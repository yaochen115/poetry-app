    },
    {
      "id": "song-971",
      "category": "宋词",
      "title": "菩萨蛮",
      "subtitle": "香莲烛下匀丹雪",
      "author": "晏几道",
      "dynasty": "宋",
      "content": "香莲烛下匀丹雪。\n妆成笑弄金阶月。\n娇面胜芙蓉。\n脸边天与红。\n玳筵双揭鼓。\n唤上华茵舞。\n春浅未禁寒。\n暗嫌罗袖宽。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "2f528bbe2f43637ed6335eab2e1ab97b312de0456ba2ec09f6eb16fcad9fc071",
      "estimatedOutput": 718,
      "resultPath": "expansion/working/v2/results/song-971--2f528bbe2f43637ed6335eab2e1ab97b312de0456ba2ec09f6eb16fcad9fc071.json"
    },
    {
      "id": "song-972",
      "category": "宋词",
      "title": "菩萨蛮",
      "subtitle": "哀筝一弄湘江曲",
      "author": "晏几道",
      "dynasty": "宋",
      "content": "哀筝一弄湘江曲。\n声声写尽湘波绿。\n纤指十三弦。\n细将幽恨传。\n当筵秋水慢。\n玉柱斜飞雁。\n弹到断肠时。\n春山眉黛低。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "655f65f759363fab9015920bd5daf565d2b842e1ad5355901774024032d46b52",
      "estimatedOutput": 718,
