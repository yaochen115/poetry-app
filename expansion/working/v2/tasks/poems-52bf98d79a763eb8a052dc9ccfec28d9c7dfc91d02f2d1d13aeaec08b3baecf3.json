    },
    {
      "id": "song-964",
      "category": "宋词",
      "title": "减字木兰花",
      "subtitle": "留春不住恰似年",
      "author": "晏几道",
      "dynasty": "宋",
      "content": "留春不住。\n恰似年光无味处。\n满眼飞英。\n弹指东风太浅情。\n筝弦未稳。\n学得新声难破恨。\n转枕花前。\n且占香红一夜眠。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "0c4243da2ad61139f56bd112f7a7fb69a3c97d878b3b6d36c4e105b8fbea461e",
      "estimatedOutput": 718,
      "resultPath": "expansion/working/v2/results/song-964--0c4243da2ad61139f56bd112f7a7fb69a3c97d878b3b6d36c4e105b8fbea461e.json"
    },
    {
      "id": "song-965",
      "category": "宋词",
      "title": "减字木兰花",
      "subtitle": "长杨辇路绿满当",
      "author": "晏几道",
      "dynasty": "宋",
      "content": "长杨辇路。\n绿满当年携手处。\n试逐春风。\n重到宫花花树中。\n芳菲绕遍。\n今日不如前日健。\n酒罢凄凉。\n新恨犹添旧恨长。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "d6a1448be118b52a42d5bb9e923016eaf4379a3ef5877478817d35e9ad291177",
