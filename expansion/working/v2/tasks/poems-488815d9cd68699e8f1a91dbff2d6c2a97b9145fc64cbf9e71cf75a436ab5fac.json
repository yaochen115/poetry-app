      "resultPath": "expansion/working/v2/results/song-910--8c5f856835ee43d9470577ba1d8bd7b728913fd1ff74e17c1134bec65dd6afe3.json"
    },
    {
      "id": "song-911",
      "category": "宋词",
      "title": "蝶恋花",
      "subtitle": "初拈霜纨生怅望",
      "author": "晏几道",
      "dynasty": "宋",
      "content": "初拈霜纨生怅望。\n隔叶莺声，似学秦娥唱。\n午睡醒来慵一饷。\n双纹翠簟铺寒浪。\n雨罢苹风吹碧涨。\n脉脉荷花，泪脸红相向。\n斜贴绿云新月上。\n弯环正是愁眉样。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "a01b1d1908ea8b4846e95efdb63ab9264ec8df7ea0972aaec1e7f6e32962c7ad",
