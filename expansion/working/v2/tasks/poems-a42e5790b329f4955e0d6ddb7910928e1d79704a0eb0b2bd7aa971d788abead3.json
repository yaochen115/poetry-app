    },
    {
      "id": "song-816",
      "category": "宋词",
      "title": "卜算子",
      "subtitle": "深院花铺地淡淡",
      "author": "杜安世",
      "dynasty": "宋",
      "content": "深院花铺地。\n淡淡阴天气。\n水榭风亭朱明景，又别是、愁情味。\n有情奈无计。\n漫惹成憔悴。\n欲把罗巾暗传寄。\n细认取、斑点泪。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "4d02806d39c7c3889dfde4f8d8af32cea5b1cb820d4d31e0178d9ea046d4ae16",
      "estimatedOutput": 724,
