    },
    {
      "id": "song-831",
      "category": "宋词",
      "title": "西江月",
      "subtitle": "天地才经否泰朝",
      "author": "张伯端",
      "dynasty": "宋",
      "content": "天地才经否泰，朝昏好识屯蒙。\n辐来辏毂水朝宗。\n妙在抽添运用。\n得一万般皆毕，休分南北西东。\n损之又损慎前功。\n命宝不宜轻弄。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "9f0c10a1e30454957b40e118903ac1a02f53ad9a91577a2b82fd9752add1b0c7",
      "estimatedOutput": 726,
      "resultPath": "expansion/working/v2/results/song-831--9f0c10a1e30454957b40e118903ac1a02f53ad9a91577a2b82fd9752add1b0c7.json"
    },
    {
      "id": "song-832",
      "category": "宋词",
      "title": "西江月",
      "subtitle": "冬至一阳来服三",
      "author": "张伯端",
      "dynasty": "宋",
      "content": "冬至一阳来服，三旬增一阳爻。\n月中复卦溯晨潮。\n望罢乾终姤兆。\n日又别为寒暑，阳生复起中宵。\n午时姤象一阴朝。\n炼药须知昏晓。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "022210951f822786ebf00bb8290e477da334c4582a745b8f49cdf650cf63535a",
      "estimatedOutput": 726,
      "resultPath": "expansion/working/v2/results/song-832--022210951f822786ebf00bb8290e477da334c4582a745b8f49cdf650cf63535a.json"
    },
    {
      "id": "song-833",
      "category": "宋词",
      "title": "西江月",
      "subtitle": "不辨五行四象那",
      "author": "张伯端",
      "dynasty": "宋",
      "content": "不辨五行四象，那分朱汞铅银。\n修丹火候未曾闻。\n早便称呼居隐。\n不背自思己错，更将错路教人。\n误他永劫在迷津。\n似恁欺心安忍。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "223a8b368964256612f4f1e8d687e0dd64de5ec0e3c73ec96033ccd7f49a1072",
      "estimatedOutput": 726,
      "resultPath": "expansion/working/v2/results/song-833--223a8b368964256612f4f1e8d687e0dd64de5ec0e3c73ec96033ccd7f49a1072.json"
    },
    {
      "id": "song-834",
      "category": "宋词",
      "title": "西江月",
      "subtitle": "德行修逾八百阴",
      "author": "张伯端",
      "dynasty": "宋",
      "content": "德行修逾八百，阴功积满三千。\n均齐物我与亲冤。\n始合神仙本愿。\n虎兕刀兵不害，无常火宅难牵。\n宝符降后去朝天。\n稳驾鸾车凤辇。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "a7d46e0149532fedcc362afce3ca11555016172da1727d14ea9e8c127c7f1a5d",
      "estimatedOutput": 726,
      "resultPath": "expansion/working/v2/results/song-834--a7d46e0149532fedcc362afce3ca11555016172da1727d14ea9e8c127c7f1a5d.json"
    },
    {
      "id": "song-835",
      "category": "宋词",
      "title": "西江月",
      "subtitle": "牛女情缘道合龟",
      "author": "张伯端",
      "dynasty": "宋",
      "content": "牛女情缘道合，龟蛇类秉天然。\n蟾乌遇朔合婵娟。\n二气相资运转。\n本是乾坤妙用，谁能达此深渊。\n阳阴否隔却成愆。\n怎得天长地远。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "737f4d16bf767b287d741b4aebbd84d7e8b8f935d6e933c20c78e40b37b4c95b",
      "estimatedOutput": 726,
      "resultPath": "expansion/working/v2/results/song-835--737f4d16bf767b287d741b4aebbd84d7e8b8f935d6e933c20c78e40b37b4c95b.json"
    },
    {
      "id": "song-836",
      "category": "宋词",
      "title": "西江月",
      "subtitle": "丹是色身至宝炼",
      "author": "张伯端",
      "dynasty": "宋",
      "content": "丹是色身至宝，炼成变化无穷。\n更於性上究真宗。\n决了死生妙用。\n不待他身后世，现前获福神通。\n自从龙虎著斯功。\n尔后谁能继踵。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "f339d5898bc4c91ed3fe9b785fb4e1f5361a3224af62b8377511c47c198ebce7",
      "estimatedOutput": 726,
      "resultPath": "expansion/working/v2/results/song-836--f339d5898bc4c91ed3fe9b785fb4e1f5361a3224af62b8377511c47c198ebce7.json"
    },
    {
      "id": "song-837",
      "category": "宋词",
      "title": "西江月",
      "subtitle": "妄想不须强灭真",
      "author": "张伯端",
      "dynasty": "宋",
      "content": "妄想不须强灭，真如何必希求。\n本源自性佛齐修。\n迷悟岂拘先后。\n悟则刹那成佛。\n迷则万劫沦流。\n若能一念契真修。\n灭尽恒沙罪垢。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "cec8460febd383eae40e2506d3129162a35844fff1617f5e3dc46fa07e76b8ef",
      "estimatedOutput": 728,
      "resultPath": "expansion/working/v2/results/song-837--cec8460febd383eae40e2506d3129162a35844fff1617f5e3dc46fa07e76b8ef.json"
    },
    {
      "id": "song-838",
      "category": "宋词",
      "title": "西江月",
      "subtitle": "本自无生无灭强",
      "author": "张伯端",
      "dynasty": "宋",
      "content": "本自无生无灭，强将生灭区分。\n只如罪福亦何根。\n妙体何曾增损。\n我有一轮明镜，从来只为蒙分。\n今朝磨莹照乾坤。\n万象超然难隐。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "1ef24bf200d3448ff556a2231de8a4411b032ee6cc387cce2f6e747a347d98f4",
      "estimatedOutput": 726,
      "resultPath": "expansion/working/v2/results/song-838--1ef24bf200d3448ff556a2231de8a4411b032ee6cc387cce2f6e747a347d98f4.json"
    },
    {
      "id": "song-839",
      "category": "宋词",
      "title": "西江月",
      "subtitle": "我性入诸佛性诸",
      "author": "张伯端",
      "dynasty": "宋",
      "content": "我性入诸佛性，诸方佛性皆然。\n亭亭蟾影照寒泉。\n一月千潭普现。\n小则毫分莫识，大时遍满三千。\n高低不约信方圆。\n说甚短长深浅。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "447e03226f4d98bef78fe79aab91ee1de918195135638a91577992f2af7bd67d",
      "estimatedOutput": 726,
      "resultPath": "expansion/working/v2/results/song-839--447e03226f4d98bef78fe79aab91ee1de918195135638a91577992f2af7bd67d.json"
    },
    {
      "id": "song-840",
      "category": "宋词",
      "title": "西江月",
      "subtitle": "法法法元无法空",
      "author": "张伯端",
      "dynasty": "宋",
      "content": "法法法元无法，空空空亦非空。\n静喧语默本来同。\n梦里何曾说梦。\n有用用中无用，无功功里施功。\n还如果熟自然红。\n莫问如何修种。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "c7b3f2fde8e2fa09f2a25c16d434fd815990e002a956e5620795d47438061929",
      "estimatedOutput": 726,
      "resultPath": "expansion/working/v2/results/song-840--c7b3f2fde8e2fa09f2a25c16d434fd815990e002a956e5620795d47438061929.json"
    },
    {
      "id": "song-841",
      "category": "宋词",
      "title": "西江月",
      "subtitle": "善恶一时妄念荣",
      "author": "张伯端",
      "dynasty": "宋",
      "content": "善恶一时妄念，荣枯都不关心。\n晦明隐显任浮沈。\n随分肌餐渴饮。\n神静湛然常寂，不妨坐卧歌吟。\n一池秋水碧仍深。\n风动鱼惊尽任。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "af08268e074b776a77c4137502e40383ee17bd2ec5bd5ede83e5f6c2d92e4d1d",
