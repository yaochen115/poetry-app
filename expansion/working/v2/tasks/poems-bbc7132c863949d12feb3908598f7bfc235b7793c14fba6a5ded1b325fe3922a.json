    },
    {
      "id": "tang-631",
      "category": "唐诗",
      "title": "宫中调笑",
      "subtitle": "团扇",
      "author": "王建",
      "dynasty": "唐",
      "content": "团扇，团扇，美人病来遮面。\n玉颜憔悴三年，谁复商量管弦。\n弦管，弦管，春草昭阳路断。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "4385ab7b2dce99d34a59c051bea8e00976be1df6b8251ad5d6ac373915dde4fa",
      "estimatedOutput": 684,
      "resultPath": "expansion/working/v2/results/tang-631--4385ab7b2dce99d34a59c051bea8e00976be1df6b8251ad5d6ac373915dde4fa.json"
    },
    {
      "id": "tang-632",
      "category": "唐诗",
      "title": "冬至",
      "subtitle": "",
      "author": "杜甫",
      "dynasty": "唐",
      "content": "年年至日长为客，忽忽穷愁泥杀人。\n江上形容吾独老，天边风俗自相亲。\n杖藜雪后临丹壑，鸣玉朝来散紫宸。\n心折此时无一寸，路迷何处见三秦。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "7f7cb93cf24850c918e7bd64a0bd8437cf8e274a577bba48d00564dbb5abec4a",
      "estimatedOutput": 734,
      "resultPath": "expansion/working/v2/results/tang-632--7f7cb93cf24850c918e7bd64a0bd8437cf8e274a577bba48d00564dbb5abec4a.json"
    },
    {
      "id": "tang-633",
      "category": "唐诗",
      "title": "折杨柳",
      "subtitle": "",
      "author": "李白",
      "dynasty": "唐",
      "content": "垂杨拂绿水，摇艳东风年。\n花明玉关雪，叶暖金窗烟。\n美人结长想，对此心凄然。\n攀条折春色，远寄龙庭前。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "3db7077d6a0a50b8ee922df673158677eece55dc379b5edbd7f436e88dc84a09",
      "estimatedOutput": 702,
      "resultPath": "expansion/working/v2/results/tang-633--3db7077d6a0a50b8ee922df673158677eece55dc379b5edbd7f436e88dc84a09.json"
    },
    {
      "id": "tang-634",
      "category": "唐诗",
      "title": "春晓",
      "subtitle": "",
      "author": "元稹",
      "dynasty": "唐",
      "content": "半欲天明半未明，醉闻花气睡闻莺。\n猧儿撼起钟声动，二十年前晓寺情。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "ad81aab26a5125403ad4c83da74afdb1bd08c386cebcc04594d234df2941bfc4",
      "estimatedOutput": 666,
      "resultPath": "expansion/working/v2/results/tang-634--ad81aab26a5125403ad4c83da74afdb1bd08c386cebcc04594d234df2941bfc4.json"
    },
    {
      "id": "tang-635",
      "category": "唐诗",
      "title": "寄全椒山中道士",
      "subtitle": "",
      "author": "韦应物",
      "dynasty": "唐",
      "content": "今朝郡斋冷，忽念山中客。\n涧底束荆薪，归来煮白石。\n欲持一瓢酒，远慰风雨夕。\n落叶满空山，何处寻行迹。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "c64fbf9d29baa0b0a0df0532f759dc7c9cfcdcff6789c77d4910b16f2bd76284",
      "estimatedOutput": 702,
      "resultPath": "expansion/working/v2/results/tang-635--c64fbf9d29baa0b0a0df0532f759dc7c9cfcdcff6789c77d4910b16f2bd76284.json"
    },
    {
      "id": "tang-636",
      "category": "唐诗",
      "title": "九日龙山饮",
      "subtitle": "",
      "author": "李白",
      "dynasty": "唐",
      "content": "九日龙山饮，黄花笑逐臣。\n醉看风落帽，舞爱月留人。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "88cfe94fcc0127429a4df8e74d8d0c721957959cf59b2cca9819249d096398ea",
      "estimatedOutput": 650,
      "resultPath": "expansion/working/v2/results/tang-636--88cfe94fcc0127429a4df8e74d8d0c721957959cf59b2cca9819249d096398ea.json"
    },
    {
      "id": "tang-637",
      "category": "唐诗",
      "title": "送人之军",
      "subtitle": "",
      "author": "贺知章",
      "dynasty": "唐",
      "content": "常经绝脉塞，复见断肠流。\n送子成今别，令人起昔愁。\n陇云晴半雨，边草夏先秋。\n万里长城寄，无贻汉国忧。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "b298967d4ab800e3965d94d359fa2f32aeb993fea5b992f80d42915903dd22a6",
      "estimatedOutput": 702,
      "resultPath": "expansion/working/v2/results/tang-637--b298967d4ab800e3965d94d359fa2f32aeb993fea5b992f80d42915903dd22a6.json"
    },
    {
      "id": "tang-638",
      "category": "唐诗",
      "title": "南轩松",
      "subtitle": "",
      "author": "李白",
      "dynasty": "唐",
      "content": "南轩有孤松，柯叶自绵幂。\n清风无闲时，潇洒终日夕。\n阴生古苔绿，色染秋烟碧。\n何当凌云霄，直上数千尺。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "e0a91999e54c402cf8b1c54e0a2719f8f76386c47dd22361328ec7f628faa244",
      "estimatedOutput": 702,
      "resultPath": "expansion/working/v2/results/tang-638--e0a91999e54c402cf8b1c54e0a2719f8f76386c47dd22361328ec7f628faa244.json"
    },
    {
      "id": "tang-639",
      "category": "唐诗",
      "title": "送李判官之润州行营",
      "subtitle": "",
      "author": "刘长卿",
      "dynasty": "唐",
      "content": "万里辞家事鼓鼙，金陵驿路楚云西。\n江春不肯留行客，草色青青送马蹄。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "663e77dfb81010a04bde8862f215d22f69845806c62694326cc87ef3b814a29a",
      "estimatedOutput": 666,
      "resultPath": "expansion/working/v2/results/tang-639--663e77dfb81010a04bde8862f215d22f69845806c62694326cc87ef3b814a29a.json"
    },
    {
      "id": "tang-640",
      "category": "唐诗",
      "title": "汴河怀古二首",
      "subtitle": "",
      "author": "皮日休",
      "dynasty": "唐",
      "content": "万艘龙舸绿丝间，载到扬州尽不还。\n应是天教开汴水，一千余里地无山。\n尽道隋亡为此河，至今千里赖通波。\n若无水殿龙舟事，共禹论功不较多。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "b436ec9337cf2f43488af999f160a5afdcd10f70070cb0c56be898b48831bada",
      "estimatedOutput": 734,
