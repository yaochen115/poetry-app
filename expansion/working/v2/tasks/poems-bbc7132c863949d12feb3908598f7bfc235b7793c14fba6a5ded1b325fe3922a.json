    },
    {
      "id": "tang-430",
      "category": "唐诗",
      "title": "宴词",
      "subtitle": "",
      "author": "王之涣",
      "dynasty": "唐",
      "content": "长堤春水绿悠悠，畎入漳河一道流。\n莫听声声催去棹，桃溪浅处不胜舟。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "ab5e31dc147cb2a25f4482a96f88a94bd0f7475e15572c103478656049be5164",
