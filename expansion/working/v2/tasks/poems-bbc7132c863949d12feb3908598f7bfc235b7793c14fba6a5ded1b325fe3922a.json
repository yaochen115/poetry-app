    {
      "id": "tang-429",
      "category": "唐诗",
      "title": "归嵩山作",
      "subtitle": "",
      "author": "王维",
      "dynasty": "唐",
      "content": "清川带长薄，车马去闲闲。\n流水如有意，暮禽相与还。\n荒城临古渡，落日满秋山。\n迢递嵩高下，归来且闭关。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "48a39a19c840402f6853f1720e0a2b46432b8489dd82004e7d6e4b4bd5a8048c",
      "estimatedOutput": 702,
