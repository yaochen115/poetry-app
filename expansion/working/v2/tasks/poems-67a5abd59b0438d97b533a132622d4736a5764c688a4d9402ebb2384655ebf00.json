    },
    {
      "id": "tang-394",
      "category": "唐诗",
      "title": "山中留客",
      "subtitle": "",
      "author": "张旭",
      "dynasty": "唐",
      "content": "山光物态弄春晖，莫为轻阴便拟归。\n纵使晴明无雨色，入云深处亦沾衣。",
      "excerptOf": null,
      "excerptNote": "",
