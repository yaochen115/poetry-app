    },
    {
      "id": "song-448",
      "category": "宋词",
      "title": "玉楼春",
      "subtitle": "凤楼郁郁呈嘉瑞",
      "author": "柳永",
      "dynasty": "宋",
      "content": "凤楼郁郁呈嘉瑞。\n降圣覃恩延四裔。\n醮台清夜洞天严，公宴凌晨箫鼓沸。\n保生酒劝椒香腻。\n延寿带垂金缕细。\n几行鹓鹭望尧云，齐共南山呼万岁。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "0dae84a58729db48209aa3e3a5d05f917be42038e795c058ad6471324d167c5e",
      "estimatedOutput": 738,
      "resultPath": "expansion/working/v2/results/song-448--0dae84a58729db48209aa3e3a5d05f917be42038e795c058ad6471324d167c5e.json"
    },
    {
      "id": "song-449",
      "category": "宋词",
      "title": "玉楼春",
      "subtitle": "皇都今夕知何夕",
      "author": "柳永",
      "dynasty": "宋",
      "content": "皇都今夕知何夕。\n特地风光盈绮陌。\n金丝玉管咽春空，蜡炬兰灯烧晓色。\n凤楼十二神仙宅。\n珠履三千鹓鹭客。\n金吾不禁六街游，狂杀云踪并雨迹。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "177753b908bdfde3ed9354a02d45e6be8c3f2ce41e7165bb878e2c63bcd59aa2",
      "estimatedOutput": 738,
      "resultPath": "expansion/working/v2/results/song-449--177753b908bdfde3ed9354a02d45e6be8c3f2ce41e7165bb878e2c63bcd59aa2.json"
    },
    {
      "id": "song-450",
      "category": "宋词",
      "title": "玉楼春",
      "subtitle": "星闱上笏金章贵",
      "author": "柳永",
      "dynasty": "宋",
      "content": "星闱上笏金章贵。\n重委外台疏近侍。\n百常天阁旧通班，九岁国储新上计。\n太仓日富中邦最。\n宣室夜思前席对。\n归心怡悦酒肠宽，不泛千锺应不醉。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "b818549fc36df139c239b01852ae7a7a6f85c65cad2928c285ba28d0308976cd",
      "estimatedOutput": 738,
      "resultPath": "expansion/working/v2/results/song-450--b818549fc36df139c239b01852ae7a7a6f85c65cad2928c285ba28d0308976cd.json"
    },
    {
      "id": "song-451",
      "category": "宋词",
      "title": "玉楼春",
      "subtitle": "阆风歧路连银阙",
      "author": "柳永",
      "dynasty": "宋",
      "content": "阆风歧路连银阙。\n曾许金桃容易窃。\n乌龙未睡定惊猜，鹦鹉能言防漏泄。\n匆匆纵得邻香雪。\n窗隔残烟帘映月。\n别来也拟不思量，争奈馀香犹未歇。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "aca59e9e146941b90bda1283619531db628e125892ad6ecf356e22701913e334",
      "estimatedOutput": 738,
      "resultPath": "expansion/working/v2/results/song-451--aca59e9e146941b90bda1283619531db628e125892ad6ecf356e22701913e334.json"
    },
    {
      "id": "song-452",
      "category": "宋词",
      "title": "定风波",
      "subtitle": "伫立长堤淡荡晚",
      "author": "柳永",
      "dynasty": "宋",
      "content": "伫立长堤，淡荡晚风起。\n骤雨歇、极目萧疏，塞柳万株，掩映箭波千里。\n走舟车向此，人人奔名竞利。\n念荡子、终日驱驱，争觉乡关转迢递。\n何意。\n绣阁轻抛，锦字难逢，等闲度岁。\n奈泛泛旅迹，厌厌病绪，迩来谙尽，宦游滋味。\n此情怀、纵写香笺，凭谁与寄。\n算孟光、争得知我，继日添憔悴。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "ed1ed4a73ca3d691396c998a8d88e6f2a50109ed1e4e8ee571d716ae873545d7",
      "estimatedOutput": 876,
      "resultPath": "expansion/working/v2/results/song-452--ed1ed4a73ca3d691396c998a8d88e6f2a50109ed1e4e8ee571d716ae873545d7.json"
    },
    {
      "id": "song-453",
      "category": "宋词",
      "title": "永遇乐",
      "subtitle": "薰风解愠昼景清",
      "author": "柳永",
      "dynasty": "宋",
      "content": "薰风解愠，昼景清和，新霁时候。\n火德流光，萝图荐祉，累庆金枝秀。\n璇枢绕电，华渚流虹，是日挺生元后。\n缵唐虞垂拱，千载应期，万灵敷祐。\n殊方异域，争贡琛賮，架巘航波奔凑。\n三殿称觞，九仪就列，韶頀锵金奏。\n藩侯瞻望彤庭，亲携僚吏，竞歌元首。\n祝尧龄、北极齐尊，南山共久。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "437faa37fbcc05ff13f520bbb4eda14038fa1da16f4aab4e23cf3eae03dfd743",
      "estimatedOutput": 870,
      "resultPath": "expansion/working/v2/results/song-453--437faa37fbcc05ff13f520bbb4eda14038fa1da16f4aab4e23cf3eae03dfd743.json"
    },
    {
      "id": "song-454",
      "category": "宋词",
      "title": "永遇乐",
      "subtitle": "天阁英游内朝密",
      "author": "柳永",
      "dynasty": "宋",
      "content": "天阁英游，内朝密侍，当世荣遇。\n汉守分麾，尧庭请瑞，方面凭心膂。\n风驰千骑，云拥双旌，向晓洞开严署。\n拥朱轓、喜色欢声，处处竞歌来暮。\n吴王旧国，今古江山秀异，人烟繁富。\n甘雨车行，仁风扇动，雅称安黎庶。\n棠郊成政，槐府登贤，非久定须归去。\n且乘闲、孙阁长开，融尊盛举。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "2a5ce245a3f84bd629bed858d854ff38a3480178f434784bf57cc3c29287fedb",
      "estimatedOutput": 870,
      "resultPath": "expansion/working/v2/results/song-454--2a5ce245a3f84bd629bed858d854ff38a3480178f434784bf57cc3c29287fedb.json"
    },
    {
      "id": "song-455",
      "category": "宋词",
      "title": "卜算子",
      "subtitle": "江风渐老汀蕙半",
      "author": "柳永",
      "dynasty": "宋",
      "content": "江风渐老，汀蕙半凋，满目败红衰翠。\n楚客登临，正是暮秋天气。\n引疏砧、断续残阳里。\n对晚景、伤怀念远，新愁旧恨相继。\n脉脉人千里。\n念两处风情，万重烟水。\n雨歇天高，望断翠峰十二。\n尽无言、谁会凭高意。\n纵写得、离肠万种，奈归云谁寄。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "485d6af89183425b237698964914575e5369c65dc4ca2e6e266a9e8f46942c3b",
      "estimatedOutput": 834,
      "resultPath": "expansion/working/v2/results/song-455--485d6af89183425b237698964914575e5369c65dc4ca2e6e266a9e8f46942c3b.json"
    },
    {
      "id": "song-456",
      "category": "宋词",
      "title": "鹊桥仙",
      "subtitle": "届征途携书剑迢",
      "author": "柳永",
      "dynasty": "宋",
      "content": "届征途，携书剑，迢迢匹马东去。\n惨离怀，嗟少年易分难聚。\n佳人方恁缱绻，便忍分鸳侣。\n当媚景，算密意幽欢，尽成轻负。\n此际寸肠万绪。\n惨愁颜、断魂无语。\n和泪眼、片时几番回顾。\n伤心脉脉谁诉。\n但黯然凝伫。\n暮烟寒雨。\n望秦楼何处。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "4896bf94462a225ddf6b1b2a2f7538007e94ed47868604f578248dd0f404c841",
      "estimatedOutput": 832,
