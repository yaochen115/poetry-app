    },
    {
      "id": "song-556",
      "category": "宋词",
      "title": "清平乐",
      "subtitle": "春花秋草只是催",
      "author": "晏殊",
      "dynasty": "宋",
      "content": "春花秋草。\n只是催人老。\n总把千山眉黛扫。\n未抵别愁多少。\n劝君绿酒金杯。\n莫嫌丝管声催。\n兔走乌飞不住，人生几度三台。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "ff11c7005acd8f7afe211ee70406766eb1f58bc67d7dac4147f2a34f7d77c7d3",
      "estimatedOutput": 720,
      "resultPath": "expansion/working/v2/results/song-556--ff11c7005acd8f7afe211ee70406766eb1f58bc67d7dac4147f2a34f7d77c7d3.json"
    },
    {
      "id": "song-557",
      "category": "宋词",
      "title": "清平乐",
      "subtitle": "秋光向晚小阁初",
      "author": "晏殊",
      "dynasty": "宋",
      "content": "秋光向晚。\n小阁初开宴。\n林叶殷红犹未遍。\n雨后青苔满院。\n萧娘劝我金卮。\n殷勤更唱新词。\n暮去朝来节老，人生不饮何为。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "e2073803beb319aaac52ebba384d92caa1b1b762707e23d67b9145171562ea1c",
      "estimatedOutput": 720,
      "resultPath": "expansion/working/v2/results/song-557--e2073803beb319aaac52ebba384d92caa1b1b762707e23d67b9145171562ea1c.json"
    },
    {
      "id": "song-558",
      "category": "宋词",
      "title": "清平乐",
      "subtitle": "春来秋去往事知",
      "author": "晏殊",
      "dynasty": "宋",
      "content": "春来秋去。\n往事知何处。\n燕子归飞兰泣露。\n光景千留不住。\n酒阑人散忡忡。\n闲阶独倚梧桐。\n记得去年今日，依前黄叶西风。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "7e1e93d41a5e487f442c11dcc0a8c1e8709cfc4dc3cd9292d0ca90071459f9cc",
      "estimatedOutput": 720,
      "resultPath": "expansion/working/v2/results/song-558--7e1e93d41a5e487f442c11dcc0a8c1e8709cfc4dc3cd9292d0ca90071459f9cc.json"
    },
    {
      "id": "song-559",
      "category": "宋词",
      "title": "采桑子",
      "subtitle": "春风不负东君信",
      "author": "晏殊",
      "dynasty": "宋",
      "content": "春风不负东君信，遍拆群芳。\n燕子双双。\n依旧衔泥入杏梁。\n须知一盏花前酒，占得韶光。\n莫话匆忙。\n梦里浮生足断肠。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "079a12e3ba5774f906d7d18e3ba3b05942e868635e9be7546af68ba2e06d7927",
      "estimatedOutput": 714,
      "resultPath": "expansion/working/v2/results/song-559--079a12e3ba5774f906d7d18e3ba3b05942e868635e9be7546af68ba2e06d7927.json"
    },
    {
      "id": "song-560",
      "category": "宋词",
      "title": "采桑子",
      "subtitle": "阳和二月芳菲遍",
      "author": "晏殊",
      "dynasty": "宋",
      "content": "阳和二月芳菲遍，暖景溶溶。\n戏蝶游蜂。\n深入千花粉艳中。\n何人解系天边日，占取春风。\n免使繁红。\n一片西飞一片东。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "381fb1cf72264604b20f83b6bd81e25ffda0293a7cc70b4d4fe6b327160b262c",
      "estimatedOutput": 714,
      "resultPath": "expansion/working/v2/results/song-560--381fb1cf72264604b20f83b6bd81e25ffda0293a7cc70b4d4fe6b327160b262c.json"
    },
    {
      "id": "song-561",
      "category": "宋词",
      "title": "采桑子",
      "subtitle": "樱桃谢了梨花发",
      "author": "晏殊",
      "dynasty": "宋",
      "content": "樱桃谢了梨花发，红白相催。\n燕子归来。\n几处风帘绣户开。\n人生乐事知多少，且酌金杯。\n管咽弦哀。\n慢引萧娘舞袖回。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "2ab8483b0746094ecab36f05585d4255f078aa88ff1626c2774935626f7c7739",
      "estimatedOutput": 714,
      "resultPath": "expansion/working/v2/results/song-561--2ab8483b0746094ecab36f05585d4255f078aa88ff1626c2774935626f7c7739.json"
    },
    {
      "id": "song-562",
      "category": "宋词",
      "title": "采桑子",
      "subtitle": "古罗衣上金针样",
      "author": "晏殊",
      "dynasty": "宋",
      "content": "古罗衣上金针样，绣出芳妍。\n玉砌朱阑。\n紫艳红英照日鲜。\n佳人画阁新妆了，对立丛边。\n试摘婵娟。\n贴向眉心学翠钿。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "c20096074bdceabba9684c091b37d49ca8f801769be027ce7570593a0180edb0",
      "estimatedOutput": 714,
      "resultPath": "expansion/working/v2/results/song-562--c20096074bdceabba9684c091b37d49ca8f801769be027ce7570593a0180edb0.json"
    },
    {
      "id": "song-563",
      "category": "宋词",
      "title": "采桑子",
      "subtitle": "林间摘遍双双叶",
      "author": "晏殊",
      "dynasty": "宋",
      "content": "林间摘遍双双叶，寄与相思。\n朱槿开时。\n尚有山榴一两枝。\n荷花欲绽金莲子，半落红衣。\n晚雨微微。\n待得空梁宿燕归。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "908f5c5023e5825ebf4b418306fc7dd05cc8e187485fd42377970dfbbcf9dd71",
      "estimatedOutput": 714,
      "resultPath": "expansion/working/v2/results/song-563--908f5c5023e5825ebf4b418306fc7dd05cc8e187485fd42377970dfbbcf9dd71.json"
    },
    {
      "id": "song-564",
      "category": "宋词",
      "title": "少年游",
      "subtitle": "重阳过后西风渐",
      "author": "晏殊",
      "dynasty": "宋",
      "content": "重阳过后，西风渐紧，庭树叶纷纷。\n朱阑向晓，芙蓉妖艳，特地斗芳新。\n霜前月下，斜红淡蕊，明媚欲回春。\n莫将琼萼等闲分。\n留赠意中人。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "f6f1d503cafeae96bd3c03cdac829594856851121df1b434062e0b1a265eb0c5",
      "estimatedOutput": 732,
      "resultPath": "expansion/working/v2/results/song-564--f6f1d503cafeae96bd3c03cdac829594856851121df1b434062e0b1a265eb0c5.json"
    },
    {
      "id": "song-565",
      "category": "宋词",
      "title": "少年游",
      "subtitle": "霜华满树兰凋蕙",
      "author": "晏殊",
      "dynasty": "宋",
      "content": "霜华满树，兰凋蕙惨，秋艳入芙蓉。\n胭脂嫩脸，金黄轻蕊，犹自怨西风。\n前欢往事，当歌对酒，无限到心中。\n更凭朱槛忆芳容。\n肠断一枝红。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "f13342f62a05354ac79551fed272d5231dd1f8cc409cff016fe027c8c4d5b00e",
