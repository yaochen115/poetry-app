      "resultPath": "expansion/working/v2/results/tang-811--35532a257601a7859ecf83eb06d354c9d9b03a55298951aa5aaea7ff7062fb9c.json"
    },
    {
      "id": "tang-812",
      "category": "唐诗",
      "title": "赠张祜",
      "subtitle": "",
      "author": "杜牧",
      "dynasty": "唐",
      "content": "诗韵一逢君，平生称所闻。\n粉毫唯画月，琼尺只裁云。\n黥阵人人慑，秋星历历分。\n数篇留别我，羞杀李将军。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "7635d97bda4d0e61e6f8bc2d0d13724a17af55968ccc7d4e1d7c0c2301b523c8",
