    },
    {
      "id": "tang-715",
      "category": "唐诗",
      "title": "谚",
      "subtitle": "",
      "author": "佚名",
      "dynasty": "唐",
      "content": "枣子塞鼻孔，悬栖阁却种。\n蝉鸣蛁蟟唤，黍种糕糜断。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "9108f9bedda277de8c9bbab840e648f0cd2b8541b4a47f095af6c60e1dcda6e7",
