    {
      "id": "tang-714",
      "category": "唐诗",
      "title": "府酒五绝。招客",
      "subtitle": "",
      "author": "白居易",
      "dynasty": "唐",
      "content": "日午微风且暮寒，春风冷峭雪乾残。\n碧毡帐下红炉畔，试为来尝一醆看。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "35541334ae0aa70faa1362b4e2a6601eae39f446237ec415b8f85e9fe8534ad3",
