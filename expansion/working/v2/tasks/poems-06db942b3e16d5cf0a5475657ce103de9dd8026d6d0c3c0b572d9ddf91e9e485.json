    },
    {
      "id": "tang-716",
      "category": "唐诗",
      "title": "酬杜使君见寄",
      "subtitle": "",
      "author": "贯休",
      "dynasty": "唐",
      "content": "轧轧复轧轧，更深门未关。\n心疼无所得，诗债若为还。\n露洒一鹤睡，钟馀万象闲。\n惭将此时意，明日寄东山。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "03879f6a29bbf5ddbf1aacc6c7fd82ab174e22a1ff8009e9ec69174a6f830ce6",
      "estimatedOutput": 702,
      "resultPath": "expansion/working/v2/results/tang-716--03879f6a29bbf5ddbf1aacc6c7fd82ab174e22a1ff8009e9ec69174a6f830ce6.json"
    },
    {
      "id": "tang-717",
      "category": "唐诗",
      "title": "荆州新秋病起杂题一十五首",
      "subtitle": "病起见庭石",
      "author": "齐己",
      "dynasty": "唐",
      "content": "病起见庭石，岂知经夏眠。\n不能资药价，空自作苔钱。\n翠忆蓝光底，青思瀑影边。\n岩僧应笑我，细碎种阶前。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "5b56f13701633d2bd56b6a36daae733836d8dafb84ad093d1f0d1bdf4b8c4ebe",
      "estimatedOutput": 702,
      "resultPath": "expansion/working/v2/results/tang-717--5b56f13701633d2bd56b6a36daae733836d8dafb84ad093d1f0d1bdf4b8c4ebe.json"
    },
    {
      "id": "tang-718",
      "category": "唐诗",
      "title": "赠历阳褚司马 时此公为稚子舞故作是诗",
      "subtitle": "",
      "author": "李白",
      "dynasty": "唐",
      "content": "北堂千万寿，侍奉有光辉。\n先同稚子舞，更著老莱衣。\n因为小儿啼，醉倒月下归。\n人间无此乐，此乐世中稀。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "f4d28a5e34aceb0cf5a0840ae72a11603eec28da661572f8b10987aeebe237bb",
      "estimatedOutput": 702,
      "resultPath": "expansion/working/v2/results/tang-718--f4d28a5e34aceb0cf5a0840ae72a11603eec28da661572f8b10987aeebe237bb.json"
    },
    {
      "id": "tang-719",
      "category": "唐诗",
      "title": "骢马",
      "subtitle": "",
      "author": "沈佺期",
      "dynasty": "唐",
      "content": "西北五花骢，来时道向东。\n四蹄碧玉片，双眼黄金瞳。\n鞍上留明月，嘶间动朔风。\n借君驰沛艾，一战取云中。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "2e92c7cdfba39f5c77dbc339da3b530d69081c49f64a07a8d81cec0640707cc3",
      "estimatedOutput": 702,
      "resultPath": "expansion/working/v2/results/tang-719--2e92c7cdfba39f5c77dbc339da3b530d69081c49f64a07a8d81cec0640707cc3.json"
    },
    {
      "id": "tang-720",
      "category": "唐诗",
      "title": "陌上赠美人",
      "subtitle": "",
      "author": "李白",
      "dynasty": "唐",
      "content": "骏马骄行踏落花，垂鞭直拂五云车。\n美人一笑褰珠箔，遥指红楼是妾家。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "baf740cf8e75344c1ac4888f782a4fc0fb89c2383be9a53449ab766150e92836",
      "estimatedOutput": 666,
      "resultPath": "expansion/working/v2/results/tang-720--baf740cf8e75344c1ac4888f782a4fc0fb89c2383be9a53449ab766150e92836.json"
    },
    {
      "id": "tang-721",
      "category": "唐诗",
      "title": "春日江次",
      "subtitle": "",
      "author": "姚合",
      "dynasty": "唐",
      "content": "野步出茆斋，闲行坐石台。\n久悲乡路远，犹喜杏花开。\n鸥鹭皆飞去，帆樯何处来。\n因凝千里目，落日尚徘徊。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "64d26a678d2f322b33a744bbaf779b97b36c2afffbaccf88821c87119e2fb4c1",
      "estimatedOutput": 702,
      "resultPath": "expansion/working/v2/results/tang-721--64d26a678d2f322b33a744bbaf779b97b36c2afffbaccf88821c87119e2fb4c1.json"
    },
    {
      "id": "tang-722",
      "category": "唐诗",
      "title": "昔昔盐二十首 花飞桃李蹊",
      "subtitle": "",
      "author": "赵嘏",
      "dynasty": "唐",
      "content": "远期难可托，桃李自依依。\n花径无容迹，戎裘未下机。\n随风开又落，度日扫还飞。\n欲折枝枝赠，那知归不归。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "f0fff300e18439169187b0a19c479e465467a77b884a8272a7e009787c53f895",
      "estimatedOutput": 702,
