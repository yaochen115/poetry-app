    {
      "id": "tang-884",
      "category": "唐诗",
      "title": "自问",
      "subtitle": "",
      "author": "白居易",
      "dynasty": "唐",
      "content": "依仁台废悲风晚，履信池荒宿草春。\n自问老身骑马出，洛阳城里觅何人。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "67f070ef50e03e054d915aa7df118ade393083bdc4a61792a698e13f1b78dd64",
