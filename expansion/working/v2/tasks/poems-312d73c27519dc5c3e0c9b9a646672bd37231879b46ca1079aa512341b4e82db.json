    {
      "id": "tang-885",
      "category": "唐诗",
      "title": "黎拾遗昕裴秀才迪见过秋夜对雨之作",
      "subtitle": "",
      "author": "王维",
      "dynasty": "唐",
      "content": "促织鸣已急，轻衣行向重。\n寒灯坐高馆，秋雨闻疏钟。\n白法调狂象，玄言问老龙。\n何人顾蓬径，空愧求羊踪。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "2a971da9089f4188c10b4a2fc03d63214dab11b4702210cf1acb7bbdf69997c7",
      "estimatedOutput": 702,
      "resultPath": "expansion/working/v2/results/tang-885--2a971da9089f4188c10b4a2fc03d63214dab11b4702210cf1acb7bbdf69997c7.json"
    },
    {
      "id": "tang-886",
      "category": "唐诗",
      "title": "早发上东门",
      "subtitle": "",
      "author": "綦毋潜",
      "dynasty": "唐",
      "content": "十五能行西入秦，三十无家作路人。\n时命不将明主合，布衣空染洛阳尘。",
      "excerptOf": null,
      "excerptNote": "",
