    {
      "id": "tang-887",
      "category": "唐诗",
      "title": "秋日书怀寄白宾客",
      "subtitle": "",
      "author": "刘禹锡",
      "dynasty": "唐",
      "content": "州远雄无益，年高健亦衰。\n兴情逢酒在，筋力上楼知。\n蝉噪芳意尽，雁来愁望时。\n商山紫芝客，应不向秋悲。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "5979208ebb84f78676122448aa59cc0102849ed52ce5a642176c4b29b9128f98",
      "estimatedOutput": 702,
      "resultPath": "expansion/working/v2/results/tang-887--5979208ebb84f78676122448aa59cc0102849ed52ce5a642176c4b29b9128f98.json"
    },
    {
      "id": "tang-888",
      "category": "唐诗",
      "title": "三闾庙",
      "subtitle": "",
      "author": "戴叔伦",
      "dynasty": "唐",
      "content": "沅湘流不尽，屈宋怨何深。\n日暮秋烟起，萧萧枫树林。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "94edd33456aac3c0172fc3b27aefbe3f2291d1fbfc47f58955b338c6814755b7",
