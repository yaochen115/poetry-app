      "resultPath": "expansion/working/v2/results/tang-879--c99ce541211de37cef8879a09434e36970af2e9eae4e4827748582bca0d519e8.json"
    },
    {
      "id": "tang-880",
      "category": "唐诗",
      "title": "送颜评事入京",
      "subtitle": "",
      "author": "岑参",
      "dynasty": "唐",
      "content": "颜子人叹屈，宦游今未迟。\n伫闻明主用，岂负青云姿。\n江柳秋吐叶，山花寒满枝。\n知君客愁处，月满巴川时。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "21e79db9a334509fa4f3c7029de6da4eaf9eec79b4a8af68bea2383bf683334f",
