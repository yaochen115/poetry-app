    },
    {
      "id": "tang-870",
      "category": "唐诗",
      "title": "草堂村寻罗生不遇",
      "subtitle": "",
      "author": "岑参",
      "dynasty": "唐",
      "content": "数株谿柳色依依，深巷斜阳暮鸟飞。\n门前雪满无人迹，应是先生出未归。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "e33a7ec06c7ae3c18d4539228dcc91e32b6c0eaaaecdf09b2adc74c691b91935",
