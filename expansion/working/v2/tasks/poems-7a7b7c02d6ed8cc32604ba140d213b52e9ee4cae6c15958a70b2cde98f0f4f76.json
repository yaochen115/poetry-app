    },
    {
      "id": "tang-871",
      "category": "唐诗",
      "title": "送淡公 其十二",
      "subtitle": "",
      "author": "孟郊",
      "dynasty": "唐",
      "content": "诗人苦为诗，不如脱空飞。\n一生空鷕气，非谏复非讥。\n脱枯挂寒枝，弃如一唾微。\n一步一步乞，半片半片衣。\n倚诗为活计，从古多无肥。\n诗饥老不怨，劳师泪霏霏。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "25700f2dc21f0553e298434f92f616b00b15300a832103f779d261b22b4c809e",
      "estimatedOutput": 754,
      "resultPath": "expansion/working/v2/results/tang-871--25700f2dc21f0553e298434f92f616b00b15300a832103f779d261b22b4c809e.json"
    },
    {
      "id": "tang-872",
      "category": "唐诗",
      "title": "送邵安石及第归连州觐省",
      "subtitle": "",
      "author": "曹松",
      "dynasty": "唐",
      "content": "及第兼归觐，宜忘涉驿劳。\n青云重庆少，白日一飞高。\n转楚闻啼狖，临湘见叠涛。\n海阳沈饮罢，何地佐旌旄。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "234f07bc8159a4f6cda64594119cf67c165ba613569e2ab9a07da3ee777226a4",
      "estimatedOutput": 702,
      "resultPath": "expansion/working/v2/results/tang-872--234f07bc8159a4f6cda64594119cf67c165ba613569e2ab9a07da3ee777226a4.json"
    },
    {
      "id": "tang-873",
      "category": "唐诗",
      "title": "奉陪郑驸马韦曲二首 其一",
      "subtitle": "",
      "author": "杜甫",
      "dynasty": "唐",
      "content": "韦曲花无赖，家家恼杀人。\n绿尊虽尽日，白发好禁春。\n石角钩衣破，藤枝刺眼新。\n何时占丛竹，头戴小乌巾。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "3854b81405c7df16d8301c9703462c8116210003c266b4750c0f584261c9f64f",
      "estimatedOutput": 702,
      "resultPath": "expansion/working/v2/results/tang-873--3854b81405c7df16d8301c9703462c8116210003c266b4750c0f584261c9f64f.json"
    },
    {
      "id": "tang-874",
      "category": "唐诗",
      "title": "宿山寺思归",
      "subtitle": "",
      "author": "李端",
      "dynasty": "唐",
      "content": "僧房秋雨歇，愁卧夜更深。\n欹枕闻鸿雁，回灯见竹林。\n归萤入草尽，落月映窗沉。\n拭泪无人觉，长谣向壁阴。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "ac6a46df50cb12ee36250d11971aee5dce2f5fdf7d6f0e84896d8da055040699",
      "estimatedOutput": 702,
      "resultPath": "expansion/working/v2/results/tang-874--ac6a46df50cb12ee36250d11971aee5dce2f5fdf7d6f0e84896d8da055040699.json"
    },
    {
      "id": "tang-875",
      "category": "唐诗",
      "title": "广陵城（一作孟迟诗）",
      "subtitle": "",
      "author": "赵嘏",
      "dynasty": "唐",
      "content": "红映高台绿绕城，城边春草傍墙生。\n隋家不向此中尽，汴水应无东去声。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "acbf2a9ca19d689237c97504cf6e161dbc35ebda4cf0f6cbf15a2a7a2bbecd44",
      "estimatedOutput": 666,
      "resultPath": "expansion/working/v2/results/tang-875--acbf2a9ca19d689237c97504cf6e161dbc35ebda4cf0f6cbf15a2a7a2bbecd44.json"
    },
    {
      "id": "tang-876",
      "category": "唐诗",
      "title": "秦州杂诗二十首 其五",
      "subtitle": "",
      "author": "杜甫",
      "dynasty": "唐",
      "content": "南使宜天马，由来万匹强。\n浮云连阵没，秋草遍山长。\n闻说真龙种，仍残老骕骦。\n哀鸣思战斗，迥立向苍苍。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "c7a563b08a208727671111e8bb97222704861c956146db118f8658b9169245ab",
      "estimatedOutput": 702,
      "resultPath": "expansion/working/v2/results/tang-876--c7a563b08a208727671111e8bb97222704861c956146db118f8658b9169245ab.json"
    },
    {
      "id": "tang-877",
      "category": "唐诗",
      "title": "除夜",
      "subtitle": "",
      "author": "佚名",
      "dynasty": "唐",
      "content": "荒城何独泪潸然，闻说今宵是改年。\n亲故睽携长已矣，幽缧寂寞镇愁煎。\n更深肠绝谁人念，夜永心伤空自怜。\n为恨漂零无计力，空知日夕仰穹天。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "4db4e96a65273024e0217698eed9e9c2e087fe74b3abdcb3d232bbf963799646",
      "estimatedOutput": 734,
      "resultPath": "expansion/working/v2/results/tang-877--4db4e96a65273024e0217698eed9e9c2e087fe74b3abdcb3d232bbf963799646.json"
    },
    {
      "id": "tang-878",
      "category": "唐诗",
      "title": "洛阳有愚叟",
      "subtitle": "",
      "author": "白居易",
      "dynasty": "唐",
      "content": "洛阳有愚叟，白黑无分别。\n浪迹虽似狂，谋身亦不拙。\n点检盘中饭，非精亦非粝。\n点检身上衣，无馀亦无阙。\n天时方得所，不寒复不热。\n体气正调和，不饥仍不渴。\n闲将酒壶出，醉向人家歇。\n野食或烹鲜，寓眠多拥褐。\n抱琴荣启乐，荷锸刘伶达。\n放眼看青山，任头生白发。\n不知天地内，更得几年活。\n从此到终身，尽为闲日月。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "1a59ac88cc6ed8b7538beee7d564401bba7e1159346d6ccedbddb73959be812f",
      "estimatedOutput": 910,
      "resultPath": "expansion/working/v2/results/tang-878--1a59ac88cc6ed8b7538beee7d564401bba7e1159346d6ccedbddb73959be812f.json"
    },
    {
      "id": "tang-879",
      "category": "唐诗",
      "title": "浮云",
      "subtitle": "",
      "author": "罗隐",
      "dynasty": "唐",
      "content": "溶溶曳曳自舒张，不向苍梧即帝乡。\n莫道无心便无事，也曾愁杀楚襄王。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "c99ce541211de37cef8879a09434e36970af2e9eae4e4827748582bca0d519e8",
