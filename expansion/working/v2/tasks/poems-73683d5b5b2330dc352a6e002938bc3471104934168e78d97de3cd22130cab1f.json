    },
    {
      "id": "yuan-099",
      "category": "元曲",
      "title": "金字经",
      "subtitle": "重到湖上",
      "author": "任昱",
      "dynasty": "元",
      "content": "碧水寺边寺，绿杨楼外楼，闲看青山云去留。鸥，飘飘随钓舟。今非旧，对花一醉休。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "bba87d233b8d0a2ac92fc5fbd68a9554d400ad8812354954f3ebf79b64a6d6fb",
      "estimatedOutput": 676,
