    {
      "id": "yuan-098",
      "category": "元曲",
      "title": "金字经",
      "subtitle": "秋宵宴坐",
      "author": "任昱",
      "dynasty": "元",
      "content": "秋夜凉如水，天河白似银，风露清清湿簟纹。论，半生名利奔。窥吟鬓，江清月近人。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "0c209a64e0f5f6ade29d6d9658cdd9e6301fbfb2d426493b3dec4becff8428a0",
