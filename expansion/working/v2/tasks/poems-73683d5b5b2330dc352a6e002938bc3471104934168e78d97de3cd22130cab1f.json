    },
    {
      "id": "yuan-100",
      "category": "元曲",
      "title": "拨不断",
      "subtitle": "布衣中",
      "author": "马致远",
      "dynasty": "元",
      "content": "布衣中，问英雄。王图霸业成何用！禾黍高低六代宫，楸梧远近千官冢。一场恶梦。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "286e9c103caf22f41f90e0bd6dc89f310f93c649d67488f3f24cb819a1b3c72b",
      "estimatedOutput": 674,
      "resultPath": "expansion/working/v2/results/yuan-100--286e9c103caf22f41f90e0bd6dc89f310f93c649d67488f3f24cb819a1b3c72b.json"
    },
    {
      "id": "yuan-101",
      "category": "元曲",
      "title": "金字经",
      "subtitle": "夜来西风里",
      "author": "马致远",
      "dynasty": "元",
      "content": "夜来西风里，九天雕鹗飞。困煞中原一布衣。\n悲，故人知未知？登楼意，恨无天上梯！",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "12126c8599fcf69d93cfa21849f8da2a68a8e067c5395cf13aaaf9bc1d5b7a76",
      "estimatedOutput": 678,
      "resultPath": "expansion/working/v2/results/yuan-101--12126c8599fcf69d93cfa21849f8da2a68a8e067c5395cf13aaaf9bc1d5b7a76.json"
    },
    {
      "id": "yuan-102",
      "category": "元曲",
      "title": "拨不断",
      "subtitle": "名利竭",
      "author": "马致远",
      "dynasty": "元",
      "content": "名利竭，是非绝。红尘不向门前惹，绿树偏宜屋角遮，青山正补墙头缺，竹篱茅舍。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "a88c017fa167081cb59dc02d67da90e7a032152a97cb251566e78b3592f7b399",
      "estimatedOutput": 674,
      "resultPath": "expansion/working/v2/results/yuan-102--a88c017fa167081cb59dc02d67da90e7a032152a97cb251566e78b3592f7b399.json"
    },
    {
      "id": "yuan-103",
      "category": "元曲",
      "title": "水仙子",
      "subtitle": "重观瀑布",
      "author": "乔吉",
      "dynasty": "元",
      "content": "天机织罢月梭闲，石壁高垂雪练寒，冰丝带雨悬霄汉。\n几千年晒未干，露华凉人怯衣单。似白虹饮涧，玉龙下山，晴雪飞滩。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "ca3428bb11908e0ae631370bb2b0b916ca50a4062d337bb8b6ada2c387a8e99a",
      "estimatedOutput": 712,
      "resultPath": "expansion/working/v2/results/yuan-103--ca3428bb11908e0ae631370bb2b0b916ca50a4062d337bb8b6ada2c387a8e99a.json"
    },
    {
      "id": "yuan-104",
      "category": "元曲",
      "title": "节节高",
      "subtitle": "题洞庭鹿角庙壁",
      "author": "卢挚",
      "dynasty": "元",
      "content": "雨晴云散，满江明月。风微浪息，扁舟一叶。半夜心，三生梦，万里别，闷倚篷窗睡些。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "fd9e52b378aeca503c4ebb0626b02785527c8e4a4b90913a4ebdd59850d652cf",
      "estimatedOutput": 678,
      "resultPath": "expansion/working/v2/results/yuan-104--fd9e52b378aeca503c4ebb0626b02785527c8e4a4b90913a4ebdd59850d652cf.json"
    },
    {
      "id": "yuan-105",
      "category": "元曲",
      "title": "拨不断",
      "subtitle": "酒杯深",
      "author": "马致远",
      "dynasty": "元",
      "content": "酒杯深，故人心。相逢且莫推辞饮，君若歌时我慢斟。\n屈原清死由他恁，醉和醒争甚！",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "2aa97da90406c85e51413c77ba93bca603cc29a40d5678072123d532809774cb",
      "estimatedOutput": 678,
      "resultPath": "expansion/working/v2/results/yuan-105--2aa97da90406c85e51413c77ba93bca603cc29a40d5678072123d532809774cb.json"
    },
    {
      "id": "yuan-106",
      "category": "元曲",
      "title": "得胜乐",
      "subtitle": "夏",
      "author": "白朴",
      "dynasty": "元",
      "content": "酷暑天，葵榴发，喷鼻香十里荷花。\n兰舟斜缆垂杨下，只宜铺枕簟、向凉亭披襟散发。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "eb4e188ddd3c41b56bf1d9e04bd281aebaf97b2b0771c02af4e1326175d94649",
      "estimatedOutput": 678,
      "resultPath": "expansion/working/v2/results/yuan-106--eb4e188ddd3c41b56bf1d9e04bd281aebaf97b2b0771c02af4e1326175d94649.json"
    },
    {
      "id": "yuan-107",
      "category": "元曲",
      "title": "醉扶归",
      "subtitle": "秃指甲",
      "author": "关汉卿",
      "dynasty": "元",
      "content": "十指如枯笋，和袖捧金樽；杀银筝字不真，揉痒天生钝。\n纵有相思泪痕，索把拳头揾。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "31b60aa6e242a16be5344f18d911f94ce53b986c7ff29a2adc975f8c04f0a878",
      "estimatedOutput": 678,
      "resultPath": "expansion/working/v2/results/yuan-107--31b60aa6e242a16be5344f18d911f94ce53b986c7ff29a2adc975f8c04f0a878.json"
    },
    {
      "id": "yuan-108",
      "category": "元曲",
      "title": "一半儿",
      "subtitle": "花边娇月静妆楼",
      "author": "张可久",
      "dynasty": "元",
      "content": "花边娇月静妆楼，叶底沧波冷翠沟，池上好风闲御舟。\n可怜秋，一半儿芙蓉一半儿柳。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "b430d466009f561d0cf8b1a9dc86077f6289efdbffd14cd614ce95924bca07b0",
      "estimatedOutput": 678,
      "resultPath": "expansion/working/v2/results/yuan-108--b430d466009f561d0cf8b1a9dc86077f6289efdbffd14cd614ce95924bca07b0.json"
    },
    {
      "id": "yuan-109",
      "category": "元曲",
      "title": "清江引",
      "subtitle": "相思",
      "author": "徐再思",
      "dynasty": "元",
      "content": "相思有如少债的，每日相催逼。常挑着一担愁，准不了三分利。这本钱见他时才算得。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "6e29d776c048e1621eca8c2bc3f4ff56b989fa033480fc2c7e58af2b959b7481",
