    {
      "id": "song-675",
      "category": "宋词",
      "title": "玉楼春",
      "subtitle": "蝶飞芳草花飞路",
      "author": "欧阳修",
      "dynasty": "宋",
      "content": "蝶飞芳草花飞路。\n把酒已嗟春色暮。\n当时枝上落残花，今日水流何处去。\n楼前独绕鸣蝉树。\n忆把芳条吹暖絮。\n红莲绿芰亦芳菲，不奈金风兼玉露。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "2edfebd96cd595b4364a75b08b3da6ab331736177a10eec89892c7959cfc23eb",
      "estimatedOutput": 738,
      "resultPath": "expansion/working/v2/results/song-675--2edfebd96cd595b4364a75b08b3da6ab331736177a10eec89892c7959cfc23eb.json"
    },
    {
      "id": "song-676",
      "category": "宋词",
      "title": "玉楼春",
      "subtitle": "红条约束琼肌稳",
      "author": "欧阳修",
      "dynasty": "宋",
      "content": "红条约束琼肌稳。\n拍碎香檀催急衮。\n陇头呜咽水声繁，叶下间关莺语近。\n美人才子传芳信。\n明月清风伤别恨。\n未知何处有知音，常为此情留此恨。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "845e003181856fe67782da3ea97bd9362af72741732f92fe6d7cd002100529e3",
      "estimatedOutput": 738,
      "resultPath": "expansion/working/v2/results/song-676--845e003181856fe67782da3ea97bd9362af72741732f92fe6d7cd002100529e3.json"
    },
    {
      "id": "song-677",
      "category": "宋词",
      "title": "玉楼春",
      "subtitle": "檀槽碎响金丝拨",
      "author": "欧阳修",
      "dynasty": "宋",
      "content": "檀槽碎响金丝拨。\n露湿浔阳江上月。\n不知商妇为谁愁，一曲行人留夜发。\n画堂花月新声别。\n红蕊调长弹未彻。\n暗将深意祝胶弦，唯愿弦弦无断绝。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "454396cb5b476106c2750dc4822cee12f20eb1169a99407d8465b06751437138",
      "estimatedOutput": 738,
      "resultPath": "expansion/working/v2/results/song-677--454396cb5b476106c2750dc4822cee12f20eb1169a99407d8465b06751437138.json"
    },
    {
      "id": "song-678",
      "category": "宋词",
      "title": "玉楼春",
      "subtitle": "春葱指甲轻拢拈",
      "author": "欧阳修",
      "dynasty": "宋",
      "content": "春葱指甲轻拢拈。\n五彩垂条双袖卷。\n雪香浓透紫檀槽，胡语急随红玉腕。\n当头一曲情何限。\n入破铮鏦金凤战。\n百分芳酒祝长春，再拜敛容抬粉面。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "e637a4396f7dcc260f794e98e4d41ba8f04c8a343c1c3462f5b71256a1b320d3",
      "estimatedOutput": 738,
      "resultPath": "expansion/working/v2/results/song-678--e637a4396f7dcc260f794e98e4d41ba8f04c8a343c1c3462f5b71256a1b320d3.json"
    },
    {
      "id": "song-679",
      "category": "宋词",
      "title": "玉楼春",
      "subtitle": "金花盏面红烟透",
      "author": "欧阳修",
      "dynasty": "宋",
      "content": "金花盏面红烟透。\n舞急香茵随步皱。\n青春才子有新词，红粉佳人重劝酒。\n也知自为伤春瘦。\n归骑休交银烛候。\n拟将沈醉为清欢，无奈醒来还感旧。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "8108bac890a0a943d0086c03a68e37c01de3a799ce6f12c869c077eefe74b7ad",
      "estimatedOutput": 738,
      "resultPath": "expansion/working/v2/results/song-679--8108bac890a0a943d0086c03a68e37c01de3a799ce6f12c869c077eefe74b7ad.json"
    },
    {
      "id": "song-680",
      "category": "宋词",
      "title": "玉楼春",
      "subtitle": "雪云乍变春云簇",
      "author": "欧阳修",
      "dynasty": "宋",
      "content": "雪云乍变春云簇。\n渐觉年华堪送目。\n北枝梅蕊犯寒开，南浦波纹如酒绿。\n芳菲次第还相续。\n不奈情多无处足。\n尊前百计得春归，莫为伤春歌黛蹙。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "b307785cae5ae2be00842bd988f9a927aee3bc2615b459b021ff7b79f61df7a1",
      "estimatedOutput": 738,
      "resultPath": "expansion/working/v2/results/song-680--b307785cae5ae2be00842bd988f9a927aee3bc2615b459b021ff7b79f61df7a1.json"
    },
    {
      "id": "song-681",
      "category": "宋词",
      "title": "玉楼春",
      "subtitle": "黄金弄色轻于粉",
      "author": "欧阳修",
      "dynasty": "宋",
      "content": "黄金弄色轻於粉。\n濯濯春条如水嫩。\n为缘力薄未禁风，不奈多娇长似困。\n腰柔乍怯人相近。\n眉小未知春有恨。\n劝君著意惜芳菲，莫待行人攀折尽。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "e280f6798d37bee502c4470e7605bf792c613595e3bad8cce4c705ba33738e22",
      "estimatedOutput": 738,
      "resultPath": "expansion/working/v2/results/song-681--e280f6798d37bee502c4470e7605bf792c613595e3bad8cce4c705ba33738e22.json"
    },
    {
      "id": "song-682",
      "category": "宋词",
      "title": "玉楼春",
      "subtitle": "珠帘半下香销印",
      "author": "欧阳修",
      "dynasty": "宋",
      "content": "珠帘半下香销印。\n二月东风催柳信。\n琵琶傍畔且寻思，鹦鹉前头休借问。\n惊鸿过后生离恨。\n红日长时添酒困。\n未知心在阿谁边，满眼泪珠言不尽。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "dc99e21583e4b4a267abbfc47830f738f2aa2833f9faf4e328f1b65f45c80418",
      "estimatedOutput": 738,
      "resultPath": "expansion/working/v2/results/song-682--dc99e21583e4b4a267abbfc47830f738f2aa2833f9faf4e328f1b65f45c80418.json"
    },
    {
      "id": "song-683",
      "category": "宋词",
      "title": "玉楼春",
      "subtitle": "沈沈庭院莺吟弄",
      "author": "欧阳修",
      "dynasty": "宋",
      "content": "沈沈庭院莺吟弄。\n日暖烟和春气重。\n绿杨娇眼为谁回，芳草深心空自动。\n倚阑无语伤离凤。\n一片风情无处用。\n寻思还有旧家心，蝴蝶时时来役梦。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "e9168b073ba39f23c7f3186f1777184642b9cbd45dd17b0e9dbe17d5a12031ad",
      "estimatedOutput": 738,
      "resultPath": "expansion/working/v2/results/song-683--e9168b073ba39f23c7f3186f1777184642b9cbd45dd17b0e9dbe17d5a12031ad.json"
    },
    {
      "id": "song-684",
      "category": "宋词",
      "title": "玉楼春",
      "subtitle": "去时梅萼初凝粉",
      "author": "欧阳修",
      "dynasty": "宋",
      "content": "去时梅萼初凝粉。\n不觉小桃风力损。\n梨花最晚又凋零，何事归期无定准。\n阑干倚遍重来凭。\n泪粉偷将红袖印。\n蜘蛛喜鹊误人多，似此无凭安足信。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "8c7c1868b4695a48ce893987450c2d868ddecfd8d29139b96a693f58d34ec91d",
      "estimatedOutput": 738,
      "resultPath": "expansion/working/v2/results/song-684--8c7c1868b4695a48ce893987450c2d868ddecfd8d29139b96a693f58d34ec91d.json"
    },
    {
      "id": "song-685",
      "category": "宋词",
      "title": "玉楼春",
      "subtitle": "酒美春浓花世界",
      "author": "欧阳修",
      "dynasty": "宋",
      "content": "酒美春浓花世界。\n得意人人千万态。\n莫教辜负艳阳天，过了堆金何处买。\n已去少年无计奈。\n且愿芳心长恁在。\n闲愁一点上心来，算得东风吹不解。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "9dd60fd4f2023273089f225a10a8732f60f4b6af2ccd59bf2c776928fd56f376",
