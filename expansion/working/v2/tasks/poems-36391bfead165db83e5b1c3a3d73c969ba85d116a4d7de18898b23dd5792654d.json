    },
    {
      "id": "song-092",
      "category": "宋词",
      "title": "南歌子",
      "subtitle": "天上星河转",
      "author": "李清照",
      "dynasty": "宋",
      "content": "天上星河转，人间帘幕垂。凉生枕簟泪痕滋。起解罗衣聊问、夜何其。\n翠贴莲蓬小，金销藕叶稀。旧时天气旧时衣。只有情怀不似、旧家时。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "c93209b63e7f2664ee44f9643d156e3566fca0956a39e2d5d8447482831b8764",
      "estimatedOutput": 726,
      "resultPath": "expansion/working/v2/results/song-092--c93209b63e7f2664ee44f9643d156e3566fca0956a39e2d5d8447482831b8764.json"
    },
    {
      "id": "song-093",
      "category": "宋词",
      "title": "点绛唇",
      "subtitle": "桃源",
      "author": "秦观",
      "dynasty": "宋",
      "content": "醉漾轻舟，信流引到花深处。尘缘相误，无计花间住。 \n烟水茫茫，千里斜阳暮。山无数，乱红如雨。不记来时路。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "59b0f1fc59cee291cf01e99cf747b32aff41b2a02d16d1121a7a57ca7aa7a6db",
