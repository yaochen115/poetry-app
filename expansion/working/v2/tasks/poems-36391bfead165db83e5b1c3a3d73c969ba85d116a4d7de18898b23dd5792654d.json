      "resultPath": "expansion/working/v2/results/song-088--d2ddd1cf620e4c29f7ac95c1af24f93db24eef5eb96506ad247d68fd77bad979.json"
    },
    {
      "id": "song-089",
      "category": "宋词",
      "title": "菩萨蛮",
      "subtitle": "回文夏闺怨",
      "author": "苏轼",
      "dynasty": "宋",
      "content": "柳庭风静人眠昼，昼眠人静风庭柳。香汗薄衫凉，凉衫薄汗香。\n手红冰碗藕，藕碗冰红手。郎笑藕丝长，长丝藕笑郎。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "c9e23f148e9fe3870650bb0096cafb98f9c9a09d3d009ec28d93c73fb31ab6ef",
      "estimatedOutput": 706,
