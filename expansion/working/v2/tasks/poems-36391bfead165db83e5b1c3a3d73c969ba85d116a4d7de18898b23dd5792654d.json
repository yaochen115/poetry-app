    {
      "id": "song-087",
      "category": "宋词",
      "title": "如梦令",
      "subtitle": "水垢何曾相受",
      "author": "苏轼",
      "dynasty": "宋",
      "content": "水垢何曾相受。细看两俱无有。寄语揩背人，尽日劳君挥肘。轻手，轻手，居士本来无垢。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "c414a1609b8f51ee19af5889951b2bb217eba7f4f80cd148a87f17c282647e8b",
