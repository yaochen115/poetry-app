    },
    {
      "id": "song-090",
      "category": "宋词",
      "title": "菩萨蛮",
      "subtitle": "花明月暗笼轻雾",
      "author": "李煜",
      "dynasty": "五代·南唐",
      "content": "花明月暗笼轻雾，今宵好向郎边去。刬袜步香阶，手提金缕鞋。画堂南畔见，一向偎人颤。奴为出来难，教君恣意怜。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "adec799370c567c1239f7204a54527b638377fba2e85fca28edd6dd25b1cb2d7",
      "estimatedOutput": 704,
      "resultPath": "expansion/working/v2/results/song-090--adec799370c567c1239f7204a54527b638377fba2e85fca28edd6dd25b1cb2d7.json"
    },
    {
      "id": "song-091",
      "category": "宋词",
      "title": "西江月",
      "subtitle": "宝髻松松挽就",
      "author": "司马光",
      "dynasty": "宋",
      "content": "宝髻松松挽就，铅华淡淡妆成。青烟翠雾罩轻盈，飞絮游丝无定。\n相见争如不见，有情何似无情。笙歌散后酒初醒，深院月斜人静。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "38c20e48c3e1efc4f51bc1b6f5b65dd1aab68392d4456091f4a722944de8e1b8",
      "estimatedOutput": 718,
