    },
    {
      "id": "song-088",
      "category": "宋词",
      "title": "西江月",
      "subtitle": "梅花",
      "author": "苏轼",
      "dynasty": "宋",
      "content": "玉骨那愁瘴雾，冰姿自有仙风。海仙时遣探芳丛。倒挂绿毛么凤。\n素面翻嫌粉涴，洗妆不褪唇红。高情已逐晓云空。不与梨花同梦。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "d2ddd1cf620e4c29f7ac95c1af24f93db24eef5eb96506ad247d68fd77bad979",
