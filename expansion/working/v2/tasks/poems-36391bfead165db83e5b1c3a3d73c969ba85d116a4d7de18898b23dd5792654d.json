    },
    {
      "id": "song-095",
      "category": "宋词",
      "title": "忆秦娥",
      "subtitle": "情脉脉",
      "author": "程垓",
      "dynasty": "宋",
      "content": "情脉脉。半黄橙子和香擘。和香擘。分明记得，袖香熏窄。 \n别来人远关山隔。见梅不忍和花摘。和花摘。有书无雁，寄谁归得。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "aef35ab963148f684fc22adf6b39fa25e48c154d20b19a76bf45072d7b087446",
      "estimatedOutput": 716,
      "resultPath": "expansion/working/v2/results/song-095--aef35ab963148f684fc22adf6b39fa25e48c154d20b19a76bf45072d7b087446.json"
    },
    {
      "id": "song-096",
      "category": "宋词",
      "title": "减字木兰花",
      "subtitle": "卖花担上",
      "author": "李清照",
      "dynasty": "宋",
      "content": "卖花担上。买得一枝春欲放。泪染轻匀。犹带彤霞晓露痕。 \n怕郎猜道。奴面不如花面好。云鬓斜簪。徒要教郎比并看。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "1bd48d5aaf98be969e29c2bb19977e521fc0da54d651f4e68ae7c77943d72a8e",
