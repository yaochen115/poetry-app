    },
    {
      "id": "song-094",
      "category": "宋词",
      "title": "浣溪沙",
      "subtitle": "缥缈红妆照浅溪",
      "author": "苏轼",
      "dynasty": "宋",
      "content": "缥缈红妆照浅溪。薄云疏雨不成泥。送君何处古台西。\n废沼夜来秋水满，茂林深处晚莺啼。行人肠断草凄迷。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "4a4d22d5a1fee05fceb436d3a8128c00dea21456844b5e39933e4422b602a63b",
