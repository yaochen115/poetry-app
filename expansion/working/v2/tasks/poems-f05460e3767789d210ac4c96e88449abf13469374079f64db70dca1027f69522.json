    },
    {
      "id": "song-1012",
      "category": "宋词",
      "title": "更漏子",
      "subtitle": "槛花稀池草遍冷",
      "author": "晏几道",
      "dynasty": "宋",
      "content": "槛花稀，池草遍。\n冷落吹笙庭院。\n人去日，燕西飞。\n燕归人未归。\n数书期，寻梦意。\n弹指一年春事。\n新怅望，旧悲凉。\n不堪红日长。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "fc8953a84d5da3434362268974b8b833d75aacd505a29ac773086019ff6afdba",
      "estimatedOutput": 730,
      "resultPath": "expansion/working/v2/results/song-1012--fc8953a84d5da3434362268974b8b833d75aacd505a29ac773086019ff6afdba.json"
    },
    {
      "id": "song-1013",
      "category": "宋词",
      "title": "更漏子",
      "subtitle": "柳间眠花里醉不",
      "author": "晏几道",
      "dynasty": "宋",
      "content": "柳间眠，花里醉。\n不惜绣裙铺地。\n钗燕重，鬓蝉轻。\n一双梅子青。\n粉笺书，罗袖泪。\n还有可怜新意。\n遮闷绿，掩羞红。\n晚来团扇风。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "e9f6c4afec845b26bd1d11f0e22ce47d23c5b24b0b5e54fd69c19a6d49901e3c",
      "estimatedOutput": 730,
      "resultPath": "expansion/working/v2/results/song-1013--e9f6c4afec845b26bd1d11f0e22ce47d23c5b24b0b5e54fd69c19a6d49901e3c.json"
    },
    {
      "id": "song-1014",
      "category": "宋词",
      "title": "更漏子",
      "subtitle": "露华高风信远宿",
      "author": "晏几道",
      "dynasty": "宋",
      "content": "露华高，风信远。\n宿醉画帘低卷。\n梳洗倦，冶游慵。\n绿窗春睡浓。\n彩条轻，金缕重。\n昨日小桥相送。\n芳草恨，落花愁。\n去年同倚楼。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "7ea9ba9f61bb46e94700d9bb863a62879693de517893191b9aa9d3bf01b50bc6",
      "estimatedOutput": 730,
      "resultPath": "expansion/working/v2/results/song-1014--7ea9ba9f61bb46e94700d9bb863a62879693de517893191b9aa9d3bf01b50bc6.json"
    },
    {
      "id": "song-1015",
      "category": "宋词",
      "title": "更漏子",
      "subtitle": "出墙花当路柳借",
      "author": "晏几道",
      "dynasty": "宋",
      "content": "出墙花，当路柳。\n借问芳心谁有。\n红解笑，绿能颦。\n千般恼乱春。\n北来人，南去客。\n朝暮等闲攀折。\n怜晚秀，惜残阳。\n情知枉断肠。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "a1026015ff3cbc8b50c171e999467525f0de293bf28b57eaacaa1982c9f8e7e1",
      "estimatedOutput": 730,
      "resultPath": "expansion/working/v2/results/song-1015--a1026015ff3cbc8b50c171e999467525f0de293bf28b57eaacaa1982c9f8e7e1.json"
    },
    {
      "id": "song-1016",
      "category": "宋词",
      "title": "更漏子",
      "subtitle": "欲论心先掩泪零",
      "author": "晏几道",
      "dynasty": "宋",
      "content": "欲论心，先掩泪。\n零落去年风味。\n闲卧处，不言时。\n愁多只自知。\n到情深，俱是怨。\n惟有梦中相见。\n犹似旧，奈人禁。\n偎人说寸心。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "05c9bb7da398206a933afd0c41432a35bc9af6846ae03da76324f5e230592d2b",
      "estimatedOutput": 730,
      "resultPath": "expansion/working/v2/results/song-1016--05c9bb7da398206a933afd0c41432a35bc9af6846ae03da76324f5e230592d2b.json"
    },
    {
      "id": "song-1017",
      "category": "宋词",
      "title": "浪淘沙",
      "subtitle": "高阁对横塘新燕",
      "author": "晏几道",
      "dynasty": "宋",
      "content": "高阁对横塘。\n新燕年光。\n柳花残梦隔潇湘。\n绿浦归帆看不见，还是斜阳。\n一笑解愁肠。\n人会娥妆。\n藕丝衫袖郁金香。\n曳雪牵云留客醉，且伴春狂。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "780654eeb40ecab8f8c37f4be5dd2e5b19cf5b4010f4f0be04acd977bdc3da11",
      "estimatedOutput": 742,
      "resultPath": "expansion/working/v2/results/song-1017--780654eeb40ecab8f8c37f4be5dd2e5b19cf5b4010f4f0be04acd977bdc3da11.json"
    },
    {
      "id": "song-1018",
      "category": "宋词",
      "title": "浪淘沙",
      "subtitle": "小绿间长红露蕊",
      "author": "晏几道",
      "dynasty": "宋",
      "content": "小绿间长红。\n露蕊烟丛。\n花开花落昔年同。\n惟恨花前携手处，往事成空。\n山远水重重。\n一笑难逢。\n已拼长在别离中。\n霜鬓知他从此去，几度春风。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "2e8e8408cd94cd81c3b767e85ad7fb9857701c7a204f1d02f8f31199843b2c4b",
      "estimatedOutput": 742,
      "resultPath": "expansion/working/v2/results/song-1018--2e8e8408cd94cd81c3b767e85ad7fb9857701c7a204f1d02f8f31199843b2c4b.json"
    },
    {
      "id": "song-1019",
      "category": "宋词",
      "title": "浪淘沙",
      "subtitle": "丽曲醉思仙十二",
      "author": "晏几道",
      "dynasty": "宋",
      "content": "丽曲醉思仙。\n十二哀弦。\n秾蛾叠柳脸红莲。\n多少雨条烟叶恨，红泪离筵。\n行子惜流年。\n鹈鴂枝边。\n吴堤春水舣兰船。\n南去北来今渐老，难负尊前。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "7653436d51975e8e45f80132de623c8346b732ec8fa06559434813fe273ef100",
      "estimatedOutput": 742,
      "resultPath": "expansion/working/v2/results/song-1019--7653436d51975e8e45f80132de623c8346b732ec8fa06559434813fe273ef100.json"
    },
    {
      "id": "song-1020",
      "category": "宋词",
      "title": "浪淘沙",
      "subtitle": "翠幕绮筵张淑景",
      "author": "晏几道",
      "dynasty": "宋",
      "content": "翠幕绮筵张。\n淑景难忘。\n阳关声巧绕雕梁。\n美酒十分谁与共，玉指持觞。\n晓枕梦高唐。\n略话衷肠。\n小山池院竹风凉。\n明夜月圆帘四卷，今夜思量。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "2cfed2a1ef4c15e646288d7e0b3d5f05ec79768a1eece9e927331c6be548ac0b",
      "estimatedOutput": 742,
      "resultPath": "expansion/working/v2/results/song-1020--2cfed2a1ef4c15e646288d7e0b3d5f05ec79768a1eece9e927331c6be548ac0b.json"
    },
    {
      "id": "song-1021",
      "category": "宋词",
      "title": "诉衷情",
      "subtitle": "种花人自蕊宫来",
      "author": "晏几道",
      "dynasty": "宋",
      "content": "种花人自蕊宫来。\n牵衣问小梅。\n今年芳意何似，应向旧枝开。\n凭寄语，谢瑶台。\n客无才。\n粉香传信，玉盏开筵，莫待春回。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "2bcb7b8c3c243bae8f6fa706419b9909ded04aca4dc34ddcd926c1fe3f7be35d",
