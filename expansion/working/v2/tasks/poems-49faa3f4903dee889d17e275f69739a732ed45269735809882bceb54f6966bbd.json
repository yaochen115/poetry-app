    },
    {
      "id": "song-651",
      "category": "宋词",
      "title": "渔家傲",
      "subtitle": "花底忽闻敲两桨",
      "author": "欧阳修",
      "dynasty": "宋",
      "content": "花底忽闻敲两桨。\n逡巡女伴来寻访。\n酒盏旋将荷叶当。\n莲舟荡。\n时时盏里生红浪。\n花气酒香清厮酿。\n花腮酒面红相向。\n醉倚绿阴眠一饷。\n惊起望。\n船头阁在沙滩上。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "007cc0db04c332b060ff8dc8af5cd67acb6ac0427fcb14c1175ab00e60a47aa7",
      "estimatedOutput": 762,
      "resultPath": "expansion/working/v2/results/song-651--007cc0db04c332b060ff8dc8af5cd67acb6ac0427fcb14c1175ab00e60a47aa7.json"
    },
    {
      "id": "song-652",
      "category": "宋词",
      "title": "渔家傲",
      "subtitle": "叶有清风花有露",
      "author": "欧阳修",
      "dynasty": "宋",
      "content": "叶有清风花有露。\n叶笼花罩鸳鸯侣。\n白锦顶丝红锦羽。\n莲女妒。\n惊飞不许长相聚。\n日脚沈红天色暮。\n青凉伞上微微雨。\n早是水寒无宿处。\n须回步。\n枉教雨里分飞去。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "0cd3e47d42a98268c754021685520c3b17ad708065bb3e9ba1b71bd081d88866",
      "estimatedOutput": 762,
      "resultPath": "expansion/working/v2/results/song-652--0cd3e47d42a98268c754021685520c3b17ad708065bb3e9ba1b71bd081d88866.json"
    },
    {
      "id": "song-653",
      "category": "宋词",
      "title": "渔家傲",
      "subtitle": "荷叶田田青照水",
      "author": "欧阳修",
      "dynasty": "宋",
      "content": "荷叶田田青照水。\n孤舟挽在花阴底。\n昨夜萧萧疏雨坠。\n愁不寐。\n朝来又觉西风起。\n雨摆风摇金蕊碎。\n合欢枝上香房翠。\n莲子与人长厮类。\n无好意。\n年年苦在中心里。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "48418c9d651a85dccdc4ed3c11778c39c5b7c81523b9880cbe7ca3bf37f1159f",
      "estimatedOutput": 762,
      "resultPath": "expansion/working/v2/results/song-653--48418c9d651a85dccdc4ed3c11778c39c5b7c81523b9880cbe7ca3bf37f1159f.json"
    },
    {
      "id": "song-654",
      "category": "宋词",
      "title": "渔家傲",
      "subtitle": "叶重如将青玉亚",
      "author": "欧阳修",
      "dynasty": "宋",
      "content": "叶重如将青玉亚。\n花轻疑是红绡挂。\n颜色清新香脱洒。\n堪长价。\n牡丹怎得称王者。\n雨笔露笺匀彩画。\n日炉风炭薰兰麝。\n天与多情丝一把。\n谁厮惹。\n千条万缕萦心下。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "e87af9024afe99a18295b97528ddd3211b00003cfeb19a2a186cc5703013eea6",
      "estimatedOutput": 762,
      "resultPath": "expansion/working/v2/results/song-654--e87af9024afe99a18295b97528ddd3211b00003cfeb19a2a186cc5703013eea6.json"
    },
    {
      "id": "song-655",
      "category": "宋词",
      "title": "渔家傲",
      "subtitle": "粉蕊丹青描不得",
      "author": "欧阳修",
      "dynasty": "宋",
      "content": "粉蕊丹青描不得。\n金针线线功难敌。\n谁傍暗香轻采摘。\n风淅淅。\n船头触散双鸂鶒。\n夜雨染成天水碧。\n朝阳借出胭脂色。\n欲落又开人共惜。\n秋气逼。\n盘中已见新荷的。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "b49545114185345ba216e7a7fa4db5841d9622c2c85efa180209f9410f679660",
      "estimatedOutput": 762,
      "resultPath": "expansion/working/v2/results/song-655--b49545114185345ba216e7a7fa4db5841d9622c2c85efa180209f9410f679660.json"
    },
    {
      "id": "song-656",
      "category": "宋词",
      "title": "渔家傲",
      "subtitle": "幽鹭谩来窥品格",
      "author": "欧阳修",
      "dynasty": "宋",
      "content": "幽鹭谩来窥品格。\n双鱼岂解传消息。\n绿柄嫩香频采摘。\n心似织。\n条条不断谁牵役。\n珠泪暗和清露滴。\n罗衣染尽秋江色。\n对面不言情脉脉。\n烟水隔。\n无人说似长相忆。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "7b8a8fc090865a2808a42607215e329740f88600a68c5d7e5840d0fe2eadc009",
      "estimatedOutput": 762,
      "resultPath": "expansion/working/v2/results/song-656--7b8a8fc090865a2808a42607215e329740f88600a68c5d7e5840d0fe2eadc009.json"
    },
    {
      "id": "song-657",
      "category": "宋词",
      "title": "渔家傲",
      "subtitle": "楚国细腰元自瘦",
      "author": "欧阳修",
      "dynasty": "宋",
      "content": "楚国细腰元自瘦。\n文君腻脸谁描就。\n日夜鼓声催箭漏。\n昏复昼。\n红颜岂得长如旧。\n醉拆嫩房红蕊嗅。\n天丝不断清香透。\n却傍小阑凝望久。\n风满袖。\n西池月上人归后。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "cb59e5383a9aaede7183c3d6d78ca39c8e449058133728bac8d5f59fda7958a1",
      "estimatedOutput": 762,
      "resultPath": "expansion/working/v2/results/song-657--cb59e5383a9aaede7183c3d6d78ca39c8e449058133728bac8d5f59fda7958a1.json"
    },
    {
      "id": "song-658",
      "category": "宋词",
      "title": "渔家傲",
      "subtitle": "喜鹊填河仙浪浅",
      "author": "欧阳修",
      "dynasty": "宋",
      "content": "喜鹊填河仙浪浅。\n云軿早在星桥畔。\n街鼓黄昏霞尾暗。\n炎光敛。\n金钩侧倒天西面。\n一别经年今始见。\n新欢往恨知何限。\n天上佳期贪眷恋。\n良宵短。\n人间不合催银箭。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "23e100d499d8814f38dc85aa1b13a0407e820d5372a671e21d3561c240e82191",
      "estimatedOutput": 762,
      "resultPath": "expansion/working/v2/results/song-658--23e100d499d8814f38dc85aa1b13a0407e820d5372a671e21d3561c240e82191.json"
    },
    {
      "id": "song-659",
      "category": "宋词",
      "title": "渔家傲",
      "subtitle": "乞巧楼头云幔卷",
      "author": "欧阳修",
      "dynasty": "宋",
      "content": "乞巧楼头云幔卷。\n浮花催洗严妆面。\n花上蛛丝寻得遍。\n颦笑浅。\n双眸望月牵红线。\n奕奕天河光不断。\n有人正在长生殿。\n暗付金钗清夜半。\n千秋愿。\n年年此会长相见。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "2facb30e12ceab0ef996400125ff88bf1eaaa19f098552acdcd8e5a6f7dc6284",
      "estimatedOutput": 762,
      "resultPath": "expansion/working/v2/results/song-659--2facb30e12ceab0ef996400125ff88bf1eaaa19f098552acdcd8e5a6f7dc6284.json"
    },
    {
      "id": "song-660",
      "category": "宋词",
      "title": "渔家傲",
      "subtitle": "别恨长长欢计短",
      "author": "欧阳修",
      "dynasty": "宋",
      "content": "别恨长长欢计短。\n疏锺促漏真堪怨。\n此会此情都未半。\n星初转。\n鸾琴凤乐匆匆卷。\n河鼓无言西北盼。\n香蛾有恨东南远。\n脉脉横波珠泪满。\n归心乱。\n离肠便逐星桥断。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "8f7b12787e0707c48421ba1acc19cfe7562fc857e0c065b190c00875e1c4f722",
      "estimatedOutput": 762,
      "resultPath": "expansion/working/v2/results/song-660--8f7b12787e0707c48421ba1acc19cfe7562fc857e0c065b190c00875e1c4f722.json"
    },
    {
      "id": "song-661",
      "category": "宋词",
      "title": "渔家傲",
      "subtitle": "九日欢游何处好",
      "author": "欧阳修",
      "dynasty": "宋",
      "content": "九日欢游何处好。\n黄花万蕊雕阑绕。\n通体清香无俗调。\n天气好。\n烟滋露结功多少。\n日脚清寒高下照。\n宝钉密缀圆斜小。\n落叶西园风袅袅。\n催秋老。\n丛边莫厌金尊倒。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "678cb8156eda906b6c9449bd2d60d530a287220f7d26360c8b387d41f6e6b9a5",
