    {
      "id": "song-245",
      "category": "宋词",
      "title": "菩萨蛮",
      "subtitle": "绿芜墙绕青苔院",
      "author": "陈克",
      "dynasty": "宋",
      "content": "绿芜墙绕青苔院，中庭日淡芭蕉卷。蝴蝶上阶飞，烘帘自在垂。\n玉钩双语燕，宝甃杨花转。几处簸钱声，绿窗春睡轻。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "077c325b7147dcbb11cbadb0a6a03a1a3b274c03b8d5a4db8fcd600b168a99e3",
