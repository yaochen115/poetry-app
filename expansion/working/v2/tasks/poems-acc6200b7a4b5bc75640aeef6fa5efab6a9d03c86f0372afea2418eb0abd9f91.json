    },
    {
      "id": "song-244",
      "category": "宋词",
      "title": "鹊桥仙",
      "subtitle": "华灯纵博",
      "author": "陆游",
      "dynasty": "宋",
      "content": "华灯纵博，雕鞍驰射，谁记当年豪举。酒徒一半取封侯，独去作、江边渔父。\n轻舟八尺，低篷三扇，占断苹洲烟雨。镜湖元自属闲人，又何必、君恩赐与。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "152dfcd5ffde51337e989e0d2ee2ec7974e60e540a84f6e3d56bae29efa3f509",
