    },
    {
      "id": "song-640",
      "category": "宋词",
      "title": "蝶恋花",
      "subtitle": "独倚危楼风细细",
      "author": "欧阳修",
      "dynasty": "宋",
      "content": "独倚危楼风细细。\n望极离愁，黯黯生天际。\n草色山光残照里。\n无人会得凭阑意。\n也拟疏狂图一醉。\n对酒当歌，强饮还无味。\n衣带渐宽都不悔。\n况伊销得人憔悴。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "d491bb41fa6e486799b1085b86b42b99bcb3892c9de4333c8f0e35df4c3f29e9",
      "estimatedOutput": 754,
      "resultPath": "expansion/working/v2/results/song-640--d491bb41fa6e486799b1085b86b42b99bcb3892c9de4333c8f0e35df4c3f29e9.json"
    },
    {
      "id": "song-641",
      "category": "宋词",
      "title": "蝶恋花",
      "subtitle": "帘下清歌帘外宴",
      "author": "欧阳修",
      "dynasty": "宋",
      "content": "帘下清歌帘外宴。\n虽爱新声，不见如花面。\n牙板数敲珠一串。\n梁尘暗落琉璃盏。\n桐树花深孤凤怨。\n渐遏遥天，不放行云散。\n坐上少年听未惯。\n玉山将倒肠先断。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "0f007e7418aa64264cef82d28c910e4a8ed4783798e608de61b3184dd598c0c8",
      "estimatedOutput": 754,
      "resultPath": "expansion/working/v2/results/song-641--0f007e7418aa64264cef82d28c910e4a8ed4783798e608de61b3184dd598c0c8.json"
    },
    {
      "id": "song-642",
      "category": "宋词",
      "title": "蝶恋花",
      "subtitle": "翠苑红芳晴满目",
      "author": "欧阳修",
      "dynasty": "宋",
      "content": "翠苑红芳晴满目。\n绮席流莺，上下长相逐。\n紫陌闲随金轹辘。\n马蹄踏遍春郊绿。\n一觉年华春梦促。\n往事悠悠，百种寻思足。\n烟雨满楼山断续。\n人闲倚遍阑干曲。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "da58c403a145ba6d37b28a5fbe0c7477178b38c646858341b624e5d57c78ef33",
      "estimatedOutput": 754,
      "resultPath": "expansion/working/v2/results/song-642--da58c403a145ba6d37b28a5fbe0c7477178b38c646858341b624e5d57c78ef33.json"
    },
    {
      "id": "song-643",
      "category": "宋词",
      "title": "蝶恋花",
      "subtitle": "小院深深门掩亚",
      "author": "欧阳修",
      "dynasty": "宋",
      "content": "小院深深门掩亚。\n寂寞珠帘，画阁重重下。\n欲近禁烟微雨罢。\n绿杨深处秋千挂。\n傅粉狂游犹未舍。\n不念芳时，眉黛无人画。\n薄幸未归春去也。\n杏花零落香红谢。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "982ba8e801ac0aac1afaa951335077f2af799b5d1d1e0affd5fb720b3416115a",
      "estimatedOutput": 754,
      "resultPath": "expansion/working/v2/results/song-643--982ba8e801ac0aac1afaa951335077f2af799b5d1d1e0affd5fb720b3416115a.json"
    },
    {
      "id": "song-644",
      "category": "宋词",
      "title": "蝶恋花",
      "subtitle": "欲过清明烟雨细",
      "author": "欧阳修",
      "dynasty": "宋",
      "content": "欲过清明烟雨细。\n小槛临窗，点点残花坠。\n梁燕语多惊晓睡。\n银屏一半堆香被。\n新岁风光如旧岁。\n所恨征轮，渐渐程迢递。\n纵有远情难写寄。\n何妨解有相思泪。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "b422c009d46ec3e75d4d15b819ba32c362e0c065be8a63b0601a0c6ac5b32c84",
      "estimatedOutput": 754,
      "resultPath": "expansion/working/v2/results/song-644--b422c009d46ec3e75d4d15b819ba32c362e0c065be8a63b0601a0c6ac5b32c84.json"
    },
    {
      "id": "song-645",
      "category": "宋词",
      "title": "蝶恋花",
      "subtitle": "尝爱西湖春色早",
      "author": "欧阳修",
      "dynasty": "宋",
      "content": "尝爱西湖春色早。\n腊雪方销，已见桃开小。\n顷刻光阴都过了。\n如今绿暗红英少。\n且趁馀花谋一笑。\n况有笙歌，艳态相萦绕。\n老去风情应不到。\n凭君剩把芳尊倒。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "dda9200bcfd03a38a0ba02e5a72a9ef61f89bb3bc782a6c06ef87f0b41514aee",
      "estimatedOutput": 754,
      "resultPath": "expansion/working/v2/results/song-645--dda9200bcfd03a38a0ba02e5a72a9ef61f89bb3bc782a6c06ef87f0b41514aee.json"
    },
    {
      "id": "song-646",
      "category": "宋词",
      "title": "渔家傲",
      "subtitle": "十月小春梅蕊绽",
      "author": "欧阳修",
      "dynasty": "宋",
      "content": "十月小春梅蕊绽。\n红炉画阁新妆遍。\n锦帐美人贪睡暖。\n羞起晚。\n玉壶一夜冰澌满。\n楼上四垂帘不卷。\n天寒山色偏宜远。\n风急雁行吹字断。\n红日短。\n江天雪意云撩乱。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "624095087265107ebbff80efd96146e94baf2a8095806a37bd37ae1525b6c63e",
      "estimatedOutput": 762,
      "resultPath": "expansion/working/v2/results/song-646--624095087265107ebbff80efd96146e94baf2a8095806a37bd37ae1525b6c63e.json"
    },
    {
      "id": "song-647",
      "category": "宋词",
      "title": "渔家傲",
      "subtitle": "四纪才名天下重",
      "author": "欧阳修",
      "dynasty": "宋",
      "content": "四纪才名天下重。\n三朝构厦为梁栋。\n定册功成身退勇。\n辞荣宠。\n归来白首笙歌拥。\n顾我薄才无可用。\n君恩近许归田垅。\n今日一觞难得共。\n聊对捧。\n官奴为我高歌送。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "26a98b4fd5ef15c29c6b5989ef0bfbbb74a6e0fcb35cc5bc915fd0482e0b17f0",
      "estimatedOutput": 762,
      "resultPath": "expansion/working/v2/results/song-647--26a98b4fd5ef15c29c6b5989ef0bfbbb74a6e0fcb35cc5bc915fd0482e0b17f0.json"
    },
    {
      "id": "song-648",
      "category": "宋词",
      "title": "渔家傲",
      "subtitle": "暖日迟迟花袅袅",
      "author": "欧阳修",
      "dynasty": "宋",
      "content": "暖日迟迟花袅袅。\n人将红粉争花好。\n花不能言惟解笑。\n金壶倒。\n花开未老人年少。\n车马九门来扰扰。\n行人莫羡长安道。\n丹禁漏声衢鼓报。\n催昏晓。\n长安城里人先老。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "303c5070f40295f7de1f306a19f64a3794dcfd6d6b9511235df56ec522023104",
      "estimatedOutput": 762,
      "resultPath": "expansion/working/v2/results/song-648--303c5070f40295f7de1f306a19f64a3794dcfd6d6b9511235df56ec522023104.json"
    },
    {
      "id": "song-649",
      "category": "宋词",
      "title": "渔家傲",
      "subtitle": "红粉墙头花几树",
      "author": "欧阳修",
      "dynasty": "宋",
      "content": "红粉墙头花几树。\n落花片片和惊絮。\n墙外有楼花有主。\n寻花去。\n隔墙遥见秋千侣。\n绿索红旗双彩柱。\n行人只得偷回顾。\n肠断楼南金锁户。\n天欲暮。\n流莺飞到秋千处。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "f8fba05d0456e1160e037c9fb082db757afd9e2fc0810a7ef953f31ea671fbb4",
