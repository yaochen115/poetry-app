    },
    {
      "id": "song-119",
      "category": "宋词",
      "title": "卜算子",
      "subtitle": "片片蝶衣轻",
      "author": "刘克庄",
      "dynasty": "宋",
      "content": "片片蝶衣轻，点点猩红小。道是天公不惜花，百种千般巧。 \n朝见树头繁，暮见枝头少。道是天公果惜花，雨洗风吹了。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "85e75f13aac976b12c6f5c7d3b6d7a6345c65ae1de842a048ceb322ababedb4c",
