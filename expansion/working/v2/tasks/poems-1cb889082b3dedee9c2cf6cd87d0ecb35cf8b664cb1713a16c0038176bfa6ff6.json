    },
    {
      "id": "song-120",
      "category": "宋词",
      "title": "昭君怨",
      "subtitle": "咏荷上雨",
      "author": "杨万里",
      "dynasty": "宋",
      "content": "午梦扁舟花底，香满西湖烟水。急雨打篷声，梦初惊。\n却是池荷跳雨，散了真珠还聚。聚作水银窝，泻清波。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "a76c912121bbb832d8bf2277359028f1c04042c4309a0c8f9994690667348022",
      "estimatedOutput": 698,
      "resultPath": "expansion/working/v2/results/song-120--a76c912121bbb832d8bf2277359028f1c04042c4309a0c8f9994690667348022.json"
    },
    {
      "id": "song-121",
      "category": "宋词",
      "title": "浪淘沙",
      "subtitle": "一叶忽惊秋",
      "author": "贺铸",
      "dynasty": "宋",
      "content": "一叶忽惊秋。分付东流。殷勤为过白苹洲。洲上小楼帘半卷，应认归舟。 \n回首恋朋游。迹去心留。歌尘萧散梦云收。惟有尊前曾见月，相伴人愁。",
      "excerptOf": null,
      "excerptNote": "",
