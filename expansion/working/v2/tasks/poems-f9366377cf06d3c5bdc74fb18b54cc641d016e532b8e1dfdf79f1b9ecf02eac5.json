    },
    {
      "id": "song-783",
      "category": "宋词",
      "title": "点绛唇",
      "subtitle": "病起恹恹画堂花",
      "author": "韩琦",
      "dynasty": "宋",
      "content": "病起恹恹，画堂花谢添憔悴。\n乱红飘砌。\n滴尽胭脂泪。\n惆怅前春，谁向花前醉。\n愁无际。\n武陵回睇。\n人远波空翠。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "d3e1461a85c11192a63ce33def85ec8f8dc31c9ea3518d3cd6dc2a08d7d64d98",
      "estimatedOutput": 712,
      "resultPath": "expansion/working/v2/results/song-783--d3e1461a85c11192a63ce33def85ec8f8dc31c9ea3518d3cd6dc2a08d7d64d98.json"
    },
    {
      "id": "song-784",
      "category": "宋词",
      "title": "念奴娇",
      "subtitle": "杏花过雨渐残红",
      "author": "沈唐",
      "dynasty": "宋",
      "content": "杏花过雨，渐残红零落，胭脂颜色。\n流水飘香人渐远，难托春心脉脉。\n恨别王孙，墙阴目断，手把青梅摘。\n金鞍何处，绿杨依旧南陌。\n消散云雨须臾，多情因甚，有轻离轻拆。\n燕语千般，争解说、些子伊家消息。\n厚约深盟，除非重见，见了方端的。\n而今无奈，寸肠千恨堆积。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "f1886a04ef05bb0bb93dc3340df1afa65d80031e346d28d025ed5acbfa41017c",
      "estimatedOutput": 856,
      "resultPath": "expansion/working/v2/results/song-784--f1886a04ef05bb0bb93dc3340df1afa65d80031e346d28d025ed5acbfa41017c.json"
    },
    {
      "id": "song-785",
      "category": "宋词",
      "title": "望海潮",
      "subtitle": "山光凝翠川容如",
      "author": "沈唐",
      "dynasty": "宋",
      "content": "山光凝翠，川容如画，名都自古并州。\n箫鼓沸天，弓刀似水，连营十万貔貅。\n金骑走长楸。\n少年人一一，锦带吴钩。\n路入榆关，雁飞汾水正宜秋。\n追思昔日风流。\n有儒将醉吟，才子狂游。\n松偃旧亭，城高故国，空馀舞榭歌楼。\n方面倚贤候。\n便恐为霖雨，归去难留。\n好向西溪，恣携弦管宴兰舟。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "5e78f8ca039647b21b8d2e90a7936013319360819c712a1a8ccdd797d4b1e973",
      "estimatedOutput": 878,
      "resultPath": "expansion/working/v2/results/song-785--5e78f8ca039647b21b8d2e90a7936013319360819c712a1a8ccdd797d4b1e973.json"
    },
    {
      "id": "song-786",
      "category": "宋词",
      "title": "浣溪沙",
      "subtitle": "模样偏宜掌上怜",
      "author": "杜安世",
      "dynasty": "宋",
      "content": "模样偏宜掌上怜。\n云如双鬓玉如颜。\n身材轻妙眼儿单。\n幽会未成双怅望，深情欲诉两艰难。\n空教魂梦到巫山。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "0d9c198bb8cbdbde890dd65875bd5603f591e9a92f59e4578c9414a34a45176d",
      "estimatedOutput": 704,
      "resultPath": "expansion/working/v2/results/song-786--0d9c198bb8cbdbde890dd65875bd5603f591e9a92f59e4578c9414a34a45176d.json"
    },
    {
      "id": "song-787",
      "category": "宋词",
      "title": "浣溪沙",
      "subtitle": "横画功夫想未全",
      "author": "杜安世",
      "dynasty": "宋",
      "content": "横画功夫想未全。\n双双文彩羽仪鲜。\n和鸣偕老是天然。\n暮雨并深流细草，暖风交颈傍清涟。\n羡他真个好因缘。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "6fc9303dd3e5f01e2a6f533c836d0414599968ade1fbb39564990443aeec3f71",
      "estimatedOutput": 704,
