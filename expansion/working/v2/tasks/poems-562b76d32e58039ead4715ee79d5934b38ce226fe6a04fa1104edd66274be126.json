    {
      "id": "tang-726",
      "category": "唐诗",
      "title": "祭岳回重赠孟都督",
      "subtitle": "",
      "author": "韩翃",
      "dynasty": "唐",
      "content": "封作天齐王，清祠太山下。\n鲁公秋赛毕，晓日回高驾。\n从骑尽幽并，同人皆沈谢。\n自矜文武足，一醉寒溪夜。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "c6f34871a5e347c5e29a7fb27baefc0202e2c02576d5ccec1057194dd1a80aa8",
      "estimatedOutput": 702,
