    },
    {
      "id": "song-411",
      "category": "宋词",
      "title": "长相思",
      "subtitle": "",
      "author": "朱敦儒",
      "dynasty": "宋",
      "content": "海云黄。橘洲霜。如箭滩流石似羊。溪船十丈长。\n人难量。水难量。过险方知著甚忙。归休老醉乡。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "63ba0676345c0e4c5e3265993f080c51e561aa5be51aa6a801781c3633deaf36",
