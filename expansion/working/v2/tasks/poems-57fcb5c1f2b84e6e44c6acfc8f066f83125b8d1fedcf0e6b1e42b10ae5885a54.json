    },
    {
      "id": "song-413",
      "category": "宋词",
      "title": "减字木兰花",
      "subtitle": "清尊白发",
      "author": "陈师道",
      "dynasty": "宋",
      "content": "清尊白发。曾是登临年少客。不似当年。人与黄花两并妍。来愁去恨。十载相看情不尽。莫更思量。梦破春回枉断肠。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "349c92fc105815187fc8602fbb9a87c4d829ece782e21b6c48c1a4c8b17dfd05",
      "estimatedOutput": 704,
      "resultPath": "expansion/working/v2/results/song-413--349c92fc105815187fc8602fbb9a87c4d829ece782e21b6c48c1a4c8b17dfd05.json"
    },
    {
      "id": "song-414",
      "category": "宋词",
      "title": "摸鱼儿",
      "subtitle": "望关河",
      "author": "苏泂",
      "dynasty": "宋",
      "content": "望关河、试穷遥眼，新愁似丝千缕。刘郎豪气今何在，应是九疑三楚。堪恨处。便拚得、一生寂寞长羁旅。无人寄语。但吊麦伤桃，边松倚竹，空忆旧诗句。文章事，到底将身自误。功名难料迟暮。鹑衣箪食年年瘦，受侮世间儿女。君信否。尽县簿高门，岁晚谁青顾。何如引起。任槎上张骞，山中李广，商略尽风度。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "2e80a496c7d06ec0b44b14a088ac7fb1e8f2fd8b2a8879ec39d2bb373299b17a",
      "estimatedOutput": 880,
      "resultPath": "expansion/working/v2/results/song-414--2e80a496c7d06ec0b44b14a088ac7fb1e8f2fd8b2a8879ec39d2bb373299b17a.json"
    },
    {
      "id": "song-415",
      "category": "宋词",
      "title": "忆秦娥",
      "subtitle": "",
      "author": "王庭",
      "dynasty": "宋",
      "content": "梅花发。夜寒吹笛千山月。千山月。此时愁听，龙吟幽噎。\n数枝飞尽南枝雪。风光又作年时别。年时别。江头心绪，乱丝千结。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "f8f5434b1ee9b05ba41bf082879f3db6496a97110641a615b2d7b641620bbecc",
      "estimatedOutput": 714,
      "resultPath": "expansion/working/v2/results/song-415--f8f5434b1ee9b05ba41bf082879f3db6496a97110641a615b2d7b641620bbecc.json"
    },
    {
      "id": "song-416",
      "category": "宋词",
      "title": "玉楼春",
      "subtitle": "",
      "author": "晏几道",
      "dynasty": "宋",
      "content": "当年信道情无价。桃叶尊前论别夜。脸红心绪学梅妆，眉翠工夫如月画。\n来时醉倒旗亭下。知是阿谁扶上马。忆曾挑尽五更灯，不记临分多少话。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "247d04afbbf3f5f811716e765a888dd95fd3a04281c74f63d8183e19601eb31a",
      "estimatedOutput": 730,
      "resultPath": "expansion/working/v2/results/song-416--247d04afbbf3f5f811716e765a888dd95fd3a04281c74f63d8183e19601eb31a.json"
    },
    {
      "id": "song-417",
      "category": "宋词",
      "title": "水龙吟",
      "subtitle": "",
      "author": "汪莘",
      "dynasty": "宋",
      "content": "当年剪彩垂髫，超然便欲为仙去。世间俗状，人心狡计，不堪同住。\n每坐空山，独临古涧，神闲意寓。想瀛洲鸡犬，蓬莱猿鹤，应怅望，门前路。\n自昔侯王将相，几番成、落花飞絮。仰天醉眼，兴云妙手，年华迟暮。\n长揖烟尘，静朝日月，谁知幽素。正风清麟背，星垂海角，晓钟初寤。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "023e9d54f5656f9e2b66d2c901c5a486d04cda825450b074e14b335f646e41f1",
      "estimatedOutput": 858,
      "resultPath": "expansion/working/v2/results/song-417--023e9d54f5656f9e2b66d2c901c5a486d04cda825450b074e14b335f646e41f1.json"
    },
    {
      "id": "song-418",
      "category": "宋词",
      "title": "水调歌头",
      "subtitle": "",
      "author": "京镗",
      "dynasty": "宋",
      "content": "为郡邑之光。辄勉继严韵，以谢万分。\n百堞龟城北，江势远连空。杠梁济涉，浑似溪涧饮长虹。覆以翚飞华宇，载以鱼浮叠石，守护有神龙。好看发源水，滚滚尽流东。\n司马氏，凌云气，盖群公。当年题柱，从此奏赋动天容。果驾轺车使蜀，能致诸蛮臣汉，邛笮道仍通。寄语登桥者，努力继前功。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "57db23c0808a3baebd460910a7028d0ec40c5730c4e466f8b673e4d849bff008",
      "estimatedOutput": 866,
      "resultPath": "expansion/working/v2/results/song-418--57db23c0808a3baebd460910a7028d0ec40c5730c4e466f8b673e4d849bff008.json"
    },
    {
      "id": "song-419",
      "category": "宋词",
      "title": "渔家傲",
      "subtitle": "",
      "author": "欧阳修",
      "dynasty": "宋",
      "content": "一派潺湲流碧涨。新亭四面山相向。翠竹岭头明月上。迷俯仰。月轮正在泉中漾。\n更待高秋天气爽。菊花香里开新酿。酒美宾嘉真胜赏。红粉唱。山深分外歌声响。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "944b2e67d87b5298addcef6ebb7f6ce09b77372eba240d43ce31d38f0a79dafe",
      "estimatedOutput": 746,
      "resultPath": "expansion/working/v2/results/song-419--944b2e67d87b5298addcef6ebb7f6ce09b77372eba240d43ce31d38f0a79dafe.json"
    },
    {
      "id": "song-420",
      "category": "宋词",
      "title": "贺新郎",
      "subtitle": "知彼须知此",
      "author": "冯取洽",
      "dynasty": "宋",
      "content": "知彼须知此。问筹边、攻守规模，云何则是。景色愔愔犹日暮，壮士无由吐气。又安得、将如廉李。燕坐江沱甘自蹙，笑腐儒、枉楦朝家紫。用与舍，徒为耳。黄芦白苇迷千里。叹长淮、篱落空疏，仅馀残垒。读父兵书宁足恃，击楫谁盟江水。有识者、知其庸矣。多少英雄沈草野，岂堂堂、吾国无君子。起诸葛，总戎事。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "799f6d03e67fd8c9b115f94806c5ad698bd45455482ccf7b3dd2c8c2ff853aa9",
      "estimatedOutput": 884,
      "resultPath": "expansion/working/v2/results/song-420--799f6d03e67fd8c9b115f94806c5ad698bd45455482ccf7b3dd2c8c2ff853aa9.json"
    },
    {
      "id": "song-421",
      "category": "宋词",
      "title": "水调歌头",
      "subtitle": "天宇正高爽",
      "author": "吴潜",
      "dynasty": "宋",
      "content": "天宇正高爽，更蹑最高楼。长风为我驱驾，极目海山头。不用牛山孟浩，不用齐山杜牧，人景自堪酬。举酒酹空阔，汗漫与为游。\n捻黄花，怜白首，恨难收。颓龄使汝能制，何待更封留。眼底朱甍画栋，往往人非物是，蟋蟀自鸣秋。万里一搔首，无处著萧飕。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "8c3fd75fccdc80749b956c5124ec94857b6a3e329088f0d7717304956e148a02",
