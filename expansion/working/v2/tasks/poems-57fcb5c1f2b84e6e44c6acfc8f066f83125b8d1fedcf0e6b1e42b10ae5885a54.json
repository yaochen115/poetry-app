      "resultPath": "expansion/working/v2/results/song-411--63ba0676345c0e4c5e3265993f080c51e561aa5be51aa6a801781c3633deaf36.json"
    },
    {
      "id": "song-412",
      "category": "宋词",
      "title": "菩萨蛮",
      "subtitle": "霜天不管青山瘦",
      "author": "佚名",
      "dynasty": "宋",
      "content": "霜天不管青山瘦。轻云浅拂修眉皱。烟树隔潇湘。隔帆吹异香。影残春恨小。淡墨敧斜倒。无处著消愁。笛寒人倚楼。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "b5119e3406eba9e824aef62c523fbe3f7635f3a7d35eb50f17c2f92c8b95e540",
      "estimatedOutput": 704,
