      "resultPath": "expansion/working/v2/results/song-608--3802b7039fbb80213902a088ca9b7f069d19e91d2934fe451bcdc67bcf4e5e86.json"
    },
    {
      "id": "song-609",
      "category": "宋词",
      "title": "蝶恋花",
      "subtitle": "雨过蒲萄新涨绿",
      "author": "宋祁",
      "dynasty": "宋",
      "content": "雨过蒲萄新涨绿。\n苍玉盘倾，堕碎珠千斛。\n姬监拥前红簇簇。\n温泉初试真妃浴。\n驿使南来丹荔熟。\n故翦轻绡，一色颁时服。\n娇汗易晞凝醉玉。\n青凉不用香绵扑。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "01dd2fec5b838506c8662de0ad8d939b0425d764ae575ad54798b502fc32e12c",
      "estimatedOutput": 754,
      "resultPath": "expansion/working/v2/results/song-609--01dd2fec5b838506c8662de0ad8d939b0425d764ae575ad54798b502fc32e12c.json"
    },
    {
      "id": "song-610",
      "category": "宋词",
      "title": "蝶恋花",
      "subtitle": "绣幕茫茫罗帐卷",
      "author": "宋祁",
      "dynasty": "宋",
      "content": "绣幕茫茫罗帐卷。\n春睡腾腾，困入娇波慢。\n隐隐枕痕留玉脸。\n腻云斜溜钗头燕。\n远梦无端欢又散。\n泪落胭脂，界破蜂黄浅。\n整了翠鬟匀了面。\n芳心一寸情何限。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "8fddb997f64a6967a6ca44bc62a3baa6eabdb0c9afe46d87e834b07cefb0ebbb",
      "estimatedOutput": 754,
