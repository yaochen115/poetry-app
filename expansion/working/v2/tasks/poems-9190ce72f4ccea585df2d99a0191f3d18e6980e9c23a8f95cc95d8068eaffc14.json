    },
    {
      "id": "song-606",
      "category": "宋词",
      "title": "蝶恋花",
      "subtitle": "贴鬓香云双绾绿",
      "author": "李冠",
      "dynasty": "宋",
      "content": "贴鬓香云双绾绿。\n柳弱花娇，一点春心足。\n不肯玉箫闲度曲。\n恼人特把青蛾蹙。\n静夜溪桥霜薄屋。\n独影行歌，惊起双鸾宿。\n愁破酒阑闺梦熟。\n月斜窗外风敲竹。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "1359c5abe2c2a16a2923f1b2e69548059cf9cb055b69fcaf393e5c93abecd8b5",
      "estimatedOutput": 754,
      "resultPath": "expansion/working/v2/results/song-606--1359c5abe2c2a16a2923f1b2e69548059cf9cb055b69fcaf393e5c93abecd8b5.json"
    },
    {
      "id": "song-607",
      "category": "宋词",
      "title": "菩萨蛮",
      "subtitle": "娟娟侵鬓妆痕浅",
      "author": "谢绛",
      "dynasty": "宋",
      "content": "娟娟侵鬓妆痕浅。\n双眸相媚弯如翦。\n一瞬百般宜。\n无论笑与啼。\n酒阑思翠被。\n特故瞢腾地。\n生怕促归轮。\n微波先注人。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "018cd1df632b9fcca5ef7e33d622c0a16ab35e3d737d69f86d5e3bd9dee2f78a",
      "estimatedOutput": 718,
      "resultPath": "expansion/working/v2/results/song-607--018cd1df632b9fcca5ef7e33d622c0a16ab35e3d737d69f86d5e3bd9dee2f78a.json"
    },
    {
      "id": "song-608",
      "category": "宋词",
      "title": "诉衷情",
      "subtitle": "银缸夜永影长孤",
      "author": "谢绛",
      "dynasty": "宋",
      "content": "银缸夜永影长孤。\n香草续残炉。\n倚屏脉脉无语，粉泪不成珠。\n双粲枕，百娇壶。\n忆当初。\n君恩莫似，秋叶无情，欲向人疏。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "3802b7039fbb80213902a088ca9b7f069d19e91d2934fe451bcdc67bcf4e5e86",
