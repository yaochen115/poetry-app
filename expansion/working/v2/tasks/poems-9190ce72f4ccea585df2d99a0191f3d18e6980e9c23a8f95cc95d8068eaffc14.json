    },
    {
      "id": "song-612",
      "category": "宋词",
      "title": "好事近",
      "subtitle": "睡起玉屏风吹去",
      "author": "宋祁",
      "dynasty": "宋",
      "content": "睡起玉屏风，吹去乱红犹落。\n天气骤生轻暖，衬沈香帷箔。\n珠帘约住海棠风，愁拖两眉角。\n昨夜一庭明月，冷秋千红索。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "e5a77df07085970c2170cbbb181d5886c8003c0dfc9527817521d90618e66228",
      "estimatedOutput": 712,
