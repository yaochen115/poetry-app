    },
    {
      "id": "song-999",
      "category": "宋词",
      "title": "浣溪沙",
      "subtitle": "飞鹊台前晕翠蛾",
      "author": "晏几道",
      "dynasty": "宋",
      "content": "飞鹊台前晕翠蛾。\n千金新换绛仙螺。\n最难加意为颦多。\n几处睡痕留醉袖，一春愁思近横波。\n远山低尽不成歌。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "cb9443c28c92aef3af1f78a9722b4333260f6ae95f360ae5b8bd1ea2d143277c",
      "estimatedOutput": 704,
      "resultPath": "expansion/working/v2/results/song-999--cb9443c28c92aef3af1f78a9722b4333260f6ae95f360ae5b8bd1ea2d143277c.json"
    },
    {
      "id": "song-1000",
      "category": "宋词",
      "title": "浣溪沙",
      "subtitle": "午醉西桥夕未醒",
      "author": "晏几道",
      "dynasty": "宋",
      "content": "午醉西桥夕未醒。\n雨花凄断不堪听。\n归时应减鬓边青。\n衣化客尘今古道，柳含春意短长亭。\n凤楼争见路旁情。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "c53403d1d62e17c0e43c857df7e07b75258b589c37e97b61ed775ec394e05e64",
      "estimatedOutput": 704,
      "resultPath": "expansion/working/v2/results/song-1000--c53403d1d62e17c0e43c857df7e07b75258b589c37e97b61ed775ec394e05e64.json"
    },
    {
      "id": "song-1001",
      "category": "宋词",
      "title": "浣溪沙",
      "subtitle": "一样宫妆簇彩舟",
      "author": "晏几道",
      "dynasty": "宋",
      "content": "一样宫妆簇彩舟。\n碧罗团扇自障羞。\n水仙人在镜中游。\n腰自细来多态度，脸因红处转风流。\n年年相遇绿江头。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "7477718a9e94f0e19b72a326a7a9dfb9b587e2e044d59ebbc90cbabf506dca10",
      "estimatedOutput": 704,
      "resultPath": "expansion/working/v2/results/song-1001--7477718a9e94f0e19b72a326a7a9dfb9b587e2e044d59ebbc90cbabf506dca10.json"
    },
    {
      "id": "song-1002",
      "category": "宋词",
      "title": "浣溪沙",
      "subtitle": "已拆秋千不奈闲",
      "author": "晏几道",
      "dynasty": "宋",
      "content": "已拆秋千不奈闲。\n却随胡蝶到花间。\n旋寻双叶插云鬟。\n几摺湘裙烟缕细，一钩罗袜素蟾弯。\n绿窗红豆忆前欢。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "156ac525914760d6b029e9458087bddd2e9630e57255d41ec442a2d91f5bdcd1",
      "estimatedOutput": 704,
      "resultPath": "expansion/working/v2/results/song-1002--156ac525914760d6b029e9458087bddd2e9630e57255d41ec442a2d91f5bdcd1.json"
    },
    {
      "id": "song-1003",
      "category": "宋词",
      "title": "浣溪沙",
      "subtitle": "闲弄筝弦懒系裙",
      "author": "晏几道",
      "dynasty": "宋",
      "content": "闲弄筝弦懒系裙。\n铅华消尽见天真。\n眼波低处事还新。\n怅恨不逢如意酒，寻思难值有情人。\n可怜虚度琐窗春。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "b99323df7d2a579182d4ef7026ec676b234c6c1fb7f20f5928882d8ed6a3e3bf",
      "estimatedOutput": 704,
      "resultPath": "expansion/working/v2/results/song-1003--b99323df7d2a579182d4ef7026ec676b234c6c1fb7f20f5928882d8ed6a3e3bf.json"
    },
    {
      "id": "song-1004",
      "category": "宋词",
      "title": "浣溪沙",
      "subtitle": "团扇初随碧簟收",
      "author": "晏几道",
      "dynasty": "宋",
      "content": "团扇初随碧簟收。\n画檐归燕尚迟留。\n靥朱眉翠喜清秋。\n风意未应迷狭路，灯痕犹自记高楼。\n露花烟叶与人愁。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "b032f8e6853ad92fe79d08fedc0c47b14de4d51905d989fbbf942d8bfe114957",
      "estimatedOutput": 704,
      "resultPath": "expansion/working/v2/results/song-1004--b032f8e6853ad92fe79d08fedc0c47b14de4d51905d989fbbf942d8bfe114957.json"
    },
    {
      "id": "song-1005",
      "category": "宋词",
      "title": "浣溪沙",
      "subtitle": "翠阁朱阑倚处危",
      "author": "晏几道",
      "dynasty": "宋",
      "content": "翠阁朱阑倚处危。\n夜凉闲捻彩箫吹。\n曲中双凤已分飞。\n绿酒细倾消别恨，红笺小写问归期。\n月华风意似当时。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "609e03717b96d99d83054a1476b17ea3a35999888433a6ffcc94e5234e4cebc6",
      "estimatedOutput": 704,
      "resultPath": "expansion/working/v2/results/song-1005--609e03717b96d99d83054a1476b17ea3a35999888433a6ffcc94e5234e4cebc6.json"
    },
    {
      "id": "song-1006",
      "category": "宋词",
      "title": "浣溪沙",
      "subtitle": "唱得红梅字字香",
      "author": "晏几道",
      "dynasty": "宋",
      "content": "唱得红梅字字香。\n柳枝桃叶尽深藏。\n遏云声里送雕觞。\n才听便拼衣袖湿，欲歌先倚黛眉长。\n曲终敲损燕钗梁。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "5eba8f8df7b970f8c891bd46e0d3b61705d70084aa57456c4f2d2ed98b9f2903",
      "estimatedOutput": 704,
      "resultPath": "expansion/working/v2/results/song-1006--5eba8f8df7b970f8c891bd46e0d3b61705d70084aa57456c4f2d2ed98b9f2903.json"
    },
    {
      "id": "song-1007",
      "category": "宋词",
      "title": "浣溪沙",
      "subtitle": "小杏春声学浪仙",
      "author": "晏几道",
      "dynasty": "宋",
      "content": "小杏春声学浪仙。\n疏梅清唱替哀弦。\n似花如雪绕琼筵。\n腮粉月痕妆罢后，脸红莲艳酒醒前。\n今年水调得人怜。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "4e4188f0ec78f1354ecca28387fce33e837f662893586e3ff1cbf70a80632f51",
      "estimatedOutput": 704,
      "resultPath": "expansion/working/v2/results/song-1007--4e4188f0ec78f1354ecca28387fce33e837f662893586e3ff1cbf70a80632f51.json"
    },
    {
      "id": "song-1008",
      "category": "宋词",
      "title": "浣溪沙",
      "subtitle": "铜虎分符领外台",
      "author": "晏几道",
      "dynasty": "宋",
      "content": "铜虎分符领外台。\n五云深处彩旌来。\n春随红旆过长淮。\n千里裤襦添旧暖，万家桃李间新栽。\n使星回首是三台。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "ba1aae717869c82ebeed83f179e3a88807a16c8c8df3e89ebb3948a6be5f19ab",
