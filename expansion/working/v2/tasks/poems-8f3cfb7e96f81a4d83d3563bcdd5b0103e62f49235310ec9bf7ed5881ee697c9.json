    {
      "id": "tang-762",
      "category": "唐诗",
      "title": "和韦开州盛山十二首 茶岭",
      "subtitle": "",
      "author": "张籍",
      "dynasty": "唐",
      "content": "紫芽连白蕊，初向岭头生。\n自看家人摘，寻常触露行。",
