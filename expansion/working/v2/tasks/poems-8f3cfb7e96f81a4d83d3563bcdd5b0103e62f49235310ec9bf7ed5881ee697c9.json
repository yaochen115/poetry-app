    },
    {
      "id": "tang-765",
      "category": "唐诗",
      "title": "投赠福建桂常侍二首",
      "subtitle": "",
      "author": "陈陶",
      "dynasty": "唐",
      "content": "后来台席更何人，都护朝天拜近臣。\n长笑当时汉卿士，等闲恩泽画麒麟。\n匝地歌钟镇海隅，城池鞅掌旧名都。\n不知珠履三千外，更许侯嬴寄食无。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "45cf40be0fbe256da750cbf57b116015f68d92c0daca9481a42227bab8333cdc",
      "estimatedOutput": 734,
      "resultPath": "expansion/working/v2/results/tang-765--45cf40be0fbe256da750cbf57b116015f68d92c0daca9481a42227bab8333cdc.json"
    },
    {
      "id": "tang-766",
      "category": "唐诗",
      "title": "旅中秋月有怀",
      "subtitle": "",
      "author": "朱庆馀",
      "dynasty": "唐",
      "content": "久客未还乡，中秋倍可伤。\n暮天飞旅雁，故国在衡阳。\n岛外归云迥，林间坠叶黄。\n数宵千里梦，时见旧书堂。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "e88f74662f2de8a59aec1bb1eb9beafb54523ce1d20a9cfcc2217e0c1ff94d8f",
      "estimatedOutput": 702,
