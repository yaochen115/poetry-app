    },
    {
      "id": "tang-957",
      "category": "唐诗",
      "title": "芙蓉楼送辛渐二首",
      "subtitle": "",
      "author": "王昌龄",
      "dynasty": "唐",
      "content": "寒雨连天夜入吴，平明送客楚山孤。\n洛阳亲友如相问，一片冰心在玉壶。\n丹阳城南秋海阴，丹阳城北楚云深。\n高楼送客不能醉，寂寂寒江明月心。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "324eb2c60c500b099af5df1f75fc9f8edd495deb8ec71c63d80395c7e8fd7f96",
      "estimatedOutput": 734,
      "resultPath": "expansion/working/v2/results/tang-957--324eb2c60c500b099af5df1f75fc9f8edd495deb8ec71c63d80395c7e8fd7f96.json"
    },
    {
      "id": "tang-958",
      "category": "唐诗",
      "title": "郊庙歌辞。释奠文宣王乐章。舒和",
      "subtitle": "",
      "author": "佚名",
      "dynasty": "唐",
      "content": "隼集龟开昭圣烈，龙蹲凤跱肃神仪。\n尊儒敬业宏图阐，纬武经文盛德施。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "925d813f8fb1d58c0a98d274d96ef10afab53b3c112fdc2da18f4e37faf85443",
      "estimatedOutput": 666,
