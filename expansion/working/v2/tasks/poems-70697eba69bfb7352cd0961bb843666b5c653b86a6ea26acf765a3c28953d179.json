    },
    {
      "id": "tang-955",
      "category": "唐诗",
      "title": "题卢五旧居",
      "subtitle": "",
      "author": "李颀",
      "dynasty": "唐",
      "content": "物在人亡无见期，闲庭系马不胜悲。\n窗前绿竹生空地，门外青山如旧时。\n怅望秋天鸣坠叶，巑岏枯柳宿寒鸱。\n忆君泪落东流水，岁岁花开知为谁。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "b9157406cf31437463d5d0aa81b99036742df3d3a80eccda3298f46e2643b047",
      "estimatedOutput": 734,
      "resultPath": "expansion/working/v2/results/tang-955--b9157406cf31437463d5d0aa81b99036742df3d3a80eccda3298f46e2643b047.json"
    },
    {
      "id": "tang-956",
      "category": "唐诗",
      "title": "游春十二首 其五",
      "subtitle": "",
      "author": "姚合",
      "dynasty": "唐",
      "content": "疏顽无异事，随例但添年。\n旧历藏深箧，新衣薄絮绵。\n暖风浑酒色，晴日畅琴弦。\n同伴无辞困，游春贵在先。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "8c01f60c64c84945a229b753056fb1ebe084a3065a0ee036b2d4b3d4713c3ad3",
