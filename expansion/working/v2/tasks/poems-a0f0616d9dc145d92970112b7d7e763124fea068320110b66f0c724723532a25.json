    },
    {
      "id": "song-664",
      "category": "宋词",
      "title": "玉楼春",
      "subtitle": "风迟日媚烟光好",
      "author": "欧阳修",
      "dynasty": "宋",
      "content": "风迟日媚烟光好。\n绿树依依芳意早。\n年华容易即凋零，春色只宜长恨少。\n池塘隐隐惊雷晓。\n柳眼未开梅萼小。\n尊前贪爱物华新，不道物新人渐老。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "2762ae5f2bbc1b1242097776448d963333b15be9f367d7e2d48a6375d2fd9d3f",
      "estimatedOutput": 738,
      "resultPath": "expansion/working/v2/results/song-664--2762ae5f2bbc1b1242097776448d963333b15be9f367d7e2d48a6375d2fd9d3f.json"
    },
    {
      "id": "song-665",
      "category": "宋词",
      "title": "玉楼春",
      "subtitle": "西亭饮散清歌阕",
      "author": "欧阳修",
      "dynasty": "宋",
      "content": "西亭饮散清歌阕。\n花外迟迟宫漏发。\n涂金烛引紫骝嘶，柳曲西头归路别。\n佳辰只恐幽期阔。\n密赠殷勤衣上结。\n翠屏魂梦莫相寻，禁断六街清夜月。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "7369b38b7b87c8d378c29ff587b5d89b96aff944a93f13d9acfe49c36aadb073",
      "estimatedOutput": 738,
      "resultPath": "expansion/working/v2/results/song-665--7369b38b7b87c8d378c29ff587b5d89b96aff944a93f13d9acfe49c36aadb073.json"
    },
    {
      "id": "song-666",
      "category": "宋词",
      "title": "玉楼春",
      "subtitle": "春山敛黛低歌扇",
      "author": "欧阳修",
      "dynasty": "宋",
      "content": "春山敛黛低歌扇。\n暂解吴钩登祖宴。\n画楼钟动已魂销，何况马嘶芳草岸。\n青门柳色随人远。\n望欲断时肠已断。\n洛城春色待君来，莫到落花飞似霰。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "f17997a3dd19bc26c533870185a3b07fcdf102b4d1e37f41a9f11c67d1cb2f54",
      "estimatedOutput": 738,
      "resultPath": "expansion/working/v2/results/song-666--f17997a3dd19bc26c533870185a3b07fcdf102b4d1e37f41a9f11c67d1cb2f54.json"
    },
    {
      "id": "song-667",
      "category": "宋词",
      "title": "玉楼春",
      "subtitle": "尊前拟把归期说",
      "author": "欧阳修",
      "dynasty": "宋",
      "content": "尊前拟把归期说。\n未语春容先惨咽。\n人生自是有情痴，此恨不关风与月。\n离歌且莫翻新阕。\n一曲能教肠寸结。\n直须看尽洛城花，始共春风容易别。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "abedd4b53407accd12bbd048a740855b24a0d78b9730cdda3746279f72f7f54f",
      "estimatedOutput": 738,
      "resultPath": "expansion/working/v2/results/song-667--abedd4b53407accd12bbd048a740855b24a0d78b9730cdda3746279f72f7f54f.json"
    },
    {
      "id": "song-668",
      "category": "宋词",
      "title": "玉楼春",
      "subtitle": "洛阳正值芳菲节",
      "author": "欧阳修",
      "dynasty": "宋",
      "content": "洛阳正值芳菲节。\n秾艳清香相间发。\n游丝有意苦相萦，垂柳无端争赠别。\n杏花红处青山缺。\n山畔行人山下歇。\n今宵谁肯远相随，惟有寂寥孤馆月。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "f653d9d3ec6f42261d0637e3ef126152e1812d0a8ca8272fccd8ac8c09949b7f",
      "estimatedOutput": 738,
      "resultPath": "expansion/working/v2/results/song-668--f653d9d3ec6f42261d0637e3ef126152e1812d0a8ca8272fccd8ac8c09949b7f.json"
    },
    {
      "id": "song-669",
      "category": "宋词",
      "title": "玉楼春",
      "subtitle": "残春一夜狂风雨",
      "author": "欧阳修",
      "dynasty": "宋",
      "content": "残春一夜狂风雨。\n断送红飞花落树。\n人心花意待留春，春色无情容易去。\n高楼把酒愁独语。\n借问春归何处所。\n暮云空阔不知音，惟有绿杨芳草路。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "bb594ea2df023ff0e25cf6fa7b3d8bb274b8b4ddcc16293f1c6271062f0b727a",
      "estimatedOutput": 738,
      "resultPath": "expansion/working/v2/results/song-669--bb594ea2df023ff0e25cf6fa7b3d8bb274b8b4ddcc16293f1c6271062f0b727a.json"
    },
    {
      "id": "song-670",
      "category": "宋词",
      "title": "玉楼春",
      "subtitle": "常忆洛阳风景媚",
      "author": "欧阳修",
      "dynasty": "宋",
      "content": "常忆洛阳风景媚。\n烟暖风和添酒味。\n莺啼宴席似留人，花出墙头如有意。\n别来已隔千山翠。\n望断危楼斜日坠。\n关心只为牡丹红，一片春愁来梦里。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "8c53397667c4b63c94908ca801040501519690c8587de61e8201dab1007452c2",
      "estimatedOutput": 738,
      "resultPath": "expansion/working/v2/results/song-670--8c53397667c4b63c94908ca801040501519690c8587de61e8201dab1007452c2.json"
    },
    {
      "id": "song-671",
      "category": "宋词",
      "title": "玉楼春",
      "subtitle": "池塘水绿春微暖",
      "author": "欧阳修",
      "dynasty": "宋",
      "content": "池塘水绿春微暖。\n记得玉真初见面。\n从头歌韵响铮鏦，入破舞腰红乱旋。\n玉钩帘下香阶畔。\n醉后不知红日晚。\n当时共我赏花人，点检如今无一半。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "6489cc338cababf7a9f6c60e86c5b6b10b23250e4ab97466c0e0e86c2f8c6978",
      "estimatedOutput": 738,
      "resultPath": "expansion/working/v2/results/song-671--6489cc338cababf7a9f6c60e86c5b6b10b23250e4ab97466c0e0e86c2f8c6978.json"
    },
    {
      "id": "song-672",
      "category": "宋词",
      "title": "玉楼春",
      "subtitle": "两翁相遇逢佳节",
      "author": "欧阳修",
      "dynasty": "宋",
      "content": "两翁相遇逢佳节。\n正值柳绵飞似雪。\n便须豪饮敌青春，莫对新花羞白发。\n人生聚散如弦筈。\n老去风情尤惜别。\n大家金盏倒垂莲，一任西楼低晓月。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "d778ee386f4ee67d89f5f6e8d2e2abdfb2ca76a1f9c12b9ec063cea6745e60e7",
      "estimatedOutput": 738,
