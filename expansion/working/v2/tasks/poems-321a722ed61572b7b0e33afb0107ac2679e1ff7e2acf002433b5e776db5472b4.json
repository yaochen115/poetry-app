    },
    {
      "id": "song-507",
      "category": "宋词",
      "title": "诉衷情",
      "subtitle": "花前月下暂相逢",
      "author": "张先",
      "dynasty": "宋",
      "content": "花前月下暂相逢。\n苦恨阻从容。\n何况酒醒梦断，花谢月朦胧。\n花不尽，月无穷。\n两心同。\n此时愿作，杨柳千丝，绊惹春风。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "a8ec6a34a8104c137ed150f0e85babe8f95a5981f990de53a7ce2a85c0e951c0",
      "estimatedOutput": 718,
      "resultPath": "expansion/working/v2/results/song-507--a8ec6a34a8104c137ed150f0e85babe8f95a5981f990de53a7ce2a85c0e951c0.json"
    },
    {
      "id": "song-508",
      "category": "宋词",
      "title": "诉衷情",
      "subtitle": "数枝金菊对芙蓉",
      "author": "张先",
      "dynasty": "宋",
      "content": "数枝金菊对芙蓉。\n零落意忡忡。\n不知多少幽怨，和泪泣东风。\n人散后，月明中。\n夜寒浓。\n谢娘愁卧，潘令闲眠，往事何穷。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "32f7987c536b7d8731dfb9b81222207ec25b0e512fbf8a2a2e3733b7d9a2936f",
