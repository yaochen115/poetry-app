    },
    {
      "id": "song-509",
      "category": "宋词",
      "title": "减字木兰花",
      "subtitle": "垂螺近额走上红",
      "author": "张先",
      "dynasty": "宋",
      "content": "垂螺近额。\n走上红裀初趁拍。\n只恐轻飞。\n拟倩游丝惹住伊。\n文鸳绣履。\n去似杨花尘不起。\n舞彻伊州。\n头上宫花颤未休。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "08ceb2504a75b09397fdd3b8103b86a9526222efbf0dbf7bb6bf139b6d6d583e",
