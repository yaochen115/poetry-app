    },
    {
      "id": "song-510",
      "category": "宋词",
      "title": "少年游",
      "subtitle": "碎霞浮动晓朦胧",
      "author": "张先",
      "dynasty": "宋",
      "content": "碎霞浮动晓朦胧。\n春意与花浓。\n银瓶素绠，玉泉金甃，真色浸朝红。\n花枝人面难常见，青子小丛丛。\n韶华长在，明年依旧，相与笑春风。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "c57e4450f006074d672f5ddb503302ecfd112d55901ac1f61a4690ca660e3794",
      "estimatedOutput": 728,
      "resultPath": "expansion/working/v2/results/song-510--c57e4450f006074d672f5ddb503302ecfd112d55901ac1f61a4690ca660e3794.json"
    },
    {
      "id": "song-511",
      "category": "宋词",
      "title": "少年游",
      "subtitle": "帽檐风细马蹄尘",
      "author": "张先",
      "dynasty": "宋",
      "content": "帽檐风细马蹄尘。\n常记探花人。\n露英千样，粉香无尽，蓦地酒初醒。\n探花人向花前老，花上旧时春。\n行歌声外，靓妆丛里，须贵少年身。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "eb980d096ea8020a1d6ce44b9b2aadfde0bf2138c2d0992036be81513ef36ca8",
      "estimatedOutput": 728,
      "resultPath": "expansion/working/v2/results/song-511--eb980d096ea8020a1d6ce44b9b2aadfde0bf2138c2d0992036be81513ef36ca8.json"
    },
    {
      "id": "song-512",
      "category": "宋词",
      "title": "虞美人",
      "subtitle": "苕花飞尽汀风定",
      "author": "张先",
      "dynasty": "宋",
      "content": "苕花飞尽汀风定。\n苕水天摇影。\n画船罗绮满溪春。\n一曲石城清响、入高云。\n壶觞昔岁同歌舞。\n今日无欢侣。\n南园花少故人稀。\n月照玉楼依旧、似当时。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "3698b329d89acfb8f14c302f2cc6bf07fcf8e0dc479d8ed807a6b3649360496d",
      "estimatedOutput": 746,
      "resultPath": "expansion/working/v2/results/song-512--3698b329d89acfb8f14c302f2cc6bf07fcf8e0dc479d8ed807a6b3649360496d.json"
    },
    {
      "id": "song-513",
      "category": "宋词",
      "title": "天仙子",
      "subtitle": "持节来时初有雁",
      "author": "张先",
      "dynasty": "宋",
      "content": "持节来时初有雁。\n十万人家春已满。\n龙标名第凤池身，堂阜远。\n江桥晚。\n一见湖山看未遍。\n障扇欲收歌泪溅。\n亭下花空罗绮散。\n樯竿渐向望中疏，旗影转。\n鼙声断。\n惆怅不如船尾燕。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "a62f523a7c2eee4cde003f2457cf493ba6835bbaaa19364182b307fdec2a83c6",
      "estimatedOutput": 778,
      "resultPath": "expansion/working/v2/results/song-513--a62f523a7c2eee4cde003f2457cf493ba6835bbaaa19364182b307fdec2a83c6.json"
    },
    {
      "id": "song-514",
      "category": "宋词",
      "title": "菩萨蛮",
      "subtitle": "玉人又是匆匆去",
      "author": "张先",
      "dynasty": "宋",
      "content": "玉人又是匆匆去。\n马蹄何处垂杨路。\n残日倚楼时。\n断魂郎未知。\n阑干移倚遍。\n薄幸教人怨。\n明月却多情。\n随人处处行。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "4db3b8b4da91158acd59b2635b996fe179e03548e06f7a305db34e249816bacc",
      "estimatedOutput": 718,
      "resultPath": "expansion/working/v2/results/song-514--4db3b8b4da91158acd59b2635b996fe179e03548e06f7a305db34e249816bacc.json"
    },
    {
      "id": "song-515",
      "category": "宋词",
      "title": "临江仙",
      "subtitle": "自古伤心惟远别",
      "author": "张先",
      "dynasty": "宋",
      "content": "自古伤心惟远别，登山临水迟留。\n暮尘衰草一番秋。\n寻常景物，到此尽成愁。\n况与佳人分凤侣，盈盈粉泪难收。\n高城深处是青楼。\n红尘远道，明日忍回头。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "7be2caf34342df52fa3f5bc8e4e26fa3e1c9a7f15610aed17eb60d6ceb766593",
      "estimatedOutput": 746,
      "resultPath": "expansion/working/v2/results/song-515--7be2caf34342df52fa3f5bc8e4e26fa3e1c9a7f15610aed17eb60d6ceb766593.json"
    },
    {
      "id": "song-516",
      "category": "宋词",
      "title": "天仙子",
      "subtitle": "醉笑相逢能几度",
      "author": "张先",
      "dynasty": "宋",
      "content": "醉笑相逢能几度。\n为报江头春且住。\n主人今日是行人，红袖舞。\n清歌女。\n凭仗东风教点取。\n三月柳枝柔似缕。\n落絮尽飞还恋树。\n有情宁不忆西园，莺解语。\n花无数。\n应讶使君何处去。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "d6762496cbe27743c447de59c742fa660d428fb7b189af89c2cfe4efbe0b8254",
      "estimatedOutput": 778,
      "resultPath": "expansion/working/v2/results/song-516--d6762496cbe27743c447de59c742fa660d428fb7b189af89c2cfe4efbe0b8254.json"
    },
    {
      "id": "song-517",
      "category": "宋词",
      "title": "渔家傲",
      "subtitle": "巴子城头青草暮",
      "author": "张先",
      "dynasty": "宋",
      "content": "巴子城头青草暮。\n巴山重叠相逢处。\n燕子占巢花脱树。\n杯且举。\n瞿塘水阔舟难渡。\n天外吴门清霅路。\n君家正在吴门住。\n赠我柳枝情几许。\n春满缕。\n为君将入江南去。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "44af22691d82f375a9bd3953e9d23bd908f0cd34ac202ded522a60cb37c6add3",
