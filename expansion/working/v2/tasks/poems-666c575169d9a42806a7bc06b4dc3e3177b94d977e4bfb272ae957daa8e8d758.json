    },
    {
      "id": "song-567",
      "category": "宋词",
      "title": "少年游",
      "subtitle": "谢家庭槛晓无尘",
      "author": "晏殊",
      "dynasty": "宋",
      "content": "谢家庭槛晓无尘。\n芳宴祝良辰。\n风流妙舞，樱桃清唱，依约驻行云。\n榴花一盏浓香满，为寿百千春。\n岁岁年年，共欢同乐，嘉庆与时新。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "06d2c7fed018c5054eaa869f2e5389f22d1ccefd44ef7f7cd499ed53c4cbf879",
