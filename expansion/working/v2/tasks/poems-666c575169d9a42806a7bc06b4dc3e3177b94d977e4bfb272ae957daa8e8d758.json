    },
    {
      "id": "song-568",
      "category": "宋词",
      "title": "诉衷情",
      "subtitle": "青梅煮酒斗时新",
      "author": "晏殊",
      "dynasty": "宋",
      "content": "青梅煮酒斗时新。\n天气欲残春。\n东城南陌花下，逢著意中人。\n回绣袂，展香茵。\n叙情亲。\n此情拼作，千尺游丝，惹住朝云。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "2a2a0abc31bd5924ad2082af49737df3ff6f7c376ee0145aa833f26b22cde14b",
      "estimatedOutput": 718,
      "resultPath": "expansion/working/v2/results/song-568--2a2a0abc31bd5924ad2082af49737df3ff6f7c376ee0145aa833f26b22cde14b.json"
    },
    {
      "id": "song-569",
      "category": "宋词",
      "title": "诉衷情",
      "subtitle": "东风杨柳欲青青",
      "author": "晏殊",
      "dynasty": "宋",
      "content": "东风杨柳欲青青。\n烟淡雨初晴。\n恼他香阁浓睡，撩乱有啼莺。\n眉叶细，舞腰轻。\n宿妆成。\n一春芳意，三月和风，牵系人情。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "dd024add71c4d150cc0b1ee62ff1008b2b80245d748eb9edbe1894b5133b0e57",
      "estimatedOutput": 718,
      "resultPath": "expansion/working/v2/results/song-569--dd024add71c4d150cc0b1ee62ff1008b2b80245d748eb9edbe1894b5133b0e57.json"
    },
    {
      "id": "song-570",
      "category": "宋词",
      "title": "诉衷情",
      "subtitle": "芙蓉金菊斗馨香",
      "author": "晏殊",
      "dynasty": "宋",
      "content": "芙蓉金菊斗馨香。\n天气欲重阳。\n远村秋色如画，红树间疏黄。\n流水淡，碧天长。\n路茫茫。\n凭高目断，鸿雁来时，无限思量。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "0302f6cc479862c79b04a8e240d252ae5b4e53ccd003e4e60f797d39ad427ef1",
      "estimatedOutput": 718,
      "resultPath": "expansion/working/v2/results/song-570--0302f6cc479862c79b04a8e240d252ae5b4e53ccd003e4e60f797d39ad427ef1.json"
    },
    {
      "id": "song-571",
      "category": "宋词",
      "title": "诉衷情",
      "subtitle": "数枝金菊对芙蓉",
      "author": "晏殊",
      "dynasty": "宋",
      "content": "数枝金菊对芙蓉。\n摇落意重重。\n不知多少幽怨，和露泣西风。\n人散后，月明中。\n夜寒浓。\n谢娘愁卧，潘令闲眠，心事无穷。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "aa9df1dde65038fb29d908c0b7938fefff8fd2ec884c0fef175dfb1e41fcb724",
      "estimatedOutput": 718,
      "resultPath": "expansion/working/v2/results/song-571--aa9df1dde65038fb29d908c0b7938fefff8fd2ec884c0fef175dfb1e41fcb724.json"
    },
    {
      "id": "song-572",
      "category": "宋词",
      "title": "诉衷情",
      "subtitle": "露莲双脸远山眉",
      "author": "晏殊",
      "dynasty": "宋",
      "content": "露莲双脸远山眉。\n偏与淡妆宜。\n小庭帘幕春晚，闲共柳丝垂。\n人别后，月圆时。\n信迟迟。\n心心念念，说尽无凭，只是相思。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "dd56d43650614f4194e400c38b8b361800af87a204b7bf49a4852636eaf5a9fc",
      "estimatedOutput": 718,
      "resultPath": "expansion/working/v2/results/song-572--dd56d43650614f4194e400c38b8b361800af87a204b7bf49a4852636eaf5a9fc.json"
    },
    {
      "id": "song-573",
      "category": "宋词",
      "title": "诉衷情",
      "subtitle": "秋风吹绽北池莲",
      "author": "晏殊",
      "dynasty": "宋",
      "content": "秋风吹绽北池莲。\n曙云楼阁鲜。\n画堂今日嘉会，齐拜玉炉烟。\n斟美酒，祝芳筵。\n奉觥船。\n宜春耐夏，多福庄严，富贵长年。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "7f74f85a3b9cd0230f0fd3c87799866fea31e35e7eb16e69f3633432df183f0b",
      "estimatedOutput": 718,
      "resultPath": "expansion/working/v2/results/song-573--7f74f85a3b9cd0230f0fd3c87799866fea31e35e7eb16e69f3633432df183f0b.json"
    },
    {
      "id": "song-574",
      "category": "宋词",
      "title": "诉衷情",
      "subtitle": "世间荣贵月中人",
      "author": "晏殊",
      "dynasty": "宋",
      "content": "世间荣贵月中人。\n嘉庆在今辰。\n兰堂帘幕高卷，清唱遏行云。\n持玉盏，敛红巾。\n祝千春。\n榴花寿酒，金鸭炉香，岁岁长新。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "cff197ff748de6e3c416cb9f3dccf5bae98bca2e640a4a828e25520ccce3b303",
      "estimatedOutput": 718,
      "resultPath": "expansion/working/v2/results/song-574--cff197ff748de6e3c416cb9f3dccf5bae98bca2e640a4a828e25520ccce3b303.json"
    },
    {
      "id": "song-575",
      "category": "宋词",
      "title": "诉衷情",
      "subtitle": "海棠珠缀一重重",
      "author": "晏殊",
      "dynasty": "宋",
      "content": "海棠珠缀一重重。\n清晓近帘栊。\n胭脂谁与匀淡，偏向脸边浓。\n看叶嫩，惜花红。\n意无穷。\n如花似叶，岁岁年年，共占春风。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "40c9699a8e4f7394f0e396a8b2a60f66da79b89b3e8990c0a997cbedc748f9fd",
      "estimatedOutput": 718,
