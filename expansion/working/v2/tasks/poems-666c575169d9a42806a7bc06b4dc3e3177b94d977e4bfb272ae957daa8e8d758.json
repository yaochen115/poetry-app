    },
    {
      "id": "song-576",
      "category": "宋词",
      "title": "踏莎行",
      "subtitle": "细草愁烟幽花怯",
      "author": "晏殊",
      "dynasty": "宋",
      "content": "细草愁烟，幽花怯露。\n凭阑总是销魂处。\n日高深院静无人，时时海燕双飞去。\n带缓罗衣，香残蕙炷。\n天长不禁迢迢路。\n垂杨只解惹春风，何曾系得行人住。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "02afef93c98b283cb4e17d7482fdcbdc68cbc10fb3f48ceac03eda7eb59e4e6d",
      "estimatedOutput": 746,
      "resultPath": "expansion/working/v2/results/song-576--02afef93c98b283cb4e17d7482fdcbdc68cbc10fb3f48ceac03eda7eb59e4e6d.json"
    },
    {
      "id": "song-577",
      "category": "宋词",
      "title": "踏莎行",
      "subtitle": "祖席离歌长亭别",
      "author": "晏殊",
      "dynasty": "宋",
      "content": "祖席离歌，长亭别宴。\n香尘已隔犹回面。\n居人匹马映林嘶，行人去棹依波转。\n画阁魂消，高楼目断。\n斜阳只送平波远。\n无穷无尽是离愁，天涯地角寻思遍。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "bfbad9e51c8f8d320477f8e654a4bf1baedf115876a57978321c13a5c51807e5",
