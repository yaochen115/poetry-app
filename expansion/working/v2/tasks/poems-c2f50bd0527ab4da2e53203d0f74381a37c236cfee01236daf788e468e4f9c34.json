    },
    {
      "id": "song-843",
      "category": "宋词",
      "title": "西江月",
      "subtitle": "人我众生寿者宁",
      "author": "张伯端",
      "dynasty": "宋",
      "content": "人我众生寿者，宁分彼此高低。\n法身通照没吾伊。\n念念体分同异。\n见是何曾是是，闻非未必非非。\n往来诸用不相知。\n生死谁能碍你。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "1e6feb28fb6c321af6284be7e9fb715f2e11fe12dbf04d3c58ac2e1e49ad54f2",
      "estimatedOutput": 726,
      "resultPath": "expansion/working/v2/results/song-843--1e6feb28fb6c321af6284be7e9fb715f2e11fe12dbf04d3c58ac2e1e49ad54f2.json"
    },
    {
      "id": "song-844",
      "category": "宋词",
      "title": "西江月",
      "subtitle": "住想修行布施果",
      "author": "张伯端",
      "dynasty": "宋",
      "content": "住想修行布施，果报不离天人。\n恰如仰箭射浮云。\n坠落祗缘力尽。\n争似无为实相，还须返朴归淳。\n境忘情性任天真。\n以证无生法忍。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "e7c8224299a36c69fa9f6a3ab2f119d879f014dea85251937d5eb79b658f5c4f",
      "estimatedOutput": 726,
      "resultPath": "expansion/working/v2/results/song-844--e7c8224299a36c69fa9f6a3ab2f119d879f014dea85251937d5eb79b658f5c4f.json"
    },
    {
      "id": "song-845",
      "category": "宋词",
      "title": "西江月",
      "subtitle": "鱼兔若还入手自",
      "author": "张伯端",
      "dynasty": "宋",
      "content": "鱼兔若还入手，自然忘却筌蹄。\n渡河筏子上天梯。\n到彼悉皆遗弃。\n未悟须凭言说，悟来言说皆非。\n虽然四句属无为。\n此等何须脱离。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "b8f610014bf8fa81796b21ed22b65a396369130321e3605022337bf90cca661f",
      "estimatedOutput": 726,
      "resultPath": "expansion/working/v2/results/song-845--b8f610014bf8fa81796b21ed22b65a396369130321e3605022337bf90cca661f.json"
    },
    {
      "id": "song-846",
      "category": "宋词",
      "title": "西江月",
      "subtitle": "悟了莫求寂灭随",
      "author": "张伯端",
      "dynasty": "宋",
      "content": "悟了莫求寂灭，随缘只接群迷。\n寻常邪见及提携。\n方便指归实际。\n五眼三身四智，六度万行修齐。\n圆光一颗好摩尼。\n利物兼能自利。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "7dd6e9cbadad4ffae876d564a6b8ed3876d429d495613af7564fb77203abbfaf",
      "estimatedOutput": 726,
      "resultPath": "expansion/working/v2/results/song-846--7dd6e9cbadad4ffae876d564a6b8ed3876d429d495613af7564fb77203abbfaf.json"
    },
    {
      "id": "song-847",
      "category": "宋词",
      "title": "西江月",
      "subtitle": "我见时人说性只",
      "author": "张伯端",
      "dynasty": "宋",
      "content": "我见时人说性，只夸口急酬机。\n及逢境界转痴迷。\n又与愚人何异。\n说得便须行得，方名言行无亏。\n能将慧剑斩魔魑。\n此号如来正智。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "97afb9fc4ce9ba968cd387116d7620ad9aa236475e87eed1da6431ae694da8eb",
      "estimatedOutput": 726,
      "resultPath": "expansion/working/v2/results/song-847--97afb9fc4ce9ba968cd387116d7620ad9aa236475e87eed1da6431ae694da8eb.json"
    },
    {
      "id": "song-848",
      "category": "宋词",
      "title": "西江月",
      "subtitle": "欲了无生妙道莫",
      "author": "张伯端",
      "dynasty": "宋",
      "content": "欲了无生妙道，莫如自见真心。\n真心无相亦无音。\n清净法身只恁。\n此道非无外有，非中亦莫求寻。\n二边俱遣弃中心。\n见了名为上品。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "58b7313eb8c66f2ce1cc1eaddbddc6d7968fa419131dec5b209895aea0cb4fd4",
      "estimatedOutput": 726,
      "resultPath": "expansion/working/v2/results/song-848--58b7313eb8c66f2ce1cc1eaddbddc6d7968fa419131dec5b209895aea0cb4fd4.json"
    },
    {
      "id": "song-849",
      "category": "宋词",
      "title": "满庭芳",
      "subtitle": "真铁牛儿形容丑",
      "author": "张伯端",
      "dynasty": "宋",
      "content": "真铁牛儿，形容丑恶，性刚偏好争驰。\n人人皆有，那角解牵骑。\n种就黄芽满院，更须用、神水浇之。\n宫里，若无此兽，安得似婴儿。\n乾坤真动静，生成家活，总赖於伊。\n饥餐虎髓，渴饮水银池。\n夜半牵车进火，霞光迸、海底腾辉。\n牧童笑，华池宴罢，乘个月明归。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "000cd82e683e44fce9a322901b70d7dec00a84704c403ae00c8ed1fb543796e1",
      "estimatedOutput": 846,
      "resultPath": "expansion/working/v2/results/song-849--000cd82e683e44fce9a322901b70d7dec00a84704c403ae00c8ed1fb543796e1.json"
    },
    {
      "id": "song-850",
      "category": "宋词",
      "title": "好事近",
      "subtitle": "瑞雪满京都宫殿",
      "author": "蔡襄",
      "dynasty": "宋",
      "content": "瑞雪满京都，宫殿尽成银阙。\n常对素光遥望，是江梅时节。\n如今江上见寒梅，幽香自清绝。\n重看落英残艳，想飘零如雪。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "58cd548aafb330061233b53a9cac31bf5a4b130610d46723b92fa6dcfc019fed",
      "estimatedOutput": 712,
      "resultPath": "expansion/working/v2/results/song-850--58cd548aafb330061233b53a9cac31bf5a4b130610d46723b92fa6dcfc019fed.json"
    },
    {
      "id": "song-851",
      "category": "宋词",
      "title": "菩萨蛮",
      "subtitle": "子规啼破城楼月",
      "author": "李师中",
      "dynasty": "宋",
      "content": "子规啼破城楼月。\n画船晓载笙歌发。\n两岸荔枝红。\n万家烟雨中。\n佳人相对泣。\n泪下罗衣湿。\n从此信音稀。\n岭南无雁飞。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "a8ce1e42d194f0cd16ee90f3f50ce40e808b27d12cb341596ddbc577d3c3ac33",
      "estimatedOutput": 718,
      "resultPath": "expansion/working/v2/results/song-851--a8ce1e42d194f0cd16ee90f3f50ce40e808b27d12cb341596ddbc577d3c3ac33.json"
    },
    {
      "id": "song-852",
      "category": "宋词",
      "title": "西江月",
      "subtitle": "早岁相期林下高",
      "author": "韩维",
      "dynasty": "宋",
      "content": "早岁相期林下，高年同在尊前。\n风花绣舞乍晴天。\n绿蚁新浮酒面。\n身外虚名电转，人间急景梭传。\n当筵莫惜听朱弦。\n一品归来强健。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "0bc1ea4bc3798028e810bb12a1d5523c9d183d1f569112ee0c575fb28ab33105",
      "estimatedOutput": 726,
      "resultPath": "expansion/working/v2/results/song-852--0bc1ea4bc3798028e810bb12a1d5523c9d183d1f569112ee0c575fb28ab33105.json"
    },
    {
      "id": "song-853",
      "category": "宋词",
      "title": "踏莎行",
      "subtitle": "归雁低空游蜂趁",
      "author": "韩维",
      "dynasty": "宋",
      "content": "归雁低空，游蜂趁暖。\n凭高目向西云断。\n具茨山外夕阳多，展江亭下春波满。\n双桂情深，千花明焕。\n良辰谁是同游伴。\n辛夷花谢早梅开。\n应须次第调弦管。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "14ea92990140315a24f07b2a6740be61564a87e425de96dc6637eacb1bad1208",
