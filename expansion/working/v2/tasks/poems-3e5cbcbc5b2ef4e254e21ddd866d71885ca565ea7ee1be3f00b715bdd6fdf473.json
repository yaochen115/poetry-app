    },
    {
      "id": "song-699",
      "category": "宋词",
      "title": "渔家傲",
      "subtitle": "九月霜秋秋已尽",
      "author": "欧阳修",
      "dynasty": "宋",
      "content": "九月霜秋秋已尽。\n烘林败叶红相映。\n惟有东篱黄菊盛。\n遗金粉。\n人家帘幕重阳近。\n晓日阴阴晴未定。\n授衣时节轻寒嫩。\n新雁一声风又劲。\n云欲凝。\n雁来应有吾乡信。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "e4db172261a0ce726cdf2bd8a7369938a0a61b8beb2e20afa53d2161adbef70e",
      "estimatedOutput": 762,
      "resultPath": "expansion/working/v2/results/song-699--e4db172261a0ce726cdf2bd8a7369938a0a61b8beb2e20afa53d2161adbef70e.json"
    },
    {
      "id": "song-700",
      "category": "宋词",
      "title": "渔家傲",
      "subtitle": "十月小春梅蕊绽",
      "author": "欧阳修",
      "dynasty": "宋",
      "content": "十月小春梅蕊绽。\n红炉画阁新妆遍。\n鸳帐美人贪睡暖。\n梳洗懒。\n玉壶一夜轻澌满。\n楼上四垂帘不卷。\n天寒山色偏宜远。\n风急雁行吹字断。\n红日晚。\n江天雪意云撩乱。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "f698861a6103350fdf194e59f2696c5cc4e816e9db85df7d16574ea9b6f1b096",
      "estimatedOutput": 762,
      "resultPath": "expansion/working/v2/results/song-700--f698861a6103350fdf194e59f2696c5cc4e816e9db85df7d16574ea9b6f1b096.json"
    },
    {
      "id": "song-701",
      "category": "宋词",
      "title": "渔家傲",
      "subtitle": "十一月新阳排寿",
      "author": "欧阳修",
      "dynasty": "宋",
      "content": "十一月新阳排寿宴。\n黄锺应管添宫线。\n猎猎寒威云不卷。\n风头转。\n时看雪霰吹人面。\n南至迎长知漏箭。\n书云纪候冰生妍。\n腊近探春春尚远。\n闲庭院。\n梅花落尽千千片。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "6f38e147aa65f3a1625f2012e600252dd0298ecf51173b1b678dc13a87d50bcd",
      "estimatedOutput": 764,
      "resultPath": "expansion/working/v2/results/song-701--6f38e147aa65f3a1625f2012e600252dd0298ecf51173b1b678dc13a87d50bcd.json"
    },
    {
      "id": "song-702",
      "category": "宋词",
      "title": "渔家傲",
      "subtitle": "十二月严凝天地",
      "author": "欧阳修",
      "dynasty": "宋",
      "content": "十二月严凝天地闭。\n莫嫌台榭无花卉。\n惟有酒能欺雪意。\n增豪气。\n直教耳热笙歌沸。\n陇上雕鞍惟数骑。\n猎围半合新霜里。\n霜重鼓声寒不起。\n千人指。\n马前一雁寒空坠。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "447341d2fdeca2dc413afc490712d9de708c273e222573302473ac1497ddb85e",
      "estimatedOutput": 764,
      "resultPath": "expansion/working/v2/results/song-702--447341d2fdeca2dc413afc490712d9de708c273e222573302473ac1497ddb85e.json"
    },
    {
      "id": "song-703",
      "category": "宋词",
      "title": "渔家傲",
      "subtitle": "正月新阳生翠琯",
      "author": "欧阳修",
      "dynasty": "宋",
      "content": "正月新阳生翠琯。\n花苞柳线春犹浅。\n帘幕千重方半卷。\n池冰泮。\n东风吹水琉璃软。\n渐好凭阑醒醉眼。\n陇梅暗落芳英断。\n初日已知长一线。\n清宵短。\n梦魂怎奈珠宫远。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "90ccd0cdf4e4214cf0207be3144977fbdf3cf14ebd44da6322b627aa8bff2555",
      "estimatedOutput": 762,
      "resultPath": "expansion/working/v2/results/song-703--90ccd0cdf4e4214cf0207be3144977fbdf3cf14ebd44da6322b627aa8bff2555.json"
    },
    {
      "id": "song-704",
      "category": "宋词",
      "title": "渔家傲",
      "subtitle": "二月春期看已半",
      "author": "欧阳修",
      "dynasty": "宋",
      "content": "二月春期看已半。\n江边春色青犹短。\n天气养花红日暖。\n深深院。\n真珠帘额初飞燕。\n渐觉衔杯心绪懒。\n酒侵花脸娇波慢。\n一捻闲愁无处遣。\n牵不断。\n游丝百尺随风远。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "e5761389736c757e4915867204251ca6396f908d6d1811e436cbc4be109b2b41",
      "estimatedOutput": 762,
      "resultPath": "expansion/working/v2/results/song-704--e5761389736c757e4915867204251ca6396f908d6d1811e436cbc4be109b2b41.json"
    },
    {
      "id": "song-705",
      "category": "宋词",
      "title": "渔家傲",
      "subtitle": "三月芳菲看欲暮",
      "author": "欧阳修",
      "dynasty": "宋",
      "content": "三月芳菲看欲暮。\n胭脂泪洒梨花雨。\n宝马绣轩南陌路。\n笙歌举。\n踏青斗草人无数。\n强欲留春春不住。\n东皇肯信韶容故。\n安得此身如柳絮。\n随风去。\n穿帘透幕寻朱户。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "9258ea764a4bcf828cbc7d8eb6580829faa17c854da5efbfadddd3f614ae02ce",
      "estimatedOutput": 762,
      "resultPath": "expansion/working/v2/results/song-705--9258ea764a4bcf828cbc7d8eb6580829faa17c854da5efbfadddd3f614ae02ce.json"
    },
    {
      "id": "song-706",
      "category": "宋词",
      "title": "渔家傲",
      "subtitle": "四月芳林何悄悄",
      "author": "欧阳修",
      "dynasty": "宋",
      "content": "四月芳林何悄悄。\n绿阴满地青梅小。\n南陌采桑何窈窕。\n争语笑。\n乱丝满腹吴蚕老。\n宿酒半醒新睡觉。\n雏莺相语匆匆晓。\n惹得此情萦寸抱。\n休临眺。\n楼头一望皆芳草。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "2a26965190d6f3268bfb5ca4ade9b3a4a617dc2dd414aa3c5a841bf62c6505ad",
      "estimatedOutput": 762,
      "resultPath": "expansion/working/v2/results/song-706--2a26965190d6f3268bfb5ca4ade9b3a4a617dc2dd414aa3c5a841bf62c6505ad.json"
    },
    {
      "id": "song-707",
      "category": "宋词",
      "title": "渔家傲",
      "subtitle": "五月薰风才一信",
      "author": "欧阳修",
      "dynasty": "宋",
      "content": "五月薰风才一信。\n初荷出水清香嫩。\n乳燕学飞帘额峻。\n谁借问。\n东邻期约尝佳酝。\n漏短日长人乍困。\n裙腰减尽柔肌损。\n一撮眉尖千叠恨。\n慵整顿。\n黄梅雨细多闲闷。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "f558abc99a9ef3a679e284779a0e4579b164a1e099999929903371173599ba7b",
      "estimatedOutput": 762,
      "resultPath": "expansion/working/v2/results/song-707--f558abc99a9ef3a679e284779a0e4579b164a1e099999929903371173599ba7b.json"
    },
    {
      "id": "song-708",
      "category": "宋词",
      "title": "渔家傲",
      "subtitle": "六月炎蒸何太盛",
      "author": "欧阳修",
      "dynasty": "宋",
      "content": "六月炎蒸何太盛。\n海榴灼灼红相映。\n天外奇峰千掌迥。\n风影定。\n汉宫圆扇初成咏。\n珠箔初褰深院静。\n绛绡衣窄冰肤莹。\n睡起日高堆酒兴。\n厌厌病。\n宿酲和梦何时醒。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "d4b85fa8c9374b9f5b2535fc4bfa21c0d8d9ac720a524c358929c913fe3222cd",
      "estimatedOutput": 762,
      "resultPath": "expansion/working/v2/results/song-708--d4b85fa8c9374b9f5b2535fc4bfa21c0d8d9ac720a524c358929c913fe3222cd.json"
    },
    {
      "id": "song-709",
      "category": "宋词",
      "title": "渔家傲",
      "subtitle": "七月芙蓉生翠水",
      "author": "欧阳修",
      "dynasty": "宋",
      "content": "七月芙蓉生翠水。\n明霞拂脸新妆媚。\n疑是楚宫歌舞妓。\n争宠丽。\n临风起舞夸腰细。\n乌鹊桥边新雨霁。\n长河清水冰无地。\n此夕有人千里外。\n经年岁。\n犹嗟不及牵牛会。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "789524609865723280fb259ac1e9a4c8b3248838408f39028f907cf320f00bfd",
