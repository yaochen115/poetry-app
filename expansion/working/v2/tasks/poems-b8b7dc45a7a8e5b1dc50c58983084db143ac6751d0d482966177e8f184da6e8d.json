    },
    {
      "id": "song-976",
      "category": "宋词",
      "title": "玉楼春",
      "subtitle": "一尊相遇春风里",
      "author": "晏几道",
      "dynasty": "宋",
      "content": "一尊相遇春风里。\n诗好似君人有几。\n吴姬十五语如弦，能唱当时楼下水。\n良辰易去如弹指。\n金盏十分须尽意。\n明朝三丈日高时，共拼醉头扶不起。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "4e0869f1c5594e9a1917a0ec3fecb40c15611dcd7a5aa575601b91734a780e6e",
      "estimatedOutput": 738,
      "resultPath": "expansion/working/v2/results/song-976--4e0869f1c5594e9a1917a0ec3fecb40c15611dcd7a5aa575601b91734a780e6e.json"
    },
    {
      "id": "song-977",
      "category": "宋词",
      "title": "玉楼春",
      "subtitle": "琼酥酒面风吹醒",
      "author": "晏几道",
      "dynasty": "宋",
      "content": "琼酥酒面风吹醒。\n一缕斜红临晚镜。\n小颦微笑尽妖娆，浅注轻匀长淡净。\n手挪梅蕊寻香径。\n正是佳期期未定。\n春来还为个般愁，瘦损宫腰罗带剩。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "b43a834d09a8476933b1c1b8e95e87dad9c51c379854e64433bcae674ee4bb53",
      "estimatedOutput": 738,
      "resultPath": "expansion/working/v2/results/song-977--b43a834d09a8476933b1c1b8e95e87dad9c51c379854e64433bcae674ee4bb53.json"
    },
    {
      "id": "song-978",
      "category": "宋词",
      "title": "玉楼春",
      "subtitle": "清歌学得秦娥似",
      "author": "晏几道",
      "dynasty": "宋",
      "content": "清歌学得秦娥似。\n金屋瑶台知姓字。\n可怜春恨一生心，长带粉痕双袖泪。\n从来懒话低眉事。\n今日新声谁会意。\n坐中应有赏音人，试问回肠曾断未。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "d1aa4d51db85e0b8dec048250b2ac69d94c0d9cf2b20c5574575de32b39bef96",
      "estimatedOutput": 738,
      "resultPath": "expansion/working/v2/results/song-978--d1aa4d51db85e0b8dec048250b2ac69d94c0d9cf2b20c5574575de32b39bef96.json"
    },
    {
      "id": "song-979",
      "category": "宋词",
      "title": "玉楼春",
      "subtitle": "旗亭西畔朝云住",
      "author": "晏几道",
      "dynasty": "宋",
      "content": "旗亭西畔朝云住。\n沈水香烟长满路。\n柳阴分到画眉边，花片飞来垂手处。\n妆成尽任秋娘妒。\n袅袅盈盈当绣户。\n临风一曲醉朦腾，陌上行人凝恨去。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "b48075534c3e844ef9cf41f9bca003fcb1c447277515ee6eb9b974997105a381",
      "estimatedOutput": 738,
      "resultPath": "expansion/working/v2/results/song-979--b48075534c3e844ef9cf41f9bca003fcb1c447277515ee6eb9b974997105a381.json"
    },
    {
      "id": "song-980",
      "category": "宋词",
      "title": "玉楼春",
      "subtitle": "离鸾照罢尘生镜",
      "author": "晏几道",
      "dynasty": "宋",
      "content": "离鸾照罢尘生镜。\n几点吴霜侵绿鬓。\n琵琶弦上语无凭，豆蔻梢头春有信。\n相思拼损朱颜尽。\n天若多情终欲问。\n雪窗休记夜来寒，桂酒已消人去恨。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "c8e9384113687d9bc020464d1e4c3a8a8c40aaa0078de3ce63825289e9b59fbf",
      "estimatedOutput": 738,
      "resultPath": "expansion/working/v2/results/song-980--c8e9384113687d9bc020464d1e4c3a8a8c40aaa0078de3ce63825289e9b59fbf.json"
    },
    {
      "id": "song-981",
      "category": "宋词",
      "title": "玉楼春",
      "subtitle": "东风又作无情计",
      "author": "晏几道",
      "dynasty": "宋",
      "content": "东风又作无情计。\n艳粉娇红吹满地。\n碧楼帘影不遮愁，还似去年今日意。\n谁知错管春残事。\n到处登临曾费泪。\n此时金盏直须深，看尽落花能几醉。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "656f79288f05bf07b61679191ee2ee6debfe92c51273a43c3e80543d42266c2e",
      "estimatedOutput": 738,
      "resultPath": "expansion/working/v2/results/song-981--656f79288f05bf07b61679191ee2ee6debfe92c51273a43c3e80543d42266c2e.json"
    },
    {
      "id": "song-982",
      "category": "宋词",
      "title": "玉楼春",
      "subtitle": "斑骓路与阳台近",
      "author": "晏几道",
      "dynasty": "宋",
      "content": "斑骓路与阳台近。\n前度无题初借问。\n暖风鞭袖尽闲垂，微月帘栊曾暗认。\n梅花未足凭芳信。\n弦语岂堪传素恨。\n翠眉饶似远山长，寄与此愁颦不尽。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "a0275f21b307032dbc6c0289b982cf46397498259b3e114ca770b8e5207888af",
      "estimatedOutput": 738,
      "resultPath": "expansion/working/v2/results/song-982--a0275f21b307032dbc6c0289b982cf46397498259b3e114ca770b8e5207888af.json"
    },
    {
      "id": "song-983",
      "category": "宋词",
      "title": "玉楼春",
      "subtitle": "红绡学舞腰肢软",
      "author": "晏几道",
      "dynasty": "宋",
      "content": "红绡学舞腰肢软。\n旋织舞衣宫样染。\n织成云外雁行斜，染作江南春水浅。\n露桃宫里随歌管。\n一曲霓裳红日晚。\n归来双袖酒成痕，小字香笺无意展。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "a339076f1bdad2d5282e0300353f7bff9730120f1a7d5c14078288a72b88756b",
      "estimatedOutput": 738,
      "resultPath": "expansion/working/v2/results/song-983--a339076f1bdad2d5282e0300353f7bff9730120f1a7d5c14078288a72b88756b.json"
    },
    {
      "id": "song-984",
      "category": "宋词",
      "title": "玉楼春",
      "subtitle": "采莲时候慵歌舞",
      "author": "晏几道",
      "dynasty": "宋",
      "content": "采莲时候慵歌舞。\n永日闲从花里度。\n暗随苹末晓风来，直待柳梢斜月去。\n停桡共说江头路。\n临水楼台苏小住。\n细思巫峡梦回时，不减秦源肠断处。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "a81daed603c7b7e99f56d82f9119cb2f5a47d1d46777cede255814b0d716e290",
      "estimatedOutput": 738,
      "resultPath": "expansion/working/v2/results/song-984--a81daed603c7b7e99f56d82f9119cb2f5a47d1d46777cede255814b0d716e290.json"
    },
    {
      "id": "song-985",
      "category": "宋词",
      "title": "玉楼春",
      "subtitle": "芳年正是香英嫩",
      "author": "晏几道",
      "dynasty": "宋",
      "content": "芳年正是香英嫩。\n天与娇波长入鬓。\n蕊珠宫里旧承恩，夜拂银屏朝把镜。\n云情去住终难信。\n花意有无休更问。\n醉中同尽一杯欢，归后各成孤枕恨。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "8e85d46e4402e565bf5cb379a6a8e82bc7d89d8769ab0927b0cc7660e78bf969",
