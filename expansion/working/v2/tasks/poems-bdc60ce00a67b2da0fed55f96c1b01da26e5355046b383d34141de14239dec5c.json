    },
    {
      "id": "song-868",
      "category": "宋词",
      "title": "诉衷情",
      "subtitle": "常时黄色见眉间",
      "author": "王安石",
      "dynasty": "宋",
      "content": "常时黄色见眉间。\n松桂我同攀。\n每言天上辛苦，不肯饵金丹。\n怜水静，爱云闲。\n便忘还。\n高歌一曲，岩谷迤逦，宛似商山。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "044bcd024b7d4fab14ab6499974532043a8b7e30e2f83af8344d3691f97032c6",
      "estimatedOutput": 718,
      "resultPath": "expansion/working/v2/results/song-868--044bcd024b7d4fab14ab6499974532043a8b7e30e2f83af8344d3691f97032c6.json"
    },
    {
      "id": "song-869",
      "category": "宋词",
      "title": "诉衷情",
      "subtitle": "练巾藜杖白云间",
      "author": "王安石",
      "dynasty": "宋",
      "content": "练巾藜杖白云间。\n有兴即跻攀。\n追思往昔如梦，华毂也曾丹。\n尘自扰，性长闲。\n更无还。\n达如周召，穷似丘轲，祗个山山。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "940327a2a52874b6bd97de3682f7a906b9d6cf016017a4a17a5a059a79e8b22c",
      "estimatedOutput": 718,
      "resultPath": "expansion/working/v2/results/song-869--940327a2a52874b6bd97de3682f7a906b9d6cf016017a4a17a5a059a79e8b22c.json"
    },
    {
      "id": "song-870",
      "category": "宋词",
      "title": "诉衷情",
      "subtitle": "茫然不肯住林间",
      "author": "王安石",
      "dynasty": "宋",
      "content": "茫然不肯住林间。\n有处即追攀。\n将他死语图度，怎得离真丹。\n浆水价，匹如闲。\n也须还。\n何如直截，踢倒军持，赢取沩山。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "e31f51aaa9c2c4981e40fcfa0ca8e061b9575603840178ae5bb5b7c160c8121c",
      "estimatedOutput": 718,
      "resultPath": "expansion/working/v2/results/song-870--e31f51aaa9c2c4981e40fcfa0ca8e061b9575603840178ae5bb5b7c160c8121c.json"
    },
    {
      "id": "song-871",
      "category": "宋词",
      "title": "诉衷情",
      "subtitle": "营巢燕子逞翱翔",
      "author": "王安石",
      "dynasty": "宋",
      "content": "营巢燕子逞翱翔。\n微志在雕梁。\n碧云举翮千里，其奈有鸾皇。\n临济处，德山行。\n果承当。\n自时降住，一切天魔，扫地焚香。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "25039f02298be5fb3dacba2263a2b1c15ef252b1379ba9c3fe8f960e94fc8013",
      "estimatedOutput": 718,
      "resultPath": "expansion/working/v2/results/song-871--25039f02298be5fb3dacba2263a2b1c15ef252b1379ba9c3fe8f960e94fc8013.json"
    },
    {
      "id": "song-872",
      "category": "宋词",
      "title": "诉衷情",
      "subtitle": "莫言普化祗颠狂",
      "author": "王安石",
      "dynasty": "宋",
      "content": "莫言普化祗颠狂。\n真解作津梁。\n蓦然打个筋斗，直跳过羲皇。\n临济处，德山行。\n果承当。\n将他建立，认作心诚，也是寻香。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "5354ff51fdb3bfcb741546e2e0fcb0ca9f9e8a4e02ab236b9774afab1870b1c4",
      "estimatedOutput": 718,
      "resultPath": "expansion/working/v2/results/song-872--5354ff51fdb3bfcb741546e2e0fcb0ca9f9e8a4e02ab236b9774afab1870b1c4.json"
    },
    {
      "id": "song-873",
      "category": "宋词",
      "title": "南乡子",
      "subtitle": "嗟见世间人但有",
      "author": "王安石",
      "dynasty": "宋",
      "content": "嗟见世间人。\n但有纤毫即是尘。\n不住旧时无相貌，沈沦。\n祗为从来认识神。\n作麽有疏亲。\n我自降魔转法轮。\n不是摄心除妄想，求真。\n幻化空身即法身。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "ed9cd4e86b38087256507dbee9607f295619df88b57c3cdf5dd8e1afabd4df61",
      "estimatedOutput": 746,
      "resultPath": "expansion/working/v2/results/song-873--ed9cd4e86b38087256507dbee9607f295619df88b57c3cdf5dd8e1afabd4df61.json"
    },
    {
      "id": "song-874",
      "category": "宋词",
      "title": "西江月",
      "subtitle": "梅好惟嫌淡伫天",
      "author": "王安石",
      "dynasty": "宋",
      "content": "梅好惟嫌淡伫，天教薄与胭脂。\n真妃初出华清池。\n酒入琼姬半醉。\n东阁诗情易动，高楼玉管休吹。\n北人浑作杏花疑。\n惟有青枝不似。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "54a7343af250816ec1f6e2cccba037006ccec5a7a4c7c5d835613e7935f34c46",
      "estimatedOutput": 726,
      "resultPath": "expansion/working/v2/results/song-874--54a7343af250816ec1f6e2cccba037006ccec5a7a4c7c5d835613e7935f34c46.json"
    },
    {
      "id": "song-875",
      "category": "宋词",
      "title": "生查子",
      "subtitle": "雨打江南树一夜",
      "author": "王安石",
      "dynasty": "宋",
      "content": "雨打江南树。\n一夜花开无数。\n绿叶渐成阴，下有游人归路。\n与君相逢处。\n不道春将暮。\n把酒祝东风，且莫恁、匆匆去。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "135b7e475eb5a38aab4a5157bb3a4d65984dc17f692c9e4ec08f89c917edd4a4",
      "estimatedOutput": 714,
      "resultPath": "expansion/working/v2/results/song-875--135b7e475eb5a38aab4a5157bb3a4d65984dc17f692c9e4ec08f89c917edd4a4.json"
    },
    {
      "id": "song-876",
      "category": "宋词",
      "title": "谒金门",
      "subtitle": "春又老南陌酒香",
      "author": "王安石",
      "dynasty": "宋",
      "content": "春又老。\n南陌酒香梅小。\n遍地落花浑不扫。\n梦回情意悄。\n红笺寄与添烦恼。\n细写相思多少。\n醉后几行书字小。\n泪痕都搵了。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "515a7e81f92320e844dd40cc219e374cc17981820dc35316c751ce212a79233d",
      "estimatedOutput": 722,
      "resultPath": "expansion/working/v2/results/song-876--515a7e81f92320e844dd40cc219e374cc17981820dc35316c751ce212a79233d.json"
    },
    {
      "id": "song-877",
      "category": "宋词",
      "title": "菩萨蛮",
      "subtitle": "海棠乱发皆临水",
      "author": "王安石",
      "dynasty": "宋",
      "content": "海棠乱发皆临水。\n君知此处花何似。\n凉月白纷纷。\n香风隔岸闻。\n啭枝黄鸟近。\n隔岸声相应。\n随意坐莓苔。\n飘零酒一杯。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "f2b94ba0e9182de6b03f068f6dbbaca66145850c4193719094307b6eee954240",
