    },
    {
      "id": "song-483",
      "category": "宋词",
      "title": "菩萨蛮",
      "subtitle": "忆郎还上层楼曲",
      "author": "张先",
      "dynasty": "宋",
      "content": "忆郎还上层楼曲。\n楼前芳草年年绿。\n绿似去时袍。\n回头风袖飘。\n郎袍应已旧。\n颜色非长久。\n惜恐镜中春。\n不如花草新。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "46b028ca3abc3b5cef2fb3e4b3089f64856bc7f38f016df3878ad431b7f5a6de",
      "estimatedOutput": 718,
      "resultPath": "expansion/working/v2/results/song-483--46b028ca3abc3b5cef2fb3e4b3089f64856bc7f38f016df3878ad431b7f5a6de.json"
    },
    {
      "id": "song-484",
      "category": "宋词",
      "title": "菩萨蛮",
      "subtitle": "闻人语著仙卿字",
      "author": "张先",
      "dynasty": "宋",
      "content": "闻人语著仙卿字。\n瞋情恨意还须喜。\n何况草长时。\n酒前频共伊。\n娇香堆宝帐。\n月到梨花上。\n心事两人知。\n掩灯罗幕垂。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "153f87d8f628d38f6d970b3f2357342e3f05e9df96f5e1740115dfa0f25ae16f",
      "estimatedOutput": 718,
      "resultPath": "expansion/working/v2/results/song-484--153f87d8f628d38f6d970b3f2357342e3f05e9df96f5e1740115dfa0f25ae16f.json"
    },
    {
      "id": "song-485",
      "category": "宋词",
      "title": "菩萨蛮",
      "subtitle": "夜深不至春蟾见",
      "author": "张先",
      "dynasty": "宋",
      "content": "夜深不至春蟾见。\n令人更更情飞乱。\n翠幕动风亭。\n时疑响屉声。\n花香闻水榭。\n几误飘衣麝。\n不忍下朱扉。\n绕廊重待伊。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "72b9c92d232481b0a9067deb08a7926c16b78a319e9700f607263360e2f30ad3",
      "estimatedOutput": 718,
      "resultPath": "expansion/working/v2/results/song-485--72b9c92d232481b0a9067deb08a7926c16b78a319e9700f607263360e2f30ad3.json"
    },
    {
      "id": "song-486",
      "category": "宋词",
      "title": "菩萨蛮",
      "subtitle": "簟纹衫色娇黄浅",
      "author": "张先",
      "dynasty": "宋",
      "content": "簟纹衫色娇黄浅。\n钗头秋叶玲珑翦。\n轻怯瘦腰身。\n纱窗病起人。\n相思魂欲绝。\n莫话新秋别。\n何处断离肠。\n西风昨夜凉。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "532858e3352b68b299add7d8eaf3e8b5da94fc545dd1ca9875cd84df3cc9cf4f",
      "estimatedOutput": 718,
      "resultPath": "expansion/working/v2/results/song-486--532858e3352b68b299add7d8eaf3e8b5da94fc545dd1ca9875cd84df3cc9cf4f.json"
    },
    {
      "id": "song-487",
      "category": "宋词",
      "title": "踏莎行",
      "subtitle": "衾凤犹温笼鹦尚",
      "author": "张先",
      "dynasty": "宋",
      "content": "衾凤犹温，笼鹦尚睡。\n宿妆稀淡眉成字。\n映花避月上行廊，珠裙摺摺轻垂地。\n翠幕成波，新荷贴水。\n纷纷烟柳低还起。\n重墙绕院更重门，春风无路通深意。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "5d45541e10ece2ed0e2a3f336a665c4dc0ca16876d144980ae3d60c55e40e12f",
      "estimatedOutput": 746,
      "resultPath": "expansion/working/v2/results/song-487--5d45541e10ece2ed0e2a3f336a665c4dc0ca16876d144980ae3d60c55e40e12f.json"
    },
    {
      "id": "song-488",
      "category": "宋词",
      "title": "踏莎行",
      "subtitle": "波湛横眸霞分腻",
      "author": "张先",
      "dynasty": "宋",
      "content": "波湛横眸，霞分腻脸。\n盈盈笑动笼香靥。\n有情未结凤楼欢，无憀爱把歌眉敛。\n密意欲传，娇羞未敢。\n斜偎象板还偷盰。\n轻轻试问借人麽，佯佯不觑云鬟点。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "7674372086f90d07c511732268fe93f49dda9edee84f0ff597e61494eb1401a3",
      "estimatedOutput": 746,
      "resultPath": "expansion/working/v2/results/song-488--7674372086f90d07c511732268fe93f49dda9edee84f0ff597e61494eb1401a3.json"
    },
    {
      "id": "song-489",
      "category": "宋词",
      "title": "西江月",
      "subtitle": "体态看来隐约梳",
      "author": "张先",
      "dynasty": "宋",
      "content": "体态看来隐约，梳妆好是家常。\n檀槽初抱更安详。\n立向尊前一行。\n小打登钩怕重，尽缠绣带由长。\n娇春莺舌巧如簧。\n飞在四条弦上。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "340de41836f14d67bbe93a5564dd7c21b8587fc749ec3eca2140ef9904bc5508",
      "estimatedOutput": 726,
      "resultPath": "expansion/working/v2/results/song-489--340de41836f14d67bbe93a5564dd7c21b8587fc749ec3eca2140ef9904bc5508.json"
    },
    {
      "id": "song-490",
      "category": "宋词",
      "title": "浣溪沙",
      "subtitle": "轻屉来时不破尘",
      "author": "张先",
      "dynasty": "宋",
      "content": "轻屉来时不破尘。\n石榴花映石榴裙。\n有情应得撞腮春。\n夜短更难留远梦，日高何计学行云。\n树深莺过静无人。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "fc45dce9f12846701ad2bd55ec0a79d6f1f1afc6609edce2e1a2baeb4b6d2c05",
      "estimatedOutput": 704,
      "resultPath": "expansion/working/v2/results/song-490--fc45dce9f12846701ad2bd55ec0a79d6f1f1afc6609edce2e1a2baeb4b6d2c05.json"
    },
    {
      "id": "song-491",
      "category": "宋词",
      "title": "西江月",
      "subtitle": "泛泛春船载乐溶",
      "author": "张先",
      "dynasty": "宋",
      "content": "泛泛春船载乐，溶溶湖水平桥。\n高鬟照影翠烟摇。\n白纻一声云杪。\n倦醉天然玉软，弄妆人惜花娇。\n风情遗恨几时消。\n不见卢郎年少。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "15914eda17d84d1deed78972ffbd0234aa0b0dcb12174555d07fb8a0421b26d9",
      "estimatedOutput": 726,
      "resultPath": "expansion/working/v2/results/song-491--15914eda17d84d1deed78972ffbd0234aa0b0dcb12174555d07fb8a0421b26d9.json"
    },
    {
      "id": "song-492",
      "category": "宋词",
      "title": "好事近",
      "subtitle": "月色透横枝短叶",
      "author": "张先",
      "dynasty": "宋",
      "content": "月色透横枝，短叶小花无力。\n北客一声长笛，怨江南先得。\n谁教强半腊前开，多情为春忆。\n留取大家沈醉，正雨休风息。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "394b44867c5ac9379e0d32bcd2b10b2f7271a672138bbb0c507c106c2b614310",
      "estimatedOutput": 712,
      "resultPath": "expansion/working/v2/results/song-492--394b44867c5ac9379e0d32bcd2b10b2f7271a672138bbb0c507c106c2b614310.json"
    },
    {
      "id": "song-493",
      "category": "宋词",
      "title": "好事近",
      "subtitle": "灯烛上山堂香雾",
      "author": "张先",
      "dynasty": "宋",
      "content": "灯烛上山堂，香雾暖生寒夕。\n前夜雪清梅瘦，已不禁轻摘。\n双歌声断宝杯空，妆光艳瑶席。\n相趁笑声归去，有随人月色。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "3a55453a6657d5cb7a6afcb3d8d39aa724262299c804dd07e97d7d26e7cb9c6c",
