      "resultPath": "expansion/working/v2/results/yuan-147--1ea021a6adf8f9dc60230260e6f96ac4cba0e17eac747a4e01f40ecdfea46d4a.json"
    },
    {
      "id": "yuan-148",
      "category": "元曲",
      "title": "山坡羊",
      "subtitle": "讥时",
      "author": "曾瑞",
      "dynasty": "元",
      "content": "繁花春尽，穷途人困，太平分的清闲运。整乾坤，会经纶，奈何不遂风雷信？朝市得安为大隐。咱，装做蠢；民，何受窘！",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "6e1547e09cf3990a7e16b79d2a7f842838ca3178af12962fa9f63a06ceebd358",
      "estimatedOutput": 708,
      "resultPath": "expansion/working/v2/results/yuan-148--6e1547e09cf3990a7e16b79d2a7f842838ca3178af12962fa9f63a06ceebd358.json"
    },
    {
      "id": "yuan-149",
      "category": "元曲",
      "title": "山坡羊",
      "subtitle": "寓兴",
      "author": "乔吉",
      "dynasty": "元",
      "content": "鹏抟九万，腰缠十万，扬州鹤背骑来惯。事间关，景阑珊，黄金不富英雄汉，一片世情天地间。白，也是眼；青，也是眼。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "6e04858398ad30dc0a655a1d9846218e2342a283df6bd9688d72d574b54efa02",
      "estimatedOutput": 708,
      "resultPath": "expansion/working/v2/results/yuan-149--6e04858398ad30dc0a655a1d9846218e2342a283df6bd9688d72d574b54efa02.json"
    },
    {
      "id": "yuan-150",
      "category": "元曲",
      "title": "山坡羊",
      "subtitle": "晴云轻漾",
      "author": "薛昂夫",
      "dynasty": "元",
      "content": "晴云轻漾，薰风无浪，开樽避暑争相向。映湖光，逞新妆，笙歌鼎沸南湖荡，今夜且休回画舫。\n风，满座凉；莲，入梦香。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "e8c843fe4507f1506eb342fb70d0939e359ed8ccd423bcd7464fcafab29a8d44",
      "estimatedOutput": 710,
      "resultPath": "expansion/working/v2/results/yuan-150--e8c843fe4507f1506eb342fb70d0939e359ed8ccd423bcd7464fcafab29a8d44.json"
    },
    {
      "id": "yuan-151",
      "category": "元曲",
      "title": "正宫·叨叨令",
      "subtitle": "",
      "author": "邓玉宾",
      "dynasty": "元",
      "content": "一个空皮囊包裹着千重气，一个干骷髅顶戴着十分罪。为儿女使尽了拖刀计，为家私费尽了担山力。你省的也么哥，你省的也么哥，这一个长生道理何人会？",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "97de3aed5f17c9c1a46551fdbf1fe6d297b939b834caf27c6a115354edca0447",
      "estimatedOutput": 738,
      "resultPath": "expansion/working/v2/results/yuan-151--97de3aed5f17c9c1a46551fdbf1fe6d297b939b834caf27c6a115354edca0447.json"
    },
    {
      "id": "yuan-152",
      "category": "元曲",
      "title": "中吕·醉高歌带摊破喜春来·旅中",
      "subtitle": "",
      "author": "顾德润",
      "dynasty": "元",
      "content": "长江远映青山，回首难穷望眼。扁舟来往蒹葭岸，人憔悴云林又晚。篱边黄菊经霜暗，囊底青蚨逐日悭。破清思晚砧鸣，断愁肠檐马韵，惊客梦晓钟寒，归去难！修一缄，回首字寄平安。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "eb016a38815b4ad2e934f11cd26da681a019729c7b8898bb4c0cb0ea78c700e2",
      "estimatedOutput": 764,
      "resultPath": "expansion/working/v2/results/yuan-152--eb016a38815b4ad2e934f11cd26da681a019729c7b8898bb4c0cb0ea78c700e2.json"
    },
    {
      "id": "yuan-153",
      "category": "元曲",
      "title": "双调·水仙子·幽居",
      "subtitle": "",
      "author": "任昱",
      "dynasty": "元",
      "content": "小堂不闭野云封，隔水时间涧大舂、比邻分得山田种。宦情薄归兴浓。想从前错怨天公，食禄黄齑瓮，忘忧绿酒钟；未必全穷。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "1877110a2bf4abd779985830bda9f221498d2ada9e1c93cc053974ff1348331d",
      "estimatedOutput": 712,
      "resultPath": "expansion/working/v2/results/yuan-153--1877110a2bf4abd779985830bda9f221498d2ada9e1c93cc053974ff1348331d.json"
    },
    {
      "id": "yuan-154",
      "category": "元曲",
      "title": "双调驻马听吹",
      "subtitle": "",
      "author": "白朴",
      "dynasty": "元",
      "content": "裂石穿云，玉管宜横清更洁。霜天沙漠，鹧鸪风里欲偏斜。\n凤凰台上暮云遮，梅花惊作黄昏雪。人静也，一声吹落江楼月。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "a4e5398d9643e154759cab541722137e5663ca38f679bc96f8dbab2c15c8913c",
      "estimatedOutput": 710,
      "resultPath": "expansion/working/v2/results/yuan-154--a4e5398d9643e154759cab541722137e5663ca38f679bc96f8dbab2c15c8913c.json"
    },
    {
      "id": "yuan-155",
      "category": "元曲",
      "title": "雁儿落带过得胜令·春花闻杜鹃",
      "subtitle": "",
      "author": "吴西逸",
      "dynasty": "元",
      "content": "春花闻杜鹃，秋月看归燕。人情薄似云，风景疾如箭。\n留下买花钱，趱入种桑园。茅盖三间厦，秧肥数顷田。\n床边，放一册冷淡渊明传，窗前，抄几首清新杜甫篇。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "085a1d9656e2e44c351a9e6e718bc82098c84a8675d380f8c872c44eacfd8682",
      "estimatedOutput": 748,
      "resultPath": "expansion/working/v2/results/yuan-155--085a1d9656e2e44c351a9e6e718bc82098c84a8675d380f8c872c44eacfd8682.json"
    },
    {
      "id": "yuan-156",
      "category": "元曲",
      "title": "越调·天净沙·闲题",
      "subtitle": "",
      "author": "吴西逸",
      "dynasty": "元",
      "content": "长江万里归帆，西风几度阳关，依旧红尘满眼。夕阳新雁，此情时拍阑干。\n江亭远树残霞，淡烟荒草平沙，绿柳阴中系马。夕阳西下，水村山郭人家",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "429b38784f94631d6a821594a55d41f41fb2eee41e6247c11b6c6dc148612fd1",
      "estimatedOutput": 732,
      "resultPath": "expansion/working/v2/results/yuan-156--429b38784f94631d6a821594a55d41f41fb2eee41e6247c11b6c6dc148612fd1.json"
    },
    {
      "id": "yuan-157",
      "category": "元曲",
      "title": "双调·蟾宫曲·纪旧",
      "subtitle": "",
      "author": "吴西逸",
      "dynasty": "元",
      "content": "折花枝寄与多情，唤起真真，留恋卿卿。隐约眉峰，依稀雾鬓，仿佛银屏。\n曾话旧花边月影，共衔杯扇底歌声。款款深盟，无限思量，笑语盈盈。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "f71c6a3b559f42a26194a1fd3cc234f254176f878dd4e8f68b18333b68d3d0a7",
