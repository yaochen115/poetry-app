    },
    {
      "id": "yuan-147",
      "category": "元曲",
      "title": "朱履曲",
      "subtitle": "雪中黎正",
      "author": "卢挚",
      "dynasty": "元",
      "content": "数盏后兜回吟兴，六花飞惹起歌声，东道西邻富才情。这其间听鹤唳，再索甚趁鸥盟，不强如孟襄阳干受冷。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "1ea021a6adf8f9dc60230260e6f96ac4cba0e17eac747a4e01f40ecdfea46d4a",
