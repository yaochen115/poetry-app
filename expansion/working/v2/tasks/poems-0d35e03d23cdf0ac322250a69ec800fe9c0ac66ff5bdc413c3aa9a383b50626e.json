    {
      "id": "yuan-062",
      "category": "元曲",
      "title": "庆宣和",
      "subtitle": "春晚病起",
      "author": "张可久",
      "dynasty": "元",
      "content": "燕子来时人未归，肯误佳期？一对灯花玉蛾飞，报报喜，报喜！",
      "excerptOf": null,
      "excerptNote": "",
