    {
      "id": "yuan-063",
      "category": "元曲",
      "title": "凭栏人",
      "subtitle": "春日怀古",
      "author": "赵善庆",
      "dynasty": "元",
      "content": "铜雀台空锁暮云，金谷园荒成路尘。转头千载春，断肠几辈人。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "f01d105551ac6b4866044712c1128c6e9f17c59dd1b8ae16cabc4ce7eedaf8d0",
      "estimatedOutput": 656,
      "resultPath": "expansion/working/v2/results/yuan-063--f01d105551ac6b4866044712c1128c6e9f17c59dd1b8ae16cabc4ce7eedaf8d0.json"
    },
    {
      "id": "yuan-064",
      "category": "元曲",
      "title": "凭栏人",
      "subtitle": "春思",
      "author": "乔吉",
      "dynasty": "元",
      "content": "淡月梨花曲槛傍，清露苍苔罗袜凉。恨他愁断肠，为他烧夜香。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "1878acedea4f9a7bccadba82943a18ac3cac560a0c5160281a25bb674ca4d175",
      "estimatedOutput": 656,
      "resultPath": "expansion/working/v2/results/yuan-064--1878acedea4f9a7bccadba82943a18ac3cac560a0c5160281a25bb674ca4d175.json"
    },
    {
      "id": "yuan-065",
      "category": "元曲",
      "title": "凭栏人",
      "subtitle": "咏史",
      "author": "徐再思",
      "dynasty": "元",
      "content": "九殿春风鳷鹊楼，千里离宫龙凤舟。始为天下忧，后为天下羞。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "fd74665b85dd0f17faf8b3a9dc24e2ae73dc29b0d8c1b915001514e9dc442ee3",
      "estimatedOutput": 656,
      "resultPath": "expansion/working/v2/results/yuan-065--fd74665b85dd0f17faf8b3a9dc24e2ae73dc29b0d8c1b915001514e9dc442ee3.json"
    },
    {
      "id": "yuan-066",
      "category": "元曲",
      "title": "得胜乐",
      "subtitle": "春",
      "author": "白朴",
      "dynasty": "元",
      "content": "丽日迟，和风习，共王孙公子游戏。\n醉酒淹衫袖湿，簪花压帽檐低。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "c5ee25b026fe4dd2c9a870e3903030e0c7a114aa39dd362dd0c52f436074c09d",
      "estimatedOutput": 662,
      "resultPath": "expansion/working/v2/results/yuan-066--c5ee25b026fe4dd2c9a870e3903030e0c7a114aa39dd362dd0c52f436074c09d.json"
    },
    {
      "id": "yuan-067",
      "category": "元曲",
      "title": "凭栏人",
      "subtitle": "马上墙头瞥见他",
      "author": "姚燧",
      "dynasty": "元",
      "content": "马上墙头瞥见他，眼角眉尖拖逗他。论文章他爱咱，睹妖娆咱爱他。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "4857206be43ff275c2fcb5dea8d1bd525ff378b4fb2f3a615e5513376a3c3901",
      "estimatedOutput": 660,
      "resultPath": "expansion/working/v2/results/yuan-067--4857206be43ff275c2fcb5dea8d1bd525ff378b4fb2f3a615e5513376a3c3901.json"
    },
    {
      "id": "yuan-068",
      "category": "元曲",
      "title": "得胜乐",
      "subtitle": "冬",
      "author": "白朴",
      "dynasty": "元",
      "content": "密布云，初交腊。偏宜去扫雪烹茶，羊羔酒添价。胆瓶内温水浸梅花。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "a03e73d75794ea1326ba52cd1183c4027f281a73a72db8312c75dea6fcec541d",
      "estimatedOutput": 662,
      "resultPath": "expansion/working/v2/results/yuan-068--a03e73d75794ea1326ba52cd1183c4027f281a73a72db8312c75dea6fcec541d.json"
    },
    {
      "id": "yuan-069",
      "category": "元曲",
      "title": "落梅风",
      "subtitle": "春晚",
      "author": "张可久",
      "dynasty": "元",
      "content": "东风景，西子湖。湿冥冥、柳烟花雾，黄莺乱啼胡蝶舞。\n几秋千、打将春去！",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "b3768b2173ade09d78987117b272c4edc483c885af3e7715d7aeb3c88fa233b9",
      "estimatedOutput": 670,
      "resultPath": "expansion/working/v2/results/yuan-069--b3768b2173ade09d78987117b272c4edc483c885af3e7715d7aeb3c88fa233b9.json"
    },
    {
      "id": "yuan-070",
      "category": "元曲",
      "title": "寿阳曲",
      "subtitle": "新秋至",
      "author": "贯云石",
      "dynasty": "元",
      "content": "新秋至，人乍别，顺长江水流残月。悠悠画船东去也，这思量起头儿一夜。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "f6d3993dfe701f3058252cae59f265a6df3372cc643d6a3b1919be337e447d9c",
      "estimatedOutput": 666,
      "resultPath": "expansion/working/v2/results/yuan-070--f6d3993dfe701f3058252cae59f265a6df3372cc643d6a3b1919be337e447d9c.json"
    },
    {
      "id": "yuan-071",
      "category": "元曲",
      "title": "天净沙",
      "subtitle": "冬",
      "author": "白朴",
      "dynasty": "元",
      "content": "门前六出花飞，樽前万事休提，为问东君信息。急教人探，小梅江上先知。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "e4d64d4bdbf9f86a512412946b5f1d00198b71043e42f8fe7da2da9c45965a61",
      "estimatedOutput": 666,
      "resultPath": "expansion/working/v2/results/yuan-071--e4d64d4bdbf9f86a512412946b5f1d00198b71043e42f8fe7da2da9c45965a61.json"
    },
