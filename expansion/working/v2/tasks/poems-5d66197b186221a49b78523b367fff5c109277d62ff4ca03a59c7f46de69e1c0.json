    },
    {
      "id": "song-688",
      "category": "宋词",
      "title": "玉楼春",
      "subtitle": "江南三月春光老",
      "author": "欧阳修",
      "dynasty": "宋",
      "content": "江南三月春光老。\n月落禽啼天未晓。\n露和啼血染花红，恨过千家烟树杪。\n云垂玉枕屏山小。\n梦欲成时惊觉了。\n人心应不似伊心，若解思归归合早。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "ba9bac44dc6f8b73ed623003189458d42637cec15623872dc6e9d5029e44ac68",
      "estimatedOutput": 738,
      "resultPath": "expansion/working/v2/results/song-688--ba9bac44dc6f8b73ed623003189458d42637cec15623872dc6e9d5029e44ac68.json"
    },
    {
      "id": "song-689",
      "category": "宋词",
      "title": "玉楼春",
      "subtitle": "东风本是开花信",
      "author": "欧阳修",
      "dynasty": "宋",
      "content": "东风本是开花信。\n及至花时风更紧。\n吹开吹谢苦匆匆，春意到头无处问。\n把酒临风千万恨。\n欲扫残红犹未忍。\n夜来风雨转离披，满眼凄凉愁不尽。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "1d9e6a158970395939f448fd697ec289f74aefebeb5a31114bfd5d43c618ac42",
      "estimatedOutput": 738,
      "resultPath": "expansion/working/v2/results/song-689--1d9e6a158970395939f448fd697ec289f74aefebeb5a31114bfd5d43c618ac42.json"
    },
    {
      "id": "song-690",
      "category": "宋词",
      "title": "玉楼春",
      "subtitle": "阴阴树色笼晴昼",
      "author": "欧阳修",
      "dynasty": "宋",
      "content": "阴阴树色笼晴昼。\n清淡园林春过后。\n杏腮轻粉日催红，池面绿罗风卷皱。\n佳人向晚新妆就。\n圆腻歌喉珠欲溜。\n当筵莫放酒杯迟，乐事良辰难入手。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "4f0b6c85cea5409f4971fac715e206fb006ab37a4b7652d3e086f37d09c31db1",
      "estimatedOutput": 738,
      "resultPath": "expansion/working/v2/results/song-690--4f0b6c85cea5409f4971fac715e206fb006ab37a4b7652d3e086f37d09c31db1.json"
    },
    {
      "id": "song-691",
      "category": "宋词",
      "title": "玉楼春",
      "subtitle": "芙蓉斗晕燕支浅",
      "author": "欧阳修",
      "dynasty": "宋",
      "content": "芙蓉斗晕燕支浅。\n留著晚花开小宴。\n画船红日晚风清，柳色溪光晴照暖。\n美人争劝梨花盏。\n舞困玉腰裙缕慢。\n莫交银烛促归期，已祝斜阳休更晚。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "d664ef3c813ac1601fb605af46ebbccd1aabf9d96afa7f1b893a5f3ecd5bb16e",
      "estimatedOutput": 738,
      "resultPath": "expansion/working/v2/results/song-691--d664ef3c813ac1601fb605af46ebbccd1aabf9d96afa7f1b893a5f3ecd5bb16e.json"
    },
    {
      "id": "song-692",
      "category": "宋词",
      "title": "渔家傲",
      "subtitle": "正月斗杓初转势",
      "author": "欧阳修",
      "dynasty": "宋",
      "content": "正月斗杓初转势。\n金刀剪彩功夫异。\n称庆高堂欢幼稚。\n看柳意。\n偏从东面春风至。\n十四新蟾圆尚未。\n楼前乍看红灯试。\n冰散绿池泉细细。\n鱼欲戏。\n园林已是花天气。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "f424f21401b437f5a27765eadb1baa7550f5de90dc35995f55951fc72c4049fd",
      "estimatedOutput": 762,
      "resultPath": "expansion/working/v2/results/song-692--f424f21401b437f5a27765eadb1baa7550f5de90dc35995f55951fc72c4049fd.json"
    },
    {
      "id": "song-693",
      "category": "宋词",
      "title": "渔家傲",
      "subtitle": "二月春耕昌杏密",
      "author": "欧阳修",
      "dynasty": "宋",
      "content": "二月春耕昌杏密。\n百花次第争先出。\n惟有海棠梨第一。\n深浅拂。\n天生红粉真无匹。\n画栋归来巢未失。\n双双款语怜飞乙。\n留客醉花迎晓日。\n金盏溢。\n却忧风雨飘零疾。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "7f7238d0e39eec3d69ad3b28f8f134dfb3c0db7b37bb1e43e08d68b9b9202bce",
      "estimatedOutput": 762,
      "resultPath": "expansion/working/v2/results/song-693--7f7238d0e39eec3d69ad3b28f8f134dfb3c0db7b37bb1e43e08d68b9b9202bce.json"
    },
    {
      "id": "song-694",
      "category": "宋词",
      "title": "渔家傲",
      "subtitle": "三月清明天婉娩",
      "author": "欧阳修",
      "dynasty": "宋",
      "content": "三月清明天婉娩。\n晴川祓禊归来晚。\n况是踏青来处远。\n犹不倦。\n秋千别闭深庭院。\n更值牡丹开欲遍。\n酴醿压架清香散。\n花底一尊谁解劝。\n增眷恋。\n东风回晚无情绊。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "3eae9f87b52dcf0696b28eadb858a041a10a453d15dc53ac20ba4931f4133e7a",
      "estimatedOutput": 762,
      "resultPath": "expansion/working/v2/results/song-694--3eae9f87b52dcf0696b28eadb858a041a10a453d15dc53ac20ba4931f4133e7a.json"
    },
    {
      "id": "song-695",
      "category": "宋词",
      "title": "渔家傲",
      "subtitle": "四月园林春去后",
      "author": "欧阳修",
      "dynasty": "宋",
      "content": "四月园林春去后。\n深深密幄阴初茂。\n折得花枝犹在手。\n香满袖。\n叶间梅子青如豆。\n风雨时时添气候。\n成行新笋霜筠厚。\n题就送春诗几首。\n聊对酒。\n樱桃色照银盘溜。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "f504085cc3c408fd6d411c487cec52d357da9581909d5a9dd7af16f4b6bf2f69",
      "estimatedOutput": 762,
      "resultPath": "expansion/working/v2/results/song-695--f504085cc3c408fd6d411c487cec52d357da9581909d5a9dd7af16f4b6bf2f69.json"
    },
    {
      "id": "song-696",
      "category": "宋词",
      "title": "渔家傲",
      "subtitle": "六月炎天时霎雨",
      "author": "欧阳修",
      "dynasty": "宋",
      "content": "六月炎天时霎雨。\n行云涌出奇峰露。\n沼上嫩莲腰束素。\n风兼露。\n梁王宫阕无烦暑。\n畏日亭亭残蕙炷。\n傍帘乳燕双飞去。\n碧碗敲冰倾玉处。\n朝与暮。\n故人风快凉轻度。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "50f4751b371252e106673ff71cc4503635d74812c6217f9f1fa687ec8b4be328",
      "estimatedOutput": 762,
      "resultPath": "expansion/working/v2/results/song-696--50f4751b371252e106673ff71cc4503635d74812c6217f9f1fa687ec8b4be328.json"
    },
    {
      "id": "song-697",
      "category": "宋词",
      "title": "渔家傲",
      "subtitle": "七月新秋风露早",
      "author": "欧阳修",
      "dynasty": "宋",
      "content": "七月新秋风露早。\n渚莲尚拆庭梧老。\n是处瓜华时节好。\n金尊倒。\n人间采缕争祈巧。\n万叶敲声凉乍到。\n百虫啼晚烟如扫。\n箭漏初长天杳杳。\n人语悄。\n那堪夜雨催清晓。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "b427104789917ebea9fc91dd5b78b08d58d88c410b6f399ffc88c3d957b32a7e",
