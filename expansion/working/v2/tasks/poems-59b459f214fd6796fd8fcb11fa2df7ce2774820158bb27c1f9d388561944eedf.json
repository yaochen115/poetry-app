    },
    {
      "id": "tang-750",
      "category": "唐诗",
      "title": "张郎中籍远寄长句开缄之日已及新秋因举目前仰酬高韵",
      "subtitle": "",
      "author": "刘禹锡",
      "dynasty": "唐",
      "content": "南宫词客寄新篇，清似湘灵促柱弦。\n京邑旧游劳梦想，历阳秋色正澄鲜。\n云衔日脚成山雨，风驾潮头入渚田。\n对此独吟还独酌，知音不见思怆然。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "93190f2a5d325b07280e06146f8ca4f205434e182946ce25cab5fd230bb15968",
      "estimatedOutput": 734,
      "resultPath": "expansion/working/v2/results/tang-750--93190f2a5d325b07280e06146f8ca4f205434e182946ce25cab5fd230bb15968.json"
    },
    {
      "id": "tang-751",
      "category": "唐诗",
      "title": "过瑞龙观道士",
      "subtitle": "",
      "author": "钱起",
      "dynasty": "唐",
      "content": "不知谁氏子，炼魄家洞天。\n鹤待成丹日，人寻种杏田。\n灵山含道气，物性皆自然。\n白鹿顾瑞草，骊龙蟠玉泉。\n得兹象外趣，便割区中缘。\n石窦采云母，霞堂陪列仙。\n主人善止客，柯烂忘归年。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "dfedc5a6a43cf643a01b2233caed9c0d56e255a6f45380056314d8633ae3f835",
      "estimatedOutput": 780,
      "resultPath": "expansion/working/v2/results/tang-751--dfedc5a6a43cf643a01b2233caed9c0d56e255a6f45380056314d8633ae3f835.json"
    },
    {
      "id": "tang-752",
      "category": "唐诗",
      "title": "偶吟",
      "subtitle": "",
      "author": "白居易",
      "dynasty": "唐",
      "content": "好官病免曾三度，散地归休已七年。\n老自退闲非世弃，贫蒙强健是天怜。\n韦荆南去留春服，王侍中来乞酒钱。\n便得一年生计足，与君美食复甘眠。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "437745869f35b770db5c8902712124ffb27a5282cc486f88aac41792740bd968",
      "estimatedOutput": 734,
      "resultPath": "expansion/working/v2/results/tang-752--437745869f35b770db5c8902712124ffb27a5282cc486f88aac41792740bd968.json"
    },
    {
      "id": "tang-753",
      "category": "唐诗",
      "title": "奉和袭美太湖诗二十首。孤园寺",
      "subtitle": "",
      "author": "陆龟蒙",
      "dynasty": "唐",
      "content": "浮屠从西来，事者极梁武。\n岩幽与水曲，结构无遗土。\n穷山林干尽，竭海珠玑聚。\n况即侍从臣，敢爱烟波坞。\n幡条玉龙扣，殿角金虬舞。\n释子厌楼台，生人露风雨。\n今来四百载，像设藏云浦。\n轻鸽乱驯鸥，鸣钟和朝橹。\n庭蕉裂旗旆，野蔓差缨组。\n石上解空人，窗前听经虎。\n林虚叶如织，水净沙堪数。\n遍问得中天，归修释迦谱。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "25b07c26589975ef7ddc7b52846f696f992a8d7c42d8c93c88e6cffae9e7e659",
      "estimatedOutput": 910,
      "resultPath": "expansion/working/v2/results/tang-753--25b07c26589975ef7ddc7b52846f696f992a8d7c42d8c93c88e6cffae9e7e659.json"
    },
    {
      "id": "tang-754",
      "category": "唐诗",
      "title": "赠别太常李博士兼寄两省旧游",
      "subtitle": "",
      "author": "韩翃",
      "dynasty": "唐",
      "content": "两年戴武弁，趋侍明光殿。\n一朝簪惠文，客事信陵君。\n简异当朝执，香非寓直熏。\n差肩何记室，携手李将军。\n玉镫初回酸枣馆，金钿正舞石榴裙。\n忽惊万事随流水，不见双旌逐塞云。\n感旧抚心多寂寂，与君相遇头初白。\n暂夸五首军中诗，还忆万年枝下客。\n昨日留欢今送归，空披秋水映斜晖。\n闲吟佳句对孤鹤，惆怅寒霜落叶稀。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "4dbdf40efb54d34c4dbd77e0c2fa2b088716bd8f780eb647c9dd90b2190721d2",
      "estimatedOutput": 906,
      "resultPath": "expansion/working/v2/results/tang-754--4dbdf40efb54d34c4dbd77e0c2fa2b088716bd8f780eb647c9dd90b2190721d2.json"
    },
    {
      "id": "tang-755",
      "category": "唐诗",
      "title": "寄宋使君",
      "subtitle": "",
      "author": "贯休",
      "dynasty": "唐",
      "content": "寺倚乌龙腹，窗中见碧棱。\n空廊人画祖，古殿鹤窥灯。\n风吼深松雪，炉寒一鼎冰。\n唯应谢内史，知此道心澄。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "8fb2d048b5d1320b2bdead0e79de49f638cbe9c0dd162dba88b6155bb26f59c2",
      "estimatedOutput": 702,
      "resultPath": "expansion/working/v2/results/tang-755--8fb2d048b5d1320b2bdead0e79de49f638cbe9c0dd162dba88b6155bb26f59c2.json"
    },
    {
      "id": "tang-756",
      "category": "唐诗",
      "title": "胡歌",
      "subtitle": "",
      "author": "岑参",
      "dynasty": "唐",
      "content": "黑姓蕃王貂鼠裘，葡萄宫锦醉缠头。\n关西老将能苦战，七十行兵仍未休。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "5282aa9a27b1f8228ea7bedecc9af7bfca35b3aafad24f7b9d38871538b84252",
      "estimatedOutput": 666,
      "resultPath": "expansion/working/v2/results/tang-756--5282aa9a27b1f8228ea7bedecc9af7bfca35b3aafad24f7b9d38871538b84252.json"
    },
    {
      "id": "tang-757",
      "category": "唐诗",
      "title": "奉饯高尊师如贵道士传道录毕归北海 【录竹",
      "subtitle": "",
      "author": "李白",
      "dynasty": "唐",
      "content": "道隐不可见，灵书藏洞天。\n吾师四万劫，历世递相传。\n别杖留青竹，行歌蹑紫烟。\n离心无远近，长在玉京悬。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "7ffdc381f4ace5d083550c996c4940ecbfae27fe748a8fb18938afceeba046e5",
      "estimatedOutput": 702,
      "resultPath": "expansion/working/v2/results/tang-757--7ffdc381f4ace5d083550c996c4940ecbfae27fe748a8fb18938afceeba046e5.json"
    },
    {
      "id": "tang-758",
      "category": "唐诗",
      "title": "碧城三首（其一）",
      "subtitle": "",
      "author": "李商隐",
      "dynasty": "唐",
      "content": "碧城十二曲阑干，犀辟尘埃玉辟寒。\n阆苑有书多附鹤，女床无树不栖鸾。\n星沉海底当窗见，雨过河源隔座看。\n若是晓珠明又定。\n一生长树水精盘。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "1a29f2211769af0b6c8d4736e4145aaf52a16a09f29baa2c2bb6e2287087a7b0",
      "estimatedOutput": 736,
      "resultPath": "expansion/working/v2/results/tang-758--1a29f2211769af0b6c8d4736e4145aaf52a16a09f29baa2c2bb6e2287087a7b0.json"
    },
    {
      "id": "tang-759",
      "category": "唐诗",
      "title": "归墅",
      "subtitle": "",
      "author": "李商隐",
      "dynasty": "唐",
      "content": "行李逾南极，旬时到旧乡。\n楚芝应遍紫，邓橘未全黄。\n渠浊村舂急，旗高社酒香。\n故山归梦喜，先入读书堂。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "0a2b916aaf578e1dcaad6dd61f41cec66a0f74240eae565a6a602a11a078ef5b",
      "estimatedOutput": 702,
      "resultPath": "expansion/working/v2/results/tang-759--0a2b916aaf578e1dcaad6dd61f41cec66a0f74240eae565a6a602a11a078ef5b.json"
    },
    {
      "id": "tang-760",
      "category": "唐诗",
      "title": "秦州杂诗二十首 其三",
      "subtitle": "",
      "author": "杜甫",
      "dynasty": "唐",
      "content": "州图领同谷，驿道出流沙。\n降虏兼千帐，居人有万家。\n马骄珠汗落，胡舞白蹄斜。\n年少临洮子，西来亦自誇。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "545ee2b166dfbe51adfef2f7b5d7f5901eb4b391304e971dfa70d926f48e0370",
