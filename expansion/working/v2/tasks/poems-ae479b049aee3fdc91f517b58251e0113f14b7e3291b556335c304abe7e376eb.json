    },
    {
      "id": "song-773",
      "category": "宋词",
      "title": "玉楼春",
      "subtitle": "夜来枕上争闲事",
      "author": "欧阳修",
      "dynasty": "宋",
      "content": "夜来枕上争闲事。\n推倒屏山褰绣被。\n尽人求守不应人，走向碧纱窗下睡。\n直到起来由自殢。\n向道夜来真个醉。\n大家恶发大家休，毕竟到头谁不是。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "99d9e23c65e392c04357d71f60ce1a500b344075c6d6f2ef8b7acaac79541237",
      "estimatedOutput": 738,
