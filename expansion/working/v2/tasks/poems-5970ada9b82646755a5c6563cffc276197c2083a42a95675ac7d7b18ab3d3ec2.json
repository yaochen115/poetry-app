    },
    {
      "id": "song-544",
      "category": "宋词",
      "title": "浣溪沙",
      "subtitle": "青杏园林著酒香",
      "author": "晏殊",
      "dynasty": "宋",
      "content": "青杏园林著酒香。\n佳人初试薄罗裳。\n柳丝无力燕飞忙。\n乍雨乍晴花自落，闲愁闲闷日偏长。\n为谁消瘦减容光。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "7bff417a4b2160e726ab002269ef36ff23178462e389a4df1abf587f4dea610d",
      "estimatedOutput": 704,
      "resultPath": "expansion/working/v2/results/song-544--7bff417a4b2160e726ab002269ef36ff23178462e389a4df1abf587f4dea610d.json"
    },
    {
      "id": "song-545",
      "category": "宋词",
      "title": "浣溪沙",
      "subtitle": "红蓼花香夹岸稠",
      "author": "晏殊",
      "dynasty": "宋",
      "content": "红蓼花香夹岸稠。\n绿波春水向东流。\n小船轻舫好追游。\n渔父酒醒重拨棹，鸳鸯飞去却回头。\n一杯销尽两眉愁。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "f54f7557a3db51395647a5e02eb7798b897fb6f4865e3f339d4ce7c3c183db8b",
      "estimatedOutput": 704,
      "resultPath": "expansion/working/v2/results/song-545--f54f7557a3db51395647a5e02eb7798b897fb6f4865e3f339d4ce7c3c183db8b.json"
    },
    {
      "id": "song-546",
      "category": "宋词",
      "title": "浣溪沙",
      "subtitle": "淡淡梳妆薄薄衣",
      "author": "晏殊",
      "dynasty": "宋",
      "content": "淡淡梳妆薄薄衣。\n天仙模样好容仪。\n旧欢前事入颦眉。\n闲役梦魂孤烛暗，恨无消息画帘垂。\n且留双泪说相思。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "5bbf470d17ab9b605f402a618c79db54e311b81b140a83ca6b1c74876be3c9c0",
      "estimatedOutput": 704,
      "resultPath": "expansion/working/v2/results/song-546--5bbf470d17ab9b605f402a618c79db54e311b81b140a83ca6b1c74876be3c9c0.json"
    },
    {
      "id": "song-547",
      "category": "宋词",
      "title": "浣溪沙",
      "subtitle": "小阁重帘有燕过",
      "author": "晏殊",
      "dynasty": "宋",
      "content": "小阁重帘有燕过。\n晚花红片落庭莎。\n曲阑干影入凉波。\n一霎好风生翠幕，几回疏雨滴圆荷。\n酒醒人散得愁多。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "5204580262489309034ae1533b5107b5969b7ac6d774a5aef54dc9427e02979d",
      "estimatedOutput": 704,
      "resultPath": "expansion/working/v2/results/song-547--5204580262489309034ae1533b5107b5969b7ac6d774a5aef54dc9427e02979d.json"
    },
    {
      "id": "song-548",
      "category": "宋词",
      "title": "浣溪沙",
      "subtitle": "宿酒才醒厌玉卮",
      "author": "晏殊",
      "dynasty": "宋",
      "content": "宿酒才醒厌玉卮。\n水沈香冷懒熏衣。\n早梅先绽日边枝。\n寒雪寂寥初散后，春风悠扬欲来时。\n小屏闲放画帘垂。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "e97b6f974425c3b398e363029518dfaca82e11ea01cf023f12751ce8c2036275",
      "estimatedOutput": 704,
      "resultPath": "expansion/working/v2/results/song-548--e97b6f974425c3b398e363029518dfaca82e11ea01cf023f12751ce8c2036275.json"
    },
    {
      "id": "song-549",
      "category": "宋词",
      "title": "浣溪沙",
      "subtitle": "绿叶红花媚晓烟",
      "author": "晏殊",
      "dynasty": "宋",
      "content": "绿叶红花媚晓烟。\n黄蜂金蕊欲披莲。\n水风深处懒回船。\n可惜异香珠箔外，不辞清唱玉尊前。\n使星归觐九重天。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "7c284f7d2f0e5f7c7cc9ca6260585396fd935d9a6c4c544abed00438d90a7d4f",
      "estimatedOutput": 704,
      "resultPath": "expansion/working/v2/results/song-549--7c284f7d2f0e5f7c7cc9ca6260585396fd935d9a6c4c544abed00438d90a7d4f.json"
    },
    {
      "id": "song-550",
      "category": "宋词",
      "title": "浣溪沙",
      "subtitle": "杨柳阴中驻彩旌",
      "author": "晏殊",
      "dynasty": "宋",
      "content": "杨柳阴中驻彩旌。\n芰荷香里劝金觥。\n小词流入管弦声。\n只有醉饮宽别恨，不须朝暮促归程。\n雨条烟叶系人情。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "e5b4e25573afd2ca0329ae34047df68f1419f823288c2524e72095e1635c46ee",
      "estimatedOutput": 704,
      "resultPath": "expansion/working/v2/results/song-550--e5b4e25573afd2ca0329ae34047df68f1419f823288c2524e72095e1635c46ee.json"
    },
    {
      "id": "song-551",
      "category": "宋词",
      "title": "更漏子",
      "subtitle": "蕣华浓山翠浅一",
      "author": "晏殊",
      "dynasty": "宋",
      "content": "蕣华浓，山翠浅。\n一寸秋波如剪。\n红日永，绮筵开。\n暗随仙驭来。\n遏云声，回雪袖。\n占断晓莺春柳。\n才送目，又颦眉。\n此情谁得知。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "dc172dee0c6d5d2eb0f53db50271d5786c73687fd41e012d9322f121dba33fd1",
      "estimatedOutput": 730,
      "resultPath": "expansion/working/v2/results/song-551--dc172dee0c6d5d2eb0f53db50271d5786c73687fd41e012d9322f121dba33fd1.json"
    },
    {
      "id": "song-552",
      "category": "宋词",
      "title": "更漏子",
      "subtitle": "塞鸿高仙露满秋",
      "author": "晏殊",
      "dynasty": "宋",
      "content": "塞鸿高，仙露满。\n秋入银河清浅。\n逢好客，且开眉。\n盛年能几时。\n宝筝调，罗袖软。\n拍碎画堂檀板。\n须尽醉，莫推辞。\n人生多别离。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "28f9b991b8f1a2b49f85c8ad8a704f8311bde0da37e6abf2be1f45f7ce40ea3c",
      "estimatedOutput": 730,
      "resultPath": "expansion/working/v2/results/song-552--28f9b991b8f1a2b49f85c8ad8a704f8311bde0da37e6abf2be1f45f7ce40ea3c.json"
    },
    {
      "id": "song-553",
      "category": "宋词",
      "title": "更漏子",
      "subtitle": "雪藏梅烟著柳依",
      "author": "晏殊",
      "dynasty": "宋",
      "content": "雪藏梅，烟著柳。\n依约上春时候。\n初送雁，欲问莺。\n绿池波浪生。\n探花开，留客醉。\n忆得去年情味。\n金盏酒，玉炉香。\n任他红日长。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "7f80d26ef0fb0a6fc05b9b195483302e32aec41d2278c0f0556459487fd67183",
