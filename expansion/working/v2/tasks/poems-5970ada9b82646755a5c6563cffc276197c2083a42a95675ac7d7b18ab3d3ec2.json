    {
      "id": "song-542",
      "category": "宋词",
      "title": "浣溪沙",
      "subtitle": "阆苑瑶台风露秋",
      "author": "晏殊",
      "dynasty": "宋",
      "content": "阆苑瑶台风露秋。\n整鬟凝思捧觥筹。\n欲归临别强迟留。\n月好谩成孤枕梦，酒阑空得两眉愁。\n此时情绪悔风流。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "5f8463a0b33926659c1cf44cef07533578b6c36d9c6025c7e26dd975be06433a",
