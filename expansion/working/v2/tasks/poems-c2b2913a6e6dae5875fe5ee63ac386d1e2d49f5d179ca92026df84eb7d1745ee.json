    },
    {
      "id": "song-940",
      "category": "宋词",
      "title": "南乡子",
      "subtitle": "渌水带青潮水上",
      "author": "晏几道",
      "dynasty": "宋",
      "content": "渌水带青潮。\n水上朱阑小渡桥。\n桥上女儿双笑靥，妖娆。\n倚著阑干弄柳条。\n月夜落花朝。\n减字偷声按玉箫。\n柳外行人回首处，迢迢。\n若比银河路更遥。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "4e1740939869f61bcc8788c29c9f5fb2470073375ab26f57f789fc03170cfca1",
      "estimatedOutput": 746,
      "resultPath": "expansion/working/v2/results/song-940--4e1740939869f61bcc8788c29c9f5fb2470073375ab26f57f789fc03170cfca1.json"
    },
    {
      "id": "song-941",
      "category": "宋词",
      "title": "南乡子",
      "subtitle": "小蕊受春风日日",
      "author": "晏几道",
      "dynasty": "宋",
      "content": "小蕊受春风。\n日日宫花花树中。\n恰向柳绵撩乱处，相逢。\n笑靥旁边心字浓。\n归路草茸茸。\n家在秦楼更近东。\n醒去醉来无限事，谁同。\n说著西池满面红。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "b8c41717980dd4f72973f0ad669ecfbc88a5338b43d3f06cc7864eae00b30d01",
      "estimatedOutput": 746,
      "resultPath": "expansion/working/v2/results/song-941--b8c41717980dd4f72973f0ad669ecfbc88a5338b43d3f06cc7864eae00b30d01.json"
    },
    {
      "id": "song-942",
      "category": "宋词",
      "title": "南乡子",
      "subtitle": "花落未须悲红蕊",
      "author": "晏几道",
      "dynasty": "宋",
      "content": "花落未须悲。\n红蕊明年又满枝。\n惟有花间人别后，无期。\n水阔山长雁字迟。\n今日最相思。\n记得攀条话别离。\n共说春来春去事，多时。\n一点愁心入翠眉。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "41beb88a2c8f28c738cc55dab7225b60c78b96f6befdf15c7de58c8bd6dd955f",
      "estimatedOutput": 746,
      "resultPath": "expansion/working/v2/results/song-942--41beb88a2c8f28c738cc55dab7225b60c78b96f6befdf15c7de58c8bd6dd955f.json"
    },
    {
      "id": "song-943",
      "category": "宋词",
      "title": "南乡子",
      "subtitle": "何处别时难玉指",
      "author": "晏几道",
      "dynasty": "宋",
      "content": "何处别时难。\n玉指偷将粉泪弹。\n记得来时楼上烛，初残。\n待得清霜满画阑。\n不惯独眠寒。\n自解罗衣衬枕檀。\n百媚也应愁不睡，更阑。\n恼乱心情半被闲。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "ed5a2e59a68178b25f5ab46de37640145df4e76bd8d540858b82876edcf4a863",
      "estimatedOutput": 746,
      "resultPath": "expansion/working/v2/results/song-943--ed5a2e59a68178b25f5ab46de37640145df4e76bd8d540858b82876edcf4a863.json"
    },
    {
      "id": "song-944",
      "category": "宋词",
      "title": "南乡子",
      "subtitle": "画鸭懒熏香绣茵",
      "author": "晏几道",
      "dynasty": "宋",
      "content": "画鸭懒熏香。\n绣茵犹展旧鸳鸯。\n不似同衾愁易晓，空床。\n细剔银灯怨漏长。\n几夜月波凉。\n梦魂随月到兰房。\n残睡觉来人又远，难忘。\n便是无情也断肠。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "932ec94b43a87b0456f904512094a3c72f64cad359bd55fe451bca688ed75b2e",
      "estimatedOutput": 746,
      "resultPath": "expansion/working/v2/results/song-944--932ec94b43a87b0456f904512094a3c72f64cad359bd55fe451bca688ed75b2e.json"
    },
    {
      "id": "song-945",
      "category": "宋词",
      "title": "南乡子",
      "subtitle": "眼约也应虚昨夜",
      "author": "晏几道",
      "dynasty": "宋",
      "content": "眼约也应虚。\n昨夜归来凤枕孤。\n且据如今情分里，相於。\n只恐多时不似初。\n深意托双鱼。\n小翦蛮笺细字书。\n更把此情重问得，何如。\n共结因缘久远无。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "18b97c93f8411d125b1e3acab1d304482ee3fd9b7aefc21324ff25d046680018",
      "estimatedOutput": 746,
      "resultPath": "expansion/working/v2/results/song-945--18b97c93f8411d125b1e3acab1d304482ee3fd9b7aefc21324ff25d046680018.json"
    },
    {
      "id": "song-946",
      "category": "宋词",
      "title": "南乡子",
      "subtitle": "新月又如眉长笛",
      "author": "晏几道",
      "dynasty": "宋",
      "content": "新月又如眉。\n长笛谁教月下吹。\n楼倚暮云初见雁，南飞。\n漫道行人雁后归。\n意欲梦佳期。\n梦里关山路不知。\n却待短书来破恨，应迟。\n还是凉生玉枕时。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "a47bdb9d48e228f1a3272bf3b9e5b710f729b97bba44b54421cc40a7abdfa3be",
      "estimatedOutput": 746,
      "resultPath": "expansion/working/v2/results/song-946--a47bdb9d48e228f1a3272bf3b9e5b710f729b97bba44b54421cc40a7abdfa3be.json"
    },
    {
      "id": "song-947",
      "category": "宋词",
      "title": "清平乐",
      "subtitle": "千花百草送得春",
      "author": "晏几道",
      "dynasty": "宋",
      "content": "千花百草。\n送得春归了。\n拾蕊人稀红渐少。\n叶底杏青梅小。\n小琼闲抱琵琶。\n雪香微透轻纱。\n正好一枝娇艳，当筵独占韶华。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "fca6afd8d6c43c35bbc1824a46109981ce71864a10072bef53e4cec247d6486a",
      "estimatedOutput": 720,
      "resultPath": "expansion/working/v2/results/song-947--fca6afd8d6c43c35bbc1824a46109981ce71864a10072bef53e4cec247d6486a.json"
    },
    {
      "id": "song-948",
      "category": "宋词",
      "title": "清平乐",
      "subtitle": "烟轻雨小紫陌香",
      "author": "晏几道",
      "dynasty": "宋",
      "content": "烟轻雨小。\n紫陌香尘少。\n谢客池塘生绿草。\n一夜红梅先老。\n旋题罗带新诗。\n重寻杨柳佳期。\n强半春寒去后，几番花信来时。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "83f4f03c2b48409b7ddd31c18a0f51f7442edfbb7c32416ce93a3d8d6eb97a07",
      "estimatedOutput": 720,
      "resultPath": "expansion/working/v2/results/song-948--83f4f03c2b48409b7ddd31c18a0f51f7442edfbb7c32416ce93a3d8d6eb97a07.json"
    },
    {
      "id": "song-949",
      "category": "宋词",
      "title": "清平乐",
      "subtitle": "可怜娇小掌上承",
      "author": "晏几道",
      "dynasty": "宋",
      "content": "可怜娇小。\n掌上承恩早。\n把镜不知人易老。\n欲占朱颜长好。\n画堂秋月佳期。\n藏钩赌酒归迟。\n红烛泪前低语，绿笺花里新词。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "cae79ba80f72a4ffe1e38ce966c5f90e315cc3cd9786630e17706611ee470dc2",
