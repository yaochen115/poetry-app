    {
      "id": "tang-425",
      "category": "唐诗",
      "title": "哥舒歌",
      "subtitle": "",
      "author": "西鄙人",
      "dynasty": "唐",
      "content": "北斗七星高，哥舒夜带刀。\n至今窥牧马，不敢过临洮。",
      "excerptOf": null,
      "excerptNote": "",
