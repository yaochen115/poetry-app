    {
      "id": "tang-426",
      "category": "唐诗",
      "title": "元日",
      "subtitle": "",
      "author": "司空图",
      "dynasty": "唐",
      "content": "甲子今重数，生涯只自怜。\n殷勤元日日，欹午又明年。",
      "excerptOf": null,
      "excerptNote": "",
