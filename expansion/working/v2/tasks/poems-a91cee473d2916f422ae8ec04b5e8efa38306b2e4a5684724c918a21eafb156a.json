    {
      "id": "tang-797",
      "category": "唐诗",
      "title": "白鹭鹚",
      "subtitle": "",
      "author": "李白",
      "dynasty": "唐",
      "content": "白鹭下秋水，孤飞如坠霜。\n心闲且未去，独立沙洲傍。",
      "excerptOf": null,
      "excerptNote": "",
