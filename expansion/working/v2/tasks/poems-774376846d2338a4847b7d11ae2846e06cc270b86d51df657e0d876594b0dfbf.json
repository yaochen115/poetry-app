      "resultPath": "expansion/working/v2/results/song-276--363ca2ecebe2b7d8da0d6c704955871f581bb6960cc629d6e30bf56503eabc0e.json"
    },
    {
      "id": "song-277",
      "category": "宋词",
      "title": "卜算子",
      "subtitle": "竹里一枝梅",
      "author": "向子諲",
      "dynasty": "宋",
      "content": "岁见梅追和一首，终恨有儿女子态耳\n竹里一枝梅，雨洗娟娟静。疑是佳人日暮来，绰约风前影。\n新恨有谁知，往事何堪省。梦绕阳台寂寞回，沾袖余香冷。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "ef606ae34ca48e2e9c9f2fe3f6a2903da0200aff15a2902a448dab5a4fb26cb2",
