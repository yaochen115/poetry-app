    },
    {
      "id": "song-162",
      "category": "宋词",
      "title": "玉楼春",
      "subtitle": "尊前拟把归期说",
      "author": "欧阳修",
      "dynasty": "宋",
      "content": "尊前拟把归期说，欲语春容先惨咽。人生自是有情痴，此恨不关风与月。\n离歌且莫翻新阕，一曲能教肠寸结。直须看尽洛城花，始共春风容易别。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "0422c3c7e10469413ce9e85e4c6be6053c512e8fae11baa3a2b9ef93a49f1b3c",
      "estimatedOutput": 730,
