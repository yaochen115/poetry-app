    },
    {
      "id": "song-166",
      "category": "宋词",
      "title": "玉楼春",
      "subtitle": "春景",
      "author": "宋祁",
      "dynasty": "宋",
      "content": "东城渐觉风光好。縠皱波纹迎客棹。绿杨烟外晓寒轻，红杏枝头春意闹。\n浮生长恨欢娱少。肯爱千金轻一笑。为君持酒劝斜阳，且向花间留晚照。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "9f10732cdfbce6996b11aa5367d65358259146905f8b7e951c16bf831ba7138f",
      "estimatedOutput": 730,
      "resultPath": "expansion/working/v2/results/song-166--9f10732cdfbce6996b11aa5367d65358259146905f8b7e951c16bf831ba7138f.json"
    },
    {
      "id": "song-167",
      "category": "宋词",
      "title": "蝶恋花",
      "subtitle": "春暮",
      "author": "李煜",
      "dynasty": "五代·南唐",
      "content": "遥夜亭皋闲信步。才过清明，渐觉伤春暮。数点雨声风约住。朦胧淡月云来去。\n桃杏依稀香暗渡。谁在秋千，笑里轻轻语。一寸相思千万绪。人间没个安排处。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "586a3ed483a5c93f9fa1b634858c95d2e99a059c1a04fa0c6f5fea7c722f79bd",
      "estimatedOutput": 742,
      "resultPath": "expansion/working/v2/results/song-167--586a3ed483a5c93f9fa1b634858c95d2e99a059c1a04fa0c6f5fea7c722f79bd.json"
    },
    {
      "id": "song-168",
      "category": "宋词",
      "title": "一剪梅",
      "subtitle": "中秋元月",
      "author": "辛弃疾",
      "dynasty": "宋",
      "content": "忆对中秋丹桂丛，花也杯中，月也杯中。今宵楼上一尊同，云湿纱窗，雨湿纱窗。\n浑欲乘风问化工，路也难通，信也难通。满堂唯有烛花红，歌且从容，杯且从容。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "a26d6ea36c67f436e47a8c92bc2d4825b388aed4b8f9002a9f10240e44dbf5fe",
      "estimatedOutput": 746,
