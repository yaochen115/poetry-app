      "estimatedOutput": 750,
      "resultPath": "expansion/working/v2/results/guwen-335--df80d1e99f1a22c6242ceb9a386a1ab86286cb0a1691a8c76df5aa5b8eabee8e.json"
    },
    {
      "id": "guwen-336",
      "category": "古文",
      "title": "围炉夜话·第一一一则",
      "subtitle": "",
      "author": "王永彬",
      "dynasty": "清",
      "content": "人知佛老为异端，不知凡背乎经常者，皆异端也；人知扬墨为邪说，不知凡涉于虚诞者，皆邪说也。",
      "excerptOf": "围炉夜话",
      "excerptNote": "完整选录《围炉夜话》中“第一一一则”一则或一章；非全书。",
      "inputHash": "525d936ee82d946128804d314435fa0abefbed3bbca42e8f2c5b72fac4d18b59",
      "estimatedOutput": 732,
      "resultPath": "expansion/working/v2/results/guwen-336--525d936ee82d946128804d314435fa0abefbed3bbca42e8f2c5b72fac4d18b59.json"
    },
    {
      "id": "guwen-337",
      "category": "古文",
      "title": "围炉夜话·第一一二则",
      "subtitle": "",
      "author": "王永彬",
      "dynasty": "清",
      "content": "图功未晚，亡羊尚可补牢；浮慕无成，羡鱼何如结网。",
      "excerptOf": "围炉夜话",
      "excerptNote": "完整选录《围炉夜话》中“第一一二则”一则或一章；非全书。",
