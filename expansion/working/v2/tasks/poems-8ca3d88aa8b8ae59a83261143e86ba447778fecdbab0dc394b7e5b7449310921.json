    },
    {
      "id": "tang-655",
      "category": "唐诗",
      "title": "八月十五夜月二首",
      "subtitle": "",
      "author": "杜甫",
      "dynasty": "唐",
      "content": "满月飞明镜，归心折大刀。\n转蓬行地远，攀桂仰天高。\n水路疑霜雪，林栖见羽毛。\n此时瞻白兔，直欲数秋毫。\n稍下巫山峡，犹衔白帝城。\n气沈全浦暗，轮仄半楼明。\n刁斗皆催晓，蟾蜍且自倾。\n张弓倚残魄，不独汉家营。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "12dca6a215b583534ad0cd20a1cedcb2962cbbe2143c123c2fa416a01fa7048f",
      "estimatedOutput": 806,
      "resultPath": "expansion/working/v2/results/tang-655--12dca6a215b583534ad0cd20a1cedcb2962cbbe2143c123c2fa416a01fa7048f.json"
    },
    {
      "id": "tang-656",
      "category": "唐诗",
      "title": "春思",
      "subtitle": "",
      "author": "皇甫冉",
      "dynasty": "唐",
      "content": "莺啼燕语报新年，马邑龙堆路几千。\n家住层城临汉苑，心随明月到胡天。\n机中锦字论长恨，楼上花枝笑独眠。\n为问元戎窦车骑，何时返旆勒燕然。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "ce915bcdcdee5604c4e920c8c74eecd147d29b01c78f5d31f8fb850fe509cd18",
      "estimatedOutput": 734,
      "resultPath": "expansion/working/v2/results/tang-656--ce915bcdcdee5604c4e920c8c74eecd147d29b01c78f5d31f8fb850fe509cd18.json"
    },
    {
      "id": "tang-657",
      "category": "唐诗",
      "title": "春江晚景",
      "subtitle": "",
      "author": "张九龄",
      "dynasty": "唐",
      "content": "江林多秀发，云日复相鲜。\n征路那逢此，春心益渺然。\n兴来只自得，佳处莫能传。\n薄暮津亭下，余花满客船。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "a12d3da68e27b6f04f2d8daf264a26183776012f7f408ccd234c505e2e36eacd",
      "estimatedOutput": 702,
      "resultPath": "expansion/working/v2/results/tang-657--a12d3da68e27b6f04f2d8daf264a26183776012f7f408ccd234c505e2e36eacd.json"
    },
    {
      "id": "tang-658",
      "category": "唐诗",
      "title": "长干行",
      "subtitle": "君家何处住",
      "author": "崔颢",
      "dynasty": "唐",
      "content": "君家何处住，妾住在横塘。\n停船暂借问，或恐是同乡。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "f357e400f1b631cb80b6abbeb639cb4818706eb95ca871ea00c8be21cd8d7b56",
      "estimatedOutput": 650,
      "resultPath": "expansion/working/v2/results/tang-658--f357e400f1b631cb80b6abbeb639cb4818706eb95ca871ea00c8be21cd8d7b56.json"
    },
    {
      "id": "tang-659",
      "category": "唐诗",
      "title": "咸阳值雨",
      "subtitle": "",
      "author": "温庭筠",
      "dynasty": "唐",
      "content": "咸阳桥上雨如悬，万点空濛隔钓船。\n还似洞庭春水色，晓云将入岳阳天。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "542ab8bf9c40e17e2b725b624e50fb192fec93d8b58f617cb356410ea5f62734",
      "estimatedOutput": 666,
      "resultPath": "expansion/working/v2/results/tang-659--542ab8bf9c40e17e2b725b624e50fb192fec93d8b58f617cb356410ea5f62734.json"
    },
    {
      "id": "tang-660",
      "category": "唐诗",
      "title": "江楼夕望招客",
      "subtitle": "",
      "author": "白居易",
      "dynasty": "唐",
      "content": "海天东望夕茫茫，山势川形阔复长。\n灯火万家城四畔，星河一道水中央。\n风吹古木晴天雨，月照平沙夏夜霜。\n能就江楼消暑否？\n比君茅舍较清凉。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "7faede2128316235462ed3aaf7fe35deb8c94f771875df18833d178bfe47ffab",
      "estimatedOutput": 736,
      "resultPath": "expansion/working/v2/results/tang-660--7faede2128316235462ed3aaf7fe35deb8c94f771875df18833d178bfe47ffab.json"
    },
    {
      "id": "tang-661",
      "category": "唐诗",
      "title": "云阳馆与韩绅宿别",
      "subtitle": "",
      "author": "司空曙",
      "dynasty": "唐",
      "content": "故人江海别，几度隔山川。\n乍见翻疑梦，相悲各问年。\n孤灯寒照雨，深竹暗浮烟。\n更有明朝恨，离杯惜共传。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "ef26725c6ef3c1faf4d11033498d671454d66fb1d90f5216deeb7db40e363ebd",
      "estimatedOutput": 702,
      "resultPath": "expansion/working/v2/results/tang-661--ef26725c6ef3c1faf4d11033498d671454d66fb1d90f5216deeb7db40e363ebd.json"
    },
    {
      "id": "tang-662",
      "category": "唐诗",
      "title": "重送裴郎中贬吉州",
      "subtitle": "",
      "author": "刘长卿",
      "dynasty": "唐",
      "content": "猿啼客散暮江头，人自伤心水自流。\n同作逐臣君更远，青山万里一孤舟。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "2781da53a5b8f5e3152ebef964c285d15bb61613dbe5e6a6bf9901be017d5e63",
      "estimatedOutput": 666,
      "resultPath": "expansion/working/v2/results/tang-662--2781da53a5b8f5e3152ebef964c285d15bb61613dbe5e6a6bf9901be017d5e63.json"
    },
    {
      "id": "tang-663",
      "category": "唐诗",
      "title": "春夜别友人二首",
      "subtitle": "其一",
      "author": "陈子昂",
      "dynasty": "唐",
      "content": "银烛吐青烟，金樽对绮筵。\n离堂思琴瑟，别路绕山川。\n明月隐高树，长河没晓天。\n悠悠洛阳道，此会在何年。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "c8b9618a2be7faea22deab892fe3f4cdeec732c596f545025dabf550b98c239e",
      "estimatedOutput": 702,
      "resultPath": "expansion/working/v2/results/tang-663--c8b9618a2be7faea22deab892fe3f4cdeec732c596f545025dabf550b98c239e.json"
    },
    {
      "id": "tang-664",
      "category": "唐诗",
      "title": "塞下曲",
      "subtitle": "其一",
      "author": "李益",
      "dynasty": "唐",
      "content": "蕃州部落能结束，朝暮驰猎黄河曲。\n燕歌未断塞鸿飞，牧马群嘶边草绿。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "c60190980b78ae70d552dd25a3f9ab67ff54710fd066a1b1f25682647519342f",
