    {
      "id": "tang-653",
      "category": "唐诗",
      "title": "夕阳楼",
      "subtitle": "",
      "author": "李商隐",
      "dynasty": "唐",
      "content": "花明柳暗绕天愁，上尽重城更上楼。\n欲问孤鸿向何处，不知身世自悠悠。",
      "excerptOf": null,
      "excerptNote": "",
