    },
    {
      "id": "tang-654",
      "category": "唐诗",
      "title": "晚春二首",
      "subtitle": "其二",
      "author": "韩愈",
      "dynasty": "唐",
      "content": "谁收春色将归去，慢绿妖红半不存。\n榆荚只能随柳絮，等闲撩乱走空园。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "e8149c79c1a13ef435105773330a50aea3249c3914f1fe3e5bbeb4961da909ad",
