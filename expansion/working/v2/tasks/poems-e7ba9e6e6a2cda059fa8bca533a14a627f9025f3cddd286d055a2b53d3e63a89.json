      "id": "song-362",
      "category": "宋词",
      "title": "蝶恋花",
      "subtitle": "",
      "author": "仲殊",
      "dynasty": "宋",
      "content": "北固山前波浪远。铁瓮城头，画角残声短。促酒溅金催小宴。灯摇蜡焰香风软。落日烟霞晴满眼。欲仗丹青，巧笔彤牙管。解写伊川山色浅。谁能画得江天晚。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "deb046692693b177d476446395b752b01946a0bf7aa8883451db00624511ef86",
      "estimatedOutput": 740,
      "resultPath": "expansion/working/v2/results/song-362--deb046692693b177d476446395b752b01946a0bf7aa8883451db00624511ef86.json"
    },
    {
      "id": "song-363",
      "category": "宋词",
      "title": "蝶恋花",
      "subtitle": "",
      "author": "仇远",
      "dynasty": "宋",
      "content": "燕燕楼空帘意静。露叶如啼，红沁胭脂井。浅约深盟期未定。木犀风里鸳鸯径。\n楚岫秦眉相入映。私倚云阑，淡月笼花顶。今夕兰釭空吊影。绣衾罗荐余香冷。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "7921b3f56f56ba7e1dbc269aea98184745020890afac650525a1c46a83835aa1",
      "estimatedOutput": 742,
      "resultPath": "expansion/working/v2/results/song-363--7921b3f56f56ba7e1dbc269aea98184745020890afac650525a1c46a83835aa1.json"
    },
    {
      "id": "song-364",
      "category": "宋词",
      "title": "南歌子",
      "subtitle": "",
      "author": "石孝友",
      "dynasty": "宋",
      "content": "畴昔飞鸾侣，而今断雁行。西风岭外下斜阳。无赖一钩新月、挂人肠。\n双泪沾襟袖，孤灯封客床。枕余衾剩只残香。别得娇痴不睡、也思量。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "476a7447e7004f5d19a955bc5358719c6bda44168066755f961da9d13db213e7",
      "estimatedOutput": 726,
      "resultPath": "expansion/working/v2/results/song-364--476a7447e7004f5d19a955bc5358719c6bda44168066755f961da9d13db213e7.json"
    },
    {
      "id": "song-365",
      "category": "宋词",
      "title": "虞美人",
      "subtitle": "小山戢戢盆池浅",
      "author": "陈克",
      "dynasty": "宋",
      "content": "小山戢戢盆池浅。芳树阴阴转。红阑干上刺蔷薇。蝴蝶飞来飞去、两三枝。绣裙斜立腰肢困。翠黛萦新恨。风流踪迹使人猜。过了斗鸡时节、合归来。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "61407ab58cfef0fc38885f456a9656e555e7668d0e24c1537c5060203c799134",
      "estimatedOutput": 732,
      "resultPath": "expansion/working/v2/results/song-365--61407ab58cfef0fc38885f456a9656e555e7668d0e24c1537c5060203c799134.json"
    },
    {
      "id": "song-366",
      "category": "宋词",
      "title": "少年游",
      "subtitle": "端午赠黄守徐君猷",
      "author": "苏轼",
      "dynasty": "宋",
      "content": "银塘朱槛麹尘波，圆绿卷新荷。兰条荐浴，菖花酿酒，天气尚清和。\n好将沉醉酬佳节，十分酒、一分歌。狱草烟深，讼庭人悄，无吝宴游过。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "edbb166e06b121158dccffbe1667e4ff81a490ce136ef8f4fb5c662c39cb11d4",
      "estimatedOutput": 726,
      "resultPath": "expansion/working/v2/results/song-366--edbb166e06b121158dccffbe1667e4ff81a490ce136ef8f4fb5c662c39cb11d4.json"
    },
    {
      "id": "song-367",
      "category": "宋词",
      "title": "水调歌头",
      "subtitle": "",
      "author": "郑元秀",
      "dynasty": "宋",
      "content": "园林夸富贵，红绿簇枝头。阳和毓秀，气劘屈贾压曹刘。翰墨场中独步，洒落胸中万卷，横截百川流。邈视青云侣，俯首看瀛洲。\n到如今，萦扃务，尚淹留。庙堂应得好语，早晚觐宸旒。从此立登要路，便可羽仪台阁，指日凤池游。岁岁蟠桃会，椿算八千秋。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "872b86344711f676bc84d1b1c37af7955137c260474d988298d9135f3675e648",
      "estimatedOutput": 830,
      "resultPath": "expansion/working/v2/results/song-367--872b86344711f676bc84d1b1c37af7955137c260474d988298d9135f3675e648.json"
    },
    {
      "id": "song-368",
      "category": "宋词",
      "title": "鹊桥仙",
      "subtitle": "才临复日",
      "author": "佚名",
      "dynasty": "宋",
      "content": "才临复日，便逢生旦，料想门阑多喜。好将何物寿冰翁，但有个、新词为礼。如今已办，一千馀阕，尽按宫商角徵。一年一阕祝椿龄，自今日、从头数起。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "e360235c05fd804e56b44957e983af755223bc66a0390c4fe7664341aec4cf70",
      "estimatedOutput": 736,
      "resultPath": "expansion/working/v2/results/song-368--e360235c05fd804e56b44957e983af755223bc66a0390c4fe7664341aec4cf70.json"
    },
    {
      "id": "song-369",
      "category": "宋词",
      "title": "清平乐",
      "subtitle": "",
      "author": "朱雍",
      "dynasty": "宋",
      "content": "雪开瑶径。素蕊迎春影。楼上玉声三弄定。无奈幽香翻阵。\n凌晨不事铅华。化工却付春花。流水残阳江上，清随月色低斜。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "a582624b1d25930da1ebcb64b1c4f8c091edecfa826a5cfc2d3ce1da5c0fda64",
      "estimatedOutput": 710,
      "resultPath": "expansion/working/v2/results/song-369--a582624b1d25930da1ebcb64b1c4f8c091edecfa826a5cfc2d3ce1da5c0fda64.json"
    },
    {
      "id": "song-370",
      "category": "宋词",
      "title": "少年游",
      "subtitle": "庐山瑶草四时春",
      "author": "晁补之",
      "dynasty": "宋",
      "content": "庐山瑶草四时春。烟锁上宫门。记得南游，偶寻飞涧，一洗庾公尘。\n香炉高咏君家事，文彩近前人。它日骑鲸，尚怜迷路，与问众仙真。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "7802ff41a178fb5eeb893a4ed6077af91a29c5f14dcc97035b47cb4e1c702531",
