      "resultPath": "expansion/working/v2/results/song-370--7802ff41a178fb5eeb893a4ed6077af91a29c5f14dcc97035b47cb4e1c702531.json"
    },
    {
      "id": "song-371",
      "category": "宋词",
      "title": "定风波",
      "subtitle": "次高左藏使君韵",
      "author": "黄庭坚",
      "dynasty": "宋",
      "content": "万里黔中一漏天，屋居终日似乘船。及至重阳天也霁，催醉，鬼门关外蜀江前。\n莫笑老翁犹气岸，君看，几人黄菊上华颠？戏马台南追两谢，驰射，风流犹拍古人肩。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "44baa4a095968f8d3cba25d99555ebcb6552f7f2dba12731a305cb0b9daa8792",
      "estimatedOutput": 748,
      "resultPath": "expansion/working/v2/results/song-371--44baa4a095968f8d3cba25d99555ebcb6552f7f2dba12731a305cb0b9daa8792.json"
    },
    {
      "id": "song-372",
      "category": "宋词",
      "title": "水调歌头",
      "subtitle": "双阙步云尾",
      "author": "邵元实",
      "dynasty": "宋",
      "content": "双阙步云尾，六阁上鳌头。侍臣冠底，英英人物是君侯。闻道东皇深意，回想西清往事，早晚启金瓯。丹扆伫宏略，黄阁待名流。九秋天，千岁日，一樽酬。策勋黄石，相期茅土更封侯。稳扈钩陈天仗，净扫搀抢氛祲，按辔入神州。收了卢龙塞，却访赤松游。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "452d6a218f5f1d9f2a24b15e5d776526253ac617be517643f7a67cc967c63249",
      "estimatedOutput": 828,
      "resultPath": "expansion/working/v2/results/song-372--452d6a218f5f1d9f2a24b15e5d776526253ac617be517643f7a67cc967c63249.json"
    },
    {
      "id": "song-373",
      "category": "宋词",
      "title": "清平乐",
      "subtitle": "",
      "author": "石孝友",
      "dynasty": "宋",
      "content": "山明水嫩。潇洒桐庐郡。极目风烟无限景。说也如何得尽。\n自怜俗状尘容。几年断梗飘蓬。借使严陵知道，只应笑问东风。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "8d03b657d93f1a14298cafcb72823ea3f22dd0131e461ba3d495bd26bc7eb330",
