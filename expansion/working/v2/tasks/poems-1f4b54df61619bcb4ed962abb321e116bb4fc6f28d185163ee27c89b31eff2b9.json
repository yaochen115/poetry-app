    },
    {
      "id": "song-262",
      "category": "宋词",
      "title": "虞美人",
      "subtitle": "宜州见梅作",
      "author": "黄庭坚",
      "dynasty": "宋",
      "content": "天涯也有江南信。梅破知春近。夜阑风细得香迟。不道晓来开遍、向南枝。\n玉台弄粉花应妒。飘到眉心住。平生个里愿杯深。去国十年老尽、少年心。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "28dbd7304ca091d6fa7d183bc48b7ae661d284eb1956f37532d2c7b21bdbc33b",
      "estimatedOutput": 734,
      "resultPath": "expansion/working/v2/results/song-262--28dbd7304ca091d6fa7d183bc48b7ae661d284eb1956f37532d2c7b21bdbc33b.json"
    },
    {
      "id": "song-263",
      "category": "宋词",
      "title": "虞美人",
      "subtitle": "小梅枝上东君信",
      "author": "晏几道",
      "dynasty": "宋",
      "content": "小梅枝上东君信。雪后花期近。南枝开尽北枝开。长被陇头游子、寄春来。\n年年衣袖年年泪。总为今朝意。问谁同是忆花人。赚得小鸿眉黛、也低颦。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "ceb6e0ff414a58a787110bcbb42105d215776e0f44f6562cbb103fe6eb3a131c",
      "estimatedOutput": 734,
      "resultPath": "expansion/working/v2/results/song-263--ceb6e0ff414a58a787110bcbb42105d215776e0f44f6562cbb103fe6eb3a131c.json"
    },
    {
      "id": "song-264",
      "category": "宋词",
      "title": "鹊桥仙",
      "subtitle": "七夕",
      "author": "苏轼",
      "dynasty": "宋",
      "content": "缑山仙子，高清云渺，不学痴牛騃女。凤箫声断月明中，举手谢时人欲去。\n客槎曾犯，银河波浪，尚带天风海雨。相逢一醉是前缘，风雨散、飘然何处？",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "1610d1044068e07618785f72d5ba2207b34cf00b6ff82c6646342bf8b0767b28",
      "estimatedOutput": 736,
      "resultPath": "expansion/working/v2/results/song-264--1610d1044068e07618785f72d5ba2207b34cf00b6ff82c6646342bf8b0767b28.json"
    },
    {
      "id": "song-265",
      "category": "宋词",
      "title": "暗香",
      "subtitle": "旧时月色",
      "author": "姜夔",
      "dynasty": "宋",
      "content": "辛亥之冬，余载雪诣石湖。止既月，授简索句，且征新声，作此两曲，石湖把玩不已，使二妓肆习之，音节谐婉，乃名之曰《暗香》、《疏影》。\n旧时月色，算几番照我，梅边吹笛？唤起玉人，不管清寒与攀摘。何逊而今渐老，都忘却春风词笔。但怪得竹外疏花，香冷入瑶席。\n江国，正寂寂，叹寄与路遥，夜雪初积。翠尊易泣，红萼无言耿相忆。长记曾携手处，千树压、西湖寒碧。又片片、吹尽也，几时见得？",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "a8df1ffe495f4daf72e0dea541ee9deb76cad0eb05af0546028b885cd3fbd377",
      "estimatedOutput": 968,
      "resultPath": "expansion/working/v2/results/song-265--a8df1ffe495f4daf72e0dea541ee9deb76cad0eb05af0546028b885cd3fbd377.json"
    }
