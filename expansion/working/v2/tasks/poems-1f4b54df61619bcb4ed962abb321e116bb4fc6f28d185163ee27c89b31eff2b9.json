    {
      "id": "song-255",
      "category": "宋词",
      "title": "虞美人",
      "subtitle": "玉楼缥缈孤烟际",
      "author": "欧阳澈",
      "dynasty": "宋",
      "content": "玉楼缥缈孤烟际。徒倚愁如醉。雁来人远暗消魂。帘卷一钩新月、怯黄昏。\n那人音信全无个。幽恨谁凭破。扑花蝴蝶若知人。为我一场清梦、去相亲。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "8b364dcb1de798cc6835e1af436e544216b70f0c7c5cf56eccafc0964851c000",
