    },
    {
      "id": "song-435",
      "category": "宋词",
      "title": "眼儿媚",
      "subtitle": "",
      "author": "赵桓",
      "dynasty": "宋",
      "content": "宸传三百旧京华。仁孝自名家。一旦奸邪，倾天拆地，忍听琵琶。\n如今在外多萧索，迤逦近胡沙。家邦万里，伶仃父子，向晓霜花。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "5df76b0e32310793a4bf560a2c4abb115c53be9b913fbb14e53f2cf215b1d85c",
      "estimatedOutput": 718,
      "resultPath": "expansion/working/v2/results/song-435--5df76b0e32310793a4bf560a2c4abb115c53be9b913fbb14e53f2cf215b1d85c.json"
    },
    {
      "id": "song-436",
      "category": "宋词",
      "title": "点绛唇",
      "subtitle": "水陌轻寒社公雨",
      "author": "寇准",
      "dynasty": "宋",
      "content": "水陌轻寒，社公雨足东风慢。\n定巢新燕。\n湿雨穿花转。\n象尺熏炉，拂晓停针线。\n愁蛾浅。\n飞红零乱。\n侧卧珠帘卷。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "323819f9bdce70d6208b18bae74fee5a13d9965482a78e4d4595959ed728f76e",
      "estimatedOutput": 712,
      "resultPath": "expansion/working/v2/results/song-436--323819f9bdce70d6208b18bae74fee5a13d9965482a78e4d4595959ed728f76e.json"
    },
    {
      "id": "song-437",
      "category": "宋词",
      "title": "玉楼春",
      "subtitle": "锦箨参差朱槛曲",
      "author": "钱惟演",
      "dynasty": "宋",
      "content": "锦箨参差朱槛曲。\n露濯文犀和粉绿。\n未容浓翠伴桃红，已许纤枝留凤宿。\n嫩似春荑明似玉。\n一寸芳心谁管束。\n劝君速吃莫踟蹰，看被南风吹作竹。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "042c98bb0587d1256945f4c0fee8c17c9e3ca366ac87c5e7e3c5d06f74cbe369",
      "estimatedOutput": 738,
      "resultPath": "expansion/working/v2/results/song-437--042c98bb0587d1256945f4c0fee8c17c9e3ca366ac87c5e7e3c5d06f74cbe369.json"
    },
    {
      "id": "song-438",
      "category": "宋词",
      "title": "踏莎行",
      "subtitle": "二社良辰千家庭",
      "author": "陈尧佐",
      "dynasty": "宋",
      "content": "二社良辰，千家庭院。\n翩翩又见新来燕。\n凤凰巢稳许为邻，潇湘烟暝来何晚。\n乱入红楼，低飞绿岸。\n画梁时拂歌尘散。\n为谁归去为谁来，主人恩重珠帘卷。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "9659f49403aca68feb14124a49cbea0bb39e2c69931c6ba0c14893932eb5a7a1",
      "estimatedOutput": 746,
      "resultPath": "expansion/working/v2/results/song-438--9659f49403aca68feb14124a49cbea0bb39e2c69931c6ba0c14893932eb5a7a1.json"
    },
    {
      "id": "song-439",
      "category": "宋词",
      "title": "点绛唇",
      "subtitle": "金谷年年乱生春",
      "author": "林逋",
      "dynasty": "宋",
      "content": "金谷年年，乱生春色谁为主。\n馀花落处。\n满地和烟雨。\n又是离歌，一阕长亭暮。\n王孙去。\n萋萋无数。\n南北东西路。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "5bbf479ff0cb5c1235257bbaeecd05b1a83773aa13abd8c82c3569a6ed9a79bb",
      "estimatedOutput": 712,
      "resultPath": "expansion/working/v2/results/song-439--5bbf479ff0cb5c1235257bbaeecd05b1a83773aa13abd8c82c3569a6ed9a79bb.json"
    },
    {
      "id": "song-440",
      "category": "宋词",
      "title": "少年游",
      "subtitle": "江南节物水昏云",
      "author": "杨亿",
      "dynasty": "宋",
      "content": "江南节物，水昏云淡，飞雪满前村。\n千寻翠岭，一枝芳艳，迢递寄归人。\n寿阳妆罢，冰姿玉态，的的写天真。\n等闲风雨又纷纷。\n更忍向、笛中闻。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "ae0c0ff25188b0405e1eed74f1bc7e8296fb5c199b4bc1e2c8c914adebb2adde",
      "estimatedOutput": 736,
      "resultPath": "expansion/working/v2/results/song-440--ae0c0ff25188b0405e1eed74f1bc7e8296fb5c199b4bc1e2c8c914adebb2adde.json"
    },
    {
      "id": "song-441",
      "category": "宋词",
      "title": "生查子",
      "subtitle": "朝庭数擢贤旋占",
      "author": "陈亚",
      "dynasty": "宋",
      "content": "朝庭数擢贤，旋占凌霄路。\n自是郁陶人，险难无移处。\n也知没药疗饥寒，食薄何相误。\n大幅纸连粘，甘草归田赋。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "a4376016f636b22ab8e21e67620912e582ec588d95d096bff3cb71db1d11f8d4",
      "estimatedOutput": 706,
      "resultPath": "expansion/working/v2/results/song-441--a4376016f636b22ab8e21e67620912e582ec588d95d096bff3cb71db1d11f8d4.json"
    },
    {
      "id": "song-442",
      "category": "宋词",
      "title": "生查子",
      "subtitle": "相思意已深白纸",
      "author": "陈亚",
      "dynasty": "宋",
      "content": "相思意已深，白纸书难足。\n字字苦参商，故要槟郎读。\n分明记得约当归，远至樱桃熟。\n何事菊花时，犹未回乡曲。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "560038f4b9bd881e3d13a5a489c2d12e8ae43aca0c97ea9fc4f3d6148385450a",
      "estimatedOutput": 706,
      "resultPath": "expansion/working/v2/results/song-442--560038f4b9bd881e3d13a5a489c2d12e8ae43aca0c97ea9fc4f3d6148385450a.json"
    },
    {
      "id": "song-443",
      "category": "宋词",
      "title": "生查子",
      "subtitle": "小院雨馀凉石竹",
      "author": "陈亚",
      "dynasty": "宋",
      "content": "小院雨馀凉，石竹风生砌。\n罢扇尽从容，半下纱厨睡。\n起来闲坐北亭中，滴尽真珠泪。\n为念婿辛勤，去折蟾宫桂。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "d23cfc1a9cc909da495f75129667953dca4fe80d2eaba0bddcda1f49c8b2c679",
      "estimatedOutput": 706,
      "resultPath": "expansion/working/v2/results/song-443--d23cfc1a9cc909da495f75129667953dca4fe80d2eaba0bddcda1f49c8b2c679.json"
    },
    {
      "id": "song-444",
      "category": "宋词",
      "title": "生查子",
      "subtitle": "浪荡去未来踯躅",
      "author": "陈亚",
      "dynasty": "宋",
      "content": "浪荡去未来，踯躅花频换。\n可惜石榴裙，兰麝香销半。\n琵琶闲抱理相思，必拨朱弦断。\n拟续断朱弦，待这冤家看。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "143981a4c275e08a2b8d801b14bd1f4d757bc9b80c8c16f5e2675d5ca9239904",
