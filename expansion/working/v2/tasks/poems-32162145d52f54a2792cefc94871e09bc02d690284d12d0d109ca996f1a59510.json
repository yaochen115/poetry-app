    },
    {
      "id": "song-496",
      "category": "宋词",
      "title": "采桑子",
      "subtitle": "水云薄薄天同色",
      "author": "张先",
      "dynasty": "宋",
      "content": "水云薄薄天同色，竟日清辉。\n风影轻飞。\n花发瑶林春未知。\n剡溪不辨沙头路，粉水平堤。\n姑射人归。\n记得歌声与舞时。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "21abc5e390ea543ce59c3917e5802d4f7fc32c54d28604c3e740e45deaca71d8",
      "estimatedOutput": 714,
      "resultPath": "expansion/working/v2/results/song-496--21abc5e390ea543ce59c3917e5802d4f7fc32c54d28604c3e740e45deaca71d8.json"
    },
    {
      "id": "song-497",
      "category": "宋词",
      "title": "武陵春",
      "subtitle": "秋染青溪天外水",
      "author": "张先",
      "dynasty": "宋",
      "content": "秋染青溪天外水，风棹采菱还。\n波上逢郎密意传。\n语近隔丛莲。\n相看忘却归来路，遮日小荷圆。\n菱蔓虽多不上船。\n心眼在郎边。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "20421b141d6bb4b5cb4cf133e68ef67b562e57b70eda12c7e57b61898318633b",
      "estimatedOutput": 722,
      "resultPath": "expansion/working/v2/results/song-497--20421b141d6bb4b5cb4cf133e68ef67b562e57b70eda12c7e57b61898318633b.json"
    },
    {
      "id": "song-498",
      "category": "宋词",
      "title": "定风波",
      "subtitle": "素藕抽条未放莲",
      "author": "张先",
      "dynasty": "宋",
      "content": "素藕抽条未放莲。\n晚蚕将茧不成眠。\n若比相思如乱絮。\n何异。\n两心俱被暗丝牵。\n暂觉欲归还是恨。\n莫问。\n有情谁信道无缘。\n有似中秋云外月。\n皎洁。\n不团圆待几时圆。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "bcc9c6b0992dfadb00dec59285e3358fced2e71299fa5d0ee46ffe9301d7350f",
      "estimatedOutput": 766,
      "resultPath": "expansion/working/v2/results/song-498--bcc9c6b0992dfadb00dec59285e3358fced2e71299fa5d0ee46ffe9301d7350f.json"
    },
    {
      "id": "song-499",
      "category": "宋词",
      "title": "少年游",
      "subtitle": "红叶黄花秋又老",
      "author": "张先",
      "dynasty": "宋",
      "content": "红叶黄花秋又老，疏雨更西风。\n山重水远，云闲天淡，游子断肠中。\n青楼薄幸何时见，细说与、这忡忡。\n念远离情，感时愁绪，应解与人同。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "fca68829bd777ff7d1af8bb46cac7d0db26e152eeb4653b15676f56d3a32d5ff",
      "estimatedOutput": 730,
      "resultPath": "expansion/working/v2/results/song-499--fca68829bd777ff7d1af8bb46cac7d0db26e152eeb4653b15676f56d3a32d5ff.json"
    },
    {
      "id": "song-500",
      "category": "宋词",
      "title": "更漏子",
      "subtitle": "锦筵红罗幕翠侍",
      "author": "张先",
      "dynasty": "宋",
      "content": "锦筵红，罗幕翠。\n侍宴美人姝丽。\n十五六，解怜才。\n劝人深酒杯。\n黛眉长，檀口小。\n耳畔向人轻道。\n柳阴曲，是儿家。\n门前红杏花。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "f0434c8c478fed06cb960a6b20967d056f38e61c65da2d8d8ee8ecaf98e70b0a",
      "estimatedOutput": 730,
      "resultPath": "expansion/working/v2/results/song-500--f0434c8c478fed06cb960a6b20967d056f38e61c65da2d8d8ee8ecaf98e70b0a.json"
    },
    {
      "id": "song-501",
      "category": "宋词",
      "title": "更漏子",
      "subtitle": "相君家宾宴集秋",
      "author": "张先",
      "dynasty": "宋",
      "content": "相君家，宾宴集。\n秋叶晓霜红湿。\n帘额动，水纹浮。\n缬花相对流。\n薄霞衣，酣酒面。\n重抱琵琶轻按。\n回画拨，抹幺弦。\n一声飞露蝉。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "6cee3d4814e0c08a656054ced6555612fc06e1c8e199dfcb70008d1bc3b35f98",
      "estimatedOutput": 730,
      "resultPath": "expansion/working/v2/results/song-501--6cee3d4814e0c08a656054ced6555612fc06e1c8e199dfcb70008d1bc3b35f98.json"
    },
    {
      "id": "song-502",
      "category": "宋词",
      "title": "南歌子",
      "subtitle": "蝉抱高高柳莲开",
      "author": "张先",
      "dynasty": "宋",
      "content": "蝉抱高高柳，莲开浅浅波。\n倚风疏叶下庭柯。\n况是不寒不暖、正清和。\n浮世欢会少，劳生怨别多。\n相逢休惜醉颜酡。\n赖有西园明月、照笙歌。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "3cb8a885cac9a04005032afab4c2079a542b2be0645c31b4f1049cdf1082d1cc",
      "estimatedOutput": 734,
      "resultPath": "expansion/working/v2/results/song-502--3cb8a885cac9a04005032afab4c2079a542b2be0645c31b4f1049cdf1082d1cc.json"
    },
    {
      "id": "song-503",
      "category": "宋词",
      "title": "南歌子",
      "subtitle": "残照催行棹乘春",
      "author": "张先",
      "dynasty": "宋",
      "content": "残照催行棹，乘春拂去衣。\n海棠花下醉芳菲。\n无计少留君住、泪双垂。\n烟染春江暮，云藏阁道危。\n行行听取杜鹃啼。\n是妾此时离恨、尽呼伊。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "8fbcac59ee84257fb30b0e65a7412b0a3506c3c901c9956f731220f6194f8300",
      "estimatedOutput": 734,
      "resultPath": "expansion/working/v2/results/song-503--8fbcac59ee84257fb30b0e65a7412b0a3506c3c901c9956f731220f6194f8300.json"
    },
    {
      "id": "song-504",
      "category": "宋词",
      "title": "蝶恋花",
      "subtitle": "临水人家深宅院",
      "author": "张先",
      "dynasty": "宋",
      "content": "临水人家深宅院。\n阶下残花，门外斜阳岸。\n柳舞麴尘千万线。\n青楼百尺临天半。\n楼上东风春不浅。\n十二阑干，尽日珠帘卷。\n有个离人凝泪眼。\n淡烟芳草连云远。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "0ce2887de7f11acf414333081f23b1ed4f78c3ae39710832d2a43e177a669b44",
      "estimatedOutput": 754,
      "resultPath": "expansion/working/v2/results/song-504--0ce2887de7f11acf414333081f23b1ed4f78c3ae39710832d2a43e177a669b44.json"
    },
    {
      "id": "song-505",
      "category": "宋词",
      "title": "蝶恋花",
      "subtitle": "绿水波平花烂漫",
      "author": "张先",
      "dynasty": "宋",
      "content": "绿水波平花烂漫。\n照影红妆，步转垂杨岸。\n别后深情将为断。\n相逢添得人留恋。\n絮软丝轻无系绊。\n烟惹风迎，并入春心乱。\n和泪语娇声又颤。\n行行尽远犹回面。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "0375e5c788a6d96e74c0aa1e77392f5a4bef7edafd063166713bd870205b011c",
