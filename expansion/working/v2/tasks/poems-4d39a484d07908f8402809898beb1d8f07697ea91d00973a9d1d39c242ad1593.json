      "resultPath": "expansion/working/v2/results/tang-895--e9bdfd22610e38f867a6d028bc7d856e17d993843b28e2cad93ad688b4d3b0a7.json"
    },
    {
      "id": "tang-896",
      "category": "唐诗",
      "title": "吊卢殷 其四",
      "subtitle": "",
      "author": "孟郊",
      "dynasty": "唐",
      "content": "登封草木深，登封道路微。\n日月不与光，莓苔空生衣。\n可怜无子翁，蚍蜉缘病肌。\n挛卧岁时长，涟涟但幽噫。\n幽噫虎豹闻，此外相访稀。\n至亲唯有诗，抱心死有归。\n河南韩先生，后君作因依。\n磨一片嵌岩，书千古光辉。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "2268fbbdd88ad1bc5ac0e35cb4a226c7074b67a8a7e8cf5fea53c7fb59aa576c",
      "estimatedOutput": 806,
      "resultPath": "expansion/working/v2/results/tang-896--2268fbbdd88ad1bc5ac0e35cb4a226c7074b67a8a7e8cf5fea53c7fb59aa576c.json"
    },
    {
      "id": "tang-897",
      "category": "唐诗",
      "title": "诏授同州刺史，病不赴任，因咏所怀",
      "subtitle": "",
      "author": "白居易",
      "dynasty": "唐",
      "content": "同州慵不去，此意复谁知。\n诚爱俸钱厚，其如身力衰。\n可怜病判案，何似醉吟诗。\n劳逸悬相远，行藏决不疑。\n徒烦人劝谏，只合自寻思。\n白发来无限，青山去有期。\n野心惟怕闹，家口莫愁饥。\n卖却新昌宅，聊充送老资。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "95ccffacfbd11ed37af08e9248e1a067f7ab2f7f2a8e21a945c858757a7bcd05",
      "estimatedOutput": 806,
      "resultPath": "expansion/working/v2/results/tang-897--95ccffacfbd11ed37af08e9248e1a067f7ab2f7f2a8e21a945c858757a7bcd05.json"
    },
    {
      "id": "tang-898",
      "category": "唐诗",
      "title": "酬王履震游园林见贻",
      "subtitle": "",
      "author": "张九龄",
      "dynasty": "唐",
      "content": "宅生惟海县，素业守郊园。\n中览霸王说，上徼明主恩。\n一行罢兰径，数载历金门。\n既负潘生拙，俄从周任言。\n逶迤恋轩陛，萧散反丘樊。\n旧径稀人迹，前池耗水痕。\n并看芳树老，唯觉敝庐存。\n自我栖幽谷，逢君翳覆盆。\n孟轲应有命，贾谊得无冤。\n江上行伤远，林间偶避喧。\n地偏人事绝，时霁鸟声繁。\n独善心俱闭，穷居道共尊。\n乐因南涧藻，忧岂北堂萱。\n幽意加投漆，新诗重赠轩。\n平生徇知己，穷达与君论。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "6467fd0e3d9ca4df6a4ce5205f4d02b30608441fb7743ca462b5cec7793c1b5b",
      "estimatedOutput": 988,
      "resultPath": "expansion/working/v2/results/tang-898--6467fd0e3d9ca4df6a4ce5205f4d02b30608441fb7743ca462b5cec7793c1b5b.json"
    },
    {
      "id": "tang-899",
      "category": "唐诗",
      "title": "可叹",
      "subtitle": "",
      "author": "李商隐",
      "dynasty": "唐",
      "content": "幸会东城宴未回，年华忧共水相催。\n梁家宅里秦宫入，赵后楼中赤凤来。\n冰簟且眠金镂枕，琼筵不醉玉交杯。\n宓妃愁坐芝田馆，用尽陈王八斗才。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "f427c6fe2f8e38b6ba0d5c363ff6e0c668fcb54b2de0e1c62e30f54af2cf4e47",
      "estimatedOutput": 734,
      "resultPath": "expansion/working/v2/results/tang-899--f427c6fe2f8e38b6ba0d5c363ff6e0c668fcb54b2de0e1c62e30f54af2cf4e47.json"
    },
    {
      "id": "tang-900",
      "category": "唐诗",
      "title": "晚春卧病寄张八",
      "subtitle": "",
      "author": "孟浩然",
      "dynasty": "唐",
      "content": "南陌春将晚，北窗犹卧病。\n林园久不游，草木一何盛。\n狭迳花障迷，闲庭竹扫净。\n翠羽戏兰苕，赪鳞动荷柄。\n念我平生好，江乡远从政。\n云山阻梦思，衾枕劳歌咏。\n歌咏复何为，同心恨别离。\n世途皆自媚，流俗寡相知。\n贾谊才空逸，安仁鬓欲丝。\n遥情每东注，奔晷复西驰。\n常恐填沟壑，无由振羽仪。\n穷通若有命，欲向论中推。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "17d2d6111b301453cd01caff3ea90b74a419043c6f62a320fbe282e582d835b8",
      "estimatedOutput": 910,
      "resultPath": "expansion/working/v2/results/tang-900--17d2d6111b301453cd01caff3ea90b74a419043c6f62a320fbe282e582d835b8.json"
    },
    {
      "id": "tang-901",
      "category": "唐诗",
      "title": "奉酬鲁望夏日四声四首。平去声",
      "subtitle": "",
      "author": "皮日休",
      "dynasty": "唐",
      "content": "怡神时高吟，快意乍四顾。\n村深啼愁鹃，浪霁醒睡鹭。\n书疲行终朝，罩困卧至暮。\n吁嗟当今交，暂贵便异路。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "47c0c67f0f33091509723ae96b76426ee27cf51bcd12ead47d251d277d89ed64",
