    {
      "id": "tang-902",
      "category": "唐诗",
      "title": "发端州初入西江",
      "subtitle": "",
      "author": "宋之问",
      "dynasty": "唐",
      "content": "问我将何去，清晨溯越溪。\n翠微悬宿雨，丹壑饮晴霓。\n树影捎云密，藤阴覆水低。\n潮回出浦驶，洲转望乡迷。\n人意长怀北，江行日向西。\n破颜看鹊喜，拭泪听猿啼。\n骨肉初分爱，亲朋忽解携。\n路遥魂欲断，身辱理能齐。\n畴日三山意，于兹万绪暌。\n金陵有仙馆，即事寻丹梯。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "629d5e7a9b22883525f213cb0dd25d5e2936d28955d778c6368869385d8a5f3f",
      "estimatedOutput": 858,
      "resultPath": "expansion/working/v2/results/tang-902--629d5e7a9b22883525f213cb0dd25d5e2936d28955d778c6368869385d8a5f3f.json"
    },
    {
      "id": "tang-903",
      "category": "唐诗",
      "title": "过田家宅",
      "subtitle": "",
      "author": "杜牧",
      "dynasty": "唐",
      "content": "安邑南门外，谁家板筑高。\n奉诚园里地，墙缺见蓬蒿。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "f5313b758b7d2f40ee0ab1c6b3b49017974298f180b63a6caa8318c4ae351a9a",
