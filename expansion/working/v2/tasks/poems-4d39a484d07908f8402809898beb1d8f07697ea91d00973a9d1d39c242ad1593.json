      "resultPath": "expansion/working/v2/results/tang-894--46f5504c20e5f4616abb6cc5df8838c845eba5096605d174b70815f2d0c5f67f.json"
    },
    {
      "id": "tang-895",
      "category": "唐诗",
      "title": "寒食野望吟",
      "subtitle": "",
      "author": "白居易",
      "dynasty": "唐",
      "content": "丘墟郭门外，寒食谁家哭。\n风吹旷野纸钱飞，古墓累累春草绿。\n棠梨花映白杨树，尽是死生离别处。\n冥寞重泉哭不闻，萧萧暮雨人归去。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "e9bdfd22610e38f867a6d028bc7d856e17d993843b28e2cad93ad688b4d3b0a7",
