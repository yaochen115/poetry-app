      "resultPath": "expansion/working/v2/results/song-333--05e2db7e48cece192528669ee1fbb6a9d237c0a84b9d44025029d9067095fbe1.json"
    },
    {
      "id": "song-334",
      "category": "宋词",
      "title": "虞美人",
      "subtitle": "碧桃天上栽和露",
      "author": "秦观",
      "dynasty": "宋",
      "content": "碧桃天上栽和露，不是凡花数。乱山深处水萦回，可惜一枝如画为谁开？\n轻寒细雨情何限！不道春难管。为君沉醉又何妨，只怕酒醒时候断人肠。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "91c33a6431e6a193d210e4d2e629aad8141516888cab338b993ac75b0a693941",
      "estimatedOutput": 730,
      "resultPath": "expansion/working/v2/results/song-334--91c33a6431e6a193d210e4d2e629aad8141516888cab338b993ac75b0a693941.json"
    },
    {
      "id": "song-335",
      "category": "宋词",
      "title": "满江红",
      "subtitle": "怀子由作",
      "author": "苏轼",
      "dynasty": "宋",
      "content": "清颍东流，愁目断，孤帆明灭。宦游处，青山白浪，万重千叠。孤负当年林下意，对床夜雨听萧瑟。恨此生，长向别离中，生华发。\n一尊酒，黄河侧。无限事，从头说。相看恍如昨，许多年月。衣上旧痕余苦泪，眉间喜气占黄色。便与君，池上觅残春，花如雪。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "d94d900693e65966f9096c861d833acea7c36f030ec396fcbed7e8cf435d343d",
      "estimatedOutput": 832,
      "resultPath": "expansion/working/v2/results/song-335--d94d900693e65966f9096c861d833acea7c36f030ec396fcbed7e8cf435d343d.json"
    },
    {
      "id": "song-336",
      "category": "宋词",
      "title": "渔家傲",
      "subtitle": "五月榴花妖艳烘",
      "author": "欧阳修",
      "dynasty": "宋",
      "content": "五月榴花妖艳烘。绿杨带雨垂垂重。五色新丝缠角粽。金盘送。生绡画扇盘双凤。\n正是浴兰时节动。菖蒲酒美清尊共。叶里黄鹂时一弄。犹瞢忪。等闲惊破纱窗梦。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "c2d099e4cad0c7d2e2b0fe801301f5af63558b4722e1d41c41d2671a786f13af",
      "estimatedOutput": 746,
