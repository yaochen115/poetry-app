    },
    {
      "id": "song-064",
      "category": "宋词",
      "title": "长相思",
      "subtitle": "一重山",
      "author": "李煜",
      "dynasty": "五代·南唐",
      "content": "一重山，两重山。山远天高烟水寒，相思枫叶丹。\n菊花开，菊花残。塞雁高飞人未还，一帘风月闲。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "86470ff426582c774723d034aa543f2b11d318c3cb379f751b962dbd30c45128",
