    },
    {
      "id": "song-065",
      "category": "宋词",
      "title": "西江月",
      "subtitle": "世事一场大梦",
      "author": "苏轼",
      "dynasty": "宋",
      "content": "世事一场大梦，人生几度秋凉？夜来风叶已鸣廊。看取眉头鬓上。\n酒贱常愁客少，月明多被云妨。中秋谁与共孤光。把盏凄然北望。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "4917b1cc55c553403c916702c7933db3a6e06fbf0b39e4bfb7e77a8a21ae3907",
      "estimatedOutput": 718,
      "resultPath": "expansion/working/v2/results/song-065--4917b1cc55c553403c916702c7933db3a6e06fbf0b39e4bfb7e77a8a21ae3907.json"
    },
    {
      "id": "song-066",
      "category": "宋词",
      "title": "浪淘沙",
      "subtitle": "把酒祝东风",
      "author": "欧阳修",
      "dynasty": "宋",
      "content": "把酒祝东风，且共从容。垂杨紫陌洛城东。总是当时携手处，游遍芳丛。\n聚散苦匆匆，此恨无穷。今年花胜去年红。可惜明年花更好，知与谁同？",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "48034fcb5d7d9d8bbec84c11624b2df84264762dbb65f308adb4f5117cef029a",
      "estimatedOutput": 730,
      "resultPath": "expansion/working/v2/results/song-066--48034fcb5d7d9d8bbec84c11624b2df84264762dbb65f308adb4f5117cef029a.json"
    },
    {
      "id": "song-067",
      "category": "宋词",
      "title": "浣溪沙",
      "subtitle": "闺情",
      "author": "李清照",
      "dynasty": "宋",
      "content": "绣面芙蓉一笑开，斜飞宝鸭衬香腮。眼波才动被人猜。 \n一面风情深有韵，半笺娇恨寄幽怀。月移花影约重来。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "d1955ea60f91798e5ae39569126b8d58e78b164504c57728dbc7558e63f3dadb",
      "estimatedOutput": 700,
      "resultPath": "expansion/working/v2/results/song-067--d1955ea60f91798e5ae39569126b8d58e78b164504c57728dbc7558e63f3dadb.json"
    },
    {
      "id": "song-068",
      "category": "宋词",
      "title": "乌夜啼",
      "subtitle": "昨夜风兼雨",
      "author": "李煜",
      "dynasty": "五代·南唐",
      "content": "昨夜风兼雨，帘帏飒飒秋声。烛残漏断频欹枕，起坐不能平。　\n世事漫随流水，算来一梦浮生。醉乡路稳宜频到，此外不堪行。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "d19de12dcc24b91b766b1c80e93ff630e3f484cfe841af63a15e21741db57997",
      "estimatedOutput": 714,
      "resultPath": "expansion/working/v2/results/song-068--d19de12dcc24b91b766b1c80e93ff630e3f484cfe841af63a15e21741db57997.json"
    },
    {
      "id": "song-069",
      "category": "宋词",
      "title": "采桑子",
      "subtitle": "群芳过后西湖好",
      "author": "欧阳修",
      "dynasty": "宋",
      "content": "群芳过后西湖好，狼籍残红，飞絮濛濛。垂柳阑干尽日风。\n笙歌散尽游人去，始觉春空。垂下帘栊，双燕归来细雨中。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "bee336012a0e3bd5dc7a1d14c064b49111f12dfdc32ab04cb3ec6dbac0d5011c",
      "estimatedOutput": 706,
      "resultPath": "expansion/working/v2/results/song-069--bee336012a0e3bd5dc7a1d14c064b49111f12dfdc32ab04cb3ec6dbac0d5011c.json"
    },
    {
      "id": "song-070",
      "category": "宋词",
      "title": "西江月",
      "subtitle": "遣兴",
      "author": "辛弃疾",
      "dynasty": "宋",
      "content": "醉里且贪欢笑，要愁那得工夫。\n近来始觉古人书。信著全无是处。\n昨夜松边醉倒，问松我醉何如。\n只疑松动要来扶。以手推松曰去。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "6bebdee89ef7ec039c39dd68ce9c3472fd255c30334205373a568136785b358b",
      "estimatedOutput": 722,
      "resultPath": "expansion/working/v2/results/song-070--6bebdee89ef7ec039c39dd68ce9c3472fd255c30334205373a568136785b358b.json"
    },
    {
      "id": "song-071",
      "category": "宋词",
      "title": "清平乐",
      "subtitle": "春归何处",
      "author": "黄庭坚",
      "dynasty": "宋",
      "content": "春归何处。寂寞无行路。若有人知春去处。唤取归来同住。 \n春无踪迹谁知。除非问取黄鹂。百啭无人能解，因风飞过蔷薇。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "29cf20e49262d6c4b1a3845687ab38ec79da01ee98af0ca63f77a4998c05d224",
      "estimatedOutput": 712,
      "resultPath": "expansion/working/v2/results/song-071--29cf20e49262d6c4b1a3845687ab38ec79da01ee98af0ca63f77a4998c05d224.json"
    },
    {
      "id": "song-072",
      "category": "宋词",
      "title": "忆江南",
      "subtitle": "多少恨",
      "author": "李煜",
      "dynasty": "五代·南唐",
      "content": "多少恨，昨夜梦魂中。还似旧时游上苑，车如流水马如龙。花月正春风。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "e889ffa6bd3f4e6962ef77ffd9206ac752183688f9240096497e1cae48d450d7",
