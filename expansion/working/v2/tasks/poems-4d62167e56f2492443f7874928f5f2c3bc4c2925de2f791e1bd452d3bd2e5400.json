    },
    {
      "id": "song-223",
      "category": "宋词",
      "title": "卜算子",
      "subtitle": "芍药打团红",
      "author": "洪咨夔",
      "dynasty": "宋",
      "content": "芍药打团红，萱草成窝绿。帘卷疏风燕子归，依旧卢仝屋。\n贫放麹生疏，闲到青奴熟。扫地焚香伴老仙，人胜连环玉。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "7c12953b888a85debfaaa455411bf4d426fa6375eebb07d500692f66943159e3",
