    },
    {
      "id": "song-227",
      "category": "宋词",
      "title": "永遇乐",
      "subtitle": "彭城夜宿燕子楼",
      "author": "苏轼",
      "dynasty": "宋",
      "content": "彭城夜宿燕子楼，梦盼盼，因作此词。\n明月如霜，好风如水，清景无限。曲港跳鱼，圆荷泻露，寂寞无人见。紞如三鼓，铿然一叶，黯黯梦云惊断。夜茫茫，重寻无处，觉来小园行遍。\n天涯倦客，山中归路，望断故园心眼。燕子楼空，佳人何在，空锁楼中燕。古今如梦，何曾梦觉，但有旧欢新怨。异时对，黄楼夜景，为余浩叹。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "7d20579799c451b85a5f25e0bf5fe2bd903da6ecdfbb7fcc994f3c672a06bdec",
      "estimatedOutput": 894,
      "resultPath": "expansion/working/v2/results/song-227--7d20579799c451b85a5f25e0bf5fe2bd903da6ecdfbb7fcc994f3c672a06bdec.json"
    },
    {
      "id": "song-228",
      "category": "宋词",
      "title": "浣溪沙",
      "subtitle": "玉碗冰寒滴露华",
      "author": "晏殊",
      "dynasty": "宋",
      "content": "玉碗冰寒滴露华，粉融香雪透轻纱。晚来妆面胜荷花。\n鬓亸欲迎眉际月，酒红初上脸边霞。一场春梦日西斜。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "47383c33fc3ffc990c34dbc06075ed73c188c2d7dfd5bf962ce4d7d2222f0c3b",
