    },
    {
      "id": "tang-846",
      "category": "唐诗",
      "title": "出山逢耿湋",
      "subtitle": "",
      "author": "卢纶",
      "dynasty": "唐",
      "content": "云雪离披山万里，别来曾住最高峰。\n暂到人间归不得，长安陌上又相逢。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "2b546534d6ea051d3d183cc856db4ba9847222b46fd9aff711dfa15a0b1b86df",
      "estimatedOutput": 666,
      "resultPath": "expansion/working/v2/results/tang-846--2b546534d6ea051d3d183cc856db4ba9847222b46fd9aff711dfa15a0b1b86df.json"
    },
    {
      "id": "tang-847",
      "category": "唐诗",
      "title": "永王东巡歌十一首 其八",
      "subtitle": "",
      "author": "李白",
      "dynasty": "唐",
      "content": "长风挂席势难回，海动山倾古月摧。\n君看帝子浮江日，何似龙骧出峡来。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "4db2bbfaf784c07e115e75d41a8842ef3efa6b243a12374e9ba6bf5ef94f0891",
      "estimatedOutput": 666,
      "resultPath": "expansion/working/v2/results/tang-847--4db2bbfaf784c07e115e75d41a8842ef3efa6b243a12374e9ba6bf5ef94f0891.json"
    },
    {
      "id": "tang-848",
      "category": "唐诗",
      "title": "头陀僧",
      "subtitle": "",
      "author": "陆龟蒙",
      "dynasty": "唐",
      "content": "万峰围绕一峰深，向此长修苦行心。\n自扫雪中归鹿迹，天明恐被猎人寻。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "4a59cd338d0f6ca3ebbe0181d0f44e3993cdac866d2b1e45b0ea1851cac1d506",
      "estimatedOutput": 666,
      "resultPath": "expansion/working/v2/results/tang-848--4a59cd338d0f6ca3ebbe0181d0f44e3993cdac866d2b1e45b0ea1851cac1d506.json"
    },
    {
      "id": "tang-849",
      "category": "唐诗",
      "title": "感遇诗三十八首 其四",
      "subtitle": "",
      "author": "陈子昂",
      "dynasty": "唐",
      "content": "乐羊为魏将，食子殉军功。\n骨肉且相薄，他人安得忠。\n吾闻中山相，乃属放麑翁。\n孤兽犹不忍，况以奉君终。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "e48d766164b2afd512f014227461e2ea96d48fcc2774d7e205b65103e252ca95",
      "estimatedOutput": 702,
      "resultPath": "expansion/working/v2/results/tang-849--e48d766164b2afd512f014227461e2ea96d48fcc2774d7e205b65103e252ca95.json"
    },
    {
      "id": "tang-850",
      "category": "唐诗",
      "title": "原隰荑绿柳",
      "subtitle": "",
      "author": "温庭筠",
      "dynasty": "唐",
      "content": "迥野韶光早，晴川柳满堤。\n拂尘生嫩绿，披雪见柔荑。\n碧玉牙犹短，黄金缕未齐。\n腰肢弄寒吹，眉意入春闺。\n预恐狂夫折，迎牵逸客迷。\n新莺将出谷，应借一枝栖。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "7354f4277155ff6cdb03fc796cced2eb3fea5239f685a973117c2837cc49205a",
      "estimatedOutput": 754,
      "resultPath": "expansion/working/v2/results/tang-850--7354f4277155ff6cdb03fc796cced2eb3fea5239f685a973117c2837cc49205a.json"
    },
    {
      "id": "tang-851",
      "category": "唐诗",
      "title": "送曹同椅",
      "subtitle": "",
      "author": "司空曙",
      "dynasty": "唐",
      "content": "青春三十馀，众艺尽无如。\n中散诗传画，将军扇续书。\n楚田晴下雁，江日暖游鱼。\n惆怅空相送，欢游自此疏。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "b7db71f1bf8a032e0d46d47163dc15b95bd17a00db4d829944e43f711eb98dc6",
      "estimatedOutput": 702,
      "resultPath": "expansion/working/v2/results/tang-851--b7db71f1bf8a032e0d46d47163dc15b95bd17a00db4d829944e43f711eb98dc6.json"
    },
    {
      "id": "tang-852",
      "category": "唐诗",
      "title": "淮阳路",
      "subtitle": "",
      "author": "李商隐",
      "dynasty": "唐",
      "content": "荒村倚废营，投宿旅魂惊。\n断雁高仍急，寒溪晓更清。\n昔年尝聚盗，此日颇分兵。\n猜贰谁先致，三朝事始平。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "58f4d2624197665987416cfc1cdd5fe4bf0d0259b9eb83dd9ebd42a682e3feaf",
      "estimatedOutput": 702,
      "resultPath": "expansion/working/v2/results/tang-852--58f4d2624197665987416cfc1cdd5fe4bf0d0259b9eb83dd9ebd42a682e3feaf.json"
    },
    {
      "id": "tang-853",
      "category": "唐诗",
      "title": "闻征四处士",
      "subtitle": "",
      "author": "贯休",
      "dynasty": "唐",
      "content": "一诏群公起，移山四海闻。\n因知丈夫事，须佐圣明君。\n白酒全倾瓮，蒲轮半载云。\n从兹居谏署，笔砚几人焚。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "d862094e063606da35de5ad619ac9df64faa955a70296d5167b2b61176a7cf0c",
      "estimatedOutput": 702,
      "resultPath": "expansion/working/v2/results/tang-853--d862094e063606da35de5ad619ac9df64faa955a70296d5167b2b61176a7cf0c.json"
    },
    {
      "id": "tang-854",
      "category": "唐诗",
      "title": "夜泊永乐有怀",
      "subtitle": "",
      "author": "许浑",
      "dynasty": "唐",
      "content": "莲渚愁红荡碧波，吴娃齐唱采莲歌。\n横塘一别已千里，芦苇萧萧风雨多。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "2aeeae76a604f02ceff8ef2579881506b46858238b0ac7c97448d73f8f516168",
      "estimatedOutput": 666,
      "resultPath": "expansion/working/v2/results/tang-854--2aeeae76a604f02ceff8ef2579881506b46858238b0ac7c97448d73f8f516168.json"
    },
    {
      "id": "tang-855",
      "category": "唐诗",
      "title": "得湖州崔十八使君书喜与杭越邻郡因成长句代贺兼寄微之",
      "subtitle": "",
      "author": "白居易",
      "dynasty": "唐",
      "content": "三郡何因此结缘，贞元科第忝同年。\n故情欢喜开书后，旧事思量在眼前。\n越国封疆吞碧海，杭城楼閤入青烟。\n吴兴卑小君应屈，为是蓬莱最后仙。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "8956d5e3fac90d7d6d7808beddd3caded7ca0cb1f1719ac23f83f0d4d1b8994d",
      "estimatedOutput": 734,
      "resultPath": "expansion/working/v2/results/tang-855--8956d5e3fac90d7d6d7808beddd3caded7ca0cb1f1719ac23f83f0d4d1b8994d.json"
    },
    {
      "id": "tang-856",
      "category": "唐诗",
      "title": "哭辛霁",
      "subtitle": "",
      "author": "钱起",
      "dynasty": "唐",
      "content": "流水辞山花别枝，随风一去绝还期。\n昨夜故人泉下宿，今朝白发镜中垂。\n音徽寂寂空成梦，容范朝朝无见时。\n旦暮馀生几息在，不应存没未尝悲。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "bbef4672788f8e77f7b7356d719d83316840495f42c9f49dda9d07c618b39871",
