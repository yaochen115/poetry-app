    {
      "id": "song-747",
      "category": "宋词",
      "title": "蝶恋花",
      "subtitle": "几度兰房听禁漏",
      "author": "欧阳修",
      "dynasty": "宋",
      "content": "几度兰房听禁漏。\n臂上残妆，印得香盈袖。\n酒力融融香汗透。\n春娇入眼横波溜。\n不见些时眉已皱。\n水阔山遥，乍向分飞后。\n大抵有情须感旧。\n肌肤拼为伊销瘦。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "a0fe08365bbccbd0757d72ed40ef147008a6f396aeb3dfc26d361c38c3f05d7d",
      "estimatedOutput": 754,
      "resultPath": "expansion/working/v2/results/song-747--a0fe08365bbccbd0757d72ed40ef147008a6f396aeb3dfc26d361c38c3f05d7d.json"
    },
    {
      "id": "song-748",
      "category": "宋词",
      "title": "蝶恋花",
      "subtitle": "宝琢珊瑚山样瘦",
      "author": "欧阳修",
      "dynasty": "宋",
      "content": "宝琢珊瑚山样瘦。\n缓髻轻拢，一朵云生袖。\n昨夜佳人初命偶。\n论情旋旋移相就。\n几叠鸳衾红浪皱。\n暗觉金钗，磔磔声相扣。\n一自楚台人梦后。\n凄凉暮雨沾裀绣。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "11fda2c5506efab8c360eab2b78e2e7c568a9febae2cfd499e289ee91f3aa3b6",
      "estimatedOutput": 754,
      "resultPath": "expansion/working/v2/results/song-748--11fda2c5506efab8c360eab2b78e2e7c568a9febae2cfd499e289ee91f3aa3b6.json"
    },
    {
      "id": "song-749",
      "category": "宋词",
      "title": "蝶恋花",
      "subtitle": "一掬天和金粉腻",
      "author": "欧阳修",
      "dynasty": "宋",
      "content": "一掬天和金粉腻。\n莲子心中，自有深深意。\n意密莲深秋正媚。\n将花寄恨无人会。\n桥上少年桥下水。\n小棹归时，不语牵红袂。\n浪溅荷心圆又碎。\n无端欲伴相思泪。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "ad930901cc3d7363a4dfc2adfd188a6cf326c8a727155fbdda888539f460dae4",
      "estimatedOutput": 754,
      "resultPath": "expansion/working/v2/results/song-749--ad930901cc3d7363a4dfc2adfd188a6cf326c8a727155fbdda888539f460dae4.json"
    },
    {
      "id": "song-750",
      "category": "宋词",
      "title": "蝶恋花",
      "subtitle": "百种相思千种恨",
      "author": "欧阳修",
      "dynasty": "宋",
      "content": "百种相思千种恨。\n早是伤春，那更春醪困。\n薄幸辜人终不愤。\n何时枕畔分明问。\n懊恼风流心一寸。\n强醉偷眠，也即依前闷。\n此意为君君不信。\n泪珠滴尽愁难尽。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "da24d44783df0426b63d598df1c8fbbaf7a22d94ea596f5c3df14dd39b8c540f",
      "estimatedOutput": 754,
      "resultPath": "expansion/working/v2/results/song-750--da24d44783df0426b63d598df1c8fbbaf7a22d94ea596f5c3df14dd39b8c540f.json"
    },
    {
      "id": "song-751",
      "category": "宋词",
      "title": "武陵春",
      "subtitle": "宝幄华灯相见夜",
      "author": "欧阳修",
      "dynasty": "宋",
      "content": "宝幄华灯相见夜，妆脸小桃红。\n斗帐香檀翡翠笼。\n携手恨匆匆。\n金泥双结同心带，留与记情浓。\n却望行云十二峰。\n肠断月斜锺。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "9406cc6e02a395560e62a02473a8464d50003c335d96e1782ed23f3b027d8e82",
      "estimatedOutput": 722,
      "resultPath": "expansion/working/v2/results/song-751--9406cc6e02a395560e62a02473a8464d50003c335d96e1782ed23f3b027d8e82.json"
    },
    {
      "id": "song-752",
      "category": "宋词",
      "title": "渔家傲",
      "subtitle": "为爱莲房都一柄",
      "author": "欧阳修",
      "dynasty": "宋",
      "content": "为爱莲房都一柄。\n双苞双蕊双红影。\n雨势断来风色定。\n秋水静。\n仙郎彩女临鸾镜。\n妾有容华君不省。\n花无恩爱犹相并。\n花却有情人薄幸。\n心耿耿。\n因花又染相思病。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "3dc33eeee51cc92cbc8eac5d32e1e6d8a42ff54d66a2c52e7071755e0496369f",
      "estimatedOutput": 762,
      "resultPath": "expansion/working/v2/results/song-752--3dc33eeee51cc92cbc8eac5d32e1e6d8a42ff54d66a2c52e7071755e0496369f.json"
    },
    {
      "id": "song-753",
      "category": "宋词",
      "title": "渔家傲",
      "subtitle": "昨日采花花欲尽",
      "author": "欧阳修",
      "dynasty": "宋",
      "content": "昨日采花花欲尽。\n隔花闻道潮来近。\n风猎紫荷声又紧。\n低难奔。\n莲茎刺惹香腮损。\n一缕艳痕红隐隐。\n新霞点破秋蟾晕。\n罗袖挹残心不稳。\n羞人问。\n归来剩把胭脂衬。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "79d9baf88bff95f64c59bc6fdfb42ba174c55655bde730566d6698f964ab4564",
      "estimatedOutput": 762,
      "resultPath": "expansion/working/v2/results/song-753--79d9baf88bff95f64c59bc6fdfb42ba174c55655bde730566d6698f964ab4564.json"
    },
    {
      "id": "song-754",
      "category": "宋词",
      "title": "渔家傲",
      "subtitle": "一夜越溪秋水满",
      "author": "欧阳修",
      "dynasty": "宋",
      "content": "一夜越溪秋水满。\n荷花开过溪南岸。\n贪采嫩香星眼慢。\n疏回眄。\n郎船不觉来身畔。\n罢采金英收玉腕。\n回身急打船头转。\n荷叶又浓波又浅。\n无方便。\n教人只得抬娇面。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "9b14c589d4cdb02bf64e1911da8c991f09721ad27bc67ab7d248135fc8919d8f",
      "estimatedOutput": 762,
      "resultPath": "expansion/working/v2/results/song-754--9b14c589d4cdb02bf64e1911da8c991f09721ad27bc67ab7d248135fc8919d8f.json"
    },
    {
      "id": "song-755",
      "category": "宋词",
      "title": "渔家傲",
      "subtitle": "近日门前溪水涨",
      "author": "欧阳修",
      "dynasty": "宋",
      "content": "近日门前溪水涨。\n郎船几度偷相访。\n船小难开红斗帐。\n无计向。\n合欢影里空惆怅。\n愿妾身为红菡萏。\n年年生在秋江上。\n重愿郎为花底浪。\n无隔障。\n随风逐雨长来往。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "2ff587503da07a83b9d3066a318ee4caf17536e1f6ebf76091f765f061e05dd3",
      "estimatedOutput": 762,
      "resultPath": "expansion/working/v2/results/song-755--2ff587503da07a83b9d3066a318ee4caf17536e1f6ebf76091f765f061e05dd3.json"
    },
    {
      "id": "song-756",
      "category": "宋词",
      "title": "渔家傲",
      "subtitle": "妾解清歌并巧笑",
      "author": "欧阳修",
      "dynasty": "宋",
      "content": "妾解清歌并巧笑。\n郎多才俊兼年少。\n何事抛儿行远道。\n无音耗。\n江头又绿王孙草。\n昔日采花呈窈窕。\n玉容长笑花枝老。\n今日采花添懊恼。\n伤怀抱。\n玉容不及花枝好。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "8a01d9c8b84f815b7d57a707ce63a5dfe9551e945119199de9e57f7465f23d2c",
      "estimatedOutput": 762,
