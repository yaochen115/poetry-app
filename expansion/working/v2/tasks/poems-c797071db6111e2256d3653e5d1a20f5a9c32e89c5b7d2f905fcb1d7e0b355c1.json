    },
    {
      "id": "song-737",
      "category": "宋词",
      "title": "虞美人",
      "subtitle": "炉香昼永龙烟白",
      "author": "欧阳修",
      "dynasty": "宋",
      "content": "炉香昼永龙烟白。\n风动金鸾额。\n画屏寒掩小山川。\n睡容初起枕痕圆。\n坠花钿。\n楼高不及烟霄半。\n望尽相思眼。\n艳阳刚爱挫愁人。\n故生芳草碧连云。\n怨王孙。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "642860c3cfb193bc04ce7a9f79044aa2878de08b7e3559c8573c5577cfbe9564",
      "estimatedOutput": 754,
      "resultPath": "expansion/working/v2/results/song-737--642860c3cfb193bc04ce7a9f79044aa2878de08b7e3559c8573c5577cfbe9564.json"
    },
    {
      "id": "song-738",
      "category": "宋词",
      "title": "清平乐",
      "subtitle": "小庭春老碧砌红",
      "author": "欧阳修",
      "dynasty": "宋",
      "content": "小庭春老。\n碧砌红萱草。\n长忆小阑闲共绕。\n携手绿丛含笑。\n别来音信全乖。\n旧期前事堪猜。\n门掩日斜人静，落花愁点青苔。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "da3b679be91314fe08fa871d33716d91733a5f936aa2e39f8462f7678db9d09c",
      "estimatedOutput": 720,
      "resultPath": "expansion/working/v2/results/song-738--da3b679be91314fe08fa871d33716d91733a5f936aa2e39f8462f7678db9d09c.json"
    },
    {
      "id": "song-739",
      "category": "宋词",
      "title": "南乡子",
      "subtitle": "翠密红繁水国凉",
      "author": "欧阳修",
      "dynasty": "宋",
      "content": "翠密红繁。\n水国凉生未是寒。\n雨打荷花珠不定，轻翻。\n冷泼鸳鸯锦翅斑。\n尽日凭阑。\n弄蕊拈花仔细看。\n偷得袅蹄新铸样，无端。\n藏在红房艳粉间。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "ffd8155d71722486c9f74c4c3736cd09ded7999bb378f23ed0c3499efabadc60",
      "estimatedOutput": 742,
      "resultPath": "expansion/working/v2/results/song-739--ffd8155d71722486c9f74c4c3736cd09ded7999bb378f23ed0c3499efabadc60.json"
    },
    {
      "id": "song-740",
      "category": "宋词",
      "title": "南乡子",
      "subtitle": "雨后斜阳细细风",
      "author": "欧阳修",
      "dynasty": "宋",
      "content": "雨后斜阳。\n细细风来细细香。\n风定波平花映水，休藏。\n照出轻盈半面妆。\n路隔秋江。\n莲子深深隐翠房。\n意在莲心无问处，难忘。\n泪裛红腮不记行。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "9c812a71b2634412d54fb26ca622780df037423ba396334a2bb4d7b594a0a7b2",
      "estimatedOutput": 742,
      "resultPath": "expansion/working/v2/results/song-740--9c812a71b2634412d54fb26ca622780df037423ba396334a2bb4d7b594a0a7b2.json"
    },
    {
      "id": "song-741",
      "category": "宋词",
      "title": "鹊桥仙",
      "subtitle": "月波清霁烟容明",
      "author": "欧阳修",
      "dynasty": "宋",
      "content": "月波清霁，烟容明淡，灵汉旧期还至。\n鹊迎桥路接天津，映夹岸、星榆点缀。\n云屏未卷，仙鸡催晓，肠断去年情味。\n多应天意不教长，恁恐把、欢娱容易。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "4bae78e0151bc2a51171e8196970a8441c23c1dbbbdc3e12d2b5d479e6a48215",
      "estimatedOutput": 742,
      "resultPath": "expansion/working/v2/results/song-741--4bae78e0151bc2a51171e8196970a8441c23c1dbbbdc3e12d2b5d479e6a48215.json"
    },
    {
      "id": "song-742",
      "category": "宋词",
      "title": "摸鱼儿",
      "subtitle": "卷绣帘梧桐秋院",
      "author": "欧阳修",
      "dynasty": "宋",
      "content": "卷绣帘、梧桐秋院落，一霎雨添新绿。\n对小池闲立残妆浅，向晚水纹如縠。\n凝远目。\n恨人去寂寂，凤枕孤难宿。\n倚阑不足。\n看燕拂风檐，蝶翻露草，两两长相逐。\n双眉促。\n可惜年华婉娩，西风初弄庭菊。\n况伊家年少，多情未已难拘束。\n那堪更趁凉景，追寻甚处垂杨曲。\n佳期过尽，但不说归来，多应忘了，云屏去时祝。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "127c90d369c432787e8c60b8a40baea63d26739d6e1ba493912d65279968ceed",
      "estimatedOutput": 900,
      "resultPath": "expansion/working/v2/results/song-742--127c90d369c432787e8c60b8a40baea63d26739d6e1ba493912d65279968ceed.json"
    },
    {
      "id": "song-743",
      "category": "宋词",
      "title": "少年游",
      "subtitle": "去年秋晚此园中",
      "author": "欧阳修",
      "dynasty": "宋",
      "content": "去年秋晚此园中。\n携手玩芳丛。\n拈花嗅蕊，恼烟撩雾，拼醉倚西风。\n今年重对芳丛处，追往事、又成空。\n敲遍阑干，向人无语，惆怅满枝红。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "190ec393539e2ed4333d5762161849325d653b22e63f990c181ef1234a51bd0c",
      "estimatedOutput": 732,
      "resultPath": "expansion/working/v2/results/song-743--190ec393539e2ed4333d5762161849325d653b22e63f990c181ef1234a51bd0c.json"
    },
    {
      "id": "song-744",
      "category": "宋词",
      "title": "少年游",
      "subtitle": "肉红圆样浅心黄",
      "author": "欧阳修",
      "dynasty": "宋",
      "content": "肉红圆样浅心黄。\n枝上巧如装。\n雨轻烟重，无憀天气，啼破晓来妆。\n寒轻贴体风头冷，忍抛弃、向秋光。\n不会深心，为谁惆怅，回面恨斜阳。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "dd32f7e9589bff84e9ba6b896f1ffd5a03ebb69623dd9ecacdc12159040a4e10",
      "estimatedOutput": 732,
      "resultPath": "expansion/working/v2/results/song-744--dd32f7e9589bff84e9ba6b896f1ffd5a03ebb69623dd9ecacdc12159040a4e10.json"
    },
    {
      "id": "song-745",
      "category": "宋词",
      "title": "少年游",
      "subtitle": "玉壶冰莹兽炉灰",
      "author": "欧阳修",
      "dynasty": "宋",
      "content": "玉壶冰莹兽炉灰。\n人起绣帘开。\n春从一夜，六花开尽，不待剪刀催。\n洛阳城阙中天起，高下遍楼台。\n絮乱风轻，拂鞍沾袖，归路似章街。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "cbdb8767f599108601814d88bdd79e567bace288fab393ba6b2cf7e4ebca4d63",
