    },
    {
      "id": "song-736",
      "category": "宋词",
      "title": "浣溪沙",
      "subtitle": "十载相逢酒一卮",
      "author": "欧阳修",
      "dynasty": "宋",
      "content": "十载相逢酒一卮。\n故人才见便开眉。\n老来游旧更同谁。\n浮世歌欢真易失，宦途离合信难期。\n尊前莫惜醉如泥。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "afcd5e21abed9ebcee93e4cc0b38ebd10d1ac61bbb4fef7905efc59b109b647f",
