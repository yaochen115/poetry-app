    },
    {
      "id": "song-323",
      "category": "宋词",
      "title": "南乡子",
      "subtitle": "自古帝王州",
      "author": "王安石",
      "dynasty": "宋",
      "content": "自古帝王州，郁郁葱葱佳气浮。四百年来成一梦，堪愁。晋代衣冠成古丘。\n绕水恣行游。上尽层城更上楼。往事悠悠君莫问，回头。槛外长江空自流。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "485fdeeb7ec973232d93555f5df2d834dcfe7f86c86d0e08a5af48954307a31e",
