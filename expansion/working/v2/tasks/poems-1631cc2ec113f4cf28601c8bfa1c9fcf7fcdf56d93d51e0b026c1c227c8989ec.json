    },
    {
      "id": "song-318",
      "category": "宋词",
      "title": "好事近",
      "subtitle": "风定落花深",
      "author": "李清照",
      "dynasty": "宋",
      "content": "风定落花深，帘外拥红堆雪。长记海棠开后，正伤春时节。\n酒阑歌罢玉尊空，青缸暗明灭。魂梦不堪幽怨，更一声啼鴂。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "303e6e0f46b7c3b872eecbf753d3fc296c04c4c5716425d6c1d3b2e03bd68636",
