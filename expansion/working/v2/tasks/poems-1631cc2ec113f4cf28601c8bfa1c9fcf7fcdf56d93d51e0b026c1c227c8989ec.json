    },
    {
      "id": "song-316",
      "category": "宋词",
      "title": "卜算子",
      "subtitle": "兰",
      "author": "曹组",
      "dynasty": "宋",
      "content": "松竹翠萝寒，迟日江山暮。幽径无人独自芳，此恨凭谁诉。似共梅花语。尚有寻芳侣。着意闻时不肯香，香在无心处。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "e0ae02827bd7318073c7197d2fbc05dd4637ecd6699bca00aa92d05d76016765",
