    },
    {
      "id": "song-324",
      "category": "宋词",
      "title": "少年游",
      "subtitle": "参差烟树灞陵桥",
      "author": "柳永",
      "dynasty": "宋",
      "content": "参差烟树灞陵桥，风物尽前朝。衰杨古柳，几经攀折，憔悴楚宫腰。\n夕阳闲淡秋光老，离思满蘅皋。一曲阳关，断肠声尽，独自凭兰桡。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "1e5a1e28762dc6de59a7d12f4b11380cc58e0dcdef77fe4d29ce429b98ab0d20",
