      "resultPath": "expansion/working/v2/results/guwen-475--39b26956fc3a9856970e1164fe71add36cc64f72edcaf42d11f48f488614ce57.json"
    },
    {
      "id": "guwen-476",
      "category": "古文",
      "title": "围炉夜话·第一七七则",
      "subtitle": "",
      "author": "王永彬",
      "dynasty": "清",
      "content": "何者为益友？凡事肯规我之过者是也；何者为小人？凡事必徇己之私者是也。",
      "excerptOf": "围炉夜话",
      "excerptNote": "完整选录《围炉夜话》中“第一七七则”一则或一章；非全书。",
      "inputHash": "59afca0a2b534f119a120aba2554fe122a88f01bbc096ab4174284f25d12fdfe",
      "estimatedOutput": 702,
      "resultPath": "expansion/working/v2/results/guwen-476--59afca0a2b534f119a120aba2554fe122a88f01bbc096ab4174284f25d12fdfe.json"
    },
    {
      "id": "guwen-477",
      "category": "古文",
      "title": "围炉夜话·第一七八则",
      "subtitle": "",
      "author": "王永彬",
      "dynasty": "清",
      "content": "待人宜宽，惟待子孙不可宽；行礼宜厚，惟行嫁娶不必厚。",
      "excerptOf": "围炉夜话",
      "excerptNote": "完整选录《围炉夜话》中“第一七八则”一则或一章；非全书。",
      "inputHash": "b560642c6171183fbabbe7022450c5390bbf43b06c48243c238e850cab24cada",
      "estimatedOutput": 678,
      "resultPath": "expansion/working/v2/results/guwen-477--b560642c6171183fbabbe7022450c5390bbf43b06c48243c238e850cab24cada.json"
    },
    {
      "id": "guwen-478",
      "category": "古文",
      "title": "围炉夜话·第一七九则",
      "subtitle": "",
      "author": "王永彬",
      "dynasty": "清",
      "content": "事但观其已然，便可知其未然；人必尽其当然，乃可听其自然。",
      "excerptOf": "围炉夜话",
      "excerptNote": "完整选录《围炉夜话》中“第一七九则”一则或一章；非全书。",
      "inputHash": "0e489e68a8371067a456df1b209c7f061db1f3a9ee80991b71b5aa76b4fed769",
