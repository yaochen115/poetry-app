    },
    {
      "id": "tang-407",
      "category": "唐诗",
      "title": "夜归鹿门山歌",
      "subtitle": "",
      "author": "孟浩然",
      "dynasty": "唐",
      "content": "山寺钟鸣昼已昏，渔梁渡头争渡喧。\n人随沙岸向江村，余亦乘舟归鹿门。\n鹿门月照开烟树，忽到庞公栖隐处。\n岩扉松径长寂寥，惟有幽人自来去。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "91092b98a721595dd9f0ebe607e1a7cc01e3248fba9df0bd9e65e17f84f853c4",
      "estimatedOutput": 734,
      "resultPath": "expansion/working/v2/results/tang-407--91092b98a721595dd9f0ebe607e1a7cc01e3248fba9df0bd9e65e17f84f853c4.json"
    },
    {
      "id": "tang-408",
      "category": "唐诗",
      "title": "春怨",
      "subtitle": "",
      "author": "金昌绪",
      "dynasty": "唐",
      "content": "打起黄莺儿，莫教枝上啼。\n啼时惊妾梦，不得到辽西。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "843adbd1cc6f39f7d3e585dc25f6fc4e825474ac09cd554a6baefc76c0a425c6",
      "estimatedOutput": 650,
      "resultPath": "expansion/working/v2/results/tang-408--843adbd1cc6f39f7d3e585dc25f6fc4e825474ac09cd554a6baefc76c0a425c6.json"
    },
    {
      "id": "tang-409",
      "category": "唐诗",
      "title": "越中览古",
      "subtitle": "",
      "author": "李白",
      "dynasty": "唐",
      "content": "越王勾践破吴归，义士还乡尽锦衣。\n宫女如花满春殿，只今惟有鹧鸪飞。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "213031f24bebddd94bfffd0f8718eb2eacca08289c1afb34a2e37f1a17dc4a92",
      "estimatedOutput": 666,
      "resultPath": "expansion/working/v2/results/tang-409--213031f24bebddd94bfffd0f8718eb2eacca08289c1afb34a2e37f1a17dc4a92.json"
    },
    {
      "id": "tang-410",
      "category": "唐诗",
      "title": "百忧集行",
      "subtitle": "",
      "author": "杜甫",
      "dynasty": "唐",
      "content": "忆年十五心尚孩，健如黄犊走复来。\n庭前八月梨枣熟，一日上树能千回。\n即今倏忽已五十，坐卧只多少行立。\n强将笑语供主人，悲见生涯百忧集。\n入门依旧四壁空，老妻睹我颜色同。\n痴儿不知父子礼，叫怒索饭啼门东。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "4b69b262ee22568d2952cdd53cce48098615b656204d6e06eb417eca7e166b6c",
      "estimatedOutput": 802,
      "resultPath": "expansion/working/v2/results/tang-410--4b69b262ee22568d2952cdd53cce48098615b656204d6e06eb417eca7e166b6c.json"
    },
    {
      "id": "tang-411",
      "category": "唐诗",
      "title": "桃花",
      "subtitle": "",
      "author": "元稹",
      "dynasty": "唐",
      "content": "桃花浅深处，似匀深浅妆。\n春风助肠断，吹落白衣裳。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "99c4dc1f9328d12d78ad0a849cff64956a8fa75ad18216b53dd84980483c3fa0",
      "estimatedOutput": 650,
      "resultPath": "expansion/working/v2/results/tang-411--99c4dc1f9328d12d78ad0a849cff64956a8fa75ad18216b53dd84980483c3fa0.json"
    },
    {
      "id": "tang-412",
      "category": "唐诗",
      "title": "酬乐天咏老见示",
      "subtitle": "",
      "author": "刘禹锡",
      "dynasty": "唐",
      "content": "人谁不顾老，老去有谁怜。\n身瘦带频减，发稀冠自偏。\n废书缘惜眼，多灸为随年。\n经事还谙事，阅人如阅川。\n细思皆幸矣，下此便翛然。\n莫道桑榆晚，为霞尚满天。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "4d9b234bd6ef21ed597b4fd3a5aec2e6a759530845509ba2d17c0e2b299f19a6",
      "estimatedOutput": 754,
      "resultPath": "expansion/working/v2/results/tang-412--4d9b234bd6ef21ed597b4fd3a5aec2e6a759530845509ba2d17c0e2b299f19a6.json"
    },
    {
      "id": "tang-413",
      "category": "唐诗",
      "title": "江上值水如海势聊短述",
      "subtitle": "",
      "author": "杜甫",
      "dynasty": "唐",
      "content": "为人性僻耽佳句，语不惊人死不休。\n老去诗篇浑漫与，春来花鸟莫深愁。\n新添水槛供垂钓，故着浮槎替入舟。\n焉得思如陶谢手，令渠述作与同游。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "6cfb5312690ec12691db85c61da04272d1b0fa8507036d75854d3770e9c68f9d",
      "estimatedOutput": 734,
      "resultPath": "expansion/working/v2/results/tang-413--6cfb5312690ec12691db85c61da04272d1b0fa8507036d75854d3770e9c68f9d.json"
    },
    {
      "id": "tang-414",
      "category": "唐诗",
      "title": "送方外上人",
      "subtitle": "",
      "author": "刘长卿",
      "dynasty": "唐",
      "content": "孤云将野鹤，岂向人间住。\n莫买沃洲山，时人已知处。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "ef22f433bbb5c499ae9648bffc7c34771b0b5337e5354be73052c400fe330d4b",
      "estimatedOutput": 650,
      "resultPath": "expansion/working/v2/results/tang-414--ef22f433bbb5c499ae9648bffc7c34771b0b5337e5354be73052c400fe330d4b.json"
    },
    {
      "id": "tang-415",
      "category": "唐诗",
      "title": "渭川田家",
      "subtitle": "",
      "author": "王维",
      "dynasty": "唐",
      "content": "斜阳照墟落，穷巷牛羊归。\n野老念牧童，倚杖候荆扉。\n雉雊麦苗秀，蚕眠桑叶稀。\n田夫荷锄至，相见语依依。\n即此羡闲逸，怅然吟式微。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "7e111e37bdc19cc9d8455d51b0010296dcec28659ecbdd62f808501504229f53",
      "estimatedOutput": 728,
      "resultPath": "expansion/working/v2/results/tang-415--7e111e37bdc19cc9d8455d51b0010296dcec28659ecbdd62f808501504229f53.json"
    },
    {
      "id": "tang-416",
      "category": "唐诗",
      "title": "夜雨",
      "subtitle": "",
      "author": "白居易",
      "dynasty": "唐",
      "content": "我有所念人，隔在远远乡。\n我有所感事，结在深深肠。\n乡远去不得，无日不瞻望。\n肠深解不得，无夕不思量。\n况此残灯夜，独宿在空堂。\n秋天殊未晓，风雨正苍苍。\n不学头陀法，前心安可忘。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "ac9218b94da9a97f9a767234f56de21d16957aa98b829081a54e180027f91525",
