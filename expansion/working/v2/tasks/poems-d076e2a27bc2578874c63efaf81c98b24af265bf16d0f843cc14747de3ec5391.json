    },
    {
      "id": "song-360",
      "category": "宋词",
      "title": "清平乐",
      "subtitle": "日寒风细",
      "author": "李莱老",
      "dynasty": "宋",
      "content": "日寒风细。庭馆浮花气。白发潘郎吟欲醉。绿暗芜千里。西园南浦东城。一春多少闲情。日暮采苹歌远，梦回唤得愁生。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "aec82a56a4088436bcc9507861e3cff9046e42e72c2245c052c3a3f8119c25cd",
      "estimatedOutput": 706,
      "resultPath": "expansion/working/v2/results/song-360--aec82a56a4088436bcc9507861e3cff9046e42e72c2245c052c3a3f8119c25cd.json"
    },
    {
      "id": "song-361",
      "category": "宋词",
      "title": "青玉案",
      "subtitle": "",
      "author": "王炎",
      "dynasty": "宋",
      "content": "深红数点吹花絮。又燕子、飞来语。远水平芜春欲暮。年年长是，清明时候，故遣人憔悴。\n竹鸡啼罢山村雨。正寥落、无情绪。猛省从前多少事。绿杨堤上，楼台如画，此景今何处。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "bfd818038bd7b429991bd2f8bcc21c117a7515edb0c094e882a3ec9bc600853a",
