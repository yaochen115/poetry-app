    {
      "id": "song-358",
      "category": "宋词",
      "title": "渔家傲",
      "subtitle": "",
      "author": "洪皓",
      "dynasty": "宋",
      "content": "圃蕙庭桐雕大半。西风不借行人便。不用留题明月观。西园宴。颜酡浪说觞无算。\n万斛羁愁推不远。千杯鲁酒何曾见。却羡南宾凫与雁。行不乱。哀鸣直到翻江岸。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "816e8434a5f44e80018eb99e52821d1de42198ff927f2004d8747ee3d2f182ad",
      "estimatedOutput": 746,
      "resultPath": "expansion/working/v2/results/song-358--816e8434a5f44e80018eb99e52821d1de42198ff927f2004d8747ee3d2f182ad.json"
    },
    {
      "id": "song-359",
      "category": "宋词",
      "title": "渔家傲",
      "subtitle": "",
      "author": "晏殊",
      "dynasty": "宋",
      "content": "楚国细腰元自瘦。文君腻脸谁描就。日夜声声催箭漏。昏复昼。红颜岂得长如旧。\n醉折嫩房和蕊嗅。天丝不断清香透。欲傍小阑凝坐久。风满袖。西池月上人归后。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "2f2ceb8498df04e3dff3e80e1f77c6d9cd263062a0e9899ff1c003b7d3d5aaea",
      "estimatedOutput": 746,
