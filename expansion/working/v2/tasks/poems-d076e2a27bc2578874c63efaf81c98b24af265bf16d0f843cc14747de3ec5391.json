    },
    {
      "id": "song-354",
      "category": "宋词",
      "title": "减字木兰花",
      "subtitle": "天涯旧恨",
      "author": "秦观",
      "dynasty": "宋",
      "content": "天涯旧恨，独自凄凉人不问。欲见回肠，断尽金炉小篆香。\n黛蛾长敛，任是春风吹不展。困倚危楼，过尽飞鸿字字愁。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "7c25f6656c621c4617158c0dee6355341615282948e0cfef5840e5273e13f838",
