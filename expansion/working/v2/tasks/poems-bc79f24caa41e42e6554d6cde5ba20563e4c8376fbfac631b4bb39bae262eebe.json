    },
    {
      "id": "song-185",
      "category": "宋词",
      "title": "诉衷情",
      "subtitle": "夜来沉醉卸妆迟",
      "author": "李清照",
      "dynasty": "宋",
      "content": "夜来沉醉卸妆迟，梅萼插残枝。酒醒熏破春睡，梦远不成归。\n人悄悄，月依依，翠帘垂。更挼残蕊，更捻余香，更得些时。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "bf06b28c00fc103d0ffe84d7aebe97eb7635fcb995a863897c85d1b4693b5c0a",
      "estimatedOutput": 710,
      "resultPath": "expansion/working/v2/results/song-185--bf06b28c00fc103d0ffe84d7aebe97eb7635fcb995a863897c85d1b4693b5c0a.json"
    },
    {
      "id": "song-186",
      "category": "宋词",
      "title": "踏莎行",
      "subtitle": "候馆梅残",
      "author": "欧阳修",
      "dynasty": "宋",
      "content": "候馆梅残，溪桥柳细。草薰风暖摇征辔。离愁渐远渐无穷，迢迢不断如春水。\n寸寸柔肠，盈盈粉泪。楼高莫近危阑倚。平芜尽处是春山，行人更在春山外。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "26f24edf440faf3f7ec7cb08aa6bec86129251a514d1b9f89846a036fea95bba",
      "estimatedOutput": 738,
      "resultPath": "expansion/working/v2/results/song-186--26f24edf440faf3f7ec7cb08aa6bec86129251a514d1b9f89846a036fea95bba.json"
    },
    {
      "id": "song-187",
      "category": "宋词",
      "title": "鹧鸪天",
      "subtitle": "雪照山城玉指寒",
      "author": "刘著",
      "dynasty": "宋",
      "content": "雪照山城玉指寒，一声羌管怨楼间。江南几度梅花发，人在天涯鬓已斑。\n星点点，月团团。倒流河汉入杯盘。翰林风月三千首，寄与吴姬忍泪看。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "492634d2181e97209c4da6f55c30d2a9c9237879713cd435dd0de7f92c4406f9",
