      "resultPath": "expansion/working/v2/results/song-187--492634d2181e97209c4da6f55c30d2a9c9237879713cd435dd0de7f92c4406f9.json"
    },
    {
      "id": "song-188",
      "category": "宋词",
      "title": "少年游",
      "subtitle": "离多最是",
      "author": "晏几道",
      "dynasty": "宋",
      "content": "离多最是，东西流水，终解两相逢。\n浅情终似，行云无定，犹到梦魂中。\n可怜人意，薄于云水，佳会更难重。\n细想从来，断肠多处，不与今番同。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "53b2515c826383641ab23648107397d900c76c37bfcf8dd94f60e463e8c28ecf",
      "estimatedOutput": 734,
      "resultPath": "expansion/working/v2/results/song-188--53b2515c826383641ab23648107397d900c76c37bfcf8dd94f60e463e8c28ecf.json"
    },
    {
      "id": "song-189",
      "category": "宋词",
      "title": "破阵子",
      "subtitle": "掷地刘郎玉斗",
      "author": "辛弃疾",
      "dynasty": "宋",
      "content": "为范南伯寿。时南伯为张南轩辟宰泸溪，南伯迟迟未行。因作此词以勉之。\n掷地刘郎玉斗，挂帆西子扁舟。千古风流今在此，万里功名莫放休。君王三百州。\n燕雀岂知鸿鹄，貂蝉元出兜鍪。却笑泸溪如斗大，肯把牛刀试手不？寿君双玉瓯。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "879e5b22e2f04eabfb8f59fccfd6c63060b18293c68d13ad665130cac15af3b7",
      "estimatedOutput": 814,
      "resultPath": "expansion/working/v2/results/song-189--879e5b22e2f04eabfb8f59fccfd6c63060b18293c68d13ad665130cac15af3b7.json"
    },
    {
      "id": "song-190",
      "category": "宋词",
      "title": "贺新郎",
      "subtitle": "甚矣吾衰矣",
      "author": "辛弃疾",
      "dynasty": "宋",
      "content": "邑中园亭，仆皆为赋此词。一日，独坐停云，水声山色，竞来相娱。意溪山欲援例者，遂作数语，庶几仿佛渊明思亲友之意云。\n甚矣吾衰矣。怅平生、交游零落，只今馀几！白发空垂三千丈，一笑人间万事。问何物、能令公喜？我见青山多妩媚，料青山见我应如是。情与貌，略相似。\n一尊搔首东窗里。想渊明《停云》诗就，此时风味。江左沉酣求名者，岂识浊醪妙理。回首叫、云飞风起。不恨古人吾不见，恨古人不见吾狂耳。知我者，二三子。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "6ac6780700dbd7920d58d8885947d5bb23e746cbfcf36b9bc63836671021daff",
      "estimatedOutput": 998,
      "resultPath": "expansion/working/v2/results/song-190--6ac6780700dbd7920d58d8885947d5bb23e746cbfcf36b9bc63836671021daff.json"
    },
    {
      "id": "song-191",
      "category": "宋词",
      "title": "天仙子",
      "subtitle": "水调数声持酒听",
      "author": "张先",
      "dynasty": "宋",
      "content": "水调数声持酒听，午醉醒来愁未醒。送春春去几时回？临晚镜，伤流景，往事后期空记省。\n沙上并禽池上暝，云破月来花弄影。重重帘幕密遮灯，风不定，人初静，明日落红应满径。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "83ece24217c2b809977c49eed43ff7db67a0f740b446eac47ac28c85b848ec8b",
      "estimatedOutput": 762,
      "resultPath": "expansion/working/v2/results/song-191--83ece24217c2b809977c49eed43ff7db67a0f740b446eac47ac28c85b848ec8b.json"
    },
    {
      "id": "song-192",
      "category": "宋词",
      "title": "临江仙",
      "subtitle": "夜登小阁忆洛中旧游",
      "author": "陈与义",
      "dynasty": "宋",
      "content": "忆昔午桥桥上饮，坐中多是豪英。长沟流月去无声。杏花疏影里，吹笛到天明。\n二十余年如一梦，此身虽在堪惊。闲登小阁看新晴。古今多少事，渔唱起三更。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "2fa7f7489e18cf9fcf6f1b0cf562c100cbf8b2caa571914a29dcf727a07003c6",
      "estimatedOutput": 742,
      "resultPath": "expansion/working/v2/results/song-192--2fa7f7489e18cf9fcf6f1b0cf562c100cbf8b2caa571914a29dcf727a07003c6.json"
    },
    {
      "id": "song-193",
      "category": "宋词",
      "title": "水调歌头",
      "subtitle": "送章德茂大卿使虏",
      "author": "陈亮",
      "dynasty": "宋",
      "content": "不见南师久，漫说北群空。当场只手，毕竟还我万夫雄。自笑堂堂汉使，得似洋洋河水，依旧只流东？且复穹庐拜，会向藁街逢！\n尧之都，舜之壤，禹之封。于中应有，一个半个耻臣戎！万里腥膻如许，千古英灵安在，磅礴几时通？胡运何须问，赫日自当中！",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "bd48792aaad9694cf1b20b8e8917935054d82020acb7f3edda3eaeb5faf77100",
