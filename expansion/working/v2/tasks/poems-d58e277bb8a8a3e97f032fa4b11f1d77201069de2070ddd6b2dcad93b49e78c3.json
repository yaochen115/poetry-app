    },
    {
      "id": "song-1024",
      "category": "宋词",
      "title": "诉衷情",
      "subtitle": "凭觞静忆去年秋",
      "author": "晏几道",
      "dynasty": "宋",
      "content": "凭觞静忆去年秋，桐落故溪头。\n诗成自写红叶，和恨寄东流。\n人脉脉，水悠悠。\n几多愁。\n雁书不到，蝶梦无凭，漫倚高楼。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "1a6c31a610fb2f90b0b02d5cc55b6da4e6d031c83aac871157258a3f7d2ceb44",
      "estimatedOutput": 716,
      "resultPath": "expansion/working/v2/results/song-1024--1a6c31a610fb2f90b0b02d5cc55b6da4e6d031c83aac871157258a3f7d2ceb44.json"
    },
    {
      "id": "song-1025",
      "category": "宋词",
      "title": "诉衷情",
      "subtitle": "小梅风韵最妖娆",
      "author": "晏几道",
      "dynasty": "宋",
      "content": "小梅风韵最妖娆。\n开处雪初消。\n南枝欲附春信，长恨陇人遥。\n闲记忆，旧江皋。\n路迢迢。\n暗香浮动，疏影横斜，几处溪桥。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "26e260db5fcca2608dfd47f3873b90f285b00a8c78bc19d12e61a692d7e2abc1",
      "estimatedOutput": 718,
      "resultPath": "expansion/working/v2/results/song-1025--26e260db5fcca2608dfd47f3873b90f285b00a8c78bc19d12e61a692d7e2abc1.json"
    },
    {
      "id": "song-1026",
      "category": "宋词",
      "title": "诉衷情",
      "subtitle": "长因蕙草记罗裙",
      "author": "晏几道",
      "dynasty": "宋",
      "content": "长因蕙草记罗裙。\n绿腰沈水熏。\n阑干曲处人静，曾共倚黄昏。\n风有韵，月无痕。\n暗消魂。\n拟将幽恨，试写残花，寄与朝云。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "3d1ebcb3fdb34822b571e9d37eeccadc05701f3552b41d59752517333149d88c",
      "estimatedOutput": 718,
      "resultPath": "expansion/working/v2/results/song-1026--3d1ebcb3fdb34822b571e9d37eeccadc05701f3552b41d59752517333149d88c.json"
    },
    {
      "id": "song-1027",
      "category": "宋词",
      "title": "诉衷情",
      "subtitle": "御纱新制石榴裙",
      "author": "晏几道",
      "dynasty": "宋",
      "content": "御纱新制石榴裙。\n沈香慢火熏。\n越罗双带宫样，飞鹭碧波纹。\n随锦字，叠香痕。\n寄文君。\n系来花下，解向尊前，谁伴朝云。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "7dd51a9ec9a8015057ea98b86b969e97b0b38075efa2a43bab9ed12ca99f62f2",
      "estimatedOutput": 718,
      "resultPath": "expansion/working/v2/results/song-1027--7dd51a9ec9a8015057ea98b86b969e97b0b38075efa2a43bab9ed12ca99f62f2.json"
    },
    {
      "id": "song-1028",
      "category": "宋词",
      "title": "诉衷情",
      "subtitle": "都人离恨满歌筵",
      "author": "晏几道",
      "dynasty": "宋",
      "content": "都人离恨满歌筵。\n清唱倚危弦。\n星屏别后千里，更见是何年。\n骢骑稳，绣衣鲜。\n欲朝天。\n北人欢笑，南国悲凉，迎送金鞭。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "d0e6e72f72c3fe7255fed58ddae7fa23fbb087374be26a344a7e3c9d218f3d1a",
      "estimatedOutput": 718,
      "resultPath": "expansion/working/v2/results/song-1028--d0e6e72f72c3fe7255fed58ddae7fa23fbb087374be26a344a7e3c9d218f3d1a.json"
    },
    {
      "id": "song-1029",
      "category": "宋词",
      "title": "破阵子",
      "subtitle": "柳下笙歌庭院花",
      "author": "晏几道",
      "dynasty": "宋",
      "content": "柳下笙歌庭院，花间姊妹秋千。\n记得春楼当日事，写向红窗夜月前。\n凭谁寄小莲。\n绛蜡等闲陪泪，吴蚕到了缠绵。\n绿鬓能供多少恨，未肯无情比断弦。\n今年老去年。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "044c1ceb183ae56b24b7260a64369eb02de68de2e0ded1c057ca36346e1b6c88",
      "estimatedOutput": 754,
      "resultPath": "expansion/working/v2/results/song-1029--044c1ceb183ae56b24b7260a64369eb02de68de2e0ded1c057ca36346e1b6c88.json"
    },
    {
      "id": "song-1030",
      "category": "宋词",
      "title": "点绛唇",
      "subtitle": "明日征鞭又将南",
      "author": "晏几道",
      "dynasty": "宋",
      "content": "明日征鞭，又将南陌垂杨折。\n自怜轻别。\n拼得音尘绝。\n杏子枝边，倚处阑干月。\n依前缺。\n去年时节。\n旧事无人说。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "281f4203b1e280f782afe4225a64f1ad44d28bf0d90a7794f5cc3670ae3e7013",
      "estimatedOutput": 712,
      "resultPath": "expansion/working/v2/results/song-1030--281f4203b1e280f782afe4225a64f1ad44d28bf0d90a7794f5cc3670ae3e7013.json"
    },
    {
      "id": "song-1031",
      "category": "宋词",
      "title": "点绛唇",
      "subtitle": "碧水东流漫题凉",
      "author": "晏几道",
      "dynasty": "宋",
      "content": "碧水东流，漫题凉叶津头寄。\n谢娘春意。\n临水颦双翠。\n日日骊歌，空费行人泪。\n成何计。\n未如浓醉。\n闲掩红楼睡。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "0c5969c56f8c38172d8b85ebdbd636f0633f1d88eb756a50d53edb558320025e",
      "estimatedOutput": 712,
      "resultPath": "expansion/working/v2/results/song-1031--0c5969c56f8c38172d8b85ebdbd636f0633f1d88eb756a50d53edb558320025e.json"
    },
    {
      "id": "song-1032",
      "category": "宋词",
      "title": "点绛唇",
      "subtitle": "妆席相逢旋匀红",
      "author": "晏几道",
      "dynasty": "宋",
      "content": "妆席相逢，旋匀红泪歌金缕。\n意中曾许。\n欲共吹花去。\n长爱荷香，柳色殷桥路。\n留人住。\n淡烟微雨。\n好个双栖处。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "c630ccdf8b5dbfc83027b55530488bce9da99bf3e859094599694dd4c51fe82e",
      "estimatedOutput": 712,
      "resultPath": "expansion/working/v2/results/song-1032--c630ccdf8b5dbfc83027b55530488bce9da99bf3e859094599694dd4c51fe82e.json"
    },
    {
      "id": "song-1033",
      "category": "宋词",
      "title": "点绛唇",
      "subtitle": "湖上西风露花啼",
      "author": "晏几道",
      "dynasty": "宋",
      "content": "湖上西风，露花啼处秋香老。\n谢家春草。\n唱得清商好。\n笑倚兰舟，转尽新声了。\n烟波渺。\n暮云稀少。\n一点凉蟾小。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "c1d4aac33a8a951e2ba6d14ec4ca7b05289acb6bd335c640b9f4def3ea57aeb4",
