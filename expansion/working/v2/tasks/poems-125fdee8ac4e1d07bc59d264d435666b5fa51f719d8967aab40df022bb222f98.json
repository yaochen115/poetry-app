    },
    {
      "id": "song-891",
      "category": "宋词",
      "title": "减字木兰花",
      "subtitle": "人生可意祗说功",
      "author": "韦骧",
      "dynasty": "宋",
      "content": "人生可意。\n祗说功名贪富贵。\n遇景开怀。\n且尽生前有限杯。\n韶华几许。\n鹈鴂声残无觅处。\n莫自因循。\n一片花飞减却春。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "edac356641947542605993d7e13c43d984d4b4f5d8bfb2e8f533f0e109c2d4d9",
      "estimatedOutput": 718,
      "resultPath": "expansion/working/v2/results/song-891--edac356641947542605993d7e13c43d984d4b4f5d8bfb2e8f533f0e109c2d4d9.json"
    },
    {
      "id": "song-892",
      "category": "宋词",
      "title": "减字木兰花",
      "subtitle": "金貂贳酒乐事可",
      "author": "韦骧",
      "dynasty": "宋",
      "content": "金貂贳酒。\n乐事可为须趁手。\n且醉青春。\n白发何曾饶贵人。\n凤笙鼍鼓。\n况是桃花落红雨。\n莫诉觥筹。\n炊熟黄粱一梦休。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "4381985967f1cd11b116bcd099bfb9ca29c8f7c6e1dd6a2671876820895009c8",
      "estimatedOutput": 718,
      "resultPath": "expansion/working/v2/results/song-892--4381985967f1cd11b116bcd099bfb9ca29c8f7c6e1dd6a2671876820895009c8.json"
    },
    {
      "id": "song-893",
      "category": "宋词",
      "title": "减字木兰花",
      "subtitle": "鸾坡凤沼轩冕傥",
      "author": "韦骧",
      "dynasty": "宋",
      "content": "鸾坡凤沼。\n轩冕傥来何足道。\n存养天真。\n安用浮名绊此身。\n劳生逸老。\n摆脱纷华须是早。\n解绶眠云。\n林下何曾见一人。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "da6a7d9fd7824d89a5a6e869af63833b2d7e94cae9272c7e58477124c97a6de0",
      "estimatedOutput": 718,
      "resultPath": "expansion/working/v2/results/song-893--da6a7d9fd7824d89a5a6e869af63833b2d7e94cae9272c7e58477124c97a6de0.json"
    },
    {
      "id": "song-894",
      "category": "宋词",
      "title": "减字木兰花",
      "subtitle": "危楼引望天气犹",
      "author": "韦骧",
      "dynasty": "宋",
      "content": "危楼引望。\n天气犹寒花未放。\n远思悠悠。\n芳草何年恨即休。\n仙踪何处。\n此去蓬山多少路。\n春霭腾腾。\n更在瑶台十二层。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "b7cc9509fa707292419a3446f6b7a974b31e1e43a9d11c4470b6e653f194bb0d",
      "estimatedOutput": 718,
      "resultPath": "expansion/working/v2/results/song-894--b7cc9509fa707292419a3446f6b7a974b31e1e43a9d11c4470b6e653f194bb0d.json"
    },
    {
      "id": "song-895",
      "category": "宋词",
      "title": "减字木兰花",
      "subtitle": "帝城春媚绿柳参",
      "author": "韦骧",
      "dynasty": "宋",
      "content": "帝城春媚。\n绿柳参天花照地。\n共乐升平。\n处处楼台歌板声。\n香轮玉镫。\n驰骤芳郊争选胜。\n妙舞轻讴。\n扰乱春风卒未休。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "a19ccd75d6f2ba9d8860a99f3614f9fb51140f9a94b484c2cf26d11157fe5f92",
      "estimatedOutput": 718,
      "resultPath": "expansion/working/v2/results/song-895--a19ccd75d6f2ba9d8860a99f3614f9fb51140f9a94b484c2cf26d11157fe5f92.json"
    },
    {
      "id": "song-896",
      "category": "宋词",
      "title": "菩萨蛮",
      "subtitle": "琼杯且尽清歌送",
      "author": "韦骧",
      "dynasty": "宋",
      "content": "琼杯且尽清歌送。\n人生离合真如梦。\n瞬息又春归。\n回头光景非。\n香喷金兽暖。\n欢意愁更短。\n白发不须量。\n从教千丈长。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "7ab1ce6a380b022020d5a629b9f35561d5ad56628577e10f59cb681eca8054c7",
      "estimatedOutput": 718,
      "resultPath": "expansion/working/v2/results/song-896--7ab1ce6a380b022020d5a629b9f35561d5ad56628577e10f59cb681eca8054c7.json"
    },
    {
      "id": "song-897",
      "category": "宋词",
      "title": "鹊桥仙",
      "subtitle": "岁华将暮寒林萧",
      "author": "韦骧",
      "dynasty": "宋",
      "content": "岁华将暮，寒林萧索，极目冻云垂地。\n官梅忽见一枝芳，便顿觉、新春情味。\n小筵开处，歌喉清婉，舞态蹁跹争媚。\n沈腰潘鬓两休论，共举白、何须惜醉。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "1d58862490fed04f0a30ebe63d2ed96c22797a8751d5ed341c93b89e9c12072e",
      "estimatedOutput": 742,
      "resultPath": "expansion/working/v2/results/song-897--1d58862490fed04f0a30ebe63d2ed96c22797a8751d5ed341c93b89e9c12072e.json"
    },
    {
      "id": "song-898",
      "category": "宋词",
      "title": "减字木兰花",
      "subtitle": "雕阑香砌红紫妖",
      "author": "韦骧",
      "dynasty": "宋",
      "content": "雕阑香砌。\n红紫妖韶何足计。\n争似幽芳。\n几朵先春蘸碧塘。\n玉盘金盏。\n谁谓花神情有限。\n绰约仙姿。\n仿佛江皋解佩时。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "a26d04ee4a173f3374aca5875570397b977fc866bfedadd454d7db9efe0085fd",
      "estimatedOutput": 718,
      "resultPath": "expansion/working/v2/results/song-898--a26d04ee4a173f3374aca5875570397b977fc866bfedadd454d7db9efe0085fd.json"
    },
    {
      "id": "song-899",
      "category": "宋词",
      "title": "沁园春",
      "subtitle": "林叶阴浓海云峰",
      "author": "韦骧",
      "dynasty": "宋",
      "content": "林叶阴浓，海云峰耸，夏景渐分。\n称画堂开宴，雍雍笑语，高年耆德，初弄君恩。\n汉相家声，一经传训，赏典今朝归庆门。\n清和昼，见香飘百和，乐按长春。\n休论。\n万事纷纭。\n算寿考、乡闾能几人。\n况凤书才降，龟龄正永，莫辞金盏，一醉醺醺。\n萱草忘忧，榴花含笑，庭院风光如再新。\n成欢颂，愿齐坚桧柏，频奉丝纶。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "4d881af34cf761cf3174fb4748df6e021524518271ae9be701755cda337142c4",
      "estimatedOutput": 900,
      "resultPath": "expansion/working/v2/results/song-899--4d881af34cf761cf3174fb4748df6e021524518271ae9be701755cda337142c4.json"
    },
    {
      "id": "song-900",
      "category": "宋词",
      "title": "渔家傲",
      "subtitle": "本是潇湘一钓客",
      "author": "圆禅师",
      "dynasty": "宋",
      "content": "本是潇湘一钓客。\n自东自西自南北。\n只把孤舟为屋宅。\n无宽窄。\n幕天席地人难测。\n顷闻四海停戈革。\n金门懒去投书册。\n时向滩头歌月白。\n真高格。\n浮名浮利谁拘得。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "cb82550dff8c9a7886b1fbde17972a3e54af9accb1ad0d162ae885e83f03da09",
      "estimatedOutput": 762,
      "resultPath": "expansion/working/v2/results/song-900--cb82550dff8c9a7886b1fbde17972a3e54af9accb1ad0d162ae885e83f03da09.json"
    },
    {
      "id": "song-901",
      "category": "宋词",
      "title": "满庭芳",
      "subtitle": "咄这牛儿身强力",
      "author": "则禅师",
      "dynasty": "宋",
      "content": "咄这牛儿，身强力健，几人能解牵骑。\n为贪原上，嫩草绿离离。\n只管寻芳逐翠，奔驰后、不顾倾危。\n争知道，山遥水远，回首到家迟。\n牧童，今有智，长绳牢把，短杖高提。\n入泥入水，终是不生疲。\n直待心调步稳，青松下、孤笛横吹。\n当归去，人牛不见，正是月明时。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "f0aaa8744afac6790556ea3e9f6308f1ec72d7cf073cee8914cab7467dbf5335",
