    },
    {
      "id": "yuan-135",
      "category": "元曲",
      "title": "红绣鞋",
      "subtitle": "秋望",
      "author": "张可久",
      "dynasty": "元",
      "content": "一两字天边白雁，百千重楼外青山，别君容易寄书难。柳依依花可可，云淡淡月弯弯，长安迷望眼。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "f61e3a2da16de51cd1fa0c91ff4a03d08684d32cbfe30522185c23efa743463d",
      "estimatedOutput": 688,
      "resultPath": "expansion/working/v2/results/yuan-135--f61e3a2da16de51cd1fa0c91ff4a03d08684d32cbfe30522185c23efa743463d.json"
    },
    {
      "id": "yuan-136",
      "category": "元曲",
      "title": "大德歌",
      "subtitle": "冬",
      "author": "关汉卿",
      "dynasty": "元",
      "content": "雪粉华，舞梨花，再不见烟村四五家。密洒堪图画，看疏林噪晚鸦。\n黄芦掩映清江下，斜缆着钓鱼艖。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "7fba35cfcaec29dc1a6044b3c3bf628c1abdee0e15e0f20b9910e40bae92ce42",
      "estimatedOutput": 692,
      "resultPath": "expansion/working/v2/results/yuan-136--7fba35cfcaec29dc1a6044b3c3bf628c1abdee0e15e0f20b9910e40bae92ce42.json"
    },
    {
      "id": "yuan-137",
      "category": "元曲",
      "title": "一半儿",
      "subtitle": "题情",
      "author": "关汉卿",
      "dynasty": "元",
      "content": "银台灯灭篆烟残，独入罗帏淹泪眼。乍孤眠好教人情兴懒。\n薄设设被儿单，一半儿温和一半儿寒。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "9d191004524261c10ff5388e50503002fd2c045b3336802f5064317e1e845c27",
      "estimatedOutput": 688,
      "resultPath": "expansion/working/v2/results/yuan-137--9d191004524261c10ff5388e50503002fd2c045b3336802f5064317e1e845c27.json"
    },
    {
      "id": "yuan-138",
      "category": "元曲",
      "title": "沉醉东风",
      "subtitle": "信笔",
      "author": "任昱",
      "dynasty": "元",
      "content": "有待江山信美，无情岁月相催。东里来，西邻醉，听渔樵讲些兴废。依旧中原一布衣，更休想麒麟画里。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "e40d41420c307583fa31b0d20db47737df2ad1a224319a556ff0243a581a857e",
      "estimatedOutput": 692,
      "resultPath": "expansion/working/v2/results/yuan-138--e40d41420c307583fa31b0d20db47737df2ad1a224319a556ff0243a581a857e.json"
    },
    {
      "id": "yuan-139",
      "category": "元曲",
      "title": "醉中天",
      "subtitle": "佳人脸上黑痣",
      "author": "白朴",
      "dynasty": "元",
      "content": "疑是杨妃在，怎脱马嵬灾？曾与明皇捧砚来，美脸风流杀。\n叵奈挥毫李白，觑着娇态，洒松烟点破桃腮。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "d9deaa948d14c5d46b5161b320b2e3d4ed4c5d259c1a2ad30a527649dc0a53d7",
      "estimatedOutput": 694,
      "resultPath": "expansion/working/v2/results/yuan-139--d9deaa948d14c5d46b5161b320b2e3d4ed4c5d259c1a2ad30a527649dc0a53d7.json"
    },
    {
      "id": "yuan-140",
      "category": "元曲",
      "title": "沉醉东风",
      "subtitle": "夜月青楼凤箫",
      "author": "关汉卿",
      "dynasty": "元",
      "content": "夜月青楼凤箫，春风翠髻金翘。雨云浓，心肠俏，俊庞儿玉软香娇。\n六幅湘裙一搦腰，间别来十分瘦了。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "de0b7b68ef13f2d346998f5dc152cc682c9f992585679e09c183714c31d5a228",
      "estimatedOutput": 694,
      "resultPath": "expansion/working/v2/results/yuan-140--de0b7b68ef13f2d346998f5dc152cc682c9f992585679e09c183714c31d5a228.json"
    },
    {
      "id": "yuan-141",
      "category": "元曲",
      "title": "四块玉",
      "subtitle": "美貌娘",
      "author": "马致远",
      "dynasty": "元",
      "content": "美貌娘，名家子，自驾着个私奔车儿。汉相如便做文章士，爱他那一操儿琴，共他那两句儿诗。\n也有改嫁时。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "30dbcf0e66f4216aeb01b72370a6ffa867564737051884cdcb113ae2395d0808",
      "estimatedOutput": 698,
      "resultPath": "expansion/working/v2/results/yuan-141--30dbcf0e66f4216aeb01b72370a6ffa867564737051884cdcb113ae2395d0808.json"
    },
    {
      "id": "yuan-142",
      "category": "元曲",
      "title": "大德歌",
      "subtitle": "夏",
      "author": "关汉卿",
      "dynasty": "元",
      "content": "俏冤家，在天涯，偏那里绿杨堪系马。困坐南窗下，数对清风想念他。蛾眉淡了教谁画？瘦岩岩羞戴石榴花。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "c8f57e1cbd1b1ae05be7ab34734a8131168aa1ddad69ad3a01e3350b71104eb2",
      "estimatedOutput": 696,
      "resultPath": "expansion/working/v2/results/yuan-142--c8f57e1cbd1b1ae05be7ab34734a8131168aa1ddad69ad3a01e3350b71104eb2.json"
    },
    {
      "id": "yuan-143",
      "category": "元曲",
      "title": "大德歌",
      "subtitle": "谢家村",
      "author": "关汉卿",
      "dynasty": "元",
      "content": "谢家村，赏芳春，疑怪他桃花冷笑人。着谁传芳信，强题诗也断魂。\n花阴下等待无人问，则听得黄犬吠柴门。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "ffe1c93b4f05233820fd85f0f256e3f7c161f7d7157aa47414bd4a6a7d59880a",
      "estimatedOutput": 698,
      "resultPath": "expansion/working/v2/results/yuan-143--ffe1c93b4f05233820fd85f0f256e3f7c161f7d7157aa47414bd4a6a7d59880a.json"
    },
    {
      "id": "yuan-144",
      "category": "元曲",
      "title": "小桃红",
      "subtitle": "山林钟鼎未谋身",
      "author": "任昱",
      "dynasty": "元",
      "content": "山林钟鼎未谋身，不觉生秋鬓。汉水秦关古今恨，谩劳神，何须斗大黄金印。渔樵近邻，田园随分。甘作武陵人。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "e1d7115c35322873efc48e89ee4c7f9c5dbd195b37af0ab78dab317f3a24e3b0",
      "estimatedOutput": 700,
      "resultPath": "expansion/working/v2/results/yuan-144--e1d7115c35322873efc48e89ee4c7f9c5dbd195b37af0ab78dab317f3a24e3b0.json"
    },
    {
      "id": "yuan-145",
      "category": "元曲",
      "title": "拨不断",
      "subtitle": "菊花开",
      "author": "马致远",
      "dynasty": "元",
      "content": "菊花开，正归来。伴虎溪僧、鹤林友、龙山客；似杜工部、陶渊明、李太白；\n有洞庭柑、东阳酒、西湖蟹。哎，楚三闾休怪！",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "eac7aa09efc35e30a850d64cd28480dbcbec508df53322c91e6eba24b432e03f",
