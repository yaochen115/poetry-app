    {
      "id": "song-819",
      "category": "宋词",
      "title": "鹊桥仙",
      "subtitle": "日长天气深深庭",
      "author": "杜安世",
      "dynasty": "宋",
      "content": "日长天气，深深庭院，又是春愁滋味。\n池边昨夜雨兼风，战红杏、馀香乱坠。\n阴阴亭榭，暖烟轻柳，万缕黄金窣地。\n一双新燕却重来，但暗把、罗巾掩泪。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "b198f561261342be49cd243516c32534c70d9479be727dd9d24aa6b4ec6ba512",
      "estimatedOutput": 742,
      "resultPath": "expansion/working/v2/results/song-819--b198f561261342be49cd243516c32534c70d9479be727dd9d24aa6b4ec6ba512.json"
    },
    {
      "id": "song-820",
      "category": "宋词",
      "title": "虞美人",
      "subtitle": "红颜绿鬓催人老",
      "author": "杜安世",
      "dynasty": "宋",
      "content": "红颜绿鬓催人老。\n世事何时了。\n君心天意与年光。\n春花未遍已秋霜。\n为谁忙。\n樽前正好闲风月。\n莫话生离别。\n直饶终日踏红尘。\n浮名浮利枉劳神。\n更愁萦。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "816389140a1562dc886aeafae5de099d8b2440c955426dba6f6c7df87145de4b",
      "estimatedOutput": 754,
      "resultPath": "expansion/working/v2/results/song-820--816389140a1562dc886aeafae5de099d8b2440c955426dba6f6c7df87145de4b.json"
    },
    {
      "id": "song-821",
      "category": "宋词",
      "title": "虞美人",
      "subtitle": "江亭春晚芳菲尽",
      "author": "杜安世",
      "dynasty": "宋",
      "content": "江亭春晚芳菲尽。\n行色青天近。\n画桥杨柳也多情。\n暗抛飞絮惹前行。\n路尘清。\n彤庭早晚瞻虞舜。\n遥听恩迁峻。\n二年歌宴绮罗人。\n片云疏雨忍漂沦。\n泪沾巾。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "1ad0aa77309c7ca1d243d491443ef93fb59ceb3e13cf45bd09733286eadcf7c4",
      "estimatedOutput": 754,
      "resultPath": "expansion/working/v2/results/song-821--1ad0aa77309c7ca1d243d491443ef93fb59ceb3e13cf45bd09733286eadcf7c4.json"
    },
    {
      "id": "song-822",
      "category": "宋词",
      "title": "虞美人",
      "subtitle": "炉香昼永龙烟白",
      "author": "杜安世",
      "dynasty": "宋",
      "content": "炉香昼永龙烟白。\n风动金鸾额。\n画屏细展小山川。\n睡容初起枕痕圆。\n坠花钿。\n楼高不及烟霄半。\n望尽相思眼。\n艳阳刚爱挫愁天。\n故生芳草碧云连。\n怨王孙。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "3d753f12f592db7def55cc43b904e314f94e730cf49720123566056be16bb2ff",
      "estimatedOutput": 754,
      "resultPath": "expansion/working/v2/results/song-822--3d753f12f592db7def55cc43b904e314f94e730cf49720123566056be16bb2ff.json"
    },
    {
      "id": "song-823",
      "category": "宋词",
      "title": "减字木兰花",
      "subtitle": "绿杨阴下短帽轻",
      "author": "元绛",
      "dynasty": "宋",
      "content": "绿杨阴下。\n短帽轻衫行信马。\n过尽春风。\n踏尽青青打尽红。\n舞鸾歌凤。\n人面湖光红影动。\n醉眼归时。\n人在朱楼曲角西。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "b801de13730a6e0576f2c832849b675b18f7ed9f5da770d8f5ef8b4acf62bc4e",
      "estimatedOutput": 718,
      "resultPath": "expansion/working/v2/results/song-823--b801de13730a6e0576f2c832849b675b18f7ed9f5da770d8f5ef8b4acf62bc4e.json"
    },
    {
      "id": "song-824",
      "category": "宋词",
      "title": "西江月",
      "subtitle": "内药还同外药内",
      "author": "张伯端",
      "dynasty": "宋",
      "content": "内药还同外药，内通外亦须通。\n丹头和合类相同。\n温养两般作用。\n内有天然真火，炉中赫赫长红。\n外炉增减要勤功。\n妙绝无过真种。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "873a5ecee03d3d7d8fef59bcade6b4220ba41a7d7bbc23171fab745603050301",
      "estimatedOutput": 726,
      "resultPath": "expansion/working/v2/results/song-824--873a5ecee03d3d7d8fef59bcade6b4220ba41a7d7bbc23171fab745603050301.json"
    },
    {
      "id": "song-825",
      "category": "宋词",
      "title": "西江月",
      "subtitle": "此道至神至圣忧",
      "author": "张伯端",
      "dynasty": "宋",
      "content": "此道至神至圣，忧君分薄难消。\n调和铅汞不终朝。\n早睹玄珠形兆。\n志士若能修炼，何妨在市居朝。\n工夫容易药非遥。\n说破人须失笑。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "6e2ac74baeb2a88004f11a852b458311e94df7adf70f768f4022a0a37f35f626",
      "estimatedOutput": 726,
      "resultPath": "expansion/working/v2/results/song-825--6e2ac74baeb2a88004f11a852b458311e94df7adf70f768f4022a0a37f35f626.json"
    },
    {
      "id": "song-826",
      "category": "宋词",
      "title": "西江月",
      "subtitle": "白虎首经至宝华",
      "author": "张伯端",
      "dynasty": "宋",
      "content": "白虎首经至宝，华池神水真金。\n故知上善利源深。\n不比寻常药品。\n若要修成九转，先须炼己持心。\n依时采取定浮沈。\n进火须防危甚。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "3d8a21aadc6d8139647e4fbee9e333b25c69f96c671f10c30fefd60590d0acf6",
      "estimatedOutput": 726,
      "resultPath": "expansion/working/v2/results/song-826--3d8a21aadc6d8139647e4fbee9e333b25c69f96c671f10c30fefd60590d0acf6.json"
    },
    {
      "id": "song-827",
      "category": "宋词",
      "title": "西江月",
      "subtitle": "若要真铅留汞亲",
      "author": "张伯端",
      "dynasty": "宋",
      "content": "若要真铅留汞，亲中不离家臣。\n木金间隔会无因。\n须仗媒人勾引。\n本性爱金顺义，金情恋木慈仁。\n相吞相陷却相亲。\n始觉男儿有孕。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "2b0adaf2c44c0ada6238ddc2969ef25b227453f61947d1a396c6091b891a792b",
      "estimatedOutput": 726,
      "resultPath": "expansion/working/v2/results/song-827--2b0adaf2c44c0ada6238ddc2969ef25b227453f61947d1a396c6091b891a792b.json"
    },
    {
      "id": "song-828",
      "category": "宋词",
      "title": "西江月",
      "subtitle": "二八谁家姹女九",
      "author": "张伯端",
      "dynasty": "宋",
      "content": "二八谁家姹女，九三何处郎君。\n自称木液与金精。\n遇土却成三性。\n更假丁公煅炼，夫妻始结欢情。\n河车不敢暂留停。\n运入昆仑峰顶。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "3d112333684783e7276d381884915a9370f0bc302eab3ae2ca1446baf136b65b",
      "estimatedOutput": 726,
      "resultPath": "expansion/working/v2/results/song-828--3d112333684783e7276d381884915a9370f0bc302eab3ae2ca1446baf136b65b.json"
    },
    {
      "id": "song-829",
      "category": "宋词",
      "title": "西江月",
      "subtitle": "七返朱砂反本九",
      "author": "张伯端",
      "dynasty": "宋",
      "content": "七返朱砂反本，九还金液还真。\n休将寅子数坤申。\n但要五行成准。\n本是水银一味，周流遍历诸辰。\n阴阳数足自通神。\n出入岂离玄牝。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "bb086e0c49b7e90e6d97d3a818f1a710b087e656e06929e25dfe5be9895c12dd",
