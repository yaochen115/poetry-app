    {
      "id": "song-590",
      "category": "宋词",
      "title": "渔家傲",
      "subtitle": "粉面啼红腰束素",
      "author": "晏殊",
      "dynasty": "宋",
      "content": "粉面啼红腰束素。\n当年拾翠曾相遇。\n密意深情谁与诉。\n空怨慕。\n西池夜夜风兼露。\n池上夕阳笼碧树。\n池中短棹惊微雨。\n水泛落英何处去。\n人不语。\n东流到了无停住。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "77d2034637cb345d10eb7e40d7d376e78edf888cf6d1ef6828fa83014e2069b0",
      "estimatedOutput": 762,
      "resultPath": "expansion/working/v2/results/song-590--77d2034637cb345d10eb7e40d7d376e78edf888cf6d1ef6828fa83014e2069b0.json"
    },
    {
      "id": "song-591",
      "category": "宋词",
      "title": "渔家傲",
      "subtitle": "幽鹭慢来窥品格",
      "author": "晏殊",
      "dynasty": "宋",
      "content": "幽鹭慢来窥品格。\n双鱼岂解传消息。\n绿柄嫩香频采摘。\n心似织。\n条条不断谁牵役。\n粉泪暗和清露滴。\n罗衣染尽秋江色。\n对面不言情脉脉。\n烟水隔。\n无人说似长相忆。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "1f5d7009394b12784b41afb1c7a905af6930bbbff7f4808e5b891f2b465d35be",
      "estimatedOutput": 762,
      "resultPath": "expansion/working/v2/results/song-591--1f5d7009394b12784b41afb1c7a905af6930bbbff7f4808e5b891f2b465d35be.json"
    },
    {
      "id": "song-592",
      "category": "宋词",
      "title": "渔家傲",
      "subtitle": "嫩绿堪裁红欲绽",
      "author": "晏殊",
      "dynasty": "宋",
      "content": "嫩绿堪裁红欲绽。\n蜻蜓点水鱼游畔。\n一霎雨声香四散。\n风飐乱。\n高低掩映千千万。\n总是凋零终有恨。\n能无眼下生留恋。\n何似折来妆粉面。\n勤看玩。\n胜如落尽秋江岸。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "77345ba48b3ca1a3f332a3667f56d9fd6e5d68e82abe3cc80cb48ecacd07c17d",
      "estimatedOutput": 762,
      "resultPath": "expansion/working/v2/results/song-592--77345ba48b3ca1a3f332a3667f56d9fd6e5d68e82abe3cc80cb48ecacd07c17d.json"
    },
    {
      "id": "song-593",
      "category": "宋词",
      "title": "蝶恋花",
      "subtitle": "一霎秋风惊画扇",
      "author": "晏殊",
      "dynasty": "宋",
      "content": "一霎秋风惊画扇。\n艳粉娇红，尚拆荷花面。\n草际露垂虫响遍。\n珠帘不下留归燕。\n扫掠亭台开小院。\n四坐清欢，莫放金杯浅。\n龟鹤命长松寿远。\n阳春一曲情千万。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "a3a3f5145e838679d5259d210f2f4eaf11ed8146a9743fd53b3916518708c21f",
      "estimatedOutput": 754,
      "resultPath": "expansion/working/v2/results/song-593--a3a3f5145e838679d5259d210f2f4eaf11ed8146a9743fd53b3916518708c21f.json"
    },
    {
      "id": "song-594",
      "category": "宋词",
      "title": "蝶恋花",
      "subtitle": "紫菊初生朱槿坠",
      "author": "晏殊",
      "dynasty": "宋",
      "content": "紫菊初生朱槿坠。\n月好风清，渐有中秋意。\n更漏乍长天似水。\n银屏展尽遥山翠。\n绣幕卷波香引穗。\n急管繁弦，共庆人间瑞。\n满酌玉杯萦舞袂。\n南春祝寿千千岁。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "8e797b00ca55ee964b44dca1447db489bb17db02395a00922f7e77bbcfd66d8e",
      "estimatedOutput": 754,
      "resultPath": "expansion/working/v2/results/song-594--8e797b00ca55ee964b44dca1447db489bb17db02395a00922f7e77bbcfd66d8e.json"
    },
    {
      "id": "song-595",
      "category": "宋词",
      "title": "蝶恋花",
      "subtitle": "帘幕风轻双语燕",
      "author": "晏殊",
      "dynasty": "宋",
      "content": "帘幕风轻双语燕。\n午醉醒来，柳絮飞撩乱。\n心事一春犹未见。\n馀花落尽青苔院。\n百尺朱楼闲倚遍。\n薄雨浓云，抵死遮人面。\n消息未知归早晚。\n斜阳只送平波远。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "fae67f4f7b7e808f22ef3de3d1a01eea8c0f934496d44c42199bb675497ca884",
      "estimatedOutput": 754,
      "resultPath": "expansion/working/v2/results/song-595--fae67f4f7b7e808f22ef3de3d1a01eea8c0f934496d44c42199bb675497ca884.json"
    },
    {
      "id": "song-596",
      "category": "宋词",
      "title": "蝶恋花",
      "subtitle": "玉碗冰寒消暑气",
      "author": "晏殊",
      "dynasty": "宋",
      "content": "玉碗冰寒消暑气。\n碧簟纱厨，向午朦胧睡。\n莺舌惺松如会意。\n无端画扇惊飞起。\n雨后初凉生水际。\n人面荷花，的的遥相似。\n眼看红芳犹抱蕊。\n丛中已结新莲子。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "448f252bb735086d1a490a172576e2a469c93219cc25d54b2a4ab6fde0213805",
      "estimatedOutput": 754,
      "resultPath": "expansion/working/v2/results/song-596--448f252bb735086d1a490a172576e2a469c93219cc25d54b2a4ab6fde0213805.json"
    },
    {
      "id": "song-597",
      "category": "宋词",
      "title": "蝶恋花",
      "subtitle": "南雁依稀回侧阵",
      "author": "晏殊",
      "dynasty": "宋",
      "content": "南雁依稀回侧阵。\n雪霁墙阴，偏觉兰芽嫩。\n中夜梦馀消酒困。\n炉香卷穗灯生晕。\n急景流年都一瞬。\n往事前欢，未免萦方寸。\n腊后花期知渐近。\n寒梅已作东风信。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "02433ef94b49294853694232829d23929e4015a2abdb3914029c576ce84f7f5b",
      "estimatedOutput": 754,
      "resultPath": "expansion/working/v2/results/song-597--02433ef94b49294853694232829d23929e4015a2abdb3914029c576ce84f7f5b.json"
    },
    {
      "id": "song-598",
      "category": "宋词",
      "title": "菩萨蛮",
      "subtitle": "芳莲九蕊开新艳",
      "author": "晏殊",
      "dynasty": "宋",
      "content": "芳莲九蕊开新艳。\n轻红淡白匀双脸。\n一朵近华堂。\n学人宫样妆。\n看时斟美酒。\n共祝千年寿。\n销得曲中夸。\n世间无此花。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "e33fe8caab7767eb29335a644e04f8a0d914b0ea99b36d178e7956db2d176060",
      "estimatedOutput": 718,
      "resultPath": "expansion/working/v2/results/song-598--e33fe8caab7767eb29335a644e04f8a0d914b0ea99b36d178e7956db2d176060.json"
    },
    {
      "id": "song-599",
      "category": "宋词",
      "title": "菩萨蛮",
      "subtitle": "秋花最是黄葵好",
      "author": "晏殊",
      "dynasty": "宋",
      "content": "秋花最是黄葵好。\n天然嫩态迎秋早。\n染得道家衣。\n淡妆梳洗时。\n晓来清露滴。\n一一金杯侧。\n插向绿云鬓。\n便随王母仙。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "8569a6d96610ecdcfc0d2e9fb9f1483f4172d6a223124a4fc7f63c85f4954f23",
      "estimatedOutput": 718,
      "resultPath": "expansion/working/v2/results/song-599--8569a6d96610ecdcfc0d2e9fb9f1483f4172d6a223124a4fc7f63c85f4954f23.json"
    },
    {
      "id": "song-600",
      "category": "宋词",
      "title": "菩萨蛮",
      "subtitle": "人人尽道黄葵淡",
      "author": "晏殊",
      "dynasty": "宋",
      "content": "人人尽道黄葵淡。\n侬家解说黄葵艳。\n可喜万般宜。\n不劳朱粉施。\n摘承金盏酒。\n劝我千长寿。\n擎作女真冠。\n试伊娇面看。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "04dfabc940000acec3b915df0b1f8fe7b9d8d684f5b824040e8afbbe9d583cce",
      "estimatedOutput": 718,
      "resultPath": "expansion/working/v2/results/song-600--04dfabc940000acec3b915df0b1f8fe7b9d8d684f5b824040e8afbbe9d583cce.json"
    },
    {
      "id": "song-601",
      "category": "宋词",
      "title": "菩萨蛮",
      "subtitle": "高梧叶下秋光晚",
      "author": "晏殊",
      "dynasty": "宋",
      "content": "高梧叶下秋光晚。\n珍丛化出黄金盏。\n还似去年时。\n傍阑三两枝。\n人情须耐久。\n花面长依旧。\n莫学蜜蜂儿。\n等闲悠扬飞。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "3591d202a3a41107b252438c342bacfd7c8db38cecd7f2d35b14b2e9a6087ac3",
