    {
      "id": "song-710",
      "category": "宋词",
      "title": "渔家傲",
      "subtitle": "八月微凉生枕簟",
      "author": "欧阳修",
      "dynasty": "宋",
      "content": "八月微凉生枕簟。\n金盘露洗秋光淡。\n池上月华开宝鉴。\n波潋滟。\n故人千里应凭槛。\n蝉树无情风苒苒。\n燕归碧海珠帘揜。\n沈臂冒霜潘鬓减。\n愁黯黯。\n年年此夕多悲感。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "2520f0bd4dcfb7652bf4779e1eaf4fd208ae5fb9ac7dec6dc7164b9c0e0707c5",
      "estimatedOutput": 762,
      "resultPath": "expansion/working/v2/results/song-710--2520f0bd4dcfb7652bf4779e1eaf4fd208ae5fb9ac7dec6dc7164b9c0e0707c5.json"
    },
    {
      "id": "song-711",
      "category": "宋词",
      "title": "渔家傲",
      "subtitle": "九月重阳还又到",
      "author": "欧阳修",
      "dynasty": "宋",
      "content": "九月重阳还又到。\n东篱菊放金钱小。\n月下风前愁不少。\n谁语笑。\n吴娘捣练腰肢袅。\n槁叶半轩慵更扫。\n凭阑岂是闲临眺。\n欲向南云新雁道。\n休草草。\n来时觅取伊消耗。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "75d6fef4aaa9ce915fe4f4333fd1d11363da6dd505e631120a6f48be23f60344",
      "estimatedOutput": 762,
      "resultPath": "expansion/working/v2/results/song-711--75d6fef4aaa9ce915fe4f4333fd1d11363da6dd505e631120a6f48be23f60344.json"
    },
    {
      "id": "song-712",
      "category": "宋词",
      "title": "渔家傲",
      "subtitle": "十月轻寒生晚暮",
      "author": "欧阳修",
      "dynasty": "宋",
      "content": "十月轻寒生晚暮。\n霜华暗卷楼南树。\n十二阑干堪倚处。\n聊一顾。\n乱山衰草还家路。\n悔别情怀多感慕。\n胡笳不管离心苦。\n犹喜清宵长数鼓。\n双绣户。\n梦魂尽远还须去。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "79bf825e0befec7be9a2adcee5bdaba0e34cae985452d7fac8797a63b96f7e75",
      "estimatedOutput": 762,
      "resultPath": "expansion/working/v2/results/song-712--79bf825e0befec7be9a2adcee5bdaba0e34cae985452d7fac8797a63b96f7e75.json"
    },
    {
      "id": "song-713",
      "category": "宋词",
      "title": "渔家傲",
      "subtitle": "律应黄锺寒气苦",
      "author": "欧阳修",
      "dynasty": "宋",
      "content": "律应黄锺寒气苦。\n冰生玉水云如絮。\n千里乡关空倚慕。\n无尺素。\n双鱼不食南鸿渡。\n把酒遣愁愁已去。\n风吹酒力愁还聚。\n却忆兽炉追旧处。\n头懒举。\n炉灰剔尽痕无数。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "8229ca3a9d066c578a780b3eea1dde272e32dc9ca97eb444c6c20aae2198f0e8",
      "estimatedOutput": 762,
      "resultPath": "expansion/working/v2/results/song-713--8229ca3a9d066c578a780b3eea1dde272e32dc9ca97eb444c6c20aae2198f0e8.json"
    },
    {
      "id": "song-714",
      "category": "宋词",
      "title": "渔家傲",
      "subtitle": "腊月年光如激浪",
      "author": "欧阳修",
      "dynasty": "宋",
      "content": "腊月年光如激浪。\n冻云欲折寒根向。\n谢女雪诗真绝唱。\n无比况。\n长堤柳絮飞来往。\n便好开尊夸酒量。\n酒阑莫遣笙歌放。\n此去青春都一饷。\n休怅望。\n瑶林即日堪寻访。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "1c5fab323714a6760d91df6e813574d2c36d6d194e68c20e23264205dcdb728a",
      "estimatedOutput": 762,
      "resultPath": "expansion/working/v2/results/song-714--1c5fab323714a6760d91df6e813574d2c36d6d194e68c20e23264205dcdb728a.json"
    },
    {
      "id": "song-715",
      "category": "宋词",
      "title": "南歌子",
      "subtitle": "凤髻金泥带龙纹",
      "author": "欧阳修",
      "dynasty": "宋",
      "content": "凤髻金泥带，龙纹玉掌梳。\n走来窗下笑相扶。\n爱道画眉深浅、入时无。\n弄笔偎人久，描花试手初。\n等闲妨了绣功夫。\n笑问双鸳鸯字、怎生书。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "9d816ab4473c4f62a1050e6b5ebb2078904fe28aaf80704a1e58cde489e7d140",
      "estimatedOutput": 734,
      "resultPath": "expansion/working/v2/results/song-715--9d816ab4473c4f62a1050e6b5ebb2078904fe28aaf80704a1e58cde489e7d140.json"
    },
    {
      "id": "song-716",
      "category": "宋词",
      "title": "桃源忆故人",
      "subtitle": "梅梢弄粉香犹嫩",
      "author": "欧阳修",
      "dynasty": "宋",
      "content": "梅梢弄粉香犹嫩。\n欲寄江南春信。\n别后寸肠萦损。\n说与伊争稳。\n小炉独守寒灰尽。\n忍泪低头画尽。\n眉上万重新恨。\n竟日无人问。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "4a26d582239060673efa70963b0b33b7fafc79d45087c4de06b3f628d4ea10f5",
      "estimatedOutput": 726,
      "resultPath": "expansion/working/v2/results/song-716--4a26d582239060673efa70963b0b33b7fafc79d45087c4de06b3f628d4ea10f5.json"
    },
    {
      "id": "song-717",
      "category": "宋词",
      "title": "桃源忆故人",
      "subtitle": "莺愁燕苦春归去",
      "author": "欧阳修",
      "dynasty": "宋",
      "content": "莺愁燕苦春归去。\n寂寂花飘红雨。\n碧草绿杨歧路。\n况是长亭暮。\n少年行客情难诉。\n泣对东风无语。\n目断两三烟树。\n翠隔江淹浦。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "8abedb64872817350f9e05389e052b0752108011192307c3fb1fff9cb9241e8f",
      "estimatedOutput": 726,
      "resultPath": "expansion/working/v2/results/song-717--8abedb64872817350f9e05389e052b0752108011192307c3fb1fff9cb9241e8f.json"
    },
    {
      "id": "song-718",
      "category": "宋词",
      "title": "临江仙",
      "subtitle": "柳外轻雷池上雨",
      "author": "欧阳修",
      "dynasty": "宋",
      "content": "柳外轻雷池上雨，雨声滴碎荷声。\n小楼西角断虹明。\n阑干倚处，待得月华生。\n燕子飞来窥画栋，玉钩垂下帘旌。\n凉波不动簟纹平。\n水精双枕，傍有堕钗横。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "2dce00d2c5d28daa6b2f7b046e07d4b78551f77a2c4a4b10be7e4e036f60f98a",
      "estimatedOutput": 746,
      "resultPath": "expansion/working/v2/results/song-718--2dce00d2c5d28daa6b2f7b046e07d4b78551f77a2c4a4b10be7e4e036f60f98a.json"
    },
    {
      "id": "song-719",
      "category": "宋词",
      "title": "浪淘沙",
      "subtitle": "花外倒金翘饮散",
      "author": "欧阳修",
      "dynasty": "宋",
      "content": "花外倒金翘。\n饮散无憀。\n柔桑蔽日柳迷条。\n此地年时会一醉，还是春朝。\n今日举轻桡。\n帆影飘飘。\n长亭回首短亭遥。\n过尽长亭人更远，特地魂销。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "d1a1039a28389218abb2780263af630a3b377c7c333e95f042e79219242a09e7",
      "estimatedOutput": 742,
      "resultPath": "expansion/working/v2/results/song-719--d1a1039a28389218abb2780263af630a3b377c7c333e95f042e79219242a09e7.json"
    },
    {
      "id": "song-720",
      "category": "宋词",
      "title": "浪淘沙",
      "subtitle": "五岭麦秋残荔子",
      "author": "欧阳修",
      "dynasty": "宋",
      "content": "五岭麦秋残。\n荔子初丹。\n绛纱囊里水晶丸。\n可惜天教生处远，不近长安。\n往事忆开元。\n妃子偏怜。\n一从魂散马嵬关。\n只有红尘无驿使，满眼骊山。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "a28fdb94548869e404020df4b4f0b3b4f46b04a854bdc3ec0eba110c13f53e43",
      "estimatedOutput": 742,
      "resultPath": "expansion/working/v2/results/song-720--a28fdb94548869e404020df4b4f0b3b4f46b04a854bdc3ec0eba110c13f53e43.json"
    },
    {
      "id": "song-721",
      "category": "宋词",
      "title": "浪淘沙",
      "subtitle": "万恨苦绵绵旧约",
      "author": "欧阳修",
      "dynasty": "宋",
      "content": "万恨苦绵绵。\n旧约前欢。\n桃花溪畔柳阴间。\n几度日高春垂重，绣户深关。\n楼外夕阳闲。\n独自凭阑。\n一重水隔一重山。\n水阔山高人不见，有泪无言。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "64b381cf61865e3781c6cf16d4ae58766a31d67d722f51bb826fe63563b3af95",
