    {
      "id": "song-135",
      "category": "宋词",
      "title": "长相思",
      "subtitle": "粉艳明秋水盈柳",
      "author": "张先",
      "dynasty": "宋",
      "content": "粉艳明。\n秋水盈。\n柳样纤柔花样轻。\n笑前双靥生。\n寒江平。\n江橹鸣。\n谁道潮沟非远行。\n回头千里情。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "57a4660ac4915a9091b978dc68ead57abf0239e5a6f215246ed8a3b632eb59a6",
      "estimatedOutput": 702,
      "resultPath": "expansion/working/v2/results/song-135--57a4660ac4915a9091b978dc68ead57abf0239e5a6f215246ed8a3b632eb59a6.json"
    },
    {
      "id": "song-136",
      "category": "宋词",
      "title": "长相思",
      "subtitle": "苹满溪柳绕堤相",
      "author": "欧阳修",
      "dynasty": "宋",
      "content": "苹满溪。\n柳绕堤。\n相送行人溪水西。\n回时陇月低。\n烟霏霏。\n风凄凄。\n重倚朱门听马嘶。\n寒鸥相对飞。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "027d8c2d68a368f4d2a8240c50eeed5622e79bdc0c4b9c07ce8971b7b38ff44d",
      "estimatedOutput": 702,
      "resultPath": "expansion/working/v2/results/song-136--027d8c2d68a368f4d2a8240c50eeed5622e79bdc0c4b9c07ce8971b7b38ff44d.json"
    },
    {
      "id": "song-137",
      "category": "宋词",
      "title": "长相思",
      "subtitle": "深花枝浅花枝深",
      "author": "欧阳修",
      "dynasty": "宋",
      "content": "深花枝。\n浅花枝。\n深浅花枝相并时。\n花枝难似伊。\n玉如肌。\n柳如眉。\n爱著鹅黄金缕衣。\n啼妆更为谁。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "eedb2cfc55859a1c39368b3b504e283b3929b16c6d36d4c0f507420343d9be7e",
      "estimatedOutput": 702,
      "resultPath": "expansion/working/v2/results/song-137--eedb2cfc55859a1c39368b3b504e283b3929b16c6d36d4c0f507420343d9be7e.json"
    },
    {
      "id": "song-138",
      "category": "宋词",
      "title": "生查子",
      "subtitle": "当初相见时彼此",
      "author": "张先",
      "dynasty": "宋",
      "content": "当初相见时，彼此心萧洒。\n近日见人来，却恁相谩諕。\n休休休便休，美底教他且。\n匹似没伊时，更不思量也。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "7c1f6a3267b49a71c8f4b30e797a288bf8a29c817c59b07d8425b845784e0f37",
      "estimatedOutput": 702,
      "resultPath": "expansion/working/v2/results/song-138--7c1f6a3267b49a71c8f4b30e797a288bf8a29c817c59b07d8425b845784e0f37.json"
    },
    {
      "id": "song-139",
      "category": "宋词",
      "title": "生查子",
      "subtitle": "含羞整翠鬟得意",
      "author": "欧阳修",
      "dynasty": "宋",
      "content": "含羞整翠鬟，得意频相顾。\n雁柱十三弦，一一春莺语。\n娇云容易飞，梦断知何处。\n深院锁黄昏，阵阵芭蕉雨。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "ba0daa3b721e2ad8d2407d5e71b040a93fe6ead6891a4f58e201fe57ff0c98e4",
      "estimatedOutput": 702,
      "resultPath": "expansion/working/v2/results/song-139--ba0daa3b721e2ad8d2407d5e71b040a93fe6ead6891a4f58e201fe57ff0c98e4.json"
    },
    {
      "id": "song-140",
      "category": "宋词",
      "title": "生查子",
      "subtitle": "金鞭美少年去跃",
      "author": "晏几道",
      "dynasty": "宋",
      "content": "金鞭美少年，去跃青骢马。\n牵系玉楼人，绣被春寒夜。\n消息未归来，寒食梨花谢。\n无处说相思，背面秋千下。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "16a8a374a2d6eff34938a1e026a58d67ac913e3e0e4324e93d47d2c95bc0104b",
      "estimatedOutput": 702,
      "resultPath": "expansion/working/v2/results/song-140--16a8a374a2d6eff34938a1e026a58d67ac913e3e0e4324e93d47d2c95bc0104b.json"
    },
    {
      "id": "song-141",
      "category": "宋词",
      "title": "生查子",
      "subtitle": "轻匀两脸花淡扫",
      "author": "晏几道",
      "dynasty": "宋",
      "content": "轻匀两脸花，淡扫双眉柳。\n会写锦笺时，学弄朱弦后。\n今春玉钏宽，昨夜罗裙皱。\n无计奈情何，且醉金杯酒。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "291e904f94d308f7b169441558d40e56288a26b401d119b1096d813d228c7216",
      "estimatedOutput": 702,
      "resultPath": "expansion/working/v2/results/song-141--291e904f94d308f7b169441558d40e56288a26b401d119b1096d813d228c7216.json"
    },
    {
      "id": "song-142",
      "category": "宋词",
      "title": "生查子",
      "subtitle": "关山魂梦长鱼雁",
      "author": "晏几道",
      "dynasty": "宋",
      "content": "关山魂梦长，鱼雁音尘少。\n两鬓可怜青，只为相思老。\n归梦碧纱窗，说与人人道。\n真个别离难，不似相逢好。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "8c87c0007258ba5be9a7567a7d9dcd59ad18aeb5b6ca04dc8530c2065f4f6e74",
      "estimatedOutput": 702,
      "resultPath": "expansion/working/v2/results/song-142--8c87c0007258ba5be9a7567a7d9dcd59ad18aeb5b6ca04dc8530c2065f4f6e74.json"
    },
    {
      "id": "song-143",
      "category": "宋词",
      "title": "生查子",
      "subtitle": "坠雨已辞云流水",
      "author": "晏几道",
      "dynasty": "宋",
      "content": "坠雨已辞云，流水难归浦。\n遗恨几时休，心抵秋莲苦。\n忍泪不能歌，试托哀弦语。\n弦语愿相逢，知有相逢否。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "8e31581009c37d4f8acefe085629ba40ab67c1f599e3c02ef9e984f6f0ec6390",
      "estimatedOutput": 702,
      "resultPath": "expansion/working/v2/results/song-143--8e31581009c37d4f8acefe085629ba40ab67c1f599e3c02ef9e984f6f0ec6390.json"
    },
    {
      "id": "song-144",
      "category": "宋词",
      "title": "生查子",
      "subtitle": "一分残酒霞两点",
      "author": "晏几道",
      "dynasty": "宋",
      "content": "一分残酒霞，两点愁蛾晕。\n罗幕夜犹寒，玉枕春先困。\n心情翦彩慵，时节烧灯近。\n见少别离多，还有人堪恨。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "46a1e6388bcc182ec2295ae1e87d5feb7ea89f4ef53616f38172fee8cc4ef4e8",
      "estimatedOutput": 702,
      "resultPath": "expansion/working/v2/results/song-144--46a1e6388bcc182ec2295ae1e87d5feb7ea89f4ef53616f38172fee8cc4ef4e8.json"
    },
    {
      "id": "song-145",
      "category": "宋词",
      "title": "生查子",
      "subtitle": "轻轻制舞衣小小",
      "author": "晏几道",
      "dynasty": "宋",
      "content": "轻轻制舞衣，小小裁歌扇。\n三月柳浓时，又向津亭见。\n垂泪送行人，湿破红妆面。\n玉指袖中弹，一曲清商怨。",
      "excerptOf": null,
      "excerptNote": "",
