    {
      "id": "song-123",
      "category": "宋词",
      "title": "阮郎归",
      "subtitle": "南园春半踏青时",
      "author": "欧阳修",
      "dynasty": "宋",
      "content": "南园春半踏青时，风和闻马嘶。青梅如豆柳如眉，日长蝴蝶飞。\n花露重，草烟低，人家帘幕垂。秋千慵困解罗衣，画堂双燕归。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "fd5f6a21e91b4b0073a469ecaf44c929d4e35ace6c60b612f760ac394bbdef1d",
