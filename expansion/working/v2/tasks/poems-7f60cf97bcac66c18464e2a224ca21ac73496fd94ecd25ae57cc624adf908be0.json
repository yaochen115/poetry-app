    },
    {
      "id": "song-125",
      "category": "宋词",
      "title": "忆秦娥",
      "subtitle": "伤离别",
      "author": "何梦桂",
      "dynasty": "宋",
      "content": "伤离别。江南雁断音书绝。音书绝。两行珠泪，寸肠千结。 \n伤心长记中秋节。今年还似前年月。前年月。那知今夜，月圆人缺。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "ea881a9e16f7cb0cb7090a822168fa696f445910bbe47806818c2bed7556b58d",
      "estimatedOutput": 716,
      "resultPath": "expansion/working/v2/results/song-125--ea881a9e16f7cb0cb7090a822168fa696f445910bbe47806818c2bed7556b58d.json"
    },
    {
      "id": "song-126",
      "category": "宋词",
      "title": "清平乐",
      "subtitle": "候蛩凄断",
      "author": "张炎",
      "dynasty": "宋",
      "content": "候蛩凄断，人语西风岸。月落沙平江似练，望尽芦花无雁。\n暗教愁损兰成，可怜夜夜关情。只有一枝梧叶，不知多少秋声！",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "a1b40adb9a138343a706aa559576ede24b7bab7e1cfe568dd3e0d96dae601a18",
      "estimatedOutput": 710,
      "resultPath": "expansion/working/v2/results/song-126--a1b40adb9a138343a706aa559576ede24b7bab7e1cfe568dd3e0d96dae601a18.json"
    },
    {
      "id": "song-127",
      "category": "宋词",
      "title": "西江月",
      "subtitle": "问讯湖边春色",
      "author": "张孝祥",
      "dynasty": "宋",
      "content": "问讯湖边春色，重来又是三年。东风吹我过湖船，杨柳丝丝拂面。\n世路如今已惯，此心到处悠然。寒光亭下水如天，飞起沙鸥一片。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "1b915b6c0c4828b7f8081c35b6d4d94596fef2280ada5459051aa575b90a0bd2",
      "estimatedOutput": 718,
      "resultPath": "expansion/working/v2/results/song-127--1b915b6c0c4828b7f8081c35b6d4d94596fef2280ada5459051aa575b90a0bd2.json"
    },
    {
      "id": "song-128",
      "category": "宋词",
      "title": "诉衷情",
      "subtitle": "寒食",
      "author": "仲殊",
      "dynasty": "宋",
      "content": "涌金门外小瀛洲。寒食更风流。红船满湖歌吹，花外有高楼。晴日暖，淡烟浮。恣嬉游。三千粉黛，十二阑干，一片云头。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "2df6809d1d48d7aa7d88c4f19df76780736abf203dc0435b69173dfba28423bf",
      "estimatedOutput": 708,
      "resultPath": "expansion/working/v2/results/song-128--2df6809d1d48d7aa7d88c4f19df76780736abf203dc0435b69173dfba28423bf.json"
    },
    {
      "id": "song-129",
      "category": "宋词",
      "title": "浪淘沙",
      "subtitle": "赋虞美人草",
      "author": "辛弃疾",
      "dynasty": "宋",
      "content": "不肯过江东。玉帐匆匆。至今草木忆英雄。唱著虞兮当日曲，便舞春风。 \n儿女此情同。往事朦胧。湘娥竹上泪痕浓。舜盖重瞳堪痛恨，羽又重瞳。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "4f1f97ac5fb982fc7236ac3d7b8415d0d6c0ae53aa7918d3d53cb99463bbf86f",
      "estimatedOutput": 732,
