    },
    {
      "id": "song-130",
      "category": "宋词",
      "title": "清平乐",
      "subtitle": "春风依旧",
      "author": "赵令畤",
      "dynasty": "宋",
      "content": "春风依旧，著意隋堤柳。搓得鹅儿黄欲就，天气清明时候。\n去年紫陌青门，今宵雨魄云魂。断送一生憔悴，只消几个黄昏？",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "c6e9032d9a80318eca0cc9dcafc55baab78abb020a3feea5667059a7498099e0",
      "estimatedOutput": 710,
      "resultPath": "expansion/working/v2/results/song-130--c6e9032d9a80318eca0cc9dcafc55baab78abb020a3feea5667059a7498099e0.json"
    },
    {
      "id": "song-131",
      "category": "宋词",
      "title": "如梦令",
      "subtitle": "自净方能净彼我",
      "author": "苏轼",
      "dynasty": "宋",
      "content": "自净方能净彼。\n我自汗流呀气。\n寄语澡浴人，且共肉身游戏。\n但洗。\n但洗。\n俯为人间一切。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "c754c3430be990cfaa796c85299780728bdb9a606458702c97bd295367abb4e2",
      "estimatedOutput": 690,
      "resultPath": "expansion/working/v2/results/song-131--c754c3430be990cfaa796c85299780728bdb9a606458702c97bd295367abb4e2.json"
    },
    {
      "id": "song-132",
      "category": "宋词",
      "title": "如梦令",
      "subtitle": "为向东坡传语人",
      "author": "苏轼",
      "dynasty": "宋",
      "content": "为向东坡传语。\n人在玉堂深处。\n别后有谁来，雪压小桥无路。\n归去。\n归去。\n江上一犁春雨。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "ee9a59e2131ea80aeae415bb95e7f24ef0f356b46193801f5e4e685702cd4e89",
