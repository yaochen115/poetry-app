      "resultPath": "expansion/working/v2/results/song-927--bf6ecb03f65890fa5ade6d6dd3ee41f36b811cb2516156d46524f94831fcaeec.json"
    },
    {
      "id": "song-928",
      "category": "宋词",
      "title": "鹧鸪天",
      "subtitle": "题破香笺小砑红",
      "author": "晏几道",
      "dynasty": "宋",
      "content": "题破香笺小砑红。\n诗篇多寄旧相逢。\n西楼酒面垂垂雪，南苑春衫细细风。\n花不尽，柳无穷。\n别来欢事少人同。\n凭谁问取归云信，今在巫山第几峰。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "126e23b8c08997dca414fbb386dba3716fece11c18bd84997499b2fa14fd5874",
      "estimatedOutput": 738,
      "resultPath": "expansion/working/v2/results/song-928--126e23b8c08997dca414fbb386dba3716fece11c18bd84997499b2fa14fd5874.json"
    },
    {
      "id": "song-929",
      "category": "宋词",
      "title": "鹧鸪天",
      "subtitle": "清颍尊前酒满衣",
      "author": "晏几道",
      "dynasty": "宋",
      "content": "清颍尊前酒满衣。\n十年风月旧相知。\n凭谁细话当时事，肠断山长水远诗。\n金凤阙，玉龙墀。\n看君来换锦袍时。\n姮娥已有殷勤约，留著蟾宫第一枝。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "1afd88b4929592ebced5937105971c8ee6abe4a8db08f89450ab24ddd98dbf20",
      "estimatedOutput": 738,
      "resultPath": "expansion/working/v2/results/song-929--1afd88b4929592ebced5937105971c8ee6abe4a8db08f89450ab24ddd98dbf20.json"
    },
    {
      "id": "song-930",
      "category": "宋词",
      "title": "鹧鸪天",
      "subtitle": "楚女腰肢越女腮",
      "author": "晏几道",
      "dynasty": "宋",
      "content": "楚女腰肢越女腮。\n粉圆双蕊髻中开。\n朱弦曲怨愁春尽，渌酒杯寒记夜来。\n新掷果，旧分钗。\n冶游音信隔章台。\n花间锦字空频寄，月底金鞍竟未回。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "c038e8bdd90d233ecbd0065b339fbb57ff4b48446b9d8ca9e80b9950c2849602",
      "estimatedOutput": 738,
      "resultPath": "expansion/working/v2/results/song-930--c038e8bdd90d233ecbd0065b339fbb57ff4b48446b9d8ca9e80b9950c2849602.json"
    },
    {
      "id": "song-931",
      "category": "宋词",
      "title": "鹧鸪天",
      "subtitle": "陌上蒙蒙残絮飞",
      "author": "晏几道",
      "dynasty": "宋",
      "content": "陌上濛濛残絮飞。\n杜娟花里杜娟啼。\n年年底事不归去，怨月愁烟长为谁。\n梅雨细，晓风微。\n倚楼人听欲沾衣。\n故园三度群花谢，曼倩天涯犹未归。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "785867ffc5c812a57da478c47e0866325ea13e8020478c07a1b9fe3c5833aeb7",
      "estimatedOutput": 738,
      "resultPath": "expansion/working/v2/results/song-931--785867ffc5c812a57da478c47e0866325ea13e8020478c07a1b9fe3c5833aeb7.json"
    },
    {
      "id": "song-932",
      "category": "宋词",
      "title": "鹧鸪天",
      "subtitle": "晓日迎长岁岁同",
      "author": "晏几道",
      "dynasty": "宋",
      "content": "晓日迎长岁岁同。\n太平箫鼓间歌钟。\n云高未有前村雪，梅小初开昨夜风。\n罗幕翠，锦筵红。\n钗头罗胜写宜冬。\n从今屈指春期近，莫使金尊对月空。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "ba9b4e0585a02f26bcdb82d32dcea66f181783ce6d76a7b7af87c04dc064baa8",
      "estimatedOutput": 738,
      "resultPath": "expansion/working/v2/results/song-932--ba9b4e0585a02f26bcdb82d32dcea66f181783ce6d76a7b7af87c04dc064baa8.json"
    },
    {
      "id": "song-933",
      "category": "宋词",
      "title": "鹧鸪天",
      "subtitle": "小玉楼中月上时",
      "author": "晏几道",
      "dynasty": "宋",
      "content": "小玉楼中月上时。\n夜来惟许月华知。\n重帘有意藏私语，双烛无端恼暗期。\n伤别易，恨欢迟。\n归来何处验相思。\n沈郎春雪愁消臂，谢女香膏懒画眉。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "b3692cf9e46c45c9054602cd4a1fb7f886699f356a17f4480595c4083950e7d3",
      "estimatedOutput": 738,
      "resultPath": "expansion/working/v2/results/song-933--b3692cf9e46c45c9054602cd4a1fb7f886699f356a17f4480595c4083950e7d3.json"
    },
    {
      "id": "song-934",
      "category": "宋词",
      "title": "鹧鸪天",
      "subtitle": "手拈香笺忆小莲",
      "author": "晏几道",
      "dynasty": "宋",
      "content": "手拈香笺忆小莲。\n欲将遗恨倩谁传。\n归来独卧逍遥夜，梦里相逢酩酊天。\n花易落，月难圆。\n只应花月似欢缘。\n秦筝算有心情在，试写离声入旧弦。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "c22572f0640858ec10f9a3a552f50f16b8e0252e810f62de32cdee2f7a96dccf",
      "estimatedOutput": 738,
      "resultPath": "expansion/working/v2/results/song-934--c22572f0640858ec10f9a3a552f50f16b8e0252e810f62de32cdee2f7a96dccf.json"
    },
    {
      "id": "song-935",
      "category": "宋词",
      "title": "鹧鸪天",
      "subtitle": "九日悲秋不到心",
      "author": "晏几道",
      "dynasty": "宋",
      "content": "九日悲秋不到心。\n凤城歌管有新音。\n风凋碧柳愁眉淡，露染黄花笑靥深。\n初见雁，已闻砧。\n绮罗丛里胜登临。\n须教月户纤纤玉，细捧霞觞滟滟金。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "1c7ae30054fcf15fd9702e45655d78ca87c2c55a431e0d9c3d772df856a13294",
      "estimatedOutput": 738,
      "resultPath": "expansion/working/v2/results/song-935--1c7ae30054fcf15fd9702e45655d78ca87c2c55a431e0d9c3d772df856a13294.json"
    },
    {
      "id": "song-936",
      "category": "宋词",
      "title": "鹧鸪天",
      "subtitle": "碧藕花开水殿凉",
      "author": "晏几道",
      "dynasty": "宋",
      "content": "碧藕花开水殿凉。\n万年枝外转红阳。\n升平歌管随天仗，祥瑞封章满御床。\n金掌露，玉炉香。\n岁华方共圣恩长。\n皇州又奏圜扉静，十样宫眉捧寿觞。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "6903ac579fda36b9a19d8ca71f0972270f2ea2d913a624d7c4b1b526fa466c6e",
      "estimatedOutput": 738,
      "resultPath": "expansion/working/v2/results/song-936--6903ac579fda36b9a19d8ca71f0972270f2ea2d913a624d7c4b1b526fa466c6e.json"
    },
    {
      "id": "song-937",
      "category": "宋词",
      "title": "鹧鸪天",
      "subtitle": "绿橘梢头几点春",
      "author": "晏几道",
      "dynasty": "宋",
      "content": "绿橘梢头几点春。\n似留香蕊送行人。\n明朝紫凤朝天路，十二重城五碧云。\n歌渐咽，酒初醺。\n尽将红泪湿湘裙。\n赣江西畔从今日，明月清风忆使君。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "05ad723a5dfb74880761c0b71d4dda91b4dcd4628a68a9900bca7d0ee67f45c6",
