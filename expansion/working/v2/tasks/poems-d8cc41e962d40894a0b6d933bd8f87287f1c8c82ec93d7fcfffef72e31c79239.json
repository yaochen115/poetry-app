    },
    {
      "id": "song-377",
      "category": "宋词",
      "title": "虞美人",
      "subtitle": "魏家品是君王后",
      "author": "刘辰翁",
      "dynasty": "宋",
      "content": "魏家品是君王后。岂比昭容袖。\n风吹满院绣囊香。谁赐大师师号、退昭阳。\n飞霞一落无根蒂。空堕重华泪。\n离披正午盛时休。闲为思王重赋、洛神愁。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "1f93081a4c7109918d049d3a22dd12306cbb122f47b632663f928fa79543cbb6",
      "estimatedOutput": 738,
      "resultPath": "expansion/working/v2/results/song-377--1f93081a4c7109918d049d3a22dd12306cbb122f47b632663f928fa79543cbb6.json"
    },
    {
      "id": "song-378",
      "category": "宋词",
      "title": "水龙吟",
      "subtitle": "",
      "author": "赵长卿",
      "dynasty": "宋",
      "content": "事为之词\n危楼横枕清江上，两岸碧山如画。夕烟幂幂，晚灯点点，楼台新夜。明月当天，白沙流水，冷光连野。浸栏干万顷，琉璃软皱，打渔艇、相高下。\n何处一声羌管，是谁家、倚楼人也。多情对景，无言有恨，欲歌还罢。把酒临筵，阿谁知我，此怀难写。忍思量后夜，芳容不似，暗尘随马。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "08a3a8bae1fc6bab95b172d8b209f66d15c33f2f424d254c9468355c556705d5",
      "estimatedOutput": 864,
      "resultPath": "expansion/working/v2/results/song-378--08a3a8bae1fc6bab95b172d8b209f66d15c33f2f424d254c9468355c556705d5.json"
    },
    {
      "id": "song-379",
      "category": "宋词",
      "title": "水龙吟",
      "subtitle": "人生何必求名",
      "author": "萧元之",
      "dynasty": "宋",
      "content": "人生何必求名，身闲便是名高处。卧云衣袂，何因自染，修涂尘土。世路羊肠，人情狙赋，翻云覆雨。把从前旧梦，倚阑重省，休更错、添笺注。况是吾庐江上，也抵得、封侯千户。高眠闲听，邻舟渔唱，倚阑农语。休望当年，溪边俱载，隆中三顾。怕群鸥微觉，见人欲起，背人飞去。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "91a77c048cc04bae9f26a2881d03ce6614bac760043c704203bdb1367ed2c056",
      "estimatedOutput": 852,
      "resultPath": "expansion/working/v2/results/song-379--91a77c048cc04bae9f26a2881d03ce6614bac760043c704203bdb1367ed2c056.json"
    },
    {
      "id": "song-380",
      "category": "宋词",
      "title": "西江月",
      "subtitle": "",
      "author": "王千秋",
      "dynasty": "宋",
      "content": "璀璨雕笼洒笔，联翩荐鹗飞书。翻阶红药试妆梳。管取不言温树。\n容我一杯为寿，看君九万鹏图。髻鬟人小串珠玑。岁岁绿窗朱户。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "b3a5b137b3cdbfeec042cb3fc055120cc8b8ea06bf4e5cfece848c5b52a9f72e",
      "estimatedOutput": 718,
      "resultPath": "expansion/working/v2/results/song-380--b3a5b137b3cdbfeec042cb3fc055120cc8b8ea06bf4e5cfece848c5b52a9f72e.json"
    },
    {
      "id": "song-381",
      "category": "宋词",
      "title": "摸鱼儿",
      "subtitle": "便披蓑",
      "author": "刘克庄",
      "dynasty": "宋",
      "content": "便披蓑、荷锄归去，何须身著宫锦。与谁共话桑麻事，朱老阮生尤稔。筛样饼。瓮样茧，长须赤脚供樵饪。清流浊品。尽扫去胸中，置诸膜外，对酒莫辞饮。华胥梦，怕杀人惊晓枕。疏窗惟月来闯。一生常被弓旌误，且告朝家追寝。愁个甚。君管取，有薇堪采松堪荫。茅山再任。幸不是谋臣，又非世将，免犯道家禁。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "f4696b8b2716ec9c2cd8547db9cd621f413c64c1e94c6e74cb62c0d671d867af",
      "estimatedOutput": 880,
      "resultPath": "expansion/working/v2/results/song-381--f4696b8b2716ec9c2cd8547db9cd621f413c64c1e94c6e74cb62c0d671d867af.json"
    },
    {
      "id": "song-382",
      "category": "宋词",
      "title": "渔家傲",
      "subtitle": "",
      "author": "侯置",
      "dynasty": "宋",
      "content": "过尽百花芳草满。柳丝舞困阑干暖。柳外秋千裙影乱。人逐伴。旧家心性如今懒。\n斗帐宝香凝不散。黄昏院落莺声晚。红叶不来音信断。疏酒盏。东阳瘦损无人管。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "e44320741912e3b197aa5a624d5023405c2c3286337ed382ddc203d612191fb2",
      "estimatedOutput": 746,
      "resultPath": "expansion/working/v2/results/song-382--e44320741912e3b197aa5a624d5023405c2c3286337ed382ddc203d612191fb2.json"
    },
    {
      "id": "song-383",
      "category": "宋词",
      "title": "南歌子",
      "subtitle": "",
      "author": "苏轼",
      "dynasty": "宋",
      "content": "云鬓裁新绿，霞衣曳晓红。待歌凝立翠筵中。一朵彩云何事、下巫峰。\n趁拍鸾飞镜，回身燕漾空。莫翻红袖过帘栊。怕被杨花句引、嫁东风。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "c6ee423d730e0537274cb87d952ea474212b915e14ab6d9608daf8d607762f88",
      "estimatedOutput": 726,
      "resultPath": "expansion/working/v2/results/song-383--c6ee423d730e0537274cb87d952ea474212b915e14ab6d9608daf8d607762f88.json"
    },
    {
      "id": "song-384",
      "category": "宋词",
      "title": "玉楼春",
      "subtitle": "",
      "author": "楼采",
      "dynasty": "宋",
      "content": "东风破晓寒成阵。曲锁沈香簧语嫩。凤钗敲枕玉声圆，罗袖拂屏金缕褪。\n云头雁影占来信。歌底眉尖萦浅晕。淡烟疏柳一帘春，细雨遥山千叠恨。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "fec45df7c1fd1cb0d619d185756087300a8242ef34338c906b22327a496f8ecb",
      "estimatedOutput": 730,
      "resultPath": "expansion/working/v2/results/song-384--fec45df7c1fd1cb0d619d185756087300a8242ef34338c906b22327a496f8ecb.json"
    },
    {
      "id": "song-385",
      "category": "宋词",
      "title": "忆秦娥",
      "subtitle": "三月时",
      "author": "翁元龙",
      "dynasty": "宋",
      "content": "三月时。杨花飞尽无花飞。无花飞。不教春去，争得春归。高楼望断黄金羁。绿窗眉黛伤新离。伤新离。好将别後，长做归时。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "69abb459dad02ff9ac7250911f62b80df62df2ef9fef341e545decd4020715e9",
      "estimatedOutput": 712,
      "resultPath": "expansion/working/v2/results/song-385--69abb459dad02ff9ac7250911f62b80df62df2ef9fef341e545decd4020715e9.json"
    }
