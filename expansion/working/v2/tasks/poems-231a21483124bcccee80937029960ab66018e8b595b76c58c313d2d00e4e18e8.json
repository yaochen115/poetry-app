    },
    {
      "id": "tang-937",
      "category": "唐诗",
      "title": "宿淮阴南楼酬常伯能",
      "subtitle": "",
      "author": "皇甫冉",
      "dynasty": "唐",
      "content": "淮阴日落上南楼，乔木荒城古渡头。\n浦外野风初入户，窗中海月早知秋。\n沧波一望通千里，画角三声起百忧。\n伫立分宵绝来客，烦君步屐忽相求。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "4eff8f704a8edc881cab9ffd80e3663d04820707f2c8651c37de08d13bf4b399",
