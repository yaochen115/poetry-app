      "resultPath": "expansion/working/v2/results/tang-939--f32b2487cf09dcd1f24b02b59cf904ce8b04cfab5456d5e79b3eded62667a252.json"
    },
    {
      "id": "tang-940",
      "category": "唐诗",
      "title": "寄旧居邻友",
      "subtitle": "",
      "author": "齐己",
      "dynasty": "唐",
      "content": "别后知何趣，搜奇少客同。\n几层山影下，万树雪声中。\n晚鼎烹茶绿，晨厨爨粟红。\n何时携卷出，世代有名公。",
      "excerptOf": null,
      "excerptNote": "",
