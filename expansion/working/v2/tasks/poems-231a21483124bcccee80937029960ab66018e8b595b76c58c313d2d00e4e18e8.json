    },
    {
      "id": "tang-931",
      "category": "唐诗",
      "title": "送少年禅师二首",
      "subtitle": "",
      "author": "贯休",
      "dynasty": "唐",
      "content": "秀眉青目树花衣，一钵随缘智不知。\n佛与轮王嫌不作，世间刚有个痴儿。\n万水千山一鹤飞，岂愁游子暮何之。\n古今此著无人会，王积新输更不疑。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "228af2694ff05da014af6b3af496bf04b0409f04bd9ef896ed2bf9ebb5686497",
      "estimatedOutput": 734,
      "resultPath": "expansion/working/v2/results/tang-931--228af2694ff05da014af6b3af496bf04b0409f04bd9ef896ed2bf9ebb5686497.json"
    },
    {
      "id": "tang-932",
      "category": "唐诗",
      "title": "咏春笋",
      "subtitle": "",
      "author": "杜甫",
      "dynasty": "唐",
      "content": "无数春笋满林生，柴门密掩断行人。\n会须上番看成竹，客至从嗔不出迎。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "6a993123593300921feb8d2c70df3601bbb61e9f54423a576f5d4b005cd0b3f9",
