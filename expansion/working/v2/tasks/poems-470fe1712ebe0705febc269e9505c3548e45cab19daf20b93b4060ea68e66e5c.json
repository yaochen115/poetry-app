  "poems": [
    {
      "id": "tang-965",
      "category": "唐诗",
      "title": "帝京篇十首 一",
      "subtitle": "",
      "author": "李世民",
      "dynasty": "唐",
      "content": "秦川雄帝宅，函谷壮皇居。\n绮殿千寻起，离宫百雉余。\n连甍遥接汉，飞观迥凌虚。\n云日隐层阙，风烟出绮疎。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "710b49f2240b2e96ade81695def31fe1e5f09d91f407f904b7860673a8dd222e",
      "estimatedOutput": 702,
      "resultPath": "expansion/working/v2/results/tang-965--710b49f2240b2e96ade81695def31fe1e5f09d91f407f904b7860673a8dd222e.json"
    },
    {
      "id": "tang-966",
      "category": "唐诗",
      "title": "帝京篇十首 二",
      "subtitle": "",
      "author": "李世民",
      "dynasty": "唐",
      "content": "岩廊罢机务，崇文聊驻辇。\n玉匣启龙图，金绳披凤篆。\n韦编断仍续，缥帙舒还卷。\n对此乃淹留，欹案观坟典。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "438083c9b760e05424a708a20d391268ab9a74fdb2dece44f850b85ed3118b35",
      "estimatedOutput": 702,
      "resultPath": "expansion/working/v2/results/tang-966--438083c9b760e05424a708a20d391268ab9a74fdb2dece44f850b85ed3118b35.json"
    },
    {
      "id": "tang-967",
      "category": "唐诗",
      "title": "帝京篇十首 三",
      "subtitle": "",
      "author": "李世民",
      "dynasty": "唐",
      "content": "移步出词林，停舆欣武宴。\n雕弓写明月，骏马疑流电。\n惊雁落虚弦，啼猿悲急箭。\n阅赏诚多美，于兹乃忘倦。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "f9a3564d1e873a74c5ad881a49d2f0a1033ed6a98fb8e0a8361fce1c58925739",
      "estimatedOutput": 702,
      "resultPath": "expansion/working/v2/results/tang-967--f9a3564d1e873a74c5ad881a49d2f0a1033ed6a98fb8e0a8361fce1c58925739.json"
    },
    {
      "id": "tang-968",
      "category": "唐诗",
      "title": "帝京篇十首 四",
      "subtitle": "",
      "author": "李世民",
      "dynasty": "唐",
      "content": "鸣笳临乐馆，眺听欢芳节。\n急管韵朱弦，清歌凝白雪。\n彩凤肃来仪，玄鹤纷成列。\n去兹郑卫声，雅音方可悦。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "78b24d773d71d4e78970a7d3bfad814838298b747c9f02baf4f99bc7f8cf158c",
      "estimatedOutput": 702,
      "resultPath": "expansion/working/v2/results/tang-968--78b24d773d71d4e78970a7d3bfad814838298b747c9f02baf4f99bc7f8cf158c.json"
    },
    {
      "id": "tang-969",
      "category": "唐诗",
      "title": "帝京篇十首 五",
      "subtitle": "",
      "author": "李世民",
      "dynasty": "唐",
      "content": "芳辰追逸趣，禁苑信多奇。\n桥形通汉上，峰势接云危。\n烟霞交隐映，花鸟自参差。\n何如肆辙迹？\n万里赏瑶池。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "4a1112931925019048e6d1a20be743134338dc885c24c94c6530c305ce9a4d88",
      "estimatedOutput": 704,
      "resultPath": "expansion/working/v2/results/tang-969--4a1112931925019048e6d1a20be743134338dc885c24c94c6530c305ce9a4d88.json"
    },
    {
      "id": "tang-970",
      "category": "唐诗",
      "title": "帝京篇十首 六",
      "subtitle": "",
      "author": "李世民",
      "dynasty": "唐",
      "content": "飞盖去芳园，兰桡游翠渚。\n萍间日彩乱，荷处香风举。\n桂楫满中川，弦歌振长屿。\n岂必汾河曲，方为欢宴所。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "166c79c0924f1a78d436bd8f8d6a27705d58df2a54940e99cf6364df32315f76",
      "estimatedOutput": 702,
      "resultPath": "expansion/working/v2/results/tang-970--166c79c0924f1a78d436bd8f8d6a27705d58df2a54940e99cf6364df32315f76.json"
    },
    {
      "id": "tang-971",
      "category": "唐诗",
      "title": "帝京篇十首 七",
      "subtitle": "",
      "author": "李世民",
      "dynasty": "唐",
      "content": "落日双阙昏，回舆九重暮。\n长烟散初碧，皎月澄轻素。\n搴幌玩琴书，开轩引云雾。\n斜汉耿层阁，清风摇玉树。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "f2b9aa8bf92c3cf9ae63f169be6d48f8ffd91d9bc34ce02a703140af772ba135",
      "estimatedOutput": 702,
      "resultPath": "expansion/working/v2/results/tang-971--f2b9aa8bf92c3cf9ae63f169be6d48f8ffd91d9bc34ce02a703140af772ba135.json"
    },
    {
      "id": "tang-972",
      "category": "唐诗",
      "title": "帝京篇十首 八",
      "subtitle": "",
      "author": "李世民",
      "dynasty": "唐",
      "content": "欢乐难再逢，芳辰良可惜。\n玉酒泛云罍，兰殽陈绮席。\n千钟合尧禹，百兽谐金石。\n得志重寸阴，忘怀轻尺璧。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "e558cc995ec68f9d03af45070b67502ae1c6f777d4c0e73da4cd64025335a8b2",
      "estimatedOutput": 702,
      "resultPath": "expansion/working/v2/results/tang-972--e558cc995ec68f9d03af45070b67502ae1c6f777d4c0e73da4cd64025335a8b2.json"
    },
    {
      "id": "tang-973",
      "category": "唐诗",
      "title": "帝京篇十首 九",
      "subtitle": "",
      "author": "李世民",
      "dynasty": "唐",
      "content": "建章欢赏夕，二八尽妖妍。\n罗绮昭阳殿，芬芳玳瑁筵。\n珮移星正动，扇掩月初圆。\n无劳上悬圃，即此对神仙。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "6a78cd7d091194a827d0af875bb0a0b2b96dd62105f29a04207547484e05f91c",
      "estimatedOutput": 702,
      "resultPath": "expansion/working/v2/results/tang-973--6a78cd7d091194a827d0af875bb0a0b2b96dd62105f29a04207547484e05f91c.json"
    },
    {
      "id": "tang-974",
      "category": "唐诗",
      "title": "帝京篇十首 十",
      "subtitle": "",
      "author": "李世民",
      "dynasty": "唐",
      "content": "以兹游观极，悠然独长想。\n披卷览前踪，抚躬寻既往。\n望古茅茨约，瞻今兰殿广。\n人道恶高危，虚心戒盈荡。\n奉天竭诚敬，临民思惠养。\n纳善察忠谏，明科慎刑赏。\n六五诚难继，四三非易仰。\n广待淳化敷，方嗣云亭响。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "5820a3ab9460ceab1de2cc68823d36a2c06f19f1932d14abb0544a7172635561",
      "estimatedOutput": 806,
      "resultPath": "expansion/working/v2/results/tang-974--5820a3ab9460ceab1de2cc68823d36a2c06f19f1932d14abb0544a7172635561.json"
    },
    {
      "id": "tang-975",
      "category": "唐诗",
      "title": "饮马长城窟行",
      "subtitle": "",
      "author": "李世民",
      "dynasty": "唐",
      "content": "塞外悲风切，交河冰已结。\n瀚海百重波，阴山千里雪。\n迥戍危烽火，层峦引高节。\n悠悠卷斾旌，饮马出长城。\n寒沙连骑迹，朔吹断边声。\n胡尘清玉塞，羌笛韵金钲。\n绝漠干戈戢，车徒振原隰。\n都尉反龙堆，将军旋马邑。\n扬麾氛雾静，纪石功名立。\n荒裔一戎衣，灵台凯歌入。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "08da95da981dd3923720481b89d789038dea3f206b1c09d59950a88397b24130",
      "estimatedOutput": 858,
      "resultPath": "expansion/working/v2/results/tang-975--08da95da981dd3923720481b89d789038dea3f206b1c09d59950a88397b24130.json"
    },
    {
      "id": "tang-976",
      "category": "唐诗",
      "title": "执契静三边",
      "subtitle": "",
      "author": "李世民",
      "dynasty": "唐",
      "content": "执契静三边，持衡临万姓。\n玉彩辉关烛，金华流日镜。\n无为宇宙清，有美璇玑正。\n皎佩星连景，飘衣云结庆。\n戢武耀七德，升文辉九功。\n烟波澄旧碧，尘火息前红。\n霜野韬莲劒，关城罢月弓。\n钱缀榆天合，新城柳塞空。\n花销葱岭雪，縠尽流沙雾。\n秋驾转兢怀，春冰弥轸虑。\n书绝龙庭羽，烽休凤穴戍。\n衣宵寝二难，食旰餐三惧。\n翦暴兴先废，除凶存昔亡。\n圆盖归天壤，方舆入地荒。\n孔海池京邑，双河沼帝乡。\n循躬思励己，抚俗媿时康。\n元首伫盐梅，股肱惟辅弼。\n羽贤崆岭四，翼圣襄城七。\n浇俗庶反淳，替文聊就质。\n已知隆至道，共欢区宇一。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "1c1c127dd10398054b15b074ac691ad3e1a235b66f8b60237aa7b27fda72c1df",
