    {
      "id": "guwen-183",
      "category": "古文",
      "title": "围炉夜话·第三三则",
      "subtitle": "",
      "author": "王永彬",
      "dynasty": "清",
      "content": "父兄有善行，子弟学之或不肖；父兄有恶行，子弟学之则无不肖；可知父兄教子弟，必正其身以率子，无庸徒事言词也。君子有过行，小人嫉之不能容；君子无过行，小人嫉之亦不能容；可知君子处小人，必平其气以待之，不可稍形激切也。",
      "excerptOf": "围炉夜话",
      "excerptNote": "完整选录《围炉夜话》中“第三三则”一则或一章；非全书。",
      "inputHash": "eb59be95275aa59d2126bb1404fadd8200347e35fabf8f9c5148a7b7b4c3928c",
      "estimatedOutput": 918,
      "resultPath": "expansion/working/v2/results/guwen-183--eb59be95275aa59d2126bb1404fadd8200347e35fabf8f9c5148a7b7b4c3928c.json"
    },
    {
      "id": "guwen-184",
      "category": "古文",
      "title": "围炉夜话·第三四则",
      "subtitle": "",
      "author": "王永彬",
      "dynasty": "清",
      "content": "守身不敢妄为，恐贻羞于父母；创业还须深虑，恐贻害于子孙。",
      "excerptOf": "围炉夜话",
      "excerptNote": "完整选录《围炉夜话》中“第三四则”一则或一章；非全书。",
      "inputHash": "772ed10cee307676568cc6c8255377ee309a337e5d1a8ddae4920ba875b033fe",
      "estimatedOutput": 684,
      "resultPath": "expansion/working/v2/results/guwen-184--772ed10cee307676568cc6c8255377ee309a337e5d1a8ddae4920ba875b033fe.json"
    },
    {
      "id": "guwen-185",
      "category": "古文",
      "title": "围炉夜话·第三五则",
      "subtitle": "",
      "author": "王永彬",
      "dynasty": "清",
      "content": "无论作何等人，总不可有势利气；无论习何等业，总不可有粗浮心。",
      "excerptOf": "围炉夜话",
      "excerptNote": "完整选录《围炉夜话》中“第三五则”一则或一章；非全书。",
