      "resultPath": "expansion/working/v2/results/song-077--b05c00a97c1985e2d8f878da650fbc9867ca270126fbb4c5dc84b153a153ad49.json"
    },
    {
      "id": "song-078",
      "category": "宋词",
      "title": "清平乐",
      "subtitle": "独宿博山王氏庵",
      "author": "辛弃疾",
      "dynasty": "宋",
      "content": "绕床饥鼠，蝙蝠翻灯舞。屋上松风吹急雨，破纸窗间自语。\n平生塞北江南，归来华发苍颜。布被秋宵梦觉，眼前万里江山。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "817ebcdc3b8587a50eeb1afe6c126bb63ccc46ab8bbc788b62c0581f0b69af6d",
      "estimatedOutput": 710,
      "resultPath": "expansion/working/v2/results/song-078--817ebcdc3b8587a50eeb1afe6c126bb63ccc46ab8bbc788b62c0581f0b69af6d.json"
    },
    {
      "id": "song-079",
      "category": "宋词",
      "title": "西江月",
      "subtitle": "世事短如春梦",
      "author": "朱敦儒",
      "dynasty": "宋",
      "content": "世事短如春梦，人情薄似秋云。不须计较苦劳心，万事原来有命。\n幸遇三杯酒好，况逢一朵花新。片时欢笑且相亲，明日阴晴未定。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "4f51336ff4e714aed820e5ce9cab1b82e9ed570556db71654abc846dbdcea1d3",
