    },
    {
      "id": "song-082",
      "category": "宋词",
      "title": "浣溪沙",
      "subtitle": "端午",
      "author": "苏轼",
      "dynasty": "宋",
      "content": "轻汗微微透碧纨，明朝端午浴芳兰。流香涨腻满晴川。\n彩线轻缠红玉臂，小符斜挂绿云鬟。佳人相见一千年。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "485ee7ea13ba9d7028f622b12a161a936087c755dd2bcd74d6b585a44a19ba49",
