    },
    {
      "id": "song-085",
      "category": "宋词",
      "title": "西江月",
      "subtitle": "阻风山峰下",
      "author": "张孝祥",
      "dynasty": "宋",
      "content": "满载一船秋色，平铺十里湖光。波神留我看斜阳，放起鳞鳞细浪。\n明日风回更好，今宵露宿何妨？水晶宫里奏霓裳，准拟岳阳楼上。",
      "excerptOf": null,
      "excerptNote": "",
