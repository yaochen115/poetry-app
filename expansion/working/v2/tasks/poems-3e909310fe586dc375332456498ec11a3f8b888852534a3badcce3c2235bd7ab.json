    {
      "id": "song-083",
      "category": "宋词",
      "title": "浣溪沙",
      "subtitle": "浅画香膏拂紫绵",
      "author": "陈克",
      "dynasty": "宋",
      "content": "浅画香膏拂紫绵。牡丹花重翠云偏。手挼梅子并郎肩。\n病起心情终是怯，困来模样不禁怜。旋移针线小窗前。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "f7a9b0d395cf2cfca9182fbd38f35a33bedaf914a790348f4742200eed408b52",
      "estimatedOutput": 698,
      "resultPath": "expansion/working/v2/results/song-083--f7a9b0d395cf2cfca9182fbd38f35a33bedaf914a790348f4742200eed408b52.json"
    },
    {
      "id": "song-084",
      "category": "宋词",
      "title": "如梦令",
      "subtitle": "春景",
      "author": "秦观",
      "dynasty": "宋",
      "content": "莺嘴啄花红溜，燕尾点波绿皱。\n指冷玉笙寒，吹彻小梅春透。\n依旧，依旧，人与绿杨俱瘦。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "e3a0074d62c0b7dc2f0061a0ffcbbe55f7b761f80c48b5f39ebfc19591973a3c",
