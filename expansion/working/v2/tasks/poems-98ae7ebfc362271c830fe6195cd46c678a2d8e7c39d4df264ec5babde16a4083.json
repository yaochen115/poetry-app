    {
      "id": "yuan-075",
      "category": "元曲",
      "title": "迎仙客",
      "subtitle": "云冉冉",
      "author": "张可久",
      "dynasty": "元",
      "content": "云冉冉，草纤纤，谁家隐居山半崦。水烟寒，溪路险。\n半幅青帘，五里桃花店。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "ad197189f7252ed4ee286981d2aad37e6dcbd6cfdaf7daf97d44e23b9a54be9e",
      "estimatedOutput": 672,
      "resultPath": "expansion/working/v2/results/yuan-075--ad197189f7252ed4ee286981d2aad37e6dcbd6cfdaf7daf97d44e23b9a54be9e.json"
    },
    {
      "id": "yuan-076",
      "category": "元曲",
      "title": "天净沙",
      "subtitle": "江上",
      "author": "张可久",
      "dynasty": "元",
      "content": "嗈嗈落雁平沙，依依孤鹜残霞，隔水疏林几家。小舟如画，渔歌唱入芦花。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "8eab8fef35a208dbb580f287e9b6ef11a6ce512a4aab37a955f899ba2c909c53",
      "estimatedOutput": 666,
      "resultPath": "expansion/working/v2/results/yuan-076--8eab8fef35a208dbb580f287e9b6ef11a6ce512a4aab37a955f899ba2c909c53.json"
    },
    {
      "id": "yuan-077",
      "category": "元曲",
      "title": "寿阳曲",
      "subtitle": "别珠帘秀",
      "author": "卢挚",
      "dynasty": "元",
      "content": "才欢悦，早间别，痛煞俺好难割舍。画船儿载将春去也！空留下半江明月。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "3d447397c3988e1fc7fca93ce545241a92d00e20e097349a83aa7b73f5027b80",
      "estimatedOutput": 666,
      "resultPath": "expansion/working/v2/results/yuan-077--3d447397c3988e1fc7fca93ce545241a92d00e20e097349a83aa7b73f5027b80.json"
    },
    {
      "id": "yuan-078",
      "category": "元曲",
      "title": "寿阳曲",
      "subtitle": "夜忆",
      "author": "卢挚",
      "dynasty": "元",
      "content": "灯将灭，人睡些，照离愁半窗残月。多情直恁的心似铁，辜负了好天良夜。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "78b8b41ad40e447b0a97460e4e1942a14526dbea7c70dbc6336c6baae626e28f",
      "estimatedOutput": 666,
      "resultPath": "expansion/working/v2/results/yuan-078--78b8b41ad40e447b0a97460e4e1942a14526dbea7c70dbc6336c6baae626e28f.json"
    },
    {
      "id": "yuan-079",
      "category": "元曲",
      "title": "天净沙",
      "subtitle": "渔父",
      "author": "徐再思",
      "dynasty": "元",
      "content": "忘形雨笠烟蓑，知心牧唱樵歌。明月清风共我，闲人三个，从他今古消磨。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "dc4353c525fe79b80efc7a30e5add5e6d4b5ae1f509cfe0a5e17ec355830fa3b",
      "estimatedOutput": 666,
      "resultPath": "expansion/working/v2/results/yuan-079--dc4353c525fe79b80efc7a30e5add5e6d4b5ae1f509cfe0a5e17ec355830fa3b.json"
    },
    {
      "id": "yuan-080",
      "category": "元曲",
      "title": "清江引",
      "subtitle": "题情",
      "author": "任昱",
      "dynasty": "元",
      "content": "南山豆苗荒数亩，拂袖先归去，高官鼎内鱼，小吏罝中兔。争似闭门闲看书！",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "dffb444266472d49f728f43020f72a28ddbf84200cd549491405bece35c91c97",
      "estimatedOutput": 668,
      "resultPath": "expansion/working/v2/results/yuan-080--dffb444266472d49f728f43020f72a28ddbf84200cd549491405bece35c91c97.json"
    },
    {
      "id": "yuan-081",
      "category": "元曲",
      "title": "清江引",
      "subtitle": "秋居",
      "author": "吴西逸",
      "dynasty": "元",
      "content": "白雁乱飞秋似雪，清露生凉夜。扫却石边云，醉踏松根月，星斗满天人睡也。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "4d64ab24c428eebdba4e51e5bba8873f10230f6a5d9fead1d0e12b901d2899cb",
      "estimatedOutput": 668,
      "resultPath": "expansion/working/v2/results/yuan-081--4d64ab24c428eebdba4e51e5bba8873f10230f6a5d9fead1d0e12b901d2899cb.json"
    },
    {
      "id": "yuan-082",
      "category": "元曲",
      "title": "四块玉",
      "subtitle": "酷吏",
      "author": "曾瑞",
      "dynasty": "元",
      "content": "官况甜，公途险，虎豹重关整威严。仇多恩少人皆厌。业贯盈，横祸添，无处闪。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "27b339c76ffb4805e485a69598cdc6d689f96b85ebcb7148e8171762409b5739",
      "estimatedOutput": 672,
      "resultPath": "expansion/working/v2/results/yuan-082--27b339c76ffb4805e485a69598cdc6d689f96b85ebcb7148e8171762409b5739.json"
    },
    {
      "id": "yuan-083",
      "category": "元曲",
      "title": "四块玉",
      "subtitle": "绿鬓衰",
      "author": "马致远",
      "dynasty": "元",
      "content": "绿鬓衰，红颜改，羞把尘容画麟台。故园风景依然在；\n三顷田，五亩宅，归去来。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "de83731a26253c6c73465e5335f8a604b415d3eb399010f9bc96ffbe320e89c9",
      "estimatedOutput": 674,
      "resultPath": "expansion/working/v2/results/yuan-083--de83731a26253c6c73465e5335f8a604b415d3eb399010f9bc96ffbe320e89c9.json"
    },
    {
      "id": "yuan-084",
      "category": "元曲",
      "title": "四块玉",
      "subtitle": "带月行",
      "author": "马致远",
      "dynasty": "元",
      "content": "带月行，披星走。孤馆寒食故乡秋，妻儿胖了咱消瘦。\n枕上忧，马上愁，死后休。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "e7fe83ff464ce2ffeb9f738b3459dd1e6c2e14287acf560760437908394e8989",
      "estimatedOutput": 674,
      "resultPath": "expansion/working/v2/results/yuan-084--e7fe83ff464ce2ffeb9f738b3459dd1e6c2e14287acf560760437908394e8989.json"
    },
    {
      "id": "yuan-085",
      "category": "元曲",
      "title": "阳春曲",
      "subtitle": "笔头风月时时过",
      "author": "姚燧",
      "dynasty": "元",
      "content": "笔底风月时时过，眼底儿曹渐渐多。有人问我事如何。人海阔，无日不风波。",
      "excerptOf": null,
      "excerptNote": "",
