      "resultPath": "expansion/working/v2/results/tang-690--7cf46eb4f3248eba8f835951dc36641d68fdc8e86fd0a94a577fcfef8cd1a8bc.json"
    },
    {
      "id": "tang-691",
      "category": "唐诗",
      "title": "塞上听吹笛",
      "subtitle": "",
      "author": "高适",
      "dynasty": "唐",
      "content": "雪净胡天牧马还，月明羌笛戍楼间。\n借问梅花何处落，风吹一夜满关山。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "3455a128e175461267e7eb1563dba6c679b49b11ec6c3a3accf5616df1382306",
      "estimatedOutput": 666,
      "resultPath": "expansion/working/v2/results/tang-691--3455a128e175461267e7eb1563dba6c679b49b11ec6c3a3accf5616df1382306.json"
    },
    {
      "id": "tang-692",
      "category": "唐诗",
      "title": "调笑令",
      "subtitle": "胡马",
      "author": "韦应物",
      "dynasty": "唐",
      "content": "胡马，胡马，远放燕支山下。\n跑沙跑雪独嘶，东望西望路迷。\n迷路，迷路，边草无穷日暮。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "7c9c02119b15fed9ea09bad52c788da52ec1abf6f85b9105933658835d543b68",
      "estimatedOutput": 684,
      "resultPath": "expansion/working/v2/results/tang-692--7c9c02119b15fed9ea09bad52c788da52ec1abf6f85b9105933658835d543b68.json"
    },
    {
      "id": "tang-693",
      "category": "唐诗",
      "title": "南陵道中",
      "subtitle": "",
      "author": "杜牧",
      "dynasty": "唐",
      "content": "南陵水面漫悠悠，风紧云轻欲变秋。\n正是客心孤迥处，谁家红袖凭江楼？",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "a82a399335d0d65b12860f387e5705b230c620baffa7587ad98ef48da09a871d",
      "estimatedOutput": 666,
      "resultPath": "expansion/working/v2/results/tang-693--a82a399335d0d65b12860f387e5705b230c620baffa7587ad98ef48da09a871d.json"
    },
    {
      "id": "tang-694",
      "category": "唐诗",
      "title": "短歌行",
      "subtitle": "",
      "author": "白居易",
      "dynasty": "唐",
      "content": "曈曈太阳如火色，上行千里下一刻。\n出为白昼入为夜，圆转如珠住不得。\n住不得，可奈何，为君举酒歌短歌。\n歌声苦，词亦苦，四座少年君听取。\n今夕未竟明夕催，秋风才往春风回。\n人无根蒂时不驻，朱颜白日相隳颓。\n劝君且强笑一面，劝君且强饮一杯。\n人生不得长欢乐，年少须臾老到来。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "5549116c9aa1e2fd6e2e7f7309d75cedad0a15c00e829ed105b02c366451e659",
      "estimatedOutput": 870,
      "resultPath": "expansion/working/v2/results/tang-694--5549116c9aa1e2fd6e2e7f7309d75cedad0a15c00e829ed105b02c366451e659.json"
    },
    {
      "id": "tang-695",
      "category": "唐诗",
      "title": "赠从兄襄阳少府皓",
      "subtitle": "",
      "author": "李白",
      "dynasty": "唐",
      "content": "结发未识事，所交尽豪雄。\n却秦不受赏，击晋宁为功。\n托身白刃里，杀人红尘中。\n当朝揖高义，举世称英雄。\n小节岂足言，退耕舂陵东。\n归来无产业，生事如转蓬。\n一朝乌裘敝，百镒黄金空。\n弹剑徒激昂，出门悲路穷。\n吾兄青云士，然诺闻诸公。\n所以陈片言，片言贵情通。\n棣华倘不接，甘与秋草同。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "607012f9458dad7566a518fa00af8bd5994b63c6e76c685f95c51a85b4e16490",
      "estimatedOutput": 884,
      "resultPath": "expansion/working/v2/results/tang-695--607012f9458dad7566a518fa00af8bd5994b63c6e76c685f95c51a85b4e16490.json"
    },
    {
      "id": "tang-696",
      "category": "唐诗",
      "title": "渡湘江",
      "subtitle": "",
      "author": "杜审言",
      "dynasty": "唐",
      "content": "迟日园林悲昔游，今春花鸟作边愁。\n独怜京国人南窜，不似湘江水北流。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "c833984eabc85e81f9c6c6a9600a3537f0ab7dc475f71ff0d8297934afcd90b0",
      "estimatedOutput": 666,
      "resultPath": "expansion/working/v2/results/tang-696--c833984eabc85e81f9c6c6a9600a3537f0ab7dc475f71ff0d8297934afcd90b0.json"
    },
    {
      "id": "tang-697",
      "category": "唐诗",
      "title": "酬武蕴之，乙丑之岁始见华发余自悲遂成继和",
      "subtitle": "",
      "author": "张祜",
      "dynasty": "唐",
      "content": "贾生年尚少，华发近相侵。\n不是流光促，因缘别恨深。\n怜君成苦调，感我独长吟。\n岂料清秋日，星星共映簪。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "5cc15ace9557644ae39b63f763f842b7526e27ccce945e596895243564585a2a",
      "estimatedOutput": 702,
      "resultPath": "expansion/working/v2/results/tang-697--5cc15ace9557644ae39b63f763f842b7526e27ccce945e596895243564585a2a.json"
    },
    {
      "id": "tang-698",
      "category": "唐诗",
      "title": "游阳河岸",
      "subtitle": "",
      "author": "姚合",
      "dynasty": "唐",
      "content": "终日游山困，今朝始傍河。\n寻芳愁路尽，逢景畏人多。\n鸟语催沽酒，鱼来似听歌。\n醉时眠石上，肢体自婆娑。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "5b567d00223d3cf3b3405a6b83c036d33d8fff63faba9c3d521db7b426c48374",
      "estimatedOutput": 702,
      "resultPath": "expansion/working/v2/results/tang-698--5b567d00223d3cf3b3405a6b83c036d33d8fff63faba9c3d521db7b426c48374.json"
    },
    {
      "id": "tang-699",
      "category": "唐诗",
      "title": "祠紫盖山经玉泉山寺",
      "subtitle": "",
      "author": "张九龄",
      "dynasty": "唐",
      "content": "指途跻楚望，策马傍荆岑。\n稍稍松篁入，泠泠涧谷深。\n观奇逐幽映，历险忘岖嶔。\n上界投佛影，中天扬梵音。\n焚香忏在昔，礼足誓来今。\n灵异若有对，神仙真可寻。\n高僧闻逝者，远俗是初心。\n藓驳经行处，猿啼燕坐林。\n归真已寂灭，留迹岂湮沉。\n法地自兹广，何云千万金。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "10fcc27f442594b3d440842d3ebe7f169db93331d3fa685f79229655b0ebe919",
      "estimatedOutput": 858,
      "resultPath": "expansion/working/v2/results/tang-699--10fcc27f442594b3d440842d3ebe7f169db93331d3fa685f79229655b0ebe919.json"
    },
    {
      "id": "tang-700",
      "category": "唐诗",
      "title": "相和歌辞。怨诗",
      "subtitle": "",
      "author": "孟郊",
      "dynasty": "唐",
      "content": "试妾与君泪，两处滴池水。\n看取芙蓉花，今年为谁死。",
      "excerptOf": null,
      "excerptNote": "",
