    {
      "id": "yuan-111",
      "category": "元曲",
      "title": "春闺怨",
      "subtitle": "不系雕鞍门前柳",
      "author": "乔吉",
      "dynasty": "元",
      "content": "不系雕鞍门前柳，玉容寂寞见花羞。冷风儿吹雨黄昏后，帘控钩，掩上珠楼，风雨替花愁。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "d8554181c587f5ac276f1350bc693032cdf992b3a94192e5e7a8601c7d9a36a8",
