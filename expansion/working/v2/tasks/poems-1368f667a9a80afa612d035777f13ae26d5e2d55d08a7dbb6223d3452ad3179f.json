    },
    {
      "id": "yuan-112",
      "category": "元曲",
      "title": "红绣鞋",
      "subtitle": "晚秋",
      "author": "李致远",
      "dynasty": "元",
      "content": "梦断陈王罗袜，情伤学士琵琶。又见西风换年华。\n数杯添泪酒，几点送秋花。行人天一涯。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "3666d343bc4f682148d70073953e871d6915ae203fb3fb25931a620d5c8e6046",
      "estimatedOutput": 682,
      "resultPath": "expansion/working/v2/results/yuan-112--3666d343bc4f682148d70073953e871d6915ae203fb3fb25931a620d5c8e6046.json"
    },
    {
      "id": "yuan-113",
      "category": "元曲",
      "title": "金字经",
      "subtitle": "春",
      "author": "徐再思",
      "dynasty": "元",
      "content": "紫燕寻旧垒，翠鸳栖暖沙，一处处绿杨堪系马。他，问前村沽酒家。秋千下，粉墙边红旗花。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "8f3769182d6b5c790aa08ad73dd9af231664c9c5e3bfe4975d2a40171f951738",
      "estimatedOutput": 682,
      "resultPath": "expansion/working/v2/results/yuan-113--8f3769182d6b5c790aa08ad73dd9af231664c9c5e3bfe4975d2a40171f951738.json"
    },
    {
      "id": "yuan-114",
      "category": "元曲",
      "title": "红绣鞋",
      "subtitle": "重到吴门",
      "author": "任昱",
      "dynasty": "元",
      "content": "槐市歌阑酒散，枫桥雨晴秋残，旧题犹在画楼间。泛湖赊看月，寻寺强登山，比陶朱心更懒。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "a2b7c6f35730b1011cbd3d3f145d273186b8dac9acbb09cfc1c3c9c178af1388",
      "estimatedOutput": 682,
      "resultPath": "expansion/working/v2/results/yuan-114--a2b7c6f35730b1011cbd3d3f145d273186b8dac9acbb09cfc1c3c9c178af1388.json"
    },
    {
      "id": "yuan-115",
      "category": "元曲",
      "title": "四块玉",
      "subtitle": "酒旋沽",
      "author": "马致远",
      "dynasty": "元",
      "content": "酒旋沽，鱼新买，满眼云山画图开。清风明月还诗债。\n本是个懒散人，又无甚经济才，归去来。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "736b1012db9821fb7de6d0bf188e00ea0f8acc58fd1b806706ca8d01d79a4894",
      "estimatedOutput": 686,
      "resultPath": "expansion/working/v2/results/yuan-115--736b1012db9821fb7de6d0bf188e00ea0f8acc58fd1b806706ca8d01d79a4894.json"
    },
    {
      "id": "yuan-116",
      "category": "元曲",
      "title": "红绣鞋",
      "subtitle": "绿树当门酒肆",
      "author": "张可久",
      "dynasty": "元",
      "content": "绿树当门酒肆，红妆映水鬟儿。眼底殷勤座间诗。\n尘埃三五字，杨柳万千丝，记年时曾到此。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "c94b28c28df8c03d4a69bed08df55bd45e5bd6c588fbde42c9bec183e527a9a2",
      "estimatedOutput": 684,
      "resultPath": "expansion/working/v2/results/yuan-116--c94b28c28df8c03d4a69bed08df55bd45e5bd6c588fbde42c9bec183e527a9a2.json"
    },
    {
      "id": "yuan-117",
      "category": "元曲",
      "title": "得胜令",
      "subtitle": "四月一日",
      "author": "张养浩",
      "dynasty": "元",
      "content": "万象欲焦枯，一雨足沾濡。天地回生意，风云起壮图。农夫，舞破蓑衣绿；和余，欢喜的无是处。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "3f49938ac15ac4553be0b0d898ae0bfb08920f576abed4d8713396db0ab281cb",
      "estimatedOutput": 686,
      "resultPath": "expansion/working/v2/results/yuan-117--3f49938ac15ac4553be0b0d898ae0bfb08920f576abed4d8713396db0ab281cb.json"
    },
    {
      "id": "yuan-118",
      "category": "元曲",
      "title": "一半儿",
      "subtitle": "题情",
      "author": "关汉卿",
      "dynasty": "元",
      "content": "多情多绪小冤家，迤逗的人来憔悴煞；说来的话先瞒过咱，怎知他，一半儿真实一半儿假。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "305bc1ee9d0fb9488d6f201206436dde9c18ea8863a6222decaf8df8ab3ef300",
      "estimatedOutput": 680,
      "resultPath": "expansion/working/v2/results/yuan-118--305bc1ee9d0fb9488d6f201206436dde9c18ea8863a6222decaf8df8ab3ef300.json"
    },
    {
      "id": "yuan-119",
      "category": "元曲",
      "title": "一半儿",
      "subtitle": "题情二首",
      "author": "王和卿",
      "dynasty": "元",
      "content": "书来和泪怕开缄，又不归来空再三。这样病儿谁惯耽？\n越恁瘦岩岩。一半儿增添一半儿减。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "984fe0fd02fa272971d2598dbe3b5c788b72ddc88f8906b78899f6c087ac1afa",
