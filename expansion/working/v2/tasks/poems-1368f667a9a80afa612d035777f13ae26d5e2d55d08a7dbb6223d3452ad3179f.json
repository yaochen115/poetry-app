    },
    {
      "id": "yuan-120",
      "category": "元曲",
      "title": "红绣鞋",
      "subtitle": "暗朱箔雨寒风峭",
      "author": "任昱",
      "dynasty": "元",
      "content": "暗朱箔雨寒风峭，试罗衣玉减香销。落花时节怨良宵。\n银台灯影淡，绣枕泪痕交。团圆春梦少。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "8fd76409ad535cbd8418617c080711b1e5454876cf368d93ee8d024e71c2e648",
      "estimatedOutput": 686,
      "resultPath": "expansion/working/v2/results/yuan-120--8fd76409ad535cbd8418617c080711b1e5454876cf368d93ee8d024e71c2e648.json"
    },
    {
      "id": "yuan-121",
      "category": "元曲",
      "title": "四块玉",
      "subtitle": "南吕·马嵬坡",
      "author": "马致远",
      "dynasty": "元",
      "content": "睡海棠，春将晚。恨不得明皇掌中看。《霓裳》便是中原乱。不因这玉环，引起那禄山，怎知蜀道难！",
      "excerptOf": null,
      "excerptNote": "",
