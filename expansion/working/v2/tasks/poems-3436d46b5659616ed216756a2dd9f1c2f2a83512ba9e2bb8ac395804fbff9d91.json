    },
    {
      "id": "song-388",
      "category": "宋词",
      "title": "定风波",
      "subtitle": "",
      "author": "欧阳修",
      "dynasty": "宋",
      "content": "把酒花前欲问伊。问伊还记那回时。黯淡梨花笼月影。人静。画堂东畔药阑西。\n及至如今都不认。难问。有情谁道不相思。何事碧窗春睡觉。偷照。粉痕匀却湿胭脂。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "c674cae7e923d61eb6a10a1699832084a04f33dad7fd929f8a1848a41000a951",
      "estimatedOutput": 748,
      "resultPath": "expansion/working/v2/results/song-388--c674cae7e923d61eb6a10a1699832084a04f33dad7fd929f8a1848a41000a951.json"
    },
    {
      "id": "song-389",
      "category": "宋词",
      "title": "菩萨蛮",
      "subtitle": "君家玉雪花如屋",
      "author": "辛弃疾",
      "dynasty": "宋",
      "content": "君家玉雪花如屋。未应山下成三宿。啼鸟几曾催。西风犹未来。山房连石径。云卧衣裳冷。倩得李延年。清歌送上天。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "df1ce6a3acab930b3be118506bfe649008424201af82ff04f8fb4a881dece7b9",
      "estimatedOutput": 704,
      "resultPath": "expansion/working/v2/results/song-389--df1ce6a3acab930b3be118506bfe649008424201af82ff04f8fb4a881dece7b9.json"
    },
    {
      "id": "song-390",
      "category": "宋词",
      "title": "阮郎归",
      "subtitle": "",
      "author": "刘子寰",
      "dynasty": "宋",
      "content": "长条袅袅串红绡。无风时自摇。十分娇艳更苗条。殢春情态娇。\n风影舞，露痕潮。买来和蝶饶。故园愁绝楚宫腰。相逢恨怎销。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "a7d5148ed2c6014a07643956dafe6a945ae4bacb954abe9d73b51fb16e9c1408",
      "estimatedOutput": 714,
      "resultPath": "expansion/working/v2/results/song-390--a7d5148ed2c6014a07643956dafe6a945ae4bacb954abe9d73b51fb16e9c1408.json"
    },
    {
      "id": "song-391",
      "category": "宋词",
      "title": "沁园春",
      "subtitle": "冰壑平生",
      "author": "佚名",
      "dynasty": "宋",
      "content": "冰壑平生，如伯伦狂，似希乐豪。喜观书不用、菊茶明眼，登山不倩、藜杖扶腰。豆粥萍齑，脍羹鳞脯，湖海人常折简招。谁云老，有满怀风月，藏在诗瓢。凌晨向鹄冲霄。道昴宿于今又应萧。记垂弧令节，恰当後日，下元好景，正属前朝。冷胆如天，刚肠如剑，须把千杯寿酒浇。那堪更，是梅花时月，烂熳溪桥。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "3c02d54802c6fbc845f9e45d24d3fc82b06cd83e678d109f3b000ba10c21a54f",
      "estimatedOutput": 878,
      "resultPath": "expansion/working/v2/results/song-391--3c02d54802c6fbc845f9e45d24d3fc82b06cd83e678d109f3b000ba10c21a54f.json"
    },
    {
      "id": "song-392",
      "category": "宋词",
      "title": "满江红",
      "subtitle": "律转黄钟",
      "author": "范飞",
      "dynasty": "宋",
      "content": "律转黄钟，尧蓂尚、零星一叶。人尽道、当年此日，诞生豪杰。我是君家门下士，三年屡献阳春雪。更此行、骑鹤上扬州，恩稠叠。君有子，文章伯。君有女，夸才色。更风流酝藉，东床佳客。婿祝长生儿祝寿，玉杯举罢金杯接。愿年年、长醉腊前梅，梅梢月。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "e13bc7904594a600c9070d4df50de318af8680784dace554d681c2124027fc25",
      "estimatedOutput": 830,
      "resultPath": "expansion/working/v2/results/song-392--e13bc7904594a600c9070d4df50de318af8680784dace554d681c2124027fc25.json"
    },
    {
      "id": "song-393",
      "category": "宋词",
      "title": "唐多令",
      "subtitle": "人物盛乾淳",
      "author": "魏了翁",
      "dynasty": "宋",
      "content": "人物盛乾淳，东嘉最得人。费江山、几许精神。我已后时犹遍识，君子子、又相亲。\n秋入塞垣新。风寒上醉痕。万百般、倚靠苍旻。只愿诸贤长寿健，容老我、看闲身。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "b11328fb049942e9da8ca2615ec069c4ca328146a787dd393f7746e1d14e701b",
      "estimatedOutput": 750,
      "resultPath": "expansion/working/v2/results/song-393--b11328fb049942e9da8ca2615ec069c4ca328146a787dd393f7746e1d14e701b.json"
    },
    {
      "id": "song-394",
      "category": "宋词",
      "title": "鹧鸪天",
      "subtitle": "新月光寒昨夜霜",
      "author": "佚名",
      "dynasty": "宋",
      "content": "新月光寒昨夜霜。三年不一奉瑶觞。朱颜大药知能驻，白日仙家岂计长。枫渐赤，橘初黄。五湖烟水动归航。且倾寿酒歌难老，便见除书出未央。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "1f446763de8c911f48af9e2f61594e7ea3a9c2da8f87e892d06c887794de0b61",
      "estimatedOutput": 728,
      "resultPath": "expansion/working/v2/results/song-394--1f446763de8c911f48af9e2f61594e7ea3a9c2da8f87e892d06c887794de0b61.json"
    },
    {
      "id": "song-395",
      "category": "宋词",
      "title": "满江红",
      "subtitle": "",
      "author": "陈之贤",
      "dynasty": "宋",
      "content": "人物英雄，更独抱、无双才气。年正壮，文章武略，尽曾留意。破胆欲凭胸内甲，清原宴启舟中誓。笑区区、燕雀不能知，青云志。\n封侯貌，神人比。社下手，须荣试。况相门出将，君家常事。斗印垂金他日贵，寿杯浮玉今朝醉。看年年、南极倍明时，春明媚。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "524392a5f2ff297f941b159fa9e8426a7226ce8a5555cf6e44c97f5b7589bb35",
      "estimatedOutput": 832,
      "resultPath": "expansion/working/v2/results/song-395--524392a5f2ff297f941b159fa9e8426a7226ce8a5555cf6e44c97f5b7589bb35.json"
    },
    {
      "id": "song-396",
      "category": "宋词",
      "title": "满江红",
      "subtitle": "",
      "author": "佚名",
      "dynasty": "宋",
      "content": "雪共梅花，念动是、经年离拆。重会面、玉肌真态，一般标格。\n谁道无情应也妒，暗香埋没教谁识。却随风、偷入傍妆台，萦帘额。\n惊醉眼，朱成碧。随冷暖，分青白。叹朱弦冻折，高山音息。\n怅望关河无驿使，剡溪兴尽成陈迹。见似枝而喜对杨花，须相忆。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "3a71f9da2c419e7fcb808d41621a97011095bd3f99d0158dbe8340b57255682c",
      "estimatedOutput": 834,
      "resultPath": "expansion/working/v2/results/song-396--3a71f9da2c419e7fcb808d41621a97011095bd3f99d0158dbe8340b57255682c.json"
    },
    {
      "id": "song-397",
      "category": "宋词",
      "title": "虞美人",
      "subtitle": "清尊黄菊红萸佩",
      "author": "卢祖皋",
      "dynasty": "宋",
      "content": "清尊黄菊红萸佩。两度云岩醉。帽檐今日更清狂。冷雨疏风、著意过重阳。故宫历历遗烟树。往事知何处。漫山秋色好题诗。吟罢阑干、独自立多时。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "accb766e4fba161163560bfbf0e83644fdc3dc27aec46d69f74de200d91f47a8",
