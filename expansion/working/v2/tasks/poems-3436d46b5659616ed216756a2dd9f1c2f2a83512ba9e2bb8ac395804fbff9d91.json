    },
    {
      "id": "song-387",
      "category": "宋词",
      "title": "清平乐",
      "subtitle": "",
      "author": "刘翰",
      "dynasty": "宋",
      "content": "萋萋芳草。怨得王孙老。瘦损腰围罗带小。长是锦书来少。\n玉箫吹落梅花。晓寒犹透轻纱。惊起半屏幽梦，小窗淡月啼鸦。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "20e6e7ee03d41155898a501784a4f802a559fd70dfcb9249f4a0d028147a95c9",
