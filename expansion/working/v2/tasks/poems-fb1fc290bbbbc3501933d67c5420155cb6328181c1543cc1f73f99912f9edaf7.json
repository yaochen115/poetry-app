    {
      "id": "song-099",
      "category": "宋词",
      "title": "清平乐",
      "subtitle": "金风细细",
      "author": "晏殊",
      "dynasty": "宋",
      "content": "金风细细。叶叶梧桐坠。绿酒初尝人易醉。一枕小窗浓睡。 \n紫薇朱槿花残。斜阳却照阑干。双燕欲归时节，银屏昨夜微寒。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "fd51f0fe84cf9aeec91541c6498b9eb8b823078655107310818ac3af9ab80245",
