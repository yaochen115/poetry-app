    },
    {
      "id": "song-107",
      "category": "宋词",
      "title": "卜算子",
      "subtitle": "苕霅水能清",
      "author": "吴潜",
      "dynasty": "宋",
      "content": "苕霅水能清，更有人如水。秋水横边簇远山，相对盈盈里。 \n溪上有鸳鸯，艇子频惊起。何似收归碧玉池。长在阑干底。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "0699e9ae8dccfcd1102b7699a9e41721d201db8560cad0d0f2fb31b12e79c58c",
