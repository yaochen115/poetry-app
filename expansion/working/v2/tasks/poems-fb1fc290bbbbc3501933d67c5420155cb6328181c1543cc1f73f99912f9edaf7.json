    },
    {
      "id": "song-100",
      "category": "宋词",
      "title": "浪淘沙",
      "subtitle": "往事只堪哀",
      "author": "李煜",
      "dynasty": "五代·南唐",
      "content": "往事只堪哀，对景难排。秋风庭院藓侵阶。一任珠帘闲不卷，终日谁来。\n金锁已沉埋，壮气蒿莱。晚凉天净月华开。想得玉楼瑶殿影，空照秦淮。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "b9295f7efe9fe724708d96ca185193aecc7a2c1faa83f0a66b9558a7c9505d8b",
      "estimatedOutput": 730,
      "resultPath": "expansion/working/v2/results/song-100--b9295f7efe9fe724708d96ca185193aecc7a2c1faa83f0a66b9558a7c9505d8b.json"
    },
    {
      "id": "song-101",
      "category": "宋词",
      "title": "浣溪沙",
      "subtitle": "湖上西风急暮蝉",
      "author": "晏殊",
      "dynasty": "宋",
      "content": "湖上西风急暮蝉。夜来清露湿红莲。少留归骑促歌筵。 \n为别莫辞金盏酒。入朝须近玉炉烟。不知重会是何年。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "c4ca289c0b3e8ebde1713f7822c3e4f6f0224981a2b313b6541d0b7ff6bf8397",
      "estimatedOutput": 700,
      "resultPath": "expansion/working/v2/results/song-101--c4ca289c0b3e8ebde1713f7822c3e4f6f0224981a2b313b6541d0b7ff6bf8397.json"
    },
    {
      "id": "song-102",
      "category": "宋词",
      "title": "采桑子",
      "subtitle": "何人解赏西湖好",
      "author": "欧阳修",
      "dynasty": "宋",
      "content": "何人解赏西湖好，佳景无时。飞盖相追。贪向花间醉玉卮。\n谁知闲凭阑干处，芳草斜晖。水远烟微。一点沧洲白鹭飞。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "d249441b425280afda5770cc7396bfb8575d401b1b3dfd9956bb0257043ae569",
      "estimatedOutput": 706,
      "resultPath": "expansion/working/v2/results/song-102--d249441b425280afda5770cc7396bfb8575d401b1b3dfd9956bb0257043ae569.json"
    },
    {
      "id": "song-103",
      "category": "宋词",
      "title": "忆王孙",
      "subtitle": "春词",
      "author": "李重元",
      "dynasty": "宋",
      "content": "萋萋芳草忆王孙。柳外楼高空断魂。杜宇声声不忍闻。欲黄昏。雨打梨花深闭门。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "876813babfa3fa4108414ccb2f3a32d7557b213711b23fe59e7403abb4b1125d",
      "estimatedOutput": 672,
      "resultPath": "expansion/working/v2/results/song-103--876813babfa3fa4108414ccb2f3a32d7557b213711b23fe59e7403abb4b1125d.json"
    },
    {
      "id": "song-104",
      "category": "宋词",
      "title": "生查子",
      "subtitle": "重叶梅",
      "author": "辛弃疾",
      "dynasty": "宋",
      "content": "百花头上开，冰雪寒中见。霜月定相知，先识春风面。 \n主人情意深，不管江妃怨。折我最繁枝，还许冰壶荐。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "9997a06c7e840a1a038ca625ba34b455dfff07c0b84e037d761cbf23423c82c9",
      "estimatedOutput": 700,
      "resultPath": "expansion/working/v2/results/song-104--9997a06c7e840a1a038ca625ba34b455dfff07c0b84e037d761cbf23423c82c9.json"
    },
    {
      "id": "song-105",
      "category": "宋词",
      "title": "点绛唇",
      "subtitle": "丁未冬过吴松作",
      "author": "姜夔",
      "dynasty": "宋",
      "content": "燕雁无心，太湖西畔随云去。数峰清苦。商略黄昏雨。 \n第四桥边，拟共天随住。今何许。凭阑怀古。残柳参差舞。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "8763786ab2a0ea06a587b086940fcf9d3db1b9948385ee2bf91351758b0668db",
      "estimatedOutput": 704,
      "resultPath": "expansion/working/v2/results/song-105--8763786ab2a0ea06a587b086940fcf9d3db1b9948385ee2bf91351758b0668db.json"
    },
    {
      "id": "song-106",
      "category": "宋词",
      "title": "清平乐",
      "subtitle": "题上卢桥",
      "author": "辛弃疾",
      "dynasty": "宋",
      "content": "清溪奔快。不管青山碍。千里盘盘平世界。更著溪山襟带。 \n古今陵谷茫茫。市朝往往耕桑。此地居然形胜，似曾小小兴亡。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "72a15d2aabdc2e9b6e64ee8c18c89c5513d61b28ae7f9bb47f38009a493e7952",
