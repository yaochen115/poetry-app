    },
    {
      "id": "tang-834",
      "category": "唐诗",
      "title": "宜春再访芳公言公幽斋写怀叙事，因赋长言",
      "subtitle": "",
      "author": "郑谷",
      "dynasty": "唐",
      "content": "入门长恐先师在，香印纱灯似昔年，涧路萦回斋处远，松堂虚豁讲声圆。\n顷为弟子曾同社，今忝星郎更契缘。\n顾渚一瓯春有味，中林话旧亦潸然。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "c0a4cfbcb7a29e358a2a6f5dfa31c21b5dcfff554b0c79555331c0bcc2197d38",
      "estimatedOutput": 732,
      "resultPath": "expansion/working/v2/results/tang-834--c0a4cfbcb7a29e358a2a6f5dfa31c21b5dcfff554b0c79555331c0bcc2197d38.json"
    },
    {
      "id": "tang-835",
      "category": "唐诗",
      "title": "登封大酺歌四首",
      "subtitle": "",
      "author": "卢照邻",
      "dynasty": "唐",
      "content": "明君封禅日重光，天子垂衣历数长。\n九州四海常无事，万岁千秋乐未央。\n日观仙云随凤辇，天门瑞雪照龙衣。\n繁弦绮席方终夜，妙舞清歌欢未归。\n翠凤逶迤登介丘，仙鹤裴回天上游。\n借问乾封何所乐，人皆寿命得千秋。\n千年圣主应昌期，万国淳风王化基。\n请比上古无为代，何如今日太平时。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "1f5c1ca176c377100c9153fa4959cdb4f275e566836a7448e8f9bc765b415c4e",
      "estimatedOutput": 870,
      "resultPath": "expansion/working/v2/results/tang-835--1f5c1ca176c377100c9153fa4959cdb4f275e566836a7448e8f9bc765b415c4e.json"
    },
    {
      "id": "tang-836",
      "category": "唐诗",
      "title": "植灵寿木",
      "subtitle": "",
      "author": "柳宗元",
      "dynasty": "唐",
      "content": "白华鉴寒水，怡我适野情。\n前趋问长老，重复欣嘉名。\n蹇连易衰朽，方刚谢经菅。\n敢期齿杖赐？\n聊且移孤茎。\n丛萼中竞秀，分房处舒英。\n柔条乍反植，劲节常对生。\n循玩足忘疲，稍觉步武轻。\n安能事翦伐，持用资徒行。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "c0bb309b3182cf658d10a741f078095fe86be4ec7529f02995c725e9929345c1",
      "estimatedOutput": 808,
      "resultPath": "expansion/working/v2/results/tang-836--c0bb309b3182cf658d10a741f078095fe86be4ec7529f02995c725e9929345c1.json"
    },
    {
      "id": "tang-837",
      "category": "唐诗",
      "title": "三峡闻猿",
      "subtitle": "",
      "author": "贯休",
      "dynasty": "唐",
      "content": "历历数声猿，寥寥渡白烟。\n应栖多月树，况是下霜天。\n万里客危坐，千山境悄然。\n更深仍不住，使我欲移船。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "1922267d9e539801af5bf1c00d8d7c84418d803850b29868964f846700c0007d",
      "estimatedOutput": 702,
      "resultPath": "expansion/working/v2/results/tang-837--1922267d9e539801af5bf1c00d8d7c84418d803850b29868964f846700c0007d.json"
    },
    {
      "id": "tang-838",
      "category": "唐诗",
      "title": "别赵子（赵子名德，潮州人）",
      "subtitle": "",
      "author": "韩愈",
      "dynasty": "唐",
      "content": "我迁于揭阳，君先揭阳居。\n揭阳去京华，其里万有馀。\n不谓小郭中，有子可与娱。\n心平而行高，两通诗与书。\n婆娑海水南，簸弄明月珠。\n及我迁宜春，意欲携以俱。\n摆头笑且言，我岂不足欤。\n又奚为于北，往来以纷如。\n海中诸山中，幽子颇不无。\n相期风涛观，已久不可渝。\n又尝疑龙虾，果谁雄牙须。\n蚌蠃鱼鳖虫，瞿瞿以狙狙。\n识一已忘十，大同细自殊。\n欲一穷究之，时岁屡谢除。\n今子南且北，岂非亦有图。\n人心未尝同，不可一理区。\n宜各从所务，未用相贤愚。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "d0d2a7fbd746e2c63ae3ecf3366622087f6e6c6016e6eeb43c5a2e808995dc55",
      "estimatedOutput": 1040,
      "resultPath": "expansion/working/v2/results/tang-838--d0d2a7fbd746e2c63ae3ecf3366622087f6e6c6016e6eeb43c5a2e808995dc55.json"
    },
    {
      "id": "tang-839",
      "category": "唐诗",
      "title": "独游",
      "subtitle": "",
      "author": "王昌龄",
      "dynasty": "唐",
      "content": "林卧情每閒，独游景常晏。\n时从灞陵下，垂钓往南涧。\n手携双鲤鱼，目送千里雁。\n悟彼飞有适，知此罹忧患。\n放之清冷泉，因得省疏慢。\n永怀青岑客，回首白云间。\n神超物无违，岂系名与宦。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "c442b7be3ee26431b106df328ba44ae0fd4a17409a8681ef2abd6cd68851fabc",
      "estimatedOutput": 780,
      "resultPath": "expansion/working/v2/results/tang-839--c442b7be3ee26431b106df328ba44ae0fd4a17409a8681ef2abd6cd68851fabc.json"
    },
    {
      "id": "tang-840",
      "category": "唐诗",
      "title": "宋中遇陈二",
      "subtitle": "",
      "author": "高适",
      "dynasty": "唐",
      "content": "常忝鲍叔义，所期王佐才。\n如何守苦节，独此无良媒。\n离别十年外，飘飖千里来。\n安知罢官后，惟见柴门开。\n穷巷隐东郭，高堂咏南陔。\n篱根长花草，井上生莓苔。\n伊昔望霄汉，于今倦蒿莱。\n男儿命未达，且尽手中杯。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "1f9c4bad784dcbc06dc2c2692b415e56f341438f3fa0b77f38151974fa9da5b3",
      "estimatedOutput": 806,
      "resultPath": "expansion/working/v2/results/tang-840--1f9c4bad784dcbc06dc2c2692b415e56f341438f3fa0b77f38151974fa9da5b3.json"
    },
    {
      "id": "tang-841",
      "category": "唐诗",
      "title": "听百舌鸟",
      "subtitle": "",
      "author": "王维",
      "dynasty": "唐",
      "content": "上兰门外草萋萋，未央宫中花里栖。\n亦有相随过御苑，不知若个向金堤。\n入春解作千般语，拂曙能先百鸟啼。\n万户千门应觉晓，建章何必听鸣鸡。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "0ef53eaf72a08491a3c61182ab1644a6c196a22c3083a8a0a6c05cd5079c38e6",
      "estimatedOutput": 734,
      "resultPath": "expansion/working/v2/results/tang-841--0ef53eaf72a08491a3c61182ab1644a6c196a22c3083a8a0a6c05cd5079c38e6.json"
    },
    {
      "id": "tang-842",
      "category": "唐诗",
      "title": "酬和杜五弟晴朝独坐见赠",
      "subtitle": "",
      "author": "李峤",
      "dynasty": "唐",
      "content": "平明坐虚馆，旷望几悠哉。\n宿雾分空尽，朝光度隙来。\n影低藤架密，香动药阑开。\n未展山阳会，空留池上杯。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "1654c95d02a5b2d0c9a60d7f2e7a702ba1b5df0fba243d110488f1e8b5fc9c36",
      "estimatedOutput": 702,
      "resultPath": "expansion/working/v2/results/tang-842--1654c95d02a5b2d0c9a60d7f2e7a702ba1b5df0fba243d110488f1e8b5fc9c36.json"
    },
    {
      "id": "tang-843",
      "category": "唐诗",
      "title": "寄南浦谪官",
      "subtitle": "",
      "author": "郑谷",
      "dynasty": "唐",
      "content": "多才翻得罪，天末抱穷忧。\n白首为迁客，青山绕万州。\n醉欹梅障晓，歌厌竹枝秋。\n望阙怀乡泪，荆江水共流。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "9031d4ac6ff218f3ec90e1c9d17890f31dcd022c05d60bcd44b2ef71bb09e14a",
      "estimatedOutput": 702,
      "resultPath": "expansion/working/v2/results/tang-843--9031d4ac6ff218f3ec90e1c9d17890f31dcd022c05d60bcd44b2ef71bb09e14a.json"
    },
    {
      "id": "tang-844",
      "category": "唐诗",
      "title": "题海盐南馆",
      "subtitle": "",
      "author": "张祜",
      "dynasty": "唐",
      "content": "故人营此地，台馆尚依依。\n黑夜山魈语，黄昏海燕归。\n旧阴杨叶在，残雨槿花稀。\n无复南亭赏，高檐红烛辉。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "d720a1a03bec13e956d2783c20b2e0fc331002e628bdc21bf0abe1a2dc291197",
