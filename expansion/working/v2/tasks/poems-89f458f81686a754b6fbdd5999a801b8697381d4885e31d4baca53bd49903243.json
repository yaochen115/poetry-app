    {
      "id": "tang-833",
      "category": "唐诗",
      "title": "郊庙歌辞。梁太庙乐舞辞。来仪舞",
      "subtitle": "",
      "author": "佚名",
      "dynasty": "唐",
      "content": "於赫帝命，应天顺人。\n亭育品汇，宾礼百神。\n洪基永固，景命惟新。\n肃恭孝享，祚我生民。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "702eba03507b74d92fd842909964c3682ed519a57c29f99b4013cc5601c2c897",
      "estimatedOutput": 686,
