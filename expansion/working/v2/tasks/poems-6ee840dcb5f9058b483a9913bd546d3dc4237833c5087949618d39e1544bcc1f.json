    },
    {
      "id": "song-519",
      "category": "宋词",
      "title": "天仙子",
      "subtitle": "坐治吴州成乐土",
      "author": "张先",
      "dynasty": "宋",
      "content": "坐治吴州成乐土。\n诏卷风飞来圣语。\n亲舆乞得便藩归，瑶席主。\n杯休数。\n清夜为君歌白苎。\n花接旧枝新蕊吐。\n造化不知人有助。\n看花岁岁比甘棠，嘉月暮。\n东门路。\n只恐带将春色去。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "fa89dd885a87069e0e74d6356a1c6ef19f03ef69357c57b519c3b909257c9492",
      "estimatedOutput": 778,
      "resultPath": "expansion/working/v2/results/song-519--fa89dd885a87069e0e74d6356a1c6ef19f03ef69357c57b519c3b909257c9492.json"
    },
    {
      "id": "song-520",
      "category": "宋词",
      "title": "南乡子",
      "subtitle": "相并细腰身时样",
      "author": "张先",
      "dynasty": "宋",
      "content": "相并细腰身。\n时样宫妆一样新。\n曲项胡琴鱼尾拨，离人。\n入塞弦声水上闻。\n天碧染衣巾。\n血色轻罗碎摺裙。\n百卉已随霜女妒，东君。\n暗折双花借小春。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "67de8f0820bb17c44823a39ed7f5ed3031b05fd6e56b3f1da8673813642e954d",
      "estimatedOutput": 746,
      "resultPath": "expansion/working/v2/results/song-520--67de8f0820bb17c44823a39ed7f5ed3031b05fd6e56b3f1da8673813642e954d.json"
    },
    {
      "id": "song-521",
      "category": "宋词",
      "title": "少年游",
      "subtitle": "听歌持酒且休行",
      "author": "张先",
      "dynasty": "宋",
      "content": "听歌持酒且休行。\n云树几程程。\n眼看檐牙，手搓花蕊，未必两无情。\n拓夫滩上闻新雁，离袖掩盈盈。\n此恨无穷，远如江水，东去几时平。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "8231f6856de1c500f7459af34f8793183959be7cf46695a5e5cb2479b58515d8",
      "estimatedOutput": 728,
      "resultPath": "expansion/working/v2/results/song-521--8231f6856de1c500f7459af34f8793183959be7cf46695a5e5cb2479b58515d8.json"
    },
    {
      "id": "song-522",
      "category": "宋词",
      "title": "沁园春",
      "subtitle": "心膂良臣帷幄元",
      "author": "张先",
      "dynasty": "宋",
      "content": "心膂良臣，帷幄元勋，左右万几。\n暂武林分阃，东南外翰，锦衣乡社，未满瓜时。\n易镇梧台，宣条期岁，又西指夷桥千骑移。\n珠滩上，喜甘棠翠荫，依旧春晖。\n须知。\n系国安危。\n料节召、还趋浴凤池。\n且代工施化，持钧播泽，置盂天下，此外何思。\n素卷书名，赤松游道，飙驭云軿仙可期。\n湖山美，有啼猿唳鹤，相望东归。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "b0dbd0b26d9c62791b13c23e9ee4d172019190b8eff63dbaf44bc2af4ab3f4c2",
      "estimatedOutput": 902,
      "resultPath": "expansion/working/v2/results/song-522--b0dbd0b26d9c62791b13c23e9ee4d172019190b8eff63dbaf44bc2af4ab3f4c2.json"
    },
    {
      "id": "song-523",
      "category": "宋词",
      "title": "忆秦娥",
      "subtitle": "参差竹吹断相思",
      "author": "张先",
      "dynasty": "宋",
      "content": "参差竹。\n吹断相思曲。\n情不足。\n西北有楼穷远目。\n忆苕溪、寒影透清玉。\n秋雁南飞速。\n菰草绿。\n应下溪头沙上宿。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "5f44262f4bb368ae009437f09ffbec28d02fb35cf133daeffc23e34d52053381",
      "estimatedOutput": 714,
      "resultPath": "expansion/working/v2/results/song-523--5f44262f4bb368ae009437f09ffbec28d02fb35cf133daeffc23e34d52053381.json"
    },
    {
      "id": "song-524",
      "category": "宋词",
      "title": "清平乐",
      "subtitle": "青袍如草得意还",
      "author": "张先",
      "dynasty": "宋",
      "content": "青袍如草。\n得意还年少。\n马跃绿螭金络脑。\n寒食乍临新晓。\n曲池斜度鸾桥。\n西园一片笙箫。\n自欲剩留春住，风花无奈飘飘。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "0400a6e7d5ff5a483f0a2aa1e46e975c40134da7e5c31d333731b2c8972de5ce",
      "estimatedOutput": 720,
      "resultPath": "expansion/working/v2/results/song-524--0400a6e7d5ff5a483f0a2aa1e46e975c40134da7e5c31d333731b2c8972de5ce.json"
    },
    {
      "id": "song-525",
      "category": "宋词",
      "title": "菩萨蛮",
      "subtitle": "佳人学得平阳曲",
      "author": "张先",
      "dynasty": "宋",
      "content": "佳人学得平阳曲。\n纤纤玉笋横孤竹。\n一弄入云声。\n海门江月清。\n髻摇金钿落。\n惜恐樱唇薄。\n听罢已依依。\n莫吹杨柳枝。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "ce59beed930b28345397c6dd9f4c97a588e33868cb915549de0db4737d3a6200",
      "estimatedOutput": 718,
      "resultPath": "expansion/working/v2/results/song-525--ce59beed930b28345397c6dd9f4c97a588e33868cb915549de0db4737d3a6200.json"
    },
    {
      "id": "song-526",
      "category": "宋词",
      "title": "菩萨蛮",
      "subtitle": "藕丝衫翦猩红窄",
      "author": "张先",
      "dynasty": "宋",
      "content": "藕丝衫翦猩红窄。\n衫轻不碍琼肤白。\n缦鬓小横波。\n花楼东是家。\n上湖闲荡桨。\n粉艳芙蓉样。\n湖水亦多情。\n照妆天底清。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "74294b6d4d499f46cec7ce17df4c57c597c34f5fc8bc92ca07d3ed53a377553a",
      "estimatedOutput": 718,
      "resultPath": "expansion/working/v2/results/song-526--74294b6d4d499f46cec7ce17df4c57c597c34f5fc8bc92ca07d3ed53a377553a.json"
    },
    {
      "id": "song-527",
      "category": "宋词",
      "title": "菩萨蛮",
      "subtitle": "牛星织女年年别",
      "author": "张先",
      "dynasty": "宋",
      "content": "牛星织女年年别。\n分明不及人间物。\n匹鸟少孤飞。\n断沙犹并栖。\n洗车昏雨过。\n缺月云中堕。\n斜汉晓依依。\n暗蛩还促机。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "daed763ac519df21c9bbbf4b0a5b3ef1021ab6730865b2f4897d537f5cfe2f81",
      "estimatedOutput": 718,
      "resultPath": "expansion/working/v2/results/song-527--daed763ac519df21c9bbbf4b0a5b3ef1021ab6730865b2f4897d537f5cfe2f81.json"
    },
    {
      "id": "song-528",
      "category": "宋词",
      "title": "菩萨蛮",
      "subtitle": "双针竞引双丝缕",
      "author": "张先",
      "dynasty": "宋",
      "content": "双针竞引双丝缕。\n家家尽道迎牛女。\n不见渡河时。\n空闻乌鹊飞。\n西南低片月。\n应恐云梳发。\n寄语问星津。\n谁为得巧人。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "e296ad2af0562122917dd46452610d0dae388da8cd1f9de9e3eec9a3964c96cb",
