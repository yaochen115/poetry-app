    {
      "id": "yuan-267",
      "category": "元曲",
      "title": "正宫·叨叨令·自叹",
      "subtitle": "",
      "author": "周文质",
      "dynasty": "元",
      "content": "筑墙的曾入高宗梦，钓鱼的也应飞熊梦，受贫的是个凄凉梦，做官的是个荣华梦。笑煞人也么哥，笑煞人也么哥，梦中又说人间梦。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "700ad93eaf4518bedb950eb36ba69f1b32ac55f464a1ed64f87d7180415a50b3",
