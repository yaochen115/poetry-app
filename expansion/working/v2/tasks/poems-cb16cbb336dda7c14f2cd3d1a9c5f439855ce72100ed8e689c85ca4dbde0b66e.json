    },
    {
      "id": "song-1035",
      "category": "宋词",
      "title": "少年游",
      "subtitle": "西溪丹杏波前媚",
      "author": "晏几道",
      "dynasty": "宋",
      "content": "西溪丹杏，波前媚脸，珠露与深匀。\n南楼翠柳，烟中愁黛，丝雨恼娇颦。\n当年此处，闻歌殢酒，曾对可怜人。\n今夜相思，水长山远，闲卧送残春。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "63f3e08ade0aef5cecd611328a9f0d4401bfcfb800309842f4c3e9941a88ad6d",
      "estimatedOutput": 734,
      "resultPath": "expansion/working/v2/results/song-1035--63f3e08ade0aef5cecd611328a9f0d4401bfcfb800309842f4c3e9941a88ad6d.json"
    },
    {
      "id": "song-1036",
      "category": "宋词",
      "title": "少年游",
      "subtitle": "西楼别后风高露",
      "author": "晏几道",
      "dynasty": "宋",
      "content": "西楼别后，风高露冷，无奈月分明。\n飞鸿影里，捣衣砧外，总是玉关情。\n王孙此际，山重水远，何处赋西征。\n金闺魂梦枉丁宁。\n寻尽短长亭。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "b3fce2dd366817a1cad8b62407e0d6de13be981da7cfcd75c801f06e082addba",
      "estimatedOutput": 732,
      "resultPath": "expansion/working/v2/results/song-1036--b3fce2dd366817a1cad8b62407e0d6de13be981da7cfcd75c801f06e082addba.json"
    },
    {
      "id": "song-1037",
      "category": "宋词",
      "title": "少年游",
      "subtitle": "雕梁燕去裁诗寄",
      "author": "晏几道",
      "dynasty": "宋",
      "content": "雕梁燕去，裁诗寄远，庭院旧风流。\n黄花醉了，碧梧题罢，闲卧对高秋。\n繁云破后，分明素月，凉影挂金钩。\n有人凝澹倚西楼。\n新样两眉愁。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "2073a90759fcce1ae5122dae1d1e33952d4175908385a4f0d2a6140631d8c53d",
      "estimatedOutput": 732,
      "resultPath": "expansion/working/v2/results/song-1037--2073a90759fcce1ae5122dae1d1e33952d4175908385a4f0d2a6140631d8c53d.json"
    },
    {
      "id": "song-1038",
      "category": "宋词",
      "title": "虞美人",
      "subtitle": "闲敲玉镫隋堤路",
      "author": "晏几道",
      "dynasty": "宋",
      "content": "闲敲玉镫隋堤路。\n一笑开朱户。\n素云凝澹月婵娟。\n门外鸭头春水、木兰船。\n吹花拾蕊嬉游惯。\n天与相逢晚。\n一声长笛倚楼时。\n应恨不题红叶、寄相思。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "0bd02f579dd95fad3b06ab4eb59b62d6379aa1d409e16387924e2febc4054305",
      "estimatedOutput": 746,
      "resultPath": "expansion/working/v2/results/song-1038--0bd02f579dd95fad3b06ab4eb59b62d6379aa1d409e16387924e2febc4054305.json"
    },
    {
      "id": "song-1039",
      "category": "宋词",
      "title": "虞美人",
      "subtitle": "飞花自有牵情处",
      "author": "晏几道",
      "dynasty": "宋",
      "content": "飞花自有牵情处。\n不向枝边坠。\n随风飘荡已堪愁。\n更伴东流流水、过秦楼。\n楼中翠黛含春怨。\n闲倚阑干见。\n远弹双泪惜香红。\n暗恨玉颜光景、与花同。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "3f95446e2d0228500d15abc85888357520a415cc9821abac3291acfac78581f1",
      "estimatedOutput": 746,
      "resultPath": "expansion/working/v2/results/song-1039--3f95446e2d0228500d15abc85888357520a415cc9821abac3291acfac78581f1.json"
    },
    {
      "id": "song-1040",
      "category": "宋词",
      "title": "虞美人",
      "subtitle": "曲阑干外天如水",
      "author": "晏几道",
      "dynasty": "宋",
      "content": "曲阑干外天如水。\n昨夜还曾倚。\n初将明月比佳期。\n长向月圆时候、望人归。\n罗衣著破前香在。\n旧意谁教改。\n一春离恨懒调弦。\n犹有两行闲泪、宝筝前。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "18ad6e242ef5f2290071124bec9a79abb77430d9068c317c8b102659d50c8fcb",
      "estimatedOutput": 746,
      "resultPath": "expansion/working/v2/results/song-1040--18ad6e242ef5f2290071124bec9a79abb77430d9068c317c8b102659d50c8fcb.json"
    },
    {
      "id": "song-1041",
      "category": "宋词",
      "title": "虞美人",
      "subtitle": "疏梅月下歌金缕",
      "author": "晏几道",
      "dynasty": "宋",
      "content": "疏梅月下歌金缕。\n忆共文君语。\n更谁情浅似春风。\n一夜满枝新绿、替残红。\n苹香已有莲开信。\n两桨佳期近。\n采莲时节定来无。\n醉后满身花影、倩人扶。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "2d4c45b1b3bd4f384d15a0295debe11fb117de6438bf1a03675817e040a48a98",
      "estimatedOutput": 746,
      "resultPath": "expansion/working/v2/results/song-1041--2d4c45b1b3bd4f384d15a0295debe11fb117de6438bf1a03675817e040a48a98.json"
    },
    {
      "id": "song-1042",
      "category": "宋词",
      "title": "虞美人",
      "subtitle": "玉箫吹遍烟花路",
      "author": "晏几道",
      "dynasty": "宋",
      "content": "玉箫吹遍烟花路。\n小谢经年去。\n更教谁画远山眉。\n又是陌头风细、恼人时。\n时光不解年年好。\n叶上秋声早。\n可怜蝴蝶易分飞。\n只有杏梁双燕、每来归。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "e269e5cb7700ab96604e3efd3468246ea10811307820e9271f050d802afa3238",
      "estimatedOutput": 746,
      "resultPath": "expansion/working/v2/results/song-1042--e269e5cb7700ab96604e3efd3468246ea10811307820e9271f050d802afa3238.json"
    },
    {
      "id": "song-1043",
      "category": "宋词",
      "title": "虞美人",
      "subtitle": "秋风不似春风好",
      "author": "晏几道",
      "dynasty": "宋",
      "content": "秋风不似春风好。\n一夜金英老。\n更谁来凭曲阑干。\n惟有雁边斜月、照关山。\n双星旧约年年在。\n笑尽人情改。\n有期无定是无期。\n说与小云新恨、也低眉。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "0cc93a41c10e4a7991b0d9b7c2bf4d13c362149ff071f9248abb9c6e350b2c43",
      "estimatedOutput": 746,
      "resultPath": "expansion/working/v2/results/song-1043--0cc93a41c10e4a7991b0d9b7c2bf4d13c362149ff071f9248abb9c6e350b2c43.json"
    },
    {
      "id": "song-1044",
      "category": "宋词",
      "title": "虞美人",
      "subtitle": "湿红笺纸回纹字",
      "author": "晏几道",
      "dynasty": "宋",
      "content": "湿红笺纸回纹字。\n多少柔肠事。\n去年双燕欲归时。\n还是碧云千里、锦书迟。\n南楼风月长依旧。\n别恨无端有。\n倩谁横笛倚危阑。\n今夜落梅声里、怨关山。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "15d42a104db8abf7a150d97b5f71da9831b1ca8b875638d2596d8baa8e14a49e",
      "estimatedOutput": 746,
      "resultPath": "expansion/working/v2/results/song-1044--15d42a104db8abf7a150d97b5f71da9831b1ca8b875638d2596d8baa8e14a49e.json"
    },
    {
      "id": "song-1045",
      "category": "宋词",
      "title": "虞美人",
      "subtitle": "一弦弹尽仙韶乐",
      "author": "晏几道",
      "dynasty": "宋",
      "content": "一弦弹尽仙韶乐。\n曾破千金学。\n玉楼银烛夜深深。\n愁见曲中双泪、落香襟。\n从来不奈离声怨。\n几度朱弦断。\n未知谁解赏新音。\n长是好风明月、暗知心。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "b7d2aa69023668aa7dfe897d80e29b7b3d96b561e0d90a980c13aa6efbacada0",
