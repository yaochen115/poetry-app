    {
      "id": "tang-665",
      "category": "唐诗",
      "title": "小池二首",
      "subtitle": "",
      "author": "白居易",
      "dynasty": "唐",
      "content": "昼倦前斋热，晚爱小池清。\n映林馀景没，近水微凉生。\n坐把蒲葵扇，闲吟三两声。\n有意不在大，湛湛方丈馀。\n荷侧泻清露，萍开见游鱼。\n每一临此坐，忆归青溪居。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "00ca6247684323bc1d7571ee15b0de5dfedd217f6a835097d2774cf0818cd7c8",
      "estimatedOutput": 754,
      "resultPath": "expansion/working/v2/results/tang-665--00ca6247684323bc1d7571ee15b0de5dfedd217f6a835097d2774cf0818cd7c8.json"
    },
    {
      "id": "tang-666",
      "category": "唐诗",
      "title": "咏怀古迹五首",
      "subtitle": "其一",
      "author": "杜甫",
      "dynasty": "唐",
      "content": "支离东北风尘际，漂泊西南天地间。\n三峡楼台淹日月，五溪衣服共云山。\n羯胡事主终无赖，词客哀时且未还。\n庾信平生最萧瑟，暮年诗赋动江关。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "16b10695a214f88f7e6656a1c476b20eefcfb8968513745ec5decf72745b8b37",
      "estimatedOutput": 734,
      "resultPath": "expansion/working/v2/results/tang-666--16b10695a214f88f7e6656a1c476b20eefcfb8968513745ec5decf72745b8b37.json"
    },
    {
      "id": "tang-667",
      "category": "唐诗",
      "title": "寻南溪常山道人隐居",
      "subtitle": "",
      "author": "刘长卿",
      "dynasty": "唐",
      "content": "一路经行处，莓苔见履痕。\n白云依静渚，春草闭闲门。\n过雨看松色，随山到水源。\n溪花与禅意，相对亦忘言。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "211693ed4c2e2dbc0e8175bc5b972f4673f7ccf7883c8256d041cf369617ce4c",
      "estimatedOutput": 702,
      "resultPath": "expansion/working/v2/results/tang-667--211693ed4c2e2dbc0e8175bc5b972f4673f7ccf7883c8256d041cf369617ce4c.json"
    },
    {
      "id": "tang-668",
      "category": "唐诗",
      "title": "赋得自君之出矣",
      "subtitle": "",
      "author": "张九龄",
      "dynasty": "唐",
      "content": "自君之出矣，不复理残机。\n思君如满月，夜夜减清辉。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "d81b8ab0eaf338f914cdd31397c31640461aef25eb3271bc1ba5bf429506fc9d",
      "estimatedOutput": 650,
      "resultPath": "expansion/working/v2/results/tang-668--d81b8ab0eaf338f914cdd31397c31640461aef25eb3271bc1ba5bf429506fc9d.json"
    },
    {
      "id": "tang-669",
      "category": "唐诗",
      "title": "韩冬郎即席为诗相送一座尽惊他日余方追吟连宵侍坐裴回久之句有老成之风因成二绝寄酬兼呈畏之员外",
      "subtitle": "其一",
      "author": "李商隐",
      "dynasty": "唐",
      "content": "十岁裁诗走马成，冷灰残烛动离情。\n桐花万里丹山路，雏凤清于老凤声。\n剑栈风樯各苦辛，别时冰雪到时春。\n为凭何逊休联句，瘦尽东阳姓沈人。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "8fe5baf25c74aac580d92fc9e5233994214e44057fd6506993f72e5e536a1923",
      "estimatedOutput": 734,
      "resultPath": "expansion/working/v2/results/tang-669--8fe5baf25c74aac580d92fc9e5233994214e44057fd6506993f72e5e536a1923.json"
    },
    {
      "id": "tang-670",
      "category": "唐诗",
      "title": "月",
      "subtitle": "",
      "author": "李商隐",
      "dynasty": "唐",
      "content": "池上与桥边，难忘复可怜。\n帘开最明夜，簟卷已凉天。\n流处水花急，吐时云叶鲜。\n姮娥无粉黛，只是逞婵娟。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "a36baabaaa60b737a8acda38797361f735f69717ca1db89dd0c1da222387df86",
      "estimatedOutput": 702,
      "resultPath": "expansion/working/v2/results/tang-670--a36baabaaa60b737a8acda38797361f735f69717ca1db89dd0c1da222387df86.json"
    },
    {
      "id": "tang-671",
      "category": "唐诗",
      "title": "武侯庙",
      "subtitle": "",
      "author": "杜甫",
      "dynasty": "唐",
      "content": "遗庙丹青落，空山草木长。\n犹闻辞后主，不复卧南阳。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "904bfe4fb6942a1d1820be9dc710a1b86aded210df5c5909ce72c12a2575e86b",
      "estimatedOutput": 650,
      "resultPath": "expansion/working/v2/results/tang-671--904bfe4fb6942a1d1820be9dc710a1b86aded210df5c5909ce72c12a2575e86b.json"
    },
    {
      "id": "tang-672",
      "category": "唐诗",
      "title": "望木瓜山",
      "subtitle": "",
      "author": "李白",
      "dynasty": "唐",
      "content": "早起见日出，暮见栖鸟还。\n客心自酸楚，况对木瓜山。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "93d5d99e7973dc7a557efe4bfff3010a94a490c676b873b3895bc4102ddce98c",
      "estimatedOutput": 650,
      "resultPath": "expansion/working/v2/results/tang-672--93d5d99e7973dc7a557efe4bfff3010a94a490c676b873b3895bc4102ddce98c.json"
    },
    {
      "id": "tang-673",
      "category": "唐诗",
      "title": "金陵新亭",
      "subtitle": "",
      "author": "李白",
      "dynasty": "唐",
      "content": "金陵风景好，豪士集新亭。\n举目山河异，偏伤周顗情。\n四坐楚囚悲，不忧社稷倾。\n王公何慷慨，千载仰雄名。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "a2e0736bd180628472a1fadcf4fd03d097510505530b8c956cb5dc8e7b7cae69",
      "estimatedOutput": 702,
      "resultPath": "expansion/working/v2/results/tang-673--a2e0736bd180628472a1fadcf4fd03d097510505530b8c956cb5dc8e7b7cae69.json"
    },
    {
      "id": "tang-674",
      "category": "唐诗",
      "title": "杨柳枝词九首",
      "subtitle": "其一",
      "author": "刘禹锡",
      "dynasty": "唐",
      "content": "塞北梅花羌笛吹，淮南桂树小山词。\n请君莫奏前朝曲，听唱新翻杨柳枝。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "c638904b58528f4dc8b9a9e417233c5b708b0e1f59982118f84c80a1dd835ab7",
      "estimatedOutput": 666,
      "resultPath": "expansion/working/v2/results/tang-674--c638904b58528f4dc8b9a9e417233c5b708b0e1f59982118f84c80a1dd835ab7.json"
    },
    {
      "id": "tang-675",
      "category": "唐诗",
      "title": "九日送别",
      "subtitle": "",
      "author": "王之涣",
      "dynasty": "唐",
      "content": "蓟庭萧瑟故人稀，何处登高且送归。\n今日暂同芳菊酒，明朝应作断蓬飞。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "4d95935668379cd228dc898618156aaf14be78a57086e1fe0c18186033af757b",
      "estimatedOutput": 666,
      "resultPath": "expansion/working/v2/results/tang-675--4d95935668379cd228dc898618156aaf14be78a57086e1fe0c18186033af757b.json"
    },
    {
      "id": "tang-676",
      "category": "唐诗",
      "title": "绝句六首",
      "subtitle": "",
      "author": "杜甫",
      "dynasty": "唐",
      "content": "日出篱东水，云生舍北泥。\n竹高鸣翡翠，沙僻舞鹍鸡。\n蔼蔼花蕊乱，飞飞蜂蝶多。\n幽栖身懒动，客至欲如何。\n凿井交棕叶，开渠断竹根。\n扁舟轻褭缆，小径曲通村。\n急雨捎溪足，斜晖转树腰。\n隔巢黄鸟并，翻藻白鱼跳。\n舍下笋穿壁，庭中藤刺檐。\n地晴丝冉冉，江白草纤纤。\n江动月移石，溪虚云傍花。\n鸟栖知故道，帆过宿谁家。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "5c16cf9e15c705d2d081c99fcf56f055dae9d65265113aa965ee51c198d3a83f",
