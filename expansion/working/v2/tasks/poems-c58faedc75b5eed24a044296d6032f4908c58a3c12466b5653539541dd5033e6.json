    {
      "id": "song-879",
      "category": "宋词",
      "title": "临江仙",
      "subtitle": "弄水亭前千万景",
      "author": "俞紫芝",
      "dynasty": "宋",
      "content": "弄水亭前千万景，登临不忍空回。\n水轻墨澹写蓬莱。\n莫教世眼，容易洗尘埃。\n收去雨昏都不见，展时还似云开。\n先生高趣更多才。\n人人尽道，小杜却重来。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "56b5c62a2dea2717744ead617dcad53c1cb65384187796cccc1d930734d73b80",
      "estimatedOutput": 746,
      "resultPath": "expansion/working/v2/results/song-879--56b5c62a2dea2717744ead617dcad53c1cb65384187796cccc1d930734d73b80.json"
    },
    {
      "id": "song-880",
      "category": "宋词",
      "title": "苏幕遮",
      "subtitle": "地锺灵天应瑞簇",
      "author": "俞紫芝",
      "dynasty": "宋",
      "content": "地锺灵，天应瑞。\n簇簇香苞、团作真珠蕊。\n玉宇瑶台分十二。\n要伴姮娥，月里双双睡。\n月如花，花似月。\n花月生香，添此真奇异。\n不许扬州夸间气。\n昨夜春风，唤醒琼琼醉。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "16ce27975b4d68c0345fde84806db53c5089652f9f59c039ab0ac30986125274",
      "estimatedOutput": 766,
      "resultPath": "expansion/working/v2/results/song-880--16ce27975b4d68c0345fde84806db53c5089652f9f59c039ab0ac30986125274.json"
    },
    {
      "id": "song-881",
      "category": "宋词",
      "title": "好事近",
      "subtitle": "江上探春回正值",
      "author": "郑獬",
      "dynasty": "宋",
      "content": "江上探春回，正值早梅时节。\n两行小槽双凤，按凉州初彻。\n谢娘扶下绣鞍来，红靴踏残雪。\n归去不须银烛，有山头明月。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "f039d337f1bc95c515ff154c93357e326ba25128ff6795f13d2ef1241a98c20d",
      "estimatedOutput": 712,
      "resultPath": "expansion/working/v2/results/song-881--f039d337f1bc95c515ff154c93357e326ba25128ff6795f13d2ef1241a98c20d.json"
    },
    {
      "id": "song-882",
      "category": "宋词",
      "title": "好事近",
      "subtitle": "把酒对江梅花小",
      "author": "郑獬",
      "dynasty": "宋",
      "content": "把酒对江梅，花小未禁风力。\n何计不教零落，为青春留得。\n故人莫问在天涯，尊前苦相忆。\n好把素香收取，寄江南消息。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "c535d3185f40de3845e205c27e98cf99e4aa3df6ca0a92f22544ebcdff1dc26b",
      "estimatedOutput": 712,
      "resultPath": "expansion/working/v2/results/song-882--c535d3185f40de3845e205c27e98cf99e4aa3df6ca0a92f22544ebcdff1dc26b.json"
    },
    {
      "id": "song-883",
      "category": "宋词",
      "title": "渔家傲",
      "subtitle": "雪月照梅溪畔路",
      "author": "强至",
      "dynasty": "宋",
      "content": "雪月照梅溪畔路。\n幽姿背立无言语。\n冷浸瘦枝清浅处。\n香暗度。\n妆成处士横斜句。\n浑似玉人常淡伫。\n菱花相对盈清楚。\n谁解小图先画取。\n天欲曙。\n恐随月色云间去。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "2dfd18b5557543e29188c29d3c13ebbdebb7f15ea6101429f14f44b177d6d1e1",
      "estimatedOutput": 762,
      "resultPath": "expansion/working/v2/results/song-883--2dfd18b5557543e29188c29d3c13ebbdebb7f15ea6101429f14f44b177d6d1e1.json"
    },
    {
      "id": "song-884",
      "category": "宋词",
      "title": "减字木兰花",
      "subtitle": "纤纤素手盘里醉",
      "author": "陈汝羲",
      "dynasty": "宋",
      "content": "纤纤素手。\n盘里醉花新点就。\n对叶双心。\n别有东风意思深。\n琼沾粉缀。\n消得玉堂留客醉。\n试嗅清芳。\n别有红罗巧袖香。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "23d0dd1f65359960869719670d71fb5524d3e1403a1176b923357156ec262341",
      "estimatedOutput": 718,
      "resultPath": "expansion/working/v2/results/song-884--23d0dd1f65359960869719670d71fb5524d3e1403a1176b923357156ec262341.json"
    },
    {
      "id": "song-885",
      "category": "宋词",
      "title": "鹧鸪天",
      "subtitle": "腊后春前暖律催",
      "author": "范纯仁",
      "dynasty": "宋",
      "content": "腊后春前暖律催。\n日和风软欲开梅。\n公方结客寻佳景，我亦忘形趁酒杯。\n添歌管，续尊罍。\n更阑烛短未能回。\n清欢莫待相期约，乘兴来时便可来。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "409d387ef0a9452099bc8db73fcf0fa248ce873d20496a46f59dd884e2a4fd78",
      "estimatedOutput": 738,
      "resultPath": "expansion/working/v2/results/song-885--409d387ef0a9452099bc8db73fcf0fa248ce873d20496a46f59dd884e2a4fd78.json"
    },
    {
      "id": "song-886",
      "category": "宋词",
      "title": "渔家傲",
      "subtitle": "深愿弘慈无缝罅",
      "author": "寿涯禅师",
      "dynasty": "宋",
      "content": "深愿弘慈无缝罅。\n乘时走入众生界。\n窈窕丰姿都没赛。\n提鱼卖。\n堪笑马郎来纳败。\n清冷露湿金襽坏。\n茜裙不把珠缨盖。\n特地掀来呈捏怪。\n牵人爱。\n还尽许多菩萨债。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "c094c0bbf375a360692e5a10f2c8a514fd7b286d8a339d28be19fa2ad4844745",
      "estimatedOutput": 762,
      "resultPath": "expansion/working/v2/results/song-886--c094c0bbf375a360692e5a10f2c8a514fd7b286d8a339d28be19fa2ad4844745.json"
    },
    {
      "id": "song-887",
      "category": "宋词",
      "title": "水龙吟",
      "subtitle": "燕忙莺懒花残正",
      "author": "章",
      "dynasty": "宋",
      "content": "燕忙莺懒花残，正堤上、柳花飘坠。\n轻飞点画青林，谁道全无才思。\n闲趁游丝，静临深院，日长门闭。\n傍珠帘散漫，垂垂欲下，依前被，风扶起。\n兰帐玉人睡觉，怪春衣、雪粘琼缀。\n绣床旋满，香球无数，才圆却碎。\n时见蜂儿，仰粘轻粉，鱼吹池水。\n望章台路杳，金鞍游荡，有盈盈泪。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "5c04601929af80a92723e32d467d65a2701b2e7dc1b7c14769e4716b23bce4de",
      "estimatedOutput": 866,
      "resultPath": "expansion/working/v2/results/song-887--5c04601929af80a92723e32d467d65a2701b2e7dc1b7c14769e4716b23bce4de.json"
    },
    {
      "id": "song-888",
      "category": "宋词",
      "title": "点绛唇",
      "subtitle": "秋气微凉梦回明",
      "author": "王安国",
      "dynasty": "宋",
      "content": "秋气微凉，梦回明月穿帘幕。\n井梧萧索。\n正绕南枝鹊。\n宝瑟尘生，金雁空零落。\n情无托。\n鬓云慵掠。\n不似君恩薄。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "316b94ca2a5787b35c20d3448bb3d999d05640579c744808fe480ab0ebf2cc41",
      "estimatedOutput": 712,
      "resultPath": "expansion/working/v2/results/song-888--316b94ca2a5787b35c20d3448bb3d999d05640579c744808fe480ab0ebf2cc41.json"
    },
    {
      "id": "song-889",
      "category": "宋词",
      "title": "减字木兰花",
      "subtitle": "画桥流水雨湿落",
      "author": "王安国",
      "dynasty": "宋",
      "content": "画桥流水。\n雨湿落红飞不起。\n月破黄昏。\n帘里馀香马上闻。\n徘徊不语。\n今夜梦魂何处去。\n不似垂杨。\n犹解飞花入洞房。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "80c841490a07bcab0ab9ecf958863a67f843d9654b1d0b3074ffc42e9e334976",
