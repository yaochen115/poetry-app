    },
    {
      "id": "yuan-219",
      "category": "元曲",
      "title": "人月圆·会稽怀古",
      "subtitle": "",
      "author": "张可久",
      "dynasty": "元",
      "content": "林深藏却云门寺，回首若耶溪。苎萝人去，蓬莱山在，老树荒碑。\n神仙何处，烧丹傍井，试墨临池。荷花十里，清风鉴水，明月天衣。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "dfa4cae55b7f0944c9df225fa43d8e1475a5b70f60f925b4c6d99cd51a4f82aa",
