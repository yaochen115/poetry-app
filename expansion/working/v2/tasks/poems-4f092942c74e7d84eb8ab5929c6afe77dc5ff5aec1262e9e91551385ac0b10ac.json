    },
    {
      "id": "guwen-459",
      "category": "古文",
      "title": "围炉夜话·第一六Ｏ则",
      "subtitle": "",
      "author": "王永彬",
      "dynasty": "清",
      "content": "有守虽无所展布，而其节不挠，故与有猷有为而并重；立言即未经起行，而于人有益，故与立功立德而并传。",
      "excerptOf": "围炉夜话",
      "excerptNote": "完整选录《围炉夜话》中“第一六Ｏ则”一则或一章；非全书。",
      "inputHash": "0fa404bd57a26a3187072e451fc4871d07414dae9b0ff1240690ce01fa2cb50e",
      "estimatedOutput": 744,
      "resultPath": "expansion/working/v2/results/guwen-459--0fa404bd57a26a3187072e451fc4871d07414dae9b0ff1240690ce01fa2cb50e.json"
    },
    {
      "id": "guwen-460",
      "category": "古文",
      "title": "围炉夜话·第一六一则",
      "subtitle": "",
      "author": "王永彬",
      "dynasty": "清",
      "content": "遇老成人，便肯殷殷求教，则向善必笃也；听切实话，觉得津津有味，则进德可期也。",
      "excerptOf": "围炉夜话",
      "excerptNote": "完整选录《围炉夜话》中“第一六一则”一则或一章；非全书。",
      "inputHash": "fe93514bb72a0f89ea94a4bf13b868f224c12c8c858610dda52e27845c0d5d52",
      "estimatedOutput": 714,
      "resultPath": "expansion/working/v2/results/guwen-460--fe93514bb72a0f89ea94a4bf13b868f224c12c8c858610dda52e27845c0d5d52.json"
    },
    {
      "id": "guwen-461",
      "category": "古文",
      "title": "围炉夜话·第一六二则",
      "subtitle": "",
      "author": "王永彬",
      "dynasty": "清",
      "content": "有真性情，须有真涵养：有大识见，乃有大文章。",
      "excerptOf": "围炉夜话",
      "excerptNote": "完整选录《围炉夜话》中“第一六二则”一则或一章；非全书。",
      "inputHash": "f4a80f19c18bc49dedd73726b0101b309dcad378a55e2d51c575d91e6b287e09",
      "estimatedOutput": 666,
      "resultPath": "expansion/working/v2/results/guwen-461--f4a80f19c18bc49dedd73726b0101b309dcad378a55e2d51c575d91e6b287e09.json"
    },
    {
      "id": "guwen-462",
      "category": "古文",
      "title": "围炉夜话·第一六三则",
      "subtitle": "",
      "author": "王永彬",
      "dynasty": "清",
      "content": "为善之端无尽，只讲一让字，便人人可行；立身之道何穷，只得一敬字，便事事皆整。",
      "excerptOf": "围炉夜话",
      "excerptNote": "完整选录《围炉夜话》中“第一六三则”一则或一章；非全书。",
      "inputHash": "54466c6dfe82e9502f4d8e7d8723a276ef3417e451479d11511872514ba6cd67",
      "estimatedOutput": 714,
      "resultPath": "expansion/working/v2/results/guwen-462--54466c6dfe82e9502f4d8e7d8723a276ef3417e451479d11511872514ba6cd67.json"
    },
    {
      "id": "guwen-463",
      "category": "古文",
      "title": "围炉夜话·第一六四则",
      "subtitle": "",
      "author": "王永彬",
      "dynasty": "清",
      "content": "自己所行之是非，尚不能知，安望知人？古人以往之得失，且不必论，但须记己。",
      "excerptOf": "围炉夜话",
      "excerptNote": "完整选录《围炉夜话》中“第一六四则”一则或一章；非全书。",
      "inputHash": "929034f8f605c75f5bc10eb8fea7f0e7f10085339ad745b7c748cb84800d012a",
      "estimatedOutput": 708,
      "resultPath": "expansion/working/v2/results/guwen-463--929034f8f605c75f5bc10eb8fea7f0e7f10085339ad745b7c748cb84800d012a.json"
    },
    {
      "id": "guwen-464",
      "category": "古文",
      "title": "围炉夜话·第一六五则",
      "subtitle": "",
      "author": "王永彬",
      "dynasty": "清",
      "content": "治术必本儒术者，念念皆仁厚也；今人不及古人者，事事皆虚浮也。",
      "excerptOf": "围炉夜话",
      "excerptNote": "完整选录《围炉夜话》中“第一六五则”一则或一章；非全书。",
      "inputHash": "63fb36e7513abc647c365aa79346f5853a9ae383db73f70d71a1bf472c3b577e",
      "estimatedOutput": 690,
      "resultPath": "expansion/working/v2/results/guwen-464--63fb36e7513abc647c365aa79346f5853a9ae383db73f70d71a1bf472c3b577e.json"
    },
    {
      "id": "guwen-465",
      "category": "古文",
      "title": "围炉夜话·第一六六则",
      "subtitle": "",
      "author": "王永彬",
      "dynasty": "清",
      "content": "莫之大祸，起于须臾之不忍，不可不谨。",
      "excerptOf": "围炉夜话",
      "excerptNote": "完整选录《围炉夜话》中“第一六六则”一则或一章；非全书。",
      "inputHash": "5ffd7463d7764c97ed6363facdcf1721ac4372e8d53e09e0fb54c1c60988a083",
      "estimatedOutput": 654,
      "resultPath": "expansion/working/v2/results/guwen-465--5ffd7463d7764c97ed6363facdcf1721ac4372e8d53e09e0fb54c1c60988a083.json"
    },
    {
      "id": "guwen-466",
      "category": "古文",
      "title": "围炉夜话·第一六七则",
      "subtitle": "",
      "author": "王永彬",
      "dynasty": "清",
      "content": "家之长幼，皆倚赖于我，我亦尝体其情否也？士之衣食，皆取资于人，人亦曾受其益否也？",
      "excerptOf": "围炉夜话",
      "excerptNote": "完整选录《围炉夜话》中“第一六七则”一则或一章；非全书。",
      "inputHash": "34b245c845374ed63af44c426fc339c3edbff6b135890a15a039687c3552b9c2",
      "estimatedOutput": 720,
      "resultPath": "expansion/working/v2/results/guwen-466--34b245c845374ed63af44c426fc339c3edbff6b135890a15a039687c3552b9c2.json"
    },
    {
      "id": "guwen-467",
      "category": "古文",
      "title": "围炉夜话·第一六八则",
      "subtitle": "",
      "author": "王永彬",
      "dynasty": "清",
      "content": "富不肯读书，贵不肯积德，错过可惜也；少不肯事长，愚不肯亲贤，不祥莫大焉！",
      "excerptOf": "围炉夜话",
      "excerptNote": "完整选录《围炉夜话》中“第一六八则”一则或一章；非全书。",
      "inputHash": "88c172b2cffac6198d60ec8729446bbd2b5b94992a29d379e118b1c059b5786c",
      "estimatedOutput": 708,
      "resultPath": "expansion/working/v2/results/guwen-467--88c172b2cffac6198d60ec8729446bbd2b5b94992a29d379e118b1c059b5786c.json"
    },
    {
      "id": "guwen-468",
      "category": "古文",
      "title": "围炉夜话·第一六九则",
      "subtitle": "",
      "author": "王永彬",
      "dynasty": "清",
      "content": "自虞廷立五伦为教，然后天下有大经；自紫阳集四子成书，然后天下有正学。",
      "excerptOf": "围炉夜话",
      "excerptNote": "完整选录《围炉夜话》中“第一六九则”一则或一章；非全书。",
      "inputHash": "92722b64d1de3d7c62b02b9b3070549683bf34227168c579d09e43b6121a88de",
      "estimatedOutput": 702,
      "resultPath": "expansion/working/v2/results/guwen-468--92722b64d1de3d7c62b02b9b3070549683bf34227168c579d09e43b6121a88de.json"
    },
    {
      "id": "guwen-469",
      "category": "古文",
      "title": "围炉夜话·第一七Ｏ则",
      "subtitle": "",
      "author": "王永彬",
      "dynasty": "清",
      "content": "意趣清高，利禄不能动也；志量远大，富贵不能淫也。",
      "excerptOf": "围炉夜话",
      "excerptNote": "完整选录《围炉夜话》中“第一七Ｏ则”一则或一章；非全书。",
