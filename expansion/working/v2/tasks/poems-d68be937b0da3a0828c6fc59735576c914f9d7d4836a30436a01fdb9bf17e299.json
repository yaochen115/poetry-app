      "resultPath": "expansion/working/v2/results/tang-679--4aabfbe9cfea83658f7aca143e1f0357570edd122331a13f315a98be750c5303.json"
    },
    {
      "id": "tang-680",
      "category": "唐诗",
      "title": "代春怨",
      "subtitle": "",
      "author": "刘方平",
      "dynasty": "唐",
      "content": "朝日残莺伴妾啼，开帘只见草萋萋。\n庭前时有东风入，杨柳千条尽向西。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "6b38e0aeb09fdc3d9c273e679b73e469bd29868b843a9c0dc831421cbeac58b8",
