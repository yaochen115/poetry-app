      "resultPath": "expansion/working/v2/results/tang-683--f3aee06e0eef3af25e8a220ae9c115dcc720afa6a57263280891861f95372b63.json"
    },
    {
      "id": "tang-684",
      "category": "唐诗",
      "title": "新晴野望",
      "subtitle": "",
      "author": "王维",
      "dynasty": "唐",
      "content": "新晴原野旷，极目无氛垢。\n郭门临渡头，村树连溪口。\n白水明田外，碧峰出山后。\n农月无闲人，倾家事南亩。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "391845cdfdaab3c0488fd7260c04c84be4222c4e8c836e16a1ec764aa45dde45",
