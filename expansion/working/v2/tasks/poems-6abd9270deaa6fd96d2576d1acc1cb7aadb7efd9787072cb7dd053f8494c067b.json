      "resultPath": "expansion/working/v2/results/song-860--72662d81a5c9f03a0e35a9025fe67915206fe84adc3df5485f3c79088b43bf60.json"
    },
    {
      "id": "song-861",
      "category": "宋词",
      "title": "浪淘沙",
      "subtitle": "雁塞说并门郡枕",
      "author": "裴湘",
      "dynasty": "宋",
      "content": "雁塞说并门。\n郡枕西汾。\n山形高下远相吞。\n古寺楼台依碧嶂，烟景遥分。\n晋庙锁溪云。\n箫鼓仍存。\n牛羊斜日自归村。\n惟有故城禾黍地，前事消魂。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "e1728959bff63af127983fb96a522198e13aaee00cb1579daec6987913098a2e",
      "estimatedOutput": 742,
      "resultPath": "expansion/working/v2/results/song-861--e1728959bff63af127983fb96a522198e13aaee00cb1579daec6987913098a2e.json"
    },
    {
      "id": "song-862",
      "category": "宋词",
      "title": "浪淘沙",
      "subtitle": "万国仰神京礼乐",
      "author": "裴湘",
      "dynasty": "宋",
      "content": "万国仰神京。\n礼乐纵横。\n葱葱佳气锁龙城。\n日御明堂天子圣，朝会簪缨。\n九陌六街平。\n万国充盈。\n青楼弦管酒如渑。\n别有隋堤烟柳暮，千古含情。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "e71fe1b619d44bc76ca8274dbd3ff6e40e430f4c1c2750cd6791671b51865d71",
      "estimatedOutput": 742,
      "resultPath": "expansion/working/v2/results/song-862--e71fe1b619d44bc76ca8274dbd3ff6e40e430f4c1c2750cd6791671b51865d71.json"
    },
    {
      "id": "song-863",
      "category": "宋词",
      "title": "蝶恋花",
      "subtitle": "叶底无风池面静",
      "author": "滕甫",
      "dynasty": "宋",
      "content": "叶底无风池面静。\n掬水佳人，拍破青铜镜。\n残月朦胧花弄影。\n新梳斜插乌云鬓。\n拍索闷怀添酒兴。\n旋撷园蔬，随分成盘饤。\n说与翠微休急性。\n功名富贵皆前定。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "e3f435c9221ed717be24a0b2f0919274e0e0bbf74598e111863dca5d9a7d6cdb",
      "estimatedOutput": 754,
      "resultPath": "expansion/working/v2/results/song-863--e3f435c9221ed717be24a0b2f0919274e0e0bbf74598e111863dca5d9a7d6cdb.json"
    },
    {
      "id": "song-864",
      "category": "宋词",
      "title": "蝶恋花",
      "subtitle": "昼永无人深院静",
      "author": "滕甫",
      "dynasty": "宋",
      "content": "昼永无人深院静。\n一枕春醒，犹未忺临镜。\n帘卷新蟾光射影。\n速忙掠起蓬松鬓。\n对景沈吟嗟没兴。\n薄幸不来，空把杯盘饤。\n休道妇人多水性。\n今宵独自言无定。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "fa1cddb57e63bd5141dc86be23290a5b78905d24832d7b78198c382efb8660db",
      "estimatedOutput": 754,
      "resultPath": "expansion/working/v2/results/song-864--fa1cddb57e63bd5141dc86be23290a5b78905d24832d7b78198c382efb8660db.json"
    },
    {
      "id": "song-865",
      "category": "宋词",
      "title": "菩萨蛮",
      "subtitle": "数家茅屋闲临水",
      "author": "王安石",
      "dynasty": "宋",
      "content": "数家茅屋闲临水。\n单衫短帽垂杨里。\n今日是何朝。\n看予度石桥。\n梢梢新月偃。\n午醉醒来晚。\n何物最关情。\n黄鹂三两声。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "6df199d407d3a24c793b4a50b9ace396997f9e6b36c1038925b937aba456c43e",
