    },
    {
      "id": "song-616",
      "category": "宋词",
      "title": "采桑子",
      "subtitle": "春深雨过西湖好",
      "author": "欧阳修",
      "dynasty": "宋",
      "content": "春深雨过西湖好，百卉争妍。\n蝶乱蜂喧。\n晴日催花暖欲然。\n兰桡画舸悠悠去，疑是神仙。\n返照波间。\n水阔风高扬管弦。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "95f73f61e6bd547ba1693e8b60eb07a6f00b49e4acf06adf6f14f34d4890c66d",
      "estimatedOutput": 714,
      "resultPath": "expansion/working/v2/results/song-616--95f73f61e6bd547ba1693e8b60eb07a6f00b49e4acf06adf6f14f34d4890c66d.json"
    },
    {
      "id": "song-617",
      "category": "宋词",
      "title": "采桑子",
      "subtitle": "画船载酒西湖好",
      "author": "欧阳修",
      "dynasty": "宋",
      "content": "画船载酒西湖好，急管繁弦。\n玉盏催传。\n稳泛平波任醉眠。\n行云却在行舟下，空水澄鲜。\n俯仰留连。\n疑是湖中别有天。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "c2ef62414e0b79a4ced83e2b9ded1f97233a1e58ea548226c49e239f15c21cc9",
      "estimatedOutput": 714,
      "resultPath": "expansion/working/v2/results/song-617--c2ef62414e0b79a4ced83e2b9ded1f97233a1e58ea548226c49e239f15c21cc9.json"
    },
    {
      "id": "song-618",
      "category": "宋词",
      "title": "采桑子",
      "subtitle": "天容水色西湖好",
      "author": "欧阳修",
      "dynasty": "宋",
      "content": "天容水色西湖好，云物俱鲜。\n鸥鹭闲眠。\n应惯寻常听管弦。\n风清月白偏宜夜，一片琼田。\n谁羡骖鸾。\n人在舟中便是仙。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "2e3f1ad45f574b811f988563193357ddf8e55c8ae5669775da4c9f354fb51de6",
      "estimatedOutput": 714,
      "resultPath": "expansion/working/v2/results/song-618--2e3f1ad45f574b811f988563193357ddf8e55c8ae5669775da4c9f354fb51de6.json"
    },
    {
      "id": "song-619",
      "category": "宋词",
      "title": "采桑子",
      "subtitle": "残霞夕照西湖好",
      "author": "欧阳修",
      "dynasty": "宋",
      "content": "残霞夕照西湖好，花坞苹汀。\n十顷波平。\n野岸无人舟自横。\n西南月上浮云散，轩槛凉生。\n莲芰香清。\n水面风来酒面醒。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "b075a0ebc3f15ca096aa7fe2eb048cbcba936b1adbd0d6c9fb611b5b3a870e20",
      "estimatedOutput": 714,
      "resultPath": "expansion/working/v2/results/song-619--b075a0ebc3f15ca096aa7fe2eb048cbcba936b1adbd0d6c9fb611b5b3a870e20.json"
    },
    {
      "id": "song-620",
      "category": "宋词",
      "title": "采桑子",
      "subtitle": "平生为爱西湖好",
      "author": "欧阳修",
      "dynasty": "宋",
      "content": "平生为爱西湖好，来拥朱轮。\n富贵浮云。\n俯仰流年二十春。\n归来恰似辽东鹤，城郭人民。\n触目皆新。\n谁识当年旧主人。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "3e4630d89fb1d70ecc3d76f23f8259200d2bc84e6b46ab417ca30641cbe0ae62",
      "estimatedOutput": 714,
      "resultPath": "expansion/working/v2/results/song-620--3e4630d89fb1d70ecc3d76f23f8259200d2bc84e6b46ab417ca30641cbe0ae62.json"
    },
    {
      "id": "song-621",
      "category": "宋词",
      "title": "采桑子",
      "subtitle": "画楼钟动君休唱",
      "author": "欧阳修",
      "dynasty": "宋",
      "content": "画楼钟动君休唱，往事无踪。\n聚散匆匆。\n今日欢娱几客同。\n去年绿鬓今年白，不觉衰容。\n明月清风。\n把酒何人忆谢公。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "340700385b221e1b96ad72330e60686bd037febfabbc7cd8aa4e6f538e01633c",
      "estimatedOutput": 714,
      "resultPath": "expansion/working/v2/results/song-621--340700385b221e1b96ad72330e60686bd037febfabbc7cd8aa4e6f538e01633c.json"
    },
    {
      "id": "song-622",
      "category": "宋词",
      "title": "采桑子",
      "subtitle": "十年一别流光速",
      "author": "欧阳修",
      "dynasty": "宋",
      "content": "十年一别流光速，白首相逢。\n莫话衰翁。\n但斗尊前语笑同。\n劝君满酌君须醉，尽日从容。\n画鹢牵风。\n即去朝天沃舜聪。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "7f7f54312a7f5f5fb9e50df18b9a42a89f38a5f4117e1a632382a8eae4bcdf28",
      "estimatedOutput": 714,
      "resultPath": "expansion/working/v2/results/song-622--7f7f54312a7f5f5fb9e50df18b9a42a89f38a5f4117e1a632382a8eae4bcdf28.json"
    },
    {
      "id": "song-623",
      "category": "宋词",
      "title": "采桑子",
      "subtitle": "十年前是尊前客",
      "author": "欧阳修",
      "dynasty": "宋",
      "content": "十年前是尊前客，月白风清。\n忧患凋零。\n老去光阴速可惊。\n鬓华虽改心无改，试把金觥。\n旧曲重听。\n犹是当年醉里声。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "109354c6e6efcb76433a78122aecf95863654d0f3b9ed58ffc39b78d1299b248",
      "estimatedOutput": 714,
