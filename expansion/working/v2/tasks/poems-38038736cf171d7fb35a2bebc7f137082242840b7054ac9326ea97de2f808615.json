      "resultPath": "expansion/working/v2/results/guwen-322--a4b442ddb2a9d866bb9556e18f8b95a8034f480a9ce948353c5183d16e415065.json"
    },
    {
      "id": "guwen-323",
      "category": "古文",
      "title": "围炉夜话·第九八则",
      "subtitle": "",
      "author": "王永彬",
      "dynasty": "清",
      "content": "守身必谨严，凡足以戕吾身者宜戒之；养心须淡泊，凡足以累吾心者勿为也。",
      "excerptOf": "围炉夜话",
      "excerptNote": "完整选录《围炉夜话》中“第九八则”一则或一章；非全书。",
      "inputHash": "ccf68a886b4a411d55b2cf68b0e4378261fbba490b3cc908eff4af438912b083",
      "estimatedOutput": 702,
      "resultPath": "expansion/working/v2/results/guwen-323--ccf68a886b4a411d55b2cf68b0e4378261fbba490b3cc908eff4af438912b083.json"
    },
    {
      "id": "guwen-324",
      "category": "古文",
      "title": "围炉夜话·第九九则",
      "subtitle": "",
      "author": "王永彬",
      "dynasty": "清",
      "content": "人之足传，在有德，不在有位；世所相信，在能行，不在能言。",
      "excerptOf": "围炉夜话",
      "excerptNote": "完整选录《围炉夜话》中“第九九则”一则或一章；非全书。",
      "inputHash": "629e0675409e9e71a88b102846fd897b4f2758fd48b6efb15befef4d7ce00534",
      "estimatedOutput": 684,
      "resultPath": "expansion/working/v2/results/guwen-324--629e0675409e9e71a88b102846fd897b4f2758fd48b6efb15befef4d7ce00534.json"
    },
    {
      "id": "guwen-325",
      "category": "古文",
      "title": "围炉夜话·第一ＯＯ则",
      "subtitle": "",
      "author": "王永彬",
      "dynasty": "清",
      "content": "与其使乡党有誉言，不如令乡党无怨言；与其为子孙谋产业，不如教子孙习恒业。",
      "excerptOf": "围炉夜话",
      "excerptNote": "完整选录《围炉夜话》中“第一ＯＯ则”一则或一章；非全书。",
      "inputHash": "2b7c82dbc525873fa128ab2527b7b624da73cc64b5d2519ef190b7832a2444fa",
      "estimatedOutput": 708,
      "resultPath": "expansion/working/v2/results/guwen-325--2b7c82dbc525873fa128ab2527b7b624da73cc64b5d2519ef190b7832a2444fa.json"
    },
    {
      "id": "guwen-326",
      "category": "古文",
      "title": "围炉夜话·第一Ｏ一则",
      "subtitle": "",
      "author": "王永彬",
      "dynasty": "清",
      "content": "多记先正格言，胸中方有主宰；闲看他人行事，眼前即是规箴。",
      "excerptOf": "围炉夜话",
      "excerptNote": "完整选录《围炉夜话》中“第一Ｏ一则”一则或一章；非全书。",
      "inputHash": "87ae1dea214f437a693e96cd3d9c3484fcd7f94f4a388fc5a0bbf040fe7aec42",
      "estimatedOutput": 684,
      "resultPath": "expansion/working/v2/results/guwen-326--87ae1dea214f437a693e96cd3d9c3484fcd7f94f4a388fc5a0bbf040fe7aec42.json"
    },
    {
      "id": "guwen-327",
      "category": "古文",
      "title": "围炉夜话·第一Ｏ二则",
      "subtitle": "",
      "author": "王永彬",
      "dynasty": "清",
      "content": "陶侃运甓官斋，其精勤可企而及也；谢安围棋别墅，其镇定非学而能也。",
      "excerptOf": "围炉夜话",
      "excerptNote": "完整选录《围炉夜话》中“第一Ｏ二则”一则或一章；非全书。",
      "inputHash": "4ade08cc6a090febb99e48549d29644d8c21ef22627e4fd136b5adfbb746ab8f",
      "estimatedOutput": 696,
      "resultPath": "expansion/working/v2/results/guwen-327--4ade08cc6a090febb99e48549d29644d8c21ef22627e4fd136b5adfbb746ab8f.json"
    },
    {
      "id": "guwen-328",
      "category": "古文",
      "title": "围炉夜话·第一Ｏ三则",
      "subtitle": "",
      "author": "王永彬",
      "dynasty": "清",
      "content": "但患不肯济人，休患我不能济人；须使人不忍欺我，勿使人不敢欺我。",
      "excerptOf": "围炉夜话",
      "excerptNote": "完整选录《围炉夜话》中“第一Ｏ三则”一则或一章；非全书。",
      "inputHash": "77278c901334bd9086ab8b58ae89f672d5504fce44737c5acf2b1e8a0cf5e926",
      "estimatedOutput": 693,
      "resultPath": "expansion/working/v2/results/guwen-328--77278c901334bd9086ab8b58ae89f672d5504fce44737c5acf2b1e8a0cf5e926.json"
    },
    {
      "id": "guwen-329",
      "category": "古文",
      "title": "围炉夜话·第一Ｏ四则",
      "subtitle": "",
      "author": "王永彬",
      "dynasty": "清",
      "content": "何谓享福之才，能读书者便是；何谓创家之人，能教子者便是。",
      "excerptOf": "围炉夜话",
      "excerptNote": "完整选录《围炉夜话》中“第一Ｏ四则”一则或一章；非全书。",
      "inputHash": "d354e32dc921446c7779875222caafb33d5658226315bd0d07f6cdc4cdaf6953",
      "estimatedOutput": 684,
      "resultPath": "expansion/working/v2/results/guwen-329--d354e32dc921446c7779875222caafb33d5658226315bd0d07f6cdc4cdaf6953.json"
    },
    {
      "id": "guwen-330",
      "category": "古文",
      "title": "围炉夜话·第一Ｏ五则",
      "subtitle": "",
      "author": "王永彬",
      "dynasty": "清",
      "content": "子弟天性未漓，教易入也，则体孔子之言以劳之，勿溺爱以长其自肆之心。子弟习气已坏，教难行也，则守孟子之言以养之，勿轻弃以绝其自新之路。",
      "excerptOf": "围炉夜话",
      "excerptNote": "完整选录《围炉夜话》中“第一Ｏ五则”一则或一章；非全书。",
      "inputHash": "4bd06d8d071436bf0aa45bceec3bacc744da9d24cc31b2d767525df1178ddb87",
      "estimatedOutput": 798,
      "resultPath": "expansion/working/v2/results/guwen-330--4bd06d8d071436bf0aa45bceec3bacc744da9d24cc31b2d767525df1178ddb87.json"
    },
    {
      "id": "guwen-331",
      "category": "古文",
      "title": "围炉夜话·第一Ｏ六则",
      "subtitle": "",
      "author": "王永彬",
      "dynasty": "清",
      "content": "忠实而无才，尚可立功，心志专一也；忠实而无识，必至偾事，意见多偏也。",
      "excerptOf": "围炉夜话",
      "excerptNote": "完整选录《围炉夜话》中“第一Ｏ六则”一则或一章；非全书。",
      "inputHash": "ccd70f0fb1c9b0a2d2a79daa448753920c82a110ae27c4ec1e789227211a502c",
      "estimatedOutput": 702,
      "resultPath": "expansion/working/v2/results/guwen-331--ccd70f0fb1c9b0a2d2a79daa448753920c82a110ae27c4ec1e789227211a502c.json"
    },
    {
      "id": "guwen-332",
      "category": "古文",
      "title": "围炉夜话·第一Ｏ七则",
      "subtitle": "",
      "author": "王永彬",
      "dynasty": "清",
      "content": "人虽无艰难之时，却不可忘艰难之境；世虽有侥幸之事，断不可存侥幸之心。",
      "excerptOf": "围炉夜话",
      "excerptNote": "完整选录《围炉夜话》中“第一Ｏ七则”一则或一章；非全书。",
      "inputHash": "a4896f63246f0d89c0f0fcfbdac2fb5c228e957c15f18ad0f88ab9cf6746d432",
      "estimatedOutput": 702,
      "resultPath": "expansion/working/v2/results/guwen-332--a4896f63246f0d89c0f0fcfbdac2fb5c228e957c15f18ad0f88ab9cf6746d432.json"
    },
    {
      "id": "guwen-333",
      "category": "古文",
      "title": "围炉夜话·第一Ｏ八则",
      "subtitle": "",
      "author": "王永彬",
      "dynasty": "清",
      "content": "心静则明，水止乃能照物；品超斯远，云飞而不碍空。",
      "excerptOf": "围炉夜话",
      "excerptNote": "完整选录《围炉夜话》中“第一Ｏ八则”一则或一章；非全书。",
