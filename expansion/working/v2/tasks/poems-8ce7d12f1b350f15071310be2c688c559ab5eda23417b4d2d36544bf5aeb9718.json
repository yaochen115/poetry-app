    {
      "id": "song-627",
      "category": "宋词",
      "title": "减字木兰花",
      "subtitle": "楼台向晓淡月低",
      "author": "欧阳修",
      "dynasty": "宋",
      "content": "楼台向晓。\n淡月低云天气好。\n翠幕风微。\n宛转梁州入破时。\n香生舞袂。\n楚女腰肢天与细。\n汗粉重匀。\n酒后轻寒不著人。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "c22a33e78961bd5cbdd6901600ba8aafab93c6d9496c7691c8b8ba1a181b5263",
