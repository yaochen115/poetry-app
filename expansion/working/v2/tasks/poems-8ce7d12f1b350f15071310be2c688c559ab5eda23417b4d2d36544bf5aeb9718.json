    },
    {
      "id": "song-630",
      "category": "宋词",
      "title": "阮郎归",
      "subtitle": "刘郎何日是来时",
      "author": "欧阳修",
      "dynasty": "宋",
      "content": "刘郎何日是来时。\n无心云胜伊。\n行云犹解傍山飞。\n郎行去不归。\n强匀画，又芳菲。\n春深轻薄衣。\n桃花无语伴相思。\n阴阴月上时。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "faece9e413c08034cc3fac1a574ca123f2b93b179cb38fb8a238db78c212f643",
      "estimatedOutput": 726,
      "resultPath": "expansion/working/v2/results/song-630--faece9e413c08034cc3fac1a574ca123f2b93b179cb38fb8a238db78c212f643.json"
    },
    {
      "id": "song-631",
      "category": "宋词",
      "title": "阮郎归",
      "subtitle": "落花浮水树临池",
      "author": "欧阳修",
      "dynasty": "宋",
      "content": "落花浮水树临池。\n年前心眼期。\n见来无事去还思。\n而今花又飞。\n浅螺黛，淡燕脂。\n闲妆取次宜。\n隔帘风雨闭门时。\n此情风月知。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "b11cd2d5df312157e44ca56d5ef62f9e447e70b5133b6745aea8a5a7e1b40cc4",
      "estimatedOutput": 726,
      "resultPath": "expansion/working/v2/results/song-631--b11cd2d5df312157e44ca56d5ef62f9e447e70b5133b6745aea8a5a7e1b40cc4.json"
    },
    {
      "id": "song-632",
      "category": "宋词",
      "title": "蝶恋花",
      "subtitle": "帘幕东风寒料峭",
      "author": "欧阳修",
      "dynasty": "宋",
      "content": "帘幕东风寒料峭。\n雪里香梅，先报春来早。\n红蜡枝头双燕小。\n金刀剪彩呈纤巧。\n旋暖金炉薰蕙藻。\n酒入横波，困不禁烦恼。\n绣被五更春睡好。\n罗帏不觉纱窗晓。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "80ecd77356ae1ed4e49c4868c83fea90e9db170bb25f76ce25aaa3a2e0b252fb",
      "estimatedOutput": 754,
      "resultPath": "expansion/working/v2/results/song-632--80ecd77356ae1ed4e49c4868c83fea90e9db170bb25f76ce25aaa3a2e0b252fb.json"
    },
    {
      "id": "song-633",
      "category": "宋词",
      "title": "蝶恋花",
      "subtitle": "南雁依稀回侧阵",
      "author": "欧阳修",
      "dynasty": "宋",
      "content": "南雁依稀回侧阵。\n雪霁墙阴，遍觉兰芽嫩。\n中夜梦馀消酒困。\n炉香卷穗灯生晕。\n急景流年都一瞬。\n往事前欢，未免萦芳寸。\n腊后花期知渐近。\n东风已作寒梅信。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "24d77d7298a4ed58bed31b89617ecb7bb4167df205afba02ef0db02a57696e4f",
      "estimatedOutput": 754,
      "resultPath": "expansion/working/v2/results/song-633--24d77d7298a4ed58bed31b89617ecb7bb4167df205afba02ef0db02a57696e4f.json"
    },
    {
      "id": "song-634",
      "category": "宋词",
      "title": "蝶恋花",
      "subtitle": "腊雪初销梅蕊绽",
      "author": "欧阳修",
      "dynasty": "宋",
      "content": "腊雪初销梅蕊绽。\n梅雪相和，喜鹊穿花转。\n睡起夕阳迷醉眼。\n新愁长向东风乱。\n瘦觉玉肌罗带缓。\n红杏梢头，二月春犹浅。\n望极不来芳信断。\n音书纵有争如见。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "bc17a20c78beabdeeef838ff79db890cbc6c64c7ed44a6eb4de554b4d8976feb",
      "estimatedOutput": 754,
      "resultPath": "expansion/working/v2/results/song-634--bc17a20c78beabdeeef838ff79db890cbc6c64c7ed44a6eb4de554b4d8976feb.json"
    },
    {
      "id": "song-635",
      "category": "宋词",
      "title": "蝶恋花",
      "subtitle": "面旋落花风荡漾",
      "author": "欧阳修",
      "dynasty": "宋",
      "content": "面旋落花风荡漾。\n柳重烟深，雪絮飞来往。\n雨后轻寒犹未放。\n春愁酒病成惆怅。\n枕畔屏山围碧浪。\n翠被华灯，夜夜空相向。\n寂寞起来褰绣幌。\n月明正在梨花上。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "91d872498e74b6e8da654ff5669ee24c20d30356d2c9ea1a269d7d3f1ee530e9",
      "estimatedOutput": 754,
      "resultPath": "expansion/working/v2/results/song-635--91d872498e74b6e8da654ff5669ee24c20d30356d2c9ea1a269d7d3f1ee530e9.json"
    },
    {
      "id": "song-636",
      "category": "宋词",
      "title": "蝶恋花",
      "subtitle": "帘幕风轻双语燕",
      "author": "欧阳修",
      "dynasty": "宋",
      "content": "帘幕风轻双语燕。\n午后醒来，柳絮飞撩乱。\n心事一春犹未见。\n红英落尽青苔院。\n百尺朱楼闲倚遍。\n薄雨浓云，抵死遮人面。\n羌管不须吹别怨。\n无肠更为新声断。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "944088e68486efb036f7fcb88857c0a669dc96c2ea55aefe0d0ac238f4779855",
      "estimatedOutput": 754,
      "resultPath": "expansion/working/v2/results/song-636--944088e68486efb036f7fcb88857c0a669dc96c2ea55aefe0d0ac238f4779855.json"
    },
    {
      "id": "song-637",
      "category": "宋词",
      "title": "蝶恋花",
      "subtitle": "永日环堤乘彩舫",
      "author": "欧阳修",
      "dynasty": "宋",
      "content": "永日环堤乘彩舫。\n烟草萧疏，恰似晴江上。\n水浸碧天风皱浪。\n菱花荇蔓随双桨。\n红粉佳人翻丽唱。\n惊起鸳鸯，两两飞相向。\n且把金尊倾美酿。\n休思往事成惆怅。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "4fe0e5cc7f8da1c9c486110ace44ad38e319f9ca1c2deb96e6bf81513945376a",
