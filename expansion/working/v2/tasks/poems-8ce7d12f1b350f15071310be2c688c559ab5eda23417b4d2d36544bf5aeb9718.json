    },
    {
      "id": "song-628",
      "category": "宋词",
      "title": "减字木兰花",
      "subtitle": "画堂雅宴一抹朱",
      "author": "欧阳修",
      "dynasty": "宋",
      "content": "画堂雅宴。\n一抹朱弦初入遍。\n慢拈轻笼。\n玉指纤纤嫩剥葱。\n拨头憁利。\n怨月愁花无限意。\n红粉轻盈。\n倚暖香檀曲未成。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "6c4d0fb92941811145cb80bb72606efe68077e92bd46f965d11886035bd4432d",
      "estimatedOutput": 718,
      "resultPath": "expansion/working/v2/results/song-628--6c4d0fb92941811145cb80bb72606efe68077e92bd46f965d11886035bd4432d.json"
    },
    {
      "id": "song-629",
      "category": "宋词",
      "title": "减字木兰花",
      "subtitle": "歌檀敛袂缭绕雕",
      "author": "欧阳修",
      "dynasty": "宋",
      "content": "歌檀敛袂。\n缭绕雕梁尘暗起。\n柔润清圆。\n百琲明珠一线穿。\n樱唇玉齿。\n天上仙音心下事。\n留往行云。\n满坐迷魂酒半醺。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "635f8c576eae5d1d3bf2321ebbebaccf3d61678487e8b8e1857153d57a5d287f",
      "estimatedOutput": 718,
