    },
    {
      "id": "song-423",
      "category": "宋词",
      "title": "清平乐",
      "subtitle": "",
      "author": "晏几道",
      "dynasty": "宋",
      "content": "波纹碧皱。曲水清明后。折得疏梅香满袖。暗喜春红依旧。\n归来紫陌东头。金钗换酒消愁。柳影深深细路，花梢小小层楼。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "24e1ff86829d7a4cf7553e2f9447dbbd26d2547657266210937186b27ba7ab39",
      "estimatedOutput": 710,
      "resultPath": "expansion/working/v2/results/song-423--24e1ff86829d7a4cf7553e2f9447dbbd26d2547657266210937186b27ba7ab39.json"
    },
    {
      "id": "song-424",
      "category": "宋词",
      "title": "临江仙",
      "subtitle": "与客湖上饮归",
      "author": "叶梦得",
      "dynasty": "宋",
      "content": "不见跳鱼翻曲港，湖边特地经过。萧萧疏雨乱风荷。微云吹散，凉月堕平波。\n白酒一杯还径醉，归来散发婆娑。无人能唱采莲歌。小轩欹枕，檐影挂星河。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "776b1327f9f31ef4c1623e7eed138c5514b989e531dfc6a3c6bb6c1d19a6614b",
      "estimatedOutput": 738,
      "resultPath": "expansion/working/v2/results/song-424--776b1327f9f31ef4c1623e7eed138c5514b989e531dfc6a3c6bb6c1d19a6614b.json"
    },
    {
      "id": "song-425",
      "category": "宋词",
      "title": "满庭芳",
      "subtitle": "",
      "author": "赵令",
      "dynasty": "宋",
      "content": "玉枕生凉，金缸传晓，败叶飞破清秋。雨余翻浪，渺渺阻行舟。暂系汀洲侧畔，风夜起、荻叶添愁。银屏远，龙香渐尽，还是梦扬州。\n更筹。何太永，当年情事，今日堪酬。最苦恨红楼，笑我飘浮。为寄相思细字，教字字、愁蹙眉头。凄凉久，渔人唱晓，随月过横沟。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "e01cb29e10c06fc516299a2c1a3f021c1a12214495c115d5907d2cb43c142281",
      "estimatedOutput": 838,
      "resultPath": "expansion/working/v2/results/song-425--e01cb29e10c06fc516299a2c1a3f021c1a12214495c115d5907d2cb43c142281.json"
    },
    {
      "id": "song-426",
      "category": "宋词",
      "title": "菩萨蛮",
      "subtitle": "秋堂积雨新凉入",
      "author": "郭应祥",
      "dynasty": "宋",
      "content": "秋堂积雨新凉入。今宵雅乘鹏飞集。劲翮会高风。功名欬唾中。笔头元有准。快写平生蕴。何日捷书来。重阳把一杯。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "0f48867465859a665672dc15925fa2624807e93c5d440eda09bcdb1826d6d0df",
      "estimatedOutput": 704,
      "resultPath": "expansion/working/v2/results/song-426--0f48867465859a665672dc15925fa2624807e93c5d440eda09bcdb1826d6d0df.json"
    },
    {
      "id": "song-427",
      "category": "宋词",
      "title": "采桑子",
      "subtitle": "年年此夕东城见",
      "author": "晏几道",
      "dynasty": "宋",
      "content": "年年此夕东城见，\n欢意匆匆。\n明日还重，\n却在楼台缥缈中。\n垂螺拂黛清歌女，\n曾唱相逢。\n秋月春风，\n醉枕香衾一岁同。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "204ca544bb74faf2d650940674d3f41821f037c650d1940a51ef9a4a223e24c4",
      "estimatedOutput": 718,
      "resultPath": "expansion/working/v2/results/song-427--204ca544bb74faf2d650940674d3f41821f037c650d1940a51ef9a4a223e24c4.json"
    },
    {
      "id": "song-428",
      "category": "宋词",
      "title": "蝶恋花",
      "subtitle": "碧落秋风吹玉树",
      "author": "晏几道",
      "dynasty": "宋",
      "content": "碧落秋风吹玉树，\n翠节红旌，晚过银河路。\n休笑星机停弄杼，凤帏已在云深处。\n楼上金针穿绣缕，\n谁管天边，隔岁分飞苦。\n试等夜阑寻别绪，泪痕千点罗衣露。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "a9718a9610871d1b6598995ebaad9a74e3fd8f770c83602793ab729dc3fb127a",
      "estimatedOutput": 750,
      "resultPath": "expansion/working/v2/results/song-428--a9718a9610871d1b6598995ebaad9a74e3fd8f770c83602793ab729dc3fb127a.json"
    },
    {
      "id": "song-429",
      "category": "宋词",
      "title": "祝英台近",
      "subtitle": "",
      "author": "葛长庚",
      "dynasty": "宋",
      "content": "月如酥，天似玉，长啸弄孤影。十二楼台，昨梦暗寻省。自怜露满衣襟，风吹毛发，浑无寐、寒宵漏永。\n捧香鼎。翻起一片龙涎，梅花对人冷。庭户冰清，何处鹤声警。少时烛暗梧窗，烟生苔砌，晓钟动。忽然心醒。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "fe2734f00513dab01226d7acae5cc1eff5088ae66efd3abaa33db0337f54b19a",
      "estimatedOutput": 792,
      "resultPath": "expansion/working/v2/results/song-429--fe2734f00513dab01226d7acae5cc1eff5088ae66efd3abaa33db0337f54b19a.json"
    },
    {
      "id": "song-430",
      "category": "宋词",
      "title": "鹧鸪天",
      "subtitle": "",
      "author": "刘学箕",
      "dynasty": "宋",
      "content": "梦绕天涯去意浓。客愁春恨两匆匆。绿波初涨桃花浪，画鹢轻随柳絮风。\n无笔力，判虚空。关山千里两心同。鱼书雁字都休问，只看啼痕翠袖红。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "7bed6d325ce5a78ab31282e1b5b00046722476ae0c627d9296fab6f327f141b3",
      "estimatedOutput": 730,
      "resultPath": "expansion/working/v2/results/song-430--7bed6d325ce5a78ab31282e1b5b00046722476ae0c627d9296fab6f327f141b3.json"
    },
    {
      "id": "song-431",
      "category": "宋词",
      "title": "一剪梅",
      "subtitle": "唱到阳关第四声",
      "author": "刘仙伦",
      "dynasty": "宋",
      "content": "唱到阳关第四声。香带轻分。罗带轻分。杏花时节雨纷纷。山绕孤村。水绕孤村。\n更没心情共酒尊。春衫香满，空有啼痕。一般离思两销魂。马上黄昏。楼上黄昏。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "0240fca9089890d707c4e4de39476727a864bf880e91af0535b51e14ad82f914",
      "estimatedOutput": 746,
      "resultPath": "expansion/working/v2/results/song-431--0240fca9089890d707c4e4de39476727a864bf880e91af0535b51e14ad82f914.json"
    },
    {
      "id": "song-432",
      "category": "宋词",
      "title": "水调歌头",
      "subtitle": "",
      "author": "陈敷",
      "dynasty": "宋",
      "content": "明月双溪上，胜景号金华。当年此夕，多少鸾凤杂云霞。共拥飘摇倦伯，来作人间英杰，王谢旧名家。纶綍妙文采，帷幄富忠嘉。\n圣天子，形梦寐。眷尤加。麒麟烟上早晚，丹陛听宣麻。鼎袖无穷勋业，岁岁薰风日永，萱秀北堂花。潋滟绮筵酒，寿算等胡沙。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "d3f8a243c4e7ca22acba608df615c00081ea82738e6f372601ace2ecbf469184",
      "estimatedOutput": 830,
      "resultPath": "expansion/working/v2/results/song-432--d3f8a243c4e7ca22acba608df615c00081ea82738e6f372601ace2ecbf469184.json"
    },
    {
      "id": "song-433",
      "category": "宋词",
      "title": "虞美人",
      "subtitle": "",
      "author": "冯时行",
      "dynasty": "宋",
      "content": "芳菲不是浑无据。只是春收取。都将酝造晚风光。百尺瑶台、吹下半天香。\n多愁多病疏慵意。也被香扶起。微吟小酌送花飞。更拼小屏幽梦、到开时。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "238efb11c6f6b3f5fe924097edd0f38d31338a9db5aec5418842a11bdd61c8a1",
      "estimatedOutput": 734,
      "resultPath": "expansion/working/v2/results/song-433--238efb11c6f6b3f5fe924097edd0f38d31338a9db5aec5418842a11bdd61c8a1.json"
    }
