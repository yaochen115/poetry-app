    },
    {
      "id": "yuan-123",
      "category": "元曲",
      "title": "庆东原",
      "subtitle": "泊罗阳驿",
      "author": "赵善庆",
      "dynasty": "元",
      "content": "砧声住，蛩韵切，静寥寥门掩清秋夜。秋心凤阙，秋愁雁堞，秋梦蝴蝶。十载故乡心，一夜邮亭月。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "53f6e64b59721f03919f039840277209158cf8bcd22b719695c569230e6ce289",
      "estimatedOutput": 688,
      "resultPath": "expansion/working/v2/results/yuan-123--53f6e64b59721f03919f039840277209158cf8bcd22b719695c569230e6ce289.json"
    },
    {
      "id": "yuan-124",
      "category": "元曲",
      "title": "卖花声",
      "subtitle": "悟世",
      "author": "乔吉",
      "dynasty": "元",
      "content": "肝肠百炼炉间铁，富贵三更枕上蝶，功名两字杯中蛇。尖风薄雪，残杯冷炙，掩青灯竹篱茅舍。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "9e2ad40a86602306181ca5780aea6afd0f1b64c2f8f7e9f57d55ce39912a04c7",
      "estimatedOutput": 684,
      "resultPath": "expansion/working/v2/results/yuan-124--9e2ad40a86602306181ca5780aea6afd0f1b64c2f8f7e9f57d55ce39912a04c7.json"
    },
    {
      "id": "yuan-125",
      "category": "元曲",
      "title": "一半儿",
      "subtitle": "题情二首",
      "author": "王和卿",
      "dynasty": "元",
      "content": "将来书信手拈着，灯下姿姿观觑了。两三行字真带草，提起来越心焦。\n一半儿丝挦一半儿烧。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "6c82c1a8f71b1b6f6baf45cf120e3a1ec9c10f258db56c55ef208c4656af22e4",
      "estimatedOutput": 684,
      "resultPath": "expansion/working/v2/results/yuan-125--6c82c1a8f71b1b6f6baf45cf120e3a1ec9c10f258db56c55ef208c4656af22e4.json"
    },
    {
      "id": "yuan-126",
      "category": "元曲",
      "title": "上小楼",
      "subtitle": "隐居",
      "author": "任昱",
      "dynasty": "元",
      "content": "荆棘满途，蓬莱闲住。诸葛茅庐，陶令松菊，张翰莼鲈。不顺俗。不妄图，清风高度。任年年落花飞絮。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "c5c36b968267317d41bafe3f6a9011f9311243e33473ca50dd0eb8c07004d87d",
      "estimatedOutput": 692,
      "resultPath": "expansion/working/v2/results/yuan-126--c5c36b968267317d41bafe3f6a9011f9311243e33473ca50dd0eb8c07004d87d.json"
    },
    {
      "id": "yuan-127",
      "category": "元曲",
      "title": "庆东原",
      "subtitle": "诗情放",
      "author": "张可久",
      "dynasty": "元",
      "content": "诗情放，剑气豪，英雄不把穷通较。江中斩蛟，云间射雕，席上挥毫。\n他得志笑闲人，他失脚闲人笑。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "6d93f8db2520ec16ab0e2371e4028138ab8fb71ccd29483ed22c40b8c38760e0",
      "estimatedOutput": 692,
      "resultPath": "expansion/working/v2/results/yuan-127--6d93f8db2520ec16ab0e2371e4028138ab8fb71ccd29483ed22c40b8c38760e0.json"
    },
    {
      "id": "yuan-128",
      "category": "元曲",
      "title": "红绣鞋",
      "subtitle": "无是无非心事",
      "author": "张可久",
      "dynasty": "元",
      "content": "无是无非心事，不寒不暖花时，妆点西湖似西施。\n控青丝玉面马，歌金缕粉团儿，信人生行乐耳！",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "7ce2b59865346e31c0fe7f11854c93115dfc08e098db3c1c391d49e7a4f007c5",
      "estimatedOutput": 688,
      "resultPath": "expansion/working/v2/results/yuan-128--7ce2b59865346e31c0fe7f11854c93115dfc08e098db3c1c391d49e7a4f007c5.json"
    },
    {
      "id": "yuan-129",
      "category": "元曲",
      "title": "卖花声",
      "subtitle": "客况",
      "author": "张可久",
      "dynasty": "元",
      "content": "十年落魄江滨客，几度雷轰荐福碑，男儿未遇暗伤怀。忆淮阴年少。灭楚为帅。气昂昂汉坛三拜。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "81aac07ab378b2dd273391a21252c8130a7ffb2cb83a47da4cc5095da1f29c97",
      "estimatedOutput": 686,
      "resultPath": "expansion/working/v2/results/yuan-129--81aac07ab378b2dd273391a21252c8130a7ffb2cb83a47da4cc5095da1f29c97.json"
    },
    {
      "id": "yuan-130",
      "category": "元曲",
      "title": "红绣鞋",
      "subtitle": "西湖雨",
      "author": "张可久",
      "dynasty": "元",
      "content": "删抹了东坡诗句，糊涂了西子妆梳，山色空蒙水模糊。行云神女梦，泼墨范宽图，挂黑龙天外雨。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "619c454cc1a12a8b03d967ee56151b0d82c20c03b757de4685609e68a7d3b3d7",
      "estimatedOutput": 686,
      "resultPath": "expansion/working/v2/results/yuan-130--619c454cc1a12a8b03d967ee56151b0d82c20c03b757de4685609e68a7d3b3d7.json"
    },
    {
      "id": "yuan-131",
      "category": "元曲",
      "title": "大德歌",
      "subtitle": "吹一个",
      "author": "关汉卿",
      "dynasty": "元",
      "content": "吹一个，弹一个，唱新行大德歌。快活休张罗，想人生能几何？\n十分淡薄随缘过，得磨陀处且磨陀。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "cf5aff6e38e6bd5b009eb379209be44de72e6df33d552e72d421416afc201c70",
      "estimatedOutput": 690,
      "resultPath": "expansion/working/v2/results/yuan-131--cf5aff6e38e6bd5b009eb379209be44de72e6df33d552e72d421416afc201c70.json"
    },
    {
      "id": "yuan-132",
      "category": "元曲",
      "title": "一半儿",
      "subtitle": "仙吕·题情",
      "author": "关汉卿",
      "dynasty": "元",
      "content": "碧纱窗外静无人，跪在床前忙要亲。骂了个负心回转身。\n虽是我话儿嗔，一半儿推辞一半儿肯。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "ab72fb785ab37834375fc312877c826f1f57e0484e8c8469e940e6beb32cdf33",
      "estimatedOutput": 686,
      "resultPath": "expansion/working/v2/results/yuan-132--ab72fb785ab37834375fc312877c826f1f57e0484e8c8469e940e6beb32cdf33.json"
    },
    {
      "id": "yuan-133",
      "category": "元曲",
      "title": "红绣鞋",
      "subtitle": "书所见",
      "author": "乔吉",
      "dynasty": "元",
      "content": "脸儿嫩难藏酒晕，扇儿薄不隔歌尘，佯整金钗暗窥人。凉风醒醉眼，明月破诗魂，料今宵怎睡得稳。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "b98d767f7ec4e00afdc7f303b614cf774874fb21a15ac0fa58c2a9eb83a96204",
