    },
    {
      "id": "song-769",
      "category": "宋词",
      "title": "玉楼春",
      "subtitle": "艳冶风情天与措",
      "author": "欧阳修",
      "dynasty": "宋",
      "content": "艳冶风情天与措。\n清瘦肌肤冰雪妒。\n百年心事一宵同，愁听鸡声窗外度。\n信阻青禽云雨暮。\n海月空惊人两处。\n强将离恨倚江楼，江水不能流恨去。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "aade12fb03c9c8c83a45ec6349699edccbe8c0d1b549ee086e84f4eb025fb447",
