    },
    {
      "id": "song-761",
      "category": "宋词",
      "title": "南乡子",
      "subtitle": "浅浅画双眉取次",
      "author": "欧阳修",
      "dynasty": "宋",
      "content": "浅浅画双眉。\n取次梳妆也便宜。\n洒着胭脂红扑面，须知。\n更有何人得似伊。\n宝帐烛残时。\n好个温柔模样儿。\n月里仙郎清似玉，相期。\n些子精神更与谁。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "d329fd37a77df1300adc6e4e5ffc9db543e87d89a35fcfe31bda318b0cfcf3c8",
      "estimatedOutput": 746,
      "resultPath": "expansion/working/v2/results/song-761--d329fd37a77df1300adc6e4e5ffc9db543e87d89a35fcfe31bda318b0cfcf3c8.json"
    },
    {
      "id": "song-762",
      "category": "宋词",
      "title": "南乡子",
      "subtitle": "好个人人深点唇",
      "author": "欧阳修",
      "dynasty": "宋",
      "content": "好个人人，深点唇儿淡抹腮。\n花下相逢、忙走怕人猜。\n遗下弓弓小绣鞋。\n剗袜重来。\n半亸乌云金凤钗。\n行笑行行连抱得，相挨。\n一向娇痴不下怀。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "8bb713ce575c0bba04eec7bb0fba42fc26c36f7c368e2b47591c4b6ee690e1e0",
      "estimatedOutput": 740,
