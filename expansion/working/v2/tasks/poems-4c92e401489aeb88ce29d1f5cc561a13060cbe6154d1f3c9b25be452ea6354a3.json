    },
    {
      "id": "song-763",
      "category": "宋词",
      "title": "踏莎行",
      "subtitle": "碧藓回廊绿杨深",
      "author": "欧阳修",
      "dynasty": "宋",
      "content": "碧藓回廊，绿杨深院。\n偷期夜入帘犹卷。\n照人无奈月华明，潜身却恨花深浅。\n密约如沈，前欢未便。\n看看掷尽金壶箭。\n阑干敲遍不应人，分明帘下闻裁剪。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "49450b00801b816f41d7427ffad38162de41f97b5c4fc3eb64b6c416b64fc457",
      "estimatedOutput": 746,
      "resultPath": "expansion/working/v2/results/song-763--49450b00801b816f41d7427ffad38162de41f97b5c4fc3eb64b6c416b64fc457.json"
    },
    {
      "id": "song-764",
      "category": "宋词",
      "title": "踏莎行",
      "subtitle": "云母屏低流苏帐",
      "author": "欧阳修",
      "dynasty": "宋",
      "content": "云母屏低，流苏帐小。\n矮床薄被秋将晓。\n乍凉天气未寒时，平明窗外闻啼鸟。\n困殢榴花，香添蕙草。\n佳期须及朱颜好。\n莫言多病为多情，此身甘向情中老。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "4a8add6ad8fdbb6026b5eccca233693fafdae6b9af781f8f4b27e064264b8490",
      "estimatedOutput": 746,
      "resultPath": "expansion/working/v2/results/song-764--4a8add6ad8fdbb6026b5eccca233693fafdae6b9af781f8f4b27e064264b8490.json"
    },
    {
      "id": "song-765",
      "category": "宋词",
      "title": "诉衷情",
      "subtitle": "歌时眉黛舞时腰",
      "author": "欧阳修",
      "dynasty": "宋",
      "content": "歌时眉黛舞时腰。\n无处不娇饶。\n初剪菊、欲登高。\n天气怯鲛绡。\n紫丝障，绿杨桥。\n路迢迢。\n酒阑歌罢，一度归时，一度魂消。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "8fbadb486d2a683bc51a192d63615c0886fe5b0fb9291edaa9014d930330abdb",
      "estimatedOutput": 722,
      "resultPath": "expansion/working/v2/results/song-765--8fbadb486d2a683bc51a192d63615c0886fe5b0fb9291edaa9014d930330abdb.json"
    },
    {
      "id": "song-766",
      "category": "宋词",
      "title": "诉衷情",
      "subtitle": "离怀酒病两忡忡",
      "author": "欧阳修",
      "dynasty": "宋",
      "content": "离怀酒病两忡忡。\n倚枕梦无踪。\n可怜有人今夜，胆小怯房空。\n杨柳绿，杏梢红。\n负春风。\n迢迢别恨，脉脉归心，付与征鸿。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "c73842030e6f52310c66b5fac148913728f6c1613b685414abce891277178ff1",
      "estimatedOutput": 718,
      "resultPath": "expansion/working/v2/results/song-766--c73842030e6f52310c66b5fac148913728f6c1613b685414abce891277178ff1.json"
    },
    {
      "id": "song-767",
      "category": "宋词",
      "title": "忆秦娥",
      "subtitle": "十五六脱罗裳长",
      "author": "欧阳修",
      "dynasty": "宋",
      "content": "十五六，脱罗裳，长恁黛眉蹙。\n红玉暖，入人怀，春困熟。\n展香裀，帐前明画烛。\n眼波长，斜浸鬓云绿。\n看不足。\n苦残宵、更漏促。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "34d8cae7e9c63c3a92baf66d6c4d32d53ca2e6e453ddb52be12cbe8e4bbe3316",
