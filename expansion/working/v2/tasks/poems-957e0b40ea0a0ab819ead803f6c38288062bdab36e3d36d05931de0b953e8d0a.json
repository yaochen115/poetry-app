    {
      "id": "tang-821",
      "category": "唐诗",
      "title": "暮春有感寄友人",
      "subtitle": "",
      "author": "鱼玄机",
      "dynasty": "唐",
      "content": "莺语惊残梦，轻妆改泪容。\n竹阴初月薄，江静晚烟浓。\n湿觜衔泥燕，香须采蕊蜂。\n独怜无限思，吟罢亚枝松。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "d361bbad074a27a6600a3fe196c08c59dd519c6d807f3f40c7a9c418cf2f1efd",
      "estimatedOutput": 702,
