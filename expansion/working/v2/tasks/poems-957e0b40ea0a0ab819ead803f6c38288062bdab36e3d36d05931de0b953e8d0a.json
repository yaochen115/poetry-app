    },
    {
      "id": "tang-822",
      "category": "唐诗",
      "title": "王郎中妓席五咏。舞",
      "subtitle": "",
      "author": "顾况",
      "dynasty": "唐",
      "content": "汗浥新装画不成，丝催急节舞衣轻。\n落花绕树疑无影，回雪从风暗有情。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "d31ba7b4a5b1d65899df3fb48751d384317d9cb9e85da33e5708dd985bb6696b",
      "estimatedOutput": 666,
      "resultPath": "expansion/working/v2/results/tang-822--d31ba7b4a5b1d65899df3fb48751d384317d9cb9e85da33e5708dd985bb6696b.json"
    },
    {
      "id": "tang-823",
      "category": "唐诗",
      "title": "寄怀东林寺匡白监寺",
      "subtitle": "",
      "author": "齐己",
      "dynasty": "唐",
      "content": "南岳别来无约后，东林归住有前缘。\n闲搜好句题红叶，静敛霜眉对白莲。\n雁塔影分疏桧月，虎溪声合几峰泉。\n修心若似伊耶舍，传记须添十九贤。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "9e35784dd1d2b6e6bb8134c2b340b71d05c42d2fe290e53c9e7eaacca37a7628",
      "estimatedOutput": 734,
      "resultPath": "expansion/working/v2/results/tang-823--9e35784dd1d2b6e6bb8134c2b340b71d05c42d2fe290e53c9e7eaacca37a7628.json"
    },
    {
      "id": "tang-824",
      "category": "唐诗",
      "title": "白发",
      "subtitle": "",
      "author": "白居易",
      "dynasty": "唐",
      "content": "雪发随梳落，霜毛绕鬓垂。\n加添老气味，改变旧容仪。\n不肯长如漆，无过总作丝。\n最憎明镜里，黑白半头时。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "c754691e81634185351ab8685db82a47553869087a672e4219f360b29e8376bf",
      "estimatedOutput": 702,
      "resultPath": "expansion/working/v2/results/tang-824--c754691e81634185351ab8685db82a47553869087a672e4219f360b29e8376bf.json"
    },
    {
      "id": "tang-825",
      "category": "唐诗",
      "title": "郊庙歌辞。太清宫乐章。第二奏",
      "subtitle": "",
      "author": "佚名",
      "dynasty": "唐",
      "content": "虚极仙宗本，希夷象帝先。\n百灵朝太上，万法祖重圆。\n善贷惟冲德，功成谓自然。\n云门达和气，思用合钧天。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "d33f7faa228359a13d1831aee9c701b75a5bae54aab434a0ff76ac1c286a78bf",
      "estimatedOutput": 702,
      "resultPath": "expansion/working/v2/results/tang-825--d33f7faa228359a13d1831aee9c701b75a5bae54aab434a0ff76ac1c286a78bf.json"
    },
    {
      "id": "tang-826",
      "category": "唐诗",
      "title": "话旧（亭中对兄姊话兰陵崇贤怀真已来故事，泫然而作）",
      "subtitle": "",
      "author": "韦应物",
      "dynasty": "唐",
      "content": "存亡三十载，事过悉成空。\n不惜沾衣泪，并话一宵中。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "420ae1c7cfe72ec23344472dca5dabaf9edee9d0e417f880c254454eec0363a1",
      "estimatedOutput": 650,
      "resultPath": "expansion/working/v2/results/tang-826--420ae1c7cfe72ec23344472dca5dabaf9edee9d0e417f880c254454eec0363a1.json"
    },
    {
      "id": "tang-827",
      "category": "唐诗",
      "title": "绝句",
      "subtitle": "",
      "author": "佚名",
      "dynasty": "唐",
      "content": "绿杨阴转画桥斜，舟有笙歌岸有花。\n尽日会稽山色里，蓬莱清浅水仙家。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "6d82c285fd672b056caf403a87b43b1686ff7b6a554c3a62c642e93a5bc26d79",
      "estimatedOutput": 666,
      "resultPath": "expansion/working/v2/results/tang-827--6d82c285fd672b056caf403a87b43b1686ff7b6a554c3a62c642e93a5bc26d79.json"
    },
    {
      "id": "tang-828",
      "category": "唐诗",
      "title": "奉酬卢端公饮后赠诸公见示之作",
      "subtitle": "",
      "author": "戴叔伦",
      "dynasty": "唐",
      "content": "佐幕临戎旌旆间，五营无事万家闲。\n风吹杨柳渐拂地，日映楼台欲下山。\n绮席昼开留上客，朱门半掩拟重关。\n当时不敢辞先醉，误逐群公倒载还。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "dc6fe72a4974e2cab88bccfc411e34ea488249a7aafb21ad3f864c78423e932f",
      "estimatedOutput": 734,
      "resultPath": "expansion/working/v2/results/tang-828--dc6fe72a4974e2cab88bccfc411e34ea488249a7aafb21ad3f864c78423e932f.json"
    },
    {
      "id": "tang-829",
      "category": "唐诗",
      "title": "遣行十首 其二",
      "subtitle": "",
      "author": "元稹",
      "dynasty": "唐",
      "content": "十五年前事，恓惶无限情。\n病僮更借出，羸马共驰声。\n射叶杨才破，闻弓雁已惊。\n小年辛苦学，求得苦辛行。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "f0009d134bc6fdd257c59780a837a95bb57dbdd1310282fcfaedefc39f5d3c6e",
      "estimatedOutput": 702,
      "resultPath": "expansion/working/v2/results/tang-829--f0009d134bc6fdd257c59780a837a95bb57dbdd1310282fcfaedefc39f5d3c6e.json"
    },
    {
      "id": "tang-830",
      "category": "唐诗",
      "title": "古风其五十一",
      "subtitle": "",
      "author": "李白",
      "dynasty": "唐",
      "content": "殷後乱天纪。\n楚怀亦已昏。\n夷羊满中野。\n菉葹盈高门。\n比干谏而死。\n屈平窜湘源。\n虎口何婉娈。\n女媭空婵媛。\n彭咸久沦没。\n此意与谁论。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "bee13aec0c3139c7a7022918684418c4a539cec65266e5bac62a9dc103f6e1b1",
      "estimatedOutput": 738,
      "resultPath": "expansion/working/v2/results/tang-830--bee13aec0c3139c7a7022918684418c4a539cec65266e5bac62a9dc103f6e1b1.json"
    },
    {
      "id": "tang-831",
      "category": "唐诗",
      "title": "嘉陵",
      "subtitle": "",
      "author": "郑谷",
      "dynasty": "唐",
      "content": "细雨湿萋萋，人稀江日西。\n春愁肠已断，不在子规啼。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "31d6610d86865859ce8b8f05cbab356fc7afd8faef781a3d2a05b82cc88dd28d",
      "estimatedOutput": 650,
      "resultPath": "expansion/working/v2/results/tang-831--31d6610d86865859ce8b8f05cbab356fc7afd8faef781a3d2a05b82cc88dd28d.json"
    },
    {
      "id": "tang-832",
      "category": "唐诗",
      "title": "风雨中寻李十一，因题船上",
      "subtitle": "",
      "author": "白居易",
      "dynasty": "唐",
      "content": "匹马来郊外，扁舟在水滨。\n可怜冲雨客，来访阻风人。\n小榼酤清醑，行厨煮白鳞。\n停杯看柳色，各忆故园春。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "3dc46ea329d50245e56d64099f788440f1184a49eca7d00f984969a51f0c7108",
