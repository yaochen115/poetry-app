    },
    {
      "id": "song-996",
      "category": "宋词",
      "title": "浣溪沙",
      "subtitle": "绿柳藏乌静掩关",
      "author": "晏几道",
      "dynasty": "宋",
      "content": "绿柳藏乌静掩关。\n鸭炉香细琐窗闲。\n那回分袂月初残。\n惜别漫成良夜醉，解愁时有翠笺还。\n欲寻双叶寄情难。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "793d1336ece82e55ff39029da8a8fb94fcda5691d5a695f112ede98c05bed0d5",
