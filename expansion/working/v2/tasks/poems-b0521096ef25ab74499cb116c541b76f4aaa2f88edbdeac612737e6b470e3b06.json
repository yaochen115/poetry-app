    },
    {
      "id": "song-987",
      "category": "宋词",
      "title": "阮郎归",
      "subtitle": "粉痕闲印玉尖纤",
      "author": "晏几道",
      "dynasty": "宋",
      "content": "粉痕闲印玉尖纤。\n啼红傍晚奁。\n旧寒新暖尚相兼。\n梅疏待雪添。\n春冉冉，恨恹恹。\n章台对卷帘。\n个人鞭影弄凉蟾。\n楼前侧帽檐。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "153551e41896986ea0a8255872e415b6f8b2291f21c02009eb7a1ae48989ed5d",
      "estimatedOutput": 726,
      "resultPath": "expansion/working/v2/results/song-987--153551e41896986ea0a8255872e415b6f8b2291f21c02009eb7a1ae48989ed5d.json"
    },
    {
      "id": "song-988",
      "category": "宋词",
      "title": "阮郎归",
      "subtitle": "来时红日弄窗纱",
      "author": "晏几道",
      "dynasty": "宋",
      "content": "来时红日弄窗纱。\n春红入睡霞。\n去时庭树欲栖鸦。\n香屏掩月斜。\n收翠羽，整妆华。\n青骊信又差。\n玉笙犹恋碧桃花。\n今宵未忆家。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "8b4391cc2c1570de2ba66d0b4d2346c876ec313cf036fa5a7022243473007f95",
      "estimatedOutput": 726,
      "resultPath": "expansion/working/v2/results/song-988--8b4391cc2c1570de2ba66d0b4d2346c876ec313cf036fa5a7022243473007f95.json"
    },
    {
      "id": "song-989",
      "category": "宋词",
      "title": "阮郎归",
      "subtitle": "旧香残粉似当初",
      "author": "晏几道",
      "dynasty": "宋",
      "content": "旧香残粉似当初。\n人情恨不如。\n一春犹有数行书。\n秋来书更疏。\n衾凤冷，枕鸳孤。\n愁肠待酒舒。\n梦魂纵有也成虚。\n那堪和梦无。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "e716ca3545b30420495efcbed4550397c138bb2a71663117103e610ea92d0174",
      "estimatedOutput": 726,
      "resultPath": "expansion/working/v2/results/song-989--e716ca3545b30420495efcbed4550397c138bb2a71663117103e610ea92d0174.json"
    },
    {
      "id": "song-990",
      "category": "宋词",
      "title": "阮郎归",
      "subtitle": "晚妆长趁景阳钟",
      "author": "晏几道",
      "dynasty": "宋",
      "content": "晚妆长趁景阳钟。\n双蛾著意浓。\n舞腰浮动绿云浓。\n樱桃半点红。\n怜美景，惜芳容。\n沈思暗记中。\n春寒帘幕几重重。\n杨花尽日风。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "b7ad2cea9ec1e0b9145bec4cc2a3a97ede64e91ac7a407961ebb51fd4991e6bb",
      "estimatedOutput": 726,
      "resultPath": "expansion/working/v2/results/song-990--b7ad2cea9ec1e0b9145bec4cc2a3a97ede64e91ac7a407961ebb51fd4991e6bb.json"
    },
    {
      "id": "song-991",
      "category": "宋词",
      "title": "浣溪沙",
      "subtitle": "二月春花厌落梅",
      "author": "晏几道",
      "dynasty": "宋",
      "content": "二月春花厌落梅。\n仙源归路碧桃催。\n渭城丝雨劝离杯。\n欢意似云真薄幸，客鞭摇柳正多才。\n凤楼人待锦书来。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "b2b9e58fde10a7550b789a9c93174aa5120d77873692e3b210f3e7767355fe8e",
      "estimatedOutput": 704,
      "resultPath": "expansion/working/v2/results/song-991--b2b9e58fde10a7550b789a9c93174aa5120d77873692e3b210f3e7767355fe8e.json"
    },
    {
      "id": "song-992",
      "category": "宋词",
      "title": "浣溪沙",
      "subtitle": "卧鸭池头小苑开",
      "author": "晏几道",
      "dynasty": "宋",
      "content": "卧鸭池头小苑开。\n暄风吹尽北枝梅。\n柳长莎软路萦回。\n静避绿阴莺有意，漫随游骑絮多才。\n去年今日忆同来。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "e18d58fedae3e289965ad23c3157c358a52fa5d5da5191b822039d666c02fa51",
      "estimatedOutput": 704,
      "resultPath": "expansion/working/v2/results/song-992--e18d58fedae3e289965ad23c3157c358a52fa5d5da5191b822039d666c02fa51.json"
    },
    {
      "id": "song-993",
      "category": "宋词",
      "title": "浣溪沙",
      "subtitle": "二月和风到碧城",
      "author": "晏几道",
      "dynasty": "宋",
      "content": "二月和风到碧城。\n万条千缕绿相迎。\n舞烟眠雨过清明。\n妆镜巧眉偷叶样，歌楼妍曲借枝名。\n晚秋霜霰莫无情。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "2486dd98351e0016438624256fc77ec620902fd14786ab6cd30050930f83a3fd",
      "estimatedOutput": 704,
      "resultPath": "expansion/working/v2/results/song-993--2486dd98351e0016438624256fc77ec620902fd14786ab6cd30050930f83a3fd.json"
    },
    {
      "id": "song-994",
      "category": "宋词",
      "title": "浣溪沙",
      "subtitle": "白纻春衫杨柳鞭",
      "author": "晏几道",
      "dynasty": "宋",
      "content": "白纻春衫杨柳鞭。\n碧蹄骄马杏花鞯。\n落英飞絮冶游天。\n南陌暖风吹舞榭，东城凉月照歌筵。\n赏心多是酒中仙。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "5eb8b7769269d346195b4c452dfffe984672aa2a57157671324e1dd5d269bde5",
      "estimatedOutput": 704,
      "resultPath": "expansion/working/v2/results/song-994--5eb8b7769269d346195b4c452dfffe984672aa2a57157671324e1dd5d269bde5.json"
    },
    {
      "id": "song-995",
      "category": "宋词",
      "title": "浣溪沙",
      "subtitle": "床上银屏几点山",
      "author": "晏几道",
      "dynasty": "宋",
      "content": "床上银屏几点山。\n鸭炉香过琐窗寒。\n小云双枕恨春闲。\n惜别漫成良夜醉，解愁时有翠笺还。\n那回分袂月初残。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "c906eaa7b87fcbda5789a1a38964c806b28578e4fa27a6306efabae20b86cc34",
      "estimatedOutput": 704,
