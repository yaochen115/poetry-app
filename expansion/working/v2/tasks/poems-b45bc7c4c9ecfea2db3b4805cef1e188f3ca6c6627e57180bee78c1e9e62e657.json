    {
      "id": "song-531",
      "category": "宋词",
      "title": "画堂春",
      "subtitle": "外潮莲子长参差",
      "author": "张先",
      "dynasty": "宋",
      "content": "外潮莲子长参差。\n霁山青处鸥飞。\n水天溶漾画桡迟。\n人影鉴中移。\n桃叶浅声双唱，杏红深色轻衣。\n小荷障面避斜晖。\n分得翠阴归。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "9dfc4036de055517beb25328d220fb30e82da7f11f72e474ce478fdadf165392",
      "estimatedOutput": 726,
      "resultPath": "expansion/working/v2/results/song-531--9dfc4036de055517beb25328d220fb30e82da7f11f72e474ce478fdadf165392.json"
    },
    {
      "id": "song-532",
      "category": "宋词",
      "title": "更漏子",
      "subtitle": "杜陵春秦树晚伤",
      "author": "张先",
      "dynasty": "宋",
      "content": "杜陵春，秦树晚。\n伤别更堪临远。\n南去信，欲凭谁。\n归鸿多北归。\n小桃枝，红蓓发。\n今夜昔时风月。\n休苦意，说相思。\n少情人不知。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "9d29d648061c9c32bf064a18e0caa0b5b0d6b8b3a44d4bdeb381d6d1e9827b50",
      "estimatedOutput": 730,
