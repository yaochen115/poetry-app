    },
    {
      "id": "song-533",
      "category": "宋词",
      "title": "浣溪沙",
      "subtitle": "楼倚春江百尺高",
      "author": "张先",
      "dynasty": "宋",
      "content": "楼倚春江百尺高。\n烟中还未见归桡。\n几时期信似江潮。\n花片片飞风弄蝶，柳阴阴下水平桥。\n日长才过又今宵。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "4a39b536f1df6a335e98bafa972735f8659bd7f94f57618b4e4c1357a7bf7cf4",
      "estimatedOutput": 704,
      "resultPath": "expansion/working/v2/results/song-533--4a39b536f1df6a335e98bafa972735f8659bd7f94f57618b4e4c1357a7bf7cf4.json"
    },
    {
      "id": "song-534",
      "category": "宋词",
      "title": "虞美人",
      "subtitle": "恩如明月家家到",
      "author": "张先",
      "dynasty": "宋",
      "content": "恩如明月家家到。\n无处无清照。\n一帆秋色共云遥。\n眼力不知人远、上江桥。\n愿君书札来双鲤。\n古汴东流水。\n宋王台畔楚宫西。\n正是节趣归路、近沙堤。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "6bfd01b46a4e8c883cab92b9c794247e9f4c2e8a166a496d432e85cf55c0c908",
      "estimatedOutput": 746,
      "resultPath": "expansion/working/v2/results/song-534--6bfd01b46a4e8c883cab92b9c794247e9f4c2e8a166a496d432e85cf55c0c908.json"
    },
    {
      "id": "song-535",
      "category": "宋词",
      "title": "满江红",
      "subtitle": "飘尽寒梅笑粉蝶",
      "author": "张先",
      "dynasty": "宋",
      "content": "飘尽寒梅，笑粉蝶游蜂未觉。\n渐迤逦、水明山秀，暖生帘幕。\n过雨小桃红未透，舞烟新柳青犹弱。\n记画桥深处水边亭，曾偷约。\n多少恨，今犹昨。\n愁和闷，都忘却。\n拼从前烂醉，被花迷著。\n晴鸽试铃风力软，雏莺弄舌春寒薄。\n但只愁、锦绣闹妆时，东风恶。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "2d67f724b655b78acbad4e0d81e79677fe34b6d9ad8737448d8fe5c292c9f691",
      "estimatedOutput": 842,
      "resultPath": "expansion/working/v2/results/song-535--2d67f724b655b78acbad4e0d81e79677fe34b6d9ad8737448d8fe5c292c9f691.json"
    },
    {
      "id": "song-536",
      "category": "宋词",
      "title": "西江月",
      "subtitle": "肃肃秺侯清慎温",
      "author": "张先",
      "dynasty": "宋",
      "content": "肃肃秺侯清慎，温温契苾知诗。\n能推恻隐救民饥。\n况乃义方教子。\n宪府两飞鹗荐，士林竞赋怀辞。\n天门正美可前知。\n入侍钧天从此。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "4478d213dacc8d5dd9184a90331a33b9f565386f98fe610972d54edbbfdca3ff",
      "estimatedOutput": 726,
      "resultPath": "expansion/working/v2/results/song-536--4478d213dacc8d5dd9184a90331a33b9f565386f98fe610972d54edbbfdca3ff.json"
    },
    {
      "id": "song-537",
      "category": "宋词",
      "title": "浪淘沙",
      "subtitle": "肠断送韶华为惜",
      "author": "张先",
      "dynasty": "宋",
      "content": "肠断送韶华。\n为惜杨花。\n雪球摇曳逐风斜。\n容易著人容易去，飞过谁家。\n聚散苦咨嗟。\n无计留他。\n行人洒泪滴流霞。\n今日画堂歌舞地，明日天涯。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "7c9282b2693270cb7e21dcecca018c3d2b13ae38d6e1c9980fc42e1aadd93210",
      "estimatedOutput": 742,
      "resultPath": "expansion/working/v2/results/song-537--7c9282b2693270cb7e21dcecca018c3d2b13ae38d6e1c9980fc42e1aadd93210.json"
    },
    {
      "id": "song-538",
      "category": "宋词",
      "title": "碧牡丹",
      "subtitle": "步帐摇红绮晓月",
      "author": "张先",
      "dynasty": "宋",
      "content": "步帐摇红绮。\n晓月堕，沈烟砌。\n缓板香檀，唱彻伊家新制。\n怨入眉头，敛黛峰横翠。\n芭蕉寒，雨声碎。\n镜华翳。\n闲照孤鸾戏。\n思量去时容易。\n钿盒瑶钗，至今冷落轻弃。\n望极蓝桥，但暮云千里。\n几重山，几重水。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "b69ca77bc55c0dd3f23477e5ddf76feb4a2edc0c328c049d24b8067457e7679f",
      "estimatedOutput": 806,
      "resultPath": "expansion/working/v2/results/song-538--b69ca77bc55c0dd3f23477e5ddf76feb4a2edc0c328c049d24b8067457e7679f.json"
    },
    {
      "id": "song-539",
      "category": "宋词",
      "title": "谒金门",
      "subtitle": "秋露坠滴尽楚兰",
      "author": "晏殊",
      "dynasty": "宋",
      "content": "秋露坠。\n滴尽楚兰红泪。\n往事旧欢何限意。\n思量如梦寐。\n人貌老于前岁。\n风月宛然无异。\n座有嘉宾尊有桂。\n莫辞终夕醉。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "efd886f24e0c3999074198723717219fb9d55ff8ed9a25646439e0d4b393c1cf",
      "estimatedOutput": 720,
      "resultPath": "expansion/working/v2/results/song-539--efd886f24e0c3999074198723717219fb9d55ff8ed9a25646439e0d4b393c1cf.json"
    },
    {
      "id": "song-540",
      "category": "宋词",
      "title": "破阵子",
      "subtitle": "海上蟠桃易熟人",
      "author": "晏殊",
      "dynasty": "宋",
      "content": "海上蟠桃易熟，人间好月长圆。\n惟有掰钗分钿侣，离别常多会面难。\n此情须问天。\n蜡烛到明垂泪，熏炉尽日生烟。\n一点凄凉愁绝意，谩道秦筝有剩弦。\n何曾为细传。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "03fec80022398dff6b04e1576560d4fb331a596ed33c6e97e727ab6bfbb96632",
      "estimatedOutput": 754,
      "resultPath": "expansion/working/v2/results/song-540--03fec80022398dff6b04e1576560d4fb331a596ed33c6e97e727ab6bfbb96632.json"
    },
    {
      "id": "song-541",
      "category": "宋词",
      "title": "破阵子",
      "subtitle": "忆得去年今日黄",
      "author": "晏殊",
      "dynasty": "宋",
      "content": "忆得去年今日，黄花已满东篱。\n曾与玉人临小槛，共折香英泛酒卮。\n长条插鬓垂。\n人貌不应迁换，珍丛又睹芳菲。\n重把一尊寻旧径，所惜光阴去似飞。\n风飘露冷时。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "944ec234261baee16718277a28d4617fecfe2f0859bb49c6995027076b1ab619",
