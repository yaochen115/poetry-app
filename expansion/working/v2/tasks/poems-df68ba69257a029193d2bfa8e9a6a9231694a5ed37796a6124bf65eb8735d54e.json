      "resultPath": "expansion/working/v2/results/tang-860--bdb466b447b58ec22b4ee9a3bf1de3872308e666b70aab5cebef4bfa59976d2c.json"
    },
    {
      "id": "tang-861",
      "category": "唐诗",
      "title": "渚宫莫问诗一十五首 其十",
      "subtitle": "",
      "author": "齐己",
      "dynasty": "唐",
      "content": "莫问无机性，甘名百钝人。\n一床铺冷落，长日卧精神。\n分已疏知旧，诗还得意新。\n多才碧云客，时或此相亲。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "25d5d90a23895d58791f767bc9b30c7bbfaf8274fac75e1c6ed19a4f43ed6f25",
      "estimatedOutput": 702,
      "resultPath": "expansion/working/v2/results/tang-861--25d5d90a23895d58791f767bc9b30c7bbfaf8274fac75e1c6ed19a4f43ed6f25.json"
    },
    {
      "id": "tang-862",
      "category": "唐诗",
      "title": "奉酬睢阳路太守见赠之作",
      "subtitle": "",
      "author": "高适",
      "dynasty": "唐",
      "content": "盛才膺命代，高价动良时。\n帝简登藩翰，人和发咏思。\n神仙去华省，鹓鹭忆丹墀。\n清净能无事，优游即赋诗。\n江山纷想像，云物共萎蕤。\n逸气刘公幹，玄言向子期。\n多惭汲引速，翻愧激昂迟。\n相马知何限，登龙反自疑。\n风尘吏道迫，行迈旅心悲。\n拙疾徒为尔，穷愁欲问谁。\n秋庭一片叶，朝镜数茎丝。\n州县甘无取，丘园悔莫追。\n琼瑶生箧笥，光景借茅茨。\n他日青霄里，犹应访所知。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "48657dc3bd2082f24c922f382209a77231deb29c03669848c8829d459abbd263",
      "estimatedOutput": 962,
      "resultPath": "expansion/working/v2/results/tang-862--48657dc3bd2082f24c922f382209a77231deb29c03669848c8829d459abbd263.json"
    },
    {
      "id": "tang-863",
      "category": "唐诗",
      "title": "渔歌子",
      "subtitle": "霅溪湾里钓鱼翁",
      "author": "张志和",
      "dynasty": "唐",
      "content": "霅溪湾里钓鱼翁，蚱艋为家西复东。\n江上雪，浦边风，笑着荷衣不叹穷。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "3a11fb3ff75811880f3afc0731af2c11a3de3b005f166d6c3eaabdc9a5091763",
      "estimatedOutput": 666,
      "resultPath": "expansion/working/v2/results/tang-863--3a11fb3ff75811880f3afc0731af2c11a3de3b005f166d6c3eaabdc9a5091763.json"
    },
    {
      "id": "tang-864",
      "category": "唐诗",
      "title": "题从叔述灵岩山壁",
      "subtitle": "",
      "author": "孟郊",
      "dynasty": "唐",
      "content": "换却世上心，独起山中情。\n露衣凉且鲜，云策高复轻。\n喜见夏日来，变为松景清。\n每将逍遥听，不厌飕飗声。\n远念尘末宗，未疏俗间名。\n桂枝妄举手，萍路空劳生。\n仰谢开净弦，相招时一鸣。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "5e52819df9ad794798c7d2fe9e451cd81997dd8a32e953ea46ce940f8e5f4cb9",
      "estimatedOutput": 780,
      "resultPath": "expansion/working/v2/results/tang-864--5e52819df9ad794798c7d2fe9e451cd81997dd8a32e953ea46ce940f8e5f4cb9.json"
    },
    {
      "id": "tang-865",
      "category": "唐诗",
      "title": "江亭夕望",
      "subtitle": "",
      "author": "白居易",
      "dynasty": "唐",
      "content": "凭高望远思悠哉，晚上江亭夜未回。\n日欲没时红浪沸，月初生处白烟开。\n辞枝雪蕊将春去，满镊霜毛送老来。\n争敢三年作归计，心知不及贾生才。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "b9ec6f4d456d88f746d0e8be2ab9f372469c140d12ecab0bf462941fa2282930",
      "estimatedOutput": 734,
      "resultPath": "expansion/working/v2/results/tang-865--b9ec6f4d456d88f746d0e8be2ab9f372469c140d12ecab0bf462941fa2282930.json"
    },
    {
      "id": "tang-866",
      "category": "唐诗",
      "title": "宿东谿王屋李隐者",
      "subtitle": "",
      "author": "岑参",
      "dynasty": "唐",
      "content": "山店不凿井，百家同一泉。\n晚来南村黑，雨色和人烟。\n霜畦吐寒菜，沙雁噪河田。\n隐者不可见，天坛飞鸟边。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "9654da08f3e63408d422a1b095f2e3fb013f8f2726c4dea29098a6263fa05f62",
      "estimatedOutput": 702,
      "resultPath": "expansion/working/v2/results/tang-866--9654da08f3e63408d422a1b095f2e3fb013f8f2726c4dea29098a6263fa05f62.json"
    },
    {
      "id": "tang-867",
      "category": "唐诗",
      "title": "休暇东斋",
      "subtitle": "",
      "author": "韦应物",
      "dynasty": "唐",
      "content": "由来束带士，请谒无朝暮。\n公暇及私身，何能独闲步。\n摘叶爱芳在，扪竹怜粉污。\n岸帻偃东斋，夏天清晓露。\n怀仙阅真诰，贻友题幽素。\n荣达颇知疏，恬然自成度。\n绿苔日已满，幽寂谁来顾。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "c29e745dd919481063f1244afc81c82ca2820830c90622250f855c214d0cf3b8",
      "estimatedOutput": 780,
      "resultPath": "expansion/working/v2/results/tang-867--c29e745dd919481063f1244afc81c82ca2820830c90622250f855c214d0cf3b8.json"
    },
    {
      "id": "tang-868",
      "category": "唐诗",
      "title": "宿报恩寺水阁",
      "subtitle": "",
      "author": "皮日休",
      "dynasty": "唐",
      "content": "寺锁双峰寂不开，幽人中夜独裴回。\n池文带月铺金簟，莲朵含风动玉杯。\n往往竹梢摇翡翠，时时杉子掷莓苔。\n可怜此际谁曾见，唯有支公尽看来。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "fc45ed29b3504ac88c7484865ef76c891722cf2bfc449d2ce63d28b2688fc1e7",
