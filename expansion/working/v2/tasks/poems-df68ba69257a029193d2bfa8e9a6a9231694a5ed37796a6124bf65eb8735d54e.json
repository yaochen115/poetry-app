      "resultPath": "expansion/working/v2/results/tang-859--3c247cdcbc0827ed1b737c7564d1d075e4ea5fac00fad08f344f9ad62d612756.json"
    },
    {
      "id": "tang-860",
      "category": "唐诗",
      "title": "杂曲歌辞。桂花曲",
      "subtitle": "",
      "author": "佚名",
      "dynasty": "唐",
      "content": "可怜天上桂花孤，试问姮娥更要无。\n月宫幸有闲田地，何不中央种两株。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "bdb466b447b58ec22b4ee9a3bf1de3872308e666b70aab5cebef4bfa59976d2c",
