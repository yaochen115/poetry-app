    },
    {
      "id": "tang-858",
      "category": "唐诗",
      "title": "感兴其六",
      "subtitle": "",
      "author": "李白",
      "dynasty": "唐",
      "content": "嘉谷隐丰草。\n草深苗且稀。\n农夫既不异。\n孤穗将安归。\n常恐委畴陇。\n忽与秋蓬飞。\n鸟得荐宗庙。\n为君生光辉。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "c72a1bfed59eb69ae545a4004c44dd38b964f08418e67fe5cf1bd5601bb474de",
      "estimatedOutput": 710,
      "resultPath": "expansion/working/v2/results/tang-858--c72a1bfed59eb69ae545a4004c44dd38b964f08418e67fe5cf1bd5601bb474de.json"
    },
    {
      "id": "tang-859",
      "category": "唐诗",
      "title": "夕次寿阳驿题吴郎中诗后",
      "subtitle": "",
      "author": "韩愈",
      "dynasty": "唐",
      "content": "风光欲动别长安，春半城边特地寒。\n不见园花兼巷柳，马头惟有月团团。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "3c247cdcbc0827ed1b737c7564d1d075e4ea5fac00fad08f344f9ad62d612756",
