    },
    {
      "id": "yuan-088",
      "category": "元曲",
      "title": "清江引",
      "subtitle": "黄莺乱啼门外柳",
      "author": "张可久",
      "dynasty": "元",
      "content": "黄莺乱啼门外柳，雨细清明后。能消几日春，又是相思瘦。\n梨花小窗人病酒。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "9442836ee4b939bfc2c8f2c9dffb262102b6941087065a6d59ab2547b1f2be18",
      "estimatedOutput": 670,
      "resultPath": "expansion/working/v2/results/yuan-088--9442836ee4b939bfc2c8f2c9dffb262102b6941087065a6d59ab2547b1f2be18.json"
    },
    {
      "id": "yuan-089",
      "category": "元曲",
      "title": "清江引",
      "subtitle": "平安信来刚半纸",
      "author": "张可久",
      "dynasty": "元",
      "content": "平安信来刚半纸，几对鸳鸯字。花开望远行，玉减伤春事。\n东风草堂飞燕子。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "420901774ee9741021cfbfb2b7e5c2a64496c266e82660b508577f84ddc890ef",
      "estimatedOutput": 670,
      "resultPath": "expansion/working/v2/results/yuan-089--420901774ee9741021cfbfb2b7e5c2a64496c266e82660b508577f84ddc890ef.json"
    },
    {
      "id": "yuan-090",
      "category": "元曲",
      "title": "四块玉",
      "subtitle": "乐闲",
      "author": "张可久",
      "dynasty": "元",
      "content": "远是非，寻潇洒。\n地暖江南燕宜家，人闲水北春无价。\n一品茶，五色瓜，四季花。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "e5b89467613f27571bf8cb5bbb95b07b6f6f8b659599392201d148bdfd91168c",
      "estimatedOutput": 676,
      "resultPath": "expansion/working/v2/results/yuan-090--e5b89467613f27571bf8cb5bbb95b07b6f6f8b659599392201d148bdfd91168c.json"
    },
    {
      "id": "yuan-091",
      "category": "元曲",
      "title": "阳春曲",
      "subtitle": "皇亭晚泊",
      "author": "徐再思",
      "dynasty": "元",
      "content": "水深水浅东西涧，云去云来远近山。秋风征棹钓鱼滩。烟树晚，茅舍两三间。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "3ef3f8d0fac90dae166fc7d58fdb57612c3cc508c300f960b5383a159c3c70c5",
      "estimatedOutput": 668,
      "resultPath": "expansion/working/v2/results/yuan-091--3ef3f8d0fac90dae166fc7d58fdb57612c3cc508c300f960b5383a159c3c70c5.json"
    },
    {
      "id": "yuan-092",
      "category": "元曲",
      "title": "喜春来",
      "subtitle": "闺怨",
      "author": "徐再思",
      "dynasty": "元",
      "content": "妾身悔作商人妇，妾命当逢薄幸夫。别时只说到东吴，三载余，却得广州书。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "9b1fef26fd0f141ad554269d5311a7d73c46e046760f32129ae50831d60d3214",
      "estimatedOutput": 668,
      "resultPath": "expansion/working/v2/results/yuan-092--9b1fef26fd0f141ad554269d5311a7d73c46e046760f32129ae50831d60d3214.json"
    },
    {
      "id": "yuan-093",
      "category": "元曲",
      "title": "乔木查",
      "subtitle": "想秦宫汉阙",
      "author": "马致远",
      "dynasty": "元",
      "content": "想秦宫汉阙，都做了衰草牛羊野。不恁渔樵无话说。\n纵荒坟横断碑，不辨龙蛇。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "e9a471e8c792c12b7252cd302df2dd478c5e6c48084efecbc0cc733ca55ec353",
      "estimatedOutput": 672,
      "resultPath": "expansion/working/v2/results/yuan-093--e9a471e8c792c12b7252cd302df2dd478c5e6c48084efecbc0cc733ca55ec353.json"
    },
    {
      "id": "yuan-094",
      "category": "元曲",
      "title": "清江引",
      "subtitle": "林泉隐居谁到此",
      "author": "马致远",
      "dynasty": "元",
      "content": "林泉隐居谁到此，有客清风至。会作山中相，不管人间事。\n争甚么半张名利纸！",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "2e707add8f982a7e2352ae5d1eb1368fb0adb22b35814332dfa0c06228bde057",
      "estimatedOutput": 672,
      "resultPath": "expansion/working/v2/results/yuan-094--2e707add8f982a7e2352ae5d1eb1368fb0adb22b35814332dfa0c06228bde057.json"
    },
    {
      "id": "yuan-095",
      "category": "元曲",
      "title": "清江引",
      "subtitle": "西村日长人事少",
      "author": "马致远",
      "dynasty": "元",
      "content": "西村日长人事少，一个新蝉噪。恰待葵花开，又早蜂儿闹，高枕上梦随蝶去了。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "2d75d6a25163528a056e03e3443bb7c9ddaea9c42c4cd45f612baac913a01dcb",
      "estimatedOutput": 670,
      "resultPath": "expansion/working/v2/results/yuan-095--2d75d6a25163528a056e03e3443bb7c9ddaea9c42c4cd45f612baac913a01dcb.json"
    },
    {
      "id": "yuan-096",
      "category": "元曲",
      "title": "四块玉",
      "subtitle": "浔阳江",
      "author": "马致远",
      "dynasty": "元",
      "content": "送客时，秋江冷。商女琵琶断肠声。可知道司马和愁听。月又明，酒又酲，客乍醒。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "a90e0b69eb9f96f3cd2ec08398e04918bd3b5634907c088767ca01d1870486d6",
      "estimatedOutput": 674,
      "resultPath": "expansion/working/v2/results/yuan-096--a90e0b69eb9f96f3cd2ec08398e04918bd3b5634907c088767ca01d1870486d6.json"
    },
    {
      "id": "yuan-097",
      "category": "元曲",
      "title": "寨儿令",
      "subtitle": "桃花开时",
      "author": "周文质",
      "dynasty": "元",
      "content": "桃花开时，到今日杨柳垂丝。假题情绝句诗，虚写恨断肠词。嗤！都扯做纸条儿。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "d863e5eba19cbb6cb5331a8d4c71365ce81d143771eb3accc7b12df918038811",
