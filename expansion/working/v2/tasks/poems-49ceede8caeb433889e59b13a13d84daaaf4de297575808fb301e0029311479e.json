    },
    {
      "id": "yuan-087",
      "category": "元曲",
      "title": "清江引",
      "subtitle": "春思",
      "author": "张可久",
      "dynasty": "元",
      "content": "松风小楼香缥缈，一曲寻仙操。秋风玉兔寒，野树金猿啸，白云半天山月小。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "fa8b0455d6be003cda951d8f2061405e2018769288018fc3c10f470591c99d18",
      "estimatedOutput": 668,
