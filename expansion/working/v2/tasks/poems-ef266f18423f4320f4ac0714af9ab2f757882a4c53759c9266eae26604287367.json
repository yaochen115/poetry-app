    },
    {
      "id": "tang-702",
      "category": "唐诗",
      "title": "送客水路归陕",
      "subtitle": "",
      "author": "韩翃",
      "dynasty": "唐",
      "content": "相风竿影晓来斜，渭水东流去不赊。\n枕上未醒秦地酒，舟前已见陕人家。\n春桥杨柳应齐叶，古县棠梨也作花。\n好是吾贤佳赏地，行逢三月会连沙。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "c0ec4b680d38744182ff701eda81b39b44bda8d3d0ec0679dcea387618bac97e",
      "estimatedOutput": 734,
      "resultPath": "expansion/working/v2/results/tang-702--c0ec4b680d38744182ff701eda81b39b44bda8d3d0ec0679dcea387618bac97e.json"
    },
    {
      "id": "tang-703",
      "category": "唐诗",
      "title": "闻范秀才自蜀游江湖",
      "subtitle": "",
      "author": "杜牧",
      "dynasty": "唐",
      "content": "蜀道下湘渚，客帆应不迷。\n江分三峡响，山并九华齐。\n秋泊雁初宿，夜吟猿乍啼。\n归时慎行李，莫到石城西。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "01b99434f0fd203cfbc837055d9fe94892f20f5584f86dbc4bdb4ea4f060c039",
      "estimatedOutput": 702,
      "resultPath": "expansion/working/v2/results/tang-703--01b99434f0fd203cfbc837055d9fe94892f20f5584f86dbc4bdb4ea4f060c039.json"
    },
    {
      "id": "tang-704",
      "category": "唐诗",
      "title": "慈恩寺东楼",
      "subtitle": "",
      "author": "曹松",
      "dynasty": "唐",
      "content": "寺楼凉出竹，非与曲江赊。\n野火流穿苑，秦山叠入巴。\n风梢离众叶，岸角积虚沙。\n此地钟声近，令人思未涯。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "2767b6ad630e050a877ad089362a579bf0ef8055f276dd1896701617d39ad47a",
      "estimatedOutput": 702,
      "resultPath": "expansion/working/v2/results/tang-704--2767b6ad630e050a877ad089362a579bf0ef8055f276dd1896701617d39ad47a.json"
    },
    {
      "id": "tang-705",
      "category": "唐诗",
      "title": "骕骦骏",
      "subtitle": "",
      "author": "杜牧",
      "dynasty": "唐",
      "content": "瑶池罢游宴，良乐委尘沙。\n遭遇不遭遇，盐车与鼓车。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "2729b3a98e0de224540d75d475afbfe4eca0d1417f70c10363bb705e38537924",
      "estimatedOutput": 650,
      "resultPath": "expansion/working/v2/results/tang-705--2729b3a98e0de224540d75d475afbfe4eca0d1417f70c10363bb705e38537924.json"
    },
    {
      "id": "tang-706",
      "category": "唐诗",
      "title": "感遇诗三十八首 其八",
      "subtitle": "",
      "author": "陈子昂",
      "dynasty": "唐",
      "content": "吾观昆崙化，日月沦洞冥。\n精魄相交会，天壤以罗生。\n仲尼推太极，老聃贵窈冥。\n西方金仙子，崇义乃无明。\n空色皆寂灭，缘业定何成。\n名教信纷藉，死生俱未停。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "42193b104db32d81cd7842814062447d395c983795b88d5bd51fc23a918bae48",
      "estimatedOutput": 754,
      "resultPath": "expansion/working/v2/results/tang-706--42193b104db32d81cd7842814062447d395c983795b88d5bd51fc23a918bae48.json"
    },
    {
      "id": "tang-707",
      "category": "唐诗",
      "title": "内题赋得巫山雨（一作沈佺期诗。题云巫山高）",
      "subtitle": "",
      "author": "宋之问",
      "dynasty": "唐",
      "content": "神女向高唐，巫山下夕阳。\n裴回作行雨，婉恋逐荆王。\n电影江前落，雷声峡外长。\n霁云无处所，台馆晓苍苍。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "6ed6162cfef625e7d23c250049babf0d7955b81de79f57e44adaadf7e4b13a9f",
      "estimatedOutput": 702,
      "resultPath": "expansion/working/v2/results/tang-707--6ed6162cfef625e7d23c250049babf0d7955b81de79f57e44adaadf7e4b13a9f.json"
    },
    {
      "id": "tang-708",
      "category": "唐诗",
      "title": "长安旅宿",
      "subtitle": "",
      "author": "钱起",
      "dynasty": "唐",
      "content": "九秋旅夜长，万感何时歇。\n蕙花渐寒暮，心事犹楚越。\n直躬邅世道，咫步隔天阙。\n每闻长乐钟，载泣灵台月。\n明旦北门外，归途堪白发。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "2d218bd57c5d6116ad999da42335709905ce77d990b8eaca90bce81187508998",
      "estimatedOutput": 728,
      "resultPath": "expansion/working/v2/results/tang-708--2d218bd57c5d6116ad999da42335709905ce77d990b8eaca90bce81187508998.json"
    },
    {
      "id": "tang-709",
      "category": "唐诗",
      "title": "喜马参军相遇醉歌",
      "subtitle": "",
      "author": "陈子昂",
      "dynasty": "唐",
      "content": "独幽默以三月兮，深林潜居。\n时岁忽兮，孤愤遐吟。\n谁知我心？\n孺子孺子，其可与理分。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "c460e7df26762488fbf5f8259fdc04007ff2871dc8e7f68ce4df42ccbcd17bd4",
