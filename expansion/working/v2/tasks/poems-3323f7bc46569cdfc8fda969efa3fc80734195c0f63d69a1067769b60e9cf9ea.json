    },
    {
      "id": "song-1049",
      "category": "宋词",
      "title": "采桑子",
      "subtitle": "日高庭院杨花转",
      "author": "晏几道",
      "dynasty": "宋",
      "content": "日高庭院杨花转，闲淡春风。\n昨夜匆匆。\n颦入遥山翠黛中。\n金盆水冷菱花净，满面残红。\n欲洗犹慵。\n弦上啼乌此夜同。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "8a4f9d233aba924994f5a15035099586302689425c9b68c3485c5999a4f10ccd",
