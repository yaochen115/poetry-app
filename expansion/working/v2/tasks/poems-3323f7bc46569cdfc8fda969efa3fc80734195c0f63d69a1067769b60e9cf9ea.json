    },
    {
      "id": "song-1048",
      "category": "宋词",
      "title": "采桑子",
      "subtitle": "芦鞭坠遍杨花陌",
      "author": "晏几道",
      "dynasty": "宋",
      "content": "芦鞭坠遍杨花陌，晚见珍珍。\n疑是朝云。\n来作高唐梦里人。\n应怜醉落楼中帽，长带歌尘。\n试拂香茵。\n留解金鞍睡过春。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "47375393cfe71902ac0e370eb1e672f2209c2d46c365a0ec4d22e0a3b5b5f8a3",
