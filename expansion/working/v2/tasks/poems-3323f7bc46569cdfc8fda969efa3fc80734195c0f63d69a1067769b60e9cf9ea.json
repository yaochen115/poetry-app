      "resultPath": "expansion/working/v2/results/song-1049--8a4f9d233aba924994f5a15035099586302689425c9b68c3485c5999a4f10ccd.json"
    },
    {
      "id": "song-1050",
      "category": "宋词",
      "title": "采桑子",
      "subtitle": "征人去日殷勤嘱",
      "author": "晏几道",
      "dynasty": "宋",
      "content": "征人去日殷勤嘱，莫负心期。\n寒雁来时。\n第一传书慰别离。\n轻春织就机中素，泪墨题诗。\n欲寄相思。\n日日高楼看雁飞。",
      "excerptOf": null,
