    },
    {
      "id": "tang-913",
      "category": "唐诗",
      "title": "盩厔县北楼望山",
      "subtitle": "",
      "author": "白居易",
      "dynasty": "唐",
      "content": "一为趋走吏，尘土不开颜。\n孤负平生眼，今朝始见山。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "4c468b4a5e310415a9ac95e961125595582189bacf324163270a92cb39b01e98",
