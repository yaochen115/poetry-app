    },
    {
      "id": "tang-915",
      "category": "唐诗",
      "title": "泗上奉送相公",
      "subtitle": "",
      "author": "赵嘏",
      "dynasty": "唐",
      "content": "语堪铭座默含春，西汉公卿绝比伦。\n今日抱辕留不得，欲挥双涕学舒人。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "1eef4fab42ca45cd33a605fd29ff700301567fb8f121ae01a61e001f43f8ef0c",
