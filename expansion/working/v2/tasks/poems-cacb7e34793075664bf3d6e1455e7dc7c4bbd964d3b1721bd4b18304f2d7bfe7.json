    },
    {
      "id": "song-580",
      "category": "宋词",
      "title": "渔家傲",
      "subtitle": "画鼓声中昏又晓",
      "author": "晏殊",
      "dynasty": "宋",
      "content": "画鼓声中昏又晓。\n时光只解催人老。\n求得浅欢风日好。\n齐揭调。\n神仙一曲渔家傲。\n绿水悠悠天杳杳。\n浮生岂得长年少。\n莫惜醉来开口笑。\n须信道。\n人间万事何时了。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "5f609726d31332853e0401efddb70072b2e6ae8dd090eee1e24a1da2551c91ae",
      "estimatedOutput": 762,
      "resultPath": "expansion/working/v2/results/song-580--5f609726d31332853e0401efddb70072b2e6ae8dd090eee1e24a1da2551c91ae.json"
    },
    {
      "id": "song-581",
      "category": "宋词",
      "title": "渔家傲",
      "subtitle": "荷叶荷花相间斗",
      "author": "晏殊",
      "dynasty": "宋",
      "content": "荷叶荷花相间斗。\n红娇绿嫩新妆就。\n昨日小池疏雨后。\n铺锦绣。\n行人过去频回首。\n倚遍朱阑凝望久。\n鸳鸯浴处波文皱。\n谁唤谢娘斟美酒。\n萦舞袖。\n当筵劝我千长寿。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "03c506e6c7b4809c3946db9c0631954c52942f7f5265025effb5a1580ad7afc9",
      "estimatedOutput": 762,
      "resultPath": "expansion/working/v2/results/song-581--03c506e6c7b4809c3946db9c0631954c52942f7f5265025effb5a1580ad7afc9.json"
    },
    {
      "id": "song-582",
      "category": "宋词",
      "title": "渔家傲",
      "subtitle": "荷叶初开犹半卷",
      "author": "晏殊",
      "dynasty": "宋",
      "content": "荷叶初开犹半卷。\n荷花欲拆犹微绽。\n此叶此花真可羡。\n秋水畔。\n青凉伞映红妆面。\n美酒一杯留客宴。\n拈花摘叶情无限。\n争奈世人多聚散。\n频祝愿。\n如花似叶长相见。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "656eba7df6e80713f7849ef5443d676a6fcd2c53ef7f175a977645e2b88f33de",
      "estimatedOutput": 762,
      "resultPath": "expansion/working/v2/results/song-582--656eba7df6e80713f7849ef5443d676a6fcd2c53ef7f175a977645e2b88f33de.json"
    },
    {
      "id": "song-583",
      "category": "宋词",
      "title": "渔家傲",
      "subtitle": "杨柳风前香百步",
      "author": "晏殊",
      "dynasty": "宋",
      "content": "杨柳风前香百步。\n盘心碎点真珠露。\n疑是水仙开洞府。\n妆景趣。\n红幢绿盖朝天路。\n小鸭飞来稠闹处。\n三三两两能言语。\n饮散短亭人欲去。\n留不住。\n黄昏更下萧萧雨。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "4b2a494b15c3fdebd1f0854bd491d55fb4ebeef5d3bdc561ba98a226733b4004",
      "estimatedOutput": 762,
      "resultPath": "expansion/working/v2/results/song-583--4b2a494b15c3fdebd1f0854bd491d55fb4ebeef5d3bdc561ba98a226733b4004.json"
    },
    {
      "id": "song-584",
      "category": "宋词",
      "title": "渔家傲",
      "subtitle": "粉笔丹青描未得",
      "author": "晏殊",
      "dynasty": "宋",
      "content": "粉笔丹青描未得。\n金针彩线功难敌。\n谁傍暗香轻采摘。\n风淅淅。\n船头触散双鸂鶒。\n夜雨染成天水碧。\n朝阳借出胭脂色。\n欲落又开人共惜。\n秋气逼。\n盘中已见新莲菂。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "18921276fbc4d5cb9fcee4c77496d1f98eb4db89e54459abe4dfc6a66a0b54ee",
      "estimatedOutput": 762,
      "resultPath": "expansion/working/v2/results/song-584--18921276fbc4d5cb9fcee4c77496d1f98eb4db89e54459abe4dfc6a66a0b54ee.json"
    },
    {
      "id": "song-585",
      "category": "宋词",
      "title": "渔家傲",
      "subtitle": "叶下䴔䴖眠未稳",
      "author": "晏殊",
      "dynasty": "宋",
      "content": "叶下鵁鶄眠未稳。\n风翻露飐香成阵。\n仙女出游知远近。\n羞借问。\n饶将绿扇遮红粉。\n一掬蕊黄沾雨润。\n天人乞与金英嫩。\n试折乱条醒酒困。\n应有恨。\n芳心拗尽丝无尽。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "d523ad751c0e775f3bc102633a428c8c5f935af4c778fd15b43dc8c8f2e2a2a3",
      "estimatedOutput": 762,
      "resultPath": "expansion/working/v2/results/song-585--d523ad751c0e775f3bc102633a428c8c5f935af4c778fd15b43dc8c8f2e2a2a3.json"
    },
    {
      "id": "song-586",
      "category": "宋词",
      "title": "渔家傲",
      "subtitle": "罨画溪边停彩舫",
      "author": "晏殊",
      "dynasty": "宋",
      "content": "罨画溪边停彩舫。\n仙娥绣被呈新样。\n飒飒风声来一饷。\n愁四望。\n残红片片随波浪。\n琼脸丽人青步障。\n风牵一袖低相向。\n应有锦鳞闲倚傍。\n秋水上。\n时时绿柄轻摇扬。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "9aa09f09c3e8bee306d07465f8a5e12cbe3f6e1c7293c5bf0c8817132e30149d",
      "estimatedOutput": 762,
      "resultPath": "expansion/working/v2/results/song-586--9aa09f09c3e8bee306d07465f8a5e12cbe3f6e1c7293c5bf0c8817132e30149d.json"
    },
    {
      "id": "song-587",
      "category": "宋词",
      "title": "渔家傲",
      "subtitle": "宿蕊斗攒金粉闹",
      "author": "晏殊",
      "dynasty": "宋",
      "content": "宿蕊斗攒金粉闹。\n青房暗结蜂儿小。\n敛面似啼开似笑。\n天与貌。\n人间不是铅华少。\n叶软香清无限好。\n风头日脚乾催老。\n待得玉京仙子到。\n凭向道。\n红颜只合长年少。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "2813e010d0b6cc2d8dbec071fc77d9abbca8f7778824fc5c832b6c0116ddfe9c",
      "estimatedOutput": 762,
      "resultPath": "expansion/working/v2/results/song-587--2813e010d0b6cc2d8dbec071fc77d9abbca8f7778824fc5c832b6c0116ddfe9c.json"
    },
    {
      "id": "song-588",
      "category": "宋词",
      "title": "渔家傲",
      "subtitle": "脸傅朝霞衣剪翠",
      "author": "晏殊",
      "dynasty": "宋",
      "content": "脸傅朝霞衣剪翠。\n重重占断秋江水。\n一曲采莲风细细。\n人未醉。\n鸳鸯不合惊飞起。\n欲摘嫩条嫌绿刺。\n闲敲画扇偷金蕊。\n半夜月明珠露坠。\n多少意。\n红腮点点相思泪。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "ce8ee082f4641ef6a682b7c38bf8669f6edfec56deb7a717992df0a1ebe69aec",
      "estimatedOutput": 762,
      "resultPath": "expansion/working/v2/results/song-588--ce8ee082f4641ef6a682b7c38bf8669f6edfec56deb7a717992df0a1ebe69aec.json"
    },
    {
      "id": "song-589",
      "category": "宋词",
      "title": "渔家傲",
      "subtitle": "越女采莲江北岸",
      "author": "晏殊",
      "dynasty": "宋",
      "content": "越女采莲江北岸。\n轻桡短棹随风便。\n人貌与花相斗艳。\n流水慢。\n时时照影看妆面。\n莲叶层层张绿伞。\n莲房个个垂金盏。\n一把藕丝牵不断。\n红日晚。\n回头欲去心撩乱。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "ea265847ed4e99c6932c9f8ca9bad582d79f599543a6343fff0e6bb983319f9a",
