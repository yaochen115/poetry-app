    },
    {
      "id": "song-232",
      "category": "宋词",
      "title": "少年游",
      "subtitle": "草",
      "author": "高观国",
      "dynasty": "宋",
      "content": "春风吹碧，春云映绿，晓梦入芳裀。软衬飞花，远连流水，一望隔香尘。\n萋萋多少江南恨，翻忆翠罗裙。冷落闲门，凄迷古道，烟雨正愁人。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "fb2b4afb36f5589f6e4a91df5b08dbd798e974586a3639114cded6b5291580a7",
