    },
    {
      "id": "tang-792",
      "category": "唐诗",
      "title": "送乾康禅师入山过夏",
      "subtitle": "",
      "author": "齐己",
      "dynasty": "唐",
      "content": "由来喧滑境，难驻寂寥踪。\n逼夏摇孤锡，离城入乱峰。\n云门应近寺，石路或穿松。\n知在栖禅外，题诗寄北宗。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "c5d8a9043bc9914dde5582394d0beae12c45deb9760d70a2dca38f0a5cc66821",
      "estimatedOutput": 702,
      "resultPath": "expansion/working/v2/results/tang-792--c5d8a9043bc9914dde5582394d0beae12c45deb9760d70a2dca38f0a5cc66821.json"
    },
    {
      "id": "tang-793",
      "category": "唐诗",
      "title": "三学山盘陀石上刻诗",
      "subtitle": "",
      "author": "佚名",
      "dynasty": "唐",
      "content": "拔地山峦秀，排空殿阁斜。\n云供数州雨，树献九天花。\n夜月摩峰顶，秋钟彻海涯。\n长松拂星汉，一一是仙槎。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "54ef7fe6281e10377f47034d4c1bd7843761127e97295365b869cf95dc8308db",
      "estimatedOutput": 702,
      "resultPath": "expansion/working/v2/results/tang-793--54ef7fe6281e10377f47034d4c1bd7843761127e97295365b869cf95dc8308db.json"
    },
    {
      "id": "tang-794",
      "category": "唐诗",
      "title": "雪中寄令狐相公，兼呈梦得",
      "subtitle": "",
      "author": "白居易",
      "dynasty": "唐",
      "content": "兔园春雪梁王会，想对金罍咏玉尘。\n今日相如身在此，不知客右坐何人。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "3e21036fc2b190549228c2fab27c8484ca2e62a3552173d06a9204ea7e1582af",
      "estimatedOutput": 666,
      "resultPath": "expansion/working/v2/results/tang-794--3e21036fc2b190549228c2fab27c8484ca2e62a3552173d06a9204ea7e1582af.json"
    },
    {
      "id": "tang-795",
      "category": "唐诗",
      "title": "家园卧疾毕太祝曜见寻①",
      "subtitle": "",
      "author": "孟浩然",
      "dynasty": "唐",
      "content": "伏枕旧游旷，笙歌劳梦思。\n平生重交结，迨此令人疑。\n冰室无暖气，炎云空赫曦。\n隙驹不暂驻，日听凉禅悲。\n壮图哀未立，斑白恨吾衰。\n夫子自南楚，缅怀嵩汝期。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "1b55d20c7a89d4951bde08e890d949a6e0438346f2c3493f1644cd9c705b4f61",
      "estimatedOutput": 754,
      "resultPath": "expansion/working/v2/results/tang-795--1b55d20c7a89d4951bde08e890d949a6e0438346f2c3493f1644cd9c705b4f61.json"
    },
    {
      "id": "tang-796",
      "category": "唐诗",
      "title": "斋居偶作",
      "subtitle": "",
      "author": "白居易",
      "dynasty": "唐",
      "content": "童子装炉火，行添一炷香。\n老翁持麈尾，坐拂半张床。\n卷缦看天色，移斋近日阳。\n甘鲜新饼果，稳暖旧衣裳。\n止足安生理，悠闲乐性场。\n是非一以遣，动静百无妨。\n岂有物相累，兼无情可忘。\n不须忧老病，心是自医王。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "f97923fae89a9587a625c5441b80901d3f62b670ba92621ee2e9a2841190f7d8",
