      "resultPath": "expansion/working/v2/results/song-149--32c19a3a4c78e274ce2e2716d469a7568e29c020a133fdeed63948ebd8fa986c.json"
    },
    {
      "id": "song-150",
      "category": "宋词",
      "title": "生查子",
      "subtitle": "狂花顷刻香",
      "author": "晏几道",
      "dynasty": "宋",
      "content": "狂花顷刻香，晚蝶缠绵意。\n天与短因缘，聚散常容易。\n传唱入离声，恼乱双蛾翠。\n游子不堪闻，正是衷肠事。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "7c703b5eda1a0bfe3411ddccdf5658a7f267369f10c6269ee90e10338e3d6727",
