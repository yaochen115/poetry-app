      "resultPath": "expansion/working/v2/results/song-459--857792a9555e6f24a7f11ba60af1eb9e298ce48fa8abd90eb0f6237e37ed99e0.json"
    },
    {
      "id": "song-460",
      "category": "宋词",
      "title": "少年游",
      "subtitle": "世间尤物意中人",
      "author": "柳永",
      "dynasty": "宋",
      "content": "世间尤物意中人。\n轻细好腰身。\n香帏睡起，发妆酒酽，红脸杏花春。\n娇多爱把齐纨扇，和笑掩朱唇。\n心性温柔，品流详雅，不称在风尘。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "457f89ffcb995b8088364c6fd5d9a5dbed11bfeaf0f75c38be6558c1fbc066ae",
      "estimatedOutput": 728,
      "resultPath": "expansion/working/v2/results/song-460--457f89ffcb995b8088364c6fd5d9a5dbed11bfeaf0f75c38be6558c1fbc066ae.json"
    },
    {
      "id": "song-461",
      "category": "宋词",
      "title": "少年游",
      "subtitle": "淡黄衫子郁金裙",
      "author": "柳永",
      "dynasty": "宋",
      "content": "淡黄衫子郁金裙。\n长忆个人人。\n文谈闲雅，歌喉清丽，举措好精神。\n当初为倚深深宠，无个事、爱娇瞋。\n想得别来，旧家模样，只是翠蛾颦。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "9501762abe549371f9bc4926dc05c9b486227e3735d472fedf70a8f0ecbed392",
      "estimatedOutput": 732,
      "resultPath": "expansion/working/v2/results/song-461--9501762abe549371f9bc4926dc05c9b486227e3735d472fedf70a8f0ecbed392.json"
    },
    {
      "id": "song-462",
      "category": "宋词",
      "title": "少年游",
      "subtitle": "铃斋无讼宴游频",
      "author": "柳永",
      "dynasty": "宋",
      "content": "铃斋无讼宴游频。\n罗绮簇簪绅。\n施朱傅粉，丰肌清骨，容态尽天真。\n舞裀歌扇花光里，翻回雪、驻行云。\n绮席阑珊，凤灯明灭，谁是意中人。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "7b2052df10b264dc3aa11c238965f2a3d4f63e5205c837e807c3e19e165881ae",
      "estimatedOutput": 732,
      "resultPath": "expansion/working/v2/results/song-462--7b2052df10b264dc3aa11c238965f2a3d4f63e5205c837e807c3e19e165881ae.json"
    },
    {
      "id": "song-463",
      "category": "宋词",
      "title": "少年游",
      "subtitle": "帘垂深院冷萧萧",
      "author": "柳永",
      "dynasty": "宋",
      "content": "帘垂深院冷萧萧。\n花外漏声遥。\n青灯未灭，红窗闲卧，魂梦去迢迢。\n薄情漫有归消息，鸳鸯被、半香消。\n试问伊家，阿谁心绪，禁得恁无憀。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "bca8b442e8c5390df0877f71451deacc531729341a308fa88964ee45a6ae473c",
      "estimatedOutput": 732,
      "resultPath": "expansion/working/v2/results/song-463--bca8b442e8c5390df0877f71451deacc531729341a308fa88964ee45a6ae473c.json"
    },
    {
      "id": "song-464",
      "category": "宋词",
      "title": "少年游",
      "subtitle": "一生赢得是凄凉",
      "author": "柳永",
      "dynasty": "宋",
      "content": "一生赢得是凄凉。\n追前事、暗心伤。\n好天良夜，深屏香被，争忍便相忘。\n王孙动是经年去，贪迷恋、有何长。\n万种千般，把伊情分，颠倒尽猜量。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "2786f272ec65fc0f0357a253d2db6a4c7a000268b71bdb9dbfdff2f0e3c906a0",
      "estimatedOutput": 736,
      "resultPath": "expansion/working/v2/results/song-464--2786f272ec65fc0f0357a253d2db6a4c7a000268b71bdb9dbfdff2f0e3c906a0.json"
    },
    {
      "id": "song-465",
      "category": "宋词",
      "title": "少年游",
      "subtitle": "日高花榭懒梳头",
      "author": "柳永",
      "dynasty": "宋",
      "content": "日高花榭懒梳头。\n无语倚妆楼。\n修眉敛黛，遥山横翠，相对结春愁。\n王孙走马长楸陌，贪迷恋、少年游。\n似恁疏狂，费人拘管，争似不风流。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "2a5d48ad155db40eb7b3f5089598a7c83dbdd118f5964f6a31e57f281cafff51",
      "estimatedOutput": 732,
      "resultPath": "expansion/working/v2/results/song-465--2a5d48ad155db40eb7b3f5089598a7c83dbdd118f5964f6a31e57f281cafff51.json"
    },
    {
      "id": "song-466",
      "category": "宋词",
      "title": "少年游",
      "subtitle": "佳人巧笑值千金",
      "author": "柳永",
      "dynasty": "宋",
      "content": "佳人巧笑值千金。\n当日偶情深。\n几回饮散，灯残香暖，好事尽鸳衾。\n如今万水千山阻，魂杳杳、信沈沈。\n孤棹烟波，小楼风月，两处一般心。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "f2783ee72d26b9fa4ac1f29821548631b45bdc7a2ee1dba2fb67ed20fa2ce36f",
      "estimatedOutput": 732,
      "resultPath": "expansion/working/v2/results/song-466--f2783ee72d26b9fa4ac1f29821548631b45bdc7a2ee1dba2fb67ed20fa2ce36f.json"
    },
    {
      "id": "song-467",
      "category": "宋词",
      "title": "长相思",
      "subtitle": "画鼓喧街兰灯满",
      "author": "柳永",
      "dynasty": "宋",
      "content": "画鼓喧街，兰灯满市，皎月初照严城。\n清都绛阙夜景，风传银箭，露叆金茎。\n巷陌纵横。\n过平康款辔，缓听歌声。\n凤烛荧荧。\n那人家、未掩香屏。\n向罗绮丛中，认得依稀旧日，雅态轻盈。\n娇波艳冶，巧笑依然，有意相迎。\n墙头马上，漫迟留、难写深诚。\n又岂知、名宦拘检，年来减尽风情。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "e3d063541cb47f430fbf0128ef4061a302329b841eb9ceeeab7bca8632f38919",
      "estimatedOutput": 872,
      "resultPath": "expansion/working/v2/results/song-467--e3d063541cb47f430fbf0128ef4061a302329b841eb9ceeeab7bca8632f38919.json"
    },
    {
      "id": "song-468",
      "category": "宋词",
      "title": "诉衷情",
      "subtitle": "一声画角日西曛",
      "author": "柳永",
      "dynasty": "宋",
      "content": "一声画角日西曛。\n催促掩朱门。\n不堪更倚危阑，肠断已消魂。\n年渐晚，雁空频。\n问无因。\n思心欲碎，愁泪难收，又是黄昏。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "b0dea22d53ab544b2a387548bc768a1916a35a22542757f32a78f4b80a87f74f",
      "estimatedOutput": 718,
      "resultPath": "expansion/working/v2/results/song-468--b0dea22d53ab544b2a387548bc768a1916a35a22542757f32a78f4b80a87f74f.json"
    },
    {
      "id": "song-469",
      "category": "宋词",
      "title": "洞仙歌",
      "subtitle": "佳景留心惯况少",
      "author": "柳永",
      "dynasty": "宋",
      "content": "佳景留心惯。\n况少年彼此，风情非浅。\n有笙歌巷陌，绮罗庭院。\n倾城巧笑如花面。\n恣雅态、明眸回美盼。\n同心绾。\n算国艳仙材，翻恨相逢晚。\n缱绻。\n洞房悄悄，绣被重重，夜永欢馀，共有海约山盟，记得翠云偷翦。\n和鸣彩凤于飞燕。\n间柳径花阴携手遍。\n情眷恋。\n向其间、密约轻怜事何限。\n忍聚散。\n况已结深深愿。\n愿人间天上，暮云朝雨长相见。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "644f96b8eb61616747841638f23ccb98c2046fafb2612482c73e11dcd37ea3f4",
      "estimatedOutput": 934,
      "resultPath": "expansion/working/v2/results/song-469--644f96b8eb61616747841638f23ccb98c2046fafb2612482c73e11dcd37ea3f4.json"
    }
