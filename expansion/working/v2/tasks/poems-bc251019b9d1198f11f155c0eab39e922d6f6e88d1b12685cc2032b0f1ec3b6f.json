    },
    {
      "id": "song-951",
      "category": "宋词",
      "title": "清平乐",
      "subtitle": "春云绿处又见归",
      "author": "晏几道",
      "dynasty": "宋",
      "content": "春云绿处。\n又见归鸿去。\n侧帽风前花满路。\n冶叶倡条情绪。\n红楼桂酒新开。\n曾携翠袖同来。\n醉弄影娥池水，短箫吹落残梅。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "0c5a74f44a7abe34866db43c25e8ddab92e6af36bd5c5f7cb00d61431d5ef301",
      "estimatedOutput": 720,
      "resultPath": "expansion/working/v2/results/song-951--0c5a74f44a7abe34866db43c25e8ddab92e6af36bd5c5f7cb00d61431d5ef301.json"
    },
    {
      "id": "song-952",
      "category": "宋词",
      "title": "清平乐",
      "subtitle": "西池烟草恨不寻",
      "author": "晏几道",
      "dynasty": "宋",
      "content": "西池烟草。\n恨不寻芳早。\n满路落花红不扫。\n春色渐随人老。\n远山眉黛娇长。\n清歌细逐霞觞。\n正在十洲残梦，水心宫殿斜阳。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "24d6a2a9642d84bae017395bc690cfe11cdd9997fd280058741f204231c83731",
      "estimatedOutput": 720,
      "resultPath": "expansion/working/v2/results/song-952--24d6a2a9642d84bae017395bc690cfe11cdd9997fd280058741f204231c83731.json"
    },
    {
      "id": "song-953",
      "category": "宋词",
      "title": "清平乐",
      "subtitle": "蕙心堪怨也逐春",
      "author": "晏几道",
      "dynasty": "宋",
      "content": "蕙心堪怨。\n也逐春风转。\n丹杏墙东当日见。\n幽会绿窗题遍。\n眼中前事分明。\n可怜如梦难凭。\n都把旧时薄幸，只消今日无情。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "95b55bcb06b65995164ad0d7e60cfff20501e816d6aed4e804b868c95f4a37f3",
      "estimatedOutput": 720,
      "resultPath": "expansion/working/v2/results/song-953--95b55bcb06b65995164ad0d7e60cfff20501e816d6aed4e804b868c95f4a37f3.json"
    },
    {
      "id": "song-954",
      "category": "宋词",
      "title": "清平乐",
      "subtitle": "幺弦写意意密弦",
      "author": "晏几道",
      "dynasty": "宋",
      "content": "幺弦写意。\n意密弦声碎。\n书得凤笺无限事。\n犹恨春心难寄。\n卧听疏雨梧桐。\n雨馀淡月朦胧。\n一夜梦魂何处，那回杨叶楼中。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "0d26304f20d8121e288a6644d68b56ae9a15334138052070f548b907037bc795",
      "estimatedOutput": 720,
      "resultPath": "expansion/working/v2/results/song-954--0d26304f20d8121e288a6644d68b56ae9a15334138052070f548b907037bc795.json"
    },
    {
      "id": "song-955",
      "category": "宋词",
      "title": "清平乐",
      "subtitle": "笙歌宛转台上吴",
      "author": "晏几道",
      "dynasty": "宋",
      "content": "笙歌宛转。\n台上吴王宴。\n宫女如花倚春殿。\n舞绽缕金衣线。\n酒阑画烛低迷。\n彩鸳惊起双栖。\n月底三千绣户，云间十二琼梯。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "d3707e05153fd81fa9f23d18b46c7a74ab420d984c6cec91fc7921e577071c35",
      "estimatedOutput": 720,
      "resultPath": "expansion/working/v2/results/song-955--d3707e05153fd81fa9f23d18b46c7a74ab420d984c6cec91fc7921e577071c35.json"
    },
    {
      "id": "song-956",
      "category": "宋词",
      "title": "清平乐",
      "subtitle": "暂来还去轻似风",
      "author": "晏几道",
      "dynasty": "宋",
      "content": "暂来还去。\n轻似风头絮。\n纵得相逢留不住。\n何况相逢无处。\n去时约略黄昏。\n月华却到朱门。\n别后几番明月，素娥应是消魂。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "c3f8328e6d13fd1dc80a459bbf0e69e35c029fbae03d9a800991d5281d87a3b6",
      "estimatedOutput": 720,
      "resultPath": "expansion/working/v2/results/song-956--c3f8328e6d13fd1dc80a459bbf0e69e35c029fbae03d9a800991d5281d87a3b6.json"
    },
    {
      "id": "song-957",
      "category": "宋词",
      "title": "清平乐",
      "subtitle": "双纹彩袖笑捧金",
      "author": "晏几道",
      "dynasty": "宋",
      "content": "双纹彩袖。\n笑捧金船酒。\n娇妙如花轻似柳。\n劝客千春长寿。\n艳歌更倚疏弦。\n有情须醉尊前。\n恰是可怜时候，玉娇今夜初圆。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "269aa12cba34e0b37b7a4036282104a0c82ba92af97b533f81f98c70a6452084",
      "estimatedOutput": 720,
      "resultPath": "expansion/working/v2/results/song-957--269aa12cba34e0b37b7a4036282104a0c82ba92af97b533f81f98c70a6452084.json"
    },
    {
      "id": "song-958",
      "category": "宋词",
      "title": "清平乐",
      "subtitle": "寒催酒醒晓陌飞",
      "author": "晏几道",
      "dynasty": "宋",
      "content": "寒催酒醒。\n晓陌飞霜定。\n背照画帘残烛影。\n斜月光中人静。\n锦衣才子西征。\n万重云水初程。\n翠黛倚门相送，鸾肠断处离声。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "582ba863ae1193cf54fde6a12567bcfe5277d24bf10846848d9ec9dbf3ffef5d",
      "estimatedOutput": 720,
      "resultPath": "expansion/working/v2/results/song-958--582ba863ae1193cf54fde6a12567bcfe5277d24bf10846848d9ec9dbf3ffef5d.json"
    },
    {
      "id": "song-959",
      "category": "宋词",
      "title": "清平乐",
      "subtitle": "莲开欲遍一夜秋",
      "author": "晏几道",
      "dynasty": "宋",
      "content": "莲开欲遍。\n一夜秋声转。\n残绿断红香片片。\n长是西风堪怨。\n莫愁家住溪边。\n采莲心事年年。\n谁管水流花谢，月明昨夜兰船。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "2cda7ad7fe9836df0e379d5170720aee8338071281b99cd869d55e2c00a8c99a",
      "estimatedOutput": 720,
      "resultPath": "expansion/working/v2/results/song-959--2cda7ad7fe9836df0e379d5170720aee8338071281b99cd869d55e2c00a8c99a.json"
    },
    {
      "id": "song-960",
      "category": "宋词",
      "title": "清平乐",
      "subtitle": "沈思暗记几许无",
      "author": "晏几道",
      "dynasty": "宋",
      "content": "沈思暗记。\n几许无凭事。\n菊靥开残秋少味。\n闲却画阑风意。\n梦云归处难寻。\n微凉暗入香襟。\n犹恨那回庭院，依前月浅灯深。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "7aa3429d58757def15561a93b6cff5a3475cb5cdb27d97e2e0528db5afca5a89",
      "estimatedOutput": 720,
      "resultPath": "expansion/working/v2/results/song-960--7aa3429d58757def15561a93b6cff5a3475cb5cdb27d97e2e0528db5afca5a89.json"
    },
    {
      "id": "song-961",
      "category": "宋词",
      "title": "清平乐",
      "subtitle": "莺来燕去宋玉墙",
      "author": "晏几道",
      "dynasty": "宋",
      "content": "莺来燕去。\n宋玉墙东路。\n草草幽欢能几度。\n便有系人心处。\n碧天秋月无端。\n别来长照关山。\n一点恹恹谁会，依前凭暖阑干。",
      "excerptOf": null,
      "excerptNote": "",
