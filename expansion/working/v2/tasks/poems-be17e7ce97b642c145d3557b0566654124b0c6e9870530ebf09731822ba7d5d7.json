    {
      "id": "tang-977",
      "category": "唐诗",
      "title": "正日临朝",
      "subtitle": "",
      "author": "李世民",
      "dynasty": "唐",
      "content": "条风开献节，灰律动初阳。\n百蛮奉遐賮，万国朝未央。\n虽无舜禹迹，幸欣天地康。\n车轨同八表，书文混四方。\n赫奕俨冠盖，纷纶盛服章。\n羽旄飞驰道，钟鼓震岩廊。\n组练辉霞色，霜戟耀朝光。\n晨宵怀至理，终媿抚遐荒。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "95e817d4c262bc31cc9893663d5473bf71669fd4739d0fa72b0d640466a674ac",
      "estimatedOutput": 806,
      "resultPath": "expansion/working/v2/results/tang-977--95e817d4c262bc31cc9893663d5473bf71669fd4739d0fa72b0d640466a674ac.json"
    },
    {
      "id": "tang-978",
      "category": "唐诗",
      "title": "幸武功庆善宫",
      "subtitle": "",
      "author": "李世民",
      "dynasty": "唐",
      "content": "寿丘惟旧迹，酆邑乃前基。\n粤予承累圣，悬弧亦在兹。\n弱龄逢运改，提劒郁匡时。\n指麾八荒定，怀柔万国夷。\n梯山咸入款，驾海亦来思。\n单于陪武帐，日逐卫文㮰。\n端扆朝四岳，无为任百司。\n霜节明秋景，轻冰结水湄。\n芸黄徧原隰，禾颖积京畿。\n共乐还乡宴，欢比大风诗。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "a7755ae4d5cd66eb8ea3d079e17420091ab9aae7403924e8ac29735faa2d26e5",
      "estimatedOutput": 858,
      "resultPath": "expansion/working/v2/results/tang-978--a7755ae4d5cd66eb8ea3d079e17420091ab9aae7403924e8ac29735faa2d26e5.json"
    },
    {
      "id": "tang-979",
      "category": "唐诗",
      "title": "重幸武功",
      "subtitle": "",
      "author": "李世民",
      "dynasty": "唐",
      "content": "代马依朔吹，惊禽愁昔丛。\n况兹承眷德，怀旧感深衷。\n积善忻余庆，畅武悦成功。\n垂衣天下治，端拱车书同。\n白水巡前迹，丹陵幸旧宫。\n列筵欢故老，高宴聚新丰。\n驻跸抚田畯，回舆访牧童。\n瑞气萦丹阙，祥烟散碧空。\n孤屿含霜白，遥山带日红。\n于焉欢击筑，聊以咏南风。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "f0ab572c6b6d38474f62c57f2dd3a458c8dac40ce42b36546d67a4c08bbae42d",
      "estimatedOutput": 858,
      "resultPath": "expansion/working/v2/results/tang-979--f0ab572c6b6d38474f62c57f2dd3a458c8dac40ce42b36546d67a4c08bbae42d.json"
    },
    {
      "id": "tang-980",
      "category": "唐诗",
      "title": "经破薛举战地",
      "subtitle": "",
      "author": "李世民",
      "dynasty": "唐",
      "content": "昔年怀壮气，提戈初仗节。\n心随朗日高，志与秋霜洁。\n移锋惊电起，转战长河决。\n营碎落星沈，阵卷横云裂。\n一挥氛沴静，再举鲸鲵灭。\n于兹俯旧原，属目驻华轩。\n沈沙无故迹，减灶有残痕。\n浪霞穿水净，峰雾抱莲昏。\n世途亟流易，人事殊今昔。\n长想眺前踪，抚躬聊自适。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "5c30381893d4f569cb082fdfa1e261330c0b96c01e6d3a01ecca15010bb0d6e3",
      "estimatedOutput": 858,
      "resultPath": "expansion/working/v2/results/tang-980--5c30381893d4f569cb082fdfa1e261330c0b96c01e6d3a01ecca15010bb0d6e3.json"
    },
    {
      "id": "tang-981",
      "category": "唐诗",
      "title": "过旧宅二首 一",
      "subtitle": "",
      "author": "李世民",
      "dynasty": "唐",
      "content": "新丰停翠辇，谯邑驻鸣笳。\n园荒一径断，苔古半阶斜。\n前池消旧水，昔树发今花。\n一朝辞此地，四海遂为家。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "fb251ac3784543cdc17cf677063b8604b638b77fac8824c46998b8ca0ed2e8fe",
      "estimatedOutput": 702,
      "resultPath": "expansion/working/v2/results/tang-981--fb251ac3784543cdc17cf677063b8604b638b77fac8824c46998b8ca0ed2e8fe.json"
    },
    {
      "id": "tang-982",
      "category": "唐诗",
      "title": "过旧宅二首 二",
      "subtitle": "",
      "author": "李世民",
      "dynasty": "唐",
      "content": "金舆巡白水，玉辇驻新丰。\n纽落藤披架，花残菊破丛。\n叶铺荒草蔓，流竭半池空。\n纫珮兰凋径，舒圭叶翦桐。\n昔地一蕃内，今宅九围中。\n架海波澄镜，韬戈器反农。\n八表文同轨，无劳歌大风。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "4ffef34c0079f0694f881faad546462fa988ec953609f5b5c623889d2d49b697",
      "estimatedOutput": 780,
      "resultPath": "expansion/working/v2/results/tang-982--4ffef34c0079f0694f881faad546462fa988ec953609f5b5c623889d2d49b697.json"
    },
    {
      "id": "tang-983",
      "category": "唐诗",
      "title": "还陕述怀",
      "subtitle": "",
      "author": "李世民",
      "dynasty": "唐",
      "content": "慨然抚长劒，济世岂邀名。\n星旗纷电举，日羽肃天行。\n徧野屯万骑，临原驻五营。\n登山麾武节，背水纵神兵。\n在昔戎戈动，今来宇宙平。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "0ccf6c43746628f37292bc72665228f822a8a2da3de9a1f0c8fcbfcd24357454",
      "estimatedOutput": 728,
      "resultPath": "expansion/working/v2/results/tang-983--0ccf6c43746628f37292bc72665228f822a8a2da3de9a1f0c8fcbfcd24357454.json"
    },
    {
      "id": "tang-984",
      "category": "唐诗",
      "title": "于北平作",
      "subtitle": "",
      "author": "李世民",
      "dynasty": "唐",
      "content": "翠野驻戎轩，卢龙转征斾。\n遥山丽如绮，长流萦似带。\n海气百重楼，岩松千丈盖。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "e4371da2d0f143bc78a57f0b09ab89093c03e8f4c5610f36cd280ea0a4c0cc64",
      "estimatedOutput": 676,
      "resultPath": "expansion/working/v2/results/tang-984--e4371da2d0f143bc78a57f0b09ab89093c03e8f4c5610f36cd280ea0a4c0cc64.json"
    },
    {
      "id": "tang-985",
      "category": "唐诗",
      "title": "辽城望月",
      "subtitle": "",
      "author": "李世民",
      "dynasty": "唐",
      "content": "玄兔月初明，澄辉照辽碣。\n映云光暂隐，隔树花如缀。\n魄满桂枝圆，轮亏镜彩缺。\n临城却影散，带晕重围结。\n驻跸俯九都，停观妖氛灭。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "8c4a1e86bf042119d4780aad0e28dfc831a419ea37058d045057974b981d2c2f",
      "estimatedOutput": 728,
      "resultPath": "expansion/working/v2/results/tang-985--8c4a1e86bf042119d4780aad0e28dfc831a419ea37058d045057974b981d2c2f.json"
    },
    {
      "id": "tang-986",
      "category": "唐诗",
      "title": "春日登陕州城楼俯眺原野回丹碧缀烟霞密翠斑红芳菲花柳即目川岫聊以命篇",
      "subtitle": "",
      "author": "李世民",
      "dynasty": "唐",
      "content": "碧原开雾隰，绮岭峻霞城。\n烟峰高下翠，日浪浅深明。\n斑红粧橤树，圆青压溜荆。\n迹岩劳傅想，窥野访莘情。\n巨川何以济，舟楫伫时英。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "24f544ffb2c76ecfa8d3536e141e9dd1244b3cb2c00a13cd786ff44f257925ce",
      "estimatedOutput": 728,
      "resultPath": "expansion/working/v2/results/tang-986--24f544ffb2c76ecfa8d3536e141e9dd1244b3cb2c00a13cd786ff44f257925ce.json"
    },
    {
      "id": "tang-987",
      "category": "唐诗",
      "title": "春日玄武门宴群臣",
      "subtitle": "",
      "author": "李世民",
      "dynasty": "唐",
      "content": "韶光开令序，淑气动芳年。\n驻辇华林侧，高宴柏梁前。\n紫庭文珮满，丹墀衮绂连。\n九夷簉瑶席，五狄列琼筵。\n娱宾歌湛露，广乐奏钧天。\n清尊浮绿醑，雅曲韵朱弦。\n粤余君万国，还慙抚八埏。\n庶几保贞固，虚己厉求贤。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "e60ee89e9bf91642da0c2b3406ad7fc82b3954ea12323635c96ed05b0443e463",
      "estimatedOutput": 806,
      "resultPath": "expansion/working/v2/results/tang-987--e60ee89e9bf91642da0c2b3406ad7fc82b3954ea12323635c96ed05b0443e463.json"
    },
    {
      "id": "tang-988",
      "category": "唐诗",
      "title": "登三台言志",
      "subtitle": "",
      "author": "李世民",
      "dynasty": "唐",
      "content": "未央初壮汉，阿房昔侈秦。\n在危犹骋丽，居奢遂役人。\n岂如家四海，日宇罄朝伦。\n扇天裁户旧，砌地翦基新。\n引月擎宵桂，飘云逼曙鳞。\n露除光炫玉，霜阙映雕银。\n舞接花梁燕，歌迎鸟路尘。\n镜池波太液，庄苑丽宜春。\n作异甘泉日，停非路寝辰。\n念劳慙逸己，居旷返劳神。\n所欣成大厦，宏材伫渭滨。",
      "excerptOf": null,
      "excerptNote": "",
      "inputHash": "d698abe3c7f1f9460929612ce79d40c5b30fca479d15db6cbafed2e4dd6c8ffd",
