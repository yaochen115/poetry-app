{
  "id": "tang-150",
  "tags": [
    "咏物",
    "山水"
  ],
  "translation": "小船移动，水珠飞溅，满池莲叶参差错落地绿着；倚着栏杆，风吹荷茎，一茎一茎摇曳出阵阵清香。多谢浣纱的人没有把莲叶折走，雨中还能留着它为成双的鸳鸯遮雨。",
  "notes": [
    {
      "term": "差差",
      "meaning": "参差不齐的样子，读cī。"
    },
    {
      "term": "倚槛",
      "meaning": "靠着栏杆。"
    },
    {
      "term": "柄柄",
      "meaning": "一茎一茎，形容荷茎挺立。"
    },
    {
      "term": "浣纱",
      "meaning": "漂洗纱织品。浣，洗。"
    },
    {
      "term": "鸳鸯",
      "meaning": "水鸟名，常雌雄成对，喻爱侣。"
    }
  ]
}
