  "id": "tang-1005",
  "tags": [
    "时令"
  ],
  "translation": "山岭衔着夜月中的桂影，清晨的露珠串在草丛间。寒蝉啼叫，让人感到树木已冷；萤火虽亮，却暖不了秋风。圆菊的花蕊绽开，荷叶凋尽，游鱼往来无阻。清晨的水边飞雁鸣叫，傍晚的洲渚上栖鸿聚集。高天上风声飒飒，天空澄明，日头炽烈地照着下方。",
  "notes": [
    {
      "term": "衔",
      "meaning": "含。写山岭托着月亮。"
    },
    {
      "term": "宵月",
      "meaning": "夜月。"
    },
    {
      "term": "橤",
      "meaning": "同“蕊”，花蕊。读ruǐ。"
    },
    {
      "term": "晨浦",
      "meaning": "清晨的水边。浦，水滨。"
    },
    {
      "term": "夕渚",
      "meaning": "傍晚的水中小洲。"
    },
    {
      "term": "氛",
      "meaning": "云气。读fēn。"
    },
    {
      "term": "炽",
      "meaning": "炽热。读chì。"
    }
  ]
}
