{
  "id": "tang-260",
  "tags": [
    "思乡",
    "咏怀"
  ],
  "translation": "白露凝结成霜，凋伤了枫树林；巫山巫峡间云气萧瑟阴森。江上的波浪连天涌起，边塞的风云接地阴沉。一丛丛菊花已两度开放，令人想起往日而流泪；孤零零的小船系在岸边，牵系着思乡的心。处处都在赶制寒衣，剪刀尺子声声催促，高高的白帝城上，傍晚捣衣的砧声一阵紧似一阵。",
  "notes": [
    {
      "term": "玉露",
      "meaning": "白露，也指秋露。"
    },
    {
      "term": "凋伤",
      "meaning": "使树木凋零受伤。"
    },
    {
      "term": "萧森",
      "meaning": "萧瑟阴森。"
    },
    {
      "term": "兼天",
      "meaning": "连天。"
    },
    {
      "term": "他日泪",
      "meaning": "因回忆往日而流的泪。"
    },
    {
      "term": "故园心",
      "meaning": "思念故园的心。"
    },
    {
      "term": "刀尺",
      "meaning": "剪刀和尺子，制寒衣的工具。"
    },
    {
      "term": "暮砧",
      "meaning": "傍晚捣衣的砧声。砧，读zhēn，捣衣石。"
    }
  ]
}
