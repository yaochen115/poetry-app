      "term": "天宇",
      "meaning": "天空。"
    },
    {
      "term": "中流",
      "meaning": "水流之中。"
    },
    {
      "term": "露华",
      "meaning": "露水。"
    },
    {
      "term": "汀洲",
      "meaning": "水边平地。"
    },
    {
      "term": "宵分",
      "meaning": "夜半。"
    }
  ]
