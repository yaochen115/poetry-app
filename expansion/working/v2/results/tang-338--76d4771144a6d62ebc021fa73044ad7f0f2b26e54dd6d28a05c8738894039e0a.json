{
  "id": "tang-338",
  "tags": [
    "思乡",
    "咏怀"
  ],
  "translation": "海边的尖峭山峰像剑锋一样，秋天到来，处处像在割断我的愁肠。怎样才能把自身化成千亿个，分散到各个峰顶，一起遥望故乡呢？",
  "notes": [
    {
      "term": "海畔",
      "meaning": "海边，诗中指诗人贬居的柳州一带。"
    },
    {
      "term": "剑铓",
      "meaning": "剑的锋芒。铓，刀剑的尖端。"
    },
    {
      "term": "愁肠",
      "meaning": "愁苦的心肠。"
    },
    {
      "term": "若为",
      "meaning": "怎能，如何能够。"
    },
    {
      "term": "千亿",
      "meaning": "极言其多，用佛家化身千亿的说法。"
    }
  ]
}
