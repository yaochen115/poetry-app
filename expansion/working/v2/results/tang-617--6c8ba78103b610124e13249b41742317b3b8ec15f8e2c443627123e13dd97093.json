{
  "id": "tang-617",
  "tags": [
    "山水"
  ],
  "translation": "山上开着一层又一层的桃花李花，云间升起炊烟的地方是山里人家。妇女们戴着银钏金钗来背水，男人们挎着长刀、戴着短笠去烧荒种田。",
  "notes": [
    {
      "term": "银钏",
      "meaning": "银制的手镯。"
    },
    {
      "term": "负水",
      "meaning": "背水，打水。"
    },
    {
      "term": "短笠",
      "meaning": "短檐斗笠。"
    },
    {
      "term": "烧畲",
      "meaning": "焚烧田地草木作肥料后播种，是山地耕作方式。畲，读shē。"
    }
  ]
}
