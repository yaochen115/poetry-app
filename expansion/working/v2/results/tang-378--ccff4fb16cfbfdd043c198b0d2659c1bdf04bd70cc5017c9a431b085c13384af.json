  "id": "tang-378",
  "tags": [
    "哲理",
    "山水"
  ],
  "translation": "绕着池塘悠闲散步，观看鱼儿游动；正逢孩子们摆弄钓鱼的小船。同样是喜爱鱼，心意却各不相同：我来投喂食物，你却在垂钓钩。",
  "notes": [
    {
      "term": "闲步",
      "meaning": "悠闲地散步。"
    },
    {
      "term": "钓舟",
      "meaning": "钓鱼的小船。"
    },
    {
      "term": "施食",
      "meaning": "投放食物。"
    }
  ]
}
