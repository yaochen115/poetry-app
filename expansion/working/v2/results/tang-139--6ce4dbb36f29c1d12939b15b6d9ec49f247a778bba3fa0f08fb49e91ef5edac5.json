  ],
  "translation": "冷落荒凉的行宫依旧还在，宫里的花朵寂寞地开着，红艳依旧。当年入宫的宫女已经满头白发，闲坐无事，说着玄宗皇帝当年的旧事。",
  "notes": [
    {
      "term": "寥落",
      "meaning": "冷落荒凉。"
    },
    {
      "term": "行宫",
      "meaning": "皇帝出行时居住的离宫。"
    },
    {
      "term": "寂寞红",
      "meaning": "花开红艳却无人观赏，显得寂寞。"
    },
    {
      "term": "玄宗",
      "meaning": "唐玄宗李隆基。"
    }
  ]
}
