{
  "id": "tang-373",
  "tags": [
    "羁旅",
    "咏怀"
  ],
  "translation": "我潦倒失意，漂泊江南，载酒而行；楚地的女子腰肢纤细，体态轻盈得仿佛能在掌中起舞。扬州十年，恍如一场大梦，只落得青楼中一个薄情负心的名声。",
  "notes": [
    {
      "term": "落魄",
      "meaning": "潦倒失意。"
    },
    {
      "term": "楚腰",
      "meaning": "细腰。用楚王好细腰的典故。"
    },
    {
      "term": "掌中轻",
      "meaning": "用赵飞燕体轻能在掌上起舞的典故，形容女子轻盈。"
    },
    {
      "term": "青楼",
      "meaning": "这里指歌楼妓馆。"
    },
    {
      "term": "薄幸",
      "meaning": "薄情负心。"
    }
  ]
}
