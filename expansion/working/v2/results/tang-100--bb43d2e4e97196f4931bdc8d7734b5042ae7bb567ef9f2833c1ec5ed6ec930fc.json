{
  "id": "tang-100",
  "tags": [
    "感遇"
  ],
  "translation": "锦官城里丝竹管弦整日纷纷不断，乐声一半散入江风，一半飘上云霄。这样的乐曲只应天上才有，人世间能听到几回呢？",
  "notes": [
    {
      "term": "锦城",
      "meaning": "锦官城，成都的别称。"
    },
    {
      "term": "丝管",
      "meaning": "弦乐器和管乐器，泛指音乐。"
    },
    {
      "term": "纷纷",
      "meaning": "这里形容乐声不断、繁多。"
    },
    {
      "term": "天上",
      "meaning": "这里双关，既指天空，也指皇宫。"
    },
    {
      "term": "几回闻",
      "meaning": "能听到几回。"
    }
  ]
}
