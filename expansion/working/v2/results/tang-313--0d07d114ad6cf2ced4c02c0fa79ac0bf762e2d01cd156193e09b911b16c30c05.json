{
  "id": "tang-313",
  "tags": [
    "咏怀"
  ],
  "translation": "老人七十岁了还在卖酒，千百个酒壶酒瓮摆在花门口。路旁的榆荚长得精巧，好像铜钱一样；摘来向你买酒，你肯不肯呢？",
  "notes": [
    {
      "term": "沽酒",
      "meaning": "卖酒，诗中兼有买酒之意。"
    },
    {
      "term": "瓮",
      "meaning": "盛酒的陶器。"
    },
    {
      "term": "花门",
      "meaning": "酒家所在之地。"
    },
    {
      "term": "榆荚",
      "meaning": "榆树的果实，形状似铜钱。"
    }
  ]
}
