{
  "id": "tang-308",
  "tags": [
    "思乡"
  ],
  "translation": "勉强想登高去过重阳节，却没有人来送酒。遥想怜惜故乡园中的菊花，如今应该正挨着战场开放。",
  "notes": [
    {
      "term": "登高",
      "meaning": "重阳节登高的习俗。"
    },
    {
      "term": "送酒",
      "meaning": "用陶渊明重阳无酒、友人送酒的典故。"
    },
    {
      "term": "故园",
      "meaning": "故乡家园。"
    },
    {
      "term": "傍",
      "meaning": "靠近，挨着。"
    }
  ]
}
