{
  "id": "tang-294",
  "tags": [
    "咏怀"
  ],
  "translation": "七弦琴上弹出清越的声音，静心听来，仿佛松林间吹来的阵阵寒风。古老的曲调虽然我自己喜爱，现在的人却大多不再弹奏了。",
  "notes": [
    {
      "term": "泠泠",
      "meaning": "形容琴声清越。"
    },
    {
      "term": "七弦",
      "meaning": "七弦琴，即古琴。"
    },
    {
      "term": "松风",
      "meaning": "古琴曲《风入松》，也写琴声如松间风声。"
    },
    {
      "term": "古调",
      "meaning": "古老的曲调。"
    }
  ]
}
