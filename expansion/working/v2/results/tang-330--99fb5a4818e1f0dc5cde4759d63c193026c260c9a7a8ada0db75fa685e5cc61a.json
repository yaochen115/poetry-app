{
  "id": "tang-330",
  "tags": [
    "咏物"
  ],
  "translation": "孤雁不吃也不喝，边飞边鸣，声音里满是思念雁群。谁怜惜这孤零零的一片身影，在万重云层中与同伴失散？望到天边，好像还能看见；哀鸣多了，仿佛更听得真切。野鸦不懂它的愁绪，只顾自己纷纷聒噪。",
  "notes": [
    {
      "term": "饮啄",
      "meaning": "饮水啄食。"
    },
    {
      "term": "念群",
      "meaning": "思念同伴。"
    },
    {
      "term": "一片影",
      "meaning": "指孤雁孤单的身影。"
    },
    {
      "term": "意绪",
      "meaning": "心绪，情绪。"
    },
    {
      "term": "鸣噪",
      "meaning": "嘈杂的鸣叫。"
    }
  ]
}
