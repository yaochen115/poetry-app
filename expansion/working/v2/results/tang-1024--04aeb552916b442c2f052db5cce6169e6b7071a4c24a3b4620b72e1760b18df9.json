{
  "id": "tang-1024",
  "tags": [
    "时令"
  ],
  "translation": "斜长的回廊连着绮丽的楼阁，初升的月亮照着夜里的帷帐。边塞转冷，鸿雁飞得迅疾；园中秋深，蝉鸣声已迟。露水凝结在稀疏的林叶上，轻寒中菊花吐露生机。愁苦的心逢上这样的时节，长叹一声，独自含悲。",
  "notes": [
    {
      "term": "绮阁",
      "meaning": "雕饰华美的楼阁。绮读qǐ。"
    },
    {
      "term": "宵帏",
      "meaning": "夜间的帷帐。帏读wéi。"
    },
    {
      "term": "蝉噪",
      "meaning": "蝉鸣。噪读zào。"
    },
    {
      "term": "林疎",
      "meaning": "林叶稀疏。疎同“疏”。"
    },
    {
      "term": "吐滋",
      "meaning": "吐露生机、滋润之态。"
    }
  ]
}
