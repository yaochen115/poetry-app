{
  "id": "tang-357",
  "tags": [
    "羁旅",
    "思乡"
  ],
  "translation": "远方的家书和归乡之梦，两者都渺茫无期；只有空荡荡的床，独自抵挡素净的秋光。台阶下的青苔与红树，在雨中显得冷落，在月光中惹人愁绪。",
  "notes": [
    {
      "term": "远书",
      "meaning": "远方的书信。"
    },
    {
      "term": "归梦",
      "meaning": "归乡之梦。"
    },
    {
      "term": "素秋",
      "meaning": "秋天。按五行说秋属金，色白，故称素秋。"
    },
    {
      "term": "寥落",
      "meaning": "冷落，稀疏。"
    }
  ]
}
