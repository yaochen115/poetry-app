  "id": "tang-1002",
  "tags": [
    "时令"
  ],
  "translation": "山亭里秋色满满，岩间窗户吹过凉风。稀疏的兰花还笼着烟雾，残菊依然承着露珠。古老的石头上披着新生的青苔，新筑的鸟巢封在古树上。遍览秋景，情思无尽，可惜近在咫尺，天色已经向晚，时光匆匆输给了暮色。",
  "notes": [
    {
      "term": "岩牖",
      "meaning": "岩壁间的窗。牖读yǒu。"
    },
    {
      "term": "疎兰",
      "meaning": "稀疏的兰花。疎同“疏”。"
    },
    {
      "term": "承露",
      "meaning": "承接露水。"
    },
    {
      "term": "衣新苔",
      "meaning": "披上新苔。衣，用作动词，覆盖。"
    },
    {
      "term": "咫尺",
      "meaning": "形容距离很近。咫读zhǐ。"
    },
    {
      "term": "输",
      "meaning": "输给，敌不过。"
    }
  ]
}
