{
  "id": "tang-124",
  "tags": [
    "咏物",
    "咏怀"
  ],
  "translation": "大漠的沙像雪一样白，燕山上的月亮像弯钩一样明亮。什么时候才能给马配上金饰的笼头，在清爽的秋天里纵情奔驰呢？",
  "notes": [
    {
      "term": "大漠",
      "meaning": "辽阔的沙漠。"
    },
    {
      "term": "燕山",
      "meaning": "山名，在今河北北部。"
    },
    {
      "term": "钩",
      "meaning": "弯钩，比喻弯月。"
    },
    {
      "term": "金络脑",
      "meaning": "金饰的马笼头。"
    },
    {
      "term": "何当",
      "meaning": "何时才能够。"
    }
  ]
}
