{
  "id": "tang-103",
  "tags": [
    "思乡",
    "羁旅"
  ],
  "translation": "江水碧绿，衬得鸟儿的羽毛更加洁白；山色青翠，山花红艳得像要燃烧起来。眼看今年春天又将过去，哪一天才是我回乡的日子呢？",
  "notes": [
    {
      "term": "逾",
      "meaning": "同“愈”，更加。"
    },
    {
      "term": "欲燃",
      "meaning": "形容山花红艳，像要燃烧起来。"
    },
    {
      "term": "看又过",
      "meaning": "眼看又将过去。"
    },
    {
      "term": "归年",
      "meaning": "回乡的日子。"
    }
  ]
}
