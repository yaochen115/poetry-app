  "id": "tang-451",
  "tags": [
    "咏怀"
  ],
  "translation": "洞房里昨夜红烛高照，等到天亮就到堂前拜见公婆。梳妆完毕后低声问丈夫：我画的眉毛深浅，合不合时兴的式样？",
  "notes": [
    {
      "term": "洞房",
      "meaning": "新婚夫妇的新房。"
    },
    {
      "term": "舅姑",
      "meaning": "公婆。"
    },
    {
      "term": "夫婿",
      "meaning": "丈夫。"
    },
    {
      "term": "入时",
      "meaning": "合乎时兴的式样。"
    }
  ]
}
