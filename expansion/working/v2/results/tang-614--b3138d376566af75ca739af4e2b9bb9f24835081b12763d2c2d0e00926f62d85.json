{
  "id": "tang-614",
  "tags": [
    "咏物"
  ],
  "translation": "风撩动着发钗，拨弄那盘成孔雀样的发髻；又恼人地拂动衣带上的鸳鸯。是谁教这风靠近了罗制的坐垫？斋戒时分，风又把深闺的门紧紧锁上。",
  "notes": [
    {
      "term": "撩",
      "meaning": "拨弄，挑动。"
    },
    {
      "term": "盘孔雀",
      "meaning": "发髻盘成孔雀形。"
    },
    {
      "term": "拂鸳鸯",
      "meaning": "拂动绣有鸳鸯的衣带。"
    },
    {
      "term": "罗荐",
      "meaning": "丝罗制成的垫褥。"
    },
    {
      "term": "斋时",
      "meaning": "斋戒的时辰。"
    }
  ]
}
