{
  "id": "tang-425",
  "tags": [
    "边塞"
  ],
  "translation": "北斗七星高高地挂在天上，哥舒将军夜里仍佩着战刀警戒。敌人至今只敢远远窥望放牧的地方，不敢越过临洮。",
  "notes": [
    {
      "term": "哥舒",
      "meaning": "哥舒翰，唐代将领。"
    },
    {
      "term": "带刀",
      "meaning": "佩带战刀，写守边的戒备。"
    },
    {
      "term": "窥",
      "meaning": "暗中探看、窥伺。"
    },
    {
      "term": "牧马",
      "meaning": "放牧马匹，这里联系边境牧地。"
    },
    {
      "term": "临洮",
      "meaning": "西北地名，诗中作为边地的标志。"
    }
  ]
}
