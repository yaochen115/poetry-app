{
  "id": "tang-147",
  "tags": [
    "山水",
    "时令"
  ],
  "translation": "从长安遥望终南山，山北背阴的山岭格外秀丽，积雪仿佛浮在云端。雪后初晴，林梢映着雪色，暮色里城中又增添了几分寒意。",
  "notes": [
    {
      "term": "阴岭",
      "meaning": "山北背阴的山岭。"
    },
    {
      "term": "浮云端",
      "meaning": "积雪高耸，像浮在云上。"
    },
    {
      "term": "霁色",
      "meaning": "雨雪初晴的景色。"
    },
    {
      "term": "暮寒",
      "meaning": "傍晚的寒意。"
    }
  ]
}
