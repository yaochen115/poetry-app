{
  "id": "song-084",
  "tags": [
    "闺怨",
    "感遇"
  ],
  "translation": "黄莺啄弄着红艳的花，燕尾点过水面，荡起绿波。手指发冷，玉笙也透着寒意；一曲《小梅》吹尽，春意渐浓。依旧啊，依旧，人和绿杨还是那样消瘦。",
  "notes": [
    {
      "term": "红溜",
      "meaning": "形容花色红润、鲜明。"
    },
    {
      "term": "绿皱",
      "meaning": "碧绿水面荡起的细纹。"
    },
    {
      "term": "玉笙",
      "meaning": "精美的笙，笙为管乐器。"
    },
    {
      "term": "小梅",
      "meaning": "乐曲名，通常联系《小梅花》。"
    },
    {
      "term": "彻",
      "meaning": "尽、完，吹彻指吹完一曲。"
    },
    {
      "term": "俱",
      "meaning": "都、一同。"
    }
  ]
}
