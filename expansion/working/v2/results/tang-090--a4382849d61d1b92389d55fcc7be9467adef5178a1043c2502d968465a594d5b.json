{
  "id": "tang-090",
  "tags": [
    "山水"
  ],
  "translation": "一个头发蓬乱的小孩子学着钓鱼，侧身坐在莓苔地上，青草掩映着他的身体。过路的人向他问路，他远远地摆手，怕惊动了鱼儿，不敢回应。",
  "notes": [
    {
      "term": "蓬头",
      "meaning": "头发蓬乱。"
    },
    {
      "term": "稚子",
      "meaning": "小孩子。"
    },
    {
      "term": "垂纶",
      "meaning": "垂钓。纶，钓丝。"
    },
    {
      "term": "莓苔",
      "meaning": "莓类和苔藓，指潮湿处生长的青苔。"
    },
    {
      "term": "借问",
      "meaning": "向人打听、问路。"
    },
    {
      "term": "应人",
      "meaning": "回答别人。"
    }
  ]
}
