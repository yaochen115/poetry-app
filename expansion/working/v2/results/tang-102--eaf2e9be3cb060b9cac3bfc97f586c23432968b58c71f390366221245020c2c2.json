{
  "id": "tang-102",
  "tags": [
    "咏物"
  ],
  "translation": "鹅啊，鹅啊，鹅，弯着脖子向着天空歌唱。洁白的羽毛浮在碧绿的水面上，红红的脚掌拨动着清清的水波。",
  "notes": [
    {
      "term": "曲项",
      "meaning": "弯曲的脖子。项，颈的后部，这里指鹅的颈。"
    },
    {
      "term": "向天歌",
      "meaning": "向着天空鸣叫。"
    },
    {
      "term": "拨",
      "meaning": "拨动，划动。"
    },
    {
      "term": "清波",
      "meaning": "清澈的水波。"
    }
  ]
}
