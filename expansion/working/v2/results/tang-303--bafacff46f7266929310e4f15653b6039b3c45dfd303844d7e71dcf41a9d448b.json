{
  "id": "tang-303",
  "tags": [
    "咏怀"
  ],
  "translation": "山上开满了红艳艳的桃花，蜀江的春水拍打着山崖流过。红花容易凋谢，就像情郎的心意；水流无穷无尽，就像我的忧愁。",
  "notes": [
    {
      "term": "上头",
      "meaning": "山上。"
    },
    {
      "term": "蜀江",
      "meaning": "蜀地的江水。"
    },
    {
      "term": "郎",
      "meaning": "女子对情人的称呼。"
    },
    {
      "term": "侬",
      "meaning": "我，古代吴地方言，诗中女子自称。"
    }
  ]
}
