{
  "id": "tang-092",
  "tags": [
    "羁旅"
  ],
  "translation": "天色已晚，青苍的山岭显得遥远；天气寒冷，简陋的茅屋更显清贫。柴门边传来狗叫声，风雪之夜，有人归来了。",
  "notes": [
    {
      "term": "苍山",
      "meaning": "青苍的山。"
    },
    {
      "term": "白屋",
      "meaning": "茅草覆顶的简陋房屋，指贫寒之家。"
    },
    {
      "term": "柴门",
      "meaning": "用柴木做的门，指简朴的家门。"
    },
    {
      "term": "犬吠",
      "meaning": "狗叫。吠读fèi。"
    },
    {
      "term": "夜归人",
      "meaning": "夜里归来的人。"
    }
  ]
}
