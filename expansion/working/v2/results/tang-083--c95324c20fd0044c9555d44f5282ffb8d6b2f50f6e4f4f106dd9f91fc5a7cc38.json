{
  "id": "tang-083",
  "tags": [
    "山水",
    "时令"
  ],
  "translation": "黄师塔前，江水向东流去；春光使人慵懒困倦，我倚着和暖的微风赏花。一丛无人照管的桃花开得正盛，到底是深红的惹人喜爱，还是浅红的惹人喜爱呢？",
  "notes": [
    {
      "term": "黄师塔",
      "meaning": "黄姓僧人安葬之塔。师，对僧人的称呼。"
    },
    {
      "term": "懒困",
      "meaning": "慵懒困倦。"
    },
    {
      "term": "倚微风",
      "meaning": "倚着微风，写春光和煦宜人。"
    },
    {
      "term": "一簇",
      "meaning": "一丛，一团。"
    },
    {
      "term": "无主",
      "meaning": "没有主人，任人观赏。"
    }
  ]
}
