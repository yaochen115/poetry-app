{
  "id": "tang-318",
  "tags": [
    "山水"
  ],
  "translation": "早晨放牛，把牛赶到江湾去；夜里放牛，把牛赶过村庄和山谷。披着蓑衣走出树林，春雨细细；躺在绿绿的莎草上，吹着芦管。腰间乱插着蓬蒿做的箭，不怕猛虎欺负小黄牛。",
  "notes": [
    {
      "term": "江曲",
      "meaning": "江湾。"
    },
    {
      "term": "荷蓑",
      "meaning": "披着蓑衣。"
    },
    {
      "term": "芦管",
      "meaning": "芦苇做的管乐器。"
    },
    {
      "term": "莎草",
      "meaning": "草名，多年生草本植物。"
    },
    {
      "term": "蓬蒿",
      "meaning": "野草名，牧童折来当箭玩耍。"
    },
    {
      "term": "黄犊",
      "meaning": "小黄牛。"
    }
  ]
}
