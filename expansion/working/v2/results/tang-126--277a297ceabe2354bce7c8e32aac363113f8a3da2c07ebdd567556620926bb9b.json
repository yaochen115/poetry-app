{
  "id": "tang-126",
  "tags": [
    "时令"
  ],
  "translation": "清明节的夜晚，清风和煦，月色朦胧；碧绿的台阶、朱红的轩窗，正是刺史的宅第。我独自绕着曲折的回廊走走停停，远远地听着弦管乐声，在夜色里静静赏花。",
  "notes": [
    {
      "term": "胧月",
      "meaning": "朦胧的月色。"
    },
    {
      "term": "碧砌",
      "meaning": "碧绿的台阶。"
    },
    {
      "term": "红轩",
      "meaning": "朱红色的轩窗。"
    },
    {
      "term": "回廊",
      "meaning": "曲折环绕的走廊。"
    },
    {
      "term": "弦管",
      "meaning": "弦乐与管乐，泛指音乐。"
    }
  ]
}
