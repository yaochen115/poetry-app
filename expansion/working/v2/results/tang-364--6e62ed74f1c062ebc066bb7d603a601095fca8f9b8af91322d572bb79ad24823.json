{
  "id": "tang-364",
  "tags": [
    "咏怀"
  ],
  "translation": "古筝弦柱装饰着金粟，弹筝女子洁白的手在玉房前拨弦。她为了引起周郎的注意，常常故意拨错弦。",
  "notes": [
    {
      "term": "金粟柱",
      "meaning": "装饰着金色粟粒状花纹的弦柱。"
    },
    {
      "term": "素手",
      "meaning": "洁白的手。"
    },
    {
      "term": "玉房",
      "meaning": "诗中指弹筝女子的华美闺房。"
    },
    {
      "term": "周郎",
      "meaning": "三国周瑜，精通音乐，听到弹错必回头看，诗中借指所爱慕的人。"
    },
    {
      "term": "拂弦",
      "meaning": "拨动琴弦。"
    }
  ]
}
