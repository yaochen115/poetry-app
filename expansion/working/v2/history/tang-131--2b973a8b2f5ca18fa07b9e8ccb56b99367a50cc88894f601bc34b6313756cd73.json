{
  "id": "tang-131",
  "tags": [
    "山水",
    "时令"
  ],
  "translation": "雨中传来几声鸡鸣，村中只有一两户人家；竹林夹着溪水，村中小路架着倾斜的木板桥。婆媳互相招呼着去浸洗蚕种，只有院中盛开的栀子花闲闲地开着，无人去理会。",
  "notes": [
    {
      "term": "鸡鸣",
      "meaning": "鸡啼声，写山村清晨。"
    },
    {
      "term": "板桥",
      "meaning": "木板搭成的小桥。"
    },
    {
      "term": "妇姑",
      "meaning": "婆婆与媳妇。"
    },
    {
      "term": "浴蚕",
      "meaning": "古代育蚕选种时用盐水浸洗蚕种的方法。"
    },
    {
      "term": "栀子花",
      "meaning": "常绿灌木，初夏开白花，香气浓郁。"
    }
  ]
}
