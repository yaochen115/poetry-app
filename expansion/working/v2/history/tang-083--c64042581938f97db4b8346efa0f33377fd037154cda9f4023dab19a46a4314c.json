{
  "id": "tang-083",
  "tags": [
    "山水",
    "时令"
  ],
  "translation": "黄师塔前的江水向东流去，和煦的春光让人懒散困倦，倚着微风小憩。一簇桃花无主自开，究竟是深红的可爱，还是浅红的可爱呢？",
  "notes": [
    {
      "term": "黄师塔",
      "meaning": "黄姓僧人安葬之塔。师，对僧人的称呼。"
    },
    {
      "term": "懒困",
      "meaning": "慵懒困倦。"
    },
    {
      "term": "倚微风",
      "meaning": "倚着微风，写春光和煦宜人。"
    },
    {
      "term": "一簇",
      "meaning": "一丛，一团。"
    },
    {
      "term": "无主",
      "meaning": "没有主人，任人观赏。"
    }
  ]
}
