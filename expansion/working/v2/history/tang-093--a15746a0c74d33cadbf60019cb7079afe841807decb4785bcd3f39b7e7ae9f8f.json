{
  "id": "tang-093",
  "tags": [
    "思乡",
    "羁旅"
  ],
  "translation": "旅馆里寒灯孤照，我独自无法入眠，客居的心情因何变得更加凄然？今夜故乡的人一定在思念千里之外的我，而明天我两鬓斑白，又添了一年。",
  "notes": [
    {
      "term": "寒灯",
      "meaning": "寒夜中孤冷的灯。"
    },
    {
      "term": "客心",
      "meaning": "客居他乡的心情。"
    },
    {
      "term": "凄然",
      "meaning": "悲伤凄凉的样子。"
    },
    {
      "term": "霜鬓",
      "meaning": "如霜的鬓发，写年华老去。"
    },
    {
      "term": "明朝",
      "meaning": "明天，这里指大年初一。"
    }
  ]
}
