{
  "version": "1.0.0",
  "dictionaryVersion": "1.1.15",
  "newCharacters": {
    "井": {
      "pinyin": [
        "jing3",
        "jing4"
      ],
      "meanings": [
        "为取地下水而凿的深洞；井宿。"
      ],
      "ancient": [
        "贾傅井联系贾谊旧宅的水井；露井指没有覆盖物的井。"
      ]
    },
    "旋": {
      "pinyin": [
        "xuan2",
        "xuan4"
      ],
      "meanings": [
        "回转，读xuán；随即、不久；转动也有xuàn音。"
      ],
      "ancient": [
        "酒旋沽写酒刚刚买来；回旋写旋转回环，须结合词语区别读音。"
      ]
    },
    "惯": {
      "pinyin": [
        "guan4"
      ],
      "meanings": [
        "习惯、习以为常。"
      ],
      "ancient": [
        "惯常、习惯，表示某种情形经常经历而熟悉。"
      ]
    },
    "皮": {
      "pinyin": [
        "pi2"
      ],
      "meanings": [
        "人或动物体表的组织；物体表层。"
      ],
      "ancient": [
        "射不主皮的皮是箭靶上的兽皮，联系射礼不以贯穿靶皮为主要标准。"
      ]
    },
    "猜": {
      "pinyin": [
        "cai1"
      ],
      "meanings": [
        "猜测；疑忌。"
      ],
      "ancient": [
        "嫌猜指嫌疑猜忌，两小无嫌猜写童年相处毫无猜忌。"
      ]
    },
    "呵": {
      "pinyin": [
        "a",
        "a1",
        "a2",
        "a3",
        "a4",
        "ha1",
        "he1",
        "huo1",
        "ke1"
      ],
      "meanings": [
        "呵斥；呼气；语气词。"
      ],
      "ancient": [
        "呵手指向手上呼气取暖，读hē；曲中句末呵常相当于啊，不把语气词解成呵斥。"
      ]
    },
    "筝": {
      "pinyin": [
        "zheng1"
      ],
      "meanings": [
        "弹拨弦乐器，读zhēng。"
      ],
      "ancient": [
        "哀筝指声调哀怨的筝声。"
      ]
    },
    "债": {
      "pinyin": [
        "zhai4"
      ],
      "meanings": [
        "欠下的钱财或应偿还的事物，读zhài。"
      ],
      "ancient": [
        "酒债指赊欠的酒钱。"
      ]
    },
    "缄": {
      "pinyin": [
        "jian1"
      ],
      "meanings": [
        "封闭；封口；书信，读jiān。"
      ],
      "ancient": [
        "开缄指拆开书信，缄口指闭口不言。"
      ]
    },
    "活": {
      "pinyin": [
        "guo1",
        "huo2"
      ],
      "meanings": [
        "生存；使有生机；灵动。"
      ],
      "ancient": [
        "成活指植物栽种后存活，不把它解作灵活。"
      ]
    },
    "累": {
      "pinyin": [
        "lei2",
        "lei3",
        "lei4",
        "lie4",
        "lv4"
      ],
      "meanings": [
        "积聚、连续，读lěi；牵连、劳倦，常读lèi；累累还有léi音。"
      ],
      "ancient": [
        "累十觞写接连饮下多杯酒；簪组累写官职的拘束牵累，须随词辨音义。"
      ]
    },
    "萝": {
      "pinyin": [
        "luo2"
      ],
      "meanings": [
        "松萝、藤萝等攀缘植物。"
      ],
      "ancient": [
        "青萝写青绿的藤蔓；牵萝补屋写牵引藤萝修补茅屋。"
      ]
    },
    "朦": {
      "pinyin": [
        "mang3",
        "meng2"
      ],
      "meanings": [
        "朦胧指模糊不清、隐约的样子，读méng。"
      ],
      "ancient": [
        "用于朦胧等词，写月色、景物或感受不清晰。"
      ]
    },
    "麟": {
      "pinyin": [
        "lin2"
      ],
      "meanings": [
        "麒麟，传说中的瑞兽，读lín。"
      ],
      "ancient": [
        "卧麒麟可写陵墓前倒卧的石麒麟，联系凭吊旧迹的语境。"
      ]
    },
    "酬": {
      "pinyin": [
        "chou2"
      ],
      "meanings": [
        "以酒相劝；报答；应答。"
      ],
      "ancient": [
        "诗题中酬常指以诗作答，酬佳节则写以饮酒等方式度过节日。"
      ]
    },
    "季": {
      "pinyin": [
        "ji4"
      ],
      "meanings": [
        "一年中的一季；排行最小；姓氏用字。"
      ],
      "ancient": [
        "四季指春夏秋冬；季氏为鲁国卿大夫家族名，不据单字解释其人物。"
      ]
    },
    "沟": {
      "pinyin": [
        "gou1"
      ],
      "meanings": [
        "水道、沟渠。"
      ],
      "ancient": [
        "沟陇联系田野中的沟渠与田垄。"
      ]
    },
    "砧": {
      "pinyin": [
        "zhen1"
      ],
      "meanings": [
        "捣衣、切物或锻打时垫在下面的石块、木板等，读zhēn。"
      ],
      "ancient": [
        "古诗词中的砧声常指捣衣声，不能一概解为砍切声。"
      ]
    },
    "救": {
      "pinyin": [
        "jiu1",
        "jiu4"
      ],
      "meanings": [
        "救助；制止、纠正。"
      ],
      "ancient": [
        "女弗能救与中的救是阻止、纠正季氏的越礼行为，不只是救人性命。"
      ]
    },
    "慰": {
      "pinyin": [
        "wei4"
      ],
      "meanings": [
        "安慰、宽解。"
      ],
      "ancient": [
        "自慰指自我宽慰。"
      ]
    }
  },
