{
  "version": "1.0.1",
  "dictionaryVersion": "1.1.19",
  "additions": {
    "堕": {
      "pinyin": [
        "duo4",
        "hui1"
      ],
      "meanings": [
        "落下、坠落，通常读duò；另有通隳的huī音。"
      ],
      "ancient": [
        "诗词中常写物体下落；通隳时与毁坏义有关，须随语境区别。"
      ]
    },
    "窝": {
      "pinyin": [
        "wo1"
      ],
      "meanings": [
        "鸟兽的巢穴；比喻居住、安身之所。"
      ],
      "ancient": [
        "安乐窝指安适的住处。"
      ]
    },
    "熏": {
      "pinyin": [
        "xun1",
        "xun4"
      ],
      "meanings": [
        "烟气熏染；温暖和煦。"
      ],
      "ancient": [
        "熏炉联系焚香取暖的炉具；熏风指和暖的风，读xūn。"
      ]
    },
    "冉": {
      "pinyin": [
        "dan1",
        "nan2",
        "ran3"
      ],
      "meanings": [
        "姓氏；冉冉表示缓慢或柔软下垂。"
      ],
      "ancient": [
        "冉有是孔子弟子冉求的字；冉冉另表示渐进，不按姓氏解释。"
      ]
    },
    "严": {
      "pinyin": [
        "yan2"
      ],
      "meanings": [
        "严格；严肃、庄严；严厉、程度深。"
      ],
      "ancient": [
        "严寒指酷寒，庄严指严肃端正，须结合所修饰之词。"
      ]
    },
    "闷": {
      "pinyin": [
        "men1",
        "men4"
      ],
      "meanings": [
        "烦闷、不畅快，常读mèn；空气不流通、闭气，常读mēn。"
      ],
      "ancient": [
        "解闷指排解愁闷，读mèn，不沿用来源页把所有义项都标为mèn的做法。"
      ]
    },
    "颍": {
      "pinyin": [
        "ying3"
      ],
      "meanings": [
        "颍水，水名，流经河南、安徽，读yǐng。"
      ],
      "ancient": [
        "箕颍联系箕山、颍水及许由隐居传说，借指隐逸。"
      ]
    },
    "配": {
      "pinyin": [
        "pei4"
      ],
      "meanings": [
        "相称、匹配；婚配；分派、调配。"
      ],
      "ancient": [
        "婚配指结为夫妇，分配指分派，不把现代词语的不同语境混为一义。"
      ]
    }
  },
