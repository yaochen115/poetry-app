    {
      "id": 255177,
      "title": "横吹曲辞 出塞",
      "content": [
        "黄砂直上白云间，一片孤城万仞山。",
        "羌笛何须怨杨柳，春风不度玉门关。"
      ],
      "author": {
        "id": 8897,
        "name": "王之涣"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 259604,
      "title": "登鹳雀楼",
      "content": [
        "白日依山尽，黄河入海流。",
        "欲穷千里目，更上一层楼。"
      ],
      "author": {
        "id": 8897,
        "name": "王之涣"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 259605,
      "title": "送别",
      "content": [
        "杨柳东风树，青青夹御河。",
        "近来攀折苦，应为别离多。"
      ],
      "author": {
        "id": 8897,
        "name": "王之涣"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 259606,
      "title": "凉州词二首” 一",
      "content": [
        "黄河远上白云间，一片孤城万仞山。",
        "羌笛何须怨杨柳，春光不度玉门关。"
      ],
      "author": {
        "id": 8897,
        "name": "王之涣"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 259607,
      "title": "凉州词二首” 二",
      "content": [
        "单于北望拂云堆，杀马登坛祭几回。",
        "汉家天子今神武，不肯和亲归去来。"
      ],
      "author": {
        "id": 8897,
        "name": "王之涣"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 259608,
      "title": "宴词",
      "content": [
        "长堤春水绿悠悠，畎入漳河一道流。",
        "莫听声声催去櫂，桃溪浅处不胜舟。"
      ],
      "author": {
        "id": 8897,
        "name": "王之涣"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 259609,
      "title": "九日送别",
      "content": [
        "蓟庭萧瑟故人稀，何处登高且送归。",
        "今日暂同芳菊酒，明朝应作断蓬飞。"
      ],
      "author": {
        "id": 8897,
        "name": "王之涣"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
