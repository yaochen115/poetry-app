{
  "provider": "https://poetry.palemoky.com/",
  "query": {
    "authorId": 8909
  },
  "items": [
    {
      "id": 289333,
      "title": "客舍寓怀",
      "content": [
        "洒洒滩声晚霁时，客亭风袖半披垂。",
        "野云行止谁相待，明月襟怀祗自知。",
        "无伴偶吟溪上路，有花偷笑腊前枝。",
        "牵情景物潜惆怅，忽似伤春远别离。"
      ],
      "author": {
        "id": 8909,
        "name": "钱珝"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 289334,
      "title": "送王郎中",
      "content": [
        "惜别远相送，却成惆怅多。",
        "独归回首处，争那暮山何。"
      ],
      "author": {
        "id": 8909,
        "name": "钱珝"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 289335,
      "title": "江行无题一百首 一",
      "content": [
        "倾酒向涟漪，乘流欲去时。",
        "寸心同尺璧，投此报冯夷。"
      ],
      "author": {
        "id": 8909,
        "name": "钱珝"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 289336,
      "title": "江行无题一百首 二",
      "content": [
        "江曲全萦楚，云飞半自秦。",
        "岘山回首望，如别故乡人。"
      ],
      "author": {
        "id": 8909,
        "name": "钱珝"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 289337,
      "title": "江行无题一百首 三",
      "content": [
        "浦烟含夜色，冷日转秋旻。",
        "自有沈碑在，清光不照人。"
      ],
      "author": {
        "id": 8909,
        "name": "钱珝"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 289338,
      "title": "江行无题一百首 四",
      "content": [
        "楚岸云空合，楚城人不来。",
        "祗今谁善舞，莫恨废章台。"
      ],
      "author": {
        "id": 8909,
        "name": "钱珝"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 289340,
      "title": "江行无题一百首 六",
      "content": [
        "晚来渔父喜，网重欲收迟。",
        "恐有长江使，金钱愿赎龟。"
      ],
      "author": {
        "id": 8909,
        "name": "钱珝"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 289342,
      "title": "江行无题一百首 八",
      "content": [
        "雾云疎有叶，雨浪细无花。",
        "稳放扁舟去，江天自有涯。"
      ],
      "author": {
        "id": 8909,
        "name": "钱珝"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 289345,
      "title": "江行无题一百首 十一",
      "content": [
        "夜江清未晓，徒惜月光沉。",
        "不是因行乐，堪伤老大心。"
      ],
      "author": {
        "id": 8909,
        "name": "钱珝"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 289346,
      "title": "江行无题一百首 十二",
      "content": [
        "翳日多乔木，维舟取束薪。",
        "静听江叟语，尽是厌兵人。"
      ],
      "author": {
        "id": 8909,
        "name": "钱珝"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 289349,
      "title": "江行无题一百首 十五",
      "content": [
        "渚边新鴈下，舟上独凄凉。",
        "俱是南来客，怜君缀一行。"
      ],
      "author": {
        "id": 8909,
        "name": "钱珝"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 289350,
      "title": "江行无题一百首 十六",
      "content": [
        "云密连江暗，风斜著物鸣。",
        "一杯真战将，笑尔作愁兵。"
      ],
      "author": {
        "id": 8909,
        "name": "钱珝"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 289351,
      "title": "江行无题一百首 十七",
      "content": [
        "柳拂斜开路，篱边数户村。",
        "可能还有意，不掩向江门。"
      ],
      "author": {
        "id": 8909,
        "name": "钱珝"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 289352,
      "title": "江行无题一百首 十八",
      "content": [
        "不识相如渴，徒吟子美诗。",
        "江清惟独看，心外更谁知。"
      ],
      "author": {
        "id": 8909,
        "name": "钱珝"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 289353,
      "title": "江行无题一百首 十九",
      "content": [
        "牵路沿江狭，沙崩岸不平。",
        "尽知行处险，谁肯载时轻。"
      ],
      "author": {
        "id": 8909,
        "name": "钱珝"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 289355,
      "title": "江行无题一百首 二十一",
      "content": [
        "水含秋夜静，云带夕阳高。",
        "诗癖非吾病，何妨吮短豪。"
      ],
      "author": {
        "id": 8909,
        "name": "钱珝"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 289356,
      "title": "江行无题一百首 二十二",
      "content": [
        "带舟维古岸，还似阻西陵。",
        "箕伯无多怒，回头讵不能。"
      ],
      "author": {
        "id": 8909,
        "name": "钱珝"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 289357,
      "title": "江行无题一百首 二十三",
      "content": [
        "秋云久无雨，江燕社犹飞。",
        "却笑舟中客，今年未得归。"
      ],
      "author": {
        "id": 8909,
        "name": "钱珝"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 289358,
      "title": "江行无题一百首 二十四",
      "content": [
        "帆翅初张处，云鹏怒翼同。",
        "莫愁千里路，自有到来风。"
      ],
      "author": {
        "id": 8909,
        "name": "钱珝"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 289360,
      "title": "江行无题一百首 二十六",
      "content": [
        "月下江流静，村荒人语稀。",
        "鹭鸳虽有伴，仍共影双飞。"
      ],
      "author": {
        "id": 8909,
        "name": "钱珝"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 289361,
      "title": "江行无题一百首 二十七",
      "content": [
        "斗转月未落，舟行夜已深。",
        "有村知不远，风便数声砧。"
      ],
      "author": {
        "id": 8909,
        "name": "钱珝"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 289362,
      "title": "江行无题一百首 二十八",
      "content": [
        "櫂惊沙鸟迅，飞溅夕阳波。",
        "不顾鱼多处，应防一目罗。"
      ],
      "author": {
        "id": 8909,
        "name": "钱珝"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 289363,
      "title": "江行无题一百首 二十九",
      "content": [
        "行到楚江岸，苍茫人正迷。",
        "秪如秦塞远，格磔鹧鸪啼。"
      ],
      "author": {
        "id": 8909,
        "name": "钱珝"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 289365,
      "title": "江行无题一百首 三十一",
      "content": [
        "岸草连荒色，村声乐稔年。",
        "晚晴贪获稻，闲却采菱船。"
      ],
      "author": {
        "id": 8909,
        "name": "钱珝"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 289366,
      "title": "江行无题一百首 三十二",
      "content": [
        "滩浅多游鹭，江清易见鱼。",
        "怪来吟未足，秋物欠红蕖。"
      ],
      "author": {
        "id": 8909,
        "name": "钱珝"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 289367,
      "title": "江行无题一百首 三十三",
      "content": [
        "蛩响依沙草，萤飞透水烟。",
        "夜凉谁咏史，空泊运租船。"
      ],
      "author": {
        "id": 8909,
        "name": "钱珝"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 289368,
      "title": "江行无题一百首 三十四",
      "content": [
        "睡稳叶舟轻，风微浪不惊。",
        "人居芦苇岸，终夜动秋声。"
      ],
      "author": {
        "id": 8909,
        "name": "钱珝"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 289369,
      "title": "江行无题一百首 三十五",
      "content": [
        "自念平生意，曾期一郡符。",
        "可知因谪宦，斑鬓入江湖。"
      ],
      "author": {
        "id": 8909,
        "name": "钱珝"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 289370,
      "title": "江行无题一百首 三十六",
      "content": [
        "水天凉夜月，不是少清光。",
        "好景随人物，秦淮忆建康。"
      ],
      "author": {
        "id": 8909,
        "name": "钱珝"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 289371,
      "title": "江行无题一百首 三十七",
      "content": [
        "古来多思客，摇落恨江潭。",
        "今日秋风至，萧疎过沔南。"
      ],
      "author": {
        "id": 8909,
        "name": "钱珝"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 289372,
      "title": "江行无题一百首 三十八",
      "content": [
        "映竹疑村好，穿芦觉渚幽。",
        "渐安无旷土，姜芋当农收。"
      ],
      "author": {
        "id": 8909,
        "name": "钱珝"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 289373,
      "title": "江行无题一百首 三十九",
      "content": [
        "烟渚复烟渚，画屏休画屏。",
        "引愁天末去，数点暮山青。"
      ],
      "author": {
        "id": 8909,
        "name": "钱珝"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 289374,
      "title": "江行无题一百首 四十",
      "content": [
        "秋风动客心，寂寂不成吟。",
        "飞上危樯立，莺啼报好音。"
      ],
      "author": {
        "id": 8909,
        "name": "钱珝"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 289376,
      "title": "江行无题一百首 四十二",
      "content": [
        "九日自佳节，扁舟无一杯。",
        "曹园旧罇酒，戏马忆高台。"
      ],
      "author": {
        "id": 8909,
        "name": "钱珝"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 289379,
      "title": "江行无题一百首 四十五",
      "content": [
        "轻云未扑霜，树杪橘初黄。",
        "行是知名物，过风过水香。"
      ],
      "author": {
        "id": 8909,
        "name": "钱珝"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 289380,
      "title": "江行无题一百首 四十六",
      "content": [
        "土旷深耕少，江平远钓多。",
        "平生皆弃本，金革竟如何。"
      ],
      "author": {
        "id": 8909,
        "name": "钱珝"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 289381,
      "title": "江行无题一百首 四十七",
      "content": [
        "海月非常物，等闲不可寻。",
        "披沙应有地，浅处定无金。"
      ],
      "author": {
        "id": 8909,
        "name": "钱珝"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 289382,
      "title": "江行无题一百首 四十八",
      "content": [
        "风晚冷飕飕，芦花已白头。",
        "旧来红叶寺，堪忆玉京秋。"
      ],
      "author": {
        "id": 8909,
        "name": "钱珝"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 289383,
      "title": "江行无题一百首 四十九",
      "content": [
        "渺渺望天涯，清涟浸赤霞。",
        "难逢星汉使，乌鹊日乘槎。"
      ],
      "author": {
        "id": 8909,
        "name": "钱珝"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 289384,
      "title": "江行无题一百首 五十",
      "content": [
        "风好来无阵，云开去有踪。",
        "钓歌无远近，应喜罢艨艟。"
      ],
      "author": {
        "id": 8909,
        "name": "钱珝"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 289385,
      "title": "江行无题一百首 五十一",
      "content": [
        "吴疆连楚甸，楚俗异吴乡。",
        "谩把罇中物，无人啄蟹黄。"
      ],
      "author": {
        "id": 8909,
        "name": "钱珝"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 289388,
      "title": "江行无题一百首 五十四",
      "content": [
        "垂露晚犹浓，清风不易逢。",
        "涉江虽已晚，高树搴芙蓉。"
      ],
      "author": {
        "id": 8909,
        "name": "钱珝"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 289389,
      "title": "江行无题一百首 五十五",
      "content": [
        "乘舟维夏口，烟野独行时。",
        "不见头陀寺，空怀幼妇碑。"
      ],
      "author": {
        "id": 8909,
        "name": "钱珝"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 289390,
      "title": "江行无题一百首 五十六",
      "content": [
        "晚泊武昌岸，津亭疎柳风。",
        "数株曾手植，好事忆陶公。"
      ],
      "author": {
        "id": 8909,
        "name": "钱珝"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 289392,
      "title": "江行无题一百首 五十八",
      "content": [
        "近戍离金落，孤岑望火门。",
        "惟将知命意，潇洒向乾坤。"
      ],
      "author": {
        "id": 8909,
        "name": "钱珝"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 289394,
      "title": "江行无题一百首 六十",
      "content": [
        "景夕残霞落，秋寒细雨晴。",
        "短缨何用濯，舟在月中行。"
      ],
      "author": {
        "id": 8909,
        "name": "钱珝"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 289397,
      "title": "江行无题一百首 六十三",
      "content": [
        "楼空人不归，云白去时衣。",
        "黄鹤无心下，长应笑令威。"
      ],
      "author": {
        "id": 8909,
        "name": "钱珝"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 289398,
      "title": "江行无题一百首 六十四",
      "content": [
        "白帝朝惊浪，阳台暮映云。",
        "等闲生险易，世路秪如君。"
      ],
      "author": {
        "id": 8909,
        "name": "钱珝"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 289399,
      "title": "江行无题一百首 六十五",
      "content": [
        "橹慢生轻浪，帆虚带白云。",
        "客船虽狭小，容得瘦将军。"
      ],
      "author": {
        "id": 8909,
        "name": "钱珝"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 289400,
      "title": "江行无题一百首 六十六",
      "content": [
        "静看秋江水，风微浪渐平。",
        "人间驰竞处，尘土自波成。"
      ],
      "author": {
        "id": 8909,
        "name": "钱珝"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 289401,
      "title": "江行无题一百首 六十七",
      "content": [
        "风借帆方疾，风回櫂却迟。",
        "较量人世事，不校一毫厘。"
      ],
      "author": {
        "id": 8909,
        "name": "钱珝"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 289402,
      "title": "江行无题一百首 六十八",
      "content": [
        "咫尺愁风雨，匡庐不可登。",
        "秪疑云雾窟，犹有六朝僧。"
      ],
      "author": {
        "id": 8909,
        "name": "钱珝"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 289403,
      "title": "江行无题一百首 六十九",
      "content": [
        "江草何多思，冬青尚满洲。",
        "谁能惊𫛳鸟，作赋为沙鸥。"
      ],
      "author": {
        "id": 8909,
        "name": "钱珝"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 289404,
      "title": "江行无题一百首 七十",
      "content": [
        "幸有烟波兴，宁辞笔砚劳。",
        "缘情无怨刺，却似反离骚。"
      ],
      "author": {
        "id": 8909,
        "name": "钱珝"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 289405,
      "title": "江行无题一百首 七十一",
      "content": [
        "沙上独行时，高吟到楚词。",
        "难将垂岸蓼，盈把当江蓠。"
      ],
      "author": {
        "id": 8909,
        "name": "钱珝"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 289406,
      "title": "江行无题一百首 七十二",
      "content": [
        "秋寒鹰隼健，逐雀下云空。",
        "知是江湖客，无心击塞鸿。"
      ],
      "author": {
        "id": 8909,
        "name": "钱珝"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 289407,
      "title": "江行无题一百首 七十三",
      "content": [
        "幽怀念烟水，长恨隔龙沙。",
        "今日滕王阁，分明见落霞。"
      ],
      "author": {
        "id": 8909,
        "name": "钱珝"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 289408,
      "title": "江行无题一百首 七十四",
      "content": [
        "江流何渺渺，怀古独依依。",
        "渔父非贤者，芦中但有矶。"
      ],
      "author": {
        "id": 8909,
        "name": "钱珝"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 289409,
      "title": "江行无题一百首 七十五",
      "content": [
        "风雨正甘寝，云霓忽晓晴。",
        "放歌虽自遣，一岁又峥嵘。"
      ],
      "author": {
        "id": 8909,
        "name": "钱珝"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 289410,
      "title": "江行无题一百首 七十六",
      "content": [
        "幽思正迟迟，沙边濯弄时。",
        "自怜非博物，犹未识凫葵。"
      ],
      "author": {
        "id": 8909,
        "name": "钱珝"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 289411,
      "title": "江行无题一百首 七十七",
      "content": [
        "曾有烟波客，能歌西塞山。",
        "落花惟待月，一钓紫菱湾。"
      ],
      "author": {
        "id": 8909,
        "name": "钱珝"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 289412,
      "title": "江行无题一百首 七十八",
      "content": [
        "千顷水纹细，一拳岚影孤。",
        "君山寒树绿，曾过洞庭湖。"
      ],
      "author": {
        "id": 8909,
        "name": "钱珝"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 289413,
      "title": "江行无题一百首 七十九",
      "content": [
        "光阔重湖水，低斜远鴈行。",
        "未曾无兴咏，多谢沈东阳。"
      ],
      "author": {
        "id": 8909,
        "name": "钱珝"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 289414,
      "title": "江行无题一百首 八十",
      "content": [
        "晚菊绕江垒，忽如开古屏。",
        "莫言时节过，白日有余馨。"
      ],
      "author": {
        "id": 8909,
        "name": "钱珝"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 289415,
      "title": "江行无题一百首 八十一",
      "content": [
        "日落长亭晚，山门步障青。",
        "可怜无酒分，处处有旗亭。"
      ],
      "author": {
        "id": 8909,
        "name": "钱珝"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 289416,
      "title": "江行无题一百首 八十二",
      "content": [
        "远岸无行树，经霜有伴红。",
        "停船搜好句，题叶赠江枫。"
      ],
      "author": {
        "id": 8909,
        "name": "钱珝"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 289417,
      "title": "江行无题一百首 八十三",
      "content": [
        "身世比行舟，无风亦暂休。",
        "敢言终破浪，惟愿稳乘流。"
      ],
      "author": {
        "id": 8909,
        "name": "钱珝"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 289418,
      "title": "江行无题一百首 八十四",
      "content": [
        "数亩苍苔石，烟蒙鹤卵洲。",
        "定因词客遇，名字始风流。"
      ],
      "author": {
        "id": 8909,
        "name": "钱珝"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 289419,
      "title": "江行无题一百首 八十五",
      "content": [
        "兴闲停桂楫，路好过松门。",
        "不负佳山水，还开酒一樽。"
      ],
      "author": {
        "id": 8909,
        "name": "钱珝"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 289420,
      "title": "江行无题一百首 八十六",
      "content": [
        "短檝休敲桂，孤根自驻萍。",
        "自怜非劒气，空向斗牛星。"
      ],
      "author": {
        "id": 8909,
        "name": "钱珝"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 289421,
      "title": "江行无题一百首 八十七",
      "content": [
        "高浪如银屋，江风一发时。",
        "笔端降太白，才大语终奇。"
      ],
      "author": {
        "id": 8909,
        "name": "钱珝"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 289422,
      "title": "江行无题一百首 八十八",
      "content": [
        "细竹渔家路，晴阳看结罾。",
        "喜来邀客坐，分与折腰菱。"
      ],
      "author": {
        "id": 8909,
        "name": "钱珝"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 289423,
      "title": "江行无题一百首 八十九",
      "content": [
        "平湖五百里，江水想通波。",
        "不奈扁舟去，其如决计何。"
      ],
      "author": {
        "id": 8909,
        "name": "钱珝"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 289424,
      "title": "江行无题一百首 九十",
      "content": [
        "数逢云断处，去岸映高山。",
        "身到章江日，应犹未得闲。"
      ],
      "author": {
        "id": 8909,
        "name": "钱珝"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 289425,
      "title": "江行无题一百首 九十一",
      "content": [
        "一湾斜照水，三版顺风船。",
        "未敢相邀钓，劳生只自怜。"
      ],
      "author": {
        "id": 8909,
        "name": "钱珝"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 289426,
      "title": "江行无题一百首 九十二",
      "content": [
        "江雨正霏微，江村晚渡稀。",
        "何曾妨钓艇，更待得鱼归。"
      ],
      "author": {
        "id": 8909,
        "name": "钱珝"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 289429,
      "title": "江行无题一百首 九十五",
      "content": [
        "湖口分江水，东流独有情。",
        "常时好风物，谁伴谢宣城。"
      ],
      "author": {
        "id": 8909,
        "name": "钱珝"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 289431,
      "title": "江行无题一百首 九十七",
      "content": [
        "高峰有佳号，千尺倚寒风。",
        "若使炉烟在，犹应为上公。"
      ],
      "author": {
        "id": 8909,
        "name": "钱珝"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 289434,
      "title": "江行无题一百首 一百",
      "content": [
        "远谪岁时[晏]，暮江风雨寒。",
        "仍愁系舟处，惊梦近长滩。"
      ],
      "author": {
        "id": 8909,
        "name": "钱珝"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 289435,
      "title": "春恨三首 一",
      "content": [
        "负罪将军在北朝，秦淮芳草绿迢迢。",
        "高台爱妾魂销尽，始得丘迟为一招。"
      ],
      "author": {
        "id": 8909,
        "name": "钱珝"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 289436,
      "title": "春恨三首 二",
      "content": [
        "久戍临洮报未归，箧香销尽别时衣。",
        "身轻愿比兰堦蝶，万里还寻塞草飞。"
      ],
      "author": {
        "id": 8909,
        "name": "钱珝"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 289437,
      "title": "春恨三首 三",
      "content": [
        "永巷频闻小苑游，旧恩如泪亦难收。",
        "君前愿报新颜色，团扇须防白露秋。"
      ],
      "author": {
        "id": 8909,
        "name": "钱珝"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 289438,
      "title": "蜀国偶题",
      "content": [
        "忽忆明皇西幸时，暗伤潜恨竟谁知。",
        "佩兰应语宫臣道，莫向金盘进茘枝。"
      ],
      "author": {
        "id": 8909,
        "name": "钱珝"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 289439,
      "title": "未展芭蕉",
      "content": [
        "冷烛无烟绿蜡干，芳心犹卷怯春寒。",
        "一缄书箚藏何事，会被东风暗拆看。"
      ],
      "author": {
        "id": 8909,
        "name": "钱珝"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 289440,
      "title": "同程九早入中书",
      "content": [
        "汉家贤相重英奇，蟠木何材也见知。",
        "不意云霄能自致，空惊鹓鹭忽相随。",
        "腊雪初明柏子殿，春光欲上万年枝。",
        "独惭皇鉴明如日，未厌春光向玉墀。"
      ],
      "author": {
        "id": 8909,
        "name": "钱珝"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 304558,
      "title": "和王员外雪晴早朝",
      "content": [
        "紫微晴雪带恩光，绕仗偏随鸳鹭行。",
        "长信月留宁避晓，宜春花满不飞香。",
        "独看积素凝清禁，已觉轻寒让太阳。",
        "题柱盛名兼绝唱，风流谁继汉田郎。",
        "（见《钱考功集》卷八）（按：《万首唐人绝句》卷六八收前四句作钱珝诗。",
        "《韵语阳秋》卷二谓此诗及《同程七蚤入中书》「二诗皆珝所作无疑，盖起未尝入中书也。",
        "」《全唐诗》卷二三九收此诗于钱起名下，今为移正。"
      ],
      "author": {
        "id": 8909,
        "name": "钱珝"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 304559,
      "title": "赴章陵酬李卿留别",
      "content": [
        "一官叨下秩，九棘谢知音。",
        "芳草文园路，春愁满别心。",
        "（见《万首唐人绝句》卷八一、《钱考功集》卷十，均收作钱起诗。",
        "《全唐诗》卷二三九收作钱起诗）。"
      ],
      "author": {
        "id": 8909,
        "name": "钱珝"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 304560,
      "title": "罢章陵令山居过中峰道者二首 一",
      "content": [
        "宁辞园令秩，不改渊明调。",
        "解印无与言，见山始一笑。",
        "幽人还绝境，谁道苦奔峭。",
        "随云剩渡溪，出门更垂钓。",
        "吾庐青霞里，窗树玄猿啸。",
        "微月清风来，方知散发妙。"
      ],
      "author": {
        "id": 8909,
        "name": "钱珝"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 304561,
      "title": "罢章陵令山居过中峰道者二首 二",
      "content": [
        "丘壑去如此，暮年始栖偃。",
        "赖遇无心云，不笑归来晚。",
        "鸣鸠拂红枝，初服傍清畎。",
        "昨日山僧来，犹嫌嘉遯浅。",
        "托君紫阳家，路灭心更远。",
        "梯云创其居，抱犊上绝𪩘。",
        "杏田溪一曲，霞境峰几转。",
        "路石挂飞泉，谢公应在眼。",
        "愿言携手去，采药长不返。",
        "（见《钱考功集》卷三。",
        "《全唐诗》卷二三六收作钱起诗。",
        "吴企明云章陵为唐文宗陵。"
      ],
      "author": {
        "id": 8909,
        "name": "钱珝"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 304562,
      "title": "裴侍郎湘川回以青竹筒相遗因而赠之",
      "content": [
        "楚竹青玉润，从来湘水阴。",
        "缄书取直节，君子知虚心。",
        "入用随宪简，积文不受金。",
        "体将丹凤直，色映秋霜深。",
        "宁肯假伶伦，谬为龙凤吟。",
        "唯将翰院客，昔秘瑶华音。",
        "长跪捧嘉贶，岁寒惭所钦。",
        "（同前。",
        "吴企明云裴侍郎为裴瓒）。"
      ],
      "author": {
        "id": 8909,
        "name": "钱珝"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 304563,
      "title": "禁闱玩雪寄薛左丞",
      "content": [
        "玄云低禁苑，飞雪满神州。",
        "虚白生台榭，寒光入冕旒。",
        "粉凝宫壁静，乳结洞门幽。",
        "细绕回风转，轻随落羽浮。",
        "怒涛堆砌石，新月孕帘钩。",
        "为报诗人道，丰年颂圣猷。",
        "（见《钱考功集》卷六。",
        "《全唐诗》卷二三八收作钱起诗。",
        "吴企明云薛左丞指薛廷珪）。"
      ],
      "author": {
        "id": 8909,
        "name": "钱珝"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 304564,
      "title": "中书遇雨",
      "content": [
        "济旱惟宸虑，为霖即上台。",
        "云衔七曜起，雨拂九门来。",
        "纶阁飞丝度，龙渠激霤回。",
        "色翻池上藻，香裛鼎前杯。",
        "湘燕皆舒翼，沙鳞岂曝腮。",
        "尺波应为假，虞海载沿洄。",
        "（同前）。"
      ],
      "author": {
        "id": 8909,
        "name": "钱珝"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 304565,
      "title": "中书省言怀因酬嵩阳张道士见寄",
      "content": [
        "朝花寻暝林，对酒伤春心。",
        "流年依素发，不觉映华簪。",
        "垂老遇中巳（集作「明代」，又作「知己」），酧恩看寸阴。",
        "如何紫芝客（集作「多慙紫阳客」），相忆白雪深。",
        "（见《文苑英华》卷二二八，署「钱起」。",
        "《全唐诗》卷二三七收作钱起诗）（按：以上七首，《全唐诗》皆收作钱起诗。",
        "今从《文学评论》第十三辑吴企明《钱起钱珝诗考辨》一文移正为钱珝诗。",
        "）（吴文于此数诗考证甚详，可视作定论。",
        "因文长，兹不备录。",
        "另吴文尚考出七首钱起诗为钱珝作，惜所举之证尚难成为定论，今不取。"
      ],
      "author": {
        "id": 8909,
        "name": "钱珝"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 368904,
      "title": "客舍寓怀",
      "content": [
        "洒洒滩声晚霁时，客亭风袖半披垂。",
        "野云行止谁相待，",
        "牵情景物潜惆怅，忽似伤春远别离。"
      ],
      "author": {
        "id": 8909,
        "name": "钱珝"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 368906,
      "title": "江行无题一百首",
      "content": [
        "倾酒向涟漪，乘流欲去时。",
        "寸心同尺璧，投此报冯夷。",
        "江曲全萦楚，云飞半自秦。",
        "岘山回首望，如别故乡人。",
        "浦烟含夜色，冷日转秋旻。",
        "自有沈碑在，清光不照人。",
        "楚岸云空合，楚城人不来。",
        "只今谁善舞，莫恨废章台。",
        "行背青山郭，吟当白露秋。",
        "风流无屈宋，空咏古荆州。",
        "晚来渔父喜，网重欲收迟。",
        "恐有长江使，金钱愿赎龟。",
        "去指龙沙路，徒悬象阙心。",
        "夜凉无远梦，不为偶闻砧。",
        "雾云疏有叶，雨浪细无花。",
        "稳放扁舟去，江天自有涯。",
        "好日当秋半，层波动旅肠。",
        "已行千里外，谁与共秋光。",
        "润色非东里，官曹更建章。",
        "宦游难自定，来唤棹船郎。",
        "夜江清未晓，徒惜月光沉。",
        "不是因行乐，堪伤老大心。",
        "翳日多乔木，维舟取束薪。",
        "静听江叟语，尽是厌兵人。",
        "箭漏日初短，汀烟草未衰。",
        "雨余虽更绿，不是采苹时。",
        "山雨夜来涨，喜鱼跳满江。",
        "岸沙平欲尽，垂蓼入船窗。",
        "渚边新雁下，舟上独凄凉。",
        "俱是南来客，怜君缀一行。",
        "云密连江暗，风斜著物鸣。",
        "一杯真战将，笑尔作愁兵。",
        "柳拂斜开路，篱边数户村。",
        "可能还有意，不掩向江门。",
        "不识相如渴，徒吟子美诗。",
        "江清惟独看，心外更谁知。",
        "牵路沿江狭，沙崩岸不平。",
        "尽知行处险，谁肯载时轻。",
        "憔悴异灵均，非谗作逐臣。",
        "如逢渔父问，未是独醒人。",
        "水含秋夜静，云带夕阳高。",
        "诗癖非吾病，何妨吮短豪。",
        "带舟维古岸，还似阻西陵。",
        "箕伯无多怒，回头讵不能。",
        "秋云久无雨，江燕社犹飞。",
        "却笑舟中客，今年未得归。",
        "帆翅初张处，云鹏怒翼同。",
        "莫愁千里路，自有到来风。",
        "佳节虽逢菊，浮生正似萍。",
        "故山何处望，荒岸小长亭。",
        "月下江流静，村荒人语稀。",
        "鹭鸳虽有伴，仍共影双飞。",
        "斗转月未落，舟行夜已深。",
        "有村知不远，风便数声砧。",
        "棹惊沙鸟迅，飞溅夕阳波。",
        "不顾鱼多处，应防一目罗。",
        "行到楚江岸，苍茫人正迷。",
        "只如秦塞远，格磔鹧鸪啼。",
        "渐觉江天远，难逢故国书。",
        "可能无往事，空食鼎中鱼。",
        "岸草连荒色，村声乐稔年。",
        "晚晴贪获稻，闲却彩菱船。",
        "滩浅多游鹭，江清易见鱼。",
        "怪来吟未足，秋物欠红蕖。",
        "蛩响依沙草，萤飞透水烟。",
        "夜凉谁咏史，空泊运租船。",
        "睡稳叶舟轻，风微浪不惊。",
        "人居芦苇岸，终夜动秋声。",
        "自念平生意，曾期一郡符。",
        "可知因谪宦，斑鬓入江湖。",
        "水天凉夜月，不是少清光。",
        "好景随人物，秦淮忆建康。",
        "古来多思客，摇落恨江潭。",
        "今日秋风至，萧疏过沔南。",
        "映竹疑村好，穿芦觉渚幽。",
        "渐安无旷土，姜芋当农收。",
        "烟渚复烟渚，画屏休画屏。",
        "引愁天末去，数点暮山青。",
        "秋风动客心，寂寂不成吟。",
        "飞上危樯立，莺啼报好音。",
        "见底高秋水，开怀万里天。",
        "旅吟还有伴，沙柳数枝蝉。",
        "九日自佳节，扁舟无一杯。",
        "曹园旧樽酒，戏马忆高台。",
        "兵火有余烬，贫村才数家。",
        "无人争晓渡，残月下寒沙。",
        "渚禽菱芡足，不向稻粱争。",
        "静宿凉湾月，应无失侣声。",
        "轻云未扑霜，树杪橘初黄。",
        "行是知名物，过风过水香。",
        "土旷深耕少，江平远钓多。",
        "平生皆弃本，金革竟如何。",
        "海月非常物，等闲不可寻。",
        "披沙应有地，浅处定无金。",
        "风晚冷飕飕，芦花已白头。",
        "旧来红叶寺，堪忆玉京秋。",
        "渺渺望天涯，清涟浸赤霞。",
        "难逢星汉使，乌鹊日乘槎。",
        "风好来无阵，云开去有踪。",
        "钓歌无远近，应喜罢艨艟。",
        "吴疆连楚甸，楚俗异吴乡。",
        "谩把樽中物，无人啄蟹黄。",
        "岸绿野烟远，江红斜照微。",
        "撑开小渔艇，应到月明归。",
        "雨余江始涨，漾漾见流薪。",
        "曾叹河中木，斯言忆古人。",
        "垂露晚犹浓，清风不易逢。",
        "涉江虽已晚，高树搴芙蓉。",
        "乘舟维夏口，烟野独行时。",
        "不见头陀寺，空怀幼妇碑。",
        "晚泊武昌岸，津亭疏柳风。",
        "数株曾手植，好事忆陶公。",
        "舟航依浦定，星斗满江寒。",
        "若比阴霾日，何妨夜未阑。",
        "近戍离金落，孤岑望火门。",
        "惟将知命意，潇洒向乾坤。",
        "丛菊生堤上，此花长后时。",
        "有人还采掇，何必在春期。",
        "景夕残霞落，秋寒细雨晴。",
        "短缨何用濯，舟在月中行。",
        "堤坏漏江水，地坳成野塘。",
        "晚荷人不折，留取作秋香。",
        "左宦终何路，摅怀亦自宽。",
        "襞笺嘲白鹭，无意喻枭鸾。",
        "楼空人不归，云白去时衣。",
        "黄鹤无心下，长应笑令威。",
        "白帝朝惊浪，阳台暮映云。",
        "等闲生险易，世路只如君。",
        "橹慢生轻浪，帆虚带白云。",
        "客船虽狭小，容得瘦将军。",
        "静看秋江水，风渐浪微平。",
        "人间驰竞处，尘土自波成。",
        "风借帆方疾，风回棹却迟。",
        "较量人世事，不校一毫厘。",
        "咫尺愁风雨，匡庐不可登。",
        "只疑云雾窟，犹有六朝僧。",
        "江草何多思，冬青尚满洲。",
        "谁能惊𫛳鸟，作赋为沙鸥。",
        "幸有烟波兴，宁辞笔砚劳。",
        "缘情无怨刺，却似反离骚。",
        "沙上独行时，高吟到楚词。",
        "难将垂岸蓼，盈把当江蓠。",
        "秋寒鹰隼健，逐雀下云空。",
        "知是江湖客，无心击塞鸿。",
        "幽怀念烟水，长恨隔龙沙。",
        "今日滕王阁，分明见落霞。",
        "江流何渺渺，怀古独依依。",
        "渔父非贤者，芦中但有矶。",
        "风雨正甘寝，云霓忽晓晴。",
        "放歌虽自遣，一岁又峥嵘。",
        "幽思正迟迟，沙边濯弄时。",
        "自怜非博物，犹未识凫葵。",
        "曾有烟波客，能歌西塞山。",
        "落花惟待月，一钓紫菱湾。",
        "千顷水纹细，一拳岚影孤。",
        "君山寒树绿，曾过洞庭湖。",
        "光阔重湖水，低斜远雁行。",
        "未曾无兴咏，多谢沈东阳。",
        "晚菊绕江垒，忽如开古屏。",
        "莫言时节过，白日有余馨。",
        "日落长亭晚，山门步障青。",
        "可怜无酒分，处处有旗亭。",
        "远岸无行树，经霜有伴红。",
        "停船搜好句，题叶赠江枫。",
        "身世比行舟，无风亦暂休。",
        "敢言终破浪，惟愿稳乘流。",
        "数亩苍苔石，烟蒙鹤卵洲。",
        "定因词客遇，名字始风流。",
        "兴闲停桂楫，路好过松门。",
        "不负佳山水，还开酒一樽。",
        "短楫休敲桂，孤根自驻萍。",
        "自怜非剑气，空向斗牛星。",
        "高浪如银屋，江风一发时。",
        "笔端降太白，才大语终奇。",
        "细竹渔家路，晴阳看结罾。",
        "喜来邀客坐，分与折腰菱。",
        "平湖五百里，江水想通波。",
        "不奈扁舟去，其如决计何。",
        "数逢云断处，去岸映高山。",
        "身到章江日，应犹未得闲。",
        "一湾斜照水，三版顺风船。",
        "未敢相邀钓，劳生只自怜。",
        "江雨正霏微，江村晚渡稀。",
        "何曾妨钓艇，更待得鱼归。",
        "新野旧楼名，浔阳胜赏情。",
        "照人长一色，江月共凄清。",
        "愿饮西江水，那吟北渚愁。",
        "莫教留滞迹，远比蔡昭侯。",
        "湖口分江水，东流独有情。",
        "常时好风物，谁伴谢宣城。",
        "浔阳江畔菊，应似古来秋。",
        "为问幽栖客，吟时得酒不。",
        "高峰有佳号，千尺倚寒风。",
        "若使炉烟在，犹应为上公。",
        "万木已清霜，江边村事忙。",
        "故溪黄稻熟，一夜梦中香。",
        "楚水苦萦回，征帆落又开。",
        "可缘非直路，却有好风来。",
        "远谪岁时晏，暮江风雨寒。",
        "仍愁系舟处，惊梦近长滩。"
      ],
