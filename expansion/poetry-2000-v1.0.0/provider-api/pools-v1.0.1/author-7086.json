  "items": [
    {
      "id": 254985,
      "title": "郊庙歌辞 享惠昭太子庙乐章 送神",
      "content": [
        "威仪毕陈，备乐将阕。",
        "苞茅酒缩，膋萧香彻。",
        "宫臣展事，肃雍在列。",
        "迎精送往，厥鉴昭晰。"
      ],
      "author": {
        "id": 7086,
        "name": "王涯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 255429,
      "title": "相和歌辞 从军行三首 一",
      "content": [
        "旌甲从军久，风云识阵难。",
        "今朝韩信计，日下斩成安。"
      ],
      "author": {
        "id": 7086,
        "name": "王涯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 255430,
      "title": "相和歌辞 从军行三首 二",
      "content": [
        "燕颔多奇相，狼头敢犯边。",
        "寄言班定远，正是立功年。"
      ],
      "author": {
        "id": 7086,
        "name": "王涯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 255431,
      "title": "相和歌辞 从军行三首 三",
      "content": [
        "旄头夜落捷书飞，来奏金门著赐衣。",
        "白马将军频破敌，黄龙戍卒几时归。"
      ],
      "author": {
        "id": 7086,
        "name": "王涯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 255775,
      "title": "琴曲歌辞 蔡氏五弄 游春曲二首 一",
      "content": [
        "万树江边杏，新开一夜风。",
        "满园深浅色，照在绿波中。"
      ],
      "author": {
        "id": 7086,
        "name": "王涯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 255776,
      "title": "琴曲歌辞 蔡氏五弄 游春曲二首 二",
      "content": [
        "上苑何穷树，花开次第新。",
        "香车与丝骑，风静亦生尘。"
      ],
      "author": {
        "id": 7086,
        "name": "王涯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 255777,
      "title": "琴曲歌辞  游春辞二首 一",
      "content": [
        "曲江丝柳变烟条，寒骨冰随暖气销。",
        "才见春光生绮陌，已闻清乐动云韶。"
      ],
      "author": {
        "id": 7086,
        "name": "王涯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 255778,
      "title": "琴曲歌辞  游春辞二首 二",
      "content": [
        "经过柳陌与桃蹊，寻逐风光著处迷。",
        "鸟度时时冲絮起，花繁衮衮压枝低。"
      ],
      "author": {
        "id": 7086,
        "name": "王涯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 255791,
      "title": "琴曲歌辞  秋思二首 一",
      "content": [
        "网轩凉吹动轻衣，夜听更长玉漏稀。",
        "月渡天河光转湿，鹊惊秋树叶频飞。"
      ],
      "author": {
        "id": 7086,
        "name": "王涯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 255792,
      "title": "琴曲歌辞  秋思二首 二",
      "content": [
        "宫连太液见苍波，暑气微清秋意多。",
        "一夜轻风苹末起，露珠翻尽满池荷。"
      ],
      "author": {
        "id": 7086,
        "name": "王涯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 256134,
      "title": "杂曲歌辞 秋夜曲",
      "content": [
        "桂魄初生秋露微，轻罗已薄未更衣。",
        "银筝夜久殷勤弄，心怯空房不忍归。"
      ],
      "author": {
        "id": 7086,
        "name": "王涯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 256142,
      "title": "杂曲歌辞 春江曲",
      "content": [
        "摇漾越江春，相将看白苹。",
        "归时不觉夜，出浦月随人。"
      ],
      "author": {
        "id": 7086,
        "name": "王涯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 264536,
      "title": "享惠昭太子庙乐章",
      "content": [
        "威仪毕陈，备乐将阕。",
        "苞茅酒缩，膋萧香彻。",
        "宫臣展事，肃雍在列。",
        "迎精送往，厥鉴昭晰。"
      ],
      "author": {
        "id": 7086,
        "name": "王涯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
