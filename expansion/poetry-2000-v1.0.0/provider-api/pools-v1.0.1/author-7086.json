        "name": "其他"
      }
    },
    {
      "id": 264537,
      "title": "望禁门松雪",
      "content": [
        "宿云开霁景，佳气此时浓。",
        "瑞雪凝清禁，祥烟幂小松。",
        "依稀鸳瓦出，隐映凤楼重。",
        "金阙晴光照，琼枝瑞色封。",
        "叶铺全类玉，柯偃乍疑龙。",
        "讵比寒山上，风霜老昔容。"
      ],
      "author": {
        "id": 7086,
        "name": "王涯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 264538,
      "title": "广宣上人以诗贺放榜和谢",
      "content": [
        "延英面奉入春闱，亦选功夫亦选奇。",
        "在冶只求金不耗，用心空学秤无私。",
        "龙门变化人皆望，莺谷飞鸣自有时。",
        "独喜至公谁是证，弥天上人与新诗。"
      ],
      "author": {
        "id": 7086,
        "name": "王涯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 264539,
      "title": "九月九日勤政楼下观百僚献寿",
      "content": [
        "御气黄花节，临轩紫陌头。",
        "早阳生彩仗，霁色入仙楼。",
        "献寿皆鹓鹭，瞻天尽冕旒。",
        "菊樽过九日，凤历肇千秋。",
        "乐奏薰风起，杯酣瑞影收。",
        "年年歌舞度，此地庆皇休。"
      ],
      "author": {
        "id": 7086,
        "name": "王涯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 264540,
      "title": "春游曲二首 一",
      "content": [
        "万树江边杏，新开一夜风。",
        "满园深浅色，照在绿波中。"
      ],
      "author": {
        "id": 7086,
        "name": "王涯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 264541,
      "title": "春游曲二首 二",
      "content": [
        "上苑何穷树，花间次第新。",
        "香车与丝骑，风静亦生尘。"
      ],
      "author": {
        "id": 7086,
        "name": "王涯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 264542,
      "title": "太平词",
      "content": [
        "风俗今和厚，君王在穆清。",
        "行看采华曲，尽是泰阶平。"
      ],
      "author": {
        "id": 7086,
        "name": "王涯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 264543,
      "title": "送春词",
      "content": [
        "日日人空老，年年春更归。",
        "相欢在尊酒，不用惜花飞。"
      ],
      "author": {
        "id": 7086,
        "name": "王涯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 264544,
      "title": "塞上曲二首 一",
      "content": [
        "天骄远塞行，出鞘宝刀鸣。",
        "定是酬恩日，今朝觉命轻。"
      ],
      "author": {
        "id": 7086,
        "name": "王涯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 264545,
      "title": "塞上曲二首 二",
      "content": [
        "塞虏常为敌，边风已报秋。",
        "平生多志气，箭底觅封侯。"
      ],
      "author": {
        "id": 7086,
        "name": "王涯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 264546,
      "title": "陇上行",
      "content": [
        "负羽到边州，鸣笳度陇头。",
        "云黄知塞近，草白见边秋。"
      ],
      "author": {
        "id": 7086,
        "name": "王涯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 264547,
      "title": "思君恩",
      "content": [
        "鸡鸣天汉晓，莺语禁林春。",
        "谁入巫山梦，唯应洛水神。"
      ],
      "author": {
        "id": 7086,
        "name": "王涯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 264548,
      "title": "春闺思",
      "content": [
        "雪尽萱抽叶，风轻水变苔。",
        "玉关音信断，又见发庭梅。"
      ],
      "author": {
        "id": 7086,
        "name": "王涯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 264549,
      "title": "春江曲",
      "content": [
        "摇漾越江春，相将采白苹。",
        "归时不觉夜，出浦月随人。"
      ],
      "author": {
        "id": 7086,
        "name": "王涯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 264550,
      "title": "闺人赠远五首 一",
      "content": [
        "花明绮陌春，柳拂御沟新。",
        "为报辽阳客，流芳不待人。"
      ],
      "author": {
        "id": 7086,
        "name": "王涯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 264551,
      "title": "闺人赠远五首 二",
      "content": [
        "远戍功名薄，幽闺年貌伤。",
        "妆成对春树，不语泪千行。"
      ],
      "author": {
        "id": 7086,
        "name": "王涯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 264552,
      "title": "闺人赠远五首 三",
      "content": [
        "形影一朝别，烟波千里分。",
        "君看望君处，祗是起行云。"
      ],
      "author": {
        "id": 7086,
        "name": "王涯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 264553,
      "title": "闺人赠远五首 四",
      "content": [
        "啼莺绿树深，语燕雕梁晚。",
        "不省出门行，沙场知近远。"
      ],
      "author": {
        "id": 7086,
        "name": "王涯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 264554,
      "title": "闺人赠远五首 五",
      "content": [
        "洞房今夜月，如练复如霜。",
        "为照离人恨，亭亭到晓光。"
      ],
      "author": {
        "id": 7086,
        "name": "王涯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
