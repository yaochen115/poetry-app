        "name": "王涯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 264563,
      "title": "秋思二首 一",
      "content": [
        "网轩凉吹动轻衣，夜听更长玉漏稀。",
        "月度天河光转湿，鹊惊秋树叶频飞。"
      ],
      "author": {
        "id": 7086,
        "name": "王涯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 264564,
      "title": "秋思二首 二",
      "content": [
        "宫连太液见沧波，暑气微消秋意多。",
        "一夜清风苹末起，露珠翻尽满池荷。"
      ],
      "author": {
        "id": 7086,
        "name": "王涯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 264565,
      "title": "汉苑行",
      "content": [
        "二月春风遍柳条，九天仙乐奏云韶。",
        "蓬莱殿后花如锦，紫阁阶前雪未销。"
      ],
      "author": {
        "id": 7086,
        "name": "王涯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 264566,
      "title": "秋夜曲",
      "content": [
        "桂魄初生秋露微，轻罗已薄未更衣。",
        "银筝夜久殷勤弄，心怯空房不忍归。"
      ],
      "author": {
        "id": 7086,
        "name": "王涯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 264567,
      "title": "献寿辞",
      "content": [
        "宫殿参差列九重，祥云瑞气捧堦浓。",
        "微臣欲献唐尧寿，遥指南山对衮龙。"
      ],
      "author": {
        "id": 7086,
        "name": "王涯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 264568,
      "title": "秋思赠远二首 一",
      "content": [
        "当年只自守空帷，梦里关山觉别离。",
        "不见乡书传鴈足，唯看新月吐蛾眉。"
      ],
      "author": {
        "id": 7086,
        "name": "王涯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 264569,
      "title": "秋思赠远二首 二",
      "content": [
        "厌攀杨柳临清阁，闲采芙蕖傍碧潭。",
        "走马台边人不见，拂云堆畔战初酣。"
      ],
      "author": {
        "id": 7086,
        "name": "王涯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 264570,
      "title": "春闺思",
      "content": [
        "愁见游空百尺丝，春风挽断更伤离。",
        "闲花落尽青苔地，尽日无人谁得知。"
      ],
      "author": {
        "id": 7086,
        "name": "王涯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 264571,
      "title": "宫词三十首 一",
      "content": [
        "白人宜著紫衣裳，冠子梳头双眼长。",
        "新睡起来思旧梦，见人忘却道胜常。"
      ],
      "author": {
        "id": 7086,
        "name": "王涯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 264572,
      "title": "宫词三十首 二",
      "content": [
        "春来新插翠云钗，尚著云头踏殿鞋。",
        "欲得君王回一顾，争扶玉辇下金阶。"
      ],
      "author": {
        "id": 7086,
        "name": "王涯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 264573,
      "title": "宫词三十首 三",
      "content": [
        "五更初起觉风寒，香炷烧来夜已残。",
        "欲卷珠帘惊雪满，自将红烛上楼看。"
      ],
      "author": {
        "id": 7086,
        "name": "王涯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 264574,
      "title": "宫词三十首 四",
      "content": [
        "各将金锁锁宫门，院院青娥侍至尊。",
        "头白监门掌来去，问频多是最承恩。"
      ],
      "author": {
        "id": 7086,
        "name": "王涯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 264575,
      "title": "宫词三十首 五",
      "content": [
        "夜久盘中蜡滴稀，金刀剪起尽霏霏。",
        "传声总是君王唤，红烛台前著舞衣。"
      ],
      "author": {
        "id": 7086,
        "name": "王涯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 264576,
      "title": "宫词三十首 六",
      "content": [
        "筝翻禁曲觉声难，玉柱皆非旧处安。",
        "记得君王曾道好，长因下辇得先弹。"
      ],
      "author": {
        "id": 7086,
        "name": "王涯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 264577,
      "title": "宫词三十首 七",
      "content": [
        "一丛高鬓绿云光，官样轻轻淡淡黄。",
        "为看九天公主贵，外边争学内家装。"
      ],
      "author": {
        "id": 7086,
        "name": "王涯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 264578,
      "title": "宫词三十首 八",
      "content": [
        "宜春院里驻仙舆，夜宴笙歌总不如。",
        "传索金笺提宠号，镫前御笔与亲书。"
      ],
      "author": {
        "id": 7086,
        "name": "王涯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 264579,
      "title": "宫词三十首 九",
      "content": [
        "永巷重门渐半开，宫官著锁隔门回。",
        "谁知曾笑他人处，今日将身自入来。"
      ],
      "author": {
        "id": 7086,
        "name": "王涯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 264580,
      "title": "宫词三十首 十",
      "content": [
        "春风帘里旧青娥，无奈新人夺宠何。",
        "寒食禁花开满树，玉堂终日闭时多。"
      ],
      "author": {
        "id": 7086,
        "name": "王涯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 264581,
      "title": "宫词三十首 十一",
      "content": [
        "碧绣簷前柳散垂，守门宫女欲攀时。",
        "曾经玉辇从容处，不敢临风折一枝。"
      ],
      "author": {
        "id": 7086,
        "name": "王涯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 264582,
      "title": "宫词三十首 十二",
      "content": [
        "鸦飞深在禁城墙，多绕重楼复殿傍。",
        "时向春簷瓦沟上，散开朝翅占朝光。"
      ],
      "author": {
        "id": 7086,
        "name": "王涯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 264583,
      "title": "宫词三十首 十三",
      "content": [
        "白雪猧儿拂地行，惯眠红毯不曾惊。",
        "深宫更有何人到，只晓金阶吠晚萤。"
      ],
      "author": {
        "id": 7086,
        "name": "王涯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 264584,
      "title": "宫词三十首 十四",
      "content": [
        "百尺仙梯倚阁边，内人争下掷金钱。",
        "风来竞看铜乌转，遥指朱干在半天。"
      ],
      "author": {
        "id": 7086,
        "name": "王涯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 264585,
      "title": "宫词三十首 十五",
      "content": [
        "春风摆荡禁花枝，寒食秋千满地时。",
        "又落深宫石渠里，尽随流水入龙池。"
      ],
      "author": {
        "id": 7086,
        "name": "王涯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 264586,
      "title": "宫词三十首 十六",
      "content": [
        "墙墙不断接宫城，金榜皆书殿院名。",
        "万转千回相隔处，各调弦管对闻声。"
      ],
      "author": {
        "id": 7086,
        "name": "王涯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 264587,
      "title": "宫词三十首 十七",
      "content": [
        "霏霏春雨九重天，渐暖龙池御柳烟。",
        "玉辇游时应不避，千廊万屋自相连。"
      ],
      "author": {
        "id": 7086,
        "name": "王涯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 264588,
      "title": "宫词三十首 十八",
      "content": [
        "禁门烟起紫沉沉，楼阁当中复道深。",
        "长入暮天凝不散，掖庭宫里动秋砧。"
      ],
      "author": {
        "id": 7086,
        "name": "王涯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 264589,
      "title": "宫词三十首 十九",
      "content": [
        "炎炎夏日满天时，桐叶交加覆玉墀。",
        "向晚移镫上银簟，丛丛绿鬓坐弹棋。"
      ],
      "author": {
        "id": 7086,
        "name": "王涯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 264590,
      "title": "宫词三十首 二十",
      "content": [
        "瞳瞳日出大明宫，天乐遥闻在碧空。",
        "禁树无风正和暖，玉楼金殿晓光中。"
      ],
      "author": {
        "id": 7086,
        "name": "王涯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 264591,
      "title": "宫词三十首 二十一",
      "content": [
        "迥出芙蓉阁上头，九天悬处正当秋。",
        "年年七夕晴光里，宫女穿针尽上楼。"
      ],
      "author": {
        "id": 7086,
        "name": "王涯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 264592,
      "title": "宫词三十首 二十二",
      "content": [
        "教来鹦鹉语初成，久闭金笼惯认名。",
        "总向春园看花去，独于深院笑人声。"
      ],
      "author": {
        "id": 7086,
        "name": "王涯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 264593,
      "title": "宫词三十首 二十三",
      "content": [
        "银瓶泻水欲朝妆，烛焰红高粉壁光。",
        "共怪满衣珠翠冷，黄花瓦上有新霜。"
      ],
      "author": {
        "id": 7086,
        "name": "王涯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 264594,
      "title": "宫词三十首 二十四",
      "content": [
        "迎风殿里罢云和，起听新蝉布浅莎。",
        "为爱九天和露滴，万年枝上最声多。"
      ],
      "author": {
        "id": 7086,
        "name": "王涯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 264595,
      "title": "宫词三十首 二十五",
      "content": [
        "御果收时属内官，傍簷低压玉阑干。",
        "明朝摘向金华殿，尽日枝边次第看。"
      ],
      "author": {
        "id": 7086,
        "name": "王涯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 264596,
      "title": "宫词三十首 二十六",
      "content": [
        "内里松香满殿闻，四行阶下暖氤氲。",
        "春深欲取黄金粉，绕树宫娥著绛裙。"
      ],
      "author": {
        "id": 7086,
        "name": "王涯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 264597,
      "title": "宫词三十首 二十七",
      "content": [
        "禁树传声在九霄，内中残火独遥遥。",
        "千官待取门犹闭，未到宫前下马桥。"
      ],
      "author": {
        "id": 7086,
        "name": "王涯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 266446,
      "title": "杂曲歌辞 太平乐",
      "content": [
        "风俗今和厚，君王在穆清。",
        "行看采花曲，尽是太阶平。"
      ],
      "author": {
        "id": 7086,
        "name": "王涯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 303840,
      "title": "宫词",
      "content": [
        "帘外微明烛下粧，殿明放锁待君王。",
        "玉阶地冷罗鞋薄，众里偷身倚玉床。",
        "（《分门纂类唐宋时贤千家诗选》卷十六）。"
      ],
      "author": {
        "id": 7086,
        "name": "王涯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 334214,
      "title": "郊庙歌辞：享惠昭太子庙乐章：送神",
      "content": [
        "威仪毕陈，备乐将阕。",
        "苞茅酒缩，膋萧香彻。",
        "宫臣展事，肃雍在列。",
        "迎精送往，厥鉴昭晰。"
      ],
      "author": {
        "id": 7086,
        "name": "王涯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 334572,
      "title": "相和歌辞：从军行三首",
      "content": [
        "旌甲从军久，风云识阵难。",
        "今朝韩信计，日下斩成安。",
        "燕颔多奇相，狼头敢犯边。",
        "寄言班定远，正是立功年。",
        "旄头夜落捷书飞，来奏金门著赐衣。",
        "白马将军频破敌，黄龙戍卒几时归。"
      ],
