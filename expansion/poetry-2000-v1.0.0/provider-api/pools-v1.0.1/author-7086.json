      }
    },
    {
      "id": 264558,
      "title": "塞下曲二首 一",
      "content": [
        "辛勤几出黄花戍，迢遰初随细柳营。",
        "塞晚每愁残月苦，边愁更逐断篷惊。"
      ],
      "author": {
        "id": 7086,
        "name": "王涯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 264559,
      "title": "塞下曲二首 二",
      "content": [
        "年少辞家从冠军，金妆宝劒去邀勋。",
        "不知马骨伤寒水，唯见龙城起暮云。"
      ],
      "author": {
        "id": 7086,
        "name": "王涯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 264560,
      "title": "平戎辞",
      "content": [
        "太白秋高助发兵，长风夜卷虏尘清。",
        "男儿解却腰间劒，喜见从王道化平。"
      ],
      "author": {
        "id": 7086,
        "name": "王涯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
