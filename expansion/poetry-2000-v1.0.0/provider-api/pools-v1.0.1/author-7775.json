  "items": [
    {
      "id": 16379,
      "title": "题翠岩寺",
      "content": [
        "秋风江上驻王师，暂向云山蹑翠微。",
        "忠义必期清塞水，功名直欲镇边圻。",
        "山林啸聚何劳取，沙漠群凶定破机。",
        "行复三关迎二圣，金酋席卷尽擒归。"
      ],
      "author": {
        "id": 7775,
        "name": "岳飞"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 16380,
      "title": "寄浮图慧海",
      "content": [
        "湓浦庐山几度秋，长江万折向东流。",
        "男儿立志扶王室，圣主专师灭虏酋。",
        "功业要刊燕石上，归休终伴赤松游。",
        "丁宁寄语东林老，莲社从此著力修。"
      ],
      "author": {
        "id": 7775,
        "name": "岳飞"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 16381,
      "title": "题青泥市萧寺壁",
      "content": [
        "雄气堂堂贯斗牛，誓将直节报君雠。",
        "斩除顽恶还车驾，不问登坛万户侯。"
      ],
      "author": {
        "id": 7775,
        "name": "岳飞"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 16382,
      "title": "送紫岩张先生北伐",
      "content": [
        "号令风霆迅，天声动北陬。",
        "长驱渡河洛，直捣向燕幽。",
        "马蹀阏氏血，旗枭克汗头。",
        "归来报明主，恢复旧神州。"
      ],
      "author": {
        "id": 7775,
        "name": "岳飞"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 16383,
      "title": "池州翠微亭",
      "content": [
        "经年尘土满征衣，特特寻芳上翠微。",
        "好山好水看不足，马蹄催趁月明归。"
      ],
      "author": {
        "id": 7775,
        "name": "岳飞"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 16384,
      "title": "游嵬石山寺",
      "content": [
        "嵬石山前寺，林泉胜景幽。",
        "紫金诸佛相，白雪老僧头。",
        "潭水寒生月，松风夜带秋。",
        "我来属龙语，为雨济民忧。"
      ],
      "author": {
        "id": 7775,
        "name": "岳飞"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 16385,
      "title": "过张溪赠张完",
      "content": [
        "无心买酒谒青春，对镜空嗟白发新。",
        "花下少年应笑我，垂垂羸马访高人。"
      ],
      "author": {
        "id": 7775,
        "name": "岳飞"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 16386,
      "title": "从驾游内苑应制",
      "content": [
        "敕报游西内，春光霭上林。",
        "花围千朵锦，柳撚万株金。",
        "燕绕龙旗舞，鶑随凤辇吟。",
        "君王多雨露，化育一人心。"
      ],
      "author": {
        "id": 7775,
        "name": "岳飞"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 16387,
      "title": "题骤马冈",
      "content": [
        "立马林冈豁战眸，阵云开处一溪流。",
        "机舂水沚犹传晋，黍秀宫庭孰悯周。",
        "南服只今歼小丑，北辕何日返神州。",
        "誓将七尺酬明圣，怒指天涯泪不收。"
      ],
      "author": {
        "id": 7775,
        "name": "岳飞"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 16388,
      "title": "题雩都华严寺",
      "content": [
        "手持竹节访黄龙，旧穴空遗虎子踪。",
        "云锁断崖无觅处，半山松竹撼秋风。"
      ],
      "author": {
        "id": 7775,
        "name": "岳飞"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 16389,
      "title": "题池州翠光寺",
      "content": [
        "爱此倚栏杆，谁同寓目闲。",
        "轻阴弄晴日，秀色隠空山。",
        "岛树萧疏外，征帆杳霭间。",
        "予虽江上老，心羡白云还。"
      ],
      "author": {
        "id": 7775,
        "name": "岳飞"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 16390,
      "title": "归赴行在过上竺寺偶题",
      "content": [
        "强胡犯金阙，驻跸大江南。",
        "二帝双魂杳，孤臣百战酣。",
        "兵威空朔漠，法力仗瞿昙。",
        "恢复山河日，捐躯分亦甘。"
      ],
      "author": {
        "id": 7775,
        "name": "岳飞"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 16391,
      "title": "送轸上人之庐山",
      "content": [
        "何处高人云路迷，相逢忽荐目前机。",
        "偶看菜叶随流水，知有茅茨在翠微。",
        "琐细夜谈皆可听，烟霏秋雨欲同归。",
        "翛然又向诸方去，无数山供玉麈挥。"
      ],
      "author": {
        "id": 7775,
        "name": "岳飞"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 331229,
      "title": "小重山",
      "content": [
        "昨夜寒蛩不住鸣。",
        "惊回千里梦，已三更。",
        "起来独自绕阶行。",
        "人悄悄，帘外月胧明。",
        "白首为功名。",
        "旧山松竹老，阻归程。",
        "欲将心事付瑶琴。",
        "知音少，弦断有谁听。"
      ],
      "author": {
        "id": 7775,
        "name": "岳飞"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 331230,
      "title": "满江红",
      "content": [
        "怒发冲冠，凭阑处、潇潇雨歇。",
        "抬望眼、仰天长啸，壮怀激烈。",
        "三十功名尘与土，八千里路云和月。",
        "莫等闲、白了少年头，空悲切。",
        "靖康耻，犹未雪。",
        "臣子恨，何时灭。",
        "驾长车踏破，贺兰山缺。",
        "壮志饥餐胡虏肉，笑谈渴饮匈奴血。",
        "待从头、收拾旧山河，朝天阙。"
      ],
      "author": {
        "id": 7775,
        "name": "岳飞"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 331231,
      "title": "满江红",
      "content": [
        "遥望中原，荒烟外、许多城郭。",
        "想当年、花遮柳护，凤楼龙阁。",
        "万岁山前珠翠绕，蓬壶殿里笙歌作。",
        "到而今、铁骑满郊畿，风尘恶。",
        "兵安在，膏锋锷。",
        "民安在，填沟壑。",
        "叹江山如故，千村寥落。",
        "何日请缨提锐旅，一鞭直渡清河洛。",
        "却归来、再续汉阳游，骑黄鹤。"
      ],
      "author": {
        "id": 7775,
        "name": "岳飞"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
