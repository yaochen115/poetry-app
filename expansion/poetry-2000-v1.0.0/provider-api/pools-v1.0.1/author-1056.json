      ],
      "author": {
        "id": 1056,
        "name": "徐俯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 231897,
      "title": "句  其六二",
      "content": [
        "少不愁穷老岂愁。"
      ],
      "author": {
        "id": 1056,
        "name": "徐俯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 231898,
      "title": "句  其六三",
      "content": [
        "从吾所好烟波上。"
      ],
      "author": {
        "id": 1056,
        "name": "徐俯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 231899,
      "title": "句  其六四",
      "content": [
        "镜中老色日侵寻。"
      ],
      "author": {
        "id": 1056,
        "name": "徐俯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 231900,
      "title": "句  其六五",
      "content": [
        "镜中嬴得鬓成丝。"
      ],
      "author": {
        "id": 1056,
        "name": "徐俯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 231901,
      "title": "句  其六六",
      "content": [
        "临流谁复赋新诗。"
      ],
      "author": {
        "id": 1056,
        "name": "徐俯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 231902,
      "title": "句  其六七",
      "content": [
        "颇知鹤胫缘诗瘦，早弃鱼须伴我闲。"
      ],
      "author": {
        "id": 1056,
        "name": "徐俯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 231903,
      "title": "句  其六八",
      "content": [
        "向使不死贼，未必世能容。"
      ],
      "author": {
        "id": 1056,
        "name": "徐俯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 231904,
      "title": "句  其六九",
      "content": [
        "今时习主簿，还是鲁诸王。"
      ],
      "author": {
        "id": 1056,
        "name": "徐俯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 328344,
      "title": "念奴娇",
      "content": [
        "素光练静，照青山隐隐，修眉横绿。",
        "𫛛鹊楼高天似水，碧瓦寒生银粟。",
        "万丈辉光，奔云涌雾，飞过卢鸿屋。",
        "更无尘翳，皓然冷浸梧竹。",
        "因念鹤发仙翁，当时曾共赏，紫岩飞瀑。",
        "对影三人聊痛饮，一洗闲愁千斛。",
        "斗转参移，翻然归去，万里骑黄鹄。",
        "一川霜晓，叫云吹断横玉。"
      ],
      "author": {
        "id": 1056,
        "name": "徐俯"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 328345,
      "title": "浣溪沙",
      "content": [
        "章水何如颍水清。",
        "江山明秀发诗情。",
        "七言还我是长城。",
        "小小钿花开宝靥，纤纤玉笋见云英。",
        "十千名酒十分倾。"
      ],
      "author": {
        "id": 1056,
        "name": "徐俯"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 328346,
      "title": "虞美人",
      "content": [
        "梅花元自江南得。",
        "还醉江南客。",
        "雪中雨里为谁香。",
        "闻道数枝清笑、出东墙。",
        "多情宋玉还知否。",
        "梁苑无寻处。",
        "胭脂为萼玉为肌。",
        "却恨恼人桃杏、不同时。"
      ],
      "author": {
        "id": 1056,
        "name": "徐俯"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 328347,
      "title": "卜算子",
      "content": [
        "心空道亦空，风静林还静。",
        "卷尽浮云月自明，中有山河影。",
        "供养及修行。",
        "旧话成重省。",
        "豆爆生莲火里时，痛拨寒灰冷。"
      ],
      "author": {
        "id": 1056,
        "name": "徐俯"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 328348,
      "title": "卜算子",
      "content": [
        "天生百种愁，挂在斜阳树。",
        "绿叶阴阴占得春，草满莺啼处。",
        "不见生尘步。",
        "空忆如簧语。",
        "柳外重重叠叠山，遮不断、愁来路。"
      ],
      "author": {
        "id": 1056,
        "name": "徐俯"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 328349,
      "title": "卜算子",
      "content": [
        "清池过雨凉，暗有清香度。",
        "缥缈娉婷绝代歌，翠袖风中举。",
        "忽敛双眉去。",
        "总是关情处。",
        "一段江山一片云，又下阳台雨。"
      ],
      "author": {
        "id": 1056,
        "name": "徐俯"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 328350,
      "title": "鹧鸪天",
      "content": [
        "绿水名园不是村。",
        "淡妆浓笑两生春。",
        "笛中已自多愁怨，雨里因谁有泪痕。",
        "香旖旎，酒氤氲。",
        "多情生怕落纷纷。",
        "旧来好事浑如梦，年少风流付与君。"
      ],
      "author": {
        "id": 1056,
        "name": "徐俯"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 328351,
      "title": "鹧鸪天",
      "content": [
        "满眼纷纷恰似花。",
        "飘飘泊泊自天涯。",
        "雨中添得无穷湿，风里吹成一道斜。",
        "银作屋，玉为车。",
        "姮娥青女过人家。",
        "应嫌素面微微露，故着轻云薄薄遮。"
      ],
      "author": {
        "id": 1056,
        "name": "徐俯"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 328352,
      "title": "踏莎行",
      "content": [
        "素景将阑，黄花初笑。",
        "登高一望秋天杳。",
        "邀宾携妓数能来，醉中赢得闲多少。",
        "佳气氤氲，飞云缥缈。",
        "竹林更着清江绕。",
        "高歌屡舞莫催人，华筵直待华灯照。"
