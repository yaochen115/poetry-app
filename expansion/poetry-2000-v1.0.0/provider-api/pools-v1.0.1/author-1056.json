        "name": "其他"
      }
    },
    {
      "id": 231895,
      "title": "句  其六○",
      "content": [
        "篱落寒梅三两枝。"
      ],
      "author": {
        "id": 1056,
        "name": "徐俯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
