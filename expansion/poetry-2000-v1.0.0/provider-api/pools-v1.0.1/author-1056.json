        "name": "其他"
      }
    },
    {
      "id": 231891,
      "title": "句  其五六",
      "content": [
        "故人特地为咨嗟。"
      ],
      "author": {
        "id": 1056,
        "name": "徐俯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 231892,
      "title": "句  其五七",
      "content": [
