    {
      "id": 265827,
      "title": "郡斋三月下旬作",
      "content": [
        "春事日已歇，池塘旷幽寻。",
        "残红披独坠，嫩绿间浅深。",
        "偃仰卷芳褥，顾步爱新阴。",
        "谋春未及竟，夏初遽见侵。"
      ],
      "author": {
        "id": 5949,
        "name": "崔护"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265828,
      "title": "五月水边柳",
      "content": [
        "结根挺涯涘，垂影覆清浅。",
        "睡脸寒未开，嬾腰晴更软。",
        "摇空条已重，拂水带方展。",
        "似醉烟景凝，如愁月露泫。",
        "丝长鱼悮恐，枝弱禽惊践。",
        "长别几多情，含春任攀搴。"
      ],
      "author": {
        "id": 5949,
        "name": "崔护"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 265829,
      "title": "三月五日陪裴大夫泛长沙东湖",
      "content": [
        "上巳余风景，芳辰集远坰。",
        "彩舟浮泛荡，绣毂下娉婷。",
        "林树回葱蒨，笙歌入杳冥。",
        "湖光迷翡翠，草色醉蜻蜓。",
        "鸟弄桐花日，鱼翻谷雨萍。",
        "从今留胜会，谁看画兰亭。"
      ],
      "author": {
        "id": 5949,
        "name": "崔护"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 265830,
      "title": "山鸡舞石镜",
      "content": [
        "庐峰开石镜，人说舞山鸡。",
        "物象纤舞隐，禽情秖自迷。",
        "景当烟雾歇，心喜锦翎齐。",
        "宛转乌呈彩，婆娑凤欲栖。",
        "何言资羽族，在地得天倪。",
        "应笑翰音者，终朝饮败醯。"
      ],
      "author": {
        "id": 5949,
        "name": "崔护"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 265831,
      "title": "题都城南庄",
      "content": [
        "去年今日此门中，人面桃花相映红。",
        "人面不知何处在，桃花依旧笑春风。"
      ],
      "author": {
        "id": 5949,
        "name": "崔护"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 265832,
      "title": "晚鸡",
      "content": [
        "黯黯严城罢鼓鼙，数声相续出寒栖。",
        "不嫌惊破纱窗梦，却恐为奴半夜啼。"
      ],
      "author": {
        "id": 5949,
        "name": "崔护"
      },
      "dynasty": {
