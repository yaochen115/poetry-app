{
  "data": [
    {
      "id": 187943,
      "title": "送仲宝叔赴秦幕",
      "content": [
        "秦关千古有雄名，秦地宁时息战争。",
        "草野英雄无敌国，朝廷勋德倚长城。",
        "锦纒红帕将军府，紫电清霜武库兵。",
        "绝幕烽烟沉远候，太平金鼓杂讙声。",
        "淮西司马新恩重，鲁国儒生旧望清。",
        "黑胆赤心男子事，大弨长剑丈夫行。",
        "待垂贾谊言余饵，就试终军请去缨。",
        "纵不首传函报死，亦须颈系背笞生。",
        "当年功业鲸鲵尽，振古勋名日月明。",
        "莫叹暂从红幕去，待于归望碧幢迎。",
        "愚时若忝书功笔，未信燕然有旧铭。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 187944,
      "title": "从光师求花",
      "content": [
        "我有归心不可寛，忆君花好旧常欢。",
        "若令醉眼异乡见，定作故人相笑看。",
        "知有灵根分客易，却忧平地得春难。",
        "只应胡蝶还相识，飞过东风又可叹。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 187945,
      "title": "九日寄满子权",
      "content": [
        "懒将衰病照清流，为有归心欲白头。",
        "幸自好花开便笑，不甘为客见成愁。",
        "长歌欲强秋风醉，髙处先输俗子游。",
        "我在无聊元亮死，当年今日共悠悠。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 187946,
      "title": "上黄任道",
      "content": [
        "家世无双旧，材资第一良。",
        "山川储地秀，日月合天光。",
        "远色抵千古，洪声压四方。",
        "道如天未丧，子让世谁当。",
        "文斧摩空运，儒工缩手藏。",
        "镕金斥淄石，截玉出端刚。",
        "追复轩羲旧，裨缝典诰亡。",
        "夸传争噍噍，问望蔚堂堂。",
        "章甫通期冠，缁裘讵合裳。",
        "计量遗丈引，收取竟寻常。",
        "有渐虽宜贺，论才固在伤。",
        "偶来官簿版，何异任牛羊。",
        "客有装垂槖，时穷道括囊。",
        "贫才完竖褐，义不及妻糠。",
        "剑折终羞屈，兰移不改香。",
        "幸偷容足地，耻学及羮墙。",
        "同日如无善，当年尚取狂。",
        "互乡前事在，北面有先望。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 187947,
      "title": "答满子权兼简衡父",
      "content": [
        "君唱奈髙何，君休我试歌。",
        "古今愚智府，天地是非罗。",
        "何日功名就，青云日月磨。",
        "俗儿吾不较，计此竟谁多。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 187948,
      "title": "寄满粹翁",
      "content": [
        "心爱满夫子，论师不敢交。",
        "诚明大中性，二五老阳爻。",
        "后学谁思进，吾蒙久辱包。",
        "思之无见日，梦把客门敲。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 187949,
      "title": "寄满衡父",
      "content": [
        "寒叶落傞傞，荆榛刺出柯。",
        "四邻松竹少，晚歳雪霜多。",
        "兹世居无可，劳生计奈何。",
        "此心须见子，不敢向人歌。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 187950,
      "title": "多阴",
      "content": [
        "寒云惨四垂，万景浩成悲。",
        "白日不可见，青天自取欺。",
        "晚烟先夜色，宿雨借寒威。",
        "泥潦莫相涴，西风会有时。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 187951,
      "title": "次韵立之红叶",
      "content": [
        "雨露三春少，风霜一夜多。",
        "从来有根本，不怕下枝柯。",
        "楚岸枫相属，吴山橘与和。",
        "秋居好相慰，醉色伴吾酡。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 187952,
      "title": "闻富并州入相",
      "content": [
        "元首赓歌乐股肱，四方强远喜声盈。",
        "忠贤不死天心在，辅弼终归圣虑精。",
        "中国自今应更重，本朝前日可嗟轻。",
        "要须待见成尧舜，未敢轻浮作颂声。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 187953,
      "title": "寄黄任道",
      "content": [
        "劳生滚滚欲何如，去髪纷纷日满梳。",
        "万古圣贤同梦寐，百年天地只蘧蒢。",
        "诗书计出田园后，岁月期收道路余。",
        "安得优游似濠上，共将谈笑戏观鱼。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 187954,
      "title": "答刘仲美",
      "content": [
        "多谢刘夫子，殷懃寄我编。",
        "何时共杯酒，一笑似当年。",
        "岁月回霜雪，生涯废简编。",
        "终期收晚学，茅屋送归田。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 187955,
      "title": "舟次",
      "content": [
        "梢梢修竹夹溪斜，树系孤篷白浅沙。",
        "风力引云行玉马，水光流月动金蛇。",
        "村酤客聚还成市，晚钓舟横便当家。",
        "山野生涯本闲暇，谁令客子自劳嗟。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 187956,
      "title": "次韵子权京口夜宿见寄",
      "content": [
        "寒江漠漠客帆稀，独泊扁舟望翠微。",
        "巳泻绿醽聊自适，更邀白鸟共忘机。",
        "水闲海月寒初上，树尽秋城碧自围。",
        "嗟我相思邈千里，不来同此两忘归。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 187957,
      "title": "答孙莘老见寄",
      "content": [
        "髙门鞍马日光荣，势力纷纷起共争。",
        "偶以不能聊自便，敢于兹世独求清。",
        "生无人愧宁非乐，死有天知岂待名。",
        "客食官居同是苟，何须称别异平生。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 187958,
      "title": "登郡楼",
      "content": [
        "江城朝雨湿晴烟，楼上风帆送去船。",
        "苟得息肩闲岁月，时来开口笑山川。",
        "田园啼鸟三春月，江海扁舟万里天。",
        "何计脱身来此老，青山白髪两忘年。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 187959,
      "title": "感愤",
      "content": [
        "二十男儿面似冰，出门嘘气玉蜺横。",
        "未甘身世成虚老，大见天心却太平。",
        "狂去诗浑夸俗句，醉余歌有过人声。",
        "燕然未勒胡雏在，不信吾无万古名。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 187960,
      "title": "闻邕盗",
      "content": [
        "病中双泪语前流，藜藿无端肉食忧。",
        "常叹平时轻死士，未知谁手付天矛。",
        "好将弓剑随军去，况是英雄得志秋。",
        "若使班超终把笔，由来何路取封侯。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 187961,
      "title": "登瓜州迎波亭",
      "content": [
        "海面清风万里寛，偶来知已脱尘关。",
        "自嗟客世无虚日，却被斜阳占尽山。",
        "海鸟不来青嶂静，渔师归去暮江闲。",
        "从来云水有期约，直待功成是厚颜。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 187962,
      "title": "闻雁",
      "content": [
        "可怜饮啄镇随阳，何处闻时最断肠。",
        "万里波涛九秋后，五更风雨一灯旁。",
        "乾坤莽莽连舟楫，缯缴纷纷羃稻梁。",
        "安得人同覊旅意，悠悠南北不相伤。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 187963,
      "title": "忆润州葛使君",
      "content": [
        "六朝游观委蒿蓬，想像当时事已空。",
        "半夜楼台横海日，万家箫鼓过江风。",
        "金山寺近尘埃绝，鐡瓮城深气象雄。",
        "欲放船随明月去，应留闲暇待诗翁。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 187964,
      "title": "何处难忘酒十首  其一",
      "content": [
        "何处难忘酒，君臣草昧初。",
        "谋臣偷贼胆，力士斡凶锄。",
        "日月明将霁，乾坤害欲除。",
        "此时无一盏，何以壮雄图。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 187965,
      "title": "何处难忘酒十首  其二",
      "content": [
        "何处难忘酒，天心渇太平。",
        "焚山急贤出，拔草恶奸生。",
        "议尽刍荛口，歌回雅颂音。",
        "此时无一盏，何以快舆情。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 187966,
      "title": "何处难忘酒十首  其三",
      "content": [
        "何处难忘酒，登贤入用初。",
        "一身兼禹稷，四海再唐虞。",
        "去圣千年恨，明时一日舒。",
        "此时无一盏，何以酹亨衢。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 187967,
      "title": "何处难忘酒十首  其四",
      "content": [
        "何处难忘酒，王朝四海中。",
        "鱼鸢上下乐，羌狄朔南通。",
        "万玉丛丹陛，千簪合辟廱。",
        "此时无一盏，何以乐成功。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 187968,
      "title": "何处难忘酒十首  其五",
      "content": [
        "何处难忘酒，君王宴豫年。",
        "群谋安一统，无口议将然。",
        "闲暇开元后，优游大业前。",
        "此时无一盏，何以慰遗贤。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 187969,
      "title": "何处难忘酒十首  其六",
      "content": [
        "何处难忘酒，王臣立荩方。",
        "群邪终自直，万死不摧刚。",
        "社鼠旁难塞，龙鳞逆易伤。",
        "此时无一盏，何以洗忧肠。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 187970,
      "title": "何处难忘酒十首  其七",
      "content": [
        "何处难忘酒，穷边壮士歌。",
        "寒弓弯未试，秋剑拔新磨。",
        "月落阴山暗，沙昏伏甲多。",
        "此时无一盏，何以陷前戈。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 187971,
      "title": "何处难忘酒十首  其八",
      "content": [
        "何处难忘酒，欃枪世不平。",
        "孤儿未胜甲，孀母送为兵。",
        "气绝心肝裂，号穷血泪横。",
        "此时无一盏，何以活余生。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 187972,
      "title": "何处难忘酒十首  其九",
      "content": [
        "何处难忘酒，穷才世不知。",
        "出门无直道，开口碍当时。",
        "白髪无端速，青山不忍期。",
        "此时无一盏，何以慰忧思。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 187973,
      "title": "何处难忘酒十首  其一○",
      "content": [
        "何处难忘酒，亡君复旧游。",
        "黍离经故国，麦秀悼前羞。",
        "远目何胜尽，行车逆自留。",
        "此时无一盏，何以谢悠悠。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 187974,
      "title": "送钱公辅赴举",
      "content": [
        "广庭簪绂立差肩，黼坐雍容第众贤。",
        "士得采衣如昼锦，人瞻归马若天仙。",
        "况提巨笔乘时出，应有髙文与世传。",
        "我久疏慵无壮思，聊倾病耳待江边。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 187975,
      "title": "春兴",
      "content": [
        "眼前红绿日加增，欲遣春愁兴未能。",
        "安得好花浑自实，使无闲地得生荆。",
        "欲图长醉贫无计，起逐东风懒不胜。",
        "芳草斜阳正柔媚，益知髙处不堪登。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 187976,
      "title": "庭草  其一",
      "content": [
        "庭草绿毰毸，庭花闲自开。",
        "长鸿抱寒去，轻燕逐春来。",
        "时节看风柳，生涯寄酒杯。",
        "伤春欲谁语，游子正徘徊。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 187977,
      "title": "庭草  其二",
      "content": [
        "平时已多病，春至更蹉跎。",
        "恶土种花少，东风生草多。",
        "客愁浑寄泪，野思不堪歌。",
        "独有诗心在，时时一自哦。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 187978,
      "title": "春怨",
      "content": [
        "扫地待花落，惜花轻着尘。",
        "游人空眷恋，踏去却寻春。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 187979,
      "title": "春晚二首  其一",
      "content": [
        "春来还自有游人，常是春归独念春。",
        "落后见花尤更惜，不知谁忍扫和尘。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 187980,
      "title": "春晚二首  其二",
      "content": [
        "三月残花落更开，小簷日日燕飞来。",
        "子规夜半犹啼血，不信东风唤不回。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 187981,
      "title": "暑中懒出",
      "content": [
        "暑云无雨易飞扬，旱日当天不可望。",
        "浪走俗尘无远到，不如嘉树坐余凉。",
        "巳嫌风少难平暑，更被蝉饥取实肠。",
        "梦到周公才我事，如何陶令说羲皇。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 187982,
      "title": "暑热思风",
      "content": [
        "坐将赤热忧天下，安得清风借我曹。",
        "力卷雨来无岁旱，尽吹云去放天髙。",
        "岂随虎口令轻啸，愿助鸿毛绝远劳。",
        "江海可怜无际岸，等闲假借作波涛。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 187983,
      "title": "悲秋",
      "content": [
        "岁事荒凉晚易悲，西风日夜弄寒威。",
        "秋来寡妇尤勤织，谁是行人未有衣。",
        "常恐衰颜随节换，空看落叶倚风飞。",
        "从来最是悲秋者，况是悲秋客未归。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 187984,
      "title": "秋日寄满子权",
      "content": [
        "楼前暮霭暗平林，楼上人愁意思深。",
        "未必薄云能作雨，从来秋日自多阴。",
        "三年客梦迷归路，一夜西风老壮心。",
        "欲作新声寄遗恨，直弦先断泪盈琴。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 187985,
      "title": "次韵介父冬日",
      "content": [
        "客梦愁生枕，鸡号喜向晨。",
        "朔风能动地，短日更随人。",
        "宫柳看埋冻，江梅想漏春。",
        "淹留归未得，尘土暗乌巾。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 187986,
      "title": "白鸡冠花",
      "content": [
        "如飞如舞对瑶台，一顶春云若剪裁。",
        "谁为移根蓂荚畔，玉鸡应为太平来。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 187987,
      "title": "去草",
      "content": [
        "毵毵出土初如直，袅袅随风竞自斜。",
        "漫借人锄劳刬拔，只消夜雨又萌芽。",
        "良田力尽农夫叹，直道春荒志士嗟。",
        "满目青青尽芜蔓，更于何处问蓬麻。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 187988,
      "title": "次韵和人古松",
      "content": [
        "直枝难立鸟徘徊，地瘦根孤碍石回。",
        "山野不逢终更老，闾阎无用始为材。",
        "更无匠伯身尝过，祗有幽人眼暂开。",
        "谁与东风记霜雪，争令平地肯栽培。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 187989,
      "title": "大松",
      "content": [
        "十寻瘦干三冬绿，一亩浓阴六月清。",
        "莫谓世材难见用，须知天意不徒生。",
        "长蛟老蜃空中影，骤雨惊雷半夜声。",
        "却笑五株乔岳下，肯将直节事秦嬴。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 187990,
      "title": "松",
      "content": [
        "直道峍峍日蚪拳，雷拔僵龙出霭烟。",
        "但假深根常得地，何忧直干不扶天。",
        "虽然世匠遗抡度，肯与凡材较后先。",
        "可惜春风爱桃李，独令霜雪漫年年。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 187991,
      "title": "和人双柏",
      "content": [
        "一时封植由谁力，万古樵莱偶自全。",
        "不惜以材同失地，好留更老共支天。",
        "人疑久有神灵守，客爱生无雨露偏。",
        "为语长松号孤劲，得秦封爵果何缘。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 187992,
      "title": "慈竹",
      "content": [
        "不求丹鳯食，不学景龙吟。",
        "自有慈仁意，相依岁月深。",
        "潜符君子道，可愧世人心。",
        "徒尔秋郊外，青青数亩阴。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 187993,
      "title": "落叶",
      "content": [
        "暮秋木落剥霜红，俄觉平林一夜空。",
        "茂遂本凭枝干力，却辞枝干逐西风。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 187994,
      "title": "不雨",
      "content": [
        "去岁秋霖若决川，今春不雨旱良田。",
        "道边老幼饥将死，云外蛟龙懒自眠。",
        "赤日有威空射地，清江无际漫连天。",
        "谁将民瘼牋双阙，四海皇恩一漏泉。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 187995,
      "title": "雨后",
      "content": [
        "毶毶柳色绿垂齐，草引青天去自迷。",
        "人说春园有寻路，我嗟荒径正行泥。",
        "蝶多平日浑如梦，花好谁家又有蹊。",
        "儿女狂娇随马逐，髙眠可惜日垂西。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 187996,
      "title": "约僧宿北山庵先寄平甫",
      "content": [
        "上人合动山间兴，吾恨衰迟学谢安。",
        "纳屐操笻那有限，吹云落雨漫无端。",
        "先凭报信春枝破，预想分题雪屋寒。",
        "林下不谙人世苦，笑将霜鬂与君看。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 187997,
      "title": "和人久雨",
      "content": [
        "拂拂春郊起绿烟，群农日日望丰年。",
        "龙移海去遗天漏，蚓得泥深乐地穿。",
        "忆酒有心吞俗价，伤春无语寄哀弦。",
        "无田却作无忧者，赢得丰凶一听天。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 187998,
      "title": "对月",
      "content": [
        "柳梢地面绝微风，一片寒光万里同。",
        "冰骨直疑潜里换，尘心都觉坐来空。",
        "蚌胎有露珠成颗，蟾窟无云玉作宫。",
        "莫怪幽人吟到晓，不知清兴自无穷。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 187999,
      "title": "夜月",
      "content": [
        "可嗟落日志悠然，便有群星出见天。",
        "夜月自明人自爱，不妨人亦闭门眠。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 188000,
      "title": "孤云",
      "content": [
        "一片孤云逐吹飞，东西终日竟何依。",
        "旁人莫道能为雨，惟恨青山未得归。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 188001,
      "title": "晚晴寄满子权",
      "content": [
        "常恐朝阴至夕曛，好风吹去信多勤。",
        "得逢白日忽开眼，可惜青天尚有云。",
        "安得植梯悬碧落，共操长帚扫妖氛。",
        "恨无玉纩充天耳，垤鹳鸣鸠愿不闻。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 188002,
      "title": "晚虹",
      "content": [
        "晚虹随雨过山巅，谁插青云倒挂悬。",
        "可惜两垂空到海，不令一直径冲天。",
        "不堪暮霭难相蔽，尝到斜阳亦可怜。",
        "好使渇来能剧饮，且教溪壑减清渊。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 188003,
      "title": "春城望湖",
      "content": [
        "春城绿野欝相望，闲客闲来兴自长。",
        "不见暮云成宿雨，空看芳草到斜阳。",
        "花生恶土终成笑，兰不逢人自信香。",
        "虽有尘缨无处濯，坐观渔者满沧浪。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 188004,
      "title": "楼上望湖",
      "content": [
        "楼上人肠渴欲枯，楼前终日望平湖。",
        "无舟得往沧浪去，为问渔人得意无。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 188005,
      "title": "江上",
      "content": [
        "羃羃江城没远烟，暮云归族忽相连。",
        "春江流水出天外，晚渡归舟下日边。",
        "杏蕚春深翻浅缬，柳花风远曳晴绵。",
        "无钱买得江头树，输与渔人系钓船。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 188006,
      "title": "野外",
      "content": [
        "绿野爱平寛，偶来或永叹。",
        "村儿骇车马，野犬吠衣冠。",
        "乱草无闲地，斜阳有去鞍。",
        "良田半蹊径，始信直行难。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 188007,
      "title": "暮归马上口占",
      "content": [
        "林密村村暗，寒鸦处处啼。",
        "水光连野白，雪意逐云低。",
        "风劲童呵指，泥深马失蹄。",
        "客心兼暮色，归去两凄凄。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 188008,
      "title": "小酌",
      "content": [
        "平生从事漫徒劳，时以休闲近酒醪。",
        "东海可从谁自重，南山如与客争髙。",
        "老将日月来双鬂，生委乾坤寄一毛。",
        "更展韦编探万绝，懒从人世问滔滔。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 188009,
      "title": "余杭倦游",
      "content": [
        "醉倚秋风笑自攻，偶来还去竟何踪。",
        "已夫鳯鸟今不至，行矣鳣鲸非所容。",
        "且把心胸同伏虎，谁知头角是真龙。",
        "归乎伊亩殊难得，死尔西山尚有从。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 188010,
      "title": "送和秘校",
      "content": [
        "野客从谁忽解颜，乐闻髙论厌樊间。",
        "致身富贵时宁少，仕道功名古亦艰。",
        "好说青山从我老，当分白日与君闲。",
        "扁舟闻说明朝别，何日音书可到山。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 188011,
      "title": "送聱隅黄先生",
      "content": [
        "黄风吹土截天横，瘦马着鞭驱不行。",
        "尚说苦心酬直道，谁知白髪为苍生。",
        "平时夷虏恬忠荩，常日公卿足仰成。",
        "虽有英雄无用处，却令老去买牛耕。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 188012,
      "title": "送周器之归润再索",
      "content": [
        "何须别子始沾衣，久有江南去梦飞。",
        "为语青山幸相望，壮夫终不白头归。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 188013,
      "title": "送庭老罢尉金坛",
      "content": [
        "心无畦畛见天真，落落男儿七尺身。",
        "莫叹一官淹圣代，聊将三釡慰慈亲。",
        "月明空照居民侣，风急随飘去马尘。",
        "寂寞西轩人别后，海棠花好为谁春。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 188014,
      "title": "送李廷尉濠梁",
      "content": [
        "直道无适可，小官真漫论。",
        "夫君自行义，而我更何言。",
        "独柱难为力，横流不奈浑。",
        "此心持送子，饮泪当前樽。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 188015,
      "title": "送束徽之入京",
      "content": [
        "出处身之道，穷通命有时。",
        "九门无直谒，千里去何为。",
        "南亩春耕近，西风去马羸。",
        "白云况多恨，归计莫令迟。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 188016,
      "title": "别陈药院",
      "content": [
        "客居平日有谁亲，一别三年百病身。",
        "为道难言轻感慨，羡君无病更医人。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 188017,
      "title": "寄介甫",
      "content": [
        "天门廉陛鬰巍巍，势利宁无淡泊讥。",
        "谁与跖徒争有道，好思吾党共言归。",
        "古人踽踽今何取，天下滔滔昔已非。",
        "终见乘桴去沧海，好留余地许相依。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 188018,
      "title": "奉寄黄任道",
      "content": [
        "蒿莱日日没幽居，时得新诗亦自娱。",
        "为有远怀希稷卨，或时飞梦见唐虞。",
        "久谙末俗难谋道，益厌庸儿妄问儒。",
        "绝笔断弦无意寄，笑将远目睨清虚。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 188019,
      "title": "奉寄朱昌叔",
      "content": [
        "劳劳忽忽欲谁从，要有田园去自终。",
        "衰俗未知谁得失，古风期与子穷通。",
        "三年客兴看秋叶，万里归心寄断蓬。",
        "知有世嘲无意解，自惭疏懒甚扬雄。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 188020,
      "title": "到润望竹林寺忆朱昌叔",
      "content": [
        "常与幽人过竹林，重来无地豁烦襟。",
        "青山欲去谁堪语，薄俗相期不到心。",
        "何计江湖终隐钓，去随鱼鸟共飞沉。",
        "尘埃闻说难为客，早晚归来忆旧吟。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 188021,
      "title": "奉寄伯兄泰伯",
      "content": [
        "心迹牵覊逐势分，一生襟抱向谁论。",
        "十年漂泊迷南北，千里忧思厌梦魂。",
        "书托远怀期日月，眼和衰泪望乾坤。",
        "何时得就归来赋，老守桑麻聚一门。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 188022,
      "title": "奉寄崔伯易",
      "content": [
        "功业尝闻亦有时，可能天命出依违。",
        "终看世态真何道，不得吾心自合归。",
        "廊庙得逢应有义，草茅虽老尚知非。",
        "秋来客况无他异，时向西风诵式微。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 188023,
      "title": "寄满子权二首  其一",
      "content": [
        "窗前午枕梦忘还，门外清风昼掩关。",
        "天下谁当千古后，床头自笑六经闲。",
        "能将道系穷通里，安用身居进退间。",
        "自愧公心犹有蔽，清时无日不思山。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 188024,
      "title": "寄满子权二首  其二",
      "content": [
        "终年谋食亦何得，浪取穷愁只自侵。",
        "饿死有时非正命，劳生几不愧常心。",
        "百年此去尘埃在，万古从来意思深。",
        "莫说山林是轻往，穷来无计得山林。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 188025,
      "title": "寄李君厚",
      "content": [
        "一笑东风去十年，重来稚子已差肩。",
        "脱衣呼客家声旧，把酒论心士气全。",
        "病骥远思牵直道，老鹰秋梦入青天。",
        "自言出处身无累，一把穷通寄自然。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 188026,
      "title": "寄满粹翁",
      "content": [
        "满子吾逢久，皇皇未见闲。",
        "老成终到孔，穷死亦为颜。",
        "学术思无际，诚明去一间。",
        "吾虽有心者，力苦未能攀。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 188027,
      "title": "强颜寄任道子权",
      "content": [
        "强颜求世亦何从，甔石时时得复空。",
        "何日能无寒饿役，此身得与圣贤终。",
        "人生汲汲须髙致，世态浑浑未易穷。",
        "安得相逢共相语，荒城回首又春风。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 188028,
      "title": "招夏和叔",
      "content": [
        "矻矻雕镌役俗儿，六经尘土有谁吹。",
        "我追往圣思前躅，子苟安行即后时。",
        "大遇定为当世福，不逢犹作后来师。",
        "思量最是男儿事，此外吾曹不足期。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 188029,
      "title": "赠崔伯易",
      "content": [
        "巉岩恶面插苍须，中道时时自笑呼。",
        "但怪佯狂轻去俗，果闻髙论足开余。",
        "恶看富贵庸男子，喜见徜徉隐丈夫。",
        "我是自髙无许可，今朝为子一长吁。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 188030,
      "title": "赠裴仲卿",
      "content": [
        "匣剑光芒射斗牛，持携天下洗人仇。",
        "英雄心胆老犹壮，道路风尘行未休。",
        "名重更须完小节，义高何必论闲愁。",
        "蒙蒙细雨陵阳市，折取重梅上酒楼。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 188031,
      "title": "寄都下二三子失举二首  其一",
      "content": [
        "翘翘数子拔群伦，落笔文章妙有神。",
        "清世暂时藏琬琰，红尘终不卧麒麟。",
        "淹留京国三年客，牢落江河一病身。",
        "得丧穷通虽付命，双眸忍泪已沾巾。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 188032,
      "title": "寄都下二三子失举二首  其二",
      "content": [
        "太学虀盐共苦辛，寒窗笔砚日相亲。",
        "梁王台畔一分袂，扬子江头三换春。",
        "箧里黄金须买酒，髩边白髪解欺人。",
        "穷通得丧谁能定，况是男儿有此身。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 188033,
      "title": "李南夫罢举归隐",
      "content": [
        "梦寐风仪近十年，尘埃无路覩云天。",
        "清朝未得荣簪绂，黄卷何妨乐圣贤。",
        "物外髙情谁与共，人间佳句已争传。",
        "欲知富贵终难动，一片丹心本寂然。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 188034,
      "title": "甫里",
      "content": [
        "甫里先生得古风，放身全入隐沦中。",
        "足磨汉榻星辰动，笔挫吴天物象空。",
        "往事欲寻人寂寂，旧田安在雨蒙蒙。",
        "当时引重髙才者，谁是曾来一亩宫。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 188035,
      "title": "次韵朱昌叔见赠",
      "content": [
        "虽无才学可人群，偶有诚心与古亲。",
        "兹世几人能永富，此身何恤不终贫。",
        "生无簪绶身宁屈，死有诗书志尚伸。",
        "自匪与君尝素计，斯言何敢易谋人。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 188036,
      "title": "次韵满子权见寄",
      "content": [
        "当世雄图不可怀，退居蒿艾自沉埋。",
        "门无来足荆生道，病不能锄草上阶。",
        "自是直方违世易，况将疏懒合人乖。",
        "无由与子同樵种，回首平林浪可柴。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 188037,
      "title": "和束熙之论旧",
      "content": [
        "当年龆龀偶同门，糊口重来已十春。",
        "仰叹早成浑属子，始知老拙尽输人。",
        "火烟论友劳薫灼，桂蘗为生合苦辛。",
        "待看圣贤堂奥去，愿持箕帚扫遗尘。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 188038,
      "title": "谢束丈",
      "content": [
        "喜赴西招足屡蹉，自惭愚鄙取无他。",
        "能终未学生何幸，得活诸孤赐最多。",
        "愧面未甘徒已矣，报心全寄命如何。",
        "须知下客终思用，不必时时弹铗歌。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 188039,
      "title": "答许勤之",
      "content": [
        "不作明堂柱石臣，要当归去老江滨。",
        "不知何处田堪买，抛却浮生一片尘。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 188040,
      "title": "答刘成父四愁诗",
      "content": [
        "倦客维扬每自悲，有时双泪等闲垂。",
        "眼前所识皆庸我，天下为忧可语谁。",
        "把臂便嫌逢子晚，开縢乃见起予诗。",
        "卷舒万彻吟千遍，此后多应手有胝。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 188041,
      "title": "谢成父",
      "content": [
        "旧说诗无三百年，于今拭目读君篇。",
        "已嗟吾道微如线，不意斯文未丧天。",
        "金玉有声情不俗，蕙兰之臭美尤全。",
        "尘埃满眼逢何晚，气类相期久合坚。",
        "以义求人今遂得，于心无愧果为贤。",
        "不须刺口论憔悴，吾辈恓惶自古然。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 188042,
      "title": "还萧几道诗卷",
      "content": [
        "武夷山骨插青冥，秀气中蟠产俊英。",
        "髙似君平于市隐，穷如东野以诗鸣。",
        "骅骝老骋青云足，绿绮纯含太古声。",
        "顾我自忧衰病久，为君双眼暂时明。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
