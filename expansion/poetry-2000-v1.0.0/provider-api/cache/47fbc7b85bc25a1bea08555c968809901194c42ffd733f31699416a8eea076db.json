{
  "data": [
    {
      "id": 275997,
      "title": "陪王尚书泛舟莲池",
      "content": [
        "莲塘移画舸，泛泛日华清。",
        "水暖鱼频跃，烟秋雁早鸣。",
        "舞疑回雪态，歌转遏云声。",
        "客散山公醉，风高月满城。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 275998,
      "title": "赠裴处士",
      "content": [
        "为儒白发生，乡里早闻名。",
        "煖酒雪初下，读书山欲明。",
        "字形翻鸟迹，诗调合猿声。",
        "门外沧浪水，知君欲濯缨。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 275999,
      "title": "对雪",
      "content": [
        "飞舞北风凉，玉人歌玉堂。",
        "帘帷增曙色，珠翠发寒光。",
        "柳重絮微湿，梅繁花未香。",
        "兹辰贺丰岁，箫鼓宴梁王。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276000,
      "title": "王居士",
      "content": [
        "筇杖倚柴关，都城卖卜还。",
        "雨中耕白水，云外𣃁青山。",
        "有药身长健，无机性自闲。",
        "即应生羽翼，华表在人间。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276001,
      "title": "早秋三首 一",
      "content": [
        "遥夜泛清瑟，西风生翠萝。",
        "残萤委玉露，早鴈拂银河。",
        "高树晓还密，远山晴更多。",
        "淮南一叶下，自觉老烟波。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276002,
      "title": "早秋三首 二",
      "content": [
        "一叶下前墀，淮南人已悲。",
        "蹉跎青汉望，迢遰白云期。",
        "老信相如渴，贫忧曼倩饥。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 276003,
      "title": "早秋三首 三",
      "content": [
        "蓟北雁犹远，淮南人已悲。",
        "残桃间堕井，新菊亦侵篱。",
        "书劒岂相误，琴尊聊自持。",
        "西斋风雨夜，更有咏贫诗。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276004,
      "title": "洛东兰若夜归",
      "content": [
        "一衲老禅床，吾生半异乡。",
        "管弦愁里老，书劒梦中忙。",
        "鸟急山初暝，蝉稀树正凉。",
        "又归何处去，尘路月苍苍。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276005,
      "title": "送段觉归杜曲闲居",
      "content": [
        "书劒南归去，山扉别几年。",
        "苔侵岩下路，果落洞中泉。",
        "红叶高斋雨，青萝曲槛烟。",
        "宁知远游客，羸马太行前。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276006,
      "title": "寄天乡寺仲仪上人富春孙处士",
      "content": [
        "诗僧与钓翁，千里两情通。",
        "云带鴈门雪，水连渔浦风。",
        "心期荣辱外，名挂是非中。",
        "岁晚亦归去，田园清洛东。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276007,
      "title": "寄契盈上人",
      "content": [
        "何处是西林，疎钟复远砧。",
        "鴈来秋水阔，鸦尽夕阳沈。",
        "婚嫁乖前志，功名异夙心。",
        "汤师不可问，江上碧云深。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276008,
      "title": "晨起二首 一",
      "content": [
        "桂树绿层层，风微烟露凝。",
        "簷楹衔落月，帏幌映残灯。",
        "蕲簟曙香冷，越瓶秋水澄。",
        "心闲即无事，何异住山僧。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276009,
      "title": "晨起二首 二",
      "content": [
        "残月皓烟露，掩门深竹斋。",
        "水虫鸣曲槛，山鸟下空阶。",
        "清镜晓看髪，素琴秋寄怀。",
        "因知北窗客，日与世情乖。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276010,
      "title": "晓发鄞江北渡寄崔韩二先辈",
      "content": [
        "南北信多岐，生涯半别离。",
        "地穷山尽处，江泛水寒时。",
        "露晓蒹葭重，霜晴橘柚垂。",
        "无劳促回檝，千里有心期。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276011,
      "title": "盈上人",
      "content": [
        "月沈霜已凝，无梦竟寒灯。",
        "寄世何殊客，修身未到僧。",
        "二毛梳上雪，双泪枕前冰。",
        "借问曹溪路，山多路几层。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276012,
      "title": "广陵道中",
      "content": [
        "城势已坡陀，城边东逝波。",
        "绿桑非苑树，青草是宫莎。",
        "山暝牛羊少，水寒凫鴈多。",
        "因高一回首，还咏黍离歌。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276013,
      "title": "宿开元寺楼",
      "content": [
        "谁家歌褭褭，孤枕在西楼。",
        "竹色寒清簟，松香染翠帱。",
        "月移珠殿晓，风遰玉筝秋。",
        "日出应移棹，三湘万里愁。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276014,
      "title": "洞灵观冬青",
      "content": [
        "霜霰不凋色，两株交石坛。",
        "未秋红实浅，经夏绿阴寒。",
        "露重蝉鸣急，风多鸟宿难。",
        "何如西禁柳，晴舞玉阑干。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276015,
      "title": "送友人自荆襄归江东",
      "content": [
        "商洛转江𣸣，一杯聊送君。",
        "劒愁龙失伴，琴怨鹤离群。",
        "楚驿枕秋水，湘帆凌暮云。",
        "猿声断肠夜，应向雨中闻。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 276016,
      "title": "送同年崔先辈",
      "content": [
        "西风帆势轻，南浦遍离情。",
        "菊艳含秋水，荷花遰雨声。",
        "扣舷滩鸟没，移棹草虫鸣。",
        "更忆前年别，槐花满凤城。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276017,
      "title": "山鸡",
      "content": [
        "珍禽暂不扃，飞舞跃前庭。",
        "翠网摧金距，雕笼减绣翎。",
        "月圆疑望镜，花暖似依屏。",
        "何必旧巢去，山山芳草青。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276018,
      "title": "孤鴈",
      "content": [
        "昔年双颉颃，池上霭春晖。",
        "霄汉力犹怯，稻粱心已违。",
        "芦洲寒独宿，榆塞夜孤飞。",
        "不及营巢燕，西风相伴归。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276019,
      "title": "寓怀",
      "content": [
        "南国浣纱伴，盈盈天下姝。",
        "盘金明绣带，动珮响罗襦。",
        "素手怨瑶瑟，清心悲玉壶。",
        "春华坐销落，未忍泣蘼芜。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276020,
      "title": "洛中游眺贻同志",
      "content": [
        "康衢一望通，河洛正天中。",
        "楼势排高凤，桥形架断虹。",
        "远山晴带雪，寒水晚多风。",
        "几日还携手，鸟鸣花满宫。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276021,
      "title": "夏日戏题郭别驾东堂",
      "content": [
        "微风起画鸾，金翠暗珊珊。",
        "晚树垂朱实，春篁露粉竿。",
        "散香蕲簟滑，沈水越瓶寒。",
        "犹恐何郎热，冰生白玉盘。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276022,
      "title": "长安旅夜",
      "content": [
        "久客怨长夜，西风吹鴈声。",
        "云移河汉浅，月泛露华清。",
        "掩瑟独凝思，缓歌空寄情。",
        "门前有归路，迢遰洛阳城。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276023,
      "title": "㶉𫛶",
      "content": [
        "池寒柳复凋，独宿夜迢迢。",
        "雨顶冠应冷，风毛劒欲飘。",
        "故巢迷碧水，旧侣越丹霄。",
        "不是无归处，心高多寂寥。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276024,
      "title": "懿安皇太后挽歌词",
      "content": [
        "陵前春不尽，陵下夜何穷。",
        "未信金蚕老，先惊玉燕空。",
        "挽移兰殿月，笳引柏城风。",
        "自此随龙驭，桥山翠霭中。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276025,
      "title": "示弟",
      "content": [
        "自尔出门去，泪痕长满衣。",
        "家贫为客早，路远得书稀。",
        "文字何人赏，烟波几日归。",
        "秋风正摇落，孤鴈又南飞。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276026,
      "title": "送杨处士叔初卜居曲江",
      "content": [
        "鴈门归去远，垂老脱袈裟。",
        "萧寺休为客，曹溪便寄家。",
        "绿琪千岁树，黄槿四时花。",
        "别怨应无限，门前桂水斜。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276027,
      "title": "发灵溪馆",
      "content": [
        "山多水不穷，一叶似渔翁。",
        "鸟浴寒潭雨，猿吟暮岭风。",
        "杂英垂锦绣，众籁合丝桐。",
        "应有曹溪路，千岩万壑中。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276028,
      "title": "题杜居士",
      "content": [
        "松偃石床平，何人识姓名。",
        "溪冰寒棹响，岩雪夜窗明。",
        "机尽心猿伏，神闲意马行。",
        "应知此来客，身世两无情。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276029,
      "title": "神女祠",
      "content": [
        "停车祀圣女，凉叶下阴风。",
        "龙气石床湿，鸟声山庙空。",
        "长眉留桂绿，丹脸寄莲红。",
        "莫学阳台畔，朝云暮雨中。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276030,
      "title": "送李定言南游",
      "content": [
        "酒酣轻别恨，酒醒复离忧。",
        "远水应移棹，高峰更上楼。",
        "簟凉清露夜，琴响碧天秋。",
        "重惜芳尊宴，满城无旧游。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276031,
      "title": "早发中岩寺别契直上人",
      "content": [
        "苍苍松桂阴，残月半西岑。",
        "素壁寒灯暗，红炉夜火深。",
        "厨开山鼠散，钟尽岭猿吟。",
        "行役方如此，逢师嬾话心。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276032,
      "title": "行次潼关题驿后轩",
      "content": [
        "飞阁极层台，终南此路回。",
        "山形朝阙去，河势抱关来。",
        "鴈过秋风急，蝉鸣宿雾开。",
        "平生无限意，驱马任尘埃。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276033,
      "title": "晨至南亭呈裴明府",
      "content": [
        "南斋梦钓竿，晨起月犹残。",
        "露重萤依草，风高蝶委兰。",
        "池光秋镜澈，山色晓屏寒。",
        "更恋陶彭泽，无心议去官。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276034,
      "title": "灞东题司马郊园",
      "content": [
        "楚翁秦塞住，昔事李轻车。",
        "白社贫思橘，青门老仰瓜。",
        "读书三迳草，沽酒一篱花。",
        "更欲寻芝术，商山便寄家。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276035,
      "title": "游维山新兴寺宿石屏村谢叟家",
      "content": [
        "晚过石屏村，村长日渐曛。",
        "僧归下岭见，人语隔溪闻。",
        "谷响寒耕雪，山明夜烧云。",
        "家家扣铜鼓，欲赛鲁将军。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276036,
      "title": "送从兄归隐蓝溪二首 一",
      "content": [
        "名高犹素衣，穷巷掩荆扉。",
        "渐老故人少，久贫豪客稀。",
        "塞云横劒望，山月抱琴归。",
        "几日蓝溪醉，藤花拂钓矶。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276037,
      "title": "送从兄归隐蓝溪二首 二",
      "content": [
        "京洛多高盖，怜兄剧断蓬。",
        "身随一劒老，家入万山空。",
        "夜忆萧关月，行悲易水风。",
        "无人知此意，甘卧白云中。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276038,
      "title": "村舍",
      "content": [
        "燕鴈下秋塘，田家自此忙。",
        "移蔬通远水，收果待繁霜。",
        "野碓舂秔滑，山厨焙茗香。",
        "客来还有酒，随事宿茅堂。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276039,
      "title": "思归",
      "content": [
        "叠嶂平芜外，依依识旧邦。",
        "气高诗易怨，愁极酒难降。",
        "树暗支公院，山寒谢守窗。",
        "殷勤楼下水，几日到荆江。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276040,
      "title": "晚泊七里滩",
      "content": [
        "天晚日沈沈，归舟系柳阴。",
        "江村平见寺，山郭远闻砧。",
        "树密猿声响，波澄鴈影深。",
        "荣华暂时事，谁识子陵心。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276041,
      "title": "寄题南山王隐居",
      "content": [
        "近逢商洛客，知尔住南塘。",
        "草阁平春水，柴门掩夕阳。",
        "随蜂收野蜜，寻麝采生香。",
        "更忆前年醉，松花满石床。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276042,
      "title": "晨装",
      "content": [
        "带月饭行侣，西游关塞长。",
        "晨鸡鸣远戍，宿鴈起寒塘。",
        "云卷四山雪，风凝千树霜。",
        "谁家游侠子，沈醉卧兰堂。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276043,
      "title": "题韦隐居西斋",
      "content": [
        "𣃁药去还归，家人半掩扉。",
        "山风藤子落，溪雨豆花肥。",
        "寺远僧来少，桥危客到稀。",
        "不闻砧杵动，应解制荷衣。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276044,
      "title": "送李溟秀才西行",
      "content": [
        "万里不辞劳，寒装叠缊袍。",
        "停车山店雨，挂席海门涛。",
        "鹰势暮偏急，鹤声秋更高。",
        "知君北邙路，留劒泣黄蒿。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276045,
      "title": "经马镇西宅",
      "content": [
        "将军久已没，行客自兴哀。",
        "功业山长在，繁华水不回。",
        "乱藤侵废井，荒菊上丛台。",
        "借问此中事，几家歌舞来。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276046,
      "title": "重游郁林寺道玄上人院",
      "content": [
        "藤杖叩松关，春溪𣃁药还。",
        "雨晴巢燕急，波暖浴鸥闲。",
        "倚槛花临水，回舟月照山。",
        "忆归师莫笑，书劒在人间。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276047,
      "title": "泛溪",
      "content": [
        "疑与武陵通，青溪碧嶂中。",
        "水寒深见石，松晚静闻风。",
        "遯迹驱鸡吏，冥心失马翁。",
        "才应毕婚嫁，还此息微躬。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276048,
      "title": "送楼烦李别驾",
      "content": [
        "琴清诗思劳，更欲学龙韬。",
        "王粲暂停笔，吕虔初佩刀。",
        "夜吟关月静，秋望塞云高。",
        "去去从军乐，雕飞代马豪。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276049,
      "title": "闻两河用兵因贻友人",
      "content": [
        "故人日已远，身事与谁论。",
        "性拙难趋世，心孤易感恩。",
        "秋悲怜宋玉，夜舞笑刘琨。",
        "徒有干时策，青山尚掩门。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276050,
      "title": "献白尹",
      "content": [
        "醉舞任生涯，褐宽乌帽斜。",
        "庾公先在郡，疎傅早还家。",
        "林晚鸟争树，园春蜂护花。",
        "高吟应更逸，嵩洛旧烟霞。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276051,
      "title": "茅山赠梁尊师",
      "content": [
        "云屋何年客，青山白日长。",
        "种花春扫雪，看箓夜焚香。",
        "上象壶中阔，平生梦里忙。",
        "幸承仙籍后，乞取大还方。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276052,
      "title": "闻薛先辈陪大夫看早梅因寄",
      "content": [
        "涧梅寒正发，莫信笛中吹。",
        "素艳雪凝树，清香风满枝。",
        "折惊山鸟散，携任野蜂随。",
        "今日从公醉，何人倒接䍠。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276053,
      "title": "送前缑氏韦明府南游",
      "content": [
        "酒阑横劒歌，日暮望关河。",
        "道直去官早，家贫为客多。",
        "山昏函谷雨，木落洞庭波。",
        "莫尽远游兴，故园荒薜萝。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276054,
      "title": "看雪",
      "content": [
        "松亚竹珊珊，心知万井欢。",
        "山明迷旧径，溪满涨新澜。",
        "客醉瑶台曙，兵防玉塞寒。",
        "红楼知有酒，谁肯学袁安。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276055,
      "title": "赠僧",
      "content": [
        "心法本无住，流沙归复来。",
        "锡随山鸟动，经附海船回。",
        "洗足柳遮寺，坐禅花委苔。",
        "唯将一童子，又欲上天台。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276056,
      "title": "趋慈和寺移宴",
      "content": [
        "高寺移清宴，渔舟系绿萝。",
        "潮平秋水阔，云歛暮山多。",
        "广槛停箫鼓，繁弦散绮罗。",
        "西楼半床月，莫问夜如何。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276057,
      "title": "留赠偃师主人",
      "content": [
        "孤城漏未残，徒侣拂征鞍。",
        "洛北去游远，淮南归梦阑。",
        "晓灯回壁暗，晴雪卷帘寒。",
        "强尽主人酒，出门行路难。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276058,
      "title": "送南陵李少府",
      "content": [
        "高人亦未闲，来往楚云间。",
        "劒在心应壮，书穷鬓已斑。",
        "落帆秋水寺，驱马夕阳山。",
        "明日南昌尉，空斋又掩关。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276059,
      "title": "别韦处士",
      "content": [
        "南北断蓬飞，别多相见稀。",
        "更伤今日酒，未换昔年衣。",
        "旧友几人在，故乡何处归？",
        "秦原向西路，云晚雪霏霏。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276060,
      "title": "九日登樟亭驿楼",
      "content": [
        "鲈鲙与蒪羹，西风片席轻。",
        "潮回孤岛晚，云歛众山晴。",
        "丹羽下高阁，黄花垂古城。",
        "因秋倍多感，乡树接咸京。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276061,
      "title": "再游越中伤朱余庆协律好直上人",
      "content": [
        "昔年湖上客，留访雪山翁。",
        "王氏船犹在，萧家寺已空。",
        "月高花有露，烟合水无风。",
        "处处多遗韵，何曾入剡中。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276062,
      "title": "京口津亭送张崔二侍御",
      "content": [
        "爱树满西津，津亭堕泪频。",
        "素车应度洛，珠履更归秦。",
        "水接三湘暮，山通五岭春。",
        "伤离与怀旧，明日白头人。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276063,
      "title": "江楼夜别",
      "content": [
        "离别奈情何，江楼凝艳歌。",
        "蕙兰秋露重，芦苇夜风多。",
        "深怨寄清瑟，远愁生翠蛾。",
        "酒酣相顾起，明月棹寒波。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276064,
      "title": "送惟素上人归新安",
      "content": [
        "山空叶复落，一迳下新安。",
        "风急渡溪晚，雪晴归寺寒。",
        "寻云策藤杖，向日倚蒲团。",
        "宁忆西游客，劳劳歌路难。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276065,
      "title": "霅上宴别",
      "content": [
        "山断水茫茫，洛人西路长。",
        "笙歌留远棹，风雨寄华堂。",
        "红壁耿秋烛，翠帘凝晓香。",
        "谁堪从此去，云树满陵阳。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276066,
      "title": "下第别友人杨至之",
      "content": [
        "花落水潺潺，十年离旧山。",
        "夜愁添白发，春泪减朱颜。",
        "孤劒北游塞，远书东出关。",
        "逢君话心曲，一醉灞陵间。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276068,
      "title": "放猿",
      "content": [
        "殷勤解金锁，昨夜雨凄凄。",
        "山浅忆巫峡，水寒思建溪。",
        "远寻红树宿，深向白云啼。",
        "好觅来时路，烟萝莫共迷。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276069,
      "title": "将离郊园留示弟姪",
      "content": [
        "身贱与心违，秋风生旅衣。",
        "久贫辞国远，多病在家稀。",
        "山暝客初散，树凉人未归。",
        "西都万余里，明旦别柴扉。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276070,
      "title": "夜归丁卯桥村舍",
      "content": [
        "月凉风静夜，归客泊岩前。",
        "桥响犬遥吠，庭空人散眠。",
        "紫蒲低水槛，红叶半江船。",
        "自有还家计，南湖二顷田。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276071,
      "title": "题青山馆",
      "content": [
        "昔人诗酒地，芳草思王孙。",
        "白水半塘岸，青山横郭门。",
        "悬岩碑已折，盘石井犹存。",
        "无处继行乐，野花空一尊。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276072,
      "title": "秋日众哲馆对竹",
      "content": [
        "萧萧凌雪霜，浓翠异三湘。",
        "疎影月移壁，寒声风满堂。",
        "卷帘秋更早，高枕夜偏长。",
        "忽忆秦溪路，万竿今正凉。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276073,
      "title": "春日题韦曲野老村舍二首 一",
      "content": [
        "遶屋遍桑麻，村南第一家。",
        "林繁树势直，溪转水纹斜。",
        "竹院昼看笋，药栏春卖花。",
        "故园归未得，到此是天涯。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276074,
      "title": "春日题韦曲野老村舍二首 二",
      "content": [
        "北岭枕南塘，数家村落长。",
        "莺啼幼妇嬾，蚕出小姑忙。",
        "烟草近沟湿，风花临路香。",
        "自怜非楚客，春望亦心伤。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276075,
      "title": "崇圣寺别杨至之",
      "content": [
        "萧寺暂相逢，离忧满病容。",
        "寒斋秋少燕，阴壁夜多蛩。",
        "树暗水千里，山深云万重。",
        "怀君在书信，莫过鴈回峰。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276076,
      "title": "途经李翰林墓",
      "content": [
        "气逸何人识，才高举世疑。",
        "祢生狂善赋，陶令醉能诗。",
        "碧水鲈鱼思，青山𫛳鸟悲。",
        "至今孤冢在，荆棘楚江湄。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276077,
      "title": "严陵钓台贻行侣",
      "content": [
        "故人天下定，垂钓碧岩幽。",
        "旧迹随台古，高名寄水流。",
        "鸟喧群木晚，蝉急众山秋。",
        "更待新安月，凭君暂驻舟。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276078,
      "title": "南楼春望",
      "content": [
        "南楼春一望，云水共昏昏。",
        "野店归山路，危桥带郭村。",
        "晴烟和草色，夜雨长溪痕。",
        "下岸谁家住，残阳半掩门。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276079,
      "title": "送无梦道人先归甘露寺",
      "content": [
        "飘飘随晚浪，杯影入鸥群。",
        "岸冻千船雪，岩阴一寺云。",
        "夜灯江北见，寒磬水西闻。",
        "鹤岭烟霞在，归期不羡君。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276080,
      "title": "闲居孟夏即事",
      "content": [
        "绿树荫青苔，柴门临水开。",
        "簟凉初熟麦，枕腻乍经梅。",
        "鱼跃海风起，鼍鸣江雨来。",
        "佳人竟何处，日夕上楼台。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276081,
      "title": "题灞西骆隐士",
      "content": [
        "磻溪连灞水，商岭接秦山。",
        "青汉不回驾，白云长掩关。",
        "雀喧知鹤静，凫戏识鸥闲。",
        "却笑南昌尉，悠悠城市间。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276082,
      "title": "溪亭二首 一",
      "content": [
        "溪亭四面山，横柳半溪湾。",
        "蝉响螳螂急，鱼深翡翠闲。",
        "水寒留客醉，月上与僧还。",
        "犹恋萧萧竹，西斋未掩关。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276083,
      "title": "溪亭二首 二",
      "content": [
        "暖枕眠溪柳，僧斋昨夜期。",
        "茶香秋梦后，松韵晚吟时。",
        "共戏鱼翻藻，争栖鸟坠枝。",
        "重阳应一醉，栽菊助东篱。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276084,
      "title": "秋日赴阙题潼关驿楼",
      "content": [
        "红叶晚萧萧，长亭酒一瓢。",
        "残云归太华，疎雨过中条。",
        "树色随山迥，河声入海遥。",
        "帝乡明日到，犹自梦渔樵。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276085,
      "title": "吴门送客早发",
      "content": [
        "吴歌咽深思，楚客怨归程。",
        "寺晓楼台迥，江秋管吹清。",
        "早潮低水槛，残月下山城。",
        "惆怅回舟日，湘南春草生。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276087,
      "title": "旅怀",
      "content": [
        "征车何轧轧，南北极天涯。",
        "孤枕易为客，远书难到家。",
        "乡连云外树，城闭月中花。",
        "犹有扁舟思，前年别若耶。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276088,
      "title": "南亭与首公䜩集",
      "content": [
        "秋来水上亭，几处似岩扃。",
        "戏鸟翻江叶，游龟带绿萍。",
        "管弦心戚戚，罗绮鬓星星。",
        "行乐非吾事，西斋尚有萤。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276089,
      "title": "早发寿安次永寿渡",
      "content": [
        "东西车马尘，巩洛与咸秦。",
        "山月夜行客，水烟朝渡人。",
        "树凉风皓皓，滩浅石磷磷。",
        "会待功名就，扁舟寄此身。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276090,
      "title": "泊松江渡",
      "content": [
        "漠漠故宫地，月凉风露幽。",
        "鸡鸣荒戍晓，鴈过古城秋。",
        "杨柳北归路，蒹葭南渡舟。",
        "去乡今已远，更上望京楼。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276091,
      "title": "送鱼思别处士归有怀",
      "content": [
        "宴罢众宾散，长歌携一巵。",
        "溪亭相送远，山郭独归迟。",
        "风槛夕云散，月轩寒露滋。",
        "病来双鬓白，不是旧离时。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276092,
      "title": "重经姑苏怀古二首 一",
      "content": [
        "越兵驱绮罗，越女唱吴歌。",
        "宫尽燕声少，台荒麋迹多。",
        "茱萸垂晓露，菡萏落秋波。",
        "无复君王醉，满城颦翠蛾。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276093,
      "title": "重经姑苏怀古二首 二",
      "content": [
        "香迳遶吴宫，千帆落照中。",
        "鹳鸣山欲雨，鱼跃水多风。",
        "城带晚莎绿，池连秋蓼红。",
        "当年国门外，谁识伍员忠。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276094,
      "title": "将赴京师留题孙处士山居二首 一",
      "content": [
        "草堂近西郭，遥对敬亭开。",
        "枕腻海云起，簟凉山雨来。",
        "高歌怀地肺，远赋忆天台。",
        "应学相如志，终须驷马回。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276095,
      "title": "将赴京师留题孙处士山居二首 二",
      "content": [
        "西岩有高兴，路僻几人知。",
        "松荫花开晚，山寒酒熟迟。",
        "游从随野鹤，休息遇灵龟。",
        "长见邻翁说，容华似旧时。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276096,
      "title": "下第寓居崇圣寺感事",
      "content": [
        "怀土泣京华，旧山归路赊。",
        "静依禅客院，幽学野人家。",
        "林晚鸟争树，园春蝶护花。",
        "东门有闲地，谁种邵平瓜。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276097,
      "title": "晓发天井关寄李师晦",
      "content": [
        "山在水滔滔，流年欲二毛。",
        "湘潭归梦远，燕赵客程劳。",
        "露晓红兰重，云晴碧树高。",
        "逢秋正多感，万里别同袍。"
      ],
      "author": {
