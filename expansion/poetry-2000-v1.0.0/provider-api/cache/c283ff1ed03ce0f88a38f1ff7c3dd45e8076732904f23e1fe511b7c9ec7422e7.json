{
  "data": [
    {
      "id": 258797,
      "title": "蓝田溪杂咏二十二首 砌下泉",
      "content": [
        "穿云来自远，激砌流偏驶。",
        "能资庭户幽，更引海禽至。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 258798,
      "title": "蓝田溪杂咏二十二首 戏鸥",
      "content": [
        "乍依菱蔓聚，尽向芦花灭。",
        "更喜好风来，数片翻晴雪。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 258799,
      "title": "蓝田溪杂咏二十二首 远山钟",
      "content": [
        "风送出山钟，云霞度水浅。",
        "欲知声尽处，鸟灭寥天远。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 258800,
      "title": "蓝田溪杂咏二十二首 东陂",
      "content": [
        "永日兴难忘，掇芳春陂曲。",
        "新晴花枝下，爱此苔水绿。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 258801,
      "title": "蓝田溪杂咏二十二首 池上亭",
      "content": [
        "临池构杏梁，待客归烟塘。",
        "水上褰帘好，莲开杜若香。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 258802,
      "title": "蓝田溪杂咏二十二首 衔鱼翠鸟",
      "content": [
        "有意莲叶间，瞥然下高树。",
        "擘波得潜鱼，一点翠光去。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 258803,
      "title": "蓝田溪杂咏二十二首 石莲花",
      "content": [
        "幽石生芙蓉，百花惭美色。",
        "远笑越溪女，闻芳不可识。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 258804,
      "title": "蓝田溪杂咏二十二首 潺湲声",
      "content": [
        "乱石跳素波，寒声闻几处。",
        "飕飕暝风引，散出空林去。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 258805,
      "title": "蓝田溪杂咏二十二首 松下雪",
      "content": [
        "虽因朔风至，不向瑶台侧。",
        "唯助苦寒松，偏明后雕色。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 258806,
      "title": "蓝田溪杂咏二十二首 田鹤",
      "content": [
        "田鹤望碧霄，无风亦自举。",
        "单飞后片云，早晚及前侣。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 258807,
      "title": "蓝田溪杂咏二十二首 题南陂",
      "content": [
        "家住凤城南，门临古陂曲。",
        "时怜上林雁，半入池塘宿。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 258808,
      "title": "伤秋",
      "content": [
        "岁去人头白，秋来树叶黄。",
        "搔头向黄叶，与尔共悲伤。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 258809,
      "title": "送崔山人归山",
      "content": [
        "东山残雨挂斜晖，野客巢由指翠微。",
        "别酒稍酣乘兴去，知君不羡白云归。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 258810,
      "title": "题礼上人壁画山水",
      "content": [
        "连山画出暎禅扉，粉壁香筵满翠微。",
        "坐来𬬻气萦空散，共指晴云向岭归。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 258811,
      "title": "送欧阳子还江华郡",
      "content": [
        "江华胜事接湘滨，千里湖山入兴新。",
        "才子思归催去櫂，汀花且为驻残春。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 258812,
      "title": "暮春归故山草堂",
      "content": [
        "谷口春残黄鸟稀，辛夷花尽杏花飞。",
        "始怜幽竹山窗下，不改清阴待我归。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 258813,
      "title": "访李卿不遇",
      "content": [
        "画戟朱楼暎晚霞，高梧寒柳度飞鸦。",
        "门前不见归轩至，城上愁看落日斜。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 258814,
      "title": "与赵莒茶䜩",
      "content": [
        "竹下忘言对紫茶，全胜羽客醉流霞。",
        "尘心洗尽兴难尽，一树蝉声片影斜。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 258815,
      "title": "故王维右丞堂前芍药花开凄然感怀",
      "content": [
        "芍药花开出旧栏，春衫掩泪再来看。",
        "主人不在花长在，更胜青松守岁寒。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 258816,
      "title": "送张参及第还家",
      "content": [
        "大学三年闻琢玉，东堂一举早成名。",
        "借问还家何处好，玉人含笑下机迎。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 258817,
      "title": "夜泊鹦鹉洲",
      "content": [
        "月照溪边一罩蓬，夜闻清唱有微风。",
        "小楼深巷敲方响，水国人家在处同。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 258818,
      "title": "归雁",
      "content": [
        "潇湘何事等闲回，水碧沙明两岸苔。",
        "二十五弦弹夜月，不胜清怨却飞来。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 258819,
      "title": "春郊",
      "content": [
        "水遶冰渠渐有声，气融烟坞晚来明。",
        "东风好作阳和使，逢草逢花报发生。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 258820,
      "title": "晚归严明府题门",
      "content": [
        "降士林霑蕙草寒，弦惊翰苑失鸳鸾。",
        "秋中回首君门阻，马上应歌行路难。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 258821,
      "title": "秋夜送赵冽归襄阳",
      "content": [
        "斗酒忘言良夜深，红萱露滴鹊惊林。",
        "欲知别后思今夕，汉水东流是寸心。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 258822,
      "title": "送符别驾还郡",
      "content": [
        "骥足骎骎吴越关，屏星复与紫书还。",
        "已知从事元无事，城上愁看海上山。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 258823,
      "title": "同王员外陇城绝句",
      "content": [
        "三军版筑脱金刀，黎庶翻惭将士劳。",
        "不忆新城连嶂起，唯惊画角入云高。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 258824,
      "title": "过故洛城",
      "content": [
        "故城门外春日斜，故城门里无人家。",
        "市朝欲认不知处，漠漠野田空草花。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 258825,
      "title": "校猎曲",
      "content": [
        "长杨杀气连云飞，汉主秋畋正掩围。",
        "重门日晏红尘出，数骑胡人猎兽归。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 258826,
      "title": "晚过横灞寄张蓝田",
      "content": [
        "乱水东流落照时，黄花满径客行迟。",
        "林端忽见南山色，马上还吟陶令诗。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 258827,
      "title": "九日田舍",
      "content": [
        "今日陶家野兴偏，东篱黄菊映秋田。",
        "浮云暝鸟飞将尽，始达青山新月前。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 258828,
      "title": "长安落第",
      "content": [
        "花繁柳暗九门深，对饮悲歌泪满襟。",
        "数日莺花皆落羽，一回春至一伤心。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 299188,
      "title": "失题",
      "content": [
        "胡风迎马首，汉月学蛾眉。",
        "久戍人将老，长征马不肥。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 300840,
      "title": "暇日题草堂",
      "content": [
        "为郎过壮岁，晚景对秋天。",
        "门掩苍苔上，池清寒竹前。",
        "通经未拾紫，炼药不成仙。",
        "且酝东臯黍，愁来得醉眠。",
        "（见宋赵师秀编选《唐众妙集》。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 301529,
      "title": "送元使君",
      "content": [
        "郢门将咫尺，龙节莫夷犹。",
        "送客与云散，行人看月愁。",
        "遥闻江汉水，日与政声流。",
        "（《舆地纪胜》八四《郢州》）。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 303221,
      "title": "题杜舍人林亭",
      "content": [
        "来访龙楼客，时逢酒瓮新。",
        "花齐云入幕，苔径竹迎人。",
        "鹊喜娇迟日，莺啼惜暮春。",
        "不须耽小隐，南院在平津。",
        "（见元骆天骧《类编长安志》卷九胜游类樊川范公五居条引，据《中国古都研究》收黄永年先生《述〈类编长安志〉》一文转引。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 303222,
      "title": "宿云门寺",
      "content": [
        "山寺宜静夜，禅房开竹扉。",
        "支公方晤语，孤月复清晖。",
        "一磬响丹壑，千灯明翠微。",
        "平生厌浮世，兹夕更忘归。",
        "（见《会稽掇英总集》卷六）。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 303223,
      "title": "芝草（题拟）",
      "content": [
        "岂如玉殿生三秀，讵有铜池出五云。",
        "陌上尧樽倾北斗，楼前舜乐动南薰。",
        "（《全芳备祖后集》卷十一《芝草》。",
        "此四句为「七言律诗散联」）。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 303224,
      "title": "芭蕉（题拟）",
      "content": [
        "幸有青丝用，宁将众草同。",
        "心虚含夕露，叶大怯秋风。",
        "细响安禅后，浓阴坐夏中。",
        "由来何所喻，持以问支公。",
        "（见前书卷十三《芭蕉》）。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 303225,
      "title": "送友人入蜀",
      "content": [
        "远路接天末，怪君与我违。",
        "客程千嶂里，鸟道片云飞。",
        "树色连青汉，泉声出翠微。",
        "锦城花月下，才子定忘归。",
        "（见《全蜀艺文志》卷二十）。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 303226,
      "title": "送归客",
      "content": [
        "京口三秋衰叶落，浔阳千里暮潮生。",
        "（《千载佳句》卷下《别离部·行旅》）。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 343926,
      "title": "紫参歌",
      "content": [
        "远公林下满青苔，春药偏宜间石开。",
        "往往幽人寻水见，",
        "春风宛转虎溪傍，紫翼红翘翻霁光。",
        "贝叶经前无住色，",
        "应知仙卉老云霞，莫赏夭桃满蹊径。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 343927,
      "title": "玛瑙杯歌",
      "content": [
        "瑶溪碧岸生奇宝，剖质披心出文藻。",
        "良工雕饰明且鲜，",
        "繁弦急管催献酬，倏若飞空生羽翼，fY々兰英照豹斑，",
        "王孙彩笔题新咏，碎锦连珠复辉映。",
        "世情贵耳不贵奇，"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 343928,
      "title": "锄药咏",
      "content": [
        "莳药穿林复在𪩘，浓香秀色深能浅。",
        "云气垂来浥露偏，",
        "不随飞鸟缘枝去，如笑幽人出谷来。",
        "对之不觉忘疏懒，",
        "但使芝兰出萧艾，不辞手足皆胼胝。",
        "宁学陶潜空嗜酒，"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 343929,
      "title": "病鹤篇",
      "content": [
        "独鹤声哀羽摧折，沙头一点留残雪。",
        "三山侣伴能远翔，",
        "不及川凫长比翼，随波双泛复双归。",
        "碧海沧江深且广，",
        "何时白雾卷青天，接影追飞太液前。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 343930,
      "title": "片玉篇",
      "content": [
        "至宝未为代所奇，韫灵示璞荆山陲。",
        "独使虹光天子识，",
        "空山埋照凡几年，古色苍痕宛自然。",
        "重溪幂幂暗云树，",
        "试劳香袖拂莓苔，不觉清心皎冰雪。",
        "连城美价幸逢时，"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 343931,
      "title": "画鹤篇",
      "content": [
        "点素凝姿任画工，霜毛玉羽照帘栊。",
        "借问飞鸣华表上，",
        "炉气朝成缑岭云，银灯夜作华亭月。",
        "日暖花明梁燕归，"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 343932,
      "title": "秋霖曲",
      "content": [
        "君不见圣主旰食忧元元，秋风苦雨暗九门。",
        "凤凰池里沸泉腾，苍龙阙下生云根。",
        "阴精离毕太淹度，",
        "公卿红粒爨丹桂，黔首白骨封青苔。",
        "貂裘玉食张公子，",
        "鹤鸣蛙跃正及时，豹隐兰凋亦可悲。",
        "焉得太阿决屏翳，"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 343933,
      "title": "白石枕",
      "content": [
        "琢瑉胜水碧，所贵素且贞。",
        "曾无白圭玷，不作浮磬鸣。",
        "捧来太阳前，一片新冰清。",
        "沉沉风宪地，待尔秋已至。",
        "璞坚难为功，谁怨晚成器。",
        "比德无磷缁，论交亦如此。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 343934,
      "title": "赋得青城山歌，送杨、杜二郎中赴蜀军",
      "content": [
        "蜀山西南千万重，仙经最说青城峰。",
        "青城嵚岑倚空碧，",
        "星台二妙逐王师，阮瑀军书王粲诗。",
        "日落猿声连玉笛，"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 343936,
      "title": "送崔校书从军",
      "content": [
        "雁门太守能爱贤，麟阁书生亦投笔。",
        "宁唯玉剑报知己，",
        "燕南春草伤心色，蓟北黄云满眼愁。",
        "闻道轻生能击虏，"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 343937,
      "title": "送张将军征西",
      "content": [
        "长安少年唯好武，金殿承恩争破虏。",
        "沙场烽火隔天山，",
        "玉笛声悲离酌晚，金方路极行人远。",
        "计日霜戈尽敌归，"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 343938,
      "title": "送修武元少府",
      "content": [
        "寸禄荣色养，此行宁叹惜。",
        "自今黄绶采兰时，",
        "黎氓久厌蓬飘苦，迟尔西南惠月传。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 343939,
      "title": "送崔十三东游",
      "content": [
        "千里有同心，十年一会面。",
        "当杯缓筝柱，倏忽催离宴。",
        "丹凤城头噪晚鸦，行人马首夕阳斜。",
        "灞上春风留别袂，"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 343940,
      "title": "送邬三落第还乡",
      "content": [
        "郢客文章绝世稀，常嗟时命与心违。",
        "十年失路谁知己，",
        "关中新月对离尊，江上残花待归客。",
        "名宦无媒自古迟，"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 343941,
      "title": "送马明府赴江陵",
      "content": [
        "陶令南行心自永，江天极目澄秋景。",
        "万室遥方犬不鸣，",
        "黄花满把应相忆，落日登楼北望还。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 343942,
      "title": "送毕侍御谪居",
      "content": [
        "崇兰香死玉簪折，志士吞声甘徇节。",
        "忠荩不为明主知，",
        "百鸟喧喧噪一鹗，上林高枝亦难托。",
        "宁嗟人世弃虞翻，",
        "桃花洞里举家去，此别相思复几春。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 343943,
      "title": "送褚大落第东归",
      "content": [
        "离琴弹苦调，美人惨向隅。",
        "顷来荷策干明主，",
        "玉堂金马隔青云，墨客儒生皆白首。",
        "昨梦芳洲采白苹，",
        "剡中风月久相忆，池上旧游应再得。",
        "酒熟宁孤芳杜春，",
        "他日东流一乘兴，知君为我扫荆扉。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 343944,
      "title": "送傅管记赴蜀军",
      "content": [
        "终童之死谁继出，燕颔儒生今俊逸。",
        "主将早知鹦鹉赋，",
        "巴山雨色藏征旆，汉水猿声咽短箫。",
        "赐璧腰金应可料，",
        "日暮黄云千里昏，壮心轻别不销魂。",
        "劝君用却龙泉剑，"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 343946,
      "title": "行路难",
      "content": [
        "君不见明星映空月，太阳朝升光尽歇。",
        "君不见凋零委路蓬，长风飘举入云中。",
        "由来人事何尝定，且莫骄奢笑贱穷。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 343947,
      "title": "卢龙塞行送韦掌记",
      "content": [
        "雨雪纷纷黑山外，行人共指卢龙塞。",
        "万里飞沙咽鼓鼙，",
        "圣主好文兼好武，封侯莫比汉皇年。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 343948,
      "title": "效古秋夜长",
      "content": [
        "秋汉飞玉霜，北风扫荷香。",
        "含情纺织孤灯尽，",
        "谁家少妇事鸳机，锦幕云屏深掩扉。",
        "白玉窗中闻落叶，"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 343949,
      "title": "卧病，李员外题扉而去",
      "content": [
        "僻陋病者居，蒿莱行径失。",
        "谁知簪绂贵，能问幽忧疾。",
        "珂声未驻门，兰气先入室。",
        "沉屙不冠带，安得候蓬荜。",
        "清扬去莫寻，离念顷来侵。",
        "雀栖高窗静，日出修桐阴。",
        "枕上忆君子，悄悄唯苦心。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 343951,
      "title": "山中寄时校书",
      "content": [
        "蓬莱紫气温如玉，唯予知尔阳春曲，别来几日芳荪绿。",
        "百花酒满不见君，青山一望心断续。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 343954,
      "title": "哭曹钧",
      "content": [
        "苦节推白首，怜君负此生。",
        "忠荩名空在，家贫道不行。",
        "朝来相忆访蓬荜，只谓渊明犹卧疾。",
        "忽见江南吊鹤来，",
        "一声邻笛残阳里，酹酒空堂泪满衣。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 343958,
      "title": "卧疾，答刘道士",
      "content": [
        "白露蚕已丝，空林日凄清。",
        "寥寥昼扉掩，独卧秋窗明。",
        "宝字比仙药，羽人寄柴荆。",
        "长吟想风驭，恍若升蓬瀛。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 343963,
      "title": "登胜果寺南楼，雨中望严协律",
      "content": [
        "微雨侵晚阳，连山半藏碧。",
        "林端陟香榭，云外迟来客。",
        "孤村凝片烟，去水生远白。",
        "但佳川原趣，不觉城池夕。",
        "更喜眼中人，清光渐咫尺。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 343965,
      "title": "自终南山晚归",
      "content": [
        "采苓日往还，得性非樵隐。",
        "白水到初阔，青山辞尚近。",
        "绝境胜无倪，归途兴不尽。",
        "沮溺时返顾，牛羊自相引。",
        "逍遥不外求，尘虑从兹泯。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 343966,
      "title": "早渡伊川见旧邻作",
      "content": [
        "鶤鸡鸣早霜，秋水寒旅涉。",
        "渔人昔邻舍，相见具舟楫。",
        "出浦兴未尽，向山心更惬。",
        "村落通白云，茅茨隐红叶。",
        "东皋满时稼，归客欣复业。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 343967,
      "title": "夕发箭场岩下作",
      "content": [
        "行役不遑安，在幽机转发。",
        "山谷无明晦，溪霞自兴没。",
        "朝栉杉下风，夕饮石上月。",
        "懿尔青云士，垂缨朝凤阙。",
        "宁知采竹人，每食惭薇蕨。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 343969,
      "title": "雨中望海上，怀郁林观中道侣",
      "content": [
        "山观海头雨，悬沫动烟树。",
        "只疑苍茫里，郁岛欲飞去。",
        "大块怒天吴，惊潮荡云路。",
        "群真俨盈想，一苇不可渡。",
        "惆怅赤城期，愿假轻鸿驭。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 343970,
      "title": "广德初銮驾出关后登高愁望二首",
      "content": [
        "长安不可望，远处边愁起。",
        "辇毂混戎夷，山河空表里。",
        "黄云压城阙，斜照移烽垒。",
        "汉帜远成霞，胡马来如蚁。",
        "不知涿鹿战，早晚蚩尤死。",
        "渴日候河清，沉忧催暮齿。",
        "愁看秦川色，惨惨云景晦。",
        "乾坤暂运行，品物遗覆载。",
        "黄尘涨戎马，紫气随龙旆。",
        "掩泣指关东，日月妖氛外。",
        "臣心寄远水，朝海去如带。",
        "周德更休明，天衢伫开泰。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 343971,
      "title": "独往覆釜山，寄郎士元",
      "content": [
        "赏心无远近，芳月好登望。",
        "胜事引幽人，山下复山上。",
        "将寻洞中药，复爱湖外嶂。",
        "古壁苔入云，阴溪树穿浪。",
        "谁言世缘绝，更惜知音旷。",
        "莺啼绿萝春，回首还惆怅。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 343972,
      "title": "送王季友赴洪州幕下",
      "content": [
        "列郡皆用武，南征所从谁。",
        "诸侯重才略，见子如琼枝。",
        "抚剑感知己，出门方远辞。",
        "烟波带幕府，海日生红旗。",
        "问我何功德，负恩留玉墀。",
        "销魂把别袂，愧尔酬明时。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 343974,
      "title": "山中春仲寄汝上王恒、颍川沈冲",
      "content": [
        "隐者守恬泊，春山日深净。",
        "谁知蟠木材，得性无人境。",
        "座隅泉出洞，竹上云起岭。",
        "饥狖入山厨，饮虹过药井。",
        "前溪堪放逸，仲月好风景。",
        "游目来远思，摘芳寄汝颍。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 343975,
      "title": "南中春意",
      "content": [
        "入仕无知言，游方随世道。",
        "平生愿开济，遇物干怀抱。",
        "已阻青云期，甘同散樗老。",
        "客游南海曲，坐见韶阳早。",
        "旧国别佳人，他乡思芳草。",
        "惜无鸿鹄翅，安得凌苍昊。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 343979,
      "title": "登秦岭半岩遇雨",
      "content": [
        "屏翳忽腾气，浮阳惨无晖。",
        "千峰挂飞雨，百尺摇翠微。",
        "震电闪云径，奔流翻石矶。",
        "倚岩假松盖，临水羡荷衣。",
        "不得采苓去，空思乘月归。",
        "且怜东皋上，水色侵荆扉。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 343980,
      "title": "杪秋南山西峰题准上人兰若",
      "content": [
        "向山看霁色，步步豁幽性。",
        "返照乱流明，寒空千嶂净。",
        "石门有余好，霞残月欲映。",
        "上诣远公庐，孤峰悬一径。",
        "云里隔窗火，松下闻山磬。",
        "客到两忘言，猿心与禅定。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 343981,
      "title": "田园雨后赠邻人",
      "content": [
        "安排常任性，偃卧晚开户。",
        "樵客荷蓑归，向来春山雨。",
        "残云虹未落，返景霞初吐。",
        "时鸟鸣村墟，新泉绕林圃。",
        "尧年尚恬泊，邻里成太古。",
        "室迩人遂遥，相思怨芳杜。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 343982,
      "title": "天门谷题孙逸人石壁",
      "content": [
        "崖石乱流处，竹深斜照归。",
        "主人卧磻石，心耳涤清晖。",
        "春雷近作解，空谷半芳菲。",
        "云栋彩虹宿，药圃蝴蝶飞。",
        "恶嚣慕嘉遁，几夜瞻少微。",
        "相见竟何说，忘情同息机。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 343983,
      "title": "蓝溪休沐，寄赵八给事",
      "content": [
        "虫鸣归旧里，田野秋农闲。",
        "即事敦夙尚，衡门方再关。",
        "夕阳入东篱，爽气高前山。",
        "霜蕙后时老，巢禽知暝还。",
        "侍臣黄枢宠，鸣玉青云间。",
        "肯想观鱼处，寒泉照发斑。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 343984,
      "title": "游辋川至南山，寄谷口王十六",
      "content": [
        "山色不厌远，我行随处深。",
        "迹幽青萝径，思绝孤霞岑。",
        "独鹤引过浦，鸣猿呼入林。",
        "褰裳百泉里，一步一清心。",
        "王子在何处，隔云鸡犬音。",
        "折麻定延伫，乘月期招寻。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 343986,
      "title": "淮上别范大",
      "content": [
        "悲风陨凉叶，送归怨南楚。",
        "穷年将别离，寸晷申宴语。",
        "长淮流不尽，征棹忽复举。",
        "碧落半愁云，黄鹤时顾侣。",
        "游宦且未达，前途各修阻。",
        "分袂一相嗟，良辰更何许。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 343987,
      "title": "离居夜雨，奉寄李京兆",
      "content": [
        "永夜不可度，蛩吟秋雨滴。",
        "寂寞想章台，始叹云泥隔。",
        "雷声匪君车，犹时过我庐。",
        "电影非君烛，犹能明我目。",
        "如何琼树枝，梦里看不足。",
        "望望佳期阻，愁生寒草绿。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 343988,
      "title": "叹毕少府以持法无隐见系",
      "content": [
        "用法本禁邪，尽心翻自极。",
        "毕公在囹圄，世事何纠纆。",
        "翠凤呈其瑞，虞罗寄铩翼。",
        "囚中千念时，窗外百花色。",
        "落景闭圜扉，春虫网丛棘。",
        "古人不念文，纷泪莫沾臆。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 343990,
      "title": "过温逸人旧居",
      "content": [
        "返真难合道，怀旧仍无吊。",
        "浮俗渐浇淳，斯人谁继妙。",
        "声容在心耳，宁觉阻言笑。",
        "玄堂闭几春，拱木齐云峤。",
        "鹤传居士舞，猿得苏门啸。",
        "酹酒片阳微，空山想埋照。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 343991,
      "title": "县内水亭晨兴听讼",
      "content": [
        "晨光起宿露，池上判黎氓。",
        "借问秋泉色，何如拙宦情。",
        "磨铅辱利用，策蹇愁前程。",
        "昨夜明月满，中心如鹊惊。",
        "负恩时易失，多病绩难成。",
        "会惜寒塘晚，霜风吹杜蘅。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 343993,
      "title": "太子李舍人城东别业",
      "content": [
        "南山转群木，昏晓拥山翠。",
        "小泽近龙居，清苍常雨气。",
        "君家北原上，千金买胜事。",
        "丹阙退朝回，白云迎赏至。",
        "新晴村落外，处处烟景异。",
        "片水明断岸，余霞入古寺。",
        "东皋指归翼，目尽有余意。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 343996,
      "title": "秋夜作",
      "content": [
        "万计各无成，寸心日悠漫。",
        "浮生竟何穷，巧历不能算。",
        "流落四海间，辛勤百年半。",
        "商歌向秋月，哀韵兼浩叹。",
        "寤寐怨佳期，美人隔霄汉。",
        "寒云度穷水，别业绕垂幔。",
        "窗中问谈鸡，长夜何时旦。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 343998,
      "title": "裴侍郎湘川回，以青竹筒相遗，因而赠之",
      "content": [
        "楚竹青玉润，从来湘水阴。",
        "缄书取直节，君子知虚心。",
        "入用随宪简，积文不受金。",
        "体将丹凤直，色映秋霜深。",
        "宁肯假伶伦，谬为龙凤吟。",
        "唯将翰院客，昔秘瑶华音。",
        "长跪捧嘉贶，岁寒惭所钦。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 343999,
      "title": "东城初陷，与薛员外、王补阙暝投南山佛寺",
      "content": [
        "日昃石门里，松声山寺寒。",
        "香云空静影，定水无惊湍。",
        "洗足解尘缨，忽觉天形宽。",
        "清钟扬虚谷，微月深重峦。",
        "噫我朝露世，翻浮与波澜。",
        "行运遘忧患，何缘亲盘桓。",
        "庶将镜中象，尽作无生观。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 344002,
      "title": "酬陶六辞秩归旧居见柬",
      "content": [
        "靖节昔高尚，令孙嗣清徽。",
        "旧庐云峰下，献岁车骑归。",
        "去俗因解绶，忆山得采薇。",
        "田畴春事起，里巷相寻稀。",
        "渊明醉乘兴，闲门只掩扉。",
        "花禽惊曙月，邻女上鸣机。",
        "毕娶愿已果，养恬志宁违。",
        "吾当挂朝服，同尔缉荷衣。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 344003,
      "title": "奉使采箭簳竹谷中晨兴赴岭",
      "content": [
        "孤客倦夜坐，闻猿乘早发。",
        "背溪已斜汉，登栈尚残月。",
        "重峰转森爽，幽步更超越。",
        "云木耸鹤巢，风萝扫虎穴。",
        "人群徒自远，世役终难歇。",
        "入山非买山，采竹异采蕨。",
        "谁见子牟意，悁劳书魏阙。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 344009,
      "title": "仲春晚寻覆釜山",
      "content": [
        "蝴蝶弄和风，飞花不知晚。",
        "王孙寻芳草，步步忘路远。",
        "况我爱青山，涉趣皆游践。",
        "萦回必中路，阴晦阳复显。",
        "古岸生新泉，霞峰映雪𪩘。",
        "交枝花色异，奇石云根浅。",
        "碧洞志忘归，紫芝行可搴。",
        "应嗤嵇叔夜，林卧方沉湎。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 344010,
      "title": "赠东邻郑少府",
      "content": [
        "一闻白雪唱，愿见清扬久。",
        "谁谓结绶来，得陪趋府后。",
        "小邑蓝溪上，卑栖惬所偶。",
        "忘言复连墙，片月亦携手。",
        "草色同春径，莺声共高柳。",
        "美景百花时，平生一杯酒。",
        "圣朝法天地，以我为刍狗。",
        "秩满归白云，期君访谷口。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 344012,
      "title": "罢章陵令山居过中峰道者二首",
      "content": [
        "宁辞园令秩，不改渊明调。",
        "解印无与言，见山始一笑。",
        "幽人还绝境，谁道苦奔峭。",
        "随云剩渡溪，出门更垂钓。",
        "吾庐青霞里，窗树玄猿啸。",
        "微月清风来，方知散发妙。",
        "丘壑趣如此，暮年始栖偃。",
        "赖遇无心云，不笑归来晚。",
        "鸣鸠拂红枝，初服傍清畎。",
        "昨日山僧来，犹嫌嘉遁浅。",
        "托君紫阳家，路灭心更远。",
        "梯云创其居，抱犊上绝𪩘。",
        "杏田溪一曲，霞境峰几转。",
        "路石挂飞泉，谢公应在眼。",
        "愿言携手去，采药长不返。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 344013,
      "title": "登覆釜山遇道人二首",
      "content": [
        "晨策趣无涯，名山深转秀。",
        "三休变覆景，万转迷宇宙。",
        "攀崖到天窗，入洞穷玉溜。",
        "侧径蹲怪石，飞萝掷惊狖。",
        "花间炼药人，鸡犬和乳窦。",
        "散发便迎客，采芝仍满袖。",
        "郭璞赋游仙，始愿今可就。",
        "真气重嶂里，知君嘉遁幽。",
        "山阶压丹穴，药井通洑流。",
        "道者带经出，洞中携我游。",
        "欲骖白霓去，且为紫芝留。",
        "忽忆武陵事，别家疑数秋。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 344014,
      "title": "寻华山云台观道士",
      "content": [
        "秋日西山明，胜趣引孤策。",
        "桃源数曲尽，洞口两岸坼。",
        "还从罔象来，忽得仙灵宅。",
        "霓裳谁之子，霞酌能止客。",
        "残阳在翠微，携手更登历。",
        "林行拂烟雨，溪望乱金碧。",
        "飞鸟下天窗，袅松际云壁。",
        "稍寻玄踪远，宛入寥天寂。",
        "愿言葛仙翁，终年炼玉液。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
