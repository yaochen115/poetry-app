{
  "data": [
    {
      "id": 267542,
      "title": "云童行",
      "content": [
        "云童童，白龙之尾垂江中。",
        "今年天旱不作雨，水足墙上有禾黍。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267543,
      "title": "新桃行",
      "content": [
        "桃生叶婆娑，枝叶四向多。",
        "高未出墙颠，蒿苋相凌摩。",
        "植之三年余，今年初试花。",
        "秋来已成实，其阴良已嘉。",
        "青蝉不来鸣，安得迅羽过。",
        "常恶牵丝虫，蒙幂成网罗。",
        "顾托戏儿童，勿折吾柔柯。",
        "明年结其实，磊磊充汝家。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267544,
      "title": "忆远曲",
      "content": [
        "水上山沈沈，征途复绕林。",
        "途荒人行少，马迹犹可寻。",
        "雪中独立树，海口失侣禽。",
        "离忧如长线，千里萦我心。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267545,
      "title": "长塘湖",
      "content": [
        "长塘湖，一斛水中半斛鱼。",
        "大鱼如柳叶，小鱼如针锋，水浊谁能辨真龙。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267546,
      "title": "废瑟词",
      "content": [
        "古瑟在匣谁复识，玉柱颠倒朱丝黑。",
        "千年曲谱不分明，乐府无人传正声。",
        "秋虫暗穿尘作色，腹中不辨工人名。",
        "几时天下复古乐，此瑟还奏云门曲。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 267547,
      "title": "野居",
      "content": [
        "贫贱易为适，荒郊亦安居。",
        "端坐无余思，弥乐古人书。",
        "秋田多良苗，野水多游鱼。",
        "我无耒与网，安得充廪厨。",
        "寒天白日短，簷下煖我躯。",
        "四肢暂宽柔，中肠郁不舒。",
        "多病减志气，为客足忧虞。",
        "况复苦时节，览景独踟蹰。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267548,
      "title": "西州",
      "content": [
        "羌胡据西州，近甸无边城。",
        "山东收税租，养我防塞兵。",
        "胡骑来无时，居人常震惊。",
        "嗟我五陵间，农者罢耘耕。",
        "边头多杀伤，士卒难全形。",
        "郡县发丁役，丈夫各征行。",
        "生男不能养，惧身有姓名。",
        "良马不念秣，烈士不苟营。",
        "所愿除国难，再逢天下平。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267549,
      "title": "杂怨",
      "content": [
        "切切重切切，秋风桂枝折。",
        "人当少年嫁，我当少年别。",
        "念君非征行，年年长远途。",
        "妾身甘独殁，高堂有舅姑。",
        "山川岂遥远，行人自不返。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267550,
      "title": "惜花",
      "content": [
        "春潭足芳树，水清不如素。",
        "幽人爱华景，一一空山暮。",
        "月出潭气白，游鱼暗冲石。",
        "夜深春思多，酒醒山寂寂。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267551,
      "title": "三原李氏园宴集",
      "content": [
        "暮春天早热，邑居苦嚣烦。",
        "言从君子乐，乐彼李氏园。",
        "园中有草堂，池引泾水泉。",
        "开户西北望，远见嵯峨山。",
        "借问主人翁，北州佐戎轩。",
        "仆夫守旧宅，为客侍华筵。",
        "高怀有余兴，竹树芳且鲜。",
        "倾我所持觞，尽日共留连。",
        "疎拙不偶俗，常喜形体闲。",
        "况来幽栖地，能不重叹言。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267552,
      "title": "沈千运旧居",
      "content": [
        "汝北君子宅，我来见颓墉。",
        "乱离子孙尽，地属邻里翁。",
        "土木被丘墟，谿路不连通。",
        "旧井蔓草合，牛羊坠其中。",
        "君辞天下书，放意任体躬。",
        "一生不自力，家与逆旅同。",
        "高议切星辰，余声激瘖聋。",
        "方将旌旧闾，百世可封崇。",
        "嗟其未积年，已为荒林丛。",
        "时岂无知音，不能崇此风。",
        "浩荡竟无覩，我将安所从。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267553,
      "title": "赠别孟郊",
      "content": [
        "历历天上星，沉沉水中萍。",
        "幸当清秋夜，流影及微形。",
        "君生衰俗间，立身如礼经。",
        "纯诚发新文，独有金石声。",
        "才名振京国，归省东南行。",
        "停车楚城下，顾我不念程。",
        "宝镜曾坠水，不磨岂自明。",
        "苦节居贫贱，所知赖友生。",
        "欢会方别离，戚戚忧虑幷。",
        "安得在一方，终老无送迎。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267554,
      "title": "卧疾",
      "content": [
        "身病多思虑，亦读神农经。",
        "空堂留灯烛，四壁青荧荧。",
        "羁旅随人欢，贫贱还自轻。",
        "今来问良医，乃知病所生。",
        "僮仆各忧愁，杵臼无停声。",
        "见我形顦顇，劝药语丁宁。",
        "春雨枕席冷，窗前新禽鸣。",
        "开门起无力，遥爱鸡犬行。",
        "服药察耳目，渐如醉者醒。",
        "顾非达性命，犹为忧患生。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267555,
      "title": "卧疾",
      "content": [
        "身病始知道，卧读神农经。",
        "空房夜留灯，四壁青荧荧。",
        "羇旅逐人欢，贫贱还自轻。",
        "今来问良医，乃知病所生。",
        "僮仆各相忧，杵臼无停声。",
        "见我形憔悴，劝药语丁宁。",
        "春雨枕席冷，窗前新禽鸣。",
        "开门起无力，遥爱鸡犬行。",
        "服药察耳目，渐觉如酒醒。",
        "方悟养生者，不为忧患并。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267556,
      "title": "别段生",
      "content": [
        "与子骨肉亲，愿言长相随。",
        "况离父母傍，从我学书诗。",
        "同在道路间，讲论亦未亏。",
        "为文于我前，日夕生光仪。",
        "行役多疾疚，赖此相扶持。",
        "贫贱事难拘，今日有别离。",
        "我去秦城中，子留汴水湄。",
        "离情两飘断，不异风中丝。",
        "幼年独为客，举动难得宜。",
        "努力自修励，常如见我时。",
        "送我登山冈，再拜问还期。",
        "还期在新年，勿怨欢会迟。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267557,
      "title": "哭于鹄",
      "content": [
        "青山无逸人，忽觉大国贫。",
        "良玉沈幽泉，名为天下珍。",
        "野性疎时俗，再拜乃从军。",
        "气高终不合，去如镜上尘。",
        "我初有章句，相合者唯君。",
        "今来吊嗣子，对陇烧新文。",
        "耕者废其耜，爨者绝其薪。",
        "苟无新衣裳，曷用光我身。",
        "奠酒徒拜手，哀怀安能陈。",
        "徒保金石韵，千载人所闻。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267558,
      "title": "南归",
      "content": [
        "促促念道路，四支不常宁。",
        "行车未及家，天外非尽程。",
        "骨肉待我欢，乡里望我荣。",
        "岂知东与西，顦顇竟无成。",
        "人言苦夜长，穷者不念明。",
        "惧离其寝寐，百忧伤性灵。",
        "世道多险薄，相劝毕中诚。",
        "远游无知音，不如商贾行。",
        "达人有常志，愚夫劳所营。",
        "旧山行去远，言归乐此生。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267559,
      "title": "惜花",
      "content": [
        "蒙蒙庭树花，坠地无颜色。",
        "日暮东风起，飘扬玉阶侧。",
        "残蘂在犹稀，青条耸复直。",
        "为君结芳实，令君勿叹息。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267560,
      "title": "奉和舍人叔直省时思琴",
      "content": [
        "蔼蔼紫薇直，秋意深无穷。",
        "滴沥仙阁漏，肃穆禁池风。",
        "竹月泛凉影，萱露澹幽丛。",
        "地清物态胜，宵闲琴思通。",
        "时属雅音际，逈凝虚抱中。",
        "达人掌枢近，常与隐默同。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267561,
      "title": "离妇",
      "content": [
        "十载来夫家，闺门无瑕疵。",
        "薄命不生子，古制有分离。",
        "托身言同穴，今日事乖违。",
        "念君终弃捐，谁能强在兹。",
        "堂上谢姑嫜，长跪请离辞。",
        "姑嫜见我往，将决复沉疑。",
        "与我古时钏，留我嫁时衣。",
        "高堂拊我身，哭我于路陲。",
        "昔日初为妇，当君贫贱时。",
        "昼夜常纺绩，不得事蛾眉。",
        "辛勤积黄金，济君寒与饥。",
        "洛阳买大宅，邯郸买侍儿。",
        "夫壻乘龙马，出入有光仪。",
        "将为富家妇，永为子孙资。",
        "谁谓出君门，一身上车归。",
        "有子未必荣，无子坐生悲。",
        "为人莫作女，作女实难为。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267562,
      "title": "怀别",
      "content": [
        "仆人驱行轩，低昂出我门。",
        "离堂无留客，席上唯琴樽。",
        "古道随水曲，悠悠绕荒村。",
        "远程未奄息，别念在朝昏。",
        "端居愁岁永，独此留清景。",
        "岂无经过人，寻叹门巷静。",
        "君如天上雨，我如屋下井。",
        "无因同波流，愿作形与影。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267563,
      "title": "学仙",
      "content": [
        "楼观开朱门，树木连房廊。",
        "中有学仙人，少年休谷粮。",
        "高冠如芙蓉，霞月披衣裳。",
        "六时朝上清，佩玉纷铿锵。",
        "自言天老书，秘覆云锦囊。",
        "百年度一人，妄泄有灾殃。",
        "每占有仙相，然后传此方。",
        "先生坐中堂，弟子跪四厢。",
        "金刀截身发，结誓焚灵香。",
        "弟子得其诀，清斋入空房。",
        "守神保元气，动息随天罡。",
        "炉烧丹砂尽，昼夜候火光。",
        "药成既服食，计日乘鸾凰。",
        "虚空无灵应，终岁安所望。",
        "勤劳不能成，疑虑积心肠。",
        "虚羸生疾疹，寿命多夭伤。",
        "身殁惧人见，夜埋山谷傍。",
        "求道慕灵异，不如守寻常。",
        "先王知其非，戒之在国章。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267564,
      "title": "夜怀",
      "content": [
        "穷居积远念，转转迷所归。",
        "幽蕙零落色，暗萤参差飞。",
        "病生秋风簟，泪堕月明衣。",
        "无愁坐寂寞，重使奏清徽。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267565,
      "title": "城南",
      "content": [
        "漾漾南涧水，来作曲池流。",
        "言寻参差岛，晓榜轻盈舟。",
        "万绕不再止，千寻尽孤幽。",
        "藻涩讶人重，萍分指鱼游。",
        "繁苗毯下垂，密箭翻回辀。",
        "曝鼈乱自坠，阴藤斜相钩。",
        "卧蒋黑米吐，翻芰紫角稠。",
        "桥低竞俯偻，亭近闲夷犹。",
        "目为逐胜朗，手因掇芳柔。",
        "渐喜游来极，忽疑归无由。",
        "气状虽可览，纤微谅难搜。",
        "未听主人赏，徒爱清华秋。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267566,
      "title": "怀友",
      "content": [
        "人生有行役，谁能如草木。",
        "别离感中怀，乃为我桎梏。",
        "百年受命短，光景良不足。",
        "念我别离者，愿怀日月促。",
        "平地施道路，车马往不复。",
        "空知为良田，秋望禾黍熟。",
        "端居无俦侣，日夜祷耳目。",
        "立身难自觉，常恐忧与辱。",
        "穷贱无闲暇，疾痛多嗜欲。",
        "我思携手人，逍遥任心腹。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267567,
      "title": "寄别者",
      "content": [
        "寒天正飞雪，行人心切切。",
        "同为万里客，中路忽离别。",
        "别君汾水东，望君汾水西。",
        "积雪无平冈，空山无人蹊。",
        "羸马时倚辕，行行未遑食。",
        "下车劝僮仆，相顾莫叹息。",
        "讵知佳期隔，离念终无极。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267568,
      "title": "献从兄",
      "content": [
        "悠悠旱天云，不远如飞尘。",
        "贤达失其所，沉飘同众人。",
        "擢秀登王畿，出为良使宾。",
        "名高满朝野，幼贱谁不闻。",
        "一朝遇谗邪，流窜八九春。",
        "诏书近迁移，组绶未及身。",
        "冬井无寒冰，玉润难为焚。",
        "虚怀日迢遥，荣辱常保纯。",
        "我念出游时，勿吟康乐文。",
        "愿言灵溪期，聊欲相依因。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267569,
      "title": "寄韩愈",
      "content": [
        "野馆非我室，新居未能安。",
        "读书避尘杂，方觉此地闲。",
        "过郭多园墟，桑果相接连。",
        "独游竟寂寞，如寄空云山。",
        "夏景常昼毒，密林无鸣蝉。",
        "临溪一盥濯，清去肢体烦。",
        "出林望曾城，君子在其间。",
        "戎府草章记，阻我此游盘。",
        "忆昔西潭时，并持钓鱼竿。",
        "共忻得鲂鲤，烹鲙于我前。",
        "几朝还复来，叹息时独言。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267570,
      "title": "赠姚怤",
      "content": [
        "漏天日无光，泽土松不长。",
        "君今职下位，志气安得扬。",
        "白发文思壮，才为国贤良。",
        "无人识高韵，荐于天子傍。",
        "况我愚朴姿，强趋利名场。",
        "远同干贵人，身举固难彰。",
        "昔逢汴水滨，今会习池阳。",
        "岂无再来期，顾恐非此方。",
        "愿为石中泉，不为瓦上霜。",
        "离别勿复道，所贵不相忘。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267571,
      "title": "病中寄白学士拾遗",
      "content": [
        "秋亭病客眠，庭树满枝蝉。",
        "凉风绕砌起，斜影入床前。",
        "梨晚渐红坠，菊寒无黄鲜。",
        "倦游寂寞日，感叹蹉跎年。",
        "尘欢久消委，华念独迎延。",
        "自寓城阙下，识君弟事焉。",
        "君为天子识，我方沉病缠。",
        "无因会同语，悄悄中怀煎。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267572,
      "title": "雨中寄元宗简",
      "content": [
        "秋堂羸病起，盥漱风雨朝。",
        "竹影冷疎涩，榆叶暗飘萧。",
        "街径多坠果，墙隅有蜕蜩。",
        "延瞻游步阻，独坐闲思饶。",
        "君居应如此，恨言相去遥。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267573,
      "title": "野寺后池寄友",
      "content": [
        "佛寺连野水，池幽夏景清。",
        "繁木荫芙蕖，时有水禽鸣。",
        "通溪岸𫏐断，分渚流复萦。",
        "伴僧钟磬罢，月来池上明。",
        "友人竟不至，东北见高城。",
        "独游自寂寞，况此恨盈盈。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267574,
      "title": "董公诗",
      "content": [
        "谁主东诸侯，元臣陇西公。",
        "旌节居汴水，四方皆承风。",
        "在朝四十年，天下诵其功。",
        "相我明天子，政成如太宗。",
        "东方有艰难，公乃出临戎。",
        "单车入危城，慈惠安群凶。",
        "公谓其党言，汝材甚骁雄。",
        "为我帐下士，出入卫我躬。",
        "汝息为我子，汝亲我为翁。",
        "众皆相顾泣，无不和且恭。",
        "其父教子义，其妻勉夫忠。",
        "不自以为资，奉上但颙颙。",
        "公衣无文采，公食少肥浓。",
        "所忧在万人，人实我宁空。",
        "轻刑宽其政，薄赋弛租庸。",
        "四郡三十城，不知岁饥凶。",
        "天子临朝喜，元老留在东。",
        "今闻扬盛德，就安我大邦。",
        "百辟贺明主，皇风恩赐重。",
        "朝廷有大事，就决其所从。",
        "海内既无虞，君臣方肃雍。",
        "端居任僚属，宴语常从容。",
        "翩翩者苍乌，来巢于林丛。",
        "甘瓜生场圃，一蔕实连中。",
        "田有嘉谷陇，异亩穗亦同。",
        "贤人佐圣人，德与神明通。",
        "感应我淳化，生瑞我地中。",
        "昔者此州人，但矜马与弓。",
        "今公施德礼，自然威武崇。",
        "公其共百年，受禄将无穷。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267575,
      "title": "祭退之",
      "content": [
        "呜呼吏部公，其道诚巍昂。",
        "生为大贤姿，天使光我唐。",
        "德义动鬼神，鉴用不可详。",
        "独得雄直气，发为古文章。",
        "学无不该贯，吏治得其方。",
        "三次论诤退，其志亦刚强。",
        "再使平山东，不言所谋臧。",
        "荐待皆寒羸，但取其才良。",
        "亲朋有孤稚，婚姻有办营。",
        "如彼天有斗，人可为信常。",
        "如彼岁有春，物宜得华昌。",
        "哀哉未申施，中年遽殂丧。",
        "朝野良共哀，矧于知旧肠。",
        "籍在江湖间，独以道自将。",
        "学诗为众体，久乃溢笈囊。",
        "略无相知人，黯如雾中行。",
        "北游偶逢公，盛语相称明。",
        "名因天下闻，传者入歌声。",
        "公领试士司，首荐到上京。",
        "一来遂登科，不见苦贡场。",
        "观我性朴直，乃言及平生。",
        "由兹类朋党，骨肉无以当。",
        "坐令其子拜，常呼幼时名。",
        "追招不隔日，继践公之堂。",
        "出则连辔驰，寝则对榻床。",
        "搜穷古今书，事事相酌量。",
        "有花必同寻，有月必同望。",
        "为文先见草，酿熟偕共觞。",
        "新果及异鲑，无不相待尝。",
        "到今三十年，曾不少异更。",
        "公文为时师，我亦有微声。",
        "而后之学者，或号为韩张。",
        "我官麟台中，公为大司成。",
        "念此委末秩，不能力自扬。",
        "特状为博士，始获升朝行。",
        "未几享其资，遂忝南宫郎。",
        "是事赖拯扶，如屋有栋梁。",
        "去夏公请告，养疾城南庄。",
        "籍时官休罢，两月同游翔。",
        "黄子陂岸曲，地旷气色清。",
        "新池四平涨，中有蒲荇香。",
        "北台临稻畴，茂柳多阴凉。",
        "板亭坐垂钓，烦苦稍已平。",
        "共爱池上佳，联句舒遐情。",
        "偶有贾秀才，来兹亦同幷。",
        "移船入南溪，东西纵篙撑。",
        "划波激船舷，前后飞鸥鸧。",
        "回入潭濑下，网截鲤与鲂。",
        "踏沙掇水蔬，树下烝新秔。",
        "日来相与嬉，不知暑日长。",
        "柴翁携童儿，聚观于岸傍。",
        "月中登高滩，星汉交垂芒。",
        "钓车掷长线，有获齐欢惊。",
        "夜阑乘马归，衣上草露光。",
        "公为游谿诗，唱咏多慨慷。",
        "自期此可老，结社于其乡。",
        "籍受新官诏，拜恩当入城。",
        "公因同归还，居处隔一坊。",
        "中秋十六夜，魄圆天差晴。",
        "公既相邀留，坐语于堦楹。",
        "乃出二侍女，合弹琵琶筝。",
        "临风听繁丝，忽遽闻再更。",
        "顾我数来过，是夜凉难忘。",
        "公疾浸日加，孺人视药汤。",
        "来候不得宿，出门每回遑。",
        "自是将重危，车马候纵横。",
        "门仆皆逆遣，独我到寝房。",
        "公有旷达识，生死为一纲。",
        "及当临终晨，意色亦不荒。",
        "赠我珍重言，傲然委衾裳。",
        "公比欲为书，遗约有修章。",
        "令我署其末，以为后事程。",
        "家人号于前，其书不果成。",
        "子符奉其言，甚于亲使令。",
        "鲁论未讫注，手迹今微茫。",
        "新亭成未登，闭在庄西厢。",
        "书札与诗文，重叠我笥盈。",
        "顷息万事尽，肠情多摧伤。",
        "旧茔盟津北，野窆动鼓钲。",
        "柳车一出门，终天无回箱。",
        "籍贫无赠赀，曷用申哀诚。",
        "衣器陈下帐，醪饵奠堂皇。",
        "明灵庶鉴知，髣髴斯来飨。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267576,
      "title": "蓟北旅思",
      "content": [
        "日日望乡国，空謌白苎词。",
        "长因送人处，忆得别家时。",
        "失意还独语，多愁祗自知。",
        "客亭门外柳，折尽向南枝。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267577,
      "title": "江南春",
      "content": [
        "江南杨柳春，日暖地无尘。",
        "渡口过新雨，夜来生白苹。",
        "晴沙鸣乳燕，芳树醉游人。",
        "向晚青山下，谁家祭水神。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 267578,
      "title": "西楼望月",
      "content": [
        "城西楼上月，复是雪晴时。",
        "寒夜共来望，思乡独下迟。",
        "幽光落水堑，净色在霜枝。",
        "明日千里去，此中还别离。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267579,
      "title": "别鹤",
      "content": [
        "双鹤出云谿，分飞各自迷。",
        "空巢在松顶，折羽落红泥。",
        "寻水终不饮，逢林亦未栖。",
        "别离应易老，万里雨凄凄。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267580,
      "title": "江陵孝女",
      "content": [
        "孝女独垂发，少年唯一身。",
        "无家空托墓，主祭不从人。",
        "相吊有行客，起庐无旧邻。",
        "江头闻哭处，寂寂楚花春。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267581,
      "title": "山中古祠",
      "content": [
        "春草空祠墓，荒林唯鸟飞。",
        "记年碑石在，经乱祭人稀。",
        "野鼠缘朱帐，阴尘盖画衣。",
        "近门潭水黑，时见宿龙归。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267582,
      "title": "渔阳将",
      "content": [
        "塞深沙草白，都护领燕兵。",
        "放火烧奚帐，分旗筑汉城。",
        "下营看岭势，寻雪觉人行。",
        "更向桑干北，擒生问碛名。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267583,
      "title": "听夜泉",
      "content": [
        "细泉深处落，夜久渐闻声。",
        "独起出门听，欲寻当涧行。",
        "还疑隔林远，复畏有风生。",
        "月下长来此，无人亦到明。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267584,
      "title": "送南迁客",
      "content": [
        "去去远迁客，瘴中衰病身。",
        "青山无限路，白首不归人。",
        "海国战骑象，蛮州市用银。",
        "一家分几处，谁见日南春。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267585,
      "title": "蓟北春怀",
      "content": [
        "渺渺水云外，别来音信稀。",
        "因逢过江使，却寄在家衣。",
        "问路更愁远，逢人空说归。",
        "今朝蓟城北，又见塞鸿飞。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267586,
      "title": "思远人",
      "content": [
        "野桥春水清，桥上送君行。",
        "去去人应老，年年草自生。",
        "出门看远道，无信向边城。",
        "杨柳别离处，秋蝉今复鸣。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267587,
      "title": "赠同溪客",
      "content": [
        "幽居得相近，烟景每寥寥。",
        "共伐临谿树，因为过水桥。",
        "自教青鹤舞，分采紫芝苗。",
        "更爱南峰住，寻君路恐遥。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267588,
      "title": "望行人",
      "content": [
        "秋风窗下起，旅雁向南飞。",
        "日日出门望，家家行客归。",
        "无因见边使，空待寄寒衣。",
        "独倚青楼暮，烟深鸟雀稀。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267589,
      "title": "送宫人入道",
      "content": [
        "旧宠昭阳里，寻仙此最稀。",
        "名初出宫籍，身未称霞衣。",
        "已别歌舞贵，长随鸾鹤飞。",
        "中官看入洞，空驾玉轮归。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267590,
      "title": "送越客",
      "content": [
        "见说孤帆去，东南到会稽。",
        "春云剡溪口，残月镜湖西。",
        "水鹤沙边立，山鼯竹里啼。",
        "谢家曾住处，烟洞入应迷。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267591,
      "title": "赠辟谷者",
      "content": [
        "学得餐霞法，逢人与小还。",
        "身轻曾试鹤，力弱未离山。",
        "无食犬犹在，不耕牛自闲。",
        "朝朝空漱水，叩齿草堂间。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267592,
      "title": "思江南旧游",
      "content": [
        "江臯三月时，花发石楠枝。",
        "归客应无数，春山自不知。",
        "独行愁道远，回信畏家移。",
        "杨柳东西渡，茫茫欲问谁。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 267593,
      "title": "夜到渔家",
      "content": [
        "渔家在江口，潮水入柴扉。",
        "行客欲投宿，主人犹未归。",
        "竹深村路远，月出钓船稀。",
        "遥见寻沙岸，春风动草衣。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267594,
      "title": "送远使",
      "content": [
        "扬旌过陇头，陇水向西流。",
        "塞路依山远，戍城逢笛秋。",
        "寒沙阴漫漫，疲马去悠悠。",
        "为问征行将，谁封定远侯。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267595,
      "title": "不食姑",
      "content": [
        "几年山里住，已作绿毛身。",
        "护气常稀语，存思自见神。",
        "养龟同不食，留药任生尘。",
        "要问西王母，仙中第几人。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267596,
      "title": "古苑杏花",
      "content": [
        "废苑杏花在，行人愁到时。",
        "独开新堑底，半露旧烧枝。",
        "晚色连荒辙，低阴覆折碑。",
        "茫茫古陵下，春尽又谁知。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267597,
      "title": "送流人",
      "content": [
        "独向长城北，黄云暗塞天。",
        "流名属边将，旧业作公田。",
        "拥雪添军垒，收冰当井泉。",
        "知君住应老，须记别乡年。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267598,
      "title": "宿临江驿",
      "content": [
        "楚驿南渡口，夜深来客稀。",
        "月明见潮上，江静觉鸥飞。",
        "旅宿今已远，此行殊未归。",
        "离家久无信，又听捣寒衣。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267599,
      "title": "送蛮客",
      "content": [
        "借问炎州客，天南几日行。",
        "江连恶谿路，山遶夜郎城。",
        "柳叶瘴云湿，桂丛蛮鸟声。",
        "知君却回日，记得海花名。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267600,
      "title": "襄国别友",
      "content": [
        "晓色荒城下，相看秋草时。",
        "独游无定计，不欲道来期。",
        "别处去家远，愁中驱马迟。",
        "归人渡烟水，遥暎野棠枝。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267601,
      "title": "送远客",
      "content": [
        "南原相送处，秋水草还生。",
        "同作忆乡客，如今分路行。",
        "因谁寄归信，渐远问前程。",
        "明日重阳节，无人上古城。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267602,
      "title": "山中赠日南僧",
      "content": [
        "独向双峰老，松门闭两崖。",
        "翻经上蕉叶，挂衲落藤花。",
        "甃石新开井，穿林自种茶。",
        "时逢海南客，蛮语问谁家。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267603,
      "title": "征西将",
      "content": [
        "黄沙北风起，半夜又翻营。",
        "战马雪中宿，探人冰上行。",
        "深山旗未展，阴碛鼓无声。",
        "几道征西将，同收碎叶城。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267604,
      "title": "寄友人",
      "content": [
        "忆在江南日，同游三月时。",
        "采茶寻远涧，鬬鸭向春池。",
        "送客沙头宿，招僧竹里碁。",
        "如今各千里，无计得相随。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267605,
      "title": "送防秋将",
      "content": [
        "白首征西将，犹能射戟支。",
        "元戎选部曲，军吏换旌旗。",
        "逐虏招降远，开边旧垒移。",
        "重收陇外地，应似汉家时。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267606,
      "title": "律僧",
      "content": [
        "苦行长不出，清羸最少年。",
        "持斋唯一食，讲律岂曾眠。",
        "避草每移径，滤虫还入泉。",
        "从来天竺法，到此几人传。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267607,
      "title": "山中秋夜",
      "content": [
        "寂寂山景静，幽人归去迟。",
        "横琴当月下，压酒及花时。",
        "冷露湿茆屋，暗泉冲竹篱。",
        "西峰采药伴，此夕恨无期。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267608,
      "title": "送南客",
      "content": [
        "行路雨修修，青山尽海头。",
        "天涯人去远，岭北水空流。",
        "夜市连铜柱，巢居属象州。",
        "来时旧相识，谁向日南游。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267609,
      "title": "宿江店",
      "content": [
        "野店临西浦，门前有橘花。",
        "停灯待贾客，卖酒与渔家。",
        "夜静江水白，路回山月斜。",
        "闲寻泊船处，潮落见平沙。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267610,
      "title": "岭表逢故人",
      "content": [
        "过岭万余里，旅游经此稀。",
        "相逢去家远，共说几时归。",
        "海上见花发，瘴中唯鸟飞。",
        "炎州望乡伴，自识北人衣。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267611,
      "title": "出塞",
      "content": [
        "秋塞雪初下，将军远出师。",
        "分营长记火，放马不收旗。",
        "月冷边帐湿，沙昏夜探迟。",
        "征人皆白首，谁见灭胡时。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 267612,
      "title": "寄紫阁隐者",
      "content": [
        "紫阁气沉沉，先生住处深。",
        "有人时得见，无路可相寻。",
        "夜鹿伴茅屋，秋猿守栗林。",
        "唯应采灵药，更不别营心。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267613,
      "title": "夜宿黑灶溪",
      "content": [
        "夜到碧溪里，无人秋月明。",
        "逢幽更移宿，取伴亦探行。",
        "花下红泉色，云西乳鹤声。",
        "明朝记归处，石上自书名。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267614,
      "title": "古树",
      "content": [
        "古树枝柯少，枯来复几春。",
        "露根堪系马，空腹定藏人。",
        "蠹节莓苔老，烧痕霹雳新。",
        "若当江浦上，行客祭为神。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267615,
      "title": "送徐先生归蜀",
      "content": [
        "日暮远归处，云间仙观钟。",
        "唯持青玉牒，独立碧鸡峰。",
        "阴涧长收乳，寒泉旧养龙。",
        "几时因卖药，得向海边逢。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267616,
      "title": "隐者",
      "content": [
        "先生已得道，市井亦容身。",
        "救病自行药，得钱多与人。",
        "问年长不定，传法又非真。",
        "每见邻家说，时闻使鬼神。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267617,
      "title": "送友人归山",
      "content": [
        "出山成北首，重去结茅庐。",
        "移石修废井，埽龛盛旧书。",
        "开田留杏树，分洞与僧居。",
        "长在幽峰里，樵人见亦疎。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 267618,
      "title": "霅溪西亭晚望",
      "content": [
        "霅水碧悠悠，西亭柳岸头。",
        "夕阴生远岫，斜照逐回流。",
        "此地动归思，逢人方倦游。",
        "吴兴耆旧尽，空见白苹州。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267619,
      "title": "哭山中友人",
      "content": [
        "入云遥便哭，山友隔今生。",
        "遶墓招魂魄，镌岩记姓名。",
        "犬因无主善，鹤为见人鸣。",
        "长说能尸解，多应别路行。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267620,
      "title": "答僧拄杖",
      "content": [
        "灵籐为拄杖，白净色如银。",
        "得自高僧手，将扶病客身。",
        "春游不骑马，夜会亦呈人。",
        "持此归山去，深宜戴角巾。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267621,
      "title": "灵都观李道士",
      "content": [
        "仙观雨来静，遶房琼草春。",
        "素书天上字，花洞古时人。",
        "泥灶煮灵液，埽坛朝玉真。",
        "几回游阆苑，青节亦随身。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267622,
      "title": "送韦评事归华阴",
      "content": [
        "三峰西面住，出见世人稀。",
        "老大谁相识，恓惶又独归。",
        "埽窗秋菌落，开箧夜蛾飞。",
        "若向云中伴，还应着褐衣。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267623,
      "title": "送闽僧",
      "content": [
        "几夏京城住，今朝独远归。",
        "修行四分律，护净七条衣。",
        "谿寺黄橙熟，沙田紫芋肥。",
        "九龙潭上路，同去客应稀。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267624,
      "title": "送海南客归旧岛",
      "content": [
        "海上去应远，蛮家云岛孤。",
        "竹船来桂浦，山市卖鱼须。",
        "入国自献宝，逢人多赠珠。",
        "却归春洞口，斩象祭天吴。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267625,
      "title": "登咸阳北寺楼",
      "content": [
        "高秋原上寺，下马一登临。",
        "渭水西来直，秦山南向深。",
        "旧宫人不住，荒碣路难寻。",
        "日暮凉风起，萧条多远心。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267626,
      "title": "送新罗使",
      "content": [
        "万里为朝使，离家今几年。",
        "应知旧行路，却上远归船。",
        "夜泊避蛟窟，朝炊求岛泉。",
        "悠悠到乡国，还望海西天。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267627,
      "title": "宿广德寺寄从舅",
      "content": [
        "古寺客堂空，开帘四面风。",
        "移床动栖鹤，停烛聚飞虫。",
        "闲卧逐凉处，远愁生静中。",
        "林西微月色，思与宁家同。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267628,
      "title": "宿邯郸馆寄马磁州",
      "content": [
        "孤客到空馆，夜寒愁卧迟。",
        "虽沽主人酒，不似在家时。",
        "几宿得欢笑，如今成别离。",
        "明朝行更远，回望隔山陂。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267629,
      "title": "舟行寄李湖州",
      "content": [
        "客愁无次第，川路重辛勤。",
        "藻密行舟涩，湾多转檝频。",
        "薄游空感惠，失计自怜贫。",
        "赖有汀洲句，时时慰远人。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267630,
      "title": "送闲师归江南",
      "content": [
        "徧住江南寺，随缘到上京。",
        "多生修律业，外学得诗名。",
        "讲殿偏追入，斋家别请行。",
        "青枫乡路远，几日尽归程。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 267631,
      "title": "游襄阳山寺",
      "content": [
        "秋色江边路，烟霞若有期。",
        "寺贫无利施，僧老足慈悲。",
        "薜荔侵禅窟，虾蟆占浴池。",
        "闲游殊未徧，即是下山时。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267632,
      "title": "登城寄王秘书建",
      "content": [
        "闻君鹤岭住，西望日依依。",
        "远客偏相忆，登城独不归。",
        "十年为道侣，几处共柴扉。",
        "今日烟霞外，人间得见稀。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267633,
      "title": "送从弟戴玄往苏州",
      "content": [
        "杨柳阊门路，悠悠水岸斜。",
        "乘舟向山寺，着屐到渔家。",
        "夜月红柑树，秋风白藕花。",
        "江天诗景好，回日莫令赊。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267634,
      "title": "送朱庆余及第归越",
      "content": [
        "东南归路远，几日到乡中。",
        "有寺山皆遍，无家水不通。",
        "湖声莲叶雨，野气稻花风。",
        "州县知名久，争邀与客同。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267635,
      "title": "过贾岛野居",
      "content": [
        "青门坊外住，行坐见南山。",
        "此地去人远，知君终日闲。",
        "蛙声篱落下，草色户庭间。",
        "好是经过处，唯愁暮独还。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267636,
      "title": "酬韩庶子",
      "content": [
        "西街幽僻处，正与嬾相宜。",
        "寻寺独行远，借书常送迟。",
        "家贫无易事，身病足闲时。",
        "寂寞谁相问，祗应君自知。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267637,
      "title": "赠姚合少府",
      "content": [
        "病来辞赤县，案上有丹经。",
        "为客烧茶灶，教儿埽竹亭。",
        "诗成添旧卷，酒尽卧空缾。",
        "阙下今遗逸，谁瞻隐士星。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267638,
      "title": "送僧游五台兼谒李司空",
      "content": [
        "远去见双节，因行上五台。",
        "化楼侵晓出，雪路向春开。",
        "边寺连峰去，胡儿听法来。",
        "定知巡礼后，解夏始应回。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267639,
      "title": "送郑秀才归宁",
      "content": [
        "桂檝彩为衣，行当令节归。",
        "夕潮迷浦远，昼雨见人稀。",
        "野芰到时熟，江鸥泊处飞。",
        "离琴一奏罢，山雨霭余晖。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267640,
      "title": "送李评事游越",
      "content": [
        "未习风尘事，初为吴越游。",
        "露沾湖草晚，日照海山秋。",
        "梅市门何在，兰亭水尚流。",
        "西陵待潮处，知汝不胜愁。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267641,
      "title": "夏日闲居",
      "content": [
        "无事门多闭，偏知夏日长。",
        "早蝉声寂寞，新竹气清凉。",
        "闲对临书案，看移晒药床。",
        "自怜归未得，犹寄在班行。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    }
  ],
