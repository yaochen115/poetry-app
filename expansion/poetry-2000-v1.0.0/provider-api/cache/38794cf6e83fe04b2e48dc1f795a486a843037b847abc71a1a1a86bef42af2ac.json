{
  "data": [
    {
      "id": 176804,
      "title": "武成致斋奉酬吴冲卿寺丞太学宿直见寄二首  其一",
      "content": [
        "广文更直太常斋，咫尺无从尽素怀。",
        "不及清风得随意，夜深容易过天街。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 176805,
      "title": "武成致斋奉酬吴冲卿寺丞太学宿直见寄二首  其二",
      "content": [
        "雪后余冰尚缀簷，月华霜气入疏帘。",
        "难堪琼玉惊心骨，坐觉清寒几倍添。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 176806,
      "title": "雪中寻友人不遇",
      "content": [
        "拥袖犯风雪，驱车行诣谁。",
        "朱门不可入，素友复难期。",
        "依世诚多拙，迷方忽自悲。",
        "褊心终寡合，吾道易参差。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176807,
      "title": "河边晚望",
      "content": [
        "高浪崩奔卷白沙，悠悠极望入天涯。",
        "谁能脱落尘中意，乘兴东游坐石槎。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 176808,
      "title": "早春寄东郡旧同僚",
      "content": [
        "楼台带余雪，寒色未全收。",
        "久负入关意，空为同舍羞。",
        "清樽接胜友，飞盖从贤侯。",
        "应恨春来晚，烟林已数游。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176809,
      "title": "边将  其一",
      "content": [
        "红旗一簇聚山椒，霁日清风看射雕。",
        "脱帽少年遥稽首，汉家新将霍嫖姚。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 176810,
      "title": "边将  其二",
      "content": [
        "月白星稀霜气多，卷旗束甲涉葱河。",
        "田家不觉官军度，夜半只闻风雨过。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 176811,
      "title": "边将  其三",
      "content": [
        "横吹长笛千万骑，将军塞北立功回。",
        "边人争出孤城望，渐见旌旗天外来。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 176812,
      "title": "渔父",
      "content": [
        "楚岸橘花香，扁舟泛渺茫。",
        "短蓑冲密雨，素髪净秋霜。",
        "烟外鸣桹远，波间掷线长。",
        "无人识名姓，击楫入沧浪。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176813,
      "title": "早春  其一",
      "content": [
        "梅梢柳萼未全开，日澹风和春意来。",
        "雨后谁家有桃李，会须多买及时栽。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 176814,
      "title": "早春  其二",
      "content": [
        "璿霄转斗车，春意逼梅花。",
        "熟寐侵街鼓，闲情到酒家。",
        "晴阳浮地末，寒色敛天涯。",
        "归鴈空余迹，朝来印浦沙。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176815,
      "title": "山中早春",
      "content": [
        "山木欣欣意，春光次第催。",
        "欹巾望归鴈，伏槛听新雷。",
        "岩静闻冰折，巢空喜燕来。",
        "涧花从寂寞，亦向草堂开。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176816,
      "title": "赠学仙者",
      "content": [
        "微迳透重峦，茅堂竹叶冠。",
        "方瞳映骨静，秀气逼人寒。",
        "夜火装丹灶，晴霜醮石坛。",
        "不须惊浅俗，轻举入云端。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176817,
      "title": "留别友生",
      "content": [
        "野际共为别，客亭芳草新。",
        "何心更执酒，满目尽伤春。",
        "今古无穷路，东西相背尘。",
        "行行复回首，不欲着鞭频。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176818,
      "title": "二月六日初见待漏房前柳色微绿欣然成咏",
      "content": [
        "宫城映出丝丝绿，顿觉皇州春意回。",
        "从此不辞驱瘦马，六街终日踏尘埃。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 176819,
      "title": "垂柳",
      "content": [
        "天意清和二月初，春风不动整如梳。",
        "陶潜宅外时无此，想更萧条不易居。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 176820,
      "title": "闲居",
      "content": [
        "故人通贵绝相过，门外真堪置雀罗。",
        "我已幽慵僮更懒，雨来春草一番多。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 176821,
      "title": "中秋陪张龙图䜩射堂初夕阴云酒行顿解喜而成咏",
      "content": [
        "飞盖共徘徊，西园高宴开。",
        "秋云惜明月，留待庾公来。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 176822,
      "title": "贻宋四行简迪",
      "content": [
        "离群如几辰，屈指十青春。",
        "不意轮蹄迹，共兹京洛尘。",
        "文场投漆契，客路转蓬身。",
        "别易相逢阔，过从莫厌频。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176823,
      "title": "自嘲",
      "content": [
        "盘飧罗新蔬，充腹不求余。",
        "穷巷昼扃户，闲轩卧读书。",
        "有心齐塞马，无意羡川鱼。",
        "世道方邀逐，如君术已疏。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176824,
      "title": "醉",
      "content": [
        "厚于太古暖于春，耳目无营见道真。",
        "果使屈原知醉趣，当年不作独醒人。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 176825,
      "title": "雪寒取酒",
      "content": [
        "雪意久未就，寒云低不收。",
        "飘扬插孤帜，迢递映高楼。",
        "试假贤人浊，聊攻客子愁。",
        "呼僮携小榼，更凖黑貂裘。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176826,
      "title": "虞部刘员外约游金明光以贱事失期刘惠诗见嘲以诗四首谢之  其一",
      "content": [
        "丝管嘈嘈耳不分，绮罗杂踏自成春。",
        "不唯汉帝昆明小，更觉唐家曲水贫。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 176827,
      "title": "虞部刘员外约游金明光以贱事失期刘惠诗见嘲以诗四首谢之  其二",
      "content": [
        "绛阙朝归散玉珂，不游不饮奈春何。",
        "皇仁聼使欢娱极，白简从君冷峭多。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 176828,
      "title": "虞部刘员外约游金明光以贱事失期刘惠诗见嘲以诗四首谢之  其三",
      "content": [
        "碧柳红桃照眼春，绮肴芳醴集朝绅。",
        "自嫌林野疏顽迹，难预风流席上宾。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 176829,
      "title": "虞部刘员外约游金明光以贱事失期刘惠诗见嘲以诗四首谢之  其四",
      "content": [
        "上苑花繁高覆墙，曲堤风暖柳丝长。",
        "炉边应有步兵尉，瓮下难寻吏部郎。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 176830,
      "title": "孙器之奉使淮浙至江为书见寄以诗谢之  其一",
      "content": [
        "韊矢迎山驿，轺车下帝台。",
        "夜看牛斗分，应有使星来。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 176831,
      "title": "孙器之奉使淮浙至江为书见寄以诗谢之  其二",
      "content": [
        "晓棹旌旗迥，暮河钲鼓喧。",
        "商船极目避，汉使一何尊。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 176832,
      "title": "孙器之奉使淮浙至江为书见寄以诗谢之  其三",
      "content": [
        "吴酿木兰春，红鲈白锦鳞。",
        "玉盘聊下筯，初识紫丝莼。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 176833,
      "title": "孙器之奉使淮浙至江为书见寄以诗谢之  其四",
      "content": [
        "岫贴晴天阔，舟缘石岸深。",
        "遥知作书处，缆袅绿波心。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 176834,
      "title": "孙器之奉使淮浙至江为书见寄以诗谢之  其五",
      "content": [
        "沙溆鸖争飞，波光可染衣。",
        "松江异淇水，信美不如归。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 176835,
      "title": "和国子夏主簿李花",
      "content": [
        "儒宫岑寂觉春闲，仙李繁花重压栏。",
        "碎锦不飞蒙树合，素云欹亚举枝难。",
        "能诗此日当推谢，捧赐他年足继桓。",
        "更约雕盘荐秋实，岂徒秾艳一朝看。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 176836,
      "title": "送聂之美摄尉韦城",
      "content": [
        "徒劳已足倦，漂泊益栖遑。",
        "短剑无三尺，征衣共一囊。",
        "折腰从事马，赞谒使君堂。",
        "并日屡承檄，无时不裹粮。",
        "官曹大児戏，弓槊小军行。",
        "破柱翻偷窟，倾林索盗囊。",
        "村墟旅颜黑，风日故衫黄。",
        "暝宿投烟舍，朝餐荫道桑。",
        "唯忧课书殿，岂慕荐飞章。",
        "志气空磅礴，才华浪激昂。",
        "镌镵圭始莹，磨拂鉴尤光。",
        "衣褐仍纒袴，无羞俗吏装。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 176837,
      "title": "送吴辨叔大名司户  其一",
      "content": [
        "元宰司宫钥，旌旄压大河。",
        "敢言趋府倦，私叹折腰多。",
        "机发何妨避，光尘未免和。",
        "艰难方远到，庆阀肯蹉跎。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176838,
      "title": "送吴辨叔大名司户  其二",
      "content": [
        "致远必自近，如君岂椽曹。",
        "鱼龙试春浪，松栝露秋毫。",
        "错落辞华富，硁𥐪气节高。",
        "垂天起肤寸，无叹走尘劳。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176839,
      "title": "送杨太祝知长洲县",
      "content": [
        "三吴佳县首，民物旧熙熙。",
        "专用清谈治，非如俗吏为。",
        "林疏丹橘迥，稻熟白芒欹。",
        "宜使民无忘，严修太伯祠。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176840,
      "title": "和邵兴宗秋夜学舍宿直",
      "content": [
        "直舍逍遥度清夜，暂投逢掖解儒冠。",
        "高楼影背星河转，疏竹气兼风露寒。",
        "篱下黄花新蘂乱，门边碧柳旧株残。",
        "折腰把板今无有，勿似陶潜遂弃官。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 176841,
      "title": "和吴冲卿病中偶书呈诸同舍光时亦卧疾",
      "content": [
        "病来门不扫，秋草翳吾庐。",
        "弃置贤人酒，萧条长者车。",
        "冥迷床鬬蚁，润溽箧生鱼。",
        "药物从无继，箪瓢自有余。",
        "形神寂可吊，身世邈相疏。",
        "何事文园客，痟中亦著书。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 176842,
      "title": "月下小饮",
      "content": [
        "美景赏心相值难，良宵四座尽儒冠。",
        "月华过冷衣襟润，酒力易消樽俎寒。",
        "自有笑谈供逸气，不须丝竹借余欢。",
        "坊楼五鼓欲催曙，桂影长先高兴阑。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 176843,
      "title": "又绝句",
      "content": [
        "举首孤轮不似遥，尊前狂气出云霄。",
        "常娥不惜惜丹桂，欲就高枝挂酒瓢。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 176844,
      "title": "马病",
      "content": [
        "羸病何其久，仁心到栈频。",
        "须怜苜蓿歉，当认主人贫。",
        "客舍同萧索，山程共苦辛。",
        "未能逢伯乐，且可自相亲。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176845,
      "title": "入塞",
      "content": [
        "万骑入榆关，臯兰苦战还。",
        "摧锋佩刀缺，蹋血马蹄殷。",
        "铙吹来风外，牛羊出雾间。",
        "须知沙塞恶，壮士变衰颜。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176846,
      "title": "喜孙器之来自共城",
      "content": [
        "取友不无人，爱君天性真。",
        "远寻穷巷宅，未拂满衣尘。",
        "主礼贫尤重，交情别更亲。",
        "谁家酿醇酒，尽醉准衣巾。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176847,
      "title": "送韩太祝知钱塘",
      "content": [
        "冠佩鬰相映，由来积德家。",
        "一时推隽异，四海走声华。",
        "图籍添舟重，江山忘路賖。",
        "夷涂指霄汉，跼骥不须嗟。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176848,
      "title": "和聂之美鴈",
      "content": [
        "汲汲复栖栖，往来谁与期。",
        "映云才可见，入雾杳难追。",
        "羁枕梦初断，寒闺涕已危。",
        "冥冥远缯缴，愧尔独知时。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176849,
      "title": "送王太祝知伊阙",
      "content": [
        "百里驩迎新令贤，儒经吏术尽家传。",
        "天开岭阜竦双阙，地杂桑麻隘一川。",
        "锦雉驯飞春陌上，雪凫高去夕岚边。",
        "长才久屈君无限，所惜斯民受赐偏。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 176850,
      "title": "庆历七年祀南郊礼毕贺赦",
      "content": [
        "雷鼓千通破大幽，天开狱钥纵累囚。",
        "驿书散出先飞鸟，一日恩流四百州。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 176851,
      "title": "送张太博知岳州",
      "content": [
        "严风秀木折为薪，得罪由来为出群。",
        "粥粥黄鸡憎鸖介，芄芄青蔓掩兰薰。",
        "天资谗嫉多端巧，人极精明不易分。",
        "饮水岂言吴刺史，谤书翻似马将军。",
        "波涛汹涌动寒野，楼阁嶣嶤压暮云。",
        "红叶寺深秋暖见，苍山钟迥夜清闻。",
        "何妨绝境聊为中，正恐中朝亟用君。",
        "身外百愁俱掷置，放歌沈饮且醺醺。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 176852,
      "title": "和之美河西列岫亭",
      "content": [
        "秋山对疏牖，羁客倦登临。",
        "雨后岚光活，晴初落照深。",
        "素波明别浦，赤叶照衰林。",
        "伫目寂无语，何人知此心。",
        "亭臯资远瞩，秋思浩无涯。",
        "鴈唼牵菱蔓，童歌出荻花。",
        "垄荒犹叱犊，枝暗稍栖鸦。",
        "烟霭藏东渚，凭轩莫望家。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 176853,
      "title": "书事",
      "content": [
        "志士喜功业，感时心易劳。",
        "蘖栽终栝柏，荒蔓任蓬蒿。",
        "梁竦慵为吏，萧咸耻诣曹。",
        "风霜果不变，会见出云高。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176854,
      "title": "钓鱼有感  其一",
      "content": [
        "垂竿临晚岸，坚坐据莓苔。",
        "饵落萍初散，鱼惊荷暂开。",
        "有求虽琐细，未获且低回。",
        "君识磻磎老，曾垂绿髪来。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176855,
      "title": "钓鱼有感  其二",
      "content": [
        "野钓披榛竹，无人知往来。",
        "高空飞不下，鸥鸟已相猜。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 176856,
      "title": "田家",
      "content": [
        "未塞豪人夺，何言公赋收。",
        "皇心虽恻隐，蓬户或焦愁。",
        "为吏空多禄，无人能此忧。",
        "知君坐公府，佗日富民侯。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176857,
      "title": "和人苇花",
      "content": [
        "葭菼迷河曲，高秋一番荣。",
        "齐纨张野白，楚练照川明。",
        "不夜月长皎，逾时雪未晴。",
        "万仙霓帔合，千亩玉苗生。",
        "漠漠波澜偃，茫茫沙碛平。",
        "际空盐海竭，垂地塞云横。",
        "日暖鸥无色，风高鹤有声。",
        "逢君得嘲赋，岂愧束薪并。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 176858,
      "title": "送赵书记之官华州",
      "content": [
        "车马西城外，遥遥未有尘。",
        "辞梁犹带雪，过洛渐生春。",
        "幕府斜依岳，关山曲抱秦。",
        "曩来谟画拙，不必笑前人。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176859,
      "title": "寄题陟屺寺",
      "content": [
        "郑南峰下寺前轩，反景分明见渭川。",
        "为报十年容易别，于今愁悴不如先。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 176860,
      "title": "寄郑县史令千之  其一",
      "content": [
        "怜君比比得佳县，胜概闲情双有余。",
        "为看西溪日沈后，如何南浦月生初。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 176861,
      "title": "寄郑县史令千之  其二",
      "content": [
        "长春宫柳远扶疏，新树应多旧已枯。",
        "蠧柱苔墙偏寻历，古亭犹有杜诗无。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 176862,
      "title": "送华亭沈主簿",
      "content": [
        "执袂青门道，萧萧马欲东。",
        "暮云零落翠，远树浅深红。",
        "楚泽吟声里，吴山醉眼中。",
        "相思杳何许，野鹤唳高风。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176863,
      "title": "闰正月十五日夜监直对月怀诸同舍  其一",
      "content": [
        "雾浄金波溢，天开碧幕空。",
        "夜寒虽料峭，春意自冲融。",
        "熠熠枝上露，翛翛竹杪风。",
        "暂还林野兴，不似畜樊笼。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176864,
      "title": "闰正月十五日夜监直对月怀诸同舍  其二",
      "content": [
        "澹薄春云散，低昂北斗横。",
        "微分汉津鴈，静识建章更。",
        "浊酒怜虚爵，高文忆友生。",
        "前轩空不掩，怅息负孤清。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176865,
      "title": "归鴈",
      "content": [
        "亦知南国稻粱肥，水满春江努力归。",
        "闻道楚人缯缴细，平沙短草尽藏机。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 176866,
      "title": "忆庞之道",
      "content": [
        "畴昔两垂髫，知音结久要。",
        "何言半涂别，不待歳寒雕。",
        "幸有才名在，非随气运消。",
        "英灵犹仿佛，宿草已萧萧。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176867,
      "title": "送郑推官赴邠州  其一",
      "content": [
        "形便豳公国，旌旗拥将坛。",
        "秦云低落日，塞树怯春寒。",
        "草檄无留思，投壶不废欢。",
        "还应笑黄卷，寂寂守儒官。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176868,
      "title": "送郑推官赴邠州  其二",
      "content": [
        "百榼行春乐，千弓从猎豪。",
        "苦吟边月冷，飞镝野风高。",
        "奇策鞭殊俗，长缨系不毛。",
        "输君跃马贵，一等着青袍。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176869,
      "title": "送郑推官赴邠州  其三",
      "content": [
        "骄虏已归计，圣朝方寝兵。",
        "时闻候火入，非复塞尘惊。",
        "秋岭无南牧，春田恣北耕。",
        "休穷西海路，辛苦学甘英。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176870,
      "title": "兴宗约游会灵久不闻问以诗趣之",
      "content": [
        "胜地何妨行乐频，万双白璧不赊春。",
        "腊醅已老久未压，杨柳青青不待人。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 176871,
      "title": "清明日兴宗饮赵道士东轩",
      "content": [
        "佳游得令辰，过此不为春。",
        "一境风光秀，万家烟火新。",
        "燕初飞玉殿，草不染香轮。",
        "逼水蒲牙短，围堤柳带匀。",
        "纵谈高出古，落笔健生神。",
        "日暮还醒去，林花应笑人。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 176872,
      "title": "上巳日与太学诸同舍饮王都尉园",
      "content": [
        "冠盖鬰相依，名园花未稀。",
        "游丝萦复展，狂絮堕还飞。",
        "积弩遗风陋，兰亭旧俗微。",
        "何如咏沂水，春服舞雩归。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176873,
      "title": "寄题洪州慈济师西轩",
      "content": [
        "登临传胜绝，怅息未成游。",
        "山气高凌霁，湖光碧照秋。",
        "烟疏茶灶迥，灯冷竹房幽。",
        "安得聊凭槛，萧然洗客愁。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176874,
      "title": "山头春色",
      "content": [
        "天意欲回煦，群生稍鬰蒸。",
        "平田犹未遍，绝岭独先升。",
        "翠色添崖柏，寒声折涧冰。",
        "谁为物外友，挈手共同登。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176875,
      "title": "三月十五日宿魏云夫山庄",
      "content": [
        "先生嫌俗宾，犹与故乡亲。",
        "不惜烟霞地，暂容缰鎻身。",
        "林庐深有径，鸡犬四无邻。",
        "蔌蔌暗花堕，苍苍古柏春。",
        "饭炊松粒细，盘采蕨芽新。",
        "静觉精神健，闲知气味真。",
        "谿泉冷毛髪，山翠湿衣巾。",
        "竹色消酲易，林声破梦频。",
        "客轮来去辙，驿路古今尘。",
        "明日空回首，白云应笑人。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 176876,
      "title": "又七言",
      "content": [
        "闻道山家门镇开，独驱瘦马出尘埃。",
        "白云明月先无约，何事今宵亦此来。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 176877,
      "title": "留别逢吉",
      "content": [
        "君念承明臭味稀，相逢惜别重依依。",
        "会稽太守方坐啸，东郭先生还步归。",
        "乐饮林塘留节物，饯行里舍动光辉。",
        "双旌回去行人发，一带长臯烟雨微。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 176878,
      "title": "陜城桃李零落已尽硖石山中今方盛开马上口占",
      "content": [
        "西望飞花千树暗，东来芳蘂一番新。",
        "行人不惜泥涂倦，喜见年光两处春。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 176879,
      "title": "自渑至洛循糓水行百余里",
      "content": [
        "已烦糓水远相送，更得嵩峰遥见迎。",
        "水碧峰青看未足，却愁前到洛阳城。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 176880,
      "title": "送邵不疑知常州",
      "content": [
        "宦学不营身，京华费十春。",
        "非贪为郡乐，意欲与民亲。",
        "祖帐青门道，归帆扬子津。",
        "江山旧游在，烟火故乡邻。",
        "敢惜离群阔，欣闻得吏循。",
        "嗟余一囊米，溟负鬓丝新。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 176881,
      "title": "送聂之美任鸡泽令",
      "content": [
        "赵魏高气侠，到今风俗然。",
        "椎埋吏难禁，击断世称贤。",
        "明府宜更瑟，罢民庶息肩。",
        "无如茧丝者，急敛纵敲鞭。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176882,
      "title": "送张秘校知分宁",
      "content": [
        "百里大夫官不轻，莫嗟领上髪垂星。",
        "人生糓禄偏宜晚，世路艰难不厌经。",
        "数曲秋江萦县白，几峰霁色入帘青。",
        "于公向日多阴德，已有鹓鶵在帝庭。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 176883,
      "title": "馆宿遇雨怀诸同舍",
      "content": [
        "佳雨濯烦暑，翛然生晓凉。",
        "森沈殿瓦碧，羃历井苔苍。",
        "院静杉篁秀，人闲钟鼓长。",
        "凭谁同把酒，清兴窅相望。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176884,
      "title": "送韩直讲郓州宁亲",
      "content": [
        "车马俨何之，东冈旧有陂。",
        "三年别亲意，千里达家时。",
        "去仕元戎幕，来为太学师。",
        "宁须负斗米，不复断机丝。",
        "物色迎归鞚，光辉入寿卮。",
        "人生无此乐，此乐独君知。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 176885,
      "title": "宣徽使河东经略使郑文肃公挽歌  其一",
      "content": [
        "璿玑敷帝命，金节护边兵。",
        "尽付将军制，真为儒者荣。",
        "扶摇方上击，蒙汜忽西倾。",
        "罢市人相吊，纷纷满百城。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176886,
      "title": "宣徽使河东经略使郑文肃公挽歌  其二",
      "content": [
        "柳翣丧容盛，江山故国遥。",
        "清时独长往，何日重来朝。",
        "事与秋云断，荣如晓梦消。",
        "西风虎丘路，马鬛又嶕峣。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176887,
      "title": "又代孙检讨作二首  其一",
      "content": [
        "湖澄翠岫孤，胜地古东吴。",
        "气象常时秀，英灵何世无。",
        "金闺演王綍，玉帐绾兵符。",
        "炜烨照乡曲，从兹益重儒。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176888,
      "title": "又代孙检讨作二首  其二",
      "content": [
        "人为天地客，处世若浮休。",
        "岂有生长在，祗知名可留。",
        "露沾寒草晚，风啸白杨秋。",
        "地下求文友，应从顾陆游。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176889,
      "title": "送丁秘丞知雍丘",
      "content": [
        "古县跨河流，人繁军市稠。",
        "羽飞朝暮驿，鳞叠往来舟。",
        "兄擅才华久，时推政治尤。",
        "足犹妨老骥，目不碍全牛。",
        "从道西来近，能无东望愁。",
        "时因趋上府，穷巷一相求。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 176890,
      "title": "苦雨",
      "content": [
        "积雨欲侵旬，朝晡漫不分。",
        "苍凉微露日，惨澹已生云。",
        "地半成泥滓，天应厌垢氛。",
        "时闻度鸧鸹，空外自为群。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176891,
      "title": "酬师道雪夜见寄",
      "content": [
        "玉树交横雪后天，银河沉着斗栏干。",
        "笔峰微结冰丝涩，灯晕初成花烬残。",
        "太学先生毡苦薄，公车倦客履仍单。",
        "欲吟佳句到清晓，夜寂愁闻金石寒。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 176892,
      "title": "代叔礼作使北诗",
      "content": [
        "人主爱民物，心无彼此情。",
        "约欢同一国，蒙福遍群生。",
        "玉帛遥相望，风波寂不惊。",
        "熙熙南北海，所至尽升平。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176893,
      "title": "又击毬",
      "content": [
        "肃奉乘轺命，仍陪戏马游。",
        "朋分初迥出，势合复相收。",
        "顾盼华星激，萦回紫电流。",
        "良因重嘉好，礼接使臣优。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176894,
      "title": "送计先辈尉宗城",
      "content": [
        "红尘久帝城，高价动公卿。",
        "竹栢寒方茂，骅骝老更成。",
        "冰霜驱马瘦，书剑束装轻。",
        "丞相虚东阁，遥知倒屣迎。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176895,
      "title": "送赵殿丞归成都",
      "content": [
        "蜀栈锦衣来，高堂绶笥开。",
        "恩辉同日至，喜色共春回。",
        "驷马过邻社，朝裾捧寿杯。",
        "吾生无此乐，空使寸心摧。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176896,
      "title": "送张都官江南东路提刑",
      "content": [
        "楚俗号难治，司刑尤择贤。",
        "危疑片言决，舒惨一方专。",
        "松不雕寒色，丝曾断直弦。",
        "清风过江外，应在下车前。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 176897,
      "title": "送杨秘丞通判扬州",
      "content": [
        "苦闻小杜说扬都，当昔豪华今在无。",
        "江势横来控南楚，地形前不瞰东吴。",
        "万商落日船交尾，一市春风酒并垆。",
        "得意莫忘京国友，踏尘冲雪奉朝趋。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 176898,
      "title": "送光禄王卿致仕归荆南",
      "content": [
        "九列谁云非显涂，人生已不负为儒。",
        "拂衣长揖夔龙贵，散髪还为黄绮徒。",
        "白鹤归飞心自远，青霞高举势何孤。",
        "千金尽与乡人费，不向江头买木奴。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 176899,
      "title": "赠清衍",
      "content": [
        "我厌俗缘苦，空为薄宦牵。",
        "如师真达者，于世亦超然。",
        "敝笠冲尘陌，寒云拥雪天。",
        "崎岖远相顾，深愧此心专。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176900,
      "title": "和道粹春寒趋馆马上口占",
      "content": [
        "残腊尚要春，清寒更著人。",
        "雪华犹惜别，物意倍添新。",
        "云压宫城重，风调玉漏匀。",
        "行游宜结辔，九陌未多尘。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
