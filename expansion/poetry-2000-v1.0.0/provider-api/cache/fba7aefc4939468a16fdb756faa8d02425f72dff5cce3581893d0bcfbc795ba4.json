{
  "data": [
    {
      "id": 268798,
      "title": "放言五首 四",
      "content": [
        "安得心源处处安，何劳终日望林峦。",
        "玉英惟向火中冷，莲叶元来水上干。",
        "宁戚饭牛图底事，陆通歌凤也无端。",
        "孙登不语启期乐，各自当情各自欢。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 268799,
      "title": "放言五首 五",
      "content": [
        "三十年来世上行，也曾狂走趁浮名。",
        "两廻左降须知命，数度登朝何处荣。",
        "乞我杯中松叶满，遮渠肘上柳枝生。",
        "他时定葬烧缸地，卖与人家得酒盛。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 268800,
      "title": "刘二十八以文石枕见赠仍题绝句以将厚意因持壁州鞭酬谢兼广为四韵",
      "content": [
        "枕截文琼珠缀篇，野人酬赠壁州鞭。",
        "用长时节君须策，泥醉风云我要眠。",
        "歌眄彩霞临药灶，执陪仙仗引炉烟。",
        "张骞却上知何日，随会归期在此年。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 268801,
      "title": "奉和严司空重阳日同崔常侍崔郎中及诸公登龙山落帽台佳宴",
      "content": [
        "谢公愁思眇天涯，蜡屐登高为菊花。",
        "贵重近臣光绮席，笑怜从事落乌纱。",
        "萸房暗绽红珠朵，茗椀寒供白露芽。",
        "咏碎龙山归去号，马奔流电妓奔车。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 268802,
      "title": "送王十一郎游剡中",
      "content": [
        "越州都在浙河湾，尘土消沈景象闲。",
        "百里油盆镜湖水，千峰钿朵会稽山。",
        "军城楼阁随高下，禹庙烟霞自往还。",
        "想得玉郎乘画舸，几回明月坠云间。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 268803,
      "title": "送友封",
      "content": [
        "轻风略略柳欣欣，晴色空蒙远似尘。",
        "斗柄未回犹带闰，江痕潜上已生春。",
        "兰成宅里寻枯树，宋玉亭前别故人。",
        "心断洛阳三两处，窈娘堤抱古天津。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 268804,
      "title": "送致用",
      "content": [
        "泪霑双袖血成文，不为悲身为别君。",
        "望鹤眼穿期海外，待乌头白老江𣸣。",
        "遥看逆浪愁翻雪，渐失征帆错认云。",
        "欲识九回肠断处，浔阳流水逐条分。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 268805,
      "title": "早春登龙山静胜寺时非休澣司空特许是行因赠幕中诸公",
      "content": [
        "谢傅知怜景气新，许寻高寺望江春。",
        "龙文远水吞平岸，羊角轻风旋细尘。",
        "山茗粉含鹰觜嫩，海榴红绽锦窼匀。",
        "归来笑问诸从事，占得闲行有几人。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 268806,
      "title": "书乐天纸",
      "content": [
        "金銮殿里书残纸，乞与荆州元判司。",
        "不忍拈将等闲用，半封京信半题诗。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268807,
      "title": "酬孝甫见赠十首 一",
      "content": [
        "宋玉秋来续楚词，阴铿官漫足闲诗。",
        "亲情书札相安慰，多道萧何作判司。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268808,
      "title": "酬孝甫见赠十首 二",
      "content": [
        "杜甫天材颇绝伦，每寻诗卷似情亲。",
        "怜渠直道当时语，不著心源傍古人。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268809,
      "title": "酬孝甫见赠十首 三",
      "content": [
        "十岁荒狂任博徒，挼莎五木掷枭卢。",
        "野诗良辅偏怜假，长借金鞍迓酒胡。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268810,
      "title": "酬孝甫见赠十首 四",
      "content": [
        "曾经绰立侍丹墀，绽蘂宫花拂面枝。",
        "雉尾扇开朝日出，柘黄衫对碧霄垂。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268811,
      "title": "酬孝甫见赠十首 五",
      "content": [
        "一自低心翰墨场，箭靫抛尽负书囊。",
        "近来兼爱休粮药，柏叶纱罗杂豆黄。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268812,
      "title": "酬孝甫见赠十首 六",
      "content": [
        "莫笑风尘满病颜，此生元在有无间。",
        "卷舒莲叶终难湿，去住云心一种闲。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268813,
      "title": "酬孝甫见赠十首 七",
      "content": [
        "无事抛棋侵虎口，几时开眼复联行。",
        "终须杀尽缘边敌，四面通同掩大荒。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268814,
      "title": "酬孝甫见赠十首 八",
      "content": [
        "原宪甘贫每自开，子春伤足少人哀。",
        "巷南唯有陈居士，时学文殊一问来。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268815,
      "title": "酬孝甫见赠十首 九",
      "content": [
        "每识闲人如未识，与君相识更相怜。",
        "经旬不解来过宿，忍见空床夜夜眠。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268816,
      "title": "酬孝甫见赠十首 十",
      "content": [
        "开坼新诗展大璆，明珠炫转玉音浮。",
        "酬君十首三更坐，减却常时半夜愁。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268817,
      "title": "和乐天招钱蔚章看山绝句",
      "content": [
        "碧落招邀闲旷望，黄金城外玉方壶。",
        "人间还有大江海，万里烟波天上无。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268818,
      "title": "折枝花赠行",
      "content": [
        "樱桃花下送君时，一寸春心逐折枝。",
        "别后相思最多处，千株万片绕林垂。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268819,
      "title": "寄刘颇二首 一",
      "content": [
        "平生嗜酒颠狂甚，不许诸公占丈夫。",
        "唯爱刘君一片胆，近来还敢似人无。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268820,
      "title": "寄刘颇二首 二",
      "content": [
        "前年碣石烟尘起，共看官军过洛城。",
        "无限公卿因战得，与君依旧绿衫行。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268821,
      "title": "晨起送使病不行因过王十一馆居二首 一",
      "content": [
        "自笑今朝误夙兴，逢他御史疟相仍。",
        "过君未起房门掩，深映寒窗一盏灯。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268822,
      "title": "晨起送使病不行因过王十一馆居二首 二",
      "content": [
        "密宇深房小火炉，饭香鱼熟近中厨。",
        "野人爱静仍耽寝，自问黄昏肯去无。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268823,
      "title": "送孙胜",
      "content": [
        "桐花暗澹柳惺愡，池带轻波柳带风。",
        "今日与君临水别，可怜春尽宋亭中。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268824,
      "title": "游三寺回呈上府主严司空时因寻寺道出当阳县奉命覆视县囚牵于游行不暇详究故以诗自诮尔",
      "content": [
        "谢公恣纵颠狂掾，触处闲行许自由。",
        "举板支颐对山色，当筵吹帽落台头。",
        "贪缘稽首他方佛，无暇精心满县囚。",
        "莫责寻常吐茵吏，书囊赤白报君侯。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 268825,
      "title": "远望",
      "content": [
        "满眼伤心冬景和，一山红树寺边多。",
        "仲宣无限思乡泪，漳水东流碧玉波。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268826,
      "title": "早春寻李校书",
      "content": [
        "款款春风澹澹云，柳枝低作翠栊帬。",
        "梅含鸡舌兼红气，江弄琼花散绿纹。",
        "带雾山莺啼尚小，穿沙芦笋叶才分。",
        "今朝何事偏相觅，撩乱芳情最是君。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 268827,
      "title": "过襄阳楼呈上府主严司空楼在江陵节度使宅北隅",
      "content": [
        "襄阳楼下树阴成，荷叶如钱水面平。",
        "拂水柳花千万点，隔林莺舌两三声。",
        "有时水畔看云立，每日楼前信马行。",
        "早晚暂教王粲上，庾公应待月分明。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 268828,
      "title": "八月六日与僧如展前松滋主簿韦戴同游碧涧寺赋得扉字韵寺临蜀江内有碧涧穿注两廊又有龙女洞能兴云雨诗中喷字以平声韵",
      "content": [
        "空阔长江碍铁围，高低行树倚岩扉。",
        "穿廊玉涧喷红旭，踊墖金轮拆翠微。",
        "草引风轻驯虎睡，洞驱云入毒龙归。",
        "他生莫忘灵山别，满壁人名后会稀。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 268829,
      "title": "奉和窦容州",
      "content": [
        "明公莫讶容州远，一路潇湘景气浓。",
        "斑竹初成二妃庙，碧莲遥耸九疑峰。",
        "禁林闻道长倾凤，池水那能久滞龙。",
        "自叹风波去无极，不知何日又相逢。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 268830,
      "title": "卢头陀诗",
      "content": [
        "卢师深话出家由，剃尽心花始剃头。",
        "马哭青山别车匿，鹊飞螺髻见罗睺。",
        "还来旧日经过处，似隔前身梦寐游。",
        "为向八龙兄弟说，他生缘会此生休。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 268831,
      "title": "醉别卢头陀",
      "content": [
        "醉迷狂象别吾师，梦觉观空始自悲。",
        "尽日笙歌人散后，满江风雨独醒时。",
        "心超几地行无处，云到何天住有期。",
        "顿见佛光身上出，已蒙衣内缀摩尼。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 268832,
      "title": "陪张湖南宴望岳楼稹为监察御史张中丞知杂事",
      "content": [
        "观象楼前奉末班，绛峰只似殿庭间。",
        "今日高楼重陪宴，雨笼衡岳是南山。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268833,
      "title": "岳阳楼",
      "content": [
        "岳阳楼上日衔窗，影到深潭赤玉幢。",
        "怅望残春万般意，满棂湖水入西江。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268834,
      "title": "寄庾敬休",
      "content": [
        "小来同在曲江头，不省春时不共游。",
        "今日江风好暄煖，可怜春尽古湘州。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268835,
      "title": "花栽二首 一",
      "content": [
        "买得山花一两栽，离乡别土易摧隤。",
        "欲知北客居南意，看取南花北地来。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268836,
      "title": "花栽二首 二",
      "content": [
        "南花北地种应难，且向船中尽日看。",
        "纵使将来眼前死，犹胜抛掷在空栏。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268837,
      "title": "宿石矶",
      "content": [
        "石矶江水夜潺湲，半夜江风引杜鹃。",
        "灯暗酒醒颠倒枕，五更斜月入空船。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268838,
      "title": "遭风二十韵",
      "content": [
        "洞庭弥漫接天廻，一点君山似措杯。",
        "暝色已笼秋竹树，夕阳犹带旧楼台。",
        "湘南贾伴乘风信，夏口篙工厄溯洄。",
        "后侣逢滩方拽𥮘，前宗到浦已眠桅。",
        "俄惊四面云屏合，坐见千峰雪浪堆。",
        "罔象睢盱频逞怪，石尤翻动忽成灾。",
        "胜凌岂但河宫溢，坱轧浑忧地轴摧。",
        "疑是阴兵致昏黑，果闻灵鼓借喧豗。",
        "龙归窟穴深潭漩，蜃作波涛古岸隤。",
        "水客暗游烧野火，枫人夜长吼春雷。",
        "浸淫沙市儿童乱，汩没汀洲雁鹜哀。",
        "自叹生涯看转烛，更悲商旅哭沈财。",
        "樯乌斗折头仓掉，水狗斜倾尾缆开。",
        "在昔讵慙横海志，此时甘乏济川才。",
        "历阳旧事曾为鼈，鮌穴相传有化能。",
        "闭目唯愁满空电，冥心真类不然灰。",
        "那知否极休征至，渐觉宵分曙气催。",
        "怪族潜收湖黯湛，幽妖尽走日崔嵬。",
        "紫衣将校临船问，白马君侯傍柳来。",
        "唤上驿亭还酩酊，两行红袖拂樽罍。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 268839,
      "title": "赠崔元儒",
      "content": [
        "殷勤夏口阮元瑜，二十年前旧饮徒。",
        "最爱轻欺杏园客，也曾辜负酒家胡。",
        "些些风景闲犹在，事事颠狂老渐无。",
        "今日头盘三两掷，翠娥潜笑白髭须。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 268840,
      "title": "鄂州寓馆严涧宅",
      "content": [
        "凤有高梧鹤有松，偶来江外寄行踪。",
        "花枝满院空啼鸟，尘榻无人忆卧龙。",
        "心想夜闲唯足梦，眼看春尽不相逢。",
        "何时最是思君处，月入斜窗晓寺钟。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 268841,
      "title": "送杜元颖",
      "content": [
        "江上五年同送客，与君长羡北归人。",
        "今朝又送君先去，千里洛阳城里尘。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268842,
      "title": "贻蜀五首 病马诗寄上李尚书",
      "content": [
        "万里长鸣望蜀门，病身犹带旧疮痕。",
        "遥看云路心空在，久服盐车力渐烦。",
        "尚有高悬双镜眼，何由竝驾两朱轓。",
        "唯应夜识深山道，忽遇君侯一报恩。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 268843,
      "title": "贻蜀五首 李中丞表臣",
      "content": [
        "韦门同是旧亲宾，独恨潘床簟有尘。",
        "十里花谿锦城丽，五年沙尾白头新。",
        "倅戎何事劳专席，老掾甘心逐众人。",
        "却待文星上天去，少分光影照沈沦。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 268844,
      "title": "贻蜀五首 卢评事子蒙",
      "content": [
        "为我殷勤卢子蒙，近来无复昔时同。",
        "懒成积疹推难动，禅尽狂心炼到空。",
        "老爱早眠虚夜月，病妨杯酒负春风。",
        "唯公两弟闲相访，往往潸然一望公。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 268845,
      "title": "贻蜀五首 张校书元夫",
      "content": [
        "未面西川张校书，书来稠叠颇相于。",
        "我闻声价金应敌，众道风姿玉不如。",
        "远处从人须谨慎，少年为事要舒徐。",
        "劝君便是酬君爱，莫比寻常赠鲤鱼。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 268846,
      "title": "贻蜀五首 韦兵曹臧文",
      "content": [
        "处处侯门可曳裙，人人争事蜀尚书。",
        "摩天气直山曾拔，澈底心清水共虚。",
        "鹏翼已翻君好去，乌头未变我何如。",
        "殷勤为话深相感，不学冯谖待食鱼。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 268847,
      "title": "赠严童子",
      "content": [
        "卫瓘诸孙卫玠珍，可怜雏凤好青春。",
        "解拈玉叶排新句，认得金环识旧身。",
        "十岁佩觿娇稚子，八行飞札老成人。",
        "杨公莫讶清无业，家有骊珠不复贫。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 268848,
      "title": "桐孙诗",
      "content": [
        "去日桐花半桐叶，别来桐树老桐孙。",
        "城中过尽无穷事，白发满头归故园。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268849,
      "title": "西归绝句十二首 一",
      "content": [
        "双堠频频减去程，渐知身得近京城。",
        "春来爱有归乡梦，一半犹疑梦里行。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268850,
      "title": "西归绝句十二首 二",
      "content": [
        "五年江上损容颜，今日春风到武关。",
        "两纸京书临水读，小桃花树满商山。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268851,
      "title": "西归绝句十二首 三",
      "content": [
        "同归谏院韦丞相，共贬河南亚大夫。",
        "今日还乡独憔悴，几人怜见白髭须。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268852,
      "title": "西归绝句十二首 四",
      "content": [
        "只去长安六日期，多应及得杏花时。",
        "春明门外谁相待，不梦闲人梦酒巵。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268853,
      "title": "西归绝句十二首 五",
      "content": [
        "白头归舍意如何，贺处无穷吊亦多。",
        "左降去时裴相宅，旧来车马几人过。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268854,
      "title": "西归绝句十二首 六",
      "content": [
        "还乡何用泪沾襟，一半云霄一半沈。",
        "世事渐多饶怅望，旧曾行处便伤心。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268855,
      "title": "西归绝句十二首 七",
      "content": [
        "闲游寺观从容到，遍问亲知次第寻。",
        "肠断裴家光德宅，无人扫地戟门深。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268856,
      "title": "西归绝句十二首 八",
      "content": [
        "一世营营死是休，生前无事定无由。",
        "不知山下东流水，何事长须日夜流。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268857,
      "title": "西归绝句十二首 九",
      "content": [
        "今朝西渡丹河水，心寄丹河无限愁。",
        "若到庄前竹园下，殷勤为遶故山流。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268858,
      "title": "西归绝句十二首 十",
      "content": [
        "寒窗风雪拥深炉，彼此相伤指白须。",
        "一夜思量十年事，几人强健几人无。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268859,
      "title": "西归绝句十二首 十一",
      "content": [
        "云覆蓝桥雪满溪，须臾便与碧峰齐。",
        "风回面市连天合，冻压花枝著水低。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268860,
      "title": "西归绝句十二首 十二",
      "content": [
        "寒花带雪满山腰，著柳冰珠满碧条。",
        "天色渐明回一望，玉尘随马度蓝桥。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268861,
      "title": "留呈梦得子厚致用",
      "content": [
        "泉溜才通疑夜磬，烧烟余暖有春泥。",
        "千层玉帐铺松盖，五出银区印虎蹄。",
        "暗落金乌山渐黑，深埋粉堠路浑迷。",
        "心知魏阙无多地，十二琼楼百里西。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 268862,
      "title": "小碎",
      "content": [
        "小碎诗篇取次书，等闲题柱意何如。",
        "诸郎到处应相问，留取三行代鲤鱼。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268863,
      "title": "和乐天高相宅",
      "content": [
        "莫愁已去无穷事，漫苦如今有限身。",
        "二百年来城里宅，一家知换几多人。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268864,
      "title": "和乐天仇家酒",
      "content": [
        "病嗟酒户年年减，老觉尘机渐渐深。",
        "饮罢醒余更惆怅，不如闲事不经心。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268865,
      "title": "和乐天赠云寂僧",
      "content": [
        "欲离烦恼三千界，不在禅门八万条。",
        "心火自生还自灭，云师无路与君销。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268866,
      "title": "沣西别乐天博载樊宗宪李景信两秀才姪谷三月三十日相饯送",
      "content": [
        "今朝相送自同游，酒语诗情替别愁。",
        "忽到沣西总回去，一身骑马向通州。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268867,
      "title": "寄昙嵩寂三上人",
      "content": [
        "长学对治思苦处，偏将死苦教人间。",
        "今因为说无生死，无可对治心更闲。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268868,
      "title": "题漫天岭智藏师兰若僧云住此二十八年",
      "content": [
        "僧临大道阅浮生，来往憧憧利与名。",
        "二十八年何限客，不曾闲见一人行。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268869,
      "title": "苍溪县寄扬州兄弟",
      "content": [
        "苍溪县下嘉陵水，入峡穿江到海流。",
        "凭仗鲤鱼将远信，雁回时节到扬州。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268870,
      "title": "赠吴渠州从姨兄士则",
      "content": [
        "忆昔分襟童子郎，白头抛掷又他乡。",
        "三千里外巴南恨，二十年前城里狂。",
        "宁氏舅甥俱寂寞，荀家兄弟半沦亡。",
        "泪因生别兼怀旧，廻首江山欲万行。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 268871,
      "title": "长滩梦李绅",
      "content": [
        "孤吟独寝意千般，合眼逢君一夜欢。",
        "慙愧梦魂无远近，不辞风雨到长滩。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268872,
      "title": "新政县",
      "content": [
        "新政县前逢月夜，嘉陵江底看星辰。",
        "已闻城上三更鼓，不见心中一个人。",
        "须鬓暗添巴路雪，衣裳无复帝乡尘。",
        "曾沾几许名兼利，劳动生涯涉苦辛。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 268873,
      "title": "南昌滩",
      "content": [
        "渠江明净峡逶迤，船到明滩拽𥮘迟。",
        "橹窡动摇妨作梦，巴童指点笑吟诗。",
        "畬余宿麦黄山腹，日背残花白水湄。",
        "物色可怜心莫恨，此行都是独行时。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 268874,
      "title": "见乐天诗",
      "content": [
        "通州到日日平西，江馆无人虎印泥。",
        "忽向破簷残漏处，见君诗在柱心题。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268875,
      "title": "夜坐",
      "content": [
        "雨滞更愁南瘴毒，月明兼喜北风凉。",
        "古城楼影横空馆，湿地虫声遶暗廊。",
        "萤火乱飞秋已近，星辰早没夜初长。",
        "孩提万里何时见，狼籍家书满卧床。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 268876,
      "title": "闻乐天授江州司马",
      "content": [
        "残灯无焰影幢幢，此夕闻君谪九江。",
        "垂死病中惊坐起，暗风吹雨入寒窗。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268877,
      "title": "岁日赠拒非",
      "content": [
        "君思曲水嗟身老，我望通州感道穷。",
        "同入新年两行泪，白头翁坐说城中。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268878,
      "title": "送卢戡",
      "content": [
        "红树蝉声满夕阳，白头相送倍相伤。",
        "老嗟去日光阴促，病觉今年昼夜长。",
        "顾我亲情皆远道，念君兄弟欲他乡。",
        "红旗满眼襄州路，此别泪流千万行。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 268879,
      "title": "雨声",
      "content": [
        "风吹竹叶休还动，雨点荷心暗复明。",
        "曾向西江船上宿，惯闻寒夜滴篷声。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268880,
      "title": "奉和荥阳公离筵作",
      "content": [
        "南郡生徒辞绛帐，东山妓乐拥油旌。",
        "钧天排比箫韶待，犹顾人间有别情。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268881,
      "title": "嘉陵水",
      "content": [
        "古时应是山头水，自古流来江路深。",
        "若使江流会人意，也应知我远来心。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268882,
      "title": "阆州开元寺壁题乐天诗",
      "content": [
        "忆君无计写君诗，写尽千行说向谁。",
        "题在阆州东寺壁，几时知是见君时。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268883,
      "title": "凭李忠州寄书乐天",
      "content": [
        "万里寄书将出峡，却凭巫峡寄江州。",
        "伤心最是江头月，莫把书将上庾楼。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268884,
      "title": "得乐天书",
      "content": [
        "远信入门先有泪，妻惊女哭问何如。",
        "寻常不省曾如此，应是江州司马书。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268885,
      "title": "寄乐天",
      "content": [
        "无身尚拟魂相就，身在那无梦往还。",
        "直到他生亦相觅，不能空记树中环。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268886,
      "title": "酬知退",
      "content": [
        "终须修到无修处，闻尽声闻始不闻。",
        "莫著妄心销彼我，我心无我亦无君。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268887,
      "title": "通州",
      "content": [
        "平生欲得山中住，天与通州遶郡山。",
        "睡到日西无一事，月储三万买教闲。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268888,
      "title": "酬乐天书后三韵",
      "content": [
        "今日庐峰霞遶寺，昔时鸾殿凤廻书。",
        "两封相去八年后，一种俱云五夜初。",
        "渐觉此生都是梦，不能将泪滴双鱼。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 268889,
      "title": "相忆泪",
      "content": [
        "西江流水到江州，闻道分成九道流。",
        "我滴两行相忆泪，遣君何处遣人求。",
        "除非入海无由住，纵使逢滩未拟休。",
        "会向伍员潮上见，气充顽石报心雠。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 268890,
      "title": "喜李十一景信到",
      "content": [
        "何事相逢翻有泪，念君缘我到通州。",
        "留君剩住君须住，我不自由君自由。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268891,
      "title": "与李十一夜饮",
      "content": [
        "寒夜灯前赖酒壶，与君相对兴犹孤。",
        "忠州刺史应闲卧，江水猿声睡得无。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268892,
      "title": "赠李十一",
      "content": [
        "淮水连年起战尘，油旌三换一何频。",
        "共君前后俱从事，羞见功名与别人。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268893,
      "title": "寒食日",
      "content": [
        "今年寒食好风流，此日一家同出游。",
        "碧水青山无限思，莫将心道是涪州。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268894,
      "title": "三兄以白角巾寄遗发不胜冠因有感叹",
      "content": [
        "病瘴年深浑秃尽，那能胜置角头巾。",
        "暗梳蓬发羞临镜，私戴莲花耻见人。",
        "白发过于冠色白，银钉少校颔中银。",
        "我身四十犹如此，何况吾兄六十身。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 268895,
      "title": "别李十一五绝 一",
      "content": [
        "巴南分与亲情别，不料与君床竝头。",
        "为我远来休怅望，折君灾难是通州。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268896,
      "title": "别李十一五绝 二",
      "content": [
        "京城每与闲人别，犹自伤心与白头。",
        "今日别君心更苦，别君缘是在通州。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268897,
      "title": "别李十一五绝 三",
      "content": [
        "万里尚能来远道，一程那忍便分头。",
        "鸟笼猿槛君应会，十步向前非我州。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    }
  ],
