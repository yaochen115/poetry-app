{
  "data": [
    {
      "id": 268898,
      "title": "别李十一五绝 四",
      "content": [
        "来时见我江南岸，今日送君江上头。",
        "别后料添新梦寐，虎惊蛇伏是通州。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268899,
      "title": "别李十一五绝 五",
      "content": [
        "闻君欲去潜销骨，一夜暗添新白头。",
        "明朝别后应肠断，独櫂破船归到州。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268900,
      "title": "酬乐天醉别",
      "content": [
        "前回一去五年别，此别又知何日回。",
        "好住乐天休怅望，匹如元不到京来。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268901,
      "title": "酬乐天雨后见忆",
      "content": [
        "雨滑危梁性命愁，差池一步一生休。",
        "黄泉便是通州郡，渐入深泥渐到州。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268902,
      "title": "和乐天过秘阁书省旧厅",
      "content": [
        "闻君西省重徘徊，秘阁书房次第开。",
        "壁记欲题三漏合，吏人惊问十年来。",
        "经排蠹简怜初校，芸长陈根识旧栽。",
        "司马见诗心最苦，满身蚊蚋哭烟埃。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 268903,
      "title": "和乐天赠杨秘书",
      "content": [
        "旧与杨郎在帝城，搜天斡地觅诗情。",
        "曾因竝句甘称小，不为论年便唤兄。",
        "刮骨直穿由苦鬬，梦肠翻出暂闲行。",
        "因君投赠还相和，老去那能竞底名。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 268904,
      "title": "和乐天题王家亭子",
      "content": [
        "风吹笋箨飘红砌，雨打桐花盖绿莎。",
        "都大资人无暇日，泛池全少买池多。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268905,
      "title": "酬乐天频梦微之",
      "content": [
        "山水万重书断绝，念君怜我梦相闻。",
        "我今因病魂颠倒，唯梦闲人不梦君。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268906,
      "title": "琵琶",
      "content": [
        "学语胡儿撼玉玲，甘州破里最星星。",
        "使君自恨常多事，不得工夫夜夜听。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268907,
      "title": "春词",
      "content": [
        "山翠湖光似欲流，蜂声鸟思却堪愁。",
        "西施颜色今何在，但看春风百草头。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268908,
      "title": "酬乐天春寄微之",
      "content": [
        "鹦心明黠雀幽蒙，何事相将尽入笼。",
        "君避海鲸惊浪里，我随巴蟒瘴烟中。",
        "千山塞路音书绝，两地知春历日同。",
        "一树梅花数升酒，醉寻江岸哭东风。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 268909,
      "title": "酬乐天舟泊夜读微之诗",
      "content": [
        "知君暗泊西江岸，读我闲诗欲到明。",
        "今夜通州还不睡，满山风雨杜鹃声。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268910,
      "title": "酬乐天武关南见微之题山石榴花诗",
      "content": [
        "比因酬赠为花时，不为君行不复知。",
        "又更几年还共到，满墙尘土两篇诗。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 268911,
      "title": "酬乐天见寄",
      "content": [
        "三千里外巴虵穴，四十年来司马官。",
        "瘴色满身治不尽，疮痕刮骨洗应难。",
        "常甘人向衰容薄，独讶君将旧眼看。",
        "前日诗中高盖字，至今唇舌遍长安。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 268912,
      "title": "酬乐天得稹所寄纻丝布白轻庸制成衣服以诗报之",
      "content": [
        "湓城万里隔巴庸，纻薄绨轻共一封。",
        "腰带定知今瘦小，衣衫难作远裁缝。",
        "唯愁书到炎凉变，忽见诗来意绪浓。",
        "春草绿茸云色白，想君骑马好仪容。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 268913,
      "title": "和乐天寻郭道士不遇",
      "content": [
        "昔年我见杯中渡，今日人言鹤上逢。",
        "两虎定随千岁鹿，双林添作几株松。",
        "方瞳应是新烧药，短脚知缘旧施舂。",
        "欲请僧繇远相画，苦愁频变本形容。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 268914,
      "title": "酬乐天寄生衣",
      "content": [
        "秋茅处处流痎疟，夜鸟声声哭瘴云。",
        "羸骨不胜纤细物，欲将文服却还君。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268915,
      "title": "酬乐天得微之诗知通州事因成四首 一",
      "content": [
        "茅簷屋舍竹篱州，虎怕偏蹄虵两头。",
        "暗蛊有时迷酒影，浮尘向日似波流。",
        "沙含水弩多伤骨，田仰畬刀少用牛。",
        "知得共君相见否，近来魂梦转悠悠。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 268916,
      "title": "酬乐天得微之诗知通州事因成四首 二",
      "content": [
        "平地才应一顷余，阁栏都大似巢居。",
        "入衙官吏声疑鸟，下峡舟船腹似鱼。",
        "市井无钱论尺丈，田畴付火罢耘锄。",
        "此中愁杀须甘分，惟惜平生旧著书。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 268917,
      "title": "酬乐天得微之诗知通州事因成四首 三",
      "content": [
        "哭鸟昼飞人少见，伥魂夜啸虎行多。",
        "满身沙虱无防处，独脚山魈不奈何。",
        "甘受鬼神侵骨髓，常忧岐路处风波。",
        "南歌未有东西分，敢唱沧浪一字歌。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 268918,
      "title": "酬乐天得微之诗知通州事因成四首 四",
      "content": [
        "荒芜满院不能锄，甑有尘埃圃乏蔬。",
        "定觉身将囚一种，未知生共死何如。",
        "饥摇困尾丧家狗，热暴枯鳞失水鱼。",
        "苦境万般君莫问，自怜方寸本来虚。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 268919,
      "title": "酬乐天闻李尚书拜相以诗见贺",
      "content": [
        "初因弹劾死东川，又为亲情弄化权百口共经三峡水，一时重上两漫天。",
        "尚书入用虽旬月，司马衔冤已十年。",
        "若待更遭秋瘴后，便愁平地有重泉。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 268920,
      "title": "酬乐天叹穷愁见寄",
      "content": [
        "病煎愁绪转纷纷，百里何由说向君。",
        "老去心情随日减，远来书信隔年闻。",
        "三冬有电连春雨，九月无霜尽火云。",
        "并与巴南终岁热，四时谁道各平分。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 268921,
      "title": "酬乐天三月三日见寄",
      "content": [
        "当年此日花前醉，今日花前病里销。",
        "独倚破帘闲怅望，可怜虚度好春朝。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268922,
      "title": "酬乐天叹损伤见寄",
      "content": [
        "前途何在转茫茫，渐老那能不自伤。",
        "病为怕风多睡月，起因花药暂扶床。",
        "函关气索迷真侣，峡水波翻碍故乡。",
        "唯有秋来两行泪，对君新赠远诗章。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 268923,
      "title": "瘴塞",
      "content": [
        "瘴塞巴山哭鸟悲，红妆少妇敛啼眉。",
        "殷勤奉药来相劝，云是前年欲病时。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268924,
      "title": "红荆",
      "content": [
        "庭中栽得红荆树，十月花开不待春。",
        "直到孩提尽惊怪，一家同是北来人。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268925,
      "title": "黄草峡听柔之琴二首 一",
      "content": [
        "胡笳夜奏塞声寒，是我乡音听渐难。",
        "料得小来辛苦学，又因知向峡中弹。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268926,
      "title": "黄草峡听柔之琴二首 二",
      "content": [
        "别鹤凄清觉露寒，离声渐咽命雏难。",
        "怜君伴我涪州宿，犹有心情彻夜弹。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268927,
      "title": "书劒",
      "content": [
        "渝工劒刃皆欧冶，巴吏书踪尽子云。",
        "唯我心知有来处，泊船黄草夜思君。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268928,
      "title": "内状诗寄杨白二员外",
      "content": [
        "天门暗辟玉琤鍧，昼送中枢晓禁清。",
        "彤管内人书细腻，金匳御印篆分明。",
        "冲街不避将军令，跋勅兼题宰相名。",
        "南省郎官谁待诏，与君将向世间行。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 268929,
      "title": "别毅郎 一",
      "content": [
        "尔爷只为一杯酒，此别那知死与生。",
        "儿有何辜才七岁，亦教儿作瘴江行。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268930,
      "title": "别毅郎 二",
      "content": [
        "爱惜尔爷唯有我，我今顦顇望何人。",
        "伤心自比笼中鹤，翦尽翅翎愁到身。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268931,
      "title": "自责",
      "content": [
        "犀带金鱼束紫袍，不能将命报分毫。",
        "他时得见牛常侍，为尔君前捧佩刀。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268932,
      "title": "送公度之福建",
      "content": [
        "棠阴犹在建溪矶，此去那论是与非。",
        "若见白头须尽敬，恐曾江岸识胡威。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268933,
      "title": "喜五兄自泗州至",
      "content": [
        "眼中三十年来泪，一望南云一度垂。",
        "惭愧临淮李常侍，远教形影暂相随。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268934,
      "title": "杏花",
      "content": [
        "常年出入右银台，每怪春光例早回。",
        "惭愧杏园行在景，同州园里也先开。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268935,
      "title": "第三岁日咏春风凭杨员外寄长安柳",
      "content": [
        "三日春风已有情，拂人头面稍怜轻。",
        "殷勤为报长安柳，莫惜枝条动软声。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268936,
      "title": "赠别杨员外巨源",
      "content": [
        "忆昔西河县下时，青山顦顇宦名卑。",
        "揄扬陶令缘求酒，结托萧娘只在诗。",
        "朱紫衣裳浮世重，苍黄岁序长年悲。",
        "白头后会知何日，一盏烦君不用辞。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 268937,
      "title": "寄乐天二首 一",
      "content": [
        "荣辱升沈影与身，世情谁是旧雷陈。",
        "唯应鲍叔犹怜我，自保曾参不杀人。",
        "山入白楼沙苑暮，潮生沧海野塘春。",
        "老逢佳景唯惆怅，两地各伤何限神。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 268938,
      "title": "寄乐天二首 二",
      "content": [
        "论才赋命不相干，凤有文章雉有冠。",
        "羸骨欲销犹被刻，疮痕未没又遭弹。",
        "劒头已折藏须盖，丁字虽刚屈莫难。",
        "休学州前罗刹石，一生身敌海波澜。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 268939,
      "title": "听妻弹别鹤操",
      "content": [
        "别鹤声声怨夜弦，闻君此奏欲潸然。",
        "商瞿五十知无子，更付琴书与仲宣。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268940,
      "title": "和王侍郎酬广宣上人观放牓后相贺",
      "content": [
        "渥洼徒自有权奇，伯乐书名世始知。",
        "竞走墙前希得俊，高县日下表无私。",
        "都中纸贵流传后，海外金填姓字时。",
        "珍重刘繇因首荐，为君送和碧云诗。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 268941,
      "title": "酬乐天喜邻郡",
      "content": [
        "蹇驴瘦马尘中伴，紫绶朱衣梦里身。",
        "符竹偶因成对岸，文章虚被配为邻。",
        "湖翻白浪常看雪，火照红妆不待春。",
        "老大那能更争竞，任君投募醉乡人。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 268942,
      "title": "再酬复言和前篇",
      "content": [
        "经过二郡逢贤牧，聚集诸郎宴老身。",
        "清夜漫劳红烛会，白头非是翠娥邻。",
        "曾携酒伴无端宿，自入朝行便别春。",
        "潦倒微之从不占，未知公议道何人。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 268943,
      "title": "赠乐天",
      "content": [
        "莫言邻境易经过，彼此分符欲奈何。",
        "垂老相逢渐难别，白头期限各无多。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268944,
      "title": "重赠",
      "content": [
        "休遣玲珑唱我诗，我诗多是别君词。",
        "明朝又向江头别，月落潮平是去时。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268945,
      "title": "别后西陵晚眺",
      "content": [
        "晚日未抛诗笔砚，夕阳空望郡楼台。",
        "与君后会知何日，不似潮头暮却廻。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268946,
      "title": "以州宅夸于乐天",
      "content": [
        "州城迥遶拂云堆，镜水稽山满眼来。",
        "四面常时对屏障，一家终日在楼台。",
        "星河似向簷前落，鼓角惊从地底廻。",
        "我是玉皇香案吏，谪居犹得住蓬莱。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 268947,
      "title": "重夸州宅旦暮景色兼酬前篇末句",
      "content": [
        "仙都难画亦难书，暂合登临不合居。",
        "绕郭烟岚新雨后，满山楼阁上灯初。",
        "人声晓动千门辟，湖色宵涵万象虚。",
        "为问西州罗刹岸，涛头冲突近何如。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 268948,
      "title": "酬乐天吟张员外诗见寄因思上京每与乐天于居敬兄升平里咏张新诗",
      "content": [
        "乐天书内重封到，居敬堂前共读时。",
        "四友一为泉路客，三人两咏浙江诗。",
        "别无远近皆难见，老减心情自各知。",
        "杯酒与他年少隔，不相酬赠欲何之。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 268949,
      "title": "寄乐天",
      "content": [
        "闲夜思君坐到明，追寻往事倍伤情。",
        "同登科后心相合，初得官时髭未生。",
        "二十年来谙世路，三千里外老江城。",
        "犹应更有前途在，知向人间何处行。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 268950,
      "title": "戏赠乐天复言",
      "content": [
        "乐事难逢岁易徂，白头光景莫令孤。",
        "弄涛船更曾观否，望市楼还有会无。",
        "眼力少将寻案牍，心情且强掷枭卢。",
        "孙园虎寺随宜看，不必遥遥羡镜湖。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 268951,
      "title": "重酬乐天",
      "content": [
        "红尘扰扰日西徂，我兴云心两共孤。",
        "暂出已遭千骑拥，故交求见一人无。",
        "百篇书判从饶白，八米诗章未伏卢。",
        "最笑近来黄叔度，自投名刺占陂湖。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 268952,
      "title": "再酬复言",
      "content": [
        "绕郭笙歌夜景徂，稽山迥带月轮孤。",
        "休文欲咏心应破，道子虽来画得无。",
        "顾我小才同培𪣻，知君险鬬敌都卢。",
        "不然岂有姑苏郡，拟著陂塘比镜湖。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 268953,
      "title": "郡务稍简因得整比旧诗幷连缀焚削封章委箧仅逾百轴偶成自叹因寄乐天",
      "content": [
        "近来章奏小年诗，一种成空尽可悲。",
        "书得眼昏朱似碧，用来心破发如丝。",
        "催身易老缘多事，报主深恩在几时。",
        "天遣两家无嗣子，欲将文集与它谁。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 268954,
      "title": "酬乐天余思不尽加为六韵之作",
      "content": [
        "律吕同声我尔身，文章君是一伶伦。",
        "众推贾谊为才子，帝喜相如作侍臣。",
        "次韵千言曾报荅，直词三道共经纶。",
        "元诗駮杂真难辨，白朴流传用转新。",
        "蔡女图书虽在口，于公门户岂生尘。",
        "商瞿未老犹希冀，莫把籝金便付人。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 268955,
      "title": "寄乐天",
      "content": [
        "莫嗟虚老海壖西，天下风光数会稽。",
        "灵泛桥前百里镜，石帆山崦五云溪。",
        "冰销田地芦锥短，春入枝条柳眼低。",
        "安得故人生羽翼，飞来相伴醉如泥。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 268956,
      "title": "酬乐天雪中见寄",
      "content": [
        "知君夜听风萧索，晓望林亭雪半糊。",
        "撼落不教封柳眼，埽来偏尽附梅株。",
        "敲扶密竹枝犹亚，煦暖寒禽气渐苏。",
        "坐觉湖声迷远浪，回惊云路在长途。",
        "钱塘湖上苹先合，梳洗楼前粉暗铺。",
        "石立玉童披鹤氅，台施瑶席换龙须。",
        "满空飞舞应为瑞，寡和高歌只自娱。",
        "莫遣拥帘伤思妇，且将盈尺慰农夫。",
        "称觞彼此情何异，对景东西事有殊。",
        "镜水遶山山尽白，琉璃云母世间无。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 268957,
      "title": "和乐天早春见寄",
      "content": [
        "雨香云澹觉微和，谁送春声入櫂歌。",
        "萱近北堂穿土早，柳偏东面受风多。",
        "湖添水色消残雪，江送潮头涌漫波。",
        "同受新年不同赏，无由缩地欲如何。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 268958,
      "title": "酬复言长庆四年元日郡斋感怀见寄",
      "content": [
        "腊尽残销春又归，逢新别故欲沾衣。",
        "自惊身上添年纪，休系心中小是非。",
        "富贵祝来何所遂，聪明鞭得转无机。",
        "羞看稚子先拈酒，怅望平生旧采薇。",
        "去日渐加余日少，贺人虽闹故人稀。",
        "椒花丽句闲重检，艾发衰容惜寸辉。",
        "苦思正旦酬白雪，闲观风色动青旗。",
        "千官仗下炉烟里，东海西头意独违。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 268959,
      "title": "代郡斋神荅乐天",
      "content": [
        "虚白堂神传好语，二年长伴独吟时。",
        "夜怜星月多离烛，日滉波涛一下帷。",
        "为报何人偿酒债，引看墙上使君诗。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 268960,
      "title": "酬乐天重寄别",
      "content": [
        "却报君侯听苦辞，老头抛我欲何之。",
        "武牢关外虽分手，不似如今衰白时。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268961,
      "title": "和乐天重题别东楼",
      "content": [
        "山容水态使君知，楼上从容万状移。",
        "日映文章霞细丽，风驱鳞甲浪参差。",
        "鼓催潮户凌晨击，笛赛婆官彻夜吹。",
        "唤客潜挥远红袖，卖垆高挂小青旗。",
        "賸铺床席春眠处，乍卷帘帷月上时。",
        "光景无因将得去，为郎抄在和郎诗。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 268962,
      "title": "余杭周从事以十章见寄词调清婉难于遍酬聊和诗首篇以荅来贶",
      "content": [
        "扰扰纷纷旦暮间，经营闲事不曾闲。",
        "多缘老病推辞酒，少有功夫久羡山。",
        "清夜笙歌喧四郭，黄昏钟漏下重关。",
        "何由得似周从事，醉入人家醒始还。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 268963,
      "title": "寄浙西李大夫四首 一",
      "content": [
        "柳眼梅心渐欲春，白头西望忆何人。",
        "金陵太守曾相伴，共蹋银台一路尘。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268964,
      "title": "寄浙西李大夫四首 二",
      "content": [
        "蘂珠深处少人知，网索西临太液池。",
        "浴殿晓闻天语后，步廊骑马笑相随。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268965,
      "title": "寄浙西李大夫四首 三",
      "content": [
        "禁林同直话交情，无夜无曾不到明。",
        "最忆西楼人静夜，玉晨钟磬两三声。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268966,
      "title": "寄浙西李大夫四首 四",
      "content": [
        "由来鹏化便图南，浙右虽雄我未甘。",
        "早渡西江好归去，莫抛舟楫滞春潭。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268967,
      "title": "初除浙东妻有阻色因以四韵晓之",
      "content": [
        "嫁时五月归巴地，今日双旌上越州。",
        "兴庆首行千命妇，会稽旁带六诸侯。",
        "海楼翡翠闲相逐，镜水鸳鸯煖共游。",
        "我有主恩羞未报，君于此外更何求。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 268968,
      "title": "为乐天自勘诗集因思顷年城南醉归马上递唱艳曲十余里不绝长庆初俱以制诰侍宿南郊斋宫夜后偶吟数十篇两掖诸公洎翰林学士三十余人惊起就听逮至卒吏莫不众观群公直至侍从行礼之时不复聚寐予与乐天吟哦竟亦不绝因书于乐天卷后越中冬夜风雨不觉将晓诸门互启关锁即事成篇",
      "content": [
        "春野醉吟十里程，斋宫潜咏万人惊。",
        "今宵不寐到明读，风雨晓闻开锁声。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268969,
      "title": "题长庆四年历日尾",
      "content": [
        "残历半张余十四，灰心雪鬓两凄然。",
        "定知新岁御楼后，从此不名长庆年。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268970,
      "title": "乐府古题序 梦上天",
      "content": [
        "梦上高高天，高高苍苍高不极。",
        "下视五岳块累累，仰天依旧苍苍色。",
        "蹋云耸身身更上，攀天上天攀未得。",
        "西瞻若水兔轮低，东望蟠桃海波黑。",
        "日月之光不到此，非暗非明烟塞塞。",
        "天悠地远身跨风，下无阶梯上无力。",
        "来时畏有他人上，截断龙胡斩鹏翼。",
        "茫茫漫漫方自悲，哭向青云椎素臆。",
        "哭声厌咽旁人恶，唤起惊悲泪飘露。",
        "千慙万谢唤厌人，向使无君终不寤。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 268971,
      "title": "乐府古题序 冬白纻",
      "content": [
        "吴宫夜长宫漏款，帘幕四垂灯燄煖。",
        "西施自舞王自管，雪纻翻翻鹤翎散。",
        "促节牵繁舞腰嬾，舞腰嬾，王罢饮。",
        "盖覆西施凤花锦，身作匡床臂为枕。",
        "朝珮枞玉王晏寝，寝醒阍报门无事。",
        "子胥死后言为讳，近王之臣谕王意。",
        "共笑越王穷惴惴，夜夜抱冰寒不睡。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 268972,
      "title": "乐府古题序 将进酒",
      "content": [
        "将进酒，将进酒。",
        "酒中有毒酖主父，言之主父伤主母。",
        "母为妾地父妾天，仰天俯地不忍言。",
        "阳为僵踣主父前，主父不知加妾鞭。",
        "旁人知妾为主说，主将泪洗鞭头血。",
        "推椎主母牵下堂，扶妾遣升堂上床。",
        "将进酒，酒中无毒令主寿。",
        "愿主廻恩归主母，遣妾如此由主父。",
        "妾为此事人偶知，自慙不密方自悲。",
        "主今颠倒安置妾，贪天僭地谁不为。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 268973,
      "title": "乐府古题序 采珠行",
      "content": [
        "海波无底珠沈海，采珠之人判死采。",
        "万人判死一得珠，斛量买婢人何在。",
        "年年采珠珠避人，今年采珠由海神。",
        "海神采珠珠尽死，死尽明珠空海水。",
        "珠为海物海属神，神今自采何况人。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 268974,
      "title": "乐府古题序 董逃行",
      "content": [
        "董逃董逃董卓逃，揩铿戈甲声劳嘈。",
        "剜剜深脐脂燄燄，人皆数叹曰。",
        "尔独不忆年年取我身上膏，膏销骨尽烟火死。",
        "长安城中贼毛起，城门四走公卿士。",
        "走劝刘虞作天子，刘虞不敢作天子。",
        "曹瞒篡乱从此始，董逃董逃人莫喜。",
        "胜负相环相枕倚，缝缀难成裁破易。",
        "何况曲针不能伸巧指，欲学裁缝须准拟。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 268975,
      "title": "乐府古题序 忆远曲",
      "content": [
        "忆远曲，郎身不远郎心远。",
        "沙随郎饭俱在匙，郎意看沙那比饭。",
        "水中书字无字痕，君心暗画谁会君。",
        "况妾事姑姑进止，身去门前同万里。",
        "一家尽是郎腹心，妾似生来无两耳。",
        "妾身何足言，听妾私劝君。",
        "君今夜夜醉何处？",
        "姑来伴妾自闭门。",
        "嫁夫恨不早，养儿将备老。",
        "妾自嫁郎身骨立，老姑为郎求娶妾。",
        "妾不忍见姑郎忍见，为郎忍耐看姑面。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 268976,
      "title": "乐府古题序 夫远征",
      "content": [
        "赵卒四十万，尽为坑中鬼。",
        "赵王未信赵母言，犹点新兵更填死。",
        "填死之兵兵气索，秦强赵破括敌起。",
        "括虽专命起尚轻，何况牵肘之人牵不已。",
        "坑中之鬼妻在营，髽麻戴绖鹅雁鸣。",
        "送夫之妇又行哭，哭声送死非送行。",
        "夫远征，远征不必戍长城，出门便不知死生。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 268977,
      "title": "乐府古题序 织妇词",
      "content": [
        "织夫何太忙，蚕经三卧行欲老。",
        "蚕神女圣早成丝，今年丝税抽征早。",
        "早征非是官人恶，去岁官家事戎索。",
        "征人战苦束刀疮，主将勋高换罗幕。",
        "缫丝织帛犹努力，变缉撩机苦难织。",
        "东家头白双女儿，为解挑纹嫁不得。",
        "檐前袅袅游丝上，上有蜘蛛巧来往。",
        "羡他虫豸解缘天，能向虚空织罗网。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 268978,
      "title": "乐府古题序 田家词",
      "content": [
        "牛咤咤，田确确。",
        "旱块敲牛蹄趵趵，种得官仓珠颗谷。",
        "六十年来兵蔟蔟，月月食粮车辘辘。",
        "一日官军收海服，驱牛驾车食牛肉。",
        "归来攸得牛两角，重铸锄犂作斤㔉。",
        "姑舂妇担去输官，输官不足归卖屋。",
        "愿官早胜雠早覆，农死有儿牛有犊，誓不遣官军粮不足。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 268979,
      "title": "乐府古题序 侠客行",
      "content": [
        "侠客不怕死，怕在事不成。",
        "事成不肯藏姓名，我非窃贼谁夜行。",
        "白日堂堂杀袁盎，九衢草草人面青。",
        "此客此心师海鲸，海鲸露背横沧溟。",
        "海波分作两处生，分海减海刀，侠客有谋。",
        "人不识测，三尺铁蛇延二国。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 268980,
      "title": "乐府古题序 君莫非",
      "content": [
        "鸟不解走，兽不解飞。",
        "两不相解，那得相讥。",
        "犬不饮露，蝉不噉肥。",
        "以蝉易犬，蝉死犬饥。",
        "燕在梁栋，鼠在阶基。",
        "各自窠窟，人不能移。",
        "妇好针缕，夫读书诗。",
        "男翁女嫁，卒不相知。",
        "惧聋摘耳，效痛嚬眉。",
        "我不非尔，尔无我非。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 268981,
      "title": "乐府古题序 田野狐兔行",
      "content": [
        "种豆耘锄，种禾沟甽。",
        "禾苗豆甲，狐榾兔翦。",
        "割鹄𫗪鹰，烹麟噉犬。",
        "鹰怕兔毫，犬被狐引。",
        "狐兔相须，鹰犬相尽。",
        "日暗天寒，禾稀豆损。",
        "鹰犬就烹，狐兔俱哂。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 268982,
      "title": "乐府古题序 当来日大难行",
      "content": [
        "当来日大难行，前有阪，后有坑。",
        "大梁侧，小梁倾。",
        "两轴相绞，两轮相撑。",
        "大牛竖，小牛横。",
        "乌啄牛背，足趺力儜，当来日大难行。",
        "太行虽险，险可使平。",
        "轮轴自挠，牵制不停。",
        "泥潦渐久，荆棘旋生。",
        "行必不得，不如不行。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 268983,
      "title": "乐府古题序 人道短",
      "content": [
        "古道天道长人道短，我道天道短人道长。",
        "天道昼夜廻转不曾住，春秋冬夏忙，颠风暴雨电雷狂。",
        "晴被阴暗，月夺日光。",
        "往往星宿，日亦堂堂。",
        "天既职性命，道德人自强。",
        "尧舜有圣德，天不能遣。",
        "寿命永昌，泥金刻玉。",
        "与秦始皇，周公傅说。",
        "何不长宰相，老耼仲尼。",
        "何事栖遑，莽卓恭显。",
        "皆数十年富贵，梁冀夫妇。",
        "车马煌煌，若此颠倒事。",
        "岂非天道短，岂非人道长。",
        "尧舜留得神圣事，百代天子有典章。",
        "仲尼留得孝顺语，千年万岁父子不敢相灭亡。",
        "殁后千余载，唐家天子封作文宣王。",
        "老君留得五千字，子孙万万称圣唐。",
        "谥作玄元帝，魂魄坐天堂。",
        "周公周礼二十卷，有能行者知纪纲。",
        "傅说说命三四纸，有能师者称祖宗。",
        "天能夭人命，人使道无穷。",
        "若此神圣事，谁道人道短。",
        "岂非人道长，天能种百草。",
        "莸得十年有气息，蕣才一日芳。",
        "人能拣得丁沈兰蕙，料理百和香。",
        "天解养禽兽，𫗪虎豹豺狼。",
        "人解和曲糵，充礿祀烝尝。",
        "杜鹃无百作，天遣百鸟哺雏。",
        "不遣哺凤皇，巨蟒寿千岁。",
        "天遣食牛吞象充腹肠，蛟螭与变化。",
        "鬼怪与隐藏，蚊蚋与利觜。",
        "枳棘与锋铓，赖得人道有拣别。",
        "信任天道真茫茫，若此撩乱事。",
        "岂非天道短，赖得人道长。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 268984,
      "title": "乐府古题序 苦乐相倚曲",
      "content": [
        "古来苦乐之相倚，近于掌上之十指。",
        "君心半夜猜恨生，荆棘满怀天未明。",
        "汉成眼瞥飞燕时，可怜班女恩已衰。",
        "未有因由相决绝，犹得半年佯暖热。",
        "转将深意谕旁人，缉缀瑕疵遣潜说。",
        "一朝诏下辞金屋，班姬自痛何仓卒。",
        "呼天抚地将自明，不悟寻时暗销骨。",
        "白首宫人前再拜，愿将日月相辉解。",
        "苦乐相寻昼夜间，灯光那有天明在。",
        "主今被夺心应苦，妾夺深恩初为主。",
        "欲知妾意恨主时，主今为妾思量取。",
        "班姬收泪抱妾身，我曾排摈无限人。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
