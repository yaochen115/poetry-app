{
  "data": [
    {
      "id": 262584,
      "title": "宫词一百首 四十",
      "content": [
        "自夸歌舞胜诸人，恨未承恩出内频。",
        "连夜宫中修别院，地衣帘额一时新。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262585,
      "title": "宫词一百首 四十一",
      "content": [
        "闷来无处可思量，旋下金堦旋忆床。",
        "收得山丹红蘂粉，镜前洗却麝香黄。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262586,
      "title": "宫词一百首 四十二",
      "content": [
        "蜂须蝉翅薄松松，浮动搔头似有风。",
        "一度出时抛一遍，金条零落满函中。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262587,
      "title": "宫词一百首 四十三",
      "content": [
        "合暗报来门锁了，夜深应别唤笙歌。",
        "房房下著珠帘睡，月过金堦白露多。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262588,
      "title": "宫词一百首 四十四",
      "content": [
        "御厨不食索时新，每见花开即苦春。",
        "白日卧多娇似病，隔帘教唤女医人。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262589,
      "title": "宫词一百首 四十五",
      "content": [
        "丛丛洗手遶金盆，旋拭红巾入殿门。",
        "众里遥抛新摘子，在前收得便承恩。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262590,
      "title": "宫词一百首 四十六",
      "content": [
        "御池水色春来好，处处分流白玉渠。",
        "密奏君王知入月，唤人相伴洗裙裾。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262591,
      "title": "宫词一百首 四十七",
      "content": [
        "移来女乐部头边，新赐花檀木五弦。",
        "缏得红罗手帕子，中心细画一双蝉。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262592,
      "title": "宫词一百首 四十八",
      "content": [
        "新晴草色绿温暾，山雪初消渐出浑。",
        "今日踏青归校晚，传声留著望春门。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262593,
      "title": "宫词一百首 四十九",
      "content": [
        "两楼相换珠帘额，中尉明朝设内家。",
        "一样金盘五千面，红酥点出牡丹花。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262594,
      "title": "宫词一百首 五十",
      "content": [
        "尽送春来出内家，记巡传把一枝花。",
        "散时各自烧红烛，相逐行归不上车。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262595,
      "title": "宫词一百首 五十一",
      "content": [
        "家常爱著旧衣裳，空插红梳不出妆。",
        "忽地下堦裙带解，非时应得见君王。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262596,
      "title": "宫词一百首 五十二",
      "content": [
        "别𠡠教歌不出房，一声一遍奏君王。",
        "再三博士留残拍，索向宣徽作彻章。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262597,
      "title": "宫词一百首 五十三",
      "content": [
        "行中第一争先舞，博士傍边亦被欺。",
        "忽觉管弦偷破拍，急翻罗袖不教知。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262598,
      "title": "宫词一百首 五十四",
      "content": [
        "私缝黄帔舍钗梳，欲得金仙观里居。",
        "近被君王知识字，收来案上检文书。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262599,
      "title": "宫词一百首 五十五",
      "content": [
        "月冷江清近猎时，玉阶金瓦雪澌澌。",
        "浴堂门外抄名入，公主家人谢面脂。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262600,
      "title": "宫词一百首 五十六",
      "content": [
        "未承恩泽一家愁，乍到宫中忆外头。",
        "求守管弦声款逐，侧商调里唱伊州。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262601,
      "title": "宫词一百首 五十七",
      "content": [
        "东风泼火雨新休，舁尽春泥扫雪沟。",
        "走马犊车当御路，汉阳宫主进鸡毬。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262602,
      "title": "宫词一百首 五十八",
      "content": [
        "风帘水阁压芙蓉，四面钩栏在水中。",
        "避热不归金殿宿，秋河织女夜妆红。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262603,
      "title": "宫词一百首 五十九",
      "content": [
        "圣人生日明朝是，私地教人属内监。",
        "自写金花红牓子，前头先进凤皇衫。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262604,
      "title": "宫词一百首 六十",
      "content": [
        "避暑昭阳不掷卢，井边含水喷鵶雏。",
        "内中数日无呼唤，搨得滕王蛱蝶图。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262605,
      "title": "宫词一百首 六十一",
      "content": [
        "内宴初秋入二更，殿前灯火一天明。",
        "中宫传旨音声散，诸院门开触处行。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262606,
      "title": "宫词一百首 六十二",
      "content": [
        "玉蝉金雀三层插，翠髻高丛绿鬓虚。",
        "舞处春风吹落地，归来别赐一头梳。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262607,
      "title": "宫词一百首 六十三",
      "content": [
        "树叶初成鸟护窠，石榴花里笑声多。",
        "众中遗却金钗子，拾得从他要赎么。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262608,
      "title": "宫词一百首 六十四",
      "content": [
        "小殿初成粉未干，贵妃姊妹自来看。",
        "为逢好日先移入，续向街西索牡丹。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262609,
      "title": "宫词一百首 六十五",
      "content": [
        "内人相续报花开，准拟君王便看来。",
        "逢着五弦琴绣袋，宜春院里按歌回。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262610,
      "title": "宫词一百首 六十六",
      "content": [
        "巡吹慢遍不相和，暗数看谁曲校多。",
        "明日棃花园里见，先须逐得内家歌。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262611,
      "title": "宫词一百首 六十七",
      "content": [
        "黄金合里盛红雪，重结香罗四出花。",
        "一一傍边书𠡠字，中官送与大臣家。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262612,
      "title": "宫词一百首 六十八",
      "content": [
        "未明东上阁门开，排仗声从后殿来。",
        "阿监两边相对立，遥闻索马一时回。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262613,
      "title": "宫词一百首 六十九",
      "content": [
        "宫人早起笑相呼，不识堦前扫地夫。",
        "乞与金钱争借问，外头还似此间无。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262614,
      "title": "宫词一百首 七十",
      "content": [
        "小随阿姊学吹笙，见好君王赐与名。",
        "夜拂玉床朝把镜，黄金殿外不教行。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262615,
      "title": "宫词一百首 七十一",
      "content": [
        "日高殿里有香烟，万岁声长动九天。",
        "妃子院中初降诞，内人争乞洗儿钱。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262616,
      "title": "宫词一百首 七十二",
      "content": [
        "宫花不共外花同，正月长生一半红。",
        "供御樱桃看守别，直无鸦鹊到园中。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262617,
      "title": "宫词一百首 七十三",
      "content": [
        "殿前铺设两边楼，寒食宫人步打毬。",
        "一半走来争跪拜，上棚先谢得头筹。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262618,
      "title": "宫词一百首 七十四",
      "content": [
        "太仪前日暖房来，嘱向朝阳乞药栽。",
        "𠡠赐一窠红踯躅，谢恩未了奏花开。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262619,
      "title": "宫词一百首 七十五",
      "content": [
        "御前新赐紫罗襦，步步金堦上软舆。",
        "宫局总来为喜乐，院中新拜内尚书。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262620,
      "title": "宫词一百首 七十六",
      "content": [
        "鹦鹉谁教转舌关，内人手里养来奸。",
        "语多更觉承恩泽，数对君王忆陇山。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262621,
      "title": "宫词一百首 七十七",
      "content": [
        "分朋闲坐赌樱桃，收却投壶玉腕劳。",
        "各把沈香双陆子，局中鬬累阿谁高。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262622,
      "title": "宫词一百首 七十八",
      "content": [
        "禁寺红楼内里通，笙歌引驾夹城东。",
        "裹头宫监堂前立，手把牙鞘竹弹弓。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262623,
      "title": "宫词一百首 七十九",
      "content": [
        "春风院院落花堆，金锁生衣掣不开。",
        "更筑歌台起妆殿，明朝先进画图来。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262624,
      "title": "宫词一百首 八十",
      "content": [
        "舞来汗湿罗衣彻，楼上人扶下玉梯。",
        "归到院中重洗面，金花盆里泼银泥。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262625,
      "title": "宫词一百首 八十一",
      "content": [
        "宿妆残粉未明天，总立昭阳花树边。",
        "寒食内人长白打，库中先散与金钱。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262626,
      "title": "宫词一百首 八十二",
      "content": [
        "众中偏得君王笑，偷把金箱笔砚开。",
        "书破红蛮隔子上，旋推当直美人来。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262627,
      "title": "宫词一百首 八十三",
      "content": [
        "教遍宫娥唱遍词，暗中头白没人知。",
        "楼中日日歌声好，不问从初学阿谁。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262628,
      "title": "宫词一百首 八十四",
      "content": [
        "青楼小妇砑裙长，总被抄名入教坊。",
        "春设殿前多队舞，朋头各自请衣裳。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262629,
      "title": "宫词一百首 八十五",
      "content": [
        "水中芹叶土中花，拾得还将避众家。",
        "总待别人般数尽，袖中拈出郁金芽。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262630,
      "title": "宫词一百首 八十六",
      "content": [
        "玉箫改调筝移柱，催换红罗绣舞筵。",
        "未戴柘枝花帽子，两行宫监在帘前。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262631,
      "title": "宫词一百首 八十七",
      "content": [
        "窗窗户户院相当，总有珠帘玳瑁床。",
        "虽道君王不来宿，帐中长是炷牙香。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262632,
      "title": "宫词一百首 八十八",
      "content": [
        "雨入珠帘满殿凉，避风新出玉盆汤。",
        "内人恐要秋衣着，不住熏笼换好香。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262633,
      "title": "宫词一百首 八十九",
      "content": [
        "金吾除夜进傩名，画袴朱衣四队行。",
        "院院烧灯如白日，沈香火底坐吹笙。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262634,
      "title": "宫词一百首 九十",
      "content": [
        "树头树底觅残红，一片西飞一片东。",
        "自是桃花贪结子，错教人恨五更风。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262635,
      "title": "宫词一百首 九十一",
      "content": [
        "金殿当头紫合重，仙人掌上玉芙蓉。",
        "太平天子朝迎日，五色云车驾六龙。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262636,
      "title": "宫词一百首 九十二",
      "content": [
        "鸳鸯瓦上瞥然声，昼寝宫娥梦里惊。",
        "元是我王金弹子，海棠花下打流莺。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262637,
      "title": "宫词一百首 九十三",
      "content": [
        "忽地金舆向月陂，内人接著便相随。",
        "却回龙武军前过，当处教开卧鸭池。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262638,
      "title": "宫词一百首 九十四",
      "content": [
        "画作天河刻作牛，玉梭金镊采桥头。",
        "每年宫里穿针夜，𠡠赐诸亲乞巧楼。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262639,
      "title": "宫词一百首 九十五",
      "content": [
        "春来睡困不梳头，懒逐君王苑北游。",
        "暂向玉花阶上坐，簸钱赢得两三筹。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262640,
      "title": "宫词一百首 九十六",
      "content": [
        "步行送入长门里，不许来辞旧院花。",
        "只恐他时身到此，乞恩求赦放还家。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262641,
      "title": "宫词一百首 九十七",
      "content": [
        "缣罗不著索轻容，对面教人染退红。",
        "衫子成来一遍出，明朝半片在园中。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262642,
      "title": "宫词一百首 九十八",
      "content": [
        "弹棋玉指两叁差，背局临虚鬬著危。",
        "先打角头红子落，上三金字半边垂。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262643,
      "title": "宫词一百首 九十九",
      "content": [
        "后宫宫女无多少，尽向园中笑一团。",
        "舞蝶落花相觅著，春风共语亦应难。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262644,
      "title": "宫词一百首 一百",
      "content": [
        "宛转黄金白柄长，青荷叶子画鸳鸯。",
        "把来不是呈新样，欲进微风到御床。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262645,
      "title": "宫词一百首 一百一",
      "content": [
        "供御香方加减频，水沈山麝每回新。",
        "内中不许相传出，已被医家写与人。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262646,
      "title": "宫词一百首 一百二",
      "content": [
        "药童食后送云浆，高殿无风扇少凉。",
        "每到日中重掠鬓，衩衣骑马绕宫廊。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262647,
      "title": "句",
      "content": [
        "单于不向南牧马，席萁遍满天山下却公不易胜，莫著外家欺。",
        "锦江诗弟子，时寄五花牋。",
        "花烧落第眼，雨破到家程。",
        "一朝金凤庭前下，当是虚皇诏沈曦。",
        "宣城四面水茫茫，草盖江城竹夹墙。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 266468,
      "title": "杂曲歌辞 宫中调笑 一",
      "content": [
        "团扇，团扇，美人病来遮面。",
        "玉颜憔悴三年，谁复商量管弦。",
        "弦管，弦管，春草昭阳路断。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 266469,
      "title": "杂曲歌辞 宫中调笑 二",
      "content": [
        "胡蝶，胡蝶，飞上金花枝叶。",
        "君前对舞春风，百叶桃花树红。",
        "红树，红树，燕语莺啼日暮。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 266470,
      "title": "杂曲歌辞 宫中调笑 三",
      "content": [
        "罗袖，罗袖，暗舞春风依旧。",
        "遥看歌舞玉楼，好日新妆坐愁。",
        "愁坐，愁坐，一世虚生虚过。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 266471,
      "title": "杂曲歌辞 宫中调笑 四",
      "content": [
        "杨柳，杨柳，日暮白沙渡口。",
        "船头江水茫茫，商人少妇断肠。",
        "肠断，肠断，鹧鸪夜飞失伴。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 266565,
      "title": "杂歌谣辞 鸡鸣曲",
      "content": [
        "鸡初鸣，明星照东屋。",
        "鸡再鸣，红霞生海腹。",
        "百官待漏双阙前，圣人亦挂山龙服。",
        "宝钗命妇灯下起，环珮玲珑晓光里。",
        "直内初烧玉[案]香，司更尚滴铜壶水。",
        "金吾卫里直郎妻，到明不睡听晨鸡。",
        "天头日月相送迎，夜栖旦鸣人不迷。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298383,
      "title": "三台 一",
      "content": [
        "鱼藻池边射鸭，芙蓉苑里看花。",
        "日色柘袍相似，不著红鸾扇遮。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298384,
      "title": "三台 二",
      "content": [
        "池北池南草绿，殿前殿后花红。",
        "天子千秋万岁，未央明月清风。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298385,
      "title": "三台 三",
      "content": [
        "扬州桥边小妇，长干市里商人。",
        "三年不得消息，各自拜鬼求神。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298386,
      "title": "三台 四",
      "content": [
        "青草湖边草色，飞猨岭上猨声。",
        "万里三湘客到，有风有雨人行。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298387,
      "title": "三台 五",
      "content": [
        "树头花落花开，道上人去人来。",
        "朝愁暮愁即老，百年几度三台。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298388,
      "title": "三台 六",
      "content": [
        "鬬身彊健且为，头白齿落难追。",
        "准拟百年千岁，能得几许多时。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298389,
      "title": "调笑令 一",
      "content": [
        "团扇，团扇，美人竝来遮面。",
        "玉颜顦顇三年，谁复商量管弦。",
        "弦管，弦管，春草昭阳路断。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298390,
      "title": "调笑令 二",
      "content": [
        "胡蝶，胡蝶，飞上金枝玉叶。",
        "君前对舞春风，百叶桃花树红。",
        "红树，红树，燕语莺啼日暮。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
