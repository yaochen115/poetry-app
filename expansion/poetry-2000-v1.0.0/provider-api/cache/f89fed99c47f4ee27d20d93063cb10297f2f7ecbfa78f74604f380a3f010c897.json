{
  "data": [
    {
      "id": 311676,
      "title": "早发焉耆怀终南别业",
      "content": [
        "晓笛别乡泪，秋冰鸣马蹄。",
        "一身虏云外，万里胡天西。",
        "终日见征战，连年闻鼓鼙。",
        "故山在何处，昨日梦清谿。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 311677,
      "title": "宿铁关西馆",
      "content": [
        "马汗踏成泥，朝驰几万蹄。",
        "雪中行地角，火处宿天倪。",
        "塞迥心常怯，乡遥梦亦迷。",
        "那知故园月，也到铁关西。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 311678,
      "title": "首秋轮台",
      "content": [
        "异域阴山外，孤城雪海边。",
        "秋来唯有雁，夏尽不闻蝉。",
        "雨拂氊墙湿，风摇毳幕膻。",
        "轮台万里地，无事历三年。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 311679,
      "title": "北庭作",
      "content": [
        "雁塞通盐泽，龙堆接醋沟。",
        "孤城天北畔，绝域海西头。",
        "秋雪春仍下，朝风夜不休。",
        "可知年四十，犹自未对侯。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 311680,
      "title": "轮台即事",
      "content": [
        "轮台风物异，地是古单于。",
        "三月无青草，千家尽白榆。",
        "蕃书文字别，胡俗语音殊。",
        "愁见流沙北，天西海一隅。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 311681,
      "title": "还东山洛上作",
      "content": [
        "春流急不浅，归栧去何迟。",
        "愁客叶舟里，夕阳花水时。",
        "云晴开䗖蝀，櫂发起鸬鹚。",
        "莫道东山远，衡门在梦思。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 311682,
      "title": "杨固店",
      "content": [
        "客舍梨叶赤，邻家闻捣衣。",
        "夜来尝有梦，坠泪缘思归。",
        "洛水行欲尽，缑山看渐微。",
        "长安祗千里，何事信音稀。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 311683,
      "title": "巴南舟中思陆浑别业",
      "content": [
        "泸水南州远，巴山北客稀。",
        "岭云撩乱起，谿鹭等闲飞。",
        "镜里愁衰鬓，舟中换旅衣。",
        "梦魂知忆处，无夜不先归。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 311684,
      "title": "晚发五渡",
      "content": [
        "客厌巴南地，乡邻劒北天。",
        "江村片雨外，野寺夕阳边。",
        "芋叶藏山径，芦花杂渚田。",
        "舟行未可住，乘月且须牵。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 311685,
      "title": "巴南舟中夜市",
      "content": [
        "渡口欲黄昏，归人争渡喧。",
        "近钟清野寺，远火点江村。",
        "见雁思乡信，闻猿积泪痕。",
        "孤舟万里外，秋月不堪论。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 311686,
      "title": "江上春叹",
      "content": [
        "腊月江上煖，南桥新柳枝。",
        "春风触处到，忆得故园时。",
        "终日不如意，出门何所之。",
        "从人觅颜色，自笑弱男儿。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 311687,
      "title": "初至犍为作",
      "content": [
        "山色轩槛内，滩声枕席间。",
        "草生公府静，花落讼庭闲。",
        "云雨连三峡，风尘接百蛮。",
        "到来能几日，不觉鬓毛斑。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 311688,
      "title": "使院中新栽柏树子呈李十五栖筠",
      "content": [
        "爱尔青青色，移根此地来。",
        "不曾台上种，留向碛中栽。",
        "脆叶欺门柳，狂花笑院梅。",
        "不须愁岁晚，霜露岂能摧。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 311689,
      "title": "咏郡斋壁画片云",
      "content": [
        "云片何人画，尘侵粉色微。",
        "未曾行雨去，不见逐风归。",
        "只怪偏凝壁，回看欲惹衣。",
        "丹青忽借便，移向帝乡飞。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 311690,
      "title": "临洮龙兴寺玄上人院同咏青木香丛",
      "content": [
        "移根自远方，种得在僧房。",
        "六月花新吐，三春叶已长。",
        "抽茎高锡杖，引影到绳床。",
        "只为能除疾，倾心向药王。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 311691,
      "title": "成王挽歌",
      "content": [
        "幽山悲旧桂，长坂怆余兰。",
        "地底孤灯冷，泉中一镜寒。",
        "铭旌门客送，骑吹路人看。",
        "漫作琉璃椀，淮王误合丹。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 311692,
      "title": "苗侍中挽歌二首 一",
      "content": [
        "摄政朝章重，持衡国相尊。",
        "笔端通造化，掌内运乾坤。",
        "青史遗芳满，黄枢故事存。",
        "空悲渭桥路，谁对汉皇言。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 311693,
      "title": "苗侍中挽歌二首 二",
      "content": [
        "天子悲元老，都人惜上公。",
        "优贤几杖在，会葬市朝空。",
        "丹旐飞斜日，清笳怨暮风。",
        "平生门下客，继美庙堂中。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 311694,
      "title": "故仆射裴公挽歌三首 一",
      "content": [
        "盛德资邦杰，嘉谟作世程。",
        "门瞻驷马贵，时仰八龙名。",
        "罢市秦人送，还乡绛老迎。",
        "莫埋丞相印，留着付玄成。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 311695,
      "title": "故仆射裴公挽歌三首 二",
      "content": [
        "五府瞻高位，三台丧大贤。",
        "礼容还故绛，宠赠冠新田。",
        "气歇汾阴鼎，魂飞京兆阡。",
        "先时劒已没，陇树久苍然。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 311696,
      "title": "故仆射裴公挽歌三首 三",
      "content": [
        "富贵徒言久，乡闾殁后归。",
        "锦衣都未着，丹旐忽先飞。",
        "哀挽辞秦塞，悲笳出帝畿。",
        "遥知九原上，渐觉吊人稀。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 311697,
      "title": "河西太守杜公挽歌四首 一",
      "content": [
        "蒙叟悲藏壑，殷宗惜济川。",
        "长安非旧日，京兆是新阡。",
        "黄霸官犹屈，苍生望已愆。",
        "唯余卿月在，留向杜陵悬。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 311698,
      "title": "河西太守杜公挽歌四首 二",
      "content": [
        "鼓角城中出，坟茔郭外新。",
        "雨随思太守，云从送夫人。",
        "蒿里埋双劒，松门闭万春。",
        "回瞻北堂上，金印已生尘。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 311699,
      "title": "河西太守杜公挽歌四首 三",
      "content": [
        "忆昨明光殿，新承天子恩。",
        "剖符移北地，授钺领西门。",
        "塞草迎军幕，边云拂使轩。",
        "至今闻陇外，戎虏尚亡魂。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 311700,
      "title": "河西太守杜公挽歌四首 四",
      "content": [
        "漫漫澄波阔，沈沈大厦深。",
        "秉心常匪席，行义每挥金。",
        "汲引窥兰室，招携入翰林。",
        "多君有令子，犹注世人心。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 311701,
      "title": "故河南尹岐国公赠工部尚书苏公挽歌二首 一",
      "content": [
        "河尹恩荣旧，尚书宠赠新。",
        "一门传画戟，几世驾朱轮。",
        "夜色何时晓，泉台不复春。",
        "唯余朝服在，金印已生尘。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 311702,
      "title": "故河南尹岐国公赠工部尚书苏公挽歌二首 二",
      "content": [
        "白日扃泉户，青春掩夜台。",
        "旧堂阶草长，空院砌花开。",
        "山晚铭旌去，郊寒骑吹回。",
        "三川难可见，应惜庾公才。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 311703,
      "title": "韩员外夫人清河县君崔氏挽歌二首 一",
      "content": [
        "令德当时重，高门举世推。",
        "从夫荣已绝，封邑宠难追。",
        "陌上人皆惜，花间鸟亦悲。",
        "仙郎看陇月，犹忆画眉时。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 311704,
      "title": "韩员外夫人清河县君崔氏挽歌二首 二",
      "content": [
        "遽闻伤别劒，忽复叹藏舟。",
        "灯冷泉中夜，衣寒地下秋。",
        "青松吊客泪，丹旐路人愁。",
        "徒有清河在，空悲逝水流。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 311705,
      "title": "西河郡太原守张夫人挽歌",
      "content": [
        "鹊印庆仍传，鱼轩宠莫先。",
        "从夫元凯贵，训子孟轲贤。",
        "龙是双归日，鸾非独舞年。",
        "哀容今共尽，凄怆杜陵田。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 311706,
      "title": "南溪别业",
      "content": [
        "结宇依青嶂，开轩对翠畴。",
        "树交花两色，溪合水重流。",
        "竹径春来埽，兰樽夜不收。",
        "逍遥自得意，鼓腹醉中游。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 311707,
      "title": "奉和中书舍人贾至早朝大明宫",
      "content": [
        "鸡鸣紫陌曙光寒，莺啭皇州春色阑。",
        "金阙晓钟开万户，玉阶仙仗拥千官。",
        "花迎劒珮星初落，柳拂旌旗露未干。",
        "独有凤皇池上客，阳春一曲和皆难。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 311708,
      "title": "和祠部王员外雪后早朝即事",
      "content": [
        "长安雪后似春归，积素凝华连曙晖。",
        "色借玉珂迷晓骑，光添银烛晃朝衣。",
        "西山落月临天仗，北阙晴云捧禁闱。",
        "闻道仙郎歌白雪，由来此曲和人稀。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 311709,
      "title": "奉和相公发益昌",
      "content": [
        "相[国]临戎别帝京，拥麾持节远横行。",
        "朝登劒阁云随马，夜渡巴江雨洗兵。",
        "山花万朵迎征盖，川柳千条拂去旌。",
        "暂到蜀城应计日，须知明主待持衡。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 311710,
      "title": "秋夕读书幽兴献兵部李侍郎",
      "content": [
        "年纪蹉跎四十强，自怜头白始为郎。",
        "雨滋苔藓侵堦绿，秋飒梧桐覆井黄。",
        "惊蝉也解求高树，旅雁还应厌后行。",
        "览卷试穿邻舍壁，明灯何惜借余光。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 311711,
      "title": "使君席夜送严河南赴长水",
      "content": [
        "娇歌急管杂青丝，银烛金杯映翠眉。",
        "使君地主能相送，河尹天明坐莫辞。",
        "春城月出人皆醉，野戍花深马去迟。",
        "寄声报尔山翁道，今日河南胜昔时。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 311712,
      "title": "暮春虢州东亭送李司马归扶风别庐",
      "content": [
        "柳亸莺娇花复殷，红亭绿酒送君还。",
        "到来函谷愁中月，归去磻谿梦里山。",
        "帘前春色应须惜，世上浮名好是闲。",
        "西望乡关肠欲断，对君衫袖泪痕斑。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 311713,
      "title": "九日使君席奉饯卫中丞赴长水",
      "content": [
        "节使横行西出师，鸣弓擐甲羽林儿。",
        "台上霜风凌草木，军中杀气傍旌旗。",
        "预知汉将宣威日，正是胡尘欲灭时。",
        "为报使君多泛菊，更将弦管醉东篱。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 311714,
      "title": "西掖省即事",
      "content": [
        "西掖重云开曙晖，北山疎雨点朝衣。",
        "千门柳色连青琐，三殿花香入紫微。",
        "平明端笏陪鹓列，薄暮垂鞭信马归。",
        "官拙自悲头白尽，不如岩下偃荆扉。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 311715,
      "title": "首春渭西郊行呈蓝田张二主簿",
      "content": [
        "迥风度雨渭城西，细草新花踏作泥。",
        "秦女峰头雪未尽，胡公阪上日初低。",
        "愁窥白发羞微禄，悔别青山忆旧谿。",
        "闻道辋川多胜事，玉壶春酒正堪携。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 311716,
      "title": "赴嘉州过城固县寻永安超禅师房",
      "content": [
        "满寺枇杷冬着花，老僧相见具袈裟。",
        "汉王城北雪初霁，韩信台西日欲斜。",
        "门外不须催五马，林中且听演三车。",
        "岂料巴川多胜事，为君书此报京华。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 311717,
      "title": "酬畅当嵩山寻麻道士见寄",
      "content": [
        "闻逐樵夫闲看棋，忽逢人世是秦时。",
        "开云种玉嫌山浅，渡海传书怪鹤迟。",
        "阴洞石幢微有字，古坛松树半无枝。",
        "烦君远示青囊录，愿得相从一问师。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 311718,
      "title": "和刑部成员外秋夜寓直寄台省知己",
      "content": [
        "列宿光三署，仙郎直五宵。",
        "时衣天子赐，厨膳大官调。",
        "长乐钟应近，明光漏不遥。",
        "黄门持被覆，侍女捧香烧。",
        "笔为题诗点，灯缘起草挑。",
        "竹喧交砌叶，柳亸拂牕条。",
        "粉署荣新命，霜台忆旧僚。",
        "名香播兰蕙，重价蕴琼瑶。",
        "击水翻沧海，[抟]风透赤霄。",
        "微才喜同舍，何幸忽闻韶。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 311719,
      "title": "送庐郎中除杭州赴任",
      "content": [
        "罢起郎官草，初分刺史符。",
        "海云迎过楚，江月引归吴。",
        "城低涛声震，楼端蜃气孤。",
        "千家窥驿舫，五马饮春湖。",
        "柳色供诗用，莺声送酒须。",
        "知君望乡处，枉道上姑苏。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 311720,
      "title": "奉送李宾客荆南迎亲",
      "content": [
        "迎亲辞旧苑，恩诏下储闱。",
        "昨见双鱼去，今看驷马归。",
        "驿帆湘水阔，客舍楚山稀。",
        "手把黄香扇，身披莱子衣。",
        "鹊随金印喜，乌傍板舆飞。",
        "胜作东征赋，还家满路辉。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 311721,
      "title": "送严维下第还江东",
      "content": [
        "勿叹今不第，似君殊未迟。",
        "且归沧洲去，相送青门时。",
        "望鸟指乡远，问人愁路疑。",
        "敝裘沾暮雪，归櫂带流澌。",
        "严子滩复在，谢公文可追。",
        "江臯如有信，莫不寄新诗。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 311722,
      "title": "六月三十日水亭送华阴王少府还县",
      "content": [
        "亭晚人将别，池凉酒未酣。",
        "关门劳夕梦，仙掌引归骖。",
        "荷叶藏鱼艇，藤花罥客簪。",
        "残云收夏暑，新雨带秋岚。",
        "失路情无适，离怀思不堪。",
        "赖兹庭户里，别有小江潭。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 311723,
      "title": "饯王岑判官赴襄阳道",
      "content": [
        "故人汉阳使，走马向南荆。",
        "不厌楚山路，祗怜襄水清。",
        "津头习氏宅，江上夫人城。",
        "夜入橘花宿，朝穿桐叶行。",
        "害群应自慑，持法固须平。",
        "暂得青门醉，斜光速去程。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 311724,
      "title": "送薛弁归河东",
      "content": [
        "薛侯故乡处，五老峰西头。",
        "归路秦树灭，到乡河水流。",
        "看君马首去，满耳蝉声愁。",
        "献赋今未售，读书凡几秋。",
        "应过伯夷庙，为上关城楼。",
        "楼上能相忆，西南指雍州。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 311725,
      "title": "送薛播擢第归河东",
      "content": [
        "归去新战胜，盛名人共闻。",
        "乡连渭川树，家近条山云。",
        "夫子能好学，圣朝全用文。",
        "弟兄负世誉，词赋超人群。",
        "雨气醒别酒，城阴低暮曛。",
        "遥知出关后，更有一终军。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 311726,
      "title": "送陶铣弃举荆南觐省",
      "content": [
        "明时不爱璧，浪迹东南游。",
        "何必世人识，知君轻五侯。",
        "采兰度汉水，问绢过荆州。",
        "异国有归兴，去乡无客愁。",
        "天寒楚塞雨，月净襄阳秋。",
        "坐见吾道远，令人看白头。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 311727,
      "title": "送史司马赴崔相公幕",
      "content": [
        "峥嵘丞相府，清切凤皇池。",
        "羡尔瑶台鹤，高栖琼树枝。",
        "归飞晴日好，吟弄惠风吹。",
        "正有乘轩乐，初当学舞时。",
        "珍禽在罗网，微命若游丝。",
        "愿托周南羽，相衔谿水湄。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 311728,
      "title": "送严黄门拜御史大夫再镇蜀川兼觐省",
      "content": [
        "授钺辞金殿，承恩恋玉墀。",
        "登坛汉主用，讲德蜀人思。",
        "副相韩安国，黄门向子期。",
        "刀州重入梦，劒阁再题词。",
        "春草连青绶，晴花间赤旗。",
        "山莺朝送酒，江月夜供诗。",
        "许国分忧日，荣亲色养时。",
        "苍生望已久，来去不应迟。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 311729,
      "title": "送郭仆射节制劒南",
      "content": [
        "铁马擐红缨，幡旗出禁城。",
        "明王亲授钺，丞相欲专征。",
        "玉馔天厨送，金杯御酒倾。",
        "劒门乘崄过，阁道踏空行。",
        "山鸟惊吹笛，江猿看洗兵。",
        "晓云随去阵，夜月逐行营。",
        "南仲今时往，西戎计日平。",
        "将心感知己，万里寄悬旌。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 311730,
      "title": "早秋与诸子登虢州西亭观眺",
      "content": [
        "亭高出鸟外，客到与云齐。",
        "树点千家小，天围万岭低。",
        "残[虹]挂陕北，急雨过关西。",
        "酒榼缘青壁，瓜田傍绿谿。",
        "微官何足道，爱客且相携。",
        "唯有乡园处，依依望不迷。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 311731,
      "title": "佐郡思旧游",
      "content": [
        "幸得趋紫殿，却忆侍丹墀。",
        "史笔众推直，谏书人莫窥。",
        "平生恒自负，垂老此安卑。",
        "同类皆先达，非才独后时。",
        "庭槐宿鸟乱，阶草夜虫悲。",
        "白发今无数，青云未有期。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 311732,
      "title": "灭胡曲",
      "content": [
        "都护新灭胡，士马气亦麤。",
        "萧条虏尘净，突兀天山孤。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 311733,
      "title": "尚书念旧垂赐袍衣率题绝句献上以申感谢",
      "content": [
        "富贵情还在，相逢岂间然。",
        "绨袍更有赠，犹荷故人怜。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 311734,
      "title": "忆长安曲二章寄庞{氵寉} 一",
      "content": [
        "东望望长安，正值日初出。",
        "长安不可见，喜见长安日。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 311735,
      "title": "忆长安曲二章寄庞{氵寉} 二",
      "content": [
        "长安何处在，只在马蹄下。",
        "明日归长安，为君急走马。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 311736,
      "title": "寄韩樽",
      "content": [
        "夫子素多疾，别来未得书。",
        "北庭苦寒地，体内今何如。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 311737,
      "title": "醉里送裴子赴镇西",
      "content": [
        "醉后未能别，待醒方送君。",
        "看君走马去，直上天山云。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 311738,
      "title": "题井陉双谿李道士所居",
      "content": [
        "五粒松花酒，双谿道士家。",
        "唯求缩却地，乡路莫教赊。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 311739,
      "title": "题云际南峰眼上人读经堂",
      "content": [
        "结宇题三藏，焚香老一峰。",
        "云间独坐卧，祗是对山松。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 311740,
      "title": "题梁锽城中高居",
      "content": [
        "高住最高处，千家恒眼前。",
        "题诗饮酒后，只对诸峰眠。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 311741,
      "title": "题三会寺苍颉造字台",
      "content": [
        "野寺荒台晚，寒天古木悲。",
        "空堦有鸟迹，犹似造书时。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 311742,
      "title": "日没贺延碛作",
      "content": [
        "沙上见日出，沙上见日没。",
        "悔向万里来，功名是何物。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 311743,
      "title": "西过渭州见渭水思秦川",
      "content": [
        "渭水东流去，何时到雍州。",
        "凭添两行泪，寄向故园流。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 311744,
      "title": "经陇头分水",
      "content": [
        "陇水何年有，潺潺逼路傍。",
        "东西流不歇，曾断几人肠。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 311745,
      "title": "秋思",
      "content": [
        "那知芳岁晚，坐见寒叶堕。",
        "吾不如腐草，翻飞作萤火。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 311746,
      "title": "行军九日思长安故园",
      "content": [
        "强欲登高去，无人送酒来。",
        "遥怜故园菊，应傍战场开。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 311747,
      "title": "戏题关门",
      "content": [
        "来亦一布衣，去亦一布衣。",
        "羞见关城吏，还从旧路归。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 311748,
      "title": "叹白发",
      "content": [
        "白发生偏速，交人不奈何。",
        "今朝两鬓上，更较数茎多。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 311749,
      "title": "题平阳郡汾桥边柳树",
      "content": [
        "此地曾居住，今来宛似归。",
        "可怜汾上柳，相见也依依。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 311750,
      "title": "失题",
      "content": [
        "帝乡北近日，泸口南连蛮。",
        "何当遇长房，缩地到京关。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 311751,
      "title": "献封大夫破播仙凯歌六首 一",
      "content": [
        "汉将承恩西破戎，捷书先奏未央宫。",
        "天子预开麟阁待，祗今谁数贰师功。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 311752,
      "title": "献封大夫破播仙凯歌六首 二",
      "content": [
        "官军西出过楼兰，营幕傍临月窟寒。",
        "蒲海晓霜凝马尾，葱山夜雪扑旌竿。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 311753,
      "title": "献封大夫破播仙凯歌六首 三",
      "content": [
        "鸣笳叠鼓拥回军，破国平蕃昔未闻。",
        "丈夫鹊印摇边月，大将龙旗掣海云。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 311754,
      "title": "献封大夫破播仙凯歌六首 四",
      "content": [
        "日落辕门鼓角鸣，千群面缚出蕃城。",
        "洗兵鱼海云迎阵，秣马龙堆月照营。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 311755,
      "title": "献封大夫破播仙凯歌六首 五",
      "content": [
        "蕃军遥见汉家营，满谷连山遍哭声。",
        "万箭千刀一夜杀，平明流血浸空城。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 311756,
      "title": "献封大夫破播仙凯歌六首 六",
      "content": [
        "暮雨旌旗湿未干，胡烟白草日光寒。",
        "昨夜将军连晓战，蕃军只见马空鞍。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 311757,
      "title": "春兴戏题赠李侯",
      "content": [
        "黄雀始欲衔花来，君家种桃花未开。",
        "长安二月眼看尽，寄报春风早为催。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 311758,
      "title": "过燕支寄杜位",
      "content": [
        "燕支山西酒泉道，北风吹沙卷白草。",
        "长安遥在日光边，忆君不见令人老。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 311759,
      "title": "题苜蓿峰寄家人",
      "content": [
        "苜蓿峰边逢立春，胡芦河上泪沾巾。",
        "闺中只是空相忆，不见沙场愁杀人。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 311760,
      "title": "玉关寄长安李主簿",
      "content": [
        "东去长安万里余，故人何惜一行书。",
        "玉关西望堪肠断，况复明朝是岁除。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 311761,
      "title": "武威送刘判官赴碛西行军",
      "content": [
        "火山五月行人少，看君马去疾如鸟。",
        "都护行营太白西，角声一动胡天晓。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 311762,
      "title": "虢州后亭送李判官使赴晋绛",
      "content": [
        "西原驿路挂城头，客散红亭雨未收。",
        "君去试看汾水上，白云犹似汉时秋。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 311763,
      "title": "五月四日送王少府归华阴",
      "content": [
        "仙掌分明引马头，西看一点是关楼。",
        "五月也须应到舍，知君不肯更淹留。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 311764,
      "title": "原头送范侍御",
      "content": [
        "百尺原头酒色殷，路傍骢马汗斑斑。",
        "别君祇有相思梦，遮莫千山与万山。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 311765,
      "title": "送李明府赴睦州便拜觐太夫人",
      "content": [
        "手把铜章望海云，夫人江上泣罗帬。",
        "严滩一点舟中月，万里烟波也梦君。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 311766,
      "title": "虢州西山亭子送范端公",
      "content": [
        "百尺红亭对万峰，平明相送到斋钟。",
        "骢马劝君皆卸却，使君家酝旧来浓。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 311767,
      "title": "奉送贾侍御使江外",
      "content": [
        "新骑骢马复承恩，使出金陵过海门。",
        "荆南渭北难相见，莫惜衫襟着酒痕。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 311768,
      "title": "崔仓曹席上送殷寅充石相判官赴淮南",
      "content": [
        "清淮无底绿江深，宿处津亭枫树林。",
        "驷马欲辞丞相府，一樽须尽故人心。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 311769,
      "title": "送崔子还京",
      "content": [
        "匹马西从天外归，扬鞭只共鸟争飞。",
        "送君九月交河北，雪里题诗泪满衣。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 311770,
      "title": "酒泉太守席上醉后作",
      "content": [
        "酒泉太守能劒舞，高堂置酒夜击鼓。",
        "胡笳一曲断人肠，座上相看泪如雨。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 311771,
      "title": "题观楼",
      "content": [
        "荒楼荒井闭空山，关令乘云去不还。",
        "羽盖霓旌何处在，空留药臼向人间。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 311772,
      "title": "草堂村寻罗生不遇",
      "content": [
        "数株谿柳色依依，深巷斜阳暮鸟飞。",
        "门前雪满无人迹，应是先生出未归。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 311773,
      "title": "山房春事二首 一",
      "content": [
        "风恬日暖荡春光，戏蝶游蜂乱入房。",
        "数枝门柳低衣桁，一片山花落笔床。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 311774,
      "title": "山房春事二首 二",
      "content": [
        "梁园日暮乱飞鸦，极目萧条三两家。",
        "庭树不知人死尽，春来还发旧时花。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 311775,
      "title": "逢入京使",
      "content": [
        "故园东望路漫漫，双袖龙钟泪不干。",
        "马上相逢无纸笔，凭君传语报平安。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    }
  ],
