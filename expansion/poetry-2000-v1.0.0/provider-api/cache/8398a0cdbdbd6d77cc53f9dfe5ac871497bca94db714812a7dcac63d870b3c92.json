        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 335135,
      "title": "杂曲歌辞：杂曲",
      "content": [
        "智琼神女，来访文君。",
        "蛾眉始约，罗袖初熏。",
        "歌齐曲韵，"
      ],
      "author": {
        "id": 3286,
        "name": "王勃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 336341,
      "title": "倬彼我系",
      "content": [
        "倬彼我系，出自有周。",
        "分疆锡社，派别支流。",
        "居卫仕宋，臣嬴相刘。",
        "乃武乃文，或公或侯。",
        "晋历崩坼，衣冠扰弊。",
        "粤自太原，播徂江澨。",
        "礼丧贤隐，时屯道闭。",
        "王室如毁，生人多殪。",
        "伊我有器，思逢其主。",
        "自东施西，择木开宇。",
        "田彼河曲，家乎汾浦。",
        "天未厌乱，吾将谁辅。",
        "伊我祖德，思济九埏。",
        "不常厥所，于兹五迁。",
        "欲及时也，夫岂愿焉。",
        "其位虽屈，其言则传。",
        "爰述帝制，大搜王道。",
        "曰天曰人，是祖是考。",
        "礼乐咸若，诗书具草。",
        "贻厥孙谋，永为家宝。",
        "伊余小子，信惭明哲。",
        "彼网有条，彼车有辙。",
        "思屏人事，克终前烈。",
        "于嗟代网，卒余来絏。",
        "来絏伊何，谓余曰仕。",
        "我瞻先达，三十方起。",
        "夫岂不怀，高山仰止。",
        "愿言毓德，啜菽饮水。",
        "有鸟反哺，其声嗷嗷。",
        "言念旧德，忧心忉忉。",
        "今我不养，岁月其滔。",
        "黾勉从役，岂敢告劳。",
        "从役伊何，薄求卑位。",
        "告劳伊何，来参卿事。",
        "名存实爽，负信愆义。",
        "静言遐思，中心是愧。"
      ],
      "author": {
        "id": 3286,
        "name": "王勃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 336342,
      "title": "上巳浮江宴韵得址字",
      "content": [
        "披观玉京路，驻赏金台址。",
        "逸兴怀九仙，良辰倾四美。",
        "松吟白云际，桂馥青溪里。",
        "别有江海心，日暮情何已。"
      ],
      "author": {
        "id": 3286,
        "name": "王勃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 336343,
      "title": "春日宴乐游园赋韵得接字",
      "content": [
        "帝里寒光尽，神皋春望浃。",
        "梅郊落晚英，柳甸惊初叶。",
        "流水抽奇弄，崩云洒芳牒。",
        "清尊湛不空，暂喜平生接。"
      ],
      "author": {
        "id": 3286,
        "name": "王勃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 336344,
      "title": "山亭夜宴",
      "content": [
        "桂宇幽襟积，山亭凉夜永。",
        "森沉野径寒，肃穆岩扉静。",
        "竹晦南汀色，荷翻北潭影。",
        "清兴殊未阑，林端照初景。"
      ],
      "author": {
        "id": 3286,
        "name": "王勃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 336345,
      "title": "咏风",
      "content": [
        "肃肃凉景生，加我林壑清。",
        "驱烟寻涧户，卷雾出山楹。",
        "去来固无迹，动息如有情。",
        "日落山水静，为君起松声。"
      ],
      "author": {
        "id": 3286,
        "name": "王勃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 336347,
      "title": "忽梦游仙",
      "content": [
        "仆本江上客，牵迹在方内。",
        "寤寐霄汉间，居然有灵对。",
        "翕尔登霞首，依然蹑云背。",
        "电策驱龙光，烟途俨鸾态。",
        "乘月披金帔，连星解琼佩。",
        "浮识俄易归，真游邈难再。",
        "寥廓沉遐想，周遑奉遗诲。",
        "流俗非我乡，何当释尘昧。"
      ],
      "author": {
        "id": 3286,
        "name": "王勃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 336348,
      "title": "杂曲",
      "content": [
        "智琼神女，来访文君。",
        "蛾眉始约，罗袖初熏。",
        "歌齐曲韵，舞乱行纷。",
        "若向阳台荐枕，何啻得胜朝云。"
      ],
      "author": {
        "id": 3286,
        "name": "王勃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 336349,
      "title": "秋夜长",
      "content": [
        "秋夜长，殊未央，月明白露澄清光，层城绮阁遥相望。",
        "遥相望，川无梁，北风受节南雁翔，崇兰委质时菊芳。",
        "鸣环曳履出长廊，为君秋夜捣衣裳。",
        "纤罗对凤凰，丹绮双鸳鸯，调砧乱杵思自伤。",
        "思自伤，征夫万里戍他乡。",
        "鹤关音信断，龙门道路长。",
        "君在天一方，寒衣徒自香。"
      ],
      "author": {
        "id": 3286,
        "name": "王勃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 336350,
      "title": "采莲曲",
      "content": [
        "采莲归，绿水芙蓉衣。",
        "秋风起浪凫雁飞。",
        "桂棹兰桡下长浦，罗裙玉腕轻摇橹。",
        "叶屿花潭极望平，",
        "塞外征夫犹未还，江南采莲今已暮。",
        "今已暮，采莲花。",
        "渠今那必尽娼家。",
        "官道城南把桑叶，何如江上采莲花。",
        "莲花复莲花，花叶何稠叠。",
        "叶翠本羞眉，花红强如颊。",
        "佳人不在兹，怅望别离时。",
        "牵花怜共蒂，折藕爱连丝。",
        "故情无处所，新物从华滋。",
        "不惜西津交佩解，",
        "正逢浩荡江上风，又值裴回江上月。",
        "裴回莲浦夜相逢，"
      ],
      "author": {
        "id": 3286,
        "name": "王勃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 336351,
      "title": "临高台",
      "content": [
        "临高台，高台迢递绝浮埃。",
        "瑶轩绮构何崔嵬，",
        "斜对甘泉路，苍苍茂陵树。",
        "高台四望同，",
        "东弥长乐观，西指未央宫。",
        "赤城映朝日，绿树摇春风。",
        "旗亭百隧开新市，甲第千甍分戚里。",
        "朱轮翠盖不胜春，",
        "锦衾夜不襞，罗帷昼未空。",
        "歌屏朝掩翠，妆镜晚窥红。",
        "为君安宝髻，蛾眉罢花丛。",
        "尘间狭路黯将暮，",
        "物色正如此，佳期那不顾。",
        "银鞍绣毂盛繁华，",
        "君看旧日高台处，柏梁铜雀生黄尘。"
      ],
      "author": {
        "id": 3286,
        "name": "王勃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 336352,
      "title": "滕王阁",
      "content": [
        "滕王高阁临江渚，佩玉鸣鸾罢歌舞。",
        "画栋朝飞南浦云，",
        "阁中帝子今何在，槛外长江空自流。"
      ],
      "author": {
        "id": 3286,
        "name": "王勃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 336353,
      "title": "江南弄",
      "content": [
        "江南弄，巫山连楚梦，行雨行云几相送。",
        "瑶轩金谷上春时，玉童仙女无见期。",
        "紫露香烟渺难托，"
      ],
      "author": {
        "id": 3286,
        "name": "王勃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 336358,
      "title": "重别薛华",
      "content": [
        "明月沉珠浦，风飘濯锦川。",
        "楼台临绝岸，洲渚亘长天。",
        "旅泊成千里，栖遑共百年。",
        "穷途唯有泪，还望独潸然。"
      ],
      "author": {
        "id": 3286,
        "name": "王勃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 336360,
      "title": "麻平晚行",
      "content": [
        "百年怀土望，千里倦游情。",
        "高低寻戍道，远近听泉声。",
        "涧叶才分色，山花不辨名。",
        "羁心何处尽，风急暮猿清。"
      ],
      "author": {
        "id": 3286,
        "name": "王勃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 336362,
      "title": "饯韦兵曹",
      "content": [
        "征骖临野次，别袂惨江垂。",
        "川霁浮烟敛，山明落照移。",
        "鹰风凋晚叶，蝉露泣秋枝。",
        "亭皋分远望，延想间云涯。"
      ],
      "author": {
        "id": 3286,
        "name": "王勃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 336364,
      "title": "杜少府之任蜀州",
      "content": [
        "城阙辅三秦，风烟望五津。",
        "与君离别意，同是宦游人。",
        "海记忆体知己，天涯若比邻。",
        "无为在岐路，儿女共沾巾。"
      ],
      "author": {
        "id": 3286,
        "name": "王勃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 336365,
      "title": "仲春郊外",
      "content": [
        "东园垂柳径，西堰落花津。",
        "物色连三月，风光绝四邻。",
        "鸟飞村觉曙，鱼戏水知春。",
        "初晴山院里，何处染嚣尘。"
      ],
      "author": {
        "id": 3286,
        "name": "王勃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 336366,
      "title": "郊兴",
      "content": [
        "空园歌独酌，春日赋闲居。",
        "泽兰侵小径，河柳覆长渠。",
        "雨去花光湿，风归叶影疏。",
        "山人不惜醉，唯畏绿尊虚。"
      ],
      "author": {
        "id": 3286,
        "name": "王勃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 336367,
      "title": "郊园即事",
      "content": [
        "烟霞春旦赏，松竹故年心。",
        "断山疑画障，县溜泻鸣琴。",
        "草遍南亭合，花开北院深。",
        "闲居饶酒赋，随兴欲抽簪。"
      ],
      "author": {
        "id": 3286,
        "name": "王勃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 336368,
      "title": "观佛迹寺",
      "content": [
        "莲座神容俨，松崖圣趾余。",
        "年长金迹浅，地久石文疏。",
        "颓华临曲磴，倾影赴前除。",
        "共嗟陵谷远，俄视化城虚。"
      ],
      "author": {
        "id": 3286,
        "name": "王勃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 336369,
      "title": "山居晚眺赠王道士",
      "content": [
        "金坛疏俗宇，玉洞侣仙群。",
        "花枝栖晚露，峰叶度晴云。",
        "斜照移山影，回沙拥籀文。",
        "琴尊方待兴，竹树已迎曛。"
      ],
      "author": {
        "id": 3286,
        "name": "王勃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 336370,
      "title": "八仙径",
      "content": [
        "柰园欣八正，松岩访九仙。",
        "援萝窥雾术，攀林俯云烟。",
        "代北鸾骖至，辽西鹤骑旋。",
        "终希脱尘网，连翼下芝田。"
      ],
      "author": {
        "id": 3286,
        "name": "王勃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 336372,
      "title": "对酒春园作",
      "content": [
        "投簪下山阁，携酒对河梁。",
        "狭水牵长镜，高花送断香。",
        "繁莺歌似曲，疏蝶舞成行。",
        "自然催一醉，非但阅年光。"
      ],
      "author": {
        "id": 3286,
        "name": "王勃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 336373,
      "title": "观内怀仙",
      "content": [
        "玉架残书隐，金坛旧迹迷。",
        "牵花寻紫涧，步叶下清溪。",
        "琼浆犹类乳，石髓尚如泥。",
        "自能成羽翼，何必仰云梯。"
      ],
      "author": {
        "id": 3286,
        "name": "王勃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 336374,
      "title": "秋日别王长史",
      "content": [
        "别路余千里，深恩重百年。",
        "正悲西候日，更动北梁篇。",
        "野色笼寒雾，山光敛暮烟。",
        "终知难再奉，怀德自潸然。"
      ],
      "author": {
        "id": 3286,
        "name": "王勃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 336377,
      "title": "铜雀妓二首",
      "content": [
        "金凤邻铜雀，漳河望邺城。",
        "君王无处所，台榭若平生。",
        "舞席纷何就，歌梁俨未倾。",
        "西陵松槚冷，谁见绮罗情。",
        "妾本深宫妓，层城闭九重。",
        "君王欢爱尽，歌舞为谁容。",
        "锦衾不复襞，罗衣谁再缝。",
        "高台西北望，流涕向青松。"
      ],
      "author": {
        "id": 3286,
        "name": "王勃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 336378,
      "title": "羁游饯别",
      "content": [
        "客心悬陇路，游子倦江干。",
        "槿丰朝砌静，筱密夜窗寒。",
        "琴声销别恨，风景驻离欢。",
        "宁觉山川远，悠悠旅思难。"
      ],
      "author": {
        "id": 3286,
        "name": "王勃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 336382,
      "title": "伤裴录事丧子",
      "content": [
        "兰阶霜候早，松露穸台深。",
        "魄散珠胎没，芳销玉树沉。",
        "露文晞宿草，烟照惨平林。",
        "芝焚空叹息，流恨满籝金。"
      ],
      "author": {
        "id": 3286,
        "name": "王勃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 336383,
      "title": "泥溪",
      "content": [
        "弭棹凌奔壑，低鞭蹑峻岐。",
        "江涛出岸险，峰磴入云危。",
        "溜急船文乱，岩斜骑影移。",
        "水烟笼翠渚，山照落丹崖。",
        "风生苹浦叶，露泣竹潭枝。",
        "泛水虽云美，劳歌谁复知。"
      ],
      "author": {
        "id": 3286,
        "name": "王勃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 336384,
      "title": "三月曲水宴得烟字",
      "content": [
        "彭泽官初去，河阳赋始传。",
        "田园归旧国，诗酒间长筵。",
        "列室窥丹洞，分楼瞰紫烟。",
        "萦回亘津渡，出没控郊鄽。",
        "凤琴调上客，龙辔俨群仙。",
        "松石偏宜古，藤萝不记年。",
        "重簷交密树，复磴拥危泉。",
        "抗石晞南岭，乘沙眇北川。",
        "傅岩来筑处，磻溪入钓前。",
        "日斜真趣远，幽思梦凉蝉。"
      ],
      "author": {
        "id": 3286,
        "name": "王勃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 336397,
      "title": "临江二首",
      "content": [
        "泛泛东流水，飞飞北上尘。",
        "归骖将别棹，俱是倦游人。",
        "去骖嘶别路，归棹隐寒洲。",
        "江皋木叶下，应想故城秋。"
      ],
      "author": {
        "id": 3286,
        "name": "王勃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 336398,
      "title": "江亭夜月送别二首",
      "content": [
        "江送巴南水，山横塞北云。",
        "津亭秋月夜，谁见泣离群。",
        "乱烟笼碧砌，飞月向南端。",
        "寂寂离亭掩，江山此夜寒。"
      ],
      "author": {
        "id": 3286,
        "name": "王勃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 336399,
      "title": "别人四首",
      "content": [
        "久客逢余闰，他乡别故人。",
        "自然堪下泪，谁忍望征尘。",
        "江上风烟积，山幽云雾多。",
        "送君南浦外，还望将如何。",
        "桂轺虽不驻，兰筵幸未开。",
        "林塘风月赏，还待故人来。",
        "霜华净天末，雾色笼江际。",
        "客子常畏人，何为久留滞。"
      ],
      "author": {
        "id": 3286,
        "name": "王勃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 336400,
      "title": "赠李十四四首",
      "content": [
        "野客思茅宇，山人爱竹林。",
        "琴尊唯待处，风月自相寻。",
        "小径偏宜草，空庭不厌花。",
        "平生诗与酒，自得会仙家。",
        "乱竹开三径，飞花满四邻。",
        "从来扬子宅，别有尚玄人。",
        "风筵调桂轸，月径引藤杯。",
        "直当花院里，书斋望晓开。"
      ],
      "author": {
        "id": 3286,
        "name": "王勃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 336403,
      "title": "冬郊行望",
      "content": [
        "桂密岩花白，梨疏林叶红。",
        "江皋寒望尽，归念断征篷。"
      ],
      "author": {
        "id": 3286,
        "name": "王勃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 336404,
      "title": "寒夜思友三首",
      "content": [
        "久别侵怀抱，他乡变容色。",
        "月下调鸣琴，相思此何极。",
        "云间征思断，月下归愁切。",
        "鸿雁西南飞，如何故人别。",
        "朝朝翠山下，夜夜苍江曲。",
        "复此遥相思，清尊湛芳绿。"
      ],
      "author": {
        "id": 3286,
        "name": "王勃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 336409,
      "title": "秋江送别二首",
      "content": [
        "早是他乡值早秋，江亭明月带江流。",
        "已觉逝川伤别念，复看津树隐离舟。",
        "归舟归骑俨成行，江南江北互相望。",
        "谁谓波澜才一水，已觉山川是两乡。"
      ],
      "author": {
        "id": 3286,
        "name": "王勃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 336411,
      "title": "寒夜怀友杂体二首",
      "content": [
        "北山烟雾始茫茫，南津霜月正苍苍。",
        "秋深客思纷无已，复值征鸿中夜起。",
        "复合重楼向浦开，秋风明月度江来。",
        "故人故情怀故宴，相望相思不相见。"
      ],
      "author": {
        "id": 3286,
        "name": "王勃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 336412,
      "title": "落花落",
      "content": [
        "落花落，落花纷漠漠。",
        "绿叶青跗映丹萼，",
        "落花飞，撩乱入中帷。",
        "落花春正满，春人归不归。",
        "落花度，氛氲绕高树。",
        "落花春已繁，春人春不顾。",
        "绮合青台静且闲，罗袂红巾复往还。",
        "盛年不再得，",
        "与君落花院，台上起双鬟。"
      ],
      "author": {
        "id": 3286,
        "name": "王勃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 336414,
      "title": "出境游山二首",
      "content": [
        "源水终无路，山阿若有人。",
        "驱羊先动石，走兔欲投巾。",
        "洞晚秋泉冷，岩朝古树新。",
        "峰斜连鸟翅，磴叠上鱼鳞。",
        "化鹤千龄早，元龟六代春。",
        "浮云今可驾，沧海自成尘。",
        "振翮凌霜吹，正月伫天浔。",
        "回镳凌翠壑，飞轸控青岑。",
        "岩深灵灶没，涧毁石渠沉。",
        "宫阙云间近，江山物外临。",
        "玉坛栖暮夜，珠洞结秋阴。",
        "萧萧离俗影，扰扰望乡心。",
        "谁意山游好，屡伤人事侵。"
      ],
      "author": {
        "id": 3286,
        "name": "王勃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 336415,
      "title": "河阳桥代窦郎中佳人答杨中舍",
      "content": [
        "披风听鸟长河路，临津织女遥相妒。",
        "判知秋夕带啼还，那及春朝携手度。"
      ],
      "author": {
        "id": 3286,
        "name": "王勃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    }
  ],
