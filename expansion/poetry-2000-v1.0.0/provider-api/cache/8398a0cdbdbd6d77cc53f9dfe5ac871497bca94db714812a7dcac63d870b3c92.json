{
  "data": [
    {
      "id": 277775,
      "title": "九日怀封元寂",
      "content": [
        "九日郊原望，平野遍霜威。",
        "兰气添新酌，花香染别衣。",
        "九秋良会少，千里故人稀。",
        "今日龙山外，当忆雁书归。"
      ],
      "author": {
        "id": 3286,
        "name": "王勃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 277776,
      "title": "出境游山二首 一",
      "content": [
        "源水终无路，山阿若有人。",
        "驱羊先动石，走兔欲投巾。",
        "洞晚秋泉冷，岩朝古树新。",
        "峰斜连鸟翅，磴叠上鱼鳞。",
        "化鹤千龄早，元龟六代春。",
        "浮云今可驾，沧海自成尘。"
      ],
      "author": {
        "id": 3286,
        "name": "王勃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 277777,
      "title": "出境游山二首 二",
      "content": [
        "振翮凌霜吹，正月伫天浔。",
        "回镳凌翠壑，飞轸控青岑。",
        "岩深灵灶没，涧毁石渠沈。",
        "宫阙云间近，江山物外临。",
        "玉坛栖暮夜，珠洞结秋阴。",
        "萧萧离俗影，扰扰望乡心。",
        "谁意山游好屡伤人事侵。"
      ],
      "author": {
        "id": 3286,
        "name": "王勃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 277778,
      "title": "河阳桥代窦郎中佳人答杨中舍",
      "content": [
        "披风听鸟长河路，临津织女遥相妬。",
        "判知秋夕带啼还，那及春朝携手度。"
      ],
      "author": {
        "id": 3286,
        "name": "王勃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 300360,
      "title": "幽居（斯五五五。下同）",
      "content": [
        "涧户风前竹，山空月下琴。",
        "（项疑「山空」为「山窗」之误。",
        "）唯余两□□，应尽百年心。"
      ],
      "author": {
        "id": 3286,
        "name": "王勃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 300361,
      "title": "寺中观卧像",
      "content": [
        "净宇流金□，直诚翳宝床。",
        "自应归寂灭，非是倦津梁。"
      ],
      "author": {
        "id": 3286,
        "name": "王勃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 301370,
      "title": "玄武山圣水宴（幷序）",
      "content": [
        "玄武山有圣泉焉，浸淫历数百千年，（「历」字据阳熙晋《骆临海集笺注》卷九补。",
        "陈熙晋云：「此序各本皆不载，今从《全唐文》录出。",
        "」「子安在梓州所作诗文尚多，恐非骆文。",
        "」）垂岩沁涌，接磴分流，下瞰长江，沙堤石岸，咸古人遗迹也。",
        "兹乃青苹绿芰，紫苔苍藓，遂使江湖思远，寤寐寄托。",
        "既而崇峦左峙，石壑（一作「壁」）前萦，丹崿万寻，碧潭千顷，松风唱响，竹露薫空。",
        "潇潇乎人间之难遇也，方欲以林壑为天属，琴罇为日用。",
        "嗟乎！",
        "古今同逝（一作「代谢」。",
        "）方深川上之悲；少长偕游，且尽山阴之乐。",
        "盍题芳什，共写高情。",
        "诗得泉字。",
        "诗曰。",
        "（《古今图书集成·坤舆典》三六《泉部》）（今按：《全唐诗》五六题作《圣泉宴》，有诗无序，故补序，诗不重录。"
      ],
      "author": {
        "id": 3286,
        "name": "王勃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 301371,
      "title": "陇西行（十首） 一",
      "content": [
        "陇西多名家，子弟复豪华。",
        "千金买骏马，蹀躞长安斜。"
      ],
      "author": {
        "id": 3286,
        "name": "王勃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 301372,
      "title": "陇西行（十首） 二",
      "content": [
        "雕弓侍羽林，宝剑照期门。",
        "南来射猛虎，西去猎平原。"
      ],
      "author": {
        "id": 3286,
        "name": "王勃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 301373,
      "title": "陇西行（十首） 三",
      "content": [
        "既夕罢朝参，薄暮入终南。",
        "田间遭骂詈，低语示乘骖。"
      ],
      "author": {
        "id": 3286,
        "name": "王勃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 301374,
      "title": "陇西行（十首） 四",
      "content": [
        "入被銮舆宠，出视辕门勇。",
        "无劳豪吏猜，常侍当无恐。"
      ],
      "author": {
        "id": 3286,
        "name": "王勃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 301375,
      "title": "陇西行（十首） 五",
      "content": [
        "充国出上邽，李广出天水。",
        "门第倚崆峒，家世垂金紫。"
      ],
      "author": {
        "id": 3286,
        "name": "王勃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 301376,
      "title": "陇西行（十首） 六",
      "content": [
        "麟阁图良将，六郡名居上。",
        "天子重开边，龙云垒相向。"
      ],
      "author": {
        "id": 3286,
        "name": "王勃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 301377,
      "title": "陇西行（十首） 七",
      "content": [
        "烽火照临洮，榆塞马萧萧。",
        "先锋秦子弟，大将霍嫖姚。"
      ],
      "author": {
        "id": 3286,
        "name": "王勃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 301378,
      "title": "陇西行（十首） 八",
      "content": [
        "开壁左贤败，夹战楼兰溃。",
        "献捷上明光，扬鞭歌《入塞》。"
      ],
      "author": {
        "id": 3286,
        "name": "王勃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 301379,
      "title": "陇西行（十首） 九",
      "content": [
        "更欲奏屯田，不必勒燕然。",
        "古人薄军旅，千载谨边关。"
      ],
      "author": {
        "id": 3286,
        "name": "王勃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 301380,
      "title": "陇西行（十首） 十",
      "content": [
        "少妇经年别，开帘知礼客。",
        "门户尔能持，归来笑投策。",
        "（以上同上五六五《巩昌府部》，又乾隆《直隶秦州新志》十一《艺文》于此《诗》）（乾隆《秦州新志》及乾隆《狄道州志》十三收外诗，连作一首。",
        "前书每二十字为一行，或因此而析为十首。"
      ],
      "author": {
        "id": 3286,
        "name": "王勃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 301381,
      "title": "自乡[还]（远）虢",
      "content": [
        "（王福畤之子，勔、勮、勃皆有才名，故杜易简称为三珠树。",
        "其后助、劼、劝，又皆以文显。",
        "勃于兄弟之间极友爱，《自乡[还]〖还〗虢》诗云云。",
        "观此语意，岂兄弟有不相能者耶？",
        "及观《诫功劲云》：「欲不可纵，争不可常，勿轻小忿，将成大殃。",
        "」此二人者，似非处于礼义之域者。",
        "「《棠棣》废」之语，疑为此二人设也。",
        "）人生忽如客，骨肉知何常。",
        "愿及百年内，花萼常相将。",
        "无使《棠棣》废，取譬人无良。",
        "（《韵语阳秋》十）（据影宋本《韵语阳秋》校改。"
      ],
      "author": {
        "id": 3286,
        "name": "王勃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 301382,
      "title": "述怀拟古诗",
      "content": [
        "仆生二十祀，有志十数年。",
        "下策图富贵，上策怀神仙。",
        "（《韵语阳秋》十二）。"
      ],
      "author": {
        "id": 3286,
        "name": "王勃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 301383,
      "title": "示知己（句）",
      "content": [
        "客书同十奏，臣剑已三奔。",
        "（同上。"
      ],
      "author": {
        "id": 3286,
        "name": "王勃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
