{
  "data": [
    {
      "id": 276508,
      "title": "听唱山鹧鸪",
      "content": [
        "金谷歌传第一流，鹧鸪清怨碧烟愁。",
        "夜来省得曾闻处，万里月明湘水秋。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276509,
      "title": "晨起西楼",
      "content": [
        "留情深处驻横波，敛翠凝红一曲歌。",
        "明月下楼人未散，共愁三径是天河。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276510,
      "title": "酬江西卢端公蓝口阻风见寄之什",
      "content": [
        "又携刀笔泛膺舟，蓝口风高桂檝留。",
        "还似郢中歌一曲，夜来春雪照西楼。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276511,
      "title": "赠何处士",
      "content": [
        "东别茅峰北去秦，梅仙书里说真人。",
        "白头主印青山下，虽遇唐生不敢亲。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276512,
      "title": "鹭鸶",
      "content": [
        "西风澹澹水悠悠，雪点丝飘带雨愁。",
        "何限归心倚前合，绿蒲红蓼练塘秋。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276513,
      "title": "学仙二首 一",
      "content": [
        "汉武迎仙紫禁秋，玉笙瑶瑟祀昆丘。",
        "年年望断无消息，空闭重城十二楼。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276514,
      "title": "学仙二首 二",
      "content": [
        "心期仙诀意无穷，采画云车起寿宫。",
        "闻有三山未知处，茂陵松柏满西风。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276515,
      "title": "酬康州韦侍御同年",
      "content": [
        "桂楫美人歌木兰，西风褭褭露溥溥。",
        "夜长曲尽意不尽，月在清湘洲渚寒。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276516,
      "title": "紫藤",
      "content": [
        "绿蔓秾阴紫袖低，客来留坐小堂西。",
        "醉中掩瑟无人会，家近江南罨画溪。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276517,
      "title": "宿咸宜观",
      "content": [
        "羽袖飘飘杳夜风，翠幢归殿玉坛空。",
        "步虚声尽天未晓，露压桃花月满宫。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276518,
      "title": "金谷园",
      "content": [
        "三惑沈身是此园，古藤荒草野禽喧。",
        "二十四友一朝尽，爱妾坠楼何足言。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276519,
      "title": "送崔珦入朝",
      "content": [
        "书劒功迟白发新，强登萧寺送归秦。",
        "月斜松桂倚高阁，明夜江南江北人。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276520,
      "title": "病中和大夫翫江月",
      "content": [
        "江上悬光海上生，仙舟迢遰绕军营。",
        "高歌一曲同筵醉，却是刘桢坐到明。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276521,
      "title": "读戾太子传",
      "content": [
        "佞臣巫蛊已相疑，身没湖边筑望思。",
        "今日更归何处是，年年芳草上台基。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276522,
      "title": "酬对雪见寄",
      "content": [
        "飞度龙山下远空，拂簷萦竹昼蒙蒙。",
        "知君吟罢意无限，曾听玉堂歌北风。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276523,
      "title": "王可封临终",
      "content": [
        "十世为儒少子孙，一生长负信陵恩。",
        "今朝埋骨寒山下，为报慈亲休倚门。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276524,
      "title": "僧院影堂",
      "content": [
        "香销云凝旧僧家，僧刹残灯壁半斜。",
        "日暮松烟空漠漠，秋风吹破妙莲华。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276525,
      "title": "纪梦",
      "content": [
        "晓入瑶台露气清，座中唯有许飞琼。",
        "尘心未尽俗缘在，十里下山空月明。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276526,
      "title": "三十六湾",
      "content": [
        "缥缈临风思美人，荻花枫叶带离声。",
        "夜深吹笛移船去，三十六湾秋月明。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 298098,
      "title": "夜行次东关逢魏扶东归",
      "content": [
        "南北断蓬飘，长亭酒一瓢。",
        "残云归太华，疏雨过中条。",
        "树色随关[迥]，河声入塞遥。",
        "劳歌此分首，风急马萧萧。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 299212,
      "title": "句",
      "content": [
        "蒹葭水暗萤知夜，杨柳风高鴈送秋。",
        "露滴晓花疑锦绣，风吹寒竹认笙簧。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 301043,
      "title": "宣州开元寺赠惟直上人",
      "content": [
        "曾与径山为小师，十年僧行众人知。",
        "夜深月色当禅处，斋后钟声到讲时。",
        "经雨绿苔侵古画，过秋红叶落新诗。",
        "劝君莫厌江城客，虽在风尘别有期。",
        "（见丹徒陈庆年刊《横山草堂丛书》本《许浑诗真迹录》。",
        "）（《全唐诗》卷五二六误作杜牧诗。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 301044,
      "title": "茅山题徐校书隐居",
      "content": [
        "深居四十年，语旧泪潺潺。",
        "官满春辞省，兵来夜出关。",
        "思随江鹤远，心寄海鸥闲。",
        "莫讶频相访，前峰似故山。",
        "（同前。",
        "）（案唐许浑乌丝栏真迹，宋岳珂《宝真斋法书赞》著录之，其跋畧谓「右唐郢州刺史许浑所书乌丝栏诗一百七十一篇真迹，分上下凡二卷。",
        "纤组闲错，辞格华古，笔妙烂然，见为三绝」云云。",
        "《横山草堂丛书》陈庆年跋谓：「用晦真迹自敍云：『编集新旧五百篇』。",
        "《全唐诗》编丁卯诗至五百三十余著，逾于郢州自纪之数，丁卯之诗，宜若一无所遗。",
        "乃《宣州开元寺赠惟直上人一首》与《茅山题徐校书隐居一首》明载于真迹中者，即为《全唐》摭拾所不及。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 301645,
      "title": "题阴阳井",
      "content": [
        "仙人修炼地，玉井著神功。",
        "日月双轮见，阴阳两窍通。",
        "可堪清彻底，那更施无穷。",
        "尚冀丹砂力，当浇俗虑空。",
        "（《弘治句容县志》八《题咏类》）。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 301646,
      "title": "白云潭禅院（在宁国白云山）",
      "content": [
        "一片白云千丈峰，殿略楼阁架虚空。",
        "山僧不语卷帘坐，遥看世间如梦中。",
        "（嘉靖《宁国府志》卷四、卷五两见）。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 358744,
      "title": "赠裴处士",
      "content": [
        "为儒白发生，乡里早闻名。",
        "暖酒雪初下，读书山欲明。",
        "字形翻鸟迹，诗调合猿声。",
        "门外沧浪水，知君欲濯缨。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 358746,
      "title": "王居士",
      "content": [
        "筇杖倚柴关，都城卖卜还。",
        "雨中耕白水，云外㔉青山。",
        "有药身长健，无机性自闲。",
        "即应生羽翼，华表在人间。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 358747,
      "title": "早秋三首",
      "content": [
        "遥夜泛清瑟，西风生翠萝。",
        "残萤委玉露，早雁拂银河。",
        "高树晓还密，远山晴更多。",
        "淮南一叶下，自觉老烟波。",
        "一叶下前墀，淮南人已悲。",
        "蹉跎青汉望，迢递白云期。",
        "老信相如渴，贫忧曼倩饥。",
        "生公与园吏，何处是吾师。",
        "蓟北雁犹远，淮南人已悲。",
        "残桃间堕井，新菊亦侵篱。",
        "书剑岂相误，琴尊聊自持。",
        "西斋风雨夜，更有咏贫诗。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 358748,
      "title": "洛东兰若夜归",
      "content": [
        "一衲老禅床，吾生半异乡。",
        "管弦愁里老，书剑梦中忙。",
        "鸟急山初暝，蝉稀树正凉。",
        "又归何处去，尘路月苍苍。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 358749,
      "title": "送段觉归杜曲闲居",
      "content": [
        "书剑南归去，山扉别几年。",
        "苔侵岩下路，果落洞中泉。",
        "红叶高斋雨，青萝曲槛烟。",
        "宁知远游客，羸马太行前。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 358750,
      "title": "寄天乡寺仲仪上人富春孙处士",
      "content": [
        "诗僧与钓翁，千里两情通。",
        "云带雁门雪，水连渔浦风。",
        "心期荣辱外，名挂是非中。",
        "岁晚亦归去，田园清洛东。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 358751,
      "title": "寄契盈上人",
      "content": [
        "何处是西林，疏钟复远砧。",
        "雁来秋水阔，鸦尽夕阳沉。",
        "婚嫁乖前志，功名异夙心。",
        "汤师不可问，江上碧云深。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 358752,
      "title": "晨起二首",
      "content": [
        "桂树绿层层，风微烟露凝。",
        "簷楹衔落月，帏幌映残灯。",
        "蕲簟曙香冷，越瓶秋水澄。",
        "心闲即无事，何异住山僧。",
        "残月皓烟露，掩门深竹斋。",
        "水虫鸣曲槛，山鸟下空阶。",
        "清镜晓看发，素琴秋寄怀。",
        "因知北窗客，日与世情乖。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 358753,
      "title": "晓发鄞江北渡寄崔韩二先辈",
      "content": [
        "南北信多岐，生涯半别离。",
        "地穷山尽处，江泛水寒时。",
        "露晓蒹葭重，霜晴橘柚垂。",
        "无劳促回楫，千里有心期。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 358754,
      "title": "盈上人",
      "content": [
        "月沉霜已凝，无梦竟寒灯。",
        "寄世何殊客，修身未到僧。",
        "二毛梳上雪，双泪枕前冰。",
        "借问曹溪路，山多路几层。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 358755,
      "title": "广陵道中",
      "content": [
        "城势已坡陀，城边东逝波。",
        "绿桑非苑树，青草是宫莎。",
        "山暝牛羊少，水寒凫雁多。",
        "因高一回首，还咏黍离歌。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 358756,
      "title": "宿开元寺楼",
      "content": [
        "谁家歌袅袅，孤枕在西楼。",
        "竹色寒清簟，松香染翠帱。",
        "月移珠殿晓，风递玉筝秋。",
        "日出应移棹，三湘万里愁。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 358758,
      "title": "送友人自荆襄归江东",
      "content": [
        "商洛转江𣸣，一杯聊送君。",
        "剑愁龙失伴，琴怨鹤离群。",
        "楚驿枕秋水，湘帆凌暮云。",
        "猿声断肠夜，应向雨中闻。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 358759,
      "title": "送同年崔先辈",
      "content": [
        "西风帆势轻，南浦遍离情。",
        "菊艳含秋水，荷花递雨声。",
        "扣舷滩鸟没，移棹草虫鸣。",
        "更忆前年别，槐花满凤城。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 358761,
      "title": "孤雁",
      "content": [
        "昔年双颉颃，池上霭春晖。",
        "霄汉力犹怯，稻粱心已违。",
        "芦洲寒独宿，榆塞夜孤飞。",
        "不及营巢燕，西风相伴归。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 358762,
      "title": "寓怀",
      "content": [
        "南国浣纱伴，盈盈天下姝。",
        "盘金明绣带，动佩响罗襦。",
        "素手怨瑶瑟，清心悲玉壶。",
        "春华坐销落，未忍泣蘼芜。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 358764,
      "title": "夏日戏题郭别驾东堂",
      "content": [
        "微风起画鸾，金翠暗珊珊。",
        "晚树垂朱实，春篁露粉竿。",
        "散香蕲簟滑，沉水越瓶寒。",
        "犹恐何郎热，冰生白玉盘。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 358765,
      "title": "长安旅夜",
      "content": [
        "久客怨长夜，西风吹雁声。",
        "云移河汉浅，月泛露华清。",
        "掩瑟独凝思，缓歌空寄情。",
        "门前有归路，迢递洛阳城。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 358766,
      "title": "㶉𫛶",
      "content": [
        "池寒柳复凋，独宿夜迢迢。",
        "雨顶冠应冷，风毛剑欲飘。",
        "故巢迷碧水，旧侣越丹霄。",
        "不是无归处，心高多寂寥。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 358768,
      "title": "示弟",
      "content": [
        "自尔出门去，泪痕长满衣。",
        "家贫为客早，路远得书稀。",
        "文字何人赏，烟波几日归。",
        "秋风正摇落，孤雁又南飞。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 358769,
      "title": "送杨处士叔初卜居曲江",
      "content": [
        "雁门归去远，垂老脱袈裟。",
        "萧寺休为客，曹溪便寄家。",
        "绿琪千岁树，黄槿四时花。",
        "别怨应无限，门前桂水斜。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 358774,
      "title": "早发中岩寺别契直上人",
      "content": [
        "苍苍松桂阴，残月半西岑。",
        "素壁寒灯暗，红炉夜火深。",
        "厨开山鼠散，钟尽岭猿吟。",
        "行役方如此，逢师懒话心。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 358775,
      "title": "行次潼关题驿后轩",
      "content": [
        "飞阁极层台，终南此路回。",
        "山形朝阙去，河势抱关来。",
        "雁过秋风急，蝉鸣宿雾开。",
        "平生无限意，驱马任尘埃。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 358777,
      "title": "灞东题司马郊园",
      "content": [
        "楚翁秦塞住，昔事李轻车。",
        "白社贫思橘，青门老仰瓜。",
        "读书三径草，沽酒一篱花。",
        "更欲寻芝术，商山便寄家。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 358778,
      "title": "游维山新兴寺，宿石屏村谢叟家",
      "content": [
        "晚过石屏村，村长日渐曛。",
        "僧归下岭见，人语隔溪闻。",
        "谷响寒耕雪，山明夜烧云。",
        "家家扣铜鼓，欲赛鲁将军。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 358779,
      "title": "送从兄归隐蓝溪二首",
      "content": [
        "名高犹素衣，穷巷掩荆扉。",
        "渐老故人少，久贫豪客稀。",
        "塞云横剑望，山月抱琴归。",
        "几日蓝溪醉，藤花拂钓矶。",
        "京洛多高盖，怜兄剧断蓬。",
        "身随一剑老，家入万山空。",
        "夜忆萧关月，行悲易水风。",
        "无人知此意，甘卧白云中。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 358780,
      "title": "村舍",
      "content": [
        "燕雁下秋塘，田家自此忙。",
        "移蔬通远水，收果待繁霜。",
        "野碓舂粳滑，山厨焙茗香。",
        "客来还有酒，随事宿茅堂。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 358782,
      "title": "晚泊七里滩",
      "content": [
        "天晚日沉沉，归舟系柳阴。",
        "江村平见寺，山郭远闻砧。",
        "树密猿声响，波澄雁影深。",
        "荣华暂时事，谁识子陵心。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 358784,
      "title": "晨装",
      "content": [
        "带月饭行侣，西游关塞长。",
        "晨鸡鸣远戍，宿雁起寒塘。",
        "云卷四山雪，风凝千树霜。",
        "谁家游侠子，沉醉卧兰堂。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 358785,
      "title": "题韦隐居西斋",
      "content": [
        "㔉药去还归，家人半掩扉。",
        "山风藤子落，溪雨豆花肥。",
        "寺远僧来少，桥危客到稀。",
        "不闻砧杵动，应解制荷衣。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 358786,
      "title": "送李溟秀才西行",
      "content": [
        "万里不辞劳，寒装叠缊袍。",
        "停车山店雨，挂席海门涛。",
        "鹰势暮偏急，鹤声秋更高。",
        "知君北邙路，留剑泣黄蒿。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 358788,
      "title": "重游郁林寺道玄上人院",
      "content": [
        "藤杖叩松关，春溪㔉药还。",
        "雨晴巢燕急，波暖浴鸥闲。",
        "倚槛花临水，回舟月照山。",
        "忆归师莫笑，书剑在人间。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 358789,
      "title": "泛溪",
      "content": [
        "疑与武陵通，青溪碧嶂中。",
        "水寒深见石，松晚静闻风。",
        "遁迹驱鸡吏，冥心失马翁。",
        "才应毕婚嫁，还此息微躬。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 358792,
      "title": "献白尹",
      "content": [
        "醉舞任生涯，褐宽乌帽斜。",
        "庾公先在郡，疏傅早还家。",
        "林晚鸟争树，园春蜂护花。",
        "高吟应更逸，嵩洛旧烟霞。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 358794,
      "title": "闻薛先辈陪大夫看早梅因寄",
      "content": [
        "涧梅寒正发，莫信笛中吹。",
        "素艳雪凝树，清香风满枝。",
        "折惊山鸟散，携任野蜂随。",
        "今日从公醉，何人倒接z5。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 358795,
      "title": "送前缑氏韦明府南游",
      "content": [
        "酒阑横剑歌，日暮望关河。",
        "道直去官早，家贫为客多。",
        "山昏函谷雨，木落洞庭波。",
        "莫尽远游兴，故园荒薜萝。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 358798,
      "title": "趋慈和寺移宴",
      "content": [
        "高寺移清宴，渔舟系绿萝。",
        "潮平秋水阔，云敛暮山多。",
        "广槛停箫鼓，繁弦散绮罗。",
        "西楼半床月，莫问夜如何。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 358800,
      "title": "送南陵李少府",
      "content": [
        "高人亦未闲，来往楚云间。",
        "剑在心应壮，书穷鬓已斑。",
        "落帆秋水寺，驱马夕阳山。",
        "明日南昌尉，空斋又掩关。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 358801,
      "title": "别韦处士",
      "content": [
        "南北断蓬飞，别多相见稀。",
        "更伤今日酒，未换昔年衣。",
        "旧友几人在，故乡何处归。",
        "秦原向西路，云晚雪霏霏。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 358802,
      "title": "九日登樟亭驿楼",
      "content": [
        "鲈鲙与莼羹，西风片席轻。",
        "潮回孤岛晚，云敛众山晴。",
        "丹羽下高阁，黄花垂古城。",
        "因秋倍多感，乡树接咸京。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 358803,
      "title": "再游越中，伤朱余庆协律好直上人",
      "content": [
        "昔年湖上客，留访雪山翁。",
        "王氏船犹在，萧家寺已空。",
        "月高花有露，烟合水无风。",
        "处处多遗韵，何曾入剡中。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 358806,
      "title": "送惟素上人归新安",
      "content": [
        "山空叶复落，一径下新安。",
        "风急渡溪晚，雪晴归寺寒。",
        "寻云策藤杖，向日倚蒲团。",
        "宁忆西游客，劳劳歌路难。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 358808,
      "title": "下第别友人杨至之",
      "content": [
        "花落水潺潺，十年离旧山。",
        "夜愁添白发，春泪减朱颜。",
        "孤剑北游塞，远书东出关。",
        "逢君话心曲，一醉灞陵间。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 358811,
      "title": "将离郊园留示弟侄",
      "content": [
        "身贱与心违，秋风生旅衣。",
        "久贫辞国远，多病在家稀。",
        "山暝客初散，树凉人未归。",
        "西都万余里，明旦别柴扉。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 358813,
      "title": "题青山馆",
      "content": [
        "昔人诗酒地，芳草思王孙。",
        "白水半塘岸，青山横郭门。",
        "悬岩碑已折，磐石井犹存。",
        "无处继行乐，野花空一尊。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 358814,
      "title": "秋日众哲馆对竹",
      "content": [
        "萧萧凌雪霜，浓翠异三湘。",
        "疏影月移壁，寒声风满堂。",
        "卷帘秋更早，高枕夜偏长。",
        "忽忆秦溪路，万竿今正凉。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 358815,
      "title": "春日题韦曲野老村舍二首",
      "content": [
        "绕屋遍桑麻，村南第一家。",
        "林繁树势直，溪转水纹斜。",
        "竹院昼看笋，药栏春卖花。",
        "故园归未得，到此是天涯。",
        "北岭枕南塘，数家村落长。",
        "莺啼幼妇懒，蚕出小姑忙。",
        "烟草近沟湿，风花临路香。",
        "自怜非楚客，春望亦心伤。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 358816,
      "title": "崇圣寺别杨至之",
      "content": [
        "萧寺暂相逢，离忧满病容。",
        "寒斋秋少燕，阴壁夜多蛩。",
        "树暗水千里，山深云万重。",
        "怀君在书信，莫过雁回峰。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 358823,
      "title": "溪亭二首",
      "content": [
        "溪亭四面山，横柳半溪湾。",
        "蝉响螳螂急，鱼深翡翠闲。",
        "水寒留客醉，月上与僧还。",
        "犹恋萧萧竹，西斋未掩关。",
        "暖枕眠溪柳，僧斋昨夜期。",
        "茶香秋梦后，松韵晚吟时。",
        "共戏鱼翻藻，争栖鸟坠枝。",
        "重阳应一醉，栽菊助东篱。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 358824,
      "title": "秋日赴阙题潼关驿楼",
      "content": [
        "红叶晚萧萧，长亭酒一瓢。",
        "残云归太华，疏雨过中条。",
        "树色随山迥，河声入海遥。",
        "帝乡明日到，犹自梦渔樵。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 358828,
      "title": "南亭与首公宴集",
      "content": [
        "秋来水上亭，几处似岩扃。",
        "戏鸟翻江叶，游龟带绿萍。",
        "管弦心戚戚，罗绮鬓星星。",
        "行乐非吾事，西斋尚有萤。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 358830,
      "title": "泊松江渡",
      "content": [
        "漠漠故宫地，月凉风露幽。",
        "鸡鸣荒戍晓，雁过古城秋。",
        "杨柳北归路，蒹葭南渡舟。",
        "去乡今已远，更上望京楼。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 358831,
      "title": "送鱼思别处士归有怀",
      "content": [
        "宴罢众宾散，长歌携一卮。",
        "溪亭相送远，山郭独归迟。",
        "风槛夕云散，月轩寒露滋。",
        "病来双鬓白，不是旧离时。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 358832,
      "title": "重经姑苏怀古二首",
      "content": [
        "越兵驱绮罗，越女唱吴歌。",
        "宫尽燕声少，台荒麋迹多。",
        "茱萸垂晓露，菡萏落秋波。",
        "无复君王醉，满城颦翠蛾。",
        "香径绕吴宫，千帆落照中。",
        "鹳鸣山欲雨，鱼跃水多风。",
        "城带晚莎绿，池连秋蓼红。",
        "当年国门外，谁识伍员忠。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 358833,
      "title": "将赴京师，留题孙处士山居二首",
      "content": [
        "草堂近西郭，遥对敬亭开。",
        "枕腻海云起，簟凉山雨来。",
        "高歌怀地肺，远赋忆天台。",
        "应学相如志，终须驷马回。",
        "西岩有高兴，路僻几人知。",
        "松荫花开晚，山寒酒熟迟。",
        "游从随野鹤，休息遇灵龟。",
        "长见邻翁说，容华似旧时。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 358841,
      "title": "玩残雪寄江南尹刘大夫",
      "content": [
        "艳阳无处避，皎洁不成容。",
        "素质添瑶水，清光散玉峰。",
        "眠鸥犹恋草，栖鹤未离松。",
        "闻在金銮望，群仙对九重。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 358842,
      "title": "陪越中使院诸公，镜波馆饯明台裴郑二使君",
      "content": [
        "倾幕来华馆，淹留二使君。",
        "舞移清夜月，歌断碧空云。",
        "海郡楼台接，江船剑戟分。",
        "明时自鶱翥，无复叹离群。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 358844,
      "title": "晨别翛然上人",
      "content": [
        "吴僧诵经罢，败衲倚蒲团。",
        "钟韵花犹敛，楼阴月向残。",
        "晴山开殿响，秋水卷帘寒。",
        "独恨孤舟去，千滩复万滩。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 358845,
      "title": "送客江行",
      "content": [
        "萧萧芦荻花，郢客独辞家。",
        "远棹依山响，危樯转浦斜。",
        "不寒澄浅石，潮落涨虚沙。",
        "莫与征徒望，乡园去渐赊。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 358846,
      "title": "将归涂口，宿郁林寺道玄上人院二首",
      "content": [
        "西岩一磬长，僧起树苍苍。",
        "开殿洒寒水，诵经焚晚香。",
        "竹风云渐散，杉露月犹光。",
        "无复重来此，归舟凌夕阳。",
        "春寻采药翁，归路宿禅宫。",
        "云起客眠处，月残僧定中。",
        "藤花深洞水，槲叶满山风。",
        "清境不能住，朝朝惭远公。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 358847,
      "title": "题宣州元处士幽居",
      "content": [
        "潺湲绕门水，未省濯缨尘。",
        "鸟散千岩曙，蜂来一径春。",
        "杉松还待客，芝术不求人。",
        "宁学磻溪叟，逢时罢隐沦。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 358848,
      "title": "送李秀才",
      "content": [
        "南楼送郢客，西郭见荆门。",
        "凫鹄下寒渚，牛羊归远村。",
        "兰舟倚行棹，桂酒掩余尊。",
        "重此一留宿，前村烟水昏。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 358849,
      "title": "题倪处士旧居",
      "content": [
        "儒翁九十余，旧向此山居。",
        "生寄一壶酒，死留千卷书。",
        "槛摧新竹少，池浅故莲疏。",
        "但有子孙在，带经还荷锄。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 358850,
      "title": "赠梁将军",
      "content": [
        "曾经黑山虏，一剑出重围。",
        "年长穷书意，时清隐钓矶。",
        "高斋云外住，瘦马月中归。",
        "唯说乡心苦，春风雁北飞。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 358852,
      "title": "病中二首",
      "content": [
        "三年婴酒渴，高卧似袁安。",
        "秋色鬓应改，夜凉心已宽。",
        "风衣藤簟滑，露井竹床寒。",
        "卧忆郊扉月，恩深未挂冠。",
        "私归人暂适，扶杖绕西林。",
        "风急柳溪响，露寒莎径深。",
        "一身仍白发，万虑只丹心。",
        "此意无言处，高窗托素琴。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 358853,
      "title": "姑熟官舍寄汝洛友人",
      "content": [
        "官静亦无能，平生少面朋。",
        "务开唯印吏，公退只棋僧。",
        "药鼎初寒火，书龛欲夜灯。",
        "安知北溟水，终日送抟鹏。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 358854,
      "title": "恩德寺",
      "content": [
        "楼台横复重，犹有半岩空。",
        "萝洞浅深水，竹廊高下风。",
        "晴山疏雨后，秋树断云中。",
        "未尽平生意，孤帆又向东。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 358856,
      "title": "朗上人院晨坐",
      "content": [
        "簟凉襟袖清，月没尚残星。",
        "山果落秋院，水花开晓庭。",
        "疏藤风袅袅，圆桂露冥冥。",
        "正忆江南寺，岩斋闻诵经。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 358858,
      "title": "过故友旧居",
      "content": [
        "往年公子宅，夜宴乐难忘。",
        "高竹动疏翠，早莲飘暗香。",
        "珠盘凝宝瑟，绮席递华觞。",
        "今日皆何处，闭门春草长。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 358859,
      "title": "送客归峡中",
      "content": [
        "津亭多别离，杨柳半无枝。",
        "住接猿啼处，行逢雁过时。",
        "江风飏帆急，山月下楼迟。",
        "还就西斋宿，烟波劳梦思。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 358860,
      "title": "题冲沼上人院",
      "content": [
        "㔉石种松子，数根侵杳冥。",
        "天寒犹讲律，雨暗尚寻经。",
        "小殿灯千盏，深炉水一瓶。",
        "碧云多别思，休到望溪亭。"
      ],
