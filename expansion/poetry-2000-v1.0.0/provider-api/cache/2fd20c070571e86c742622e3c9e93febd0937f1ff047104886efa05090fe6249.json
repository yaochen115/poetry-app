{
  "data": [
    {
      "id": 377131,
      "title": "应天长·应天长·一钩初月临妆镜",
      "content": [
        "一钩初月临妆镜，蝉鬓凤钗慵不整。",
        "重帘静，层楼迥，惆怅落花风不定。",
        "柳堤芳草径，梦断辘轳金井。",
        "昨夜更阑酒醒，春愁过却病。"
      ],
      "author": {
        "id": 1810,
        "name": "李璟"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377132,
      "title": "望远行·望远行·碧砌花光照眼",
      "content": [
        "碧砌花光照眼明，朱扉长日镇长扃。",
        "馀寒欲去梦难成，炉香烟冷自亭亭。",
        "辽阳月、秣陵砧，不传消息但传情。",
        "黄金台下忽然惊，征人归日二毛生！"
      ],
      "author": {
        "id": 1810,
        "name": "李璟"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377133,
      "title": "摊破浣溪沙·摊破浣溪沙·手卷真珠上玉钩",
      "content": [
        "手卷真珠上玉钩，依前春恨锁重楼。",
        "风里落花谁是主？",
        "思悠悠。",
        "青鸟不传云外信，丁香空结雨中愁。",
        "回首绿波三楚暮，接天流。"
      ],
      "author": {
        "id": 1810,
        "name": "李璟"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377134,
      "title": "摊破浣溪沙·摊破浣溪沙·菡萏香销翠叶残",
      "content": [
        "菡萏香销翠叶残，西风愁起绿波间。",
        "还与韶光共憔悴，不堪看！",
        "细雨梦回鸡塞远，小楼吹彻玉笙寒。",
        "多少泪珠无限恨，倚栏杆。"
      ],
      "author": {
        "id": 1810,
        "name": "李璟"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377135,
      "title": "虞美人·虞美人·春花秋月何时了",
      "content": [
        "春花秋月何时了，往事知多少？",
        "小楼昨夜又东风，故国不堪回首月明中。",
        "雕栏玉砌应犹在，只是朱颜改。",
        "问君能有几多愁？",
        "恰似一江春水向东流。"
      ],
      "author": {
        "id": 6029,
        "name": "李煜"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377136,
      "title": "乌夜啼·乌夜啼·昨夜风兼雨",
      "content": [
        "昨夜风兼雨，帘帏飒飒秋声。",
        "烛残漏断频攲枕，起坐不能平。",
        "世事漫随流水，算来一梦浮生。",
        "醉乡路稳宜频到，此外不堪行。"
      ],
      "author": {
        "id": 6029,
        "name": "李煜"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377137,
      "title": "一斛珠·一斛珠·晓妆初过",
      "content": [
        "晓妆初过，沈檀轻注些儿个。",
        "向人微露丁香颗。",
        "一曲清歌，暂引樱桃破。",
        "罗袖裛残殷色可，杯深旋被香醪涴。",
        "绣床斜凭娇无那。",
        "烂嚼红茸，笑向檀郎唾。"
      ],
      "author": {
        "id": 6029,
        "name": "李煜"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377138,
      "title": "子夜歌·子夜歌·人生愁恨何能免",
      "content": [
        "人生愁恨何能免，销魂独我情何限。",
        "故国梦重归，觉来双泪垂。",
        "高楼谁与上？",
        "长记秋晴望。",
        "往事已成空，还如一梦中。"
      ],
      "author": {
        "id": 6029,
        "name": "李煜"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377139,
      "title": "临江仙·临江仙·樱桃落尽春归去",
      "content": [
        "樱桃落尽春归去，蝶翻轻粉双飞。",
        "子规啼月小楼西。",
        "玉钩罗幕，惆怅暮烟垂。",
        "别巷寂寥人散后，望残烟草低迷。",
        "炉香闲袅凤凰儿。",
        "空持罗带，回首恨依依。"
      ],
      "author": {
        "id": 6029,
        "name": "李煜"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377140,
      "title": "望江南·望江南·多少泪",
      "content": [
        "多少泪，断脸复横颐。",
        "心事莫将和泪说，凤笙休向泪时吹。",
        "肠断更无疑。"
      ],
      "author": {
        "id": 6029,
        "name": "李煜"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377141,
      "title": "望江南·望江南·多少恨",
      "content": [
        "多少恨，昨夜梦魂中。",
        "还似旧时游上苑，车如流水马如龙。",
        "花月正春风。"
      ],
      "author": {
        "id": 6029,
        "name": "李煜"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377142,
      "title": "清平乐·清平乐·别来春半",
      "content": [
        "别来春半，触目柔肠断。",
        "砌下落梅如雪乱，拂了一身还满。",
        "雁来音信无凭，路遥归梦难成。",
        "离恨恰如春草，更行更远还生。"
      ],
      "author": {
        "id": 6029,
        "name": "李煜"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377143,
      "title": "采桑子·采桑子·庭前春逐红英尽",
      "content": [
        "庭前春逐红英尽，舞态徘徊。",
        "细雨霏微，不放双眉时暂开。",
        "绿窗冷静芳英断，香印成灰。",
        "可奈情怀，欲睡朦胧入梦来。"
      ],
      "author": {
        "id": 6029,
        "name": "李煜"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377144,
      "title": "喜迁莺·喜迁莺·晓月坠",
      "content": [
        "晓月坠，宿烟微，无语枕频倾攲。",
        "梦回芳草思依依，天远雁声稀。",
        "啼莺散，馀花乱，寂寞画堂深院。",
        "片红休扫尽从伊，留待舞人归。"
      ],
      "author": {
        "id": 6029,
        "name": "李煜"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377145,
      "title": "蝶恋花·蝶恋花·遥夜亭皋闲信步",
      "content": [
        "遥夜亭皋闲信步。",
        "乍过清明，早觉伤春暮。",
        "数点雨声风约住，朦胧淡月云来去。",
        "桃李依依春暗度。",
        "谁在秋千，笑里低低语？",
        "一片芳心千万绪，人间没个安排处。"
      ],
      "author": {
        "id": 6029,
        "name": "李煜"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377146,
      "title": "相见欢·相见欢·无言独上西楼",
      "content": [
        "无言独上西楼，月如钩。",
        "寂寞梧桐深院，锁清秋。",
        "剪不断，理还乱，是离愁。",
        "别是一般滋味，在心头。"
      ],
      "author": {
        "id": 6029,
        "name": "李煜"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377147,
      "title": "相见欢·相见欢·林花谢了春红",
      "content": [
        "林花谢了春红，太匆匆！",
        "无奈朝来寒雨晚来风。",
        "胭脂泪，留人醉，几时重？",
        "自是人生长恨水长东！"
      ],
      "author": {
        "id": 6029,
        "name": "李煜"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377148,
      "title": "长相思·长相思·云一涡",
      "content": [
        "云一涡，玉一梭。",
        "澹澹衫儿薄薄罗，轻颦双黛螺。",
        "秋风多，雨相和。",
        "帘外芭蕉三两窠。",
        "夜长人奈何？"
      ],
      "author": {
        "id": 6029,
        "name": "李煜"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377149,
      "title": "捣练子令·捣练子令·深院静",
      "content": [
        "深院静，小庭空，断续寒砧断续风。",
        "无奈夜长人不寐，数声和月到帘栊。"
      ],
      "author": {
        "id": 6029,
        "name": "李煜"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377150,
      "title": "浣溪沙·浣溪沙·红日已高三丈透",
      "content": [
        "红日已高三丈透，金炉次第添香兽。",
        "红锦地依随步皱。",
        "佳人舞点金钗溜，酒恶时拈花蕊嗅。",
        "别殿遥闻箫鼓奏。"
      ],
      "author": {
        "id": 6029,
        "name": "李煜"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377151,
      "title": "望江梅·望江梅·闲梦远",
      "content": [
        "闲梦远，南国正芳春。",
        "船上管弦江面绿，满城飞絮滚轻尘。",
        "忙杀看花人。",
        "闲梦远，南国正清秋。",
        "千里江山寒色暮，芦花深处泊孤舟。",
        "笛在月明楼。"
      ],
      "author": {
        "id": 6029,
        "name": "李煜"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377152,
      "title": "菩萨蛮·菩萨蛮·花明月暗笼轻雾",
      "content": [
        "花明月暗笼轻雾，今宵好向郎边去。",
        "铲袜步香阶，手提金缕鞋。",
        "画堂南畔见，一晌偎人颤。",
        "奴为出来难，教郎恣意怜。"
      ],
      "author": {
        "id": 6029,
        "name": "李煜"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377153,
      "title": "菩萨蛮·菩萨蛮·蓬莱院闭天台女",
      "content": [
        "蓬莱院闭天台女，画堂昼寝人无语。",
        "抛枕翠云光，绣衣闻异香。",
        "潜来珠琐动，惊觉银屏梦。",
        "脸慢笑盈盈，相看无限情。"
      ],
      "author": {
        "id": 6029,
        "name": "李煜"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377154,
      "title": "菩萨蛮·菩萨蛮·铜簧韵脆锵寒竹",
      "content": [
        "铜簧韵脆锵寒竹，新声慢奏移纤玉。",
        "眼色暗相钩，秋波横欲流。",
        "雨云深绣户，未便谐衷素。",
        "宴罢又成空，魂迷春梦中。"
      ],
      "author": {
        "id": 6029,
        "name": "李煜"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377155,
      "title": "阮郎归·阮郎归·呈郑王十二弟",
      "content": [
        "东风吹水日衔山，春来长是闲。",
        "落花狼籍酒阑珊，笙歌醉梦间。",
        "佩声悄，晚妆残，凭谁整翠鬟？",
        "留连光景惜春颜，黄昏独倚栏。"
      ],
      "author": {
        "id": 6029,
        "name": "李煜"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377156,
      "title": "浪淘沙·浪淘沙·往事只堪哀",
      "content": [
        "往事只堪哀，对景难排。",
        "秋风庭院藓侵阶。",
        "一任珠帘闲不卷，终日谁来？",
        "金剑已沉埋，壮气蒿莱。",
        "晚凉天净月华开。",
        "想得玉楼瑶殿影，空照秦淮。"
      ],
      "author": {
        "id": 6029,
        "name": "李煜"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377157,
      "title": "采桑子·采桑子·辘轳金井梧桐晚",
      "content": [
        "辘轳金井梧桐晚，几树惊秋。",
        "昼雨如愁，百尺虾须在玉钩。",
        "琼窗梦断双蛾皱，回首边头。",
        "欲寄鳞游，九曲寒波不溯流。"
      ],
      "author": {
        "id": 6029,
        "name": "李煜"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377158,
      "title": "虞美人·虞美人·风回小院庭芜绿",
      "content": [
        "风回小院庭芜绿，柳眼春相续。",
        "凭栏半日独无言，依旧竹声新月似当年。",
        "笙歌未散尊前在，池面冰初解。",
        "烛明香暗画楼深，满鬓清霜残雪思难禁。"
      ],
      "author": {
        "id": 6029,
        "name": "李煜"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377159,
      "title": "玉楼春·玉楼春·晚妆初了明肌雪",
      "content": [
        "晚妆初了明肌雪，春殿嫔娥鱼贯列。",
        "笙箫吹断水云间，重按霓裳歌遍彻。",
        "临春谁更飘香屑？",
        "醉拍栏杆情味切。",
        "归时休放烛光红，待踏马啼清夜月。"
      ],
      "author": {
        "id": 6029,
        "name": "李煜"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377160,
      "title": "子夜歌·子夜歌·寻春须是先春早",
      "content": [
        "寻春须是先春早，看花莫待花枝老。",
        "缥色玉柔擎，醅浮盏面清。",
        "何妨频笑粲，禁苑春归晚。",
        "同醉与闲评，诗随羯鼓成。"
      ],
      "author": {
        "id": 6029,
        "name": "李煜"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377161,
      "title": "谢新恩·谢新恩·秦楼不见吹箫女",
      "content": [
        "秦楼不见吹箫女，空馀上苑风光。",
        "粉英含蕊自低昂。",
        "东风恼我，才发一衿香。",
        "琼窗梦醒留残日，当年得恨何长。",
        "碧栏杆外映垂杨。",
        "暂时相见，如梦懒思量。"
      ],
      "author": {
        "id": 6029,
        "name": "李煜"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377162,
      "title": "谢新恩·谢新恩·樱花落尽阶前月",
      "content": [
        "樱花落尽阶前月，象床愁倚薰笼。",
        "远似去年今日，恨还同。",
        "双鬟不整云憔翠，泪沾红抹胸。",
        "何处相思苦？",
        "纱窗醉梦中。"
      ],
      "author": {
        "id": 6029,
        "name": "李煜"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377163,
      "title": "谢新恩·谢新恩·庭空客散人归后",
      "content": [
        "庭空客散人归后，画堂半掩珠帘。",
        "林风淅淅夜厌厌。",
        "小楼新月，回首自纤纤。",
        "春光镇在人空老，新愁往恨何穷！",
        "金窗力困起还慵。",
        "一声羌笛，惊起醉怡容。"
      ],
      "author": {
        "id": 6029,
        "name": "李煜"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377164,
      "title": "谢新恩·谢新恩·樱花落尽春将困",
      "content": [
        "樱花落尽春将困，秋千架下归时。",
        "漏暗斜月迟迟，花在枝。",
        "□□□□□□□，□□□□□。",
        "彻晓纱窗下，待来君不知。"
      ],
      "author": {
        "id": 6029,
        "name": "李煜"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377165,
      "title": "谢新恩·谢新恩·冉冉秋光留不住",
      "content": [
        "冉冉秋光留不住，满阶红叶暮。",
        "又是过重阳，台榭登临处。",
        "茱萸香坠，紫菊气，飘庭户，晚烟笼细雨。",
        "嗈嗈新雁咽寒声，愁恨年年长相侣。"
      ],
      "author": {
        "id": 6029,
        "name": "李煜"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377166,
      "title": "破阵子·破阵子·四十年来家国",
      "content": [
        "四十年来家国，三千里地山河。",
        "凤阁龙楼连霄汉，玉树琼枝作烟萝，几曾识干戈？",
        "一旦归为臣虏，沈腰潘鬓销磨。",
        "最是仓皇辞庙日，教坊犹奏别离歌，垂泪对宫娥。"
      ],
      "author": {
        "id": 6029,
        "name": "李煜"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377167,
      "title": "浪淘沙令·浪淘沙令·帘外雨潺潺",
      "content": [
        "帘外雨潺潺，春意阑珊。",
        "罗衾不耐五更寒。",
        "梦里不知身是客，一晌贪欢。",
        "独自莫凭栏，无限江山。",
        "别时容易见时难。",
        "流水落花春去也，天上人间"
      ],
      "author": {
        "id": 6029,
        "name": "李煜"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377168,
      "title": "浣溪沙·浣溪沙·风压轻云贴水飞",
      "content": [
        "风压轻云贴水飞，乍晴池馆燕争泥。",
        "沈郎多病不胜衣。",
        "沙上未闻鸿雁信，竹间时听鹧鸪啼。",
        "此情唯有落花知。"
      ],
      "author": {
        "id": 6029,
        "name": "李煜"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377169,
      "title": "长相思·长相思·一重山",
      "content": [
        "一重山，两重山。",
        "山远天高烟水寒，相思枫叶丹。",
        "菊花开，菊花残。",
        "寒雁高飞人未还，一帘风月闲。"
      ],
      "author": {
        "id": 6029,
        "name": "李煜"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377170,
      "title": "柳枝·柳枝·风情渐老见春羞",
      "content": [
        "风情渐老见春羞，到处芳魂感旧游。",
        "多谢长条似旧识，强垂烟穗拂人头。"
      ],
      "author": {
        "id": 6029,
        "name": "李煜"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377171,
      "title": "后庭花破子·后庭花破子·玉树后庭前",
      "content": [
        "玉树后庭前，瑶草妆镜边。",
        "去年花不老，今年月又圆。",
        "莫教偏，和月和花，大教长少年。"
      ],
      "author": {
        "id": 6029,
        "name": "李煜"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377172,
      "title": "三台令·三台令·不寐倦长更",
      "content": [
        "不寐倦长更，披衣出户行。",
        "月寒秋竹冷，风切夜窗声。"
      ],
      "author": {
        "id": 6029,
        "name": "李煜"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377173,
      "title": "捣练子·捣练子·云鬓乱",
      "content": [
        "云鬓乱，晚妆残，带恨眉儿远岫攒。",
        "斜托香腮春笋嫩，为谁和泪倚栏杆。"
      ],
      "author": {
        "id": 6029,
        "name": "李煜"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377174,
      "title": "浣溪沙·浣溪沙·转烛飘蓬一梦归",
      "content": [
        "转烛飘蓬一梦归，欲寻陈迹怅人非。",
        "天教心愿与身违。",
        "待月池馆空逝水，映花楼阁谩斜晖。",
        "登临不惜更沾衣。"
      ],
      "author": {
        "id": 6029,
        "name": "李煜"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377175,
      "title": "渔父·渔父·浪花有意千里雪",
      "content": [
        "浪花有意千里雪，桃花无言一队春。",
        "一壶酒，一竿身，快活如侬有几人。",
        "一棹春风一叶舟，一纶茧缕一轻钩。",
        "花满渚，酒满瓯，万顷波中得自由。"
      ],
      "author": {
        "id": 6029,
        "name": "李煜"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377760,
      "title": "花间集",
      "content": [
        "武德军节度判官司欧阳炯[1]撰镂玉雕琼[2]，拟化工[3]而迥巧；裁花剪叶，夺春艳以争鲜。",
        "是以唱云谣则金母词清[4]，挹霞醴则穆王心醉[5]。",
        "名高《白雪》[6]，声声而自合鸾歌[7]；响遏行云，字字而偏谐凤律[8]。",
        "《杨柳》《大堤》[9]之句，乐府相传；《芙蓉》《曲渚》之篇，豪家自制。",
        "莫不争高门下，三千玳帽之簪[10]；竞富尊前，数十珊瑚之树[11]。",
        "则有绮筵公子，绣幌佳人，递叶叶之花笺，文抽丽锦；举纤纤之",
        "玉指，拍按香檀[12]。",
        "不无清绝之词，用助娇娆之态。",
        "自南朝之宫体[13]，扇北里[14]之倡风。",
        "何止言之不文[15]，所谓秀而不实。",
        "有唐已降，率土之滨[16]，家家之香径春风，宁寻越艳；处处之红楼夜月，自锁嫦娥。",
        "在明皇朝[17]，则有李太白之应制[18]《清平乐》词四首，近代温飞卿复有《金筌集》，迩来[19]作者，无愧前人。",
        "今卫尉少卿字弘基[20]，以拾翠洲边，自得羽毛之异；织绡泉底，独殊机杼之功。",
        "广会众宾，时延[21]佳论。",
        "因集近来诗客曲子词[22]五百首，分为十卷。",
        "以炯[23]粗预知音，辱请命题，仍为叙引。",
        "昔郢人有歌《阳春》者，号为绝唱，乃命之为《花间集》。",
        "庶使西园[24]英哲，用姿羽盖[25]之欢；南国婵娟，休唱莲舟之引[26]。",
        "时大蜀广政三年[27]夏四月日叙。"
      ],
      "author": {
        "id": 7780,
        "name": "赵崇祚"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377761,
      "title": "菩萨蛮·菩萨蛮 其一",
      "content": [
        "小山重叠金明灭，鬓云欲度香腮雪。",
        "懒起画蛾眉，弄妆梳洗迟。",
        "照花前后镜，花面交相映。",
        "新帖绣罗襦，双双金鹧鸪。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377762,
      "title": "菩萨蛮·菩萨蛮 其二",
      "content": [
        "水晶帘里玻璃枕，暖香惹梦鸳鸯锦。",
        "江上柳如烟，雁飞残月天。",
        "藕丝秋色浅，人胜参差剪。",
        "双鬓隔香红，玉钗头上风。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377763,
      "title": "菩萨蛮·菩萨蛮 其三",
      "content": [
        "蕊黄无限当山额，宿妆隐笑纱窗隔。",
        "相见牡丹时，暂来还别离。",
        "翠钗金作股，钗上蝶双舞。",
        "心事竟谁知，月明花满枝。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377764,
      "title": "菩萨蛮·菩萨蛮 其四",
      "content": [
        "翠翘金缕双㶉𫛶，水纹细起春池碧。",
        "池上海棠梨，雨晴红满枝。",
        "绣衫遮笑靥，烟草粘飞蝶。",
        "青琐对芳菲，玉关音信稀。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377765,
      "title": "菩萨蛮·菩萨蛮 其五",
      "content": [
        "杏花含露团香雪，绿杨陌上多离别。",
        "灯在月胧明，觉来闻晓莺。",
        "玉钩褰翠幕，妆浅旧眉薄。",
        "春梦正关情，镜中蝉鬓轻。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377766,
      "title": "菩萨蛮·菩萨蛮 其六",
      "content": [
        "玉楼明月长相忆，柳丝袅娜春无力。",
        "门外草萋萋，送君闻马嘶。",
        "画罗金翡翠，香烛消成泪。",
        "花落子规啼，绿窗残梦迷。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377767,
      "title": "菩萨蛮·菩萨蛮 其七",
      "content": [
        "凤凰相对盘金缕，牡丹一夜经微雨。",
        "明镜照新妆，鬓轻双脸长。",
        "画楼相望久，栏外垂丝柳。",
        "音信不归来，社前双燕回。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377768,
      "title": "菩萨蛮·菩萨蛮 其八",
      "content": [
        "牡丹花谢莺声歇，绿杨满院中庭月。",
        "相忆梦难成，背窗灯半明。",
        "翠钿金压脸，寂寞香闺掩。",
        "人远泪阑干，燕飞春又残。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377769,
      "title": "菩萨蛮·菩萨蛮 其九",
      "content": [
        "满宫明月梨花白，故人万里关山隔。",
        "金雁一双飞，泪痕沾绣衣。",
        "小园芳草绿，家住越溪曲。",
        "杨柳色依依，燕归君不归。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377770,
      "title": "菩萨蛮·菩萨蛮 其十",
      "content": [
        "宝函钿雀金㶉𫛶，沉香阁上吴山碧。",
        "杨柳又如丝，驿桥春雨时。",
        "画楼音信断，芳草江南岸。",
        "鸾镜与花枝，此情谁得知。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377771,
      "title": "菩萨蛮·菩萨蛮 其十一",
      "content": [
        "南园满地堆轻絮，愁闻一霎清明雨。",
        "雨后却斜阳，杏花零落香。",
        "无言匀睡脸，枕上屏山掩。",
        "时节欲黄昏，无聊独倚门。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377772,
      "title": "菩萨蛮·菩萨蛮 其十二",
      "content": [
        "夜来皓月才当午，重帘悄悄无人语。",
        "深处麝烟长，卧时留薄妆。",
        "当年还自惜，往事那堪忆。",
        "花落月明残，锦衾知晓寒。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377773,
      "title": "菩萨蛮·菩萨蛮 其十三",
      "content": [
        "雨暗夜合玲珑日，万枝香袅红丝拂。",
        "闲梦忆金堂，满庭萱草长。",
        "绣帘垂簏簌，眉黛远山绿。",
        "春水渡溪桥，凭栏魂欲消。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377774,
      "title": "菩萨蛮·菩萨蛮 其十四",
      "content": [
        "竹风轻动庭除冷，珠帘月上玲珑影。",
        "山枕隐秾妆，绿檀金凤凰。",
        "两蛾愁黛浅，故国吴宫远。",
        "春恨正关情，画楼残点声。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377775,
      "title": "更漏子·更漏子 其一",
      "content": [
        "柳丝长，春雨细，花外漏声迢递。",
        "惊塞雁，起城乌，画屏金鹧鸪。",
        "香雾薄，透帘幕，惆怅谢家池阁。",
        "红烛背，绣帘垂，梦长君不知。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377776,
      "title": "更漏子·更漏子 其二",
      "content": [
        "星斗稀，钟鼓歇，帘外晓莺残月。",
        "兰露重，柳风斜，满庭堆落花。",
        "虚阁上，倚栏望，还似去年惆怅。",
        "春欲暮，思无穷，旧欢如梦中。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377777,
      "title": "更漏子·更漏子 其三",
      "content": [
        "金雀钗，红粉面，花里暂时相见。",
        "如我意，感君怜，此情须问天。",
        "香作穗，蜡成泪，还似两人心意。",
        "山枕腻，锦衾寒，觉来更漏残。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377778,
      "title": "更漏子·更漏子 其四",
      "content": [
        "相见稀，相忆久，眉浅淡烟如柳。",
        "垂翠幕，结同心，待郎熏绣衾。",
        "城上月，白如雪，蝉鬓美人愁绝。",
        "宫树暗，鹊桥横，玉签初报明。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377779,
      "title": "更漏子·更漏子 其五",
      "content": [
        "背江楼，临海月，城上角声呜咽。",
        "堤柳动，岛烟昏，两行征雁分。",
        "京口路，归帆渡，正是芳菲欲度。",
        "银烛尽，玉绳低，一声村落鸡。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377780,
      "title": "更漏子·更漏子 其六",
      "content": [
        "玉炉香，红蜡泪，偏照画堂秋思。",
        "眉黛薄，鬓云残，夜长衾枕寒。",
        "梧桐树，三更雨，不道离情正苦。",
        "一叶叶，一声声，空阶滴到明。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377781,
      "title": "归国遥·归国遥·香玉",
      "content": [
        "香玉，翠凤宝钗垂簏簌，胜金粟，越罗春水绿。",
        "画堂照帘残烛，梦余更漏促。",
        "谢娘无限心曲，晓屏山断续。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377782,
      "title": "归国遥·归国遥·双脸",
      "content": [
        "双脸，小凤战蓖金飐艳。",
        "舞衣无力风敛，藕丝秋色染。",
        "锦帐绣帷斜掩，露珠清晓簟。",
        "粉心黄蕊花靥，黛眉山两点。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377783,
      "title": "酒泉子·酒泉子·花映柳条",
      "content": [
        "花映柳条，闲向绿萍池上。",
        "凭栏干，窥细浪，雨萧萧。",
        "近来音信两疏索，洞房空寂寞。",
        "掩银屏，垂翠箔，度春宵。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377784,
      "title": "酒泉子·酒泉子·日映纱窗",
      "content": [
        "日映纱窗，金鸭小屏山碧。",
        "故乡春，烟霭隔，背兰釭。",
        "宿妆惆怅倚高阁，千里云影薄。",
        "草初齐，花又落，燕双双。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377785,
      "title": "酒泉子·酒泉子·楚女不归",
      "content": [
        "楚女不归，楼枕小河春水。",
        "月孤明，风又起，杏花稀。",
        "玉钗斜簪云鬟髻，裙上金缕凤。",
        "八行书，千里梦，雁南归。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377786,
      "title": "酒泉子·酒泉子·罗带惹香",
      "content": [
        "罗带惹香，犹系别时红豆。",
        "泪痕新，金缕旧，断离肠。",
        "一双娇燕语雕梁，还是去年时节。",
        "绿阴浓，芳草歇，柳花狂。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377787,
      "title": "定西番·定西番·汉使昔年离别",
      "content": [
        "汉使昔年离别。",
        "攀弱柳，折寒梅，上高台。",
        "千里玉关春雪，雁来人不来。",
        "羌笛一声愁绝，月徘徊。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377788,
      "title": "定西番·定西番·海燕欲飞调羽",
      "content": [
        "海燕欲飞调羽。",
        "萱草绿，杏花红，隔帘栊。",
        "双鬓翠霞金缕，一枝春艳浓。",
        "楼上月明三五，琐窗中。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377789,
      "title": "定西番·定西番·细雨晓莺春晚",
      "content": [
        "细雨晓莺春晚。",
        "人似玉，柳如眉，正相思。",
        "罗幕翠帘初卷，镜中花一枝。",
        "肠断塞门消息，雁来稀。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377790,
      "title": "杨柳枝·杨柳枝·宜春苑外最长条",
      "content": [
        "宜春苑外最长条，闲袅春风伴舞腰。",
        "正是玉人肠绝处，一渠春水赤栏桥。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377791,
      "title": "杨柳枝·杨柳枝·南内墙东御路傍",
      "content": [
        "南内墙东御路傍，须知春色柳丝黄。",
        "杏花未肯无情思，何事行人最断肠。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377792,
      "title": "杨柳枝·杨柳枝·苏小门前柳万条",
      "content": [
        "苏小门前柳万条，毵毵金线拂平桥。",
        "黄莺不语东风起，深闭朱门伴舞腰。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377793,
      "title": "杨柳枝·杨柳枝·金缕毵毵碧瓦沟",
      "content": [
        "金缕毵毵碧瓦沟，六宫眉黛惹香愁。",
        "晚来更带龙池雨，半拂栏干半入楼。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377794,
      "title": "杨柳枝·杨柳枝·馆娃宫外邺城西",
      "content": [
        "馆娃宫外邺城西，远映征帆近拂提。",
        "系得王孙归意切，不关芳草绿萋萋。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377795,
      "title": "杨柳枝·杨柳枝·两两黄鹂色似金",
      "content": [
        "两两黄鹂色似金，袅枝啼露动芳音。",
        "春来幸自长如线，可惜牵缠荡子心。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377796,
      "title": "杨柳枝·杨柳枝·御柳如丝映九重",
      "content": [
        "御柳如丝映九重，凤凰窗映绣芙蓉。",
        "景阳楼畔千条路，一面新妆等晓风。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377797,
      "title": "杨柳枝·杨柳枝·织锦机边莺语频",
      "content": [
        "织锦机边莺语频，停梭垂泪忆征人。",
        "塞门三月犹萧索，纵有垂杨未觉春。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377798,
      "title": "南歌子·南歌子·手里金鹦鹉",
      "content": [
        "手里金鹦鹉，胸前绣凤凰。",
        "偷眼暗形相，不如从嫁与，作鸳鸯。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377799,
      "title": "南歌子·南歌子·似带如丝柳",
      "content": [
        "似带如丝柳，团酥握雪花。",
        "帘卷玉钩斜，九衢尘欲暮，逐香车。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377800,
      "title": "南歌子·南歌子·鬓堕低梳髻",
      "content": [
        "鬓堕低梳髻，连娟细扫眉。",
        "终日两相思，为君憔悴尽，百花时。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377801,
      "title": "南歌子·南歌子·脸上金霞细",
      "content": [
        "脸上金霞细，眉间翠钿深。",
        "倚枕覆鸳衾，隔帘莺百啭，感君心。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377802,
      "title": "南歌子·南歌子·扑蕊添黄子",
      "content": [
        "扑蕊添黄子，呵花满翠鬟。",
        "鸳枕映屏山，明月三五夜，对芳颜。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377803,
      "title": "南歌子·南歌子·转盼如波眼",
      "content": [
        "转盼如波眼，娉婷似柳腰。",
        "花里暗相招，忆君肠欲断，恨春宵。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377804,
      "title": "南歌子·南歌子·懒拂鸳鸯枕",
      "content": [
        "懒拂鸳鸯枕，休缝翡翠裙。",
        "罗帐罢炉熏，近来心更切，为思君。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377805,
      "title": "河渎神·河渎神·河上望丛柯",
      "content": [
        "河上望丛柯，庙前春雨来时。",
        "楚山无限鸟飞迟，兰棹空伤别离。",
        "何处杜鹃啼不歇，艳红开尽如血。",
        "蝉鬓美人愁绝，百花芳草佳节。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377806,
      "title": "河渎神·河渎神·孤庙对寒潮",
      "content": [
        "孤庙对寒潮，西陵风雨萧萧。",
        "谢娘惆怅倚兰桡，泪流玉箸千条。",
        "暮天愁听思归乐，早梅香满山郭。",
        "回首两情萧索，离魂何处飘泊。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
