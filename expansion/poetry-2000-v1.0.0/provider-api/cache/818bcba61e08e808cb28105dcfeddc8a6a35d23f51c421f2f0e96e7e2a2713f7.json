{
  "data": [
    {
      "id": 339054,
      "title": "送相里造入京",
      "content": [
        "子月过秦正，寒云覆洛城。",
        "嗟君未得志，犹作苦辛行。",
        "暖酒嫌衣薄，瞻风候雨晴。",
        "春官含笑待，驱马速前程。"
      ],
      "author": {
        "id": 2684,
        "name": "李颀"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 339059,
      "title": "送卢逸人",
      "content": [
        "洛阳为此别，携手更何时。",
        "不复人间见，只应海上期。",
        "清溪入云木，白首卧茅茨。",
        "共惜卢敖去，天边望所思。"
      ],
      "author": {
        "id": 2684,
        "name": "李颀"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 339063,
      "title": "晚归东园",
      "content": [
        "荆扉带郊郭，稼穑满东菑。",
        "倚杖寒山暮，鸣梭秋叶时。",
        "回云覆阴谷，返景照霜梨。",
        "澹泊真吾事，清风别自兹。"
      ],
      "author": {
        "id": 2684,
        "name": "李颀"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 339065,
      "title": "篱笋",
      "content": [
        "东园长新笋，映日复穿篱。",
        "迸出依青嶂，攒生伴绿池。",
        "色因林向背，行逐地高卑。",
        "但恐春将老，青青独尔为。"
      ],
      "author": {
        "id": 2684,
        "name": "李颀"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 339067,
      "title": "寄司勋卢员外",
      "content": [
        "流澌腊月下河阳，草色新年发建章。",
        "秦地立春传太史，",
        "早晚荐雄文似者，故人今已赋长杨。"
      ],
      "author": {
        "id": 2684,
        "name": "李颀"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 339068,
      "title": "寄綦毋三",
      "content": [
        "新加大邑绶仍黄，近与单车去洛阳。",
        "顾眄一过丞相府，",
        "共道进贤蒙上赏，看君几岁作台郎。"
      ],
      "author": {
        "id": 2684,
        "name": "李颀"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 339069,
      "title": "送魏万之京",
      "content": [
        "朝闻游子唱离歌，昨夜微霜初渡河。",
        "鸿雁不堪愁里听，",
        "莫见长安行乐处，空令岁月易蹉跎。"
      ],
      "author": {
        "id": 2684,
        "name": "李颀"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 339070,
      "title": "送李回",
      "content": [
        "知君官属大司农，诏幸骊山职事雄。",
        "岁发金钱供御府，",
        "不睹声明与文物，自伤流滞去关东。"
      ],
      "author": {
        "id": 2684,
        "name": "李颀"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 339071,
      "title": "宿莹公禅房闻梵",
      "content": [
        "花宫仙梵远微微，月隐高城钟漏稀。",
        "夜动霜林惊落叶，",
        "始觉浮生无住著，顿令心地欲皈依。"
      ],
      "author": {
        "id": 2684,
        "name": "李颀"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 339072,
      "title": "题璿公山池",
      "content": [
        "远公遁迹庐山岑，开士幽居祇树林。",
        "片石孤峰窥色相，",
        "此外俗尘都不染，惟余玄度得相寻。"
      ],
      "author": {
        "id": 2684,
        "name": "李颀"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 339073,
      "title": "题卢五旧居",
      "content": [
        "物在人亡无见期，闲庭系马不胜悲。",
        "窗前绿竹生空地，",
        "忆君泪落东流水，岁岁花开知为谁。"
      ],
      "author": {
        "id": 2684,
        "name": "李颀"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 339074,
      "title": "赠别张兵曹",
      "content": [
        "汉家萧相国，功盖五诸侯。",
        "勋业河山重，丹青锡命优。",
        "君为禁脔婿，争看玉人游。",
        "荀令焚香日，潘郎振藻秋。",
        "新成鹦鹉赋，能衣鹔鹴裘。",
        "不惮轩车远，仍寻薜荔幽。",
        "苑梨飞绛叶，伊水净寒流。",
        "雪满故关道，云遮祥凤楼。",
        "一身轻寸禄，万物任虚舟。",
        "别后如相问，沧波双白鸥。"
      ],
      "author": {
        "id": 2684,
        "name": "李颀"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 339076,
      "title": "圣善阁送裴迪入京",
      "content": [
        "云华满高阁，苔色上钩栏。",
        "药草空阶静，梧桐返照寒。",
        "清吟可愈疾，携手暂同欢。",
        "坠叶和金磬，饥乌鸣露盘。",
        "伊流惜东别，灞水向西看。",
        "旧托含香署，云霄何足难。"
      ],
      "author": {
        "id": 2684,
        "name": "李颀"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 339081,
      "title": "送卢少府赴延陵",
      "content": [
        "问君从宦所，何日府中趋。",
        "遥指金陵县，青山天一隅。",
        "行人怀寸禄，小吏献新图。",
        "北固波涛险，南天风俗殊。",
        "春江连橘柚，晚景媚菰蒲。",
        "漠漠花生渚，亭亭云过湖。",
        "滩沙映村火，水雾敛樯乌。",
        "回首东门路，乡书不可无。"
      ],
      "author": {
        "id": 2684,
        "name": "李颀"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 339082,
      "title": "送皇甫曾游襄阳山水兼谒韦太守",
      "content": [
        "岘山枕襄阳，滔滔江汉长。",
        "山深卧龙宅，水净斩蛟乡。",
        "元凯春秋传，昭明文选堂。",
        "风流满今古，烟岛思微茫。",
        "白雁暮冲雪，青林寒带霜。",
        "芦花独戍晚，柑实万家香。",
        "旧国欲兹别，轻舟眇未央。",
        "百花亭漫漫，一柱观苍苍。",
        "按俗荆南牧，持衡吏部郎。",
        "逢君立五马，应醉习家塘。"
      ],
      "author": {
        "id": 2684,
        "name": "李颀"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 339083,
      "title": "龙门送裴侍御监五岭选",
      "content": [
        "万里番禺地，官人继帝忧。",
        "君为柱下史，将命出东周。",
        "歇马傍川路，张灯临石楼。",
        "棱棱静疏木，濞濞响寒流。",
        "榔叶四荒外，梅花五岭头。",
        "明珠尉佗国，翠羽夜郎洲。",
        "夷俗富珍产，土风资宦游。",
        "心清物不杂，弊革事无留。",
        "举善必称最，持奸当去尤。",
        "何辞桂江远，今日用贤秋。"
      ],
      "author": {
        "id": 2684,
        "name": "李颀"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 339084,
      "title": "送乔琳",
      "content": [
        "草绿小平津，花开伊水滨。",
        "今君不得意，孤负帝乡春。",
        "口不言金帛，心常任屈伸。",
        "阮公惟饮酒，陶令肯羞贫。",
        "阳羡风流地，沧江游寓人。",
        "菱歌五湖远，桂树八公邻。",
        "青鸟迎孤棹，白云随一身。",
        "潮随秣陵上，月映石头新。",
        "未可逃名利，应须在缙绅。",
        "汀洲芳杜色，劝尔暂垂纶。"
      ],
      "author": {
        "id": 2684,
        "name": "李颀"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 339085,
      "title": "题少府监李丞山池",
      "content": [
        "能向府亭内，置兹山与林。",
        "他人骕骦马，而我薜萝心。",
        "雨止禁门肃，莺啼官柳深。",
        "长廊閟军器，积水背城阴。",
        "窗外王孙草，床头中散琴。",
        "清风多仰慕，吾亦尔知音。"
      ],
      "author": {
        "id": 2684,
        "name": "李颀"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 339090,
      "title": "《百花原",
      "content": [
        "百花原头望京师，黄河水流无已时。",
        "穷秋旷野行人绝，马首东来知是谁。"
      ],
      "author": {
        "id": 2684,
        "name": "李颀"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 339095,
      "title": "送东阳王太守",
      "content": [
        "江皋杜蘅绿，芳草日迟迟。",
        "桧楫今何去，星郎出守时。",
        "彤襜问风俗，明主寄惸嫠。",
        "令下不徒尔，人和当在兹。",
        "昔年经此地，微月有佳期。",
        "洞口桂花白，岩前春草滋。",
        "素沙静津濑，青壁带川坻。",
        "野鹤每孤立，林鼯常昼悲。"
      ],
      "author": {
        "id": 2684,
        "name": "李颀"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 339096,
      "title": "咏张諲山水",
      "content": [
        "小山破体闲支策，落日梨花照空壁。",
        "诗堪记室妒风流，画与将军作勍敌。"
      ],
      "author": {
        "id": 2684,
        "name": "李颀"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    }
  ],
