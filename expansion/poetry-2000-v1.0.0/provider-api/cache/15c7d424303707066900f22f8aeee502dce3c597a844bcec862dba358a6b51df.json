    },
    {
      "id": 79820,
      "title": "酬滑州公仪龙图见寄",
      "content": [
        "画舫斋前旧菊丛，十年开落任秋风。",
        "知君为我留红旆，犹记栽花白发翁。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
