{
  "data": [
    {
      "id": 79722,
      "title": "题金山寺",
      "content": [
        "地接龙宫涨浪赊，鹫峰岑绝倚云斜。",
        "岩披宿雾三竿日，路引迷人四照花。",
        "海国盗牙争起塔，河童施钵但惊沙。",
        "春萝攀倚难成去，山谷踈钟落暮霞。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 79723,
      "title": "送窦秀才",
      "content": [
        "晴原高下细如鳞，树转城回路欲分。",
        "望月西楼人共远，跃鞍南陌草初薰。",
        "短亭山翠偏多叠，送目鸿惊不及群。",
        "一驿赋成应援笔，好凭飞翼寄归云。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 79724,
      "title": "旅思",
      "content": [
        "调苦歌非乐，岐多泪始零。",
        "羞弹长铗劔，终恋五侯鲭。",
        "陌草薰沙绿，江枫照岸青。",
        "南陔动归思，兰叶向春馨。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 79725,
      "title": "仙意",
      "content": [
        "孤桐百尺拂非烟，凤去鸾归夜悄然。",
        "沧海风高愁燕远，扶桑春老记蚕眠。",
        "槎流千里才成曲，桂魄经旬始下弦。",
        "独有金人寄遗恨，晓盘云泪冷涓涓。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 79726,
      "title": "闻朱祠部罢浔州归阙",
      "content": [
        "汉柱题名墨未干，南州坐布政条宽。",
        "岭云路隔梅欹驿，使驿秋归柳拂鞍。",
        "建礼侵晨趋冉冉，明光赐对佩珊珊。",
        "颍川此召行闻拜，冠𫠆凝尘俟一弹。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 79727,
      "title": "倦征",
      "content": [
        "沈约伤春思，嵇含倦久游。",
        "帆归黄鹤浦，人滞白苹洲。",
        "乳燕差池远，江禽格磔浮。",
        "物华真可玩，黑鬓恐逢秋。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 79728,
      "title": "郑驾部射圃",
      "content": [
        "梦草西堂射圃连，兰苕初日露华鲜。",
        "晕含画的弦开月，牙算行筹酒满船。",
        "镂管思催吟韵剧，妓帘阴薄舞衣翩。",
        "当筵独愧探牛炙，俭府芙蓉客尽贤。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 79729,
      "title": "甘露寺",
      "content": [
        "云树千寻隔翠微，给园金地敞仁祠。",
        "讲花飘雨诸天近，春漏欹连白日迟。",
        "引钵当空时取露，残灰经劫自成池。",
        "危栏徙倚吟忘下，九子铃寒塔影移。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 79730,
      "title": "送友人南下",
      "content": [
        "河桥别柳减春条，隔浦挐音听已遥。",
        "千里羹莼夸敌酪，满池滮稻欲鸣蜩。",
        "东风楚岸神灵雨，残月吴波上下潮。",
        "如吊湘累搴香若，秋江斜日驻兰桡。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 79731,
      "title": "高楼",
      "content": [
        "六曲雕栏百尺楼，帘波不定瓦如流。",
        "浮云已映楼西北，更向云西待月钩。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 79732,
      "title": "榴花",
      "content": [
        "絮乱丝繁不自持，蜂黄蝶紫燕参差。",
        "榴花最恨来时晚，惆怅春期独后期。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 79733,
      "title": "宿云梦馆",
      "content": [
        "北鴈来时岁欲昏，私书归梦杳难分。",
        "井桐叶落池荷尽，一夜西窗雨不闻。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 79734,
      "title": "𫛴䳏",
      "content": [
        "花残如霰落纷纷，紫陌空遗翠幰尘。",
        "𫛴䳏枉缘催节物，年华不信有伤春。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 79735,
      "title": "帘",
      "content": [
        "银蒜钩帘宛地垂，桂丛乌起上朝晖。",
        "枉将玳瑁雕为押，遮掩春堂碍燕归。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 79736,
      "title": "行雪",
      "content": [
        "叠叠烟波隔梦思，离愁几日减要围。",
        "行云自亦伤无定，莫就行雪托信归。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 79737,
      "title": "琵琶亭上作",
      "content": [
        "九江烟水一登临，风月清含古恨深。",
        "湿尽青衫司马泪，琵琶还似雍门琴。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 79738,
      "title": "柳",
      "content": [
        "雨阔堤长走画辕，絮兼梨雪堕春烟。",
        "东风苑外千丝老，犹伴吴蚕尽日眠。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 79739,
      "title": "井桐",
      "content": [
        "簷欹碧瓦拂倾梧，玉井声高转辘轳。",
        "肠断西楼惊稳梦，半留残月照啼乌。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 79740,
      "title": "雪中寄友人",
      "content": [
        "楚岸梅香半入衣，冻云银铄晓光飞。",
        "遥应便面逢人处，走马章街失路归。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 79741,
      "title": "与谢三学士唱和八首 和国庠劝讲之什",
      "content": [
        "春尽沂风暖，芹生泮水清。",
        "双旌荣照路，博带俨盈庭。",
        "函丈师临席，锵金壁有经。",
        "诸生拜玉衮，欣识象丘形。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 79742,
      "title": "与谢三学士唱和八首 和游午桥庄",
      "content": [
        "晓坛初毕祀，弭盖共寻幽。",
        "鸟哢林中出，泉声冰下流。",
        "攀条惊雪尽，翻袂爱风柔。",
        "好驻城南马，春桑徧陌头。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 79743,
      "title": "与谢三学士唱和八首 和龙门晓望",
      "content": [
        "雾蒙蒙晓望平，悠然驱马独吟行。",
        "烟岚明灭川霞上，凌乱空山百鸟惊。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 79744,
      "title": "与谢三学士唱和八首 除夜偶成拜上学士三丈",
      "content": [
        "万瓦青烟夕霭生，斗杓迎岁转东城。",
        "隋宫守夜沈香燎，楚俗驱神爆竹声。",
        "玉树罗阶家宴盛，羽觞称寿彩衣荣。",
        "九门朝客思公甚，向晓天风舞雪霙。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 79745,
      "title": "与谢三学士唱和八首 陪饮上林院后亭见樱桃花悉已披谢因成七言四韵",
      "content": [
        "寻芳长恨见花迟，岂意看花独后期。",
        "试藉落英聊共醉，为怜残萼更攀枝。",
        "清香肯以无人减，幽艳惟应有蝶知。",
        "开谢两城成怅望，伤春不到柳丝时。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 79746,
      "title": "与谢三学士唱和八首 昨日偶陪后骑同适近郊谨成七言四韵兼呈圣俞",
      "content": [
        "堤柳才黄已落梅，寻芳弭盖共徘徊。",
        "桑城日暖蚕催浴，麦垅风和雉应媒。",
        "别浦人嬉遗翠羽，弋林春废锁歌台。",
        "归鞍暮逼宫街鼓，府吏应惊便面回。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 79747,
      "title": "和八月十五日斋宫对月",
      "content": [
        "皓月三川静，晴氛万里锁。",
        "灵光望日满，寒色入波摇。",
        "灏气成山雾，浮云蔽垅苗。",
        "庙荒阴燐出，苑废露萤飘。",
        "斋馆心方寂，秋城夜已遥。",
        "清谈对元亮，琼彩映萧萧。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 79748,
      "title": "送学士三丈",
      "content": [
        "供帐洛城边，征辕去莫攀。",
        "人醒风外酒，马度雪中关。",
        "故府谁同在，新年独未还。",
        "遥应行路者，偏识彩衣斑。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 79749,
      "title": "双桂楼",
      "content": [
        "嘉树丛生秀，兹楼层汉傍。",
        "飞甍临万井，伏槛出垂杨。",
        "卷幕晴云度，披襟夕籁凉。",
        "山河瞻帝里，风月坐胡床。",
        "爱客东阿宴，清欢北海觞。",
        "淮南多雅咏，岁晚翫幽芳。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 79750,
      "title": "题张应之县斋",
      "content": [
        "小官叹簿领，夫子卧高斋。",
        "五斗未能去，一丘真所怀。",
        "绿苔长秋雨，黄叶堆空阶。",
        "县古仍无柳，池清尚有蛙。",
        "琴觞开月幌，窗户对云崖。",
        "嵩少亦堪老，行当与子偕。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 79751,
      "title": "和梅圣俞杏花",
      "content": [
        "谁道梅花早，残年岂是春。",
        "何如艳风日，独自占芳辰。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 79752,
      "title": "钱相中伏日池亭宴会分韵",
      "content": [
        "罇俎逢佳节，簪缨奉宴居。",
        "林光拂衣冷，云影入池虚。",
        "酒色风前绿，莲香水上踈。",
        "飞谈交玉麈，听曲跃文鱼。",
        "粉箨春苞解，红榴夏实初。",
        "睢园多美物，能赋谢相如。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 79753,
      "title": "送辛判官",
      "content": [
        "被荐方趋召，还乡仍彩衣。",
        "看山向家近，上路逐鸿飞。",
        "结绶同为客，登高独送归。",
        "都门足行者，莫讶柳条稀。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 79754,
      "title": "丛翠亭",
      "content": [
        "柳色满重城，岧岧出翠甍。",
        "春云依槛暖，夕照落山明。",
        "走马章街晓，翻鸿洛浦晴。",
        "清罇但留客，桴鼓昼无惊。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 79755,
      "title": "贺九龙庙祈雪有应",
      "content": [
        "真宰调神化，幽灵应不言。",
        "朝云九渊暗，暮霰六花繁。",
        "朔吹萦归旆，宾裾载后轩。",
        "睢园有客赋，郢曲几人翻。",
        "槐座方虚位，锋车伫改辕。",
        "愿移盈尺瑞，为雨徧群元。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 79756,
      "title": "早春南征寄洛中诸友",
      "content": [
        "楚色穷千里，行人何苦赊。",
        "芳林逢旅鴈，候馆噪山鵶。",
        "春入河边草，花开水上槎。",
        "东风一罇酒，新岁独思家。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 79757,
      "title": "花山寒食",
      "content": [
        "客路逢寒食，花山不见花。",
        "归心随北鴈，先向洛阳家。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 79758,
      "title": "寒食值雨",
      "content": [
        "禁火仍风雨，客心愁复凄。",
        "阴云花更重，春日水平堤。",
        "油壁逢南陌，秋千出绿蹊。",
        "寻芳无厌远，自有锦障泥。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 79759,
      "title": "寄谢晏尚书二绝  其一",
      "content": [
        "送尽残春始到家，主人爱客不须嗟。",
        "红泥煮酒尝青杏，犹向临流藉落花。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 79760,
      "title": "寄谢晏尚书二绝  其二",
      "content": [
        "烂漫残芳不可收，归来惆怅失春游。",
        "绿阴深处闻啼鸟，犹得追闲果下骝。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 79761,
      "title": "留守相公移镇汉东",
      "content": [
        "周郊彻楚坰，旧相拥新旌。",
        "路识青山在，人今白首行。",
        "问农穿稻野，候节见梅英。",
        "腰组人稀识，偏应邸吏惊。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 79762,
      "title": "寄圣俞",
      "content": [
        "平沙漫飞雪，行旅断浮桥。",
        "坐觉山陂阻，空嗟音信遥。",
        "穷阴变寒律，急节惨惊飚。",
        "野斋云犹积，河长冰未销。",
        "山阳人半在，洛社客无聊。",
        "寄问陶彭泽，篮舆谁见邀。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 79763,
      "title": "柴舍人金霞阁",
      "content": [
        "簷前洛阳道，下听走辕声。",
        "树荫春城绿，山明雪野晴。",
        "云藏天外阙，日落柳间营。",
        "缓步应多乐，壶歌咏太平。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 79764,
      "title": "送王公慥判官",
      "content": [
        "久客倦京国，言归岁已冬。",
        "独过伊水渡，犹听洛城钟。",
        "山色经寒绿，云阴入暮重。",
        "腊梅孤馆路，疲马有谁逢。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 79765,
      "title": "伊川独游",
      "content": [
        "绿树遶伊川，人行乱石间。",
        "寒云依晓日，白鸟向青山。",
        "路转香林出，僧归野渡闲。",
        "岩阿谁可访，兴尽复空还。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 79766,
      "title": "游彭城公白莲庄",
      "content": [
        "谢墅多幽赏，华轩曾共寻。",
        "人闲聊载酒，台迥独披襟。",
        "水落陂光淡，城当山气阴。",
        "惟余桃李树，日觉翠蹊深。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 79767,
      "title": "普明院避暑",
      "content": [
        "选胜避炎鬰，林泉清可佳。",
        "拂琴惊水鸟，代麈折山花。",
        "就简刻筠粉，浮瓯烹露芽。",
        "归鞍微带雨，不惜角巾斜。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 79768,
      "title": "送高君先辈还家",
      "content": [
        "闲居寂寞面重城，过我时欣倒屣迎。",
        "入洛机云推俊誉，游梁枚马得英声。",
        "风晴秀野春光变，梅发家林鸟哢轻。",
        "祗待登高成丽赋，汉庭推毂有公卿。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 79769,
      "title": "忆龙门",
      "content": [
        "楚客有归心，因声道故岑。",
        "依依动春色，蔼蔼望香林。",
        "山日岩边下，溪云水上霠。",
        "遥知怀洛社，应复动乡吟。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 79770,
      "title": "赠梅圣俞",
      "content": [
        "黄鹄刷金衣，自言能远飞。",
        "择侣异栖息，终年修羽仪。",
        "朝下玉池饮，暮宿霜桐枝。",
        "徘徊且垂翼，会有秋风时。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 79771,
      "title": "郡人献花",
      "content": [
        "蝶遶蜂游露满盘，芳条可惜折来残。",
        "我缘多病经春卧，砌下花开不暇看。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 79772,
      "title": "龙门泛舟晚向香山",
      "content": [
        "暂解尘中绂，来寻物外游。",
        "搴兰流水曲，弄桂倚山幽。",
        "波影岩前绿，滩声石上流。",
        "忘机不鸥鸟，至乐翫游鯈。",
        "梵响云间出，残阳树杪收。",
        "溪穷兴不尽，系榜且淹留。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 79773,
      "title": "荷叶",
      "content": [
        "采掇本芳陂，移根向玉池。",
        "晴香滋白露，翠色弄清漪。",
        "雨歇凉飚起，烟明夕照移。",
        "如何江上思，偏动越人悲。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 79774,
      "title": "早赴府学释奠",
      "content": [
        "羽籥兴东序，春秋纪上丁。",
        "行祠汉丞相，学礼鲁诸生。",
        "俎豆兼三代，罇罍奠两楹。",
        "雾中槐市暗，日出杏坛明。",
        "昔齿公卿胃，尝闻弦诵声。",
        "何须向阙里，首善本西京。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 79775,
      "title": "和晏尚书夏日偶至郊亭",
      "content": [
        "关关啼鸟树交阴，雨过西城野色侵。",
        "避暑谁能陪剧饮，清歌自可涤烦襟。",
        "稻花欲秀蝉初嘒，菱蔓初长水正深。",
        "知有江湖杳然意，扁舟应许共追寻。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 79776,
      "title": "和晏尚书自嘲",
      "content": [
        "未归归即秉鸿钧，偷醉关亭醉几春。",
        "与物有情宁易得，莫嗔花解久留人。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 79777,
      "title": "题荐严院",
      "content": [
        "那堪多难百忧攻，三十衰容一病翁。",
        "却把西都看花眼，断肠来此哭东风。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 79778,
      "title": "寄题嵩巫亭",
      "content": [
        "平地烟霄向此分，绣楣丹槛照清芬。",
        "风帘暮卷秋空碧，剩见西山数岭云。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 79779,
      "title": "题浄慧大师禅斋",
      "content": [
        "巾屦诸方遍，莓苔一室前。",
        "萎花吟次落，孤月定中圆。",
        "斋钵都人施，谈机海外传。",
        "时应暮钟响，来度禁城烟。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 79780,
      "title": "琵琶亭",
      "content": [
        "乐天曾谪此江边，已叹天涯涕泫然。",
        "今日始知予罪大，夷陵此去更三千。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 79781,
      "title": "初至虎牙滩见江山类龙门",
      "content": [
        "晓鼓潭潭客梦惊，虎牙滩上作船行。",
        "山形酷似龙门秀，江色不如伊水清。",
        "平日两京人少壮，今年三峡岁峥嵘。",
        "卧闻乳石淙流响，疑是香林八节声。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 79782,
      "title": "题张损之学士兰皋亭",
      "content": [
        "埼岸接芳蹊，琴觞此自怡。",
        "林花朝落砌，山月夜临池。",
        "雨积蛙鸣乱，春归鸟哢移。",
        "惟应乘兴客，不待主人知。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 79783,
      "title": "霁后看雪走笔呈元珍判官二首",
      "content": [
        "江上寒山祗对门，野花岩草共嶙峋。",
        "独吟群玉峰前景，闲忆红莲幕下人。",
        "嘉景无人把酒看，县楼终日独凭栏。",
        "山城岁暮惊时节，已作春风料峭寒。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 79784,
      "title": "送致政朱郎中",
      "content": [
        "平生不省问田园，白首忘怀道更尊。",
        "已上印书辞北阙，稍留冠盖饯东门。",
        "冯唐老有为郎恋，疎广终无任子恩。",
        "今日荣归人所羡，两儿腰绶拥高轩。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 79785,
      "title": "留题安州朱氏草堂",
      "content": [
        "俯槛监流蕙径深，平泉花木绕阴森。",
        "蛙鸣鼓吹春喧耳，草暖池塘梦费吟。",
        "赌墅乞甥宾对弈，惊鸿送目手挥琴。",
        "嗟予远捧从军檄，不得披裘五月寻。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 79786,
      "title": "题光化张氏园亭",
      "content": [
        "君家花几种，来自洛之滨。",
        "惟我曾游洛，看花若故人。",
        "芳菲不改色，开洛几经春。",
        "陶令来常醉，山公到最频。",
        "曲池涵草树，啼鸟悦松筠。",
        "相德今方赖，思归未有因。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 79787,
      "title": "和圣俞百花洲二首  其一",
      "content": [
        "野岸溪几曲，松蹊穿翠阴。",
        "不知芳渚远，但爱绿荷深。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 79788,
      "title": "和圣俞百花洲二首  其二",
      "content": [
        "荷深水风阔，雨过清香发。",
        "暮角起城头，归桡带明月。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 79789,
      "title": "鱼",
      "content": [
        "秋水澄清见发毛，锦鳞行处水纹摇。",
        "岸边人影惊还去，时向绿荷深处跳。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 79790,
      "title": "月",
      "content": [
        "天高月影浸长江，江阔风微水面凉。",
        "天水相连为一色，更无纤霭隔清光。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 79791,
      "title": "枨子",
      "content": [
        "嘉树团团俯可攀，压枝秋实渐斓斑。",
        "朱栏碧瓦清霜晓，粲粲繁星绿叶间。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 79792,
      "title": "初冬归襄城弊居",
      "content": [
        "日落原野晦，天寒闾市闲。",
        "牛斗远陂去，鸟雀空簷间。",
        "凭高植藜杖，旷目瞻前山。",
        "垅麦风际绿，霜鵶村外还。",
        "禾黍日已熟，杯酒聊开颜。",
        "酣歌岁云暮，寂寞向柴关。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 79793,
      "title": "和晏尚书对雪招饮",
      "content": [
        "瑶林琼树影交加，谁伴山翁醉帽斜。",
        "自把金船浮白蚁，应须红粉唱梅花。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 79794,
      "title": "滑州归鴈亭",
      "content": [
        "长河终岁足悲风，亭古台荒半倚空。",
        "惟有鴈归时最早，柳含微绿杏粘红。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 79795,
      "title": "送黄通之郧乡",
      "content": [
        "君子贵从俗，小官能养贤。",
        "无惭折腰吏，勉食落头鲜。",
        "困有亭之理，穷当志益坚。",
        "惟宜少近祸，亲发况皤然。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 79796,
      "title": "秋日与诸君马头山登高",
      "content": [
        "晴原霜后若榴红，佳节登临兴未穷。",
        "日泛花光摇露际，酒浮山色入樽中。",
        "金壶恣洒毫端墨，玉麈交挥席上风。",
        "惟有渊明偏好饮，篮舆酩酊一衰翁。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 79797,
      "title": "送杨君归汉上",
      "content": [
        "我昔谪穷县，相逢清汉阴。",
        "拂尘时解榻，置酒屡横琴。",
        "介节温如玉，嘉辞掷若金。",
        "趣当乡士荐，无滞计车音。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 79798,
      "title": "后潭游船见岸上看者有感",
      "content": [
        "喧喧谁暇听歌讴，浪遶春潭逐彩舟。",
        "争得心如汝无事，明年今日更来游。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 79799,
      "title": "春日独居",
      "content": [
        "众喧争去逐春游，独静谁知味最优。",
        "雨霁日长花烂漫，春深睡美梦飘浮。",
        "常忧任重才难了，偶得身闲乐暂偷。",
        "因此益知为郡趣，乞州仍拟乞山州。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 79800,
      "title": "得滕岳阳书大夸湖山之美郡署怀物甚野其意有恋著之趣作诗一百四十言为寄且警激之",
      "content": [
        "峭𪩘孤城倚，平湖远浪来。",
        "万寻迷岛屿，百仞起楼台。",
        "太守凭轩处，群宾奉笏陪。",
        "清霜荐丹橘，积雨过黄梅。",
        "逸思歌湘曲，遒文继楚材。",
        "鱼贪河岫乐，云忘帝乡回。",
        "遥信双鸿下，新缄尺素裁。",
        "因闻夸野景，自笑拥边埃。",
        "龙漠方多孽，旄头久示灾。",
        "旌旗时映日，鼙鼓或惊雷。",
        "有志皆尝胆，何人可凿坏。",
        "儒生半投笔，牧竖亦输财。",
        "沮泽辞犹慢，蒲萄馆未开。",
        "支离莫攘臂，天子正求才。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 79801,
      "title": "幽谷种花洗山",
      "content": [
        "洗出峰峦看腊雪，栽成花木趁新年。",
        "史君功行今将满，谁肯同来作地仙。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 79802,
      "title": "鹭鸶",
      "content": [
        "激石滩声如战鼓，翻天浪色似银山。",
        "滩惊浪打风兼雨，独立亭亭意愈闲。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 79803,
      "title": "赠歌者",
      "content": [
        "病客多年掩绿罇，今宵为尔一颜醺。",
        "可怜玉树庭花后，又向江都月下闻。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 79804,
      "title": "初春",
      "content": [
        "新年变物华，春意日堪嘉。",
        "霁色初含柳，余寒尚勒花。",
        "风丝飞荡漾，林鸟哢交加。",
        "独有无悰者，谁知老可嗟。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 79805,
      "title": "送田处士",
      "content": [
        "秦士多豪侠，夫君久遁名。",
        "青山对高卧，白首喜论兵。",
        "气古时难合，诗精格入评。",
        "公车不久召，归袖夕风生。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 79806,
      "title": "行次寿州寄内",
      "content": [
        "紫金山下水长流，尝记当年此共游。",
        "今夜南风吹客梦，清淮明月照孤舟。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 79807,
      "title": "答吕太博赏双莲",
      "content": [
        "年来因病不饮酒，老去无悰懒作诗。",
        "我已负花常自愧，君须屡醉及芳时。",
        "汉宫姊妹争新宠，湘浦皇英望所思。",
        "天下从来无定色，况将铅黛比天姿。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 79808,
      "title": "酬孙延仲龙图",
      "content": [
        "洛社当年盛莫加，洛阳耆老至今夸。",
        "死生零落余无几，齿发衰残各可嗟。",
        "北库酒醪君旧物，西湖烟水我如家。",
        "已将二美交相胜，仍枉新篇丽彩霞。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 79809,
      "title": "常州张卿养素堂",
      "content": [
        "江左衣冠世有名，几人今复振家声。",
        "朝廷独立清冰节，闾里归来白首卿。",
        "志在言谈犹慷慨，身闲耳目益聪明。",
        "长松野水谁为伴，顾我堪羞恋宠荣。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 79810,
      "title": "西湖泛舟呈运使学士张掞",
      "content": [
        "波光柳色碧溟蒙，曲渚斜桥画舸通。",
        "更远更佳唯恐尽，渐深渐密似无穷。",
        "绮罗香里留佳客，弦管声来飏晚风。",
        "半醉回舟迷向背，楼台高下夕阳中。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 79811,
      "title": "去思堂会饮得春字",
      "content": [
        "世事纷然百态新，西冈一醉十三春。",
        "自惭白发随年少，犹把金钟劝主人。",
        "黄鸟乱飞深夏木，红榴初发艳清晨。",
        "佳时易失闲难得，有酒重来莫厌频。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 79812,
      "title": "太傅相公入陪大祀以疾不行圣恩优贤诏书俞允发于感遇纪以嘉篇小子不揆辄亦课成拙恶诗一首",
      "content": [
        "驿骑频来急诏随，都人相与窃嗟咨。",
        "自非峻节终无改，安得清衷久益思。",
        "前席盖将注谠议，在庭非为乏陪祠。",
        "尊贤优老朝家美，他日安车召未迟。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 79813,
      "title": "寄子春发运待制",
      "content": [
        "广陵花月尝同醉，睢苑风霜暂破颜。",
        "但喜交情久弥重，休嗟人事老多艰。",
        "壮心未忍悲华发，强饮犹能倒玉山。",
        "留滞江湖应不久，多为春酒待君还。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 79814,
      "title": "答许发运见寄",
      "content": [
        "琼花芍药世无伦，偶不题诗便怨人。",
        "曾向无双亭下醉，自知不负广陵春。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 79815,
      "title": "赠庐山僧居讷",
      "content": [
        "方瞳如水衲披肩，邂逅相逢为洒然。",
        "五百僧中得一士，始知林下有遗贤。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 79816,
      "title": "过塞二首",
      "content": [
        "身驱汉马踏胡霜，每叹劳生祗自伤。",
        "气候愈寒人愈北，不如征鴈解随阳。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 79817,
      "title": "晏元献公挽辞三首  其一",
      "content": [
        "接物襟怀旷，推贤品藻精。",
        "谋猷存二府，台阁徧诸生。",
        "帝念宫臣旧，恩隆衮服荣。",
        "春风绿野迥，千两送铭旌。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 79818,
      "title": "晏元献公挽辞三首  其二",
      "content": [
        "四镇名藩忽十春，归来白首两朝臣。",
        "上心方喜亲耆德，物论犹期秉国钧。",
        "退食图书盈一室，开罇谈笑列嘉宾。",
        "昔人风采今人少，恸哭何由赎以身。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
