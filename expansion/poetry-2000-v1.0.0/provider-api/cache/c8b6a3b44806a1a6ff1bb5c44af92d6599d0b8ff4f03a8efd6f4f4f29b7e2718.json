{
  "data": [
    {
      "id": 266147,
      "title": "陪侍御叔游城南山墅",
      "content": [
        "夜坐拥肿亭，昼登崔巍岑。",
        "日窥万峰首，月见双泉心。",
        "松气清耳目，竹氛碧衣襟。",
        "伫想琅玕字，数听枯槁吟。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 266148,
      "title": "登华岩寺楼望终南山赠林校书兄弟",
      "content": [
        "地脊亚为崖，耸出冥冥中。",
        "楼根插迥云，殿翼翔危空。",
        "前山胎元气，灵异生不穷。",
        "势吞万象高，秀夺五岳雄。",
        "一望俗虑醒，再登仙愿崇。",
        "青莲三居士，昼景真赏同。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 266149,
      "title": "游终南山",
      "content": [
        "南山塞天地，日月石上生。",
        "高峰夜留景，深谷昼未明。",
        "山中人自正，路险心亦平。",
        "长风驱松柏，声拂万壑清。",
        "到此悔读书，朝朝近浮名。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 266150,
      "title": "游终南龙池寺",
      "content": [
        "飞鸟不到处，僧房终南巅。",
        "龙在水长碧，雨开山更鲜。",
        "步出白日上，坐依清溪边。",
        "地寒松桂短，石险道路偏。",
        "晚磬送归客，数声落遥天。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 266151,
      "title": "南阳公请东樱桃亭子春䜩",
      "content": [
        "万木皆未秀，一林先含春。",
        "此地独何力，我公布深仁。",
        "霜叶日舒卷，风枝远埃尘。",
        "初英濯紫霞，飞雨流清津。",
        "赏异出嚣杂，折芳积懽忻。",
        "文心兹焉重，俗尚安能珍。",
        "碧玉粧粉比，飞琼秾艳均。",
        "鸳鸯七十二，花态并相新。",
        "常恐遗秀志，迨兹广䜩陈。",
        "芳菲争胜引，歌咏竟良辰。",
        "方知戏马会，永谢登龙宾。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 266152,
      "title": "游华山云台观",
      "content": [
        "华岳独灵异，草木恒新鲜。",
        "山尽五色石，水无一色泉。",
        "仙酒不醉人，仙芝皆延年。",
        "夜闻明星馆，时韵女萝弦。",
        "敬兹不能寐，焚栢吟道篇。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 266153,
      "title": "喜与长文上人宿李秀才小山池亭",
      "content": [
        "灯尽语不尽，主人庭砌幽。",
        "柳枝星影曙，兰叶露华浮。",
        "块岭笑群岫，片池轻众流。",
        "更闻清净子，逸唱颇难俦。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 266154,
      "title": "邀花伴",
      "content": [
        "边地春不足，十里见一花。",
        "及时须邀游，日莫饶风沙。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 266155,
      "title": "石淙 一",
      "content": [
        "岩谷不自胜，水木幽奇多。",
        "朔风入空曲，泾流无大波。",
        "迢递径难尽，参差势相罗。",
        "雪霜有时洗，尘土无由和。",
        "洁冷诚未厌，晚步将如何。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 266156,
      "title": "石淙 二",
      "content": [
        "出曲水未断，入山深更重。",
        "泠泠若仙语，皎皎多异容。",
        "万响不相杂，四时皆有浓。",
        "日月互分照，云霞各生峰。",
        "久迷向方理，逮兹耸前踪。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 266157,
      "title": "石淙 三",
      "content": [
        "荒策每恣远，戆步难自回。",
        "已抱苔藓疾，尚凌潺湲隈。",
        "驿骥苦衔勒，笼禽恨摧颓。",
        "实力苟未足，浮夸信悠哉。",
        "顾惟非时用，静言还自咍。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 266158,
      "title": "石淙 四",
      "content": [
        "朔水刀劒利，秋石琼瑶鲜。",
        "鱼龙气不腥，潭洞状更妍。",
        "磴雪入呀谷，掬星洒遥天。",
        "声忙不及韵，势疾多断涟。",
        "输去虽有恨，躁气一何颠。",
        "蜿蜒相缠掣，荦确亦回旋。",
        "黑草濯铁发，白苔浮冰钱。",
        "具生此云遥，非德不可甄。",
        "何况被犀士，制之空以权。",
        "始知静刚猛，文教从来先。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 266159,
      "title": "石淙 五",
      "content": [
        "空谷耸视听，幽湍泽心灵。",
        "疾流脱鳞甲，叠岸冲风霆。",
        "丹𪩘堕环景，霁波灼虚形。",
        "淙淙豗厚轴，棱棱攒高冥。",
        "弱栈跨旋碧，危梯倚凝青。",
        "飘飘鹤骨仙，飞动鼇背庭。",
        "常闻夸大言，下顾皆细萍。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 266160,
      "title": "石淙 六",
      "content": [
        "百尺明镜流，千曲寒星飞。",
        "为君洗故物，有色如新衣。",
        "不饮泥土污，但饮雪霜饥。",
        "石棱玉纤纤，草色琼霏霏。",
        "谷硙有余力，溪舂亦多机。",
        "从来一智萌，能使众利归。",
        "因之山水中，喧然论是非。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 266161,
      "title": "石淙 七",
      "content": [
        "入深得奇趣，升险为良跻。",
        "搜胜有闻见，逃俗无踪蹊。",
        "穴流恣回转，窍景忘东西。",
        "戆兽鲜猜惧，罗人巧罝罤。",
        "幽驰异处所，忍虑多端倪。",
        "虚护我何饱，实归彼非迷。",
        "斯文浪云洁，此旨谁得齐。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 266162,
      "title": "石淙 八",
      "content": [
        "屑珠泻潺湲，裂玉何威瓌。",
        "若调千瑟弦，未果一曲谐。",
        "古骇毛发栗，险惊视听乖。",
        "二老皆劲骨，风趋缘欹崖。",
        "地远有余美，我游采弃怀。",
        "乘时幸勤鉴，前恨多幽霾。",
        "弱力谢刚健，蹇策贵安排。",
        "始知随事静，何必当夕斋。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 266163,
      "title": "石淙 九",
      "content": [
        "昔浮南渡飙，今攀朔山景。",
        "物色多瘦削，吟笑还孤永。",
        "日月冻有棱，雪霜空无影。",
        "玉喷不生冰，瑶涡旋成井。",
        "潜角时耸光，隐鳞乍漂冏。",
        "再吟获新胜，返步失前省。",
        "惬怀虽已多，惕虑未能整。",
        "颓阳落何处，升魄衔疎岭。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 266164,
      "title": "石淙 十",
      "content": [
        "圣朝搜岩谷，此地多遗玩。",
        "怠惰成远游，顽疎恣灵观。",
        "劲飙刷幽视，怒水慑余愞。",
        "曾是结芳诚，远兹勉流倦。",
        "冰条耸危虑，霜翠莹遐眄。",
        "物诱信多端，荒寻谅难遍。",
        "去矣朔之隅，翛然楚之甸。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 266165,
      "title": "游韦七洞庭别业",
      "content": [
        "洞庭如潇湘，叠翠荡浮碧。",
        "松桂无赤日，风物饶清激。",
        "逍遥展幽韵，参差逗良觌。",
        "道胜不知疲，冥搜自无斁。",
        "旷然青霞抱，永矣白雪适。",
        "崆峒非凡乡，蓬瀛在仙籍。",
        "无言从远尚，还思君子识。",
        "波涛漱古岸，铿锵辨奇石。",
        "灵响非外求，殊音自中积。",
        "人皆走烦浊，君能致虚寂。",
        "何以祛扰扰，叩调清淅淅。",
        "既惧豪华损，誓从诗书益。",
        "一举独往姿，再摇飞遁迹。",
        "山深有变异，意惬无惊惕。",
        "采翠夺日月，照耀迷昼夕。",
        "松斋何用扫，萝院自然涤。",
        "业峻谢烦芜，文高追古昔。",
        "暂遥朱门恋，终立青史绩。",
        "物表易淹留，人间重离析。",
        "难随洞庭酌，且醉横塘席。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 266166,
      "title": "越中山水",
      "content": [
        "日觉耳目胜，我来山水州。",
        "蓬瀛若髣髴，田野如泛浮。",
        "碧嶂几千遶，清泉万余流。",
        "莫穷合沓步，孰尽派别游。",
        "越水净难污，越天阴易收。",
        "气鲜无隐物，目视远更周。",
        "举俗媚葱蒨，连冬撷芳柔。",
        "菱湖有余翠，茗圃无荒畴。",
        "赏异忽已远，探奇诚淹留。",
        "永言终南色，去矣销人忧。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 266167,
      "title": "春集越州皇甫秀才山亭",
      "content": [
        "嘉宾在何处，置亭春山巅。",
        "顾余寂寞者，谬厕芳菲筵。",
        "视听日澄澈，声光坐连绵。",
        "晴湖泻峰嶂，翠浪多萍藓。",
        "何以逞高志，为君吟秋天。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 266168,
      "title": "和皇甫判官游瑯琊溪",
      "content": [
        "山中琉璃境，物外瑯琊溪。",
        "房廊逐岩壑，道路随高低。",
        "碧濑漱白石，翠烟含青蜺。",
        "客来暂游践，意欲忘簪珪。",
        "树杪灯火夕，云端钟梵齐。",
        "时同虽可仰，迹异难相携。",
        "唯当清宵梦，髣髴愿攀跻。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 266169,
      "title": "汝州南潭陪陆中丞公䜩",
      "content": [
        "一雨百泉涨，南潭夜来深。",
        "分明碧沙底，写出青天心。",
        "远客洞庭至，因兹涤烦襟。",
        "既登飞云舫，愿奏清风琴。",
        "高岸立旗戟，潜蛟失浮沈。",
        "威棱护斯浸，魍魉逃所侵。",
        "山态变初霁，水声流新音。",
        "耳目极眺听，潺湲与嵚岑。",
        "谁言柳太守，空有白苹吟。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 266170,
      "title": "汝州陆中丞席喜张从事至同赋十韵",
      "content": [
        "汝水无浊波，汝山饶奇石。",
        "大贤为此郡，佳士来如积。",
        "有客乘白驹，奉义惬所适。",
        "清风荡华馆，雅瑟泛瑶席。",
        "芳醑静无喧，金尊光有涤。",
        "纵情孰虑损，听论自招益。",
        "愿折若木枝，却彼曜灵夕。",
        "贵贱一相接，忧悰忽转易。",
        "会合勿言轻，别离古来惜。",
        "请君驻征车，良遇难再觌。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 266171,
      "title": "夜集汝州郡斋听陆僧辩弹琴",
      "content": [
        "康乐宠词客，清宵意无穷。",
        "征文北山外，借月南楼中。",
        "千里愁并尽，一樽欢暂同。",
        "胡为戛楚琴，淅沥起寒风。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 266172,
      "title": "同年春燕",
      "content": [
        "少年三十士，嘉会良在兹。",
        "高歌摇春风，醉舞摧花枝。",
        "意荡晼晚景，喜凝芳菲时。",
        "马迹攒騕褭，乐声韵参差。",
        "视听改旧趣，物象含新姿。",
        "红雨花上滴，绿烟柳际垂。",
        "淹中讲精义，南皮献清词。",
        "前贤与今人，千载为一期。",
        "明鉴有皎洁，澄玉无磷缁。",
        "永与沙泥别，各整云汉仪。",
        "盛气自中积，英名日四驰。",
        "塞鸿绝俦匹，海月难等夷。",
        "郁抑忽已尽，亲朋乐无涯。",
        "幽蘅发空曲，芳杜绵所思。",
        "浮迹自聚散，壮心谁别离。",
        "愿保金石志，无令有夺移。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 266173,
      "title": "罗氏花下奉招陈侍御",
      "content": [
        "眼在枝上春，落地成埃尘。",
        "不是风流者，谁为攀折人。",
        "宁辞波浪阔，莫道往来频。",
        "拾紫岂宜晚，掇芳须及晨。",
        "劳收贾生泪，强起屈平身。",
        "花下本无俗，酒中别有神。",
        "游蜂不饮故，戏蝶亦争新。",
        "万物尽如此，过时非所珍。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 266174,
      "title": "游石龙涡",
      "content": [
        "石龙不见形，石雨如散星。",
        "山下晴皎皎，山中阴泠泠。",
        "水飞林木杪，珠缀莓苔屏。",
        "畜异物皆别，当晨景欲暝。",
        "泉芳春气碧，松月寒色青。",
        "险力此独壮，猛兽亦不停。",
        "日暮且回去，浮心恨未宁。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 266175,
      "title": "浮石亭",
      "content": [
        "曾是风雨力，崔巍漂来时。",
        "落星夜皎洁，近榜朝逶迤。",
        "翠潋递明灭，清潨泻欹危。",
        "况逢蓬岛仙，会合良在兹。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 266176,
      "title": "看花 一",
      "content": [
        "家家有芍药，不妨至温柔。",
        "温柔一同女，红笑笑不休。",
        "月娥双双下，楚艳枝枝浮。",
        "洞里逢仙人，绰约青宵游。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 266177,
      "title": "看花 二",
      "content": [
        "芍药谁为壻，人人不敢来。",
        "唯应待诗老，日日殷勤开。",
        "玉立无气力，春凝且裴徊。",
        "将何谢青春，痛饮一百杯。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 266178,
      "title": "看花 三",
      "content": [
        "芍药吹欲尽，无奈晓风何。",
        "余花欲谁待，唯待谏郎过。",
        "谏郎不事俗，黄金买高歌。",
        "高歌夜更清，花意晚更多。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 266179,
      "title": "看花 四",
      "content": [
        "饮之不见底，醉倒深红波。",
        "红波荡谏心，谏心终无它。",
        "独游终难醉，挈榼徒经过。",
        "问花不解语，劝得酒无多。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 266180,
      "title": "看花 五",
      "content": [
        "三年此村落，春色入心悲。",
        "料得一孀妇，经时独泪垂。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 266181,
      "title": "济源春",
      "content": [
        "太行横偃脊，百里芳崔巍。",
        "济滨花异颜，枋口云如裁。",
        "新画彩色湿，上界光影来。",
        "深红缕草木，浅碧珩溯洄。",
        "千家门前饮，一道传禊杯。",
        "玉鳞吞金钩，仙璇瑠璃开。",
        "朴童茂言语，善俗无惊猜。",
        "狂吹寝恒宴，晓清梦先回。",
        "治生鲜惰夫，积学多深材。",
        "再游讵癫戆，一洗惊尘埃。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 266182,
      "title": "济源寒食 一",
      "content": [
        "风巢袅袅春鵶鵶，无子老人仰面嗟。",
        "柳弓苇箭覰不见，高红远绿劳相遮。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 266183,
      "title": "济源寒食 二",
      "content": [
        "女婵童子黄短短，耳中闻人惜春晚。",
        "逃蜂匿蝶踏地来，抛却斋糜一瓷椀。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 266184,
      "title": "济源寒食 三",
      "content": [
        "一日踏春一百回，朝朝没脚走芳埃。",
        "饥童饿马埽花喂，向晚饮溪三两杯。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 266185,
      "title": "济源寒食 四",
      "content": [
        "莓苔井上空相忆，辘轳索断无消息。",
        "酒人皆倚春发绿，病叟独藏秋发白。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 266186,
      "title": "济源寒食 五",
      "content": [
        "长安落花飞上天，南风引至三殿前。",
        "可怜春物亦朝谒，唯我孤吟渭水边。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 266187,
      "title": "济源寒食 六",
      "content": [
        "枋口花间掣手归，嵩阳为我留红晖。",
        "可怜踯躅千万尺，柱地柱天疑欲飞。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 266188,
      "title": "济源寒食 七",
      "content": [
        "蜜蜂为主各磨牙，咬尽村中万木花。",
        "君家瓮瓮今应满，五色冬笼甚可夸。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 266189,
      "title": "游枋口 一",
      "content": [
        "一步复一步，出行千里幽。",
        "为取山水意，故作寂寞游。",
        "太行青巅高，枋口碧照浮。",
        "明明无底镜，泛泛忘机鸥。",
        "老逸不自限，病狂不可周。",
        "恣闲饶淡薄，怠玩多淹留。",
        "芳物竞晼晚，绿梢挂新柔。",
        "和友莺相遶，言语亦以稠。",
        "始知万类然，静躁难相求。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 266190,
      "title": "游枋口 二",
      "content": [
        "耸我残病骨，健如一仙人。",
        "镜中照千里，镜浪洞百神。",
        "此神日月华，不作寻常春。",
        "三十夜皆明，四时昼恒新。",
        "鸟声尽依依，兽心亦忻忻。",
        "澄幽出所怪，闪异坐微絪。",
        "可来复可来，此地灵相亲。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 266191,
      "title": "与王二十一员外涯游枋口柳溪",
      "content": [
        "万株古柳根，挐此磷磷溪。",
        "野榜多屈曲，仙浔无端倪。",
        "春桃散红烟，寒竹含晚凄。",
        "晓听忽以异，芳树安能齐。",
        "共疑落镜中，坐泛红景低。",
        "水意酒易醒，浪情事非迷。",
        "小儒峭章句，大贤嘉提携。",
        "潜窦韵灵瑟，翠崖鸣玉珪。",
        "主人稷卨翁，德茂芝术畦。",
        "凿出幽隐端，气象皆升跻。",
        "曾是清乐抱，逮兹几省溪。",
        "宴位席兰草，滥觞惊凫鹥。",
        "灵味荐鲂瓣，金花屑橙韲。",
        "江调摆衰俗，洛风远尘泥。",
        "徒言奏狂狷，讵敢忘筌蹄。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 266192,
      "title": "与王二十一员外涯游昭成寺",
      "content": [
        "洛友寂寂约，省骑霏霏尘。",
        "游僧步晚磬，话茗含芳春。",
        "瑶策冰入手，粉壁画莹神。",
        "頳廊芙蓉霁，碧殿瑠璃匀。",
        "玄讲岛岳尽，渊咏文字新。",
        "屡笑寒竹䜩，况接青云宾。",
        "顾慙余眷下，衰瘵婴残身。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 266193,
      "title": "嵩少",
      "content": [
        "沙弥舞袈裟，走向踯躅飞。",
        "闲步亦惺惺，芳援相依依。",
        "噎塞春咽喉，蜂蝶事光辉。",
        "群嬉且已晚，孤引将何归。",
        "流艳去不息，朝英亦疎微。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 266194,
      "title": "旅次洛城东水亭",
      "content": [
        "水竹色相洗，碧花动轩楹。",
        "自然逍遥风，荡涤浮竞情。",
        "霜落叶声燥，景寒人语清。",
        "我来招隐亭，衣上尘暂轻。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 266195,
      "title": "洛桥晚望",
      "content": [
        "天津桥下冰初结，洛阳陌上人行绝。",
        "榆柳萧疎楼阁闲，月明直见嵩山雪。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 266196,
      "title": "北郭贫居",
      "content": [
        "进乏广莫力，退为蒙笼居。",
        "三年失意归，四向相识疎。",
        "地僻草木壮，荒条扶我庐。",
        "夜贫灯烛绝，明月照吾书。",
        "欲识贞静操，秋蝉饮清虚。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 266197,
      "title": "题陆鸿渐上饶新开山舍",
      "content": [
        "惊彼武陵状，移归此岩边。",
        "开亭拟贮云，凿石先得泉。",
        "啸竹引清吹，吟花成新篇。",
        "乃知高洁情，摆落区中缘。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 266198,
      "title": "题韦承总吴王故城下幽居",
      "content": [
        "才饱身自贵，巷荒门岂贫。",
        "韦生堪继相，孟子愿依邻。",
        "夜思琴语切，昼情茶味新。",
        "霜枝留过鹊，风竹扫蒙尘。",
        "郢唱一声发，吴花千片春。",
        "对君何所得，归去觉情真。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 266199,
      "title": "苏州昆山惠聚寺僧房",
      "content": [
        "昨日到上方，片云挂石床。",
        "锡杖莓苔青，袈裟松栢香。",
        "晴磬无短韵，古灯含永光。",
        "有时乞鹤归，还访逍遥场。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 266200,
      "title": "题从叔述灵岩山壁",
      "content": [
        "换却世上心，独起山中情。",
        "露衣凉且鲜，云策高复轻。",
        "喜见夏日来，变为松景清。",
        "每将逍遥听，不厌飕飗声。",
        "远念尘末宗，未疎俗间名。",
        "桂枝妄举手，萍路空劳生。",
        "仰谢开净弦，相招时一鸣。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 266201,
      "title": "题林校书花严寺书窗",
      "content": [
        "隐咏不夸俗，问禅徒净居。",
        "翻将白云字，寄向青莲书。",
        "拟古投松坐，就明开纸疏。",
        "昭昭南山景，独与心相如。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 266202,
      "title": "蓝溪元居士草堂",
      "content": [
        "市井不容义，义归山谷中。",
        "夫君宅松桂，招我栖蒙笼。",
        "人朴情虑肃，境闲视听空。",
        "清溪宛转水，修竹徘徊风。",
        "木倦采樵子，土劳稼穑翁。",
        "读书业虽异，敦本志亦同。",
        "蓝岸青漠漠，蓝峰碧崇崇。",
        "日昏各命酒，寒蛩鸣蕙丛。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 266203,
      "title": "新卜清罗幽居恭奉献陆大夫",
      "content": [
        "黔娄住何处，仁邑无馁寒。",
        "岂悟旧羇旅，变为新闲安。",
        "二顷有余食，三农行可观。",
        "笼禽得高巢，辙鲋还层澜。",
        "翳翳桑柘墟，纷纷田里欢。",
        "兵戈忽消散，耦耕非艰难。",
        "嘉木偶良酌，芳阴庇清弹。",
        "力农唯一事，趣世徒万端。",
        "静觉本相厚，动为末所残。",
        "此外有余暇，锄荒出幽兰。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 266204,
      "title": "题韦少保静恭宅藏书洞",
      "content": [
        "高意合天制，自然状无穷。",
        "仙华凝四时，玉藓生数峰。",
        "书秘漆文字，匣藏金蛟龙。",
        "闲为气候肃，开作云雨浓。",
        "洞隐谅非久，岩梦诚必通。",
        "将缀文士集，贯就真珠丛。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 266205,
      "title": "生生亭",
      "content": [
        "滩闹不妨语，跨溪仍置亭。",
        "置亭嵽嵲头，开窗纳遥青。",
        "遥青新画出，三十六扇屏。",
        "褭褭立平地，棱棱浮高冥。",
        "一日数开扉，仙闪目不停。",
        "徒夸远方岫，曷若中峰灵。",
        "拔意千余丈，浩言永堪铭。",
        "浩言无媿同，媿同忍丑醒。",
        "致之未有力，力在君子听。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 266206,
      "title": "寒溪 一",
      "content": [
        "霜洗水色尽，寒溪见纤鳞。",
        "幸临虚空镜，照此残悴身。",
        "潜滑不自隐，露底莹更新。",
        "豁如君子怀，曾是危陷人。",
        "始明浅俗心，夜结朝已津。",
        "净漱一掬碧，远消千虑尘。",
        "始知泥步泉，莫与山源隣。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 266207,
      "title": "寒溪 二",
      "content": [
        "洛阳岸边道，孟氏庄前溪。",
        "舟行素冰折，声作青瑶嘶。",
        "绿水结绿玉，白波生白珪。",
        "明明宝镜中，物物天照齐。",
        "仄步下危曲，攀枯闻孀啼。",
        "霜芬稍消歇，凝景微茫齐。",
        "痴坐直视听，戆行失踪蹊。",
        "岸童𣃁棘劳，语言多悲凄。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 266208,
      "title": "寒溪 三",
      "content": [
        "晓饮一杯酒，踏雪过清溪。",
        "波澜冻为刀，剸割凫与鹥。",
        "宿羽皆翦弃，血声沉沙泥。",
        "独立欲何语，默念心酸嘶。",
        "冻血莫作春，作春生不齐。",
        "冻血莫作花，作花发孀啼。",
        "幽幽棘针村，冻死难耕犂。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 266209,
      "title": "寒溪 四",
      "content": [
        "篙工磓玉星，一路随迸萤。",
        "朔冻哀彻底，獠馋咏潜鯹。",
        "冰齿相磨啮，风音酸铎铃。",
        "清悲不可逃，洗出纤悉听。",
        "碧潋卷已尽，彩缕飞飘零。",
        "下蹑滑不定，上栖折难停。",
        "哮嘐呷喢冤，仰诉何时宁。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 266210,
      "title": "寒溪 五",
      "content": [
        "一曲一直水，白龙何鳞鳞。",
        "冻飙杂碎号，韲音坑谷辛。",
        "柧椾吃无力，飞走更相仁。",
        "猛弓一折弦，余喘争来宾。",
        "大严此之立，小杀不复陈。",
        "皎皎何皎皎，氤氲复氤氲。",
        "瑞晴刷日月，高碧开星辰。",
        "独立两脚雪，孤吟千虑新。",
        "天欃徒昭昭，箕舌虚龂龂。",
        "尧圣不听汝，孔微亦有臣。",
        "谏书竟成章，古义终难陈。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 266211,
      "title": "寒溪 六",
      "content": [
        "因冻死得食，杀风仍不休。",
        "以兵为仁义，仁义生刀头。",
        "刀头仁义腥，君子不可求。",
        "波澜抽劒冰，相劈如仇讐。",
        "尖雪入鱼心，鱼心明愀愀。",
        "怳如罔两说，似诉割切由。",
        "谁使异方气，入此中土流。",
        "翦尽一月春，闭为百谷幽。",
        "仰怀新霁光，下照疑忧愁。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 266212,
      "title": "寒溪 七",
      "content": [
        "溪老哭甚寒，涕泗冰珊珊。",
        "飞死走死形，雪裂纷心肝。",
        "劒刃冻不割，弓弦彊难弹。",
        "常闻君子武，不食天杀残。",
        "𣃁玉掩骼胔，吊琼哀阑干。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 266213,
      "title": "寒溪 八",
      "content": [
        "溪风摆余冻，溪景衔明春。",
        "玉消花滴滴，虬解光鳞鳞。",
        "悬步下清曲，消期濯芳津。",
        "千里冰裂处，一勺暖亦仁。",
        "凝精互相洗，漪涟竞将新。",
        "忽如劒疮尽，初起百战身。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 266214,
      "title": "立德新居 一",
      "content": [
        "立德何亭亭，西南耸高隅。",
        "阳崖泄春意，井圃留冬芜。",
        "胜引即纡道，幽行岂通衢。",
        "碧峰远相揖，清思谁言孤。",
        "寺秩虽贵家，浊醪良可哺。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 266215,
      "title": "立德新居 二",
      "content": [
        "耸城架霄汉，洁宅涵絪缊。",
        "开门洛北岸，时锁嵩阳云。",
        "夜高星辰大，昼长天地分。",
        "厚韵属疎语，薄名谢嚣闻。",
        "兹焉有殊隔，永矣难及群。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 266216,
      "title": "立德新居 三",
      "content": [
        "宾秩已觉厚，私储常恐多。",
        "清贫聊自尔，素责将如何。",
        "俭教先勉力，修襟无余佗。",
        "良栖一枝木，灵巢片叶荷。",
        "仰笑鹍鹏辈，委身拂天波。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 266217,
      "title": "立德新居 四",
      "content": [
        "疎门不掩水，洛色寒更高。",
        "晓碧流视听，夕清濯衣袍。",
        "为于仁义得，未觉登陟劳。",
        "远岸雪难莫，劲枝风易号。",
        "霜禽各啸侣，吾亦爱吾曹。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 266218,
      "title": "立德新居 五",
      "content": [
        "崎岖有悬步，委曲饶荒寻。",
        "远树足良木，疎巢无争禽。",
        "素魄衔夕岸，绿水生晓浔。",
        "空旷伊洛视，髣髴潇湘心。",
        "何必尚远异，忧劳满行襟。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 266219,
      "title": "立德新居 六",
      "content": [
        "悬途多仄足，崎圃无修畦。",
        "芳兰与宿艾，手撷心不迷。",
        "品子懒读书，辕驹难服犂。",
        "虚食日相投，夸肠讵能低。",
        "耻从新学游，愿将古农齐。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 266220,
      "title": "立德新居 七",
      "content": [
        "都城多耸秀，爱此高县居。",
        "伊雒遶街巷，鸳鸯飞阎闾。",
        "翠景何的砾，霜飔飘空虚。",
        "突出万家表，独治二亩蔬。",
        "一旬一手版，十日九手锄。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 266221,
      "title": "立德新居 八",
      "content": [
        "手锄手自勗，激劝亦已饶。",
        "畏彼棃栗儿，空资玩弄骄。",
        "夜景卧难尽，昼光坐易消。",
        "治旧得新义，耕荒生嘉苗。",
        "锄治苟惬适，心形俱逍遥。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 266222,
      "title": "立德新居 九",
      "content": [
        "玉蹄裂鸣水，金绶忽照门。",
        "拂拭贫士席，拜候丞相辕。",
        "德疎未为高，礼至方觉尊。",
        "岂唯耀兹日，可以荣远孙。",
        "如何一阳朝，独荷众瑞繁。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 266223,
      "title": "立德新居 十",
      "content": [
        "东南富水木，寂寥蔽光辉。",
        "此地足文字，及时隘骖騑。",
        "仄雪踏为平，涩行变如飞。",
        "令畦生气色，嘉绿新霏微。",
        "天意资厚养，贤人肯相违。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 266224,
      "title": "西上经灵宝观",
      "content": [
        "道士无白发，语音灵泉清。",
        "青松多寿色，白石恒夜明。",
        "放步霁霞起，振衣华风生。",
        "真文秘中顶，宝气浮四楹。",
        "一片古关路，万里今人行。",
        "上仙不可见，驱策徒西征。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 266225,
      "title": "泛黄河",
      "content": [
        "谁开昆仑源，流出混沌河。",
        "积雨飞作风，惊龙喷为波。",
        "湘瑟飕飗弦，越宾呜咽歌。",
        "有恨不可洗，虚此来经过。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 266226,
      "title": "往河阳宿峡陵寄李侍御",
      "content": [
        "莫天寒风悲屑屑，啼鸟遶树泉水噎。",
        "行路解鞍投古陵，苍苍隔山见微月。",
        "鸮鸣犬吠霜烟昏，开囊拂巾对盘飧。",
        "人生穷达感知己，明日投君申片言。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 266227,
      "title": "鵶路溪行呈陆中丞",
      "content": [
        "鵶路不可越，三十六渡溪。",
        "有物饮碧水，高林挂青蜺。",
        "历览道更险，驱使迹频暌。",
        "视听易常主，心魂互相迷。",
        "浪石忽摇动，沙堤信难跻。",
        "危峰紫霄外，古木浮云齐。",
        "出阻望汝郡，大贤多招携。",
        "疲马恋旧秣，羁禽思故栖。",
        "应怜泣楚玉，弃置如尘泥。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 266228,
      "title": "独宿岘首忆长安故人",
      "content": [
        "月迥无隐物，况复大江秋。",
        "江城与沙村，人语风飕飗。",
        "岘亭当此时，故人不同游。",
        "故人在长安，亦可将梦求。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267231,
      "title": "自商行谒复州卢使君虔",
      "content": [
        "一身遶千山，远作行路人。",
        "未遂东吴归，暂出西京尘。",
        "仲宣荆州客，今余竟陵宾。",
        "往迹虽不同，托意皆有因。",
        "商岭莓苔滑，石坂上下频。",
        "江汉沙泥洁，永日光景新。",
        "独泪起残夜，孤吟望初晨。",
        "驱驰竟何事，章句依深仁。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267232,
      "title": "梦泽中行",
      "content": [
        "楚山争蔽亏，日月无全辉。",
        "楚路饶回惑，旅人有迷归。",
        "骐骥思北首，鹧鸪愿南飞。",
        "我怀京洛游，未厌风尘衣。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267233,
      "title": "京山行",
      "content": [
        "众䖟聚病马，流血不得行。",
        "后路起夜色，前山闻虎声。",
        "此时游子心，百尺风中旌。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267234,
      "title": "旅次湘沅有怀灵均",
      "content": [
        "分拙多感激，久游遵长途。",
        "经过湘水源，怀古方踟蹰。",
        "旧称楚灵均，此处殒忠躯。",
        "侧聆故老言，遂得旌贤愚。",
        "名参君子场，行为小人儒。",
        "骚文衒贞亮，体物情崎岖。",
        "三黜有愠色，即非贤哲模。",
        "五十爵高秩，谬膺从大夫。",
        "胸襟积忧愁，容鬓复雕枯。",
        "死为不吊鬼，生作猜谤徒。",
        "吟泽洁其身，忠节宁见输。",
        "怀沙灭其性，孝行焉能俱。",
        "且闻善称君，一何善自殊。",
        "且闻过称己，一何过不渝。",
        "悠哉风土人，角黍投川隅。",
        "相传历千祀，哀悼延八区。",
        "如今圣明朝，养育无羁孤。",
        "君臣逸雍熙，德化盈纷敷。",
        "巾车徇前侣，白日犹昆吾。",
        "寄君臣子心，戒此真良图。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267235,
      "title": "过彭泽",
      "content": [
        "扬帆过彭泽，舟人讶叹息。",
        "不见种柳人，霜风空寂历。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 267236,
      "title": "过分水岭",
      "content": [
        "山壮马力短，马行石齿中。",
        "十步九举辔，回环失西东。",
        "溪水变为雨，悬崖阴蒙蒙。",
        "客衣飘飖秋，葛花零落风。",
        "白日舍我没，征途忽然穷。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267237,
      "title": "分水岭别夜示从弟寂",
      "content": [
        "南中少平地，山水重叠生。",
        "别泉万余曲，迷舟独难行。",
        "四际乱峰合，一眺千虑幷。",
        "潺湲冬夏冷，光彩昼夜明。",
        "赏心难久胜，离肠忽自惊。",
        "古木摇霁色，高风动秋声。",
        "饮尔一樽酒，慰我百忧轻。",
        "嘉期何处定，此晨堪寄情。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267238,
      "title": "连州吟 一",
      "content": [
        "春风朝夕起，吹绿日日深。",
        "试为连州吟，泪下不可禁。",
        "连山何连连，连天碧岑岑。",
        "哀猿哭花死，子规裂客心。",
        "兰芷结新佩，潇湘遗旧音。",
        "怨声能翦弦，坐抚零落琴。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267239,
      "title": "连州吟 二",
      "content": [
        "羽翼不自有，相追力难任。",
        "唯凭方寸灵，独夜万里寻。",
        "方寻魂飘飖，南梦山岖嵚。",
        "髣髴惊魍魉，悉窣闻枫林。",
        "正直被放者，鬼魅无所侵。",
        "贤人多安排，俗士多虚钦。",
        "孤怀吐明月，众毁铄黄金。",
        "愿君保玄曜，壮志无自沉。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267240,
      "title": "连州吟 三",
      "content": [
        "朝亦连州吟，暮亦连州吟。",
        "连州果有信，一纸万里心。",
        "开缄白云断，明月堕衣襟。",
        "南风嘶舜琯，苦竹动猿音。",
        "万里愁一色，潇湘雨淫淫。",
        "两劒忽相触，双蛟恣浮沈。",
        "鬬水正回斡，倒流安可禁。",
        "空愁江海信，惊浪隔相寻。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267241,
      "title": "旅行",
      "content": [
        "楚水结冰薄，楚云为雨微。",
        "野梅参差发，旅榜逍遥归。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 267242,
      "title": "上河阳李大夫",
      "content": [
        "上将秉神略，至兵无猛威。",
        "三军当严冬，一抚胜重衣。",
        "霜劒夺众景，夜星失长辉。",
        "苍鹰独立时，恶鸟不敢飞。",
        "武牢锁天关，河桥纽地机。",
        "大将奚以安，守此称者稀。",
        "贫士少颜色，贵门多轻肥。",
        "试登山岳高，方见草木微。",
        "山岳恩既广，草木心皆归。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267243,
      "title": "投赠张端公",
      "content": [
        "君子量不极，胸吞百川流。",
        "嫉邪霜气直，问俗春辞柔。",
        "日户昼辉静，月杯夜景幽。",
        "咏惊芙蓉发，笑激风飙秋。",
        "鸾步独无侣，鹤音仍寡俦。",
        "幸霑分寸顾，散此千万忧。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267244,
      "title": "赠苏州韦郎中使君",
      "content": [
        "谢客吟一声，霜落群听清。",
        "文含元气柔，鼓动万物轻。",
        "嘉木依性植，曲枝亦不生。",
        "尘埃徐庾词，金玉曹刘名。",
        "章句作雅正，江山益鲜明。",
        "萍苹一浪草，菰蒲片池荣。",
        "曾是康乐咏，如今搴其英。",
        "顾惟菲薄质，亦愿将此幷。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267245,
      "title": "上张徐州",
      "content": [
        "为水不入海，安得浮天波。",
        "为木不在山，安得横日柯。",
        "再来君子傍，始觉精义多。",
        "大德唯一施，众情自偏颇。",
        "至乐无宫征，至声遗讴謌。",
        "愿鼓空桑弦，永使万物和。",
        "顾己诚拙讷，干名已蹉跎。",
        "献词惟在口，所欲无余佗。",
        "乍作支泉石，乍作翳松萝。",
        "一不改方圆，破质为琢磨。",
        "贱子本如此，大贤心若何。",
        "岂是无异途，异途难经过。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267246,
      "title": "上包祭酒",
      "content": [
        "岳岳冠盖彦，英英文字雄。",
        "琼音独听时，尘韵固不同。",
        "春云生纸上，秋涛起胸中。",
        "时吟五君咏，再举七子风。",
        "何幸松桂侣，见知勤苦功。",
        "愿将黄鹤翅，一借飞云空。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267247,
      "title": "赠别崔纯亮",
      "content": [
        "食荠肠亦苦，强歌声无欢。",
        "出门即有碍，谁谓天地宽。",
        "有碍非遐方，长安大道傍。",
        "小人智虑险，平地生太行。",
        "镜破不改光，兰死不改香。",
        "始知君子心，交久道益彰。",
        "君心与我怀，离别俱回遑。",
        "譬如浸蘖泉，流苦已日长。",
        "忍泣目易衰，忍忧形易伤。",
        "项籍岂不壮，贾生岂不良。",
        "当其失意时，涕泗各沾裳。",
        "古人劝加餐，此餐难自强。",
        "一饭九祝噎，一嗟十断肠。",
        "况是儿女怨，怨气凌彼苍。",
        "彼苍若有知，白日下清霜。",
        "今朝始惊叹，碧落空茫茫。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267248,
      "title": "赠文应上人",
      "content": [
        "栖迟青山巅，高静身所便。",
        "不践有命草，但饮无声泉。",
        "斋性空转寂，学情深更专。",
        "经文开贝叶，衣制垂秋莲。",
        "厌此俗人群，暂来还却旋。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    }
  ],
