{
  "data": [
    {
      "id": 346443,
      "title": "和赵端公九日登石亭上和州家兄",
      "content": [
        "洛浦想江津，悲欢共此辰。",
        "采花湖岸菊，望国旧楼人。",
        "雁别声偏苦，松寒色转新。",
        "传书问渔叟，借寇尔何因。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 346444,
      "title": "酬赵少尹戏示诸侄元阳等因以见赠",
      "content": [
        "八龙三虎俨成行，琼树花开鹤翼张。",
        "且请同观舞鸲鹆，",
        "谬入阮家逢庆乐，竹林因得奉壶觞。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 346445,
      "title": "奉和户曹叔夏夜寓直寄呈同曹诸公并见示",
      "content": [
        "敛板捧清词，恭闻侍直时。",
        "暮尘归众骑，邃宇舍诸司。",
        "华月先灯至，清风与簟随。",
        "乱萤光熠熠，行树影离离。",
        "龙卧人宁识，鹏抟鷃岂知。",
        "便因当五夜，敢望竹林期。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 346447,
      "title": "和太常李主簿秋中山下别墅即事",
      "content": [
        "清秋来几时，宋玉已先知。",
        "旷朗霞映竹，澄明山满池。",
        "葺桥双鹤赴，收果众猿随。",
        "韶乐方今奏，云林徒蔽亏。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 346448,
      "title": "酬韦渚秋夜有怀见寄",
      "content": [
        "萧条良夜永，秋草对衰颜。",
        "露下鸟初定，月明人自闲。",
        "独悲无旧业，共喜出时艰。",
        "为问功成后，同游何处山。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 346449,
      "title": "同吉中孚梦桃源",
      "content": [
        "春雨夜不散，梦中山亦阴。",
        "云中碧潭水，路暗红花林。",
        "花水自深浅，无人知古今。",
        "夜静春梦长，梦逐仙山客。",
        "园林满芝术，鸡犬傍篱栅。",
        "几处花下人，看予笑头白。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 346450,
      "title": "同柳侍郎题侯钊侍郎新昌里",
      "content": [
        "清源君子居，左右尽图书。",
        "三径春自足，一瓢欢有余。",
        "庭莎成野席，阑药是家蔬。",
        "幽显岂殊迹，昔贤徒病诸。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 346451,
      "title": "酬孙侍御春日见寄",
      "content": [
        "经过里巷春，同是谢家邻。",
        "顾我觉衰早，荷君留醉频。",
        "松高犹覆草，鹤起暂萦尘。",
        "始悟达人志，患名非患贫。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 346452,
      "title": "和王员外冬夜寓直",
      "content": [
        "高步长裾锦帐郎，居然自是汉贤良。",
        "潘岳叙年因鬓发，",
        "坐见重门俨朝骑，可怜云路独翱翔。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 346453,
      "title": "酬金部王郎中省中春日见寄",
      "content": [
        "南宫树色晓森森，虽有春光未有阴。",
        "鹤侣正疑芳景引，",
        "更有阮郎迷路处，万株红树一溪深。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 346455,
      "title": "和李中丞酬万年房署少府过汾州景云观因以寄上房与李早年同居此观",
      "content": [
        "显晦澹无迹，贤哉常晏如。",
        "如何警孤鹤，忽乃传双鱼。",
        "叙以泉石旧，怅然风景余。",
        "低回青油幕，梦寐白云居。",
        "玉洞桂香满，雪坛松影疏。",
        "沈思瞩仙侣，纾组正军书。",
        "积学早成道，感恩难遂初。",
        "梅生谅多感，归止岂吾庐。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 346456,
      "title": "酬陈翃郎中冬至携柳郎窦郎归河中旧居见寄",
      "content": [
        "三旬一休沐，清景满林庐。",
        "南郭群儒从，东床两客居。",
        "烧烟浮雪野，麦陇润冰渠。",
        "班白皆持酒，蓬茅尽有书。",
        "终期买寒渚，同此利蒲鱼。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 346457,
      "title": "酬李益端公夜宴见赠",
      "content": [
        "戚戚一西东，十年今始同。",
        "可怜歌酒夜，相对两衰翁。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 346458,
      "title": "和陈翃郎中拜本府少尹兼侍御史献上侍中因呈同院诸公",
      "content": [
        "金印垂鞍白马肥，不同疏广老方归。",
        "三千士里文章伯，",
        "乡中贺者唯争路，不识传呼獬豸威。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 346459,
      "title": "和王仓少尹暇日言怀",
      "content": [
        "清秋多暇日，况乃是夫君。",
        "习静通仙事，书空阅篆文。",
        "剑飞终上汉，鹤梦不离云。",
        "无限烟霄路，何嗟迹未分。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 346460,
      "title": "和崔侍郎游万固寺",
      "content": [
        "闻说中方高树林，曙华先照啭春禽。",
        "风云才子冶游思，",
        "贺君此去君方至，河水东流西日沉。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 346461,
      "title": "和裴延龄尚书寄题果州谢舍人仙居",
      "content": [
        "飘然去谒八仙翁，自地从天香满空。",
        "紫盖迥标双鹤上，",
        "歌此因思捧金液，露盘长庆汉皇宫。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 346462,
      "title": "酬崔侍御早秋卧病书情见寄时君亦抱疾在假中",
      "content": [
        "掷地金声信有之，莹然冰玉见清词。",
        "元凯癖成官始贵，",
        "寂寞罢琴风满树，几多黄叶落蛛丝。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 346463,
      "title": "酬灵澈上人",
      "content": [
        "军人奉役本无期，落叶花开总不知。",
        "走马城中头雪白，若为将面见汤师。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 346464,
      "title": "敬酬大府二十四舅览诗卷因以见示",
      "content": [
        "郤公怜戆亦怜愚，忽赐金盘径寸珠。",
        "彻底碧潭滋涸溜。",
        "压枝红艳照枯株。",
        "九门洞启延高论，百辟联行挹大儒。",
        "顾己文章非酷似，敢将幽劣俟洪炉。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 346465,
      "title": "雨中酬友人",
      "content": [
        "看山独行归竹院，水绕前阶草生遍。",
        "空林细雨暗无声，唯有愁心两相见。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 346466,
      "title": "酬人失题",
      "content": [
        "孤鸾将鹤群，晴日丽春云。",
        "何幸晚飞者，清音长此闻。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 346467,
      "title": "哭司农苗主簿",
      "content": [
        "原头殡御绕新茔，原下行人望哭声。",
        "更想秋山连古木，唯应石上见君名。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 346468,
      "title": "得耿𣲗司法书因叙长安故友零落兵部苗员外发秘省李校书端相次倾逝潞府崔功曹峒长林司空丞曙俱谪远方余以摇落之时对书增叹因呈河中郑仓曹畅参军昆季",
      "content": [
        "鬓似衰蓬心似灰，惊悲相集老相催。",
        "故友九泉留语别，",
        "幸接野居宜屣步，冀君清夜一申哀。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 346470,
      "title": "纶与吉侍郎中孚司空郎中曙苗员外发崔补阙峒耿拾遗𣲗李校书端风尘追游向三十载数公皆负当时盛称荣耀未几俱沈下泉畅博士当感怀前踪有五十韵见寄辄有所酬以申悲旧兼寄夏侯侍御审侯仓曹钊",
      "content": [
        "禀命孤且贱，少为病所婴。",
        "八岁始读书，四方遂有兵。",
        "童心幸不羁，此去负平生。",
        "是月胡入洛，明年天陨星。",
        "夜行登灞陵，惝恍靡所征。",
        "云海一翻荡，鱼龙俱不宁。",
        "因浮襄江流，远寄鄱阳城。",
        "鄱阳富学徒，诮我戆无营。",
        "谕以诗礼义，勖随宾荐名。",
        "舟车更滞留，水陆互阴晴。",
        "晓望怯云阵，夜愁惊鹤声。",
        "凄凄指宋郊，浩浩入秦京。",
        "沴气既风散，皇威如日明。",
        "方逢粟比金，未识公与卿。",
        "十上不可待，三年竟无成。",
        "偶为达者知，扬我于王廷。",
        "素志且不立，青袍徒见萦。",
        "昏孱夙自保，静躁本殊形。",
        "始趋甘棠阴，旋遇密人迎。",
        "考实绩无取，责能才固轻。",
        "新丰古离宫，宫树锁云扃。",
        "中复莅兹邑，往惟曾所经。",
        "缭垣何逶迤，水殿亦峥嵘。",
        "夜雨滴金砌，阴风吹玉楹。",
        "官曹虽检率，国步日夷平。",
        "命蹇固安分，祸来非有萌。",
        "因逢骇浪飘，几落无辜刑。",
        "巍巍登坛臣，独正天柱倾。",
        "悄悄失途子，分将秋草并。",
        "百年甘守素，一顾乃拾青。",
        "相逢十月交，众卉飘已零。",
        "感旧谅戚戚，问孤恳茕茕。",
        "侍郎文章宗，杰出淮楚灵。",
        "掌赋若吹籁，司言如建瓴。",
        "郎中善余庆，雅韵与琴清。",
        "郁郁松带雪，萧萧鸿入冥。",
        "员外真贵儒，弱冠被华缨。",
        "月香飘桂实，乳溜滴琼英。",
        "补阙思冲融，巾拂艺亦精。",
        "彩蝶戏芳圃，瑞云凝翠屏。",
        "拾遗兴难侔，逸调旷无程。",
        "九酝贮弥洁，三花寒转馨。",
        "校书才智雄，举世一娉婷。",
        "赌墅鬼神变，属词鸾凤惊。",
        "差肩曳长裾，总辔奉和铃。",
        "共赋瑶台雪，同观金谷筝。",
        "倚天方比剑，沈井忽如瓶。",
        "神昧不可问，天高莫尔听。",
        "君持玉盘珠，泻我怀袖盈。",
        "读罢涕交颐，愿言跻百龄。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 346471,
      "title": "酬李叔度秋夜喜相遇因伤关东僚友丧逝见赠",
      "content": [
        "寒月照秋城，秋风泉涧鸣。",
        "过时见兰蕙，独夜感衰荣。",
        "酒散同移疾，心悲似远行。",
        "以愚求作友，何德敢称兄。",
        "谷变波长急，松枯药未成。",
        "恐看新鬓色，怯问故人名。",
        "野泽云阴散，荒原日气生。",
        "羁飞本难定，非是恶弦惊。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 346476,
      "title": "七夕诗",
      "content": [
        "祥光若可求，闺女夜登楼。",
        "月露浩方下，河云凝不流。",
        "铅华潜警曙，机杼暗传秋。",
        "回想敛余眷，人天俱是愁。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 346480,
      "title": "伦开府席上赋得咏美人名解愁",
      "content": [
        "不敢苦相留，明知不自由。",
        "颦眉乍欲语，敛笑又低头。",
        "舞态兼些醉，歌声似带羞。",
        "今朝总见也，只不解人愁。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 346481,
      "title": "王评事驸马花烛诗",
      "content": [
        "万条银烛引天人，十月长安半夜春。",
        "步障三千隘将断，几多珠翠落香尘。",
        "一人女婿万人怜，一夜调疏抵百年。",
        "为报司徒好将息，明珠解转又能圆。",
        "人主人臣是亲家，千秋万岁保荣华。",
        "几时曾向高天上，得见今宵月里花。",
        "比翼和鸣双凤凰，欲栖金帐满城香。",
        "平明却入天泉里，日气曈昽五色光。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 346482,
      "title": "和赵给事白蝇拂歌",
      "content": [
        "华堂多众珍，白拂称殊异。",
        "柄裁沈节香袭人，",
        "皎然素色不因染，淅尔凉风非为秋。",
        "群蝇青苍恣游息，",
        "此时满筵看一举，荻花忽旋杨花舞，砉如寒隼惊暮禽，",
        "若将挥玩闲临水，愿接波中一白鸥。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 346483,
      "title": "萧常侍瘿柏亭歌",
      "content": [
        "柏之异者山中灵，何人断绝为君亭。",
        "云翻浪卷不可识，",
        "金貂主人汉三老，构此穷年下朝早。",
        "心规目制不暂疲，",
        "攒甍斗拱无斤迹，根瘿联悬同素壁。",
        "数层乱泻云里峰，",
        "水精如意刁金色，云母屏风透掩光。",
        "四阶绵绵被纤草，",
        "愚儒敢欲贺成功，鸾凤栖翔固不同。",
        "应念废材今接地，"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 346484,
      "title": "慈恩寺石磬歌",
      "content": [
        "灵山石磬生海西，海涛平处与山齐。",
        "长眉老僧同佛力，",
        "星汉徘徊山有风，禅翁静扣月明中。",
        "群仙下云龙出水，",
        "花宫杳杳响泠泠，无数沙门昏梦醒。",
        "古廊灯下见行道，",
        "岂如全质挂青松，数叶残云一片峰。",
        "吾师宝之寿中国，"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 346485,
      "title": "送张郎中还蜀歌",
      "content": [
        "秦家御史汉家郎，亲专两印征殊方。",
        "功成走马朝天子，",
        "泸南五将望君还，愿以天书示百蛮。",
        "曲栈重江初过雨，",
        "塞口云生火候迟，烟中鹤唳军行早。",
        "黄花川下水交横，",
        "回首岷峨半天黑，传觞接膝何由得。",
        "空令豪士仰威名，",
        "须臾醉起箫笳发，空见红旌入白云。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 346486,
      "title": "宴席赋得姚美人拍筝歌",
      "content": [
        "出帘仍有钿筝随，见罢翻令恨识迟。",
        "微收皓腕缠红袖，",
        "凤箫韶管寂不喧，绣幕纱窗俨秋月。",
        "有时轻弄和郎歌，"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 346487,
      "title": "陈翃郎中北亭送侯钊侍御赋得带冰流歌",
      "content": [
        "溪中鸟鸣春景旦，一派寒冰忽开散。",
        "璧方镜员流不断，",
        "持此赠君君饮之，圣君识君冰玉姿。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 346488,
      "title": "栖岩寺隋文帝马脑盏歌",
      "content": [
        "天宫宝器隋朝物，锁在金函比金骨。",
        "开函捧之光乃发，",
        "规形环影相透彻，乱雪繁花千万重。",
        "可怜贞质无今古，",
        "一留寒殿殿将坏，唯有幽光通隙尘。",
        "山中老僧眉似雪，"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 346489,
      "title": "难绾刀子歌",
      "content": [
        "黄金鞘里青芦叶，丽若剪成铦且翣。",
        "轻冰薄玉状不分，",
        "淬之几堕前池水，焉知不是蛟龙子。",
        "割鸡刺虎皆若空，"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 346490,
      "title": "腊日观咸宁王部曲娑勒擒豹歌",
      "content": [
        "山头曈曈日将出，山下猎围照初日。",
        "前林有兽未识名，",
        "阴方质子才三十，译语受词蕃语揖。",
        "舍鞍解甲疾如风，",
        "既苏复吼拗仍怒，果协英谋生致之。",
        "拖自深丛目如电，",
        "始知缚虎如缚鼠，败虏降羌生眼前。",
        "祝尔嘉词尔无苦，",
        "非熊之兆庆无极，愿纪雄名传百蛮。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 346491,
      "title": "赋得白鸥歌送李伯康归使",
      "content": [
        "积水深源，白鸥翻翻。",
        "倒影光素，于潭之间。",
        "衔鱼鱼落乱惊鸣，争扑莲丛莲叶倾。",
        "尔不见波中鸥鸟闲无营，何必汲汲劳其生。",
        "柳花冥蒙大堤口，悠扬相和乍无有。",
        "轻随去浪杳不分，",
        "今日还同看鸥鸟，如何羽翮复参差。",
        "复参差，"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 346492,
      "title": "皇帝感词",
      "content": [
        "提剑风雷动，垂衣日月明。",
        "禁花呈瑞色，国老见星精。",
        "发棹鱼先跃，窥巢鸟不惊。",
        "山呼一万岁，直入九重城。",
        "天香五凤彩，御马六龙文。",
        "雨露清驰道，风雷翊上军。",
        "高旍花外转，行漏乐前闻。",
        "时见金鞭举，空中指瑞云。",
        "妙算干戈止，神谋宇宙清。",
        "两阶文物盛，七德武功成。",
        "校猎长杨苑，屯军细柳营。",
        "归来献明主，歌舞溢春城。",
        "天乐下天中，云輧俨在空。",
        "铅黄艳河汉，笑语合笙镛。",
        "已见长随凤，仍闻不避熊。",
        "君王亲试舞，阊阖静无风。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 346493,
      "title": "天长久词",
      "content": [
        "玉砌红花树，香风不敢吹。",
        "春光解天意，偏发殿南枝。",
        "虹桥千步廊，半在水中央。",
        "天子方清暑，宫娃起夜妆。",
        "辞辇复当熊，倾心奉六宫。",
        "君王若看貌，甘在众妃中。",
        "云日呈祥礼物殊，彤庭生献五单于。",
        "塞垣万里无飞鸟，可是边城用郅都。",
        "台殿云深秋色微，君王初赐六宫衣。",
        "楼船泛罢归犹早，行遣才人斗射飞。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 346494,
      "title": "和张仆射塞下曲",
      "content": [
        "鹫翎金仆姑，燕尾绣蝥弧。",
        "独立扬新令，千营共一呼。",
        "林暗草惊风，将军夜引弓。",
        "平明寻白羽，没在石棱中。",
        "月黑雁飞高，单于夜遁逃。",
        "欲将轻骑逐，大雪满弓刀。",
        "野幕敞琼筵，羌戎贺劳旋。",
        "醉和金甲舞，雷鼓动山川。",
        "调箭又呼鹰，俱闻出世能。",
        "奔狐将迸雉，扫尽古丘陵。",
        "亭亭七叶贵，荡荡一隅清。",
        "他日题麟阁，唯应独不名。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 346495,
      "title": "古艳诗",
      "content": [
        "残妆色浅髻鬟开，笑映朱帘觑客来。",
        "推醉唯知弄花钿，潘郎不敢使人催。",
        "自拈裙带结同心，暖处偏知香气深。",
        "爱捉狂夫问闲事，不知歌舞用黄金。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 346496,
      "title": "孤松吟酬浑赞善",
      "content": [
        "深山荒松枝，雪压半离披。",
        "朱门青松树，万叶承清露。",
        "露重色逾鲜，吟风似远泉。",
        "天寒香自发，日丽影常圆。",
        "阴郊一夜雪，榆柳皆枯折。",
        "回首望君家，翠盖满琼花。",
        "捧君青松曲，自顾同衰木。",
        "曲罢不相亲，深山头白人。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 346497,
      "title": "从军行",
      "content": [
        "二十在边城，军中得勇名。",
        "卷旗收败马，占碛拥残兵。",
        "覆阵乌鸢起，烧山草木明。",
        "塞闲思远猎，师老厌分营。",
        "雪岭无人迹，冰河足雁声。",
        "李陵甘此没，惆怅汉公卿。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 346499,
      "title": "送朝长史赴荆南旧幕",
      "content": [
        "元瑜思旧幕，几夜梦旌旃。",
        "暑退蒹葭雨，秋生鼓角天。",
        "月明三峡路，浪里九江船。",
        "□□□□□，□□□□□。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 346500,
      "title": "送渭南崔少府归徐郎中幕",
      "content": [
        "叶下山边路，行人见自悲。",
        "夜寒逢雪处，日暖到村时。",
        "语少心长苦，愁深醉自迟。",
        "□□□□□，羡有幕中期。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 346501,
      "title": "寄郑七纲",
      "content": [
        "小来落托复迍邅，一辱君知二十年，舍去形骸容傲慢，",
        "他日吴公如记问，愿将黄绶比青毡。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 346502,
      "title": "逢南中使因寄岭外故人",
      "content": [
        "见说南来处，苍梧接桂林。",
        "过秋天更暖，边海日长阴。",
        "巴路缘云出，蛮乡入洞深。",
        "信回人自老，梦到月应沉。",
        "碧水通春色，青山寄远心。",
        "炎方难久客，为尔一沾襟。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 346503,
      "title": "代员将军罢战后归旧里赠朔北故人",
      "content": [
        "结发事疆场，全生俱到乡。",
        "连云防铁岭，同日破渔阳。",
        "牧马胡天晚，移军碛路长。",
        "枕戈眠古戍，吹角立繁霜。",
        "归老勋仍在，酬恩虏未亡。",
        "独行过邑里，多病对农桑。",
        "雄剑依尘橐，阴符寄药囊。",
        "空余麾下将，犹逐羽林郎。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 346505,
      "title": "早春归盩厔旧居却寄耿拾遗𣲗李校书端",
      "content": [
        "野日初晴麦垄分，竹园相接鹿成群。",
        "几家废井生青草，",
        "可怜荒岁青山下，惟有松枝好寄君。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 346509,
      "title": "客舍苦雨即事寄钱起郎士元二员外",
      "content": [
        "积雨暮凄凄，羁人状鸟栖。",
        "响空宫树接，覆水野云低。",
        "穴蚁多随草，巢蜂半坠泥。",
        "绕池墙藓合，拥溜瓦松齐。",
        "旧圃平如海，新沟曲似溪。",
        "坏阑留众蝶，欹栋止群鸡。",
        "莠盛终无实，槎枯返有荑。",
        "绿萍藏废井，黄叶隐危堤。",
        "闾里欢将绝，朝昏望亦迷。",
        "不知霄汉侣，何路可相携。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 346510,
      "title": "郊居对雨寄赵涓给事包佶郎中",
      "content": [
        "暑雨青山里，随风到野居。",
        "乱沤浮曲砌，悬溜响前除。",
        "尘镜愁多掩，蓬头懒更梳。",
        "夜窗凄枕席，阴壁润图书。",
        "萧飒宜新竹，龙钟拾野蔬。",
        "石泉空自咽，药圃不堪锄。",
        "浊水淙深辙，荒兰拥败渠。",
        "繁枝留宿鸟，碎浪出寒鱼。",
        "桑屐时登望，荷衣自卷舒。",
        "应怜在泥滓，无路托高车。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 346514,
      "title": "卧病寓居龙兴观枉冯十七著作书知罢摄洛阳赴缑氏因题十四韵寄冯生并赠乔尊师",
      "content": [
        "乞假依山宅，蹉跎属岁周。",
        "弱荑轻采拾，钝质称归休。",
        "潘岳衰将至，刘桢病未瘳。",
        "步迟乘羽客，起晏滞书邮。",
        "幸以编方验，终贻骨肉忧。",
        "灼龟炉气冷，曝药树阴稠。",
        "语命心堪醉，伤离梦亦愁。",
        "荤膻居已绝，鸾鹤见无由。",
        "世累如尘积，年光剧水流。",
        "蹑云知有路，济海岂无舟。",
        "倚玉翻成难，投砖敢望酬。",
        "卑栖君就禄，羸惫我逢秋。",
        "腐叶填荒辙，阴萤出古沟。",
        "依然在遐想，愿子励风猷。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 346516,
      "title": "洛阳早春忆吉中孚校书、司空曙主簿因寄清江上人",
      "content": [
        "值迥逢高驻马频，雪晴闲看洛阳春。",
        "莺声报远同芳信，",
        "年来百事皆无绪，唯与汤师结净因。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 346517,
      "title": "偶逢姚校书凭附书达河南郤推官因以戏赠",
      "content": [
        "寄书常切到常迟，今日凭君君莫辞。",
        "若问玉人殊易识，莲花府里最清羸。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 346518,
      "title": "夜中得循州赵司马侍郎书因寄回使",
      "content": [
        "瘴海寄双鱼，中宵达我居。",
        "两行灯下泪，一纸岭南书。",
        "地说炎蒸极，人称老病余。",
        "殷勤报贾傅，莫共酒杯疏。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 346519,
      "title": "晚次新丰北野老家书事呈赠韩质明府",
      "content": [
        "机鸣舂响日暾暾，鸡犬相和汉古村。",
        "数派清泉黄菊盛，",
        "共说年来但无事，不知何者是君恩。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 346520,
      "title": "书情上大尹十兄",
      "content": [
        "紫陌绝纤埃，油幢千骑来。",
        "剖辞纷若雨，奔吏殷成雷。",
        "圣泽初忧壅，群心本在台。",
        "海鳞方泼剌，云翼暂徘徊。",
        "芳室芝兰茂，春蹊桃李开。",
        "江湖余派少，鸿雁远声哀。",
        "命厌蓍龟诱，年惊弟侄催。",
        "磨铅惭砥砺，挥策愧驽骀。",
        "玉管能喧谷，金炉可变灰。",
        "应怜费思者，衔泪亦衔枚。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 346523,
      "title": "太白西峰偶宿车祝二尊师石室晨登前𪩘凭眺书怀即事寄呈凤翔齐员外张侍御",
      "content": [
        "弱龄诚昧鄙，遇胜惟求止。",
        "如何羁滞中，得步青冥里。",
        "青冥有桂丛，冰雪两仙翁。",
        "毛节未归海，丹梯闲倚空。",
        "逍遥拟上清，洞府不知名。",
        "醮罢雨雷至，客辞山忽明。",
        "山明鸟声乐，日气生岩壑。",
        "岩壑树修修，白云如水流。",
        "白云消散尽，陇塞俨然秋。",
        "积阻关河固，绵联烽戍稠。",
        "五营承庙略，四野失边愁。",
        "吁嗟系尘役，又负灵仙迹。",
        "芝术自芳香，泥沙几沉溺。",
        "书此欲沾衣，平生事每违。",
        "烟霄不可仰，鸾鹤自追随。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 346524,
      "title": "赠韩山人",
      "content": [
        "见君何事不惭颜，白发生来未到山。",
        "更叹无家又无药，往来唯在酒徒间。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 346526,
      "title": "春日书情赠别司空曙",
      "content": [
        "壮志随年尽，谋身意未安。",
        "风尘交契阔，老大别离难。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 346527,
      "title": "冬晓呈邻里",
      "content": [
        "终夜寝衣冷，开门思曙光。",
        "空阶一丛叶，华室四邻霜。",
        "望阙觉天迥，忆山愁路荒。",
        "途中一留滞，双鬓飒然苍。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 346528,
      "title": "首冬寄河东昭德里书事贻郑损仓曹",
      "content": [
        "清冬和暖天，老钝昼多眠。",
        "日爱闾巷静，每闻官吏贤。",
        "寒菹供家食，腐叶宿厨烟。",
        "且复执杯酒，无烦轻议边。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 346529,
      "title": "浑赞善东斋戏赠陈归",
      "content": [
        "长裾珠履飒轻尘，闲以琴书列上宾。",
        "公子无雠可邀请，侯嬴此坐是何人。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 346530,
      "title": "春日卧病示赵季黄",
      "content": [
        "病中饶泪眼常昏，闻说花开亦闭门。",
        "语少渐知琴思苦，",
        "今日支离顾形影，向君凡在几重恩。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 346531,
      "title": "秋幕中夜独坐迟明因陪陈翃郎中晨谒上公因书即事兼呈同院诸公",
      "content": [
        "风凄露泫然，明月在山巅。",
        "独倚古庭树，仰看深夜天。",
        "叶翻萤不定，虫思草无边。",
        "南舍机杼发，东方云景鲜。",
        "簪裘肃已整，车骑俨将前。",
        "百雉拱双戟，万夫尊一贤。",
        "琳琅多谋蕴，律吕更相宣。",
        "晓桂香浥露，新鸿晴满川。",
        "熙熙造化功，穆穆唐尧年。",
        "顾己草同贱，誓心金匪坚。",
        "蹇辞惭自寡，渴病老难痊。",
        "书此更何问，边韶唯昼眠。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 346533,
      "title": "寄赠畅当山居",
      "content": [
        "古村荒石路，岁晏独言归。",
        "山雪厚三尺，社榆粗十围。",
        "虬龙宁守蛰，鸾鹤岂矜飞。",
        "君子固安分，毋听劳者讥。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 346534,
      "title": "偶宿山中忆畅当",
      "content": [
        "深山夜雪晴，坐忆晓山明。",
        "读易罢三卷，弹琴当五更。",
        "薜萝枯有影，岩壑冻无声。",
        "此夕一相望，君应知我诚。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 346535,
      "title": "秋中野望寄舍弟绶兼令呈上西川尚书舅",
      "content": [
        "忧来思远望，高处殊非惬。",
        "夜露湿苍山，秋陂满黄叶。",
        "人随雁迢递，栈与云重叠。",
        "骨肉暂分离，形神遂疲苶。",
        "红旌渭阳骑，几日劳登涉。",
        "蜀道蔼松筠，巴江盛舟楫。",
        "小生即何限，简诲偏盈箧。",
        "旧恨尚填膺，新悲复萦睫。",
        "因求种瓜利，自喜归耕捷。",
        "井臼赖依邻，儿童亦胜汲。",
        "尘容不在照，雪鬓那堪镊。",
        "唯有餐霞心，知夫与天接。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 346537,
      "title": "玩春因寄冯卫二补阙戏呈李益",
      "content": [
        "掖垣春色自天来，红药当阶次第开。",
        "萱草丛丛尔何物，等闲穿破绿莓苔。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 346539,
      "title": "与张擢对酌",
      "content": [
        "张翁对卢叟，一榼山村酒。",
        "倾酒请予歌，忽蒙张翁呵。",
        "呵予官非屈，曲有怨词多。",
        "歌罢谢张翁，所思殊不同。",
        "予悲方为老，君责一何空。",
        "曾看乐官录，向是悲翁曲。",
        "张老闻此词，汪汪泪盈目。",
        "卢叟醉言粗，一杯凡数呼。",
        "回头顾张老，敢欲戏为儒。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 346540,
      "title": "喜从弟激初至",
      "content": [
        "儒服策羸车，惠然过我庐。",
        "叙年惭已长，称从意何疏。",
        "作吏清无比，为文丽有余。",
        "应嗤受恩者，头白读兵书。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 346542,
      "title": "秋中过独孤郊居",
      "content": [
        "开园过水到郊居，共引家童拾野蔬。",
        "高树夕阳连古巷，",
        "帝里诸亲别来久，岂知王粲爱樵渔。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 346544,
      "title": "春日题杜叟山下别业",
      "content": [
        "白鸟群飞山半晴，渚田相接有泉声。",
        "园中晓露青丛合，",
        "今朝醉舞同君乐，始信幽人不爱荣。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 346545,
      "title": "过终南柳处士",
      "content": [
        "五老正相寻，围棋到煮金。",
        "石摧丹井闭，月过洞门深。",
        "猿鸟三时下，藤萝十里阴。",
        "绿泉多草气，青壁少花林。",
        "自愧非仙侣，何言见道心。",
        "悠哉宿山口，雷雨夜沉沉。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 346550,
      "title": "题杨虢县竹亭",
      "content": [
        "夜宿密公室，话余将昼兴。",
        "绕阶三径雪，当户一池冰。",
        "家训资风化，心源隐政能。",
        "明朝复何见，莱草古沟塍。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 346555,
      "title": "题金吾郭将军石伏茅堂",
      "content": [
        "云戟曙沉沉，轩墀清且深。",
        "家传成栋美，尧宠结茅心。",
        "玉佩多依石，油幢亦在林。",
        "炉香诸洞暖，殿影众山阴。",
        "草奏风生笔，筵开雪满琴。",
        "客从龙阙至，僧自虎溪寻。",
        "萧洒延清赏，风流会素襟。",
        "终朝息尘步，一醉间华簪。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 346556,
      "title": "题贾山人园林",
      "content": [
        "竹影朦胧松影长，素琴清簟好风凉。",
        "连春诗会烟花满，",
        "长沙流谪君非远，莫遣英名负洛阳。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 346558,
      "title": "重同畅当奘公院闻琴",
      "content": [
        "误以音声祈远公，请将徽轸付秋风。",
        "漾漾硖流吹不尽，月华如在白波中。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 346559,
      "title": "同耿𣲗宿陆澧旅舍",
      "content": [
        "当轩云月开，清夜故人杯。",
        "拥褐觉霜下，抱琴闻雁来。",
        "迎风君顾步，临路我迟回。",
        "双鬓共如此，此欢非易陪。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 346562,
      "title": "九日奉陪侍郎登白楼",
      "content": [
        "碧霄孤鹤发清音，上宰因添望阙心。",
        "睥睨三层连步障，",
        "此日所从何所问，俨然冠剑拥成林。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 346563,
      "title": "春日喜雨奉和马侍中宴白楼",
      "content": [
        "鹳鹤相呼绿野宽，鼎臣闲倚玉栏干。",
        "洪河拥沫流仍急，",
        "今朝醉舞共乡老，不觉倾欹獬豸冠。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 346564,
      "title": "奉陪侍中游石笋溪十二韵",
      "content": [
        "朝日照灵山，山溪浩纷错。",
        "图书无旧记，鲧禹应新凿。",
        "双壁泻天河，一峰吐莲萼。",
        "潭心乱雪卷，岩腹繁珠落。",
        "彩蛤攒锦囊，芳萝袅花索。",
        "猿群曝阳岭，龙穴腥阴壑。",
        "静得渔者言，闲闻洞仙博。",
        "欹松倚朱幰，广石屯油幕。",
        "国泰事留侯，山春纵康乐。",
        "间关殊状鸟，烂熳无名药。",
        "欲验少君方，还吟大隐作。",
        "旌幢不可驻，古塞新沙漠。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 346565,
      "title": "九日奉陪侍中宴白楼",
      "content": [
        "露白菊氛氲，西楼盛袭文。",
        "玉筵秋令节，金钺汉元勋。",
        "说剑风生座，抽琴鹤绕云。",
        "𫍲儒无以答，愿得备前军。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 346567,
      "title": "九日奉陪令公登白楼同咏菊",
      "content": [
        "琼尊犹有菊，可以献留侯。",
        "愿比三花秀，非同百卉秋。",
        "金英分蕊细，玉露结房稠。",
        "黄雀知恩在，衔飞亦上楼。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 346568,
      "title": "奉陪浑侍中上巳日泛渭河",
      "content": [
        "青舸锦帆开，浮天接上台。",
        "晚莺和玉笛，春浪动金罍。",
        "舟楫方朝海，鲸鲵自曝腮。",
        "应怜似萍者，空逐榜人回。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 346569,
      "title": "奉陪侍中春日过武安君庙",
      "content": [
        "长裾间貔虎，遗庙盛攀登。",
        "白羽三千骑，红林一万层。",
        "元臣达幽契，祝史告明征。",
        "抚坐悲今古，瞻容感废兴。",
        "回风卷丛柏，骤雨湿诸陵。",
        "倏忽烟花霁，当营看月生。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 346570,
      "title": "过玉真公主影殿",
      "content": [
        "夕照临窗起暗尘，青松绕殿不知春。",
        "君看白发诵经者，半是宫中歌舞人。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 346572,
      "title": "题伯夷庙",
      "content": [
        "中条山下黄礓石，垒作夷齐庙里神。",
        "落叶满阶尘满座，不知浇酒为何人。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 346573,
      "title": "早春游樊川野居却寄李端校书兼呈崔峒补阙司空曙主簿耿𣲗拾遗",
      "content": [
        "白水遍沟塍，青山对杜陵。",
        "晴明人望鹤，旷野鹿随僧。",
        "古柳连巢折，荒堤带草崩。",
        "阴桥全覆雪，瀑溜半垂冰。",
        "斗鼠摇松影，游龟落石层。",
        "韶光偏不待，衰败巧相仍。",
        "桂树曾争折，龙门几共登。",
        "琴师阮校尉，诗和柳吴兴。",
        "舐笔求书扇，张屏看画蝇。",
        "卜邻空遂约，问卦独无征。",
        "投足经危路，收才遇直绳。",
        "守农穷自固，行乐病何能。",
        "掩帙蓬蒿晚，临川景气澄。",
        "飒然成一叟，谁更慕鶱腾。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 346575,
      "title": "曲江春望",
      "content": [
        "菖蒲翻叶柳交枝，暗上莲舟鸟不知。",
        "更到无花最深处，玉楼金殿影参差。",
        "翠黛红妆画鹢中，共惊云色带微风。",
        "箫管曲长吹未尽，花南水北雨蒙蒙。",
        "泉声遍野入芳洲，拥沫吹花草上流。",
        "落日行人渐无路，巢乌乳燕满高楼。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 346576,
      "title": "春日陪李庶子遵善寺东院晓望",
      "content": [
        "映竹水田分，当山起雁群。",
        "阳峰高对寺，阴井下通云。",
        "雪昼唯逢鹤，花时此见君。",
        "由来禅诵地，多有谢公文。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 346577,
      "title": "华清宫",
      "content": [
        "汉家天子好经过，白日青山宫殿多。",
        "见说只今生草处，禁泉荒石已相和。",
        "水气朦胧满画梁，一回开殿满山香。",
        "宫娃几许经歌舞，白首翻令忆建章。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 346580,
      "title": "宴赵氏昆季书院因与会文并率尔投赠",
      "content": [
        "诗礼挹余波，相欢在琢磨。",
        "琴尊方会集，珠玉忽骈罗。",
        "谢族风流盛，于门福庆多。",
        "花攒骐骥枥，锦绚凤凰窠。",
        "咏雪因饶妹，书经为爱鹅。",
        "仍闻广练被，更有远儒过。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 346581,
      "title": "题天华观",
      "content": [
        "峰嶂徘徊霞景新，一潭寒水绝纤鳞。",
        "朱字灵书千万轴，",
        "眼见仙丹求不得，汉家簪绂在羸身。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 346582,
      "title": "宿石瓮寺",
      "content": [
        "殿有寒灯草有萤，千林万壑寂无声。",
        "烟凝积水龙蛇蛰，",
        "回瞻相好因垂泪，苦海波涛何日平。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 346585,
      "title": "九日同司直九叔崔侍御登宝鸡南楼",
      "content": [
        "把菊叹将老，上楼悲未还。",
        "短长新白发，重叠旧青山。",
        "霜气清襟袖，琴声引醉颜。",
        "竹林唯七友，何幸亦登攀。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 346586,
      "title": "同王员外雨后登开元寺南楼因寄西岩警上人",
      "content": [
        "过雨开楼看晚虹，白云相逐水相通。",
        "寒蝉噪暮野无日，",
        "何言暂别东林友，惆怅人间事不同。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 346587,
      "title": "同赵进马元阳春日登长春宫古城望河中因寄郑损仓曹",
      "content": [
        "城头春霭晓蒙蒙，指望关桥满袖风。",
        "云骑闲嘶宫柳外，",
        "迹忝已成方恋赏，此时离恨与君同。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    }
  ],
