{
  "data": [
    {
      "id": 206705,
      "title": "鄂州南楼书事四首  其三",
      "content": [
        "势压湖南可长雄，胸吞云梦略从容。",
        "北船未尝睹巨丽，复阁重楼天际逢。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206706,
      "title": "鄂州南楼书事四首  其四",
      "content": [
        "武昌参佐幕中画，我亦来追六月凉。",
        "老子平生殊不浅，诸君少住对胡床。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206707,
      "title": "南楼画阁观方公悦二小诗戏次韵  其一",
      "content": [
        "十年华屋网蛛尘，大旆重来一日新。",
        "五凤楼前修造手，个中余刃亦精神。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206708,
      "title": "南楼画阁观方公悦二小诗戏次韵  其二",
      "content": [
        "重山复水绕深幽，不见高贤独倚楼。",
        "手拂壁间留恨句，凌波微步有人愁。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206709,
      "title": "庭坚以去岁九月至鄂登南楼叹其制作之美成长句久欲寄远因循至今书呈公悦",
      "content": [
        "江东湖北行画图，鄂州南楼天下无。",
        "高明广深势抱合，表里江山来画阁。",
        "雪筵披襟夏簟寒，胸吞云梦何足言。",
        "庾公风流冷似铁，谁其继之方公悦。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 206710,
      "title": "养鬭鸡",
      "content": [
        "峥嵘已介季氏甲，更以黄金饰两戈。",
        "虽有英心甘鬭死，其如纪渻木鸡何。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206711,
      "title": "颜徒贫乐斋二首  其一",
      "content": [
        "衡门低首过，环堵容膝坐。",
        "四旁无给侍，百衲自缠裹。",
        "论事直如弦，观书曲肱卧。",
        "饥来或乞食，有道无不可。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 206712,
      "title": "颜徒贫乐斋二首  其二",
      "content": [
        "小山作友朋，义重子舆桑。",
        "香草当姬妾，不须珠翠妆。",
        "鸟乌窥冻砚，星月入幽房。",
        "儿报无炊米，浩歌绕屋梁。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 206713,
      "title": "和凉轩二首  其一",
      "content": [
        "打荷看急雨，吞月任行云。",
        "夜半蚊雷起，西风为解纷。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 206714,
      "title": "和凉轩二首  其二",
      "content": [
        "茗椀梦中觉，荷花镜里香。",
        "凉生只当处，暑退亦无方。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 206715,
      "title": "题默轩和遵老",
      "content": [
        "平生三业浄，在俗亦超然。",
        "佛事一盂饭，横眠不学禅。",
        "松风佳客共，茶梦小僧圆。",
        "漫续山家颂，非诗莫浪传。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 206716,
      "title": "次韵文安国纪梦",
      "content": [
        "道人偶许俗人知，法喜非妻解养儿。",
        "夜久金茎添沆瀣，室虚璧月映琉璃。",
        "远来醉侠匆匆去，近出诗仙句句奇。",
        "独怪区区践绳墨，相逢未省角巾敧。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 206717,
      "title": "寄贺方回",
      "content": [
        "少游醉卧古藤下，谁与愁眉唱一杯。",
        "解作江南断肠句，只今唯有贺方回。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206718,
      "title": "文安国挽词二首  其一",
      "content": [
        "七闽家举子，百粤海还珠。",
        "往日推忠厚，穷年领转输。",
        "一床遗杖屦，万事委锱铢。",
        "岂有苍茫恨，归巢未拮据。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 206719,
      "title": "文安国挽词二首  其二",
      "content": [
        "平生翰墨学，空走使臣车。",
        "瞿令能苍史，归公好古书。",
        "秦山刊日月，周鼓颂畋渔。",
        "不见龙蛇笔，新干研滴蜍。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 206720,
      "title": "鄂州节推陈荣绪惠示沿檄崇阳道中六诗老懒不能追韵辄自取韵奉和 头陀寺",
      "content": [
        "头陀全盛时，宫殿梯空级。",
        "城中望金碧，云外僧𧥄𧥄。",
        "人亡经禅尽，屋破龙象泣。",
        "惟有简栖碑，文字岿然立。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 206721,
      "title": "鄂州节推陈荣绪惠示沿檄崇阳道中六诗老懒不能追韵辄自取韵奉和 道中闻松声",
      "content": [
        "蟠空作风雨，发地鸣鼓吹。",
        "日晴四无人，声在高林际。",
        "伊优儿女语，蹇浅市井议。",
        "我欲抱七弦，写此以卒岁。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 206722,
      "title": "鄂州节推陈荣绪惠示沿檄崇阳道中六诗老懒不能追韵辄自取韵奉和 中秋山行怀子兴节判",
      "content": [
        "俗物常偪塞，令人眼生白。",
        "永怀洛阳人，谈诗论画壁。",
        "青山吐秋月，阻作南楼客。",
        "但歌靡盬诗，赏此无瑕璧。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 206723,
      "title": "鄂州节推陈荣绪惠示沿檄崇阳道中六诗老懒不能追韵辄自取韵奉和 再登莲落岭怀君泽知录",
      "content": [
        "邑下羹不和，幕中往调护。",
        "纷争非士则，各使捐细故。",
        "颇忆郗参军，能令公喜怒。",
        "应知鞅掌车，历尽崔嵬路。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 206724,
      "title": "鄂州节推陈荣绪惠示沿檄崇阳道中六诗老懒不能追韵辄自取韵奉和 崇阳道中",
      "content": [
        "张公少为令，愍俗有遗书。",
        "左贩洞庭橘，右担彭蠡鱼。",
        "歌奔中夜女，归抱十年雏。",
        "近岁多儒学，仁风似有初。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 206725,
      "title": "鄂州节推陈荣绪惠示沿檄崇阳道中六诗老懒不能追韵辄自取韵奉和 晚发咸宁行松径至芦子",
      "content": [
        "咸宁走芦子，终日乔木阴。",
        "太丘心洒落，古松韵清深。",
        "聊持不俗耳，静听无弦琴。",
        "非今胡部律，而独可人心。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 206726,
      "title": "陈荣绪惠示之字韵诗推奖过实非所敢当辄次高韵三首  其一",
      "content": [
        "纷纷不可耐，君子有忧之。",
        "鞅掌诚庄语，贤劳似怨诗。",
        "颓波阅砥柱，浊水得摩尼。",
        "知我无枝叶，刳心只有皮。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 206727,
      "title": "陈荣绪惠示之字韵诗推奖过实非所敢当辄次高韵三首  其二",
      "content": [
        "太丘胸量阔，一苇莫杭之。",
        "万事不挂眼，四愁犹有诗。",
        "状闲聊阘茸，心洁似毗尼。",
        "早晚同舟去，烟波学子皮。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 206728,
      "title": "陈荣绪惠示之字韵诗推奖过实非所敢当辄次高韵三首  其三",
      "content": [
        "十家有忠信，江夏可无之。",
        "政苦寄卖友，忽闻衡说诗。",
        "饥蒙青𩠇饭，寒赠紫陀尼。",
        "酬报矜难巧，深慙陆与皮。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 206729,
      "title": "德孺五丈和之字诗韵难而愈工辄复和成可发一笑",
      "content": [
        "且然聊尔耳，得也自知之。",
        "独笑真成梦，狂歌或似诗。",
        "照滩禽郭索，烧野得伊尼。",
        "早晚来同醉，僧窗卧虎皮。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 206730,
      "title": "次韵德孺新居病起",
      "content": [
        "潭潭经略府，寂寂闭门居。",
        "京洛圣贤宅，江湖鱼鼈潴。",
        "官如一梦觉，话胜十年书。",
        "稍喜过从近，扶筇不驾车。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 206731,
      "title": "次韵德孺感兴二首  其一",
      "content": [
        "于此吾忘我，从谁尺直寻。",
        "事来千万种，人有两三心。",
        "自守藩篱小，犹能井臼任。",
        "过时虽不采，吾与菊花斟。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 206732,
      "title": "次韵德孺感兴二首  其二",
      "content": [
        "眼前尝废忘，事往更追寻。",
        "爱酒陶元亮，著书王仲任。",
        "寒蒲虽有节，枯木已无心。",
        "客至还须饮，逢欢起自斟。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 206733,
      "title": "次韵德孺惠贶秋字之句",
      "content": [
        "少日才华接贵游，老来忠义气横秋。",
        "未应白发如霜草，不见丹砂似箭头。",
        "顾我今成丧家狗，期君早作济川舟。",
        "汉家宗庙英灵在，定是寒儒浪自愁。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 206734,
      "title": "求范子默染鸦青纸二首  其一",
      "content": [
        "学似贫家老破除，古今迷忘失三余。",
        "极知鹄白非新得，谩染鸦青袭旧书。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206735,
      "title": "求范子默染鸦青纸二首  其二",
      "content": [
        "深如女发兰膏罢，明似山光夜月余。",
        "为染溪藤三百个，待渠湔拂一床书。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206736,
      "title": "谢荣绪惠贶鲜鲫",
      "content": [
        "偶思暖老庖玄鲫，公遣霜鳞贯柳来。",
        "虀臼方看金作屑，鲙盘已见雪成堆。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206737,
      "title": "谢荣绪割麞见贻二首  其一",
      "content": [
        "何处惊麏触祸机，烦君遣骑割鲜肥。",
        "秋来多病新开肉，粝饭寒葅得解围。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206738,
      "title": "谢荣绪割麞见贻二首  其二",
      "content": [
        "二十余年枯淡过，病来筯下剧甘肥。",
        "果然口腹为灾怪，梦去呼鹰雪打围。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206739,
      "title": "吴执中有两鹅为余烹之戏赠",
      "content": [
        "学书池上一双鹅，宛颈相追笔意多。",
        "皆为涪翁赴汤鼎，主人言汝不能歌。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206740,
      "title": "秋冬之间鄂渚绝市无蟹今日偶得数枚吐沫相濡乃可悯笑戏成小诗三首  其一",
      "content": [
        "怒目横行与虎争，寒沙奔火祸胎成。",
        "虽为天上三辰次，未免人间五鼎烹。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206741,
      "title": "秋冬之间鄂渚绝市无蟹今日偶得数枚吐沫相濡乃可悯笑戏成小诗三首  其二",
      "content": [
        "勃窣媻跚烝涉波，草泥出没尚横戈。",
        "也知觳觫元无罪，奈此尊前风味何。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206742,
      "title": "秋冬之间鄂渚绝市无蟹今日偶得数枚吐沫相濡乃可悯笑戏成小诗三首  其三",
      "content": [
        "解缚华堂一座倾，忍堪支解见姜橙。",
        "东归却为鲈鱼鲙，未敢知言许季鹰。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206743,
      "title": "宁子与追和予岳阳楼诗复次韵二首  其一",
      "content": [
        "去年新霁独凭栏，山似樊姬拥髻鬟。",
        "个里宛然多事在，世间遥望但云山。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206744,
      "title": "宁子与追和予岳阳楼诗复次韵二首  其二",
      "content": [
        "轩皇乐罢拱朝班，天地为家不闭关。",
        "惟有金炉紫烟起，至今留作御前山。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206745,
      "title": "和宁子与白鹿寺",
      "content": [
        "谷朗岩开见佛灯，云遮雾掩碧层层。",
        "青山得意看流水，白鹿归来失旧僧。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206746,
      "title": "谢人惠猫头笋",
      "content": [
        "长沙一月煨鞭笋，鹦鹉洲前人未知。",
        "走送烦公助汤餠，猫头突兀想穿篱。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206747,
      "title": "短韵奉乞腊梅",
      "content": [
        "卧云庄上残花笑，香似早梅开不迟。",
        "浅色春衫弄风日，遣来当为作新诗。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206748,
      "title": "以酒渴爱江清作五小诗寄廖明略学士兼简初和父主簿  其一",
      "content": [
        "将发沔鄂间，尽醉竹林酒。",
        "二三石友辈，未肯弃老朽。",
        "借问坐客谁，卢溪紫髯叟。",
        "此翁今惜醉，旧不论升斗。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 206749,
      "title": "以酒渴爱江清作五小诗寄廖明略学士兼简初和父主簿  其二",
      "content": [
        "平生思故人，江汉不解渴。",
        "谁言放逐地，烧烛饮至跋。",
        "忧予先狗马，劝以爱肤发。",
        "有罪当窜流，但惧不得活。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 206750,
      "title": "以酒渴爱江清作五小诗寄廖明略学士兼简初和父主簿  其三",
      "content": [
        "廖侯劝我酒，此亦雅所爱。",
        "中年刚制之，常惧作灾怪。",
        "连台盘拗倒，故人不相贷。",
        "谁能知许事，痛饮且一快。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 206751,
      "title": "以酒渴爱江清作五小诗寄廖明略学士兼简初和父主簿  其四",
      "content": [
        "竹林文章伯，国士无与双。",
        "比来少制作，非以弱故降。",
        "景阳机中锦，犹衣被丘江。",
        "时时能度曲，秀句入新腔。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 206752,
      "title": "以酒渴爱江清作五小诗寄廖明略学士兼简初和父主簿  其五",
      "content": [
        "斯人绝少可，白眼视公卿。",
        "每与俗物逢，三沐取洁清。",
        "我亦漫浪者，君何许同盟。",
        "试问卢溪叟，犹得多可名。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 206753,
      "title": "四休居士诗三首  其一",
      "content": [
        "富贵何时润髑髅，守钱奴与拘官囚。",
        "太医诊得人间病，安乐延年万事休。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206754,
      "title": "四休居士诗三首  其二",
      "content": [
        "无求不着看人面，有酒可以留人嬉。",
        "欲知四休安乐法，听取山谷老人诗。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206755,
      "title": "四休居士诗三首  其三",
      "content": [
        "一病能恼安乐性，四病长作一生愁。",
        "借问四休何所好，不令一点上眉头。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206756,
      "title": "十二月十九日夜中发鄂渚晓泊汉阳亲旧携酒追送聊为短句",
      "content": [
        "接淅报官府，敢违王事程。",
        "宵征江夏县，睡起汉阳城。",
        "邻里烦追送，杯盘泻浊清。",
        "秪应瘴乡老，难答故人情。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 206757,
      "title": "次韵陈荣绪同倚钟楼晚望别后明日见寄之作",
      "content": [
        "天外僧伽塔，斜辉极照临。",
        "凭栏随处好，残雪向来深。",
        "青草无风浪，枯松半死心。",
        "衡阳有回雁，他日更传音。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 206758,
      "title": "过洞庭青草湖",
      "content": [
        "乙丑越洞庭，丙寅渡青草。",
        "似为神所怜，雪上日杲杲。",
        "我虽贫至骨，犹胜杜陵老。",
        "忆昔上岳阳，一饭从人讨。",
        "行矣勿迟留，蕉林追獦獠。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206759,
      "title": "过土山寨",
      "content": [
        "南风日日纵篙撑，时喜北风将我行。",
        "汤餠一杯银线乱，蒌蒿数筯玉簪横。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206760,
      "title": "晚泊长沙示秦处度范元实用寄明略和父韵五首  其一",
      "content": [
        "昔在秦少游，许我同门友。",
        "掘狱无张雷，剑气在牛斗。",
        "今来见令子，文似前哲有。",
        "何用相浇泼，清江绿如酒。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 206761,
      "title": "晚泊长沙示秦处度范元实用寄明略和父韵五首  其二",
      "content": [
        "范公太史僚，山立乃先达。",
        "发挥百代史，管以六经辖。",
        "投身转岭海，就木乃京洛。",
        "仲子见长沙，且用慰饥渴。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 206762,
      "title": "晚泊长沙示秦处度范元实用寄明略和父韵五首  其三",
      "content": [
        "秦郎水江汉，范郎器鼎鼐。",
        "逝者不可寻，犹喜二子在。",
        "相逢唾珠玉，贫病问薪菜。",
        "豫愁帆风船，目极别所爱。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 206763,
      "title": "晚泊长沙示秦处度范元实用寄明略和父韵五首  其四",
      "content": [
        "往时高交友，宰木已枞枞。",
        "今我二三子，事业在灯窗。",
        "秦范波澜阔，笑陆海潘江。",
        "愿兹秉经术，出仕荣家邦。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 206764,
      "title": "晚泊长沙示秦处度范元实用寄明略和父韵五首  其五",
      "content": [
        "少游五十策，其言明且清。",
        "笔墨深关键，开阖见日星。",
        "陈友评斯文，如钟磬鼓笙。",
        "谁能续凤鸣，洗耳听两甥。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 206765,
      "title": "次韵元实病目",
      "content": [
        "道人尝恨未灰心，儒士苦爱读书眼。",
        "要须玄览照镜空，莫作白鱼钻蠹简。",
        "阅人朦胧似有味，看字昏涩尤宜懒。",
        "范侯年少百夫雄，言行一一无可柬。",
        "看君眸子当了然，乃称胸次常坦坦。",
        "如何有物食明月，泪睫陨珠衣袖满。",
        "金篦刮膜会有时，汤熨取快术诚短。",
        "君不见岳头懒瓒一生禅，鼻涕垂颐渠不管。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206766,
      "title": "胜业寺悦亭",
      "content": [
        "苦雨已解严，诸峰来献状。",
        "不见白头禅，空倚紫藤杖。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 206767,
      "title": "离福严",
      "content": [
        "山下三日晴，山上三日雨。",
        "不见祝融峰，还溯潇湘去。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 206768,
      "title": "花光仲仁出秦苏诗卷思二国士不可复见开卷绝叹因花光为我作梅数枝及画烟外远山追少游韵记卷末",
      "content": [
        "梦蝶真人貌黄槁，篱落逢花须醉倒。",
        "雅闻花光能画梅，更乞一枝洗烦恼。",
        "扶持爱梅说道理，自许牛头参已早。",
        "长眠橘洲风雨寒，今日梅开向谁好。",
        "何况东坡成古丘，不复龙蛇看挥扫。",
        "我向湖南更岭南，系船来近花光老。",
        "叹息斯人不可见，喜我未学霜前草。",
        "写尽南枝与北枝，更作千峰倚晴昊。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206769,
      "title": "题花光画",
      "content": [
        "湖北山无地，湖南水彻天。",
        "云沙真富贵，翰墨小神仙。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 206770,
      "title": "题花光画山水",
      "content": [
        "花光寺下对云沙，欲把轻舟小钓车。",
        "更看道人烟雨笔，乱峰深处是吾家。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206771,
      "title": "所住堂",
      "content": [
        "此山花光佛所住，今日花光还放光。",
        "天女来修散花供，道人自有本来香。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206772,
      "title": "戏咏高节亭边山矾花二首  其一",
      "content": [
        "北岭山矾取意开，轻风正用此时来。",
        "平生习气难料理，爱著幽香未拟回。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206773,
      "title": "戏咏高节亭边山矾花二首  其二",
      "content": [
        "高节亭边竹已空，山矾独自倚春风。",
        "二三名士开颜笑，把断花光水不通。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206774,
      "title": "赠惠洪",
      "content": [
        "数面欣羊胛，论诗喜雉膏。",
        "眼横湘水暮，云献楚天高。",
        "堕我玉麈尾，乞君宫锦袍。",
        "月清放舟舫，万里渺云涛。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 206775,
      "title": "戏咏零陵李宗古居士家驯鹧鸪二首  其一",
      "content": [
        "山雌之弟竹鸡兄，乍入雕笼便不惊。",
        "此鸟为公行不得，报晴报雨总同声。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206776,
      "title": "戏咏零陵李宗古居士家驯鹧鸪二首  其二",
      "content": [
        "真人梦出大槐宫，万里苍梧一洗空。",
        "终日忧兄行不得，鹧鸪应是鼻亭公。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206777,
      "title": "李宗古出示谢李道人苕帚杖从蒋彦回乞葬地二颂作二诗奉呈  其一",
      "content": [
        "提携禅客扶衰杖，断当姻家葬骨山。",
        "因病废棋仍废酒，鹧鸪鹦鹉伴清闲。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206778,
      "title": "李宗古出示谢李道人苕帚杖从蒋彦回乞葬地二颂作二诗奉呈  其二",
      "content": [
        "诗书传女似中郎，杞菊同盘有孟光。",
        "今日鹧鸪鸣蹇蹇，他年鹦鹉恨堂堂。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206779,
      "title": "书磨崖碑后",
      "content": [
        "春风吹船著浯溪，扶藜上读中兴碑。",
        "平生半世看墨本，摩挲石刻鬓成丝。",
        "明皇不作苞桑计，颠倒四海由禄儿。",
        "九庙不守乘舆西，万官已作乌择栖。",
        "抚军监国太子事，何乃趣取大物为。",
        "事有至难天幸尔，上皇跼蹐还京师。",
        "内间张后色可否，外闲李父颐指挥。",
        "南内凄凉几苟活，高将军去事尤危。",
        "臣结舂陵二三策，臣甫杜鹃再拜诗。",
        "安知忠臣痛至骨，世上但赏琼琚词。",
        "同来野僧六七辈，亦有文士相追随。",
        "断崖苍藓对立久，涷雨为洗前朝悲。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206780,
      "title": "浯溪图",
      "content": [
        "成子写浯溪，下笔便造极。",
        "空蒙得真趣，肤寸已千尺。",
        "只今中宫寺，在昔漫郎宅。",
        "更作老夫船，樯竿插苍石。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 206781,
      "title": "太平寺慈氏阁",
      "content": [
        "青玻瓈盆插千岑，湘江水清无古今。",
        "何处拭目穷表里，太平飞阁暂登临。",
        "朝阳不闻皂盖下，愚溪但见古木阴。",
        "谁与洗涤怀古恨，坐有佳客非孤斟。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 206782,
      "title": "题淡山岩二首  其一",
      "content": [
        "去城二十五里近，天与隔尽俗子尘。",
        "春蛙秋蝇不到耳，夏凉冬暖总宜人。",
        "岩中清磬僧定起，洞口绿树仙家春。",
        "惜哉次山世未显，不得雄文镵翠珉。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 206783,
      "title": "题淡山岩二首  其二",
      "content": [
        "淡山淡姓人安在，征君避秦亦不归。",
        "石门竹径几时有，琼台瑶室至今疑。",
        "回中明洁坐十客，亦可呼乐醉舞衣。",
        "阆州城南果何似，永州淡岩天下稀。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 206784,
      "title": "明远庵",
      "content": [
        "远公引得陶潜住，美酒沽来饮无数。",
        "我醉欲眠卿且去，只有空瓶同此趣。",
        "谁知明远似远公，亦欲我行庵上路。",
        "多方挈取瓮头春，大白梨花十分注。",
        "与君深入逍遥游，了无一物当情素。",
        "道卿道卿归去来，明远主人今进步。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206785,
      "title": "玉芝园",
      "content": [
        "春生潇湘水，风鸣涧谷泉。",
        "过雨花漠漠，弄晴絮翩翩。",
        "名园上朱阁，观后复观前。",
        "借问昔居人，岑绝无炊烟。",
        "人生须富贵，河水清且涟。",
        "百年共如此，安用涕潺湲。",
        "蒋侯真好事，杖屦喜接连。",
        "车载溪中骨，推排若差肩。",
        "厌看孔壬面，丑石反成妍。",
        "感君劝我醉，吾亦无间然。",
        "乱我朱碧眼，空花坠便翾。",
        "行动须人扶，那能金石坚。",
        "爱君雷氏琴，汤汤发朱弦。",
        "但恨赏音人，大半随逝川。",
        "平生有诗罪，如痼不可痊。",
        "今当痛自改，三衅复三湔。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206786,
      "title": "游愚溪",
      "content": [
        "意行到愚溪，竹舆鸣担肩。",
        "冉溪昔居人，埋没不知年。",
        "偶托文字工，遂以愚溪传。",
        "柳侯不可见，古木荫溅溅。",
        "罗氏家潇东，潇西读书园。",
        "笋茁不避道，檀栾摇春烟。",
        "下入朝阳岩，次山有铭镌。",
        "藓石破篆文，不辨瞿李袁。",
        "嵌窦响笙磬，洞中出寒泉。",
        "同游三五客，拂石弄潺湲。",
        "俄顷生白云，似欲驾我仙。",
        "吾将从此逝，挽牵遂回船。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206787,
      "title": "代书寄翠岩新禅师",
      "content": [
        "山谷青石牛，自负万钧重。",
        "八风吹得行，处处是日用。",
        "又将十六口，去作宜州梦。",
        "苦忆新老人，是我法梁栋。",
        "信手斫方圆，规矩一一中。",
        "遥思灵源叟，分坐法席共。",
        "聊持楚狂句，往作天女供。",
        "岭上早梅春，参军慙独弄。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206788,
      "title": "戏答欧阳诚发奉议谢余送茶歌",
      "content": [
        "欧阳子，出阳山。",
        "山奇水怪有异气，生此突兀熊豹颜。",
        "饮如江入洞庭野，诗成十手不供写。",
        "老来抱璞向涪翁，东坡原是知音者。",
        "苍龙璧，官焙香。",
        "涪翁投赠非世味，自许诗情合得尝。",
        "却思翰林来餽光禄酒，两家水鉴共寒光。",
        "予乃安敢比东坡，有如玉盘金叵罗。",
        "直相千万不啻过，爱公好诗又能多。",
        "老夫何有更横戈，奈此于思百战何。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206789,
      "title": "到桂州",
      "content": [
        "桂岭环城如雁荡，平地苍玉忽嶒峨。",
        "李成不在郭熙死，奈此百嶂千峰何。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206790,
      "title": "答许觉之惠桂花椰子茶盂二首  其一",
      "content": [
        "万事相寻荣与衰，故人别来鬓成丝。",
        "欲知岁晚在何许，唯说山中有桂枝。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206791,
      "title": "答许觉之惠桂花椰子茶盂二首  其二",
      "content": [
        "硕果不食寒林梢，剖而器之如悬匏。",
        "故人相见各贫病，且可烹茶当酒肴。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206792,
      "title": "以椰子茶瓶寄德孺二首  其一",
      "content": [
        "硕果𫕥林梢，可以代悬匏。",
        "携持二十年，煮茗当酒肴。",
        "我今御魑魅，学打衲僧包。",
        "聊持坚重器，遗我金石交。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 206793,
      "title": "以椰子茶瓶寄德孺二首  其二",
      "content": [
        "炎丘椰木实，入用随茗椀。",
        "譬如楛矢砮，但贵从来远。",
        "往时万里物，今在篱落间。",
        "知公一拂拭，想我瘴雾颜。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 206794,
      "title": "寄黄龙清老三首  其一",
      "content": [
        "万山不隔中秋月，一雁能传寄远书。",
        "深密伽陀枯战笔，真成相见问何如。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206795,
      "title": "寄黄龙清老三首  其二",
      "content": [
        "风前橄榄星宿落，日下桄榔羽扇开。",
        "昭默堂中有相忆，清秋忽遣化人来。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206796,
      "title": "寄黄龙清老三首  其三",
      "content": [
        "骑馿觅馿但可笑，非马喻马亦成痴。",
        "一天月色为谁好，二老风流只自知。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206797,
      "title": "宜阳别元明用觞字韵",
      "content": [
        "霜须八十期同老，酌我仙人九酝觞。",
        "明月湾头松老大，永思堂下草荒凉。",
        "千林风雨鶑求友，万里云天雁断行。",
        "别夜不眠听鼠啮，非关春茗搅枯肠。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 206798,
      "title": "和范信中寓居崇宁遇雨二首  其一",
      "content": [
        "范侯来寻八桂路，走避俗人如脱兔。",
        "衣囊夜雨寄禅家，行潦升阶漂两屦。",
        "遣闷闷不离眼前，避愁愁已知人处。",
        "庆公忧民苗未立，旻公忧木水推去。",
        "两禅有意开寿域，岁晚筑室当百堵。",
        "他时无屋可藏身，且作五里公超雾。"
      ],
