{
  "data": [
    {
      "id": 33273,
      "title": "别荣州",
      "content": [
        "浮生岁岁俱如梦，一枕轻安亦可人。",
        "偶落山城无事处，暂还老子自由身。",
        "啸台载酒云生履，仙穴寻梅雨垫巾。",
        "便恐清游从此少，锦城车马涨红尘。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 33274,
      "title": "闻仲高从兄讣",
      "content": [
        "去国万里逰，发书三日哭。",
        "久矣吾已衰，哀哉公不淑。",
        "寄书墨未干，玉立在我目。",
        "天高鬼神恶，生世露电速。",
        "丹心抱忠贞，白首悲放逐。",
        "九阍不可叫，百身何由赎。",
        "文章果何罪，一斥独不复。",
        "上寿阿母前，悔不早碌碌。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 33275,
      "title": "夏日过摩诃池",
      "content": [
        "乌帽翩翩白纻轻，摩诃池上试闲行。",
        "淙潺野水鸣空苑，寂歴斜阳下废城。",
        "纵辔迎凉看马影，袖鞭寻句听蝉声。",
        "白头散吏元无事，却为兴亡一怆情。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 33276,
      "title": "早行",
      "content": [
        "筰马践槐影，纱笼吹蜡香。",
        "凭鞭寻断梦，侧帽受微凉。",
        "病骨更疏放，衰怀罢激昻。",
        "道邉双石笋，笑我伴人忙。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 33277,
      "title": "天申节前三日大圣慈寺华严阁燃灯甚盛逰人过于元夕",
      "content": [
        "万瓦如鳞百尺梯，遥看突兀与云齐。",
        "宝帘风定灯相射，绮陌尘香马不嘶。",
        "星陨半空天宇静，莲生陆地客心迷。",
        "归途细踏槐阴月，家在花行更向西。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 33278,
      "title": "喜雨",
      "content": [
        "黄尘赤日欲忘生，一夜新凉满锦城。",
        "雨急骤增车辙水，泥深渐壮马蹄声。",
        "蚊蝇敛迹知无地，灯火于人顿有情。",
        "市远鸡豚不须问，小畦蔬甲已堪烹。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 33279,
      "title": "夜闻浣花江声甚壮",
      "content": [
        "浣花之东当筰桥，奔流啮桥桥为摇。",
        "分洪初疑两蛟舞，触石散作千珠跳。",
        "壮声每挟雷雨横，巨势濳借鼋鼍骄。",
        "梦回闻之坐太息，鐡衣何日东征辽。",
        "衔枚度碛沙飒飒，盘槊断陇风萧萧。",
        "不然投檄径归去，短篷卧听钱塘潮。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 33280,
      "title": "暑行憩新都驿",
      "content": [
        "细细黄花落古槐，江皋不雨转轻雷。",
        "长空鸟破苍烟去，落日人从绿野来。",
        "散策意行寻水石，脱巾高卧避氛埃。",
        "羁逰未羡端居乐，看月房湖又一回。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 33281,
      "title": "早发新都驿",
      "content": [
        "喔喔江村鸡，迢迢县门漏。",
        "河汉纵复横，繁星明如昼。",
        "爱凉趣上马，未晓阅两堠。",
        "高林起宿鸟，绝涧落惊狖。",
        "寺楼插苍烟，沙泉泻幽窦。",
        "我行忽万里，坐叹关河溜。",
        "官如广文冷，面作拾遗瘦。",
        "今年盍归哉，勿落春雁后。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 33282,
      "title": "谒诸葛丞相庙",
      "content": [
        "汉终四百天所命，老贼方持太阿柄。",
        "区区梁益岂足支，不忍安坐观异姓。",
        "遗民亦知王室在，闰位那干天统正。",
        "公虽已没有神灵，犹假贼手诛钟邓。",
        "前年我过沔阳祠，再拜奠爼衰泪迸。",
        "洁斋请作送迎诗，精忠大义神其听。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 33283,
      "title": "自汉州之金堂过沈氏竹园小憩坐间微雨",
      "content": [
        "修修万竹压康庄，碧玉掾围一尺彊。",
        "雪节烟梢谁暇赏，马蹄车辙可怜忙。",
        "帽邉忽堕吹香句，肘后旧传医俗方。",
        "更觉清逰天所惜，坐来飞雨度横塘。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 33284,
      "title": "自小云顶上云顶寺",
      "content": [
        "素衣虽成缁，不为京路尘。",
        "跃马上云顶，欲呼飞仙人。",
        "飞仙不可呼，野僧意甚真。",
        "煎茶清樾下，童子拾堕薪。",
        "我少本疏放，一出但坐贫。",
        "缚袴属櫜鞬，哀哉水云身。",
        "此地虽暂寓，失喜忘吟呻。",
        "故溪归去来，岁晚思鲈莼。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 33285,
      "title": "马上微雨",
      "content": [
        "三日触毒暑，衣垢背汗浃。",
        "今旦殊萧然，凉雨吹醉颊。",
        "瘦松无横枝，蠧竹少全叶。",
        "渚莲乃可念，泫泣如放妾。",
        "岂惟人意适，我马亦振鬛。",
        "远村有归人，清溪争晚涉。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 33286,
      "title": "弥牟镇驿舍小酌",
      "content": [
        "邮亭草草置盘盂，买果煎蔬便有余。",
        "自许白云终醉死，不论黄纸有除书。",
        "角巾垫雨蝉声外，细葛含风日落初。",
        "行遍天涯身尚健，却嫌陶令爱吾庐。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 33287,
      "title": "游弥牟菩提院庭下有凌霄藤附古楠其高数丈花已零落满地",
      "content": [
        "绛英翠蔓亦佳哉，零乱空庭码瑙杯。",
        "遍雨新花天有意，定知闲客欲闲来。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 33288,
      "title": "楼上醉歌",
      "content": [
        "我游四方不得意，阳狂施药成都市。",
        "大瓢满贮随所求，聊为疲民起憔悴。",
        "瓢空夜静上高楼，买酒卷帘邀月醉。",
        "醉中拂剑光射月，往往悲歌独流涕。",
        "刬却君山湘水平，斫却桂树月更明。",
        "丈夫有志苦难成，修名未立华发生。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 33289,
      "title": "伏日独逰城西",
      "content": [
        "幕府重来老令威，山川良是昔人非。",
        "痴儿已遣了官事，伏日元知当早归。",
        "避热幽花房自敛，迎秋高树叶先飞。",
        "论诗敢补先师处，僭拂江头旧钓矶。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 33290,
      "title": "五鼓送客出城马上作",
      "content": [
        "夜漏余十刻，凉飔如九秋。",
        "滩声聒酒醒，月色照人愁。",
        "落魄悲孤宦，龙钟怯远游。",
        "此生那可料，六岁剑南州。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 33291,
      "title": "寓舍书怀",
      "content": [
        "借得茅斋近筰桥，羁怀病思两无聊。",
        "春从豆蔲梢头老，日向樗蒱齿上消。",
        "丛竹晓兼风力横，高梧夜挟雨声骄。",
        "书生莫倚身常健，未画凌烟鬓已凋。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 33292,
      "title": "夜登城楼",
      "content": [
        "上天何苍苍，四序浩旋斡。",
        "异哉今年热，炊鬻不可活。",
        "夜分睡复起，揺箑腕欲脱。",
        "彊登城西楼，月露渺空濶。",
        "凭栏弄清影，凉飔入蕉葛。",
        "湿萤沾草根，惊鹘起木末。",
        "亦知难久留，襟抱资一豁。",
        "人事迭废兴，天理交予夺。",
        "羲和不停驭，去若弦上筈。",
        "此热会当衰，岁晚备裘褐。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 33293,
      "title": "试茶",
      "content": [
        "苍爪初惊鹰脱鞲，得汤已见玉花浮。",
        "睡魔何止避三舍，欢伯直知输一筹。",
        "日铸焙香怀旧隐，谷帘试水忆西逰。",
        "银缾铜碾俱官様，恨欠纤纤为捧瓯。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 33294,
      "title": "成都大阅",
      "content": [
        "千步毬场爽气新，西山遥见碧嶙峋。",
        "令传雪岭蓬婆外，声震秦川渭水濵。",
        "旗脚倚风时弄影，马蹄经雨不霑尘。",
        "属櫜缚袴毋多恨，久矣儒冠误此身。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 33295,
      "title": "书怀",
      "content": [
        "万里驰驱坐一饥，自怜无计脱尘鞿。",
        "身留幕府还家少，眼乱文书把酒稀。",
        "客路更逢秋色晚，故山空有梦魂归。",
        "芋羮豆饭元堪饱，错用人言恨子威。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 33296,
      "title": "逰大智寺",
      "content": [
        "脱发纷满梳，衰颜不堪照。",
        "百年忽已半，去日如过烧。",
        "平生功名心，上马无燕赵。",
        "尔来阅世故，万事惊错料。",
        "岂无旧朋俦，聮翩半廊庙。",
        "谁能伴此老，溯峡听猿叫。",
        "锦城得数公，意气如再少。",
        "偷闲访野寺，系马追一笑。",
        "新糟厌玉貍，畏酒亦复釂。",
        "古殿鼪鼯豪，壊壁冠佩肖。",
        "摩挲宋公诗，句法叹高妙。",
        "正如霓裳曲，零落得遗调。",
        "归途缭长堤，掠面霜气峭。",
        "佳逰不可忘，落笔君勿诮。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 33297,
      "title": "看月睡晚戏作",
      "content": [
        "香火课夙兴，风月留晚睡。",
        "直言散吏闲，亦未尽无事。",
        "旧闻云台翁，高枕阅尘世。",
        "至今青嶂间，鼻息乱松吹。",
        "平生寡嗜好，所愿究此味。",
        "千年一欠伸，笑看岩花坠。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 33298,
      "title": "成都书事二首  其一",
      "content": [
        "剑南山水尽清晖，濯锦江邉天下稀。",
        "烟柳不遮楼角断，风花时傍马头飞。",
        "芼羮笋似稽山美，斫脍鱼如笠泽肥。",
        "客报城西有园卖，老夫白首欲忘归。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 33299,
      "title": "成都书事二首  其二",
      "content": [
        "大城少城柳已青，东台西台雪正晴。",
        "莺花又作新年梦，丝竹常闻静夜声。",
        "废苑烟芜迎马动，清江春涨拍堤平。",
        "尊中酒满身彊健，未恨飘零过此生。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 33300,
      "title": "双溪道中",
      "content": [
        "晓出筰桥门，天低日未暾。",
        "绿陂寒淡淡，白雾远昏昏。",
        "古路乱车辙，行人惊雁群。",
        "征涂不须厌，蓬转本无根。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 33301,
      "title": "牛饮市中小饮呈坐客",
      "content": [
        "牛饮桥头小市东，店门系马一尊同。",
        "已能自置功名外，尚欲相期意气中。",
        "褐拥紫茸迎晓日，酒翻红浪醉春风。",
        "从今共约无疏索，竹外梅花欲恼公。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 33302,
      "title": "自警",
      "content": [
        "乳烹佛粥遽如许，菜簇春盘行及时。",
        "草木欣欣渠得意，乾坤浩浩我何私。",
        "怀材所忌多轻用，学道当从不自欺。",
        "旦莫置规君勿怪，修身三省自先师。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 33303,
      "title": "午寝",
      "content": [
        "眼涩朦胧不自支，欠伸常恨到床迟。",
        "庭花著雨晴方见，野客敲门去始知。",
        "灰冷香烟无复在，汤成茶椀径须持。",
        "颓然却自嫌疏放，旋了生涯一首诗。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 33304,
      "title": "白发",
      "content": [
        "我生实多邅，九折行晚途。",
        "忧伤日熏心，惊见颊与颅。",
        "稍生秋风时，竞出寒雨余。",
        "星星初尚稀，𧥄𧥄不可除。",
        "昔如春柳妍，今作霜蓬枯。",
        "蓬枯有再绿，念我岂得如。",
        "平昔乐方外，固与功名疏。",
        "投镊三叹息，金丹岂无书。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 33305,
      "title": "明日午睡至暮复次前韵",
      "content": [
        "酒力醺然入四支，华胥税驾不应迟。",
        "残年已觉衰难彊，万事无如睡不知。",
        "幸有琴书供枕籍，安能冠带更支持。",
        "红炉过尽灰如雪，独守青灯坐画诗。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 33306,
      "title": "醉中长歌",
      "content": [
        "阑干斗柄摇天东，人间一夜回春风。",
        "注桃染柳岁相似，惟我衰颜非昔红。",
        "可怜逢春不自感，更欲使气惊儿童。",
        "烟郊射雉锦臆碎，水亭供鲙金盘空。",
        "归穿南市万人看，流星突过连钱骢。",
        "高楼作歌醉自写，墨光烛焰交长虹。",
        "人生未死贵适意，万里作客元非穷。",
        "故人夜直金銮殿，僵卧独听宫门钟。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 33307,
      "title": "对酒",
      "content": [
        "扇邉生怕庾公尘，索笑来逰锦水濵。",
        "四野云齐初酿雪，一枝梅动已催春。",
        "绿尊有味能消日，白发无情不贷人。",
        "商略此生何所恨，太平时得自由身。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 33308,
      "title": "人日饮昭觉",
      "content": [
        "天涯羁旅逄人日，病起消摇集宝坊。",
        "雪水初融锦江涨，梅花半落绿苔香。",
        "家山松桂年年长，幕府文书日日忙。",
        "自笑余生有几许，一庵僣与得深藏。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 33309,
      "title": "上元前一日",
      "content": [
        "异县客逰久，今年春事迟。",
        "峭寒增酒价，微雨恼灯期。",
        "老态人未觉，孤愁心自知。",
        "停车呼病妇，彊出伴诸儿。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 33310,
      "title": "上元二首  其一",
      "content": [
        "细细香尘暗六街，鱼鳞浅碧暮云开。",
        "新粧褰幕全身见，误马随车一笑回。",
        "酒酽顿忘风力峭，夜长犹恨漏声催。",
        "京华旧侣雕零尽，短鬓成丝心未灰。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 33311,
      "title": "上元二首  其二",
      "content": [
        "病起衰颜非昔红，偷闲聊与少年同。",
        "一规寒玉挂楼角，千点华星来坐中。",
        "久戍遗民虽困弊，承平旧镇尚繁雄。",
        "归时瘦马崔嵬影，定有游人笑此翁。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 33312,
      "title": "喜谭德称归",
      "content": [
        "少鄙章句学，所慕在经世。",
        "诸公荐文章，颇恨非素志。",
        "一朝落江湖，烂漫得自恣。",
        "讨论极王霸，事业窥莘渭。",
        "孔明景略间，却立颇眦睨。",
        "从人无一欣，对食有三喟。",
        "谭侯信豪隽，可共不朽事。",
        "天涯再相见，握手更抆泪。",
        "欲寻西郊路，斗酒倾意气。",
        "浩歌君和我，勿作寻常醉。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 33313,
      "title": "春感",
      "content": [
        "少时狂走西复东，银鞍骏马驰如风。",
        "眼看春去不复惜，只道岁月来无穷。",
        "初逰汉中亦未觉，一饮尚可倾千钟。",
        "义鱼狼藉漾水浊，猎虎蹴蹋南山空。",
        "射堋命中万人看，毬门对植双旗红。",
        "华堂却来弄笔砚，新诗醉草夸坐中。",
        "剑关南山才几日，壮气摧缩成衰翁。",
        "雪霜萧飒已满鬓，蛟龙郁屈空蟠胸。",
        "邻园杏花忽烂漫，推枕彊起随逰蜂。",
        "遶看百匝几叹息，吹红洗绿行匆匆。",
        "莫年逢春尚有几，常恐春去寻无踪。",
        "青钱三百幸可办，且判烂醉酤郫筒。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 33314,
      "title": "春晴暄甚逰西市施家园",
      "content": [
        "税驾名园半日留，逰丝飞蝶晚悠悠。",
        "骤暄不为海棠计，长昼只添鹦鹉愁。",
        "老去自惊诗酒减，客中偏觉岁时遒。",
        "东风好为吹归梦，著我松江弄钓舟。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 33315,
      "title": "花时遍逰诸家园十首  其一",
      "content": [
        "看花南陌复东阡，晓露初干日正妍。",
        "走马碧鸡坊里去，市人唤作海棠颠。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 33316,
      "title": "花时遍逰诸家园十首  其二",
      "content": [
        "为爱名花抵死狂，只愁风日损红芳。",
        "绿章夜奏通明殿，乞借春阴护海棠。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 33317,
      "title": "花时遍逰诸家园十首  其三",
      "content": [
        "翩翩马上帽簷斜，尽日寻春不到家。",
        "偏爱张园好风景，半天高柳卧溪花。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 33318,
      "title": "花时遍逰诸家园十首  其四",
      "content": [
        "花阴扫地置清尊，烂醉归时夜已分。",
        "欲睡未成欹倦枕，轮囷帐底见红云。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 33319,
      "title": "花时遍逰诸家园十首  其五",
      "content": [
        "宣华无树著啼莺，惟有摩诃春水生。",
        "故老能言当日事，直将宫锦裹宫城。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 33320,
      "title": "花时遍逰诸家园十首  其六",
      "content": [
        "枝上猩猩血未晞，尊前红袖醉成围。",
        "应须直到三更看，画烛如椽为发辉。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 33321,
      "title": "花时遍逰诸家园十首  其七",
      "content": [
        "重蕚丹砂品最高，可怜寂寞弃蓬蒿。",
        "会当车载金钱去，买取春归亦足豪。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 33322,
      "title": "花时遍逰诸家园十首  其八",
      "content": [
        "丝丝红蕚弄春柔，不似疏梅只惯愁。",
        "常恐夜寒花索寞，锦茵银烛按凉州。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 33323,
      "title": "花时遍逰诸家园十首  其九",
      "content": [
        "飞花尽逐五更风，不照先生社酒中。",
        "输与新来双燕子，啣泥犹得带残红。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 33324,
      "title": "花时遍逰诸家园十首  其一○",
      "content": [
        "海棠已过不成春，丝竹凄凉锁暗尘。",
        "眼看燕脂吹作雪，不须零落始愁人。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 33325,
      "title": "晓过万里桥",
      "content": [
        "晓出锦江邉，长桥柳带烟。",
        "豪华行乐地，芳润养花天。",
        "拥路看欹帽，窥门笑坠鞭。",
        "京华归未得，聊此送流年。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 33326,
      "title": "自合江亭涉江至赵园",
      "content": [
        "政为梅花忆两京，海棠又满锦官城。",
        "鸦藏高柳阴初宻，马涉清江水未生。",
        "风掠春衫惊小冷，酒潮玉颊见微頳。",
        "残年飘泊无时了，肠断楼头画角声。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 33327,
      "title": "春晴",
      "content": [
        "一庭舞絮鬭身轻，百尺游丝弄午晴。",
        "静喜香烟萦曲几，卧惊玉子落纹枰。",
        "新春易失遽如许，薄宦忘归何似生。",
        "安得一船东下峡，江南江北听莺声。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 33328,
      "title": "题明皇幸蜀图",
      "content": [
        "天宝政事何披猖，使典相国胡奴王。",
        "弄权杨李不足怪，阿瞒手自裂纪纲。",
        "八姨富贵尚有理，何至诏书褒五郎。",
        "卢龙贼骑已汹汹，丹鳯神语犹琅琅。",
        "人知大势危絫卵，天稔奇祸如崩墙。",
        "台省诸公独耐事，歌咏功德卑虞唐。",
        "一朝杀气横天末，疋马西奔几不脱。",
        "向来谄子知几人，贼前称臣草间活。",
        "剑南万里望秦天，行殿春寒闻杜鹘。",
        "老臣九龄不可作，鱼蠧蛛丝金鉴篇。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 33329,
      "title": "春寒连日不出",
      "content": [
        "海棠花入燕泥干，梅子枝头已带酸。",
        "老去懒寻年少梦，舂分不减社前寒。",
        "著书敢望垂千载，嗜酒犹须隐一官。",
        "正是闲时无客过，小庭斜日倚阑干。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 33330,
      "title": "马上偶成",
      "content": [
        "城南城北紫游缰，尽日闲行看似忙。",
        "刺水离离葛叶短，连村漠漠豆花香。",
        "夕阳有信催残角，春草无情上缭墙。",
        "我亦人间倦逰者，长吟聊复怆兴亡。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 33331,
      "title": "夜宴",
      "content": [
        "酒浪摇春不受寒，烛花垂烬忽堆盘。",
        "山川路邈人将老，丝管声遒夜向阑。",
        "四海交朋更聚散，百年光景杂悲欢。",
        "自怜病眼犹明在，更把名花半醉看。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 33332,
      "title": "观音院读壁间蘓在廷少卿两小诗次韵二首  其一",
      "content": [
        "扬鞭暮出锦官城，小院无僧有月明。",
        "不信道人心似鐡，隔城犹送捣衣声。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 33333,
      "title": "观音院读壁间蘓在廷少卿两小诗次韵二首  其二",
      "content": [
        "老去痴顽不受镌，姓名身后更须传。",
        "世间商略无归处，只合长斋绣佛前。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 33334,
      "title": "锦亭",
      "content": [
        "天公为我齿頬计，遣饫黄甘与丹荔。",
        "又怜狂眼老更狂，令看广陵芍药蜀海棠。",
        "周行万里逐所乐，天公于我元不薄。",
        "贵人不出长安城，宝带华缨真汝䌸。",
        "乐哉今从石湖公，大度不计聋承聋。",
        "夜宴新亭海棠底，红云倒吸玻璃钟。",
        "琵琶弦繁腰鼓急，盘鳯舞衫香雾湿。",
        "春醪凸盏烛光摇，素月中天花影立。",
        "逰人如云环玉帐，诗未落纸先传唱。",
        "此邦句律方一新，鳯阁舍人今有様。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 33335,
      "title": "晚起",
      "content": [
        "新晴窗日弄春妍，幌小屏深意自便。",
        "长恨病多妨痛饮，却缘客少得安眠。",
        "雏莺故故啼簷角，飞絮翩翩堕枕前。",
        "欲著衣裳还孏起，重寻残梦一悠然。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 33336,
      "title": "雨",
      "content": [
        "映空初作茧丝微，掠地俄成箭镞飞。",
        "纸帐光迟饶晓梦，铜𬬻香润覆春衣。",
        "池鱼鱍鱍随沟出，梁燕翩翩接翅归。",
        "惟有落花吹不去，数枝红湿自相依。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 33337,
      "title": "春晚书怀",
      "content": [
        "万里西逰为覔诗，锦城更付一官痴。",
        "脱巾漉酒从人笑，拄笏看山颇自奇。",
        "疏雨池塘鱼避钓，晓莺窗户客争棋。",
        "老来怕与春为别，醉过残红满地时。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 33338,
      "title": "出朝天门缭长堤至刘侍郎庙由小西门归",
      "content": [
        "晓从北郭过西城，十里沙堤似席平。",
        "澹日向人供帽影，微风傍马助鞭声。",
        "欢情寂寂随年减，俗事纷纷逐日生。",
        "到处每求佳水竹，晚途牢落念归耕。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 33339,
      "title": "夜分读书有感",
      "content": [
        "光阴百岁已中分，拟结茅茨老白云。",
        "万里谁怜新卧疾，九重犹记旧能文。",
        "枕邉得句题屏叠，马上看山隔帽裙。",
        "终恨无劳縻廪粟，夜窗聊策读书勲。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 33340,
      "title": "中夜闻大雷雨",
      "content": [
        "雷车驾雨龙尽起，电行半空如狂矢。",
        "中原战争五十年，上帝震怒初一洗。",
        "黄头女真褫魂魄，面䌸军门争请死。",
        "已闻三箭定天山，何啻积甲齐熊耳。",
        "捷书驰骑奏行宫，近臣上寿天颜喜。",
        "合门明日催贺班，云集千官摩剑履。",
        "长安父老请移跸，愿见六龙临渭水。",
        "从今身是太平人，敢惮安西九千里。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 33341,
      "title": "春残",
      "content": [
        "石镜山前送落晖，春残回首倍依依。",
        "时平壮士无功老，乡远征人有梦归。",
        "苜蓿苗侵官道合，芜菁花入麦畦稀。",
        "倦逰自笑摧頺甚，谁记飞鹰醉打围。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 33342,
      "title": "武担东台晚望",
      "content": [
        "憔悴西窗已一翁，登高意气尚豪雄。",
        "关河覇国兴亡后，风月诗人醉醒中。",
        "病起顿惊双鬓改，春归一扫万花空。",
        "栏邉徙倚君知否，直到吴天目未穷。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 33343,
      "title": "行武担西南村落有感",
      "content": [
        "骑马悠然欲断魂，春愁满眼与谁论。",
        "市朝迁变归芜没，磵谷谺谺互吐吞。",
        "一径松楠遥见寺，数家鸡犬自成村。",
        "最怜高冢临官道，细细烟莎遍焼痕。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 33344,
      "title": "小饮房园",
      "content": [
        "宦逰到处即忘家，况得闲身管物华。",
        "疏索故人缘病酒，折除厚禄为看花。",
        "泥新高栋初巢燕，萍匝荒池已集蛙。",
        "斟酌人生要行乐，灯前起舞落乌纱。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 33345,
      "title": "饭昭觉寺抵暮乃归",
      "content": [
        "身堕黄尘每慨然，携儿萧散亦前缘。",
        "聊凭方外巾盂净，一洗人间匕箸膻。",
        "静院春风传浴鼓，画廊晚雨湿茶烟。",
        "濳光寮里明窗下，借我消摇过十年。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 33346,
      "title": "自芳华楼过瑶林庄",
      "content": [
        "春晚江邉草过腰，雨余楼下水平桥。",
        "名花未落如相待，佳客能来不费招。",
        "栏角峭风罗袖薄，柳阴斜日玉骢骄。",
        "此身醉死元关命，敢笑闻鸡趁早朝。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 33347,
      "title": "书怀",
      "content": [
        "诗不能工浪得穷，几年衮衮看诸公。",
        "摧頺已作骥伏枥，留滞敢嫌船逆风。",
        "消日剧棋疏竹下，送春烂醉乱花中。",
        "倚楼看镜俱痴绝，赢取烟蓑伴钓翁。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 33348,
      "title": "逰东郭赵氏园",
      "content": [
        "清晨呼马出，驭吏请所之。",
        "锦城浩如海，我亦无与期。",
        "有花即入门，莫问主人谁。",
        "下马据胡床，傲睨忘诃讥。",
        "人言白头翁，胡为尚儿痴。",
        "老翁故不痴，借花发吾诗。",
        "诗句带花香，东风不敢吹。",
        "徘徊双蛱蝶，许汝鼻端知。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 33349,
      "title": "卜居二首  其一",
      "content": [
        "歴尽人间行路难，老来要覔数年闲。",
        "供家米少因添鹤，买宅钱多为见山。",
        "池靣纹生风细细，花根土润雨斑斑。",
        "借舂乞火依邻里，剩酿村醪约往还。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 33350,
      "title": "卜居二首  其二",
      "content": [
        "南浮七泽吊沉湘，西溯三巴掠夜郎。",
        "自信前缘与人薄，每求寛地寄吾狂。",
        "雪山水作中泠味，蒙顶茶如正焙香。",
        "傥有把茅端可老，不须辛苦念还乡。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 33351,
      "title": "马上",
      "content": [
        "春残马上意伥伥，纵辔微吟过数坊。",
        "绿树成帷连药市，清流如带绕毬场。",
        "城荒鼓角增悲壮，苑废云烟尚莽苍。",
        "堪笑年来向诗懒，还家古锦只空囊。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 33352,
      "title": "夜登江楼",
      "content": [
        "平生胸中无滞留，旷然独与造物逰。",
        "天风驾我周宇县，夜半忽过江邉楼。",
        "楼前茫茫天地濶，万顷月浸空江秋。",
        "云阶无尘鸾鹤舞，玉笛裂石鱼龙愁。",
        "肺肝澄澈纳灏气，毛发惨栗临寒流。",
        "世间回首真一梦，谁能更念酬恩雠。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 33353,
      "title": "书叹",
      "content": [
        "早得虚名翰墨林，谢归忽已岁时侵。",
        "春郊射雉朝盘马，秋院焚香夜弄琴。",
        "病酒闭门常兀兀，哦诗袖手久愔愔。",
        "浮沉不是忘经世，后有仁人识此心。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 33354,
      "title": "三月一日府宴学射山",
      "content": [
        "北出升仙路少东，据鞍自笑老从戎。",
        "百年身世酣歌里，千古功名感慨中。",
        "天远仅分山髣髴，雾收初见日曈昽。",
        "横空我欲江湖去，谁借泠然御寇风。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 33355,
      "title": "对酒",
      "content": [
        "闲愁如飞雪，入酒即消融。",
        "好花如故人，一笑杯自空。",
        "流莺有情亦念我，柳邉尽日啼春风。",
        "长安不到十四载，酒徒往往成衰翁。",
        "九环宝带光照地，不如留君双颊红。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 33356,
      "title": "题直舍壁",
      "content": [
        "文书那得废哦诗，羞作群儿了事痴。",
        "付与后人评此老，一丘一壑过元规。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 33357,
      "title": "逰圜觉干明祥符三院至暮",
      "content": [
        "成都再见春事残，虽名闲官实不闲。",
        "门前车马閙如市，案上文檄高于山。",
        "有时投罅輙径出，略似齐客偷秦关。",
        "日斜仆夫已整驾，顾景欲驻愁嘲讪。",
        "岂知今朝有此乐，放浪一笑开衰颜。",
        "抽身黄尘乌帽底，得意翠木清泉间。",
        "褰裳危磴穷荦确，洗耳古涧听淙潺。",
        "岂惟顿觉宇宙广，政尔一散腰脚顽。",
        "似闻青城缥缈处，待我归缀仙官班。",
        "俊鹰解绦即万里，岂比倦翼方知还。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 33358,
      "title": "逰合江园戏题",
      "content": [
        "朱朱白白池台间，好风妍日开未残。",
        "我来覔醉苦草草，常恨不如花意闲。",
        "山鸡飞起乱花落，下上青林穿翠壑。",
        "世间动步即有拘，常恨不如禽意乐。",
        "人言功名恐不免，我愿徜徉娱岁晚。",
        "熟计滛书理白鱼，何如纵猎牵黄犬。",
        "成都四郊如砥平，安得双鞬驰出城。",
        "鞚飞尘起望不见，从骑寻我鸣鹘声。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 33359,
      "title": "三月十六日作",
      "content": [
        "石笋街西风景幽，醉眠万事付悠悠。",
        "倦逰我已七年客，促驾春无三日留。",
        "枝上蝶稀红药老，舍中蚕起绿桑柔。",
        "功名堕甑谁能问，羞作饥鹰夜掣鞲。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 33360,
      "title": "食荠三首  其一",
      "content": [
        "日日思归饱蕨薇，春来荠美忽忘归。",
        "传夸真欲嫌荼苦，自笑何时得瓠肥。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 33361,
      "title": "食荠三首  其二",
      "content": [
        "采采珍蔬不待畦，中原正味压莼丝。",
        "桃根择叶无虚日，直到开花如雪时。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 33362,
      "title": "食荠三首  其三",
      "content": [
        "小著盐醯助滋味，微加姜桂发精神。",
        "风炉歙钵穷家活，妙诀何曾肻授人。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 33363,
      "title": "次韵范文渊",
      "content": [
        "箪瓢气已压膏梁，不傍朱门味更长。",
        "细看高人忘宠辱，始知吾辈可怜伤。",
        "岩扃勾漏新丹灶，香火匡庐古道场。",
        "剩欲与君坚此约，它年八十鬓眉苍。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 33364,
      "title": "题醉中所作草书卷后",
      "content": [
        "胸中磊落藏五兵，欲试无路空峥嵘。",
        "酒为旗鼓笔刀槊，势从天落银河倾。",
        "端溪石池浓作墨，烛光相射飞纵横。",
        "须臾收卷复把酒，如见万里烟尘清。",
        "丈夫身在要有立，逆虏运尽行当平。",
        "何时夜出五原塞，不闻人语闻鞭声。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 33365,
      "title": "登子城新楼遍至西园池亭",
      "content": [
        "狂夫无计奈狂何，何况登临逸兴多。",
        "千叠雪山连滴博，一支春水入摩诃。",
        "吟余骑省霜侵鬓，钓罢玄真雨满蓑。",
        "逐冦榆关期尚远，不妨随处得婆娑。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 33366,
      "title": "小疾谢客",
      "content": [
        "小疾深居不唤医，消摇更觉胜平时。",
        "痴人未害看周易，名士真须读楚辞。",
        "绿径风斜花片片，画廊人静雨丝丝。",
        "晚来顿觉清羸甚，自置篝炉煮粟糜。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 33367,
      "title": "归耕",
      "content": [
        "随牒人间鬓欲疏，归耕且复补东隅。",
        "甑炊地碓新舂米，衣拆天吴旧绣图。",
        "有圃免烦官送菜，叩门翻喜吏徴租。",
        "不愁问字无来客，惟欠扬雄宅一区。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 33368,
      "title": "闻孙岩老挂冠叹仰之余輙赋长句",
      "content": [
        "圣贤在世龙行天，出处何至为物牵。",
        "后人竞作驹伏辕，未死奄奄如九泉。",
        "郫孙公者山泽僊，巉岩玉骨寒入肩。",
        "哦诗调苦乱嘒蝉，燥墨瘦字丑不妍。",
        "诸公好之挽使前，六丁力尽山嶷然。",
        "奏书告老不待年，脱手径上岷山巅。",
        "吾侪一官自纠纒，俛首鞭箠不自怜。",
        "强欲作诗诵公贤，事伟辞卑难竝传。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 33369,
      "title": "松骥行",
      "content": [
        "骥行千里亦何得，垂首伏枥终自伤。",
        "松阅千年弃涧壑，不如杀身扶明堂。",
        "士生抱材愿少试，誓取燕赵归君王。",
        "闭门高卧身欲老，闻鸡相蹴涕数行。",
        "正令吚嘤死床箦，岂若横身当战场。",
        "半酣浩歌声激烈，车轮百转盘愁肠。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 33370,
      "title": "遣兴",
      "content": [
        "鹤料无多又扫空，今年真是浣花翁。",
        "放教绿酒关身事，留得朱颜在镜中。",
        "挟弹园林芳径雨，投竿窗槛小溪风。",
        "痴顽自笑归何日，家在东吴更向东。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 33371,
      "title": "野意",
      "content": [
        "小东门外曵笻枝，白葛乌纱自一奇。",
        "闲客逍遥无吏责，茂阴清润胜花时。",
        "茶经每向僧窗读，菰米仍于野艇炊。",
        "便觉眼邉归路近，镜湖禹庙见参差。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 33372,
      "title": "雨中登安福寺塔",
      "content": [
        "平生喜登高，醉眼无疆界。",
        "北顾极幽并，东望夸海岱。",
        "喟然抚手叹，从古几成败。",
        "英雄如过鸟，城郭但遗块。",
        "今朝上黑塔，千里旷无碍。",
        "忽惊风霆掣，坐觉天地晦。",
        "急雨挟龙腥，溽暑为摧壊。",
        "皇天念蟠郁，令我寄一快。",
        "那知书生狂，自倚心眼大。",
        "更思驻潼关，黄河看如带。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    }
  ],
