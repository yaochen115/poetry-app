      }
    },
    {
      "id": 344304,
      "title": "赴章陵酬李卿赠别",
      "content": [
        "一官叨下秩，九棘谢知音。",
        "芳草文园路，春愁满别心。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 344308,
      "title": "宿洞口馆",
      "content": [
        "野竹通溪冷，秋泉入户鸣。",
        "乱来人不到，芳草上阶生。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 344309,
      "title": "九日寄侄箊箕等",
      "content": [
        "采菊偏相忆，传香寄便风。",
        "今朝竹林下，莫使桂尊空。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 344312,
      "title": "蓝田溪杂咏二十二首：登台",
      "content": [
        "望山登春台，目尽趣难极。",
        "晚景下平阡，花际霞峰色。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 344313,
      "title": "蓝田溪杂咏二十二首：板桥",
      "content": [
        "静宜樵隐度，远与车马隔。",
        "有时行药来，喜遇归山客。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 344314,
      "title": "蓝田溪杂咏二十二首：石井",
      "content": [
        "片霞照仙井，泉底桃花红。",
        "那知幽石下，不与武陵通。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 344315,
      "title": "蓝田溪杂咏二十二首：古藤",
      "content": [
        "引蔓出云树，垂纶覆巢鹤。",
        "幽人对酒时，苔上闲花落。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 344316,
      "title": "蓝田溪杂咏二十二首：晚归鹭",
      "content": [
        "池上静难厌，云间欲去晚。",
        "忽背夕阳飞，乘兴清风远。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 344317,
      "title": "蓝田溪杂咏二十二首：洞仙谣",
      "content": [
        "几转到青山，数重度流水。",
        "秦人入云去，知向桃源里。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 344318,
      "title": "蓝田溪杂咏二十二首：药圃",
      "content": [
        "春畦生百药，花叶香初霁。",
        "好容似风光，偏来入丛蕙。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 344319,
      "title": "蓝田溪杂咏二十二首：石上苔",
      "content": [
        "净与溪色连，幽宜松雨滴。",
        "谁知古石上，不染世人迹。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 344320,
      "title": "蓝田溪杂咏二十二首：窗里山",
      "content": [
        "远岫见如近，千里一窗里。",
        "坐来石上云，乍谓壶中起。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 344321,
      "title": "蓝田溪杂咏二十二首：竹间路",
      "content": [
        "暗归草堂静，半入花园去。",
        "有时载酒来，不与清风遇。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 344322,
      "title": "蓝田溪杂咏二十二首：竹屿",
      "content": [
        "幽鸟清涟上，兴来看不足。",
        "新篁压水低，昨夜鸳鸯宿。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 344323,
      "title": "蓝田溪杂咏二十二首：砌下泉",
      "content": [
        "穿云来自远，激砌流偏驶。",
        "能资庭户幽，更引海禽至。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 344324,
      "title": "蓝田溪杂咏二十二首：戏鸥",
      "content": [
        "乍依菱蔓聚，尽向芦花灭。",
        "更喜好风来，数片翻晴雪。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 344325,
      "title": "蓝田溪杂咏二十二首：远山钟",
      "content": [
        "风送出山钟，云霞度水浅。",
        "欲知声尽处，鸟灭寥天远。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 344326,
      "title": "蓝田溪杂咏二十二首：东陂",
      "content": [
        "永日兴难望，掇芳春陂曲。",
        "新晴花枝下，爱此苔水绿。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 344327,
      "title": "蓝田溪杂咏二十二首：池上亭",
      "content": [
        "临池构杏梁，待客归烟塘。",
        "水上褰帘好，莲开杜若香。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 344328,
      "title": "蓝田溪杂咏二十二首：衔鱼翠鸟",
      "content": [
        "有意莲叶间，瞥然下高树。",
        "擘波得潜鱼，一点翠光去。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 344329,
      "title": "蓝田溪杂咏二十二首：石莲花",
      "content": [
        "幽石生芙蓉，百花惭美色。",
        "远笑越溪女，闻芳不可识。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 344330,
      "title": "蓝田溪杂咏二十二首：潺湲声",
      "content": [
        "乱石跳素波，寒声闻几处。",
        "飕飕暝风引，散出空林去。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 344331,
      "title": "蓝田溪杂咏二十二首：松下雪",
      "content": [
        "虽因朔风至，不向瑶台侧。",
        "唯助苦寒松，偏明后凋色。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 344332,
      "title": "蓝田溪杂咏二十二首：田鹤",
      "content": [
        "田鹤望碧霄，舞风亦自举。",
        "单飞后片雪，早晚及前侣。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 344333,
      "title": "蓝田溪杂咏二十二首：题南陂",
      "content": [
        "家住凤城南，门临古陂曲。",
        "时怜上林雁，半入池塘宿。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 344334,
      "title": "蓝田溪杂咏二十二首：伤秋",
      "content": [
        "岁去人头白，秋来树叶黄。",
        "搔头向黄叶，与尔共悲伤。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 344336,
      "title": "题礼上人壁画山水",
      "content": [
        "连山画出映禅扉，粉壁香筵满翠微。",
        "坐来炉气萦空散，共指晴云向岭归。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 344337,
      "title": "送欧阳子还江华郡",
      "content": [
        "江华胜事接湘滨，千里湖山入兴新。",
        "才子思归催去棹，汀花且为驻残春。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 344339,
      "title": "访李卿不遇",
      "content": [
        "画戟朱楼映晚霞，高梧寒柳度飞鸦。",
        "门前不见归轩至，城上愁看落日斜。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 344340,
      "title": "与赵莒茶宴",
      "content": [
        "竹下忘言对紫茶，全胜羽客醉流霞。",
        "尘心洗尽兴难尽，一树蝉声片影斜。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 344341,
      "title": "故王维右丞堂前芍药花开，凄然感怀",
      "content": [
        "芍药花开出旧栏，春衫掩泪再来看。",
        "主人不在花长在，更胜青松守岁寒。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    }
  ],
