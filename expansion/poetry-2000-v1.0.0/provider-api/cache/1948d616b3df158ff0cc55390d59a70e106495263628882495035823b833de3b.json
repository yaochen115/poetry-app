{
  "data": [
    {
      "id": 344215,
      "title": "奉和王相公秋日戏赠元校书",
      "content": [
        "才妙心仍远，名疏迹可追。",
        "清秋闻礼暇，新雨到山时。",
        "胜事唯愁尽，幽寻不厌迟。",
        "弄云怜鹤去，隔水许僧期。",
        "贤相敦高躅，雕龙忆所思。",
        "芙蓉洗清露，愿比谢公诗。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 344216,
      "title": "过杨驸马亭子",
      "content": [
        "衣冠在汉庭，台榭接天成。",
        "彩凤翻箫曲，祥鳣入馆名。",
        "歌钟芳月曙，林嶂碧云生。",
        "乱水归潭净，高花映竹明。",
        "退朝追宴乐，开阁醉簪缨。",
        "长袖留嘉客，栖乌下禁城。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 344218,
      "title": "晚出青门望终南别业",
      "content": [
        "能清谢脁思，暂下承明庐。",
        "远山新水下，寒皋微雨余。",
        "更怜归鸟去，宛到卧龙居。",
        "笑指丛林上，闲云自卷舒。",
        "宁心鸣凤日，却意钓璜初。",
        "处贵有余兴，伊周位不如。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 344221,
      "title": "过王舍人宅",
      "content": [
        "入门花柳暗，知是近臣居。",
        "大隐心何远，高风物自疏。",
        "翛然静者事，宛得上皇余。",
        "鸡犬偷仙药，儿童授道书。",
        "清吟送客后，微月上城初。",
        "彩笔有新咏，文星垂太虚。",
        "承恩金殿宿，应荐马相如。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 344224,
      "title": "和韦侍御寓直对雨",
      "content": [
        "名贵四科首，班宜二妙齐。",
        "如何厌白简，未得步金闺。",
        "寓直晦秋雨，吟余闻远鸡。",
        "漏声过旦冷，云色向窗低。",
        "谁谓霄汉近，翻嗟心事暌。",
        "兰滋人未握，霜晓鹗还栖。",
        "伫见田郎字，亲劳御笔题。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 344225,
      "title": "奉和圣制登朝元阁",
      "content": [
        "六合纡玄览，重轩启上清。",
        "石林飞栋出，霞顶泰阶平。",
        "拂曙銮舆上，晞阳瑞雪晴。",
        "翠微回日驭，丹𪩘驻天行。",
        "御气升银汉，垂衣俯锦城。",
        "山通玉苑迥，河抱紫关明。",
        "感物干文动，凝神道化成。",
        "周王陟乔岳，列辟让英声。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 344226,
      "title": "奉和杜相公移长兴宅，奉呈元相公",
      "content": [
        "守贵常思俭，平津此意深。",
        "能卑丞相宅，何谢故人心。",
        "种蕙初抽带，移篁不改阴。",
        "院梅朝助鼎，池凤夕归林。",
        "觉路经中得，沧洲梦里寻。",
        "道高仍济代，恩重岂投簪。",
        "报国谁知己，推贤共作霖。",
        "兴来文雅振，清韵掷双金。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 344228,
      "title": "送外甥怀素上人归乡侍奉",
      "content": [
        "释子吾家宝，神清慧有余。",
        "能翻梵王字，妙尽伯英书。",
        "远鹤无前侣，孤云寄太虚。",
        "狂来轻世界，醉里得真如。",
        "飞锡离乡久，宁亲喜腊初。",
        "故池残雪满，寒柳霁烟疏。",
        "寿酒还尝药，晨餐不荐鱼。",
        "遥知禅诵外，健笔赋闲居。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 344230,
      "title": "送王相公赴范阳",
      "content": [
        "翊圣衔恩重，频年按节行。",
        "安危皆报国，文武不缘名。",
        "受脤仍调鼎，为霖更洗兵。",
        "幕开丞相阁，旗总贰师营。",
        "料敌知无战，安边示有征。",
        "代云横马首，燕雁拂笳声。",
        "去镇关河静，归看日月明。",
        "欲知瞻恋切，迟暮一书生。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 344232,
      "title": "送李兵曹赴河中",
      "content": [
        "能荷钟鼎业，不矜纨绮荣。",
        "侯门三事后，儒服一书生。",
        "昔志学文史，立身为士英。",
        "骊珠难隐耀，皋鹤会长鸣。",
        "休命且随牒，候时常振缨。",
        "寒蝉思关柳，匹马向蒲城。",
        "秋日黯将暮，黄河如欲清。",
        "黎人思坐啸，知子树佳声。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 344233,
      "title": "罢官后酬元校书见赠",
      "content": [
        "心期怅已阻，交道复何如。",
        "自我辞丹阙，惟君到故庐。",
        "忘机贫负米，忆戴出无车。",
        "怜犬吠初服，家人愁斗储。",
        "秋堂入闲夜，云月思离居。",
        "穷巷闻砧冷，荒枝应鹊疏。",
        "宦名随落叶，生事感枯鱼。",
        "临水仍挥手，知音未弃余。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 344235,
      "title": "新丰主人",
      "content": [
        "明代少知己，夜光频暗投。",
        "迍邅终薄命，动息尽穷愁。",
        "自欲归飞鹢，当为不系舟。",
        "双垂素丝泪，几弊皂貂裘。",
        "暮鸟栖幽树，孤云出旧丘。",
        "蛩悲衣褐夕，雨暗转蓬秋。",
        "客里冯谖剑，歌中宁戚牛。",
        "主人能纵酒，一醉且忘忧。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 344237,
      "title": "陪郭常侍令公东亭宴集",
      "content": [
        "盛业山河列，重名剑履荣。",
        "珥貂为相子，开阁引时英。",
        "美景池台色，佳期宴赏情。",
        "词人载笔至，仙妓出花迎。",
        "暗竹朱轮转，回塘玉佩鸣。",
        "舞衫招戏蝶，歌扇隔啼莺。",
        "饮德心皆醉，披云兴转清。",
        "不愁欢乐尽，积庆在和羹。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 344238,
      "title": "太子李舍人城东别业与二三文友逃暑",
      "content": [
        "下马失炎暑，重门深绿篁。",
        "宫臣礼嘉客，林表开兰堂。",
        "兹夕兴难尽，澄罍照墨场。",
        "鲜风吹印绶，密坐皆馨香。",
        "美景惜文会，清吟迟羽觞。",
        "东林晚来好，目极趣何长。",
        "鸟道挂疏雨，人家残夕阳。",
        "城隅拥归骑，留醉恋琼芳。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 344240,
      "title": "赠李十六",
      "content": [
        "半面喜投分，数年钦盛名。",
        "常思梦颜色，谁忆访柴荆。",
        "忽听款扉响，欣然倒屣迎。",
        "蓬蒿驻驺驭，鸡犬傍簪缨。",
        "酌水即嘉宴，新知甚故情。",
        "仆夫视日色，栖鸟催车声。",
        "自尔宴言后，至今门馆清。",
        "何当更乘兴，林下已苔生。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 344241,
      "title": "裴仆射东亭",
      "content": [
        "凤扆任匡济，云溪难退还。",
        "致君超列辟，得道在荣班。",
        "朱戟缭垣下，高斋芳树间。",
        "隔花开远水，废卷爱晴山。",
        "晚沐值清兴，知音同解颜。",
        "藉兰开赐酒，留客下重关。",
        "仙犬逐人静，朝车映竹闲。",
        "则知真隐逸，未必谢区寰。",
        "轩后三朝顾，赤松何足攀。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 344242,
      "title": "中书王舍人辋川旧居",
      "content": [
        "几年家绝壑，满径种芳兰。",
        "带石买松贵，通溪涨水宽。",
        "诵经连谷响，吹律减云寒。",
        "谁谓桃源里，天书问考盘。",
        "一从解蕙带，三入偶蝉冠。",
        "今夕复何夕，归休寻旧欢。",
        "片云隔苍翠，春雨半林湍。",
        "藤长穿松盖，花繁压药栏。",
        "景深青眼下，兴绝彩毫端。",
        "笑向同来客，登龙此地难。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 344243,
      "title": "送襄阳卢判官奏开河事",
      "content": [
        "千里趋魏阙，一言简圣聪。",
        "河流引关外，国用赡秦中。",
        "有诏许其策，随山兴此功。",
        "连云积石阻，计日安波通。",
        "飞棹转年谷，利人胜岁丰。",
        "言归汉阳路，拜手蓬莱宫。",
        "紫殿赐衣出，青门酣酌同。",
        "晚阳过微雨，秋水见新鸿。",
        "坐惜去车远，愁看离馆空。",
        "因思郢川守，南楚满清风。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 344245,
      "title": "奉和中书常舍人晚秋集贤院即事寄徐薛二侍御",
      "content": [
        "文星垂太虚，辞伯综群书。",
        "彩笔下鸳掖，褒衣来石渠。",
        "典坟探奥旨，造化睹权舆。",
        "述圣鲁宣父，通经汉仲舒。",
        "窗明宜缥带，地肃近丹除。",
        "清昼删诗暇，高秋作赋初。",
        "露盘侵汉耸，宫柳度鸦疏。",
        "静对连云阁，晴闻过阙车。",
        "旧僚云出矣，晚岁复何如。",
        "海峤瞻归路，江城梦直庐。",
        "含毫思两凤，望远寄双鱼。",
        "定笑巴歌拙，还参丽曲余。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 344246,
      "title": "和范郎中宿直中书，晓玩清池，赠南省同僚两垣遗补",
      "content": [
        "青琐留才子，春池静禁林。",
        "自矜仙岛胜，宛在掖垣深。",
        "引派彤庭里，含虚玉砌阴。",
        "涨来知圣泽，清处见天心。",
        "兰气飘红岸，文星动碧浔。",
        "凤栖长近日，虬卧欲为霖。",
        "席宠虽高位，流谦乃素襟。",
        "焚香春漏尽，假寐晓莺吟。",
        "丹地宜清泚，朝阳复照临。",
        "司言兼逸趣，鼓兴接知音。",
        "六义惊摛藻，三台响掷金。",
        "为怜风水外，落羽此漂沉。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 344247,
      "title": "同程九早入中书",
      "content": [
        "汉家贤相重英奇，蟠木何材也见知。",
        "不意云霄能自致，",
        "独惭皇鉴明如日，未厌春光向玉墀。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 344248,
      "title": "仲春宴王补阙城东小池",
      "content": [
        "王孙兴至幽寻好，芳草春深景气和。",
        "药院爱随流水入，",
        "醉来倚玉无余事，目送归鸿笑复歌。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 344249,
      "title": "夜宿灵台寺寄郎士元",
      "content": [
        "西日横山含碧空，东方吐月满禅宫。",
        "朝瞻双顶青冥上，",
        "万里故人能尚尔，知君视听我心同。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 344250,
      "title": "题郎士元半日吴村别业，兼呈李长官",
      "content": [
        "半日吴村带晚霞，闲门高柳乱飞鸦。",
        "横云岭外千重树，",
        "自叹梅生头似雪，却怜潘令县如花。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 344251,
      "title": "猷川雪后送僧粲临还京，时避世卧疾",
      "content": [
        "连步青溪几万重，有时共立在孤峰。",
        "斋到盂空餐雪麦，",
        "回望群山携手处，离心一一涕无从。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 344252,
      "title": "和李员外扈驾幸温泉宫",
      "content": [
        "未央月晓度疏钟，凤辇时巡出九重。",
        "雪霁山门迎瑞日，",
        "遥羡枚皋扈仙跸，偏承霄汉渥恩浓。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 344253,
      "title": "长信怨",
      "content": [
        "长信萤来一叶秋，蛾眉泪尽九重幽。",
        "𫛛鹊观前明月度，",
        "谁分昭阳夜歌舞，君王玉辇正淹留。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 344254,
      "title": "送河南陆少府",
      "content": [
        "云间陆生美且奇，银章朱绶映金羁。",
        "自料抱材将致远，",
        "朝夕诏书还柏署，行看飞隼集高枝。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 344255,
      "title": "送李评事赴潭州使幕",
      "content": [
        "湖南远去有余情，苹叶初齐白芷生。",
        "谩说简书催物役，",
        "幕下由来贵无事，伫闻谈笑静黎氓。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 344256,
      "title": "送李九贬南阳",
      "content": [
        "玉柱金罍醉不欢，云山驿道向东看，鸿声断续暮天远，",
        "秋来回首君门阻，马上应歌行路难。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 344257,
      "title": "送裴頔侍御使蜀",
      "content": [
        "柱史才年四十强，须髯玄发美清扬。",
        "朝天绣服乘恩贵，",
        "多才自有云霄望，计日应追鸳鹭行。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 344258,
      "title": "送韦信爱子归觐",
      "content": [
        "离舟解缆到斜晖，春水东流燕北飞。",
        "才子学诗趋露冕，",
        "借问还珠盈合浦，何如鲤也入庭闱。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 344259,
      "title": "送兴平王少府游梁",
      "content": [
        "旧识相逢情更亲，攀欢甚少怆离频。",
        "黄绶罢来多远客，",
        "梁国遗风重词赋，诸侯应念马卿贫。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 344260,
      "title": "送张员外出牧岳州",
      "content": [
        "凤凰衔诏与何人，喜政多才宠寇恂。",
        "台上鸳鸾争送远，",
        "应笑冯唐衰且拙，世情相见白头新。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 344261,
      "title": "送孙十尉温县",
      "content": [
        "飞花落絮满河桥，千里伤心送客遥。",
        "不惜芸香染黄绶，",
        "急管繁弦催一醉，颓阳不驻引征镳。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 344262,
      "title": "送钟评事应宏词下第东归",
      "content": [
        "芳岁归人嗟转蓬，含情回首灞陵东。",
        "蛾眉不入秦台镜，",
        "劝君稍尽离筵酒，千里佳期难再同。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 344263,
      "title": "送严维尉河南",
      "content": [
        "蕙叶青青花乱开，少年趋府下蓬莱。",
        "甘泉未献扬雄赋，",
        "欲知别后相思处，愿植琼枝向柏台。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 344264,
      "title": "送马员外拜官觐省",
      "content": [
        "二十为郎事汉文，鸳雏骥子自为群。",
        "笔精已许台中妙，",
        "莫言来往朝天远，看取鸣鞘入断云。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 344265,
      "title": "送冷朝阳擢第后归金陵觐省",
      "content": [
        "莱子昼归今始好，潘园景色夏偏浓。",
        "夕阳流水吟诗去，",
        "佳期少别俄千里，云树愁看过几重。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 344266,
      "title": "九日宴浙江西亭",
      "content": [
        "诗人九日怜芳菊，筵客高斋宴浙江。",
        "渔浦浪花摇素壁，",
        "四子醉时争讲习，笑论黄霸旧为邦。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 344267,
      "title": "和王员外雪晴早朝",
      "content": [
        "紫微晴雪带恩光，绕仗偏随鸳鹭行。",
        "长信月留宁避晓，",
        "题柱盛名兼绝唱，风流谁继汉田郎。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 344268,
      "title": "避暑纳凉",
      "content": [
        "木槿花开畏日长，时摇轻扇倚绳床。",
        "初晴草蔓缘新笋，",
        "无事始然知静胜，深垂纱帐咏沧浪。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 344269,
      "title": "早夏",
      "content": [
        "楚狂身世恨情多，似病如忧正是魔，花萼败春多寂寞，",
        "军旅阅诗裁不得，可怜风景遣如何。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 344270,
      "title": "题嵩阳焦道士石壁",
      "content": [
        "三峰花畔碧堂悬，锦里真人此得仙。",
        "玉体才飞西蜀雨，",
        "幸入桃源因去世，方期丹诀一延年。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 344271,
      "title": "题延州圣僧穴",
      "content": [
        "定力无涯不可称，未知何代坐禅僧。",
        "默默山门宵闭月，",
        "昔日舍身缘救鸽，今时出见有飞鹰。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 344272,
      "title": "乐游原晴望上中书李侍郎",
      "content": [
        "爽气朝来万里清，凭高一望九秋轻。",
        "不知凤沼霖初霁，"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 344273,
      "title": "幽居春暮书怀",
      "content": [
        "自哂鄙夫多野性，贫居数亩半临湍。",
        "溪云杂雨来茅屋，",
        "更怜童子宜春服，花里寻师指杏坛。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 344274,
      "title": "谒许由庙",
      "content": [
        "故向箕山访许由，林泉物外自清幽。",
        "松上挂瓢枝几变，",
        "缅想古人增叹惜，飒然云树满岩秋。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 344275,
      "title": "过张成侍御宅",
      "content": [
        "丞相幕中题凤人，文章心事每相亲。",
        "从军谁谓仲宣乐，",
        "欲知别后相思意，唯愿琼枝入梦频。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 344276,
      "title": "酬考功杨员外见赠佳句",
      "content": [
        "上林谏猎知才薄，尺组承恩愧命牵。",
        "潢潦难滋沧海润，",
        "相国无私人守朴，何辞老去上皇年。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 344277,
      "title": "寄永嘉王十二",
      "content": [
        "永嘉风景入新年，才子诗成定可怜。",
        "梦里还乡不相见，",
        "愿得回风吹海雁，飞书一宿到君边。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 344278,
      "title": "七盘岭阻寇闻李端公先到南楚",
      "content": [
        "日暮穷途泪满襟，云天南望羡飞禽。",
        "阮肠暗与孤鸿断，",
        "秦楚眼看成绝国，相思一寄白头吟。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 344279,
      "title": "酬赵给事相寻不遇留赠",
      "content": [
        "谁忆颜生穷巷里，能劳马迹破春苔。",
        "忽看童子扫花处，",
        "岂无鸡黍期他日，惜此残春阻绿杯。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 344280,
      "title": "山中酬杨补阙见过",
      "content": [
        "日暖风恬种药时，红泉翠壁薜萝垂。",
        "幽溪鹿过苔还静，",
        "却惭身外牵缨冕，未胜杯前倒接z5。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 344281,
      "title": "同王𫓾起居程浩郎中韩翃舍人题安国寺用上人院",
      "content": [
        "慧眼沙门真远公，经行宴坐有儒风。",
        "香缘不绝簪裾会，",
        "狂夫入室无余事，唯与天花一笑同。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 344282,
      "title": "寻司勋李郎中不遇",
      "content": [
        "知己知音同舍郎，如何咫尺阻清扬。",
        "每恨蒹葭傍芳树，",
        "唯有早朝趋凤阁，朝时怜羽接鸳行。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 344283,
      "title": "赠张南史",
      "content": [
        "紫泥何日到沧洲，笑向东阳沈隐侯。",
        "黛色晴峰云外出，",
        "溪畔秋兰虽可佩，知君不得少停舟。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 344284,
      "title": "暇日览旧诗因以题咏",
      "content": [
        "逍遥心地得关关，偶被功名涴我闲。",
        "有寿亦将归象外，",
        "筐箧静开难似此，蕊珠春色海中山。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 344285,
      "title": "汉武出猎",
      "content": [
        "汉家无事乐时雍，羽猎年年出九重。",
        "玉帛不朝金阙路，",
        "薄暮方归长乐观，垂杨几处绿烟浓。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 344286,
      "title": "宴曹王宅",
      "content": [
        "贤王驷马退朝初，小苑三春带雨余。",
        "林沼葱茏多贵气，",
        "自叹平生相识愿，何如今日厕应徐。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 344287,
      "title": "重赠赵给事",
      "content": [
        "久飞鸳掖出时髦，耻负平生稽古劳。",
        "玉树满庭家转贵，",
        "应念潜郎守贫病，常悲休沐对蓬蒿。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 344288,
      "title": "赠阙下裴舍人",
      "content": [
        "二月黄莺飞上林，春城紫禁晓阴阴。",
        "长乐钟声花外尽，",
        "献赋十年犹未遇，羞将白发对华簪。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
