{
  "data": [
    {
      "id": 162919,
      "title": "□□□",
      "content": [
        "□□□□□□□，□□□□□□□。",
        "□□□□□地动，兵前草木挟风寒。",
        "计穷但觉归降易，事定方知进退难。",
        "献宅乞为祈请使，酣歌食肉愧田单。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 162920,
      "title": "和徐雪江即事",
      "content": [
        "万里起青烟，旌旗若涌泉。",
        "国家开气数，陵谷见推迁。",
        "避难浑无地，偷生頼有天。",
        "夜来闻大母，已自纳降笺。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 162921,
      "title": "二月初八日左丞相吴坚右□□□□□枢密使谢堂参政密  其一",
      "content": [
        "原缺三十八字。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 162922,
      "title": "二月初八日左丞相吴坚右□□□□□枢密使谢堂参政密  其二",
      "content": [
        "巵江海蛟□□□母子悲□□□□□□□□征诗。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 162923,
      "title": "望海楼独立",
      "content": [
        "风吹腥气满楼台，独倚阑干十二回。",
        "天入越江龙逝去，雨昏吴市燕飞来。",
        "旌旗闪闪千帆过，帘幙重重一笛哀。",
        "惆怅玉环何处在，海棠犹自向人开。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 162924,
      "title": "吴山晓望",
      "content": [
        "城南城北草芊芊，满地干戈已惘然。",
        "燕燕鶑鶑随战马，风风雨雨渡江船。",
        "小儒愁剧吟如哭，老子歌阑醉欲眠。",
        "一夜春寒花命薄，乱飘红紫下平川。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 162925,
      "title": "同毛敏仲出湖上由万松岭过浙江亭",
      "content": [
        "钱塘门外看新晴，舞蜨游蜂没一星。",
        "风挟断云横北𪩘，烟随飞雨度南屏。",
        "苏隄柳树照波绿，吴苑麦苗连地青。",
        "邂逅寻诗过岭去，鼓鞞声震浙江亭。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 162926,
      "title": "客感和林石田",
      "content": [
        "细柳和烟舞湿云，落花随水送归春。",
        "门东□□□应噪，江上白鸥谁肯驯。",
        "朱子不仁唐逆贼，□□□□诳汉忠。",
        "离亭一笛悲风急，君赋秦州□□□。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 162927,
      "title": "感慈元殿事",
      "content": [
        "翠华扶辇出彤庭，蜜炬星繁天未明。",
        "鹓鹭分行江上别，熊罴从驾雨中行。",
        "绿波淼淼浮三殿，紫禁沈沈断六更。",
        "惟有周遭山似洛，不堪回首泪纵横。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 162928,
      "title": "钱塘歌",
      "content": [
        "钱塘江上龙光死，钱王宫阙今如此。",
        "白髪宫娃作远游，漠漠平沙千万里。",
        "西北高楼白云齐，欲落未落日已低。",
        "古人不见今人去，江水东流乌夜啼。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 162929,
      "title": "别杨驸马",
      "content": [
        "去去马空冀北，行行鹤度辽东。",
        "弹铗三千客里，囊锥十九人中。",
        "杜子肯依严武，孔融不下曹公。",
        "南八男儿如此，杀身方是英雄。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 162930,
      "title": "清明",
      "content": [
        "避难不知寒食，和愁又过清明。",
        "都下纷纷跃马，湖边恰恰啼鶑。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 162931,
      "title": "读史",
      "content": [
        "饿死首阳二子，偷生商岭四翁。",
        "刘项称王称霸，关张无命无功。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 162932,
      "title": "废宅",
      "content": [
        "王侯多第宅，草满玉阑干。",
        "纵有春光在，人谁看牡丹。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 162933,
      "title": "越女",
      "content": [
        "越女为驱虏，朝来揽镜慵。",
        "欲梳新堕马，忍□□□□。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 162934,
      "title": "兵后登大内芙蓉阁宫人梳洗处",
      "content": [
        "粲粲芙蓉阁，我登双眼明。",
        "手拊沈香阑，美人已东征。",
        "美人未去时，朝理绿云鬟，暮吹紫鸾笙。",
        "美人既去时，阁下麋鹿走，阁上鸱枭鸣。",
        "江山咫尺生烟雾，万年枝上悲风生。",
        "空有遗钿碎珥狼籍堆玉案，空有金莲宝炬错落悬珠楹。",
        "杨柳兮青青，芙蓉兮冥冥。",
        "美人不见空泪零，锦梁双燕来又去，夜夜蟾蜍窥玉屏。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 162935,
      "title": "醉歌  其一",
      "content": [
        "吕将军在守襄阳，十载襄阳铁脊梁。",
        "望断援兵无信息，声声骂杀贾平章。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 162936,
      "title": "醉歌  其二",
      "content": [
        "援兵不遣事堪哀，食肉权臣大不才。",
        "见说襄樊投拜了，千军万马过江来。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 162937,
      "title": "醉歌  其三",
      "content": [
        "淮襄州郡尽归降，鞞鼓喧天入古杭。",
        "国母已无心听政，书生空有泪成行。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 162938,
      "title": "醉歌  其四",
      "content": [
        "六宫宫女泪涟涟，事主谁知不尽年。",
        "太后传宣许降国，伯颜丞相到帘前。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 162939,
      "title": "醉歌  其五",
      "content": [
        "乱点连声杀六更，荧荧庭燎待天明。",
        "侍臣已写归降表，臣妾佥名谢道清。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 162940,
      "title": "醉歌  其六",
      "content": [
        "衣冠不改只如先，关会通行满市廛。",
        "北客南人成买卖，京师依旧使铜钱。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 162941,
      "title": "醉歌  其七",
      "content": [
        "北师要讨撒花银，官府行移逼市民。",
        "丞相伯颜犹有语，学中要拣秀才人。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 162942,
      "title": "醉歌  其八",
      "content": [
        "涌金门外雨晴初，多少红船上下趋。",
        "龙管凤笙无韵调，却挝战鼓下西湖。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 162943,
      "title": "醉歌  其九",
      "content": [
        "南苑西宫棘露芽，万年枝上乱啼鸦。",
        "北人环立阑干曲，手指红梅作杏花。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 162944,
      "title": "醉歌  其一○",
      "content": [
        "伯颜丞相吕将军，收了江南不杀人。",
        "昨日太皇请茶饭，满朝朱紫尽降臣。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 162945,
      "title": "贾魏公府  其一",
      "content": [
        "葛岭当年宰相家，游人不敢此行过。",
        "柳阴夹道鶑成市，花影压阑蜂閙衙。",
        "六载襄阳围已解，三更鲁港事如何。",
        "栋梁今日皆焦土，新有园丁种火麻。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 162946,
      "title": "贾魏公府  其二",
      "content": [
        "重门犹钉旧桃牌，惆怅行人去不回。",
        "万种好花环曲径，一泓流水遶香阶。",
        "高台已见胡羊走，乔木惟闻蜀鸟哀。",
        "簷外竹梅森似束，邻翁时剪作烧柴。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 162947,
      "title": "贾魏公府  其三",
      "content": [
        "湖边不见碾香车，断珥遗钿满路涂。",
        "门迳风轻飞野马，亭台火尽及池鱼。",
        "海棠花下生青杞，石竹丛边出紫苏。",
        "却忆相公游赏日，三千卫士立阶除。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 162948,
      "title": "杭州杂诗和林石田  其一",
      "content": [
        "石田林处士，吟境静无尘。",
        "乱后长如醉，愁来不为贫。",
        "饭蔬留好客，笔砚老斯人。",
        "近法秦州体，篇篇妙入神。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 162949,
      "title": "杭州杂诗和林石田  其二",
      "content": [
        "先生忘富贵，久客幸平安。",
        "髪已千茎白，心犹一寸丹。",
        "衣冠前进士，家世旧郎官。",
        "醉入乌程里，吟登李杜坛。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 162950,
      "title": "杭州杂诗和林石田  其三",
      "content": [
        "逃难藏深隠，重逢出近诗。",
        "乾坤一反掌，今古两愁眉。",
        "我作新亭泣，君生旧国悲。",
        "向来行乐地，夜雨走狐狸。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 162951,
      "title": "杭州杂诗和林石田  其四",
      "content": [
        "蠋也吞声哭，潜行到水头。",
        "人谁包马革，子独衣羊裘。",
        "水面生何益，南冠死则休。",
        "百年如过翼，抚掌笑孙刘。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 162952,
      "title": "杭州杂诗和林石田  其五",
      "content": [
        "一春云羃羃，三月雨淋淋。",
        "鱼菜不归市，鶑花空满林。",
        "人行官巷口，军簇御街心。",
        "老子猖狂甚，犹歌梁甫吟。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 162953,
      "title": "杭州杂诗和林石田  其六",
      "content": [
        "烽火来千里，狼烟度六桥。",
        "岭寒苍兕叫，江晓白鱼跳。",
        "壮士披金甲，佳人弄玉箫。",
        "偶余尊酒在，聊以永今朝。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 162954,
      "title": "杭州杂诗和林石田  其七",
      "content": [
        "有客肠回九，无人髪握三。",
        "关中新约法，江左旧清谈。",
        "铁骑来天北，楼船过海南。",
        "一枝巢越鸟，八茧熟吴蚕。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 162955,
      "title": "杭州杂诗和林石田  其八",
      "content": [
        "蹑足封韩信，剖心嗔比干。",
        "河山千古泪，风雨一番寒。",
        "世指鹿为马，人呼鸟作鸾。",
        "江头潮汹汹，城脚水漫漫。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 162956,
      "title": "杭州杂诗和林石田  其九",
      "content": [
        "吟身春共瘦，独立望江亭。",
        "越水荒荒白，吴山了了青。",
        "军降欣解甲，民喜罢抽丁。",
        "拍碎阑干曲，吞声血泪零。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 162957,
      "title": "杭州杂诗和林石田  其一○",
      "content": [
        "天也今如此，人乎可奈何。",
        "台边西子去，宫里北人过。",
        "玉树歌方息，金铜泪已多。",
        "旌旗遮御路，舟楫满官河。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 162958,
      "title": "杭州杂诗和林石田  其一一",
      "content": [
        "此夕知何夕，游船杂战船。",
        "山河空百二，宫阙漫三千。",
        "雨歇云垂地，潮平水接天。",
        "惜哉无祖逖，谁肯著先鞭。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 162959,
      "title": "杭州杂诗和林石田  其一二",
      "content": [
        "陵庙成焦土，宫墙没野蒿。",
        "亡秦皆赵李，佐汉独萧曹。",
        "国子乘黄贵，山人著白高。",
        "飞埃犹黯黯，逝水正滔滔。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 162960,
      "title": "杭州杂诗和林石田  其一三",
      "content": [
        "静看从衡士，番成买卖儿。",
        "禁中惊战鼓，城上出降旗。",
        "魏操非无汉，唐渊不有隋。",
        "从兹更革后，宁复太平期。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 162961,
      "title": "杭州杂诗和林石田  其一四",
      "content": [
        "偶出西湖上，新蒲绿未齐。",
        "携来鳊缩项，买得蟹团脐。",
        "问酒入新店，唤船行旧隄。",
        "乱离多杀戮，水畔几人啼。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 162962,
      "title": "杭州杂诗和林石田  其一五",
      "content": [
        "天目丝丝雨，江头翦翦风。",
        "鼓鞞千艇合，刁斗万家同。",
        "金马怜焦土，铜驼压草丛。",
        "杞天愁欲堕，黑入太阴中。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 162963,
      "title": "杭州杂诗和林石田  其一六",
      "content": [
        "日月往来毂，乾坤生杀机。",
        "江春蛟妾舞，塞暖雁奴归。",
        "逆旅诗添债，愁城酒破围。",
        "如何秦相国，昨夜𤆡韩非。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 162964,
      "title": "杭州杂诗和林石田  其一七",
      "content": [
        "如此只如此，无聊酒一樽。",
        "江山犹昨日，笳鼓又新元。",
        "黑潦迷行路，黄埃入禁门。",
        "皋亭山顶上，百万汉军屯。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 162965,
      "title": "杭州杂诗和林石田  其一八",
      "content": [
        "世变长椎髻，时更短后衣。",
        "魏庭翁仲泣，唐殿子孙非。",
        "树秃鸦争集，梁空燕自归。",
        "断桥春已暮，无頼柳花飞。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 162966,
      "title": "杭州杂诗和林石田  其一九",
      "content": [
        "春去雨方歇，水流花自飞。",
        "人生蝼蚁梦，世道犬羊衣。",
        "日月东西驿，乾坤阖辟扉。",
        "斯令无二子，空有首阳薇。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 162967,
      "title": "杭州杂诗和林石田  其二○",
      "content": [
        "假途虞灭虢，尝胆越吞吴。",
        "黑白一棋局，方圆八阵图。",
        "是翁犹矍铄，诸老自揶揄。",
        "喟叹投麟笔，悲歌击唾壶。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 162968,
      "title": "杭州杂诗和林石田  其二一",
      "content": [
        "竟夕柴门掩，无心接缙绅。",
        "山中多乐事，世上少全人。",
        "诸吕几亡汉，商翁不仕秦。",
        "柴桑深僻处，亦有晋遗民。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 162969,
      "title": "杭州杂诗和林石田  其二二",
      "content": [
        "天下愁无尽，生前乐有涯。",
        "文章一小技，富贵总虚花。",
        "尘入金张宅，草生王谢家。",
        "可怜三月火，不见八姨车。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 162970,
      "title": "杭州杂诗和林石田  其二三",
      "content": [
        "休休休休休，干戈尽白头。",
        "诸公云北去，万事水东流。",
        "春雨不知止，晚山相对愁。",
        "呼童携斗酒，我欲一登楼。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 162971,
      "title": "送琴师毛敏仲北行  其一",
      "content": [
        "西塞山前日落处，北关门外雨来天。",
        "南人堕泪北人笑，臣甫头低拜杜鹃。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 162972,
      "title": "送琴师毛敏仲北行  其二",
      "content": [
        "五里十里亭长短，千帆万帆船去来。",
        "请君收泪向前去，要看幽州金筑台。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 162973,
      "title": "送琴师毛敏仲北行  其三",
      "content": [
        "苏子瞻吃惠州饭，黄鲁直度鬼门关。",
        "今日君行清泪落，他年勋业勒燕山。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 162974,
      "title": "吴儿",
      "content": [
        "玉貌儿童泪盈把，辫髪垂肩行酒斚。",
        "将军又去打苏州，出门指使教牵马。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 162975,
      "title": "答林石田",
      "content": [
        "南朝千古伤心事，每阅陈编泪满襟。",
        "我更伤心成野史，人看野史更伤心。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 162976,
      "title": "浙江亭别客",
      "content": [
        "诸公来此欲凭阑，秃树粘云湿不干。",
        "小燕正嫌三月雨，老鶑又受一春寒。",
        "楼头呼酒尽情饮，江上遇花随意看。",
        "莫怨人生有离别，人生到此别离难。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 162977,
      "title": "江上",
      "content": [
        "太学诸斋拣秀才，出门何处是金台。",
        "楝花风紧子规急，杨柳烟昏黄鸟哀。",
        "潮落潮生天外去，人歌人哭水边来。",
        "推篷坐对吴山月，几度关门击柝回。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 162978,
      "title": "晓行",
      "content": [
        "痴坐书窗待晓钟，背灯无语意无穷。",
        "一家骨肉正愁绝，四海弟兄如梦同。",
        "西舍东邻今日别，北鱼南雁几时通。",
        "行行忍见御沟水，流出满江花片红。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 162979,
      "title": "北征",
      "content": [
        "北师有严程，挽我投燕京。",
        "挟此万卷书，明发万里行。",
        "出门隔山岳，未知死与生。",
        "三宫锦帆张，粉阵吹鸾笙。",
        "遗氓拜路傍，号哭皆失声。",
        "吴山何青青，吴水何泠泠。",
        "山水岂有极，天地终无情。",
        "回首叫重华，苍梧云正横。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 162980,
      "title": "吴江",
      "content": [
        "吴江潮水化虫沙，两岸垂杨噪乱鸦。",
        "舟子鱼羹分宰相，路人麦饭进官家。",
        "莫思后事悲前事，且向天涯到海涯。",
        "回首尚怜西去路，临平山下有荷花。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 162981,
      "title": "苏台",
      "content": [
        "阖闾门外草如霜，到此踌躇欲断肠。",
        "红阵教成人已去，黄池会罢事堪伤。",
        "将雏野鹿衔枯荠，挟子宫乌噪夕阳。",
        "越蠡扁舟漭无所，五湖风浪白茫茫。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 162982,
      "title": "虎丘",
      "content": [
        "维舟与客访兴亡，寺有残僧说故王。",
        "宝物已销龙虎气，奎章犹射斗牛光。",
        "为妖真女花藏墓，说法生公月满堂。",
        "邂逅一樽归路远，樵歌牧笛送斜阳。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 162983,
      "title": "惠山值雨",
      "content": [
        "惠山寺里北人过，古柏茎茎伐尽柯。",
        "三世佛身犹破相，一泓泉水亦生波。",
        "山林虽乐元非乐，尘世多魔未是魔。",
        "举似于人何以故，坐簷闲看雨霶𩃱。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 162984,
      "title": "画溪酒边",
      "content": [
        "夜来饮酒醉如何，酒醒方知事转多。",
        "赵国未衰廉蔺在，齐城将下郦韩过。",
        "鹊飞月树无依所，龙入风江漫作波。",
        "忽有好诗来眼底，画溪榔板唱渔歌。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 162985,
      "title": "常州",
      "content": [
        "渡头风起柳摇丝，丁卯桥边屋已稀。",
        "河草青青淮马健，江花冉冉海鸥肥。",
        "一樽酒对三人饮，八字帆分两岸飞。",
        "天末有人难问讯，仲连东去不须归。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 162986,
      "title": "重游甘露寺",
      "content": [
        "小留甘露莫开船，我欲题诗寄佛轩。",
        "犬下修廊迎宿客，僧归曲巷背𣟴门。",
        "梅边拂石安棋局，竹外鸣琴荐酒尊。",
        "却忆市朝无事日，笙歌日日醉昏昏。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 162987,
      "title": "多景楼",
      "content": [
        "多景楼中昼掩扉，画梁不敢住乌衣。",
        "禅房花木兵烧杀，佛寺干戈僧怕归。",
        "山雨欲来淮树立，潮风初起海云飞。",
        "酒尊未尽登舟急，更过金焦看落晖。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 162988,
      "title": "金山",
      "content": [
        "杨柳隄边看渡船，金山山上访金仙。",
        "一江风起尘扬海，两岸潮来浪拍天。",
        "龙化老人频问法，狐为少妇窃听禅。",
        "此机何与书生事，且借方床熟昼眠。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 162989,
      "title": "焦山",
      "content": [
        "焦山寺里白云堆，百尺危楼百尺台。",
        "持咒圣僧漂海去，寻诗闲客渡江来。",
        "雷轰古树蜈公出，日转虚簷燕子回。",
        "案上楞严都好在，昆明又见有新灰。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 162990,
      "title": "京口野望",
      "content": [
        "傍岸人家插酒旗，受降城下客行稀。",
        "南徐白昼虎成阵，北固黄昏鸦打围。",
        "乱后江山元历历，愁边杨柳极依依。",
        "櫂歌渔子无些事，网得时鱼换酒归。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 162991,
      "title": "扬子江",
      "content": [
        "扬子津头客子愁，孤舟欲渡意绸缪。",
        "蛟龙汹汹争新穴，鸥鹭轻轻下故洲。",
        "水卷岸沙连地去，风掀江浪接天流。",
        "试披陆羽图经看，洗鼎煎茶更少留。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 162992,
      "title": "扬州",
      "content": [
        "江都王气逐浮沤，旧说维扬第一州。",
        "银烛夜攒喧凤吹，金鞍晓织卫龙舟。",
        "绿芜城上军声合，红药阶前客泪收。",
        "云散月明天在水，误疑身世落瀛洲。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 162993,
      "title": "淮安水驿",
      "content": [
        "薄暮舟维杨柳隄，手攀杨柳立多时。",
        "汉儿快意歌荷叶，越女含愁舞柘枝。",
        "月湿江花和露泫，潮摇淮树带风悲。",
        "长亭一夜浑无寐，与客传杯更和诗。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 162994,
      "title": "邳州",
      "content": [
        "身如传舍任西东，夜榻荒邮四壁空。",
        "乡梦渐生灯影外，客愁多在雨声中。",
        "淮南火后居民少，河北兵前战鼓雄。",
        "万里别离心正苦，帛书何日寄归鸿。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 162995,
      "title": "徐州",
      "content": [
        "白杨猎猎起悲风，满目黄埃涨太空。",
        "野壁山墙彭祖宅，塺花粪草项王宫。",
        "古今尽付三杯外，豪杰同归一梦中。",
        "更上城楼见城郭，乱鸦古木夕阳红。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 162996,
      "title": "戏马台",
      "content": [
        "台空马尽始知休，枳棘丛边鹿自游。",
        "泗水不关兴废事，佛峰空锁古今愁。",
        "风吹野甸稻花晚，雨暗山城枫叶秋。",
        "欲吊英灵何处在，髑髅无数满长洲。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 162997,
      "title": "燕子楼",
      "content": [
        "楼颠瓦解草如鬣，燕子不来风猎猎。",
        "倚筇搔首重徘徊，野花丛里飞蝴蜨。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 162998,
      "title": "吕梁",
      "content": [
        "吕梁三十仞，县水莫知源。",
        "雨歇山如沃，波狂岸欲翻。",
        "黄云扑古塞，青草织平原。",
        "最是关情处，秋霜一夜猿。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 162999,
      "title": "歌风台",
      "content": [
        "百尺荒台禾黍悲，沈思往事似轮飞。",
        "洛中车驾秦皇去，沛上风云汉帝归。",
        "鹰入塞榆冲雁阵，鹘穿城树破鸦围。",
        "东徐多少英雄恨，留与行人歌是非。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 163000,
      "title": "观鱼台",
      "content": [
        "高台留古迹，不见隠公游。",
        "白日悲风起，清河逆水流。",
        "潜鱼投别浦，狡兔据荒丘。",
        "应笑臧僖伯，何如谏得休。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 163001,
      "title": "东平官舍",
      "content": [
        "晓鞭驿马入东州，瘦骨棱嶒怯素秋。",
        "天地不仁人去国，江山如待客登楼。",
        "市沽鲁酒难为醉，座咽胡笳易得愁。",
        "日暮凭阑穷目力，一行征雁塞边头。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 163002,
      "title": "通州道中",
      "content": [
        "一片秋云妬太虚，穷荒漠漠走群狐。",
        "西瓜黄处藤如织，北枣红时树若屠。",
        "雪塞捣砧人戍远，霜营吹角客愁孤。",
        "几回兀坐穹庐下，頼有葡萄酒熟初。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 163003,
      "title": "幽州会同馆",
      "content": [
        "六花飞舞下天衢，万里羁人心正孤。",
        "收拾碎砖裨煖炕，掘穿平地结寒炉。",
        "行厨日给官中粟，递驿时供塞上酥。",
        "忽报传宣双敕使，王门今欲试齐竽。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 163004,
      "title": "黄金台和吴实堂韵",
      "content": [
        "把酒上金台，伤心泪落杯。",
        "君臣难再得，天地不重来。",
        "古木巢苍鹘，残碑枕碧苔。",
        "倚阑休北望，万里起黄埃。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 163005,
      "title": "幽州歌",
      "content": [
        "汉儿辫髪笼毡笠，日暮黄金台上立。",
        "臂鹰解带忽放飞，一行塞雁南征急。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 163006,
      "title": "御宴蓬莱岛",
      "content": [
        "晓入重闱对冕旒，内家开宴拥歌讴。",
        "驼峰屡割分金盌，马嬭时倾泛玉瓯。",
        "禁苑风生亭北角，寝园日转殿西头。",
        "山前山后花如锦，一朵红云侍辇游。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 163007,
      "title": "幽州寒食游江乡园",
      "content": [
        "晓出城南信杖藜，江乡小圃百花开。",
        "侑尊妓女骑馿去，顶笠僧官跃马来。",
        "几架秋千红嬝娜，数行箫管绿低徊。",
        "隔河小艇人歌舞，摇荡春光不肯回。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 163008,
      "title": "登蓟门用家则堂韵",
      "content": [
        "蓟门高处小凝眸，雨后林峦翠欲流。",
        "车笠自来还自去，笳箫如怨复如愁。",
        "珍珠络臂夸燕舞，纱帽蒙头笑楚囚。",
        "忽忆旧家行乐地，春风花柳十三楼。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 163009,
      "title": "燕山送黄千户之旴江",
      "content": [
        "万里关河道路迂，出门一笑意何如。",
        "来时雨雪侵驼褐，归日风云蔼驷车。",
        "玉座喜闻黄石策，金台荣拜紫泥书。",
        "野人无以效芹献，一斗酒边双鲤鱼。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 163010,
      "title": "卢奉御自上都回见访",
      "content": [
        "诗人骑马接官回，解后居庸怀抱开。",
        "冷地不禁风聒聒，炎天长见雪堆堆。",
        "昨宵我梦中南去，今日君从直北来。",
        "说尽穷阴无限事，呼童携酒上金台。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 163011,
      "title": "筠溪王奉御寄诗次韵呈崖松卢奉御",
      "content": [
        "新诗蒙远寄，客路不胜秋。",
        "同谷歌臣甫，新丰醉客周。",
        "君今嫌作吏，我已厌封侯。",
        "何日西湖曲，红船上下游。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 163012,
      "title": "幽州秋日听王昭仪琴",
      "content": [
        "瑶池宴罢夜何其，拂拭朱弦落指迟。",
        "弹到急时声不乱，曲当终处意尤奇。",
        "雪深沙碛王嫱怨，月满关山蔡琰悲。",
        "羁客相看默无语，一襟愁思自心知。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 163013,
      "title": "蓟北春望",
      "content": [
        "江南二月蕨笋肥，江北客行殊未归。",
        "怕上西楼洒乡泪，东风吹雨湿征衣。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 163014,
      "title": "燕歌行",
      "content": [
        "北风刮地愁云彤，草木烂死黄尘蒙。",
        "挝鞞伐鼓声冬冬，金鞍铁马摇玲珑。",
        "将军浩气吞长虹，幽并健儿胆力雄。",
        "战车轧轧驰先锋，甲戈相拨声摩空。",
        "雁行鱼贯弯角弓，披霜踏雪渡海东。",
        "鬬血浸野吹腥风，捐躯报国效死忠。",
        "鼓衰矢竭谁收功，将军卸甲入九重。",
        "锦袍宣赐金团龙，天子锡宴葡萄宫。",
        "烹龙炰鸾割驼峰，紫霞潋滟琉璃钟。",
        "天颜有喜春融融，乞与窈窕双芙蓉。",
        "虎符腰佩官益穹，归来贺客皆王公。",
        "戟门和气春风中，美人左右如花红。",
        "朝歌夜舞何时穷，岂知沙场雨湿悲风急，冤魂战鬼成行泣。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
