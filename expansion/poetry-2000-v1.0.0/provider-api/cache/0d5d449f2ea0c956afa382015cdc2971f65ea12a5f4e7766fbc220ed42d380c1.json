{
  "data": [
    {
      "id": 261236,
      "title": "送彭开府往云中觐使君兄",
      "content": [
        "一门三代贵，非是主恩偏。",
        "破虏山铭在，承家剑艺全。",
        "夺旗貂帐侧，射虎雪林前。",
        "鴈塞逢兄弟，云州发管弦。",
        "冻河光带日，枯草净无烟。",
        "儒者曾修武，因贻上将篇。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 261237,
      "title": "送李缃",
      "content": [
        "旧国仍连五将营，儒衣何处谒公卿。",
        "波翻远水蒹葭动，路入寒村机杼鸣。",
        "嵇康书论多归兴，谢氏家风有学名。",
        "为问西来雨中客，空山几处是前程。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 261238,
      "title": "送内弟韦宗仁归信州觐省",
      "content": [
        "常嗟外族兄弟稀，转觉心孤是送归。",
        "醉掩壶觞人有泪，梦惊波浪日无辉。",
        "烹鱼绿岸烟浮草，摘橘青溪露湿衣。",
        "闻说江楼长卷幔，几回风起望胡威。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 261239,
      "title": "长安疾后首秋夜即事",
      "content": [
        "九重深锁禁城秋，月过南宫渐映楼。",
        "紫陌夜深槐露滴，碧空云尽火星流。",
        "清风刻漏传三殿，甲第歌钟乐五侯。",
        "楚客病来乡思苦，寂寥灯下不胜愁。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 261240,
      "title": "送崔琦赴宣州幕",
      "content": [
        "五马临流待幕宾，羡君谈笑出风尘。",
        "身闲就养宁辞远，世难移家莫厌贫。",
        "天际晓山三峡路，津头腊市九江人。",
        "何处遥知最惆怅，满湖青草鴈声春。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 261241,
      "title": "送杨皞东归",
      "content": [
        "登楼掩泣话归期，楚树荆云发远思。",
        "日里扬帆闻戍鼓，舟中酹酒见山祠。",
        "西江风浪何时尽，北客音书欲寄谁。",
        "若说湓城杨司马，知君望国有新诗。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 261242,
      "title": "至德中途中书事却寄李僴",
      "content": [
        "乱离无处不伤情，况复看碑对古城。",
        "路遶寒山人独去，月临秋水鴈空惊。",
        "颜衰重喜归乡国，身贱多惭问姓名。",
        "今日主人还共醉，应怜世故一儒生。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 261243,
      "title": "奉和太常王卿酬中书李舍人中书寓直春夜对月见寄",
      "content": [
        "露如轻雨月如霜，不见星河见鴈行。",
        "虚晕入池波自泛，满轮当苑桂多香。",
        "春台几望黄龙阙，云路宁分白玉郎。",
        "是夜巴歌应金石，岂殊萤影对清光。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 261244,
      "title": "詶包佶郎中览拙卷后见寄",
      "content": [
        "令伯支离晚读书，岂知词赋称相如。",
        "枉逢花木无新思，拙就溪潭损旧居。",
        "禁路看山歌自缓，云司玩月漏应疎。",
        "沈忧敢望金门召，空媿巴歈并子虚。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 261245,
      "title": "送史采滑州谒贾仆射",
      "content": [
        "朱门洞启俨行车，金𫔎装囊半是书。",
        "君向东州问徐胤，羊公何事灭吹鱼。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 261246,
      "title": "送鲍中丞赴太原",
      "content": [
        "分路引鸣驺，喧喧似陇头。",
        "暂移西掖望，全解北门忧。",
        "专幕临都护，分曹制督邮。",
        "积冰营不下，盛雪猎方休。",
        "白草连胡帐，黄云拥戍楼。",
        "今朝送旌斾，一减鲁儒羞。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 261247,
      "title": "送耿拾遗𣲗充括图书使往江淮",
      "content": [
        "传令收遗籍，诸儒喜饯君。",
        "孔家唯有地，禹穴但生云。",
        "编简知还续，虫鱼亦自分。",
        "如逢北山隐，一为谢移文。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261248,
      "title": "送郭判官赴振武",
      "content": [
        "黄河九曲流，缭绕古边州。",
        "鸣鴈飞初夜，羌胡正晚秋。",
        "凄凉金管思，迢遰玉人愁。",
        "七叶推多庆，须怀杀敌忧。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261249,
      "title": "春江夕望",
      "content": [
        "洞庭芳草遍，楚客莫思归。",
        "经难人空老，逢春鴈自飞。",
        "东西兄弟远，存没友朋稀。",
        "独立还垂泪，天南一布衣。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261250,
      "title": "送元昱尉义兴",
      "content": [
        "欲成云海别，一夜梦天涯。",
        "白浪缘江雨，青山绕县花。",
        "风标当剧部，冠带称儒家。",
        "去矣谢亲爱，知予发已华。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261251,
      "title": "送黎兵曹往陕府结亲",
      "content": [
        "郎马两如龙，春朝上路逢。",
        "鸳鸯初集水，薜荔欲依松。",
        "步帐歌声转，妆台烛影重。",
        "何言在阴者，得是戴侯宗。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261252,
      "title": "送乐平苗明府",
      "content": [
        "累职比柴桑，清秋入楚乡。",
        "一船灯照浪，两岸树凝霜。",
        "亭吏趋寒雾，山城敛曙光。",
        "无辞折腰久，仲德在鸳行。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261253,
      "title": "晚到盩厔耆老家",
      "content": [
        "老翁曾旧识，相引出柴门。",
        "苦话别时事，因寻溪上村。",
        "数年何处客，近日几家存。",
        "冒雨看禾黍，逢人忆子孙。",
        "乱藤穿井口，流水到篱根。",
        "惆怅不堪住，空山月又昏。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 261254,
      "title": "卧病书怀",
      "content": [
        "苦心三十载，白首遇艰难。",
        "旧地成孤客，全家赖钓竿。",
        "貌衰缘药尽，起晚为山寒。",
        "老病今如此，无人更问看。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261255,
      "title": "落第后归终南别业",
      "content": [
        "久为名所误，春尽始归山。",
        "落羽羞言命，逢人强破颜。",
        "交疎贫病里，身老是非间。",
        "不及东溪月，渔翁夜往还。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261256,
      "title": "送朝邑张明府",
      "content": [
        "千室暮山西，浮云与树齐。",
        "剖辞云落纸，拥吏雪成泥。",
        "野火芦千顷，河田水万畦。",
        "不知琴月夜，谁得听乌啼。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261257,
      "title": "送李方东归",
      "content": [
        "故交三四人，闻别共霑巾。",
        "举目是陈事，满城无至亲。",
        "身从丧日病，家自俭年贫。",
        "此去何堪远，遗孤在旧邻。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261258,
      "title": "秋晚霁后野望忆夏侯审",
      "content": [
        "天晴禾黍平，畅目亦伤情。",
        "野店云日丽，孤庄砧杵鸣。",
        "川原唯寂寞，岐路自纵横。",
        "前后无俦侣，此怀谁与呈。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261259,
      "title": "送王尊师",
      "content": [
        "梦别一仙人，霞衣满鹤身。",
        "旌幢天路晚，桃杏海山春。",
        "种玉非求稔，烧金不为贫。",
        "自怜头白早，难与葛洪亲。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261260,
      "title": "送抚州周使君",
      "content": [
        "周郎三十余，天子赐鱼书。",
        "龙节随云水，金铙动里闾。",
        "松声三楚远，乡思百花初。",
        "若转弘农守，萧咸事不如。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261261,
      "title": "赠别司空曙",
      "content": [
        "有月曾同赏，无秋不共悲。",
        "如何与君别，又是菊花时。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 261262,
      "title": "送王录事赴任苏州",
      "content": [
        "古堤迎拜路，万里一帆前。",
        "潮作浇田雨，云成煮海烟。",
        "吏闲唯重法，俗富不忧边。",
        "西掖今宵咏，还应寄阿连。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261263,
      "title": "大梵山寺院奉呈趣上人赵中丞",
      "content": [
        "渐欲休人事，僧房学闭关。",
        "伴鱼浮水上，看鹤向林间。",
        "寺古秋仍早，松深暮更闲。",
        "月中随道友，夜夜坐空山。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261264,
      "title": "送恒操上人归江外觐省",
      "content": [
        "依佛不违亲，高堂与寺邻。",
        "问安双树晓，求膳一僧贫。",
        "持呪过龙庙，翻经化海人。",
        "还同惠休去，儒者亦霑巾。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261265,
      "title": "上巳日陪齐相公花楼宴",
      "content": [
        "钟陵暮春月，飞观延群英。",
        "晨霞耀中轩，满席罗金琼。",
        "持杯凝远睇，触物结幽情。",
        "树色参差绿，湖光潋滟明。",
        "礼卑瞻绛帐，恩浃厕华缨。",
        "徒记山阴兴，祓禊乃为荣。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 261266,
      "title": "寒食",
      "content": [
        "孤客飘飘岁载华，况逢寒食倍思家。",
        "莺啼远墅多从柳，人哭荒坟亦有花。",
        "浊水秦渠通渭急，黄埃京洛上原斜。",
        "驱车西近长安好，宫观参差半隐霞。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 261267,
      "title": "舟中寒食",
      "content": [
        "寒食空江曲，孤舟渺水前。",
        "鬬鸡沙鸟异，禁火岸花然。",
        "日霁开愁望，波喧警醉眠。",
        "因看数茎鬓，倍欲惜芳年。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261268,
      "title": "元日早朝呈故省诸公",
      "content": [
        "万戟凌霜布，森森瑞气间。",
        "垂衣当晓日，上寿对南山。",
        "济济延多士，跹跹舞百蛮。",
        "小臣无事谏，空愧伴鸣环。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261269,
      "title": "元日朝回中夜书情寄南宫二故人",
      "content": [
        "鸣珮随鹓鹭，登堦见冕旒。",
        "无能裨圣代，何事别沧洲。",
        "闲夜贫还醉，浮名老渐羞。",
        "凤城春欲晚，郎吏忆同游。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261270,
      "title": "裴给事宅白牡丹",
      "content": [
        "长安豪贵惜春残，争翫街西紫牡丹。",
        "别有玉盘承露冷，无人起就月中看。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 261271,
      "title": "送韦判官得雨中山",
      "content": [
        "前峰后岭碧蒙蒙，草拥惊泉树带风。",
        "人语马嘶听不得，更堪长路在云中。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 261272,
      "title": "送宛丘任少府",
      "content": [
        "带绶别乡亲，东为千里人。",
        "俗讹唯竞祭，地古不留春。",
        "野戍云藏火，军城树拥尘。",
        "少年何所重，才子又清贫。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261273,
      "title": "送永阳崔明府",
      "content": [
        "鹤唳蒹葭晓，中流见楚城。",
        "浪清风乍息，山白月犹明。",
        "废路开荒木，归人种古营。",
        "悬闻正讹俗，邴曼更知名。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261274,
      "title": "割飞二刀子歌",
      "content": [
        "我家有翦刀，人云鬼国铁。",
        "裁罗裁绮无钝时，用来三年一股折。",
        "南中匠人淳用钢，再令盘屈随手伤。",
        "改锻割飞二刀子，色迎霁雪锋含霜。",
        "两条神物秋冰薄，刃淬初蟾鞘金错。",
        "越戟吴钩不足夸，斩犀切玉应怀怍。",
        "日试曾磨汉水边，掌中恄栗声冷然。",
        "神惊魄悸却收得，刃头已吐微微烟。",
        "刀乎刀乎何烨烨，魑魅须藏怪须慑。",
        "若非良工变尔形，只向裁缝委箱箧。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 261275,
      "title": "送郎士元使君赴郢州",
      "content": [
        "赐衣兼授节，行日郢中闻。",
        "花发登山庙，天晴阅水军。",
        "渔商三楚接，郡邑九江分。",
        "高兴应难遂，元戎有大勋。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261276,
      "title": "春词",
      "content": [
        "北苑罗裙带，尘衢锦绣鞵。",
        "醉眠芳树下，半被落花埋。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 261277,
      "title": "清如玉壶冰",
      "content": [
        "玉壶冰始结，循吏政初成。",
        "既有虚心鉴，还如照胆清。",
        "瑶池慙洞澈，金镜让澄明。",
        "气若朝霜动，形随夜月盈。",
        "临人能不蔽，待物本无情。",
        "怯对圆光裹，妍蚩自此呈。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 261278,
      "title": "山店",
      "content": [
        "登登山路行时尽，决决溪泉到处闻。",
        "风动叶声山犬吠，一家松火隔秋云。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 266504,
      "title": "杂曲歌辞 天长地久词 一",
      "content": [
        "玉砌红花树，香风不敢吹。",
        "春光解天意，偏发殿南枝。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 266505,
      "title": "杂曲歌辞 天长地久词 二",
      "content": [
        "虹桥千步廊，半在水中央。",
        "天子方清暑，宫人重暮妆。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 266506,
      "title": "杂曲歌辞 天长地久词 三",
      "content": [
        "辞辇复当熊，倾心奉上宫。",
        "君王若看貌，甘在众妃中。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 266507,
      "title": "杂曲歌辞 天长地久词 四",
      "content": [
        "云日呈祥礼物殊，北庭生献五单于。",
        "塞天万里无飞鸟，可在边城用郅都。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 266508,
      "title": "杂曲歌辞 天长地久词 五",
      "content": [
        "台殿云凉风日微，君王初赐六宫衣。",
        "楼船罢泛归犹早，行道才人鬬射飞。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 266551,
      "title": "杂曲歌辞 皇帝感词 一",
      "content": [
        "提劒云雷动，垂衣日月明。",
        "禁花呈瑞色，国老见星精。",
        "发棹鱼先跃，窥巢鸟不惊。",
        "山呼一万岁，直入九重城。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 266552,
      "title": "杂曲歌辞 皇帝感词 二",
      "content": [
        "天衣五凤彩，御马六龙文。",
        "雨露清驰道，风雷翊上军。",
        "高旍花外转，行漏乐前闻。",
        "时见金鞭举，空中指瑞云。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 266553,
      "title": "杂曲歌辞 皇帝感词 三",
      "content": [
        "妙算干戈止，神谋宇宙清。",
        "两阶文物盛，七德武功成。",
        "校猎长杨苑，屯军细柳营。",
        "归来献明主，歌舞隘春城。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 266554,
      "title": "杂曲歌辞 皇帝感词 四",
      "content": [
        "天乐下天中，云𫐌俨在空。",
        "铅黄艳河汉，语笑合笙镛。",
        "已见长随凤，仍闻不避熊。",
        "君王亲试舞，阊阖静无风。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 303353,
      "title": "剑诗",
      "content": [
        "太平时节无人看，雪刃闲封满匣尘。",
        "（见《吟窗杂录》卷十四《诗中旨格》）（按：《吟窗杂录》本作者名作「处纶」，兹依《诗学指南》卷四改正。",
        "《全唐诗》卷八四九收作处默诗，疑误。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 334565,
      "title": "相和歌辞：从军行",
      "content": [
        "二十在边城，军中得勇名。",
        "卷旗收败马，断碛拥残兵。",
        "覆阵乌鸢起，烧山草木明。",
        "塞闲思远猎，师老厌分营。",
        "雪岭无人迹，冰河足雁声。",
        "李陵甘此没，惆怅汉公卿。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 334666,
      "title": "相和歌辞：长门怨",
      "content": [
        "空宫古廊殿，寒月照斜晖。",
        "卧听未央曲，满箱歌舞衣。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 334908,
      "title": "杂曲歌辞：妾薄命",
      "content": [
        "妾年初二八，两度嫁狂夫。",
        "薄命今犹在，坚贞扫地无。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 335311,
      "title": "杂曲歌辞：天长地久词",
      "content": [
        "玉砌红花树，香风不敢吹。",
        "春光解天意，偏发殿南枝。",
        "虹桥千步廊，半在水中央。",
        "天子方清暑，宫人重暮妆。",
        "辞辇复当熊，倾心奉上宫。",
        "君王若看貌，甘在众妃中。",
        "云日呈祥礼物殊，北庭生献五单于。",
        "塞天万里无飞鸟，可在边城用郅都。",
        "台殿云凉风日微，君王初赐六宫衣。",
        "楼船罢泛归犹早，行道才人斗射飞。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 335336,
      "title": "杂曲歌辞：皇帝感词",
      "content": [
        "提剑云雷动，垂衣日月明。",
        "禁花呈瑞色，国老见星精。",
        "发棹鱼先跃，窥巢鸟不惊。",
        "山呼一万岁，直入九重城。",
        "天衣五凤彩，御马六龙文。",
        "雨露清驰道，风雷翊上军。",
        "高旍花外转，行漏乐前闻。",
        "时见金鞭举，空中指瑞云。",
        "妙算干戈止，神谋宇宙清。",
        "两阶文物盛，七德武功成。",
        "校猎长杨苑，屯军细柳营。",
        "归来献明主，歌舞隘春城。",
        "天乐下天中，云輧俨在空。",
        "铅黄艳河汉，语笑合笙镛。",
        "已见长随凤，仍闻不避熊。",
        "君王亲试舞，阊阖静无风。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 346366,
      "title": "送吉中孚校书归楚州旧山",
      "content": [
        "青袍芸阁郎，谈笑挹侯王。",
        "旧箓藏云穴，新诗满帝乡。",
        "名高闲不得，到处人争识。",
        "谁知冰雪颜，已杂风尘色。",
        "此去复如何，东皋岐路多。",
        "藉芳临紫陌，回首忆沧波。",
        "年来倦萧索，但说淮南乐。",
        "并楫湖上游，连樯月中泊。",
        "沿溜入阊门，千灯夜市喧。",
        "喜逢邻舍伴，遥语问乡园。",
        "下淮风自急，树杪分郊邑。",
        "送客随岸行，离人出帆立。",
        "渔村绕水田，澹澹隔晴烟。",
        "欲就林中醉，先期石上眠。",
        "林昏天未曙，但向云边去。",
        "暗入无路山，心知有花处。",
        "登高日转明，下望见春城。",
        "洞里草空长，冢边人自耕。",
        "寥寥行异境，过尽千峰影。",
        "露色凝古坛，泉声落寒井。",
        "仙成不可期，多别自堪悲。",
        "为问桃源客，何人见乱时。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 346367,
      "title": "送姨弟裴均尉诸暨",
      "content": [
        "相悲得成长，同是外家恩。",
        "旧业废三亩，弱年成一门。",
        "城开山日早，吏散渚禽喧。",
        "东阁谬容止，予心君冀言。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 346368,
      "title": "送邓州崔长史",
      "content": [
        "出山车骑次诸侯，坐领图书见督邮。",
        "绕郭桑麻通淅口，",
        "闻说元规偏爱月，知君长得伴登楼。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 346372,
      "title": "送从舅成都县丞广归蜀",
      "content": [
        "褒谷通岷岭，青冥此路深。",
        "晚程椒瘴热，野饭荔枝阴。",
        "古郡三刀夜，春桥万里心。",
        "唯应对杨柳，暂醉卓家琴。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 346377,
      "title": "送丹阳赵少府",
      "content": [
        "恭闻林下别，未至亦沾裳。",
        "荻岸雨声尽，江天虹影长。",
        "佩韦宗懒慢，偷橘爱芳香。",
        "遥想从公后，称荣在上堂。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 346380,
      "title": "送申屠正字往湖南迎亲兼谒赵和州因呈上侍郎使君并戏简前历阳李明府",
      "content": [
        "晓月朣朦映水关，水边因到历阳山。",
        "千艘财货朱桥下，",
        "欢余若问南行计，知念天涯负米还。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 346381,
      "title": "送李尚书郎君昆季侍从归觐滑州",
      "content": [
        "凤雏联翼美王孙，彩服戎装拟塞垣。",
        "金鼎对筵调野膳，",
        "更说务农将罢战，敢持歌颂庆晨昏。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 346382,
      "title": "送张调参军侍从归觐荆南因寄长林司空十四曙",
      "content": [
        "玉勒侍行襜，郗超未有髯。",
        "守儒轻猎骑，承诲访沈潜。",
        "云势将峰杂，江声与屿兼。",
        "还当见王粲，应念二毛添。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 346384,
      "title": "送张成季往江上赋得垂杨",
      "content": [
        "垂杨真可怜，地胜觉春偏。",
        "一穗雨声里，千条池色前。",
        "露繁光的皪，日丽影团圆。",
        "若到隋堤望，应逢花满船。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 346385,
      "title": "送陕府王司法",
      "content": [
        "东门雪覆尘，出送陕城人。",
        "粉郭朝喧市，朱桥夜掩津。",
        "上寮应重学，小吏已甘贫。",
        "谢脁曾为掾，希君一比邻。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 346386,
      "title": "送太常李主簿归觐省",
      "content": [
        "粲粲美仍都，清闲一贵儒。",
        "定交分玉剑，发咏写冰壶。",
        "风景随台位，河山入障图。",
        "上堂多庆乐，肯念谷中愚。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 346388,
      "title": "送万巨",
      "content": [
        "把酒留君听琴，难堪岁暮离心。",
        "霜叶无风自落，",
        "望断青山独立，更知何处相寻。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 346392,
      "title": "无题",
      "content": [
        "耻将名利托交亲，只向尊前乐此身。",
        "才大不应成滞客，",
        "□□□□□□□，岂能偏遣老风尘。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 346393,
      "title": "题念济寺",
      "content": [
        "灵空闻偈夜清净，雨里花枝朝暮开。",
        "故友九泉留语别，逐臣千里寄书来。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 346398,
      "title": "与从弟瑾同下第后出关言别",
      "content": [
        "同作金门献赋人，二年悲见故园春。",
        "到阙不沾新雨露，还家空带旧风尘。",
        "杂花飞尽柳阴阴，官路逶迤绿草深。",
        "对酒已成千里客，望山空寄两乡心。",
        "出关愁暮一沾裳，满野蓬生古战场。",
        "孤村树色昏残雨，远寺钟声带夕阳。",
        "谁怜苦志已三冬，却欲躬耕学老农。",
        "流水白云寻不尽，期君何处得相逢。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 346400,
      "title": "冬夜赠别友人",
      "content": [
        "愁听千家流水声，相思独向月中行。",
        "侵阶暗草秋霜重，",
        "更送乘轺归上国，应怜贡禹未成名。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 346402,
      "title": "送卫司法河中觐省",
      "content": [
        "出身因强学，不以外家荣。",
        "年少无遗事，官闲有政声。",
        "晓山临野渡，落日照军营。",
        "共赏高堂下，连行弟与兄。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 346403,
      "title": "送从叔牧永州",
      "content": [
        "五侯轩盖行何疾，零陵太守登车日。",
        "零陵太守泪盈巾，",
        "彼方韶景无时节，山水诸花恣开发。",
        "客投津戍少闻猿，",
        "浪里争迎三蜀货，月中喧泊九江船。",
        "今朝小阮同夷老，"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 346406,
      "title": "送浑炼归觐却赴阙庭",
      "content": [
        "露幕拥簪裾，台庭饯伯鱼。",
        "彩衣人竞看，银诏帝亲书。",
        "知子当元老，为臣饯二疏。",
        "执珪期已迫，捧膳步宁徐。",
        "而我诚愚者，夫君岂病诸。",
        "探题多决胜，馔玉每分余。",
        "荣比成功后，恩同造化初。",
        "甑尘方欲合，笼翮或将舒。",
        "榆荚钱难比，杨花雪不如。",
        "明朝古堤路，心断玉人车。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 346407,
      "title": "送崔邠拾遗",
      "content": [
        "皎洁无瑕清玉壶，晓乘华幰向天衢。",
        "石建每闻宗谨孝，",
        "今日攀车复何者，辕门垂白一愚夫。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 346408,
      "title": "送浑别驾赴舒州",
      "content": [
        "江平芦荻齐，五两贴樯低。",
        "绕郭覆晴雪，满船闻曙鸡。",
        "鳣鲂宜入贡，橘柚亦成蹊。",
        "还似海沂日，风清无鼓鼙。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 346409,
      "title": "送从叔士准赴任润州司士",
      "content": [
        "云起山城暮，沉沉江上天。",
        "风吹建业雨，浪入广陵船。",
        "久是吴门客，尝闻谢守贤。",
        "终悲去国远，泪尽竹林前。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 346410,
      "title": "送尹枢令狐楚及第后归觐",
      "content": [
        "佳人比香草，君子即芳兰。",
        "宝器金罍重，清音玉佩寒。",
        "贡文齐受宠，献礼两承欢。",
        "鞍马并汾地，争迎陆与潘。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 346414,
      "title": "𢽾颜鲁公送挺赟归翠微寺",
      "content": [
        "挺赟惠学该儒释，袖有颜徐真草迹。",
        "一斋三请纪行诗，",
        "虎迹印雪大如斗，闰月暮天过得无。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 346417,
      "title": "颜侍御厅丛篁咏送薛存诚",
      "content": [
        "玉干百余茎，生君此堂侧。",
        "拂帘寒雨响，拥砌深溪色。",
        "何事凤凰雏，兹焉理归翼。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 346419,
      "title": "达奚中丞东斋壁画山水各赋一物得树杪悬泉送长安赵元阳少府",
      "content": [
        "素壁画飞泉，从云落树颠。",
        "练垂疑叶响，云并觉枝偏。",
        "利物得双剑，为儒当一贤。",
        "应思洒尘陌，调膳亦芳鲜。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 346420,
      "title": "送信州姚使君",
      "content": [
        "朱幡徐转候群官，猿鸟无声郡宇宽。",
        "楚国上腴收赋重，",
        "几日政声闻户外，九江行旅得相欢。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 346422,
      "title": "送史兵曹判官赴楼烦",
      "content": [
        "渥洼龙种散云时，千里繁花乍别离。",
        "中有重臣承霈泽，",
        "敢谢亲贤得琼玉，仲宣能赋亦能诗。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 346423,
      "title": "送昙延法师讲罢赴上都",
      "content": [
        "金缕袈裟国大师，能销坏宅火烧时。",
        "复来拥膝说无住，知向人天何处期。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 346424,
      "title": "送道士郤彝素归内道场",
      "content": [
        "病老正相仍，忽逢张道陵。",
        "羽衣风淅淅，仙貌玉棱棱。",
        "叱我问中寿，教人祈上升。",
        "楼居五云里，几与武皇登。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 346426,
      "title": "送饯从叔辞丰州幕归嵩阳旧居",
      "content": [
        "白须宗孙侍坐时，愿持寿酒前致词。",
        "鄙词何所拟，",
        "屯田布锦周千里，牧马攒花溢万群。",
        "白云本是乔松伴，",
        "丰州闻说似凉州，沙塞晴明部落稠。",
        "行客已去依独戍，",
        "洞里先生那怪迟，人天无路自无期。",
        "砂泉丹井非同味，",
        "莫著戎衣期上清，东方曼倩逢人轻。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 346427,
      "title": "送静居法师",
      "content": [
        "五色香幢重复重，宝舆升座发神钟。",
        "薝卜名花飘不断，",
        "愿比灵山前世别，多生还得此相逢。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 346432,
      "title": "虢州逢侯钊同寻南观因赠别",
      "content": [
        "相见翻惆怅，应怜责废官。",
        "过深惭禄在，识浅赖刑宽。",
        "独失耕农业，同思弟侄欢。",
        "衰贫羞客过，卑束会君难。",
        "放鹤登云壁，浇花绕石坛。",
        "兴还江海上，迹在是非端。",
        "林密风声细，山高雨色寒。",
        "悠然此中别，宾仆亦阑干。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 346433,
      "title": "赴池州拜觐舅氏留上考功郎中舅",
      "content": [
        "孤贱易蹉跎，其如酷似何。",
        "衰荣同族少，生长外家多。",
        "别国桑榆在，沾衣血泪和。",
        "应怜失行雁，霜霰寄烟波。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 346434,
      "title": "送从侄滁州觐省",
      "content": [
        "爱尔似龙媒，翩翩千里回。",
        "书从外氏学，竹自晋时栽。",
        "拥棹逢鸥舞，凭阑见雨来。",
        "上堂多庆乐，不醉莫停杯。"
      ],
      "author": {
