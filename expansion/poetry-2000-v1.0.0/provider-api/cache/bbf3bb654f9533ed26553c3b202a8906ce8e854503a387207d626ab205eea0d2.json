{
  "data": [
    {
      "id": 255109,
      "title": "鼓吹曲辞 芳树",
      "content": [
        "细蘂慢逐风，暖香闲破鼻。",
        "青帝固有心，时时动人意。",
        "去年高枝犹压地，今年低枝已顦顇。",
        "吾所以见造化之权，变通之理。",
        "春夏作头，秋冬为尾。",
        "循环反复无穷已，今生长短同一轨。",
        "若使威可以制，力可以止，秦皇不肯敛手下沙丘，孟贲不合低头入蒿里。",
        "伊人彊猛犹如此，顾我劳生何足恃？",
        "但愿开素袍，倾绿蚁，陶陶兀兀大醉于青冥白昼间。",
        "任他上是天，下是地。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 255150,
      "title": "横吹曲辞 陇头水",
      "content": [
        "借问陇头水，年年恨何事。",
        "全疑呜咽声，中有征人泪。",
        "自古无长策，况我非深智。",
        "何计谢潺湲，一宵空不寐。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 255276,
      "title": "相和歌辞 江南曲",
      "content": [
        "江烟湿雨鲛绡輭，漠漠远山眉黛浅。",
        "水国多愁又有情，夜槽压酒银船满。",
        "绷丝采怨凝晓空，吴王台榭春梦中。",
        "鸳鸯㶉𫛶唤不起，平铺渌水眠东风。",
        "西陵路边月悄悄，油壁轻车嫁苏小。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 255359,
      "title": "相和歌辞 铜雀台",
      "content": [
        "强歌强舞竟难胜，花落花开泪满缯。",
        "祗合当年伴君死，免教顦顇望西陵。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 284778,
      "title": "曲江春感",
      "content": [
        "江头日暖花又开，江东行客心悠哉。",
        "高阳酒徒半雕落，终南山色空崔嵬。",
        "圣代也知无弃物，侯门未必用非才。",
        "一船明月一竿竹，家住五湖归去来。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 284779,
      "title": "皇陂",
      "content": [
        "皇陂潋滟深复深，陂西下马聊登临。",
        "垂杨风轻弄翠带，鲤鱼日暖跳黄金。",
        "三月穷途无胜事，十年流水见归心。",
        "输他谷口郑夫子，偷得闲名说至今。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 284780,
      "title": "寄郑补阙",
      "content": [
        "夫子门前数仞墙，每经过处忆游梁。",
        "路从青琐无因见，恩在丹心不可忘。",
        "未必便为谗口隔，只应贪草谏书忙。",
        "别来愁悴知多少，两度槐花马上黄。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 284781,
      "title": "牡丹花",
      "content": [
        "似共东风别有因，绛罗高卷不胜春。",
        "若教解语应倾国，任是无情亦动人。",
        "芍药与君为近侍，芙蓉何处避芳尘。",
        "可怜韩令功成后，辜负秾华过此身。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 284782,
      "title": "黄河",
      "content": [
        "莫把阿胶向此倾，此中天意固难明。",
        "解通银汉应须曲，才出昆仑便不清。",
        "高祖誓功衣带小，仙人占斗客槎轻。",
        "三千年后知谁在，何必劳君报太平。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 284783,
      "title": "汴河",
      "content": [
        "当时天子是闲游，今日行人特地愁。",
        "柳色纵饶妆故国，水声何忍到扬州。",
        "乾坤有意终难会，黎庶无情岂自由。",
        "应笑秦皇用心错，谩驱神鬼海东头。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 284784,
      "title": "西京崇德里居",
      "content": [
        "进乏梯媒退又难，强随豪贵𣨼长安。",
        "风从昨夜吹银汉，泪拟何门落玉盘。",
        "抛掷红尘应有恨，思量仙桂也无端。",
        "锦鳞赪尾平生事，却被闲人把钓竿。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 284785,
      "title": "投所思",
      "content": [
        "顦顇长安何所为，旅魂穷命自相疑。",
        "满川碧嶂无归日，一榻红尘有泪时。",
        "雕琢只应劳郢匠，膏肓终恐误秦医。",
        "浮生七十今三十，从此凄惶未可知。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 284786,
      "title": "经张舍人旧居",
      "content": [
        "行尘不是昔时尘，谩向朱门忆侍臣。",
        "一榻已无开眼处，九泉应有爱才人。",
        "文余吐凤他年诏，树想栖鸾旧日春。",
        "从此恩深转难报，夕阳衰草泪沾巾。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 284787,
      "title": "雒城作",
      "content": [
        "大卤旌旗出洛滨，此中烟月已埃尘。",
        "更无楼阁寻行处，只有山川识野人。",
        "早得铸金夸范蠡，旋闻垂钓哭平津。",
        "旧游难得时难遇，回首空城百草春。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 284788,
      "title": "姑苏城南湖陪曹使君游",
      "content": [
        "水蓼花红稻穗黄，使君兰棹泛回塘。",
        "倚风荇藻先开路，迎斾凫鹥尽著行。",
        "手里兵符神与术，腰间金印彩为囊。",
        "少年太守勋庸盛，应笑燕台两鬓霜。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 284789,
      "title": "秋日有寄姑苏曹使君",
      "content": [
        "多病无因櫂小舟，阖闾城下谒名侯。",
        "水寒不见双鱼信，风便唯闻五袴讴。",
        "早说用兵长暗合，近传观稼亦闲游。",
        "须知谢奕依前醉，闲阻清谈又一秋。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 284790,
      "title": "送章碣赴举",
      "content": [
        "苹鹿歌中别酒催，粉闱星彩动昭回。",
        "久经罹乱心应破，乍覩升平眼渐开。",
        "顾我昔年悲玉石，怜君今日蕴风雷。",
        "龙门盛事无因见，费尽黄金老隗台。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 284791,
      "title": "寄杨秘书",
      "content": [
        "湖水平来见鲤鱼，偶因烹处得琼琚。",
        "披寻藻思千重后，吟想冰光万里余。",
        "漳浦病来情转薄，赤城吟苦意何如。",
        "锦衣公子怜君在，十载兵戈从板舆。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 284792,
      "title": "往年进士赵能卿尝话金庭胜事见示叙",
      "content": [
        "会稽诗客赵能卿，往岁相逢话石城。",
        "正恨故人无上寿，喜闻良宰有高情。",
        "山朝佐命层层耸，水接飞流步步清。",
        "两火一刀罹乱后，会须乘兴雪中行。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 284793,
      "title": "得宣州窦尚书书因投寄二首 一",
      "content": [
        "双鱼迢递到江滨，伤感南陵旧主人。",
        "万里朝台劳寄梦，十年侯国阻趋尘。",
        "寻知乱后尝辞禄，共喜闲来得养神。",
        "时见齐山敬亭客，不堪戎马战征频。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 284794,
      "title": "得宣州窦尚书书因投寄二首 二",
      "content": [
        "曾逐旌旗过板桥，世途多难竟蓬飘。",
        "步兵校尉辞公府，车骑将军忆本朝。",
        "醉里旧游还历历，病中衰鬓奈萧萧。",
        "遗簪堕履应留念，门客如今只下僚。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 284795,
      "title": "雪",
      "content": [
        "细玉罗纹下碧霄，杜门颜巷落偏饶。",
        "巢居只恐高柯折，旅客愁闻去路遥。",
        "撅冻野蔬和粉重，埽庭松叶带酥烧。",
        "寒窗呵笔寻诗句，一片飞来纸上销。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 284796,
      "title": "暇日有寄姑苏曹使君兼呈张郎中郡中宾僚",
      "content": [
        "嘉植阴阴覆劒池，此中能政动神祗。",
        "湖边观稼雨迎马，城外犒军风满旗。",
        "融酒徒夸无算爵，俭莲还少最高枝。",
        "珊瑚笔架真珠履，曾和陈王几首诗。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 284797,
      "title": "寄右省王谏议",
      "content": [
        "耳边要静不得静，心里欲闲终未闲。",
        "自是宿缘应有累，可能时事更相关。",
        "鱼慙张翰辞东府，鹤怨周颙负北山。",
        "看却金庭芝术老，又驱车入七人班。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 284798,
      "title": "焚书坑",
      "content": [
        "千载遗踪一窖尘，路傍耕者亦伤神。",
        "祖龙算事浑乖角，将谓诗书活得人。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 284799,
      "title": "始皇陵",
      "content": [
        "荒堆无草树无枝，嬾向行人问昔时。",
        "六国英雄漫多事，到头徐福是男儿。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 284800,
      "title": "送沈先辈归送上嘉礼",
      "content": [
        "青青月桂触人香，白苎衫轻称沈郎。",
        "好继马卿归故里，况闻山简在襄阳。",
        "杯倾别岸应须醉，花傍征军渐欲芳。",
        "拟把金钱赠嘉礼，不堪栖屑困名场。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 284801,
      "title": "春日叶秀才曲江",
      "content": [
        "江花江草暖相隈，也向江边把酒杯。",
        "春色恼人遮不得，别愁如疟避还来。",
        "安排贱迹无良策，裨补明时望重才。",
        "一曲吴歌齐拍手，十年尘眼未曾开。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 284802,
      "title": "西京道德里",
      "content": [
        "秦树团团夕结阴，此中庄舃动悲吟。",
        "一枝丹桂未入手，万里苍波长负心。",
        "老去渐知时态薄，愁来唯愿酒杯深。",
        "七雄三杰今何在，休为闲人泪满襟。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 284803,
      "title": "忆夏口",
      "content": [
        "汉阳渡口兰为舟，汉阳城下多酒楼。",
        "当年不得尽一醉，别梦有时还重游。",
        "襟带可怜吞楚塞，风烟只好狎江鸥。",
        "月明更想曾行处，吹笛桥边木叶秋。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 284804,
      "title": "武牢关",
      "content": [
        "楚人曾此限封疆，不见清阴六里长。",
        "一壑暮声何怨望，数峰秋势自颠狂。",
        "由来四皓须神伏，大抵秦皇谩气强。",
        "欲学鸡鸣试关吏，太平时节嬾思量。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 284805,
      "title": "途中献晋州孟中丞",
      "content": [
        "太平天子念蒲东，又委星郎养育功。",
        "昨日隼旟辞阙下，今朝珠履在河中。",
        "楼移庾亮千山月，树待袁宏一扇风。",
        "不及政成应入拜，晋州何足展清通。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 284806,
      "title": "长安秋夜",
      "content": [
        "远闻天子似羲皇，偶舍渔乡入帝乡。",
        "五等列侯无故旧，一枝仙桂有风霜。",
        "灯欹短焰烧离鬓，漏转寒更滴旅肠。",
        "归计未知身已老，九衢双阙夜苍苍。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 284807,
      "title": "春晚寄钟尚书",
      "content": [
        "宰府初开忝末尘，四年谈笑隔通津。",
        "官资肯便矜中路，酒醆还应忆故人。",
        "江畔旧游秦望月，槛前公事镜湖春。",
        "如今莫问西禅坞，一炷寒香老病身。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 284808,
      "title": "秋晓寄友人",
      "content": [
        "洞庭霜落水云秋，又泛轻涟任去留。",
        "世界高谈今已得，宦途清贵旧曾游。",
        "手中彩笔夸题凤，天上泥封奖狎鸥。",
        "更见南来钓翁说，醉吟还上木兰舟。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 284809,
      "title": "秋日有酬",
      "content": [
        "旧业传家有宝刀，近闻余力更挥毫。",
        "腰间印佩黄金重，卷里诗裁白雪高。",
        "䜩罢嘉宾迎凤藻，猎归诸将问龙韬。",
        "分茅列土才三十，犹拟廻头赌锦袍。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 284810,
      "title": "所思",
      "content": [
        "梁王兔苑荆榛里，炀帝鸡台梦想中。",
        "只觉惘然悲谢傅，未知何以报文翁。",
        "生灵不幸台星拆，造化无情世界空。",
        "划尽寒灰始堪叹，满庭霜叶一窗风。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 284811,
      "title": "送魏校书兼呈曹使君",
      "content": [
        "乱离无计驻生涯，又事东游惜岁华。",
        "村店酒旗沽竹叶，野桥梅雨泊芦花。",
        "讐书发迹官虽屈，负米安亲路不赊。",
        "应见使君论世旧，埽门重得向曹家。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 284812,
      "title": "四皓庙",
      "content": [
        "汉惠秦皇事已闻，庙前高木眼前云。",
        "楚王谩费闲心力，六里青山尽属君。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 284813,
      "title": "浮云",
      "content": [
        "溶溶曳曳自舒张，不向苍梧即帝乡。",
        "莫道无心便无事，也曾愁杀楚襄王。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 284814,
      "title": "早发",
      "content": [
        "北去南来无定居，此生生计竟何如。",
        "酷怜一觉平明睡，长被鸡声恶破除。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 284815,
      "title": "香",
      "content": [
        "沈水良材食柏珍，博山烟煖玉楼春。",
        "怜君亦是无端物，贪作馨香忘却身。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 284816,
      "title": "邺城",
      "content": [
        "台上年年揜翠蛾，台前高树夹漳河。",
        "英雄亦到分香处，能共常人较几多。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 284817,
      "title": "七夕",
      "content": [
        "络角星河菡萏天，一家懽笑设红筵。",
        "应倾谢女珠玑箧，尽写檀郎锦绣篇。",
        "香帐簇成排窈窕，金针穿罢拜婵娟。",
        "铜壶漏报天将晓，惆怅佳期又一年。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 284818,
      "title": "送臧𣸣下第谒窦鄜州",
      "content": [
        "赋得长杨不直钱，却来京口看莺迁。",
        "也知绛灌轻才子，好谒尤常醉少年。",
        "万里故乡云缥缈，一春生计泪澜汍。",
        "多情柱史应相问，与话归心正浩然。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 284819,
      "title": "清明日曲江怀友",
      "content": [
        "君与田苏即旧游，我于交分亦绸缪。",
        "二年隔绝黄泉下，尽日悲凉曲水头。",
        "鸥鸟似能齐物理，杏花疑欲伴人愁。",
        "寡妻稚子应寒食，遥望江陵一泪流。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 284820,
      "title": "送郑州严员外",
      "content": [
        "欲将刀笔润王猷，东去先分圣主忧。",
        "满扇好风吹郑圃，一车甘雨别皇州。",
        "尚书碛冷鸿声晚，仆射陂寒树影秋。",
        "从此文星在何处，武牢关外庾公楼。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 284821,
      "title": "孙员外赴阙后重到三衢",
      "content": [
        "远山高树思悠哉，重倚危楼尽一杯。",
        "谢守已随征诏入，鲁儒犹逐断蓬来。",
        "地寒谩忆移暄手，时急方须济世才。",
        "宣室夜阑如有问，可能全望未然灰。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 284822,
      "title": "衡阳泊木居士庙下作",
      "content": [
        "乌噪残阳草满庭，此中枯木似人形。",
        "只应神物长为主，未必浮槎即有灵。",
        "八月风波飘不去，四时黍稷荐惟馨。",
        "南朝庾信无因赋，牢落祠前水气腥。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 284823,
      "title": "钟陵见杨秀才",
      "content": [
        "孺亭滕阁少踟蹰，三度南游一事无。",
        "秪觉流年如鸟逝，不知何处有龙屠？",
        "云归洪井枝柯敛，水下漳江气色麤。",
        "赖得与君同此醉，醒来愁被鬼揶揄。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 284824,
      "title": "自湘川东下立春泊夏口阻风登孙权城",
      "content": [
        "吴门此去逾千里，湘浦离来想数旬。",
        "只见风师长占路，不知青帝已行春。",
        "危怜坏堞犹遮水，狂爱寒梅欲傍人。",
        "事往时移何足问，且凭村酒暖精神。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 284825,
      "title": "春日忆湖南旧游寄卢校书",
      "content": [
        "旅榜前年过洞庭，曾提刀笔事甘宁。",
        "瑇筵离隔将军幕，朱履频窥处士星。",
        "恩重匣中孤劒在，梦余江畔数峰青。",
        "金貂见服嘉宾散，回首昭丘一涕零。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 284826,
      "title": "贺淮南节度卢员外赐绯",
      "content": [
        "俭莲高贵九霄闻，粲粲朱衣降五云。",
        "骢马早年曾避路，银鱼今日且从军。",
        "御题彩服垂天眷，袍展花心透縠纹。",
        "应笑当年老莱子，鲜华都自降明君。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 284827,
      "title": "春日独游禅智寺",
      "content": [
        "树远连天水接空，几年行乐旧隋宫。",
        "花开花谢还如此，人去人来自不同。",
        "鸾凤调高何处酒，吴牛蹄健满车风。",
        "思量只合腾腾醉，煮海平陈一梦中。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 284828,
      "title": "和淮南李司空同转运员外",
      "content": [
        "层层高阁旧瀛洲，此地须征第一流。",
        "丞相近年萦倚望，重才今日喜遨游。",
        "荣持健笔金黄贵，恨咽离筵管吹秋。",
        "谁继伊臯送行句，梁王诗好郢人愁。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 284829,
      "title": "后土庙",
      "content": [
        "四海兵戈尚未宁，始于云外学仪形。",
        "九天玄女犹无圣，后土夫人岂有灵。",
        "一带好云侵鬓绿，两层危岫拂眉青。",
        "韦郎年少知何在，端坐思量太白经。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 284830,
      "title": "金陵夜泊",
      "content": [
        "冷烟轻澹傍衰丛，此夕秦淮驻断蓬。",
        "栖鴈远惊沽酒火，乱鵶高避落帆风。",
        "地销王气波声急，山带秋阴树影空。",
        "六代精灵人不见，思量应在月明中。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 284831,
      "title": "上江州陈员外",
      "content": [
        "寒江九派转城楼，东下钟陵第一州。",
        "人自中台方贵盛，地从西晋即风流。",
        "旧班久望鹓晴翥，余力犹闻虎夜浮。",
        "应恨属官无健令，异时佳节阻闲游。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 284832,
      "title": "广陵开元寺阁上作",
      "content": [
        "满槛山川漾落晖，槛前前事去如飞。",
        "云中鸡犬刘安过，月里笙歌炀帝归。",
        "江蹙海门帆散去，地吞淮口树相依。",
        "红楼翠幕知多少，长向东风有是非。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 284833,
      "title": "上鄂州韦尚书",
      "content": [
        "往岁先皇驭九州，侍臣才业最风流。",
        "文穷典诰虽余力，俗致雍熙尽密谋。",
        "兰省换班青作绶，柏台前引绛为鞲。",
        "都缘未负江山兴，开济生灵校一秋。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 284834,
      "title": "早春巴陵道中",
      "content": [
        "远雪亭亭望未销，岳阳春浅似相饶。",
        "短芦冒土初生笋，高柳偷风已弄条。",
        "波泛洞庭㺍獭健，谷连荆楚鬼神妖。",
        "中流菱唱泊何处，一只画船兰作桡。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 284835,
      "title": "广陵秋日酬进士臧𣸣见寄",
      "content": [
        "驿西斜日满窗前，独凭秋栏思渺绵。",
        "数尺断蓬惭故国，一轮清镜泣流年。",
        "已知世事真徒尔，纵有心期亦偶然。",
        "空媿荀家好兄弟，鴈来鱼去是因缘。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 284836,
      "title": "淮南送李司空朝觐",
      "content": [
        "圣君宵旰望时雍，丹诏西来雨露浓。",
        "宣父道高休叹凤，武侯才大本吟龙。",
        "九州似鼎终须负，万物为铜只待镕。",
        "腊后春前更何事，便看经度奏东封。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 284837,
      "title": "秋日禅智寺见裴郎中题名寄韦瞻",
      "content": [
        "野寺疎钟万木秋，偶寻题处认名侯。",
        "官离南郡应闲暇，地胜东山想驻留。",
        "百醆浓醪成别梦，两行垂露澣羁愁。",
        "心知只有韦公在，更对真踪话旧游。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 284838,
      "title": "广陵春日忆池阳有寄",
      "content": [
        "烟水蒙蒙接板桥，数年经历驻征桡。",
        "醉凭危槛波千顷，愁倚长亭柳万条。",
        "别后故人冠獬豸，病来知己赏鹪鹩。",
        "清流夹宅千家住，会向闲乘一信潮。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 284839,
      "title": "春中湘中题岳麓寺僧舍",
      "content": [
        "蟾宫虎穴两皆休，来凭危栏送远愁。",
        "多事林莺还谩语，薄情边鴈不回头。",
        "春融只待乾坤醉，水阔深知世界浮。",
        "欲共高僧话心迹，野花芳草奈相尤。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 284840,
      "title": "出试后投所知",
      "content": [
        "此日蓬壶两日程，当时消息甚分明。",
        "桃须曼倩催方熟，橘待洪崖遣始行。",
        "岛外音书应有意，眼前尘士渐无情。",
        "莫教更似山西鼠，啮破愁肠恨一生。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 284841,
      "title": "湘南春日怀古",
      "content": [
        "晴江春暖兰蕙薰，凫鹥苒苒鸥著群。",
        "洛阳贾谊自无命，少陵杜甫兼有文。",
        "空阔远帆遮落日，苍茫野树碍归云。",
        "松醪酒好昭潭静，闲过中流一吊君。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 284842,
      "title": "江州望庐山",
      "content": [
        "东南苍翠何崔嵬，横流一望幽抱开。",
        "影寒已令水底去，脚阔欲过湖心来。",
        "深处不唯容鬼怪，暗中兼恐有风雷。",
        "仙人往往今谁在，红杏花香重首回。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 284843,
      "title": "金陵寄窦尚书",
      "content": [
        "二年岐路有西东，长忆优游楚驿中。",
        "虎帐谈高无客继，马卿官傲少人同。",
        "世危肯使依刘表，山好犹能忆谢公。",
        "此去此恩言不得，谩将闲泪对春风。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 284844,
      "title": "清溪江令公宅",
      "content": [
        "蛮牋象管夜深时，曾赋陈宫第一诗。",
        "宴罢风流人不见，废来踪迹草应知。",
        "莺怜胜事啼空巷，蜨恋余香舞好枝。",
        "还有往年金甃井，牧童樵叟等闲窥。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 284845,
      "title": "郑州献卢舍人",
      "content": [
        "海槎闲暇阆风轻，不是安流不肯行。",
        "鸡省露浓汤饼熟，凤池烟暖诏书成。",
        "渔筹已合光儒梦，尧印何妨且治兵。",
        "会将两都收复后，右图仪表左题名。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 284846,
      "title": "别池阳所居",
      "content": [
        "黄尘初起此留连，火耨刀耕六七年。",
        "雨夜老农伤水旱，雪晴渔父共舟船。",
        "已悲世乱身须去，肯媿途危迹屡迁。",
        "却是九华山有意，列行相送到江边。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 284847,
      "title": "送内使周大夫自杭州朝贡",
      "content": [
        "八都上将近平戎，便附輶轩奏圣聪。",
        "三接驾前朝觐礼，一函江表战征功。",
        "云间阆苑何时见，水底瑶池触处通。",
        "知有殿庭余力在，莫辞消息寄西风。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 284848,
      "title": "酬黄从事怀旧见寄",
      "content": [
        "旧游不合到心中，把得君诗意亦同。",
        "水馆酒阑清夜月，香街人散白杨风。",
        "长绳系日虽难绊，辨口谈天不易穷。",
        "世事自随蓬转在，思量何处是飞蓬。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 284849,
      "title": "绣",
      "content": [
        "一片丝罗□□□，洞房西室女工劳。",
        "花随玉指添春色，鸟逐金针长羽毛。",
        "蜀绵谩夸声自贵，越绫虚说价功高。",
        "可中用作鸳鸯被，红叶枝枝不碍刀。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 284850,
      "title": "西施",
      "content": [
        "家国兴亡自有时，吴人何苦怨西施。",
        "西施若解倾吴国，越国亡来又是谁。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 284851,
      "title": "自遣",
      "content": [
        "得即高歌失即休，多愁多恨亦悠悠。",
        "今朝有酒今朝醉，明日愁来明日愁。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 284852,
      "title": "白角箆",
      "content": [
        "白似琼瑶滑似苔，随梳伴镜拂尘埃。",
        "莫言此个尖头物，几度撩人恶髪来。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 284853,
      "title": "铜雀台",
      "content": [
        "强歌强舞竟难胜，花落花开泪满膺。",
        "秪合当年伴君死，免交憔悴望西陵。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 284854,
      "title": "鹦鹉",
      "content": [
        "莫恨雕笼翠羽残，江南地暖陇西寒。",
        "劝君不用分明语，语得分明出转难。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 284855,
      "title": "金钱花",
      "content": [
        "占得佳名绕树芳，依依相伴向秋光。",
        "若教此物堪收贮，应被豪门尽㔉将。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 284856,
      "title": "梅",
      "content": [
        "天赐胭脂一抹腮，盘中磊落笛中哀。",
        "虽然未得和羹便，曾与将军止渴来。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 284857,
      "title": "钱尚父生日",
      "content": [
        "大昴分光降斗牛，兴唐宗社作诸侯。",
        "伊夔事业扶千载，韩白机谋冠九州。",
        "贵盛上持龙节钺，延长应续鹤春秋。",
        "锦衣玉食将何报，更俟庄椿一举头。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 284858,
      "title": "寄前户部陆郎中",
      "content": [
        "出驯桑雉入朝簪，萧洒清名映士林。",
        "近日篇章欺白雪，早年词赋得黄金。",
        "桂堂纵道探龙颔，兰省何曾驻鹤心。",
        "离乱事多人不会，酒浓花暖且闲吟。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 284859,
      "title": "登瓦棺寺阁",
      "content": [
        "下盘空迹上云浮，偶逐僧行步步愁。",
        "暂憩已知须用意，渐来争忍不回头。",
        "烟中树老重江晚，铎外风轻四境秋。",
        "嬾指台城更东望，鹊飞龙鬬尽荒丘。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 284860,
      "title": "九华山费征君所居",
      "content": [
        "草堂何处试徘徊，见说遗踪向此开。",
        "蟾桂自归三径后，鹤书曾降九天来。",
        "白云事迹依前在，青琐光阴竟不回。",
        "尽夕为君思曩日，野泉呜咽路莓苔。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 284861,
      "title": "途中寄怀",
      "content": [
        "不知何处是前程，合眼腾腾信马行。",
        "两鬓已衰时未遇，数峰虽在病相撄。",
        "尘埃巩洛虚光景，诗酒江湖漫姓名。",
        "试哭军门看谁问，旧来还似祢先生。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 284862,
      "title": "京口见李侍郎",
      "content": [
        "傞傞江柳欲矜春，铁瓮城边见故人。",
        "屈指不堪言甲子，披风常记是庚申。",
        "别来且喜身俱健，乱后休悲业尽贫。",
        "还有杖头沽酒物，待寻山寺话逡巡。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 284863,
      "title": "秋日酬张特玄",
      "content": [
        "病寄南徐两度秋，故人依约亦扬州。",
        "偶因鴈足思闲事，拟棹孤舟访旧游。",
        "风急几闻江上笛，月高谁共酒家楼。",
        "平生意气消磨尽，甘露轩前看水流。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 284864,
      "title": "登高咏菊尽",
      "content": [
        "篱畔霜前偶得存，苦教迟晚避兰荪。",
        "能销造化几多力，不受阳和一点恩。",
        "生处岂容依玉砌，要时还许上金罇。",
        "陶公没后无知己，露滴幽丛见泪痕。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 284865,
      "title": "登夏州城楼",
      "content": [
        "寒城猎猎戍旗风，独倚危楼怅望中。",
        "万里山河唐土地，千年魂魄晋英雄。",
        "离心不忍听边马，往事应须问塞鸿。",
        "好脱儒冠从校尉，一枝长戟六钧弓。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 284866,
      "title": "水边偶题",
      "content": [
        "野水无情去不回，水边花好为谁开。",
        "只知事逐眼前去，不觉老从头上来。",
        "穷似丘轲休叹息，达如周召亦尘埃。",
        "思量此理何人会，蒙邑先生最有才。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
