{
  "data": [
    {
      "id": 258697,
      "title": "江行无题一百首 二十三",
      "content": [
        "帆翅初张处，云鹏怒翼同。",
        "莫愁千里路，自有到来风。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 258698,
      "title": "江行无题一百首 二十四",
      "content": [
        "秋云久无雨，江燕社犹飞。",
        "却笑舟中客，今年未得归。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 258699,
      "title": "江行无题一百首 二十五",
      "content": [
        "佳节虽逢菊，浮生正似萍。",
        "故山何处望，荒岸小长亭。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 258700,
      "title": "江行无题一百首 二十六",
      "content": [
        "行到楚江岸，苍茫人正迷。",
        "秖知秦塞远，格磔鹧鸪啼。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 258701,
      "title": "江行无题一百首 二十七",
      "content": [
        "月下江流静，村荒人语稀。",
        "鹭鸶虽有伴，仍共影双飞。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 258702,
      "title": "江行无题一百首 二十八",
      "content": [
        "斗转月未落，舟行夜已深。",
        "有村知不远，风便数声砧。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 258703,
      "title": "江行无题一百首 二十九",
      "content": [
        "櫂惊沙鸟迅，飞溅夕阳波。",
        "不顾鱼多处，应防一目罗。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 258704,
      "title": "江行无题一百首 三十",
      "content": [
        "渐觉江天远，难逢故国书。",
        "可能无往事，空食鼎中鱼。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 258705,
      "title": "江行无题一百首 三十一",
      "content": [
        "岸草连荒色，村声乐稔年。",
        "晚晴初获稻，闲却采莲船。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 258706,
      "title": "江行无题一百首 三十二",
      "content": [
        "滩浅争游鹭，江清易见鱼。",
        "怪来吟未足，秋物欠红蕖。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 258707,
      "title": "江行无题一百首 三十三",
      "content": [
        "蛩响依莎草，萤飞透水烟。",
        "夜凉谁咏史，空泊运租船。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 258708,
      "title": "江行无题一百首 三十四",
      "content": [
        "睡稳叶舟轻，风微浪不惊。",
        "任君芦苇岸，终夜动秋声。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 258709,
      "title": "江行无题一百首 三十五",
      "content": [
        "自念平生意，曾期一郡符。",
        "岂知因谪宦，斑鬓入江湖。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 258710,
      "title": "江行无题一百首 三十六",
      "content": [
        "烟渚复烟渚，画屏休画屏。",
        "引愁天末去，数点暮山青。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 258711,
      "title": "江行无题一百首 三十七",
      "content": [
        "水天凉夜月，不是惜清光。",
        "好物随人秘，秦淮忆建康。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 258712,
      "title": "江行无题一百首 三十八",
      "content": [
        "古来多思客，摇落恨江潭。",
        "今日秋风至，萧疎独沔南。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 258713,
      "title": "江行无题一百首 三十九",
      "content": [
        "暎竹疑村好，穿芦觉渚幽。",
        "渐安无旷土，姜芋当农收。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 258714,
      "title": "江行无题一百首 四十",
      "content": [
        "秋风动客心，寂寂不成吟。",
        "飞上危樯立，啼乌报好音。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 258715,
      "title": "江行无题一百首 四十一",
      "content": [
        "见底高秋水，开怀万里天。",
        "旅吟还有伴，沙柳数枝蝉。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 258716,
      "title": "江行无题一百首 四十二",
      "content": [
        "九日自佳节，扁舟无一杯。",
        "曹园旧尊酒，戏马忆高台。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 258717,
      "title": "江行无题一百首 四十三",
      "content": [
        "兵火有余烬，贫村才数家。",
        "无人争晓渡，残月下寒沙。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 258718,
      "title": "江行无题一百首 四十四",
      "content": [
        "渚禽菱芡足，不向稻粱争。",
        "静宿凉湾月，应无失侣声。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 258719,
      "title": "江行无题一百首 四十五",
      "content": [
        "轻云未护霜，树杪橘初黄。",
        "信是知名物，微风过水香。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 258720,
      "title": "江行无题一百首 四十六",
      "content": [
        "渺渺望天涯，清涟浸赤霞。",
        "难逢星汉使，乌鹊日乘槎。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 258721,
      "title": "江行无题一百首 四十七",
      "content": [
        "土旷深耕少，江平远钓多。",
        "生平皆弃本，金革竟如何。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 258722,
      "title": "江行无题一百首 四十八",
      "content": [
        "海月非常物，等闲不可寻。",
        "披沙应有地，浅处定无金。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 258723,
      "title": "江行无题一百首 四十九",
      "content": [
        "风晚冷飕飕，芦花已白头。",
        "旧来红叶寺，堪忆玉京秋。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 258724,
      "title": "江行无题一百首 五十",
      "content": [
        "风好来无阵，云闲去有踪。",
        "钓歌无远近，应喜罢艨艟。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 258725,
      "title": "江行无题一百首 五十一",
      "content": [
        "吴疆连楚甸，楚俗异吴乡。",
        "漫把尊中物，无人啄蟹筐。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 258726,
      "title": "江行无题一百首 五十二",
      "content": [
        "岸绿野烟远，江红斜照微。",
        "撑开小渔艇，应到月明归。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 258727,
      "title": "江行无题一百首 五十三",
      "content": [
        "雨余江始涨，漾漾见流薪。",
        "曾叹河中木，斯言忆古人。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 258728,
      "title": "江行无题一百首 五十四",
      "content": [
        "叶舟维夏口，烟野独行时。",
        "不见头陀寺，空怀幼妇碑。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 258729,
      "title": "江行无题一百首 五十五",
      "content": [
        "晚泊武昌岸，津亭疎柳风。",
        "数株曾手植，好事忆陶公。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 258730,
      "title": "江行无题一百首 五十六",
      "content": [
        "坠露晓犹浓，秋花不易逢。",
        "涉江虽已晚，高树搴芙蓉。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 258731,
      "title": "江行无题一百首 五十七",
      "content": [
        "舟航依浦定，星斗满江寒。",
        "若比阴霾日，何妨夜未阑。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 258732,
      "title": "江行无题一百首 五十八",
      "content": [
        "近戍离金落，孤岑望火门。",
        "唯将知命意，潇洒向乾坤。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 258733,
      "title": "江行无题一百首 五十九",
      "content": [
        "丛菊生堤上，此花长后时。",
        "有人还采掇，何必在春期。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 258734,
      "title": "江行无题一百首 六十",
      "content": [
        "夕景残霞落，秋寒细雨晴。",
        "短缨何用濯，舟在月中行。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 258735,
      "title": "江行无题一百首 六十一",
      "content": [
        "堤坏漏江水，地坳成野塘。",
        "晚荷人不折，留取作秋香。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 258736,
      "title": "江行无题一百首 六十二",
      "content": [
        "左宦终何路，摅怀亦自宽。",
        "襞牋嘲白鹭，无意喻枭鸾。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 258737,
      "title": "江行无题一百首 六十三",
      "content": [
        "楼空人不归，云似去时衣。",
        "黄鹤无心下，长应笑令威。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 258738,
      "title": "江行无题一百首 六十四",
      "content": [
        "白帝朝惊浪，浔阳暮暎云。",
        "等闲生险易，世路秖如君。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 258739,
      "title": "江行无题一百首 六十五",
      "content": [
        "橹慢开轻浪，帆虚带白云。",
        "客船虽狭小，容得庾将军。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 258740,
      "title": "江行无题一百首 六十六",
      "content": [
        "风雨正甘寝，云霓忽晚晴。",
        "放歌虽自遣，一岁又峥嵘。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 258741,
      "title": "江行无题一百首 六十七",
      "content": [
        "静看秋江水，风微浪渐平。",
        "人间驰竞处，尘土自波成。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 258742,
      "title": "江行无题一百首 六十八",
      "content": [
        "风劲帆方疾，风回櫂却迟。",
        "较量人世事，不校一毫厘。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 258743,
      "title": "江行无题一百首 六十九",
      "content": [
        "咫尺愁风雨，匡庐不可登。",
        "秖疑云雾窟，犹有六朝僧。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 258744,
      "title": "江行无题一百首 七十",
      "content": [
        "幽思正迟迟，沙边濯弄时。",
        "自怜非博物，犹未识凫葵。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 258745,
      "title": "江行无题一百首 七十一",
      "content": [
        "曾有烟波客，能歌西塞山。",
        "落帆唯待月，一钓紫菱湾。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 258746,
      "title": "江行无题一百首 七十二",
      "content": [
        "千顷水纹细，一拳岚影孤。",
        "君山寒树绿，曾过洞庭湖。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 258747,
      "title": "江行无题一百首 七十三",
      "content": [
        "光阔重湖水，低斜远雁行。",
        "未曾无兴咏，多谢沈东阳。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 258748,
      "title": "江行无题一百首 七十四",
      "content": [
        "晚菊绕江垒，忽如开古屏。",
        "莫言时节过，白日有余馨。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 258749,
      "title": "江行无题一百首 七十五",
      "content": [
        "秋寒鹰隼健，逐雀下云空。",
        "知是江湖阔，无心击塞鸿。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 258750,
      "title": "江行无题一百首 七十六",
      "content": [
        "日落长亭晚，山门步障青。",
        "可怜无酒分，处处有旗亭。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 258751,
      "title": "江行无题一百首 七十七",
      "content": [
        "江草何多思，冬青尚满洲。",
        "谁能惊𫛳鸟，作赋为沙鸥。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 258752,
      "title": "江行无题一百首 七十八",
      "content": [
        "远岸无行树，经霜有半红。",
        "停船搜好句，题叶赠江枫。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 258753,
      "title": "江行无题一百首 七十九",
      "content": [
        "身世比行舟，无风亦暂休。",
        "敢言终破浪，唯愿稳乘流。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 258754,
      "title": "江行无题一百首 八十",
      "content": [
        "数亩苍苔石，烟蒙鹤卵洲。",
        "定因词客遇，名字始风流。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 258755,
      "title": "江行无题一百首 八十一",
      "content": [
        "兴闲停桂楫，路好过松门。",
        "不负佳山水，还开酒一尊。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 258756,
      "title": "江行无题一百首 八十二",
      "content": [
        "幽怀念烟水，长恨隔龙沙。",
        "今日膝王阁，分明见落霞。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 258757,
      "title": "江行无题一百首 八十三",
      "content": [
        "短楫休敲桂，孤根自驻萍。",
        "自怜非劒气，空向斗牛星。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 258758,
      "title": "江行无题一百首 八十四",
      "content": [
        "江流何渺渺，怀古独依依。",
        "渔父非贤者，芦中但有矶。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 258759,
      "title": "江行无题一百首 八十五",
      "content": [
        "高浪如银屋，江风一发时。",
        "笔端降太白，才大语终奇。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 258760,
      "title": "江行无题一百首 八十六",
      "content": [
        "细竹渔家路，晴阳看结缯。",
        "喜来邀客坐，分与折腰菱。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 258761,
      "title": "江行无题一百首 八十七",
      "content": [
        "幸有烟波兴，宁辞笔砚劳。",
        "缘情无怨刺，却似反离骚。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 258762,
      "title": "江行无题一百首 八十八",
      "content": [
        "平湖五百里，江水想通波。",
        "不奈扁舟去，其如决计何。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 258763,
      "title": "江行无题一百首 八十九",
      "content": [
        "数峰云断处，去岸暎高山。",
        "身到韦江日，犹应未得闲。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 258764,
      "title": "江行无题一百首 九十",
      "content": [
        "一湾斜照水，三版顺风船。",
        "未敢相邀约，劳生秖自怜。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 258765,
      "title": "江行无题一百首 九十一",
      "content": [
        "江雨正霏微，江村晚渡稀。",
        "何曾妨钓艇，更待得鱼归。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 258766,
      "title": "江行无题一百首 九十二",
      "content": [
        "沙上独行时，高吟到楚词。",
        "难将垂岸蓼，盈把当江蓠。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 258767,
      "title": "江行无题一百首 九十三",
      "content": [
        "新野旧楼名，浔阳胜赏情。",
        "照人长一色，江月共凄清。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 258768,
      "title": "江行无题一百首 九十四",
      "content": [
        "愿饮西江水，那吟北渚愁。",
        "莫教留滞迹，远比蔡昭侯。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 258769,
      "title": "江行无题一百首 九十五",
      "content": [
        "湖口分江水，东流独有情。",
        "当时好风物，谁伴谢宣城。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 258770,
      "title": "江行无题一百首 九十六",
      "content": [
        "浔阳江畔菊，应似古来秋。",
        "为问幽栖客，吟时得酒不。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 258771,
      "title": "江行无题一百首 九十七",
      "content": [
        "高峰有佳号，千尺倚寒松。",
        "若使𬬻烟在，犹应为上公。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 258772,
      "title": "江行无题一百首 九十八",
      "content": [
        "万木已清霜，江边村事忙。",
        "故溪黄稻熟，一夜梦中香。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 258773,
      "title": "江行无题一百首 九十九",
      "content": [
        "楚水苦萦回，征帆落又开。",
        "可缘非直路，却有好风来。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 258774,
      "title": "江行无题一百首 一百",
      "content": [
        "远谪岁时晏，暮江风雨寒。",
        "仍愁系舟处，惊梦近长滩。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 258775,
      "title": "言怀",
      "content": [
        "夜月霁未好，云泉堪梦归。",
        "如何建章漏，催著早朝衣。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 258776,
      "title": "和张仆射塞下曲",
      "content": [
        "月黑雁飞高，单于夜遁逃。",
        "欲将轻骑逐，大雪满弓刀。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 258777,
      "title": "送李明府去官",
      "content": [
        "谤言三至后，直道叹何如。",
        "今日蓝溪水，无人不夜鱼。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 258778,
      "title": "赴章陵詶李卿赠别",
      "content": [
        "一官叨下秩，九棘谢知音。",
        "芳草文园路，春愁满别心。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 258779,
      "title": "逢侠者",
      "content": [
        "燕赵悲歌士，相逢剧孟家。",
        "寸心言不尽，前路日将斜。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 258780,
      "title": "郎员外见寻不遇",
      "content": [
        "轩骑来相访，渔樵悔晚归。",
        "更怜垂露迹，花里点墙衣。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 258781,
      "title": "过李侍御宅",
      "content": [
        "不见承明客，愁闻长乐钟。",
        "马卿何早世，汉主欲登封。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 258782,
      "title": "宿洞口馆",
      "content": [
        "野竹通溪冷，秋泉入户鸣。",
        "乱来人不到，芳草上堦生。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 258783,
      "title": "九日寄姪箊箕等",
      "content": [
        "采菊偏相忆，传香寄便风。",
        "今朝竹林下，莫使桂尊空。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 258784,
      "title": "梨花",
      "content": [
        "艳静如笼月，香寒未逐风。",
        "桃花徒照地，终被笑妖红。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 258785,
      "title": "题崔逸人山亭",
      "content": [
        "药径深红藓，山窗满翠微。",
        "羡君花下酒，蝴蝶梦中飞。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 258786,
      "title": "蓝田溪杂咏二十二首 登台",
      "content": [
        "望山登春台，目尽趣难极。",
        "晚景下平阡，花际霞峰色。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 258787,
      "title": "蓝田溪杂咏二十二首 板桥",
      "content": [
        "静宜樵隐度，远与车马隔。",
        "有时行药来，喜遇归山客。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 258788,
      "title": "蓝田溪杂咏二十二首 石井",
      "content": [
        "片霞照仙井，泉底桃花红。",
        "那知幽石下，不与武陵通。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 258789,
      "title": "蓝田溪杂咏二十二首 古藤",
      "content": [
        "引蔓出云树，垂纶覆巢鹤。",
        "幽人对酒时，苔上闲花落。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 258790,
      "title": "蓝田溪杂咏二十二首 晚归鹭",
      "content": [
        "池上静难厌，云间欲去晚。",
        "忽背夕阳飞，乘兴清风远。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 258791,
      "title": "蓝田溪杂咏二十二首 洞仙谣",
      "content": [
        "几转到青山，数重度流水。",
        "秦人入云去，知向桃源里。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 258792,
      "title": "蓝田溪杂咏二十二首 药圃",
      "content": [
        "春畦生百药，花叶香初霁。",
        "好容似风光，偏来入丛蕙。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 258793,
      "title": "蓝田溪杂咏二十二首 石上苔",
      "content": [
        "净与溪色连，幽宜松雨滴。",
        "谁知古石上，不染世人迹。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 258794,
      "title": "蓝田溪杂咏二十二首 窗里山",
      "content": [
        "远岫见如近，千里一窗里。",
        "坐来石上云，乍谓壶中起。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 258795,
      "title": "蓝田溪杂咏二十二首 竹间路",
      "content": [
        "暗归草堂静，半入花园去。",
        "有时载酒来，不与清风遇。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 258796,
      "title": "蓝田溪杂咏二十二首 竹屿",
      "content": [
        "幽鸟清涟上，兴来看不足。",
        "新篁压水低，昨夜鸳鸯宿。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    }
  ],
