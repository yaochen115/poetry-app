{
  "data": [
    {
      "id": 174088,
      "title": "鹤林寺",
      "content": [
        "昔人春尽强登山，只肯逢僧半日闲。",
        "何似一尊乘兴去，醉中骑马月中还。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 174089,
      "title": "送关彦远赴河北",
      "content": [
        "子明高谊众人知，苗裔清材世所推。",
        "诗作士林夸刻烛，赋成天路喜同时。",
        "岂当白首淹风力，自合青云纵羽仪。",
        "北部经营应不久，玉阶朝夕是归期。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 174090,
      "title": "正月十一日迎驾呈诸同舍",
      "content": [
        "锦袍周卫一番新，警跸朝严下紫宸。",
        "俗眼望来犹眩日，天颜回处自生春。",
        "行齐鹓鹭常随仗，步稳骅骝不起尘。",
        "归路青云喧鼓吹，乐游从此属都人。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 174091,
      "title": "和御制上元观灯",
      "content": [
        "翠幰霓旌夹露台，夜凉宫扇月中开。",
        "龙衔烛抱金门出，鳌负山趋玉座来。",
        "砀极戏添夷客喜，柏梁篇较从臣材。",
        "共知天意同民乐，愿奏君王万寿杯。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 174092,
      "title": "和史馆相公上元观灯",
      "content": [
        "九衢仙仗豫游归，宝烛星繁换夕晖。",
        "传醆未斜清禁月，散花还拂侍臣衣。",
        "天香暗度金虬暖，宫扇双开彩凤飞。",
        "法曲世人听未足，却迎朱辇下端闱。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 174093,
      "title": "集贤殿春燕呈诸同舍",
      "content": [
        "御炉风细麝烟浮，法乐声和酒味柔。",
        "冠剑九重霄汉路，鶑花三月帝王州。",
        "垂廊四合盘龙幕，当殿双高彩凤楼。",
        "归去人人夸雨露，总含欢意跃骅骝。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 174094,
      "title": "上巳日瑞圣园锡燕呈诸同舍",
      "content": [
        "北上郊原一据鞭，华林清集缀儒冠。",
        "方塘渰渰春先渌，密竹娟娟午更寒。",
        "流渚酒浮金凿落，照庭花并玉阑干。",
        "君恩倍觉丘山重，长日从容笑语欢。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 174095,
      "title": "池上即席送况之赴宣城",
      "content": [
        "池上红深绿浅时，春风荡漾水逶迤。",
        "南州鼓舞归慈惠，东观壶觞惜别离。",
        "远岫烟云供醉眼，双溪鱼鸟付新诗。",
        "陵阳岂是迟留地，趣驾追锋自有期。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 174096,
      "title": "寄题饶君茂才葆光庵",
      "content": [
        "适意藜羹与布裘，结庐人境地还幽。",
        "清谈汝水孤猿夜，爽气麻源一叶秋。",
        "应有风骚归健笔，可无尊酒付扁舟。",
        "因君更起家园兴，梦寐思从几杖游。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 174097,
      "title": "朝退即事呈大尹正仲龙图",
      "content": [
        "六街尘断早凉生，细葛含风体更清。",
        "官府吏闲时乐易，市廛人喜政和平。",
        "挥金蔌蔌宫槐蕊，鸣玉淙淙御水声。",
        "观阙渐迎初日上，马头还傍绿阴行。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 174098,
      "title": "喜晴赴田中",
      "content": [
        "自愁雨破西岭出，只看水缘南涧生。",
        "青天忽从树杪见，白日渐向谷中明。",
        "豳公涤场不可失，陶令负禾须自行。",
        "归时小榼搊亦满，固有阿连相伴倾。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 174099,
      "title": "少年",
      "content": [
        "不复论心与少年，世间情伪久茫然。",
        "朱门如市方招客，独守残经自可怜。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 174100,
      "title": "上杜相三首  其一",
      "content": [
        "天扶昌代得忠良，坐以材谋镇庙堂。",
        "万里声名开学校，四方根本劝农桑。",
        "从容贤路通江海，慷慨公心贯雪霜。",
        "谦让黑辕归太早，空令终古爱余芳。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 174101,
      "title": "上杜相三首  其二",
      "content": [
        "翊戴唐虞旦暮中，忽将符节抚山东。",
        "忆归慷慨无私计，抗疏频烦有古风。",
        "世路一人知进退，士林当日计穷通。",
        "寿觞须祝年年喜，旧德华夷望更隆。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 174102,
      "title": "上杜相三首  其三",
      "content": [
        "转觉忧余好尚孤，较量唯合老葭蒲。",
        "圣贤可是随时拙，正直由来济世迂。",
        "生事有亲甘钓筑，客情无力买山湖。",
        "天边愁绝伤离苦，台象空看照宋都。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 174103,
      "title": "寄王荆公介甫",
      "content": [
        "数病门稀出，常贫客少过。",
        "经纶知龃龉，耕钓亦蹉跎。",
        "两事艰难极，孤心感慨多。",
        "素交千里远，谁听此时歌。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 174104,
      "title": "送王补之归南城",
      "content": [
        "瘦马君将去，清樽我谩开。",
        "眼看新雨露，身带旧尘埃。",
        "但喜丹心在，休惊白发催。",
        "穷通莫须问，功业有时来。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 174105,
      "title": "和酬王平甫道中见寄",
      "content": [
        "安危魁柄倚谁操，敛笏千官拱赭袍。",
        "能有本根持国论，岂须毫发间戎韬。",
        "征求借借人多困，羁旅皇皇我亦劳。",
        "栖宿与君何计得，半生飘荡似风毛。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 174106,
      "title": "读孟子",
      "content": [
        "千载士推无比拟，一编吾喜窃窥观。",
        "苟非此道知音少，安有兹人得志难。",
        "机巧满朝论势利，疮痍连室叹饥寒。",
        "先生自是齐梁客，谁作商岩渭水看。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 174107,
      "title": "圣贤",
      "content": [
        "圣贤性分良难并，好恶情怀岂得同。",
        "荀子书犹非孟子，召公心未悦周公。",
        "况令树立追高远，而使裁量属暗蒙。",
        "举世不知何足怪，力行无顾是豪雄。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 174108,
      "title": "寄晋州孙学士",
      "content": [
        "风标闲淡易为安，晋陕应忘道路难。",
        "学似海收天下水，性如桂奈月中寒。",
        "素心已向新书见，大法常留后世看。",
        "自送西舟江上别，孤怀经岁未能宽。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 174109,
      "title": "送戚郎中",
      "content": [
        "一心清淡本如秋，何必锱铢较两州。",
        "身向宦名虽黾勉，性于人事岂雕锼。",
        "但思簿领忙时俗，便觉溪山静处优。",
        "荔子满盘宁易得，与谁频宴岭边楼。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 174110,
      "title": "李供奉",
      "content": [
        "一身得禄从孤客，千里还丧获旧林。",
        "清节萧条妻子计，白头敦笃弟兄心。",
        "能抛印绶高应少，自筑丘坟达更深。",
        "我与往来无力荐，褒传唯有北窗吟。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 174111,
      "title": "寄孙正之二首  其一",
      "content": [
        "两人怀抱喜相投，初得青山一日游。",
        "已听高文吟太古，更开昏眼洗清流。",
        "共寻素壁题皆遍，欲去红桥钓始休。",
        "回首至今嘉兴在，梦魂犹拟奉觥筹。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 174112,
      "title": "寄孙正之二首  其二",
      "content": [
        "隠似龙蛇应有待，清□冰雪更无双。",
        "志留世外虽遗俗，文落人间或过江。",
        "峻节但期终老学，健诗犹愧一时降。",
        "风骚近亦思强伴，恨未高吟共北窗。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 174113,
      "title": "依韵和酬提刑都官寒食阻风见寄",
      "content": [
        "画舡齐泊倚青山，正值春风阻往还。",
        "江作鼓鼙声浩渺，树为城障绿回环。",
        "幽花婀娜偏当眼，啼鸟交加亦解颜。",
        "使者文章工不浅，尽将模写寄柴关。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 174114,
      "title": "杜鹃",
      "content": [
        "杜鹃花上杜鹃啼，自有归心似见机。",
        "人各有求难意合，何须勤苦劝人归。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 174115,
      "title": "雨中",
      "content": [
        "愁烟苦雨今朝是，小屋深扉野性怜。",
        "偶似鲁连能肆志，肯如刘备耻求田。",
        "贫谙亲友难过饮，病笑诗书可枕眠。",
        "欲会此心何自适，平生消长任陶甄。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 174116,
      "title": "题祝道士房",
      "content": [
        "悠悠行处是风波，万事万惊久琢磨。",
        "心逐世情知龃龉，身求闲伴恐蹉跎。",
        "功名自古时应少，山水输君乐最多。",
        "争得有田收迹去，比中文酒数经过。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 174117,
      "title": "题宝月大师法喜堂",
      "content": [
        "谁能怀抱信分明，扰扰相欺是世情。",
        "只有陋儒夸势利，几曾高位功名。",
        "欲将志义期千载，只合溪山过一生。",
        "君向此堂应笑我，病身南北正营营。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 174118,
      "title": "题关都官宅",
      "content": [
        "麻衣少壮干时去，朱绂康强得老归。",
        "身世自如天下少，利名难退古来稀。",
        "更无俗事侵方寸，只与闲人话翠微。",
        "科第诸郎同日显，高门当代有光辉。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 174119,
      "title": "题修广房",
      "content": [
        "世情衮衮利名间，子有高情独闭关。",
        "万事长年抛似梦，一堂终日静于山。",
        "幽花得地无妍丑，好鸟窥人自往还。",
        "药箓棋枰俱我好，几时能共此中闲。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 174120,
      "title": "田中作",
      "content": [
        "傍人应总笑为生，病体朝朝踏雨行。",
        "红饭白菹妻具饷，青秧绿水自催耕。",
        "止知索寞箪瓢计，岂论喧哗内素名。",
        "胜事山风吹木石，暂如韶夏管弦声。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 174121,
      "title": "寄人",
      "content": [
        "懒听诗书散满床，鬓须垂白坐茅堂。",
        "溪山入手何时见，尘土劳心继日忙。",
        "气味向人卑可耻，风波随处险难当。",
        "羡君出处由胸臆，安稳将家水石傍。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 174122,
      "title": "首夏",
      "content": [
        "乱崖蒸润滴嵯峨，苒苒生云雨意多。",
        "已爱破山泉漱玉，更怜垂垅麦翻波。",
        "妖红落后新篁出，老绿浓时野鸟过。",
        "还与北窗添睡思，尽抛尘上养天和。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 174123,
      "title": "雹",
      "content": [
        "穷谷结时雷已动，荒台看处雪犹埋。",
        "崩腾沙雳乘风下，宛转珠玑压雨来。",
        "已激山声如骇浪，更回天色似寒灰。",
        "何繇得见晴辉上，愁放昏昏睡眼开。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 174124,
      "title": "初冬道中",
      "content": [
        "潦退蛟螭不可逃，溪潭清澈见秋毫。",
        "欲霜日射西山赤，渐冷天腾北极高。",
        "秀色更浓唯竹柏，孤根先动是蓬蒿。",
        "感时一抚青萍叹，马踏西风气自豪。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 174125,
      "title": "留山中诸君子见访",
      "content": [
        "茅舍开扉胜事稠，况携佳客此中游。",
        "妖红落后坚松在，南涧清时野潦收。",
        "林带寒烟如水合，山含晴日似尘浮。",
        "不嫌淡薄幽人趣，欲进藜羹更少留。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 174126,
      "title": "丰年有高廪",
      "content": [
        "盛德临昭旦，多祥获有年。",
        "嘉禾登羡溢，高廪积连延。",
        "田入丰维亿，仓收富且千。",
        "梦鱼谐素兆，如栉比前篇。",
        "瑞贶神之与，休明颂所传。",
        "粢盛繇此备，清庙荐恭虔。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 174127,
      "title": "将行陪贰车观灯",
      "content": [
        "行歌红粉满城欢，犹作常时五马看。",
        "忽忆使君身是客，一时挥泪逐金鞍。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 174128,
      "title": "赴齐州",
      "content": [
        "淮南蒙召鬓毛斑，乞得东秦慰病颜。",
        "晓整轻鞍汶阳北，却冲微雨看青山。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 174129,
      "title": "恩藏主送古梅求诗",
      "content": [
        "折得前村雪里枝，殷勤来聘老夫诗。",
        "请公静看横斜影，便是当年一字师。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 174130,
      "title": "饯神",
      "content": [
        "击牲酾酒荐明蠲，饤果装香婢仆专。",
        "拣米作糜分糁椀，折篿为箸插芳筵。",
        "儿惊庖下添熏肉，神笑人间用纸钱。",
        "巫祝谓知来岁事，珓杯犹有暂时权。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 174131,
      "title": "千丈岩瀑布",
      "content": [
        "玉虬垂处雪花翻，四季雷声六月寒。",
        "凭槛未穷千丈势，请从岩下举头看。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 174132,
      "title": "疏山",
      "content": [
        "一见云山病眼清，野僧勤动水边迎。",
        "苍松翠竹东南道，乱石峰前踏月行。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 174133,
      "title": "石门",
      "content": [
        "细草疏云一径凉，纵吟闲望兴何长。",
        "僧关入竹行随意，野茹持钱得满筐。",
        "江腹远吞千壑翠，峡门高控两崖苍。",
        "乘秋更欲西山雨，一洗郊原晚稻香。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 174134,
      "title": "清风阁",
      "content": [
        "百级危梯屈曲成，栏干朱碧半空横。",
        "天垂远水秋容静，雪压群山霁色明。",
        "海燕力穷飞不到，郊园阴合坐犹清。",
        "风前有客须留醉，莫放归时月满城。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 174135,
      "title": "薛老亭晚归",
      "content": [
        "终日行山不出城，城中山势与云平。",
        "万家市井鱼盐合，千里川原彩错明。",
        "座上潮风醒酒力，晚来岩雾盖钟声。",
        "归时休得燃官烛，在处林灯夹道迎。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 174136,
      "title": "诗一首",
      "content": [
        "食肉遗马肝，未为不知味。",
        "食鱼必河豚，此理果何谓。",
        "非鳞亦非介，芒刺皮如猬。",
        "见形固可憎，况复论肠胃。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 174137,
      "title": "句  其一",
      "content": [
        "濯残暑气朝来雨，助作秋声夜半风。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 174138,
      "title": "句  其二",
      "content": [
        "荷花落日红酣。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 174139,
      "title": "句  其三",
      "content": [
        "兴亡两丘土。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 174140,
      "title": "句  其四",
      "content": [
        "吟笑还孤永。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 174141,
      "title": "句  其五",
      "content": [
        "旷然青霞抱，永矣白云适。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 174142,
      "title": "句  其六",
      "content": [
        "割蚌珠的皪。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 174143,
      "title": "句  其七",
      "content": [
        "固知臭味非相类，其奈萦缠不自由。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 174144,
      "title": "存目",
      "content": [
        "诗题：虞美人草首句：鸿门玉斗纷如雪。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 313207,
      "title": "赏南枝",
      "content": [
        "暮冬天地闭，正柔木冻折，瑞雪飘飞。",
        "对景见南山，岭梅露、几点清雅容姿。",
        "丹染萼、玉缀枝。",
        "又岂是、一阳有私。",
        "大抵是、化工独许，使占却先时。",
        "霜威莫苦凌持。",
        "此花根性，想群卉争知。",
        "贵用在和羹，三春里、不管绿是红非。",
        "攀赏处、宜酒卮。",
        "醉拈嗅、幽香更奇。",
        "倚阑干、仗何人去，嘱羌管休吹。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    }
  ],
