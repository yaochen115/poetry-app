{
  "data": [
    {
      "id": 255155,
      "title": "横吹曲辞 出塞",
      "content": [
        "忽闻天上将，关塞重横行。",
        "始返楼兰国，还向朔方城。",
        "黄金装战马，白羽集神兵。",
        "星月开天阵，山川列地营。",
        "晚风吹画角，春色耀飞旌。",
        "宁知班定远，独是一书生。"
      ],
      "author": {
        "id": 7117,
        "name": "陈子昂"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 288613,
      "title": "庆云章",
      "content": [
        "昆仑元气，实生庆云。",
        "大人作矣，五色氤氲。",
        "昔在帝妫，南风既薰。",
        "丛芳烂熳，郁郁纷纷。",
        "旷矣千祀，庆云来止。",
        "玉叶金柯，祚我天子。",
        "非我天子，庆云谁昌。",
        "非我圣母，庆云谁光。",
        "庆云光矣，周道昌矣。",
        "九万八千，天授皇年。"
      ],
      "author": {
        "id": 7117,
        "name": "陈子昂"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 288614,
      "title": "感遇诗三十八首 一",
      "content": [
        "微月生西海，幽阳始代升。",
        "圆光正东满，阴魂已朝凝。",
        "太极生天地，三元更废兴。",
        "至精谅斯在，三五谁能征。"
      ],
      "author": {
        "id": 7117,
        "name": "陈子昂"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 288615,
      "title": "感遇诗三十八首 二",
      "content": [
        "兰若生春夏，芊蔚何青青。",
        "幽独空林色，朱蕤冒紫茎。",
        "迟迟白日晚，袅袅秋风生。",
        "岁华尽摇落，芳意竟何成。"
      ],
      "author": {
        "id": 7117,
        "name": "陈子昂"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 288616,
      "title": "感遇诗三十八首 三",
      "content": [
        "苍苍丁零塞，今古缅荒途。",
        "亭堠何摧兀，暴骨无全躯。",
        "黄沙幕南起，白日隐西隅。",
        "汉甲三十万，曾以事匈奴。",
        "但见沙场死，谁怜塞上孤。"
      ],
      "author": {
        "id": 7117,
        "name": "陈子昂"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 288617,
      "title": "感遇诗三十八首 四",
      "content": [
        "乐羊为魏将，食子殉军功。",
        "骨肉且相薄，他人安得忠。",
        "吾闻中山相，乃属放麑翁。",
        "孤兽犹不忍，况以奉君终。"
      ],
      "author": {
        "id": 7117,
        "name": "陈子昂"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 288618,
      "title": "感遇诗三十八首 五",
      "content": [
        "市人矜巧智，于道若童蒙。",
        "倾夺相夸侈，不知身所终。",
        "曷见玄真子，观世玉壶中。",
        "窅然遗天地，乘化入无穷。"
      ],
      "author": {
        "id": 7117,
        "name": "陈子昂"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 288619,
      "title": "感遇诗三十八首 六",
      "content": [
        "吾观龙变化，乃知至阳精。",
        "石林何冥密，幽洞无留行。",
        "古之得仙道，信与元化幷。",
        "玄感非象识，谁能测沈冥。",
        "世人拘目见，酣酒笑丹经。",
        "昆仑有瑶树，安得采其英。"
      ],
      "author": {
        "id": 7117,
        "name": "陈子昂"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 288620,
      "title": "感遇诗三十八首 七",
      "content": [
        "白日每不归，青阳时暮矣。",
        "茫茫吾何思，林卧观无始。",
        "众芳委时晦，𫛸鴂鸣悲耳。",
        "鸿荒古已颓，谁识巢居子。"
      ],
      "author": {
        "id": 7117,
        "name": "陈子昂"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 288621,
      "title": "感遇诗三十八首 八",
      "content": [
        "吾观昆仑化，日月沦洞冥。",
        "精魄相交会，天壤以罗生。",
        "仲尼推太极，老聃贵窈冥。",
        "西方金仙子，崇义乃无明。",
        "空色皆寂灭，缘业定何成。",
        "名教信纷藉，死生俱未停。"
      ],
      "author": {
        "id": 7117,
        "name": "陈子昂"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 288622,
      "title": "感遇诗三十八首 九",
      "content": [
        "圣人秘元命，惧世乱其真。",
        "如何嵩公辈，诙谲误时人。",
        "先天诚为美，阶乱祸谁因。",
        "长城备胡寇，嬴祸发其亲。",
        "赤精既迷汉，子年何救秦。",
        "去去桃李花，多言死如麻。"
      ],
      "author": {
        "id": 7117,
        "name": "陈子昂"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 288623,
      "title": "感遇诗三十八首 十",
      "content": [
        "深居观元化，悱然争朵颐。",
        "谗说相啖食，利害纷㘈㘈。",
        "便便夸毘子，荣耀更相持。",
        "务光让天下，商贾竞刀锥。",
        "已矣行采芝，万世同一时。"
      ],
      "author": {
        "id": 7117,
        "name": "陈子昂"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 288624,
      "title": "感遇诗三十八首 十一",
      "content": [
        "吾爱鬼谷子，青谿无垢氛。",
        "囊括经世道，遗身在白云。",
        "七雄方龙鬬，天下久无君。",
        "浮荣不足贵，遵养晦时文。",
        "舒可弥宇宙，卷之不盈分。",
        "岂徒山木寿，空与麋鹿群。"
      ],
      "author": {
        "id": 7117,
        "name": "陈子昂"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 288625,
      "title": "感遇诗三十八首 十二",
      "content": [
        "呦呦南山鹿，罹罟以媒和。",
        "招摇青桂树，幽蠹亦成科。",
        "世情甘近习，荣耀纷如何。",
        "怨憎未相复，亲爱生祸罗。",
        "瑶台倾巧笑，玉杯殒双蛾。",
        "谁见枯城蘖，青青成斧柯。"
      ],
      "author": {
        "id": 7117,
        "name": "陈子昂"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 288626,
      "title": "感遇诗三十八首 十三",
      "content": [
        "林居病时久，水木澹孤清。",
        "闲卧观物化，悠悠念无生。",
        "青春始萌达，朱火已满盈。",
        "徂落方自此，感叹何时平。"
      ],
      "author": {
        "id": 7117,
        "name": "陈子昂"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 288627,
      "title": "感遇诗三十八首 十四",
      "content": [
        "临岐泣世道，天命良悠悠。",
        "昔日殷王子，玉马遂朝周。",
        "宝鼎沦伊谷，瑶台成古丘。",
        "西山伤遗老，东陵有故侯。"
      ],
      "author": {
        "id": 7117,
        "name": "陈子昂"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 288628,
      "title": "感遇诗三十八首 十五",
      "content": [
        "贵人难得意，赏爱在须臾。",
        "莫以心如玉，探他明月珠。",
        "昔称夭桃子，今为舂市徒。",
        "鸱鸮悲东国，麋鹿泣姑苏。",
        "谁见鸱夷子，扁舟去五湖。"
      ],
      "author": {
        "id": 7117,
        "name": "陈子昂"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 288629,
      "title": "感遇诗三十八首 十六",
      "content": [
        "圣人去已久，公道缅良难。",
        "蚩蚩夸毘子，尧禹以为谩。",
        "骄荣贵工巧，势利迭相干。",
        "燕王尊乐毅，分国愿同欢。",
        "鲁连让齐爵，遗组去邯郸。",
        "伊人信往矣，感激为谁叹。"
      ],
      "author": {
        "id": 7117,
        "name": "陈子昂"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 288630,
      "title": "感遇诗三十八首 十七",
      "content": [
        "幽居观天运，悠悠念群生。",
        "终古代兴没，豪圣莫能争。",
        "三季沦周赧，七雄灭秦嬴。",
        "复闻赤精子，提劒入咸京。",
        "炎光既无象，晋虏复纵横。",
        "尧禹道已昧，昏虐势方行。",
        "岂无当世雄，天道与胡兵。",
        "咄咄安可言，时醉而未醒。",
        "仲尼溺东鲁，伯阳遁西溟。",
        "大运自古来，旅人胡叹哉。"
      ],
      "author": {
        "id": 7117,
        "name": "陈子昂"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 288631,
      "title": "感遇诗三十八首 十八",
      "content": [
        "逶迤势已久，骨鲠道斯穷。",
        "岂无感激者，时俗颓此风。",
        "灌园何其鄙，皎皎于陵中。",
        "世道不相容，嗟嗟张长公。"
      ],
      "author": {
        "id": 7117,
        "name": "陈子昂"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 288632,
      "title": "感遇诗三十八首 十九",
      "content": [
        "圣人不利己，忧济在元元。",
        "黄屋非尧意，瑶台安可论。",
        "吾闻西方化，清净道弥敦。",
        "奈何穷金玉，雕刻以为尊。",
        "云构山林尽，瑶图珠翠烦。",
        "鬼工尚未可，人力安能存。",
        "夸愚适增累，矜智道逾昏。"
      ],
      "author": {
        "id": 7117,
        "name": "陈子昂"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 288633,
      "title": "感遇诗三十八首 二十",
      "content": [
        "玄天幽且默，群议曷嗤嗤。",
        "圣人教犹在，世运久陵夷。",
        "一绳将何系？",
        "忧醉不能持。",
        "去去行采芝，勿为尘所欺。"
      ],
      "author": {
        "id": 7117,
        "name": "陈子昂"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 288634,
      "title": "感遇诗三十八首 二十一",
      "content": [
        "蜻蛉游天地，与世本无患。",
        "飞飞未能止，黄雀来相干。",
        "穰侯富秦宠，金石比交欢。",
        "出入咸阳里，诸侯莫敢言。",
        "宁知山东客，激怒秦王肝。",
        "布衣取丞相，千载为辛酸。"
      ],
      "author": {
        "id": 7117,
        "name": "陈子昂"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 288635,
      "title": "感遇诗三十八首 二十二",
      "content": [
        "微霜知岁晏，斧柯始青青。",
        "况乃金天夕，浩露沾群英。",
        "登山望宇宙，白日已西暝。",
        "云海方荡潏，孤鳞安得宁。"
      ],
      "author": {
        "id": 7117,
        "name": "陈子昂"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 288636,
      "title": "感遇诗三十八首 二十三",
      "content": [
        "翡翠巢南海，雄雌珠树林。",
        "何知美人意，骄爱比黄金。",
        "杀身炎州里，委羽玉堂阴。",
        "旖旎光首饰，葳蕤烂锦衾。",
        "岂不在遐远，虞罗忽见寻。",
        "多材信为累，叹息此珍禽。"
      ],
      "author": {
        "id": 7117,
        "name": "陈子昂"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 288637,
      "title": "感遇诗三十八首 二十四",
      "content": [
        "挈瓶者谁子，姣服当青春。",
        "三五明月满，盈盈不自珍。",
        "高堂委金玉，微缕悬千钧。",
        "如何负公鼎，被敚笑时人。"
      ],
      "author": {
        "id": 7117,
        "name": "陈子昂"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 288638,
      "title": "感遇诗三十八首 二十五",
      "content": [
        "玄蝉号白露，兹岁已蹉跎。",
        "群物从大化，孤英将奈何？",
        "瑶台有青鸟，远食玉山禾。",
        "昆仑见玄凤，岂复虞云罗。"
      ],
      "author": {
        "id": 7117,
        "name": "陈子昂"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 288639,
      "title": "感遇诗三十八首 二十六",
      "content": [
        "荒哉穆天子，好与白云期。",
        "宫女多怨旷，层城闭蛾眉。",
        "日耽瑶池乐，岂伤桃李时。",
        "青苔空萎绝，白发生罗帷。"
      ],
      "author": {
        "id": 7117,
        "name": "陈子昂"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 288640,
      "title": "感遇诗三十八首 二十七",
      "content": [
        "朝发宜都渚，浩然思故乡。",
        "故乡不可见，路隔巫山阳。",
        "巫山彩云没，高丘正微茫。",
        "伫立望已久，涕落沾衣裳。",
        "岂兹越乡感，忆昔楚襄王。",
        "朝云无处所，荆国亦沦亡。"
      ],
      "author": {
        "id": 7117,
        "name": "陈子昂"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 288641,
      "title": "感遇诗三十八首 二十八",
      "content": [
        "昔日章华宴，荆王乐荒淫。",
        "霓旌翠羽盖，射兕云梦林。",
        "朅来高唐观，怅望云阳岑。",
        "雄图今何在？",
        "黄雀空哀吟。"
      ],
      "author": {
        "id": 7117,
        "name": "陈子昂"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 288642,
      "title": "感遇诗三十八首 二十九",
      "content": [
        "丁亥岁云暮，西山事甲兵。",
        "赢粮匝邛道，荷戟争羗城。",
        "严冬阴风劲，穷岫泄云生。",
        "昏噎无昼夜，羽檄复相惊。",
        "拳跼竞万仞，崩危走九冥。",
        "籍籍峰壑里，哀哀冰雪行。",
        "圣人御宇宙，闻道泰阶平。",
        "肉食谋何失，藜藿缅纵横。"
      ],
      "author": {
        "id": 7117,
        "name": "陈子昂"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 288643,
      "title": "感遇诗三十八首 三十",
      "content": [
        "可怜瑶台树，灼灼佳人姿。",
        "碧华映朱实，攀折青春时。",
        "岂不盛光宠，荣君白玉墀。",
        "但恨红芳歇，凋伤感所思。"
      ],
      "author": {
        "id": 7117,
        "name": "陈子昂"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 288644,
      "title": "感遇诗三十八首 三十一",
      "content": [
        "朅来豪游子，势利祸之门。",
        "如何兰膏叹，感激自生冤。",
        "众趋明所避，时弃道犹存。",
        "云渊既已失，罗网与谁论。",
        "箕山有高节，湘水有清源。",
        "唯应白鸥鸟，可为洗心言。"
      ],
      "author": {
        "id": 7117,
        "name": "陈子昂"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 288645,
      "title": "感遇诗三十八首 三十二",
      "content": [
        "索居犹几日，炎夏忽然衰。",
        "阳彩皆阴翳，亲友尽暌违。",
        "登山望不见，涕泣久涟洏。",
        "宿梦感颜色，若与白云期。",
        "马上骄豪子，驱逐正蚩蚩。"
      ],
      "author": {
        "id": 7117,
        "name": "陈子昂"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 288646,
      "title": "感遇诗三十八首 三十三",
      "content": [
        "金鼎合神丹，世人将见欺。",
        "飞飞骑羊子，胡乃在峨眉。",
        "变化固幽类，芳菲能几时。",
        "疲疴苦沦世，忧痗日侵淄。",
        "眷然顾幽褐，白云空涕洟。"
      ],
      "author": {
        "id": 7117,
        "name": "陈子昂"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 288647,
      "title": "感遇诗三十八首 三十四",
      "content": [
        "朔风吹海树，萧条边已秋。",
        "亭上谁家子，哀哀明月楼。",
        "自言幽燕客，结发事远游。",
        "赤丸杀公吏，白刃报私雠。",
        "避雠至海上，被役此边州。",
        "故乡三千里，辽水复悠悠。",
        "每愤胡兵入，常为汉国羞。",
        "何知七十战，白首未封侯。"
      ],
      "author": {
        "id": 7117,
        "name": "陈子昂"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 288648,
      "title": "感遇诗三十八首 三十五",
      "content": [
        "本为贵公子，平生实爱才。",
        "感时思报国，拔劒起蒿莱。",
        "西驰丁零塞，北上单于台。",
        "登山见千里，怀古心悠哉。",
        "谁言未忘祸，磨灭成尘埃。"
      ],
      "author": {
        "id": 7117,
        "name": "陈子昂"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 288649,
      "title": "感遇诗三十八首 三十六",
      "content": [
        "浩然坐何慕，吾蜀有峨眉。",
        "念与楚狂子，悠悠白云期。",
        "时哉悲不会，涕泣久涟洏。",
        "梦登绥山穴，南采巫山芝。",
        "探元观群化，遗世从云螭。",
        "婉变时永矣，感悟不见之。"
      ],
      "author": {
        "id": 7117,
        "name": "陈子昂"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 288650,
      "title": "感遇诗三十八首 三十七",
      "content": [
        "朝入云中郡，北望单于台。",
        "胡秦何密迩，沙朔气雄哉。",
        "借借天骄子，猖狂已复来。",
        "塞垣无名将，亭堠空崔嵬。",
        "咄嗟吾何叹，边人涂草莱。"
      ],
      "author": {
        "id": 7117,
        "name": "陈子昂"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 288651,
      "title": "感遇诗三十八首 三十八",
      "content": [
        "仲尼探元化，幽鸿顺阳和。",
        "大运自盈缩，春秋递来过。",
        "盲飙忽号怒，万物相纷劘。",
        "溟海皆震荡，孤凤其如何。"
      ],
      "author": {
        "id": 7117,
        "name": "陈子昂"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 288652,
      "title": "观荆玉篇",
      "content": [
        "鸱夷双白玉，此玉有缁磷。",
        "悬之千金价，举世莫知真。",
        "丹青非异色，轻重有殊伦。",
        "勿信玉工言，徒悲荆国人。"
      ],
      "author": {
        "id": 7117,
        "name": "陈子昂"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 288653,
      "title": "鸳鸯篇",
      "content": [
        "飞飞鸳鸯鸟，举翼相蔽亏。",
        "俱来绿潭里，共向白云涯。",
        "音容相眷恋，羽翮两逶迤。",
        "苹萍戏春渚，霜霰遶寒池。",
        "浦沙连岸净，汀树拂潭垂。",
        "年年此游翫，岁岁来追随。",
        "凤凰起丹穴，独向梧桐枝。",
        "鸿雁来紫塞，空忆稻粱肥。",
        "乌啼倦依托，鹤鸣伤别离。",
        "岂若此双禽，飞翻不异林。",
        "刷尾青江浦，交颈紫山岑。",
        "文章负奇色，和鸣多好音。",
        "闻有鸳鸯绮，复有鸳鸯衾。",
        "持为美人赠，勖此故交心。"
      ],
      "author": {
        "id": 7117,
        "name": "陈子昂"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 288654,
      "title": "与东方左史虬修竹篇",
      "content": [
        "龙种生南岳，孤翠郁亭亭。",
        "峰岭上崇崒，烟雨下微冥。",
        "夜闻鼯鼠呌，昼聒泉鹤声。",
        "春风正淡荡，白露已清泠。",
        "哀响激金奏，密色滋玉英。",
        "岁寒霜雪苦，含彩独青青。",
        "岂不厌凝洌，羞比春木荣。",
        "春木有荣歇，此节无凋零。",
        "始愿与金石，终古保坚贞。",
        "不意伶伦子，吹之学凤鸣。",
        "遂偶云和瑟，张乐奏天庭。",
        "妙曲方千变，箫韶亦九成。",
        "信蒙雕斲美，常愿事仙灵。",
        "驱驰翠虬驾，伊郁紫鸾笙。",
        "结交嬴台女，吟弄升天行。",
        "携手登白日，远游戏赤城。",
        "低昂玄鹤舞，断续彩云生。",
        "永随众仙逝，三山游玉京。"
      ],
      "author": {
        "id": 7117,
        "name": "陈子昂"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 288655,
      "title": "蓟丘览古赠卢居士藏用七首 轩辕台",
      "content": [
        "北登蓟丘望，求古轩辕台。",
        "应龙已不见，牧马空黄埃。",
        "尚想广成子，遗迹白云隈。"
      ],
      "author": {
        "id": 7117,
        "name": "陈子昂"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 288656,
      "title": "蓟丘览古赠卢居士藏用七首 燕昭王",
      "content": [
        "南登碣石坂，遥望黄金台。",
        "丘陵尽乔木，昭王安在哉。",
        "霸图怅已矣，驱马复归来。"
      ],
      "author": {
        "id": 7117,
        "name": "陈子昂"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 288657,
      "title": "蓟丘览古赠卢居士藏用七首 乐生",
      "content": [
        "王道已沦昧，战国竞贪兵。",
        "乐生何感激，仗义下齐城。",
        "雄图竟中夭，遗叹寄阿衡。"
      ],
      "author": {
        "id": 7117,
        "name": "陈子昂"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 288658,
      "title": "蓟丘览古赠卢居士藏用七首 燕太子",
      "content": [
        "秦王日无道，太子怨亦深。",
        "一闻田光义，匕首赠千金。",
        "其事虽不立，千载为伤心。"
      ],
      "author": {
        "id": 7117,
        "name": "陈子昂"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 288659,
      "title": "蓟丘览古赠卢居士藏用七首 田光先生",
      "content": [
        "自古皆有死，狥义良独稀。",
        "奈何燕太子，尚使田生疑。",
        "伏劒诚已矣，感我涕沾衣。"
      ],
      "author": {
        "id": 7117,
        "name": "陈子昂"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 288660,
      "title": "蓟丘览古赠卢居士藏用七首 邹衍",
      "content": [
        "大运沦三代，天人罕有窥。",
        "邹子何寥廓，漫说九瀛垂。",
        "兴亡已千载，今也则无推。"
      ],
      "author": {
        "id": 7117,
        "name": "陈子昂"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 288661,
      "title": "蓟丘览古赠卢居士藏用七首 郭隗",
      "content": [
        "逢时独为贵，历代非无才。",
        "隗君亦何幸，遂起黄金台。"
      ],
      "author": {
        "id": 7117,
        "name": "陈子昂"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 288662,
      "title": "西还至散关答乔补阙知之",
      "content": [
        "葳蕤苍梧凤，嘹唳白露蝉。",
        "羽翰本非匹，结交何独全。",
        "昔君事胡马，余得奉戎旃。",
        "携手向沙塞，关河缅幽燕。",
        "芳岁几阳止，白日屡徂迁。",
        "功业云台薄，平生玉佩捐。",
        "叹此南归日，犹闻北戍边。",
        "代水不可涉，巴江亦潺湲。",
        "揽衣度函谷，衔涕望秦川。",
        "蜀门自兹始，云山方浩然。"
      ],
      "author": {
        "id": 7117,
        "name": "陈子昂"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 288663,
      "title": "度峡口山赠乔补阙知之王二无竞",
      "content": [
        "峡口大漠南，横绝界中国。",
        "丛石何纷𫄙，赤山复翕赩。",
        "远望多众容，逼之无异色。",
        "崔崒乍孤断，逶迤屡回直。",
        "信关胡马冲，亦距汉边塞。",
        "岂依河山险，将顺休明德。",
        "物壮诚有衰，势雄良易极。",
        "逦迤忽而尽，泱漭平不息。",
        "之子黄金躯，如何此荒域。",
        "云台盛多士，待君丹墀侧。"
      ],
      "author": {
        "id": 7117,
        "name": "陈子昂"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 288664,
      "title": "题居延古城赠乔十二知之",
      "content": [
        "闻君东山意，宿昔紫芝荣。",
        "沧洲今何在？",
        "华髪旅边城。",
        "还汉功既薄，逐胡策未行。",
        "徒嗟白日暮，坐对黄云生。",
        "桂枝芳欲晚，薏苡谤谁明。",
        "无为空自老，含叹负生平。"
      ],
      "author": {
        "id": 7117,
        "name": "陈子昂"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 288665,
      "title": "赠赵六贞固二首 一",
      "content": [
        "回中[烽]火入，塞上追兵起。",
        "此时边朔寒，登陇思君子。",
        "东顾望汉京，南山云雾里。"
      ],
      "author": {
        "id": 7117,
        "name": "陈子昂"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 288666,
      "title": "赠赵六贞固二首 二",
      "content": [
        "赤螭媚其彩，婉娈苍梧泉。",
        "昔者瑯琊子，躬耕亦慨然。",
        "美人岂遐旷，之子乃前贤。",
        "良辰在何许，白日屡颓迁。",
        "道心固微密，神用无留连。",
        "舒可弥宇宙，揽之不盈拳。",
        "蓬莱久芜没，金石徒精坚。",
        "良宝委短褐，闲琴独婵娟。"
      ],
      "author": {
        "id": 7117,
        "name": "陈子昂"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 288667,
      "title": "答韩使同在边",
      "content": [
        "汉家失中策，胡马屡南驱。",
        "闻诏安边使，曾是故人谟。",
        "废书怅怀古，负劒许良图。",
        "出关岁方晏，乘障日多虞。",
        "虏入白登道，烽交紫塞途。",
        "连兵屯北地，清野备东胡。",
        "边城方晏闭，斥堠始昭苏。",
        "复闻韩长孺，辛苦事匈奴。",
        "雨雪颜容改，纵横才位孤。",
        "空怀老臣策，未获赵军租。",
        "但蒙魏侯重，不受谤书诬。",
        "当取金人祭，还歌凯入都。"
      ],
      "author": {
        "id": 7117,
        "name": "陈子昂"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 288668,
      "title": "征东至淇门答宋十一参军之问",
      "content": [
        "南星中大火，将子涉清淇。",
        "西林改微月，征斾空自持。",
        "碧潭去已远，瑶华折遗谁。",
        "若问辽阳戍，悠悠天际旗。"
      ],
      "author": {
        "id": 7117,
        "name": "陈子昂"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 288669,
      "title": "答洛阳主人",
      "content": [
        "平生白云志，早爱赤松游。",
        "事亲恨未立，从宦此中州。",
        "主人亦何问，旅客非悠悠。",
        "方谒明天子，清宴奉良筹。",
        "再取连城璧，三陟平津侯。",
        "不然拂衣去，归从海上鸥。",
        "宁随当代子，倾侧且沈浮。"
      ],
      "author": {
        "id": 7117,
        "name": "陈子昂"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 288670,
      "title": "酬晖上人秋夜山亭有赠",
      "content": [
        "皎皎白林秋，微微翠山静。",
        "禅居感物变，独坐开轩屏。",
        "风泉夜声杂，月露宵光冷。",
        "多谢忘机人，尘忧未能整。"
      ],
      "author": {
        "id": 7117,
        "name": "陈子昂"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 288671,
      "title": "酬李参军崇嗣旅馆见赠",
      "content": [
        "昨夜银河畔，星文犯遥汉。",
        "今朝紫气新，物色果逢真。",
        "言从天上落，乃是地仙人。",
        "白璧疑冤楚，乌裘似入秦。",
        "摧藏多古意，历览备艰辛。",
        "乐广云虽覩，夷吾风未春。",
        "凤歌空有问，龙性讵能驯。",
        "宝劒终应出，骊珠会见珍。",
        "未及冯公老，何惊孺子贫。",
        "青云傥可致，北海忆孙宾。"
      ],
      "author": {
        "id": 7117,
        "name": "陈子昂"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 288672,
      "title": "酬晖上人夏日林泉",
      "content": [
        "闻道白云居，窈窕青莲宇。",
        "岩泉万丈流，树石千年古。",
        "林卧对轩窗，山阴满庭户。",
        "方释尘事劳，从君袭兰杜。"
      ],
      "author": {
        "id": 7117,
        "name": "陈子昂"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 288673,
      "title": "同宋参军之问梦赵六赠卢陈二子之作",
      "content": [
        "晓霁望嵩丘，白云半岩足。",
        "氛氲涵翠微，宛如嬴台曲。",
        "故人昔所尚，幽琴歌断续。",
        "变化竟无常，人琴遂两亡。",
        "白云失处所，梦想暧容光。",
        "畴昔疑缘业，儒道两相妨。",
        "前期许幽报，迨此尚茫茫。",
        "晤言既已失，感叹情何一。",
        "始忆携手期，云台与峨眉。",
        "达兼济天下，穷独善其时。",
        "诸君推管乐，之子慕巢夷。",
        "奈何苍生望，卒为黄绶欺。",
        "铭鼎功未立，山林事亦微。",
        "抚孤一流恸，怀旧日暌违。",
        "卢子尚高节，终南卧松雪。",
        "宋侯逢圣君，骖驭游青云。",
        "而我独蹭蹬，语默道犹屯。",
        "征戍在辽阳，蹉跎草再黄。",
        "丹丘恨不及，白露已苍苍。",
        "远闻山阳赋，感涕下沾裳。"
      ],
      "author": {
        "id": 7117,
        "name": "陈子昂"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 288674,
      "title": "送别出塞",
      "content": [
        "平生闻高义，书劒百夫雄。",
        "言登青云去，非此白头翁。",
        "胡兵屯塞下，汉骑属云中。",
        "君为白马将，腰佩骍角弓。",
        "单于不敢射，天子伫深功。",
        "蜀山余方隐，良会何时同。"
      ],
      "author": {
        "id": 7117,
        "name": "陈子昂"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 288675,
      "title": "登蓟丘楼送贾兵曹入都",
      "content": [
        "东山宿昔意，北征非我心。",
        "孤负平生愿，感涕下沾襟。",
        "暮登蓟楼上，永望燕山岑。",
        "辽海方漫漫，胡沙飞且深。",
        "峨眉杳如梦，仙子曷由寻。",
        "击劒起叹息，白日忽西沈。",
        "闻君洛阳使，因子寄南音。"
      ],
      "author": {
        "id": 7117,
        "name": "陈子昂"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 288676,
      "title": "夏日晖上人房别李参军崇嗣",
      "content": [
        "四十九变化，一十三死生。",
        "翕忽玄黄里，驱驰风雨情。",
        "是非纷妄作，宠辱坐相惊。",
        "至人独幽鉴，窈窕随昏明。",
        "咫尺山河道，轩窗日月庭。",
        "别离焉足问，悲乐固能幷。",
        "我辈何为尔，栖皇犹未平。",
        "金台可攀陟，宝界绝将迎。",
        "户牖观天地，阶基上杳冥。",
        "自超三界乐，安知万里征。",
        "中国要荒内，人寰宇宙荣。",
        "弦望如朝夕，宁嗟蜀道行。"
      ],
      "author": {
        "id": 7117,
        "name": "陈子昂"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 288677,
      "title": "秋园卧病呈晖上人",
      "content": [
        "幽寂旷日遥，林园转清密。",
        "疲疴澹无豫，独坐泛瑶瑟。",
        "怀挟万古情，忧虞百年疾。",
        "绵绵多滞念，忽忽每如失。",
        "缅想赤松游，高寻白云逸。",
        "荣吝始都丧，幽人遂贞吉。",
        "图书纷满床，山水蔼盈室。",
        "宿昔心所尚，平生自兹毕。",
        "愿言谁见知，梵筵有同术。",
        "八月高秋晚，凉风正萧瑟。"
      ],
      "author": {
        "id": 7117,
        "name": "陈子昂"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 288678,
      "title": "登泽州城北楼䜩",
      "content": [
        "平生倦游者，观化久无穷。",
        "复来登此国，临望与君同。",
        "坐见秦兵垒，遥闻赵将雄。",
        "武安君何在，长平事已空。",
        "且歌玄云曲，御酒舞薰风。",
        "勿使青衿子，嗟尔白头翁。"
      ],
      "author": {
        "id": 7117,
        "name": "陈子昂"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 288679,
      "title": "山水粉图",
      "content": [
        "山图之白云兮，若巫山之高丘。",
        "纷群翠之鸿溶，又似蓬瀛海水之周流。",
        "信夫人之好道，爱云山以幽求。"
      ],
      "author": {
        "id": 7117,
        "name": "陈子昂"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 288680,
      "title": "彩树歌",
      "content": [
        "嘉锦筵之珍树兮，错众彩之氛氲。",
        "状瑶台之微月，点巫山之朝云。",
        "青春兮不可逢，况蕙色之增芬。",
        "结芳意而谁赏，怨绝世之无闻。",
        "红荣碧艳坐看歇，素华流年不待君。",
        "故吾思昆仑之琪树，厌桃李之缤纷。"
      ],
      "author": {
        "id": 7117,
        "name": "陈子昂"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 288681,
      "title": "春台引",
      "content": [
        "感阳春兮生碧草之油油，怀宇宙以伤远，登高台而写忧。",
        "迟美人兮不见，恐青岁之遂遒。",
        "从毕公以酣饮，寄林塘而一留。",
        "采芳荪于北渚，忆桂树于南州。",
        "何云木之美丽，而池馆之崇幽。",
        "星台秀士，月旦诸子。",
        "嘉青鸟之辰，迎火龙之始。",
        "挟宝书与瑶瑟，芳蕙华而兰靡。",
        "乃掩白苹，藉绿芷。",
        "酒既醉，乐未已。",
        "击青钟，歌渌水。",
        "怨青春之萎绝，赠瑶台之旖旎。",
        "愿一见而道意，结众芳之绸缪。",
        "曷余情之荡漾，瞩青云以增愁。",
        "怅三山之飞鹤，忆海上之白鸥。",
        "重曰：群仙去兮青春颓，岁华歇兮黄鸟哀。",
        "富贵荣乐几时兮，朱宫碧堂生青苔，白云兮归来。"
      ],
      "author": {
        "id": 7117,
        "name": "陈子昂"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 288682,
      "title": "登幽州台歌",
      "content": [
        "前不见古人，后不见来者。",
        "念天地之悠悠，独怆然而涕下。"
      ],
      "author": {
        "id": 7117,
        "name": "陈子昂"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 288683,
      "title": "喜马参军相遇醉歌",
      "content": [
        "独幽默以三月兮，深林潜居。",
        "时岁忽兮，孤愤遐吟。",
        "谁知我心，孺子孺子，其可与理分。"
      ],
      "author": {
        "id": 7117,
        "name": "陈子昂"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 288684,
      "title": "度荆门望楚",
      "content": [
        "遥遥去巫峡，望望下章台。",
        "巴国山川尽，荆门烟雾开。",
        "城分苍野外，树断白云隈。",
        "今日狂歌客，谁知入楚来。"
      ],
      "author": {
        "id": 7117,
        "name": "陈子昂"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 288685,
      "title": "晚次乐乡县",
      "content": [
        "故乡杳无际，日暮且孤征。",
        "川原迷旧国，道路入边城。",
        "野戍荒烟断，深山古木平。",
        "如何此时恨，噭噭夜猿鸣。"
      ],
      "author": {
        "id": 7117,
        "name": "陈子昂"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 288686,
      "title": "同王员外雨后登开元寺南楼因酬晖上人独坐山亭有赠",
      "content": [
        "钟梵经行罢，香林坐入禅。",
        "岩庭交杂树，石濑泻鸣泉。",
        "水月心方寂，云霞思独玄。",
        "宁知人世里，疲病得攀缘。"
      ],
      "author": {
        "id": 7117,
        "name": "陈子昂"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 288687,
      "title": "东征答朝臣相送",
      "content": [
        "平生白云意，疲薾愧为雄。",
        "君王谬殊宠，旌节此从戎。",
        "挼绳当系虏，单马岂邀功。",
        "孤劒将何托，长谣塞上风。"
      ],
      "author": {
        "id": 7117,
        "name": "陈子昂"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 288688,
      "title": "咏主人壁上画鹤寄乔主簿崔著作",
      "content": [
        "古壁仙人画，丹青尚有文。",
        "独舞纷如雪，孤飞暧似云。",
        "自矜彩色重，宁忆故池群。",
        "江海联翩翼，长鸣谁复闻。"
      ],
      "author": {
        "id": 7117,
        "name": "陈子昂"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 288689,
      "title": "居延海树闻莺同作",
      "content": [
        "边地无芳树，莺声忽听新。",
        "间关如有意，愁绝若怀人。",
        "明妃失汉宠，蔡女没胡尘。",
        "坐闻应落泪，况忆故园春。"
      ],
      "author": {
        "id": 7117,
        "name": "陈子昂"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 288690,
      "title": "题李三书斋",
      "content": [
        "灼灼青春仲，悠悠白日升。",
        "声容何足恃，荣吝坐相矜。",
        "愿与金庭会，将待玉书征。",
        "还丹应有术，烟驾共君乘。"
      ],
      "author": {
        "id": 7117,
        "name": "陈子昂"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 288691,
      "title": "送魏大从军",
      "content": [
        "匈奴犹未灭，魏绛复从戎。",
        "怅别三河道，言追六郡雄。",
        "雁山横代北，狐塞接云中。",
        "勿使燕然上，惟留汉将功。"
      ],
      "author": {
        "id": 7117,
        "name": "陈子昂"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 288692,
      "title": "送殷大入蜀",
      "content": [
        "禺山金碧路，此地饶英灵。",
        "送君一为别，凄断故乡情。",
        "片云生极浦，斜日隐离亭。",
        "坐看征骑没，惟见远山青。"
      ],
      "author": {
        "id": 7117,
        "name": "陈子昂"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 288693,
      "title": "落第西还别刘祭酒高明府",
      "content": [
        "别馆分周国，归骖入汉京。",
        "地连函谷塞，川接广阳城。",
        "望迥楼台出，途遥烟雾生。",
        "莫言长落羽，贫贱一交情。"
      ],
      "author": {
        "id": 7117,
        "name": "陈子昂"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 288694,
      "title": "落第西还别魏四懔",
      "content": [
        "转蓬方不定，落羽自惊弦。",
        "山水一为别，欢娱复几年。",
        "离亭暗风雨，征路入云烟。",
        "还因北山迳，归守东陂田。"
      ],
      "author": {
        "id": 7117,
        "name": "陈子昂"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 288695,
      "title": "送客",
      "content": [
        "故人洞庭去，杨柳春风生。",
        "相送河洲晚，苍茫别思盈。",
        "白苹已堪把，绿芷复含荣。",
        "江南多桂树，归客赠生平。"
      ],
      "author": {
        "id": 7117,
        "name": "陈子昂"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 288696,
      "title": "春夜别友人二首 一",
      "content": [
        "银烛吐青烟，金樽对绮筵。",
        "离堂思琴瑟，别路遶山川。",
        "明月隐高树，长河没晓天。",
        "悠悠洛阳道，此会在何年。"
      ],
      "author": {
        "id": 7117,
        "name": "陈子昂"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 288697,
      "title": "春夜别友人二首 二",
      "content": [
        "紫塞白云断，青春明月初。",
        "对此芳樽夜，离忧怅有余。",
        "清冷花露满，滴沥檐宇虚。",
        "怀君欲何赠，愿上大臣书。"
      ],
      "author": {
        "id": 7117,
        "name": "陈子昂"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 288698,
      "title": "遂州南江别乡曲故人",
      "content": [
        "楚江复为客，征棹方悠悠。",
        "故人悯追送，置酒此南洲。",
        "平生亦何恨，夙昔在林丘。",
        "违此乡山别，长谣去国愁。"
      ],
      "author": {
        "id": 7117,
        "name": "陈子昂"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 288699,
      "title": "送东莱王学士无竞",
      "content": [
        "宝劒千金买，平生未许人。",
        "怀君万里别，持赠结交亲。",
        "孤松宜晚岁，众木爱芳春。",
        "已矣将何道，无令白首新。"
      ],
      "author": {
        "id": 7117,
        "name": "陈子昂"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 288700,
      "title": "送梁李二明府",
      "content": [
        "负书犹在汉，怀策未闻秦。",
        "复此穷秋日，芳樽别故人。",
        "黄金装屡尽，白首契逾新。",
        "空羡双凫舄，俱飞向玉轮。"
      ],
      "author": {
        "id": 7117,
        "name": "陈子昂"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 288701,
      "title": "送魏兵曹使嶲州得登字",
      "content": [
        "阳山淫雾雨，之子慎攀登。",
        "羗笮多珍宝，人言有爱憎。",
        "欲酬明主惠，当尽使臣能。",
        "勿以王阳道，迢递畏崚嶒。"
      ],
      "author": {
        "id": 7117,
        "name": "陈子昂"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 288702,
      "title": "送著作佐郎崔融等从梁王东征",
      "content": [
        "金天方肃杀，白露始专征。",
        "王师非乐战，之子慎佳兵。",
        "海气侵南部，边风扫北平。",
        "莫卖卢龙塞，归邀麟阁名。"
      ],
      "author": {
        "id": 7117,
        "name": "陈子昂"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 288703,
      "title": "春晦饯陶七于江南同用风字",
      "content": [
        "黄鹤烟云去，青江琴酒同。",
        "离帆方楚越，沟水复西东。",
        "芙蓉生夏浦，杨柳送春风。",
        "明日相思处，应对菊花丛。"
      ],
      "author": {
        "id": 7117,
        "name": "陈子昂"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 288704,
      "title": "喜遇冀侍御珪崔司议泰之二使",
      "content": [
        "谢病南山下，幽卧不知春。",
        "使星入东井，云是故交亲。",
        "惠风吹宝瑟，微月忆清真。",
        "凭轩一留醉，江海寄情人。"
      ],
      "author": {
        "id": 7117,
        "name": "陈子昂"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 288705,
      "title": "登蓟城西北楼送崔著作融入都",
      "content": [
        "蓟楼望燕国，负劒喜兹登。",
        "清规子方奏，单戟我无能。",
        "仲冬边风急，云汉复霜棱。",
        "慷慨竟何道，西南恨失朋。"
      ],
      "author": {
        "id": 7117,
        "name": "陈子昂"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 288706,
      "title": "月夜有怀",
      "content": [
        "美人挟赵瑟，微月在西轩。",
        "寂寞夜何久，殷勤玉指繁。",
        "清光委衾枕，遥思属湘沅。",
        "空帘隔星汉，犹梦感精魂。"
      ],
      "author": {
        "id": 7117,
        "name": "陈子昂"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 288707,
      "title": "夏日游晖上人房",
      "content": [
        "山水开精舍，琴歌列梵筵。",
        "人疑白楼赏，地似竹林禅。",
        "对户池光乱，交轩岩翠连。",
        "色空今已寂，乘月弄澄泉。"
      ],
      "author": {
        "id": 7117,
        "name": "陈子昂"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 288708,
      "title": "春日登金华观",
      "content": [
        "白玉仙台古，丹丘别望遥。",
        "山川乱云日，楼榭入烟霄。",
        "鹤舞千年树，虹飞百尺桥。",
        "还疑赤松子，天路坐相邀。"
      ],
      "author": {
        "id": 7117,
        "name": "陈子昂"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 288709,
      "title": "群公集毕氏林亭",
      "content": [
        "金门有遗世，鼎实恣和邦。",
        "默语谁能识，琴樽寄北窗。",
        "子牟恋魏阙，渔父爱沧江。",
        "良时信同此，岁晚迹难双。"
      ],
      "author": {
        "id": 7117,
        "name": "陈子昂"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 288710,
      "title": "宴胡楚真禁所",
      "content": [
        "人生固有命，天道信无言。",
        "青绳一相点，白璧遂成冤。",
        "请室闲逾邃，幽庭春未暄。",
        "寄谢韩安国，何惊狱吏尊。"
      ],
      "author": {
        "id": 7117,
        "name": "陈子昂"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 288711,
      "title": "魏氏园林人赋一物得秋亭萱草",
      "content": [
        "昔时幽径里，荣耀杂春丛。",
        "今来玉墀上，销歇畏秋风。",
        "细叶犹含绿，鲜花未吐红。",
        "忘忧谁见赏，空此北堂中。"
      ],
      "author": {
        "id": 7117,
        "name": "陈子昂"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    }
  ],
