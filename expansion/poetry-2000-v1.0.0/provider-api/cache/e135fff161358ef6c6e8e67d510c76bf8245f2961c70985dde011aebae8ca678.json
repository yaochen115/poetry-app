{
  "data": [
    {
      "id": 346728,
      "title": "华山南庙",
      "content": [
        "阴山临古道，古庙闭山碧。",
        "落日春草中，搴芳荐瑶席。",
        "明灵达精意，仿佛如不隔。",
        "岩雨神降时，回飙入松柏。",
        "常闻坑儒后，此地返秦璧。",
        "自古害忠良，神其辅宗祏。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 346729,
      "title": "喜邢校书远至对雨同赋远晚饭阮返五韵",
      "content": [
        "雀噪空城阴，木衰羁思远。",
        "已蔽青山望，徒悲白云晚。",
        "别离千里风，雨中同一饭。",
        "开径说逢康，临觞方接阮。",
        "旅宦竟何如，劳飞思自返。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 346730,
      "title": "城西竹园送裴佶王达",
      "content": [
        "葳蕤凌风竹，寂寞离人觞。",
        "怆怀非外至，沉郁自中肠。",
        "远行从此始，别袂重凄霜。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 346731,
      "title": "月下喜邢校书至自洛",
      "content": [
        "天河夜未央，漫漫复苍苍。",
        "重君远行至，及此明月光。",
        "华星映衰柳，暗水入寒塘。",
        "客心定何似，余欢方自长。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 346732,
      "title": "北至太原",
      "content": [
        "炎祚昔昏替，皇基此郁盘。",
        "玄命久已集，抚运良乃艰。",
        "南厄羊肠险，北走雁门寒。",
        "始于一戎定，垂此亿世安。",
        "唐风本忧思，王业实艰难。",
        "中历虽横溃，天纪未可干。",
        "圣明所兴国，灵岳固不殚。",
        "咄咄薄游客，斯言殊不刊。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 346733,
      "title": "入华山访隐者经仙人石坛",
      "content": [
        "三考四岳下，官曹少休沐。",
        "久负青山诺，今还获所欲。",
        "尝闻玉清洞，金简受玄箓。",
        "夙驾升天行，云游恣霞宿。",
        "平明矫轻策，扪石入空曲。",
        "仙人古石坛，苔绕青瑶局。",
        "阳桂凌烟紫，阴罗冒水绿。",
        "隔世闻丹经，悬泉注明玉。",
        "前惊羽人会，白日天居肃。",
        "问我将致辞，笑之自相目。",
        "竦身云遂起，仰见双白鹄。",
        "堕其一纸书，文字类鸟足。",
        "视之了不识，三返又三复。",
        "归来问方士，举世莫解读。",
        "何必若蜉蝣，然后为局促。",
        "鄙哉宦游子，身志俱降辱。",
        "再往不及期，劳歌叩山木。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 346736,
      "title": "答郭黄中孤云首章见赠",
      "content": [
        "孤云生西北，从风东南飘。",
        "帝乡日已远，苍梧无还飙。",
        "已矣玄凤叹，严霜集灵苕。",
        "君其勉我怀，岁暮孰不凋。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 346739,
      "title": "送诸暨王主簿之任",
      "content": [
        "别愁已万绪，离曲方三奏。",
        "远宦一辞乡，南天异风候。",
        "秦城岁芳老，越国春山秀。",
        "落日望寒涛，公门闭清昼。",
        "何用慰相思，裁书寄关右。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 346741,
      "title": "自朔方还与郑式瞻崔称郑子周岑赞同会法云寺三门避暑",
      "content": [
        "予本疏放士，朅来非外矫。",
        "误落边尘中，爱山见山少。",
        "始投清凉宇，门值烟岫表。",
        "参差互明灭，彩翠竟昏晓。",
        "泠泠远风来，过此群木杪。",
        "英英二三彦，襟旷去烦扰。",
        "游川出潜鱼，息阴倦飞鸟。",
        "徇物不可穷，唯于此心了。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 346742,
      "title": "来从窦车骑行",
      "content": [
        "束发逢世屯，怀恩抱明义。",
        "读书良有感，学剑惭非智。",
        "遂别鲁诸生，来从窦车骑。",
        "追兵赴边急，络马黄金辔。",
        "出入燕南陲，由来重意气。",
        "自经皋兰战，又破楼烦地。",
        "西北护三边，东南留一尉。",
        "时过欻如云，参差不自意。",
        "将军失恩泽，万事从此异。",
        "置酒高台上，薄暮秋风至。",
        "长戟与我归，归来同弃置。",
        "自酌还自饮，非名又非利。",
        "歌出易水寒，琴下雍门泪。",
        "出逢平乐旧，言在天阶侍。",
        "问我从军苦，自陈少年贵。",
        "丈夫交四海，徒论身自致。",
        "汉将不封侯，苏卿劳远使。",
        "今我终此曲，此曲诚不易。",
        "贵人难识心，何由知忌讳。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 346743,
      "title": "夜发军中",
      "content": [
        "边马枥上惊，雄剑匣中鸣。",
        "半夜军书至，匈奴寇六城。",
        "中坚分暗阵，太乙起神兵。",
        "出没风云合，苍黄豺虎争。",
        "今日边庭战，缘赏不缘名。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 346745,
      "title": "城傍少年",
      "content": [
        "生长边城傍，出身事弓马。",
        "少年有胆气，独猎阴山下。",
        "偶与匈奴逢，曾擒射雕者。",
        "名悬壮士籍，请君少相假。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 346746,
      "title": "游子吟",
      "content": [
        "女羞夫婿薄，客耻主人贱。",
        "遭遇同众流，低回愧相见。",
        "君非青铜镜，何事空照面。",
        "莫以衣上尘，不谓心如练。",
        "人生当荣盛，待士勿言倦。",
        "君看白日驰，何异弦上箭。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 346748,
      "title": "莲塘驿",
      "content": [
        "五月渡淮水，南行绕山陂。",
        "江村远鸡应，竹里闻缲丝。",
        "楚女肌发美，莲塘烟露滋。",
        "菱花覆碧渚，黄鸟双飞时。",
        "渺渺溯洄远，凭风托微词。",
        "斜光动流睇，此意难自持。",
        "女歌本轻艳，客行多怨思。",
        "女萝蒙幽蔓，拟上青桐枝。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 346750,
      "title": "与王楚同登青龙寺上方",
      "content": [
        "连冈出古寺，流睇移芳宴。",
        "鸟没汉诸陵，草平秦故殿。",
        "摇光浅深树，拂木参差燕。",
        "春心断易迷，远目伤难遍。",
        "壮日各轻年，暮年方自见。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 346751,
      "title": "登夏州城观送行人赋得六州胡儿歌",
      "content": [
        "六州胡儿六蕃语，十岁骑羊逐沙鼠。",
        "沙头牧马孤雁飞，",
        "无定河边数株柳，共送行人一杯酒。",
        "胡儿起作和蕃歌，",
        "回头忽作异方声，一声回尽征人首。",
        "蕃音虏曲一难分，",
        "不见天边青作冢，古来愁杀汉昭君。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 346752,
      "title": "从军夜次六胡北饮马磨剑石为祝殇辞",
      "content": [
        "我行空碛，见沙之磷磷，与草之幂幂，半没胡儿磨剑石。",
        "当时洗剑血成川，至今草与沙皆赤。",
        "我因扣石问以言，",
        "请君先问湘江水，然我此恨乃可论。",
        "秦亡汉绝三十国，",
        "为之弹剑作哀吟，风沙四起云沉沉。",
        "满营战马嘶欲尽，",
        "年移代去感精魂，空山月暗闻鼙鼓。",
        "秦坑赵卒四十万，",
        "韩公三城断胡路，汉甲百万屯边秋。",
        "乃分司空授朔土，",
        "殇为魂兮，可以归还故乡些；沙场地无人兮，"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 346753,
      "title": "登天坛夜见海",
      "content": [
        "朝游碧峰三十六，夜上天坛月边宿。",
        "仙人携我搴玉英，",
        "霞梯赤城遥可分，霓旌绛节倚彤云。",
        "八鸾五凤纷在御，",
        "竦身别我期丹宫，空山处处遗清风。",
        "九州下视杳未旦，"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 346754,
      "title": "大礼毕皇帝御丹凤门改元建中大赦",
      "content": [
        "大明曈曈天地分，六龙负日升天门。",
        "凤凰飞来衔帝箓，",
        "宸居穆清受天历，建中甲子合上元。",
        "昊穹景命即已至，",
        "云亭之事略可记，七十二君宁独尊。",
        "小臣欲上封禅表，"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 346755,
      "title": "轻薄篇",
      "content": [
        "豪不必驰千骑，雄不在垂双鞬。",
        "天生俊气自相逐，",
        "忽闻燕雁一声去，回鞍挟弹平陵园。",
        "归来青楼曲未半，",
        "安知我有不平色，白日欲落红尘昏。",
        "死生容易如反掌，"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 346757,
      "title": "古别离",
      "content": [
        "双剑欲别风凄然，雌沉水底雄上天。",
        "江回汉转两不见，"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 346759,
      "title": "汉宫少年行",
      "content": [
        "君不见上宫警夜营八屯，冬冬街鼓朝朱轩。",
        "玉阶霜仗拥未合，少年排入铜龙门。",
        "暗闻弦管九天上，",
        "玉笼金锁养黄口，探雏取卵伴王孙。",
        "分曹陆博快一掷，",
        "晚来香街经柳市，行过倡舍宿桃根。",
        "相逢杯酒一言失，",
        "岂知人事无定势，朝欢暮戚如掌翻。",
        "椒房宠移子爱夺，",
        "持杯收水水已覆，徙薪避火火更燔。",
        "欲求四老张丞相，"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 346760,
      "title": "竹窗闻风寄苗发司空曙",
      "content": [
        "微风惊暮坐，临牖思悠哉。",
        "开门复动竹，疑是故人来。",
        "时滴枝上露，稍沾阶下苔。",
        "何当一入幌，为拂绿琴埃。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 346767,
      "title": "送韩将军还边",
      "content": [
        "白马羽林儿，扬鞭薄暮时。",
        "独将轻骑出，暗与伏兵期。",
        "雨雪移军远，旌旗上垄迟。",
        "圣心戎寄重，未许让恩私。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 346771,
      "title": "寻纪道士偶会诸叟",
      "content": [
        "山阴寻道士，映竹羽衣新。",
        "侍坐双童子，陪游五老人。",
        "水花松下静，坛草雪中春。",
        "见说桃源洞，如今犹避秦。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 346775,
      "title": "述怀寄衡州令狐相公",
      "content": [
        "调元方翼圣，轩盖忽言东。",
        "道以中枢密，心将外理同。",
        "白头生远浪，丹叶下高枫。",
        "江上萧疏雨，何人对谢公。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 346776,
      "title": "喜入兰陵望紫阁峰呈宣上人",
      "content": [
        "薙草开三径，巢林喜一枝。",
        "地宽留种竹，泉浅欲开池。",
        "紫阁当疏牖，青松入坏篱。",
        "从今安僻陋，萧相是吾师。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 346778,
      "title": "立春日宁州行营因赋朔风吹飞雪",
      "content": [
        "边声日夜合，朔风惊复来。",
        "龙山不可望，千里一裴回。",
        "捐扇破谁执，素纨轻欲裁。",
        "非时妒桃李，自是舞阳台。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 346782,
      "title": "紫骝马",
      "content": [
        "争场看斗鸡，白鼻紫骝嘶。",
        "漳水春闺晚，丛台日向低。",
        "歇鞍珠作汗，试剑玉如泥。",
        "为谢红梁燕，年年妾独栖。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 346784,
      "title": "同崔邠登鹳雀楼",
      "content": [
        "鹳雀楼西百尺樯，汀洲云树共茫茫。",
        "汉家萧鼓空流水，",
        "风烟并起思归望，远目非春亦自伤。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 346785,
      "title": "奉酬崔员外副使携琴宿使院见示",
      "content": [
        "忽闻此夜携琴宿，遂叹常时尘吏喧。",
        "庭木已衰空月亮，",
        "谁问南飞长绕树，官微同在谢公门。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 346786,
      "title": "送贾校书东归寄振上人",
      "content": [
        "北风吹雁数声悲，况指前林是别时。",
        "秋草不堪频送远，",
        "为向东州故人道，江淹已拟惠休诗。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 346787,
      "title": "过马嵬二首",
      "content": [
        "路至墙垣问樵者，顾予云是太真宫。",
        "太真血染马蹄尽，",
        "世人莫重霓裳曲，曾致干戈是此中。",
        "金甲银旌尽已回，苍茫罗袖隔风埃。",
        "浓香犹自随鸾辂，",
        "唯留坡畔弯环月，时送残辉入夜台。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 346788,
      "title": "盐州过胡儿饮马泉",
      "content": [
        "绿杨著水草如烟，旧是胡儿饮马泉。",
        "几处吹笳明月夜，",
        "莫遣行人照容鬓，恐惊憔悴入新年。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 346789,
      "title": "宿冯翊夜雨赠主人",
      "content": [
        "危心惊夜雨，起望漫悠悠。",
        "气耿残灯暗，声繁高树秋。",
        "凉轩辞夏扇，风幌揽轻裯。",
        "思绪蓬初断，归期燕暂留。",
        "关山蔼已失，脸泪迸难收。",
        "赖君时一笑，方能解四愁。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 346791,
      "title": "春日晋祠同声会集得疏字韵",
      "content": [
        "风壤瞻唐本，山祠阅晋余。",
        "水亭开帟幕，岩榭引簪裾。",
        "地绿苔犹少，林黄柳尚疏。",
        "菱苕生皎镜，金碧照澄虚。",
        "翰苑声何旧，宾筵醉止初。",
        "中州有辽雁，好为系边书。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 346792,
      "title": "再赴渭北使府留别",
      "content": [
        "结发逐鸣鼙，连兵追谷蠡。",
        "山川搜伏虏，铠甲被重犀。",
        "故府旌旗在，新军羽校齐。",
        "报恩身未死，识路马还嘶。",
        "列嶂高烽举，当营太白低。",
        "平戎七尺剑，封检一丸泥。",
        "截海取蒲类，跑泉饮䴙鹈。",
        "汉庭中选重，更事五原西。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 346796,
      "title": "照镜",
      "content": [
        "衰鬓朝临镜，将看却自疑。",
        "惭君明似月，照我白如丝。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 346797,
      "title": "书院无历日，以诗代书，问路侍御六月大小",
      "content": [
        "野性迷尧历，松窗有道经。",
        "故人为柱史，为我数阶蓂。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 346803,
      "title": "听唱赤白桃李花",
      "content": [
        "赤白桃李花，先皇在时曲。",
        "欲向西宫唱，西宫宫树绿。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 346804,
      "title": "江南词",
      "content": [
        "嫁得瞿塘贾，朝朝误妾期。",
        "早知潮有信，嫁与弄潮儿。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 346806,
      "title": "答窦二曹长留酒还榼",
      "content": [
        "榼小非由榼，星郎是酒星。",
        "解酲元有数，不用吓刘伶。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 346812,
      "title": "金吾子",
      "content": [
        "绣帐博山炉，银鞍冯子都。",
        "黄昏莫攀折，惊起欲栖乌。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 346821,
      "title": "度破讷沙二首",
      "content": [
        "眼见风来沙旋移，经年不省草生时。",
        "莫言塞北无春到，总有春来何处知。",
        "破讷沙头雁正飞，䴙鹈泉上战初归。",
        "平明日出东南地，满碛寒光生铁衣。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 346823,
      "title": "中桥北送穆质兄弟应制，戏赠萧二策",
      "content": [
        "洛水桥边雁影疏，陆机兄弟驻行车。",
        "欲陈汉帝登封草，犹待萧郎寄内书。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 346824,
      "title": "九月十日雨中过张伯佳期柳镇未至以诗招之",
      "content": [
        "柳吴兴近无消息，张长公贫苦寂寥。",
        "唯有角巾沾雨至，手持残菊向西招。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 346826,
      "title": "塞下曲",
      "content": [
        "蕃州部落能结束，朝暮驰猎黄河曲。",
        "燕歌未断塞鸿飞，牧马群嘶边草绿。",
        "秦筑长城城已摧，汉武北上单于台。",
        "古来征战虏不尽，今日还复天兵来。",
        "黄河东流流九折，沙场埋恨何时绝。",
        "蔡琰没去造胡笳，苏武归来持汉节。",
        "为报如今都护雄，匈奴且莫下云中。",
        "请书塞北阴山石，愿比燕然车骑功。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 346827,
      "title": "夜上西城听梁州曲二首",
      "content": [
        "行人夜上西城宿，听唱梁州双管逐。",
        "此时秋月满关山，何处关山无此曲。",
        "鸿雁新从北地来，闻声一半却飞回。",
        "金河戍客肠应断，更在秋风百尺台。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 346832,
      "title": "边思",
      "content": [
        "腰悬锦带佩吴钩，走马曾防玉塞秋。",
        "莫笑关西将家子，只将诗思入凉州。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 346833,
      "title": "奉和武相公春晓闻莺",
      "content": [
        "蜀道山川心易惊，绿窗残梦晓闻莺。",
        "分明似写文君恨，万怨千愁弦上声。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 346841,
      "title": "诣红楼院寻广宣不遇留题",
      "content": [
        "柿叶翻红霜景秋，碧天如水倚红楼。",
        "隔窗爱竹有人问，遣向邻房觅户钩。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 346842,
      "title": "回军行",
      "content": [
        "关城榆叶早疏黄，日暮沙云古战场。",
        "表请回军掩尘骨，莫教士卒哭龙荒。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 346861,
      "title": "和丘员外题湛长史旧居",
      "content": [
        "昔降英王顾，屏身幽岩曲。",
        "灵波结繁笳，爽籁赴鸣玉。",
        "运转春华至，岁来山草绿。",
        "青松掩落晖，白云竟空谷。",
        "伊人抚遗叹，恻恻芳又缛。",
        "云谁𢽾美香，分毫寄明牧。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 346864,
      "title": "赠宣大师",
      "content": [
        "一国沙弥独解诗，人人道胜惠林师。",
        "先皇诏下征还日，",
        "因论佛地求心地，只说常吟是住持。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 346873,
      "title": "上黄堆烽",
      "content": [
        "心期紫阁山中月，身过黄堆烽上云。",
        "年发已从书剑老，戎衣更逐霍将军。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 371859,
      "title": "宣上人病中相寻联句",
      "content": [
        "策杖迎诗客，归房理病身。",
        "闲收无效药，遍寄有情人。",
        "——广宣",
        "草木分千品，方书问六陈。",
        "还知一室内，我尔即天亲。",
        "——李益"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 371860,
      "title": "八月十五夜宣上人独游安国寺山庭院步人迟…乘兴联句",
      "content": [
        "九重城接天花界，三五秋生一夜风。",
        "——广宣",
        "行听漏声云散后，遥闻天语月明中。",
        "——广宣",
        "含凉阁迥通仙掖，承露盘高出上宫。",
        "——李益",
        "谁问独愁门外客，清谈不与此宵同。",
        "——李益"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 371861,
      "title": "重阳夜集兰陵居与宣上人联句",
      "content": [
        "蟋蟀催寒服，茱萸滴露房。",
        "酒巡明刻烛，篱菊暗寻芳。",
        "——李益",
        "新月和秋露，繁星混夜霜。",
        "登高今夕事，九九是天长。",
        "——广宣"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 371862,
      "title": "与宣供奉携瘿尊归杏溪园联句",
      "content": [
        "千畦抱瓮园，一酌瘿尊酒。",
        "唯有沃洲僧，时过杏溪臾。",
        "——李益",
        "追欢君适性，独饮我空口。",
        "儒释事虽殊，文章意多偶。",
        "——广宣"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 371863,
      "title": "兰陵僻居联句",
      "content": [
        "潘岳闲居赋，陶潜独酌谣。",
        "二贤成往事，三径是今朝。",
        "——广宣",
        "生幸逢唐运，昌时奉帝尧。",
        "进思谐启沃，退混即渔樵。",
        "——李益",
        "蠹简封延阁，雕阑閟上霄。",
        "相从清旷地，秋露挹兰苕。",
        "——杜羔"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 371864,
      "title": "天津桥南山中各题一句",
      "content": [
        "野坐分苔席，——李益",
        "山行绕菊丛。",
        "——韦执中",
        "云衣惹不破，——诸葛觉",
        "秋色望来空。",
        "——贾岛"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 371865,
      "title": "红楼下联句",
      "content": [
        "佛刹接重城，红楼切太清。",
        "紫云连照耀，丹槛郁峥嵘。",
        "——广宣",
        "榱栋烟虹入，轩窗日月平。",
        "参差五陵晚，分背八川明。",
        "——李益",
        "松韵风初过，莲陂浪欲倾。",
        "敬瞻疑涌见，围绕学无生。",
        "——杜羔"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 371866,
      "title": "赋应门照绿苔",
      "content": [
        "宫阙何年月，应门何岁苔。",
        "清光一以照，白露共裴回。",
        "——李益",
        "珠履久行绝，玉房重未开。",
        "妾心正如此，昭阳歌吹来。",
        "——法振"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 376703,
      "title": "暖川",
      "content": [
        "胡风冻合䴙鹈泉，牛马千群逐暖川。",
        "塞外征行无尽日，年年移帐雪中天。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 376704,
      "title": "从军北征",
      "content": [
        "天山雪后海风寒，横笛偏吹《行路难》。",
        "碛里征人三十万，一时回首月中看。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 376705,
      "title": "夜上受降城闻笛",
      "content": [
        "回乐烽前沙似雪，受降城外月如霜。",
        "不知何处吹芦管，一夜征人尽望乡。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 376706,
      "title": "水宿闻雁",
      "content": [
        "早雁忽为双，惊秋风水凉。",
        "夜长人自起，星月满空江。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 376707,
      "title": "江南曲",
      "content": [
        "嫁得瞿塘贾，朝朝误妾期。",
        "早知潮有信，嫁与弄潮儿。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
