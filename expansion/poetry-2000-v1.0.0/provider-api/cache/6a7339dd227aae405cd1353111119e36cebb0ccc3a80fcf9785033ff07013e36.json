{
  "data": [
    {
      "id": 79522,
      "title": "谒庙马上有感",
      "content": [
        "旌旆晓悠悠，行惊岁已遒。",
        "霜云依日薄，野水带冰流。",
        "富庶齐三服，山川禹九州。",
        "自怜思颍意，无异旅人愁。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 79523,
      "title": "毬场看山",
      "content": [
        "为爱南山紫翠峰，偶来仍值雪初融。",
        "自嫌前引朱衣吏，不称闲行白发翁。",
        "向老光阴双转毂，此身天地一飘蓬。",
        "何时粗报君恩了，去逐冥冥物外鸿。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 79524,
      "title": "残腊",
      "content": [
        "腊雪初销上古台，桑郊向日彩旗开。",
        "山横南陌城中见，春逐东风海上来。",
        "老去每惊新岁换，病多能使壮心摧。",
        "自嗟空有东阳瘦，览物慙无八咏才。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 79525,
      "title": "岁暮书事",
      "content": [
        "东州负海圻，风物老依依。",
        "岁熟鵶声乐，天寒鴈过稀。",
        "跨鞍惊髀骨，数带减腰围。",
        "却羡常夫子，终年独掩扉。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 79526,
      "title": "闻沂州卢侍郎致仕有感",
      "content": [
        "少年相与探花开，老病惟愁节物催。",
        "蹉跎归计荒三径，牢落生涯泥一杯。",
        "颍上先生招不起，沂州太守亦归来。",
        "自媿国恩终莫报，尚贪荣禄此徘徊。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 79527,
      "title": "春晴书事",
      "content": [
        "莫笑青州太守顽，三齐人物旧安闲。",
        "晴明风日家家柳，高下楼台处处山。",
        "嘉客但当倾美酒，青春终不换颓颜。",
        "惟慙未报君恩了，昨日卢公衣锦还。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 79528,
      "title": "游石子涧",
      "content": [
        "巀嶭高亭古涧隈，偶携嘉客共徘徊。",
        "席间风起闻天籁，雨后山光入酒杯。",
        "泉落断崖舂壑响，花藏深崦过春开。",
        "麏䴥禽鸟莫惊顾，太守不将车骑来。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 79529,
      "title": "读易",
      "content": [
        "莫嫌白发拥朱轮，恩许东州养病臣。",
        "饮酒横琴销永日，焚香读易过残春。",
        "昔贤轩冕如遗屣，世路风波偶脱身。",
        "寄语西家隐君子，奈何名姓已惊人。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 79530,
      "title": "水磨亭子",
      "content": [
        "多病山斋厌鬰蒸，经时久不到东城。",
        "新荷出水双飞鹭，乔木成阴百啭鸎。",
        "载酒未妨佳客醉，凭高仍见老农耕。",
        "史君自有林泉趣，不用丝篁乱水声。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 79531,
      "title": "寄题相州荣归堂",
      "content": [
        "白首三朝社稷臣，壶浆夹道拥如云。",
        "金貂争看真丞相，竹马犹迎旧使君。",
        "岂止轩裳夸故里，已将钟鼎勒元勋。",
        "不须授简樽前客，好学平津自有文。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 79532,
      "title": "昼锦堂",
      "content": [
        "昔憩甘棠长旧围，重来城郭叹人非。",
        "随车仍是为霖雨，被衮何如衣锦归。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 79533,
      "title": "观鱼轩",
      "content": [
        "当年下泽驱羸马，今见犀兵拥碧油。",
        "位望愈隆心愈静，每来临水翫游鯈。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 79534,
      "title": "狎鸥亭",
      "content": [
        "险夷一节如金石，勋德俱高映古今。",
        "岂止忘机鸥鸟信，陶钧万物本无心。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 79535,
      "title": "休逸台",
      "content": [
        "清谈终日对清樽，不似崇高富贵身。",
        "已有山川资胜赏，更将风月醉嘉宾。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 79536,
      "title": "青州书事",
      "content": [
        "年丰千里无夜警，吏退一室焚清香。",
        "青春固非老者事，白日自为闲人长。",
        "禄厚岂惟慙饱食，俸余仍足买轻装。",
        "君恩天地不违物，归去行歌颍水傍。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 79537,
      "title": "留题南楼二绝  其一",
      "content": [
        "偷得青州一岁闲，四时终日面孱颜。",
        "须知我是爱山者，无一诗中不说出。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 79538,
      "title": "留题南楼二绝  其二",
      "content": [
        "醉翁到处不曾醒，问向青州作么生。",
        "公退留宾夸酒美，睡余欹枕看山横。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 79539,
      "title": "答和王宣徽",
      "content": [
        "相逢莫怪我皤然，出处参差四纪间。",
        "有道方令万物遂，无能拟乞一身闲。",
        "花前独酌罇前月，淮上扁舟枕上山。",
        "此乐想公应未暇，且持金盏醉红颜。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 79540,
      "title": "答和吕侍读",
      "content": [
        "昔日题舆媿屈贤，今来还见拥朱轓。",
        "笑谈二纪思如昨，名望三朝老更尊。",
        "野径冷香黄菊秀，平湖斜照白鸥翻。",
        "此中自有忘言趣，病客犹堪奉一罇。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 79541,
      "title": "奉答子履学士见寄之作",
      "content": [
        "忆昨初为亳守行，暂休车骑汝阴城。",
        "喜君再共罇俎乐，怜我久怀丘壑情。",
        "累牍已尝陈素志，新春应许遂归耕。",
        "老年虽不堪东作，犹得酣歌咏太平。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 79542,
      "title": "谢景平挽词",
      "content": [
        "忆见奇童髧两髦，遽惊名誉众推高。",
        "东山子弟家风在，西汉文章笔力豪。",
        "方看凌云驰𫘧骥，已嗟埋玉向蓬蒿。",
        "追思阳夏曾游处，抚事伤心涕满袍。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 79543,
      "title": "答资政邵谏议见寄二首  其一",
      "content": [
        "豪横当年气吐虹，萧条晚节鬓如蓬。",
        "欲知颍水新居士，即是滁山旧醉翁。",
        "所乐蕃篱追尺鷃，敢言寥廓逐冥鸿。",
        "期公归辅岩廓上，顾我无忘畎亩中。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 79544,
      "title": "答资政邵谏议见寄二首  其二",
      "content": [
        "欲知归计久迁延，三十篇诗二十年。",
        "受宠不思身报效，乞骸惟冀上哀怜。",
        "相如旧苦中痟渴，陶令犹能一醉眠。",
        "材薄力殚难勉强，岂同高士爱林泉。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 79545,
      "title": "拟玉台体七首 欲眠",
      "content": [
        "行人夜已断，明河南陌头。",
        "双珰不拟解，更欲要君留。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 79546,
      "title": "拟玉台体七首 携手曲",
      "content": [
        "落日堤上行，独歌携手曲。",
        "却忆携手人，处处春华绿。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 79547,
      "title": "拟玉台体七首 雨中归",
      "content": [
        "朝看楼上云，日幕城南雨。",
        "路远香车迟，迢迢向何所。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 79548,
      "title": "拟玉台体七首 别后",
      "content": [
        "连环结连带，赠君情不忘。",
        "暂别莫言易，一夕九回肠。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 79549,
      "title": "拟玉台体七首 夜夜曲",
      "content": [
        "浮云吐明月，流影玉阶阴。",
        "千里虽共照，安知夜夜心。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 79550,
      "title": "落日窗中坐",
      "content": [
        "朝闻惊禽去，日暮见禽归。",
        "瑶琴坐不理，含情复为谁。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 79551,
      "title": "落日窗中坐 领边绣",
      "content": [
        "双鸳刺绣领，粲烂五文章。",
        "暂近已复远，犹持歌扇障。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 79552,
      "title": "七交七首 河南府张推官",
      "content": [
        "尧夫大雅哲，禀德实温粹。",
        "霜筠秀含润，玉海湛无际。",
        "平明坐大府，官事盈案几。",
        "高谈遣放纷，外物不能累。",
        "非惟席上珍，乃是青云器。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 79553,
      "title": "七交七首 尹书记",
      "content": [
        "师鲁天下才，神锋凛豪俊。",
        "逸骥卧秋枥，意在骙骙迅。",
        "平居弄翰墨，挥酒不停瞬。",
        "谈笑帝王略，驱驰古今论。",
        "良工正求玉，片石胡为韫。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 79554,
      "title": "七交七首 杨户曹",
      "content": [
        "子聪江山禀，弱岁擅奇誉。",
        "盱衡恣文辩，落笔妙言语。",
        "胡为冉冉趋，三十滞公府。",
        "美璞思善价，浮云有夷路。",
        "大雅恶速成，俟命宜希古。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 79555,
      "title": "七交七首 梅主簿",
      "content": [
        "圣俞翘楚才，乃是东南秀。",
        "玉山高岑岑，映我觉形陋。",
        "离骚喻草香，诗人识鸟兽。",
        "城中争拥鼻，欲学不能就。",
        "平日礼文贤，宁久滞奔走。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 79556,
      "title": "七交七首 张判官",
      "content": [
        "洛城车隆隆，晓门争道入。",
        "连袂纷如帷，文者岂无十。",
        "壮矣张太素，拂羽择其集。",
        "远慕邺才子，一笑懽相挹。",
        "虽有轩与冕，攀翔莫能及。",
        "人将孰君子，盍视其游执。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 79557,
      "title": "七交七首 王秀才",
      "content": [
        "几道颜之徒，沈深务覃圣。",
        "采藻荐良璧，文润相辉映。",
        "入市羊驾车，谈道犀为柄。",
        "时时一文出，往往纸价盛。",
        "无为恋丘樊，遂滞蒲轮聘。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 79558,
      "title": "七交七首 自叙",
      "content": [
        "余本漫浪者，兹亦漫为官。",
        "胡然类鸱夷，托载随车辕。",
        "时士不俛眉，默默谁与言。",
        "赖有洛中俊，日许相跻攀。",
        "饮德醉醇酎，袭馨佩春兰。",
        "平时罢军檄，文酒聊相欢。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 79559,
      "title": "答杨辟喜雨长句",
      "content": [
        "吾闻阴阳在天地，升降上下无时穷。",
        "环回不得不差失，所以岁时无常丰。",
        "古之为政知若此，均节收歛勤人功。",
        "三年必有一年食，九岁常备三岁凶。",
        "纵令水旱或时遇，以多补少能相通。",
        "今者吏愚不善政，民亦游惰离于农。",
        "军国赋歛急星火，兼并奉养过王公。",
        "终年之耕幸一熟，聚而耗者多于蠭。",
        "是以比岁屡登稔，然而民室常虚空。",
        "遂令一时暂不雨，辄以困急号天翁。",
        "赖天闵民不责吏，甘泽流布何其浓。",
        "农当勉力吏当愧，敢不酌酒浇神龙。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 79560,
      "title": "嵩山十二首 公路涧",
      "content": [
        "驱马渡寒流，断涧横荒堡。",
        "槎危欲欹岸，花落多依草。",
        "击汰翫游鯈，倒影看飞鸟。",
        "留连爱芳社，渐下西峰照。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 79561,
      "title": "嵩山十二首 拜马涧",
      "content": [
        "昔闻王子晋，把袂浮丘仙。",
        "金骏于此堕，吹笙不复还。",
        "玉蹄无迹久，涧草但荒烟。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 79562,
      "title": "嵩山十二首 二室道",
      "content": [
        "二室对岧峣，群峰耸崷直。",
        "云随高下起，路转参差碧。",
        "春晚桂丛深，日下山烟白。",
        "芝英已可茹，悠然想泉石。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 79563,
      "title": "嵩山十二首 自峻极中院步登太室中峰",
      "content": [
        "系马青松阴，蹑屣苍崖路。",
        "惊鸟动林花，空山答人语。",
        "云霞不可揽，直入冥冥雾。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 79564,
      "title": "嵩山十二首 玉女窗",
      "content": [
        "玉女不可邀，苍崖鬰岧直。",
        "石乳滴空窦，仰见泬寥碧。",
        "徙倚难久留，桂树含春色。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 79565,
      "title": "嵩山十二首 玉女捣衣石",
      "content": [
        "玉女捣仙衣，夜下青松岭。",
        "山深风露寒，月杵遥相应。",
        "灵踪杳可寻，片石秋光莹。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 79566,
      "title": "嵩山十二首 天门",
      "content": [
        "石径方盘纡，双峰忽中断。",
        "呀豁青冥间，畜泄烟云乱。",
        "杉萝试举手，自可阶天汉。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 79567,
      "title": "嵩山十二首 天门泉",
      "content": [
        "烟霞天门深，灵泉吐岩侧。",
        "云湿颢气寒，石老林腴碧。",
        "长松暂休坐，一酌烦心涤。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 79568,
      "title": "嵩山十二首 天池",
      "content": [
        "高步登天池，灵源湛然吐。",
        "俯窥不可见，渊默神龙护。",
        "静夜天籁寒，宿客疑风雨。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 79569,
      "title": "嵩山十二首 三醉石",
      "content": [
        "拂石登古坛，旷怀聊共醉。",
        "云霞伴酣乐，忽在千峰外。",
        "坐久还自醒，日落松声起。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 79570,
      "title": "嵩山十二首 峻极寺",
      "content": [
        "路入石门见，苍苍深霭间。",
        "云生石砌润，木老天风寒。",
        "客来依返照，徙倚听山蝉。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 79571,
      "title": "嵩山十二首 中峰",
      "content": [
        "望望不可到，行行何屈盘。",
        "一迳林杪出，千岩云下看。",
        "烟岚半明灭，落照在峰端。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 79572,
      "title": "初秋普明寺竹林小饮饯梅圣俞分韵得亭臯木叶下五首  其一",
      "content": [
        "临水复欹石，陶然同醉醒。",
        "山霞坐未敛，池月来亭亭。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 79573,
      "title": "初秋普明寺竹林小饮饯梅圣俞分韵得亭臯木叶下五首  其二",
      "content": [
        "洛城风日美，秋色满蘅臯。",
        "谁同茂林下，扫叶酌松醪。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 79574,
      "title": "初秋普明寺竹林小饮饯梅圣俞分韵得亭臯木叶下五首  其三",
      "content": [
        "野水竹间清，秋山酒中绿。",
        "送子此酣歌，淮南应落木。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 79575,
      "title": "初秋普明寺竹林小饮饯梅圣俞分韵得亭臯木叶下五首  其四",
      "content": [
        "劝客芙蓉杯，欲搴芙蓉叶。",
        "垂杨碍行舟，演漾回轻楫。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 79576,
      "title": "初秋普明寺竹林小饮饯梅圣俞分韵得亭臯木叶下五首  其五",
      "content": [
        "山水日已佳，登临同上下。",
        "衰兰尚可采，欲赠离居者。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 79577,
      "title": "和谢学士泛伊川浩然无归意因咏刘长卿佳句作欲留篇之什",
      "content": [
        "久不见南山，依然已秋色。",
        "悠哉川上行，复邀城中客。",
        "木落山半空，川明潦尤积。",
        "飞鸟鉴中看，行云舟中白。",
        "夷犹白苹里，笑傲清风侧。",
        "极浦追所远，回峰高易夕。",
        "觞咏共留连，高怀追昔贤。",
        "惟应谢公兴，不减向临川。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 79578,
      "title": "戏书拜呈学士三丈",
      "content": [
        "渊明本嗜酒，一钱常不持。",
        "人邀辄就饮，酩酊篮舆归。",
        "归来步三径，索寞绕东篱。",
        "咏句把黄菊，望门逢白衣。",
        "欣然复坐酌，独醉卧斜晖。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 79579,
      "title": "和杨子聪答圣俞月夜见寄",
      "content": [
        "秋露蔼已繁，迢迢星汉回。",
        "皎洁庭际月，流光依井苔。",
        "有客爱凉景，幽轩为君开。",
        "所思不可极，但慰清风来。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 79580,
      "title": "谢人寄双桂树子",
      "content": [
        "有客赏芳丛，移根自幽谷。",
        "为怀山中趣，爱此岩下绿。",
        "晓露秋晖浮，清阴药栏曲。",
        "更待繁花白，邀君弄芒馥。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 79581,
      "title": "雨中独酌二首  其一",
      "content": [
        "老大世情薄，掩关外郊原。",
        "英英少年子，谁肯过我门。",
        "宿云屯朝阴，暑雨清北轩。",
        "逍遥一罇酒，此意谁与论。",
        "酒味正薰烈，吾心方浩然。",
        "鸣禽时一弄，如与古人言。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 79582,
      "title": "雨中独酌二首  其二",
      "content": [
        "幽居草木深，蒙笼蔽窗户。",
        "鸟语知天阴，蛙鸣识天雨。",
        "亦复命罇酒，欣兹却烦暑。",
        "人情贵自适，独乐非钟鼓。",
        "出门何所之，闭门谁我顾。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 79583,
      "title": "庭前两好树",
      "content": [
        "庭前两好树，日夕欣相对。",
        "风霜岁苦晚，枝叶常葱翠。",
        "午眠背清阴，露坐荫高盖。",
        "东城桃李月，车马倾阛阓。",
        "而我不出门，依然伴憔悴。",
        "荣华不随时，寂寞幸相慰。",
        "君子固有常，小人多变态。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 79584,
      "title": "绿竹堂独饮",
      "content": [
        "夏篁解箨阴加樛，卧斋公退无喧嚣。",
        "清和况复值佳月，翠树好鸟鸣咬咬。",
        "芳罇有酒美可酌，胡为欲饮先长谣。",
        "人生暂别客秦楚，尚欲泣泪相攀邀。",
        "况兹一诀乃永已，独使幽梦恨蓬蒿。",
        "忆予驱马别家去，去时柳陌东风高。",
        "楚乡留滞一千里，归来落尽李与桃。",
        "残花不共一日看，东风送哭声嗷嗷。",
        "洛池不见青春色，白杨但有风萧萧。",
        "姚黄魏紫开次第，不觉成恨俱零凋。",
        "榴花最晚今又拆，红绿点缀如裙腰。",
        "年芳转新物转好，逝者日与生期遥。",
        "予生本是少年气，瑳磨牙角争雄豪。",
        "马迁班固洎歆向，下笔点窜皆嘲嘈。",
        "客来共坐说今古，纷纷落尽玉麈毛。",
        "弯弓或拟射石虎，又欲醉斩荆江蛟。",
        "自言刚气贮心腹，何尔柔软为脂膏。",
        "吾闻庄生善齐物，平日吐论奇牙聱。",
        "忧从中来不自遣，强叩瓦缶何𫍢𫍢。",
        "伊人达者尚乃尔，情之所钟况吾曹。",
        "愁填胸中若山积，虽欲强饮如沃焦。",
        "乃判自古英壮气，不有此恨如何消。",
        "又闻浮屠说生死，灭没谓若梦幻泡。",
        "前有万古后万世，其中一世独虭蟧。",
        "安得独洒一榻泪，欲助河水增滔滔。",
        "古来此事无可奈，不如饮此罇中醪。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 79585,
      "title": "暇日雨后绿竹堂独居兼简府中诸僚",
      "content": [
        "新晴竹林茂，日夕爱此君。",
        "佳禽哢翠树，若与幽人亲。",
        "扫径绿苔静，引流清派分。",
        "开轩见远岫，欹枕送归云。",
        "桐槿渐秋意，琴觞怀友文。",
        "浩然沧洲思，日厌京洛尘。",
        "车骑方开府，梁王多上宾。",
        "平时罢飞檄，行乐喜从军。",
        "骑省悼亡后，漳滨多病身。",
        "南窗若可傲，方事陶潜巾。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 79586,
      "title": "江上弹琴",
      "content": [
        "江水深无声，江云夜不明。",
        "抱琴舟上弹，栖鸟林中惊。",
        "游鱼为跳跃，山风助清泠。",
        "境寂听愈真，弦舒心已平。",
        "用兹有道器，寄此无景情。",
        "经纬文章合，谐和雌雄鸣。",
        "飒飒骤风雨，隆隆隐雷霆。",
        "无射变凛冽，黄钟催发生。",
        "咏歌文王雅，怨刺离骚经。",
        "二典意澹薄，三盘语丁宁。",
        "琴声虽可状，琴意谁可听。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 79587,
      "title": "送白秀才西归",
      "content": [
        "白子来自西，投我文与书。",
        "升阶揖让席，言气温且舒。",
        "万辙走声利，独趋仁义涂。",
        "仁义荒已久，斤锄费耕除。",
        "吾常患力寡，欣子好古徒。",
        "终当竭其力，刬治为通衢。",
        "旗旄侍天子，安驾五辂车。",
        "尽驱天子民，垂白歌其隅。",
        "子其从我游，有志知何如。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 79588,
      "title": "巩县初见黄河",
      "content": [
        "河决三门合四水，径流万里东输海。",
        "巩洛之山夹而峙，河来啮山作沙嘴。",
        "山形迤逦若奔避，河益汹汹怒而詈。",
        "舟师弭檝不以帆，顷刻奔过不及视。",
        "舞波渊旋投沙渚，聚沫倏忽为平地。",
        "下窥莫测浊且深，痴龙怪鱼肆凭恃。",
        "我生居南不识河，但见禹贡书之记。",
        "其言河状巨且猛，验河质书信皆是。",
        "昔者帝尧与帝舜，有子朱商不堪嗣。",
        "皇天意欲开禹圣，以水病尧民以溃。",
        "尧愁下人瘦若腊，众臣荐鲧帝曰试。",
        "试之九载功不效，遂殛羽山慙而毙。",
        "禹羞父罪哀且勤，天始以书畀于姒。",
        "书曰五行水润下，禹得其术因而治。",
        "凿山疏流浚畎浍，分擘枝派有条理。",
        "万邦入贡九州宅，生人始免生鳞尾。",
        "功深德大夏以家，施及三代蒙其利。",
        "江海淮济洎汉沔，岂不浩渺汪而大。",
        "收波卷怒畏威德，万古不敢肆凶厉。",
        "惟兹浊流不可律，历自秦汉尤为害。",
        "崩坚决壅势益横，斜跳旁出惟其意。",
        "制之以力不以德，驱民就溺财随弊。",
        "盖闻河源出昆仑，其山上高大无际。",
        "自高泻下若激箭，一直一曲一千里。",
        "湍雄冲急乃迸溢，其势不得不然尔。",
        "前岁河怒惊滑民，浸漱洋洋淫不止。",
        "滑人奔走若锋骇，河伯视之以为戏。",
        "呀呀怒口缺若门，日啖薪石万万计。",
        "明堂天子圣且神，悼河不仁嗟曰喟。",
        "河伯素顽不可令，至诚一感惶且畏。",
        "引流辟易趋故道，闭口不改烦官吏。",
        "遵涂率职直东下，咫尺莫可离其次。",
        "尔来岁星行一周，民牛饱刍邦羡费。",
        "滑人居河饮河流，耕河之壖浸河𣸣。",
        "嗟河改凶作民福，呜呼明堂圣天子。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 79589,
      "title": "代书寄尹十一兄杨十六王三",
      "content": [
        "竝辔登北原，分首昭陵道。",
        "秋风吹行衣，落日下霜草。",
        "昔日憩巩县，信马行苦早。",
        "行行过任村，遂历黄河隩。",
        "登高望河流，汹汹若怒闹。",
        "予生平居南，但闻河浩渺。",
        "停鞍暂游目，茫洋肆惊眺。",
        "并河行数曲，山坡亦萦绕。",
        "甖子与山口，呀险乃天灶。",
        "秤钩真如钩，上下欲颠倒。",
        "虎牢吏当关，讥问名已告。",
        "荥阳夜闻雨，故人留我笑。",
        "明朝已高尘，輤车引旌纛。",
        "传云送主丧，窀穸诣坟兆。",
        "后乘皆辎𫐌，轮毂相辉照。",
        "辟易未及避，庐儿已呵噭。",
        "午出郑东门，下马仆射庙。",
        "中牟去郑远，记里十余堠。",
        "抵牟日已暮，仆马困米槀。",
        "渐望阊阖门，崛若中天表。",
        "趋门争道入，羁鞅不及掉。",
        "浪墥游九衢，风埃叹何浩。",
        "京师天下聚，奔走纷扰扰。",
        "但闻街鼓喧，忽忽夜复晓。",
        "追怀洛中俊，已动思归操。",
        "为别未期月，音尘一何杳。",
        "因书写行役，聊以为君导。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 79590,
      "title": "别圣俞",
      "content": [
        "车马古城隅，喧喧分晓色。",
        "行人念归涂，居者徒惨恻。",
        "薄宦共羁旅，论交喜金石。",
        "荐以朋酒懽，宁知岁月适。",
        "人事坐云变，出处俄乖隔。",
        "关山自兹始，挥袂举轻策。",
        "岁暮寒云多，野旷阴风积。",
        "征蹄践严霜，别酒临长陌。",
        "应念同时人，独为未归客。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 79591,
      "title": "送刘秀才归河内",
      "content": [
        "落日古京门，车马动行色。",
        "河上多悲风，山阳有归客。",
        "朽箧蠹虫篆，遗文摹鸟迹。",
        "言干有司知，岂顾时人识。",
        "山陂岁始寒，霰雪密已积。",
        "还爱宁久留，方言事征轭。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 79592,
      "title": "数诗",
      "content": [
        "一室曾何埽，居闲俗虑平。",
        "二毛经节变，青鉴不须惊。",
        "三复磨圭戒，深防悔吝生。",
        "四愁宁敢拟，高咏且陶情。",
        "五鼎期君禄，无思死必烹。",
        "六奇还自秘，海宇正休兵。",
        "七日南山雾，彪文幸有成。",
        "八门当鼓翼，凌厉指霄程。",
        "九德方居位，皇猷日月明。",
        "十朋如可问，从此卜嘉亨。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 79593,
      "title": "答钱寺丞忆伊川",
      "content": [
        "之子问伊川，伊川已春色。",
        "绿芷杂芳浦，青溪含白石。",
        "山阿昔留赏，屐齿无遗迹。",
        "惟有岩桂花，留芳待归客。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 79594,
      "title": "书怀感事寄梅圣俞",
      "content": [
        "相别始一岁，幽忧有百端。",
        "乃知一世中，少乐多悲患。",
        "每忆少年日，未知人事艰。",
        "颠狂无所阂，落魄去羁牵。",
        "三月入洛阳，春深花未残。",
        "龙门翠鬰鬰，伊水清潺潺。",
        "逢君伊水畔，一见已开颜。",
        "不暇谒大尹，相携步香山。",
        "自兹惬所适，便若投山猿。",
        "幕府足文士，相公方好贤。",
        "希深好风骨，迥出风尘间。",
        "师鲁心磊落，高谈羲与轩。",
        "子渐口若讷，诵书坐千言。",
        "彦国善饮酒，百盏颜未丹。",
        "几道事闲远，风流如谢安。",
        "子聪作参军，常跨破虎鞯。",
        "子野乃秃翁，戏弄时脱冠。",
        "次公才旷奇，王霸驰笔端。",
        "圣俞善吟哦，共嘲为阆仙。",
        "惟予号达老，醉必如张颠。",
        "洛阳古郡邑，万户美风烟。",
        "荒凉见宫阙，表里壮河山。",
        "相将日无事，上马若鸿翩。",
        "出门尽垂柳，信步即名园。",
        "嫩箨筠粉暗，渌池萍锦翻。",
        "残花落酒面，飞絮拂归鞍。",
        "寻尽水与竹，忽去嵩峰巅。",
        "青苍缘万仞，杳蔼望三川。",
        "花草窥涧窦，崎岖寻石泉。",
        "君吟倚树立，我醉欹云眠。",
        "子聪疑日近，谓若手可攀。",
        "共题三醉石，留在八仙坛。",
        "水云心已倦，归坐正杯盘。",
        "飞琼始十八，妖妙犹双环。",
        "寒篁暖凤嘴，银甲调鴈弦。",
        "自制白云曲，始送黄金船。",
        "珠帘卷明月，夜气如春烟。",
        "灯花弄粉色，酒红生脸莲。",
        "东堂榴花好，点缀裙腰鲜。",
        "插花云髻上，展簟绿阴前。",
        "乐事不可极，酣歌变为叹。",
        "诏书走东下，丞相忽南迁。",
        "送之伊水头，相顾泪潸潸。",
        "腊月相公去，君随赴春官。",
        "送君白马寺，独入东上门。",
        "故府谁同在，新年独未还。",
        "当时作此语，闻者已依然。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 79595,
      "title": "杂言答圣俞见寄兼简东京诸友",
      "content": [
        "昔君居洛阳，乐事无时有。",
        "窦府富文章，谢墅从亲友。",
        "丰年政颇简，命驾时为偶。",
        "不问竹林主，仍携步兵酒。",
        "芬芳弄嘉月，翠绿相森茂。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 79596,
      "title": "闻梅二授德兴令戏书",
      "content": [
        "君家小谢城，为客洛阳里。",
        "绿发方少年，青衫喜为吏。",
        "重湖乱山绿，归梦寄千里。",
        "洛浦见秋鸿，江南老芳芷。",
        "自言北地禽，能感南人耳。",
        "京国本繁花，驰逐多英轨。",
        "争歌白雪曲，取酒西城市。",
        "朝逢油壁车，暮结青骢尾。",
        "岁月倏可忘，行乐方未已。",
        "忽尔畏简书，翻然浩归思。",
        "江山故国近，风物饶阳美。",
        "楚柚烟中黄，吴莼波上紫。",
        "还乡问井邑，上堂多庆喜。",
        "离别古所难，更畏秋风起。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 79597,
      "title": "戏赠",
      "content": [
        "莫愁家住洛川傍，十五纤腰闻四方。",
        "堂上金罇邀上客，门前白马系垂杨。",
        "春风满城花满树，落日花光争粉光。",
        "城头行人莫驻马，一曲能令君断肠。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 79598,
      "title": "寄左军巡刘判官",
      "content": [
        "遥听洛城钟，独渡伊川水。",
        "绿树鬰参差，行人去无已。",
        "因高望京邑，驱马沿山趾。",
        "落日乱峰多，龙门何处是。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 79599,
      "title": "罢官后初还襄城弊居述怀十韵回寄洛中旧寮",
      "content": [
        "路尽见家山，欣然望吾庐。",
        "陋巷叩柴扉，迎候遥惊呼。",
        "儿童戏竹马，田里邀篮舆。",
        "春桑鬰已绿，岁事催农夫。",
        "朝日飞雉雊，东皋新雨余。",
        "植杖望远林，行歌登故墟。",
        "夙志在一壑，兹焉将荷锄。",
        "言谢洛社友，因招洛中愚。",
        "马卿已倦客，严安犹献书。",
        "行矣方于役，岂能遂归欤。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 79600,
      "title": "和圣俞聚蚊",
      "content": [
        "颓阳照穷巷，暑退凉风生。",
        "夫子卧环堵，振衣步前楹。",
        "愁烟四邻起，鸟雀喧空庭。",
        "余景蔼欲昏，众蚊复薨薨。",
        "群飞岂能数，但厌声营营。",
        "抱琴不暇抚，挥麈无由停。",
        "散帙复归卧，咏言聊写情。",
        "覆载无巨细，善恶皆生成。",
        "朽木出众蠹，腐草为飞萤。",
        "书鱼长阴湿，鬰鸡由鬰蒸。",
        "豕鬣固多虱，牛闲常聚虻。",
        "元气或台鬰，𢹔之为孽腥。",
        "卑臭乃其类，清虚非所经。",
        "华堂敞高栋，绮疏仍藻扃。",
        "金红莹椒壁，玉壶含夜冰。",
        "终朝事薰祓，岂敢近簷甍。",
        "富贵非苟得，抱节居茅衡。",
        "阴墙百虫聚，下偃众秽盈。",
        "何尝曲肱乐，但苦聚雷声。",
        "江南美山水，水木正秋明。",
        "自古佳丽国，能助诗人情。",
        "喧嚣不可久，片席何时征。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 79601,
      "title": "送刘学士知衡州",
      "content": [
        "杨子懒属书，平居惟嗜酒。",
        "一沐或弥旬，解酲须五斗。",
        "淡尔轻荣利，何常问无有。",
        "忍忆四马归，行为一麾守。",
        "湘酎自古醇，醽水闻名久。",
        "簿领但盈几，圣经不离口。",
        "湖田赋稻蟹，民讼争垅亩。",
        "兀尔即沈冥，安能知可否。",
        "聊为寄情乐，岂与素怀偶。",
        "藏器思适时，投刃宁烦手。",
        "行当考官绩，勿复困甖缶。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 79602,
      "title": "送张屯田归洛歌",
      "content": [
        "昔年洛浦见花落，曾作悲歌歌落花。",
        "愁来欲遣何可柰，时向金河寻杜家。",
        "杜家花虽非绝品，犹可开颜为之饮。",
        "少年意气易成懽，醉不还家伴花寝。",
        "一来京国两伤春，憔悴穷愁九陌尘。",
        "红房紫莟处处有，骑马欲寻无故人。",
        "黄河三月入隋河，河水多时怅望多。",
        "为怜此水来何处，中有伊流与洛波。",
        "忽闻君至自西京，洗眼相看眼暂明。",
        "心衰面老畏人问，惊我瘦骨清如冰。",
        "今年七月妹丧夫，稚儿孀女啼呱呱。",
        "季秋九月予丧妇，十月厌厌成病躯。",
        "端居移病新城下，日不出门无过者。",
        "独行时欲强高歌，一曲未终双涕泪。",
        "可怜明月与春风，岁岁年年事不同。",
        "暂别已嗟非旧态，再来应是作衰翁。",
        "感时惜别情无已，无酒送君空有泪。",
        "西归必有问君人，为道别来今若此。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 79603,
      "title": "述怀送张总之",
      "content": [
        "鬰鬰河堤绿树平，送君困得到东城。",
        "落花已尽鸎犹啭，垂柳初长蝉欲鸣。",
        "去年送客亦曾到，正值杨花乱芳草。",
        "人心不复故时欢，景物自随时节好。",
        "感今怀昔复伤离，一别相逢知几时。",
        "莫辞今日一罇酒，明日思君难重持。",
        "东吴山水天下秀，羡君轻舟片帆逗。",
        "江城月下夜闻歌，淮浦山前朝放溜。",
        "乐哉此行时未晚，万壑千岩不知远。",
        "可怜病客厌京尘，寂寞淹留已再春。",
        "扁舟待得东南下，犹更河桥送几人。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 79604,
      "title": "送子野",
      "content": [
        "四时惨舒不可调，冬夏寒暑易鬰陶。",
        "春阳著物大软媚，独有秋节最劲豪。",
        "金方坚刚屏炎瘴，兑气高爽清风飚。",
        "烟霞破散灏气豁，山河震发地脉摇。",
        "天开宝鉴露寒月，海拍积雪卷怒潮。",
        "光辉通透夺星耀，蟠潜惊奋鬭蜃蛟。",
        "高楼精爽毛发竦，壮怀直恐冲斗杓。",
        "欲飞轻衣上拂汉，拟乘王气戏鹭涛。",
        "念时文法密于织，覊縻束缚不自聊。",
        "岂无策议献人主，扼持舌在口已胶。",
        "当秋且幸际轩豁，谁能儿女听螗蜩。",
        "君方壮岁襟宇快，名声乐与家声高。",
        "轻舟从游山川底，诗酒合兴皆翘翘。",
        "堪嗟宋玉自悲搅，可并张翰同逍遥。",
        "功名富贵有时到，忍把壮节良辰消。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 79605,
      "title": "送刘十三南游",
      "content": [
        "决决汴河流，橹声过晚浦。",
        "行客问吴山，舟人多楚语。",
        "春深紫兰泽，夏早黄梅雨。",
        "时应赋登眺，聊以忘覊旅。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 79606,
      "title": "与李献臣宋子京春集东园得节字",
      "content": [
        "绿野秀可餐，游骖喜初结。",
        "芸局苦寂寥，禁署隔清切。",
        "欢言得幽寻，况此及嘉节。",
        "鸟哢已关关，泉流初决决。",
        "紫萼繁若缀，翠苕柔可撷。",
        "屡期无后时，芳物畏𫛸鴂。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 79607,
      "title": "晚泊岳阳",
      "content": [
        "卧闻岳阳城里钟，系舟岳阳城下树。",
        "正见空江明月来，云水苍茫失江路。",
        "夜深江月弄清辉，水上人歌月下归。",
        "一阕声长听不尽，轻舟短楫去如飞。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 79608,
      "title": "新开棋轩呈元珍表臣",
      "content": [
        "竹树日已滋，轩窗渐幽兴。",
        "人闲与世远，鸟语知境静。",
        "春光蔼欲布，山色寒尚映。",
        "独收万虑心，于此一枰竞。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 79609,
      "title": "代赠田文初",
      "content": [
        "感君一顾重千金，赠君白璧为妾心。",
        "舟中绣被薰香夜，春雪江头三尺深。",
        "西陵长官头已白，憔悴穷愁媿相识。",
        "手持玉斝唱阳春，江上梅花落如积。",
        "津亭送别君未悲，梦阑酒解始相思。",
        "须知巫峡闻猿处，不似荆江夜雪时。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 79610,
      "title": "惠泉亭",
      "content": [
        "翠壁刻孱颜，烟霞跬步间。",
        "使君能爱客，朝夕弄山泉。",
        "春岩雨过春流长，置酒来听山溜响。",
        "鉴中楼阁俯清池，雪里峰峦开晓幌。",
        "须知清兴无时已，酒美宾嘉自相对。",
        "席间谁伴谢公吟，日暮多逢山简醉。",
        "淹留桂树几经春，野鸟岩花识使君。",
        "使君今是罇前客，谁与山泉作主人。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 79611,
      "title": "过张至秘校庄",
      "content": [
        "田家何所乐，籉笠日相亲。",
        "桑条起蚕事，菖叶候耕辰。",
        "望岁占风色，宽徭知政仁。",
        "樵渔逐晚浦，鸡犬隔前村。",
        "泉溜塍间动，山田树杪分。",
        "鸟声梅店雨，野色柳桥春。",
        "有客问行路，呼童惊候门。",
        "焚鱼酌白醴，但坐且懽忻。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 79612,
      "title": "行次叶县",
      "content": [
        "朝渡汝河流，暮宿楚山曲。",
        "城阴日下寒，野气春深绿。",
        "征车倦长道，故国有乔木。",
        "行行渐乐郊，东风满平陆。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 79613,
      "title": "将至淮安马上早行学谢灵运体六韵",
      "content": [
        "晴霞煦东浦，惊鸟动烟林。",
        "曙河兼斗没，沓嶂隐云深。",
        "寒鸡隔树起，曲坞留风吟。",
        "征失倦行役，秋兴感登临。",
        "衡皋积涂迥，江蓠香露沉。",
        "行矣岁华晚，归欤劳叹音。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 79614,
      "title": "自岐江山行至平陆驿五言二十四韵",
      "content": [
        "岐江望平陆，百里千余岭。",
        "萧条断烟火，莽苍无人境。",
        "峰峦互前后，南北失壬丙。",
        "天秋云愈高，木落岁方冷。",
        "水涉愁蜮射，林行忧虎猛。",
        "万仞悬岩崖，一彴履枯梗。",
        "缘危类猨猱，陷淖若蛙黾。",
        "腰舆惧倾扑，烦马倦鞭警。",
        "攀跻诚畏涂，习俗羡蛮犷。",
        "度隘足虽踠，因高目还骋。",
        "九野画荆衡，群山乱巫郢。",
        "烟岚互明灭，点缀成图屏。",
        "时时度深谷，往往得佳景。",
        "翠树鬰如盖，飞泉溜垂绠。",
        "幽花乱黄紫，蒨粲弄光影。",
        "山鸟啭成歌，寒蜩嘒如哽。",
        "登临虽云劳，巨细得周省。",
        "晨装趁徒旅，夕宿访闾井。",
        "村暗水茫茫，鸡鸣星耿耿。",
        "登高近佳节，归思时引领。",
        "谿菊荐山罇，田𫛪佐烹鼎。",
        "家近梦先归，夜寒衾屡整。",
        "崎岖念行役，昔宿已为永。",
        "岂如江上舟，棹歌方酩酊。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 79615,
      "title": "春日西湖寄谢法曹歌",
      "content": [
        "西湖春色归，春水绿于染。",
        "群芳烂不收，东风落如糁。",
        "参军春思乱如云，白发题诗愁送春。",
        "遥知湖上一罇酒，能忆天涯万里人。",
        "万里思春尚有情，忽逢春至客心惊。",
        "雪消门外千山绿，花发江边二月晴。",
        "少年把酒逢春色，今日逢春头已白。",
        "异乡物态与人殊，惟有东风旧相识。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 79616,
      "title": "答谢景山遗古瓦砚歌",
      "content": [
        "火数四百炎灵销，谁其代者当涂高。",
        "穷奸极酷不易取，始知文景基扃牢。",
        "坐挥长喙啄天下，豪杰竞起如猬毛。",
        "董吕傕汜相继死，绍术权备争咆咻。",
        "力彊者胜怯者败，岂较才德为功劳。",
        "然犹到手不敢取，而使螟蝗生蝮蜪。",
        "子丕当初不自耻，敢谓舜禹传之尧。",
        "得之以此失亦此，谁知三马食一槽。",
        "当其盛时争意气，叱咤雷雹生风飚。",
        "干戈战罢数功阀，周蔑方召尧无皋。",
        "英雄致酒奉高会，巍然铜雀高岧岧。",
        "圆歌宛转激清征，妙舞左右回纤腰。",
        "一朝西陵看拱木，寂寞穗帐空萧萧。",
        "当时凄凉已可叹，而况后世悲前朝。",
        "高台已倾渐平地，此瓦一坠埋蓬蒿。",
        "苔文半灭荒土蚀，战血曾经野火烧。",
        "败皮弊网各有用，谁使镌镵成凸凹。",
        "景山笔力若半弩，句遒语老能挥毫。",
        "嗟予夺得何所用，簿领朱墨徒纷淆。",
        "走官南北未尝舍，缇袭三四勤缄包。",
        "有时属思欲飞洒，意绪轧轧难抽缲。",
        "舟行屡备水神夺，往往冥晦遭风涛。",
        "质顽物久有精怪，常恐变化成灵妖。",
        "名都所至必传玩，爱之不换鲁宝刀。",
        "长歌送我怪且伟，欲报慙愧无琼瑶。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 79617,
      "title": "古瓦砚",
      "content": [
        "甎瓦贱微物，得厕笔墨间。",
        "于物用有宜，不计丑与妍。",
        "金非不为宝，玉岂不为坚。",
        "用之以发墨，不及瓦砾顽。",
        "乃知物虽贱，当用价难攀。",
        "岂惟瓦砾尔，用人从古难。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 79618,
      "title": "新营小斋凿地炉辄成五言三十七韵",
      "content": [
        "霜降百工休，居者皆入室。",
        "墐户畏初寒，开炉代温律。",
        "规模不盈丈，广狭足容膝。",
        "轩窗共幽窳，竹栢助蒙密。",
        "辛勤惭巧宦，穷贱守卑秩。",
        "无术政奚为，有年秋屡实。",
        "文书少期会，租讼省鞭抶。",
        "地僻与世踈，官闲得身佚。",
        "荆蛮苦卑陋，气候常壹鬰。",
        "天日每阴翳，风飙多凛凓。",
        "衰颜惨时晚，病骨如寒疾。",
        "蛮床倦晨兴，篮舆厌朝出。",
        "南山近樵采，僮仆免呵叱。",
        "御岁畜蹲鸱，馈客荐包橘。",
        "霜薪吹晶荧，石鼎沸啾唧。",
        "披方养丹砂，候节煎秋术。",
        "西邻有高士，𫐘轲卧蓬荜。",
        "鹤发善高谈，鲐背更炙熨。",
        "披裘屡相就，束缊亦时乞。",
        "传经伏生老，爱酒杨雄吃。",
        "晨灰煖余杯，夜火爆山粟。",
        "无言两忘形，相对或终日。",
        "微生慕刚毅，劲强早难屈。",
        "自从世欲牵，常恐天性失。",
        "仰兹微官禄，养此多病质。",
        "省躬由一言，无枉慕三黜。",
        "因知吏隐乐，渐使欲心窒。",
        "面壁或僧禅，倒冠聊酒逸。",
        "螟蛉轻二豪，一马齐万物。",
        "启期为乐三，叔夜不堪七。",
        "负薪幸有瘳，旧学颇思述。",
        "兴亡阅今古，图籍罗甲乙。",
        "鲁册谨会盟，周公彖凶吉。",
        "详明左丘辩，驰骋马迁笔。",
        "金石互铿鍧，风云生倏忽。",
        "豁尔一开卷，慨然时揜帙。",
        "浮沈恣其间，适若遂聱䎲。",
        "吾居谁云陋，所得乃非一。",
        "五斗岂须惭，忧游岁将毕。"
      ],
