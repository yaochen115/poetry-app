{
  "data": [
    {
      "id": 303112,
      "title": "长生草",
      "content": [
        "老根那复占春晴，能住虚根自发生。",
        "（见《剡录》卷十。",
        "疑伪）。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 307824,
      "title": "过崔驸马山池",
      "content": [
        "画楼吹笛妓，金椀酒家胡。",
        "锦石称贞女，青松学大夫。",
        "脱貂贳桂醑，射雁与山厨。",
        "闻道高阳会，愚公谷正愚。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 307825,
      "title": "过福禅师兰若",
      "content": [
        "岩壑转微迳，云林隐法堂。",
        "羽人飞奏乐，天女跪焚香。",
        "竹外峰偏曙，藤阴水更凉。",
        "欲知禅坐久，行路长春芳。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 307826,
      "title": "过香积寺",
      "content": [
        "不知香积寺，数里入云峰。",
        "古木无人迳，深山何处钟。",
        "泉声咽危石，日色冷青松。",
        "薄暮空潭曲，安禅制毒龙。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 307827,
      "title": "过感化寺昙兴上人山院",
      "content": [
        "暮持筇竹杖，相待虎谿头。",
        "催客闻山响，归房逐水流。",
        "野花丛发好，谷鸟一声幽。",
        "夜坐空林寂，松风直似秋。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 307828,
      "title": "夏日过青龙寺谒操禅师",
      "content": [
        "龙钟一老翁，徐步谒禅宫。",
        "欲问义心义，遥知空病空。",
        "山河天眼里，世界法身中。",
        "莫怪销炎热，能生大地风。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 307829,
      "title": "登辨觉寺",
      "content": [
        "竹径从初地，莲峰出化城。",
        "窗中三楚尽，林上九江平。",
        "软草承趺坐，长松响梵声。",
        "空居法云外，观世得无生。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 307830,
      "title": "喜祖三至留宿",
      "content": [
        "门前洛阳客，下马拂征衣。",
        "不枉故人驾，平生多掩扉。",
        "行人返深巷，积雪带余晖。",
        "早岁同袍者，高车何处归。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 307831,
      "title": "黎拾遗昕裴秀才迪见过秋夜对雨之作",
      "content": [
        "促织鸣已急，轻衣行向重。",
        "寒灯坐高馆，秋雨闻疎钟。",
        "白法调狂象，玄言问老龙。",
        "何人顾蓬径，空愧求羊踪。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 307832,
      "title": "慕容承携素馔见过",
      "content": [
        "纱帽乌皮几，闲居懒赋诗。",
        "门看五柳识，年筭六身知。",
        "灵寿君王赐，雕胡弟子炊。",
        "空劳酒食馔，持底解人颐。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 307833,
      "title": "晚春严少尹与诸公见过",
      "content": [
        "松菊荒三迳，图书共五车。",
        "烹葵邀上客，看竹到贫家。",
        "鹊乳先春草，莺啼过落花。",
        "自怜黄髪暮，一倍惜年华。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 307834,
      "title": "郑果州相过",
      "content": [
        "丽日照残春，初晴草木新。",
        "床前磨镜客，树下灌园人。",
        "五马惊穷巷，双童逐老身。",
        "中厨办麤饭，当恕阮家贫。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 307835,
      "title": "山居秋暝",
      "content": [
        "空山新雨后，天气晚来秋。",
        "明月松间照，清泉石上流。",
        "竹喧归浣女，莲动下渔舟。",
        "随意春芳歇，王孙自可留。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 307836,
      "title": "终南别业",
      "content": [
        "中岁颇好道，晚家南山陲。",
        "兴来每独往，胜事空自知。",
        "行到水穷处，坐看云起时。",
        "偶然值林叟，谈笑无还期。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 307837,
      "title": "归嵩山作",
      "content": [
        "清川带长薄，车马去闲闲。",
        "流水如有意，暮禽相与还。",
        "荒城临古渡，落日满秋山。",
        "迢递嵩高下，归来且闭关。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 307838,
      "title": "归辋川作",
      "content": [
        "谷口疎钟动，渔樵稍欲稀。",
        "悠然远山暮，独向白云归。",
        "菱蔓弱难定，杨花轻易飞。",
        "东臯春草色，惆怅掩柴扉。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 307839,
      "title": "韦给事山居",
      "content": [
        "幽寻得此地，讵有一人曾。",
        "大壑随阶转，群山入户登。",
        "庖厨出深竹，印绶隔垂藤。",
        "即事辞轩冕，谁云病未能。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 307840,
      "title": "山居即事",
      "content": [
        "寂寞掩柴扉，苍茫对落晖。",
        "鹤巢松树遍，人访荜门稀。",
        "绿竹含新粉，红莲落故衣。",
        "渡头烟火起，处处采菱归。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 307841,
      "title": "终南山",
      "content": [
        "太乙近天都，连山接海隅。",
        "白云回望合，青霭入看无。",
        "分野中峰变，阴晴众壑殊。",
        "欲投人处宿，隔水问樵夫。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 307842,
      "title": "辋川闲居",
      "content": [
        "一从归白社，不复到青门。",
        "时倚檐前树，远看原上村。",
        "青菰临水拔，白鸟向山翻。",
        "寂寞於陵子，桔槔方灌园。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 307843,
      "title": "春园即事",
      "content": [
        "宿雨乘轻屐，春寒著弊袍。",
        "开畦分白水，间柳发红桃。",
        "草际成棋局，林端举桔槔。",
        "还持鹿皮几，日暮隐蓬蒿。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 307844,
      "title": "淇上田园即事",
      "content": [
        "屏居淇水上，东野旷无山。",
        "日隐桑柘外，河明闾井间。",
        "牧童望村去，猎犬随人还。",
        "静者亦何事，荆扉乘昼关。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 307845,
      "title": "凉州郊外游望",
      "content": [
        "野老才三户，边村少四邻。",
        "婆娑依里社，箫鼓赛田神。",
        "洒酒浇刍狗，焚香拜木人。",
        "女巫纷屡舞，罗袜自生尘。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 307846,
      "title": "观猎",
      "content": [
        "风劲角弓鸣，将军猎渭城。",
        "草枯鹰眼疾，雪尽马蹄轻。",
        "忽过新丰市，还归细柳营。",
        "回看射雕处，千里暮云平。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 307847,
      "title": "春日上方即事",
      "content": [
        "好读高僧传，时看辟谷方。",
        "鸠形将刻杖，龟壳用支床。",
        "柳色春山暎，梨花夕鸟藏。",
        "北窗桃李下，闲坐但焚香。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 307848,
      "title": "汉江临泛",
      "content": [
        "楚塞三湘接，荆门九派通。",
        "江流天地外，山色有无中。",
        "郡邑浮前浦，波澜动远空。",
        "襄阳好风日，留醉与山翁。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 307849,
      "title": "泛前陂",
      "content": [
        "秋空自明迥，况复远人间。",
        "畅以沙际鹤，兼之云外山。",
        "澄波澹将夕，清月皓方闲。",
        "此夜任孤櫂，夷犹殊未还。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 307850,
      "title": "登河北城楼作",
      "content": [
        "井邑傅岩上，客亭云雾间。",
        "高城眺落日，极浦暎苍山。",
        "岸火孤舟宿，渔家夕鸟还。",
        "寂寥天地暮，心与广川闲。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 307851,
      "title": "千塔主人",
      "content": [
        "逆旅逢佳节，征帆未可前。",
        "窗临汴河水，门渡楚人船。",
        "鸡犬散墟落，桑榆荫远田。",
        "所居人不见，枕席生云烟。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 307852,
      "title": "使至塞上",
      "content": [
        "单车欲问边，属国过居延。",
        "征蓬出汉塞，归雁入胡天。",
        "大漠孤烟直，长河落日圆。",
        "萧关逢候吏，都护在燕然。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 307853,
      "title": "使至塞上",
      "content": [
        "衔命辞天阙，单车欲问边。",
        "征蓬出汉塞，归雁入胡天。",
        "大漠孤烟直，长河落日圆。",
        "萧关逢候吏，都护在燕然。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 307854,
      "title": "晚春归思",
      "content": [
        "新妆可怜色，落日卷罗帷。",
        "𬬻气清珍簟，墙阴上玉墀。",
        "春虫飞网户，暮雀隐花枝。",
        "向晚多愁思，闲窗桃李时。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 307855,
      "title": "戏题示萧氏甥",
      "content": [
        "怜尔解临池，渠爷未学诗。",
        "老夫何足似，弊宅倘因之。",
        "芦笋穿荷叶，菱花罥雁儿。",
        "郗公不易胜，莫著外家欺。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 307856,
      "title": "秋夜独坐",
      "content": [
        "独坐悲双鬓，空堂欲二更。",
        "雨中山果落，灯下草虫鸣。",
        "白发终难变，黄金不可成。",
        "欲知除老病，唯有学无生。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 307857,
      "title": "待储光羲不至",
      "content": [
        "重门朝已启，起坐听车声。",
        "要欲闻清佩，方将出户迎。",
        "晚钟鸣上苑，疎雨过春城。",
        "了自不相顾，临堂空复情。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 307858,
      "title": "听宫莺",
      "content": [
        "春树遶宫墙，宫莺啭曙光。",
        "忽惊啼暂断，移处弄还长。",
        "隐叶栖承露，攀花出未央。",
        "游人未应返，为此始思乡。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 307859,
      "title": "杂诗",
      "content": [
        "双燕初命子，五桃新作花。",
        "王昌是东舍，宋玉次西家。",
        "小小能织绮，时时出浣纱。",
        "亲劳使君问，南陌驻香车。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 307860,
      "title": "留别钱起",
      "content": [
        "卑栖却得性，每与白云归。",
        "徇禄仍怀橘，看山免采薇。",
        "暮禽先去马，新月待开扉。",
        "霄汉时回首，知音青琐闱。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 307861,
      "title": "留别丘为",
      "content": [
        "归鞍白云外，缭绕出前山。",
        "今日又明日，自知心不闲。",
        "亲劳簪组送，欲趂莺花还。",
        "一步一回首，迟迟向近关。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 307862,
      "title": "愚公谷三首 一",
      "content": [
        "愚谷与谁去，唯将黎子同。",
        "非须一处住，不那两心空。",
        "宁问春将夏，谁论西复东。",
        "不知吾与子，若个是愚公。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 307863,
      "title": "愚公谷三首 二",
      "content": [
        "吾家愚谷里，此谷本来平。",
        "虽则行无迹，还能响应声。",
        "不随云色暗，只待日光明。",
        "缘底名愚谷，都由愚所成。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 307864,
      "title": "愚公谷三首 三",
      "content": [
        "借问愚公谷，与君聊一寻。",
        "不寻翻到谷，此谷不离心。",
        "行处曾无险，看时岂有深。",
        "寄言尘世客，何处欲归临。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 307865,
      "title": "酬慕容十一",
      "content": [
        "行行西陌返，驻幰问车公。",
        "挟毂双官骑，应门五尺僮。",
        "老年如塞北，强起离墙东。",
        "为报壶丘子，来人道姓蒙。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 307866,
      "title": "过始皇墓",
      "content": [
        "古墓成苍岭，幽宫象紫台。",
        "星辰七曜隔，河汉九泉开。",
        "有海人宁渡，无春雁不廻。",
        "更闻松韵切，疑是大夫哀。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 307867,
      "title": "恭懿太子挽歌五首 一",
      "content": [
        "何悟藏环早，才知拜璧年。",
        "翀天王子去，对日圣君怜。",
        "树转宫犹出，笳悲马不前。",
        "虽蒙绝驰道，京兆别开阡。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 307868,
      "title": "恭懿太子挽歌五首 二",
      "content": [
        "兰殿新恩切，椒宫夕临幽。",
        "白云随凤管，明月在龙楼。",
        "人向青山哭，天临渭水愁。",
        "鸡鸣常问膳，今恨玉京留。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 307869,
      "title": "恭懿太子挽歌五首 三",
      "content": [
        "骑吹凌霜发，旌旗夹路陈。",
        "凯容金节护，册命玉符新。",
        "傅母悲香褓，君家拥画轮。",
        "射熊今梦帝，秤象问何人。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 307870,
      "title": "恭懿太子挽歌五首 四",
      "content": [
        "苍舒留帝宠，子晋有仙才。",
        "五岁过人智，三天使鹤催。",
        "心悲阳禄馆，目断望思台。",
        "若道长安近，何为更不来。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 307871,
      "title": "恭懿太子挽歌五首 五",
      "content": [
        "西望昆池阔，东瞻下杜平。",
        "山朝豫章馆，树转凤凰城。",
        "五校连旗色，千门叠鼓声。",
        "金环如有验，还向画堂生。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 307872,
      "title": "故太子太师徐公挽歌四首 一",
      "content": [
        "功德冠群英，弥纶有大名。",
        "轩皇用风后，傅说是星精。",
        "就第优遗老，来朝诏不名。",
        "留侯常辟谷，何苦不长生。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 307873,
      "title": "故太子太师徐公挽歌四首 二",
      "content": [
        "谋猷为相国，翊戴奉宸舆。",
        "劒履升前殿，貂蝉托后车。",
        "齐侯疏土宇，汉室赖图书。",
        "僻处留田宅，仍才十顷余。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 307874,
      "title": "故太子太师徐公挽歌四首 三",
      "content": [
        "旧里趋庭日，新年置酒辰。",
        "闻诗鸾渚客，献赋凤楼人。",
        "北首辞明主，东堂哭大臣。",
        "犹思御朱辂，不惜[污]车茵。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 307875,
      "title": "故太子太师徐公挽歌四首 四",
      "content": [
        "久践中台座，终登上将坛。",
        "谁言断车骑，空忆盛衣冠。",
        "风日咸阳惨，笳箫渭水寒。",
        "无人当便阙，应罢太师官。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 307876,
      "title": "故西河郡杜太守挽歌三首 一",
      "content": [
        "天上去西征，云中护北平。",
        "生擒白马将，连破黑雕城。",
        "忽见刍灵苦，徒闻竹使荣。",
        "空留左氏传，谁继卜商名。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 307877,
      "title": "故西河郡杜太守挽歌三首 二",
      "content": [
        "返葬金符守，同归石窌妻。",
        "卷衣悲画翟，持翣待鸣鸡。",
        "容衞都人惨，山川驷马嘶。",
        "犹闻陇上客，相对哭征西。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 307878,
      "title": "故西河郡杜太守挽歌三首 三",
      "content": [
        "涂刍去国门，秘器出东园。",
        "太守留金印，夫人罢锦轩。",
        "旌旗转衰木，箫鼓上寒原。",
        "坟树应西靡，长思魏阙恩。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 307879,
      "title": "故南阳夫人樊氏挽歌",
      "content": [
        "锦衣余翟茀，绣毂罢鱼轩。",
        "淑女诗长在，夫人法尚存。",
        "凝笳随晓斾，行哭向秋原。",
        "归去将何见，谁能返戟门。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 307880,
      "title": "达奚侍郎夫人寇氏挽词二首 一",
      "content": [
        "束带将朝日，鸣环映牖辰。",
        "能令谏明主，相劝识贤人。",
        "遗挂空留壁，廻文日覆尘。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 307881,
      "title": "达奚侍郎夫人寇氏挽词二首 二",
      "content": [
        "女史悲彤管，夫人罢锦轩。",
        "卜茔占二室，行哭度千门。",
        "秋日光能淡，寒川波自翻。",
        "一朝成万古，松柏暗平原。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 307882,
      "title": "送孙秀才",
      "content": [
        "帝城风日好，况复建平家。",
        "玉枕双文簟，金盘五色瓜。",
        "山中无鲁酒，松下饭胡麻。",
        "莫厌田家苦，归期远复赊。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 307883,
      "title": "奉和圣制庆玄元皇帝玉像之作应制",
      "content": [
        "明君梦帝先，宝命上齐天。",
        "秦后徒闻乐，周王耻卜年。",
        "玉京移大像，金箓会群仙。",
        "承露调天供，临空敞御筵。",
        "斗廻迎寿酒，山近起𬬻烟。",
        "愿奉无为化，斋心学自然。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 307884,
      "title": "奉和圣制与太子诸王三月三日龙池春禊应制",
      "content": [
        "故事修春禊，新宫展豫游。",
        "明君移凤辇，太子出龙楼。",
        "赋掩陈王作，桮如洛水流。",
        "金人来捧劒，画鹢去回舟。",
        "苑树浮宫阙，天池照冕旒。",
        "宸章在云表，垂象满皇州。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 307885,
      "title": "奉和圣制上巳于望春亭观禊饮应制",
      "content": [
        "长乐青门外，宜春小苑东。",
        "楼开万井上，辇过百花中。",
        "画鹢移仙妓，金貂列上公。",
        "清歌邀落日，妙舞向春风。",
        "渭水明秦甸，黄山入汉宫。",
        "君王来祓禊，灞浐亦朝宗。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 307886,
      "title": "奉和圣制暮春送朝集使归郡应制",
      "content": [
        "万国仰宗周，衣冠拜冕旒。",
        "玉乘迎大客，金节送诸侯。",
        "祖席倾三省，褰帷向九州。",
        "杨花飞上路，槐色荫通沟。",
        "来预钧天乐，归分汉主忧。",
        "宸章类河汉，垂象满中州。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 307887,
      "title": "三月三日曲江侍宴应制",
      "content": [
        "万乘亲斋祭，千官喜豫游。",
        "奉迎从上苑，祓禊向中流。",
        "草树连容衞，山河对冕旒。",
        "画旗摇浦溆，春服满汀洲。",
        "仙籞龙媒下，神臯凤跸留。",
        "从今亿万岁，天宝纪春秋。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 307888,
      "title": "奉和圣制重阳节宰臣及群官上寿应制",
      "content": [
        "四海方无事，三秋大有年。",
        "百生无此日，万寿愿齐天。",
        "芍药和金鼎，茱萸插玳筵。",
        "玉堂开右个，天乐动宫悬。",
        "御柳疎秋景，城鸦拂曙烟。",
        "无穷菊花节，长奉柏梁篇。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 307889,
      "title": "三月三日勤政楼侍宴应制",
      "content": [
        "彩仗连宵合，琼楼拂曙通。",
        "年光三月里，宫殿百花中。",
        "不数秦王日，谁将洛水同。",
        "酒筵嫌落絮，舞袖怯春风。",
        "天保无为德，人欢不战功。",
        "仍临九衢宴，更达四门聪。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 307890,
      "title": "奉和圣制十五夜然灯继以酺宴应制",
      "content": [
        "上路笙歌满，春城漏刻长。",
        "游人多昼日，明月让灯光。",
        "鱼钥通翔凤，龙舆出建章。",
        "九衢陈广乐，百福透名香。",
        "仙伎来金殿，都人遶玉堂。",
        "定应偷妙舞，从此学新妆。",
        "奉引迎三事，司仪列万方。",
        "愿将天地寿，同以献君王。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 307891,
      "title": "奉和圣制幸玉真公主山庄因题石壁十韵之作应制",
      "content": [
        "碧落风烟外，瑶台道路赊。",
        "如何连帝苑，别自有仙家。",
        "此地回鸾驾，缘谿转翠华。",
        "洞中开日月，窗里发云霞。",
        "庭养冲天鹤，溪流上汉查。",
        "种田生白玉，泥灶化丹砂。",
        "谷静泉逾响，山深日易斜。",
        "御羹和石髓，香饭进胡麻。",
        "大道今无外，长生讵有涯。",
        "还瞻九霄上，来往五云车。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 307892,
      "title": "春日直门下省早朝",
      "content": [
        "骑省直明光，鸡鸣谒建章。",
        "遥闻侍中珮，暗识令君香。",
        "玉漏随铜史，天书拜夕郎。",
        "旌旗暎阊阖，歌吹满昭阳。",
        "官舍梅初紫，宫门柳欲黄。",
        "愿将迟日意，同与圣恩长。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 307893,
      "title": "和仆射晋公扈从温汤",
      "content": [
        "天子幸新丰，旌旗渭水东。",
        "寒山天仗外，温谷幔城中。",
        "奠玉群仙座，焚香太乙宫。",
        "出游逢牧马，罢猎见非熊。",
        "上宰无为化，明时太古同。",
        "灵芝三秀紫，陈粟万箱红。",
        "王礼奠儒教，天兵小战功。",
        "谋犹归哲匠，词赋属文宗。",
        "司谏方无阙，陈诗且未工。",
        "长吟吉甫颂，朝夕仰清风。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 307894,
      "title": "和宋中丞夏日游福贤观天长寺寺即陈左相宅所施之作",
      "content": [
        "已相殷王国，空余尚父谿。",
        "钓矶开月殿，筑道出云梯。",
        "积水浮香象，深山鸣白鸡。",
        "虚空陈伎乐，衣服制虹霓。",
        "墨点三千界，丹飞六一泥。",
        "桃源勿遽返，再访恐君迷。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 307895,
      "title": "和陈监四郎秋雨中思从弟据",
      "content": [
        "袅袅秋风动，凄凄烟雨繁。",
        "声连𫛛鹊观，色暗凤凰原。",
        "细柳疎高阁，轻槐落洞门。",
        "九衢行欲断，万井寂无喧。",
        "忽有愁霖唱，更陈多露言。",
        "平原思令弟，康乐谢贤昆。",
        "逸兴方三接，衰颜强七奔。",
        "相如今老病，归守茂陵园。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 307896,
      "title": "上张令公",
      "content": [
        "珥笔趋丹陛，垂珰上玉除。",
        "步檐青琐闼，方幰画轮车。",
        "市阅千金字，朝闻五色书。",
        "致君光帝典，荐士满公车。",
        "伏奏回金驾，横经重石渠。",
        "从兹罢角觝，且复幸储胥。",
        "天统知尧后，王章笑鲁初。",
        "匈奴遥俯伏，汉相俨簪裾。",
        "贾生非不遇，汲黯自堪疎。",
        "学易思求我，言诗或起予。",
        "当从大夫后，何惜隶人余。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 307897,
      "title": "赠焦道士",
      "content": [
        "海上游三岛，淮南预八公。",
        "坐知千里外，跳向一壶中。",
        "缩地朝珠阙，行天使玉童。",
        "饮人聊割酒，送客乍分风。",
        "天老能行气，吾师不养空。",
        "谢君徒雀跃，无可问鸿蒙。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 307898,
      "title": "赠东岳焦炼师",
      "content": [
        "先生千岁余，五岳遍曾居。",
        "遥识齐侯鼎，新过王母庐。",
        "不能师孔墨，何事问长沮。",
        "玉管时来凤，铜盘即钓鱼。",
        "竦身空里语，明目夜中书。",
        "自有还丹术，时论太素初。",
        "频蒙露版诏，时降软轮车。",
        "山静泉逾响，松高枝转疎。",
        "搘颐问樵客，世上复何如。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 307899,
      "title": "送秘书晁监还日本国",
      "content": [
        "积水不可极，安知沧海东。",
        "九州何处远，万里若乘空。",
        "向国唯看日，归帆但信风。",
        "鳌身暎天黑，鱼眼射波红。",
        "乡树扶桑外，主人孤岛中。",
        "别离方异域，音信若为通。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 307900,
      "title": "送祢郎中",
      "content": [
        "东郊春草色，驱马去悠悠。",
        "况复乡山外，猿啼湘水流。",
        "岛夷传露版，江馆候鸣驺。",
        "卉服为诸吏，珠官拜本州。",
        "孤鸎吟远墅，野杏发山邮。",
        "早晚方归奏，南中才忌秋。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 307901,
      "title": "送李太守赴上洛",
      "content": [
        "商山包楚邓，积翠蔼沈沈。",
        "驿路飞泉洒，关门落照深。",
        "野花开古戍，行客响空林。",
        "板屋春多雨，山城昼欲阴。",
        "丹泉通虢略，白羽抵荆岑。",
        "若见西山爽，应知黄绮心。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 307902,
      "title": "送熊九赴任安阳",
      "content": [
        "魏国应刘后，寂寥文雅空。",
        "漳河如旧日，之子继清风。",
        "阡陌铜台下，闾阎金虎中。",
        "送车盈灞上，轻骑出关东。",
        "相去千余里，西园明月同。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 307903,
      "title": "山中示弟",
      "content": [
        "山林吾丧我，冠带尔成人。",
        "莫学嵇康懒，且安原宪贫。",
        "山阴多北户，泉水在东邻。",
        "缘合妄相有，性空无所亲。",
        "安知广成子，不是老夫身。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 307904,
      "title": "青龙寺昙璧上人兄院集",
      "content": [
        "高处敞招提，虚空讵有倪。",
        "坐看南陌骑，下听秦城鸡。",
        "眇眇孤烟起，芊芊远树齐。",
        "青山万井外，落日五陵西。",
        "眼界今无染，心空安可迷。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 307905,
      "title": "济州过赵叟家宴",
      "content": [
        "虽与人境接，闭门成隐居。",
        "道言庄叟事，儒行鲁人余。",
        "深巷斜晖静，闲门高柳疎。",
        "荷锄修药圃，散帙曝农书。",
        "上客摇芳翰，中厨馈野蔬。",
        "夫君第高饮，景晏出林闾。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 307906,
      "title": "春过贺遂员外药园",
      "content": [
        "前年槿篱故，新作药栏成。",
        "香草为君子，名花是长卿。",
        "水穿盘石透，藤系古松生。",
        "画畏开厨走，来蒙到屣迎。",
        "蔗浆菰米饭，蒟酱露葵羹。",
        "颇识灌园意，于陵不自轻。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 307907,
      "title": "过卢四员外宅看饭僧共题七韵",
      "content": [
        "三贤异七贤，青眼慕青莲。",
        "乞饭从香积，裁衣学水田。",
        "上人飞锡杖，檀越施金钱。",
        "趺作檐前日，焚香竹下烟。",
        "寒空法云地，秋色净居天。",
        "身逐因缘法，心过次第禅。",
        "不须愁日暮，自有一灯然。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 307908,
      "title": "河南严尹弟见宿弊庐访别人赋十韵",
      "content": [
        "上客能论道，吾生学养蒙。",
        "贫交世情外，才子古人中。",
        "冠上方簪豸，车边已画熊。",
        "拂衣迎五马，垂手凭双童。",
        "花醥和松屑，茶香透竹丛。",
        "薄霜澄夜月，残雪带春风。",
        "古壁苍苔黑，寒山远烧红。",
        "眼看东候别，心事北川同。",
        "为学轻先辈，何能访老翁。",
        "欲知今日后，不乐为车公。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 307909,
      "title": "投道一师兰若宿",
      "content": [
        "一公栖太白，高顶出风烟。",
        "梵流诸壑遍，花雨一峰偏。",
        "迹为无心隐，名因立教传。",
        "鸟来还语法，客去更安禅。",
        "昼涉松路尽，暮投兰若边。",
        "洞房隐深竹，清夜闻遥泉。",
        "向是云霞里，今成枕席前。",
        "岂唯暂留宿，服事将穷年。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 307910,
      "title": "游感化寺",
      "content": [
        "翡翠香烟合，琉璃宝地平。",
        "龙宫连栋宇，虎穴傍檐楹。",
        "谷静唯松响，山深无鸟声。",
        "琼峰当户拆，金涧透林明。",
        "郢路云端逈，秦川雨外晴。",
        "鴈王衔果献，鹿女踏花行。",
        "抖擞辞贫里，归依宿化城。",
        "绕篱生野蕨，空馆发山樱。",
        "香饭青菰米，嘉蔬绿笋茎。",
        "誓陪清梵末，端坐学无生。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 307911,
      "title": "游悟真寺",
      "content": [
        "闻道黄金地，仍开白玉田。",
        "掷山移巨石，呪岭出飞泉。",
        "猛虎同三迳，愁猿学四禅。",
        "买香然绿桂，乞火踏红莲。",
        "草色摇霞上，松声泛月边。",
        "山河穷百二，世界接三千。",
        "梵宇聊凭视，王城遂渺然。",
        "灞陵才出树，渭水欲连天。",
        "远县分诸郭，孤村起白烟。",
        "望云思圣主，披雾隐群贤。",
        "薄宦惭尸素，终身拟尚玄。",
        "谁知草庵客，曾和柏梁篇。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 307912,
      "title": "与苏卢二员外期游方丈寺而苏不至因有是作",
      "content": [
        "共仰头陀行，能忘世谛情。",
        "回看双凤阙，相去一牛鸣。",
        "法向空林说，心随宝地平。",
        "手巾花氎净，香帔稻畦成。",
        "闻道邀同舍，相期宿化城。",
        "安知不来往，翻得似无生。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 307913,
      "title": "晓行巴峡",
      "content": [
        "际晓投巴峡，余春忆帝京。",
        "晴江一女浣，朝日众鸡鸣。",
        "水国舟中市，山桥树杪行。",
        "登高万井出，眺迥二流明。",
        "人作殊方语，鸎为故国声。",
        "赖多山水趣，稍解别离情。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 307914,
      "title": "清如玉壶冰",
      "content": [
        "玉壶何用好，偏许素冰居。",
        "未共销丹日，还同照绮疏。",
        "抱明中不隐，含净外疑虚。",
        "气似庭霜积，光言砌月余。",
        "晓凌飞鹊镜，宵暎聚萤书。",
        "若向夫君比，清心尚不如。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 307915,
      "title": "赋得秋日悬清光",
      "content": [
        "寥廓凉天静，晶明白日秋。",
        "圆光含万象，碎影入闲流。",
        "迥与青冥合，遥同江甸浮。",
        "昼阴殊众木，斜影下危楼。",
        "宋玉登高怨，张衡望远愁。",
        "余辉如可托，云路岂悠悠。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 307916,
      "title": "东谿玩月",
      "content": [
        "月从断山口，遥吐柴门端。",
        "万木分空霁，流阴中夜攒。",
        "光连虚象白，气与风露寒。",
        "谷静秋泉响，岩深青霭残。",
        "清灯入幽梦，破影抱空峦。",
        "恍惚琴窗里，松谿晓思难。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 307917,
      "title": "田家",
      "content": [
        "旧谷行将尽，良苗未可希。",
        "老年方爱粥，卒岁且无衣。",
        "雀乳青苔井，鸡鸣白板扉。",
        "柴车驾羸牸，草𪨗牧豪狶。",
        "夕雨红榴拆，新秋绿芋肥。",
        "饷田桑下憩，旁舍草中归。",
        "住处名愚谷，何烦问是非。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 307918,
      "title": "沈十四拾遗新竹生读经处同诸公之作",
      "content": [
        "闲居日清静，修竹自檀栾。",
        "嫩节留余箨，新丛出旧阑。",
        "细枝风响乱，疎影月光寒。",
        "乐府裁龙笛，渔家伐钓竿。",
        "何如道门里，青翠拂仙坛。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 307919,
      "title": "杂诗",
      "content": [
        "朝因折杨柳，相见洛阳隅。",
        "楚国无如妾，秦家自有夫。",
        "对人传玉腕，暎烛解罗襦。",
        "人见东方骑，皆言夫壻殊。",
        "持谢金吾子，烦君提玉壶。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 307920,
      "title": "哭褚司马",
      "content": [
        "妄识皆心累，浮生定死媒。",
        "谁言老龙吉，未免伯牛灾。",
        "故有求仙药，仍余遯俗杯。",
        "山川秋树苦，窗户夜泉哀。",
        "尚忆青骡去，宁知白马来。",
        "汉臣修史记，莫蔽褚生才。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 307921,
      "title": "过沈居士山居哭之",
      "content": [
        "杨朱来此哭，桑扈返于真。",
        "独自成千古，依然旧四邻。",
        "闲簷喧鸟鹊，故榻满埃尘。",
        "曙月孤莺啭，空山五柳春。",
        "野花愁对客，泉水咽迎人。",
        "善卷明时隐，黔娄在日贫。",
        "逝川嗟尔命，丘井叹吾身。",
        "前后徒言隔，相悲讵几晨。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 307922,
      "title": "哭祖六自虚",
      "content": [
        "否极尝闻泰，嗟君独不然。",
        "悯凶才稚齿，羸疾主中年。",
        "余力文章秀，生知礼乐全。",
        "翰留天帐览，词入帝宫传。",
        "国讶终军少，人知贾谊贤。",
        "公卿尽虚左，朋识共推先。",
        "不恨依穷辙，终期济巨川。",
        "才雄望羔雁，寿促背貂蝉。",
        "福善闻前录，歼良昧上玄。",
        "何辜铩鸾翮，底事碎龙泉。",
        "𫛳起长沙赋，麟终曲阜编。",
        "域中君道广，海内我情偏。",
        "乍失疑犹见，沈思悟绝缘。",
        "生前不忍别，死后向谁宣。",
        "为此情难尽，弥令忆更缠。",
        "本家清渭曲，归葬旧茔边。",
        "永去长安道，徒闻京兆阡。",
        "旌车出郊甸，乡国隐云天。",
        "定作无期别，宁同旧日旋。",
        "候门家属苦，行路国人怜。",
        "送客哀难进，征途泥复前。",
        "赠言为挽曲，奠席是离筵。",
        "念昔同携手，风期不暂捐。",
        "南山俱隐逸，东洛类神仙。",
        "未省音容间，那堪生死迁。",
        "花时金谷饮，月夜竹林眠。",
        "满地传都赋，倾朝看药船。",
        "群公咸属目，微物敢齐肩。",
        "谬合同人旨，而将玉树连。",
        "不期先挂劒，长恐后施鞭。",
        "为善吾无矣，知音子绝焉。",
        "琴声纵不没，终亦继悲弦。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
