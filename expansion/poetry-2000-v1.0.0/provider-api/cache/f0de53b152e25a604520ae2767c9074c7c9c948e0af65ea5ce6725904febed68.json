{
  "data": [
    {
      "id": 378015,
      "title": "南乡子·南乡子·袖敛鲛绡",
      "content": [
        "袖敛鲛绡，采香深洞笑相邀。",
        "藤杖枝头芦酒滴，铺葵席，豆蔻花间趖晚日。"
      ],
      "author": {
        "id": 7856,
        "name": "欧阳炯"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378016,
      "title": "南乡子·南乡子·翡翠䴔䴖",
      "content": [
        "翡翠䴔䴖，白萍香里小沙汀。",
        "岛上阴阴秋雨色，芦花扑，数只渔船何处宿。"
      ],
      "author": {
        "id": 7856,
        "name": "欧阳炯"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378017,
      "title": "献衷心·献衷心·见好花颜色",
      "content": [
        "见好花颜色，争笑东风。",
        "双脸上，晚妆同。",
        "闭小楼深阁，春景重重。",
        "三五夜，偏有恨，月明中。",
        "情未已，信曾通，满衣犹自染檀红。",
        "恨不如双燕，飞舞帘栊。",
        "春欲暮，残絮尽，柳条空。"
      ],
      "author": {
        "id": 7856,
        "name": "欧阳炯"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378018,
      "title": "贺明朝·贺明朝·忆昔花间初识面",
      "content": [
        "忆昔花间初识面，红袖半遮妆脸。",
        "轻转石榴裙带，故将纤纤玉指，愉捻双凤金线。",
        "碧梧桐锁深深院，谁料得，两情何日教缱绻。",
        "羡春来双燕，飞到玉楼，朝暮相见。"
      ],
      "author": {
        "id": 7856,
        "name": "欧阳炯"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378019,
      "title": "贺明朝·贺明朝·忆昔花间相见后",
      "content": [
        "忆昔花间相见后，只凭纤手，暗抛红豆。",
        "人前不解，巧传心事。",
        "别来依旧，辜负春昼。",
        "碧罗衣上蹙金绣，睹对对鸳鸯，空裛泪痕透。",
        "想韶颜非久，终是为伊，只恁偷瘦。"
      ],
      "author": {
        "id": 7856,
        "name": "欧阳炯"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378020,
      "title": "江城子·江城子·晚日金陵岸草平",
      "content": [
        "晚日金陵岸草平，落霞明，水无情，六代繁华，暗逐逝波声。",
        "空有姑苏台上月，如西子镜照江城。"
      ],
      "author": {
        "id": 7856,
        "name": "欧阳炯"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378021,
      "title": "凤楼春·凤楼春·凤髻绿云丛",
      "content": [
        "凤髻绿云丛，深掩房栊。",
        "锦书通，梦中相见觉来慵，匀面泪脸珠融。",
        "因想玉郎何处去，对淑景谁同。",
        "小楼中，春思无穷。",
        "倚栏颙望，暗牵愁绪，柳花飞起东风。",
        "斜日照帘，罗幌香冷粉屏空。",
        "海棠零落，莺语残红。"
      ],
      "author": {
        "id": 7856,
        "name": "欧阳炯"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378022,
      "title": "小重山·小重山·春入神京万木芳",
      "content": [
        "春入神京万木芳，禁林莺语滑，蝶飞狂。",
        "晓花擎露妨啼妆，红日水，风和百花香。",
        "烟锁柳丝长，御沟澄碧水，转池塘。",
        "时时微雨洗劫风光，天衢远，到处引笙簧。"
      ],
      "author": {
        "id": 7016,
        "name": "和凝"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378023,
      "title": "小重山·小重山·正是神京烂熳时",
      "content": [
        "正是神京烂熳时，群仙初折得，郄诜枝。",
        "乌犀白纻最相宜，精神出，御陌袖鞭垂。",
        "柳色展愁眉，管弦分响亮，探花期。",
        "光阴占断曲江池，新榜上，名姓彻丹墀。"
      ],
      "author": {
        "id": 7016,
        "name": "和凝"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378024,
      "title": "临江仙·临江仙·海棠香老春江晚",
      "content": [
        "海棠香老春江晚，小楼雾縠涳蒙。",
        "翠鬟初出绣帘中，麝烟鸾鬟苹风。",
        "碾玉钗摇㶉𫛶战，雪肌云鬓将融。",
        "含情遥指碧波东，越王台殿蓼花红。"
      ],
      "author": {
        "id": 7016,
        "name": "和凝"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378025,
      "title": "临江仙·临江仙·披袍窣地红宫锦",
      "content": [
        "披袍窣地红宫锦，莺语时啭轻音。",
        "碧罗冠子稳犀簪，凤凰双飐步摇金。",
        "肌骨细匀红玉软，脸波微送春心。",
        "娇羞不肯入鸳衾，兰膏光里两情深。"
      ],
      "author": {
        "id": 7016,
        "name": "和凝"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378026,
      "title": "菩萨蛮·菩萨蛮·越梅半坼轻寒里",
      "content": [
        "越梅半坼轻寒里，冰清淡薄笼蓝水。",
        "暖觉杏梢红，游丝狂惹风。",
        "闲阶莎径碧，远梦犹堪惜。",
        "离恨又迎春，相思难重陈。"
      ],
      "author": {
        "id": 7016,
        "name": "和凝"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378027,
      "title": "山花子·山花子·莺锦蝉縠馥麝脐",
      "content": [
        "莺锦蝉縠馥麝脐，轻裾花早晓烟迷。",
        "㶉𫛶战金红掌坠，翠云低。",
        "星靥笑偎霞脸畔，蹙金开襜衬银泥。",
        "春思半和芳草嫩，碧萋萋。"
      ],
      "author": {
        "id": 7016,
        "name": "和凝"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378028,
      "title": "山花子·山花子·银字笙寒调正长",
      "content": [
        "银字笙寒调正长，水纹簟冷画屏凉。",
        "玉腕重金扼臂，淡梳妆。",
        "几度试香纤手暖，一回尝酒绛唇光。",
        "佯弄红丝蝇拂子，打檀郎。"
      ],
      "author": {
        "id": 7016,
        "name": "和凝"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378029,
      "title": "河满子·河满子·正是破瓜年几",
      "content": [
        "正是破瓜年几，含情惯得人饶。",
        "桃李精神鹦鹉舌，可堪虚度良宵。",
        "却爱蓝罗裙子，羡他长束纤腰。"
      ],
      "author": {
        "id": 7016,
        "name": "和凝"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378030,
      "title": "河满子·河满子·写得鱼笺无限",
      "content": [
        "写得鱼笺无限，其如花锁春晖。",
        "目断巫山云雨，空教残梦依依。",
        "却爱熏香小鸭，羡他长在屏帷。"
      ],
      "author": {
        "id": 7016,
        "name": "和凝"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378031,
      "title": "薄命女·薄命女·天欲晓",
      "content": [
        "天欲晓，宫漏穿花声缭绕。",
        "窗里星光少，冷霞寒侵帐额，残月光沉树杪。",
        "梦断锦帷空悄悄，强起愁眉小。"
      ],
      "author": {
        "id": 7016,
        "name": "和凝"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378032,
      "title": "望梅花·望梅花·春草全无消息",
      "content": [
        "春草全无消息，腊雪犹余踪迹。",
        "越岭寒枝香自坼，冷艳奇芳堪惜。",
        "何事寿阳无处觅，吹入谁家横笛。"
      ],
      "author": {
        "id": 7016,
        "name": "和凝"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378033,
      "title": "天仙子·天仙子·柳色披衫金缕凤",
      "content": [
        "柳色披衫金缕凤，纤手轻拈红豆弄，翠蛾双敛正含情。",
        "桃花洞，瑶台梦，一片春愁谁与共。"
      ],
      "author": {
        "id": 7016,
        "name": "和凝"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378034,
      "title": "天仙子·天仙子·洞口春红飞蔌蔌",
      "content": [
        "洞口春红飞蔌蔌，仙子含愁眉黛绿。",
        "阮郎何事不归来，懒烧金，慵篆玉。",
        "流水桃花空断续。"
      ],
      "author": {
        "id": 7016,
        "name": "和凝"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378035,
      "title": "春光好·春光好·纱窗暖",
      "content": [
        "纱窗暖，画屏间，亸云鬟。",
        "睡起四肢无力，半春闲。",
        "玉指剪裁罗胜，金盘点缀酥山。",
        "窥宋深心无限事，小眉弯。"
      ],
      "author": {
        "id": 7016,
        "name": "和凝"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378036,
      "title": "春光好·春光好·苹叶软",
      "content": [
        "苹叶软，杏花明，画船轻。",
        "双浴鸳鸯出绿汀，棹歌声。",
        "春水无风无浪，春天半雨半晴。",
        "红粉相随南浦晚，几含情。"
      ],
      "author": {
        "id": 7016,
        "name": "和凝"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378037,
      "title": "采桑子·采桑子·蝤蛴领上诃梨子",
      "content": [
        "蝤蛴领上诃梨子，绣带双垂，椒户闲时，竞学樗蒲赌荔枝。",
        "丛头鞋子红编细，裙窣金丝。",
        "无事颦眉，春思翻教阿母疑。"
      ],
      "author": {
        "id": 7016,
        "name": "和凝"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378038,
      "title": "柳枝·柳枝·软碧瑶烟似送人",
      "content": [
        "软碧瑶烟似送人，映花时把翠蛾颦。",
        "青青自是风流主，慢飐金丝待洛神。"
      ],
      "author": {
        "id": 7016,
        "name": "和凝"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378039,
      "title": "柳枝·柳枝·瑟瑟罗裙金缕腰",
      "content": [
        "瑟瑟罗裙金缕腰，黛眉偎破未重描。",
        "醉来咬损新花子，拽住仙郎尽放娇。"
      ],
      "author": {
        "id": 7016,
        "name": "和凝"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378040,
      "title": "柳枝·柳枝·雀桥初就咽银河",
      "content": [
        "雀桥初就咽银河，今夜仙郎自姓和。",
        "不是昔年攀桂树，岂能月里索嫦娥。"
      ],
      "author": {
        "id": 7016,
        "name": "和凝"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378041,
      "title": "渔父·渔父·白芷汀寒立鹭鸶",
      "content": [
        "白芷汀寒立鹭鸶，苹风轻剪浪花时。",
        "烟幂幂，日迟迟。",
        "香引芙蓉惹钓丝。"
      ],
      "author": {
        "id": 7016,
        "name": "和凝"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378042,
      "title": "虞美人·虞美人·晓莺啼破相思梦",
      "content": [
        "晓莺啼破相思梦，帘看金泥凤。",
        "宿妆犹在酒初醒，翠翘慵整倚云屏，转娉婷。",
        "香檀细画侵桃脸，罗袂轻轻敛。",
        "佳期堪恨再难寻，绿芜满院柳成阴，负春心。"
      ],
      "author": {
        "id": 12325,
        "name": "顾敻"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378043,
      "title": "虞美人·虞美人·触帘风送景阳钟",
      "content": [
        "触帘风送景阳钟，鸳被绣花重。",
        "晓帷初卷冷烟浓，翠匀粉黛好仪容，思娇慵。",
        "起来无语理朝妆，宝匣镜凝光。",
        "绿荷相倚满池塘，露清枕簟藕花香，恨悠扬。"
      ],
      "author": {
        "id": 12325,
        "name": "顾敻"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378044,
      "title": "虞美人·虞美人·翠屏闲掩垂珠箔",
      "content": [
        "翠屏闲掩垂珠箔，丝雨笼池阁。",
        "露沾红藕咽清香，谢娘娇极不成狂，罢朝妆。",
        "小金㶉𫛶沉烟细，腻枕堆云髻。",
        "浅眉微敛注檀轻，旧欢时有梦魂惊，悔多情。"
      ],
      "author": {
        "id": 12325,
        "name": "顾敻"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378045,
      "title": "虞美人·虞美人·碧梧桐映纱窗晚",
      "content": [
        "碧梧桐映纱窗晚，花谢莺声懒。",
        "小屏屈曲掩青山，翠帷香粉玉炉寒，两蛾攒。",
        "颠狂少年轻离别，辜负春时节。",
        "画罗红袂有啼痕，魂消无语倚闺门，欲黄昏。"
      ],
      "author": {
        "id": 12325,
        "name": "顾敻"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378046,
      "title": "虞美人·虞美人·深闺春色劳思想",
      "content": [
        "深闺春色劳思想，恨共春芜长。",
        "黄鹂娇啭泥芳妍，杏枝如画倚轻烟，琐窗前。",
        "凭栏愁立双蛾细，柳影斜摇砌。",
        "玉郎还是不还家，教人魂梦逐杨花，绕天涯。"
      ],
      "author": {
        "id": 12325,
        "name": "顾敻"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378047,
      "title": "虞美人·虞美人·少年艳质胜琼英",
      "content": [
        "少年艳质胜琼英，早晚别三清。",
        "莲冠稳簪钿篦横，飘飘罗袖碧云轻，画难成。",
        "迟迟少转腰身袅，翠靥眉心小。",
        "醮坛风急杏花香。",
        "此时恨不驾鸾凤，访刘郎。"
      ],
      "author": {
        "id": 12325,
        "name": "顾敻"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378048,
      "title": "河传·河传·燕飏",
      "content": [
        "燕飏，晴景。",
        "小窗屏暖，鸳鸯交颈。",
        "菱花掩却翠鬓欹，慵整。",
        "海棠帘外影。",
        "绣帷香断金㶉𫛶，无消息，心事空相忆。",
        "倚东风，春正浓。",
        "愁红，泪痕衣上重。"
      ],
      "author": {
        "id": 12325,
        "name": "顾敻"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378049,
      "title": "河传·河传·曲槛",
      "content": [
        "曲槛，春晚。",
        "波光渺渺，不知何处。",
        "岸花汀草共依依，雨微，鹧鸪相逐飞。",
        "天涯离恨江声咽，啼猿切，此意向谁说。",
        "倚兰桡，独无聊。",
        "魂消，小炉香欲焦。"
      ],
      "author": {
        "id": 12325,
        "name": "顾敻"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378050,
      "title": "甘州子·甘州子·一炉龙麝锦帷旁",
      "content": [
        "一炉龙麝锦帷旁，屏掩映，烛荧煌。",
        "禁楼刁斗喜初长，罗荐绣鸳鸯。",
        "山枕上，私语口脂香。"
      ],
      "author": {
        "id": 12325,
        "name": "顾敻"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378051,
      "title": "甘州子·甘州子·每逢清夜与良晨",
      "content": [
        "每逢清夜与良晨，多怅望，足伤神。",
        "云迷水隔意中人，寂寞绣罗茵。",
        "山枕上，几点泪痕新。"
      ],
      "author": {
        "id": 12325,
        "name": "顾敻"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378052,
      "title": "甘州子·甘州子·曾如刘阮访仙踪",
      "content": [
        "曾如刘阮访仙踪，深洞客，此时逢。",
        "绮筵散后绣衾同，款曲见韶容。",
        "山枕上，长是怯晨钟。"
      ],
      "author": {
        "id": 12325,
        "name": "顾敻"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378053,
      "title": "甘州子·甘州子·露桃花里小楼深",
      "content": [
        "露桃花里小楼深，持玉盏，听瑶琴。",
        "醉归青琐入鸳衾，月色照衣襟。",
        "山枕上，翠钿镇眉心。"
      ],
      "author": {
        "id": 12325,
        "name": "顾敻"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378054,
      "title": "甘州子·甘州子·红炉深夜醉调笙",
      "content": [
        "红炉深夜醉调笙，敲拍处，玉纤轻。",
        "小屏古画岸低平，烟月满闲庭。",
        "山枕上，灯背脸波横。"
      ],
      "author": {
        "id": 12325,
        "name": "顾敻"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378055,
      "title": "玉楼春·玉楼春·月照玉楼春漏促",
      "content": [
        "月照玉楼春漏促，飒飒风摇庭砌竹。",
        "梦惊鸳被觉来时，何处管弦声断续。",
        "惆怅少年游冶去，枕上两蛾攒细绿。",
        "晓莺帘外语花枝，背帐犹残红蜡烛。"
      ],
      "author": {
        "id": 12325,
        "name": "顾敻"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378056,
      "title": "玉楼春·玉楼春·柳映玉楼春日晚",
      "content": [
        "柳映玉楼春日晚，雨细风轻烟草软。",
        "画堂鹦鹉语雕笼，金粉小屏犹半掩。",
        "香灭绣帷人寂寂，倚槛无言愁思远。",
        "恨郎何处纵疏狂，长使含啼眉不展。"
      ],
      "author": {
        "id": 12325,
        "name": "顾敻"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378057,
      "title": "玉楼春·玉楼春·月皎露华窗影细",
      "content": [
        "月皎露华窗影细，风送菊香沾绣袂。",
        "博山炉冷水沉微，惆怅金闺终日闭。",
        "懒展罗衾垂玉箸，羞对菱花簪宝髻。",
        "良宵好事枉教休，无计那他狂耍婿。"
      ],
      "author": {
        "id": 12325,
        "name": "顾敻"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378058,
      "title": "玉楼春·玉楼春·拂水双飞来去燕",
      "content": [
        "拂水双飞来去燕，曲槛小屏山六扇。",
        "春愁凝思结眉心，绿绮懒调红锦荐。",
        "话别情多声欲战，玉箸痕留红粉面。",
        "镇长独立到黄昏，却怕良宵频梦见。"
      ],
      "author": {
        "id": 12325,
        "name": "顾敻"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378059,
      "title": "浣溪沙·浣溪沙·春色迷人恨正赊",
      "content": [
        "春色迷人恨正赊，可堪荡子不还家，细风轻露着梨花。",
        "帘外有情双燕飏，槛前无力绿杨斜，小屏狂梦极天涯。"
      ],
      "author": {
        "id": 12325,
        "name": "顾敻"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378060,
      "title": "浣溪沙·浣溪沙·红藕香寒翠渚平",
      "content": [
        "红藕香寒翠渚平，月笼虚阁夜蛩清，塞鸿惊梦两牵情。",
        "宝帐玉炉，残麝冷，罗衣金缕暗尘生，小窗孤烛泪纵横。"
      ],
      "author": {
        "id": 12325,
        "name": "顾敻"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378061,
      "title": "浣溪沙·浣溪沙·荷芰风轻帘幕香",
      "content": [
        "荷芰风轻帘幕香，绣衣㶉𫛶泳回塘，小屏闲掩旧潇湘。",
        "恨入空帷鸾影独，泪凝双脸渚莲光，薄情年少悔思量。"
      ],
      "author": {
        "id": 12325,
        "name": "顾敻"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378062,
      "title": "浣溪沙·浣溪沙·惆怅经年别谢娘",
      "content": [
        "惆怅经年别谢娘，月窗花院好风光，此时相望最情伤。",
        "青鸟不来传锦字，瑶姬何处琐兰房，忍教魂梦两茫茫。"
      ],
      "author": {
        "id": 12325,
        "name": "顾敻"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378063,
      "title": "浣溪沙·浣溪沙·庭菊飘黄玉露浓",
      "content": [
        "庭菊飘黄玉露浓，冷莎偎砌隐鸣蛩，何期良夜得相逢。",
        "背帐风摇红蜡滴，惹香梦暖绣衾重，觉来枕上怯晨钟。"
      ],
      "author": {
        "id": 12325,
        "name": "顾敻"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378064,
      "title": "浣溪沙·浣溪沙·云峡风高叶乱飞",
      "content": [
        "云峡风高叶乱飞，小庭寒雨绿苔微，深闺人静掩屏帷。",
        "粉黛暗愁金带枕，鸳鸯空绕画罗衣，那堪辜负不思归。"
      ],
      "author": {
        "id": 12325,
        "name": "顾敻"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378065,
      "title": "浣溪沙·浣溪沙·雁响遥天玉漏清",
      "content": [
        "雁响遥天玉漏清，小纱窗外月胧明，翠帷金鸭炷香平。",
        "何处不归音信断，良宵空使攀魂惊，簟凉枕冷不胜情。"
      ],
      "author": {
        "id": 12325,
        "name": "顾敻"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378066,
      "title": "浣溪沙·浣溪沙·露白蟾明又到秋",
      "content": [
        "露白蟾明又到秋，佳期幽会两悠悠，梦牵情役几时休。",
        "记得泥人微敛黛，无言斜倚小书楼，暗思前事不胜愁。"
      ],
      "author": {
        "id": 12325,
        "name": "顾敻"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378067,
      "title": "酒泉子·酒泉子·杨柳舞风",
      "content": [
        "杨柳舞风，轻惹春烟残雨。",
        "杏花愁，莺正语，画楼东。",
        "锦屏寂寞思无穷，还是不知消息。",
        "镜尘生，珠泪滴，损仪容。"
      ],
      "author": {
        "id": 12325,
        "name": "顾敻"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378068,
      "title": "酒泉子·酒泉子·罗带缕金",
      "content": [
        "罗带缕金，兰麝烟凝魂断。",
        "画屏欹，云鬓乱，恨难任。",
        "几回垂泪滴鸳衾，薄情何处去。",
        "月临窗，花满树，信沉沉。"
      ],
      "author": {
        "id": 12325,
        "name": "顾敻"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378069,
      "title": "酒泉子·酒泉子·小槛日斜",
      "content": [
        "小槛日斜，风度绿窗人悄悄。",
        "翠帷闲掩舞双鸾，旧香寒。",
        "别来情绪转难拚，韶颜看却老。",
        "依稀粉上有啼痕，暗销魂。"
      ],
      "author": {
        "id": 12325,
        "name": "顾敻"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378070,
      "title": "酒泉子·酒泉子·黛薄红深",
      "content": [
        "黛薄红深，约掠绿鬟云腻。",
        "小鸳鸯，金翡翠，称人心。",
        "锦鳞无处传幽意，海燕兰堂春又去。",
        "隔年书，千点泪，恨难任。"
      ],
      "author": {
        "id": 12325,
        "name": "顾敻"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378071,
      "title": "酒泉子·酒泉子·掩却菱花",
      "content": [
        "掩却菱花，收拾翠钿休上面。",
        "金虫玉燕锁香奁，恨厌厌。",
        "云鬟半坠懒重簪，泪侵山枕湿。",
        "恨灯背帐梦方酣，雁飞南。"
      ],
      "author": {
        "id": 12325,
        "name": "顾敻"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378072,
      "title": "酒泉子·酒泉子·水碧风清",
      "content": [
        "水碧风清，入槛细香红藕腻。",
        "谢娘敛翠恨无涯，小屏斜。",
        "堪憎荡子不还家，漫留罗带结。",
        "帐深枕腻炷沉烟，负当年。"
      ],
      "author": {
        "id": 12325,
        "name": "顾敻"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378073,
      "title": "酒泉子·酒泉子·黛愁怨红羞",
      "content": [
        "黛愁怨红羞，掩映画堂春欲暮。",
        "残花微雨隔青楼，思悠悠。",
        "芳菲时节看将度，寂寞无人还独语。",
        "画罗襦，香粉污，不胜愁。"
      ],
      "author": {
        "id": 12325,
        "name": "顾敻"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378074,
      "title": "杨柳枝·杨柳枝·秋夜香闺思寂寞",
      "content": [
        "秋夜香闺思寂寞，漏迢迢。",
        "鸳帷罗幌麝烟销，烛光摇。",
        "正忆玉郎游荡去，无寻处。",
        "更闻帘外雨萧萧，滴芭蕉。"
      ],
      "author": {
        "id": 12325,
        "name": "顾敻"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378075,
      "title": "遐方怨·遐方怨·帘影细",
      "content": [
        "帘影细，簟纹平。",
        "象纱笼玉指，缕金罗扇轻。",
        "嫩双脸似花明，两条眉黛远山横。",
        "风箫歇，镜尘生。",
        "辽塞音书绝，梦魂长暗惊。",
        "玉郎经岁负娉婷，教人怎不恨无情。"
      ],
      "author": {
        "id": 12325,
        "name": "顾敻"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378076,
      "title": "献衷心·献衷心·绣鸳鸯帐暖",
      "content": [
        "绣鸳鸯帐暖，画孔雀欹。",
        "人悄悄，月明时，想昔年欢笑，恨今日分离。",
        "银背，铜漏永，阻佳期。",
        "小炉烟细，虚阁帘垂。",
        "几多心事，暗地思惟。",
        "被娇娥牵役，魂梦如痴。",
        "金闺里，山枕上，始应知。"
      ],
      "author": {
        "id": 12325,
        "name": "顾敻"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378077,
      "title": "应天长·应天长·瑟瑟罗裙金线缕",
      "content": [
        "瑟瑟罗裙金线缕，轻透鹅黄香画袴。",
        "垂交带，盘鹦鹉，袅袅翠翘移玉步。",
        "背人匀檀注，慢转横波偷觑。",
        "敛黛春情暗许，倚慵不语。"
      ],
      "author": {
        "id": 12325,
        "name": "顾敻"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378078,
      "title": "诉衷情·诉衷情·香灭帘垂春漏永",
      "content": [
        "香灭帘垂春漏永，整鸳衾。",
        "罗带重，双凤，缕黄金。",
        "窗外月光临，沉沉。",
        "断肠无处寻，负春心。"
      ],
      "author": {
        "id": 12325,
        "name": "顾敻"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378079,
      "title": "诉衷情·诉衷情·永夜抛人何处去",
      "content": [
        "永夜抛人何处去，绝来音。",
        "香阁掩，眉敛，月将沉。",
        "怎忍不相寻？",
        "鸳孤衾。",
        "换我心为你心，始知相忆深。"
      ],
      "author": {
        "id": 12325,
        "name": "顾敻"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378080,
      "title": "荷叶杯·荷叶杯·春尽小庭花落",
      "content": [
        "春尽小庭花落，寂寞。",
        "凭槛敛双眉，忍教成病忆佳期。",
        "知么知，知么知。"
      ],
      "author": {
        "id": 12325,
        "name": "顾敻"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378081,
      "title": "荷叶杯·荷叶杯·歌发谁家筵上",
      "content": [
        "歌发谁家筵上，寥亮。",
        "别恨正悠悠，兰釭背帐月当楼。",
        "愁么愁，愁么愁。"
      ],
      "author": {
        "id": 12325,
        "name": "顾敻"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378082,
      "title": "荷叶杯·荷叶杯·弱柳好花尽坼",
      "content": [
        "弱柳好花尽坼，晴陌。",
        "陌上少年郎，满身兰麝扑人香。",
        "狂么狂，狂么狂。"
      ],
      "author": {
        "id": 12325,
        "name": "顾敻"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378083,
      "title": "荷叶杯·荷叶杯·记得那时相见",
      "content": [
        "记得那时相见，胆战。",
        "鬓乱四肢柔，泥人无语不抬头。",
        "羞么羞，羞么羞。"
      ],
      "author": {
        "id": 12325,
        "name": "顾敻"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378084,
      "title": "荷叶杯·荷叶杯·夜久歌声怨咽",
      "content": [
        "夜久歌声怨咽，残月。",
        "菊冷露微微，看看湿透缕金衣。",
        "归么归，归么归。"
      ],
      "author": {
        "id": 12325,
        "name": "顾敻"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378085,
      "title": "荷叶杯·荷叶杯·我忆君诗最苦",
      "content": [
        "我忆君诗最苦，知否。",
        "字字尽关心，红笺写寄表情深。",
        "吟么吟，吟么吟。"
      ],
      "author": {
        "id": 12325,
        "name": "顾敻"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378086,
      "title": "荷叶杯·荷叶杯·金鸭香浓鸳被",
      "content": [
        "金鸭香浓鸳被，枕腻。",
        "小髻簇花钿，腰如细柳脸如莲。",
        "怜么怜，怜么怜。"
      ],
      "author": {
        "id": 12325,
        "name": "顾敻"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378087,
      "title": "荷叶杯·荷叶杯·曲砌蝶飞烟暖",
      "content": [
        "曲砌蝶飞烟暖，春半。",
        "花发柳垂条，花如双脸柳如腰。",
        "娇么娇，娇么娇。"
      ],
      "author": {
        "id": 12325,
        "name": "顾敻"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378088,
      "title": "荷叶杯·荷叶杯·一去又乖期信",
      "content": [
        "一去又乖期信，春尽。",
        "满院长莓苔，手挼裙带独徘徊。",
        "来么来，来么来。"
      ],
      "author": {
        "id": 12325,
        "name": "顾敻"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378089,
      "title": "渔歌子·渔歌子·晓风清",
      "content": [
        "晓风清，幽沼绿，倚栏凝望珍禽浴。",
        "画帘垂，翠屏曲，满袖荷香馥郁。",
        "好摅怀，堪寓目，身闲心静平生足。",
        "酒杯深，光影促，名利无心较逐。"
      ],
      "author": {
        "id": 12325,
        "name": "顾敻"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378090,
      "title": "临江仙·临江仙·碧染长空池似镜",
      "content": [
        "碧染长空池似镜，倚楼闲望凝情，满衣红藕细香清。",
        "象床珍簟，山障掩，玉琴横。",
        "暗想昔时欢笑事，如今赢得愁生。",
        "博山炉暖淡烟轻。",
        "蝉吟人静，残日傍，小窗明。"
      ],
      "author": {
        "id": 12325,
        "name": "顾敻"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378091,
      "title": "临江仙·临江仙·幽闺小槛春光晚",
      "content": [
        "幽闺小槛春光晚，柳浓花淡莺稀。",
        "旧欢思想尚依依，翠颦红敛，终日损芳菲。",
        "何事狂夫音信断，不如梁燕犹归。",
        "画意深处麝烟微，屏虚枕冷，风细雨霏霏。"
      ],
      "author": {
        "id": 12325,
        "name": "顾敻"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378092,
      "title": "临江仙·临江仙·月色穿帘风入竹",
      "content": [
        "月色穿帘风入竹，倚屏双黛愁时。",
        "砌花含露两三枝，如啼恨脸，魂断损容仪。",
        "香烬暗消金鸭冷，可堪辜负前期。",
        "绣襦不整鬓鬟欹，几多惆怅，情绪在天涯。"
      ],
      "author": {
        "id": 12325,
        "name": "顾敻"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378093,
      "title": "醉公子·醉公子·漠漠秋云淡",
      "content": [
        "漠漠秋云淡，红耦香侵槛。",
        "枕欹小山屏，金铺向晚扃。",
        "睡起横波慢，独望情何限。",
        "衰柳数声蝉，魂消似去年。"
      ],
      "author": {
        "id": 12325,
        "name": "顾敻"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378094,
      "title": "醉公子·醉公子·岸柳垂金线",
      "content": [
        "岸柳垂金线，雨晴莺石啭。",
        "家在绿杨边，往来多少年。",
        "马嘶芳草远，高楼帘半卷。",
        "敛袖翠蛾攒，相逢尔许难。"
      ],
      "author": {
        "id": 12325,
        "name": "顾敻"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378095,
      "title": "更漏子·更漏子·旧欢娱",
      "content": [
        "旧欢娱，新怅望，拥鼻含颦楼上。",
        "浓柳翠，晚霞微，江鸥接翼飞。",
        "帘半卷，屏斜掩，远岫参差迷眼。",
        "歌满耳，酒盈樽，前非不要论。"
      ],
      "author": {
        "id": 12325,
        "name": "顾敻"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378096,
      "title": "浣溪沙·浣溪沙·蓼岸风多枯柚香",
      "content": [
        "蓼岸风多枯柚香，江边一望楚天长，片帆烟际闪孤光。",
        "目送征鸿飞杳杳，思随流水去茫茫，兰红波碧忆潇湘。"
      ],
      "author": {
        "id": 12232,
        "name": "孙光宪"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378097,
      "title": "浣溪沙·浣溪沙·桃杏风香帘幕闲",
      "content": [
        "桃杏风香帘幕闲，谢家门户约花关，画梁幽语燕初还。",
        "绣阁数行题了壁，晓屏一枕酒醒山，却疑身是梦魂间。"
      ],
      "author": {
        "id": 12232,
        "name": "孙光宪"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378098,
      "title": "浣溪沙·浣溪沙·花渐凋疏不耐风",
      "content": [
        "花渐凋疏不耐风，画帘垂地晚堂空，堕阶萦藓舞愁红。",
        "腻粉半沾金靥子，残香犹暖绣熏笼，蕙心无处与人同。"
      ],
      "author": {
        "id": 12232,
        "name": "孙光宪"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378099,
      "title": "浣溪沙·浣溪沙·揽镜无言泪欲流",
      "content": [
        "揽镜无言泪欲流，凝情半日懒梳头，一庭疏雨湿春愁。",
        "杨柳只知伤离别，杏花应信损娇羞，泪沾魂断轸离忧。"
      ],
      "author": {
        "id": 12232,
        "name": "孙光宪"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378100,
      "title": "浣溪沙·浣溪沙·半踏长裾宛约行",
      "content": [
        "半踏长裾宛约行，晚帘疏处见分明，此时堪恨昧平生。",
        "早是消魂残烛影，更愁闻着品弦声，杳无消息若为情。"
      ],
      "author": {
        "id": 12232,
        "name": "孙光宪"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378101,
      "title": "浣溪沙·浣溪沙·兰沐初休曲槛前",
      "content": [
        "兰沐初休曲槛前，缓风迟日洗头天，湿云新敛未梳蝉。",
        "翠袂半将遮粉臆，宝钗长欲坠香肩，此时模样不禁怜。"
      ],
      "author": {
        "id": 12232,
        "name": "孙光宪"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378102,
      "title": "浣溪沙·浣溪沙·风递残香出绣帘",
      "content": [
        "风递残香出绣帘，团窠金凤舞襜襜，落花微雨恨相兼。",
        "何处去来狂太甚，空推宿酒睡无厌，怎教人不别猜嫌。"
      ],
      "author": {
        "id": 12232,
        "name": "孙光宪"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378103,
      "title": "浣溪沙·浣溪沙·轻打银筝坠燕泥",
      "content": [
        "轻打银筝坠燕泥，断丝高罥画楼西，花冠闲上午墙啼。",
        "粉箨半开新竹径，红苞尽落旧桃蹊，不堪终日闭深闺。"
      ],
      "author": {
        "id": 12232,
        "name": "孙光宪"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378104,
      "title": "浣溪沙·浣溪沙·乌帽斜欹倒佩鱼",
      "content": [
        "乌帽斜欹倒佩鱼，静街偷步访仙居，隔墙应认打门初。",
        "将见客时微掩敛，得人怜处且先疏，低头羞问壁边书。"
      ],
      "author": {
        "id": 12232,
        "name": "孙光宪"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378105,
      "title": "河传·河传·太平天子",
      "content": [
        "太平天子，等闲游戏，疏河千里。",
        "柳如丝，偎倚绿波春水，长淮风不起。",
        "如花殿脚三千女，争云雨，何处留人住？",
        "锦帆风，烟际江，烧空，魂迷大业中。"
      ],
      "author": {
        "id": 12232,
        "name": "孙光宪"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378106,
      "title": "河传·河传·柳拖金缕",
      "content": [
        "柳拖金缕，着烟笼雾，蒙蒙落絮。",
        "凤皇舟上楚女，妙舞，雷喧波上鼓。",
        "龙争虎战分中土，人无主，桃叶江南渡。",
        "襞花笺，艳思牵。",
        "成篇，官娥相与传。"
      ],
      "author": {
        "id": 12232,
        "name": "孙光宪"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378107,
      "title": "河传·河传·花落",
      "content": [
        "花落，烟薄，谢家池阁。",
        "寂寞春深，翠蛾轻敛意沉吟。",
        "沾襟，无人知此心。",
        "玉炉香断霜灰冷，帘铺影，梁燕归红杏。",
        "晚来天，空悄然。",
        "孤眠，枕檀云髻偏。"
      ],
      "author": {
        "id": 12232,
        "name": "孙光宪"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378108,
      "title": "河传·河传·风飐",
      "content": [
        "风飐，波敛。",
        "团荷闪闪，珠倾露点。",
        "木兰舟上，何处吴娃越艳，藕花红照脸。",
        "大堤狂杀襄阳客，烟波隔，渺渺湖光白。",
        "身已归，心不归。",
        "斜晖，远汀㶉𫛶飞。"
      ],
      "author": {
        "id": 12232,
        "name": "孙光宪"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378109,
      "title": "菩萨蛮·菩萨蛮·月华如水笼香砌",
      "content": [
        "月华如水笼香砌，金环碎撼门初闭。",
        "寒影堕高檐，钩垂一画帘。",
        "碧烟轻袅袅，红战灯花笑。",
        "即此是高唐，掩屏秋梦长。"
      ],
      "author": {
        "id": 12232,
        "name": "孙光宪"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378110,
      "title": "菩萨蛮·菩萨蛮·花冠频鼓墙头翼",
      "content": [
        "花冠频鼓墙头翼，东方淡白连窗色。",
        "门外早莺声，背楼残月明。",
        "薄寒笼醉态，依旧铅华在。",
        "握手送人归，半拖金缕衣。"
      ],
      "author": {
        "id": 12232,
        "name": "孙光宪"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378111,
      "title": "菩萨蛮·菩萨蛮·小庭花落无人归",
      "content": [
        "小庭花落无人归，疏香满地东风老。",
        "春晚信沉沉，天涯何处寻。",
        "晓堂屏六扇，眉共湘山远。",
        "怎奈别离心，近来尤不禁。"
      ],
      "author": {
        "id": 12232,
        "name": "孙光宪"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378112,
      "title": "菩萨蛮·菩萨蛮·青岩碧洞经朝雨",
      "content": [
        "青岩碧洞经朝雨，隔花相唤南溪去。",
        "一只木兰船，波平远浸天。",
        "扣舷惊翡翠，嫩玉抬香臂。",
        "红日欲沉西，烟中遥解觽。"
      ],
      "author": {
        "id": 12232,
        "name": "孙光宪"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378113,
      "title": "菩萨蛮·菩萨蛮·木绵花映丛祠小",
      "content": [
        "木绵花映丛祠小，越禽声里春光晓。",
        "铜鼓与蛮歌，南人祈赛多。",
        "客帆风正急，茜袖偎樯立。",
        "极浦几回头，烟波无限愁。"
      ],
      "author": {
        "id": 12232,
        "name": "孙光宪"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378114,
      "title": "河渎神·河渎神·汾水碧依依",
      "content": [
        "汾水碧依依，黄云落叶初飞。",
        "翠华一去不言归，庙门空掩斜晖。",
        "四壁阴森排古画，依旧琼轮羽驾。",
        "小殿沉沉清夜，银灯飘落香灺。"
      ],
      "author": {
        "id": 12232,
        "name": "孙光宪"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
