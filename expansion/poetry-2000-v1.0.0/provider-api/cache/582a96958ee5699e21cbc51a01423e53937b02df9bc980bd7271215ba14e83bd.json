{
  "data": [
    {
      "id": 3585,
      "title": "次韵大光五羊待耿伯顺之作",
      "content": [
        "康州艇子来不急，过岸橹声空复长。",
        "百尺楼头堪望远，淡烟斜日晚荒荒。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 3586,
      "title": "雨中再赋海山楼诗",
      "content": [
        "百尺阑干横海立，一生襟抱与山开。",
        "岸边天影随潮入，楼上春容带雨来。",
        "慷慨赋诗还自恨，徘徊舒啸却生哀。",
        "灭胡猛士今安有，非复当年单父台。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 3587,
      "title": "题长乐亭",
      "content": [
        "远山云迷颠，近山浄如沐。",
        "客子曳竹舆，伊鸦过山麓。",
        "我行一何迟，时序一何速。",
        "东风所经过，林水一时绿。",
        "疏雨忽飞坠，声在道边木。",
        "淑气自远归，光景变川陆。",
        "遥知存存子，明亦戒征轴。",
        "霁色虽宜诗，不见此清穆。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3588,
      "title": "和大光道中绝句  其一",
      "content": [
        "已费天工十日晴，今朝小雨送潮生。",
        "转头云日还如锦，一抹葱珑画不成。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 3589,
      "title": "和大光道中绝句  其二",
      "content": [
        "寂寂孤村竹映沙，槟榔迎客当煎茶。",
        "岭南二月无桃李，夹路松开黄玉花。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 3590,
      "title": "题长冈亭呈德升大光",
      "content": [
        "久客不忘归，如头垢思沐。",
        "身行江海滨，梦绕嵩少麓。",
        "马何预得失，𫛳何了淹速。",
        "匣中三尺水，瘴雨生新绿。",
        "胡为古驿中，坐听风吟木。",
        "既非还吴张，亦异赴洛陆。",
        "两公茂名实，自是宜鼎轴。",
        "发发不可迟，帝言频郁穆。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3591,
      "title": "甘棠驿怀李德升席大光",
      "content": [
        "破驿难并休，差池便薪水。",
        "山川会心地，还思对君子。",
        "道边千尺榕，午荫清且美。",
        "极知非世用，我爱不能已。",
        "东风吹南服，莽莽绿万里。",
        "此地亦可耕，胡为茧予趾。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3592,
      "title": "赠漳州守綦叔厚",
      "content": [
        "过尽蛮荒兴复新，漳州画戟拥诗人。",
        "十年去国九行旅，万里逢公一欠伸。",
        "王粲登楼还感慨，纪瞻赴召欲逡巡。",
        "绳床相对有今日，剩醉斋中软脚春。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 3593,
      "title": "宿资圣院阁",
      "content": [
        "暮投山崦寺，高处绝人群。",
        "远岫林间见，微泉舍后闻。",
        "阁虚云乱入，江阔野横分。",
        "欲与僧为记，今年懒作文。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 3594,
      "title": "题大龙湫",
      "content": [
        "晓行苍壁中，穷处仍高崖。",
        "白龙三百丈，欲下层颠来。",
        "映日洒飞雨，绕山行怒雷。",
        "潭影纳浩荡，云气扶崔嵬。",
        "小儒叹造化，办此何雄哉。",
        "亦知天下绝，尊者所徘徊。",
        "三生清净愿，俗缘故难开。",
        "践胜吾岂敢，稽首傥兴哀。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3595,
      "title": "雨中宿灵峰寺",
      "content": [
        "雁荡山中逢晚雨，灵峰寺里借绳床。",
        "只应护得纶巾角，还费高僧一炷香。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 3596,
      "title": "自黄岩县舟行入台州",
      "content": [
        "宴坐峰前冲雨急，黄岩县里借舟迟。",
        "百年痴黠不相补，万事悲欢岂可期。",
        "莽莽沧波兼宿雾，纷纷白鹭落山陂。",
        "只应江海凄凉地，欠我临风一赋诗。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 3597,
      "title": "过下杯渡",
      "content": [
        "夜宿下杯馆，朝鸣一棹东。",
        "湖平天尽落，峡断海横通。",
        "冉冉云随舸，茫茫鸟弃风。",
        "仙人蓬岛上，遥见我乘空。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 3598,
      "title": "王孙岭",
      "content": [
        "已过长溪岭更危，伏龙莽莽向川垂。",
        "斜阳照见林中石，记得南山隐去时。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 3599,
      "title": "泛舟入前仓",
      "content": [
        "曾皷盐田棹，前仓不足言。",
        "尽行江左路，初过浙东村。",
        "春去花无迹，潮归岸有痕。",
        "百年都几日，聊复信乾坤。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 3600,
      "title": "送熊博士赴瑞安令",
      "content": [
        "衣冠衮衮相逢地，草木萧萧未变时。",
        "聚散同惊一枕梦，悲欢各诵十年诗。",
        "山林有约吾当去，天地无情子亦饥。",
        "笑领铜章非失计，岁寒心事欲深期。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 3601,
      "title": "夜赋",
      "content": [
        "抱病喜清夜，形羸心独开。",
        "不知药鼎沸，错认雨声来。",
        "岁晚灯烛丽，天长鸿雁哀。",
        "书生惜日月，欹枕意茫哉。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 3602,
      "title": "喜雨",
      "content": [
        "秦望山头云，昨日鸾凤举。",
        "冥冥万里风，淅淅三更雨。",
        "小臣知君忧，起坐听檐语。",
        "风力有去来，龙工杂文武。",
        "灯花识我意，一笑相媚妩。",
        "泥翻早朝路，弥弥光欲吐。",
        "鬰然苍龙阙，佳气接南亩。",
        "千官次第来，豫色各眉宇。",
        "记事以短篇，不工还自许。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3603,
      "title": "醉中",
      "content": [
        "醉中今古兴衰事，诗里江湖摇落时。",
        "两手尚堪杯酒用，寸心唯是鬓毛知。",
        "稽山拥郭东西去，禹穴生云朝暮奇。",
        "万里南征无赋笔，茫茫远望不胜悲。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 3604,
      "title": "不见梅花六言",
      "content": [
        "荆楚岁时经尽，今年不见梅花。",
        "想得苍烟玉立，都藏江上人家。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3605,
      "title": "梅花二首  其一",
      "content": [
        "铁面苍髯洛阳客，玉颜红领会稽仙。",
        "街头相见如相识，恨满东风意不传。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 3606,
      "title": "梅花二首  其二",
      "content": [
        "画取维摩室中物，小瓶春色一枝斜。",
        "梦回映月窗间见，不是桃花与李花。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 3607,
      "title": "雨",
      "content": [
        "听雨披夜襟，冲雨踏晨鼓。",
        "万珠络笋舆，诗中有新语。",
        "老龙经秋卧，岁暮始一举。",
        "成功亦何迟，光采变蔬圃。",
        "道边闻井溢，可笑遽如许。",
        "旧山百尺泉，不知旱与雨。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3608,
      "title": "瓶中梅",
      "content": [
        "明窗净棐几，玉立耿无邻。",
        "红绿两重袂，殷勤满面春。",
        "曾为庾岭客，本是洛阳人。",
        "老我何颜貌，东风处处新。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 3609,
      "title": "除夜",
      "content": [
        "畴昔追欢事，如今病不能。",
        "等闲生白发，耐久是青灯。",
        "海内春还满，江南砚不冰。",
        "题诗饯残岁，钟鼓报晨兴。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 3610,
      "title": "雨中",
      "content": [
        "北客霜侵鬓，南州雨送年。",
        "未闻兵革定，从使岁时迁。",
        "古泽生春霭，高空落暮鸢。",
        "山川含万古，鬰鬰在樽前。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 3611,
      "title": "渡江",
      "content": [
        "江南非不好，楚客自生哀。",
        "摇檝天平渡，迎人树欲来。",
        "雨余吴岫立，日照海门开。",
        "虽异中原险，方隅亦壮哉。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 3612,
      "title": "夙兴",
      "content": [
        "美哉木枕与菅席，无耐当兴戴朝帻。",
        "巷南巷北闻锻声，舍后舍前唯月色。",
        "事国无功端未去，竹舆伊鸦犹昨日。",
        "不见武林城里事，繁华梦觉生荆棘。",
        "成坏由来几古今，乾坤但可著山泽。",
        "西湖已无金碧丽，雨抹晴粧尚娱客。",
        "会当休日一访之，摩挲苍藓慰崖石。",
        "只恐冷泉亭下水，发明白发增叹息。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3613,
      "title": "幽窗",
      "content": [
        "贫士工用短，壮夫溺于诗。",
        "破壁为幽窗，我笔还得持。",
        "高鸟度遗影，风扉语移时。",
        "迨我休暇日，与物聊同嬉。",
        "古来贤哲人，畎亩策安危。",
        "一行或大谬，半隐良亦痴。",
        "寄言山中友，即岁以为期。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3614,
      "title": "题伯时画温溪心等贡五马",
      "content": [
        "漠漠河西尘几重，年来画马亦难逢。",
        "题诗记著今朝事，同看联翩五匹龙。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 3615,
      "title": "休日马上",
      "content": [
        "休日不自休，骑马踏荒径。",
        "却扇受景风，今朝我无病。",
        "春云閟晨耀，群绿澹相映。",
        "山川与朝市，一动自一静。",
        "九衢行万人，谁抱此怀胜。",
        "不得与之语，萧萧寄孤咏。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3616,
      "title": "题画",
      "content": [
        "分明楼阁是龙门，亦有溪流曲抱村。",
        "万里家山无路入，十年心事有谁论。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 3617,
      "title": "题崇兰图二首  其一",
      "content": [
        "两公得我色敷腴，藜杖相将入画图。",
        "我已梦中都识路，秋风举袂不踟蹰。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 3618,
      "title": "题崇兰图二首  其二",
      "content": [
        "奕奕天风吹角巾，松声水色一时新。",
        "山林从此不牢落，照影溪头共六人。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 3619,
      "title": "秋夜独酌",
      "content": [
        "凉秋佳夕天氛廓，河汉之涯秋漠漠。",
        "月出未出林彩变，幽人露坐方独酌。",
        "自歌新词酒如空，天星下饮觥船中。",
        "忽思李白不可见，夜半乔木摇西风。",
        "百年佳月几今夕，忧乐相寻老来疾。",
        "琼瑶满地我影横，添酒赋诗何可失。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3620,
      "title": "九日示大圆洪智",
      "content": [
        "自得休心法，悠然不赋诗。",
        "忽逢重九日，无奈菊花枝。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 3621,
      "title": "刘大资挽词二首  其一",
      "content": [
        "天柱欹倾日，堂堂堕虏围。",
        "遂闻王蠋死，不见华元归。",
        "一代名超古，千年泪染衣。",
        "当时如有继，犹足变危机。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 3622,
      "title": "刘大资挽词二首  其二",
      "content": [
        "一死公余事，由来虏亦人。",
        "使知临难日，犹有不欺臣。",
        "河洛倾遗愤，英雄叹后尘。",
        "煌煌中兴业，公合冠麒麟。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 3623,
      "title": "与智老天经夜坐",
      "content": [
        "残年不复徙他邦，长与两禅同夜缸。",
        "坐到更深都寂寂，雪花无数落窗前。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 3624,
      "title": "观雪",
      "content": [
        "无住庵前境界新，琼楼玉宇总无尘。",
        "开门倚杖移时立，我是人间富贵人。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 3625,
      "title": "题江参山水横轴画俞秀才所藏二首  其一",
      "content": [
        "卷中衮衮溪山去，笔下明明开辟初。",
        "不肯一裈为妇计，俞郎作意未全疏。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 3626,
      "title": "题江参山水横轴画俞秀才所藏二首  其二",
      "content": [
        "万壑分烟高复低，人家随处有柴扉。",
        "此中只欠陈居士，千仞岗头一振衣。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 3627,
      "title": "小阁晨起",
      "content": [
        "纸帐不知晓，鸦鸣吾当兴。",
        "开窗面老松，相对寒崚嶒。",
        "幸无公家责，欲懒还不能。",
        "汲井颒我面，铜盆旋敲冰。",
        "梳头风入槛，纷散霜满膺。",
        "四瞻郊泽间，苍烟惨朝凝。",
        "却望塔颠日，光景舒层层。",
        "乾坤有奇事，变化忽相乘。",
        "客来无可语，语此不见应。",
        "今晨胡床冷，愧我无毾㲪。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3628,
      "title": "小阁晚望",
      "content": [
        "泽国候易变，孟冬乃微和。",
        "解襟凭小阁，日暮归云多。",
        "苍苍散草木，莽莽杂山河。",
        "荒野虫乱鸣，长空鸟时过。",
        "万象各无待，唯人顾纷罗。",
        "备物以养己，更用干与戈。",
        "天风吹我来，衣袂生微波。",
        "幽怀眇无寄，萧瑟起悲歌。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3629,
      "title": "梅花",
      "content": [
        "一枝斜映佛前灯，春入铜壶夜不冰。",
        "昔岁曾游大庾岭，今年聊作小乘僧。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 3630,
      "title": "得张正字诗",
      "content": [
        "送老茅屋底，天寒人迹稀。",
        "一觞犹有味，万事已无机。",
        "岁暮塔孤立，风生鸦乱飞。",
        "此时张正字，书札到郊扉。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 3631,
      "title": "江梅",
      "content": [
        "风雪集岁暮，江梅开不迟。",
        "朝来幽窗底，明珰缀青枝。",
        "上天播淑气，百卉分四时。",
        "寒村值西子，足以昌吾诗。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 3632,
      "title": "雪",
      "content": [
        "穷腊见三白，江南无旧闻。",
        "天上春已暮，尽日花缤纷。",
        "平生虽畏寒，遇雪心所欣。",
        "拥裘未敢出，投隙致殷勤。",
        "窗户忽相照，川陵已难分。",
        "二仪有巨丽，老我不能文。",
        "高吟黄竹诗，薄暮心无垠。",
        "浮屠似玉笋，突兀倚重云。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3633,
      "title": "小阁",
      "content": [
        "栏干横岁暮，徙倚度阴晴。",
        "木落太湖近，梅开南纪明。",
        "病余仍爱酒，身后更须名。",
        "鹳鹤忽双起，吾诗还欲成。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 3634,
      "title": "元夜",
      "content": [
        "今夕天气佳，上天何澄穆。",
        "列宿雨后明，流云月边速。",
        "空檐垂斗柄，微吹生丛竹。",
        "对此不能寐，步绕庭之曲。",
        "遥睇浮屠颠，数星红煜煜。",
        "悟知烧灯夕，节意亦满目。",
        "历代能几诗，遍赋杂珉玉。",
        "栖鸦亦未定，更鸣伴余独。",
        "百年滔滔内，忧乐两难复。",
        "唯应长似今，寂寞送寒燠。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3635,
      "title": "怀天经智老因访之",
      "content": [
        "今年二月冻初融，睡起苕溪绿向东。",
        "客子光阴诗卷里，杏花消息雨声中。",
        "西庵禅伯还多病，北栅儒先只固穷。",
        "忽忆轻舟寻二子，纶巾鹤氅试春风。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 3636,
      "title": "黄修职雨中送芍药五枝",
      "content": [
        "微雨湿清晓，老夫门未开。",
        "煌煌五仙子，并拥翠蕤来。",
        "烟脂洗尽不自惜，为雨归来更无力。",
        "老夫五十尚可痴，凭轩一赋会真诗。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3637,
      "title": "樱桃",
      "content": [
        "四月江南黄鸟肥，樱桃满市粲朝晖。",
        "赤瑛盘里虽殊遇，何似筠笼相发挥。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 3638,
      "title": "叶柟惠花",
      "content": [
        "无住庵中老居士，逢春入定不衔杯。",
        "文殊罔明俱拱手，今日花枝唤得回。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 3639,
      "title": "牡丹",
      "content": [
        "一自胡尘入汉关，十年伊洛路漫漫。",
        "青墩溪畔龙钟客，独立东风看牡丹。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 3640,
      "title": "盆池",
      "content": [
        "三尺清池窗外开，茨菰叶底戏鱼回。",
        "雨声转入浙江去，云影还从震泽来。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 3641,
      "title": "松棚",
      "content": [
        "黯黯当窗云不驱，不教风日到琴书。",
        "只今老子风流地，何似茅山陶隐居。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 3642,
      "title": "西轩",
      "content": [
        "平生江海志，岁暮僧庐中。",
        "虚斋时独步，溯此西窗风。",
        "初夏气未变，幽居念方冲。",
        "三日无客来，门外生蒿蓬。",
        "轻阴映夕幌，窈窕瓶花红。",
        "未知古今士，谁与此心同。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3643,
      "title": "玉堂儤直",
      "content": [
        "庭叶珑珑晓更青，断云吐日照寒厅。",
        "只应未上归田奏，贪诵楞伽四卷经。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 3644,
      "title": "病骨",
      "content": [
        "病骨瘦始轻，清虚日来入。",
        "今朝僧阁上，超遥久风立。",
        "茂林榴萼红，细雨离黄湿。",
        "物色乃可怜，所悲非故邑。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 3645,
      "title": "晨起",
      "content": [
        "寂寂东轩晨起迟，蒙茏草木暗疏篱。",
        "风来众绿一时动，正是先生睡足时。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 3646,
      "title": "登阁",
      "content": [
        "今日天气佳，登临散腰脚。",
        "南方宜草木，九月未黄落。",
        "秋郊乃明丽，夕云更萧索。",
        "远游吾未能，岁暮依楼阁。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 3647,
      "title": "芙蓉",
      "content": [
        "白发飘萧一病翁，暮年身世药瓢中。",
        "芙蓉墙外垂垂发，九月凭栏未怯风。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 3648,
      "title": "岁华",
      "content": [
        "岁华日已凋，飞叶鸣古瓦。",
        "白头倚危槛，高旻覆平野。",
        "遥瞻疏柳林，下有清溪泻。",
        "三春既繁丽，九秋亦潇洒。",
        "平生万事过，所欠茅一把。",
        "山川鬰日夕，有抱无与写。",
        "赋诗老不工，开篇咏风雅。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3649,
      "title": "得长春两株植之窗前",
      "content": [
        "乡邑已无路，僧庐今是家。",
        "聊乘数点雨，自种两丛花。",
        "篱落失秋序，风烟添岁华。",
        "衰翁病不饮，独立到栖鸦。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 3650,
      "title": "九月八日戏作两绝句示妻子  其一",
      "content": [
        "今夕知何夕，都如未病时。",
        "重阳莫草草，剩作几篇诗。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 3651,
      "title": "九月八日戏作两绝句示妻子  其二",
      "content": [
        "小瓮今朝熟，无劳问酒家。",
        "重阳明日是，何处有黄花。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 3652,
      "title": "拒霜",
      "content": [
        "拒霜花已吐，吾宇不凄凉。",
        "天地虽肃杀，草木有芬芳。",
        "道人宴坐处，侍女古时粧。",
        "浓露湿丹脸，西风吹绿裳。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 3653,
      "title": "微雨中赏月桂独酌",
      "content": [
        "人间跌宕简斋老，天下风流月桂花。",
        "一壶不觉丛边尽，暮雨霏霏欲湿鸦。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 3654,
      "title": "画梅",
      "content": [
        "娥眉淡淡自成粧，驿使还家空断肠。",
        "脂粉不施憔悴尽，失身未嫁易元光。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 3655,
      "title": "竹",
      "content": [
        "高枝已约风为友，密叶能留雪作花。",
        "昨夜常娥更潇洒，又携疏影过窗纱。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 3656,
      "title": "心老久许为作画未果以诗督之",
      "content": [
        "布衲王摩诘，禅余寄笔端。",
        "试将能事迫，肯作画工难。",
        "秋入无声句，山连欲雨寒。",
        "平生梦想处，奉乞小巑岏。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 3657,
      "title": "偶成古调十六韵上呈判府兼赠刘兴州",
      "content": [
        "稽首苏耽仙，乘云去无迹。",
        "尚留橘井在，与世除狂疾。",
        "谁能不饮此，识味亦可录。",
        "坐令郑玄牛，亦抱荆山玉。",
        "伟哉稚川裔，神交接朝夕。",
        "游戏及小道，造化入大笔。",
        "优为吴诗父，雅命楚骚仆。",
        "岂其橘井助，本自同仙箓。",
        "坐中子刘子，知是当日客。",
        "书悬元和脚，语经建康力。",
        "先我登公门，不数鸷鸟百。",
        "曾挹两仙袖，自然生羽翼。",
        "嗟我无长才，学架屋下屋。",
        "诗虽两牛腰，事亦几蛇足。",
        "已穷犹不悔，政荷师友德。",
        "文盟傥许予，幸不疑籍湜。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3658,
      "title": "再用迹字韵成一首呈判府",
      "content": [
        "风雨一叶过，黄花已陈迹。",
        "人贫交旧疏，岁暮日月疾。",
        "贪人积胡椒，智不到鬼录。",
        "那知庾郎菜，地瘦饱金玉。",
        "不如学服气，清座了晨夕。",
        "尚余烟月债，驱使入吟笔。",
        "晚逢葛先生，怜我出无仆。",
        "借车得时诣，谬窥文字箓。",
        "谈诗不知疲，或作夜半客。",
        "挥毫写珠玉，治郡盖余力。",
        "不羡江千万，不慕李八百。",
        "愿传公句法，容我附风翼。",
        "城东刘子政，著书方满屋。",
        "昨示一篇诗，三日叹未足。",
        "仍闻供笔砚，家有樊通德。",
        "但恐裴公门，从此近舍湜。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3659,
      "title": "蒙示黄礀佳诗三读钦羡辄继韵仰报嘉赐",
      "content": [
        "痴儿了官事，官事那可讫。",
        "岂知公偷闲，临水照缨绂。",
        "虽微八川雄，暴怒常至沸。",
        "傥或似山阴，清流可共祓。",
        "贪德实以济，行地不鬰鬰。",
        "赵洛与陶丘，相比亦仿佛。",
        "解后逢公赏，一洗伏流屈。",
        "可爱不可唾，众议那可咈。",
        "彼是公余波，本来非俗物。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3660,
      "title": "蒙示涉汝诗次韵",
      "content": [
        "城南天倒影，绿浪摇十里。",
        "使君云梦胸，犹复录此水。",
        "舟行及雨霁，秋色在葭苇。",
        "烟涵翠縠润，月照金波委。",
        "知公已忘机，鸥鹭宛停峙。",
        "向来趋热士，说似颡应泚。",
        "俗子与清游，自古剧函矢。",
        "如何有双脚，受垢不受洗。",
        "异哉公殊嗜，记此两苦李。",
        "诗成堕衡门，名字污纸尾。",
        "明当蹑公迹，佳处不待指。",
        "会逢白沙渚，我舍真可徙。",
        "鸣驺傥重来，傍舫倾我耳。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3661,
      "title": "再和",
      "content": [
        "洪河岂不壮，余润弥九里。",
        "海内所咏歌，在德不在水。",
        "德人经行地，可敬及蒲苇。",
        "况有水如此，浪去剧雪委。",
        "念昔涉涛江，怒鼍如山峙。",
        "天风怖杀人，舟定舷有泚。",
        "惕然三夜梦，沙砾下飞矢。",
        "至今逢沟壑，敢照不敢洗。",
        "忽诵涉汝诗，五字拟苏李。",
        "快言击汰事，想见鱼掉尾。",
        "十年疑此乐，始误斗柄指。",
        "便当策我足，岁月忽转徙。",
        "未办志和舟，且洗子荆耳。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3662,
      "title": "游岘山次韵三首  其一",
      "content": [
        "夜度一程云，平明踏山址。",
        "山神岂妬我，飞雨乱眸子。",
        "重岳衮衮去，前杰后俊伟。",
        "晦明更百态，始望那及此。",
        "路穷得精庐，税驾咨祖始。",
        "老僧千金意，佳处相指似。",
        "先生一笑领，得句易翻水。",
        "安石未归山，却要山料理。",
        "奇哉此一段，惊世无前轨。",
        "酬山以快饮，春蕨正滋旨。",
        "一丘傥许予，高卧饱松髓。",
        "城中谩拄笏，那知有兹事。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3663,
      "title": "游岘山次韵三首  其二",
      "content": [
        "高人买山隐，百万犹恨少。",
        "客儿最省事，有屐一生了。",
        "东庄良不遥，十里望缥缈。",
        "萦纡并麦垅，翠浪四山绕。",
        "先生滞鹿车，去程通凤沼。",
        "暂来山泉上，思与飞云杳。",
        "云北接云南，一迳绝纷扰。",
        "竹林怀风雨，目断极窈窈。",
        "从来无世尘，相对真不挠。",
        "龙儿争地出，头角已表表。",
        "先生嘱支郎，勿使斤斧夭。",
        "终当乞一杖，险路扶吾老。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3664,
      "title": "游岘山次韵三首  其三",
      "content": [
        "转路山突兀，众山之所望。",
        "懒融不下山，揖山会虚堂。",
        "大空出盘嬉，小空时侍傍。",
        "我游瞻铁凤，力尽随木羊。",
        "石窗非人世，意欲凌风翔。",
        "巉巉窗中人，出定发有霜。",
        "过眼几浮烟，关身一禅床。",
        "教我安心法，入鸟不乱行。",
        "似知使君尊，起炷柏子香。",
        "陇云亦堪寄，分作我归装。",
        "好在窗前竹，伴师老苍苍。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3665,
      "title": "再赋  其一",
      "content": [
        "堂堂李杜坛，谁敢蹑其址。",
        "先生坐坛上，持钺令余子。",
        "由来文字伯，不但表奏伟。",
        "高怀淡无嗜，寓兴或留此。",
        "平生上林手，避谤淹二始。",
        "登临意超然，笔落风雨似。",
        "事异柳司马，辛苦记山水。",
        "乐哉邦无事，那待猛政理。",
        "驾言慰吾民，不愧城门轨。",
        "看山笑邹湛，句外寄深旨。",
        "岩树阅几客，尚余尧时髓。",
        "抚板歌公诗，未暇知余事。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3666,
      "title": "再赋  其二",
      "content": [
        "兴公赋天台，千字一何少。",
        "岘山逢巧匠，笼络六诗了。",
        "余情到娘子，心动云缥缈。",
        "仿佛山阿人，薜荔一身绕。",
        "殷勤供泚笔，路转得龙沼。",
        "应龙喜公来，嘘气纷雾杳。",
        "忽然张盖起，知不受人扰。",
        "诗成中有画，幽情杂荒窈。",
        "从公虽一快，顾有和诗挠。",
        "是事姑置之，归路迷日表。",
        "安得永兹乐，彭铿尚为夭。",
        "但愁归城中，念山令人老。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3667,
      "title": "再赋  其三",
      "content": [
        "修眉入幽梦，起费西南望。",
        "终愿学柳文，买泉筑愚堂。",
        "错磨高壁翠，日日在我旁。",
        "忽在新野邹，行从泰山羊。",
        "城中瞻使君，驾鹤高驰翔。",
        "诗成堕人世，字字含风霜。",
        "平生仰止勤，不但上下床。",
        "顾许俗士驾，平参丈人行。",
        "封姨岂嗔予，震怒挟阿香。",
        "知公终可恃，不记当趋装。",
        "清欢岂有极，夜色来苍苍。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3668,
      "title": "秋月",
      "content": [
        "袢暑推不去，快风喜来过。",
        "西荣迟明月，与子聊婆娑。",
        "初如金盆涌，稍若玉鉴磨。",
        "亭亭倚华魄，艳艳舒冻波。",
        "夜气清入骨，奈此光景何。",
        "一杯幸相属，安能废吟哦。",
        "纤阿无停轮，衰鬓飒已多。",
        "及时会行乐，无惜醉颜酡。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3669,
      "title": "均台辞二首  其一",
      "content": [
        "小桃借春春已来，平分和气入均台。",
        "夜来台边草环绿，今朝芒生满三木。",
        "街头拍手闹千儿，齐唱中和宣布曲。",
        "使君坐啸闹如云，请酿百川寿使君。",
        "但愿使君长乐职，不须更看杓虚实。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3670,
      "title": "均台辞二首  其二",
      "content": [
        "东家西家尔盍来，听说空圄如春台。",
        "决曹高卧印生绿，丛棘化为交逊木。",
        "策勋此木那可遗，动地风摇枝不曲。",
        "愿我无讼到来云，莫辞著力借寇君。",
        "借得贤侯虽尔职，但恐朝廷要人调鼎实。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3671,
      "title": "长沙寺桂花重开",
      "content": [
        "天遣幽花两度开，黄昏梵放此徘徊。",
        "不教居士卧禅榻，唤出西厢共看来。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 3672,
      "title": "和若拙弟得陪游后园  其一",
      "content": [
        "西园冠盖坐生风，更欲长绳系六龙。",
        "惟有病夫能省事，北窗三友是过从。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 3673,
      "title": "和若拙弟得陪游后园  其二",
      "content": [
        "壮夫三箭功名手，儒士百篇藜苋肠。",
        "莫道人人握珠玉，应须字字挟风霜。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 3674,
      "title": "季高送酒",
      "content": [
        "自接曲生蓬户外，便呼伯雅竹床头。",
        "真逢幼妇著黄绢，直遣从事到青州。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 3675,
      "title": "墨戏二首 兰",
      "content": [
        "鄂州迁客一花说，仇池老仙五字铭。",
        "并入晴窗三昧手，不须辛苦读骚经。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 3676,
      "title": "墨戏二首 蕙",
      "content": [
        "人间风露不到畹，只有酪奴无世尘。",
        "何须更待秋风至，萧艾从来不共春。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 3677,
      "title": "和孙升之",
      "content": [
        "姬国余芳代有人，于今公子秀溪𣸣。",
        "处心如水尚书市，能赋临流靖节君。",
        "花岛红云春句丽，月梅疏影夜香闻。",
        "囊开古锦湖山出，何意一星窥妙文。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 3678,
      "title": "寺居",
      "content": [
        "招提远占一牛鸣，阻绝干戈得暂经。",
        "梦境了知非有实，醉乡不入自常醒。",
        "楼台近水涵明鉴，草树连空写素屏。",
        "物象自堪供客眼，未须觅句户长扃。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 3679,
      "title": "某窃慕东坡以铁拄杖为乐全生日之寿今以大铜瓶上判府待制庶几因物以露区区且作诗二首将之亦东坡故事  其一",
      "content": [
        "要学东坡寿乐全，此瓶端合供儒先。",
        "铁如意畔无忧畏，玉唾壶傍耐岁年。",
        "项似董宣真是强，腹如边孝故应便。",
        "与公剩贮为霖水，不羡宫门承露仙。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 3680,
      "title": "某窃慕东坡以铁拄杖为乐全生日之寿今以大铜瓶上判府待制庶几因物以露区区且作诗二首将之亦东坡故事  其二",
      "content": [
        "不与观音伴柳枝，要令奇相解公颐。",
        "会逢白氏编书日，犹梦陶家贮粟时。",
        "安用作盘供歃血，也胜为钵困催诗。",
        "千年秀结重重绿，长映先生鬓与眉。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 3681,
      "title": "又用韵春雪",
      "content": [
        "急雪催诗兴未阑，东风肯奈鸟乌寒。",
        "最怜度牖勤勤意，更接飞花细细看。",
        "连夜抛回三白瑞，及时惊动五辛盘。",
        "袁安久绝千人望，春破还思绮一端。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 3682,
      "title": "次韵邢子友",
      "content": [
        "壮士如今烂莫收，尚思抽矢射旄头。",
        "不堪苦雾侵衰鬓，稍喜和烟入戍楼。",
        "万里中原空费梦，三春胜日偶成游。",
        "青松远岭偏惊眼，薄晚阑干更少留。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 3683,
      "title": "某用家弟韵赋绝句上浼清视芜词累句非敢以为诗也赐一言卒相之",
      "content": [
        "万里平生几蛇足，九州何路不羊肠。",
        "只应绿士苍官辈，却解从公到雪霜。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 3684,
      "title": "某以雨有嘉应遂占有秋辄采用家弟韵赋二绝句少赀勤恤之诚也  其一",
      "content": [
        "云气初看龙起湫，雨声旋听树惊秋。",
        "已教农父歌田守，更遣虞人信魏侯。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    }
  ],
