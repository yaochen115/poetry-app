{
  "data": [
    {
      "id": 311576,
      "title": "送楚丘曲少府赴官",
      "content": [
        "青袍美少年，黄绶一神仙。",
        "微子城东面，梁王苑北边。",
        "桃花色似马，榆荚小于钱。",
        "单父闻相近，家书早为传。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 311577,
      "title": "送蜀郡李掾",
      "content": [
        "饮酒俱未醉，一言聊赠君。",
        "功曹善为政，明主还应闻。",
        "夜宿劒门月，朝行巴水云。",
        "江城菊花发，满道香氛氲。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 311578,
      "title": "送郑少府赴滏阳",
      "content": [
        "子真河朔尉，邑里带清漳。",
        "春草迎袍色，晴花拂绶香。",
        "青山入官舍，黄鸟度宫墙。",
        "若到铜台上，应怜魏寝荒。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 311579,
      "title": "还高冠潭口留别舍弟",
      "content": [
        "昨日山有信，祗今耕种时。",
        "遥传杜陵叟，怪我还山迟。",
        "独向潭上酌，无人林下棋。",
        "东谿忆汝处，闲卧对鸬鹚。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 311580,
      "title": "醴泉东谿送程皓元镜微入蜀",
      "content": [
        "蜀郡路漫漫，梁州过七盘。",
        "二人来信宿，一县醉衣冠。",
        "谿逼春衫冷，林交宴席寒。",
        "西南如喷酒，遥向雨中看。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 311581,
      "title": "夏初醴泉南楼送太康颜少府",
      "content": [
        "何地堪相饯，南楼出万家。",
        "可怜高处送，远见故人车。",
        "野果新成子，庭槐欲作花。",
        "爱君兄弟好，书向颍中夸。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 311582,
      "title": "送严诜擢第归蜀",
      "content": [
        "巴江秋月新，阁道发征轮。",
        "战胜真才子，名高动世人。",
        "工文能似舅，擢第去荣亲。",
        "十月天官待，应须早赴秦。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 311583,
      "title": "送张直公归南郑拜省",
      "content": [
        "夫子思何速，世人皆叹奇。",
        "万言不加点，七步犹嫌迟。",
        "对酒落日后，还家飞雪时。",
        "北堂应久待，乡梦促征期。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 311584,
      "title": "送周子落第游荆南",
      "content": [
        "足下复不第，家贫寻故人。",
        "且倾湘南酒，羞对关西尘。",
        "山店橘花发，江城枫叶新。",
        "若从巫峡过，应见楚王神。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 311585,
      "title": "送薛彦伟擢第东归",
      "content": [
        "时辈似君稀，青春战胜归。",
        "名登郄诜第，身着老莱衣。",
        "称意人皆羡，还家马若飞。",
        "一枝谁不折，棣蕚独相辉。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 311586,
      "title": "送杨瑗尉南海",
      "content": [
        "不择南州尉，高堂有老亲。",
        "楼台重蜃气，邑里杂鲛人。",
        "海暗三山雨，花明五岭春。",
        "此乡多宝玉，慎莫厌清贫。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 311587,
      "title": "凤翔府行军送程使君赴成州",
      "content": [
        "程侯新出守，好日发行军。",
        "拜命时人羡，能官圣主闻。",
        "江楼黑塞雨，山郭冷秋云。",
        "竹马诸童子，朝朝待使君。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 311588,
      "title": "送张升卿宰新滏",
      "content": [
        "官柳叶尚小，长安春未浓。",
        "送君浔阳宰，把酒青门钟。",
        "水驿楚云冷，山城江树重。",
        "遥知南湖上，只对香炉峰。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 311589,
      "title": "送陈子归陆浑别业",
      "content": [
        "虽不旧相识，知君丞相家。",
        "故园伊川上，夜梦方山花。",
        "种药畏春过，出关愁路赊。",
        "青门酒垆别，日暮东城鸦。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 311590,
      "title": "稠桑驿喜逢严河南中丞便别",
      "content": [
        "驷马映花枝，人人夹路窥。",
        "离心且莫问，春草自应知。",
        "不谓青云客，犹思紫禁时。",
        "别君能几日，看取鬓成丝。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 311591,
      "title": "送蒲秀才擢第归蜀",
      "content": [
        "去马疾如飞，看君战胜归。",
        "新登郄诜第，更著老莱衣。",
        "汉水行人少，巴山客舍稀。",
        "向南风候暖，腊月见春辉。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 311592,
      "title": "送郭司马赴伊吾郡请示李明府",
      "content": [
        "安西美少年，脱劒卸弓弦。",
        "不倚将军势，皆称司马贤。",
        "秋山城北面，古治郡东边。",
        "江上舟中月，遥思李郭仙。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 311593,
      "title": "送滕亢擢第归苏州拜亲",
      "content": [
        "送尔姑苏客，沧波秋正凉。",
        "橘怀三个去，桂折一枝将。",
        "湖上山当舍，天边水是乡。",
        "江村人事少，时作捕鱼郎。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 311594,
      "title": "送任郎中出守明州",
      "content": [
        "罢起郎官草，初封刺史符。",
        "城边楼枕海，郭里树侵湖。",
        "郡政傍连楚，朝恩独借吴。",
        "观涛秋正好，莫不上姑苏。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 311595,
      "title": "临洮客舍留别祁四",
      "content": [
        "无事向边外，至今仍不归。",
        "三年绝乡信，六月未春衣。",
        "客舍洮水聒，孤城胡雁飞。",
        "心知别君后，开口笑应稀。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 311596,
      "title": "送弘文李校书往汉南拜亲",
      "content": [
        "未识已先闻，清辞果出群。",
        "如逢祢处士，似见鲍参军。",
        "梦暗巴山雨，家连汉水云。",
        "慈亲思爱子，几度泣霑帬。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 311597,
      "title": "送李别将摄伊吾令充使赴武威便寄崔员外",
      "content": [
        "词赋满书囊，胡为在战场。",
        "行间脱宝劒，邑里挂铜章。",
        "马疾飞千里，凫飞向五凉。",
        "遥知竹林下，星使对星郎。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 311598,
      "title": "送四镇薛侍御东归",
      "content": [
        "相送泪沾衣，天涯独未归。",
        "将军初得罪，门客复何依。",
        "梦去湖山阔，书停陇雁稀。",
        "园林幸接近，一为到柴扉。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 311599,
      "title": "送张都尉东归",
      "content": [
        "白羽绿弓弦，年年只在边。",
        "还家劒锋尽，出塞马蹄穿。",
        "逐虏西逾海，平胡北到天。",
        "封侯应不远，燕颔岂徒然。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 311600,
      "title": "送樊侍御使丹阳便觐",
      "content": [
        "卧病穷巷晚，忽惊骢马来。",
        "知君京口去，借问几时回。",
        "驿舫江风引，乡书海雁催。",
        "慈亲应倍喜，爱子在霜台。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 311601,
      "title": "送张卿郎君赴硖石尉",
      "content": [
        "卿家送爱子，愁见灞头春。",
        "草羡青袍色，花随黄绶新。",
        "县西函谷路，城北大阳津。",
        "日暮征鞍去，东郊一片尘。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 311602,
      "title": "送颜少府投郑陈州",
      "content": [
        "一尉便垂白，数年唯草玄。",
        "出关策匹马，逆旅闻秋蝉。",
        "爱客多酒债，罢官无俸钱。",
        "知君羁思少，所适主人贤。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 311603,
      "title": "赵少尹南亭送郑侍御归东台",
      "content": [
        "红亭酒瓮香，白面绣衣郎。",
        "砌冷虫喧坐，帘疎雨到床。",
        "钟催离兴急，弦逐醉歌长。",
        "关树应先落，随君满鬓霜。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 311604,
      "title": "祁四再赴江南别诗",
      "content": [
        "万里来又去，三湘东复西。",
        "别多人换鬓，行远马穿蹄。",
        "山驿秋云冷，江帆暮雨低。",
        "怜君不解说，相忆在书题。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 311605,
      "title": "送许员外江外置常平仓",
      "content": [
        "诏置海陵仓，朝推画省郎。",
        "还家锦服贵，出使绣衣香。",
        "水驿风催舫，江楼月透床。",
        "仍怀陆氏橘，归献老亲尝。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 311606,
      "title": "送秘省虞校书赴虞乡丞",
      "content": [
        "花绶傍腰新，关东县欲春。",
        "残书厌科斗，旧阁别麒麟。",
        "虞坂临官舍，条山映吏人。",
        "看君有知己，坦腹向平津。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 311607,
      "title": "送江陵泉少府赴任便呈卫荆州",
      "content": [
        "神仙吏姓梅，人吏待君来。",
        "渭北草新出，江南花已开。",
        "城边宋玉宅，峡口楚王台。",
        "不畏无知己，荆州甚爱才。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 311608,
      "title": "奉送李太保兼御史大夫充渭北节度使",
      "content": [
        "诏出未央宫，登坛近总戎。",
        "上公周太保，副相汉司空。",
        "弓抱关西月，旗翻渭北风。",
        "弟兄皆许国，天地荷成功。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 311609,
      "title": "送江陵黎少府",
      "content": [
        "悔系腰间绶，翻为膝下愁。",
        "那堪汉水远，更值楚山秋。",
        "新橘香官舍，征帆拂县楼。",
        "王城不敢住，岂是爱荆州。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 311610,
      "title": "虢州送天平何丞入京市马",
      "content": [
        "关树晚苍苍，长安近夕阳。",
        "回风醒别酒，细雨湿行装。",
        "习战边尘黑，防秋塞草黄。",
        "知君市骏马，不是学燕王。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 311611,
      "title": "送扬州王司马",
      "content": [
        "君家旧淮水，水上到扬州。",
        "海树青官舍，江云黑郡楼。",
        "东南随去鸟，人吏待行舟。",
        "为报吾兄道，如今已白头。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 311612,
      "title": "陕州月城楼送辛判官入奏",
      "content": [
        "送客飞鸟外，城头楼最高。",
        "樽前遇风雨，牕里动波涛。",
        "谒帝向金殿，随身唯宝刀。",
        "相思灞陵月，祗有梦偏劳。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 311613,
      "title": "送王七录事赴虢州",
      "content": [
        "早岁即相知，嗟君最后时。",
        "青云仍未达，白发欲成丝。",
        "小店关门树，长河华岳祠。",
        "弘农人吏待，莫使马行迟。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 311614,
      "title": "阌乡送上官秀才归关西别业",
      "content": [
        "风尘奈汝何，终日独波波。",
        "亲老无官养，家贫在外多。",
        "醉眼轻白发，春梦渡黄河。",
        "相去关城近，何时更肯过。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 311615,
      "title": "送羽林长孙将军赴歙州",
      "content": [
        "剖竹向江𣸣，能名计日闻。",
        "隼旗新刺史，虎劒旧将军。",
        "驿舫宿湖月，州城浸海云。",
        "青门酒楼上，欲别醉醺醺。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 311616,
      "title": "送崔主簿赴夏阳",
      "content": [
        "常爱夏阳县，往年曾再过。",
        "县中饶白鸟，郭外是黄河。",
        "地近行程少，家贫酒债多。",
        "知君新称意，好得奈春何。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 311617,
      "title": "送梁判官归女几旧庐",
      "content": [
        "女几知君忆，春云相逐归。",
        "草堂开药裹，苔壁取荷衣。",
        "老竹移时少，新花旧处飞。",
        "可怜真傲吏，尘事到山稀。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 311618,
      "title": "送怀州吴别驾",
      "content": [
        "灞上柳枝黄，垆头酒正香。",
        "春流饮去马，暮雨湿行装。",
        "驿路通函谷，州城接太行。",
        "覃怀人总喜，别驾得王祥。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 311619,
      "title": "送人归江宁",
      "content": [
        "楚客忆乡信，向家湖水长。",
        "住愁春草绿，去喜桂枝香。",
        "海月迎归楚，江云引到乡。",
        "吾兄应借问，为报鬓毛霜。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 311620,
      "title": "送襄州任别驾",
      "content": [
        "别乘向襄州，萧条楚地秋。",
        "江声官舍里，山色郡城头。",
        "莫羡黄公盖，须乘彦伯舟。",
        "高阳诸醉客，唯见古时丘。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 311621,
      "title": "送李司谏归京",
      "content": [
        "别酒为谁香，春官驳正郎。",
        "醉经秦树远，梦怯汉川长。",
        "雨过风头黑，云开日脚黄。",
        "知君解起草，早去入文昌。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 311622,
      "title": "送緜州李司马秩满归京因呈李兵部",
      "content": [
        "久客厌江月，罢官思早归。",
        "眼看春光老，羞见梨花飞。",
        "劒北山居小，巴南音信稀。",
        "因君报兵部，愁泪日沾衣。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 311623,
      "title": "送崔员外入秦因访故园",
      "content": [
        "欲谒明光殿，先趋建礼门。",
        "仙郎去得意，亚相正承恩。",
        "竹里巴山道，花间汉水源。",
        "凭将两行泪，为访邵平园。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 311624,
      "title": "送柳录事赴梁州",
      "content": [
        "英掾柳家郎，离亭酒瓮香。",
        "折腰思汉北，随传过巴阳。",
        "江树连官舍，山云到卧床。",
        "知君归梦积，去去劒川长。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 311625,
      "title": "送韦侍御先归京",
      "content": [
        "闻欲朝龙阙，应须拂豸冠。",
        "风霜随马去，炎暑为君寒。",
        "客泪题书落，乡愁对酒宽。",
        "先凭报亲友，后月到长安。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 311626,
      "title": "送裴侍御赴岁入京",
      "content": [
        "羡他骢马郎，元日谒明光。",
        "立处闻天语，朝回惹御香。",
        "台寒柏树绿，江暖柳条黄。",
        "惜别津亭暮，挥戈忆鲁阳。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 311627,
      "title": "送颜评事入京",
      "content": [
        "颜子人叹屈，宦游今未迟。",
        "伫闻明主用，岂负青云姿。",
        "江柳秋吐叶，山花寒满枝。",
        "知君客愁处，月满巴川时。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 311628,
      "title": "送赵侍御归上都",
      "content": [
        "骢马五花毛，青云归处高。",
        "霜随驱夏暑，风逐振江涛。",
        "执简皆推直，勤王岂告劳。",
        "帝城谁不恋，回望动离骚。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 311629,
      "title": "送杨子",
      "content": [
        "斗酒渭城边，垆头耐醉眠。",
        "梨花千树雪，杨叶万条烟。",
        "惜别添壶酒，临岐赠马鞭。",
        "看君颍上去，新月到家圆。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 311630,
      "title": "送人赴安西",
      "content": [
        "上马带胡钩，翩翩度陇头。",
        "小来思报国，不是爱封侯。",
        "万里乡为梦，三边月作愁。",
        "早须清黠虏，无事莫经秋。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 311631,
      "title": "发临洮将赴北庭留别",
      "content": [
        "闻说轮台路，连年见雪飞。",
        "春风曾不到，汉使亦应稀。",
        "白草通疎勒，青山过武威。",
        "勤王敢道远，私向梦中归。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 311632,
      "title": "临洮泛舟赵仙舟自北庭罢使还京",
      "content": [
        "白发轮台使，边功竟不成。",
        "云沙万里地，孤负一书生。",
        "池上风回舫，桥西雨过城。",
        "醉眠乡梦罢，东望羡归程。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 311633,
      "title": "春日醴泉杜明府承恩五品宴席上赋诗",
      "content": [
        "凫舃旧称仙，鸿私降自天。",
        "青袍移草色，朱绶夺花然。",
        "邑里雷仍震，台中星欲悬。",
        "吾兄此栖棘，因得贺初筵。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 311634,
      "title": "早春陪崔中丞同泛浣花谿宴",
      "content": [
        "旌节临谿口，塞郊陡觉暄。",
        "红亭移酒席，画舸逗江村。",
        "云带歌声飏，风飘舞袖翻。",
        "花间催秉烛，川上欲黄昏。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 311635,
      "title": "喜华阴王少府使到南池宴集",
      "content": [
        "有客至铃下，自言身姓梅。",
        "仙人掌里使，黄帝鼎边来。",
        "竹影拂棋局，荷香随酒杯。",
        "池前堪醉卧，待月未须回。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 311636,
      "title": "行军雪后月夜宴王卿家",
      "content": [
        "子夜雪华余，卿家月影初。",
        "酒香薰枕席，炉气煖轩除。",
        "晚岁宦情薄，行军欢宴疎。",
        "相逢剩取醉，身外尽空虚。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 311637,
      "title": "梁州陪赵行军龙冈寺北庭泛舟宴王侍御",
      "content": [
        "谁宴霜台使，行军粉署郎。",
        "唱歌江鸟没，吹笛岸花香。",
        "酒影摇新月，滩声聒夕阳。",
        "江钟闻已暮，归櫂绿川长。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 311638,
      "title": "奉陪封大夫宴得征字时封公兼鸿胪卿",
      "content": [
        "西边虏尽平，何处更专征。",
        "幕下人无事，军中政已成。",
        "座参殊俗语，乐杂异方声。",
        "醉里东楼月，偏能照列卿。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 311639,
      "title": "陪封大夫宴瀚海亭纳凉",
      "content": [
        "细管杂青丝，千杯倒接䍠。",
        "军中乘兴出，海上纳凉时。",
        "日没鸟飞急，山高云过迟。",
        "吾从大夫后，归路拥旌旗。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 311640,
      "title": "虢州西亭陪端公宴集",
      "content": [
        "红亭出鸟外，骏马系云端。",
        "万岭牕前睥，千家肘底看。",
        "开瓶酒色嫩，踏地叶声干。",
        "为逼霜台使，重裘也觉寒。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 311641,
      "title": "陪使君早春东郊游眺",
      "content": [
        "太守拥朱轮，东郊物候新。",
        "莺声随坐啸，柳色唤行春。",
        "谷口云迎马，谿边水照人。",
        "郡中叨佐理，何幸接芳尘。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 311642,
      "title": "雪后与群公过慈恩寺",
      "content": [
        "乘兴忽相招，僧房暮与朝。",
        "雪融双树湿，沙暗一灯烧。",
        "竹外山低塔，藤间院隔桥。",
        "归家如欲嬾，俗虑向来销。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 311643,
      "title": "与鄠县群官泛渼陂",
      "content": [
        "万顷浸天色，千寻穷地根。",
        "舟移城入树，岸阔水浮村。",
        "闲鹭惊箫管，潜蚪傍酒樽。",
        "暝来呼小吏，列火俨归轩。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 311644,
      "title": "与鄠县源少府泛渼陂",
      "content": [
        "载酒入天色，水凉难醉人。",
        "清摇县郭动，碧洗云山新。",
        "吹笛惊白鹭，垂竿跳紫鳞。",
        "怜君公事后，陂上日娱宾。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 311645,
      "title": "终南东谿中作",
      "content": [
        "谿水碧于草，潺潺花底流。",
        "沙平堪濯足，石浅不胜舟。",
        "洗药朝与暮，钓鱼春复秋。",
        "兴来从所适，还欲向沧洲。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 311646,
      "title": "与鲜于庶子泛汉江",
      "content": [
        "急管更须吹，杯行莫遣迟。",
        "酒光红琥珀，江色碧琉璃。",
        "日影浮归櫂，芦花罥钓丝。",
        "山公醉不醉，问取葛[彊]知。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 311647,
      "title": "晦日陪侍御泛北池",
      "content": [
        "春池满复宽，晦节耐邀欢。",
        "月带虾蟆冷，霜随獬豸寒。",
        "水云低锦席，岸柳拂金盘。",
        "日暮舟中散，都人夹道看。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 311648,
      "title": "登凉州尹台寺",
      "content": [
        "胡地三月半，梨花今始开。",
        "因从老僧饭，更上夫人台。",
        "清唱云不去，弹弦风飒来。",
        "应须一倒载，还似山公回。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 311649,
      "title": "登总持阁",
      "content": [
        "高阁逼诸天，登临近日边。",
        "晴开万井树，愁看五陵烟。",
        "槛外低秦岭，牕中小渭川。",
        "蚤知清净理，常愿奉金仙。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 311650,
      "title": "奉陪封大夫九日登高",
      "content": [
        "九日黄花酒，登高会昔闻。",
        "霜威逐亚相，杀气傍中军。",
        "横笛惊征雁，娇歌落塞云。",
        "边头幸无事，醉舞荷吾君。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 311651,
      "title": "郡斋平望江山",
      "content": [
        "水路东连楚，人烟北接巴。",
        "山光围一郡，江月照千家。",
        "庭树纯栽橘，园畦半种茶。",
        "梦魂知忆处，无夜不京华。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 311652,
      "title": "宿岐州北郭严给事别业",
      "content": [
        "郭外山色暝，主人林馆秋。",
        "疎钟入卧内，片月到床头。",
        "遥夜惜已半，清言殊未休。",
        "君虽在青琐，心不忘沧洲。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 311653,
      "title": "暮秋会严京兆后厅竹斋",
      "content": [
        "京兆小斋宽，公庭半药阑。",
        "瓯香茶色嫩，牕冷竹声干。",
        "盛德中朝贵，清风画省寒。",
        "能将吏部镜，照取寸心看。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 311654,
      "title": "省中即事",
      "content": [
        "华省谬为郎，蹉跎鬓已苍。",
        "到来恒幞被，随例且含香。",
        "竹影遮牕暗，花阴拂簟凉。",
        "君王新赐笔，草奏向明光。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 311655,
      "title": "寻阳七郎中宅即事",
      "content": [
        "万事信苍苍，机心久已忘。",
        "无端来出守，不是厌为郎。",
        "雨滴芭蕉赤，霜催橘子黄。",
        "逢君开口笑，何处有他乡。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 311656,
      "title": "携琴酒寻阎防崇济寺所居僧院",
      "content": [
        "相访但寻钟，门寒古殿松。",
        "弹琴醒暮酒，卷幔引诸峰。",
        "事惬林中语，人幽物外踪。",
        "吾庐幸接近，兹地兴偏慵。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 311657,
      "title": "春寻河阳陶处士别业",
      "content": [
        "风煖日暾暾，黄鹂飞近村。",
        "花明潘子县，柳暗陶公门。",
        "药椀摇山影，鱼竿带水痕。",
        "南桥车马客，何事苦喧喧。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 311658,
      "title": "晚过盘石寺礼郑和尚",
      "content": [
        "暂诣高僧话，来寻野寺孤。",
        "岸花藏水碓，谿水映风炉。",
        "顶上巢新鹊，衣中带旧珠。",
        "谈禅未得去，辍櫂且踟蹰。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 311659,
      "title": "寻少室张山人闻与偃师周明府同入都",
      "content": [
        "中峰炼金客，昨日游人间。",
        "叶县凫共去，葛陂龙暂还。",
        "春云凑深水，秋雨悬空山。",
        "寂寂清谿上，空余丹灶闲。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 311660,
      "title": "虢州卧疾喜刘判官相过水亭",
      "content": [
        "卧疾尝晏起，朝来头未梳。",
        "见君胜服药，清话病能除。",
        "低柳共系马，小池堪钓鱼。",
        "观棋不觉暝，月出水亭初。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 311661,
      "title": "武威春暮闻宇文判官西使还已到晋昌",
      "content": [
        "岸雨过城头，黄鹂上戍楼。",
        "塞北飘客泪，边柳挂乡愁。",
        "白发悲明镜，青春换敝裘。",
        "君从万里使，闻已到瓜州。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 311662,
      "title": "虢州南池候严中丞不至",
      "content": [
        "池上日相待，知君殊未回。",
        "徒教柳叶长，漫使梨花开。",
        "驷马去不见，双鱼空往来。",
        "思想不解说，孤负舟中杯。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 311663,
      "title": "春兴思南山旧庐招柳建正字",
      "content": [
        "终岁不得意，春风今复来。",
        "自怜蓬鬓改，羞见梨花开。",
        "西掖诚可恋，南山思早回。",
        "园庐幸接近，相与归蒿莱。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 311664,
      "title": "郡斋南池招杨辚",
      "content": [
        "郡僻人事少，云山常眼前。",
        "偶从池上醉，便向舟中眠。",
        "与子居最近，周官情又偏。",
        "闲时耐相访，正有床头钱。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 311665,
      "title": "高冠谷口招郑鄠",
      "content": [
        "谷口来相访，空斋不见君。",
        "涧花然暮雨，潭树煖春云。",
        "门径稀人迹，簷峰下鹿群。",
        "衣裳与枕席，山霭碧氛氲。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 311666,
      "title": "题新乡王釜厅壁",
      "content": [
        "怜君守一尉，家计复清贫。",
        "禄米尝不足，俸钱供与人。",
        "城头苏门树，陌上黎阳尘。",
        "不是旧相识，声同心自亲。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 311667,
      "title": "题山寺僧房",
      "content": [
        "牕影摇群木，墙阴载一峰。",
        "野炉风自𦶟，山碓水能舂。",
        "勤学翻知误，为官好欲慵。",
        "高僧暝不见，月出但闻钟。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 311668,
      "title": "汉上题韦氏庄",
      "content": [
        "结茅闻楚客，卜筑汉江边。",
        "日落数归鸟，夜深闻扣舷。",
        "水痕侵岸柳，山翠借厨烟。",
        "调笑提筐妇，春来蚕几眠。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 311669,
      "title": "题永乐韦少府厅壁",
      "content": [
        "大河南郭外，终日气昏昏。",
        "白鸟下公府，青山当县门。",
        "故人是邑尉，过客驻征轩。",
        "不惮烟波阔，思君一笑言。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 311670,
      "title": "题金城临河驿楼",
      "content": [
        "古戍依重险，高楼见五凉。",
        "山根盘驿道，河水浸城墙。",
        "庭树巢鹦鹉，园花隐麝香。",
        "忽如江浦上，忆作捕鱼郎。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 311671,
      "title": "初授官题高冠草堂",
      "content": [
        "三十始一命，宦情多欲阑。",
        "自怜无旧业，不敢耻微官。",
        "涧水吞樵路，山花醉药栏。",
        "秪缘五斗米，辜负一渔竿。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 311672,
      "title": "题虢州西楼",
      "content": [
        "错料一生事，蹉跎今白头。",
        "纵横皆失计，妻子也堪羞。",
        "明主虽然弃，丹心亦未休。",
        "愁来无去处，祗上郡西楼。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 311673,
      "title": "夜过盘石隔河望永乐寄闺中效齐梁体",
      "content": [
        "盈盈一水隔，寂寂二更初。",
        "波上思罗袜，鱼边忆素书。",
        "月如眉已画，云似鬓新梳。",
        "春物知人意，桃花笑索居。"
