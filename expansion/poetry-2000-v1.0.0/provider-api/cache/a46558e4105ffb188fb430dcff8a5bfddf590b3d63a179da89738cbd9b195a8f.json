{
  "data": [
    {
      "id": 280330,
      "title": "寻隐者不遇",
      "content": [
        "松下问童子，言师采药去。",
        "只在此山中，云深不知处。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 280332,
      "title": "马嵬",
      "content": [
        "长川几处树青青，孤驿危楼对翠屏。",
        "一自上皇惆怅后，至今来往马蹄腥。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 280333,
      "title": "冬夜送人",
      "content": [
        "平明走马上村桥，花落梅溪雪未消。",
        "日短天寒愁送客，楚山无限路迢迢。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 280334,
      "title": "句",
      "content": [
        "晴风吹柳絮，新火起厨烟。",
        "长江风送客，孤馆雨留人。",
        "古岸崩将尽，平沙长未休。",
        "不如牛与羊，犹得日暮归。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 292807,
      "title": "过海联句",
      "content": [
        "沙鸟浮还没，山云断复连。",
        "櫂穿波底月，船压水中天。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 298088,
      "title": "赴南巴留别苏台知己",
      "content": [
        "人过梅岭上，岁岁北风寒。",
        "落日孤舟去，青山万里看。",
        "猿声湘水静，草色洞庭宽。",
        "已料生涯事，只应持钓竿。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 299217,
      "title": "句",
      "content": [
        "莫是上天宫里唱，歌声飘下玉梁尘。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 300849,
      "title": "纪汤泉",
      "content": [
        "维泉肇何代，开凿同二仪。",
        "五行分水火，厥用谁一之。",
        "在卦得既济，备象坎与离。",
        "下有风轮煽，上有雷车驰。",
        "霞掀祝融井，日烂扶桑池。",
        "气殊礐石厉，脉有灵砂滋。",
        "骊山岂不好，玉环污流脂。",
        "至今华清树，空遗后人悲。",
        "遐哉哲人逝，此水真吾师。",
        "一濯三沐髪，六凿还希夷。",
        "伐毛返骨髓，髪白令人黟。",
        "十年走尘土，负我汗漫期。",
        "再来池上游，触热三伏时。",
        "古寺僧寂寞，但余壁上诗。",
        "不见题诗人，令我长叹咨。",
        "（见康熙十八年闵麟嗣撰《黄山志定本》卷六，乾隆间刊印。",
        "此诗承仪征吴白匋先生见告。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 301585,
      "title": "黄鹤楼",
      "content": [
        "高槛危簷势若飞，孤云野水共依依。",
        "青山万古长如旧，黄鹤何年去不归。",
        "岸映西山（一作「州」）城半山，烟生南浦树将微。",
        "定知羽客无因见，空使含情对落晖。",
        "（《古今图书集成·职方典》一一二五《武昌府部》（民国《湖北通志》卷一○一《金石》九录《鄂州杂诗碑》，分五层，录谢朓及唐人诗三十九首，其中即贾岛此诗及本书后录之卢郢诗。",
        "碑署「熙宁二年六月□日额立」，不著书人姓名，清代尚存于黄鹤楼后斗姥阁西壁。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 301586,
      "title": "留题南赵古庙",
      "content": [
        "鳞鵕老树铁生斑，神宇荒凉野壑闲。",
        "地僻无人秋寂寂，一川红影夕阳间。",
        "（同上三○五《太原府部》）。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 301587,
      "title": "虎丘千人坐（又名千人石）",
      "content": [
        "上陟千人从，低窥百尺松。",
        "碧池藏宝剑，寒涧宿潜龙。",
        "（康熙顾湄《虎邱志》二《泉石》）。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 301588,
      "title": "题安业县",
      "content": [
        "一山未了一山迎，百里都无半里平。",
        "宜是老禅遥指处，只堪图画不堪行。",
        "（《关中胜迹图志》二五《商州地理》）。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 303962,
      "title": "逢友人",
      "content": [
        "还似不才命未通，相逢云水思无穷。",
        "清时年少为幽客，寒月更深听过鸿。",
        "东越山多连楚叠，南朝城古枕江空。",
        "苍崖欲隐谁招我？",
        "姜子生涯只此中。",
        "（见《吟窗杂录》卷十三梅尧臣《续金针诗格》引）。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 303963,
      "title": "送人",
      "content": [
        "半夜长安雨，灯前越客心。",
        "（见同书卷十二沙门文彧《诗格》）。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 303964,
      "title": "桃氏林亭",
      "content": [
        "窗含明月树，沙起白云鸥。",
        "（见同书卷十四正字王元《诗中旨格》）。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 303965,
      "title": "南台对月",
      "content": [
        "僧归湖里寺，鱼听水边经。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 303966,
      "title": "寄[贞]（正）空二上人",
      "content": [
        "老窥明镜少，秋忆故山多。",
        "（均见同书卷三五《贾岛句对》）。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 303967,
      "title": "句 一",
      "content": [
        "风雷一夜雨，山川半年行。",
        "（见同书卷十三王梦简《进士王氏诗要格律》）。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 303968,
      "title": "句 二",
      "content": [
        "祭闲收朔雪，吊后折寒花。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 303969,
      "title": "句 三",
      "content": [
        "离人隔楚水，落叶满长安。",
        "（均见同书卷十三僧虚中《流类手鉴》）。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 334973,
      "title": "杂曲歌辞：壮士吟",
      "content": [
        "壮士不曾悲，悲即无回期。",
        "如何易水上，未歌先泪垂。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 361455,
      "title": "寄远",
      "content": [
        "别肠多郁纡，岂能肥肌肤。",
        "始知相结密，不及相结疏。",
        "疏别恨应少，密离恨难袪。",
        "门前南流水，中有北飞鱼。",
        "鱼飞向北海，可以寄远书。",
        "不惜寄远书，故人今在无。",
        "况此数尺身，阻彼万里途。",
        "自非日月光，难以知子躯。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361456,
      "title": "斋中",
      "content": [
        "眈静非谬为，本性实疏索。",
        "斋中一就枕，不觉白日落。",
        "低扉碍轩辔，寡德谢接诺。",
        "丛菊在墙阴，秋穷未开萼。",
        "所餐类病马，动影似移岳。",
        "欲驻迫逃衰，岂殊辞绠缚。",
        "已见饱时雨，应丰蔬与药。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361457,
      "title": "感秋",
      "content": [
        "商气飒已来，岁华又虚掷。",
        "朝云藏奇峰，暮雨洒疏滴。",
        "几蜩嘿凉叶，数蛩思阴壁。",
        "落日空馆中，归心远山碧。",
        "昔人多秋感，今人何异昔。",
        "四序驰百年，玄发坐成白。",
        "喧喧徇声利，扰扰同辙迹。",
        "傥无世上怀，去偃松下石。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361458,
      "title": "玩月",
      "content": [
        "寒月破东北，贾生立西南。",
        "西南立倚何，立倚青青杉。",
        "近月有数星，星名未详谙。",
        "但爱杉倚月，我倚杉为三。",
        "月乃不上杉，上杉难相参。",
        "眙愕子细视，睛瞳桂枝劖。",
        "目常有热疾，久视无烦炎。",
        "以手扪衣裳，零露已濡沾。",
        "久立双足冻，时向股髀淹。",
        "立久病足折，兀然黐胶粘。",
        "他人应已睡，转喜此景恬。",
        "此景亦胡及，而我苦淫耽。",
        "无异市井人，见金不知廉。",
        "不知此夜中，几人同无厌。",
        "待得上顶看，未拟归枕函。",
        "强步望寝斋，步步情不堪。",
        "步到竹丛西，东望如隔帘。",
        "却坐竹丛外，清思刮幽潜。",
        "量知爱月人，身愿化为蟾。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361460,
      "title": "义雀行和朱评事",
      "content": [
        "玄鸟雄雌俱，春雷惊蛰余。",
        "口衔黄河泥，空即翔天隅。",
        "一夕皆莫归，哓哓遗众雏。",
        "双雀抱仁义，哺食劳劬劬。",
        "雏既逦迤飞，云间声相呼。",
        "燕雀虽微类，感愧诚不殊。",
        "禽贤难自彰，幸得主人书。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361468,
      "title": "双鱼谣",
      "content": [
        "天河堕双鲂，飞我庭中央。",
        "掌握尺余雪，劈开肠有璜。",
        "见令馋舌短，烹绕邻舍香。",
        "一得古诗字，与玉含异藏。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 361470,
      "title": "早起",
      "content": [
        "北客入西京，北雁再离北。",
        "秋寝独前兴，天梭星落织。",
        "耽玩余恬爽，顾盼轻疴力。",
        "旅途少颜尽，明镜劝仙食。",
        "出门路纵横，张家路最直。",
        "昨夜梦见书，张家厅上壁。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361473,
      "title": "赠智朗禅师",
      "content": [
        "上人分明见，玉兔潭底没。",
        "上人光惨貌，古来恨峭发。",
        "涕辞孔颜庙，笑访禅寂室。",
        "步随青山影，坐学白塔骨。",
        "解听无弄琴，不礼有身佛。",
        "欲问师何之，忽与我相别。",
        "率赋赠远言，言惭非子曰。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361476,
      "title": "冬月长安雨中见终南雪",
      "content": [
        "秋节新已尽，雨疏露山雪。",
        "西峰稍觉明，残滴犹未绝。",
        "气侵瀑布水，冻著白云穴。",
        "今朝灞浐雁，何夕潇湘月。",
        "想彼石房人，对雪扉不闭。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361477,
      "title": "寄孟协律",
      "content": [
        "我有吊古泣，不泣向路岐。",
        "挥泪洒暮天，滴著桂树枝。",
        "别后冬节至，离心北风吹。",
        "坐孤雪扉夕，泉落石桥时。",
        "不惊猛虎啸，难辱君子词。",
        "欲酬空觉老，无以堪远持。",
        "岧峣倚角窗，王屋悬清思。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361479,
      "title": "明月山怀独孤崇鱼琢",
      "content": [
        "明月长在目，明月长在心。",
        "在心复在目，何得稀去寻。",
        "试望明月人，孟夏树蔽岑。",
        "想彼叹此怀，乐喧忘幽林。",
        "乡本北岳外，悔恨东夷深。",
        "愿缩地脉还，岂待天恩临。",
        "非不渴隐秀，却嫌他事侵。",
        "或云岳楼钟，来绕草堂吟。",
        "当从令尹后，再往步柏林。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361480,
      "title": "投张太祝",
      "content": [
        "风骨高更老，向春初阳葩。",
        "泠泠月下韵，一一落海涯。",
        "有子不敢和，一听千叹嗟。",
        "身卧东北泥，魂挂西南霞。",
        "手把一枝栗，往轻觉程赊。",
        "水天朔方色，暖日嵩根花。",
        "达闲幽栖山，遣寻种药家。",
        "欲买双琼瑶，惭无一木瓜。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361483,
      "title": "携新文诣张籍韩愈途中成",
      "content": [
        "袖有新成诗，欲见张韩老。",
        "青竹未生翼，一步万里道。",
        "仰望青冥天，云雪压我脑。",
        "失却终南山，惆怅满怀抱。",
        "安得西北风，身愿变蓬草。",
        "地只闻此语，突出惊我倒。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361484,
      "title": "上谷送客游江湖",
      "content": [
        "莫叹迢递分，何殊咫尺别。",
        "江楼到夜登，还见南台月。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 361486,
      "title": "投孟郊",
      "content": [
        "月中有孤芳，天下聆熏风。",
        "江南有高唱，海北初来通。",
        "容飘清冷余，自蕴襟抱中。",
        "止息乃流溢，推寻却冥蒙。",
        "我知雪山子，谒彼偈句空。",
        "必竟获所实，尔焉遂深衷。",
        "录之孤灯前，犹恨百首终。",
        "一吟动狂机，万疾辞顽躬。",
        "生平面未交，永夕梦辄同。",
        "叙诘谁君师，讵言无吾宗。",
        "余求履其迹，君曰可但攻。",
        "啜波肠易饱，揖险神难从。",
        "前岁曾入洛，差池阻从龙。",
        "萍家复从赵，云思长萦萦。",
        "嵩海每可诣，长途追再穷。",
        "原倾肺肠事，尽入焦梧桐。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361488,
      "title": "寄刘栖楚",
      "content": [
        "趋走与偃卧，去就自殊分。",
        "当窗一重树，上有万里云。",
        "离披不相顾，仿佛类人群。",
        "友生去更远，来书绝如焚。",
        "蝉吟我为听，我歌蝉岂闻。",
        "岁暮傥旋归，晤言桂氛氲。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361492,
      "title": "寄友人",
      "content": [
        "同人半年别，一别寂来音。",
        "赖有别时文，相思时一吟。",
        "我常倦投迹，君亦知此衿。",
        "笔砚且勿弃，苏张曾陆沉。",
        "但存舌在口，当冀身遂心。",
        "君看明月夜，松桂寒森森。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361495,
      "title": "戏赠友人",
      "content": [
        "一日不作诗，心源如废井。",
        "笔砚为辘轳，吟咏作縻绠。",
        "朝来重汲引，依旧得清冷。",
        "书赠同怀人，词中多苦辛。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 361496,
      "title": "寓兴",
      "content": [
        "真集道方至，貌殊妒还多。",
        "山泉入城池，自然生浑波。",
        "今时出古言，在众翻为讹。",
        "有琴含正韵，知音者如何。",
        "一生足感激，世言忽嵯峨。",
        "不得市井味，思响吾岩阿。",
        "浮华岂我事，日月徒蹉跎。",
        "旷哉颍阳风，千载无其他。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361504,
      "title": "题岸上人郡内闲居",
      "content": [
        "静向方寸求，不居山嶂幽。",
        "池开菡萏香，门闭莓苔秋。",
        "金玉重四句，秕糠轻九流。",
        "炉烟上乔木，钟磬下危楼。",
        "手种一株松，贞心与师俦。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361511,
      "title": "就可公宿",
      "content": [
        "十里寻幽寺，寒流数派分。",
        "僧同雪夜坐，雁向草堂闻。",
        "静语终灯焰，余生许峤云。",
        "由来多抱疾，声不达明君。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 361512,
      "title": "旅游",
      "content": [
        "此心非一事，书劄若为传。",
        "旧国别多日，故人无少年。",
        "空巢霜叶落，疏牖水萤穿。",
        "留得林僧宿，中宵坐默然。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 361520,
      "title": "送崔定",
      "content": [
        "未知游子意，何不避炎蒸。",
        "几日到汉水，新蝉鸣杜陵。",
        "秋江待得月，夜语恨无僧。",
        "巴峡吟过否，连天十二层。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 361522,
      "title": "雨后宿刘司马池上",
      "content": [
        "蓝溪秋漱玉，此地涨清澄。",
        "芦苇声兼雨，芰荷香绕灯。",
        "岸头秦古道，亭面汉荒陵。",
        "静想泉根本，幽崖落几层。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 361523,
      "title": "送朱可久归越中",
      "content": [
        "石头城下泊，北固暝钟初。",
        "汀鹭潮冲起，船窗月过虚。",
        "吴山侵越众，隋柳入唐疏。",
        "日欲躬调膳，辟来何府书。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 361525,
      "title": "送董正字常州觐省",
      "content": [
        "相逐一行鸿，何时出碛中。",
        "江流翻白浪，木叶落青枫。",
        "轻楫浮吴国，繁霜下楚空。",
        "春来欢侍阻，正字在东宫。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 361528,
      "title": "送李骑曹",
      "content": [
        "归骑双旌远，欢生此别中。",
        "萧关分碛路，嘶马背寒鸿。",
        "朔色晴天北，河源落日东。",
        "贺兰山顶草，时动卷帆风。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 361531,
      "title": "寄无可上人",
      "content": [
        "僻寺多高树，凉天忆重游。",
        "磬过沟水尽，月入草堂秋。",
        "穴蚁苔痕静，藏蝉柏叶稠。",
        "名山思遍往，早晚到嵩丘。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 361534,
      "title": "送贞空二上人",
      "content": [
        "林下中餐后，天涯欲去时。",
        "衡阳过有伴，梦泽出应迟。",
        "石磬疏寒韵，铜瓶结夜澌。",
        "殷勤讶此别，且未定归期。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 361535,
      "title": "送裴校书",
      "content": [
        "拜官从秘省，署职在藩维。",
        "多故长疏索，高秋远别离。",
        "天寒泗上醉，夜静岳阳棋。",
        "使府临南海，帆飞到不迟。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 361536,
      "title": "升道精舍南台对月寄姚合",
      "content": [
        "月向南台见，秋霖洗涤余。",
        "出逢危叶落，静看众峰疏。",
        "冷露常时有，禅窗此夜虚。",
        "相思聊怅望，润气遍衣初。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 361538,
      "title": "黄子陂上韩吏部",
      "content": [
        "石楼云一别，二十二三春。",
        "相逐升堂者，几为埋骨人。",
        "涕流闻度瘴，病起喜还秦。",
        "曾是令勤道，非惟恤在迍。",
        "疏衣蕉缕细，爽味茗芽新。",
        "钟绝滴残雨，萤多无近邻。",
        "溪潭承到数，位秩见辞频。",
        "若个山招隐，机忘任此身。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361540,
      "title": "吊孟协律",
      "content": [
        "才行古人齐，生前品位低。",
        "葬时贫卖马，远日哭惟妻。",
        "孤冢北邙外，空斋中岳西。",
        "集诗应万首，物象遍曾题。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 361541,
      "title": "送人适越",
      "content": [
        "高城满夕阳，何事欲沾裳。",
        "迁客蓬蒿暮，游人道路长。",
        "晴湖胜镜碧，寒柳似金黄。",
        "若有相思梦，殷勤载八行。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 361544,
      "title": "洛阳道中寄弟",
      "content": [
        "趋走迫流年，惭经此路偏。",
        "密云埋二室，积雪度三川。",
        "生类梗萍泛，悲无金石坚。",
        "翻鸿有归翼，极目仰联翩。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 361546,
      "title": "送耿处士",
      "content": [
        "一瓶离别酒，未尽即言行。",
        "万水千山路，孤舟几月程。",
        "川原秋色静，芦苇晚风鸣。",
        "迢递不归客，人传虚隐名。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 361549,
      "title": "送天台僧",
      "content": [
        "远梦归华顶，扁舟背岳阳。",
        "寒蔬修净食，夜浪动禅床。",
        "雁过孤峰晓，猿啼一树霜。",
        "身心无别念，余习在诗章。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 361550,
      "title": "怀紫阁隐者",
      "content": [
        "寂寥思隐者，孤烛坐秋霖。",
        "梨栗猿喜熟，云山僧说深。",
        "寄书应不到，结伴拟同寻。",
        "废寝方终夕，迢迢紫阁心。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 361551,
      "title": "雨夜同厉玄怀皇甫荀",
      "content": [
        "桐竹绕庭匝，雨多风更吹。",
        "还如旧山夜，卧听瀑泉时。",
        "碛雁来期近，秋钟到梦迟。",
        "沟西吟苦客，中夕话兼思。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 361553,
      "title": "哭胡遇",
      "content": [
        "夭寿知齐理，何曾免叹嗟。",
        "祭回收朔雪，吊后折寒花。",
        "野水秋吟断，空山暮影斜。",
        "弟兄相识遍，犹得到君家。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 361555,
      "title": "送安南惟鉴法师",
      "content": [
        "讲经春殿里，花绕御床飞。",
        "南海几回渡，旧山临老归。",
        "潮摇蛮草落，月湿岛松微。",
        "空水既如彼，往来消息稀。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 361557,
      "title": "送韩湘",
      "content": [
        "挂席从古路，长风起广津。",
        "楚城花未发，上苑蝶来新。",
        "半没湖波月，初生岛草春。",
        "孤霞临石镜，极浦映村神。",
        "细响吟干苇，余馨动远苹。",
        "欲凭将一劄，寄与沃洲人。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361559,
      "title": "宿赟上人房",
      "content": [
        "阶前多是竹，闲地拟栽松。",
        "朱点草书疏，雪平麻履踪。",
        "御沟寒夜雨，宫寺静时钟。",
        "此时无他事，来寻不厌重。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 361561,
      "title": "题山寺井",
      "content": [
        "沉沉百尺余，功就岂斯须。",
        "汲早僧出定，凿新虫自无。",
        "藏源重嶂底，澄翳大空隅。",
        "此地如经劫，凉潭会共枯。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 361564,
      "title": "荒斋",
      "content": [
        "草合径微微，终南对掩扉。",
        "晚凉疏雨绝，初晓远山稀。",
        "落叶无青地，闲身著白衣。",
        "朴愚犹本性，不是学忘机。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 361565,
      "title": "夜喜贺兰三见访",
      "content": [
        "漏钟仍夜浅，时节欲秋分。",
        "泉聒栖松鹤，风除翳月云。",
        "踏苔行引兴，枕石卧论文。",
        "即此寻常静，来多只是君。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 361566,
      "title": "题青龙寺镜公房",
      "content": [
        "一夕曾留宿，终南摇落时。",
        "孤灯冈舍掩，残磬雪风吹。",
        "树老因寒折，泉深出井迟。",
        "疏慵岂有事，多失上方期。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 361567,
      "title": "送陈判官赴绥德",
      "content": [
        "将军邀入幕，束带便离家。",
        "身暖蕉衣窄，天寒碛日斜。",
        "火烧冈断苇，风卷雪平沙。",
        "丝竹丰州有，春来只欠花。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 361570,
      "title": "送敡法师",
      "content": [
        "度岁不相见，严冬始出关。",
        "孤烟寒色树，高雪夕阳山。",
        "瀑布寺应到，牡丹房甚闲。",
        "南朝遗迹在，此去几时还。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 361571,
      "title": "寄钱庶子",
      "content": [
        "曲江春水满，北岸掩柴关。",
        "只有僧邻舍，全无物映山。",
        "树阴终日扫，药债来年还。",
        "犹记听琴夜，寒灯竹屋间。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 361572,
      "title": "原上秋居",
      "content": [
        "关西又落木，心事复如何。",
        "岁月辞山久，秋霖入夜多。",
        "鸟从井口出，人自洛阳过。",
        "倚仗聊闲望，田家未剪禾。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 361575,
      "title": "送厉宗上人",
      "content": [
        "拥策背岷峨，终南雨雪和。",
        "漱泉秋鹤至，禅树夜猿过。",
        "高顶白云尽，前山黄叶多。",
        "曾吟庐岳上，月动九江波。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 361578,
      "title": "寄武功姚主簿",
      "content": [
        "居枕江沱北，情悬渭曲西。",
        "数宵曾梦见，几处得书披。",
        "驿路穿荒阪，公田带淤泥。",
        "静棋功奥妙，闲作韵清凄。",
        "锄草留丛药，寻山上石梯。",
        "客回河水涨，风起夕阳低。",
        "空地苔连井，孤村火隔溪。",
        "卷帘黄叶落，锁印子规啼。",
        "陇色澄秋月，边声入战鼙。",
        "会须过县去，况是屡招携。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361579,
      "title": "题刘华书斋",
      "content": [
        "白石床无尘，青松树有鳞。",
        "一莺啼带雨，两树合从春。",
        "荒榭苔胶砌，幽丛果堕榛。",
        "偶来疏或数，当暑夕胜晨。",
        "露滴星河水，巢重草木薪。",
        "终南同往意，赵北独游身。",
        "渡叶司天漏，惊蛩远地人。",
        "机清公干族，也莫卧漳滨。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361586,
      "title": "早春题友人湖上新居二首",
      "content": [
        "近得云中路，门长侵早开。",
        "到时犹有雪，行处已无苔。",
        "劝酒客初醉，留茶僧未来。",
        "每逢晴暖日，惟见乞花栽。",
        "门不当官道，行人到亦稀。",
        "故从餐后出，多是夜深归。",
        "开箧收诗卷，扫床移卧衣。",
        "几时同买宅，相送有柴扉。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361587,
      "title": "送雍陶入蜀",
      "content": [
        "江山事若谙，那肯滞云南。",
        "草色分危磴，杉阴近古潭。",
        "日斜褒谷鸟，夏浅巂州蚕。",
        "吾自疑双鬓，相逢更不堪。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 361588,
      "title": "张郎中过原东居",
      "content": [
        "年长惟添懒，经旬止掩关。",
        "高人餐药后，下马此林间。",
        "对坐天将暮，同来客亦闲。",
        "几时能重至，水味似深山。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 361589,
      "title": "答王建秘书",
      "content": [
        "人皆闻蟋蟀，我独恨蹉跎。",
        "白发无心镊，青山去意多。",
        "信来漳浦岸，期负洞庭波。",
        "时扫高槐影，朝回或恐过。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 361590,
      "title": "送李余往湖南",
      "content": [
        "昔去候温凉，秋山满楚乡。",
        "今来从辟命，春物遍涔阳。",
        "岳石挂海雪，野枫堆渚樯。",
        "若寻吾祖宅，寂寞在潇湘。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 361593,
      "title": "寄顾非熊",
      "content": [
        "知君归有处，山水亦难齐。",
        "犹去潇湘远，不闻猿狖啼。",
        "穴通茆岭下，潮满石头西。",
        "独立生遥思，秋原日渐低。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 361595,
      "title": "送慈恩寺霄韵法师谒太原李司空",
      "content": [
        "何故谒司空，云山知几重。",
        "碛遥来雁尽，雪急去僧逢。",
        "清磬先寒角，禅灯彻晓烽。",
        "旧房闲片石，倚著最高松。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 361597,
      "title": "送惠雅法师归玉泉",
      "content": [
        "只到潇湘水，洞庭湖未游。",
        "饮泉看月别，下峡听猿愁。",
        "讲不停雷雨，吟当近海流。",
        "降霜归楚夕，星冷玉泉秋。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 361599,
      "title": "题张博士新居",
      "content": [
        "青枫何不种，林在洞庭村。",
        "应为三湘远，难移万雷根。",
        "斗牛初过伏，菡萏欲香门。",
        "旧即湖山隐，新庐葺此原。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 361600,
      "title": "石门陂留辞从叔谟",
      "content": [
        "幽鸟飞不远，此行千里间。",
        "寒冲陂水雾，醉下菊花山。",
        "有耻长为客，无成又入关。",
        "何时临涧柳，吾党共来攀。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 361602,
      "title": "怀博陵故人",
      "content": [
        "孤城易水头，不忘旧交游。",
        "雪压围棋石，风吹饮酒楼。",
        "路遥千万里，人别十三秋。",
        "吟苦相思处，天寒水急流。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 361605,
      "title": "孟融逸人",
      "content": [
        "孟君临水居，不食水中鱼。",
        "衣褐唯粗帛，筐箱只素书。",
        "树林幽鸟恋，世界此心疏。",
        "拟棹孤舟去，何峰又结庐。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 361606,
      "title": "晚晴见终南诸峰",
      "content": [
        "秦分积多峰，连巴势不穷。",
        "半旬藏雨里，此日到窗中。",
        "圆魄将升兔，高空欲叫鸿。",
        "故山思不见，碣石泬寥东。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 361610,
      "title": "送李溟谒宥州李权使君",
      "content": [
        "英雄典宥州，迢递苦吟游。",
        "风宿骊山下，月斜灞水流。",
        "去时初落叶，回日定非秋。",
        "太守携才子，看鹏百尺楼。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 361614,
      "title": "送徐员外赴河中",
      "content": [
        "原野正萧瑟，中间分散情。",
        "吏从甘扈罢，诏许朔方行。",
        "边日沉残角，河关截夜城。",
        "云居闲独往，长老出房迎。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 361616,
      "title": "送令狐绹相公",
      "content": [
        "梁园趋戟节，海草几枯春。",
        "风水难遭便，差池未振鳞。",
        "姓名犹语及，门馆阻何因。",
        "苦拟修文卷，重擎献匠人。",
        "吟看青岛处，朝退赤墀晨。",
        "根爱杉栽活，枝怜雪霰新。",
        "缀篇嗟调逸，不和揣才贫。",
        "早晚还霖雨，滂沱洗月轮。",
        "揠苗方灭裂，成器待陶钧。",
        "困阪思回顾，迷邦辄问津。",
        "数行望外劄，绝句握中珍。",
        "是日荣游汴，当时怯往陈。",
        "鸿舂乖汉爵，桢病卧漳滨。",
        "岳整五千仞，云惟一片身。",
        "故山离未死，秋水宿经旬。",
        "下第能无恧，高科恐有神。",
        "罢耕田料废，省钓岸应榛。",
        "慷慨知音在，谁能泪堕巾。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361617,
      "title": "寄沧州李尚书",
      "content": [
        "沧溟深绝阔，西岸郭东门。",
        "戈者罗夷鸟，桴人思峤猿。",
        "威棱高腊冽，煦育极春温。",
        "陂淀封疆内，蒹葭壁垒根。",
        "摇鞞边地脉，愁箭虎狼魂。",
        "水县卖纱市，盐田煮海村。",
        "枝条分御叶，家世食唐恩。",
        "武可纵横讲，功从战伐论。",
        "天涯生月片，屿顶涌泉源。",
        "非是泥池物，方因雷雨尊。",
        "沉谋藏未露，邻境帖无喧。",
        "青冢骄回鹘，萧关陷叶蕃。",
        "何时霖岁旱，早晚雪邦冤。",
        "迢递瞻旌纛，浮阳寄咏言。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361620,
      "title": "送李傅侍郎剑南行营",
      "content": [
        "走马从边事，新恩受外台。",
        "勇看双节出，期破八蛮回。",
        "许国家无恋，盘江栈不摧。",
        "移军刁斗逐，报捷剑门开。",
        "角咽猕猴叫，鼙干霹雳来。",
        "去年新甸邑，犹滞佐时才。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361625,
      "title": "子规",
      "content": [
        "游魂自相叫，宁复记前身。",
        "飞过邻家月，声连野路春。",
        "梦边催晓急，愁处送风频。",
        "自有沾花血，相和雨滴新。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 361626,
      "title": "送僧归天台",
      "content": [
        "辞秦经越过，归寺海西峰。",
        "石涧双流水，山门九里松。",
        "曾闻清禁漏，却听赤城钟。",
        "妙宇研磨讲，应齐智者踪。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 361627,
      "title": "让纠曹上乐使君",
      "content": [
        "战战复兢兢，犹如履薄冰。",
        "虽然叨一掾，还似说三乘。",
        "瓶汲南溪水，书来北岳僧。",
        "戆愚兼抱疾，权纪不相应。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 361629,
      "title": "送雍陶及第归成都宁亲",
      "content": [
        "不唯诗著籍，兼又赋知名。",
        "议论于题称，春秋对问精。",
        "半应阴骘与，全赖有司平。",
        "归去峰峦众，别来松桂生。",
        "涨江流水品，当道白云坑。",
        "勿以攻文捷，而将学剑轻。",
        "制衣新濯锦，开酝旧烧罂。",
        "同日升科士，谁同膝下荣。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361638,
      "title": "酬厉玄",
      "content": [
        "我来从北鄙，子省涉西陵。",
        "白发初相识，秋山拟共登。",
        "邻居帝城雨，会宿御沟冰。",
        "未报见贻作，耿然中夜兴。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 361639,
      "title": "送刘式洛中觐省",
      "content": [
        "晴峰三十六，侍立上春台。",
        "同宿别离恨，共看星月回。",
        "野莺临苑语，河棹历江来。",
        "便寄相思劄，缄封花下开。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 361640,
      "title": "送空公往金州",
      "content": [
        "七百里山水，手中楖栗粗。",
        "松生师坐石，潭涤祖传盂。",
        "长拟老岳峤，又闻思海湖。",
        "惠能同俗姓，不是岭南卢。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
