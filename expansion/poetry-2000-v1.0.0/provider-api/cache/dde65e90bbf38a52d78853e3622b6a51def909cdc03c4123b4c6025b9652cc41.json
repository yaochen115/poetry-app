{
  "data": [
    {
      "id": 284874,
      "title": "商于驿楼东望有感",
      "content": [
        "山川去接汉江东，曾伴隋侯醉此中。",
        "歌绕夜梁珠宛转，舞娇春席雪朦胧。",
        "棠遗善政阴犹在，薤送哀声事已空。",
        "惆怅知音竟难得，两行清泪白杨风。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 284875,
      "title": "寄南城韦逸人",
      "content": [
        "杜甫诗中韦曲花，至今无赖尚豪家。",
        "美人晓折露沾袖，公子醉时香满车。",
        "万里丹青传不得，二年风雨恨无涯。",
        "羡他南涧高眠客，春去春来任物华。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 284876,
      "title": "梅花",
      "content": [
        "吴王醉处十余里，照野拂衣今正繁。",
        "经雨不随山鸟散，倚风疑共路人言。",
        "愁怜粉艳飘歌席，静爱寒香扑酒罇。",
        "欲寄所思无好信，为人惆恨又黄昏。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 284877,
      "title": "淮南高骈所造迎仙楼",
      "content": [
        "鸾音鹤信杳难回，凤驾龙车早晚来。",
        "仙境是谁知处所，人间空自造楼台。",
        "云侵朱槛应难到，虫网闲窗永不开。",
        "子细思量成底事，露凝风摆作尘埃。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 284878,
      "title": "和禅月大师见赠",
      "content": [
        "高僧惠我七言诗，顿豁尘心展白眉。",
        "秀似谷中花媚日，清如潭底月圆时。",
        "应观法界莲千叶，肯折人间桂一枝。",
        "漂荡秦吴十余载，因循犹恨识师迟。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 284879,
      "title": "谒文宣王庙",
      "content": [
        "晚来乘兴谒先师，松柏凄凄人不知。",
        "九仭萧墙堆瓦砾，三间茅殿走狐狸。",
        "雨淋状似悲麟泣，露滴还同叹凤悲。",
        "傥使小儒名稍立，岂教吾道受栖迟。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 284880,
      "title": "代文宣王答",
      "content": [
        "三教之中儒最尊，止戈为武武尊文。",
        "吾今尚自披蓑笠，你等何须读典坟。",
        "释氏宝楼侵碧汉，道家宫殿拂青云。",
        "若教颜闵英灵在，终不羞他李老君。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 284881,
      "title": "重送朗州张员外",
      "content": [
        "朱轮此去正春风，且驻青云听断蓬。",
        "一榻早年容孺子，双旌今日别文翁。",
        "诚知汲善心长在，争奈干时迹转穷。",
        "酬德酬恩两无路，谩劳惆怅凤城东。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 284882,
      "title": "广陵秋夜读进士常修三篇因题",
      "content": [
        "入蜀归吴三首诗，藏于笥箧重于师。",
        "劒关夜读相如听，瓜步秋吟炀帝悲。",
        "景物也知输健笔，时情谁不许高枝。",
        "明年二月春风里，江岛闲人慰所思。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 284883,
      "title": "逼试投所知",
      "content": [
        "桃在仙翁旧苑傍，暖烟轻霭扑人香。",
        "十年此地频偷眼，二月春风最断肠。",
        "曾恨梦中无好事，也知囊里有仙方。",
        "寻思仙骨终难得，始与回头问玉皇。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 284884,
      "title": "汉江上作",
      "content": [
        "汉江波浪渌于苔，每到江边病眼开。",
        "半雨半风终日恨，无名无迹几时回。",
        "云生岸谷秋阴合，树接帆樯晚思来。",
        "对此空惭圣明代，忍教缨上有尘埃。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 284885,
      "title": "秋夜寄进士顾荣",
      "content": [
        "秋河耿耿夜沈沈，往事三更尽到心。",
        "多病谩劳窥圣代，薄才终是费知音。",
        "家山梦后帆千尺，尘土搔来髪一簪。",
        "空羡良朋尽高价，可怜东箭与南金。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 284886,
      "title": "寄渭北徐从事",
      "content": [
        "暖云慵堕柳垂条，骢马徐郎过渭桥。",
        "官秩旧参荀秘监，罇罍今伴霍嫖姚。",
        "科随鹄箭频曾中，礼向侯弓以重招。",
        "莫恨东风促行李，不多时节却归朝。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 284887,
      "title": "徐寇南逼感事献江南知己次韵",
      "content": [
        "酒阑离思浩无穷，西望维扬忆数公。",
        "万里飘零身未了，一家知奖意曾同。",
        "云横晋国尘应暗，路转吴江信不通。",
        "今日便成卢子谅，满襟珠泪堕霜风。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 284888,
      "title": "寄三衢孙员外",
      "content": [
        "小敷文伯见何时，南望三衢渴复饥。",
        "天子未能崇典诰，诸生徒欲恋旌旗。",
        "风高绿野苗千顷，露冷平楼酒满巵。",
        "尽是数旬陪奉处，使君争肯不相思。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 284889,
      "title": "淮南送卢端公归台",
      "content": [
        "凤鸾势逸九霄宽，北去南来任羽翰。",
        "朱绂两参王俭府，绣衣三领杜林官。",
        "道从上国曾匡济，才向牢盆始重难。",
        "应笑张纲谩生事，埋轮不得在长安。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 284890,
      "title": "炀帝陵",
      "content": [
        "入郭登桥出郭船，红楼日日柳年年。",
        "君王忍把平陈业，只博雷塘数亩田。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 284891,
      "title": "马嵬坡",
      "content": [
        "佛屋前头野草春，贵妃轻骨此为尘。",
        "从来绝色知难得，不破中原未是人。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 284892,
      "title": "柳",
      "content": [
        "灞岸晴来送别频，相偎相倚不胜春。",
        "自家飞絮犹无定，争解垂丝绊路人。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 284893,
      "title": "隋堤柳",
      "content": [
        "夹路依依千里遥，路人回首认隋朝。",
        "春风未借宣华意，犹费工夫长绿条。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 284894,
      "title": "孟浩然墓",
      "content": [
        "数步荒榛接旧蹊，寒江漠漠草凄凄。",
        "鹿门黄土无多少，恰到书生冢便低。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 284895,
      "title": "秦纪",
      "content": [
        "长策东鞭及海隅，鼋鼍奔起鬼神趋。",
        "怜君未到沙丘日，肯信人间有死无。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 284896,
      "title": "仙掌",
      "content": [
        "掌前流水驻无尘，掌下轩车日日新。",
        "谩向山头高举手，何曾招得路行人。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 284897,
      "title": "咏月",
      "content": [
        "湖上风高动白苹，暂延清景此逡巡。",
        "隔年违别成何事，半夜相看似故人。",
        "蟾向静中矜爪距，兔隈明处弄精神。",
        "嫦娥老大应惆怅，倚泣苍苍桂一轮。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 284898,
      "title": "宿荆州江陵驿",
      "content": [
        "西游象阙媿知音，东下荆溪称越吟。",
        "风动芰荷香四散，月明楼阁影相侵。",
        "闲欹别枕千般梦，醉送征帆万里心。",
        "薜荔衣裳木兰檝，异时烟雨好追寻。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 284899,
      "title": "抚州别阮兵曹",
      "content": [
        "雪晴天外见诸峰，幽轧行轮有去踪。",
        "内史宅边今独恨，步兵厨畔旧相容。",
        "十年别鬓疑朝镜，千里归心著晚钟。",
        "若不他时更青眼，未知谁肯荐临邛。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 284900,
      "title": "新安投所知",
      "content": [
        "少年容易舍樵渔，曾辱明公荐子虚。",
        "汉殿寒夜时不食，宋都风急命何疎。",
        "云埋野艇吟归去，草没山田赋遂初。",
        "长劒一寻歌一奏，此心争肯为鲈鱼。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 284901,
      "title": "江边有寄",
      "content": [
        "江边旧业半雕残，每轸归心即万端。",
        "狂折野梅山店暖，醉吹村笛酒楼寒。",
        "只言圣代谋身易，争奈贫儒得路难。",
        "同病同忧更何事，为君提笔画渔竿。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 284902,
      "title": "送友人归夷门",
      "content": [
        "二年流落大梁城，每送君归即有情。",
        "别路算来成底事，旧游言著似前生。",
        "苑荒嬾认词人会，门在空怜烈士名。",
        "至竟男儿分应定，不须惆怅谷中莺。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 284903,
      "title": "湘中见进士乔诩",
      "content": [
        "吴公台下别经秋，破虏城边暂驻留。",
        "一笑有情堪解梦，数年无故不同游。",
        "云牵楚思横鱼艇，柳送乡心入酒楼。",
        "且酌松醪依旧醉，谁能相见向春愁。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 284904,
      "title": "上霅川裴郎中",
      "content": [
        "贵提金印出咸秦，潇洒江城两度春。",
        "一派水清疑见胆，数重山翠欲留人。",
        "望崇早合归黄阁，诗好何妨恋白苹。",
        "自是受恩心未足，却垂双翅羡吴均。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 284905,
      "title": "钱塘江潮",
      "content": [
        "怒声汹汹势悠悠，罗刹江边地欲浮。",
        "漫道往来存大信，也知反复向平流。",
        "任抛巨浸疑无底，猛过西陵只有头。",
        "至竟朝昏谁主掌，好骑赪鲤问阳侯。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 284906,
      "title": "送人赴职任褒中",
      "content": [
        "物态时情难重陈，夫君此去莫伤春。",
        "男儿只要有知己，才子何堪更问津。",
        "万转江山通蜀国，两行珠翠见褒人。",
        "海棠花谢东风老，应念京都共苦辛。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 284907,
      "title": "临川投穆中丞",
      "content": [
        "试将生计问蓬根，心委寒灰首戴盆。",
        "翅弱未知三岛路，舌顽虚掉五侯门。",
        "啸烟白狖沈高木，捣月清砧触旅魂。",
        "家在碧江归不得，十年鱼艇长苔痕。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 284908,
      "title": "早春送张坤归大梁",
      "content": [
        "萧萧羸马正尘埃，又送輶轩向吹台。",
        "别酒莫辞今夜醉，故人知是几时回。",
        "泉经华岳犹应冻，花到梁园始合开。",
        "为谢东门抱关吏，不堪惆怅满离杯。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 284909,
      "title": "东归途中作",
      "content": [
        "松橘苍黄覆钓矶，早年生计近年违。",
        "老知风月终堪恨，贫觉家山不易归。",
        "别岸客帆和鴈落，晚程霜叶向人飞。",
        "买臣严助精灵在，应笑无成一布衣。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 284910,
      "title": "送进士臧𣸣下第后归池州",
      "content": [
        "赋成无处换黄金，却向春风动越吟。",
        "天子爱才虽仄席，诸生多病又沾襟。",
        "柳攀灞岸狂遮袂，水忆池阳渌满心。",
        "珍重彩衣归正好，莫将闲事系升沈。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 284911,
      "title": "湘中赠范郧",
      "content": [
        "丹桂无心彼此谙，二年疎嬾共江潭。",
        "愁知酒醆终难舍，老觉人情转不堪。",
        "云外鸳鸯非故旧，眼前胶漆似烟岚。",
        "劳歌一曲霜风暮，击折湘妃白玉簪。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 284912,
      "title": "寄张侍郎",
      "content": [
        "衰羸岂合话荆州，争奈思多不自由。",
        "无路重趋桓典马，有诗曾上仲宣楼。",
        "尘销别迹堪垂泪，树拂他门嬾举头。",
        "一种人间太平日，独教零落忆沧州。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 284913,
      "title": "渚宫秋思",
      "content": [
        "楚城日暮烟霭深，楚人驻马还登临。",
        "襄王台下水无赖，神女庙前云有心。",
        "千载是非难重问，一江风雨好闲吟。",
        "欲招屈宋当时魄，兰败荷枯不可寻。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 284914,
      "title": "闲居早秋",
      "content": [
        "槐杪清蝉烟雨余，萧萧凉叶堕衣裾。",
        "噪槎乌散沈苍岭，弄杵风高上碧虚。",
        "百岁梦生悲蛱蜨，一朝香死泣芙蕖。",
        "六宫谁买相如赋，团扇恩情日日疎。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 284915,
      "title": "建康",
      "content": [
        "潮平远岸草侵沙，东晋衰来最可嗟。",
        "庾舅已能窥帝室，王都还是预人家。",
        "山寒老树啼风曲，泉暖枯骸动芷牙。",
        "欲起九原看一徧，秦淮声急日西斜。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 284916,
      "title": "送舒州宿松县傅少府",
      "content": [
        "江蓠漠漠树重重，东过清淮到宿松。",
        "县好也知临浣水，官闲应得看灊峰。",
        "春风绿野吴歌怨，雪霁平郊楚酒浓。",
        "留取余杯待张翰，明年归棹一从容。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 284917,
      "title": "经故洛阳城",
      "content": [
        "败垣危堞迹依稀，试驻羸骖吊落晖。",
        "跋扈以成梁冀在，简书难问杜乔归。",
        "由来世事须翻覆，未必余才解是非。",
        "千载昆阳好功业，与君门下作恩威。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 284918,
      "title": "夏州胡常侍",
      "content": [
        "百尺高台勃勃州，大刀长戟汉诸侯。",
        "征鸿过尽边云阔，战马闲来塞草秋。",
        "国计已推肝胆许，家财不为子孙谋。",
        "仍闻陇蜀由多事，深喜将军未白头。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 284919,
      "title": "寄进士卢休",
      "content": [
        "半年池口恨萍蓬，今日思量已梦中。",
        "游子马蹄难重到，故人尊酒与谁同。",
        "山横翠后千重绿，蜡想歌时一烬红。",
        "从此客程君不见，麦秋梅雨徧江东。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 284920,
      "title": "赠先辈令狐补阙",
      "content": [
        "中间声迹早薰然，阻避钧衡过十年。",
        "碧海浪高终济物，苍梧云好已归天。",
        "花迎彩服离莺谷，柳傍东风触马鞭。",
        "应念凄凉洞庭客，夜深双泪忆渔船。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 284921,
      "title": "送秦州从事",
      "content": [
        "一枝何足解人愁，抛却还随定远侯。",
        "紫陌红尘今别恨，九衢双阙夜同游。",
        "芳时易失劳行止，良会难期且驻留。",
        "若到边庭有来使，试批书尾话梁州。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 284922,
      "title": "湖州裴郎中赴阙后投简寄友生",
      "content": [
        "锦帐郎官塞诏年，汀州曾驻木兰船。",
        "祢衡酒醒春瓶倒，柳恽诗成海月圆。",
        "歌蹙远山珠滴滴，漏催香烛泪涟涟。",
        "使君入拜吾徒在，宣室他时岂偶然。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 284923,
      "title": "秋日泊平望驿寄太常裴郎中",
      "content": [
        "苹洲重到杳难期，西倚邮亭忆往时。",
        "北海尊中常有酒，东阳楼上岂无诗。",
        "地清每负生灵望，官重方升礼乐司。",
        "闻说江南旧歌曲，至今犹自唱吴姬。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 284924,
      "title": "西塞山",
      "content": [
        "吴塞当时指此山，吴都亡后绿孱颜。",
        "岭梅乍暖残妆恨，沙鸟初晴小队闲。",
        "波阔鱼龙应混杂，壁危猿狖奈奸顽。",
        "会将一副寒蓑笠，来与渔翁作往还。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 284925,
      "title": "秋日汴河客舍酬友人",
      "content": [
        "梁宋追游早岁同，偶然违别事皆空。",
        "年如流水催何急，道似危途动即穷。",
        "醉舞且欣连夜月，狂吟还聚上楼风。",
        "烦君更枉骚人句，白凤灵虵满袖中。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 284926,
      "title": "东归",
      "content": [
        "仙桂高高似有神，貂裘敝尽取无因。",
        "难将白发期公道，不觉丹枝属别人。",
        "双阙往来慙请谒，五湖归后耻交亲。",
        "盈盘紫蟹千巵酒，添得临岐泪满巾。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 284927,
      "title": "广陵李仆射借示近诗因投献",
      "content": [
        "朝论国计暮论兵，余力犹随凤藻生。",
        "语继盘盂抛俗格，气兼河岳带商声。",
        "闲寻绮思千花丽，静想高吟六义清。",
        "天柄已持尧典在，更堪回首问缘情。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 284928,
      "title": "三衢哭孙员外",
      "content": [
        "燕恋雕梁马恋轩，此心从此更何言。",
        "直将尘外三生命，未敌君侯一日恩。",
        "红蜡有时还入梦，片帆何处独销魂？",
        "忍看明发衣襟上，珠泪痕中见酒痕。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 284929,
      "title": "箧中得故王郎中书",
      "content": [
        "凤里前年别望郎，丁宁唯恐滞吴乡。",
        "劝疎杯酒知妨事，乞与书题作裹粮。",
        "苹鹿未能移海曲，县花寻已落河阳。",
        "九原自此无因见，反复遗踪泪万行。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 284930,
      "title": "泪",
      "content": [
        "逼脸横颐咽复匀，也曾谗毁也伤神。",
        "自从鲁国潸然后，不是奸人即妇人。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 284931,
      "title": "子规",
      "content": [
        "铜梁路远草青青，此恨那堪枕上听。",
        "一种有冤犹可报，不如衔石叠沧溟。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 284932,
      "title": "姑苏台",
      "content": [
        "让高泰伯开基日，贤见延陵复命时。",
        "未会子孙因底事，解崇台榭为西施。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 284933,
      "title": "王濬墓",
      "content": [
        "男儿未必尽英雄，但到时来即命通。",
        "若使吴都犹王气，将军何处立殊功。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 284934,
      "title": "京中晚望",
      "content": [
        "心如野鹿迹如萍，谩向人间性一灵。",
        "往事不知多少梦，夜来和酒一时醒。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 284935,
      "title": "寄窦泽处士二首 一",
      "content": [
        "兰亭醉客旧知闻，欲问平安隔海云。",
        "不是金陵钱太尉，世事谁肯更容身。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 284936,
      "title": "寄窦泽处士二首 二",
      "content": [
        "鼇背楼台拂白榆，此中槎客亦踟蹰。",
        "牢山道士无仙骨，却向人间作酒徒。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 284937,
      "title": "省试秋风生桂枝",
      "content": [
        "凉吹从何起，中宵景象清。",
        "漫随云叶动，高傍桂枝生。",
        "漠漠看无际，萧萧别有声。",
        "远吹斜汉转，低拂白榆轻。",
        "寥泬工夫大，乾坤岁序更。",
        "因悲远归客，长望一枝荣。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 284938,
      "title": "思故人",
      "content": [
        "故人不可见，聊复拂鸣琴。",
        "鹊绕风枝急，萤藏露草深。",
        "平生四方志，此夜五湖心。",
        "惆怅友朋尽，洋洋漫好音。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 284939,
      "title": "寄陆龟蒙",
      "content": [
        "龙楼李丞相，昔岁仰高文。",
        "黄阁寻无主，青山竟未焚。",
        "夜船乘海月，秋寺伴江云。",
        "却恐尘埃里，浮名点污君。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 284940,
      "title": "题方干诗",
      "content": [
        "中间李建州，夏汭偶同游。",
        "顾我论佳句，推君最上流。",
        "九霄无鹤板，双鬓老渔舟。",
        "世难方如此，何当浣旅愁。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 284941,
      "title": "秋江",
      "content": [
        "秋江待晚潮，客归斾旌摇。",
        "细雨翻芦叶，高风却柳条。",
        "兵戈村落破，饥俭虎狼骄。",
        "吾土兼连此，离魂望里消。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 284942,
      "title": "寄制诰李舍人",
      "content": [
        "梁王握豹韬，雪里见枚臯。",
        "上客趋丹陛，游人叹二毛。",
        "门闲知待诏，星动想濡毫。",
        "一首长杨赋，应嫌索价高。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 284943,
      "title": "秋日怀孟夷庚",
      "content": [
        "秋日黄陂下，孤舟忆共谁。",
        "江山三分楚，风雨二妃祠。",
        "知己秦貂没，流年贾𫛳悲。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 284944,
      "title": "送李右丞分司",
      "content": [
        "分漕得洛川，谠议更昭然。",
        "在省曾批敕，中台肯避权。",
        "所悲时渐薄，共贺道由全。",
        "卖与清平代，相兼直几钱。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 284945,
      "title": "郴江迁客",
      "content": [
        "不是逢清世，何由见皂囊。",
        "事虽危虎尾，名胜泊鹓行。",
        "毒雾郴江阔，愁云楚驿长。",
        "归时有诗赋，一为吊沈湘。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 284946,
      "title": "感旧",
      "content": [
        "劒佩孙弘阁，戈鋋太尉营。",
        "重言虚有位，孤立竟无成。",
        "丘陇笳箫咽，池台岁月平。",
        "此恩何以报，归处是柴荆。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 284947,
      "title": "鹰",
      "content": [
        "越海霜天暮，辞韬野草干。",
        "俊通司隶职，严奉武夫官。",
        "眼恶藏蜂在，心麤逐物殚。",
        "近来脂腻足，驱遣不妨难。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 284948,
      "title": "秋日寄狄补阙",
      "content": [
        "红尘扰扰间，立马看南山。",
        "谩道经年往，何妨逐日闲。",
        "病中霜叶赤，愁里鬓毛斑。",
        "不为良知在，驱车已出关。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 284949,
      "title": "寄易定公乘亿侍郎",
      "content": [
        "谢舞仍宫柳，高奇世少双。",
        "侍中生不到，园令死须降。",
        "班秩通乌府，罇罍奉碧幢。",
        "昭王有余烈，试为祷迷邦。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 284950,
      "title": "寄大理徐郎中",
      "content": [
        "佐棘竟谁同，因思证圣中。",
        "事虽忘显报，理合有阴功。",
        "官序诜枝老，幽尘范甑空。",
        "几时潘好礼，重与话清风。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 284951,
      "title": "寄苏拾遗",
      "content": [
        "早岁长杨赋，当年谏猎书。",
        "格高时辈伏，言数宦情疎。",
        "慷慨传丹桂，艰难保旧居。",
        "退朝观藁草，能望马相如。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 284952,
      "title": "寄许融",
      "content": [
        "多病仍疎拙，唯君与我同。",
        "帝乡年共老，江徼业俱空。",
        "燕冷辞华屋，蛩凉恨晓丛。",
        "白云高几许，全属采芝翁。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 284953,
      "title": "寄礼部郑员外",
      "content": [
        "栾郄门风大，裴王礼乐优。",
        "班资冠鸡舌，人品压龙头。",
        "夜直炉香细，晴编疏草稠。",
        "近闻潘散骑，三十二悲秋。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 284954,
      "title": "菊",
      "content": [
        "篱落岁云暮，数枝聊自芳。",
        "雪裁纤蘂密，金拆小苞香。",
        "千载白衣酒，一生青女霜。",
        "春丛莫轻薄，彼此有行藏。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 284955,
      "title": "台城",
      "content": [
        "水国春常在，台城夜未寒。",
        "丽华承宠渥，江令捧杯盘。",
        "宴罢明堂烂，诗成宝炬残。",
        "兵来吾有计，金井玉钩栏。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 284956,
      "title": "旧游",
      "content": [
        "良时不复再，渐老更难言。",
        "远水犹经眼，高楼似断魂。",
        "依依宋玉宅，历历长卿村。",
        "今日空江畔，相于只酒樽。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 284957,
      "title": "寄虔州薛大夫",
      "content": [
        "祝融峰下别，三载梦魂劳。",
        "地转南康重，官兼亚相高。",
        "海鹏终负日，神马背眠槽。",
        "会得窥成绩，幽窗染兔毫。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 284958,
      "title": "苏小小墓",
      "content": [
        "魂兮檇李城，犹未有人耕。",
        "好月当年事，残花触处情。",
        "向谁曾艳冶，随分得声名。",
        "应侍吴王宴，兰桡暗送迎。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 284959,
      "title": "寒食日早出城东",
      "content": [
        "青门欲曙天，车马已喧阗。",
        "禁柳疎风雨，墙花拆露鲜。",
        "向谁夸丽景，只是叹流年。",
        "不得高飞便，回头望纸鸢。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 284960,
      "title": "秋日怀贾随进士",
      "content": [
        "边寇日骚动，故人音信稀。",
        "长缨慙贾谊，孤愤忆韩非。",
        "晓匣鱼肠冷，春园鸭掌肥。",
        "知君安未得，聊且示忘机。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 284961,
      "title": "乱后逢友人",
      "content": [
        "沧海去未得，倚舟聊问津。",
        "生灵寇盗尽，方镇改更贫。",
        "梦里旧行处，眼前新贵人。",
        "从来事如此，君莫独霑巾。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 284962,
      "title": "残花",
      "content": [
        "已叹良时晚，仍悲别酒催。",
        "暖芳随日薄，轻片逐风回。",
        "黛敛愁歌扇，妆残泣镜台。",
        "繁阴莫矜衒，终是共尘埃。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 284963,
      "title": "秋日富春江行",
      "content": [
        "远岸平如翦，澄江静似铺。",
        "紫鳞仙客驭，金颗李衡奴。",
        "冷叠群山阔，清涵万象殊。",
        "严陵亦高见，归卧是良图。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 284964,
      "title": "寄侯博士",
      "content": [
        "规谏扬雄赋，邅回贾谊官。",
        "久贫还往少，孤立转迁难。",
        "清镜流年急，高槐旅舍寒。",
        "侏儒亦何有，饱食向长安。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 284965,
      "title": "送沈光侍御赴职闽中",
      "content": [
        "未至应居右，全家出帝乡。",
        "礼优逢苑雪，官重带台霜。",
        "夜浦吴潮吼，春滩建水狂。",
        "延平有风雨，从此是腾骧。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 284966,
      "title": "寄袁皓侍郎",
      "content": [
        "东台失路岐，荣辱事堪悲。",
        "我寝牛衣敝，君居豸角危。",
        "风尘慙上品，才业愧明时。",
        "千里芙蓉幕，何由话所思。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 284967,
      "title": "寄金吾李荪常侍",
      "content": [
        "西班掌禁兵，兰锜最分明。",
        "晓色严天仗，春寒避火城。",
        "安危虽已任，韬略即嘉声。",
        "请问何功德，壶关寇始平。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 284968,
      "title": "商于驿与于蕴玉话别",
      "content": [
        "南朝徐庾流，洛下忆同游。",
        "酒采闲坊菊，山登远寺楼。",
        "相思劳寄梦，偶别已经秋。",
        "还被青青桂，催君不自由。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 284969,
      "title": "封禅寺居",
      "content": [
        "盛礼何由覩，嘉名偶寄居。",
        "周南太史泪，蛮徼长卿书。",
        "砌竹摇风直，庭花泣露疎。",
        "谁能赋秋兴，千里隔吾庐。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 284970,
      "title": "钱",
      "content": [
        "志士不敢道，贮之成祸胎。",
        "小人无事艺，假尔作梯媒。",
        "解释愁肠结，能分睡眼开。",
        "朱门狼虎性，一半逐君回。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
