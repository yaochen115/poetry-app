{
  "data": [
    {
      "id": 188043,
      "title": "再次元韵答几道",
      "content": [
        "尘嚣摆落到鸿冥，始见当时遁世英。",
        "丛棘敢思丹鳯至，寸筳惭叩巨钟鸣。",
        "须知奔竞浮荣路，未若喧传不朽声。",
        "此道固为流俗笑，苟非夫子欲谁明。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 188044,
      "title": "谢几道见示佳什因次元韵二首  其一",
      "content": [
        "曾酬唱和向家溪，嫫母终惭敌艶妻。",
        "岂意误将三献玉，翻来轻博一丸泥。",
        "利能绝地同庄剑，巧可凌云上鲁梯。",
        "巾衍珍藏虽已固，祗愁飞去化为霓。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 188045,
      "title": "谢几道见示佳什因次元韵二首  其二",
      "content": [
        "篇篇光绝夺春华，中有纯音正不邪。",
        "跛鼈久惭追骏足，降旗今巳怯崇牙。",
        "清新格调空吟讽，猥冗言辞自咄嗟。",
        "为我指迷终有得，曲蓬从此长丛麻。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 188046,
      "title": "偶占",
      "content": [
        "卒卒往来舟，翻翻逐利谋。",
        "中流谁自溺，方去不回头。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 188047,
      "title": "思归",
      "content": [
        "平生孤愤自潸然，不作春蠺但食眠。",
        "干禄有心羞枉道，无田虚日望丰年。",
        "每将浩叹期黄卷，已许多忧竞白颠。",
        "旧笑古人轻独往，近来还自忆林泉。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 188048,
      "title": "秋日感愤二首  其一",
      "content": [
        "击剑髙歌四顾遐，男儿何事系如瓜。",
        "蛟龙不是池中物，燕雀乌知陇上嗟。",
        "命有傥来犹未耳，天徒生我使穷耶。",
        "谢安未是才难者，底事苍生却盛夸。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 188049,
      "title": "秋日感愤二首  其二",
      "content": [
        "坐睨归鸿起自嗟，西风吹落泪痕斜。",
        "聚书老懒堆尘楮，秋剑寒酸蛰鐡蛇。",
        "自是卧龙犹戢角，浪嗟穴虎向生牙。",
        "从来思掷班佣笔，况是西山旧有家。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 188050,
      "title": "袭袭",
      "content": [
        "袭袭前修与后生，要言髙爵是身荣。",
        "却将猎较诬师圣，不见三年学有成。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 188051,
      "title": "病中",
      "content": [
        "十日身无一日宁，病源知向百忧生。",
        "寒侵骐骥应方瘦，蠧满楩楠岂易荣。",
        "小阁昼闲书帙乱，画堂风静药罗声。",
        "北山扶杖终归去，寄语嵒猿莫晓惊。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 188052,
      "title": "寄介甫",
      "content": [
        "已推事业皆归命，空有文章自满家。",
        "借使牛羊虽有责，岂于鳯鸟独无嗟。",
        "人留孟子皆非道，客议扬雄正自哗。",
        "贤哲相望每千古，得逢犹说与时差。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 188053,
      "title": "上杭帅吕舍人",
      "content": [
        "玉海澄中粹，金山拔外佳。",
        "无前谁与敌，独进不容偕。",
        "列象明星璧，遗思结馆娃。",
        "一麾迎日下，四海望霖乖。",
        "今见询佥允，从来注意谐。",
        "推沟常己任，济域定民皆。",
        "富裕吴中俗，优游治外怀。",
        "樽环常满客，醉拥坐添钗。",
        "贱子儒名业，平生客旁淮。",
        "尘埃方困顿，时命两沉埋。",
        "居拙思营窟，炊穷欲析骸。",
        "毛生祢衡刺，麻繋吕匡鞋。",
        "海远狂图酌，天髙妄欲阶。",
        "请虽非义得，来实为贫嗟。",
        "况是常瞻目，将希未施崖。",
        "虽然愚者虑，庶享恶人斋。",
        "肉骨非难力，铭心谢莫涯。",
        "定须为进互，庶或未愚柴。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 188054,
      "title": "上邵宝文",
      "content": [
        "出处身之道，穷通命所关。",
        "孔犹闻宋逐，轲亦退梁还。",
        "兹道方中否，流风有后艰。",
        "客来方病宪，人戚不堪颜。",
        "士有髙山仰，身尝逸驾攀。",
        "径心思古到，独手欲今扳。",
        "憔悴穷年学，乖疏五两纶。",
        "鱼盐闻古隐，畎亩识今闲。",
        "蹈海时何谓，无田力亦孱。",
        "清醒甘泽畔，富贵奈墦间。",
        "进壮羝羊触，行屯乘马班。",
        "食贫欣道在，愠见笑儿顽。",
        "时已输雌雉，心犹耻瘠环。",
        "偶逢邦有道，喜睠涕无潸。",
        "观水求窥海，知天愿适山。",
        "虽归滕国圣，尚贱许行蛮。",
        "进効无横草，希仁等弃官。",
        "圣门犹进惑，惠政况先鳏。",
        "自道非能赋，几希不敢删。",
        "误知何以报，忠信赤心殷。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 188055,
      "title": "赠致政郭大丞",
      "content": [
        "冠盖冲冲语退居，几人年少褫银鱼。",
        "风波脱去都无累，日月闲来静有余。",
        "一斗独倾花下酒，五车时晒腹中书。",
        "论诗深愧非商也，敢向邱门望起予。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 188056,
      "title": "闲居奉寄几道",
      "content": [
        "门前一径长寒莎，耳冷不闻车马过。",
        "疏竹有风堪待月，空庭无雀可张罗。",
        "道心自觉闲中得，懒性还从病后多。",
        "回首西城望诗老，此心此性复如何。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 188057,
      "title": "慵",
      "content": [
        "衣冠慵整鬂慵梳，万事从来静有余。",
        "却笑嵇康慵未得，区区犹作绝交书。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 188058,
      "title": "金山寺",
      "content": [
        "万顷清江浸碧山，乾坤都向此中寛。",
        "楼台影落鱼龙骇，钟磬声来水石寒。",
        "日暮海门飞白鸟，潮回瓜步见黄滩。",
        "当时户外风波恶，祗得髙僧静处看。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 188059,
      "title": "登甘露寺阁",
      "content": [
        "忽忽劳生岁月催，时偷髙迹出浮埃。",
        "风沾草树红朝动，春入川源绿夜回。",
        "欲出壮怀临八极，可无樽酒到髙台。",
        "江山不与人相语，似待忘言野客来。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 188060,
      "title": "读西汉",
      "content": [
        "汉得孤秦万弊时，当年丞相要无为。",
        "洛阳年少空流涕，谁谓书生果有知。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 188061,
      "title": "读东汉",
      "content": [
        "汉鼎重炎逆血熬，当时天子亦勤劳。",
        "不能乘作唐虞计，未会严陵所谓髙。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 188062,
      "title": "读商君传",
      "content": [
        "利害从来识所存，固难轻重与人论。",
        "赵良不自身为客，刚欲都君使灌园。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 188063,
      "title": "书孔融传",
      "content": [
        "戏拨虎须求不啮，何如缩手袖中归。",
        "虚云坐上客常满，许下惟闻哭习脂。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 188064,
      "title": "武侯",
      "content": [
        "三顾虽然志意深，出非由道此何心。",
        "平时胸腹能多少，且与群儿梁父吟。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 188065,
      "title": "叔孙通",
      "content": [
        "弟子从来学未纯，异时得失亦频频。",
        "一官所买知多少，便议先生作圣人。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 188066,
      "title": "韩吏部",
      "content": [
        "宣尼夹谷叱强齐，吏部深州破贼围。",
        "始信真儒能见用，可为邦国大皇威。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 188067,
      "title": "读老杜诗集",
      "content": [
        "气吞风雅妙无伦，碌碌当年不见珍。",
        "自是古贤因发愤，非关诗道可穷人。",
        "镌镵物象三千首，照耀乾坤四百春。",
        "寂寞有名身后事，惟余孤塜耒江滨。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 188068,
      "title": "读白乐天集",
      "content": [
        "北邙山下一孤坟，流落三千绮丽文。",
        "后世声名髙白日，当年荣利等浮云。",
        "屏除忧愤归禅寂，消遣光阴在酒醺。",
        "若使篇章深李杜，竹符还不到君分。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 188069,
      "title": "过伍子胥庙",
      "content": [
        "西风骚客倦游吴，吊古心怀此暂舒。",
        "鬼箓久应除佞嚭，民思今果庙神胥。",
        "虽然邪正皆归死，奈有忠谗各异书。",
        "回首旧江江水在，怒涛犹是不平初。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 188070,
      "title": "泰伯庙",
      "content": [
        "古庙鬰崔嵬，朱门傃道开。",
        "今人不为让，间或乞灵来。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 188071,
      "title": "和人古剑",
      "content": [
        "安知岁月几经今，传记汗漫不可寻。",
        "得自废墟埋万古，失曾飞将购千金。",
        "客思秋水龙泉冷，士叹中原虎穴深。",
        "好与壮夫同隐约，鐡房寒澁壁尘侵。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 188072,
      "title": "琴二首  其一",
      "content": [
        "古风寥落欲何寻，常记南风素意深。",
        "闻说五弦弦不断，欲于何处借人琴。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 188073,
      "title": "琴二首  其二",
      "content": [
        "不独区区操缦间，要期追逐古风还。",
        "吾民有愠何当解，学得南风不敢弹。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 188074,
      "title": "谢张和仲惠宝云茶",
      "content": [
        "故人有意真怜我，灵荈封题寄荜门。",
        "与疗文园消渇病，还招楚客独醒魂。",
        "烹来似带吴云脚，摘处应无糓雨痕。",
        "果肯同尝竹林下，寒泉应有惠山存。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 188075,
      "title": "和人孤雁",
      "content": [
        "朔碛云深忆旧行，心惊汉月忽骞翔。",
        "江南水濶无天地，漠北沙寒有雪霜。",
        "远目送飞沉暮霭，西风吹影过斜阳。",
        "衡南未到归何日，须信张罗近稻粱。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 188076,
      "title": "雁",
      "content": [
        "万里长为客，飞飞岂自由。",
        "情知稻粱急，莫近网罗求。",
        "关塞风髙夜，江湖水落秋。",
        "哀鸣徒自切，谁谓尔悲愁。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 188077,
      "title": "送雁",
      "content": [
        "来时群雁去相随，病眼看天远不知。",
        "为有客愁归未得，独凴斜日望多时。",
        "迟迟南国无春雪，细细东风满柳枝。",
        "蝴蝶黄莺有期约，好加归翥莫令迟。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 188078,
      "title": "鸦鸣",
      "content": [
        "庭前佳树绿阴成，树抄飞鸦去就轻。",
        "自顾主人无败德，岂嫌尔口有凶声。",
        "平生直道常多祸，两耳清风一听鸣。",
        "輙莫为人轻自重，须知弹射易忘生。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 188079,
      "title": "驯鹿",
      "content": [
        "日日野心新，笼栏外强驯。",
        "祗消指马相，便有逐原人。",
        "昔起歌宾兴，今无伏囿仁。",
        "豺狼好牙爪，应笑角如麟。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 188080,
      "title": "和人放鱼",
      "content": [
        "春溪水暖绿蒲沉，两两游鳞跃紫金。",
        "必以直钩应不得，果知非命亦何心。",
        "舟吞远海鲸鲵老，饵满平湖网罟深。",
        "纵尔岂知吾有意，渭川人去事难寻。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 188081,
      "title": "和人促织",
      "content": [
        "秋虫何尔亦怱怱，何处人心与尔同。",
        "梦枕几年悬客泪，晓窗残月破西风。",
        "人思绝漠冰霜早，妇叹穷阎杼柚空。",
        "更有孤砧共岑寂，平明华髪满青铜。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 188082,
      "title": "闻促织",
      "content": [
        "衰草风来响不知，破窗灯灭月藏辉。",
        "白头老妇无机织，卧听邻儿懒捣衣。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 188083,
      "title": "苦热",
      "content": [
        "土燥木根焦，禽穷自拔毛。",
        "龙遗赤日走，天避火云髙。",
        "虎惧千山炽，鲸忧四海熬。",
        "风微不饱腹，蝉亦为身号。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 188084,
      "title": "和束蒙初九日不见菊登髙",
      "content": [
        "从来秋菊不曾栽，敢向西风怨不开。",
        "我自伤秋有髙兴，非关特为菊花来。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 188085,
      "title": "帘",
      "content": [
        "髙明庭宇好崇基，枉把疏帘窣地垂。",
        "必欲满堂阴有乐，谁能暗室自无欺。",
        "卷舒未必风无意，间隙须防燕解窥。",
        "莫道人终可遮障，可终遮障亦何为。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 188086,
      "title": "诋燕",
      "content": [
        "金屋人娇奈燕何，暮帘好卷放来过。",
        "今年已见燕无数，何况明年燕更多。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 188087,
      "title": "燕答",
      "content": [
        "春日楼台暖气低，东风无主自东西。",
        "寻常帘幙有多少，何处画梁无燕泥。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 188088,
      "title": "观饮",
      "content": [
        "不饮虽然合众难，何妨众客自盘桓。",
        "已看手足互颠倒，更听人人自谓欢。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 188089,
      "title": "答耿奎",
      "content": [
        "浮生飘泊委蓬蒿，洴澼无封敢叹劳。",
        "心学古人方有愧，身从衰俗忽为髙。",
        "苟惭枉道干箪食，肯谓非时爱一毛。",
        "末学从兹益知守，善人不鄙与华褒。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 188090,
      "title": "江上",
      "content": [
        "浩渺烟波不可名，我来闲自濯尘缨。",
        "久思沧海收身去，安得长舟破浪行。",
        "天濶水云连黯淡，日间鸥鹭自飞鸣。",
        "屈平死后渔人尽，后世凭谁论浊清。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 188091,
      "title": "洗竹",
      "content": [
        "去年春笋密相扶，洗去心图翠色疏。",
        "髙节欲令人尽见，枉枝何惜手亲除。",
        "临川常可持为钓，待凤犹能饱有余。",
        "须看月明风劲夜，寒声薄影满茅居。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 188092,
      "title": "春梦",
      "content": [
        "湘水茫茫春意关，岑郎一睡片时间。",
        "谁知行尽江南路，枕上离家枕上还。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 188093,
      "title": "秋日偶成呈杜子长显之兼简仲美刘丈",
      "content": [
        "丈夫不合自穷愁，藜藿先须天下忧。",
        "君不唐虞皆我罪，民推沟壑更谁尤。",
        "须将兼济为吾事，若只诚身亦我羞。",
        "满纸古人皆有道，如其所学愿轲邱。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 188094,
      "title": "岁暮言怀呈诸友",
      "content": [
        "万事无成只一吁，穷年况复叹穷途。",
        "功名未立头先白，贫病相仍气尚粗。",
        "富贵早知皆有命，穷通料是不由吾。",
        "会须开口随时笑，一曲长歌醉倒壶。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 188095,
      "title": "日益无聊赖偶成呈子长",
      "content": [
        "一夕西风叶下柯，覊人憔悴发沉疴。",
        "穷来无子知难得，命薄于人可奈何。",
        "困卧牛衣空有泪，剧弹鐡剑不成歌。",
        "陶家壁冷尘埃满，何日云雷起鐡梭。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 188096,
      "title": "醉后",
      "content": [
        "醉里分明别是天，最宜沉溺过流年。",
        "平时政要全稽古，盛世朝廷不乏贤。",
        "但得有生皆自遂，不妨吾属亦陶然。",
        "沉湘死屈如何者，却把醒名欲自专。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 188097,
      "title": "梅花",
      "content": [
        "晓枝开早未多稠，屡齅清香不忍收。",
        "万木已知春尽到，百花常负后来羞。",
        "东风也合相和暖，腊雪无端欲滞留。",
        "满眼萧疏正堪惜，莫将横笛起人愁。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 188098,
      "title": "木瓜花",
      "content": [
        "簇簇红葩间绿荄，阳和闲暇不须催。",
        "天教尔艶呈奇绝，不与夭桃次第开。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 188099,
      "title": "蔬兰",
      "content": [
        "晓折寒蔬野圃间，荒林深处有芳兰。",
        "世无贤士纫为佩，犹有幽人日取餐。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 188100,
      "title": "九曲池悼古",
      "content": [
        "刳地决洪波，深流隐木鹅。",
        "樯髙帆系锦，堤暖柳藏河。",
        "泰甚心方兆，颠危念则那。",
        "去都如脱屣，东下若瘳疴。",
        "殿脚千论女，宫眉斛计螺。",
        "迷楼插空远，水调掲声和。",
        "忠切闻无路，愚谀面自阿。",
        "君颜未回笑，贼首已称戈。",
        "运去天移鼎，人迁地见禾。",
        "当年遗废沼，及此尚名歌。",
        "古往悲奚寄，今传迹未讹。",
        "水寒波刺甲，土老岸髯莎。",
        "落照留归鸟，西风困旧荷。",
        "暮林迷远屿，夕霭暝前波。",
        "亡国谁堪问，覊人恨自多。",
        "凭栏不成去，归意为蹉跎。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 188101,
      "title": "寄宿倅陆经子履",
      "content": [
        "勋业悠悠未可贪，直须随处酌醺酣。",
        "君知仕路三无愠，我与人情七不堪。",
        "闻借朱衣为别乘，想回青眼忆髙谈。",
        "东风尚有西行约，甬水桥边定解骖。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 188102,
      "title": "太湖",
      "content": [
        "西南无尽望，吞恐罄吴郊。",
        "海近私凭蓄，天低不敢包。",
        "蛟龙宜自宅，螾蛭莫令巢。",
        "远浦才分点，归樯略认梢。",
        "水乘潮更濶，地过底宜坳。",
        "鸟绝烟维断，风凌浪脊交。",
        "大桥横作书，别岸缺成爻。",
        "吟恐诗无气，图忧笔费抄。",
        "归输范蠡得，官许季鹰抛。",
        "去忆心应系，归夸口定劳。",
        "穷何须蹈海，来好卜编茅。",
        "著户生同隐，居民钓自庖。",
        "沧浪未容濯，鱼枻夜停敲。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 188103,
      "title": "答刘仲美",
      "content": [
        "莽莽晴川水，寥寥病客舟。",
        "来随风浩荡，去逐雨淹留。",
        "生计梁边燕，归心海上鸥。",
        "多惭故人句，欹卧一长讴。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 188104,
      "title": "平山堂寄欧阳公",
      "content": [
        "废苑繁华未可寻，孤城西北路嵚崟。",
        "檐边月过峰峦顶，柱下云回草树阴。",
        "宾客日随千骑乐，管弦风入万家深。",
        "知公白玉堂中梦，未负当时壮观心。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 188106,
      "title": "尘土呈介甫",
      "content": [
        "尘土纷纷起处微，祗随风力乱嘘吹。",
        "髙张白雾横宫阙，低引轻云暗路岐。",
        "客坐昏蒙归耳目，人行斑白上须眉。",
        "谁知霶霈天飞雨，洗涤轻浮会有时。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 188107,
      "title": "溪上",
      "content": [
        "溪上清涟树老苍，行穿溪树踏青阳。",
        "溪深树密无人处，祗有幽花度水香。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 188108,
      "title": "金山",
      "content": [
        "马蹄行尽九州闲，无处欢娱得破颜。",
        "只有此中宜旷望，谁令天作海门山。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 188109,
      "title": "朝云",
      "content": [
        "朝云飞飞来无穷，暮云漠漠昏相蒙。",
        "闲来既自不成雨，拂去安用遮长空。",
        "拟鞭屏翳问白日，更谪星伯诛长风。",
        "尽令万物被光景，夜看北斗朝天中。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 188110,
      "title": "登城",
      "content": [
        "病来万事懒自宜，髙城有楼闲登跻。",
        "来期清风脱日热，坐厌远日看天低。",
        "闲郊草树漫蒙昧，落日燕雀争依栖。",
        "临风一叹人不会，直气飞去添虹霓。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 188111,
      "title": "招束伯仁杜子长夜话",
      "content": [
        "久阴忽晴已可赏，况复夜气驱蚊藏。",
        "清风逆回六月热，急雨借得三秋凉。",
        "非惟归云人目快，更有白月天心当。",
        "从来万古有未尽，待子一夕心胸张。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 188112,
      "title": "临别瓜州",
      "content": [
        "十年来往常依依，此日复去来何时。",
        "青山有意退弗忍，白髪不逢归未迟。",
        "乾坤不尽万里望，草木无限西风悲。",
        "尘缨欲濯恶独洁，沧浪流去清无涯。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 188113,
      "title": "春意",
      "content": [
        "春空漠漠多愁容，春意冉冉随归鸿。",
        "寒云飞髙不肯雨，白日翳暗何时风。",
        "闲花野草各意态，浓烟弱柳相昏蒙。",
        "北窗厌睡不知夜，起见海月如秋空。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 188114,
      "title": "酒船",
      "content": [
        "刳木以为舟，盖取诸涣象。",
        "有能为其模，黄金役良匠。",
        "虚中无樯楫，所载惟佳酿。",
        "绣段围华堂，妖姬发清唱。",
        "坐乘欢来时，落日翻红浪。",
        "试问醉乡游，何如江海上。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 188115,
      "title": "别表弟司秀才",
      "content": [
        "吾学老无长，吾日亦自爱。",
        "念当相舍去，反复互嗟慨。",
        "谋道苟能同，千里如坐会。",
        "又何重子行，吾意自有在。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 188116,
      "title": "别黄端微",
      "content": [
        "沧江无纤鳞，太岳无低岑。",
        "凤凰遗其卵，意欲留清音。",
        "昂昂卧虎儿，已有吞牛心。",
        "吴山山虽高，满路红棘林。",
        "不如早西来，草堂松竹深。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 188117,
      "title": "长江万顷明如镜",
      "content": [
        "长江万顷明如镜，江面无风江水静。",
        "白日当空照江底，蛟穴龙居难隐映。",
        "乱山影落碧波寒，渔翁醉卧愁不醒。",
        "迟暮东南见海门，海门目断烟云暝。",
        "几度狂涛日月低，舟师鼓枻歌相庆。",
        "长江虽长缯网多，纤鳞何处逃生命。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 188118,
      "title": "题步君叙园亭",
      "content": [
        "我爱练湖春柳好，四十里围青玉城。",
        "平流中澄绿镜匣，远山旁卧翠虎横。",
        "黄林主人乐此地，瞰压湖面开以亭。",
        "常将醉目望野色，数曲老画谁家屏。",
        "山禽水鸟尽相识，飞入栏壁驯不惊。",
        "有时落照到波上，一眼万叠金鳞明。",
        "伊余与世既龃龊，奈此有地来归耕。",
        "回头把眼看市道，愁向尘埃著脚行。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 188119,
      "title": "楼上曲",
      "content": [
        "逆口不唱当时歌，当时笑声与曲和。",
        "忍目不视当时字，当时字写当时意。",
        "当时意断字空存，纵有前歌不忍闻。",
        "楼凭西北栏干暖，病眼看天泪瘴昏。",
        "望望行云迷笑电，晓梦依稀有时见。",
        "双眉聚绿眼揉红，犹似临归别时面。",
        "秋夜迟迟夜灯短，翠被孤眠不成暖。",
        "旧时笑月不长圆，如今愁看月空满。",
        "武陵几欲寻归路，桃花迷人不知步。",
        "霜余芳草不成青，暮鸿飞入斜阳去。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 188120,
      "title": "忆江阴呈介甫",
      "content": [
        "江上城隍古镜中，城边山色翠屏风。",
        "鱼虾接海随时足，稻米连湖逐岁丰。",
        "泰伯人民堪教育，春申沟港可疏通。",
        "朱轮天使从君欲，异日能忘笑语同。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 188121,
      "title": "平山堂",
      "content": [
        "豁豁虚堂巧架成，地平相与远山平。",
        "横岩积翠檐边出，度陇浮苍瓦上生。",
        "春入壶觞分蜀井，风回谈笑落芜城。",
        "谢公已去人怀想，向此还留召伯名。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 188122,
      "title": "吴学士席上作",
      "content": [
        "尘沙欺客日冥冥，喜对贤豪耳目清。",
        "烂熳共夸文字饮，欢娱谁忆管弦声。",
        "风牵翠幕灯相照，月挂朱帘酒屡倾。",
        "后夜想当繁剧处，梦魂还绕北池行。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 188123,
      "title": "羁旅呈介甫",
      "content": [
        "羁旅迫岁晚，班毛混满簪。",
        "游无輠下马，坐乏囊中金。",
        "尘涨风声浊，天昏雪气深。",
        "幸闻清论数，竟日解悲吟。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 188124,
      "title": "送介甫行畿县",
      "content": [
        "厩牧三年厌苦频，况令持斧似行春。",
        "民氓堕窳怀宽政，吏士因循倚近亲。",
        "被水田畴思贷种，经冬鳏寡待周贫。",
        "想今愈有江湖兴，亦欲同君一钓纶。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 188125,
      "title": "次韵介甫怀舒州山水见示之什",
      "content": [
        "皖上相逢昔少留，登楼隐几听鸣鸠。",
        "山峰行处今何在，溪水流乘此有不。",
        "就食四方甘不系，为生一世信长浮。",
        "共知局促京沙里，回首当时始觉差。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 188127,
      "title": "次韵介甫集禧池上咏鹅",
      "content": [
        "池上溶溶浮暖日，野鹅无数自相于。",
        "谋生迹与风波密，择地心将网弋疏。",
        "毛羽鲜明疑振鹭，声鸣和好似关雎。",
        "应怜豢养轻身者，只直羲之数纸书。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 188128,
      "title": "存目",
      "content": [
        "诗题：有约首句：黄梅时节家家雨。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
