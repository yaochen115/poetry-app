{
  "data": [
    {
      "id": 33173,
      "title": "醉书",
      "content": [
        "似闲有俸钱，似仕无簿书。",
        "似长免事任，似属非走趋。",
        "病能加餐饭，老与酒不疏。",
        "婆娑东湖上，幽旷足自娱。",
        "时时唤客醉，小阁临红蕖。",
        "钓鱼斫银丝，擘荔见玉肤。",
        "檀槽列四十，遗声传故都。",
        "岂惟豪两川，自足夸东吴。",
        "但恨诗不进，榛荒失耘锄。",
        "何当扫纤艳，杰作追黄初。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 33174,
      "title": "楚氏庄龟泉",
      "content": [
        "曵尾穹龟不负图，一泓寒碧照庭除。",
        "醉中只合长来此，卧听蛮童放辘轳。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 33175,
      "title": "书怀二首  其一",
      "content": [
        "楚泽巴江两鬓残，夕阳又是倚阑干。",
        "敢言日与长安远，惟恨天如蜀道难。",
        "客枕五更归梦短，新诗千首后人看。",
        "青帘白舫何时发，醉听琵琶兴已阑。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 33176,
      "title": "书怀二首  其二",
      "content": [
        "西风萧瑟晚吹衣，又见亭皋木叶飞。",
        "已是中年频作恶，更堪秋日送将归。",
        "黄尘颜鬓无人识，青史功名与愿违。",
        "彊把一杯还径醉，羁怀何必不依依。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 33177,
      "title": "秋思三首  其一",
      "content": [
        "大面山前秋笛清，细腰宫畔莫滩平。",
        "吴樯楚柁动归思，陇月巴云空复情。",
        "万里风尘旧朝士，百年铅椠老书生。",
        "水村渔市从今始，安用区区海内名。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 33178,
      "title": "秋思三首  其二",
      "content": [
        "巢燕成归秋景奇，颇容老子醉哦诗。",
        "山晴更觉云含态，风定闲看水弄姿。",
        "痛饮何由从次道，并游空复忆安期。",
        "天涯又作经年客，莫对青铜恨鬓丝。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 33179,
      "title": "秋思三首  其三",
      "content": [
        "西风吹叶满湖边，初换秋衣独慨然。",
        "白首有诗悲蜀道，清宵无梦到钧天。",
        "迂疏早不营三窟，流落今寜直一钱。",
        "把酒未妨余兴在，试凭丝管饯流年。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 33180,
      "title": "东园晚步",
      "content": [
        "久客天涯忆故园，彊名官寺只衡门。",
        "秋桐蠧遍无全叶，古柳吹斜出半根。",
        "痛饮每思尊酒窄，微官空羡布衣尊。",
        "何时定下三巴去，思卧孤舟听断猿。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 33181,
      "title": "秋夜读书戏作",
      "content": [
        "别驾生涯似蠧鱼，简编垂老未相疏。",
        "也知赋得寒儒分，五十灯前见细书。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 33182,
      "title": "太平花",
      "content": [
        "扶床踉蹡出京华，头白车书未一家。",
        "宵旰至今劳圣主，泪痕空对太平花。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 33183,
      "title": "日暮至湖上",
      "content": [
        "篮舆晚绕湖，乐此新秋凉。",
        "粉落竹方老，红凋荷更香。",
        "天宇无纤云，仰视鸿鹄翔。",
        "小楼久不登，抚槛悲慨慷。",
        "浮生寄一梦，共尽无彭殇。",
        "况我数月客，转眼促去装。",
        "顾作儿女态，裵徊惜流光。",
        "簷角迎夜月，林间送斜阳。",
        "四年已五迁，终岁常遑遑。",
        "安得一茆屋，归老樵风旁。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 33184,
      "title": "秋兴",
      "content": [
        "无处逢秋不黯然，驿前斜日渡头烟。",
        "吟肩雅与寒驴称，归梦频争社燕先。",
        "百岁犹穿几两屐，千诗不及一囊钱。",
        "故应身世如团扇，已向人间耐弃捐。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 33185,
      "title": "秋色",
      "content": [
        "一段凄凉傍酒杯，中年剩作楚囚哀。",
        "迢迢似伴明河出，惨惨如随落照来。",
        "客路半生常泪眼，乡关万里更危台。",
        "蓼汀荻浦江南岸，自入秋来梦几回。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 33186,
      "title": "秋声",
      "content": [
        "萧骚拂树过中庭，何处人间有此声。",
        "涨水雨余晨放闸，骑兵战罢夜还营。",
        "闲凭曲几听虽久，彊抚哀弦写不成。",
        "暑退凉生君勿喜，一年光景又峥嵘。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 33187,
      "title": "观长安城图",
      "content": [
        "许国虽坚鬓已斑，山南经岁望南山。",
        "横戈上马嗟心在，穿堑环城笑虏孱。",
        "日暮风烟传陇上，秋高刁斗落云间。",
        "三秦父老应惆怅，不见王师出散关。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 33188,
      "title": "雨中作",
      "content": [
        "方惊岁更端，不觉秋已孟。",
        "虽云暑毒竢，无奈风雨横。",
        "荷空湖面濶，叶脱树枝劲。",
        "百卉亦已衰，非复昔华盛。",
        "游子老忘归，一榻卧衰病。",
        "欲谈无客来，向壁弄麈柄。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 33189,
      "title": "夜读了翁遗文有感",
      "content": [
        "秋雨萧萧夜不眠，挑灯开卷意凄然。",
        "吾曹自欲期千载，世论何曾待百年。",
        "当日公卿笑迂濶，即今河洛污腥膻。",
        "阴阳消长从来事，玩易深知屡绝编。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 33190,
      "title": "雷",
      "content": [
        "君不见冬月雷，深藏九地底，寂黙如寒灰。",
        "纷纷槁叶木尽脱，蠢蠢蛰户虫争坯。",
        "坚冰积雪一朝尽，风揺天边斗柄回。",
        "雷声却擘九地出，殷殷似挟春俱来。",
        "鱼龙振鳍熟睡醒，桃李一笑韶颜开。",
        "候耕老农喜欲舞，掀泥百草知谁催。",
        "惟嗟妇女不解事，深屋揜耳藏婴孩。",
        "吾闻阴阳有常数，非时动静皆为菑。",
        "无人为报阿香道，时来何至劳卿推。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 33191,
      "title": "龙眠画马",
      "content": [
        "国家一从失西陲，年年买马西南夷。",
        "瘴乡所产非权奇，边头岁入几番皮。",
        "崔嵬瘦骨带火印，离立欲不禁风吹。",
        "圉人太仆空列位，龙媒汗血来何时。",
        "李公太平官京师，立仗惯见渥洼姿。",
        "断缣岁久墨色暗，逸气尚若不可羁。",
        "赏奇好古自一癖，感事忧国空余悲。",
        "呜呼安得毛骨若此三千疋，衘枚夜度桑干碛。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 33192,
      "title": "秋夜池上作",
      "content": [
        "短发飕飕病骨轻，临池闲看露荷倾。",
        "月明何与浮云事，正向圆时故故生。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 33193,
      "title": "秋雨",
      "content": [
        "西山云千重，东园泥一尺。",
        "可怜墙下路，十日无履迹。",
        "空庭桐叶尽，古甃土花碧。",
        "坐怀江湖间，病鴈湿羽翮。",
        "寒窗向人青，衰发垂领白。",
        "孤吟更不寐，聊伴候虫啧。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 33194,
      "title": "卧病",
      "content": [
        "人生寓一气，血脉日夜流。",
        "秋毫或壅隔，百体若相仇。",
        "嗟予少多艰，衣食拙自谋。",
        "方寸丛百虑，如箭集射侯。",
        "奔走连数岁，呻吟剧兹秋。",
        "生死亦何有，成坏同一沤。",
        "胡为不自爱，森然起戈矛。",
        "一笑众妄灭，霜天鹰睨鞲。",
        "呼儿屏药囊，吾疾今其瘳。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 33195,
      "title": "梦入禅林有老宿方升座或云通悟禅师也",
      "content": [
        "尘埃车马何憧憧，麞头鼠目厌妄庸。",
        "乐哉梦见德人容，巍巍堂堂人中龙。",
        "举头仰望太华峰，摄衣欲往路无从。",
        "忽然梦断难再逢，空记说法声如钟。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 33196,
      "title": "蜀州大阅",
      "content": [
        "晓束戎衣一怅然，五年奔走遍穷边。",
        "平生亭障休兵日，惨澹风云阅武天。",
        "戍陇旧游真一梦，渡辽奇事付他年。",
        "刘琨晚抱闻鸡恨，安得英雄共著鞭。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 33197,
      "title": "放怀亭独立有感",
      "content": [
        "苇丛枯倒蓼花红，小立东湖更向东。",
        "委肉本知居几上，翦翎何恨蓍笼中。",
        "一笻信脚乾坤迮，百榼浇愁宠辱空。",
        "谁道穷途知旧少，此心念念与天通。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 33198,
      "title": "九月三日同吕周辅教授游大邑诸山",
      "content": [
        "大邑知名杜叟诗，山中仍值菊花时。",
        "节旄落尽羁臣老，髀肉生来壮士悲。",
        "豪举每嫌杯绿浅，痴顽颇怪鬓丝迟。",
        "广文别乘官俱冷，相伴宽为五日期。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 33199,
      "title": "次韵周辅道中二首  其一",
      "content": [
        "山灵喜我马蹄声，正用此时秋雨晴。",
        "日淡风斜江上路，芦花也似柳花轻。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 33200,
      "title": "次韵周辅道中二首  其二",
      "content": [
        "从来重九如寒食，天气微阴正自佳。",
        "莫问茱茰赐朝士，一尊随处有黄花。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 33201,
      "title": "憩黄秀才书堂",
      "content": [
        "吾生如虚舟，万里常泛泛。",
        "终年厌作客，著处思系缆。",
        "道边何人居，花竹颇闲淡。",
        "门庭净如拭，窗几光可鉴。",
        "堂上满架书，朱黄方点勘。",
        "把茅容卜邻，老死更谁憾。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 33202,
      "title": "夜宿鹄鸣山",
      "content": [
        "西游万里已关天，采药名山亦宿缘。",
        "老柏干霄如许寿，幽花泣露为谁妍。",
        "苔黏石磴扪萝上，灯耿云房扫榻眠。",
        "安得仙翁索米术，一生留此弄寒泉。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 33203,
      "title": "次韵周辅雾中作",
      "content": [
        "一日篮舆十过溪，丹茰黄菊及佳时。",
        "端居恐作他年恨，聨辔聊成此段奇。",
        "侧磴下临重涧黑，乱云高出一峰危。",
        "何时关辅烟尘静，太华山头更卜期。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 33204,
      "title": "山中得长句戏呈周辅并简朱县丞山",
      "content": [
        "鹤鸣山空无鹤来，青霞嶂深天壁开。",
        "千岩角逐互吞吐，一峰拔起矜崔嵬。",
        "日光微漏潭见底，水气上薄云成堆。",
        "幽禽飞鸣报客至，奇树璀璨知谁栽。",
        "花藤怪蔓白昼暗，奔猿落狖无时哀。",
        "路穷尚蹑一千级，忽见密竹藏楼台。",
        "共言神僧昔住此，至今光景如天台。",
        "搘笻负笠出复没，喜动妇人惊提孩。",
        "高人何至作狡狯，无乃翫世聊相诙。",
        "不然学道穷实际，讵舍正大崇奇瓌。",
        "儒林丈人学擅世，余事尚压蔡与崔。",
        "名山未死可再到，此士一失难重陪。",
        "赞府摘山事如织，摆拨领客何奇哉。",
        "境幽神怆不可住，归倩玉手传金杯。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 33205,
      "title": "捣药鸟",
      "content": [
        "白发无情日日生，散愁聊复作山行。",
        "幽禽似欲嘲衰病，故学禅房杵药声。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 33206,
      "title": "出山",
      "content": [
        "出山似与高人别，回首时时一怅然。",
        "它日再来缘要熟，遍题名姓绿岩边。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 33207,
      "title": "平云亭",
      "content": [
        "满榼芳醪何处倾，金鼇背上得同行。",
        "天垂绿野三边尽，云与朱阑一様平。",
        "烟树微茫疑误墨，风松萧瑟有新声。",
        "黄花未吐无多恨，也胜湘累拾落英。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 33208,
      "title": "高秋亭",
      "content": [
        "三日山中醉复醒，径归回首愧山灵。",
        "从今惜取观书眼，长看天西万叠青。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 33209,
      "title": "九日小疾不出",
      "content": [
        "病厌追游懒举觞，今年闭戸作重阳。",
        "香烟袅袅闲萦几，书卷纷纷静满床。",
        "斜日更增秋惨淡，黄花应怪客凄凉。",
        "长安光景还如昨，谁醉城南杜曲旁。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 33210,
      "title": "九日试雾中僧所赠茶",
      "content": [
        "少逢重九事豪华，南陌雕鞍拥钿车。",
        "今日蜀州生白发，瓦炉独试雾中茶。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 33211,
      "title": "我有美酒歌",
      "content": [
        "我有美酒起自斟，劝君一巵为君吟。",
        "素衣未遂京尘化，绿鬓已受吴霜侵。",
        "三巴涂路何嵚崟，五溪雾潦多毒淫。",
        "虎豹夜啸裂崖谷，魑魅昼出矜山林。",
        "身如槁叶堕幽穽，窅窅何啻千尺深。",
        "无因剖胸出此心，一寸孤忠天实临。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 33212,
      "title": "次韵师伯浑见寄",
      "content": [
        "穷乡久客易消魂，短发秋来白几分。",
        "梦泛扁舟镜湖月，身骑瘦马剑关云。",
        "万钉宝带知何用，九转金丹幸有闻。",
        "欲与先生同此计，会营茅舍近江滨。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 33213,
      "title": "自江源过双流不宿径行之成都",
      "content": [
        "断笮飘飘挂渡头，临江立马唤渔舟。",
        "少城已破繁华梦，老境聊寻汗漫游。",
        "斜日驿门双堠立，早霜风叶一林秋。",
        "诗材满路无人取，凖拟归骖到处留。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 33214,
      "title": "过绿杨桥",
      "content": [
        "过县东驰十里遥，行吟不觉度谿桥。",
        "硙轮激水无时息，酒斾迎风尽日揺。",
        "半掩店门灯煜煜，横穿村市马萧萧。",
        "秦吴万里行几遍，莫恨尊前绿鬓凋。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 33215,
      "title": "五鼓自簇桥入府",
      "content": [
        "晓月有余光，秋树无浓影。",
        "野烟浩无际，陂路行愈永。",
        "堰声何澎湃，露气正凄冷。",
        "忽然客愁破，更觉诗律整。",
        "昔人千载意，忙里一笑领。",
        "山林岂难归，吾计自不猛。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 33216,
      "title": "客多福院晨起",
      "content": [
        "万鲸传响彻修廊，唤起衰翁晓梦长。",
        "万事可怜随日出，一生常是伴人忙。",
        "驰驱深厌交飞盖，息偃何时静炷香。",
        "四到锦城身愈老，更堪重入少年场。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 33217,
      "title": "雨中出谒归昼卧",
      "content": [
        "宿雨盈车辙，秋风涨帽裙。",
        "爱闲惟兀兀，应俗苦纷纷。",
        "病眼添花晕，酡颜散缬纹。",
        "归来炷香卧，窗底看微云。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 33218,
      "title": "长歌行",
      "content": [
        "人生不作安期生，醉入东海骑长鲸。",
        "犹当出作李西平，手杖旄钺清旧京。",
        "金印煌煌未入手，白发种种来无情。",
        "成都古寺卧秋晚，落日偏傍僧窗明。",
        "岂其马上破贼手，哦诗长作寒螀鸣。",
        "兴来买尽市桥酒，大车磊落堆长缾。",
        "哀丝豪竹助剧饮，如巨野受黄河倾。",
        "平时一滴不入口，意气顿使千人惊。",
        "国雠未报壮士老，匣中宝剑夜有声。",
        "何当凯还宴将士，三更雪压飞狐城。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 33219,
      "title": "夜食炒栗有感",
      "content": [
        "齿根浮动叹吾衰，山栗炮燔疗夜饥。",
        "唤起少年京辇梦，和寜门外早朝来。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 33220,
      "title": "秋夜怀吴中",
      "content": [
        "秋夜挑灯读楚辞，昔人句句不吾欺。",
        "更堪临水登山处，正是浮家泛宅时。",
        "巴酒不能消客恨，蜀巫空解报归期。",
        "灞桥烟柳知何限，谁念行人寄一枝。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 33221,
      "title": "游三井观",
      "content": [
        "三井久知名，暇日偶一访。",
        "栋宇坏欲尽，基址尚闳壮。",
        "画墙皆国工，烟云俨天仗。",
        "旌旄亚戈戟，佩玉杂弓䩨。",
        "太古实杰作，笔落九天上。",
        "吴生名擅世，睥睨未肻让。",
        "规模远有考，意象豪不放。",
        "最奇老癯仙，骨立神愈王。",
        "石恪虽少怪，用笔亦跌宕。",
        "两姝淡蛾眉，非复火食状。",
        "尘埃久侵蚀，风雨无盖障。",
        "好事未易逢，寜能久亡恙。",
        "雍洛劫火余，妙迹尽凋丧。",
        "斯游恐难继，伫立增悄怆。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 33222,
      "title": "僊游阁",
      "content": [
        "张公一去二百载，杰阁依然横霭中。",
        "徙倚看碑仍看画，时闻柏子落秋风。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 33223,
      "title": "寓居小庵才袤丈戏作",
      "content": [
        "早衰甚畏寒，飕飕压空馆。",
        "登阁望东庵，亭亭长一繖。",
        "欣然愿暂寓，竹底门可欵。",
        "外看磔猬毛，仰视覆鹄卵。",
        "席才置锥地，牖若窥天管。",
        "瓦炉香不去，菅寝衾易暖。",
        "颇疑渔庵结，又类土室窽。",
        "家具止囊衣，弛担著亦满。",
        "客来勿嗤陋，老我善用短。",
        "犹能设胡床，相唤共茗椀。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 33224,
      "title": "送华师从剑州张秘书之招",
      "content": [
        "三年相伴锦江头，一日翩然不可留。",
        "官冷蓬门无客恋，时清剑阁有僧游。",
        "关山黙数来时路，风月悬知别后愁。",
        "禅版经龛有余暇，频登高处望西州。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 33225,
      "title": "江上对酒作",
      "content": [
        "把酒不能饮，苦泪滴酒觞。",
        "醉酒蜀江中，和涙下荆扬。",
        "楼橹压湓口，山川蟠武昌。",
        "石头与钟阜，南望郁苍苍。",
        "戈船破浪飞，鐡骑射日光。",
        "冦来即送死，讵能犯金汤。",
        "汴洛我旧都，燕赵我旧疆。",
        "请书一尺檄，为国平氐羌。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 33226,
      "title": "自嘲",
      "content": [
        "华子中年百事忘，嵇生仍坐懒为妨。",
        "病于荣宦冥心久，老向端闲得味长。",
        "对客欲谈还愦愦，读书才过已茫茫。",
        "青缣帐暖黄䌷稳，聊借东庵作睡乡。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 33227,
      "title": "暮归马上作",
      "content": [
        "石笋街头日落时，铜壶阁上角声悲。",
        "不辞与世终难合，惟恨无人麤见知。",
        "宝马俊逰春浩荡，江楼豪饮夜淋漓。",
        "醉来剩欲吟梁父，千古隆中可与期。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 33228,
      "title": "临别成都帐饮万里桥赠谭德称",
      "content": [
        "成都城南万里桥，芦根苹末风萧萧。",
        "映花碾草钿车小，驻坡蓦涧青骢骄。",
        "入门翠径绝窈窕，临水飞观何岧嶤。",
        "判无功名著不朽，惟仗诗酒宽亡聊。",
        "迎霜早已足雉兔，微冷便欲思狐貂。",
        "喜看缕脍映盘箸，恨欠斫蟹加橙椒。",
        "坐中谭侯天下士，龙马毛骨矜超遥。",
        "乌犀白纻谪仙様，但可邂逅不可招。",
        "今年一战馘余子，风送六翮凌青霄。",
        "美人再拜乞利市，醉墨飞落生蛟绡。",
        "我衰于世百无用，十年不趁含元朝。",
        "华缨肻傍萧飒鬓，宝带那束龙钟腰。",
        "祝君好去事明主，日望分喜来渔樵。",
        "逰谈引类亦细事，寄酒且解相如消。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 33229,
      "title": "夜宿二江驿",
      "content": [
        "鸡鸣原前风折树，夜到双流雨如注。",
        "桦皮湿透点不明，旋设篝炉燎衣袴。",
        "重城回首一梦散，锦障氊车渺无处。",
        "新声犹傍耳边来，残酒半随风力去。",
        "飞觞纵饮亦何乐，愦愦不堪长闭户。",
        "丈夫要为国平戎，俗子岂识吾所寓。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 33230,
      "title": "涉白马渡慨然有怀",
      "content": [
        "我马顾影嘶，忽涉白马津。",
        "虽非黄河上，抚事犹悲辛。",
        "太行之下吹战尘，燕南赵北空无人。",
        "袁曹百战相持处，犬羊堂堂自来去。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 33231,
      "title": "瑞草桥",
      "content": [
        "柘叶飕飕雪意骄，檐头双兔遇归樵。",
        "宿酲未觧题诗懒，虚过风流瑞草桥。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 33232,
      "title": "将之荣州取道青城",
      "content": [
        "倚天山作海涛倾，看遍人间两赤城。",
        "自笑年年随宦牒，不如处处得闲行。",
        "草痕沙际犹余绿，枫叶霜余已带頳。",
        "归去还堪咤儿辈，锦囊三十六峥嵘。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 33233,
      "title": "丈人观",
      "content": [
        "黄金篆书扁朱门，夹道巨竹屯苍云。",
        "崖岭划若天地分，千柱耽耽压其垠。",
        "缨冠肃谒丈人君，广殿空庭吹宝熏。",
        "摩挲画墙手为皲，异哉山巙与土𫅗。",
        "物怪𫜰𫜰冠丘坟，仙人佩玉杂帨帉。",
        "手整貂冠最不群，欲去不忍恨日曛。",
        "道翁采药昼夜勤，松根茯苓获兼斤。",
        "人芝植立彊骨觔，狗杞群吠声狺狺。",
        "山炉小甑吹幽芬，朱颜不饮常自醺。",
        "我亦宿诵五千文，一念之差堕世纷。",
        "逝将从翁走如麋，隐书秘诀何由闻。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 33234,
      "title": "题丈人观道院壁",
      "content": [
        "断香浮月磬声残，木影如龙布石坛。",
        "偶驾青鸾尘世窄，闲吹玉笛洞天寒。",
        "奇香满院晨炊药，异气穿岩夜浴丹。",
        "却笑飞仙未忘俗，金貂犹著侍中冠。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 33235,
      "title": "宿上清宫",
      "content": [
        "九万天衢浩浩风，此身真是一枯蓬。",
        "盘蔬采掇多灵药，阁道攀隮出半空。",
        "累尽神仙端可致，心虚造化欲无功。",
        "金丹定觧幽人意，散作山椒百炬红。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 33236,
      "title": "自上清延庆归过丈人观少留",
      "content": [
        "再到蓬莱路欲平，却吹长笛过青城。",
        "空山霜叶无行迹，半岭天风有啸声。",
        "细栈跨云萦峭绝，危桥飞柱插澄清。",
        "玉华更控青鸾住，要倚栏干待月明。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 33237,
      "title": "长生观观月",
      "content": [
        "碧天万里月正中，清夜弭节长生宫。",
        "广寒忽堕人间世，但怪步虚声散瑶台空。",
        "四山沉沉万籁寂，夭矫髯龙舞娱客。",
        "弭貂老仙期不来，独倚栏干吹玉笛。",
        "道人不怕九霄寒，银阙冰壶处处看。",
        "天台四万八千丈，明年照我扶藜杖。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 33238,
      "title": "储福观",
      "content": [
        "路转屏风叠，云藏帝子家。",
        "穷幽行荦确，息倦倚槎牙。",
        "绿藓封茶树，清霜折药花。",
        "世无勾漏令，谁此养丹砂。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 33239,
      "title": "龙门洞",
      "content": [
        "我来香积寺，清晨歴龙门。",
        "孤峰撑苍昊，大壑裂厚坤。",
        "古穴吹腥风，峭壁挂爪痕。",
        "水浮石楠花，崖络菖蒲根。",
        "横策意未餍，褰裳探其源。",
        "绝境岂可名，恨我诗语烦。",
        "须臾苍云合，便恐白雨翻。",
        "东走得平野，万里扶桑暾。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 33240,
      "title": "布金院",
      "content": [
        "万里西来了宿缘，凭鞭欹帽过年年。",
        "山寒院落开炉月，霜重郊原𣃁芋天。",
        "浅碧鳞鳞人度彴，长空杳杳鸟冲烟。",
        "夜投萧寺清无寐，楼角三更月满川。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 33241,
      "title": "离堆伏龙祠观孙太古画英惠王像",
      "content": [
        "岷山导江书禹贡，江流蹴山山为动。",
        "呜呼秦守信豪杰，千年遗迹人犹诵。",
        "决江一支溉数州，至今禾黍连云种。",
        "孙翁下笔开生面，岌嶪高冠摩屋栋。",
        "徙木遗风虽峭刻，取材尚足当世用。",
        "寥寥后世岂乏人，尺寸未施谗已众。",
        "要官无责空赋禄，轩盖传呼真一閧。",
        "奇勲伟绩旷世无，仁人志士临风恸。",
        "我游故祠九顿首，夜遇神君了非梦。",
        "披云激电从天来，赤手骑鲸不施鞚。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 33242,
      "title": "登灌口庙东大楼观崏江雪山",
      "content": [
        "我生不识柏梁建章之宫殿，安得峨冠侍游宴。",
        "又不及身在荥阳京索间，擐甲横戈夜酣战。",
        "胸中迫隘思远游，溯江来倚岷山楼。",
        "千年雪岭阑边出，万里云涛坐上浮。",
        "禹迹茫茫始江汉，疏凿功当九州半。",
        "丈夫生世要如此，赍志空死能无叹。",
        "白发萧条吹北风，手把巵酒酹江中。",
        "姓名未死终磊磊，要与此江东注海。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 33243,
      "title": "郫县道中思故里",
      "content": [
        "衰发不胜簮，驰驱岂复堪。",
        "客魂迷剑外，归思满天南。",
        "江路滩声壮，云停雪意酣。",
        "空怀小丛碧，细酌破吴柑。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 33244,
      "title": "宿江原县东十里张氏亭子未明而起",
      "content": [
        "寸廪驱人卒岁劳，一官坐失布衣高。",
        "剑南十月霜犹薄，江上五更鸡乱号。",
        "孤枕拥衾寻短梦，青灯照影著征袍。",
        "客愁相续无时断，那得并州快剪刀。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 33245,
      "title": "戏咏西州风土",
      "content": [
        "衍沃绵千里，融和被四时。",
        "蚕丛角歌吹，石室盛书诗。",
        "绿树藏渔市，清江遶佛祠。",
        "吾行更堪乐，载酒上蟆颐。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 33246,
      "title": "宿彭山县通津驿大风邻园多乔木终夜有声",
      "content": [
        "木欲静，风不止。",
        "子欲养，亲不留。",
        "夜诵此语涕莫收。",
        "吾亲之没今几秋，尚疑舍我而远游。",
        "心冀乘云反故丘，再拜奉觞陈膳羞。",
        "陶盎治米声叟叟，木甑炊饼香浮浮。",
        "芼姜屑桂调甘柔，稚鼈煮𦞦长鱼䐹。",
        "夜敷枕席视衾裯，晨起熏笼进衣裘。",
        "哀乐此志终莫酬，有言不闻九泉幽。",
        "北风岁晚号松楸，哀哉万里为食谋。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 33247,
      "title": "眉州郡燕大醉中间道驰出城宿石佛院",
      "content": [
        "玻瓈春作江水清，紫玉箫如雏鳯鸣。",
        "漏声不闻看炧烛，侠气未减欺飞觥。",
        "单车万里信有数，二年三过宁忘情。",
        "钗头玉茗妙天下，琼花一树真虚名。",
        "酒酣忽作檀公策，间道绝出东关城。",
        "清歌未断去已远，回首楼堞空峥嵘。",
        "貂裘狐帽醉走马，陌上应有行人惊。",
        "径投野寺睡正美，鱼鼓忽报江天明。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 33248,
      "title": "双柏",
      "content": [
        "双柏屹相向，刚严如巨人。",
        "龙吟风雨夕，山立雪霜晨。",
        "阅世易成古，刳心不复春。",
        "扶颠要力量，岁晚莫全身。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 33249,
      "title": "戍卒说沉黎事有感",
      "content": [
        "亭障曾无阅岁寕，频闻夷落犯王灵。",
        "孤城月落寃魂哭，百里风吹战血腥。",
        "瘴重厌看茅叶赤，春残不放柳条青。",
        "焦头烂额知何补，弭患从来贵未形。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 33250,
      "title": "平羌道中望峨眉山慨然有作",
      "content": [
        "白云如玉城，翠岭出其上。",
        "异境忽堕前，心目久荡漾。",
        "别来二百日，突兀喜亡恙。",
        "飞仙遥举手，唤我一税鞅。",
        "此行岂或使，屏迹事幽旷。",
        "何必故山归，更破万里浪。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 33251,
      "title": "次韵何元立都曹赠行",
      "content": [
        "嘉荣东西川，此别不为远。",
        "徘徊凌云寺，决去未遽忍。",
        "登高望故人，烟树参差见。",
        "悬知今日梦，不隔重城键。",
        "平生相从意，百年有未满。",
        "结巢青城云，期子在岁晚。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 33252,
      "title": "次韵杨嘉父先辈赠行",
      "content": [
        "贞元旧朝士，太学老诸生。",
        "半世不偶谐，残年正飘零。",
        "危坐但愁悲，一笑黄河清。",
        "佳客如晨星，俗子如春萍。",
        "奇哉今日事，诸贤送东征。",
        "吸酒杯当空，缀诗笔勿停。",
        "明发复百忧，君听马蹄声。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 33253,
      "title": "入荣州境",
      "content": [
        "一起一伏黄茅冈，崔嵬破丘狐兔藏。",
        "炯炯寒日清无光，单单终日行羊肠。",
        "村落聚看如惊麞，亦有银钗伏短墙。",
        "黄旗翻翻鼓其镗，画角鸣咽吹斜阳。",
        "长筒汲井熬雪霜，辘轳咿哑官道傍。",
        "渺然孤城天一方，传者或云古夜郎。",
        "其民简朴士甚良，千里郁为诗书乡。",
        "闭合扫地焚清香，老人处处是道场。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 33254,
      "title": "井研道中",
      "content": [
        "穷冬景方促，下岭路微平。",
        "地瘦竹无叶，风干茅有声。",
        "客逰空自叹，归计与谁评。",
        "尚喜长亭下，云穿夕照明。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 33255,
      "title": "頼牟镇早行",
      "content": [
        "孤灯照影听初鸡，揽辔情怀倍惨凄。",
        "雪作未成云意閙，茅荒无际客魂迷。",
        "触寒手指藏犹裂，畏崄图书弃不擕。",
        "老去有文无卖处，等闲题遍蜀东西。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 33256,
      "title": "初到荣州",
      "content": [
        "乱山缺处城楼呀，双旗萧萧晚吹笳。",
        "烟深绿桂临绝壑，霜落残瀬鸣寒沙。",
        "废台已无隐士啸，遗宅上有高人家。",
        "铃斋下榻约僧话，松阴枕石放吏衙。",
        "杯羹最珍慈竹笋，缾水自养山姜花。",
        "地炉堆兽炽石炭，瓦鼎号蚓煎秋茶。",
        "少年远逰无百里，一饥能使行天涯。",
        "岂惟惯见蓬婆雪，直恐遂泛星河槎。",
        "故巢肻作儿女恋，异境会向乡闾夸。",
        "一杯径醉帻自坠，灯下发影看𩭹髿。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 33257,
      "title": "城上二首  其一",
      "content": [
        "双双黄犊卧斜阳，叶叶丹枫著早霜。",
        "沙水自鸣如有恨，野花无主为谁芳。",
        "郫筒味酽愁濡甲，巴曲声悲怯断肠。",
        "赖有生平管城子，不妨驱使荅风光。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 33258,
      "title": "城上二首  其二",
      "content": [
        "濯锦豪华梦不通，岿然孤叠乱山中。",
        "行歌满道知人乐，露积连村见岁丰。",
        "万瓦新霜扫残瘴，一林丹叶换青枫。",
        "鹅黄名酝何由得，且醉杯中琥珀红。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 33259,
      "title": "西楼夕望",
      "content": [
        "夜郎城里叹途穷，赖有西楼著此翁。",
        "溪鸟孤飞寒霭外，野人参语夕阳中。",
        "苍天可恃何曾老，白发缘愁却未公。",
        "俗态十年看烂熟，不如留眼送归鸿。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 33260,
      "title": "醉中怀眉山旧逰",
      "content": [
        "劲酒少和气，哀歌无欢情。",
        "故乡不敢思，登高望锦城。",
        "锦城那得去，仿佛蟆颐路。",
        "遥知尊前人，指我题诗处。",
        "我虽流落夜郎天，遇酒能狂似少年。",
        "想见东郊携手日，海棠如雪柳飞绵。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 33261,
      "title": "登城望西崦",
      "content": [
        "登城望西崦，数家斜照中。",
        "柴荆昼亦闭，乃有太古风。",
        "惨淡起炊烟，寂歴下钓筒。",
        "土瘦麦苗短，霜重桑枝空。",
        "恐是种桃人，或有采芝翁。",
        "何当宿楼上，月明照夜舂。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 33262,
      "title": "甲午十一月十三夜梦右臂踊出一小剑长八九寸有光既觉犹微痛也",
      "content": [
        "少年学剑白猿翁，曾破浮生十岁功。",
        "玉具拄颐谁复许，蒯缑弹铗老犹穷。",
        "床头忽觉蛟龙吼，天上方惊牛斗空。",
        "此梦怪奇君记取，佩刀犹得世三公。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 33263,
      "title": "汉斋中夜坐有感",
      "content": [
        "荒山为城溪作壕，风鼓巨木声翻涛。",
        "鸱枭乘屋弹不去，狐狸欺人怒竖毛。",
        "雨来红鹤更可恶，争巢一似婴儿号。",
        "城孤屋老草木茂，正坐人少此辈豪。",
        "急呼五百具畚锸，欲掀窟穴穷腥臊。",
        "忽然语罢却自笑，残年何至与汝鏖。",
        "浣花江色绿如黛，春波灔灔浮轻舠。",
        "行当系缆柳阴下，仰听莺语倾香醪。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 33264,
      "title": "晚登横溪阁二首  其一",
      "content": [
        "楼鼓声中日又斜，凭高愈觉在天涯。",
        "空桑客土生秋草，野渡虚舟集晚鸦。",
        "瘴雾不开连六诏，俚歌相荅带三巴。",
        "故乡可望应添泪，莫恨云山万叠遮。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 33265,
      "title": "晚登横溪阁二首  其二",
      "content": [
        "荦确坡头笻竹枝，西临村路立多时。",
        "卖蔬市近还家早，煮井人忙下麦迟。",
        "病客情怀常怯酒，山城光景尽供诗。",
        "晚来试问愁多少，只许高楼横笛吹。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 33266,
      "title": "昭德堂晚步",
      "content": [
        "笑唤枯笻蹋夕阳，探春聊作静中忙。",
        "高枝鹊语如相命，幽径梅开秪自香。",
        "苔蚀断碑惊世换，钟来废寺觉城荒。",
        "谪仙未必无遗恨，老欠题诗到夜郎。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 33267,
      "title": "龙洞",
      "content": [
        "峭崖磨天如立壁，柟根横走松倒植。",
        "呀然一岫惊倒人，空洞坡陁三百尺。",
        "幽阴宜为异物托，角爪痕存犹可识。",
        "想当蟠蛰未奋时，腥风逼人云触石。",
        "一朝偶为旱岁起，卷海作雨飞霹雳。",
        "向来伊吕正如此，莘渭千年有遗迹。",
        "我欲酌酒招蜿蜒，安用辛苦常行天。",
        "太平海内多丰年，归来故祠听管弦。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 33268,
      "title": "客中夜寒戏作长谣",
      "content": [
        "孤翁痴钝如寒蝇，霜夕不暝愁严凝。",
        "寝衣触体起芒粟，鼻息嘘润成冰凌。",
        "冬冬黙数严谯鼓，耿耿独看幽窗灯。",
        "支床龟老共夜永，号月鸡冷同晨兴。",
        "白狐紫貂了不暖，何况蜀锦并吴绫。",
        "静思忽得安乐法，人生所欠絮与缯。",
        "十年一衲尚可过，不信请视匡山僧。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 33269,
      "title": "高斋小饮戏作",
      "content": [
        "梅花又发鬼门关，坐觉春风万里寛。",
        "荔子阴中时纵酒，竹枝声里彊追欢。",
        "丁年汉使殊方老，子夜吴歌昨梦残。",
        "白帝夜郎俱不恶，两公补处得凭栏。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 33270,
      "title": "太液黄鹄歌",
      "content": [
        "建章宫里春风寒，太液水生池面寛。",
        "中人驰奏黄鹄下，龙旗豹尾临池看。",
        "芹香藻暖鹄得意，左右从官呼万岁。",
        "须臾传诏宴公卿，欢声如雷动天地。",
        "时平宫省逰乐多，黄鹄刷羽涵恩波。",
        "小臣珥笔龙墀下，愿继前朝天马歌。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 33271,
      "title": "自唐安徙家来和义出城迎之马上作",
      "content": [
        "身如林下僧，处处常寄包。",
        "家如梁上鷰，岁岁旋作巢。",
        "岂惟人所怜，顾影每自嘲。",
        "眼看佳山水，不得结把茅。",
        "造物困豪杰，如视饿虎哮。",
        "要令出精神，感激使叫呶。",
        "颇思投笔去，走马盘云旓。",
        "三更冒急雪，大战梁楚郊。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 33272,
      "title": "乙未元日",
      "content": [
        "五十人间老大身，更堪从此数新春。",
        "冬冬漏鼓催窗色，急急文书动驿尘。",
        "病后光阴常自惜，客中节物为谁新。",
        "壮心只向邮亭尽，自揣头颅莫问人。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    }
  ],
