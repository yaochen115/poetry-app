{
  "data": [
    {
      "id": 209947,
      "title": "寄少仪弟",
      "content": [
        "一隔音尘月屡迁，忽收来问涕潸然。",
        "栖迟册府吾如昨，流落江村汝可怜。",
        "梦里漫成池草句，愁来空诵棣华篇。",
        "卑飞暂尔无多恨，会有高风送上天。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 209948,
      "title": "九月八日夜大风雨寄王定国",
      "content": [
        "长年身外事都捐，节物惊心一怅然。",
        "正是山川秋入梦，可堪风雨夜连天。",
        "桐梢摵摵增凄断，灯烬飞飞落小圆。",
        "湔洗此情须痛饮，明朝试就酒中仙。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 209949,
      "title": "林次中奉使契丹刘仲平出倅郓州同舍十有六人饮饯于丁氏园次少蓬韵二首 送次中谏议",
      "content": [
        "鲜车百乘使龙庭，路指全燕古北平。",
        "祖帐列仙修故事，行台诸部奏新声。",
        "留犂挠酒知胡意，尺牍移书示汉情。",
        "纳节便应归法从，中途已报制书行。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 209950,
      "title": "林次中奉使契丹刘仲平出倅郓州同舍十有六人饮饯于丁氏园次少蓬韵二首 送平仲学士",
      "content": [
        "须句别驾伟仪刑，陵谷初无见坦平。",
        "七子建安推世艺，五经中秘擅家声。",
        "南宫参掇端如梦，东观分携空复情。",
        "莫爱谿堂好风月，早来龙尾道前行。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 209951,
      "title": "寄孙传师著作",
      "content": [
        "上林池籞富春风，十里宫青错御红。",
        "应与少年修故事，误随游毂柳花中。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 209952,
      "title": "泗州东城晚望",
      "content": [
        "渺渺孤城白水环，舳舻人语夕霏间。",
        "林梢一抹青如画，应是淮流转处山。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 209953,
      "title": "戏云龙山人二绝  其一",
      "content": [
        "芳草未应羞鹎𫛥，潜鳞终是畏提壶。",
        "蔡经背上痕犹在，更念麻姑指爪无。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 209954,
      "title": "戏云龙山人二绝  其二",
      "content": [
        "选胜只携长胫鹤，入廛还驾短辕车。",
        "时人若问虚玄事，笑答无过李老书。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 209955,
      "title": "圆通院白衣阁  其一",
      "content": [
        "无边刹境一毫端，同住澄清觉海间。",
        "还似此花并此叶，坏空成住未曾闲。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 209956,
      "title": "圆通院白衣阁  其二",
      "content": [
        "一根反本六根同，古佛传家有此风。",
        "满目红蕖参翠盖，不唯门里获圆通。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 209957,
      "title": "照阁",
      "content": [
        "弥猴镜里三身现，龙女珠中万象开。",
        "未若此轩人散后，水光清泛月华来。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 209958,
      "title": "睡足寮寄震鼎二弟",
      "content": [
        "与物无营但欲眠，客来从笑腹便便。",
        "秋生淮海凉如水，得句还应梦阿连。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 209959,
      "title": "次韵参寥见别",
      "content": [
        "炉香冉冉纡寒穗，篝火荧荧擢夜芒。",
        "预想江天回首处，雪风横急雁声长。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 209960,
      "title": "与倪老伯辉九曲池有怀元龙参寥",
      "content": [
        "云月娟娟淮海秋，隋家池上共浮游。",
        "可怜一段风流事，特欠支郎与子猷。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 209961,
      "title": "春日五首  其一",
      "content": [
        "幅巾投晓入西园，春动林塘物物鲜。",
        "却憩小庭才日出，海棠花发麝香眠。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 209962,
      "title": "春日五首  其二",
      "content": [
        "一夕轻雷落万丝，霁光浮瓦碧差差。",
        "有情芍药含春泪，无力蔷薇卧晓枝。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 209963,
      "title": "春日五首  其三",
      "content": [
        "裌衣新著倦琴书，散策池塘返照初。",
        "翠碧黄鹂相续去，荇丝深处见游鱼。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 209964,
      "title": "春日五首  其四",
      "content": [
        "春禽叶底引圆吭，临罢黄庭日正长。",
        "满院柳花寒食后，旋钻新火𦶟炉香。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 209965,
      "title": "春日五首  其五",
      "content": [
        "金屋旧题烦乙子，蜜脾新采頼蜂臣。",
        "蜻蜓蛱蝶无情思，随例颠忙过一春。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 209966,
      "title": "秋日三首  其一",
      "content": [
        "霜落邗沟积水清，寒星无数傍船明。",
        "菰蒲深处疑无地，忽有人家笑语声。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 209967,
      "title": "秋日三首  其二",
      "content": [
        "月团新碾瀹花瓷，饮罢呼儿课楚词。",
        "风定小轩无落叶，青虫相对吐秋丝。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 209968,
      "title": "秋日三首  其三",
      "content": [
        "连卷雌蜺挂西楼，逐雨追晴意未休。",
        "安得万妆相向舞，酒酣聊把作缠头。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 209969,
      "title": "次韵子由召伯埭见别三首  其一",
      "content": [
        "孤蓬短榜溯河流，无頼寒侵紫绮裘。",
        "召伯埭南春欲尽，为公重赋畔牢愁。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 209970,
      "title": "次韵子由召伯埭见别三首  其二",
      "content": [
        "青荧灯火照深更，逐客舟航冷似冰。",
        "到处故应山作主，随方还有月为朋。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 209971,
      "title": "次韵子由召伯埭见别三首  其三",
      "content": [
        "冠盖纷纷不我谋，掩关聊与古人游。",
        "会须匹马淮西去，云𪩘风溪遂所求。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 209972,
      "title": "还自广陵四首  其一",
      "content": [
        "薄茶便当乌程酒，短艇聊充下泽车。",
        "坟墓去家无百里，往来仍不废观书。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 209973,
      "title": "还自广陵四首  其二",
      "content": [
        "南北悠悠三十年，谢公遗埭故依然。",
        "欲论旧事无人共，卧听钟鱼古寺边。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 209974,
      "title": "还自广陵四首  其三",
      "content": [
        "邗沟缭绕上云空，坐阻层冰不得通。",
        "頼有东风可人意，为开明镜玉奁中。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 209975,
      "title": "还自广陵四首  其四",
      "content": [
        "天寒水鸟自相依，十百为群戏落晖。",
        "过尽行人都不起，忽闻水响一齐飞。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 209976,
      "title": "元日立春三绝  其一",
      "content": [
        "此度春非草草回，美人休著剪刀催。",
        "直须残腊十分尽，始共新年一并来。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 209977,
      "title": "元日立春三绝  其二",
      "content": [
        "发春献岁偶然同，新历观天最有功。",
        "头上两般幡胜影，一时飞入酒杯中。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 209978,
      "title": "元日立春三绝  其三",
      "content": [
        "摄提东直斗杓寒，骤觉中原气象宽。",
        "天为两宫同号令，不教春岁各开端。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 209979,
      "title": "次韵宋履中题李侯檀栾亭",
      "content": [
        "阴阴数亩箨龙稠，亭外危通一径幽。",
        "颇似竹林当日集，酒狂莫笑阮陈留。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 209980,
      "title": "春日偶题呈上尚书丈丈",
      "content": [
        "三年京国鬓如丝，又见新花发故枝。",
        "日典春衣非为酒，家贫食粥已多时。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 209981,
      "title": "观辱户部钱尚书和诗饷禄米再成二章上谢  其一",
      "content": [
        "本欲先生一解颐，顿烦分米慰长饥。",
        "客无贵贱皆蔬饭，惟有慈亲食肉糜。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 209982,
      "title": "观辱户部钱尚书和诗饷禄米再成二章上谢  其二",
      "content": [
        "梦里光阴挽不回，掩关独坐万缘灰。",
        "偶因问讯维摩病，香积天中施饭来。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 209983,
      "title": "拟题织锦图",
      "content": [
        "悲风鸣叶秋宵冷，寒丝萦手泪残妆。",
        "微烛窥人愁断肠，机翻云锦妙成章。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 209984,
      "title": "晚出左掖",
      "content": [
        "金爵觚棱转夕晖，翩翩宫叶堕秋衣。",
        "出门尘障如黄雾，始觉身从天上归。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 209985,
      "title": "次韵蔡子骏琼花",
      "content": [
        "无双亭上传觞处，最惜人归月上时。",
        "相见异乡心欲绝，可怜花与月应知。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 209986,
      "title": "处州水南庵二首  其一",
      "content": [
        "竹栢萧森溪水南，道人为作小圆庵。",
        "市区收罢鱼豚税，来与弥陀共一龛。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 209987,
      "title": "处州水南庵二首  其二",
      "content": [
        "此身分付一蒲团，静对萧萧玉数竿。",
        "偶为老僧煎茗粥，自携修绠汲清宽。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 209988,
      "title": "三月晦日偶题",
      "content": [
        "节物相催各自新，痴心儿女挽留春。",
        "芳菲歇去何须恨，夏木阴阴正可人。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 209989,
      "title": "次韵东坡上元扈从三绝  其一",
      "content": [
        "赭黄繖底望龙章，不断惟闻蜡炬香。",
        "一片韶音归复道，重瞳左右列英皇。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 209990,
      "title": "次韵东坡上元扈从三绝  其二",
      "content": [
        "端门魏阙鬰峥嵘，灯火成山辇路平。",
        "不待上林鶑百啭，教坊先已进新声。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 209991,
      "title": "次韵东坡上元扈从三绝  其三",
      "content": [
        "仗下番夷各一群，机泉如雨自缤纷。",
        "细看香案旁边吏，却是茅家大小君。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 209992,
      "title": "四绝  其一",
      "content": [
        "阴风一夜搅青冥，风定霏霏霰雪零。",
        "遥想玉真清境上，白虚光里诵黄庭。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 209993,
      "title": "四绝  其二",
      "content": [
        "夜深楼上拨书眠，天在栏干四角边。",
        "风拂乱云毫发尽，独留璧月向人圆。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 209994,
      "title": "四绝  其三",
      "content": [
        "天风吹月入栏干，乌鹊无声子夜阑。",
        "织女明星来枕上，了知身不在人间。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 209995,
      "title": "四绝  其四",
      "content": [
        "本是匡山种杏人，出山来事碧虚君。",
        "上清欲问因何事，请看先山十丈文。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 209996,
      "title": "奉别牛司理",
      "content": [
        "堂堂先德擅才名，词赋高凌墨客卿。",
        "之子妙龄初筮仕，好修文史继家声。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 209997,
      "title": "送酒与泗州太守张朝请",
      "content": [
        "莫笑杭州别驾村，昔曾柱下数承恩。",
        "而今虽是江湖吏，犹有当时七字尊。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 209998,
      "title": "题郴阳道中一古寺壁二绝  其一",
      "content": [
        "门掩荒寒僧未归，萧萧庭菊两三枝。",
        "行人到此无肠断，问尔黄花知不知。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 209999,
      "title": "题郴阳道中一古寺壁二绝  其二",
      "content": [
        "哀歌巫女隔祠丛，饥鼠相追坏壁中。",
        "北客念家浑不睡，荒山一夜雨吹风。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 210000,
      "title": "又别牛司理",
      "content": [
        "半年淹恤越溪滨，好爱如君只数人。",
        "解手莫令书信断，故园桑梓幸相邻。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 210001,
      "title": "和工部侍郎新章",
      "content": [
        "甍栋相连数亩中，出门遥见大明宫。",
        "朝元虽共浮丘伯，煮苕还同桑苎翁。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 210002,
      "title": "题金华山寺壁",
      "content": [
        "鸾鹤同为汗漫游，天风吹散下沧洲。",
        "金华有路通元气，水绕高寒不断流。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 210003,
      "title": "次韵出省马上有怀蒋颖叔  其一",
      "content": [
        "新淬鱼肠玉似泥，将军唾手取河西。",
        "偏裨万户封龙额，部曲千金赐褭蹄。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 210004,
      "title": "次韵出省马上有怀蒋颖叔  其二",
      "content": [
        "制诏行闻降紫泥，簪花且醉玉东西。",
        "羌人谁谓多筹策，止有黔馿技一蹄。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 210005,
      "title": "元祐三年余被召至京师从翰林苏先生过兴国浴室院始识汶师后二年复来阅诸公诗因次韵",
      "content": [
        "聊移小榻就风廊，卧久衣巾带佛香。",
        "白发道人还省否，前年引去病贤良。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 210006,
      "title": "客有遗予以假山石盆池者闻陈元发有石菖蒲作此诗乞之",
      "content": [
        "瑟瑟风漪心为清，更窥崷崒眼增明。",
        "可怜一片江山样，只欠菖蒲十数茎。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 210007,
      "title": "兴国浴室院独坐时儿子湛就试未出",
      "content": [
        "满城车马没深泥，院里安闲总不知。",
        "儿辈未来钩箔坐，长春花上雨如丝。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 210008,
      "title": "题赵团练画江干晚景四绝  其一",
      "content": [
        "本自江湖客，宦游常苦心。",
        "看君小平远，怀我旧登临。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 210009,
      "title": "题赵团练画江干晚景四绝  其二",
      "content": [
        "鸟外云峰晚，沙头草树晴。",
        "想初挥洒就，侍女一齐惊。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 210010,
      "title": "题赵团练画江干晚景四绝  其三",
      "content": [
        "公子歌钟里，何从识渺茫。",
        "惟应斗帐梦，曾到水云乡。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 210011,
      "title": "题赵团练画江干晚景四绝  其四",
      "content": [
        "晓浦烟笼树，春江水拍空。",
        "烦君添小艇，画我作渔翁。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 210012,
      "title": "梦中得此",
      "content": [
        "缟带横秋匣，寒流烱暮堂。",
        "风尘如未息，持此奉君王。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 210013,
      "title": "宁浦书事六首  其一",
      "content": [
        "挥汗读书不已，人皆怪我何求。",
        "我岂更求荣达，日长聊以销忧。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 210014,
      "title": "宁浦书事六首  其二",
      "content": [
        "鱼稻有如淮右，溪山宛类江南。",
        "自是迁臣多病，非干此地烟岚。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 210015,
      "title": "宁浦书事六首  其三",
      "content": [
        "南土四时尽热，愁人日夜俱长。",
        "安得此身作石，一齐忘了家乡。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 210016,
      "title": "宁浦书事六首  其四",
      "content": [
        "洛邑太师奄谢，龙川仆射云亡。",
        "他日岿然独在，不知谁似灵光。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 210017,
      "title": "宁浦书事六首  其五",
      "content": [
        "身与枝藜为二，对月和影成三。",
        "骨肉未知消息，人生到此何堪。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 210018,
      "title": "宁浦书事六首  其六",
      "content": [
        "寒暑更拚三十，同归灭尽无疑。",
        "纵复玉关生入，何殊死葬蛮夷。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 210019,
      "title": "题务中壁",
      "content": [
        "醡头春酒响潺潺，垆下黄翁寝正安。",
        "梦入平阳旧池馆，隔花螭口吐清寒。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 210020,
      "title": "题法海平阇黎",
      "content": [
        "寒食山州百色喧，春风花雨暗川原。",
        "因循移病依香火，写得弥陀七万言。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 210021,
      "title": "留别平阇黎",
      "content": [
        "缘尽山城且不归，此生相见了无期。",
        "保持异日莲花上，重说如今结社时。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 210022,
      "title": "大行太皇太后挽词二首  其一",
      "content": [
        "东朝制诏九年称，烈武功高后世兴。",
        "坐举不周天柱正，亲扶旸谷日车升。",
        "班行尚想延和殿，羽卫俄趋永厚陵。",
        "洛水嵩峰霄汉外，百官西望涕难胜。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 210023,
      "title": "大行太皇太后挽词二首  其二",
      "content": [
        "保扶明主自春宫，万国升平出至公。",
        "顾命一时聊共政，思齐千古遂同风。",
        "外家恩数仍长信，原庙蒸尝即治隆。",
        "欲叙圣功歌挽者，乾坤难入画图中。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 210024,
      "title": "韩枢密夫人挽词二首  其一",
      "content": [
        "奕叶貂蝉后，宗姻乐静间。",
        "从夫登两地，看子入三山。",
        "旧像瞻榆阙，遗音想佩环。",
        "百年川阅水，不复更西还。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 210025,
      "title": "韩枢密夫人挽词二首  其二",
      "content": [
        "天上开华屋，丘山忽返真。",
        "内人归赗盛，挽者转哀新。",
        "鸾诏初干墨，鱼轩已暗尘。",
        "蔼然多德善，论次有苍珉。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 210026,
      "title": "俞公达待制挽词二首  其一",
      "content": [
        "词场英妙气如虹，出入青云见事功。",
        "流马木牛通蜀漕，葛巾羽扇破渠戎。",
        "风生使者旌旄上，春在将军俎豆中。",
        "诏墨未干人奄忽，伤心江汉日倾东。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 210027,
      "title": "俞公达待制挽词二首  其二",
      "content": [
        "一麾出守著威名，凶讣西来上为惊。",
        "玉帐笑谈成昨梦，锦囊书札见平生。",
        "衣冠渐散红莲府，铠马还归细柳营。",
        "可道风流回首尽，芝兰庭下粲朝荣。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 210028,
      "title": "陈承事挽词",
      "content": [
        "明时就养寄淮壖，忽叹艅艎以柩旋。",
        "八尺衣冠成绘事，百年风谊列幽镌。",
        "铭旌暮暗黄梅雨，乡路秋横碧玉天。",
        "遥想葬期豪杰会，高车连轸驻新阡。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 210029,
      "title": "永寿县君挽词二首  其一",
      "content": [
        "廷尉蒙恩后，兰台就养初。",
        "大椿宜更寿，流水遽焉如。",
        "鸾锦封花诰，蛛丝网板舆。",
        "百年谁考德，琬琰在幽墟。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 210030,
      "title": "永寿县君挽词二首  其二",
      "content": [
        "明世辞隆养，哀荣道路传。",
        "赙丧从上宰，歌挽出群仙。",
        "素幔伤秋泛，青缸惨夜船。",
        "玉峰归葬处，木拱雁连天。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 210031,
      "title": "曾子固哀词",
      "content": [
        "皇受命而熙洽兮，实千祀而一时。",
        "协气鬰而四塞兮，与盛德其俱升。",
        "麟凤出而旁午兮，犹氤氲而扶舆。",
        "笃生我公兮，以文章为世师。",
        "公神禹之苗裔兮，肇子爵而鄫封。",
        "逮去邑而为氏兮，季叶汩其南征。",
        "祖骞翔而绩著兮，考踡跼而文鸣。",
        "公既生而多艰兮，踵祖武而好修。",
        "既轻车又良御兮，遂大放乎厥词。",
        "发天人之奥秘兮，约六艺而成章。",
        "元气含而未泄兮，洞芒芴而窅冥。",
        "挽天河而一泻兮，物应手而华昌。",
        "揖扬马使先路兮，咸告公曰不敢。",
        "彼崔蔡之纷纷兮，孰云窥其藩翰。",
        "辰来迟而去速兮，固前修以跋疐。",
        "方盘礴而上征兮，遽相羊而补外。",
        "皇揆公之忠诚兮，即商墟而赐环。",
        "䌷史谍乎东观兮，裁诰命乎西垣。",
        "典章绝而复作兮，世争睹而快先。",
        "正经纬乎终古兮，配维斗而昭然。",
        "变化诡而难常兮，虽司命其或昧。",
        "忽遭艰而去国兮，遂衔哀而即世。",
        "述作纷其具存兮，怅爽灵之焉诣。",
        "信百年不斯须兮，遒电灭而焱逝。",
        "天不憗遗一老兮，固搢绅之所伤。",
        "矧不肖以薄技兮，早获进于门墙。",
        "路贯江而修阻兮，曾莫奠乎酒浆。",
        "悲填膺而茀鬰兮，聊自托于斯文。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 210032,
      "title": "蔡氏哀词",
      "content": [
        "惟夫人之高谊兮，真一时之女英。",
        "既富有此好德兮，又申之以令仪。",
        "带幽蕙之缥缈兮，佩明月之陆离。",
        "人自操舍之不一兮，雅独取善以自持。",
        "何报施之或忒兮，罹祸艰于不虞。",
        "颜色炫而未暮兮，所天忽以殒俎。",
        "痛平素之偕处兮，忍此奄奄而嫠居。",
        "沥哀血以自誓兮，甘饵毒而捐躯。",
        "佩珠玉以死真兮，固众女之所嗤。",
        "曷卓越以不顾兮，弃性命其如遗。",
        "美不可强有兮，信天资之所开。",
        "要反心以内省兮，岂或售乎人知。",
        "嗟三晨之未浃兮，遂俱游而莫留。",
        "死者有知兮，羌魂魄以并游。",
        "日黄昏而不见兮，虚室窈其无人。",
        "惟哀风以归来兮，动素幔之襜襜。",
        "何平生之款密兮，遽音声之不可寻。",
        "俨遗迹以在目兮，纷百忧而攻心。",
        "岂至理不吾喻兮，如意厚而悲深。",
        "抚双榇以增恸兮，涕清血而洒襟。",
        "已矣哉，人生有死兮，自前古而既然。",
        "精魄忽其不驻兮，惟修名之可延。",
        "忍录录以寓世兮，信烈者之所羞。",
        "傥佳志之获申兮，虽奄忽其焉悼。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 210033,
      "title": "时宣义挽词",
      "content": [
        "奋发多难里，哀荣后夜中。",
        "妙年推正行，末路见阴功。",
        "风雨双龙合，山川吊鹤空。",
        "悬知青史上，又载一于公。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 210034,
      "title": "中书侍郎挽词二首  其一",
      "content": [
        "崛起商岩后，清忠士论归。",
        "法知商鞅弊，议折董宏非。",
        "迁谪生华发，骞腾上紫微。",
        "又骑箕尾去，朝野涕空挥。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 210035,
      "title": "中书侍郎挽词二首  其二",
      "content": [
        "守道无夷险，如公实寡仇。",
        "望从乌府重，官到凤池休。",
        "二品追褒峻，千金赙恤优。",
        "搢绅终有恨，王骏不封侯。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 210036,
      "title": "吕与叔挽章四首  其一",
      "content": [
        "举举西州士，来为邦国华。",
        "艺文尤尔雅，经术自名家。",
        "正有高山仰，俄成逝水嗟。",
        "贤人各有数，不独岁龙蛇。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 210037,
      "title": "吕与叔挽章四首  其二",
      "content": [
        "数日音容隔，人琴遂已虚。",
        "门生应有谥，国史可无书。",
        "旧室悬蛛网，遗编走蠹鱼。",
        "定无封禅草，平日笑相如。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 210038,
      "title": "吕与叔挽章四首  其三",
      "content": [
        "追惟献岁发春间，和我新诗忆故山。",
        "今日始知诗是谶，魂兮应已度函关。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 210039,
      "title": "吕与叔挽章四首  其四",
      "content": [
        "风流云散了无余，天禄空存旧直庐。",
        "小吏独来开锁钥，案头尘满校残书。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 210040,
      "title": "东平夫人挽章",
      "content": [
        "相阀风流盛，王家地势雄。",
        "室中兰作佩，庭下玉成丛。",
        "啼鸟悲春槛，荒原入夜宫。",
        "遗芳得鸿笔，论次诏无穷。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 210041,
      "title": "开府李公挽章  其一",
      "content": [
        "报国封章数，论交意气真。",
        "先朝贵公子，当代老成人。",
        "月动融尊酒，花催郑驿宾。",
        "谁知古原上，马鬣一朝新。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 210042,
      "title": "开府李公挽章  其二",
      "content": [
        "戚里薨耆旧，哀荣世未如。",
        "襚加三事衮，奠致两宫舆。",
        "卤簿前衢隘，歌钟后院虚。",
        "英风知不坠，芝玉茂庭除。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 210043,
      "title": "孙莘老挽词四首  其一",
      "content": [
        "同功一体尽调元，独抱沉疴反故园。",
        "壶遂暮年非不遇，人生到此可忘言。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 210044,
      "title": "孙莘老挽词四首  其二",
      "content": [
        "青春芸阁妙文词，进读金华鬓若丝。",
        "转守七州多异政，奉常处处有房祠。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 210045,
      "title": "孙莘老挽词四首  其三",
      "content": [
        "月旦尝居第一评，立朝风采照公卿。",
        "门生故吏知多少，尽向碑阴刻姓名。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 210046,
      "title": "孙莘老挽词四首  其四",
      "content": [
        "华屋丘山可柰何，百年光景一投梭。",
        "故人唯有羊昙在，恸哭西州不忍歌。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    }
  ],
