        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 261482,
      "title": "留别柳中庸",
      "content": [
        "惆怅流水时，萧条背城路。",
        "离人出古亭，嘶马入寒树。",
        "江海正风波，相逢在何处。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 261483,
      "title": "野亭三韵送钱员外",
      "content": [
        "野菊开欲稀，寒泉流渐浅。",
        "幽人步林后，叹此年华晚。",
        "倚杖送行云，寻思故山远。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 261484,
      "title": "归山招王逵",
      "content": [
        "日长原野静，杖策步幽𪩘。",
        "雉雊麦苗阴，蝶飞溪草晚。",
        "我生好闲放，此去殊未返。",
        "自是君不来，非关故山远。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261485,
      "title": "过谷口元赞善所居",
      "content": [
        "入谷访君来，秋泉已堪涉。",
        "林间人独坐，月下山相接。",
        "重露湿苍苔，明灯照黄叶。",
        "故交一不见，素发何稠叠。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261486,
      "title": "旅次岐山得山友书却寄凤翔张尹",
      "content": [
        "本与戴征君，同师竹上坐。",
        "偶为名利引，久废论真果。",
        "昨日山信回，寄书来责我。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 261487,
      "title": "九日赠司空文明",
      "content": [
        "我有惆怅词，待君醉时说。",
        "长来逢九日，难与菊花别。",
        "摘却正开花，暂言花未发。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 261488,
      "title": "芜城",
      "content": [
        "昔人登此地，丘陇已前悲。",
        "今日又非昔，春风能几时。",
        "风吹城上树，草没城边路。",
        "城里月明时，精灵自来去。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261489,
      "title": "送吉中孚拜官归楚州",
      "content": [
        "才子神骨清，虚竦眉眼明。",
        "貌应同衞玠，鬓且异潘生。",
        "初戴莓苔帻，来过丞相宅。",
        "满堂归道师，众口宗诗伯。",
        "须臾里巷传，天子亦知贤。",
        "出诏升高士，驰声在少年。",
        "自为才哲爱，日与侯王会。",
        "匡主一言中，荣亲千里外。",
        "更闻仙士友，往往东回首。",
        "驱石不成羊，指丹空毙狗。",
        "孤帆淮上归，商估夜相依。",
        "海雾寒将尽，天星晓欲稀。",
        "潮头来始歇，浦口喧争发。",
        "乡树尚和云，邻船犹带月。",
        "到洞必伤情，巡房见旧名。",
        "醮疎坛路涩，汲少井栏倾。",
        "别我长安道，前期共须老。",
        "方随水向山，肯惜花辞岛。",
        "怅望执君衣，今朝风景好。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 261490,
      "title": "荆州泊",
      "content": [
        "南楼西下时，月里闻来棹。",
        "桂水舳舻回，荆州津济闹。",
        "移帷望星汉，引带思容貌。",
        "今夜一江人，唯应妾身觉。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261491,
      "title": "春游乐",
      "content": [
        "游童苏合弹，倡女蒲葵扇。",
        "初日映城时，相思忽相见。",
        "褰裳蹋路草，理鬓回花面。",
        "薄暮不同归，留情此芳甸。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261492,
      "title": "千里思",
      "content": [
        "凉州风月美，遥望居延路。",
        "泛泛下天云，青青缘塞树。",
        "燕山苏武上，海岛田横住。",
        "更是草生时，行人出门去。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261493,
      "title": "白鹭咏",
      "content": [
        "迥起来应近，高飞去自遥。",
        "映林同落雪，拂水状飜潮。",
        "犹有幽人兴，相逢到碧霄。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 261494,
      "title": "冬夜与故友聚送吉校书",
      "content": [
        "途穷别则怨，何必天涯去。",
        "共作出门人，不见归乡路。",
        "殷勤执杯酒，怅望送亲故。",
        "月色入闲轩，风声落高树。",
        "云霄望且远，齿发行应暮。",
        "九日泣黄花，三秋悲白露。",
        "君行过洛阳，莫向青山度。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 261495,
      "title": "与苗员外山行",
      "content": [
        "古人留路去，今日共君行。",
        "若待青山尽，应逢白发生。",
        "谁知到兰若，流落一书名。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 261496,
      "title": "早春同庾侍郎题青龙上方院",
      "content": [
        "相见惜余辉，齐行登古寺。",
        "风烟结远恨，山水含芳意。",
        "车马莫前归，留看巢鹤至。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 261497,
      "title": "送从叔赴洪州",
      "content": [
        "荣家兼佐幕，叔父似还乡。",
        "王粲名虽重，郄超髯未长。",
        "鸣桡过夏口，敛笏见浔阳。",
        "后夜相思处，中庭月一方。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261498,
      "title": "送路司谏侍从叔赴洪州",
      "content": [
        "郄超本绝伦，得意在芳春。",
        "勋业耿家盛，风流荀氏均。",
        "声名金作赋，白皙玉为身。",
        "敛笏辞天子，乘龟从丈人。",
        "度关行且猎，鞍马何躞蹀。",
        "猿啸暮应愁，湖流春好涉。",
        "浔阳水分送，于越山相接。",
        "梅雨细如丝，蒲帆轻似叶。",
        "逢风燕不定，值石波先叠。",
        "楼见远公庐，船经徐穉业。",
        "邑人多秉笔，州吏亦负笈。",
        "村女解收鱼，津童能用檝。",
        "唯我有荆扉，无成未得归。",
        "见君兄弟出，今日自霑衣。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 261499,
      "title": "病后游青龙寺",
      "content": [
        "病来形貌秽，斋沫入东林。",
        "境静闻神远，身羸向道深。",
        "芭蕉高自折，荷叶大先沈。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 261500,
      "title": "夜寻司空文明逢深上人因寄晋侍御",
      "content": [
        "鹤裘筇竹杖，语笑过林中。",
        "正是月明夜，陶家见远公。",
        "自嫌山客务，不与汉官同。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 261501,
      "title": "长安书事寄薛戴",
      "content": [
        "朔雁去成行，哀蝉响如昨。",
        "时芳一憔悴，暮序何萧索。",
        "笑语且无聊，逢迎多约略。",
        "三山不可见，百岁空挥霍。",
        "故事尽为愁，新知无复乐。",
        "夫君又离别，而我加寂寞。",
        "惠远纵相寻，陶潜祗独酌。",
        "主人恩则厚，客子才自薄。",
        "委曲见提携，因循成蹇剥。",
        "论边书未上，招隐诗还作。",
        "贵者已朝餐，岂能敦宿诺。",
        "飞禽虽失树，流水长思壑。",
        "千里寄琼枝，梦寐青山郭。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 261502,
      "title": "鲜于少府宅看花",
      "content": [
        "谢家能植药，万簇相萦倚。",
        "烂熳绿苔前，婵娟青草里。",
        "垂栏复照户，映竹仍临水。",
        "骤雨发芳香，回风舒锦绮。",
        "孤光杂新故，众色更重累。",
        "散碧出疎茎，分黄成细蘂。",
        "游蜂高更下，惊蝶坐还起。",
        "玉貌对应慙，霞标方不似。",
        "春阴怜弱蔓，夏日同短晷。",
        "回落报荣衰，交关鬬红紫。",
        "花时苟未赏，老至谁能止。",
        "上客屡移床，幽僧劳凭几。",
        "初合虽薄劣，却得陪君子。",
        "敢问贤主人，何如种桃李。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 261503,
      "title": "慈恩寺怀旧",
      "content": [
        "去者不可忆，旧游相见时。",
        "凌霄徒更发，非是看花期。",
        "倚玉交文友，登龙年月久。",
        "东阁许联床，西郊亦携手。",
        "彼苍何暖昧，薄劣翻居后。",
        "重入远师谿，谁尝陶令酒。",
        "伊昔会禅宫，容辉在眼中。",
        "篮舆来问道，玉柄解谈空。",
        "孔席亡颜子，僧堂失谢公。",
        "遗文一书壁，新竹再移丛。",
        "始聚终成散，朝欢暮不同。",
        "春霞方照日，夜烛忽迎风。",
        "蚁鬬声犹在，鸮灾道已穷。",
        "问天应默默，归宅太匆匆。",
        "凄其履还路，莽苍云林暮。",
        "九陌似无人，五陵空有雾。",
        "缅怀山阳笛，永恨平原赋。",
        "错莫过门栏，分明识行路。",
        "上智本全真，郄公况重臣。",
        "唯应抚灵运，暂是忆嘉宾。",
        "存信松犹小，缄哀草尚新。",
        "鲤庭埋玉树，那忍见门人。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 261504,
      "title": "赠薛戴",
      "content": [
        "晓雾忽为霜，寒蝉还罢响。",
        "行人在长道，日暮多归想。",
        "射策本何功，名登绛帐中。",
        "遂矜丘室重，不料阮途穷。",
        "交结慙时辈，龙钟似老翁。",
        "机非鄙夫正，懒是平生性。",
        "欹枕鸿雁高，闭关花药盛。",
        "厨烟当雨绝，阶竹连窗暝。",
        "欲赋苦饥行，无如消渴病。",
        "旧业历胡尘，荒原少四邻。",
        "田园空有处，兄弟未成人。",
        "毛义心长苦，袁安家转贫。",
        "今呈胸臆事，当为泪沾巾。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 261505,
      "title": "东门送客",
      "content": [
        "绿杨新草路，白发故乡人。",
        "既壮还应老，游梁复滞秦。",
        "逢花莫漫折，能有几多春。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 261506,
      "title": "送韩绅卿",
      "content": [
        "春雨昨开花，秋霜忽霑草。",
        "荣枯催日夕，去住皆须老。",
        "君望汉家原，高坟渐成道。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 261507,
      "title": "襄阳曲",
      "content": [
        "襄阳堤路长，草碧柳枝黄。",
        "谁家女儿临夜妆，红罗帐里有灯光。",
        "雀钗翠羽动明珰，欲出不出脂粉香。",
        "同居女伴正衣裳，中庭寒月白如霜。",
        "贾生十八称才子，空得门前一断肠。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 261508,
      "title": "胡腾儿",
      "content": [
        "胡腾身是凉州儿，肌肤如玉鼻如锥。",
        "桐布轻衫前后卷，葡萄长带一边垂。",
        "帐前跪作本音语，拾襟搅袖为君舞。",
        "安西旧牧收泪看，洛下词人抄曲与。",
        "扬眉动目踏花毡，红汗交流珠帽偏。",
        "醉却东倾又西倒，双靴柔弱满灯前。",
        "环行急蹴皆应节，反手叉腰如却月。",
        "丝桐忽奏一曲终，呜呜画角城头发。",
        "胡腾儿，胡腾儿，故乡路断知不知。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 261509,
      "title": "赠康洽",
      "content": [
        "黄须康兄酒泉客，平生出入王侯宅。",
        "今朝醉卧又明朝，忽忆故乡头已白。",
        "流年恍惚瞻西日，陈事苍茫指南陌。",
        "声名恒压鲍参军，班位不过扬执戟。",
        "迩来七十遂无机，空是咸阳一布衣。",
        "后辈轻肥贱衰朽，五侯门馆许因依。",
        "自言万物有移改，始信桑田变成海。",
        "同时献赋人皆尽，共壁题诗君独在。",
        "步出东城风景和，青山满眼少年多。",
        "汉家尚壮今则老，发短心长知奈何。",
        "华堂举杯白日晚，龙钟相见谁能免。",
        "君今已反我正来，朱颜宜笑能几回。",
        "借问朦胧花树下，谁家畚插筑高台。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 261510,
      "title": "瘦马行",
      "content": [
        "城傍牧马驱未过，一马徘徊起还卧。",
        "眼中有泪皮有疮，骨毛焦瘦令人伤。",
        "朝朝放在儿童手，谁觉举头看故乡。",
        "往时汉地相驰逐，如雨如风过平陆。",
        "岂意今朝驱不前，蚊蚋满身泥上腹。",
        "路人识是名马儿，畴昔三军不得骑。",
        "玉勒金鞍既已远，追奔获兽有谁知。",
        "终身枥上食君草，遂与驽骀一时老。",
        "傥借长鸣陇上风，犹期一战安西道。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 261511,
      "title": "杂歌呈郑锡司空文明",
      "content": [
        "昨宵梦到亡何乡，忽见一人山之阳。",
        "高冠长剑立石堂，鬓眉飒爽瞳子方。",
        "胡麻作饭琼作浆，素书一帙在柏床。",
        "啖我还丹拍我背，令我延年在人代。",
        "乃书数字与我持，小儿归去须读之。",
        "觉来知是虚无事，山中雪平云覆地。",
        "东岭啼猿三四声，卷帘一望心堪碎。",
        "蓬莱有梯不可蹑，向海回头泪盈睫。",
        "且闻童子是苍蝇，谁谓庄生异蝴蝶。",
        "学仙去来辞故人，长安道路多风尘。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 261512,
      "title": "杂歌",
      "content": [
        "汉水至清泥则浊，松枝至坚萝则弱。",
        "十三女儿事他家，颜色如花终索寞。",
        "兰生当门燕巢幙，兰芽未吐燕泥落。",
        "为姑偏忌诸嫂良，作妇翻嫌壻家恶。",
        "人生照镜须自知，无盐何用妬西施。",
        "秦庭野鹿忽为马，巧伪乱真君试思。",
        "伯奇掇蜂贤父逐，曾参杀人慈母疑。",
        "酒沽千日人不醉，琴弄一弦心已悲。",
        "常闻善交无尔汝，谗口甚甘良药苦。",
        "山鸡锦翼岂凤凰，陇鸟人言止鹦鹉。",
        "向栩非才徒隐灶，田文有命那关户。",
        "犀烛江行见鬼神，木人登席呈歌舞。",
        "乐生东去终居赵，阳虎北辕飜适楚。",
        "世间反复不易陈，缄此贻君泪如雨。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 261513,
      "title": "乌栖曲",
      "content": [
        "白马逐朱车，黄昏入狭斜。",
        "狭斜柳树乌争宿，争枝未得飞上屋。",
        "东房少妇壻从军，每听乌啼知夜分。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 261514,
      "title": "送客东归",
      "content": [
        "昨夜东风吹尽雪，两京路上梅花发。",
        "行人相见便东西，日暮溪头饮马别。",
        "把君衫袖望垂杨，两行泪下思故乡。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 261515,
      "title": "王敬伯歌",
      "content": [
        "妾本舟中女，闻君江上琴。",
        "君初感妾意，妾亦感君心。",
        "遂出合欢被，同为交颈禽。",
        "传杯唯畏浅，接膝犹嫌远。",
        "侍婢奏箜篌，女郎歌宛转。",
        "宛转怨如何，中庭霜渐多。",
        "霜多叶可惜，昨日非今夕。",
        "徒结万重欢，终成一宵客。",
        "王敬伯，绿水青山从此隔。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 261516,
      "title": "救生寺望春寄畅当",
      "content": [
        "东西南北望，望远悲潜蓄。",
        "红黄绿紫花，花开看不足。",
        "今年与子少相随，他年与子老相逐。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 261517,
      "title": "荆门歌送兄赴夔州",
      "content": [
        "余兄佐郡经西楚，饯行因赋荆门雨。",
        "𩆵𩆵燮燮声渐繁，浦里人家收市喧。",
        "重阴大点过欲尽，碎浪柔文相与飜。",
        "云间怅望荆衡路，万里青山一时暮。",
        "琵琶寺里响空廊，熨斗陂前湿荒戍。",
        "沙尾长樯发渐稀，竹竿草𪨗涉流归。",
        "夷陵已远半成烧，汉上游倡始濯衣。",
        "船门相对多商估，葛服龙钟篷下语。",
        "自是湘州石燕飞，那关齐地商羊舞。",
        "曾为江客念江行，肠断秋荷雨打声。",
        "摩天古木不可见，住岳高僧空得名。",
        "今朝拜首临欲别，遥忆荆门雨中发。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 261518,
      "title": "妾薄命",
      "content": [
        "忆妾初嫁君，花鬟如绿云。",
        "回灯入绮帐，转面脱罗裙。",
        "折步教人学，偷香与客熏。",
        "容颜南国重，名字北方闻。",
        "一从失恩意，转觉身顦顇。",
        "对镜不梳头，倚窗空落泪。",
        "新人莫恃新，秋至会无春。",
        "从来闭在长门者，必是宫中第一人。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 261519,
      "title": "关山月",
      "content": [
        "露湿月苍苍，关头榆叶黄。",
        "回轮照海远，分彩上楼长。",
        "水冻频移幕，兵疲数望乡。",
        "只应城影外，万里共胡霜。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 261520,
      "title": "度关山",
      "content": [
        "雁塞日初晴，狐关雪复平。",
        "危楼缘广漠，古窦傍长城。",
        "拂剑金星出，弯弧玉羽鸣。",
        "谁知系虏者，贾谊是书生。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261521,
      "title": "巫山高",
      "content": [
        "巫山十二峰，皆在碧虚中。",
        "回合云藏月，霏微雨带风。",
        "猿声寒过涧，树色暮连空。",
        "愁向高唐望，清秋见楚宫。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261522,
      "title": "雨雪曲",
      "content": [
        "天山一丈雪，杂雨夜霏霏。",
        "湿马胡歌乱，经烽汉火微。",
        "丁零苏武别，疎勒范羌归。",
        "若看关头下，长榆叶定稀。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261523,
      "title": "春游乐",
      "content": [
        "柘弹连钱马，银钩妥堕鬟。",
        "摘桑春陌上，踏草夕阳间。",
        "意合辞先露，心诚貌却闲。",
        "明朝若相忆，云雨出巫山。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261524,
      "title": "山下泉",
      "content": [
        "碧水暎丹霞，溅溅度浅沙。",
        "暗通山下草，流出洞中花。",
        "净色和云落，喧声遶石斜。",
        "明朝更寻去，应到阮郎家。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261525,
      "title": "送客赴洪州",
      "content": [
        "草色随骢马，悠悠共出秦。",
        "水传云梦晓，山接洞庭春。",
        "帆影连三峡，猿声在四邻。",
        "青门一分手，难见杜陵人。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261526,
      "title": "与郑锡游春",
      "content": [
        "东门垂柳长，回首独心伤。",
        "日煖临芳草，天晴忆故乡。",
        "暎花鸎上下，过水蝶飞扬。",
        "借问同行客，今朝泪几行。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261527,
      "title": "送友人",
      "content": [
        "闻说湘川路，年年古木多。",
        "猿啼巫峡夜，月照洞庭波。",
        "穷海人还去，孤城雁与过。",
        "青山不同赏，来往自蹉跎。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 261528,
      "title": "题从叔沆林园",
      "content": [
        "阮宅闲园暮，窗中见树阴。",
        "樵歌依远草，僧语过长林。",
        "鸟哢花间曲，人弹竹里琴。",
        "自嫌身未老，已有住山心。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261529,
      "title": "送少微上人入蜀",
      "content": [
        "削发本求道，何方不是归。",
        "松风开法席，江月濯禅衣。",
        "飞阁蝉鸣早，漫天客过稀。",
        "戴颙常执笔，不觉此身非。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261530,
      "title": "雨后游辋川",
      "content": [
        "骤雨归山尽，颓阳入辋川。",
        "看虹登晚墅，踏石过春泉。",
        "紫葛藏仙井，黄花出野田。",
        "自知无路去，回步就人烟。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261531,
      "title": "同皇甫侍御题惟一上人房",
      "content": [
        "焚香居一室，尽日见空林。",
        "得道轻年暮，安禅爱夜深。",
        "东西皆是梦，存没岂关心。",
        "唯羡诸童子，持经在竹阴。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261532,
      "title": "同苗员外宿荐福寺僧舍",
      "content": [
        "潘安秋兴动，凉夜宿僧房。",
        "倚杖云离月，垂帘竹有霜。",
        "回风生远迳，落叶飒长廊。",
        "一与交亲会，空贻别后伤。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261533,
      "title": "送客往湘江",
      "content": [
        "识君年已老，孤棹向潇湘。",
        "素发临高镜，清晨入远乡。",
        "三山分夏口，五两映涔阳。",
        "更逐巴东客，南行泪几行。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261534,
      "title": "送友人游蜀",
      "content": [
        "嘉陵天气好，百里见双流。",
        "帆影缘巴字，钟声出汉州。",
        "绿原春草晚，青木暮猿愁。",
        "本是风流地，游人易白头。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 261535,
      "title": "送友人游江东",
      "content": [
        "江上花开尽，南行见杪春。",
        "鸟声悲古木，云影入通津。",
        "返景斜连草，回潮暗动苹。",
        "谢公今在郡，应喜得诗人。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 261536,
      "title": "送乐平苗明府得家字",
      "content": [
        "本自求彭泽，谁云道里赊。",
        "山从石壁断，江向弋阳斜。",
        "暮色随枫树，阴云暗荻花。",
        "诸侯旧调鼎，应重宰臣家。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261537,
      "title": "过宋州",
      "content": [
        "睢阳陷虏日，外绝救兵来。",
        "世乱忠臣死，时清明主哀。",
        "荒郊春草徧，故垒野花开。",
        "欲为将军哭，东流水不回。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261538,
      "title": "茂陵山行陪韦金部",
      "content": [
        "宿雨朝来歇，空山秋气清。",
        "盘云双鹤下，隔水一蝉鸣。",
        "古道黄花落，平芜赤烧生。",
        "茂陵虽有病，犹得伴君行。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261539,
      "title": "江上逢司空曙",
      "content": [
        "共尔髫年故，相逢万里余。",
        "新春两行泪，故国一封书。",
        "夏口帆初落，涔阳雁正疎。",
        "唯当执杯酒，暂食汉江鱼。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261540,
      "title": "逢王泌自东京至",
      "content": [
        "逢君自乡至，雪涕问田园。",
        "几处生乔木，谁家在旧村。",
        "山峰横二室，水色映千门。",
        "愁见游从处，如今花正繁。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261541,
      "title": "山中期吉中孚",
      "content": [
        "行人路不同，花落到山中。",
        "水暗蒹葭雾，月明杨柳风。",
        "年华惊已掷，志业飒然空。",
        "何必龙钟后，方期事远公。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261542,
      "title": "酬前大理寺评事张芬",
      "content": [
        "君家旧林壑，寄在乱峰西。",
        "近日春云满，相思路亦迷。",
        "闻钟投野寺，待月过前溪。",
        "怅望成幽梦，依依识故蹊。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261543,
      "title": "赋得山泉送房造",
      "content": [
        "泉水山边去，高人月下看。",
        "润松秋色净，落涧夜声寒。",
        "委曲穿深竹，潺湲过远滩。",
        "圣朝无隐者，早晚罢渔竿。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261544,
      "title": "宿兴善寺后堂池",
      "content": [
        "草堂高树下，月向后池生。",
        "野客如僧静，新荷共水平。",
        "锦鳞沉不食，绣羽乱相鸣。",
        "即事思江海，谁能万里行。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261545,
      "title": "忆皎然上人",
      "content": [
        "未得从师去，人间万事劳。",
        "云门不可见，山木已应高。",
        "向日开柴户，惊秋问敝袍。",
        "何由宿峰顶，窗里望波涛。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261546,
      "title": "赠衡岳隐禅师",
      "content": [
        "旧住衡州寺，随缘偶北来。",
        "夜禅山雪下，朝汲竹门开。",
        "半偈传初尽，群生意未回。",
        "唯当与樵者，杖锡入天台。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261547,
      "title": "云阳观寄袁稠",
      "content": [
        "花洞晚阴阴，仙坛隔杏林。",
        "漱泉春谷冷，捣药夜窗深。",
        "石上开仙酌，松间对玉琴。",
        "戴家溪北住，雪后去相寻。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261548,
      "title": "晚游东田寄司空曙",
      "content": [
        "暮来思远客，独立在东田。",
        "片雨无妨景，残虹不映天。",
        "别愁逢夏果，归兴入秋蝉。",
        "莫作隳官意，陶潜未必贤。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261549,
      "title": "题崔端公园林",
      "content": [
        "上士爱清辉，开门向翠微。",
        "抱琴看鹤去，枕石待云归。",
        "野坐苔生席，高眠竹挂衣。",
        "旧山东望远，惆怅暮花飞。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261550,
      "title": "早春雪夜寄卢纶兼呈秘书元丞",
      "content": [
        "闻君随谢朓，春夜宿前川。",
        "看竹云垂地，寻僧月满田。",
        "熊寒方入树，鱼乐稍离船。",
        "独夜羇愁客，惟知惜故年。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261551,
      "title": "早春夜集耿拾遗宅",
      "content": [
        "如何逋客会，忽在侍臣家。",
        "新草犹停雪，寒梅未放花。",
        "衔杯鸡欲唱，逗月雁应斜。",
        "年齿俱憔悴，谁堪故国赊。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261552,
      "title": "元丞宅送胡濬及第东归觐省",
      "content": [
        "登龙兼折桂，归去当高车。",
        "旧楚枫犹在，前隋柳已疎。",
        "月中逢海客，浪里得乡书。",
        "见说江边住，知君不厌鱼。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261553,
      "title": "送魏广下第归扬州宁亲",
      "content": [
        "游宦今空返，浮淮一雁秋。",
        "白云阴泽国，青草遶扬州。",
        "调膳过花下，张筵到水头。",
        "昆山仍有玉，岁晏莫淹留。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261554,
      "title": "归山与酒徒别",
      "content": [
        "野客本无事，此来非有求。",
        "烦君征乐饯，未免忆山愁。",
        "红烛侵明月，青娥促白头。",
        "童心久已尽，岂为艳歌留。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261555,
      "title": "冬夜寄韩弇",
      "content": [
        "独坐知霜下，开门见木衰。",
        "壮应随日去，老岂与人期。",
        "废井虫鸣早，阴阶菊发迟。",
        "兴来空忆戴，不似剡溪时。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261556,
      "title": "闻吉道士还俗因而有赠",
      "content": [
        "闻有华阳客，儒裳谒紫微。",
        "旧山连药卖，孤鹤带云归。",
        "柳市名犹在，桃源梦已稀。",
        "还乡见鸥鸟，应愧背船飞。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261557,
      "title": "韦员外东斋看花",
      "content": [
        "入花凡几步，此树独相留。",
        "发艳红枝合，垂烟绿水幽。",
        "倂开偏觉好，未落已成愁。",
        "一到芳菲下，空招两鬓秋。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261558,
      "title": "边头作",
      "content": [
        "邠郊泉脉动，落日上城楼。",
        "羊马水草足，羌胡帐幕稠。",
        "射雕过海岸，传箭怯边州。",
        "何事归朝将，今年又拜侯。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261559,
      "title": "宿深上人院听远泉",
      "content": [
        "泉声宜远听，入夜对支公。",
        "断续来方尽，潺湲咽又通。",
        "何年出石下，几里在山中。",
        "君问穷源处，禅心与此同。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261560,
      "title": "茂陵村行赠何兆",
      "content": [
        "春天黄鸟啭，野迳白云闲。",
        "解带依芳草，支颐想故山。",
        "人行九州路，树老五陵间。",
        "谁道临邛远，相如自忆还。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    }
  ],
