{
  "data": [
    {
      "id": 255094,
      "title": "鼓吹曲辞 巫山高",
      "content": [
        "巫山十二峰，皆在碧虚中。",
        "回合云藏日，霏微雨带风。",
        "猨声寒过水，树色暮连空。",
        "愁向高唐望，清秋见楚宫。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 255207,
      "title": "横吹曲辞 折杨柳",
      "content": [
        "东城攀柳叶，柳叶低著草。",
        "少壮莫轻年，轻年有人老。",
        "柳发徧川岗，登高堪断肠。",
        "雨烟轻漠漠，何树近君乡？",
        "赠君折杨柳，颜色岂能久。",
        "上客莫霑巾，佳人正回首。",
        "新柳送君行，古柳伤君情。",
        "突兀临荒渡，婆娑出旧营。",
        "隋家两岸尽，陶宅五株平。",
        "日暮偏愁望，春山有鸟声。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 255219,
      "title": "横吹曲辞 关山月",
      "content": [
        "露湿月苍苍，关头榆叶黄。",
        "回轮照海远，分彩上楼长。",
        "水冻频移幕，兵疲数望乡。",
        "祗应城影外，万里共如霜。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 255245,
      "title": "横吹曲辞 雨雪曲",
      "content": [
        "天山一丈雪，杂雨夜霏霏。",
        "湿马胡歌乱，经烽汉火微。",
        "丁零苏武别，疎勒范羌归。",
        "若著关头过，长榆叶定稀。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 255283,
      "title": "相和歌辞 度关山",
      "content": [
        "雁塞日初晴，胡关雪复平。",
        "危竿缘广漠，古窦傍长城。",
        "拔劒金星出，弯弧玉羽鸣。",
        "谁知系虏者，贾谊是书生。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 255334,
      "title": "相和歌辞 昭君词",
      "content": [
        "李陵初送子卿回，汉月明明照帐来。",
        "忆著长安旧游处，千门万户玉楼台。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 255640,
      "title": "相和歌辞 乌栖曲",
      "content": [
        "白马逐牛车，黄昏入狭斜。",
        "狭斜柳树乌争宿，争枝未得飞上屋。",
        "东房少妇壻从军，每听乌啼知夜分。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 255656,
      "title": "相和歌辞 襄阳曲",
      "content": [
        "襄阳堤路长，草碧杨柳黄。",
        "谁家女儿临夜妆，红罗帐里有灯光。",
        "雀钗翠羽动明珰，欲出不出脂粉香。",
        "同居女伴正衣裳，中庭寒月白如霜。",
        "贾生十八称才子，空得门前一断肠。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 255819,
      "title": "琴曲歌辞 王敬伯歌",
      "content": [
        "妾本舟中客，闻君江上琴。",
        "君初感妾叹，妾亦感君心。",
        "遂出合欢被，同为交颈禽。",
        "传杯惟畏浅，接膝犹嫌远。",
        "侍婢奏箜篌，女郎歌宛转。",
        "宛转怨如何，中庭霜渐多。",
        "霜多叶可惜，昨日非今夕。",
        "徒结万里欢，终成一宵客。",
        "王敬伯，渌水青山从此隔。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 255863,
      "title": "杂曲歌辞 妾薄命三首 一",
      "content": [
        "忆妾初嫁君，花鬟如绿云。",
        "回灯入绮帐，对面脱罗裙。",
        "折步教人学，偷香与客熏。",
        "容颜南国重，名字北方闻。",
        "一从失恩意，转觉身憔悴。",
        "对镜不梳头，倚窗空落泪。",
        "新人莫恃新，秋至会无春。",
        "从来闭在长门者，必是宫中第一人。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 255864,
      "title": "杂曲歌辞 妾薄命三首 二",
      "content": [
        "玉垒城边争走马，铜蹏市里共乘舟。",
        "鸣环动佩思无尽，掩袖低巾泪不流。",
        "畴昔将歌邀客醉，如今欲舞对君羞。",
        "忍怀贱妾平生曲，独上襄阳旧酒楼。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 255865,
      "title": "杂曲歌辞 妾薄命三首 三",
      "content": [
        "自从君弃妾，憔悴不羞人。",
        "惟余坏粉泪，未免映衫匀。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 255997,
      "title": "杂曲歌辞 千里思",
      "content": [
        "凉州风月美，遥望居延路。",
        "泛泛下天云，青青缘塞树。",
        "燕山苏武上，海岛田横住。",
        "更是草生时，行人出门去。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 256039,
      "title": "杂曲歌辞 古别离二首 一",
      "content": [
        "水国叶黄时，洞庭霜落夜。",
        "行舟闻商估，宿在枫林下。",
        "此地送君还，茫茫似梦间。",
        "后期知几日，前路转多山。",
        "巫峡通湘浦，迢迢隔云雨。",
        "天晴见海樯，月落闻津鼓。",
        "人老自多愁，水深难急流。",
        "清宵歌一曲，白首对汀洲。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 256040,
      "title": "杂曲歌辞 古别离二首 二",
      "content": [
        "与君桂阳别，令君岳阳待。",
        "后事忽差池，前期日空在。",
        "木落鴈嗷嗷，洞庭波浪高。",
        "远山云似盖，极浦树如毫。",
        "朝发能几里，暮来风又起。",
        "如何两处愁，皆在孤舟里。",
        "昨夜天月明，长川寒且清。",
        "菊花开欲尽，荠菜拍来生。",
        "下江帆势速，五两遥相逐。",
        "欲问去时人，知投何处宿。",
        "空令猨啸时，泣对湘潭竹。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 256074,
      "title": "杂曲歌辞 荆州泊",
      "content": [
        "南楼西下时，月里闻来棹。",
        "桂水舳舻回，荆州津济闹。",
        "移帷望星汉，引带思容貌。",
        "今夜一江人，惟应妾身觉。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 256151,
      "title": "杂曲歌辞 春游乐二首 一",
      "content": [
        "游童苏合带，倡女蒲葵扇。",
        "初日映城时，相思忽相见。",
        "褰裳踏露草，理鬓回花面。",
        "薄暮不同归，留情此芳甸。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 256152,
      "title": "杂曲歌辞 春游乐二首 二",
      "content": [
        "柘弹连钱马，银钩妥堕鬟。",
        "采桑春陌上，踏草夕阳间。",
        "意合辞先露，心诚貌却闲。",
        "明朝若相忆，云雨出巫山。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
