{
  "data": [
    {
      "id": 13540,
      "title": "峡中逢雪",
      "content": [
        "峡内逢霏霰，凌辰望已迷。",
        "寒花才集栈，斜片旋沈溪。",
        "户入垂缯壤，田成种玉畦。",
        "速干殊未惜，山道润无泥。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13541,
      "title": "冒雪马上作",
      "content": [
        "大雪浃天畿，晨骖望禁扉。",
        "二仪连皓气，万物共清辉。",
        "楼迥标银阙，台寒压粉围。",
        "瑞花真有意，偏著入朝衣。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13542,
      "title": "四望亭",
      "content": [
        "秋城聊一眺，物色已苍茫。",
        "爽籁风驱远，寒烟晚曳长。",
        "祠成樗作社，戍罢女留墙。",
        "要是凋年感，能回倦客肠。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13543,
      "title": "秋日书怀",
      "content": [
        "秋旻荡喧浊，茂宰属高情。",
        "水遶溪初浪，林干籁自声。",
        "醉茵留剩暖，欢瑟泛余清。",
        "尚念江湖守，其如华发生。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13544,
      "title": "送潘秘校赴颍上簿",
      "content": [
        "捧檄去三铨，招招客叩船。",
        "倦游惊密雪，离思著幺弦。",
        "淮月开帆暝，京尘减绶鲜。",
        "枳鸾非久息，刷羽𥩟来旋。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13545,
      "title": "送南顿胡簿",
      "content": [
        "密雪妍辞盛，垂窗怒翼开。",
        "聊从百里佐，初露七年材。",
        "集隼趋侯府，歌骊酧客罍。",
        "时年无道茀，庇邑迩天台。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13546,
      "title": "舟中三首  其一",
      "content": [
        "舟行不碍动，纵目望联隄。",
        "稍觉前川近，徐惊后树低。",
        "鱼游随聚沫，禽度带残啼。",
        "自趣家田路，春清况日携。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13547,
      "title": "舟中三首  其二",
      "content": [
        "漠漠朝烟上，霏霏野气和。",
        "惊鸿自去渚，戏鹜不沈波。",
        "田畯耕扶耒，溪童食啄蠡。",
        "绀舟时一眺，䍧践损春莎。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13548,
      "title": "舟中三首  其三",
      "content": [
        "雾迥𫄠林趾，波生啮岸沙。",
        "漫红披杏带，短碧上蒲芽。",
        "鲑菜随宜有，浆醪不用赊。",
        "行行乐萧散，未觉远京华。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13549,
      "title": "物外亭",
      "content": [
        "飞宇冠苍岑，盘盘上百寻。",
        "风含太虚爽，云作下方阴。",
        "坞桂寒仍燠，岩猿暝始吟。",
        "知君有高兴，天壤共登临。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13550,
      "title": "秋日咏庭树",
      "content": [
        "庭树报秋归，萧然芳意衰。",
        "露危阴处叶，风劲暝前枝。",
        "嘒嘒蝉嘶早，梢梢鹊定迟。",
        "江潭正摇落，司马不无悲。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13551,
      "title": "司徒侍中宣献公挽词二首  其一",
      "content": [
        "斯文推旧德，忧国变华颠。",
        "夙夜劳三事，东西止百年。",
        "温辞联册秘，良史大都传。",
        "他日贤臣垅，心知望圃田。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13552,
      "title": "司徒侍中宣献公挽词二首  其二",
      "content": [
        "美疢交明晦，浮龄讵控抟。",
        "宗盟一个弱，人赎百身难。",
        "赐歛荣𫄨衮，临哀驻玉銮。",
        "欲知桃李爱，朝绂共汍澜。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13553,
      "title": "送蒙城簿谢煜先辈",
      "content": [
        "曾第飘飘赋，仍劳冉冉趋。",
        "叹时三嗅雉，倦别一飞凫。",
        "句簿虚公几，迎浆溢里壶。",
        "异时赍阀阅，明陟在丹涂。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13554,
      "title": "送江阴簿江楚材先辈",
      "content": [
        "黉舍久过从，清言服阿戎。",
        "半纶人结绶，一箭水分风。",
        "行稻鲜原绿，攀花杂树红。",
        "羡君谈有助，新论得王充。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13555,
      "title": "送炳宗巢簿",
      "content": [
        "世德封胡后，英游终贾年。",
        "尘缁去郡客，木落渡淮天。",
        "揖吏贪持簿，劳歌倦倚弦。",
        "无忧亲釜薄，新复古圭田。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13556,
      "title": "观相国长城公留题药师院壁",
      "content": [
        "拥节趋瑶县，回舆礼梵仙。",
        "望云催觐日，零雨记归年。",
        "蕙露霏毫润，尼珠入局圆。",
        "斯人具瞻地，二绝贲金田。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13557,
      "title": "题玉溪符上人清风阁",
      "content": [
        "斋橑翠霏间，人高境自闲。",
        "禅心溪上月，佛髻槛前山。",
        "昼漏依莲改，晴云识栋还。",
        "谁持快哉意，来此共跻攀。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13558,
      "title": "李中令挽词二首  其一",
      "content": [
        "家赐齐侯履，人推郤縠文。",
        "结婚荣外馆，谋帅得中军。",
        "盛集追园盖，遒章托陇云。",
        "不图新渚畔，更作死生分。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13559,
      "title": "李中令挽词二首  其二",
      "content": [
        "赠窆充幽隧，鸣箫异素轮。",
        "山丘华屋远，桃李故蹊春。",
        "使幕被愁雾，谈犀委暗尘。",
        "须知悟生灭，终得法为身。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13560,
      "title": "龙岩寺",
      "content": [
        "磴齿缘苍𪩘，簷牙冒紫氛。",
        "楼鸣穿峡濑，堂宿抱峰云。",
        "鸟散生台晏，僧归浴树曛。",
        "居然化城地，长与客尘分。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13561,
      "title": "农阁",
      "content": [
        "菌阁俯江干，西南蜀塞宽。",
        "看云记巫峡，望日省长安。",
        "钿崒峰头碧，霞皴荔子丹。",
        "比来秋物好，谁伴数凭栏。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13562,
      "title": "闻杜宇",
      "content": [
        "传闻望帝冤，底处最堪怜。",
        "蜀月将残夜，巴山欲晓天。",
        "周军尝化鹤，齐后亦为蝉。",
        "物变皆如此，非君是偶然。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13563,
      "title": "春野观农事",
      "content": [
        "茂气回鲜野，寒姿换故林。",
        "败防溪响急，新甽耒痕深。",
        "乳雉嬉原隩，歌牛下浦阴。",
        "吾庐堪学稼，将老有初心。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13564,
      "title": "唐诏监簿池阳市征",
      "content": [
        "五鼓歇津亭，风帆去斗城。",
        "美材王国秀，独木县官征。",
        "萍密浮罂剂，莼丝杂釜羹。",
        "袁郎秋咏去，江月对盈盈。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13565,
      "title": "早秋夜坐",
      "content": [
        "穹旻炎𡏖歇，颢气袭中闺。",
        "倦鹊兼河转，初蟾共月西。",
        "客愁无处所，世虑足端倪。",
        "清客才成泫，皋禽且稳栖。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13566,
      "title": "秋日书怀",
      "content": [
        "风头日萧索，爽气自西岑。",
        "暝戍有传鼓，寒城无罢砧。",
        "未论乡思苦，且念岁华侵。",
        "目羡高高雁，先时到上林。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13567,
      "title": "得伯逢书",
      "content": [
        "书来何所道，报我二毛生。",
        "种种因年化，星星著领明。",
        "别离才几日，感慨若为情。",
        "且莫悲迟暮，须容四海兄。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13568,
      "title": "伯逢欲予买一田墅因成自讼",
      "content": [
        "予从大夫后，禄乃二千余。",
        "簪笔论何事，藏山著底书。",
        "病教年事早，拙使宦情疏。",
        "合治菟裘未，蜗牛尚有庐。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13569,
      "title": "西园晚眺",
      "content": [
        "弱柳蒙蒙密，新花衮衮繁。",
        "贪寻芳蒨远，遂到落霞昏。",
        "亭橑衔山霭，池波撼月痕。",
        "惜春还语客，慎勿诉余樽。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13570,
      "title": "李先辈昆仲见过",
      "content": [
        "有客过穷巷，门罗日晏开。",
        "南州一榻下，平轝二龙来。",
        "霏雪欣谈麈，炊菰乏案杯。",
        "自惭邻壁焰，时照不燃灰。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13571,
      "title": "公园",
      "content": [
        "幽兴足端倪，危桥便见溪。",
        "浪轻鱼喜掷，山近鸟工啼。",
        "弱苇披风溆，凉蔬甲雨畦。",
        "使君来已屡，林下自成蹊。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13572,
      "title": "八月十四日夜东轩饯赵同州志元吴陕州冲卿徐润州君章",
      "content": [
        "明月不常值，中秋能暂新。",
        "谁言一堂上，相与异州人。",
        "适意苦难得，举杯宁厌频。",
        "清光定千里，他日远相亲。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13573,
      "title": "访隠者因题壁",
      "content": [
        "岩径蹑云层，藤萝失晦明。",
        "青谿一道士，篮轝两门生。",
        "山溜足奔响，松风无罢声。",
        "愿同沮桀侣，林下耦寒耕。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13574,
      "title": "哭郭仲微三首  其一",
      "content": [
        "仓卒闻婴疾，何辜遂没身。",
        "哭筵同产子，霜寝未亡人。",
        "冢有邢山旧，天为京兆邻。",
        "想君赍志恨，不使白杨春。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13575,
      "title": "哭郭仲微三首  其二",
      "content": [
        "我作鱼符守，君司凤诏文。",
        "他时谈笑罢，今日死生分。",
        "怨涕翻荥浪，悲魂引郑云。",
        "山阳怀旧笛，肠断不堪闻。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13576,
      "title": "哭郭仲微三首  其三",
      "content": [
        "谢氏虽多女，中郎竟乏儿。",
        "人生忽至此，天道果无知。",
        "一代英才往，千篇故稿遗。",
        "生平同翰墨，不及镂丰碑。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13577,
      "title": "夕坐",
      "content": [
        "岸帻坐前楹，天围极望青。",
        "日华开岭雾，风影碎池星。",
        "重露惊栖鹤，幽丛带暗萤。",
        "尘机心久息，宁待据梧瞑。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13578,
      "title": "西楼夕望",
      "content": [
        "炎氛随日入，岑寂坐遥帷。",
        "倦鹜昏投浦，惊蝉夜去枝。",
        "桂华兼月破，槎影带星移。",
        "珍重窗风好，羲人即此时。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13579,
      "title": "偶书",
      "content": [
        "悲秋葆发生，倦客厌离身。",
        "九奏庄禽眩，千钧楚俗轻。",
        "媒劳伤偃蹇，岁晏恨峥嵘。",
        "谁讶游都久，方归谷口耕。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13580,
      "title": "答书  其一",
      "content": [
        "栾栾余病骨，踽踽本孤臣。",
        "夷饿怀餐粟，轲居忆徙邻。",
        "旧围宽胁带，镵刻暗书筠。",
        "亲见扬雄者，容仪不动人。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13581,
      "title": "答书  其二",
      "content": [
        "答书牛马走，卜疏草茅人。",
        "久谢轮囷器，羞言阿堵神。",
        "触笼摧劲翮，喣沫瀑穷鳞。",
        "尚欲求糟粕，心知老斲轮。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13582,
      "title": "和朱少府苦雨",
      "content": [
        "滞淹连春晦，层阴接夜分。",
        "骁壶惟发电，愁栋但生云。",
        "里突居无爨，官蛙坐厌闻。",
        "遥知霖唱罢，客思转相纷。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13583,
      "title": "岁除",
      "content": [
        "雕节真如借，良宵此向阑。",
        "家储宿岁酒，乡送大傩寒。",
        "旧卉回新物，来情续往欢。",
        "匆匆余几刻，催具五辛盘。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13584,
      "title": "咏酒壶",
      "content": [
        "刻像小蹁跹，无情是所怜。",
        "客欢迎指顾，觞冷寄回旋。",
        "屡转疑投节，将休似取妍。",
        "劳君戢深意，醒者勿须传。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13585,
      "title": "答书",
      "content": [
        "经㰅摧无几，书刀削未休。",
        "胡能反招隠，更欲傍牢愁。",
        "澌砚寒余滴，窗灯明映篝。",
        "子威销骨尽，何相得封侯。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13586,
      "title": "望仙亭晚眺",
      "content": [
        "日晏来凭槛，要知刀笔休。",
        "晚云山曲岪，麤饭客稽留。",
        "未觉清言减，犹堪大白浮。",
        "狂歌谁击节，只是自摇头。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13587,
      "title": "明月湖",
      "content": [
        "湖色淡无际，月华相与闲。",
        "临波双璧映，照浦一珠还。",
        "宿火汀洲外，横烟桑柘间。",
        "不妨清思剧，举国尽溪山。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13588,
      "title": "晚眺",
      "content": [
        "危栏真可倚，极目尽高原。",
        "双堠驿边道，孤烟山下村。",
        "高风生树响，寒水落溪痕。",
        "坐见斜阳尽，归鸦满翅昏。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13589,
      "title": "胡同年恢信州弋阳簿",
      "content": [
        "笼樱沈醵宴，津鼓怆离群。",
        "道出东南水，心留西北云。",
        "秫田供酝剂，练幅换书裙。",
        "熛阙方呼俊，归来𥩟献文。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13590,
      "title": "黄垍勾建昌簿",
      "content": [
        "灵风彻宴巵，十幅曙帆飞。",
        "路入江山国，人兼彩绣衣。",
        "草堂空岫幌，偃室听琴徽。",
        "谁识无双誉，新从日下归。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13591,
      "title": "元处宗安化簿",
      "content": [
        "军府沈千奏，边城佐一同。",
        "乡书黄耳远，客爨扊扅空。",
        "怨曙羌笳月，嘶寒代马风。",
        "未应期会急，平日废谈丛。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13592,
      "title": "同年毛洵勾簿新建",
      "content": [
        "年衰冬集罢，鹢首晓帆催。",
        "枳棘非鸾处，膏腴得父才。",
        "澄江限天阔，孤鹜透霞来。",
        "此地留清赏，谁同耻宴罍。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13593,
      "title": "霜宇",
      "content": [
        "霜宇澹秋光，峥嵘歇岁芳。",
        "地形侵楚庳，渠尾入淮长。",
        "廥集牛初下，罗稀鸟恣翔。",
        "病悰多感极，身托茂陵傍。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13594,
      "title": "季秋十九日追还学士院回舟入都作二首  其一",
      "content": [
        "上恩留不遣，仍棹越船回。",
        "人忝玉堂署，鱼还符节台。",
        "危心摧橹罢，病眼刮云开。",
        "读徧淮南诏，惭非视草才。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13595,
      "title": "季秋十九日追还学士院回舟入都作二首  其二",
      "content": [
        "得麾初出守，趋召遽言旋。",
        "露藿元倾日，秋槎却上天。",
        "丹涂容蹇步，星弁许华颠。",
        "再奏皆闻罢，惭妨此路贤。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13596,
      "title": "古邑二首  其一",
      "content": [
        "古邑蓬池上，私居市道邻。",
        "初抛三釜粟，来作一廛民。",
        "乞火黔薪突，繙经振隙尘。",
        "何从复何去，更欲问圆神。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13597,
      "title": "古邑二首  其二",
      "content": [
        "坠雨离邦远，编蓬僦庑卑。",
        "人非一国敌，家乏万钱赀。",
        "江海嗟漂荡，乾坤惜变衰。",
        "此时看落叶，宁翅长年悲。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13598,
      "title": "三封田墅  其一",
      "content": [
        "驱马三封下，还家值日西。",
        "林间寻路隘，露里入山迷。",
        "僮倦仍依樾，鸡闲已上栖。",
        "暂来翻似客，邻酒夜过携。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13599,
      "title": "三封田墅  其二",
      "content": [
        "清和迁首序，岑寂此凭栏。",
        "涧雨虹前罢，林樱鸟后残。",
        "野姿连草向，天影入池宽。",
        "日暮严城阻，裴回惜据鞍。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13600,
      "title": "行药",
      "content": [
        "行药来溪上，园秋损物华。",
        "漫丛繁野菊，荒蔓系寒瓜。",
        "野旷难藏树，山明即变霞。",
        "病身慵事事，楼鼓谩催衙。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13601,
      "title": "江夏黄孝恭数遗新诗因以是答",
      "content": [
        "万里江南客，三年泽畔身。",
        "惊弦已疮雁，涸辙欲穷鳞。",
        "日月奔腾晚，烟花感慨春。",
        "谁能为此曲，无乃数奇人。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13602,
      "title": "答转运王工部到寿阳却乘流东下以诗见寄",
      "content": [
        "闻到清淮上，还乘清溜回。",
        "缘持使者节，难把故人杯。",
        "曙盖星衔柳，昏邮雨亚梅。",
        "怆离并感昔，都向句中来。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13603,
      "title": "答景亳宣徽吴尚书见寄短偈",
      "content": [
        "玉帐论兵罢，东方静守藩。",
        "有尘都是客，无法可容言。",
        "海鸟逢觞怯，醯鸡恋瓮喧。",
        "因公四句惠，弥觉对酬烦。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13604,
      "title": "答连生见寄兼简同邑胡希元",
      "content": [
        "京华倦游客，顾我损文鳞。",
        "道觉穷方胜，交缘淡更亲。",
        "句成池草夕，讯到陇梅春。",
        "欲答双盘恨，清才彼有人。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13605,
      "title": "答刑部王侍郎病中见寄",
      "content": [
        "请告烦开许，循衰分退藏。",
        "病淹三折臂，愁热九回肠。",
        "冻酌思同釂，仙丸得徧尝。",
        "深惭白云老，相忆未相忘。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13606,
      "title": "偈答王侍郎",
      "content": [
        "遮莫传衣去，饶他舍筏回。",
        "雪虽炉上见，珠自髻中来。",
        "劫劫无真谛，人人止妄猜。",
        "公知兜率否，举足便尘埃。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13607,
      "title": "观烧",
      "content": [
        "白草开平野，炎晖照暮云。",
        "商原宁易向，昆玉怯同焚。",
        "田烛宵俱远，边烽晓不分。",
        "方阳休自任，阮瑀久从军。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13608,
      "title": "西斋秋晚",
      "content": [
        "霜华零暮节，日气淡长穹。",
        "池减无留潦，林寒少罢风。",
        "虫鸣星杼促，蝉起露緌空。",
        "隠几无纷虑，窥园嗜晚菘。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13609,
      "title": "西园晚秋见寄",
      "content": [
        "中园秋物晓，清玩日无穷。",
        "暝筿深留翠，寒花浅作红。",
        "鹤鸣残滴露，蜩咽已凉风。",
        "谁伴调丝管，心知忆戴崇。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13610,
      "title": "和伯氏小疾原韵",
      "content": [
        "握臂苦愔愔，苍华倦昼簪。",
        "悟非蘧瑗早，达想净名深。",
        "齐鹿闲三㰅，仙图戏一禽。",
        "独应吴客问，眉宇识侵淫。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13611,
      "title": "悼祚禅师二首  其一",
      "content": [
        "两股飞神锡，千金供住园。",
        "吹毛曾有问，得髓更无言。",
        "兰紫恩袍异，莲香社侣繁。",
        "双林今奄忽，泪目送风幡。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13612,
      "title": "悼祚禅师二首  其二",
      "content": [
        "击电传心要，浮沤厌世喧。",
        "一床空病室，五叶谶诸孙。",
        "风惨萎花坠，尘流旧鉴昏。",
        "导师宁怛化，缁侣自销魂。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13613,
      "title": "陪谢紫微晚泛",
      "content": [
        "积雨涨秋濠，轻舟共此邀。",
        "菰蒲敛铓锷，莲芡熟櫜韬。",
        "岸静鱼跳月，林喧鸟避篙。",
        "归时兴不浅，风物正萧骚。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13614,
      "title": "答朱公绰牡丹",
      "content": [
        "珍卉分清赏，飞邮附翠笼。",
        "蹄金点鬓密，璋玉镂跗红。",
        "香惜持来远，春应摘后空。",
        "玩时仍把酒，恨不与君同。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13615,
      "title": "渡湘江",
      "content": [
        "春过湘江渡，真观八景图。",
        "云藏岳麓寺，江入洞庭湖。",
        "晴日花争发，丰年酒易沽。",
        "长沙十万户，游女似京都。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13616,
      "title": "腊后晚望",
      "content": [
        "寒日系难定，鸣笳弄已休。",
        "冻崖初辨马，昏谷自量牛。",
        "汉树临关密，荒泉入塞流。",
        "登高能赋未，风物古尧州。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13617,
      "title": "中秋新霁壕水初满自城东隅泛舟回谢公命赋",
      "content": [
        "斋舫谈经后，官池载酒行。",
        "斜阳鸟外落，新月树端生。",
        "清漾思江浦，夷犹遶郡城。",
        "东辕有遗恨，日日物华清。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13618,
      "title": "读绝交论",
      "content": [
        "嫌忌萧朱末，盈虚田窦间。",
        "言虽甘若醴，心定险于山。",
        "覆辙何能救，颓波遂不还。",
        "居然孝标论，抵几若为删。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13619,
      "title": "和夏推官奉太夫人就养仲氏次韵",
      "content": [
        "盛府从军日，大家随子初。",
        "伯兮均洁膳，仲也庆将舆。",
        "雾舍嵩尘薄，霜程巩树疏。",
        "循陔传咏切，匪夕伫归欤。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13620,
      "title": "寄泾北都运待制施正臣",
      "content": [
        "我作东南守，君为河朔行。",
        "旌旗向江步，笳鼓入边声。",
        "共结光华遇，难禁离索情。",
        "惟应指羊酪，未肯下莼羹。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13621,
      "title": "探题得小桥",
      "content": [
        "寻幽路穷处，略彴跨回溪。",
        "一水虹相映，双华鹤自栖。",
        "浅痕过钓艇，斜势截横隄。",
        "弭节谁凭望，秋光徧水西。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13622,
      "title": "蓬池二首  其一",
      "content": [
        "大道来中县，余粮徧近原。",
        "狙林朝芋陨，豳屋昼茅喧。",
        "短日方催暮，低云屡向繁。",
        "我忧宁易写，惟有悄无言。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13623,
      "title": "蓬池二首  其二",
      "content": [
        "天形垂沆漭，原势带纡余。",
        "社久熏无鼠，渊澄察见鱼。",
        "駉駉开牧庌，蹇蹇度柴车。",
        "却望斜阳市，行人掉臂初。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13624,
      "title": "雨夜",
      "content": [
        "滞雨兼兰夕，遥帷更烛房。",
        "疾雷方破柱，惊电或生墙。",
        "易断幽衾梦，频回逐客肠。",
        "新欢谁复得，最是楚高唐。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13625,
      "title": "送睦州柳从事",
      "content": [
        "唱第千人俊，从军十部贤。",
        "鸡翘迂赐绶，鹢首赴归船。",
        "别思瑶华岸，怀乡玉脍天。",
        "不妨宾弁侧，新曲徧鹍弦。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13626,
      "title": "城隅晚意",
      "content": [
        "寥寥天意晚，稍觉井闾闲。",
        "水落呈全屿，云生失半山。",
        "牛羊樵路暗，灯火客舟还。",
        "暝思输凫鹄，归飞沆漭闲。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13627,
      "title": "即事",
      "content": [
        "中伏翻无暑，斜阳未即曛。",
        "暂光风处叶，余墨雨残云。",
        "圃埒繁蔬甲，堂坳叠藓文。",
        "巾㡚殊上喜，文酒半离群。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13628,
      "title": "水亭",
      "content": [
        "地渍蚌衣接，天澄縠雾开。",
        "微风发琴籁，残月减珠胎。",
        "鸟散纤条动，鱼游细浪来。",
        "坐堂兼伏槛，恨乏楚人才。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13629,
      "title": "送戚秘丞典上饶钱监",
      "content": [
        "左典吴山冶，行行榜客舟。",
        "终无善宦巧，肯为著书愁。",
        "别思都成恶，芳辰信易遒。",
        "江南饶杜若，何兴奈高秋。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13630,
      "title": "赠清逸魏闲处士",
      "content": [
        "奕世依岩石，褒恩下帝庭。",
        "姓名高士传，父子少微星。",
        "池溜遥通涧，家林近带坰。",
        "分明诏书意，天极赐鸿冥。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13631,
      "title": "七月二十七日",
      "content": [
        "客雁归何处，寒螀鸣不休。",
        "兼之清夜永，副以长年愁。",
        "家令有移带，中郎余白头。",
        "此怀诚自感，何頼怨高秋。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13632,
      "title": "七月二十八日",
      "content": [
        "秋物向摇落，客心真悄然。",
        "高风已凉夜，澹月始晴天。",
        "拂幌单𦈌怯，凝尘故扇捐。",
        "露华休早滴，羁鹄不曾眠。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13633,
      "title": "寒夜始长",
      "content": [
        "四海秋风晚，千门夜刻长。",
        "梧桐老空井，蟋蟀近人床。",
        "暗烛勤垂烬，离鸿短趁行。",
        "生平江海志，耿耿未渠央。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13634,
      "title": "将归二首  其一",
      "content": [
        "远假西南守，三逢梅柳新。",
        "衰令宦情薄，老惜岁华频。",
        "郫酿供销日，巴禽巧唤春。",
        "离家何所恨，雁后作归人。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13635,
      "title": "将归二首  其二",
      "content": [
        "云栈短长亭，今兹重作经。",
        "邛崃叱残驭，蜀分使回星。",
        "旅鬓双垂雪，羁怀一泛萍。",
        "骊驹在门久，此曲若为听。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13636,
      "title": "夏日陪提刑彭学士登周襄王故城",
      "content": [
        "聊随汉使者，一上周王城。",
        "片雨北郊晦，残阳西岭明。",
        "野禽呼自别，香草问无名。",
        "谁复歌离黍，惟兴箕颍情。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13637,
      "title": "寄大固山嘉祐院长吉上人",
      "content": [
        "名高身愈隠，孤锡倚岩扃。",
        "园布黄金地，台藏白马经。",
        "庵云吞暝烛，涧月泻虚瓶。",
        "坐想谿桥路，莓苔又几青。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13638,
      "title": "寄净名庵僧长吉",
      "content": [
        "故人诗未报，恨恨复经年。",
        "梦去长江路，心知宝所天。",
        "孤情岩桂老，逸思暮云传。",
        "无奈缨緌累，犹乖方外缘。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13639,
      "title": "东晋",
      "content": [
        "仓卒浮江日，声名建号初。",
        "群臣让禁脔，上宰制单𦈌。",
        "气锐开桁战，心欢折屐书。",
        "纤儿竞撞坏，不念好家居。"
