        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351353,
      "title": "和左司元郎中秋居十首",
      "content": [
        "选得闲坊住，秋来草树肥。",
        "风前卷筒簟，雨里脱荷衣。",
        "野客留方去，山童取药归。",
        "非因入朝省，过此出门稀。",
        "有地唯栽竹，无池亦养鹅。",
        "学书求墨迹，酿酒爱朝和。",
        "古镜铭文浅，神方谜语多。",
        "居贫闲自乐，豪客莫相过。",
        "闲来松菊地，未省有埃尘。",
        "直去多将药，朝回不访人。",
        "见僧收酒器，迎客换纱巾。",
        "更恐登清要，难成自在身。",
        "自知清静好，不要问时豪。",
        "就石安琴枕，穿松压酒槽。",
        "山晴因月甚，诗语入秋高。",
        "身外无余事，唯应笔砚劳。",
        "闲堂新扫洒，称是早秋天。",
        "书客多呈帖，琴僧与合弦。",
        "莎台乘晚上，竹院就凉眠。",
        "终日无忙事，还应似得仙。",
        "醉倚斑藤杖，闲眠瘿木床。",
        "案头行气诀，炉里降真香。",
        "尚俭经营少，居闲意思长。",
        "秋茶莫夜饮，新自作松浆。",
        "每忆旧山居，新教上墨图。",
        "晚花回地种，好酒问人沽。",
        "夜后开朝簿，申前发省符。",
        "为郎凡几岁，已见白髭须。",
        "菊地才通履，茶房不垒阶。",
        "凭医看蜀药，寄信觅吴鞋。",
        "尽得仙家法，多随道客斋。",
        "本无荣辱意，不是学安排。",
        "林下无拘束，闲行放性灵。",
        "好时开药灶，高处置琴亭。",
        "更撰居山记，唯寻相鹤经。",
        "初当授衣假，无吏挽门铃。",
        "客散高斋晚，东园景象偏。",
        "晴明犹有蝶，凉冷渐无蝉。",
        "藤折霜来子，蜗行雨后涎。",
        "新诗才上卷，已得满城传。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351357,
      "title": "寄孙冲主簿",
      "content": [
        "低折沧洲簿，无书整两春。",
        "马从同事借，妻怕罢官贫。",
        "道僻收闲药，诗高笑故人。",
        "仍闻长吏奏，表乞锁厅频。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 351359,
      "title": "旧宫人",
      "content": [
        "歌舞梁州女，归时白发生。",
        "全家没蕃地，无处问乡程。",
        "宫锦不传样，御香空记名。",
        "一身难自说，愁逐路人行。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 351360,
      "title": "春日留别",
      "content": [
        "游人欲别离，半醉对花枝。",
        "看著春又晚，莫轻少年时。",
        "临行记分处，回首是相思。",
        "各向天涯去，重来未可期。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 351363,
      "title": "冬夕",
      "content": [
        "寒蛩独罢织，湘雁犹能鸣。",
        "月色当窗入，乡心半夜生。",
        "不成高枕梦，复作绕阶行。",
        "回首嗟淹泊，城头北斗横。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 351364,
      "title": "奉和陕州十四翁中丞寄雷州二十二翁司户之作",
      "content": [
        "联飞独不前，迥落海南天。",
        "贾傅竟行矣，邵公惟泫然。",
        "瘴开山更远，路极水无边。",
        "沉劣本多感，况闻原上篇。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 351369,
      "title": "岳州晚景",
      "content": [
        "晚景寒鸦集，秋声旅雁归。",
        "水光浮日去，霞彩映江飞。",
        "洲白芦花吐，园红柿叶稀。",
        "长沙卑湿地，九月未成衣。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 351371,
      "title": "寒食书事二首",
      "content": [
        "今朝一百五，出户雨初晴。",
        "舞爱双飞蝶，歌闻数里莺。",
        "江深青草岸，花满白云城。",
        "为政多孱懦，应无酷吏名。",
        "出城烟火少，况复是今朝。",
        "闲坐将谁语，临觞只自谣。",
        "阶前春藓遍，衣上落花飘。",
        "妓乐州人戏，使君心寂寥。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351372,
      "title": "和李仆射雨中寄卢、严二给事",
      "content": [
        "郊原飞雨至，城阙湿云埋。",
        "迸点时穿牖，浮沤欲上阶。",
        "偏滋解箨竹，并洒落花槐。",
        "晚润生琴匣，新凉满药斋。",
        "从容朝务退，放旷掖曹乖。",
        "尽日无来客，闲吟感此怀。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351375,
      "title": "和令狐尚书平泉东庄近居李仆射有寄十韵",
      "content": [
        "平地有清泉，伊南古寺边。",
        "涨池闲绕屋，出野遍浇田。",
        "旧隐离多日，新邻得几年。",
        "探幽皆一绝，选胜又双全。",
        "门静山光别，园深竹影连。",
        "斜分采药径，直过钓鱼船。",
        "鸡犬还应识，云霞顿觉鲜。",
        "追思应不远，赏爱谅难偏。",
        "此处堪长往，游人早共传。",
        "各当恩寄重，归卧恐无缘。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351376,
      "title": "送郑尚书出镇南海",
      "content": [
        "远镇承新命，王程不假催。",
        "班行争路送，恩赐并时来。",
        "牙旆从城展，兵符到府开。",
        "蛮声喧夜市，海色浸潮台。",
        "画角天边月，寒关岭上梅。",
        "共知公望重，多是来年回。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351377,
      "title": "徐州试反舌无声",
      "content": [
        "夏木多好鸟，偏知反舌名。",
        "林幽仍共宿，时过即无声。",
        "竹外天空晓，溪头雨自晴。",
        "居人宜寂寞，深院益凄清。",
        "入雾暗相失，当风闲易惊。",
        "来年上林苑，知尔最先鸣。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351379,
      "title": "新城甲仗楼",
      "content": [
        "谢氏起新楼，西临城角头。",
        "图功百尺丽，藏器五兵修。",
        "结缔榱甍固，虚明户槛幽。",
        "鱼龙卷旗帜，霜雪积戈矛。",
        "暑雨熇烝隔，凉风宴位留。",
        "地高形出没，山静气清优。",
        "睥睨斜光彻，阑干宿霭浮。",
        "芊芊粳稻色，脉脉苑溪流。",
        "郡化黄丞相，诗成沉隐侯。",
        "居兹良得景，殊胜岘山游。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351380,
      "title": "赠殷山人",
      "content": [
        "郁郁山中客，知名四十年。",
        "恓惶身独隐，寂寞性应便。",
        "世业公侯籍，生涯黍稷田。",
        "藤悬读书帐，竹系网鱼船。",
        "已种千头橘，新开数脉泉。",
        "闲游携酒远，幽语向僧偏。",
        "入洞题松过，看花选石眠。",
        "避喧长汩没，逢胜即留连。",
        "自古多高迹，如君少比肩。",
        "耕耘此辛苦，章句已流传。",
        "昔日交游盛，当时省阁贤。",
        "同袍还共弊，连辔每推先。",
        "讲序居重席，群儒愿执鞭。",
        "满堂虚左待，众目望乔迁。",
        "才异时难用，情高道自全。",
        "畏人颜惨澹，疏物势迍邅。",
        "贤者闻知命，吾生复礼玄。",
        "深藏报恩剑，久缉养生篇。",
        "憔悴众夫笑，经过郡守怜。",
        "夕阳悲病鹤，霜气动饥鹯。",
        "处士谁能荐，穷途世所捐。",
        "伯鸾甘寄食，元淑苦无钱。",
        "策蹇秋尘里，吟诗黄叶前。",
        "故裘余白领，废瑟断朱弦。",
        "志气终犹在，逍遥任自然。",
        "家贫念婚嫁，身老恋云烟。",
        "放逸栖岩鹿，清虚饮露蝉。",
        "郑逃秦谷口，严爱越溪边。",
        "霄汉予犹阻，荣枯子不牵。",
        "山城一相遇，感激意难宣。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351381,
      "title": "夏日可畏",
      "content": [
        "赫赫温风扇，炎炎夏日徂。",
        "火威驰迥野，畏景铄遥途。",
        "势矫翔阳翰，功分造化炉。",
        "禁城千品烛，黄道一轮孤。",
        "落照频空簟，余晖卷夕梧。",
        "如何倦游子，中路独踟蹰。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351383,
      "title": "和李仆射西园",
      "content": [
        "遇午归闲处，西庭敞四簷。",
        "高眠著琴枕，散帖检书签。",
        "印在休通客，山晴好卷帘。",
        "竹凉蝇少到，藤暗蝶争潜。",
        "晓鹊频惊喜，疏蝉不许拈。",
        "石苔生紫点，栏药吐红尖。",
        "虚坐诗情远，幽探道侣兼。",
        "所营尚胜地，虽俭复谁嫌。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351384,
      "title": "送裴相公赴镇太原",
      "content": [
        "盛德雄名远近知，功高先乞守藩维。",
        "衔恩暂遣分龙节，",
        "明年塞北清蕃落，应建生祠请立碑。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351385,
      "title": "寄元员外",
      "content": [
        "外郎直罢无余事，扫洒书堂试药炉。",
        "门巷不教当要闹，",
        "朝省入频闲日少，可能同作旧游无。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351386,
      "title": "赠梅处士",
      "content": [
        "早闻声价满京城，头白江湖放旷情。",
        "讲易自传新注义，",
        "天子如今议封禅，应将束帛请先生。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351387,
      "title": "赠王秘书",
      "content": [
        "不曾浪出谒公侯，唯向花间水畔游。",
        "每著新衣看药灶，",
        "自领闲司了无事，得来君处喜相留。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351388,
      "title": "谢裴司空寄马",
      "content": [
        "𫘧耳新驹骏得名，司空远自寄书生。",
        "乍离华厩移蹄涩，",
        "长思岁旦沙堤上，得从鸣珂傍火城。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351389,
      "title": "酬秘书王丞见寄",
      "content": [
        "相看头白来城阙，却忆漳溪旧往还。",
        "今体诗中偏出格，",
        "芸阁水曹虽最冷，与君长喜得身闲。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351390,
      "title": "送李余及第后归蜀",
      "content": [
        "十年人咏好诗章，今日成名出举场。",
        "归去唯将新诰牒，",
        "乡里亲情相见日，一时携酒贺高堂。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351391,
      "title": "早朝寄白舍人、严郎中",
      "content": [
        "鼓声初动未闻鸡，羸马街中踏冻泥。",
        "烛暗有时冲石柱，",
        "凤阙星郎离去远，合门开日入还齐。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351392,
      "title": "书怀寄元郎中",
      "content": [
        "转觉人间无气味，常因身外省因缘。",
        "经过独爱游山客，",
        "吟君钓客词中说，便欲南归榜小船。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351393,
      "title": "赠道士宜师",
      "content": [
        "自到王城得几年，巴童蜀马共随缘。",
        "两朝侍从当时贵，",
        "闲房暂喜居相近，还得陪师坐竹边。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351394,
      "title": "书怀寄王秘书",
      "content": [
        "白发如今欲满头，从来百事尽应休。",
        "只于触目须防病，",
        "赖君同在京城住，每到花前免独游。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351395,
      "title": "题韦郎中新亭",
      "content": [
        "起得幽亭景复新，碧莎地上更无尘。",
        "琴书著尽犹嫌少，",
        "成名同日官连署，此处经过有几人。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351396,
      "title": "送杨州判官",
      "content": [
        "应得烟霞出俗心，茅山道士共追寻。",
        "闲怜鹤貌偏能画，",
        "征南幕里多宾客，君独相知最校深。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351397,
      "title": "喜王起侍郎放牒",
      "content": [
        "东风节气近清明，车马争来满禁城。",
        "二十八人初上牒，",
        "共贺春司能鉴识，今年定合有公卿。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351398,
      "title": "赠王司马",
      "content": [
        "白笏朱衫年少时，久登班列会朝仪。",
        "贮财不省关身用，",
        "未曾相识多闻说，遥望长如白玉枝。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351399,
      "title": "书怀",
      "content": [
        "自小信成疏懒性，人间事事总无功。",
        "别从仙客求方法，",
        "未能即便休官去，惭愧南山采药翁。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351400,
      "title": "赠令狐博士",
      "content": [
        "头白新年六十余，近闻生计转空虚。",
        "久为博士谁能识，",
        "古来贤哲皆如此，应是才高与众疏。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351401,
      "title": "送从弟删东归",
      "content": [
        "云水东南两月程，贪归庆节马蹄轻。",
        "春桥欲醉攀花别，",
        "旧山风月知应好，莫向秋时不到京。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351402,
      "title": "赠王秘书",
      "content": [
        "早在山东声价远，曾将顺策佐嫖姚。",
        "赋来诗句无闲语，",
        "独从书阁归时晚，春水渠边看柳条。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351403,
      "title": "哭丘长史",
      "content": [
        "曾是先皇殿上臣，丹砂久服不成真。",
        "常骑马在嘶空枥，",
        "最悲昨日同游处，看却春风树树新。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351404,
      "title": "送枝江刘明府",
      "content": [
        "老著青衫为楚宰，平生志业有谁知。",
        "家僮从去愁行远，",
        "向南渐渐云山好，一路唯闻唱竹枝。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351405,
      "title": "送从弟彻东归",
      "content": [
        "缑山领印知公奏，才称同时尽不如。",
        "奉使贺成登册礼，",
        "早晚得为朝署拜，闲坊买宅作邻居。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351406,
      "title": "哭胡十八遇",
      "content": [
        "早得声名年尚少，寻常志气出风尘。",
        "文场继续成三代，",
        "送君帐下衣裳白，数尺坟头柏树新。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351407,
      "title": "赠贾岛",
      "content": [
        "篱落荒凉僮仆饥，乐游原上住多时。",
        "蹇驴放饱骑将出，",
        "姓名未上登科记，身屈惟应内史知。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351408,
      "title": "逢王建有赠",
      "content": [
        "年状皆齐初有髭，鹊山漳水每追随。",
        "使君座下朝听易，",
        "经今三十余年事，却说还同昨日时。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351409,
      "title": "移居静安坊，答元八郎中",
      "content": [
        "长安寺里多时住，虽守卑官不苦贫。",
        "作活每常嫌费力，",
        "更喜往还相去近，门前减却送书人。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351410,
      "title": "送杨少尹赴凤翔",
      "content": [
        "诗名往日动长安，首首人家卷里看。",
        "西学已行秦博士，",
        "今去岐州生计薄，移居偏近陇头寒。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351411,
      "title": "送韩侍御归山",
      "content": [
        "闻君久卧在云间，为佐嫖姚未得还。",
        "新结茅庐招隐逸，",
        "明日珂声出城去，家僮不复扫柴关。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351412,
      "title": "新除水曹郎，答白舍人见贺",
      "content": [
        "年过五十到南宫，章句无名荷至公。",
        "黄纸开呈相府后，",
        "最幸紫薇郎见爱，独称官与古人同。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351413,
      "title": "送杨少尹赴满城",
      "content": [
        "官为本府当身荣，因得还乡任野情。",
        "自废田园今作主，",
        "公事况闲诗更好，将随相逐上山行。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351414,
      "title": "哭元九少府",
      "content": [
        "平生志业独相知，早结云山老去期。",
        "初作学官常共宿，",
        "今日春风花满宅，入门行哭见灵帷。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351415,
      "title": "送侯判官赴广州从军",
      "content": [
        "年少才高求自展，将身万里赴军门。",
        "辟书远到开呈客，",
        "海花蛮草连冬有，行处无家不满园。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351416,
      "title": "答白杭州郡楼登望画图见寄",
      "content": [
        "画得江城登望处，寄来今日到长安。",
        "乍惊物色从诗出，",
        "见君向此闲吟意，肯恨当时作外官。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351417,
      "title": "赠赵将军",
      "content": [
        "当年胆略已纵横，每见妖星气不平。",
        "身贵早登龙尾道，",
        "会取安西将报国，凌烟阁上大书名。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351418,
      "title": "送和蕃公主",
      "content": [
        "塞上如今无战尘，汉家公主出和亲。",
        "邑司犹属宗卿寺，",
        "毡城南望无回日，空见沙蓬水柳春。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351419,
      "title": "寒食内宴二首",
      "content": [
        "朝光瑞气满宫楼，彩纛鱼龙四周稠。",
        "廊下御厨分冷食，",
        "共喜拜恩侵夜出，金吾不敢问行由。",
        "城阙沉沉向晓寒，恩当令节赐余欢，瑞烟深处开三殿，",
        "宫筵戏乐年年别，已得三回对御看。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351420,
      "title": "朝日敕赐百官樱桃",
      "content": [
        "仙果人间都未有，今朝忽见下天门。",
        "捧盘小吏初宣敕，",
        "每年重此先偏待，愿得千春奉至尊。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351421,
      "title": "太白老人",
      "content": [
        "日观东峰幽客住，竹巾藤带亦逢迎。",
        "暗修黄箓无人见，",
        "春泉四面绕茅屋，日日唯闻杵臼声。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351422,
      "title": "和裴司空酬满城杨少尹",
      "content": [
        "圣朝偏重大司空，人咏元和第一功。",
        "拥节高临汉水上，",
        "谁不望归丞相府，江边杨柳又秋风。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351423,
      "title": "寄和州刘使君",
      "content": [
        "别离已久犹为郡，闲向春风倒酒瓶。",
        "送客特过沙口堰，",
        "到此诗情应更远，醉中高咏有谁听。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351424,
      "title": "赠商州王使君",
      "content": [
        "衔命南来会郡堂，却思朝里接班行。",
        "才雄犹是山城守，",
        "明朝从此辞君去，独出商关路渐长。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351425,
      "title": "寄令狐宾客",
      "content": [
        "勋名尽得国家传，退狎琴僧与酒仙。",
        "还带郡符经几处，",
        "秋日出城伊水好，领谁相逐上闲船。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351426,
      "title": "寄梅处士",
      "content": [
        "扰扰人间是与非，官闲自觉省心机。",
        "六行班里身常下，",
        "君今独得居山乐，应喜多时未办归。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351427,
      "title": "送施肩吾东归",
      "content": [
        "知君本是烟霞客，被荐因来城阙间。",
        "世业偏临七里濑，",
        "惆怅灞亭相送去，云中琪树不同攀。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351428,
      "title": "昆仑儿",
      "content": [
        "昆仑家住海中州，蛮客将来汉地游。",
        "言语解教秦吉了，",
        "自爱肌肤黑如漆，行时半脱木绵裘。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351429,
      "title": "赠李杭州",
      "content": [
        "仙郎白首未归朝，应为苍生领六条。",
        "惠化州人尽清净，",
        "终日政声长独坐，开门长望浙江潮。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351430,
      "title": "送郑尚书赴广州",
      "content": [
        "圣朝选将持符节，内使宣时百辟听。",
        "海北蛮夷来舞蹈，",
        "此处莫言多瘴疠，天边看取老人星。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
