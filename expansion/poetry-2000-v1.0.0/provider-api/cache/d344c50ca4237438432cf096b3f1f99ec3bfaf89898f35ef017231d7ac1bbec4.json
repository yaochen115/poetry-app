{
  "data": [
    {
      "id": 351254,
      "title": "别鹤",
      "content": [
        "双鹤出云溪，分飞各自迷。",
        "空巢在松顶，折羽落红泥。",
        "寻水终不饮，逢林亦未栖。",
        "别离应易老，万里雨凄凄。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 351262,
      "title": "赠同溪客",
      "content": [
        "幽居得相近，烟景每寥寥。",
        "共伐临溪树，因为过水桥。",
        "自教青鹤舞，分采紫芝苗。",
        "更爱南峰住，寻君路恐遥。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 351267,
      "title": "思江南旧游",
      "content": [
        "江皋三月时，花发石楠枝。",
        "归客应无数，春山自不知。",
        "独行愁道远，回信畏家移。",
        "杨柳东西渡，茫茫欲问谁。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 351274,
      "title": "送蛮客",
      "content": [
        "借问炎州客，天南几日行。",
        "江连恶溪路，山绕夜郎城。",
        "柳叶瘴云湿，桂丛蛮鸟声。",
        "知君却回日，记得海花名。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 351275,
      "title": "襄国别友",
      "content": [
        "晓色荒城下，相看秋草时。",
        "独游无定计，不欲道来期。",
        "别处去家远，愁中驱马迟。",
        "归人渡烟水，遥映野棠枝。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 351279,
      "title": "寄友人",
      "content": [
        "忆在江南日，同游三月时。",
        "采茶寻远涧，斗鸭向春池。",
        "送客沙头宿，招僧竹里棋。",
        "如今各千里，无计得相随。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 351292,
      "title": "送友人归山",
      "content": [
        "出山成北首，重去结茅庐。",
        "移石修废井，扫龛盛旧书。",
        "开田留杏树，分洞与僧居。",
        "长在幽峰里，樵人见亦疏。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 351293,
      "title": "霅溪西亭晚望",
      "content": [
        "霅水碧悠悠，西亭柳岸头。",
        "夕阴生远岫，斜照逐回流。",
        "此地动归思，逢人方倦游。",
        "吴兴耆旧尽，空见白苹洲。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 351294,
      "title": "哭山中友人",
      "content": [
        "入云遥便哭，山友隔今生。",
        "绕墓招魂魄，镌岩记姓名。",
        "犬因无主善，鹤为见人鸣。",
        "长说能尸解，多应别路行。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 351295,
      "title": "答僧拄杖",
      "content": [
        "灵藤为拄杖，白净色如银。",
        "得自高僧手，将扶病客身。",
        "春游不骑马，夜会亦呈人。",
        "持此归山去，深宜戴角巾。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 351296,
      "title": "灵都观李道士",
      "content": [
        "仙观雨来静，绕房琼草春。",
        "素书天上字，花洞古时人。",
        "泥灶煮灵液，扫坛朝玉真。",
        "几回游阆苑，青节亦随身。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 351297,
      "title": "送韦评事归华阴",
      "content": [
        "三峰西面住，出见世人稀。",
        "老大谁相识，恓惶又独归。",
        "扫窗秋菌落，开箧夜蛾飞。",
        "若向云中伴，还应著褐衣。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 351298,
      "title": "送闽僧",
      "content": [
        "几夏京城住，今朝独远归。",
        "修行四分律，护净七条衣。",
        "溪寺黄橙熟，沙田紫芋肥。",
        "九龙潭上路，同去客应稀。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 351301,
      "title": "送新罗使",
      "content": [
        "万里为朝使，离家今几年。",
        "应知旧行路，却上远归船。",
        "夜泊避蛟窟，朝炊求岛泉。",
        "悠悠到乡国，远望海西天。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 351304,
      "title": "舟行寄李湖州",
      "content": [
        "客愁无次第，川路重辛勤。",
        "藻密行舟涩，湾多转楫频。",
        "薄游空感惠，失计自怜贫。",
        "赖有汀洲句，时时慰远人。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 351305,
      "title": "送闲师归江南",
      "content": [
        "遍住江南寺，随缘到上京。",
        "多生修律业，外学得诗名。",
        "讲殿偏追入，斋家别请行。",
        "青枫乡路远，几日尽归程。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 351306,
      "title": "游襄阳山寺",
      "content": [
        "秋色江边路，烟霞若有期。",
        "寺贫无利施，僧老足慈悲。",
        "薜荔侵禅窟，虾蟆占浴池。",
        "闲游殊未遍，即是下山时。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 351308,
      "title": "送从弟戴玄往苏州",
      "content": [
        "杨柳阊门路，悠悠水岸斜。",
        "乘舟向山寺，著屐到渔家。",
        "夜月红柑树，秋风白藕花。",
        "江天诗景好，回日莫令赊。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 351311,
      "title": "酬韩庶子",
      "content": [
        "西街幽僻处，正与懒相宜。",
        "寻寺独行远，借书常送迟。",
        "家贫无易事，身病足闲时。",
        "寂寞谁相问，只应君自知。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 351312,
      "title": "赠姚合少府",
      "content": [
        "病来辞赤县，案上有丹经。",
        "为客烧茶灶，教儿扫竹亭。",
        "诗成添旧卷，酒尽卧空瓶。",
        "阙下今遗逸，谁瞻隐士星。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 351314,
      "title": "送郑秀才归宁",
      "content": [
        "桂楫彩为衣，行当令节归。",
        "夕潮迷浦远，昼雨见人稀。",
        "野芰到时熟，江鸥泊处飞。",
        "离琴一奏罢，山雨霭余晖。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 351323,
      "title": "晚秋闲居",
      "content": [
        "独坐高秋晚，萧条足远思。",
        "家贫常畏客，身老转怜儿。",
        "万种尽闲事，一生能几时。",
        "从来疏懒性，应只有僧知。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 351329,
      "title": "春日李舍人宅见两省诸公唱和，因书情即事",
      "content": [
        "又见帝城里，东风天气和。",
        "官闲人事少，年长道情多。",
        "紫掖发章句，青闱更咏歌。",
        "谁知余寂寞，终日断经过。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 351330,
      "title": "和李仆射秋日病中作",
      "content": [
        "由来病根浅，易见药功成。",
        "晓日杵臼静，凉风衣服轻。",
        "犹疑少气力，渐觉有心情。",
        "独倚红藤杖，时时阶上行。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 351331,
      "title": "早春病中",
      "content": [
        "羸病及年初，心情不自如。",
        "多申请假牒，只送贺官书。",
        "幽径独行步，白头长懒梳。",
        "更怜晴日色，渐渐暖贫居。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 351332,
      "title": "送严大夫之桂州",
      "content": [
        "旌旆过湘潭，幽奇得遍探。",
        "莎城百越北，行路九疑南。",
        "有地多生桂，无时不养蚕。",
        "听歌疑似曲，风俗自相谙。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 351334,
      "title": "使至蓝溪驿，寄太常王丞",
      "content": [
        "独上七盘去，峰峦转转稠。",
        "云中迷象鼻，雨里下筝头。",
        "水没荒桥路，鸦啼古驿楼。",
        "君今在城阙，肯见此中愁。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 351341,
      "title": "赠太常王建藤杖笋鞋",
      "content": [
        "蛮藤剪为杖，楚笋结成鞋。",
        "称与诗人用，堪随礼寺斋。",
        "寻花入幽径，步日下寒阶。",
        "以此持相赠，君应惬素怀。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 351344,
      "title": "寒食夜寄姚侍郎",
      "content": [
        "贫官多寂寞，不异野人居。",
        "作酒和山药，教儿写道书。",
        "五湖归去远，百事病来疏。",
        "况忆同怀者，寒庭月上初。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 351345,
      "title": "题清澈上人院",
      "content": [
        "古寺临坛久，松间别起堂。",
        "看添浴佛水，自合读经香。",
        "爱养无家客，多传得效方。",
        "过斋长不出，坐卧一绳床。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 351346,
      "title": "寄灵一上人初归云门寺",
      "content": [
        "寒山白云里，法侣自招携。",
        "竹径通城下，松门隔水西。",
        "方同沃洲去，不作武陵迷。",
        "仿佛遥看处，秋风是会稽。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 351349,
      "title": "和户部令狐尚书喜裴司空见招看雪",
      "content": [
        "南园新覆雪，上宰晓来看。",
        "谁共登春榭，唯闻有地官。",
        "色连山远静，气与竹偏寒。",
        "高韵更相应，宁同歌吹欢。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 351352,
      "title": "庄陵挽歌词三首",
      "content": [
        "白日已昭昭，干戈亦渐消。",
        "迎师亲出道，从谏早临朝。",
        "佞幸威权薄，忠良宠锡饶。",
        "丘陵今一变，无复白云谣。",
        "观风欲巡洛，习战亦开池。",
        "始改三年政，旋闻七月期。",
        "陵分内外使，官具吉凶仪。",
        "渭北新园路，箫笳远更悲。",
        "晓日龙车动，秋风阊阖开。",
        "行帷六宫出，执绋万方来。",
        "惨惨郊原暮，迟迟挽唱哀。",
        "空山烟雨夕，新陌绕陵台。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
