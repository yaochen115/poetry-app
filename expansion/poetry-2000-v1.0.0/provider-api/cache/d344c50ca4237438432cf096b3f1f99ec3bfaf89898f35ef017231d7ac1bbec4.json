        "name": "其他"
      }
    },
    {
      "id": 351431,
      "title": "贺秘书王丞南郊摄将军",
      "content": [
        "正初天子亲郊礼，诏摄将军领卫兵。",
        "斜带银刀入黄道，",
        "共喜与君逢此日，病中无计得随行。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
