{
  "data": [
    {
      "id": 377073,
      "title": "虞美人·黄昏又听城头角",
      "content": [
        "黄昏又听城头角，病起心情恶",
        "药炉初沸短檠青，无那残香半缕恼多情",
        "多情自古原多病，清镜怜清影",
        "一声弹指泪如丝，央及东风休遣玉人知"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 377074,
      "title": "金缕曲·亡妇忌日有感",
      "content": [
        "此恨何时已",
        "滴空阶、寒更雨歇，葬花天气",
        "三载悠悠魂梦杳，是梦久应醒矣",
        "料也觉、人间无味",
        "不及夜台尘土隔，冷清清、一片埋愁地",
        "钗钿约，竟抛弃",
        "重泉若有双鱼寄",
        "好知他、年来苦乐，与谁相倚",
        "我自中宵成转侧，忍听湘弦重理",
        "待结个、他生知己",
        "还怕两人俱薄命，再缘悭、剩月零风里",
        "清泪尽，纸灰起"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 377075,
      "title": "虞美人·秋夕信步",
      "content": [
        "愁痕满地无人省，露湿琅玕影",
        "闲阶小立倍荒凉",
        "还剩旧时月色在潇湘",
        "薄情转是多情累，曲曲柔肠碎",
        "红笺向壁字模糊，忆共灯前呵手为伊书"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 377076,
      "title": "柳枝词",
      "content": [
        "池上闲房碧树围，帘纹如彀上斜晖",
        "生憎飞絮吹难定，一出红窗便不归"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 377077,
      "title": "遐方怨·欹角枕",
      "content": [
        "欹角枕，掩红窗",
        "梦到江南，伊家博山沉水香",
        "湔裙归晚坐思量",
        "轻烟笼浅黛，月茫茫"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 377078,
      "title": "浣溪沙·肯把离情容易看",
      "content": [
        "肯把离情容易看，要从容易见艰难",
        "难抛往事一般般",
        "今夜灯前形共影，枕函虚置翠衾单",
        "更无人与共春寒"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 377079,
      "title": "霜天晓角·重来丁酒",
      "content": [
        "重来丁酒，折尽风前柳",
        "若问看花情绪，似当日，怎能够",
        "休为西风瘦，痛饮频搔首",
        "自古青蝇白璧，天已早安排就"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 377080,
      "title": "菩萨蛮·黄云紫塞三千里",
      "content": [
        "黄云紫塞三千里，女墙西畔啼乌起",
        "落日万山寒，萧萧猎马还",
        "笳声听不得，入夜空城黑",
        "秋梦不归家，残灯落碎花"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 377081,
      "title": "减字木兰花·烛花摇影",
      "content": [
        "烛花摇影，冷透疏衾刚欲醒",
        "待不思量，不许孤眠不断肠",
        "茫茫碧落，天上人间情一诺",
        "银汉难通，稳耐风波愿始从"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 377082,
      "title": "减字木兰花·从教铁石",
      "content": [
        "从教铁石，每见花开成惜惜",
        "泪点难消，滴损苍烟玉一条",
        "怜伊大冷，添个纸窗疏竹影",
        "记取相思，环佩归来月上时"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 377083,
      "title": "采桑子·明月多情应笑我",
      "content": [
        "明月多情应笑我，笑我如今",
        "辜负春心，独自闲行独自吟",
        "近来怕说当时事，结遍兰襟",
        "月浅灯深，梦里云归何处寻"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 377084,
      "title": "采桑子·巂周声里严关峙",
      "content": [
        "巂周声里严关峙，匹马登登，乱踏黄尘",
        "听报邮签第几程",
        "行人莫话前朝事，风雨诸陵，寂寞鱼灯",
        "天寿山头冷月横"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 377085,
      "title": "采桑子·土花曾染湘娥黛",
      "content": [
        "土花曾染湘娥黛，铅泪难消",
        "清韵谁敲，不是犀椎是凤翘",
        "只应长伴端溪紫，割取秋潮",
        "鹦鹉偷教，方响前头见玉萧"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 377086,
      "title": "河传·春浅",
      "content": [
        "春浅，红怨，掩双环",
        "微雨花间，昼闲",
        "无言暗将红泪弹",
        "阑珊，香销轻梦还",
        "斜倚画屏思往事，皆不是，空作相思字",
        "记当时垂柳丝，花枝，满庭蝴蝶儿"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 377087,
      "title": "于中好·咏史",
      "content": [
        "马上吟成促渡江，分明闲气属闺房",
        "生憎久闭金铺暗，花冷回心玉一床",
        "添哽咽，足凄凉",
        "谁教生得满身香",
        "只今西海年年月，犹为萧家照断肠"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 377088,
      "title": "菩萨蛮·隔花才歇帘纤雨",
      "content": [
        "隔花才歇帘纤雨，一声弹指浑无语",
        "梁燕自双归，长条脉脉垂",
        "小屏山色远，妆薄铅华浅",
        "独自立瑶阶，透寒金缕鞋"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 377089,
      "title": "玉连环影",
      "content": [
        "何处几叶萧萧雨",
        "湿尽檐花，花底人无语",
        "掩屏山，玉炉寒",
        "谁见两眉愁聚倚阑干"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 377090,
      "title": "茅斋",
      "content": [
        "闲亭照白日，一室罗古今",
        "偶焉此栖迟，抱膝悠然吟",
        "吟罢有余适，散瞩复披襟",
        "时开玉怀卷，或弹珠柱琴",
        "檐树吐新花，枝头语珍禽",
        "花发饶冶色，禽鸣多姣音",
        "色冶眩春目，音姣伤春心",
        "夕阳下虞渊，寂莫还空林",
        "清光复相照，片月西山岭",
        "东园桃李姿，是妾嫁君时",
        "燕婉为夫妇，相爱不相离",
        "良人忽远征，妾独守空帏",
        "忧来恒自叹，冀死魂追随",
        "又念妾死时，谁制万里衣",
        "幸有双鲤鱼，拟为寄君辞",
        "终日不成章，含泪自封题",
        "君若得鲤鱼，剖鱼开素书",
        "但看行中字，一一与泪俱"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 377091,
      "title": "净业寺",
      "content": [
        "红楼高耸碧池深，荷芰生凉豁远襟",
        "湖色静涵孤刹影，花香暗入定僧心",
        "经翻佛藏研朱荚，地赐朝家布紫金",
        "下马长堤一吟望，梵钟杂送海潮音"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 377092,
      "title": "菩萨蛮·客中愁损催寒夕",
      "content": [
        "客中愁损催寒夕，夕寒催损愁中客",
        "门掩月黄昏，昏黄月掩门",
        "翠衾孤拥醉，醉拥孤衾翠",
        "醒莫更多情，情多更莫醒"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 377093,
      "title": "高楼望月",
      "content": [
        "戚戚复戚戚，高楼月如雪",
        "二八正婵娟，月明翡翠钿",
        "由来工织锦，生小倚朱弦",
        "朱弦岂解愁，素手似云浮",
        "一声落天上，闻者皆泪流",
        "别郎已经年，望郎出楼前",
        "青天如海水，碧月如珠圆",
        "月圆以复缺，不见长安客",
        "古道白于霜，沙灭行人迹",
        "月出光在天，月高光在地",
        "何当同心人，两两不相弃"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 377094,
      "title": "扈驾马兰峪赐观温泉恭纪十韵",
      "content": [
        "御天来凤辇，浴日启龙池",
        "野迥纡皇览，春浓值圣时",
        "落花萦彩仗，初柳拂朱旗",
        "行漏三辰拥，停銮万象随",
        "瑞征泉是醴，喜溢沼生芝",
        "特许观灵液，相将涉禁墀"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 377095,
      "title": "拟古·高云媚春日",
      "content": [
        "高云媚春日，坐觉鱼鸟亲",
        "可怜暮春候，病中别故人",
        "莺啼花乱落，风吹成锦茵",
        "君去一何速，到家垂柳新",
        "芙蓉湖上月，照君垂长纶"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 377096,
      "title": "南海子·分弓列戟四门开",
      "content": [
        "分弓列戟四门开，游豫长陪万乘来",
        "七十二桥天汉上，彩虹飞下晾鹰台"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 377097,
      "title": "扈跸霸州",
      "content": [
        "霸山重镇奠神京，鸾辂春游淑景明",
        "万呱银涛冲古岸，四围玉甃护严城",
        "花乘暖日迎来骑，柳带新膏绾去旌",
        "八寨雄图今更固，行随赏乐胜蓬瀛"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 377098,
      "title": "江行",
      "content": [
        "木落江已空，清辉澹鸥鹭",
        "不见系缆石，寒潮没瓜步",
        "帆移清枫林，人归白沙渡",
        "似有山猿啼，窈然潇湘暮"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 377099,
      "title": "中元前一夕枕上偶成",
      "content": [
        "酒醒池塘耿不眠，帐纹漠漠隔轻烟",
        "溪风到竹初疑雨，秋月如弓渐满弦",
        "残梦远经吹角戍，明河长亘衣天",
        "哀蛩饯晓浑多事，也似严更古驿边"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 377100,
      "title": "",
      "content": [
        "朔风吹古柳，时序忽代续",
        "庭草萎已尽，顾视白日速",
        "吾本落拓人，无为自拘束",
        "倜傥寄天地，樊笼非所欲",
        "嗟载华亭鹤，荣名反以辱",
        "有客叹二毛，操觚序金谷",
        "酒空人尽去，聚散何局促",
        "揽衣起长歌，明月皎如玉"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 377101,
      "title": "盛京",
      "content": [
        "拔地蛟龙宅，当关虎豹城",
        "山连长白秀，江入混同清",
        "庙社灵风肃，豪强右族更",
        "明明开创业，休拟作陪京"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 377102,
      "title": "柳条边",
      "content": [
        "是处垣篱防绝塞，角端西来画疆界",
        "汉使今行虎落中，秦城合筑龙荒外",
        "龙荒虎落两依然，护得当时饮马泉",
        "若使春风知别苦，不应吹到柳条边"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 377103,
      "title": "南海子·红桥夹岸柳平分",
      "content": [
        "红桥夹岸柳平分，雉兔年年不掩群",
        "飞放何须烦海户，郊南新置羽林军"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 377104,
      "title": "古北口",
      "content": [
        "乱山入戟拥孤城，一线人争鸟道行",
        "地险东西分障塞，云开南北望神京",
        "新图已入三关志，往事休论十路兵",
        "都护近来长不调，年年烽火报生平"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 377105,
      "title": "玉泉",
      "content": [
        "芙蓉殿俯御河寒，残月西风并马看",
        "十里松杉清绝处，不知晓雪在西山"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 377106,
      "title": "玉泉十二韵",
      "content": [
        "地涌西山脉，名标禁御泉",
        "百层飞作雨，万顷汇成渊",
        "润下终归海，源高却自天",
        "萦烟来树杪，带雪落云边",
        "隐见瑶光曳，琤苁佩响传",
        "红栋桥宛转，乌榜棹洄沿",
        "蛟龙蟠翠岛，雁鹜起琼田",
        "镜面晶荧合，珠痕荡漾圆",
        "翠流初放荇，娇拥半开莲",
        "睿赏悬孤鉴，馀波溢九璇",
        "那居真有庆，鱼藻在诗篇"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 377107,
      "title": "汤泉应制·六龙初驻浴蓝天",
      "content": [
        "六龙初驻浴蓝天，碧瓦朱旗共一川",
        "润逼仙桃红自舞，醉酣人柳绿犹眠",
        "吹成暖律回燕谷，散作薰风入舜弦",
        "最是垂衣深圣德，不须词笔颂甘泉"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 377108,
      "title": "记征人语",
      "content": [
        "边月无端照别离，故园何处寄相思",
        "西风不解征人语，一夕萧萧满大旗"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 377109,
      "title": "汤泉应制·清时礼乐萃朝端",
      "content": [
        "清时礼乐萃朝端，次第郊原引玉銮",
        "河岳千年归带砾，寝园三月拜衣冠",
        "便从畿甸亲民隐，更启神泉示从官",
        "非独炎灵钟坎德，恩波深处不知寒"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 377110,
      "title": "汤泉应制·鱼鳞雁齿镜中开",
      "content": [
        "鱼鳞雁齿镜中开，溅沫为霖遍九垓",
        "不用劫灰求仿佛，便从天汉象昭回",
        "桑坛法驾乘春转，鹤禁仙镳问寝来",
        "遥祝海隅同帝泽，年年长听属车雷"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 377111,
      "title": "雄县观鱼",
      "content": [
        "渔师临广泽，侍从俯清澜",
        "瑞入王舟好，仁知圣网宽",
        "拨鳞飞白雪，行鲙缕金盘",
        "在藻同周宴，时容万姓看"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 377112,
      "title": "梅花落",
      "content": [
        "春色凤城来，寒梅逼岁开",
        "条风初入树，缥雪渐侵苔",
        "粉逐莺衣散，香黏蝶翅回",
        "陇头人未返，急管莫频催"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 377113,
      "title": "蕉园",
      "content": [
        "见说斋坦闭，前朝大乙祠",
        "莺边花树树，燕外柳丝丝",
        "宫御人稀少，词臣例许窥",
        "今朝陪豹尾，新长万年枝"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 377114,
      "title": "风流子·秋郊射猎",
      "content": [
        "平原草枯矣，重阳后，黄叶树骚骚",
        "记玉勒青丝，落花时节，曾逢拾翠，忽听吹箫",
        "今来是、烧痕残碧尽，霜影乱红凋",
        "秋水映空，寒烟如织，皂雕飞处，天惨云高",
        "人生须行乐，君知否。",
        "容易两鬓萧萧",
        "自与东君作别，刬地无聊",
        "算功名何许，此身博得",
        "短衣射虎，沽酒西郊。",
        "便向夕阳影里，倚马挥毫"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 377115,
      "title": "扈驾西山",
      "content": [
        "凤翥龙蟠势作环，浮青不断太行山",
        "九重殿阁葱茏里，一气风云吐纳间",
        "熊虎自当驰道伏，蛟螭长棒御书闲",
        "黄图此日论形胜，惭愧频叨侍从班"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 377116,
      "title": "入直西苑",
      "content": [
        "望里蓬瀛近，行来阆苑齐",
        "晴霞开碧沼，落月隐金堤",
        "叶密莺先觉，花繁径不迷",
        "笙歌回辇处，长在凤城西"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 377117,
      "title": "兴京陪祭福陵",
      "content": [
        "龙盘凤翥气佳哉，东指斋宫玉辇来",
        "影入松楸仙仗远，香升俎豆晓云开",
        "盛仪备处千官肃，神贶乘时万马回",
        "豹尾叨陪须献颂，小臣惭愧展微才"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 377118,
      "title": "汤泉应制·身向咸池榜末光",
      "content": [
        "身向咸池榜末光，三危露暖不成霜",
        "金铺照日初涵影，玉求生烟别作香",
        "地接蓬莱通御气，波翻豆蔻散朝凉",
        "微臣幸属赓歌日，愿借如川献寿觞"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 377119,
      "title": "菩萨蛮·春花春月年年客",
      "content": [
        "春花春月年年客，怜春又怕春离别",
        "只为晓风愁，催花扑玉钩",
        "娟娟双蛱蝶，宛转飞花侧",
        "花底一声歌，疼花花奈何"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 377120,
      "title": "拟冬日景忠山应制·岧峣铁凤锁琳宫",
      "content": [
        "岧峣铁凤锁琳宫，亲侍銮舆度碧空",
        "圣主岂因崇象教，宸游直自接鸿蒙",
        "远山雪有一峰白，别浦枫余几树红",
        "天意不教常肃杀，伫看宇宙遍春风"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 377121,
      "title": "景山",
      "content": [
        "雪里瑶华岛，云端白玉京",
        "削成千仞势，高出九重城",
        "绣陌回环绕，红楼宛转迎",
        "近天多雨露，草木每先荣"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 377122,
      "title": "拟古·美人临残月",
      "content": [
        "美人临残月，无言若有思",
        "含颦但斜睇，吁嗟怜者谁",
        "予本多情人，寸心聊自持",
        "浩歌幽兰曲，援琴终不怡",
        "私恨托远梦，初日照帘帏"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 377123,
      "title": "拟古·予生未三十",
      "content": [
        "予生未三十，忧愁居其半",
        "心事如落花，春风吹已断",
        "行当适远道，作记殊汗漫",
        "寒食青草多，薄暮烟冥冥",
        "山桃一夜红，茵箔随飘零",
        "愿餐玉红草，一醉不复醒"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 377124,
      "title": "密云",
      "content": [
        "白檀山下水声秋，地踞潮河最上流",
        "日暮行人寻堠馆，凉砧一片古檀州"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 377125,
      "title": "芳树",
      "content": [
        "连理无分影，同心岂独芳",
        "傍檐巢翡翠，临水宿鸳鸯",
        "叶叶含春思，枝枝向画廊",
        "君情若比树，妾意复何伤",
        "陌上谁攀折，闺中思复侵",
        "眼凝清露重，眉敛翠烟深",
        "羌笛临风曲，悲笳出塞音",
        "纵垂千万缕，那系别离心"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 377126,
      "title": "拟冬日景忠山应制·雄关阻塞戴灵鳌",
      "content": [
        "雄关阻塞戴灵鳌，控制卢龙胜百牢",
        "山界万重横翠黛，海当三面涌银涛",
        "哀笳带月传声切，早雁迎秋度影高",
        "旧是六师开险处，待陪巡幸扈星旌"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 377127,
      "title": "明月棹孤舟·海淀",
      "content": [
        "一片亭亭空凝伫",
        "趁西风霓裳偏舞",
        "白鸟惊飞，菰蒲叶乱，断续浣纱人语",
        "丹碧驳残秋夜雨",
        "风吹去采菱越女",
        "辘轳声断，昏鸦欲起，多少博山情绪"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 377128,
      "title": "南海子·相风微动九门开",
      "content": [
        "相风微动九门开，南陌离宫万柳栽",
        "草色横粘下马泊，水光平占晾鹰台",
        "锦鞯欲射波间去，玉辇疑从岛上回",
        "自是软红惊十丈，天教到此洗尘埃"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 377129,
      "title": "班婕妤怨歌",
      "content": [
        "团团望舒月，皓皓冰蚕绢",
        "欲却炎天暑，比月裁成扇",
        "望舒圆易缺，金风换炎节",
        "风凉秋气寒，匣扇复谁看",
        "扇弃何足道，感妾伤怀抱",
        "对月泪如丝，君恩异旧时"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 377130,
      "title": "浣溪沙·伏雨朝寒愁不胜",
      "content": [
        "伏雨朝寒悉不胜，那能还傍杏花行",
        "去年高摘斗轻盈",
        "漫惹炉烟双袖紫，空将酒晕一衫青",
        "人间何处问多情"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    }
  ],
