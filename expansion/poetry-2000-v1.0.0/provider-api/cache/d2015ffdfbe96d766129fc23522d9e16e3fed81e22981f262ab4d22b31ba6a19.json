{
  "data": [
    {
      "id": 216241,
      "title": "岁暮书事十二首  其一一",
      "content": [
        "日落擎明烛，一杯千里心。",
        "骄儿惊醉舞，山仆怪悲吟。",
        "谷冷水流急，天昏云起阴。",
        "三更何处雁，急急尚哀音。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 216242,
      "title": "岁暮书事十二首  其一二",
      "content": [
        "云去暮天迥，雁飞寒夜长。",
        "姮娥守孤月，青女恨连霜。",
        "不寐看银烛，长吟送羽觞。",
        "山炉与石鼎，伴我老他乡。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 216243,
      "title": "宿东鲁父居二首  其一",
      "content": [
        "夕阳低欲尽，春浅色萧萧。",
        "暝色催归牧，炊烟向晚樵。",
        "疏星临水际，远火隔村桥。",
        "黯黯柴门夜，栖鸦对寂寥。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 216244,
      "title": "宿东鲁父居二首  其二",
      "content": [
        "郡国何时极，羁愁触处生。",
        "望随天不尽，春共野兼平。",
        "烟树淮南阔，渔盐楚俗轻。",
        "飘零五年别，叹息鬓毛更。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 216245,
      "title": "淮上夜风",
      "content": [
        "县郭初传柝，船窗已闭篷。",
        "星低春野路，月淡夜淮风。",
        "烟水东南阔，渔盐吴楚同。",
        "久游谙里社，赊酒问邻翁。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 216246,
      "title": "春望",
      "content": [
        "鸟去晴云外，帆归芳草边。",
        "平淮分绿野，春树接低天。",
        "残枿寒余烧，新青雨后田。",
        "年来千里目，容易泪双悬。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 216247,
      "title": "村晚",
      "content": [
        "深坞繁花丽，晴田细迳分。",
        "孤舟春水路，芳草夕阳村。",
        "暗雀投簷静，昏鸦集树喧。",
        "牛羊自归晚，灯火掩衡门。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 216248,
      "title": "夜意",
      "content": [
        "荒城转五更，北斗向谁倾。",
        "穴鬭时争啮，林栖或自惊。",
        "老来神虑淡，睡足骨毛轻。",
        "石磬催僧粥，低窗枕畔鸣。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 216249,
      "title": "春望",
      "content": [
        "暖日晴薰草，清淮阔浸天。",
        "地卑连远水，城废入春田。",
        "目极风灯外，愁悬泪脸边。",
        "人生苦多感，花柳自年年。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 216250,
      "title": "同七兄及崧上人自坟庄还寺",
      "content": [
        "和风快人意，岸帻晚襟凉。",
        "日落野痕碧，月生淮际光。",
        "论诗得灵运，静语属支郎。",
        "不是耽闲散，从来懒性长。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 216251,
      "title": "蔡河涨二首  其一",
      "content": [
        "长河秋雨涨，极目漫难分。",
        "潢潦虽无自，龟鱼恐有神。",
        "天宽垂鉴影，风细起龙鳞。",
        "老去扁舟兴，临流欲问津。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 216252,
      "title": "蔡河涨二首  其二",
      "content": [
        "浑浑虽未已，浩浩竟东归。",
        "阔处长天近，澄边一鸟飞。",
        "西风疏苇乱，斜日远村微。",
        "淹泊从吾道，扁舟伴钓矶。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 216253,
      "title": "初秋对雨",
      "content": [
        "闭户理残编，疏慵得自便。",
        "朝凉清病思，秋雨对高眠。",
        "屋冷深藏燕，槐疏混抱蝉。",
        "所欣堂下菊，芳意已鲜鲜。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 216254,
      "title": "泊长平晚望",
      "content": [
        "川隠夷犹棹，春归杳霭天。",
        "翠深交岸树，绿野望川田。",
        "渔酒数家市，船樯何处船。",
        "登临一回首，无限意茫然。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 216255,
      "title": "发长平",
      "content": [
        "归牛川上渡，去翼望中迷。",
        "野水侵官道，春芜没断堤。",
        "川平双桨上，天阔一帆西。",
        "无酒消羁恨，诗成独自题。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 216256,
      "title": "离建雄涂中",
      "content": [
        "远水悠悠静，孤樯袅袅迟。",
        "草深春已后，麦秀日长时。",
        "聚语条桑妇，行歌拾穗儿。",
        "年丰随处乐，飘泊我何为。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 216257,
      "title": "夏日十二首  其一",
      "content": [
        "过雨芰荷乱，繁阴竹树多。",
        "雏声知鸟哺，萍动见鱼过。",
        "细迳饶苔藓，阴墙引薜萝。",
        "角巾从倒侧，疏懒欲如何。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 216258,
      "title": "夏日十二首  其二",
      "content": [
        "蚓壤排晴圃，蜗涎印雨阶。",
        "花须娇带粉，树角老封苔。",
        "问字病多忘，过邻慵却回。",
        "晚凉还盥栉，对竹引清杯。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 216259,
      "title": "夏日十二首  其三",
      "content": [
        "山雨晴来暑，溪云暗复兴。",
        "林塘阴不解，巾帻润还蒸。",
        "书帙慵披蠹，盘餐厌扑蝇。",
        "老来疲薾甚，多病日侵陵。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 216260,
      "title": "夏日十二首  其四",
      "content": [
        "朝雨来还密，村墟一望间。",
        "远声惟野竹，润色但青山。",
        "书史供高卧，莓苔只闭关。",
        "萧萧觉秋兴，飘飒近衰颜。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 216261,
      "title": "夏日十二首  其五",
      "content": [
        "细迳依原僻，蓬蒿四五家。",
        "山田来雉兔，溪雨熟桑麻。",
        "竹笼晨收果，茅庵夜守瓜。",
        "颇知农事乐，彼此问生涯。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 216262,
      "title": "夏日十二首  其六",
      "content": [
        "养拙贫无事，深幽乐更真。",
        "簷巢偷哺子，树啄巧藏身。",
        "窃果莺知主，移居蚁过邻。",
        "老夫朝食美，荐俎有溪鳞。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 216263,
      "title": "夏日十二首  其七",
      "content": [
        "谢守常搜句，陶潜亦效官。",
        "傍溪分水细，过𪩘得天宽。",
        "布种随蔬陇，寻香到药栏。",
        "野装儿稚笑，绳屦鹿衣冠。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 216264,
      "title": "夏日十二首  其八",
      "content": [
        "久与山川约，那无风月情。",
        "经营原阔略，疏放自平生。",
        "山友招相见，乡书向远征。",
        "殷勤语归计，贫苦病难成。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 216265,
      "title": "夏日十二首  其九",
      "content": [
        "种药幽人事，还披本草经。",
        "出山抛旧翠，过雨有新青。",
        "术受壶中秘，方传肘后灵。",
        "不辞勤服饵，为变发星星。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 216266,
      "title": "夏日十二首  其一○",
      "content": [
        "陶令抛官易，庞公去隠深。",
        "由来浮世事，可见昔人心。",
        "卜筑闲多思，奔驰病不禁。",
        "簷楹来燕雀，鸾鹤自山林。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 216267,
      "title": "夏日十二首  其一一",
      "content": [
        "蛩怨青莎老，萤飞秋水深。",
        "庭除延夜色，砧杵发秋心。",
        "雄剑鸣初匣，寒衣补硬针。",
        "老来词赋懒，从使二毛侵。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 216268,
      "title": "夏日十二首  其一二",
      "content": [
        "夜色川原合，秋声草木催。",
        "星辰随地阔，河汉写山来。",
        "栖鹤凉先警，饥乌夕未回。",
        "高楼对斜月，鸣笛正清哀。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 216269,
      "title": "宿故济阳城",
      "content": [
        "夜色萧条寺，天寒老病身。",
        "空村惟有雪，远道更无人。",
        "不寐依炉暖，多愁頼酒醇。",
        "遥思双凤阙，雨露已先春。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 216270,
      "title": "早秋感怀",
      "content": [
        "永日付悠悠，年华逝不留。",
        "风声送残暑，云色淡新秋。",
        "吾道倘有待，穷通宁遽忧。",
        "朝来望清颍，一雁下汀洲。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 216271,
      "title": "庚辰腊八日大雪二首  其一",
      "content": [
        "平生腊八日，借钵受斋糜。",
        "客路岁将晚，旅庖晨不炊。",
        "持杯从破律，遣兴自吟诗。",
        "何日依禅宿，钟鱼自有时。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 216272,
      "title": "庚辰腊八日大雪二首  其二",
      "content": [
        "东州逢腊雪，却忆竟陵梅。",
        "客路人方远，天涯雁欲回。",
        "遥怜簷外白，还点砌边苔。",
        "久是无人过，谁知照酒杯。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 216273,
      "title": "蒙恩除奉常有感",
      "content": [
        "平生秉周礼，投老奉龙旗。",
        "斥逐偶不死，归来敢恨迟。",
        "门阑走宾客，行李饬妻儿。",
        "又踏长安道，多惭鬓有丝。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 216274,
      "title": "建平途次",
      "content": [
        "野桥田径滑，官路柳条新。",
        "流水伴丽日，野花留晚春。",
        "点空知去翼，冲绿有归人。",
        "自笑谙岐路，无劳更问津。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 216275,
      "title": "白沙阻风",
      "content": [
        "春江风易恶，故作客行难。",
        "晴日开野色，朝寒醒醉颜。",
        "归人出断岸，去翼复前山。",
        "淹泊无谁语，村翁亦往还。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 216276,
      "title": "冬日杂兴六首  其一",
      "content": [
        "小园晴自扫，曝日坐前轩。",
        "野鼠穿山叶，寒乌啄草根。",
        "短篱藩隙地，别迳入孤村。",
        "幽趣供岑寂，淹留不复论。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 216277,
      "title": "冬日杂兴六首  其二",
      "content": [
        "水落桥痕在，沙干岸草枯。",
        "霜余槐老壮，风际竹清疏。",
        "啄木高逾响，鹡鸰飞且呼。",
        "二年亲友绝，惟有对禽鱼。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 216278,
      "title": "冬日杂兴六首  其三",
      "content": [
        "池馆留余雪，西山照夕曛。",
        "腊催梅蕊迸，春向鸟声新。",
        "愁思供多病，风光欲近人。",
        "年年桃李树，相对只伤神。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 216279,
      "title": "冬日杂兴六首  其四",
      "content": [
        "空山身欲老，徂岁腊还来。",
        "愁怯年年柳，伤心处处梅。",
        "绿蔬挑甲短，红蜡点花开。",
        "冰雪知何有，东风日夜回。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 216280,
      "title": "冬日杂兴六首  其五",
      "content": [
        "南壁苍崖壮，穷冬井落闲。",
        "风声先老树，日色避诸山。",
        "落雁饥相向，啼乌夕自还。",
        "微微寒月影，蓬户已深关。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 216281,
      "title": "冬日杂兴六首  其六",
      "content": [
        "击柝山城闭，疏灯野店扃。",
        "疾风鸣夜谷，晴水动浮星。",
        "霜翼归何晚，邻机织未停。",
        "短歌时自和，愁绝更谁听。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 216282,
      "title": "哲宗皇帝挽词四首  其一",
      "content": [
        "端拱循尧道，无为十六年。",
        "偏师擒颉利，上将勒燕然。",
        "梦损周王寿，丹催黄帝仙。",
        "凄凉旧载笔，恸哭抱残编。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 216283,
      "title": "哲宗皇帝挽词四首  其二",
      "content": [
        "秦地蟠螭纽，细阳玉象光。",
        "升歌陈备乐，信史记多祥。",
        "夺邑公无怨，开边义侮亡。",
        "威灵对三后，常在白云乡。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 216284,
      "title": "哲宗皇帝挽词四首  其三",
      "content": [
        "万世兴王业，千年极治辰。",
        "泽丘还北祭，玉检议东巡。",
        "汗竹人间事，因山地下春。",
        "云天不可望，髯断泣遗臣。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 216285,
      "title": "哲宗皇帝挽词四首  其四",
      "content": [
        "七月宫车驾，西陵观阙新。",
        "风云悲厚夜，羽卫异时巡。",
        "落月低金爵，秋芜暗石麟。",
        "威灵凛如在，善继有天伦。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 216286,
      "title": "故仆射司马文正公挽词四首  其一",
      "content": [
        "黼座方恭点，邦家付老臣。",
        "颂歌民一口，形势国千钧。",
        "富庶新田里，忠臣旧搢绅。",
        "裴公恨不早，丘祷叹无神。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 216287,
      "title": "故仆射司马文正公挽词四首  其二",
      "content": [
        "辞爵浮云外，安民反手中。",
        "山林独往意，衮绣太平功。",
        "布被终身俭，貂冠一命崇。",
        "他年两行泪，碑下泣羊公。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 216288,
      "title": "故仆射司马文正公挽词四首  其三",
      "content": [
        "经济心犹壮，清羸疾易伤。",
        "那知两楹奠，遽失万夫望。",
        "家有诗书积，坟无金玉藏。",
        "谁知幅巾敛，曾佩上公章。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 216289,
      "title": "故仆射司马文正公挽词四首  其四",
      "content": [
        "伊洛平生兴，园林独乐居。",
        "曾过郑公里，得御李膺车。",
        "华屋当年客，名山异代书。",
        "定知传不朽，埋玉自沾裾。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 216290,
      "title": "钦慈皇后挽词二首  其一",
      "content": [
        "畴昔熙宁盛，远同麟趾时。",
        "内敦勤俭德，阴辅太平基。",
        "余烈光彤史，追荣备母仪。",
        "遗民怀永裕，箫鼓不胜悲。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 216291,
      "title": "钦慈皇后挽词二首  其二",
      "content": [
        "淑德承明旧，徽音固有来。",
        "据龙符圣嗣，合剑会轩台。",
        "玉冷衣销馥，鸾昏镜集埃。",
        "伤心国西道，寂寞送车回。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 216292,
      "title": "挽黄几道",
      "content": [
        "异政颍川凤，遗风叔度陂。",
        "闻哀苦朋友，归葬束书诗。",
        "百岁乡人社，他年故吏碑。",
        "知公万金产，故在阿戎儿。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 216293,
      "title": "范参军挽词",
      "content": [
        "力学志不就，多才宦可嗟。",
        "生平叔知己，身后妇成家。",
        "温洛新阡茂，东吴庆系赊。",
        "功名付儿子，文史旧生涯。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 216294,
      "title": "任左藏挽词",
      "content": [
        "人也隠君子，一官聊自闲。",
        "谁能学管库，竟尔死茅菅。",
        "良璞不易剖，大弨终不弯。",
        "惟应太史录，他日出名山。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 216295,
      "title": "张夫人挽词",
      "content": [
        "世德簪缨贵，家风孝友传。",
        "承夫知不忌，爱子故亲贤。",
        "飘忽人间梦，生平物外缘。",
        "诸天清浄报，可但閟重泉。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 216296,
      "title": "吕郡君挽词",
      "content": [
        "表海东侯长，分吴异姓王。",
        "世家端作合，华裔远相望。",
        "龙去孤神剑，雏成九凤凰。",
        "多情潘散骑，悼逝足文章。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 216297,
      "title": "太府李萃卿挽词",
      "content": [
        "妙誉驰场屋，家风在搢绅。",
        "使华推厚德，卿月上通津。",
        "齿德时方重，山丘迹已陈。",
        "长年先友泪，怀感独沾巾。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 216298,
      "title": "太皇太后挽词",
      "content": [
        "共政艰难际，临朝保佑初。",
        "经纶付耆老，利泽到樵渔。",
        "礼盛谦常抑，功成委不居。",
        "圣君深致孝，尽守典刑余。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 216299,
      "title": "李处道都曹丈挽词",
      "content": [
        "凄凉正始后，尚复有斯人。",
        "恸哭亦云已，伤心难重陈。",
        "传家双令器，怀德万遗民。",
        "尚想典刑在，萧然老鹤身。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 216300,
      "title": "栾提举妻石氏挽词",
      "content": [
        "和敬承夫顺，勤劬教子贤。",
        "平生积浄业，仓卒叹无年。",
        "孤剑留耿介，九雏谁抚怜。",
        "尘埃旧脂泽，春草掩新阡。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 216301,
      "title": "邓学士慎思挽词",
      "content": [
        "清苦吟诗客，癯羸嗜学身。",
        "诗书不得力，鬼物定欺人。",
        "类物传遗学，经书植妙因。",
        "九原谁与友，千载葬鱼臣。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 216302,
      "title": "潘鲠奉议挽词",
      "content": [
        "廉退辞荣早，清贫卜吉迟。",
        "买山新兆域，从窆旧书诗。",
        "松菊留三径，箪瓢遗两儿。",
        "升堂旧宾客，执绋涕交颐。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 216303,
      "title": "哭蔡彦规二首  其一",
      "content": [
        "青衫未白首，已叹掩新阡。",
        "哭别自今日，书来才去年。",
        "功因钟鼎记，名頼友朋传。",
        "平昔围棋笑，临枰更泫然。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 216304,
      "title": "哭蔡彦规二首  其二",
      "content": [
        "文章不用世，沦落掩山阿。",
        "命也人无奈，悲哉天谓何。",
        "至交嗟我少，双泪为君多。",
        "遥想山阳墓，秋风吹薜萝。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 216305,
      "title": "李少卿挽词",
      "content": [
        "青云旧驰誉，白发早辞荣。",
        "谈笑惟诗酒，交游尽老成。",
        "支离病中见，潇洒旧时情。",
        "已矣不可问，九原松柏声。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 216306,
      "title": "岁暮即事寄子由先生",
      "content": [
        "岁暮淮阳客，贫闲两有余。",
        "朝昏面壁坐，风雪闭门居。",
        "老去深依佛，年衰更嗜书。",
        "未能忘素业，聊用慰穷途。",
        "下里皆平屋，开门即古墟。",
        "鸡豚来近舍，舂汲頼邻夫。",
        "雪压移来竹，霜萎自种蔬。",
        "乌皮蒙燕几，褐帽裹僧颅。",
        "肉似闻韶客，斋如持律徒。",
        "女寒愁粉黛，男窘补衣裾。",
        "已病药三暴，辞贫饭一盂。",
        "长瓶卧墙角，短褐倒天吴。",
        "宵寐衾铺铁，晨炊米数珠。",
        "木镵随杜胫，葛制暖韩躯。",
        "时命今如此，功名已矣乎。",
        "谈愁风射马，拙待兔逢株。",
        "久慕香城乐，深谙梦境虚。",
        "谁怜九顿首，正有一长吁。",
        "瞻望身空老，苍茫岁欲除。",
        "何当闻妙诲，黥刖待完肤。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 216307,
      "title": "用欧阳文忠韵雪诗",
      "content": [
        "密雪当残腊，冲风到荜门。",
        "洒窗惊纸湿，入竹觉声繁。",
        "天阔飘无界，城高积有痕。",
        "气和归麦陇，水味到茶轩。",
        "广陌无游骑，空邮有滞辕。",
        "炎炉聊自暖，浊酒仅能温。",
        "野迥征鞍设，边寒塞甲屯。",
        "振奇歌历历，回袖舞蹲蹲。",
        "客至须驼褐，相逢頼酒樽。",
        "晴明占草木，春意到闲园。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 216308,
      "title": "题谯东魏武帝庙",
      "content": [
        "草昧群龙鬭，英雄接上游。",
        "吴卑青盖伏，蜀陋葆车留。",
        "挟汉临诸夏，中原半九州。",
        "人惊吕布缚，谁信本初忧。",
        "天作西南限，时方割据秋。",
        "力终回赤壁，功止霸诸侯。",
        "历数知归禹，乾坤正造周。",
        "事商完夙志，传子岂人谋。",
        "铜雀佳人恨，西陵拱木秋。",
        "千年故乡庙，歌舞荐牢羞。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 216309,
      "title": "过卫真太清宫追怀章圣皇帝游幸之盛小臣斐然成韵",
      "content": [
        "凤历开三叶，中原正偃兵。",
        "端居思道妙，顺动展精神。",
        "函谷传经后，涡阳旧宅新。",
        "龙蟠泉不竭，丹养桧长生。",
        "鸾鹤迎黄屋，烟霞避翠旌。",
        "琳瑯千佩玉，貔虎万屯营。",
        "邃殿仙容俨，灵庭盛礼行。",
        "书留河上语，碑勒大夫名。",
        "歌罢秋风晚，弓遗药鼎成。",
        "句陈严旧寝，辇道接新耕。",
        "日落重楼影，天寒暮鸟声。",
        "异时怀往事，千古有余情。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 216310,
      "title": "天庆观三色桧",
      "content": [
        "聚处岁寒物，生为千岁身。",
        "柯条虽自异，臭味本相亲。",
        "商季诸公子，茅家贤弟昆。",
        "分驱众彭恶，各共一清真。",
        "竽籁风中合，鳞鳍雨后伸。",
        "高枝如借便，轻举岂无人。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 216311,
      "title": "八月三日舟行自蔡河赴临淮",
      "content": [
        "旷野天垂地，川晴水见沙。",
        "河回迷向背，岸断忽桑麻。",
        "水阔时浮鹭，陂寒乍集鸦。",
        "年饥田濩落，岁晚客悲嗟。",
        "新月排云水，西风送日斜。",
        "孤舟何处宿，故国已天涯。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 216312,
      "title": "舟行即事二首  其一",
      "content": [
        "古岸生微霭，空林挂夕阳。",
        "霞辉明野色，天影战波光。",
        "集鸟村墟暗，鸣虫禾黍荒。",
        "秋高孤月静，天末巧云长。",
        "沙晚横归艇，川晴列去樯。",
        "登临自多感，何必寄他乡。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 216313,
      "title": "舟行即事二首  其二",
      "content": [
        "去去路日远，行行岁向深。",
        "晚田荒更阔，秋野晓多阴。",
        "岸蓼飞寒蝶，汀沙戏水禽。",
        "迎风芦颤叶，眩日枣装林。",
        "早蟹肥堪荐，村醪浊可斟。",
        "不劳频怅望，处处有鸣砧。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 216314,
      "title": "发崔桥",
      "content": [
        "野麦平芜陇，官榆卧古津。",
        "眠鸥沙上晓，幽草水边春。",
        "暖叶生浮绿，风漪起细鳞。",
        "青新桑媪筥，茜浄浣娘裙。",
        "有客悲芳芷，无人采白苹。",
        "可怜千里目，愁杀未归人。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 216315,
      "title": "和柳郎中山谷寺翠光亭长韵",
      "content": [
        "山深疑路断，古寺忽开门。",
        "乔木风霜急，荒崖云雨痕。",
        "朝霞明翠霭，秋雨濯岚昏。",
        "幽鸟不避客，闲云时入轩。",
        "重萝深更绿，碧涧浅无浑。",
        "宝地黄金布，飞泉白玉喷。",
        "庭闲卧驯鹿，果熟引王孙。",
        "禅静石为室，客迷桃满园。",
        "每悲尘世幻，方信梵王尊。",
        "野实饥堪荐，阳崖冬自温。",
        "便当安寂寞，何事走歊烦。",
        "清梵晨斋启，高松夜枕喧。",
        "逢人休问道，得意已忘言。",
        "直指曹溪路，劳将贝叶翻。",
        "功名叹不偶，岁月去如奔。",
        "久分疏轩冕，宁辞友玃猿。",
        "从容岩客话，粗粝野僧飧。",
        "即是平生乐，心期何日论。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 216316,
      "title": "访昙上人有感",
      "content": [
        "上人稀出入，黄叶闭门深。",
        "系马长林下，逢僧古殿阴。",
        "相逢成底事，乘兴偶来寻。",
        "静境亦何有，无言知祖心。",
        "生平避浮俗，与物苦差参。",
        "脱去犹未得，尘埃嗟滞淫。",
        "长廊秋日薄，古木野霜侵。",
        "徙倚谁晤语，独归还独吟。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 216317,
      "title": "夜吟",
      "content": [
        "帘卷凉侵户，窗虚月过帷。",
        "高桐清露湿，深柳夜蝉嘶。",
        "断绩银河转，欹斜斗柄移。",
        "风来高叶报，伏近候虫知。",
        "陶令尊无酒，潘生鬓有丝。",
        "将何慰愁寂，倚杖独题诗。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 216318,
      "title": "斜日二首  其一",
      "content": [
        "斜日归钱暑，秋容淡太虚。",
        "闲云工变易，片月自清孤。",
        "淹泊年华老，凄凉岁事余。",
        "时违自朴拙，兴懒日萧疏。",
        "阮籍慵耽酒，文园病著书。",
        "簪缨非草野，江海得樵渔。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 216319,
      "title": "斜日二首  其二",
      "content": [
        "伏尽金才壮，天高火欲流。",
        "病悰抛酷暑，诗兴得高秋。",
        "昼静尘埃少，宵凉河汉浮。",
        "青伤桐叶腻，爽夺蕙兰柔。",
        "晚岁寒将届，群芳叶不收。",
        "幽人多感慨，啼鴂助骚愁。",
        "病懒非高卧，疏迂却自由。",
        "功名与世事，摆落醉乡游。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 216320,
      "title": "岁暮独酌书事奉怀晁永宁",
      "content": [
        "天涯催晚岁，残律去如奔。",
        "入夜北风恶，多阴寒日昏。",
        "野吹余烧烬，溪落旧沙痕。",
        "霜重饥鹰疾，田空宿雁喧。",
        "山明千笋直，云积万营屯。",
        "足雨耕犂早，丰年柿栗繁。",
        "地平秦接席，土断洛开门。",
        "白首三年客，黄桑数亩村。",
        "懒梳悲发短，不寐守炉温。",
        "折骨披残枿，苍龙卧老根。",
        "晚篁犹𥩟思，幽蕊助消魂。",
        "慷慨双龙剑，飘零一酒樽。",
        "琳琅思秀色，环佩想清言。",
        "独语看明烛，空庭月出轩。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 216321,
      "title": "出都有感",
      "content": [
        "来时雪尽花初发，归去柳阴蝉乱鸣。",
        "四序风光半为客，百年飘泊一浮名。",
        "春来多病思高卧，老去违时畏后生。",
        "若有黄精换华发，敢随车马到高城。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 216322,
      "title": "赠别何道士",
      "content": [
        "疏散多违久自知，形骸况复病先衰。",
        "全身幸免诛三献，避世何劳赋五噫。",
        "闻说永嘉饶水石，便思轻帆向天涯。",
        "却嗟病翮伤摧甚，孤鹤高飞不得随。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 216323,
      "title": "北桥送客",
      "content": [
        "桥上垂杨系马嘶，桥头船尾插青旗。",
        "船来船去知多少，桥北桥南长别离。",
        "亭上几倾行客酒，游人自唱少年辞。",
        "百年回首皆陈迹，浮世飘零亦可悲。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 216324,
      "title": "九日独游怀故人",
      "content": [
        "故人分散在天涯，九日登临独叹嗟。",
        "人世光阴催日日，乡闾时节自家家。",
        "风烟满眼临秋尽，鼓角荒城送日斜。",
        "取醉凭谁正乌帽，遣愁犹强插黄花。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 216325,
      "title": "夜",
      "content": [
        "木落风高砧杵伤，孤城更漏入秋长。",
        "寒生疏牖人无梦，月过中庭树有霜。",
        "报落梧桐犹陨叶，知时蟋蟀解亲床。",
        "年年多病浑无寐，静对楞严一炷香。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 216326,
      "title": "早春",
      "content": [
        "辉辉暖日弄游丝，风软晴云缓缓飞。",
        "残雪暗随冰笋滴，新春偷向柳梢归。",
        "可怜鬓发蹉跎老，每惜梅花取次稀。",
        "何事都城轻薄子，买欢酤酒试春衣。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 216327,
      "title": "上元日驾回登楼二首  其一",
      "content": [
        "紫雾氛霏阊阖开，团团明月上天来。",
        "香车百两天街晚，清跸一声仙仗回。",
        "灯隔画帘时闪烁，风穿高幕故徘徊。",
        "太平日久多闲暇，簪笏从容侍燕杯。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 216328,
      "title": "上元日驾回登楼二首  其二",
      "content": [
        "长街十二远相通，阊阖峨峨彩雾红。",
        "天白华灯交皓月，楼寒朱幕荡春风。",
        "车头笑语归时醉，城下传呼夜向中。",
        "自古长安多乐事，周南留滞意何穷。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 216329,
      "title": "探春有感二首  其一",
      "content": [
        "出城但怪风光老，草色苍茫柳色深。",
        "烟树远浮春缥缈，风光不动日阴沉。",
        "芳郊未厌萦纡入，美酒何妨取次斟。",
        "羸马青衫亦何事，一生空负野人心。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 216330,
      "title": "探春有感二首  其二",
      "content": [
        "柳萼蒙茸待放绵，樱桃新叶大如钱。",
        "深春冷落花残后，寒食朦胧月淡天。",
        "独坐每将诗作伴，遣愁安得酒如泉。",
        "伤心千里休凝望，城外东风早满船。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 216331,
      "title": "暇日同孙毕二同舍游李氏园亭",
      "content": [
        "荡荡东风散客心，出门驱马问园林。",
        "花房待暖徐徐放，柳色随春旋旋深。",
        "城郭远来无俗客，松篁深处有幽禽。",
        "王公留壁题诗句，应许骚人尽日吟。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 216332,
      "title": "暮春",
      "content": [
        "夜雨轻寒拂晓晴，牡丹开尽过清明。",
        "庭前落絮谁家柳，叶里新声是处莺。",
        "白发生来如有信，青春归去更无情。",
        "便当种秫长成酒，远学陶潜过此生。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 216333,
      "title": "秋兴",
      "content": [
        "薄云蔽日晚悠悠，簷雨萧萧急未收。",
        "佳树已雕今岁叶，西风还是去年秋。",
        "蹉跎不奈时惊客，牢落惟凭酒散愁。",
        "多病支离欣得睡，晚来凉气满衾裯。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 216334,
      "title": "秋雨二首  其一",
      "content": [
        "急雨凄风未肯晴，墙阴先报候虫鸣。",
        "扫除暑气驱三伏，催促秋声向五更。",
        "美酒若能斟靖节，二毛偏解著潘生。",
        "醉来真有无穷意，老去何劳浪自惊。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 216335,
      "title": "秋雨二首  其二",
      "content": [
        "陋巷柴门揜寂寥，一窗风雨晚萧萧。",
        "清秋渐冷尤宜懒，闲日苦长无处消。",
        "乌几青筇扶病弱，素琴黄卷伴逍遥。",
        "交朋南北音书隔，虽有芳樽谁可招。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 216336,
      "title": "寿阳楼下泊舟有感",
      "content": [
        "寿阳楼下清淮水，帆去帆来何日休。",
        "浮世十年多少事，风烟依旧别离愁。",
        "楼头夜静行人绝，楼下影斜淮月秋。",
        "不道孤吟不能寐，一声羌笛怨谁舟。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 216337,
      "title": "和柳郎中舒州潜庵二首  其一",
      "content": [
        "浪走尘埃竟未甘，仙郎六十制潜庵。",
        "门前山色云侵坐，峰下秋光水满潭。",
        "野鹤避人巢古木，清猿乘月啸寒岩。",
        "从今不作轩裳客，多买烟霞未是贪。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 216338,
      "title": "和柳郎中舒州潜庵二首  其二",
      "content": [
        "苍颜华发未能甘，欲觉长年先创庵。",
        "坐久烟岚开翠壁，梦回云雨起寒潭。",
        "松风夜扫鸣琴榻，溪溜晴分种药岩。",
        "不是仙翁有仙骨，幽奇争许世人贪。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 216339,
      "title": "将至寿州初见淮山二首  其一",
      "content": [
        "浩荡平波欲接天，天光波色远相连。",
        "风鸣雨桨初离浦，岸转青山忽对船。",
        "泽国秋高添气象，人家南去好风烟。",
        "步兵何必江东走，自有鲈鱼不值钱。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 216340,
      "title": "将至寿州初见淮山二首  其二",
      "content": [
        "晚系孤舟古岸隈，蒹葭风定渚鸥回。",
        "山兼野色苍茫去，月向淮心晃荡来。",
        "秋色解将愁并至，年华偏与客相催。",
        "青衫手板徒劳尔，富贵功名安在哉。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
