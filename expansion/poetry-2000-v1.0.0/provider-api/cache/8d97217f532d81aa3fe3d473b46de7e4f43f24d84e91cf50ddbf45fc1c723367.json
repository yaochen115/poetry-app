{
  "data": [
    {
      "id": 13840,
      "title": "同年王圣源南都讲授",
      "content": [
        "刻意悲秋发未华，诸曹频费杜陵嗟。",
        "歌缘郢客高难和，璧是秦人误指瑕。",
        "绿底恩书褒振滞，乌衣群从庆还家。",
        "离宫万户经庠盛，却对诸生坐绛纱。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13841,
      "title": "守塞三年上北京留守贾相公  其一",
      "content": [
        "天心北顾倚长城，上相元戎两印荣。",
        "鸡羽静沈传处檄，虎皮间里战余兵。",
        "九宵冬日人蒙惠，万耒春霖俗劝耕。",
        "和气愈充身愈退，只忧难避是功名。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13842,
      "title": "守塞三年上北京留守贾相公  其二",
      "content": [
        "雨洗星街夜祲空，暂持鱼牧守离宫。",
        "臯陶旧曲明良内，郤縠高谈礼乐中。",
        "载笔后车云盖密，鸣铙前队锦褠红。",
        "不妨华发千官上，始称凌烟第一功。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13843,
      "title": "暮春",
      "content": [
        "伏槛临堂更曲池，鲜风淡荡燕参差。",
        "蕙残已觉铜盘冷，梅落犹烦玉笛吹。",
        "拂世只愁衣带缓，当筵但诉玉杯迟。",
        "羲和辛苦真何益，不放金乌宿故枝。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13844,
      "title": "感怀",
      "content": [
        "俯首周南泪未干，惊开鱼素得双盘。",
        "心随月树乌三匝，病费仙山药一丸。",
        "久许横经陪阙里，更忧举步学邯郸。",
        "髀销衣缓风波苦，鸿陆归飞燕厦宽。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13845,
      "title": "续抒感怀",
      "content": [
        "出案屯营卧治州，黄云三结塞垣秋。",
        "敦诗未必真谋帅，有恨何妨老不侯。",
        "百虑参差非壮境，一樽寥落但边愁。",
        "此时自跃知无愧，万物炉中许见收。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13846,
      "title": "官廪月钱不足经费",
      "content": [
        "俸微才给斗升储，炀灶烟沈乏爨苏。",
        "下泽出游无款段，长安饱死羡侏儒。",
        "病杯残蚁分蛇影，梦管流尘晦鼠须。",
        "天极包荒恩未报，敢随张翰忆秋鲈。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13847,
      "title": "书怀  其一",
      "content": [
        "颜徒陋巷不堪忧，日晏南荣拥敝裘。",
        "已识交情一贵贱，宁论书置自沈浮。",
        "争名在昔闻探穴，嗅饵何人肯直钩。",
        "强欲诛茆启三径，邑中无客继羊求。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13848,
      "title": "书怀  其二",
      "content": [
        "功成有意避斋坛，睨柱无瑕玉更寒。",
        "万里长风收戍旆，三年零雨拂归鞍。",
        "樽中酒美催高会，圯上书闲得细看。",
        "岁晏雪园宾盖少，要须枚叟奉余欢。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13849,
      "title": "春雪",
      "content": [
        "银砾欺春乱眼来，重阴万里压平台。",
        "光沈后牖将飞瓦，艳补南枝已落梅。",
        "池曲平翻冰共泮，山腰未积玉争颓。",
        "长安并长旗亭价，蜀女当垆自涤杯。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13850,
      "title": "春雪寄郑府尹",
      "content": [
        "风御凭空揽玉尘，急飘斜舞碎霙匀。",
        "九重阙里都无夜，五出花前自作春。",
        "賸借薄寒添雁夕，强留余晦恼鸾晨。",
        "须知柳絮纷纷态，迷杀章台便面人。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13851,
      "title": "看雪",
      "content": [
        "惨淡繁云密霰狂，结瑶城堞俨相望。",
        "偷寻柳絮思隋岸，误折蔾光认洛阳。",
        "斜透绮帘欺翡翠，旋迷楼瓦失鸳鸯。",
        "平台宾客今何在，谁继邹枚从孝王。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13852,
      "title": "望仙亭置酒看雪",
      "content": [
        "雪压春期蔽曙空，凭高把酒思无穷。",
        "光侵病鬓都成白，寒著酡颜久未红。",
        "淮浒乱迷珠罅月，柳园狂误絮时风。",
        "使君醉笔惭妍唱，半落巴人下里中。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13853,
      "title": "答通判张太博贺雪应期",
      "content": [
        "亲祝星鱼裂绘绡，再旬方见瑞英飘。",
        "阴连腊底寒威在，润压春头疠气销。",
        "碎粒有声欺瓦屋，乱花无次恼林条。",
        "府中上客真才子，首为常民续楚谣。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13854,
      "title": "对雪二首  其一",
      "content": [
        "风过龙山万里沙，密霙疏霰渺无涯。",
        "台疑穆满都成璧，树忆黄奴并是花。",
        "曾许轻姿饶白羽，解将寒力减流霞。",
        "梁王不悦邹枚老，同坐睢园念岁华。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13855,
      "title": "对雪二首  其二",
      "content": [
        "萦丛著树半潇潇，皓气妍华混泬寥。",
        "为倚风流偏解舞，故藏朝晛未成消。",
        "玉绳四彻仙峰迥，银界三千佛国遥。",
        "向曙纷纷殊未已，九门知有谢庄朝。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13856,
      "title": "和晏相公乘舆宿殿致斋日巡仗遇雪",
      "content": [
        "天京飞雪洒车装，九九清尘御路长。",
        "斜影不迷宣曲骑，薄花才点羽林枪。",
        "观边丽色含𫛛鹊，盖外轻阴亚凤凰。",
        "谁识宪驺巡趠盛，赐袍冲霰入林光。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13857,
      "title": "和晏相公夜归遇雪",
      "content": [
        "孝王台下糅花飞，草草归骖骤碧啼。",
        "斗作暝寒凌冒絮，更回余舞拂鄣泥。",
        "城连迥阙迷苍凤，人度长桥压素霓。",
        "颓玉正酣天幕静，不妨清思入新题。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13858,
      "title": "汉南都监官廨射亭",
      "content": [
        "的晕遥连射圃墙，碧帘烟瓦鬭翚翔。",
        "庭中桂树含春早，席外帘衣拂地长。",
        "鲙缕荐盘鳊项缩，酒杯行算蟹螯香。",
        "主翁绶带多欢极，宾辖沈声在井床。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13859,
      "title": "寄献许昌晏相公",
      "content": [
        "右辅风烟接上都，功成番爱驻州旟。",
        "炉经万物为铜后，田是诸侯假璧余。",
        "合宴金匏催大白，当年宾从照红蕖。",
        "向来病守成惆怅，不预怀铅奉相车。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13860,
      "title": "绝荤",
      "content": [
        "多年卧病厌腥𦝼，香饭初依竺国流。",
        "宣父蒲葅真可学，钟岏蚶蛎更无求。",
        "炉销午篆天花泊，几隠宵灯偈叶留。",
        "割肉炰羔非我事，此身今悟一浮沤。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13861,
      "title": "寄题眉州孙氏书楼",
      "content": [
        "鲁简多年屋壁藏，始营翚棘瞰堂皇。",
        "髹厨四匝香防蠹，镂椠千题缥制囊。",
        "定与乡人评月旦，何妨婢子诵灵光。",
        "良辰更此邀清赏，庭树交阴隽味长。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13862,
      "title": "南岘候馆晚春有感献郡守",
      "content": [
        "春晖明淡上三竿，风菀愁红迈蔕残。",
        "梦后单衾凌晚薄，体中余酒向醒寒。",
        "山梁嗅雉晨羞饫，楯鼻磨铅藻思干。",
        "深愧府公宾礼厚，不教持版预粗官。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13863,
      "title": "三月晦日",
      "content": [
        "静弹尘帻照溪流，落泊春芳向尽头。",
        "早叶乍浓留客坐，晚花犹在索人愁。",
        "最怜幽草能萦带，已觉浮云解映楼。",
        "玉发未多须剧饮，赢输宁属阿戎筹。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13864,
      "title": "夜宴",
      "content": [
        "卜夜金华逼绮寮，星河垂地漏声遥。",
        "吟龙递怨先供舞，留凤愁寒不傍箫。",
        "隔坐联章催镂管，分行度曲认金翘。",
        "平明便是骊驹别，莫使衣香即日消。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13865,
      "title": "答燕龙图对雪宴百花见寄",
      "content": [
        "百花洲外六花寒，使幕凌晨把酒看。",
        "舞袂回风人鬭丽，醉山颓玉客留欢。",
        "斜霏北渚离鸿下，密洒东风宝骑攒。",
        "犹念平台旧朋侣，远将清句代幽兰。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13866,
      "title": "休日阅古堂小宴",
      "content": [
        "宴堂丛橑倚晨霏，客衽风清酒力微。",
        "曲沼新荷能碍钓，霁林浓叶不通飞。",
        "盘纷素脍鱼腴美，齿渍寒津蔗境肥。",
        "一笑相欢无吏责，张扶应悟坐曹非。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13867,
      "title": "陈奉礼宰四明",
      "content": [
        "大庭联袂掞英华，龙凤池名在一家。",
        "雁塔墨痕鸰继序，桂林春色棣交花。",
        "袍薰茂草萋萋远，樯竖归风栉栉斜。",
        "灵越弦歌皆胜践，递赓清思赋余霞。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13868,
      "title": "答彭州职方朱员外公绰",
      "content": [
        "四忝方州换隼旟，九番官树老储胥。",
        "淹留太史编残藁，废忘河东箧里书。",
        "远想渊云才不逮，略通邛僰计仍疏。",
        "梦回密友偏矜我，时损瑶音附鲤鱼。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13869,
      "title": "舣舟怀信亭",
      "content": [
        "使麾得请印垂腰，不畏秋风病鬓凋。",
        "游子已携河上手，客槎犹在斗边桥。",
        "水从南浦伤离剧，马近东方作意骄。",
        "晓榻梦回翻自愧，卧听人赴午门朝。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13870,
      "title": "省判李度支硕相过叙别兼述感怀",
      "content": [
        "君趋召节向中台，我滞边州未得回。",
        "头白羞论天下事，眼青欣举故人杯。",
        "池蛟得雨鳞先动，霜隼乘风翅始开。",
        "见上若询颇牧将，为言儒帅果非才。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13871,
      "title": "监中会两禁诸公饮饯吴舍人梁正言富修撰叶龙图以计省不赴作诗见寄",
      "content": [
        "殊庭诏跸斗车回，学省歌骊宴豆开。",
        "孺子橐闲同放笔，景山铛暖不停杯。",
        "桥门细溜生寒沼，经市斜光落晚槐。",
        "捉麈知君非兴浅，枉教华剧计筹催。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13872,
      "title": "客自茂来言元礼日观棋剧饮",
      "content": [
        "寒山倒影入楼扉，铃唱愔愔少诤辞。",
        "左手持螯人嗜饮，一斑窥豹客争棋。",
        "萍游倦斝伤酲夕，星落残枰鬭劫迟。",
        "日日忘怀还忆否，戍时瓜老是归时。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13873,
      "title": "冬夜饮散怅然有感",
      "content": [
        "酏颜夜酌釂兰巵，怅忆雕年事半违。",
        "雪墅陇云寒寡色，霜天幌月暗通辉。",
        "素书有恨随鸿远，蘧梦无成伴蝶归。",
        "可得延陵重一听，流波雅引在金徽。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13874,
      "title": "东湖禅院",
      "content": [
        "像阁缘云一水东，鹿园珍树蔽青葱。",
        "漂残劫烬神池浪，吹去菱花讲坐风。",
        "仙石拂衣寒起雾，层沙聚塔远凌空。",
        "赤髭净侣移谈久，牛首青烟匝篆红。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13875,
      "title": "送客野外始见春物萌动",
      "content": [
        "苑路高高雪作泥，始知春信到芳蹊。",
        "绿波水暖鱼腮骤，缥色陂长麦首齐。",
        "万里碧云随望合，半规红日有情低。",
        "榆牙柳目相看数，枉是回肠付解携。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13876,
      "title": "送客不及",
      "content": [
        "祖帟难留十里筵，亭臯衰柳但长烟。",
        "班骓不及来时路，黄鹄空惊去后弦。",
        "曾是松心同岁晚，怒无梅信发春前。",
        "南楼漫作凭高计，望尽天涯更有天。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13877,
      "title": "江上送客",
      "content": [
        "十里长臯五里亭，天涯送月泪缘缨。",
        "洛辞但许凌波渡，桃曲犹烦用檝迎。",
        "远信即时劳裂素，客心何日免摇旌。",
        "芳晨莫遣归期晚，碧草江南正乱鸾。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13878,
      "title": "倦客",
      "content": [
        "貂裘敝尽饮瓢空，身滞平台倦客中。",
        "濩落本依庄栎社，飘飖误闭陇鹦笼。",
        "心缘远别长依旆，发近穷年已付蓬。",
        "素愿禄储过六百，云罗天外有冥鸿。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13879,
      "title": "登师利寺文殊阁",
      "content": [
        "宝梯斜级上盘空，千里亭臯一眺穷。",
        "翠柰自生经苑地，萎花时堕佛天风。",
        "桥横颍岸淙幽碧，日下嵩云插倒红。",
        "暂涤六尘凭槛久，可嗟归御太匆匆。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13880,
      "title": "中山公损疾二首  其一",
      "content": [
        "自有西京七发才，蠲疴不待更延枚。",
        "𪭢金广乐迷魂寤，蔽月飞云病膜开。",
        "宫鼠晦须抛赐琯，蓬鱼霏缕强晨杯。",
        "何人过问维摩室，定有文殊作礼来。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13881,
      "title": "中山公损疾二首  其二",
      "content": [
        "恳避严庐十拜章，一麾重许出东方。",
        "批成诏凤多焚草，戏入仙禽不乱行。",
        "丽正书编争授简，荆州象笏别持囊。",
        "绛帷有客悲秋早，预怯临流奉祖觞。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13882,
      "title": "长兄冬夕递宿偶成长句上寄",
      "content": [
        "绛帻鸡人唱夜筹，宿庐遥忖道山头。",
        "梦思园吏成覊寝，书掩冤家倦对雠。",
        "雨阁气昏莲蔕并，烛帘光动蒜条钩。",
        "孤吟一夕怀康乐，广陌黎明望紫骝。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13883,
      "title": "和王龙图七夕直宿",
      "content": [
        "二星秋早驾云车，此夕闻君寓直庐。",
        "月在宫中穿线处，香传楼下曝衣余。",
        "桥乌径度明河近，巢凤归翻暝阁虚。",
        "寂寞潜郎谁晤语，只应藜烛伴雠书。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13884,
      "title": "和宫师相公待制庞学士贤年二韵续川然两字",
      "content": [
        "龙楼一品亚台联，佚老归来帝养贤。",
        "商皓岭芝追隠伴，胡公潭菊得高年。",
        "客盘梅熟经调鼎，宴渚舟横旧济川。",
        "延阁裁章纡和曲，玉音风驭共泠然。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13885,
      "title": "友人书斋",
      "content": [
        "雩上鲜风拂袂过，讼庭谈树自婆娑。",
        "东家屋壁韦经绝，左氏门庭赋笔多。",
        "岫幌蟾蜍生夕露，墨池科斗动圆波。",
        "学诗梦草丰余暇，万寿称觞醉弁俄。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13886,
      "title": "感事",
      "content": [
        "曹鼠秦车未足多，几人曾此动悲歌。",
        "鸿心不慕冥冥弋，凫胫长随泛泛波。",
        "方朔一生游禁籞，彦伦终古老山阿。",
        "江淹若是真多恨，古往今来奈尔何。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13887,
      "title": "答李从著作",
      "content": [
        "身是鸡翘侍从流，单车淮上老为州。",
        "全生正似婆娑树，不死翻成觳觫牛。",
        "今日空名同地餠，晚年归计有瓜畴。",
        "惭君远寄相思句，不啻三逢采艾秋。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13888,
      "title": "朱舜卿南游有寄",
      "content": [
        "汉臯烟浪泼醅春，弭节江干一问津。",
        "南浦草平偏送客，大堤花晚欲留人。",
        "归心怨逐摇摇旆，尺素愁迷六六鳞。",
        "湘册聚萤嵇几静，露轩香粉暗书筠。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13889,
      "title": "贺紫微舍人改镇",
      "content": [
        "星翼分疆镇上游，江山和气拥行舟。",
        "芝房照露供盘剂，萍日横波送棹讴。",
        "楚塞路长云恋幕，孺亭天晚月呈钩。",
        "汉家夜席归期近，宫箧书空谤焰收。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13890,
      "title": "送孙皋",
      "content": [
        "江边瑶草鬭袍青，所乐从军得四明。",
        "新水一篙催泛鹢，故林三月及闻鶑。",
        "羽书无警栖毫熟，谈幄多欢醉叶倾。",
        "我亦中都厌羊酪，为传秋思与莼羹。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13891,
      "title": "送黄灏",
      "content": [
        "横步文林二十春，华颠初得半通纶。",
        "江边又濯沧浪水，堂上宁招肮脏人。",
        "未分尘缨惭蕙帐，不缘羊酪弃羹莼。",
        "思家夕梦还都信，并附秋波六六鳞。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13892,
      "title": "送张问南游",
      "content": [
        "草远花明沟水头，同君此地并离愁。",
        "盖余瓮酒沈三赋，合作盘鲭厌五侯。",
        "觉在他乡应有梦，信非吾土少登楼。",
        "楚山不见西江远，莫反骚文剩驻留。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13893,
      "title": "送郑天休",
      "content": [
        "春筠蒸徧擿锋摧，剡奏飘然别上台。",
        "授简客惊枚乘去，探书人继史公来。",
        "爆桐度曲离筵惨，樵的分风使棹催。",
        "千万禊滨传善序，永和三月有流杯。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13894,
      "title": "送马房",
      "content": [
        "百五天长甚雨回，祖筵离思冷如灰。",
        "骋辞睢苑繁云散，拄颊西山晓气来。",
        "草色不须争去袂，花光正欲傍迎醅。",
        "相君卧镇群英集，一府翘然用楚材。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13895,
      "title": "三月四日玩园花小集",
      "content": [
        "中园爱客重游陪，三月林花落复开。",
        "镂管喜传吟处笔，白波催卷醉时杯。",
        "欢襟已快邀风度，舞地犹宽放雪回。",
        "不是年芳相假借，使君兼乏斐然才。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13896,
      "title": "春夕雨歇",
      "content": [
        "江云夜雨过前墀，菌阁微凉縠雾披。",
        "戒井漏残银箭促，青天笑罢玉壶欹。",
        "文波弱荇浮清濑，珍树惊禽遶暗枝。",
        "纵使何郎诗笔在，未应幽恨抵兰时。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13897,
      "title": "城西晚眺",
      "content": [
        "北榭风轻爽醉襟，天涯摇落对登临。",
        "一篙寒浪船移浦，千尾残阳鸟赴林。",
        "倦客亭臯时远笛，早寒墟里渐疏碪。",
        "凭栏不觉休边角，暝气苍茫失半岑。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13898,
      "title": "题著作魏仲先隠墅",
      "content": [
        "隠路高高入翠微，人亡宅在有余悲。",
        "自圆溪月知吟处，不散岩云忆卧时。",
        "素壁尘昏三纪貌，白杨风老几寻枝。",
        "草堂故集篇篇好，要与商翁续紫芝。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13899,
      "title": "杜少卿知陆州",
      "content": [
        "三年去国别尧云，一箧书空此谤分。",
        "贾谊有才偏陨涕，屈原何赋不思君。",
        "谏囊久晦沈余草，绶笥重开续旧薰。",
        "几日班春向桑野，汉家新诏十行文。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13900,
      "title": "程密学知益州",
      "content": [
        "墀涂昼对光尧蓂，细札芝泥袭绶馨。",
        "三独旧台呼辐宠，十连新府梦刀灵。",
        "云梯霁日明钩栈，雨阁苍苔蚀剑铭。",
        "只恐廉襦歌未厌，萤煌归应六符星。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13901,
      "title": "张屯田知兖州",
      "content": [
        "汉家关内使驺来，广鲁风旟画隼开。",
        "地得股肱雄近辅，书留筋骨冠中台。",
        "儒宫刬壁严祠豆，督府均羊盛宴罍。",
        "应望仙闾旧车道，倚天娲石篆昭回。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13902,
      "title": "叶司封知宣州",
      "content": [
        "岁久中台鹄领垂，牢盆罢计拥藩麾。",
        "新加绶艾天香袭，密对帘须禁刻移。",
        "青舸信潮随早暮，赤轓灵雨徧公私。",
        "树犹如此成前感，重荫当年蔽芾枝。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13903,
      "title": "病兴",
      "content": [
        "病兴还见岁华阴，身属櫜鞬久未任。",
        "主画固须烦孟博，作书宁免倩陈琳。",
        "仙丸玉匕贪余饵，甜酎银瓯喜细斟。",
        "谁笑衣囊长寂寞，横思新得汉台金。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13904,
      "title": "送俞给事知宣州",
      "content": [
        "恳乞江南太守麾，过家为有故山期。",
        "使轩密雨千驺拥，琐闼斜阳一拜辞。",
        "枕底潮鸡参驿鼓，船头沙鸨避牙旗。",
        "此行正及吴羹美，雉尾莼香欲变丝。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13905,
      "title": "凌屯田知和州",
      "content": [
        "坡殿程篇属思精，飘飘老气薄黔嬴。",
        "一台旧服郎官笔，千骑新提太守兵。",
        "候吏腾装催去舸，故人引脰怅离觥。",
        "云波莫苦秋江阔，自有桃歌用檝迎。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13906,
      "title": "送郭太保知相州",
      "content": [
        "螭阶看引羽林兵，罢直还家得使旌。",
        "黼帐三云清晓别，锦鄣千骑上头迎。",
        "鸳沈故瓦秋烟阔，凤下长阿夕照平。",
        "谁伴燕休同把酒，嘈嘈歌鼓亚夫营。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13907,
      "title": "张宫苑拜嘉州刺史知恩州",
      "content": [
        "二年同守梦刀城，遥节初为北道行。",
        "飞将负才曾捕虏，伏波见上数论兵。",
        "剑南剩腊梅迎使，塞下新春柳映营。",
        "贵宠逼身头未白，七貂终嗣汉西京。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13908,
      "title": "哭公孙子正",
      "content": [
        "穷愁四十鬓华侵，肘卧垂杨感慨深。",
        "遗墨未干园令札，悲弦长绝献之琴。",
        "嗟贤有梦龙占苦，对臆无言𫛳坐阴。",
        "三步过车绵酹薄，死生从此隔朋簪。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13909,
      "title": "七夕  其一",
      "content": [
        "开秋七夕到佳辰，里俗争夸节物新。",
        "乌鹊桥头已凉夜，黄姑渚畔暂归人。",
        "裴回月御斜光敛，宛转蛛丝巧意真。",
        "卜肆沈冥谁复问，年年槎路上天津。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13910,
      "title": "七夕  其二",
      "content": [
        "西南新月玉成钩，奕奕神光渡饮牛。",
        "素彩低浮承露掌，清香不散曝衣楼。",
        "天边华幄催云卷，星外横桥伴客愁。",
        "莫使银河到沧海，人间沟水易东流。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13911,
      "title": "冬眺",
      "content": [
        "城外斜光角已催，城头倦客首空回。",
        "星霜牢落凋年往，天地苍茫暝色来。",
        "千尾昏鸦愁迥戍，几蹄征马思穷埃。",
        "使君兴罢惟无绪，不是登高能赋才。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13912,
      "title": "朱舜卿归自别墅",
      "content": [
        "逍遥初服偃郊扉，学舍经旬望贡綦。",
        "庾信移谈思讲树，周颙回驾避低枝。",
        "摛华更喜联新唱，散秩犹烦莹旧疑。",
        "欲序三都先自媿，士安风痹素清羸。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13913,
      "title": "感秋",
      "content": [
        "回肠病骨两惊秋，已作衰翁未白头。",
        "天上有星宁免客，人间无地可埋忧。",
        "车翻落日何曾定，臂化鸣鸮岂易求。",
        "莫就离鸿寄归思，离鸿身世更悠悠。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13914,
      "title": "和十九日湖上与张集贤饯提刑张都官韵",
      "content": [
        "共凭高榭眺云波，使节将归可奈何。",
        "醇酒暂留丞相饮，骊驹愁对主人歌。",
        "千岩日下催云合，万里风长送雁过。",
        "兹会难言须惜别，岁阴光景玩蹉跎。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13915,
      "title": "苦雨中作",
      "content": [
        "云阵穷天雨足低，阴霞不照露盘西。",
        "城高已蔽觚棱凤，水浊先愁独漉泥。",
        "战蚁争封缘暗穴，怒蛙邀轼沸空蹊。",
        "斋窗病枕迷昏晏，只有喈喈托曙鸡。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13916,
      "title": "送韩太祝",
      "content": [
        "云阵星躔促传车，长安初日望储胥。",
        "金闺引籍中天阙，玉字藏家上帝书。",
        "祖道泛萍觞易釂，赋园飞雪席应虚。",
        "承明再过怀先业，磐石深沈禁树疏。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13917,
      "title": "送萧山宰刘寺丞",
      "content": [
        "秋江九月鹭涛平，楚客征樯拂县星。",
        "射的初过若耶渚，禊林重访永和亭。",
        "畏蛟俗富风移古，飞乙天长日际冥。",
        "几帙异书藏卧帐，肯容伧客广蒸青。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13918,
      "title": "孙沆从事宰吴兴邑",
      "content": [
        "舳尾东衔鸟羽轻，沧浪余沫恣霑缨。",
        "尚沈幕府千人俊，却劝疁田二耦耕。",
        "莲有艳歌邀夕泛，蔗留佳境析朝酲。",
        "行行正及吴蚕咡，脆尽商弦别曲声。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13919,
      "title": "寄献澶渊太傅",
      "content": [
        "使旆高翻西北云，舟梁横过九江𣸣。",
        "文书吏乐轻车府，表帜人知大树军。",
        "引溉劭农渠雨密，感凉邀会帐霞醺。",
        "花门车子能歌地，乐职声诗日夕闻。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13920,
      "title": "祗答太傅邓国张相公",
      "content": [
        "鸭陂清浪撼城隅，此地班春忝细书。",
        "琪树老来抛禁省，玉绳低处认皇居。",
        "君轩恋结萧萧马，客素愁凭六六鱼。",
        "相阁裁章怜旧物，为曾簪笔从雕舆。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13921,
      "title": "登塔",
      "content": [
        "窣堵缘霄雁势联，凭阑清眺俯三川。",
        "春华已徧燃灯地，日气犹烘噀雨天。",
        "游盖结阴尘不动，饮筹催釂客争传。",
        "须知四级题名处，要记浮生六十年。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13922,
      "title": "和延州庞龙图见寄",
      "content": [
        "交戟多年著皂衣，乞州初逐阮咸麾。",
        "惊残鸟翮虚弓笑，倾尽葵心白日知。",
        "宿莽骚人传丽赋，女萝山鬼赛丛祠。",
        "自惭念旧殊非计，正是朋游掉臂时。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13923,
      "title": "再寄",
      "content": [
        "铃下呼儿破锦鳞，新篇遗我故情亲。",
        "铩鸾遂有翻飞日，行苇应无践履人。",
        "谗毒未销须刮骨，上恩难报止沾巾。",
        "夫君何事材为累，短褐征衣拥塞尘。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13924,
      "title": "山中清明",
      "content": [
        "一雨东郊卷夕云，山中坐对寂寥春。",
        "高低桃锦红相倚，轻重榆钱绿不匀。",
        "杯冷罗门抛午案，簺残犀槊晦流尘。",
        "汉鳊渐美开鱼禁，已约溪公下钓缗。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13925,
      "title": "隠几",
      "content": [
        "空斋隠几度流光，濩落由来我所长。",
        "枉许是非同喻马，不知书簺两亡羊。",
        "空名更甚浮云薄，代事都无半捶强。",
        "心誓前贤六百石，异时初服返东冈。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13926,
      "title": "题多宝寺水阁",
      "content": [
        "宝坊云构压河流，梁日东南宿雾收。",
        "涌塔千层排候雁，丛楹四注倚阴虬。",
        "低翻楚蕙鲜风晓，横逗吴飚下濑秋。",
        "暇日便堪供赋笔，不烦王粲更登楼。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13927,
      "title": "赠张斋郎",
      "content": [
        "青丝垂领称华簪，结驷千门别第深。",
        "学舍问诗衣五彩，家庭佐酒寿千金。",
        "赪兰媚畹供晨膳，碧草生塘动昼吟。",
        "独感旧游移岸谷，山阳疏笛泪涔涔。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13928,
      "title": "赠潘斋郎",
      "content": [
        "吟塘春草夺袍青，兰玉仙姿出谢庭。",
        "刻羽雕章传雪市，煎波丽赋淹云溟。",
        "逢衣四座开宾榻，彩服千金献寿醽。",
        "汉殿前期思削牍，紫围翔步弁如星。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13929,
      "title": "题横山寺",
      "content": [
        "碧山千叠隠招提，净刹岧亭拂彩蜺。",
        "月涧溜琴喧菌阁，雨天云叶晦璇题。",
        "寒销炉篆螟风细，密亚岩烟凤竹低。",
        "病久毗邪真得赏，迷津一滴恋曹溪。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13930,
      "title": "闰正月二十五日送客寻春集裴氏园",
      "content": [
        "寻春送客共留连，雨罢春郊物物妍。",
        "黄抹柳梢初徧后，紫粘花萼未开前。",
        "朋襟自为交欢悴，醉斝谁能辨圣贤。",
        "犹頼斜阳催跋马，不然离恨损丝弦。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13931,
      "title": "和李屯田西湖寻春",
      "content": [
        "把酒同寻湖畔春，赏心何况更良辰。",
        "留阴岸雨溥红杏，送暖汀风恼绿苹。",
        "低写卧虹桥齿密，小装文鹢舫头新。",
        "聚星亭上华簪客，即是高阳旧里人。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13932,
      "title": "和武宣徽陕楼晚望有怀旧游",
      "content": [
        "陕楼重倚望轩城，百感中来久未平。",
        "屈指疑迁饶岁月，逼身添重许功名。",
        "飞觞置酒高阳兴，旧树攀条司马情。",
        "昔日使君今上将，请看前后万犀兵。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13933,
      "title": "欹枕",
      "content": [
        "欹枕风窗雪絮繁，梦回红日转南轩。",
        "栖迟自乐周人什，偃息终非魏国藩。",
        "书习练裙聊弄翰，吟随池草欲迷魂。",
        "疏慵不喜当关报，罗雀先时署翟门。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13934,
      "title": "祗答天平相国庞公追记旧游见寄",
      "content": [
        "把酒同为花下宾，东风一十五回春。",
        "欢情坠若瓶边绠，感绪多干臼里辛。",
        "枚马老能持从笔，夔龙今已避鸿钧。",
        "附尘旧好公须忆，憔悴惟残厌次人。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13935,
      "title": "杨都官日严赴郓州",
      "content": [
        "连年三换左朱轮，正用台郎第二人。",
        "帷殿程书清刻永，家床添笏赐袍新。",
        "润波仍跨洪河曲，敏政将肥瘠鲁民。",
        "趣引前旍向桑野，汉皇恩诏重方春。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13936,
      "title": "杪秋官舍念归",
      "content": [
        "独计年华念鬓华，秋来依旧滞天涯。",
        "半分沈约愁销臂，一束钟繇忆赐花。",
        "寂寞林蝉应自叹，氃氋庭鹤待谁夸。",
        "西江闻道通星汉，试借君平问客槎。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13937,
      "title": "登高晚思",
      "content": [
        "喜祓尘襟属丽谯，高旻雨罢暑氛销。",
        "游回宿鸟霞横岭，唱杀寒蝉柳抱桥。",
        "戍壁风烟闲尉候，客亭灯火混渔樵。",
        "山川信美非吾乐，已是三年去国遥。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13938,
      "title": "一雨",
      "content": [
        "一雨初收细细凉，碧云西畔见残阳。",
        "归期只觉刀头远，别恨偏教带眼长。",
        "梅驿使稀谁托信，蕙盘烟冷不成香。",
        "酒泉已是三千里，何况关门未得望。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13939,
      "title": "谢都官监治建州",
      "content": [
        "初得中台满岁迁，七闽犹贰左鱼权。",
        "鸡香烬晦华星闼，虎眼波迎下濑船。",
        "几种珍鲑资昼膳，万岑芳茗蔽春廛。",
        "行行正及陶嘉月，溪树烘霞荔子鲜。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    }
