{
  "data": [
    {
      "id": 80385,
      "title": "赠陈管辖",
      "content": [
        "一拂清风一袖云，紫阳容貌鹤精神。",
        "诗因道进言辞别，丹得师传火候真。",
        "庐岳峰前吟瀑布，浑仪图上礼星辰。",
        "我来暂作闲人歇，多谢仙翁相访频。"
      ],
      "author": {
        "id": 7098,
        "name": "翁卷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 80386,
      "title": "寄筠州张录事",
      "content": [
        "每到友朋相会地，未尝一日不思君。",
        "小诗曾托乡僧寄，善政因逢故客闻。",
        "山上仙踪丹鼎在，郭边溪色市桥分。",
        "公余若起吟游兴，游处多应见白云。"
      ],
      "author": {
        "id": 7098,
        "name": "翁卷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 80387,
      "title": "次徐灵渊韵赠赵灵秀",
      "content": [
        "一轴黄庭看不厌，诗囊茶器每随身。",
        "三年在任同仙隠，一日还家只旧贫。",
        "种得溪蒲生似发，教成野鹤舞如人。",
        "出门便是登山路，更要遥山翠色匀。"
      ],
      "author": {
        "id": 7098,
        "name": "翁卷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 80388,
      "title": "西风",
      "content": [
        "一处西风一处愁，又逢鸣雁在沧洲。",
        "芙蓉不分秋萧索，鬭拆繁红满树头。"
      ],
      "author": {
        "id": 7098,
        "name": "翁卷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 80389,
      "title": "雁池作",
      "content": [
        "包家门外柳垂垂，摇荡春风满雁池。",
        "为是城中最佳处，每经过此立多时。"
      ],
      "author": {
        "id": 7098,
        "name": "翁卷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 80390,
      "title": "舍外早梅",
      "content": [
        "行遍江村未有梅，一花忽向暖枝开。",
        "黄蜂何处知消息，便解寻香隔舍来。"
      ],
      "author": {
        "id": 7098,
        "name": "翁卷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 80391,
      "title": "冯公岭",
      "content": [
        "乱峰千叠拂云霓，辐合坑崖立似梯。",
        "曾向括州州里望，众山却是此山低。"
      ],
      "author": {
        "id": 7098,
        "name": "翁卷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 80392,
      "title": "东阳路傍蚕妇",
      "content": [
        "两鬓樵风一面尘，采桑桑上露沾身。",
        "相逢却道空辛苦，抽得丝来还别人。"
      ],
      "author": {
        "id": 7098,
        "name": "翁卷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 80393,
      "title": "山雨",
      "content": [
        "一夜满林星月白，且无云气亦无雷。",
        "平明忽见溪流急，知是他山落雨来。"
      ],
      "author": {
        "id": 7098,
        "name": "翁卷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 80394,
      "title": "寄山人徐灵晖",
      "content": [
        "只隔烟霞数里间，本期还往共幽闲。",
        "宁知逸羽飞相背，我入山来君出山。"
      ],
      "author": {
        "id": 7098,
        "name": "翁卷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 80395,
      "title": "还家夜同赵端行分韵赋",
      "content": [
        "莫怪繁霜满鬓侵，半年长路几关心。",
        "还家点检家中物，依旧清风在竹林。"
      ],
      "author": {
        "id": 7098,
        "name": "翁卷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 80396,
      "title": "东湖行",
      "content": [
        "湖水添时宿雨晴，野禽无处不春声。",
        "万株杨柳青如昨，全是东风染得成。"
      ],
      "author": {
        "id": 7098,
        "name": "翁卷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 80397,
      "title": "观落花",
      "content": [
        "才看艳蕾破春晴，又见飞花点点轻。",
        "纵是闲花自开落，东风毕竟亦无情。"
      ],
      "author": {
        "id": 7098,
        "name": "翁卷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 80398,
      "title": "寄张季思",
      "content": [
        "荆吴中隔万山遥，那得相逢话寂寥。",
        "长忆梅花好时节，访君船泊古枫桥。"
      ],
      "author": {
        "id": 7098,
        "name": "翁卷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 80399,
      "title": "题东池",
      "content": [
        "一池寒水绿粼粼，池上初梅白未匀。",
        "谁念酒旗飞动处，唐朝曾住作诗人。"
      ],
      "author": {
        "id": 7098,
        "name": "翁卷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 80400,
      "title": "秋怀",
      "content": [
        "不管秋天阴复晴，秋怀何处不凄清。",
        "江城几夜无佳月，亦有新诗对雨成。"
      ],
      "author": {
        "id": 7098,
        "name": "翁卷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 80401,
      "title": "野望",
      "content": [
        "一天秋色冷晴湾，无数峰峦远近间。",
        "闲上山来看野水，忽于水底见青山。"
      ],
      "author": {
        "id": 7098,
        "name": "翁卷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 80402,
      "title": "南塘即事",
      "content": [
        "半川寒日满村烟，红树青林古岸边。",
        "渔子不知何处去，渚禽飞落拗罾船。"
      ],
      "author": {
        "id": 7098,
        "name": "翁卷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 80403,
      "title": "春登南昌城",
      "content": [
        "独立高城四望低，望中无物不堪题。",
        "欲知春事几深浅，芳草青青犹未齐。"
      ],
      "author": {
        "id": 7098,
        "name": "翁卷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 80404,
      "title": "乡村四月",
      "content": [
        "绿遍山原白满川，子规声里雨如烟。",
        "乡村四月闲人少，才了蚕桑又插田。"
      ],
      "author": {
        "id": 7098,
        "name": "翁卷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 80405,
      "title": "悼旧呈赵紫芝",
      "content": [
        "忆向城南共说诗，山民与我定相随。",
        "如今独来还独往，此恨除君人不知。"
      ],
      "author": {
        "id": 7098,
        "name": "翁卷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 80406,
      "title": "冬日登富览亭",
      "content": [
        "未委海潮水，往来何不闲。",
        "轻烟分近郭，积雪盖遥山。",
        "渔舸汀鸿外，僧廊岛树间。",
        "晚寒难独立，吟竟小诗还。"
      ],
      "author": {
        "id": 7098,
        "name": "翁卷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 80407,
      "title": "赠九华李丹士",
      "content": [
        "行遍东南地，曾看江水源。",
        "袖藏勾漏药，身是老君孙。",
        "去住云相似，枯荣事不论。",
        "九华峰最碧，相对旧柴门。"
      ],
      "author": {
        "id": 7098,
        "name": "翁卷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 80408,
      "title": "幽居",
      "content": [
        "蓬户掩还开，幽居称不才。",
        "移松连峤土，买石带溪苔。",
        "药信仙方服，衣从古样裁。",
        "本无官可弃，何用赋归来。"
      ],
      "author": {
        "id": 7098,
        "name": "翁卷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 80409,
      "title": "赠葛天民",
      "content": [
        "燕本昔如此，清名千载垂。",
        "谁将囊米施，自拾束薪炊。",
        "柳影连山阁，湖波浸竹篱。",
        "朝昏无别事，只是欲吟诗。"
      ],
      "author": {
        "id": 7098,
        "name": "翁卷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 80410,
      "title": "梦回",
      "content": [
        "一枕庄生梦，囘来日未衙。",
        "自煎砂井水，更煮岳僧茶。",
        "宿雨消花气，惊雷长荻芽。",
        "故山沧海角，遥念在春华。"
      ],
      "author": {
        "id": 7098,
        "name": "翁卷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 80411,
      "title": "寄从善上人",
      "content": [
        "数载不相见，师应长闭关。",
        "香烟前代寺，秋色五峰山。",
        "棋进僧谁敌，琴余鹤共闲。",
        "几时重过我，吟话此林间。"
      ],
      "author": {
        "id": 7098,
        "name": "翁卷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 80412,
      "title": "偶题",
      "content": [
        "绿树何稠叠，清风稍羡余。",
        "枕萦云片片，帘透雨疎疎。",
        "修笕通泉壑，残碑出野锄。",
        "丘陵知几变，耕稼学陶渔。"
      ],
      "author": {
        "id": 7098,
        "name": "翁卷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 80413,
      "title": "泊舟龙游",
      "content": [
        "未得桥开锁，去船难自由。",
        "渚禽飞入竹，山叶下随流。",
        "忽见秋风喜，还成早岁愁。",
        "卧闻舟子说，明日到衢州。"
      ],
      "author": {
        "id": 7098,
        "name": "翁卷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 80414,
      "title": "闽中秋思",
      "content": [
        "客愁无定迹，几处冒风埃。",
        "逢得家乡便，凭将信息囘。",
        "海烟蛮树湿，秋雨瘴花开。",
        "旧日越王国，吾今身再来。"
      ],
      "author": {
        "id": 7098,
        "name": "翁卷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 80415,
      "title": "寿昌道中",
      "content": [
        "清游从此起，过处必须看。",
        "背日山梅瘦，随潮海鸭寒。",
        "平途迷望阔，峻岭疾行难。",
        "听得居人语，今年冬又残。"
      ],
      "author": {
        "id": 7098,
        "name": "翁卷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 80416,
      "title": "周氏东山草堂",
      "content": [
        "城隅古谢村，博士草堂存。",
        "唯见烟霞起，全无市井喧。",
        "鹊来巢木末，鼋出戏蒲根。",
        "消得吟诗客，凭栏看几番。"
      ],
      "author": {
        "id": 7098,
        "name": "翁卷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 80417,
      "title": "同徐道晖赵紫芝泛湖",
      "content": [
        "相见即相亲，吟坛得几人。",
        "扁舟当是日，胜赏共闲身。",
        "山雨曾添碧，湖风不动尘。",
        "晚来渔唱起，处处藕花新。"
      ],
      "author": {
        "id": 7098,
        "name": "翁卷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 80418,
      "title": "玉隆宫周道士自足轩",
      "content": [
        "贪得无厌者，应难共此居。",
        "炉中姹女药，案上老君书。",
        "花竹庭阶洁，风烟户牖虚。",
        "道人随分外，安坐不求余。"
      ],
      "author": {
        "id": 7098,
        "name": "翁卷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 80419,
      "title": "旅泊",
      "content": [
        "几日溪篷下，低垂困水程。",
        "喜因山县泊，略向岸汀行。",
        "闻笛生羁思，看松减宦情。",
        "遥知此夜月，必照故山明。"
      ],
      "author": {
        "id": 7098,
        "name": "翁卷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 80420,
      "title": "岳麓宫道房",
      "content": [
        "借问经行处，群仙第几家。",
        "晴簷鸣雪滴，虚砌影梅花。",
        "香𦶟何年柏，芽煎未社茶。",
        "道人三四辈，相对诵南华。"
      ],
      "author": {
        "id": 7098,
        "name": "翁卷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 80421,
      "title": "赠□□先生",
      "content": [
        "陇上穷年不辍耕，风吹纠笠自翾轻。",
        "攒眉且复看天醉，枵腹谁能与命争。",
        "李实于今难仲子，柳条何似问先生。",
        "不须远觅王官谷，雁荡峰头云自横。"
      ],
      "author": {
        "id": 7098,
        "name": "翁卷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 80422,
      "title": "寻僧",
      "content": [
        "秋净日晖晖，间行风满衣。",
        "寻僧虽不遇，折得菊花归。"
      ],
      "author": {
        "id": 7098,
        "name": "翁卷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 80423,
      "title": "赠普觉院道上人",
      "content": [
        "病来形转瘦，老忘出家年。",
        "对客多无语，贪闲懒赴缘。",
        "一斋能过日，几世已修禅。",
        "住傍观音阁，门前有井泉。"
      ],
      "author": {
        "id": 7098,
        "name": "翁卷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 80424,
      "title": "题定慧寺",
      "content": [
        "不知何代寺，寺向一溪分。",
        "幽磴稀来往，闲僧绝见闻。",
        "尘昏金佛相，藓断石碑文。",
        "渔子并樵客，炉烟此处焚。"
      ],
      "author": {
        "id": 7098,
        "name": "翁卷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 80425,
      "title": "题江心寺",
      "content": [
        "名与金山并，僧言景更幽。",
        "寺无双屿近，地占一江浮。",
        "曾是龙为宅，还疑蜃吐楼。",
        "他乡远归者，望此得停舟。"
      ],
      "author": {
        "id": 7098,
        "name": "翁卷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 80426,
      "title": "寿周少保",
      "content": [
        "袖中勋业拂云烟，笔底文章响涧泉。",
        "已是贵为天下宰，不妨长作地行仙。",
        "蚁浮玉斝秋初熟，鹊报银河月正圆。",
        "满饮寿觞今夜看，相星重入太微躔。"
      ],
      "author": {
        "id": 7098,
        "name": "翁卷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 80427,
      "title": "句  其一",
      "content": [
        "留客看花赋诗坐。"
      ],
      "author": {
        "id": 7098,
        "name": "翁卷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 80428,
      "title": "句  其二",
      "content": [
        "独自卷帘楼上望。"
      ],
      "author": {
        "id": 7098,
        "name": "翁卷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 80429,
      "title": "句  其三",
      "content": [
        "梅花处处妍。"
      ],
      "author": {
        "id": 7098,
        "name": "翁卷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 80430,
      "title": "句  其四",
      "content": [
        "官历春犹浅。"
      ],
      "author": {
        "id": 7098,
        "name": "翁卷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 80431,
      "title": "句  其五",
      "content": [
        "空把月中枝。"
      ],
      "author": {
        "id": 7098,
        "name": "翁卷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 80432,
      "title": "句  其六",
      "content": [
        "分石同僧坐，看松见鹤来。"
      ],
