{
  "data": [
    {
      "id": 280230,
      "title": "寄慈恩寺郁上人",
      "content": [
        "中秋期夕望，虚室省相容。",
        "北斗生清漏，南山出碧重。",
        "露寒鸠宿竹，鸿过月圆钟。",
        "此夜情应切，衡阳旧住峰。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280231,
      "title": "送饶州张使君",
      "content": [
        "终南云雨连城阙，去路西江白浪头。",
        "滁上郡斋离昨日，鄱阳农事劝今秋。",
        "道心生向前朝寺，文思来因静夜楼。",
        "借问泊帆干谒者，谁人曾听峡猨愁。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 280232,
      "title": "观冬设上东川杨尚书",
      "content": [
        "匏革奏冬非独乐，军城未晓启重门。",
        "何时却入三台贵，此日空知八座尊。",
        "罗绮舞中收雨点，貔貅阃外卷云根。",
        "逐迁属吏随宾列，拨櫂扁舟不忘恩。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 280233,
      "title": "巴兴作",
      "content": [
        "三年未省闻鸿呌，九月何曾见草枯。",
        "寒暑气均思白社，星辰位正忆皇都。",
        "苏卿持节终还汉，葛相行师自渡泸。",
        "乡味朔山林果别，北归期挂海帆孤。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 280234,
      "title": "早蝉",
      "content": [
        "早蝉孤抱芳槐叶，噪向残阳意度秋。",
        "也任一声催我老，堪听两耳畏吟休。",
        "得非下第无高韵，须是青山隐白头。",
        "若问此心嗟叹否，天人不可怨而尤。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 280235,
      "title": "投元郎中",
      "content": [
        "心在潇湘归未期，卷中多是得名诗。",
        "高台聊望清秋色，片水堪留白鹭鸶。",
        "省宿有时闻急雨，朝回尽日伴禅师。",
        "旧文去岁曾将献，蒙与人来说始知。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 280236,
      "title": "阮籍啸台",
      "content": [
        "如闻长啸春风里，荆棘丛边访旧踪。",
        "地接苏门山近远，荒台突兀抵高峰。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 280237,
      "title": "滕校书使院小池",
      "content": [
        "小池谁见凿时初，走水南来十里余。",
        "楼上日斜吹暮角，院中人出锁游鱼。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 280238,
      "title": "送陕府王建司马",
      "content": [
        "司马虽然听晓钟，尚犹高枕恣疎慵。",
        "请诗僧过三门水，卖药人归五老峰。",
        "移舫绿阴深处息，登楼凉夜此时逢。",
        "杜陵惆怅临相饯，未寝月前多屐踪。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 280239,
      "title": "上谷旅夜",
      "content": [
        "世难那堪恨旅游，龙钟更是对穷秋。",
        "故园千里数行泪，邻杵一声终夜愁。",
        "月到寒窗空皓皛，风翻落叶更飕飗。",
        "此心不向常人说，倚识平津万户侯。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 280240,
      "title": "寄无得头陀",
      "content": [
        "夏腊今应三十余，不离树下冢间居。",
        "貌堪良匠抽毫写，行称高僧续传书。",
        "落涧水声来远远，当空月色自如如。",
        "白衣只在青门里，心每相亲迹且疎。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 280241,
      "title": "崔卿池上双白鹭",
      "content": [
        "鹭雏相逐出深笼，顶各有丝茎数同。",
        "洒石多霜移足冷，隔城远树挂巢空。",
        "其如尽在滩声外，何似双飞浦色中。",
        "见此池潭卿自凿，清泠太液底潜通。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 280242,
      "title": "送胡道士",
      "content": [
        "短褐身披满渍苔，灵溪深处观门开。",
        "却从城里移琴去，许到山中寄药来。",
        "临水古坛秋醮罢，宿杉幽鸟夜飞回。",
        "丹梯愿逐真人上，日夕归心白发催。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 280243,
      "title": "寄韩潮州愈",
      "content": [
        "此心曾与木兰舟，直到天南潮水头。",
        "隔岭篇章来华岳，出关书信过泷流。",
        "峰悬驿路残云断，海浸城根老树秋。",
        "一夕瘴烟风卷尽，月明初上浪西楼。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 280244,
      "title": "詶张籍王建",
      "content": [
        "疎林荒宅古坡前，久住还因太守怜。",
        "渐老更思深处隐，多闲数得上方眠。",
        "鼠抛贫屋收田日，鴈度寒江拟雪天。",
        "身是龙钟应是分，水曹芸阁枉来篇。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 280245,
      "title": "逢博陵故人彭兵曹",
      "content": [
        "曲阳分散会京华，见说三年住海涯。",
        "别后解餐蓬蔂子，向前未识牡丹花。",
        "偶逢日者教求禄，终傍泉声拟置家。",
        "蹋雪携琴相就宿，夜深开户斗牛斜。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 280246,
      "title": "赠牛山人",
      "content": [
        "二十年中饵茯苓，致书半是老君经。",
        "东都旧住商人宅，南国新修道士亭。",
        "凿石养蜂休买蜜，坐山秤药不争星。",
        "古来隐者多能卜，欲就先生问丙丁。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 280247,
      "title": "送于中丞使回纥册立",
      "content": [
        "君立天骄发使车，册文字字著金书。",
        "渐通青冢乡山尽，欲达皇情译语初。",
        "调角寒城边色动，下霜秋碛鴈行疎。",
        "旌旗来往几多日，应向途中见岁除。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 280248,
      "title": "送刘侍御重使江西",
      "content": [
        "时当苦热远行人，石壁飞泉溅马身。",
        "又到钟陵知务大，还浮湓浦属秋新。",
        "早程猨呌云深极，宿馆禽惊叶动频。",
        "前者已闻廉使荐，兼言有画静边尘。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 280249,
      "title": "赠圆上人",
      "content": [
        "诵经千纸得为僧，麈尾持行不拂蝇。",
        "古塔月高闻呪水，新坛日午见烧灯。",
        "一双童子浇红药，百八真珠贯彩绳。",
        "且说近来心里事，仇雠相对似亲朋。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 280250,
      "title": "处州李使君改任遂州因寄赠",
      "content": [
        "庭树几株阴入户，主人何在客闻蝉。",
        "钥开原上高楼锁，瓶汲池东古井泉。",
        "趂静野禽曾后到，休吟邻叟始安眠。",
        "仙都山水谁能忆，西去风涛书满船。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 280251,
      "title": "酬慈恩寺文郁上人",
      "content": [
        "袈裟影入禁池清，犹忆乡山近赤城。",
        "篱落罅间寒蟹过，莓苔石上晚蛩行。",
        "期登野阁闲应甚，阻宿山房疾未平。",
        "闻说又寻南岳去，无端诗思忽然生。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 280252,
      "title": "访鉴玄师姪",
      "content": [
        "维摩青石讲初休，缘访亲宗到普州。",
        "我有军持凭弟子，岳阳溪里汲寒流。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 280253,
      "title": "夜坐",
      "content": [
        "蟋蟀渐多秋不浅，蟾蜍已没夜应深。",
        "三更两鬓几枝雪，一念双峰四祖心。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 280254,
      "title": "送别",
      "content": [
        "门外便伸千里别，无车不得到河梁。",
        "高楼直上百余尺，今日为君南望长。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 280255,
      "title": "闻蝉感怀",
      "content": [
        "新蝉忽发最高枝，不觉立听无限时。",
        "正遇友人来告别，一心分作两般悲。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 280256,
      "title": "夏夜上谷宿开元寺",
      "content": [
        "诗成一夜月中题，便卧松风到曙鸡。",
        "带月时闻山鸟语，郡城知近武陵溪。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 280257,
      "title": "送于总持归京",
      "content": [
        "出家初隷何方寺，上国西明御水东。",
        "却见旧房堦下树，别来二十一春风。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 280258,
      "title": "崔卿池上鹤",
      "content": [
        "月中时呌叶纷纷，不异洞庭霜夜闻。",
        "翎羽如今从放长，犹能飞起向孤云。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 280259,
      "title": "登田中丞高亭",
      "content": [
        "高亭林表迥嵯峨，独坐秋宵不寝多。",
        "玉兔玉人歌里出，白云难似莫相和。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 280260,
      "title": "友人婚杨氏催妆",
      "content": [
        "不知今夕是何夕，催促阳台近镜台。",
        "谁道芙蓉水中种，青铜镜里一枝开。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 280261,
      "title": "酬朱侍御望月见寄",
      "content": [
        "他寝此时吾不寝，近秋三五日逢晴。",
        "相思唯有霜台月，望尽孤光见却生。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 280262,
      "title": "题韦云叟草堂",
      "content": [
        "新起此堂开北窗，当窗山隔一重江。",
        "白茅草苫重重密，爱此秋天夜雨淙。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 280263,
      "title": "和韩吏部泛南溪",
      "content": [
        "溪里晚从池岸出，石泉秋急夜深闻。",
        "木兰船共山人上，月映渡头零落云。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 280264,
      "title": "方镜",
      "content": [
        "背如刀截机头锦，面似升量涧底泉。",
        "铜雀台南秋日后，照来照去已三年。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 280265,
      "title": "詶姚合",
      "content": [
        "黍穗豆苗侵古道，晴原午后早秋时。",
        "故人相忆僧来说，杨柳无风蝉满枝。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 280266,
      "title": "送灵应上人",
      "content": [
        "遍参尊宿游方久，名岳奇峰问此公。",
        "五月半间看瀑布，青城山里白云中。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 280267,
      "title": "赠丘先生",
      "content": [
        "常言吃药全胜饭，华岳松边采茯神。",
        "不遣髭须一茎白，拟为白日上升人。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 280268,
      "title": "渡桑干",
      "content": [
        "客舍幷州已十霜，归心日夜忆咸阳。",
        "无端更渡桑干水，却望幷州是故乡。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 280269,
      "title": "夜期啸客吕逸人不至",
      "content": [
        "逸人期宿石床中，遣我开扉对晚空。",
        "不知何处啸秋月，闲著松门一夜风。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 280270,
      "title": "夜集乌行中所居",
      "content": [
        "环炉促席复持杯，松院双扉向月开。",
        "座上同声半先达，名山独入此心来。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 280271,
      "title": "赠梁浦秀才斑竹拄杖",
      "content": [
        "拣得林中最细枝，结根石上长身迟。",
        "莫嫌滴沥红斑少，恰似湘妃泪尽时。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 280272,
      "title": "寻石瓮寺上方",
      "content": [
        "野寺入时春雪后，崎岖得到此房前。",
        "老僧不出迎朝客，已住上方三十年。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 280273,
      "title": "早秋寄题天竺灵隐寺",
      "content": [
        "峰前峰后寺新秋，绝顶高窗见沃洲。",
        "人在定中闻蟋蟀，鹤从栖处挂猕猴。",
        "山钟夜渡空江水，汀月寒生古石楼。",
        "心忆悬帆身未遂，谢公此地昔年游。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 280274,
      "title": "黎阳寄姚合",
      "content": [
        "魏都城里曾游熟，才子斋中止泊多。",
        "去日绿杨垂紫陌，归时白草夹黄河。",
        "新诗不觉千回咏，古镜曾经几度磨。",
        "惆怅心思滑台北，满杯浓酒与愁和。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 280275,
      "title": "送崔约秀才",
      "content": [
        "归宁髣髴三千里，月向船窗见几宵。",
        "野鼠独偷高树果，前山渐见短禾苗。",
        "更深栅锁淮波疾，苇动风生雨气遥。",
        "重入石头城下寺，南朝杉老未干燋。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 280276,
      "title": "咏怀",
      "content": [
        "纵把书看未省勤，一生生计秖长贫。",
        "可能在世无成事，不觉离家作老人。",
        "中岳深林秋独往，南原多草夜无邻。",
        "经年抱疾谁来问，野鸟相过啄木频。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 280277,
      "title": "夏日寄高洗马",
      "content": [
        "三十年来长在客，两三行泪忽然垂。",
        "白衣苍鬓经过嬾，赤日朱门偃息迟。",
        "花发应耽新熟酒，草颠还写早朝诗。",
        "不缘马死西州去，画角堪听是晓吹。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 280278,
      "title": "送周判官元范赴越",
      "content": [
        "原下相逢便别离，蝉鸣关路使回时。",
        "过淮渐有悬帆兴，到越应将坠叶期。",
        "城上秋山生菊早，驿西寒渡落潮迟。",
        "已曾几遍随旌斾，去谒荒郊大禹祠。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 280279,
      "title": "送罗少府归牛渚",
      "content": [
        "作尉长安始三日，忽思牛渚梦天台。",
        "楚山远色独归去，灞水空流相送回。",
        "霜覆鹤身松子落，月分萤影石房开。",
        "白云多处应频到，寒涧泠泠漱古苔。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 280280,
      "title": "题童真上人",
      "content": [
        "江上修持积岁年，滩声未拟住潺湲。",
        "誓从五十身披衲，便向三千界坐禅。",
        "月峡青城那有滞，天台庐岳岂无缘。",
        "昨宵忽梦游沧海，万里波涛在目前。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 280281,
      "title": "赠温观主",
      "content": [
        "一别罗浮竟未还，观深廊古院多关。",
        "君来几日行虚洞，仙去空坛在远山。",
        "胎息存思当黑处，井华悬绠取朝间。",
        "弊庐道室虽邻近，自乐冬阳炙背闲。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 280282,
      "title": "贺庞少尹除太常少卿",
      "content": [
        "太白山前终日见，十旬假满拟秋寻。",
        "中峰绝顶非无路，北阙除书阻入林。",
        "朝谒此时闲野屐，宿斋何处止鸣砧？",
        "省中石镫陪随步，唯赏烟霞不厌深。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 280283,
      "title": "上邠宁邢司徒",
      "content": [
        "箭头破帖浑无敌，杖底敲毬远有声。",
        "马走千蹄朝万乘，地分三郡拥双旌。",
        "春风欲尽山花发，晓角初吹客梦惊。",
        "不是邢公来镇此，长安西北未能行。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 280284,
      "title": "欲游嵩岳留别李少尹益",
      "content": [
        "孤策迟回洛水湄，孤禽嘹唳幸人知。",
        "嵩岳望中常待我，河梁欲上未题诗。",
        "新秋爱月愁多雨，古观逢仙看尽棋。",
        "微眇此来将敢问，凤凰何日定归池。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 280285,
      "title": "病鹘吟",
      "content": [
        "俊鸟还投高处栖，腾身戛戛下云梯。",
        "有时透雾凌空去，无事随风入草迷。",
        "迅疾月边捎玉兔，迟回日里拂金鸡。",
        "不缘毛羽遭零落，焉肯雄心向尔低。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 280286,
      "title": "赠僧",
      "content": [
        "从来多是游山水，省泊禅舟月下涛。",
        "初过石桥年尚少，久辞天柱腊应高。",
        "青松带雪悬铜锡，白发如霜落铁刀。",
        "常恐画工援笔写，身长七尺有眉毫。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 280287,
      "title": "赠翰林",
      "content": [
        "清重无过知内制，从前礼绝外庭人。",
        "看花在处多随驾，召宴无时不及身。",
        "马自赐来骑觉稳，诗缘见彻语长新。",
        "应怜独向名场苦，曾十余年浪过春。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 280288,
      "title": "颂德上贾常侍",
      "content": [
        "边臣说使朝天子，发语轰然激夏雷。",
        "高节羽书期独传，分符绛郡滞长材。",
        "啁啾鸟恐鹰鹯起，流散人归父母来。",
        "自顾此身无所立，恭谈祖德朵颐开。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 280289,
      "title": "田将军书院",
      "content": [
        "满庭花木半新栽，石自平湖远岸来。",
        "笋迸邻家还长竹，地经山雨几层苔。",
        "井当深夜泉微上，阁入高秋户尽开。",
        "行背曲江谁到此，琴书锁著未朝回。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 280290,
      "title": "投庞少尹",
      "content": [
        "闭户息机搔白首，中庭一树有清阴。",
        "年年不改风尘趣，日日转多泉石心。",
        "病起望山台上立，觉来听雨烛前吟。",
        "庞公相识元和岁，眷分依依直至今。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 280291,
      "title": "夏夜登南楼",
      "content": [
        "水岸寒楼带月跻，夏林初见岳阳溪。",
        "一㸃新萤报秋信，不知何处是菩提。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 280292,
      "title": "题青龙寺",
      "content": [
        "碣石山人一轴诗，终南山北数人知。",
        "拟看青龙寺里月，待无一点夜云时。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 280293,
      "title": "赠李文通",
      "content": [
        "营当万胜冈头下，誓立千年不朽功。",
        "天子手擎新钺斧，谏官请赠李文通。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 280294,
      "title": "题虢州三堂赠吴郎中",
      "content": [
        "无穷草树昔谁栽，新起临湖白石台。",
        "半岸泥沙孤鹤立，三堂风雨四门开。",
        "荷翻团露惊秋近，柳转斜阳过水来。",
        "昨夜北楼堪朗咏，虢城初锁月裴回。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 280295,
      "title": "送僧",
      "content": [
        "池上时时松雪落，焚香烟起见孤灯。",
        "静夜忆谁来对坐，曲江南岸寺中僧。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 280296,
      "title": "三月晦日赠刘评事",
      "content": [
        "三月正当三十日，风光别我苦吟身。",
        "共君今夜不须睡，未到晓钟犹是春。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 280297,
      "title": "送张道者",
      "content": [
        "新岁抱琴何处去，洛阳三十六峰西。",
        "生来未识山人面，不得一听乌夜啼。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 280298,
      "title": "题鱼尊师院",
      "content": [
        "老子堂前花万树，先生曾见几回春。",
        "夜煎白石平明吃，不拟教人哭此身。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 280299,
      "title": "宿村家亭子",
      "content": [
        "床头枕是溪中石，井底泉通竹下池。",
        "宿客未眠过夜半，独闻山雨到来时。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 280300,
      "title": "送称上人",
      "content": [
        "归蜀拟从巫峡过，何时得入旧房禅。",
        "寺中来后谁身化，起塔栽松向野田。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 280301,
      "title": "杨秘书新居",
      "content": [
        "城角新居邻静寺，时从新阁上经楼。",
        "南山泉入宫中去，先向诗人门外流。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 280302,
      "title": "听乐山人弹易水",
      "content": [
        "朱丝弦底燕泉急，燕将云孙白日弹。",
        "嬴氏归山陵已掘，声声犹带发冲冠。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 280303,
      "title": "经苏秦墓",
      "content": [
        "沙埋古篆折碑文，六国兴亡事系君。",
        "今日凄凉无处说，乱山秋尽有寒云。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 280304,
      "title": "题戴胜",
      "content": [
        "星点花冠道士衣，紫阳宫女化身飞。",
        "能传上界春消息，若到蓬山莫放归。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 280305,
      "title": "题隐者居",
      "content": [
        "虽有柴门常不关，片云孤木伴身闲。",
        "犹嫌住久人知处，见拟移家更上山。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 280306,
      "title": "哭孟东野",
      "content": [
        "兰无香气鹤无声，哭尽秋天月不明。",
        "自从东野先生死，侧近云山得散行。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 280307,
      "title": "过京索先生坟",
      "content": [
        "京索先生三尺坟，秋风漠漠吐寒云。",
        "从来有恨君多哭，今日何人更哭君。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 280308,
      "title": "客思",
      "content": [
        "促织声尖尖似针，更深刺著旅人心。",
        "独言独语月明里，惊觉眠童与宿禽。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 280309,
      "title": "盐池院观鹿",
      "content": [
        "条峰五老势相连，此鹿来从若个边。",
        "别有野麋人不见，一生长饮白云泉。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 280310,
      "title": "黄鹄下太液池",
      "content": [
        "高飞空外鹄，下向禁中池。",
        "岸印行踪浅，波摇立影危。",
        "来从千里岛，舞拂万年枝。",
        "踉跄孤风起，裴回水沫移。",
        "幽音清露滴，野性白云随。",
        "太液无弹射，灵禽翅不垂。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 280311,
      "title": "代旧将",
      "content": [
        "旧事说如梦，谁当信老夫。",
        "战场几处在，部曲一人无。",
        "落日收病马，晴天晒阵图。",
        "犹希圣朝用，自镊白髭须。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280312,
      "title": "老将",
      "content": [
        "胆壮乱须白，金疮蠹百骸。",
        "旌旗犹入梦，歌舞不开怀。",
        "燕雀来鹰架，尘埃满箭靫。",
        "自夸勋业重，开府是官阶。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280313,
      "title": "春行",
      "content": [
        "去去行人远，尘随马不穷。",
        "旅情斜日后，春色早烟中。",
        "流水穿空馆，闲花发故宫。",
        "旧乡千里思，池上绿杨风。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280314,
      "title": "题郑常侍厅前竹",
      "content": [
        "绿竹临诗酒，婵娟思不穷。",
        "乱枝低积雪，繁叶亚寒风。",
        "萧飒疑泉过，萦回有迳通。",
        "侵庭根出土，隔壁笋成丛。",
        "疎影纱窗外，清音宝瑟中。",
        "卷帘终日看，欹枕几秋同。",
        "万顷歌王子，千竿伴阮公。",
        "露光怜片片，雨润爱蒙蒙。",
        "嶰谷蛮湖北，湘川灀水东。",
        "何如轩槛侧，苍翠褭长空。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 280315,
      "title": "早行",
      "content": [
        "早起赴前程，邻鸡尚未鸣。",
        "主人灯下别，羸马暗中行。",
        "蹋石新霜滑，穿林宿鸟惊。",
        "远山钟动后，曙色渐分明。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280316,
      "title": "送人南归",
      "content": [
        "分手向天涯，迢迢泛海波。",
        "虽然南地远，见说北人多。",
        "山暖花常发，秋深鴈不过。",
        "炎方饶胜事，此去莫蹉跎。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280317,
      "title": "送人南游",
      "content": [
        "此别天涯远，孤舟泛海中。",
        "夜行常认火，帆去每因风。",
        "蛮国人多富，炎方语不同。",
        "鴈飞难度岭，书信若为通。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280318,
      "title": "送道者",
      "content": [
        "独向山中见，今朝又别离。",
        "一心无挂住，万里独何之。",
        "到处绝烟火，逢人话古时。",
        "此行无弟子，白犬自相随。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280319,
      "title": "风蝉",
      "content": [
        "风蝉旦夕鸣，伴叶送新声。",
        "故里客归尽，水边身独行。",
        "噪轩高树合，惊枕暮山横。",
        "听处无人见，尘埃满甑生。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280320,
      "title": "清明日园林寄友人",
      "content": [
        "今日清明节，园林胜事偏。",
        "晴风吹柳絮，新火起厨烟。",
        "杜草开三迳，文章忆二贤。",
        "几时能命驾，对酒落花前。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280321,
      "title": "上杜驸马",
      "content": [
        "玉山突兀压乾坤，出得朱门入戟门。",
        "妻是九重天子女，身为一品令公孙。",
        "鸳鸯殿里参皇后，龙凤堂前贺至尊。",
        "今日澧阳非久驻，伫为霖雨拜新恩。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 280322,
      "title": "莲峰歌",
      "content": [
        "锦砾潺湲玉溪水，晓来微雨藤花紫。",
        "冉冉山鸡红尾长，一声樵斧惊飞起。",
        "松刺梳空石差齿，烟香风软人参蕊。",
        "阳崖一梦伴云根，仙菌灵芝梦魂里。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 280323,
      "title": "壮士吟",
      "content": [
        "壮士不曾悲，悲即无回期。",
        "如何易水上，未歌先泪垂。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 280324,
      "title": "题兴化园亭",
      "content": [
        "破却千家作一池，不栽桃李种蔷薇。",
        "蔷薇花落秋风起，荆棘满庭君始知。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 280325,
      "title": "竹",
      "content": [
        "篱外清阴接药栏，晓风交戛碧琅玕。",
        "子猷没后知音少，粉节霜筠漫岁寒。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 280326,
      "title": "李斯井",
      "content": [
        "井存上蔡南门外，置此井时来相秦。",
        "断绠数寻垂古甃，取将寒水是何人。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 280327,
      "title": "题诗后",
      "content": [
        "二句三年得，一吟双泪流。",
        "知音如不赏，归卧故山秋。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 280328,
      "title": "送友人之南陵",
      "content": [
        "莫叹徒劳向宦途，不群气岸有谁如。",
        "南陵暂掌仇香印，北阙终行贾谊书。",
        "好趂江山寻胜境，莫辞韦杜别幽居。",
        "少年跃马同心使，免得诗中道跨驴。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 280329,
      "title": "寻人不遇",
      "content": [
        "闻说到扬州，吹箫有旧游。",
        "人来多不见，莫是上迷楼。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    }
  ],
