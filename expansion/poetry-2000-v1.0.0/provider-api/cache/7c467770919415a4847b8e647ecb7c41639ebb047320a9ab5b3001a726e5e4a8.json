{
  "data": [
    {
      "id": 206605,
      "title": "刘邦直送早梅水仙花四首  其四",
      "content": [
        "钱塘昔闻水仙庙，荆州今见水仙花。",
        "暗香静色撩诗句，宜在林逋处士家。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206606,
      "title": "谢檀敦信送柑子",
      "content": [
        "色深林表风霜下，香著尊前指爪间。",
        "书后合题三百颗，频随驿使未应悭。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206607,
      "title": "赠李辅圣",
      "content": [
        "交盖相逢水急流，八年今复会荆州。",
        "已回青眼追鸿翼，肯使黄尘没马头。",
        "旧管新收几妆镜，流行坎止一虚舟。",
        "相看绝叹女博士，笔研管弦成古丘。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 206608,
      "title": "和高仲本喜相见",
      "content": [
        "雨昏南浦曾相对，雪满荆州喜再逢。",
        "有子才如不羁马，知君心是后凋松。",
        "闲寻书册应多味，老傍人门似更慵。",
        "何日晴轩观笔砚，一樽相属要从容。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 206609,
      "title": "戏咏煖足瓶二首  其一",
      "content": [
        "小姬煖足卧，或能起心兵。",
        "千金买脚婆，夜夜睡天明。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 206610,
      "title": "戏咏煖足瓶二首  其二",
      "content": [
        "脚婆原不食，缠裹一衲足。",
        "天明更倾泻，颒面有余燠。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 206611,
      "title": "戏呈闻善二兄",
      "content": [
        "匏悬篱落鸦窥井，草上阶除雪衮风。",
        "想得尊前欹醉帽，浑家儿女笑山公。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206612,
      "title": "次韵闻善",
      "content": [
        "扶醉三竿日，题诗一研埃。",
        "张罗门带雪，投辖井生苔。",
        "待得成丘陇，谁能把酒杯。",
        "常应黄菊畔，怅望白衣来。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 206613,
      "title": "谢答闻善二兄九绝句  其一",
      "content": [
        "身入醉乡无畔岸，心与欢伯为友朋。",
        "更阑骂坐客星散，午过未苏发鬅鬙。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206614,
      "title": "谢答闻善二兄九绝句  其二",
      "content": [
        "未尝顷刻可去酒，无有一日不吟诗。",
        "诗狂克念作酒圣，意态忽如少年时。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206615,
      "title": "谢答闻善二兄九绝句  其三",
      "content": [
        "群猪过饮尚可醉，疥手轑瓮庸何伤。",
        "柳家兄弟太迫窄，狂药不容人发狂。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206616,
      "title": "谢答闻善二兄九绝句  其四",
      "content": [
        "莫作叫号惊四邻，瓮中有地可藏真。",
        "渊明醉握远公手，大笑绝倒人不嗔。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206617,
      "title": "谢答闻善二兄九绝句  其五",
      "content": [
        "阮籍醉睡不论昏，刘伶鸡肋避尊拳。",
        "至今凛凛有生气，饮酒真成不愧天。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206618,
      "title": "谢答闻善二兄九绝句  其六",
      "content": [
        "公择醉面桃花红，人百忤之无愠容。",
        "莘老夜阑倾数斗，焚香默坐日生东。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206619,
      "title": "谢答闻善二兄九绝句  其七",
      "content": [
        "椎床破面枨触人，作无义语怒四邻。",
        "尊中欢伯笑尔辈，我本和气如三春。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206620,
      "title": "谢答闻善二兄九绝句  其八",
      "content": [
        "陶令舍中有名酒，无日不为父老倾。",
        "四座欢欣观酒德，一灯明暗又诗成。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206621,
      "title": "谢答闻善二兄九绝句  其九",
      "content": [
        "阮籍刘伶智如海，人间有道作糟丘。",
        "酒中无诤真三昧，便觉嵇康输一筹。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206622,
      "title": "戏呈闻善",
      "content": [
        "堆豗病鹤怯鸡群，见酒特地生精神。",
        "坐中索起时被肘，亦任旁人嫌我真。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206623,
      "title": "题子瞻画竹石",
      "content": [
        "风枝雨叶瘠土竹，龙蹲虎踞苍藓石。",
        "东坡老人翰林公，醉时吐出胸中墨。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206624,
      "title": "戏赠米元章二首  其一",
      "content": [
        "万里风帆水著天，麝煤鼠尾过年年。",
        "沧江静夜虹贯月，定是米家书画船。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206625,
      "title": "戏赠米元章二首  其二",
      "content": [
        "我有玄晖古印章，印刓不忍与诸郎。",
        "虎儿笔力能扛鼎，教字玄晖继阿章。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206626,
      "title": "次韵高子勉十首  其一",
      "content": [
        "雪尽虚簷滴，春从细草回。",
        "德人泉下梦，俗物眼中埃。",
        "久立我有待，长吟君不来。",
        "重玄锁关籥，要待玉匙开。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 206627,
      "title": "次韵高子勉十首  其二",
      "content": [
        "扫雪我三日，御风君过旬。",
        "言诗今有数，下笔不无神。",
        "行布佺期近，飞扬子建亲。",
        "可怜金石友，去不待斯人。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 206628,
      "title": "次韵高子勉十首  其三",
      "content": [
        "岘南羁旅井，灞上猎归亭。",
        "日绕分鱼市，风回落雁汀。",
        "笔由诗客把，笛为故人听。",
        "但恐苏耽鹤，归时或姓丁。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 206629,
      "title": "次韵高子勉十首  其四",
      "content": [
        "君不居郎省，还应上谏坡。",
        "才高殊未识，岁晚喜无它。",
        "枥马羸难出，邻鸡冻不歌。",
        "寒炉余几火，灰里拨阴何。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 206630,
      "title": "次韵高子勉十首  其五",
      "content": [
        "荆渚楼中赋，南阳垅底吟。",
        "谁言小隠处，频屈故人临。",
        "经笥难窥底，词源幸汲深。",
        "思君眠竹屋，雪月冰寒衾。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 206631,
      "title": "次韵高子勉十首  其六",
      "content": [
        "惊人得佳句，或以傲王公。",
        "处世要清节，滑稽安足雄。",
        "深沈似康乐，简远到安丰。",
        "一点无俗气，相期林下同。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 206632,
      "title": "次韵高子勉十首  其七",
      "content": [
        "志士难推毂，将如高子何。",
        "心期诚不浅，余论或相多。",
        "欲向沧洲去，还能小艇么。",
        "鸬鹚西照处，相并晒渔蓑。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 206633,
      "title": "次韵高子勉十首  其八",
      "content": [
        "凿开混沌窍，窥见伏羲心。",
        "有物先天地，含生尽陆沈。",
        "伐山成大厦，鼓橐铸祥金。",
        "三尺无弦木，期君发至音。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 206634,
      "title": "次韵高子勉十首  其九",
      "content": [
        "少年基一篑，长岁足三余。",
        "忽作飞黄去，顿超同队鱼。",
        "尊前八采句，窗下十年书。",
        "定作牛腰束，传抄听小胥。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 206635,
      "title": "次韵高子勉十首  其一○",
      "content": [
        "沙上步微暖，思君剩欲招。",
        "蒌蒿穿雪动，杨柳索春饶。",
        "枉驾时逢出，新诗若见撩。",
        "樽前远湖树，来饮莫辞遥。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 206636,
      "title": "赠高子勉四首  其一",
      "content": [
        "文章瑞世惊人，学行刳心润身。",
        "沅江求九肋鼈，荆州见一角麟。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206637,
      "title": "赠高子勉四首  其二",
      "content": [
        "张侯海内长句，晁子庙中雅歌。",
        "高郎少加笔力，我知三杰同科。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206638,
      "title": "赠高子勉四首  其三",
      "content": [
        "妙在和光同尘，事须钩深入神。",
        "听他下虎口著，我不为牛后人。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206639,
      "title": "赠高子勉四首  其四",
      "content": [
        "拾遗句中有眼，彭泽意在无弦。",
        "顾我今六十老，付公以二百年。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206640,
      "title": "再用前韵赠子勉四首  其一",
      "content": [
        "胸中有度择人，事上无心活身。",
        "只么情亲鱼鸟，傥然图画麒麟。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206641,
      "title": "再用前韵赠子勉四首  其二",
      "content": [
        "行要争光日月，诗须皆可弦歌。",
        "著鞭莫落人后，百年风转蓬科。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206642,
      "title": "再用前韵赠子勉四首  其三",
      "content": [
        "句法俊逸清新，词源广大精神。",
        "建安才六七子，开元数两三人。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206643,
      "title": "再用前韵赠子勉四首  其四",
      "content": [
        "醉乡闲处日月，鸟语花中管弦。",
        "有兴勤来把酒，与君端欲忘年。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206644,
      "title": "荆南签判向和卿用予六言见惠次韵奉酬四首  其一",
      "content": [
        "仕宦初不因人，富贵方来逼身。",
        "要是出群拔萃，乃成威凤祥麟。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206645,
      "title": "荆南签判向和卿用予六言见惠次韵奉酬四首  其二",
      "content": [
        "向侯赋我菁莪，何敢当不类歌。",
        "顾我乃山林士，看君取将相科。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206646,
      "title": "荆南签判向和卿用予六言见惠次韵奉酬四首  其三",
      "content": [
        "覆却万方无准，安排一字有神。",
        "更能识诗家病，方是我眼中人。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206647,
      "title": "荆南签判向和卿用予六言见惠次韵奉酬四首  其四",
      "content": [
        "觅句真成小技，知音定须绝弦。",
        "景公有马千驷，伯夷垂名万年。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206648,
      "title": "蚁蝶图",
      "content": [
        "胡蝶双飞得意，偶然毕命网罗。",
        "群蚁争收坠翼，策勋归去南柯。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206649,
      "title": "谢胡藏之送栗鼠尾画维摩二首  其一",
      "content": [
        "貂尾珍材可笔，虎头墨妙疑神。",
        "颇知君尘外物，真是我眼中人。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206650,
      "title": "谢胡藏之送栗鼠尾画维摩二首  其二",
      "content": [
        "丹青貌金粟影，毛物宜管城公。",
        "只今为君落笔，他日听我谈空。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206651,
      "title": "次韵向和卿行松滋县与邹天锡夜语南极亭二首  其一",
      "content": [
        "雪泥滑滑到山郭，提壶劝沽亦不恶。",
        "林中解道不如归，家人应念思归乐。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206652,
      "title": "次韵向和卿行松滋县与邹天锡夜语南极亭二首  其二",
      "content": [
        "冲风冲雨走七县，唯有白鸥盟未寒。",
        "坐中更得江南客，开尽南窗借月看。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206653,
      "title": "戏答荆州王充道烹茶四首  其一",
      "content": [
        "三径虽锄客自稀，醉乡安稳更何之。",
        "老翁更把春风椀，灵府清寒要作诗。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206654,
      "title": "戏答荆州王充道烹茶四首  其二",
      "content": [
        "茗椀难加酒椀醇，暂时扶起藉糟人。",
        "何须忍垢不濯足，苦学梁州阴子春。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206655,
      "title": "戏答荆州王充道烹茶四首  其三",
      "content": [
        "香从灵坚垄上发，味自白石源中生。",
        "为公唤觉荆州梦，可待南柯一梦成。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206656,
      "title": "戏答荆州王充道烹茶四首  其四",
      "content": [
        "龙焙东风鱼眼汤，个中即是白云乡。",
        "更煎双井苍鹰爪，始耐落花春日长。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206657,
      "title": "雨中登岳阳楼望君山二首  其一",
      "content": [
        "投荒万死鬓毛斑，生出瞿塘滟滪关。",
        "未到江南先一笑，岳阳楼上对君山。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206658,
      "title": "雨中登岳阳楼望君山二首  其二",
      "content": [
        "满川风雨独凭栏，绾结湘娥十二鬟。",
        "可惜不当湖水面，银山堆里看青山。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206659,
      "title": "自巴陵略平江临湘入通城无日不雨至黄龙奉谒清禅师继而晚晴邂逅禅客戴道纯款语作长句呈道纯",
      "content": [
        "山行十日雨霑衣，幕阜峰前对落晖。",
        "野水自添田水满，晴鸠却唤雨鸠归。",
        "灵源大士人天眼，双塔老师诸佛机。",
        "白发苍颜重到此，问君还是昔人非。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 206660,
      "title": "题徐氏书院",
      "content": [
        "学书但学溪老鹅，读书可观樵父歌。",
        "紫髯将军不复见，空余岩桂绿婆娑。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206661,
      "title": "赠石敏若",
      "content": [
        "才似谪仙惟欠酒，情如宋玉更逢秋。",
        "相看领会一谈胜，注目长江天际流。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206662,
      "title": "题胡逸老致虚庵",
      "content": [
        "藏书万卷可教子，遗金满籯常作灾。",
        "能与贫人共年谷，必有明月生蚌胎。",
        "山随宴坐图画出，水作夜窗风雨来。",
        "观水观山皆得妙，更将何物污灵台。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 206663,
      "title": "题莲华寺",
      "content": [
        "狂卒猝起金坑西，胁从数百马百蹄。",
        "所过州县不敢谁，肩舆掳载三十妻。",
        "伍生有胆无智略，谓河可冯虎可搏。",
        "身膏白刃浮屠前，此乡父老至今怜。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 206664,
      "title": "冲雨向万载道中得逍遥观托宿遂戏题",
      "content": [
        "逍遥近道边，憩息慰惫懑。",
        "晴晖时晦明，谑语谐谠论。",
        "草莱荒蒙茏，室屋壅尘坌。",
        "仆僮偪侧泌，泾渭清浊混。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 206665,
      "title": "题竹尊者轩",
      "content": [
        "平生脊骨硬如铁，听风听雨随宜说。",
        "百尺竿头放步行，更向脚跟参一节。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206666,
      "title": "送密老住五峰",
      "content": [
        "我穿高安过萍乡，七十二渡遶羊肠。",
        "水边林下逢衲子，南北东西古道场。",
        "五峰秀出云雨上，中有宝坊如侧掌。",
        "去与青山作主人，不负法昌老禅将。",
        "栽松种竹是家风，莫嫌斗绝无来往。",
        "但得螺蛳吞大象，从来美酒无深巷。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206667,
      "title": "新喻道中寄元明用觞字韵",
      "content": [
        "中年畏病不举酒，孤负东来数百觞。",
        "唤客煎茶山店远，看人秧稻午风凉。",
        "但知家里俱无恙，不用书来细作行。",
        "一百八盘携手上，至今犹梦遶羊肠。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 206668,
      "title": "拜刘凝之画像",
      "content": [
        "弃官清颍尾，买田落星湾。",
        "身在菰蒲中，名满天地间。",
        "谁能四十年，保此清静退。",
        "往来涧谷中，神光射牛背。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 206669,
      "title": "追和东坡壶中九华",
      "content": [
        "有人夜半持山去，顿觉浮岚暖翠空。",
        "试问安排华屋处，何如零落乱云中。",
        "能回赵璧人安在，已入南柯梦不通。",
        "頼有霜钟难席卷，袖椎来听响玲珑。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 206670,
      "title": "罢姑熟寄元明用觞字韵",
      "content": [
        "追随富贵劳牵尾，准拟田园略滥觞。",
        "本与江鸥成保社，聊随海燕度炎凉。",
        "未栽姑熟桃李径，却入江西鸿雁行。",
        "别后常同千里月，书来莫寄九回肠。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 206671,
      "title": "次苏子瞻和李太白浔阳紫极宫感秋诗韵追怀太白子瞻",
      "content": [
        "不见两谪仙，长怀倚修竹。",
        "行遶紫极宫，明珠得盈掬。",
        "平生人欲杀，耿介受命独。",
        "往者如可作，抱被求同宿。",
        "砥柱阅颓波，不疑更何卜。",
        "但观草木秋，叶落根自复。",
        "我病二十年，大斗久不覆。",
        "因之酌苏李，蟹肥社醅熟。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206672,
      "title": "琼芝轩",
      "content": [
        "卓僊在时养琼芝，深根固蒂活人命。",
        "憧憧来问此何草，但告渠是唐婆镜。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206673,
      "title": "龟壳轩",
      "content": [
        "紫极宫中三百楹，道人独藏一神屋。",
        "开轩纳息星月明，时有白云来伴宿。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206674,
      "title": "秋声轩",
      "content": [
        "谁居空闲扇橐籥，情与无情并时作。",
        "是声皆自根极来，更莫辛勤问南郭。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206675,
      "title": "戏效禅月作远公咏",
      "content": [
        "邀陶渊明把酒椀，过陆修静送虎溪。",
        "胸次九流清似镜，人间万事醉如泥。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206676,
      "title": "跋子瞻和陶诗",
      "content": [
        "子瞻谪岭南，时宰欲杀之。",
        "饱吃惠州饭，细和渊明诗。",
        "彭泽千载人，东坡百世士。",
        "出处虽不同，风味乃相似。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 206677,
      "title": "题李亮功戴嵩牛图",
      "content": [
        "韩生画肥马，立仗有辉光。",
        "戴老作瘦牛，平生千顷荒。",
        "觳觫告主人，实已尽筋力。",
        "乞我一牧童，林间听横笛。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 206678,
      "title": "追和东坡题李亮功归来图",
      "content": [
        "今人常恨古人少，今得见之谁谓无。",
        "欲学渊明归作赋，先烦摩诘画成图。",
        "小池已筑鱼千里，隙地仍栽芋百区。",
        "朝市山林俱有累，不居京洛不江湖。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 206679,
      "title": "次韵徐仲车喜董元达访之作南郭篇四韵",
      "content": [
        "董侯从军来，意望名不朽。",
        "款门拜徐公，在德不在酒。",
        "徐公虽避俗，对客辄粲然。",
        "耳不闻世事，时诵陶令篇。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 206680,
      "title": "次韵仲车为元达置酒四韵",
      "content": [
        "射阳三万家，莫贵徐公门。",
        "谁能拜床前，况乃共酒尊。",
        "惟此酒中趣，难为醒者论。",
        "盗卧月皎皎，鸡鸣雨昏昏。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 206681,
      "title": "次韵仲车因娄行父见寄之什",
      "content": [
        "前朝老诸生，大半正邱首。",
        "投荒万里归，烦公问健否。",
        "往时望江宰，今为夏津吏。",
        "他日可教之，玉音尚无弃。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 206682,
      "title": "武昌松风阁",
      "content": [
        "依山筑阁见平川，夜阑箕斗插屋椽。",
        "我来名之意适然。",
        "老松魁梧数百年，斧斤所赦今参天。",
        "风鸣娲皇五十弦，洗耳不须菩萨泉。",
        "嘉二三子甚好贤，力贫买酒醉此筵。",
        "夜雨鸣廊到晓悬，相看不归卧僧毡。",
        "泉枯石燥复潺湲，山川光辉为我妍。",
        "野僧早饥不能𫗴，晓见寒谿有炊烟。",
        "东坡道人已沈泉，张侯何时到眼前。",
        "钓台惊涛可昼眠，怡亭看篆蛟龙缠。",
        "安得此身脱拘挛，舟载诸友长周旋。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206683,
      "title": "次韵文潜",
      "content": [
        "武昌赤壁吊周郎，寒溪西山寻漫浪。",
        "忽闻天上故人来，呼船凌江不待饷。",
        "我瞻高明少吐气，君亦欢喜失微恙。",
        "年来鬼祟覆三豪，词林根柢颇摇荡。",
        "天生大材竟何用，只与千古拜图像。",
        "张侯文章殊不病，历险心胆原自壮。",
        "汀洲鸿雁未安集，风雪牖户当塞向。",
        "有人出手办兹事，正可隠几穷诸妄。",
        "经行东坡眠食地，拂拭宝墨生楚怆。",
        "水清石见君所知，此是吾家秘密藏。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206684,
      "title": "和文潜舟中所题",
      "content": [
        "云横疑有路，天远欲无门。",
        "信矣江山美，怀哉谴逐魂。",
        "长波空𣶂记，佳句洗眵昏。",
        "谁奈离愁得，村醪或可尊。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 206685,
      "title": "题君子泉",
      "content": [
        "云梦泽南君子泉，水无名字托人贤。",
        "两苏翰墨相为重，未刻他山世已传。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206686,
      "title": "宿黄州观音院钟楼上",
      "content": [
        "钟鸣山川晓，露下星斗湿。",
        "老夫梳白头，潘何埙篪集。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 206687,
      "title": "谢何十三送蟹",
      "content": [
        "形模虽入妇女笑，风味可解壮士颜。",
        "寒蒲束缚十六辈，已觉酒兴生江山。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206688,
      "title": "又借答送蟹韵并戏小何",
      "content": [
        "草泥本自行郭索，玉人为开桃李颜。",
        "恐似曹瞒说鸡肋，不比东阿举肉山。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206689,
      "title": "代二螯解嘲",
      "content": [
        "仙儒昔日卷龟壳，蛤蜊自可洗愁颜。",
        "不比二螯风味好，那堪把酒对西山。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206690,
      "title": "又借前韵见意",
      "content": [
        "招潮瘦恶无永味，海镜纤毫只强颜。",
        "想见霜脐当大嚼，梦回雪压摩围山。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206691,
      "title": "次韵文潜立春日三绝句  其一",
      "content": [
        "眇然今日望欧梅，已发黄州首更回。",
        "试问淮南风月主，新年桃李为谁开。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206692,
      "title": "次韵文潜立春日三绝句  其二",
      "content": [
        "谁怜旧日青钱选，不立春风玉笋班。",
        "传得黄州新句法，老夫端欲把降幡。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206693,
      "title": "次韵文潜立春日三绝句  其三",
      "content": [
        "江山也似随春动，花柳真成触眼新。",
        "清浊尽须归瓮蚁，吉凶更莫问波臣。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206694,
      "title": "再次前韵  其一",
      "content": [
        "春工调物似盐梅，一一根中生意回。",
        "风日安排催岁换，丹青次第与花开。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206695,
      "title": "再次前韵  其二",
      "content": [
        "久狎渔樵作往还，晓风宫殿梦催班。",
        "邻娃似与春争道，酥滴花枝彩剪幡。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206696,
      "title": "再次前韵  其三",
      "content": [
        "酒有全功笔有神，可将心付白头新。",
        "春盘一任人争席，莫道前衔是近臣。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206697,
      "title": "梦中和觞字韵",
      "content": [
        "天教兄弟各异方，不使新年对举觞。",
        "作云作雨手翻覆，得马失马心清凉。",
        "何处胡椒八百斛，谁家金钗十二行。",
        "一邱一壑可曳尾，三沐三舋取刳肠。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 206698,
      "title": "次韵吴可权题余干县白云亭",
      "content": [
        "曩谁筑孤亭，胜日有感遇。",
        "永怀刘随州，因榜白云句。",
        "遗老不能谈，岁月忽成屡。",
        "绿阴斤斧尽，华屋风雨仆。",
        "吴侯七闽英，宰县有真趣。",
        "弦歌解民愠，根节去吏蠹。",
        "材收佛宫余，工有子来助。",
        "厦成燕雀贺，水满凫雁翥。",
        "四海名士来，一笑佳客聚。",
        "云兴碧山留，云散清江去。",
        "斯须成苍狗，皆道不如故。",
        "至人观万物，谁有安立处。",
        "寄语吴令君，但遣糟床注。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206699,
      "title": "次韵廖明略同吴明府白云亭宴集",
      "content": [
        "江静明花竹，山空响管弦。",
        "风生学士麈，云绕令君筵。",
        "百越余生聚，三吴远接连。",
        "庖霜刀落鲙，执玉酒明船。",
        "叶县飞来舄，壶公谪处天。",
        "酌时多暴谑，舞短更成妍。",
        "唯我孤登览，观诗未究宣。",
        "空余五字赏，文似两京然。",
        "医是肱三折，官当岁九迁。",
        "老夫看镜罢，衰白敢争先。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206700,
      "title": "病来十日不举酒二首  其一",
      "content": [
        "病来十日不举酒，回施青春与后生。",
        "满袖东风惬人意，见君诗与字俱清。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206701,
      "title": "病来十日不举酒二首  其二",
      "content": [
        "病来十日不举酒，独卧南床春草生。",
        "承君折送袁家紫，令我兴发郎官清。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206702,
      "title": "题小景扇",
      "content": [
        "草色青青柳色黄，桃花零落杏花香。",
        "春风不解吹愁却，春日偏能惹恨长。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206703,
      "title": "鄂州南楼书事四首  其一",
      "content": [
        "四顾山光接水光，凭栏十里芰荷香。",
        "清风明月无人管，并作南楼一味凉。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206704,
      "title": "鄂州南楼书事四首  其二",
      "content": [
        "画阁传觞容十客，透风透月两明轩。",
        "南楼槃礴三百尺，天上云居不足言。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    }
  ],
