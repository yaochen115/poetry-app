{
  "data": [
    {
      "id": 314901,
      "title": "昭君怨",
      "content": [
        "隔叶乳鸦声软。",
        "啼断日斜影转。",
        "杨柳小腰肢。",
        "画楼西。",
        "役损风流心眼。",
        "眉上新愁无限。",
        "极目送云行。",
        "此时情。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314902,
      "title": "桃源忆故人",
      "content": [
        "夜来一夜东风暖。",
        "春到桃腮柳眼。",
        "对景可堪肠断。",
        "强把愁眉展。",
        "花期惹起归期念。",
        "前事从头忖遍。",
        "凝想水遥山远。",
        "空结相思怨。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314903,
      "title": "长相思",
      "content": [
        "花飞飞。",
        "柳依依。",
        "帘卷东风日正迟。",
        "社前双燕归。",
        "药栏东，药栏西。",
        "记得当时素手携。",
        "弯弯月似眉。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314904,
      "title": "感皇恩",
      "content": [
        "景物一番新，熙熙时候。",
        "小院融和渐长昼。",
        "东君有意，为怜纤腰消瘦。",
        "软风吹破眉间皱。",
        "袅袅枝头，轻黄微透。",
        "舞到春深转清秀。",
        "锦囊多感，又更新来伤酒。",
        "断肠无语凭栏久。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314905,
      "title": "探春令",
      "content": [
        "笙歌间错华筵启。",
        "喜新春新岁。",
        "菜传纤手青丝细。",
        "和气入、东风里。",
        "幡儿胜儿都姑媂。",
        "戴得更忔戏。",
        "愿新春已后，吉吉利利。",
        "百事都入意。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314906,
      "title": "菩萨蛮",
      "content": [
        "赤栏干外桃花雨。",
        "飞花已觉春归去。",
        "柳色碧依依。",
        "浓阴春昼迟。",
        "海棠红未破。",
        "匀糁胭脂颗。",
        "风雨也相饶。",
        "应怜粉面娇。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314907,
      "title": "丑奴儿・采桑子",
      "content": [
        "牡丹已过酴醿谢，飞尽繁花。",
        "浓翠啼鸦。",
        "绿水桥边卖酒家。",
        "年时携手寻春去，满引流霞。",
        "往事堪嚓。",
        "犹喜潘郎鬓未华。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314908,
      "title": "浣溪沙",
      "content": [
        "帘卷轻风怜小春。",
        "荷枯菊悴正愁人。",
        "江梅喜见一枝新。",
        "料得主人偏爱惜，也应冰雪好精神。",
        "故园桃李莫生嗔。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314909,
      "title": "清平乐",
      "content": [
        "楚梅娇小。",
        "好是霜天晓。",
        "宿酒恼人香暗绕。",
        "浸影碧波池沼。",
        "生成素淡芳容。",
        "不须抹黛匀红。",
        "准拟凝成阴结子，莫教枉费春工。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314910,
      "title": "清平乐",
      "content": [
        "绮疏新晓。",
        "学语雏莺巧。",
        "烟暖瑶阶梧叶老。",
        "满地东风芳草。",
        "少年不合风流。",
        "偿他酒债花愁。",
        "望断绿芜春去，销魂懒上层楼。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314911,
      "title": "更漏子",
      "content": [
        "日彤彤，风荡荡。",
        "帘外柳花飞扬。",
        "红有限，绿无穷。",
        "雨晴芳径中。",
        "肠寸结。",
        "萦离别。",
        "还是去年时节。",
        "春暮也，子归啼。",
        "伤春三月时。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314912,
      "title": "诉衷情",
      "content": [
        "檀心刻玉几千重。",
        "开处对房栊。",
        "黄昏淡月笼艳，香与酒争浓。",
        "宜轻素，鄙轻红。",
        "思无穷。",
        "化工著意，南南北北，一种东风。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314913,
      "title": "小重山",
      "content": [
        "枝上杨花糁玉尘。",
        "晚风扶起处，雪轻盈。",
        "扑人点点细无声。",
        "谁能惜，撩乱满江城。",
        "忍泪未须倾。",
        "十年追往事，叹流莺。",
        "晓来雨过转伤情。",
        "铺池绿，遣恨寄浮萍。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314914,
      "title": "蝶恋花",
      "content": [
        "绿尽烧痕芳草遍。",
        "不暖不寒，切莫辜良宴。",
        "罨画屏风开羽扇。",
        "薄罗衫子仙衣练。",
        "晚雨小池添水面。",
        "戏跃赪鳞，又向波心见。",
        "持酒伊听声宛转。",
        "樽前唱彻昭阳怨。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314915,
      "title": "鹧鸪天",
      "content": [
        "梁上双双海燕归。",
        "故人应不寄新诗。",
        "柳梧阴里高还下，帘幕中间去复回。",
        "追盛事，忆乌衣。",
        "王家巷陌日沈西。",
        "兴亡无限惊心语，说与时人总不知。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314916,
      "title": "鹧鸪天",
      "content": [
        "谡谡东风作雨寒。",
        "无言独自凭栏干。",
        "绿肥红瘦春归去，恨逼愁侵酒怎宽。",
        "追往事，惜花残。",
        "残花往事总相关。",
        "风光台上伤心处，此意人休作等闲。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314917,
      "title": "探春令",
      "content": [
        "新元才过，渐融和气，先到帘帏。",
        "谩闲绕、柳径花蹊里。",
        "探看试、春来未。",
        "年时曾把春抛弃。",
        "与春光陪泪。",
        "待今春、日日花前沈醉。",
        "款细偎红翠。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314918,
      "title": "探春令",
      "content": [
        "数声回雁。",
        "几番疏雨，东风回暖。",
        "甚今年、立得春来晚。",
        "过人日、方相见。",
        "缕金幡胜教先办。",
        "著工夫裁剪。",
        "到那时睹当，须教滴惜，称得梅妆面。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314919,
      "title": "探春令",
      "content": [
        "冰檐垂箸，雪花飞絮，时方严肃。",
        "向寻常摇曳，凡花野草，怎生敢夸红绿。",
        "江梅孤洁无拘束。",
        "只温然如玉。",
        "自一般天赋，风流清秀，总不同粗俗。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314920,
      "title": "探春令",
      "content": [
        "而今风韵，旧时标致，总皆奇绝。",
        "再相逢还是，春前腊后，粉面凝香雪。",
        "芳心自与群花别。",
        "尽孤高清洁。",
        "那情怀最是，与人好处，冷淡黄昏月。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314921,
      "title": "探春令",
      "content": [
        "雕墙风定，绮窗烛灺，沈吟独坐。",
        "料雪霜深处，司花神女，暗里焚百和。",
        "恼人一阵香初过。",
        "把清愁薰破。",
        "更那堪得，冰姿玉貌，痛与惜则个。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314922,
      "title": "探春令",
      "content": [
        "龟纱隔雾，绣帘钩月，那时曾见。",
        "照影儿、觑了千回百转。",
        "素艳明于练。",
        "柔肠堆满相思愿。",
        "更重看几遍。",
        "是天然不用，施朱栊翠，羞损桃花面。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314923,
      "title": "探春令",
      "content": [
        "疏篱横出，绿枝斜露，笑盈盈地。",
        "悄一似、初睹东邻女，有无限、风流意。",
        "半开折得琼瑰蕊。",
        "惹新香沾袂。",
        "放曲屏珠幌胆瓶儿里，伴我醺醺睡。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314924,
      "title": "探春令",
      "content": [
        "冰澌池面。",
        "柳摇金线，春光无限。",
        "问梅花底事，收香藏蕊，到此方舒展。",
        "百花头上俱休管。",
        "且惊开俗眼。",
        "看绿阴结子，成功调鼎，有甚迟和晚。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314925,
      "title": "探春令",
      "content": [
        "溪桥山路。",
        "竹篱茅舍，凄凉风雨。",
        "被摧残沮挫，精神依旧，无奈相思苦。",
        "东君故与收拾取。",
        "忍教他尘土。",
        "向绿窗绣户，朱栏小槛，做个名花主。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314926,
      "title": "探春令",
      "content": [
        "雨孱风瘦，雪欺霜妒，时光牢落。",
        "怎奈向、天与孤高出众，一任傍人恶。",
        "凡花且莫相嘲谑。",
        "尽强伊寂寞。",
        "便饶他、百计千方就做，酝藉如何学。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314927,
      "title": "探春令",
      "content": [
        "楼头月满。",
        "栏干风度，有人肠断。",
        "为多情、役得神魂撩乱。",
        "又被梅萦绊。",
        "对花沈醉应须拼。",
        "且尊前相伴。",
        "恨无端玉笛，穿帘透幕，好梦还惊散。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314928,
      "title": "探春令",
      "content": [
        "清江平淡，暗香潇洒，满林风露。",
        "渐枝上、也学杨花柳絮。",
        "轻逐春归去。",
        "东君著意勤遮护。",
        "总留他不住。",
        "幸西园别有，能言花貌，委曲关心愫。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314929,
      "title": "宝鼎现",
      "content": [
        "嚣尘尽扫，碧落辉腾，元宵三五。",
        "更漏永、迟迟停鼓。",
        "天上人间当此遇。",
        "正年少、尽香车宝马，次第追随士女。",
        "看往来、巷陌连甍，簇起星逑无数。",
        "政简物阜清闲处。",
        "听笙歌、鼎沸频举。",
        "灯焰暖、庭帏高下，红影相交知几户。",
        "恣欢笑、道今宵景色，胜前时几度。",
        "细算来、皇都此夕，消得喧传今古。",
        "排备绮席成行，炉喷袅、沈檀轻缕。",
        "睹遨游彩仗，疑是神仙伴侣。",
        "欲飞去、恨难留住。",
        "渐到蓬瀛步。",
        "愿永逢、恁时恁节，且与风光为主。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314930,
      "title": "青玉案",
      "content": [
        "梅黄又见纤纤雨。",
        "客里情怀两眉聚。",
        "何处烟村啼杜宇。",
        "劝人归去，早思家转，听得声声苦。",
        "利名萦绊何时住。",
        "恼乱愁肠成万缕。",
        "满眼兴亡知几许。",
        "不如寻个，老松石畔，作个柴门户。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314931,
      "title": "烛影摇红",
      "content": [
        "梅雪飘香，杏花开艳燃春昼。",
        "铜驼烟淡晓风轻，摇曳青青柳。",
        "海燕归来未久。",
        "向雕梁、初成对偶。",
        "日长人困，绿水池塘，清明时候。",
        "帘幕低垂，麝煤烟喷黄金兽。",
        "天涯人去杳无凭，不念东阳瘦。",
        "眉上新愁压旧。",
        "要消遣、除非𣨼酒。",
        "酒醒人静，月满南楼，相思还又。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314932,
      "title": "念奴娇",
      "content": [
        "银蟾光满，弄馀辉、冷浸江梅无力。",
        "缓引柔条浮素蕊，横在闲窗虚壁。",
        "染纸挥毫，粉涂墨晕，不似今端的。",
        "天然造化，别是一般，清瘦踪迹。",
        "今夜翠葆堂深，梦回风定，因月才相识。",
        "先自离愁，那更被、晓角残更催逼。",
        "曙色将分，轻阴移尽，过眼难寻觅。",
        "江南图上，画工应为描得。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314933,
      "title": "念奴娇",
      "content": [
        "玉龙声杳，正瑶台曲舞，香山初彻。",
        "褪粉掐酥千万颗，满地平铺银雪。",
        "草褥香茵，苔钱买住，留待黄昏月。",
        "有人妆罢，对花凝伫愁绝。",
        "休更恨落羞开，东君情分，自古多离别。",
        "好把芳心收拾取，与个和羹人说。",
        "摆脱风尘，消停酸苦，终有成时节。",
        "浮花浪蕊，到头不是生活。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314934,
      "title": "阮郎归",
      "content": [
        "和风暖日小层楼。",
        "人闲春事幽。",
        "杏花深处一声鸠。",
        "花飞水自流。",
        "寻旧梦，续扬州。",
        "眉山相对愁。",
        "忆曾和泪送行舟。",
        "清江古渡头。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314935,
      "title": "虞美人",
      "content": [
        "东风卷尽辛夷雪。",
        "逆旅清明节。",
        "黄昏烟雨失前山。",
        "陟遍朱栏、酒噤不禁寒。",
        "归来谁护衣篝火。",
        "倒拥文鸳卧。",
        "可堪连夜子规啼。",
        "唤得春归、人却未成归。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314936,
      "title": "念奴娇",
      "content": [
        "兰枯菊槁。",
        "是返魂香入，江南春早。",
        "谷静林幽人不见，梦与梨花颠倒。",
        "雪刻檀心，玉匀丰颊，妆趁严锺晓。",
        "海山么凤，绿衣何处飞绕。",
        "竹外孤袅一枝，古今解道，只有东坡老。",
        "莫倚广平心似铁，闲把珠玑挥扫。",
        "桃李舆台，冰霜宾客，月地还凄悄。",
        "暗香消尽，和羹心事谁表。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314937,
      "title": "玉楼春",
      "content": [
        "江村百六春强半。",
        "拍拍池塘春水满。",
        "风团柳絮舞如狂，雨压橘花香不散。",
        "阴阴巷陌闲庭院。",
        "小立危栏羞燕燕。",
        "不知何事未还乡，除却青春谁作伴。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314938,
      "title": "谒金门",
      "content": [
        "风又雨。",
        "满地残红无数。",
        "花不能言莺解语。",
        "晓来啼更苦。",
        "把酒东皋日暮。",
        "抵死留春春去。",
        "拟倩杨花寻去处。",
        "杨花无定据。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314939,
      "title": "菩萨蛮",
      "content": [
        "杨花飞尽莺声涩。",
        "杜娟唤得春归急。",
        "病酒起来迟。",
        "娇慵懒画眉。",
        "宝奁金鸭冷。",
        "重唤烧香饼。",
        "著意炼龙涎。",
        "纤纤手逴烟。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314940,
      "title": "画堂春",
      "content": [
        "小亭烟柳水溶溶。",
        "野花白白红红。",
        "恼人池上晚来风。",
        "吹损春容。",
        "又是清明天气，记当年、小院相逢。",
        "凭栏幽思几千重。",
        "残杏香中。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314941,
      "title": "画堂春",
      "content": [
        "夜来暖趁海棠时。",
        "脸边匀透胭脂。",
        "乱红娇影困垂垂。",
        "睡损杨妃。",
        "多少肉温香润，朱唇绿鬓相偎。",
        "晚风何苦过台西。",
        "断送春归。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314942,
      "title": "卜算子",
      "content": [
        "春水满江南，三月多芳草。",
        "幽鸟闲将远恨来，一一都啼了。",
        "不学鸳鸯老。",
        "回首临平道。",
        "人道长眉似远山，山不似长眉好。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314943,
      "title": "念奴娇",
      "content": [
        "水边篱落独横枝，冉冉风烟岑寂。",
        "踏雪寻芳村路永，竹屋西头遥识。",
        "蕙草香销，小桃红未，醉眼惊春色。",
        "离愁何处，断肠无限陈迹。",
        "憔悴素脸朱唇，天寒日暮，倚栏干无力。",
        "岁晚天涯驿使远，难寄江南消息。",
        "自笑平生，怜清惜淡，故园曾亲植。",
        "百花虽好，问还有恁标格。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314944,
      "title": "菩萨蛮",
      "content": [
        "肩舆晓踏江头月。",
        "月华冷浸消残雪。",
        "雪月照疏篱。",
        "梅花三两枝。",
        "人怜花淡薄。",
        "花恨人牢落。",
        "不似那回时。",
        "醺醺醉玉肌。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314945,
      "title": "点绛唇",
      "content": [
        "开尽梅花，雪残庭户春来早。",
        "岁华偏好。",
        "只恐催人老。",
        "惟有诗情，犹被花枝恼。",
        "金樽倒。",
        "共成欢笑。",
        "终是清狂少。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314946,
      "title": "鹧鸪天",
      "content": [
        "手种梅花三四株。",
        "要看冰霜照清臞。",
        "朝来几朵茅檐下，竹外江头恐不如。",
        "凝玉面，吐香须。",
        "莫嫌孤瘦渐丰馀。",
        "化工不肯辜人意，做底欢娱报答渠。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314947,
      "title": "鹧鸪天",
      "content": [
        "只惯娇痴不惯愁。",
        "离情浑不挂眉头。",
        "可怜恼尽尊前客，却趁东风上小舟。",
        "真个去，不忺留。",
        "落花流水一春休。",
        "自怜不及春江水，随到滕王阁下流。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314948,
      "title": "瑞鹤仙",
      "content": [
        "海棠花半落。",
        "正蕙圃风生，兰亭香扑。",
        "青英暝池阁。",
        "任翻红飞絮，游丝穿幕。",
        "情怀易著。",
        "奈宿酲、情绪正恶。",
        "叹韶光渐改，年华荏苒，旧欢如许。",
        "追念凭肩盟誓，枕臂私言，尽成离索。",
        "记得忘却。",
        "当时事，那时约。",
        "怕灯前月下，得见则个，厌厌只待窥著。",
        "问新来、为谁萦牵，又还瘦削。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314949,
      "title": "临江仙",
      "content": [
        "过尽征鸿来尽燕，故园消息茫然。",
        "一春憔悴有谁怜。",
        "怀家寒食夜，中酒落花天。",
        "见说江头春浪渺，殷勤欲送归船。",
        "别来此处最萦牵。",
        "断篷南浦雨，疏柳断桥烟。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314950,
      "title": "一丛花",
      "content": [
        "阶前春草乱愁芽。",
        "尘暗绿窗纱。",
        "钗盟镜约知何限，最断肠、湓浦琵琶。",
        "南渚送船，西城折柳，遗恨在天涯。",
        "夜来魂梦到侬家。",
        "一笑脸如霞。",
        "莺啼燕恨西窗下，问何事、潘鬓先华。",
        "钟动五更，魂归千里，残角怨梅花。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314951,
      "title": "柳梢青",
      "content": [
        "桃杏舒红。",
        "迟迟暖日，媚景芳浓。",
        "紫燕穿帘，香泥著地，未乳巢空。",
        "千山万水重重。",
        "烟雨里、王维画中。",
        "芳草斜阳，无人江渡，蓑笠渔翁。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314952,
      "title": "花心动",
      "content": [
        "绿水平湖，浸芙渠烂锦，艳胜倾国。",
        "半敛半开，斜立斜敧，好似困娇无力。",
        "水仙应赴瑶池宴，醉归去、美人扶策。",
        "驻香驾、拥波心媚容，倩妆颜色。",
        "曾见苕川澄碧。",
        "匀粉面、溪头旧时相识。",
        "翠被绣裀，彩扇香篝，度岁杳无消息。",
        "露痕滴尽风前泪，追往恨、悠悠踪迹。",
        "动怨忆。",
        "多情自家赋得。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314953,
      "title": "鼓笛慢・水龙吟",
      "content": [
        "暑风吹雨仙源过，深院静，凉于水。",
        "莲花郎面，翠幢红粉，烘人香细。",
        "别院新番，曲成初按，词清声脆。",
        "奈难堪羞涩，朦松病眼，无心听，笙簧美。",
        "还记当年此际。",
        "叹飘零、萍踪千里。",
        "楚云寂寞，吴歌凄切，成何情意。",
        "因念而今，水乡潇洒，风亭高致。",
        "对花前可是，十分蒙斗，肯辜欢醉。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314954,
      "title": "念奴娇",
      "content": [
        "晚妆才罢，见栊丝匀玉，一团娇秀。",
        "趁得年光，长是向、金谷无花时候。",
        "不比莺莺，不关燕燕，不似章台柳。",
        "清凉无汗，雪肌潇洒难偶。",
        "好是斜月黄昏，瑶阶钿砌，百媚初含酒。",
        "恼杀多情香喷喷，双靥盈盈回首。",
        "倾国倾城，千金莫惜，兰蕙应难友。",
        "沈郎拚了，为花一味销瘦。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314955,
      "title": "满庭芳",
      "content": [
        "竹飐斜梢，荷倾馀沥，晚风初到南池。",
        "雨收池上，高柳乱蝉嘶。",
        "冉冉莲香满院，夕阳映、红浸庭闱。",
        "凉生到，碧瓜破玉，白酒酌玻璃。",
        "思量，浮世事，枯荣辱宠，欢喜忧悲。",
        "算劳心劳力，得甚便宜。",
        "粗有田园笑傲，拣些个、朋友追随。",
        "好时景，莫教挫过，撞著醉如泥。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314956,
      "title": "满庭芳",
      "content": [
        "红藕洲塘，黄葵庭院，渚风时动清飔。",
        "素纨轻飐，凉色爽征衣。",
        "一一光阴日月，关情处、前事难期。",
        "空凝想，临鸾有恨，谁与画新眉。",
        "刀头，心寸折，江南厚约，惟是侬知。",
        "念默歌停舞，冷落屏帏。",
        "何日朱笼鹦鹉，迎门报、金勒东归。",
        "罗弦管，合欢声里，烂醉玉东西。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314957,
      "title": "好事近",
      "content": [
        "山路乱蝉吟，声隐茂林修竹。",
        "恰值快风收雨，递荷香芬馥。",
        "破除愁虑酒宜多，把酒再三嘱。",
        "遥想溪亭潇洒，称晚凉新浴。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314958,
      "title": "虞美人",
      "content": [
        "二乔姊妹新妆了。",
        "照水盈盈笑。",
        "多情相约五湖游。",
        "似向群花丛里、骋风流。",
        "丁香枝上千千结。",
        "怨惹相思切。",
        "争如特地嫁薰风。",
        "吐尽芳心点点、绛唇红。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314959,
      "title": "醉蓬莱",
      "content": [
        "正火山槐夏，黛叶湘枝，荔子新摘。",
        "千里驰驱，荐仙源佳席。",
        "浪比龙晴，未输崖蜜，灿烂然红摘。",
        "满贮雕盘，纤纤素手，丹苞新擘。",
        "梨栗粗疏，带酸橘柚，凡品多般，总羞标格。",
        "何以浓香，洗烦襟仙液。",
        "为爱真妃，再三珍重，价倾城倾国。",
        "玉骨冰肌，风流酝藉，直宜消得。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314960,
      "title": "醉蓬莱",
      "content": [
        "见浴兰才罢，拂掠新妆，巧梳云髻。",
        "初试生衣，恰三裁贴体。",
        "艾虎宜男，朱符辟恶，好储祥纳吉。",
        "金凤钗头，应时戴了，千般忔戏。",
        "那更殷勤，再三祝愿，斗巧合欢，彩丝缠臂。",
        "刻玉香蒲，泛金觥迎醉。",
        "午日熏风，楚词高咏，度遏云声脆。",
        "赤口白舌，从今消灭，诸馀可意。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314961,
      "title": "踏莎行",
      "content": [
        "树影将圆，林梢不动。",
        "汗珠挹透纱衣重。",
        "荷风忽送雨飞来，晚凉习习生幽梦。",
        "珠箔高钩，瑶琴闲弄。",
        "移樽邀取蝉娟共。",
        "今宵拼著醉眠呵，夜香闻早添金凤。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314962,
      "title": "醉落魄・一斛珠",
      "content": [
        "淡妆浓抹。",
        "西湖人面两奇绝。",
        "菖蒲角黍家家节。",
        "水戏鱼龙，十里画帘揭。",
        "凌波无限生尘袜。",
        "冰肌莹彻香罗雪。",
        "游船且莫催归楫。",
        "遮莫黄昏，天外有新月。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314963,
      "title": "阮郎归",
      "content": [
        "东城沙软马蹄轻。",
        "清和雨乍晴。",
        "柳阴曲径泣流莺。",
        "凄凉不忍听。",
        "休苦怨，莫悲鸣。",
        "何须雨泪倾。",
        "但将巧语写心诚。",
        "东君肯薄情。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314964,
      "title": "蝶恋花",
      "content": [
        "乱叠青钱荷叶小。",
        "浓绿阴阴，学语雏莺巧。",
        "小树飞花芳径草。",
        "堆红衬碧于中好。",
        "梅子弄黄枝上早。",
        "春已归时，戏蝶游蜂少。",
        "细把新词才和了。",
        "鸡声已唤纱窗晓。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314965,
      "title": "鹧鸪天",
      "content": [
        "新晴水暖藕花红。",
        "烘人暑意晚来浓。",
        "共携纤手桥东路，杨柳青青一径风。",
        "深翠里，艳香中。",
        "双莺初下蕊珠宫。",
        "月笼粉面三更露，凉透萧萧一梦中。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314966,
      "title": "江神子・江城子",
      "content": [
        "彩云飞尽楚天空。",
        "碧溶溶。",
        "一帘风。",
        "吹起荷花，香雾喷人浓。",
        "明月凄凉多少恨，恨难许，我情锺。",
        "相思魂梦几时穷。",
        "洞房中。",
        "忆从容。",
        "须信别来，应也敛眉峰。",
        "好景良宵添怅望，无计与，一樽同。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314967,
      "title": "新荷叶",
      "content": [
        "冷彻蓬壶，翠幢鼎鼎生香。",
        "十顷玻璃，望中无限清凉。",
        "遮风掩日，高低衬、密护红妆。",
        "阴阴湖里，羡他双浴鸳鸯。",
        "猛忆西湖，当年一梦难忘。",
        "折得曾将盖雨，归思如狂。",
        "水云千里，不堪更、回首思量。",
        "而今把酒，为伊沈醉何妨。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314968,
      "title": "临江仙",
      "content": [
        "帘幕轻风洒洒，园林绿荫垂垂。",
        "楝花开遍麦秋时。",
        "雨深芳草渡，蝴蝶正慵飞。",
        "憔悴三春心事，风流一弄金衣。",
        "韶光老尽起深思。",
        "日长庭院里，徙倚听催归。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314969,
      "title": "朝中措",
      "content": [
        "荷钱浮翠点前溪。",
        "梅雨日长时。",
        "恰是清和天气，雕鞍又作分携。",
        "别来几日愁心折，针线小蛮衣。",
        "羞对绿阴庭院，衔泥燕燕于飞。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314970,
      "title": "减字木兰花",
      "content": [
        "柳丝摇翠。",
        "翠幄笼阴无限意。",
        "不绊行舟。",
        "只向江边绊客愁。",
        "月明风细。",
        "分付一江流去水。",
        "娇眼伤春。",
        "谁是章台欲折人。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314971,
      "title": "卜算子",
      "content": [
        "执手送行人，水满荷花浦。",
        "旧恨新愁不忍论，泪压潇潇雨。",
        "行计已匆匆，无计留伊住。",
        "一点相思万里心，谁怕关山阻。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314972,
      "title": "临江仙",
      "content": [
        "柳上斜阳红万缕，烘人满院荷香。",
        "晚凉初浴略梳妆。",
        "冠儿轻替枕，衫子染莺黄。",
        "蓄意新词轻缓唱，殷勤满捧瑶觞。",
        "醉乡日月得能长。",
        "仙源正闲散，伴我老高唐。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314973,
      "title": "雨中花令",
      "content": [
        "绿锁窗纱梧叶底。",
        "麦秋时、晓寒慵起。",
        "宿酒厌厌，残香冉冉，浑似那时天气。",
        "别日不堪频屈指。",
        "回头早、一年不啻。",
        "搔首无言，栏干十二，倚了又还重倚。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314974,
      "title": "画堂春",
      "content": [
        "湖光乘雨碧连天。",
        "绕堤映、草色芊芊。",
        "舞风杨柳欲撕绵。",
        "依依起翠烟。",
        "还是春风客路，对花时、空负蝉娟。",
        "暮寒楼阁碧云间。",
        "罗袖成斑。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314975,
      "title": "浣溪沙",
      "content": [
        "露挹新荷扑鼻香。",
        "恼人更漏乡浪浪。",
        "柳梳斜月上纱窗。",
        "小醉耳边私语好，五云楼阁羡刘郎。",
        "酒阑烛暗断回肠。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314976,
      "title": "西江月",
      "content": [
        "水满平塘过雨，洗妆红褪芙蕖。",
        "绿荷美影荫龟鱼。",
        "无限闲中景趣。",
        "潇洒高堂邃馆，那堪左右图书。",
        "凌云赋得似相如。",
        "多少风流态度。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314977,
      "title": "卜算子",
      "content": [
        "闲路踏花来，闲逐清和云。",
        "来去虽然总是闲，有多少伤心处。",
        "红碧好池塘，朱绿深庭户。",
        "随分山歌社舞中，且乐陶陶趣。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314978,
      "title": "清平乐",
      "content": [
        "水乡清楚。",
        "襟袖销袢暑。",
        "绰约藕花初过雨。",
        "出浴杨妃无语。",
        "葡萄满酌玻璃。",
        "已拼一醉酬伊。",
        "浪卷夕阳红碎，池光飞上帘帏。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314979,
      "title": "清平乐",
      "content": [
        "清和时候。",
        "底事休交瘦。",
        "满酌流霞看舞袖。",
        "步步锦裀红皱。",
        "六么舞到虚催。",
        "几多深意徘徊。",
        "拼了明朝中酒，为伊更饮琼杯。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314980,
      "title": "浣溪沙",
      "content": [
        "雾透龟纱月映栏。",
        "麦秋天气怯衣单。",
        "楝花风软晓来寒。",
        "懒起麝煤重换火，暖香浓处敛眉山。",
        "眼波横浸绿云鬟。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314981,
      "title": "浣溪沙",
      "content": [
        "薄雾轻阴酿晓寒。",
        "起来宿酒尚酡颜。",
        "柳莺何事苦关关。",
        "新恨旧愁俱唤起，当年紫袖看弓弯。",
        "泪和梅雨两潸潸。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314982,
      "title": "鹧鸪天",
      "content": [
        "牙领番腾一线红。",
        "花儿新样喜相逢。",
        "薄纱衫子轻笼玉，削玉身材瘦怯风。",
        "人易老，恨难穷。",
        "翠屏罗幌两心同。",
        "既无闲事萦怀抱，莫把双蛾皱碧峰。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314983,
      "title": "菩萨蛮",
      "content": [
        "方池新涨蒲萄绿。",
        "晓来雨过花如浴。",
        "测测杏园风。",
        "梢头一捻红。",
        "危楼愁独倚。",
        "一寸心千里。",
        "宿酒尚微醺。",
        "懒装堆髻云。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314984,
      "title": "西江月",
      "content": [
        "稳唱巧翻新曲，灵犀密意潜通。",
        "荷花香染晚来风。",
        "相对恍然如梦。",
        "有恨眉尖皱碧，多情酒晕生红。",
        "此愁不是等闲浓。",
        "应为仙源倾动。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314985,
      "title": "浣溪沙",
      "content": [
        "睡起风帘一派垂。",
        "失巢燕子傍人飞。",
        "日长深院委香泥。",
        "绿笋出林翻锦箨，红葵著雨褪胭脂。",
        "微风度竹入轻衣。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314986,
      "title": "蝶恋花",
      "content": [
        "忆昔临平山下过。",
        "无数荷花，照水无纤黦。",
        "短艇直疑天上坐。",
        "醉眠花里香无那。",
        "雨浥红妆娇娜娜。",
        "脉脉含情，欲向风前破。",
        "莫道晚来风景可。",
        "青房著子千千颗。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314987,
      "title": "浣溪沙",
      "content": [
        "密叶阴阴翠幄深。",
        "梅黄弄雨正频频。",
        "榴花照眼一枝新。",
        "缑岭有人今毓粹，飞凫不日簉严宸。",
        "一尊敬寿太夫人。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314988,
      "title": "浣溪沙",
      "content": [
        "雨过西湖绿涨平。",
        "环湖密柳暗藏莺。",
        "麦秋天气似清明。",
        "对策有人新切直，逢春不日尽施行。",
        "扁舟未用速归程。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314989,
      "title": "青玉案",
      "content": [
        "结堂雄占云烟表。",
        "万象争呈巧。",
        "老木参天溪四绕。",
        "乱山横秀，一湖澄照。",
        "天付阴晴好。",
        "夜空唤客清樽倒。",
        "明月飞来上林杪。",
        "凉满九宵风露浩。",
        "酒慵起舞，一声清啸。",
        "平压波声小。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314990,
      "title": "青玉案",
      "content": [
        "恍如辽鹤归华表。",
        "阅尽人间巧。",
        "天乞一堂山对绕。",
        "微波不动，岸巾时照。",
        "照见星星好。",
        "舞风荷盖从敧倒。",
        "碧树生凉自天杪。",
        "谁识元龙胸次浩。",
        "骑鲸欲去，引杯独啸。",
        "醉眼青天小。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314991,
      "title": "谒金门",
      "content": [
        "今夜雨。",
        "扫尽一番袢暑。",
        "宛似潇潇鸣远浦。",
        "短蓬何日去。",
        "自漉床头玉醑。",
        "清兴有谁知否。",
        "反笑功名能几许。",
        "槐宫非浪语。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314992,
      "title": "念奴娇",
      "content": [
        "江城向晓，被西风揉碎，一天丝雨。",
        "乱织离愁千万缕，多少关心情绪。",
        "促织鸣时，木犀开后，秋色还如许。",
        "那堪飘泊，异乡千里孤旅。",
        "应想帘幕闲垂，西楼东院，齐把归期数。",
        "记得临歧收泪眼，执手叮咛言语。",
        "白酒红萸，黄花绿橘，莫等闲辜负。",
        "朱笼归骑，甚时先报鹦鹉。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314993,
      "title": "念奴娇",
      "content": [
        "花王有意，念三秋寂寞，凄凉天气。",
        "木落烟深山雾冷，不比寻常风味。",
        "勒驾闲来，柳蒲憔悴，无限惊心事。",
        "仙容香艳，俨然春盛标致。",
        "雅态出格天姿，风流酝藉，羞杀岩前桂。",
        "寄语芙蓉临水际，莫骋芳颜妖丽。",
        "一朵凭栏，千花退避，恼得骚人醉。",
        "等闲风雨，更休僝僽容易。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314994,
      "title": "声声慢",
      "content": [
        "金风玉露，绿橘黄澄，商秋爽气飘逸。",
        "南斗腾光，应是间生贤出。",
        "照人紫芝眉宇，更仙风、谁能俦匹。",
        "细屈指，到小春时候，恰则三日。",
        "莫论早年富贵，也休问文章，有如椽笔。",
        "尧舜逢君，启沃定知多术。",
        "而今且张锦幄，麝煤泛、暖香郁郁。",
        "华堂里，听瑶琴轻弄，水仙新律。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314995,
      "title": "瑞鹤仙",
      "content": [
        "西风苹末起。",
        "动院落清秋，新凉如水。",
        "纤歌遏云际。",
        "正美人翻曲，阳春轻丽。",
        "兰衣玉佩。",
        "拥南斗、光中一醉。",
        "有邦人、万口同声，赞叹我公恺悌。",
        "百里。",
        "年丰谷稔，事简刑清，颂声盈耳。",
        "鹏程九万，摹空展、垂天翼。",
        "定丹书飞下，彤墀归去，秘略家传小试。",
        "看封留、亘古功名，未容退避。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314996,
      "title": "满庭芳",
      "content": [
        "雨洗长空，风清云路，又还毕备佳期。",
        "夜凉如水，一似去秋时。",
        "渺渺银河浪静，星桥外、香霭馡馡。",
        "霞轺举，鸾骖鹊驭，稳稳过飞梯。",
        "经年，成间阻，相逢无语，应喜应悲。",
        "怕玉绳低处，依旧睽离。",
        "和我愁肠万缕，嫦娥怨、底事来迟。",
        "广寒殿，春风桂魄，首与慰相思。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314997,
      "title": "水调歌头",
      "content": [
        "今夕知何夕，秋色正平分。",
        "嫦娥此际，底事越样好精神。",
        "已是天高气肃，那更清风洒洒，万里没纤云。",
        "把酒临风饮，酒面起红鳞。",
        "歌一曲，舞一曲，捧金樽。",
        "从他妄想，老兔憔悴正纷纷。",
        "我为桂花拚醉，明日扶头不起，颠倒白纶巾。",
        "天若知人意，夜雨莫倾盆。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314998,
      "title": "蓦山溪",
      "content": [
        "满城风雨，又是重阳近。",
        "黄菊媚清秋，倚东篱、商量开尽。",
        "红萸白酒，景物一年年，人渐远，梦还稀，赢得无穷恨。",
        "钗分镜破，一一关方寸。",
        "强醉欲消除，醉魂醒、凄凉越闷。",
        "鸳鸯宿债，偿了恶因缘，当时事，只今愁，斑尽安仁鬓。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314999,
      "title": "洞仙歌",
      "content": [
        "芰荷已老，菊与芙蓉未。",
        "一夜秋容上岩桂。",
        "间蘩芜、嫩黄染就琼瑰，开未足，已早香传十里。",
        "从前分付处，明月清风，不用斜晖照佳丽。",
        "叹浮花，徒解咤，浅白深红，争似我、潇洒堆金积翠。",
        "看天阔、秋高露华清，见标致风流，更无尘意。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315000,
      "title": "虞美人",
      "content": [
        "西风明月临台榭。",
        "准拟中秋夜。",
        "一年等待到而今。",
        "为甚今宵陡顿、却无情。",
        "姮娥应怨孤眠苦。",
        "取次为云雨。",
        "素蟾特地暗中圆。",
        "未放清光容易、到仙源。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    }
  ],
