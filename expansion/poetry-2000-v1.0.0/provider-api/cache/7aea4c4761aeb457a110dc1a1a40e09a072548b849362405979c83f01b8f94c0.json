{
  "data": [
    {
      "id": 280609,
      "title": "送僧东游",
      "content": [
        "师归旧山去，此别已凄然。",
        "灯影秋江寺，篷声夜雨船。",
        "鸥飞吴市外，麟卧晋陵前。",
        "若到东林社，谁人更问禅。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280610,
      "title": "盘石寺留别成公",
      "content": [
        "槲叶萧萧带苇风，寺前归客别支公。",
        "三秋岸雪花初白，一夜林霜叶尽红。",
        "山叠楚天云压塞，浪遥吴苑水连空。",
        "悠然旅榜频回首，无复松窗半偈同。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 280611,
      "title": "题中南佛塔寺",
      "content": [
        "鸣泉隔翠微，千里到柴扉。",
        "地胜人无欲，林昏虎有威。",
        "涧苔侵客屦，山雪入禅衣。",
        "桂树芳阴在，还期岁晏归。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280612,
      "title": "马嵬佛寺",
      "content": [
        "荒鸡夜唱战尘深，五鼓雕舆过上林。",
        "才信倾城是真语，直教涂地始甘心。",
        "两重秦苑成千里，一炷胡香抵万金。",
        "曼倩死来无绝艺，后人谁肯惜青禽。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 280613,
      "title": "清凉寺",
      "content": [
        "黄花红树谢芳蹊，宫殿参差黛𪩘西。",
        "诗合晓窗藏雪岭，画堂秋水接蓝溪。",
        "松飘晚吹𪭢金铎，竹荫寒苔上石梯。",
        "妙迹奇名竟何在，下方烟暝草萋萋。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 280614,
      "title": "赠卢长史",
      "content": [
        "移病欲成隐，扁舟归旧居。",
        "地深新事少，官散故交疎。",
        "道直更无侣，家贫唯有书。",
        "东门烟水梦，非独为鲈鱼。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280615,
      "title": "秋日旅舍寄义山李侍御",
      "content": [
        "一水悠悠隔渭城，渭城风物近柴荆。",
        "寒蛩乍响催机杼，旅雁初来忆弟兄。",
        "自为林泉牵晓梦，不关砧杵报秋声。",
        "子虚何处堪消渴，试向文园问长卿。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 280616,
      "title": "晚坐寄友人",
      "content": [
        "九枝灯在琐窗空，希逸无聊恨不同。",
        "晓梦未离金夹膝，早寒先到石屏风。",
        "遗簪可惜三秋白，蜡烛犹残一寸红。",
        "应卷𫚥帘看皓齿，镜中惆怅见梧桐。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 280617,
      "title": "送渤海王子归本国",
      "content": [
        "疆理虽重海，车书本一家。",
        "盛勋归旧国，佳句在中华。",
        "定界分秋涨，开帆到曙霞。",
        "九门风月好，回首是天涯。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280618,
      "title": "送北阳袁明府",
      "content": [
        "楚乡千里路，君去及良晨。",
        "苇浦迎船火，茶山候吏尘。",
        "桑浓蚕卧晚，麦秀雉声春。",
        "莫作东篱兴，青云有故人。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280619,
      "title": "送李生归旧居",
      "content": [
        "一从征战后，故社几人归。",
        "薄宦离山久，高谈与世稀。",
        "夕阳当板槛，春日入柴扉。",
        "莫却严滩意，西溪有钓矶。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280620,
      "title": "早春浐水送友人",
      "content": [
        "青门烟野外，渡浐送行人。",
        "鸭卧溪沙暖，鸠鸣社树春。",
        "残波青有石，幽草绿无尘。",
        "杨柳东风里，相看泪满巾。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 280621,
      "title": "送襄州李中丞赴从事",
      "content": [
        "汉庭文采有相如，天子通宵爱子虚。",
        "把钓看棋高兴尽，焚香起草宦情疎。",
        "楚山重叠当归路，溪月分明到直庐。",
        "江雨潇潇帆一片，此行谁道为鲈鱼。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 280622,
      "title": "江上别友人",
      "content": [
        "秋色满葭菼，离人西复东。",
        "几年方暂见，一笑又难同。",
        "地势萧陵歇，江声禹庙空。",
        "如何暮滩上，千里逐征鸿。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280623,
      "title": "与友人别",
      "content": [
        "半醉别都门，含凄上古原。",
        "晚风杨叶社，寒食杏花村。",
        "薄暮牵离绪，伤春忆晤言。",
        "年芳本无限，何况有兰孙。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280624,
      "title": "鸿胪寺有开元中锡宴堂楼台池沼雅为胜绝荒凉遗址仅有存者偶成四十韵",
      "content": [
        "明皇昔御极，神圣垂耿光。",
        "沈机发雷电，逸躅陵尧汤。",
        "西覃积石山，北至穷发乡。",
        "四凶有獬豸，一臂无螳螂。",
        "婵娟得神艳，郁烈闻国香。",
        "紫绦鸣羯鼓，玉管吹霓裳。",
        "禄山未封侯，林甫才为郎。",
        "昭融廓日月，妥帖安纪纲。",
        "群生到寿域，百辟趋明堂。",
        "四海正夷宴，一尘不飞扬。",
        "天子自犹豫，侍臣宜乐康。",
        "轧然阊阖开，赤日生扶桑。",
        "玉砌露盘纡，金壶漏丁当。",
        "劒佩相击触，左右随趋跄。",
        "玄珠十二旒，红粉三千行。",
        "顾盻生羽翼，叱嗟廻雪霜。",
        "神霞凌云阁，春水骊山阳。",
        "盘鬬九子糭，瓯擎五云浆。",
        "双琼京兆博，七鼓邯郸娼。",
        "毰毸碧鸡鬬，茏葱翠雉场。",
        "杖官绣蔽膝，宝马金镂锡。",
        "椒涂隔鹦鹉，柘弹惊鸳鸯。",
        "猗欤华国臣，鬓髪俱苍苍。",
        "锡宴得幽致，车从真炜煌。",
        "画鹢照鱼鼈，鸣驺乱鹙鸧。",
        "飐滟荡碧波，炫煌迷横塘。",
        "萦盈舞廻雪，宛转歌遶梁。",
        "艳带画银络，宝梳金钿筐。",
        "沈冥类汉相，醉倒疑楚狂。",
        "一旦紫微东，胡星森耀芒。",
        "凭陵逐鲸鲵，唐突驱犬羊。",
        "纵火三月赤，战尘千里黄。",
        "殽函与府寺，从此俱荒凉。",
        "兹地乃蔓草，故基摧坏墙。",
        "枯池接断岸，唧唧啼寒螀。",
        "败荷塌作泥，死竹森如枪。",
        "游人问老吏，相对聊感伤。",
        "岂必见麋鹿，然后堪回肠。",
        "幸今遇太平，令节称羽觞。",
        "谁知曲江曲，岁岁栖鸾凰。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 280625,
      "title": "访知玄上人遇暴经因有赠",
      "content": [
        "缥帙无尘满画廊，钟山弟子静焚香。",
        "惠能未肯传心法，张湛徒劳与眼方。",
        "风飏檀烟销篆印，日移松影过禅床。",
        "客儿自有翻经处，江上秋来蕙草荒。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 280626,
      "title": "寄崔先生",
      "content": [
        "往年江海别元卿，家近山阳古郡城。",
        "莲浦香中离席散，柳堤风里钓船横。",
        "星霜荏苒无音信，烟水微茫变姓名。",
        "菰黍正肥鱼正美，五侯门下负平生。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 280627,
      "title": "敬荅李先生",
      "content": [
        "七里滩声舜庙前，杏花初盛草芊芊。",
        "绿昏晴气春风岸，红漾轻纶野水天。",
        "不为伤离成极望，更因行乐惜流年。",
        "一瓢无事麛裘暖，手弄溪波坐钓船。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 280628,
      "title": "宿沣曲僧舍",
      "content": [
        "东郊和气新，芳霭远如尘。",
        "客舍停疲马，僧墙画故人。",
        "沃田桑景晚，平野菜花春。",
        "更想严家濑，微风荡白苹。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280629,
      "title": "宿一公精舍",
      "content": [
        "夜阑黄叶寺，瓶锡两俱能。",
        "松下石桥路，雨中山殿灯。",
        "茶炉天姥客，棋席剡溪僧。",
        "还笑长门赋，高秋卧茂陵。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280630,
      "title": "月中宿云居寺上方",
      "content": [
        "虚合披衣坐，寒堦踏叶行。",
        "众星中夜少，圆月上方明。",
        "霭尽无林色，喧余有涧声。",
        "祗应愁恨事，还逐晓光生。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280631,
      "title": "登卢氏台",
      "content": [
        "胜地当通邑，前山有故居。",
        "台高秋尽出，林断野无余。",
        "白露鸣蛩急，晴天度雁疎。",
        "由来放怀地，非独在吾庐。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280632,
      "title": "牡丹二首 一",
      "content": [
        "轻阴隔翠帏，宿雨泣晴晖。",
        "醉后佳期在，歌余旧意非。",
        "蝶繁经粉住，蜂重抱香归。",
        "莫惜薰炉夜，因风到舞衣。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280633,
      "title": "牡丹二首 二",
      "content": [
        "水漾晴红压叠波，晓来金粉覆庭莎。",
        "裁成艳思偏应巧，分得春光最数多。",
        "欲绽似含双靥笑，正繁疑有一声歌。",
        "华堂客散帘垂地，想凭阑干歛翠蛾。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 280634,
      "title": "反生桃花发因题",
      "content": [
        "疾眼逢春四壁空，夜来山雪破东风。",
        "未知王母千年熟，且共刘郎一笑同。",
        "已落又开横晚翠，似无如有带朝红。",
        "僧虔蜡炬高三尺，莫惜连宵照露丛。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 280635,
      "title": "杏花",
      "content": [
        "红花初绽雪花繁，重叠高低满小园。",
        "正见盛时犹怅望，岂堪开处已缤翻。",
        "情为世累诗千首，醉是吾乡酒一樽。",
        "杳杳艳歌春日午，出墙何处隔朱门。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 280636,
      "title": "和太常杜少卿东都修[行]里有嘉莲",
      "content": [
        "春秋罢注直铜龙，旧宅嘉莲照水红。",
        "两处龟巢清露里，一时鱼跃翠茎东。",
        "同心表瑞荀池上，半面分妆乐镜中。",
        "应为临川多丽句，故持重艳向西风。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 280637,
      "title": "题磁岭海棠花",
      "content": [
        "幽态竟谁赏，岁华空与期。",
        "岛回香尽处，泉照艳浓时。",
        "蜀彩淡摇曳，吴妆低怨思。",
        "王孙又谁恨，惆怅下山迟。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280638,
      "title": "苦楝花",
      "content": [
        "院里莺歌歇，墙头蝶舞孤。",
        "天香薰羽葆，宫紫晕流苏。",
        "晻暧迷青琐，氤氲向画图。",
        "只应春惜别，留与博山炉。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280639,
      "title": "自有扈至京师已后朱樱之期",
      "content": [
        "露圆霞赤数千枝，银笼谁家寄所思。",
        "秦苑飞禽谙熟早，杜陵游客恨来迟。",
        "空看翠幄成阴日，不见红珠满树时。",
        "尽日徘徊浓影下，祗应重作钓鱼期。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 280640,
      "title": "答段柯古见嘲",
      "content": [
        "彩翰殊翁金缭绕，一千二百逃飞鸟。",
        "尾薪桥下未为痴，暮雨朝云世间少。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 280641,
      "title": "莲花",
      "content": [
        "绿塘摇滟接星津，轧轧兰桡入白苹。",
        "应为洛神波上韈，至今莲蘂有香尘。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 280642,
      "title": "过吴景帝陵",
      "content": [
        "王气销来水淼茫，岂能才与命相妨。",
        "虚开直渎三千里，青盖何曾到洛阳。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 280643,
      "title": "龙尾驿妇人图",
      "content": [
        "慢笑开元有幸臣，直教天子到蒙尘。",
        "今来看画犹如此，何况亲逢绝世人。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 280644,
      "title": "薛氏池垂钓",
      "content": [
        "池塘经雨更苍苍，万点荷珠晓气凉。",
        "朱瑀空偷御沟水，锦鳞红尾属严光。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 280645,
      "title": "简同志",
      "content": [
        "开济由来变盛衰，五车才得号镃基。",
        "留侯功业何容易，一卷兵书作帝师。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 280646,
      "title": "瑟瑟钗",
      "content": [
        "翠染冰轻透露光，堕云孙寿有余香。",
        "只因七夕回天浪，添作湘妃泪两行。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 280647,
      "title": "元日",
      "content": [
        "神耀破氛昏，新阳入晏温。",
        "绪风调玉吹，端日应铜浑。",
        "威凤跄瑶簴，升龙护璧门。",
        "雨旸春令煦，裘冕晬容尊。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280648,
      "title": "二月十五日樱桃盛开自所居蹑履吟翫竞名王泽章洋才",
      "content": [
        "晓觉笼烟重，春深染雪轻。",
        "静应留得蝶，繁欲不胜莺。",
        "影乱晨飙急，香多夜雨晴。",
        "似将千万恨，西北为卿卿。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280649,
      "title": "寒食节日寄楚望二首 一",
      "content": [
        "芳兰无意绿，弱柳何穷缕。",
        "心断入淮山，梦长穿楚雨。",
        "繁花如二八，好月当三五。",
        "愁碧竟平臯，韶红换幽圃。",
        "流莺隐员树，乳燕喧余哺。",
        "旷望恋曾台，离忧集环堵。",
        "当年不自遣，晚得终何补。",
        "郑谷有樵苏，归来要腰斧。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 280650,
      "title": "寒食节日寄楚望二首 二",
      "content": [
        "家乏两千万，时当一百五。",
        "飔飔杨柳风，穰穰樱桃雨。",
        "年芳苦沈潦，心事如摧橹。",
        "金犊近兰汀，铜龙接花坞。",
        "青葱建杨宅，隐辚端门鼓。",
        "彩素拂庭柯，轻毬落邻圃。",
        "三春谢游衍，一笑牵规矩。",
        "独有恩泽侯，归来看楚舞。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 280651,
      "title": "清明日",
      "content": [
        "清娥画扇中，春树郁金红。",
        "出犯繁花露，归穿弱柳风。",
        "马骄偏避幰，鸡骇乍开笼。",
        "柘弹何人发，黄鹂隔故宫。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280652,
      "title": "禁火日",
      "content": [
        "骀荡清明日，储胥小苑东。",
        "舞衫萱草绿，春鬓杏花红。",
        "马辔轻衔雪，车衣弱向风。",
        "□愁闻百舌，残睡正朦胧。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280653,
      "title": "嘲三月十八日雪",
      "content": [
        "三月雪连夜，未应伤物华。",
        "只缘春欲尽，留著伴梨花。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 280654,
      "title": "杨柳八首 一",
      "content": [
        "宜春苑外最长条。",
        "闲褭春风伴舞腰，正是玉人肠断处。",
        "一渠春水赤阑桥。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 280655,
      "title": "杨柳八首 二",
      "content": [
        "南内墙东御路旁，预知春色柳丝黄。",
        "杏花未肯无情思，何是情人最断肠。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 280656,
      "title": "杨柳八首 三",
      "content": [
        "苏小门前柳万条，毶毶金线拂平桥。",
        "黄莺不语东风起，深闭朱门伴细腰。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 280657,
      "title": "杨柳八首 四",
      "content": [
        "金缕毶毶碧瓦沟，六宫眉黛惹春愁。",
        "晚来更带龙池雨，半拂阑干半入楼。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 280658,
      "title": "杨柳八首 五",
      "content": [
        "馆娃宫外邺城西，远映征帆近拂堤。",
        "系得王孙归意切，不关春草绿萋萋。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 280659,
      "title": "杨柳八首 六",
      "content": [
        "两两黄鹂色似金，褭枝啼露动芳音。",
        "春来幸自长如线，可惜牵缠荡子心。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 280660,
      "title": "杨柳八首 七",
      "content": [
        "御柳如丝映九重，凤皇窗柱绣芙蓉。",
        "景阳楼畔千条露，一面新妆待晓钟。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 280661,
      "title": "杨柳八首 八",
      "content": [
        "织锦机边莺语频，停梭垂泪忆征人。",
        "塞门三月犹萧索，纵有垂杨未觉春。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 280662,
      "title": "客愁",
      "content": [
        "客愁看柳色，日日逐春深。",
        "荡漾春风里，谁知历乱心。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 280663,
      "title": "和周繇",
      "content": [
        "齐马驰千驷，卢姬逞十三。",
        "玳筵方喜睐，金勒自𫎺𧽼。",
        "堕珥情初洽，鸣鞭战未酣。",
        "神交花冉冉，眉语柳毶毶。",
        "却略青鸾镜，翘翻翠凤𥮾。",
        "专城有佳对，宁肯顾春蚕。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 280664,
      "title": "光风亭夜宴妓有醉殴者",
      "content": [
        "吴国初成阵，王家欲解围。",
        "拂巾双雉呌，飘瓦两鸳飞。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 280665,
      "title": "南歌子词二首 一",
      "content": [
        "一尺深红胜曲尘，天生旧物不如新。",
        "合欢桃核终堪恨，里许元来别有人。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 280666,
      "title": "南歌子词二首 二",
      "content": [
        "井底点灯深烛伊，共郎长行莫围棋。",
        "玲珑骰子安红豆，入骨相思知不知。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 280667,
      "title": "题李卫公诗二首 一",
      "content": [
        "蒿棘深春卫国门，九年于此盗乾坤。",
        "两行密疏倾天下，一夜阴谋达至尊。",
        "肉视具僚忘匕箸，气吞同列削寒温。",
        "当时谁是承恩者，肯有余波达鬼邨。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 280668,
      "title": "题李卫公诗二首 二",
      "content": [
        "势欲凌云威触天，权倾诸夏力排山。",
        "三年骥尾有人附，一日龙须无路攀。",
        "画合不开梁燕去，朱门罢埽乳鸦还。",
        "千岩万壑应惆怅，流水斜倾出武关。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 280669,
      "title": "题谷隐兰若",
      "content": [
        "风带巢熊拗树声，老僧相引入云行。",
        "半坡新路畬才了，一谷寒烟烧不成。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 280670,
      "title": "观棋",
      "content": [
        "闲对楸枰倾一壶，黄华坪上几成卢。",
        "他时谒帝铜龙水，便赌宣城太守无。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 280671,
      "title": "句",
      "content": [
        "春水碧于天，画船听雨眠。",
        "绿树遶村含细雨，寒潮背郭卷平沙。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 297565,
      "title": "戏令狐相",
      "content": [
        "自从元老登庸后，天下诸胡悉带铃。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298419,
      "title": "南歌子 一",
      "content": [
        "手里金鹦鹉，胸前绣凤凰。",
        "偷眼暗形相。",
        "不如从嫁与，作鸳鸯。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298420,
      "title": "南歌子 二",
      "content": [
        "似带如丝柳，团酥握雪花。",
        "帘卷玉钩斜。",
        "九衢尘欲暮，逐香车。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298421,
      "title": "南歌子 三",
      "content": [
        "倭堕低梳髻，连娟细扫眉。",
        "终日两相思。",
        "为君憔悴尽，百花时。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298422,
      "title": "南歌子 四",
      "content": [
        "脸上金霞细，眉间翠钿深。",
        "欹枕覆鸳衾。",
        "隔帘鸎百转，感君心。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298423,
      "title": "南歌子 五",
      "content": [
        "扑蘂添黄子，呵花满翠鬟。",
        "鸳枕映屏山。",
        "月明三五夜，对芳颜。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298424,
      "title": "南歌子 六",
      "content": [
        "转盼如波眼，娉婷似柳腰。",
        "花里暗相招。",
        "忆君肠欲断，恨春宵。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298425,
      "title": "南歌子 七",
      "content": [
        "嬾拂鸳鸯枕，休缝翡翠裙。",
        "罗帐罢炉熏。",
        "近来心更切，为思君。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298426,
      "title": "荷叶杯 一",
      "content": [
        "一点露珠凝冷，波影，满池塘。",
        "绿茎红艳两相乱，肠断，水风凉。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298427,
      "title": "荷叶杯 二",
      "content": [
        "镜水夜来秋月，如雪，采莲时。",
        "小娘红粉对寒浪，惆怅，正思惟。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298428,
      "title": "荷叶杯 三",
      "content": [
        "楚女欲归南浦，朝雨，湿愁红。",
        "小船摇漾入花里，波起，隔西风。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298429,
      "title": "忆江南 一",
      "content": [
        "千万恨，恨极在天涯。",
        "山月不知心里事，水风空落眼前花，摇曳碧云斜。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 298430,
      "title": "忆江南 二",
      "content": [
        "梳洗罢，独倚望江楼。",
        "过尽千帆皆不是，斜晖脉脉水悠悠，肠断白苹洲。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 298431,
      "title": "蕃女怨 一",
      "content": [
        "万枝香雪开已遍，细雨双燕。",
        "钿蝉筝，金雀扇，画梁相见。",
        "鴈门消息不归来，又飞回。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298432,
      "title": "蕃女怨 二",
      "content": [
        "碛南沙上惊鴈起，飞雪千里。",
        "玉连环，金镞箭，年年征战。",
        "画楼离恨锦屏空，杏花红。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298433,
      "title": "遐方怨 一",
      "content": [
        "凭绣槛，解罗帏。",
        "未得君书，断肠潇湘春鴈飞。",
        "不知征马几时归。",
        "海棠花谢也，雨霏霏。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298434,
      "title": "遐方怨 二",
      "content": [
        "花半拆，雨初晴。",
        "未卷珠帘，梦残惆怅闻晓鸎。",
        "宿妆眉浅粉山横。",
        "约鬟鸾镜里，绣罗轻。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298435,
      "title": "诉衷情",
      "content": [
        "鸎语，花舞，春昼午，雨霏微。",
        "金带枕，宫锦，凤凰帷。",
        "柳弱燕交飞，依依。",
        "辽阳音信稀，梦中归。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298436,
      "title": "定西番 一",
      "content": [
        "汉使昔年离别，攀弱柳，折寒梅，上高台。",
        "千里玉关春雪，鴈来人不来。",
        "羌笛一声愁绝，月裴回。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298437,
      "title": "定西番 二",
      "content": [
        "海燕欲飞调羽，萱草绿，杏花红，隔帘栊。",
        "双鬓翠霞金缕，一枝春艳浓。",
        "楼上月明三五，琐窗中。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298438,
      "title": "定西番 三",
      "content": [
        "细雨晓鸎春晚，人似玉，柳如眉，正相思。",
        "罗幕翠帘初卷，镜中花一枝。",
        "肠断塞门消息，鴈来稀。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298439,
      "title": "思帝乡",
      "content": [
        "花花，满枝红似霞。",
        "罗袖画帘肠断，卓香车。",
        "回面共人闲语，战箆金凤斜。",
        "惟有阮郎春尽，不归家。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298440,
      "title": "酒泉子 一",
      "content": [
        "花映柳条，闲向绿萍池上。",
        "凭栏干，窥细浪，雨萧萧。",
        "近来音信两疎索，洞房空寂寞。",
        "掩银屏，垂翠箔，度春宵。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298441,
      "title": "酒泉子 二",
      "content": [
        "日映纱窗，金鸭小屏山碧。",
        "故乡春，烟霭隔，背兰釭。",
        "宿妆惆怅倚高阁，千里云影薄。",
        "草初齐，花又落，燕双飞。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298442,
      "title": "酒泉子 三",
      "content": [
        "楚女不归，楼枕小河春水。",
        "月孤明，风又起，杏花稀。",
        "玉钗斜𥮾云鬟重，裙上金缕凤。",
        "八行书，千里梦，鴈南飞。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298443,
      "title": "酒泉子 四",
      "content": [
        "罗带惹香，犹系别时红豆。",
        "泪痕新，金缕旧，断离肠。",
        "一双娇燕语雕梁，还是去年时节。",
        "绿杨浓，芳草歇，柳花狂。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298444,
      "title": "玉蝴蝶",
      "content": [
        "秋风凄切伤离，行客未归时。",
        "塞外草先衰，江南鴈到迟。",
        "芙蓉凋嫩脸，杨柳堕新眉。",
        "摇落使人悲，断肠谁得知。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298445,
      "title": "女冠子 一",
      "content": [
        "含娇含笑，宿翠残红窈窕，鬓如蝉。",
        "寒玉簪秋水，轻纱卷碧烟。",
        "雪胸鸾镜里，琪树凤楼前。",
        "寄语青娥伴，早求仙。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298446,
      "title": "女冠子 二",
      "content": [
        "霞帔云发，钿镜仙容似雪，画愁眉。",
        "遮语回轻扇，含羞下绣帏。",
        "玉楼相望久，花洞恨来迟。",
        "早晚乘鸾去，莫相遗。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298447,
      "title": "归国遥 一",
      "content": [
        "香玉，翠凤宝钗垂{罒/录}𦌉，钿筐交胜金粟，越罗春水绿。",
        "画堂照帘残烛，梦余更漏促。",
        "谢娘无限心曲，晓屏山断续。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298448,
      "title": "归国遥 二",
      "content": [
        "双脸，小凤战箆金飐艳，舞衣无力风歛，藕丝秋色染。",
        "锦帐绣帏斜掩，露珠清晓簟。",
        "粉心黄蘂花靥，黛眉山两点。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298449,
      "title": "菩萨蛮 一",
      "content": [
        "小山重叠金明灭，鬓云欲度香顋雪。",
        "嬾起画蛾眉，弄妆梳洗迟。",
        "照花前后镜，花面交相映。",
        "新帖绣罗襦，双双金鹧鸪。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298450,
      "title": "菩萨蛮 二",
      "content": [
        "水精帘里颇黎枕，暖香惹梦鸳鸯锦。",
        "江上柳如烟，鴈飞残月天。",
        "藕丝秋色浅，人胜参差翦。",
        "双鬓隔香红，玉钗头上风。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298451,
      "title": "菩萨蛮 三",
      "content": [
        "蘂黄无限当山额，宿妆隐笑纱窗隔。",
        "相见牡丹时，暂来还别离。",
        "翠钗金作股，钗上蝶双舞。",
        "心事竟谁知，月明花满枝。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298452,
      "title": "菩萨蛮 四",
      "content": [
        "翠翘金缕双㶉𫛶，水文细起春池碧。",
        "池上海棠梨，雨晴红满枝。",
        "绣衫遮笑靥，烟草黏飞蝶。",
        "青琐对芳菲，玉关音信稀。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298453,
      "title": "菩萨蛮 五",
      "content": [
        "杏花含露团香雪，绿杨陌上多离别。",
        "灯在月胧明，觉来闻晓鸎。",
        "玉钩褰翠幕，妆浅旧眉薄。",
        "春梦正关情，镜中蝉鬓轻。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
