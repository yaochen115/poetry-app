{
  "data": [
    {
      "id": 249286,
      "title": "泛宅",
      "content": [
        "芗林新赐宅，春水向鸥前。",
        "不是萧何第，元非范蠡船。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 249287,
      "title": "上饶方君小倅官而不婚宦居偏户间静无官宦之事舍后梯城而上即棚为亭尽得溪山之胜名之曰快哉为作四小诗以快哉此风为韵  其一",
      "content": [
        "簿书苦沈迷，世俗嗟迫隘。",
        "不如溪山上，风至取一快。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 249288,
      "title": "上饶方君小倅官而不婚宦居偏户间静无官宦之事舍后梯城而上即棚为亭尽得溪山之胜名之曰快哉为作四小诗以快哉此风为韵  其二",
      "content": [
        "掾曹官事了，载取曲生来。",
        "得酒且欢喜，俗氛安在哉。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 249289,
      "title": "上饶方君小倅官而不婚宦居偏户间静无官宦之事舍后梯城而上即棚为亭尽得溪山之胜名之曰快哉为作四小诗以快哉此风为韵  其三",
      "content": [
        "从容吏隐间，游戏僧俗里。",
        "孤月浪中翻，吾心正如此。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 249290,
      "title": "上饶方君小倅官而不婚宦居偏户间静无官宦之事舍后梯城而上即棚为亭尽得溪山之胜名之曰快哉为作四小诗以快哉此风为韵  其四",
      "content": [
        "偪仄何偪仄，官居尘土中。",
        "高城与隔尽，惟有一溪风。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 249291,
      "title": "遗直堂  其一",
      "content": [
        "三孔吾渭阳，犹及见仲叔。",
        "堂堂舍人公，再拜但乔木。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 249292,
      "title": "遗直堂  其二",
      "content": [
        "长身一庭中，劲气九霄上。",
        "思公立朝时，澟澟不可向。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 249293,
      "title": "遗直堂  其三",
      "content": [
        "策登董相科，赋作长卿语。",
        "刘牢出外甥，愧我不如古。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 249294,
      "title": "遗直堂  其四",
      "content": [
        "老柏蜀人爱，甘棠召南思。",
        "领客清樾下，作诗咏歌之。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 249295,
      "title": "遗直堂  其五",
      "content": [
        "元祐几阅歳，诸公一无遗。",
        "吾舅典型在，神明力扶持。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 249296,
      "title": "遗直堂  其六",
      "content": [
        "柏叶松其身，在时公手植。",
        "杂树谁所栽，一钱初不直。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 249297,
      "title": "同官皆和复次韵  其一",
      "content": [
        "苍官可长雄，余子皆季叔。",
        "所以吾外家，深栽后雕木。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 249298,
      "title": "同官皆和复次韵  其二",
      "content": [
        "高标何许看，小阁有时上。",
        "烈风知人怀，柯叶尽西向。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 249299,
      "title": "同官皆和复次韵  其三",
      "content": [
        "孔父昔所游，父老不能语。",
        "文章翠珉上，如此树高古。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 249300,
      "title": "同官皆和复次韵  其四",
      "content": [
        "寂寞西州路，凄凉渭阳思。",
        "敢不酷似舅，苍官实临之。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 249301,
      "title": "同官皆和复次韵  其五",
      "content": [
        "大厦要直木，郢斤弃如遗。",
        "一朝谏省上，王魏不支持。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 249302,
      "title": "同官皆和复次韵  其六",
      "content": [
        "华屋落山丘，悲歌咏曹植。",
        "故有主林神，百年依正直。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 249303,
      "title": "玉井",
      "content": [
        "茗饮贵石泉，江流亦其亚。",
        "甘寒如此井，未肯出汝下。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 249304,
      "title": "碧芦潨",
      "content": [
        "春风桃李蹊，学语鸟相唤。",
        "不可无寒芦，汀洲下凫雁。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 249305,
      "title": "通幽花径",
      "content": [
        "一径夹青葱，无人到幽处。",
        "花发晓莺啼，欣然得佳趣。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 249306,
      "title": "虎川",
      "content": [
        "啸壑有於菟，吹波作奇字。",
        "川上雪髯翁，文章政相似。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 249307,
      "title": "放鱼矶",
      "content": [
        "一丝公不挂，钓饵也怜渠。",
        "旧日垂竿地，临流只放鱼。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 249308,
      "title": "三老亭",
      "content": [
        "华髪累朝人，苍髯几时树。",
        "政恐郢斤寻，明堂要材具。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 249309,
      "title": "题摘蔬亭",
      "content": [
        "幽畦小雨余，一一锦绣段。",
        "春日细春盘，悬知咄嗟办。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 249310,
      "title": "题退轩",
      "content": [
        "求名恐颠隮，求道戒进取。",
        "谁知郤行人，可以超万古。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 249311,
      "title": "题无热轩",
      "content": [
        "一溪乔木阴，六月火云冷。",
        "门外有行人，寒泉思汲井。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 249312,
      "title": "寄轩",
      "content": [
        "人皆爱吾庐，烛理均是寓。",
        "未办山林居，聊依佛僧住。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 249313,
      "title": "企疏堂",
      "content": [
        "芗林未置身，泛宅先入手。",
        "二疏归来时，能似今日否。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 249314,
      "title": "羃翠庭",
      "content": [
        "群木上参天，清阴并为一。",
        "炎曦无路来，不废风月入。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 249315,
      "title": "醉石",
      "content": [
        "冷石磨青瑶，客至相与饮。",
        "醉倒不用扶，真成一高枕。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 249316,
      "title": "墨坳",
      "content": [
        "有水碧于天，玄云滃然起。",
        "定是临池人，一沐管城子。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 249317,
      "title": "驾月桥",
      "content": [
        "伐木梁清浅，扶藤日几回。",
        "嫦娥与牛女，昔日度桥来。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 249318,
      "title": "过花桥",
      "content": [
        "溶溶水拍隄，了了花隔岸。",
        "不著小桥通，令人方寸乱。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 249319,
      "title": "归来桥",
      "content": [
        "安车过桥时，童稚皆喜舞。",
        "题柱作归来，元无长卿语。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 249320,
      "title": "廿一兄以手和四清香见饷用心清闻妙香为韵成五小诗  其一",
      "content": [
        "微雨久逾润，禅房低复深。",
        "下帷香一缕，收尽向来心。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 249321,
      "title": "廿一兄以手和四清香见饷用心清闻妙香为韵成五小诗  其二",
      "content": [
        "花覆春风殿，炉薫上紫清。",
        "旧时香案吏，趺坐对烟明。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 249322,
      "title": "廿一兄以手和四清香见饷用心清闻妙香为韵成五小诗  其三",
      "content": [
        "不属蔚宗传，又非知见薰。",
        "从来香一瓣，只许自闻闻。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 249323,
      "title": "廿一兄以手和四清香见饷用心清闻妙香为韵成五小诗  其四",
      "content": [
        "拟去竹坞间，煎茶炷新料。",
        "从容二士谈，领会一语妙。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 249324,
      "title": "廿一兄以手和四清香见饷用心清闻妙香为韵成五小诗  其五",
      "content": [
        "老柏参深水，封题远寄将。",
        "发奁知长者，闭合自调香。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 249325,
      "title": "李商叟秀才求斋名于王元渤以养源名之求诗  其一",
      "content": [
        "自古词林枝叶，皆从根柢中来。",
        "万卷须窥藏室，一尘莫点灵台。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 249326,
      "title": "李商叟秀才求斋名于王元渤以养源名之求诗  其二",
      "content": [
        "老杜诗家初祖，涪翁句法曹溪。",
        "尙论渊源师友，他时派列江西。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 249327,
      "title": "李商叟秀才求斋名于王元渤以养源名之求诗  其三",
      "content": [
        "学问直须富有，文章政要深藏。",
        "玉在山中辉润，兰生林下芬芳。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 249328,
      "title": "广南韩公圭舶使致龙涎香三种数珠一串戏赠  其一",
      "content": [
        "千里传闻陆凯，一枝远寄梅花。",
        "虎节无烦驿使，龙涎走送寒家。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 249329,
      "title": "广南韩公圭舶使致龙涎香三种数珠一串戏赠  其二",
      "content": [
        "花气薫肌郁郁，贯珠入手累累。",
        "想见范公和处，绝胜乃祖偷时。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 249330,
      "title": "黄嗣深尚书自仰山来惠茶及竹薰炉",
      "content": [
        "茗椀中超舌界，薫炉上悟香尘。",
        "坐我集云峰顶，对公小释迦身。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 249331,
      "title": "黄嗣深尚书见访",
      "content": [
        "骑气初占客至，履声忽报公来。",
        "不乱空庭鸟雀，何妨满席尘埃。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 249332,
      "title": "乞梅曾宏甫二首  其一",
      "content": [
        "寻梅不惜上南坡，傍险冲泥奈老何。",
        "寂寞僧窗禅榻畔，好枝还解送人么。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 249333,
      "title": "乞梅曾宏甫二首  其二",
      "content": [
        "腊前腊后无非雪，溪北溪南并是梅。",
        "知有家山难觅路，敢烦健步送春来。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 249334,
      "title": "觅梅",
      "content": [
        "欲寻梅去不禁寒，宜著书签研滴间。",
        "闻道南坡开似雪，略分疏影到茶山。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 249335,
      "title": "消梅花",
      "content": [
        "未见枝间著子初，闻名已疗渴相如。",
        "花肌自是冰和雪，那得生儿不似渠。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 249336,
      "title": "黄香梅",
      "content": [
        "雪里何人作道装，冰绡重叠色鹅黄。",
        "染时定著蔷薇露，雨洗风吹故自香。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 249337,
      "title": "寻梅至杨家见数株盛开",
      "content": [
        "芒鞋竹杖寻梅去，只有香来未见花。",
        "村北村南行欲徧，数株如雪小民家。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 249338,
      "title": "落梅",
      "content": [
        "玉颊香肌委尘土，雪魄冰魂无处所。",
        "一年春事顿成空，不必飘零似红雨。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 249339,
      "title": "墨竹梅",
      "content": [
        "的皪江梅竹外枝，能将幻法转生机。",
        "凭君莫作风垂绿，便恐飘零学雪飞。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 249340,
      "title": "水芭蕉",
      "content": [
        "寒泉中有小峥嵘，种得芭蕉积渐成。",
        "一叶似抽人不见，坐窗头白眼犹明。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 249341,
      "title": "郑侍郎家瑞香花盛开而未赏戏赠二首  其一",
      "content": [
        "瑞香花发去年枝，惬对君家白玉池。",
        "复幕重帘开欲徧，馨香少有外人知。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 249342,
      "title": "郑侍郎家瑞香花盛开而未赏戏赠二首  其二",
      "content": [
        "移春小槛绿樽前，记得花头数尺圆。",
        "传语郑荘修故事，锦薰笼畔过年年。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 249343,
      "title": "诸公次韵予复次韵二首  其一",
      "content": [
        "琐琐红英密缀枝，春风春物不差池。",
        "诸君但办樽前去，昨夜灯花报客知。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 249344,
      "title": "诸公次韵予复次韵二首  其二",
      "content": [
        "梅花过后杏花前，嫩蕊装成一盖圆。",
        "恼乱春风为渠了，幽香破睡有明年。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 249345,
      "title": "曾宏甫见过因问讯鞓红花则云已落矣惊呼之余戏成三首  其一",
      "content": [
        "茶山老子竟成痴，漫说寻芳去不迟。",
        "浪蕊飘残犹自可，名花落尽不曾知。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 249346,
      "title": "曾宏甫见过因问讯鞓红花则云已落矣惊呼之余戏成三首  其二",
      "content": [
        "不令老眼看鞓红，岂是青春不负公。",
        "尚有扬州风物在，亦防此段并成空。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 249347,
      "title": "曾宏甫见过因问讯鞓红花则云已落矣惊呼之余戏成三首  其三",
      "content": [
        "南渡年来两鬓霜，牡丹芍药但他乡。",
        "即从江水浮淮水，便上维扬向洛阳。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 249348,
      "title": "置酒签厅观荷徐判官携家酿四首  其一",
      "content": [
        "绿水波深欲上堦，红蕖香动要传杯。",
        "幕中自有两佳客，又载青州从事来。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 249349,
      "title": "置酒签厅观荷徐判官携家酿四首  其二",
      "content": [
        "鄣日青圆自拥堦，绉风绿净可添杯。",
        "被花恼处君知否，罗袜凌波笑不来。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 249350,
      "title": "置酒签厅观荷徐判官携家酿四首  其三",
      "content": [
        "白白红红花映堦，高高下下叶成杯。",
        "娇娆似不禁长夏，故就团𪢮扇影来。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 249351,
      "title": "置酒签厅观荷徐判官携家酿四首  其四",
      "content": [
        "休看红药咏翻堦，极目荷花照酒杯。",
        "静濯明妆何所待，风标公子远飞来。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 249352,
      "title": "谢送蜡梅二首  其一",
      "content": [
        "天将何物染江梅，白玉花成栗玉开。",
        "一种暗香全似旧，小罂和雪送春来。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 249353,
      "title": "谢送蜡梅二首  其二",
      "content": [
        "化工团蜡作寒梅，绝胜牛酥点滴开。",
        "不是前村深雪里，蜜蜂应认暗香来。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 249354,
      "title": "郑侍郎送蜡梅次韵三首  其一",
      "content": [
        "折来梅与句争清，强和余音本不能。",
        "欲向都官论一字，略无佳处似诗僧。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 249355,
      "title": "郑侍郎送蜡梅次韵三首  其二",
      "content": [
        "小瓶梅映短檠灯，幽兴何人似我能。",
        "枉沐歌词无用处，维摩诘是在家僧。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 249356,
      "title": "郑侍郎送蜡梅次韵三首  其三",
      "content": [
        "江梅难以蜡妆成，女手虽工未必能。",
        "香气恼人眠不著，若为学得定中僧。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 249357,
      "title": "曾宏甫饷溪山堂南坡胯新茶",
      "content": [
        "溪山宝胯能分我，不但禅房破睡魔。",
        "便觉胸中有丘壑，免教辛苦上南坡。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 249358,
      "title": "衢僧送新茶",
      "content": [
        "斋肠得饱又逐去，午梦欲成还唤回。",
        "定是僧家不堪此，满匳青箬送春来。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 249359,
      "title": "绍兴帅相公遗小春新茶且折简云对瑞香啜之大胜暖帐中饮羔儿酒也小诗两绝以谢  其一",
      "content": [
        "打门将军得人惊，十月茶牙照眼明。",
        "漏泄春光凌雪色，柳条萱草太迟生。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 249360,
      "title": "绍兴帅相公遗小春新茶且折简云对瑞香啜之大胜暖帐中饮羔儿酒也小诗两绝以谢  其二",
      "content": [
        "酒压羔儿雪煮茶，红罗斗帐锦笼花。",
        "中书堂上权衡手，小物勤公定等差。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 249361,
      "title": "啜建溪新茗李文授有二绝句次韵  其一",
      "content": [
        "北焙今年但取陈，草芽过了二分春。",
        "为君湔洗丁坑后，宝胯云团一样新。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 249362,
      "title": "啜建溪新茗李文授有二绝句次韵  其二",
      "content": [
        "壑源今日为君倾，可当杯盘泻浊清。",
        "未到舌根先一笑，风炉石鼎雨来声。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 249363,
      "title": "谢宜春宰黄时举惠冬笋二首  其一",
      "content": [
        "此君老去犹停雪，稚子生来亦耐寒。",
        "记得长蔬山谷老，三珍错落粲同盘。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 249364,
      "title": "谢宜春宰黄时举惠冬笋二首  其二",
      "content": [
        "竹底春从雪底归，烦君抱送玉婴儿。",
        "白头无复迎船喜，只供江鱼作许悲。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 249365,
      "title": "谢路宪送蟹",
      "content": [
        "从来叹赏内黄侯，风味尊前第一流。",
        "秖合蹒跚赴汤鼎，不须辛苦上糟丘。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 249366,
      "title": "食淮白鱼二首  其一",
      "content": [
        "十年不踏盱眙路，想见长淮属玉飞。",
        "安得玻瓈泉上酒，藉糟空有白鱼肥。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 249367,
      "title": "食淮白鱼二首  其二",
      "content": [
        "帝所三江带五湖，古来修贡有淮鱼。",
        "上方无复𧏖珠事，玉食光辉郤要渠。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 249368,
      "title": "食酥二首  其一",
      "content": [
        "贡包分自浙西东，函谷金城在眼中。",
        "泛酒煎茶俱惬当，满前腊雪化春风。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 249369,
      "title": "食酥二首  其二",
      "content": [
        "土酥绝类穆家儿，好著崔家饤坐梨。",
        "如梦甘寒千百颗，雪肌相伴出关西。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 249370,
      "title": "食杨梅三首  其一",
      "content": [
        "年年梅里见诸杨，火齐堆盘更有香。",
        "风味十分如荔子，何妨盛著绛纱囊。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 249371,
      "title": "食杨梅三首  其二",
      "content": [
        "一月如绳雨泻簷，只言新竹渐多添。",
        "岂知政负幽人腹，不放杨梅蜜样甜。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 249372,
      "title": "食杨梅三首  其三",
      "content": [
        "饶阳接种江南少，越上楞梅天下无。",
        "梅熟应同儿辈吃，有兄八十住东吴。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 249373,
      "title": "食牛尾貍",
      "content": [
        "生不能令鼠穴空，但为牛后亦何功。",
        "不如醉卧糟丘底，犹得声名异味中。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 249374,
      "title": "谢寄端砚四首  其一",
      "content": [
        "我居南楚君南越，遣骑持书致石泓。",
        "未识松煤先一笑，向人鸲鹆眼能明。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 249375,
      "title": "谢寄端砚四首  其二",
      "content": [
        "名声借甚端溪砚，何况珍材琢下碞。",
        "兔颖麝煤俱惬当，使君裁鉴果超凡。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 249376,
      "title": "谢寄端砚四首  其三",
      "content": [
        "治中长啸得石砚，乞与衰翁一笑开。",
        "小试松煤便终日，必知渠是下碞来。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 249377,
      "title": "谢寄端砚四首  其四",
      "content": [
        "管城子挟秋霜气，绛县人含松壑风。",
        "不是端溪石居士，分甘弃置一生中。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 249378,
      "title": "谢郑侍郎饷酒二首  其一",
      "content": [
        "尊中政尔空空然，忽有一壶来眼边。",
        "君知情快何所似，石涧怒流深夜泉。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 249379,
      "title": "谢郑侍郎饷酒二首  其二",
      "content": [
        "鸣鞭走送徒纷然，开尝政足甜中边。",
        "甘辛未省有如许，气压烂柯山下泉。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 249380,
      "title": "家酿酒乡四首  其一",
      "content": [
        "恶怀种种占胸次，俗物纷纷遮眼边。",
        "知有醉乡无路入，竹渠昨夜响山泉。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 249381,
      "title": "家酿酒乡四首  其二",
      "content": [
        "酒泉郡郭果何在，校尉兵厨安足求。",
        "即使愁城攻得破，策勋当拜醉乡侯。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 249382,
      "title": "家酿酒乡四首  其三",
      "content": [
        "醉乡即是无何有，欢伯相招归去休。",
        "全以个中为境界，更于底处觅温柔。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 249383,
      "title": "家酿酒乡四首  其四",
      "content": [
        "醉乡论石仍论斗，如此山重水复何。",
        "我觉去人殊不远，从来杯勺不能多。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 249384,
      "title": "读书四首  其一",
      "content": [
        "黄卷中人最起予，病来相对却成疏。",
        "新凉试傍青灯看，犹有飞蚊小未除。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 249385,
      "title": "读书四首  其二",
      "content": [
        "童子区区攻一艺，老生汲汲事三余。",
        "偶然领会忘言处，只有渊明解读书。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    }
  ],
