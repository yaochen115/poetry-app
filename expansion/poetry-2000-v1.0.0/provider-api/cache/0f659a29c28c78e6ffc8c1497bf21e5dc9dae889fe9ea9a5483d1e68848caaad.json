{
  "data": [
    {
      "id": 136611,
      "title": "宫词  其四",
      "content": [
        "深夜游宫玉漏迟，侵晨鶑啭上林时。",
        "无端蝶恋花心动，摇落东风第一枝。"
      ],
      "author": {
        "id": 12428,
        "name": "胡仲弓"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 162804,
      "title": "立夏",
      "content": [
        "四时天气促相催，一夜薰风带暑来。",
        "陇亩日长蒸翠麦，园林雨过熟黄梅。",
        "鶑啼春去愁千缕，蝶恋花残恨几回。",
        "睡起南窗情思倦，闲看槐荫满亭台。"
      ],
      "author": {
        "id": 4345,
        "name": "赵友直"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 198406,
      "title": "万蝶花",
      "content": [
        "谁唱残春蝶恋花，一团粉翅压枝斜。",
        "美人欲向钗头插，又恐惊飞鬓似鸦。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 298337,
      "title": "蝶恋花",
      "content": [
        "遥夜亭臯闲信步，才过清明，渐觉伤春暮。",
        "数点雨声风约住，朦胧澹月云来去。",
        "桃李依依香暗度，谁在秋千，笑里轻轻语。",
        "一片芳心千万绪，人间没个安排处。"
      ],
      "author": {
        "id": 11675,
        "name": "后主煜"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 299084,
      "title": "蝶恋花 一",
      "content": [
        "窗外寒鸡天欲曙，香印成灰，坐起浑无绪。",
        "庭际高梧凝宿雾，卷帘双鹊惊飞去。",
        "屏上罗衣闲绣缕，一晌关情，忆遍江南路。",
        "夜夜梦魂休谩语，已知前事无情处。"
      ],
      "author": {
        "id": 8353,
        "name": "冯延巳"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 299085,
      "title": "蝶恋花 二",
      "content": [
        "萧索清秋珠泪坠，枕簟微凉，展转浑无寐。",
        "残酒欲醒中夜起，月明如练天如水。",
        "堦下寒声啼络纬，庭树金风，悄悄重门闭。",
        "可惜旧欢携手地，思量一夕成憔悴。"
      ],
      "author": {
        "id": 8353,
        "name": "冯延巳"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 299086,
      "title": "蝶恋花 三",
      "content": [
        "几度凤楼同饮宴，此夕相逢，却胜当时见。",
        "低语前欢频转面，双眉歛恨春山远。",
        "蜡烛泪流羌笛怨，偷整罗衣，欲唱情犹嬾。",
        "醉里不辞金爵满，阳关一曲肠千断。"
      ],
      "author": {
        "id": 8353,
        "name": "冯延巳"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 299087,
      "title": "蝶恋花 四",
      "content": [
        "几日行云何处去，忘了归来，不道春将暮。",
        "百草千花寒食路，香车系在谁家树。",
        "泪眼倚楼频独语，双燕飞来，陌上相逢否。",
        "撩乱春愁如柳絮，悠悠梦里无寻处。"
      ],
      "author": {
        "id": 8353,
        "name": "冯延巳"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 299088,
      "title": "蝶恋花 五",
      "content": [
        "六曲阑干偎碧树，杨柳风轻，展尽黄金缕。",
        "谁把钿筝移玉柱，穿帘海燕双飞去。",
        "满眼游丝兼落絮，红杏开时，一霎清明雨。",
        "浓醉觉来莺乱语，惊残好梦无寻处。"
      ],
      "author": {
        "id": 8353,
        "name": "冯延巳"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 299089,
      "title": "蝶恋花 六",
      "content": [
        "谁道闲情抛弃久，每到春来，惆怅还依旧。",
        "日日花前常病酒，不辞镜里朱颜瘦。",
        "河畔青芜堤上柳，为问新愁，何事年年有。",
        "独立小楼风满袖，平林新月人归后。"
      ],
      "author": {
        "id": 8353,
        "name": "冯延巳"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 303790,
      "title": "崔徽歌 六",
      "content": [
        "舞态低迷误招拍。",
        "（同前书卷八《蝶恋花》之二注引崔徽诗）。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 312221,
      "title": "凤栖梧・蝶恋花",
      "content": [
        "十二层楼春色早。",
        "三殿笙歌，九陌风光好。",
        "堤柳岸花连复道。",
        "玉梯相对开蓬岛。",
        "莺啭乔林鱼在藻。",
        "太液微波，绿斗王孙草。",
        "南阙万人瞻羽葆。",
        "后天祝圣天难老。"
      ],
      "author": {
        "id": 4908,
        "name": "丁谓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312222,
      "title": "凤栖梧・蝶恋花",
      "content": [
        "朱阙玉城通阆苑。",
        "月桂星榆，春色无深浅。",
        "潇瑟篌笙仙客宴。",
        "蟠桃花满蓬莱殿。",
        "九色明霞裁羽扇。",
        "云雾为车，鸾鹤骖雕辇。",
        "路指瑶池归去晚。",
        "壶中日月如天远。"
      ],
      "author": {
        "id": 4908,
        "name": "丁谓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312305,
      "title": "凤栖梧・蝶恋花",
      "content": [
        "帘下清歌帘外宴。",
        "虽爱新声，不见如花面。",
        "牙板数敲珠一串，梁尘暗落琉璃盏。",
        "桐树花深孤凤怨。",
        "渐遏遥天，不放行云散。",
        "坐上少年听不惯。",
        "玉山未倒肠先断。"
      ],
      "author": {
        "id": 3061,
        "name": "柳永"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312306,
      "title": "凤栖梧・蝶恋花",
      "content": [
        "伫倚危楼风细细。",
        "望极春愁，黯黯生天际。",
        "草色烟光残照里。",
        "无言谁会凭阑意。",
        "拟把疏狂图一醉。",
        "对酒当歌，强乐还无味。",
        "衣带渐宽终不悔。",
        "为伊消得人憔悴。"
      ],
      "author": {
        "id": 3061,
        "name": "柳永"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312307,
      "title": "凤栖梧・蝶恋花",
      "content": [
        "蜀锦地衣丝步障。",
        "屈曲回廊，静夜闲寻访。",
        "玉砌雕阑新月上。",
        "朱扉半掩人相望。",
        "旋暖熏炉温斗帐。",
        "玉树琼枝，迤逦相偎傍。",
        "酒力渐浓春思荡。",
        "鸳鸯绣被翻红浪。"
      ],
      "author": {
        "id": 3061,
        "name": "柳永"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312507,
      "title": "凤栖梧・蝶恋花",
      "content": [
        "密宴厌厌池馆暮。",
        "天汉沈沈，借得春光住。",
        "红翠斗为长袖舞。",
        "香檀拍过惊鸿翥。",
        "明日不知花在否。",
        "今夜圆蟾，后夜忧风雨。",
        "可惜歌云容易去。",
        "东城杨柳东城路。"
      ],
      "author": {
        "id": 5040,
        "name": "张先"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312515,
      "title": "蝶恋花",
      "content": [
        "临水人家深宅院。",
        "阶下残花，门外斜阳岸。",
        "柳舞曲尘千万线。",
        "青楼百尺临天半。",
        "楼上东风春不浅。",
        "十二阑干，尽日珠帘卷。",
        "有个离人凝泪眼。",
        "淡烟芳草连云远。"
      ],
      "author": {
        "id": 5040,
        "name": "张先"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312516,
      "title": "蝶恋花",
      "content": [
        "槛菊愁烟兰泣露。",
        "罗幕轻寒，燕子双来去。",
        "明月不谙离恨苦。",
        "斜光到晓穿朱户。",
        "昨夜西风雕碧树。",
        "独上高楼，望尽天涯路。",
        "欲寄彩笺兼尺素。",
        "山长水阔知何处。"
      ],
      "author": {
        "id": 5040,
        "name": "张先"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312517,
      "title": "蝶恋花",
      "content": [
        "绿水波平花烂漫。",
        "照影红妆，步转垂杨岸。",
        "别后深情将为断。",
        "相逢添得人留恋。",
        "絮软丝轻无系绊。",
        "烟惹风迎，并入春心乱。",
        "和泪语娇声又颤。",
        "行行尽远犹回面。"
      ],
      "author": {
        "id": 5040,
        "name": "张先"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312518,
      "title": "蝶恋花",
      "content": [
        "移得绿杨栽后院。",
        "学舞宫腰，二月青犹短。",
        "不比灞陵多送远。",
        "残丝乱絮东西岸。",
        "几叶小眉寒不展。",
        "莫唱阳关，真个肠先断。",
        "分付与春休细看。",
        "条条尽是离人怨。"
      ],
      "author": {
        "id": 5040,
        "name": "张先"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312645,
      "title": "鹊踏枝・蝶恋花",
      "content": [
        "槛菊愁烟兰泣露。",
        "罗幕轻寒，燕子双飞去。",
        "明月不谙离恨苦。",
        "斜光到晓穿朱户。",
        "昨夜西风凋碧树。",
        "独上高楼，望尽天涯路。",
        "欲寄彩笺兼尺素。",
        "山长水阔知何处。"
      ],
      "author": {
        "id": 6242,
        "name": "晏殊"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312646,
      "title": "鹊踏枝・蝶恋花",
      "content": [
        "紫府群仙名籍秘。",
        "五色斑龙，暂降人间世。",
        "海变桑田都不记。",
        "蟠桃一熟三千岁。",
        "露滴彩旌云绕袂。",
        "谁信壶中，别有笙歌地。",
        "门外落花随水逝。",
        "相看莫惜尊前醉。"
      ],
      "author": {
        "id": 6242,
        "name": "晏殊"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312727,
      "title": "蝶恋花",
      "content": [
        "一霎秋风惊画扇。",
        "艳粉娇红，尚拆荷花面。",
        "草际露垂虫响遍。",
        "珠帘不下留归燕。",
        "扫掠亭台开小院。",
        "四坐清欢，莫放金杯浅。",
        "龟鹤命长松寿远。",
        "阳春一曲情千万。"
      ],
      "author": {
        "id": 6242,
        "name": "晏殊"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312728,
      "title": "蝶恋花",
      "content": [
        "紫菊初生朱槿坠。",
        "月好风清，渐有中秋意。",
        "更漏乍长天似水。",
        "银屏展尽遥山翠。",
        "绣幕卷波香引穗。",
        "急管繁弦，共庆人间瑞。",
        "满酌玉杯萦舞袂。",
        "南春祝寿千千岁。"
      ],
      "author": {
        "id": 6242,
        "name": "晏殊"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312729,
      "title": "蝶恋花",
      "content": [
        "帘幕风轻双语燕。",
        "午醉醒来，柳絮飞撩乱。",
        "心事一春犹未见。",
        "馀花落尽青苔院。",
        "百尺朱楼闲倚遍。",
        "薄雨浓云，抵死遮人面。",
        "消息未知归早晚。",
        "斜阳只送平波远。"
      ],
      "author": {
        "id": 6242,
        "name": "晏殊"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312730,
      "title": "蝶恋花",
      "content": [
        "玉碗冰寒消暑气。",
        "碧簟纱厨，向午朦胧睡。",
        "莺舌惺松如会意。",
        "无端画扇惊飞起。",
        "雨后初凉生水际。",
        "人面荷花，的的遥相似。",
        "眼看红芳犹抱蕊。",
        "丛中已结新莲子。"
      ],
      "author": {
        "id": 6242,
        "name": "晏殊"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312731,
      "title": "蝶恋花",
      "content": [
        "梨叶疏红蝉韵歇。",
        "银汉风高，玉管声凄切。",
        "枕簟乍凉铜漏咽。",
        "谁教社燕轻离别。",
        "草际蛩吟珠露结。",
        "宿酒醒来，不记归时节。",
        "多少衷肠犹未说。",
        "朱帘一夜朦胧月。"
      ],
      "author": {
        "id": 6242,
        "name": "晏殊"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312732,
      "title": "蝶恋花",
      "content": [
        "南雁依稀回侧阵。",
        "雪霁墙阴，偏觉兰芽嫩。",
        "中夜梦馀消酒困。",
        "炉香卷穗灯生晕。",
        "急景流年都一瞬。",
        "往事前欢，未免萦方寸。",
        "腊后花期知渐近。",
        "寒梅已作东风信。"
      ],
      "author": {
        "id": 6242,
        "name": "晏殊"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312770,
      "title": "蝶恋花",
      "content": [
        "遥夜亭皋闲信步。",
        "才过清明，渐觉伤春暮。",
        "数点雨声风约住。",
        "朦胧淡月云来去。",
        "桃杏依稀香暗渡。",
        "谁在秋千，笑里轻轻语。",
        "一寸相思千万绪。",
        "人间没个安排处。"
      ],
      "author": {
        "id": 3052,
        "name": "李冠"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312773,
      "title": "蝶恋花",
      "content": [
        "贴鬓香云双绾绿。",
        "柳弱花娇，一点春心足。",
        "不肯玉箫闲度曲。",
        "恼人特把青蛾蹙。",
        "静夜溪桥霜薄屋。",
        "独影行歌，惊起双鸾宿。",
        "愁破酒阑闺梦熟。",
        "月斜窗外风敲竹。"
      ],
      "author": {
        "id": 3052,
        "name": "李冠"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312780,
      "title": "蝶恋花",
      "content": [
        "雨过蒲萄新涨绿。",
        "苍玉盘倾，堕碎珠千斛。",
        "姬监拥前红簇簇。",
        "温泉初试真妃浴。",
        "驿使南来丹荔熟。",
        "故翦轻绡，一色颁时服。",
        "娇汗易晞凝醉玉。",
        "青凉不用香绵扑。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312782,
      "title": "蝶恋花",
      "content": [
        "绣幕茫茫罗帐卷。",
        "春睡腾腾，困入娇波慢。",
        "隐隐枕痕留玉脸。",
        "腻云斜溜钗头燕。",
        "远梦无端欢又散。",
        "泪落胭脂，界破蜂黄浅。",
        "整了翠鬟匀了面。",
        "芳心一寸情何限。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312825,
      "title": "蝶恋花",
      "content": [
        "帘幕东风寒料峭。",
        "雪里香梅，先报春来早。",
        "红蜡枝头双燕小。",
        "金刀剪彩呈纤巧。",
        "旋暖金炉薰蕙藻。",
        "酒入横波，困不禁烦恼。",
        "绣被五更春睡好。",
        "罗帏不觉纱窗晓。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312826,
      "title": "蝶恋花",
      "content": [
        "南雁依稀回侧阵。",
        "雪霁墙阴，遍觉兰芽嫩。",
        "中夜梦馀消酒困。",
        "炉香卷穗灯生晕。",
        "急景流年都一瞬。",
        "往事前欢，未免萦芳寸。",
        "腊后花期知渐近。",
        "东风已作寒梅信。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312827,
      "title": "蝶恋花",
      "content": [
        "腊雪初销梅蕊绽。",
        "梅雪相和，喜鹊穿花转。",
        "睡起夕阳迷醉眼。",
        "新愁长向东风乱。",
        "瘦觉玉肌罗带缓。",
        "红杏梢头，二月春犹浅。",
        "望极不来芳信断。",
        "音书纵有争如见。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312828,
      "title": "蝶恋花",
      "content": [
        "海燕双来归画栋。",
        "帘影无风，花影频移动。",
        "半醉腾腾春睡重。",
        "绿鬟堆枕香云拥。",
        "翠被双盘金缕凤。",
        "忆得前春，有个人人共。",
        "花里黄莺时一弄。",
        "日斜惊起相思梦。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312829,
      "title": "蝶恋花",
      "content": [
        "面旋落花风荡漾。",
        "柳重烟深，雪絮飞来往。",
        "雨后轻寒犹未放。",
        "春愁酒病成惆怅。",
        "枕畔屏山围碧浪。",
        "翠被华灯，夜夜空相向。",
        "寂寞起来褰绣幌。",
        "月明正在梨花上。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312830,
      "title": "蝶恋花",
      "content": [
        "帘幕风轻双语燕。",
        "午后醒来，柳絮飞撩乱。",
        "心事一春犹未见。",
        "红英落尽青苔院。",
        "百尺朱楼闲倚遍。",
        "薄雨浓云，抵死遮人面。",
        "羌管不须吹别怨。",
        "无肠更为新声断。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312831,
      "title": "蝶恋花",
      "content": [
        "永日环堤乘彩舫。",
        "烟草萧疏，恰似晴江上。",
        "水浸碧天风皱浪。",
        "菱花荇蔓随双桨。",
        "红粉佳人翻丽唱。",
        "惊起鸳鸯，两两飞相向。",
        "且把金尊倾美酿。",
        "休思往事成惆怅。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312832,
      "title": "蝶恋花",
      "content": [
        "越女采莲秋水畔。",
        "窄袖轻罗，暗露双金钏。",
        "照影摘花花似面。",
        "芳心只共丝争乱。",
        "㶉𫛶滩头风浪晚。",
        "雾重烟轻，不见来时伴。",
        "隐隐歌声归棹远。",
        "离愁引著江南岸。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312833,
      "title": "蝶恋花",
      "content": [
        "水浸秋天风皱浪。",
        "缥缈仙舟，只似秋天上。",
        "和露采莲愁一饷。",
        "看花却是啼妆样。",
        "折得莲茎丝未放。",
        "莲断丝牵，特地成惆怅。",
        "归棹莫随花荡漾。",
        "江头有个人相望。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312834,
      "title": "蝶恋花",
      "content": [
        "梨叶初红婵韵歇。",
        "银汉风高，玉管声凄切。",
        "枕簟乍凉铜漏彻。",
        "谁教社燕轻离别。",
        "草际虫吟秋露结。",
        "宿酒醒来，不记归时节。",
        "多少衷肠犹未说。",
        "珠帘夜夜朦胧月。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312835,
      "title": "蝶恋花",
      "content": [
        "独倚危楼风细细。",
        "望极离愁，黯黯生天际。",
        "草色山光残照里。",
        "无人会得凭阑意。",
        "也拟疏狂图一醉。",
        "对酒当歌，强饮还无味。",
        "衣带渐宽都不悔。",
        "况伊销得人憔悴。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312836,
      "title": "蝶恋花",
      "content": [
        "帘下清歌帘外宴。",
        "虽爱新声，不见如花面。",
        "牙板数敲珠一串。",
        "梁尘暗落琉璃盏。",
        "桐树花深孤凤怨。",
        "渐遏遥天，不放行云散。",
        "坐上少年听未惯。",
        "玉山将倒肠先断。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312837,
      "title": "蝶恋花",
      "content": [
        "翠苑红芳晴满目。",
        "绮席流莺，上下长相逐。",
        "紫陌闲随金轹辘。",
        "马蹄踏遍春郊绿。",
        "一觉年华春梦促。",
        "往事悠悠，百种寻思足。",
        "烟雨满楼山断续。",
        "人闲倚遍阑干曲。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312838,
      "title": "蝶恋花",
      "content": [
        "小院深深门掩亚。",
        "寂寞珠帘，画阁重重下。",
        "欲近禁烟微雨罢。",
        "绿杨深处秋千挂。",
        "傅粉狂游犹未舍。",
        "不念芳时，眉黛无人画。",
        "薄幸未归春去也。",
        "杏花零落香红谢。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312839,
      "title": "蝶恋花",
      "content": [
        "欲过清明烟雨细。",
        "小槛临窗，点点残花坠。",
        "梁燕语多惊晓睡。",
        "银屏一半堆香被。",
        "新岁风光如旧岁。",
        "所恨征轮，渐渐程迢递。",
        "纵有远情难写寄。",
        "何妨解有相思泪。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312840,
      "title": "蝶恋花",
      "content": [
        "画阁归来春又晚。",
        "燕子双飞，柳软桃花浅。",
        "细雨满天风满院。",
        "愁眉敛尽无人见。",
        "独倚阑干心绪乱。",
        "芳草芊绵，尚忆江南岸。",
        "风月无情人暗换。",
        "旧游如梦空肠断。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312841,
      "title": "蝶恋花",
      "content": [
        "尝爱西湖春色早。",
        "腊雪方销，已见桃开小。",
        "顷刻光阴都过了。",
        "如今绿暗红英少。",
        "且趁馀花谋一笑。",
        "况有笙歌，艳态相萦绕。",
        "老去风情应不到。",
        "凭君剩把芳尊倒。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312971,
      "title": "蝶恋花",
      "content": [
        "几度兰房听禁漏。",
        "臂上残妆，印得香盈袖。",
        "酒力融融香汗透。",
        "春娇入眼横波溜。",
        "不见些时眉已皱。",
        "水阔山遥，乍向分飞后。",
        "大抵有情须感旧。",
        "肌肤拼为伊销瘦。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312972,
      "title": "蝶恋花",
      "content": [
        "宝琢珊瑚山样瘦。",
        "缓髻轻拢，一朵云生袖。",
        "昨夜佳人初命偶。",
        "论情旋旋移相就。",
        "几叠鸳衾红浪皱。",
        "暗觉金钗，磔磔声相扣。",
        "一自楚台人梦后。",
        "凄凉暮雨沾裀绣。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312973,
      "title": "蝶恋花",
      "content": [
        "一掬天和金粉腻。",
        "莲子心中，自有深深意。",
        "意密莲深秋正媚。",
        "将花寄恨无人会。",
        "桥上少年桥下水。",
        "小棹归时，不语牵红袂。",
        "浪溅荷心圆又碎。",
        "无端欲伴相思泪。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312974,
      "title": "蝶恋花",
      "content": [
        "百种相思千种恨。",
        "早是伤春，那更春醪困。",
        "薄幸辜人终不愤。",
        "何时枕畔分明问。",
        "懊恼风流心一寸。",
        "强醉偷眠，也即依前闷。",
        "此意为君君不信。",
        "泪珠滴尽愁难尽。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312986,
      "title": "鹊踏枝・蝶恋花",
      "content": [
        "一曲尊前开画扇。",
        "暂近还遥，不语仍低面。",
        "直至情多缘少见。",
        "千金不直双回眄。",
        "苦恨行云容易散。",
        "过尽佳期，争向年芳晚。",
        "百种寻思千万遍。",
        "愁肠不似情难断。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313103,
      "title": "凤栖梧・蝶恋花",
      "content": [
        "整顿云鬟初睡起。",
        "庭院无风，尽日帘垂地。",
        "画阁巢新燕声喜。",
        "杨花狂散无拘系。",
        "近来早是添憔悴。",
        "金缕衣宽，赛过宫腰细。",
        "苒苒光阴似流水。",
        "春残莺老人千里。"
      ],
      "author": {
        "id": 11741,
        "name": "杜安世"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313104,
      "title": "凤栖梧・蝶恋花",
      "content": [
        "池上新秋帘幕卷。",
        "菡萏娇红，鉴里西施面。",
        "衰柳摇风尚柔软。",
        "眠沙㶉𫛶临清浅。",
        "新翻归翅云间燕。",
        "满地槐花，尽日蝉声乱。",
        "独倚阑干暮山远。",
        "一场寂寞无人见。"
      ],
      "author": {
        "id": 11741,
        "name": "杜安世"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313105,
      "title": "凤栖梧・蝶恋花",
      "content": [
        "闲上江楼初雨过。",
        "满袖清风，微散谁知我。",
        "莲脸佳人颜未破。",
        "沙洲两两鸳鸯卧。",
        "时有渔歌相应和。",
        "叠秀危横，黛拨山千朵。",
        "一片凄凉无计那。",
        "离愁还有些些个。"
      ],
      "author": {
        "id": 11741,
        "name": "杜安世"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313106,
      "title": "凤栖梧・蝶恋花",
      "content": [
        "惆怅留春留不住。",
        "欲到清和，背我堂堂去。",
        "飞絮落花和细雨。",
        "凄凉庭院流莺度。",
        "更被闲愁相赚误。",
        "梦断高唐，回首桃源路。",
        "一饷沈吟无意绪。",
        "分明往事今何处。"
      ],
      "author": {
        "id": 11741,
        "name": "杜安世"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313140,
      "title": "凤栖梧・蝶恋花",
      "content": [
        "秋日楼台在空际。",
        "画角声沈，历历寒更起。",
        "深院黄昏人独自。",
        "想伊遥共伤前事。",
        "懊恼当初无算计。",
        "些子欢娱，多少凄凉味。",
        "相去江山千万里。",
        "一回东望心如醉。"
      ],
      "author": {
        "id": 11741,
        "name": "杜安世"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313141,
      "title": "凤栖梧・蝶恋花",
      "content": [
        "任在芦花最深处。",
        "浪静风恬，又泛轻舟去。",
        "去到滩头遇俦侣。",
        "散唱狂歌鱼未取。",
        "不把身心干时务。",
        "一副轮竿，莫笑闲家具。",
        "待拟观光佐明主。",
        "将甚医他民病苦。"
      ],
      "author": {
        "id": 11741,
        "name": "杜安世"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313142,
      "title": "凤栖梧・蝶恋花",
      "content": [
        "别浦迟留恋清浅。",
        "菱蔓荷花，尽日妨钩线。",
        "向晚澄江静如练。",
        "风送归帆飞似箭。",
        "鸥鹭相将是家眷。",
        "坐对云山，一任炎凉变。",
        "定是寰区又清宴。",
        "不见龙骧波上战。"
      ],
      "author": {
        "id": 11741,
        "name": "杜安世"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313143,
      "title": "凤栖梧・蝶恋花",
      "content": [
        "闲把浮生细思算。",
        "百岁光阴，梦里销除半。",
        "白首为郎休浩叹。",
        "偷安自喜身强健。",
        "多少英贤裨圣旦。",
        "一个非才，深谢容疏懒。",
        "席上清歌珠一串。",
        "莫教欢会轻分散。"
      ],
      "author": {
        "id": 11741,
        "name": "杜安世"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313144,
      "title": "凤栖梧・蝶恋花",
      "content": [
        "新月羞光影庭树。",
        "窗外芭蕉，数点黄昏雨。",
        "何事秋来无意绪。",
        "玉容寂寞双眉聚。",
        "一点银釭扃绣户。",
        "莎砌寒蛩，历历啼声苦。",
        "孤枕夜长君信否。",
        "披衣颙坐魂飞去。"
      ],
      "author": {
        "id": 11741,
        "name": "杜安世"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313191,
      "title": "凤栖梧・蝶恋花",
      "content": [
        "蜀道青天烟霭翳。",
        "帝里繁华、迢递何时至。",
        "回望锦川挥粉泪。",
        "凤钗斜亸乌云腻。",
        "钿带双垂金缕细。",
        "玉珮玎珰，露滴寒如水。",
        "从此鸾妆添远意。",
        "画眉学得遥山翠。"
      ],
      "author": {
        "id": 2438,
        "name": "卢氏"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313221,
      "title": "蝶恋花",
      "content": [
        "香作风光浓著露。",
        "正恁双栖，又遣分飞去。",
        "密诉东君应不许。",
        "泪波一洒奴衷素。"
      ],
      "author": {
        "id": 12696,
        "name": "韩缜姬"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313225,
      "title": "蝶恋花",
      "content": [
        "叶底无风池面静。",
        "掬水佳人，拍破青铜镜。",
        "残月朦胧花弄影。",
        "新梳斜插乌云鬓。",
        "拍索闷怀添酒兴。",
        "旋撷园蔬，随分成盘饤。",
        "说与翠微休急性。",
        "功名富贵皆前定。"
      ],
      "author": {
        "id": 13449,
        "name": "滕甫"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313226,
      "title": "蝶恋花",
      "content": [
        "昼永无人深院静。",
        "一枕春醒，犹未忺临镜。",
        "帘卷新蟾光射影。",
        "速忙掠起蓬松鬓。",
        "对景沈吟嗟没兴。",
        "薄幸不来，空把杯盘饤。",
        "休道妇人多水性。",
        "今宵独自言无定。"
      ],
      "author": {
        "id": 13449,
        "name": "滕甫"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313316,
      "title": "蝶恋花",
      "content": [
        "卷絮风头寒欲尽。",
        "坠粉飘红，日日香成阵。",
        "新酒又添残酒困。",
        "今春不减前春恨。",
        "蝶去莺飞无处问。",
        "隔水高楼，望断双鱼信。",
        "恼乱层波横一寸。",
        "斜阳只与黄昏近。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313317,
      "title": "蝶恋花",
      "content": [
        "初拈霜纨生怅望。",
        "隔叶莺声，似学秦娥唱。",
        "午睡醒来慵一饷。",
        "双纹翠簟铺寒浪。",
        "雨罢苹风吹碧涨。",
        "脉脉荷花，泪脸红相向。",
        "斜贴绿云新月上。",
        "弯环正是愁眉样。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313318,
      "title": "蝶恋花",
      "content": [
        "庭院碧苔红叶遍。",
        "金菊开时，已近重阳宴。",
        "日日露荷凋绿扇。",
        "粉塘烟水澄如练。",
        "试倚凉风醒酒面。",
        "雁字来时，恰向层楼见。",
        "几点护霜云影转。",
        "谁家芦管吹秋怨。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313319,
      "title": "蝶恋花",
      "content": [
        "喜鹊桥成催凤驾。",
        "天为欢迟，乞与初凉夜。",
        "乞巧双蛾加意画。",
        "玉钩斜傍西南挂。",
        "分钿擘钗凉叶下。",
        "香袖凭肩，谁记当时话。",
        "路隔银河犹可借。",
        "世间离恨何年罢。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313320,
      "title": "蝶恋花",
      "content": [
        "碧草池塘春又晚。",
        "小叶风娇，尚学娥妆浅。",
        "双燕来时还念远。",
        "珠帘绣户杨花满。",
        "绿柱频移弦易断。",
        "细看秦筝，正似人情短。",
        "一曲啼乌心绪乱。",
        "红颜暗与流年换。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313321,
      "title": "蝶恋花",
      "content": [
        "碾玉钗头双凤小。",
        "倒晕工夫，画得宫眉巧。",
        "嫩曲罗裙胜碧草。",
        "鸳鸯绣字春衫好。",
        "三月露桃芳意早。",
        "细看花枝，人面争多少。",
        "水调声长歌未了。",
        "掌中杯尽东池晓。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313322,
      "title": "蝶恋花",
      "content": [
        "醉别西楼醒不记。",
        "春梦秋云，聚散真容易。",
        "斜月半窗还少睡。",
        "画屏闲展吴山翠。",
        "衣上酒痕诗里字。",
        "点点行行，总是凄凉意。",
        "红烛自怜无好计。",
        "夜寒空替人垂泪。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313323,
      "title": "蝶恋花",
      "content": [
        "欲减罗衣寒未去。",
        "不卷珠帘，人在深深处。",
        "残杏枝头花几许。",
        "啼红正恨清明雨。",
        "尽日沈香烟一缕。",
        "宿酒醒迟，恼破春情绪。",
        "远信还因归燕误。",
        "小屏风上西江路。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313324,
      "title": "蝶恋花",
      "content": [
        "千叶早梅夸百媚。",
        "笑面凌寒，内样妆先试。",
        "月脸冰肌香细腻。",
        "风流新称东君意。",
        "一捻年光春有味。",
        "江北江南，更有谁相比。",
        "横玉声中吹满地。",
        "好枝长恨无人寄。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313325,
      "title": "蝶恋花",
      "content": [
        "金翦刀头芳意动。",
        "彩蕊开时，不怕朝寒重。",
        "晴雪半消花䰒䰄。",
        "晓妆呵尽香酥冻。",
        "十二楼中双翠凤。",
        "缥缈歌声，记得江南弄。",
        "醉舞春风谁可共。",
        "秦云已有鸳屏梦。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313326,
      "title": "蝶恋花",
      "content": [
        "笑艳秋莲生绿浦。",
        "红脸青腰，旧识凌波女。",
        "照影弄妆娇欲语。",
        "西风岂是繁华主。",
        "可恨良辰天不与。",
        "才过斜阳，又是黄昏雨。",
        "朝落暮开空自许。",
        "竟无人解知心苦。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313327,
      "title": "蝶恋花",
      "content": [
        "碧落秋风吹玉树。",
        "翠节红旌，晚过银河路。",
        "休笑星机停弄杼。",
        "凤帏已在云深处。",
        "楼上金针穿绣缕。",
        "谁管天边，隔岁分飞苦。",
        "试等夜阑寻别绪。",
        "泪痕千点罗衣露。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313328,
      "title": "蝶恋花",
      "content": [
        "碧玉高楼临水住。",
        "红杏开时，花底曾相遇。",
        "一曲阳春春已暮。",
        "晓莺声断朝云去。",
        "远水来从楼下路。",
        "过尽流波，未得鱼中素。",
        "月细风尖垂柳渡。",
        "梦魂长在分襟处。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313329,
      "title": "蝶恋花",
      "content": [
        "梦入江南烟水路。",
        "行尽江南，不与离人遇。",
        "睡里消魂无说处。",
        "觉来惆怅消魂误。",
        "欲尽此情书尺素。",
        "浮雁沈鱼，终了无凭据。",
        "却倚缓弦歌别绪。",
        "断肠移破秦筝柱。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313330,
      "title": "蝶恋花",
      "content": [
        "黄菊开时伤聚散。",
        "曾记花前，共说深深愿。",
        "重见金英人未见。",
        "相思一夜天涯远。",
        "罗带同心闲结遍。",
        "带易成双，人恨成双晚。",
        "欲写彩笺书别怨。",
        "泪痕早已先书满。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313612,
      "title": "卷珠帘・蝶恋花",
      "content": [
        "记得来时春未暮。",
        "执手攀花，袖染花梢露。",
        "暗卜春心共花语。",
        "争寻双朵争先去。",
        "多情因甚相辜负。",
        "轻折轻离，欲向谁分诉。",
        "泪湿海棠花枝处。",
        "东君空把奴分付。"
      ],
      "author": {
        "id": 2516,
        "name": "魏夫人"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313630,
      "title": "蝶恋花",
      "content": [
        "钟送黄昏鸡报晓。",
        "昏晓相催，世事何时了。",
        "万恨千愁人自老。",
        "春来依旧生芳草。",
        "忙处人多闲处少。",
        "闲处光阴，几个人知道。",
        "独上高楼云渺渺。",
        "天涯一点青山小。"
      ],
      "author": {
        "id": 1324,
        "name": "王诜"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313640,
      "title": "蝶恋花",
      "content": [
        "小雨初晴回晚照。",
        "金翠楼台，倒影芙蓉沼。",
        "杨柳垂垂风袅袅。",
        "嫩荷无数青钿小。",
        "似此园林无限好。",
        "流落归来，到了心情少。",
        "坐到黄昏人悄悄。",
        "更应添得朱颜老。"
      ],
      "author": {
        "id": 1324,
        "name": "王诜"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313775,
      "title": "蝶恋花",
      "content": [
        "花褪残红青杏小。",
        "燕子飞时，绿水人家绕。",
        "枝上柳绵吹又少。",
        "天涯何处无芳草。",
        "墙里秋千墙外道。",
        "墙外行人，墙里佳人笑。",
        "笑渐不闻声渐悄。",
        "多情却被无情恼。"
      ],
      "author": {
        "id": 11678,
        "name": "苏轼"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313776,
      "title": "蝶恋花",
      "content": [
        "一颗樱桃樊素口。",
        "不爱黄金，只爱人长久。",
        "学画鸦儿犹未就。",
        "眉间已作伤春皱。",
        "扑蝶西园随伴走。",
        "花落花开，渐解相思瘦。",
        "破镜重圆人在否。",
        "章台折尽青青柳。"
      ],
      "author": {
        "id": 11678,
        "name": "苏轼"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313777,
      "title": "蝶恋花",
      "content": [
        "雨后春容清更丽。",
        "只有离人，幽恨终难洗。",
        "北固山前三面水。",
        "碧琼梳拥青螺髻。",
        "一纸乡书来万里。",
        "问我何年，真个成归计。",
        "白首送春拼一醉。",
        "东风吹破千行泪。"
      ],
      "author": {
        "id": 11678,
        "name": "苏轼"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313778,
      "title": "蝶恋花",
      "content": [
        "簌簌无风花自亸。",
        "寂寞园林，柳老樱桃过。",
        "落日多情还照坐。",
        "山青一点横云破。",
        "路尽河回千转柁。",
        "系缆渔村，月暗孤灯火。",
        "凭仗飞魂招楚些。",
        "我思君处君思我。"
      ],
      "author": {
        "id": 11678,
        "name": "苏轼"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313779,
      "title": "蝶恋花",
      "content": [
        "灯火钱塘三五夜。",
        "明月如霜，照见人如画。",
        "帐底吹笙香吐麝。",
        "此般风味应无价。",
        "寂寞山城人老也。",
        "击鼓吹箫，乍入农桑社。",
        "火冷灯稀霜露下。",
        "昏昏雪意云垂野。"
      ],
      "author": {
        "id": 11678,
        "name": "苏轼"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313780,
      "title": "蝶恋花",
      "content": [
        "帘外东风交雨霰。",
        "帘里佳人，笑语如莺燕。",
        "深惜今年正月暖。",
        "灯光酒色摇金盏。",
        "掺鼓《渔阳》挝未遍。",
        "舞褪琼钗，汗湿香罗软。",
        "今夜何人吟古怨。",
        "清诗未就冰生砚。"
      ],
      "author": {
        "id": 11678,
        "name": "苏轼"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313781,
      "title": "蝶恋花",
      "content": [
        "自古涟漪佳绝地。",
        "绕郭荷花，欲把吴兴比。",
        "倦客尘埃何处洗。",
        "真君堂下寒泉水。",
        "左海门前酤酒市。",
        "夜半潮来，月下孤舟起。",
        "倾盖相逢拼一醉。",
        "双凫飞去人千里。"
      ],
      "author": {
        "id": 11678,
        "name": "苏轼"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313782,
      "title": "蝶恋花",
      "content": [
        "云水萦回溪上路。",
        "叠叠青山，环绕溪东注。",
        "月白沙汀翘宿鹭。",
        "更无一点尘来处。",
        "溪叟相看私自语。",
        "底事区区，苦要为官去。",
        "尊酒不空田百亩。",
        "归来分得闲中趣。"
      ],
      "author": {
        "id": 11678,
        "name": "苏轼"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313920,
      "title": "蝶恋花",
      "content": [
        "别酒劝君君一醉。",
        "清润潘郎，又是何郎婿。",
        "记取钗头新利市。",
        "莫将分付东邻子。",
        "回首长安佳丽地。",
        "三十年前，我是风流帅。",
        "为向青楼寻旧事。",
        "花枝缺处馀名字。"
      ],
      "author": {
        "id": 11678,
        "name": "苏轼"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313921,
      "title": "蝶恋花",
      "content": [
        "泛泛东风初破五。",
        "江柳微黄，万万千千缕。",
        "佳气郁葱来绣户。",
        "当年江上生奇女。",
        "一盏寿觞谁与举。",
        "三个明珠，膝上王文度。",
        "放尽穷鳞看圉圉。",
        "天公为下曼陀雨。"
      ],
      "author": {
        "id": 11678,
        "name": "苏轼"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313963,
      "title": "蝶恋花",
      "content": [
        "春事阑珊芳草歇。",
        "客里风光，又过清明节。",
        "小院黄昏人忆别。",
        "落红处处闻啼鴂。",
        "咫尺江山分楚越。",
        "目断魂销，应是音尘绝。",
        "梦破五更心欲折。",
        "角声吹落梅花月。"
      ],
      "author": {
        "id": 11678,
        "name": "苏轼"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313964,
      "title": "蝶恋花",
      "content": [
        "记得画屏初会遇。",
        "好梦惊回，望断高唐路。",
        "燕子双飞来又去。",
        "纱窗几度春光暮。",
        "那日绣帘相见处。",
        "低眼佯行，笑整香云缕。",
        "敛尽春山羞不语。",
        "人前深意难轻诉。"
      ],
      "author": {
        "id": 11678,
        "name": "苏轼"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313965,
      "title": "蝶恋花",
      "content": [
        "昨夜秋风来万里。",
        "月上屏帏，冷透人衣袂。",
        "有客抱衾愁不寐。",
        "那堪玉漏长如岁。",
        "羁舍留连归计未。",
        "梦断魂销，一枕相思泪。",
        "衣带渐宽无别意。",
        "新书报我添憔悴。"
      ],
      "author": {
        "id": 11678,
        "name": "苏轼"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313966,
      "title": "蝶恋花",
      "content": [
        "雨霰疏疏经泼火。",
        "巷陌秋千。",
        "犹未清明过。",
        "杏子梢头香蕾破。",
        "淡红褪白胭脂涴。",
        "苦被多情相折挫。",
        "病绪厌厌，浑似年时个。",
        "绕遍回廊还独坐。",
        "月笼云暗重门锁。"
      ],
      "author": {
        "id": 11678,
        "name": "苏轼"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    }
  ],
