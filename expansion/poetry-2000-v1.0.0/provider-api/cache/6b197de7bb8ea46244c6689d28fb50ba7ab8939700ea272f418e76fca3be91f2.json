{
  "data": [
    {
      "id": 231790,
      "title": "题颜鲁公画像",
      "content": [
        "公生开元间，壮及天宝乱。",
        "捐躯范阳兵，竟死蔡州叛。",
        "其贤似魏徴，天下非贞观。",
        "四帝数十年，一身逢百难。",
        "少时读书史，此事心已断。",
        "老来鬓髪衰，慨叹功名晚。",
        "嗟哉忠义徒，捷去不可缓。",
        "初无当年悲，只令后世叹。",
        "一朝绝霖雨，南亩常亢旱。",
        "小人计虽得，斯民盖涂炭。",
        "长歌永君节，千载勇夫愞。",
        "敬书子张绅，庶几古人半。"
      ],
      "author": {
        "id": 1056,
        "name": "徐俯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 231791,
      "title": "滕王阁  其一",
      "content": [
        "一日逢王造，千年与客游。",
        "云边梅岭出，坐上赣江流。",
        "日落回飞鸟，烟深失钓舟。",
        "蝉声枯柳外，天地晚风秋。"
      ],
      "author": {
        "id": 1056,
        "name": "徐俯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 231792,
      "title": "滕王阁  其二",
      "content": [
        "云气浮高栋，波澜遶古城。",
        "雨余山更碧，叶下水逾清。",
        "燕语留秋色，鸦声落晚晴。",
        "昔王歌舞地，帆急见山行。"
      ],
      "author": {
        "id": 1056,
        "name": "徐俯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 231793,
      "title": "同曾户部吴县尉张秀才北山僧房寻梅令客对棋",
      "content": [
        "处处已收南亩稻，闲闲还看北山梅。",
        "累觞聊尔酡颜在，对局怡然笑口开。",
        "扫径似知佳客至，杖藜惟可数君来。",
        "移松种树鄱阳老，章贡风帆岁一回。"
      ],
      "author": {
        "id": 1056,
        "name": "徐俯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 231794,
      "title": "庭中梅花正开用旧韵贻端伯",
      "content": [
        "羌笛何劳塞北吹，江南何处不寒梅。",
        "千秋寂寂无人看，独树亭亭对客开。",
        "偏为咨嗟惟尔念，是谁移种待君来。",
        "纵留一曲安能唱，恰似朝歌墨子回。"
      ],
      "author": {
        "id": 1056,
        "name": "徐俯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 231795,
      "title": "戊午山间对雪",
      "content": [
        "雪中出去雪边行，屋下吹来屋上平。",
        "积得重重那许重，飞来片片又何轻。",
        "簷间日暖重为雨，林下风吹再落晴。",
        "表里江山应更好，溪山已复不胜清。"
      ],
      "author": {
        "id": 1056,
        "name": "徐俯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 231796,
      "title": "咏史",
      "content": [
        "楚汉分争辨士忧，东归那复割鸿沟。",
        "郑君立义不名藉，项伯胡颜肯姓刘。"
      ],
      "author": {
        "id": 1056,
        "name": "徐俯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 231797,
      "title": "游潜峰二首  其一",
      "content": [
        "昔年会稽探尚书，探得六甲开山图。",
        "载之潜南天柱山，上侵霄汉下渊泉。",
        "真人秘语世不传，但见绝顶蒙云烟。",
        "汉武射蛟浮九江，舳舻千里来枞阳。",
        "筑坛祈仙瞻杳茫，茂陵桧柱空青苍。",
        "石牛一卧叱不起，白鹿还归深洞里。",
        "二月灵鹤有来时，洞口桃花泛流水。"
      ],
      "author": {
        "id": 1056,
        "name": "徐俯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 231798,
      "title": "游潜峰二首  其二",
      "content": [
        "久留舒子国，惯作北门游。",
        "山远三峰出，溪长二水流。"
      ],
      "author": {
        "id": 1056,
        "name": "徐俯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 231799,
      "title": "明皇夜游图",
      "content": [
        "歌吹开元曲，铅华天宝粧。",
        "苑风翠袖冷，宫露赭袍光。",
        "闺闼连阊阖，骅骝从骕骦。",
        "千门还欲晓，九陌乍闻香。"
      ],
      "author": {
        "id": 1056,
        "name": "徐俯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 231800,
      "title": "李贺晚归图",
      "content": [
        "近代推名画，诸君作荐书。",
        "皇都开艺学，博士是新除。",
        "高柳长安道，乱云昌谷居。",
        "丹青聊至此，仆马晚归欤。"
      ],
      "author": {
        "id": 1056,
        "name": "徐俯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 231801,
      "title": "饶守董尚书令画史绘释迦出山相及维摩居士使灵山香火之因不断复惠腊药数种皆病夫所欲也作此寄之",
      "content": [
        "示病毗耶金粟影，出山五祖金仙相。",
        "神妙通灵顾虎头，白莲香火空诸妄。",
        "腊中发药补衰朽，扶杖清风看花柳。",
        "捷书政用此时来，开颜正尔难忘酒。",
        "韩门弟子更谁如，即今犹有董安于。",
        "更有承明两学士，与公相对白髭须。"
      ],
      "author": {
        "id": 1056,
        "name": "徐俯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 231802,
      "title": "成生山水画歌",
      "content": [
        "画水不画湿，画山不画坚。",
        "盈尺之纸数寸管，便有江湖万里天。",
        "成生貎古心亦古，造化为工笔端取。",
        "玄冬起雷夏造冰，翻手作云覆手雨。",
        "岭外荒山与野水，自昔不闻传画史。",
        "只画潇湘与洞庭，于今却在兵戈里。",
        "翠峰碧嶂鬰然来，病眼愁心次第开。",
        "人家浦溆扁舟渡，何日真能到一回。"
      ],
      "author": {
        "id": 1056,
        "name": "徐俯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 231803,
      "title": "次韵可师题于逢辰画山水二首  其一",
      "content": [
        "江汉逾千里，阴晴自一川。",
        "故山黄叶下，梦境白鸥前。",
        "巫峡常云雨，香炉旧紫烟。",
        "布帆无恙在，速上钓鱼船。"
      ],
      "author": {
        "id": 1056,
        "name": "徐俯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 231804,
      "title": "次韵可师题于逢辰画山水二首  其二",
      "content": [
        "席上浮三楚，毫端会百川。",
        "名今大年亚，意古惠崇前。",
        "竟日对秋色，无时散暝烟。",
        "知君不浪语，一眼认归船。"
      ],
      "author": {
        "id": 1056,
        "name": "徐俯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 231805,
      "title": "单老画树石山水歌",
      "content": [
        "老树笔间生，奇石笔下出。",
        "浓淡高低远近山，阴晴朝暮烟云没。",
        "漠漠江天杳杳空，不劳施力自然中。",
        "便于沙际寻归路，却怪霜林叶不红。"
      ],
      "author": {
        "id": 1056,
        "name": "徐俯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 231806,
      "title": "画虎行为吉州假守苏公作",
      "content": [
        "昔日何人画於菟，君家独有他家无。",
        "宣城老包骨已朽，纷纷俗子尚讙呼。",
        "大虎蹲踞小虎戏，目光注射百步外。",
        "名画多闻内府收，人间岂惜千金费。",
        "巉巉岩岩谷中石，老树穹枝拂秋色。",
        "锐头将军射不得，却挂江南使君壁。",
        "林间一啸四山风，麏惊狐号鸟堕空。",
        "不向南山随李广，只愁东海笑黄公。",
        "忆昔余顽少小时，先生教诵荆公诗。",
        "只今耆旧无新语，赖有庐山病可师。"
      ],
      "author": {
        "id": 1056,
        "name": "徐俯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 231807,
      "title": "再次韵题于生画豹二首  其一",
      "content": [
        "耽酒丰城客子，醉画山崦人家。",
        "他日营丘伯仲，高名远出长沙。"
      ],
      "author": {
        "id": 1056,
        "name": "徐俯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 231808,
      "title": "再次韵题于生画豹二首  其二",
      "content": [
        "彭蠡何限秋鴈，此君胸次为家。",
        "醉里举群飞出，著行排立平沙。"
      ],
      "author": {
        "id": 1056,
        "name": "徐俯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 231809,
      "title": "春日登眺游宝胜诸寺且观名画",
      "content": [
        "护法俨神龙，诸天拥梵宫。",
        "楼台春日丽，海岳画图雄。",
        "浦树重重绿，园花灼灼红。",
        "微风吹细雨，只在夕阳中。"
      ],
      "author": {
        "id": 1056,
        "name": "徐俯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 231810,
      "title": "次可师韵",
      "content": [
        "五湖出画师手，一叶浮渔父家。",
        "风里芙蓉野色，雨中鸿鴈汀沙。"
      ],
      "author": {
        "id": 1056,
        "name": "徐俯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 231811,
      "title": "白鹭洲",
      "content": [
        "金陵与庐陵，俱出白鹭洲。",
        "相望万里江，中同二水流。"
      ],
      "author": {
        "id": 1056,
        "name": "徐俯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 231812,
      "title": "双庙",
      "content": [
        "开元天宝间，衮衮见诸公。",
        "不闻张与许，名在台省中。"
      ],
      "author": {
        "id": 1056,
        "name": "徐俯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 231813,
      "title": "跋韩子苍代葛亚卿诗",
      "content": [
        "夏木阴阴欲放船，黄鹂啼了落花天。",
        "十诗尽说人间事，付与风流葛稚川。"
      ],
      "author": {
        "id": 1056,
        "name": "徐俯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 231814,
      "title": "访邹道卿故居",
      "content": [
        "履霜颇强徤，晨兴恣所适。",
        "两儿休篮舆，呼客同蜡屐。",
        "危桥出隘巷，凭高聊物色。",
        "蒿然但林莽，芜废长荆棘。",
        "井灶那复移，江山依旧碧。",
        "要知千载下，怀贤求所历。"
      ],
      "author": {
        "id": 1056,
        "name": "徐俯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 231815,
      "title": "诗一首",
      "content": [
        "人言春事已，我言未遽央。",
        "试向后湖去，菰叶如许长。"
      ],
      "author": {
        "id": 1056,
        "name": "徐俯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 231816,
      "title": "陪李泰发登洪川南楼",
      "content": [
        "十年不复上南楼，直为干戈作远游。",
        "满地江湖春入望，连天章贡水争流。",
        "青云聊尔居金马，紫气还应射斗牛。",
        "公是主人身是客，举觞登望得无愁。"
      ],
      "author": {
        "id": 1056,
        "name": "徐俯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 231817,
      "title": "昭州感梅公挚邹道乡遗迹",
      "content": [
        "正言邹子独留名，法从梅公尚有亭。",
        "药是苦言能治瘴，竹生屈曲坐看经。",
        "风前云似秋前赤，雨后山能烧后青。",
        "恋土怀乡频作恶，怀贤感旧叹飘零。"
      ],
      "author": {
        "id": 1056,
        "name": "徐俯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 231818,
      "title": "上郡守",
      "content": [
        "尚书八座贵，大使十州雄。",
        "仁民兼爱物，时雨及春风。"
      ],
      "author": {
        "id": 1056,
        "name": "徐俯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 231819,
      "title": "题画",
      "content": [
        "五日十日一水石，此言虽工盖其迹。",
        "请看天地开辟初，炼就日魂镕月魄。",
        "贵人费尽数寸管，中有江湖万里客。"
      ],
      "author": {
        "id": 1056,
        "name": "徐俯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 231820,
      "title": "安庆府",
      "content": [
        "君过秋浦正逢秋，亦到枞阳皖水头。",
        "九派先将明月去，三峰少为白云留。"
      ],
      "author": {
        "id": 1056,
        "name": "徐俯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 231821,
      "title": "喜王秀才见过小酌玩月",
      "content": [
        "君家近市，所见天咫。",
        "庭户之间，容光能几。",
        "莼蒲之中，江湖之涘。",
        "云碧万顷，长空千里。"
      ],
      "author": {
        "id": 1056,
        "name": "徐俯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 231822,
      "title": "太平州二首  其一",
      "content": [
        "便风击鼓太平州，斜日落帆大信口。",
        "二年两见黄山塔，平生不饮姑孰酒。"
      ],
      "author": {
        "id": 1056,
        "name": "徐俯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 231823,
      "title": "太平州二首  其二",
      "content": [
        "南人北人朝暮船，东梁西梁今古天。",
        "兹地何时复回首，溯流千里到家园。"
      ],
      "author": {
        "id": 1056,
        "name": "徐俯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 231824,
      "title": "诗一首",
      "content": [
        "云洞看云坐，月岩和月留。",
        "元来是野老，强唤作知州。"
      ],
      "author": {
        "id": 1056,
        "name": "徐俯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 231825,
      "title": "鄥子值风雨",
      "content": [
        "重湖浪正起，支川舟不行。",
        "急雨夜卧听，颠风昼眠惊。"
      ],
      "author": {
        "id": 1056,
        "name": "徐俯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 231826,
      "title": "清逸楼",
      "content": [
        "冯高览章贡，登楼见吴楚。",
        "帆远行尽山，江长流入雾。"
      ],
      "author": {
        "id": 1056,
        "name": "徐俯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 231827,
      "title": "庐陵中秋对月",
      "content": [
        "岭近山相属，江通水不流。",
        "无云方万里，有月正中秋。"
      ],
      "author": {
        "id": 1056,
        "name": "徐俯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 231828,
      "title": "司空山",
      "content": [
        "主簿峰高昔所见，司空山深初未游。",
        "但愿承平无路梗，不惮登涉寻岩幽。"
      ],
      "author": {
        "id": 1056,
        "name": "徐俯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 231829,
      "title": "舒州  其一",
      "content": [
        "昔为郡下客，曾借水边居。",
        "秋水月为昼，春风花作庐。"
      ],
      "author": {
        "id": 1056,
        "name": "徐俯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 231830,
      "title": "舒州  其二",
      "content": [
        "林依玉照远，云为石盆留。",
        "春色年年好，溪山事事幽。"
      ],
      "author": {
        "id": 1056,
        "name": "徐俯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 231831,
      "title": "昭州自强斋",
      "content": [
        "青芜且作弦歌地，白屋曾为将相家。",
        "莫倚田畴日富足，门标六戟自光华。"
      ],
      "author": {
        "id": 1056,
        "name": "徐俯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 231832,
      "title": "春日游湖上",
      "content": [
        "双飞燕子几时回，夹岸桃花蘸水开。",
        "春雨断桥人不渡，小舟撑出柳荫来。"
      ],
      "author": {
        "id": 1056,
        "name": "徐俯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 231833,
      "title": "渡彭蠡湖",
      "content": [
        "沙岸委蛇白，云林迤逦青。",
        "千山拥庐岳，百水会宫庭。",
        "旋食犹能饭，丛祠更乞灵。",
        "江湖万里浪，政尔片帆轻。"
      ],
      "author": {
        "id": 1056,
        "name": "徐俯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 231834,
      "title": "章江晚望",
      "content": [
        "水面无波千里镜，日斜倒影一溪红。",
        "渔舟不动飞鸟急，淡淡碧烟苹末风。"
      ],
      "author": {
        "id": 1056,
        "name": "徐俯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 231835,
      "title": "慈姥望夫二矶",
      "content": [
        "慈姥矶头秋雨声，望夫山下暮潮生。",
        "离鸾只说闺中事，舐犊谁知目下情。"
      ],
      "author": {
        "id": 1056,
        "name": "徐俯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 231836,
      "title": "句  其一",
      "content": [
        "平生功名心，夜窗短檠灯。"
      ],
      "author": {
        "id": 1056,
        "name": "徐俯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 231837,
      "title": "句  其二",
      "content": [
        "黄气远临天北极，紫宸位在殿中央。"
      ],
      "author": {
        "id": 1056,
        "name": "徐俯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 231838,
      "title": "句  其三",
      "content": [
        "谁家竹可款，何处酒难忘。"
      ],
      "author": {
        "id": 1056,
        "name": "徐俯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 231839,
      "title": "句  其四",
      "content": [
        "平生不喜刘蕡策，色色人中自有人。"
      ],
      "author": {
        "id": 1056,
        "name": "徐俯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 231840,
      "title": "句  其五",
      "content": [
        "字得苏黄妙，文薰班马香。"
      ],
      "author": {
        "id": 1056,
        "name": "徐俯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 231841,
      "title": "句  其六",
      "content": [
        "淮流涨后浊，汴水浅来清。"
      ],
      "author": {
        "id": 1056,
        "name": "徐俯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 231842,
      "title": "句  其七",
      "content": [
        "诗如云态度，人似柳风流。"
      ],
      "author": {
        "id": 1056,
        "name": "徐俯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 231843,
      "title": "句  其八",
      "content": [
        "字直千金师智永，句称八米继卢郎。"
      ],
      "author": {
        "id": 1056,
        "name": "徐俯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 231844,
      "title": "句  其九",
      "content": [
        "细落李花那可数，偶行芳草步因迟。"
      ],
      "author": {
        "id": 1056,
        "name": "徐俯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 231845,
      "title": "句  其一○",
      "content": [
        "四月麦穗如马尾，汤饼在眼粉可喜。"
      ],
      "author": {
        "id": 1056,
        "name": "徐俯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 231846,
      "title": "句  其一一",
      "content": [
        "疑是隔墙窥宋玉，巧如施粉妬何郎。"
      ],
      "author": {
        "id": 1056,
        "name": "徐俯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 231847,
      "title": "句  其一二",
      "content": [
        "金盏银台何足比。"
      ],
      "author": {
        "id": 1056,
        "name": "徐俯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 231848,
      "title": "句  其一三",
      "content": [
        "诗名空复满世间，白髯萧萧今老矣。"
      ],
      "author": {
        "id": 1056,
        "name": "徐俯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 231849,
      "title": "句  其一四",
      "content": [
        "江南旧时无腊梅，只是梅花对月开。"
      ],
      "author": {
        "id": 1056,
        "name": "徐俯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 231850,
      "title": "句  其一五",
      "content": [
        "古来石可砚。"
      ],
      "author": {
        "id": 1056,
        "name": "徐俯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 231851,
      "title": "句  其一六",
      "content": [
        "往事湖阴曲，浮生水上萍。"
      ],
      "author": {
        "id": 1056,
        "name": "徐俯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 231852,
      "title": "句  其一七",
      "content": [
        "游客乍惊人外境，居僧初识面前山。"
      ],
      "author": {
        "id": 1056,
        "name": "徐俯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 231853,
      "title": "句  其一八",
      "content": [
        "轻帆朝渡彭蠡泽，锦缆晚击松阳门。"
      ],
      "author": {
        "id": 1056,
        "name": "徐俯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 231854,
      "title": "句  其一九",
      "content": [
        "夜雨急还急，客愁深复深。"
      ],
      "author": {
        "id": 1056,
        "name": "徐俯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 231855,
      "title": "句  其二○",
      "content": [
        "青干霄外山千尺，碧入林间水一条。"
      ],
      "author": {
        "id": 1056,
        "name": "徐俯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 231856,
      "title": "句  其二一",
      "content": [
        "湖风渡彭蠡，山月宿吴城。"
      ],
      "author": {
        "id": 1056,
        "name": "徐俯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 231857,
      "title": "句  其二二",
      "content": [
        "鹤岭鸾冈空胜地，龙沙乌塔尽荒墟。"
      ],
      "author": {
        "id": 1056,
        "name": "徐俯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 231858,
      "title": "句  其二三",
      "content": [
        "玉立竹千亩，金垂橘万头。"
      ],
      "author": {
        "id": 1056,
        "name": "徐俯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 231859,
      "title": "句  其二四",
      "content": [
        "官事有时闲，江上每夷犹。"
      ],
      "author": {
        "id": 1056,
        "name": "徐俯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 231860,
      "title": "句  其二五",
      "content": [
        "此邦富山水，自昔少园池。"
      ],
      "author": {
        "id": 1056,
        "name": "徐俯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 231861,
      "title": "句  其二六",
      "content": [
        "竹暗乔公宅，林藏伍相祠。"
      ],
      "author": {
        "id": 1056,
        "name": "徐俯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 231862,
      "title": "句  其二七",
      "content": [
        "白水十丈瀑，吴塘千顷波。"
      ],
      "author": {
        "id": 1056,
        "name": "徐俯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 231863,
      "title": "句  其二八",
      "content": [
        "欲寻浙子水云客，共看皖江冰雪颜。"
      ],
      "author": {
        "id": 1056,
        "name": "徐俯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 231864,
      "title": "句  其二九",
      "content": [
        "乔公宅下路已没，皖伯峰前云未开。"
      ],
      "author": {
        "id": 1056,
        "name": "徐俯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 231865,
      "title": "句  其三○",
      "content": [
        "虎头玉照南北岭，麟角石盆三两峰。"
      ],
      "author": {
        "id": 1056,
        "name": "徐俯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 231866,
      "title": "句  其三一",
      "content": [
        "三百六旬了无事，七十二峰常对门。"
      ],
      "author": {
        "id": 1056,
        "name": "徐俯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 231867,
      "title": "句  其三二",
      "content": [
        "横舟千古枞阳水，一径沿容达观台。"
      ],
      "author": {
        "id": 1056,
        "name": "徐俯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
