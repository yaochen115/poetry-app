{
  "data": [
    {
      "id": 275079,
      "title": "泛溪",
      "content": [
        "曲渚回花舫，生衣卧向风。",
        "鸟飞溪色里，人语棹声中。",
        "余卉才分影，新蒲自作丛。",
        "前湾更幽绝，虽浅去犹通。"
      ],
      "author": {
        "id": 4645,
        "name": "朱庆余"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 275080,
      "title": "宿陈处士书斋",
      "content": [
        "结茅当此地，下马见高情。",
        "菰叶寒塘晚，杉阴白石明。",
        "向炉新茗色，隔雪远钟声。",
        "闲得相逢少，吟多寐不成。"
      ],
      "author": {
        "id": 4645,
        "name": "朱庆余"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 275081,
      "title": "上宣州沈大夫",
      "content": [
        "科名继世古来稀，高步何年下紫微。",
        "帝命几曾移重镇，时清犹望领春闱。",
        "登朝旧友常思见，开幕贤人并望归。",
        "今日得游风化地，却回沧海有光辉。"
      ],
      "author": {
        "id": 4645,
        "name": "朱庆余"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 275082,
      "title": "杭州送萧宝校书",
      "content": [
        "马识青山路，人随白浪船。",
        "别君犹有泪，学道谩经年。"
      ],
      "author": {
        "id": 4645,
        "name": "朱庆余"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 275083,
      "title": "送盛长史",
      "content": [
        "莫辞东路远，此别岂闲行。",
        "职处中军要，官兼上佐荣。",
        "野亭枫叶暗，秋水藕花明。",
        "拜省期将近，孤舟促去程。"
      ],
      "author": {
        "id": 4645,
        "name": "朱庆余"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 275084,
      "title": "宿道士观",
      "content": [
        "堂闭僊人影，空坛月露初。",
        "闲听道家子，盥漱读灵书。"
      ],
      "author": {
        "id": 4645,
        "name": "朱庆余"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 275085,
      "title": "湖州韩使君置宴",
      "content": [
        "老大成名仍足病，纵听丝竹也无欢。",
        "高情太守容闲坐，借与青山尽日看。"
      ],
      "author": {
        "id": 4645,
        "name": "朱庆余"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 275086,
      "title": "题僊游寺",
      "content": [
        "石抱龙堂藓石干，山遮白日寺门寒。",
        "长松瀑布饶奇状，曾有仙人驻鹤看。"
      ],
      "author": {
        "id": 4645,
        "name": "朱庆余"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 275087,
      "title": "宫词",
      "content": [
        "寂寂花时闭院门，美人相并立琼轩。",
        "含情欲说宫中事，鹦鹉前头不敢言。"
      ],
      "author": {
        "id": 4645,
        "name": "朱庆余"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 275088,
      "title": "公子行",
      "content": [
        "闲从结客冶游时，忘却红楼薄暮期。",
        "醉上黄金堤上去，马鞭捎断绿杨丝。"
      ],
      "author": {
        "id": 4645,
        "name": "朱庆余"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 275089,
      "title": "送陈摽",
      "content": [
        "满酌劝童仆，好随郎马蹄。",
        "春风慎行李，莫上白铜鞮。"
      ],
      "author": {
        "id": 4645,
        "name": "朱庆余"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 275090,
      "title": "寻古观",
      "content": [
        "僊观曾过知不远，花藏石室杳难寻。",
        "泉边白鹿闻人语，看过天坛渐入深。"
      ],
      "author": {
        "id": 4645,
        "name": "朱庆余"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 275091,
      "title": "南岭路",
      "content": [
        "越岭向南风景异，人人传说到京城。",
        "经冬来往不踏雪，尽在刺桐花下行。"
      ],
      "author": {
        "id": 4645,
        "name": "朱庆余"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 275092,
      "title": "陪江州李使君重阳宴百花亭",
      "content": [
        "闲携九日酒，共到百花亭。",
        "醉里求诗境，回看岛屿青。"
      ],
      "author": {
        "id": 4645,
        "name": "朱庆余"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 275093,
      "title": "上张水部",
      "content": [
        "出入门阑久，儿童亦有情。",
        "不忘将姓字，常说向公卿。",
        "每许连床坐，仍容并马行。",
        "恩深转无语，怀抱甚分明。"
      ],
      "author": {
        "id": 4645,
        "name": "朱庆余"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 275094,
      "title": "凤翔西池与贾岛纳凉",
      "content": [
        "四面无炎气，清池阔复深。",
        "蝶飞逢草住，鱼戏见人沉。",
        "拂石安茶器，移床选树阴。",
        "几回同到此，尽日得闲吟。"
      ],
      "author": {
        "id": 4645,
        "name": "朱庆余"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 275095,
      "title": "上汴州令狐相公",
      "content": [
        "罢相恩犹在，那容处静司。",
        "政严初领节，名重更因诗。",
        "公事巡营外，戎装拜勅时。",
        "恭闻长与善，应念出身迟。"
      ],
      "author": {
        "id": 4645,
        "name": "朱庆余"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 275096,
      "title": "送于中丞入蕃册立",
      "content": [
        "上马生边思，戎装别众僚。",
        "双旌衔命重，空碛去程遥。",
        "迥没沙中树，孤飞雪外雕。",
        "蕃庭过册礼，几日却回朝。"
      ],
      "author": {
        "id": 4645,
        "name": "朱庆余"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 275097,
      "title": "送淮阴丁明府",
      "content": [
        "之官未入境，已有爱人心。",
        "遣吏回中路，停舟对远林。",
        "岛声淮浪静，雨色稻苗深。",
        "暇日公门掩，唯应伴客吟。"
      ],
      "author": {
        "id": 4645,
        "name": "朱庆余"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 275098,
      "title": "送韦校书佐灵州幕",
      "content": [
        "共知行处乐，犹惜此时分。",
        "职已为书记，官曾校典坟。",
        "寒城初落叶，高戍远生云。",
        "边事何须问，深谋祗在君。"
      ],
      "author": {
        "id": 4645,
        "name": "朱庆余"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 275099,
      "title": "上江州李史君",
      "content": [
        "起家声望重，自古更谁过。",
        "得在朝廷少，还因谏诤多。",
        "经年愁瘴疠，几处遇恩波。",
        "入境无余事，唯闻父老歌。"
      ],
      "author": {
        "id": 4645,
        "name": "朱庆余"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 275100,
      "title": "发凤翔后涂中怀田少府",
      "content": [
        "识君春未半，意欲住经秋。",
        "见酒连诗句，逢花跋马头。",
        "别来唯独宿，梦里尚同游。",
        "所在求飧过，无因离得愁。"
      ],
      "author": {
        "id": 4645,
        "name": "朱庆余"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 275101,
      "title": "雪夜与真上人宿韩协律宅",
      "content": [
        "斜雪微霑砌，空堂夜语清。",
        "逆风听漏短，回烛向楼明。",
        "盥漱随禅伴，讴吟得野情。",
        "此欢那敢忘，世贵丈夫名。"
      ],
      "author": {
        "id": 4645,
        "name": "朱庆余"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 275102,
      "title": "与贾岛顾非熊无可上人宿万年姚少府宅",
      "content": [
        "莫厌通宵坐，贫中会聚难。",
        "堂虚雪气入，灯在漏声残。",
        "役思因生病，当禅岂觉寒。",
        "开门各有事，非不惜余欢。"
      ],
      "author": {
        "id": 4645,
        "name": "朱庆余"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 275103,
      "title": "震为苍筤竹",
      "content": [
        "为擢东方秀，修然异众筠。",
        "青苍才映粉，蒙密正含春。",
        "嫩箨霑微雨，幽根绝细尘。",
        "乍怜分径小，偏觉带烟新。",
        "结实皆留凤，垂阴似庇人。",
        "顾唯竿在手，深水挂頳鳞。"
      ],
      "author": {
        "id": 4645,
        "name": "朱庆余"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 275104,
      "title": "题青龙寺",
      "content": [
        "寺好因岗势，登临值夕阳。",
        "青山当佛阁，红叶满僧廊。",
        "竹色连平地，虫声在上方。",
        "最怜东面静，为近楚城墙。"
      ],
      "author": {
        "id": 4645,
        "name": "朱庆余"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 275105,
      "title": "送滕庶子致仕归江南",
      "content": [
        "常怀独往意，此日去朝簪。",
        "丹诏荣归骑，清风满故林。",
        "诸侯新起敬，遗老重相寻。",
        "在处饶山水，堪行慰所心。"
      ],
      "author": {
        "id": 4645,
        "name": "朱庆余"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 275106,
      "title": "夏日题武功姚主簿",
      "content": [
        "亭午无公事，垂帘树色间。",
        "僧来茶灶动，吏去印床闲。",
        "傍竹行寻巷，当门立看山。",
        "吟诗老不倦，未省话官班。"
      ],
      "author": {
        "id": 4645,
        "name": "朱庆余"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 275107,
      "title": "送张景宣下第东归",
      "content": [
        "归省值花时，闲吟落第诗。",
        "高情怜道在，公论觉才遗。",
        "春雨连淮暗，私船过马迟。",
        "离心可惆怅，为有入城期。"
      ],
      "author": {
        "id": 4645,
        "name": "朱庆余"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 275108,
      "title": "送顾非熊下第归",
      "content": [
        "但取诗名远，宁论下第频。",
        "惜为今日别，共受几年贫。",
        "听雨宿吴寺，过江逢越人。",
        "知从本府荐，秋晚又辞亲。"
      ],
      "author": {
        "id": 4645,
        "name": "朱庆余"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 275109,
      "title": "送韦繇校书赴浙东幕",
      "content": [
        "丞相辟书新，秋关独去人。",
        "官离芸阁早，名占甲科频。",
        "水驿迎船火，山城候骑尘。",
        "湖边寄家久，到日喜荣亲。"
      ],
      "author": {
        "id": 4645,
        "name": "朱庆余"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 275110,
      "title": "寻贾岛所居",
      "content": [
        "求闲身未得，此日到京东。",
        "独在钟声外，相逢树色中。",
        "谁言人渐老，所向意皆同。",
        "月上因留宿，移床对药丛。"
      ],
      "author": {
        "id": 4645,
        "name": "朱庆余"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 275111,
      "title": "题毗陵上人院",
      "content": [
        "院深终日静，落叶覆秋虫。",
        "盥漱新斋后，修行未老中。",
        "映松山色远，隔水磬声通。",
        "此处宜清夜，高吟永与同。"
      ],
      "author": {
        "id": 4645,
        "name": "朱庆余"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 275112,
      "title": "送李侍御入蕃",
      "content": [
        "远使随双节，新官属外台。",
        "戎装非好武，书记本多才。",
        "移帐依泉宿，迎人带雪来。",
        "心知玉关道，稀见一花开。"
      ],
      "author": {
        "id": 4645,
        "name": "朱庆余"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 275113,
      "title": "望萧关",
      "content": [
        "渐见风沙暗，萧关欲到时。",
        "儿童能探火，妇女解缝旗。",
        "川绝衔鱼鹭，林多带箭麋。",
        "暂来戎马地，不敢苦吟诗。"
      ],
      "author": {
        "id": 4645,
        "name": "朱庆余"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 275114,
      "title": "送韩校书赴江西幕",
      "content": [
        "从军五湖外，终是称诗人。",
        "酒后愁将别，涂中过却春。",
        "山桥槲叶暗，水馆燕巢新。",
        "驿舫迎应远，京书寄自频。",
        "野情随到处，公务日关身。",
        "久共趋名利，龙钟独滞秦。"
      ],
      "author": {
        "id": 4645,
        "name": "朱庆余"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 275115,
      "title": "题寄王秘书",
      "content": [
        "唯求买药价，此外更无机。",
        "扶病看红叶，辞官著白衣。",
        "断篱通野径，高树荫邻扉。",
        "时复留僧宿，余人得见稀。"
      ],
      "author": {
        "id": 4645,
        "name": "朱庆余"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 275116,
      "title": "山居",
      "content": [
        "归来青壁下，又见满篱霜。",
        "转觉琴斋静，闲从菊地荒。",
        "山泉共鹿饮，林果让僧尝。",
        "时复收新药，随云过石梁。"
      ],
      "author": {
        "id": 4645,
        "name": "朱庆余"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 275117,
      "title": "重过惟贞上人院",
      "content": [
        "老去唯求静，都忘外学名。",
        "扫床秋叶满，对客远云生。",
        "香合闲留宿，晴阶暖共行。",
        "窗西暮山色，依旧入诗情。"
      ],
      "author": {
        "id": 4645,
        "name": "朱庆余"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 275118,
      "title": "与石昼秀才过普照寺",
      "content": [
        "问人知寺路，松竹暗春山。",
        "潭黑龙应在，巢空鹤未还。",
        "经年为客倦，半日与僧闲。",
        "更共尝新茗，闻钟笑语间。"
      ],
      "author": {
        "id": 4645,
        "name": "朱庆余"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 275119,
      "title": "题任处士幽居",
      "content": [
        "惜与幽人别，停舟对草堂。",
        "湖云侵卧位，杉露滴茶床。",
        "山月吟时在，池花觉后香。",
        "生涯无一物，谁与读书粮。"
      ],
      "author": {
        "id": 4645,
        "name": "朱庆余"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 275120,
      "title": "送僧往太原谒李司空",
      "content": [
        "已共邻房别，应无更住心。",
        "中时过野店，后夜宿寒林。",
        "寺去人烟远，城连塞雪深。",
        "禅余得新句，堪对上公吟。"
      ],
      "author": {
        "id": 4645,
        "name": "朱庆余"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 275121,
      "title": "将之上京别淮南书记李侍御",
      "content": [
        "心地偶相见，语多为别难。",
        "诗成公府晚，路入翠微寒。",
        "逢石自应坐，有花谁共看。",
        "身为当去鴈，云尽到长安。"
      ],
      "author": {
        "id": 4645,
        "name": "朱庆余"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 275122,
      "title": "韩协律相送精舍读书四韵奉寄呈陆补阙",
      "content": [
        "白鹤西山别，更看上去船。",
        "遥知寻寺路，应念宿江烟。",
        "到处无闲日，回期已隔年。",
        "何因陪夜坐，清论谏臣边。"
      ],
      "author": {
        "id": 4645,
        "name": "朱庆余"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 275123,
      "title": "过苏州晓上人院",
      "content": [
        "夏满律当清，无中景自生。",
        "移松不避远，取石亦亲行。",
        "经案离时少，绳床著处平。",
        "若将林下比，应只欠泉声。"
      ],
      "author": {
        "id": 4645,
        "name": "朱庆余"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 275124,
      "title": "送僧游缙云",
      "content": [
        "但望青山去，何山不是缘。",
        "寺幽堪讲律，月冷称当禅。",
        "水落无风夜，猨吟欲雨天。",
        "寻师若有路，终作缓归年。"
      ],
      "author": {
        "id": 4645,
        "name": "朱庆余"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 275125,
      "title": "赠道者",
      "content": [
        "自识来清瘦，寻常语论真。",
        "药成休伏火，符验不传人。",
        "独有年过鹤，曾无病到身。",
        "潜教问弟子，居处与谁邻。"
      ],
      "author": {
        "id": 4645,
        "name": "朱庆余"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 275126,
      "title": "杭州卢录事山亭",
      "content": [
        "山色满公署，到来诗景饶。",
        "解衣临曲榭，隔竹见红蕉。",
        "清漏焚香夕，轻岚视事朝。",
        "静中看锁印，高处见迎潮。",
        "曳履庭芜近，当身树叶飘。",
        "傍城余菊在，步入一僊瓢。"
      ],
      "author": {
        "id": 4645,
        "name": "朱庆余"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 275127,
      "title": "送品上人入秦",
      "content": [
        "独去何人见，林塘共寂寥。",
        "生缘闻磬早，觉路出尘遥。",
        "江雪霑新草，秦园发故条。",
        "心知禅定处，石室对芭蕉。"
      ],
      "author": {
        "id": 4645,
        "name": "朱庆余"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 275128,
      "title": "题蔷薇花",
      "content": [
        "四面垂条密，浮阴入夏清。",
        "绿攒伤手刺，红堕断肠英。",
        "粉著蜂须腻，光凝蝶翅明。",
        "雨中看亦好，况复值初晴。"
      ],
      "author": {
        "id": 4645,
        "name": "朱庆余"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 275129,
      "title": "题胡氏溪亭",
      "content": [
        "亭与溪相近，无时不有风。",
        "涧松生便黑，野藓看多红。",
        "雨足秋声后，山沈夜色中。",
        "主人能守静，略与客心同。"
      ],
      "author": {
        "id": 4645,
        "name": "朱庆余"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 275130,
      "title": "看涛",
      "content": [
        "不知来远近，但见白峨峨。",
        "风雨驱寒玉，鱼龙迸上波。",
        "声长势未尽，晓去夕还过。",
        "要路横天堑，其如造化何。"
      ],
      "author": {
        "id": 4645,
        "name": "朱庆余"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 275131,
      "title": "和刘补阙秋园寓兴之什十首 一",
      "content": [
        "闲园清气满，新兴日堪追。",
        "隔水蝉鸣后，当簷鴈过时。",
        "雨余槐穟重，霜近药苗衰。",
        "不以朝簪贵，多将野客期。"
      ],
      "author": {
        "id": 4645,
        "name": "朱庆余"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 275132,
      "title": "和刘补阙秋园寓兴之什十首 二",
      "content": [
        "谁言高静意，不异在衡茅。",
        "竹冷人离洞，天晴鹤出巢。",
        "深篱藏白菌，荒蔓露青匏。",
        "几见中宵月，清光坠树梢。"
      ],
      "author": {
        "id": 4645,
        "name": "朱庆余"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 275133,
      "title": "和刘补阙秋园寓兴之什十首 三",
      "content": [
        "逍遥人事外，杖屦入杉萝。",
        "草色寒犹在，虫声晚渐多。",
        "静逢山鸟下，幽称野僧过。",
        "几许新开菊，闲从落叶和。"
      ],
      "author": {
        "id": 4645,
        "name": "朱庆余"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 275134,
      "title": "和刘补阙秋园寓兴之什十首 四",
      "content": [
        "留情清景宴，朝罢有余闲。",
        "蝶散红兰外，萤飞白露间。",
        "墙高微见寺，林静远分山。",
        "吟足期相访，残阳自掩关。"
      ],
      "author": {
        "id": 4645,
        "name": "朱庆余"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 275135,
      "title": "和刘补阙秋园寓兴之什十首 五",
      "content": [
        "深斋尝独处，讵肯厌秋声。",
        "翠筿寒愈静，孤花晚更明。",
        "每因逢石坐，多见抱书行。",
        "入夜听疎杵，遥知耿此情。"
      ],
      "author": {
        "id": 4645,
        "name": "朱庆余"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 275136,
      "title": "和刘补阙秋园寓兴之什十首 六",
      "content": [
        "苍翠经宵在，园庐景自深。",
        "风凄欲去燕，月思向来砧。",
        "碧石当莎迳，寒烟冒竹林。",
        "桮瓢闲寄咏，清绝是知音。"
      ],
      "author": {
        "id": 4645,
        "name": "朱庆余"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 275137,
      "title": "和刘补阙秋园寓兴之什十首 七",
      "content": [
        "门巷唯苔藓，谁言不称贫。",
        "台闲人下晚，果熟鸟来频。",
        "石脉潜通井，松枝静离尘。",
        "残蔬得晴后，又见一番新。"
      ],
      "author": {
        "id": 4645,
        "name": "朱庆余"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 275138,
      "title": "和刘补阙秋园寓兴之什十首 八",
      "content": [
        "卷帘天色静，近濑觉衣单。",
        "蕉叶犹停翠，桐阴已爽寒。",
        "云从高处望，琴爱静时弹。",
        "正去重阳近，吟秋意未阑。"
      ],
      "author": {
        "id": 4645,
        "name": "朱庆余"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 275139,
      "title": "和刘补阙秋园寓兴之什十首 九",
      "content": [
        "竹迳通邻圃，清深称独游。",
        "虫丝交影细，藤子坠声幽。",
        "积润苔纹厚，迎寒荠叶稠。",
        "闲来寻古画，未废执茶瓯。"
      ],
      "author": {
        "id": 4645,
        "name": "朱庆余"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 275140,
      "title": "和刘补阙秋园寓兴之什十首 十",
      "content": [
        "风物已萧飒，晚烟生霁容。",
        "斜分紫陌树，远隔翠微钟。",
        "宿客论文静，闲灯落烬重。",
        "无穷林下意，真得古人风。"
      ],
      "author": {
        "id": 4645,
        "name": "朱庆余"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 275141,
      "title": "上翰林蒋防舍人",
      "content": [
        "清重可过知内制，从前礼绝外庭人。",
        "看花在处多随驾，召宴无时不及旬。",
        "马自赐来骑觉稳，诗缘得后意长新。",
        "应怜独在文场久，十有余年浪过春。"
      ],
      "author": {
        "id": 4645,
        "name": "朱庆余"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 275142,
      "title": "上翰林李舍人",
      "content": [
        "记得早年曾拜识，便怜孤进赏文章。",
        "免令汩没慙时辈，与作声名彻举场。",
        "一自凤池承密旨，今因世路接余光。",
        "云泥虽隔思长在，纵使无成也不忘。"
      ],
      "author": {
        "id": 4645,
        "name": "朱庆余"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 275143,
      "title": "题章正字道正新居",
      "content": [
        "独在御楼南畔住，生涯还似旧时贫。",
        "全无竹可侵行迳，一半花犹属别人。",
        "吟处不妨嫌鼓闹，眼前唯称与僧邻。",
        "近来渐觉青莎巷，车马过从已有尘。"
      ],
      "author": {
        "id": 4645,
        "name": "朱庆余"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 275144,
      "title": "送李余及第归蜀",
      "content": [
        "从得高科名转盛，亦言归去满城知。",
        "发时谁不开筵送，到处人争与马骑。",
        "剑路红蕉明栈阁，巴村绿树荫神祠。",
        "乡中后辈游门馆，半是来求近日诗。"
      ],
      "author": {
        "id": 4645,
        "name": "朱庆余"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 275145,
      "title": "送唐中丞开淘西湖夏日游泛因书示郡人",
      "content": [
        "萍岸新淘见碧霄，中流相去忽成遥。",
        "空余孤屿来诗景，无复横槎碍柳条。",
        "红斾路幽山翠湿，锦帆风起浪花飘。",
        "共知浸润同雷泽，何虑川源有旱苗。"
      ],
      "author": {
        "id": 4645,
        "name": "朱庆余"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 275146,
      "title": "过旧宅",
      "content": [
        "古巷戟门谁旧宅，早曾闻说属官家。",
        "更无新燕来巢屋，唯有闲人去看花。",
        "空廐欲摧尘满枥，小池初涸草侵沙。",
        "荣华事歇皆如此，立马踟蹰到日斜。"
      ],
      "author": {
        "id": 4645,
        "name": "朱庆余"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 275147,
      "title": "鄂渚送白舍人赴杭州",
      "content": [
        "岂知鹦鹉洲边路，得见凤皇池上人。",
        "从此不同诸客礼，故乡西与郡城邻。"
      ],
      "author": {
        "id": 4645,
        "name": "朱庆余"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 275148,
      "title": "题崔驸马林亭",
      "content": [
        "选居幽近御街东，易得诗人聚会同。",
        "白练鸟飞深竹里，朱弦琴在乱书中。",
        "亭开山色当高枕，楼静箫声落远风。",
        "何事宦涂犹寂寞，都缘清苦道难通。"
      ],
      "author": {
        "id": 4645,
        "name": "朱庆余"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 275149,
      "title": "赠韩协律",
      "content": [
        "永日微吟在竹前，骨清唯爱漱寒泉。",
        "门闲多有投文客，身病长无买药钱。",
        "岭寺听猨频独宿，湖亭避宴动经年。",
        "亲知尽怪疎荣禄，的是将心暗学禅。"
      ],
      "author": {
        "id": 4645,
        "name": "朱庆余"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 275150,
      "title": "自萧关望临洮",
      "content": [
        "玉关西路出临洮，风卷边沙入马毛。",
        "寺寺院中无竹树，家家壁上有弓刀。",
        "惟怜战士垂金甲，不尚游人著白袍。",
        "日暮独吟秋色里，平原一望戍楼高。"
      ],
      "author": {
        "id": 4645,
        "name": "朱庆余"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 275151,
      "title": "送崔约下第归淮南觐省",
      "content": [
        "远忆拜亲留不住，出门行计与谁同。",
        "程涂半是依船上，请谒多愁值雨中。",
        "堰水静连隄树绿，村桥时映野花红。",
        "回期须及来春事，莫便江边逐钓翁。"
      ],
      "author": {
        "id": 4645,
        "name": "朱庆余"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 275152,
      "title": "羽林郎",
      "content": [
        "紫髯年少奉恩初，直合将军尽不如。",
        "酒后引兵围百草，风前驻斾领边书。",
        "宅将公主同时赐，官与中郎共日除。",
        "大笑鲁儒年四十，腰间犹未识金鱼。"
      ],
      "author": {
        "id": 4645,
        "name": "朱庆余"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 275153,
      "title": "归故园",
      "content": [
        "桑柘骈阗数亩间，门前五柳正堪攀。",
        "尊中美酒长须满，身外浮名总是闲。",
        "竹迳有时风为扫，柴门无事日常关。",
        "于焉已是忘机地，何用将金别买山。"
      ],
      "author": {
        "id": 4645,
        "name": "朱庆余"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 275154,
      "title": "同友人看花",
      "content": [
        "寻花不问春深浅，纵是残红也入诗。",
        "每个树边行一匝，谁家园里最多时。"
      ],
      "author": {
        "id": 4645,
        "name": "朱庆余"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 275155,
      "title": "种花",
      "content": [
        "忆昔两京官道上，可怜桃李昼阴垂。",
        "不知谁作巡花使，空记玄宗遣种时。"
      ],
      "author": {
        "id": 4645,
        "name": "朱庆余"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 275156,
      "title": "早发庐江涂中遇雪寄李侍御",
      "content": [
        "芦苇声多雁满陂，湿云连野见山稀。",
        "遥知将吏相逢处，半是春城贺雪归。"
      ],
      "author": {
        "id": 4645,
        "name": "朱庆余"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 275157,
      "title": "登望云亭招友",
      "content": [
        "日日恐无云可望，不辞逐静望来频。",
        "共知亭下眠云远，解到上头能几人。"
      ],
      "author": {
        "id": 4645,
        "name": "朱庆余"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 275158,
      "title": "刘补阙西亭晚宴",
      "content": [
        "虫声已尽菊花干，共立松阴向晚寒。",
        "对酒看山俱惜去，不知斜月下栏干。"
      ],
      "author": {
        "id": 4645,
        "name": "朱庆余"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 275159,
      "title": "送长安罗少府",
      "content": [
        "科名再得年犹少，今日休官更觉贤。",
        "去国已辞趋府伴，向家还入渡江船。",
        "雪晴新雁斜行出，潮落残云远色鲜。",
        "在处若逢山水住，到时应不及秋前。"
      ],
      "author": {
        "id": 4645,
        "name": "朱庆余"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 275160,
      "title": "林下招胡长官",
      "content": [
        "语低清貌似休粮，称著朱衣入草堂。",
        "销暑近来无别物，桂阴当午满绳床。"
      ],
      "author": {
        "id": 4645,
        "name": "朱庆余"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 275161,
      "title": "与真上人一二禅师题玢寺主院",
      "content": [
        "杖屦相随任处便，不唯空寄上方眠。",
        "归时亦取湖边路，晚映枫林共上船。"
      ],
      "author": {
        "id": 4645,
        "name": "朱庆余"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 275162,
      "title": "寻僧",
      "content": [
        "吟背春城出草迟，天晴紫阁赴僧期。",
        "山边树下行人少，一派新泉日午时。"
      ],
      "author": {
        "id": 4645,
        "name": "朱庆余"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 275163,
      "title": "题王丘长史宅",
      "content": [
        "更无人吏在门前，不似居官似学僊。",
        "药气暗侵朝服上，花阴晚到簿书边。",
        "玉琴闲把看山坐，筒簟长铺与客眠。",
        "时见街中骑瘦马，低头只是为诗篇。"
      ],
      "author": {
        "id": 4645,
        "name": "朱庆余"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 275164,
      "title": "寄刘少府",
      "content": [
        "唯爱图书兼古器，在官犹自未离贫。",
        "更闻县去青山近，称与诗人作主人。"
      ],
      "author": {
        "id": 4645,
        "name": "朱庆余"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 275165,
      "title": "哭胡遇",
      "content": [
        "寻僧昨日尚相随，忽见绯幡意可知。",
        "题处旧诗休更读，买来新马忆曾骑。",
        "不应随分空营奠，终拟求人与立碑。",
        "每向宣阳里中过，遥闻哭临泪先垂。"
      ],
      "author": {
        "id": 4645,
        "name": "朱庆余"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 275166,
      "title": "自述",
      "content": [
        "诗人甘寂寞，居处遍苍苔。",
        "后夜蟾光满，邻家树影来。",
        "岂知莲帐好，自爱草堂开。",
        "愿答相思意，援毫愧不才。"
      ],
      "author": {
        "id": 4645,
        "name": "朱庆余"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 275167,
      "title": "省试晦日与同志昆明池泛舟",
      "content": [
        "故人同泛处，远色望中明。",
        "静见沙痕露，微思月魄生。",
        "周回余雪在，浩渺暮云平。",
        "戏鸟随兰棹，空波荡石鲸。",
        "劫灰难问理，岛树偶知名。",
        "自省曾追赏，无如此日情。"
      ],
      "author": {
        "id": 4645,
        "name": "朱庆余"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 275168,
      "title": "送崔拾遗赴阙",
      "content": [
        "清貌凌寒玉，朝来拜拾遗。",
        "行承天子诏，去感主人知。",
        "劒佩分班日，风霜独立时。",
        "名高住不得，非与九霄期。"
      ],
      "author": {
        "id": 4645,
        "name": "朱庆余"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 275169,
      "title": "酬李处士见赠",
      "content": [
        "干上非无援，才多却累身。",
        "云霄未得路，江海作闲人。",
        "久别唯谋道，相逢不话贫。",
        "行藏一如此，可便老风尘。"
      ],
      "author": {
        "id": 4645,
        "name": "朱庆余"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 275170,
      "title": "送僧游温州",
      "content": [
        "夏满随所适，江湖非系缘。",
        "卷经离峤寺，隔苇上秋船。",
        "水落无风夜，猨啼欲雨天。",
        "石门期独往，谢守有遗篇。"
      ],
      "author": {
        "id": 4645,
        "name": "朱庆余"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 275171,
      "title": "梦谢亭",
      "content": [
        "梦后何人见，孤亭似旧时。",
        "褰开诚得地，冥感竟因诗。",
        "不往过应少，悲来下独迟。",
        "顾慙非谢客，灵贶杳难追。"
      ],
      "author": {
        "id": 4645,
        "name": "朱庆余"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 275172,
      "title": "河亭",
      "content": [
        "孤亭临绝岸，猨鸟识幽蹊。",
        "花落曾谁到，诗成独未题。",
        "潮痕经雨在，石笋与杉齐。",
        "谢守便登陟，秋来屐齿低。"
      ],
      "author": {
        "id": 4645,
        "name": "朱庆余"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 275173,
      "title": "送吴秀才之山西",
      "content": [
        "泽潞西边路，兰桡北去人。",
        "出门谁恨别，投分不缘贫。",
        "桮酒从年少，知音在日新。",
        "东湖发诗意，夏卉竟如春。"
      ],
      "author": {
        "id": 4645,
        "name": "朱庆余"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 275174,
      "title": "和处州严郎中游南溪",
      "content": [
        "四望非人境，从前洞穴深。",
        "潭清蒲远岸，岚积树无阴。",
        "看草初移屐，扪萝忽并簪。",
        "世嫌山水僻，谁伴谢公吟。"
      ],
      "author": {
        "id": 4645,
        "name": "朱庆余"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 275175,
      "title": "秋宵䜩别卢侍御",
      "content": [
        "风亭弦管绝，玉漏一声新。",
        "绿茗香醒酒，寒灯静照人。",
        "清班无意恋，素业本来贫。",
        "明发青山道，谁逢去马尘。"
      ],
      "author": {
        "id": 4645,
        "name": "朱庆余"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 275176,
      "title": "酬于䜣校书见贻",
      "content": [
        "能□得从军，清嬴□□□。",
        "绮罗徒满目，山水不离心。",
        "暂别愁花老，相思倚竹阴。",
        "家贫无以养，未可话抽簪。"
      ],
      "author": {
        "id": 4645,
        "name": "朱庆余"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 275177,
      "title": "送石协律归吴兴别业",
      "content": [
        "识来无定居，此去复何如。",
        "一与耕者遇，转将朝客疎。",
        "资身唯药草，教子但诗书。",
        "曾许黄庭本，斯言岂合虚。"
      ],
      "author": {
        "id": 4645,
        "name": "朱庆余"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 275178,
      "title": "同卢校书游新兴寺",
      "content": [
        "山深云景别，有寺亦堪过。",
        "才子将迎远，林僧气性和。",
        "潭清蒲影定，松老鹤声多。",
        "岂不思公府，其如野兴何。"
      ],
      "author": {
        "id": 4645,
        "name": "朱庆余"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
