{
  "data": [
    {
      "id": 159493,
      "title": "陆龟蒙茶灶笔床图",
      "content": [
        "笠泽往来无定期，煮茶垂钓醉吟诗。",
        "一船清致终难画，不是散人应不知。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159494,
      "title": "公孙大娘舞剑图",
      "content": [
        "织手生风搅昼寒，好花翻影艳清欢。",
        "试看不犯锋铓处，舞碎晴空雪一团。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159495,
      "title": "张果老倒骑馿图",
      "content": [
        "云是尧时丙子生，狂踪怪迹恣幽情。",
        "拗馿面目不须看，一任骑来颠倒行。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159496,
      "title": "张志和渔父图",
      "content": [
        "苕霅春深花满溪，一钩翻动碧琉璃。",
        "蓑衣篛笠尽有意，不到斜风细雨知。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159497,
      "title": "蓝采和踏踏歌图",
      "content": [
        "踏踏歌中天地开，红颜春树莫相催。",
        "蓝袍转破转奇特，别看仙人舞一回。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159498,
      "title": "钟吕传道图",
      "content": [
        "钟吕喃喃手指空，应谈玄牝妙无穷。",
        "都来造化只半句，不在丹经文字中。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159499,
      "title": "吕洞宾卖墨图",
      "content": [
        "链就玄玄一块金，朝磨暮写愈精神。",
        "先生此墨初无价，不识谁为买墨人。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159500,
      "title": "沈东老遇吕洞宾图",
      "content": [
        "东老忘怀相遇时，洞宾烂醉以为期。",
        "聊题不涉毫端句，早被石榴皮得知。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159501,
      "title": "巴山橘中图",
      "content": [
        "剖破浑沦一壳宽，二仙飞去已云端。",
        "须知橘里封疆别，莫作凡间胜负看。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159502,
      "title": "中秋苦雨赵知微登天柱峰赏月图",
      "content": [
        "人爱中秋月色同，忽惊凉雨翳昏钟。",
        "如何只隔一重膜，不见仙家天柱峰。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159503,
      "title": "南柯蚁梦图",
      "content": [
        "忘了堂堂六尺身，鬼花生艳幻微春。",
        "绝怜蚁窟无分晓，迷尽古今多少人。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159504,
      "title": "崔护觅水图",
      "content": [
        "哭断东风转有情，俄惊满面笑容新。",
        "当时饮水今犹醉，别是桃花半点春。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159505,
      "title": "倩女离魂图",
      "content": [
        "有心谁怕铁为墙，直透虚空未易量。",
        "若问合离真伪事，满池绿水笑鸳鸯。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159506,
      "title": "崔智韬虎妻图",
      "content": [
        "佳人睡觉失青山，恶毒心肠卖笑颜。",
        "认得皮毛一归去，花枝无艳虎全斑。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159507,
      "title": "玉川长须赤脚图",
      "content": [
        "惯立煎茶屋角头，低眸频候雪花浮。",
        "一奴一婢亦作怪，不为先生破屋愁。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159508,
      "title": "陈抟睡图",
      "content": [
        "五季干戈乱似麻，慵将醒眼阅年华。",
        "齁齁一觉华山里，谁问春开几度花。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159509,
      "title": "逋仙探梅图",
      "content": [
        "雪压咸平处士家，冻云锁暝苦相遮。",
        "欲知天上春消息，只觅南枝第一花。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159510,
      "title": "苏东坡前赤壁赋图",
      "content": [
        "泛舟赤壁痛衔杯，孟德英豪安在哉。",
        "何似江山风月妙，不从自己外边来。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159511,
      "title": "李伯时所画太一真人莲叶舟图",
      "content": [
        "太一真人妙出神，聊乘莲叶下南冥。",
        "若人欲识空凉境，但诵薰风一卷经。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159512,
      "title": "无名氏巡簷数修竹图",
      "content": [
        "四簷玉立碧重重，终日相看眼亦空。",
        "何啻数来千万个，不知那个弄清风。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159513,
      "title": "锦钱余笑  其一",
      "content": [
        "有时业一笑，清于万壑冰。",
        "有时吐一语，浊于三月春。",
        "所以天地闲，不著如是人。",
        "任之波波走，永劫长沉沦。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 159514,
      "title": "锦钱余笑  其二",
      "content": [
        "昔有古先生，忒杀不唧溜。",
        "拈得一枝花，失却一张口。",
        "白昼叫不醒，徒尔打筋斗。",
        "若欲了此意，但饮一杯酒。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 159515,
      "title": "锦钱余笑  其三",
      "content": [
        "晚年阖闾国，侨寓陋巷屋。",
        "屋中无所有，事事不具足。",
        "终不借人口，伸舌觅饭吃。",
        "以此大恣纵，骂人笑吃吃。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 159516,
      "title": "锦钱余笑  其四",
      "content": [
        "山中一溪水，绝与众水别。",
        "不解饮清风，只解醉明月。",
        "一片清泠意，活动流不彻。",
        "何劳濯缨人，再三苦饶舌。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 159517,
      "title": "锦钱余笑  其五",
      "content": [
        "我家南山南，日月最相爱。",
        "清光泼面来，只是无人买。",
        "我昔买淂之，翻手恣买卖。",
        "山北诸草木，也只得礼拜。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 159518,
      "title": "锦钱余笑  其六",
      "content": [
        "佯狂真佯狂，踏碎东风影。",
        "一任东风吹，花意乱不定。",
        "閙閙人丛中，人人唤不应。",
        "借问老先生，莫教是姓郑。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 159519,
      "title": "锦钱余笑  其七",
      "content": [
        "头戴烂纱巾，脚踏破鞋底。",
        "不知以何道，琮琤宇宙里。",
        "或恐是达人，毋乃是痴子。",
        "我亦欲问之，面冷似铁鬼。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 159520,
      "title": "锦钱余笑  其八",
      "content": [
        "我有一句子，朗朗最分明。",
        "问水水亦笑，问石石亦嗔。",
        "独有老枯树，闻之弥精神。",
        "从此开笑面，恼杀天下人。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 159521,
      "title": "锦钱余笑  其九",
      "content": [
        "崛强数十年，只弄一枝笔。",
        "笔是无根花，日月常结实。",
        "千千万万颗，颗颗如红日。",
        "日日采将来，布施十方佛。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 159522,
      "title": "锦钱余笑  其一○",
      "content": [
        "苍蝇亦奇哉，腹内矢何物。",
        "黑者变为白，白者变为黑。",
        "不换人活眼，何以化流俗。",
        "我来阎浮提，却喜无此术。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 159523,
      "title": "锦钱余笑  其一一",
      "content": [
        "一火陶铸来，莫不皆完具。",
        "岂有一造化，而劳别父母。",
        "可怜生盲者，当面不辨主。",
        "此理甚无斁，唾汝化为土。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 159524,
      "title": "锦钱余笑  其一二",
      "content": [
        "不怕明日死，且喜今日活。",
        "拍响浪敲击，飞谑讯挑挞。",
        "直送双眼去，天外破毫末。",
        "卢都横上唇，口门八寸阔。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 159525,
      "title": "锦钱余笑  其一三",
      "content": [
        "三三即九九，数之何曾有。",
        "九九非三三，拈来不用参。",
        "满顶发䰐𩭹，满面骨岩巉。",
        "不知死日至，只是弄痴憨。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 159526,
      "title": "锦钱余笑  其一四",
      "content": [
        "巉巉岩谷中，尽谓是白石。",
        "一见一摩挲，老眼滴寒碧。",
        "绝无一点香，苍顶直坚立。",
        "当道横黄金，惜哉无人识。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 159527,
      "title": "锦钱余笑  其一五",
      "content": [
        "叫笑舞荒唐，面上生雪霜。",
        "一味呵呵笑，赤脚走四方。",
        "明月忽见憎，憎我太枯清。",
        "我亦骂明月，骂月弄光明。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 159528,
      "title": "锦钱余笑  其一六",
      "content": [
        "每爱入深山，最怕石路恶。",
        "剖树斫木屐，坚欲护双脚。",
        "即忙著将来，步步革落落。",
        "从教世上人，骂我错错错。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 159529,
      "title": "锦钱余笑  其一七",
      "content": [
        "二十余年来，非不喜饮酒。",
        "近日青天痴，也逐世人走。",
        "骂詈古冰雪，赞叹新花柳。",
        "安得不独行，鼻角插入口。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 159530,
      "title": "锦钱余笑  其一八",
      "content": [
        "飘飘山中行，与云同出没。",
        "饥来餐生石，入口细无骨。",
        "满吻流甘香，不嚼而味出。",
        "幽禽独赏音，数声不可忽。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 159531,
      "title": "锦钱余笑  其一九",
      "content": [
        "生来好苦吟，与天争意气。",
        "自谓李杜生，当趋下风避。",
        "而今吾老矣，无力收鼻涕。",
        "非惟不成文，抑且错写字。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 159532,
      "title": "锦钱余笑  其二○",
      "content": [
        "昔者所读书，皆已束高阁。",
        "只有自是经，今亦俱忘却。",
        "时乎歌一拍，不知是谁作。",
        "慎勿错听之，也且用不著。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 159533,
      "title": "锦钱余笑  其二一",
      "content": [
        "突然出身来，拨却青天转。",
        "击破古洪蒙，碎作七八片。",
        "片片生春风，散作花柳面。",
        "面面冷眼笑，何处不相见。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 159534,
      "title": "锦钱余笑  其二二",
      "content": [
        "顽绝绝顽绝，以笑为生业。",
        "刚道黑如炭，谁知白似雪。",
        "笑杀娑婆儿，尽逐光影灭。",
        "若无八角眼，岂识四方月。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 159535,
      "title": "锦钱余笑  其二三",
      "content": [
        "叫卖没底有，有价不敢道。",
        "拾得一块泥，胜如万块宝。",
        "如此至鹘突，直是不老草。",
        "逢人但点头，好好好好好。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 159536,
      "title": "锦钱余笑  其二四",
      "content": [
        "何待死方休，即今骨已朽。",
        "奇特动天地，也掷向背后。",
        "咄这臭矢囊，恣情开大口。",
        "几翻说得风，惊落虚空走。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 159537,
      "title": "题多景楼",
      "content": [
        "英雄登眺处，一剑独来游。",
        "男子抱奇气，中原入远谋。",
        "江分淮浙土，天阔楚吴秋。",
        "试望斜阳外，谁宽西顾忧。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 159538,
      "title": "逢陈宜之",
      "content": [
        "行李苦役役，相逢古润州。",
        "千金一夜醉，四海十年游。",
        "山静鬼行月，宵凉人梦秋。",
        "近闻边事急，畎亩得无忧。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 159539,
      "title": "送友人归",
      "content": [
        "年高雪满簪，唤渡浙江浔。",
        "花落一杯酒，月明千里心。",
        "凤凰身宇宙，麋鹿性山林。",
        "别后空回首，冥冥烟树深。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 159540,
      "title": "越州飞翼楼",
      "content": [
        "飞来绝顶上，流盼入无垠。",
        "国土东南阔，山川今古新。",
        "高楼临白日，平地载青春。",
        "直欲蓬莱去，因风问大钧。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 159541,
      "title": "书怀寄孟耐翁",
      "content": [
        "弓冶学不就，悠悠信所之。",
        "坐看浮世梦，吟白少年髭。",
        "树冷巢营鹊，山晴角解麋。",
        "覩兹岁又晚，而我独何为。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 159542,
      "title": "山中闻鹤",
      "content": [
        "凉夜坐岩石，飞来白鹤鸣。",
        "星流银弹过，月碾玉轮行。",
        "万里思不极，一天秋更清。",
        "欣然有所得，长啸度蓬瀛。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 159543,
      "title": "游观音山怀乡僧贵月溪",
      "content": [
        "天地一闲人，孤云自在身。",
        "去来心不碍，语默意俱深。",
        "山叠千层树，花连四望春。",
        "旧年同笑语，今日独登临。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 159544,
      "title": "重题多景楼",
      "content": [
        "无力可为用，登楼欲断魂。",
        "望西忧逆贼，指北说中原。",
        "粮运供淮饷，军行戍汉屯。",
        "何年遂所志，一统正乾坤。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 159545,
      "title": "送人之官",
      "content": [
        "烂醉拥貂裘，挥鞭跨紫骝。",
        "客途寒色重，边地月华愁。",
        "旌旆开前道，江山指别州。",
        "相逢俄作别，沧海一虚舟。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 159546,
      "title": "僧房夜坐",
      "content": [
        "说到死生处，令人羡出家。",
        "法身终不坏，浊世自无涯。",
        "梵夹金销字，经帘彩散花。",
        "拥炉待月上，溶雪煮春芽。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 159547,
      "title": "听琴",
      "content": [
        "洋洋盈耳间，一派水潺潺。",
        "意不随声尽，心应与物闲。",
        "宿云穿窦出，飞鸟御风还。",
        "却喜无人识，支颐看远山。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 159548,
      "title": "寄友人",
      "content": [
        "御街暂分手，相忆两相望。",
        "生意随春动，新诗入梦香。",
        "九天饶雨露，一水贯苏杭。",
        "地控衣冠会，声名日日彰。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 159549,
      "title": "别故人",
      "content": [
        "拍马又登程，余酣尚未醒。",
        "曙蟾消淡白，秋汉覆空青。",
        "江走游龙势，山蟠睡虎形。",
        "飘零毋感叹，天地亦浮萍。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 159550,
      "title": "就泛省留别",
      "content": [
        "歌声送晚酒匆匆，颇快青霄志已通。",
        "灯火几年成旧业，文章今日试新功。",
        "九天宫阙春城晓，万国轮蹄辇路风。",
        "每念苍生受辛苦，愿为霖雨白云中。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 159551,
      "title": "夏驾湖晚步怀古",
      "content": [
        "岂独吴王事可怜，人生回首总凄然。",
        "空嗟落日犹如梦，不记东风几换年。",
        "宝驾迹消前古地，菱歌声断晚凉船。",
        "如今城郭都迁变，茅屋荒颓草积烟。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 159552,
      "title": "睡觉有怀寄王梅坞垓",
      "content": [
        "向年治乱屡兴怀，此日清闲独把杯。",
        "千古英雄人不见，一楼风雨梦初回。",
        "空中变化观龙见，世上凄凉误凤来。",
        "须入山林了生死，莫将心迹付尘埃。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 159553,
      "title": "送人之行在",
      "content": [
        "歌断阳关奏暮笳，东风吹客向京华。",
        "三更舟度淞江月，一路春连上苑花。",
        "地逼星辰黄道近，山环宫殿紫云斜。",
        "兹游归计须宜早，莫遣相思梦绕家。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 159554,
      "title": "飘零",
      "content": [
        "飘零书剑十年吴，又见西风脱尽梧。",
        "万顷秋生杯后兴，数茎雪上镜中须。",
        "晴天空阔浮云尽，破屋荒凉俗梦无。",
        "惟有固穷心不改，左经右史足清娱。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 159555,
      "title": "怀归",
      "content": [
        "突兀高楼落照间，此身逈出俯人寰。",
        "客心不逐年华老，诗兴何曾月夜闲。",
        "峡水流归天际海，淮云飞度浙中山。",
        "杜鹃啼后归舟发，只有春愁满载还。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 159556,
      "title": "南山老松",
      "content": [
        "凌空独立挺精神，节操森森骨不尘。",
        "半夜波涛惊鹤梦，几番风雨护龙身。",
        "心贞宁受岁寒变，气老常涵古意新。",
        "终见取为梁栋去，紫烟空锁碧磷𥒘。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 159557,
      "title": "即事",
      "content": [
        "河朔杯多席莫逃，碧筩制酒饮儿曹。",
        "雨余地润南风爽，秋近宵凉北斗高。",
        "月下梦归吴苑路，天涯心绕浙江臯。",
        "灵均仙后无人怨，谁肯明时赋续骚。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 159558,
      "title": "访隠者",
      "content": [
        "石窦云封隠者家，一溪流水绕门斜。",
        "满山落叶无行路，树上寒猿剥藓花。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159559,
      "title": "春日登城",
      "content": [
        "城头啼鸟隔花鸣，城外游人傍水行。",
        "遥认孤帆何处去，柳塘烟重不分明。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159560,
      "title": "春词",
      "content": [
        "春气暄妍御夹纱，玉钗双袅绿云斜。",
        "倚栏看遍庭前树，尽是枝头结子花。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159561,
      "title": "怀友",
      "content": [
        "今日樽前忽忆君，为怜秋事又平分。",
        "坐来凝睇西风久，过尽天边数片云。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159562,
      "title": "春日游承天寺",
      "content": [
        "野梅香软雨新晴，来此闲听笑语声。",
        "不管少年人老去，春风岁岁阖闾城。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159563,
      "title": "赠老王道人",
      "content": [
        "曾宴瑶池王母家，瞳方鬓黑脸凝霞。",
        "休将甲子来相问，知见蟠桃几度花。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159564,
      "title": "书兰亭帖后",
      "content": [
        "千载流芳禊事余，鼠须笔法重璠玙。",
        "晋人多喜清虚话，不及兰亭一纸书。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159565,
      "title": "湖上漫赋二首  其一",
      "content": [
        "藓崖苍润雨初干，石罅飞泉喷雪寒。",
        "啼断禽声山更静，青松影下倚栏干。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159566,
      "title": "湖上漫赋二首  其二",
      "content": [
        "一望湖光镜面平，暮鸦过尽断霞轻。",
        "狂来飞上高峰顶，趺坐松柯叫月生。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159567,
      "title": "仙兴",
      "content": [
        "跣足蓬头烱碧瞳，划然长啸响天风。",
        "千岩万壑无人迹，独自飞行明月中。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159568,
      "title": "咏怀三首  其一",
      "content": [
        "读书陋巷中，愚直与时忤。",
        "一鹤仰天鸣，志不在尘土。",
        "有怀诸葛公，默然不发语。",
        "后世无斯人，清风激千古。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 159569,
      "title": "咏怀三首  其二",
      "content": [
        "居屋虽不大，终日心闲闲。",
        "口诵圣人书，立身仁义间。",
        "俯仰无愧怍，兹道诚为难。",
        "君子常进德，小人偷自安。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 159570,
      "title": "咏怀三首  其三",
      "content": [
        "驱车欲出门，独立眺虚旷。",
        "恣意杯酒间，舞剑心悲壮。",
        "虽在寂寞滨，心实千载上。",
        "天地固寥廓，亦当定所向。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 159571,
      "title": "吴江垂虹雨后观荷",
      "content": [
        "睡龙瞪目开，射光冯夷宫。",
        "翻身弄变化，噀水湿洪蒙。",
        "浪花卷寒雪，斜喷清泠风。",
        "雨歇龙归来，波心卧晴虹。",
        "净洗秋色出，霁景涵青空。",
        "烁烁锦炫昼，新绿妬娇红。",
        "湿香吹不飞，恋抱花心中。",
        "醉面仰天笑，月照三吴东。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 159572,
      "title": "虎丘",
      "content": [
        "何年海涌来，霹雳破地脉。",
        "裂透千仞深，嵌空削苍壁。",
        "山润石乳甘，秋冷铁花碧。",
        "阖闾云空愁，银虎去无迹。",
        "蛟龙镇奇险，拱护梵王宅。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 159573,
      "title": "寄萧梅初二首  其一",
      "content": [
        "韫匮玉未售，妄想夜生梦。",
        "风霜鬓鬅鬙，谈笑气澒洞。",
        "上天宫阙高，凡身血肉重。",
        "顾影无其俦，一呼四壁动。",
        "抱兹忠义心，惭与猿鹤共。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 159574,
      "title": "寄萧梅初二首  其二",
      "content": [
        "雁声杳然来，壮心惕然跃。",
        "委身坐枯静，飞语讯冥漠。",
        "会学屠龙技，岂授龟手药。",
        "学成无所用，举世亦错愕。",
        "孰云方寸微，天地入笼络。",
        "春阔花无边，雨骤云不薄。",
        "不齐臯夔肩，当跨孤飞鹤。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 159575,
      "title": "观雪",
      "content": [
        "吾独爱观雪，心与雪同色。",
        "清兴匝空朗，或语或时默。",
        "李白有狂才，飞笔写无极。",
        "惊倒天上人，世间晓不得。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 159576,
      "title": "古诗三首  其一",
      "content": [
        "笔田不丰年，百巧皆画餠。",
        "宿火潜永耀，奚慕脱囊颖。",
        "汲古饮玄味，至妙终身领。",
        "虚怀抱空明，爽语吐清泠。",
        "不将白日身，浪走红尘影。",
        "何当踏云飞，始信骅骝猛。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 159577,
      "title": "古诗三首  其二",
      "content": [
        "醉歌京华春，行迈心摇摇。",
        "孤云未致雨，随风南北飘。",
        "王国天地极，斡运四海遥。",
        "城中百万户，飞簷插紫霄。",
        "倾金买谀噱，仰面气宇骄。",
        "不重读书人，研苦坐寂寥。",
        "我欲封绿章，天门高岧峣。",
        "岂抱浩然气，长年而渔樵。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 159578,
      "title": "古诗三首  其三",
      "content": [
        "苍苍碧玉盘，乌兔东西趒。",
        "一气母群儿，各弄性情妙。",
        "雷动蛰龙飞，天老哀猿吊。",
        "俯首问洪蒙，万古一长啸。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 159579,
      "title": "秋歌",
      "content": [
        "凉风卷地吹秋来，秋之为气何清哉。",
        "紫箫露华浴万宇，暑神欲驻难裴回。",
        "今年舍我去者二百二十有五日，今日之后谁使来日来相催。",
        "琥珀满巵，发越清奇。",
        "万物脆而易化，五官灵而多知。",
        "一世之间几千万人，一人之心几千万变，碎裂神气纷云为。",
        "液槁矣而告惫，气翻然而相辞。",
        "适之变化，不知其谁。",
        "气母一丸，空虚跳跃。",
        "金浮木沉，老怪消铄。",
        "我之变化，亦不知谁。",
        "苍苍茫茫万万古，玄瞳烱歘夜不瞽。",
        "醉中唤秋与秋语，秋辞凄脆咽不吐。",
        "忽欲骑鲸汗漫游，海藏飞出白玉鼓。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 159580,
      "title": "春歌",
      "content": [
        "去年秋日作秋歌，今年春日奈春何。",
        "往春叠叠叠万古，来春冥冥春更多。",
        "青皇旌旆开天衢，三八二十四头苍龙车。",
        "大开东方宫殿坐，八荒之内交相贺。",
        "红紫茸茸烂如缬，回首柳花扑晴雪。",
        "造物弄人祗片时，弄死世人人不知。",
        "我心清泠湛无边，流光澒洞先天先。",
        "前身本在未铸日月前，黄面瞿昙，长耳老聃，乃吾无量劫后之孙。",
        "后身复现搦碎虚空后，当知所南先生为无量劫前之祖。",
        "人生精魄假合舞幻妄，纷如气丸趒尘土。",
        "偶然而来托为形，飘然而去若无主。",
        "今日之今，霍霍诩诩。",
        "少焉瞩之，已化为古。",
        "胡为堕影黄泗浦，独坐翛然看春雨。",
        "山苍苍，水茫茫，百岁劫劫太极长。",
        "我来濯形白云乡，大笑世上生颠狂。",
        "醉笔作歌字不讹，宛然苍蛟老蜃势相拏。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 159581,
      "title": "琴女行",
      "content": [
        "嫦娥开殿当高青，白光染夜生空明。",
        "望中泠泠莹如水，碧透肉镜双瞳子。",
        "窄袖笼春玉笋娇，援琴一鼓秋潇潇。",
        "瑶池女子旨趣别，紫清吹下太古雪。",
        "双鬟翠腻绾香雾，临风欲控青鸾羽。",
        "应悔思凡谪尘土，长向花前忆王母。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 159582,
      "title": "遇秋涧",
      "content": [
        "灵襟吐泄山川秀，擒勒造化归双手。",
        "玄云飞雨破青空，耸动万象鬼神走。",
        "我昔先人游荆州，曾同君醉江汉楼。",
        "手捉明月入口吞，足踏清风跨海游。",
        "于今二十二年后，古吴国中相邂逅。",
        "先人虽负一代名，不似先生今白首。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 159583,
      "title": "雪中醉题",
      "content": [
        "玄雪冥冥凝不飞，朔雪洒洒晴还落。",
        "水神恣意弄奇怪，宇宙一白阴风恶。",
        "南州客子心飘飖，狂发长歌破寂寥。",
        "醉中浏亮金石声，精神秀发意气骄。",
        "故人睨目嗔我怪，抚掌大笑群儿骇。",
        "我家万卷列中堂，古人颠怪皆曾载。",
        "须臾酒醒那得知，索纸落笔蛟龙飞。",
        "明晓火轮飞出海，来看壁上新题诗。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 159584,
      "title": "前雪歌",
      "content": [
        "玄冥玄玄玄又玄，一夜一尺平阶前。",
        "故现幻化瞒俗眼，忽变境界为神仙。",
        "弥望洁净失污秽，与世坦荡忘欹偏。",
        "混沌有影昼短短，穹窿无缝云悬悬。",
        "慢飘如倦欲止歇，斜洒似舞争便嬛。",
        "万物根蔕不可见，数笔图画安能传。",
        "诗战素手白相敌，酒潮赧脸红不鲜。",
        "老龟缩壳息饮气，卧龙哆口寒凝涎。",
        "木帝舍暖施下土，火精气驭行中天。",
        "须臾被野尽锦绣，四望四野春无边。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 159585,
      "title": "后雪歌",
      "content": [
        "不知今日是何年，忽然生白照无边。",
        "全体莹净妙无象，还我太极未分前。",
        "开口大笑说不得，一日一夜独自颠。",
        "与君同此光明域，有辞难铸玄中玄。",
        "醉吐大语吞六合，前古朽言无光鲜。",
        "浩然之气开虚空，举头渺渺皆青天。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 159586,
      "title": "岁旦登万佛阁观雪",
      "content": [
        "赤脚踏上万佛顶，全身坐断清净境。",
        "见大光明遍法界，不见三千大千影。",
        "一时八面俱玲珑，诸尘诸相本无踪。",
        "色不是色空不空，莹然塞破虚空中。",
        "怪见此番寒彻骨，无中弄得光芒出。",
        "蓦地省得大年朝，即是正月初一日。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 159587,
      "title": "火德",
      "content": [
        "火德续正统，东南气运昌。",
        "雒京都赤帝，鲁史笔天王。",
        "八极开清晓，群星避太阳。",
        "讴歌今有在，历数永无疆。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 159588,
      "title": "德祐二年岁旦二首  其一",
      "content": [
        "力不胜于胆，逢人空泪垂。",
        "一心中国梦，万古下泉诗。",
        "日近望犹见，天高问岂知。",
        "朝朝向南拜，愿覩汉旌旗。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 159589,
      "title": "德祐二年岁旦二首  其二",
      "content": [
        "有怀长不释，一语一酸辛。",
        "此地暂胡马，终身只宋民。",
        "读书成底事，报国是何人。",
        "耻见干戈里，荒城梅又春。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
