{
  "data": [
    {
      "id": 249487,
      "title": "白鹤亭",
      "content": [
        "萧散霖林下风，霜毛极清润。",
        "为问载高轩，何如弄闲影。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 249488,
      "title": "湖州张公济仰高亭",
      "content": [
        "苕溪霅溪磨青铜，南山北山无数峰。",
        "不知当用几钱买，罗列乃在君窗中。",
        "属官属私置莫问，但办一榻眠清风。",
        "烟波钓徒定乃祖，傥有渔舟吾请从。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 249489,
      "title": "寓轩",
      "content": [
        "故国例卜宅，他乡多惜居。",
        "短长三万日，何处是吾庐。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 249490,
      "title": "句  其一",
      "content": [
        "地灵得南徐，天险称此固。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 249491,
      "title": "句  其二",
      "content": [
        "僧居负高青，佛阁俯深翠。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 249492,
      "title": "句  其三",
      "content": [
        "斫雪流膏乃如许，也容石蟹趁时新。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 249493,
      "title": "句  其四",
      "content": [
        "使君领客未经旬，更以蝤蛑作小春。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 249494,
      "title": "句  其五",
      "content": [
        "新如月出初三夜，清似茶烹第一泉。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 249495,
      "title": "句  其六",
      "content": [
        "一天倒影澄秋色，万顷波浮浸月华。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 249496,
      "title": "句  其七",
      "content": [
        "手自栽培千个竹，身常枕籍一床书。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 249497,
      "title": "句  其八",
      "content": [
        "余子不足数，此君何可无。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 249498,
      "title": "句  其九",
      "content": [
        "不堪相背处，何况独归时。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 249499,
      "title": "句  其一○",
      "content": [
        "摸金千骑去，埋玉几人归。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 249500,
      "title": "句  其一一",
      "content": [
        "断崖韦偃树，小雨郭熙山。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 249501,
      "title": "句  其一二",
      "content": [
        "借我以一鉴，饷公无两瓻。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 249502,
      "title": "句  其一三",
      "content": [
        "可惜不当梅蕊破，幽香合在弟兄间。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 249503,
      "title": "句  其一四",
      "content": [
        "红皱解罗襦处，清香开玉肌时。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 249504,
      "title": "句  其一五",
      "content": [
        "猩血染罗欣入手，冰肌饮露欲濡唇。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 249505,
      "title": "存目",
      "content": [
        "诗题：芦沟桥全诗：舆马连年东复西，巨鳌双脇夹青猊。",
        "荷旃食肉无非命，憔悴相如不敢题。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    }
  ],
