{
  "data": [
    {
      "id": 197548,
      "title": "腊雪五首  其四",
      "content": [
        "忧愁不可缓，风雪故相撩。",
        "试问五斗米，能胜一束樵。",
        "耕耘终亦饱，哺啜定谁邀。",
        "寒暑不须避，倾危且自遥。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 197549,
      "title": "腊雪五首  其五",
      "content": [
        "雪霜何与我，忧思自伤神。",
        "忠信亦何罪，才名空误身。",
        "归来聊且止，老去莫逢嗔。",
        "樽酒它年事，相看醉此晨。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 197550,
      "title": "次韵王适雪晴复雪二首  其一",
      "content": [
        "骄阳得一雪，逾尺应更好。",
        "晨兴视窗隙，惊见晴霞杲。",
        "九衢无停迹，狼籍须一扫。",
        "空余浩然气，凛凛接清昊。",
        "余寒薄虚室，一静解群燥。",
        "晨炊晚未供，客馈惭草草。",
        "试脱身上衣，行问酒家保。",
        "孤吟击槁木，大笑称有道。",
        "人生但如此，富贵何用祷。",
        "所思独未见，耿耿属怀抱。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 197551,
      "title": "次韵王适雪晴复雪二首  其二",
      "content": [
        "同云自成幄，飞雪来无根。",
        "一为清风卷，坐见东方暾。",
        "重阴偶复合，飞霰满南轩。",
        "油然青春意，已见出土萱。",
        "老病一不堪，惟恃浊酒温。",
        "开户理松菊，扫荡无遗痕。",
        "卷舒朝夕间，谁识造化元。",
        "乾坤本何施，中有神怪奔。",
        "万物极毫末，颠倒何足掀。",
        "老农但知种，荷鉏理南园。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 197552,
      "title": "送吕由庚推官得替还洛中二首  其一",
      "content": [
        "君家相国旧元勋，凛凛中丞继后尘。",
        "谈笑二年同幕府，风流一倍愈它人。",
        "南都去后少佳客，西洛归来多老臣。",
        "我亦宦游无久意，它年松竹许相邻。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 197553,
      "title": "送吕由庚推官得替还洛中二首  其二",
      "content": [
        "洛水留人一向干，雪泥溢路十分寒。",
        "送行我岂无樽酒，多难君知久鲜欢。",
        "回首祇应怜老病，凌风争看试轻翰。",
        "到家定见嵩阳老，问我衰迟未解官。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 197554,
      "title": "四十一岁岁莫日歌",
      "content": [
        "小儿不知老人意，贺我明年四十二。",
        "人生三十百事衰，四十已过良可知。",
        "少年读书不晓事，坐谈王霸了不疑。",
        "脂车秣马试长道，一日百里先自期。",
        "不知中途有陷穽，山高日莫多棘茨。",
        "长裾大袖足溯挽，却行欲返筋力疲。",
        "蝮蛇当前猛虎后，脱身且免充朝饥。",
        "归来掩卷泪如雨，平生读书空自误。",
        "山中故人一长笑，布衣脱粟何所苦。",
        "古人知非不嫌晚，朝来闻道行当返。",
        "四十一岁不可言，四十二岁聊自还。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 197555,
      "title": "次韵子瞻系御史狱赋狱中榆槐竹柏 榆",
      "content": [
        "秋风一何厉，吹尽山中绿。",
        "可怜凌云条，化为樵夫束。",
        "凛然造物意，岂复私一木。",
        "置身有得地，不问直与曲。",
        "青松未必贵，枯榆还自足。",
        "纷然落叶下，萧条愧华屋。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 197556,
      "title": "次韵子瞻系御史狱赋狱中榆槐竹柏 槐",
      "content": [
        "盛衰日相寻，循环何曾歇。",
        "攀条擥柔荑，回首惊脱叶。",
        "绿槐阴最厚，零落今存荚。",
        "千林一枯槁，平地三尺雪。",
        "草木何足道，盈虚视新月。",
        "微阳起泉下，生意未应绝。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 197557,
      "title": "次韵子瞻系御史狱赋狱中榆槐竹柏 竹",
      "content": [
        "故园今何有，犹有百竿竹。",
        "春雷起新萌，不放牛羊触。",
        "虽无朱栏拥，不见红尘辱。",
        "清风时一过，交戛响鸣玉。",
        "渊明避纷乱，归嗅东篱菊。",
        "嗟我独何为，弃此北窗绿。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 197558,
      "title": "次韵子瞻系御史狱赋狱中榆槐竹柏 柏",
      "content": [
        "曲如山下藤，脆若溪上苇。",
        "春风一张王，秋霜死则已。",
        "胡为南涧中，辛勤种柏子。",
        "上枝挠云霓，下根绞石齿。",
        "伐之为梁栋，岁月良晚矣。",
        "白首阅时人，君看柱下史。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 197559,
      "title": "次韵子瞻赠张憨子",
      "content": [
        "得罪南来正坐言，道人闭口意深全。",
        "天游本自有真乐，羿彀谁知定不贤。",
        "构火暾暾初吐日，飞流滚滚旋成川。",
        "此心此去如灰冷，肯更逢人问复然。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 197560,
      "title": "过龟山",
      "content": [
        "再涉长淮水，惊呼十四年。",
        "龟山老僧在，相见一茫然。",
        "僧老不自知，我老私自怜。",
        "驱驰定何获，少壮空已捐。",
        "掉头不见答，笑指岸下船。",
        "人生何足云，陵谷自变迁。",
        "当年此山下，莫测千仞渊。",
        "渊中械神物，自昔尧禹传。",
        "帆樯避石壁，风雨随香烟。",
        "尔来放冬汴，冷沙涨成田。",
        "褰裳六月渡，中流一带牵。",
        "俯首见砂砾，群渔捕鲂鳣。",
        "父老但惊叹，此理未易原。",
        "何况七尺躯，不为物所旋。",
        "众形要同尽，独有无生全。",
        "百年争夺中，扰扰谁相贤。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 197561,
      "title": "放闸二首  其一",
      "content": [
        "画舫连樯住，清流泛闸平。",
        "忽看银汉落，仍听夏雷惊。",
        "正柂迟回久，开头取次轻。",
        "滞留初一快，奔驶忽如倾。",
        "不识风涛恐，聊同枕席行。",
        "行逢贱鱼稻，饱食慰平生。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 197562,
      "title": "放闸二首  其二",
      "content": [
        "闸空非有碍，水静为谁兴。",
        "开闭偶然异，喧豗自不胜。",
        "渊停初镜净，势转忽云崩。",
        "脱隘尚容与，投深益沸腾。",
        "玉山纷破碎，陈马急侵陵。",
        "挟版千钧重，浮舟万斛升。",
        "岸摇将落木，鱼困或投罾。",
        "汹涌曾谁止，萧条远欲凝。",
        "力争知必折，少待亦何能。",
        "一发临流笑，微言早服膺。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 197563,
      "title": "次韵王适细鱼",
      "content": [
        "群鱼一何微，仅比毛发大。",
        "嬉游极草草，鬓鬣自个个。",
        "造物赋群形，偶然如一唾。",
        "吞舟虽云巨，其乐不相过。",
        "若言无性灵，还知避船柂。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 197564,
      "title": "高邮别秦观三首  其一",
      "content": [
        "蒙蒙春雨湿邗沟，蓬底安眠昼拥裘。",
        "知有故人家在此，速将诗卷洗闲愁。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 197565,
      "title": "高邮别秦观三首  其二",
      "content": [
        "笔端大字鸦栖壁，袖里清诗句琢冰。",
        "送我扁舟六十里，不嫌罪垢污交朋。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 197566,
      "title": "高邮别秦观三首  其三",
      "content": [
        "高安此去风涛恶，犹有庐山得纵游。",
        "便欲携君解船去，念君无罪去何求。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 197567,
      "title": "召伯埭上斗野亭",
      "content": [
        "细雨添春色，微风净牐流。",
        "徂年半今世，生计一扁舟。",
        "饮食随鱼蟹，封疆入斗牛。",
        "江波方在眼，转觉此生浮。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 197568,
      "title": "次韵鲜于子骏游九曲池",
      "content": [
        "天高山近海，春尽草生池。",
        "禾黍多新恨，川原自昔时。",
        "花存故苑丽，樵出旧城隳。",
        "莫望瓜洲渡，曾经驻佛狸。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 197569,
      "title": "扬州五咏 九曲池",
      "content": [
        "嵇老清弹怨广陵，隋家水调继哀音。",
        "可怜九曲遗声尽，惟有一池春水深。",
        "凤阙萧条荒草外，龙舟想像绿杨阴。",
        "都人似有兴亡恨，每到残春一度寻。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 197570,
      "title": "扬州五咏 平山堂",
      "content": [
        "堂上平看江上山，晴光千里对凭栏。",
        "海门仅可一二数，云梦犹吞八九宽。",
        "檐外小棠阴蔽芾，壁间遗墨涕汍澜。",
        "人亡坐使风流尽，遗构仍须子细观。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 197571,
      "title": "扬州五咏 蜀井",
      "content": [
        "信脚东游十二年，甘泉香稻忆归田。",
        "行逢蜀井恍如梦，试煮山茶意自便。",
        "短绠不收容盥濯，红泥仍许置清鲜。",
        "早知乡味胜为客，游宦何须更着鞭。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 197572,
      "title": "扬州五咏 摘星亭",
      "content": [
        "阙角孤高特地迷，迷藏浑忘日东西。",
        "江流入海情无限，莫雨连山醉似泥。",
        "梦里兴亡应未觉，后来愁思独难齐。",
        "只堪留作游观地，看遍峰峦处处低。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 197573,
      "title": "扬州五咏 僧伽塔",
      "content": [
        "山头孤塔閟真人，云是僧伽第二身。",
        "处处金钱追晚供，家家蚕麦保新春。",
        "欲求世外无心地，一扫胸中累劫尘。",
        "方丈近闻延老宿，清朝留客语逡巡。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 197574,
      "title": "题杜介供奉熙熙堂",
      "content": [
        "门前籍籍草生径，堂上熙熙气吐春。",
        "遮眼图书聊度日，放情丝竹最关身。",
        "年来冯脱乌皮几，客去时干漉酒巾。",
        "卜筑城中移榜就，休心便作广陵人。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 197575,
      "title": "游金山寄扬州鲜于子骏从事邵光",
      "content": [
        "扬州望金山，隠隠大如幞。",
        "朅来长江上，孤高二千尺。",
        "僧居厌山小，面面贴苍石。",
        "虚楼三百间，正压江潮白。",
        "清风敛霁雾，晓日曜金碧。",
        "直侵鱼龙居，似得鬼神役。",
        "我行有程度，欲去空自惜。",
        "风吹渡江水，山僧午方食。",
        "波澜洗我心，笋蕨饱我腹。",
        "平生足游衍，壮观此云极。",
        "铁瓮本谁安，海门复谁植。",
        "东南递隠见，遥与此山匹。",
        "兹游几不遂，深愧幕府客。",
        "归时日已莫，正值江月黑。",
        "顾视天水并，坐恐星斗湿。",
        "使君何时罢，登览不可失。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 197576,
      "title": "初至金陵",
      "content": [
        "山川过雨晓光浮，初看江南第一州。",
        "路绕匡庐更南去，悬知是处可忘忧。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 197577,
      "title": "和孔武仲金陵九咏 白鹭亭",
      "content": [
        "白鹭洲前水，奔腾乱马牛。",
        "亭高疑欲动，船去似无忧。",
        "汹涌山方坏，澄清练不收。",
        "中秋谁在此，明月满城头。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 197578,
      "title": "和孔武仲金陵九咏 览辉亭",
      "content": [
        "城里最高处，坡陀见一城。",
        "山多来有绪，江远静无声。",
        "歌吹风前度，楼台雨后明。",
        "风光同楚蜀，聊此慰平生。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 197579,
      "title": "和孔武仲金陵九咏 凤凰台",
      "content": [
        "凤鸟久不至，斯台空复高。",
        "何年种梧竹，特地翦蓬蒿。",
        "白水来无际，青山转几遭。",
        "南游且未返，江海共滔滔。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 197580,
      "title": "和孔武仲金陵九咏 天庆观",
      "content": [
        "兴废不可必，冶城今静祠。",
        "松声闻道路，竹色净轩墀。",
        "江近风云改，亭深草木滋。",
        "孤坟吊遗直，狂暗闵元规。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 197581,
      "title": "和孔武仲金陵九咏 高斋",
      "content": [
        "金陵佳处自无穷，使宅幽深即故宫。",
        "楼殿六朝遗烬后，江山百里旧城中。",
        "雨余尚有金钿落，月出长窥粉堞空。",
        "看尽一城怀古地，兹游恨不与君同。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 197582,
      "title": "和孔武仲金陵九咏 此君亭",
      "content": [
        "绿竹不可数，孤亭一倍幽。",
        "色分岩石润，梢出涧松修。",
        "雪节寒方见，春萌旱不抽。",
        "故山多此物，长恨未归休。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 197583,
      "title": "和孔武仲金陵九咏 见江亭",
      "content": [
        "江水信浩渺，连山巧蔽亏。",
        "端能上崄绝，故自识津涯。",
        "灭没樯竿度，飘摇鹭羽迟。",
        "何人倚舟望，亦爱此峰危。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 197584,
      "title": "和孔武仲金陵九咏 定林院",
      "content": [
        "定林两山间，崖木生欲合。",
        "茅屋倚岩隈，重重阴清樾。",
        "晨斋取旁寺，生事信幽绝。",
        "吾人定何为，常欲依暖热。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 197585,
      "title": "和孔武仲金陵九咏 八功德水",
      "content": [
        "君言山上泉，定有何功德。",
        "热尽自清凉，苦除即甘滑。",
        "颇遭游人病，时取破匏挹。",
        "烦恼虽云消，凛然终在臆。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 197586,
      "title": "游钟山",
      "content": [
        "江南四月如三伏，北望钟山万松碧。",
        "杖藜试上宝公龛，众壑秋声起相袭。",
        "青峰回抱石城小，白练前横大江直。",
        "石梯南下府城闉，松径东蟠转山谷。",
        "乔林无风声如雨，时见游僧石上息。",
        "行穷碧涧一庵岩，坐弄清泉八功德。",
        "归寻晚饭众山底，困卧定林依石壁。",
        "朝游不知涧谷远，莫归但觉穿双屐。",
        "老僧一身泉上住，十年扫尽人间迹。",
        "客到惟烧柏子香，晨饥坐待山前粥。",
        "丈夫济时诚妄语，白首居山本良策。",
        "茹蔬饭糗何足道，纯灰洗心聊自涤。",
        "失身处世足愆尤，愧尔山僧少忧责。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 197587,
      "title": "郭祥正国博醉吟庵",
      "content": [
        "姑熟溪头醉吟客，归作茅庵劣容席。",
        "团团鹄卵中自明，窗前月出夜更清。",
        "醉吟自作溪上语，不学拥鼻雒阳生。",
        "诗成付与坐中读，知有清溪可终日。",
        "作诗饮酒聊复同，谁来共枕溪中石。",
        "圆天方地千万里，中与此间大相似。",
        "嚣然一息不自停，水火雷风相灭起。",
        "直须只作此庵看，歌罢曲肱还醉眠。",
        "不用骑鲸学李白，东入沧海观桑田。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 197588,
      "title": "湖阴曲",
      "content": [
        "老虎穴中卧，猎夫不敢窥。",
        "骅骝服箱骖盗骊，巡城三匝漫不知。",
        "帐中昼梦日绕壁，惊起知是黄须儿。",
        "马鞭七宝留道左，猛士徘徊不能过。",
        "遗矢如冰去已遥，明日神兵下赤霄。",
        "荒城至今人不住，狐兔惊走风萧萧。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 197589,
      "title": "舟次大云仓回寄孔武仲",
      "content": [
        "一风失前期，十日不相见。",
        "君帆一何驶，去若乘风箭。",
        "我舟一何迟，出没蔽葭薍。",
        "瓮中有白糟，床上有黄卷。",
        "妻孥不足共，思子但长叹。",
        "池阳重相遇，抚手成一粲。",
        "先行复草草，回首空眷眷。",
        "人生类如此，迟速亦何算。",
        "一见诚偶然，四海良独远。",
        "相期庐山阴，把臂上云𪩘。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 197590,
      "title": "池州萧丞相楼二首  其一",
      "content": [
        "绕郭青峰睥睨屯，入城流水縠文翻。",
        "楼成始觉江山胜，人去方知德业尊。",
        "坐久浮云霾后岭，酒醒飞雪变前村。",
        "我来邂逅公归国，犹喜登临共一樽。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 197591,
      "title": "池州萧丞相楼二首  其二",
      "content": [
        "丞相风流直至今，朱栏仍对旧山林。",
        "奔驰轩冕终何有，跌宕图书意最深。",
        "松绕城头风瑟缩，江浮山外气阴森。",
        "三年不起南迁想，应有前人识此心。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 197592,
      "title": "过九华山",
      "content": [
        "南迁私自喜，看尽江南山。",
        "孤舟少僮仆，此志还复难。",
        "局促守破窗，联翩过重峦。",
        "忽惊九华峰，高拱立我前。",
        "萧然九仙人，缥缈凌云烟。",
        "碧霞为裳衣，首冠青琅玕。",
        "挥手谢世人，可望不可攀。",
        "我行竟草草，安能拍其肩。",
        "但闻有高士，卧听松风眠。",
        "松根得茯苓，状若千岁鼋。",
        "煮食一朝尽，终身弃腥膻。",
        "腹背生绿毛，轻举如翔鸾。",
        "相逢欲借问，已在长松端。",
        "何年脱罪罟，出处良自便。",
        "芒鞋拄藤杖，逢山即盘桓。",
        "斯人未可求，岩室傥复存。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 197593,
      "title": "佛池口遇风雨",
      "content": [
        "长江五月多风暴，欲行先看风日好。",
        "此风忽作东南来，阴云如涌拨不开。",
        "惊雷往还转车毂，狂波低昂起坑谷。",
        "中流一叶那复持，卷舒已副天公知。",
        "解帆转柁不容语，佛池口中幸可住。",
        "须臾急雨变昏霾，柁师喜贺风已回。",
        "澄溪不动萦白练，老木苍崖蔚葱蒨。",
        "系舟茅屋得青蔬，试问钓船还有鱼。",
        "开樽引满向妻子，明日复行未须怖。",
        "阴阳开阖良等闲，扁舟谁令乘险艰。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 197594,
      "title": "舟次磁湖以风浪留二日不得进子瞻以诗见寄作二篇答之前篇自赋后篇次韵  其一",
      "content": [
        "惭愧江淮南北风，扁舟千里得相从。",
        "黄州不到六十里，白浪俄生百万重。",
        "自笑一生浑类此，可怜万事不由侬。",
        "夜深魂梦先飞去，风雨对床闻晓钟。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 197595,
      "title": "舟次磁湖以风浪留二日不得进子瞻以诗见寄作二篇答之前篇自赋后篇次韵  其二",
      "content": [
        "西归犹未有菟裘，拟就南迁买一丘。",
        "舟楫自能通蜀道，林泉真欲老黄州。",
        "鱼多钓户应容贳，酒熟邻翁便可留。",
        "从此莫言身外事，功名毕竟不如休。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 197596,
      "title": "黄州陪子瞻游武昌西山",
      "content": [
        "千里到齐安，三夜语不足。",
        "劝我勿重陈，起游西山麓。",
        "西山隔江水，轻舟乱凫鹜。",
        "连峰多回溪，盛夏富草木。",
        "杖策看万松，流汗升九曲。",
        "苍茫大江涌，浩荡众山蹙。",
        "上方寄云端，中寺倚岩腹。",
        "清泉类牛乳，烦热须一掬。",
        "县令知客来，行庖映修竹。",
        "黄鹅时新煮，白酒亦近熟。",
        "山行得一饱，看尽千山绿。",
        "幽怀苦不遂，滞念每烦促。",
        "归舟浪花暝，落日金盘浴。",
        "妻孥寄九江，此会难再卜。",
        "君看孙讨虏，百战不摇目。",
        "犹怜江上台，高会饮千斛。",
        "巾冠堕台下，坐使张公哭。",
        "异时君再来，携被山中宿。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 197597,
      "title": "将还江州子瞻相送至刘郎家洑王生家饮别",
      "content": [
        "相从恨不多，送我三十里。",
        "车湖风雨交，松竹相披靡。",
        "系舟枯木根，会面两王子。",
        "嘉眉虽异郡，鸡犬固犹尔。",
        "相逢勿空过，一醉不须起。",
        "风涛未可涉，隔竹见奔驶。",
        "渡江买羔豚，收网得鲂鲤。",
        "朝畦甘瓠熟，冬盎香醪美。",
        "乌菱不论价，白藕如泥耳。",
        "谁言百口活，仰给一湖水。",
        "夺官正无頼，生事应且尔。",
        "卜居请连屋，扣户容屣履。",
        "人生定何为，食足真已矣。",
        "愆尤未见雪，世俗多相鄙。",
        "买田信良计，蔬食期没齿。",
        "手持一竿竹，分子长湖尾。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 197598,
      "title": "赤壁怀古",
      "content": [
        "新破荆州得水军，鼓行夏口气如云。",
        "千艘已共长江崄，百胜安知赤壁焚。",
        "觜距方强要一斗，君臣已定势三分。",
        "古来伐国须观衅，意突成功所未闻。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 197599,
      "title": "自黄州还江州",
      "content": [
        "身浮一叶返湓城，凌犯风涛日夜行。",
        "把酒独斟从睡重，还家渐近觉身轻。",
        "岸回樊口依稀见，日出庐山紫翠横。",
        "家在庾公楼下泊，舟人遥指岸如頳。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 197600,
      "title": "江州五咏 射蛟浦",
      "content": [
        "万骑巡游遍，千帆破浪轻。",
        "射蛟江水赤，教战越人惊。",
        "山转楼船影，岸摧连弩声。",
        "祈招无为赋，酣寝尽平生。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 197601,
      "title": "江州五咏 浪井",
      "content": [
        "江波浮阵云，岸壁立青铁。",
        "胡为井中泉，涌浪时惊发。",
        "水性本无定，得止自澄澈。",
        "谁为女娲手，补此天地裂。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 197602,
      "title": "江州五咏 庾楼",
      "content": [
        "元规情不薄，上客有殷生。",
        "夜半酒将罢，公来坐不惊。",
        "舞翻江月迥，谈落麈毛轻。",
        "尘世风流尽，高楼空此名。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 197603,
      "title": "江州五咏 东湖",
      "content": [
        "读书庐山中，作郡庐山下。",
        "平湖浸山脚，云峰对虚榭。",
        "红蕖纷欲落，白鸟时来下。",
        "犹思隠居胜，乱石惊湍泻。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 197604,
      "title": "江州五咏 琵琶亭",
      "content": [
        "湓江莫雨晴，孤舟暝将发。",
        "夜闻胡琴语，展转不成别。",
        "草堂寄东林，雅意存北阙。",
        "潸然涕泗下，安用无生说。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 197605,
      "title": "不到东西二林",
      "content": [
        "山北东西寺，高人永远师。",
        "来游亦前定，回首独移时。",
        "社散白莲尽，山空玄鹤悲。",
        "何年陶靖节，溪上送行迟。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 197606,
      "title": "游庐山山阳七咏 开先瀑布",
      "content": [
        "山上流泉自作溪，行逢石缺泻虹霓。",
        "定知云外波澜阔，飞到峰前本末齐。",
        "入海明河惊照曜，倚天长剑失提携。",
        "谁来卧枕莓苔石，一洗尘心万斛泥。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 197607,
      "title": "游庐山山阳七咏 潄玉亭",
      "content": [
        "山回不见落银潢，余溜喧豗响石塘。",
        "目乱珠玑溅空谷，足寒雷电绕飞梁。",
        "入瓶铜鼎春茶白，接竹斋厨午饭香。",
        "从此出山都不弃，满田粳稻插新秧。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 197608,
      "title": "游庐山山阳七咏 简寂观",
      "content": [
        "山行但觉鸟声殊，渐近神仙简寂居。",
        "门外长溪净客足，山腰苦笋助盘蔬。",
        "乔松定有藏丹处，大石仍存拜斗余。",
        "弟子苍髯年八十，养生世世授遗书。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 197609,
      "title": "游庐山山阳七咏 归宗寺",
      "content": [
        "来听归宗早晚钟，疲劳懒上紫霄峰。",
        "墨池漫叠溪中石，白塔微分岭上松。",
        "佛宇争推一山甲，僧厨坐待十方供。",
        "欲游山北东西寺，岩谷相连更几重。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 197610,
      "title": "游庐山山阳七咏 万杉寺",
      "content": [
        "万木青杉一手栽，满堂白佛九天来。",
        "涓涓石溜供厨足，矗矗山屏绕寺开。",
        "半榻松阴秋簟冷，一杯香饭午钟催。",
        "安眠饱食平生事，不待山僧唤始回。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 197611,
      "title": "游庐山山阳七咏 三峡石桥",
      "content": [
        "三峡波涛饱溯沿，过桥雷电记当年。",
        "江声仿佛瞿唐口，石角参差滟滪前。",
        "应有夜猿啼古木，已将秋叶作归船。",
        "老僧未省游巴蜀，松下相逢问信然。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 197612,
      "title": "游庐山山阳七咏 白鹤观",
      "content": [
        "五老相携欲上天，玄猿白鹤尽疑仙。",
        "浮云有意藏山顶，流水无声入稻田。",
        "古木微风时起籁，诸峰落日尽生烟。",
        "归鞍草草还城市，惭愧幽人正醉眠。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 197613,
      "title": "南康阻风游东寺",
      "content": [
        "欲涉彭蠡湖，南风未相许。",
        "扁舟厌摇荡，古寺慰行旅。",
        "重湖面南轩，惊浪卷前浦。",
        "霏微雪阵散，颠倒玉山舞。",
        "一风辄九日，未悉土囊怒。",
        "百里断行舟，仰看飞鸿度。",
        "故人念征役，一饭语平素。",
        "竹色净飞涛，松声乱秋雨。",
        "我生足忧患，十载不安处。",
        "南北已兼忘，迟速何须数。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 197614,
      "title": "寄题陈宪郎中竹轩",
      "content": [
        "家有修篁绿满轩，趋庭诗礼旧忘言。",
        "凌霜自得良朋友，过雨时添好子孙。",
        "试翦轻筠扶野步，旋收凉叶煮清樽。",
        "风流共道胜桑梓，邻里何妨种百根。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 197615,
      "title": "次韵孔武仲到官后见寄",
      "content": [
        "举楫同千里，系舟时一言。",
        "共嗟蓬作屋，愿就席为门。",
        "行役身先困，征商思益昏。",
        "仅同登垄断，何止服车辕。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 197616,
      "title": "次韵筠守毛维瞻司封观修城三首  其一",
      "content": [
        "北垣荆棘旧成堆，留待公来次第开。",
        "车马已通城下路，榛芜尽付冶家灰。",
        "异时碧瓦千门合，应记红旌百度来。",
        "自笑裨谌便旷野，肩舆飞盖许追陪。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 197617,
      "title": "次韵筠守毛维瞻司封观修城三首  其二",
      "content": [
        "拨弃案头文字堆，晓晴山色四门开。",
        "究怀民事老虽壮，俯首山城心已灰。",
        "荆棘烧残桑柘出，狐狸去尽犬鸡来。",
        "规模先遣通蹊隧，后乘应容众客陪。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 197618,
      "title": "次韵筠守毛维瞻司封观修城三首  其三",
      "content": [
        "山脚侵城起阜堆，绕城徼道斩新开。",
        "闉阇半坏惊潮信，隍壑初深见劫灰。",
        "蚁聚千夫曾几日，鳞差万瓦看将来。",
        "史君才力轻山郡，朝论行闻急召陪。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 197619,
      "title": "次子瞻夜字韵作中秋对月二篇一以赠王郎二以寄子瞻  其一",
      "content": [
        "平明坐曹黄昏归，终岁得闲惟有夜。",
        "已邀明月出墙东，更遣清风扫庭下。",
        "城上青鬟四山合，门前白练长江泻。",
        "谁家高会吹参差，邻妇悲歌舂罢亚。",
        "二年忧患今已过，一夜清光天所借。",
        "西京诗句出苏李，南国风流数王谢。",
        "已随孤棹去中原，肯顾新科求上舍。",
        "读书本自比嵇锻，学剑要须问曹蔗。",
        "清觞滟滟君莫违，佳句骎骎予已怕。",
        "狂夫猖狂终累人，不返行遭亲党骂。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 197620,
      "title": "次子瞻夜字韵作中秋对月二篇一以赠王郎二以寄子瞻  其二",
      "content": [
        "十年秋月照相思，相从祇有彭门夜。",
        "露侵笳鼓思城阙，寒迫鱼龙舞潭下。",
        "厌厌夜饮欢自足，落落襟怀向人泻。",
        "秋深河来巨野溢，水干楼起滕王亚。",
        "北海孔公虽好客，河内寇尹那得借。",
        "是非朝野忽纷纭，得丧芳菲一开谢。",
        "明月多情还入门，流水何知空绕舍。",
        "晨餐江市富鳣鲂，夜宿山村足梨蔗。",
        "坐隅𫛳鸟不须问，墙外蝮蛇犹足怕。",
        "娄公见唾行自干，冯老尚多谁定骂。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 197621,
      "title": "次韵王适食茅栗",
      "content": [
        "相从万里试南餐，对案长思苜蓿盘。",
        "山栗满篮兼白黑，村醪入口半甜酸。",
        "久闻牛尾何曾试，窃比鸡头意未安。",
        "故国霜蓬如碗大，夜来弹剑似冯驩。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 197622,
      "title": "过毛国镇夜饮",
      "content": [
        "风格照人华省郎，江山绕郭古仙乡。",
        "漫传铅鼎八百岁，未比金钗十二行。",
        "不动歌声人已醉，旋闻诗句夜初长。",
        "簿书拨尽知余力，道院清虚顷未尝。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 197623,
      "title": "次韵毛国镇赵景仁唱和三首一赠毛一赠赵一自咏  其一",
      "content": [
        "治剧从容缓策衔，铃轩无事日清谈。",
        "隼旟画戟明千里，纸帐绳床自一庵。",
        "金奏屡陈容客和，玉山不动看宾酣。",
        "我来邂逅逢宽政，忘却漂流身在南。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 197624,
      "title": "次韵毛国镇赵景仁唱和三首一赠毛一赠赵一自咏  其二",
      "content": [
        "一纸新诗过雁衔，醒然何异接君谈。",
        "奉亲鱼蟹兼临海，退食琴书定有庵。",
        "一别经年真似梦，多忧不饮亦如酣。",
        "共君友契非今日，蔽芾棠阴自剑南。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 197625,
      "title": "次韵毛国镇赵景仁唱和三首一赠毛一赠赵一自咏  其三",
      "content": [
        "远谪江湖舳尾衔，到来辛苦向谁谈。",
        "畏人野鹤长依岭，厌事山僧祇住庵。",
        "黄雀顿来成一饱，白醪新熟喜初酣。",
        "疏顽近日尤堪笑，坐任飘风去自南。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 197626,
      "title": "再和三首  其一",
      "content": [
        "穴鼠何须窭数衔，粗官不用苦高谈。",
        "夜倾绿蚁风吹竹，昼拥黄䌷雪覆庵。",
        "每作微词还自笑，偶渐余润亦成酣。",
        "公诗精绝非伦拟，自古骚人尽在南。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 197627,
      "title": "再和三首  其二",
      "content": [
        "燕窠泥土一春衔，惭愧封侯止立谈。",
        "旧隠尚闻存竹径，归休但要葺茅庵。",
        "钓船梦想沿溪泛，酒盏遥思向日酣。",
        "强欲迟留依幕府，吴公行恐召河南。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 197628,
      "title": "再和三首  其三",
      "content": [
        "天教穷困欲谁衔，生事那须一一谈。",
        "自笑丰年尘满甑，不堪雨后菌生庵。",
        "士师憔悴经三黜，陶令幽忧付一酣。",
        "他日归耕若相忆，尺书频寄北山南。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 197629,
      "title": "次韵王适州学新修水阁",
      "content": [
        "黄钟巨挺两舂容，何幸幽居近学宫。",
        "坐对江山增浩气，力追齐鲁欲同风。",
        "颂诗闻道求何武，家法行看试左雄。",
        "欲伴少年游矍相，奔军惭愧恐词穷。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 197630,
      "title": "次韵毛君九日",
      "content": [
        "山脚侵城尽是台，登高处处喜崔嵬。",
        "手拈霜菊香无奈，面拂江风酒自开。",
        "幕府尊罍云里集，民家歌吹静中来。",
        "定知胜却陶彭泽，怅望篱边白日颓。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 197631,
      "title": "次韵毛君感事书怀",
      "content": [
        "种棠经岁便成科，秋雨调匀气渐和。",
        "才力有余嫌事少，风情无限觉诗多。",
        "长松更老仍添节，古井虽深自不波。",
        "宴坐山房人岂识，一尊聊且慰蹉跎。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 197632,
      "title": "次韵毛君见督和诗",
      "content": [
        "新诗落纸一城传，顾我疏芜岂足编。",
        "他日杜陵诗集里，韦迢略见两三篇。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 197633,
      "title": "次韵毛君山房遣兴",
      "content": [
        "欲就阳崖暖，新开石磴斜。",
        "谁言太守宅，自是野人家。",
        "燕坐收心鉴，冥观阅界沙。",
        "退公长寂寞，外物自喧哗。",
        "缺径移松补，斜阳种竹遮。",
        "白云生后础，孤鹜伴残霞。",
        "破闷时寻鹤，呼眠亦任鸦。",
        "喜闻糟出瓮，屡问菊开花。",
        "古井元依斗，丹砂旧养芽。",
        "蚍蜉频上案，猿狖巧分樝。",
        "客到扁舟远，年侵两鬓华。",
        "心摇挂风旆，眼暗隔轻纱。",
        "强拨横肱睡，来从插版衙。",
        "隠居惭弃掷，胜地每咨嗟。",
        "顽钝终何取，雕磨岂复加。",
        "焦先夙所尚，圜舍恰如蜗。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 197634,
      "title": "和胡教授蒙太守策试诸生",
      "content": [
        "著籍初同阙里多，采芹先致鲁风和。",
        "欲将大策观胸胆，尽召中堂列雁鹅。",
        "终日正言何忌讳，几人余力尚委蛇。",
        "岂惟太守知为政，仍见先生善设科。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 197635,
      "title": "和毛君州宅八咏 凤凰山",
      "content": [
        "山川蟠踞偶成形，威凤低回久未行。",
        "更种梧桐真可致，高飞性似伯夷清。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 197636,
      "title": "和毛君州宅八咏 披仙亭",
      "content": [
        "仙翁旧住蜀江边，千岁归来一鹤翩。",
        "城郭已非人事改，凄凉遗迹但披仙。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 197637,
      "title": "和毛君州宅八咏 方沼亭",
      "content": [
        "池上茅檐覆水低，早来秋雨尚虹霓。",
        "败荷折苇飞鸿下，正忆渔舟泊故溪。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 197638,
      "title": "和毛君州宅八咏 翠樾亭",
      "content": [
        "一夜飞霜点绿苔，晓庭黄叶扫成堆。",
        "檐间翠樾雕疏尽，却放墙东好月来。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 197639,
      "title": "和毛君州宅八咏 李八百洞",
      "content": [
        "洞府山川百里赊，洞门藤蔓锁烟霞。",
        "神仙不与人间异，弟妹还应共一家。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 197640,
      "title": "和毛君州宅八咏 炼丹井",
      "content": [
        "凿井烧丹八百年，尘缘消尽果初圆。",
        "石床藓甃人安在，绿水团团一片天。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 197641,
      "title": "和毛君州宅八咏 磨剑池",
      "content": [
        "神仙铸剑本无硎，岸石班班尚铁鉎。",
        "天上少年仍狡狯，不须还尔对方平。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 197642,
      "title": "和毛君州宅八咏 山房",
      "content": [
        "岸帻携筇夜夜来，蒲团纸帐竹香台。",
        "直须觅取僧为伴，更为开庵𣃁草莱。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 197643,
      "title": "次韵毛君病中菊未开",
      "content": [
        "病肺秋深雾雨伤，旧缯故絮喜清凉。",
        "菊花金粟未曾吐，桂酒鹅儿空自黄。",
        "草木亦知年有闰，风霜渐近月方阳。",
        "得诗闻道维摩病，欲到毗耶言已忘。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 197644,
      "title": "雨中宿酒务",
      "content": [
        "微官终日守糟缸，风雨凄凉夜渡江。",
        "早岁谬知儒术贵，安眠近喜壮心降。",
        "夜深唧唧醅鸣瓮，睡起萧萧叶打窗。",
        "阮籍作官都为酒，不须分别恨南邦。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 197645,
      "title": "次韵毛君经旬不用鞭扑",
      "content": [
        "共喜秋深酒未醇，官曹休假不须旬。",
        "政宽境内棠阴合，讼去庭中草色新。",
        "不惜牛刀时一割，已因鼷鼠发千钧。",
        "岁终谁为公书考，岂止江西第一人。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 197646,
      "title": "次韵李抚辰屯田修州门",
      "content": [
        "六月江涛壁垒颓，苍崖翠甓就新台。",
        "咄嗟双阙还依旧，咫尺群山信有材。",
        "画戟风生两衙退，飞桥日出万人来。",
        "不因毁圮催兴筑，谁见雍容治剧才。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 197647,
      "title": "饮酒过量肺疾复作",
      "content": [
        "朝蒙曲尘居，夜傍糟床卧。",
        "鼻香黍麦熟，眼乱瓶罂过。",
        "囊中衣已空，口角涎虚堕。",
        "啜尝未云足，盗釂恐深坐。",
        "使君信宽仁，高会慰寒饿。",
        "西楼适新成，明月犹半破。",
        "拥檐青山横，拂槛流水播。",
        "雕槃贮霜实，银盎荐秋糯。",
        "共言文字欢，岂待红裙佐。",
        "惟知醍醐滑，不悟颇罗大。",
        "夜归肺增涨，晨起脾失磨。",
        "情怀忽牢落，药饵费调和。",
        "衰年足奇穷，一醉仍坎坷。",
        "清尊自不恶，多病欲何奈。",
        "闻公话少年，举白不论个。",
        "歌吟杂嘲谑，笑语争掀簸。",
        "平明起相视，锐气曾未挫。",
        "达人遗形骸，驽马怀豆莝。",
        "不知逃世网，但解忧岁课。",
        "不见独醒人，终费招魂些。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    }
