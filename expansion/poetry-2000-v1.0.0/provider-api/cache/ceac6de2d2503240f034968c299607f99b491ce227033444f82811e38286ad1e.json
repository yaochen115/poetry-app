{
  "data": [
    {
      "id": 251119,
      "title": "广福寺",
      "content": [
        "小松新桧未成行，劝督栽培想上方。",
        "簷外老榕知几岁，亭亭孤立傲风霜。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 255145,
      "title": "横吹曲辞 陇头水",
      "content": [
        "陇水何年陇头别，不在山中亦呜咽。",
        "征人塞耳马不行，未到陇头闻水声。",
        "谓是西流入蒲海，还闻北海绕龙城。",
        "陇东陇西多屈曲，野麋饮水长簇簇。",
        "胡兵夜回水傍住，忆著来时磨劒处。",
        "向前无井复无泉，放马回看陇头树。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 255209,
      "title": "横吹曲辞 望行人",
      "content": [
        "自从江树秋，日日上江楼。",
        "梦见离珠浦，书来在桂州。",
        "不同鱼比目，终恨水分流。",
        "久不开明镜，多应是白头。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 255220,
      "title": "横吹曲辞 关山月",
      "content": [
        "关山月，营开道白前军发。",
        "冻轮当碛光悠悠，照见三堆两堆骨。",
        "边风割面天欲明，金莎岭西看看没。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 255255,
      "title": "相和歌辞 公无渡河",
      "content": [
        "渡头恶天两岸远，波涛塞川如叠坂。",
        "幸无白刃驱向前，何用将身自弃捐。",
        "蛟龙啮尸鱼食血，黄泥直下无青天。",
        "男儿纵轻妇人语，惜君性命还须取。",
        "妇人无力挽断衣，舟沈身死悔难追，公无渡河公自为。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 255302,
      "title": "相和歌辞 采桑",
      "content": [
        "鸟鸣桑叶间，叶绿条复柔。",
        "攀看去手近，放下长长钩。",
        "黄花盖野田，白马少年游。",
        "所念岂回顾，良人在高楼。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 255349,
      "title": "相和歌辞 短歌行",
      "content": [
        "人初生，日初出。",
        "上山迟，下山疾。",
        "百年三万六千朝，夜里分将彊半日。",
        "有歌有舞间早为，昨日健于今日时。",
        "人家见生男女好，不知男女催人老。",
        "短歌行，无乐声。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 255422,
      "title": "相和歌辞 从军行",
      "content": [
        "汉军逐单于，日没处河曲。",
        "浮云道傍起，行子车下宿。",
        "枪城围鼓角，氊帐依山谷。",
        "马上悬壶浆，刀头分顿肉。",
        "来时高堂上，父母亲结束。",
        "回首不见家，风吹破衣服。",
        "金创生肢节，相与拔箭镞。",
        "闻道西凉州，家家妇人哭。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 255473,
      "title": "相和歌辞 饮马长城窟行",
      "content": [
        "长城窟，长城窟边多马骨。",
        "古来此地无井泉，赖得秦家筑城卒。",
        "征人饮马愁不回，长城变作望乡堆。",
        "蹄迹未干人去近，续后马来泥污尽。",
        "枕弓睡著待水生，不见阴山在前阵。",
        "马蹄足脱装马头，健儿战死谁封侯。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 255637,
      "title": "相和歌辞 乌夜啼",
      "content": [
        "庭树乌，尔何不向别处栖？",
        "夜夜夜半当户啼。",
        "家人把烛出洞户，惊栖失群飞落树。",
        "一飞直欲飞上天，回回不离旧栖处。",
        "未明重绕主人屋，欲下空中黑相触。",
        "风飘雨湿亦不移，君家树头多好枝。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 255641,
      "title": "相和歌辞 乌栖曲",
      "content": [
        "章华宫人夜上楼，君王望月西山头。",
        "夜深宫殿门不锁，白露满山山叶堕。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 255711,
      "title": "舞曲歌辞 独漉歌",
      "content": [
        "独独漉漉，鼠食猫肉。",
        "乌日中，鹤露宿，黄河水直人心曲。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 255719,
      "title": "舞曲歌辞 白纻歌二首 一",
      "content": [
        "天河漫漫北斗粲，宫中乌啼知夜半。",
        "新缝白纻舞衣成，来迟邀得吴王迎。",
        "低鬟转面掩双袖，玉钗浮动秋风生。",
        "酒多夜长夜未晓，月明灯光两相照，后庭歌声更窈窕。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 255720,
      "title": "舞曲歌辞 白纻歌二首 二",
      "content": [
        "馆娃宫中春日暮，荔枝木瓜花满树。",
        "城头乌栖休击鼓，青娥弹瑟白纻舞。",
        "夜天燑燑不见星，宫中火照西江明。",
        "美人醉起无次第，堕钗遗佩满中庭。",
        "此时但愿可君意，回昼为宵亦不寐，年年奉君君莫弃。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 255724,
      "title": "舞曲歌辞 霓裳辞十首 一",
      "content": [
        "弟子部中留一色，听风听水作霓裳。",
        "散声未足重来授，直到床前见上皇。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 255725,
      "title": "舞曲歌辞 霓裳辞十首 二",
      "content": [
        "中管五弦初半曲，遥教合上隔帘听。",
        "一声声向天头落，效得仙人夜唱经。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 255726,
      "title": "舞曲歌辞 霓裳辞十首 三",
      "content": [
        "自直梨园得出稀，更番上曲不教归。",
        "一时跪拜霓裳彻，立地阶前赐紫衣。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 255727,
      "title": "舞曲歌辞 霓裳辞十首 四",
      "content": [
        "旋翻新谱声初足，除却梨园未教人。",
        "宣与书家分手写，中官走马赐功臣。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 255728,
      "title": "舞曲歌辞 霓裳辞十首 五",
      "content": [
        "伴教霓裳有贵妃，从初直到曲成时。",
        "日长耳里闻声熟，拍数分毫错总知。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 255729,
      "title": "舞曲歌辞 霓裳辞十首 六",
      "content": [
        "弦索𪭢𪭢隔彩云，五更初发一山闻。",
        "武皇自送西王母，新换霓裳月色裙。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 255730,
      "title": "舞曲歌辞 霓裳辞十首 七",
      "content": [
        "敕赐宫人澡浴回，遥看美女院门开。",
        "一山星月霓裳动，好字先从殿里来。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 255731,
      "title": "舞曲歌辞 霓裳辞十首 八",
      "content": [
        "传呼法部按霓裳，新得承恩别作行。",
        "应是贵妃楼上看，内人舁下彩罗箱。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 255732,
      "title": "舞曲歌辞 霓裳辞十首 九",
      "content": [
        "朝元阁上山风起，夜听霓裳玉露寒。",
        "宫女月中更替立，黄金梯滑竝行难。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 255733,
      "title": "舞曲歌辞 霓裳辞十首 十",
      "content": [
        "知向华清年月满，山头山底种长生。",
        "去时留下霓裳曲，总是离宫别馆声。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 255766,
      "title": "琴曲歌辞 别鹤",
      "content": [
        "主人一去池水绝，池鹤散飞不相别。",
        "青天漫漫碧海重，知向何山风雪中？",
        "万里虽然音影在，向心终是死生同。",
        "池边巢破松树死，树头年年乌生子。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 255870,
      "title": "杂曲歌辞 羽林行",
      "content": [
        "长安恶少出名字，楼下劫商楼上醉。",
        "天明下直明光宫，散入五陵松柏中。",
        "百回杀人身合死，赦书尚有收城功。",
        "九衢一日消息定，乡吏籍中重改姓。",
        "出来依旧属羽林，立在殿前射飞禽。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 255975,
      "title": "杂曲歌辞 空城雀",
      "content": [
        "空城雀，何不飞来人家住？",
        "空城无人种禾黍。",
        "土间生子草间长，满地蓬蒿幸无主。",
        "近村虽有高树枝，雨中无食长苦饥。",
        "八月小儿夹弓箭，家家畏我田头飞。",
        "但能不出空城里，秋时百草皆有子。",
        "黄口黄口莫啾啾，长尔得成无横死。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 256105,
      "title": "杂曲歌辞 宫中三台二首 一",
      "content": [
        "鱼藻池边射鸭，芙蓉园里看花。",
        "日色柘袍相似，不著红鸾扇遮。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 256106,
      "title": "杂曲歌辞 宫中三台二首 二",
      "content": [
        "池北池南草绿，殿前殿后花红。",
        "天子千年万岁，未央明月清风。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 256107,
      "title": "杂曲歌辞 江南三台四首 一",
      "content": [
        "扬州桥边小妇，长干市里商人。",
        "三年不得消息，各自拜鬼求神。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 256108,
      "title": "杂曲歌辞 江南三台四首 二",
      "content": [
        "青草湖边草色，飞猨岭上猨声。",
        "万里三湘客到，有风有雨人行。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 256109,
      "title": "杂曲歌辞 江南三台四首 三",
      "content": [
        "树头花落花开，道上人去人来。",
        "朝愁暮愁即老，百年几度三台。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 256110,
      "title": "杂曲歌辞 江南三台四首 四",
      "content": [
        "闻身彊健且为，头白齿落难追。",
        "准拟百年千岁，能得几许多时。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 256131,
      "title": "杂曲歌辞 秋夜曲二首 一",
      "content": [
        "天清漏长霜泊泊，兰绿收荣桂膏涸。",
        "高楼云鬟弄婵娟，古瑟暗断秋风弦。",
        "玉关遥隔万里道，金刀不翦双泪泉。",
        "香囊火死香气少，向帷合眼何时晓？",
        "城乌作营嗁野月，秦川少妇生离别。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 256132,
      "title": "杂曲歌辞 秋夜曲二首 二",
      "content": [
        "秋灯向壁掩洞房，良人此夜直明光。",
        "天河悠悠漏水长，南楼北斗两相当。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 256172,
      "title": "杂曲歌辞 辽东行",
      "content": [
        "辽东万里辽水曲，古戍无城复无屋。",
        "黄云盖地雪作山，不惜黄金买衣服。",
        "战回各自收弓箭，正西回面家乡远。",
        "年年郡县送征人，将与辽东作丘坂。",
        "宁为草木乡中生，有身不向辽东行。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 256173,
      "title": "杂曲歌辞 渡辽水",
      "content": [
        "渡辽水，此去咸阳五千里。",
        "来时父母知隔生，重著衣裳如送死。",
        "亦有白骨归咸阳，营家各与题本乡。",
        "身在应无回渡日，驻马相看辽水傍。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 262121,
      "title": "送人",
      "content": [
        "白日向西没，黄河复东流。",
        "人生足著地，宁免四方游。",
        "我行无返顾，祝子勿回头。",
        "当须向前去，何用起离忧。",
        "但恐无广路，平地作山丘。",
        "令我车与马，欲疾反停留。",
        "蜀客多积货，边人易封侯。",
        "男儿恋家乡，欢乐为仇讐。",
        "丁宁相劝勉，苦口幸无尤。",
        "对面无相成，不如豺虎俦。",
        "彼远不寄书，此寒莫寄裘。",
        "与君俱绝迹，两念无因由。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 262122,
      "title": "主人故亭",
      "content": [
        "主人昔专城，城南起高亭。",
        "贵与宾客游，工者夜不宁。",
        "酒食宴圃人，栽接望早成。",
        "经年使家僮，远道求异英。",
        "郡中暂闲暇，遶树引诸生。",
        "开泉浴山禽，为爱山中声。",
        "世间事难保，一日各徂征。",
        "死生不相及，花落实方荣。",
        "我来至此中，守吏非本名。",
        "重君昔为主，相与下马行。",
        "旧岛日日摧，池水不复清。",
        "岂无后人赏，所贵手自营。",
        "浇酒向所思，风起如有灵。",
        "此去不重来，重来伤我形。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 262123,
      "title": "古从军",
      "content": [
        "汉家逐单于，日没处河曲。",
        "浮云道旁起，行子车下宿。",
        "枪城围鼓角，毡帐依山谷。",
        "马上悬壶浆，刀头分颊肉。",
        "来时高堂上，父母亲结束。",
        "回面不见家，风吹破衣服。",
        "金疮在肢节，相与拔箭镞。",
        "闻道西凉州，家家妇女哭。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 262124,
      "title": "邯郸主人",
      "content": [
        "远客无主人，夜投邯郸市。",
        "飞蛾绕残烛，半夜人醉起。",
        "垆边酒家女，遗我缃绮被。",
        "合成双凤花，宛转不相离。",
        "纵令颜色改，勿遣合欢异。",
        "一念始为难，万金谁足贵。",
        "门前长安道，去者如流水。",
        "晨风群鸟翔，裴回别离此。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 262125,
      "title": "泛水曲",
      "content": [
        "载酒入烟浦，方舟泛绿波。",
        "子酌我复饮，子饮我还歌。",
        "莲深微路通，峰曲幽气多。",
        "阅芳无留瞬，弄桂不停柯。",
        "水上秋日鲜，西山碧峩峩。",
        "兹欢良可贵，谁复更来过。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 262126,
      "title": "江南杂体二首 一",
      "content": [
        "江上风翛翛，竹间湘水流。",
        "日夜桂花落，行人去悠悠。",
        "复见离别处，虫声阴雨秋。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 262127,
      "title": "江南杂体二首 二",
      "content": [
        "处处江草绿，行人发潇湘。",
        "潇湘回雁多，日夜思故乡。",
        "春梦不知数，空山兰蕙芳。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 262128,
      "title": "远征归",
      "content": [
        "万里发辽阳，处处问家乡。",
        "回车不淹辙，雨雪满衣裳。",
        "行见日月疾，坐思道路长。",
        "但令不征戍，暗镜生重光。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 262129,
      "title": "思远人",
      "content": [
        "妾思常悬悬，君行复绵绵。",
        "征途向何处，碧海与青天。",
        "岁久自有念，谁令长在边。",
        "少年若不归，兰室如黄泉。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 262130,
      "title": "伤近者不见",
      "content": [
        "离人隔中庭，幸不为远征。",
        "雕梁下有壁，闻语亦闻行。",
        "天涯尚寄信，此处不传情。",
        "君能并照水，形影自分明。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 262131,
      "title": "元日早朝",
      "content": [
        "大国礼乐备，万邦朝元正。",
        "东方色未动，冠劒门已盈。",
        "帝居在蓬莱，肃肃钟漏清。",
        "将军领羽林，持戟巡宫城。",
        "翠华皆宿陈，雪仗罗天兵。",
        "庭燎远煌煌，旗上日月明。",
        "圣人龙火衣，寝殿开旋扃。",
        "龙楼横紫烟，宫女天中行。",
        "六蕃倍位次，衣服各异形。",
        "举头看玉牌，不识宫殿名。",
        "左右雉扇开，蹈舞分满庭。",
        "朝服带金玉，珊珊相触声。",
        "泰阶备雅乐，九奏鸾凤鸣。",
        "裴回庆云中，竽磬寒铮铮。",
        "三公再献寿，上帝锡永贞。",
        "天明告四方，群后保太平。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 262132,
      "title": "闻故人自征戍回",
      "content": [
        "昔闻著征戍，三年一还乡。",
        "今来不换兵，须死在战场。",
        "念子无气力，徒学事戎行。",
        "少年得生还，有同堕穹苍。",
        "自去报尔家，再行上高堂。",
        "尔弟修废枥，尔母缝新裳。",
        "恍恍恐不真，犹未苦承望。",
        "每日空出城，畏渴携壶浆。",
        "安得缩地经，忽使在我傍。",
        "亦知远行劳，人悴马玄黄。",
        "慎莫多停留，苦我居者肠。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 262133,
      "title": "七泉寺上方",
      "content": [
        "长年好名山，本性今得从。",
        "回看尘迹遥，稍见糜鹿踪。",
        "老僧云中居，石门青重重。",
        "阴泉养成龟，古壁飞却龙。",
        "扫石礼新经，悬幡上高峰。",
        "日夕猿鸟合，觅食听山钟。",
        "将火寻远泉，煮茶傍寒松。",
        "晚随收药人，便宿南涧中。",
        "晨起冲露行，湿花枝茸茸。",
        "归依向禅师，愿作香火翁。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 262134,
      "title": "从元太守夏䜩西楼",
      "content": [
        "六月晨亦热，卑居多烦昏。",
        "五马游西城，几杖随朱轮。",
        "西楼临方塘，嘉木当华轩。",
        "凫鹥满中流，有酒复盈尊。",
        "山东地无山，平视大海垠。",
        "高风凉气来，灏景沈清源。",
        "青衿俨坐傍，礼容益敦敦。",
        "愿为颜氏徒，歌咏夫子门。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 262135,
      "title": "酬栢侍御闻与韦处士同游灵台寺见寄",
      "content": [
        "西域传中说，灵台属雍州。",
        "有泉皆圣迹，有石皆佛头。",
        "所出薝卜香，外国俗来求。",
        "毒蛇护其下，樵者不可偷。",
        "古碑在云巅，备载置寺由。",
        "魏家移下来，后人始增修。",
        "近与韦处士，爱此山之幽。",
        "各自具所须，竹笼盛茶瓯。",
        "牵马过危栈，襞衣涉奔流。",
        "草开平路尽，林下大石稠。",
        "过郭转经峰，忽见东西楼。",
        "瀑布当寺门，逬落衣裳秋。",
        "石苔铺紫花，溪叶裁碧油。",
        "松根载殿高，飘飖仙山浮。",
        "县中贤大夫，一月前此游。",
        "赛神贺得雨，岂暇多停留。",
        "二十韵新诗，远寄寻山俦。",
        "清冷玉涧泣，冷切石磬愁。",
        "君名高难闲，余身愚终休。",
        "相将长无因，从今生离忧。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 262136,
      "title": "荆南赠别李肇著作转韵诗",
      "content": [
        "辉天复耀地，再为歌咏始。",
        "素传学道徒，清门有君子。",
        "文涧泻潺潺，德峰来垒垒。",
        "两京二十年，投食公卿间。",
        "封章既不下，故旧多慙颜。",
        "卖马市耕牛，却归湘浦山。",
        "麦收蚕上簇，衣食应丰足。",
        "碧涧伴僧禅，秋山对雨宿。",
        "且欢身体适，幸免缨组束。",
        "上宰镇荆州，敬重同岁游。",
        "欢逢通世友，简授画戎筹。",
        "迟迟就公食，怆怆别野裘。",
        "主人开宴席，礼数无形迹。",
        "醉笑或颠吟，发谈皆损益。",
        "临甃理芳鲜，升堂引宾客。",
        "早岁慕嘉名，远思今始平。",
        "孔门忝同辙，潘馆幸诸甥。",
        "自知再婚娶，岂望为亲情。",
        "欣欣还切切，又二千里别。",
        "楚笔防寄书，蜀茶忧远热。",
        "关山足重叠，会合何时节。",
        "莫叹各从军，且愁岐路分。",
        "美人停玉指，离瑟不中闻。",
        "争向巴山夜，猿声满碧云。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 262137,
      "title": "早发金堤驿",
      "content": [
        "虫声四野合，月色满城白。",
        "家家闭户眠，行人发孤驿。",
        "离家尚苦热，衣服唯轻绤。",
        "时节忽复迁，秋风彻经脉。",
        "人睡落堑辙，马惊入芦荻。",
        "慰远时问程，惊昏忽摇策。",
        "从军岂云乐，忧患常萦积。",
        "唯愿在贫家，团圆过朝夕。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 262138,
      "title": "和裴相公道中赠别张相公",
      "content": [
        "云间双凤鸣，一去一归城。",
        "鞍马朝天色，封章恋阙情。",
        "日临宫树高，烟盖沙草平。",
        "会当戎事息，联影遶池行。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 262139,
      "title": "和钱舍人水植诗",
      "content": [
        "盆里盛野泉，晚鲜幽更好。",
        "初活草根浮，重生荷叶小。",
        "多时水马出，尽日蜻蜓遶。",
        "朝早独来看，冷星沈碧晓。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 262140,
      "title": "题寿安南馆",
      "content": [
        "明蒙竹间亭，天暖幽桂碧。",
        "云生四面山，水接当阶石。",
        "湿树浴鸟痕，破苔卧鹿迹。",
        "不缘尘驾触，堪作商皓宅。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 262141,
      "title": "送张籍归江东",
      "content": [
        "清泉澣尘缁，灵药释昏狂。",
        "君诗发大雅，正气回我肠。",
        "复令五彩姿，洁白归天常。",
        "昔岁同讲道，青襟在师傍。",
        "出处两相因，如彼衣与裳。",
        "行行成此归，离我适咸阳。",
        "失意未还家，马蹄尽四方。",
        "访余咏新文，不倦道路长。",
        "僮仆怀昔念，亦如还故乡。",
        "相亲惜昼夜，寝息不异床。",
        "犹将在远道，忽忽起思量。",
        "黄金未为罍，无以挹酒浆。",
        "所念俱贫贱，安得相发扬。",
        "回车远归省，旧宅江南厢。",
        "归乡非得意，但贵情义彰。",
        "五月天气热，波涛毒于汤。",
        "慎勿多饮酒，药膳愿自强。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 262142,
      "title": "励学",
      "content": [
        "买地不肥实，其繁系耕凿。",
        "良田少锄理，兰焦香亦薄。",
        "勿以听者迷，故使宫征错。",
        "谁言三岁童，还能分善恶。",
        "孜孜日求益，犹恐业未博。",
        "况我性顽蒙，复不勤修学。",
        "有如朝暮食，暂亏忧陨获。",
        "若使无六经，贤愚何所托。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 262143,
      "title": "山中寄及第故人",
      "content": [
        "长长南山松，短短北磵杨。",
        "俱承日月照，幸免斤斧伤。",
        "去年与子别，诚言暂还乡。",
        "如何弃我去，天路忽腾骧。",
        "谁谓有双目，识貌不识肠。",
        "岂知心内乖，著我薜萝裳。",
        "寻君向前事，不叹今异翔。",
        "往往空室中，寤寐说珪璋。",
        "十年居此溪，松桂日苍苍。",
        "自从无佳人，山中不辉光。",
        "尽弃所留药，亦焚旧草堂。",
        "还君誓已书，归我学仙方。",
        "既为参与辰，各愿不相望。",
        "始终名利途，慎勿罹咎殃。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 262144,
      "title": "求友",
      "content": [
        "鉴形须明镜，疗疾须良医。",
        "若无傍人见，形疾安自知。",
        "世路薄言行，学成弃其师。",
        "每怀一饭恩，不重劝勉词。",
        "𢽾学既不诚，朋友道日亏。",
        "遂作名利交，四海争奔驰。",
        "常慕正直人，生死不相离。",
        "苟能成我身，甘与僮仆随。",
        "我言彼当信，彼道我无疑。",
        "针药及病源，以石投深池。",
        "终朝举善道，敬爱当行之。",
        "纵令误所见，亦贵本相规。",
        "不求立名声，所贵去瑕玼。",
        "各愿贻子孙，永为后世资。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 262145,
      "title": "寄李益少监兼送张实游幽州",
      "content": [
        "大雅废已久，人伦失其常。",
        "天若不生君，谁复为文纲。",
        "迷者得道路，溺者遇舟航。",
        "国风人已变，山泽增辉光。",
        "星辰有其位，岂合离帝傍。",
        "贤人既遐征，凤鸟安来翔。",
        "少小慕高名，所念隔山冈。",
        "集卷新纸封，每读常焚香。",
        "古来难自达，取鉴在贤良。",
        "未为知音故，徒恨名不彰。",
        "谅无金石坚，性命岂能长。",
        "常恐一世中，不上君子堂。",
        "伟哉清河子，少年志坚强。",
        "箧中有素文，千里求发扬。",
        "自愿音韵乖，无因合宫商。",
        "幸君达精诚，为我求回章。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 262146,
      "title": "寄崔列中丞",
      "content": [
        "火山无冷地，浊流无清源。",
        "人生在艰世，何处避谗言。",
        "诸侯镇九州，天子开四门。",
        "尚有忠义士，不得申其冤。",
        "嘉木移远植，为我当行轩。",
        "君子居要途，易失主人恩。",
        "我爱古人道，师君直且温。",
        "贪泉誓不饮，邪路誓不奔。",
        "如何非冈坂，故使车轮翻。",
        "妓妾随他人，家事幸获存。",
        "当时门前客，默默空冤烦。",
        "从今遇明代，善恶亦须论。",
        "莫以曾见疑，直道遂不敦。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 262147,
      "title": "喩时",
      "content": [
        "去者如弊帷，来者如新衣。",
        "鲜华非久长，色落还弃遗。",
        "讵知行者夭，岂悟壮者衰。",
        "区区未死间，回面相是非。",
        "好闻苦不乐，好视忽生疵。",
        "乃明万物情，皆逐人心移。",
        "古今尽如此，达士将何为。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 262148,
      "title": "赠王侍御",
      "content": [
        "愚者昧邪正，贵将平道行。",
        "君子抱仁义，不惧天地倾。",
        "三受主人辟，方出咸阳城。",
        "迟疑匪自崇，将显求贤名。",
        "自来掌军书，无不尽臣诚。",
        "何必操白刃，始致海内平。",
        "恭事四海人，甚于敬公卿。",
        "有恶如己辱，闻善如已荣。",
        "或人居饥寒，进退陈中情。",
        "彻晏听苦辛，坐卧身不宁。",
        "以心应所求，尽家犹为轻。",
        "衣食有亲疎，但恐逾礼经。",
        "我今愿求益，讵敢为友生。",
        "幸君扬素风，永作来者程。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 262149,
      "title": "宋氏五女",
      "content": [
        "五女誓终养，贞孝内自持。",
        "兔丝自萦纡，不上青松枝。",
        "晨昏在亲傍，闲则读书诗。",
        "自得圣人心，不因儒者知。",
        "少年绝音华，贵绝父母词。",
        "素钗垂两髦，短窄古时衣。",
        "行成闻四方，征诏环珮随。",
        "同时入皇宫，联影步玉墀。",
        "乡中尚其风，重为修茅茨。",
        "圣朝有良史，将此为女师。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 262150,
      "title": "送于丹移家洺州",
      "content": [
        "忆昔门馆前，君当童子年。",
        "今来见成长，俱过远所传。",
        "诗礼不外学，兄弟相攻研。",
        "如彼贩海翁，岂种溪中田。",
        "四方尚尔文，独我敬尔贤。",
        "但爱金玉声，不贵金玉坚。",
        "孤遗一室中，寝食不相捐。",
        "饱如肠胃同，疾若肤体连。",
        "耕者求沃土，沤者求深源。",
        "彼邦君子居，一日可徂迁。",
        "念此居处近，各为衣食牵。",
        "从今不见面，犹胜异山川。",
        "既乖欢会期，郁郁两难宣。",
        "素琴苦无徽，安得宫商全。",
        "他皆缓别日，我愿促行轩。",
        "送人莫长歌，长歌离恨延。",
        "羸马不知去，过门常盘旋。",
        "会当为尔邻，有地容一泉。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 262151,
      "title": "留别舍弟",
      "content": [
        "孤贱相长育，未曾为远游。",
        "谁不重欢爱，晨昏阙珍羞。",
        "出门念衣车，草木当穷秋。",
        "非疾有忧叹，实为人子尤。",
        "世情本难合，对面隔山丘。",
        "况复干戈地，儒夫何所投。",
        "与尔俱长成，尚为沟壑忧。",
        "岂非轻岁月，少小不勤修。",
        "从今解思量，勉力谋善猷。",
        "但得成尔身，衣食宁我求。",
        "固合受此训，堕慢为身羞。",
        "岁暮当归来，慎莫怀远游。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 262152,
      "title": "坏屋",
      "content": [
        "官家有坏屋，居者愿离得。",
        "苟或幸其迁，回循任倾侧。",
        "若当君子住，一日还修餙。",
        "必使换榱楹，先须木端直。",
        "永令雀与鼠，无处求栖息。",
        "坚固传后人，从今勉劳力。",
        "以兹喩臣下，亦可成邦国。",
        "虽曰愚者词，将来幸无惑。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 262153,
      "title": "送薛蔓应举",
      "content": [
        "四海重贡献，珠賮称至珍。",
        "圣朝开礼闱，所贵集嘉宾。",
        "若生在世间，此路出常伦。",
        "一士登甲科，九族光彩新。",
        "憧憧车马徒，争路长安尘。",
        "万目视高天，升者得苦辛。",
        "况子当少年，丈人在咸秦。",
        "出门见宫阙，献赋侍朱轮。",
        "有贤大国丰，无子一家贫。",
        "男儿富邦家，岂为荣其身。",
        "煌煌文明代，俱幸生此辰。",
        "自顾非国风，难以合圣人。",
        "子去东堂上，我归南涧滨。",
        "愿君勤作书，与我山中邻。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 262154,
      "title": "将归故山留别杜侍御",
      "content": [
        "有川不得涉，有路不得行。",
        "沈沈百忧中，一日如一生。",
        "错来干诸侯，石田废春耕。",
        "虎戟衞重门，何因达中诚。",
        "日月俱照辉，山川异阴晴。",
        "如何百里间，开目不见明。",
        "我今归故山，誓与草木幷。",
        "愿君去丘坂，长使道路平。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 262155,
      "title": "送韦处士老舅",
      "content": [
        "忆昨痴小年，不知有经籍。",
        "常随童子游，多向外家剧。",
        "偷花入邻里，弄笔书墙壁。",
        "照水学梳头，应门未穿帻。",
        "人前赏文性，棃果蒙不惜。",
        "赋字咏新泉，探题得幽石。",
        "自从出关辅，三十年作客。",
        "风雨一飘飖，亲情多阻隔。",
        "如何二千里，尘土驱蹇瘠。",
        "良久陈苦辛，从头叹衰白。",
        "既来今又去，暂笑还成戚。",
        "落日动征车，春风卷离席。",
        "云台观西路，华岳祠前柏。",
        "会得过帝乡，重寻旧行迹。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 262156,
      "title": "送同学故人",
      "content": [
        "各为四方人，此地同事师。",
        "业成有先后，不得长相随。",
        "出林多道路，缘冈复遶陂。",
        "念君辛苦行，令我形体疲。",
        "黄叶堕车前，四散当此时。",
        "亭上夜萧索，山风水离离。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 262157,
      "title": "幽州送申稷评事归平卢",
      "content": [
        "行子绕天北，山高塞复深。",
        "升堂展客礼，临水濯缨襟。",
        "驱驰戎地马，聚散林间禽。",
        "一杯泻东流，各愿无异心。",
        "蓟亭虽苦寒，春夕勿重衾。",
        "从军任白头，莫卖故山岑。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 262158,
      "title": "温门山",
      "content": [
        "早入温门山，群峰乱如戟。",
        "崩崖欲相触，呀豁断行迹。",
        "脱屐寻浅流，定足畏欹石。",
        "路尽十里溪，地多千岁栢。",
        "洞门昼阴黑，深处惟石壁。",
        "似见丹砂光，亦闻钟乳滴。",
        "灵池出山底，沸水冲地脉。",
        "暖气成湿烟，蒙蒙窗中白。",
        "随僧入古寺，便是云外客。",
        "月出天气凉，夜钟山寂寂。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 262159,
      "title": "代故人新姬侍疾",
      "content": [
        "双毂不回辙，子疾已在傍。",
        "侍坐长摇扇，迎医渐下床。",
        "新施箱中幔，未洗来时妆。",
        "奉君缠绵意，幸愿莫相忘。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 262160,
      "title": "采桑",
      "content": [
        "鸟鸣桑叶间，绿条复柔柔。",
        "攀看去手近，放下长长钩。",
        "黄花盖野田，白马少年游。",
        "所念岂回顾，良人在高楼。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 262161,
      "title": "晓思",
      "content": [
        "晓气生绿水，春条露霏霏。",
        "林间栖鸟散，远念征人起。",
        "幽花宿含彩，早蝶寒弄翅。",
        "君行非晨风，讵能从门至。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 262162,
      "title": "早起",
      "content": [
        "回灯正衣裳，出户星未稀。",
        "堂前候姑起，环珮生晨辉。",
        "暗池光羃䍥，密树花葳蕤。",
        "九城钟漏绝，遥听直郎归。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 262163,
      "title": "酬张十八病中寄诗",
      "content": [
        "本性慵远行，绵绵病自生。",
        "见君绸缪思，慰我寂寞情。",
        "风幌夜不掩，秋灯照雨明。",
        "彼愁此又忆，一夕两盈盈。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 262164,
      "title": "凉州行",
      "content": [
        "凉州四边沙皓皓，汉家无人开旧道。",
        "边头州县尽胡兵，将军别筑防秋城。",
        "万里人家皆已没，年年旌节发西京。",
        "多来中国收妇女，一半生男为汉语。",
        "蕃人旧日不耕犂，相学如今种禾黍。",
        "驱羊亦著锦为衣，为惜毡裘防鬬时。",
        "养蚕缫茧成匹帛，那堪绕帐作旌旗。",
        "城头山鸡鸣角角，洛阳家家学胡乐。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 262165,
      "title": "寒食行",
      "content": [
        "寒食家家出古城，老人看屋少年行。",
        "丘垅年年无旧道，车徒散行入衰草。",
        "牧儿驱牛下冢头，畏有家人来洒扫。",
        "远人无坟水头祭，还引妇姑望乡拜。",
        "三日无火烧纸钱，纸钱那得到黄泉。",
        "但看垅上无新土，此中白骨应无主。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 262166,
      "title": "促剌词",
      "content": [
        "促剌复促剌，水中无鱼山无石。",
        "少年虽嫁不得归，头白犹著父母衣。",
        "田边旧宅非所有，我身不及逐鸡飞。",
        "出门若有归死处，猛虎当衢向前去。",
        "百年不遗踏君门，在家谁唤为新妇。",
        "岂不见他邻舍娘，嫁来常在舅姑傍。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 262167,
      "title": "垅头水",
      "content": [
        "垅水何年垅头别，不在山中亦呜咽。",
        "征人塞耳马不行，未到垅头闻水声。",
        "谓是西流入蒲海，还闻北去绕龙城。",
        "垅东垅西多屈曲，野麋饮水长簇簇。",
        "胡兵夜回水旁住，忆著来时磨劒处。",
        "向前无井复无泉，放马回看垅头树。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 262168,
      "title": "北邙行",
      "content": [
        "北邙山头少闲士，尽是洛阳人旧墓。",
        "旧墓人家归葬多，堆著黄金无买处。",
        "天涯悠悠葬日促，冈坂崎岖不停毂。",
        "高张素幕绕铭旌，夜唱挽歌山下宿。",
        "洛阳城北复城东，魂车祖马长相逢。",
        "车辙广若长安路，蒿草少于松柏树。",
        "涧底盘陀石渐稀，尽向坟向作羊虎。",
        "谁家石碑文字灭，后人重取书年月。",
        "朝朝车马送葬回，还起大宅与高台。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 262169,
      "title": "温泉宫行",
      "content": [
        "十月一日天子来，青绳御路无尘埃。",
        "宫前内里汤各别，每个白玉芙蓉开。",
        "朝元阁向山上起，城绕青山龙暖水。",
        "夜开金殿看星河，宫女知更月明里。",
        "武皇得仙王母去，山鸡昼鸣宫中树。",
        "温泉决决出宫流，宫使年年修玉楼。",
        "禁兵去尽无射猎，日西麋鹿登城头。",
        "棃园弟子偷曲谱，头白人间教歌舞。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 262170,
      "title": "春词",
      "content": [
        "红烟满户日照梁，天丝软弱虫飞扬。",
        "菱花霍霍绕帷光，美人对镜著衣裳。",
        "庭中并种相思树，夜夜还栖双凤凰。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 262171,
      "title": "辽东行",
      "content": [
        "辽东万里辽水曲，古戍无城复无屋。",
        "黄云盖地雪作山，不惜黄金买衣服。",
        "战回各自收弓箭，正西回面家乡远。",
        "年年郡县送征人，将与辽东作丘坂。",
        "宁为草木乡中生，有身不向辽东行。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 262172,
      "title": "塞上梅",
      "content": [
        "天山路傍一株梅，年年花发黄云下。",
        "昭君已殁汉使回，前后征人惟系马。",
        "日夜风吹满陇头，还随陇水东西流。",
        "此花若近长安路，九衢年少无攀处。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 262173,
      "title": "戴胜词",
      "content": [
        "戴胜谁与尔为名，木中作窠墙上鸣。",
        "声声催我急种毂，人家向田不归宿。",
        "紫冠采采褐羽斑，衔得蜻蜓飞过屋。",
        "可怜白鹭满绿池，不如戴胜知天时。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 262174,
      "title": "秋千词",
      "content": [
        "长长丝绳紫复碧，袅袅横枝高百尺。",
        "少年儿女重秋千，盘巾结带分两边。",
        "身轻裙薄易生力，双手向空如鸟翼。",
        "下来立定重系衣，复畏斜风高不得。",
        "傍人送上那足贵，终赌鸣珰鬬自起。",
        "回回若与高树齐，头上宝钗从堕地。",
        "眼前争胜难为休，足踏平地看始愁。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 262175,
      "title": "开池得古钗",
      "content": [
        "美人开池北堂下，拾得宝钗金未化。",
        "凤凰半在双股齐，钿花落处生黄泥。",
        "当时堕地觅不得，暗想窗中还夜啼。",
        "可知将来对夫壻，镜前学梳古时髻。",
        "莫言至死亦不遗，还似前人初得时。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 262176,
      "title": "赛神曲",
      "content": [
        "男抱琵琶女作舞，主人再拜听神语。",
        "新妇上酒勿辞勤，使尔舅姑无所苦。",
        "椒浆湛湛桂座新，一双长箭系红巾。",
        "但愿牛羊满家宅，十月报赛南山神。",
        "青天无风水复碧，龙马上鞍牛服轭。",
        "纷纷醉舞踏衣裳，把酒路旁劝行客。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 262177,
      "title": "田家留客",
      "content": [
        "人家少能留我屋，客有新浆马有粟。",
        "远行僮仆应苦饥，新妇厨中炊欲熟。",
        "不嫌田家破门户，蚕房新泥无风土。",
        "行人但饮莫畏贫，明府上来何苦辛。",
        "丁宁回语屋中妻，有客勿令儿夜啼。",
        "双冢直西有县路，我教丁男送君去。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 262178,
      "title": "精衞词",
      "content": [
        "精衞谁教尔填海，海边石子青磊磊。",
        "但得海水作枯池，海中鱼龙何所为。",
        "口穿岂为空衔石，山中草木无全枝。",
        "朝在树头暮海里，飞多羽折时堕水。",
        "高山未尽海未平，愿我身死子还生。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 262179,
      "title": "老妇叹镜",
      "content": [
        "嫁时明镜老犹在，黄金镂画双凤背。",
        "忆昔咸阳初买来，灯前自绣芙蓉带。",
        "十年不开一片铁，长向暗中梳白发。",
        "今日后床重照看，生死终当此长别。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 262180,
      "title": "望夫石",
      "content": [
        "望夫处，江悠悠，化为石，不回头。",
        "上头日日风复雨，行人归来石应语。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 262181,
      "title": "别鹤曲",
      "content": [
        "主人一去池水绝，池鹤散飞不相别。",
        "青天漫漫碧水重，知向何山风雪中。",
        "万里虽然音影在，两心终是死生同。",
        "池边巢破松树死，树头年年乌生子。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 262182,
      "title": "乌栖曲",
      "content": [
        "章华宫人夜上楼，君王望月西山头。",
        "夜深宫殿门不锁，白露满山山叶堕。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262183,
      "title": "雉将雏",
      "content": [
        "雉咿喔，雏出㲉，毛斑斑，觜啄啄。",
        "学飞未得一尺高，还逐母行旋母脚。",
        "麦垄浅浅难蔽身，远去恋雏低怕人。",
        "时时土中鼓两翅，引雏拾虫不相离。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    }
  ],
