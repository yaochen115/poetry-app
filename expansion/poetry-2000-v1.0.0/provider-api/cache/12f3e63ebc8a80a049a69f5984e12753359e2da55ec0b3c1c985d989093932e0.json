      }
    },
    {
      "id": 261324,
      "title": "长社窦明府宅夜送王屋道士常究子",
      "content": [
        "旦随三鸟去，羽节凌霞光。",
        "暮与双凫宿，云车下紫阳。",
        "天坛临月近，洞水出山长。",
        "海峤年年别，丘陵徒自伤。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261325,
      "title": "观回军三韵",
      "content": [
        "行行上陇头，陇月暗悠悠。",
        "万里将军没，回旌陇戍秋。",
        "谁令呜咽水，重入故营流。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 261326,
      "title": "华山南庙",
      "content": [
        "阴山临古道，古庙闭山碧。",
        "落日春草中，搴芳荐瑶席。",
        "明灵达精意，髣髴如不隔。",
        "岩雨神降时，回飙入松栢。",
        "常闻坑儒后，此地返秦璧。",
        "自古害忠良，神其辅宗祏。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 261327,
      "title": "喜邢校书远至对雨同赋远晚饭阮返五韵",
      "content": [
        "雀噪空城阴，木衰羇思远。",
        "已蔽青山望，徒悲白云晚。",
        "别离千里风，雨中同一饭。",
        "开径说逢康，临觞方接阮。",
        "旅宦竟何如，劳飞思自返。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 261328,
      "title": "城西竹园送裴佶王达",
      "content": [
        "葳蕤凌风竹，寂寞离人觞。",
        "怆怀非外至，沈郁自中肠。",
        "远行从此始，别袂重凄霜。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 261329,
      "title": "月下喜邢校书至自洛",
      "content": [
        "天河夜未央，漫漫复苍苍。",
        "重君远行至，及此明目光。",
        "华星暎衰柳，暗水入寒塘。",
        "客心定何似，余欢方自长。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261330,
      "title": "北至太原",
      "content": [
        "炎祚昔昏替，皇基此郁盘。",
        "玄命久已集，抚运良乃艰。",
        "南阨羊肠险，北走雁门寒。",
        "始于一戎定，垂此亿世安。",
        "唐风本忧思，王业寔艰难。",
        "中历虽横溃，天纪未可干。",
        "圣明所兴国，灵岳固不殚。",
        "咄咄薄游客，斯言殊不刊。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 261331,
      "title": "入华山访隐者经仙人石坛",
      "content": [
        "三考四岳下，官曹少休沐。",
        "久负青山诺，今还获所欲。",
        "尝闻玉清洞，金简受玄箓。",
        "夙驾升天行，云游恣霞宿。",
        "平明矫轻策，扪石入空曲。",
        "仙人古石坛，苔遶青瑶局。",
        "阳桂凌烟紫，阴萝冒水绿。",
        "隔世闻丹经，悬泉注明玉。",
        "前惊羽人会，白日天居肃。",
        "问我将致辞，笑之自相目。",
        "竦身云遂起，仰见双白鹄。",
        "堕其一纸书，文字类鸟足。",
        "视之了不识，三返又三复。",
        "归来问方士，举世莫解读。",
        "何必若蜉蝣，然后为跼促。",
        "鄙哉宦游子，身志俱降辱。",
        "再往不及期，劳歌叩山木。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 261332,
      "title": "罢镜",
      "content": [
        "手中青铜镜，照我少年时。",
        "衰飒一如此，清光难复持。",
        "欲令孤月掩，从遣半心疑。",
        "纵使逢人见，犹胜自见悲。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261333,
      "title": "华阴东泉同张处士诣藏律师兼简县内同官因寄齐中书",
      "content": [
        "苍崖抱寒泉，沦照洞金碧。",
        "潜鳞孕明晦，山灵閟幽赜。",
        "前峰何其诡，万变穷日夕。",
        "松老风易悲，山秋云更白。",
        "故人邑中吏，五里仙雾隔。",
        "美质简琼瑶，英声铿金石。",
        "烦君竟相问，问我此何适。",
        "我因赞时理，书寄西飞翮。",
        "哲匠熙百工，日月被光泽。",
        "大国本多士，荆岑无遗璧。",
        "高网弥八纮，皇图明四辟。",
        "群材既兼畅，顾我在草泽。",
        "贵无身外名，贱有区中役。",
        "忽忽百龄内，殷殷千虑迫。",
        "人生已如寄，在寄复为客。",
        "旧国不得归，风尘满阡陌。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 261334,
      "title": "答郭黄中孤云首章见赠",
      "content": [
        "孤云生西北，从风东南飘。",
        "帝乡日已远，苍梧无还飙。",
        "已矣玄凤叹，严霜集灵苕。",
        "君其勉我怀，岁暮孰不雕。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261335,
      "title": "合源溪期张计不至",
      "content": [
        "霜露肃时序，缅然方独寻。",
        "暗溪迟仙侣，寒涧闻松禽。",
        "寂历兹夜永，清明秋序深。",
        "微波澹澄夕，烟景含虚林。",
        "素志久沦否，幽怀方自吟。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 261336,
      "title": "竹溪",
      "content": [
        "访竹越云崖，即林若溪绝。",
        "宁知修干下，漠漠秋苔洁。",
        "清光溢空曲，茂色临幽澈。",
        "采摘愧芳鲜，奉君岁暮节。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261337,
      "title": "送诸曁王主簿之任",
      "content": [
        "别愁已万绪，离曲方三奏。",
        "远宦一辞乡，南天异风候。",
        "秦城岁芳老，越国春山秀。",
        "落日望寒涛，公门闭清昼。",
        "何用慰相思，裁书寄关右。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 261338,
      "title": "罢秩后入华山采茯苓逢道者",
      "content": [
        "委绶来名山，观奇恣所停。",
        "山中若有闻，言此不死庭。",
        "遂逢五老人，一谓西岳灵。",
        "或闻樵人语，飞去入昴星。",
        "授我出云路，苍然凌石屏。",
        "视之有文字，乃古黄庭经。",
        "左右长松列，动摇风露零。",
        "上蟠千年枝，阴虬负青冥。",
        "下结九秋霰，流膏为茯苓。",
        "取之砂石间，异若龟鹤形。",
        "况闻秦宫女，华发变已青。",
        "有如上帝心，与我千万龄。",
        "始疑有仙骨，炼魂可永宁。",
        "何事逐豪游，饮啄以膻腥。",
        "神物亦自閟，风雷护此扃。",
        "欲传山中宝，回策忽已暝。",
        "乃悲世上人，求醒终不醒。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 261339,
      "title": "自朔方还与郑式瞻崔称郑子周岑赞同会法云寺三门避暑",
      "content": [
        "予本疎放士，朅来非外矫。",
        "误落边尘中，爱山见山少。",
        "始投清凉宇，门值烟岫表。",
        "参差互明灭，彩翠竟昏晓。",
        "泠泠远风来，过此群木杪。",
        "英英二三彦，襟旷去烦扰。",
        "游川出潜鱼，息阴倦飞鸟。",
        "徇物不可穷，唯于此心了。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 261340,
      "title": "来从窦车骑行",
      "content": [
        "束发逢世屯，怀恩抱明义。",
        "读书良有感，学劒慙非智。",
        "遂别鲁诸生，来从窦车骑。",
        "追兵赴边急，络马黄金辔。",
        "出入燕南陲，由来重意气。",
        "自经臯兰战，又破楼烦地。",
        "西北护三边，东南留一尉。",
        "时过歘如云，参差不自意。",
        "将军失恩泽，万事从此异。",
        "置酒高台上，薄暮秋风至。",
        "长戟与我归，归来同弃置。",
        "自酌还自饮，非名又非利。",
        "歌出易水寒，琴下雍门泪。",
        "出逢平乐旧，言在天阶侍。",
        "问我从军苦，自陈少年贵。",
        "丈夫交四海，徒论身自致。",
        "汉将不封侯，苏卿劳远使。",
        "今我终此曲，此曲诚不易。",
        "贵人难识心，何由知忌讳。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 261341,
      "title": "夜发军中",
      "content": [
        "边马枥上惊，雄劒匣中鸣。",
        "半夜军书致，匈奴寇六城。",
        "中坚分暗阵，太乙起神兵。",
        "出没风云合，苍黄豺虎争。",
        "今日边庭战，缘赏不缘名。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 261342,
      "title": "将赴朔方早发汉武泉",
      "content": [
        "弭盖出故关，穷秋首边路。",
        "问我此何为，平生重一顾。",
        "风吹山下草，系马河边树。",
        "奉役良有期，回瞻终未屡。",
        "去乡幸未远，戎衣今已故。",
        "岂惟幽朔寒，念我机中素。",
        "去矣勿复言，所酬知音遇。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 261343,
      "title": "城傍少年",
      "content": [
        "长生边城傍，出身事弓马。",
        "少年有胆气，独猎阴山下。",
        "偶与匈奴逢，曾擒射雕者。",
        "名悬壮士籍，请君少相假。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261344,
      "title": "游子吟",
      "content": [
        "女羞夫壻薄，客耻主人贱。",
        "遭遇同众流，低回媿相见。",
        "君非青铜镜，何事空照面。",
        "莫以衣上尘，不谓心如练。",
        "人生当荣盛，待士勿言倦。",
        "君看白日驰，何异弦上箭。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 261345,
      "title": "饮马歌",
      "content": [
        "百马饮一泉，一马争上游。",
        "一马喷成泥，百马饮浊流。",
        "上有沧浪客，对之空叹息。",
        "自顾缨上尘，裴回终日夕。",
        "为问泉上翁，何时见沙石。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 261346,
      "title": "莲塘驿",
      "content": [
        "五月渡淮水，南行遶山陂。",
        "江村远鸡应，竹里闻缲丝。",
        "楚女肌发美，莲塘烟露滋。",
        "菱花覆碧渚，黄鸟双飞时。",
        "渺渺溯洄远，凭风托微词。",
        "斜光动流睇，此意难自持。",
        "女歌本轻艳，客行多怨思。",
        "女萝蒙幽蔓，拟上青桐枝。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 261347,
      "title": "五城道中",
      "content": [
        "金铙随玉节，落日河边路。",
        "沙鸣后骑来，雁起前军度。",
        "五城鸣斥堠，三秦新召募。",
        "天寒白登道，塞浊阴山雾。",
        "仍闻旧兵老，尚在乌兰戍。",
        "笳箫汉思繁，旌旗边色故。",
        "寝兴倦弓甲，勤役伤风露。",
        "来远赏不行，锋交勋乃茂。",
        "未知朔方道，何年罢兵赋。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 261348,
      "title": "与王楚同登青龙寺上方",
      "content": [
        "连冈出古寺，流睇移芳䜩。",
        "鸟没汉诸陵，草平秦故殿。",
        "摇光浅深树，拂木参差燕。",
        "春心断易迷，远目伤难徧。",
        "壮日各轻年，暮年方自见。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 261349,
      "title": "登夏州城观送行人赋得六州胡儿歌",
      "content": [
        "六州胡儿六蕃语，十岁骑羊逐沙鼠。",
        "沙头牧马孤雁飞，汉军游骑貂锦衣。",
        "云中征戍三千里，今日征行何岁归。",
        "无定河边数株柳，共送行人一杯酒。",
        "胡儿起作和蕃歌，齐唱呜呜尽垂手。",
        "心知旧国西州远，西向胡天望乡久。",
        "回头忽作异方声，一声回尽征人首。",
        "蕃音虏曲一难分，似说边情向塞云。",
        "故国关山无限路，风沙满眼堪断魂。",
        "不见天边青作冢，古来愁杀汉昭君。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 261350,
      "title": "从军夜次六胡北饮马磨劒石为祝殇辞",
      "content": [
        "我行空碛，见沙之磷磷，与草之幂幂。",
        "半没胡儿磨劒石，当时洗劒血成川。",
        "至今草与沙皆赤，我因扣石问以言。",
        "水流呜咽幽草根，君宁独不怪阴燐。",
        "吹火荧荧又为碧，有鸟自称蜀帝魂。",
        "南人伐竹湘山下，交根接叶满泪痕。",
        "请君先问湘江水，然我此恨乃可论。",
        "秦亡汉绝三十国，关山战死知何极。",
        "风飘雨洒水自流，此中有冤消不得。",
        "为之弹劒作哀吟，风沙四起云沈沈。",
        "满营战马嘶欲尽，毕昴不见胡天阴。",
        "东征曾吊长平苦，往往睛明独风雨。",
        "年移代去感精魂，空山月暗闻鼙鼓。",
        "秦坑赵卒四十万，未若格鬬伤戎虏。",
        "圣君破胡为六州，六州又尽为胡丘。",
        "韩公三城断胡路，汉甲百万屯边秋。",
        "乃分司空授朔土，拥以玉节临诸侯。",
        "汉为一雪万世讐，我今抽刀勒劒石，告尔万世为唐休。",
        "又闻招魂有美酒，为我浇酒祝东流。",
        "殇为魂兮，可以归还故乡些。",
        "沙场地无人兮，尔独不可以久留。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 261351,
      "title": "登天坛夜见海",
      "content": [
        "朝游碧峰三十六，夜上天坛月边宿。",
        "仙人携我搴玉英，坛上夜半东方明。",
        "僊钟撞撞近海日，海中离离三山出。",
        "霞梯赤城遥可分，霓旌绛节倚彤云。",
        "八鸾五凤纷在御，王母欲上朝元君。",
        "群仙指此为我说，几见尘飞沧海竭。",
        "竦身别我期丹宫，空山处处遗清风。",
        "九州下视杳未旦，一半浮生皆梦中。",
        "始知武皇求不死，去逐瀛洲羡门子。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 261352,
      "title": "大礼毕皇帝御丹凤门改元建中大赦",
      "content": [
        "大明曈曈天地分，六龙负日升天门。",
        "凤凰飞来衔帝箓，言我万代金皇孙。",
        "灵鸡鼓舞承天赦，高翔百尺垂朱幡。",
        "宸居穆清受天历，建中甲子合上元。",
        "昊穹景命即已至，王事乃可酬乾坤。",
        "升中告成答玄贶，泥金检玉昭鸿恩。",
        "云亭之事略可记，七十二君宁独尊。",
        "小臣欲上封禅表，久而未就归文园。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 261353,
      "title": "轻薄篇",
      "content": [
        "豪不必驰千骑，雄不在垂双鞬。",
        "天生俊气自相逐，出与雕鹗同飞翻。",
        "朝行九衢不得意，下鞭走马城西原。",
        "忽闻燕雁一声去，回鞍挟弹平陵园。",
        "归来青楼曲未半，美人玉色当金尊。",
        "淮阴少年不相下，酒酣半笑倚市门。",
        "安知我有不平色，白日欲落红尘昏。",
        "死生容易如反掌，得意失意由一言。",
        "少年但饮莫相问，此中报讐亦报恩。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 261354,
      "title": "野田行",
      "content": [
        "日没出古城，野田何茫茫。",
        "寒狐啸青冢，鬼火烧白杨。",
        "昔人未为泉下客，行到此中曾断肠。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 261355,
      "title": "古别离",
      "content": [
        "双劒欲别风凄然，雌沈水底雄上天。",
        "江回汉转两不见，云交雨合知何年。",
        "古来万事皆由命，何用临岐苦涕涟。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 261356,
      "title": "效古促促曲为河上思妇作",
      "content": [
        "促促何促促，黄河九回曲。",
        "嫁与棹船郎，空床将影宿。",
        "不道君心不如石，那教妾貌长如玉。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 261357,
      "title": "汉宫少年行",
      "content": [
        "君不见上宫警夜营八屯，冬冬街鼓朝朱轩。",
        "玉堦霜仗拥未合，少年排入铜龙门。",
        "暗闻弦管九天上，宫漏沈沈清吹繁。",
        "平明走马绝驰道，呼鹰挟弹通缭垣。",
        "玉笼金锁养黄口，探雏取卵伴王孙。",
        "分曹陆博快一掷，迎欢先意笑语喧。",
        "巧为柔媚学优孟，儒衣嬉戏冠沐猿。",
        "晚来香街经柳市，行过倡舍宿桃根。",
        "相逢杯酒一言失，回朱点白闻至尊。",
        "金张许史伺颜色，王侯将相莫敢论。",
        "岂知人事无定势，朝欢暮戚如掌翻。",
        "椒房宠移子爱夺，一夕秋风生戾园。",
        "徒用黄金将买赋，宁知白玉暗成痕。",
        "持杯收水水已覆，徙薪避火火更燔。",
        "欲求四老张丞相，南山如天不可上。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 261358,
      "title": "竹窗闻风寄苗发司空曙",
      "content": [
        "微风惊暮坐，临牖思悠哉。",
        "开门复动竹，疑是故人来。",
        "时滴枝上露，稍沾堦下苔。",
        "何当一入幌，为拂绿琴埃。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261359,
      "title": "赋得垣衣",
      "content": [
        "漠漠复霏霏，为君垣上衣。",
        "昭阳辇下草，应笑此生非。",
        "掩蔼青春去，苍茫白露稀。",
        "犹胜萍逐水，流浪不相依。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261360,
      "title": "送人流贬",
      "content": [
        "汉章虽约法，秦律已除名。",
        "谤远人多惑，官微不自明。",
        "霜风先独树，瘴雨失荒城。",
        "畴昔长沙事，三年召贾生。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261361,
      "title": "送人南归",
      "content": [
        "人言下江疾，君道下江迟。",
        "五月江路恶，南风惊浪时。",
        "应知近家喜，还有异乡悲。",
        "无奈孤舟夕，山歌闻竹枝。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261362,
      "title": "水亭夜坐赋得晓雾",
      "content": [
        "月落寒雾起，沈思浩通川。",
        "宿禽啭木散，山泽一苍然。",
        "漠漠沙上路，沄沄洲外田。",
        "犹当依远树，断续欲穷天。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261363,
      "title": "送常曾侍御使西蕃寄题西川",
      "content": [
        "凉王宫殿尽，芜没陇云西。",
        "今日闻君使，雄心逐鼓鼙。",
        "行当收汉垒，直可取蒲泥。",
        "旧国无由到，烦君下马题。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261364,
      "title": "入南山至全师兰若",
      "content": [
        "木陨水归壑，寂然无念心。",
        "南行有真子，被褐息山阴。",
        "石路瑶草散，松门寒景深。",
        "吾师亦何爱，自起定中吟。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261365,
      "title": "送韩将军还边",
      "content": [
        "白马羽林儿，扬鞭薄暮时。",
        "独将轻骑出，暗与伏兵期。",
        "雨雪移军远，旌旗上垅迟。",
        "圣心戎寄重，未许让恩私。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261366,
      "title": "晚春卧病喜振上人见访",
      "content": [
        "卧床如旧日，窥户易伤春。",
        "灵寿扶衰力，芭蕉对病身。",
        "道心空寂寞，时物自芳新。",
        "旦夕谁相访，唯当摄上人。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261367,
      "title": "春行",
      "content": [
        "侍臣朝谒罢，戚里自相过。",
        "落日青丝骑，春风白纻歌。",
        "恩承三殿近，猎向五陵多。",
        "归路南桥望，垂杨拂细波。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261368,
      "title": "洛阳河亭奉酬留守群公追送",
      "content": [
        "离亭饯落晖，腊酒减春衣。",
        "岁晚烟霞重，川寒云树微。",
        "戎装千里至，旧路十年归。",
        "还似汀洲雁，相逢又背飞。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261369,
      "title": "寻纪道士偶会诸叟",
      "content": [
        "山阴寻道士，暎竹羽衣新。",
        "侍坐双童子，陪游五老人。",
        "水花松下静，坛草雪中春。",
        "见说桃源洞，如今犹避秦。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261370,
      "title": "同萧炼师宿太乙庙",
      "content": [
        "微月空山曙，春祠谒少君。",
        "落花坛上拂，流水洞中闻。",
        "酒引芝童奠，香余桂子焚。",
        "鹤飞将羽节，遥向赤城分。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261371,
      "title": "送同落第者东归",
      "content": [
        "东门有行客，落日满前山。",
        "圣代谁知者，沧洲今独还。",
        "片云归海暮，流水背城闲。",
        "余亦依嵩颍，松花深闭关。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261372,
      "title": "送柳判官赴振武",
      "content": [
        "边庭汉仪重，旌甲似云中。",
        "虏地山川壮，单于鼓角雄。",
        "关寒塞榆落，月白胡天风。",
        "君逐嫖姚将，麒麟有战功。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261373,
      "title": "述怀寄衡州令狐相公",
      "content": [
        "调元方翼圣，轩盖忽言东。",
        "道以中枢密，心将外理同。",
        "白头生远浪，丹叶下高枫。",
        "江上萧疎雨，何人对谢公。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261374,
      "title": "喜入兰陵望紫阁峰呈宣上人",
      "content": [
        "薙草开三径，巢林喜一枝。",
        "地宽留种竹，泉浅欲开池。",
        "紫阁当疎牖，青松入坏篱。",
        "从今安僻陋，萧相是吾师。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261375,
      "title": "喜见外弟又言别",
      "content": [
        "十年离乱后，长大一相逢。",
        "问姓惊初见，称名忆旧容。",
        "别来沧海事，语罢暮天钟。",
        "明日巴陵道，秋山又几重。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261376,
      "title": "立春日宁州行营因赋朔风吹飞雪",
      "content": [
        "边声日夜合，朔风惊复来。",
        "龙山不可望，千里一裴回。",
        "捐扇破谁执，素纨轻欲裁。",
        "非时妬桃李，自是舞阳台。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261377,
      "title": "献刘济",
      "content": [
        "草绿古燕州，莺声引独游。",
        "雁归天北畔，春尽海西头。",
        "向日花偏落，驰年水自流。",
        "感恩知有地，不上望京楼。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261378,
      "title": "哭柏岩禅师",
      "content": [
        "遍与傍人别，临终尽不愁。",
        "影堂谁为扫，坐塔自看修。",
        "白日钟边晚，青苔钵上秋。",
        "天涯禅弟子，空到柏岩游。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261379,
      "title": "赴邠宁留别",
      "content": [
        "身承汉飞将，束发即言兵。",
        "侠少何相问，从来事不平。",
        "黄云断朔吹，白雪拥沙城。",
        "幸应边书募，横戈会取名。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261380,
      "title": "紫骝马",
      "content": [
        "争场看鬬鸡，白鼻紫骝嘶。",
        "漳水春闺晚，丛台日向低。",
        "歇鞍珠作汗，试劒玉如泥。",
        "为谢红梁燕，年年妾独栖。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261381,
      "title": "夜上受降城闻笛",
      "content": [
        "入夜思归切，笛声清更哀。",
        "愁人不愿听，自到枕前来。",
        "风起塞云断，夜深关月开。",
        "平明独惆怅，落尽一庭梅。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261382,
      "title": "同崔邠登鹳雀楼",
      "content": [
        "鹳雀楼西百尺樯，汀洲云树共茫茫。",
        "汉家箫鼓空流水，魏国山河半夕阳。",
        "事去千年犹恨速，愁来一日即为长。",
        "风烟倂起思归望，远目非春亦自伤。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 261383,
      "title": "奉酬崔员外副使携琴宿使院见示",
      "content": [
        "忽闻此夜携琴宿，遂叹常时尘吏喧。",
        "庭木已衰空月亮，城砧自急对霜繁。",
        "犹持副节留军府，未荐高词直掖垣。",
        "谁问南飞长绕树，官微同在谢公门。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 261384,
      "title": "送贾校书东归寄振上人",
      "content": [
        "北风吹雁数声悲，况指前林是别时。",
        "秋草不堪频送远，白云何处更相期。",
        "山随匹马行看暮，路入寒城独去迟。",
        "为向东州故人道，江淹已拟惠休诗。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 261385,
      "title": "过马嵬二首 一",
      "content": [
        "路至墙垣问樵者，顾予云是太真宫。",
        "太真血染马蹄尽，朱阁影随天际空。",
        "丹壑不闻歌吹夜，玉堦唯有薜萝风。",
        "世人莫重霓裳曲，曾致干戈是此中。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 261386,
      "title": "过马嵬二首 二",
      "content": [
        "金甲银旌尽已回，苍茫罗袖隔风埃。",
        "浓香犹自随鸾辂，恨魄无由离马嵬。",
        "南内真人悲帐殿，东溟方士问蓬莱。",
        "唯留坡畔弯环月，时送残辉入夜台。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 261387,
      "title": "盐州过胡儿饮马泉",
      "content": [
        "绿杨著水草如烟，旧是胡儿饮马泉。",
        "几处吹笳明月夜，何人倚劒白云天。",
        "从来冻合关山路，今日分流汉使前。",
        "莫遣行人照容鬓，恐惊憔悴入新年。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 261388,
      "title": "宿冯翊夜雨赠主人",
      "content": [
        "危心惊夜雨，起望漫悠悠。",
        "气耿残灯暗，声繁高树秋。",
        "凉轩辞夏扇，风幌揽轻裯。",
        "思绪蓬初断，归期燕暂留。",
        "关山蔼已失，脸泪逬难收。",
        "赖君时一笑，方能解四愁。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 261389,
      "title": "送襄阳李尚书",
      "content": [
        "天寒发梅柳，忆昔到襄州。",
        "树暖然红烛，江清展碧油。",
        "风烟临岘首，云水接昭丘。",
        "俗尚春秋学，词称文选楼。",
        "都门送旌节，符竹领诸侯。",
        "汉沔分戎寄，黎元减圣忧。",
        "时追山简兴，本自习家流。",
        "莫废思康乐，诗情满沃洲。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 261390,
      "title": "春日晋祠同声会集得疎字韵",
      "content": [
        "风壤瞻唐本，山祠阅晋余。",
        "水亭开帟幕，岩榭引簪裾。",
        "地绿苔犹少，林黄柳尚疎。",
        "菱苕生皎镜，金碧照澄虚。",
        "翰苑声何旧，宾筵醉止初。",
        "中州有辽雁，好为系边书。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 261391,
      "title": "再赴渭北使府留别",
      "content": [
        "结发逐鸣鼙，连兵追谷蠡。",
        "山川搜伏虏，铠甲被重犀。",
        "故府旌旗在，新军羽校齐。",
        "报恩身未死，识路马还嘶。",
        "列嶂高烽举，当营太白低。",
        "平戎七尺劒，封检一丸泥。",
        "截海取蒲类，跑泉饮䴙鹈。",
        "汉庭中选重，更事五原西。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 261392,
      "title": "送归中丞使新罗册立吊祭",
      "content": [
        "东望扶桑日，何年是到时。",
        "片帆通雨露，积水隔华夷。",
        "浩渺风来远，虚明鸟去迟。",
        "长波静云月，孤岛宿旌旗。",
        "别叶传秋意，回潮动客思。",
        "沧溟无旧路，何处问前期。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 261393,
      "title": "赋得路傍一株柳送邢校书赴延州使府",
      "content": [
        "路傍一株柳，此路向延州。",
        "延州在何处，此路起悠悠。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 261394,
      "title": "重赠邢校书",
      "content": [
        "俱从四方事，共会九秋中。",
        "断蓬与落叶，相值各因风。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 261395,
      "title": "照镜",
      "content": [
        "衰鬓朝临镜，将看却自疑。",
        "慙君明似月，照我白如丝。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 261396,
      "title": "书院无历日以诗代书问路侍御六月大小",
      "content": [
        "野性迷尧历，松窗有道经。",
        "故人为柱史，为我数堦蓂。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 261397,
      "title": "闻鸡赠主人",
      "content": [
        "胶胶司晨鸣，报尔东方旭。",
        "无事恋君轩，今君重凫鹄。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 261398,
      "title": "登白楼见白鸟席上命鹧鸪辞",
      "content": [
        "一鸟如霜雪，飞向白楼前。",
        "问君何以至，天子太平年。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 261399,
      "title": "石楼山见月",
      "content": [
        "紫塞连年戍，黄砂碛路穷。",
        "故人今夜宿，见月石楼中。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 261400,
      "title": "惜春伤同幕故人孟郎中兼呈去年看花友",
      "content": [
        "畏老身全老，逢春解惜春。",
        "今年看花伴，已少去年人。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 261401,
      "title": "嘉禾寺见亡友王七题壁",
      "content": [
        "今日忆君处，忆君君岂知。",
        "空余暗尘字，读罢泪仍垂。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 261402,
      "title": "听唱赤白桃李花",
      "content": [
        "赤白桃李花，先皇在时曲。",
        "欲向西宫唱，西宫[宫]树绿。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 261403,
      "title": "江南词",
      "content": [
        "嫁得瞿塘贾，朝朝悮妾期。",
        "早知潮有信，嫁与弄潮儿。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    }
  ],
