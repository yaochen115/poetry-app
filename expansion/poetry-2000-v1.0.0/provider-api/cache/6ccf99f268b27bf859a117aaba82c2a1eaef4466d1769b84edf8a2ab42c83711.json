{
  "data": [
    {
      "id": 365882,
      "title": "春思",
      "content": [
        "荡漾春风渌似波，惹情摇恨去傞傞。",
        "燕翻永日音声好，",
        "可怜户外桃兼李，仲蔚蓬蒿奈尔何。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 365883,
      "title": "黄鹤驿寓题",
      "content": [
        "野云芳草绕离鞭，敢对青楼倚少年。",
        "秋色未催榆塞雁，",
        "车马同归莫同恨，古人头白尽林泉。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365884,
      "title": "安陆赠徐砺",
      "content": [
        "灵蛇桥下水声声，曾向桥边话别情。",
        "一榻偶依陈太守，",
        "还把余杯重相劝，不堪秋色背郧城。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365885,
      "title": "寄钟常侍",
      "content": [
        "一从朱履步金台，蘖苦冰寒奉上台。",
        "峻节不由人学得，",
        "应笑樟亭旧同舍，九州无验满炉灰。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365886,
      "title": "中秋夜不见月",
      "content": [
        "阴云薄暮上空虚，此夕清光已破除。",
        "只恐异时开霁后，玉轮依旧养蟾蜍。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 365887,
      "title": "魏博罗令公附卷有回",
      "content": [
        "寒门虽得在诸宗，栖北巢南恨不同。",
        "马上固惭消髀肉，",
        "深荷吾宗有知己，好将刀笔为英雄。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365888,
      "title": "寄处默师",
      "content": [
        "甘露卷帘看雨脚，樟亭倚柱望潮头。",
        "十年顾我醉中过，",
        "香炉烟霭虎溪月，终棹铁船寻惠休。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365889,
      "title": "病中上钱尚父",
      "content": [
        "左脚方行右臂挛，每惭名迹污宾筵。",
        "纵饶吴土容衰病，",
        "深恩重德无言处，回首浮生泪泫然。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365890,
      "title": "送梅处士归宁国",
      "content": [
        "十五年前即别君，别时天下未纷纭。",
        "乱罹且喜身俱在，",
        "殷勤为谢逃名客，想望千秋岭上云。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365891,
      "title": "经故友所居",
      "content": [
        "槐花漠漠向人黄，此地追游迹已荒。",
        "清论不知庄叟达，",
        "日暮街东策羸马，一声横笛似山阳。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365892,
      "title": "大梁从事居汜水",
      "content": [
        "前年帝里望行尘，记得仙家第四人。",
        "泉暖旧谙龙偃息，",
        "知有箧中编集在，只应从此是经纶。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365894,
      "title": "绝境",
      "content": [
        "绝境非身事，流年但物华。",
        "水梳苔发直，风引蕙心斜。",
        "凡客从题凤，肤音未胜蛙。",
        "小船兼有桨，始与问渔家。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 365895,
      "title": "雪中怀友人",
      "content": [
        "腊酒复腊雪，故人今越乡。",
        "所思谁把盏，端坐恨无航。",
        "兔苑旧游尽，龟台仙路长。",
        "未知邹孟子，何以奉梁王。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 365896,
      "title": "秋晚",
      "content": [
        "宰邑惭良术，为文愧壮图。",
        "纵饶长委命，争奈渐非夫。",
        "杯酒有时有，乱罹无处无。",
        "金庭在何域，回首一踟蹰。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 365898,
      "title": "姑苏真娘墓",
      "content": [
        "春草荒坟墓，萋萋向虎丘。",
        "死犹嫌寂寞，生肯不风流。",
        "皎镜山泉冷，轻裾海雾秋。",
        "还应伴西子，香径夜深游。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 365899,
      "title": "灵山寺",
      "content": [
        "晚景聊摅抱，凭栏几荡魂。",
        "槛虚从四面，江阔奈孤根。",
        "幽径薜萝色，小山苔藓痕。",
        "欲依师问道，何处系心猿。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 365900,
      "title": "倚棹",
      "content": [
        "倚棹听邻笛，沾衣认酒垆。",
        "自缘悲巨室，谁复为穷途。",
        "树解将军梦，城遗御史乌。",
        "直应齐始了，倾酌向寒芜。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 365905,
      "title": "早秋宿叶堕所居",
      "content": [
        "池荷叶正圆，长历报时殚。",
        "旷野云蒸热，空庭雨始寒。",
        "蝇蚊犹得志，簟席若为安。",
        "浮世知谁是，劳歌共一欢。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 365906,
      "title": "蝶",
      "content": [
        "汉王刀笔精，写尔逼天生。",
        "舞巧何妨急，飞高所恨轻。",
        "野田黄雀虑，山馆主人情。",
        "此物那堪作，庄周梦不成。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 365907,
      "title": "春居",
      "content": [
        "春风百卉摇，旧国路迢迢。",
        "偶病成疏散，因贫得寂寥。",
        "倚帘高柳弱，乘露小桃夭。",
        "春色常无处，村醪更一瓢。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 365910,
      "title": "陕西晚思",
      "content": [
        "长途已自穷，此去更西东。",
        "树色荣衰里，人心往返中。",
        "别情流水急，归梦故山空。",
        "莫忘交游分，从来事一同。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 365911,
      "title": "除夜寄张达",
      "content": [
        "梅花已著眼，竹叶况粘唇。",
        "只此留残岁，那堪忆故人。",
        "乱罹书不远，衰病日相亲。",
        "江浦思归意，明朝又一春。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 365912,
      "title": "寄酬邺王罗令公五首",
      "content": [
        "营室东回荫斥丘，少年承袭拥青油。",
        "坐调金鼎尊明主，",
        "西园旧迹今应在，衰老无因奉胜游。",
        "脉散源分历几朝，纵然官宦只卑僚。",
        "正忧末派沦沧海，",
        "良时难得吾宗少，应念寒门更寂寥。",
        "敢将衰弱附强宗，细算还缘血脉同。",
        "湘浦烟波无旧迹，",
        "珍重珠玑兼绣段，草玄堂下寄扬雄。",
        "水云开霁立高亭，依约黎阳对福星。",
        "只见篇章矜镂管，",
        "鹤发四垂烟阁远，此生何处拜仪形。",
        "锦笈朱囊连复连，紫鸾飞下浙江边。",
        "绡从海室夺烟雾，",
        "戴湾老圃根基薄，虚费工夫八十年。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365913,
      "title": "春日投钱塘元帅尚父二首",
      "content": [
        "正忧衰老辱金台，敢望昭王顾问来。",
        "门外旌旗屯虎豹，",
        "若比紫髯分鼎足，未闻余力有琼瑰。",
        "征东幕府十三州，敢望非才忝上游。",
        "官秩已叨吴品职，",
        "一句黄河千载事，麦城王粲谩登楼。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365914,
      "title": "钱塘府亭",
      "content": [
        "新恩别启馆娃宫，还拜吴王向此中。",
        "九牧土田周制在，",
        "更有宠光人未见，问安调膳尽三公。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365919,
      "title": "江夏酬高崇节",
      "content": [
        "腊雪都堂试，春风汴水行。",
        "十年虽抱疾，何处不无情。",
        "群盗正当路，此游应隔生。",
        "劳君问流落，山下已躬耕。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 365920,
      "title": "莺声",
      "content": [
        "井上梧桐暗，花间雾露晞。",
        "一枝晴复暖，百啭是兼非。",
        "金屋梦初觉，玉关人未归。",
        "不堪闲日听，因尔又沾衣。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 365921,
      "title": "仿玉台体",
      "content": [
        "青楼枕路隅，壁甃复椒涂。",
        "晚梦通帘柙，春寒逼酒垆。",
        "解吟怜芍药，难见恨菖蒲。",
        "试问年多少，邻姬亦姓胡。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 365924,
      "title": "经耒阳杜工部墓",
      "content": [
        "紫菊馨香覆楚醪，奠君江畔雨萧骚。",
        "旅魂自是才相累，",
        "屈原宋玉邻君处，几驾青螭缓郁陶。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365925,
      "title": "题袁溪张逸人所居",
      "content": [
        "蒲梢猎猎燕差差，数里溪光日落时。",
        "芳树文君机上锦，",
        "若使浮名拘绊得，世间何处有男儿。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365926,
      "title": "升平公主旧第",
      "content": [
        "乘凤仙人降此时，玉篇才罢到文词。",
        "两轮水硙光明照，",
        "坛场客散香街暝，惆怅齐竽取次吹。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365927,
      "title": "寄黔中王从事",
      "content": [
        "故人刀笔事军书，南转黔江半月余。",
        "别后乡关情几许，",
        "今日举觞君莫问，生涯牢落鬓萧疏。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365928,
      "title": "关亭春望",
      "content": [
        "关畔春云拂马头，马前春事共悠悠。",
        "风摇岸柳长条困，",
        "未知至竟将何用，渭水泾川一向流。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365929,
      "title": "寄徐济进士",
      "content": [
        "往年疏懒共江湖，月满花香记得无。",
        "霜压楚莲秋后折，",
        "出得函关抽得手，从来不及阮元瑜。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365930,
      "title": "寄韦赡",
      "content": [
        "石城蓑笠阻心期，落尽山花有所思。",
        "羸马二年蓬转后，",
        "禅智阑干市桥酒，纵然相见只相悲。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365931,
      "title": "霅溪晚泊寄裴庶子",
      "content": [
        "溪风如扇雨如丝，闲步闲吟柳恽诗。",
        "杯酒疏狂非曩日，",
        "满眼云山莫相笑，与君俱是受深知。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365932,
      "title": "送姚安之赴任秋浦",
      "content": [
        "官罢春坊地象雷，片帆高指贵池开。",
        "五侯水暖鱼鳞去，",
        "到头称意须年少，赢得时光向酒杯。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365933,
      "title": "寄乔逸人",
      "content": [
        "南经湘浦北扬州，别后风帆几度游。",
        "春酒谁家禁烂漫，",
        "长短此行须入手，更饶君占一年秋。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365934,
      "title": "塞外",
      "content": [
        "塞外偷儿塞内兵，圣君宵旰望升平。",
        "碧幢未作朝廷计，",
        "汉王第宅秦田土，今日将军已自荣。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365935,
      "title": "裴庶子除太仆卿因贺",
      "content": [
        "楚珪班序未为轻，莫惜良途副圣明。",
        "宫省旧推皇甫谧，",
        "应笑马安虚巧宦，四回迁转始为卿。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365936,
      "title": "咏史",
      "content": [
        "蠹简遗编试一寻，寂寥前事似如今。",
        "徐陵笔砚珊瑚架，",
        "九原郝泚何由起，虚误西蕃八尺金。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365937,
      "title": "中元夜泊淮口",
      "content": [
        "木叶回飘水面平，偶因孤棹已三更。",
        "秋凉雾露侵灯下，",
        "锦帆天子狂魂魄，应过扬州看月明。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365938,
      "title": "寄池州郑员外",
      "content": [
        "兽绕朱轮酒满船，郡城萧洒贵池边。",
        "衣同莱子曾分笔，",
        "陵阳百姓将何福，社舞村歌又一年。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365939,
      "title": "归梦",
      "content": [
        "陆海波涛渐渐深，一回归梦抵千金。",
        "路傍草色休多事，",
        "贪财败阵谁相悉，鲍叔如今不可寻。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365940,
      "title": "送溪州使君",
      "content": [
        "兵寇伤残国力衰，就中南土藉良医。",
        "凤衔泥诏辞丹阙，",
        "灞桥酒醆黔巫月，从此江心两所思。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365941,
      "title": "送霅川郑员外",
      "content": [
        "明时塞诏列分麾，东拥朱轮出帝畿。",
        "铜虎贵提天子印，",
        "知有掖垣南步在，可能须待政成归。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365942,
      "title": "酬寄右司李员外",
      "content": [
        "当年忆见桂枝春，自此清途未四旬。",
        "左省望高推健笔，",
        "犹把随和向泥滓，应怜疏散任天真。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365943,
      "title": "莲塘驿",
      "content": [
        "莲塘馆东初日明，莲塘馆西行人行。",
        "隔林啼鸟似相应，",
        "莫言来去只如此，君看鬓边霜几茎。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365944,
      "title": "甘露寺火后",
      "content": [
        "六朝胜事已尘埃，犹有闲人怅望来。",
        "只道鬼神能护物，",
        "还识平泉故侯否，一生踪迹比楼台。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365945,
      "title": "春日登上元石头故城",
      "content": [
        "万里伤心极目春，东南王气只逡巡。",
        "野花相笑落满地，",
        "太平寺主惟轻薄，却把三公与贼臣。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365946,
      "title": "送宣武徐巡官",
      "content": [
        "傲睨公卿二十年，东来西去只悠然。",
        "白知关畔元非马，",
        "临行不惜刀圭便，愁杀长安买笑钱。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365947,
      "title": "冬暮寄裴郎中",
      "content": [
        "晓发星星入镜宜，早年容易近年悲。",
        "敢言得事时将晚，",
        "仙郎旧有黄金约，沥胆隳肝更祷祈。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365948,
      "title": "中元甲子以辛丑驾幸蜀四首",
      "content": [
        "子仪不起浑瑊亡，西幸谁人从武皇。",
        "四海为家虽未远，",
        "应感两朝巡狩迹，绿槐端正驿荒凉。",
        "爪牙柱石两俱销，一点渝尘九土摇。",
        "敢恨甲兵为弃物，",
        "跪望嵕山重启告，可能余烈不胜妖。",
        "邪气奔屯瑞气移，清平过尽到艰危。",
        "纵饶犬彘迷常理，",
        "可怜一曲还京乐，重对红蕉教蜀儿。",
        "白丁攘臂犯长安，翠辇苍黄路屈盘。",
        "丹凤有情尘外远，",
        "不将不侯何计是，钓鱼船上泪阑干。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365949,
      "title": "题润州妙善前石羊",
      "content": [
        "紫髯桑盖此沈吟，很石犹存事可寻。",
        "汉鼎未安聊把手，",
        "还有市鄽沽酒客，雀喧鸠聚话蹄涔。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365950,
      "title": "登宛陵条风楼寄窦常侍",
      "content": [
        "乱罹时节懒登临，试借条风半日吟。",
        "只有远山含暖律，",
        "自笑疏慵似麋鹿，也教台上费黄金。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365951,
      "title": "台城",
      "content": [
        "晚云阴映下空城，六代累累夕照明。",
        "玉井已干龙不起，",
        "深谷作陵山作海，茂弘流辈莫伤情。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365952,
      "title": "甘露寺看雪上周相公",
      "content": [
        "筛寒洒白乱溟蒙，祷请功兼造化功。",
        "光薄乍迷京口月，",
        "一种为祥君看取，半禳灾沴半年丰。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365953,
      "title": "寄京阙陆郎中昆仲",
      "content": [
        "柏台兰署四周旋，宾榻何妨雁影连。",
        "才见玳簪欹细柳，",
        "争奈乱罹人渐少，麦城新赋许谁传。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365959,
      "title": "帘二首",
      "content": [
        "叠影重纹映画堂，玉钩银烛共荧煌。",
        "会应得见神仙在，休下真珠十二行。",
        "翡翠佳名世共稀，玉堂高下巧相宜。",
        "殷勤为嘱纤纤手，卷上银钩莫放垂。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 365960,
      "title": "送顾云下第",
      "content": [
        "行行杯酒莫辞频，怨叹劳歌两未伸。",
        "汉帝后宫犹识字，",
        "百岁都来多几日，不堪相别又伤春。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365961,
      "title": "村桥",
      "content": [
        "村桥酒旆月明楼，偶逐渔舟系叶舟。",
        "莫学鲁人疑海鸟，",
        "除却思量太平在，肯抛疏散换公侯。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365962,
      "title": "送刘校书之新安寄吴常侍",
      "content": [
        "野云如火照行尘，会绩溪边去问津。",
        "才子省衔非幕客，",
        "他日酒筵应见问，鹿裘渔艇隔朱轮。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365963,
      "title": "官池秋夕",
      "content": [
        "池边月影闲婆娑，池上醉来成短歌。",
        "芙渠抵死怨珠露，",
        "松醪作酒兰为棹，十载烟尘奈尔何。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365964,
      "title": "奉使宛陵别二三从事",
      "content": [
        "梁王雪里有深知，偶别家乡隔路岐。",
        "官品共传胜曩日，",
        "还有钓鱼蓑笠在，不堪风雨失归期。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365965,
      "title": "金陵思古",
      "content": [
        "杜秋在时花解言，杜秋死后花更繁。",
        "柔姿曼态葬何处，",
        "绮筵金缕无消息，一阵征帆过海门。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365966,
      "title": "送王使君赴苏台",
      "content": [
        "东南一望可长吁，犹忆王孙领虎符。",
        "两地干戈连越绝，",
        "料得伍员兼旅寓，不妨招取好揶揄。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365967,
      "title": "忆九华",
      "content": [
        "九华巉崒荫柴扉，长忆前时此息机。",
        "黄菊倚风村酒熟，",
        "回首佳期恨多少，夜阑霜露又沾衣。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365968,
      "title": "送裴饶归会稽",
      "content": [
        "金庭路指剡川隈，珍重良朋自此来。",
        "两鬓不堪悲岁月，",
        "笑杀山阴雪中客，等闲乘兴又须回。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365969,
      "title": "送程尊师之晋陵",
      "content": [
        "栋间云出认行轩，郊外阴阴夏木繁。",
        "高道乍为张翰侣，",
        "莫见时危便乘兴，人来何处不桃源。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365970,
      "title": "吴门晚泊寄句曲道友",
      "content": [
        "采香径在人不留，采香径下停叶舟。",
        "桃花李花斗红白，",
        "未知到了关身否，笑杀雷平许远游。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365971,
      "title": "贵池晓望",
      "content": [
        "稂莠参天剪未平，且乘孤棹且行行。",
        "计疏狡兔无三窟，",
        "前溪好泊谁为主，昨夜沙禽占月明。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365972,
      "title": "寄崔庆孙",
      "content": [
        "故人何处又留连，月冷风高镜水边。",
        "文阵解围才昨日，",
        "还拟山阴一乘兴，雪寒难得渡江船。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365973,
      "title": "寄杨秘书",
      "content": [
        "萧萧簷雪打窗声，因忆江东阮步兵。",
        "两信海潮书不达，",
        "会待与君开秫瓮，满船般载镜中行。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365974,
      "title": "酬章处士见寄",
      "content": [
        "中原甲马未曾安，今日逢君事万端。",
        "乱后几回乡梦隔，",
        "何必新诗更相戏，小楼吟罢暮天寒。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365975,
      "title": "送丁明府赴紫溪任",
      "content": [
        "金徽玉轸肯躇蹰，偶滞良途半月余。",
        "楼上酒阑梅拆后，",
        "县谱莫辞留旧本，异时量度更何如。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365976,
      "title": "寄前宣州窦常侍",
      "content": [
        "往年西谒谢玄晖，樽酒留欢醉始归。",
        "曲槛柳浓莺未老，",
        "今日乱罹寻不得，满蓑风雨钓鱼矶。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365977,
      "title": "秦望山僧院",
      "content": [
        "巉巉危岫倚沧洲，闻说秦皇亦此游。",
        "霸主卷衣才二世，",
        "各是病来俱未了，莫将烦恼问汤休。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365978,
      "title": "送光禄崔卿赴阙",
      "content": [
        "一年极目望西辕，此日殷勤圣主恩。",
        "上国已留虞寄命，",
        "鹓侣寂寥曹署冷，更堪呜咽问田园。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365979,
      "title": "寄程尊师",
      "content": [
        "鹤信虽然到五湖，烟波迢递路崎岖。",
        "玉书分薄花生眼，",
        "未知朽败凡间骨，中授先生指教无。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365980,
      "title": "定远楼",
      "content": [
        "前年上将定妖氛，曾筑岩城驻大军。",
        "近日关防虽弛柝，",
        "唯恐乱来良吏少，不知谁解叙功勋。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365981,
      "title": "送程尊师东游有寄",
      "content": [
        "华盖峰前拟卜耕，主人无奈又闲行。",
        "且凭鹤驾寻沧海，",
        "劝君莫忘归时节，芝似萤光处处生。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365982,
      "title": "江亭别裴饶",
      "content": [
        "行杯且待怨歌终，多病怜君事事同。",
        "衰鬓别来光景里，",
        "日晚长亭问西使，不堪车马尚萍蓬。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365983,
      "title": "江南寄所知周仆射",
      "content": [
        "曾陪公子醉西园，岘首碑前事懒言。",
        "世乱共嗟王粲老，",
        "飞盖寂寥清宴罢，不知簪履更谁存。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 365984,
      "title": "钱唐见芮逢",
      "content": [
        "蔡伦池北雁峰前，罹乱相兼十九年。",
        "所喜故人犹会面，",
        "今日与君赢得在，戴家湾里两皤然。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365985,
      "title": "江都",
      "content": [
        "淮王高宴动江都，曾忆狂生亦坐隅。",
        "九里楼台牵翡翠，",
        "惆怅晋阳星拆后，世间兵革地荒芜。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365986,
      "title": "湖上岁暮感怀有寄友人",
      "content": [
        "雪天萤席几辛勤，同志当时四五人。",
        "兰版地寒俱受露，",
        "唯有广都庞令在，白头樽酒忆交亲。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365987,
      "title": "送张绾游钟陵",
      "content": [
        "南忆龙沙两岸行，当时天下尚清平。",
        "醉眠野寺花方落，",
        "西山十二真人在，从此烦君语姓名。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365988,
      "title": "送z6光大师",
      "content": [
        "禹祠分首戴湾逢，健笔寻知达九重。",
        "圣主赐衣怜绝艺，",
        "一种苦心师得了，不须回首笑龙钟。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365989,
      "title": "息夫人庙",
      "content": [
        "百雉摧残连野青，庙门犹见昔朝廷。",
        "一生虽抱楚王恨，",
        "玉颜浑似羞来客，依旧无言照画屏。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365990,
      "title": "漂母冢",
      "content": [
        "寂寂荒坟一水滨，芦洲绝岛自相亲。",
        "青娥已落淮边月，",
        "虽然寂寞千秋魄，犹是韩侯旧主人。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365991,
      "title": "感怀",
      "content": [
        "石径松轩亦自由，谩随浮世逐飘流。",
        "驽骀路结前程恨，",
        "虽教小事相催逼，未到青云拟白头。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365992,
      "title": "扇上画牡丹",
      "content": [
        "为爱红芳满砌阶，教人扇上画将来。",
        "叶随彩笔参差长，",
        "根生无地如仙桂，疑是姮娥月里栽。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365998,
      "title": "贵游",
      "content": [
        "馆陶园外雨初晴，绣毂香车入凤城。",
        "八尺家僮三尺棰，何知高祖要苍生。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 366000,
      "title": "虚白堂前牡丹相传云太傅手植在钱塘",
      "content": [
        "欲询往事奈无言，六十年来托此根。",
        "香暖几飘袁虎扇，",
        "莫背阑干便相笑，与君俱受主人恩。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 366001,
      "title": "县斋秋晚酬友人朱瓒见寄",
      "content": [
        "中和节后捧琼瑰，坐读行吟数月来。",
        "只叹雕龙方擅价，",
        "惆怅报君无玉案，水天东望一裴回。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 366002,
      "title": "第五将军于余杭天柱宫入道因题寄",
      "content": [
        "交梨火枣味何如，闻说苕川已下车。",
        "瓦榼尚携京口酒，",
        "却恐武皇还望祀，软轮征入问玄虚。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 366003,
      "title": "寄无相禅师",
      "content": [
        "老住西峰第几层，为师回首忆南能。",
        "有缘有相应非佛，",
        "何如一衲尘埃外，日日香烟夜夜灯。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 366004,
      "title": "秋日有寄",
      "content": [
        "丹青未合便回头，见尽人间事始休。",
        "只有百神朝宝镜，",
        "东去西来人不会，上卿踪迹本玄洲。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 366005,
      "title": "送前南昌崔令替任映摄新城县",
      "content": [
        "五年苛政甚虫螟，深喜夫君已戴星。",
        "大族不唯专礼乐，",
        "二月春风何处好，亚夫营畔柳青青。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 366006,
      "title": "下第作",
      "content": [
        "年年模样一般般，何似东归把钓竿。",
        "岩谷谩劳思雨露，",
        "至竟穷途也须达，不能长与世人看。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    }
  ],
