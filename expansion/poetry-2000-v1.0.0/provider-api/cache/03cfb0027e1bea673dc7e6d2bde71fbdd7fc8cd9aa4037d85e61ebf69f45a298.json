{
  "data": [
    {
      "id": 315901,
      "title": "玉漏迟",
      "content": [
        "一春浑不见，那堪又是，花飞时节。",
        "忍对危栏数曲，暮云千叠。",
        "门外星星柳眼，看还似、当时风月。",
        "愁万结。",
        "凭谁为我，殷勤低说。",
        "不是惯却春心，奈新燕传情，旧莺饶舌。",
        "冷篆馀香，莫放等闲消歇。",
        "纵使繁红褪尽，犹有、荼䕷堪折。",
        "魂梦切。",
        "如今不奈，飞来蝴蝶。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315902,
      "title": "折红英・撷芳词",
      "content": [
        "桃花暖。",
        "杨花乱。",
        "可怜朱户春强半。",
        "长记忆。",
        "探芳日。",
        "笑凭郎肩，𣨼红偎碧。",
        "惜惜惜。",
        "春宵短。",
        "离肠断。",
        "泪痕长向东风满。",
        "凭青翼。",
        "问消息。",
        "花谢春归，几时来得。",
        "忆忆忆。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315903,
      "title": "上平西・金人捧露盘",
      "content": [
        "爱春归，忧春去，为春忙。",
        "旋点检、雨障云妨。",
        "遮红护绿，翠帷罗幕任高张。",
        "海棠明月杏花天，更惜浓芳。",
        "唤莺吟，招蝶拍，迎柳舞，倩桃妆。",
        "尽唤起、万籁笙簧。",
        "一觞一咏，尽教陶写绣心肠。",
        "笑他人世漫嬉游，拥翠偎香。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315904,
      "title": "瑶阶草",
      "content": [
        "空山子规叫，月破黄昏冷。",
        "帘幕风轻，绿暗红又尽。",
        "自从别后，粉消香腻，一春成病。",
        "那堪昼闲日永。",
        "恨难整。",
        "起来无语，绿萍破处池光净。",
        "闷理残妆，照花独自怜瘦影。",
        "睡来又怕，饮来越醉，醒来却闷。",
        "看谁似我孤令。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315905,
      "title": "碧牡丹",
      "content": [
        "睡起情无著。",
        "晓雨尽，春寒弱。",
        "酒盏飘零，几日顿疏行乐。",
        "试数花枝，问此情何若。",
        "为谁开，为谁落。",
        "正愁却。",
        "不是花情薄。",
        "花元笑人萧索。",
        "旧观千红，至今冷梦难托。",
        "燕麦春风，更几人惊觉。",
        "对花羞，为花恶。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315906,
      "title": "满庭芳",
      "content": [
        "南月惊乌，西风破雁，又是秋满平湖。",
        "采莲人尽，寒色战菇蒲。",
        "旧信江南好景，一万里、轻觅莼鲈。",
        "谁知道，吴侬未识，蜀客已情孤。",
        "凭高，增怅望，湘云尽处，都是平芜。",
        "问故乡何日，重见吾庐。",
        "纵有荷纫芰制，终不似、菊短篱疏。",
        "归情远，三更雨梦，依旧绕庭梧。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315907,
      "title": "念奴娇",
      "content": [
        "秋风秋雨，正黄昏、供断一窗愁绝。",
        "带减衣宽谁念我，难忍重城离别。",
        "转枕褰帷，挑灯整被，总是相思切。",
        "知他别后，负人多少风月。",
        "不是怨极愁浓，只愁重见了，相思难说。",
        "料得新来魂梦里，不管飞来蝴蝶。",
        "排闷人间，寄愁天上，终有归时节。",
        "如今无奈，乱云依旧千叠。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315908,
      "title": "雪狮儿",
      "content": [
        "断云低晚，轻烟带暝，风惊罗幕。",
        "数点梅花，香倚雪窗摇落。",
        "红炉对谑。",
        "正酒面、琼稣初削。",
        "云屏暖，不知门外，月寒风恶。",
        "迤逦慵云半掠。",
        "笑盈盈、闲弄宝筝弦索。",
        "暖极生春，已向横波先觉。",
        "花娇柳弱。",
        "渐倚醉、要人搂著。",
        "低告托。",
        "早把被香熏却。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315909,
      "title": "摸鱼儿",
      "content": [
        "掩凄凉、黄昏庭院，角声何处呜咽。",
        "矮窗曲屋风灯冷，还是苦寒时节。",
        "凝伫切。",
        "念翠被熏笼，夜夜成虚设。",
        "倚阑愁绝。",
        "听凤竹声中，犀影帐外，簌簌酿寒轻雪。",
        "伤心处，却忆当年轻别。",
        "梅花满园初发。",
        "吹香弄蕊无人见，帷有暮云千叠。",
        "情未彻。",
        "又谁料而今，好梦分胡越。",
        "不堪重说。",
        "但记得当初，重门锁处，犹有夜深月。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315910,
      "title": "无闷",
      "content": [
        "天与多才，不合更与，𣨼柳怜花情分。",
        "甚总为才情，恼人方寸。",
        "早是春残花褪。",
        "也不料、一春都成病。",
        "自失笑，因甚腰围半减，珠泪频揾。",
        "难省。",
        "也怨天、也自恨。",
        "怎免千般思忖。",
        "倩人说与，又却不忍。",
        "拼了一生愁闷。",
        "又只恐、愁多无人问。",
        "到这里，天也怜人，看他稳也不稳。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315911,
      "title": "孤雁儿・御街行",
      "content": [
        "在家不觉穷冬好。",
        "向客里、方知道。",
        "故园梅花正开时，记得清尊频倒。",
        "高烧红蜡，暖熏罗幌，一任花枝恼。",
        "如今客里伤怀抱。",
        "忍双鬓、随花老。",
        "小窗独自对黄昏，只有月华飞到。",
        "假饶真个，雁书频寄，何似归来早。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315912,
      "title": "孤雁儿・御街行",
      "content": [
        "双鬓乍绾横波溜。",
        "记当日、香心透。",
        "谁教容易逐鸡飞，输却春风先手。",
        "天公元也，管人憔悴，放出花枝瘦。",
        "几宵和月来相就。",
        "问何事、春山斗。",
        "祗应深院锁蝉娟，枉却娇花时候。",
        "何时为我，小梯横阁，试约黄昏后。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315913,
      "title": "意难忘",
      "content": [
        "花拥鸳房。",
        "记驼肩髻小，约鬓眉长。",
        "轻身翻燕舞，低语转莺簧。",
        "相见处，便难忘。",
        "肯亲度瑶觞。",
        "向夜阑，歌翻郢曲，带换韩香。",
        "别来音信难将。",
        "似云收楚峡，雨散巫阳。",
        "相逢情有在，不语意难量。",
        "些个事，断人肠。",
        "怎禁得恓惶。",
        "待与伊、移根换叶，试又何妨。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315914,
      "title": "一丛花",
      "content": [
        "伤春时候一凭阑。",
        "何况别离难。",
        "东风只解催人去，也不道、莺老花残。",
        "青笺未约，红绡忍泪，无计锁征鞍。",
        "宝钗瑶钿一时闲。",
        "此恨苦天悭。",
        "如今直恁抛人去，也不念、人瘦衣宽。",
        "归来忍见，重楼淡月，依旧五更寒。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315915,
      "title": "蓦山溪",
      "content": [
        "老来风味，是事都无可。",
        "只爱小书舟，剩围着、琅玕几个。",
        "呼风约月，随分乐生涯，不羡富，不忧贫，不怕乌蟾堕。",
        "三杯径醉，转觉乾坤大。",
        "醉后百篇诗，尽从他、龙吟鹤和。",
        "升沈万事，还与本来天，青云上，白云间，一任安排我。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315916,
      "title": "满江红",
      "content": [
        "葺屋为舟，身便是、烟波钓客。",
        "况人间元似，泛家浮宅。",
        "秋晚雨声篷背稳，夜深月影窗棂白。",
        "□满船诗酒满船书，随意索。",
        "也不怕，云涛隔。",
        "也不怕，风帆侧。",
        "但独醒还睡，自歌还拍。",
        "卧后从教秋鳝舞，醉来一任乾坤窄。",
        "恐有时、撑向大江头，占风色。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315917,
      "title": "小桃红・连理枝",
      "content": [
        "不恨残花妥。",
        "不恨残春破。",
        "只恨流光，一年一度，又催新火。",
        "纵青天白日系长绳，也留春得么。",
        "花院重教锁。",
        "春事从教过。",
        "烧笋园林，尝梅台榭，有何不可。",
        "已安排、珍簟小胡床，待日长闲坐。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315918,
      "title": "芭蕉雨",
      "content": [
        "雨过凉生藕叶。",
        "晚庭消尽暑，浑无热。",
        "枕簟不胜香滑。",
        "争奈宝帐情生，金尊意惬。",
        "玉人何处梦蝶。",
        "思一见冰雪。",
        "须写个贴儿、丁宁说。",
        "试问道、肯来么，今夜小院无人，重楼有月。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315919,
      "title": "红娘子・连理枝",
      "content": [
        "小小闲窗底。",
        "曲曲深屏里。",
        "一枕新凉，半床明月，留人欢意。",
        "奈梅花引里唤人行，苦随他无计。",
        "几点清觞泪。",
        "数曲乌丝纸。",
        "见少离多，心长分短，如何得是。",
        "到如今、留下许都愁，枉教人憔悴。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315920,
      "title": "醉落魄・一斛珠",
      "content": [
        "夏围初结。",
        "绿深深处红千叠。",
        "杜鹃过尽芳菲歇。",
        "只道无春，满意春犹惬。",
        "折来一点如猩血。",
        "透明冠子轻盈贴。",
        "芳心蹙破情尤切。",
        "不管花残，犹自拣双叶。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315921,
      "title": "一翦梅",
      "content": [
        "旧日心期不易招。",
        "重来孤负，几个良宵。",
        "寻常不见尽相邀。",
        "见了知他，许大无聊。",
        "昨夜梅花插翠翘。",
        "影落清溪，应也魂消。",
        "假饶真个住山腰。",
        "那个金章，换得渔樵。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315922,
      "title": "一翦梅",
      "content": [
        "小会幽欢整及时。",
        "花也相宜。",
        "人也相宜。",
        "宝香未断烛光低。",
        "莫厌杯迟。",
        "莫恨欢迟。",
        "夜渐深深漏渐稀。",
        "风已侵衣。",
        "露已沾衣。",
        "一杯重劝莫相违。",
        "何似休归。",
        "何自同归。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315923,
      "title": "眼儿媚",
      "content": [
        "一枝烟雨瘦东墙。",
        "真个断人肠。",
        "不为天寒日暮，谁怜水远山长。",
        "相思月底，相思竹外，犹自禁当。",
        "只恐玉楼贪梦，输他一夜清香。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315924,
      "title": "浪淘沙",
      "content": [
        "山尽两溪头。",
        "水合天浮。",
        "行人莫赋大江愁。",
        "且是芙蓉城下水，还送归舟。",
        "渔雁两悠悠。",
        "烟断云收。",
        "谁教此水却西流。",
        "载我相思千点泪，还与青楼。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315925,
      "title": "雨中花令",
      "content": [
        "闻说海棠开尽了。",
        "怎生得、夜来一笑。",
        "颦绿枝头，落红点里，问有愁多少。",
        "小园闭门春悄悄。",
        "禁不得、瘦腰如袅。",
        "豆蔻浓时，酴醿香处，试把菱花照。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315926,
      "title": "雨中花令",
      "content": [
        "旧日爱花心未了。",
        "紧消得、花时一笑。",
        "几日春寒，连宵雨闷，不道幽欢少。",
        "记得去年深院悄。",
        "□梁畔，一枝香袅。",
        "说与西楼，后来明月，莫把菱花照。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315927,
      "title": "雨中花令",
      "content": [
        "卷地芳草都过了。",
        "花不语、对人含笑。",
        "花与人期，人怜花病，瘦似人多少。",
        "闻道重门深悄悄。",
        "愁不尽、露啼烟袅。",
        "断得相思，除非明月，不把花枝照。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315928,
      "title": "凤栖梧・蝶恋花",
      "content": [
        "九月江南烟雨里。",
        "客枕凄凉，到晓浑无寐。",
        "起上小楼观海气。",
        "昏昏半约渔樵市。",
        "断雁西边家万里。",
        "料得秋来，笑我归无计。",
        "剑在床头书在几。",
        "未甘分付黄花泪。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315929,
      "title": "凤栖梧・蝶恋花",
      "content": [
        "有客钱塘江上住。",
        "十日斋居，九日愁风雨。",
        "断送一春弹指去。",
        "荷花又绕南山渡。",
        "湖上幽寻君已许。",
        "消息不来，望得行云暮。",
        "芳草梦魂应记取。",
        "不成忘却池塘句。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315930,
      "title": "凤栖梧・蝶恋花",
      "content": [
        "门外飞花风约住。",
        "消息江南，已酿黄梅雨。",
        "蜀客望乡归不去。",
        "当时不合催南渡。",
        "忧国丹心曾独许。",
        "纵吐长虹，不奈斜阳暮。",
        "莫道春光难揽取。",
        "少陵辨得寻花句。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315931,
      "title": "凤栖梧・蝶恋花",
      "content": [
        "薄薄窗油清似镜。",
        "两面疏帘，四壁文书静。",
        "小篆焚香消日永。",
        "新来识得闲中性。",
        "人爱人嫌都莫问。",
        "絮自沾泥，不怕东风紧。",
        "只有诗狂消不尽。",
        "夜来题破窗花影。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315932,
      "title": "凤栖梧・蝶恋花",
      "content": [
        "九月重湖寒意早。",
        "目断黄云，冉冉连衰草。",
        "惨别临江愁满抱。",
        "酒尊时事都相恼。",
        "闻道吴天消息好。",
        "鸳鸯西池，咫尺君应到。",
        "若见故人相问劳。",
        "为言未分书舟老。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315933,
      "title": "愁倚阑・春光好",
      "content": [
        "山无数，雨萧萧。",
        "路迢迢。",
        "不似芙蓉城下去，柳如腰。",
        "梦随春絮飘飘。",
        "知他在、第几朱桥。",
        "说与杜鹃休唤，怕魂销。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315934,
      "title": "渔家傲",
      "content": [
        "野店无人霜似水。",
        "清灯照影寒侵被。",
        "门外行人催客起。",
        "因个事。",
        "老来方有思家泪。",
        "寄问梅花开也未。",
        "爱花只有归来是。",
        "想见小桥歌舞地。",
        "浑含喜。",
        "天涯不念人憔悴。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315935,
      "title": "渔家傲",
      "content": [
        "独木小舟烟雨湿。",
        "燕儿乱点春江碧。",
        "江上青山随意觅。",
        "人寂寂。",
        "落花芳草催寒食。",
        "昨夜青楼今日客。",
        "吹愁不得东风力。",
        "细拾残红书怨泣。",
        "流水急。",
        "不知那个传消息。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315936,
      "title": "临江仙",
      "content": [
        "送我南来舟一叶，谁教催动鸣榔。",
        "高城不见水茫茫。",
        "云湾才几曲，折尽九回肠。",
        "买酒浇愁愁不尽，江烟也共凄凉。",
        "和天瘦了也何妨。",
        "只愁今夜雨，更做泪千行。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315937,
      "title": "临江仙",
      "content": [
        "浓绿锁窗闲院静，照人明月团团。",
        "夜长幽梦见伊难。",
        "瘦从香脸薄，愁到翠眉残。",
        "只道花时容易见，如今花尽春阑。",
        "画楼依旧五更寒。",
        "可怜红绣被，空记合时欢。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315938,
      "title": "朝中措",
      "content": [
        "矮窗西畔翠荷香。",
        "人在小池塘。",
        "何事未拈期局，却来闲倚胡床。",
        "金盆弄水，玉钗亸鬓，妆懒何妨。",
        "莫道困来不饮，今宵却恨天凉。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315939,
      "title": "朝中措",
      "content": [
        "华筵饮散撤芳尊。",
        "人影乱纷纷。",
        "且约玉骢留住，细将团凤平分。",
        "一瓯看取，招回酒兴，爽彻诗魂。",
        "歌罢清风两腋，归来明月千门。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315940,
      "title": "朝中措",
      "content": [
        "龙团分罢觉芳滋。",
        "歌彻碧云词。",
        "翠袖且留纤玉，沈香载捧冰垍。",
        "一声清唱，半瓯轻啜，愁绪如丝。",
        "记取临汾馀味，图教归后相思。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315941,
      "title": "朝中措",
      "content": [
        "真游六六洞中仙。",
        "骑鹤下三天。",
        "休道日斜岁暮，行年方是韶华。",
        "相逢一笑，此心不动，须待明年。",
        "要得安排稳当，除非四十相连。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315942,
      "title": "朝中措",
      "content": [
        "片花飞后水东流。",
        "无计挽春留。",
        "香小谁栽杜若，梦回依旧扬州。",
        "破瓜年在，娇花艳冶，舞柳纤柔。",
        "莫道刘郎霜鬓，才情未放春休。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315943,
      "title": "醉落魄・一斛珠",
      "content": [
        "风催雨促。",
        "今番不似前欢足。",
        "早来最苦离情毒。",
        "唱我新词，掩著面儿哭。",
        "临行只怕人行远。",
        "殷勤更写多情曲。",
        "相逢已是腰如束。",
        "从此知他，还减几分玉。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315944,
      "title": "酷相思",
      "content": [
        "月挂霜林寒欲坠。",
        "正门外、催人起。",
        "奈离别、如今真个是。",
        "欲住也、留无计。",
        "欲去也、来无计。",
        "马上离魂衣上泪。",
        "各自个、供憔悴。",
        "问江路梅花开也未。",
        "春到也、须频寄。",
        "人到也、须频寄。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315945,
      "title": "生查子",
      "content": [
        "溪光曲曲村，花影重重树。",
        "风物小桃源，春事还如许。",
        "情知送客来，又作寻芳去。",
        "可惜一春诗，总为闲愁赋。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315946,
      "title": "生查子",
      "content": [
        "长记别郎时，月淡梅花影。",
        "梅影又横窗，不见江南信。",
        "无心换夕香，有分怜朝镜。",
        "不怕瘦棱棱，只怕梅开尽。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315947,
      "title": "忆王孙",
      "content": [
        "萧萧梅雨断人行。",
        "门掩残春绿荫生。",
        "翠被寒灯枕自横。",
        "梦初惊。",
        "窗外啼鹃催五更。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315948,
      "title": "卜算子",
      "content": [
        "枕簟暑风消，帘幕秋风动。",
        "月到夜来愁处明，只照团衾凤。",
        "去意杳无凭，别语愁难送。",
        "一纸鱼笺枕底香，且做新来梦。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315949,
      "title": "卜算子",
      "content": [
        "独自上层楼，楼外青山远。",
        "望到斜阳欲尽时，不见西飞雁。",
        "独自下层楼，楼下蛩声怨。",
        "待到黄昏月上时，依旧柔肠断。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315950,
      "title": "卜算子",
      "content": [
        "几日赏花天，月淡荼䕷小。",
        "写尽相思唤不来，又是花飞了。",
        "春在怕愁多，春去怜欢少。",
        "一夜安排梦不成，月堕西窗晓。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315951,
      "title": "霜天晓角",
      "content": [
        "几夜锁窗揭。",
        "素蟾光似雪。",
        "恰恨照人欹枕，纱橱爽、簟纹滑。",
        "迤逦篆香裛。",
        "好坏谁共说。",
        "若是知人风味，来分取、半床月。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315952,
      "title": "霜天晓角",
      "content": [
        "玉清冰样洁。",
        "几夜相思切。",
        "谁料浓云遮拥，同心带、甚时结。",
        "匆匆休惜别。",
        "还有来时节。",
        "记取江阴归路，须共踏、夜深月。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315953,
      "title": "乌夜啼",
      "content": [
        "杨柳拖烟漠漠，梨花浸月溶溶。",
        "吹香院落春还尽，憔悴立东风。",
        "只道芳时易见，谁知密约难通。",
        "芳园绕遍无人问，独自拾残红。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315954,
      "title": "乌夜啼",
      "content": [
        "白酒欺人易醉，黄花笑我多愁。",
        "一年只有秋光好，独自却悲秋。",
        "风急常吹梦去，月迟多为人留。",
        "半黄橙子和诗卷，空自伴床头。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315955,
      "title": "乌夜啼",
      "content": [
        "绿外深深柳巷，红间曲曲花楼。",
        "一春想见贪游冶，不道有人愁。",
        "三月东风易老，几宵明月难留。",
        "酴醿白尽窗前也，还肯醉来否。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315956,
      "title": "瑞鹧鸪",
      "content": [
        "东风冷落旧梅台。",
        "犹喜山花拂面开。",
        "绀色染衣春意静，水沈熏骨晚风来。",
        "柔条不学丁香结，矮树仍参茉莉栽。",
        "安得方盆载幽植，道人随处作香材。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315957,
      "title": "瑞鹧鸪",
      "content": [
        "门前杨柳绿成阴。",
        "翠坞笼香径自深。",
        "迟日暖熏芳草眼，好风轻撼落花心。",
        "无多春恨莺难语，最晚朝眠蝶易寻。",
        "惟有狂醒不相贷，酿成憔悴到如今。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315958,
      "title": "青玉案",
      "content": [
        "宝林岩畔凌云路。",
        "记藉草、寻梅去。",
        "咏绿书红知几度。",
        "行云归后，碧云遮断，寂寞人何处。",
        "一声长笛江天暮。",
        "别后谁吟倚楼句。",
        "匀面照溪心已许。",
        "欲凭锦字，写人愁去，生怕梨花雨。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315959,
      "title": "好事近",
      "content": [
        "别梦记春前，春尽苦无归日。",
        "想见鹊声庭院，误几回消息。",
        "万重离恨万重山，无处说思忆。",
        "只有路傍双堠，也随人孤只。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315960,
      "title": "好事近",
      "content": [
        "天淡一帘秋，明月几时来得。",
        "何事桂底香近，把清光邀勒。",
        "人间明晦总由天，何必问通塞。",
        "且为人如月好，醉莫分南北。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315961,
      "title": "好事近",
      "content": [
        "烟尽戍楼空，又是一帘佳月。",
        "何事山城留滞，负好花时节。",
        "烧灯翦彩没心情，应有翠娥说。",
        "欲借好风吹恨，奈乱云愁叠。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315962,
      "title": "好事近",
      "content": [
        "急雨闹冰荷，销尽一襟烦暑。",
        "趁取晚凉幽会，近翠阴浓处。",
        "风梢危滴撼珠矶，洒面得新句。",
        "莫怪玉壶倾尽，待月明归去。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315963,
      "title": "点绛唇",
      "content": [
        "梅雨收黄，暑风依旧闲庭院。",
        "露荷轻颤。",
        "只有香浮面。",
        "挂起西窗，月澹无人见。",
        "幽情远。",
        "随钗低扇。",
        "好个凉方便。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315964,
      "title": "如梦令",
      "content": [
        "风入藕花翻动。",
        "夜气与香俱纵。",
        "月又带风来，凉意一襟谁共。",
        "情重。",
        "情重。",
        "可惜短宵无梦。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315965,
      "title": "清平乐",
      "content": [
        "山城桃李。",
        "催促春无几。",
        "日日为花须早起。",
        "犹□惜花无计。",
        "阿谁留得春风。",
        "长教绕绿围红。",
        "莫遣十分芳意，输他万点愁容。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315966,
      "title": "清平乐",
      "content": [
        "秋香谁买。",
        "散入琉璃界。",
        "点缀小红全不碍。",
        "还却铅华馀债。",
        "夜来月底相期。",
        "一枝未觉香迟。",
        "恰似青绫帐底，绛罗初试裙儿。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315967,
      "title": "清平乐",
      "content": [
        "疏疏整整。",
        "风急花无定。",
        "红烛照筵寒欲凝。",
        "时见筛帘玉影。",
        "夜深明月笼纱。",
        "醉归凉面香料。",
        "犹有惜梅心在，满庭误作吹花。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315968,
      "title": "清平乐",
      "content": [
        "绿深红少。",
        "柳外横桥小。",
        "双燕不知幽梦好。",
        "惊起碧窗春晓。",
        "起来瞢�┒嗍薄�",
        "玉台金镜慵移。",
        "多少春愁未说，却来闲数花枝。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315969,
      "title": "望秦川・南歌子",
      "content": [
        "柳弱眠初醒，梅残舞尚痴。",
        "春阴将冷傍帘帷。",
        "又是东风和恨、向人归。",
        "乐事灯前记，愁肠酒后知。",
        "老来无计遣芳时。",
        "只有闲情随分、品花枝。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315970,
      "title": "望秦川・南歌子",
      "content": [
        "竹粉翻新箨，荷花拭靓妆。",
        "断云侵晚度横塘。",
        "小扇斜钗依约、傍牙床。",
        "蘸蜜分红荔，倾筒泻碧香。",
        "醉时风雨醒时凉。",
        "明月多情依旧、过西厢。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315971,
      "title": "望秦川・南歌子",
      "content": [
        "翠黛随妆浅，铢衣称体香。",
        "好风偏与十分凉。",
        "却扇含情独自、绕池塘。",
        "碧藕丝丝嫩，红榴叶叶双。",
        "牵丝摘叶为谁忙。",
        "情到厌厌拼醉、又何妨。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315972,
      "title": "天仙子",
      "content": [
        "惨惨霜林冬欲尽。",
        "又是溪梅寒弄影。",
        "矮窗曲屋夜烧香，人已静。",
        "灯垂烬。",
        "点滴芭蕉和雨听。",
        "约个归期犹未定。",
        "一夜梦魂终不稳。",
        "知他勾得许多情，真个闷。",
        "无人问。",
        "说与画楼应不信。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315973,
      "title": "望江南・忆江南",
      "content": [
        "篷上雨，篷底有人愁。",
        "身在汉江东畔去，不知家在锦江头。",
        "烟水两悠悠。",
        "吾老矣，心事几时休。",
        "沈水熨香年似日，薄云垂帐夏如秋。",
        "安得小书舟。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315974,
      "title": "南歌子",
      "content": [
        "雨燕翻新幕，风鹃绕旧枝。",
        "画堂春尽日迟迟。",
        "又是一番平绿、涨西池。",
        "病起尊难尽，腰宽带易垂。",
        "不堪村落子规啼。",
        "问道行人一去、几时归。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315975,
      "title": "南歌子",
      "content": [
        "淡霭笼青琐，轻寒薄翠绡。",
        "有人憔悴带宽腰。",
        "又见东风、不忍见柔条。",
        "闷酒尊难寻，闲香篆易销。",
        "夜来溪雪已平桥。",
        "溪上梅魂凭仗、一相招。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315976,
      "title": "南歌子",
      "content": [
        "梅坞飞香定，兰窗翠色齐。",
        "水边沙际又春归。",
        "领略东风、能有几人知。",
        "爱月眠须晚，寻花去未迟。",
        "谁家庭院更芳菲。",
        "费尽才情、休负一春诗。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315977,
      "title": "南歌子",
      "content": [
        "荷盖倾新绿，榴巾蹙旧红。",
        "水亭烟榭晚凉中。",
        "又是一钩新月、静房栊。",
        "丝藕清如雪，幮纱薄似空。",
        "好维今夜与谁同。",
        "唤取玉人来共、一帘风。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315978,
      "title": "南歌子",
      "content": [
        "野水寻溪路，青山踏晚春。",
        "偶来相值却锺情。",
        "一树琼瑶洗尽、客衣襟。",
        "曲沼通诗梦，幽窗净俗尘。",
        "何时散发伴襜裙。",
        "后夜相思生怕、月愁人。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315979,
      "title": "南乡子",
      "content": [
        "几日诉离尊。",
        "歌尽阳关不忍分。",
        "此度天涯真个去，销魂。",
        "相送黄花落叶村。",
        "斜日又黄昏。",
        "萧寺无人半掩门。",
        "今夜粉香明月泪，休论。",
        "只要罗巾记旧痕。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315980,
      "title": "浪淘沙",
      "content": [
        "才合又轻离。",
        "心事多违。",
        "小窗灯影记亲移。",
        "可奈酒酣花困处，不省人归。",
        "山翠又如眉。",
        "肠断幽期。",
        "相思有梦阿谁知。",
        "莫遣重来风絮乱，不似当时。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315981,
      "title": "浪淘沙",
      "content": [
        "老去懒寻花。",
        "独自生涯。",
        "几枝疏影浸窗纱。",
        "昨夜月来人不睡，看尽横斜。",
        "门外欲啼鸦。",
        "香意凌霞。",
        "从渠千树绕人家。",
        "世上一枝元也足，不要随他。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315982,
      "title": "摊破南乡子",
      "content": [
        "休赋惜春诗。",
        "留春住、说与人知。",
        "一年已负东风瘦，说愁说恨，数期数刻，只望归时。",
        "莫怪杜鹃啼。",
        "真个也、唤得人归。",
        "归来休恨花开了，梁间燕子，且教知道，人也双飞。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315983,
      "title": "祝英台・祝英台近",
      "content": [
        "坠红轻，浓绿润，深院又春晚。",
        "睡起厌厌，无语小妆懒。",
        "可堪三月风光，五更魂梦，又都被、杜鹃催攒。",
        "怎消遣。",
        "人道愁与春归，春归愁未断。",
        "闲倚银屏，羞怕泪痕满。",
        "断肠沈水重熏，瑶琴闲理，奈依旧、夜寒人远。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315984,
      "title": "虞美人",
      "content": [
        "轻红短白东城路。",
        "忆得分襟处。",
        "柳丝无赖舞春柔。",
        "不系离人、只解系离愁。",
        "如今花谢春将老。",
        "柳下无人到。",
        "月明门外子规啼。",
        "唤得人愁、争似唤人归。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315985,
      "title": "长相思",
      "content": [
        "对重阳。",
        "感重阳。",
        "身在西风天一方。",
        "年年人断肠。",
        "景凄凉。",
        "客凄凉。",
        "纵有黄花祗异乡。",
        "晚云连梦长。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315986,
      "title": "长相思",
      "content": [
        "酒孤斟。",
        "客孤吟。",
        "戏马台荒露草深。",
        "英雄何处寻。",
        "爱登临。",
        "莫登临。",
        "定是愁来关客心。",
        "暮天烟水沈。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315987,
      "title": "长相思",
      "content": [
        "风敲窗。",
        "雨敲窗。",
        "窗外芭蕉云作幢。",
        "声声愁对床。",
        "剔银缸。",
        "点银缸。",
        "梦采芙蓉隔一江。",
        "几时蝴蝶双。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315988,
      "title": "鹊桥仙",
      "content": [
        "角声吹月，风声落枕，梦与柔肠俱断。",
        "谁教当日太情浓，飏不下、新愁一段。",
        "黄花开了，梅花开未，曾约那时相见。",
        "莫教容易负幽期，怕真个、孤他泪眼。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315989,
      "title": "醉落魄・一斛珠",
      "content": [
        "晚凉时节。",
        "翠梧风定蝉声歇。",
        "有人睡起香浮颊。",
        "倚著阑干，笑拣青荷叶。",
        "如今往事愁难说。",
        "曲池依旧闲风月。",
        "田田翠盖香罗叠。",
        "留得露痕，都是泪珠结。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315990,
      "title": "减字木兰花",
      "content": [
        "双双相并。",
        "一点红边偏照映。",
        "玉翦云裁。",
        "不比浮花共蒂开。",
        "几回心曲。",
        "选胜摘来情自足。",
        "插向云鬟。",
        "要与仙郎比并看。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315991,
      "title": "谒金门",
      "content": [
        "春悄悄。",
        "红到一枝先巧。",
        "酒入半腮微带卯。",
        "粉寒香未饱。",
        "芳意枝头偏闹。",
        "困尽蜂须莺爪。",
        "拟倩玉纤和露拗。",
        "情多愁易搅。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315992,
      "title": "谒金门",
      "content": [
        "花簇簇。",
        "触眼万条垂玉。",
        "小院春深窗锁绿。",
        "水沈风断续。",
        "明月又侵楼曲。",
        "羞向枕囊拘束。",
        "只待夜深清影足。",
        "醉来花底宿。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315993,
      "title": "谒金门",
      "content": [
        "乌帽侧。",
        "行遍杏花春色。",
        "野意青青分陇麦。",
        "人家烟水隔。",
        "春事莫催行客。",
        "弹指青梅堪摘。",
        "醉倚暮天江拍拍。",
        "雨晴沙路白。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315994,
      "title": "谒金门",
      "content": [
        "花半湿。",
        "一霎晚云笼密。",
        "天气未佳风又急。",
        "小庭愁独立。",
        "酒病起来无力。",
        "懊恼篆烟锁碧。",
        "一饷春情无处觅。",
        "小屏山数尺。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315995,
      "title": "谒金门",
      "content": [
        "春夜雨。",
        "催润柳塘花坞。",
        "小院深深门几许。",
        "画帘香一缕。",
        "独立晚庭凝伫。",
        "细把花枝闲数。",
        "燕子不来天欲暮。",
        "说愁无处所。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315996,
      "title": "谒金门",
      "content": [
        "风阵阵。",
        "吹落杨花无定。",
        "酒病厌厌三月尽。",
        "花檀红自隐。",
        "新绿轩窗清润。",
        "月影又移墙影。",
        "手拈青梅无处问。",
        "一春长闷损。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315997,
      "title": "谒金门",
      "content": [
        "浓睡醒。",
        "惊对一帘秋影。",
        "桐叶乍零风不定。",
        "半窗疏雨影。",
        "愁与年光不尽。",
        "老入星星双鬓。",
        "只拟上楼寻远信。",
        "雁遥烟水暝。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315998,
      "title": "蝶恋花",
      "content": [
        "日下船篷人未起。",
        "一个燕儿，说尽伤春意。",
        "江上残花能有几。",
        "风催雨促成容易。",
        "湖海客心千万里。",
        "著力东风，推得人行未。",
        "相次桃花三月水。",
        "菱歌谁伴西湖醉。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315999,
      "title": "蝶恋花",
      "content": [
        "满路梅英飞雪粉。",
        "临水人家，先得春光嫩。",
        "楼底杏花楼外影。",
        "墙东柳线墙西恨。",
        "撷翠揉红何处问。",
        "暖入眉峰，已作伤春困。",
        "归路月痕弯一寸。",
        "芳心只为东风损。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316000,
      "title": "蝶恋花",
      "content": [
        "寒意勒花春未足。",
        "只有东风，不管春拘束。",
        "杨柳满城吹又绿。",
        "可人青眼还相属。",
        "小叶星星眠未熟。",
        "看尽行人，唱彻《阳关曲》。",
        "心事一春何计续。",
        "芳条未展眉先蹙。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    }
  ],
