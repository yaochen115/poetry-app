{
  "data": [
    {
      "id": 32973,
      "title": "自蜀州暂还成都奉简诸公",
      "content": [
        "不染元规一点尘，行歌偶到锦江濵。",
        "淋漓诗酒无虚日，判断莺花又过春。",
        "客路柳阴初堕絮，还家梅子欲生仁。",
        "更须作意勤相过，要信年光属散人。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32974,
      "title": "摩诃池",
      "content": [
        "摩诃古池苑，一过一消魂。",
        "春水生新涨，烟芜没旧痕。",
        "年光走车毂，人事转萍根。",
        "犹有宫梁燕，衘泥入水门。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 32975,
      "title": "三月十七日夜醉中作",
      "content": [
        "前年脍鲸东海上，白浪如山寄豪壮。",
        "去年射虎南山秋，夜归急雪满貂裘。",
        "今年摧颓最堪笑，华发苍颜羞自照。",
        "谁知得酒尚能狂，脱帽向人时大叫。",
        "逆胡未灭心未平，孤剑床头铿有声。",
        "破驿梦回灯欲死，打窗风雨正三更。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 32976,
      "title": "嘉祐院观壁间文湖州墨竹",
      "content": [
        "石室先生笔有神，我来拂拭一酸辛。",
        "败墙惨澹欲无色，老气森严犹逼人。",
        "惯阅冰霜元耐久，耻随儿女更争春。",
        "纷纷可笑空摹拟，尔辈毫端万斛尘。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32977,
      "title": "春晚书怀三首  其一",
      "content": [
        "吹尽郊原万点红，燕梁考室亦匆匆。",
        "老来偏觉岁华速，客里忽惊春事空。",
        "病有药方传肘后，懒无诗句付囊中。",
        "归心日夜随江水，只欲东门觅短篷。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32978,
      "title": "春晚书怀三首  其二",
      "content": [
        "经春淹泊锦官城，作个归期苦未成。",
        "老向轩裳增力量，病于风月减心情。",
        "官闲有味缘高卧，酒贵无忧为细倾。",
        "忆探梅花如昨日，西斋榆荚与阶平。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32979,
      "title": "春晚书怀三首  其三",
      "content": [
        "老客天涯心尚孩，惜春直欲挽春回。",
        "长绳纵系斜阳住，右手难移故国来。",
        "暑近蚊雷先隠辚，雨前螘垤正崔嵬。",
        "茹芝却粒终无术，万事惟须付一杯。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32980,
      "title": "偶忆万州戏作短歌",
      "content": [
        "峡中天下最穷处，万州萧条谁肯顾。",
        "去年正月偶过之，曾为巴人三日住。",
        "南浦寻梅雪满舟，西山载酒云生屦。",
        "至今梦听竹枝声，灯火纷纷驿前路。",
        "残春犹客蜀江边，陈迹回思一怆然。",
        "渐老定知欢渐少，明年还复忆今年。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 32981,
      "title": "驿舍见故屏风画海棠有感",
      "content": [
        "厌烦只欲长面壁，此心安得顽如石。",
        "杜门复出叹习气，止酒还开惭定力。",
        "成都二月海棠开，锦绣裹城迷巷陌。",
        "燕宫最盛号花海，霸国雄豪有遗迹。",
        "猩红鸭绿极天巧，叠蕚重跗眩朝日。",
        "繁华一梦忽吹散，闭眼细思犹歴歴。",
        "忧乐相寻岂易知，故人应记醉中诗。",
        "夜阑风雨嘉州驿，愁向屏风见折枝。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 32982,
      "title": "思政堂东轩偶题",
      "content": [
        "羁愁酒病两无聊，小篆吹香已半消。",
        "唤起十年闽岭梦，赪桐花畔见红蕉。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 32983,
      "title": "荔枝楼小酌二首  其一",
      "content": [
        "碧瓦朱栏已半摧，强呼歌舞试樽罍。",
        "邦人莫讶心情懒，新出莺花海里来。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 32984,
      "title": "荔枝楼小酌二首  其二",
      "content": [
        "病与愁兼怯酒船，巴歌闻罢更凄然。",
        "此身未死长为客，回首夔州又二年。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 32985,
      "title": "嘉阳官舍奇石甚富散弃无领略者予始取作假山因名西斋曰小山堂为赋短歌",
      "content": [
        "昔人何人爱岩壑，为山未成储荦确。",
        "散落支床压酒槽，大或专车小拳握。",
        "幽人邂逅为绝叹，修绠趣取寒泉濯。",
        "峭峰幽窦相吐吞，翠岭丹崖渺聨络。",
        "石不能言意可解，问我胡为怜寂寞。",
        "人间兴废自有数，昔弃何伤今岂乐。",
        "斯言妙矣予则陋，敢对石友辞罸爵。",
        "为君宽作十日留，在眼便同真著脚。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 32986,
      "title": "望云楼晚兴",
      "content": [
        "小阁东南独咏诗，此生终与世差池。",
        "夕阳明处苍烟合，栖燕归时画角悲。",
        "人与江山均是梦，心非风月尚谁知。",
        "旧交几岁音尘隔，三抚阑干有所思。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32987,
      "title": "护国天王院故神霄玉清万寿宫也废圯略尽而规模尚极壮丽过之有感",
      "content": [
        "太霄帝君神霄府，一日玺书行海宇。",
        "筑宫奔走谁敢后，万牛挽材山作础。",
        "步虚夜半落云间，玉磬漻漻鸾鹤舞。",
        "帝师丞相领使君，侍晨校籍纷如雨。",
        "洛阳临淮小睥睨，御史立奏投裔土。",
        "从来桑门喜嘲竞，举国冠巾噤无语。",
        "古传东海会扬尘，君看此地亦荆榛。",
        "霓旌仙仗空遗堵，甃缺台倾知几春。",
        "牧儿驱牛啮庭草，谁记剑佩来朝真。",
        "斜阳却上笋舆去，沟水泠泠愁杀人。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 32988,
      "title": "登荔枝楼",
      "content": [
        "平羌江水接天流，凉入帘栊已似秋。",
        "唤作主人元是客，知非吾土强登楼。",
        "闲凭曲槛常忘去，欲下危梯更小留。",
        "公事无多厨酿美，此身不负负嘉州。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32989,
      "title": "再赋荔枝楼",
      "content": [
        "只道文书拨不开，未妨高处独徘徊。",
        "山横瓦屋披云出，水自牂牁裂地来。",
        "暝入帘阴吹细雨，凉生楼角转轻雷。",
        "痴顽也拟忘乡国，不奈城头暮角哀。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32990,
      "title": "能仁院前有石像丈余盖作大像时様也",
      "content": [
        "江阁欲开千尺像，云龛先定此规模。",
        "斜阳徙倚空三叹，尝试成功自古无。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 32991,
      "title": "谒凌云大像",
      "content": [
        "出郭幽寻一笑新，径呼艇子截烟津。",
        "不辞疾步登重阁，聊欲今生识伟人。",
        "泉镜正涵螺髻绿，浪花不犯宝趺尘。",
        "始知神力无穷尽，丈六黄金果小身。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32992,
      "title": "凌云醉归作",
      "content": [
        "峨嵋月入平羌水，叹息吾行俄至此。",
        "谪仙一去五百年，至今醉魂呼不起。",
        "玻瓈春满琉璃钟，宦情苦薄酒兴浓。",
        "饮如长鲸渴赴海，诗成放笔千觞空。",
        "十年看尽人间事，更觉曲生偏有味。",
        "君不见蒲萄一斗换得西凉州，不如将军告身供一醉。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 32993,
      "title": "独游城西诸僧舍",
      "content": [
        "我是天公度外人，看山看水自由身。",
        "藓崖直上飞双屐，云洞前头岸幅巾。",
        "万里欲呼牛渚月，一生不受庾公尘。",
        "非无好客堪招唤，独往飘然觉更真。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32994,
      "title": "西林院",
      "content": [
        "一邦尽对江边像，试比西林总不如。",
        "群玉萧森开士宅，五云飞动相君书。",
        "磴危渐觉山争出，屐响方惊阁半虚。",
        "安得弃官长住此，一杯香饭荐珍蔬。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32995,
      "title": "听事前紫薇花二本甚盛戏题绝句",
      "content": [
        "红药紫薇西省春，从来惟惯对词臣。",
        "问囚自是粗官分，无奈名花解笑人。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 32996,
      "title": "同何元立蔡肩吾至东丁院汲泉煮茶二首  其一",
      "content": [
        "一州佳处尽裴回，惟有东丁院未来。",
        "身是江南老桑苎，诸君小住共茶杯。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 32997,
      "title": "同何元立蔡肩吾至东丁院汲泉煮茶二首  其二",
      "content": [
        "雪芽近自峨嵋得，不减红囊顾渚春。",
        "旋置风炉清樾下，他年奇事记三人。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 32998,
      "title": "癸巳夏旁郡多苦旱惟汉嘉数得雨然未足也立秋夜三鼓雨至明日晡后未止高下霑足喜而有赋二首  其一",
      "content": [
        "画簷鸣雨早秋天，不喜新凉喜有年。",
        "眼里香秔三万顷，寄声父老共欣然。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 32999,
      "title": "癸巳夏旁郡多苦旱惟汉嘉数得雨然未足也立秋夜三鼓雨至明日晡后未止高下霑足喜而有赋二首  其二",
      "content": [
        "五十衰翁发半华，犹能把酒醉天涯。",
        "丝毫美政何曾有，惟把丰年赠汉嘉。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 33000,
      "title": "晚登望云二首  其一",
      "content": [
        "一出修门又十年，辈流多已珥金蝉。",
        "衰如蠧叶秋先觉，愁似鳏鱼夜不眠。",
        "辇路疏槐迎驾处，苑城残日泛湖天。",
        "君恩未报身今老，徙倚危楼一泫然。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 33001,
      "title": "晚登望云二首  其二",
      "content": [
        "晚来烟雨暗江干，烽火遥传画角残。",
        "看镜功名空自许，上楼怀抱若为宽。",
        "青枫揺落新秋令，白发凄凉旧史官。",
        "饱见少年轻宿士，可怜随处强追欢。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 33002,
      "title": "立秋后十日风雨凄冷独居有感",
      "content": [
        "急雨鸣瓦沟，尖风入窗罅。",
        "纱笼耿青灯，寂寂新秋夜。",
        "谁言簿领中，乃复有此暇。",
        "稍繙书册读，已念灰火跨。",
        "那知是羁客，恍若在家舍。",
        "睡晚且熟眠，洗沐官有假。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 33003,
      "title": "晦日西窗怀故山",
      "content": [
        "今朝休日仍无客，茶罢西窗卧解衣。",
        "白发已侵残梦境，绿苔应满旧渔矶。",
        "桃源鸡犬尘凡隔，杜曲桑麻梦想归。",
        "赖有小山聊慰眼，幽篁丛桂雨霏霏。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 33004,
      "title": "秋日怀东湖二首  其一",
      "content": [
        "小阁东头罨画池，秋来长是忆幽期。",
        "身如巢燕临归日，心似堂僧欲动时。",
        "病思羁怀惟付酒，西风落日更催诗。",
        "故知岁暮常多感，不独当年宋玉悲。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 33005,
      "title": "秋日怀东湖二首  其二",
      "content": [
        "罨画池边小钓矶，垂竿几度到斜晖。",
        "青苹叶动知鱼过，朱阁帘开看燕归。",
        "岁晚官身空自闵，途穷世事巧相违。",
        "边州客少巴歌陋，谁与愁城略解围。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 33006,
      "title": "小山之南作曲栏石磴缭绕如栈道戏作二篇  其一",
      "content": [
        "羁游随处得哦诗，扫溉轩窗每恨迟。",
        "已幻小山宽客恨，更添危磴作儿嬉。",
        "偶留塞上寜无数，径返湖边已有期。",
        "谁遣化工娱此老，幽花微拆绿苔滋。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 33007,
      "title": "小山之南作曲栏石磴缭绕如栈道戏作二篇  其二",
      "content": [
        "吏退庭空剩得闲，一窗如在翠微间。",
        "半崖萦栈游秦路，叠嶂生云入剡山。",
        "真有岩居临绝壑，但无渔艇系寒湾。",
        "跻攀自苦君休笑，寸步何曾不险艰。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 33008,
      "title": "得成都诸友书劝少留嘉阳戏作",
      "content": [
        "一坐五十日，痴顽良可哀。",
        "新凉为醉地，少讼作慵媒。",
        "市柳风烟惨，汀苹岁月催。",
        "远官从漫浪，垂老懒低回。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 33009,
      "title": "道院",
      "content": [
        "四壁长苔痕，经旬掩绿樽。",
        "雨声清梦境，灯影伴吟魂。",
        "揺落悲徂岁，漂流忆故园。",
        "拟骚无杰语，千古愧湘沅。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 33010,
      "title": "醉中感怀",
      "content": [
        "早岁君王记姓名，只今憔悴客边城。",
        "青衫犹是鹓行旧，白发新从剑外生。",
        "古戍旌旗秋惨淡，高城刁斗夜分明。",
        "壮心未许全消尽，醉听檀槽出塞声。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 33011,
      "title": "玻瓈江",
      "content": [
        "玻瓈江水千尺深，不如江上离人心。",
        "君行未过青衣县，妾心先到峨嵋阴。",
        "金罇共釂不知晓，月落烟渚天横参。",
        "车轮无角那得住，马蹄不方何处寻。",
        "空凭尺素寄幽恨，纵有绿绮谁知音。",
        "愁来只欲掩屏睡，无奈梦断闻疏砧。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 33012,
      "title": "夜思",
      "content": [
        "苍颜华鬓久低摧，叹息何堪岁月催。",
        "残暑已随团扇去，新凉还傍短檠来。",
        "月痕澹澹侵苔砌，云叶萧萧覆水台。",
        "簿领沈迷无日了，试凭诗思洗氛埃。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 33013,
      "title": "雨夜怀唐安",
      "content": [
        "归心日夜逆江流，官柳三千忆蜀州。",
        "小阁帘栊频梦蝶，平湖烟水已盟鸥。",
        "萤依湿草同为旅，雨滴空阶别是愁。",
        "堪笑邦人不解事，区区犹借陆君留。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 33014,
      "title": "迎诏书",
      "content": [
        "忆瞻銮仗省门前，扇影鞭声下九天。",
        "寂寞嘉州迎诏处，忽闻鼓吹却凄然。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 33015,
      "title": "秋夜遣怀",
      "content": [
        "江云傍簷山雨细，羁客空堂卧荒翳。",
        "心如秋燕不安巢，迹似春萍本无柢。",
        "官身奔走何时定，病眼蒙笼惟欲闭。",
        "壮游不复记坠鞭，夜语谁能怀拥髻。",
        "诗情已减但微吟，酒戒渐坚才小哜。",
        "从今更拟著幽禅，半世伥伥真误计。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 33016,
      "title": "送客至江上",
      "content": [
        "多事经旬不出城，今朝送客此闲行。",
        "郊原远带新晴色，人语中含乐岁声。",
        "天际敛云山尽出，江流收涨水初平。",
        "故园社友应惆怅，五岁无端弃耦耕。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 33017,
      "title": "雨中至西林寺",
      "content": [
        "胸中荆棘费鉏耘，正藉幽寻暂解纷。",
        "不尽长江来画玉，半空飞阁对凌云。",
        "昏昏横霭凭轩见，杳杳疏钟隔岸闻。",
        "珍重山僧迎客意，螭奁一缕起微熏。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 33018,
      "title": "休日登花将军庙小楼",
      "content": [
        "林间缥缈出层楼，栏角苍茫万顷秋。",
        "曾是胸中著云梦，不妨此地少迟留。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 33019,
      "title": "深居",
      "content": [
        "作吏难堪簿领迷，深居聊复学幽栖。",
        "病来酒户何妨小，老去诗名不厌低。",
        "零落野云寒傍水，霏微山雨晚成泥。",
        "自怜甫里家风在，小摘残蔬遶废畦。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 33020,
      "title": "秋夜独醉戏题",
      "content": [
        "敝袍羸马遍天涯，恰似伶优著处家。",
        "社瓮嫩醅初泛蚁，寒缸残烬自成花。",
        "幽窗照影乌巾折，醉手题诗淡墨斜。",
        "莫恨久为峨下客，江湖归去得雄夸。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 33021,
      "title": "感事",
      "content": [
        "清班曾见六龙飞，晚落天涯远日畿。",
        "边月空悲新雪鬓，京尘犹染旧朝衣。",
        "江山壮丽诗难敌，风物萧条醉绝稀。",
        "赖有东湖堪吏隠，寄声篱菊待吾归。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 33022,
      "title": "醉乡",
      "content": [
        "醉乡卜筑亦佳哉，但苦无情白发催。",
        "痴欲煎胶黏日月，狂思入海访蓬莱。",
        "辞巢归燕先秋去，泣露幽花近社开。",
        "莫惜倾家供作乐，古人白骨有苍苔。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 33023,
      "title": "夜读岑嘉州诗集",
      "content": [
        "汉嘉山水邦，岑公昔所寓。",
        "公诗信豪伟，笔力追李杜。",
        "常想从军时，气无玉关路。",
        "至今蠧简传，多昔横槊赋。",
        "零落财百篇，崔嵬多杰句。",
        "工夫刮造化，音节配韶頀。",
        "我后四百年，清梦奉巾屦。",
        "晚途有奇事，随牒得补处。",
        "群胡自鱼肉，明主方北顾。",
        "诵公天山篇，流涕思一遇。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 33024,
      "title": "次韵师伯浑见寄",
      "content": [
        "眉山汉嘉东西州，估船日日到津头。",
        "不得讲书一行字，倚遍临江百尺楼。",
        "黄钟大吕忽复见，绣叚英瑶何足酬。",
        "愿约青神王夫子，来醉万景作中秋。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 33025,
      "title": "社前一夕未昏辄寝中夜乃得寐",
      "content": [
        "祠事当行惧不任，未昏强卧拥孤衾。",
        "三更自笑元无睡，万事从来忌有心。",
        "簷角河倾秋耿耿，床头虫语夜愔愔。",
        "若耶溪上苹花老，倦枕何人听越吟。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 33026,
      "title": "晚雨",
      "content": [
        "萧瑟度横塘，霏微映缭墙。",
        "压低尘不动，洒急土生香。",
        "声入楸梧碎，清分枕簟凉。",
        "回头忽陈迹，簷角挂斜阳。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 33027,
      "title": "社日",
      "content": [
        "百谷登场酒满巵，神林箫鼓晚清悲。",
        "蝉依疏柳长言处，燕委空巢大去时。",
        "幼学已忘那用忌，微聋自乐不须医。",
        "伤心故里鸡豚集，父老逢迎正见思。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 33028,
      "title": "夜雨感怀",
      "content": [
        "老来每惜岁峥嵘，几为巴歌判宿酲。",
        "白帝草生时入梦，锦官花重更关情。",
        "帘疏夜雨侵灯晕，枕冷秋风逓角声。",
        "定许何时理归棹，酒狂犹解赋芜城。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 33029,
      "title": "八月二十二日嘉州大阅",
      "content": [
        "陌上弓刀拥寓公，水边旌斾卷秋风。",
        "书生又试戎衣窄，山郡新添画角雄。",
        "早事枢庭虚画策，晚游幕府愧无功。",
        "草间鼠辈何劳磔，要挽天河洗洛嵩。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 33030,
      "title": "九月六夜梦中作笑诗觉而忘之明日戏追补一首",
      "content": [
        "吾家笑疾自士龙，我才虽卑笑则同。",
        "纷纷世事何足计，尽付抚掌掀髯中。",
        "清樽可醉风月好，虚空万象皆绝倒。",
        "问君此笑是喜不，道得老夫输一筹。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 33031,
      "title": "重九会饮万景楼",
      "content": [
        "粲粲黄花手自持，登高聊答此佳时。",
        "纤云不作看山祟，斗酒聊宽去国思。",
        "落日楼台频徙倚，西风鼓笛倍凄悲。",
        "彭城戏马平生意，强为巴歌一解颐。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 33032,
      "title": "久客书怀",
      "content": [
        "行役饱看山，沉绵剩得闲。",
        "忘忧缘落魄，耐老为痴顽。",
        "射虎临秦塞，骑驴入蜀关。",
        "芳洲兰可佩，幽磴桂堪攀。",
        "欸乃声饶楚，陬隅句带蛮。",
        "悠然长自遣，故里几时还。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 33033,
      "title": "初报嘉阳除官还东湖有期喜而有作",
      "content": [
        "塞上经秋几醉醒，羁愁减尽鬓边青。",
        "烽传八诏登楼看，歌奏三巴忍泪听。",
        "好语忽闻还印绶，归心先已绕林坰。",
        "呼儿结束从今日，鹊语灯花故有灵。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 33034,
      "title": "闻勾龙司戸会客山亭送酒殽及橄榄并简诸同僚",
      "content": [
        "东山如高人，吾辈岂易见。",
        "君独不出门，终日与相面。",
        "阴晴烟雨月，朝暮知几变。",
        "闻君交不渎，冠佩未尝燕。",
        "弛张要有时，一笑山未谴。",
        "高秋得佳日，折简唤诸彦。",
        "风流非俗饮，歌舞参笔砚。",
        "但恨五日尹，阻造三语掾。",
        "清樽遣分似，霜果亦可荐。",
        "烂醉君勿辞，光景真掣电。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 33035,
      "title": "九月十六日夜梦驻军河外遣使招降诸城觉而有作",
      "content": [
        "杀气昏昏横塞上，东并黄河开玉帐。",
        "昼飞羽檄下列城，夜脱貂裘抚降将。",
        "将军枥上汗血马，猛士腰间虎文韔。",
        "阶前白刅明如霜，门外长戟森相向。",
        "朔风卷地吹急雪，转盼玉花深一丈。",
        "谁言铁衣冷彻骨，感义怀恩如挟纩。",
        "河外诸城一洗空，太行北岳元无恙。",
        "更呼斗酒作长歌，要遣天山健儿唱。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 33036,
      "title": "何元立示九日诗卧病累日乃能次韵",
      "content": [
        "何郎戏写菊花秋，落笔纵横岂易酬。",
        "豪士乃能为老伴，寓公那得称遨头。",
        "早衰不耐危亭冷，独卧空惊画角愁。",
        "病起尚思寻宿约，一樽从子醉东楼。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 33037,
      "title": "成都行",
      "content": [
        "倚锦瑟，击玉壶，吴中狂士游成都。",
        "成都海棠十万株，繁华盛丽天下无。",
        "青丝金络白雪驹，日斜驰遣迎名姝。",
        "燕脂褪尽见玉肤，绿鬟半脱娇不梳。",
        "吴绫便面对客书，斜行小草密复疏。",
        "墨君秀润瘦不枯，风枝雨叶笔笔殊。",
        "月浸罗韈清夜徂，满身花影醉索扶。",
        "东来此欢堕空虚，坐悲新霜点鬓须。",
        "易求合浦千斛珠，难觅锦江双鲤鱼。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 33038,
      "title": "闻虏乱有感",
      "content": [
        "前年从军南山南，夜出驰猎常半酣。",
        "玄熊苍兕积如阜，赤手曵虎毛毵毵。",
        "有时登高望鄠社，悲歌仰天泪如雨。",
        "头颅自揣已可知，一死犹思报明主。",
        "近闻索虏自相残，秋风抚剑泪汍澜。",
        "雒阳八陵那忍说，玉座尘昏松柏寒。",
        "儒冠忽忽垂五十，急装何由穿袴褶。",
        "羞为老骥伏枥悲，寜作枯鱼过河泣。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 33039,
      "title": "醉歌",
      "content": [
        "我饮江楼上，阑干四面空。",
        "手把白玉船，身游水精宫。",
        "方我吸酒时，江山入胸中。",
        "肺肝生崔嵬，吐出为长虹。",
        "欲吐辄复吞，颇畏惊儿童。",
        "乾坤大如许，无处著此翁。",
        "何当呼青鸾，更驾万里风。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 33040,
      "title": "初寒",
      "content": [
        "江路常逢雨，山城早得寒。",
        "兰凋初解佩，菊老尚加餐。",
        "节物知何负，情怀自鲜欢。",
        "浮生看已熟，不必梦邯郸。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 33041,
      "title": "木山",
      "content": [
        "枯楠千岁遭风雷，披枝折干吁可哀。",
        "轮囷无用天所赦，秋水初落浮江来。",
        "嵌空宛转若耳鼻，峭瘦拔起何崔嵬。",
        "珠宫贝阙留不得，忽出洲渚知谁推。",
        "书窗正对云洞启，樷菊初傍幽篁栽。",
        "是间著汝颇宜称，摩挲朝暮真千回。",
        "天公解事雨十日，洗尽泥滓滋莓苔。",
        "一丘一壑吾所许，不须更慕明堂材。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 33042,
      "title": "寒夜遣怀",
      "content": [
        "临觞本不饮，忧多自成醉。",
        "四方行万里，不见埋忧地。",
        "忆昔入京都，宝马揺香鬃。",
        "酣饮青楼夜，歌声在半空。",
        "去日不可挽，华发忽垂领。",
        "娟娟峨眉月，相对作凄冷。",
        "月落照空床，不寐听寒螀。",
        "早知忧随人，何用去故乡。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 33043,
      "title": "嘉阳绝无木犀偶得一枝戏作",
      "content": [
        "久客红尘不自怜，眼明初见广寒仙。",
        "只饶篱菊同时出，尚占江梅一著先。",
        "重露湿香幽径晓，斜阳烘蕊小窗妍。",
        "何人更与蒸况水，金鸭华灯恼醉眠。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 33044,
      "title": "雨后登西楼独酌",
      "content": [
        "老觉人间无一欣，强寻高处看归云。",
        "天空列嶂开图画，水落寒江学篆文。",
        "四海道途行大半，百年光景近中分。",
        "交游赖有曲生在，正向愁时能策勲。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 33045,
      "title": "喜晴",
      "content": [
        "西风吹雨冷凄凄，道上行人白昼迷。",
        "聊抉重云取朝日，未容嘉谷卧秋泥。",
        "年丰郡府疏文檄，蛮遁边亭息鼓鼙。",
        "寄语农家莫游惰，冬闲正要饱鉏犁。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 33046,
      "title": "晓出城东",
      "content": [
        "渺渺长江下估船，亭亭孤塔隠苍烟。",
        "不堪异县萧条地，更遇初寒惨澹天。",
        "巾褐已成归有约，箪瓢未足去无缘。",
        "包羞强索侏儒米，豪举何人记少年。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 33047,
      "title": "宝剑吟",
      "content": [
        "幽人枕宝剑，殷殷夜有声。",
        "人言剑化龙，直恐兴风霆。",
        "不然愤狂虏，慨然思遐征。",
        "取酒起酹剑，至宝当潜形。",
        "岂无知君者，时来自施行。",
        "一匣有余地，胡为鸣不平。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 33048,
      "title": "十月一日浮桥成以故事宴客凌云",
      "content": [
        "阴风吹雨白昼昏，谁扫云雾升朝暾。",
        "三江水缩献洲渚，九顶秀色欲塞门。",
        "西山下竹十万个，江面便可驰车辕。",
        "巷无居人亦何怪，释耒来看空山村。",
        "竹枝宛转秋猿苦，桑落潋滟春泉浑。",
        "众賔共醉忘烛跋，一径却下缘云根。",
        "走沙人语若潮卷，争桥炬火如星繁。",
        "肩舆睡兀到东郭，空有醉墨留衫痕。",
        "十年万事俱变灭，点检自觉惟身存。",
        "寒灯夜永照耿耿，卧赋长句招羁魂。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 33049,
      "title": "闻王嘉叟讣报有作",
      "content": [
        "呜呼嘉叟今信死，哭君寝门泪如水。",
        "我初入都不妄交，倾倒如君数人耳。",
        "笼灯蹋雪夜相过，剧论悬河骇邻里。",
        "地炉燔栗美刍豢，石鼎烹茶当醪醴。",
        "上书去国何勇决，作诗送君犹壮伟。",
        "十年偶复过都门，君方草制西垣里。",
        "鬓须班白面骨生，心颇疑君遽如此。",
        "西来例不候达官，每欲寄声中辄止。",
        "只鸡絮酒纵有时，双鱼素书长已矣。",
        "生前客屦纷满户，身后人情薄于纸。",
        "悬知海内莆阳公，独念遗孤为经纪。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 33050,
      "title": "出城至吕公亭按视修堤",
      "content": [
        "翠霭横山澹日升，孤亭聊借曲栏凭。",
        "霜威渐重江初缩，农事方休役可兴。",
        "重阜护城高歴歴，千夫在野筑登登。",
        "寓公仅踵前人迹，伐石西山恨未能。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 33051,
      "title": "登楼",
      "content": [
        "从来好境遍人间，无奈劳生自欠闲。",
        "江近时时吹白雨，楼高面面看青山。",
        "歌声哀怨传三峡，行色凄凉带百蛮。",
        "流落爱君心未已，梦魂犹缀紫宸班。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 33052,
      "title": "醉中作四首  其一",
      "content": [
        "晚途豪气未低摧，一饮犹能三百杯。",
        "烂烂目光方似电，齁齁鼻息忽如雷。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 33053,
      "title": "醉中作四首  其二",
      "content": [
        "驾鹤孤飞万里风，偶然来憩大峨东。",
        "持杯露坐无人会，要看青天入酒中。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 33054,
      "title": "醉中作四首  其三",
      "content": [
        "曾赐琳腴白玉京，狂歌起舞蜀人惊。",
        "却骑黄鹤横空去，今夕垂虹醉月明。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 33055,
      "title": "醉中作四首  其四",
      "content": [
        "画角三终夜未阑，醉凭飞阁喜天宽。",
        "月明满地江风急，吹落幽人紫绮冠。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 33056,
      "title": "观大散关图有感",
      "content": [
        "上马击狂夫，下马草军书。",
        "二十抱此志，五十犹癯儒。",
        "大散陈仓间，山川郁盘纡。",
        "劲气钟义士，可与共壮图。",
        "坡陀咸阳城，秦汉之故都。",
        "王气浮夕霭，宫室生春芜。",
        "安得从王师，汛扫迎皇舆。",
        "黄河与函谷，四海通舟车。",
        "士马发燕赵，布帛来青徐。",
        "先当营七庙，次第画九衢。",
        "偏师缚可汗，倾都观受俘。",
        "上寿大安宫，复如正观初。",
        "丈夫毕此愿，死与蝼螘殊。",
        "志大浩无期，醉胆空满躯。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
