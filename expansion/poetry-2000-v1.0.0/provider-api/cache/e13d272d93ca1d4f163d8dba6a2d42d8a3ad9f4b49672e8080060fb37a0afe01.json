{
  "data": [
    {
      "id": 215841,
      "title": "与潘仲达二首  其一",
      "content": [
        "东风沛甘雨，百物一时好。",
        "江南桃李尽，红紫到百草。",
        "道傍负担子，寒食归祭祷。",
        "念我淮上丘，三年不躬扫。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 215842,
      "title": "与潘仲达二首  其二",
      "content": [
        "淮阳牡丹花，盛不数京洛。",
        "姚黄一枝开，众艳气如削。",
        "亭亭风尘表，独立朝万萼。",
        "谁知临老眼，更复美葵藿。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 215843,
      "title": "莎鸡",
      "content": [
        "金风透残伏，玉树先秋凉。",
        "喓喓草间虫，感时振衣裳。",
        "楚客思万里，夜吟怨藜床。",
        "劳劳终夕语，共此簷月光。",
        "孤轮曳独茧，折管韵哀伤。",
        "辛苦豳父兄，无衣畏风霜。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 215844,
      "title": "宦游",
      "content": [
        "宦游吾漫尔，未慕致身早。",
        "秋来忆山苦，遥夜梦颠倒。",
        "鸣虫待谁听，落叶烦我扫。",
        "谁得省劳人，吾生常草草。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 215845,
      "title": "次韵秦觏",
      "content": [
        "琬琰非世珍，昔以羊皮换。",
        "嗟君复何求，众弃乃所玩。",
        "十年少游兄，闭口受客难。",
        "二毛才一第，俗子犹愤惋。",
        "人间异巧拙，善琢贵颜汗。",
        "婵娟守重闺，倚市争倩盼。",
        "君胡宝滞货，屡辱访衰懦。",
        "譬犹卧仆涂，更侑觥与散。",
        "球然瑚琏质，磨琢争璀璨。",
        "迟君三年鸣，更用惊我慢。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 215846,
      "title": "阿几",
      "content": [
        "小儿名阿几，眉目颇疏明。",
        "日来书案傍，学我读书声。",
        "男儿事业多，何必学读书。",
        "自古奇男子，往往羞为儒。",
        "阿几笑谓爷，薄云无密雨。",
        "看爷饥寒姿，儿岂合贵富。",
        "翁家破箧中，惟有书与史。",
        "教儿不读书，更欲作何事。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 215847,
      "title": "宿虹县驿",
      "content": [
        "长隄隘舟车，上下无暂歇。",
        "煎熬古驿门，聒聒争琐屑。",
        "东南淮浙富，输餽日填咽。",
        "楚风习喧卑，吴舌动嘲哳。",
        "平生耽静意，投闹剧含哕。",
        "况兹道路勤，强食慰饥渴。",
        "年来嵩洛兴，久与泉石结。",
        "终当卜吾庐，云山对华发。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 215848,
      "title": "有感三首  其一",
      "content": [
        "一春苦多风，桃李见无几。",
        "良游时已失，忽忽三月尾。",
        "中间亦何有，徒自乱心耳。",
        "所嗟违所娱，坐费良日晷。",
        "堂北千叶桃，微本混榛枳。",
        "居然未之省，一日灿相视。",
        "零丁不忍摘，攀玩聊自慰。",
        "乃知物虽微，未易即疏弃。",
        "从今至零落，犹足伴尊胾。",
        "仍烦芊绵草，藉我花前醉。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 215849,
      "title": "有感三首  其二",
      "content": [
        "昨日鸦作巢，今者鸦哺儿。",
        "念知三月阑，春物行已稀。",
        "晚风飒不收，残红怨余姿。",
        "回风起轻寒，拥炉火重吹。",
        "灯明夜斋静，目涩临书迟。",
        "病齿不饮酒，持杯劝妻儿。",
        "岂无儿女心，惆怅桃李蹊。",
        "彼昏安目前，丈夫方有思。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 215850,
      "title": "有感三首  其三",
      "content": [
        "古今不殊途，掩卷独长想。",
        "炎炉与死灰，相去如反掌。",
        "彼昏诚不知，一醉富莫量。",
        "那知道旁殍，曾是厌杯盎。",
        "一金短贩儿，岂暇议得丧。",
        "但怜反复间，观者为惆怅。",
        "圣贤蹈大方，不苟目前妄。",
        "寄身爱憎间，得失真一饷。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 215851,
      "title": "食菜",
      "content": [
        "大雨困淋漓，小雨伤霡霂。",
        "哀哉南亩人，日夜涂手足。",
        "入仓无一粒，敢望祈报福。",
        "余功归老圃，畦菜青满目。",
        "长官却野馈，性命赦鸡鹜。",
        "何须问清白，荐德刍一束。",
        "归来辍食叹，每悔釜炊玉。",
        "青衫尚如此，何况膏粱腹。",
        "愿君少自宽，谋远须食肉。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 215852,
      "title": "王子开朝散早年以疾病谢事还江阴求诗为别三首  其一",
      "content": [
        "济物昔所务，舍耕还自非。",
        "骎骎老将至，忽忽意多违。",
        "门有王夫子，柴车谢事归。",
        "令人三叹息，羞涩向尘衣。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 215853,
      "title": "王子开朝散早年以疾病谢事还江阴求诗为别三首  其二",
      "content": [
        "田园何日到，水国洗秋寒。",
        "兴来出饮酒，兴罢归杜门。",
        "漫郎游已倦，老眼乱丹铅。",
        "扁舟肯载我，共看雪涛翻。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 215854,
      "title": "王子开朝散早年以疾病谢事还江阴求诗为别三首  其三",
      "content": [
        "避禄免危疾，弃铅得黄金。",
        "须眉蔼如漆，便觉老难侵。",
        "江湖足幽遯，市卒或可寻。",
        "莫思芙蓉子，丹田乱君心。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 215855,
      "title": "暮春奉女兄弟集宴堂",
      "content": [
        "晨晖丽花柳，流水滟池塘。",
        "暮春渐暄燠，华构肃朝凉。",
        "使君簿领暇，亦复陈壶觞。",
        "班坐岂异人，骨肉皆欢康。",
        "遥山出远翠，远水明斜阳。",
        "欢言不期醉，淡泊味何长。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 215856,
      "title": "窥园",
      "content": [
        "吾老懒读书，得闲尝窥园。",
        "爱此千树雪，高低不胜繁。",
        "冲风掠之去，颇已随沙尘。",
        "感之可奈何，我岂土木人。",
        "畏病不饮酒，已惭嵇阮真。",
        "淡泊非众嗜，自娱难及宾。",
        "独游还独吟，鱼鸟与我亲。",
        "悠哉山林趣，媿此簪缨身。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 215857,
      "title": "马巨济董役魏王坟作诗寄之",
      "content": [
        "城北牛脾山，千丘压其麓。",
        "事皆有司办，圣世数厚族。",
        "园林迫复土，百役兴甚速。",
        "烦我别驾公，侵星次空谷。",
        "邮亭旧客去，闲日睡颇足。",
        "闻莺有佳兴，徙倚近乔木。",
        "樱笋味鼎来，管弦调渐熟。",
        "期归酌烧酒，及此未炎燠。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 215858,
      "title": "出伏后风雨顿凉有感三首  其一",
      "content": [
        "秋风振秋晓，万境一凄清。",
        "幽草虫响息，高叶露华凝。",
        "戢翼乌尚宿，引吭鸡屡鸣。",
        "淹留度华岁，怅然难为情。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 215859,
      "title": "出伏后风雨顿凉有感三首  其二",
      "content": [
        "三伏如汤釜，熏煮理亦足。",
        "西风半夜雨，窗户一清肃。",
        "那能惜摇落，共喜过炎燠。",
        "老人亦晨起，稍进杯中醁。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 215860,
      "title": "出伏后风雨顿凉有感三首  其三",
      "content": [
        "残暑扇中尽，新凉枕上归。",
        "微云起平远，空碧上朝曦。",
        "稍感夏衣薄，渐伤高叶稀。",
        "来鸿飞集喜，卒岁稻粱肥。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 215861,
      "title": "太宁庭柏",
      "content": [
        "微风起清籁，烈日交翠阴。",
        "荫兹金仙居，楼殿鬰沈沈。",
        "永日燕雀下，有时钟梵音。",
        "谁能悟斯道，来此契无心。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 215862,
      "title": "暇日步西园感物辄为诗得七篇 酴醾",
      "content": [
        "欲知此园古，请视酴醾苍。",
        "孙枝已轮囷，走蔓龙蛇长。",
        "春风一吹嘘，灼灼发奇光。",
        "仙姝不可挹，顺风饮其香。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 215863,
      "title": "暇日步西园感物辄为诗得七篇 秋圃",
      "content": [
        "秋圃寂无有，萧条残菊枝。",
        "老蛩依日叫，暗蝶傍人飞。",
        "锁涩门开少，莎长人到稀。",
        "旧游浑记得，到处即如归。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 215864,
      "title": "暇日步西园感物辄为诗得七篇 菊丛",
      "content": [
        "下根盘秋泥，上叶披宿雨。",
        "惟余黄金蕊，秀色日夜吐。",
        "宁须荐九日，但惜岁云暮。",
        "吾将屑落英，持泛兰皋露。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 215865,
      "title": "暇日步西园感物辄为诗得七篇 芙蓉",
      "content": [
        "清霜厉严杀，松栢气不振。",
        "芙蓉乃微木，晓艳独娇春。",
        "秾粹觉兰疲，芬敷知菊贫。",
        "欲攀无所赠，聊复插吾巾。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 215866,
      "title": "暇日步西园感物辄为诗得七篇 橘",
      "content": [
        "奇林蕴贞粹，健叶圆青鲜。",
        "中有碧瑶实，正味百果先。",
        "贡包登尧俎，颂德列骚篇。",
        "李衡空庸材，徒列木奴千。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 215867,
      "title": "暇日步西园感物辄为诗得七篇 斑竹",
      "content": [
        "重瞳陟方时，二妃盖老人。",
        "安肯泣路傍，洒泪留丛筠。",
        "颇疑葛陂化，点点留斑鳞。",
        "慎勿脱水去，入世多埃尘。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 215868,
      "title": "暇日步西园感物辄为诗得七篇 种蔬",
      "content": [
        "贫舍无旨蓄，种圃治寒蔬。",
        "纵横数席间，灌溉亦勤劬。",
        "积雨有新甲，时摘付中厨。",
        "何劳樊迟学，当问汉阴夫。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 215869,
      "title": "所居堂后北篱下获二蛇一小色赤长二尺许一大色黑长七尺围四五寸尾可贯百钱尽放之",
      "content": [
        "二物穴我居，岁月亦已老。",
        "一朝双擒获，蜿蜿出幽草。",
        "安行免噬啮，敢望吐珠报。",
        "巳月不杀蛇，昔贤有遗告。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 215870,
      "title": "小雨效韦体",
      "content": [
        "午景蔽浮云，芳林散清雨。",
        "虚窗度遥吹，稍觉青叶举。",
        "残蔬知夏余，陨叶兆秋序。",
        "幽独无往来，烹茶谁晤语。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 215871,
      "title": "纳凉",
      "content": [
        "靡靡春事退，寂寂夏日长。",
        "日西骑马归，卧此北户凉。",
        "官事幸休逸，甘为白头郎。",
        "朝出暮还家，悠悠愧路旁。",
        "所欣药物灵，颇觉疾病康。",
        "幸免三已愠，敢希五馈浆。",
        "难堪七有余，不过三已尝。",
        "呼儿且粝食，贫固士之常。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 215872,
      "title": "三伏暑甚七月八日立秋是日风作凉爽炎酷顿消老病欣然命酒成二诗  其一",
      "content": [
        "西风吹淡白，窗户含凄清。",
        "炎凉一朝变，徂暑逝不停。",
        "山堂晓潇洒，病叟巾褐轻。",
        "平时干云树，芳叶亦复零。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 215873,
      "title": "三伏暑甚七月八日立秋是日风作凉爽炎酷顿消老病欣然命酒成二诗  其二",
      "content": [
        "苦热逢三秋，西风飒然起。",
        "金气入草木，伤夷从此始。",
        "盛极衰从之，循环固其理。",
        "老翁复何事，新凉欣酒美。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 215874,
      "title": "白乐天有渭上雨中独乐十余首倣渊明予寓宛丘居多暇日时屡秋雨倣白之作得三章  其一",
      "content": [
        "寒极则有暑，晦久则有明。",
        "开辟迄今兹，此理信可凭。",
        "炎炎者易灭，巍巍者必倾。",
        "圣智无奈何，况此愚昏氓。",
        "设罗以猎兽，切骨陷其膺。",
        "重势以镇物，悬绝压其肱。",
        "纵使贲与育，力有不获呈。",
        "物情千万变，可尽得经营。",
        "不如寂寞士，葛带而兰缨。",
        "无求复无忧，容貌甚和平。",
        "况兹积雨余，秋气日姿清。",
        "悠然有佳兴，美酒时一倾。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 215875,
      "title": "白乐天有渭上雨中独乐十余首倣渊明予寓宛丘居多暇日时屡秋雨倣白之作得三章  其二",
      "content": [
        "罢官卧穷巷，值此云物稠。",
        "连延经旬雨，城市欲行舟。",
        "柱础变坳塘，瓦沟成暴流。",
        "萧然残暑退，寒事戒衣裘。",
        "老人朝睡足，起坐梳白头。",
        "呼童饬晨餐，薪湿爨妇愁。",
        "洗我朱提杯，不复具肴羞。",
        "一觞已径醉，万事良悠悠。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 215876,
      "title": "白乐天有渭上雨中独乐十余首倣渊明予寓宛丘居多暇日时屡秋雨倣白之作得三章  其三",
      "content": [
        "故人遗我酒，气味芳以清。",
        "置之屋壁间，兴至时一倾。",
        "银杯度一合，三釂已彻觥。",
        "既免戒沉湎，且无忧病酲。",
        "嵇阮愧令德，刘石无遐龄。",
        "荒狂有何乐，徒以酒自名。",
        "吾幸免困此，庶几尽平生。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 215877,
      "title": "古意三首  其一",
      "content": [
        "园中杨柳树，飞舞似含羞。",
        "如何风静处，尽放眼中愁。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 215878,
      "title": "古意三首  其二",
      "content": [
        "金铺银屈膝，动处有人挨。",
        "棋盘作十字，中心为子来。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 215879,
      "title": "古意三首  其三",
      "content": [
        "橘犀如半月，何日是圆时。",
        "如何一种味，却有两人知。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 215880,
      "title": "权势",
      "content": [
        "权势世所重，桓温役孟嘉。",
        "桓公自人雄，为下未足嗟。",
        "颇怪蔡中郎，为董受疵瑕。",
        "因之以取死，曾不念汉家。",
        "士固感知己，尚安知其他。",
        "搜牢则可诛，好邕自其佳。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 215881,
      "title": "临文",
      "content": [
        "一病废百嗜，好文心未忘。",
        "南窗纳虚明，罗列陈缣缃。",
        "茫昧考巢燧，典章断虞唐。",
        "清妍进屈景，隽永旌苏张。",
        "少狂不自料，遇事形文章。",
        "误逢作者叹，因复力披攘。",
        "蹉跎生白发，始䌷石室藏。",
        "粗见汉家事，濡毫时否臧。",
        "文词比工祝，不殊公卿行。",
        "何用疲心精，舍本弃耕桑。",
        "读赋意凌云，律令尊张汤。",
        "荣华系遇合，才技无短长。",
        "颇师老氏术，抱璞和其光。",
        "无营以卒岁，刻意翰墨场。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 215882,
      "title": "自淮阴被命守宣城复过楚雨中遇道孚因同诵楚词为书此以足楚词",
      "content": [
        "秋庭新过雨，佳菊独秀先。",
        "含芳良未展，风气已清妍。",
        "金凤汝婢妾，红紫徒相鲜。",
        "老人对节物，昏昏祇欲眠。",
        "与子读楚词，亹亹忽尽编。",
        "袅袅兮秋风，憀栗在远行。",
        "蟋蟀鸣西堂，淹留了无成。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 215883,
      "title": "寓陈杂诗十首  其一",
      "content": [
        "传舍不可久，束装投新居。",
        "新居亦苟完，佳木颇扶疏。",
        "洒扫寻丈地，琴书遣朝晡。",
        "风云中夜变，大雨如决渠。",
        "落点若强箭，穿我老屋涂。",
        "中夜起明烛，移床护吾雏。",
        "传闻北城隅，老弱堤上庐。",
        "官吏操畚锸，纷纷役千夫。",
        "螘漏或一决，城闉变江湖。",
        "吾衰也久矣，岂复惮为鱼。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 215884,
      "title": "寓陈杂诗十首  其二",
      "content": [
        "昔记古甲子，商灭而周兴。",
        "如何雨此日，乃为霪雨征。",
        "阴阳久乖张，此事颇有凭。",
        "岂天悔牧野，洗此漂杵腥。",
        "旧雨水未干，洞房苔欲青。",
        "新雨虽霡霡，欺我墙善崩。",
        "虚堂就夕眠，永夜楸桐声。",
        "萧然秋气至，岂觉巾屦轻。",
        "怜我老病者，三伏困薰蒸。",
        "得凉且饱饭，何暇念秋成。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 215885,
      "title": "寓陈杂诗十首  其三",
      "content": [
        "朝雨如棼丝，咫尺不相辨。",
        "俄然晨光漏，绀碧出天面。",
        "天工易明晦，顷刻俄屡变。",
        "今朝事大定，云物卷组练。",
        "客有北来说，蝝生被数县。",
        "谷穗无一粒，遗秆如立箭。",
        "卑田成大泽，投种哀莫见。",
        "官人懵不知，犹喜输租办。",
        "兴怀及鳏寡，犹愧吾饱饭。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 215886,
      "title": "寓陈杂诗十首  其四",
      "content": [
        "唐有元相国，实杀颜平原。",
        "平原腹有丹，尸解神已仙。",
        "颜公死已矣，人见如生前。",
        "致令遗其像，委曲与人言。",
        "相国死仓卒，秽袜塞其咽。",
        "家门随手破，但怪椒斛千。",
        "颜公黄尘外，风节犹凛然。",
        "元子堕九幽，遗臭万世传。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 215887,
      "title": "寓陈杂诗十首  其五",
      "content": [
        "清夜何晏晏，客眠亦复佳。",
        "邻钟唤我觉，咽咽闻城笳。",
        "披衣行中庭，星汉已横斜。",
        "缺月挂西南，皎皎流清华。",
        "莎鸡振其羽，蟋蟀旁悲嗟。",
        "悠哉岁已秋，日月如奔车。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 215888,
      "title": "寓陈杂诗十首  其六",
      "content": [
        "开门无客来，永日不冠履。",
        "客至我老懒，投刺辄复去。",
        "端成两相忘，因得百无虑。",
        "故人在旁郡，书信不能屡。",
        "兴哀东城公，将掩郏山墓。",
        "不能往一恸，名义真有负。",
        "可能金玉骨，亦遂黄壤腐。",
        "但恐已神仙，裂石终飞去。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 215889,
      "title": "寓陈杂诗十首  其七",
      "content": [
        "疲马龁故草，闭门苔藓深。",
        "闲坊居人少，秋日疏槐阴。",
        "境寂心亦闲，萧然散巾襟。",
        "静中有深趣，因见至人心。",
        "谷神古不死，兹理良可寻。",
        "无令儿辈觉，一抚无弦琴。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 215890,
      "title": "寓陈杂诗十首  其八",
      "content": [
        "念昔为吏日，朝夕羡人闲。",
        "解印出公府，翛然若归山。",
        "衡茅三亩居，无客门常关。",
        "早眠而起晏，永日或不冠。",
        "故人远寄酒，为致一醉欢。",
        "我亦领其意，呼儿具杯盘。",
        "长闲贫亦好，安用朱其轓。",
        "我生本蓬荜，久已傲饥寒。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 215891,
      "title": "寓陈杂诗十首  其九",
      "content": [
        "我不知暑退，但觉衣汗干。",
        "颇怪庭中天，湛然青已宽。",
        "有物叫草根，啾啾自相喧。",
        "问知已新秋，大火流金天。",
        "九土变寒暑，正尔事亦繁。",
        "静观付一笑，吾事宁相关。",
        "但无筋力健，悠然佳意还。",
        "喧喧憎邻里，砧杵乱人眠。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 215892,
      "title": "寓陈杂诗十首  其一○",
      "content": [
        "秦子死南海，旋骨还故墟。",
        "辛勤一生事，空得数编书。",
        "琅琅巧言语，玉佩联琼琚。",
        "知者能几人，憎者颇有余。",
        "书生事业薄，生世苦勤劬。",
        "持以待后世，何足润槁枯。",
        "兴怀及昔者，使我涕涟如。",
        "道路阻且长，悲哉违抚孤。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 215893,
      "title": "寄李端叔二首  其一",
      "content": [
        "束发闻至道，荣辱久齐观。",
        "中年婴世故，已复傲忧患。",
        "闲居虽荒寂，几杖颇清晏。",
        "悠悠闲晷景，草草贫寝饭。",
        "狂言无为发，浊酒醉自劝。",
        "与君通家旧，迩者颇屡见。",
        "相望岂示远，数舍隔异县。",
        "吾人师佛祖，妙旨得忍粲。",
        "敛藏避世俗，未免逢侮讪。",
        "坐令鬓垂雪，犹把从事版。",
        "尺书每见警，妙语珠在贯。",
        "复君进明德，同遂丘壑愿。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 215894,
      "title": "寄李端叔二首  其二",
      "content": [
        "陈墟自古皇，疆野实楚县。",
        "沃野接神畿，荒沟漕淮甸。",
        "民风静而陋，原隰平以远。",
        "我来逢艰岁，禾黍秋色浅。",
        "荒居困蛩蚓，风雨老藜苋。",
        "闭门谢车马，隠几亲笔砚。",
        "马迹巷泥深，庖烟簷日宴。",
        "深居窥老易，妙理殊自玩。",
        "困亨方寸足，夸安劳远愿。",
        "乖离感岁月，老色各满面。",
        "友道古所敦，尺书莫辞倦。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 215895,
      "title": "秋日晒古城",
      "content": [
        "秋日晒古城，西风振尘埃。",
        "出门何所之，坏道连蒿莱。",
        "飞鸣鸡犬稀，破屋枯壕隈。",
        "老圃理蔬畦，晚甲瘦未开。",
        "输人暮出城，栖鸦一一回。",
        "怅然心不怡，归坐劝一杯。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 215896,
      "title": "古意效东野二首  其一",
      "content": [
        "与君虽异坊，秋凉各平分。",
        "已遣月入牖，更教风扫门。",
        "照君幌中寝，拂君堂上尘。",
        "绸缪似衣带，终日遶君身。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 215897,
      "title": "古意效东野二首  其二",
      "content": [
        "扇不风自凉，身不兰自香。",
        "深居不出门，幽独更清扬。",
        "为鹊栖君树，为燕巢君堂。",
        "不食亦可饱，况乃餐辉光。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 215898,
      "title": "早稻",
      "content": [
        "早稻如倒戈，十穗八九折。",
        "晚稻不及秀，日炙根土烈。",
        "踏车激湖水，车众湖欲竭。",
        "得泉如沸汤，旱土湿未彻。",
        "老农祝天工，叩额眼垂血。",
        "游云不作雨，风至辄散灭。",
        "昊天未悔祸，牲玉无徒设。",
        "谁能缚妖魃，敕起龙泼剌。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 215899,
      "title": "鸣蜩",
      "content": [
        "鸣蜩嘒高风，逮夜且复静。",
        "草虫何为者，落日鸣复逞。",
        "阴阳且战争，微物何所竞。",
        "化工执其机，开阖惟所命。",
        "朔雁有行意，肃肃如待令。",
        "江河有旧渚，宁畏风霜劲。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 215900,
      "title": "书初凉夜至将晓",
      "content": [
        "秋房灯火清，人语久已寂。",
        "城远不闻更，警柝鸣未息。",
        "横参已入地，斗柄当天直。",
        "乃知三更中，市廛已寂历。",
        "我时守书几，磨墨倾砚滴。",
        "反复小学书，昏目如芒刺。",
        "试寻邻房僧，鼻鼾背负壁。",
        "体劳径就枕，冷梦分南北。",
        "觉来寺钟鸣，僧礼像前席。",
        "须臾闻梵呗，木鱼如叩石。",
        "举头视东牖，朝日已淡白。",
        "反身起披衣，神爽健筋力。",
        "亟来酒瓮边，侧听声唧唧。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 215901,
      "title": "秋日喜杨介吉老寄药",
      "content": [
        "闲坊远市声，终日掩衡门。",
        "惟有风中叶，萧骚终日闻。",
        "午枕不成寐，起坐无与言。",
        "喜开故人书，珍药幸见存。",
        "其方受仙圣，其效未易论。",
        "岂惟蠲沉疴，庶可辅本根。",
        "珍重复珍重，厥价万玙璠。",
        "永年未可冀，庶保无夭昏。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 215902,
      "title": "见黄仲达感秋意",
      "content": [
        "秋风吹衡茅，寂历如荒村。",
        "独立无与语，悲虫鸣草根。",
        "老木经疾风，枝叶仅得存。",
        "疏荫不满地，白日耿当轩。",
        "北城有黄仲，眸子清不浑。",
        "时能出秀句，宝铁雕玙璠。",
        "念将舍我去，为吏国西京。",
        "荒凉古中牟，昼夜轮蹄奔。",
        "青衫给吏役，怀恶未易论。",
        "强颜诡应接，有抱谁能言。",
        "从容来去间，无厌走黄昏。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 215903,
      "title": "服仙灵脾酒",
      "content": [
        "冷气侵吾髀，趋拜剧苦艰。",
        "仁哉神农氏，遗药驱恫瘝。",
        "持钱取之市，易得如茆芫。",
        "繁枝与芳叶，尽取无可删。",
        "贮之白缣囊，渍以壶酒宽。",
        "七日以供饮，跛曳皆翩跹。",
        "呼儿谨盖藏，用此九转丹。",
        "平生误信书，安坐得老邅。",
        "方书岂尽信，柳子固无言。",
        "事固有然者，岂容尽欺谩。",
        "疾走非吾愿，且复补羸残。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 215904,
      "title": "孙志康许为南酿前日已闻籴米欣然作诗以问之",
      "content": [
        "平生一尊酒，风月不可无。",
        "谪官将十年，一醉未易图。",
        "市岂无旗亭，官亦有酒垆。",
        "薄乃捩齿酸，一滴不可沽。",
        "英英孙夫子，臭味真吾徒。",
        "自云得异糵，乃出粳稻腴。",
        "岁久精粹出，去者乃其粗。",
        "酝酿才浃日，芳甘已盈壶。",
        "伧人喻其力，若火经茅芦。",
        "此语真野陋，殆出负贩夫。",
        "前日闻吉语，籴米已在途。",
        "每恨乏陈糯，价直如买珠。",
        "怜君久客囊，倾倒无复余。",
        "假器走仆僮，供我一笑娱。",
        "欲为漉巾潜，请学涤器如。",
        "作诗以讯之，何日陈尊盂。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 215905,
      "title": "夜书",
      "content": [
        "黯黯夜烟青，寥寥秋汉迥。",
        "海月出天高，霜云泊天静。",
        "鹤鸣知露寒，树影当轩正。",
        "幽客独未眠，经窗夜声磬。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 215906,
      "title": "小雨",
      "content": [
        "稍稍阴霭集，萧肃春寒生。",
        "窗灯耿初照，小雨细无声。",
        "还来就温炉，依然有故情。",
        "燕坐悄无语，军城递远更。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 215907,
      "title": "月夜怀陈永源",
      "content": [
        "众喧息遥夜，爽气渍烦襟。",
        "殷勤低簷月，入幌来相寻。",
        "平生学虚静，每为多病侵。",
        "卧想陈夫子，幅巾修竹林。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 215908,
      "title": "冬日放言二十一首  其一",
      "content": [
        "清冬万境肃，墙户益萧然。",
        "薄寒惟可饮，短景不容眠。",
        "贫厨烟火暖，尘釜亦烹鲜。",
        "且复养口体，何劳更问天。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 215909,
      "title": "冬日放言二十一首  其二",
      "content": [
        "汤餠慰朝馁，三杯浇旦寒。",
        "醉饱外何欲，昏然宵就眠。",
        "幽通梦有告，默存神自全。",
        "萧萧松竹舍，岁暮聊盘桓。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 215910,
      "title": "冬日放言二十一首  其三",
      "content": [
        "风雨连江气，十月如深冬。",
        "坐曹日暮归，密室温炉红。",
        "惨惨庭下日，骚骚窗外风。",
        "三杯容我醉，万事听天工。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 215911,
      "title": "冬日放言二十一首  其四",
      "content": [
        "小儿喜学书，满纸如涂鸦。",
        "老妇寒不绩，当户理琵琶。",
        "樽中有神物，快泻如流霞。",
        "三杯任兀兀，冻脸生春华。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 215912,
      "title": "冬日放言二十一首  其五",
      "content": [
        "卯饮终日醉，万事付悠悠。",
        "醺然据榻瞑，簷雨方飕飕。",
        "吾事幸无急，不醉欲何求。",
        "顾谓妇与子，酒尽为我谋。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 215913,
      "title": "冬日放言二十一首  其六",
      "content": [
        "寒羊肉如膏，江鱼如切玉。",
        "肥兔与奔鹑，日夕悬庖屋。",
        "嬉嬉顾妻孥，滋味喉可欲。",
        "谪官但强名，比者何不足。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 215914,
      "title": "冬日放言二十一首  其七",
      "content": [
        "酒圣卯时欢，此语闻乐天。",
        "安用苦了了，白日供忧煎。",
        "浮世本幻妄，空花电露然。",
        "人间无实事，惟醉庶几焉。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 215915,
      "title": "冬日放言二十一首  其八",
      "content": [
        "愈老愈嗜酒，益醉益自然。",
        "两人同坠车，醉者乃得全。",
        "我不但醉酒，天和醉心源。",
        "当其醉甚时，更类痴与顽。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 215916,
      "title": "冬日放言二十一首  其九",
      "content": [
        "至道与物反，夫岂会俗心。",
        "圣处有阃域，扃钥一何深。",
        "时时资美酒，可得及其门。",
        "送君者既返，君驾胡可寻。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 215917,
      "title": "冬日放言二十一首  其一○",
      "content": [
        "清晨坐官舍，官舍复何有。",
        "离披经雨菊，萧疏委风柳。",
        "饱食或至睡，涉笔无可否。",
        "油然有好怀，日暮归饮酒。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 215918,
      "title": "冬日放言二十一首  其一一",
      "content": [
        "日暮归饮酒，儿女戏我前。",
        "须臾径三酌，据榻已欣然。",
        "老妻坐我傍，肴胾已炮煎。",
        "大胜刘伶妇，区区为酒钱。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 215919,
      "title": "冬日放言二十一首  其一二",
      "content": [
        "我初谪官时，帝问司酒神。",
        "曰此好酒徒，聊给酒养真。",
        "去国一千里，齐安酒最醇。",
        "失火而遇雨，仰戴天公仁。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 215920,
      "title": "冬日放言二十一首  其一三",
      "content": [
        "吾腹如鸱夷，但满贮醇酒。",
        "外圆故不滞，中静一无有。",
        "纷纷千百辈，纳若一尘垢。",
        "下而至真源，保之故难朽。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 215921,
      "title": "冬日放言二十一首  其一四",
      "content": [
        "淮阳名都会，爽垲太昊墟。",
        "最爱西城道，汪汪数顷湖。",
        "古木巢翠鸟，清濠见游鱼。",
        "幽居多不惬，怀我平生娱。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 215922,
      "title": "冬日放言二十一首  其一五",
      "content": [
        "灵通古丛林，他日休吾车。",
        "出门循古城，荒圃畦寒蔬。",
        "手种堂下花，颇已数尺余。",
        "何人揽其华，故人应念予。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 215923,
      "title": "冬日放言二十一首  其一六",
      "content": [
        "塞向久室处，帟幕亦复周。",
        "温炉炽薪炭，永夜炎光流。",
        "五更屋霜重，重衾如无裘。",
        "兴怀无衣子，卒岁聊优游。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 215924,
      "title": "冬日放言二十一首  其一七",
      "content": [
        "陶潜经世才，龃龉不得肆。",
        "彼宁徒嗜饮，有蕴托诸醉。",
        "时时吐高词，颇复见一二。",
        "义熙书甲子，此意有泾渭。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 215925,
      "title": "冬日放言二十一首  其一八",
      "content": [
        "葛公盖世才，功业亦云偶。",
        "世无左将军，老作躬耕叟。",
        "皇天挺奇产，必使有所受。",
        "珠玉在山渊，终为王府有。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 215926,
      "title": "冬日放言二十一首  其一九",
      "content": [
        "秦人焚诗书，意欲遂绝灭。",
        "六经至今存，何曾损毫发。",
        "兴衰有天理，人力自浅拙。",
        "不忧骊山墓，回首遭发掘。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 215927,
      "title": "冬日放言二十一首  其二○",
      "content": [
        "元子本豪爽，颇复有俗气。",
        "孟嘉亦可人，乃与较权势。",
        "崛强尽百年，究竟成何事。",
        "江左无英雄，汝得免徒隶。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 215928,
      "title": "冬日放言二十一首  其二一",
      "content": [
        "渊明非无心，似以酒忘忧。",
        "如以药愈疾，未佳宁免忧。",
        "我直好饮耳，与世本悠悠。",
        "人间有何事，奚足烦杯瓯。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 215929,
      "title": "四月望日自孝悌坊迁冠盖孙氏第",
      "content": [
        "青芜满古城，白日照大泽。",
        "街荒鸡犬闹，市远喧閧寂。",
        "中有腾腾者，淮阳四年客。",
        "坐偷太仓粟，稳睡而饱食。",
        "平生愿陈力，衰老困逼迫。",
        "何曾一可意，但有百无益。",
        "偷安浅夫志，苟且志士惜。",
        "穷通有天理，誓不安苟得。",
        "朱阳方肇序，春去无辙迹。",
        "怅此复几时，抚事三叹息。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 215930,
      "title": "谪官",
      "content": [
        "谪官成吏隠，古寺度高秋。",
        "寒灯明夜室，清坐闻更筹。",
        "裘葛屡往还，感彼岁月遒。",
        "吾意方有会，谁能赋离忧。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 215931,
      "title": "十月二十二日晚作三首  其一",
      "content": [
        "黯黯东牖暗，寂寂吾庐闲。",
        "粗粝饱妇子，苜蓿无余盘。",
        "雁急天欲雨，鸡栖日已寒。",
        "老人袖手坐，一杯聊自宽。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 215932,
      "title": "十月二十二日晚作三首  其二",
      "content": [
        "天寒聊饮酒，再酌已停觞。",
        "岂不欲酣畅，要使夜腹康。",
        "意得乐有余，偶然不必长。",
        "寄身造化中，勿使天和伤。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 215933,
      "title": "十月二十二日晚作三首  其三",
      "content": [
        "蓬荜无奥处，北风利戈鋋。",
        "空炉有微火，且复与周旋。",
        "酒隠柴桑叟，醉吟渭上贤。",
        "二士忽已远，遗风载陈编。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 215934,
      "title": "题壁",
      "content": [
        "命驾欲诣客，欲去复迟迟。",
        "事幸无甚急，何用劳驱驰。",
        "家贫幸有酒，亦略具鲜肥。",
        "且复东窗下，高歌醉而嬉。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 215935,
      "title": "夜坐",
      "content": [
        "万籁声久寂，三更霜已寒。",
        "老人袖手坐，一气中自存。",
        "自得此中趣，不与儿曹论。",
        "但有老孟光，相对亦无言。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 215936,
      "title": "任仲微阅世亭",
      "content": [
        "志士抱奇策，常苦不得伸。",
        "及其利害出，倏已亡其人。",
        "今古同此恨，愚智竟谁分。",
        "哀哉老任公，英魄久已沦。",
        "惟余亭下柏，阅世盘深根。",
        "纷纷凡草木，几变秋与春。",
        "朝菌与蟪蛄，尽死我独存。",
        "任公不及见，见其贤子孙。",
        "请君利斯奇，仍复大其门。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 215937,
      "title": "感怀",
      "content": [
        "枯树桓司马，五柳陶征君。",
        "微木何足道，所叹此两人。",
        "一埋柴桑骨，一为九锡臣。",
        "荣辱俱已矣，芳秽万世闻。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 215938,
      "title": "次韵题李援舫子",
      "content": [
        "紫髯不复见，故宫无入门。",
        "元子亦寂寞，一丘吊遗魂。",
        "兴亡两梦幻，今古一朝昏。",
        "念当置是事，尽此舟中樽。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 215939,
      "title": "秋感二首  其一",
      "content": [
        "秋日无远晖，秋草无美姿。",
        "残蛩吊白日，寒鸟悲空枝。",
        "时节一如此，余出怅安归。",
        "强歌不成音，还坐空涕垂。",
        "感动百虑游，触心遂纷披。",
        "弃捐勿复道，日暮眠吾帷。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 215940,
      "title": "秋感二首  其二",
      "content": [
        "秋山多远声，日暮尤百态。",
        "鸣风落高树，清涧泻寒濑。",
        "鸣蜩默谁怜，瘖死不偿罪。",
        "蛩啼独不已，有愬未逢解。",
        "天时激汝曹，宁自知进退。",
        "吹嘘成踊跃，刍狗忌撤祭。",
        "庭空月宵挂，园冷露晨沛。",
        "嗟哉心虽忘，俯事还感慨。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    }
  ],
