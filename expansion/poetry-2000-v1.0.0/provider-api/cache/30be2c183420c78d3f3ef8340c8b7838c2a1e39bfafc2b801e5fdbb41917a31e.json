{
  "data": [
    {
      "id": 79422,
      "title": "喜定号和禹玉内翰",
      "content": [
        "衡鉴慙叨选，英豪此所钟。",
        "古今参雅郑，善恶杂臯共。",
        "挥翰飘飘思，怀奇落落胸。",
        "披文惊可畏，奏下始开封。",
        "但喜真才得，宁虞横议攻。",
        "欲知儒学盛，首善本三廱。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 79423,
      "title": "和出省",
      "content": [
        "僮奴补被莫相催，待报霜台御史来。",
        "晴陌便当联骑去，春风任放百花开。",
        "文章纸贵争驰誉，朝野人言庆得才。",
        "共向丹墀侍临选，莫惊鳞鬣化风雷。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 79424,
      "title": "送郑革先辈赐第南归",
      "content": [
        "少年乡誉叹才淹，六十犹随贡士函。",
        "握手亲朋惊白发，还爱闾里看青衫。",
        "阁涵空翠连衡阜，门枕寒江落楚帆。",
        "试问尘埃勤斗禄，何如琴酒老云岩。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 79425,
      "title": "和原父扬州六题 时会堂二首 其一",
      "content": [
        "积雪犹封蒙顶树，惊雷未发建溪春。",
        "中州地暖萌牙早，入贡宜先百物新。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 79426,
      "title": "和原父扬州六题 时会堂二首 其二",
      "content": [
        "忆昔尝修守臣职，先春自探两旗开。",
        "谁知白首来辞禁，得与金銮赐一杯。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 79427,
      "title": "自东门泛舟至竹西亭登昆丘入蒙谷戏题春贡亭",
      "content": [
        "昆丘蒙谷接新亭，画舸悠悠春水生。",
        "欲觅扬州使君处，但随风际管弦声。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 79428,
      "title": "竹西亭",
      "content": [
        "十里楼台歌吹繁，扬州无复似当年。",
        "古来兴废皆如此，徒使登临一慨然。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 79429,
      "title": "昆丘台",
      "content": [
        "访古高台半已倾，春郊谁从彩旗行。",
        "喜闻车马人同乐，惯听笙歌鸟不惊。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 79430,
      "title": "蒙谷",
      "content": [
        "一径崎岖入谷中，翠条红刺罥春丛。",
        "花深时有人相应，竹密初疑路不通。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 79431,
      "title": "内直奉寄圣俞博士",
      "content": [
        "千门钥入断人声，楼阁沉沉夜气生。",
        "独直偏知宫漏永，稍寒尤觉玉堂清。",
        "霜云映月鳞鳞色，风叶飞空摵摵鸣。",
        "犬马力疲恩未报，坐惊时节已峥嵘。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 79432,
      "title": "送梅龙图公仪和杭州",
      "content": [
        "万室东南且繁，羡君风力有余闲。",
        "渔樵人乐江湖外，谈笑诗成罇俎间。",
        "日暖梨花催美酒，天寒桂子落空山。",
        "邮筒不绝如飞翼，莫惜新篇屡往还。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 79433,
      "title": "送沈学士知常州",
      "content": [
        "旧馆芸香锁寂寥，斋舲东下入秋涛。",
        "江晴风暖旌旗飏，木落霜清鼓角高。",
        "吟就彩牋宾已醉，舞翻红袖饮方豪。",
        "平生粗得为州乐，因羡君行首重搔。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 79434,
      "title": "圣俞在南省监印进士试卷有兀然独坐之叹因思去岁同在礼闱慨然有感兼简子华景仁",
      "content": [
        "南宫官舍苦萧条，常忆群居接俊寮。",
        "古屋醉吟灯艳艳，画廓愁听雨萧萧。",
        "残春共约无虚掷，一岁那知忽复销。",
        "顾我心情又非昨，祗思相伴老渔樵。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 79435,
      "title": "奉答圣俞岁日书事",
      "content": [
        "积雪照清晨，东风冷著人。",
        "年光向老速，物意逐时新。",
        "贳酒闲邀客，披裘共探春。",
        "犹能自勉彊，顾我莫辞频。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 79436,
      "title": "夜闻春风有感奉寄同院子华紫微长文景仁",
      "content": [
        "闰后春深雪始锁，东风凌铄势方豪。",
        "阳生草木黄泉动，冰破江湖白浪高。",
        "未报国恩嗟病骨，可怜身事一渔舠。",
        "少年自与芳菲竞，莫笑衰翁拥弊袍。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 79437,
      "title": "病告中怀子华原父",
      "content": [
        "狂来有意与春争，老去心情渐不能。",
        "世味惟存诗淡泊，生涯半为病侵陵。",
        "花明晓日繁如锦，酒拨浮醅绿似渑。",
        "自是少年豪横过，而今痴钝若寒蝇。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 79438,
      "title": "春酬长文舍人出城见示之句",
      "content": [
        "春分腊雪未全销，凛冽春寒气尚骄。",
        "摄事初欣迎社燕，寻芳因得过溪桥。",
        "清浮酒蚁醅初拨，暖入鸎篁舌渐调。",
        "兴味爱君年尚少，莫嫌斋禁暂无憀。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 79439,
      "title": "唐崇徽公主手痕和韩内翰",
      "content": [
        "故乡飞鸟尚啁啾，何况悲笳出塞愁。",
        "青冢埋魂知不返，翠崖遗迹为谁留。",
        "玉颜自古为身累，肉食何人与国谋。",
        "行路至今空叹息，岩花涧草自春秋。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 79440,
      "title": "答和阁老刘舍人雨中见寄",
      "content": [
        "花间鸟语愁泥滑，屋上鸠鸣厌雨多。",
        "坐见残春一如此，可怜吾意已蹉跎。",
        "萧条两鬓霜后草，潋滟十分金卷荷。",
        "此物犹能慰衰老，稍晴相约屡相过。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 79441,
      "title": "寄阁老刘舍人",
      "content": [
        "梦寐江西未得归，谁怜萧飒鬓毛衰。",
        "莓苔生壁图书室，风雨闭门桃李时。",
        "得酒虽能陪笑语，老年其实厌追随。",
        "明朝雨止花应在，又踏春泥向凤池。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 79442,
      "title": "详定幕次呈同舍",
      "content": [
        "来时宫柳绿初匀，坐见红芳几番新。",
        "蜂蜜满房花结子，还家何处觅残春。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 79443,
      "title": "禁中见鞓红牡丹",
      "content": [
        "盛游西洛方年少，晚落南谯号醉翁。",
        "白首归来玉堂署，君王殿后见鞓红。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 79444,
      "title": "和江邻几学士桃花",
      "content": [
        "草上红多枝上稀，芳条绿萼忆来时。",
        "见桃著子始归后，谁道仙花开落迟。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 79445,
      "title": "送襄陵令李君",
      "content": [
        "绿发襄陵新长官，面颜虽老渥如丹。",
        "折腰聊为五斗屈，把酒犹能一笑欢。",
        "红枣林繁欣岁熟，紫檀皮软御春寒。",
        "民淳政简居多乐，无苦思归欲挂冠。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 79446,
      "title": "景灵宫致斋",
      "content": [
        "摄事衰年力不彊，谁怜岑寂卧斋坊。",
        "青苔点点无人迹，绿叶阴阴覆砌凉。",
        "玉宇清风来处远，仙家白日静中长。",
        "却视九衢车马客，自然颜鬓易苍苍。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 79447,
      "title": "夏享太庙摄事斋宫闻鸎寄原甫",
      "content": [
        "四月田家麦穗稠，桑枝生椹鸟啁啾。",
        "凤城绿树知多少，何处飞来黄栗留。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 79448,
      "title": "送王平甫下第",
      "content": [
        "归袂摇摇心浩然，晓船鸣鼓转风滩。",
        "朝廷失士有司耻，贫贱不忧君子难。",
        "执手聊须为醉别，还家何以慰亲懽。",
        "自慙知子不能荐，白首胡为侍从官。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 79449,
      "title": "对雪十韵",
      "content": [
        "对雪无佳名，端居正杜门。",
        "人闲见初落，风定不胜繁。",
        "可喜轻明质，都无剪刻痕。",
        "铺平失池沼，飘急响窗轩。",
        "惜不摇嘉树，冲宜走画辕。",
        "寒欺白酒嫩，暖爱紫貂温。",
        "远霭销如洗，愁云晚更屯。",
        "儿吟雏凤语，翁坐冻鸱蹲。",
        "病思惊残岁，朋欢赖酒罇。",
        "稍晴春意动，谁与探名园。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 79450,
      "title": "和武平学士岁晚禁直书怀五言二十韵",
      "content": [
        "多病淹残岁，初寒卧直庐。",
        "朝廷务清静，铃索少文书。",
        "向学今为盛，优贤古莫如。",
        "靓深严禁署，闲宴乐群居。",
        "赐马联金络，清尘侍玉舆。",
        "讨论三代盛，献纳万机余。",
        "号令存宽大，文章复古初。",
        "笑谈挥翰墨，俄顷列琼琚。",
        "夜漏销宫烛，春晖上玉除。",
        "歌诗唐李杜，言语汉严徐。",
        "自顾追时彦，多慙不鄙予。",
        "无盐烦刻画，寒谷借吹嘘。",
        "朋友飞雝鹭，君臣在藻鱼。",
        "贪荣同卫鹤，取笑类黔驴。",
        "皎皎心虽在，萧萧发已疏。",
        "未知论报效，安得遂樵渔。",
        "云破西山出，江横画阁虚。",
        "余生叹劳止，搔首念归欤。",
        "引绶夸民吏，樵牛会里闾。",
        "一麾终得请，此计岂踌躇。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 79451,
      "title": "答西京王尚书寄牡丹",
      "content": [
        "新花来远喜开封，呼酒看花兴未穷。",
        "年少曾为洛阳客，眼明重见魏家红。",
        "却思初赴青油幕，自笑今为白发翁。",
        "西望无由陪胜赏，但吟佳句想芳丛。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 79452,
      "title": "应制赏花钓鱼",
      "content": [
        "绛阙晨霞照雾开，轻尘不动翠华来。",
        "鱼游碧沼涵灵德，花馥清香荐寿杯。",
        "梦听钧天声杳默，日长化国景徘徊。",
        "自慙击壤音多野，帝所赓歌亦许陪。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 79453,
      "title": "清明赐新火",
      "content": [
        "鱼钥侵晨放九门，天街一骑走红尘。",
        "桐华应候催佳节，榆火推恩忝侍臣。",
        "多病正愁饧粥冷，清香但爱蜡烟新。",
        "自怜惯识金莲烛，翰苑曾经七见春。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 79454,
      "title": "明堂庆成",
      "content": [
        "辰火天文次，臯门路寝闳。",
        "奉亲昭孝德，惟帝飨精诚。",
        "礼以三年讲，时因万物成。",
        "九筵严太室，六变导和声。",
        "象魏中天起，风雷大号行。",
        "欢呼响山岳，流泽浃根茎。",
        "宝墨飞云动，金文耀日晶。",
        "从臣才力薄，无以颂休明。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 79455,
      "title": "群玉殿赐宴  其一",
      "content": [
        "至治臻无事，丰年乐有成。",
        "图书开秘府，宴饫集群英。",
        "论道皇坟奥，贻谋宝训明。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 79456,
      "title": "群玉殿赐宴  其二",
      "content": [
        "九重多暇豫，八体极研精。",
        "笔力千钧劲，豪端万象生。",
        "飞牋金洒落，拜赐玉锵鸣。",
        "盛际崇儒学，愚臣滥宠荣。",
        "惟能同舞兽，闻乐识和声。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 79457,
      "title": "永昭陵挽词三首  其一",
      "content": [
        "与子虽天意，知人昔帝难。",
        "一言谋早定，九鼎势先安。",
        "大舜仁由性，成汤治以宽。",
        "孤臣恩未报，清血但汍澜。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 79458,
      "title": "永昭陵挽词三首  其二",
      "content": [
        "干戈不用臻无事，朝野多欢乐有年。",
        "便坐看挥飞白笔，侍臣新和栢梁篇。",
        "衣冠忽见藏原庙，箫鼓愁闻向洛川。",
        "寂寞秋风群玉殿，还同恍惚梦钧天。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 79459,
      "title": "永昭陵挽词三首  其三",
      "content": [
        "行殿沉沉画翣重，凄凉挽铎出深宫。",
        "攀号不悟龙胡远，侍从犹穿豹尾中。",
        "日薄山川长起雾，天寒松栢自生风。",
        "斯民四十年涵煦，耕凿安知荷帝功。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 79460,
      "title": "续作永昭陵挽词五首  其一",
      "content": [
        "王者居尊本无外，由来天下以为家。",
        "六龙白日乘云去，何用金钱买道车。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 79461,
      "title": "续作永昭陵挽词五首  其二",
      "content": [
        "苦雾霏霏著彩旗，犹排吉伏杂凶仪。",
        "常时凤辇行游处，今日龙輴恸哭随。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 79462,
      "title": "续作永昭陵挽词五首  其三",
      "content": [
        "都人扰扰塞唐庄，西送灵车过苑墙。",
        "金鼎药成龙已去，人间惟有鼠拖肠。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 79463,
      "title": "续作永昭陵挽词五首  其四",
      "content": [
        "素幕悠悠逗晓风，行随哀挽出深宫。",
        "妃嫔莫向苍梧望，云覆昭陵洛水东。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 79464,
      "title": "续作永昭陵挽词五首  其五",
      "content": [
        "叨陪法从最多年，惯听梨园奏管弦。",
        "从此无因瞻黼坐，惟应魂梦到钧天。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 79465,
      "title": "赴集禧宫祈雪追忆从先皇驾幸泫然有感",
      "content": [
        "琳阙岧岧倚瑞烟，忆陪游豫入新年。",
        "云深晓日开宫殿，水阔春风飏管弦。",
        "千骑清尘回辇路，万家明月放灯天。",
        "一朝人事凄凉改，惟有灵光独岿然。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 79466,
      "title": "夜宿中书东合",
      "content": [
        "翰林平日接群公，文酒相欢慰病翁。",
        "白首归田徒有约，黄扉论道愧无功。",
        "攀髯路断三山远，忧国心危百箭攻。",
        "今夜静听丹禁漏，尚疑身在玉堂中。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 79467,
      "title": "送王学士赴两浙转运",
      "content": [
        "汉家财利析秋毫，暂屈清才岂足劳。",
        "邑屋连云盈万井，舳舻衔尾列千艘。",
        "春寒欲尽黄梅雨，海浪高翻白鹭涛。",
        "平昔壮心今在否，江山犹得助诗豪。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 79468,
      "title": "早朝",
      "content": [
        "阊阖初开瑞雾中，丹霞晓日上苍龙。",
        "鸣鞭响彻廓千步，佩玉声趋戟百重。",
        "雪后朝寒犹凛冽，柳梢春意已丰茸。",
        "少年自结芳菲侣，老病惟添睡思浓。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 79469,
      "title": "下直",
      "content": [
        "宫柳街槐绿未齐，春阴不解宿云低。",
        "轻寒漠漠侵𫘞褐，小雨班班作燕泥。",
        "报国无功嗟已老，归田有约一何稽。",
        "终当自驾柴车去，独结茅庐颍水西。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 79470,
      "title": "斋宫尚有残雪思作学士时摄事于此尝有闻鸎诗寄原父因而有感四首  其一",
      "content": [
        "雪压枯条脉未抽，春寒憀栗作春愁。",
        "却思绿叶清阴下，来此曾闻黄栗留。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 79471,
      "title": "斋宫尚有残雪思作学士时摄事于此尝有闻鸎诗寄原父因而有感四首  其二",
      "content": [
        "老来何与青春事，闲处方知白日长。",
        "自恨乞身今未得，齿牙浮动鬓苍浪。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 79472,
      "title": "斋宫尚有残雪思作学士时摄事于此尝有闻鸎诗寄原父因而有感四首  其三",
      "content": [
        "两京平日接英髦，不独诗豪酒亦豪。",
        "休把青铜照双鬓，君谟今已白刁骚。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 79473,
      "title": "斋宫尚有残雪思作学士时摄事于此尝有闻鸎诗寄原父因而有感四首  其四",
      "content": [
        "诗篇自觉随年老，酒力犹能助气豪。",
        "兴味不衰惟此尔，其余万事一牛毛。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 79474,
      "title": "摄事斋宫偶书",
      "content": [
        "斋宫岑寂偶偷闲，犹觉闲中兴未阑。",
        "美酒清香销昼景，冷风残雪作春寒。",
        "丹心未死惟忧国，白发盈簪盍挂冠。",
        "谁为寄声清颍客，此生终不负渔竿。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 79475,
      "title": "早期感事",
      "content": [
        "疏星牢落晓光微，残月苍龙阙角西。",
        "玉勒争门随仗入，牙牌当殿报班齐。",
        "羽仪虽接鸳兼鹭，野性终存鹿与麛。",
        "笑杀汝阴常处士，十年骑马听朝鸡。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 79476,
      "title": "集禧谢雨",
      "content": [
        "十里长街五鼓催，泥深雨急马行迟。",
        "卧听竹屋箫箫响，却忆滁州睡足时。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 79477,
      "title": "下直呈同行三公",
      "content": [
        "午漏声初转，归鞍路偶同。",
        "天清黄道日，街阔绿槐风。",
        "万国舟车会，中天象魏雄。",
        "戢戈清四海，论道属三公。",
        "自愧陪群彦，从来但朴忠。",
        "时平容窃禄，岁晚叹衰翁。",
        "买地淮山北，垂竿颍水东。",
        "稻粱虽可恋，吾志在冥鸿。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 79478,
      "title": "东合雨中",
      "content": [
        "直合时偷暇，幽怀坐独哦。",
        "绿苔人迹少，黄叶雨声多。",
        "云结愁阴重，风传禁漏过。",
        "瑶图新嗣圣，玉塞久包戈。",
        "相府文书简，丰年气候和。",
        "还将凤池句，聊杂野人歌。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 79479,
      "title": "四月十七日景灵宫奉迎仁宗皇帝御容有感",
      "content": [
        "行殿峨峨出绿槐，琳房芝阙耸崔嵬。",
        "管弦飘落人间去，幛节疑从天上来。",
        "基业百年传圣子，黔黎四纪乐春台。",
        "孤臣不得同针虎，未死心先冷若灰。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 79480,
      "title": "马上默诵圣俞诗有感",
      "content": [
        "兴来笔力千钧劲，酒醒人间万事空。",
        "苏梅二字今亡矣，索寞滁山一醉翁。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 79481,
      "title": "定力院七叶木",
      "content": [
        "伊洛多佳木，娑罗旧得名。",
        "常于佛家见，宜在月宫生。",
        "扣砌阴铺静，虚堂子落声。",
        "夜风疑雨过，朝露炫霞明。",
        "车马王都盛，楼台梵宇闳。",
        "惟应静者乐，时听野禽鸣。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 79482,
      "title": "秋阴",
      "content": [
        "秋阴积不散，夜气凛初清。",
        "雨冷侵灯晕，风愁送叶声。",
        "国恩慙未报，岁晚念余生。",
        "却忆滁州睡，村醪自解酲。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 79483,
      "title": "秋怀",
      "content": [
        "节物岂不好，秋怀何黯然。",
        "西风酒旗市，细雨菊花天。",
        "感事悲双鬓，包羞食万钱。",
        "鹿车终自驾，归去颍东田。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 79484,
      "title": "初寒",
      "content": [
        "多病淹残岁，初寒悄独吟。",
        "云容乍浓淡，秋色半晴阴。",
        "篱菊催佳节，山泉响夜琴。",
        "自能知此乐，何必恋腰金。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 79485,
      "title": "寄渭州王仲仪龙图",
      "content": [
        "羡君三作临边守，惯听胡笳不惨然。",
        "弓劲秋风鸣白角，帐寒春雪压青毡。",
        "威行四境烽烟断，响入千山号令传。",
        "翠幕红灯照罗绮，心情何似十年前。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 79486,
      "title": "崇政殿试贤良晚归",
      "content": [
        "槐柳依依禁籞长，初寒人意自凄凉。",
        "凤城斜日留残照，玉阙浮云结夜霜。",
        "老负渔竿贪国宠，病须樽酒送年光。",
        "归来解带西风冷，衣袖犹霑玉案香。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 79487,
      "title": "闻颍州通判国博与知郡学士唱和颇多因以奉寄知郡陆经通判杨褒",
      "content": [
        "一自苏梅闭九泉，始闻东颍播新篇。",
        "金樽留客史君醉，玉麈高谈别乘贤。",
        "十里秋风红菡萏，一溪春水碧漪涟。",
        "政成事简何为乐，终日吟哦杂管弦。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 79488,
      "title": "南郊庆成",
      "content": [
        "祀教民昭孝，天惟德是亲。",
        "太宫严大飨，吉土兆精禋。",
        "礼乐三五盛，梯航万国宾。",
        "恩霑群动洽，庆与一阳新。",
        "奉册尊长乐，均厘及众臣。",
        "不须云物瑞，和气浃人神。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 79489,
      "title": "和昭文相公上巳宴",
      "content": [
        "一雨初消九陌尘，秉兰修禊及芳辰。",
        "恩深始锡龙池宴，节正须知凤历新。",
        "红琥珀传杯潋滟，碧琉璃莹水奫沦。",
        "上林未放花齐发，留待鸣鞘出紫宸。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 79490,
      "title": "三日赴宴口占",
      "content": [
        "赐饮初逢禊节佳，昆池新涨碧无涯。",
        "九门寒食多游骑，三月春阴正养花。",
        "共喜流觞修故事，自怜双鬓惜年华。",
        "凤城残照归鞍晚，禁籞无风柳自斜。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 79491,
      "title": "读杨蟠章安集",
      "content": [
        "苏梅久作黄泉客，我亦今为白发翁。",
        "卧读杨蟠一千首，乞渠秋月与春风。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 79492,
      "title": "苏主簿挽歌",
      "content": [
        "布衣驰誉入京都，丹旐俄惊反旧闾。",
        "诸老谁能先贾谊，君王犹未识相如。",
        "三年弟子行丧礼，千两乡人会葬车。",
        "我独空斋挂尘榻，遗编时阅子云书。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 79493,
      "title": "寄题沙溪宝锡院",
      "content": [
        "为爱江西物物佳，作诗尝向北人夸。",
        "青林霜日换枫叶，白水秋风吹稻花。",
        "酿酒烹鸡留醉客，鸣机织苎徧山家。",
        "野僧独得无生乐，终日焚香坐结跏。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 79494,
      "title": "宋司空挽辞",
      "content": [
        "文章天下无双誉，伯仲人间第一流。",
        "出入两朝推旧德，周旋三事著嘉谋。",
        "从容进退身名泰，宠锡哀荣礼数优。",
        "棠棣从来敦友爱，九原相望接松楸。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 79495,
      "title": "感事",
      "content": [
        "故园三径久成荒，贤路胡为此坐妨。",
        "病骨瘦便花蕊暖，烦心渴喜凤团香。",
        "号弓但洒孤臣血，忧国空余两鬓霜。",
        "何日君恩悯衰朽，许从初服返耕桑。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 79496,
      "title": "大行皇帝灵驾以引挽歌辞  其一",
      "content": [
        "享国年虽近，斯民泽已深。",
        "俭勤成禹圣，仁孝本虞心。",
        "方庆逢千载，俄惊遏八音。",
        "天愁嵩岭外，云惨洛川浔。",
        "仗动千官卫，神行万象阴。",
        "孤臣恩未报，清血但盈襟。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 79497,
      "title": "大行皇帝灵驾以引挽歌辞  其二",
      "content": [
        "文景孜孜俭与恭，慨然思就太平功。",
        "兴隆学校皇家盛，放斥嫔嫱永巷空。",
        "威慑黠羌方问罪，凡成仙鼎忽遗弓。",
        "霜清日薄箫笳咽，万国悲号惨澹中。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 79498,
      "title": "大行皇帝灵驾以引挽歌辞  其三",
      "content": [
        "千龄应运叶天人，四海方欣政日新。",
        "忽见九门陈羽卫，犹疑五载欲时巡。",
        "觚棱月暗翔金凤，辇道霜清卧石麟。",
        "白首旧臣瞻画翣，秋风泪洒属车尘。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 79499,
      "title": "奉答子履学士见赠之作",
      "content": [
        "谁言颍水似潇湘，一笑相逢乐未央。",
        "岁晚君尤耐霜雪，兴阑吾欲返耕桑。",
        "铜槽旋压清樽美，玉麈闲挥白日长。",
        "豫约诗筒屡来往，两州鸡犬接封疆。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 79500,
      "title": "送道州张职方",
      "content": [
        "桂籍青衫忆共游，怜君华发始为州。",
        "身行南鴈不到处，山与北人相对愁。",
        "莫为高才轻远俗，当令遗老识贤侯。",
        "三年解组来归日，吾已先耕颍水头。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 79501,
      "title": "再至汝阴三绝  其一",
      "content": [
        "黄栗留鸣桑葚美，紫樱桃熟麦风凉。",
        "朱轮昔愧无遗爱，白首重来似故乡。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 79502,
      "title": "再至汝阴三绝  其二",
      "content": [
        "十载荣华贪国宠，一生忧患损天真。",
        "颍人莫怪归来晚，新向君前乞得身。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 79503,
      "title": "再至汝阴三绝  其三",
      "content": [
        "水味甘于大明井，鱼肥恰似新开湖。",
        "十四五年劳梦寐，此时才得少踟蹰。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 79504,
      "title": "郡斋忆书事寄子履",
      "content": [
        "使君居处似山中，吏散焚香一室空。",
        "雨过紫苔惟鸟迹，夜凉苍桧起天风。",
        "白醪酒嫩迎秋熟，红枣林繁喜岁丰。",
        "寄语瀛洲未归客，醉翁今已作僊翁。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 79505,
      "title": "答子履学士见寄",
      "content": [
        "颍毫相望乐未央，吾州仍得治仙乡。",
        "梦回枕上黄粱熟，身在壶中白日长。",
        "每恨老年才已尽，怕逢诗敌力难当。",
        "知君欲别西湖去，乞我桥南菡萏香。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 79506,
      "title": "寄枣人行书赠子履学士",
      "content": [
        "秋来红枣压枝繁，堆向君家白玉盘。",
        "甘辛楚国赤萍实，磊落韩嫣黄金丸。",
        "聊效诗人投木李，敢期佳句报琅玕。",
        "嗟予久苦相如渴，却忆冰梨熨齿寒。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 79507,
      "title": "赠隐者",
      "content": [
        "五岳嵩当天地中，闻君仍在最高峰。",
        "山藏六月阴崖雪，潭养千年蜕骨龙。",
        "物外自应多至乐，人间何事忽相逢。",
        "饮罢飘然不辞决，孤云飞去杳无踪。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 79508,
      "title": "戏书示黎教授",
      "content": [
        "古郡谁云毫陋邦，我来仍值岁丰穰。",
        "乌衔枣实园林熟，峰采桧花村落香。",
        "世治人方安垅亩，兴阑吾欲反耕桑。",
        "若无颍水肥鱼蟹，终老仙乡作醉乡。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 79509,
      "title": "书怀",
      "content": [
        "齿牙零落鬓毛踈，颍水多年已结庐。",
        "解组便为闲处士，新花莫笑病尚书。",
        "青衫仕至千钟录，白首归乘一鹿车。",
        "况有西邻隐君子，轻蓑短笠伴春锄。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 79510,
      "title": "涡河龙潭",
      "content": [
        "碧潭风定影涵虚，神物中藏岸不枯。",
        "一夜四郊春雨足，却来闲卧养明珠。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 79511,
      "title": "游太清宫出城马上口占",
      "content": [
        "拥旆西城一据鞍，耕夫初识劝农官。",
        "鵶鸣日出林光动，野阔风摇麦浪寒。",
        "渐暖绿杨才弄色，得晴丹杏不胜繁。",
        "牛羊鸡犬田家乐，终日思归盍挂冠。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 79512,
      "title": "太清宫烧香",
      "content": [
        "清晨琳阙耸巑岏，弭节斋坊暂整冠。",
        "玉案拜时香袅袅，画廓行处佩珊珊。",
        "坛场夜雨苍苔古，楼殿春风碧瓦寒。",
        "我是蓬莱宫学士，朝真便合列仙官。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 79513,
      "title": "谢提刑张郎中寄笻竹拄杖",
      "content": [
        "玉光莹润锦斓斑，霜雪经多节愈坚。",
        "珍重故人相赠意，扶持衰病过残年。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 79514,
      "title": "七言二首答黎教授  其一",
      "content": [
        "拨瓮浮醅新酿熟，得霜寒菊始开齐。",
        "养丹道士颜如玉，爱酒山公醉似泥。",
        "不惜蕊从蜂采去，尚余香有蝶来栖。",
        "莫嫌学舍官闲冷，犹得芳樽此共携。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 79515,
      "title": "七言二首答黎教授  其二",
      "content": [
        "共坐栏边日欲斜，更将金蕊泛流霞。",
        "俗知却老延龄药，百草枯时始见花。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 79516,
      "title": "又寄许道人",
      "content": [
        "绿发方瞳瘦骨轻，飘然乘鹤去吹笙。",
        "郡斋独坐风生竹，疑是孙登长啸声。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 79517,
      "title": "扶沟知县周职方录示白鹤宫苏才翁子美赠黄道士诗并盛作三绝见索拙句辄为四韵奉酬",
      "content": [
        "能棋好饮一道士，醉墨狂吟二谪仙。",
        "道士不闻乘白鹤，谪仙今已揜黄泉。",
        "古来豪杰皆如此，谁拂尘埃为惘然。",
        "华发郎官才调美，更将新句续遗篇。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 79518,
      "title": "晓发齐州道中二首  其一",
      "content": [
        "东州几日倦征轩，千骑骖驔白草原。",
        "鴈入寒云惊晓角，鸡鸣苍海浴朝暾。",
        "国恩未报身先老，客思无憀岁已昏。",
        "谁得平时为郡乐，自怜痟渴马文园。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 79519,
      "title": "晓发齐州道中二首  其二",
      "content": [
        "岁晚劳征役，三齐旧富闲。",
        "人行桑下路，日上海边山。",
        "轩冕非吾志，风霜犯客颜。",
        "惟应思颍梦，先过穆陵关。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 79520,
      "title": "表海亭",
      "content": [
        "望海亭亭古堞间，独凭危槛俯人寰。",
        "苦寒冰合分流水，欲雪云垂四面山。",
        "髀肉已消嗟病骨，冻醪犹可慰愁颜。",
        "颍田二顷春芜没，安得柴车自驾还。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 79521,
      "title": "岁晚书事",
      "content": [
        "一麾新命古三齐，白首沧洲愿已违。",
        "轩冕从来为外物，山川信美独思归。",
        "长天极目无飞鸟，积雪生光射落晖。",
        "腊候已穷春俗动，劝耕犹得览郊圻。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    }
  ],
