{
  "data": [
    {
      "id": 262484,
      "title": "江馆对雨",
      "content": [
        "鸟声愁雨似秋天，病客思家一向眠。",
        "草馆门临广州路，夜闻蛮语小江边。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262485,
      "title": "雨过山村",
      "content": [
        "雨里鸡鸣一两家，竹溪村路板桥斜。",
        "妇姑相唤浴蚕去，闲看中庭栀子花。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262486,
      "title": "山店",
      "content": [
        "登登石路何时尽，决决溪泉到处闻。",
        "风动叶声山犬吠，一家松火隔秋云。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262487,
      "title": "雨中寄东溪韦处士",
      "content": [
        "雨中溪破无干地，浸著床头湿著书。",
        "一个月来山水隔，不知茅屋若为居。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262488,
      "title": "乞竹",
      "content": [
        "乞取池西三两竿，房前栽著病时看。",
        "亦知自惜难判割，犹胜横根引出栏。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262489,
      "title": "人家看花",
      "content": [
        "年少狂疎逐君马，去来憔悴到京华。",
        "恨无闲地栽仙药，长傍人家看好花。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262490,
      "title": "未央风",
      "content": [
        "五更先起玉阶东，渐入千门万户中。",
        "总向高楼吹舞袖，秋风还不及春风。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262491,
      "title": "归山庄",
      "content": [
        "长安寄食半年余，重向人边乞荐书。",
        "山路独归冲夜雪，落斜骑马避柴车。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262492,
      "title": "寒食忆归",
      "content": [
        "京中曹局无多事，寒食贫儿要在家。",
        "遮莫杏园胜别处，亦须归看傍村花。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262493,
      "title": "留别张广文",
      "content": [
        "谢恩新入凤皇城，乱定相逢合眼明。",
        "千万求方好将息，杏花寒食的同行。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262494,
      "title": "送郑山人归山",
      "content": [
        "玉作车辕蒲作轮，当初不起颍阳人。",
        "一家总入嵩山去，天子何因得谏臣。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262495,
      "title": "伤堕水乌",
      "content": [
        "一乌堕水百乌啼，相吊相号遶故堤。",
        "眼见行人车辗过，不妨同伴各东西。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262496,
      "title": "看碁",
      "content": [
        "彼此抽先局势平，傍人道死的还生。",
        "两边对坐无言语，尽日时闻下子声。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262497,
      "title": "设酒寄独孤少府",
      "content": [
        "自看和酿一依方，缘看松花色较黄。",
        "不分君家新酒熟，好诗收得被回将。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262498,
      "title": "赠人二首 一",
      "content": [
        "金炉烟里要班头，欲得归山可自由。",
        "每度报朝愁入阁，在先教示小千牛。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262499,
      "title": "赠人二首 二",
      "content": [
        "多在蓬莱少在家，越绯衫上有红霞。",
        "朝回不向诸余处，骑马城西检校花。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262500,
      "title": "楼前",
      "content": [
        "天宝年前勤政楼，每年三日作千秋。",
        "飞龙老马曾教舞，闻著音声总举头。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262501,
      "title": "寄刘蕡问疾",
      "content": [
        "年少病多应为酒，谁家将息过今春。",
        "赊来半夏重熏尽，投著山中旧主人。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262502,
      "title": "听雨",
      "content": [
        "半夜思家睡里愁，雨声落落屋簷头。",
        "照泥星出依前黑，淹烂庭花不肯休。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262503,
      "title": "新晴",
      "content": [
        "夏夜新晴星校少，雨收残水入天河。",
        "簷前熟著衣裳坐，风冷浑无扑火蛾。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262504,
      "title": "秋日后",
      "content": [
        "住处近山常足雨，闻晴晒曝旧芳茵。",
        "立秋日后无多热，渐觉生衣不著身。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262505,
      "title": "哭孟东野二首 一",
      "content": [
        "吟损秋天月不明，兰无香气鹤无声。",
        "自从东野先生死，侧近云山得散行。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262506,
      "title": "哭孟东野二首 二",
      "content": [
        "老松临死不生枝，东野先生早哭儿。",
        "但是洛阳城里客，家传一本杏殇诗。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262507,
      "title": "寄蜀中薛涛校书",
      "content": [
        "万里桥边女校书，枇杷花里闭门居。",
        "扫眉才子于今少，管领春风总不如。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262508,
      "title": "路中上田尚书",
      "content": [
        "去路何词见六亲，手中刀尺不如人。",
        "可怜池阁秋风夜，愁绿娇红一遍新。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262509,
      "title": "于主簿厅看花",
      "content": [
        "小叶稠枝粉压摧，暖风吹动鹤翎开。",
        "若无别事为留滞，应便抛家宿看来。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262510,
      "title": "江楼对雨寄杜书记",
      "content": [
        "竹烟花雨细相和，看著闲书睡更多。",
        "好是主人无事日，应持小酒按新歌。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262511,
      "title": "观蛮妓",
      "content": [
        "欲说昭君歛翠蛾，清声委曲怨于歌。",
        "谁家年少春风里，抛与金钱唱好多。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262512,
      "title": "送顾非熊秀才归丹阳",
      "content": [
        "江城柳色海门烟，欲到茅山始下船。",
        "知道君家当瀑布，菖蒲潭在草堂前。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262513,
      "title": "老人歌",
      "content": [
        "白发老人垂泪行，上皇生日出京城。",
        "如今供奉多新意，错唱当时一半声。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262514,
      "title": "和元郎中从八月十二至十五夜翫月五首 一",
      "content": [
        "半秋初入中旬夜，已向堦前守月明。",
        "从未圆时看却好，一分分见傍轮生。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262515,
      "title": "和元郎中从八月十二至十五夜翫月五首 二",
      "content": [
        "乱云遮却台东月，不许教依次第看。",
        "莫为诗家先见镜，被他宠与作艰难。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262516,
      "title": "和元郎中从八月十二至十五夜翫月五首 三",
      "content": [
        "今夜月明胜昨夜，新添桂树近东枝。",
        "立多地湿舁床坐，看过墙西寸寸迟。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262517,
      "title": "和元郎中从八月十二至十五夜翫月五首 四",
      "content": [
        "月似圆来色渐凝，玉盆盛水欲侵棱。",
        "夜深尽放家人睡，直到天明不炷灯。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262518,
      "title": "和元郎中从八月十二至十五夜翫月五首 五",
      "content": [
        "合望月时常望月，分明不得似今年。",
        "仰头五夜风中立，从未圆时直到圆。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262519,
      "title": "对酒",
      "content": [
        "为病比来浑断绝，缘花不免却知闻。",
        "从来事事关身少，主领春风只在君。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262520,
      "title": "晓望华清宫",
      "content": [
        "晓来楼阁更鲜明，日出阑干见鹿行。",
        "武帝自知身不死，看修玉殿号长生。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262521,
      "title": "赠李愬仆射二首 一",
      "content": [
        "和雪翻营一夜行，神旗冻定马无声。",
        "遥看火号连营赤，知是先锋已上城。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262522,
      "title": "赠李愬仆射二首 二",
      "content": [
        "旗幡四面下营稠，手诏频来老将忧。",
        "每日城南空挑战，不知生缚入唐州。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262523,
      "title": "秋夜对雨寄石瓮寺二秀才",
      "content": [
        "夜山秋雨滴空廊，灯照堂前树叶光。",
        "对坐读书终卷后，自披衣被扫僧房。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262524,
      "title": "华清宫前柳",
      "content": [
        "杨柳宫前忽地春，在先惊动探春人。",
        "晓来唯欠骊山雨，洗却枝头绿上尘。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262525,
      "title": "别杨校书",
      "content": [
        "从军秣马十三年，白发营中听早蝉。",
        "故作老丞身不避，县名昭应管山泉。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262526,
      "title": "和门下武相公春晓闻莺",
      "content": [
        "侵黑行飞一两声，春寒啭小未分明。",
        "若教更解诸余语，应向宫花不惜情。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262527,
      "title": "田侍郎归镇 一",
      "content": [
        "去处长将决胜筹，回回身在阵前头。",
        "贼城破后先锋入，看著红妆不敢收。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262528,
      "title": "田侍郎归镇 二",
      "content": [
        "熨帖朝衣抛战袍，夔龙班里侍中高。",
        "对时先奏牙间将，次第天恩与节旄。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262529,
      "title": "田侍郎归镇 三",
      "content": [
        "踏著家乡马脚轻，暮山秋色眼前明。",
        "老人上酒齐头拜，得侍中来尽再生。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262530,
      "title": "田侍郎归镇 四",
      "content": [
        "功成谁不拥藩方，富贵还须是本乡。",
        "万里双旌汾水上，玉鞭遥指白云庄。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262531,
      "title": "田侍郎归镇 五",
      "content": [
        "鼓吹旛旗道两边，行男走女喜骈阗。",
        "旧交省得当时别，指点如今却少年。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262532,
      "title": "田侍郎归镇 六",
      "content": [
        "广场破阵乐初休，彩纛高于百尺楼。",
        "老将气雄争起舞，管弦回作大缠头。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262533,
      "title": "田侍郎归镇 七",
      "content": [
        "笳声万里动燕山，草白天清塞马闲。",
        "触处不如别处乐，可怜秋月照江关。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262534,
      "title": "田侍郎归镇 八",
      "content": [
        "将士请衣忘却贫，绿窗红烛酒楼新。",
        "家家尽踏还乡曲，明月街中不绝人。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262535,
      "title": "寄广文张博士",
      "content": [
        "春明门外作卑官，病友经年不得看。",
        "莫道长安近于日，升天却易到城难。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262536,
      "title": "早春书情",
      "content": [
        "渐老风光不著人，花溪柳陌早逢春。",
        "近来行到门前少，趁暖闲眠似病人。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262537,
      "title": "唐昌观玉蕋花",
      "content": [
        "一树笼𩮀玉刻成，飘廊点地色轻轻。",
        "女冠夜觅香来处，唯见阶前碎月明。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262538,
      "title": "眼病寄同官",
      "content": [
        "天寒眼痛少心情，隔雾看人夜里行。",
        "年少往来常不住，墙西冻地马蹄声。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262539,
      "title": "九日登丛台",
      "content": [
        "平原池阁在谁家，双塔丛台野菊花。",
        "零落故宫无入路，西来涧水绕城斜。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262540,
      "title": "题酸枣县蔡中郎碑",
      "content": [
        "苍苔满字土埋龟，风雨销磨绝妙词。",
        "不向图经中旧见，无人知是蔡邕碑。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262541,
      "title": "江陵使至汝州",
      "content": [
        "回看巴路在云间，寒食离家麦熟还。",
        "日暮数峰青似染，商人说是汝州山。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262542,
      "title": "十五夜望月寄杜郎中",
      "content": [
        "中庭地白树栖鸦，冷露无声湿桂花。",
        "今夜月明人尽望，不知秋思在谁家。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262543,
      "title": "寄同州田长史",
      "content": [
        "除听好语耳常聋，不见诗人眼底空。",
        "莫怪出城为长史，总缘山在白云中。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262544,
      "title": "外按",
      "content": [
        "夹城门向野田开，白鹿非时出洞来。",
        "日暮秦陵尘土起，从东外按使初回。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262545,
      "title": "宫词一百首 一",
      "content": [
        "蓬莱正殿压金鼇，红日初生碧海涛。",
        "闲著五门遥北望，柘黄新帕御床高。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262546,
      "title": "宫词一百首 二",
      "content": [
        "殿前传点各依班，召对西来八诏蛮。",
        "上得青花龙尾道，侧身偷觑正南山。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262547,
      "title": "宫词一百首 三",
      "content": [
        "龙烟日暖紫曈曈，宣政门当玉殿风。",
        "五刻阁前卿相出，下帘声在半天中。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262548,
      "title": "宫词一百首 四",
      "content": [
        "白玉窗前起草臣，樱桃初赤赐尝新。",
        "殿头传语金阶远，只进词来谢圣人。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262549,
      "title": "宫词一百首 五",
      "content": [
        "内人对御叠花牋，绣坐移来玉案边。",
        "红蜡烛前呈草本，平明舁出阁门宣。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262550,
      "title": "宫词一百首 六",
      "content": [
        "千牛仗下放朝初，玉案傍边立起居。",
        "每日进来金凤纸，殿头无事不多书。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262551,
      "title": "宫词一百首 七",
      "content": [
        "延英引对碧衣郎，江砚宣毫各别床。",
        "天子下帘亲考试，宫人手里过茶汤。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262552,
      "title": "宫词一百首 八",
      "content": [
        "未明开著九重关，金画黄龙五色幡。",
        "直到银台排仗合，圣人三殿对西番。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262553,
      "title": "宫词一百首 九",
      "content": [
        "少年天子重边功，亲到凌烟画阁中。",
        "教觅勋臣写图本，长将殿里作屏风。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262554,
      "title": "宫词一百首 十",
      "content": [
        "丹凤楼门把火开，五云金辂下天来。",
        "堦前走马人宣慰，天子南郊一宿回。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262555,
      "title": "宫词一百首 十一",
      "content": [
        "楼前立仗看宣赦，万岁声长拜舞齐。",
        "日照彩盘高百尺，飞仙争上取金鸡。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262556,
      "title": "宫词一百首 十二",
      "content": [
        "集贤殿里图书满，点勘头边御印同。",
        "真迹进来依数字，别收锁在玉函中。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262557,
      "title": "宫词一百首 十三",
      "content": [
        "秘殿清斋刻漏长，紫微宫女夜焚香。",
        "拜陵日近公卿发，卤簿分头入太常。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262558,
      "title": "宫词一百首 十四",
      "content": [
        "新调白马怕鞭声，供奉骑来遶殿行。",
        "为报诸王侵早入，隔门催进打毬名。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262559,
      "title": "宫词一百首 十五",
      "content": [
        "对御难争第一筹，殿前不打背身毬。",
        "内人唱好龟兹急，天子鞘回过玉楼。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262560,
      "title": "宫词一百首 十六",
      "content": [
        "新衫一样殿头黄，银带排方獭尾长。",
        "总把玉鞭骑御马，绿鬃红额麝香香。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262561,
      "title": "宫词一百首 十七",
      "content": [
        "罗衫叶叶绣重重，金凤银鹅各一丛。",
        "每遍舞时分两向，太平万岁字当中。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262562,
      "title": "宫词一百首 十八",
      "content": [
        "鱼藻宫中锁翠娥，先皇行处不曾过。",
        "如今池底休铺锦，菱角鸡头积渐多。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262563,
      "title": "宫词一百首 十九",
      "content": [
        "殿前明日中和节，连夜琼林散舞衣。",
        "传报所司分蜡烛，监开金锁放人归。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262564,
      "title": "宫词一百首 二十",
      "content": [
        "五更三点索金车，尽放宫人出看花。",
        "仗下一时催立马，殿头先报内园家。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262565,
      "title": "宫词一百首 二十一",
      "content": [
        "城东北面望云楼，半下珠帘半上钩。",
        "骑马行人长远过，恐防天子在楼头。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262566,
      "title": "宫词一百首 二十二",
      "content": [
        "射生宫女宿红妆，把得新弓各自张。",
        "临上马时齐赐酒，男儿跪拜谢君王。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262567,
      "title": "宫词一百首 二十三",
      "content": [
        "新秋白兔大于拳，红耳霜毛趁草眠。",
        "天子不教人射杀，玉鞭遮到马蹄前。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262568,
      "title": "宫词一百首 二十四",
      "content": [
        "内鹰笼脱解红绦，鬬胜争飞出手高。",
        "直上碧云还却下，一双金爪掬花毛。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262569,
      "title": "宫词一百首 二十五",
      "content": [
        "竞渡船头掉采旗，两边溅水湿罗衣。",
        "池东争向池西岸，先到先书上字归。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262570,
      "title": "宫词一百首 二十六",
      "content": [
        "灯前飞入玉堦虫，未卧常闻半夜钟。",
        "看著中元斋日到，自盘金线绣真容。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262571,
      "title": "宫词一百首 二十七",
      "content": [
        "红灯睡里唤春云，云上三更直宿分。",
        "金砌雨来行步滑，两人抬起隐花裙。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262572,
      "title": "宫词一百首 二十八",
      "content": [
        "一时起立吹箫管，得宠人来满殿迎。",
        "整顿衣裳皆著却，舞头当拍第三声。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262573,
      "title": "宫词一百首 二十九",
      "content": [
        "琵琶先抹六么头，小管丁宁侧调愁。",
        "半夜美人双唱起，一声声出凤皇楼。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262574,
      "title": "宫词一百首 三十",
      "content": [
        "春池日暖少风波，花里牵船水上歌。",
        "遥索劒南新样锦，东宫先钓得鱼多。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262575,
      "title": "宫词一百首 三十一",
      "content": [
        "十三初学擘箜篌，弟子名中被点留。",
        "昨日教坊新进入，并房宫女与梳头。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262576,
      "title": "宫词一百首 三十二",
      "content": [
        "红蛮杆拨贴胸前，移坐当头近御筵。",
        "用力独弹金殿响，凤皇飞下四条弦。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262577,
      "title": "宫词一百首 三十三",
      "content": [
        "春风吹雨洒旗竿，得出深宫不怕寒。",
        "夸道自家能走马，团中横过觅人看。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262578,
      "title": "宫词一百首 三十四",
      "content": [
        "粟金腰带象牙锥，散插红翎玉突枝。",
        "旋猎一边还引马，归来鸡兔遶鞍垂。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262579,
      "title": "宫词一百首 三十五",
      "content": [
        "云駮花骢各试行，一般毛色一般缨。",
        "殿前来往重骑过，欲得君王别赐名。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262580,
      "title": "宫词一百首 三十六",
      "content": [
        "每夜停灯熨御衣，银熏笼底火霏霏。",
        "遥听帐里君王觉，上直钟声始得归。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262581,
      "title": "宫词一百首 三十七",
      "content": [
        "因吃樱桃病放归，三年著破旧罗衣。",
        "内中人识从来去，结得金花上贵妃。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262582,
      "title": "宫词一百首 三十八",
      "content": [
        "欲迎天子看花去，下得金堦却悔行。",
        "恐见失恩人旧院，回来忆著五弦声。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262583,
      "title": "宫词一百首 三十九",
      "content": [
        "往来旧院不堪修，近𠡠宣徽别起楼。",
        "闻有美人新进入，六宫未见一时愁。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    }
  ],
