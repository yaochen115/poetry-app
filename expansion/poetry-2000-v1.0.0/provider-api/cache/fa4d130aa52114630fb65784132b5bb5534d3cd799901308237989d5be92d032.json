{
  "data": [
    {
      "id": 315101,
      "title": "鹧鸪天",
      "content": [
        "宝篆烟消香已残。",
        "蝉娟月色浸栏干。",
        "歌喉不作寻常唱，酒令从他各自还。",
        "传杯手，莫教闲。",
        "醉红潮脸媚酡颜。",
        "相携共学骖鸾侣，却笑卢郎旧约寒。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315102,
      "title": "鹧鸪天",
      "content": [
        "绿水澄江得胜游。",
        "浪平风软称轻舟。",
        "樽前我易伤前事，柳外人谁独倚楼。",
        "空感慨，惜风流。",
        "风流赢得谩多愁。",
        "愁多著甚销磨得，莫怪安仁鬓早秋。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315103,
      "title": "鹧鸪天",
      "content": [
        "一曲清歌金缕衣。",
        "巧佼心事有谁知。",
        "自从别后难相见，空解题红寄好诗。",
        "忆携手，过阶墀。",
        "月笼花影半明时。",
        "玉钗头上轻轻颤，摇落钗头豆蔻枝。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315104,
      "title": "眼儿媚",
      "content": [
        "人随社节去匆匆。",
        "此恨几时穷。",
        "阳台寂寞，巫山凄惨，云雨成空。",
        "芭蕉密处窗儿下，冷落旧香中。",
        "黄昏静也，蛩声满院，明月清风。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315105,
      "title": "眼儿媚",
      "content": [
        "槐阴密处啭黄鹂。",
        "午日正长时。",
        "一番过雨，绿荷池面，冷浸琉璃。",
        "红尘不到华堂里，纤楚对蛾眉。",
        "笑偎人道，新词觅个，美底腔儿。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315106,
      "title": "眼儿媚",
      "content": [
        "当年策马过钱塘。",
        "曲径小平康。",
        "繁红酽白，娇莺姹燕，争唤何郎。",
        "而今又客东风里，浑不似寻常。",
        "只愁别后，月房云洞，啼损红妆。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315107,
      "title": "临江仙",
      "content": [
        "蕊嫩花房无限好，东风一样春工。",
        "百年欢笑酒樽同。",
        "笙吹雏凤语，裙染石榴红。",
        "且向五云深处住，锦衾绣幌从容。",
        "如何即是出樊笼。",
        "蓬莱人少到，云雨事难穷。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315108,
      "title": "临江仙",
      "content": [
        "破靥盈盈巧笑，举杯滟滟迎逢。",
        "慧心端有谢娘风。",
        "烛花香雾，娇困面微红。",
        "别恨彩笺虽寄，清歌浅酌难同。",
        "梦回楚馆雨云空。",
        "相思春暮，愁满绿芜中。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315109,
      "title": "临江仙",
      "content": [
        "夜久笙箫吹彻，更深星斗还稀。",
        "醉拈裙带写新诗。",
        "锁窗风露，烛灺月明时。",
        "水调悠扬声美，幽情彼此心知。",
        "古香烟断彩云归。",
        "满倾蕉叶，齐唱传花枝。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315110,
      "title": "惜奴娇",
      "content": [
        "洛浦娇魂，恐得到、人间少。",
        "把风流、分付花貌。",
        "六出精神，腊寒射、香试到。",
        "清秀。",
        "与江梅、争相先后。",
        "檐卜粗疏，怎似妖娆体调。",
        "比山樊、也应错道。",
        "最是殷勤，捧出金盏银台笑。",
        "拼了。",
        "仙源与、奇葩醉倒。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315111,
      "title": "水龙吟",
      "content": [
        "无情风掠芭蕉响，还是重门已闭。",
        "银缸独对，相思方切，教人怎睡。",
        "解叹从前事，解叹了、依前鳖气。",
        "想他家那里，知人憔悴，相应是、睡也未。",
        "且恁和衣强寝，奈无寐、依前重起。",
        "起来思想，当初与你，忒煞容易。",
        "及至而今也，半头天眼，不存不济。",
        "最消魂苦是，黄昏前后，冷清清地。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315112,
      "title": "水调歌头",
      "content": [
        "把酒相劳苦，月色耀天章。",
        "冰轮碾破寒碧，飞入酒樽凉。",
        "击节词人妙句，吸此清辉万丈，肺腑亦生光。",
        "揽袂欲仙举，逸兴共天长。",
        "日边客，幕中俊，坐间狂。",
        "浩歌清啸，恍然云海渺茫茫。",
        "唤醒谪仙苏二，何事常愁客少，更恐被云妨。",
        "月与人长好，广大醉为乡。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315113,
      "title": "水龙吟",
      "content": [
        "先来天与精神，更因丽景添殊态。",
        "拖轻苒苒，才凝一段，还分五彩。",
        "毕竟非烟，有时为雨，惹情无奈。",
        "道无心，怎被歌声遏断，迟迟向、青天外。",
        "宜伴先生醉卧，得饶道、和山须买。",
        "也曾恼杀襄王，谁道依前不会。",
        "我欲乘风归去，翻怅恨、帝乡何在。",
        "念佳期未展，天长莫合，尽空相对。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315114,
      "title": "诉衷情",
      "content": [
        "花前月下会鸳鸯。",
        "分散两情伤。",
        "临行祝付真意，臂间皓齿留香。",
        "还更毒，又何妨。",
        "尽成疮。",
        "疮儿可后，痕儿见在，见后思量。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315115,
      "title": "满江红",
      "content": [
        "懊恼平生，奈天赋、恩情太薄。",
        "二三岁、看伊受尽，眼尖眉角。",
        "记得当初低耳畔，是谁先有于飞约。",
        "惟到今、划地误盟言，还先恶。",
        "天眼见，人难度。",
        "天易感，人难托。",
        "人心险，天又怎生捉摸。",
        "莫问傍人非与是，手儿但把心儿托。",
        "便不成、厮守许多时，干休却。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315116,
      "title": "贺新郎",
      "content": [
        "负你千行泪。",
        "大都来、一寸心儿，万般萦系。",
        "似恁愁烦那里洎。",
        "故自三年二岁。",
        "为你后、甘心憔悴。",
        "终待说、山盟海誓。",
        "这恩情、到此非容易。",
        "拼做个，久长计。",
        "紧要事须评议。",
        "怕人人、蓦地知时，怎生处置。",
        "毒害心肠祆知是。",
        "怕你生烦到底。",
        "便莫待、将人轻弃。",
        "不是我多疑你。",
        "被傍人、赚后失圈圚。",
        "经一事，长一智。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315117,
      "title": "眼儿媚",
      "content": [
        "连沧危观暮江前。",
        "几醉使君筵。",
        "少年俊气，曾将吟笔，买断江天。",
        "重来细把朋游数，回首一辛酸。",
        "兰成已老，文园多病，负此江山。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315118,
      "title": "簇水",
      "content": [
        "长忆当初，是他见我心先有。",
        "一钩才下，便引得鱼儿开口。",
        "好是重门深院，寂寞黄昏后。",
        "厮觑著、一面儿酒。",
        "试撋就。",
        "便把我、得人意处，闵子里、施纤手。",
        "云情雨意，似十二巫山旧。",
        "更向枕前言约，许我长相守。",
        "忺人也，犹自眉头皱。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315119,
      "title": "摊破丑奴儿・采桑子",
      "content": [
        "最苦是离愁。",
        "行坐里、只在心头。",
        "待要作个巫山梦，孤衾展转，无眠到晓，和梦都休。",
        "梦里也无由。",
        "谁敢望、真个绸缪。",
        "暂时不见浑闲事，只愁柳絮杨花，自来摆荡难留。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315120,
      "title": "更漏子",
      "content": [
        "烛消红，窗送白。",
        "冷落一衾寒色。",
        "鸦唤起，马忘行",
        "月来衣上明。",
        "酒香唇，妆印臂。",
        "亿共人人睡。",
        "魂蝶乱，梦鸾孤。",
        "知他睡也无。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315121,
      "title": "浣溪沙",
      "content": [
        "一味风流一味香。",
        "十分浓艳十分妆。",
        "自然娇态自然芳。",
        "楼上好风楼下水，雪前栏槛竹前窗。",
        "也宜单著也宜双。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315122,
      "title": "浣溪沙",
      "content": [
        "恻恻笙竽万籁风。",
        "阳关叠遍酒尊空。",
        "相逢草草别匆匆。",
        "满眼泪珠和雨洒，一襟愁绪抵秋浓。",
        "相思今夜五云东。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315123,
      "title": "汉宫春",
      "content": [
        "讲柳谈花，我从来口快，忺说他家。",
        "眼前见了，无限楚女吴娃。",
        "千停万稳，较量来、终不如他。",
        "便做得，宫仪院体，歌谈不带烟花。",
        "从前万事堪夸。",
        "爱拈笺弄管，锦字敧斜。",
        "新来与人臑著，不许胡巴。",
        "嚎懑谩惹，料福缘、浅似他些。",
        "谁为我，传诗递曲，殷勤题上窗纱。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315124,
      "title": "雨中花慢",
      "content": [
        "帊子分香，罗巾拭泪，别来时、未觅凄惶。",
        "上得船儿来了，刬地凄凉。",
        "可惜花前月里，却成水远山长。",
        "做成恩爱，如今赢得，万里千乡。",
        "情知这场寂寞，不干你事，伤我穷忙。",
        "不道是、久长活路，终要称量。",
        "我则匆匆归去，知你且、种种随娘。",
        "下梢睚彻，有时共你风光。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315125,
      "title": "柳梢青",
      "content": [
        "小窗闲适。",
        "云髻亸肩，香肌偎膝。",
        "玉局无尘，明琼欲碎，春纤同掷。",
        "不争百万呼卢，赌今夜、鸳帷痛惜。",
        "好忍马儿，若还输了，当甚则剧。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315126,
      "title": "南歌子",
      "content": [
        "梅萼和霜晓，梨花带雪春。",
        "玉肌琼艳本无尘。",
        "肯把铅华容易、污天真。",
        "汤饼尝初罢，罗巾拭转新。",
        "几回贪耍失黄昏。",
        "月里归来无处、觅精神。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315127,
      "title": "临江仙",
      "content": [
        "人在梦云楼上别，残灯影里迟留。",
        "依稀绿惨更红羞。",
        "露痕双脸湿，山样两眉愁。",
        "几幅片帆天际去，云涛烟浪悠悠。",
        "今宵独立古江头。",
        "水腥鱼菜市，风碎荻花舟。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315128,
      "title": "浣溪沙",
      "content": [
        "画角声沈卷暮霞。",
        "寒生促索锦屏遮。",
        "沈檀半𦶟髻堆鸦。",
        "蝴蝶梦回馀烛影，子规啼处隔窗纱。",
        "夜深明月浸梨花。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315129,
      "title": "浪淘沙",
      "content": [
        "帘卷露花容。",
        "几度相逢。",
        "他知我意欲相通。",
        "偏奈天教多阻间，积恨何穷。",
        "云雨杳无踪。",
        "愁怕东风。",
        "时闻语笑恣欢浓。",
        "惟有俺咱真分浅，往事成空。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315130,
      "title": "如梦令",
      "content": [
        "竹外半窥娇面。",
        "真个出尘体段。",
        "没处可偷怜，空恁眼穿肠断。",
        "休恋。",
        "休恋。",
        "只是与伊分浅。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315131,
      "title": "浣溪沙",
      "content": [
        "闲理丝簧听好音。",
        "西楼剪烛夜深深。",
        "半嗔半喜此时心。",
        "暖语温存无恙语，韵开香靥笑吟吟。",
        "别来烦恼到如今。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315132,
      "title": "减字木兰花",
      "content": [
        "阳关唱彻。",
        "断尽离肠声哽咽。",
        "酒已三巡。",
        "今夜王孙是路人。",
        "此情难说。",
        "莫负等闲风与月。",
        "欲问归期。",
        "来戴钗头艾虎儿。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315133,
      "title": "减字木兰花",
      "content": [
        "半窗斜月。",
        "茅店萧条灯已灭。",
        "床下蛩声。",
        "声动凄凉不忍听。",
        "终宵无寐。",
        "覆去翻来真个是。",
        "屈指归期。",
        "应是梅花烂熳时。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315134,
      "title": "夜行船",
      "content": [
        "短棹轻舟排办了。",
        "歌声断、晚霞残照。",
        "红蓼坡头，绿杨堤外，离恨知多少。",
        "别后莫教音信杳。",
        "叹光阴、初自来堪笑。",
        "画角谯门，槐溪归路，正是楚天清晓。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315135,
      "title": "眼儿媚",
      "content": [
        "玉楼初见念奴娇。",
        "无处不妖娆。",
        "眼传密意，樽前烛外，怎不魂消。",
        "西风明月相逢夜，枕簟正凉宵。",
        "𣨼人记得，叮咛残漏，且慢明朝。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315136,
      "title": "品令",
      "content": [
        "黄昏时候，诮不语、心如醉。",
        "无眠凝想，别来绣阁，多应憔悴。",
        "上了灯儿，知是睡哩坐哩。",
        "蓦思归计。",
        "又还是重屈指。",
        "从今已后，暌离千万，且休容易。",
        "这底凄惶，你看是谁不是。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315137,
      "title": "柳梢青",
      "content": [
        "甜言软语。",
        "长记那时，萧娘叮嘱。",
        "清管危弦，前欢难断，鳞鸿无据。",
        "纷纷眼底浮花，拈弄动、几多思虑。",
        "千结丁香，且须珍重，休胡分付。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315138,
      "title": "浣溪沙",
      "content": [
        "金兽喷香瑞霭氛。",
        "夜凉如水酒醺醺。",
        "照人娇眼媚生春。",
        "我自愁多魂已断，不禁楚雨带巫云。",
        "人情又是一番新。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315139,
      "title": "浣溪沙",
      "content": [
        "坐看销金暖帐中。",
        "羔儿酒美兽煤红。",
        "浅斟低唱好家风。",
        "爱客东君多解事，晚妆新与画眉峰。",
        "便须催唤出房栊。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315140,
      "title": "浣溪沙",
      "content": [
        "堆枕冠儿翡翠钗。",
        "蒙金领子满絣鞋。",
        "于中沈净好情怀。",
        "新欲晚凉梳洗罢，半娇微笑下堂来。",
        "莲花因甚未曾开。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315141,
      "title": "临江仙",
      "content": [
        "天外浓云云外雨，雨声初上檐牙。",
        "红蕖应褪洗妆花。",
        "晚凉如有意，霫霫到山家。",
        "为唤山童多索酒，金锺细酌流霞。",
        "晕生玉颊酒潮斜。",
        "闲中无宠辱，醉里是生涯。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315142,
      "title": "夜行船",
      "content": [
        "绿盖红幢笼碧水。",
        "鱼跳处、浪痕匀碎。",
        "惜别殷勤，留连无计，歌声与、泪和柔脆。",
        "一叶扁舟烟浪里。",
        "曲滩头、此情无际。",
        "窈窕眉山，暮霞红处，雨云想、翠峰十二。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315143,
      "title": "浪淘沙",
      "content": [
        "窈窕绣帏深。",
        "窈窕娉婷。",
        "梅花初试晚妆新。",
        "那更娇痴年纪小，冰雪精神。",
        "举措忒轻盈。",
        "歌彻新声。",
        "柔肠魂断不堪听。",
        "但恐巫山留不住，飞作行云。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315144,
      "title": "如梦令",
      "content": [
        "居士年来懒散。",
        "凡事只从宽简。",
        "身外更无求，祗要夏凉冬暖。",
        "美满。",
        "美满。",
        "得过何须积趱。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315145,
      "title": "卜算子",
      "content": [
        "十载仰高明，一见心相许。",
        "来日孤舟西水门。",
        "风饱征帆腹。",
        "后夜起相思，明月清江曲。",
        "若见秋风寒雁来，能寄音书否。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315146,
      "title": "眼儿媚",
      "content": [
        "先来客路足伤悲。",
        "那更话别离。",
        "玉骢也解，知人欲去，骧首频嘶。",
        "马蹄动是三千里，后会莫相违。",
        "切须更把，丁香珍重，待我重期。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315147,
      "title": "南乡子",
      "content": [
        "楚楚窄衣裳。",
        "腰身占却，多少风光。",
        "共说春来春去事，凄凉。",
        "懒对菱花晕晓妆。",
        "闲立近红芳。",
        "游峰戏蝶，误采真香。",
        "何事不归巫峡去，思量。",
        "故来尘世断人肠。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315148,
      "title": "南乡子",
      "content": [
        "月转水晶盘。",
        "楼上初闻一鼓残。",
        "又是去年天气好，栏干。",
        "风动梅梢玉斗寒。",
        "无奈壮情阑。",
        "对酒如何欲强欢。",
        "谁道破愁须仗酒，君看。",
        "酒到愁多破亦难。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315149,
      "title": "谒金门",
      "content": [
        "灯乍灭。",
        "忽见一天明月。",
        "恰舞霓裳歌未歇。",
        "露寒回绛阙。",
        "羽服明晖玉雪。",
        "笑语轻参环玦。",
        "香泽恼人情不彻。",
        "夜长窗自白。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315150,
      "title": "点绛唇",
      "content": [
        "云亸宫鬟，淡黄衫子轻香透。",
        "晚凉时候。",
        "睡起新妆就。",
        "冰枕生寒，玉浸纤纤手。",
        "沈吟久。",
        "眉山敛秀。",
        "爱道奴家瘦。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315151,
      "title": "菩萨蛮",
      "content": [
        "春山已蹙眉峰绿。",
        "春心骀荡难拘束。",
        "惆怅为春伤。",
        "惜花心更狂。",
        "对花深有意。",
        "且向花前醉。",
        "花作有情香。",
        "与人相久长。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315152,
      "title": "画堂春",
      "content": [
        "当时巧笑记相逢。",
        "玉梅枝上玲珑。",
        "酒杯流处已愁浓。",
        "寒雁横空。",
        "去程无记更从容。",
        "到归来好事匆匆。",
        "一时分付不言中。",
        "此恨难穷。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315153,
      "title": "如梦令",
      "content": [
        "居士年来病酒。",
        "肉食百不宜口。",
        "蒲合与波薐，更着同蒿葱韭。",
        "亲手。",
        "亲手。",
        "分送卧龙诗友。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315154,
      "title": "如梦令",
      "content": [
        "别恨眉尖无数。",
        "后夜王孙何处。",
        "歌馆与妆楼，目断行云凝伫。",
        "凝伫。",
        "凝伫。",
        "忆泪千行红雨。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315155,
      "title": "菩萨蛮",
      "content": [
        "隔江一带春山好。",
        "平林新绿春光老。",
        "休去倚阑干。",
        "飞红不忍看。",
        "东流何处去。",
        "便是归舟路。",
        "芳草外斜阳。",
        "行人更断肠。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315156,
      "title": "长相思",
      "content": [
        "敛愁眉。",
        "恨依依。",
        "肠断关情怨别离。",
        "云中过雁悲。",
        "瘦因谁。",
        "病因谁。",
        "屈指无言忖后期。",
        "此时人怎知。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315157,
      "title": "柳梢青",
      "content": [
        "潇洒仙源。",
        "夭桃秾李，曾对华筵。",
        "歌媚惊尘，舞弯低月，满劝金船。",
        "鉴湖烟水连天。",
        "政归棹、红妆斗妍。",
        "花雾香中，人询居士，切莫多传。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315158,
      "title": "好事近",
      "content": [
        "不羡八千椿，不羡三偷桃客。",
        "也不羡他龟鹤，一总为凡物。",
        "羡君恰似老人星，长明无休息。",
        "好与中兴贤主，立维城勋绩。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315159,
      "title": "朝中措",
      "content": [
        "南楼风物一番新。",
        "春暮畀斯民。",
        "岂但仁人恺弟，更兼政事如神。",
        "人生最贵，荣登五马，千里蒙恩。",
        "祗恐促归廊庙，去思有脚阳春。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315160,
      "title": "朝中措",
      "content": [
        "文章学业继家声。",
        "名誉压群英。",
        "早岁掀腾膴仕，如公富贵难并。",
        "定膺丹诏，朱轮迅召，陶冶苍生。",
        "自是盐梅姿质，伫看大手调羹。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315161,
      "title": "朝中措",
      "content": [
        "先生德行冠南丰。",
        "锦绣作心胸。",
        "暂屈徒劳州县，文章后进宗工。",
        "督邮纲纪，才高幕府，雅望尤崇。",
        "此去定膺光宠，且须满醉西东。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315162,
      "title": "念奴娇",
      "content": [
        "桂华蟾魄，到中秋、祗有人闻一六。",
        "浩渺清风因唤起，千里吹飞鸿鹄。",
        "碧落翻花，瑶空隐瑞，声节琅玕筑。",
        "板怀玉燕，此时嘉梦重育。",
        "始信名在丹台，曈方八百，子已三千熟。",
        "麟脯灵瓜那更有，琼斝神仙醽醁。",
        "秋水春山，柳腰花面，一醉霓裳曲。",
        "长生清净，自然何用辟谷。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315163,
      "title": "好事近",
      "content": [
        "江上一江楼，楼上远山横翠。",
        "还更腰金骑鹤，引竹西歌吹。",
        "寿君春酒遣双壶，满引见深意。",
        "肯向龟荷香里，唤侬来同醉。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315164,
      "title": "好事近",
      "content": [
        "剑水霭欢声，喜庆间生人杰。",
        "一段葱葱佳气，扇熏风时节。",
        "今朝银艾佐琴堂，争把寿香𦶟。",
        "去去凤皇池上，见龟巢连叶。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315165,
      "title": "柳长春・踏莎行",
      "content": [
        "梅喜先春，雁惊未腊。",
        "于门瑞气浮周匝。",
        "正当月应上弦时，长庚梦与良辰合。",
        "螺水恩浓，旴江德洽。",
        "寿杯劝处燃红蜡。",
        "明年此际祝遐龄，贺宾一一趋东阁。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315166,
      "title": "武陵春",
      "content": [
        "又是新逢三五夜，瑞气霭氤氲。",
        "万点灯和月色新。",
        "桃李倍添春。",
        "花县主人情思好，行乐逐良辰。",
        "满引千锺酒又醇。",
        "歌韵动梁尘。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315167,
      "title": "临江仙",
      "content": [
        "天祐炎图生国瑞，蓝田暂屈英僚。",
        "始知文宿降璇霄。",
        "中元前五日，七夕后三朝。",
        "江𢽾风流临此政，少年潇洒奇标。",
        "行看峻擢相熙朝。",
        "功名前稷契，寿算等松乔。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315168,
      "title": "喜迁莺",
      "content": [
        "商𩙪轻透。",
        "动帘幕飞梧，乱飘庭甃。",
        "瑞气氤氲，沈檀初𦶟，烟喷宝台金兽。",
        "黄花美酒。",
        "天教占得，先他时候。",
        "诞元老，庆有声，此夕降生华胄。",
        "欢笑。",
        "宜称寿。",
        "弦管鼎沸，宫商方频奏。",
        "满捧瑶卮，华堂歌舞，拍转金钗斜溜。",
        "朱颜绿鬓，殷勤深愿，镇长如旧。",
        "叹滨海，道难留，指日荣迁飞骤。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315169,
      "title": "鹊桥仙",
      "content": [
        "云峰初敛，秋荣如洗，庭院金风初扇。",
        "葱葱佳气霭侯门，信天上、麒麟乍见。",
        "祝君此去，飞黄腾踏，日侍凝旒邃冕。",
        "和羹调味早归来，坐看取、蓬莱清浅。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315170,
      "title": "柳梢青",
      "content": [
        "晴雪楼台，试灯帘幕，适是元宵。",
        "罗绮娇春，帝城风景，今夜应饶。",
        "争知我系如匏，便そ月良天任教。",
        "早闭柴门，从他箫鼓，细打轻敲。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315171,
      "title": "贺新郎",
      "content": [
        "世谛人多错。",
        "阿谁将、虚名微利，放教轻著。",
        "万事莫非前定了，选甚微如饮酌。",
        "算徒诧、龙韬豹略。",
        "纵使龙头安尺木，更从教、豹变生三角。",
        "浑是梦，恍如昨。",
        "吾庐自笑常虚廓。",
        "对残编、磨穿枯砚，生涯微薄。",
        "负郭田园能有几，随分安贫守约。",
        "要不改、箪瓢颜乐。",
        "西掖百扉终须到，且嘲风咏月常相谑。",
        "更要甚，万金药。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315172,
      "title": "东坡引",
      "content": [
        "茅斋无客至。",
        "冰砚冻寒泚。",
        "南枝喜入新诗里。",
        "恼人频嚼蕊。",
        "恼人频嚼蕊。",
        "因思去腊江头醉。",
        "倚动客兴伤春意。",
        "经年自叹人如寄。",
        "光阴如拈指。",
        "光阴如拈指。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315173,
      "title": "满庭芳",
      "content": [
        "风力驱寒，云荣呈瑞，晓来到处花飞。",
        "遍装琼树，春意到南枝。",
        "便是渔蓑旧画，纶竿重、横玉低垂。",
        "今宵里，香闺邃馆，幽赏事偏宜。",
        "风流金马客，歌鬟醉拥，乌帽斜敧。",
        "问人间何处，鹏运天池。",
        "且共周郎按曲，音微误、首己先回。",
        "同心事，丹山路稳，长伴彩鸾归。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315174,
      "title": "杏花天",
      "content": [
        "乍凉淅淅风生幕。",
        "人独在、朱栏翠阁。",
        "吹箫信杳炉香薄。",
        "眉上新愁又觉。",
        "从前事、拟将拼却。",
        "梦不断、花梢柳萼。",
        "一杯睡起谁同酌。",
        "斜日阴阴转角。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315175,
      "title": "临江仙",
      "content": [
        "远岫螺头湿翠，流霞赪尾疏明。",
        "断虹斜界雨新晴。",
        "烟村灯火晚，江浦画难成。",
        "我向其间泛叶，终朝露渚风汀。",
        "老来心事最关情。",
        "不堪三弄笛，吹作断肠声。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315176,
      "title": "辊绣球",
      "content": [
        "流水奏鸣琴，风月净、天无星斗。",
        "翠岚堆里，苍岩深处，满林霜腻，暗香冻了，那禁频嗅。",
        "马上再三回首。",
        "因记省、去年时候。",
        "十分全似，那人风韵，柔腰弄影，冰腮退粉，做成清瘦。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315177,
      "title": "眼儿媚",
      "content": [
        "南枝消息杳然间。",
        "寂寞倚雕栏。",
        "紫腰艳艳，青腰袅袅，风月俱闲。",
        "佳人环佩玉阑珊。",
        "作恶探花还。",
        "玉纤拈粟，樱唇呵粉，愁点眉弯。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315178,
      "title": "菩萨蛮",
      "content": [
        "日高犹恋珊瑚枕。",
        "羞红不忿花如锦。",
        "双燕运芹泥。",
        "燕归人未归。",
        "纵饶梳洗罢。",
        "朱户何曾跨。",
        "寂寞小房栊。",
        "回文和泪封。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315179,
      "title": "鹧鸪天",
      "content": [
        "落魄东吴二十春。",
        "风流诗句得清新。",
        "今年却恨花星照，再见温卿与远真。",
        "分楚佩，染巫云。",
        "赤绳结得短花茵。",
        "若非京口初相识，安得毗陵作故人。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315180,
      "title": "浪淘沙",
      "content": [
        "绿树转鸣禽。",
        "已是春深。",
        "杨花庭院日阴阴。",
        "帘外飞来双语燕，不寄归音。",
        "旧事懒追寻。",
        "空惹芳心。",
        "天涯消息远沈沈。",
        "记得年时中酒后，直至而今。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315181,
      "title": "谒金门",
      "content": [
        "春睡足。",
        "帘卷翠屏山曲。",
        "芳草沿阶横地轴。",
        "垂杨相映绿。",
        "暗忆旧欢难续。",
        "又是禁烟传烛。",
        "陌上踏青新结束。",
        "秋千谁共促。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315182,
      "title": "侍香金童",
      "content": [
        "一种春光，占断东君惜。",
        "算秾李、昭华争并得。",
        "粉腻酥融娇欲滴。",
        "端的尊前，旧曾相识。",
        "向夜阑、酒醒霜浓寒又力。",
        "但只与、冰姿添夜色。",
        "绣幕银屏人寂寂。",
        "只许刘郎，暗传消息。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315183,
      "title": "菩萨蛮",
      "content": [
        "新晴庭户春阴薄。",
        "东风不度重帘幕。",
        "第几小兰房。",
        "雏莺初弄黄。",
        "悄寒春未透。",
        "不解寻花柳。",
        "只恐渐春深。",
        "愁生求友心。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315184,
      "title": "清平乐",
      "content": [
        "紫箫声断。",
        "窗底春愁乱。",
        "试著春衫羞自看。",
        "窄似年时一半。",
        "一春长病厌厌。",
        "新来愁病重添。",
        "香冷倦熏金鸭，日高不卷珠帘。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315185,
      "title": "好事近",
      "content": [
        "齿颊带馀香，謦咳总成珠玉。",
        "剪碎袖罗花片，点金觥春绿。",
        "玉鱼花露自清凉，涓涓在郎腹。",
        "犹胜望梅消渴，对文君眉蹙。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315186,
      "title": "品令",
      "content": [
        "好事客。",
        "宫商内、吟得风清月白。",
        "主人幸有豪家意，后堂煞有春色。",
        "花压金翘俏相映，酒满玉纤无力。",
        "你若待我些儿酒，尽吃得、尽吃得。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315187,
      "title": "武陵春",
      "content": [
        "落了丹枫残了菊，秋色苦无多。",
        "谁唤西风泣泪罗，吹恨入星河。",
        "碧枝头金粟闹，曾扌乖翠云窝。",
        "重揉檀英忆两娥。",
        "无奈冷香何。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315188,
      "title": "水调歌头",
      "content": [
        "秋宇净如水，月镜不安台。",
        "郁孤高处张乐，语笑脱氛埃。",
        "檐外白毫千丈，坐上银河万斛，心境两佳哉。",
        "俯仰共清绝，底处著风雷。",
        "问天公，邀月姊，愧凡才。",
        "婆娑人世，羞见蓬鬓漾金罍。",
        "来岁公归何处，照耀彩衣簪橐，禁直且休催。",
        "一曲庾江上，千古继韶陔。"
      ],
      "author": {
        "id": 6465,
        "name": "罗愿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315189,
      "title": "失调名",
      "content": [
        "九月江南秋色，黄雀雨，鲤鱼风。"
      ],
      "author": {
        "id": 6465,
        "name": "罗愿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315190,
      "title": "醉翁操",
      "content": [
        "茫茫。",
        "苍苍。",
        "青山绕、千顷波光。",
        "新秋露风荷吹香。",
        "悠飏心地け然，生清凉。",
        "古岸摇垂杨。",
        "时有白鹭飞来双。",
        "隐君如在，鹤与翱翔。",
        "老仙何处，尚有流风未忘。",
        "琴与君兮宫商。",
        "酒与君兮杯觞。",
        "清欢殊未央。",
        "西山忽斜阳。",
        "欲去且徜徉。",
        "更将霜鬓临沧浪。"
      ],
      "author": {
        "id": 3272,
        "name": "楼钥"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315191,
      "title": "醉翁操",
      "content": [
        "冷然。",
        "清圆。",
        "谁弹。",
        "向屋山。",
        "何言。",
        "清风至阴德之天。",
        "悠飏馀响婵娟。",
        "方昼眠。",
        "迥立八风前。",
        "八音相宣知孰贤。",
        "有时悲壮，铿若龙泉。",
        "有时幽杳，彷佛猿吟鹤怨。",
        "忽若巍巍山巅。",
        "荡荡几如流川。",
        "聊将娱暮年。",
        "听之身欲仙。",
        "弦索满人间。",
        "未有逸韵如此弦。"
      ],
      "author": {
        "id": 3272,
        "name": "楼钥"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315192,
      "title": "导引",
      "content": [
        "孝宗纯孝，前圣更何加。",
        "高蹈处重华。",
        "丹成仙去龙輴远，越岸暮山遐。",
        "波臣先为卷寒沙。",
        "来往护灵槎。",
        "九虞礼举神祗乐，万世佑皇家。"
      ],
      "author": {
        "id": 3272,
        "name": "楼钥"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315193,
      "title": "导引",
      "content": [
        "吾皇尽孝，宗庙务崇尊。",
        "巨典备弥文。",
        "巍巍东向开基主，七世祔神孙。",
        "追思九闰整乾坤。",
        "环宇慕洪恩。",
        "从今密迩高宗室，千载事如存。"
      ],
      "author": {
        "id": 3272,
        "name": "楼钥"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315194,
      "title": "失调名",
      "content": [
        "昨日豆花篱下过，忽然迎面好风吹。",
        "独自立多时。"
      ],
      "author": {
        "id": 8064,
        "name": "张良臣"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315195,
      "title": "西江月",
      "content": [
        "四壁空围恨玉，十香浅捻啼绡。",
        "殷云度雨井桐凋。",
        "雁雁无书又到。",
        "别后钗分燕股，病馀镜减鸾腰。",
        "蛮江豆蔻影连梢。",
        "不道参横易晓。"
      ],
      "author": {
        "id": 8064,
        "name": "张良臣"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315196,
      "title": "采桑子",
      "content": [
        "佳人满劝金蕉叶，夜玉春温。",
        "别后黄昏。",
        "燕子楼高月一痕。",
        "年年依旧梨花雨，粉泪空存。",
        "流水孤村。",
        "不著寒鸦也断魂。"
      ],
      "author": {
        "id": 8064,
        "name": "张良臣"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315197,
      "title": "水调歌头",
      "content": [
        "问讯金华伯，自是地行仙。",
        "只为朱轮画戟，句引到湘川。",
        "用个狎鸥心地，做就烹鲜时政，民化我何言。",
        "但贵衡阳纸，纸落尽云烟。",
        "对湖天，梅索笑，月还圆。",
        "旧时岳生申甫，重到是前缘。",
        "快洗瑶觥一醉，唤个鹤仙起舞，骑取上花砖。",
        "春秋更多少，庄木八千年。"
      ],
      "author": {
        "id": 357,
        "name": "舒邦佐"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315198,
      "title": "杏花天",
      "content": [
        "爱寻水竹添情况。",
        "任云卧、溪边石上。",
        "衔杯乐圣成游荡。",
        "不为弓弯舞样。",
        "北湖迥、风飘彩舫。",
        "□笑击、冯夷薄相。",
        "致身福地何萧爽。",
        "莫道居夷太枉。"
      ],
      "author": {
        "id": 257,
        "name": "张孝忠"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315199,
      "title": "杏花天",
      "content": [
        "看花随柳湖边去。",
        "似邂逅、水晶宫住。",
        "刘郎笔落惊风雨。",
        "酒社诗盟心许。",
        "玉关外、不辞马武。",
        "便好展、云霄稳步。",
        "郴江自绕郴山路。",
        "欲问功名何处。"
      ],
      "author": {
        "id": 257,
        "name": "张孝忠"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315200,
      "title": "破阵子",
      "content": [
        "占气中涵清淑，征诗古富篇章。",
        "杖屦闲随鱼□乐，怀抱清如湖水凉。",
        "何殊吴越乡。",
        "风柳春容袅袅，水花月影汪汪。",
        "且把清尊浇磊磈，莫为浮名愁肺肠。",
        "星星白发长。"
      ],
      "author": {
        "id": 257,
        "name": "张孝忠"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    }
  ],
