{
  "data": [
    {
      "id": 305730,
      "title": "绣",
      "content": [
        "一片丝罗轻似水，洞房西室女工劳。",
        "花随玉指添春色，鸟逐金针长羽毛。",
        "蜀锦谩夸声自贵，越绫虚说价犹高。",
        "可中用作鸳鸯被，红叶枝枝不碍刀。",
        "（见雍文华校本《罗隐集·甲乙集》，又见《四库全书》本《罗昭谏集》。",
        "）（按：《全唐诗》卷六五六收此诗，缺三字，今重录。",
        "雍文华所据为清张瓒瑞榴堂《罗昭谏集》。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 305731,
      "title": "咏柳",
      "content": [
        "袅袅和烟映玉楼，半垂桥上半垂流。",
        "今年渐见枝条密，恼乱春风卒未休。",
        "（见蜀何光远《鉴诫录》卷七《亡国音》。",
        "）（按：《全唐诗》卷六六三收隐《柳》诗，系据《甲乙集》卷九所录，与最早记载本诗的《鉴诫录》相较，有十三字不同。",
        "今重录。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 305732,
      "title": "过梁震居留题",
      "content": [
        "道院迎仙客，书堂隐相儒。",
        "庭栽栖凤竹，池养化龙鱼。",
        "（见《尧山堂外纪》卷三九、《全浙诗话》卷八。",
        "）（按：隐卒开平间，震至后康时始在荆南握重权。",
        "诗疑出伪托。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 305733,
      "title": "送灶诗",
      "content": [
        "一盏清茶一缕烟，灶君皇帝上青天。",
        "玉皇若问人间事，为道文章不值钱。",
        "（《坚瓠甲集》卷二。",
        "又见《全浙诗话》卷八。",
        "）（按：此篇似亦出后人附托。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 305734,
      "title": "下杜城",
      "content": [
        "来往城南十八年，赖家桥上潏河边。",
        "村醪香美脱衣典，几度落花相对眠。",
        "（《类编长安志》卷九。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 305735,
      "title": "华严寺",
      "content": [
        "华严[西]（而）转遶朱坡，每到春时日夕过。",
        "曾向姚家园里醉，牡丹红紫数千窠。",
        "（同前。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 305736,
      "title": "游北湖",
      "content": [
        "醒心亭下水涵天，吏部风流三百年。",
        "（见《舆地纪胜》卷五十七《郴州》。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 305737,
      "title": "凤凰台",
      "content": [
        "昔云丹穴凤，翔集高台端。",
        "（同前。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 305738,
      "title": "下第诗",
      "content": [
        "帘卷残阳鸣鸟鹊，花飞何处好楼台。",
        "（见明胡应麟《诗薮·内编》卷六。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 305739,
      "title": "句 一",
      "content": [
        "曹韩沙嘴团，铜陵出状元。",
        "（见影印天一阁藏本《嘉靖池州府志》卷一。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 305740,
      "title": "句 二",
      "content": [
        "饮水鱼心知冷暖，濯缨人足识炎凉。",
        "（《天都载》。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 305741,
      "title": "句 三",
      "content": [
        "桃李无言应笑我，二年尘土满渔航。",
        "（《五色线》。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 305742,
      "title": "句 四",
      "content": [
        "马上抱鸡鬬三市，袖中携剑五陵游。",
        "（《荛山堂》。",
        "以上六句均见明闵元衢《罗江东外纪》。",
        "）（按：自《下第诗》以降，皆据雍文华校点本《罗隐集》所辑佚句迻录。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 305743,
      "title": "句 五",
      "content": [
        "一列珠帘不下钩。",
        "（《后村千家诗》卷十六闻人祥正《集句》引。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 334326,
      "title": "乐府杂曲：鼓吹曲辞：芳树",
      "content": [
        "细蕊慢逐风，暖香闲破鼻。",
        "青帝固有心，时时动人意。",
        "去年高枝犹压地，今年低枝已憔悴。",
        "吾所以见造化之权，变通之理。",
        "春夏作头，秋冬为尾。",
        "回圈反复无穷已。",
        "今生长短同一轨，若使威可以制，",
        "伊人强猛犹如此，顾我劳生何足恃。",
        "但愿开素袍，"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 334361,
      "title": "横吹曲辞：陇头水",
      "content": [
        "借问陇头水，年年恨何事。",
        "全疑呜咽声，中有征人泪。",
        "自古无长策，况我非深智。",
        "何计谢潺湲，一宵空不寐。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 334459,
      "title": "相和歌辞：江南曲",
      "content": [
        "江烟湿雨鲛绡软，漠漠远山眉黛浅。",
        "水国多愁又有情，",
        "鸳鸯㶉𫛶唤不起，平铺渌水眠东风。",
        "西陵路边月悄悄，"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 334523,
      "title": "相和歌辞：铜雀台",
      "content": [
        "强歌强舞竟难胜，花落花开泪满缯。",
        "只合当年伴君死，免教憔悴望西陵。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 365647,
      "title": "曲江春感",
      "content": [
        "江头日暖花又开，江东行客心悠哉。",
        "高阳酒徒半凋落，",
        "一船明月一竿竹，家住五湖归去来。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365648,
      "title": "皇陂",
      "content": [
        "皇陂潋滟深复深，陂西下马聊登临。",
        "垂杨风轻弄翠带，",
        "输他谷口郑夫子，偷得闲名说至今。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365649,
      "title": "寄郑补阙",
      "content": [
        "夫子门前数仞墙，每经过处忆游梁。",
        "路从青琐无因见，",
        "别来愁悴知多少，两度槐花马上黄。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365650,
      "title": "牡丹花",
      "content": [
        "似共东风别有因，绛罗高卷不胜春。",
        "若教解语应倾国，",
        "可怜韩令功成后，辜负秾华过此身。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365651,
      "title": "黄河",
      "content": [
        "莫把阿胶向此倾，此中天意固难明。",
        "解通银汉应须曲，",
        "三千年后知谁在，何必劳君报太平。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365652,
      "title": "汴河",
      "content": [
        "当时天子是闲游，今日行人特地愁。",
        "柳色纵饶妆故国，",
        "应笑秦皇用心错，谩驱神鬼海东头。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365653,
      "title": "西京崇德里居",
      "content": [
        "进乏梯媒退又难，强随豪贵𣨼长安。",
        "风从昨夜吹银汉，",
        "锦鳞赪尾平生事，却被闲人把钓竿。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365654,
      "title": "投所思",
      "content": [
        "憔悴长安何所为，旅魂穷命自相疑。",
        "满川碧嶂无归日，",
        "浮生七十今三十，从此凄惶未可知。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365655,
      "title": "经张舍人旧居",
      "content": [
        "行尘不是昔时尘，谩向朱门忆侍臣。",
        "一榻已无开眼处，",
        "从此恩深转难报，夕阳衰草泪沾巾。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365656,
      "title": "雒城作",
      "content": [
        "大卤旌旗出洛滨，此中烟月已埃尘。",
        "更无楼阁寻行处，",
        "旧游难得时难遇，回首空城百草春。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365657,
      "title": "姑苏城南湖陪曹使君游",
      "content": [
        "水蓼花红稻穗黄，使君兰棹泛回塘。",
        "倚风荇藻先开路，",
        "少年太守勋庸盛，应笑燕台两鬓霜。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365658,
      "title": "秋日有寄姑苏曹使君",
      "content": [
        "多病无因棹小舟，阖闾城下谒名侯。",
        "水寒不见双鱼信，",
        "须知谢奕依前醉，闲阻清谈又一秋。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365659,
      "title": "送章碣赴举",
      "content": [
        "苹鹿歌中别酒催，粉闱星彩动昭回。",
        "久经罹乱心应破，",
        "龙门盛事无因见，费尽黄金老隗台。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365660,
      "title": "寄杨秘书",
      "content": [
        "湖水平来见鲤鱼，偶因烹处得琼琚。",
        "披寻藻思千重后，",
        "锦衣公子怜君在，十载兵戈从板舆。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365661,
      "title": "往年进士赵能卿尝话金庭胜事，见示叙",
      "content": [
        "会稽诗客赵能卿，往岁相逢话石城。",
        "正恨故人无上寿，",
        "两火一刀罹乱后，会须乘兴雪中行。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365662,
      "title": "得宣州窦尚书书因投寄二首",
      "content": [
        "双鱼迢递到江滨，伤感南陵旧主人。",
        "万里朝台劳寄梦，",
        "时见齐山敬亭客，不堪戎马战征频。",
        "曾逐旌旗过板桥，世途多难竟蓬飘。",
        "步兵校尉辞公府，",
        "遗簪堕履应留念，门客如今只下僚。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365663,
      "title": "雪",
      "content": [
        "细玉罗纹下碧霄，杜门颜巷落偏饶。",
        "巢居只恐高柯折，",
        "寒窗呵笔寻诗句，一片飞来纸上销。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365664,
      "title": "暇日有寄姑苏曹使君兼呈张郎中郡中宾僚",
      "content": [
        "嘉植阴阴覆剑池，此中能政动神祇。",
        "湖边观稼雨迎马，",
        "珊瑚笔架真珠履，曾和陈王几首诗。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365665,
      "title": "寄右省王谏议",
      "content": [
        "耳边要静不得静，心里欲闲终未闲。",
        "自是宿缘应有累，",
        "看却金庭芝术老，又驱车入七人班。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365667,
      "title": "始皇陵",
      "content": [
        "荒堆无草树无枝，懒向行人问昔时。",
        "六国英雄漫多事，到头徐福是男儿。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 365668,
      "title": "送沈先辈归送上嘉礼",
      "content": [
        "青青月桂触人香，白苎衫轻称沈郎。",
        "好继马卿归故里，",
        "拟把金钱赠嘉礼，不堪栖屑困名场。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365669,
      "title": "春日叶秀才曲江",
      "content": [
        "江花江草暖相隈，也向江边把酒杯。",
        "春色恼人遮不得，",
        "一曲吴歌齐拍手，十年尘眼未曾开。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365670,
      "title": "西京道德里",
      "content": [
        "秦树团团夕结阴，此中庄舄动悲吟。",
        "一枝丹桂未入手，",
        "七雄三杰今何在，休为闲人泪满襟。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365671,
      "title": "忆夏口",
      "content": [
        "汉阳渡口兰为舟，汉阳城下多酒楼。",
        "当年不得尽一醉，",
        "月明更想曾行处，吹笛桥边木叶秋。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365672,
      "title": "武牢关",
      "content": [
        "楚人曾此限封疆，不见清阴六里长。",
        "一壑暮声何怨望，",
        "欲学鸡鸣试关吏，太平时节懒思量。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365673,
      "title": "途中献晋州孟中丞",
      "content": [
        "太平天子念蒲东，又委星郎养育功。",
        "昨日隼旟辞阙下，",
        "不及政成应入拜，晋州何足展清通。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365674,
      "title": "长安秋夜",
      "content": [
        "远闻天子似羲皇，偶舍渔乡入帝乡。",
        "五等列侯无故旧，",
        "归计未知身已老，九衢双阙夜苍苍。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365675,
      "title": "春晚寄钟尚书",
      "content": [
        "宰府初开忝末尘，四年谈笑隔通津。",
        "官资肯便矜中路，",
        "如今莫问西禅坞，一炷寒香老病身。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365676,
      "title": "秋晓寄友人",
      "content": [
        "洞庭霜落水云秋，又泛轻涟任去留。",
        "世界高谈今已得，",
        "更见南来钓翁说，醉吟还上木兰舟。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365677,
      "title": "秋日有酬",
      "content": [
        "旧业传家有宝刀，近闻余力更挥毫。",
        "腰间印佩黄金重，",
        "分茅列土才三十，犹拟回头赌锦袍。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365678,
      "title": "所思",
      "content": [
        "梁王兔苑荆榛里，炀帝鸡台梦想中。",
        "只觉惘然悲谢傅，",
        "划尽寒灰始堪叹，满庭霜叶一窗风。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365679,
      "title": "送魏校书兼呈曹使君",
      "content": [
        "乱离无计驻生涯，又事东游惜岁华。",
        "村店酒旗沽竹叶，",
        "应见使君论世旧，扫门重得向曹家。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365683,
      "title": "香",
      "content": [
        "沈水良材食柏珍，博山烟暖玉楼春。",
        "怜君亦是无端物，贪作馨香忘却身。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 365684,
      "title": "邺城",
      "content": [
        "台上年年掩翠蛾，台前高树夹漳河。",
        "英雄亦到分香处，能共常人较几多。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 365685,
      "title": "七夕",
      "content": [
        "络角星河菡萏天，一家欢笑设红筵。",
        "应倾谢女珠玑箧，",
        "铜壶漏报天将晓，惆怅佳期又一年。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365686,
      "title": "送臧𣸣下第谒窦鄜州",
      "content": [
        "赋得长杨不直钱，却来京口看莺迁。",
        "也知绛灌轻才子，",
        "多情柱史应相问，与话归心正浩然。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365687,
      "title": "清明日曲江怀友",
      "content": [
        "君与田苏即旧游，我于交分亦绸缪。",
        "二年隔绝黄泉下，",
        "寡妻稚子应寒食，遥望江陵一泪流。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365688,
      "title": "送郑州严员外",
      "content": [
        "欲将刀笔润王猷，东去先分圣主忧。",
        "满扇好风吹郑圃，",
        "从此文星在何处，武牢关外庾公楼。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365689,
      "title": "孙员外赴阙后重到三衢",
      "content": [
        "远山高枝思悠哉，重倚危楼尽一杯。",
        "谢守已随征诏入，",
        "宣室夜阑如有问，可能全忘未然灰。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365690,
      "title": "衡阳泊木居士庙下作",
      "content": [
        "乌噪残阳草满庭，此中枯木似人形。",
        "只应神物长为主，",
        "南朝庾信无因赋，牢落祠前水气腥。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365691,
      "title": "钟陵见杨秀才",
      "content": [
        "孺亭滕阁少踟蹰，三度南游一事无。",
        "只觉流年如鸟逝，",
        "赖得与君同此醉，醒来愁被鬼揶揄。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365692,
      "title": "自湘川东下立春泊夏口阻风登孙权城",
      "content": [
        "吴门此去逾千里，湘浦离来想数旬。",
        "只见风师长占路，",
        "事往时移何足问，且凭村酒暖精神。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365693,
      "title": "春日忆湖南旧游寄卢校书",
      "content": [
        "旅榜前年过洞庭，曾提刀笔事甘宁。",
        "玳筵离隔将军幕，",
        "金貂见服嘉宾散，回首昭丘一涕零。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365694,
      "title": "贺淮南节度卢员外赐绯",
      "content": [
        "俭莲高贵九霄闻，粲粲朱衣降五云。",
        "骢马早年曾避路，",
        "应笑当年老莱子，鲜华都自降明君。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365695,
      "title": "春日独游禅智寺",
      "content": [
        "树远连天水接空，几年行乐旧隋宫。",
        "花开花谢还如此，",
        "思量只合腾腾醉，煮海平陈一梦中。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365696,
      "title": "和淮南李司空同转运员外",
      "content": [
        "层层高阁旧瀛洲，此地须征第一流。",
        "丞相近年萦倚望，",
        "谁继伊皋送行句，梁王诗好郢人愁。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365697,
      "title": "后土庙",
      "content": [
        "四海兵戈尚未宁，始于云外学仪形。",
        "九天玄女犹无圣，",
        "韦郎年少知何在，端坐思量太白经。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365698,
      "title": "金陵夜泊",
      "content": [
        "冷烟轻淡傍衰丛，此夕秦淮驻断蓬。",
        "栖雁远惊沽酒火，",
        "六代精灵人不见，思量应在月明中。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365699,
      "title": "上江州陈员外",
      "content": [
        "寒江九派转城楼，东下钟陵第一州。",
        "人自中台方贵盛，",
        "应恨属官无健令，异时佳节阻闲游。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365700,
      "title": "广陵开元寺阁上作",
      "content": [
        "满槛山川漾落晖，槛前前事去如飞。",
        "云中鸡犬刘安过，",
        "红楼翠幕知多少，长向东风有是非。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365701,
      "title": "上鄂州韦尚书",
      "content": [
        "往岁先皇驭九州，侍臣才业最风流。",
        "文穷典诰虽余力，",
        "都缘未负江山兴，开济生灵校一秋。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365702,
      "title": "早春巴陵道中",
      "content": [
        "远雪亭亭望未销，岳阳春浅似相饶。",
        "短芦冒土初生笋，",
        "中流菱唱泊何处，一只画船兰作桡。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365703,
      "title": "广陵秋日酬进士臧𣸣见寄",
      "content": [
        "驿西斜日满窗前，独凭秋栏思渺绵。",
        "数尺断蓬惭故国，",
        "空愧荀家好兄弟，雁来鱼去是因缘。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365704,
      "title": "淮南送李司空朝觐",
      "content": [
        "圣君宵旰望时雍，丹诏西来雨露浓。",
        "宣父道高休叹凤，",
        "腊后春前更何事，便看经度奏东封。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365705,
      "title": "秋日禅智寺见裴郎中题名寄韦瞻",
      "content": [
        "野寺疏钟万木秋，偶寻题处认名侯。",
        "官离南郡应闲暇，",
        "心知只有韦公在，更对真踪话旧游。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365706,
      "title": "广陵春日忆池阳有寄",
      "content": [
        "烟水蒙蒙接板桥，数年经历驻征桡。",
        "醉凭危槛波千顷，",
        "清流夹宅千家住，会待闲乘一信潮。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365707,
      "title": "春中湘中题岳麓寺僧舍",
      "content": [
        "蟾宫虎穴两皆休，来凭危栏送远愁。",
        "多事林莺还谩语，",
        "欲共高僧话心迹，野花芳草奈相尤。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365708,
      "title": "出试后投所知",
      "content": [
        "此日蓬壶两日程，当时消息甚分明。",
        "桃须曼倩催方熟，",
        "莫教更似山西鼠，啮破愁肠恨一生。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365709,
      "title": "湘南春日怀古",
      "content": [
        "晴江春暖兰蕙熏，凫鹥苒苒鸥著群。",
        "洛阳贾谊自无命，",
        "松醪酒好昭潭静，闲过中流一吊君。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365710,
      "title": "江州望庐山",
      "content": [
        "东南苍翠何崔嵬，横流一望幽抱开。",
        "影寒已令水底去，",
        "仙人往往今谁在，红杏花香重首回。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365711,
      "title": "金陵寄窦尚书",
      "content": [
        "二年岐路有西东，长忆优游楚驿中。",
        "虎帐谈高无客继，",
        "此去此恩言不得，谩将闲泪对春风。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365712,
      "title": "清溪江令公宅",
      "content": [
        "蛮笺象管夜深时，曾赋陈宫第一诗。",
        "宴罢风流人不见，",
        "还有往年金甃井，牧童樵叟等闲窥。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365713,
      "title": "郑州献卢舍人",
      "content": [
        "海槎闲暇阆风轻，不是安流不肯行。",
        "鸡省露浓汤饼熟，",
        "会待两都收复后，右图仪表左题名。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365714,
      "title": "别池阳所居",
      "content": [
        "黄尘初起此留连，火耨刀耕六七年。",
        "雨夜老农伤水旱，",
        "却是九华山有意，列行相送到江边。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365715,
      "title": "送内使周大夫自杭州朝贡",
      "content": [
        "八都上将近平戎，便附輶轩奏圣聪。",
        "三接驾前朝觐礼，",
        "知有殿庭余力在，莫辞消息寄西风。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365716,
      "title": "酬黄从事怀旧见寄",
      "content": [
        "旧游不合到心中，把得君诗意亦同。",
        "水馆酒阑清夜月，",
        "世事自随蓬转在，思量何处是飞蓬。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365717,
      "title": "绣",
      "content": [
        "一片丝罗□□□，洞房西室女工劳。",
        "花随玉指添春色，",
        "可中用作鸳鸯被，红叶枝枝不碍刀。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365720,
      "title": "白角篦",
      "content": [
        "白似琼瑶滑似苔，随梳伴镜拂尘埃。",
        "莫言此个尖头物，几度撩人恶发来。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 365721,
      "title": "铜雀台",
      "content": [
        "强歌强舞竟难胜，花落花开泪满膺。",
        "只合当年伴君死，免交憔悴望西陵。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 365725,
      "title": "钱尚父生日",
      "content": [
        "大昴分光降斗牛，兴唐宗社作诸侯。",
        "伊夔事业扶千载，",
        "锦衣玉食将何报，更俟庄椿一举头。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365726,
      "title": "寄前户部陆郎中",
      "content": [
        "出驯桑雉入朝簪，箫洒清名映士林。",
        "近日篇章欺白雪，",
        "离乱事多人不会，酒浓花暖且闲吟。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365727,
      "title": "登瓦棺寺阁",
      "content": [
        "下盘空迹上云浮，偶逐僧行步步愁。",
        "暂憩已知须用意，",
        "懒指台城更东望，鹊飞龙斗尽荒丘。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365728,
      "title": "九华山费征君所居",
      "content": [
        "草堂何处试徘徊，见说遗踪向此开。",
        "蟾桂自归三径后，",
        "尽夕为君思曩日，野泉呜咽路莓苔。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365729,
      "title": "途中寄怀",
      "content": [
        "不知何处是前程，合眼腾腾信马行。",
        "两鬓已衰时未遇，",
        "试哭军门看谁问，旧来还似祢先生。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365730,
      "title": "京口见李侍郎",
      "content": [
        "傞傞江柳欲矜春，铁瓮城边见故人。",
        "屈指不堪言甲子，",
        "还有杖头沽酒物，待寻山寺话逡巡。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365731,
      "title": "秋日酬张特玄",
      "content": [
        "病寄南徐两度秋，故人依约亦扬州。",
        "偶因雁足思闲事，",
        "平生意气消磨尽，甘露轩前看水流。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365732,
      "title": "登高咏菊尽",
      "content": [
        "篱畔霜前偶得存，苦教迟晚避兰荪。",
        "能销造化几多力，",
        "陶公没后无知己，露滴幽丛见泪痕。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365733,
      "title": "登夏州城楼",
      "content": [
        "寒城猎猎戍旗风，独倚危楼怅望中。",
        "万里山河唐土地，",
        "好脱儒冠从校尉，一枝长戟六钧弓。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365734,
      "title": "水边偶题",
      "content": [
        "野水无情去不回，水边花好为谁开。",
        "只知事逐眼前去，",
        "思量此理何人会，蒙邑先生最有才。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365735,
      "title": "故洛阳公镇大梁时隐得游门下今之经历事往人非聊抒所怀以伤以谢",
      "content": [
        "孤舟欲泊思何穷，曾忆西来值雪中。",
        "珠履少年初满座，",
        "今日斯文向谁说，泪碑棠树两成空。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365736,
      "title": "杜陵秋思",
      "content": [
        "南望商于北帝都，两堪栖托两无图。",
        "只闻斥逐张公子，",
        "一杯渌酒他年忆，沥向清波寄五湖。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 365737,
      "title": "隐尝在江陵忝故中令白公叨蒙知遇今复重过渚宫感事悲身遂成长句",
      "content": [
        "往岁酂侯镇渚宫，曾将清律暖孤蓬。",
        "才怜曼倩三冬后，",
        "凤凰池涸台星拆，回首岐山忆至公。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    }
  ],
