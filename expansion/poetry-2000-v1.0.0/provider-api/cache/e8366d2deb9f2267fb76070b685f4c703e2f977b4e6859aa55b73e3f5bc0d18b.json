{
  "data": [
    {
      "id": 45192,
      "title": "题萧岳英常州草虫轴盖画师之女朱氏之笔二首  其二",
      "content": [
        "笔端春草已如生，点缀虫沙更未停。",
        "浅著鹅黄作蝴蝶，深将猩血染蜻蜓。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45193,
      "title": "过双陂",
      "content": [
        "霜后寒溪清更清，冰如溪水水如冰。",
        "闲行也有穷忙事，问讯梅花开未曾。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45194,
      "title": "夜宿王才臣斋中睡觉闻风雪大作",
      "content": [
        "雨外风非细，风中雪更飞。",
        "夜声吹不尽，寒客卧相依。",
        "一醉醒醒了，平生事事非。",
        "终年才小款，明日又言归。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 45195,
      "title": "和罗巨济山居十咏  其一",
      "content": [
        "世方争速化，渠独请真祠。",
        "意在升沉外，官无冷热宜。",
        "山如辋川画，地似习家池。",
        "若道闲居嬾，如何有十诗。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 45196,
      "title": "和罗巨济山居十咏  其二",
      "content": [
        "老子朝慵起，春风苦唤行。",
        "晴边犹著雪，寒后未闻鶑。",
        "偶见千峰翠，偏令两眼明。",
        "倦来浑欲睡，无处避溪声。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 45197,
      "title": "和罗巨济山居十咏  其三",
      "content": [
        "只拥书千卷，何须屋万间。",
        "新堂傍溪水，大字署蓬山。",
        "恰有乘风客，来分半日闲。",
        "自煎虾蟹眼，同瀹鹧鸪斑。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 45198,
      "title": "和罗巨济山居十咏  其四",
      "content": [
        "漫浪真堪老，丁宁勿语人。",
        "屐痕浑似齿，巾角小于纶。",
        "从事固不恶，贤人也似醇。",
        "空瓶未应卧，只恐恼比邻。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 45199,
      "title": "和罗巨济山居十咏  其五",
      "content": [
        "园花皆手植，梅蕊独禁寒。",
        "色与香无价，飞和雪作团。",
        "数枝横翠竹，一夜遶朱栏。",
        "不惜吟边苦，收将句里看。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 45200,
      "title": "和罗巨济山居十咏  其六",
      "content": [
        "花柳春全盛，池塘燕学飞。",
        "晚晴还小立，暮色不能归。",
        "草远天无壁，苔深水有衣。",
        "山居自清绝，不必扣禅扉。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 45201,
      "title": "和罗巨济山居十咏  其七",
      "content": [
        "酒客来中散，诗僧约惠勤。",
        "共听茅屋雨，添炷博山云。",
        "万事休多问，三杯且一醺。",
        "君看醉中语，不琢自成文。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 45202,
      "title": "和罗巨济山居十咏  其八",
      "content": [
        "秀溪何处好，腊尾与春初。",
        "山色梅边浄，人家竹里居。",
        "先生来得得，一笑意舒舒。",
        "归路无灯火，冰轮挂岭隅。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 45203,
      "title": "和罗巨济山居十咏  其九",
      "content": [
        "且爱灯檠短，宁论剑铗长。",
        "芝兰照春紫，编简著人香。",
        "贺监聊吴语，昌黎岂楚狂。",
        "豹文元炳蔚，未信雾能藏。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 45204,
      "title": "和罗巨济山居十咏  其一○",
      "content": [
        "眼底无群子，毫端有百川。",
        "修名如揭月，余事亦凌烟。",
        "剩欲携藤去，相从听雨眠。",
        "恐渠即霄汉，泉石罢潺湲。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 45205,
      "title": "赵通判恭人周氏挽辞",
      "content": [
        "早与梁鸿隠，中随士会归。",
        "一门忠义气，千古日星晖。",
        "紫告金花诏，青灯锦字机。",
        "西峰今夜月，坟是昔人非。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 45206,
      "title": "老眼废书有叹",
      "content": [
        "老矣书无分，居然眼有花。",
        "墨兵非死友，陆谞且生涯。",
        "雪后霜逾劲，吟边帽只斜。",
        "小儿知我嬾，夜诵故喧哗。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 45207,
      "title": "过蕉坑",
      "content": [
        "枫叶干余尚小红，苕花飞尽不留茸。",
        "经旬欲雪还无雪，只作清寒恼杀侬。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45208,
      "title": "和九叔知县昨游长句",
      "content": [
        "诗穷不但两鬓霜，白发缘愁千丈长。",
        "一年强半走道路，归来又见橘柚黄。",
        "不如南邻更此里，醉折梅花照溪水。",
        "扶藜时蹑大阮踪，觅句深参少陵髓。",
        "昨游过眼不可留，今朝欲再亦何由。",
        "新诗已落万人口，不应更著锦囊收。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 45209,
      "title": "送王无咎善邵康节皇极数二首  其一",
      "content": [
        "安乐窝中书一编，君从何许得真传。",
        "我无杜曲桑麻在，也道此生休问天。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45210,
      "title": "送王无咎善邵康节皇极数二首  其二",
      "content": [
        "识尽江淮诸贵人，归来卢水一番新。",
        "问渠福将今谁子，容我升平作幸民。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45211,
      "title": "看雪",
      "content": [
        "揉云剪水作风毬，夜落连明肯便休。",
        "旧说六花元未试，偶看一片上驼裘。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45212,
      "title": "送曾秀才归永丰",
      "content": [
        "白白茅柴强作春，青青灯火夜相亲。",
        "超然似子真翘楚，旧矣逢人诵过秦。",
        "觅举不应专嗜古，能文安得却嫌贫。",
        "射科速化谁无术，误向南溪更问津。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 45213,
      "title": "寄题邹公桥",
      "content": [
        "吾侪一事办不曾，邹公一桥了此生。",
        "省斋先生三大字，此桥便有千载意。",
        "今年天亦与护持，桃花春水不多肥。",
        "济川题柱吾无梦，梦借新桥作钓矶。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 45214,
      "title": "赠曾相士二首  其一",
      "content": [
        "富贵真成一聚尘，饥寒选得万年名。",
        "心知那有扬州鹤，更问侬当作么生。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45215,
      "title": "赠曾相士二首  其二",
      "content": [
        "抛了儒书读相书，却将冷眼看诸儒。",
        "曾生肯伴诚斋否，共个渔舟入五湖。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45216,
      "title": "题萧端虚和乐堂",
      "content": [
        "玉笥风回峡山雨，两公对床方软语。",
        "少公一生吟样臞，长公半醉少公扶。",
        "白头兄弟不多有，面如橘红不关酒。",
        "紫荆花开连理枝，孝友未要时人知。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 45217,
      "title": "昌英知县叔作岁坐上赋瓶里梅花时坐上九人七首  其一",
      "content": [
        "销冰作水旋成家，犹似江头竹外斜。",
        "试问坐中还几客，九人而已更梅花。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45218,
      "title": "昌英知县叔作岁坐上赋瓶里梅花时坐上九人七首  其二",
      "content": [
        "胆样银瓶玉样梅，北枝折得未全开。",
        "为怜落莫空山里，唤入诗人几案来。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45219,
      "title": "昌英知县叔作岁坐上赋瓶里梅花时坐上九人七首  其三",
      "content": [
        "酒兵半已卧长瓶，更看梅兄巧尽情。",
        "醉插寒花望松雪，人间曾有个般清。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45220,
      "title": "昌英知县叔作岁坐上赋瓶里梅花时坐上九人七首  其四",
      "content": [
        "寒尽春生夜未央，酒狂狂似醒时狂。",
        "吾人何用餐烟火，揉碎梅花和蜜霜。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45221,
      "title": "昌英知县叔作岁坐上赋瓶里梅花时坐上九人七首  其五",
      "content": [
        "衣染龙涎与麝脐，裁云剪月作冰肌。",
        "小瓶雪水无多子，只𥮾横斜一两枝。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45222,
      "title": "昌英知县叔作岁坐上赋瓶里梅花时坐上九人七首  其六",
      "content": [
        "雪冻霜封稍欲残，殷勤折向坐中看。",
        "绮疎深闭珠帘密，不遣花愁半点寒。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45223,
      "title": "昌英知县叔作岁坐上赋瓶里梅花时坐上九人七首  其七",
      "content": [
        "梅香不是不寒清，参遍横枝酒未醒。",
        "梦入西湖疎影里，觉来失却冷泉亭。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45224,
      "title": "戊子正月六日雷雨感叹示寿仁子",
      "content": [
        "今晨忽雷雨，天地又发春。",
        "草木閟红绿，生意察已欣。",
        "蛰虫且徐动，余寒未全仁。",
        "先生起裹头，三叹一再颦。",
        "春风吹万物，不吹先生贫。",
        "靖怨一束书，只博两袴尘。",
        "自倚文字工，竟取造物嗔。",
        "小儿在傍笑，笑我浪苦辛。",
        "去年作客子，椒柏羡主人。",
        "在家不差胜，更用愁此身。",
        "先生亦一莞，我不如儿真。",
        "为我满眼酤，不问醨与醇。",
        "杖头日百钱，无钱借诸隣。",
        "不然衣可典，及此花柳新。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
