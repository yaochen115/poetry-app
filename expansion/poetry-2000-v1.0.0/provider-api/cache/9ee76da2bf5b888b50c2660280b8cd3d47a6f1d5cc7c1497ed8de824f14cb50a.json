{
  "data": [
    {
      "id": 361907,
      "title": "和沈参军招友生观芙蓉池",
      "content": [
        "桂栋坐清晓，瑶琴商凤丝。",
        "况闻楚泽香，适与秋风期。",
        "遂从棹萍客，静啸烟草湄。",
        "倒影回澹荡，愁红媚涟漪。",
        "湘茎久鲜涩，宿雨增离披。",
        "而我江海意，楚游动梦思。",
        "北渚水云叶，南塘烟雾枝。",
        "岂亡台榭芳，独与鸥鸟知。",
        "珠坠鱼迸浅，影多凫泛迟。",
        "落英不可攀，返照昏澄陂。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361908,
      "title": "寓怀",
      "content": [
        "诚足不顾得，妄矜徒有言。",
        "语斯谅未尽，隐显何悠然。",
        "洵彼都邑盛，眷惟车马喧。",
        "自期尊客卿，非意干王孙。",
        "衔知有贞爵，处实非厚颜。",
        "苟无海岱气，奚取壶浆恩。",
        "唯丝南山杨，适我松菊香。",
        "鹏鶤诚未忆，谁谓凌风翔。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361909,
      "title": "余昔自西滨得兰数本，移艺于庭，亦既逾岁，而芃然蕃殖，自余游者未始以芳草为遇矣。因悲夫物有厌常而反，不若混然者有之焉，遂寄情于此",
      "content": [
        "寓赏本殊致，意幽非我情。",
        "吾常有流浅，外物无重轻。",
        "各言艺幽深，彼美香素茎。",
        "岂为赏者设，自保孤根生。",
        "易地无赤株，丽土亦同荣。",
        "赏际林壑近，泛余烟露清。",
        "余怀既郁陶，尔类徒纵横。",
        "妍蚩苟不信，宠辱何为惊。",
        "贞隐谅无迹，激时犹拣名。",
        "幽丛霭绿畹，岂必怀归耕。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361910,
      "title": "秋日",
      "content": [
        "爽气变昏旦，神皋遍原隰。",
        "烟华久荡摇，石涧仍清急。",
        "柳暗山犬吠，蒲荒水禽立。",
        "菊花明欲迷，枣叶光如湿。",
        "天籁思林岭，车尘倦都邑。",
        "诪张夙所违，悔吝何由入。",
        "芳草秋可藉，幽泉晓堪汲。",
        "牧羊烧外鸣，林果雨中拾。",
        "复此遂闲旷，翛然脱羁絷。",
        "田收鸟雀喧，气肃龙蛇蛰。",
        "佳节足丰穰，良朋阻游集。",
        "沉机日寂寥，葆素常呼吸。",
        "投迹倦攸往，放怀志所执。",
        "良时有东菑，吾将事蓑笠。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361911,
      "title": "七夕",
      "content": [
        "鸣机劄劄停金梭，芙蓉澹荡生池波。",
        "神轩红粉陈香罗，",
        "弯桥销尽愁奈何，天气骀荡云陂阤。",
        "平明花木有秋意，"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361912,
      "title": "酬友人",
      "content": [
        "辞荣亦素尚，倦游非夙心。",
        "宁复思金籍，独此卧烟林。",
        "闲云无定貌，佳树有余阴。",
        "坐久芰荷发，钓阑茭苇深。",
        "游鱼自摇漾，浴鸟故浮沉。",
        "唯君清露夕，一为洒烦襟。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361915,
      "title": "经西坞偶题",
      "content": [
        "摇摇弱柳黄鹂啼，芳草无情人自迷。",
        "日影明灭金色鲤，",
        "借问含嚬向何事，昔年曾到武陵溪。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361917,
      "title": "侠客行",
      "content": [
        "欲出鸿都门，阴云蔽城阙。",
        "宝剑黯如水，微红湿余血。",
        "白马夜频惊，三更霸陵雪。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 361918,
      "title": "咏晓",
      "content": [
        "虫歇纱窗静，鸦散碧梧寒。",
        "稍惊朝佩动，犹传清漏残。",
        "乱珠凝烛泪，微红上露盘。",
        "褰衣复理鬓，余润拂芝兰。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 361919,
      "title": "芙蓉",
      "content": [
        "剌茎澹荡碧，花片参差红。",
        "吴歌秋水冷，湘庙夜云空。",
        "浓艳香露里，美人青镜中。",
        "南楼未归客，一夕练塘东。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 361920,
      "title": "敕勒歌塞北",
      "content": [
        "敕勒金fj壁，阴山无岁华。",
        "帐外风飘雪，营前月照沙。",
        "羌儿吹玉管，胡姬踏锦花。",
        "却笑江南客，梅落不归家。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361928,
      "title": "咏嚬",
      "content": [
        "毛羽敛愁翠，黛娇攒艳春。",
        "恨容偏落泪，低态定思人。",
        "枕上梦随月，扇边歌绕尘。",
        "玉钩鸾不住，波浅石磷磷。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 361929,
      "title": "中书令裴公挽歌词二首",
      "content": [
        "王俭风华首，萧何社稷臣。",
        "丹阳布衣客，莲渚白头人。",
        "铭勒燕山暮，碑沉汉水春。",
        "从今虚醉饱，无复污车茵。",
        "箭下妖星落，风前杀气回。",
        "国香荀令去，楼月庾公来。",
        "玉玺终无虑，金縢意不开。",
        "空嗟荐贤路，芳草满燕台。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361930,
      "title": "唐庄恪太子挽歌词二首",
      "content": [
        "叠鼓辞宫殿，悲笳降杳冥。",
        "影离云外日，光灭火前星。",
        "邺客瞻秦苑，商公下汉庭。",
        "依依陵树色，空绕古原青。",
        "东府虚容卫，西园寄梦思。",
        "凤悬吹曲夜，鸡断问安时。",
        "尘陌都人恨，霜郊赗马悲。",
        "唯余埋璧地，烟草近丹墀。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361931,
      "title": "秘书刘尚书挽歌词二首",
      "content": [
        "王笔活鸾凤，谢诗生芙蓉。",
        "学筵开绛帐，谈柄发洪钟。",
        "粉署见飞𫛳，玉山猜卧龙。",
        "遗风丽清韵，萧散九原松。",
        "麈尾近良玉，鹤裘吹素丝。",
        "坏陵殷浩谪，春墅谢安棋。",
        "京口贵公子，襄阳诸女儿。",
        "折花兼踏月，多唱柳郎词。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361932,
      "title": "太子西池二首",
      "content": [
        "梨花雪压枝，莺啭柳如丝。",
        "懒逐妆成晓，春融梦觉迟。",
        "鬓轻全作影，嚬浅未成眉。",
        "莫信张公子，窗间断暗期。",
        "花红兰紫茎，愁草雨新晴。",
        "柳占三春色，莺偷百鸟声。",
        "日长嫌辇重，风暖觉衣轻。",
        "薄暮香尘起，长杨落照明。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361933,
      "title": "西陵道士茶歌",
      "content": [
        "乳窦溅溅通石脉，绿尘愁草春江色。",
        "涧花入井水味香，",
        "疏香皓齿有余味，更觉鹤心通杳冥。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361934,
      "title": "过西堡塞北",
      "content": [
        "浅草干河阔，丛棘废城高。",
        "白马犀匕首，黑裘金佩刀。",
        "霜清澈兔目，风急吹雕毛。",
        "一经何用厄，日暮涕沾袍。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 361935,
      "title": "送李亿东归",
      "content": [
        "黄山远隔秦树，紫禁斜通渭城。",
        "别路青青柳弱，",
        "灞上金樽未饮，宴歌已有余声。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361936,
      "title": "开圣寺",
      "content": [
        "路分溪石夹烟丛，十里萧萧古树风。",
        "出寺马嘶秋色里，",
        "犹有南朝旧碑在，耻将兴废问休公。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361937,
      "title": "赠蜀府将",
      "content": [
        "十年分散剑关秋，万事皆随锦水流。",
        "志气已曾明汉节，",
        "今日逢君倍惆怅，灌婴韩信尽封侯。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361938,
      "title": "西江贻钓叟骞生",
      "content": [
        "晴江如镜月如钩，泛滟苍茫送客愁。",
        "衣泪潜生竹枝曲，",
        "昨日欢娱竟何在，一枝梅谢楚江头。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361939,
      "title": "寄清源寺僧",
      "content": [
        "石路无尘竹径开，昔年曾伴戴颙来。",
        "窗间半偈闻钟后，",
        "白莲社里如相问，为说游人是姓雷。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361940,
      "title": "重游圭峰宗密禅师精庐",
      "content": [
        "百尺青崖三尺坟，微言已绝杳难闻。",
        "戴颙今日称居士，",
        "故山弟子空回首，葱岭唯应见宋云。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361941,
      "title": "题李处士幽居",
      "content": [
        "水玉簪头白角巾，瑶琴寂历拂轻尘。",
        "浓阴似帐红薇晚，",
        "南山自是忘年友，谷口徒称郑子真。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361942,
      "title": "利州南渡",
      "content": [
        "澹然空水对斜晖，曲岛苍茫接翠微，波上马嘶看棹去，",
        "谁解乘舟寻范蠡，五湖烟水独忘机。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361943,
      "title": "赠李将军",
      "content": [
        "谁言荀羡爱功勋，年少登坛众所闻。",
        "曾以能书称内史，",
        "不学龙骧画山水，醉乡无迹似闲云。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361944,
      "title": "寒食日作",
      "content": [
        "红深绿暗径相交，抱暖含芳披紫袍。",
        "彩索平时墙婉娩，",
        "自有玉楼春意在，不能骑马度烟郊。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361945,
      "title": "李羽处士寄新酝走笔戏酬",
      "content": [
        "高谈有伴还成薮，沉醉无期即是乡。",
        "已恨流莺欺谢客，",
        "所恨玳筵红烛夜，草玄寥落近回塘。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361946,
      "title": "郊居秋日有怀一二知己",
      "content": [
        "稻田凫雁满晴沙，钓渚归来一径斜。",
        "门带果林招邑吏，",
        "自笑谩怀经济策，不将心事许烟霞。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361947,
      "title": "题友人池亭",
      "content": [
        "月榭风亭绕曲池，粉垣回互瓦参差。",
        "侵帘片白摇翻影，",
        "山翁醉后如相忆，羽扇清樽我自知。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361948,
      "title": "南湖",
      "content": [
        "湖上微风入槛凉，翻翻菱荇满回塘。",
        "野船著岸偎春草，",
        "飘然篷艇东归客，尽日相看忆楚乡。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361949,
      "title": "赠袁司录",
      "content": [
        "一朝辞满有心期，花发杨园雪压枝。",
        "刘尹故人谙往事，",
        "记得襄阳耆旧语，不堪风景岘山碑。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361950,
      "title": "题西明寺僧院",
      "content": [
        "曾识匡山远法师，低松片石对前墀。",
        "为寻名画来过院，",
        "自知终有张华识，不向沧洲理钓丝。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361951,
      "title": "偶题",
      "content": [
        "微风和暖日鲜明，草色迷人向渭城。",
        "吴客卷帘闲不语，",
        "自恨青楼无近信，不将心事许卿卿。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361952,
      "title": "寄湘阴阎少府乞钓轮子",
      "content": [
        "钓轮形与月轮同，独茧和烟影似空。",
        "若向三湘逢雁信，",
        "终日垂钩还有意，尺书多在锦鳞中。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361953,
      "title": "哭王元裕",
      "content": [
        "闻说萧郎逐逝川，伯牙因此绝清弦。",
        "柳边犹忆青骢影，",
        "他时若到相寻处，碧树红楼自宛然。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361954,
      "title": "法云寺双桧",
      "content": [
        "晋朝名辈此离群，想对浓阴去住分。",
        "题处尚寻王内史，",
        "一下南台到人世，晓泉清籁更难闻。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361955,
      "title": "送陈嘏之侯官兼简李常侍",
      "content": [
        "纵得步兵无绿蚁，不缘句漏有丹砂。",
        "殷勤为报同袍友，",
        "梅仙自是青云客，莫羡相如却到家。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361956,
      "title": "春日野行",
      "content": [
        "雨涨西塘金堤斜，碧草芊芊晴吐芽。",
        "野岸明媚山芍药，",
        "何事轻桡句溪客，绿萍方好不归家。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361957,
      "title": "溪上行",
      "content": [
        "绿塘漾漾烟蒙蒙，张翰此来情不穷。",
        "雪羽褵褷立倒影，",
        "心羡夕阳波上客，片时归梦钓船中。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361958,
      "title": "投翰林萧舍人",
      "content": [
        "人间鹓鹭杳难从，独恨金扉直九重。",
        "万象晚归仁寿镜，",
        "每过朱门爱庭树，一枝何日许相容。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361959,
      "title": "春日偶作",
      "content": [
        "西园一曲艳阳歌，扰扰车尘负薜萝。",
        "自欲放怀犹未得，",
        "钓渚别来应更好，春风还为起微波。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361960,
      "title": "春暮宴罢寄宋寿先辈",
      "content": [
        "斜掩朱门花外钟，晓莺时节好相逢。",
        "窗间桃蕊宿妆在，",
        "谁怜芳草生三径，参佐桥西陆士龙。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361961,
      "title": "马嵬驿",
      "content": [
        "穆满曾为物外游，六龙经此暂淹留。",
        "返魂无验青烟灭，",
        "甘泉不复重相见，谁道文成是故侯。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361962,
      "title": "和道溪君别业",
      "content": [
        "积润初销碧草新，凤阳晴日带雕轮。",
        "风飘弱柳平桥晚，",
        "花房透露红珠落，蛱蝶双飞护粉尘。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361963,
      "title": "奉天西佛寺",
      "content": [
        "忆昔狂童犯顺年，玉虬闲暇出甘泉。",
        "宗臣欲舞千钧剑，",
        "至今南顿诸耆旧，犹指榛芜作弄田。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361964,
      "title": "题望苑驿",
      "content": [
        "弱柳千条杏一枝，半含春雨半垂丝。",
        "景阳寒井人难到，",
        "分明十二楼前月，不向西陵照盛姬。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361965,
      "title": "寄分司元庶子兼呈元处士",
      "content": [
        "闭门高卧莫长嗟，水木凝晖属谢家。",
        "缑岭参差残晓雪，",
        "月榭知君还怅望，碧霄烟阔雁行斜。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361966,
      "title": "题柳",
      "content": [
        "杨柳千条拂面丝，绿烟金穗不胜吹。",
        "香随静婉歌尘起，",
        "千门九陌花如雪，飞过宫墙两自知。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361967,
      "title": "和友人悼亡",
      "content": [
        "玉貌潘郎泪满衣，画罗轻鬓雨霏微。",
        "红兰委露愁难尽，",
        "春来多少伤心事，碧草侵阶粉蝶飞。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361968,
      "title": "李羽处士故里",
      "content": [
        "柳不成丝草带烟，海槎东去鹤归天。",
        "愁肠断处春何限，",
        "终知此恨销难尽，辜负南华第一篇。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361969,
      "title": "却经商山寄昔同行人",
      "content": [
        "曾道逍遥第一篇，尔来无处不恬然。",
        "便同南郭能忘象，"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361970,
      "title": "池塘七夕",
      "content": [
        "月出西南露气秋，绮罗河汉在斜沟。",
        "杨家绣作鸳鸯幔，",
        "万家砧杵三篙水，一夕横塘似旧游。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361971,
      "title": "偶游",
      "content": [
        "曲巷斜临一水间，小门终日不开关。",
        "红珠斗帐樱桃熟，",
        "与君便是鸳鸯侣，休向人间觅往还。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361972,
      "title": "寄河南杜少尹",
      "content": [
        "十载归来鬓未凋，玳簪珠履见常僚。",
        "岂关名利分荣路，",
        "夕阳亭畔山如画，应念田歌正寂寥。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361973,
      "title": "赠知音",
      "content": [
        "翠羽花冠碧树鸡，未明先向短墙啼。",
        "窗间谢女青蛾敛，",
        "景阳宫里钟初动，不语垂鞭上柳堤。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361974,
      "title": "过陈琳墓",
      "content": [
        "曾于青史见遗文，今日飘蓬过古坟。",
        "词客有灵应识我，",
        "莫怪临风倍惆怅，欲将书剑学从军。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361975,
      "title": "题崔公池亭旧游",
      "content": [
        "皎镜方塘菡萏秋，此来重见采莲舟。",
        "谁能不逐当年乐，",
        "簷前依旧青山色，尽日无人独上楼。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361976,
      "title": "回中作",
      "content": [
        "苍莽寒空远色愁，呜呜戍角上高楼。",
        "吴姬怨思吹双管，",
        "夜来霜重西风起，陇水无声冻不流。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361977,
      "title": "西江上送渔父",
      "content": [
        "却逐严光向若耶，钓轮菱棹寄年华。",
        "三秋梅雨愁枫叶，",
        "白苹风起楼船暮，江燕双双五两斜。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361978,
      "title": "经故秘书崔监扬州南塘旧居",
      "content": [
        "昔年曾识范安成，松竹风姿鹤性情。",
        "西掖曙河横漏响，",
        "千顷水流通故墅，至今留得谢公名。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361979,
      "title": "七夕",
      "content": [
        "鹊归燕去两悠悠，青琐西南月似钩。",
        "天上岁时星右转，",
        "苏小横塘通桂楫，未应清浅隔牵牛。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361980,
      "title": "题韦筹博士草堂",
      "content": [
        "玄晏先生已白头，不随鹓鹭狎群鸥。",
        "元卿谢免开三径，",
        "沧浪未濯尘缨在，野水无情处处流。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361981,
      "title": "和友人题壁",
      "content": [
        "冲尚犹来出范围，肯将经世作风徽。",
        "三台位缺严陵卧，",
        "西州未有看棋暇，涧户何由得掩扉。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361982,
      "title": "春日将欲东归寄新及第苗绅先辈",
      "content": [
        "几年辛苦与君同，得丧悲欢尽是空。",
        "犹喜故人先折桂，",
        "知有杏园无路入，马前惆怅满枝红。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361983,
      "title": "经李征君故居",
      "content": [
        "露浓烟重草萋萋，树映阑干柳拂堤。",
        "一院落花无客醉，",
        "惆怅羸骖往来惯，每经门巷亦长嘶。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361984,
      "title": "送崔郎中赴幕",
      "content": [
        "一别黔巫似断弦，故交东去更凄然。",
        "心游目送三千里，",
        "相思休话长安远，江月随人处处圆。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361985,
      "title": "经旧游",
      "content": [
        "珠箔金钩对彩桥，昔年于此见娇娆。",
        "香灯怅望飞琼鬓，",
        "坏墙经雨苍苔遍，拾得当时旧翠翘。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361986,
      "title": "老君庙",
      "content": [
        "紫气氤氲捧半岩，莲峰仙掌共巉巉。",
        "庙前晚色连寒水，",
        "自怜金骨无人识，知有飞龟在石函。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361987,
      "title": "过五丈原",
      "content": [
        "铁马云雕久绝尘，柳阴高压汉营春。",
        "天晴杀气屯关右，",
        "象床锦帐无言语，从此谯周是老臣。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361988,
      "title": "和友人伤歌姬",
      "content": [
        "月缺花残莫怆然，花须终发月终圆。",
        "更能何事销芳念，",
        "王孙莫学多情客，自古多情损少年。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361989,
      "title": "山中与诸道友夜坐闻边防不宁因示同志",
      "content": [
        "龙砂铁马犯烟尘，迹近群鸥意倍亲。",
        "风卷蓬根屯戊己，",
        "心许故人知此意，古来知者竟谁人。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361990,
      "title": "秘书省有贺监知章草题诗笔力遒健风尚高远拂尘寻玩因有此作",
      "content": [
        "越溪渔客贺知章，任达怜才爱酒狂。",
        "㶉𫛶苇花随钓艇，",
        "荣路脱身终自得，福庭回首莫相忘。",
        "出笼鸾鹤归辽海，"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361991,
      "title": "题裴晋公林亭",
      "content": [
        "谢傅林亭暑气微，山丘零落閟音徽。",
        "东山终为苍生起，",
        "悠然到此忘情处，一日何妨有万几。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361995,
      "title": "赠郑征君家匡山首春与丞相赞皇公游止",
      "content": [
        "一抛兰棹逐燕鸿，曾向江湖识谢公。",
        "每到朱门还怅望，故山多在画屏中。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 361998,
      "title": "题李相公敕赐锦屏风",
      "content": [
        "丰沛曾为社稷臣，赐书名画墨犹新。",
        "几人同保山河誓，犹自栖栖九陌尘。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 362002,
      "title": "寄裴生乞钓钩",
      "content": [
        "一随菱棹谒王侯，深愧移文负钓舟。",
        "今日太湖风色好，却将诗句乞鱼钩。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 362003,
      "title": "长安春晚二首",
      "content": [
        "曲江春半日迟迟，正是王孙怅望时。",
        "杏花落尽不归去，江上东风吹柳丝。",
        "四方无事太平年，万象鲜明禁火前。",
        "九重细雨惹春色，轻染龙池杨柳烟。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 362005,
      "title": "咸阳值雨",
      "content": [
        "咸阳桥上雨如悬，万点空蒙隔钓船。",
        "还似洞庭春水色，晓云将入岳阳天。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 362009,
      "title": "渭上题三首",
      "content": [
        "吕公荣达子陵归，万古烟波绕钓矶。",
        "桥上一通名利迹，至今江鸟背人飞。",
        "目极云霄思浩然，风帆一片水连天。",
        "轻桡便是东归路，不肯忘机作钓船。",
        "烟水何曾息世机，暂时相向亦依依。",
        "所嗟白首磻溪叟，一下渔舟更不归。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 362010,
      "title": "经故翰林袁学士居",
      "content": [
        "剑逐惊波玉委尘，谢安门下更何人。",
        "西州城外花千树，尽是羊昙醉后春。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 362012,
      "title": "夜看牡丹",
      "content": [
        "高低深浅一阑红，把火殷勤绕露丛。",
        "希逸近来成懒病，不能容易向春风。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 362014,
      "title": "过分水岭",
      "content": [
        "溪水无情似有情，入山三日得同行。",
        "岭头便是分头处，惜别潺湲一夜声。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 362015,
      "title": "鄠杜郊居",
      "content": [
        "槿篱芳援近樵家，垄麦青青一径斜。",
        "寂寞游人寒食后，夜来风雨送梨花。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 362017,
      "title": "四皓",
      "content": [
        "商于甪里便成功，一寸沉机万古同。",
        "但得戚姬甘定分，不应真有紫芝翁。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 362019,
      "title": "病中书怀呈友人",
      "content": [
        "逸足皆先路，穷郊独向隅。",
        "顽童逃广柳，羸马卧平芜。",
        "黄卷嗟谁问，朱弦偶自娱。",
        "鹿鸣皆缀士，雌伏竟非夫。",
        "采地荒遗野，爰田失故都。",
        "亡羊犹博簺，牧马倦呼卢。",
        "奕世参周禄，承家学鲁儒。",
        "功庸留剑舄，铭戒在盘盂。",
        "经济怀良画，行藏识远图。",
        "未能鸣楚玉，空欲握隋珠。",
        "定为鱼缘木，曾因兔守株。",
        "五车堆缥帙，三径阖绳枢。",
        "适与群英集，将期善价沽。",
        "叶龙图夭矫，燕鼠笑胡卢。",
        "赋分知前定，寒心畏厚诬。",
        "蹑尘追庆忌，操剑学班输。",
        "文囿陪多士，神州试大巫。",
        "对虽希鼓瑟，名亦滥吹竽。",
        "正使猜奔竞，何尝计有无。",
        "镏惔虚访觅，王霸竟揶揄。",
        "市义虚焚券，关讥谩弃𦈡。",
        "至言今信矣，微尚亦悲夫。",
        "白雪调歌响，清风乐舞雩。",
        "胁肩难黾勉，搔首易嗟吁。",
        "角胜非能者，推贤见射乎。",
        "兕觥增恐竦，杯水失锱铢。",
        "粉垛收丹采，金髇隐仆姑。",
        "垂櫜羞尽爵，扬觯辱弯弧。",
        "虎拙休言画，龙希莫学屠。",
        "转蓬随款段，耘草辟墁垆。",
        "受业乡名郑，藏机谷号愚。",
        "质文精等贯，琴筑韵相须。",
        "筑室连中野，诛茅接上腴。",
        "苇花纶虎落，松瘿斗栾栌。",
        "静语莺相对，闲眠鹤浪俱。",
        "蕊多劳蝶翅，香酷坠蜂须。",
        "芳草迷三岛，澄波似五湖。",
        "跃鱼翻藻荇，愁鹭睡葭芦。",
        "暝渚藏㶉𫛶，幽屏卧鹧鸪。",
        "苦辛随艺殖，甘旨仰樵苏。",
        "笑语空怀橘，穷愁亦据梧。",
        "尚能甘半菽，非敢薄生刍。",
        "钓石封苍藓，芳蹊艳绛跗。",
        "树兰畦缭绕，穿竹路萦纡。",
        "机杼非桑女，林园异木奴。",
        "横竿窥赤鲤，持翳望青鸬。",
        "泮水思芹味，琅琊得稻租。",
        "杖轻藜拥肿，衣破芰披敷。",
        "芳意忧𫛸鴂，愁声觉蟪蛄。",
        "短簷喧语燕，高木堕饥鼯。",
        "事迫离幽墅，贫牵犯畏途。",
        "爱憎防杜挚，悲叹似杨朱。",
        "旅食常过卫，羁游欲渡泸。",
        "塞歌伤督护，边角思单于。",
        "堡戍标枪槊，关河锁舳舻。",
        "威容尊大树，刑法避秋荼。",
        "远目穷千里，归心寄九衢。",
        "寝甘诚系滞，浆馈贵睢盱。",
        "怀刺名先远，干时道自孤。",
        "齿牙频激发，簦笈尚崎岖。",
        "莲府侯门贵，霜台帝命俞。",
        "骥蹄初蹑景，鹏翅欲抟扶。",
        "寓直回骢马，分曹对暝乌。",
        "百神歆仿佛，孤竹韵含糊。",
        "凤阙分班立，鹓行竦剑趋。",
        "触邪承密勿，持法奉吁谟。",
        "鸣玉锵登降，衡牙响曳娄。",
        "祀亲和氏璧，香近博山炉。",
        "瑞景森琼树，轻水莹玉壶。",
        "豸冠簪铁柱，螭首对金铺。",
        "内史书千卷，将军画一厨。",
        "眼明惊气象，心死伏规模。",
        "岂意观文物，保劳琢碔砆。",
        "草肥牧騕褭，苔涩淬昆吾。",
        "乡思巢枝鸟，年华过隙驹。",
        "衔恩空抱影，酬德未捐躯。",
        "时辈推良友，家声继令图。",
        "致身伤短翮，骧首顾疲驽。",
        "班马方齐骛，陈雷亦并驱。",
        "昔皆言尔志，今亦畏吾徒。",
        "有气干牛斗，无人辩辘轳。",
        "客来斟绿蚁，妻试踏青蚨。",
        "积毁方销骨，微瑕惧掩瑜。",
        "蛇予犹转战，鱼服自囚拘。",
        "欲就欺人事，何能逭鬼诛。",
        "是非迷觉梦，行役议秦吴。",
        "凛冽风埃惨，萧条草木枯。",
        "低徊伤志气，蒙犯变肌肤。",
        "旅雁唯闻叫，饥鹰不待呼。",
        "梦梭抛促织，心茧学蜘蛛。",
        "宁复机难料，庸非信未孚。",
        "激扬衔箭虎，疑惧听冰狐。",
        "处己将营窟，论心若合符。",
        "浪言辉棣萼，何所托葭莩。",
        "乔木能求友，危巢莫吓雏。",
        "风华飘领袖，诗礼拜衾𦈡。",
        "欹枕情何苦，同舟道岂殊。",
        "放怀亲蕙芷，收迹异桑榆。",
        "赠远聊攀柳，栽书欲截蒲。",
        "瞻风无限泪，回首更踟蹰。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 362020,
      "title": "感旧陈情五十韵献淮南李仆射",
      "content": [
        "嵇绍垂髫日，山涛筮仕年。",
        "琴樽陈席上，纨绮拜床前。",
        "邻里才三徙，云霄已九迁。",
        "感深情惝怳，言发泪潺湲。",
        "忆昔龙图盛，方今鹤羽全。",
        "桂枝香可袭，杨叶旧频穿。",
        "玉籍标人瑞，金丹化地仙。",
        "赋成攒笔写，歌出满城传。",
        "既矫排虚翅，将持造物权。",
        "万灵思鼓铸，群品待陶甄。",
        "视草丝纶出，持纲雨露悬。",
        "法行黄道内，居近翠华边。",
        "书迹临汤鼎，吟声接舜弦。",
        "白麻红烛夜，清漏紫微天。",
        "雷电随神笔，鱼龙落彩笺。",
        "闲宵陪雍时，清暑在甘泉。",
        "耿介非持禄，优游是养贤。",
        "冰清临百粤，风靡化三川。",
        "委寄崇推毂，威仪压控弦。",
        "梁园提彀骑，淮水换戎旃。",
        "照日青油湿，迎风锦帐鲜。",
        "黛蛾陈二八，珠履列三千。",
        "舞转回红袖，歌愁敛翠钿。",
        "满堂开照曜，分座俨婵娟。",
        "油额芙蓉帐，香尘玳瑁筵。",
        "绣旗随影合，金阵似波旋。",
        "缇幕深回互，朱门暗接连。",
        "彩虬蟠画戟，花马立金鞭。",
        "有客将谁托，无媒窃自怜。",
        "抑扬中散曲，漂泊孝廉船。",
        "未展干时策，徒抛负郭田。",
        "转蓬犹邈尔，怀橘更潸然。",
        "投足乖蹊径，冥心向简编。",
        "未知鱼跃地，空愧鹿鸣篇。",
        "稷下期方至，漳滨病未痊。",
        "定非笼外鸟，真是壳中蝉。",
        "蕙径邻幽澹，荆扉兴静便。",
        "草堂苔点点，蔬囿水溅溅。",
        "钓罢溪云重，樵归涧月圆。",
        "懒多成宿疢，愁甚似春眠。",
        "木直终难怨，膏明只自煎。",
        "郑乡空健羡，陈榻未招延。",
        "旅食逢春尽，羁游为事牵。",
        "宦无毛义檄，婚乏阮修钱。",
        "冉弱营中柳，披敷幕下莲。",
        "傥能容委质，非敢望差肩。",
        "涩剑犹堪淬，余朱或可研。",
        "从师当鼓箧，穷理久忘筌。",
        "折简能荣瘁，遣簪莫弃捐。",
        "韶光如见借，寒谷变风烟。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
