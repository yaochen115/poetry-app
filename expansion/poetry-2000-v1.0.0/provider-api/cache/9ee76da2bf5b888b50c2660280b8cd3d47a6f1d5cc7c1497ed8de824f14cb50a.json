        "name": "其他"
      }
    },
    {
      "id": 362024,
      "title": "洞户二十二韵",
      "content": [
        "洞户连珠网，方疏隐碧浔。",
        "烛盘烟坠烬，帘压月通阴。",
        "粉白仙郎署，霜清玉女砧。",
        "醉乡高窈窈，棋阵静愔愔。",
        "素手琉璃扇，玄髫玳瑁簪。",
        "昔邪看寄迹，栀子咏同心。",
        "树列千秋胜，楼悬七夕针。",
        "旧词翻白纻，新赋换黄金。",
        "唳鹤调蛮鼓，惊蝉应宝琴。",
        "舞疑繁易度，歌转断难寻。",
        "露委花相妒，风欹柳不禁。",
        "桥弯双表迥，池涨一篙深。",
        "清跸传恢囿，黄旗幸上林。",
        "神鹰参翰苑，天马破蹄涔。",
        "武库方题品，文园有好音。",
        "朱茎殊菌蠢，丹桂欲萧森。",
        "黼帐回瑶席，华灯对锦衾。",
        "画图惊走兽，书帖得来禽。",
        "河曙秦楼映，山晴魏阙临。",
        "绿囊逢赵后，青锁见王沈。",
        "任达嫌孤愤，疏慵倦九箴。",
        "若为南遁客，犹作卧龙吟。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 362028,
      "title": "题陈处士幽居",
      "content": [
        "松轩尘外客，高枕自萧疏。",
        "雨后苔侵井，霜来叶满渠。",
        "闲看镜湖画，秋得越僧书。",
        "若待前溪月，谁人伴钓鱼。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 362030,
      "title": "题卢处士山居",
      "content": [
        "西溪问樵客，遥识楚人家。",
        "古树老连石，急泉清露沙。",
        "千峰随雨暗，一径入云斜。",
        "日暮飞鸦集，满山荞麦花。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 362032,
      "title": "题丰安里王相林亭二首",
      "content": [
        "花竹有薄埃，嘉游集上才。",
        "白苹安石渚，红叶子云台。",
        "朱户雀罗设，黄门驭骑来。",
        "不知淮水浊，丹藕为谁开。",
        "偶到乌衣巷，含情更惘然。",
        "西州曲堤柳，东府旧池莲。",
        "星坼悲元老，云归送墨仙。",
        "谁知济川楫，今作野人船。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 362034,
      "title": "和友人磐石寺逢旧友",
      "content": [
        "楚寺上方宿，满堂皆旧游。",
        "月溪逢远客，烟浪有归舟。",
        "江馆白苹夜，水关红叶秋。",
        "西风吹暮雨，汀草更堪愁。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 362035,
      "title": "送人南游",
      "content": [
        "送君游楚国，江浦树苍然。",
        "沙净有波迹，岸平多草烟。",
        "角悲临海郡，月到渡淮船。",
        "唯以一杯酒，相思高楚天。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 362038,
      "title": "赠隐者",
      "content": [
        "茅堂对薇蕨，炉暖一裘轻。",
        "醉后楚山梦，觉来春鸟声。",
        "采茶溪树绿，煮药石泉清。",
        "不问人间事，忘机过此生。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 362039,
      "title": "渚宫晚春寄秦地友人",
      "content": [
        "风华已眇然，独立思江天。",
        "凫雁野塘水，牛羊春草烟。",
        "秦原晓重叠，灞浪夜潺湲。",
        "今日思归客，愁容在镜悬。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
