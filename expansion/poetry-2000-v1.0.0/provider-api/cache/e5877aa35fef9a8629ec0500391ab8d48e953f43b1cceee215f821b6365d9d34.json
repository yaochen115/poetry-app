  "data": [
    {
      "id": 176504,
      "title": "和范景仁西圻野老诗",
      "content": [
        "西郊广路浮壤黄，上天雨泣寒云苍。",
        "鸾旗闟戟纷晻霭，扈从威神归帝乡。",
        "田家老父眉睫白，杖藜匍匐泣路傍。",
        "且云生逢至仁主，蠲租罢役岁为常。",
        "蠺收百箔桑蔽野，麻麦极望无边疆。",
        "去年翠华出赛雨，锦绣绵络墟里光。",
        "拜迎六马负缣帛，孙扶妪接归扬扬。",
        "自分讴歌毕余景，一朝缟素安可防。",
        "哀声澒洞彻四极，草木惨淡颜色伤。",
        "蝼蚁衰龄不足赎，泪如飞雪空霑裳。",
        "河萦洛贯嵩峰足，泉底寰瀛日月长。",
        "羡门已闭属车返，轭上空瞻金鳯凰。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 176505,
      "title": "种竹",
      "content": [
        "种竹南墙阴，竹生皆北响。",
        "苟非阳在北，竹性安可强。",
        "乃知就阳意，草木皆有情。",
        "园葵最柔弱，独取倾心名。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176506,
      "title": "介甫巫山高命光属和勉率成篇真不知量",
      "content": [
        "巫山高，巫山之高高不极。",
        "寒江西来曳练长，群峰森罗十二戟。",
        "清狖悲号裂翠崖，老蛟怒鬭摧丹壁。",
        "轻生重利三巴客，一叶直冲高浪白。",
        "船头吟啸坐自如，仰视长天不盈尺。",
        "丛祠象设俨山椒，巫祝纷纷非一朝。",
        "云是高唐神女之所处，至今暮雨常萧萧。",
        "我闻神理明且直，兴亡唯观恶与德。",
        "安肯来从楚国君，凭依梦寐为淫昏。",
        "襄王之心自荒惑，引领日望阳台云。",
        "独不思怀王西行不复返，甲光照地屯秦军。",
        "蠺食黔中下荆门，陵园宗庙皆烧焚。",
        "社稷飘零不复存，嗟嗟若敖蚡冒时，筚路蓝缕皆辛勤。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 176507,
      "title": "昔予尝权宰韦城今重过之二十五年矣慨然有怀",
      "content": [
        "二十五年南北走，遗爱寂然民记否。",
        "昔日婴儿今壮夫，昔日壮夫今老叟。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 176508,
      "title": "秋怀呈范景仁",
      "content": [
        "草木正蕃庑，孰知天地秋。",
        "况兹宿雨余，景气益和柔。",
        "消摇愧簪绂，梦想怀林丘。",
        "兹志久未果，素髪今已稠。",
        "仰视白日光，浩荡浮云流。",
        "安得黄鹤羽，陵风千里游。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 176509,
      "title": "又和秋怀",
      "content": [
        "畴昔共登仕，尔来三十秋。",
        "常晞丝绳直，窃耻鸱夷柔。",
        "蹄涔学巨海，螘垤依崇丘。",
        "行之不自疑，亲寡憎怨稠。",
        "于今不亟去，沦胥恐同流。",
        "努力买良田，远追沮溺游。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 176510,
      "title": "赠道士陈景元酒",
      "content": [
        "篱根委余菊，堦角拥残叶。",
        "清言久不悒，何以慰疲苶。",
        "朋樽涵太和，高兴雅所惬。",
        "谁云居室远，风味自可接。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176511,
      "title": "景仁召饮东园呈陈彦升宋次道李才元苏子容",
      "content": [
        "去冬辱嘉招，寒风方赑屭。",
        "今秋侍高宴，晴日正澄丽。",
        "虽无花蘤繁，且有丘樊思。",
        "虽无山泉乐，𫏐违尘土气。",
        "仆休散城邑，马纵脱羁辔。",
        "讙呼笑言适，散诞冠带弃。",
        "殊胜禁掖严，进止有常地。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 176512,
      "title": "花庵诗寄邵尧夫  其一",
      "content": [
        "洛阳四时常有花，雨晴颜色秋更好。",
        "谁能相与共此乐，坐对年华不知老。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 176513,
      "title": "花庵诗寄邵尧夫  其二",
      "content": [
        "自然天物胜人为，万叶无风绿四垂。",
        "犹恨簪绅未离俗，荷衣蕙带始相宜。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
