{
  "data": [
    {
      "id": 32773,
      "title": "江上",
      "content": [
        "江上霜寒透客衣，闭窗羸卧不支持。",
        "羁孤形影真相吊，衰飒头颅已可知。",
        "潦缩稳经行雨峡，竹疏賸见挂猿枝。",
        "清樽可置须勤醉，莫望功名老大时。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32774,
      "title": "旅食",
      "content": [
        "霜余汉水浅，野逈朔风寒。",
        "炊黍香浮甑，烹蔬绿映盘。",
        "心安失粗粝，味美出艰难。",
        "惟恨虚捐日，无书得纵观。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 32775,
      "title": "沧滩",
      "content": [
        "百夫正讙助鸣𫇛，舟中对面不得语。",
        "须臾人散寂无哗，惟闻百丈转两车。",
        "呕呕哑哑车转急，舟人已在沙际立。",
        "雾敛芦村落照红，雨余渔舍炊烟湿。",
        "故乡回首已千山，上峡初经第一滩。",
        "少年亦慕宦游乐，投老方知行路难。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 32776,
      "title": "松滋小酌",
      "content": [
        "西游六千里，此地最凄凉。",
        "骚客久埋骨，巴歌犹断肠。",
        "风声撼云梦，雪意接潇湘。",
        "万古茫茫恨，悠然付一觞。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 32777,
      "title": "晚泊松滋渡口二首  其一",
      "content": [
        "此行何处不艰难，寸寸强弓且旋弯。",
        "县近欢欣初得菜，江回徙倚忽逢山。",
        "系船日落松滋渡，跋马云埋滟滪关。",
        "未满百年均是客，不须数日待东还。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32778,
      "title": "晚泊松滋渡口二首  其二",
      "content": [
        "小滩拍拍鸬鹚飞，深竹萧萧杜宇悲。",
        "看镜不堪衰病后，系船最好夕阳时。",
        "生涯落魄惟躭酒，客路苍茫自咏诗。",
        "莫问长安在何许，乱山孤店是松滋。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32779,
      "title": "荆门冬夜",
      "content": [
        "常饥龟老欲无肠，卧听寒更自短长。",
        "香椀得闲聊作伴，酒杯因病颇相忘。",
        "有情窗罅恰通月，耐冷橹枝多得霜。",
        "歴尽风波知险阻，平生错羡捕鱼郎。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32780,
      "title": "系舟下牢溪游三游洞二十八韵",
      "content": [
        "旧观三峡图，常谓非人情。",
        "意疑天壤间，岂有此峥嵘。",
        "画师定戏耳，聊欲穷丹青。",
        "西游过沔鄂，莽莽千里平。",
        "昨日到峡州，所见始可惊。",
        "乃知画非妄，却恨笔未精。",
        "及兹下牢戍，峰嶂毕自呈。",
        "下入裂坤轴，高鶱插青冥。",
        "角胜多列峙，擅美有孤撑。",
        "或如釡上甑，或如坐后屏。",
        "或如倨而立，或如喜而迎。",
        "或深如螺房，或疏如窗棂。",
        "峨巍冠冕古，婀娜髻鬟倾。",
        "其间绝出者，虎搏蛟龙狞。",
        "崩崖凛欲堕，修梁架空横。",
        "悬瀑泻无底，终古何时盈。",
        "幽泉莫知处，但闻珩珮鸣。",
        "怪怪与奇奇，万状不可名。",
        "久闻三游洞，疾走忘病婴。",
        "窦穴初漆黑，伛偻扪壁行。",
        "方虞触蛰蛇，𫖯见一点明。",
        "扶接困僮奴，恍然出瓶罂。",
        "穹穹厦屋宽，滴乳成微泓。",
        "题名欧与黄，云蒸苍藓平。",
        "穿林走惊麕，拂面逢飞鼪。",
        "息倦盘石上，拾樵置茶铛。",
        "长啸答谷响，清吟和松声。",
        "辞卑不堪刻，犹足寄友生。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 32781,
      "title": "三游洞前岩下小潭水甚奇取以煎茶",
      "content": [
        "苔径芒鞵滑不妨，潭边聊得据胡床。",
        "岩空倒看峰峦影，涧远中含药草香。",
        "汲取满瓶牛乳白，分流触石珮声长。",
        "囊中日铸传天下，不是名泉不合尝。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32782,
      "title": "扇子峡山腹有草阁小亭极幽邃意其非俗人居也",
      "content": [
        "绝境慰人心，谁家住玉岑。",
        "乱云生翠窦，密雪洒青林。",
        "高阁临空豁，孤亭隠邃深。",
        "定知非俗士，橹急不容寻。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 32783,
      "title": "虾蟆碚",
      "content": [
        "不肯爬沙桂树边，朵颐千古向岩前。",
        "巴东峡里最初峡，天下泉中第四泉。",
        "啮雪饮冰疑换骨，掬珠弄玉可忘年。",
        "清游自笑何曾足，叠鼓冬冬又解船。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32784,
      "title": "黄牛峡庙",
      "content": [
        "三峡束江流，崖谷互吐纳。",
        "黄牛不负重，云表恣蹴蹋。",
        "吴船与蜀舸，有请神必答。",
        "谁怜马遭刖，百岁创未合。",
        "柂师浪奔走，烹彘陈酒榼。",
        "纷然馂神余，羮{炙火=肉}争嘬嚃。",
        "空庭多落叶，日莫声飒飒。",
        "奇文粲可辨，高古篆籕杂。",
        "村女卖秋茶，簪花髻鬟匝。",
        "襁儿著背上，帖妥若在榻。",
        "山寒雪欲下，虎出门早阖。",
        "我行忽至此，临风久呜唈。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 32785,
      "title": "过夷陵适值祈雪与叶使君清饮谈括苍旧游既行舟中雪作戏成长句奉寄",
      "content": [
        "巴楚夷陵酒最醇，使君风味更清真。",
        "少年恨不从豪饮，薄宦那知托近邻。",
        "本拟笙歌娱病客，却催雨雪恼行人。",
        "朝来冻手题诗寄，莫笑欹斜字不匀。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32786,
      "title": "泊虎头滩下",
      "content": [
        "大舟已泊灯火明，小舟犹行闻橹声。",
        "虎头崔嵬鹿角横，人生实难君勿轻。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 32787,
      "title": "过东𤃩滩入马肝峡",
      "content": [
        "书生就食等奔逃，道路崎岖信所遭。",
        "船上急滩如退鹢，人缘绝壁似飞猱。",
        "口夸远岭青千叠，心忆平波绿一篙。",
        "犹胜溪丁绝轻死，无时来往驾𦨴艚。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32788,
      "title": "新安驿",
      "content": [
        "孤驿荒山与虎邻，更堪风雪暗南津。",
        "羁游如此真无策，独立凄然黙怆神。",
        "木盎汲江人起早，银钗簇髻女粧新。",
        "蛮风弊恶蛟龙横，未敢全夸见在身。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32789,
      "title": "秭归醉中怀都下诸公示坐客",
      "content": [
        "长谣为子说天涯，四坐听歌且勿哗。",
        "蛮俗杀人供鬼祭，败舟触石委江沙。",
        "此身长是沧浪客，何日能为饱暖家。",
        "坐忆故人空有梦，尺书不敢到京华。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32790,
      "title": "憩归州光孝寺寺后有楚冢近岁或发之得宝玉剑佩之类",
      "content": [
        "秭归城畔蹋斜阳，古寺无僧昼闭房。",
        "残珮断钗陵谷变，苦茆架竹井闾荒。",
        "虎行欲与人争路，猿啸能令客断肠。",
        "寂寞倚楼搔短发，剩题新恨付巴娘。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32791,
      "title": "饮罢寺门独立有感",
      "content": [
        "一邑无平土，邦人例得穷。",
        "凄凉远嫁妇，憔悴独醒翁。",
        "今古阑干外，悲欢酒醆中。",
        "三巴不揺落，搔首对丹枫。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 32792,
      "title": "泛溪船至巴东",
      "content": [
        "溪船莫嫌迮，船迮始相宜。",
        "两桨行何驶，重滩过不知。",
        "荒村寇相县，破屋屈平祠。",
        "不奈新愁得，啼猿挂冷枝。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 32793,
      "title": "巴东遇小雨二首  其一",
      "content": [
        "暂借清溪伴钓翁，沙边微雨湿孤蓬。",
        "从今诗在巴东县，不属灞桥风雪中。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 32794,
      "title": "巴东遇小雨二首  其二",
      "content": [
        "西游万里亦何为，欲就骚人乞弃遗。",
        "到此宛然诗不进，始知才分有穷时。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 32795,
      "title": "秋风亭拜宼莱公遗像二首  其一",
      "content": [
        "江上秋风宋玉悲，长官手自葺茅茨。",
        "人生穷达谁能料，蜡泪成堆又一时。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 32796,
      "title": "秋风亭拜宼莱公遗像二首  其二",
      "content": [
        "豪杰何心后世名，材高遇事即峥嵘。",
        "巴东诗句澶州策，信手拈来尽可惊。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 32797,
      "title": "巴东令廨白云亭",
      "content": [
        "寇公壮岁落巴蛮，得意孤亭缥缈间。",
        "常倚曲阑贪看水，不安四壁怕遮山。",
        "遗民虽尽犹能说，老令初来亦爱闲。",
        "正使官清贫至骨，未妨留客听潺潺。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32798,
      "title": "谒巫山庙两庑碑版甚众皆言神佐禹开峡之功而诋宋玉高唐赋之妄予亦赋诗一首",
      "content": [
        "真人翳鳯驾蛟龙，一念何曾与世同。",
        "不为行云求弭谤，那因治水欲论功。",
        "翺翔想见虚无里，毁誉谁知溷浊中。",
        "读尽旧碑成绝倒，书生惟惯谄王公。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32799,
      "title": "闻猿",
      "content": [
        "瘦尽腰围不为诗，良辰流落自成衰。",
        "也知客里偏多感，谁料天涯有许悲。",
        "汉塞角残人不寐，渭城歌罢客将离。",
        "故应未抵闻猿恨，况是巫山庙里时。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32800,
      "title": "瞿唐行",
      "content": [
        "四月欲尽五月来，峡中水涨何雄哉。",
        "浪花高飞暑路雪，滩石怒转晴天雷。",
        "千艘万舸不敢过，篙工柂师心胆破。",
        "人人阴拱待势衰，谁敢轻行犯奇祸。",
        "一朝时去不自由，山腹空有沙痕留。",
        "君不见陆子岁暮来夔州，瞿唐峡水平如油。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 32801,
      "title": "入瞿唐登白帝庙",
      "content": [
        "晓入大谿口，是为瞿唐门。",
        "长江从蜀来，日夜东南奔。",
        "两山对崔嵬，势如塞乾坤。",
        "峭壁空仰视，欲上不可扪。",
        "禹功何巍巍，尚覩镌凿痕。",
        "天不生斯人，人皆化鱼鼋。",
        "于时仲冬月，水各归其源。",
        "滟滪屹中流，百尺呈孤根。",
        "参差层颠屋，邦人祀公孙。",
        "力战死社稷，宜享庙貎尊。",
        "丈夫贵不挠，成败何足论。",
        "我欲伐巨石，作碑累千言。",
        "上陈跃马壮，下斥乘骡昏。",
        "虽惭豪伟词，尚慰雄杰魂。",
        "君王昔玉食，何至歆鸡豚。",
        "愿言采芳兰，舞歌荐清尊。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 32802,
      "title": "登江楼",
      "content": [
        "已过瞿唐更少留，小船聊系古夔州。",
        "簿书未破三年梦，杖履先寻百尺楼。",
        "日暮雪云迷峡口，岁穷畬火照关头。",
        "野人不解微官缚，尊酒应来此散愁。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32803,
      "title": "雪中卧病在吿戏作",
      "content": [
        "面裂愁出门，指直但藏袖。",
        "谁云三峡热，有此凛冽候。",
        "殷勤愧雪片，飞舞为我寿。",
        "方惊四山积，已见万瓦覆。",
        "岂惟寒到骨，遂觉疾在腠。",
        "地炉炽薪炭，噤坐连昏昼。",
        "梅花真强项，不肯落春后。",
        "俗人爱桃李，苦道太疏瘦。",
        "清芬终见赏，此事非速售。",
        "已矣吾何言，高枕听簷溜。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 32804,
      "title": "雪晴",
      "content": [
        "腊尽春生白帝城，俸钱虽薄胜躬耕。",
        "眼前但恨亲朋少，身外元知得丧轻。",
        "日映满窗松竹影，雪消并舍鸟乌声。",
        "老来莫道风情减，忆向烟芜信马行。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32805,
      "title": "玉笈斋书事二首  其一",
      "content": [
        "莫笑新霜点鬓须，老来却得少工夫。",
        "晨占上古连山易，夜对西真五岳图。",
        "叔夜曾闻高士啸，孔宾岂待异人呼。",
        "眉间喜色谁知得，今日新添火四铢。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32806,
      "title": "玉笈斋书事二首  其二",
      "content": [
        "雪霁茆堂钟磬清，晨斋枸杞一杯羮。",
        "隠书不厌千回读，大药何时九转成。",
        "孤坐月魂寒彻骨，安眠龟息浩无声。",
        "剩分松屑为山信，明日青城有使行。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32807,
      "title": "记梦",
      "content": [
        "梦里都忘困晚途，纵横草疏论迁都。",
        "不知尽挽银河水，洗得平生习气无。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 32808,
      "title": "瀼西",
      "content": [
        "千载瀼西路，今年著脚行。",
        "匆匆衰已具，渺渺恨难平。",
        "绝壁猿啼雨，深枝鹊报晴。",
        "亦知忧吏责，未忍废诗情。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 32809,
      "title": "山寺",
      "content": [
        "篮舆送客过江村，小寺无人半掩门。",
        "古佛负墙尘漠漠，孤灯照殿雨昏昏。",
        "喜投禅榻聊寻梦，懒为啼猿更断魂。",
        "要识人间盛衰理，岸沙君看去年痕。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32810,
      "title": "蹋碛",
      "content": [
        "鬼门关外逢人日，蹋碛千家万家出。",
        "竹枝惨戚云不动，剑气聨翩日将夕。",
        "行人十有八九瘿，见惯何曾羞顾影。",
        "江边沽酒沙上卧，峡口月出风吹醒。",
        "人生未死信难知，憔悴夔州生鬓丝。",
        "何日画船揺桂檝，西湖却赋探春诗。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 32811,
      "title": "寒食",
      "content": [
        "峡云烘日欲成霞，瀼水生纹浅见沙。",
        "又向蛮方作寒食，强持巵酒对梨花。",
        "身如巢燕年年客，心羡游僧处处家。",
        "赖有春风能领略，一生相伴遍天涯。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32812,
      "title": "晚晴书事呈同舍",
      "content": [
        "鱼复城边夕照红，物华偏解恼衰翁。",
        "巴莺有恨啼芳树，野水无情入故宫。",
        "许国渐疏悲壮志，读书多忘愧新功。",
        "因君共语增惆怅，京洛交游欲半空。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32813,
      "title": "乡中每以寒食立夏之间省坟客夔适逢此时凄然感怀二首  其一",
      "content": [
        "松阴系马启朱扉，粔籹青红正此时。",
        "守墓万家犹有日，及亲三釡永无期。",
        "诗成谩写天涯感，泪尽何由地下知。",
        "富贵贱贫俱有恨，此生长废蓼莪诗。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32814,
      "title": "乡中每以寒食立夏之间省坟客夔适逢此时凄然感怀二首  其二",
      "content": [
        "手持绿酒酹苍苔，今岁何由疋马来。",
        "清泪不随春雨断，孤吟欲和暮猿哀。",
        "皂貂破弊归心切，白发凄凉老境催。",
        "誓墓只思长不出，松门日日手亲开。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32815,
      "title": "试院春晚",
      "content": [
        "病思萧条掩绿罇，闲坊寂歴锁朱门。",
        "故人别久难寻梦，远客愁多易断魂。",
        "漫漫晚花吹瀼岸，离离春草上宫垣。",
        "此生飘泊何时已，家在山阴水际村。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32816,
      "title": "倚阑",
      "content": [
        "故山未敢说归期，十口相随又别离。",
        "小雨初收残照晚，阑干西角立多时。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 32817,
      "title": "自咏",
      "content": [
        "朝衣无色如霜叶，将奈云安别驾何。",
        "钟鼎山林俱不遂，声名官职两无多。",
        "低昻未免闻鸡舞，慷慨犹能击筑歌。",
        "头白伴人书纸尾，只思归去弄烟波。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32818,
      "title": "午兴",
      "content": [
        "渐转廊腰日，徐来峡口风。",
        "飧浆便北客，淖粥称衰翁。",
        "槐晚纤纤绿，榴残续续红。",
        "责轻仍饱食，三叹愧无功。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 32819,
      "title": "风雨中望峡口诸山奇甚戏作短歌",
      "content": [
        "白盐赤甲天下雄，拔地突兀摩苍穹。",
        "凛然猛士舞长剑，空有豪健无雍容。",
        "不令气象少渟滀，常恨天地无全功。",
        "今朝忽悟始叹息，妙处元在烟雨中。",
        "太阴杀气横惨澹，元化变态含空蒙。",
        "正如奇材遇事见，平日乃与常人同。",
        "安得朱楼高百尺，看此疾雨吹横风。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 32820,
      "title": "夜坐庭中",
      "content": [
        "人静风褰幔，更阑露泫衣。",
        "暗窗饥鼠啮，空庑冷萤飞。",
        "岁月背人去，乡闾何日归。",
        "脱巾还感叹，残发不胜稀。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 32821,
      "title": "新蔬",
      "content": [
        "黄瓜翠苣最相宜，上市登盘四月时。",
        "莫拟将军春荠句，两京名价有谁知。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 32822,
      "title": "初夏怀故山",
      "content": [
        "镜湖四月正清和，白塔红桥小艇过。",
        "梅雨晴时插秧鼓，苹风生处采菱歌。",
        "沉迷簿领吟哦少，淹泊蛮荒感慨多。",
        "谁谓吾庐六千里，眼中歴歴见渔蓑。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32823,
      "title": "初夏新晴",
      "content": [
        "曲径泥新晚照明，小轩才受一床横。",
        "翩翩乳燕穿帘影，蔌蔌新篁解箨声。",
        "药物屏除知病减，梦魂安穏觉心平。",
        "深居不恨无来客，时有山禽自赞名。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32824,
      "title": "定拆号日喜而有作",
      "content": [
        "小雨如丝落复收，悄无人语但鸣鸠。",
        "挽须预想诸儿喜，倒指犹为五日留。",
        "满案堆书惟引睡，侵天围棘不遮愁。",
        "为农父子长相守，误计随人学宦游。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32825,
      "title": "睡起",
      "content": [
        "深闭重门谢簿书，日长添得睡工夫。",
        "水纹笛簟凉如洗，云碧纱幮薄欲无。",
        "半吐山榴看著子，新来梁燕见将雏。",
        "梦回茗椀聊须把，自扫桐阴置瓦炉。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32826,
      "title": "四月二十九日作",
      "content": [
        "假馆犹三日，还家甫四旬。",
        "昏眸云雾隔，衰鬓雪霜新。",
        "尊酒虽慵近，囊诗却未贫。",
        "但愁门有客，流汗强冠巾。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 32827,
      "title": "苦热",
      "content": [
        "万瓦鳞鳞若火龙，日车不动汗珠融。",
        "无因羽翮氛埃外，坐觉蒸炊釡甑中。",
        "石磵寒泉空有梦，冰壶团扇欲无功。",
        "余威向晚犹堪畏，浴罢斜阳满野红。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32828,
      "title": "拆号前一日作",
      "content": [
        "飘零随处是生涯，断梗飞蓬但可嗟。",
        "稚子欢迎先入梦，从兵结束待还家。",
        "食眠屡失身多病，忧愧相乘发易华。",
        "隔日寄声为薄具，石榴应有未开花。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32829,
      "title": "暴雨",
      "content": [
        "风怒欲掀屋，雨来如决隄。",
        "孤灯映窗灭，羁鸟就簷栖。",
        "暑令方炎赫，秋声忽惨凄。",
        "传闻涨江水，已断瀼东西。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 32830,
      "title": "西斋雨后",
      "content": [
        "香碗灰深微炷火，茶铛声细缓煎汤。",
        "百年浮世几人乐，一雨虚斋三日凉。",
        "帘外微风斜燕影，池边残照敛萱房。",
        "纱幮石枕萧然卧，付与今宵幽梦长。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32831,
      "title": "急雨",
      "content": [
        "阴云屯硖口，急雨过城头。",
        "白舫投沙峡，青帘卷市楼。",
        "漂揺争阖户，壅溢共疏沟。",
        "抽得驱蝇手，题诗慰旅愁。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 32832,
      "title": "晚晴闻角有感",
      "content": [
        "暑雨初收白帝城，小荷新竹夕阳明。",
        "十年尘土青衫色，万里江山画角声。",
        "零落亲朋劳远梦，凄凉乡社负归耕。",
        "议郎博士多新奏，谁致当时鲁二生。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32833,
      "title": "夏夜起坐南亭达晓不复寐",
      "content": [
        "风露青冥近九秋，脱巾扶杖冷飕飗。",
        "曲阑影外巴山月，画角声中楚塞愁。",
        "巢燕并栖高栋稳，潜鱼时跃小池幽。",
        "悠然坐待江城晓，红日将升碧雾浮。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32834,
      "title": "夜登白帝城楼怀少陵先生",
      "content": [
        "拾遗白发有谁怜，零落歌诗遍两川。",
        "人立飞楼今已矣，浪翻孤月尚依然。",
        "升沉自古无穷事，愚智同归有限年。",
        "此意凄凉谁共语，夜阑鸥鹭起沙边。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32835,
      "title": "假日书事",
      "content": [
        "万里西来为一饥，坐曹日日汗霑衣。",
        "但嫌忧畏妨人乐，不恨疏慵与世违。",
        "雕槛迎阳花并发，画梁避雨燕双归。",
        "放怀始得闲中趣，下马何人又叩扉。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32836,
      "title": "林亭书事二首  其一",
      "content": [
        "吏退林亭夏日长，乌纱白纻自生凉。",
        "遶簷密叶帷三面，覆水青萍锦一方。",
        "约束蛮僮收药富，催呼稚子晒书忙。",
        "平生幽事还拈起，未觉巴山异故乡。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32837,
      "title": "林亭书事二首  其二",
      "content": [
        "期会文书日日忙，偷门聊得卧方床。",
        "花藏密叶多时在，风度疏帘特地凉。",
        "野艇空怀菱蔓滑，冰盆谁弄藕丝长。",
        "角声唤起东归梦，十里平湖一草堂。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32838,
      "title": "游卧龙寺",
      "content": [
        "晓发鱼复走瞿唐，沙头唤渡倚胡床。",
        "峒人争趁五更市，我亦来追六月凉。",
        "残星欲尽尚歴落，明河已淡余苍茫。",
        "翻翻林表鸦鹊语，渺渺烟边鸥鹭行。",
        "过江走马十五里，小寺残僧真蕞尔。",
        "投鞭入门一为笑，僻陋称雄有如此。",
        "君不见天童径山金碧浮虚空，千衲梵呗层云中。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 32839,
      "title": "久病灼艾后独卧有感",
      "content": [
        "白帝城高暮柝传，幽窗搔首意萧然。",
        "江边云湿初横雁，墙下桐疏不庇蝉。",
        "计出火攻伤老病，卧闻鸢堕叹蛮烟。",
        "诸贤好试筹戎策，敛退无心竞著鞭。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32840,
      "title": "秋晚病起",
      "content": [
        "心静病良已，翛然巾屦轻。",
        "灰深地炉暖，日出纸窗明。",
        "宿雨全消瘴，新霜賸得晴。",
        "井梧殊可念，无叶送秋声。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 32841,
      "title": "秋思",
      "content": [
        "鱼复城边逢雁飞，白头覊客恨依依。",
        "远游眼底故交少，晚岁人间乐事稀。",
        "云重古关传夜柝，月斜深巷捣秋衣。",
        "官闲况是频移疾，药鼎荧荧卧掩扉。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 32842,
      "title": "一病四十日天气遂寒感怀有赋",
      "content": [
        "幽人病起鬓毛残，硖口楼台九月寒。",
        "暮角又催孤梦断，早霜初染一林丹。",
        "乡闾乖隔知谁健，怀抱凄凉用底宽。",
        "曲米春香虽可醉，瀼西新橘尚余酸。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32843,
      "title": "登城",
      "content": [
        "簿领无时了，登临亦快哉。",
        "楼危压城起，硖迮束江来。",
        "病瘴抛书帙，思乡泥酒杯。",
        "天寒水尽落，滟滪已崔嵬。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 32844,
      "title": "夔州重阳",
      "content": [
        "夔州鼓角晚凄悲，恰是幽窗睡起时。",
        "但忆社醅挼菊蕋，敢希朝士赐茰枝。",
        "山川信美吾庐远，天地无情客鬓衰。",
        "佳日掩门君莫笑，病来纱帽不禁吹。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32845,
      "title": "追怀曾文清公呈赵教授赵近尝示诗",
      "content": [
        "忆在茶山听说诗，亲从夜半得玄机。",
        "常忧老死无人付，不料穷荒见此奇。",
        "律令合时方帖妥，工夫深处却平夷。",
        "人间可恨知多少，不及同君叩老师。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32846,
      "title": "谢张廷老司理录示山居诗二首  其一",
      "content": [
        "憔悴经年客瘴乡，把君诗卷意差强。",
        "古人三语犹嗟赏，况是珠玑满锦囊。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 32847,
      "title": "谢张廷老司理录示山居诗二首  其二",
      "content": [
        "老觉人间万事非，但思茆屋映疏篱。",
        "秋衾已是饶归梦，更读山居二十诗。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 32848,
      "title": "秋晴欲出城以事不果",
      "content": [
        "古人已云不可回，今人日夜归泉台。",
        "浮生细看只此是，到死自苦何为哉。",
        "矝名饰诈竟一世，忍寒触热忘其骸。",
        "不令金樽映翠杓，坐待白骨生苍苔。",
        "清秋九月瘴如洗，白盐千仞高崔嵬。",
        "荒庭落叶不可扫，惟有樷菊争先开。",
        "瀼西黄柑霜落爪，溪口赤梨丹染腮。",
        "熊肪玉洁美香饭，鲊脔花糁宜新醅。",
        "南窗病起亦萧散，甚欲往探城西梅。",
        "一官底处不败意，正用此时持事来。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 32849,
      "title": "南窗",
      "content": [
        "流落逢知少，疏慵迕俗多。",
        "闷拈如意舞，狂叩唾壶歌。",
        "巴酒禁愁得，金丹奈老何。",
        "南窗好风月，聊复此婆娑。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 32850,
      "title": "遣兴",
      "content": [
        "酒量愁翻减，诗声老转低。",
        "日高羮马齿，霜冷驾鸡栖。",
        "已判功名迕，寜论簿领迷。",
        "赖无权入手，软弱实如泥。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 32851,
      "title": "九月三十日登城门东望凄然有感",
      "content": [
        "减尽腰围白尽头，经年作客向夔州。",
        "流离去国归无日，瘴疠侵人病过秋。",
        "菊蕋残时初把酒，雁行横处更登楼。",
        "蜀江朝暮东南注，我独胡为淹此留。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32852,
      "title": "初冬野兴",
      "content": [
        "关北关南霜露寒，瀼东瀼西山谷盘。",
        "簟纹细细吹残水，鼋背时时出小滩。",
        "衰发病来无复绿，寸心老去尚如丹。",
        "逆胡未灭时多事，却为无才得少安。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32853,
      "title": "东屯呈同游诸公",
      "content": [
        "十月霜雕枫树林，清溪白石称幽寻。",
        "按行老子诛茆地，惆怅孤臣许国心。",
        "走马平沙嫌路近，传杯小阁喜寒侵。",
        "也思试索梅花笑，冻蕊疏疏欲不禁。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32854,
      "title": "别王伯高",
      "content": [
        "冷落何人肯见寻，断弦尘匣愧知音。",
        "倾家酿酒犹嫌少，入海求诗未厌深。",
        "薄宦簿书常衮衮，中年光景易骎骎。",
        "香匳赠别非无意，共约跏趺看此心。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32855,
      "title": "书驿壁二首  其一",
      "content": [
        "猿叫铺前雪欲作，鬼门关头路正恶。",
        "泥深三尺马蹄弱，霜厚一寸客衣薄。",
        "朝行过栈暮渡笮，夜投破驿火煜爚。",
        "人生但要无媿怍，万里窜身元不错。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32856,
      "title": "书驿壁二首  其二",
      "content": [
        "峡中山多甲天下，万嶂千峰通一罅。",
        "峒民无地习耕稼，射麋捕虎连昼夜。",
        "女儿薄命天不借，青灯独宿江边舍。",
        "黎明卖薪勿悲咤，女生岂有终不嫁。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32857,
      "title": "醉中到白崖而归",
      "content": [
        "醉眼朦胧万事空，今年痛饮瀼西东。",
        "偶呼快马迎新月，却上轻舆御晚风。",
        "行路八千常是客，丈夫五十未称翁。",
        "乱山缺处如横线，遥指孤城翠霭中。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32858,
      "title": "十二月十九日晚巫山送客归回望西寺小阁缥缈可爱遂与赵郭二教授同游抵夜乃还楚乡偶得长句呈二君",
      "content": [
        "送客沙头落日催，遥看重阁更同来。",
        "清尊与闷都倾尽，倦马和诗总勒回。",
        "憔悴远游悲骑省，豪华前事记章台。",
        "归时灯火参差晚，自脱征衣拂帽埃。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32859,
      "title": "饭三折铺铺在乱山中",
      "content": [
        "平生爱山每自叹，举世但觉山可玩。",
        "皇天怜之足其愿，著在荒山更何怨。",
        "南穷闽粤西蜀汉，马蹏几歴天下半。",
        "山横水掩路欲断，崔嵬可陟流可乱。",
        "春风桃李方漫漫，飞栈凌空又奇观。",
        "但令身健能强饭，万里只作游山看。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 32860,
      "title": "小市",
      "content": [
        "小市门前沙作堤，杏花虽落不霑泥。",
        "客心尚壮身先老，江水方东我独西。",
        "𫏐憩轩窗仍汛扫，远游书剑亦提携。",
        "子规应笑飘零惯，故傍茆簷尽意啼。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32861,
      "title": "酒无独饮理",
      "content": [
        "酒无独饮理，常恨欠佳客。",
        "忽得我辈人，岂计晨与夕。",
        "少年事虚名，岁月驹过隙。",
        "自从老大来，一日亦可惜。",
        "糟丘未易办，小计且千石。",
        "頺然置万事，天地为幕帟。",
        "人生如刀砺，磨尽要有日。",
        "不须荷锸随，况问几两屐。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 32862,
      "title": "畏虎",
      "content": [
        "滑路滑如苔，涩路涩若梯。",
        "更堪都梁下，一雪三日泥。",
        "泥深尚云可，委身饿虎蹊。",
        "心寒道上迹，魄碎茆叶低。",
        "常恐不自免，一死均猪鸡。",
        "老马亦甚畏，愶愶不敢嘶。",
        "吾闻虎虽暴，未尝窥汝栖。",
        "孤行暮不止，取祸非排挤。",
        "彼谗实有心，平地生沟谿。",
        "哀哉马新息，薏苡成珠犀。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 32863,
      "title": "戏题",
      "content": [
        "走马平欺刺绣坡，放船横截乱丝涡。",
        "从来倚个心平稳，遇险方知得力多。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 32864,
      "title": "蟠龙瀑布",
      "content": [
        "远望纷珠缨，近观转雷霆。",
        "人言水出奇，意使行人惊。",
        "人惊我何得，定非水之情。",
        "水亦有何情，因物以赋形。",
        "处高势趋下，岂乐与石争。",
        "退之亦隘人，强言不平鸣。",
        "古来贤达士，初亦愿躬耕。",
        "意气或感激，邂逅成功名。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 32865,
      "title": "题梁山军瑞丰亭",
      "content": [
        "我行都梁窘风雪，史君喜事能留客。",
        "瑞丰亭上一尊酒，渺渺郊原水初白。",
        "峡中地褊常苦贫，政令愈简民愈淳。",
        "本来无事只畏扰，扰者才吏非庸人。",
        "都梁之民独无苦，须晴得晴雨得雨。",
        "史君心爱稼如云，时上斯亭按歌舞。",
        "歌阑舞罢史君醉，父老罗拜丰年赐。",
        "圣朝尚实抑虚文，纵产芝房非上瑞。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 32866,
      "title": "马上",
      "content": [
        "残年流转似萍根，马上伤春易断魂。",
        "烘暖花无经日蕊，涨深水过去年痕。",
        "迷行每问樵夫路，投宿时敲竹寺门。",
        "不信太平元有象，牛羊点点散烟村。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32867,
      "title": "邻山县道上作",
      "content": [
        "微雨晴时出驿门，乱莺啼处过江村。",
        "挽花醉袖霑余馥，迎日征鞍借小温。",
        "客路一身真吊影，故园万里欲招魂。",
        "鬓毛无色心犹壮，藉草悲歌对酒尊。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32868,
      "title": "邻水延福寺早行",
      "content": [
        "化蝶方酣枕，闻鸡又著鞭。",
        "乱山徐吐日，积水远生烟。",
        "淹泊真衰矣，登临独惘然。",
        "桃花应笑客，无酒到愁边。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 32869,
      "title": "岳池农家",
      "content": [
        "春深农家耕未足，原头叱叱两黄犊。",
        "泥融无块水初浑，雨细有痕秧正绿。",
        "绿秧分时风日美，时平未有差科起。",
        "买花西舍喜成婚，持酒东邻贺生子。",
        "谁言农家不入时，小姑画得城中眉。",
        "一双素手无人识，空村相唤看缫丝。",
        "农家农家乐复乐，不比市朝争夺恶。",
        "宦游所得真几何，我已三年废东作。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 32870,
      "title": "过广安吊张才叔谏议",
      "content": [
        "春风疋马过孤城，欲吊先贤涕已倾。",
        "许国肺肝知激烈，照人眉宇尚峥嵘。",
        "中原成败寜非数，后世忠邪自有评。",
        "叹息知人真未易，流芳遗臭尽书生。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32871,
      "title": "果州驿",
      "content": [
        "驿前官路堠累累，叹息何时送我归。",
        "池馆莺花春渐老，窗扉灯火夜相依。",
        "孤鸾怯舞愁窥镜，老马贪行强受鞿。",
        "到处风尘常扑面，岂惟京洛化人衣。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32872,
      "title": "留樊亭三日王觉民检详日携酒来饮海棠下比去花亦衰矣二首  其一",
      "content": [
        "留落犹能领物华，名园又作醉生涯。",
        "何妨海内功名士，共赏人间富贵花。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
