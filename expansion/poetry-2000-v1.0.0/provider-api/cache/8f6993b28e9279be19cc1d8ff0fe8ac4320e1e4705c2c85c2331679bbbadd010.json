{
  "data": [
    {
      "id": 327013,
      "title": "醉桃源・阮郎归",
      "content": [
        "碧天如水月如眉。",
        "城头银漏迟。",
        "绿波风动画船移。",
        "娇羞初见时。",
        "银烛暗，翠帘垂。",
        "芳心两自知。",
        "楚台魂断晓云飞。",
        "幽欢难再期。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 327014,
      "title": "河传",
      "content": [
        "乱花飞絮。",
        "又望空斗合，离人愁苦。",
        "那更夜来，一霎薄情风雨。",
        "暗掩将、春色去。",
        "篱枯壁尽因谁做。",
        "若说相思，佛也眉儿聚。",
        "莫怪为伊，底死萦肠惹肚。",
        "为没教、人恨处。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 327015,
      "title": "河传",
      "content": [
        "恨眉醉眼。",
        "甚轻轻覰著，神魂迷乱。",
        "常记那回，小曲阑干西畔。",
        "鬓云松、罗袜刬。",
        "丁香笑吐娇无限。",
        "语软声低，道我何曾惯。",
        "云雨未谐，早被东风吹散。",
        "闷损人、天不管。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 327016,
      "title": "浣溪沙",
      "content": [
        "漠漠轻寒上小楼。",
        "晓阴无赖似穷秋。",
        "淡烟流水画屏幽。",
        "自在飞花轻似梦，无边丝雨细如愁。",
        "宝帘闲挂小银钩。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 327017,
      "title": "浣溪沙",
      "content": [
        "香靥凝羞一笑开。",
        "柳腰如醉暖相挨。",
        "日长春困下楼台。",
        "照水有情聊整鬓，倚阑无绪更兜鞋。",
        "眼边牵系懒归来。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 327018,
      "title": "浣溪沙",
      "content": [
        "霜缟同心翠黛连。",
        "红绡四角缀金钱。",
        "恼人香𦶟是龙涎。",
        "枕上忽收疑是梦，灯前重看不成眠。",
        "又还一断恶因缘。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 327019,
      "title": "浣溪沙",
      "content": [
        "脚上鞋儿四寸罗。",
        "唇边朱粉一樱多。",
        "见人无语但回波。",
        "料得有心怜宋玉，只应无奈楚襄何。",
        "今生有分共伊么。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 327020,
      "title": "浣溪沙",
      "content": [
        "锦帐重重卷暮霞。",
        "屏风曲曲斗红牙。",
        "恨人何事苦离家。",
        "枕上梦魂飞不去，觉来红日又西斜。",
        "满庭芳草衬残花。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 327021,
      "title": "如梦令",
      "content": [
        "门外鸦啼杨柳。",
        "春色著人如酒。",
        "睡起熨沈香，玉腕不胜金斗。",
        "消瘦。",
        "消瘦。",
        "还是褪花时候。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 327022,
      "title": "如梦令",
      "content": [
        "遥夜沈沈如水。",
        "风紧驿亭深闭。",
        "梦破鼠窥灯，霜送晓寒侵被。",
        "无寐。",
        "无寐。",
        "门外马嘶人起。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 327023,
      "title": "如梦令",
      "content": [
        "幽梦匆匆破后。",
        "妆粉乱痕沾袖。",
        "遥想酒醒来，无奈玉销花瘦。",
        "回首。",
        "回首。",
        "绕岸夕阳疏柳。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 327024,
      "title": "如梦令",
      "content": [
        "楼外残阳红满。",
        "春入柳条将半。",
        "桃李不禁风，回首落英无限。",
        "肠断。",
        "肠断。",
        "人共楚天俱远。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 327025,
      "title": "如梦令",
      "content": [
        "池上春归何处。",
        "满目落花飞絮。",
        "孤馆悄无人，梦断月堤归路。",
        "无绪。",
        "无绪。",
        "帘外五更风雨。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 327026,
      "title": "阮郎归",
      "content": [
        "褪花新绿渐团枝。",
        "扑人风絮飞。",
        "秋千未拆水平堤。",
        "落红成地衣。",
        "游蝶困，乳莺啼。",
        "怨春春怎知。",
        "日长早被酒禁持。",
        "那堪更别离。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 327027,
      "title": "阮郎归",
      "content": [
        "宫腰袅袅翠鬟松。",
        "夜堂深处逢。",
        "无端银烛殒秋风。",
        "灵犀得暗通。",
        "身有恨，恨无穷。",
        "星河沈晓空。",
        "陇头流水各西东。",
        "佳期如梦中。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 327028,
      "title": "阮郎归",
      "content": [
        "潇湘门外水平铺。",
        "月寒征棹孤。",
        "红妆饮罢少踟蹰。",
        "有人偷向隅。",
        "挥玉箸，洒真珠。",
        "梨花春雨馀。",
        "人人尽道断肠初。",
        "那堪肠已无。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 327029,
      "title": "阮郎归",
      "content": [
        "湘天风雨破寒初。",
        "深沈庭院虚。",
        "丽谯吹罢《小单于》。",
        "迢迢清夜徂。",
        "乡梦断，旅魂孤。",
        "峥嵘岁又除。",
        "衡阳犹有雁传书。",
        "郴阳和雁无。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 327030,
      "title": "满庭芳",
      "content": [
        "北苑研膏，方圭圆璧，名动万里京关。",
        "碎身粉骨，功合上凌烟。",
        "尊俎风流战胜，降春睡、开拓愁边。",
        "纤纤捧，香泉溅乳，金缕鹧鸪斑。",
        "相如，方病酒，一觞一咏，宾有群贤。",
        "便扶起灯前，醉玉颓山。",
        "搜揽胸中万卷，还倾动，三峡词源。",
        "归来晚，文君未寝，相对晓妆残。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 327031,
      "title": "满庭芳",
      "content": [
        "晓色云开，春随人意，骤雨才过还晴。",
        "古台芳榭，飞燕蹴红英。",
        "舞困榆钱自落，秋千外、绿水桥平。",
        "东风里，朱门映柳，低底按小秦筝。",
        "多情。",
        "行乐处，珠钿翠盖，玉辔红缨。",
        "渐酒空金榼，花困蓬瀛。",
        "豆蔻梢头旧恨，十年梦，屈指堪惊。",
        "凭阑久，疏烟淡日，寂寞下芜城。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 327032,
      "title": "满庭芳",
      "content": [
        "雅燕飞觞，清谈挥座，使君高会群贤。",
        "密云双凤，初破缕金团。",
        "窗外炉烟似动，开瓶试、一品香泉。",
        "轻淘起，香生玉尘，雪溅紫瓯圆。",
        "娇鬟。",
        "宜美盼，双擎翠袖，稳步红莲。",
        "坐中客翻愁，酒醒歌阑。",
        "点上纱笼画烛，花骢弄、月影当轩。",
        "频相顾，馀欢未尽，欲去且流连。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 327033,
      "title": "桃源忆故人",
      "content": [
        "玉楼深锁薄情种。",
        "清夜悠悠谁共。",
        "羞见枕衾鸳凤。",
        "闷即和衣拥。",
        "无端画角严城动。",
        "惊破一番新梦。",
        "窗外月华霜重。",
        "听彻梅花弄。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 327034,
      "title": "调笑令",
      "content": [
        "回顾。",
        "汉宫路。",
        "捍拨檀槽鸾对舞。",
        "玉容寂寞花无主。",
        "顾影偷弹玉箸。",
        "未央宫殿知何处。",
        "目送征鸿南去。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 327035,
      "title": "调笑令",
      "content": [
        "辇路。",
        "江枫古。",
        "楼上吹箫人在否。",
        "菱花半璧香尘污。",
        "往日繁华何处。",
        "旧欢新爱谁是主。",
        "啼笑两难分付。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 327036,
      "title": "调笑令",
      "content": [
        "翡翠。",
        "好容止。",
        "谁使庸奴轻点缀。",
        "裴郎一见心如醉。",
        "笑里偷传深意。",
        "罗衣中夜与门吏。",
        "暗结城西幽会。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 327037,
      "title": "调笑令",
      "content": [
        "相慕。",
        "无双女。",
        "当日尚书先曾许。",
        "王郎明俊神仙侣。",
        "肠断别离情苦。",
        "数年睽恨今复遇。",
        "笑指襄江归去。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 327038,
      "title": "调笑令",
      "content": [
        "肠断。",
        "绣帘卷。",
        "妾愿身为梁上燕。",
        "朝朝暮暮长相见。",
        "莫遣恩迁情变。",
        "红绡粉泪知何限。",
        "万古空传遗怨。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 327039,
      "title": "调笑令",
      "content": [
        "恋恋。",
        "楼中燕。",
        "燕子楼空春色晚。",
        "将军一去音容远。",
        "空锁楼中深怨。",
        "春风重到人不见。",
        "十二阑干倚遍。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 327040,
      "title": "调笑令",
      "content": [
        "春梦。",
        "神仙洞。",
        "冉冉拂墙花树动。",
        "西厢待月知谁共。",
        "更觉玉人情重。",
        "红娘深夜行云送。",
        "困亸钗横金凤。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 327041,
      "title": "调笑令",
      "content": [
        "柳岸。",
        "水清浅。",
        "笑折荷花呼女伴。",
        "盈盈日照新妆面。",
        "水调空传幽怨。",
        "扁舟日暮笑声远。",
        "对此令人肠断。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 327042,
      "title": "调笑令",
      "content": [
        "眷恋。",
        "西湖岸。",
        "湖面楼台侵云汉。",
        "阿溪本是飞琼伴。",
        "风月朱扉斜掩。",
        "谢郎巧思诗裁翦。",
        "能动芳怀幽怨。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 327043,
      "title": "调笑令",
      "content": [
        "心素。",
        "与谁语。",
        "始信别离情最苦。",
        "兰舟欲解春江暮。",
        "精爽随君归去。",
        "异时携手重来处。",
        "梦觉春风庭户。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 327044,
      "title": "虞美人",
      "content": [
        "高城望断尘如雾。",
        "不见联骖处。",
        "夕阳村外小湾头。",
        "只有柳花无数、送归舟。",
        "琼枝玉树频相见。",
        "只恨离人远。",
        "欲将幽事寄青楼。",
        "争奈无情江水、不西流。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 327045,
      "title": "虞美人",
      "content": [
        "碧桃天上栽和露。",
        "不是凡花数。",
        "乱山深处水潆回。",
        "可惜一枝如画、为谁开。",
        "轻寒细雨情何限。",
        "不道春难管。",
        "为君沈醉又何妨。",
        "祗怕酒醒时候、断人肠。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 327046,
      "title": "虞美人",
      "content": [
        "行行信马横塘畔。",
        "烟水秋平岸。",
        "绿荷多少夕阳中。",
        "知为阿谁凝恨、背西风。",
        "红妆艇子来何处。",
        "荡桨偷相顾。",
        "鸳鸯惊起不无愁。",
        "柳外一双飞去、却回头。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 327049,
      "title": "品令",
      "content": [
        "幸自得。",
        "一分索强，教人难吃。",
        "好好地恶了十来日。",
        "恰而今、较些不。",
        "须管啜持教笑，又也何须肐织。",
        "衠倚赖脸儿得人惜。",
        "放软顽、道不得。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 327050,
      "title": "品令",
      "content": [
        "掉又惧。",
        "天然个品格。",
        "于中压一。",
        "帘儿下时把鞋儿踢。",
        "语低低、笑咭咭。",
        "每每秦楼相见，见了无限怜惜。",
        "人前强不欲相沾识。",
        "把不定、脸儿赤。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 327051,
      "title": "南歌子",
      "content": [
        "玉漏迢迢尽，银潢淡淡横。",
        "梦回宿酒未全醒。",
        "已被邻鸡催起、怕天明。",
        "臂上妆犹在，襟间泪尚盈。",
        "水边灯火渐人行。",
        "天外一钩残月、带三星。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 327052,
      "title": "南歌子",
      "content": [
        "愁鬓香云坠，娇眸水玉裁。",
        "月屏风幌为谁开。",
        "天外不知音耗、百般猜。",
        "玉露沾庭砌，金风动琯灰。",
        "相看有似梦初回。",
        "只恐又抛人去、几时来。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 327053,
      "title": "南歌子",
      "content": [
        "香墨弯弯画，燕脂淡淡匀。",
        "揉蓝衫子杏黄裙。",
        "独倚玉阑无语、点檀唇。",
        "人去空流水，花飞半掩门。",
        "乱山何处觅行云。",
        "又是一钩新月、照黄昏。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 327054,
      "title": "临江仙",
      "content": [
        "千里潇湘挼蓝浦，蓝桡昔日曾经。",
        "月高风定露华清。",
        "微波澄不动，冷浸一天星。",
        "独倚危樯情悄悄，遥闻妃瑟泠泠。",
        "新声寒尽古今情。",
        "曲终人不见，江上数峰青。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 327055,
      "title": "临江仙",
      "content": [
        "髻子偎人娇不整，眼儿失睡微重。",
        "寻思模样早心忪。",
        "断肠携手，何事太匆匆。",
        "不忍残红犹在臂，翻疑梦里相逢。",
        "遥怜南埭上孤篷。",
        "夕阳流水，红满泪痕中。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 327056,
      "title": "好事近",
      "content": [
        "春路雨添花，花动一山春色。",
        "行到小溪深处，有黄鹂千百。",
        "飞云当面化龙蛇，夭矫转空碧。",
        "醉卧古藤阴下，了不知南北。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 327057,
      "title": "失调名",
      "content": [
        "我会从事风流府。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 327058,
      "title": "添春色・醉乡春",
      "content": [
        "唤起一声人悄。",
        "衾冷梦寒窗晓。",
        "瘴雨过，海棠晴，春色又添多少。",
        "社瓮酿成微笑。",
        "半缺瘿瓢共舀。",
        "觉健倒，急投床，醉乡广大人间小。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 327059,
      "title": "南柯子・南歌子",
      "content": [
        "霭霭迷春态，溶溶媚晓光。",
        "不应容易下巫阳。",
        "祗恐翰林前世、是襄王。",
        "暂为清歌驻，还因暮雨忙。",
        "瞥然飞去断人肠。",
        "空使兰台公子、赋高唐。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 327060,
      "title": "失调名",
      "content": [
        "天若有情，天也为人烦恼。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 327061,
      "title": "失调名",
      "content": [
        "粽团桃柳，盈门共垒，把菖蒲、旋刻个人人。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 327062,
      "title": "画堂春",
      "content": [
        "东风吹柳日初长。",
        "雨馀芳草斜阳。",
        "杏花零落燕泥香。",
        "睡损红妆。",
        "香篆暗消鸾凤，画屏萦绕潇湘。",
        "暮寒轻透薄罗裳。",
        "无限思量。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 327063,
      "title": "木兰花慢",
      "content": [
        "过秦淮旷望，回萧洒、绝纤尘。",
        "爱清景风蛩，吟鞭醉帽，时度疏林。",
        "秋来政情味淡，更一重烟水一重云。",
        "千古行人旧恨，尽应分付今人。",
        "渔村。",
        "望断横门。",
        "芦荻浦、雁先闻。",
        "对触目凄凉，红凋岸蓼，翠减汀苹。",
        "凭高正千嶂暗，便无情到此也销魂。",
        "江月知人念远，上楼来照黄昏。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 327064,
      "title": "御街行",
      "content": [
        "银烛生花如红豆。",
        "这好事、而今有。",
        "夜阑人静曲屏深，借宝瑟、轻轻招手。",
        "一阵白苹风，故灭烛、教相就。",
        "花带雨、冰肌香透。",
        "恨啼鸟、辘轳声晓。",
        "岸柳微风吹残酒。",
        "断肠时、至今依旧。",
        "镜中消瘦。",
        "那人知后，怕你来僝僽。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 327065,
      "title": "青门饮",
      "content": [
        "风起云间，雁横天末，严城画角，梅花三奏。",
        "塞草西风，冻云笼月，窗外晓寒轻透。",
        "人去香犹在，孤衾长闲馀绣。",
        "恨与宵长，一夜薰炉，添尽香兽。",
        "前事空劳回首。",
        "虽梦断春归，相思依旧。",
        "湘瑟声沈，庾梅信断，谁念画眉人瘦。",
        "一句难忘处，怎忍辜、耳边轻咒。",
        "任人攀折，可怜又学，章台杨柳。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 327066,
      "title": "夜游宫",
      "content": [
        "何事东君又去。",
        "空满院、落花飞絮。",
        "巧燕昵喃向谁语。",
        "何曾解、说伊家、些子苦。",
        "况是伤心绪。",
        "念个人、又成睽阻。",
        "一觉相思梦回处。",
        "连宵雨、更那堪、闻杜宇。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 327067,
      "title": "醉蓬莱",
      "content": [
        "见扬州独有，天下无双，号为琼树。",
        "占断天风，岁花开两次。",
        "九朵一苞，攒成环玉，心似珠玑缀。",
        "瓣瓣玲珑，枝枝洁净，世上无花类。",
        "冷露朝凝，香风远送，信是琼瑶贵。",
        "料得天宫有，此地久难留住。",
        "翰苑才人，贵家公子，都要看花去。",
        "莫吝金钱，好寻诗伴，日日花前醉。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 327068,
      "title": "满江红",
      "content": [
        "越艳风流，占天上、人间第一。",
        "须信道、绝尘标致，倾城颜色。",
        "翠绾垂螺双髻小，柳柔花媚娇无力。",
        "笑从来、到处只闻名，今相识。",
        "脸儿美，鞋儿窄。",
        "玉纤嫩，酥胸白。",
        "自觉愁肠搅乱，坐中狂客。",
        "金缕和杯曾有分，宝钗落枕知何日。",
        "谩从今、一点在心头，空成忆。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 327069,
      "title": "一斛珠",
      "content": [
        "碧云寥廓。",
        "倚阑怅望情离索。",
        "悲秋自怯罗衣薄。",
        "晓镜空悬，懒把青丝掠。",
        "江山满眼今非昨。",
        "纷纷木叶风中落。",
        "别巢燕子辞帘幕。",
        "有意东君，故把红丝缚。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 333316,
      "title": "满庭芳",
      "content": [
        "山抹微云，天连衰草，画角声断谯门。",
        "暂停征棹，聊共引离尊。",
        "多少蓬莱旧事，空回首、烟霭纷纷。",
        "斜阳外，寒鸦万点，流水绕孤村。",
        "销魂。",
        "当此际，香囊暗解，罗带轻分。",
        "谩赢得、青楼薄名存。",
        "此去何时见也，襟袖上、空惹啼痕。",
        "伤情处，高城望断，灯火已黄昏。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 333319,
      "title": "满庭芳",
      "content": [
        "晓色云开，春随人意，骤雨才过还晴。",
        "古台芳榭，飞燕蹴红英。",
        "舞困榆钱自落，秋千外、绿水桥平。",
        "东风里，朱门映柳，低底按小秦筝。",
        "多情。",
        "行乐处，珠钿翠盖，玉辔红缨。",
        "渐酒空金，花困蓬瀛。",
        "豆蔻梢头旧恨，十年梦，屈指堪惊。",
        "凭阑久，疏烟淡日，寂寞下芜城。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    }
  ],
