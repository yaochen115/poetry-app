{
  "data": [
    {
      "id": 159693,
      "title": "励志二首  其二",
      "content": [
        "大哉天地经，森然不可逾。",
        "圣人治天下，纲常安厥居。",
        "谁谓遭大变，干戈血模糊。",
        "天地忽破碎，虎狼穴吾庐。",
        "毒气孽万物，草木俱焦枯。",
        "我为国之臣，于义当捐躯。",
        "受死不为痛，国家终何如。",
        "念此迫我心，万剑裂肌肤。",
        "骨腐尚衔冤，且为国家图。",
        "鬼神果有知，闻之亦欷歔。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 159694,
      "title": "春日偶成五绝  其一",
      "content": [
        "山塘游舫接荒城，纵有笙歌耳不清。",
        "深忆国家无事日，人心和气是春声。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159695,
      "title": "春日偶成五绝  其二",
      "content": [
        "晓来怕上最高楼，春尽时光只似秋。",
        "草木荒寒生意涩，风腥雨腻一天愁。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159696,
      "title": "春日偶成五绝  其三",
      "content": [
        "郡县荒芜哭暮笳，凭高望不见天涯。",
        "如今挥泪洒枯木，南国春回生紫华。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159697,
      "title": "春日偶成五绝  其四",
      "content": [
        "天地腥膻社稷隳，万邦赤子病流离。",
        "几番曾共秋风语，说得虚空亦泪垂。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159698,
      "title": "春日偶成五绝  其五",
      "content": [
        "百万胡儿犯大朝，奔南狩北恨迢迢。",
        "我非办得中兴事，一点英灵死不消。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159699,
      "title": "写愤三首  其一",
      "content": [
        "自许志颇大，频歌慷慨辞。",
        "攒眉无说处，仰面独行时。",
        "豪杰心犹檗，生灵命若丝。",
        "当今欲平治，舍我则云谁。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 159700,
      "title": "写愤三首  其二",
      "content": [
        "开眼看不得，愁来只自颠。",
        "六年万忧苦，四海一腥膻。",
        "叹命巧相值，观时痛可怜。",
        "却惭深夜月，犹忍照胡天。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 159701,
      "title": "写愤三首  其三",
      "content": [
        "朝廷罹祸乱，民物苦颠连。",
        "晋帝渡江谶，唐皇幸蜀年。",
        "剖云行白日，翻海洗青天。",
        "办得大事了，胸中即泰然。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 159702,
      "title": "偶成",
      "content": [
        "郡国残民少，君王何日归。",
        "不知秋后雁，犹得向南飞。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 159703,
      "title": "无题五首  其一",
      "content": [
        "屡问北来者，相传尽不同。",
        "三宫在何许，万姓堕愁中。",
        "春草活腥绿，雨花啼惨红。",
        "人间至微物，今亦怨天公。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 159704,
      "title": "无题五首  其二",
      "content": [
        "自古无兹难，我朝今遇之。",
        "小臣惭逆土，大事决成期。",
        "劫坏六龙死，天荒万象悲。",
        "时哉弗可失，奋发莫迟疑。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 159705,
      "title": "无题五首  其三",
      "content": [
        "一天凄怆事，此恨极难裁。",
        "骨纵已成土，心终不肯灰。",
        "毒蛇嘘树死，怨鸟哭春哀。",
        "处处山东老，悬情汉诏来。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 159706,
      "title": "无题五首  其四",
      "content": [
        "愁海茫茫望不穷，黄茅白苇渺阴风。",
        "凤凰高遁层霄外，豺虎横行大道中。",
        "九庙倾颓郊祀废，四方祸乱国家空。",
        "于今建武重兴汉，谁是云台第一功。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 159707,
      "title": "无题五首  其五",
      "content": [
        "鞠躬尽瘁吊无君，满耳冤声不忍闻。",
        "醉去忘形犹蜕骨，怒来嚼齿欲穿龈。",
        "腥风涴晓春应怨，痴雾霾空路莫分。",
        "荧惑星明圣人出，频频中夜验天文。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 159708,
      "title": "和文丞相六歌  其一",
      "content": [
        "我忆三宫幸朔方，天颜皴黑鬓发黄。",
        "鬼风尖尖割肌肉，惊沙扑损龙衣裳。",
        "群黎命死北魔手，世界缺陷苦断肠。",
        "小臣翅短飞未得，望破痴眼愁更长。",
        "呜呼一歌兮哀以伤，白日无光天荒荒。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 159709,
      "title": "和文丞相六歌  其二",
      "content": [
        "我忆二王血泪垂，一丝正统悬颠危。",
        "士卒零落若霜叶，阵前将军今有谁。",
        "以舟为国大洋里，万死一生终安归。",
        "至痛无声叫不响，皇天皇天知不知。",
        "呜呼再歌兮歌孔悲，风雨骤至昼冥迷。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 159710,
      "title": "和文丞相六歌  其三",
      "content": [
        "我忆我父在日时，叱我痴钝无天姿。",
        "旦旦灌溉仁义泽，灵台豁然开光辉。",
        "夙劫孤露命浊世，王事鞅掌生无期。",
        "一忆父母教我语，逃罪无地死亦迟。",
        "呜呼三歌兮泪淋漓，君父不在倚頼谁。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 159711,
      "title": "和文丞相六歌  其四",
      "content": [
        "我忆母氏兮圣善，劳苦家事手生茧。",
        "母后父死十五年，教我育我恩不浅。",
        "我虽贫拙志不屈，清气棱棱秋莹骨。",
        "至今一粟一缕丝，皆是父母流传物。",
        "呜呼四歌兮痛恻恻，皇天后土无终极。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 159712,
      "title": "和文丞相六歌  其五",
      "content": [
        "我所思兮文丞相，英风凛凛照穹壤。",
        "失身匍匐草莽间，屡迫以死弥忠壮。",
        "虚空可变心不变，吐语铿然金石响。",
        "想公骨朽化为土，生树开花亦南向。",
        "呜呼五歌兮并凄怆，望公不见愁泱漭。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 159713,
      "title": "和文丞相六歌  其六",
      "content": [
        "我生我生何不辰，血泪化作妖花春。",
        "平生意气若风云，何苦戚戚悲呻吟。",
        "狂来一呼天地动，万物鼓荡俱精神。",
        "天上真火灭不得，灼烁大地生光明。",
        "呜呼六歌兮歌声清，海岳莹洁日月新。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 159714,
      "title": "久雨后郊外独行",
      "content": [
        "新秧遭水毁，岁事正关情。",
        "日没虎狼出，城荒荆棘生。",
        "清流不可污，古道竟谁行。",
        "阔步独归去，茅簷月自明。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 159715,
      "title": "追奖",
      "content": [
        "谁谓匪人贱，犹怀事贼羞。",
        "挺身持大义，正语叱狂酋。",
        "名在春逾艳，骨香花不愁。",
        "有灵知国事，地下笑王侯。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 159716,
      "title": "咏怀二首  其一",
      "content": [
        "凤为百鸟王，孤飞无其友。",
        "览德而来仪，千载不一有。",
        "云胡德之衰，囚身狎鸡狗。",
        "我当愁来时，散发狂叫走。",
        "历历诉此苦，太空亦肯首。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 159717,
      "title": "咏怀二首  其二",
      "content": [
        "精卫虽至微，衔石尚填海。",
        "一点至烈心，千生万生在。",
        "我誓铭于天，语大莫能载。",
        "万万雷霆诛，此盟亦不坏。",
        "划然笑一声，今古生光彩。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 159718,
      "title": "一砺",
      "content": [
        "愈久愈不变，一忱生死俱。",
        "独行天与语，枯坐石为徒。",
        "血污衣冠国，冤浮盗贼区。",
        "何当洗兵马，终古统炎图。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 159719,
      "title": "忆前辈二首  其一",
      "content": [
        "昔在先皇帝，当阳四十年。",
        "文明照天下，俊杰立王前。",
        "一自胡兵入，俄惊汉鼎迁。",
        "致今人道乱，空谷遁遗贤。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 159720,
      "title": "忆前辈二首  其二",
      "content": [
        "治世衣冠盛，人才极典刑。",
        "开心呈日月，吐语走风霆。",
        "气象近三代，文章出六经。",
        "今焉不可得，四顾一冥冥。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 159721,
      "title": "续洗兵马",
      "content": [
        "遭时不祥厄阳九，垢面蓬鬓丧家狗。",
        "四夷交侵小雅废，率其子弟攻父母。",
        "封豕长蛇亘人域，天子下殿跣足走。",
        "凝碧池头乐最愁，连昌宫里花亦丑。",
        "三精雾塞黑曈曈，天破地裂一无有。",
        "谁执弓矢救日月，仰泣旻天大号吼。",
        "贤者不入胜母里，义士耻饮盗泉水。",
        "丈夫立身乃大事，一失此足死亦耻。",
        "当知孔明杲卿辈，岿然三代古君子。",
        "吕尚磻溪钓文王，乃是汉唐人才尔。",
        "到今大坏不可救，鸱枭破獍咀唇齿。",
        "高瞠双眼视天下，黔首浑敦状如鬼。",
        "龙堆大漠鸟兽夷，舌卷音响蛮侏离。",
        "不类人形舞百怪，错乱天命灾群黎。",
        "营州羯狗猪龙形，讵能篡有唐丕基。",
        "太子即位灵武日，天开万仞磨崖碑。",
        "载定尊卑奠鳌极，一新正朔授人时。",
        "渐被日出月没处，梯航臣妾拜京师。",
        "黄旗紫盖东南兴，大火王气浮晴春。",
        "勿欺一成一旅微，少康犹能作之君。",
        "班超已著王命论，陈婴王陵毋生心。",
        "绛衣大冠大敌勇，今日岂无刘将军。",
        "田野豪杰久延颈，一呼而动云来奔。",
        "我当率之效驰驱，整顿乾坤明大伦。",
        "旧邦新命光前王，逆俗污染咸惟新。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 159722,
      "title": "二砺二首  其一",
      "content": [
        "愁里高歌梁父吟，犹如金玉戛商音。",
        "十年勾践亡吴计，七日包胥哭楚心。",
        "秋送新鸿哀破国，昼行饥虎啮空林。",
        "胸中有誓深于海，肯使神州竟陆沉。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 159723,
      "title": "二砺二首  其二",
      "content": [
        "钧天梦冷紫宸春，臣子啣哀社稷屯。",
        "一缕血忱开白日，两篇心誓哭苍旻。",
        "渡江祖逖愿兴晋，蹈海仲连羞帝秦。",
        "回首故都宫阙恨，满山秋色正愁人。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 159724,
      "title": "题拙作后",
      "content": [
        "我有诗一编，率皆恳切辞。",
        "但写肺腑苦，不求言语奇。",
        "矢口吐愤气，焉知诗非诗。",
        "脆语剪风露，叨叨儿女痴。",
        "昂然大丈夫，以身佩安危。",
        "何时把杯酒，大笑信双眉。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 159725,
      "title": "三砺",
      "content": [
        "一砺二砺至万砺，盟执牛耳血为誓。",
        "灵台空莹白于秋，彻底不生乖戾气。",
        "眦裂齿碎志恳恳，貉之天性宁逾汶。",
        "我生一双霹雳手，终碎此虏为虀粉。",
        "天平地成风俗淳，一统永歌胡无人。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 159726,
      "title": "九日",
      "content": [
        "眼见今朝菊又黄，双扉渍泪唁凄凉。",
        "峥嵘岁月精神发，磅礴乾坤意气狂。",
        "新雁来时芳草死，归鸿尽处暮云长。",
        "后年箭主当回跸，始信山河再属唐。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 159727,
      "title": "菊花歌",
      "content": [
        "太极之髓日之精，生出天地秋风身。",
        "万木摇落百草死，正色与秋争光明。",
        "背时独立抱寂寞，心香贞烈透寥廓。",
        "至死不变英气多，举头南山高嵯峨。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 159728,
      "title": "餐菊花歌",
      "content": [
        "道人四时花为粮，骨生灵气身吐香。",
        "闻到菊花大欢喜，拍手歌笑频颠狂。",
        "忆昔我为混沌王，洞见末劫寿不长。",
        "尽召群仙列殿下，敕宣餐菊长生方。",
        "我今化身游下土，一嚼清凉彻肺腑。",
        "顿令心地豁然开，迸出明珠耀今古。",
        "普入变化妙如意，能为一切主中主。",
        "尘尘刹刹黄金身，永救娑婆众生苦。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 159729,
      "title": "爱竹歌",
      "content": [
        "此君气节极伟特，令人爱之舍不得。",
        "遍造山水有竹处，不问主人识不识。",
        "朝朝暮暮看不足，感得碧光透双目。",
        "一旦心空忽归去，挺身特立化为玉。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 159730,
      "title": "四砺二首  其一",
      "content": [
        "壮怀宁久淹，藏六暂穷櫩。",
        "道病人相食，时危笔不铦。",
        "哭衰愁里命，笑粲醉中髯。",
        "清怪每如是，从教俗士嫌。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 159731,
      "title": "四砺二首  其二",
      "content": [
        "说杀说不醒，世人良可叹。",
        "欣欣从北俗，往往弃南冠。",
        "毒露沾肤烂，尖风破骨寒。",
        "愿身化作剑，飞去斩楼兰。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 159732,
      "title": "五砺",
      "content": [
        "宋鼎终难问，元酋莫死争。",
        "九州俱是泪，一刻不容生。",
        "舌在身当贵，心真愿必成。",
        "但思湖海上，谁可与斯盟。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 159733,
      "title": "六砺三首  其一",
      "content": [
        "一听茶歌泪即流，更兼风叶响飕飕。",
        "不堪满地余残照，并与新寒合作愁。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159734,
      "title": "六砺三首  其二",
      "content": [
        "又是江空岁晚时，痛思国事独行迟。",
        "青山无语青天远，吐出丹心把向谁。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159735,
      "title": "六砺三首  其三",
      "content": [
        "操得南音类楚囚，早期戮力复神州。",
        "须知铁铸忠臣骨，纵作微尘亦不休。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159736,
      "title": "吊扬州琼花",
      "content": [
        "南土新飞劫火灰，琼仙恋国暗惊猜。",
        "定应摄向天宫种，不忍陷于胡地开。",
        "花死青春禽鸟哭，城埋黑气鬼神哀。",
        "一朝枯枿变高树，传得欢声沸似雷。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 159737,
      "title": "七砺",
      "content": [
        "天生忠义性，习俗岂能移。",
        "道在国常在，我知人不知。",
        "眼悬尧历象，心醉汉官仪。",
        "前日喃喃者，今谁语及斯。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 159738,
      "title": "八砺三首  其一",
      "content": [
        "黄道霾阴昼蚀光，野浮冤气白冥茫。",
        "世无圣主天应哭，时有忠臣国不亡。",
        "万刃攒身终莫变，一诚铭骨岂能忘。",
        "休嫌重复叨叨说，未奏肤公正断肠。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 159739,
      "title": "八砺三首  其二",
      "content": [
        "生得贞心铁石坚，肯将识见与时迁。",
        "泪如江水流成海，恨似山峰插入天。",
        "慷慨歌声闻屋外，婆娑剑影落灯前。",
        "篇篇字字皆盟誓，莫作空言只浪传。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 159740,
      "title": "八砺三首  其三",
      "content": [
        "愤气填膺奈若何，千生万死不消磨。",
        "夷齐道丧纲常坏，汤武兵兴叛逆多。",
        "天外游心穷碧落，风前注目寄苍波。",
        "此时此意那容说，环顾斜阳一浩歌。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 159741,
      "title": "梅花",
      "content": [
        "寒结痴阴惨物华，莫将憔悴听胡笳。",
        "明年无限风花在，夺得春回是此花。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159742,
      "title": "九砺",
      "content": [
        "忍死以待旦，蹉跎岁又残。",
        "堕身囚陷阱，尽命哭衣冠。",
        "月死虚空黑，春枯草木寒。",
        "床头雄剑在，白气夜盘盘。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 159743,
      "title": "辛巳岁立春作",
      "content": [
        "大辱痛于死，含哀吊岁华。",
        "叫云声草檄，恋阙梦宣麻。",
        "地走人形兽，春开鬼面花。",
        "年年北去妇，马上哭琵琶。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 159744,
      "title": "览镜",
      "content": [
        "朝来一览镜，抱负颇峥嵘。",
        "貌古烟霞气，诗新金玉声。",
        "郊坰常哭鬼，风雨自鸡鸣。",
        "所喜不靴笠，巍冠敝屣行。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 159745,
      "title": "独游",
      "content": [
        "吾非好独游，无与吾同者。",
        "不行众所行，所以惊天下。",
        "逆哉一世人，昔辩而今哑。",
        "吻涎流腥膻，变尾面不赭。",
        "若曰汝为人，宁不识取舍。",
        "止止勿多言，清风生四野。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 159746,
      "title": "十砺",
      "content": [
        "屏气处逆阱，衡虑画奇谋。",
        "指日誓血语，高空开青愁。",
        "决志揭大法，一洗天地羞。",
        "永使臣子辈，耻列伪逆俦。",
        "美俗薰古德，至治昭皇猷。",
        "一统万万世，海宇咸蒙休。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 159747,
      "title": "同",
      "content": [
        "一刻积一日，因循忽七年。",
        "孰云天道迩，不鉴下民冤。",
        "海陆频征战，城池尽变迁。",
        "吾君幸何地，数祷紫微垣。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 159748,
      "title": "十一砺四首  其一",
      "content": [
        "钱塘帝王都，宫阙高崔嵬。",
        "盛治蔼无外，鼓舞如春台。",
        "咸淳圣人去，山崩龙虎摧。",
        "弹指变晦冥，铁围生劫灰。",
        "丈夫吐一语，霍落飞风雷。",
        "直排四海水，并走天外来。",
        "手濯天地壳，永劫绝纤埃。",
        "唤醒群盲儿，欢喜双眼开。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 159749,
      "title": "十一砺四首  其二",
      "content": [
        "我本渔樵徒，山水足嘉遁。",
        "昔也为凤凰，今焉乃驽钝。",
        "反思生为人，虚食国家饭。",
        "讵甘死贼手，拑口违公论。",
        "孤忠破众逆，弥久气弥健。",
        "决当乘良机，为国行天宪。",
        "勇往直无前，一举四海劝。",
        "谈笑解倒悬，尽释下民怨。",
        "生或不就绪，死当偿夙愿。",
        "罔使竟食言，劫劫抱长恨。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 159750,
      "title": "十一砺四首  其三",
      "content": [
        "姬发誓孟津，集者八百国。",
        "当时尽弃商，喜受巨桥粟。",
        "独有首阳山，不生周草木。",
        "至今插天高，与商无终极。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 159751,
      "title": "十一砺四首  其四",
      "content": [
        "素持不杀戒，一视齐冤亲。",
        "今遭此大恶，不报无天伦。",
        "况闻曾子语，不取姑息仁。",
        "实为不得已，挺身事经纶。",
        "苟能悟昨非，赦汝改而新。",
        "负固变诈者，我恕佛亦嗔。",
        "直期后世后，弗忍为逆臣。",
        "惟愿吾与汝，同归天德淳。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 159752,
      "title": "十二砺",
      "content": [
        "攀断龙髯哭不回，鼎湖仙去下民灾。",
        "一身肉痛愁销骨，两脸颜枯瘦入腮。",
        "誓以匹夫纾国难，艰于乱世取人才。",
        "屡曾算至难谋处，裂破肺肝天地哀。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 159753,
      "title": "题明皇按乐图",
      "content": [
        "谁□銮舆向蜀行，梨园弟子歇新声。",
        "及知凝碧池头事，难得乐工雷海清。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159754,
      "title": "忆梦哭歌",
      "content": [
        "金轮王夭中天寿，赤龙夜哭玄蛇吼。",
        "仙人不忍辞汉去，青山照水生愁丑。",
        "虽贫亦有买醉资，甘美不入孤臣口。",
        "死后骨消恨不消，岁岁暗逐春风上新柳。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 159755,
      "title": "元贼谋取日本二绝  其一",
      "content": [
        "涉险应难得命还，倭中风土素蛮顽。",
        "纵饶航海数百万，不直龙王一怒间。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159756,
      "title": "元贼谋取日本二绝  其二",
      "content": [
        "海外东夷数万程，无仇于鞑亦生嗔。",
        "此番去者皆衔怨，试看他时秦灭秦。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159757,
      "title": "十三砺十首  其一",
      "content": [
        "我有一卷书，仗之以为命。",
        "所言非奇辞，教人归于正。",
        "昭昭灵台间，生死明于镜。",
        "愿为大医王，普治众生病。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 159758,
      "title": "十三砺十首  其二",
      "content": [
        "穷阴有巨蛇，蜿蜒数千里。",
        "磨牙雨毒雾，闻其气者死。",
        "我心不回邪，纵毒徒为尔。",
        "终将飞剑去，一击化为水。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 159759,
      "title": "十三砺十首  其三",
      "content": [
        "哀哉大数乖，妖魔填虚空。",
        "劫雨坏世界，欲与大海通。",
        "群愚扪空走，夺命鬼手中。",
        "阴极集万恼，愿天生暖风。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 159760,
      "title": "十三砺十首  其四",
      "content": [
        "苍苍南山松，特立孤峰巅。",
        "身此至正气，性于太初前。",
        "流泉近灵物，鬼饮之亦仙。",
        "况抱长生宝，永荫娑婆天。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 159761,
      "title": "十三砺十首  其五",
      "content": [
        "大哉万物母，清净光薿薿。",
        "独尊而为帝，天地亦其子。",
        "我见我之身，弹指魔王死。",
        "欢喜独自笑，清风万万里。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 159762,
      "title": "十三砺十首  其六",
      "content": [
        "北荒腾黑阴，飞妖蚀汉日。",
        "阊阖九重门，老胡骑马入。",
        "万世熙明殿，一朝鞑靼窟。",
        "江南荒野间，月黑鬼兵出。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 159763,
      "title": "十三砺十首  其七",
      "content": [
        "嗟汝儿女曹，至蠢亦孔丑。",
        "面笑心摇摇，欲进乃却走。",
        "憨痴弄盲语，捧酒祝鬼寿。",
        "伤哉复伤哉，醒眼频搔首。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 159764,
      "title": "十三砺十首  其八",
      "content": [
        "偶背文明时，万事暗苍莽。",
        "诏汝一世人，父亡子焉往。",
        "良心油然生，千载垂清响。",
        "与道同周流，光明塞穹壤。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 159765,
      "title": "十三砺十首  其九",
      "content": [
        "王道一陵夷，风俗愈卑隘。",
        "至于读书者，见利直下拜。",
        "一或持高论，聚笑议为怪。",
        "谁其振木铎，与世开聋聩。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 159766,
      "title": "十三砺十首  其一○",
      "content": [
        "夙生抱一诚，天亦莫能破。",
        "云胡白昼中，开眼而死坐。",
        "猛然风雨生，一叱万邪挫。",
        "卒使世上人，子孙未相贺。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 159767,
      "title": "题萧梅初旧所藏钱塘王畿图二首  其一",
      "content": [
        "阴山腥马蹂京尘，锁杀宫花不识春。",
        "哭问钱塘江上月，如今谁是去邠人。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159768,
      "title": "题萧梅初旧所藏钱塘王畿图二首  其二",
      "content": [
        "抚膺唁国问苍苍，郭唶声中喜气昌。",
        "偷报故都忠义士，赵家天下又南阳。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159769,
      "title": "十四砺二首  其一",
      "content": [
        "法驾遥巡六载余，农桑烟火顿萧疏。",
        "深山大泽精灵哭，赤县神州鸟兽居。",
        "天下黄金归朔漠，南中白骨蔽郊墟。",
        "漳泉数郡屡反正，賸有忠臣野史书。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 159770,
      "title": "十四砺二首  其二",
      "content": [
        "六合漫空一网罗，驱徭椎剥极烦苛。",
        "星辰错乱历无准，天地阴寒气不和。",
        "汉室公卿周勃少，河梁朋友李陵多。",
        "蹴然发叹悲风过，渺渺吴淞卷白波。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 159771,
      "title": "十五砺二首  其一",
      "content": [
        "国家今板荡，旧物一微丝。",
        "至苦说不得，长怀病似痴。",
        "人心危陷阱，天理过蓍龟。",
        "頼有二盟在，宁无吐气时。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 159772,
      "title": "十五砺二首  其二",
      "content": [
        "王畿三辅地，谁信卷风沙。",
        "南货北填市，北人南住家。",
        "乱招城聚虎，毒入土生蛇。",
        "说著未来事，战争宁有涯。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 159773,
      "title": "十六砺",
      "content": [
        "双眼荒荒不寐时，冥搜俊杰慕夷齐。",
        "谶符铁券虏当灭，梦出玉清天亦低。",
        "城里月明闻虎过，人间夜久望鸡啼。",
        "深怜举国巅崖底，谁搆悬空万丈梯。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 159774,
      "title": "六月大雨后作",
      "content": [
        "推上沧溟犯玉京，业龙鼓怒恣纵横。",
        "青天忽破鬼神走，黑雨骤来山岳倾。",
        "混沌重新开覆载，虚空顿觉发光明。",
        "如今清净浑无碍，一日南风万物荣。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 159775,
      "title": "二唁诗 丞相陈公",
      "content": [
        "相国生东瓯，应谶海坛沙。",
        "早观上国光，辟雍飞声华。",
        "叫云骂奸权，远窜走天涯。",
        "十年登要津，文彩绚晴霞。",
        "中台势将圻，大拜宣黄麻。",
        "国步正孔棘，盲涂相牵拏。",
        "鬼盗杀机弄，平陆哄龙蛇。",
        "黔首心不正，居然中阴邪。",
        "蛛丝网黄屋，六宫妃嫔髽。",
        "公奉二王奔，脱命毫发差。",
        "沥胆酹上帝，哭断口大呀。",
        "南邦血糊地，春深草不芽。",
        "鬼气射死树，腥妖幻毒花。",
        "万痛集如虿，百怪鸣如蛙。",
        "蚀尽朱垠天，国寄海上槎。",
        "始知上色玉，洁白浑无瑕。",
        "垢衣悬相印，独御指南车。",
        "沍寒冻不死，微微命一漥。",
        "刀圭返魂丹，阳和匝迩遐。",
        "生擒左贤王，刳腹盐为豝。",
        "却视旧朝士，一一谁忠嘉。",
        "万古虚空中，一伪不可加。",
        "傒我王师来，动地腾喧哗。",
        "雷霆破恶逆，四海仍一家。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 159776,
      "title": "二唁诗 少保张公",
      "content": [
        "将军本北人，归顺年已久。",
        "擢身将校中，腰绾中国绶。",
        "身润白玉洁，面狞黑铁丑。",
        "刚勇有武威，功出众人右。",
        "一朝天柱折，当昼丰其蔀。",
        "阴阳反铁炭，桮棬贼杞柳。",
        "公卿文章士，尽醉马乳酒。",
        "未闻天地间，生死反噬狗。",
        "幸有张将军，强哉气赳赳。",
        "生死不携异，宁受奸宄狃。",
        "平生铁石肠，明白照九有。",
        "荧荧赤伏符，百拜悬右肘。",
        "谋画入微茫，僵目拇撑口。",
        "死战拓山开，高擎日月走。",
        "剖心𫗪龙雏，淋漓血双手。",
        "圣火寿绵绵，凡水焉能溲。",
        "瞬目出死关，命在事非偶。",
        "张巡埋骨地，顽石变琼玖。",
        "白光射天门，璀璨夺星斗。",
        "英气磨不坏，生公踵其后。",
        "播荡大海外，若子死恋母。",
        "屈指我世祖，建武又乙酉。",
        "恶兽脑百裂，始识狮子吼。",
        "天风吹新雨，浊劫净无垢。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 159777,
      "title": "辛巳夏七月",
      "content": [
        "辛巳夏七月，初五日正午。",
        "太白灿然见，太阴亦俱覩。",
        "索历验其次，太白躔在午。",
        "兵争周分野，天下气当吐。",
        "敬以诗识之，储为史官补。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 159778,
      "title": "避暑入古寺",
      "content": [
        "避暑入古寺，暂尔遣骚屑。",
        "心静凉于秋，倏然适清悦。",
        "彼哉谁氏子，对弈气争杰。",
        "惜其二低手，彼此蔑奇著。",
        "旁观发冷笑，连呼错错错。",
        "救之不可及，流视入寥廓。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 159779,
      "title": "十七砺",
      "content": [
        "我有真黄金，只作土价卖。",
        "陪笑遍示人，竟无一人买。",
        "日暮哭归来，反为众所怪。",
        "安得明眼人，与之语痛快。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 159780,
      "title": "昭君叹",
      "content": [
        "汉朝远人来入使，当时公卿短奇计。",
        "紫清殿内一朵花，狂风妬春吹落地。",
        "命堕穷阴鬼为侣，回首玉皇紫清里。",
        "旧愁新愁东海深，黄鹂舌破伤春事。",
        "江南绝色天下夸，元贼尽虏归胡沙。",
        "或以嫁之鬻伪爵，于飞马背行天涯。",
        "年深乐与生子女，情热比翼忘咨嗟。",
        "果知礼义不忍去，亦有一死魂还家。",
        "德祐百官人稷契，腹饱理学纵横说。",
        "尚弃君父从背叛，乃教妻妾学贞烈。",
        "男儿或老不晓事，女子正少欲守节。",
        "天生至性教不得，时危罕见人中杰。",
        "能尽妇道能诲儿，王陵之母王凝妻。",
        "世间妇人谁及之，空恨昭君上马时。",
        "颜色日老单于死，万里魂归身不归。",
        "广寒嫦娥今尘土，应见青冢双泪垂。"
      ],
      "author": {
