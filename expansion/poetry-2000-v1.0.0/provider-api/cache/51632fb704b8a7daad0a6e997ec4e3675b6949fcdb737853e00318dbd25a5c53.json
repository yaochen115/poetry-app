{
  "data": [
    {
      "id": 163319,
      "title": "昝相公送锦被",
      "content": [
        "蜀都府主迎宾客，赠我蜀锦三百尺。",
        "美人䔩䔩弄金梭，鸳鸯机上初成疋。",
        "繁花乱蘂皆同心，艳枿中含杜鹃血。",
        "玉妃如霜姑射仙，金刀剪破云霞缬。",
        "为我裁成合欢被，细意密缝无线迹。",
        "道人把玩色相射，银海光摇泪珠滴。",
        "却忆故家初破时，绣龙画雉如砂石。",
        "绮窗窈窕花离离，红粧万镜娇无力。",
        "百幅锦帆风不动，绿湿红鲜荡春碧。",
        "纷华过眼一梦如，蜀锦吴绫复何益。",
        "白茅安用红锦包，虎皮难以裹羊质。",
        "只今卷锦还府主，心地了然无得失。",
        "铜壶漏断银缸灭，昆仑影转初三月。",
        "道人坐久闻妙香，纸帐蒲团自清绝。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 163320,
      "title": "社牲",
      "content": [
        "年登敛牲钱，日吉视牢䇲。",
        "烹庖香满村，未觉膰脤窄。",
        "馂余裹青蒻，篱落笑言哑。",
        "咄哉陈孺子，乃有天下责。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 163321,
      "title": "寄李鹤田",
      "content": [
        "南泉多载夜光还，健步移梅种玉山。",
        "八十二翁犹矍铄，苦吟不放此心闲。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 163322,
      "title": "寄赵青山同舍  其一",
      "content": [
        "六馆风流不可寻，形骸土木泪痕深。",
        "有时咄咄空书字，俗子宁知我辈心。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 163323,
      "title": "寄赵青山同舍  其二",
      "content": [
        "短褐离披紫凤图，非扬非墨亦非儒。",
        "独怜后辈欺前辈，自笑今吾即故吾。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 163324,
      "title": "寄赵青山同舍  其三",
      "content": [
        "聚嘲丛谤腐儒痴，江海漂零酒一巵。",
        "闲把至音调绿绮，朗吟新句写乌丝。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 163325,
      "title": "寄赵青山同舍  其四",
      "content": [
        "谢傅东山喜劫棋，刘生南岳怕联诗。",
        "君侯自有通身胆，用舍行藏且顺时。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 163326,
      "title": "唐律寄呈父凤山提举  其一",
      "content": [
        "西兴渡口乱啼鸦，锦缆牵江目力赊。",
        "六馆衣冠沦道路，三宫珠玉走风砂。",
        "山川不尽心难老，岁月忧煎髪渐华。",
        "行到湘南归不得，倚门应是望天涯。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 163327,
      "title": "唐律寄呈父凤山提举  其二",
      "content": [
        "黄帽催人急放舟，荻花枫叶共飕飕。",
        "天公作恶云翻手，河伯为妖风打头。",
        "接翅野鸦围古堞，断行孤雁落中州。",
        "吴山只隔淮山路，江北江南处处愁。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 163328,
      "title": "唐律寄呈父凤山提举  其三",
      "content": [
        "燕山只在乱云边，过了黄河便豁然。",
        "鼠帽蒙头车上坐，貂裘拥鼻草间眠。",
        "秋砧捣落千营月，晓寨炊残万灶烟。",
        "说与奚奴休笑我，诗人要看好山川。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 163329,
      "title": "唐律寄呈父凤山提举  其四",
      "content": [
        "锦帆浩荡湿龙鸾，乐指三千粉泪寒。",
        "万里远行看日近，一人不杀见天宽。",
        "玉关屡沐军罗拜，金殿时蒙上问安。",
        "宴罢御香携满袖，醉归环珮月中看。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 163330,
      "title": "唐律寄呈父凤山提举  其五",
      "content": [
        "昔年去国大苍黄，同舍诸生半死亡。",
        "春别浙江花似雾，秋行碛地草如霜。",
        "时沽市酒借余景，屡宿官邮悲故乡。",
        "满目故人皆厚禄，吾侪添得两奚囊。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 163331,
      "title": "唐律寄呈父凤山提举  其六",
      "content": [
        "抱琴挟策马萧萧，北望燕云道路遥。",
        "紫塞晓行闻雁叫，黄河夜渡见鱼跳。",
        "周回四蜀愁双剑，浩荡三湘梦六桥。",
        "踏遍乾坤犹是客，小山丛桂不能招。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 163332,
      "title": "唐律寄呈父凤山提举  其七",
      "content": [
        "夜来梦里到吾庐，梦破潸然泪似珠。",
        "吴女北游簪素柰，湘娥南望泣苍梧。",
        "风吹远浦秋鸿杳，月出空山夜鹤孤。",
        "忽忆西湖梅与柳，梦随云水度西湖。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 163333,
      "title": "唐律寄呈父凤山提举  其八",
      "content": [
        "南岳诸峰处处嘉，麻鞋竹杖蹑青霞。",
        "山前已见九杈□，洞里不逢三朵花。",
        "岩瀑垂垂腾晓蜃，野田渺渺落寒鸦。",
        "衡阳鼓角风悲咽，游子斯时正忆家。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 163334,
      "title": "唐律寄呈父凤山提举  其九",
      "content": [
        "愁来不可更禁当，望鬼门关断尽肠。",
        "无处告诉只欲死，有时颠倒忽成狂。",
        "三湘风雨失舟檝，万里路岐多雪霜。",
        "遥忆武林社中友，下湖箫鼓醉红装。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 163335,
      "title": "唐律寄呈父凤山提举  其一○",
      "content": [
        "自笑儒衣世法疏，穷愁何日得伸舒。",
        "一从挟策来燕地，几拟陈情乞鉴湖。",
        "风雨凄凄鸿雁瘦，雪霜凛凛鹡鸰孤。",
        "湘江楼上无憀甚，不见吴山似画图。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 163336,
      "title": "衡山道中寄平远赵宣慰",
      "content": [
        "回雁峰前问讯，楚江几度兰香。",
        "望美人兮何许，水云隔断潇湘。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 163337,
      "title": "月夜听琴",
      "content": [
        "如此良夜，秋空月圆。",
        "君弹山鬼，我拊水仙。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 163338,
      "title": "听徐雪江琴",
      "content": [
        "徐卿寒夜弹玉琴，冻云妬月波澄阴。",
        "海上神峰削幽翠，十二楼前玉妃坠。",
        "湘娥素女相对泣，翠竹苍梧泪痕湿。",
        "幽兰不香蕙花死，千愁万怨青枫里。",
        "风敲叶脱雨如啸，百鸟喧啾孤凤叫。",
        "老龙吐珠赤洒洒，山鬼摇𣟴走堂下。",
        "徐卿徐卿且停手，呼儿割鸡酌春酒。",
        "曲高调古人不识，侧耳西楼咽筝笛。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 163339,
      "title": "昝舍人锦江泛舟",
      "content": [
        "舍人与客放船开，网得鲸鱼饷酒杯。",
        "西川锦雀甜如蜜，录事相分二百枚。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 163340,
      "title": "昝元帅相拉浣花溪泛舟",
      "content": [
        "行都元帅千蹄马，腰佩角弓箭盈把。",
        "浣花溪头具小舟，击鼓吹箫行酒斝。",
        "舞腰嬝娜锦缠头，风吹金缕随东流。",
        "公孙弟子背面笑，拔剑一击蛟龙愁。",
        "万里桥西有茅屋，杜子当年来卜筑。",
        "湘江一醉不复归，四松寂寞擎寒玉。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 163341,
      "title": "麻姑仙坛歌",
      "content": [
        "麻姑飘飘出烟雾，红尾凤飞骑不住。",
        "青城山高风露寒，珮环挂著山花树。",
        "花雾蒙蒙香湿衣，一点柔红泻香露。",
        "群仙行酒擘麒麟，玉盌金盘间犀筯。",
        "琼璈铁笛含氤氲，二十三弦语幽素。",
        "琼台醼罢醉不归，月出昆仑天未曙。",
        "青衣结束金丝蘂，鹤扇双行引归路。",
        "白云叠叠水潺潺，神仙窟宅知何处。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 163342,
      "title": "蚕丛祠",
      "content": [
        "西蜀风烟天一方，蚕丛古庙枕斜阳。",
        "茫然开国人天主，仿佛鸿荒盘古王。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 163343,
      "title": "神女祠",
      "content": [
        "野庙凄凉向峡中，断崖无路一从容。",
        "楚王神女知何在，云锁巫山十二峰。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 163344,
      "title": "湘夫人祠",
      "content": [
        "舟维古渡小从容，二女含嚬媚晚风。",
        "野庙半间蒙薜荔，湘江两岸泣芙蓉。",
        "玉台有镜蝌铭古，锦瑟无弦雁柱空。",
        "行近祠南默惆怅，倚筇江上数青峰。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 163345,
      "title": "明皇庙",
      "content": [
        "三郎幸蜀大琅珰，夜雨闻铃欲断肠。",
        "遗庙至今香火閙，女巫调笑舞霓裳。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 163346,
      "title": "锦江蜀先主庙",
      "content": [
        "国破人何在，宫名喜尚存。",
        "虽云蜀先主，犹是汉诸孙。",
        "吴魏不相下，关张岂少恩。",
        "崩年在三峡，遗恨满乾坤。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 163347,
      "title": "后主庙",
      "content": [
        "汉贼不两立，英雄恨不平。",
        "孔明劳已死，仲达走还生。",
        "双剑鹰鹯急，三秦虎豹横。",
        "东南无霸气，恢复恐难行。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 163348,
      "title": "忠武侯庙",
      "content": [
        "夔门春水拍天流，人日倾城踏碛游。",
        "古庙虫蛇穿画壁，竹风溪雨共啾啾。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 163349,
      "title": "蜀相庙",
      "content": [
        "我谒武侯祠，阴廊草凄凄。",
        "当时南阳结庐学龙卧，深山大泽无人知。",
        "胡为蜀先主，三顾前致辞。",
        "欲烦恢复天下计，先生筹策天下奇。",
        "浩然出山来，凛凛虎豹姿。",
        "乘时既得人，上曰真吾师。",
        "已晓关与张，二子不复疑。",
        "孤有孔明在军中，如龙有水相因依。",
        "历数既有归，破贼当自兹。",
        "可怜复汉社稷心未已，当时三峡图垒空巍巍。",
        "先生有才过曹丕，中原恢复未可知。",
        "惜哉军务劳，一心死无私。",
        "出师一表如皎日，千古万古鸿名垂。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 163350,
      "title": "嘉定府",
      "content": [
        "郡楼著眼蜀天宽，分得巴江水一湾。",
        "大小峨眉相对立，梨花山接海棠山。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 163351,
      "title": "函谷关",
      "content": [
        "田文夜半至函关，鸡未鸣时去路难。",
        "不是三千珠履客，如何秦地得生还。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 163352,
      "title": "南岳道中  其一",
      "content": [
        "南岳阴阴松道凉，又骑站马望荆襄。",
        "山中老柏滴寒翠，江上危峰撑夕阳。",
        "昔往不堪经滟滪，此行重得看潇湘。",
        "三宫万里知安否，何日檀栾把寿觞。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 163353,
      "title": "南岳道中  其二",
      "content": [
        "夜来大醉别衡阳，今日长吟下楚湘。",
        "翠藻青苹鱼市井，白苹红蓼雁家乡。",
        "江云起处蒙蒙湿，山雨来时陈陈凉。",
        "欹枕不禁肝肺热，汪然流涕惜兴亡。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 163354,
      "title": "旧内曲水池",
      "content": [
        "锦沟引水入觞池，两两金船上下驰。",
        "春季夫人扶辇疾，玉堂学士带花迟。",
        "当时行乐虽然秘，此日遗踪自可悲。",
        "回首支郎新栋宇，浮屠千尺白差差。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 163355,
      "title": "幽州城南江乡园",
      "content": [
        "幽州城南花满溪，秋千摇飏高复低。",
        "吹笙击鼓园之西，金鞍马踏芳草堤。",
        "花娘满眼歌声齐，今日烂醉归去兮。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 163356,
      "title": "吴山",
      "content": [
        "海枯龙去雨淋淋，羯鼓諠哗山禁林。",
        "虎士堕弢兵力倦，鸡人罢箭漏声沈。",
        "鶑摇御柳春犹閙，燕蹴宫花雾转深。",
        "肠断木绵庵里客，可怜郿坞筑黄金。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 163357,
      "title": "青城山",
      "content": [
        "敕使穿云破湿苔，水边坐石更行杯。",
        "翩翩野鹤飞如舞，冉冉岩花笑不来。",
        "乱木交柯盘圣井，数峰削玉并仙台。",
        "平明绝顶穷幽讨，更上青城望一回。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 163358,
      "title": "黄州江下",
      "content": [
        "黄州渡口，赤壁矶头。",
        "冷风凄雨，一叶扁舟。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 163359,
      "title": "巴江",
      "content": [
        "巴□鼓櫂兴悠悠，野鹿衔花出峡头。",
        "网得巨鱼堪切脍，携觞重上荔枝楼。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 163360,
      "title": "庐山三叠泉",
      "content": [
        "唐不过李仙，宋不过苏子。",
        "此泉来高处，亦复聊尔耳。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 163361,
      "title": "药市  其一",
      "content": [
        "成都五月，家家列药于市，以为盛事。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 163362,
      "title": "药市  其二",
      "content": [
        "蜀乡人是大医王，一道长街尽药香。",
        "天下苍生正狼狈，愿分良剂救膏肓。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 163363,
      "title": "蜀主芙蓉城",
      "content": [
        "芙蓉城上草萋萋，吊古徘徊日欲西。",
        "帝子不来花蘂去，荒宫无主乱鸦啼。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 163364,
      "title": "牡丹平",
      "content": [
        "长平山上紫云封，蜀老相传隠者宫。",
        "高树蔽天三十里，开花十丈舞春风。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 163365,
      "title": "百花潭",
      "content": [
        "万里扬鞭到益州，旌旗小队锦江头。",
        "红船载酒环歌女，摇荡百花潭水秋。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 163366,
      "title": "蚕市",
      "content": [
        "成都美女白如霜，结伴携筐去采桑。",
        "一岁蚕苗凡七出，寸丝那得做衣裳。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 163367,
      "title": "废苑见牡丹黄色者",
      "content": [
        "西园兵后草茫茫，亭北犹存御爱黄。",
        "晴日暖风生百媚，不知作意为谁香。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 163368,
      "title": "慈元殿赐牡丹",
      "content": [
        "九重羯鼓声动地，万年枝上回春意。",
        "天遣姮娥散一枝，一枝先到山人家。",
        "焚香再拜臯国色，雨露沾濡知帝力。",
        "我愿人间春不老，长对此花颜色好。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 163369,
      "title": "昌州海棠有香  其一",
      "content": [
        "我到昌州看海棠，恰逢时节近重阳。",
        "人言好种亦难得，只有州衙一树香。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 163370,
      "title": "昌州海棠有香  其二",
      "content": [
        "香霏堂上树婆娑，不见嫣然亦可嘉。",
        "且向秋风一杯酒，枝头的的两三花。",
        "夜梦花仙索我诗，他山别种世间稀。",
        "一年四季花如锦，莫把娇姿比贵妃。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 163371,
      "title": "锦城秋暮海棠",
      "content": [
        "锦城海棠妙无比，秋光染出胭脂蘂。",
        "日照殷红如血鲜，箭砂粧粒真珠子。",
        "玉环著酒睡初觉，脸薄粉香泪如洗。",
        "绛纱穿露水晶圆，笑杀荷花守红死。",
        "蜀乡海棠根本别，有色有香成二美。",
        "春花开残秋复花，簸弄东君权不已。",
        "锦袍公子汗血驹，宾客諠哗间朱紫。",
        "有酒如池肉如山，银烛千条照罗绮。",
        "萧娘十八青丝髪，手把金钟歌皓齿。",
        "神仙艳骨世所无，歌声直入青云里。",
        "江南倦客惨不乐，鸣笛哀筝乱人耳。",
        "干戈满地行路难，屏里吴山数千里。",
        "遥怜花国化青芜，浪蘂浮花敢欣喜。",
        "草堂无诗花无德，窃号花仙宁不耻。",
        "春花撩乱亦可怜，秋花烂熳何为尔。",
        "花前妙舞曲未终，红雪纷纷落流水。",
        "薄命佳人只土尘，抛杯拔剑长歌起。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 163372,
      "title": "九月九日赏红叶  其一",
      "content": [
        "天平山木似花开，青女裁成锦绣堆。",
        "暂借秋光作春色，白衣解遣曲生来。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 163373,
      "title": "九月九日赏红叶  其二",
      "content": [
        "凤凰山上少人家，红叶漫山映落霞。",
        "却笑陶潜归栗里，东篱寂寞对黄花。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 163374,
      "title": "云安闻鹃",
      "content": [
        "云安风景愚能说，苍峡风掀浪如雪。",
        "杜鹃叫得口流血，染遍山花归不得。",
        "臣甫再拜哦新诗，诗成甫也成愁绝。",
        "都人重是古帝魂，敬重此鸟心不辍。",
        "不知此鸟知不知，四时叫得巴山裂。",
        "却忆群姬左右趋，三十六宫醉花月。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 163375,
      "title": "小桃源入三岩观鱼",
      "content": [
        "眉州城外小桃源，行入三岩涧水喧。",
        "人近碧潭才抚掌，唤鱼出洞跳龙门。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 163376,
      "title": "永安宫",
      "content": [
        "蜀主遗宫有古槐，颓墙古木鸟喈喈。",
        "金舆罢幸荒金屋，玉仗休班废玉阶。",
        "三峡浪舂红日碎，两崖风振黑云霾。",
        "孔明图垒仍登览，野寺残僧拾堕柴。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 163377,
      "title": "眉州借景亭",
      "content": [
        "巍亭借景引壶觞，元祐诗人翰墨香。",
        "苍峡雷霆龙意气，碧崖烟雨豹文章。",
        "隔邻修竹娟娟静，夹道枯桑冉冉黄。",
        "水泛帘栊簷影倒，风吹城堞角声长。",
        "巴童结束歌仍俊，蜀女腰肢舞亦狂。",
        "千古相望翁季在，眉山草木有辉光。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 163378,
      "title": "夔门",
      "content": [
        "赤甲山连白帝山，三巴三峡百牢关。",
        "孤舟行客愁无那，十二峰前十二滩。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 163379,
      "title": "夔门驿",
      "content": [
        "宿酲未解据胡床，亭午披衣望麝香。",
        "三峡夜来天似水，百蛮秋后月如霜。",
        "洲前橘柚垂垂实，石上藤萝细细长。",
        "又欲拏舟过滟滪，黄牛白狗接高唐。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 163380,
      "title": "草堂  其一",
      "content": [
        "子美西来筑此堂，浣花春水共凄凉。",
        "鸣鸠乳燕归何处，野草闲花护短墙。",
        "英雄去矣柴门闭，邻里伤哉竹径荒。",
        "安得山缾盛乳酒，送分渔父濯沧浪。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 163381,
      "title": "草堂  其二",
      "content": [
        "白髪遨游梓阆间，中原戎马未平安。",
        "粗饭浊醪常欠缺，老妻稚子半饥寒。",
        "扁舟出峡风涛壮，短褐行湘天地宽。",
        "侨寓耒阳牛酒饱，不知曾忆使君滩。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 163382,
      "title": "剑门",
      "content": [
        "剑门崔嵬若相抗，云栈萦回千百丈。",
        "石角钩连皆北向，失势一落心胆丧。",
        "侧身西望不可傍，猛虎毒蛇相下上。",
        "安得朱亥袖椎来，为我碎打双叠嶂。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 163383,
      "title": "琴台",
      "content": [
        "文园多病厌文君，恨入金徽不忍闻。",
        "寂寞高台留古迹，来牛去马自成群。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 163384,
      "title": "严郑公故宅",
      "content": [
        "蜀山突兀接青天，郑公故宅城相连。",
        "深深古木哀黄鸟，漠漠荒烟哭杜鹃。",
        "舞罢遗钿流水外，战余折戟落花前。",
        "将军好武通文墨，割据操心未必然。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 163385,
      "title": "花蕊夫人故宅  其一",
      "content": [
        "千古风流一梦中，江山阅尽几英雄。",
        "芙蓉城里家何在，花蘂夫人宅已空。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 163386,
      "title": "花蕊夫人故宅  其二",
      "content": [
        "宅前宅后好青山，零落重门半掩关。",
        "玉貌久归天上去，宫词百首落人间。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 163387,
      "title": "重访草堂",
      "content": [
        "放櫂花谿去，重来访草堂。",
        "菰蒲依静渚，杨柳遶回塘。",
        "野堑棨高下，山墙竹短长。",
        "槁梧含古色，瘦菊减清香。",
        "鼙鼓檛三叠，旌旗列两行。",
        "花娘纷舞袖，座客竞飞觞。",
        "醤蘸生葱白，虀浇熟韭黄。",
        "洪炉催卷餠，匕首割烧羊。",
        "大笑诸公醉，高谈小子狂。",
        "城关犹未掩，冠盖已飞扬。",
        "鸟语青松里，人行锦树傍。",
        "杜陵轻出峡，千古隔潇湘。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 163388,
      "title": "忠州荔枝楼小憩",
      "content": [
        "竟日扬鞭不暂闲，畏途叠叠是青山。",
        "西风吹落忠州去，锦绣窠中屋万间。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 163389,
      "title": "光相寺",
      "content": [
        "峨眉县西四十里，峭壁悬崖削寒翠。",
        "崎岖栈道动摇摇，矮石支撑同赑屭。",
        "忽窥万仞黑无底，下有龙渊七十二。",
        "攀扪步步足难移，大盘小盘八十四。",
        "行行更入娑罗平，侧立长嗟心胆碎。",
        "洗脚溪头登土峰，板屋数间光相寺。",
        "寺中萧然无个僧，普贤小殿生阴气。",
        "天仙桥上光明岩，银色光中世界异。",
        "须臾风雨洗天来，兜罗绵云塞天地。",
        "虚空现出大圆光，五色晕中瞻大士。",
        "日暮云收山寂然，乙夜灯分百千计。",
        "别有草庵三四僧，花木满轩颇清致。",
        "有时云起自雷岩，两道金光出岩际。",
        "有时云散光独明，犹见光中回象辔。",
        "僧云又有清现光，白日无云光更丽。",
        "奇花异草吹香风，怪兽珍禽左右至。",
        "善财童子何许来，五十三参见真谛。",
        "神通变化无了时，如幻如梦复如戏。",
        "胡为狡狯弄精魂，机事机心极无谓。",
        "儒生持此问山僧，僧曰如是观如是。",
        "若言有相更有光，灵化千千诚小技。",
        "何如无光复无相，湛寂名为第一义。",
        "菩萨空中数点头，收敛圆光无一事。",
        "雪山万点白差差，初日照之光毳毳。",
        "遥瞻天竺立绵延，我欲游观足如系。",
        "平生兹游真冠绝，走笔成诗图快意。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 163390,
      "title": "峡边山寺",
      "content": [
        "寺近阴崖多雾雨，峡边灵窦忽风雷。",
        "松间白足携诗板，石上苍头把酒杯。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 163391,
      "title": "居拟苏武  其一",
      "content": [
        "棠棣本同根，芳葩亦相联。",
        "谁谓忽远役，怀抱无由宣。",
        "况我骨肉亲，与子枝叶连。",
        "昔为双飞凫，今为孤飞鸢。",
        "徘徊复彷徨，感激涕泗涟。",
        "道路阻且远，四海霏尘烟。",
        "鹡鸰恐失群，遶树何翩翩。",
        "我有一斗酒，可以同笑言。",
        "去去从此辞，努力云中鞭。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 163392,
      "title": "居拟苏武  其二",
      "content": [
        "黄鹤一远举，千年方始归。",
        "众鸟念其群，哀鸣亦相依。",
        "彼美双鸳鸯，一旦生乖离。",
        "幸有盈尊酒，聊以与子违。",
        "请歌远游吟，慷慨声以悲。",
        "清商咽丝竹，激烈怆复凄。",
        "行人不可留，万里将何之。",
        "念子日已远，会念未有期。",
        "俛首长叹息，泪下沾我衣。",
        "安得生羽翰，与子成双飞。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 163393,
      "title": "居拟苏武  其三",
      "content": [
        "结髪为新婚，恩爱相匹俦。",
        "欢乐殊未已，征夫忽西游。",
        "中夜起彷徨，仰视天汉流。",
        "众星正纵横，皓月澄中州。",
        "明发临古道，古道何悠悠。",
        "生死从此辞，握手泪不收。",
        "勉哉惜芳姿，毋使怀百忧。",
        "丈夫抱赤心，妇女安可留。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 163394,
      "title": "居拟苏武  其四",
      "content": [
        "皎皎云间月，灼灼我室闾。",
        "酣歌美长夜，清辉丽高隅。",
        "征夫许报国，将使万里途。",
        "是时吹寒风，晨起驱行车。",
        "仰视天文乖，俯视长江殊。",
        "良友惜远别，执手相踟蹰。",
        "清时不屡好，嘉会难再娱。",
        "万里一失所，中道将何如。",
        "愿子著明誓，善保千金躯。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 163395,
      "title": "竹枝歌  其一",
      "content": [
        "快风吹我入三巴，桂櫂兰桡倚暮花。",
        "一道月明天似水，湘灵鼓瑟下长沙。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 163396,
      "title": "竹枝歌  其二",
      "content": [
        "贾谊祠前酹酒尊，汨罗江上吊骚魂。",
        "耒阳更有一抔土，行路人传是假坟。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 163397,
      "title": "竹枝歌  其三",
      "content": [
        "黄陵庙前枫叶丹，黄陵渡头烟水寒。",
        "美人万里不相见，月子弯弯只自看。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 163398,
      "title": "竹枝歌  其四",
      "content": [
        "柘枝舞罢竹枝歌，风烛须臾奈尔何。",
        "马玉池中鸿雁密，定王台上骆驼多。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 163399,
      "title": "竹枝歌  其五",
      "content": [
        "落木萧萧风怒号，平沙漠漠雁腥臊。",
        "湘江秋水澄如练，山鬼嚣时山月高。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 163400,
      "title": "竹枝歌  其六",
      "content": [
        "湘江日落乱帆飞，不向东归便北归。",
        "杨柳渡头村店里，青裙女子卖乌柙。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 163401,
      "title": "竹枝歌  其七",
      "content": [
        "湘南湘北蕙花开，树头树底猨乱哀。",
        "云巢九疑虞帝庙，雨昏三峡楚王台。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 163402,
      "title": "竹枝歌  其八",
      "content": [
        "白头渔父白头妻，网得鱼多夜不归。",
        "生怕渡官搜著税，巴东转柁向巴西。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 163403,
      "title": "竹枝歌  其九",
      "content": [
        "弄玉吹箫过洞庭，烟波渺渺接巴陵。",
        "朗吟仙子来何处，飞上君山玩月明。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 163404,
      "title": "竹枝歌  其一○",
      "content": [
        "天上人间一梦过，春来秋去奈愁何。",
        "铜仙有泪如铅水，不似湘妃竹上多。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 163405,
      "title": "短歌",
      "content": [
        "腰宝剑，背瑶琴，燕云万里金门深。",
        "斩邪诛佞拱北极，阜财解愠歌南音。",
        "驾骅骝，御狐貉。",
        "度关山，望河洛。",
        "况是东南宇宙窄，桑田变海风涛恶。",
        "劝君一醉千日醒，世事花开又花落。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 163406,
      "title": "送皇甫秀才下荆州",
      "content": [
        "西南多胜概，挟策缓周旋。",
        "笛弄五溪月，櫂摇三峡天。",
        "楚江萍似斗，太华藕如船。",
        "归橐应无价，人争秀句传。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 322200,
      "title": "满江红",
      "content": [
        "一个兰舟，双桂桨、顺流东去。",
        "但满目、银光万顷，凄其风露。",
        "渔火已归鸿雁汊，棹歌更在鸳鸯浦。",
        "渐夜深、芦叶冷飕飕，临平路。",
        "吹铁笛，鸣金谷。",
        "丝玉脍，倾香醑。",
        "且浩歌痛饮，藕花深处。",
        "秋水长天迷远望，晓风残月空凝伫。",
        "问人间、今夕是何年，清如许。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 322201,
      "title": "金人捧露盘",
      "content": [
        "越山云，越江水，越王台。",
        "个中景、尽可徘徊。",
        "凌高放目，使人胸次共崔嵬。",
        "黄鹂紫燕报春晚，劝我衔杯。",
        "古时事，今时泪，前人喜，后人哀。",
        "正醉里、歌管成灰。",
        "新愁旧恨，一时分付与潮回。",
        "鹧鸪啼歇夕阳去，满地风埃。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 322202,
      "title": "相思引",
      "content": [
        "晓拂菱花巧画眉。",
        "猩罗新翦作春衣。",
        "恐春归去，无处看花枝。",
        "已恨东风成去客，更教飞燕舞些时。",
        "惜花人醉，头上插花归。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 322203,
      "title": "长相思",
      "content": [
        "吴山深。",
        "越山深。",
        "空谷佳人金玉音。",
        "有谁知此心。",
        "夜沈沈。",
        "漏沈沈。",
        "闲却梅花一曲琴。",
        "月高松竹林。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 322204,
      "title": "传言玉女",
      "content": [
        "一片风流，今夕与谁同乐。",
        "月台花馆，慨尘埃漠漠。",
        "豪华荡尽，只有青山如洛。",
        "钱塘依旧，潮生潮落。",
        "万点灯光，羞照舞钿歌箔。",
        "玉梅消瘦，恨东皇命薄。",
        "昭君流泪，手拈琵琶弦索。",
        "离愁聊寄，画楼哀角。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 322205,
      "title": "好事近",
      "content": [
        "独倚浙江楼，满耳怨笳哀笛。",
        "犹有梨园声在，念那人天北。",
        "海棠憔悴怯春寒，风雨怎禁得。",
        "回首华清池畔，渺露芜烟荻。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 322206,
      "title": "洞仙歌",
      "content": [
        "西园春暮。",
        "乱山迷行路。",
        "风卷残花堕红雨。",
        "念旧巢燕子，飞傍谁家，斜阳外、长笛一声今古。",
        "繁华流水去。",
        "舞歇歌沈，忍见遗钿种香土。",
        "渐橘树方生，桑枝才长，都付与、沙门为主。",
        "便关防、不放贵游来，又突兀梯空，楚王宫宇。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 322207,
      "title": "莺啼序",
      "content": [
        "金陵故都最好，有朱楼迢递。",
        "嗟倦客、又此凭高，槛外已少佳致。",
        "更落尽梨花，飞尽杨花，春也成憔悴。",
        "问青山、三国英雄，六朝奇伟。",
        "麦甸葵丘，荒台败垒。",
        "鹿豕衔枯荠。",
        "正朝打孤城，寂寞斜阳影里。",
        "听楼头、哀笳怨角，未把酒、愁心先醉。",
        "渐夜深，月满秦淮，烟笼寒水。",
        "凄凄惨惨，冷冷清清，灯火渡头市。",
        "慨商女不知兴废。",
        "隔江犹唱庭花，馀音亹亹。",
        "伤心千古，泪痕如洗。",
        "乌衣巷口青芜路，认依稀、王谢旧邻里。",
        "临春结绮。",
        "可怜红粉成灰，萧索白杨风起。",
        "因思畴昔，铁索千寻，谩沈江底。",
        "挥羽扇、障西尘，便好角巾私第。",
        "清谈到底成何事。",
        "回首新亭，风景今如此。",
        "楚囚对泣何时已。",
        "叹人间、今古真儿戏。",
        "东风岁岁还来，吹入锺山，几重苍翠。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 322208,
      "title": "六州歌头",
      "content": [
        "绿芜城上，怀古恨依依。",
        "淮山碎。",
        "江波逝。",
        "昔人非。",
        "今人悲。",
        "惆怅隋天子。",
        "锦帆里。",
        "环朱履。",
        "丛香绮。",
        "展旌旗。",
        "荡涟猗。",
        "击鼓挝金，拥琼璈玉吹。",
        "姿意游嬉。",
        "斜日晖晖。",
        "乱莺啼。",
        "销魂此际。",
        "君臣醉。",
        "貔貅弊。",
        "事如飞。",
        "山河坠。",
        "烟尘起。",
        "风凄凄。",
        "雨霏霏。",
        "草木皆垂泪。",
        "家国弃。",
        "竟忘归。",
        "笙歌地。",
        "欢娱地。",
        "尽荒畦。",
        "唯有当时皓月，依然挂、杨柳青枝。",
        "听堤边渔叟，一笛醉中吹。",
        "兴废谁知。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 322209,
      "title": "水龙吟",
      "content": [
        "鼓鞞惊破霓裳，海棠亭北多风雨。",
        "歌阑酒罢，玉啼金泣，此行良苦。",
        "驼背模糊，马头匼匝，朝朝暮暮。",
        "自都门燕别，龙艘锦缆，空载得、春归去。",
        "目断东南半壁，怅长淮、已非吾土。",
        "受降城下，草如霜白，凄凉酸楚。",
        "粉阵红围，夜深人静，谁宾谁主。",
        "对渔灯一点，羁愁一搦，谱琴中语。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 322210,
      "title": "望江南・忆江南",
      "content": [
        "官舍悄，坐到月西斜。",
        "永夜角声悲自语，客心愁破正思家。",
        "南北各天涯。",
        "肠断裂，搔首一长嗟。",
        "绮席象床寒玉枕，美人何处醉黄花。",
        "和泪拈琵琶。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 322211,
      "title": "卜算子",
      "content": [
        "我向河南来，伊向河西去。",
        "客里相逢只片时，无计留伊住。",
        "去住总由伊，莫把眉头聚。",
        "安得并州快剪刀，割断相思路。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
