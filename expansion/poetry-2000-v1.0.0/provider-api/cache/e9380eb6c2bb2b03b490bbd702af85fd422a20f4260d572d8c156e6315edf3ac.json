{
  "data": [
    {
      "id": 267642,
      "title": "闲居",
      "content": [
        "东城南陌尘，紫幰与朱轮。",
        "尽说无多事，能闲有几人。",
        "唯教推甲子，不信守庚申。",
        "谁见衡门里，终朝自在贫。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267643,
      "title": "寄昭应王中丞",
      "content": [
        "借得街西宅，开门渭水头。",
        "长贫唯要健，渐老不禁愁。",
        "独凭藤书案，空悬竹酒钩。",
        "春风石瓮寺，作意共君游。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267644,
      "title": "酬孙洛阳",
      "content": [
        "家贫相远住，斋馆入时稀。",
        "独坐看书卷，闲行著褐衣。",
        "早蝉庭笋老，新雨径莎肥。",
        "各离争名地，无人见是非。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267645,
      "title": "送人任济阴",
      "content": [
        "黄绶在腰下，知君非旅行。",
        "将书报旧里，留褐与诸生。",
        "赠别尽沽酒，惜欢多出城。",
        "春风济水上，候吏听车声。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267646,
      "title": "晚春过崔驸马东园",
      "content": [
        "闲园多好风，不意在街东。",
        "早早诗名远，长长酒性同。",
        "竹香新雨后，莺语落花中。",
        "莫遣经过少，年光渐觉空。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267647,
      "title": "夏日闲居",
      "content": [
        "多病逢迎少，闲居又一年。",
        "药看辰日合，茶过卯时煎。",
        "草长晴来地，虫飞晚后天。",
        "此时幽梦远，不觉到山边。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267648,
      "title": "晚秋闲居",
      "content": [
        "独坐高秋晚，萧条足远思。",
        "家贫常畏客，身老转怜儿。",
        "万种尽闲事，一生能几时。",
        "从来疎嬾性，应祗有僧知。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267649,
      "title": "和陆司业习静寄所知",
      "content": [
        "幽室独焚香，清晨下未央。",
        "山开登竹阁，僧到出茶床。",
        "收拾新琴谱，封题旧药方。",
        "逍遥无别事，不似在班行。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267650,
      "title": "酬韩祭酒雨中见寄",
      "content": [
        "雨中愁不出，阴黑尽连宵。",
        "屋湿唯添漏，泥深未放朝。",
        "无刍怜马瘦，少食信儿娇。",
        "闻道韩夫子，还同此寂寥。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267651,
      "title": "和裴仆射移官言志",
      "content": [
        "身在勤劳地，常思放旷时。",
        "功成归圣主，位重委群司。",
        "看垒台边石，闲吟箧里诗。",
        "苍生正瞻望，难与故山期。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267652,
      "title": "酬白二十二舍人早春曲江见招",
      "content": [
        "曲江冰欲尽，风日已恬和。",
        "柳色看犹浅，泉声觉渐多。",
        "紫蒲生湿岸，青鸭戏新波。",
        "仙掖高情客，相招共一过。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267653,
      "title": "和裴仆射朝回寄韩吏部",
      "content": [
        "独爱南关里，山晴竹杪风。",
        "从容朝早退，萧洒客常通。",
        "案曲新亭上，移花远寺中。",
        "唯应有吏部，诗酒每相同。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267654,
      "title": "春日李舍人宅见两省诸公唱和因书情即事",
      "content": [
        "又见帝城里，东风天气和。",
        "官闲人事少，年长道情多。",
        "紫掖发章句，青闱更咏歌。",
        "谁知余寂寞，终日断经过。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267655,
      "title": "和李仆射秋日病中作",
      "content": [
        "由来病根浅，易见药功成。",
        "晓日杵臼静，凉风衣服轻。",
        "犹疑少气力，渐觉有心情。",
        "独倚红藤杖，时时堦上行。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267656,
      "title": "早春病中",
      "content": [
        "羸病及年初，心情不自如。",
        "多申请假牒，祗送贺官书。",
        "幽径独行步，白头长嬾梳。",
        "更怜晴日色，渐渐暖贫居。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267657,
      "title": "送严大夫之桂州",
      "content": [
        "旌斾过湘潭，幽奇得徧探。",
        "莎城百越北，行路九疑南。",
        "有地多生桂，无时不养蚕。",
        "听歌疑似曲，风俗自相谙。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267658,
      "title": "咏怀",
      "content": [
        "老去多悲事，非唯见二毛。",
        "眼昏书字大，耳重觉声高。",
        "望月偏增思，寻山易发劳。",
        "都无作官意，赖得在闲曹。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267659,
      "title": "使至蓝谿驿寄太常王丞",
      "content": [
        "独上七盘去，峰峦转转稠。",
        "云中迷象鼻，雨里下筝头。",
        "水没荒桥路，鸦啼古驿楼。",
        "君今在城阙，肯见此中愁。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267660,
      "title": "留别江陵王少府",
      "content": [
        "迢迢山上路，病客独行迟。",
        "况此分手处，当君失意时。",
        "寒林远路驿，晚烧过荒陂。",
        "别后空回首，相逢未有期。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267661,
      "title": "赠海东僧",
      "content": [
        "别家行万里，自说过扶余。",
        "学得中州语，能为外国书。",
        "与医收海藻，持咒取龙鱼。",
        "更问同来伴，天台几处居。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267662,
      "title": "寄汉阳故人",
      "content": [
        "知君汉阳住，烟树远重重。",
        "归使雨中发，寄书灯下封。",
        "同时买江坞，今日别云松。",
        "欲问新移处，青萝最北峰。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267663,
      "title": "送安西将",
      "content": [
        "万里海西路，茫茫边草秋。",
        "计程沙塞口，望伴驿峰头。",
        "雪暗非时宿，沙深独去愁。",
        "塞乡人易老，莫住近蕃州。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267664,
      "title": "题李山人幽居",
      "content": [
        "襄阳南郭外，茅屋一书生。",
        "无事焚香坐，有时寻竹行。",
        "画苔藤杖细，踏石笋鞋轻。",
        "应笑风尘客，区区逐世名。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267665,
      "title": "早春闲游",
      "content": [
        "年长身多病，独宜作冷官。",
        "从来闲坐惯，渐觉出门难。",
        "树影新犹薄，池光晚尚寒。",
        "遥闻有花发，骑马暂行看。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267666,
      "title": "赠太常王建藤杖笋鞋",
      "content": [
        "蛮藤剪为杖，楚笋结成鞋。",
        "称与诗人用，堪随礼寺斋。",
        "寻花入幽径，步日下寒堦。",
        "以此持相赠，君应惬素怀。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267667,
      "title": "和周赞善闻子规",
      "content": [
        "秦城啼楚鸟，远思更纷纷。",
        "况是街西夜，偏当雨里闻。",
        "应投最高树，似隔数重云。",
        "此处谁能听，遥知独有君。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267668,
      "title": "送李骑曹灵州归觐",
      "content": [
        "翩翩出上京，几日到边城。",
        "渐觉风沙起，还将弓箭行。",
        "席箕侵路暗，野马见人惊。",
        "军府知归庆，应教数骑迎。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267669,
      "title": "寒食夜寄姚侍郎",
      "content": [
        "贫官多寂寞，不异野人居。",
        "作酒和山药，教儿写道书。",
        "五湖归去远，百事病来疎。",
        "况忆同怀者，寒庭月上初。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267670,
      "title": "题清彻上人院",
      "content": [
        "古寺临坛久，松间别起堂。",
        "看添浴佛水，自合读经香。",
        "爱养无家客，多传得效方。",
        "过斋长不出，坐卧一绳床。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267671,
      "title": "寄灵一上人初归云门寺",
      "content": [
        "寒山白云里，法侣自招携。",
        "竹径通城下，松门隔水西。",
        "方同沃洲去，不作武陵迷。",
        "髣髴遥看处，秋风是会稽。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267672,
      "title": "和裴司空即事通简旧僚",
      "content": [
        "肃肃上台坐，四方皆仰风。",
        "当朝奉明政，早日立元功。",
        "独对赤墀下，密宣黄阁中。",
        "犹闻动高韵，思与旧僚同。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267673,
      "title": "使回留别襄阳李司空",
      "content": [
        "江亭寒日晚，弦管有离声。",
        "从此一筵别，独为千里行。",
        "迟迟恋恩德，役役限公程。",
        "回首吟新句，霜云满楚城。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267674,
      "title": "和户部令狐尚书喜裴司空见招看雪",
      "content": [
        "南园新覆雪，上宰晓来看。",
        "谁共登春榭，唯闻有地官。",
        "色连山远静，气与竹偏寒。",
        "高韵更相应，宁同謌吹欢。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267675,
      "title": "和裴司空以诗请刑部白侍郎双鹤",
      "content": [
        "皎皎仙家鹤，远留闲宅中。",
        "徘徊幽树月，嘹唳小亭风。",
        "丞相西园好，池塘野水通。",
        "欲将来放此，赏望与宾同。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267676,
      "title": "同锦州胡郎中清明日对雨西亭宴",
      "content": [
        "郡内开新火，高斋雨气清。",
        "惜花邀客赏，劝酒促歌声。",
        "共醉移芳席，留欢闭暮城。",
        "政闲方宴语，琴筑任遥情。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267677,
      "title": "庄陵挽歌词三首 一",
      "content": [
        "白日已昭昭，干戈亦渐消。",
        "迎师亲出道，从谏早临朝。",
        "佞幸威权薄，忠良宠锡饶。",
        "丘陵今一变，无复白云谣。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267678,
      "title": "庄陵挽歌词三首 二",
      "content": [
        "观风欲巡洛，习战亦开池。",
        "始改三年政，旋闻七月期。",
        "陵分内外使，官具吉凶仪。",
        "渭北新园路，箫笳远更悲。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267679,
      "title": "庄陵挽歌词三首 三",
      "content": [
        "晓日龙车动，秋风阊阖开。",
        "行帷六宫出，执绋万方来。",
        "惨惨郊原暮，迟迟挽唱哀。",
        "空山烟雨夕，新陌遶陵台。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267680,
      "title": "和左司元郎中秋居十首 一",
      "content": [
        "选得闲坊住，秋来草树肥。",
        "风前卷筒簟，雨里脱荷衣。",
        "野客留方去，山童取药归。",
        "非因入朝省，过此出门稀。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267681,
      "title": "和左司元郎中秋居十首 二",
      "content": [
        "有地唯栽竹，无池亦养鹅。",
        "学书求墨迹，酿酒爱朝和。",
        "古镜铭文浅，神方谜语多。",
        "居贫闲自乐，豪客莫相过。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267682,
      "title": "和左司元郎中秋居十首 三",
      "content": [
        "闲来松菊地，未省有埃尘。",
        "直去多将药，朝回不访人。",
        "见僧收酒器，迎客换纱巾。",
        "更恐登清要，难成自在身。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267683,
      "title": "和左司元郎中秋居十首 四",
      "content": [
        "自知清静好，不要问时豪。",
        "就石安琴枕，穿松压酒槽。",
        "山晴因月甚，诗语入秋高。",
        "身外无余事，唯应笔砚劳。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267684,
      "title": "和左司元郎中秋居十首 五",
      "content": [
        "闲堂新埽洒，称是早秋天。",
        "书客多呈帖，琴僧与合弦。",
        "莎台乘晚上，竹院就凉眠。",
        "终日无忙事，还应似得仙。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267685,
      "title": "和左司元郎中秋居十首 六",
      "content": [
        "醉倚斑藤杖，闲眠瘿木床。",
        "案头行气诀，炉里降真香。",
        "尚俭经营少，居闲意思长。",
        "秋茶莫夜饮，新自作松浆。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267686,
      "title": "和左司元郎中秋居十首 七",
      "content": [
        "每忆旧山居，新教上墨图。",
        "晚花回地种，好酒问人沽。",
        "夜后开朝簿，申前发省符。",
        "为郎凡几岁，已见白髭须。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267687,
      "title": "和左司元郎中秋居十首 八",
      "content": [
        "菊地才通履，茶房不垒阶。",
        "凭医看蜀药，寄信觅吴鞋。",
        "尽得仙家法，多随道客斋。",
        "本无荣辱意，不是学安排。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267688,
      "title": "和左司元郎中秋居十首 九",
      "content": [
        "林下无拘束，闲行放性灵。",
        "好时开药灶，高处置琴亭。",
        "更撰居山记，唯寻相鹤经。",
        "初当授衣假，无吏挽门铃。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267689,
      "title": "和左司元郎中秋居十首 十",
      "content": [
        "客散高斋晚，东园景象偏。",
        "晴明犹有蝶，凉冷渐无蝉。",
        "藤折霜来子，蜗行雨后涎。",
        "新诗才上卷，已得满城传。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267690,
      "title": "经王处士原居",
      "content": [
        "旧宅谁相近，唯僧近竹关。",
        "庭闲云满井，窗晓雪通山。",
        "来客半留宿，借书多寄还。",
        "明时未中岁，莫便一生闲。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267691,
      "title": "不食仙姑山房",
      "content": [
        "寂寂花枝里，草堂唯素琴。",
        "因山曾改眼，见客不言心。",
        "月出溪路静，鹤鸣云树深。",
        "丹砂如可学，便欲住幽林。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267692,
      "title": "江头",
      "content": [
        "晚步随江远，来帆过眼频。",
        "试寻新住客，少见故乡人。",
        "回首怜归翼，长吟任此身。",
        "应同南浦雁，更见岭头春。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267693,
      "title": "寄孙冲主簿",
      "content": [
        "低折沧州簿，无书整两春。",
        "马从同事借，妻怕罢官贫。",
        "道僻收闲药，诗高笑故人。",
        "仍闻长吏奏，表乞锁厅频。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267694,
      "title": "赠任懒",
      "content": [
        "未肯求科第，深坊且隐居。",
        "胜游寻野客，高卧看兵书。",
        "点药医闲马，分泉灌远蔬。",
        "汉庭无得意，谁拟荐相如。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267695,
      "title": "旧宫人",
      "content": [
        "謌舞梁州女，归时白发生。",
        "全家没蕃地，无处问乡程。",
        "宫锦不传样，御香空记名。",
        "一身难自说，愁逐路人行。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267696,
      "title": "春日留别",
      "content": [
        "游人欲别离，半醉对花枝。",
        "看著春又晚，莫轻少年时。",
        "临行记分处，廻首是相思。",
        "各向天涯去，重来未可期。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267697,
      "title": "没蕃故人",
      "content": [
        "前年伐月支，城上没全师。",
        "蕃汉断消息，死生长别离。",
        "无人收废帐，归马识残旗。",
        "欲祭疑君在，天涯哭此时。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267698,
      "title": "赠箕山僧",
      "content": [
        "久住空林下，长斋耳目清。",
        "蒲团借客坐，石磹甃人行。",
        "似鹤难知性，因山强号名。",
        "时闻衣袖里，暗掐念珠声。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267699,
      "title": "冬夕",
      "content": [
        "寒蛩独罢织，湘雁犹能鸣。",
        "月色当窗入，乡心半夜生。",
        "不成高枕梦，复作遶堦行。",
        "回首嗟淹泊，城头北斗横。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267700,
      "title": "奉和陕州十四翁中丞寄雷州二十二翁司户之作",
      "content": [
        "联飞独不前，迥落海南天。",
        "贾傅竟行矣，邵公惟泫然。",
        "瘴开山更远，路极水无边。",
        "沈劣本多感，况闻原上篇。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267701,
      "title": "老将",
      "content": [
        "鬓衰头似雪，行步急如风。",
        "不怕骑生马，犹能挽硬弓。",
        "兵书封锦字，手诏满香筒。",
        "今日身憔悴，犹夸定远功。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267702,
      "title": "送友生游峡中",
      "content": [
        "风静杨柳垂，看花又别离。",
        "几年同在此，今日各驱驰。",
        "峡里闻猿呌，山头见月时。",
        "殷勤一杯酒，珍重岁寒姿。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267703,
      "title": "送安法师",
      "content": [
        "出郭见落日，别君临古津。",
        "远程无野寺，宿处问何人。",
        "原色不分路，锡声遥隔尘。",
        "山阴到家节，犹及蕙兰春。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267704,
      "title": "水",
      "content": [
        "荡漾空沙际，虚明入远天。",
        "秋光照不极，鸟色去无边。",
        "势引长云阔，波轻片雪连。",
        "汀洲杳难测，万古覆苍烟。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267705,
      "title": "岳州晚景",
      "content": [
        "晚景寒鸦集，秋声旅雁归。",
        "水光浮日去，霞彩暎江飞。",
        "洲白芦花吐，园红柿叶稀。",
        "长沙卑湿地，九月未成衣。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267706,
      "title": "寒食后",
      "content": [
        "田舍清明日，家家出火迟。",
        "白衫眠古巷，红索搭高枝。",
        "纱带生难结，铜钗重易垂。",
        "斩新衣著尽，还似去年时。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267707,
      "title": "寒食书事二首 一",
      "content": [
        "今朝一百五，出户雨初晴。",
        "舞爱双飞蝶，歌闻数里莺。",
        "江深青草岸，花满白云城。",
        "为政多孱懦，应无酷吏名。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267708,
      "title": "寒食书事二首 二",
      "content": [
        "出城烟火少，况复是今朝。",
        "闲坐将谁语，临觞只自谣。",
        "堦前春藓徧，衣上落花飘。",
        "妓乐州人戏，使君心寂寥。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267709,
      "title": "和李仆射雨中寄卢严二给事",
      "content": [
        "郊原飞雨至，城阙湿云埋。",
        "迸点时穿牖，浮沤欲上堦。",
        "偏滋解箨竹，并洒落花槐。",
        "晚润生琴匣，新凉满药斋。",
        "从容朝务退，放旷掖曹乖。",
        "尽日无来客，闲吟感此怀。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267710,
      "title": "酬李仆射晚春见寄",
      "content": [
        "戟户洞初晨，莺声雨后频。",
        "虚庭清气在，众药湿光新。",
        "鱼动芳池面，苔侵老竹身。",
        "教铺尝酒处，自问探花人。",
        "独此长多病，幽居欲过春。",
        "今朝听高韵，忽觉离埃尘。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267711,
      "title": "和卢常侍寄华山郑隐者",
      "content": [
        "独住三峰下，年深学炼丹。",
        "一间松叶屋，数片石花冠。",
        "酒待山中饮，琴将洞口弹。",
        "开门移远竹，剪草出幽兰。",
        "荒壁通泉架，晴崖晒药坛。",
        "寄知骑省客，长向白云闲。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267712,
      "title": "和令狐尚书平泉东庄近居李仆射有寄十韵",
      "content": [
        "平地有清泉，伊南古寺边。",
        "涨池闲遶屋，出野徧浇田。",
        "旧隐离多日，新邻得几年。",
        "探幽皆一绝，选胜又双全。",
        "门静山光别，园深竹影连。",
        "斜分采药径，直过钓鱼船。",
        "鸡犬还应识，云霞顿觉鲜。",
        "追思应不远，赏爱谅难偏。",
        "此处堪长往，游人早共传。",
        "各当恩寄重，归卧恐无缘。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267713,
      "title": "送郑尚书出镇南海",
      "content": [
        "远镇承新命，王程不假催。",
        "班行争路送，恩赐并时来。",
        "牙斾从城展，兵符到府开。",
        "蛮声喧夜市，海色浸潮台。",
        "画角天边月，寒关岭上梅。",
        "共知公望重，多是隔年回。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267714,
      "title": "徐州试反舌无声",
      "content": [
        "夏木多好鸟，偏知反舌名。",
        "林幽仍共宿，时过即无声。",
        "竹外天空晓，谿头雨自晴。",
        "居人宜寂寞，深院益凄清。",
        "入雾暗相失，当风闲易惊。",
        "来年上林苑，知尔最先鸣。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267715,
      "title": "省试行不由径",
      "content": [
        "田里有微径，贤人不复行。",
        "孰知求捷步，又恐异端成。",
        "从易众所欲，安邪患亦生。",
        "谁能达天道，共此竞前程。",
        "子羽有遗迹，孔门传旧声。",
        "今逢大君子，士节自光明。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267716,
      "title": "新城甲仗楼",
      "content": [
        "谢氏起新楼，西临城角头。",
        "图功百尺丽，藏器五兵修。",
        "结缔榱甍固，虚明户槛幽。",
        "鱼龙卷旗帜，霜雪积戈矛。",
        "暑雨熇烝隔，凉风宴位留。",
        "地高形出没，山静气清优。",
        "睥睨斜光彻，阑干宿霭浮。",
        "芊芊秔稻色，脉脉苑谿流。",
        "郡化黄丞相，诗成沈隐侯。",
        "居兹良得景，殊胜岘山游。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267717,
      "title": "赠殷山人",
      "content": [
        "郁郁山中客，知名四十年。",
        "恓惶身独隐，寂寞性应便。",
        "世业公侯籍，生涯黍稷田。",
        "藤悬读书帐，竹系网鱼船。",
        "已种千头橘，新开数脉泉。",
        "闲游携酒远，幽语向僧偏。",
        "入洞题松过，看花选石眠。",
        "避喧长汩没，逢胜即留连。",
        "自古多高迹，如君少比肩。",
        "耕耘此辛苦，章句已流传。",
        "昔日交游盛，当时省阁贤。",
        "同袍还共弊，连辔每推先。",
        "讲序居重席，群儒愿执鞭。",
        "满堂虚左待，众目望乔迁。",
        "才异时难用，情高道自全。",
        "畏人颜惨澹，疎物势迍邅。",
        "贤者闻知命，吾生复礼玄。",
        "深藏报恩劒，久缉养生篇。",
        "憔悴众夫笑，经过郡守怜。",
        "夕阳悲病鹤，霜气动饥鹯。",
        "处士谁能荐，穷途世所捐。",
        "伯鸾甘寄食，元淑苦无钱。",
        "策蹇秋尘里，吟诗黄叶前。",
        "故裘余白领，废瑟断朱弦。",
        "志气终犹在，逍遥任自然。",
        "家贫念婚嫁，身老恋云烟。",
        "放逸栖岩鹿，清虚饮露蝉。",
        "郑逃秦谷口，严爱越溪边。",
        "霄汉予犹阻，荣枯子不牵。",
        "山城一相遇，感激意难宣。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267718,
      "title": "夏日可畏",
      "content": [
        "赫赫温风扇，炎炎夏日徂。",
        "火威驰逈野，畏景铄遥途。",
        "势矫翔阳翰，功分造化罏。",
        "禁城千品烛，黄道一轮孤。",
        "落照频空簟，余晖卷夕梧。",
        "如何倦游子，中路独踟蹰。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267719,
      "title": "罔象得玄珠",
      "content": [
        "赤水今何处，遗珠已渺然。",
        "离娄徒肆目，罔象乃通玄。",
        "皎洁因成性，圆明不在泉。",
        "暗中看夜色，尘外照晴田。",
        "无胫真难掬，怀疑实易迁。",
        "今朝搜择得，应免媚晴川。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267720,
      "title": "和李仆射西园",
      "content": [
        "遇午归闲处，西庭敞四簷。",
        "高眠著琴枕，散帖检书签。",
        "印在休通客，山晴好卷帘。",
        "竹凉蝇少到，藤暗蝶争潜。",
        "晓鹊频惊喜，疎蝉不许拈。",
        "石苔生紫点，栏药吐红尖。",
        "虚坐诗情远，幽探道侣兼。",
        "所营尚胜地，虽俭复谁嫌。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267721,
      "title": "送裴相公赴镇太原",
      "content": [
        "盛德雄名远近知，功高先乞守藩维。",
        "衔恩暂遣分龙节，署勅还同在凤池。",
        "天子亲临楼上送，朝官齐出道傍辞。",
        "明年塞北清蕃落，应建生祠请立碑。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 267722,
      "title": "寄元员外",
      "content": [
        "外郎直罢无余事，埽洒书堂试药炉。",
        "门巷不教当要闹，诗篇转觉足工夫。",
        "月明台上唯僧到，夜静坊中有酒沽。",
        "朝省入频闲日少，可能同作旧游无。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 267723,
      "title": "赠梅处士",
      "content": [
        "早闻声价满京城，头白江湖放旷情。",
        "讲易自传新注义，题诗不著旧官名。",
        "近移马迹山前住，多向牛头寺里行。",
        "天子如今议封禅，应将束帛请先生。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 267724,
      "title": "赠王秘书",
      "content": [
        "不曾浪出谒公侯，唯向花间水畔游。",
        "每著新衣看药灶，多收古器在书楼。",
        "有官祗作山人老，平地能开洞穴幽。",
        "自领闲司了无事，得来君处喜相留。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 267725,
      "title": "谢裴司空寄马",
      "content": [
        "𫘧耳新驹骏得名，司空远自寄书生。",
        "乍离华廐移蹄涩，初到贫家举眼惊。",
        "每被闲人来借问，多寻古寺独骑行。",
        "长思岁旦沙堤上，得从鸣珂傍火城。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 267726,
      "title": "酬秘书王丞见寄",
      "content": [
        "相看头白来城阙，却忆漳溪旧往还。",
        "今体诗中偏出格，常参官里每同班。",
        "街西借宅多临水，马上逢人亦说山。",
        "芸阁水曹虽最冷，与君长喜得身闲。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 267727,
      "title": "送李余及第后归蜀",
      "content": [
        "十年人咏好诗章，今日成名出举场。",
        "归去唯将新诰牒，后来争取旧衣裳。",
        "山桥晓上芭蕉暗，水店晴看芋草黄。",
        "乡里亲情相见日，一时携酒贺高堂。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 267728,
      "title": "早朝寄白舍人严郎中",
      "content": [
        "鼓声初动未闻鸡，羸马街中踏冻泥。",
        "烛暗有时冲石柱，雪深无处认沙堤。",
        "常参班里人犹少，待漏房前月欲西。",
        "凤阙星郎离去远，合门开日入还齐。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 267729,
      "title": "书怀寄元郎中",
      "content": [
        "转觉人间无气味，常因身外省因缘。",
        "经过独爱游山客，计校唯求买药钱。",
        "重作学官闲尽日，一离江坞病多年。",
        "吟君钓客词中说，便欲南归榜小船。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 267730,
      "title": "赠道士宜师",
      "content": [
        "自到王城得几年，巴童蜀马共随缘。",
        "两朝侍从当时贵，五字声名远处传。",
        "旧住红楼通内院，新承墨诏赐斋钱。",
        "闲房暂喜居相近，还得陪师坐竹边。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 267731,
      "title": "书怀寄王秘书",
      "content": [
        "白发如今欲满头，从来百事尽应休。",
        "祗于触目须防病，不拟将心更养愁。",
        "下药远求新熟酒，看山多上最高楼。",
        "赖君同在京城住，每到花前免独游。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 267732,
      "title": "题韦郎中新亭",
      "content": [
        "起得幽亭景复新，碧莎地上更无尘。",
        "琴书著尽犹嫌少，松竹栽多亦称贫。",
        "药酒欲开期好客，朝衣暂脱见闲身。",
        "成名同日官连署，此处经过有几人。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 267733,
      "title": "送杨州判官",
      "content": [
        "应得烟霞出俗心，茅山道士共追寻。",
        "闲怜鹤貌偏能画，暗辨桐声自作琴。",
        "长啸每来松下坐，新诗堪向雪中吟。",
        "征南幕里多宾客，君独相知最校深。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 267734,
      "title": "喜王起侍郎放牒",
      "content": [
        "东风节气近清明，车马争来满禁城。",
        "二十八人初上牒，百千万里尽传名。",
        "谁家不借花园看，在处多将酒器行。",
        "共贺春司能鉴识，今年定合有公卿。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 267735,
      "title": "赠王司马",
      "content": [
        "白笏朱衫年少时，久登班列会朝仪。",
        "贮财不省关身用，行义唯愁被众知。",
        "藏得宝刀求主带，调成骏马乞人骑。",
        "未曾相识多闻说，遥望长如白玉枝。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 267736,
      "title": "书怀",
      "content": [
        "自小信成疎嬾性，人间事事总无功。",
        "别从仙客求方法，时到僧家问苦空。",
        "老大登朝如梦里，贫穷作活似村中。",
        "未能即便休官去，惭愧南山采药翁。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 267737,
      "title": "赠令狐博士",
      "content": [
        "头白新年六十余，近闻生计转空虚。",
        "久为博士谁能识，自到长安赁舍居。",
        "骑马出随寻寺客，呼儿散写乞钱书。",
        "古来贤哲皆如此，应是才高与众疎。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 267738,
      "title": "送从弟删东归",
      "content": [
        "云水东南两月程，贪归庆节马蹄轻。",
        "春桥欲醉攀花别，野路闲吟触雨行。",
        "诗价已高犹失意，礼司曾赏会成名。",
        "旧山风月知应好，莫向秋时不到京。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 267739,
      "title": "赠王秘书",
      "content": [
        "早在山东声价远，曾将顺策佐嫖姚。",
        "赋来诗句无闲语，老去官班未在朝。",
        "身屈祗闻词客说，家贫多见野僧招。",
        "独从书阁归时晚，春水渠边看柳条。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 267740,
      "title": "哭丘长史",
      "content": [
        "曾是先皇殿上臣，丹砂久服不成真。",
        "常骑马在嘶空枥，自作书留别故人。",
        "诗句徧传天下口，朝衣偏送地中身。",
        "最悲昨日同游处，看却春风树树新。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 267741,
      "title": "送枝江刘明府",
      "content": [
        "老著青衫为楚宰，平生志业有谁知。",
        "家僮从去愁行远，县吏迎来怪到迟。",
        "定访玉泉幽院宿，应过碧涧早茶时。",
        "向南渐渐云山好，一路唯闻唱竹枝。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    }
