{
  "data": [
    {
      "id": 267060,
      "title": "哭金部韦郎中",
      "content": [
        "金曹初受拜，玉地始含香。",
        "翻同五日尹，遽见一星亡。",
        "贺客犹扶路，哀人遂上堂。",
        "歌筵长寂寂，哭位自苍苍。",
        "岁时宾径断，朝暮雀罗张。",
        "书留魏主阙，魂掩汉家床。",
        "徒令永平帝，千载罢撞郎。"
      ],
      "author": {
        "id": 1929,
        "name": "卢照邻"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267061,
      "title": "哭明堂裴主簿",
      "content": [
        "缔欢三十载，通家数百年。",
        "潘杨称代穆，秦晋忝姻连。",
        "风云洛阳道，花月茂陵田。",
        "相悲共相乐，交骑复交筵。",
        "始谓调金鼎，如何掩玉泉。",
        "黄公酒𬬻处，青眼竹林前。",
        "故琴无复雪，新树但生烟。",
        "遽痛兰襟断，徒令宝剑悬。",
        "客散同秋叶，人亡似夜川。",
        "送君一长恸，松台路几千。"
      ],
      "author": {
        "id": 1929,
        "name": "卢照邻"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267062,
      "title": "同崔录事哭郑员外",
      "content": [
        "文学秋天远，郎官星位尊。",
        "伊人表时彦，飞誉满司存。",
        "楚席光文雅，瑶山侍讨论。",
        "凤词凌汉阁，龟辩罩周园。",
        "已陪东岳驾，将逝北溟鲲。",
        "如何万化尽，空叹九飞魂。",
        "白马西京驿，青松北海门。",
        "夜台无晓箭，朝奠有虚尊。",
        "一代儒风没，千年陇雾昏。",
        "梁山送夫子，湘水吊王孙。",
        "仆本多悲泪，沾裳不待猿。",
        "闻君绝弦曲，吞恨更无言。"
      ],
      "author": {
        "id": 1929,
        "name": "卢照邻"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267063,
      "title": "登玉清",
      "content": [
        "绝顶横临日，孤峰半倚天。",
        "裴回拜真老，万里见风烟。"
      ],
      "author": {
        "id": 1929,
        "name": "卢照邻"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 267064,
      "title": "曲池荷",
      "content": [
        "浮香绕曲岸，圆影覆华池。",
        "常恐秋风早，飘零君不知。"
      ],
      "author": {
        "id": 1929,
        "name": "卢照邻"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 267065,
      "title": "浴浪鸟",
      "content": [
        "独舞依磐石，群飞动轻浪。",
        "奋迅碧沙前，长怀白云上。"
      ],
      "author": {
        "id": 1929,
        "name": "卢照邻"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 267066,
      "title": "临阶竹",
      "content": [
        "封霜连锦砌，防露拂瑶阶。",
        "聊将仪凤质，暂与俗人谐。"
      ],
      "author": {
        "id": 1929,
        "name": "卢照邻"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 267067,
      "title": "含风蝉",
      "content": [
        "高情临爽月，急响送秋风。",
        "独有危冠意，还将衰鬓同。"
      ],
      "author": {
        "id": 1929,
        "name": "卢照邻"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 267068,
      "title": "葮川独泛",
      "content": [
        "倚櫂春江上，横舟石岸前。",
        "山瞑行人断，迢迢独泛仙。"
      ],
      "author": {
        "id": 1929,
        "name": "卢照邻"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 267069,
      "title": "送二兄入蜀",
      "content": [
        "关山客子路，花柳帝王城。",
        "此中一分手，相顾怜无声。"
      ],
      "author": {
        "id": 1929,
        "name": "卢照邻"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 267070,
      "title": "宿玄武二首 一",
      "content": [
        "方池开晓色，圆月下秋阴。",
        "已乘千里兴，还抚一弦琴。"
      ],
      "author": {
        "id": 1929,
        "name": "卢照邻"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 267071,
      "title": "宿玄武二首 二",
      "content": [
        "庭摇北风柳，院绕南溟禽。",
        "累宿恩方重，穷秋叹不深。"
      ],
      "author": {
        "id": 1929,
        "name": "卢照邻"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 267072,
      "title": "九陇津集",
      "content": [
        "落落树阴紫，澄澄水华碧。",
        "复有翻飞禽，裴回疑曳舃。"
      ],
      "author": {
        "id": 1929,
        "name": "卢照邻"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 267073,
      "title": "游昌化山精舍",
      "content": [
        "宝地乘峰出，香台接汉高。",
        "稍觉真途近，方知人事劳。"
      ],
      "author": {
        "id": 1929,
        "name": "卢照邻"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 267074,
      "title": "登封大酺歌四首 一",
      "content": [
        "明君封禅日重光，天子垂衣历数长。",
        "九州四海常无事，万岁千秋乐未央。"
      ],
      "author": {
        "id": 1929,
        "name": "卢照邻"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 267075,
      "title": "登封大酺歌四首 二",
      "content": [
        "日观仙云随凤辇，天门瑞雪照龙衣。",
        "繁弦绮席方终夜，妙舞清歌欢未归。"
      ],
      "author": {
        "id": 1929,
        "name": "卢照邻"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 267076,
      "title": "登封大酺歌四首 三",
      "content": [
        "翠凤逶迤登介丘，仙鹤裴回天上游。",
        "借问干封何所乐，人皆寿命得千秋。"
      ],
      "author": {
        "id": 1929,
        "name": "卢照邻"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 267077,
      "title": "登封大酺歌四首 四",
      "content": [
        "千年圣主应昌期，万国淳风王化基。",
        "请比上古无为代，何如今日太平时。"
      ],
      "author": {
        "id": 1929,
        "name": "卢照邻"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 267078,
      "title": "九月九日登玄武山",
      "content": [
        "九月九日眺山川，归心归望积风烟。",
        "他乡共酌金花酒，万里同悲鸿雁天。"
      ],
      "author": {
        "id": 1929,
        "name": "卢照邻"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 267079,
      "title": "句",
      "content": [
        "城狐尾独束，山鬼面参覃。"
      ],
      "author": {
        "id": 1929,
        "name": "卢照邻"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 334299,
      "title": "乐府杂曲：鼓吹曲辞：上之回",
      "content": [
        "回中道路险，萧关烽候多。",
        "五营屯北地，万乘出西河。",
        "单于拜玉玺，天子按雕戈。",
        "振旅汾川曲，秋风横大歌。"
      ],
      "author": {
        "id": 1929,
        "name": "卢照邻"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 334302,
      "title": "乐府杂曲：鼓吹曲辞：战城南",
      "content": [
        "将军出紫塞，冒顿在乌贪。",
        "笳喧雁门北，阵翼龙城南。",
        "雕弓夜宛转，铁骑晓参潭。",
        "应须驻白日，为待战方酣。"
      ],
      "author": {
        "id": 1929,
        "name": "卢照邻"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 334308,
      "title": "乐府杂曲：鼓吹曲辞：巫山高",
      "content": [
        "巫山望不极，望望下朝雰。",
        "莫辨啼猿树，徒看神女云。",
        "惊涛乱水脉，骤雨暗峰文。",
        "沾裳即此地，况复远思君。"
      ],
      "author": {
        "id": 1929,
        "name": "卢照邻"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 334322,
      "title": "乐府杂曲：鼓吹曲辞：芳树",
      "content": [
        "芳树本多奇，年华复在斯。",
        "结翠成新幄，开红满旧枝。",
        "风归花历乱，日度影参差。",
        "容色朝朝落，思君君不知。"
      ],
      "author": {
        "id": 1929,
        "name": "卢照邻"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 334356,
      "title": "横吹曲辞：陇头水",
      "content": [
        "陇阪高无极，征人一望乡。",
        "关河别去水，沙塞断归肠。",
        "马系千年树，旌悬九月霜。",
        "从来共呜咽，皆是为勤王。"
      ],
      "author": {
        "id": 1929,
        "name": "卢照邻"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 334386,
      "title": "横吹曲辞：折杨柳",
      "content": [
        "倡楼启曙扉，园柳正依依。",
        "鸟鸣知岁隔，条变识春归。",
        "露叶疑啼脸，风花乱舞衣。",
        "攀折聊将寄，军中书信稀。"
      ],
      "author": {
        "id": 1929,
        "name": "卢照邻"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 334402,
      "title": "横吹曲辞：关山月",
      "content": [
        "塞垣通碣石，虏障抵祁连。",
        "相思在万里，明月正孤悬。",
        "影移金岫北，光断玉门前。",
        "寄书谢中妇，时看鸿雁天。"
      ],
      "author": {
        "id": 1929,
        "name": "卢照邻"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 334426,
      "title": "横吹曲辞：梅花落",
      "content": [
        "梅岭花初发，天山雪未开。",
        "雪处疑花满，花边似雪回。",
        "因风入舞袖，杂粉向妆台。",
        "匈奴几万里，春至不知来。"
      ],
      "author": {
        "id": 1929,
        "name": "卢照邻"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 334429,
      "title": "横吹曲辞：紫骝马",
      "content": [
        "骝马照金鞍，转战入皋兰。",
        "塞门风稍急，长城水正寒。",
        "雪暗鸣珂重，山长喷玉难。",
        "不辞横绝漠，流血几时干。"
      ],
      "author": {
        "id": 1929,
        "name": "卢照邻"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 334437,
      "title": "横吹曲辞：刘生",
      "content": [
        "刘生气不平，抱剑欲专征。",
        "报恩为豪侠，死难在横行。",
        "翠羽装剑鞘，黄金饰马缨。",
        "但令一顾重，不吝百身轻。"
      ],
      "author": {
        "id": 1929,
        "name": "卢照邻"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 334483,
      "title": "相和歌辞：王昭君",
      "content": [
        "合殿恩中绝，交河使渐稀。",
        "肝肠辞玉辇，形影向金微。",
        "汉宫草应绿，胡庭沙正飞。",
        "愿逐三秋雁，年年一度归。"
      ],
      "author": {
        "id": 1929,
        "name": "卢照邻"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 334873,
      "title": "琴曲歌辞：明月引",
      "content": [
        "洞庭波起兮鸿雁翔，风瑟瑟兮野苍苍。",
        "浮云卷霭，明月流光。",
        "荆南兮赵北，碣石兮潇湘。",
        "澄清规于万里，照离思于千行。",
        "横桂枝于西第，",
        "试登高而极目，莫不变而回肠。"
      ],
      "author": {
        "id": 1929,
        "name": "卢照邻"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 334932,
      "title": "杂曲歌辞：结客少年场行",
      "content": [
        "长安重游侠，洛阳富才雄。",
        "玉剑浮云骑，金鞍明月弓。",
        "斗鸡过渭北，走马向关东。",
        "孙宾遥见待，郭解暗相通。",
        "不受千金爵，谁论万里功。",
        "将军下天上，虏骑入云中。",
        "烽火夜似月，兵气晓成虹。",
        "横行徇知己，负羽远从戎。",
        "龙旌昏朔雾，鸟阵卷寒风。",
        "追奔瀚海咽，战罢阴山空。",
        "归来谢天子，何如马上翁。"
      ],
      "author": {
        "id": 1929,
        "name": "卢照邻"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 335010,
      "title": "杂曲歌辞：行路难",
      "content": [
        "君不见长安城北渭桥边，枯木横槎卧古田。",
        "昔日含红复含紫，常时留雾亦留烟。",
        "春景春风花似雪，",
        "倡家宝袜蛟龙帔，公子银鞍千万骑。",
        "黄莺一向花娇春，",
        "珊瑚叶上鸳鸯鸟，凤凰巢里雏鹓儿。",
        "巢倾枝折凤归去，",
        "人生贵贱无终始，倏忽须臾难久恃。",
        "谁家能驻西山日，",
        "自昔公卿二千石，咸拟荣华一万年。",
        "不见朱唇将白貌，",
        "寄言坐客神仙署，一生一死交情处。",
        "苍龙阙下君不来，",
        "但愿尧年一百万，长作巢由也不辞。"
      ],
      "author": {
        "id": 1929,
        "name": "卢照邻"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 335698,
      "title": "中和乐九章：歌登封第一",
      "content": [
        "炎图丧宝，黄历开璿。",
        "祖武类帝，宗文配天。",
        "玉銮垂日，翠华陵烟。",
        "东云干吕，南风入弦。",
        "山称万岁，河庆千年。",
        "金绳永结，璧丽长悬。"
      ],
      "author": {
        "id": 1929,
        "name": "卢照邻"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 335699,
      "title": "中和乐九章：歌明堂第二",
      "content": [
        "穆穆圣皇，雍雍明堂。",
        "左平右墄，上圆下方。",
        "调均风雨，制度阴阳。",
        "四窗八达，五室九房。",
        "南通夏火，西瞰秋霜。",
        "天子临御，万玉锵锵。"
      ],
      "author": {
        "id": 1929,
        "name": "卢照邻"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 335700,
      "title": "中和乐九章：歌东军第三",
      "content": [
        "遐哉庙略，赫矣台臣。",
        "横戈碣石，倚剑浮津。",
        "风丘佛箨，日域清尘。",
        "岛夷复祀，龙伯来宾。",
        "休兵宇县，献馘天闉。",
        "旆海凯入，耀辉震震。"
      ],
      "author": {
        "id": 1929,
        "name": "卢照邻"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 335701,
      "title": "中和乐九章：歌南郊第四",
      "content": [
        "虔郊上帝，肃事圆丘。",
        "龙驾四牡，鸾旗九斿。",
        "钟歌晚引，紫炀高浮。",
        "日丽苍璧，云飞鸣球。",
        "皇之庆矣，万寿千秋。"
      ],
      "author": {
        "id": 1929,
        "name": "卢照邻"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 335702,
      "title": "中和乐九章：歌中宫第五",
      "content": [
        "祥游沙麓，庆洽瑶衣。",
        "黄云昼聚，白气宵飞。",
        "居中履正，禀和体微。",
        "仪刑赤县，演教椒闱。",
        "陶钧万国，丹青四妃。",
        "河洲在咏，风化攸归。"
      ],
      "author": {
        "id": 1929,
        "name": "卢照邻"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 335703,
      "title": "中和乐九章：歌储宫第六",
      "content": [
        "波澄少海，景丽前星。",
        "高禖诞圣，甲观升灵。",
        "承规翠所，问寝瑶庭。",
        "宗儒侧席，问道横经。",
        "山宾皎皎，国胄青青。",
        "黄裳元吉，邦家以宁。"
      ],
      "author": {
        "id": 1929,
        "name": "卢照邻"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 335704,
      "title": "中和乐九章：歌诸王第七",
      "content": [
        "星陈帝子，岳列天孙。",
        "义光带砺，象著乾坤。",
        "我有明德，利建攸存。",
        "苴以茅社，锡以牺尊。",
        "藩屏王室，翼亮尧门。",
        "八才两献，夫何足论。"
      ],
      "author": {
        "id": 1929,
        "name": "卢照邻"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 335705,
      "title": "中和乐九章：歌公卿第八",
      "content": [
        "蹇蹇三事，师师百僚。",
        "群龙在职，振鹭盈朝。",
        "丰金辉首，佩玉鸣腰。",
        "青蒲翼翼，丹地翘翘。",
        "歌云佐汉，捧日匡尧。",
        "天工人代，邈邈昭昭。"
      ],
      "author": {
        "id": 1929,
        "name": "卢照邻"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 335706,
      "title": "中和乐九章：总歌第九",
      "content": [
        "明明天子兮圣德扬，穆穆皇后兮阴化康。",
        "登若木兮坐明堂，池蒙汜兮家扶桑。",
        "武化偃兮文化昌，礼乐昭兮股肱良。",
        "君臣已定兮君永无疆，颜子更生兮徒皇皇。",
        "若有人兮天一方，忠为衣兮信为裳。",
        "餐白玉兮饮琼芳，心思荃兮路阻长。"
      ],
      "author": {
        "id": 1929,
        "name": "卢照邻"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 335707,
      "title": "关山月",
      "content": [
        "塞坦通碣石，虏障抵祁连。",
        "相思在万里，明月正孤悬。",
        "影移金岫北，光断玉门前。",
        "寄言闺中妇，时看鸿雁天。"
      ],
      "author": {
        "id": 1929,
        "name": "卢照邻"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 335709,
      "title": "紫骝马",
      "content": [
        "骝马照金鞍，转战入皋兰。",
        "塞门风稍急，长城水正寒。",
        "雪暗鸣珂重，山长喷玉难。",
        "不辞横绝漠，流血几时干。"
      ],
      "author": {
        "id": 1929,
        "name": "卢照邻"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 335711,
      "title": "梅花落",
      "content": [
        "梅岭花初发，天山雪未开。",
        "雪处疑花满，花边似雪回。",
        "因风入舞袖，杂粉向妆台。",
        "匈奴几万里，春至不知来。"
      ],
      "author": {
        "id": 1929,
        "name": "卢照邻"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 335712,
      "title": "结客少年场行",
      "content": [
        "长安重游侠，洛阳富财雄。",
        "玉剑浮云骑，金鞭明月弓。",
        "斗鸡过渭北，走马向关东。",
        "孙宾遥见待，郭解暗相通。",
        "不受千金爵，谁论万里功。",
        "将军下天上，虏骑入云中。",
        "烽火夜似月，兵气晓成虹。",
        "横行徇知己，负羽远从戎。",
        "龙旌昏朔雾，鸟阵卷胡风。",
        "追奔瀚海咽，战罢阴山空。",
        "归来谢天子，何如马上翁。"
      ],
      "author": {
        "id": 1929,
        "name": "卢照邻"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 335713,
      "title": "咏史四首",
      "content": [
        "季生昔未达，身辱功不成。",
        "髡钳为台隶，灌园变姓名。",
        "幸逢滕将军，兼遇曹丘生。",
        "汉祖广招纳，一朝拜公卿。",
        "百金孰云重，一诺良匪轻。",
        "廷议斩樊哙，群公寂无声。",
        "处身孤且直，遭时坦而平。",
        "丈夫当如此，唯唯何足荣。",
        "大汉昔云季，小人道遂振。",
        "玉帛委奄尹，斧锧婴缙绅。",
        "邈哉郭先生，卷舒得其真。",
        "雍容谢朝廷，谈笑奖人伦。",
        "在晦不绝俗，处乱不为亲。",
        "诸侯不得友，天子不得臣。",
        "冲情甄负甑，重价折角巾。",
        "悠悠天下士，相送洛桥津。",
        "谁知仙舟上，寂寂无四邻。",
        "公业负奇志，交结尽才雄。",
        "良田四百顷，所食常不充。",
        "一为侍御史，慷慨说何公。",
        "何公何为败，吾谋适不同。",
        "仲颖恣残忍，废兴良在躬。",
        "死人如乱麻，天子如转蓬。",
        "干戈及黄屋，荆棘生紫宫。",
        "郑生运其谋，将以清国戎。",
        "时来命不遂，脱身归山东。",
        "凛凛千载下，穆然怀清风。",
        "昔有平陵男，姓朱名阿游。",
        "直发上冲冠，壮气横三秋。",
        "愿得斩马剑，先断佞臣头。",
        "天子玉槛折，将军丹血流。",
        "捐生不肯拜，视死其若休。",
        "归来教乡里，童蒙远相求。",
        "弟子数百人，散在十二州。",
        "三公不敢吏，五鹿何能酬。",
        "名与日月悬，义与天壤俦。",
        "何必疲执戟，区区在封侯。",
        "伟哉旷达士，知命固不忧。"
      ],
      "author": {
        "id": 1929,
        "name": "卢照邻"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 335716,
      "title": "三月曲水宴得尊字",
      "content": [
        "风烟彭泽里，山水仲长园。",
        "由来弃铜墨，本自重琴尊。",
        "高情邈不嗣，雅道今复存。",
        "有美光时彦，养德坐山樊。",
        "门开芳杜径，室距桃花源。",
        "公子黄金勒，仙人紫气轩。",
        "长怀去城市，高咏狎兰荪。",
        "连沙飞白鹭，孤屿啸玄猿。",
        "日影岩前落，云花江上翻。",
        "兴阑车马散，林塘夕鸟喧。"
      ],
      "author": {
        "id": 1929,
        "name": "卢照邻"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 335717,
      "title": "奉使益州至长安发钟阳驿",
      "content": [
        "跻险方未夷，乘春聊骋望。",
        "落花赴丹谷，奔流下青嶂。",
        "葳蕤晓树滋，滉漾春江涨。",
        "平川看钓侣，狭径闻樵唱。",
        "蝶戏绿苔前，莺歌白云上。",
        "耳目多异赏，风烟有奇状。",
        "峻阻将长城，高标吞巨舫。",
        "联翩事羁靮，辛苦劳疲恙。",
        "夕济几潺湲，晨登每惆怅。",
        "谁念复刍狗，山河独偏丧。"
      ],
      "author": {
        "id": 1929,
        "name": "卢照邻"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 335718,
      "title": "和王奭秋夜有所思",
      "content": [
        "寂寂南轩夜，悠然怀所知。",
        "长河落雁苑，明月下鲸池。",
        "凤台有清曲，此曲何人吹。",
        "丹唇间玉齿，妙响入云涯。",
        "穷巷秋风叶，空庭寒露枝。",
        "劳歌欲有和，星鬓已将垂。"
      ],
      "author": {
        "id": 1929,
        "name": "卢照邻"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 335719,
      "title": "望宅中树有所思",
      "content": [
        "我家有庭树，秋叶正离离。",
        "上舞双栖鸟，中秀合欢枝。",
        "劳思复劳望，相见不相知。",
        "何当共攀折，歌笑此堂垂。"
      ],
      "author": {
        "id": 1929,
        "name": "卢照邻"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 335720,
      "title": "宿晋安亭",
      "content": [
        "闻有弦歌地，穿凿本多奇。",
        "游人试一览，临玩果忘疲。",
        "窗横暮卷叶，簷卧古生枝。",
        "旧石开红藓，新河覆绿池。",
        "孤猿稍断绝，宿鸟复参差。",
        "泛滟月华晓，裴回星鬓垂。",
        "今日删书客，凄惶君讵知。"
      ],
      "author": {
        "id": 1929,
        "name": "卢照邻"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 335721,
      "title": "于时春也，慨然有江湖之思，寄赠柳九陇",
      "content": [
        "提琴一万里，负书三十年。",
        "晨攀偃蹇树，暮宿清泠泉。",
        "翔禽鸣我侧，旅兽过我前。",
        "无人且无事，独酌还独眠。",
        "遥闻彭泽宰，高弄武城弦。",
        "形骸寄文墨，意气托神仙。",
        "我有壶中要，题为物外篇。",
        "将以贻好道，道远莫致旃。",
        "相思劳日夜，相望阻风烟。",
        "坐惜春华晚，徒令客思悬。",
        "水去东南地，气凝西北天。",
        "关山悲蜀道，花鸟忆秦川。",
        "天子何时问，公卿本亦怜。",
        "自哀还自乐，归薮复归田。",
        "海屋银为栋，云车电作鞭。",
        "倘遇鸾将鹤，谁论貂与蝉。",
        "莱洲频度浅，桃实几成圆。",
        "寄言飞凫舄，岁晏同联翩。"
      ],
      "author": {
        "id": 1929,
        "name": "卢照邻"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 335722,
      "title": "至望喜瞩目言怀贻剑外知己",
      "content": [
        "圣图夷九折，神化掩三分。",
        "缄愁赴蜀道，题拙奉虞熏。",
        "隐辚度深谷，遥袅上高云。",
        "碧流递萦注，青山互纠纷。",
        "涧松咽风绪，岩花濯露文。",
        "思北常依驭，图南每丧群。",
        "无由召宣室，何以答吾君。"
      ],
      "author": {
        "id": 1929,
        "name": "卢照邻"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 335723,
      "title": "赤谷安禅师塔",
      "content": [
        "独坐岩之曲，悠然无俗纷。",
        "酌酒呈丹桂，思诗赠白云。",
        "烟霞朝晚聚，猿鸟岁时闻。",
        "水华竞秋色，山翠含夕曛。",
        "高谈十二部，细核五千文。",
        "如如数冥昧，生生理氛氲。",
        "古人有糟粕，轮扁情未分。",
        "且当事芝术，从吾所好云。"
      ],
      "author": {
        "id": 1929,
        "name": "卢照邻"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 335724,
      "title": "赠益府裴录事",
      "content": [
        "忽忽岁云暮，相望限风烟。",
        "长歌欲对酒，危坐遂停弦。",
        "停弦变霜露，对酒怀朋故。",
        "朝看桂蟾晚，夜闻鸿雁度。",
        "鸿度何时还，桂晚不同攀。",
        "浮云映丹壑，明月满青山。",
        "青山云路深，丹壑月华临。",
        "耿耿离忧积，空令星鬓侵。"
      ],
      "author": {
        "id": 1929,
        "name": "卢照邻"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 335725,
      "title": "赠益府群官",
      "content": [
        "一鸟自北燕，飞来向西蜀。",
        "单栖剑门上，独舞岷山足。",
        "昂藏多古貌，哀怨有新曲。",
        "群凤从之游，问之何所欲。",
        "答言寒乡子，飘飖万余里。",
        "不息恶木枝，不饮盗泉水。",
        "常思稻粱遇，愿栖梧桐树。",
        "智者不我邀，愚夫余不顾。",
        "所以成独立，耿耿岁云暮。",
        "日夕苦风霜，思归赴洛阳。",
        "羽翮毛衣短，关山道路长。",
        "明月流客思，白云迷故乡。",
        "谁能借风便，一举凌苍苍。"
      ],
      "author": {
        "id": 1929,
        "name": "卢照邻"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 335727,
      "title": "大剑送别刘右史",
      "content": [
        "金碧禺山远，关梁蜀道难。",
        "相逢属晚岁，相送动征鞍。",
        "地咽绵川冷，云凝剑阁寒。",
        "倘遇忠孝所，为道忆长安。"
      ],
      "author": {
        "id": 1929,
        "name": "卢照邻"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 335729,
      "title": "失群雁",
      "content": [
        "三秋北地雪皑皑，万里南翔渡海来。",
        "欲随石燕沉湘水，",
        "先过上苑传书信，暂下中州戏稻粱。",
        "虞人负缴来相及，",
        "唯有庄周解爱鸣，复道郊哥重奇色。",
        "惆怅惊思悲未已，",
        "云间海上应鸣舞，远得鶤弦犹独抚。",
        "金龟全写中牟印，"
      ],
      "author": {
        "id": 1929,
        "name": "卢照邻"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 335730,
      "title": "行路难",
      "content": [
        "君不见长安城北渭桥边，枯木横槎卧古田。",
        "昔日含红复含紫，常时留雾亦留烟。",
        "春景春风花似雪，",
        "娼家宝袜蛟龙帔，公子银鞍千万骑。",
        "黄莺一一向花娇，",
        "珊瑚叶上鸳鸯鸟，凤凰巢里雏鹓儿。",
        "巢倾枝折凤归去。",
        "条枯叶落任风吹。",
        "一朝零落无人问，万古摧残君讵知。",
        "人生贵贱无终始，倏忽须臾难久恃。",
        "谁家能驻西山日，",
        "自昔公卿二千石，咸拟荣华一万年。",
        "不见朱唇将白貌，",
        "寄言坐客神仙署，一生一死交情处。",
        "苍龙阙下君不来，",
        "但愿尧年一百万，长作巢由也不辞。"
      ],
      "author": {
        "id": 1929,
        "name": "卢照邻"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 335731,
      "title": "长安古意",
      "content": [
        "长安大道连狭斜，青牛白马七香车。",
        "玉辇纵横过主第，",
        "百丈游丝争绕树，一群娇鸟共啼花。",
        "啼花戏蝶千门侧，",
        "梁家画阁天中起，汉帝金茎云外直。",
        "楼前相望不相知，",
        "得成比目何辞死，愿作鸳鸯不羡仙。",
        "比目鸳鸯真可羡，",
        "双燕双飞绕画梁，罗纬翠被郁金香。",
        "片片行云著蝉鬓，",
        "妖童宝马铁连钱，娼妇盘龙金屈膝。",
        "御史府中乌夜啼，",
        "挟弹飞鹰杜陵北，探丸借客渭桥西。",
        "俱邀侠客芙蓉剑，",
        "北堂夜夜人如月，南陌朝朝骑似云。",
        "南陌北堂连北里，",
        "汉代金吾千骑来，翡翠屠苏鹦鹉杯。",
        "罗襦宝带为君解，",
        "意气由来排灌夫，专权判不容萧相。",
        "专权意气本豪雄，",
        "节物风光不相待，桑田碧海须臾改。",
        "昔时金阶白玉堂，",
        "独有南山桂花发，飞来飞去袭人裾。"
      ],
      "author": {
        "id": 1929,
        "name": "卢照邻"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 335732,
      "title": "明月引",
      "content": [
        "洞庭波起兮鸿雁翔，风瑟瑟兮野苍苍。",
        "浮云卷霭，明月流光。",
        "荆南兮赵北，碣石兮潇湘。",
        "澄清规于万里，照离思于千行。",
        "横桂枝于西第，",
        "文姬绝域，侍子他乡。",
        "见胡鞍之似练，知汉剑之如霜。",
        "试登高而骋目，莫不变而回肠。"
      ],
      "author": {
        "id": 1929,
        "name": "卢照邻"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 335734,
      "title": "怀仙引",
      "content": [
        "若有人兮山之曲，驾青虬兮乘白鹿，往从之游愿心足。",
        "披涧户，访岩轩，石濑潺湲横石径，松萝幂zx掩松门。",
        "下空蒙而无鸟，上巉岩而有猿。",
        "怀飞阁，度飞梁。",
        "休余马于幽谷，挂余冠于夕阳。",
        "曲复曲兮烟庄邃，",
        "山坱轧，磴连褰。",
        "攀旧壁而无据，溯泥溪而不前。",
        "向无情之白日，窃有恨于皇天。",
        "回行遵故道，",
        "珠为阙兮玉为楼，青云盖兮紫霜裘。",
        "天长地久时相忆，千龄万代一来游。"
      ],
      "author": {
        "id": 1929,
        "name": "卢照邻"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 335735,
      "title": "七日登乐游故墓",
      "content": [
        "四序周缇钥，三正纪璿耀。",
        "绿野变初黄，旸山开晓眺。",
        "中天擢露掌，匝地分星徼。",
        "汉寝眷遗灵，秦江想余吊。",
        "蚁泛青田酌，莺歌紫芝调。",
        "柳色摇岁华，冰文荡春照。",
        "远迹谢群动，高情符众妙。",
        "兰游澹未归，倾光下岩窈。"
      ],
      "author": {
        "id": 1929,
        "name": "卢照邻"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 335736,
      "title": "释疾文三歌",
      "content": [
        "岁将暮兮欢不再，时已晚兮忧来多。",
        "东郊绝此麒麟笔，",
        "岁去忧来兮东流水，地久天长兮人共死。",
        "明镜羞窥兮向十年，骏马停驱兮几千里。",
        "麟兮凤兮，自古吞恨无已。",
        "茨山有薇兮颍水有漪，夷为柏兮秋有实。",
        "叔为柳兮春向飞。",
        "倏尔而笑，泛沧浪兮不归。"
      ],
      "author": {
        "id": 1929,
        "name": "卢照邻"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 335738,
      "title": "刘生",
      "content": [
        "刘生气不平，抱剑欲专征。",
        "报恩为豪侠，死难在横行。",
        "翠羽装刀鞘，黄金饰马铃。",
        "但令一顾重，不吝百身轻。"
      ],
      "author": {
        "id": 1929,
        "name": "卢照邻"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 335740,
      "title": "巫山高",
      "content": [
        "巫山望不极，望望下朝氛。",
        "莫辨啼猿树，徒看神女云。",
        "惊涛乱水脉，骤雨暗峰文。",
        "沾裳即此地，况复远思君。"
      ],
      "author": {
        "id": 1929,
        "name": "卢照邻"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 335749,
      "title": "石镜寺",
      "content": [
        "古墓芙蓉塔，神铭松柏烟。",
        "鸾沉仙镜底，花没梵轮前。",
        "铢衣千古佛，宝月两重圆。",
        "隐隐香台夜，钟声彻九天。"
      ],
      "author": {
        "id": 1929,
        "name": "卢照邻"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 335750,
      "title": "辛法司宅观妓",
      "content": [
        "南国佳人至，北堂罗荐开。",
        "长裙随凤管，促柱送鸾杯。",
        "云光身后落，雪态掌中回。",
        "到愁金谷晚，不怪玉山颓。"
      ],
      "author": {
        "id": 1929,
        "name": "卢照邻"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 335751,
      "title": "春晚山庄率题二首",
      "content": [
        "顾步三春晚，田园四望通。",
        "游丝横惹树，戏蝶乱依丛。",
        "竹懒偏宜水，花狂不待风。",
        "唯余诗酒意，当了一生中。",
        "田家无四邻，独坐一园春。",
        "莺啼非选树，鱼戏不惊纶。",
        "山水弹琴尽，风花酌酒频。",
        "年华已可乐，高兴复留人。"
      ],
      "author": {
        "id": 1929,
        "name": "卢照邻"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 335752,
      "title": "江中望月",
      "content": [
        "江水向涔阳，澄澄写月光。",
        "镜圆珠溜彻，弦满箭波长。",
        "沉钩摇兔影，浮桂动丹芳。",
        "延照相思夕，千里共沾裳。"
      ],
      "author": {
        "id": 1929,
        "name": "卢照邻"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 335754,
      "title": "益州城西张超亭观妓",
      "content": [
        "落日明歌席，行云逐舞人。",
        "江前飞暮雨，梁上下轻尘。",
        "冶服看疑画，妆楼望似春。",
        "高车勿遽返，长袖欲相亲。"
      ],
      "author": {
        "id": 1929,
        "name": "卢照邻"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 335756,
      "title": "至陈仓晓晴望京邑",
      "content": [
        "拂曙驱飞传，初晴带晓凉。",
        "雾敛长安树，云归仙帝乡。",
        "涧流漂素沫，岩景霭朱光。",
        "今朝好风色，延瞰极天庄。"
      ],
      "author": {
        "id": 1929,
        "name": "卢照邻"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 335759,
      "title": "七夕泛舟二首",
      "content": [
        "汀葭肃徂暑，江树起初凉。",
        "水疑通织室，舟似泛仙潢。",
        "连桡渡急响，鸣棹下浮光。",
        "日晚菱歌唱，风烟满夕阳。",
        "凤杼秋期至，凫舟野望开。",
        "微吟翠塘侧，延想白云隈。",
        "石似支机罢，槎疑犯宿来。",
        "天潢殊漫漫，日暮独悠哉。"
      ],
      "author": {
        "id": 1929,
        "name": "卢照邻"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 335762,
      "title": "绵州官池赠别同赋湾字",
      "content": [
        "輶轩遵上国，仙佩下灵关。",
        "尊酒方无地，联绻喜暂攀。",
        "离言欲赠策，高辨正连环。",
        "野径浮云断，荒池春草斑。",
        "残花落古树，度鸟入澄湾。",
        "欲叙他乡别，幽谷有绵蛮。"
      ],
      "author": {
        "id": 1929,
        "name": "卢照邻"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 335763,
      "title": "还赴蜀中贻示京邑游好",
      "content": [
        "籞宿花初满，章台柳向飞。",
        "如何正此日，还望昔多违。",
        "怅别风期阻，将乖云会稀。",
        "敛衽辞丹阙，悬旗陟翠微。",
        "野禽喧戍鼓，春草变征衣。",
        "回顾长安道，关山起夕霏。"
      ],
      "author": {
        "id": 1929,
        "name": "卢照邻"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 335765,
      "title": "山庄休沐",
      "content": [
        "兰署乘闲日，蓬扉狎遁栖。",
        "龙柯疏玉井，凤叶下金堤。",
        "川光摇水箭，山气上云梯。",
        "亭幽闻唳鹤，窗晓听鸣鸡。",
        "玉轸临风奏，琼浆映月携。",
        "田家自有乐，谁肯谢青溪。"
      ],
      "author": {
        "id": 1929,
        "name": "卢照邻"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 335766,
      "title": "山林休日田家",
      "content": [
        "归休乘暇日，馌稼返秋场。",
        "径草疏王彗，岩枝落帝桑。",
        "耕田虞讼寝，凿井汉机忘。",
        "戎葵朝委露，齐枣夜含霜。",
        "南涧泉初冽，东篱菊正芳。",
        "还思北窗下，高卧偃羲皇。"
      ],
      "author": {
        "id": 1929,
        "name": "卢照邻"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 335767,
      "title": "宴梓州南亭得池字",
      "content": [
        "二条开胜迹，大隐叶冲规。",
        "亭阁分危岫，楼台绕曲池。",
        "长薄秋烟起，飞梁古蔓垂。",
        "水鸟翻荷叶，山虫咬桂枝。",
        "游人惜将晚，公子爱忘疲。",
        "愿得回三舍，琴尊长若斯。"
      ],
      "author": {
        "id": 1929,
        "name": "卢照邻"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 335769,
      "title": "首春贻京邑文士",
      "content": [
        "寂寂罢将迎，门无车马声。",
        "横琴答山水，披卷阅公卿。",
        "忽闻岁云晏，倚仗出簷楹。",
        "寒辞杨柳陌，春满凤凰城。",
        "梅花扶院吐，兰叶绕阶生。",
        "览镜改容色，藏书留姓名。",
        "时来不假问，生死任交情。"
      ],
      "author": {
        "id": 1929,
        "name": "卢照邻"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 335773,
      "title": "酬张少府柬之",
      "content": [
        "昔余与夫子，相遇汉川阴。",
        "珠浦龙犹卧，檀溪马正沉。",
        "价重瑶山曲，词惊丹凤林。",
        "十年睽赏慰，万里隔招寻。",
        "毫翰风期阻，荆衡云路深。",
        "鹏飞俱望昔，蠖屈共悲今。",
        "谁谓青衣道，还叹白头吟。",
        "地接神仙涧，江连云雨岑。",
        "飞泉如散玉，落日似悬金。",
        "重以瑶华赠，空怀舞咏心。"
      ],
      "author": {
        "id": 1929,
        "name": "卢照邻"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 335774,
      "title": "过东山谷口",
      "content": [
        "不知名利险，辛苦滞皇州。",
        "始觉飞尘倦，归来事绿畴。",
        "桃源迷处所，桂树可淹留。",
        "迹异人间俗，禽同海上鸥。",
        "古苔依井被，新乳傍崖流。",
        "野老堪成鹤，山神或化鸠。",
        "泉鸣碧涧底，花落紫岩幽。",
        "日暮餐龟壳，开寒御鹿裘。",
        "不辨秦将汉，宁知春与秋。",
        "多谢青溪客，去去赤松游。"
      ],
      "author": {
        "id": 1929,
        "name": "卢照邻"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 335775,
      "title": "送幽州陈参军赴任寄呈乡曲父老",
      "content": [
        "蓟北三千里，关西二十年。",
        "冯唐犹在汉，乐毅不归燕。",
        "人同黄鹤远，乡共白云连。",
        "郭隗池台处，昭王尊酒前。",
        "故人当已老，旧壑几成田。",
        "红颜如昨日，衰鬓似秋天。",
        "西蜀桥应毁，东周石尚全。",
        "灞池水犹绿，榆关月早圆。",
        "塞云初上雁，庭树欲销蝉。",
        "送君之旧国，挥泪独潸然。"
      ],
      "author": {
        "id": 1929,
        "name": "卢照邻"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 335777,
      "title": "哭明堂裴主簿",
      "content": [
        "缔欢三十载，通家数百年。",
        "潘杨称代穆，秦晋忝姻连。",
        "风云洛阳道，花月茂陵田。",
        "相悲共相乐，交骑复交筵。",
        "始谓调金鼎，如何掩玉泉。",
        "黄公酒炉处，青眼竹林前。",
        "故琴无复雪，新树但生烟。",
        "遽痛兰襟断，徒令宝剑悬。",
        "客散同秋叶，人亡似夜川。",
        "送君一长恸，松台路几千。"
      ],
      "author": {
        "id": 1929,
        "name": "卢照邻"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 335784,
      "title": "葮川独泛",
      "content": [
        "倚棹春江上，横舟石岸前。",
        "山暝行人断，迢迢独泛仙。"
      ],
      "author": {
        "id": 1929,
        "name": "卢照邻"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 335786,
      "title": "宿玄武二首",
      "content": [
        "方池开晓色，圆月下秋阴。",
        "已乘千里兴，还抚一弦琴。",
        "庭摇北风柳，院绕南溟禽。",
        "累宿恩方重，穷秋叹不深。"
      ],
      "author": {
        "id": 1929,
        "name": "卢照邻"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 335787,
      "title": "九陇津集",
      "content": [
        "落落树阴紫，澄澄水华碧。",
        "复有翻飞禽，裴回疑曳舄。"
      ],
      "author": {
        "id": 1929,
        "name": "卢照邻"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 335789,
      "title": "登封大酺歌四首",
      "content": [
        "明君封禅日重光，天子垂衣历数长。",
        "九州四海常无事，万岁千秋乐未央。",
        "日观仙云随凤辇，天门瑞雪照龙衣。",
        "繁弦绮席方终夜，妙舞清歌欢未归。",
        "翠凤逶迤登介丘，仙鹤裴回天上游。",
        "借问干封何所乐，人皆寿命得千秋。",
        "千年圣主应昌期，万国淳风王化基。",
        "请比上古无为代，何如今日太平时。"
      ],
      "author": {
        "id": 1929,
        "name": "卢照邻"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    }
