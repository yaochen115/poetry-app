{
  "data": [
    {
      "id": 276304,
      "title": "下第贻友人",
      "content": [
        "身在关西家洞庭，夜寒歌苦烛荧荧。",
        "人心高下月中桂，客思往来波上萍。",
        "马氏识君眉最白，阮公留我眼长青。",
        "花前失意共寥落，莫遣东风吹酒醒。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276305,
      "title": "晚登龙门驿楼",
      "content": [
        "鱼龙多处凿门开，万古人知夏禹材。",
        "青嶂远分从地断，洪流高泻自天来。",
        "风云有路皆烧尾，波浪无程尽曝腮。",
        "心感膺门身过此，晚山秋树独徘徊。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276306,
      "title": "题故李秀才居",
      "content": [
        "曾醉笙歌日正迟，醉中相送易前期。",
        "橘花满地人亡后，菰叶连天鴈过时。",
        "琴倚旧窗尘漠漠，剑埋新冢草离离。",
        "河桥酒熟平生事，更向东流奠一巵。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276307,
      "title": "韶州韶阳楼夜䜩",
      "content": [
        "待月西楼卷翠罗，玉杯瑶瑟近星河。",
        "帘前碧树穷秋密，窗外青山薄暮多。",
        "鸜鹆未知狂客醉，鹧鸪先让美人歌。",
        "使君莫惜通宵饮，刀笔初从马伏波。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276308,
      "title": "闻韶州李相公移拜郴州因寄",
      "content": [
        "诏移丞相木兰舟，桂水潺湲岭北流。",
        "青汉梦归双阙曙，白云吟过五湖秋。",
        "恩回玉扆人先喜，道在金縢世不忧。",
        "闻说公卿尽南望，甘堂花暖凤池头。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276309,
      "title": "游江令旧宅",
      "content": [
        "身没南朝宅已荒，邑人犹赏旧风光。",
        "芹根生叶石池浅，桐树落花金井香。",
        "带暖山蜂巢画阁，欲阴溪燕集书堂。",
        "闲愁此地更西望，潮侵台城春草长。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276310,
      "title": "灞上逢元九处士东归",
      "content": [
        "瘦马频嘶灞水寒，灞南高处望长安。",
        "何人更结王生韤，此客虚弹贡氏冠。",
        "江上蟹螯沙渺渺，坞中蜗壳雪漫漫。",
        "旧交已变新知少，却伴渔郎把钓竿。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276311,
      "title": "别张秀才",
      "content": [
        "不知何计写离忧，万里山川半旧游。",
        "风卷暮沙和雪起，日融春水带冰流。",
        "凌晨客泪分东郭，竟夕乡心共北楼。",
        "青桂一枝年少事，莫因鲈鲙涉穷秋。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276312,
      "title": "别表兄军倅",
      "content": [
        "卢橘花香拂钓矶，佳人犹舞越罗衣。",
        "三洲水浅鱼来少，五岭山高鴈到稀。",
        "客路晚依红树宿，乡关朝望白云归。",
        "交亲不念征南吏，昨夜风帆去似飞。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276313,
      "title": "题苏州虎丘寺僧院",
      "content": [
        "暂引寒泉濯远尘，此生多是异乡人。",
        "荆溪夜雨花开疾，吴苑秋风月满频。",
        "万里高低门外路，百年荣辱梦中身。",
        "世间谁似西林客，一卧烟霞四十春。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276314,
      "title": "酬郭少府先奉使巡涝见寄兼呈裴明府",
      "content": [
        "载书携榼别池龙，十幅轻帆处处通。",
        "谢朓宅荒山翠里，王敦城古月明中。",
        "江村夜涨浮天水，泽国秋生动地风。",
        "饱食鲙鱼榜归檝，待君琴酒醉陶公。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276315,
      "title": "出永通门经李氏庄",
      "content": [
        "飞轩危槛百花堂，朝䜩歌钟暮已荒。",
        "中散狱成琴自怨，步兵厨废酒犹香。",
        "风池宿鸟喧朱阁，雨砌秋萤拂画梁。",
        "力保山河家又庆，秪应中令敌汾阳。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276316,
      "title": "汉水伤稼",
      "content": [
        "西北楼开四望通，残霞成绮月悬弓。",
        "江村夜涨浮天水，泽国秋生动地风。",
        "高下绿苗千顷尽，新陈红粟万厫空。",
        "才微分薄忧何益，却欲回心学钓翁。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276317,
      "title": "送王总下第归丹阳",
      "content": [
        "秦楼心断楚江湄，系马春风酒一巵。",
        "汴水月明东下疾，练塘花发北来迟。",
        "青芜定没安贫处，黄叶应催献赋诗。",
        "凭寄家书为回报，旧乡还有故人知。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276318,
      "title": "南阳道中",
      "content": [
        "月斜孤馆傍村行，野店高低带古城。",
        "篱上晓花斋后落，井边秋叶社前生。",
        "饥乌索哺随雏叫，乳牸慵归望犊鸣。",
        "荒草连天风动地，不知谁学武侯耕。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276319,
      "title": "破北虏太和公主归宫阙",
      "content": [
        "毳幕承秋极断蓬，飘飖一剑黑山空。",
        "匈奴北走荒秦垒，贵主西还盛汉宫。",
        "定是庙谟倾种落，必知边寇畏骁雄。",
        "恩霑残类从归去，莫使华人杂犬戎。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276320,
      "title": "李定言自殿院衔命归阙拜员外郎迁右史因寄",
      "content": [
        "白笔南征变二毛，越山愁瘴海惊涛。",
        "才归龙尾含鸡舌，更立螭头运兔毫。",
        "阊阖欲开宫漏尽，冕旒初坐御香高。",
        "吴中旧侣君先贵，曾忆王祥与佩刀。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276321,
      "title": "早秋韶阳夜雨",
      "content": [
        "宋玉含凄梦亦惊，芙蓉山响一猨声。",
        "阴云迎雨枕先润，夜电引雷窗暂明。",
        "暗惜水花飘广槛，远愁风叶下高城。",
        "西归万里未千里，应到故园春草生。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276322,
      "title": "将为南行陪尚书崔公宴海榴堂",
      "content": [
        "朝䜩华堂暮未休，几人偏得谢公留。",
        "风传鼓角霜侵戟，云卷笙歌月上楼。",
        "宾馆尽开徐穉榻，客帆空恋李膺舟。",
        "谩夸书剑无知己，水远山长步步愁。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276323,
      "title": "赠王山人",
      "content": [
        "贳酒携琴访我频，始知城市有闲人。",
        "君臣药在宁忧病，子母钱成岂患贫。",
        "年长每劳推甲子，夜寒初共守庚申。",
        "近来闻说烧丹处，玉洞桃花万树春。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276324,
      "title": "宣城崔大夫召联句偶疾不获赴因献",
      "content": [
        "心慕知音命自拘，画堂闻欲试吹竽。",
        "茂陵罢酒慙中圣，漳浦题诗怯大巫。",
        "鬐鬣几年伤在藻，羽毛终日羡栖梧。",
        "还愁旅棹空归去，枫叶荷花钓五湖。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276325,
      "title": "赠郑处士",
      "content": [
        "道傍年少莫矜夸，心在重霄鬓未华。",
        "杨子可曾过北里，鲁人何必敬东家。",
        "寒云晓散千峰雪，暖雨晴开一迳花。",
        "且卖湖田酿春酒，与君书剑是生涯。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276326,
      "title": "正元",
      "content": [
        "高揭鸡竿辟帝阍，祥风微暖瑞云屯。",
        "千官共削奸臣迹，万国初衔圣主恩。",
        "宫殿雪华齐紫阁，关河春色到青门。",
        "华夷一轨人方泰，莫学论兵误至尊。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276327,
      "title": "登尉佗楼",
      "content": [
        "刘项持兵鹿未穷，自乘黄屋岛夷中。",
        "南来作尉任嚣力，北向称臣陆贾功。",
        "箫鼓尚陈今世庙，旌旗犹镇昔时宫。",
        "越人未必知虞舜，一奏薰弦万古风。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276328,
      "title": "诏州驿楼宴罢",
      "content": [
        "簷外千帆背夕阳，归心杳杳鬓苍苍。",
        "岭猨群宿夜山静，沙鸟独飞秋水凉。",
        "露堕桂花棋局湿，风吹荷叶酒瓶香。",
        "主人不醉下楼去，月在南轩更漏长。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276329,
      "title": "和淮南王相公与宾僚同游瓜洲别业题旧书斋",
      "content": [
        "碧油红斾想青衿，积雪窗前尽日吟。",
        "巢鹤去时云树老，卧龙归处石潭深。",
        "道傍苦李犹垂实，城外甘棠已布阴。",
        "宾御莫辞岩下醉，武丁高枕待为霖。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276330,
      "title": "送卢先辈自衡岳赴复州嘉礼二首 一",
      "content": [
        "名振金闺步玉京，暂留沧海见高情。",
        "众花尽处松千尺，群鸟喧时鹤一声。",
        "朱阁簟凉疎雨过，碧溪船动早潮生。",
        "离心不异西江水，直送征帆万里行。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276331,
      "title": "送卢先辈自衡岳赴复州嘉礼二首 二",
      "content": [
        "湘南诗客海中行，鹏翅垂云不自矜。",
        "秋水静磨金镜土，夜风寒结玉壶冰。",
        "万重岭峤辞衡岳，千里山陂问竟陵。",
        "醉倚西楼人已远，柳溪无浪月澄澄。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276332,
      "title": "哭杨攀处士",
      "content": [
        "先生忧道乐清贫，白发终为不仕身。",
        "嵇阮没来无酒客，应刘亡后少诗人。",
        "山前月照荒坟晓，溪上花开旧宅春。",
        "昨夜回舟更惆怅，至今钟磬满南邻。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276333,
      "title": "宿松江驿却寄苏州一二同志",
      "content": [
        "候馆人稀夜自长，姑苏台远树苍苍。",
        "江湖潮落高楼迥，河汉秋归广簟凉。",
        "月转碧梧移鹊影，露低红叶湿萤光。",
        "西园诗侣应多思，莫醉笙歌掩画堂。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276334,
      "title": "卢山人自巴蜀由湘潭归茅山因赠",
      "content": [
        "太乙灵方炼紫荷，紫荷飞尽髪皤皤。",
        "猨啼巫峡晓云薄，鴈宿洞庭秋月多。",
        "导引岂如桃叶舞，步虚宁比竹枝歌。",
        "华阳旧隐莫归去，水没芝田生绿莎。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276335,
      "title": "颍州从事西湖亭䜩饯",
      "content": [
        "西湖清宴不知回，一曲离歌酒一杯。",
        "城带夕阳闻鼓角，寺临秋水见楼台。",
        "兰堂客散蝉犹噪，桂檝人稀鸟自来。",
        "独想征车过巩洛，此中霜菊遶潭开。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276336,
      "title": "瓜洲留别李诩",
      "content": [
        "泣玉三年一见君，白衣顦顇更离群。",
        "柳堤惜别春潮落，花榭留欢夜漏分。",
        "孤馆宿时风带雨，远帆归处水连云。",
        "悲歌曲尽莫重奏，心遶关河不忍闻。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276337,
      "title": "余谢病东归王秀才见寄今潘秀才南櫂奉酬",
      "content": [
        "酷似牢之玉不如，落星山下白云居。",
        "春耕旋搆金门客，夜学兼修玉府书。",
        "风扫碧云迎鸷鸟，水还沧海养嘉鱼。",
        "莫将年少轻时节，王氏家风在石渠。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276338,
      "title": "献韶阳相国崔公",
      "content": [
        "一匮为功极九层，康庄犹自剑棱棱。",
        "舟回北渚经年泊，门接东山尽日登。",
        "万国已闻传玉玺，百官犹望启金縢。",
        "贤臣会致唐虞世，独倚江楼笑范增。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276339,
      "title": "郡斋夜坐寄旧乡二姪",
      "content": [
        "千官奉职衮龙垂，旅卧淮阳鬓日衰。",
        "三月已乖棠树政，二年空负竹林期。",
        "楼侵白浪风来远，城抱丹岩日到迟。",
        "长欲挂帆君莫笑，越禽花晚梦南枝。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276340,
      "title": "病间寄郡中文士",
      "content": [
        "卢橘含花处处香，老人依旧卧清漳。",
        "心同客舍惊秋早，迹似僧斋厌夜长。",
        "风卷翠帘琴自响，露凝朱阁簟先凉。",
        "明朝欲醉文中彦，犹觉吟声带越乡。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276341,
      "title": "贺少师相公致政",
      "content": [
        "六十悬车自古稀，我公年少独忘机。",
        "门临二室留侯隐，櫂倚三川越相归。",
        "不拟优游同陆贾，已回清白遗胡威。",
        "龙城凤沼棠阴在，只恐归鸿更北飞。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276342,
      "title": "题崔处士山居",
      "content": [
        "坐穷今古掩书堂，二顷湖田一半荒。",
        "荆树有花兄弟乐，橘林无实子孙忙。",
        "龙归晓洞云犹湿，麝过春山草自香。",
        "向夜欲归心万里，故园松月更苍苍。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276343,
      "title": "疾后与郡中群公䜩李秀才",
      "content": [
        "强留佳客䜩王孙，岩上余花落酒樽。",
        "书院欲开虫网户，讼庭犹掩雀罗门。",
        "耳虚尽日疑琴癖，眼暗经秋觉镜昏。",
        "莫引刘安倚西槛，夜来红叶下江村。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276344,
      "title": "晨起白云楼寄龙兴江准上人兼呈窦秀才",
      "content": [
        "兹楼今是望乡台，乡信全稀晓鴈哀。",
        "山翠万重当槛出，水华千里抱城来。",
        "东岩月在僧初定，南浦花残客未回。",
        "欲吊灵均能赋否，秋风还有木兰开。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276345,
      "title": "醼饯李员外",
      "content": [
        "病守江城眼暂开，昔年吴越共衔杯。",
        "膺舟出镇虚陈榻，郑履还京下隗台。",
        "云叶渐低朱阁掩，浪花初起画樯回。",
        "心期解印同君醉，九曲池西望月来。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276346,
      "title": "詶钱汝州",
      "content": [
        "白雪多随汉水流，谩劳旌斾晚悠悠。",
        "笙歌暗写终年恨，台榭潜消尽日忧。",
        "鸟散落花人自醉，马嘶芳草客先愁。",
        "怪来雅韵清无敌，三十六峰当庾楼。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276347,
      "title": "将归姑苏南楼饯送李明府",
      "content": [
        "无处登临不系情，一凭春酒醉高城。",
        "暂移罗绮见山色，才驻管弦闻水声。",
        "花落西亭添别恨，柳阴南浦促归程。",
        "前期迢遰今宵短，更倚朱阑待月明。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276348,
      "title": "和浙西从事刘三复送僧南归",
      "content": [
        "楚客送僧归故乡，海门帆势极潇湘。",
        "碧云千里暮愁合，白雪一声春思长。",
        "满院草花平讲席，绕龛藤叶盖禅床。",
        "怜师不得随师去，已戴儒冠事素王。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276349,
      "title": "送上元王明府赴任",
      "content": [
        "莫言名重懒驱鸡，六代江山碧海西。",
        "日照蒹葭明楚塞，烟分杨柳见隋堤。",
        "荒城树暗沈书浦，旧宅花连罨画溪。",
        "官满定知归未得，九重霄汉有丹梯。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276350,
      "title": "送沈卓少府任江都",
      "content": [
        "炀帝都城春水边，笙歌夜上木兰船。",
        "三千宫女自涂地，十万人家如洞天。",
        "艳艳花枝官舍晚，重重云影寺墙连。",
        "少年作尉须兢慎，莫向楼前坠马鞭。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276351,
      "title": "酬邢杜二员外",
      "content": [
        "雪带东风洗画屏，客星悬处聚文星。",
        "未归嵩岭暮云碧，久别杜陵春草青。",
        "熊轼并驱因雀噪，隼旟齐驻是鸿冥。",
        "岂知京洛旧亲友，梦绕潺湲江上亭。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276352,
      "title": "经故丁补阙郊居",
      "content": [
        "死酧知己道终全，波暖孤冰且自坚。",
        "𫛳上承尘才一日，鹤归华表已千年。",
        "风吹药蔓迷樵径，雨暗芦花失钓船。",
        "四尺孤坟何处是，阖闾城外草连天。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276353,
      "title": "陪宣城大夫崔公泛后池兼北楼䜩二首 一",
      "content": [
        "陪泛芳池醉北楼，水花繁艳照膺舟。",
        "亭台阴合树初昼，弦管韵高山欲秋。",
        "皆贺虢岩终选傅，自伤燕谷未逢邹。",
        "昔时恩遇今能否，一尉沧洲已白头。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276354,
      "title": "陪宣城大夫崔公泛后池兼北楼䜩二首 二",
      "content": [
        "江上西来共鸟飞，翦荷浮泛似轻肥。",
        "王珣作簿公曾喜，刘表为邦客尽依。",
        "云外轩窗通早景，风前箫鼓送残晖。",
        "宛陵行乐金陵住，遥对家山未忆归。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276355,
      "title": "留别赵端公",
      "content": [
        "海门征櫂赴龙泷，暂寄华筵倒玉缸。",
        "箫鼓散时逢夜雨，绮罗分处下秋江。",
        "孤帆已过滕王阁，高榻留眠谢守窗。",
        "却愿烟波阻风雪，待君同拜碧油幢。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276356,
      "title": "寄阳陵处士",
      "content": [
        "旧隐青山紫桂阴，一书迢遰寄归心。",
        "谢公楼上晚花盛，杨子宅前春草深。",
        "吴岫雨来溪鸟浴，楚江云暗岭猨吟。",
        "野人宁忆沧洲畔，会待吹嘘定至音。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276357,
      "title": "与张道士同访李隐君不遇",
      "content": [
        "千岩万壑独携琴，知在陵阳不可寻。",
        "去辙已平秋草遍，空斋长掩暮云深。",
        "霜寒橡栗留山鼠，月冷菰蒲散水禽。",
        "唯有西邻张仲蔚，坐来同怆别离心。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276358,
      "title": "闻州中有䜩寄崔大夫兼简邢群评事",
      "content": [
        "箫管筵间列翠蛾，玉杯金液耀金波。",
        "池边雨过飘帷幕，海上风来动绮罗。",
        "颜子巷深青草遍，庾君楼迥碧山多。",
        "甘心不及同年友，卧听行云一曲歌。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276359,
      "title": "寄殷尧藩先辈",
      "content": [
        "十载功名翰墨林，为从知己信浮沈。",
        "青山有雪谙松性，碧落无云称鹤心。",
        "带月独归萧寺远，翫花频醉庾楼深。",
        "思君一见如琼树，空把新诗尽日吟。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276360,
      "title": "赠河东虞押衙二首 一",
      "content": [
        "长剑高歌换素衣，君恩未报不言归。",
        "旧精鸟篆谙书体，新授龙韬识战机。",
        "万里往来征马瘦，十年离别故人稀。",
        "生平志气何人见，空上西楼望落晖。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276361,
      "title": "赠河东虞押衙二首 二",
      "content": [
        "吴门风水各萍流，月满花开懒独游。",
        "万里山川分晓梦，四邻歌管送春愁。",
        "昔年顾我长青眼，今日逢君尽白头。",
        "莫向尊前更惆怅，古来投笔尽封侯。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276362,
      "title": "陵阳春日寄汝洛旧游",
      "content": [
        "百年身世似飘蓬，泽国移家叠嶂中。",
        "万里绿波鱼恋钓，九重青汉鹤愁笼。",
        "西池水冷春岩雪，南浦花香晓树风。",
        "纵倒芳尊心不醉，故人多在洛城东。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276363,
      "title": "酬杜补阙初春雨中舟次横江喜裴郎中相迎见寄",
      "content": [
        "江馆维舟为庾公，暖波微渌雨蒙蒙。",
        "红桥迤逦春岩下，朱斾联翩晓树中。",
        "柳滴圆波生细浪，梅含香艳吐轻风。",
        "郢歌莫问青山吏，鱼在深池鸟在笼。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276364,
      "title": "送张厚浙东谒丁常侍",
      "content": [
        "凉露清蝉柳陌空，故人遥指浙江东。",
        "青山有雪松当涧，碧落无云鹤出笼。",
        "齐唱离歌愁晚月，独看征棹怨秋风。",
        "定知洛下声名士，共说膺门得孔融。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276365,
      "title": "酬副使郑端公见寄",
      "content": [
        "一日高名遍九州，玄珠仍向道中求。",
        "郢中白雪慙新唱，涂上青山忆旧游。",
        "笙磬有文终易别，珠玑无价竟难酬。",
        "柳营迢遰江风阔，夜夜孤吟月下楼。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276366,
      "title": "酬绵州于中丞使君见寄",
      "content": [
        "故人书信越襃斜，新意虽多旧约赊。",
        "皆就一麾先去国，共谋三迳未还家。",
        "荆巫夜隔巴西月，鄢郢春连汉上花。",
        "半月离居犹怅望，可堪垂白各天涯。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276367,
      "title": "春早郡楼书事寄呈府中群公",
      "content": [
        "两鬓垂丝髪半霜，石城孤梦绕襄阳。",
        "鸳鸿幕里莲披槛，虎豹营中柳拂墙。",
        "画舸欲行春水急，翠帘初卷暮山长。",
        "岘亭风起花千片，流入南湖尽日香。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276368,
      "title": "元处士自洛归宛陵山居见示詹事相公饯行之什因赠",
      "content": [
        "紫霄峰下绝韦编，旧隐相如结韈前。",
        "月落尚留东合醉，风高还忆北窗眠。",
        "江城夜别潇潇雨，山槛晴归漠漠烟。",
        "一顷豆花三顷竹，想应抛却钓鱼船。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276369,
      "title": "送元昼上人归苏州兼寄张厚二首 一",
      "content": [
        "自卜闲居荆水头，感时相别思悠悠。",
        "一樽酒尽青山暮，千里书回碧树秋。",
        "深巷久贫知寂寞，小诗多病尚风流。",
        "昼公此去应相问，为说沾巾忆旧游。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276370,
      "title": "送元昼上人归苏州兼寄张厚二首 二",
      "content": [
        "三年无事客吴乡，南陌春园碧草长。",
        "共醉八门回画舸，独还三径掩书堂。",
        "前山雨过池塘满，小院秋归枕簟凉。",
        "经岁别离心自苦，何堪黄叶落清漳。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276371,
      "title": "送陆拾遗东归",
      "content": [
        "独振儒风遇盛时，紫泥初降世人知。",
        "文章报主非无意，书剑还家素有期。",
        "秋寺卧云移棹晚，暮江乘月落帆迟。",
        "东归自是缘清兴，莫比商山咏紫芝。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276372,
      "title": "湖南徐明府余之南邻久不还家因题林馆",
      "content": [
        "湘南官罢不归来，高阁经年掩绿苔。",
        "鱼溢池塘秋雨过，鸟还洲岛暮潮回。",
        "阶前石稳棋终局，窗外山寒酒满杯。",
        "借问先生独何处，一篱疎菊又花开。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276373,
      "title": "酬和杜侍御",
      "content": [
        "花时曾省杜陵游，闻下书帷不举头。",
        "因过石城先访戴，欲朝金阙暂依刘。",
        "征帆夜转鸬鹚穴，骋骑春辞鹳雀楼。",
        "正把新诗望南浦，棹歌应是木兰舟。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276374,
      "title": "酬河中杜侍御重寄",
      "content": [
        "五色如丝下碧空，片帆还遶楚王宫。",
        "文章已变南山雾，羽翼应抟北海风。",
        "春雪预呈霜简白，晓霞先染绣衣红。",
        "十千沽酒留君醉，莫道归心似转蓬。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276375,
      "title": "寄献三川守刘公 一",
      "content": [
        "三川歌颂彻咸秦，十二楼前侍从臣。",
        "休闭玉笼留鸑鷟，早开金埒纵麒麟。",
        "花深穉榻迎何客，月在膺舟醉几人。",
        "自笑东风过寒食，茂陵寥落未知春。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276376,
      "title": "寄献三川守刘公 二",
      "content": [
        "半年三度转蓬居，锦帐心阑羡隼旟。",
        "老去自惊秦塞鴈，病来先忆楚江鱼。",
        "长闻季氏千金诺，更望刘公一纸书。",
        "春雪未晴春酒贵，莫教愁杀马相如。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276377,
      "title": "送段觉之西蜀结婚",
      "content": [
        "词赋名高身不闲，彩衣如锦度函关。",
        "镜中鸾影胡威去，剑外花归卫玠还。",
        "秋浪远侵黄鹤岭，暮云遥断碧鸡山。",
        "时人若问西游客，心在重霄鬓欲斑。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276378,
      "title": "长庆寺遇常州阮秀才",
      "content": [
        "高阁晴轩对一峰，毗陵书客此相逢。",
        "晚收红叶题诗遍，秋待黄花酿酒浓。",
        "山馆日斜喧鸟雀，石潭波动戏鱼龙。",
        "上方有路应知处，疎磬寒蝉树几重。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276379,
      "title": "赠闲师",
      "content": [
        "近日高僧更有谁，宛陵山下遇闲师。",
        "东林共许三乘学，南国争传五字诗。",
        "初到庾楼红叶坠，夜投萧寺碧云随。",
        "秋江莫惜题佳句，正是磷磷见底时。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276380,
      "title": "东游留别李丛秀才",
      "content": [
        "烦君沽酒强登楼，罢唱离歌说远游。",
        "文字岂劳诸子重，风尘多幸故人忧。",
        "数程山路长侵夜，千里家书动隔秋。",
        "起凭栏干各垂泪，又驱羸马向东州。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276381,
      "title": "竹林寺别友人",
      "content": [
        "骚人吟罢起乡愁，暗觉年华似水流。",
        "花满谢城伤共别，蝉鸣萧寺喜同游。",
        "前山月落杉松晚，深夜风清枕簟秋。",
        "明日分襟又何处，江南江北路悠悠。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276382,
      "title": "送处士武君归章洪山居",
      "content": [
        "形影无群消息沈，登闻三击血沾襟。",
        "皇纲一日开冤气，青史千年重壮心。",
        "却望乌台春树老，独归蜗舍暮云深。",
        "他时纵有征书至，雪满空山不可寻。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276383,
      "title": "题义女亭",
      "content": [
        "身没兰闺道日明，郭南寻得旧池亭。",
        "诗人愁立暮山碧，贾客怨离秋草青。",
        "四望月沈疑掩镜，两簷花动认收屏。",
        "至今乡里风犹在，借问谁传义女铭。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276384,
      "title": "吴门送振武李从事",
      "content": [
        "晚促离筵醉玉缸，伊州一曲泪双双。",
        "欲携刀笔从新幕，更宿烟霞别旧窗。",
        "胡马近秋侵紫塞，吴帆乘月下清江。",
        "嫖姚若许传书檄，坐筑三城看受降。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276385,
      "title": "郊居春日有怀府中诸公幷柬王兵曹",
      "content": [
        "欲学渔翁钓艇新，濯缨犹惜九衢尘。",
        "花前更谢依刘客，雪后空怀访戴人。",
        "僧舍覆碁消白日，市楼赊酒过青春。",
        "一山桃杏同时发，谁似东风不厌贫。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276386,
      "title": "同韦少尹伤故卫尉李少卿",
      "content": [
        "客醉更长乐未穷，似知身世一宵空。",
        "香街宝马嘶残月，暖阁佳人哭晓风。",
        "未卷绣筵朱阁上，已开尘席画屏中。",
        "何须更赋山阳笛，寒月沈西水向东。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276387,
      "title": "舟行早发庐陵郡郭寄滕郎中",
      "content": [
        "楚客停桡太守知，露凝丹叶自秋悲。",
        "蟹螯只恐相如渴，鲈鲙应防曼倩饥。",
        "风卷曙云飘角远，雨昏寒浪挂帆迟。",
        "离心更羡高斋夕，巫峡花深醉玉巵。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276388,
      "title": "闻边将刘臯无辜受戮",
      "content": [
        "外监多假帝王尊，威胁偏裨势不存。",
        "才许誓心安玉垒，已伤传首动金门。",
        "三千客里宁无义，五百人中必有恩。",
        "却赖汉庭多烈士，至今犹自伏蒲轮。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276389,
      "title": "送薛秀才南游",
      "content": [
        "姑苏城外柳初凋，同上江楼更寂寥。",
        "遶壁旧诗尘漠漠，对窗寒竹雨潇潇。",
        "怜君别路随秋鴈，尽我离觞任晚潮。",
        "从此草玄应有处，白云青嶂一相招。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276390,
      "title": "夜归孤山寺却寄卢郎中",
      "content": [
        "青山有志路犹赊，心在琴书自忆家。",
        "醉别庾楼山色晓，夜归萧寺月光斜。",
        "落帆露湿回塘柳，别院风惊满地花。",
        "他日此身须报德，莫言空爱旧烟霞。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276391,
      "title": "赠桐庐房明府先辈",
      "content": [
        "帝城春榜谪灵仙，四海声华二十年。",
        "阙下书功无后辈，卷中文字掩前贤。",
        "官闲每喜江山静，道在宁忧雨露偏。",
        "自笑小儒非一鹗，亦趋门屏冀相怜。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276392,
      "title": "甘露寺感事贻同志",
      "content": [
        "云蔽长安路更赊，独随渔艇老天涯。",
        "青山尽日寻黄绢，沧海经年梦绛纱。",
        "雪愤有期心自壮，报恩无处髪先华。",
        "东堂旧侣勤书剑，同出膺门是一家。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276393,
      "title": "泛溪夜回寄道玄上人",
      "content": [
        "南郭烟光异世间，碧桃红杏水潺潺。",
        "猨来近岭猕猴散，鱼下深潭翡翠闲。",
        "犹阻晚风停桂檝，欲乘春月访松关。",
        "几回策杖终难去，洞口云归不见山。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276394,
      "title": "客至",
      "content": [
        "得路逢津更俊才，可怜鞍马照春来。",
        "残花几日小斋闭，大笑一声幽抱开。",
        "袖拂碧溪寒缭绕，冠欹红树晚徘徊。",
        "相逢少别更堪恨，何必秋风江上台。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276395,
      "title": "经李给事旧居",
      "content": [
        "归作儒翁出致君，故山谁复有遗文。",
        "汉庭使气摧张禹，楚国怀忧送范云。",
        "枫叶暗时迷旧宅，芳花落处认荒坟。",
        "朱弦一奏沈湘怨，风起寒波日欲曛。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276396,
      "title": "新兴道中",
      "content": [
        "芙蓉村步失官金，折狱无功不可寻。",
        "初挂海帆逢岁暮，却开山馆值春深。",
        "波浑未辨鱼龙迹，雾暗宁知蚌鹬心。",
        "夜榜归舟望渔火，一溪风雨两岩阴。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276397,
      "title": "下第有怀亲友",
      "content": [
        "万山晴雪九衢尘，何处风光寄梦频？",
        "花盛庾园携酒客，草深颜巷读书人。",
        "征帆又过湘南月，旅馆还悲渭水春。",
        "无限别情多病后，杜陵寥落在漳滨。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276398,
      "title": "中秋夕寄大梁刘尚书",
      "content": [
        "汴人迎拜洛人留，虎豹旌旗拥碧油。",
        "[刁]斗严更军耳目，戈鋋长控国咽喉。",
        "柳营出号风生纛，莲幕题诗月上楼。",
        "应念散郎千里外，去年今夜醉兰舟。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276399,
      "title": "卧病",
      "content": [
        "寒窗灯尽月斜晖，珮马朝天独掩扉。",
        "清露已凋秦塞柳，白云空长越山薇。",
        "病中送客难为别，梦里还家不当归。",
        "惟有寄书书未得，卧闻燕鴈向南飞。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276400,
      "title": "残雪",
      "content": [
        "忆昨新春霰雪飞，堦前簷上鬬寒姿。",
        "狂风送在竹深处，隔日未消花发时。",
        "轻压嫩蔬旁出土，冷冲幽鸟别寻枝。",
        "晚来又喜登楼见，一曲高歌和者谁。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276401,
      "title": "和常秀才寄简归州郑使君借猨",
      "content": [
        "谢守携猨东路长，褭藤穿竹似潇湘。",
        "碧山初鸣啸秋月，红树生寒啼晓霜。",
        "陌上楚人皆驻马，里中巴客半归乡。",
        "心知欲借南游侣，未到三声恐断肠。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276402,
      "title": "送人之任邛州",
      "content": [
        "绿发监州丹府归，还家乐事我先知。",
        "群童竹马交迎日，二老兰觞初见时。",
        "黄卷新书芸委积，青山旧路菊离披。",
        "亨衢自有横飞势，便到西垣视训辞。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276403,
      "title": "和河南杨少尹奉陪薛司空石笋诗",
      "content": [
        "暖溪寒井碧岩前，谢傅宾朋盛绮筵。",
        "云断石峰高竝笋，日临山势远开莲。",
        "闲留幢节低春水，醉拥笙歌出暮烟。",
        "闻道诗成归已夕，柳风花露月初圆。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    }
