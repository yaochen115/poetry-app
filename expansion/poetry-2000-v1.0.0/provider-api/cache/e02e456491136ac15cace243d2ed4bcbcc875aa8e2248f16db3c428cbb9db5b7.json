{
  "data": [
    {
      "id": 44792,
      "title": "壬午初秋赠写真陈生",
      "content": [
        "居士一丘壑，深衣折角巾。",
        "谁曾令子见，忽漫写吾真。",
        "更不游方外，于何顿若人。",
        "呼儿一笑看，下笔可能亲。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 44793,
      "title": "和萧判官东夫韵寄之",
      "content": [
        "湘江晓月照离裾，目送车尘至欲晡。",
        "归路新诗合千首，几时乘兴更三吾。",
        "眼边俗物只添睡，别后故人何似臞。",
        "尚策爬沙追历块，未甘直作水中凫。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 44794,
      "title": "木犀二绝句  其一",
      "content": [
        "只道秋花艳未强，此花尽更有商量。",
        "东风染得千红紫，曾有西风半点香。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 44795,
      "title": "木犀二绝句  其二",
      "content": [
        "轻薄西风未办霜，夜揉黄雪作秋光。",
        "吹残六出犹余四，匹似天花更著香。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 44796,
      "title": "考试湖南漕司南归值雨",
      "content": [
        "我亦知吾生有涯，长将病骨抵风沙。",
        "天寒短日仍为客，酒暖长亭未是家。",
        "又苦征夫催去去，更甘飞雨故斜斜。",
        "旧闻行路令人老，便恐霜毛一半加。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 44797,
      "title": "题湘中馆二首  其一",
      "content": [
        "清境故应好，新寒殊不胜。",
        "征衣愁著尽，凭槛喜犹能。",
        "乱眼船离岸，关心山见棱。",
        "个中有句在，下语更谁曾。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 44798,
      "title": "题湘中馆二首  其二",
      "content": [
        "江欲浮秋去，山能渡水来。",
        "娵隅蛮语杂，欵乃楚声哀。",
        "寒早当缘闰，诗成未费才。",
        "愁边正无奈，欢伯一相开。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 44799,
      "title": "送施少才赴试南宫二首  其一",
      "content": [
        "我岂登名晚，今仍作吏卑。",
        "文能追古作，子未要人知。",
        "取第真成漫，危言良独奇。",
        "新知谁不乐，所要白头期。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 44800,
      "title": "送施少才赴试南宫二首  其二",
      "content": [
        "十日九奔命，同行半倦游。",
        "出城愁不早，思子悔何由。",
        "脚底已衡岳，眼中犹橘洲。",
        "似嫌疎过子，吾过更谁尤。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 44801,
      "title": "野菊",
      "content": [
        "未与骚人当糗粮，况随流俗作重阳。",
        "政缘在野有幽色，肯为无人减妙香。",
        "已晚相逢半山碧，便忙也折一枝黄。",
        "花应冷笑东篱族，犹向陶翁觅宠光。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 44802,
      "title": "衡山值雨",
      "content": [
        "稍喜归涂中半程，犹愁泥潦未知晴。",
        "雨来也不怜行客，风过何须作许声。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 44803,
      "title": "至永州城外",
      "content": [
        "恋恋庭闱竟北征，槐花唤我试诸生。",
        "了知归近犹看堠，更有愁来即入城。",
        "愚水端能勤入梦，崳峰何得嬾相迎。",
        "只应白发持环久，见我跫然笑未成。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 44804,
      "title": "寄别何运判德献移闽宪二首  其一",
      "content": [
        "再岁三移节，千山一据鞍。",
        "梅花锦囊古，霜月绣衣寒。",
        "民欲刑几措，公于此岂难。",
        "谁令清庙器，未著侍臣冠。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 44805,
      "title": "寄别何运判德献移闽宪二首  其二",
      "content": [
        "薄技工奚取，知音一已多。",
        "从公日几许，去我意如何。",
        "梦里闽山月，吟边楚水波。",
        "门阑万珠履，更试岁寒柯。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 44806,
      "title": "视旱憩镜田店",
      "content": [
        "走檄堪频捧，严程敢少徐。",
        "虽晴恐非久，犹热未全无。",
        "憩息翻增倦，驰驱减壮图。",
        "诗成兼利害，失闷得清臞。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 44807,
      "title": "视旱过雨",
      "content": [
        "已旱何秋雨，无禾始水声。",
        "病民岂天意，致此定谁生。",
        "汤爪宁须翦，桑羊可缓烹。",
        "小儒空自叹，得到凤凰城。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 44808,
      "title": "水西野店皆不著宿夜抵石山虚",
      "content": [
        "不著官人宿，无如野店何。",
        "见容幸有此，虽陋更嫌它。",
        "头虱妨归梦，邻鸡伴寤歌。",
        "此生眠食尔，行路总蹉跎。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 44809,
      "title": "明发石山",
      "content": [
        "明发愁仍集，寒云又作屯。",
        "悬知今定雨，正坐夜来暄。",
        "便恐禾生耳，宁论客断魂。",
        "山深更须入，闻有早梅村。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 44810,
      "title": "涉小溪宿淡山",
      "content": [
        "径仄愁斜步，溪深怯正看。",
        "破船能不渡，晴色敢辞寒。",
        "白退山云细，青还玉宇宽。",
        "险艰明已济，魂梦未渠安。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 44811,
      "title": "题龙归寺壁",
      "content": [
        "题字才前岁，冲寒又此行。",
        "竹能知雨至，窗不隔江清。",
        "走檄还曾了，禁人未肯晴。",
        "息肩更须喜，问路可怜生。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 44812,
      "title": "董主簿正道壁间作水墨老梅一枝宿鹊缩脰合半眼栖焉",
      "content": [
        "斜枝饱风雪，疎花淡冰玉。",
        "一鹊忍清寒，居然伴幽独。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 44813,
      "title": "普明寺见梅",
      "content": [
        "城中忙失探梅期，初见僧窗一两枝。",
        "犹喜相看那恨晚，故应更好半开时。",
        "今冬不雪何关事，作伴孤芳却欠伊。",
        "月落山空正幽独，慰存无酒且新诗。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 44814,
      "title": "寄周子充察院二首  其一",
      "content": [
        "乡者豺当路，如今虎在山。",
        "百年诸老尽，一段好风还。",
        "谁谓永嘉末，人犹庆历间。",
        "班心公定可，更可押廷班。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 44815,
      "title": "寄周子充察院二首  其二",
      "content": [
        "迹远公犹记，情亲势使疎。",
        "忽思参研席，如许遽龙猪。",
        "云步知无那，文盟肯弃予。",
        "只哦五个字，不愈一行书。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 44816,
      "title": "自音声岩泛小舟下高溪",
      "content": [
        "晚日黄犹暖，寒江白更清。",
        "远山冲岸出，钓艇背人行。",
        "舟稳何妨小，波恬尔许平。",
        "大鱼不相报，拨剌得吾惊。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 44817,
      "title": "腊夜普明寺睡觉二首  其一",
      "content": [
        "旅梦忘为客，簷声忽唤愁。",
        "亲庭未差远，佛屋不胜秋。",
        "只么功名是，如今悟解不。",
        "十年行路饱，谁不遣吾休。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 44818,
      "title": "腊夜普明寺睡觉二首  其二",
      "content": [
        "作腊聊村酒，依人只短檠。",
        "略无更可数，听到雨无声。",
        "犬吠知何苦，鸡寒肯更鸣。",
        "生来眠不足，老去梦难成。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 44819,
      "title": "腊后二首  其一",
      "content": [
        "待腊惊还过，留年惜欲除。",
        "雨才三日有，雪更一冬无。",
        "游屐妨缘泞，寒威恋为炉。",
        "未须排旅闷，犹足助诗娱。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 44820,
      "title": "腊后二首  其二",
      "content": [
        "云暗虚疑暮，江空分外寒。",
        "如何山雨过，便尔岸沙干。",
        "奈此诗愁得，怀哉岁事阑。",
        "梅残吾更忍，不折一枝看。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 44821,
      "title": "夜坐",
      "content": [
        "欲雪天还惜，不风寒自生。",
        "灯摇无定影，火作始然声。",
        "又遣庭闱讯，悬知骨肉情。",
        "履端犹几日，有梦未归程。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 44822,
      "title": "东寺诗僧照上人访予于普明寺赠以诗",
      "content": [
        "故人深住白云隈，欲到何因只寄梅。",
        "岁晚观山吾独立，泥中骑马子能来。",
        "转头不觉三年别，病眼相看一笑开。",
        "说似少陵真句法，未应言下更空回。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 44823,
      "title": "题照上人迎翠轩二首  其一",
      "content": [
        "寺外秋山触眼明，寺根秋水洗心清。",
        "晴岚暖翠来未了，不用高人倒屣迎。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 44824,
      "title": "题照上人迎翠轩二首  其二",
      "content": [
        "参寥癞可去无还，谁踏诗僧最上关。",
        "欲具江西句中眼，犹须作礼问云山。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 44825,
      "title": "得亲老家问二首  其一",
      "content": [
        "节里难为客，家中数有书。",
        "慈亲问归否，意绪各何如。",
        "强酒那能尽，添愁不更除。",
        "旧来贫未仕，父子岂相疎。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 44826,
      "title": "得亲老家问二首  其二",
      "content": [
        "济世吾无策，迎亲仕屡惊。",
        "乾坤裂未补，簪笏达何荣。",
        "三径犹须禄，群飞不复情。",
        "山林早回首，诗酒且平生。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 44827,
      "title": "立春前一夕二首  其一",
      "content": [
        "春忽明朝是，冬将半夜非。",
        "年华只不住，客子未能归。",
        "微霰疎还密，寒簷滴又稀。",
        "撚须真浪苦，呵笔更成挥。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 44828,
      "title": "立春前一夕二首  其二",
      "content": [
        "腊尽春还好，朝暄暮复寒。",
        "雨晴终日异，衣著一冬难。",
        "生菜知无分，残梅不用看。",
        "本凭书遣睡，转更睡相干。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 44829,
      "title": "霰",
      "content": [
        "雪花遣霰作前锋，势颇张皇欲暗空。",
        "筛瓦巧寻疎处漏，跳阶误到暖边融。",
        "寒声带雨山难白，冷气侵人火失红。",
        "方讶一冬暄较甚，今宵敢叹卧如弓。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 44830,
      "title": "立春日有怀二首  其一",
      "content": [
        "飘蓬敢恨一年迟，客里春光也自宜。",
        "白玉青丝那得说，一杯咽下少陵诗。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 44831,
      "title": "立春日有怀二首  其二",
      "content": [
        "玉堂著句转春风，诸老从前亦寓忠。",
        "谁为君王供帖子，丁宁绮语不须工。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 44832,
      "title": "立春新晴",
      "content": [
        "宿云送腊晓仍开，日动江光度竹来。",
        "春到更晴谁不喜，时迁不道老相催。",
        "山村敢惜身犹远，边地应怜战未回。",
        "春鸟岂知人意绪，新声只欲劝衔杯。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 44833,
      "title": "晚立普明寺门时已过立春去除夕三日尔将归有叹",
      "content": [
        "萧萧淅淅荻花风，惨惨澹澹云物容。",
        "欲雪不雪关得侬，得归未归一莞中。",
        "年华纵留春已换，半生作客今何恨。",
        "夜来飞霰打僧窗，便恐雪真数尺强。",
        "催科不拙亦安出，吾民沥髓不濡骨。",
        "边头犀渠未晏眠，天不雨粟地流钱。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 44834,
      "title": "除夕前一日归舟夜泊曲涡市宿治平寺",
      "content": [
        "江宽风紧折绵寒，滩多岸少上水船。",
        "市何曾远船不近，意已先到灯明边。",
        "夜投古寺冲泥入，湿薪烧作虫声泣。",
        "冷窗冻笔更成眠，也胜疎篷仰见天。",
        "市人歌呼作时节，诗人两膝高于颊。",
        "还家儿女问何如，明日此怀犹忍说。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 44835,
      "title": "癸未上元后永州夜饮赵敦礼竹亭闻蛙醉吟",
      "content": [
        "茅亭夜集俯万竹，初月未光让高烛。",
        "主人酒令来无穷，恍然堕我醉乡中。",
        "草间蛙声忽三两，似笑吾人悭酒量。",
        "只作蛙听故自佳，何须更作鼓吹想。",
        "尚忆同登万石亭，倚栏垂手望寒青。",
        "只今真到寒青里，吾人不饮竹不喜。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 44836,
      "title": "过百家渡四绝句  其一",
      "content": [
        "出得城来事事幽，涉湘半济值渔舟。",
        "也知渔父趁鱼急，翻著春衫不裹头。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 44837,
      "title": "过百家渡四绝句  其二",
      "content": [
        "园花落尽路花开，白白红红各自媒。",
        "莫问早行奇绝处，四方八面野香来。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 44838,
      "title": "过百家渡四绝句  其三",
      "content": [
        "柳子祠前春已残，新晴特地却春寒。",
        "疎篱不与花为护，只为蛛丝作网竿。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 44839,
      "title": "过百家渡四绝句  其四",
      "content": [
        "一晴一雨路干湿，半淡半浓山叠重。",
        "远草平中见牛背，新秧疎处有人踪。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 44840,
      "title": "武冈李簿回多问萧判官东夫",
      "content": [
        "客有来从天一隅，相逢喜问子何如。",
        "橘洲各自分马首，湘水更曾烹鲤鱼。",
        "心近人遐长作恶，离多合少可无书。",
        "得知安稳犹差慰，敢道韦郎迹也疎。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 44841,
      "title": "迓新守值雨",
      "content": [
        "春雨不大又不晴，只与行人禁送迎。",
        "小溪绿涨竟何曾，官路黄泥滑不胜。",
        "今年送迎乃尔苦，去年送迎正如许。",
        "风严火灭未五更，暗行十里鸡三鸣。",
        "行路最难仍最恶，平生历尽今更觉。",
        "前人失脚后人笑，后人失脚那可料。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 44842,
      "title": "负丞零陵更尽而代者未至家君携老幼先归追送出城正值泥雨万感骤集",
      "content": [
        "吾父先归吾未可，吾母已行犹顾我。",
        "儿女喜归未解悲，我愁安得似儿痴。",
        "墙头人看不须羡，居者那知行者叹。",
        "昨日幸晴今又雨，天公管得行人苦。",
        "吾母病肺生怯寒，晚风鸣屋正无端。",
        "人家养子要作官，吾亲此行谁使然。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 44843,
      "title": "送别吕令圣与",
      "content": [
        "一门三相千子孙，后有公家前诸袁。",
        "有治国谱无县谱，种爱在堂铭在门。",
        "谁能不徼鬻爵恩，民乃不识田亩钱。",
        "姓名堕在诸公口，去去云霄稳著鞭。",
        "三年为寮无间然，公行何得搀吾先。",
        "取别当愁今更喜，定知同醉西湖莲。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 44844,
      "title": "和司法张仲良醉中论诗二首  其一",
      "content": [
        "醉语醒犹记，来诗读转新。",
        "不缘朋好密，其奈客居贫。",
        "无乃阳秋误，云何鼠朴珍。",
        "端令和者寡，敢以速为神。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 44845,
      "title": "和司法张仲良醉中论诗二首  其二",
      "content": [
        "相过宁嫌数，未行先畏辞。",
        "要宽千里别，犹费几篇诗。",
        "意得翻难售，声希只自奇。",
        "此生诗社里，三折或知医。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 44846,
      "title": "题唐德明秀才玉立斋",
      "content": [
        "坡云无竹令人俗，我云俗人正累竹。",
        "玉立斋前一万竿，能与主人相对寒。",
        "看竹哦诗笔生力，山童怪予遽忘食。",
        "不但不可一日无，斯须无此看何如。",
        "诗成欲写且复歇，恐竹嫌诗未清绝。",
        "丁宁一竿不可除，竹亦何曾减风月。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 44847,
      "title": "张仲良久约出郊以诗督之二首  其一",
      "content": [
        "百花亭下花如海，子厚宅前溪似油。",
        "幕下风流法曹掾，坐窗犹未作遨头。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 44848,
      "title": "张仲良久约出郊以诗督之二首  其二",
      "content": [
        "只道今春不肯晴，已晴谁遣不郊行。",
        "忍违花底提壶语，不虑屋头鸠妇鸣。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 44849,
      "title": "和仲良催看黄才叔秀才南园牡丹",
      "content": [
        "愁雨留花花已阑，作晴犹喜两朝寒。",
        "山城春事无多子，可缓黄园探牡丹。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 44850,
      "title": "谢唐德明惠笋",
      "content": [
        "高人爱笋如爱玉，忍口不餐要添竹。",
        "云何又遣十辈来，昏花两眼为渠开。",
        "贩夫束缚向市卖，外强中干美安在。",
        "锦纹犹带落花泥，不论烧煮两皆奇。",
        "猪肝累人真可怍，以笋累公端不恶。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 44851,
      "title": "别吴教授景衡",
      "content": [
        "道合从人笑，情亲觉别难。",
        "得朋何恨晚，到老几相看。",
        "世路今逾窄，吾徒却自宽。",
        "此心各相勉，不但道加餐。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 44852,
      "title": "谒张安国",
      "content": [
        "帝苑花秾记并游，万人回首看鼇头。",
        "也知旬月应颛面，已逼云霄又作州。",
        "别后闻公非故我，学林著脚到前修。",
        "登门犹说同年话，未觉红鸾映白鸥。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 44853,
      "title": "龚令国英约小集感冷暴下归卧感而赋焉二首  其一",
      "content": [
        "客里何烦病，春余不谓寒。",
        "并来无计奈，那得有怀宽。",
        "憎药犹须强，耽书更暇看。",
        "两亲问消息，敢道不平安。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 44854,
      "title": "龚令国英约小集感冷暴下归卧感而赋焉二首  其二",
      "content": [
        "吏卒稀仍散，僮奴野自亲。",
        "问吾适无恙，遽病此何因。",
        "初觉身为客，还疑老逼人。",
        "焚香发深省，一笑对残春。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 44855,
      "title": "仲良见和再和谢焉四首  其一",
      "content": [
        "未惜诗脾苦，端令鬼胆寒。",
        "吾才三鼓竭，君思九江宽。",
        "作者今犹古，灯前卷又看。",
        "不辞须撚断，只苦句难安。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 44856,
      "title": "仲良见和再和谢焉四首  其二",
      "content": [
        "谁谓陈三远，髯张下笔亲。",
        "夫何此意合，恐有宿生因。",
        "我岂慵开眼，年来寡见人。",
        "更烦雕好句，割取楚江春。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 44857,
      "title": "仲良见和再和谢焉四首  其三",
      "content": [
        "健论开仍阖，清规高更寒。",
        "抗章胡未报，忧世可能宽。",
        "收用今宁晚，飞鶱尚会看。",
        "自怜千虑短，所愿一枝安。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 44858,
      "title": "仲良见和再和谢焉四首  其四",
      "content": [
        "岂不为寮久，兹焉独愈亲。",
        "卜居如不近，同志竟何因。",
        "山鸟频招饮，江花解笑人。",
        "风颠仍雨急，枉却一年春。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 44859,
      "title": "晚寒",
      "content": [
        "莫道今晨热，东风未得欺。",
        "晚来作恶甚，寒似禁烟时。",
        "约雨斜还整，吹花合且离。",
        "不应如许峭，故故恼吾衰。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 44860,
      "title": "和仲良病中耽睡",
      "content": [
        "居士何曾病，群儿错见怜。",
        "对床正风雨，落纸忽云烟。",
        "欲夏花全退，犹寒柳尚眠。",
        "如何睡乡里，只是著诗仙。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 44861,
      "title": "和仲良春晚即事五首  其一",
      "content": [
        "几许春才好，谁令绿遽深。",
        "风光曾著眼，时序只惊心。",
        "永日便甘寝，羁怀怯苦吟。",
        "春归犹作客，晴少更多阴。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 44862,
      "title": "和仲良春晚即事五首  其二",
      "content": [
        "春在已愁热，夏来还解凉。",
        "一年又如许，万事更须忙。",
        "情薄忘花减，心危愿岁穰。",
        "平生只坐嬾，何药疗嵇康。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 44863,
      "title": "和仲良春晚即事五首  其三",
      "content": [
        "欲与东风说，休吹堕絮飞。",
        "吾行正无定，魂梦岂忘归。",
        "花暖能醺眼，山浓欲染衣。",
        "只嫌春已老，此景也应稀。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 44864,
      "title": "和仲良春晚即事五首  其四",
      "content": [
        "贫难聘欢伯，病敢跨连钱。",
        "梦岂花边到，春俄雨里迁。",
        "一犁关五秉，百箔候三眠。",
        "只有书生拙，穷年垦纸田。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 44865,
      "title": "和仲良春晚即事五首  其五",
      "content": [
        "笋改斋前路，蔬眠雨后畦。",
        "晴江明处动，远树看来齐。",
        "我语真雕朽，君诗妙斲泥。",
        "殷勤报春去，恰恰一鶑啼。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 44866,
      "title": "题潘彦政叔姪濯缨斋",
      "content": [
        "愚溪之口湘江左，茅斋不小亦不大。",
        "斋前看江江只流，江中望斋斋更幽。",
        "两潘读书韵清壮，湘妃出听鱼吹浪。",
        "大潘皎如鹤出林，小潘不减在沙金。",
        "向来姓名到天府，市人莫笑渠尘土。",
        "濯缨当属最闲人，两潘且弹冠上尘。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 44867,
      "title": "和仲良分送柚花沉三首  其一",
      "content": [
        "薰然真腊水沉片，烝以洞庭春雪花。",
        "只得掾曹作南董，国香未向俗人夸。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 44868,
      "title": "和仲良分送柚花沉三首  其二",
      "content": [
        "锯沉百叠糁琼英，一日三薰更九烝。",
        "却悔香成太清绝，龙涎生妬木犀憎。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 44869,
      "title": "和仲良分送柚花沉三首  其三",
      "content": [
        "鹤骨龙筋金玉相，诗人十袭几年藏。",
        "已惊好手夺天巧，更遣余芬恼楚狂。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 44870,
      "title": "再病书怀呈仲良四首  其一",
      "content": [
        "病身谁伴亦谁怜，赢得昏昏几觉眠。",
        "睡起不知身是病，踞床看尽水沉烟。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 44871,
      "title": "再病书怀呈仲良四首  其二",
      "content": [
        "病中嫌雨又嫌晴，自是情怀未苦平。",
        "两日雨多端不恶，市声洗尽只簷声。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 44872,
      "title": "再病书怀呈仲良四首  其三",
      "content": [
        "功名销尽向来心，诗酒从今也不禁。",
        "夜雨遣人归思动，不知湘水几篙深。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 44873,
      "title": "再病书怀呈仲良四首  其四",
      "content": [
        "方外诗豪张仲良，义风今日更谁双。",
        "绝怜病客无半眼，粥饭随宜到小窗。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 44874,
      "title": "赠蜀中相士范思齐往全州见万先之教授",
      "content": [
        "两脚那解上金銮，两手只合把钓竿。",
        "比身管乐儿时态，已翻九河洗我肝。",
        "范生来自浣花里，眼中之人定谁贵。",
        "百炼未必贤绕指，贵人正要老于事。",
        "斜风细雨又春休，落花啼鸟总春愁。",
        "试问谈间立封侯，何如百钱挂杖头。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 44875,
      "title": "和唐德明问病二首  其一",
      "content": [
        "罢却微官且客居，庭闱不近信全疎。",
        "更无竹下子唐子，谁与过逢说异书。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 44876,
      "title": "和唐德明问病二首  其二",
      "content": [
        "俟命循天更不疑，朶颐那可换灵龟。",
        "逍遥岂在榆枋外，问著扶摇总不知。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 44877,
      "title": "又和梅雨",
      "content": [
        "管得天公雨更晴，何关客子病心情。",
        "得归此意良不恶，且住微躯也自轻。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 44878,
      "title": "又和见喜病间",
      "content": [
        "初病杨花犹乱飞，即今梅子已黄稀。",
        "卧惊节物遽如许，起得沉緜更解肥。",
        "云寺耶溪招布袜，斜风细雨欠蓑衣。",
        "半生不结修门梦，只梦家山唤早归。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 44879,
      "title": "罢丞零陵忽病伤寒谒医两旬如负担者日远日重改谒唐医公亮九日而无病矣谢以长句",
      "content": [
        "料病如料敌，用药如中的。",
        "淮阴百战有百胜，由基百发无一失。",
        "老唐脉法明更高，阅人二竖可得逃。",
        "探囊起死无德色，掉臂不为曳裾客。",
        "但使乡邻少卧疴，眼底名医麻竹多。",
        "嗟予诗瘦仍多病，两旬进尺退不寸。",
        "逢君已晚亦未恨，扫除何曾费余刃。",
        "长句借手聊尔耳，真成不直一杯水。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 44880,
      "title": "题黄才叔看山亭",
      "content": [
        "春山华润秋山瘦，雨山点黯晴山秀。",
        "湖湘山色天下稀，零陵乃复白其眉。",
        "作亭不为俗人好，个竹把茅吾事了。",
        "朝来看山佳有余，为渠更尽一编书。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 44881,
      "title": "送张倅",
      "content": [
        "山西劲气何曾歇，秦汉迄今几奇杰。",
        "张公长身须鬓苍，斜飞不入鹓鹭行。",
        "狂卒叫讙民震扰，不劳谈笑斯须了。",
        "皇上方披舆地图，烦公赤手系单于。",
        "捕逐虎豹公则老，坐运筹策公尚少。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 44882,
      "title": "题所寓唐德明书斋",
      "content": [
        "凫鹜行中脱病身，竹林深处得幽人。",
        "只言官满浑无事，也被诗愁搅一春。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 44883,
      "title": "白含笑",
      "content": [
        "薰风晓破碧莲莟，花意犹低白玉颜。",
        "一粲不曾容易发，清香何自遍人间。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 44884,
      "title": "题唐德明建一斋",
      "content": [
        "城南前江后山趾，竹斋正对寒江启。",
        "不嫌渔火乱书灯，只苦橹声惊睡美。",
        "平生刺头钻故纸，晚知此道无多子。",
        "从渠散漫汗牛书，笑倚江枫弄江水。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 44885,
      "title": "夜离零陵以避同僚追送之劳留二绝简诸友  其一",
      "content": [
        "已坐诗臞病更羸，诸公刚欲饯湘湄。",
        "夜浮一叶逃盟去，已被沙鸥圣得知。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 44886,
      "title": "夜离零陵以避同僚追送之劳留二绝简诸友  其二",
      "content": [
        "思归日日只空言，一棹今真水月间。",
        "半夜犹闻郡楼鼓，明朝应失永州山。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 44887,
      "title": "泊冷水浦",
      "content": [
        "前夕放船湘口步，约到衡州来日午。",
        "五程一减作三程，谢渠江涨半篙清。",
        "今日雨来三四五，又闭疎篷听暮雨。",
        "长年商量泊船所，雨外青山更青处。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 44888,
      "title": "憩连岭店",
      "content": [
        "此馆初明眼，前山正接眉。",
        "热嫌连日甚，凉惜两朝迟。",
        "雨竹何其重，风鸥不自持。",
        "庭闱犹百里，早已豁愁思。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
