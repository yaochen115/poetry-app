  "data": [
    {
      "id": 6789,
      "title": "颂古三十一首  其二八",
      "content": [
        "北斗藏身句，商量几万般。",
        "贪观天上月，谁觉骨毛寒。"
      ],
      "author": {
        "id": 5535,
        "name": "释如本"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 11489,
      "title": "偈十首  其八",
      "content": [
        "定林只履，天台楖𣗖。",
        "𨱄斧住山，横担镔铁。",
        "独有云床老胡僧，徒见夜中天上月。",
        "目前无极分外心，少室花容是妙诀。"
      ],
      "author": {
        "id": 13367,
        "name": "释慧晖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 12517,
      "title": "天上月",
      "content": [
        "皎皎天上月，随人如有情。",
        "何当背银烛，弃我如绝缨。"
      ],
      "author": {
        "id": 1108,
        "name": "曹勋"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 14817,
      "title": "白头吟一首",
      "content": [
        "浮云高映天上月，月华未落云已灭。",
        "浊水长羡清路尘，浊水尚流尘已绝。",
        "人心不如云与尘，变态无穷旋消歇。",
        "我家火齐堆金盘，朱楼锁烟青冥端。",
        "昨忆闻琴才等闲，夜奔临邛相与还。",
        "凤皇曲成保懽乐，骕骦裘典无艰难。",
        "当炉涤器两憔悴，几度暗啼愁远山。",
        "君侪狗监动人主，君乘驷马跨故园。",
        "檄书呵讥蜀父老，未足洒耻徒小恩。",
        "颜色何尝不如旧，自是心存憎爱间。",
        "我方失意天地窄，君视浮云江海宽。",
        "一身情易复情难，百年有来终有去。",
        "凄凄嫁娶不须啼，出门万里沦中路。",
        "我怜秀色茂陵女，既有新人须有故。",
        "请把阿娇作近喻，到底君王不重顾。",
        "若知此事为当然，千金莫换长门赋。"
      ],
      "author": {
        "id": 11454,
        "name": "王铚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 23394,
      "title": "查漕元章生日",
      "content": [
        "气压群阴首占阳，生贤时节自非常。",
        "十分天上月轮满，一线人间日影长。",
        "揽辔威名崖雪凛，和羹消息岭梅香。",
        "要知三峡无穷水，便是词源与寿觞。"
      ],
      "author": {
        "id": 9239,
        "name": "王十朋"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 26871,
      "title": "金刚随机无尽颂 不受不贪分第二十八 其六",
      "content": [
        "平湖范蠡舡，空恨万波前。",
        "不观天上月，徒捞水间天。"
      ],
      "author": {
        "id": 5166,
        "name": "释印肃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 29057,
      "title": "偈颂六十五首  其一二",
      "content": [
        "天上月圆，人间月半。",
        "槌鼓升堂，理旧公案。",
        "车不横推，理无曲断。"
      ],
      "author": {
        "id": 18,
        "name": "释咸杰"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 53790,
      "title": "寿母生朝四首  其三",
      "content": [
        "良辰好景占年年，画烛浓香醉玉船。",
        "天上月圆三夜后，人间春到万花边。"
      ],
      "author": {
        "id": 5174,
        "name": "项安世"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 56875,
      "title": "天上月",
      "content": [
        "春冰一片净无瑕，万里清光遍海涯。",
        "欲与常娥移桂树，月中先合种梅花。"
      ],
      "author": {
        "id": 2970,
        "name": "刘翰"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 62724,
      "title": "酴醿雨后  其二",
      "content": [
        "玩世无心子，成功不义侯。",
        "升沈三跃浪，聚散一浮沤。",
        "守郡官槐木，王家梦髑髅。",
        "团团天上月，犹自曲如钩。"
      ],
      "author": {
        "id": 10056,
        "name": "薛季宣"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 64669,
      "title": "偈颂四十二首  其四二",
      "content": [
        "天上月圆，人间月半。",
        "子细看来，从头错算。",
        "姮娥昨夜失金针，撼动玉楼寻不见。"
      ],
      "author": {
        "id": 1105,
        "name": "释祖先"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 82987,
      "title": "谒苏州守",
      "content": [
        "十年狂荡客征途，时为文章未剖符。",
        "引臂欲攀天上月，回身却碍日中乌。",
        "穷愁自是真男子，慷慨须投大丈夫。",
        "闻道使鱼鳌海阔，特将香饵钓姑苏。"
      ],
      "author": {
        "id": 4984,
        "name": "刘过"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 95381,
      "title": "偈颂九十三首  其九○",
      "content": [
        "今朝正月半，万物尽更新。",
        "衲僧无一物，何物当慇懃。",
        "银烛高𪸩天上月，灯花开遍洞中春。"
      ],
      "author": {
        "id": 12808,
        "name": "释梵琮"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 96695,
      "title": "感秋",
      "content": [
        "西风忽起江枫末，偏喜萧萧弄华发。",
        "世间何物最坚牢，惟有古来天上月。"
      ],
      "author": {
        "id": 6082,
        "name": "陈宓"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 102162,
      "title": "偈颂一百四十一首  其九六",
      "content": [
        "人皆竞赏中秋，惟有山僧不管。",
        "大都天上月圆，只是寻常月半。"
      ],
      "author": {
        "id": 9047,
        "name": "释师范"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 108067,
      "title": "湖月赠朱几仲",
      "content": [
        "天上月，三五盈兮三五缺。",
        "湖中月，无缺无圆无生灭。",
        "天上月，虾蟇妖精敢作孽。",
        "湖中月，能使痴蟇踪影没。",
        "岂是蟾兔不如龙，不知龙有何秘诀。",
        "甓社湖中看明月，湖中天上双皎洁。",
        "湛卢令我书大字，老来百事懒且拙。",
        "惟有作字气如虹，写罢森森清彻骨。",
        "神龙见之应骧首，共伴寒光千古揭。",
        "夜夜明月照我字，我字照湖两相埒。",
        "更得湛卢著佳句，便与盂城成三绝。"
      ],
      "author": {
        "id": 6848,
        "name": "袁甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 108357,
      "title": "偈颂二十五首  其三",
      "content": [
        "人间灯，天上月。",
        "有明有暗，有圆有缺，底事贪观心未歇。",
        "兴圣室内无油，免得证龟作鼈。"
      ],
      "author": {
        "id": 12378,
        "name": "释智愚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 121104,
      "title": "呈万庵十章 温养",
      "content": [
        "金翁姹女结亲姻，洞口桃花日日春。",
        "拾得一轮天上月，炼成万劫屋中珍。",
        "黄婆即是母之母，赤子乃其身外身。",
        "龙汉元年消息断，威音前面更何人。"
      ],
      "author": {
        "id": 8874,
        "name": "白玉蟾"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 129823,
      "title": "嘉熙戊戌季春一日画溪吟客王子信为亚愚诗禅上人作渔父词七首  其六",
      "content": [
        "白发髼松不记年，扁舟泊在荻花边。",
        "天上月，水中天，夜夜烟波得意眠。"
      ],
      "author": {
        "id": 2415,
        "name": "王谌"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 130388,
      "title": "日本云上人请赞",
      "content": [
        "山头云，天上月。",
        "云月有殊，光影无别。",
        "此是吾端的，不许见，不许闻。",
        "大唐国有人，必能辨，必能别。",
        "不妨卷去挂向大溪头，教他几个横论竖论东说西说。"
      ],
      "author": {
        "id": 12313,
        "name": "释妙伦"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 130994,
      "title": "偈颂一百三十六首  其五五",
      "content": [
        "人间月半，天上月圆。",
        "幸自一天明朗，何须万斛金莲。",
        "诸人睡眼豁开见得分晓，不起于座即超于然灯之前。",
        "其或未然，灯节元来是上元。"
      ],
      "author": {
        "id": 1085,
        "name": "释惟一"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 133159,
      "title": "偈颂七十六首  其八",
      "content": [
        "天上月圆，人间月半。",
        "明眼衲僧，见似不见。",
        "盏子扑落地，楪子成七片。"
      ],
      "author": {
        "id": 12630,
        "name": "释子益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 137214,
      "title": "渔父词七首  其六",
      "content": [
        "白发髼松不记年，扁舟泊在荻花边。",
        "天上月，水中天，夜夜烟波得意眠。"
      ],
      "author": {
        "id": 11095,
        "name": "薛嵎"
      },
      "dynasty": {
