{
  "data": [
    {
      "id": 159593,
      "title": "写愤四首  其二",
      "content": [
        "未能归赵璧，我不厌干戈。",
        "万古青天在，三年白骨多。",
        "春风仍岁月，世界自山河。",
        "宁忍委国难，飞身入薜萝。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 159594,
      "title": "写愤四首  其三",
      "content": [
        "北虏昔深入，东瓯亦未曾。",
        "江山能几战，风雨废诸陵。",
        "云尽喜天出，宵残愿日升。",
        "苍苍今悔祸，谶应两中兴。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 159595,
      "title": "写愤四首  其四",
      "content": [
        "不信夜不晓，哀哀锁暗颦。",
        "铁城蹲败土，锦国涨腥尘。",
        "草泣荒宫雨，花羞哨地春。",
        "少焉开霁色，四望一时新。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 159596,
      "title": "赠僧",
      "content": [
        "澹然无所著，暂走世间尘。",
        "罗汉来东土，将军现后身。",
        "语香清净法，心苦乱离春。",
        "曾得拈花意，纵横变化新。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 159597,
      "title": "独钓",
      "content": [
        "高兴一丝在，清风万古长。",
        "不为周吕望，愿似汉严光。",
        "天下皆秋雨，山中自夕阳。",
        "后来有孺子，终久辨沧浪。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 159598,
      "title": "书前后臣子盟檄后",
      "content": [
        "死亦乌可已，丹心阐大猷。",
        "恭承父母教，用剪国家仇。",
        "日破四洲夜，天开六幕秋。",
        "终当见行事，不与世同流。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 159599,
      "title": "墨兰",
      "content": [
        "钟得至清气，精神欲照人。",
        "抱香怀古意，恋国忆前身。",
        "空色微开晓，晴光淡弄春。",
        "凄凉如怨望，今日有遗民。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 159600,
      "title": "晓晴",
      "content": [
        "雨晨辉朗霁，一碧湛无垠。",
        "草木新容净，林峦远意分。",
        "海生东出日，天散北飞云。",
        "却喜风犹竞，微凉透夏薰。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 159601,
      "title": "晚晴",
      "content": [
        "落照开空霁，明霞映水鲜。",
        "干文悬造化，土脉润山川。",
        "白满重圆月，青还不翳天。",
        "定钟声更彻，通昔喜无眠。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 159602,
      "title": "此心",
      "content": [
        "此心期不变，曾洒血为盟。",
        "举世无人识，终年独自行。",
        "海中擎日出，天外唤风生。",
        "净尽去云雾，重开白昼明。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 159603,
      "title": "即事八首  其一",
      "content": [
        "举头云苍莽，何以喻吾怀。",
        "白眼世无偶，青天路可阶。",
        "湘兰终恋楚，吴橘不逾淮。",
        "龙卧未雷雨，池塘空沸蛙。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 159604,
      "title": "即事八首  其二",
      "content": [
        "栖迟破屋下，书史自徜徉。",
        "道不嫌清苦，人皆笑独狂。",
        "晚花亏雨露，老树惯风霜。",
        "莫望阖门北，愁云天外长。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 159605,
      "title": "即事八首  其三",
      "content": [
        "一说乾坤事，无愁鬓亦斑。",
        "心飞空阔外，身堕乱离间。",
        "日落经何国，归云识故山。",
        "凭谁扣冥漠，天道几时还。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 159606,
      "title": "即事八首  其四",
      "content": [
        "徉狂全性命，守死混樵渔。",
        "道否怀才老，心高涉世疏。",
        "掌中筹地理，灯下论兵书。",
        "愧我非诸葛，何人顾草庐。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 159607,
      "title": "即事八首  其五",
      "content": [
        "山川不可望，荒草苦何深。",
        "故国英雄泪，终身父母心。",
        "清池函莹玉，落日堕圆金。",
        "休问愁多少，芳年雪上簪。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 159608,
      "title": "即事八首  其六",
      "content": [
        "薰风吹不透，热恼苦无涯。",
        "时异生深恨，云飞动壮怀。",
        "醉谈天下事，清坐月中阶。",
        "此意有谁解，儿童自听蛙。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 159609,
      "title": "即事八首  其七",
      "content": [
        "大地尽戎马，皇皇奚所之。",
        "此身犹梦里，无处问天涯。",
        "鸟影惊飞弹，蝉声避过旗。",
        "愿言仍旧贯，生死太平时。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 159610,
      "title": "即事八首  其八",
      "content": [
        "独闭衡门坐，无言意极长。",
        "赤心怀赵日，绿鬓染吴霜。",
        "火正当阳地，风来自午方。",
        "连宵验天象，心宿炳明堂。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 159611,
      "title": "宿半塘寺",
      "content": [
        "一襟清气足，此夜岂人寰。",
        "醉影松杉下，吟身风露间。",
        "秋悬当殿月，云宿近城山。",
        "明发骑鲸去，飘然不可攀。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 159612,
      "title": "对雨有怀",
      "content": [
        "世道忽翻覆，愁来痛彻心。",
        "腥风行杀气，淫雨哭秋阴。",
        "虏睨朝廷玺，官空帑藏金。",
        "妃嫔今草地，宫髻泪中簪。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 159613,
      "title": "次韵",
      "content": [
        "冥迷江树外，一鸟破云还。",
        "雨雪乾坤变，干戈笔砚闲。",
        "命于时不偶，心与道相关。",
        "终见二三月，花边展笑颜。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 159614,
      "title": "自挽",
      "content": [
        "堂堂男子不封侯，与命为仇死未休。",
        "陷虏有歌春梦断，哭天无地夜魂愁。",
        "九清风露极玄处，万古虚空自在游。",
        "痛恨莫能生报国，从今阴隲溥南州。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 159615,
      "title": "一旦",
      "content": [
        "一旦蒙尘朔漠行，杜鹃哭破旧冤声。",
        "金杯暂饮胡瓶酒，玉铉谁调御鼎羹。",
        "故国夜长天正晦，离宫春尽草初生。",
        "小臣有誓曾铭骨，不到神州不太平。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 159616,
      "title": "偶成二首  其一",
      "content": [
        "剑气荧荧夜属天，忍观禾黍废苍烟。",
        "梦中亦问朝廷事，诗后唯书德祐年。",
        "花柳有愁春正苦，江山无主月空圆。",
        "如今好弃毛锥子，望北长驱马一鞭。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 159617,
      "title": "偶成二首  其二",
      "content": [
        "曾受家传究典坟，自期不与俗人群。",
        "君臣位乱纲常在，父母恩深生死分。",
        "霁日行空镕积雪，长风吹晓净残云。",
        "坐令世上春光好，长使桃花笑脸醺。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 159618,
      "title": "答",
      "content": [
        "语声带咽吐新诗，彻骨啣冤痛不知。",
        "报国心惟忧汉贼，读书人肯学胡儿。",
        "剑携入手霜三尺，镜挂当胸月一规。",
        "终久难磨天理在，匪伊谈笑定时危。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 159619,
      "title": "雁足",
      "content": [
        "雁足冥冥未报归，此心裂碎有谁知。",
        "一怀愤闷心啣苦，两鬓䰐𩭹发倒垂。",
        "醉后爱歌诸葛表，生来耻读李陵诗。",
        "喜吾筋力犹强健，愿为朝廷理乱丝。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 159620,
      "title": "次韵三首  其一",
      "content": [
        "百岁光阴十过三，故山路梗梦中还。",
        "看来身在终为累，悟得心空始是闲。",
        "几度踏云归草屋，有时卧雨掩松关。",
        "人间转盼皆陈迹，何必长生久驻颜。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 159621,
      "title": "次韵三首  其二",
      "content": [
        "活计烟波羡谢三，醉眠钓艇去仍还。",
        "为怜死者今何在，笑杀忙人不识闲。",
        "烛影欲残登夜榻，鼓声未绝启晨关。",
        "匆匆役役尘中走，一见青山一动颜。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 159622,
      "title": "次韵三首  其三",
      "content": [
        "花前欢笑忆春三，何故东君尚未还。",
        "一寸心中千种事，百年世上几时闲。",
        "虏迁玉帛犹归市，马犯金汤即弃关。",
        "生怕朔风吹下雪，飞来点鬓妬红颜。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 159623,
      "title": "古时",
      "content": [
        "古时明月碧霄间，曾照鸾舆幸蜀还。",
        "御座乍空三殿远，朝仪暂歇六更闲。",
        "马屯腥雾彤墀坏，鶑哭冤春玉户关。",
        "苦是年年归旧燕，绕簷偷语问龙颜。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 159624,
      "title": "补梦中所作",
      "content": [
        "鸿雁流离梦亦惊，满怀凄怨足秋声。",
        "此身不死胡儿手，留与君王取太平。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159625,
      "title": "闻陷虏宫女所问",
      "content": [
        "尘污宫装粉不香，死生魂梦只昭阳。",
        "一逢人自南来者，垂泪殷勤问二王。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159626,
      "title": "题陶渊明集后",
      "content": [
        "拂袖归来未是迟，传家何用五男儿。",
        "不堪生在义熙后，眼见朝廷被篡时。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159627,
      "title": "秋雨",
      "content": [
        "云满长空雨满山，凄凄风色变新寒。",
        "夜来白帝将秋去，万树淋漓哭不干。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159628,
      "title": "逢故人",
      "content": [
        "晓路云埋拨未开，霜风空老栋梁材。",
        "平生不识悲秋事，今日白头何处来。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159629,
      "title": "秋成",
      "content": [
        "秋成田里自人烟，刁斗声中又一年。",
        "王莽货泉成底事，东都仍用五铢钱。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159630,
      "title": "北望",
      "content": [
        "紫塞风高直北秋，黄河水自向东流。",
        "穆王御马还宫日，海内封疆只属周。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159631,
      "title": "南望",
      "content": [
        "南阳遥望见舂陵，残雪初消霁日升。",
        "鬰鬰葱葱有佳气，汉家天子必中兴。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159632,
      "title": "匈奴",
      "content": [
        "匈奴残破汉封疆，江北江南尽战场。",
        "若问生灵谁是主，如今天子又康王。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159633,
      "title": "绝句十首  其一",
      "content": [
        "羊裘独钓浙江湄，百姓哀哀苦乱离。",
        "但得汉家鸿业在，莫愁光武奋身迟。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159634,
      "title": "绝句十首  其二",
      "content": [
        "目断秋江欲暮时，天边落叶弄愁飞。",
        "翠华幸北平安信，只愿新鸿带得归。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159635,
      "title": "绝句十首  其三",
      "content": [
        "玉辇愁经草地腥，酸风频卷马头尘。",
        "我朝三百年忠厚，不信山河属别人。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159636,
      "title": "绝句十首  其四",
      "content": [
        "阊门城外水涵空，雁影凄凉落照中。",
        "一望秋风数千里，不知何处是行宫。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159637,
      "title": "绝句十首  其五",
      "content": [
        "草木恩深雨露余，公卿环列汉庭居。",
        "一朝投阁千年笑，却是杨雄不读书。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159638,
      "title": "绝句十首  其六",
      "content": [
        "一叶飞秋万树寒，行吟憔悴倚栏干。",
        "渊明只忆晋朝事，满眼黄花泪不干。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159639,
      "title": "绝句十首  其七",
      "content": [
        "银汉斜倾玉漏残，钗虫熠熠照清寒。",
        "最怜今夜下弦月，一半娑婆树不完。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159640,
      "title": "绝句十首  其八",
      "content": [
        "騣笠毡靴搭护衣，金牌骏马走如飞。",
        "十三门里秋光冷，谁梦朝天喝道归。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159641,
      "title": "绝句十首  其九",
      "content": [
        "西风满路奈愁何，昏鼓声中厌北歌。",
        "菱藕市空灯火断，一城秋怨月明多。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159642,
      "title": "绝句十首  其一○",
      "content": [
        "子夜神游碧落间，群仙飞语下人寰。",
        "上天深念苍生苦，特敕三宫圣驾还。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159643,
      "title": "五忠咏 制置李公",
      "content": [
        "举家自杀尽忠臣，面仰青天哭断声。",
        "听得北人歌里唱，潭州城是铁州城。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159644,
      "title": "五忠咏 丞相李公",
      "content": [
        "大驾迢迢已北行，淮南犹守九州城。",
        "只谋渡海南归国，不意忘躯博得名。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159645,
      "title": "五忠咏 察使姜公",
      "content": [
        "杀气盘空白昼阴，始终不变似精金。",
        "直疑碧落三更月，来作将军一片心。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159646,
      "title": "五忠咏 都统王公",
      "content": [
        "健儿三百陷胡尘，匹马孤腾勇过人。",
        "至死执刀唯骂贼，自言不作两朝臣。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159647,
      "title": "五忠咏 随驾内嫔某氏",
      "content": [
        "玉殿辞春陷马尘，忍将膻秽污贞身。",
        "能行男子难行事，羞杀朝中投阁人。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159648,
      "title": "寄同庚友",
      "content": [
        "淳祐初年同下生，已经三十七番春。",
        "此身虽堕胡尘里，只是三朝天子臣。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159649,
      "title": "即事",
      "content": [
        "旅琐曾听月下猿，至今触事即愁端。",
        "北风昨夜无情甚，又作冬来一信寒。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159650,
      "title": "小春花",
      "content": [
        "天地无情正北风，飞鸿哀咽乱云中。",
        "此时纵使开千树，不及东皇一点红。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159651,
      "title": "对菊四首  其一",
      "content": [
        "天风吹古秋，独立殿寒馥。",
        "我父昔爱之，终身不忘菊。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 159652,
      "title": "对菊四首  其二",
      "content": [
        "受命太极前，立身晚秋后。",
        "一朝扬清香，名动天下口。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 159653,
      "title": "对菊四首  其三",
      "content": [
        "日月虽云逝，山中秋自香。",
        "平生抱正色，谁怕夜来霜。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 159654,
      "title": "对菊四首  其四",
      "content": [
        "三迳今非昔，多愁老此身。",
        "谁知陶靖节，只是晋朝人。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 159655,
      "title": "陷虏歌",
      "content": [
        "德祐初年腊月二，逆臣叛我苏城地。",
        "城外荡荡为丘墟，积骸飘血弥田里。",
        "城中生灵气如蛰，与贼为徒廿六日。",
        "蚩蚩横目无所知，低面卖笑如相识。",
        "彼儒衣冠谁家子，靡然相从亦如此。",
        "不知平日读何书，失节抱虎反矜喜。",
        "有粟可食不下咽，有头可断容我言。",
        "不忍我家与国同休三百十六年，阅历凡几世，忠孝已相传。",
        "足大宋地，首大宋天。",
        "身大宋衣，口大宋田。",
        "今弃我三十五岁父母玉成之身，一旦为氓受虏廛。",
        "我忆我父教我者，日夜滴血哭成颠。",
        "我有老母病老病，相依为命生余生。",
        "欲死不得为孝子，欲生不得为忠臣。",
        "痛哉擗胸叫大宋，青青在上宁无闻。",
        "自古帝王行仁政，唯有我朝天子圣。",
        "老天高眼不昏花，盍拯下土苍生命。",
        "忍令此贼恣杀气，颠倒上下乱纲纪。",
        "厥今帝怒行天刑，一怒天下净如洗。",
        "要荒仍归禹疆土，四海草木霑新雨。",
        "应容隠者入深密，岁收芋栗供母食。",
        "对人有口不肯开，面仰虚空双眼白。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 159656,
      "title": "狂歌",
      "content": [
        "一笑识破天地根，随意变化易其名。",
        "俯御三十六天顶，主宰一气生群生。",
        "倏歘有怒行号令，亿兆雷鼓轰天声。",
        "敕噀龙口数滴水，净洗世界泠然清。",
        "推出火帝照寰宇，万万万世长光明。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 159657,
      "title": "黄河清",
      "content": [
        "丁丑戊寅岁，黄河两度清。",
        "但教大宋在，即是圣人生。",
        "亘古理不泯，中天日转明。",
        "这番戡定后，世世永休兵。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 159658,
      "title": "自题大义集后",
      "content": [
        "长夜漫漫发浩歌，生民涂炭果如何。",
        "中兴车马修攘在，变雅君臣废缺多。",
        "赤帜开明新日月，青毡恢拓旧山河。",
        "誓崇忠义诛奸逆，田海虽迁志不磨。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 159659,
      "title": "郊行即事四首  其一",
      "content": [
        "一变太平业，民生若失巢。",
        "乏牛耕瘠土，多马坏荒郊。",
        "花圃半栽菜，谷田今长茅。",
        "幡然欲深隠，远与世相抛。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 159660,
      "title": "郊行即事四首  其二",
      "content": [
        "五年前事别，一说泪滂沱。",
        "帝业虽迁鼎，人心未倒戈。",
        "日光疑白昼，天影愧清波。",
        "背立官塘路，风前慷慨歌。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 159661,
      "title": "郊行即事四首  其三",
      "content": [
        "痴立若忘归，欲言还又讷。",
        "时危恐戄多，国破繁华歇。",
        "黄叶辱吴山，绿芜欺魏阙。",
        "两峰流水声，偷哭汉宫月。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 159662,
      "title": "郊行即事四首  其四",
      "content": [
        "云禁江城昼色阴，可怜寂寞读书身。",
        "风霜虐命四五载，雨露润民三百春。",
        "雁落愁声唯送泪，马驰怨迹岂成尘。",
        "如今不独桐江上，新著羊裘又一人。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 159663,
      "title": "观颜鲁公帖",
      "content": [
        "吾拜鲁公帖，凛然气如生。",
        "终身大唐臣，千载名峥嵘。",
        "愧彼今之人，兽心蠹天经。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 159664,
      "title": "苦怀六首  其一",
      "content": [
        "我行荒野间，风埃苦浩浩。",
        "嗟汝后生者，惟恐不见老。",
        "世事如霜木，颜色尽枯槁。",
        "愁来不即死，反为命所恼。",
        "今人真小儿，语话尚痴倒。",
        "不辨亲与仇，得食即为好。",
        "焉知父母心，茹痛伤怀抱。",
        "难报三春晖，满地皆芳草。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 159665,
      "title": "苦怀六首  其二",
      "content": [
        "滔滔流波澜，百川俱颓靡。",
        "竞羡吕望贵，独欠伯夷死。",
        "小恩尚思报，大义反忘耻。",
        "国家三百年，果何负于尔。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 159666,
      "title": "苦怀六首  其三",
      "content": [
        "南山一何高，支脉远不断。",
        "巉岩峰峦间，松柏苍翠满。",
        "面阳地力盛，万物发新暖。",
        "我欲飞至之，惜哉羽翮短。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 159667,
      "title": "苦怀六首  其四",
      "content": [
        "昔为天上云，今作地下尘。",
        "踠足屡哭懊，痛惜六尺身。",
        "父母生我时，教我为贤人。",
        "生得男儿骨，一死亦精神。",
        "畴谓迫中年，堕影浊水滨。",
        "跼蹐走残命，语飒气不伸。",
        "固知复继剥，霜雪天地仁。",
        "愿得一脉暖，散为天下春。",
        "援手水火间，以道拯斯民。",
        "俾知尊卑位，万世不湮沦。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 159668,
      "title": "苦怀六首  其五",
      "content": [
        "我命而为人，形异禽兽生。",
        "所以异者何，不越纲常行。",
        "斯道如日光，千古同一明。",
        "胡为舍白昼，摘埴涂冥盲。",
        "伯夷圣人远，双瞳空晶晶。",
        "悲风吹语断，天阔青山横。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 159669,
      "title": "苦怀六首  其六",
      "content": [
        "古人立志高，为义不为己。",
        "今人所见卑，独为贫贱耻。",
        "不义富贵生，宁以饿而死。",
        "遗体非不重，所惧悖于理。",
        "我禀清淑气，生而秀为士。",
        "读书三十年，颇知六经旨。",
        "质之以人道，所言皆如此。",
        "奚乃滞风尘，尔汝弄欢喜。",
        "浙山高苍苍，浙水清弥弥。",
        "三叹动遐思，清风响两耳。",
        "暂焉深隠去，长镵访园绮。",
        "敬俟时之清，终其天伦尔。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 159670,
      "title": "己卯十一月朔又梦食梅花梦中作",
      "content": [
        "雁宇高高兔国斜，湿花飞露沁流霞。",
        "狂来清兴不可遏，吃尽寒梅一树花。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159671,
      "title": "遣兴二首  其一",
      "content": [
        "独笑或独哭，从人唤作颠。",
        "生惟嗜食菜，贫亦耻言钱。",
        "清兴游空外，孤愁抱日边。",
        "所忧无别念，雁又犯南天。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 159672,
      "title": "遣兴二首  其二",
      "content": [
        "传家曾受易，所得亦良深。",
        "今古岂二道，死生惟一心。",
        "颠风掀旷野，痴雪厄寒林。",
        "不改隠居操，扃门自鼓琴。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 159673,
      "title": "送僧游西湖归永嘉",
      "content": [
        "大地疮痍痛正新，南归不避雪纷纷。",
        "柳边人忆一湖锦，松下僧闲九里云。",
        "熟路有缘家易到，空经无字世难闻。",
        "菖蒲涧水濯双足，雁荡山巅曝夕曛。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 159674,
      "title": "结交二首  其一",
      "content": [
        "凤鸮同为禽，麟虎同为兽。",
        "以彼善恶殊，致令分去取。",
        "恶者伪以善，惑世不可究。",
        "唯在行事间，以理观于久。",
        "或不近人情，避之如避臭。",
        "君子重结交，芳名垂宇宙。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 159675,
      "title": "结交二首  其二",
      "content": [
        "伐木义不古，伪敬溢颜面。",
        "交接无真情，面是背乃变。",
        "疏则易为恩，密则将成怨。",
        "当学晏平仲，终始保相见。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 159676,
      "title": "隠居谣",
      "content": [
        "布衣暖，菜羹香，诗书滋味长。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 159677,
      "title": "醉乡十二首  其一",
      "content": [
        "破得愁城了，仍还太古风。",
        "浑然无事国，不与世相通。",
        "地迈华胥外，天归混沌中。",
        "蠢哉蛮触氏，苦死角英雄。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 159678,
      "title": "醉乡十二首  其二",
      "content": [
        "狂药蜕凡骨，疑来别一州。",
        "形骸闲若弃，风壤旷无忧。",
        "屡有圣人至，难同恶客游。",
        "所交惟陆谞，落魄老菟裘。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 159679,
      "title": "醉乡十二首  其三",
      "content": [
        "盎然非世境，乐意渺无垠。",
        "暖骨通仙处，寒冬能幻春。",
        "眼空天亦小，心净月逾新。",
        "昔者李太白，于兹竟瘗身。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 159680,
      "title": "醉乡十二首  其四",
      "content": [
        "太和国土里，风味极清柔。",
        "意外竟忘世，胸中不梦秋。",
        "日蒸春气涌，地漾水光流。",
        "此即神仙窟，何须更十洲。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 159681,
      "title": "醉乡十二首  其五",
      "content": [
        "独到至乐处，于于自在行。",
        "身心全去碍，骨肉若通明。",
        "劫外冥天地，空中一死生。",
        "却观凡世界，眇尔幻沤轻。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 159682,
      "title": "醉乡十二首  其六",
      "content": [
        "谁居此域作生涯，偏许刘伶毕卓家。",
        "屋影空空天渺漭，烛光闪闪地横斜。",
        "春红软玉颓衣树，秋碧流波漾缬花。",
        "接壤或通三岛路，任他苦海事如麻。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 159683,
      "title": "醉乡十二首  其七",
      "content": [
        "万里和风眼底回，陶陶乐土隔飞埃。",
        "暖浮花思春初透，红涨霞纹潮正来。",
        "长驻童颜驱老去，不教玄鬓受愁催。",
        "举头阊阖手能摸，更欲乘风过九垓。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 159684,
      "title": "醉乡十二首  其八",
      "content": [
        "风物清妍地不尘，一天无尽四时春。",
        "此中正属忘怀境，来者多应避世人。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159685,
      "title": "醉乡十二首  其九",
      "content": [
        "红潮初上玉船空，假道青州一水通。",
        "相去尘寰千万里，不愁日夜不春风。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159686,
      "title": "醉乡十二首  其一○",
      "content": [
        "大哉春宇，温厚凝聚。",
        "靡有沍寒，暖于吹煦。",
        "厥俗孔洽，恬无憎妬。",
        "高阳之徒，历年熟路。",
        "惟楚屈平，欲来莫赴。",
        "我至是邦，妙莫能喻。",
        "至和滋形，神与天遇。",
        "载朗笑咏，金玉韶頀。",
        "至清之气，嘘呵风露。",
        "喜若悟道，默契玄趣。",
        "陋彼市朝，喧隘弗寤。",
        "愿我遐年，克寿厥寓。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 159687,
      "title": "醉乡十二首  其一一",
      "content": [
        "天道何冥冥，委形辟空杳。",
        "旷劫土坦平，冲气蔼云杪。",
        "不入禹封疆，拓地八荒表。",
        "空洞无边涯，一切境界小。",
        "骨柔春香浓，目绀夜光瞭。",
        "洪荒上古前，命不为愁剿。",
        "卑哉苍生愚，役心颜貌愀。",
        "窗猴狂摇摇，野马走扰扰。",
        "髓竭冲融膏，渴命竟枯夭。",
        "奚不来此邦，软坐廓幽眇。",
        "刳刷膏肓俗，涤濯肺腑皎。",
        "骋驾无可游，一生事足了。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 159688,
      "title": "醉乡十二首  其一二",
      "content": [
        "穷冬骄寒冻地裂，北望朔方常下雪。",
        "五台积古雪不消，鸟兽毛氄结冻血。",
        "江南昔有酒如渑，蔗浆麟脯相凭陵。",
        "朝廷有道四海清，既醉凫鹥歌太平。",
        "九土夜市彻天明，楼红陌紫喧箫笙。",
        "豪气一饮一千钟，唤得国里春风生。",
        "千金少年百花眼，左右捧拥上天行。",
        "战鼓声多瓦欲飞，从此百姓无宁时。",
        "龙遭鳝舞鼠变虎，恣意反复弄风雨。",
        "如今寂寞不救饱，髑髅眼睛生秋草。",
        "空欲拍弄百斛船，莫羡酿来曝背眠。",
        "何如我入壶中游，喝云开破天外天。",
        "翠锦帏幕车渠土，八面雪白净无烟。",
        "水王双阙琼膏填，使得五行颠倒颠。",
        "坎离媾春中央宫，俯现摩醯王王仙。",
        "手执乾坤万化柄，斟酌混沌壳中髓。",
        "咽得半掬碧色云，夙根无明百杂碎。",
        "万绿俱空恬无为，四股馥郁红玻瓈。",
        "自然氤氲太和身，融融泄泄先天春。",
        "形化为气轻于雾，飞御慈盼福下土。",
        "金相朵朵鲜绿云，花甃彩衢跨空住。",
        "八十一天开玉殿，天天互透长生路。",
        "憨涌醴泉雨甘露，孕牛产麟鳏蛟舞。",
        "九苞凤凰对舞鸣，钧天清戛云璈音。",
        "敕取龙猛大士药，尽点大地变黄金。",
        "嫦娥搦弄团圆雪，抛向下界悬作月。",
        "银光倒泼白泠明，笑吻霏雾飘香冰。",
        "戏掷火丸煎海干，珊瑚万树红斑斑。",
        "抱出懒雨活龙帝，拔髯痒鼻激喷嚏。",
        "鼻气环空挂白虹，垂脚东贯大荒东。",
        "八八翠衫蓬莱儿，舞撒宝花双逶迤。",
        "千丈白眉老神翁，前导万从开天倪。",
        "径出盘古顶外行，劫风浩浩空掀轰。",
        "呵暖为春吸为冬，浊世甲子刹那中。",
        "数数老松化石了，篯铿小厮半刻夭。",
        "我之大醉八万四千岁，小醉三千六百日。",
        "世上几回汉与唐，苦于争战悲獝狘。",
        "万国黔首行饭囊，鬼貌蓝色心茫荒。",
        "狭步蹩躠膻埃里，蜉蝣拜天祈寿长。",
        "气浊謦欬不清响，啾啁碎声群争攘。",
        "生来不识快活国，纷华外胜夺心王。",
        "昼夜火烧菩提树，背井索水吃且僵。",
        "哨地荒年苦命活，籧篨戚施疮痍伤。",
        "贫者逼迫富者狂，一漥血气六贼戕。",
        "眼望天上金银落，垒琼架屋铁筑墙。",
        "莫知仁义为何物，冷笑诗书今不香。",
        "沉酗私欲反为醒，嫌说青山白云人。",
        "群昏鼾齁摇不觉，强语以道必生嗔。",
        "忽笑大笑休休休，回视若辈愁如仇。",
        "挥手长揖永相谢，千劫万劫逍遥游。"
      ],
