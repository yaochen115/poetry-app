{
  "data": [
    {
      "id": 334480,
      "title": "相和歌辞：日出行",
      "content": [
        "白日下昆仑，发光如舒丝。",
        "徒照葵藿心，不照游子悲。",
        "折折黄河曲，日从中央转。",
        "旸谷耳曾闻，若木眼不见。",
        "奈何铄石，胡为销人。",
        "羿弯弓属矢那不中，"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 334508,
      "title": "相和歌辞：蜀国弦",
      "content": [
        "枫香晚华静，锦水南山影。",
        "惊石坠猿哀，竹云愁半岭。",
        "凉月生秋浦，玉沙鳞鳞光。",
        "谁家红泪客，不忍过瞿塘。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 334534,
      "title": "相和歌辞：铜雀妓",
      "content": [
        "佳人一壶酒，秋容满千里。",
        "石马卧新烟，忧来何所似。",
        "歌声且潜弄，陵树风自起。",
        "长裾压高台，泪眼看花机。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 334543,
      "title": "相和歌辞：长歌续短歌",
      "content": [
        "长歌破衣襟，短歌断白发。",
        "秦王不可见，旦夕成内热。",
        "渴饮壶中酒，饥拔陇头粟。",
        "凄凄四月兰，千里一时绿。",
        "夜峰何离离，月明落石底。",
        "裴回沿石寻，照出高峰外。",
        "不得与之游，歌成鬓先改。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 334548,
      "title": "相和歌辞：猛虎行",
      "content": [
        "长戈莫舂，强弩莫烹。",
        "乳孙哺子，教得生狞。",
        "举头为城，掉尾为旌。",
        "东海黄公，愁见夜行。",
        "道逢驺虞，牛哀不平。",
        "生何用尺刀，壁上雷鸣。",
        "泰山之下，妇人哭声。",
        "官家有程，吏不敢听。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 334591,
      "title": "相和歌辞：难忘曲",
      "content": [
        "夹道开洞门，弱杨低画戟。",
        "帘影竹叶起，箫声吹日色。",
        "蜂语绕妆镜，拂蛾学春碧。",
        "乱系丁香梢，满阑花向夕。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 334592,
      "title": "相和歌辞：塘上行",
      "content": [
        "藕花凉露湿，花缺藕根涩。",
        "飞下雌鸳鸯，塘水声溢溢。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 334611,
      "title": "相和歌辞：安乐宫",
      "content": [
        "深井桐乌起，尚复牵清水。",
        "未盥邵陵王，瓶中弄长翠。",
        "新城安乐宫，宫如凤凰翅。",
        "歌回蜡版鸣，大绾提壶使。",
        "绿繁悲水曲，茱萸别秋子。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 334617,
      "title": "相和歌辞：雁门太守行",
      "content": [
        "黑云压城城欲摧，甲光向月金鳞开。",
        "角声满天秋色里，",
        "报君黄金台上意，提携玉龙为君死。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 334725,
      "title": "相和歌辞：神弦曲",
      "content": [
        "西山日没东山昏，旋风吹马马踏云。",
        "画弦素管声浅繁，",
        "古壁彩虬金帖尾，雨工骑入秋潭水。",
        "百年老鸮成木魅，"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 334726,
      "title": "相和歌辞：神弦别曲",
      "content": [
        "巫山小女隔云别，松花春风山上发。",
        "绿盖独穿香径归，",
        "南山桂树为君死，云衫残污红脂花。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 334745,
      "title": "相和歌辞：莫愁曲",
      "content": [
        "草生陇阪下，鸦噪城堞头。",
        "何人此城里，城角栽石榴。",
        "青丝系五马，黄金络双牛。",
        "白鱼驾莲船，夜作十里游。",
        "归来无人识，暗上沉香楼。",
        "罗床倚瑶瑟，残月倾帘钩。",
        "今日槿花落，明朝梧树秋。",
        "若负平生意，何名作莫愁。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 334758,
      "title": "相和歌辞：大堤曲",
      "content": [
        "妾家住横塘，红纱满桂香。",
        "青云教绾头上髻，",
        "郎食鲤鱼尾，妾食猩猩唇。",
        "莫指襄阳道，绿浦归帆少。",
        "今日菖蒲花，明朝枫树老。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 334765,
      "title": "相和歌辞：江南弄",
      "content": [
        "江中绿雾起凉波，天上叠𪩘红嵯峨。",
        "水风浦云生老竹，",
        "吴歈越吟未终曲，江上团团帖寒玉。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 334791,
      "title": "相和歌辞：上云乐",
      "content": [
        "飞香走红满天春，花龙盘盘上紫云。",
        "三千宫女列金屋，",
        "断烟素，缝舞衣，八月一日君前舞。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 334800,
      "title": "舞曲歌辞：章和二年中",
      "content": [
        "云萧索，风拂拂，麦芒如篲黍和粟。",
        "关中父老百领襦，",
        "殷勤为我下田鉏，百钱携赏丝桐客。",
        "游春漫光坞花白，"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 334801,
      "title": "舞曲歌辞：公莫舞歌",
      "content": [
        "方花古础排九楹，刺豹淋血盛银罂。",
        "华筵鼓吹无桐竹，",
        "腰下三看宝玦光，项庄掉箾拦前起。",
        "材官小臣公莫舞，",
        "铁枢铁楗重束关，大旗五丈撞双环。",
        "汉王今日须秦印，"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 334802,
      "title": "舞曲歌辞：拂舞辞",
      "content": [
        "吴娥声绝天，空云闲裴回。",
        "门外满车马，亦须生绿苔。",
        "尊有乌程酒，劝君千万寿。",
        "全胜汉武锦楼上，",
        "丹成作蛇乘白雾，千年重化玉井龟。",
        "从蛇作龟二千载。",
        "吴堤绿草年年在。",
        "背有八卦称神仙，邪鳞顽甲滑腥涎。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 334819,
      "title": "琴曲歌辞：湘妃",
      "content": [
        "筠竹千年老不死，长伴秦娥盖湘水。",
        "蛮娘吟弄满寒空，",
        "幽愁秋气上青枫，凉夜波间吟古龙。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 334847,
      "title": "琴曲歌辞：走马引",
      "content": [
        "我有辞乡剑，玉锋堪截云。",
        "襄阳走马客，意气自生春。",
        "朝嫌剑光静，暮嫌剑花冷。",
        "能持剑向人，不解持照身。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 334856,
      "title": "琴曲歌辞：蔡氏五弄：渌水辞",
      "content": [
        "今宵好风月，阿侯在何处。",
        "为有倾城色，翻成足愁苦。",
        "东湖采莲叶，南湖拔蒲根。",
        "未持寄小姑，且持感愁魂。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 334917,
      "title": "杂曲歌辞：神仙曲",
      "content": [
        "碧峰海面藏灵书，上帝拣作神仙居。",
        "晴时笑语闻空虚，",
        "鹤羽冲风过海迟，不如却使青龙去。",
        "犹疑王母不相许，"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 334937,
      "title": "杂曲歌辞：少年乐",
      "content": [
        "芳草落花如锦地，二十长游醉乡里。",
        "红缨不重白马骄，",
        "陆郎倚醉牵罗袂，夺得宝钗金翡翠。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 334977,
      "title": "杂曲歌辞：浩歌",
      "content": [
        "南风吹山作平地，帝遣天吴移海水。",
        "王母桃花千遍红，",
        "筝人劝我金屈卮，神血未凝身问谁。",
        "不须浪饮丁督护，",
        "漏催水咽玉蟾蜍，卫娘发薄不胜梳。",
        "看见秋眉换深绿，"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 335138,
      "title": "杂曲歌辞：摩多楼子",
      "content": [
        "玉塞去金人，二万四千里。",
        "风吹沙作云，一时渡辽水。",
        "天白水如练，甲丝双串断。",
        "行行莫苦辛，城月犹残半。",
        "晓气朔烟上，趢趗胡马蹄。",
        "行人听水别，隔陇长东西。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 335313,
      "title": "杂曲歌辞：十二月乐辞：正月",
      "content": [
        "上楼迎春新春归，暗黄著柳宫漏迟。",
        "薄薄淡霭弄野姿，",
        "官街柳带不堪折，早晚菖蒲胜绾结。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 335314,
      "title": "杂曲歌辞：十二月乐辞：二月",
      "content": [
        "二月饮酒采桑津，宜男草生兰笑人。",
        "蒲如交剑风如熏，"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 335315,
      "title": "杂曲歌辞：十二月乐辞：三月",
      "content": [
        "东方风来满眼春，花城柳暗愁几人。",
        "复宫深殿竹风起，",
        "军装宫妓扫蛾浅，摇摇锦旗夹城暖。",
        "曲水飘香去不归，"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 335316,
      "title": "杂曲歌辞：十二月乐辞：四月",
      "content": [
        "晓凉暮凉树如盖，千山浓绿生云外。",
        "依微香雨青氛氲，"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 335317,
      "title": "杂曲歌辞：十二月乐辞：五月",
      "content": [
        "雕玉押帘上，轻縠笼虚门。",
        "井汲铅华水，扇织鸳鸯文。",
        "回雪舞凉殿，甘露洗空绿。",
        "罗袖从徊翔，香汗沾宝粟。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 335318,
      "title": "杂曲歌辞：十二月乐辞：六月",
      "content": [
        "裁生罗，伐湘竹，帔拂疏霜簟秋玉。",
        "炎炎红镜东方开，"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 335319,
      "title": "杂曲歌辞：十二月乐辞：七月",
      "content": [
        "星依云渚冷，露滴盘中圆。",
        "好花生木末，衰蕙愁空园。",
        "夜天如玉砌，池叶极青钱。",
        "仅厌舞衫薄，稍知花簟寒。",
        "晓风何拂拂，北斗光阑干。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 335320,
      "title": "杂曲歌辞：十二月乐辞：八月",
      "content": [
        "孀妾怨长夜，独客梦归家。",
        "傍簷虫缉丝，向壁灯垂花。",
        "簷外月光吐，帘中树影斜。",
        "悠悠飞露姿，点缀池中荷。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 335321,
      "title": "杂曲歌辞：十二月乐辞：九月",
      "content": [
        "离宫散萤天似水，竹黄池冷芙蓉死。",
        "月缀金铺光脉脉，",
        "鸡人罢唱晓珑璁，鸦啼金井下疏桐。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 335322,
      "title": "杂曲歌辞：十二月乐辞：十月",
      "content": [
        "玉壶银箭稍难倾，釭花夜笑凝幽明。",
        "碎霜斜舞上罗幕，"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 335323,
      "title": "杂曲歌辞：十二月乐辞：十一月",
      "content": [
        "宫城团回凛严光，白天碎碎堕琼芳。",
        "挝钟高饮千日酒，"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 335324,
      "title": "杂曲歌辞：十二月乐辞：十二月",
      "content": [
        "日脚淡光红洒洒，薄霜不销桂枝下。",
        "依稀和气解冬严，已就长日辞长夜。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 335325,
      "title": "杂曲歌辞：十二月乐辞：闰月",
      "content": [
        "帝重光，年重时，七十二候回环推。",
        "天官玉管灰剩飞，"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 335345,
      "title": "杂歌谣辞：李夫人歌",
      "content": [
        "紫皇宫殿重重开，夫人飞入琼瑶台。",
        "绿香绣帐何时歇，",
        "红璧阑珊悬佩当，歌台小妓遥相望。",
        "玉蟾滴水鸡人唱，"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 335354,
      "title": "杂歌谣辞：苏小小歌",
      "content": [
        "幽兰露，如啼眼。",
        "无物结同心，烟花不堪翦。",
        "草如茵，",
        "冷翠烛，劳光彩。",
        "西陵下，风吹雨。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 335368,
      "title": "杂歌谣辞：邺城童子谣",
      "content": [
        "邺城中，暮尘起。",
        "将黑丸，斫文吏。",
        "棘为鞭，虎为马。",
        "团团走，邺城下。",
        "切玉剑，射日弓。",
        "献何人，奉相公。",
        "扶毂来，关右儿。",
        "香扫途，相公归。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351677,
      "title": "李凭箜篌引",
      "content": [
        "吴丝蜀桐张高秋，空白凝云颓不流。",
        "江娥啼竹素女愁，",
        "十二门前融冷光，二十三丝动紫皇。",
        "女娲炼石补天处，",
        "吴质不眠倚桂树，露脚斜飞湿寒兔。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 351678,
      "title": "残丝曲",
      "content": [
        "垂杨叶老莺哺儿，残丝欲断黄蜂归。",
        "绿鬓年少金钗客，",
        "榆荚相催不知数，沈郎青钱夹城路。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351680,
      "title": "出城寄权璩、杨敬之",
      "content": [
        "草暖云昏万里春，宫花拂面送行人。",
        "自言汉剑当飞去，何事还车载病身。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 351682,
      "title": "竹",
      "content": [
        "入水文光动，抽空绿影春。",
        "露华生笋径，苔色拂霜根。",
        "织可承香汗，裁堪钓锦鳞。",
        "三梁曾入用，一节奉王孙。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 351683,
      "title": "同沈驸马赋得御沟水",
      "content": [
        "入苑白泱泱，宫人正靥黄。",
        "绕堤龙骨冷，拂岸鸭头香。",
        "别馆惊残梦，停杯泛小觞。",
        "幸因流浪处，暂得见何郎。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 351684,
      "title": "始为奉礼忆昌谷山居",
      "content": [
        "扫断马蹄痕，衙回自闭门。",
        "长枪江米熟，小树枣花春。",
        "向壁悬如意，当帘阅角巾。",
        "犬书曾去洛，鹤病悔游秦。",
        "土甑封茶叶，山杯锁竹根。",
        "不知船上月，谁棹满溪云。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351686,
      "title": "过华清宫",
      "content": [
        "春月夜啼鸦，宫帘隔御花。",
        "云生朱络暗，石断紫钱斜。",
        "玉碗盛残露，银灯点旧纱。",
        "蜀王无近信，泉上有芹芽。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 351687,
      "title": "送沈亚之歌",
      "content": [
        "吴兴才人怨春风，桃花满陌千里红。",
        "紫丝竹断骢马小，",
        "雄光宝矿献春卿，烟底蓦波乘一叶。",
        "春卿拾材白日下，",
        "吾闻壮夫重心骨，古人三走无摧捽。",
        "请君待旦事长鞭，"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351688,
      "title": "咏怀二首",
      "content": [
        "长卿怀茂陵，绿草垂石井。",
        "弹琴看文君，春风吹鬓影。",
        "梁王与武帝，弃之如断梗。",
        "惟留一简书，金泥泰山顶。",
        "日夕著书罢，惊霜落素丝。",
        "镜中聊自笑，讵是南山期。",
        "头上无幅巾，苦檗已染衣。",
        "不见清溪鱼，饮水得自宜。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351689,
      "title": "追和柳恽",
      "content": [
        "汀洲白苹草，柳恽乘马归。",
        "江头楂树香，岸上蝴蝶飞。",
        "酒杯箬叶露，玉轸蜀桐虚。",
        "朱楼通水陌，沙暖一双鱼。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 351690,
      "title": "春坊正字剑子歌",
      "content": [
        "先辈匣中三尺水，曾入吴潭斩龙子。",
        "隙月斜明刮露寒，",
        "直是荆轲一片心，莫教照见春坊字。",
        "挼丝团金悬bAzy，"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351691,
      "title": "贵公子夜阑曲",
      "content": [
        "袅袅沉水烟，乌啼夜阑景。",
        "曲沼芙蓉波，腰围白玉冷。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 351692,
      "title": "雁门太守行",
      "content": [
        "黑云压城城欲摧，甲光向日金鳞开。",
        "角声满天秋色里，",
        "报君黄金台上意，提携玉龙为君死。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 351693,
      "title": "大堤曲",
      "content": [
        "妾家住横塘，红纱满桂香。",
        "青云教绾头上髻，",
        "郎食鲤鱼尾，妾食猩猩唇。",
        "莫指襄阳道，绿浦归帆少。",
        "今日菖蒲花，明朝枫树老。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351694,
      "title": "蜀国弦",
      "content": [
        "枫香晚花静，锦水南山影。",
        "惊石坠猿哀，竹云愁半岭。",
        "凉月生秋浦，玉沙粼粼光。",
        "谁家红泪客，不忍过瞿塘。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 351695,
      "title": "苏小小墓",
      "content": [
        "幽兰露，如啼眼。",
        "无物结同心，烟花不堪剪。",
        "草如茵，"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 351696,
      "title": "梦天",
      "content": [
        "老兔寒蟾泣天色，云楼半开壁斜白。",
        "玉轮轧露湿团光，",
        "遥望齐州九点烟，一泓海水杯中泻。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 351697,
      "title": "唐儿歌",
      "content": [
        "头玉硗硗眉刷翠，杜郎生得真男子。",
        "骨重神寒天庙器，",
        "东家娇娘求对值，浓笑画空作唐字。",
        "眼大心雄知所以，"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351698,
      "title": "绿章封事",
      "content": [
        "青霓扣额呼宫神，鸿龙玉狗开天门。",
        "石榴花发满溪津，",
        "虚空风气不清泠，短衣小冠作尘土。",
        "金家香巷千轮鸣，"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351699,
      "title": "河南府试十二月乐词：正月",
      "content": [
        "上楼迎春新春归，暗黄著柳宫漏迟。",
        "薄薄淡霭弄野姿，",
        "官街柳带不堪折，早晚菖蒲胜绾结。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351700,
      "title": "河南府试十二月乐词：二月",
      "content": [
        "二月饮酒采桑津，宜男草生兰笑人。",
        "蒲如交剑风如熏，"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351701,
      "title": "河南府试十二月乐词：三月",
      "content": [
        "东方风来满眼春，花城柳暗愁杀人。",
        "复宫深殿竹风起，",
        "军装宫妓扫蛾浅，摇摇锦旗夹城暖。",
        "曲水漂香去不归，"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351702,
      "title": "河南府试十二月乐词：四月",
      "content": [
        "晓凉暮凉树如尽，千山浓绿生云外。",
        "依微香雨青氛氲，"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351703,
      "title": "河南府试十二月乐词：五月",
      "content": [
        "雕玉押帘额，轻縠笼虚门。",
        "井汲铅华水，扇织鸳鸯纹。",
        "回雪舞凉殿，甘露洗空绿。",
        "罗袖从徊翔，香汗沾宝粟。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 351704,
      "title": "河南府试十二月乐词：六月",
      "content": [
        "裁生罗，伐湘竹，帔拂疏霜簟秋玉。",
        "炎炎红镜东方开，"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351705,
      "title": "河南府试十二月乐词：七月",
      "content": [
        "星依云渚冷，露滴盘中圆。",
        "好花生木末，衰蕙愁空园。",
        "夜天如玉砌，池叶极青钱。",
        "仅厌舞衫薄，稍知花簟寒。",
        "晓风何拂拂，北斗光阑干。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351706,
      "title": "河南府试十二月乐词：八月",
      "content": [
        "孀妾怨夜长，独客梦归家。",
        "傍簷虫缉丝，向壁灯垂花。",
        "帘外月光吐，帘内树影斜。",
        "悠悠飞露姿，点缀池中荷。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 351707,
      "title": "河南府试十二月乐词：九月",
      "content": [
        "离宫散萤天似水，竹黄池冷芙蓉死。",
        "月缀金铺光脉脉，",
        "鸡人罢唱晓珑璁，鸦啼金井下疏桐。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351708,
      "title": "河南府试十二月乐词：十月",
      "content": [
        "玉壶银箭稍难倾，釭花夜笑凝幽明。",
        "碎霜斜舞上罗幕，"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351709,
      "title": "河南府试十二月乐词：十一月",
      "content": [
        "宫城团回凛严光，白天碎碎堕琼芳。",
        "挝钟高饮千日酒，"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351710,
      "title": "河南府试十二月乐词：十二月",
      "content": [
        "日脚淡光红洒洒，薄霜不销桂枝下。",
        "依稀和气排冬严，已就长日辞长夜。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 351711,
      "title": "河南府试十二月乐词：闰月",
      "content": [
        "帝重光，年重时，七十二候回环推，天官玉管灰剩飞。",
        "今岁何长来岁迟，王母移桃献天子，羲氏和氏迂龙辔。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351712,
      "title": "天上谣",
      "content": [
        "天河夜转漂回星，银浦流云学水声。",
        "玉宫桂树花未落，",
        "王子吹笙鹅管长，呼龙耕烟种瑶草。",
        "粉霞红绶藕丝裙，"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351713,
      "title": "浩歌",
      "content": [
        "南风吹山作平地，帝遣天吴移海水。",
        "王母桃花千遍红，",
        "筝人劝我金屈卮，神血未凝身问谁。",
        "不须浪饮丁都护，",
        "漏催水咽玉蟾蜍，卫娘发薄不胜梳。",
        "看见秋眉换新绿，"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351714,
      "title": "秋来",
      "content": [
        "桐风惊心壮士苦，衰灯络纬啼寒素。",
        "谁看青简一编书，",
        "秋坟鬼唱鲍家诗，恨血千年土中碧。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351715,
      "title": "帝子歌",
      "content": [
        "洞庭明月一千里，凉风雁啼天在水。",
        "九节菖蒲石上死，",
        "沙浦走鱼白石郎，闲取真珠掷龙堂。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351716,
      "title": "秦王饮酒",
      "content": [
        "秦王骑虎游八极，剑光照空天自碧。",
        "羲和敲日玻璃声，",
        "洞庭雨脚来吹笙，酒酣喝月使倒行。",
        "银云栉栉瑶殿明，"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351717,
      "title": "洛姝真珠",
      "content": [
        "真珠小娘下清廓，洛苑香风飞绰绰。",
        "寒鬓斜钗玉燕光，",
        "花袍白马不归来，浓蛾叠柳香唇醉。",
        "金鹅屏风蜀山梦，",
        "市南曲陌无秋凉，楚腰卫鬓四时芳。",
        "玉喉窱窱排空光，"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351718,
      "title": "李夫人歌",
      "content": [
        "紫皇宫殿重重开，夫人飞入琼瑶台。",
        "绿香绣帐何时歇，",
        "红壁阑珊悬佩珰，歌台小妓遥相望。",
        "玉蟾滴水鸡人唱，"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351719,
      "title": "走马引",
      "content": [
        "我有辞乡剑，玉锋堪截云。",
        "襄阳走马客，意气自生春。",
        "朝嫌剑花净，暮嫌剑光冷。",
        "能持剑向人，不解持照身。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 351720,
      "title": "湘妃",
      "content": [
        "筠竹千年老不死，长伴秦娥盖湘水。",
        "蛮娘吟弄满寒空，",
        "幽愁秋气上青枫，凉夜波间吟古龙。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351721,
      "title": "南园十三首",
      "content": [
        "花枝草蔓眼中开，小白长红越女腮。",
        "可怜日暮嫣香落，嫁与春风不用媒。",
        "宫北田塍晓气酣，黄桑饮露窣宫帘。",
        "长腰健妇偷攀折，将喂吴王八茧蚕。",
        "竹里缲丝挑网车，青蝉独噪日光斜。",
        "桃胶迎夏香琥珀，自课越佣能种瓜。",
        "三十未有二十余，白日长饥小甲蔬。",
        "桥头长老相哀念，因遗戎韬一卷书。",
        "男儿何不带吴钩，收取关山五十州。",
        "请君暂上凌烟阁，若个书生万户侯。",
        "寻章摘句老雕虫，晓月当帘挂玉弓。",
        "不见年年辽海上，文章何处哭秋风。",
        "长卿牢落悲空舍，曼倩诙谐取自容。",
        "见买若耶溪水剑，明朝归去事猿公。",
        "春水初生乳燕飞，黄蜂小尾扑花归。",
        "窗含远色通书幌，鱼拥香钩近石矶。",
        "泉沙软卧鸳鸯暖，曲岸回篙舴艋迟。",
        "泻酒木栏椒叶盖，病容扶起种菱丝。",
        "边让今朝忆蔡邕，无心裁曲卧春风。",
        "舍南有竹堪书字，老去溪头作钓翁。",
        "长峦谷口倚嵇家，白昼千峰老翠华。",
        "自履藤鞋收石蜜，手牵苔絮长莼花。",
        "松溪黑水新龙卵，桂洞生硝旧马牙。",
        "谁遣虞卿裁道帔，轻绡一匹染朝霞。",
        "小树开朝径，长茸湿夜烟。",
        "柳花惊雪浦，麦雨涨溪田。",
        "古刹疏钟度，遥岚破月悬。",
        "沙头敲石火，烧竹照渔船。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351722,
      "title": "金铜仙人辞汉歌",
      "content": [
        "茂陵刘郎秋风客，夜闻马嘶晓无迹。",
        "画栏桂树悬秋香，",
        "空将汉月出宫门，忆君清泪如铅水。",
        "衰兰送客咸阳道，"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 351724,
      "title": "黄头郎",
      "content": [
        "黄头郎，捞拢去不归。",
        "南浦芙蓉影，愁红独自垂。",
        "水弄湘娥佩，竹啼山露月。",
        "玉瑟调青门，石云湿黄葛。",
        "沙上蘼芜花，秋风已先发。",
        "好持扫罗荐，香出鸳鸯热。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351725,
      "title": "马诗二十三首",
      "content": [
        "龙脊贴连钱，银蹄白踏烟。",
        "无人织锦韂，谁为铸金鞭。",
        "腊月草根甜，天街雪似盐。",
        "未知口硬软，先拟蒺藜衔。",
        "忽忆周天子，驱车上玉山。",
        "鸣驺辞凤苑，赤骥最承恩。",
        "此马非凡马，房星本是星。",
        "向前敲瘦骨，犹自带铜声。",
        "大漠山如雪，燕山月似钩。",
        "何当金络脑，快走踏清秋。",
        "饥卧骨查牙，粗毛刺破花。",
        "鬣焦朱色落，发断锯长麻。",
        "西母酒将阑，东王饭已干。",
        "君王若燕去，谁为拽车辕。",
        "赤兔无人用，当须吕布骑。",
        "吾闻果下马，羁策任蛮儿。",
        "飂叔去匆匆，如今不豢龙。",
        "夜来霜压栈，骏骨折西风。",
        "催榜渡乌江，神骓泣向风。",
        "君王今解剑，何处逐英雄。",
        "内马赐宫人，银鞯刺骐驎。",
        "午时盐阪上，蹭蹬溘风尘。",
        "批竹初攒耳，桃花未上身。",
        "他时须搅阵，牵去借将军。",
        "宝玦谁家子，长闻侠骨香。",
        "堆金买骏骨，将送楚襄王。",
        "香幞赭罗新，盘龙蹙镫鳞。",
        "回看南陌上，谁道不逢春。",
        "不从桓公猎，何能伏虎威。",
        "一朝沟陇出，看取拂云飞。",
        "唐剑斩隋公，拳毛属太宗。",
        "莫嫌金甲重，且去捉旋风。",
        "白铁剉青禾，砧间落细莎。",
        "世人怜小颈，金埒畏长牙。",
        "伯乐向前看，旋毛在腹间。",
        "只今掊白草，何日蓦青山。",
        "萧寺驮经马，元从竺国来。",
        "空知有善相，不解走章台。",
        "重围如燕尾，宝剑似鱼肠。",
        "欲求千里脚，先采眼中光。",
        "暂系腾黄马，仙人上彩楼。",
        "须鞭玉勒吏，何事谪高州。",
        "汗血到王家，随鸾撼玉珂。",
        "少君骑海上，人见是青骡。",
        "武帝爱神仙，烧金得紫烟。",
        "厩中皆肉马，不解上青天。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351727,
      "title": "老夫采玉歌",
      "content": [
        "采玉采玉须水碧，琢作步摇徒好色。",
        "老夫饥寒龙为愁，",
        "蓝溪之水厌生人，身死千年恨溪水。",
        "斜山柏风雨如啸，"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351728,
      "title": "伤心行",
      "content": [
        "咽咽学楚吟，病骨伤幽素。",
        "秋姿白发生，木叶啼风雨。",
        "灯青兰膏歇，落照飞蛾舞。",
        "古壁生凝尘，羁魂梦中语。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 351729,
      "title": "湖中曲",
      "content": [
        "长眉越沙采兰若，桂叶水葓春漠漠。",
        "横船醉眠白昼闲，",
        "蜀纸封巾报云鬓，晚漏壶中水淋尽。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351730,
      "title": "黄家洞",
      "content": [
        "雀步蹙沙声促促，四尺角弓青石镞。",
        "黑幡三点铜鼓鸣，",
        "山潭晚雾吟白鼍，竹蛇飞蠹射金沙。",
        "闲驱竹马缓归家，"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351731,
      "title": "屏风曲",
      "content": [
        "蝶栖石竹银交关，水凝绿鸭琉璃钱。",
        "团回六曲抱膏兰，",
        "月风吹露屏外寒，城上乌啼楚女眠。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351732,
      "title": "南山田中行",
      "content": [
        "秋野明，秋风白，塘水漻漻虫啧啧。",
        "云根苔藓山上石，",
        "石脉水流泉滴沙，鬼灯如漆点松花。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351733,
      "title": "贵主征行乐",
      "content": [
        "奚骑黄铜连锁甲，罗旗香干金画叶。",
        "中军留醉河阳城，",
        "女垣素月角咿咿，牙帐未开分锦衣。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351734,
      "title": "酒罢张大彻索赠诗",
      "content": [
        "长鬣张郎三十八，天遣裁诗花作骨。",
        "往还谁是龙头人，",
        "金门石阁知卿有，豸角鸡香早晚含。",
        "陇西长吉摧颓客，"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351735,
      "title": "罗浮山父与葛篇",
      "content": [
        "依依宜织江雨空，雨中六月兰台风。",
        "博罗老仙时出洞，",
        "欲剪箱中一尺天，吴娥莫道吴刀涩。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351736,
      "title": "仁和里杂叙皇甫湜",
      "content": [
        "大人乞马臒乃寒，宗人贷宅荒厥垣。",
        "横庭鼠径空土涩，",
        "还家白笔未上头，使我清声落人后。",
        "枉辱称知犯君眼，",
        "那知坚都相草草，客枕幽单看春老。",
        "归来骨薄面无膏，",
        "明朝下元复西道，崆峒叙别长如天。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351737,
      "title": "宫娃歌",
      "content": [
        "蜡光高悬照纱空，花房夜捣红守宫。",
        "象口吹香毾bG暖，",
        "啼蛄吊月钩栏下，屈膝铜铺锁阿甄。",
        "梦入家门上沙渚，"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351738,
      "title": "堂堂",
      "content": [
        "堂堂复堂堂，红脱梅灰香。",
        "十年粉蠹生画梁，",
        "华清源中礜石汤，裴回白凤随君王。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351739,
      "title": "勉爱行二首送小季之庐山",
      "content": [
        "洛郊无俎豆，弊厩惭老马。",
        "小雁过炉峰，影落楚水下。",
        "长船倚云泊，石镜秋凉夜。",
        "岂解有乡情，弄月聊呜哑。",
        "别柳当马头，官槐如兔目。",
        "欲将千里别，持我易斗粟。",
        "南云北云空脉断，灵台经络悬春线。",
        "青轩树转月满床，",
        "辞家三载今如此，索米王门一事无。",
        "荒沟古水光如刀，"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351740,
      "title": "致酒行",
      "content": [
        "零落栖迟一杯酒，主人奉觞客长寿。",
        "主父西游困不归，",
        "空将笺上两行书，直犯龙颜请恩泽。",
        "我有迷魂招不得，"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
