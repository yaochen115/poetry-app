{
  "data": [
    {
      "id": 298144,
      "title": "重阳山居",
      "content": [
        "此身逃难入乡关，八度重阳在旧山。",
        "篱菊乱来成烂熳，家僮常得解登攀。",
        "年随历日三分尽，醉伴浮生一片闲。",
        "满目秋光还似镜，殷勤为我照衰颜。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 298145,
      "title": "旅中重阳",
      "content": [
        "乘时争路秪危身，经乱登高有几人。",
        "今岁节唯南至在，旧交坟向北邙新。",
        "当歌共惜初筵乐，且健无辞后会频。",
        "莫道中冬犹有闰，蟾声才尽即青春。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 298146,
      "title": "南至日",
      "content": [
        "年年山□□来频，莫强孤危竞要津。",
        "吉卦偶成开病眼，暖簷还葺寄羸身。",
        "求仙自躁非无药，报国当材别有人。",
        "鬓发堪伤白已遍，镜中更待白眉新。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 298147,
      "title": "五月九日",
      "content": [
        "金石皆销铄，贤愚共网罗。",
        "达从诗似偈，狂觉哭胜歌。",
        "高燕凌鸿鹄，枯槎压芰荷。",
        "此中无别境，此外是闲魔。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 298148,
      "title": "庚子腊月五日",
      "content": [
        "复道朝延火，严城夜涨尘。",
        "骅骝思故第，鹦鹉失佳人。",
        "禁漏虚传点，妖星不振辰。",
        "何当回万乘，重覩玉京春。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 298497,
      "title": "酒泉子",
      "content": [
        "买得杏花，十载归来方始坼。",
        "假山西畔药阑东，满枝红。",
        "旋开旋落旋成空，白发多情人更惜。",
        "黄昏把酒祝东风，且从容。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 301105,
      "title": "晚思",
      "content": [
        "蛩余窗下月，草湿堦前露。",
        "晚景凄我衣，秋风入何树？",
        "（此见《分门纂类唐歌诗》残本第一册《天地山川类》。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 301732,
      "title": "{巩/言}光大师草书歌",
      "content": [
        "羸病爱师书劲逸，翻作长歌助狂笔。",
        "乘高攂鼓震川原，惊迸骅骝几千匹。",
        "落笔纵横不离禅，方知草圣本非颠。",
        "歌成与扫松斋壁，何似曾题《说剑篇》。",
        "（《六艺之一录》二九○引朱长文《墨池编》十三原书目录作{巩/言}光诗）（《四库全书》本《墨池编》卷四录此诗无作者，附司空图《书屏记》后。",
        "《宣和书谱》卷九录司空图赠{巩/言}光诗云：「看）（师逸说迹两相宜，高适歌行李白诗」，此诗中无。",
        "是砧图作，颇可疑。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 301733,
      "title": "恭州界（旧《图经》及《寰宇记》、《九域志》皆日渝州，《舆地广记》曰恭州。）",
      "content": [
        "山容地脉本清凉，不解为霖却作汤。",
        "草木龟鱼困薰煮，漫赢尘垢涴僧坊。",
        "（《舆地纪胜》一七五《重庆府》）。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 301734,
      "title": "春晚（句）",
      "content": [
        "凭高怜酒韵，引满未能已。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 301735,
      "title": "抚事寄同游（句）",
      "content": [
        "春添茶韵时过寺。",
        "（以上元李治《敬斋古今黈逸文》二）。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 304603,
      "title": "岁尽日二首（之二）",
      "content": [
        "桂花穷北陆，荆艳下东邻。",
        "残粧欲送晓，薄衣已迎春。",
        "举袖争流雪，分歌竞绕尘。",
        "不应将共醉，年去远催人。",
        "（见上海图书馆藏明抄本《古今岁时杂咏》卷四一）。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 304604,
      "title": "南至日",
      "content": [
        "年年山压压来频，莫强孤危竞要津。",
        "吉卦偶成开病眼，暖簷还葺寄羸身。",
        "求仙自躁非无药，报国当材别有人。",
        "鬓发堪伤白已遍，镜中更待白眉新。",
        "（同前书卷三九）（按：《全唐诗》卷八八五收此诗首句缺二字，今重录。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 334861,
      "title": "琴曲歌辞：蔡氏五弄：秋思",
      "content": [
        "身病时亦危，逢秋多恸哭。",
        "风波一摇荡，天地几翻覆。",
        "孤萤出荒池，落叶穿破屋。",
        "势利长草草，何人访幽独。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 364234,
      "title": "寄永嘉崔道融",
      "content": [
        "旅寓虽难定，乘闲是胜游。",
        "碧云萧寺霁，红树谢村秋。",
        "戍鼓和潮暗，船灯照岛幽。",
        "诗家多滞此，风景似相留。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 364241,
      "title": "效陈拾遗子昂感遇二首",
      "content": [
        "高燕飞何捷，啄害恣群雏。",
        "人岂玩其暴，华轩容尔居。",
        "强欺自天禀，刚吐信吾徒。",
        "乃知不平者，矫世道终孤。",
        "阳和含煦润，卉木竞纷华。",
        "当为众所悦，私已汝何夸。",
        "北里秘秾艳，东园锁名花。",
        "豪夺乃常理，笑君徒咄嗟。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 364245,
      "title": "早春",
      "content": [
        "伤怀同客处，病眼却花朝。",
        "草嫩侵沙短，冰轻著雨消。",
        "风光知可爱，容发不相饶。",
        "早晚丹丘去，飞书肯见招。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 364246,
      "title": "上陌梯寺怀旧僧二首",
      "content": [
        "云根禅客居，皆说旧无庐。",
        "松日明金像，山风向木鱼。",
        "依栖应不阻，名利本来疏。",
        "纵有人相问，林间懒拆书。",
        "高鸦隔谷见，路转寺西门。",
        "塔影荫泉脉，山苗侵烧痕。",
        "钟疏含杳霭，合迥亘黄昏。",
        "更待他僧到，长如前信存。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 364251,
      "title": "江行二首",
      "content": [
        "地阔分吴塞，枫高映楚天。",
        "曲塘春尽雨，方响夜深船。",
        "行纪添新梦，羁愁甚往年。",
        "何时京洛路，马上见人烟。",
        "初程风信好，回望失津楼。",
        "日带潮声晚，烟含楚色秋。",
        "戍旗当远客，岛树转惊鸥。",
        "此去非名利，孤帆任白头。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 364254,
      "title": "寄郑仁规",
      "content": [
        "清才郑小戎，标的贵游中。",
        "万里云无侣，三山鹤不笼。",
        "香和丹地暖，晚著彩衣风。",
        "荣路期经济，唯应在至公。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 364255,
      "title": "寄考功王员外",
      "content": [
        "喜闻三字耗，闲客是陪游。",
        "白鸟闲疏索，青山日滞留。",
        "琴如高韵称，诗愧逸才酬。",
        "更勉匡君志，论思在献谋。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 364256,
      "title": "杂言",
      "content": [
        "乌飞飞，兔蹶蹶，朝来暮去驱时节。",
        "女娲只解补青天，"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 364257,
      "title": "陈疾",
      "content": [
        "自怜旅舍亦酣歌，世路无机奈尔何。",
        "霄汉逼来心不动，",
        "闲得此身归未得，磬声深夏隔烟萝。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 364258,
      "title": "淅上",
      "content": [
        "华下支离已隔河，又来此地避干戈。",
        "山田渐广猿时到，",
        "儿童栗熟迷归路，归得仍随牧竖歌。",
        "西北乡关近帝京，烟尘一片正伤情。",
        "愁看地色连空色，",
        "从他烟棹更南去，休向津头问去程。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 364259,
      "title": "山中",
      "content": [
        "全家与我恋孤岑，蹋得苍苔一径深。",
        "逃难人多分隙地，",
        "昨夜前溪骤雷雨，晚晴闲步数峰吟。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 364260,
      "title": "寄赠诗僧秀公",
      "content": [
        "灵一心传清塞心，可公吟后础公吟。",
        "近来雅道相亲少，",
        "冷曹孤宦甘寥落，多谢携筇数访寻。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 364261,
      "title": "重阳日访元秀上人",
      "content": [
        "红叶黄花秋景宽，醉吟朝夕在樊川。",
        "却嫌今日登山俗，",
        "归来童稚争相笑，何事无人与酒船。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 364262,
      "title": "丁未岁归王官谷",
      "content": [
        "家山牢落战尘西，匹马偷归路已迷。",
        "冢上卷旗人簇立，",
        "将取一壶闲日月，长歌深入武陵溪。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 364263,
      "title": "书怀",
      "content": [
        "病来犹强引雏行，力上东原欲试耕。",
        "几处马嘶春麦长，",
        "陶令若能兼不饮，无弦琴亦是沽名。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 364264,
      "title": "退栖",
      "content": [
        "宦游萧索为无能，移住中条最上层。",
        "得剑乍如添健仆，",
        "自此致身绳检外，肯教世路日兢兢。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 364265,
      "title": "五十",
      "content": [
        "闲身事少只题诗，五十今来觉陡衰。",
        "清秩偶叨非养望，",
        "漉酒有巾无黍酿，负他黄菊满东篱。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 364266,
      "title": "新岁对写真",
      "content": [
        "得见明时下寿身，须甘岁酒更移巡。",
        "生情暗结千重恨，",
        "自伤衰飒慵开镜，拟与儿童别写真。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 364267,
      "title": "华下",
      "content": [
        "箨冠新带步池塘，逸韵偏宜夏景长。",
        "扶起绿荷承早露，",
        "不用名山访真诀，退休便是养生方。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 364268,
      "title": "重阳山居",
      "content": [
        "诗人自古恨难穷，暮节登临且喜同。",
        "四望交亲兵乱后，",
        "明日更期来此醉，不堪寂寞对衰翁。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 364269,
      "title": "争名",
      "content": [
        "争名岂在更搜奇，不朽才消一句诗。",
        "穷辱未甘英气阻，",
        "只此共栖尘外境，无妨亦恋好文时。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 364270,
      "title": "光启四年春戊申",
      "content": [
        "乱后烧残数架书，峰前犹自恋吾庐。",
        "忘机渐喜逢人少，",
        "酣歌自适逃名久，不必门多长者车。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 364271,
      "title": "丁巳重阳",
      "content": [
        "重阳未到已登临，探得黄花且独斟。",
        "客舍喜逢连日雨，",
        "自贺逢时能自弃，归鞭唯拍马鞯吟。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 364272,
      "title": "喜王驾小仪重阳相访",
      "content": [
        "白菊初开卧内明，闻君相访病身轻。",
        "樽前且拨伤心事，",
        "拟将寂寞同留住，且劝康时立大名。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 364273,
      "title": "酬张芬赦后见寄",
      "content": [
        "紫凤朝衔五色书，阳春忽布网罗除。",
        "已将心变寒灰后，",
        "劳君故有诗相赠，欲报琼瑶愧不如。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 364277,
      "title": "闲步",
      "content": [
        "几处白烟断，一川红树时。",
        "坏桥侵辙水，残照背村碑。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 364278,
      "title": "春中",
      "content": [
        "伏溜侵阶润，繁花隔竹香。",
        "娇莺方晓听，无事过南塘。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 364279,
      "title": "独望",
      "content": [
        "绿树连村暗，黄花出陌稀。",
        "远陂春草绿，犹有水禽飞。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 364281,
      "title": "漫题三首",
      "content": [
        "乱后他乡节，烧残故国春。",
        "自怜垂白首，犹伴踏青人。",
        "齿落伤情久，心惊健忘频。",
        "蜗庐经岁客，蚕市异乡人。",
        "率怕人言谨，闲宜酒韵高。",
        "山林若无虑，名利不难逃。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 364282,
      "title": "河上二首",
      "content": [
        "惨惨日将暮，驱羸独到庄。",
        "沙痕傍墟落，风色入牛羊。",
        "新霁田园处，夕阳禾黍明。",
        "沙村平见水，深巷有鸥声。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 364284,
      "title": "即事二首",
      "content": [
        "茶爽添诗句，天清莹道心。",
        "只留鹤一只，此外是空林。",
        "御礼征奇策，人心注盛时。",
        "从来留振滞，只待济临危。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 364288,
      "title": "退居漫题七首",
      "content": [
        "花缺伤难缀，莺喧奈细听。",
        "惜春春已晚，珍重草青青。",
        "堤柳自绵绵，幽人无恨牵。",
        "只忧诗病发，莫寄校书笺。",
        "燕语曾来客，花催欲别人。",
        "莫愁春又过，看著又新春。",
        "身外都无事，山中久避喧。",
        "破巢看乳燕，留果待啼猿。",
        "诗家通籍美，工部与司勋。",
        "高贾虽难敌，微官偶胜君。",
        "努力省前非，人生上寿稀。",
        "青云无直道，暗室有危机。",
        "燕拙营巢苦，鱼贪触网惊。",
        "岂缘身外事，亦似我劳形。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 364289,
      "title": "即事九首",
      "content": [
        "宿雨川原霁，凭高景物新。",
        "陂痕侵牧马，云影带耕人。",
        "十年深隐地，一雨太平心。",
        "匣涩休看剑，窗明复上琴。",
        "明时那弃置，多病自迟留。",
        "疏磬和吟断，残灯照卧幽。",
        "衰鬓闲生少，丹梯望觉危。",
        "松须依石长，鹤不傍人卑。",
        "落叶频惊鹿，连峰欲映雕。",
        "此生诗病苦，此病更萧条。",
        "旅思又惊夏，庭前长小松。",
        "远峰生贵气，残月敛衰容。",
        "林鸟频窥静，家人亦笑慵。",
        "旧居留稳枕，归卧听秋钟。",
        "华宇知难保，烧来又却修。",
        "只应巢燕惜，未必主人留。",
        "幽鸟穿篱去，邻翁采药回。",
        "云从潭底出，花向佛前开。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 364290,
      "title": "松滋渡二首",
      "content": [
        "步上短亭久，看回官渡船。",
        "江乡宜晚霁，楚老语丰年。",
        "楚岫接乡思，茫茫归路迷。",
        "更堪斑竹驿，初听鹧鸪啼。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 364292,
      "title": "牛头寺",
      "content": [
        "终南最佳处，禅诵出青霄。",
        "群木澄幽寂，疏烟泛泬寥。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 364294,
      "title": "乱后三首",
      "content": [
        "丧乱家难保，艰虞病懒医。",
        "空将忧国泪，犹拟洒丹墀。",
        "流芳能几日，惆怅又闻蝉。",
        "行在多新贵，幽栖独长年。",
        "世事尝艰险，僧居惯寂寥。",
        "美香闻夜合，清景见寅朝。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 364296,
      "title": "避乱",
      "content": [
        "离乱身偶在，窜迹任浮沉。",
        "虎暴荒居迥，萤孤黑夜深。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 364298,
      "title": "村西杏花二首",
      "content": [
        "薄腻力偏羸，看看怆别时。",
        "东风狂不惜，西子病难医。",
        "肌细分红脉，香浓破紫苞。",
        "无因留得玩，争忍折来抛。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 364302,
      "title": "偶书五首",
      "content": [
        "衰谢当何忏，惟应悔壮图。",
        "磬声花外远，人影塔前孤。",
        "色变莺雏长，竿齐笋箨垂。",
        "白头身偶在，清夏景还移。",
        "蜀妓轻成妙，吴娃狎共纤。",
        "晚妆留拜月，卷上水精帘。",
        "独步荒郊暮，沉思远墅幽。",
        "平生多少事，弹指一时休。",
        "掩谤知迎吠，欺心见强颜。",
        "有名人易困，无契债难还。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 364303,
      "title": "杂题九首",
      "content": [
        "病来胜未病，名缚便忘名。",
        "今日甘为客，当时注湣征。",
        "暑湿深山雨，荒居破屋灯。",
        "此生无忏处，此去作高僧。",
        "不须频怅望，且喜脱喧嚣。",
        "亦有终焉意，陂南看稻苗。",
        "楼带猿吟迥，庭容鹤舞宽。",
        "z4书因阅画，封药偶和丹。",
        "宴罢论诗久，亭高拜表频。",
        "岸香蕃舶月，洲色海烟春。",
        "驿步堤萦阁，军城鼓振桥。",
        "鸥和湖雁下，雪隔岭梅飘。",
        "带雪南山道，和钟北阙明。",
        "太平当共贺，开化喝来声。",
        "舴艋猿偷上，蜻蜓燕竞飞。",
        "樵香烧桂子，苔湿挂莎衣。",
        "溪涨渔家近，烟收鸟道高。",
        "松花飘可惜，睡里洒离骚。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 364307,
      "title": "漫书二首",
      "content": [
        "剩欲逢花折，判须冒雨频。",
        "晴明开渐少，莫怕湿新巾。",
        "小蝶尔何竞，追飞不惮劳。",
        "远教群雀见，宁悟祸梯高。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 364308,
      "title": "岁尽二首",
      "content": [
        "明日添一岁，端忧奈尔何。",
        "冲寒出洞口，犹校夕阳多。",
        "莫话伤心事，投春满鬓霜。",
        "殷勤共尊酒，今岁只残阳。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 364318,
      "title": "白菊杂书四首",
      "content": [
        "黄昏寒立更披襟，露浥清香悦道心。",
        "却笑谁家扃绣户，正熏龙麝暖鸳衾。",
        "四面云屏一带天，是非断得自翛然。",
        "此生只是偿诗债，白菊开时最不眠。",
        "狂才不足自英雄，仆妾驱令学贩舂。",
        "侯印几人封万户，侬家只办买孤峰。",
        "黄鹂啭处谁同听，白菊开时且剩过。",
        "漫道南朝足流品，由来叔宝不宜多。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 364321,
      "title": "涧户",
      "content": [
        "涧户芳烟接水村，乱来归得道仍存。",
        "数竿新竹当轩上，不羡侯家立戟门。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 364323,
      "title": "华上二首",
      "content": [
        "故国春归未有涯，小栏高槛别人家。",
        "五更惆怅回孤枕，犹自残灯照落花。",
        "关外风昏欲雨天，荠花耕倒枕河壖。",
        "村南寂寞时回望，一只鸳鸯下渡船。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 364325,
      "title": "榜下",
      "content": [
        "三十功名志未伸，初将文字竞通津。",
        "春风漫折一枝桂，烟阁英雄笑杀人。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 364326,
      "title": "涔阳渡",
      "content": [
        "楚田人立带残晖，驿迥村幽客路微。",
        "两岸芦花正萧飒，渚烟深处白牛归。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 364328,
      "title": "寓居有感三首",
      "content": [
        "亦知世路薄忠贞，不忍残年负圣明。",
        "只待东封沾庆赐，碑阴别刻老臣名。",
        "不放残年却到家，衔杯懒更问生涯。",
        "河堤往往人相送，一曲晴川隔蓼花。",
        "黑须寄在白须生，一度秋风减几茎。",
        "客处不堪频送别，无多情绪更伤情。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 364331,
      "title": "自gM乡北归",
      "content": [
        "巴烟幂幂久萦恨，楚柳绵绵今送归。",
        "回避江边同去雁，莫教惊起错南飞。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 364333,
      "title": "山中",
      "content": [
        "凡鸟爱喧人静处，闲云似妒月明时。",
        "世间万事非吾事，只愧秋来未有诗。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 364334,
      "title": "有感二首",
      "content": [
        "自古经纶足是非，阴谋最忌夺天机。",
        "留侯却粒商翁去，甲第何人意气归。",
        "古来贤俊共悲辛，长是豪家拒要津。",
        "从此当歌唯痛饮，不须经世为闲人。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 364335,
      "title": "闲夜二首",
      "content": [
        "道侣难留为虐棋，邻家闻说厌吟诗。",
        "前峰月照分明见，夜合香中露卧时。",
        "此身闲得易为家，业是吟诗与看花。",
        "若使他生抛笔砚，更应无事老烟霞。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 364336,
      "title": "雨中",
      "content": [
        "维摩居士陶居士，尽说高情未足夸。",
        "簷外莲峰阶下菊，碧莲黄菊是吾家。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 364337,
      "title": "送道者二首",
      "content": [
        "洞天真侣昔曾逢，西岳今居第几峰。",
        "峰顶他时教我认，相招须把碧芙蓉。",
        "殷勤不为学烧金，道侣惟应识此心。",
        "雪里千山访君易，微微鹿迹入深林。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 364342,
      "title": "顷年陪恩地赴甘棠之召感动留题",
      "content": [
        "去时憔悴青衿在，归路凄凉绛帐空。",
        "无限酬恩心未展，又将孤剑别从公。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 364347,
      "title": "南北史感遇十首",
      "content": [
        "雨淋麟阁名臣画，雪卧龙庭猛将碑。",
        "不用黄金铸侯印，尽输公子买蛾眉。",
        "汉世频封万户侯，云台空峻谢风流。",
        "江南不有名儒相，齿冷中原笑未休。",
        "天风斡海怒长鲸，永固南来百万兵。",
        "若向沧洲犹笑傲，江山虚有石头城。",
        "花迷公子玉楼恩，镜弄佳人红粉春。",
        "不信关山劳远戍，绮罗香外任行尘。",
        "兵围梁殿金瓯破，火发陈宫玉树摧。",
        "奸佞岂能惭误国，空令怀古更徘徊。",
        "行乐最宜连夜景，太平方觉有春风。",
        "千金尽把酬歌舞，犹胜三边赏战功。",
        "桃芳李艳年年发，羌管蛮弦处处多。",
        "海上应无三岛路，人间惟有一声歌。",
        "佳人自折一枝红，把唱新词曲未终。",
        "惟向眼前怜易落，不如抛掷任春风。",
        "景阳楼下花钿镜，玄武湖边锦绣旗。",
        "昔日繁华今日恨，雉媒声晚草芳时。",
        "乱后人间尽不平，秦川花木最伤情。",
        "无穷红艳红尘里，骤马分香散入营。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 364348,
      "title": "狂题二首",
      "content": [
        "草堂旧隐犹招我，烟阁英才不见君。",
        "惆怅故山归未得，酒狂叫断暮天云。",
        "须知世乱身难保，莫喜天晴菊并开。",
        "长短此身长是客，黄花更助白头催。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 364351,
      "title": "见后雁有感",
      "content": [
        "笑尔穷通亦似人，高飞偶滞莫悲辛。",
        "却缘风雪频相阻，只向关中待得春。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 364353,
      "title": "忆中条",
      "content": [
        "燕辞旅舍人空在，萤出疏篱菊正芳。",
        "堪恨昔年联句地，念经僧扫过重阳。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 364354,
      "title": "乐府",
      "content": [
        "五更窗下簇妆台，已怕堂前阿母催。",
        "满鸭香熏鹦鹉睡，隔帘灯照牡丹开。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 364355,
      "title": "放龟二首",
      "content": [
        "却为多知自不灵，今朝教汝卜长生。",
        "若求深处无深处，只有依人会有情。",
        "世外犹迷不死庭，人间莫恃自无营。",
        "本期沧海堪投迹，却向朱门待放生。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 364356,
      "title": "灯花三首",
      "content": [
        "蜀柳丝丝幂画楼，窗尘满镜不梳头。",
        "几时金雁传归信，剪断香魂一缕愁。",
        "姊姊教人且抱儿，逐他女伴卸头迟。",
        "明朝斗草多应喜，翦得灯花自扫眉。",
        "闰前小雪过经旬，犹自依依向主人。",
        "开尽菊花怜强舞，与教弟子待新春。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 364357,
      "title": "偶题三首",
      "content": [
        "浮世悠悠旋一空，多情偏解挫英雄。",
        "风光只在歌声里，不必楼前万树红。",
        "小池随事有风荷，烧酹倾壶一曲歌。",
        "欲待秋塘擎露看，自怜生意已无多。",
        "辽阳音信近来稀，纵有虚传逼节归。",
        "永日无人新睡觉，小窗晴暖螖虫飞。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 364361,
      "title": "商山二首",
      "content": [
        "清溪一路照羸身，不似云台画像人。",
        "国史数行犹有志，只将谈笑继英尘。",
        "马上搜奇已数篇，籍中犹愧是顽仙。",
        "关头传说开元事，指点多疑孟浩然。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 364362,
      "title": "与伏牛长老偈二首",
      "content": [
        "不算菩提与阐提，惟应执著便生迷。",
        "无端指个清凉地，冻杀胡僧雪岭西。",
        "长绳不见系空虚，半偈传心亦未疏。",
        "推倒我山无一事，莫将文字缚真如。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 364364,
      "title": "柳二首",
      "content": [
        "谁家按舞傍池塘，已见繁枝嫩眼黄。",
        "漫说早梅先得意，不知春力暗分张。",
        "似拟凌寒妒早梅，无端弄色傍高台。",
        "折来未有新枝长，莫遣佳人更折来。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 364369,
      "title": "南至四首",
      "content": [
        "今冬腊后无残日，故国烧来有几家。",
        "却恨早梅添旅思，强偷春力报年华。",
        "花时不是偏愁我，好事应难总取他。",
        "已被诗魔长役思，眼中莫厌早梅多。",
        "年华乱后偏堪惜，世路抛来已自生。",
        "犹有玉真长命缕，樽前时唱缓羁情。",
        "一任喧阗绕四邻，闲忙皆是自由身。",
        "人来客去还须议，莫遣他人作主人。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 364372,
      "title": "剑器",
      "content": [
        "楼下公孙昔擅场，空教女子爱军装。",
        "潼关一败吴儿喜，簇马骊山看御汤。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 364374,
      "title": "携仙箓九首",
      "content": [
        "岳北秋空渭北川，晴云渐薄薄如烟。",
        "坐来还见微风起，吹散残阳一片蝉。",
        "一半晴空一半云，远笼仙掌日初曛。",
        "洞天有路不知处，绝顶异香难更闻。",
        "决事还须更事酬，清谭妙理一时休。",
        "渔翁亦被机心误，眼暗汀边结钓钩。",
        "迹不趋时分不侯，功名身外最悠悠。",
        "听君总画麒麟阁，还我闲眠舴艋舟。",
        "仙凡路阻两难留，烟树人间一片秋。",
        "若道阴功能济活，且将方寸自焚修。",
        "若有阴功救未然，玉皇品籍亦搜贤。",
        "应知谭笑还高谢，别就沧洲赞上仙。",
        "英名何用苦搜奇，不朽才销一句诗。",
        "却赖风波阻三岛，老臣犹得恋明时。",
        "剪取红云剩写诗，年年高会趁花时。",
        "水精楼阁分明见，只欠霞浆别著旗。",
        "此生得作太平人，只向尘中便出尘。",
        "移取碧桃花万树，年年自乐故乡春。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 364377,
      "title": "暮春对柳二首",
      "content": [
        "萦愁惹恨奈杨花，闭户垂帘亦满家。",
        "恼得闲人作酒病，刚须又扑越溪茶。",
        "洞中犹说看桃花，轻絮狂飞自俗家。",
        "正是阶前开远信，小娥旋拂碾新茶。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 364378,
      "title": "戊午三月晦二首",
      "content": [
        "随风逐浪剧蓬萍，圆首何曾解最灵。",
        "笔砚近来多自弃，不关妖气暗文星。",
        "牛夸棋品无勍敌，谢占诗家作上流。",
        "岂似小敷春水涨，年年鸾鹤待仙舟。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 364379,
      "title": "偶书五首",
      "content": [
        "情知了得未如僧，客处高楼莫强登。",
        "莺也解啼花也发，不关心事最堪憎。",
        "自有池荷作扇摇，不关风动爱芭蕉。",
        "只怜直上抽红蕊，似我丹心向本朝。",
        "曾看轻舟渡远津，无风著岸不经旬。",
        "只缘命蹇须知命，却是人争阻得人。",
        "上谷何曾解有情，有情人自惜君行。",
        "证因池上今生愿，的的他生作化生。",
        "新店南原后夜程，黄河风浪信难平。",
        "渡头杨柳知人意，为惹官船莫放行。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 364380,
      "title": "喜山鹊初归三首",
      "content": [
        "翠衿红觜便知机，久避重罗稳处飞。",
        "只为从来偏护惜，窗前今贺主人归。",
        "山中只是惜珍禽，语不分明识尔心。",
        "若使解言天下事，燕台今筑几千金。",
        "阻他罗网到柴扉，不奈偷仓雀转肥。",
        "赖尔林塘添景趣，剩留山果引教归。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 364381,
      "title": "虞乡北原",
      "content": [
        "泽北村贫烟火狞，稚田冬旱倩牛耕。",
        "老人惆怅逢人诉，开尽黄花麦未金。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 364382,
      "title": "洛中三首",
      "content": [
        "秋风团扇未惊心，笑看妆台落叶侵。",
        "绣凤不教金缕暗，青楼何处有寒砧。",
        "不用频嗟世路难，浮生各自系悲欢。",
        "风霜一夜添羁思，罗绮谁家待早寒。",
        "燕巢空后谁相伴，鸳被缝来不忍熏。",
        "薄命敢辞长滴泪，倡家未必肯留君。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 364383,
      "title": "寓笔",
      "content": [
        "年年镊鬓到花飘，依旧花繁鬓易凋。",
        "撩乱一场人更恨，春风谁道胜轻飙。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
