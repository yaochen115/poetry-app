  "data": [
    {
      "id": 349401,
      "title": "晚泊江口",
      "content": [
        "郡城朝解缆，江岸暮依村。",
        "二女竹上泪，孤臣水底魂。",
        "双双归蛰燕，一一叫群猿。",
        "回首那闻语，空看别袖翻。"
      ],
      "author": {
        "id": 4118,
        "name": "韩愈"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 349404,
      "title": "喜雪献裴尚书",
      "content": [
        "宿云寒不卷，春雪堕如簁。",
        "骋巧先投隙，潜光半入池。",
        "喜深将策试，惊密仰簷窥。",
        "自下何曾污，增高未觉危。",
        "比心明可烛，拂面爱还吹。",
        "妒舞时飘袖，欺梅并压枝。",
        "地空迷界限，砌满接高卑。",
        "浩荡乾坤合，霏微物象移。",
        "为祥矜大熟，布泽荷平施。",
        "已分年华晚，犹怜曙色随。",
        "气严当酒换，洒急听窗知。",
        "照曜临初日，玲珑滴晚澌。",
        "聚庭看岳耸，扫路见云披。",
        "阵势鱼丽远，书文鸟篆奇。",
        "纵欢罗艳黠，列贺拥熊螭。",
        "履敝行偏冷，门扃卧更羸。",
        "悲嘶闻病马，浪走信娇儿。",
        "灶静愁烟绝，丝繁念鬓衰。",
        "拟盐吟旧句，授简慕前规。",
        "捧赠同燕石，多惭失所宜。"
      ],
      "author": {
        "id": 4118,
        "name": "韩愈"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 349405,
      "title": "春雪",
      "content": [
        "看雪乘清旦，无人坐独谣。",
        "拂花轻尚起，落地暖初销。",
        "已讶陵歌扇，还来伴舞腰。",
        "洒篁留密节，著柳送长条。",
        "入镜鸾窥沼，行天马度桥。",
        "遍阶怜可掬，满树戏成摇。",
        "江浪迎涛日，风毛纵猎朝。",
        "弄闲时细转，争急忽惊飘。",
        "城险疑悬布，砧寒未捣绡。",
        "莫愁阴景促，夜色自相饶。"
      ],
      "author": {
        "id": 4118,
        "name": "韩愈"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 349407,
      "title": "春雪间早梅",
      "content": [
        "梅将雪共春，彩艳不相因。",
        "逐吹能争密，排枝巧妒新。",
        "谁令香满座，独使净无尘。",
        "芳意饶呈瑞，寒光助照人。",
        "玲珑开已遍，点缀坐来频。",
        "那是俱疑似，须知两逼真。",
        "荧煌初乱眼，浩荡忽迷神。",
        "未许琼华比，从将玉树亲。",
        "先期迎献岁，更伴占兹晨。",
        "愿得长辉映，轻微敢自珍。"
      ],
      "author": {
        "id": 4118,
        "name": "韩愈"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 349412,
      "title": "木芙蓉",
      "content": [
        "新开寒露丛，远比水间红。",
        "艳色宁相妒，嘉名偶自同。",
        "采江官渡晚，搴木古祠空。",
        "愿得勤来看，无令便逐风。"
      ],
      "author": {
        "id": 4118,
        "name": "韩愈"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 349413,
      "title": "题张十一旅舍三咏：榴花",
      "content": [
        "五月榴花照眼明，枝间时见子初成。",
        "可怜此地无车马，颠倒青苔落绛英。"
      ],
      "author": {
        "id": 4118,
        "name": "韩愈"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 349414,
      "title": "题张十一旅舍三咏：井",
      "content": [
        "贾谊宅中今始见，葛洪山下昔曾窥。",
        "寒泉百尺空看影，正是行人渴死时。"
      ],
      "author": {
        "id": 4118,
        "name": "韩愈"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 349415,
      "title": "题张十一旅舍三咏：蒲萄",
      "content": [
        "新茎未遍半犹枯，高架支离倒复扶。",
        "若欲满盘堆马乳，莫辞添竹引龙须。"
      ],
      "author": {
        "id": 4118,
        "name": "韩愈"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 349416,
      "title": "峡石西泉",
      "content": [
        "居然鳞介不能容，石眼环环水一钟。",
        "闻说旱时求得雨，只疑科斗是蛟龙。"
      ],
      "author": {
        "id": 4118,
        "name": "韩愈"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 349417,
      "title": "梁国惠康公主挽歌二首",
      "content": [
        "定谥芳声远，移封大国新。",
        "巽宫尊长女，台室属良人。",
        "河汉重泉夜，梧桐半树春。",
        "龙輀非厌翟，还辗禁城尘。",
        "秦地吹箫女，湘波鼓瑟妃。",
        "佩兰初应梦，奔月竟沦辉。",
        "夫族迎魂去，宫官会葬归。",
        "从今沁园草，无复更芳菲。"
      ],
      "author": {
        "id": 4118,
        "name": "韩愈"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 349418,
      "title": "和崔舍人咏月二十韵",
      "content": [
        "三秋端正月，今夜出东溟。",
        "对日犹分势，腾天渐吐灵。",
        "未高烝远气，半上霁孤形。",
        "赫奕当躔次，虚徐度杳冥。",
        "长河晴散雾，列宿曙分萤。",
        "浩荡英华溢，萧疏物象泠。",
        "池边临倒照，簷际送横经。",
        "花树参差见，皋禽断续聆。",
        "牖光窥寂寞，砧影伴娉婷。",
        "幽坐看侵户，闲吟爱满庭。",
        "辉斜通壁练，彩碎射沙星。",
        "清洁云间路，空凉水上亭。",
        "净堪分顾兔，细得数飘萍。",
        "山翠相凝绿，林烟共幂青。",
        "过隅惊桂侧，当午觉轮停。",
        "属思摛霞锦，追欢罄缥瓶。",
        "郡楼何处望，陇笛此时听。",
        "右掖连台座，重门限禁扃。",
        "风台观滉漾，冰砌步青荧。",
        "独有虞庠客，无由拾落蓂。"
      ],
      "author": {
        "id": 4118,
        "name": "韩愈"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 349419,
      "title": "咏雪赠张籍",
      "content": [
        "只见纵横落，宁知远近来。",
        "飘飖还自弄，历乱竟谁催。",
        "座暖销那怪，池清失可猜。",
        "坳中初盖底，垤处遂成堆。",
        "慢有先居后，轻多去却回。",
        "度前铺瓦陇，发本积墙隈。",
        "穿细时双透，乘危忽半摧。",
        "舞深逢坎井，集早值层台。",
        "砧练终宜捣，阶纨未暇裁。",
        "城寒装睥睨，树冻裹莓苔。",
        "片片匀如剪，纷纷碎若挼。",
        "定非燖鹄鹭，真是屑琼瑰。",
        "纬繣观朝萼，冥茫瞩晚埃。",
        "当窗恒凛凛，出户即皑皑。",
        "压野荣芝菌，倾都委货财。",
        "娥嬉华荡漾，胥怒浪崔嵬。",
        "碛迥疑浮地，云平想辗雷。",
        "随车翻缟带，逐马散银杯。",
        "万屋漫汗合，千株照曜开。",
        "松篁遭挫抑，粪壤获饶培。",
        "隔绝门庭遽，挤排陛级才。",
        "岂堪裨岳镇，强欲效盐梅。",
        "隐匿瑕疵尽，包罗委琐该。",
        "误鸡宵呃喔，惊雀暗裴回。",
        "浩浩过三暮，悠悠匝九垓。",
        "鲸鲵陆死骨，玉石火炎灰。",
        "厚虑填溟壑，高愁cN斗魁。",
        "日轮埋欲侧，坤轴压将颓。",
        "岸类长蛇搅，陵犹巨象豗。",
        "水官夸杰黠，木气怯胚胎。",
        "著地无由卷，连天不易推。",
        "龙鱼冷蛰苦，虎豹饿号哀。",
        "巧借奢华便，专绳困约灾。",
        "威贪陵布被，光肯离金罍。",
        "赏玩捐他事，歌谣放我才。",
        "狂教诗硉矹，兴与酒陪鳃。",
        "惟子能谙耳，诸人得语哉。",
        "助留风作党，劝坐火为媒。",
        "雕刻文刀利，搜求智网恢。",
        "莫烦相属和，传示及提孩。"
      ],
      "author": {
        "id": 4118,
        "name": "韩愈"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 349422,
      "title": "学诸进士作精卫衔石填海",
      "content": [
        "鸟有偿冤者，终年抱寸诚。",
        "口衔山石细，心望海波平。",
        "渺渺功难见，区区命已轻。",
        "人皆讥造次，我独赏专精。",
        "岂计休无日，惟应尽此生。",
        "何惭刺客传，不著报雠名。"
      ],
      "author": {
        "id": 4118,
        "name": "韩愈"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 349423,
      "title": "奉酬振武胡十二丈大夫",
      "content": [
        "倾朝共羡宠光频，半岁迁腾作虎臣。",
        "戎旆暂停辞社树，",
        "自笑平生夸胆气，不离文字鬓毛新。"
      ],
      "author": {
        "id": 4118,
        "name": "韩愈"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 349424,
      "title": "奉和库部卢四兄曹长元日朝回",
      "content": [
        "天仗宵严建羽旄，春云送色晓鸡号。",
        "金炉香动螭头暗，",
        "太平时节难身遇，郎署何须叹二毛。"
      ],
      "author": {
        "id": 4118,
        "name": "韩愈"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 349425,
      "title": "寒食直归遇雨",
      "content": [
        "寒食时看度，春游事已违。",
        "风光连日直，阴雨半朝归。",
        "不见红球上，那论彩索飞。",
        "惟将新赐火，向曙著朝衣。"
      ],
      "author": {
        "id": 4118,
        "name": "韩愈"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 349427,
      "title": "题百叶桃花",
      "content": [
        "百叶双桃晚更红，窥窗映竹见玲珑。",
        "应知侍史归天上，故伴仙郎宿禁中。"
      ],
      "author": {
        "id": 4118,
        "name": "韩愈"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 349429,
      "title": "戏题牡丹",
      "content": [
        "幸自同开俱隐约，何须相倚斗轻盈。",
        "陵晨并作新妆面，",
        "长年是事皆抛尽，今日栏边暂眼明。"
      ],
      "author": {
        "id": 4118,
        "name": "韩愈"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 349430,
      "title": "盆池五首",
      "content": [
        "老翁真个似童儿，汲水埋盆作小池。",
        "一夜青蛙鸣到晓，恰如方口钓鱼时。",
        "莫道盆池作不成，藕稍初种已齐生。",
        "从今有雨君须记，来听萧萧打叶声。",
        "瓦沼晨朝水自清，小虫无数不知名。",
        "忽然分散无踪影，惟有鱼儿作队行。",
        "泥盆浅小讵成池，夜半青蛙圣得知。",
        "一听暗来将伴侣，不烦鸣唤斗雄雌。",
        "池光天影共青青，拍岸才添水数瓶。",
        "且待夜深明月去，试看涵泳几多星。"
      ],
      "author": {
        "id": 4118,
        "name": "韩愈"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 349431,
      "title": "芍药",
      "content": [
        "浩态狂香昔未逢，红灯烁烁绿盘笼。",
        "觉来独对情惊恐，身在仙宫第几重。"
      ],
      "author": {
        "id": 4118,
        "name": "韩愈"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 349432,
      "title": "奉和虢州刘给事使君三堂新题二十一咏：新亭",
      "content": [
        "湖上新亭好，公来日出初。",
        "水文浮枕簟，瓦影荫龟鱼。"
      ],
      "author": {
        "id": 4118,
        "name": "韩愈"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
