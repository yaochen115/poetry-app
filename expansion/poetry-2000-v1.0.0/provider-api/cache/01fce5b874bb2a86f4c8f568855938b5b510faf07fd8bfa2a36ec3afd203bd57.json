    },
    {
      "id": 349529,
      "title": "和水部张员外宣政衙赐百官樱桃诗",
      "content": [
        "汉家旧种明光殿，炎帝还书本草经。",
        "岂似满朝承雨露，",
        "食罢自知无所报，空然惭汗仰皇扃。"
      ],
      "author": {
        "id": 4118,
        "name": "韩愈"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 349530,
      "title": "早春呈水部张十八员外二首",
      "content": [
        "天街小雨润如酥，草色遥看近却无。",
        "最是一年春好处，绝胜烟柳满皇都。",
        "莫道官忙身老大，即无年少逐春心。",
        "凭君先到江头看，柳色如今深未深。"
      ],
      "author": {
        "id": 4118,
        "name": "韩愈"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 349531,
      "title": "送桂州严大夫同用南字",
      "content": [
        "苍苍森八桂，兹地在湘南。",
        "江作青罗带，山如碧玉𥮾。",
        "户多输翠羽，家自种黄甘。",
        "远胜登仙去，飞鸾不假骖。"
      ],
      "author": {
        "id": 4118,
        "name": "韩愈"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 349533,
      "title": "奉使镇州，行次承天行营，奉酬裴司空",
      "content": [
        "窜逐三年海上归，逢公复此著征衣。",
        "旋吟佳句还鞭马，恨不身先去鸟飞。"
      ],
      "author": {
        "id": 4118,
        "name": "韩愈"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 349535,
      "title": "奉和仆射裴相公感恩言志",
      "content": [
        "文武功成后，居为百辟师。",
        "林园穷胜事，钟鼓乐清时。",
        "摆落遗高论，雕镌出小诗。",
        "自然无不可，范蠡尔其谁。"
      ],
      "author": {
        "id": 4118,
        "name": "韩愈"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 349536,
      "title": "和仆射相公朝回见寄",
      "content": [
        "尽瘁年将久，公今始暂闲。",
        "事随忧共减，诗与酒俱还。",
        "放意机衡外，收身矢石间。",
        "秋台风日迥，正好看前山。"
      ],
      "author": {
        "id": 4118,
        "name": "韩愈"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 349538,
      "title": "奉和杜相公太清宫纪事陈诚上李相公十六韵",
      "content": [
        "耒耜兴姬国，輴欙建夏家。",
        "在功诚可尚，于道讵为华。",
        "象帝威容大，仙宗宝历赊。",
        "卫门罗戟槊，图壁杂龙蛇。",
        "礼乐追尊盛，乾坤降福遐。",
        "四真皆齿列，二圣亦肩差。",
        "阳月时之首，阴泉气未牙。",
        "殿阶铺水碧，庭炬坼金葩。",
        "紫极观忘倦，青词奏不哗。",
        "噌吰宫夜辟，嘈囐鼓晨挝。",
        "亵味陈奚取，名香荐孔嘉。",
        "垂祥纷可录，俾寿浩无涯。",
        "贵相山瞻峻，清文玉绝瑕。",
        "代工声问远，摄事敬恭加。",
        "皎洁当天月，葳蕤捧日霞。",
        "唱妍酬亦丽，俯仰但称嗟。"
      ],
      "author": {
        "id": 4118,
        "name": "韩愈"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 349539,
      "title": "郓州溪堂诗",
      "content": [
        "帝奠九廛，有叶有年。",
        "有荒不条，河岱之间。",
        "及我宪考，",
        "公不饮食，以训以徇。",
        "孰饥无食，孰呻孰叹。",
        "孰冤不问，",
        "吹之喣之，摩手拊之。",
        "箴之石之，膊而磔之。",
        "凡公四封，",
        "公作溪堂。",
        "播播流水。",
        "浅有蒲莲，深有葭苇。",
        "公以宾燕，",
        "既歌以舞，其鼓考考。",
        "公在溪堂，公御琴瑟。",
        "公暨宾赞，",
        "公在中流，右诗左书。",
        "无我斁遗，此邦是庥。"
      ],
      "author": {
        "id": 4118,
        "name": "韩愈"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 349540,
      "title": "送张道士",
      "content": [
        "大匠无弃材，寻尺各有施。",
        "况当营都邑，杞梓用不疑。",
        "张侯嵩高来，面有熊豹姿。",
        "开口论利害，剑锋白差差。",
        "恨无一尺捶，为国苔羌夷。",
        "诣阙三上书，臣非黄冠师。",
        "臣有胆与气，不忍死茅茨。",
        "又不媚笑语，不能伴儿嬉。",
        "乃著道士服，众人莫臣知。",
        "臣有平贼策，狂童不难治。",
        "其言简且要，陛下幸听之。",
        "天空日月高，下照理不遗。",
        "或是章奏繁，裁择未及斯。",
        "宁当不俟报，归袖风披披。",
        "答我事不尔，吾亲属吾思。",
        "昨宵梦倚门，手取连环持。",
        "今日有书至，又言归何时。",
        "霜天熟柿栗，收拾不可迟。",
        "岭北梁可构，寒鱼下清伊。",
        "既非公家用，且复还其私。",
        "从容进退间，无一不合宜。",
        "时有利不利，虽贤欲奚为。",
        "但当励前操，富贵非公谁。"
      ],
      "author": {
        "id": 4118,
        "name": "韩愈"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
