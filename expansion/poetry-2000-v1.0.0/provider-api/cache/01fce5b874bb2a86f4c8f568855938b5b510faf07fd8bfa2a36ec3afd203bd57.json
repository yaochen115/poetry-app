      }
    },
    {
      "id": 349437,
      "title": "奉和虢州刘给事使君三堂新题二十一咏：竹溪",
      "content": [
        "蔼蔼溪流慢，梢梢岸筱长。",
        "穿沙碧簳净，落水紫苞香。"
      ],
      "author": {
        "id": 4118,
        "name": "韩愈"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 349438,
      "title": "奉和虢州刘给事使君三堂新题二十一咏：北湖",
      "content": [
        "闻说游湖棹，寻常到此回。",
        "应留醒心处，准拟醉时来。"
      ],
      "author": {
        "id": 4118,
        "name": "韩愈"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 349439,
      "title": "奉和虢州刘给事使君三堂新题二十一咏：花岛",
      "content": [
        "蜂蝶去纷纷，香风隔岸闻。",
        "欲知花岛处，水上觅红云。"
      ],
      "author": {
        "id": 4118,
        "name": "韩愈"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 349440,
      "title": "奉和虢州刘给事使君三堂新题二十一咏：柳溪",
      "content": [
        "柳树谁人种，行行夹岸高。",
        "莫将条系缆，著处有蝉号。"
      ],
      "author": {
        "id": 4118,
        "name": "韩愈"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 349441,
      "title": "奉和虢州刘给事使君三堂新题二十一咏：西山",
      "content": [
        "新月迎宵挂，晴云到晚留。",
        "为遮西望眼，终是懒回头。"
      ],
      "author": {
        "id": 4118,
        "name": "韩愈"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 349442,
      "title": "奉和虢州刘给事使君三堂新题二十一咏：竹径",
      "content": [
        "无尘从不扫，有鸟莫令弹。",
        "若要添风月，应除数百竿。"
      ],
      "author": {
        "id": 4118,
        "name": "韩愈"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 349443,
      "title": "奉和虢州刘给事使君三堂新题二十一咏：荷池",
      "content": [
        "风雨秋池上，高荷盖水繁。",
        "未谙鸣摵摵，那似卷翻翻。"
      ],
      "author": {
        "id": 4118,
        "name": "韩愈"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 349444,
      "title": "奉和虢州刘给事使君三堂新题二十一咏：稻畦",
      "content": [
        "罫布畦堪数，枝分水莫寻。",
        "鱼肥知已秀，鹤没觉初深。"
      ],
      "author": {
        "id": 4118,
        "name": "韩愈"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 349445,
      "title": "奉和虢州刘给事使君三堂新题二十一咏：柳巷",
      "content": [
        "柳巷还飞絮，春余几许时。",
        "吏人休报事，公作送春诗。"
      ],
      "author": {
        "id": 4118,
        "name": "韩愈"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 349446,
      "title": "奉和虢州刘给事使君三堂新题二十一咏：花源",
      "content": [
        "源上花初发，公应日日来。",
        "丁宁红与紫，慎莫一时开。"
      ],
      "author": {
        "id": 4118,
        "name": "韩愈"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 349447,
      "title": "奉和虢州刘给事使君三堂新题二十一咏：北楼",
      "content": [
        "郡楼乘晓上，尽日不能回。",
        "晚色将秋至，长风送月来。"
      ],
      "author": {
        "id": 4118,
        "name": "韩愈"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 349448,
      "title": "奉和虢州刘给事使君三堂新题二十一咏：镜潭",
      "content": [
        "非铸复非熔，泓澄忽此逢。",
        "鱼虾不用避，只是照蛟龙。"
      ],
      "author": {
        "id": 4118,
        "name": "韩愈"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 349449,
      "title": "奉和虢州刘给事使君三堂新题二十一咏：孤屿",
      "content": [
        "朝游孤屿南，暮戏孤屿北。",
        "所以孤屿鸟，与公尽相识。"
      ],
      "author": {
        "id": 4118,
        "name": "韩愈"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 349450,
      "title": "奉和虢州刘给事使君三堂新题二十一咏：方桥",
      "content": [
        "非阁复非船，可居兼可过。",
        "君欲问方桥，方桥如此作。"
      ],
      "author": {
        "id": 4118,
        "name": "韩愈"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 349451,
      "title": "奉和虢州刘给事使君三堂新题二十一咏：梯桥",
      "content": [
        "乍似上青冥，初疑蹑菡萏。",
        "自无飞仙骨，欲度何由敢。"
      ],
      "author": {
        "id": 4118,
        "name": "韩愈"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 349452,
      "title": "奉和虢州刘给事使君三堂新题二十一咏：月池",
      "content": [
        "寒池月下明，新月池边曲。",
        "若不妒清妍，却成相映烛。"
      ],
      "author": {
        "id": 4118,
        "name": "韩愈"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 349453,
      "title": "游城南十六首：赛神",
      "content": [
        "白布长衫紫领巾，差科未动是闲人。",
        "麦苗含穟桑生葚，共向田头乐社神。"
      ],
      "author": {
        "id": 4118,
        "name": "韩愈"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 349454,
      "title": "游城南十六首：题于宾客庄",
      "content": [
        "榆荚车前盖地皮，蔷薇蘸水笋穿篱。",
        "马蹄无入朱门迹，纵使春归可得知。"
      ],
      "author": {
        "id": 4118,
        "name": "韩愈"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 349455,
      "title": "游城南十六首：晚春",
      "content": [
        "草树知春不久归，百般红紫斗芳菲。",
        "杨花榆荚无才思，惟解漫天作雪飞。"
      ],
      "author": {
        "id": 4118,
        "name": "韩愈"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 349456,
      "title": "游城南十六首：落花",
      "content": [
        "已分将身著地飞，那羞践踏损光晖。",
        "无端又被春风误，吹落西家不得归。"
      ],
      "author": {
        "id": 4118,
        "name": "韩愈"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 349457,
      "title": "游城南十六首：楸树二首",
      "content": [
        "几岁生成为大树，一朝缠绕困长藤。",
        "谁人与脱青罗帔，看吐高花万万层。",
        "幸自枝条能树立，可烦萝蔓作交加。",
        "傍人不解寻根本，却道新花胜旧花。"
      ],
      "author": {
        "id": 4118,
        "name": "韩愈"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 349458,
      "title": "游城南十六首：风折花枝",
      "content": [
        "浮艳侵天难就看，清香扑地只遥闻。",
        "春风也是多情思，故拣繁枝折赠君。"
      ],
      "author": {
        "id": 4118,
        "name": "韩愈"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 349459,
      "title": "游城南十六首：赠同游",
      "content": [
        "唤起窗全曙，催归日未西。",
        "无心花里鸟，更与尽情啼。"
      ],
      "author": {
        "id": 4118,
        "name": "韩愈"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 349460,
      "title": "游城南十六首：赠张十八助教",
      "content": [
        "喜君眸子重清朗，携手城南历旧游。",
        "忽见孟生题竹处，相看泪落不能收。"
      ],
      "author": {
        "id": 4118,
        "name": "韩愈"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 349461,
      "title": "游城南十六首：题韦氏庄",
      "content": [
        "昔者谁能比，今来事不同。",
        "寂寥青草曲，散漫白榆风。",
        "架倒藤全落，篱崩竹半空。",
        "宁须惆怅立，翻覆本无穷。"
      ],
      "author": {
        "id": 4118,
        "name": "韩愈"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 349462,
      "title": "游城南十六首：晚雨",
      "content": [
        "廉纤晚雨不能晴，池岸草间蚯蚓鸣。",
        "投竿跨马蹋归路，才到城门打鼓声。"
      ],
      "author": {
        "id": 4118,
        "name": "韩愈"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 349463,
      "title": "游城南十六首：出城",
      "content": [
        "暂出城门蹋青草，远于林下见春山。",
        "应须韦杜家家到，只有今朝一日闲。"
      ],
      "author": {
        "id": 4118,
        "name": "韩愈"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 349464,
      "title": "游城南十六首：把酒",
      "content": [
        "扰扰驰名者，谁能一日闲。",
        "我来无伴侣，把酒对南山。"
      ],
      "author": {
        "id": 4118,
        "name": "韩愈"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 349465,
      "title": "游城南十六首：嘲少年",
      "content": [
        "直把春偿酒，都将命乞花。",
        "只知闲信马，不觉误随车。"
      ],
      "author": {
        "id": 4118,
        "name": "韩愈"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 349466,
      "title": "游城南十六首：楸树",
      "content": [
        "青幢紫盖立童童，细雨浮烟作彩笼。",
        "不得画师来貌取，定知难见一生中。"
      ],
      "author": {
        "id": 4118,
        "name": "韩愈"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 349467,
      "title": "游城南十六首：遣兴",
      "content": [
        "断送一生惟有酒，寻思百计不如闲。",
        "莫忧世事兼身事，须著人间比梦间。"
      ],
      "author": {
        "id": 4118,
        "name": "韩愈"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 349469,
      "title": "和席八十二韵",
      "content": [
        "绛阙银河曙，东风右掖春。",
        "官随名共美，花与思俱新。",
        "绮陌朝游间，绫衾夜直频。",
        "横门开日月，高阁切星辰。",
        "庭变寒前草，天销霁后尘。",
        "沟声通苑急，柳色压城匀。",
        "纶綍谋猷盛，丹青步武亲。",
        "芳菲含斧藻，光景畅形神。",
        "傍砌看红药，巡池咏白苹。",
        "多情怀酒伴，余事作诗人。",
        "倚玉难藏拙，吹竽久混真。",
        "坐惭空自老，江海未还身。"
      ],
      "author": {
        "id": 4118,
        "name": "韩愈"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 349470,
      "title": "和武相公早春闻莺",
      "content": [
        "早晚飞来入锦城，谁人教解百般鸣。",
        "春风红树惊眠处，似妒歌童作艳声。"
      ],
      "author": {
        "id": 4118,
        "name": "韩愈"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 349472,
      "title": "晚春",
      "content": [
        "谁收春色将归去，慢绿妖红半不存。",
        "榆荚只能随柳絮，等闲撩乱走空园。"
      ],
      "author": {
        "id": 4118,
        "name": "韩愈"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 349473,
      "title": "大行皇太后挽歌词三首",
      "content": [
        "一纪尊名正，三时孝养荣。",
        "高居朝圣主，厚德载群生。",
        "武帐虚中禁，玄堂掩太平。",
        "秋天笳鼓歇，松柏遍山鸣。",
        "威仪备吉凶，文物杂军容。",
        "配地行新祭，因山托故封。",
        "凤飞终不返，剑化会相从。",
        "无复临长乐，空闻报晓钟。",
        "追攀万国来，警卫百神陪。",
        "画翣登秋殿，容衣入夜台。",
        "云随仙驭远，风助圣情哀。",
        "只有朝陵日，妆奁一暂开。"
      ],
      "author": {
        "id": 4118,
        "name": "韩愈"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 349474,
      "title": "广宣上人频见过",
      "content": [
        "三百六旬长扰扰，不冲风雨即尘埃。",
        "久惭朝士无裨补，",
        "天寒古寺游人少，红叶窗前有几堆。"
      ],
      "author": {
        "id": 4118,
        "name": "韩愈"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 349475,
      "title": "闲游二首",
      "content": [
        "雨后来更好，绕池遍青青。",
        "柳花闲度竹，菱叶故穿萍。",
        "独坐殊未厌，孤斟讵能醒。",
        "持竿至日暮，幽咏欲谁听。",
        "兹游苦不数，再到遂经旬。",
        "萍盖污池净，藤笼老树新。",
        "林乌鸣讶客，岸竹长遮邻。",
        "子云只自守，奚事九衢尘。"
      ],
      "author": {
        "id": 4118,
        "name": "韩愈"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 349477,
      "title": "和侯协律咏笋",
      "content": [
        "竹亭人不到，新笋满前轩。",
        "乍出真堪赏，初多未觉烦。",
        "成行齐婢仆，环立比儿孙。",
        "验长常携尺，愁干屡侧盆。",
        "对吟忘膳饮，偶坐变朝昏。",
        "滞雨膏腴湿，骄阳气候温。",
        "得时方张王，挟势欲腾骞。",
        "见角牛羊没，看皮虎豹存。",
        "攒生犹有隙，散布忽无垠。",
        "讵可持筹算，谁能以理言。",
        "纵横公占地，罗列暗连根。",
        "狂剧时穿壁，横强几触藩。",
        "深潜如避逐，远去若追奔。",
        "始讶妨人路，还惊入药园。",
        "萌芽防浸大，覆载莫偏恩。",
        "已复侵危砌，非徒出短垣。",
        "身宁虞瓦砾，计拟掩兰荪。",
        "且叹高无数，庸知上几番。",
        "短长终不校，先后竟谁论。",
        "外恨苞藏密，中仍节目繁。",
        "暂须回步履，要取助盘飧。",
        "穰穰疑翻地，森森竞塞门。",
        "戈矛头戢戢，蛇虺首掀掀。",
        "妇懦咨料拣，儿痴谒尽髡。",
        "侯生来慰我，诗句读惊魂。",
        "属和才将竭，呻吟至日暾。"
      ],
      "author": {
        "id": 4118,
        "name": "韩愈"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 349482,
      "title": "郾城晚饮奉赠副使马侍郎及冯、李二员外",
      "content": [
        "城上赤云呈胜气，眉间黄色见归期。",
        "幕中无事惟须饮，即是连镳向阙时。"
      ],
      "author": {
        "id": 4118,
        "name": "韩愈"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 349483,
      "title": "酬别留后侍郎",
      "content": [
        "为文无出相如右，谋帅难居郤縠先。",
        "归去雪销溱洧动，西来旌旆拂晴天。"
      ],
      "author": {
        "id": 4118,
        "name": "韩愈"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 349485,
      "title": "同李二十八员外从裴相公野宿西界",
      "content": [
        "四面星辰著地明，散烧烟火宿天兵。",
        "不关破贼须归奏，自趁新年贺太平。"
      ],
      "author": {
        "id": 4118,
        "name": "韩愈"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 349487,
      "title": "宿神龟招李二十八冯十七",
      "content": [
        "荒山野水照斜晖，啄雪寒鸦趁始飞。",
        "夜宿驿亭愁不睡，幸来相就盖征衣。"
      ],
      "author": {
        "id": 4118,
        "name": "韩愈"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 349489,
      "title": "和李司勋过连昌宫",
      "content": [
        "夹道疏槐出老根，高甍巨桷压山原。",
        "宫前遗老来相问，今是开元几叶孙。"
      ],
      "author": {
        "id": 4118,
        "name": "韩愈"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 349490,
      "title": "次潼关先寄张十二阁老使君",
      "content": [
        "荆山已去华山来，日出潼关四扇开。",
        "刺史莫辞迎候远，相公亲破蔡州回。"
      ],
      "author": {
        "id": 4118,
        "name": "韩愈"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 349493,
      "title": "送李员外院长分司东都",
      "content": [
        "去年秋露下，羁旅逐东征。",
        "今岁春光动，驱驰别上京。",
        "饮中相顾色，送后独归情。",
        "两地无千里，因风数寄声。"
      ],
      "author": {
        "id": 4118,
        "name": "韩愈"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 349494,
      "title": "晋公破贼回重拜台司，以诗示幕中宾客，愈奉和",
      "content": [
        "南伐旋师太华东，天书夜到册元功。",
        "将军旧压三司贵，",
        "长惭典午非材职，得就闲官即至公。"
      ],
      "author": {
        "id": 4118,
        "name": "韩愈"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 349495,
      "title": "独钓四首",
      "content": [
        "侯家林馆胜，偶入得垂竿。",
        "曲树行藤角，平池散芡盘。",
        "羽沈知食驶，缗细觉牵难。",
        "聊取夸儿女，榆条系从鞍。",
        "一径向池斜，池塘野草花。",
        "雨多添柳耳，水长减蒲芽。",
        "坐厌亲刑柄，偷来傍钓车。",
        "太平公事少，吏隐讵相赊。",
        "独往南塘上，秋晨景气醒。",
        "露排四岸草，风约半池萍。",
        "鸟下见人寂，鱼来闻饵馨。",
        "所嗟无可召，不得倒吾瓶。",
        "秋半百物变，溪鱼去不来。",
        "风能坼芡觜，露亦染梨腮。",
        "远岫重叠出，寒花散乱开。",
        "所期终莫至，日暮与谁回。"
      ],
      "author": {
        "id": 4118,
        "name": "韩愈"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 349499,
      "title": "祖席前字",
      "content": [
        "祖席洛桥边，亲交共黯然。",
        "野晴山簇簇，霜晓菊鲜鲜。",
        "书寄相思处，杯衔欲别前。",
        "淮阳知不薄，终愿早回船。"
      ],
      "author": {
        "id": 4118,
        "name": "韩愈"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 349500,
      "title": "秋字",
      "content": [
        "淮南悲木落，而我亦伤秋。",
        "况与故人别，那堪羁宦愁。",
        "荣华今异路，风雨昔同忧。",
        "莫以宜春远，江山多胜游。"
      ],
      "author": {
        "id": 4118,
        "name": "韩愈"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 349501,
      "title": "送郑尚书赴南海",
      "content": [
        "番禺军府盛，欲说暂停杯。",
        "盖海旗幢出，连天观阁开。",
        "衙时龙户集，上日马人来。",
        "风静鶢鶋去，官廉蚌蛤回。",
        "货通师子国，乐奏武王台。",
        "事事皆殊异，无嫌屈大才。"
      ],
      "author": {
        "id": 4118,
        "name": "韩愈"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 349502,
      "title": "答道士寄树鸡",
      "content": [
        "软湿青黄状可猜，欲烹还唤木盘回。",
        "烦君自入华阳洞，直割乖龙左耳来。"
      ],
      "author": {
        "id": 4118,
        "name": "韩愈"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 349503,
      "title": "左迁至蓝关示侄孙湘",
      "content": [
        "一封朝奏九重天，夕贬潮州路八千。",
        "欲为圣朝除弊事，",
        "知汝远来应有意，好收吾骨瘴江边。"
      ],
      "author": {
        "id": 4118,
        "name": "韩愈"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 349504,
      "title": "武关西逢配流吐番",
      "content": [
        "嗟尔戎人莫惨然，湖南地近保生全。",
        "我今罪重无归望，直去长安路八千。"
      ],
      "author": {
        "id": 4118,
        "name": "韩愈"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 349505,
      "title": "次邓州界",
      "content": [
        "潮阳南去倍长沙，恋阙那堪又忆家。",
        "心讶愁来惟贮火，",
        "早晚王师收海岳，普将雷雨发萌芽。"
      ],
      "author": {
        "id": 4118,
        "name": "韩愈"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 349507,
      "title": "晚次宣溪，辱韶州张端公使君惠书叙别酬以绝句二章",
      "content": [
        "韶州南去接宣溪，云水苍茫日向西。",
        "客泪数行先自落，鹧鸪休傍耳边啼。",
        "兼金那足比清文，百首相随愧使君。",
        "俱是岭南巡管内，莫欺荒僻断知闻。"
      ],
      "author": {
        "id": 4118,
        "name": "韩愈"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 349511,
      "title": "韶州留别张端公使君",
      "content": [
        "来往再逢梅柳新，别离一醉绮罗春。",
        "久钦江总文才妙，",
        "已知奏课当征拜，那复淹留咏白苹。"
      ],
      "author": {
        "id": 4118,
        "name": "韩愈"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 349512,
      "title": "从潮州量移袁州，张韶州端公以诗相贺，因酬之",
      "content": [
        "明时远逐事何如，遇赦移官罪未除。",
        "北望讵令随塞雁，",
        "暂欲系船韶石下，上宾虞舜整冠裾。"
      ],
      "author": {
        "id": 4118,
        "name": "韩愈"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 349513,
      "title": "次石头驿寄江西王十中丞阁老",
      "content": [
        "凭高试回首，一望豫章城。",
        "人由恋德泣，马亦别群鸣。",
        "寒日夕始照，风江远渐平。",
        "默然都不语，应识此时情。"
      ],
      "author": {
        "id": 4118,
        "name": "韩愈"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 349515,
      "title": "自袁州还京行次安陆，先寄随州周员外",
      "content": [
        "行行指汉东，暂喜笑言同。",
        "雨雪离江上，蒹葭出梦中。",
        "面犹含瘴色，眼已见华风。",
        "岁暮难相值，酣歌未可终。"
      ],
      "author": {
        "id": 4118,
        "name": "韩愈"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 349518,
      "title": "酒中留上襄阳李相公",
      "content": [
        "浊水污泥清路尘，还曾同制掌丝纶。",
        "眼穿长讶双鱼断，",
        "知公不久归钧轴，应许闲官寄病身。"
      ],
      "author": {
        "id": 4118,
        "name": "韩愈"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 349519,
      "title": "去岁自刑部侍郎以罪贬潮州刺史乘驿赴任其后家亦谴逐小女道死殡之层峰驿旁山下蒙恩还朝过其墓留题驿梁",
      "content": [
        "数条藤束木皮棺，草殡荒山白骨寒。",
        "惊恐入心身已病，",
        "致汝无辜由我罪，百年惭痛泪阑干。"
      ],
      "author": {
        "id": 4118,
        "name": "韩愈"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 349520,
      "title": "贺张十八秘书得裴司空马",
      "content": [
        "司空远寄养初成，毛色桃花眼镜明。",
        "落日已曾交辔语，",
        "旦夕公归伸拜谢，免劳骑去逐双旌。"
      ],
      "author": {
        "id": 4118,
        "name": "韩愈"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 349522,
      "title": "雨中寄张博士籍、侯主簿喜",
      "content": [
        "放朝还不报，半路蹋泥归。",
        "雨惯曾无节，雷频自失威。",
        "见墙生菌遍，忧麦作蛾飞。",
        "岁晚偏萧索，谁当救晋饥。"
      ],
      "author": {
        "id": 4118,
        "name": "韩愈"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 349523,
      "title": "奉和兵部张侍郎酬，郓州马尚书祗召途中见寄开缄之日马帅已再领郓州之作",
      "content": [
        "来朝当路日，承诏改辕时。",
        "再领须句国，仍迁少昊司。",
        "暖风抽宿麦，清雨卷归旗。",
        "赖寄新珠玉，长吟慰我思。"
      ],
      "author": {
        "id": 4118,
        "name": "韩愈"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 349525,
      "title": "奉使常山，早次太原，呈副使吴郎中",
      "content": [
        "朗朗闻街鼓，晨起似朝时。",
        "翻翻走驿马，春尽是归期。",
        "地失嘉禾处，风存蟋蟀辞。",
        "暮齿良多感，无事涕垂颐。"
      ],
      "author": {
        "id": 4118,
        "name": "韩愈"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 349528,
      "title": "同水部张员外籍曲江春游，寄白二十二舍人",
      "content": [
        "漠漠轻阴晚自开，青天白日映楼台。",
        "曲江水满花千树，有底忙时不肯来。"
      ],
      "author": {
        "id": 4118,
        "name": "韩愈"
      },
      "dynasty": {
