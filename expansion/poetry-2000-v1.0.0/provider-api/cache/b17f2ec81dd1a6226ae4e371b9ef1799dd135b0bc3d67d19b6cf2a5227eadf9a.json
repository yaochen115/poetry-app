{
  "data": [
    {
      "id": 285841,
      "title": "投时相十韵",
      "content": [
        "何以保孤危，操修自不知。",
        "众中常杜口，梦里亦吟诗。",
        "失计辞山早，非才得仕迟。",
        "薄冰安可履，暗室岂能欺。",
        "勤苦流萤信，吁嗟宿燕知。",
        "残钟残漏晓，落叶落花时。",
        "故旧寒门少，文章外族衰。",
        "此生多𫐘轲，半世足漂离。",
        "省署随清品，渔舟爽素期。",
        "恋恩休未遂，双鬓渐成丝。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 285842,
      "title": "喜秀上人相访",
      "content": [
        "雪初开一径，师忽扣双扉。",
        "老大情相近，林泉约共归。",
        "忧荣栖省署，孤僻谢朝衣。",
        "他夜松堂宿，论诗更入微。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 285843,
      "title": "夕阳",
      "content": [
        "夕阳秋更好，敛敛蕙兰中。",
        "极浦明残雨，长天急远鸿。",
        "僧窗留半榻，渔舸透疎篷。",
        "莫恨清光尽，寒蟾即照空。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 285844,
      "title": "摇落",
      "content": [
        "夜来摇落悲，桑枣半空枝。",
        "故国无消息，流年有乱离。",
        "霜秦闻雁早，烟渭认帆迟。",
        "日暮寒鼙急，边军在雍岐。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 285845,
      "title": "西蜀净众寺松溪八韵兼寄小笔崔处士",
      "content": [
        "松因溪得名，溪吹荅松声。",
        "缭绕能穿寺，幽奇不在城。",
        "寒烟斋后散，春雨夜中平。",
        "染岸苍苔古，翘沙白鸟明。",
        "澄分僧影瘦，光彻客心清。",
        "带梵侵云响，和钟击石鸣。",
        "澹烹新茗爽，暖泛落花轻。",
        "此景吟难尽，凭君画入京。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 285846,
      "title": "迁客",
      "content": [
        "离夜闻横笛，可堪吹鹧鸪。",
        "雪冤知早晚，雨泣渡江湖。",
        "秋树吹黄叶，腊烟垂绿芜。",
        "虞飜归有日，莫便哭穷途。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 285847,
      "title": "蔡处士",
      "content": [
        "无著复无求，平生不解愁。",
        "鬻蔬贫洁净，中酒病风流。",
        "旨趣陶山相，诗篇沈隐侯。",
        "小斋江色里，篱柱系渔舟。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 285848,
      "title": "予尝有雪景一绝为人所讽吟段赞善小笔精微忽为图画以诗谢之",
      "content": [
        "赞善贤相后，家藏名画多。",
        "留心于绘素，得事在烟波。",
        "属兴同吟咏，成功更琢磨。",
        "爱予风雪句，幽绝写渔蓑。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 285849,
      "title": "京兆府试残月如新月",
      "content": [
        "荣落何相似，初终却一般。",
        "犹疑和夕照，谁信堕朝寒。",
        "水木辉华别，诗家比象难。",
        "佳人应误拜，栖鸟反求安。",
        "屈指期轮满，何心谓影残。",
        "庾楼清赏处，吟彻曙钟看。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 285850,
      "title": "咸通十四年府试木向荣",
      "content": [
        "园林青气动，众木散寒声。",
        "败叶墙阴在，滋条雪后荣。",
        "欣欣春令早，蔼蔼日华轻。",
        "庾岭梅先觉，隋堤柳暗惊。",
        "山川应物候，臯壤起农情。",
        "秪待花开日，连栖出谷莺。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 285851,
      "title": "丞相孟夏祗荐南郊纪献十韵",
      "content": [
        "节应清和候，郊宫事洁羞。",
        "至诚闻上帝，明德祀圆丘。",
        "雅用陶匏器，馨非黍稷流。",
        "就阳陈盛礼，匡国祷鸿休。",
        "渐晓兰迎露，微凉麦弄秋。",
        "寿山横紫阁，瑞霭抱皇州。",
        "外肃通班序，中严锡庆优。",
        "奏歌三酒备，表敬百神柔。",
        "池碧将还凤，原清再问牛。",
        "万方瞻辅翼，共贺赞皇猷。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 285852,
      "title": "叙事感恩上狄右丞",
      "content": [
        "昔岁曾投贽，关河在左冯。",
        "庾公垂顾遇，王粲许从容。",
        "首荐叨殊礼，全家寓近封。",
        "白楼陪写望，青眼感遭逢。",
        "顾念梁间燕，深怜涧底松。",
        "岚光莲岳逼，酒味菊花浓。",
        "寇难旋移国，漂离几听蛩。",
        "半生悲逆旅，二纪间门墉。",
        "蜀雪随僧蹋，荆烟逐雁冲。",
        "凋零归两鬓，举止失前踪。",
        "得事虽甘晚，陈诗未肯慵。",
        "迩来趋九仞，又伴赏三峰。",
        "栖托情何限，吹嘘意数重。",
        "自兹俦侣内，无复叹龙钟。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 285853,
      "title": "咏怀",
      "content": [
        "迂疎虽可欺，心路甚男儿。",
        "薄宦浑无味，平生粗有诗。",
        "澹交终不破，孤达晚相宜。",
        "直夜花前唤，朝寒雪里追。",
        "竹声输我听，茶格共僧知。",
        "景物还多感，情怀偶不卑。",
        "溪莺喧午寝，山蕨止春饥。",
        "险事销肠酒，清欢敌手棋。",
        "香锄抛药圃，烟艇忆莎陂。",
        "自许亨途在，儒纲复振时。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 285854,
      "title": "干符丙申岁奉试春涨曲江池",
      "content": [
        "王泽尚通津，恩波此日新。",
        "深疑一夜雨，宛似五湖春。",
        "泛滟翘振鹭，澄清跃紫鳞。",
        "翠低孤屿柳，香失半汀苹。",
        "凤辇寻佳境，龙舟命近臣。",
        "桂花如入手，愿作从游人。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 285855,
      "title": "华山",
      "content": [
        "峭仞耸巍巍，晴岚染近畿。",
        "孤高不可状，图写尽应非。",
        "绝顶神仙会，半空鸾鹤归。",
        "云台分远霭，树谷隐斜晖。",
        "坠石连村响，狂雷发庙威。",
        "气中寒渭阔，影外白楼微。",
        "云对莲花落，泉横露掌飞。",
        "乳悬危磴滑，樵彻上方稀。",
        "澹泊生真趣，逍遥息世机。",
        "野花明涧路，春藓涩松围。",
        "远洞时闻磬，群僧昼掩扉。",
        "他年洗尘骨，香火愿相依。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 285856,
      "title": "入阁",
      "content": [
        "秘殿临轩日，和銮返正年。",
        "两班文武盛，百辟羽仪全。",
        "霜漏清中禁，风旗拂曙天。",
        "门严新勘契，仗入乍承宣。",
        "玉几当红旭，金𬬻纵碧烟。",
        "对扬称法吏，赞引出宫钿。",
        "言动挥毫疾，雍容执簿专。",
        "寿山晴叆叇，颢气暖连延。",
        "礼有鸳鸾集，恩无雨露偏。",
        "小臣叨备位，歌咏泰阶前。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 285857,
      "title": "故少师从翁隐岩别墅乱后榛芜感旧怆怀遂有追纪",
      "content": [
        "风骚为主人，凡俗仰清尘。",
        "密行称闺阃，明诚动搢绅。",
        "周旋居显重，内外掌丝纶。",
        "妙主蓬壶籍，忠为社稷臣。",
        "大仪墙仞峻，东辖纪纲新。",
        "闻善常开口，推公岂为身。",
        "立朝鸣珮重，归宅典衣贫。",
        "半醉看花晚，中餐煮菜春。",
        "晴台随鹿上，幽墅结僧邻。",
        "理论知清越，生徒得李频。",
        "药香沾笔砚，竹色染衣巾。",
        "寄鹤眠云叟，骑驴入室宾。",
        "近将姚监比，僻与段卿亲。",
        "叶积池边路，茶迟雪后薪。",
        "所难留著述，谁不秉陶钧。",
        "丧乱时多变，追思事已陈。",
        "浮华重发作，雅正甚湮沦。",
        "宗从今何在，依栖素有因。",
        "七松无影响，双泪益悲辛。",
        "犹喜于门秀，年来屈复伸。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 285858,
      "title": "送吏部曹郎中免官南归",
      "content": [
        "高名向已求，古韵古无俦。",
        "风月抛兰省，江山复桂州。",
        "贤人知止足，中岁便归休。",
        "云鹤深相待，公卿不易留。",
        "满朝张祖席，半路上仙舟。",
        "箧重藏吴画，茶新换越瓯。",
        "郡迎红烛宴，寺宿翠岚楼。",
        "触目成幽兴，全家是胜游。",
        "篷声渔叟雨，苇色鹭鸶秋。",
        "久别郊园改，将归里巷修。",
        "桑麻胜禄食，节序免乡愁。",
        "阳朔花迎櫂，崇贤叶满沟。",
        "席春欢促膝，簷日暖梳头。",
        "道畅应为蝶，时来必问牛。",
        "终须康庶品，未爽漱寒流。",
        "议在归群望，情难恋自由。",
        "小生诚浅拙，早岁便依投。",
        "夏课每垂奖，雪天常见忧。",
        "远招陪宿直，首荐向公侯。",
        "攀送偏挥洒，龙钟志未酬。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 285859,
      "title": "回銮",
      "content": [
        "妖星沈雨露，和气满京关。",
        "上将忠勋立，明君法驾还。",
        "顺风调雅乐，夹道序群班。",
        "香泛传宣里，尘清指顾间。",
        "楼台新紫气，云物旧黄山。",
        "晓渭行朝肃，秋郊旷望闲。",
        "庙灵安国步，日角动天颜。",
        "浩浩升平曲，流歌彻百蛮。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 285860,
      "title": "峡中",
      "content": [
        "万重烟霭里，隐隐见夔州。",
        "夜静明月峡，春寒堆雪楼。",
        "独吟谁会解，多病自淹留。",
        "往事如今日，聊同子美愁。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 285861,
      "title": "蜀中寓止夏日自贻",
      "content": [
        "展转攲孤枕，风帏信寂寥。",
        "涨江垂䗖蝀，骤雨闹芭蕉。",
        "道阻归期晚，年加记性销。",
        "故人衰飒尽，相望在行朝。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 285862,
      "title": "试笔偶书",
      "content": [
        "沙鸟与山麋，由来性不羁。",
        "可凭唯在道，难解莫过诗。",
        "任笑孤吟僻，终嫌巧宦卑。",
        "秉慵恩地恕，冷澹好僧知。",
        "华省慙公器，沧江负钓师。",
        "露花春直夜，烟鼓早朝时。",
        "世路多艰梗，家风免坠遗。",
        "殷勤一蓑雨，秪得梦中披。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 285863,
      "title": "奔避",
      "content": [
        "奔避投人远，漂离易感恩。",
        "愁髯霜飒飒，病眼泪昏昏。",
        "孤馆秋声树，寒江落照村。",
        "更闻归路绝，新寨截荆门。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 285864,
      "title": "吊水部贾员外嵩",
      "content": [
        "八韵与五字，俱为时所先。",
        "幽魂应自慰，李白墓相连。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 285865,
      "title": "贫女吟",
      "content": [
        "尘压鸳鸯废锦机，满头空插丽春枝。",
        "东邻舞妓多金翠，笑翦灯花学画眉。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 285866,
      "title": "席上贻歌者",
      "content": [
        "花月楼台近九衢，清歌一曲倒金壶。",
        "座中亦有江南客，莫向春风唱鹧鸪。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 285867,
      "title": "菊",
      "content": [
        "王孙莫把比荆蒿，九日枝枝近鬓毛。",
        "露湿秋香满池岸，由来不羡瓦松高。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 285868,
      "title": "下峡",
      "content": [
        "忆子啼猨绕树哀，雨随孤櫂过阳台。",
        "波头未白人头白，瞥见春风滟滪堆。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 285869,
      "title": "文昌寓直",
      "content": [
        "何逊空堦夜雨平，朝来交直雨新晴。",
        "落花乱上花塼上，不忍和苔蹋紫英。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 285870,
      "title": "街西晚归",
      "content": [
        "御沟春水绕闲坊，信马归来傍短墙。",
        "幽榭名园临紫陌，晚风时带牡丹香。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 285871,
      "title": "十日菊",
      "content": [
        "节去蜂愁蝶不知，晓庭还绕折残枝。",
        "自缘今日人心别，未必秋香一夜衰。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 285872,
      "title": "鹭鸶",
      "content": [
        "闲立春塘烟澹澹，静眠寒苇雨飕飕。",
        "渔翁归后汀沙晚，飞下滩头更自由。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 285873,
      "title": "柳",
      "content": [
        "半烟半雨江桥畔，暎杏映桃山路中。",
        "会得离人无限意，千丝万絮惹春风。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 285874,
      "title": "下第退居二首 一",
      "content": [
        "年来还未上丹梯，且著渔蓑谢故溪。",
        "落尽梨花春又了，破篱残雨晚莺啼。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 285875,
      "title": "下第退居二首 二",
      "content": [
        "未尝青杏出长安，豪士应疑怕牡丹。",
        "秪有退耕耕不得，茫然村落水吹残。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 285876,
      "title": "江宿闻芦管",
      "content": [
        "塞曲凄清楚水滨，声声吹出落梅春。",
        "须知风月千樯下，亦有葫芦河畔人。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 285877,
      "title": "闲题",
      "content": [
        "举世何人肯自知，须逢精鉴定妍媸。",
        "若教嫫母临明镜，也道不劳红粉施。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 285878,
      "title": "曲江春草",
      "content": [
        "花落江堤蔟暖烟，雨余草色远相连。",
        "香轮莫辗青青破，留与愁人一醉眠。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 285879,
      "title": "雪中偶题",
      "content": [
        "乱飘僧舍茶烟湿，密洒歌楼酒力微。",
        "江上晚来堪画处，渔人披得一蓑归。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 285880,
      "title": "题慈恩寺默公院",
      "content": [
        "虽近曲江居古寺，旧山终忆九华峰。",
        "春来老病厌迎送，翦却牡丹栽野松。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 285881,
      "title": "江上阻风",
      "content": [
        "水天春暗暮寒浓，船闭篷窗细雨中。",
        "闲道渔家酒初熟，夜来翻喜打头风。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 285882,
      "title": "淮上与友人别",
      "content": [
        "扬子江头杨柳春，杨花愁杀渡江人。",
        "数声风笛离亭晚，君向潇湘我向秦。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 285883,
      "title": "忍公小轩二首 一",
      "content": [
        "松溪水色绿于松，每到松溪到暮钟。",
        "闲得心源秪如此，问禅何必向双峰。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 285884,
      "title": "忍公小轩二首 二",
      "content": [
        "旧游前事半埃尘，多向林中结净因。",
        "一念一炉香火里，后身唯愿似师身。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 285885,
      "title": "淮上渔者",
      "content": [
        "白头波上白头翁，家逐船移浦浦风。",
        "一尺鲈鱼新钓得，儿孙吹火荻花中。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 285886,
      "title": "兴州江馆",
      "content": [
        "向蜀还秦计未成，寒蛩一夜绕床鸣。",
        "愁眠不稳孤灯尽，坐听嘉陵江水声。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 285887,
      "title": "题无本上人小斋",
      "content": [
        "寒寺唯应我访师，人稀境静雪销迟。",
        "竹西落照侵窗好，堪惜归时落照时。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 285888,
      "title": "七祖院小山",
      "content": [
        "小巧功成雨藓斑，轩车日日扣松关。",
        "峨嵋咫尺无人去，却向僧窗看假山。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 285889,
      "title": "定水寺行香",
      "content": [
        "听经看画绕虚廊，风拂金𬬻待赐香。",
        "丞相未来春雪密，暂偷闲卧老僧床。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 285890,
      "title": "浯溪",
      "content": [
        "湛湛清江叠叠山，白云白鸟在其间。",
        "渔翁醉睡又醒睡，谁道皇天最惜闲。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 285891,
      "title": "闷题",
      "content": [
        "莫厌九衢尘土间，秋晴满眼是南山。",
        "僧家未必全无事，道著访僧心且闲。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 285892,
      "title": "重访黄神谷策禅者",
      "content": [
        "初尘芸阁辞禅阁，却访支郎是老郎。",
        "我趣转卑师趣静，数峰秋雪一𬬻香。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 285893,
      "title": "别修觉寺无本上人",
      "content": [
        "松上闲云石上苔，自嫌归去夕阳催。",
        "山门握手无他语，秪约今冬看雪来。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 285894,
      "title": "赠日东鉴禅师",
      "content": [
        "故国无心渡海潮，老禅方丈倚中条。",
        "夜深雨绝松堂静，一点山萤照寂寥。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 285895,
      "title": "传经院壁画松",
      "content": [
        "危根瘦尽耸孤峰，珍重江僧好笔踪。",
        "得向游人多处画，却胜涧底作真松。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 285896,
      "title": "高蟾先辈以诗笔相示抒成寄酬",
      "content": [
        "张生故国三千里，知者唯应杜紫微。",
        "君有君恩秋后叶，可能更羡谢玄晖。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 285897,
      "title": "为人题",
      "content": [
        "泪湿孤鸾晓镜昏，近来方解惜青春。",
        "杏花杨柳年年好，不忍回看旧写真。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 285898,
      "title": "越鸟",
      "content": [
        "背霜南雁不到处，倚櫂北人初听时。",
        "梅雨满江春草歇，一声声在荔枝枝。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 285899,
      "title": "黄莺",
      "content": [
        "春云薄薄日辉辉，宫树烟深隔水飞。",
        "应为能歌系仙籍，麻姑乞与女真衣。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 285900,
      "title": "失鹭鸶",
      "content": [
        "野格由来倦小池，惊飞却下碧江涯。",
        "月昏风急何处宿，秋岸萧萧黄苇枝。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 285901,
      "title": "苔钱",
      "content": [
        "春红秋紫绕池台，个个圆如济世财。",
        "雨后无端满穷巷，买花不得买愁来。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 285902,
      "title": "莲叶",
      "content": [
        "移舟水溅差差绿，倚槛风摇柄柄香。",
        "多谢浣溪人不折，雨中留得盖鸳鸯。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 285903,
      "title": "蜀中赏海棠",
      "content": [
        "浓澹芳春满蜀乡，半随风雨断莺肠。",
        "浣花溪上堪惆怅，子美无心为发扬。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 285904,
      "title": "投所知",
      "content": [
        "砌下芝兰新满径，门前桃李旧垂阴。",
        "却应回念江边草，放出春烟一寸心。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 285905,
      "title": "早入谏院二首 一",
      "content": [
        "玉阶春冷未催班，暂拂尘衣就笏眠。",
        "孤立小心还自笑，梦魂潜绕御𬬻烟。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 285906,
      "title": "早入谏院二首 二",
      "content": [
        "紫云重叠抱春城，廊下人稀唱漏声。",
        "偷得微吟斜倚柱，满衣花露听宫莺。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 285907,
      "title": "忝官谏垣明日转对",
      "content": [
        "吾君英睿相君贤，其那寰区未晏然。",
        "明日翠华春殿下，不知何语可闻天。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 285908,
      "title": "再经南阳",
      "content": [
        "平芜漠漠失楼台，昔日游人乱后来。",
        "寥落墙匡春欲暮，烧残宫树有花开。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 285909,
      "title": "赠下第举公",
      "content": [
        "见君失意我惆怅，记得当年落第情。",
        "出去无憀归又闷，花南慢打讲钟声。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 285910,
      "title": "春阴",
      "content": [
        "推琴当酒度春阴，不解谋生秪解吟。",
        "舞蝶歌莺莫相试，老郎心是老僧心。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 285911,
      "title": "送张逸人",
      "content": [
        "人间疎散更无人，浪兀孤舟酒兀身。",
        "芦笋鲈鱼抛不得，五陵珍重五湖春。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 285912,
      "title": "初还京师寓止府署偶题屋壁",
      "content": [
        "秋光不见旧亭台，四顾荒凉瓦砾堆。",
        "火力不能销地力，乱前黄菊眼前开。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 285913,
      "title": "擢第后入蜀经罗村路见海棠盛开偶有题咏",
      "content": [
        "上国休夸红杏𦫢，深溪自照绿苔矶。",
        "一枝低带流莺睡，数片狂和舞蝶飞。",
        "堪恨路长移不得，可无人与画将归。",
        "手中已有新春桂，多谢烟香更入衣。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285914,
      "title": "次韵和礼部卢侍郎江上秋夕寓怀",
      "content": [
        "卢郎到处觉风生，蜀郡留连亚相情。",
        "乱后江山悲庾信，夜来烟月属袁宏。",
        "梦归兰省寒星动，吟向莎洲宿鹭惊。",
        "未脱白衣头半白，叨陪属和倍为荣。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285915,
      "title": "宜春再访芳公言公幽斋写怀叙事因赋长言",
      "content": [
        "入门长恐先师在，香印纱灯似昔年。",
        "涧路萦回斋处远，松堂虚豁讲声圆。",
        "顷为弟子曾同社，今忝星郎更契缘。",
        "顾渚一瓯春有味，中林话旧亦潸然。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285916,
      "title": "读李白集",
      "content": [
        "何事文星与酒星，一时钟在李先生。",
        "高吟大醉三千首，留著人间伴月明。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 285917,
      "title": "卷末偶题三首 一",
      "content": [
        "一卷疎芜一百篇，名成未敢暂忘筌。",
        "何如海日生残夜，一句能令万古传。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 285918,
      "title": "卷末偶题三首 二",
      "content": [
        "七岁侍行湖外去，岳阳楼上敢题诗。",
        "如今寒晚无功业，何以胜任国士知。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 285919,
      "title": "卷末偶题三首 三",
      "content": [
        "一第由来是出身，垂名俱为国风陈。",
        "此生若不知骚雅，孤宦如何作近臣。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 285920,
      "title": "读前集二首 一",
      "content": [
        "殷璠裁鉴英灵集，颇觉同才得旨深。",
        "何事后来高仲武，品题间气未公心。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 285921,
      "title": "读前集二首 二",
      "content": [
        "风骚如线不胜悲，国步多艰即此时。",
        "爱日满堦看古集，秪应陶集是吾师。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 285922,
      "title": "渚宫乱后作",
      "content": [
        "乡人来话乱离情，泪滴残阳问紫荆。",
        "白社已应无故老，清江依旧绕空城。",
        "高秋军旅齐山树，昔日渔家是野营。",
        "牢落故居灰烬后，黄花紫蔓上墙生。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285923,
      "title": "鹧鸪",
      "content": [
        "暖戏烟芜锦翼齐，品流应得近山鸡。",
        "雨昏青草湖边过，花落黄陵庙里啼。",
        "游子乍闻征袖湿，佳人才唱翠眉低。",
        "相呼相应湘江阔，苦竹丛深春日西。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285924,
      "title": "燕",
      "content": [
        "年去年来来去忙，春寒烟暝渡潇湘。",
        "低飞绿岸和梅雨，乱入红楼拣杏梁。",
        "闲几砚中窥水浅，落花径里得泥香。",
        "千言万语无人会，又逐流莺过短墙。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285925,
      "title": "侯家鹧鸪",
      "content": [
        "江天梅雨湿江蓠，到处烟香是此时。",
        "苦竹岭无归去日，海棠花落旧栖枝。",
        "春宵思极兰灯暗，晓月啼多锦幕垂。",
        "唯有佳人忆南国，殷勤为尔唱愁词。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285926,
      "title": "雁",
      "content": [
        "八月悲风九月霜，蓼花红澹苇条黄。",
        "石头城下波摇影，星子湾西云间行。",
        "惊散渔家吹短笛，失群征戍锁残阳。",
        "故乡闻尔亦惆怅，何况扁舟非故乡。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285927,
      "title": "水",
      "content": [
        "竹院松廊分数派，不空清泚亦逶迤。",
        "落花相逐去何处，幽鹭独来无限时。",
        "洗钵老僧临岸久，钓鱼闲客卷纶迟。",
        "晚晴一片连莎绿，悔与沧浪有旧期。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285928,
      "title": "海棠",
      "content": [
        "春风用意匀颜色，销得携觞与赋诗。",
        "秾丽最宜新著雨，娇饶全在欲开时。",
        "莫愁粉黛临窗嬾，梁广丹青点笔迟。",
        "朝醉暮吟看不足，羡他蝴蝶宿深枝。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285929,
      "title": "竹",
      "content": [
        "宜烟宜雨又宜风，拂水藏村复间松。",
        "移得萧骚从远寺，洗来疎净见前峰。",
        "侵堦藓拆春芽迸，绕径莎微夏荫浓。",
        "无赖杏花多意绪，数枝穿翠好相容。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285930,
      "title": "荔枝树",
      "content": [
        "二京曾见画图中，数本芳菲色不同。",
        "孤櫂今来巴徼外，一枝烟雨思无穷。",
        "夜郎城近含香瘴，杜宇巢低起暝风。",
        "肠断渝泸霜霰薄，不教叶似灞陵红。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285931,
      "title": "锦二首 一",
      "content": [
        "布素豪家定不看，若无文彩入时难。",
        "红迷天子帆边日，紫夺星郎帐外兰。",
        "春水濯来云雁活，夜机挑处雨灯寒。",
        "舞衣转转求新样，不问流离桑柘残。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285932,
      "title": "锦二首 二",
      "content": [
        "文君手里曙霞生，美号仍闻借蜀城。",
        "夺得始知袍更贵，著归方觉昼偏荣。",
        "宫花颜色开时丽，池雁毛衣浴后明。",
        "礼部郎官人所重，省中别占好窠名。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285933,
      "title": "蜡烛",
      "content": [
        "仙漏迟迟出建章，宫帘不动透清光。",
        "金闱露白新裁诏，画合春红正试妆。",
        "泪滴杯盘何所恨，烬飘兰麝暗和香。",
        "多情更有分明处，照得歌尘下燕梁。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285934,
      "title": "灯",
      "content": [
        "雨向莎堦滴未休，冷光孤恨雨悠悠。",
        "船中闻雁洞庭宿，床下有蛩长信秋。",
        "背照翠帘新洒别，不挑红烬正含愁。",
        "萧骚寒竹南窗静，一局闲棋为尔留。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285935,
      "title": "宗人作尉唐昌官署幽胜而又博学精富得以言谈将欲他之留书屋壁",
      "content": [
        "公堂潇洒有林泉，秪隔苔墙是渚田。",
        "宗党相亲离乱世，春秋闲论战争年。",
        "远江惊鹭来池口，绝顶归云过竹边。",
        "风雨夜长同一宿，旧游多共忆樊川。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285936,
      "title": "为户部李郎中与令季端公寓止渠州江寺偶作寄献",
      "content": [
        "退居潇洒寄禅关，高挂朝簪净室间。",
        "孤岛虽留双鹤歇，五云争放二龙闲。",
        "轻舟共泛花边水，野屐同登竹外山。",
        "仙署金闺虚位久，夜清应梦近天颜。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285937,
      "title": "重阳日访元秀上人",
      "content": [
        "红叶黄花秋景宽，醉吟朝夕在樊川。",
        "却嫌今日登山俗，且共高僧对榻眠。",
        "别画长怀吴寺壁，宜茶偏赏霅溪泉。",
        "归来童稚争相笑，何事无人与酒船。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
