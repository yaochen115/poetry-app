{
  "data": [
    {
      "id": 286188,
      "title": "初过汉江",
      "content": [
        "襄阳好向岘亭看，人物萧条值岁阑。",
        "为报习家多置酒，夜来风雪过江寒。"
      ],
      "author": {
        "id": 6926,
        "name": "崔涂"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 286189,
      "title": "题授阳镇路",
      "content": [
        "越鸟巢边溪路断，秦人耕处洞门开。",
        "小桃花发春风起，千里江山一梦回。"
      ],
      "author": {
        "id": 6926,
        "name": "崔涂"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 286190,
      "title": "初识梅花",
      "content": [
        "江北不如南地暖，江南好断北人肠。",
        "燕脂桃颊棃花粉，共作寒梅一面粧。"
      ],
      "author": {
        "id": 6926,
        "name": "崔涂"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 286191,
      "title": "江雨望花",
      "content": [
        "细雨满江春水涨，好风留客野梅香。",
        "避秦不是无归意，一度逢花一断肠。"
      ],
      "author": {
        "id": 6926,
        "name": "崔涂"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 334836,
      "title": "琴曲歌辞：幽兰",
      "content": [
        "幽植众能知，贞芳只暗持。",
        "自无君子佩，未是国香衰。",
        "白露沾长早，青春每到迟。",
        "不知当路草，芳馥欲何为。"
      ],
      "author": {
        "id": 6926,
        "name": "崔涂"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 366787,
      "title": "秋夕送友人归吴",
      "content": [
        "离心醉岂欢，把酒强相宽。",
        "世路须求达，还家亦未安。",
        "旅程愁算远，江月坐吟残。",
        "莫羡扁舟兴，功成去不难。"
      ],
      "author": {
        "id": 6926,
        "name": "崔涂"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 366790,
      "title": "湖外送友人游边",
      "content": [
        "我泛潇湘浦，君行指塞云。",
        "两乡天外隔，一径渡头分。",
        "雨暗江花老，笳愁陇月曛。",
        "不堪来去雁，迢递思离群。"
      ],
      "author": {
        "id": 6926,
        "name": "崔涂"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 366791,
      "title": "读段太尉碑",
      "content": [
        "愤激计潜成，临危岂顾生。",
        "只空持一笏，便欲碎长鲸。",
        "国已酬徽烈，家犹耸义声。",
        "不知青史上，谁可计功名。"
      ],
      "author": {
        "id": 6926,
        "name": "崔涂"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 366797,
      "title": "巫山庙",
      "content": [
        "双黛俨如嚬，应伤故国春。",
        "江山非旧主，云雨是前身。",
        "梦觉传词客，灵犹福楚人。",
        "不知千载后，何处又为神。"
      ],
      "author": {
        "id": 6926,
        "name": "崔涂"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 366803,
      "title": "蜀城春",
      "content": [
        "天涯憔悴身，一望一沾巾。",
        "在处有芳草，满城无故人。",
        "怀才皆得路，失计自伤春。",
        "清镜不能照，鬓毛愁更新。"
      ],
      "author": {
        "id": 6926,
        "name": "崔涂"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 366804,
      "title": "送道士于千龄游南岳",
      "content": [
        "物外与谁期，人间又别离。",
        "四方多事日，高岳独游时。",
        "猿狖潇湘树，烟波屈宋祠。",
        "无因陪此去，空惜鬓将衰。"
      ],
      "author": {
        "id": 6926,
        "name": "崔涂"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 366808,
      "title": "秋夜兴上人别",
      "content": [
        "常时岂不别，此别异常情。",
        "南国初闻雁，中原未息兵。",
        "暗蛩侵语歇，疏磬入吟清。",
        "曾听无生说，辞师话此行。"
      ],
      "author": {
        "id": 6926,
        "name": "崔涂"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 366811,
      "title": "秋夜僧舍闻猿",
      "content": [
        "哀猿听未休，禅景夜方幽。",
        "暂得同僧静，那能免客愁。",
        "影摇云外树，声褭月中秋。",
        "曾向巴江宿，当时泪亦流。"
      ],
      "author": {
        "id": 6926,
        "name": "崔涂"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 366815,
      "title": "春日登吴门",
      "content": [
        "故国望不见，愁襟难暂开。",
        "春潮映杨柳，细雨入楼台。",
        "静少人同到，晴逢雁正来。",
        "长安远于日，搔首独徘徊。"
      ],
      "author": {
        "id": 6926,
        "name": "崔涂"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 366816,
      "title": "湘中秋怀迁客",
      "content": [
        "兰杜晓香薄，汀洲夕露繁。",
        "并闻燕塞雁，独立楚人村。",
        "雾散孤城上，滩回曙枕喧。",
        "不堪逢贾傅，还欲吊湘沅。"
      ],
      "author": {
        "id": 6926,
        "name": "崔涂"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 366818,
      "title": "东林愿禅师院",
      "content": [
        "与世渐无缘，身心独了然。",
        "讲销林下日，腊长定中年。",
        "磬绝朝斋后，香焚古寺前。",
        "非因送小朗，不到虎溪边。"
      ],
      "author": {
        "id": 6926,
        "name": "崔涂"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 366819,
      "title": "孤雁",
      "content": [
        "湘浦离应晚，边城去已孤。",
        "如何万里计，只在一枝芦。",
        "迥起波摇楚，寒栖月映蒲。",
        "不知天畔侣，何处下平芜。",
        "几行归去尽，片影独何之。",
        "暮雨相呼失，寒塘独下迟。",
        "渚云低暗度，关月冷遥随。",
        "未必逢矰缴，孤飞自可疑。"
      ],
      "author": {
        "id": 6926,
        "name": "崔涂"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 366826,
      "title": "送僧归天竺",
      "content": [
        "忽忆曾栖处，千峰近沃州。",
        "别来秦树老，归去海门秋。",
        "汲带寒汀月，禅邻贾客舟。",
        "遥思清兴惬，不厌石林幽。"
      ],
      "author": {
        "id": 6926,
        "name": "崔涂"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 366828,
      "title": "送友人归江南",
      "content": [
        "渚田芳草遍，共忆故山春。",
        "独往沧洲暮，相看白发新。",
        "定过林下寺，应见社中人。",
        "只恐东归后，难将鸥鸟亲。"
      ],
      "author": {
        "id": 6926,
        "name": "崔涂"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 366831,
      "title": "灞上",
      "content": [
        "长安名利路，役役古由今。",
        "征骑少闲日，绿杨无旧阴。",
        "水侵秦甸阔，草接汉陵深。",
        "紫阁曾过处，依稀白鸟沈。"
      ],
      "author": {
        "id": 6926,
        "name": "崔涂"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 366833,
      "title": "赠休粮僧",
      "content": [
        "闻钟独不斋，何事更关怀。",
        "静少人过院，闲从草上阶。",
        "生台无鸟下，石路有云埋。",
        "为忆禅中旧，时犹梦百崖。"
      ],
      "author": {
        "id": 6926,
        "name": "崔涂"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 366834,
      "title": "题绝岛山寺",
      "content": [
        "绝岛跨危栏，登临到此难。",
        "夕阳高鸟过，疏雨一钟残。",
        "骇浪摇空阔，灵山厌渺漫。",
        "那堪更回首，乡树隔云端。"
      ],
      "author": {
        "id": 6926,
        "name": "崔涂"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 366838,
      "title": "樵者",
      "content": [
        "行山行采薇，闲翦蕙为衣。",
        "避世嫌山浅，逢人说姓稀。",
        "有时还独醉，何处掩衡扉。",
        "莫看棋终局，溪风晚待归。"
      ],
      "author": {
        "id": 6926,
        "name": "崔涂"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 366845,
      "title": "江上怀翠微寺空上人",
      "content": [
        "旅泛本无定，相逢那可期。",
        "空怀白阁夜，未答碧云诗。",
        "暮雨潮生早，春寒雁到迟。",
        "所思今不见，乡国正天涯。"
      ],
      "author": {
        "id": 6926,
        "name": "崔涂"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 366847,
      "title": "远望",
      "content": [
        "长为乡思侵，望极即沾襟。",
        "不是前山色，能伤愁客心。",
        "平芜连海尽，独树隐云深。",
        "况复斜阳外，分明有去禽。"
      ],
      "author": {
        "id": 6926,
        "name": "崔涂"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 366848,
      "title": "秋晚书怀",
      "content": [
        "看看秋色晚，又是出门时。",
        "白发生非早，青云去自迟。",
        "梦唯怀上国，迹不到他岐。",
        "以此坚吾道，还无愧已知。"
      ],
      "author": {
        "id": 6926,
        "name": "崔涂"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 366849,
      "title": "途中秋晚送友人归江南",
      "content": [
        "又指烟波算路岐，此生多是厌羁离。",
        "正逢摇落仍须别，",
        "扁舟未得如君去，空向沧江梦所思。"
      ],
      "author": {
        "id": 6926,
        "name": "崔涂"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 366850,
      "title": "己亥岁感事",
      "content": [
        "正闻青犊起葭萌，又报黄巾犯汉营。",
        "岂是将皆无上略，",
        "见说圣君能仄席，不知谁是请长缨。"
      ],
      "author": {
        "id": 6926,
        "name": "崔涂"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 366851,
      "title": "金陵晚眺",
      "content": [
        "苇声骚屑水天秋，吟对金陵古渡头。",
        "千古是非输蝶梦，",
        "何必登临更惆怅，比来身世只如浮。"
      ],
      "author": {
        "id": 6926,
        "name": "崔涂"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 366852,
      "title": "过长江贾岛主簿旧厅",
      "content": [
        "雕琢文章字字精，我经此处倍伤情。",
        "身从谪宦方沾禄，",
        "长江一曲年年水，应为先生万古清。"
      ],
      "author": {
        "id": 6926,
        "name": "崔涂"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 366853,
      "title": "途中感怀寄青城李明府",
      "content": [
        "鳞鬣催残志未休，壮心翻是此身雠。",
        "并闻寒雨多因夜，",
        "如何只是三年别，君著朱衣我白头。"
      ],
      "author": {
        "id": 6926,
        "name": "崔涂"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 366854,
      "title": "夏日书怀寄道友",
      "content": [
        "达即匡邦退即耕，是非何足挠平生。",
        "终期道向希夷得，",
        "十年惟悟吟诗句，待得中原欲铸兵。"
      ],
      "author": {
        "id": 6926,
        "name": "崔涂"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 366855,
      "title": "和进士张曙闻雁见寄",
      "content": [
        "断行哀响递相催，争趁高秋作恨媒。",
        "云外关山闻独去，",
        "试向富春江畔过，故园犹合有池台。"
      ],
      "author": {
        "id": 6926,
        "name": "崔涂"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 366856,
      "title": "鹦鹉洲即事",
      "content": [
        "怅望春襟郁未开，重吟鹦鹉益堪哀。",
        "曹瞒尚不能容物，",
        "何人正得风涛便，一点轻帆万里回。"
      ],
      "author": {
        "id": 6926,
        "name": "崔涂"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 366857,
      "title": "读留侯传",
      "content": [
        "覆楚雠韩势有余，男儿遭遇更难如。",
        "偶成汉室千年业，",
        "若能终始匡天子，何必□□□□□。"
      ],
      "author": {
        "id": 6926,
        "name": "崔涂"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 366858,
      "title": "赤壁怀古",
      "content": [
        "汉室河山鼎势分，勤王谁肯顾元勋。",
        "不知征伐由天子，",
        "分明胜败无寻处，空听渔歌到夕曛。"
      ],
      "author": {
        "id": 6926,
        "name": "崔涂"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 366859,
      "title": "东晋",
      "content": [
        "五陵豪侠笑为儒，将为儒生只读书。",
        "看取不成投笔后，谢安功业复何如。",
        "秦国金陵王气全，一龙正道始东迁。",
        "兴亡竟不关人事，虚倚长淮五百年。"
      ],
      "author": {
        "id": 6926,
        "name": "崔涂"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 366860,
      "title": "春夕",
      "content": [
        "水流花谢两无情，送尽东风过楚城。",
        "蝴蝶梦中家万里，",
        "自是不归归便得，五湖烟景有谁争。"
      ],
      "author": {
        "id": 6926,
        "name": "崔涂"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 366862,
      "title": "湘中弦",
      "content": [
        "苍山遥遥江潾潾，路傍老尽没闲人。",
        "王孙不见草空绿，惆怅渡头春复春。",
        "烟愁雨细云冥冥，杜兰香老三湘清。",
        "故山望断不知处，𫛸鴂隔花时一声。"
      ],
      "author": {
        "id": 6926,
        "name": "崔涂"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 366863,
      "title": "续纪汉武",
      "content": [
        "分明三鸟下储胥，一觉钧天梦不如。",
        "争那白头方士到，茂陵红叶已萧疏。"
      ],
      "author": {
        "id": 6926,
        "name": "崔涂"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 366867,
      "title": "海棠图",
      "content": [
        "海棠花底三年客，不见海棠花盛开。",
        "却向江南看图画，始惭虚到蜀城来。"
      ],
      "author": {
        "id": 6926,
        "name": "崔涂"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 366875,
      "title": "幽兰",
      "content": [
        "幽植众宁知，芬芳只暗持。",
        "自无君子佩，未是国香衰。",
        "白露沾长早，春风到每迟。",
        "不如当路草，芬馥欲何为。"
      ],
      "author": {
        "id": 6926,
        "name": "崔涂"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 366877,
      "title": "过绣岭宫",
      "content": [
        "古殿春残绿野阴，上皇曾此驻泥金。",
        "三城帐属升平梦，",
        "前朝旧物东流在，犹为年年下翠岑。"
      ],
      "author": {
        "id": 6926,
        "name": "崔涂"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 366878,
      "title": "巴山道中除夜书怀",
      "content": [
        "迢递三巴路，羁危万里身。",
        "乱山残雪夜，孤烛异乡春。",
        "渐与骨肉远，转于僮仆亲。",
        "那堪正漂泊，明日岁华新。"
      ],
      "author": {
        "id": 6926,
        "name": "崔涂"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 366879,
      "title": "题净众寺古松",
      "content": [
        "百尺森疏倚梵台，昔人谁见此初栽。",
        "故园未有偏堪恋，",
        "清阴可惜不驻得，归去暮城空首回。"
      ],
      "author": {
        "id": 6926,
        "name": "崔涂"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 366885,
      "title": "初识梅花",
      "content": [
        "江北不如南地暖，江南好断北人肠。",
        "燕脂桃颊梨花粉，共作寒梅一面妆。"
      ],
      "author": {
        "id": 6926,
        "name": "崔涂"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 376866,
      "title": "孤雁",
      "content": [
        "几行归塞尽，念尔独何之？",
        "暮雨相呼失，寒塘欲下迟。",
        "渚云低暗度，关月冷相随。",
        "未必逢矰缴，孤飞自可疑。"
      ],
      "author": {
        "id": 6926,
        "name": "崔涂"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 376867,
      "title": "除夜有怀",
      "content": [
        "迢递三巴路，羁危万里身。",
        "乱山残雪夜，孤独异乡人。",
        "渐与骨肉远，转于童仆亲。",
        "那堪正漂泊，明日岁华新。"
      ],
      "author": {
        "id": 6926,
        "name": "崔涂"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    }
