{
  "data": [
    {
      "id": 362042,
      "title": "赠越僧岳云二首",
      "content": [
        "世机消已尽，巾屦亦飘然。",
        "一室故山月，满瓶秋涧泉。",
        "禅庵过微雪，乡寺隔寒烟。",
        "应共白莲客，相期松桂前。",
        "兰亭旧都讲，今日意如何。",
        "有树关深院，无尘到浅莎。",
        "僧居随处好，人事出门多。",
        "不及新春雁，年年镜水波。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 362043,
      "title": "咏山鸡",
      "content": [
        "万壑动晴景，山禽凌翠微。",
        "绣翎翻草去，红觜啄花归。",
        "巢暖碧云色，影孤清镜辉。",
        "不知春树伴，何处又分飞。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 362044,
      "title": "清旦题采药翁草堂",
      "content": [
        "幽人寻药径，来自晓云边。",
        "衣湿术花雨，语成松岭烟。",
        "解藤开涧户，踏石过溪泉。",
        "林外晨光动，山昏鸟满天。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 362046,
      "title": "题竹谷神祠",
      "content": [
        "苍苍松竹晚，一径入荒祠。",
        "古树风吹马，虚廊日照旗。",
        "烟煤朝奠处，风雨夜归时。",
        "寂寞东湖客，空看蒋帝碑。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 362047,
      "title": "途中有怀",
      "content": [
        "驱车何日闲，扰扰路岐间。",
        "岁暮自多感，客程殊未还。",
        "亭皋汝阳道，风雪穆陵关。",
        "腊后寒梅发，谁人在故山。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 362049,
      "title": "登李羽士东楼",
      "content": [
        "经客有余音，他年终故林。",
        "高楼本危睇，凉月更伤心。",
        "此意竟难折，伊人成古今。",
        "流尘其可欲，非复懒鸣琴。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 362050,
      "title": "题僧泰恭院二首",
      "content": [
        "昔岁东林下，深公识姓名。",
        "尔来辞半偈，空复叹劳生。",
        "忧患慕禅味，寂寥遗世情。",
        "所归心自得，何事倦尘缨。",
        "微生竟劳止，晤言犹是非。",
        "出门还有泪，看竹暂忘机。",
        "爽气三秋近，浮生一笑稀。",
        "故山松菊在，终欲掩荆扉。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 362052,
      "title": "送人东游",
      "content": [
        "荒戍落黄叶，浩然离故关。",
        "高风汉阳渡，初日郢门山。",
        "江上几人在，天涯孤棹还。",
        "何当重相见，尊酒慰离颜。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 362055,
      "title": "赠考功卢郎中",
      "content": [
        "白首方辞满，荆扉对渚田。",
        "雪中无陋巷，醉后似当年。",
        "一笈负山药，两瓶携涧泉。",
        "夜来风浪起，何处认渔船。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 362057,
      "title": "春日寄岳州从事李员外二首",
      "content": [
        "苒弱楼前柳，轻空花外窗。",
        "蝶高飞有伴，莺早语无双。",
        "剪胜裁春字，开屏见晓江。",
        "从来共情战，今日欲归降。",
        "从小识宾卿，恩深若弟兄。",
        "相逢在何日，此别不胜情。",
        "红粉座中客，彩斿江上城。",
        "尚平婚嫁累，无路逐双旌。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 362058,
      "title": "和段少常柯古",
      "content": [
        "称觞惭座客，怀刺即门人。",
        "素向宁知贵，清淡不厌贫。",
        "野梅江上晚，堤柳雨中春。",
        "未报淮南诏，何劳问白苹。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 362059,
      "title": "海榴",
      "content": [
        "海榴开似火，先解报春风。",
        "叶乱裁笺绿，花宜插鬓红。",
        "蜡珠攒作蒂，缃彩剪成丛。",
        "郑驿多归思，相期一笑同。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 362060,
      "title": "李先生别墅望僧舍宝刹，因作双韵声",
      "content": [
        "栖息消心象，簷楹溢艳阳。",
        "帘栊兰露落，邻里柳林凉。",
        "高阁过空谷，孤竿隔古冈。",
        "潭庐同淡荡，仿佛复芬芳。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 362063,
      "title": "送淮阴孙令之官",
      "content": [
        "隋堤杨柳烟，孤棹正悠然。",
        "萧寺通淮戍，芜城枕楚壖。",
        "鱼盐桥上市，灯火雨中船。",
        "故老青葭岸，先知i7子贤。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 362064,
      "title": "宿辉公精舍",
      "content": [
        "禅房无外物，清话此宵同。",
        "林彩水烟里，涧声山月中。",
        "橡霜诸壑霁，杉火一炉空。",
        "拥褐寒更彻，心知觉路通。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 362066,
      "title": "赠僧云栖",
      "content": [
        "麈尾与筇杖，几年离石坛。",
        "梵余林雪厚，棋罢岳钟残。",
        "开卷喜先悟，漱瓶知早寒。",
        "衡阳寺前雁，今日到长安。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 362067,
      "title": "雪夜与友生同宿晓寄近邻",
      "content": [
        "闭门群动息，积雪透疏林。",
        "有客寒方觉，无声晓已深。",
        "正繁闻近雁，并落起栖禽。",
        "寂寞寒塘路，怜君独阻寻。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 362068,
      "title": "题造微禅师院",
      "content": [
        "夜香闻偈后，岑寂掩双扉。",
        "照竹灯和雪，看松月到衣。",
        "草堂疏磬断，江寺故人稀。",
        "唯忆湘南雨，春风独鸟归。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 362076,
      "title": "休浣日西掖谒所知",
      "content": [
        "赤墀高阁自从容，玉女窗扉报曙钟。",
        "日丽九门青锁闼，",
        "荀令凤池春婉娩，好将余润变鱼龙。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 362077,
      "title": "博山",
      "content": [
        "博山香重欲成云，锦段机丝妒鄂君。",
        "粉蝶团飞花转影，",
        "见说杨朱无限泪，岂能空为路岐分。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 362078,
      "title": "送卢处士游吴越",
      "content": [
        "羡君东去见残梅，唯有王孙独未回。",
        "吴苑夕阳明古堞，",
        "试逐渔舟看雪浪，几多江燕荇花开。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 362079,
      "title": "过新丰",
      "content": [
        "一剑乘时帝业成，沛中乡里到咸京。",
        "寰区已作皇居贵，",
        "至今留得离家恨，鸡犬相闻落照明。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 362080,
      "title": "过潼关",
      "content": [
        "地形盘屈带河流，景气澄明是胜游。",
        "十里晓鸡关树暗，",
        "麈尾角巾应旷望，更嗟芳霭隔秦楼。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 362081,
      "title": "题西平王旧赐屏风",
      "content": [
        "曾向金扉玉砌来，百花鲜湿隔尘埃。",
        "披香殿下樱桃熟，",
        "世间刚有东流水，一送恩波更不回。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 362082,
      "title": "河中陪帅游亭",
      "content": [
        "倚阑愁立独徘徊，欲赋惭非宋玉才。",
        "满座山光摇剑戟，",
        "添得五湖多少恨，柳花飘荡似寒梅。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 362083,
      "title": "和赵嘏题岳寺",
      "content": [
        "疏钟细响乱鸣泉，客省高临似水天。",
        "岚翠暗来空觉润，",
        "张邴宦情何太薄，远公窗外有池莲。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 362084,
      "title": "苏武庙",
      "content": [
        "苏武魂销汉使前，古祠高树两茫然。",
        "云边雁断胡天月，",
        "茂陵不见封侯印，空向秋波哭逝川。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 362085,
      "title": "送客偶作",
      "content": [
        "石路荒凉接野蒿，西风吹马利如刀。",
        "小桥连驿杨柳晚，",
        "故山有梦不归去，官树陌尘何太劳。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 362086,
      "title": "寒食前有怀",
      "content": [
        "万物鲜华雨乍晴，春寒寂历近清明。",
        "残芳荏苒双飞蝶，",
        "悠然更起严滩恨，一宿东风蕙草生。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 362087,
      "title": "宿云际寺",
      "content": [
        "白盖微云一径深，东峰弟子远相寻。",
        "苍苔路熟僧归寺，",
        "自从紫桂岩前别，不见南能直至今。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 362088,
      "title": "寄岳州李外郎远",
      "content": [
        "含苹不语坐持颐，天远楼高宋玉悲。",
        "湖上残棋人散后，",
        "独有袁宏正憔悴，一樽惆怅落花时。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 362089,
      "title": "游南塘寄知者",
      "content": [
        "白鸟梳翎立岸莎，藻花菱刺泛微波。",
        "烟光似带侵垂柳，",
        "镏公不信归心切，听取江楼一曲歌。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 362090,
      "title": "寄卢生",
      "content": [
        "遗业荒凉近故都，门前堤路枕平湖。",
        "绿杨阴里千家月，",
        "他年犹拟金貂换，寄语黄公旧酒垆。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 362091,
      "title": "春日访李十四处士",
      "content": [
        "花深桥转水潺潺，甪里先生自闭关。",
        "看竹已知行处好，",
        "一局残棋千点雨，绿萍池上暮方还。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 362092,
      "title": "宿松门寺",
      "content": [
        "白石青崖世界分，卷帘孤坐对氛氲。",
        "林间禅室春深雪，",
        "西山旧是经行地，愿漱寒瓶逐领军。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 362093,
      "title": "咏寒宵",
      "content": [
        "寒宵何耿耿，良宴有余姿。",
        "宝靺徘徊处，熏炉怅望时。",
        "曲琼垂翡翠，斜月到罘罳。",
        "委坠金釭烬，阑珊玉局棋。",
        "话穷犹注睇，歌罢尚持颐。",
        "晻暖遥相属，氛氲积所思。",
        "秦蛾卷衣晚，胡雁度云迟。",
        "上郡归来梦，那知锦字诗。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 362094,
      "title": "寄渚宫遗民弘里生",
      "content": [
        "柳弱湖堤曲，篱疏水巷深。",
        "酒阑初促席，歌罢欲分襟。",
        "波月欺华烛，汀云润故琴。",
        "镜清花并蒂，床冷簟连心。",
        "荷叠平桥暗，萍稀败舫沉。",
        "城头五通鼓，窗外万家砧。",
        "异县鱼投浪，当年鸟共林。",
        "八行香未灭，千里梦难寻。",
        "未肯睽良愿，空期嗣好音。",
        "他时因咏作，犹得比南金。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 362095,
      "title": "春尽与友人入裴氏林探渔竿",
      "content": [
        "一径互纡直，茅棘亦已繁。",
        "晴阳入荒竹，暧暧和春园。",
        "倚杖息惭倦，徘徊恋微暄。",
        "历寻婵娟节，剪破苍筤根。",
        "地闭修茎孤，林振余箨翻。",
        "适心在所好，非必寻湘沅。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 362098,
      "title": "题贺知章故居叠韵作",
      "content": [
        "废砌翳薜荔，枯湖无菰蒲。",
        "老媪饱槁草，愚儒输逋租。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 362099,
      "title": "雨中与李先生期垂钓先后相失，因作叠韵",
      "content": [
        "隔石觅屐迹，西溪迷鸡啼。",
        "小鸟扰晓沼，犁泥齐低畦。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 362101,
      "title": "细雨",
      "content": [
        "凭轩望秋雨，凉入暑衣清。",
        "极目鸟频没，片时云复轻。",
        "沼萍开更敛，山叶动还鸣。",
        "楚客秋江上，萧萧故国情。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 362102,
      "title": "秋雨",
      "content": [
        "云满鸟行灭，池凉龙气腥。",
        "斜飘看棋簟，疏洒望山亭。",
        "细响鸣林叶，圆文破沼萍。",
        "秋阴杳无际，平野但冥冥。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 362103,
      "title": "春初对暮雨",
      "content": [
        "淅沥生丛筱，空蒙泫网轩。",
        "暝姿看远树，春意入尘根。",
        "点细飘风急，声轻入夜繁。",
        "雀喧争槿树，人静出蔬园。",
        "瓦湿光先起，房深影易昏。",
        "不应江上草，相与滞王孙。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 362104,
      "title": "雪二首",
      "content": [
        "砚水池先冻，窗风酒易消。",
        "鸦声出山郭，人迹过村桥。",
        "稍急方萦转，才深未寂寥。",
        "细光穿暗隙，轻白驻寒条。",
        "草静封还折，松欹堕复摇。",
        "谢庄今病眼，无意坐通宵。",
        "羸骖出更慵，林寺已疏钟。",
        "踏紧寒声涩，飞交细点重。",
        "圃斜人过迹，阶静鸟行踪。",
        "寂寞梁鸿病，谁人代夜舂。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 362106,
      "title": "原隰荑绿柳",
      "content": [
        "迥野韶光早，晴川柳满堤。",
        "拂尘生嫩绿，披雪见柔荑。",
        "碧玉牙犹短，黄金缕未齐。",
        "腰肢弄寒吹，眉意入春闺。",
        "预恐狂夫折，迎牵逸客迷。",
        "新莺将出谷，应借一枝栖。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 362111,
      "title": "磐石寺留别成公",
      "content": [
        "槲叶萧萧带苇风，寺前归客别支公。",
        "三秋岸雪花初白，",
        "悠然旅榜频回首，无复松窗半偈同。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 362113,
      "title": "马嵬佛寺",
      "content": [
        "荒鸡夜唱战尘深，五鼓雕舆过上林。",
        "才信倾城是真语，",
        "曼倩死来无绝艺，后人谁肯惜青禽。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 362114,
      "title": "清凉寺",
      "content": [
        "黄花红树谢芳蹊，宫殿参差黛𪩘西。",
        "诗合晓窗藏雪岭，",
        "妙迹奇名竟何在，下方烟暝草萋萋。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 362115,
      "title": "赠卢长史",
      "content": [
        "移病欲成隐，扁舟归旧居。",
        "地深新事少，官散故交疏。",
        "道直更无侣，家贫唯有书。",
        "东门烟水梦，非独为鲈鱼。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 362116,
      "title": "秋日旅舍寄义山李侍御",
      "content": [
        "一水悠悠隔渭城，渭城风物近柴荆。",
        "寒蛩乍响催机杼，",
        "子虚何处堪消渴，试向文园问长卿。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 362117,
      "title": "晚坐寄友人",
      "content": [
        "九枝灯在琐窗空，希逸无聊恨不同。",
        "晓梦未离金夹膝，",
        "应卷𫚥帘看皓齿，镜中惆怅见梧桐。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 362122,
      "title": "送襄州李中丞赴从事",
      "content": [
        "汉庭文采有相如，天子通宵爱子虚。",
        "把钓看棋高兴尽，",
        "江雨潇潇帆一片，此行谁道为鲈鱼。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 362125,
      "title": "鸿胪寺有开元中锡宴堂楼台池沼雅为胜绝荒凉遗址仅有存者偶成四十韵",
      "content": [
        "明皇昔御极，神圣垂耿光。",
        "沈机发雷电，逸躅陵尧汤。",
        "西覃积石山，北至穷发乡。",
        "四凶有獬豸，一臂无螳螂。",
        "婵娟得神艳，郁烈闻国香。",
        "紫绦鸣羯鼓，玉管吹霓裳。",
        "禄山未封侯，林甫才为郎。",
        "昭融廓日月，妥帖安纪纲。",
        "群生到寿域，百辟趋明堂。",
        "四海正夷宴，一尘不飞扬。",
        "天子自犹豫，侍臣宜乐康。",
        "轧然阊阖开，赤日生扶桑。",
        "玉砌露盘纡，金壶漏丁当。",
        "剑佩相击触，左右随趋跄。",
        "玄珠十二旒，红粉三千行。",
        "顾盻生羽翼，叱嗟回雪霜。",
        "神霞凌云阁，春水骊山阳。",
        "盘斗九子粽，瓯擎五云浆。",
        "双琼京兆博，七鼓邯郸娼。",
        "毰毸碧鸡斗，茏葱翠雉场。",
        "仗官绣蔽膝，宝马金镂锡。",
        "椒涂隔鹦鹉，柘弹惊鸳鸯。",
        "猗欤华国臣，鬓发俱苍苍。",
        "锡宴得幽致，车从真炜煌。",
        "画鹢照鱼鳖，鸣驺乱甃鸧。",
        "飐滟荡碧波，炫煌迷横塘。",
        "萦盈舞回雪，宛转歌绕梁。",
        "艳带画银络，宝梳金钿筐。",
        "沈冥类汉相，醉倒疑楚狂。",
        "一旦紫微东，胡星森耀芒。",
        "凭陵逐鲸鲵，唐突驱犬羊。",
        "纵火三月赤，战尘千里黄。",
        "殽函与府寺，从此俱荒凉。",
        "兹地乃蔓草，故基摧坏墙。",
        "枯池接断岸，唧唧啼寒螀。",
        "败荷塌作泥，死竹森如枪。",
        "游人问老吏，相对聊感伤。",
        "岂必见麋鹿，然后堪回肠。",
        "幸今遇太平，令节称羽觞。",
        "谁知曲江曲，岁岁栖鸾凰。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 362126,
      "title": "访知玄上人遇暴经因有赠",
      "content": [
        "缥帙无尘满画廊，钟山弟子静焚香。",
        "惠能未肯传心法，",
        "客儿自有翻经处，江上秋来蕙草荒。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 362127,
      "title": "寄崔先生",
      "content": [
        "往年江海别元卿，家近山阳古郡城。",
        "莲浦香中离席散，",
        "菰黍正肥鱼正美，五侯门下负平生。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 362128,
      "title": "敬答李先生",
      "content": [
        "七里滩声舜庙前，杏花初盛草芊芊。",
        "绿昏晴气春风岸，",
        "一瓢无事麛裘暖，手弄溪波坐钓船。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 362131,
      "title": "月中宿云居寺上方",
      "content": [
        "虚合披衣坐，寒阶踏叶行。",
        "众星中夜少，圆月上方明。",
        "霭尽无林色，暄余有涧声。",
        "只应愁恨事，还逐晓光生。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 362132,
      "title": "登卢氏台",
      "content": [
        "胜地当通邑，前山有故居。",
        "台高秋尽出，林断野无余。",
        "白露鸣蛩急，晴天度雁疏。",
        "由来放怀地，非独在吾庐。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 362133,
      "title": "牡丹二首",
      "content": [
        "轻阴隔翠帏，宿雨泣晴晖。",
        "醉后佳期在，歌余旧意非。",
        "蝶繁经粉住，蜂重抱香归。",
        "莫惜熏炉夜，因风到舞衣。",
        "水漾晴红压叠波，晓来金粉覆庭莎。",
        "裁成艳思偏应巧，",
        "华堂客散帘垂地，想凭阑干敛翠蛾。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 362134,
      "title": "反生桃花发因题",
      "content": [
        "疾眼逢春四壁空，夜来山雪破东风。",
        "未知王母千年熟，",
        "僧虔蜡炬高三尺，莫惜连宵照露丛。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 362135,
      "title": "杏花",
      "content": [
        "红花初绽雪花繁，重叠高低满小园。",
        "正见盛时犹怅望，",
        "杳杳艳歌春日午，出墙何处隔朱门。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 362136,
      "title": "和太常杜少卿东都修行里有嘉莲",
      "content": [
        "春秋罢注直铜龙，旧宅嘉莲照水红。",
        "两处龟巢清露里，",
        "应为临川多丽句，故持重艳向西风。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 362138,
      "title": "苦楝花",
      "content": [
        "院里莺歌歇，墙头蝶舞孤。",
        "天香熏羽葆，宫紫晕流苏。",
        "晻暧迷青琐，氤氲向画图。",
        "只应春惜别，留与博山炉。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 362139,
      "title": "自有扈至京师已后朱樱之期",
      "content": [
        "露圆霞赤数千枝，银笼谁家寄所思。",
        "秦苑飞禽谙熟早，",
        "尽日徘徊浓影下，只应重作钓鱼期。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 362141,
      "title": "莲花",
      "content": [
        "绿塘摇滟接星津，轧轧兰桡入白苹。",
        "应为洛神波上袜，至今莲蕊有香尘。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 362148,
      "title": "二月十五日樱桃盛开自所居蹑履吟玩竞名王泽章洋才",
      "content": [
        "晓觉笼烟重，春深染雪轻。",
        "静应留得蝶，繁欲不胜莺。",
        "影乱晨飙急，香多夜雨晴。",
        "似将千万恨，西北为卿卿。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 362149,
      "title": "寒食节日寄楚望二首",
      "content": [
        "芳兰无意绿，弱柳何穷缕。",
        "心断入淮山，梦长穿楚雨。",
        "繁花如二八，好月当三五。",
        "愁碧竟平皋，韶红换幽圃。",
        "流莺隐员树，乳燕喧余哺。",
        "旷望恋曾台，离忧集环堵。",
        "当年不自遣，晚得终何补。",
        "郑谷有樵苏，归来要腰斧。",
        "家乏两千万，时当一百五。",
        "飔飔杨柳风，穰穰樱桃雨。",
        "年芳苦沉潦，心事如摧橹。",
        "金犊近兰汀，铜龙接花坞。",
        "青葱建杨宅，隐辚端门鼓。",
        "彩素拂庭柯，轻球落邻圃。",
        "三春谢游衍，一笑牵规矩。",
        "独有恩泽侯，归来看楚舞。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 362153,
      "title": "杨柳八首",
      "content": [
        "宜春苑外最长条，闲袅春风伴舞腰。",
        "正是玉人肠断处，一渠春水赤阑桥。",
        "南内墙东御路旁，预知春色柳丝黄。",
        "杏花未肯无情思，何是情人最断肠。",
        "苏小门前柳万条，毵毵金线拂平桥。",
        "黄莺不语东风起，深闭朱门伴细腰。",
        "金缕毵毵碧瓦沟，六宫眉黛惹春愁。",
        "晚来更带龙池雨，半拂阑干半入楼。",
        "馆娃宫外邺城西，远映征帆近拂堤。",
        "系得王孙归意切，不关春草绿萋萋。",
        "两两黄鹂色似金，袅枝啼露动芳音。",
        "春来幸自长如线，可惜牵缠荡子心。",
        "御柳如丝映九重，凤凰窗柱绣芙蓉。",
        "景阳楼畔千条露，一面新妆待晓钟。",
        "织锦机边莺语频，停梭垂泪忆征人。",
        "塞门三月犹萧索，纵有垂杨未觉春。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 362155,
      "title": "和周繇",
      "content": [
        "齐马驰千驷，卢姬逞十三。",
        "玳筵方喜睐，金勒自𫎺𧽼。",
        "堕珥情初洽，鸣鞭战未酣。",
        "神交花冉冉，眉语柳毵毵。",
        "却略青鸾镜，翘翻翠凤𥮾。",
        "专城有佳对，宁肯顾春蚕。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 362156,
      "title": "光风亭夜宴妓有醉殴者",
      "content": [
        "吴国初成阵，王家欲解围。",
        "拂巾双雉叫，飘瓦两鸳飞。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 362157,
      "title": "南歌子词二首",
      "content": [
        "一尺深红胜曲尘，天生旧物不如新。",
        "合欢桃核终堪恨，里许元来别有人。",
        "井底点灯深烛伊，共郎长行莫围棋。",
        "玲珑骰子安红豆，入骨相思知不知。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 362158,
      "title": "题李卫公诗二首",
      "content": [
        "蒿棘深春卫国门，九年于此盗乾坤。",
        "两行密疏倾天下，",
        "当时谁是承恩者，肯有余波达鬼村。",
        "势欲凌云威触天，权倾诸夏力排山。",
        "三年骥尾有人附，",
        "千岩万壑应惆怅，流水斜倾出武关。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 362161,
      "title": "句",
      "content": [
        "春水碧于天，画船听雨眠。",
        "绿树绕村含细雨，寒潮背郭卷平沙。",
        "（《送人》，"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 376312,
      "title": "南歌子",
      "content": [
        "手里金鹦鹉，胸前绣凤凰。",
        "偷眼暗形相，不如从嫁与，",
        "似带如丝柳，团酥握雪花。",
        "帘卷玉钩斜，九衢尘欲暮，",
        "倭堕低梳髻，连娟细扫眉。",
        "终日两相思，为君憔悴尽，",
        "脸上金霞细，眉间翠钿深。",
        "欹枕覆鸳衾，隔帘莺百转，",
        "扑蕊添黄子，呵花满翠鬟。",
        "鸳枕映屏山，月明三五夜，",
        "转盼如波眼，娉婷似柳腰。",
        "花里暗相招，忆君肠欲断，",
        "懒拂鸳鸯枕，休缝翡翠裙。",
        "罗帐罢炉熏，近来心更切，"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 376313,
      "title": "荷叶杯",
      "content": [
        "一点露珠凝冷，波影，满池塘。",
        "绿茎红艳两相乱，肠断，",
        "镜水夜来秋月，如雪，采莲时。",
        "小娘红粉对寒浪，惆怅，",
        "楚女欲归南浦，朝雨，湿愁红。",
        "小船摇漾入花里，波起，"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 376314,
      "title": "忆江南",
      "content": [
        "千万恨，恨极在天涯。",
        "山月不知心里事，",
        "梳洗罢，独倚望江楼。",
        "过尽千帆皆不是，"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 376315,
      "title": "蕃女怨",
      "content": [
        "万枝香雪开已遍，细雨双燕。",
        "钿蝉筝，金雀扇，",
        "碛南沙上惊雁起，飞雪千里。",
        "玉连环，金镞箭，"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 376316,
      "title": "遐方怨",
      "content": [
        "凭绣槛，解罗帏。",
        "未得君书，断肠潇湘春雁飞，",
        "花半拆，雨初晴。",
        "未卷珠帘，梦残惆怅闻晓莺，"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 376317,
      "title": "诉衷情",
      "content": [
        "莺语，花舞，春昼午，雨霏微。",
        "金带枕，宫锦，凤凰帷。",
        "柳弱燕交飞，依依。",
        "辽阳音信稀，梦中归。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 376318,
      "title": "定西番",
      "content": [
        "汉使昔年离别，攀弱柳，折寒梅，上高台。",
        "千里玉关春雪，雁来人不来。",
        "羌笛一声愁绝，月裴回。",
        "海燕欲飞调羽，萱草绿，杏花红，隔帘栊。",
        "双鬓翠霞金缕，一枝春艳浓。",
        "楼上月明三五，琐窗中。",
        "细雨晓莺春晚，人似玉，柳如眉，正相思。",
        "罗幕翠帘初卷，镜中花一枝。",
        "肠断塞门消息，雁来稀。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 376319,
      "title": "思帝乡",
      "content": [
        "花花，满枝红似霞。",
        "罗袖画帘肠断，卓香车。",
        "回面共人闲语，战篦金凤斜。",
        "惟有阮郎春尽，不归家。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 376320,
      "title": "酒泉子",
      "content": [
        "花映柳条，闲向绿萍池上。",
        "凭栏干，窥细浪，雨萧萧。",
        "近来音信两疏索，洞房空寂寞。",
        "掩银屏，垂翠箔，度春宵。",
        "日映纱窗，金鸭小屏山碧。",
        "故乡春，烟霭隔，背兰釭。",
        "宿妆惆怅倚高阁，千里云影薄。",
        "草初齐，花又落，燕双飞。",
        "楚女不归，楼枕小河春水。",
        "月孤明，风又起，杏花稀。",
        "玉钗斜𥮾云鬟重，裙上金缕凤。",
        "八行书，千里梦，雁南飞。",
        "罗带惹香，犹系别时红豆。",
        "泪痕新，金缕旧，断离肠。",
        "一双娇燕语雕梁，还是去年时节。",
        "绿杨浓，芳草歇，"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 376321,
      "title": "玉蝴蝶",
      "content": [
        "秋风凄切伤离，行客未归时。",
        "塞外草先衰，江南雁到迟。",
        "芙蓉凋嫩脸，杨柳堕新眉。",
        "摇落使人悲，断肠谁得知。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 376322,
      "title": "女冠子",
      "content": [
        "含娇含笑，宿翠残红窈窕。",
        "鬓如蝉，寒玉簪秋水，",
        "雪胸鸾镜里，琪树凤楼前。",
        "寄语青娥伴，早求仙。",
        "霞帔云发，钿镜仙容似雪。",
        "画愁眉，遮语回轻扇，",
        "玉楼相望久，花洞恨来迟。",
        "早晚乘鸾去，莫相遗。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 376323,
      "title": "归国遥",
      "content": [
        "香玉，翠凤宝钗垂s4zy。",
        "钿筐交胜金粟，越罗春水绿。",
        "画堂照帘残烛，梦余更漏促。",
        "谢娘无限心曲，晓屏山断续。",
        "双脸，小凤战篦金飐艳。",
        "舞衣无力风敛，藕丝秋色染。",
        "锦帐绣帏斜掩，露珠清晓簟。",
        "粉心黄蕊花靥，黛眉山两点。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 376324,
      "title": "菩萨蛮",
      "content": [
        "小山重叠金明灭，鬓云欲度香腮雪。",
        "懒起画蛾眉，",
        "照花前后镜，花面交相映。",
        "新帖绣罗襦，双双金鹧鸪。",
        "水精帘里颇黎枕，暖香惹梦鸳鸯锦。",
        "江上柳如烟，",
        "藕丝秋色浅，人胜参差剪。",
        "双鬓隔香红，玉钗头上风。",
        "蕊黄无限当山额，宿妆隐笑纱窗隔。",
        "相见牡丹时，",
        "翠钗金作股，钗上蝶双舞。",
        "心事竟谁知，月明花满枝。",
        "翠翘金缕双㶉𫛶，水文细起春池碧。",
        "池上海棠梨，",
        "绣衫遮笑靥，烟草黏飞蝶。",
        "青琐对芳菲，玉关音信稀。",
        "杏花含露团香雪，绿杨陌上多离别。",
        "灯在月胧明，",
        "玉钩褰翠幕，妆浅旧眉薄。",
        "春梦正关情，镜中蝉鬓轻。",
        "玉楼明月长相忆，柳丝袅娜春无力。",
        "门外草萋萋，",
        "画罗金翡翠，香烛销成泪。",
        "花落子规啼，绿窗残梦迷。",
        "凤凰相对盘金缕，牡丹一夜经微雨。",
