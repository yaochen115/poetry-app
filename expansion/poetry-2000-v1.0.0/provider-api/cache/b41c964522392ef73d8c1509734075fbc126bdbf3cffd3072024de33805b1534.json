{
  "data": [
    {
      "id": 280130,
      "title": "送沈鹤",
      "content": [
        "家楚壻于秦，携妻去养亲。",
        "陆行千里外，风卷一帆新。",
        "夜泊疏山雨，秋吟捣药轮。",
        "芜城登眺作，才动广陵人。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280131,
      "title": "秋夜仰怀钱孟二公琴客会",
      "content": [
        "月色四时好，秋光君子知。",
        "南山昨夜雨，为我写清规。",
        "独鹤耸寒骨，高杉韵细飔。",
        "仙家缥缈弄，髣髴此中期。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280132,
      "title": "赠李金州",
      "content": [
        "绮里祠前后，山程践白云。",
        "溯流随大斾，登岸见全军。",
        "晓角吹人梦，秋风卷雁群。",
        "雾开方露日，汉水底沙分。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280133,
      "title": "酬姚合校书",
      "content": [
        "因贫行远道，得见旧交游。",
        "美酒易倾尽，好诗难卒酬。",
        "公堂朝共到，私第夜相留。",
        "不觉入关晚，别来林木秋。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280134,
      "title": "送独孤马二秀才居明月山读书",
      "content": [
        "濯志俱高洁，儒科慕冉颜。",
        "家辞临水郡，雨到读书山。",
        "栖鸟椶花上，声钟砾阁间。",
        "寂寥窗户外，时见一舟还。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280135,
      "title": "病蝉",
      "content": [
        "病蝉飞不得，向我掌中行。",
        "拆翼犹能薄，酸吟尚极清。",
        "露华凝在腹，尘点误侵睛。",
        "黄雀幷鸢鸟，俱怀害尔情。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280136,
      "title": "青门里作",
      "content": [
        "燕存鸿已过，海内几人愁。",
        "欲问南宗理，将归北岳修。",
        "若无攀桂分，秖是卧云休。",
        "泉树一为别，依稀三十秋。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280137,
      "title": "卢秀才南台",
      "content": [
        "居在青门里，台当千万岑。",
        "下因冈助势，上有树交阴。",
        "陵远根才近，空长畔可寻。",
        "新晴登啸处，惊起宿枝禽。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280138,
      "title": "寄李辀侍郎",
      "content": [
        "终过盟津书，分明梦不虚。",
        "人从清渭别，地隔太行余。",
        "宾幕谁嫌静，公门但晏如。",
        "櫑鞞干霹雳，斜汉湿蟾蜍。",
        "追琢垂今后，敦庞得古初。",
        "井台怜操筑，漳岸想丕疏。",
        "亦冀铿珉珮，终当直石渠。",
        "此身多抱疾，幽里近营居。",
        "忆漱苏门涧，经浮楚泽潴。",
        "松栽侵古影，荤断尚芹葅。",
        "语嘿曾延接，心源离滓淤。",
        "谁言姓琴氏，独跨角生鱼。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 280139,
      "title": "寄令狐绹相公",
      "content": [
        "驴骏胜羸马，东川路匪赊。",
        "一缄论贾谊，三蜀寄严家。",
        "澄彻霜江水，分明露石沙。",
        "话言声及政，栈阁谷离斜。",
        "自著衣偏暖，谁忧雪六花。",
        "裹裳留阔幞，防患与通茶。",
        "山馆中宵起，星河残月华。",
        "双僮前日雇，数口向天涯。",
        "良乐知骐骥，张雷验镆铘。",
        "谦光贤将相，别纸圣龙蛇。",
        "岂有斯言玷，应无白璧瑕。",
        "不妨圆魄里，人亦指虾蟇。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 280140,
      "title": "再投李益常侍",
      "content": [
        "何处初投刺，当时赴尹京。",
        "淹留花柳变，然诺肺肠倾。",
        "避暑蝉移树，高眠雁过城。",
        "人家嵩岳色，公府洛河声。",
        "联句逢秋尽，尝茶见月生。",
        "新衣裁白苎，思从曲江行。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 280141,
      "title": "积雪",
      "content": [
        "昔属时霖滞，今逢腊雪多。",
        "南猜飘桂渚，北讶雨交河。",
        "尽灭平芜色，弥重古木柯。",
        "空中离白气，岛外下沧波。",
        "隐者迷樵道，朝人冷玉珂。",
        "夕繁仍昼密，漏间复钟和。",
        "想积高嵩顶，新秋皎月过。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 280142,
      "title": "过杨道士居",
      "content": [
        "先生修道处，茆屋远嚣氛。",
        "叩齿坐明月，搘颐望白云。",
        "精神含药色，衣服带霞纹。",
        "无话瀛洲路，多年别少君。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280143,
      "title": "赠僧",
      "content": [
        "乱山秋木穴，里有灵蛇藏。",
        "铁锡挂临海，石楼闻异香。",
        "出尘头未白，入定衲凝霜。",
        "莫话五湖事，令人心欲狂。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280144,
      "title": "送友人游塞",
      "content": [
        "飘蓬多塞下，君见益潸然。",
        "逈碛沙衔日，长河水接天。",
        "夜泉行客火，晓戍向京烟。",
        "少结相思恨，佳期芳草前。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 280145,
      "title": "思游边友人",
      "content": [
        "凝愁对孤烛，昨日饮离杯。",
        "叶下故人去，天中新雁来。",
        "连沙秋草薄，带雪暮山开。",
        "苑北红尘道，何时见远回。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280146,
      "title": "秋暮寄友人",
      "content": [
        "寥落关河暮，霜风树叶低。",
        "远天垂地外，寒日下峰西。",
        "有志烟霞切，无家岁月迷。",
        "清宵话白阁，已负十年栖。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280147,
      "title": "寄令狐绹相公",
      "content": [
        "官高频敕授，老免把犁锄。",
        "一主长江印，三封东省书。",
        "不无濠上思，唯食圃中蔬。",
        "梦幻将泡影，浮生事只如。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280148,
      "title": "和孟逸人林下道情",
      "content": [
        "四气相陶铸，中庸道岂销。",
        "夏云生此日，春色尽今朝。",
        "陋巷贫无闷，毘耶疾未调。",
        "已栽天末柏，合抱岂非遥。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280149,
      "title": "宿姚少府北斋",
      "content": [
        "石溪同夜泛，复此北斋期。",
        "鸟绝吏归后，蛩鸣客卧时。",
        "鏁城凉雨细，开印曙钟迟。",
        "忆此漳川岸，如今是别离。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280150,
      "title": "雪晴晚望",
      "content": [
        "倚杖望晴雪，溪云几万重。",
        "樵人归白屋，寒日下危峰。",
        "野火烧冈草，断烟生石松。",
        "却回山寺路，闻打暮天钟。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280151,
      "title": "送崔峤游潇湘",
      "content": [
        "功烈尚书孙，琢磨风雅言。",
        "渡河山凿处，陟岘汉滩喧。",
        "梦想吟天目，宵同话石门。",
        "枫林叶欲下，极浦月清暾。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280152,
      "title": "寄朱锡珪",
      "content": [
        "远泊与谁同，来从古木中。",
        "长江人钓月，旷野火烧风。",
        "梦泽吞楚大，闽山阨海丛。",
        "此时樯底水，涛起屈原通。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280153,
      "title": "马戴居华山因寄",
      "content": [
        "玉女洗头盆，孤高不可言。",
        "瀑流莲岳顶，河注华山根。",
        "绝雀林藏鹘，无人境有猨。",
        "秋蟾才过雨，石上古松门。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280154,
      "title": "寄胡遇",
      "content": [
        "一自残春别，经炎复到凉。",
        "萤从枯树出，蛩入破堦藏。",
        "落叶书胜纸，闲砧坐当林。",
        "东门因送客，相访也何妨。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280155,
      "title": "送李戎扶侍往寿安",
      "content": [
        "二千余里路，一半是波涛。",
        "未晓著衣起，出城逢日高。",
        "关山多寇盗，扶侍带弓刀。",
        "临别不挥泪，谁知心郁陶。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280156,
      "title": "送孙逸人",
      "content": [
        "衣屦犹同俗，妻儿亦宛然。",
        "不餐能累月，无病已多年。",
        "是药皆谙性，令人渐信仙。",
        "杖头书数卷，荷入翠微烟。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280157,
      "title": "寄华山僧",
      "content": [
        "遥知白石室，松柏隐朦胧。",
        "月落看心次，云生闭目中。",
        "五更钟隔岳，万尺水悬空。",
        "苔藓嵌岩所，依稀有径通。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280158,
      "title": "送李登少府",
      "content": [
        "伊阳耽酒尉，朗咏醉醒新。",
        "应见嵩山里，明年踯躅春。",
        "一千寻树直，三十六峰邻。",
        "流水潺潺处，坚贞玉涧珉。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280159,
      "title": "易州过郝逸人居",
      "content": [
        "每逢词翰客，邀我共寻君。",
        "果见闲居赋，未曾流俗闻。",
        "也知邻市井，宛似出嚣氛。",
        "却笑巢由辈，何须隐白云。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280160,
      "title": "詶鄠县李廓少府见寄",
      "content": [
        "稍怜公事退，复遇夕阳时。",
        "北朔霜凝竹，南山水入篱。",
        "吟怀沧海侣，空问白云师。",
        "恨不相从去，心惟野鹤知。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280161,
      "title": "净业寺与前鄠县李廓少府同宿",
      "content": [
        "来从城上峰，京寺暮相逢。",
        "往往语复默，微微雨洒松。",
        "家贫初罢吏，年长畏闻蛩。",
        "前日独拘束，披衣起晓钟。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280162,
      "title": "送南卓归京",
      "content": [
        "残春别镜陂，罢郡未霜髭。",
        "行李逢炎暑，山泉满路岐。",
        "云藏巢鹤树，风触啭莺枝。",
        "三省同虚位，双旌带去思。",
        "入城宵梦后，待漏月沈时。",
        "长策幷忠告，从容写玉墀。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 280163,
      "title": "卧疾走笔詶韩愈书问",
      "content": [
        "一卧三四旬，数书惟独君。",
        "愿为出海月，不作归山云。",
        "身上衣频寄，瓯中物亦分。",
        "欲知强健否，病鹤未离群。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280164,
      "title": "长孙霞李溟自紫阁白阁二峰见访",
      "content": [
        "寂寞吾庐贫，同来二阁人。",
        "所论唯野事，招作住云邻。",
        "古寺期秋宿，平林散早春。",
        "漱流今已矣，巢许岂尧臣。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280165,
      "title": "送惟一游清凉寺",
      "content": [
        "去有巡台侣，荒溪众树分。",
        "瓶残秦地水，锡入晋山云。",
        "秋月离喧见，寒泉出定闻。",
        "人间临欲别，旬日雨纷纷。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280166,
      "title": "郑尚书新开涪江二首 一",
      "content": [
        "岸凿青山破，江开白浪寒。",
        "日沈源出海，春至草生滩。",
        "梓匠防波溢，蓬仙畏水干。",
        "从今疏决后，任雨滞峰峦。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280167,
      "title": "郑尚书新开涪江二首 二",
      "content": [
        "不侵南亩务，已拔北江流。",
        "涪水方移岸，浔阳有到舟。",
        "潭澄初捣药，波动乍垂钩。",
        "山可疏三里，从知历亿秋。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280168,
      "title": "寄乔侍郎",
      "content": [
        "大宁犹未到，曾渡北浮桥。",
        "晓出爬船寺，手擎紫栗条。",
        "差池不相见，怅望至今朝。",
        "近日营家计，绳悬一小瓢。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280169,
      "title": "送去华法师",
      "content": [
        "在越居何寺，东南水路归。",
        "秋江洗一钵，寒日晒三衣。",
        "默听鸿声尽，行看叶影飞。",
        "囊中无宝货，船户夜扃稀。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280170,
      "title": "送蔡京",
      "content": [
        "跃蹄归鲁日，带漏别秦星。",
        "易折芳条桂，难穷邃义经。",
        "登封多泰岳，巡狩徧沧溟。",
        "家在何林下，梁山翠满庭。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280171,
      "title": "慈恩寺上座院",
      "content": [
        "未委衡山色，何如对塔峰。",
        "曩宵曾宿此，今夕值秋浓。",
        "羽族栖烟竹，寒流带月钟。",
        "井甘源起异，泉涌渍苔封。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280172,
      "title": "题朱庆余所居",
      "content": [
        "天寒吟竟晓，古屋瓦生松。",
        "寄信船一只，隔乡山万重。",
        "树来沙岸鸟，窗度雪楼钟。",
        "每忆江中屿，更看城上峰。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280173,
      "title": "送黄知新归安南",
      "content": [
        "池亭沈饮徧，非独曲江花。",
        "地远路穿海，春归冬到家。",
        "火山难下雪，瘴土不生茶。",
        "知决移来计，相逢期尚赊。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280174,
      "title": "赠胡禅归",
      "content": [
        "自是根机钝，非关夏腊深。",
        "秋来江上寺，夜坐岭南心。",
        "井凿山含月，风吹磬出林。",
        "祖师携只履，去路杳难寻。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280175,
      "title": "元日女道士受箓",
      "content": [
        "元日更新夜，斋身称净衣。",
        "数星连斗出，万里断云飞。",
        "霜下磬声在，月高坛影微。",
        "立听师语了，左肘系符归。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280176,
      "title": "重与彭兵曹",
      "content": [
        "故人在城里，休寄海边书。",
        "渐去老不远，别来情岂疎。",
        "砚冰催腊日，山雀到贫居。",
        "每有平戎计，官家别敕除。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280177,
      "title": "赠庄上人",
      "content": [
        "不语焚香坐，心知道已成。",
        "流年衰此世，定力见他生。",
        "暮雪余春冷，寒灯续昼明。",
        "寻常五侯至，敢望下堦迎。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280178,
      "title": "落第东归逢僧伯阳",
      "content": [
        "相逢须语笑，人世别离频。",
        "晓至长侵月，思乡动隔春。",
        "见僧心暂静，从俗事多迍。",
        "宇宙诗名小，山河客路新。",
        "翠桐犹入爨，清镜未辞尘。",
        "逸足思奔骥，随群且退鳞。",
        "宴乖红杏寺，愁在绿杨津。",
        "老病难为乐，开眉赖故人。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 280179,
      "title": "皇甫主簿期游山不及赴",
      "content": [
        "休官匹马在，新意入山中。",
        "更住应难遂，前期恨不同。",
        "集蝉苔树僻，留客雨堂空。",
        "深夜谁相访，惟当清净翁。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280180,
      "title": "宿成湘林下",
      "content": [
        "相访夕阳时，千株木未衰。",
        "石泉流出谷，山雨滴栖鸱。",
        "漏向灯听数，酒因客寝迟。",
        "今宵不尽兴，更有月明期。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280181,
      "title": "喜雍陶至",
      "content": [
        "今朝笑语同，几日百忧中。",
        "鸟度劒门静，蛮归泸水空。",
        "步霜吟菊畔，待月坐林东。",
        "且莫孤此兴，勿论穷与通。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280182,
      "title": "酬胡遇",
      "content": [
        "丽句传人口，科名立可图。",
        "移居见山烧，买树带巢乌。",
        "游远风涛急，吟清雪月孤。",
        "却思初识面，仍未有多须。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280183,
      "title": "宿慈恩寺郁公房",
      "content": [
        "病身来寄宿，自扫一床闲。",
        "反照临江磬，新秋过雨山。",
        "竹阴移冷月，荷气带禅关。",
        "独住天台意，方从内请还。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280184,
      "title": "送褚山人归日本",
      "content": [
        "悬帆待秋水，去入杳冥间。",
        "东海几年别，中华此日还。",
        "岸遥生白发，波尽露青山。",
        "隔水相思在，无书也是闲。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280185,
      "title": "寄韩湘",
      "content": [
        "过岭行多少，潮州涨满川。",
        "花开南去后，水冻北归前。",
        "望鹭吟登阁，听猨泪滴船。",
        "相思堪面话，不著尺书传。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280186,
      "title": "雨夜寄马戴",
      "content": [
        "芳林杏花树，花落子西东。",
        "今夕曲江雨，寒催朔北风。",
        "乡书沧海绝，隐路翠微通。",
        "寂寂相思际，孤釭残漏中。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280187,
      "title": "喜无可上人游山回",
      "content": [
        "一食复何如，寻山无定居。",
        "相逢新夏满，不见半年余。",
        "听话龙潭雪，休传鸟道书。",
        "别来还似旧，白发日高梳。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280188,
      "title": "寄毘陵彻公",
      "content": [
        "身依吴寺老，黄叶几回看。",
        "早讲林霜在，孤禅隙月残。",
        "井通潮浪远，钟与角声寒。",
        "已有南游约，谁言礼谒难。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280189,
      "title": "送韦琼校书",
      "content": [
        "宾佐兼归觐，此行江汉心。",
        "别离从阙下，道路向山阴。",
        "孤屿消寒沫，空城滴夜霖。",
        "若邪溪畔寺，秋色共谁寻。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280190,
      "title": "寄刘侍御",
      "content": [
        "衣多苔藓痕，犹拟更趋门。",
        "自夏虽无病，经秋不过原。",
        "积泉留岱鸟，叠岫隔巴猨。",
        "琴月西斋集，如今岂复言。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280191,
      "title": "送穆少府知眉州",
      "content": [
        "劒门倚青汉，君昔未曾过。",
        "日暮行人少，山深异鸟多。",
        "猨啼和峡雨，栈尽到江波。",
        "一路白云里，飞泉洒薜萝。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280192,
      "title": "二月晦日留别鄠中友人",
      "content": [
        "立马柳花里，别君当酒酣。",
        "春风渐向北，云雁不飞南。",
        "明晓日初一，今年月又三。",
        "鞭羸去暮色，远岳起烟岚。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280193,
      "title": "送李校书赴吉期",
      "content": [
        "筮算重重吉，良期讵可迁。",
        "不同牛女夜，是配凤凰年。",
        "佩玉春风里，题章蜡烛前。",
        "诗书与箴训，夫哲又妻贤。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280194,
      "title": "宿孤馆",
      "content": [
        "落日投村戍，愁生为客途。",
        "寒山晴后绿，秋月夜来孤。",
        "橘树千株在，渔家一半无。",
        "自知风水静，舟系岸边芦。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280195,
      "title": "哭宗密禅师",
      "content": [
        "鸟道雪岑巅，师亡谁去禅。",
        "几尘增灭后，树色改生前。",
        "层塔当松吹，残踪傍野泉。",
        "唯嗟听经虎，时到坏庵边。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280196,
      "title": "宿山寺",
      "content": [
        "众岫耸寒色，精庐向此分。",
        "流星透疎木，走月逆行云。",
        "绝顶人来少，高松鹤不群。",
        "一僧年八十，世事未曾闻。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280197,
      "title": "送友人如边",
      "content": [
        "去日重阳后，前程菊正芳。",
        "行车辗秋岳，落叶坠寒霜。",
        "云入汉天白，风高碛色黄。",
        "蒲轮待恐晚，求荐向诸方。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 280198,
      "title": "题竹谷上人院",
      "content": [
        "禅庭高鸟道，回望极川原。",
        "樵径连峰顶，石泉通竹根。",
        "木深犹积雪，山浅未闻猨。",
        "欲别尘中苦，愿师贻一言。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280199,
      "title": "京北原作",
      "content": [
        "登原见城阙，策蹇思炎天。",
        "日午路中客，槐花风处蝉。",
        "远山秦木上，清渭汉陵前。",
        "何事居人世，皆从名利牵。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280200,
      "title": "寄江上人",
      "content": [
        "紫阁旧房在，新家中岳东。",
        "烟波千里隔，消息一朝通。",
        "寒日汀洲路，秋晴岛屿风。",
        "分明杜陵叶，别后两经红。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280201,
      "title": "送僧归太白山",
      "content": [
        "坚冰连夏处，太白接青天。",
        "云塞石房路，峰明雨外巅。",
        "夜禅临虎穴，寒漱撇龙泉。",
        "后会不期日，相逢应信缘。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280202,
      "title": "暮过山村",
      "content": [
        "数里闻寒水，山家少四邻。",
        "怪禽啼旷野，落日恐行人。",
        "初月未终夕，边烽不过秦。",
        "萧条桑柘外，烟火渐相亲。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280203,
      "title": "鹭鸶",
      "content": [
        "求鱼未得食，沙岸往来行。",
        "岛月独栖影，暮天寒过声。",
        "堕巢因木折，失侣遇弦惊。",
        "频向烟霄望，吾知尔去程。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280204,
      "title": "内道场僧弘绍",
      "content": [
        "麟德燃香请，长安春几回。",
        "夜闲同像寂，昼定为吾开。",
        "讲罢松根老，经浮海水来。",
        "六年双足履，只步院中苔。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280205,
      "title": "蒋亭和蔡湘州",
      "content": [
        "蒋宅为亭榭，蔡城东郭门。",
        "潭连秦相井，松老汉朝根。",
        "已积苍苔徧，何曾旧径存。",
        "高斋无事后，时复一携尊。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280206,
      "title": "光州王建使君水亭作",
      "content": [
        "楚水临轩积，澄鲜一亩余。",
        "柳根连岸尽，荷叶出萍初。",
        "极浦清相似，幽禽到不虚。",
        "夕阳庭际眺，槐雨滴疎疎。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280207,
      "title": "留别光州王使君建",
      "content": [
        "杜陵千里外，期在末秋归。",
        "既见林花落，须防木叶飞。",
        "楚从何地尽，淮隔数峰微。",
        "回首余霞失，斜阳照客衣。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280208,
      "title": "宿姚合宅寄张司业籍",
      "content": [
        "闲宵因集会，柱史话先生。",
        "身爱无一事，心期往四明。",
        "松枝影摇动，石磬响寒清。",
        "谁伴南斋宿，月高霜满城。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280209,
      "title": "哭张籍",
      "content": [
        "精灵归恍惚，石磬韵曾闻。",
        "即日是前古，谁人耕此坟。",
        "旧游孤櫂远，故域九江分。",
        "本欲蓬瀛去，餐芝御白云。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280210,
      "title": "灵准上人院",
      "content": [
        "掩扉当太白，腊数等松椿。",
        "禁漏来遥夜，山泉落近邻。",
        "经声终卷晓，草色几芽春。",
        "海内知名士，交游准上人。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280211,
      "title": "寄柳舍人宗元",
      "content": [
        "格与功俱造，何人意不降。",
        "一宵三梦柳，孤泊九秋江。",
        "擢第名重列，冲天字几双。",
        "誓为仙者仆，侧执驭风幢。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280212,
      "title": "送玄岩上人归西蜀",
      "content": [
        "玉垒山中寺，幽深胜概多。",
        "药成彭祖捣，顶受七轮摩。",
        "去腊催今夏，流光等逝波。",
        "会当依粪扫，五岳徧头陀。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280213,
      "title": "寄宋州田中丞",
      "content": [
        "古郡近南徐，关河万里余。",
        "相思深夜后，未荅去秋书。",
        "自别知音少，难忘识面初。",
        "旧山期已久，门掩数畦蔬。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280214,
      "title": "送朱休归劒南",
      "content": [
        "劒南归受贺，太学赋声雄。",
        "山路长江岸，朝阳十月中。",
        "芽新抽雪茗，枝重集猨枫。",
        "卓氏琴台废，深芜想径通。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280215,
      "title": "寄长武朱尚书",
      "content": [
        "不日即登坛，枪旗一万竿。",
        "角吹边月没，鼓绝爆雷残。",
        "中国今如此，西荒可取难。",
        "白衣思请谒，徒步在长安。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280216,
      "title": "送皇甫侍御",
      "content": [
        "晓钟催早朝，自是赴嘉招。",
        "舟泊湘江阔，田收楚泽遥。",
        "雁惊起衰草，猨渴下寒条。",
        "来使黔南日，时应问寂寥。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280217,
      "title": "郊居即事",
      "content": [
        "住此园林久，其如未是家。",
        "叶书传野意，簷溜煮胡茶。",
        "雨后逢行鹭，更深听远蛙。",
        "自然还往里，多是爱烟霞。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280218,
      "title": "夜集姚合宅期可公不至",
      "content": [
        "公堂秋雨夜，已是念园林。",
        "何事疾病日，重论山水心。",
        "孤灯明腊后，微雪下更深。",
        "释子乖来约，泉西寒磬音。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280219,
      "title": "喜李余自蜀至",
      "content": [
        "迢遰岷峨外，西南驿路高。",
        "几程寻崄栈，独宿听寒涛。",
        "白鸟飞还立，青猨断更号。",
        "往来从此过，词体近风骚。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280220,
      "title": "王侍御南原庄",
      "content": [
        "买得足云地，新栽药数窠。",
        "峰头盘一径，原下注双河。",
        "春寺闲眠久，晴台独上多。",
        "南斋宿雨后，仍许重来么。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280221,
      "title": "送康秀才",
      "content": [
        "俱为落第年，相识落花前。",
        "酒泻两三盏，诗吟十数篇。",
        "行岐逢塞雨，嘶马上津船。",
        "树影高堂下，回时应有蝉。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280222,
      "title": "送僧",
      "content": [
        "此生披衲过，在世得身闲。",
        "日午游都市，天寒往华山。",
        "言归文字外，意出有无间。",
        "仙掌云边树，巢禽时出关。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280223,
      "title": "寄魏少府",
      "content": [
        "来时乖面别，终日使人慙。",
        "易记卷中句，难忘灯下谈。",
        "湿苔黏树瘿，瀑布溅房庵。",
        "音信如相惠，移居古井南。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280224,
      "title": "原居即事言怀赠孙员外",
      "content": [
        "出入土门偏，秋深石色泉。",
        "径通原上草，地接水中莲。",
        "采菌依余枿，拾薪逢刈田。",
        "镊挦白发断，兵阻尺书传。",
        "避路来华省，抄诗上彩牋。",
        "高斋久不到，犹喜未经年。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 280225,
      "title": "登楼",
      "content": [
        "秋日登高望，凉风吹海初。",
        "山川明已久，河汉没无余。",
        "远近涯寥敻，高低中太虚。",
        "赋因王阁笔，思比谢游疎。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280226,
      "title": "上乐使君救康成公",
      "content": [
        "曾梦诸侯笑，康囚议脱枷。",
        "千根池里藕，一朵火中花。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 280227,
      "title": "[昆]明池泛舟",
      "content": [
        "一枝青竹榜，泛泛绿萍里。",
        "不见钓鱼人，渐入秋塘水。"
      ],
