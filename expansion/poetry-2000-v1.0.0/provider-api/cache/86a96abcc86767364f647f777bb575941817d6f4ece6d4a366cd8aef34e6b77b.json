{
  "data": [
    {
      "id": 264847,
      "title": "酬贾鹏山人郡内新栽松寓兴见赠二首 二",
      "content": [
        "无能常闭阁，偶以静见名。",
        "奇姿来远山，忽似人家生。",
        "劲色不改旧，芳心与谁荣。",
        "喧卑岂所安，任物非我情。",
        "清韵动竽瑟，谐此风中声。"
      ],
      "author": {
        "id": 1331,
        "name": "柳宗元"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 264848,
      "title": "种柳戏题",
      "content": [
        "柳州柳刺史，种柳柳江边。",
        "谈笑为故事，推移成昔年。",
        "垂阴当覆地，耸干会参天。",
        "好作思人树，惭无惠化传。"
      ],
      "author": {
        "id": 1331,
        "name": "柳宗元"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 264849,
      "title": "柳州二月榕叶落尽偶题",
      "content": [
        "宦情羁思共凄凄，春半如秋意转迷。",
        "山城过雨百花尽，榕叶满庭莺乱啼。"
      ],
      "author": {
        "id": 1331,
        "name": "柳宗元"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 264850,
      "title": "浩初上人见贻绝句欲登仙人山因以酬之",
      "content": [
        "珠树玲珑隔翠微，病来方外事多违。",
        "仙山不属分符客，一任凌空锡杖飞。"
      ],
      "author": {
        "id": 1331,
        "name": "柳宗元"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 264851,
      "title": "雨中赠仙人山贾山人",
      "content": [
        "寒江夜雨声潺潺，晓云遮尽仙人山。",
        "遥知玄豹在深处，下笑羁绊泥涂间。"
      ],
      "author": {
        "id": 1331,
        "name": "柳宗元"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 264852,
      "title": "别舍弟宗一",
      "content": [
        "零落残红倍黯然，双垂别泪越江边。",
        "一身去国六千里，万死投荒十二年。",
        "桂岭瘴来云似墨，洞庭春尽水如天。",
        "欲知此后相思梦，长在荆门郢树烟。"
      ],
      "author": {
        "id": 1331,
        "name": "柳宗元"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 264853,
      "title": "奉和周二十丈酬郴州侍郎衡江夜泊得韶州书幷附当州生黄茶一封率然成篇代意之作",
      "content": [
        "丘山仰德耀，天路下征騑。",
        "梦喜三刀近，书嫌五载违。",
        "凝情江月落，属思岭云飞。",
        "会入司徒府，还邀周掾归。"
      ],
      "author": {
        "id": 1331,
        "name": "柳宗元"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 264854,
      "title": "殷贤戏批书后寄刘连州幷示孟仑二童",
      "content": [
        "书成欲寄庾安西，纸背应劳手自题。",
        "闻到尽来诸子弟，临池寻已厌家鸡。"
      ],
      "author": {
        "id": 1331,
        "name": "柳宗元"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 264855,
      "title": "重赠二首 一",
      "content": [
        "闻道将雏向墨池，刘家还有异同词。",
        "如今试遣隈墙问，已道世人那得知。"
      ],
      "author": {
        "id": 1331,
        "name": "柳宗元"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 264856,
      "title": "重赠二首 二",
      "content": [
        "世上悠悠不识真，姜芽尽是捧心人。",
        "若道柳家无子弟，往年何事乞西宾。"
      ],
      "author": {
        "id": 1331,
        "name": "柳宗元"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 264857,
      "title": "叠前",
      "content": [
        "小学新翻墨沼波，羡君琼树散枝柯。",
        "左家弄玉唯娇女，空觉庭前鸟迹多。"
      ],
      "author": {
        "id": 1331,
        "name": "柳宗元"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 264858,
      "title": "叠后",
      "content": [
        "事业无成耻艺成，南宫起草旧连名。",
        "劝君火急添功用，趂取当时二妙声。"
      ],
      "author": {
        "id": 1331,
        "name": "柳宗元"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 264859,
      "title": "铜鱼使赴都寄亲友",
      "content": [
        "行尽关山万里余，到时闾井是荒墟。",
        "附庸唯有铜鱼使，此后无因寄远书。"
      ],
      "author": {
        "id": 1331,
        "name": "柳宗元"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 264860,
      "title": "韩漳州书报彻上人亡因寄二绝 一",
      "content": [
        "早岁京华听越吟，闻君江海分逾深。",
        "他时若写兰亭会，莫画高僧支道林。"
      ],
      "author": {
        "id": 1331,
        "name": "柳宗元"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 264861,
      "title": "韩漳州书报彻上人亡因寄二绝 二",
      "content": [
        "频把琼书出袖中，独吟遗句立秋风。",
        "桂江日夜流千里，挥泪何时到甬东。"
      ],
      "author": {
        "id": 1331,
        "name": "柳宗元"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 264862,
      "title": "柳州城西北隅种柑树",
      "content": [
        "手种黄柑二百株，春来新叶徧城隅。",
        "方同楚客怜皇树，不学荆州利木奴。",
        "几岁开花闻喷雪，何人摘实见垂珠。",
        "若教坐待成林日，滋味还堪养老夫。"
      ],
      "author": {
        "id": 1331,
        "name": "柳宗元"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 264863,
      "title": "闻彻上人亡寄侍郎杨丈",
      "content": [
        "东越高僧还姓汤，几时琼佩触鸣珰。",
        "空花一散不知处，谁采金英与侍郎。"
      ],
      "author": {
        "id": 1331,
        "name": "柳宗元"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 264864,
      "title": "段九秀才处见亡友吕衡州书迹",
      "content": [
        "交侣平生意最亲，衡阳往事似分身。",
        "袖中忽见三行字，拭泪相看是故人。"
      ],
      "author": {
        "id": 1331,
        "name": "柳宗元"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 264865,
      "title": "柳州寄京中亲故",
      "content": [
        "林邑山连瘴海秋，牂牁水向郡前流。",
        "劳君远问龙城地，正北三千到锦州。"
      ],
      "author": {
        "id": 1331,
        "name": "柳宗元"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 264866,
      "title": "种木槲花",
      "content": [
        "上苑年年占物华，飘零今日在天涯。",
        "祗因长作龙城守，剩种庭前木槲花。"
      ],
      "author": {
        "id": 1331,
        "name": "柳宗元"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 264867,
      "title": "摘樱桃赠元居士时在望仙亭南楼与朱道士同处",
      "content": [
        "海上朱樱赠所思，楼居况是望仙时。",
        "蓬莱羽客如相访，不是偷桃一小儿。"
      ],
      "author": {
        "id": 1331,
        "name": "柳宗元"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 264868,
      "title": "酬曹侍御过象县见寄",
      "content": [
        "破额山前碧玉流，骚人遥驻木兰舟。",
        "春风无限潇湘意，欲采苹花不自由。"
      ],
      "author": {
        "id": 1331,
        "name": "柳宗元"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 264869,
      "title": "法华寺石门精舍三十韵",
      "content": [
        "拘情病幽郁，旷志寄高爽。",
        "愿言怀名缁，东峰旦夕仰。",
        "始欣云雨霁，尤悦草木长。",
        "道同有爱弟，披拂恣心赏。",
        "松谿𥦖窱入，石栈夤缘上。",
        "萝葛绵层甍，莓苔侵标牓。",
        "密林互对耸，绝壁俨双敞。",
        "堑峭出蒙笼，墟险临滉瀁。",
        "稍疑地脉断，悠若天梯往。",
        "结构罩群崖，廻环驱万象。",
        "小劫不逾瞬，大千若在掌。",
        "体空得化元，观有遗细想。",
        "喧烦困蠛蠓，跼蹐疲魍魉。",
        "寸进谅何营，寻直非所枉。",
        "探奇极遥瞩，穷妙閟清响。",
        "理会方在今，神开庶殊曩。",
        "兹游苟不嗣，浩气竟谁养。",
        "道异诚所希，名宾匪余仗。",
        "超摅藉外奖，俯默有内朗。",
        "鉴尔揖古风，终焉乃吾党。",
        "潜躯委缰锁，高步谢尘坱。",
        "蓄志徒为劳，追纵将焉倣。",
        "淹留值颓暮，眷恋睇遐壤。",
        "映日雁联轩，翻云波泱漭。",
        "殊风纷已萃，乡路悠且广。",
        "羁木畏漂浮，离旌倦摇荡。",
        "昔人叹违志，出处今已两。",
        "何用期所归，浮图有遗像。",
        "幽蹊不盈尺，虚室有函丈。",
        "微言信可传，申旦稽吾颡。"
      ],
      "author": {
        "id": 1331,
        "name": "柳宗元"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 264870,
      "title": "游朝阳岩遂登西亭二十韵",
      "content": [
        "谪弃殊隐沦，登陟非远郊。",
        "所怀缓伊郁，讵欲肩夷巢。",
        "高岩瞰清江，幽窟潜神蛟。",
        "开旷延阳景，廻薄攒林梢。",
        "西亭搆其巓，反字临呀庨。",
        "背瞻星辰兴，下见云雨交。",
        "惜非吾乡土，得以荫菁茆。",
        "羁贯去江介，世仕尚函崤。",
        "故墅即沣川，数亩均肥硗。",
        "台馆葺荒丘，池塘疏沈坳。",
        "会有圭组恋，遂贻山林嘲。",
        "薄躯信无庸，琐屑剧斗筲。",
        "囚居固其宜，厚羞久已包。",
        "庭除植蓬艾，隟牖悬蟏蛸。",
        "所赖山川客，扁舟枉长梢。",
        "挹流敌清觞，掇野代嘉肴。",
        "适道有高言，取乐非弦匏。",
        "逍遥屏幽昧，淡薄辞喧呶。",
        "晨鸡不余欺，风雨闻嘐嘐。",
        "再期永日闲，提挈移中庖。"
      ],
      "author": {
        "id": 1331,
        "name": "柳宗元"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 264871,
      "title": "湘口馆潇湘二水所会",
      "content": [
        "九疑濬倾奔，临源委萦廻。",
        "会合属空旷，泓澄停风雷。",
        "高馆轩霞表，危楼临山隈。",
        "兹辰始澂霁，纤云尽褰开。",
        "天秋日正中，水碧无尘埃。",
        "杳杳渔父吟，呌呌羁鸿哀。",
        "境胜岂不豫，虑分固难裁。",
        "升高欲自舒，弥使远念来。",
        "归流驶且广，泛舟绝沿洄。"
      ],
      "author": {
        "id": 1331,
        "name": "柳宗元"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 264872,
      "title": "登蒲州石矶望横江口潭岛深逈斜对香零山",
      "content": [
        "隐忧倦永夜，凌雾临江津。",
        "猿鸣稍已疎，登石娱清沦。",
        "日出洲渚静，澄明皛无垠。",
        "浮晖翻高禽，沈景照文鳞。",
        "双江汇西奔，诡怪潜坤珍。",
        "孤山乃北峙，森爽栖灵神。",
        "洄潭或动容，岛屿疑摇振。",
        "陶埴兹择土，蒲鱼相与邻。",
        "信美非所安，羁心屡逡巡。",
        "𫄙结良可解，纡郁亦已伸。",
        "高歌返故室，自𫍬非所欣。"
      ],
      "author": {
        "id": 1331,
        "name": "柳宗元"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 264873,
      "title": "南磵中题",
      "content": [
        "秋气集南磵，独游亭午时。",
        "廻风一萧瑟，林影久参差。",
        "始至若有得，稍深遂忘疲。",
        "羁禽响幽谷，寒藻舞沦漪。",
        "去国魂已远，怀人泪空垂。",
        "孤生易为感，失路少所宜。",
        "索寞竟何事，徘徊秖自知。",
        "谁为后来者，当与此心期。"
      ],
      "author": {
        "id": 1331,
        "name": "柳宗元"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 264874,
      "title": "游石角过小岭至长乌村",
      "content": [
        "志适不期贵，道存岂偷生。",
        "久忘上封事，复笑升天行。",
        "窜逐宦湘浦，摇心剧悬旌。",
        "始惊陷世议，终欲逃天刑。",
        "岁月杀忧栗，慵疎寡将迎。",
        "追游疑所爱，且复舒吾情。",
        "石角恣幽步，长乌遂遐征。",
        "磴廻茂树断，景晏寒川明。",
        "旷望少行人，时闻田鹳鸣。",
        "风篁冒水远，霜稻侵山平。",
        "稍与人事闲，益知身世轻。",
        "为农信可乐，居宠真虚荣。",
        "乔木余故国，愿言果丹诚。",
        "四支反田亩，释至东臯耕。"
      ],
      "author": {
        "id": 1331,
        "name": "柳宗元"
