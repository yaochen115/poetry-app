{
  "data": [
    {
      "id": 337723,
      "title": "辛丑岁十月上幸长安时扈从出西岳作",
      "content": [
        "西镇何穹崇，壮哉信灵造。",
        "诸岭皆峻秀，中峰特美好。",
        "傍见巨掌存，势如石东倒。",
        "颇闻首阳去，开坼此河道。",
        "磅礴压洪源，巍峨壮清昊。",
        "云泉纷乱瀑，天磴屹横抱。",
        "子先呼其巅，宫女世不老。",
        "下有府君庙，历载传洒扫。",
        "皇明应天游，十月戒丰镐。",
        "微末忝闲从，兼得事苹藻。",
        "宿心爱兹山，意欲拾灵草。",
        "阴壑已永閟，云窦绝探讨。",
        "芳月期来过，回策思方浩。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 337724,
      "title": "和杜麟台元志春情",
      "content": [
        "嘉树满中园，氛氲罗秀色。",
        "不见仙山云，倚琴空太息。",
        "沉思若在梦，缄怨似无忆。",
        "青春坐南移，白日忽西匿。",
        "蛾眉返清镜，闺中不相识。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 337729,
      "title": "同工部李侍郎适访司马子微",
      "content": [
        "紫微降天仙，丹地投云藻。",
        "上言华顶事，中问长生道。",
        "华顶居最高，大壑朝阳早。",
        "长生术何妙，童颜后天老。",
        "清晨朝凤京，静夜思鸿宝。",
        "凭崖饮蕙气，过涧摘灵草。",
        "人非冢已荒，海变田应燥。",
        "昔尝游此郡，三霜弄溟岛。",
        "绪言霞上开，机事尘外扫。",
        "顷来迫世务，清旷未云保。",
        "崎岖待漏恩，怵惕司言造。",
        "轩皇重斋拜，汉武爱祈祷。",
        "顺风怀崆峒，承露在丰镐。",
        "泠然委轻驭，复得散幽抱。",
        "柱下留伯阳，储闱登四皓。",
        "闻有参同契，何时一探讨。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 337730,
      "title": "自昌乐郡溯流至白石岭下行入郴州",
      "content": [
        "兹山界夷夏，天险横寥廓。",
        "太史漏登探，文命限开凿。",
        "北流自南泻，群峰回众壑。",
        "驰波如电腾，激石似雷落。",
        "崖留盘古树，涧蓄神农药。",
        "乳窦何淋漓，苔藓更彩错。",
        "娟娟潭里虹，渺渺滩边鹤。",
        "岁杪应流火，天高云物薄。",
        "金风吹绿梢，玉露洗红箨。",
        "溯舟始兴廨，登践桂阳郭。",
        "匍匐缘修阪，穹窿曳长dh。",
        "碍林阻往来，遇堰每前却。",
        "救艰不遑饭，毕昏无暇泊。",
        "濯溪宁足惧，磴道谁云恶。",
        "我行山水间，湍险皆不若。",
        "安能独见闻，书此贻京洛。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 337732,
      "title": "入卫作",
      "content": [
        "淇上风日好，纷纷沿岸多。",
        "绿芳幸未歇，泛滥此明波。",
        "采蘩忆幽吹，理棹想荆歌。",
        "郁然怀君子，浩旷将如何。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 337733,
      "title": "夜泊越州逢北使",
      "content": [
        "天地降雷雨，放逐还国都。",
        "重以风潮事，年月戒回舻。",
        "容颜荒外老，心想域中愚。",
        "憩泊在兹夜，炎云逐斗枢。",
        "k3k4萦海若，霹雳耿天吴。",
        "鼇抃群岛失，鲸吞众流输。",
        "偶逢金华使，握手泪相濡。",
        "饥共噬齐枣，眠共席秦蒲。",
        "既北思攸济，将南睿所图。",
        "往来固无咎，何忽惮前桴。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 337734,
      "title": "绍隆寺",
      "content": [
        "吾从释迦久，无上师涅盘。",
        "探道三十载，得道天南端。",
        "非胜适殊方，起喧归理难。",
        "放弃乃良缘，世虑不曾干。",
        "香界萦北渚，花龛隐南峦。",
        "危昂阶下石，演漾窗中澜。",
        "云盖看木秀，天空见藤盘。",
        "处俗勒宴坐，居贫业行坛。",
        "试将有漏躯，聊作无生观。",
        "了然究诸品，弥觉静者安。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 337735,
      "title": "神龙初废逐南荒途出郴口北望苏耽山",
      "content": [
        "少曾读仙史，知有苏耽君。",
        "流望来南国，依然会昔闻。",
        "泊舟问耆老，遥指孤山云。",
        "孤山郴郡北，不与众山群。",
        "重崖下萦映，嶛峣上纠纷。",
        "碧峰泉附落，红壁树傍分。",
        "选地今方尔，升天因可云。",
        "不才予窜迹，羽化子遗芬。",
        "将览成麟凤，旋惊御鬼文。",
        "此中迷出处，含思独氛氲。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 337736,
      "title": "初达驩州",
      "content": [
        "流子一十八，命予偏不偶。",
        "配远天遂穷，到迟日最后。",
        "水行儋耳国，陆行雕题薮。",
        "魂魄游鬼门，骸骨遗鲸口。",
        "夜则忍饥卧，朝则抱病走。",
        "搔首向南荒，拭泪看北斗。",
        "何年赦书来，重饮洛阳酒。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 337737,
      "title": "被弹",
      "content": [
        "知人昔不易，举非贵易失。",
        "尔何按国章，无罪见呵叱。",
        "平生守直道，遂为众所嫉。",
        "少以文作吏，手不曾开律。",
        "一旦法相持，荒忙意如漆。",
        "幼子双囹圄，老夫一念室。",
        "昆弟两三人，相次俱囚桎。",
        "万铄当众怒，千谤无片实。",
        "庶以白黑谗，显此泾渭质。",
        "劾吏何咆哮，晨夜闻扑抶。",
        "事间拾虚证，理外存枉笔。",
        "怀痛不见伸，抱冤竟难悉。",
        "穷囚多垢腻，愁坐饶虮虱。",
        "三日唯一饭，两旬不再栉。",
        "是时盛夏中，暵赫多瘵疾。",
        "瞪目眠欲闭，喑呜气不出。",
        "有风自扶摇，鼓荡无伦匹。",
        "安得吹浮云，令我见白日。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 337738,
      "title": "枉系二首",
      "content": [
        "吾怜曾家子，昔有投杼疑。",
        "吾怜姬公旦，非无鸱鸮诗。",
        "臣子竭忠孝，君亲惑谗欺。",
        "萋斐离骨肉，含愁兴此辞。",
        "昔日公冶长，非罪遇缧絏。",
        "圣人降其子，古来叹独绝。",
        "我无毫发瑕，苦心怀冰雪。",
        "今代多秀士，谁能继明辙。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 337740,
      "title": "伤王学士",
      "content": [
        "闭囚断外事，昧坐半余期。",
        "有言颖叔子，亡来已一时。",
        "初闻宛不信，中话涕涟洏。",
        "痛哉玄夜重，何遽青春姿。",
        "忆汝曾旅食，屡空瀍涧湄。",
        "吾徒禄未厚，筲斗愧相贻。",
        "原宪贫无愁，颜回乐自持。",
        "诏书择才善，君为王子师。",
        "宠儒名可尚，论秩官犹欺。",
        "化往不复见，情来安可思。",
        "目绝毫翰洒，耳无歌讽期。",
        "灵柩寄何处，精魂今何之。",
        "恨予在丹棘，不得看素旗。",
        "孀妻知己叹，幼子路人悲。",
        "感游值商日，绝弦留此词。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 337741,
      "title": "古镜",
      "content": [
        "莓苔翳清池，虾蟆蚀明月。",
        "埋落今如此，照心未尝歇。",
        "愿垂拂拭恩，为君鉴玄发。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 337742,
      "title": "凤箫曲",
      "content": [
        "八月凉风动高阁，千金丽人卷绡幕。",
        "已怜池上歇芳菲，",
        "飞燕侍寝昭阳殿，班姬饮恨长信宫。",
        "长信宫，昭阳殿，"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 337743,
      "title": "古歌",
      "content": [
        "落叶流风向玉台，夜寒秋思洞房开。",
        "水晶帘外金波下，",
        "璿闺窈窕秋夜长，绣户徘徊明月光。",
        "燕姬彩帐芙蓉色，"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 337744,
      "title": "七夕曝衣篇",
      "content": [
        "君不见昔日宜春太液边，披香画阁与天连。",
        "灯火灼烁九微映，香气氛氲百和然。",
        "此夜星繁河正白，",
        "曝衣何许曛半黄，宫中彩女提玉箱。",
        "珠履奔腾上兰砌，",
        "朝霞散彩羞衣架，晚月分光劣镜台。",
        "上有仙人长命绺，",
        "椒房金屋宠新流，意气骄奢不自由。",
        "汉文宜惜露台费，"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 337745,
      "title": "入少密溪",
      "content": [
        "云峰苔壁绕溪斜，江路香风夹岸花。",
        "树密不言通鸟道，",
        "游鱼瞥瞥双钓童，伐木丁丁一樵叟。",
        "自言避喧非避秦，"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 337746,
      "title": "霹雳引",
      "content": [
        "岁七月，火伏而金生。",
        "客有鼓琴于门者，奏霹雳之商声。",
        "始戛羽以騞砉，终扣宫而砰駖。",
        "电耀耀兮龙跃，",
        "有如驱千旗，制五兵；截荒虺，斫长鲸。",
        "孰与广陵比，"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 337748,
      "title": "晦日浐水应制",
      "content": [
        "素浐接宸居，青门盛祓除。",
        "摘兰喧凤野，浮藻溢龙渠。",
        "苑蝶飞殊懒，宫莺啭不疏。",
        "星移天上入，歌舞向储胥。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 337749,
      "title": "奉和洛阳玩雪应制",
      "content": [
        "周王甲子旦，汉后德阳宫。",
        "洒瑞天庭里，惊春御苑中。",
        "氛氲生浩气，飒遝舞回风。",
        "宸藻光盈尺，赓歌乐岁丰。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 337751,
      "title": "幸梨园亭观打球应制",
      "content": [
        "今春芳苑游，接武上琼楼。",
        "宛转萦香骑，飘飖拂画球。",
        "俯身迎未落，回辔逐傍流。",
        "只为看花鸟，时时误失筹。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 337752,
      "title": "九日临渭亭侍宴应制得长字",
      "content": [
        "御气幸金方，凭高荐羽觞。",
        "魏文颁菊蕊，汉武赐萸房。",
        "秋变铜池色，晴添银树光。",
        "年年重九庆，日月奉天长。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 337754,
      "title": "安乐公主移入新宅",
      "content": [
        "初闻衡汉来，移住斗城隈。",
        "锦帐迎风转，琼筵拂雾开。",
        "马香遗旧埒，风吹绕新台。",
        "为问沈冥子，仙槎何处回。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 337756,
      "title": "送金城公主适西蕃应制",
      "content": [
        "金榜扶丹掖，银河属紫阍。",
        "那堪将凤女，还以嫁乌孙。",
        "玉就歌中怨，珠辞掌上恩。",
        "西戎非我匹，明主至公存。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 337762,
      "title": "巫山高二首",
      "content": [
        "巫山峰十二，合遝隐昭回。",
        "俯眺琵琶峡，平看云雨台。",
        "古槎天外倚，瀑水日边来。",
        "何忍猿啼夜，荆王枕席开。",
        "神女向高唐，巫山下夕阳。",
        "裴回作行雨，婉娈逐荆王。",
        "电影江前落，雷声峡外长。",
        "霁云无处所，台馆晓苍苍。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 337763,
      "title": "巫山高",
      "content": [
        "巫山高不极，合遝状奇新。",
        "暗谷疑风雨，阴崖若鬼神。",
        "月明三峡曙，潮满九江春。",
        "为问阳台客，应知入梦人。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 337766,
      "title": "奉和圣制同皇太子游慈恩寺应制",
      "content": [
        "肃肃莲花界，荧荧贝叶宫。",
        "金人来梦里，白马出城中。",
        "涌塔初从地，焚香欲遍空。",
        "天歌应春钥，非是为春风。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 337768,
      "title": "寿阳王花烛",
      "content": [
        "仙媛乘龙夕，天孙捧雁来。",
        "可怜桃李树，更绕凤凰台。",
        "烛送香车入，花临宝扇开。",
        "莫令银箭晓，为尽合欢杯。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 337769,
      "title": "陇头水",
      "content": [
        "陇山飞落叶，陇雁度寒天。",
        "愁见三秋水，分为两地泉。",
        "西流入羌郡，东下向秦川。",
        "征客重回首，肝肠空自怜。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 337771,
      "title": "折杨柳",
      "content": [
        "玉窗朝日映，罗帐春风吹。",
        "拭泪攀杨柳，长条踠地垂。",
        "白花飞历乱，黄鸟思参差。",
        "妾自肝肠断，傍人那得知。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 337775,
      "title": "王昭君",
      "content": [
        "非君惜鸾殿，非妾妒蛾眉。",
        "薄命由骄虏，无情是画师。",
        "嫁来胡地日，不并汉宫时。",
        "心苦无聊赖，何堪马上辞。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 337776,
      "title": "被试出塞",
      "content": [
        "十年通大漠，万里出长平。",
        "寒日生戈剑，阴云拂旆旌。",
        "饥乌啼旧垒，疲马恋空城。",
        "辛苦皋兰北，胡霜损汉兵。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 337778,
      "title": "杂诗三首",
      "content": [
        "落叶惊秋妇，高砧促暝机。",
        "蜘蛛寻月度，萤火傍人飞。",
        "清镜红埃入，孤灯绿焰微。",
        "怨啼能至晓，独自懒缝衣。",
        "妾家临渭北，春梦著辽西。",
        "何苦朝鲜郡，年年事鼓鼙。",
        "燕来红壁语，莺向绿窗啼。",
        "为许长相忆，阑干玉箸齐。",
        "闻道黄龙戍，频年不解兵。",
        "可怜闺里月，长在汉家营。",
        "少妇今春意，良人昨夜情。",
        "谁能将旗鼓，一为取龙城。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 337779,
      "title": "剪彩",
      "content": [
        "宫女怜芳树，裁花竞早荣。",
        "寒依刀尺尽，春向绮罗生。",
        "弱蒂盘丝发，香蕤结素成。",
        "纤枝幸不弃，长就玉阶倾。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 337782,
      "title": "和崔正谏登秋日早朝",
      "content": [
        "鸡鸣朝谒满，露白禁门秋。",
        "爽气临旌戟，朝光映冕旒。",
        "河宗来献宝，天子命焚裘。",
        "独负池阳议，言从建礼游。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 337784,
      "title": "李舍人山园送庞邵",
      "content": [
        "符传有光辉，喧喧出帝畿。",
        "东邻借山水，南陌驻骖騑。",
        "握手凉风至，当歌秋日微。",
        "高幨去勿缓，人吏待霜威。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 337786,
      "title": "洛州萧司兵谒兄还赴洛成礼",
      "content": [
        "棠棣日光辉，高襟应序归。",
        "来成鸿雁聚，去作凤凰飞。",
        "细草承轻传，惊花惨别衣。",
        "灞亭春有酒，岐路惜芬菲。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 337795,
      "title": "初达驩州",
      "content": [
        "自昔闻铜柱，行来向一年。",
        "不知林邑地，犹隔道明天。",
        "雨露何时及，京华若个边。",
        "思君无限泪，堪作日南泉。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 337796,
      "title": "岭表逢寒食",
      "content": [
        "岭外无寒食，春来不见饧。",
        "洛阳新甲子，何日是清明。",
        "花柳争朝发，轩车满路迎。",
        "帝乡遥可念，肠断报亲情。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 337797,
      "title": "驩州南亭夜望",
      "content": [
        "昨夜南亭望，分明梦洛中。",
        "室家谁道别，儿女案尝同。",
        "忽觉犹言是，沉思始悟空。",
        "肝肠余几寸，拭泪坐春风。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 337799,
      "title": "咸阳览古",
      "content": [
        "咸阳秦帝居，千载坐盈虚。",
        "版筑林光尽，坛场溜听疏。",
        "野桥疑望日，山火类焚书。",
        "唯有骊峰在，空闻厚葬余。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 337801,
      "title": "题椰子树",
      "content": [
        "日南椰子树，香袅出风尘。",
        "丛生调木首，圆实槟榔身。",
        "玉房九霄露，碧叶四时春。",
        "不及涂林果，移根随汉臣。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 337802,
      "title": "同狱者叹狱中无燕",
      "content": [
        "何许乘春燕，多知辨夏台。",
        "三时欲并尽，双影未尝来。",
        "食蕊嫌丛棘，衔泥怯死灰。",
        "不如黄雀语，能雪冶长猜。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 337805,
      "title": "秦州薛都督挽词",
      "content": [
        "十里绛山幽，千年汾水流。",
        "碑传门客建，剑是故人留。",
        "陇树烟含夕，山门月对秋。",
        "古来钟鼎盛，共尽一蒿丘。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 337806,
      "title": "天官崔侍郎夫人卢氏挽歌",
      "content": [
        "偕老言何谬，香魂事永违。",
        "潘鱼从此隔，陈凤宛然飞。",
        "埋镜泉中暗，藏镫地下微。",
        "犹凭少君术，仿佛睹容辉。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 337808,
      "title": "奉和立春游苑迎春",
      "content": [
        "东郊暂转迎春仗，上苑初飞行庆杯。",
        "风射蛟冰千片断，",
        "歌吹衔恩归路晚，栖乌半下凤城来。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 337809,
      "title": "人日重宴大明宫赐彩缕人胜应制",
      "content": [
        "拂旦鸡鸣仙卫陈，凭高龙首帝城春。",
        "千官黼帐杯前寿，",
        "天文正应韶光转，设报悬知用此辰。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 337810,
      "title": "奉和春初幸太平公主南庄应制",
      "content": [
        "主家山第早春归，御辇春游绕翠微。",
        "买地铺金曾作埒，",
        "自有神仙鸣凤曲，并将歌舞报恩晖。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 337811,
      "title": "奉和春日幸望春宫应制",
      "content": [
        "芳郊绿野散春晴，复道离宫烟雾生。",
        "杨柳千条花欲绽，",
        "定是风光牵宿醉，来晨复得幸昆明。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 337812,
      "title": "侍宴安乐公主新宅应制",
      "content": [
        "皇家贵主好神仙，别业初开云汉边。",
        "山出尽如鸣凤岭，",
        "敬从乘舆来此地，称觞献寿乐钧天。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 337813,
      "title": "龙池篇",
      "content": [
        "龙池跃龙龙已飞，龙德先天天不违。",
        "池开天汉分黄道，",
        "为报寰中百川水，来朝此地莫东归。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 337814,
      "title": "兴庆池侍宴应制",
      "content": [
        "碧水澄潭映远空，紫云香驾御微风。",
        "汉家城阙疑天上，",
        "古来徒羡横汾赏，今日宸游圣藻雄。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 337815,
      "title": "从幸香山寺应制",
      "content": [
        "南山奕奕通丹禁，北阙峨峨连翠云。",
        "岭上楼台千地起，",
        "愿以醍醐参圣酒，还将祇苑当秋汾。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 337816,
      "title": "红楼院应制",
      "content": [
        "红楼疑见白毫光，寺逼宸居福盛唐。",
        "支遁爱山情谩切，",
        "谁谓此中难可到，自怜深院得徊翔。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 337817,
      "title": "再入道场纪事应制",
      "content": [
        "南方归去再生天，内殿今年异昔年。",
        "见辟乾坤新定位，",
        "自喜恩深陪侍从，两朝长在圣人前。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 337818,
      "title": "嵩山石淙侍宴应制",
      "content": [
        "金舆旦下绿云衢，彩殿晴临碧涧隅。",
        "溪水泠泠杂行漏，",
        "自惜汾阳纡道驾，无如太室览真图。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 337819,
      "title": "古意呈补阙乔知之",
      "content": [
        "卢家少妇郁金堂，海燕双栖玳瑁梁。",
        "九月寒砧催木叶，",
        "谁谓含愁独不见，更教明月照流黄。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 337820,
      "title": "遥同杜员外审言过岭",
      "content": [
        "天长地阔岭头分，去国离家见白云。",
        "洛浦风光何所似，",
        "两地江山万余里，何时重谒圣明君。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 337821,
      "title": "和上巳连寒食有怀京洛",
      "content": [
        "天津御柳碧遥遥，轩骑相从半下朝。",
        "行乐光辉寒食借，",
        "坐见司空扫西第，看君侍从落花朝。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 337822,
      "title": "陪幸太平公主南庄诗",
      "content": [
        "主第山门起灞川，宸游风景入初年。",
        "凤凰楼下交天仗，",
        "今朝扈跸平阳馆，不羡乘槎云汉边。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 337823,
      "title": "守岁应制",
      "content": [
        "南渡轻冰解渭桥，东方树色起招摇。",
        "天子迎春取今夜，",
        "宜将岁酒调神药，圣祚千春万国朝。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 337824,
      "title": "陪幸韦嗣立山庄",
      "content": [
        "台阶好赤松，别业对青峰。",
        "茆室承三顾，花源接九重。",
        "虹旗萦秀木，凤辇拂疏筇。",
        "径直千官拥，溪长万骑容。",
        "水堂开禹膳，山阁献尧钟。",
        "皇鉴清居远，天文睿奖浓。",
        "岩泉他夕梦，渔钓往年逢。",
        "共荣丞相府，偏降逸人封。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 337825,
      "title": "扈从出长安应制",
      "content": [
        "汉宅规模壮，周都景命隆。",
        "西宾让东主，法驾幸天中。",
        "太史占星应，春官奏日同。",
        "旌门起长乐，帐殿出新丰。",
        "翕习黄山下，纡徐清渭东。",
        "金麾张画月，珠幰戴松风。",
        "是节严阴始，寒郊散野蓬。",
        "薄霜沾上路，残雪绕离宫。",
        "赐帛矜耆老，褰旒问小童。",
        "复除恩载洽，望秩礼新崇。",
        "臣忝承明召，多惭献赋雄。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 337830,
      "title": "奉和晦日驾幸昆明池应制",
      "content": [
        "法驾乘春转，神池象汉回。",
        "双星移旧石，孤月隐残灰。",
        "战鹢逢时去，恩鱼望幸来。",
        "山花缇绮绕，堤柳幔城开。",
        "思逸横汾唱，欢留宴镐杯。",
        "微臣雕朽质，羞睹豫章材。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 337831,
      "title": "奉和圣制幸礼部尚书窦希玠宅",
      "content": [
        "北阙垂旒暇，南宫听履回。",
        "天临翔凤转，恩向跃龙开。",
        "兰气熏仙帐，榴花引御杯。",
        "水从金穴吐，云是玉衣来。",
        "池影摇歌席，林香散舞台。",
        "不知行漏晚，清跸尚裴徊。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 337832,
      "title": "钓竿篇",
      "content": [
        "朝日敛红烟，垂竿向绿川。",
        "人疑天上坐，鱼似镜中悬。",
        "避楫时惊透，猜钩每误牵。",
        "湍危不理辖，潭静欲留船。",
        "钓玉君徒尚，征金我未贤。",
        "为看芳饵下，贪得会无筌。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 337833,
      "title": "和户部岑尚书参迹枢揆",
      "content": [
        "大君制六合，良佐参万机。",
        "大业永开泰，臣道日光辉。",
        "盐梅和鼎食，家声众所归。",
        "汉章题楚剑，郑武袭缁衣。",
        "理识当朝远，文华振古希。",
        "风云神契合，舟楫道心微。",
        "庙堂喜容与，时物递芳菲。",
        "御柳垂仙掖，公槐覆礼闱。",
        "昔陪鹓鹭后，今望鶤鹏飞。",
        "徒御清风颂，巴歌聊自挥。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 337834,
      "title": "同李舍人冬日集安乐公主山池",
      "content": [
        "尝闻天女贵，家即帝宫连。",
        "亭插宜春果，山冲太液泉。",
        "桥低乌鹊夜，台起凤凰年。",
        "故事犹如此，新图更可怜。",
        "紫岩妆阁透，青嶂妓楼悬。",
        "峰夺香炉巧，池偷明镜圆。",
        "梅花寒待雪，桂叶晚留烟。",
        "兴尽方投辖，金声还复传。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 337835,
      "title": "酬苏员外味道夏晚寓直省中见赠",
      "content": [
        "并命登仙阁，分曹直礼闱。",
        "大官供宿膳，侍史护朝衣。",
        "卷幔天河入，开窗月露微。",
        "小池残暑退，高树早凉归。",
        "冠剑无时释，轩车待漏飞。",
        "明朝题汉柱，三署有光辉。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 337836,
      "title": "和韦舍人早朝",
      "content": [
        "阊阖连云起，岩廊拂雾开。",
        "玉珂龙影度，珠履雁行来。",
        "长乐宵钟尽，明光晓奏催。",
        "一经推旧德，五字擢英才。",
        "俨若神仙去，纷从霄汉回。",
        "千春奉休历，分禁喜趋陪。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 337837,
      "title": "自考功员外授给事中",
      "content": [
        "南省推丹地，东曹拜琐闱。",
        "惠移双管笔，恩降五时衣。",
        "出入宜真选，遭逢每滥飞。",
        "器惭公理拙，才谢子云微。",
        "案牍遗常礼，朋僚隔等威。",
        "上台行揖让，中禁动光辉。",
        "旭日千门起，初春八舍归。",
        "赠兰闻宿昔，谈树隐芳菲。",
        "何幸盐梅处，唯忧对问机。",
        "省躬知任重，宁止冒荣非。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 337838,
      "title": "和元舍人万顷临池玩月戏为新体",
      "content": [
        "春风摇碧树，秋雾卷丹台。",
        "复有相宜夕，池清月正开。",
        "玉流含吹动，金魄度云来。",
        "熠爚光如沸，翩翾景若摧。",
        "半环投积草，碎璧聚流杯。",
        "夜久平无焕，天晴皎未隤。",
        "镜将池作匣，珠以岸为胎。",
        "有美司言暇，高兴独悠哉。",
        "挥翰初难拟，飞名岂易陪。",
        "夜光殊在握，了了见沉灰。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 337839,
      "title": "酬杨给事兼见赠台中",
      "content": [
        "子云推辨博，公理擅词雄。",
        "始自尚书省，旋闻给事中。",
        "言从温室秘，籍向琐闱通。",
        "顾我叨郎署，惭无草奏功。",
        "分曹八舍断，解袂五时空。",
        "宿昔陪余论，平生赖击蒙。",
        "神仙应东掖，云雾限南宫。",
        "忽枉琼瑶赠，长歌兰渚风。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 337840,
      "title": "九真山净居寺谒无碍上人",
      "content": [
        "大士生天竺，分身化日南。",
        "人中出烦恼，山下即伽蓝。",
        "小涧香为刹，危峰石作龛。",
        "候禅青鸽乳，窥讲白猿参。",
        "藤爱云间壁，花怜石下潭。",
        "泉行幽供好，林挂浴衣堪。",
        "弟子哀无识，医王惜未谈。",
        "机疑闻不二，蒙昧即朝三。",
        "欲究因缘理，聊宽放弃惭。",
        "超然虎溪夕，双树下虚岚。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 337841,
      "title": "夜游",
      "content": [
        "今夕重门启，游春得夜芳。",
        "月华连昼色，灯影杂星光。",
        "南陌青丝骑，东邻红粉妆。",
        "管弦遥辨曲，罗绮暗闻香。",
        "人拥行歌路，车攒斗舞场。",
        "经过犹未已，钟鼓出长杨。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 337843,
      "title": "塞北二首",
      "content": [
        "虏障天骄起，秦城地脉分。",
        "柏坛飞五将，梅吹动三军。",
        "锋刃奔涛色，旌旗焰火文。",
        "朔风吹汗漫，飘砾洒轒辒。",
        "海气如秋雨，边峰似夏云。",
        "二庭无岁月，百战有功勋。",
        "形影随鱼贯，音书在雁群。",
        "归来拜天子，凯乐助南熏。",
        "胡骑犯边埃，风从丑上来。",
        "五原烽火急，六郡羽书催。",
        "冰壮飞狐冷，霜浓候雁哀。",
        "将军朝授钺，战士夜衔枚。",
        "紫塞金河里，葱山铁勒隈。",
        "莲花秋剑发，桂叶晓旗开。",
        "秘略三军动，妖氛百战摧。",
        "何言投笔去，终作勒铭回。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 337844,
      "title": "李员外秦援宅观妓",
      "content": [
        "盈盈粉署郎，五日宴春光。",
        "选客虚前馆，征声遍后堂。",
        "玉钗翠羽饰，罗袖郁金香。",
        "拂黛随时广，挑鬟出意长。",
        "啭歌遥合态，度舞暗成行。",
        "巧落梅庭里，斜光映晓妆。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 337845,
      "title": "送韦商州弼",
      "content": [
        "会府应文昌，商山镇国阳。",
        "闻君监郡史，暂罢尚书郎。",
        "王事嗟相失，人情贵不忘。",
        "累年同画省，四海接文场。",
        "点翰芳春色，传杯明月光。",
        "故交从此去，遥忆紫芝香。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 337846,
      "title": "夏日梁王席送张岐州",
      "content": [
        "秦鸡常下雍，周凤昔鸣岐。",
        "此地推雄抚，惟良寄在斯。",
        "家传七豹贵，人擅八龙奇。",
        "高传生光彩，长林叹别离。",
        "天人开祖席，朝采候征麾。",
        "翠帟当郊敞，彤幨向野披。",
        "芃芃秋麦盛，苒苒夏条垂。",
        "奏计何时入，台阶望羽仪。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 337849,
      "title": "移禁司刑",
      "content": [
        "畴昔参乡赋，中年忝吏途。",
        "丹唇曾学史，白首不成儒。",
        "天子开昌箓，群生偶大炉。",
        "散材仍葺厦，弱羽遽抟扶。",
        "宠迈乘轩鹤，荣过食稻凫。",
        "何功游画省，何德理黄枢。",
        "吊影惭非据，倾心事远图。",
        "盗泉宁止渴，恶木匪投躯。",
        "任直翻多毁，安身遂少徒。",
        "一朝逢纠谬，三省竟无虞。",
        "白简初心屈，黄纱始望孤。",
        "患平终不怒，持劾每相驱。",
        "埋剑谁当辨，偷金以自诬。",
        "诱言虽委答，流议亦真符。",
        "首夏方忧圄，高秋独向隅。",
        "严城看熠耀，圜户对蜘蛛。",
        "累饷唯妻子，披冤是友于。",
        "物情牵倚伏，人事限荣枯。",
        "门客心谁在，邻交迹倘无。",
        "抚襟双涕落，危坐日忧趋。",
        "圣旨垂明德，冤囚岂滥诛。",
        "会希恩免理，终望罪矜愚。",
        "司寇宜哀狱，台庭幸恤辜。",
        "汉皇虚诏上，容有报恩珠。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 337850,
      "title": "入鬼门关",
      "content": [
        "昔传瘴江路，今到鬼门关。",
        "土地无人老，流移几客还。",
        "自从别京洛，颓鬓与衰颜。",
        "夕宿含沙里，晨行冈路间。",
        "马危千仞谷，舟险万重湾。",
        "问我投何地，西南尽百蛮。"
      ],
      "author": {
        "id": 5932,
