{
  "data": [
    {
      "id": 357940,
      "title": "过旧宅",
      "content": [
        "古巷戟门谁旧宅，早曾闻说属官家。",
        "更无新燕来巢屋，",
        "荣华事歇皆如此，立马踟蹰到日斜。"
      ],
      "author": {
        "id": 4645,
        "name": "朱庆余"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 357941,
      "title": "鄂渚送白舍人赴杭州",
      "content": [
        "岂知鹦鹉洲边路，得见凤凰池上人。",
        "从此不同诸客礼，故乡西与郡城邻。"
      ],
      "author": {
        "id": 4645,
        "name": "朱庆余"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 357942,
      "title": "题崔驸马林亭",
      "content": [
        "选居幽近御街东，易得诗人聚会同。",
        "白练鸟飞深竹里，",
        "何事宦涂犹寂寞，都缘清苦道难通。"
      ],
      "author": {
        "id": 4645,
        "name": "朱庆余"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 357943,
      "title": "赠韩协律",
      "content": [
        "永日微吟在竹前，骨清唯爱漱寒泉。",
        "门闲多有投文客，",
        "亲知尽怪疏荣禄，的是将心暗学禅。"
      ],
      "author": {
        "id": 4645,
        "name": "朱庆余"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 357944,
      "title": "自萧关望临洮",
      "content": [
        "玉关西路出临洮，风卷边沙入马毛。",
        "寺寺院中无竹树，",
        "日暮独吟秋色里，平原一望戍楼高。"
      ],
      "author": {
        "id": 4645,
        "name": "朱庆余"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 357945,
      "title": "送崔约下第归淮南觐省",
      "content": [
        "远忆拜亲留不住，出门行计与谁同。",
        "程涂半是依船上，",
        "回期须及来春事，莫便江边逐钓翁。"
      ],
      "author": {
        "id": 4645,
        "name": "朱庆余"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 357946,
      "title": "羽林郎",
      "content": [
        "紫髯年少奉恩初，直阁将军尽不如。",
        "酒后引兵围百草，",
        "大笑鲁儒年四十，腰间犹未识金鱼。"
      ],
      "author": {
        "id": 4645,
        "name": "朱庆余"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 357947,
      "title": "归故园",
      "content": [
        "桑柘骈阗数亩间，门前五柳正堪攀。",
        "尊中美酒长须满，",
        "于焉已是忘机地，何用将金别买山。"
      ],
      "author": {
        "id": 4645,
        "name": "朱庆余"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 357953,
      "title": "送长安罗少府",
      "content": [
        "科名再得年犹少，今日休官更觉贤。",
        "去国已辞趋府伴，",
        "在处若逢山水住，到时应不及秋前。"
      ],
      "author": {
        "id": 4645,
        "name": "朱庆余"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 357957,
      "title": "题王丘长史宅",
      "content": [
        "更无人吏在门前，不似居官似学仙。",
        "药气暗侵朝服上，",
        "时见街中骑瘦马，低头只是为诗篇。"
      ],
      "author": {
        "id": 4645,
        "name": "朱庆余"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 357959,
      "title": "哭胡遇",
      "content": [
        "寻僧昨日尚相随，忽见绯幡意可知。",
        "题处旧诗休更读，",
        "每向宣阳里中过，遥闻哭临泪先垂。"
      ],
      "author": {
        "id": 4645,
        "name": "朱庆余"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 357962,
      "title": "送崔拾遗赴阙",
      "content": [
        "清貌凌寒玉，朝来拜拾遗。",
        "行承天子诏，去感主人知。",
        "剑佩分班日，风霜独立时。",
        "名高住不得，非与九霄期。"
      ],
      "author": {
        "id": 4645,
        "name": "朱庆余"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 357964,
      "title": "送僧游温州",
      "content": [
        "夏满随所适，江湖非系缘。",
        "卷经离峤寺，隔苇上秋船。",
        "水落无风夜，猿啼欲雨天。",
        "石门期独往，谢守有遗篇。"
      ],
      "author": {
        "id": 4645,
        "name": "朱庆余"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 357965,
      "title": "梦谢亭",
      "content": [
        "梦后何人见，孤亭似旧时。",
        "褰开诚得地，冥感竟因诗。",
        "不往过应少，悲来下独迟。",
        "顾惭非谢客，灵贶杳难追。"
      ],
      "author": {
        "id": 4645,
        "name": "朱庆余"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 357966,
      "title": "河亭",
      "content": [
        "孤亭临绝岸，猿鸟识幽蹊。",
        "花落曾谁到，诗成独未题。",
        "潮痕经雨在，石笋与杉齐。",
        "谢守便登陟，秋来屐齿低。"
      ],
      "author": {
        "id": 4645,
        "name": "朱庆余"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 357967,
      "title": "送吴秀才之山西",
      "content": [
        "泽潞西边路，兰桡北去人。",
        "出门谁恨别，投分不缘贫。",
        "杯酒从年少，知音在日新。",
        "东湖发诗意，夏卉竟如春。"
      ],
      "author": {
        "id": 4645,
        "name": "朱庆余"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 357969,
      "title": "秋宵宴别卢侍御",
      "content": [
        "风亭弦管绝，玉漏一声新。",
        "绿茗香醒酒，寒灯静照人。",
        "清班无意恋，素业本来贫。",
        "明发青山道，谁逢去马尘。"
      ],
      "author": {
        "id": 4645,
        "name": "朱庆余"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 357970,
      "title": "酬于欣校书见贻",
      "content": [
        "能□得从军，清嬴□□□。",
        "绮罗徒满目，山水不离心。",
        "暂别愁花老，相思倚竹阴。",
        "家贫无以养，未可话抽簪。"
      ],
      "author": {
        "id": 4645,
        "name": "朱庆余"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 357971,
      "title": "送石协律归吴兴别业",
      "content": [
        "识来无定居，此去复何如。",
        "一与耕者遇，转将朝客疏。",
        "资身唯药草，教子但诗书。",
        "曾许黄庭本，斯言岂合虚。"
      ],
      "author": {
        "id": 4645,
        "name": "朱庆余"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 357981,
      "title": "孔尚书致仕因而有寄赠",
      "content": [
        "高人心易足，三表乞身闲。",
        "与世长疏索，唯僧得往还。",
        "直声留阙下，生事在林间。",
        "时复逢清景，乘车看远山。"
      ],
      "author": {
        "id": 4645,
        "name": "朱庆余"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 357982,
      "title": "和处州韦使君新开南溪",
      "content": [
        "地里光图谶，樵人共说深。",
        "悠然想高躅，坐使变荒岑。",
        "疏凿因殊旧，亭台亦自今。",
        "静容猿暂下，闲与鹤同寻。",
        "转旆驯禽起，褰帷瀑溜侵。",
        "石稀潭见底，岚暗树无阴。",
        "跻险难通屐，攀栖称抱琴。",
        "云风开物意，潭水识人心。",
        "携榼巡花遍，移舟惜景沈。",
        "世嫌山水僻，谁伴谢公吟。"
      ],
      "author": {
        "id": 4645,
        "name": "朱庆余"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 357983,
      "title": "送罗先辈书记归后却还闽中留别",
      "content": [
        "同是越人从小别，忽归乡里见皆惊。",
        "湖边访旧知谁在，",
        "况当季父承恩日，廉问南州政已成。"
      ],
      "author": {
        "id": 4645,
        "name": "朱庆余"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 357984,
      "title": "送浙东陆中丞",
      "content": [
        "坐将文教镇藩维，花满东南圣主知。",
        "公务肯容私暂入，",
        "自爱此身居乐土，咏歌林下日忘疲。"
      ],
      "author": {
        "id": 4645,
        "name": "朱庆余"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 357985,
      "title": "送元处士游天台",
      "content": [
        "青冥路口绝人行，独与僧期上赤城。",
        "树列烟岚春更好，",
        "若过石桥看瀑布，不妨高处便题名。"
      ],
      "author": {
        "id": 4645,
        "name": "朱庆余"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 357986,
      "title": "吴兴新堤",
      "content": [
        "春堤一望思无涯，树势还同水势斜。",
        "深映菰蒲三十里，",
        "若与青山长作固，汀洲肯恨柳丝遮。"
      ],
      "author": {
        "id": 4645,
        "name": "朱庆余"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 357987,
      "title": "酬萧员外见寄",
      "content": [
        "麦风吹雨正徘徊，忽报书从郡阁来。",
        "道薄谬应宗伯选，",
        "胜寄幸容溪馆宿，龙钟惭见妓筵开。",
        "倘期霁后陪新兴，"
      ],
      "author": {
        "id": 4645,
        "name": "朱庆余"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 357988,
      "title": "台州郑员外郡斋双鹤",
      "content": [
        "丹顶分明音响别，况闻来处隔云涛。",
        "情悬碧落飞何晚，",
        "仙郎为尔开笼早，莫虑回翔损羽毛。"
      ],
      "author": {
        "id": 4645,
        "name": "朱庆余"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 357989,
      "title": "送窦秀才",
      "content": [
        "江南才子日纷纷，少有篇章得似君。",
        "清话未同山寺宿，",
        "通籍名高年又少，回头应笑晚从军。"
      ],
      "author": {
        "id": 4645,
        "name": "朱庆余"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 357990,
      "title": "送邵州林使君",
      "content": [
        "轩车此去也逢时，地近湘南颇入诗。",
        "一月计程那是远，",
        "想得化行风土变，州人应为立生祠。"
      ],
      "author": {
        "id": 4645,
        "name": "朱庆余"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 357991,
      "title": "送饶州张使君",
      "content": [
        "白头为郡清秋别，山水南行岂觉赊。",
        "楚老只应思入境，",
        "务退唯当吟咏苦，留心曾不在生涯。"
      ],
      "author": {
        "id": 4645,
        "name": "朱庆余"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 357992,
      "title": "题开元寺",
      "content": [
        "西入山门十里程，粉墙书字甚分明。",
        "萧帝坏陵深虎迹，",
        "何必更将空色遣，眼前人事是浮生。"
      ],
      "author": {
        "id": 4645,
        "name": "朱庆余"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 357993,
      "title": "与庞复言携酒望洞庭",
      "content": [
        "南湖春色通平远，贪记诗情忘酒杯。",
        "帆自巴陵山下过，",
        "尽日与君同看望，了然胜见画屏开。"
      ],
      "author": {
        "id": 4645,
        "name": "朱庆余"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 357994,
      "title": "送浙东周判官",
      "content": [
        "久闻从事沧江外，谁谓无官已白头。",
        "来备戎装嘶数骑，",
        "到日重陪丞相宴，镜湖新月在城楼。"
      ],
      "author": {
        "id": 4645,
        "name": "朱庆余"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 357997,
      "title": "望早日",
      "content": [
        "窗下闻鸡后，苍茫映远林。",
        "才分天地色，便禁虎狼心。",
        "是处程涂远，何山洞府深。",
        "此时堪伫望，万象豁尘襟。"
      ],
      "author": {
        "id": 4645,
        "name": "朱庆余"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 357998,
      "title": "旅中秋月有怀",
      "content": [
        "久客未还乡，中秋倍可伤。",
        "暮天飞旅雁，故国在衡阳。",
        "岛外归云迥，林间坠叶黄。",
        "数宵千里梦，时见旧书堂。"
      ],
      "author": {
        "id": 4645,
        "name": "朱庆余"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 358000,
      "title": "行路难",
      "content": [
        "世事浇浮后，艰难向此生。",
        "人心不自足，公道为谁平。",
        "德丧淳风尽，年荒蔓草盈。",
        "堪悲山下路，非只客中行。"
      ],
      "author": {
        "id": 4645,
        "name": "朱庆余"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 358008,
      "title": "宿山居",
      "content": [
        "山店灯前客，酬身未有媒。",
        "乡关贫后别，风雨夜深来。",
        "上国求丹桂，衡门长绿苔。",
        "堪惊双鬓雪，不待岁寒催。"
      ],
      "author": {
        "id": 4645,
        "name": "朱庆余"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 358010,
      "title": "过洞庭",
      "content": [
        "帆挂狂风起，茫茫既往时。",
        "波涛如未息，舟楫亦堪疑。",
        "旅雁投孤岛，长天下四维。",
        "前程有平处，谁敢与心期。"
      ],
      "author": {
        "id": 4645,
        "name": "朱庆余"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 358011,
      "title": "旅中过重阳",
      "content": [
        "一岁重阳至，羁游在异乡。",
        "登高思旧友，满目是穷荒。",
        "草际飞云片，天涯落雁行。",
        "故山篱畔菊，今日为谁黄。"
      ],
      "author": {
        "id": 4645,
        "name": "朱庆余"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 358014,
      "title": "塞下感怀",
      "content": [
        "塞下闲为客，乡心岂易安。",
        "程涂过万里，身事尚孤寒。",
        "竟日风沙急，临秋草木残。",
        "何年方致主，时拂剑尘看。"
      ],
      "author": {
        "id": 4645,
        "name": "朱庆余"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 358015,
      "title": "宿江馆",
      "content": [
        "江馆迢遥处，知音信渐赊。",
        "夜深乡梦觉，窗下月明斜。",
        "起雁看荒草，惊波尚白沙。",
        "那堪动乡思，故国在天涯。"
      ],
      "author": {
        "id": 4645,
        "name": "朱庆余"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 358016,
      "title": "早梅",
      "content": [
        "天然根性异，万物尽难陪。",
        "自古承春早，严冬斗雪开。",
        "艳寒宜雨露，香冷隔尘埃。",
        "堪把依松竹，良涂一处栽。"
      ],
      "author": {
        "id": 4645,
        "name": "朱庆余"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 358017,
      "title": "夏日访贞上人院",
      "content": [
        "炎夏寻灵境，高僧澹荡中。",
        "命棋隈绿竹，尽日有清风。",
        "流水离经阁，闲云入梵宫。",
        "此时袪万虑，直似出尘笼。"
      ],
      "author": {
        "id": 4645,
        "name": "朱庆余"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 358019,
      "title": "赠至寂禅师",
      "content": [
        "处世唯据衲，禅门几岁寒。",
        "法空无所染，性悟不多看。",
        "竟日门长掩，相逢草自残。",
        "有时寻道侣，飞锡度峰峦。"
      ],
      "author": {
        "id": 4645,
        "name": "朱庆余"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 358021,
      "title": "废宅花",
      "content": [
        "数树荒庭上，芬芳映绿苔。",
        "自缘逢暖发，不是为人开。",
        "色艳莺犹在，香消蝶已回。",
        "相从无胜事，谁向此倾杯。"
      ],
      "author": {
        "id": 4645,
        "name": "朱庆余"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 358023,
      "title": "途中感怀",
      "content": [
        "世上名利牵，途中意惨然。",
        "到家能几日，为客便经年。",
        "迹似萍随水，情同鹤在田。",
        "何当功业遂，归路下遥天。"
      ],
      "author": {
        "id": 4645,
        "name": "朱庆余"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 358028,
      "title": "别李侍御后亭夜坐却寄",
      "content": [
        "已作亭下别，未忘灯下情。",
        "吟多欲就枕，更漏转分明。"
      ],
      "author": {
        "id": 4645,
        "name": "朱庆余"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 358029,
      "title": "题钱宇别墅",
      "content": [
        "林居向晚饶清景，惜去非关恋酒杯。",
        "石净每因杉露滴，",
        "红叶闲飘篱落迥，行人远见草堂开。"
      ],
      "author": {
        "id": 4645,
        "name": "朱庆余"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 358030,
      "title": "近试上张籍水部",
      "content": [
        "洞房昨夜停红烛，待晓堂前拜舅姑。",
        "妆罢低声问夫婿，画眉深浅入时无。"
      ],
      "author": {
        "id": 4645,
        "name": "朱庆余"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 358031,
      "title": "留别卢玄休归荆门",
      "content": [
        "江边离别心，言罢各沾襟。",
        "以我去帆远，知君离恨深。",
        "云开孤鸟出，浪起白鸥沈。",
        "更作来年约，阳台许伴寻。"
      ],
      "author": {
        "id": 4645,
        "name": "朱庆余"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 358046,
      "title": "观涛",
      "content": [
        "木落霜飞天地清，空江百里见潮生。",
        "鲜飙出海鱼龙气，",
        "高楼晓望无穷意，丹叶黄花绕郡城。"
      ],
      "author": {
        "id": 4645,
        "name": "朱庆余"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 358047,
      "title": "南湖",
      "content": [
        "湖上微风小槛凉，翻翻菱荇满回塘。",
        "野船著岸入春草，",
        "飘然蓬艇东归客，尽日相看忆楚乡。"
      ],
      "author": {
        "id": 4645,
        "name": "朱庆余"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 358048,
      "title": "镜湖西岛言事",
      "content": [
        "慵拙幸便荒僻地，纵闻猿鸟亦何愁。",
        "偶因药酒欺梅雨，",
        "世人若便无知己，应向此溪成白头。"
      ],
      "author": {
        "id": 4645,
        "name": "朱庆余"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 358049,
      "title": "送刘思复南河从军",
      "content": [
        "七千里别宁无恨，且贵从军乐事多。",
        "不驻节旄先候发，",
        "远作受恩身不易，莫抛书剑近笙歌。"
      ],
      "author": {
        "id": 4645,
        "name": "朱庆余"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    }
  ],
