{
  "data": [
    {
      "id": 285941,
      "title": "光化戊午年举公见示省试春草碧色诗偶赋是题",
      "content": [
        "苌弘血染新，含露满江滨。",
        "想得寻花径，应迷拾翠人。",
        "窗纱迎拥砌，簪玉妬成茵。",
        "天借新晴色，云饶落日春。",
        "岚光垂处合，眉黛看时嚬。",
        "愿与仙桃比，无令惹路尘。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 285942,
      "title": "江际",
      "content": [
        "杳杳渔舟破暝烟，疎疎芦苇旧江天。",
        "那堪流落逢摇落，可得潸然是偶然。",
        "万顷白波迷宿鹭，一林黄叶送残蝉。",
        "兵车未息年华促，早晚闲吟向浐川。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285943,
      "title": "将之泸郡旅次遂州遇裴晤员外谪居于此话旧凄凉因寄二首 一",
      "content": [
        "谁解登高问上玄，谪仙何事谪诗仙。",
        "云遮列宿离华省，树荫澄江入野船。",
        "黄鸟晚啼愁瘴雨，青梅早落中蛮烟。",
        "不知几首南行曲，留与巴儿万古传。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285944,
      "title": "将之泸郡旅次遂州遇裴晤员外谪居于此话旧凄凉因寄二首 二",
      "content": [
        "昔年共照松溪影，松折溪荒僧已无。",
        "今日重思锦城事，雪销花谢梦何殊。",
        "乱离未定身俱老，骚雅全休道甚孤。",
        "我拜师门更南去，荔枝春熟向渝泸。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285945,
      "title": "次韵和秀上人长安寺居言怀寄渚宫禅者",
      "content": [
        "旧斋松老别多年，香社人稀丧乱间。",
        "出寺秪知趋内殿，闭门长似在深山。",
        "卧听秦树秋钟断，吟想荆江夕鸟还。",
        "唯恐兴来飞锡去，老郎无路更追攀。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285946,
      "title": "蜀中春日",
      "content": [
        "海棠风外独霑巾，襟袖无端惹蜀尘。",
        "和暖又逢挑菜日，寂寥未是探花人。",
        "不嫌蚁酒冲愁肺，却忆渔蓑覆病身。",
        "何事晚来微雨后，锦江春学曲江春。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285947,
      "title": "游蜀",
      "content": [
        "所向明知是暗投，两行清泪语前流。",
        "云横新塞遮秦甸，花落空山入阆州。",
        "不忿黄鹂惊晓梦，唯应杜宇信春愁。",
        "梅黄麦绿无归处，可得漂漂爱浪游。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285948,
      "title": "峡中尝茶",
      "content": [
        "蔟蔟新英摘露光，小江园里火煎尝。",
        "吴僧漫说鸦山好，蜀叟休夸鸟觜香。",
        "合座半瓯轻泛绿，开缄数片浅含黄。",
        "鹿门病客不归去，酒渴更知春味长。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285949,
      "title": "辇下冬暮咏怀",
      "content": [
        "永巷闲吟一径蒿，轻肥大笑事风骚。",
        "烟含紫禁花期近，雪满长安酒价高。",
        "失路渐惊前计错，逢僧更念此生劳。",
        "十年春泪催衰飒，羞向清流照鬓毛。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285950,
      "title": "石城",
      "content": [
        "石城昔为莫愁乡，莫愁魂散石城荒。",
        "江人依旧棹舴艋，江岸还飞双鸳鸯。",
        "帆去帆来风浩渺，花开花落春悲凉。",
        "烟浓草远望不尽，千古汉阳闲夕阳。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285951,
      "title": "蜀中三首 一",
      "content": [
        "马头春向鹿头关。",
        "远树平芜一望闲，雪下文君沾酒市。",
        "云藏李白读书山，江楼客恨黄梅后。",
        "村落人歌紫芋间，堤月桥灯好时景。",
        "汉庭无事不征蛮。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285952,
      "title": "蜀中三首 二",
      "content": [
        "夜无多雨晓生尘，草色岚光日日新。",
        "蒙顶茶畦千点露，浣花牋纸一溪春。",
        "扬雄宅在唯乔木，杜甫台荒绝旧邻。",
        "却共海棠花有约，数年留滞不归人。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285953,
      "title": "蜀中三首 三",
      "content": [
        "渚远江清碧簟纹，小桃花绕薛涛坟。",
        "朱桥直指金门路，粉堞高连玉垒云。",
        "窗下[斵]琴翘凤足，波中濯锦散鸥群。",
        "子规夜夜啼巴树，不并吴乡楚国闻。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285954,
      "title": "少华甘露寺",
      "content": [
        "石门萝径与天邻，雨桧风篁远近闻。",
        "饮涧鹿喧双派水，上楼僧蹋一梯云。",
        "孤烟薄暮关城没，远色初晴渭曲分。",
        "长欲然香来此宿，北林猨鹤旧同群。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285955,
      "title": "慈恩寺偶题",
      "content": [
        "往事悠悠添浩叹，劳生扰扰竟何能。",
        "故山岁晚不归去，高塔晴来独自登。",
        "林下听经秋苑鹿，江边扫叶夕阳僧。",
        "吟余却起双峰念，曾看庵西瀑布冰。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285956,
      "title": "石门山泉",
      "content": [
        "一脉清泠何所之，萦莎漱藓入僧池。",
        "云边野客穷来处，石上寒猨见落时。",
        "聚沫绕崖残雪在，迸流穿树堕花随。",
        "烟春雨晚闲吟去，不复远寻皇子陂。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285957,
      "title": "渭阳楼闲望",
      "content": [
        "千重二华见皇州，望尽凝岚即此楼。",
        "细雨不藏秦树色，夕阳空照渭河流。",
        "后车宁见前车覆，今日难忘昨日忧。",
        "扰扰尘中犹未已，可能疏傅独能休。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285958,
      "title": "送田光",
      "content": [
        "九陌低迷谁问我，五湖流浪可悲君。",
        "著书笑破苏司业，赋咏思齐郑广文。",
        "理棹好携三百首，阻风须饮几千分。",
        "耒阳江口春山绿，恸哭应寻杜甫坟。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285959,
      "title": "送进士吴延保及第后南游",
      "content": [
        "得意却思寻旧迹，新衔未切向兰台。",
        "吟看秋草出关去，逢见故人随计来。",
        "胜地昔年诗板在，清歌几处郡筵开。",
        "江湖易有淹留兴，莫待春风落庾梅。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285960,
      "title": "送进士王驾下第归蒲中",
      "content": [
        "失意离愁春不知，到家时是落花时。",
        "孤单取事休言命，早晚逢人苦爱诗。",
        "度塞风沙归路远，傍河桑柘旧居移。",
        "应嗟我又巴江去，游子悠悠听子规。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285961,
      "title": "作尉鄠郊送进士潘为下第南归",
      "content": [
        "归去宜春春水深，麦秋梅雨过湘阴。",
        "乡园几度经狂寇，桑柘谁家有旧林。",
        "结绶位卑甘晚达，登龙心在且高吟。",
        "灞陵桥上杨花里，酒满芳樽泪满襟。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285962,
      "title": "送进士韦序赴举",
      "content": [
        "丹霞照上三清路，瑞锦裁成五色毫。",
        "波浪不能随世态，鸾凰应得入吾曹。",
        "秋山晚水吟情远，雪竹风松醉格高。",
        "预想明年腾跃处，龙津春碧浸仙桃。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285963,
      "title": "寄献狄右丞",
      "content": [
        "逐胜偷闲向杜陵，爱僧不爱紫衣僧。",
        "身为醉客思吟客，官自中丞拜右丞。",
        "残月露垂朝阙盖，落花风动宿斋灯。",
        "孤单小谏渔舟在，心恋清潭去未能。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285964,
      "title": "转正郎后寄献集贤相公",
      "content": [
        "予名初在德门前，屈指年来三十年。",
        "自贺孤危终际会，别将流涕感阶缘。",
        "止陪鸳鸯居清秩，滥应星辰浼上玄。",
        "平昔苦心何所恨，受恩多是旧诗篇。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285965,
      "title": "所知从事近藩偶有怀寄",
      "content": [
        "官舍种莎僧对榻，生涯如在旧山贫。",
        "酒醒草檄闻残漏，花落移厨送晚春。",
        "水墨画松清睡眼，云霞仙氅挂吟身。",
        "霜台伏首思归切，莫把渔竿逐逸人。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285966,
      "title": "献大京兆薛常侍能",
      "content": [
        "耻将官业竞前途，自爱篇章古不如。",
        "一炷香新开道院，数坊人聚避朝车。",
        "纵游藉草花垂酒，闲卧临窗燕拂书。",
        "唯有明公赏新句，秋风不敢忆鲈鱼。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285967,
      "title": "寄赠孙路处士",
      "content": [
        "平生诗誉更谁过，归老东吴命若何。",
        "知己凋零垂白发，故园寥落近沧波。",
        "酒醒藓砌花阴转，病起渔舟鹭迹多。",
        "深入富春人不见，闲门空掩半庭莎。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285968,
      "title": "献制诰杨舍人",
      "content": [
        "为郡东吴秪饮冰，琐闱频降凤书征。",
        "随行已有朱衣吏，伴直多招紫阁僧。",
        "窗下调琴鸣远水，帘前睡鹤背秋灯。",
        "苇陂竹坞情无限，闲话毘陵问杜陵。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285969,
      "title": "次韵酬张补阙因寒食见寄之什",
      "content": [
        "柳近清明翠缕长，多情右衮不相忘。",
        "开缄虽覩新篇丽，破鼻须闻冷酒香。",
        "时态嬾随人上下，花心甘被蝶分张。",
        "朝稀且莫轻春赏，胜事由来在帝乡。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285970,
      "title": "赠宗人前公安宰君",
      "content": [
        "喧卑从宦出喧卑，别画能琴又解棋。",
        "海上春耕因乱废，年来冬荐得官迟。",
        "风中夜犬惊槐巷，月下寒驴啮槿篱。",
        "孤散恨无推唱路，耿怀吟得赠君诗。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285971,
      "title": "寄赠杨夔处士",
      "content": [
        "结茅秪约钓鱼台，溅水鸬鹚去又回。",
        "春卧瓮边听酒熟，露吟庭际待花开。",
        "三江胜景遨游徧，百氏群书讲贯来。",
        "国步未安风雅薄，可能高尚掞天才。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285972,
      "title": "寄同年礼部赵郎中",
      "content": [
        "仙步徐徐整羽衣，小仪澄澹转中仪。",
        "桦飘红烬趋朝路，兰纵清香宿省时。",
        "彩笔烟霞供不足，纶闱鸾凤讶来迟。",
        "自怜孤宦谁相念，祷祝空吟一首诗。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285973,
      "title": "春暮咏怀寄集贤韦起居衮",
      "content": [
        "寂寂风帘信自垂，杨花笋箨正离披。",
        "长安一夜残春雨，右省三年老拾遗。",
        "坐看群贤争得路，退量孤分且吟诗。",
        "五湖烟网非无意，未去难忘国士知。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285974,
      "title": "多情",
      "content": [
        "赋分多情却自嗟，萧衰未必为年华。",
        "睡轻可忍风敲竹，饮散那堪月在花。",
        "薄宦因循抛岘首，故人流落向天涯。",
        "莺春鴈夜长如此，赖是幽居近酒家。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285975,
      "title": "感怀投时相",
      "content": [
        "非才偶忝直文昌，两鬓年深一镜霜。",
        "待漏敢辞称小吏，立班犹未出中行。",
        "孤吟马迹抛槐陌，远梦渔竿掷苇乡。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 285976,
      "title": "自贻",
      "content": [
        "饮筵博席与心违，野眺春吟更是谁。",
        "琴有涧风声转澹，诗无僧字格还卑。",
        "恨抛水国荷蓑雨，贫过长安樱笋时。",
        "头角俊髦应指笑，权门踪迹独差池。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285977,
      "title": "自遣",
      "content": [
        "强健宦途何足谓，入微章句更难论。",
        "谁知野性真天性，不扣权门扣道门。",
        "窥砚晚莺临砌树，迸堦春笋隔篱根。",
        "朝回何处消长日，紫阁峰南有旧村。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285978,
      "title": "中年",
      "content": [
        "漠漠秦云澹澹天，新年景象入中年。",
        "情多最恨花无语，愁破方知酒有权。",
        "苔色满墙寻故第，雨声一夜忆春田。",
        "衰迟自喜添诗学，更把前题改数联。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285979,
      "title": "自适",
      "content": [
        "紫陌奔驰不暂停，送迎终日在郊坰。",
        "年来鬓畔未垂白，雨后江头且蹋青。",
        "浮蚁满杯难暂舍，贯珠一曲莫辞听。",
        "春风秪有九十日，可合花前半日醒。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285980,
      "title": "结绶鄠郊縻摄府署偶有自咏",
      "content": [
        "莺离寒谷士逢春，释褐来年暂种芸。",
        "自笑老为梅少府，可堪贫摄鲍参军。",
        "酒醒往事多兴念，吟苦邻居必厌闻。",
        "推却簿书搔短发，落花飞絮正纷纷。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285981,
      "title": "漂泊",
      "content": [
        "槿坠蓬疎池馆清，日光风绪澹无情。",
        "鲈鱼斫鲙输张翰，橘树呼奴羡李衡。",
        "十口漂零犹寄食，两川消息未休兵。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 285982,
      "title": "吊故礼部韦员外序",
      "content": [
        "腊雪初晴共举杯，便期携手上春台。",
        "高情唯怕酒不满，长逝可悲花正开。",
        "晓奠莺啼残漏在，风帏燕觅旧巢来。",
        "杜陵芳草年年绿，醉魄吟魂无复回。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285983,
      "title": "渼陂",
      "content": [
        "昔事东流共不回，春深独向渼陂来。",
        "乱前别业依稀在，雨里繁花寂寞开。",
        "却展渔丝无野艇，旧题诗句没苍苔。",
        "潸然四顾难消遣，秪有佯狂泥酒杯。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285984,
      "title": "代秋扇词",
      "content": [
        "露入庭芜恨已深，热时天下是知音。",
        "汗流浃背曾施力，气爽中宵便负心。",
        "一片山溪从蠹损，数行文字任尘侵。",
        "绿槐阴合清和后，不会何颜又见寻。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285985,
      "title": "宣义里舍冬暮自贻",
      "content": [
        "幽居不称在长安，沟浅浮春岸雪残。",
        "板屋渐移方带野，水车新入夜添寒。",
        "名如有分终须立，道若离心岂易宽。",
        "满眼尘埃驰骛去，独寻烟竹翦渔竿。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285986,
      "title": "省中偶作",
      "content": [
        "三转郎曹自勉旃，莎阶吟步想前贤。",
        "未如何逊无佳句，若比冯唐是壮年。",
        "捧制名题黄纸尾，约僧心在白雪边。",
        "乳毛松雪春来好，直夜清闲且学禅。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285987,
      "title": "同志顾云下第出京偶有寄勉",
      "content": [
        "凤策联华是国华，春来偶未上仙槎。",
        "乡连南渡思菰米，泪滴东风避杏花。",
        "吟聒暮莺归庙院，睡消迟日寄僧家。",
        "一般情绪应相信，门静莎深树影斜。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285988,
      "title": "敷溪高士",
      "content": [
        "敷溪南岸掩柴荆，挂却朝衣爱净名。",
        "闲得林园栽树法，喜闻儿姪读书声。",
        "眠窗日暖添幽梦，步野风清散酒酲。",
        "谪去征还何扰扰，片云相伴看衰荣。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285989,
      "title": "九日偶怀寄左省张起居",
      "content": [
        "令节争欢我独闲，荒台尽日向晴山。",
        "浑无酒泛金英菊，漫道官趋玉笋班。",
        "深愧青莎迎野步，不堪红叶照衰颜。",
        "羡君官重多吟兴，醉带南陂落照还。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285990,
      "title": "春夕伴同年礼部赵员外省直",
      "content": [
        "锦帐名郎重锦科，清宵寓直纵吟哦。",
        "冰含玉镜春寒在，粉傅仙闱月色多。",
        "视草即应归属望，握兰知道暂经过。",
        "流莺百啭和残漏，犹把芳樽藉露莎。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285991,
      "title": "倦客",
      "content": [
        "十年五年岐路中，千里万里西复东。",
        "匹马愁冲晚村雪，孤舟闷阻春江风。",
        "达士由来知道在，昔贤何必哭途穷。",
        "闲烹芦笋炊菰米，会向源乡作醉翁。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285992,
      "title": "温处士能画鹭鹚以四韵换之",
      "content": [
        "昔年吟醉绕江蓠，爱把渔竿伴鹭鹚。",
        "闻说小毫能纵逸，敢凭轻素写幽奇。",
        "涓涓浪溅残菱蔓，戛戛风搜折苇枝。",
        "得向晓窗闲挂翫，雪蓑烟艇恨无遗。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285993,
      "title": "驾部郑郎中三十八丈尹贰东周荣加金紫谷以末派之外恩旧事深因贺送",
      "content": [
        "香浮玉陛晓辞天，袍拂蒲茸称少年。",
        "郎署转曹虽久次，京河亚尹是优贤。",
        "纵游云水无公事，贵买琴书有俸钱。",
        "今日龙门看松雪，探春明日向平泉。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285994,
      "title": "欹枕",
      "content": [
        "攲枕高眠日午春，酒酣睡足最闲身。",
        "明朝会得穷通理，未必输他马上人。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 285995,
      "title": "野步",
      "content": [
        "翠岚迎步兴何长，笑领渔翁入醉乡。",
        "日暮渚田微雨后，鹭鹚闲暇稻花香。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 285996,
      "title": "偶书",
      "content": [
        "承时偷喜负明神，务实那能得庇身。",
        "不会苍苍主何事，忍饥多是力耕人。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 285997,
      "title": "静吟",
      "content": [
        "骚雅荒凉我未安，月和余雪夜吟寒。",
        "相门相客应相笑，得句胜于得好官。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 285998,
      "title": "和知己秋日伤怀",
      "content": [
        "流水歌声共不回，去年天气旧亭台。",
        "梁尘寂寞燕归去，黄蜀葵花一朵开。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 285999,
      "title": "谷比岁受同年丈人故川守李侍郎教谕衰晏龙钟益用感叹遂以章句自贻",
      "content": [
        "多感京河李丈人，童蒙受教便书绅。",
        "文章至竟无功业，名宦由来致苦辛。",
        "皎日还应知守道，平生自信解甘贫。",
        "孤单所得皆逾分，归种敷溪一亩春。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 286000,
      "title": "郊墅",
      "content": [
        "韦曲樊川雨半晴，竹庄花院徧题名。",
        "画成烟景垂杨色，滴破春愁压酒声。",
        "满野红尘谁得路，连天紫阁独关情。",
        "渼陂水色澄于镜，何必沧浪始濯缨。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 286001,
      "title": "舟行",
      "content": [
        "九派迢迢九月残，舟人相语且相宽。",
        "村逢好处嫌风便，酒到醒来觉夜寒。",
        "蓼渚白波喧夏口，柿园红叶忆长安。",
        "季鹰可是思鲈鲙，引退知时自古难。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 286002,
      "title": "奔问三峰寓止近墅",
      "content": [
        "半年奔走颇惊魂，来谒行宫泪眼昏。",
        "鸳鹭入朝同待漏，牛羊送日独归村。",
        "灞陵散失诗千首，太华凄凉酒一樽。",
        "兵革未休无异术，不知何以受君恩。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 286003,
      "title": "朝直",
      "content": [
        "朝直叨居省阁间，由来疎退校安闲。",
        "落花夜静宫中漏，微雨春寒廊下班。",
        "自扣玄门齐宠辱，从他荣路用机关。",
        "孤峰未得深归去，名画偏求水墨山。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 286004,
      "title": "巴江",
      "content": [
        "乱来奔走巴江滨，愁客多于江徼人。",
        "朝醉暮醉雪开霁，一枝两枝梅探春。",
        "诏书罪己方哀痛，乡县征兵尚苦辛。",
        "鬓秃又惊逢献岁，眼前浑不见交亲。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 286005,
      "title": "故许昌薛尚书能尝为都官郎中后数岁故建州李员外频自宪府内弹拜都官员外八座外郎皆一时骚雅宗师则都官之曹振盛于此予早年请益实受深知今忝此官复是正秩岂唯俯慰孤宦何以仰继前贤荣惕在衷遂赋自贺",
      "content": [
        "都官虽未是名郎，践历曾闻薛许昌。",
        "复有李公陪雅躅，岂宜郑子忝余光。",
        "荣为后进趋兰署，喜拂前题在粉墙。",
        "他日节旄如可继，不嫌曹冷在中行。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 286006,
      "title": "访题表兄王藻渭上别业",
      "content": [
        "桑林摇落渭川西，蓼水弥弥接稻泥。",
        "幽槛静来鱼唱远，暝天寒极鴈行低。",
        "浊醪最称看山醉，冷句偏宜选竹题。",
        "中表人稀离乱后，花时莫惜重相携。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 286007,
      "title": "题汝州从事厅",
      "content": [
        "诗人公署如山舍，秪向堦前便采薇。",
        "惊燕拂帘闲睡觉，落花沾砚会餐归。",
        "壁看旧记官多达，牓挂明文吏莫违。",
        "自说小池栽苇后，雨凉频见鹭鹚飞。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 286008,
      "title": "谷初忝谏垣今宪长薛公方在西阁知奖隆异以四韵代述荣感",
      "content": [
        "旧诗常得在高吟，不奈公心爱苦心。",
        "道自琐闱言下振，恩从仙殿对回深。",
        "流年渐觉霜欺鬓，至药能教土化金。",
        "自拂青萍知有地，斋诚旦夕望为霖。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 286009,
      "title": "兵部卢郎中光济借示诗集以四韵谢之",
      "content": [
        "七子风骚寻失主，五君歌诵久无声。",
        "调和雅乐归时正，澄滤颓波到底清。",
        "才大始知寰宇窄，吟高何止鬼神惊。",
        "叶公好尚浑疎阔，忽见真龙几丧明。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 286010,
      "title": "贺左省新除韦拾遗",
      "content": [
        "初升谏署是真仙，浪透桃花恰五年。",
        "垂白郎官居座末，著绯人吏立阶前。",
        "百寮班列趋丹陛，两掖风清上碧天。",
        "从此追飞何处去，金銮殿与玉堂连。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 286011,
      "title": "右省张补阙茂枢同在谏垣连居光德新春赋咏聊以寄怀",
      "content": [
        "小梅零落雪欺残，浩荡穷愁岂易宽。",
        "唯有郎吟偿晚景，且无浓醉厌春寒。",
        "高斋每喜追攀近，丽句先忧属和难。",
        "十五年前谙苦节，知心不独为同官。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 286012,
      "title": "右省补阙张茂枢同在谏垣邻居光德迭和篇什未尝间时忽见贻谓谷将来履历必在文昌当与何水部宋考功为俦谷虽赋于风雅实用兢惶因抒酬寄",
      "content": [
        "何宋清名动粉闱，不才今日偶陈诗。",
        "考功岂敢闻题品，水部犹须系挈维。",
        "积雪巷深酬唱夜，落花墙隔笑言时。",
        "紫垣名士推扬切，为话心孤倍感知。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 286013,
      "title": "寄职方李员外",
      "content": [
        "曾袖篇章谒长卿，今来附凤事何荣。",
        "星临南省陪仙步，春满东朝接珮声。",
        "谈笑不拘先后礼，岁寒仍契子孙情。",
        "龙墀仗下天街暖，共看圭峰并马行。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 286014,
      "title": "寄题诗僧秀公",
      "content": [
        "灵一心传清塞心，可公吟后楚公吟。",
        "近来雅道相亲少，唯仰吾师所得深。",
        "好句未停无暇日，旧山归老有东林。",
        "冷曹孤宦甘寥落，多谢携筇数访寻。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 286015,
      "title": "东蜀春晚",
      "content": [
        "如此浮生更别离，可堪长恸送春归。",
        "潼江水上杨花雪，刚逐孤舟缭绕飞。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 286016,
      "title": "永日有怀",
      "content": [
        "能消永日是摴蒱，坑堑由来似宦途。",
        "两掷未终楗橛内，座中何惜为呼卢。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 286017,
      "title": "槐花",
      "content": [
        "毵毵金蕊扑晴空，举子魂惊落照中。",
        "今日老郎犹有恨，昔年相虐十秋风。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 286018,
      "title": "小桃",
      "content": [
        "和烟和雨遮敷水，映竹映村连灞桥。",
        "撩乱春风耐寒令，到头赢得杏花娇。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 286019,
      "title": "长江县经贾岛墓",
      "content": [
        "水绕荒坟县路斜，耕人讶我久咨嗟。",
        "重来兼恐无寻处，落日风吹鼓子花。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 286020,
      "title": "嘉陵",
      "content": [
        "细雨湿萋萋，人稀江日西。",
        "春愁肠已断，不在子规啼。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 286021,
      "title": "嘉陵",
      "content": [
        "细雨湿凄凄，人稀江日西。",
        "春膓已愁断，不待子规啼。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 286022,
      "title": "中秋",
      "content": [
        "清香闻晓莲，水国雨余天。",
        "天气正得所，客心刚悄然。",
        "乱兵何日息，故老几人全。",
        "此际难消遣，从来未学禅。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 286023,
      "title": "朝谒",
      "content": [
        "捧日整朝簪，千官一片心。",
        "班趋黄道急，殿接紫宸深。",
        "威凤回香扆，新莺啭上林。",
        "小松含瑞露，春翠易成阴。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 286024,
      "title": "锦浦",
      "content": [
        "流落夜凄凄，春寒锦浦西。",
        "不甘花逐水，可惜雪成泥。",
        "病眼嫌灯近，离肠赖酒迷。",
        "凭君嘱鹎𫛥，莫向五更啼。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 286025,
      "title": "峨嵋山",
      "content": [
        "万仞白云端，经春雪未残。",
        "夏消江峡满，晴照蜀楼寒。",
        "造境知僧熟，归林认鹤难。",
        "会须朝阙去，秪有画图看。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 286026,
      "title": "蜀江有吊",
      "content": [
        "孟子有良策，惜哉今已而。",
        "徒将心体国，不识道消时。",
        "折槛未为切，沈湘何足悲。",
        "苍苍无问处，烟雨徧江蓠。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 286027,
      "title": "书村叟壁",
      "content": [
        "草肥朝牧牛，桑绿晚鸣鸠。",
        "列岫簷前见，清泉碓下流。",
        "春蔬和雨割，社酒向花𥬠。",
        "引我南陂去，篱边有小舟。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 286028,
      "title": "题进士王驾郊居",
      "content": [
        "前山微有雨，永巷净无尘。",
        "牛卧篱阴晚，鸠鸣村意春。",
        "时浮应寡合，道在不嫌贫。",
        "后径临陂水，菰蒲是切邻。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 286029,
      "title": "题庄严寺休公院",
      "content": [
        "秋深庭色好，红叶间青松。",
        "病客殊无著，吾师甚见容。",
        "疎钟和细溜，高塔等遥峰。",
        "未省求名侣，频于此地逢。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 286030,
      "title": "题兴善寺",
      "content": [
        "寺在帝城阴，清虚胜二林。",
        "藓侵隋画暗，茶助越瓯深。",
        "巢鹤和钟唳，诗僧倚锡吟。",
        "烟莎后池水，前迹杳难寻。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 286031,
      "title": "宿澄泉兰若",
      "content": [
        "山半古招提，空林雪月迷。",
        "乱流分石上，斜汉在松西。",
        "云集寒庵宿，猨先晓磬啼。",
        "此心如了了，即此是曹溪。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 286032,
      "title": "送举子下第东归",
      "content": [
        "夫子道何孤，青云未得途。",
        "诗书难舍鲁，山水暂游吴。",
        "野绿梅阴重，江春浪势麤。",
        "秣陵兵役后，旧业半成芜。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 286033,
      "title": "寄察院李侍御文炬",
      "content": [
        "古柏间疎篁，清阴在印床。",
        "宿郊虔点馔，秋寺静监香。",
        "参集行多揖，风仪见即庄。",
        "伫闻横擘去，帷集谏书囊。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 286034,
      "title": "偶怀寄台院孙端公棨",
      "content": [
        "才拙道仍孤，无何舍钓徒。",
        "班虽沾玉笋，香不近金炉。",
        "雨露瞻双阙，烟波隔五湖。",
        "唯君应见念，曾共伏青蒲。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 286035,
      "title": "次韵和秀上人游南五台",
      "content": [
        "中峰曾到处，题记没苍苔。",
        "振锡传深谷，翻经想旧台。",
        "苍松临砌偃，惊鹿蓦溪来。",
        "内殿评诗切，身回心未回。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 286036,
      "title": "乖慵",
      "content": [
        "乖慵居竹里，凉冷卧池东。",
        "一霎芰荷雨，几回帘幕风。",
        "远僧来扣寂，小吏笑书空。",
        "衰鬓霜供白，愁颜酒借红。",
        "扇轻摇鹭羽，屏古画渔翁。",
        "自得无端趣，琴棋舫子中。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 286037,
      "title": "南宫寓直",
      "content": [
        "寓直事非轻，宦孤忧且荣。",
        "制承黄纸重，词见紫垣清。",
        "晓霁庭松色，风和禁漏声。",
        "僧携新茗伴，吏扫落花迎。",
        "锁印诗心动，垂帘睡思生。",
        "粉廊曾试处，石柱昔贤名。",
        "来误宫窗燕，啼疑苑树莺。",
        "残阳应更好，归促恨严城。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 286038,
      "title": "恩门小谏雨中乞菊栽",
      "content": [
        "握兰将满岁，栽菊伴吟诗。",
        "老去慵趋世，朝回独绕篱。",
        "递香风细细，浇绿水弥弥。",
        "秪共山僧赏，何当国士移。",
        "孤根深有托，微雨正相宜。",
        "更待金英发，凭君插一枝。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 286039,
      "title": "荆渚八月十五夜值雨寄同年李屿",
      "content": [
        "共待辉光夜，翻成黯澹秋。",
        "正宜清路望，潜起滴堦愁。",
        "棹倚袁宏渚，帘垂庾亮楼。",
        "桂无香实落，兰有露花休。",
        "玉漏添萧索，金尊阻献酬。",
        "明年佳景在，相约向神州。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 286040,
      "title": "寄左省张起居",
      "content": [
        "含香复记言，清秩称当年。",
        "点笔非常笔，朝天最近天。",
        "家声三相后，公事一人前。",
        "诗句江郎伏，书踪宁氏传。",
        "风标欺鹭鹤，才力涌沙泉。",
        "居僻贫无虑，名高退更坚。",
        "渔舟思静泛，僧榻寄闲眠。",
        "消息当弥入，丝纶的粲然。",
        "依栖常接迹，属和旧盈编。",
        "开口人皆信，凄凉是谢毡。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
