{
  "data": [
    {
      "id": 312596,
      "title": "御街行",
      "content": [
        "夭非花艳轻非雾。",
        "来夜半、天明去。",
        "来如春梦不多时，去似朝云何处。",
        "远鸡栖燕，落星沈月，紞紞城头鼓。",
        "参差渐辨西池树。",
        "珠阁斜开户。",
        "绿苔深径少人行，苔上屐痕无数。",
        "馀香遗粉，剩衾闲枕，天把多情付。"
      ],
      "author": {
        "id": 5040,
        "name": "张先"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312597,
      "title": "苏幕遮",
      "content": [
        "柳飞绵，花实少。",
        "镂板音清，浅发江南调。",
        "斜日两竿留碧□。",
        "马足重重，又近青门道。",
        "去尘浓，人散了。",
        "回首旗亭，渐渐红裳小。",
        "莫讶安仁头白早。",
        "天若有情，天也终须老。"
      ],
      "author": {
        "id": 5040,
        "name": "张先"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312598,
      "title": "武陵春",
      "content": [
        "每见韶娘梳鬓好，钗燕傍云飞。",
        "谁掬彤霞露染衣。",
        "□玉透柔肌。",
        "梅花瘦雪梨花雨，心眼未芳菲。",
        "看著娇妆听柳枝。",
        "人意觉春归。"
      ],
      "author": {
        "id": 5040,
        "name": "张先"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312599,
      "title": "醉落魄・一斛珠",
      "content": [
        "山围画障。",
        "风溪弄月清溶漾。",
        "玉楼苕馆人相望。",
        "下若醲醅，竞欲金钗当。",
        "使君劝醉青娥唱。",
        "分明仙曲云中响。",
        "南园百卉千家赏。",
        "和气兼春，不独花枝上。"
      ],
      "author": {
        "id": 5040,
        "name": "张先"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312600,
      "title": "长相思",
      "content": [
        "粉艳明。",
        "秋水盈。",
        "柳样纤柔花样轻。",
        "笑前双靥生。",
        "寒江平。",
        "江橹鸣。",
        "谁道潮沟非远行。",
        "回头千里情。"
      ],
      "author": {
        "id": 5040,
        "name": "张先"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312601,
      "title": "更漏子",
      "content": [
        "杜陵春，秦树晚。",
        "伤别更堪临远。",
        "南去信，欲凭谁。",
        "归鸿多北归。",
        "小桃枝，红蓓发。",
        "今夜昔时风月。",
        "休苦意，说相思。",
        "少情人不知。"
      ],
      "author": {
        "id": 5040,
        "name": "张先"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312602,
      "title": "浣溪沙",
      "content": [
        "楼倚春江百尺高。",
        "烟中还未见归桡。",
        "几时期信似江潮。",
        "花片片飞风弄蝶，柳阴阴下水平桥。",
        "日长才过又今宵。"
      ],
      "author": {
        "id": 5040,
        "name": "张先"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312603,
      "title": "醉桃源・阮郎归",
      "content": [
        "仙郎何日是来期。",
        "无心云胜伊。",
        "行云犹解傍山飞。",
        "郎行去不归。",
        "强匀画，又芳菲。",
        "春深轻薄衣。",
        "桃花无语伴相思。",
        "阴阴月上时。"
      ],
      "author": {
        "id": 5040,
        "name": "张先"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312604,
      "title": "行香子",
      "content": [
        "舞雪歌云。",
        "闲淡妆匀。",
        "蓝溪水、深染轻裙。",
        "酒香醺脸，粉色生春。",
        "更巧谈话，美情性，好精神。",
        "江空无畔，凌波何处，月桥边、青柳朱门。",
        "断钟残角，又送黄昏。",
        "奈心中事，眼中泪，意中人。"
      ],
      "author": {
        "id": 5040,
        "name": "张先"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312605,
      "title": "熙州慢",
      "content": [
        "武林乡，占第一湖山，咏画争巧。",
        "鹫石飞来，倚翠楼烟霭，清猿啼晓。",
        "况值禁垣师帅，惠政流入欢谣。",
        "朝暮万景，寒潮弄月，乱峰回照。",
        "天使寻春不早。",
        "并行乐，免有花愁花笑。",
        "持酒更听，红儿肉声长调。",
        "潇湘故人未归，但目送游云孤鸟。",
        "际天杪。",
        "离情尽寄芳草。"
      ],
      "author": {
        "id": 5040,
        "name": "张先"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312606,
      "title": "虞美人",
      "content": [
        "恩如明月家家到。",
        "无处无清照。",
        "一帆秋色共云遥。",
        "眼力不知人远、上江桥。",
        "愿君书札来双鲤。",
        "古汴东流水。",
        "宋王台畔楚宫西。",
        "正是节趣归路、近沙堤。"
      ],
      "author": {
        "id": 5040,
        "name": "张先"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312607,
      "title": "泛清苕",
      "content": [
        "绿净无痕，过晓霁清苕，镜里游人。",
        "红柱巧，彩船稳，当筵主、秘馆词臣。",
        "吴娃劝饮韩娥唱，竞艳容、左右皆春。",
        "学为行雨，傍画桨，从教水溅罗裙。",
        "溪烟混月黄昏。",
        "渐楼台上下，火影星分。",
        "飞槛倚，斗牛近，响箫鼓、远破重云。",
        "归轩未至千家待，掩半妆、翠箔朱门。",
        "衣香拂面，扶醉卸簪花，满袖馀煴。"
      ],
      "author": {
        "id": 5040,
        "name": "张先"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312608,
      "title": "惜琼花",
      "content": [
        "汀苹白。",
        "苕水碧。",
        "每逢花驻乐，随处欢席。",
        "别时携手看春色。",
        "萤火而今，飞破秋夕。",
        "旱河流，如带窄。",
        "任身轻似叶，何计归得。",
        "断云孤鹜青山极。",
        "楼上徘徊，无尽相忆。"
      ],
      "author": {
        "id": 5040,
        "name": "张先"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312609,
      "title": "河满子",
      "content": [
        "溪女送花随处，沙鸥避乐分行。",
        "游舸已如图障里，小屏犹画潇湘。",
        "人面新生酒艳，日痕更欲春长。",
        "衣上交枝斗色，钗头比翼相双。",
        "片段落霞明水底，风纹时动妆光。",
        "宾从夜归无月，千灯万火河塘。"
      ],
      "author": {
        "id": 5040,
        "name": "张先"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312610,
      "title": "劝金船",
      "content": [
        "流泉宛转双开窦。",
        "带染轻纱皱。",
        "何人暗得金船酒。",
        "拥罗绮前后。",
        "绿定见花影，并照与、艳妆争秀。",
        "行尽曲名，休更再歌杨柳。",
        "光生飞动摇琼甃。",
        "隔障笙箫奏。",
        "须知短景欢无足，又还过清昼。",
        "翰阁迟归来，传骑恨、留住难久。",
        "异日凤凰池上，为谁思旧。"
      ],
      "author": {
        "id": 5040,
        "name": "张先"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312611,
      "title": "庆同天・河传",
      "content": [
        "海宇，称庆。",
        "复生元圣。",
        "风入南薰。",
        "拜恩遥阙，衣上晓色犹春。",
        "望尧云。",
        "游钧广乐人疑梦。",
        "仙声共。",
        "日转旗光动。",
        "无疆帝算，何独待祝华封。",
        "与天同。"
      ],
      "author": {
        "id": 5040,
        "name": "张先"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312612,
      "title": "江城子",
      "content": [
        "小圆珠串静慵拈。",
        "夜厌厌。",
        "下重帘。",
        "曲屏斜烛，心事入眉尖。",
        "金字半开香穗小，愁不寐，恨西蟾。"
      ],
      "author": {
        "id": 5040,
        "name": "张先"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312613,
      "title": "雨中花令",
      "content": [
        "近鬓彩钿云雁细。",
        "好客艳、花枝争媚。",
        "学双燕、同栖还并翅。",
        "我合著、你难分离。",
        "这佛面、前生应布施。",
        "你更看、蛾眉下秋水。",
        "似赛九底、见他三五二。",
        "正闷里、也须欢喜。"
      ],
      "author": {
        "id": 5040,
        "name": "张先"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312614,
      "title": "汉宫春",
      "content": [
        "红粉苔墙。",
        "透新春消息，梅粉先芳。",
        "奇葩异卉，汉家宫额涂黄。",
        "何人斗巧，运紫檀、翦出蜂房。",
        "应为是、中央正色，东君别与清香。",
        "仙姿自称霓裳。",
        "更孤标俊格，非雪凌霜。",
        "黄昏院落，为谁密解罗囊。",
        "银瓶注水，浸数枝、小阁幽窗。",
        "春睡起，纤条在手，厌厌宿酒残妆。"
      ],
      "author": {
        "id": 5040,
        "name": "张先"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312615,
      "title": "青门引・青门饮",
      "content": [
        "乍暖还轻冷。",
        "风雨晚来方定。",
        "庭轩寂寞近清明，残花中酒，又是去年病。",
        "楼头画角风吹醒。",
        "入夜重门静。",
        "那堪更被明月，隔墙送过秋千影。"
      ],
      "author": {
        "id": 5040,
        "name": "张先"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312616,
      "title": "满江红",
      "content": [
        "飘尽寒梅，笑粉蝶游蜂未觉。",
        "渐迤逦、水明山秀，暖生帘幕。",
        "过雨小桃红未透，舞烟新柳青犹弱。",
        "记画桥深处水边亭，曾偷约。",
        "多少恨，今犹昨。",
        "愁和闷，都忘却。",
        "拼从前烂醉，被花迷著。",
        "晴鸽试铃风力软，雏莺弄舌春寒薄。",
        "但只愁、锦绣闹妆时，东风恶。"
      ],
      "author": {
        "id": 5040,
        "name": "张先"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312617,
      "title": "西江月",
      "content": [
        "肃肃秺侯清慎，温温契苾知诗。",
        "能推恻隐救民饥。",
        "况乃义方教子。",
        "宪府两飞鹗荐，士林竞赋怀辞。",
        "天门正美可前知。",
        "入侍钧天从此。"
      ],
      "author": {
        "id": 5040,
        "name": "张先"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312618,
      "title": "塞垣春",
      "content": [
        "野树秋声满。",
        "对雨壁、风灯乱。",
        "云低翠帐，烟销素被，签动重幔。",
        "甚客怀、先自无消遣。",
        "更篱落、秋虫叹。",
        "叹樊川、风流减。",
        "旧欢难得重见。",
        "停酒说扬州，平山月、应照棋观。",
        "绿绮为谁弹，空传广陵散。",
        "但光纱短帽，窄袖轻衫，犹记竹西庭院。",
        "老鹤何时去，认琼花一面。"
      ],
      "author": {
        "id": 5040,
        "name": "张先"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312619,
      "title": "浪淘沙",
      "content": [
        "肠断送韶华。",
        "为惜杨花。",
        "雪球摇曳逐风斜。",
        "容易著人容易去，飞过谁家。",
        "聚散苦咨嗟。",
        "无计留他。",
        "行人洒泪滴流霞。",
        "今日画堂歌舞地，明日天涯。"
      ],
      "author": {
        "id": 5040,
        "name": "张先"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312620,
      "title": "望江南・忆江南",
      "content": [
        "香闺内、空自想佳期。",
        "独步花阴情绪乱，谩将珠泪两行垂。",
        "胜会在何时。",
        "厌厌病，此夕最难持。",
        "一点芳心无托处，荼縻架上月迟迟。",
        "惆怅有谁知。"
      ],
      "author": {
        "id": 5040,
        "name": "张先"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312621,
      "title": "碧牡丹",
      "content": [
        "步帐摇红绮。",
        "晓月堕，沈烟砌。",
        "缓板香檀，唱彻伊家新制。",
        "怨入眉头，敛黛峰横翠。",
        "芭蕉寒，雨声碎。",
        "镜华翳。",
        "闲照孤鸾戏。",
        "思量去时容易。",
        "钿盒瑶钗，至今冷落轻弃。",
        "望极蓝桥，但暮云千里。",
        "几重山，几重水。"
      ],
      "author": {
        "id": 5040,
        "name": "张先"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312622,
      "title": "山亭宴",
      "content": [
        "碧波落日寒烟聚，望遥山、迷离红树。",
        "小艇载人来，约尊酒、商量歧路。",
        "衰柳断桥西，共携手、攀条无语。",
        "水际见鹥凫，一对对、眠沙溆。",
        "西陵松柏青如故。",
        "翦烟花、幽兰啼露。",
        "油壁间花骢，那禁得、风吹细雨。",
        "饶他此后更思量，总莫似、当筵情绪。",
        "镜面绿波平，照几度、人来去。"
      ],
      "author": {
        "id": 5040,
        "name": "张先"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312623,
      "title": "谒金门",
      "content": [
        "秋露坠。",
        "滴尽楚兰红泪。",
        "往事旧欢何限意。",
        "思量如梦寐。",
        "人貌老于前岁。",
        "风月宛然无异。",
        "座有嘉宾尊有桂。",
        "莫辞终夕醉。"
      ],
      "author": {
        "id": 6242,
        "name": "晏殊"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312624,
      "title": "破阵子",
      "content": [
        "海上蟠桃易熟，人间好月长圆。",
        "惟有掰钗分钿侣，离别常多会面难。",
        "此情须问天。",
        "蜡烛到明垂泪，熏炉尽日生烟。",
        "一点凄凉愁绝意，谩道秦筝有剩弦。",
        "何曾为细传。"
      ],
      "author": {
        "id": 6242,
        "name": "晏殊"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312625,
      "title": "破阵子",
      "content": [
        "燕子欲归时节，高楼昨夜西风。",
        "求得人间成小会，试把金尊傍菊丛。",
        "歌长粉面红。",
        "斜日更穿帘幕，微凉渐入梧桐。",
        "多少襟怀言不尽，写向蛮笺曲调中。",
        "此情千万重。"
      ],
      "author": {
        "id": 6242,
        "name": "晏殊"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312626,
      "title": "破阵子",
      "content": [
        "忆得去年今日，黄花已满东篱。",
        "曾与玉人临小槛，共折香英泛酒卮。",
        "长条插鬓垂。",
        "人貌不应迁换，珍丛又睹芳菲。",
        "重把一尊寻旧径，所惜光阴去似飞。",
        "风飘露冷时。"
      ],
      "author": {
        "id": 6242,
        "name": "晏殊"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312627,
      "title": "破阵子",
      "content": [
        "湖上西风斜日，荷花落尽红英。",
        "金菊满丛珠颗细，海燕辞巢翅羽轻。",
        "年年岁岁情。",
        "美酒一杯新熟，高歌数阕堪听。",
        "不向尊前同一醉，可奈光阴似水声。",
        "迢迢去未停。"
      ],
      "author": {
        "id": 6242,
        "name": "晏殊"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312628,
      "title": "浣溪沙",
      "content": [
        "阆苑瑶台风露秋。",
        "整鬟凝思捧觥筹。",
        "欲归临别强迟留。",
        "月好谩成孤枕梦，酒阑空得两眉愁。",
        "此时情绪悔风流。"
      ],
      "author": {
        "id": 6242,
        "name": "晏殊"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312629,
      "title": "浣溪沙",
      "content": [
        "三月和风满上林。",
        "牡丹妖艳直千金。",
        "恼人天气又春阴。",
        "为我转回红脸面，向谁分付紫檀心。",
        "有情须𣨼酒杯深。"
      ],
      "author": {
        "id": 6242,
        "name": "晏殊"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312630,
      "title": "浣溪沙",
      "content": [
        "青杏园林著酒香。",
        "佳人初试薄罗裳。",
        "柳丝无力燕飞忙。",
        "乍雨乍晴花自落，闲愁闲闷日偏长。",
        "为谁消瘦减容光。"
      ],
      "author": {
        "id": 6242,
        "name": "晏殊"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312631,
      "title": "浣溪沙",
      "content": [
        "一曲新词酒一杯。",
        "去年天气旧亭台。",
        "夕阳西下几时回。",
        "无可奈何花落去，似曾相识燕归来。",
        "小园香径独徘徊。"
      ],
      "author": {
        "id": 6242,
        "name": "晏殊"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312632,
      "title": "浣溪沙",
      "content": [
        "红蓼花香夹岸稠。",
        "绿波春水向东流。",
        "小船轻舫好追游。",
        "渔父酒醒重拨棹，鸳鸯飞去却回头。",
        "一杯销尽两眉愁。"
      ],
      "author": {
        "id": 6242,
        "name": "晏殊"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312633,
      "title": "浣溪沙",
      "content": [
        "淡淡梳妆薄薄衣。",
        "天仙模样好容仪。",
        "旧欢前事入颦眉。",
        "闲役梦魂孤烛暗，恨无消息画帘垂。",
        "且留双泪说相思。"
      ],
      "author": {
        "id": 6242,
        "name": "晏殊"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312634,
      "title": "浣溪沙",
      "content": [
        "小阁重帘有燕过。",
        "晚花红片落庭莎。",
        "曲阑干影入凉波。",
        "一霎好风生翠幕，几回疏雨滴圆荷。",
        "酒醒人散得愁多。"
      ],
      "author": {
        "id": 6242,
        "name": "晏殊"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312635,
      "title": "浣溪沙",
      "content": [
        "宿酒才醒厌玉卮。",
        "水沈香冷懒熏衣。",
        "早梅先绽日边枝。",
        "寒雪寂寥初散后，春风悠扬欲来时。",
        "小屏闲放画帘垂。"
      ],
      "author": {
        "id": 6242,
        "name": "晏殊"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312636,
      "title": "浣溪沙",
      "content": [
        "绿叶红花媚晓烟。",
        "黄蜂金蕊欲披莲。",
        "水风深处懒回船。",
        "可惜异香珠箔外，不辞清唱玉尊前。",
        "使星归觐九重天。"
      ],
      "author": {
        "id": 6242,
        "name": "晏殊"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312637,
      "title": "浣溪沙",
      "content": [
        "湖上西风急暮蝉。",
        "夜来清露湿红莲。",
        "少留归骑促歌筵。",
        "为别莫辞金盏酒，入朝须近玉炉烟。",
        "不知重会是何年。"
      ],
      "author": {
        "id": 6242,
        "name": "晏殊"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312638,
      "title": "浣溪沙",
      "content": [
        "杨柳阴中驻彩旌。",
        "芰荷香里劝金觥。",
        "小词流入管弦声。",
        "只有醉饮宽别恨，不须朝暮促归程。",
        "雨条烟叶系人情。"
      ],
      "author": {
        "id": 6242,
        "name": "晏殊"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312639,
      "title": "浣溪沙",
      "content": [
        "一向年光有限身。",
        "等闲离别易消魂。",
        "酒筵歌席莫辞频。",
        "满目山河空念远，落花风雨更伤春。",
        "不如怜取眼前人。"
      ],
      "author": {
        "id": 6242,
        "name": "晏殊"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312640,
      "title": "浣溪沙",
      "content": [
        "玉碗冰寒滴露华。",
        "粉融香雪透轻纱。",
        "晚来妆面胜荷花。",
        "鬓亸欲迎眉际月，酒红初上脸边霞。",
        "一场春梦日西斜。"
      ],
      "author": {
        "id": 6242,
        "name": "晏殊"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312641,
      "title": "更漏子",
      "content": [
        "蕣华浓，山翠浅。",
        "一寸秋波如剪。",
        "红日永，绮筵开。",
        "暗随仙驭来。",
        "遏云声，回雪袖。",
        "占断晓莺春柳。",
        "才送目，又颦眉。",
        "此情谁得知。"
      ],
      "author": {
        "id": 6242,
        "name": "晏殊"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312642,
      "title": "更漏子",
      "content": [
        "塞鸿高，仙露满。",
        "秋入银河清浅。",
        "逢好客，且开眉。",
        "盛年能几时。",
        "宝筝调，罗袖软。",
        "拍碎画堂檀板。",
        "须尽醉，莫推辞。",
        "人生多别离。"
      ],
      "author": {
        "id": 6242,
        "name": "晏殊"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312643,
      "title": "更漏子",
      "content": [
        "雪藏梅，烟著柳。",
        "依约上春时候。",
        "初送雁，欲问莺。",
        "绿池波浪生。",
        "探花开，留客醉。",
        "忆得去年情味。",
        "金盏酒，玉炉香。",
        "任他红日长。"
      ],
      "author": {
        "id": 6242,
        "name": "晏殊"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312644,
      "title": "更漏子",
      "content": [
        "菊花残，梨叶堕。",
        "可惜良辰虚过。",
        "新酒熟，绮筵开。",
        "不辞红玉杯。",
        "蜀弦高，羌管脆。",
        "慢飐舞娥香袂。",
        "君莫笑，醉乡人。",
        "熙熙长似春。"
      ],
      "author": {
        "id": 6242,
        "name": "晏殊"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312645,
      "title": "鹊踏枝・蝶恋花",
      "content": [
        "槛菊愁烟兰泣露。",
        "罗幕轻寒，燕子双飞去。",
        "明月不谙离恨苦。",
        "斜光到晓穿朱户。",
        "昨夜西风凋碧树。",
        "独上高楼，望尽天涯路。",
        "欲寄彩笺兼尺素。",
        "山长水阔知何处。"
      ],
      "author": {
        "id": 6242,
        "name": "晏殊"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312646,
      "title": "鹊踏枝・蝶恋花",
      "content": [
        "紫府群仙名籍秘。",
        "五色斑龙，暂降人间世。",
        "海变桑田都不记。",
        "蟠桃一熟三千岁。",
        "露滴彩旌云绕袂。",
        "谁信壶中，别有笙歌地。",
        "门外落花随水逝。",
        "相看莫惜尊前醉。"
      ],
      "author": {
        "id": 6242,
        "name": "晏殊"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312647,
      "title": "点绛唇",
      "content": [
        "露下风高，井梧宫簟生秋意。",
        "画堂筵启。",
        "一曲呈珠缀。",
        "天外行云，欲去凝香袂。",
        "炉烟起。",
        "断肠声里。",
        "敛尽双蛾翠。"
      ],
      "author": {
        "id": 6242,
        "name": "晏殊"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312648,
      "title": "凤衔杯",
      "content": [
        "青苹昨夜秋风起。",
        "无限个、露莲相倚。",
        "独凭朱阑、愁望晴天际。",
        "空目断、遥山翠。",
        "彩笺长，锦书细。",
        "谁信道、两情难寄。",
        "可惜良辰好景、欢娱地。",
        "只恁空憔悴。"
      ],
      "author": {
        "id": 6242,
        "name": "晏殊"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312649,
      "title": "凤衔杯",
      "content": [
        "留花不住怨花飞。",
        "向南园、情绪依依。",
        "可惜倒红斜白、一枝枝。",
        "经宿雨、又离披。",
        "凭朱槛，把金卮。",
        "对芳丛、惆怅多时。",
        "何况旧欢新恨、阻心期。",
        "空满眼、是相思。"
      ],
      "author": {
        "id": 6242,
        "name": "晏殊"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312650,
      "title": "凤衔杯",
      "content": [
        "柳条花颣恼青春。",
        "更那堪、飞絮纷纷。",
        "一曲细丝清脆、倚朱唇。",
        "斟绿酒、掩红巾。",
        "追往事，惜芳辰。",
        "暂时间、留住行云。",
        "端的自家心下、眼中人。",
        "到处里、觉尖新。"
      ],
      "author": {
        "id": 6242,
        "name": "晏殊"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312651,
      "title": "清平乐",
      "content": [
        "春花秋草。",
        "只是催人老。",
        "总把千山眉黛扫。",
        "未抵别愁多少。",
        "劝君绿酒金杯。",
        "莫嫌丝管声催。",
        "兔走乌飞不住，人生几度三台。"
      ],
      "author": {
        "id": 6242,
        "name": "晏殊"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312652,
      "title": "清平乐",
      "content": [
        "秋光向晚。",
        "小阁初开宴。",
        "林叶殷红犹未遍。",
        "雨后青苔满院。",
        "萧娘劝我金卮。",
        "殷勤更唱新词。",
        "暮去朝来节老，人生不饮何为。"
      ],
      "author": {
        "id": 6242,
        "name": "晏殊"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312653,
      "title": "清平乐",
      "content": [
        "春来秋去。",
        "往事知何处。",
        "燕子归飞兰泣露。",
        "光景千留不住。",
        "酒阑人散忡忡。",
        "闲阶独倚梧桐。",
        "记得去年今日，依前黄叶西风。"
      ],
      "author": {
        "id": 6242,
        "name": "晏殊"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312654,
      "title": "清平乐",
      "content": [
        "金风细细。",
        "叶叶梧桐坠。",
        "绿酒初尝人易醉。",
        "一枕小窗浓睡。",
        "紫微朱槿花残。",
        "斜阳却照阑干。",
        "双燕欲归时节，银屏昨夜微寒。"
      ],
      "author": {
        "id": 6242,
        "name": "晏殊"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312655,
      "title": "清平乐",
      "content": [
        "红笺小字。",
        "说尽平生意。",
        "鸿雁在云鱼在水。",
        "惆怅此情难寄。",
        "斜阳独倚西楼。",
        "遥山恰对帘钩。",
        "人面不知何处，绿波依旧东流。"
      ],
      "author": {
        "id": 6242,
        "name": "晏殊"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312656,
      "title": "红窗听",
      "content": [
        "淡薄梳妆轻结束。",
        "天意与、脸红眉绿。",
        "断环书素传情久，许双飞同宿。",
        "一饷无端分比目。",
        "谁知道、风前月底，相看未足。",
        "此心终拟，觅鸾弦重续。"
      ],
      "author": {
        "id": 6242,
        "name": "晏殊"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312657,
      "title": "红窗听",
      "content": [
        "记得香闺临别语。",
        "彼此有、万重心诉。",
        "淡云轻霭知多少，隔桃源无处。",
        "梦觉相思天欲曙。",
        "依前是、银屏画烛，宵长岁暮。",
        "此时何计，托鸳鸯飞去。"
      ],
      "author": {
        "id": 6242,
        "name": "晏殊"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312658,
      "title": "采桑子",
      "content": [
        "春风不负东君信，遍拆群芳。",
        "燕子双双。",
        "依旧衔泥入杏梁。",
        "须知一盏花前酒，占得韶光。",
        "莫话匆忙。",
        "梦里浮生足断肠。"
      ],
      "author": {
        "id": 6242,
        "name": "晏殊"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312659,
      "title": "采桑子",
      "content": [
        "红英一树春来早，独占芳时。",
        "我有心期。",
        "把酒攀条惜绛蕤。",
        "无端一夜狂风雨，暗落繁枝。",
        "蝶怨莺悲。",
        "满眼春愁说向谁。"
      ],
      "author": {
        "id": 6242,
        "name": "晏殊"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312660,
      "title": "采桑子",
      "content": [
        "阳和二月芳菲遍，暖景溶溶。",
        "戏蝶游蜂。",
        "深入千花粉艳中。",
        "何人解系天边日，占取春风。",
        "免使繁红。",
        "一片西飞一片东。"
      ],
      "author": {
        "id": 6242,
        "name": "晏殊"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312661,
      "title": "采桑子",
      "content": [
        "樱桃谢了梨花发，红白相催。",
        "燕子归来。",
        "几处风帘绣户开。",
        "人生乐事知多少，且酌金杯。",
        "管咽弦哀。",
        "慢引萧娘舞袖回。"
      ],
      "author": {
        "id": 6242,
        "name": "晏殊"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312662,
      "title": "采桑子",
      "content": [
        "古罗衣上金针样，绣出芳妍。",
        "玉砌朱阑。",
        "紫艳红英照日鲜。",
        "佳人画阁新妆了，对立丛边。",
        "试摘婵娟。",
        "贴向眉心学翠钿。"
      ],
      "author": {
        "id": 6242,
        "name": "晏殊"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312663,
      "title": "采桑子",
      "content": [
        "时光只解催人老，不信多情。",
        "长恨离亭。",
        "泪滴春衫酒易醒。",
        "梧桐昨夜西风急，淡月胧明。",
        "好梦频惊。",
        "何处高楼雁一声。"
      ],
      "author": {
        "id": 6242,
        "name": "晏殊"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312664,
      "title": "采桑子",
      "content": [
        "林间摘遍双双叶，寄与相思。",
        "朱槿开时。",
        "尚有山榴一两枝。",
        "荷花欲绽金莲子，半落红衣。",
        "晚雨微微。",
        "待得空梁宿燕归。"
      ],
      "author": {
        "id": 6242,
        "name": "晏殊"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312665,
      "title": "喜迁莺",
      "content": [
        "风转蕙，露催莲。",
        "莺语尚绵蛮。",
        "尧蓂随月欲团圆。",
        "真驭降荷兰。",
        "褰油幕。",
        "调清乐。",
        "四海一家同乐。",
        "千官心在玉炉香。",
        "圣寿祝天长。"
      ],
      "author": {
        "id": 6242,
        "name": "晏殊"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312666,
      "title": "喜迁莺",
      "content": [
        "歌敛黛，舞萦风。",
        "迟日象筵中。",
        "分行珠翠簇繁红。",
        "云髻袅珑璁。",
        "金炉暖。",
        "龙香远。",
        "共祝尧龄万万。",
        "曲终休解画罗衣。",
        "留伴彩云飞。"
      ],
      "author": {
        "id": 6242,
        "name": "晏殊"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312667,
      "title": "喜迁莺",
      "content": [
        "花不尽，柳无穷。",
        "应与我情同。",
        "觥船一棹百分空。",
        "何处不相逢。",
        "朱弦悄。",
        "知音少。",
        "天若有情应老。",
        "劝君看取利名场。",
        "今古梦茫茫。"
      ],
      "author": {
        "id": 6242,
        "name": "晏殊"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312668,
      "title": "喜迁莺",
      "content": [
        "烛飘花，香掩烬。",
        "中夜酒初醒。",
        "画楼残点两三声。",
        "窗外月胧明。",
        "晓帘垂，惊鹊去。",
        "好梦不知何处。",
        "南园春色已归来。",
        "庭树有寒梅。"
      ],
      "author": {
        "id": 6242,
        "name": "晏殊"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312669,
      "title": "喜迁莺",
      "content": [
        "曙河低，斜月淡。",
        "帘外早凉天。",
        "玉楼清唱倚朱弦。",
        "馀韵入疏烟。",
        "脸霞轻，眉翠重。",
        "欲舞钗钿摇动。",
        "人人如意祝炉香。",
        "为寿百千长。"
      ],
      "author": {
        "id": 6242,
        "name": "晏殊"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312670,
      "title": "撼庭秋",
      "content": [
        "别来音信千里。",
        "怅此情难寄。",
        "碧纱秋月，梧桐夜雨，几回无寐。",
        "楼高目断，天遥云黯，只堪憔悴。",
        "念兰堂红烛，心长焰短，向人垂泪。"
      ],
      "author": {
        "id": 6242,
        "name": "晏殊"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312671,
      "title": "少年游",
      "content": [
        "重阳过后，西风渐紧，庭树叶纷纷。",
        "朱阑向晓，芙蓉妖艳，特地斗芳新。",
        "霜前月下，斜红淡蕊，明媚欲回春。",
        "莫将琼萼等闲分。",
        "留赠意中人。"
      ],
      "author": {
        "id": 6242,
        "name": "晏殊"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312672,
      "title": "少年游",
      "content": [
        "霜华满树，兰凋蕙惨，秋艳入芙蓉。",
        "胭脂嫩脸，金黄轻蕊，犹自怨西风。",
        "前欢往事，当歌对酒，无限到心中。",
        "更凭朱槛忆芳容。",
        "肠断一枝红。"
      ],
      "author": {
        "id": 6242,
        "name": "晏殊"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312673,
      "title": "少年游",
      "content": [
        "芙蓉花发去年枝。",
        "双燕欲归飞。",
        "兰堂风软，金炉香暖，新曲动帘帷。",
        "家人拜上千春寿，深意满琼卮。",
        "绿鬓朱颜，道家装束，长似少年时。"
      ],
      "author": {
        "id": 6242,
        "name": "晏殊"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312674,
      "title": "少年游",
      "content": [
        "谢家庭槛晓无尘。",
        "芳宴祝良辰。",
        "风流妙舞，樱桃清唱，依约驻行云。",
        "榴花一盏浓香满，为寿百千春。",
        "岁岁年年，共欢同乐，嘉庆与时新。"
      ],
      "author": {
        "id": 6242,
        "name": "晏殊"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312675,
      "title": "酒泉子",
      "content": [
        "三月暖风，开却好花无限了，当年丛下落纷纷。",
        "最愁人。",
        "长安多少利名身。",
        "若有一杯香桂酒，莫辞花下醉芳茵。",
        "且留春。"
      ],
      "author": {
        "id": 6242,
        "name": "晏殊"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312676,
      "title": "酒泉子",
      "content": [
        "春色初来，遍拆红芳千万树，流莺粉蝶斗翻飞。",
        "恋香枝。",
        "劝君莫惜缕金衣。",
        "把酒看花须强饮，明朝后日渐离披。",
        "惜芳时。"
      ],
      "author": {
        "id": 6242,
        "name": "晏殊"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312677,
      "title": "木兰花・玉楼春",
      "content": [
        "东风昨夜回梁苑。",
        "日脚依稀添一线。",
        "旋开杨柳绿蛾眉，暗拆海棠红粉面。",
        "无情一去云中雁。",
        "有意归来梁上燕。",
        "有情无意且休论，莫向酒杯容易散。"
      ],
      "author": {
        "id": 6242,
        "name": "晏殊"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312678,
      "title": "木兰花・玉楼春",
      "content": [
        "帘旌浪卷金泥凤。",
        "宿醉醒来长瞢松。",
        "海棠开后晓寒轻，流絮飞时春睡重。",
        "美酒一杯谁与共。",
        "往事旧欢时节动。",
        "不如怜取眼前人，免更劳魂兼役梦。"
      ],
      "author": {
        "id": 6242,
        "name": "晏殊"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312679,
      "title": "木兰花・玉楼春",
      "content": [
        "燕鸿过后莺归去。",
        "细算浮生千万绪。",
        "长于春梦几多时，散似秋云无觅处。",
        "闻琴解佩神仙侣。",
        "挽断罗衣留不住。",
        "劝君莫作独醒人，烂醉花间应有数。"
      ],
      "author": {
        "id": 6242,
        "name": "晏殊"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312680,
      "title": "木兰花・玉楼春",
      "content": [
        "池塘水绿风微暖。",
        "记得玉真初见面。",
        "重头歌韵响铮琮，入破舞腰红乱旋。",
        "玉钩阑下香阶畔。",
        "醉后不知斜日晚。",
        "当时共我赏花人，点检如今无一半。"
      ],
      "author": {
        "id": 6242,
        "name": "晏殊"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312681,
      "title": "木兰花・玉楼春",
      "content": [
        "玉楼朱阁横金锁。",
        "寒食清明春欲破。",
        "窗间斜月两眉愁，帘外落花双泪堕。",
        "朝云聚散真无那。",
        "百岁相看能几个。",
        "别来将为不牵情，万转千回思想过。"
      ],
      "author": {
        "id": 6242,
        "name": "晏殊"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312682,
      "title": "木兰花・玉楼春",
      "content": [
        "朱帘半下香销印。",
        "二月东风催柳信。",
        "琵琶旁畔且寻思，鹦鹉前头休借问。",
        "惊鸿去后生离恨。",
        "红日长时添酒困。",
        "未知心在阿谁边，满眼泪珠言不尽。"
      ],
      "author": {
        "id": 6242,
        "name": "晏殊"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312683,
      "title": "木兰花・玉楼春",
      "content": [
        "杏梁归燕双回首。",
        "黄蜀葵花开应候。",
        "画堂元是降生辰，玉盏更斟长命酒。",
        "炉中百和添香兽。",
        "帘外青蛾回舞袖。",
        "此时红粉感恩人，拜向月宫千岁寿。"
      ],
      "author": {
        "id": 6242,
        "name": "晏殊"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312684,
      "title": "木兰花・玉楼春",
      "content": [
        "紫薇朱槿繁开后。",
        "枕簟微凉生玉漏。",
        "玳筵初启日穿帘，檀板欲开香满袖。",
        "红衫侍女频倾酒。",
        "龟鹤仙人来献寿。",
        "欢声喜气逐时新，青鬓玉颜长似旧。"
      ],
      "author": {
        "id": 6242,
        "name": "晏殊"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312685,
      "title": "木兰花・玉楼春",
      "content": [
        "春葱指甲轻拢拈。",
        "五彩条垂双袖卷。",
        "雪香浓透紫檀槽，胡语急随红玉腕。",
        "当头一曲情无限。",
        "入破铮琮金凤战。",
        "百分芳酒祝长春，再拜敛容抬粉面。"
      ],
      "author": {
        "id": 6242,
        "name": "晏殊"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312686,
      "title": "木兰花・玉楼春",
      "content": [
        "红条约束琼肌稳。",
        "拍碎香檀催急衮。",
        "垅头呜咽水声繁，叶下间关莺语近。",
        "美人才子传芳信。",
        "明月清风伤别恨。",
        "未知何处有知音，长为此情言不尽。"
      ],
      "author": {
        "id": 6242,
        "name": "晏殊"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312687,
      "title": "迎春乐",
      "content": [
        "长安紫陌春归早。",
        "亸垂杨、染芳草。",
        "被啼莺语燕催清晓。",
        "正好梦、频惊觉。",
        "当此际、青楼临大道。",
        "幽会处、两情多少。",
        "莫惜明珠百琲，占取长年少。"
      ],
      "author": {
        "id": 6242,
        "name": "晏殊"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312688,
      "title": "诉衷情",
      "content": [
        "青梅煮酒斗时新。",
        "天气欲残春。",
        "东城南陌花下，逢著意中人。",
        "回绣袂，展香茵。",
        "叙情亲。",
        "此情拼作，千尺游丝，惹住朝云。"
      ],
      "author": {
        "id": 6242,
        "name": "晏殊"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312689,
      "title": "诉衷情",
      "content": [
        "东风杨柳欲青青。",
        "烟淡雨初晴。",
        "恼他香阁浓睡，撩乱有啼莺。",
        "眉叶细，舞腰轻。",
        "宿妆成。",
        "一春芳意，三月和风，牵系人情。"
      ],
      "author": {
        "id": 6242,
        "name": "晏殊"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312690,
      "title": "诉衷情",
      "content": [
        "芙蓉金菊斗馨香。",
        "天气欲重阳。",
        "远村秋色如画，红树间疏黄。",
        "流水淡，碧天长。",
        "路茫茫。",
        "凭高目断，鸿雁来时，无限思量。"
      ],
      "author": {
        "id": 6242,
        "name": "晏殊"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312691,
      "title": "诉衷情",
      "content": [
        "数枝金菊对芙蓉。",
        "摇落意重重。",
        "不知多少幽怨，和露泣西风。",
        "人散后，月明中。",
        "夜寒浓。",
        "谢娘愁卧，潘令闲眠，心事无穷。"
      ],
      "author": {
        "id": 6242,
        "name": "晏殊"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312692,
      "title": "诉衷情",
      "content": [
        "露莲双脸远山眉。",
        "偏与淡妆宜。",
        "小庭帘幕春晚，闲共柳丝垂。",
        "人别后，月圆时。",
        "信迟迟。",
        "心心念念，说尽无凭，只是相思。"
      ],
      "author": {
        "id": 6242,
        "name": "晏殊"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312693,
      "title": "诉衷情",
      "content": [
        "秋风吹绽北池莲。",
        "曙云楼阁鲜。",
        "画堂今日嘉会，齐拜玉炉烟。",
        "斟美酒，祝芳筵。",
        "奉觥船。",
        "宜春耐夏，多福庄严，富贵长年。"
      ],
      "author": {
        "id": 6242,
        "name": "晏殊"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312694,
      "title": "诉衷情",
      "content": [
        "世间荣贵月中人。",
        "嘉庆在今辰。",
        "兰堂帘幕高卷，清唱遏行云。",
        "持玉盏，敛红巾。",
        "祝千春。",
        "榴花寿酒，金鸭炉香，岁岁长新。"
      ],
      "author": {
        "id": 6242,
        "name": "晏殊"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312695,
      "title": "诉衷情",
      "content": [
        "海棠珠缀一重重。",
        "清晓近帘栊。",
        "胭脂谁与匀淡，偏向脸边浓。",
        "看叶嫩，惜花红。",
        "意无穷。",
        "如花似叶，岁岁年年，共占春风。"
      ],
      "author": {
        "id": 6242,
        "name": "晏殊"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    }
  ],
