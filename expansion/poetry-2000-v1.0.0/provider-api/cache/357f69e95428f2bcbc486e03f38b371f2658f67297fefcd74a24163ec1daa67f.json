{
  "data": [
    {
      "id": 265329,
      "title": "秋日题窦员外崇德里新居",
      "content": [
        "长爱街西风景闲，到君居处暂开颜。",
        "清光门外一渠水，秋色墙头数点山。",
        "疎种碧松通月朗，多栽红药待春还。",
        "莫言堆案无余地，认得诗人在此间。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 265330,
      "title": "蒙恩转仪曹郎依前充集贤学士举韩潮州自代因寄七言",
      "content": [
        "翔鸾阙下谢恩初，通籍由来在石渠。",
        "暂入南宫判祥瑞，还归内殿阅图书。",
        "故人犹在三江外，同病凡经二纪余。",
        "今日荐君嗟久滞，不惟文体似相如。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 265331,
      "title": "途次华州陪钱大夫登城北楼春望因覩李崔令狐三相国唱和之什翰林旧侣继踵华城山水清高鸾凤翔集皆忝宿眷遂题此诗",
      "content": [
        "城楼四望出风尘，见尽关西渭北春。",
        "百二山河雄上国，一双旌斾委名臣。",
        "壁中今日题诗处，天上同时草诏人。",
        "莫怪老郎呈滥吹，宦途虽别旧情亲。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 265332,
      "title": "始闻秋风",
      "content": [
        "昔看黄菊与君别，今听玄蝉我却回。",
        "五夜飕飗枕前觉，一年颜状镜中来。",
        "马思边草拳毛动，雕眄青云睡眼开。",
        "天地肃清堪四望，为君扶病上高台。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 265333,
      "title": "洛中初冬拜表有怀上京故人",
      "content": [
        "凤楼南面控三条，拜表郎官早渡桥。",
        "清洛晓光铺碧簟，上阳霜叶剪红绡。",
        "省门簪组初成列，云路鸳鸾想退朝。",
        "寄谢慇懃九天侣，抢榆水击各逍遥。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 265334,
      "title": "尉迟郎中见示自南迁牵复却至洛城东旧居之作因以和之",
      "content": [
        "曾遭飞语十年谪，新受恩光万里还。",
        "朝服不妨游洛浦，郊园依旧看嵩山。",
        "竹含天籁清商乐，水遶庭台碧玉环。",
        "留作功成退身地，如今只是暂时闲。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 265335,
      "title": "洛中詶福建陈判官见赠",
      "content": [
        "潦倒声名拥肿材，一生多故苦邅回。",
        "南宫旧籍遥相管，东洛闲门昼未开。",
        "静对道流论药石，偶逢词客与琼瑰。",
        "怪君近日文锋利，新向延平看劒来。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 265336,
      "title": "和苏十郎中谢病闲居时严常侍萧给事同过访叹初有二毛之作",
      "content": [
        "清羸隐几望云空，左掖鸳鸾到室中。",
        "一卷素书消永日，数茎斑髪对秋风。",
        "菱花照后容虽改，蓍草占来命已通。",
        "莫怪人人惊早白，缘君尚是黑头翁。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 265337,
      "title": "酬淮南廖参谋秋夕见过之作",
      "content": [
        "扬州从事夜相寻，无限新诗月下吟。",
        "初服已惊玄髪长，高情犹向碧云深。",
        "语余时举一杯酒，坐久方闻四处砧。",
        "不逐繁华访闲散，知君摆落俗人心。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 265338,
      "title": "题王郎中宣义里新居",
      "content": [
        "爱君新买街西宅，客到如游鄠杜间。",
        "雨后退朝贪种树，申时出省趂看山。",
        "门前巷陌三条近，墙内池亭万境闲。",
        "见拟移居作邻里，不论时节请开关。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 265339,
      "title": "酬朗州崔员外与任十四兄侍御同过鄙人旧居见怀之什时守吴郡",
      "content": [
        "昔日居邻招屈亭，枫林橘树鹧鸪声。",
        "一辞御苑青门去，十见蛮江白芷生。",
        "自此曾沾宣室召，如今又守阖闾城。",
        "何人万里能相忆，同舍仙郎与外兄。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 265340,
      "title": "刘驸马水亭避暑",
      "content": [
        "千竿竹翠数莲红，水阁虚凉玉簟空。",
        "琥珀琖红疑漏酒，水晶帘莹更通风。",
        "赐冰满盌沈朱实，法馔盈盘覆碧笼。",
        "尽日逍遥避烦暑，再三珍重主人翁。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 265341,
      "title": "述旧贺迁寄陕虢孙常侍",
      "content": [
        "南宫幸袭芝兰后，左辅曾交印绶来。",
        "多病未离清洛苑，新恩已历望仙台。",
        "关头古塞桃林静，城下长河竹箭回。",
        "闻说随车有零雨，此时偏动子荆才。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 265342,
      "title": "江陵严司空见示与成都武相公唱和因命同作",
      "content": [
        "南荆西蜀大行台，幕府旌门相对开。",
        "名重三司平水土，威雄八阵役风雷。",
        "彩云朝望青城起，锦浪秋经白帝来。",
        "不是郢中清唱发，谁当丞相掞天才。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 265343,
      "title": "庙庭偃松诗",
      "content": [
        "势轧枝偏根已危，高情一见与扶持。",
        "忽从顦顇有生意，却为离披无俗姿。",
        "影入岩廊行乐处，韵含天籁宿斋时。",
        "谢公莫道东山去，待取阴成满凤池。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 265344,
      "title": "赠致仕滕庶子先辈",
      "content": [
        "朝服归来昼锦荣，登科记上更无兄。",
        "寿觞每使曾孙献，胜境长携众妓行。",
        "[矍]铄据鞍时骋健，殷勤把酒尚多情。",
        "凌寒却向山阴去，衣绣郎君雪里行。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 265345,
      "title": "哭吕衡州时予方谪居",
      "content": [
        "一夜霜风凋玉芝，苍生望绝士林悲。",
        "空怀济世安人略，不见男婚女嫁时。",
        "遗草一函归太史，旅坟三尺近要离。",
        "朔方徙岁行当满，欲为君刊第二碑。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 265346,
      "title": "夔州窦员外使君见示悼妓诗顾余尝识之因命同作",
      "content": [
        "前年曾见两鬟时，今日惊吟悼妓诗。",
        "凤管学成知有籍，龙媒欲换叹无期。",
        "空廊月照常行地，后院花开旧折枝。",
        "寂寞鱼山青草里，何人更立智琼祠。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 265347,
      "title": "窦夔州见寄寒食日忆故姬小红吹笙因和之",
      "content": [
        "鸾声窈眇管参差，清韵初调众乐随。",
        "幽院妆成花下弄，高楼月好夜深吹。",
        "忽惊暮雨飘零尽，唯有朝云梦想期。",
        "闻道今年寒食日，东山旧路独行迟。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 265348,
      "title": "哭庞京兆",
      "content": [
        "俊骨英才气褎然，策名飞步冠群贤。",
        "逢时已自致高位，得疾还因倚少年。",
        "天上别归京兆府，人间空数茂陵阡。",
        "今朝穗帐哭君处，前日见铺歌舞筵。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 265349,
      "title": "送李庚先辈赴选",
      "content": [
        "一家何啻十朱轮，诸父双飞秉大钧。",
        "曾脱素衣参幕客，却为精舍读书人。",
        "离筵雒水侵杯色，征路函关向晚尘。",
        "今日山公旧宾主，知君不负帝城春。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 265350,
      "title": "阳山庙观赛神",
      "content": [
        "汉家都尉旧征蛮，血食如今配此山。",
        "曲盖幽深苍桧下，洞箫愁绝翠屏间。",
        "荆巫脉脉传神语，野老娑娑起醉颜。",
        "日落风生庙门外，几人连蹋竹歌还。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 265351,
      "title": "送僧元暠东游",
      "content": [
        "宝书翻译学初成，振锡如飞白足轻。",
        "彭泽因家凡几世，灵山预会是前生。",
        "传灯已悟无为理，濡露犹怀罔极情。",
        "从此多逢大居士，何人不愿解珠璎。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 265352,
      "title": "赠日本僧智藏",
      "content": [
        "浮杯万里过沧溟，遍礼名山适性灵。",
        "深夜降龙潭水黑，新秋放鹤野田青。",
        "身无彼我那怀土，心会真如不读经。",
        "为问中华学道者，几人雄猛得宁馨。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 265353,
      "title": "送元简上人适越",
      "content": [
        "孤云出岫本无依，胜境名山即是归。",
        "久向吴门游好寺，还思越水洗尘机。",
        "浙江涛惊狮子吼，稽岭峰疑灵鹫飞。",
        "更入天台石桥去，垂珠璀璨拂三衣。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 265354,
      "title": "送宗密上人归南山草堂寺因谒河南尹白侍郎",
      "content": [
        "宿习修来得慧根，多闻第一却忘言。",
        "自从七祖传心印，不要三乘入便门。",
        "东泛沧江寻古迹，西归紫阁出尘喧。",
        "河南白尹大檀越，好把真经相对翻。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 265355,
      "title": "西塞山怀古",
      "content": [
        "西晋楼船下益州，金陵王气黯然收。",
        "千寻铁锁沈江底，一片降旛出石头。",
        "人世几回伤往事，山形依旧枕江流。",
        "今逢四海为家日，故垒萧萧芦荻秋。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 265356,
      "title": "广宣上人寄在蜀与韦令公唱和诗卷因以令公手扎荅诗示之",
      "content": [
        "碧云佳句久传芳，曾向成都住草堂。",
        "振锡常过长者宅，披衣犹带令公香。",
        "一时风景添诗思，八部人天入道塲。",
        "吾家本自有柴桑。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 265357,
      "title": "白舍人自杭州寄新诗有柳色春藏苏小家之句因而戏酬兼寄浙东元相公",
      "content": [
        "钱塘山水有奇声，暂谪仙官领百城。",
        "女妓还闻名小小，使君谁许唤卿卿。",
        "鼇惊震海风雷起，蜃鬬嘘天楼阁成。",
        "莫道骚人在三楚，文星今向斗牛明。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 265358,
      "title": "春日书怀寄东洛白二十二杨八二庶子",
      "content": [
        "曾向空门学坐禅，如今万事尽忘筌。",
        "眼前名利同春梦，醉里风情敌少年。",
        "野草芳菲红锦地，游丝撩乱碧罗天。",
        "心知洛下闲才子，不作诗魔即酒颠。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 265359,
      "title": "白舍人见酬拙诗因以寄谢",
      "content": [
        "虽陪三品散班中，资历从来事不同。",
        "名姓也曾镌石柱，诗篇未得上屏风。",
        "甘陵旧党凋零尽，魏阙新知礼数崇。",
        "烟水五湖如有伴，犹应堪作钓鱼翁。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 265360,
      "title": "白舍人曹长寄新诗有游宴之盛因以戏酬",
      "content": [
        "苏州刺史例能诗，西掖今来替左司。",
        "二八城门开道路，五千兵马引旌旗。",
        "水通山寺笙歌去，骑过虹桥劒戟随。",
        "若共吴王鬬百草，不如应是欠西施。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 265361,
      "title": "苏州白舍人寄新诗有叹早白无儿之句因以赠之",
      "content": [
        "莫嗟华髪与无儿，却是人间久远期。",
        "雪里高山头白早，海中仙果子生迟。",
        "于公必有高门庆，谢守何烦晓镜悲。",
        "幸免如新分非浅，祝君长咏梦熊诗。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 265362,
      "title": "酬乐天扬州初逢席上见赠",
      "content": [
        "巴山楚水凄凉地，二十三年弃置身。",
        "怀旧空吟闻篴赋，到乡翻似烂柯人。",
        "沈舟侧畔千帆过，病树前头万木春。",
        "今日听君歌一曲，暂凭杯酒长精神。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 265363,
      "title": "罢郡归洛途次山阳留辞郭中丞使君",
      "content": [
        "自到山阳不许辞，高斋日夜有佳期。",
        "管弦正合看书院，语笑方酣各咏诗。",
        "银汉雪晴褰翠幕，清淮月影落金巵。",
        "洛阳归客明朝去，容趂城东花发时。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 265364,
      "title": "楚州开元寺北院枸杞临井繁茂可观群贤赋诗因以继和",
      "content": [
        "僧房药树依寒井，井有香泉树有灵。",
        "翠黛叶生笼石甃，殷红子熟照铜瓶。",
        "枝繁本是仙人杖，根老新成瑞犬形。",
        "上品功能甘露味，还知一勺可延龄。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 265365,
      "title": "和乐天鹦鹉",
      "content": [
        "养来鹦鹉觜初红，宜在朱楼绣户中。",
        "频学唤人缘性慧，偏能识主为情通。",
        "歛毛睡足难销日，亸翅愁时愿见风。",
        "谁遣聪明好颜色，事须安置入深笼。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 265366,
      "title": "洛中逢白监同话游梁之乐因寄宣武令狐相公",
      "content": [
        "曾经谢病各游梁，今日相逢忆孝王。",
        "少有一身兼将相，更能四面占文章。",
        "开颜坐上催飞盏，廻首庭中看舞枪。",
        "借问风前兼月下，不知何客对胡床。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 265367,
      "title": "河南王少尹宅燕张常侍白舍人兼呈卢郎中李员外二副使",
      "content": [
        "将星夜落使星来，三省清臣到外台。",
        "事重各衔天子诏，礼成同把故人杯。",
        "卷帘松竹雪初霁，满院池塘春欲回。",
        "第一林亭迎好客，殷勤莫惜玉山颓。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 265368,
      "title": "和宣武令狐相公郡斋对新竹",
      "content": [
        "新竹翛翛韵晓风，隔囱依砌尚蒙笼。",
        "数间素壁初开后，一段清光入坐中。",
        "欹枕闲看知自适，含毫朗咏与谁同。",
        "此君若欲长相见，政事堂东有旧丛。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 265369,
      "title": "和乐天送鹤上裴相公别鹤之作",
      "content": [
        "昨日看成送鹤诗，高笼提出白云司。",
        "朱门乍入应迷路，玉树容栖莫拣枝。",
        "双舞庭中花落处，数声池上月明时。",
        "三山碧海不归去，且向人间呈羽仪。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 265370,
      "title": "阙下待传点呈诸同舍",
      "content": [
        "禁漏晨钟声欲绝，旌旗组绶影相交。",
        "殿含佳气当龙首，阁倚晴天见凤巢。",
        "山色葱笼丹槛外，霞光泛滟翠松梢。",
        "多慙再入金门籍，不敢为文学解嘲。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 265371,
      "title": "和乐天以镜换酒",
      "content": [
        "把取菱花百炼镜，换他竹叶十旬杯。",
        "嚬眉厌老终难去，蘸甲须欢便到来。",
        "妍丑太分迷忌讳，松乔俱傲绝嫌猜。",
        "校量功力相千万，好去从空白玉台。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 265372,
      "title": "同乐天送河南冯尹学士",
      "content": [
        "可怜五马风流地，暂辍金貂侍从才。",
        "阁上掩书刘向去，门前修刺孔融来。",
        "崤陵路静寒无雨，洛水桥长昼起雷。",
        "共羡府中棠棣好，先于城外百花开。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 265373,
      "title": "同白二十二赠王山人",
      "content": [
        "爱名之世忘名客，多事之时无事身。",
        "古老相传见来久，岁年虽变貌常新。",
        "飞章上达三清路，受箓平交五岳神。",
        "笑听冬冬朝暮鼓，只能催得市朝人。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 265374,
      "title": "题集贤阁",
      "content": [
        "凤池西畔图书府，玉树玲珑景气闲。",
        "长听余风送天乐，时登高阁望人寰。",
        "青山云绕栏干外，紫殿香来步武间。",
        "曾是先贤翔集地，每看壁记一慙颜。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 265375,
      "title": "和令狐相公初归京国赋诗言怀",
      "content": [
        "凌云羽翮掞天才，扬历中枢与外台。",
        "相印昔辞东阁去，将星还拱北辰来。",
        "殿庭捧日彯缨入，阁道看山曳履回。",
        "口不言功心自适，吟诗酿酒待花开。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 265376,
      "title": "和乐天南园试小乐",
      "content": [
        "闲步南园烟雨晴，遥闻丝竹出墙声。",
        "欲抛丹笔三川去，先教清商一部成。",
        "花木手栽偏有兴，歌词自作别生情。",
        "多才遇景皆能咏，当日人传满凤城。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 265377,
      "title": "答乐天戏赠",
      "content": [
        "才子声名白侍郎，风流虽老尚难当。",
        "诗情逸似陶彭泽，斋日多如周太常。",
        "矻矻将心求净法，时时偷眼看春光。",
        "知君技痒思欢䜩，欲倩天魔破道塲。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 265378,
      "title": "同乐天送令狐相公赴东都留守",
      "content": [
        "尚书劒履出明光，居守旌旗赴洛阳。",
        "世上功名兼将相，人间声价是文章。",
        "衙门晓辟分天仗，宾幕初开辟省郎。",
        "从发坡头向东望，春风处处有甘棠。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 265379,
      "title": "刑部白侍郎谢病长告改宾客分司以诗赠别",
      "content": [
        "鼎食华轩到眼前，拂衣高谢岂徒然。",
        "九霄路上辞朝客，四皓丛中作少年。",
        "他日卧龙终得雨，今朝放鹤且冲天。",
        "洛阳旧有衡茆在，亦拟抽身伴地仙。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 265380,
      "title": "和留守令狐相公答白宾客",
      "content": [
        "麦陇和风吹树枝，商山逸客出关时。",
        "身无拘束起长晚，路足交亲行自迟。",
        "官拂象筵终日待，私将鸡黍几人期。",
        "君来不用飞书报，万户先从纸贵知。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 265381,
      "title": "酬郓州令狐相公官舍言怀见寄兼呈乐天",
      "content": [
        "词人各在一涯居，声味虽同迹自疎。",
        "佳句传因多好事，尺题稀为不便书。",
        "已通戎略逢黄石，仍占星文耀碧虚。",
        "闻说朝天在来岁，霸陵春色待行车。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 265382,
      "title": "吟白乐天哭崔儿二篇怆然寄赠",
      "content": [
        "吟君苦调我霑缨，能使无情尽有情。",
        "四望车中心未释，千秋亭下赋初成。",
        "庭梧已有栖雏处，池鹤今无子和声。",
        "从此期君比琼树，一枝吹折一枝生。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 265383,
      "title": "答乐天所寄咏怀且释其枯树之叹",
      "content": [
        "衙前有乐馔常精，宅内连池酒任倾。",
        "自是官高无狎客，不论年长少欢情。",
        "骊龙颔被探珠去，老蚌胚还应月生。",
        "莫羡三春桃与李，桂花成实向秋荣。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 265384,
      "title": "赴苏州酬别乐天",
      "content": [
        "吴郡鱼书下紫宸，长安厩吏送朱轮。",
        "二南风化承遗爱，八咏声名蹑后尘。",
        "梁氏夫妻为寄客，陆家兄弟是州民。",
        "江城春日追游处，共忆东归旧主人。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 265385,
      "title": "福先寺雪中酬别乐天",
      "content": [
        "龙门宾客会龙宫，东去旌旗驻上东。",
        "二八笙歌云幕下，三千世界雪花中。",
        "离堂未暗排红烛，别曲含凄飏晚风。",
        "才子从今一分散，便将诗咏向吴侬。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 265386,
      "title": "和乐天耳顺吟兼寄敦诗",
      "content": [
        "吟君新什慰蹉跎，屈指同登耳顺科。",
        "邓禹功成三纪事，孔融书就八年多。",
        "已经将相谁能尔，抛却丞郎争奈何。",
        "独恨长洲数千里，且随鱼鸟泛烟波。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 265387,
      "title": "和白侍郎送令狐相公镇太原",
      "content": [
        "十万天兵貂锦衣，晋城风日斗生辉。",
        "行台仆射深恩重，从事中郎旧路归。",
        "叠鼓蹙成汾水浪，闪旗惊断塞鸿飞。",
        "边庭自此无烽火，拥节还来坐紫微。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 265388,
      "title": "酬乐天见寄",
      "content": [
        "元君后辈先零落，崔相同年不少留。",
        "华屋坐来能几日，夜台归去便千秋。",
        "背时犹自居三品，得老终须卜一丘。",
        "若使吾徒还早达，亦应箫鼓入松楸。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 265389,
      "title": "乐天寄重和晚达冬青一篇因成再答",
      "content": [
        "风云变化饶年少，光景蹉跎属老夫。",
        "秋隼得时凌汗漫，寒龟饮气受泥涂。",
        "东隅有失谁能免，北叟之言岂便无。",
        "振臂犹堪呼一掷，争知掌下不成卢。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 265390,
      "title": "河南白尹有喜崔宾客归洛兼见怀长句因而继和",
      "content": [
        "几年侍从作名臣，却向青云索得身。",
        "朝士忽为方外士，主人仍是眼中人。",
        "双鸾游处天京好，五马行时海峤春。",
        "遥羡光阴不虚掷，肯令丝竹暂生尘。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 265391,
      "title": "和杨师臯给事伤小姬英英",
      "content": [
        "见学胡琴见艺成，今朝追想几伤情。",
        "撚弦花下呈新曲，放拨灯前谢改名。",
        "但是好花皆易落，从来尤物不长生。",
        "鸾台夜直衣衾冷，云雨无因入禁城。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 265392,
      "title": "和乐天洛下醉吟寄太原令狐相公兼见怀长句",
      "content": [
        "旧相临戎非称意，词人作尹本多情。",
        "从容自使边尘静，谈笑不闻桴鼓声。",
        "章句新添塞下曲，风流旧占洛阳城。",
        "昨来亦有吴趋咏，惟寄东都与北京。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 265393,
      "title": "郡斋书怀寄江南白尹兼简分司崔宾客",
      "content": [
        "谩读图书三十车，年年为郡老天涯。",
        "一生不得文章力，百口空为饱煖家。",
        "绮季衣冠称鬓面，吴公政事副词华。",
        "还思谢病吟归去，同醉城东桃李花。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 265394,
      "title": "题于家公主旧宅",
      "content": [
        "树绕荒台叶满池，箫声一绝草虫悲。",
        "邻家犹学宫人髻，园客争偷御果枝。",
        "马埒蓬蒿藏狡兔，凤楼烟雨啸愁鸱。",
        "何郎独在无恩泽，不似当初傅粉时。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 265395,
      "title": "酬乐天贻贺金紫之什",
      "content": [
        "久学文章含白凤，却因政事赐金鱼。",
        "郡人未识闻谣咏，天子知名与诏书。",
        "珍重贺诗呈锦绣，愿言归计竝园庐。",
        "旧来词客多无位，金紫同游谁得如。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 265396,
      "title": "乐天见示伤微之敦诗晦叔三君子皆有深分因成是诗以寄",
      "content": [
        "吟君叹逝双绝句，使我伤怀奏短歌。",
        "世上空惊故人少，集中惟觉祭文多。",
        "芳林新叶催陈叶，流水前波让后波。",
        "万古到今同此恨，闻琴泪尽欲如何。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 265397,
      "title": "和乐天柘枝",
      "content": [
        "柘枝本出楚王家，玉面添娇舞态奢。",
        "松鬓改梳鸾凤髻，新衫别识鬬鸡纱。",
        "鼓催残拍腰身软，汗透罗衣雨点花。",
        "画筵曲罢辞归去，便随王母上烟霞。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 265398,
      "title": "和乐天题真娘墓",
      "content": [
        "薝卜林中黄土堆，罗襦绣黛已成灰。",
        "芳魂虽死人不怕，蔓草逢春花自开。",
        "幡盖向风疑舞袖，镜灯临晓似妆台。",
        "吴王娇女坟相近，一片行云应往来。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 265399,
      "title": "客有话汴州新政书事寄令狐相公",
      "content": [
        "天下咽喉今大宁，军城喜气彻青冥。",
        "庭前劒戟朝迎日，笔底文章夜应星。",
        "三省壁中题姓字，万人头上见仪形。",
        "汴州忽复承平事，正月看灯户不扃。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 265400,
      "title": "令狐相公见示河中杨少尹赠答兼命继之",
      "content": [
        "两首新诗百字余，朱弦玉磬韵难如。",
        "汉家丞相重征后，梁苑仁风一变初。",
        "四面诸侯瞻节制，八方通货溢河渠。",
        "自从却縠为元帅，大将归来尽把书。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 265401,
      "title": "和令狐相公送赵常盈炼师与中贵人同拜岳及天台投龙毕却赴京",
      "content": [
        "银珰谒者引蜺旌，霞帔仙官到赤城。",
        "白鹤迎来天乐动，金龙掷下海神惊。",
        "元君伏奏归中禁，武帝亲斋礼上清。",
        "何事夷门请诗送，梁王文字上声名。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 265402,
      "title": "酬令狐相公赠别",
      "content": [
        "越声长苦有谁闻，老向湘山与楚云。",
        "海峤新辞永嘉守，夷门重见信陵君。",
        "田园松菊今迷路，霄汉鸳鸿久绝群。",
        "幸遇甘泉尚词赋，不知何客荐雄文。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 265403,
      "title": "酬令狐相公寄贺迁拜之什",
      "content": [
        "邅廻二纪重为郎，洛下遥分列宿光。",
        "不见当关呼早起，曾无侍史与焚香。",
        "三花秀色通春幌，十字清波遶宅墙。",
        "白发青衫谁比数，相怜只是有梁王。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 265404,
      "title": "夏日寄宣武令狐相公",
      "content": [
        "长忆梁王逸兴多，西园花尽兴如何。",
        "近来溽暑侵亭馆，应觉清谈胜绮罗。",
        "境入篇章高韵发，风穿号令众心和。",
        "承明欲谒先相报，愿拂朝衣逐晓珂。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 265405,
      "title": "酬令狐留守巡内至集贤院见寄",
      "content": [
        "仙院文房隔旧宫，当时盛事尽成空。",
        "墨池半在颓垣下，书带犹生蔓草中。",
        "巡内因经九重苑，裁诗又继二南风。",
        "为兄手写殷勤句，遍历三台各一通。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 265406,
      "title": "和令狐相公言怀寄河中杨少尹",
      "content": [
        "章句慙非第一流，世间才子昔陪游。",
        "吴宫已叹芙蓉死，边月空悲芦管秋。",
        "任向洛阳称傲吏，苦教河上领诸侯。",
        "石渠甘对图书老，关外杨公安稳不。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 265407,
      "title": "令狐相公自天平移镇太原以诗申贺",
      "content": [
        "北都留守将天兵，出入香街宿禁扃。",
        "鼙鼓夜闻惊朔鴈，旌旗晓动拂参星。",
        "孔璋旧檄家家有，叔度新歌处处听。",
        "夷落遥知真汉相，争来屈膝看仪刑。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 265408,
      "title": "重酬前寄",
      "content": [
        "边烽寂寂尽收兵。",
        "宫树苍苍静掩扃，戎羯归心如内地。",
        "天狼无角比凡星，新成丽句开缄后。",
        "便入清歌满坐听，吴苑晋祠遥望处。",
        "可怜南北太相形。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 265409,
      "title": "令狐相公自太原累示新诗因以酬寄",
      "content": [
        "飞蓬卷尽塞云寒，战马闲嘶汉地宽。",
        "万里胡天无警急，一笼烽火报平安。",
        "灯前妓乐留宾宴，雪后山河出猎看。",
        "珍重新诗远相寄，风情不似四登坛。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 265410,
      "title": "酬令狐相公使宅别斋初栽桂树见怀之作",
      "content": [
        "清淮南岸家山树，黑水东边第一栽。",
        "影近画梁迎晓日，香随绿酒入金杯。",
        "根留本土依江润，叶起寒棱映月开。",
        "早晚阴城比梧竹，九霄还放彩雏来。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 265411,
      "title": "酬令狐相公见寄",
      "content": [
        "才兼文武播雄名，遗爱芳尘满洛城。",
        "身在行台为仆射，书来甪里访先生。",
        "闲游占得嵩山色，醉卧高听洛水声。",
        "千里相思难命驾，七言诗里寄深情。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 265412,
      "title": "郡内书情献裴侍中留守",
      "content": [
        "功成频献乞身章，摆落襄阳镇洛阳。",
        "万乘旌旗分一半，八方风雨会中央。",
        "兵符今奉黄公略，书殿曾随翠凤翔。",
        "心寄华亭一双鹤，曰陪高步绕池塘。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 265413,
      "title": "酬乐天衫酒见寄",
      "content": [
        "酒法众传吴米好，舞衣偏尚越罗轻。",
        "动摇浮蚁香浓甚，装束轻鸿意态生。",
        "阅曲定知能自适，举杯应叹不同倾。",
        "终朝相忆终年别，对景临风无限情。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 265414,
      "title": "自左冯归洛下酬乐天兼呈裴令公",
      "content": [
        "新恩通籍在龙楼，分务神都近旧丘。",
        "自有园公紫芝侣，仍追少傅赤松游。",
        "华林霜叶红霞晚，伊水晴光碧玉秋。",
        "更接东山文酒会，始知江左未风流。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 265415,
      "title": "秋斋独坐寄乐天兼呈吴方之大夫",
      "content": [
        "空斋寂寂不生尘，药物方书绕病身。",
        "纤草数茎胜静地，幽禽忽至似佳宾。",
        "世间忧喜虽无定，释氏销磨尽有因。",
        "同向洛阳闲度日，莫教风景属他人。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 265416,
      "title": "和乐天斋戒月满夜对道场偶怀咏",
      "content": [
        "常修清净去繁华，人识王城长者家。",
        "案上香烟铺贝叶，佛前灯焰透莲花。",
        "持斋已满招闲客，理曲先闻命小娃。",
        "明日若过方丈室，还应问为法来邪。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 265417,
      "title": "吴方之见示独酌小醉首篇乐天续有詶答皆含戏谑极至风流两篇之中竝蒙见属辄呈滥吹益美来章",
      "content": [
        "闲门共寂任张罗，静室同虚养太和。",
        "尘世欢娱开意少，醉乡风景独游多。",
        "散金疏傅寻常乐，枕曲刘生取次歌。",
        "计会雪中争挈榼，鹿裘鹤氅递相过。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 265418,
      "title": "酬乐天斋满日裴令公置宴席上戏赠",
      "content": [
        "一月道场斋戒满，今朝华幄管弦迎。",
        "衔杯本自多狂态，事佛无妨有佞名。",
        "酒力半酣愁已散，文锋未钝老犹争。",
        "平阳不独容宾醉，听取喧呼吏舍声。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 265419,
      "title": "酬乐天偶题酒瓮见寄",
      "content": [
        "从君勇断抛名后，世路荣枯见几回。",
        "门外红尘人自走，瓮头清酒我初开。",
        "三冬学任胸中有，万户侯须骨上来。",
        "何幸相招同醉处，洛阳城里好池台。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 265420,
      "title": "酬乐天请裴令公开春加宴",
      "content": [
        "高名大位能兼有，恣意遨游是特恩。",
        "二室烟霞成步障，三川风物是家园。",
        "晨窥苑树韶光动，晚度河桥春思繁。",
        "弦管常调客常满，但逢花处即开樽。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 265421,
      "title": "乐天示过敦诗旧宅有感一篇吟之泫然追想昔事因成继和以寄苦怀",
      "content": [
        "凄凉同到故人居，门枕寒流古木疎。",
        "向秀心中嗟栋宇，萧何身后散图书。",
        "本营归计非无意，唯算生涯尚有余。",
        "忽忆前言更惆怅，丁宁相约速悬车。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 265422,
      "title": "寄和东川杨尚书慕巢兼寄西川继之二公近从弟兄情分偏睦早忝游旧因成是诗",
      "content": [
        "太华莲峰降岳灵，两川棠树接郊坰。",
        "政同兄弟人人乐，曲奏埙篪处处听。",
        "杨叶百穿荣会府，芝泥五色耀天庭。",
        "各抛笔砚夸旄钺，莫遣文星让将星。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 265423,
      "title": "和乐天洛下雪中宴集寄汴州李尚书",
      "content": [
        "洛城无事足杯盘，风雪相和岁欲兰。",
        "树上因依见寒鸟，坐中收拾尽闲官。",
        "笙歌要请频何爽，笑语忘机拙更欢。",
        "遥想兔园今日会，琼林满眼映旗竿。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 265424,
      "title": "和牛相公游南庄醉后寓言戏赠乐天兼见示",
      "content": [
        "城外园林初夏天，就中野趣在西偏。",
        "蔷薇乱发多临水，㶉𫛶双游不避船。",
        "水底远山云似雪，桥边平岸草如烟。",
        "白家唯有杯觞兴，欲把头盘打少年。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 265425,
      "title": "乐天以愚相访沽酒致欢因成七言聊以奉答",
      "content": [
        "少年曾醉酒旗下，同辈黄衣颔亦黄。",
        "蹴踏青云寻入仕，萧条白发且飞觞。",
        "令征古事欢生雅，客唤闲人兴任狂。",
        "犹胜独居荒草院，蝉声听尽到寒螀。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 265426,
      "title": "和思黯忆南庄见示",
      "content": [
        "丞相新家伊水头，智囊心匠日增修。",
        "化成池沼无痕迹，奔走清波不自由。",
        "台上看山徐举酒，潭中见月慢回舟。",
        "从来天下推尤物，合属人间第一流。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 265427,
      "title": "酬思黯见示小饮四韵",
      "content": [
        "抛却人间第一官，俗情惊怪我方安。",
        "兵府相印无心恋，洛水嵩云恣意看。",
        "三足鼎中知味久，百寻竿上掷身难。",
        "追呼故旧连宵饮，直到天明兴未阑。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 265428,
      "title": "和仆射牛相公春日闲坐见怀",
      "content": [
        "官曹崇重难频入，第宅清闲且独行。",
        "阶蚁相逢如偶语，园蜂速去恐违程。",
        "人于红药惟看色，莺到垂杨不惜声。",
        "东洛池台怨抛掷，移文非久会应成。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    }
  ],
