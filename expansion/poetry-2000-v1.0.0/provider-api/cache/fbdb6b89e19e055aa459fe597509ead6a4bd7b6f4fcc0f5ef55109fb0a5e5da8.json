  "data": [
    {
      "id": 13140,
      "title": "顺祀诗",
      "content": [
        "孰顺其祀，明明天子。",
        "天子谦让，诏群臣其议。",
        "惟章献、章懿，遂祔先帝。",
        "宜索而典，而古而今。",
        "顺考攸宜，慰我孝心。",
        "群臣稽首，不远厥成。",
        "伊先猷是程，伊大孝是经。",
        "匪祥符孰从，则莫我京。",
        "三代庙寝，止一帝后。",
        "汉制已迁，儒臣罔究。",
        "礼缺不称，因朴趋陋。",
        "亲靡祔尊，神挈斯祐。",
        "帝曰俞哉，予奉二慈。",
        "匪曰无典，实成训是依。",
        "促灼尔龟，爰𫈵尔仪。",
        "琢金追玉，昭款信辞。",
        "不敢先后，惟以顺跻。",
        "孟冬十月，大飨其时。",
        "朕不惮勤，于庭遣之。",
        "吉日辛酉，帝自文德。",
        "至于大庆，奉宝授册。",
        "永怀劬劳，孝贯天极。",
        "虞宾在位，百官承式。",
        "显显太岁，惟册宝是将。",
        "和鸾有容，龙旗孔扬。",
        "既至于庙，是承是告。",
        "奉迁后主，合侑文考。",
        "有主则止，有匹得行。",
        "遂旅豆笾，以及芼牲。",
        "明水太羹，有𫗣有澄。",
        "鼓钟钦钦，鼓瑟鼓琴。",
        "考悦妣安，蠲我德音。",
        "德音惟何，帝受纯嘏。",
        "不专斯飨，用赦天下。",
        "开释罪辜，赐逮九军。",
        "一人作孝，庶邦蒙仁。",
        "礼非天作，托始于圣。",
        "圣克正始，万世攸定。",
        "作述交善，神人胥庆。",
        "天谓皇帝，既付所覆。",
        "帝克孝治，奉亲以侑。",
        "其收丕祺，蕃衍后昆。",
        "万有亿年，继继存存。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 13141,
      "title": "上许州吕相公嗣崧许康诗二首 嗣崧诗 其一",
      "content": [
        "彼岳惟崧，天作其神。",
        "嗣生我公，我公斤斤。",
        "嘉猷矢陈，柄国之均。",
        "帝亲命之，纂成前人。",
        "不显其道，惟申是保。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 13142,
      "title": "上许州吕相公嗣崧许康诗二首 嗣崧诗 其二",
      "content": [
        "公迈厥德，祗祗翼翼。",
        "柔嘉而直，模我彝伦。",
        "揉我方国，施于夷貊。",
        "百度是毗，庶绩允熙。",
        "罔敢不恪，惟公是若。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 13143,
      "title": "上许州吕相公嗣崧许康诗二首 嗣崧诗 其三",
      "content": [
        "帝诏执事，彻申土疆，衍沃腴良。",
        "赋舆溱溱，莫乐于申。",
        "昔在四岳，佑尧象禹，为国心膂。",
        "受民作邦，于今以光。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 13144,
      "title": "上许州吕相公嗣崧许康诗二首 嗣崧诗 其四",
      "content": [
        "帝告于公，绍胥尔宇。",
        "宪是文武，如申如甫，为周之辅。",
        "诞锡尔祉，惟申甫是似。",
        "乘车错衡，淑施英英，式遄其荣。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 13145,
      "title": "上许州吕相公嗣崧许康诗二首 嗣崧诗 其五",
      "content": [
        "公拜稽首，敢扬王休。",
        "祈天之久，为天子万寿。",
        "彼岳磐磐，松柏丸丸，公福禄实蕃。",
        "有崇而冈，有大而陵，公寿考是承。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 13146,
      "title": "上许州吕相公嗣崧许康诗二首 许康诗 其一",
      "content": [
        "许丽而康，岳孙奠之。",
        "曰公之屏，实维似之。",
        "公徒增增，朱綅绿縢。",
        "不戁不惊，钩膺镂锡。",
        "称娖颜行，哕焉绥章。",
        "总我列侯，式时南疆。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 13147,
      "title": "上许州吕相公嗣崧许康诗二首 许康诗 其二",
      "content": [
        "公之相攸，孔乐于许。",
        "其原膴膴，其川訏訏。",
        "有芃禾麻，有京稷黍。",
        "薮焉麋麕，渚焉鲂𫚈。",
        "有李有桃，有柘有檀。",
        "树我之园，令居则安。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 13148,
      "title": "上许州吕相公嗣崧许康诗二首 许康诗 其三",
      "content": [
        "公视于庭，师兵翼翼，孔武有力。",
        "公适于府，陪卿髦士，罔不就绪。",
        "公宴于堂，嘉宾我从。",
        "琴瑟鼓钟，或揳或𪭢。",
        "静好铿锵，万舞有容。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 13149,
      "title": "上许州吕相公嗣崧许康诗二首 许康诗 其四",
      "content": [
        "左拂其殽，炰鼈燔羔，给鲜于庖。",
        "右烹其蔌，笋菭蒲葅，柔嘉惟馥。",
        "旨酒且多，其饮温克。",
        "摄尔攸仪，侑公宴嬉。",
        "俾胖而乐，俾艾而耆。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 13150,
      "title": "上许州吕相公嗣崧许康诗二首 许康诗 其五",
      "content": [
        "明明天子，股肱一体。",
        "于蕃于宣，邦人咸喜。",
        "主芣之山，浚{氵冀}之渠。",
        "弗童而材，弗竭而渔。",
        "皇惠斯人，俾公焉依。",
        "公报其成，帝曰还归。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 13151,
      "title": "夜直省舍",
      "content": [
        "省舍诸吏休，前轩成独步。",
        "月色净牟首，星痕隠温树。",
        "稍听班马鸣，犹见昏鸦度。",
        "索居易兴感，幽抱邈谁晤。",
        "自问游落姿，胡撄文墨务。",
        "企欢无剩娱，即事有盈虑。",
        "远寄江海心，冷风傥能御。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 13152,
      "title": "省舍晚景",
      "content": [
        "日稷城阴生，尘露稍云歇。",
        "密树抱烟沈，高禽映天没。",
        "外物既不扰，清机亦徐发。",
        "何意羲皇风，吹我襟袖末。",
        "少驻北堂陲，娟娟待明月。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 13153,
      "title": "正言田学士况书言上庠祭酒厅北轩予所种竹滋茂",
      "content": [
        "昔承上庠乏，莳竹北堂轩。",
        "饬吏勤浸灌，冉冉荣孤根。",
        "日晏到官下，对赏忘尘喧。",
        "海月影宵戺，天风籁晨颠。",
        "去年主人斥，负谤为淮藩。",
        "后来异好尚，欲诿不敢宣。",
        "何幸觏时哲，乃加封殖恩。",
        "千里走书驿，语竹遥相存。",
        "不才好冷局，异日期归旋。",
        "千万屏剪伐，勿令孤愿言。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 13154,
      "title": "仲夏愆雨穉苗告悴辄按先帝诏书绘龙请雨兼祷霍山淮渎二祠戊寅蒇祀己卯获雨谨成喜雨诗呈官属",
      "content": [
        "盛夏挟骄阳，于以搆炎熯。",
        "歊尘坌天盖，烈御煽云汉。",
        "稻颖茁然秀，涸流不胜灌。",
        "田畯恤岁功，释耒共愁叹。",
        "太守忝农使，闭阁重惭惋。",
        "曾是谬政纲，曾是滥囚犴。",
        "一食三失匕，冀亦思过半。",
        "驰祝诉群望，愿以身塞谴。",
        "先帝隠民癠，致和格灵变。",
        "图龙著绘法，令甲布州县。",
        "愚计不知出，奉行安敢慢。",
        "外日筑层坛，丙夜封舒雁。",
        "奉匜再三跪，信辞靡虚荐。",
        "幸勿为龙羞，敢不报神眷。",
        "翼日耿弗寐，徂野视宵奠。",
        "幽血粲静蠲，执事便传赞。",
        "薄诚蒙昭享，距跃私自忭。",
        "回车未及税，云油默焉徧。",
        "穷海遂涔涔，笼山兹漫漫。",
        "旱麓众卉苏，焦原暍氛散。",
        "寸苗蔚如揠，新波鳞欲涣。",
        "何意一溉窘，有望千箱衍。",
        "揆予乏嘉绩，圣诏仰成宪。",
        "恤祀神罔恫，昏作人胥劝。",
        "抒藻拙言词，窃用慰群掾。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 13155,
      "title": "长葛道中作寄侍读梅给事",
      "content": [
        "仲春告言归，道次古长葛。",
        "水穷既舍舟，仆具始脂辖。",
        "南登高原望，天宇莽庨豁。",
        "溱{氵冀}澹无波，芣騩森相轧。",
        "春鸠日夜鸣，阳膏浅深达。",
        "田畯挈壶浆，稚子勤襫袯。",
        "驱牛洒先稑，趣车载输秸。",
        "郊柘色欣欣，梢沟流活活。",
        "县官恩泽美，农节未尝夺。",
        "贤牧谨诏书，民隠罔遗察。",
        "射蠲赘聚劳，赋检诛求猾。",
        "我亦占一廛，闻兹慰饥渴。",
        "矢诗虽不多，要附许风末。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 13156,
      "title": "去郡作",
      "content": [
        "解龟淮阳区，浮鹢暮春月。",
        "州民拥前道，重为使君别。",
        "尊酒却略跪，丝管参差发。",
        "共谓君此行，宠命焕朝节。",
        "进伏丹泥戺，勉之奋芳烈。",
        "使君惭且嗟，处躬素衷拙。",
        "虽尔荷赐环，安敢冀荣辙。",
        "顿首谢上毕，行当避时杰。",
        "愿移邦人爱，孤根保勿伐。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 13157,
      "title": "寿州十咏 熙熙阁",
      "content": [
        "东谯已自高，复此构层宇。",
        "谁谓淮南远，风物美无度。",
        "飞岑纳昼碧，流月遗宵素。",
        "揆予乏仙气，楼居庶可慕。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13158,
      "title": "寿州十咏 白莲堂",
      "content": [
        "堂皇敞而华，簷牙照池水。",
        "钿叶矗新团，玉莩粲繁蘤。",
        "游鳞竟泼泼，幽石仍齿齿。",
        "寄言采秋芳，何必涉江涘。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13159,
      "title": "寿州十咏 春晖亭",
      "content": [
        "涉园憇何处，道左荫华榱。",
        "幽寻乏朋往，胜晤徒自知。",
        "文禽弄不歇，惠风至无期。",
        "含情重徙倚，物色到霞霏。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13160,
      "title": "寿州十咏 式燕亭",
      "content": [
        "使君班春还，于焉衎吾属。",
        "四阿住翚棘，聊以便凉燠。",
        "栋表飞云逝，题端邀月宿。",
        "无德与斯人，式宴良自恧。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13161,
      "title": "寿州十咏 秋香亭",
      "content": [
        "兰菊被秋坂，危宇冠层巅。",
        "杂树自隠日，修条争刺天。",
        "石斜苔附秀，樛穷蔓倒悬。",
        "撷英欲谁遗，伫立徒娟娟。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13162,
      "title": "寿州十咏 狎鸥亭",
      "content": [
        "昔人有机心，鸥鸟舞不下。",
        "太守心异昔，寒灰与时化。",
        "尔既不我猜，余亦无尔诈。",
        "随波以全躯，于兹伴多暇。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13163,
      "title": "寿州十咏 齐云亭",
      "content": [
        "肇允缔层宇，岧岧少城隈。",
        "凭轩肄师孑，中坐合宾罍。",
        "白日披霞上，苍山障雾回。",
        "眷言西北道，吾师安在哉。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13164,
      "title": "寿州十咏 望仙亭",
      "content": [
        "尝闻淮南王，鸡犬从此去。",
        "至今山头石，马迹尚有处。",
        "使臣辞从官，终日绝尘虑。",
        "望望云汉间，想见宾天驭。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13165,
      "title": "寿州十咏 清涟亭",
      "content": [
        "烟筿环曲隄，飞轩俯幽渚。",
        "水容静可鉴，倒见城头树。",
        "青蒲矗尔秀，白鸟瞥然去。",
        "胜晤与时新，遂歌奚能叙。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13166,
      "title": "草木杂咏五首 楠",
      "content": [
        "童童挺十寻，一盖摩空绿。",
        "斜月碍枝回，凉烟附叶宿。",
        "拙斧无妄加，要经匠者目。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 13167,
      "title": "草木杂咏五首 藤",
      "content": [
        "虺蔓相结蟠，虬梢互回屈。",
        "纷若未契绳，繁如已纶綍。",
        "峭格外团阴，尤堪庇炎日。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 13168,
      "title": "草木杂咏五首 橼",
      "content": [
        "绀实纷累累，柔柯缓若若。",
        "叶以代新陈，花仍开续落。",
        "味虽不常御，香能破酲恶。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 13169,
      "title": "草木杂咏五首 海椶",
      "content": [
        "哆炽风叶张，囷皴雨皮厚。",
        "丛橑列盖端，攒旄注旗首。",
        "物以希见珍，材缘怪志丑。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 13170,
      "title": "草木杂咏五首 枇杷",
      "content": [
        "有果产西裔，作花凌蚤寒。",
        "树繁碧玉叶，柯叠黄金丸。",
        "上都不可寄，咀味独长叹。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 13171,
      "title": "塞垣",
      "content": [
        "塞垣八月暮，百卉已凄然。",
        "沙惊瓯脱路，雾暗单于天。",
        "卫霍始开府，辛赵数屯边。",
        "鏖霜奔金戟，攒月驶飞鋋。",
        "雕弧六钧劲，犀札七重穿。",
        "一战薄澣海，再讨穷祁连。",
        "露布报天子，称觞寿万年。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 13172,
      "title": "春集东园诗赋得笋字",
      "content": [
        "茂气遍春逵，结客并游轸。",
        "胜践属园墟，欢言驻驺引。",
        "跼情适野豁，远目向天尽。",
        "林馥树才花，町疏篁未笋。",
        "饮来无留釂，嘲往有余冁。",
        "耳热谢时人，戚戚良可悯。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 13173,
      "title": "七不堪诗七首  其一",
      "content": [
        "一不堪，性嗜日高寝。",
        "叠鼓震余梦，星毛欹倦枕。",
        "冠剑朝已盈，当关视门闯。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 13174,
      "title": "七不堪诗七首  其二",
      "content": [
        "二不堪，草野乐垂钓。",
        "泼泼锦鳞游，泼泼翠竿掉。",
        "夕负槁桐还，行吟面烟徼。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 13175,
      "title": "七不堪诗七首  其三",
      "content": [
        "三不堪，坐痹不得摇。",
        "汤沐乏薰濯，虮虱喜爬搔。",
        "俯惕板在手，回惭绶结腰。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 13176,
      "title": "七不堪诗七首  其四",
      "content": [
        "四不堪，不喜谢书疏。",
        "正无刀笔能，拙作餐饭句。",
        "自勉信非长，愆酬亦逢怒。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 13177,
      "title": "七不堪诗七首  其五",
      "content": [
        "五不堪，未始临丧吊。",
        "倍重秦失号，礼讥老聋笑。",
        "勉顺当世情，为哀损真妙。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 13178,
      "title": "七不堪诗七首  其六",
      "content": [
        "六不堪，不乐俗人共。",
        "聒聒沸蝈集，纷纷臭孥众。",
        "怒迁多市色，礼烦方聚讼。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 13179,
      "title": "七不堪诗七首  其七",
      "content": [
        "七不堪，束绅对文案。",
        "吏若凫鸭趋，文惊朱墨抏。",
        "自襮安所能，深心托萧散。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 13180,
      "title": "库部闵员外还都",
      "content": [
        "望郎东南秀，奯然悟真理。",
        "身虽宰官身，子即诸佛子。",
        "画诺阁铃下，尘虑未尝滓。",
        "成金不复矿，见月讵存指。",
        "东道整朝珂，西亭掺离襼。",
        "无用乐山林，山林即朝市。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 13181,
      "title": "葵",
      "content": [
        "剉蘗染新蘤，插钿成密房。",
        "仙人文玉字，宫女道家妆。",
        "闻说蕊间露，能令肌骨香。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 13182,
      "title": "和登山城望京邑",
      "content": [
        "子牟怀魏阙，陈咸思帝城。",
        "他乡岂不美，吾土乐所生。",
        "况复抚凋节，凭高怀上京。",
        "山川不可见，葱鬰凝神县。",
        "紫气抱关回，玉斗侵城转。",
        "负羽长杨猎，撞钟平乐宴。",
        "高冠照华蝉，英俊皆比肩。",
        "朝奏主父牍，夜召贾生贤。",
        "五侯交荐币，诸公亟为言。",
        "我生流离极，十年悲去国。",
        "叶愿洛阳飞，鱼宁武昌食。",
        "当弃关下符，一对危言策。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 13183,
      "title": "送平陆知县尹象先",
      "content": [
        "之子被尉荐，走马赴关西。",
        "西人待贤相，抚育庶有宜。",
        "羌膻污右鄙，秦陇含创痍。",
        "健将贪屯聚，砦栅犹鳞差。",
        "四年结不解，粮饷先自疲。",
        "兵分势已弱，贼入纵横驰。",
        "营阵讫不立，安得张吾师。",
        "比来守御计，尚复纷相訾。",
        "子今位苦下，何由能奋奇。",
        "悉力字羸瘼，姑守簿书期。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 13184,
      "title": "次陕郊",
      "content": [
        "惊风吹客梦，西落剑南天。",
        "自问何为尔，官牒见婴缠。",
        "遽传非久舍，黎明徒御喧。",
        "俯轮千仞底，仰辔百寻巅。",
        "凭高一以眺，野气正苍然。",
        "崖奔仆僵树，湍躁啼荒泉。",
        "羁禽易去木，奔麕不择阡。",
        "抚物重增叹，去邦邈以绵。",
        "何为久行役，坐使欢心捐。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 13185,
      "title": "提刑使者还嘉州",
      "content": [
        "使者舣行舟，是行及凄序。",
        "祖帐俯平沙，从骑罗前渚。",
        "一进酒惟醴，再进鲂及𫚈。",
        "远客已少悰，况将暌宴语。",
        "劲风自薄林，寒流稍分浦。",
        "讼矢久已闲，农坻矧就绪。",
        "岁晏亟言旋，无为负延伫。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 13186,
      "title": "提刑劝农使者还嘉州",
      "content": [
        "案部聊北征，肃舲复东下。",
        "江溜澹泱泱，樯乌纷雅雅。",
        "离醑不余杯，征棹亟沿洄。",
        "远岫随时见，幽花无候开。",
        "清氛霁平陆，林艿信重复。",
        "僰路缭山颜，駹田耨岩腹。",
        "属此屡丰期，仍当省敛时。",
        "击壤系途乐，余粮寻亩栖。",
        "嘉阳信嘉处，时与赏心遇。",
        "霁树抱空轮，寒涛下翔鹭。",
        "还辕眷仲秋，秋序日方遒。",
        "归诺果无负，迟子临江楼。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 13187,
      "title": "杂咏三首  其一",
      "content": [
        "有客款我庐，念我衰暮齿。",
        "自言上真书，有药名不死。",
        "黄金乃能化，白发安足治。",
        "谓我刀圭余，已足度年纪。",
        "驱还扶桑面，黄昏付蒙泛。",
        "主人诡谢客，吾生本尘滓。",
        "少来诵诗书，不识怪神理。",
        "惊闻河汉言，浩然弗知涘。",
        "今也病未能，异日从吾子。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 13188,
      "title": "杂咏三首  其二",
      "content": [
        "金炉焚蕙荃，香播蕙已灰。",
        "郁馥诚可贵，无乃为蕙灾。",
        "上瓦编翠烟，下础挺沈质。",
        "所用不必同，相济成宫室。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13189,
      "title": "杂咏三首  其三",
      "content": [
        "乐羊振归旅，光艳充国都。",
        "矜心激盛气，奋若长虹舒。",
        "君王劳军罢，为出一箧书。",
        "避席再拜跪，功非臣所图。",
        "不待一盈箧，寸书已有余。",
        "成功在主君，斯语不可诬。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 13190,
      "title": "玉玫瑰",
      "content": [
        "瑶楮镂空蒙，冰纨卷重叠。",
        "寒光欲冲斗，回秀难藏叶。",
        "谁碎辟邪香，氤氲飞作蝶。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 13191,
      "title": "刘伯诚见惠仆所作中山杂咏石刻",
      "content": [
        "衣冠昔奔波，晋社亦中徙。",
        "水府拥宫阙，六姓传剑玺。",
        "名卿入理窟，黔首多兵死。",
        "真人刬墉障，六合如平砥。",
        "三山屹不化，城郭无形似。",
        "冥冥桑麻村，残锋出耘耔。",
        "前朝绝遗老，故事稽野史。",
        "我顷为中山，蠲租案田水。",
        "刳木枕波涛，礲刀伐荆杞。",
        "丛祠及荒垅，幽处无不履。",
        "车停客登席，酒尽诗在纸。",
        "游深造遐邃，语苦出奇诡。",
        "投囊凡几时，蓬尘失料理。",
        "刘侯见之笑，谓此那可毁。",
        "濡毫请挥洒，买石亲镌纪。",
        "嗟予政理疏，无德行嵔垒。",
        "编民愿尸祝，有愧庚桑子。",
        "惟兹楚客谣，可以传下里。",
        "何时见椎击，断仆清江尾。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 13192,
      "title": "写怀寄献枢密太尉",
      "content": [
        "仆本草茅人，守植自有素。",
        "偶与力运偕，牵丝及荣路。",
        "矢将保独行，安敢邀诡遇。",
        "朝跻绿雾阁，夕舍金马署。",
        "鷃志屈鸿翼，珉质谢瑶圃。",
        "内省实空虚，焉得久留处。",
        "悟非不必老，斑领况云屡。",
        "竟获一麾来，果此避贤趣。",
        "载以朱轓车，佩以银符兔。",
        "君宠寄华冕，癯丑不成恶。",
        "淮郡梁楚交，刀笔纷民务。",
        "粗欲逃官责，何暇收民誉。",
        "平生觏宗工，亟为拯沦误。",
        "惭负知己言，遂贻越乡虑。",
        "何图霄与泥，肯问簪与屦。",
        "辛勤风波事，尺牍奚能诉。",
        "代马愁南嘶，鹧鸪憎北翥。",
        "所恋明主恩，未理归田驭。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 13193,
      "title": "琼花",
      "content": [
        "唐昌观中树，曾降九天人。",
        "銮驾久何许，雪英如旧春。",
        "岂无遗佩者，来效捧心颦。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 13194,
      "title": "抒怀上孙侍讲学士",
      "content": [
        "仆本寒乡士，始愿托田陇。",
        "偶与亨会并，遂窃空名宠。",
        "黉胄信清闲，文书无倥偬。",
        "牵丝玷外举，挟册陪春诵。",
        "缥帙芸叶香，清池璧流壅。",
        "虽均五能知，犹冀三陌踊。",
        "有志慕孤直，多言畏奇中。",
        "往往犯怒狙，时时遭吓凤。",
        "胁肩方病畦，洗足几成湩。",
        "言充卫士爨，赋盖吴人瓮。",
        "但望不汝瑕，安能贾予勇。",
        "丛云属帝辰，烝油乐贤共。",
        "前追三代风，旁鼓天下动。",
        "方正召华郤，贤良命晁董。",
        "务擢平津对，无罪贾生恸。",
        "裒然群俊来，灿若春葩纵。",
        "咨予苦涩讷，望风犹阴拱。",
        "愁多目似蒿，疾久带移孔。",
        "直虑醒而狂，遂同微且尰。",
        "三千御上方，八九吞云梦。",
        "订正清庙诗，白罢旅獒贡。",
        "夫宁本无志，良忧拙于用。",
        "击辕固歌鄙，殙金诚外重。",
        "中夕抚躬叹，明恩愧孤奉。",
        "况复年苒苒，坐惊头种种。",
        "闲居昔有潘，广宅今非仲。",
        "尘容化衣𫋻，雨气昏刀䩬。",
        "所頼庇明哲，盱衡顾闲冗。",
        "每辨骥垂耳，力排儒发冢。",
        "不尔谢病归，鉏钓事江葑。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 13195,
      "title": "溪上",
      "content": [
        "溪上玩秋水，使人意自清。",
        "烈烈回飚余，鳞鳞夕浪生。",
        "有鱼可垂饵，有蒲可芼羹。",
        "况值新酒熟，鲑菜辛咸并。",
        "兴来命一樽，樽至壶自倾。",
        "便值人间虑，浩然沧海情。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 13196,
      "title": "送行",
      "content": [
        "秋日苦凄凄，味若虀臼辛。",
        "如何多感地，更送将归人。",
        "高盖浮清旭，长缨缚素尘。",
        "惨色动车仆，离言发坐宾。",
        "霜珂响征马，星脂滑行轮。",
        "契阔何所道，良饭自宠珍。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 13197,
      "title": "晓栉",
      "content": [
        "晓栉理斑鬓，萧萧徧愁颠。",
        "多病始计日，蚤衰不待年。",
        "青青固未几，种种今乃然。",
        "寡发有巽象，施髲惭庄篇。",
        "且复委蓬葆，言就东山眠。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 13198,
      "title": "筠亭",
      "content": [
        "山阿彼有人，葺宇映修竹。",
        "露箨新旧斑，风梢动摇绿。",
        "此君自虚心，主公今实腹。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 13199,
      "title": "送屯田张员外",
      "content": [
        "飞霜逐凋节，岁籥忽已阑。",
        "奈何送归客，置酒长江干。",
        "十载始一遇，别易会故难。",
        "此地嗟素领，昔日皆朱颜。",
        "讵意前欢余，更为后感端。",
        "行舟望不见，留骖相与还。",
        "芳讯幸无保，时付凌风翰。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 13200,
      "title": "古意",
      "content": [
        "薄宦若秋蔕，飘然去林枝。",
        "盲风不我爱，吹堕清淮湄。",
        "淮南苦憀栗，九月繁霜飞。",
        "晚蕙相为叹，崇兰偕此衰。",
        "凋落虽云苦，芬香终不移。",
        "但愿阳春动，要当三秀期。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 13201,
      "title": "秋气",
      "content": [
        "清浊还二仪，秋气飒然肃。",
        "溪洁潦已残，林疏条自矗。",
        "寒蛩思长阶，归燕眷华屋。",
        "凋年自兹始，乡怀念松菊。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13202,
      "title": "感旧送虞曹杨员外",
      "content": [
        "曩笑长者言，感恨岁时遽。",
        "不云笑未几，倐已及衰路。",
        "却怀眼中人，落落星向曙。",
        "宁无新相知，论新不如故。",
        "夫子惠然至，适慰离群慕。",
        "缔交三十载，契阔不同处。",
        "丑老向来妍，鬓黑今也素。",
        "伐木喜求旧，谷风念将惧。",
        "我顾滥荣班，君乃叹奇数。",
        "根柢假容进，缠牵以长误。",
        "久领一麾行，江湖极沿溯。",
        "杯酒曾未款，仆夫告方具。",
        "前乐暂还衿，后戚已盈虑。",
        "丈夫固有志，膂力经世务。",
        "何必常相从，卑若堂下屦。",
        "岁满亟来旋，中朝著翔步。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 13203,
      "title": "拟杜工部九成宫",
      "content": [
        "云山鬰嵯峨，宫户莽𫐖轕。",
        "摧峰隠驰道，镵岫启绣闼。",
        "游鹍邈飞鬭，阳马恣陵突。",
        "危淙注铜池，翠潋潄崖骨。",
        "落虹拖晨轩，奔蟾守夜窟。",
        "凭高眺鸿洞，念古一超忽。",
        "咄嗟有隋后，缔构穷剞劂。",
        "徒矜昔日工，乃忘后世拙。",
        "居为唐家保，功业何汩汩。",
        "牛酒望幸民，岩廊卫守卒。",
        "残松抱空偃，卧杨委新伐。",
        "千载徧荒愁，金铺锁崷崒。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 13204,
      "title": "望仙亭",
      "content": [
        "淮山相蝉联，万景归宇下。",
        "来波澹天末，归雾灭岩罅。",
        "凄凄草色繁，肃肃桂丛亚。",
        "吾人愧攸馆，僊属冀来舍。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13205,
      "title": "湖山",
      "content": [
        "一水抱天回，千岩互相映。",
        "寒湖囓沙痕，狂峰贯霞景。",
        "持此写琴心，宁无子期听。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 13206,
      "title": "劝酒",
      "content": [
        "酌酒奉君寿，劝君慎勿辞。",
        "只今举酒罢，已异行觞时。",
        "波澜前后来，日月分寸推。",
        "稚容不耐久，缟领无停缁。",
        "独醒信劳人，兹事定何悲。",
        "假令古无死，昼夜常倭迟。",
        "正恐爽鸠乐，后人非所希。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 13207,
      "title": "种竹",
      "content": [
        "世皆笑幽独，可不少自贬。",
        "种竹南轩间，亦足以相验。",
        "况兹岁华晚，众卉日凋敛。",
        "清节良自如，栽培匪为谄。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13208,
      "title": "凉蟾",
      "content": [
        "凉蟾囓残云，飞影上西庑。",
        "鹊鸦依空墙，蟏蛸已在户。",
        "君行阅三岁，确战亦云苦。",
        "新衣本自绽，故裳复谁补。",
        "朔风万里来，傥或从君所。",
        "风过无传音，徘徊独谁语。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 13209,
      "title": "杨秘校秋怀  其一",
      "content": [
        "上天分四序，素秋独可悲。",
        "商风劲危条，寒露鲜繁蕤。",
        "依依燕去巢，嘒嘒蝉抱枝。",
        "抚物喟然叹，流光忽已驰。",
        "危衿恧新壮，华领移故缁。",
        "愿君策高足，无后功名时。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 13210,
      "title": "杨秘校秋怀  其二",
      "content": [
        "凉风飒雕年，遥昔耿多虑。",
        "冽冽寒螀鸣，离离客鸿度。",
        "之子怀茂器，有志康庶务。",
        "未蒙徐乐召，方感董生遇。",
        "道局骏愿违，弦𫄠危响赴。",
        "此际怊怅情，偕之岁云暮。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 13211,
      "title": "杨秘校秋怀  其三",
      "content": [
        "治畹当树兰，治林当植桂。",
        "兰生可香国，桂茂绝藂荟。",
        "邈哉志士节，所趣与人异。",
        "意经千古上，心包九垠际。",
        "道胜外物轻，矧复缰锁细。",
        "所以抢榆者，局局笑鹏翅。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 13212,
      "title": "真珠龙柏",
      "content": [
        "彼美夜光喻，益之新甫名。",
        "累累云际艳，皎皎月中英。",
        "勿诮素为绚，相期隆德声。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 13213,
      "title": "度飞石岭",
      "content": [
        "人不怨飘瓦，何用罪飞石。",
        "石坠不可常，人值亦其适。",
        "去去走嵚崟，千金幸自惜。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 13214,
      "title": "拟王右丞瓜园",
      "content": [
        "荷锄往瓜田，烟蔓纷广畴。",
        "植杖未及憇，有客眷林丘。",
        "驺哄罗户前，冠盖荫道周。",
        "进客北堂上，借以氍毹柔。",
        "持杯再三跪，酌我清白酧。",
        "时时高兴酣，矫首望神州。",
        "长衢贯广陌，反宇注飞楼。",
        "惠风林间翔，早晖花上浮。",
        "新叶向蒙密，鷇雏已啁啾。",
        "时哉物可玩，况复忘吾忧。",
        "故人心傥尔，驾言时见求。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 13215,
      "title": "寄题宫师相公宴息园",
      "content": [
        "相公纳衡枢，卜筑来东里。",
        "恤他匪足尚，自适乃云美。",
        "中园兴夷爽，薄言谢朝市。",
        "壤石非远迁，松竹皆故莳。",
        "绛蘤谢游轩，素波鸣禊戺。",
        "遐苍眺京隩，侧缥抱嵩趾。",
        "畦塍互演漾，灌薄纷靃靡。",
        "崒崒相向山，溅溅自流水。",
        "高云靡还期，冥鸿无慕理。",
        "公时挟胜想，朅来遵逸轨。",
        "逢觞即陶然，坐树亦欣止。",
        "冲情舍天倪，妙歌怯物类。",
        "挥金屡空镒，爱客辄留屣。",
        "式俾卫公寿，弗取安石侈。",
        "有守卧淮壖，聆风竦予企。",
        "他日果西归，角巾望松梓。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 13216,
      "title": "小渠",
      "content": [
        "唐溪析春溜，一股入清渠。",
        "循庭始演漾，走圃辄萦纡。",
        "淙淙潄幽石，唯唯泳纤鱼。",
        "瀑来聊激浊，澄罢复涵虚。",
        "恃源才自润，流波愧挹余。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 13217,
      "title": "晓过二里山",
      "content": [
        "黎明走苍山，千仞势如削。",
        "北斗挂西巅，徘徊久未落。",
        "驿道转岩肩，人烟聚岑脚。",
        "太虚交昏旦，颢气自喷薄。",
        "阳光排暗升，阴氛值明郤。",
        "翔禽散乔枿，啼狖思空壑。",
        "逢隈雾尚屯，投险泉争跃。",
        "生平好山意，每遭事婴缚。",
        "安得乘冷风，穷跻叩寥廓。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 13218,
      "title": "思贤阁图予真愧而成咏",
      "content": [
        "忝中二千石，罢去辄图真。",
        "揆予本完士，蚤蒙善养仁。",
        "执笏班华位，飞绥侍邃宸。",
        "如何金紫服，乃裹丘壑身。",
        "西南一面重，朅来驾朱轮。",
        "牵拙岁再期，初无德在民。",
        "形象安足纪，崖略聊自陈。",
        "质陋眸子瞭，志泰眉宇伸。",
        "谁谓彼其子，而传阿堵神。",
        "爵里三十八，赫赫多名臣。",
        "瞻前谢前哲，垂后惭后人。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 13219,
      "title": "九日药市作",
      "content": [
        "阳九协嘉辰，斯人始多暇。",
        "五药会广廛，游肩闹相驾。",
        "灵品罗贾区，仙芬冒闉舍。",
        "撷露来山阿，𣃁烟去岩罅。",
        "载道杂提携，盈簷更荐藉。",
        "乘时物无贱，投乏利能射。",
        "饔苓互作主，参荠交相假。",
        "曹植谨赝令，韩康无二价。",
        "西南岁多疠，卑湿连春夏。",
        "佳剂止刀圭，千金厚相谢。",
        "刺史主求瘼，万室系吾化。",
        "顾頼药石功，扪襟重惭唶。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 13220,
      "title": "迎春曲三阕  其一",
      "content": [
        "青陆斗杓回，河内动新灰。",
        "冰际绡纹绽，云边鹤影来。",
        "汉宫行庆罢，花树剪刀催。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 13221,
      "title": "迎春曲三阕  其二",
      "content": [
        "东郊风驭软，严署漏筹添。",
        "柳拂将军壁，梅飘公主奁。",
        "舞衣裁几许，新人解织缣。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 13222,
      "title": "迎春曲三阕  其三",
      "content": [
        "荔达阳膏动，冰解水纹融。",
        "天花四面碧，日气几竿红。",
        "不言双燕晚，为叹玉箱空。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 13223,
      "title": "散关",
      "content": [
        "磴道何盘盘，百步人一憩。",
        "弭节高山颠，关存不置吏。",
        "昔缘暴客须，今为有道废。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 13224,
      "title": "和成上人",
      "content": [
        "西山有尊者，秀出于稻麻。",
        "徧参居第一，诸佛素所嗟。",
        "锡声来赤县，被祴垂青霞。",
        "流出一切妙，普见大千沙。",
        "我法果无在，昧者兹有涯。",
        "是凡方是圣，归正即归邪。",
        "妄怀万缘息，举意千里差。",
        "有客谢病免，清辞春月赊。",
        "静眠金粟室，厌坐马融纱。",
        "观化哂罨勒，自呼嗤镆铘。",
        "瞻言世外友，相期心不遐。",
        "挥斤郢匠室，流水子期家。",
        "披云示驶月，拂果去空花。",
        "师叹未曾有，君对无以加。",
        "清襟互默遣，所得非齿牙。",
        "层阴朋盍阻，坐久丹霏斜。",
        "涵毫泚仙滴，抒藻扬晨葩。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 13225,
      "title": "水文叠石",
      "content": [
        "晓波清苍痕，豗激翠将腐。",
        "奔涛已东决，磊块留不去。",
        "巧匠取之出，入资园亭趣。",
        "阴罅囓余苔，寒凹逗轻露。",
        "彼怪予弗谈，不转吾所慕。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 13226,
      "title": "远行",
      "content": [
        "楚人巧悲秋，分作四种戚。",
        "最极有远行，百感攒羁臆。",
        "林鸟戢和哢，屯云献惨色。",
        "客久归念长，年惊壮图窄。",
        "抚物盈近叹，驱騑拥遥恻。",
        "晓斗亦告劳，垂杓卧楼北。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 13227,
      "title": "早秋有感",
      "content": [
        "一叶飞足惊，要是变衰始。",
        "毛泽自兹竭，多露方夜委。",
        "凉蜩抱空号，腐燐变幽煅。",
        "怊然感物化，须发不常美。",
        "羲和鞭白日，已复向蒙泛。",
        "功名未及见，轩冕胡足恃。",
        "坐客悯予忧，粲然启玉齿。",
        "辍嗟谢诸郎，长年行自尔。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 13228,
      "title": "䜩集",
      "content": [
        "素节倐已宴，高风送浮凉。",
        "拂席进宾客，酾酒罗壶觞。",
        "黄鸡跖跖美，紫蟹螯螯香。",
        "莫矜来欢早，须念后戚长。",
        "奔川无缓澜，徂日不还光。",
        "愿客且安坐，调弦未遽央。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 13229,
      "title": "水月",
      "content": [
        "渺渺溯云波，盈盈柅霜驭。",
        "碎璧拥舟来，流金映沙聚。",
        "夜寂波已休，何人荐真趣。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 13230,
      "title": "和君贶学士宿淮上见寄",
      "content": [
        "使舲既邅回，淮溜剧沿溯。",
        "我行非不远，君节自前路。",
        "烟汰历濠汭，雾氛逗荆树。",
        "感此言迈情，慰予索居慕。",
        "曰归归未辰，惨别别已屡。",
        "努力保素衿，天途迟还翥。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 13231,
      "title": "钤辖冒上合就移知雄州",
      "content": [
        "聚散非一端，贤逸难两遂。",
        "拥节北临边，安得久交臂。",
        "此行讵不远，印瑞三且二。",
        "背剑车炙輠，径秦骖舞辔。",
        "雄州乃剧藩，喉领塞南地。",
        "译通老上庭，道系单于使。",
        "适馆授主粲，乘韦交客贽。",
        "列戍俨趋风，诸将走咨事。",
        "应变君所长，立功今可冀。",
        "君家诚易知，世烈在青史。",
        "齐楚异姓王，阴邓后家里。",
        "券字金对行，戟带霞交尾。",
        "濬源无近波，高峰本洪址。",
        "行矣励壮猷，公侯当复始。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 13232,
      "title": "常山杨氏有二怪石奇险百状田曹张中行家雒阳徧见都中诸家所得异石皆出此下予他日思之恐常人忽而不珍作诗以诧其处并邀中行伯逢同赋",
      "content": [
        "块然两奇石，谲怪状难悉。",
        "千仞裂嵯峨，一气与崷崒。",
        "四隅藓剥肤，万古云渍骨。",
        "补余天所委，陨罢星不没。",
        "横苍对偃蹇，怒翠竞腾突。",
        "神媪秘弗露，狂鼇抃而失。",
        "由兹落人宇，得用玩奇质。",
        "屹如不可转，挺若无所屈。",
        "鬭虎攫余痕，乖龙卧残窟。",
        "撑掉壮士槊，奋立直臣笏。",
        "危顶烟夭矫，窄窦雷鬰律。",
        "涛头缩不长，魖臂愤相捽。",
        "变现载灵牒，呵护费神物。",
        "穷陬苦陋庳，珍碧恐湮汩。",
        "各保坚䃭姿，以待封山日。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 13233,
      "title": "反骚",
      "content": [
        "我闻上天乐，仙圣并游宾。",
        "离楚何所据，招回逐客魂。",
        "谓门有九关，虎豹代守阍。",
        "砥舌饥涎流，触之辄害人。",
        "讥呵自有常，帝意宁不仁。",
        "穷壤苦恨隔，传闻恐失真。",
        "我欲稽首问，无梯倚青云。",
        "块然守下土，此愤何由伸。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 13234,
      "title": "怀三封墅  其一",
      "content": [
        "寡求愿易足，久计还中林。",
        "君恩容有报，宿留未抽簪。",
        "浅谋乏经济，流景倏颓侵。",
        "企翰羡鸿翥，俯泳愧鱼沈。",
        "荣名非不勉，高坻良可歆。",
        "奈何贾生恸，又将庄舄吟。",
        "投沙乃闻古，怀春方在今。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 13235,
      "title": "怀三封墅  其二",
      "content": [
        "三封何所怀，怀我东南亩。",
        "方春原田秀，是时簦笠聚。",
        "杏花灿晴落，菖叶甲阴浦。",
        "泱泱云抱岑，眇眇林鸣扈。",
        "野老携晨馌，薄醪间炊黍。",
        "安知五熟滋，但慰四友苦。",
        "日作夕还家，烟火青林下。",
        "嗟我仕易稼，穷年宦三辅。",
        "誓毕尚生累，将从平子赋。",
        "自省非大人，请事学农圃。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 13236,
      "title": "风雨",
      "content": [
        "昨夜东风急，疏窗荐雨入。",
        "溪南梅正花，狼藉随尘沙。",
        "皓皓多易汗，不得同春葩。",
        "春葩能有几，纷纷入桃李。",
        "时哉小兴衰，人生犹物理。",
        "明发簷沈声，鸟雀喧新晴。",
        "老农脱袯冲，一犁原上耕。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 13237,
      "title": "秋兴",
      "content": [
        "西颢肃凉氛，天宇正岑寂。",
        "凄风条末吟，浩露林下滴。",
        "寥寥燕辞楹，促促蛩在壁。",
        "池潦湛寒绿，鳞云屯晚白。",
        "齐纨不复御，桃笙已复易。",
        "嗟哉无壮士，翻车忽西匿。",
        "有客过我庐，问我何凄恻。",
        "气索不能对，披襟长太息。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 13238,
      "title": "金雀花",
      "content": [
        "叠叶倚风绽，翩翾凌雾排。",
        "齐名仙母使，写样汉宫钗。",
        "俗眼未应妬，勿忧珠弹来。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 13239,
      "title": "浮屠",
      "content": [
        "乞食古为耻，浮屠名自修。",
        "黎明抱应器，禺中饫干糇。",
        "果腹固其愿，之墦非所羞。",
        "歉歉常不足，遑遑兹有求。",
        "素饱聊安坐，调饥复来游。",
        "顾尔殊灵辄，翳桑何用酬。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    }
  ],
