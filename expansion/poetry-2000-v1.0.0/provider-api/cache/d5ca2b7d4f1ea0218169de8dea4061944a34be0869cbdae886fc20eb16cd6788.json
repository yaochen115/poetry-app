{
  "data": [
    {
      "id": 267349,
      "title": "送淡公 二",
      "content": [
        "坐爱青草上，意含沧海滨。",
        "渺渺独见水，悠悠不问人。",
        "镜浪洗手绿，剡花入心春。",
        "虽然防外触，无奈饶衣新。",
        "行当译文字，慰此吟殷勤。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267350,
      "title": "送淡公 三",
      "content": [
        "铜斗饮江酒，手拍铜斗歌。",
        "侬是拍浪儿，饮则拜浪婆。",
        "脚踏小船头，独速舞短蓑。",
        "笑伊渔阳操，空恃文章多。",
        "闲倚青竹竿，白日奈我何。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267351,
      "title": "送淡公 四",
      "content": [
        "短蓑不怕雨，白鹭相争飞。",
        "短楫画菰蒲，鬬作豪横归。",
        "笑伊水健儿，浪战求光辉。",
        "不如竹枝弓，射鸭无是非。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267352,
      "title": "送淡公 五",
      "content": [
        "射鸭复射鸭，鸭惊菰蒲头。",
        "鸳鸯亦零落，彩色难相求。",
        "侬是清浪儿，每踏清浪游。",
        "笑伊乡贡郎，踏土称风流。",
        "如何丱角翁，至死不裹头。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267353,
      "title": "送淡公 六",
      "content": [
        "师得天文章，所以相知怀。",
        "数年伊雒同，一旦江湖乖。",
        "江湖有故庄，小女啼喈喈。",
        "我忧未相识，乳养难和谐。",
        "幸以片佛衣，诱之令看斋。",
        "斋中百福言，催促西归来。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267354,
      "title": "送淡公 七",
      "content": [
        "伊洛气味薄，江湖文章多。",
        "坐缘江湖岸，意识鲜明波。",
        "铜斗短蓑行，新章其奈何。",
        "兹焉激切句，非是等闲歌。",
        "制之附驿回，勿使余风讹。",
        "都城第一寺，昭成屹嵯峨。",
        "为师书广壁，仰咏时经过。",
        "徘徊相思心，老泪双滂沱。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267355,
      "title": "送淡公 八",
      "content": [
        "江南邑中寺，平地生胜山。",
        "开元吴语僧，律韵高且闲。",
        "妙药溪岸平，桂榜往复还。",
        "树石相鬬生，红绿各异颜。",
        "风味我遥忆，新奇师独攀。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267356,
      "title": "送淡公 九",
      "content": [
        "报恩兼报德，寺与山争鲜。",
        "橙橘金盖槛，竹蕉绿凝禅。",
        "经章音韵细，风磬清泠翩。",
        "离肠绕师足，旧忆随路延。",
        "不知几千尺，至死方绵绵。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267357,
      "title": "送淡公 十",
      "content": [
        "乡在越镜中，分明见归心。",
        "镜芳步步绿，镜水日日深。",
        "异刹碧天上，古香清桂岑。",
        "朗约徒在昔，章句忽盈今。",
        "幸因西飞叶，书作东风吟。",
        "落我病枕上，慰此浮恨侵。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267358,
      "title": "送淡公 十一",
      "content": [
        "牵师袈裟别，师断袈裟归。",
        "问师何苦去，感吃言语稀。",
        "意恐被诗饿，欲住将底依。",
        "卢殷刘言史，饿死君已噫。",
        "不忍见别君，哭君他是非。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267359,
      "title": "送淡公 十二",
      "content": [
        "诗人苦为诗，不如脱空飞。",
        "一生空鷕气，非谏复非讥。",
        "脱枯挂寒枝，弃如一唾微。",
        "一步一步乞，半片半片衣。",
        "倚诗为活计，从古多无肥。",
        "诗饥老不怨，劳师泪霏霏。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267360,
      "title": "送魏端公入朝",
      "content": [
        "东洛尚淹翫，西京足芳妍。",
        "大宾威仪肃，上客冠劒鲜。",
        "岂惟空恋阙，亦以将朝天。",
        "局促尘末吏，幽老病中弦。",
        "徒怀青云价，忽至白发年。",
        "何当补风教，为荐三百篇。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267361,
      "title": "送卢郎中汀",
      "content": [
        "洛水春渡阔，别离心悠悠。",
        "一生空吟诗，不觉成白头。",
        "向事每计较，与山实绸缪。",
        "太华天上开，其下车辙流。",
        "县街无尘土，过客多淹留。",
        "坐饮孤驿酒，行思独山游。",
        "逸关岚气明，照渭空漪浮。",
        "玉珂摆新欢，声与鸾凤俦。",
        "朝谒大家事，唯余去无由。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267362,
      "title": "送郑仆射出节山南",
      "content": [
        "国老出为将，红旗入青山。",
        "再招门下生，结束余病孱。",
        "自笑骑马丑，强从驱驰间。",
        "顾顾磨天路，褭褭镜下颜。",
        "文魄既飞越，宦情唯等闲。",
        "羡他白面少，多是清朝班。",
        "惜命非所报，慎行诚独艰。",
        "悠悠去住心，两说何能删。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267363,
      "title": "别妻家",
      "content": [
        "芙蓉湿晓露，秋别南浦中。",
        "鸳鸯卷新赠，遥恋东床空。",
        "碧水不息浪，清溪易生风。",
        "参差坐成阻，飘飖去无穷。",
        "孤云目虽断，明月心相通。",
        "私情讵销铄，积芳在春藂。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267364,
      "title": "赠姚怤别",
      "content": [
        "美人废琴瑟，不是无巧弹。",
        "闻君郢中唱，始觉知音难。",
        "惊蓬无还根，驰水多分澜。",
        "倦客厌出门，疲马思解鞍。",
        "何以写此心，赠君握中丹。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267365,
      "title": "赠竟陵卢使君虔别",
      "content": [
        "赤日千里火，火中行子心。",
        "孰不苦焦灼，所行为贫侵。",
        "山木岂无凉，猛兽蹲清阴。",
        "归人忆平坦，别路多岖嵚。",
        "赖得竟陵守，时闻建安吟。",
        "赠别折楚芳，楚芳摇衣襟。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267366,
      "title": "与韩愈李翺张籍话别",
      "content": [
        "朱弦奏离别，华灯少光辉。",
        "物色岂有异，人心顾将违。",
        "客程殊未已，岁华忽然微。",
        "秋桐故叶下，寒露新雁飞。",
        "远游起重恨，送人念先归。",
        "夜集类饥鸟，晨光失相依。",
        "马迹遶川水，雁书还闺闱。",
        "常恐亲朋阻，独行知虑非。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267367,
      "title": "监察十五叔东斋招李益端公会别",
      "content": [
        "欲知惜别情，泻水还清池。",
        "此地有君子，芳兰步葳蕤。",
        "手掇杂英珮，意摇春夜思。",
        "莫作遶山云，循环无定期。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267368,
      "title": "汴州留别韩愈",
      "content": [
        "不饮浊水澜，空滞此汴河。",
        "坐见遶岸水，尽为还海波。",
        "四时不在家，弊服断线多。",
        "远客独顦顇，春英落婆娑。",
        "汴水饶曲流，野桑无直柯。",
        "但为君子心，叹息终靡他。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267369,
      "title": "赠别殷山人说易后归幽墅",
      "content": [
        "夫子说天地，若与灵龟言。",
        "幽幽人不知，一一予所敦。",
        "秋月吐白夜，凉风韵清源。",
        "旁通忽已远，神感寂不喧。",
        "一悟祛万结，夕怀倾朝烦。",
        "旅辀无停波，别马嘶去辕。",
        "殷勤荒草士，会有知己论。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267370,
      "title": "寿安西渡奉别郑相公 一",
      "content": [
        "洛河向西道，石波横磷磷。",
        "清风送君子，车远无还尘。",
        "春别亦萧索，况兹冰霜晨。",
        "零落景易入，郁抑抱难申。",
        "百宵华灯宴，一旦星散人。",
        "岁去弦吐箭，忧来蚕抽纶。",
        "绵绵无穷事，各各驰遶身。",
        "徘徊黄缥缈，倏忽春霜宾。",
        "相为物表物，永谢区中姻。",
        "日嗟来教士，仰望无由亲。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267371,
      "title": "寿安西渡奉别郑相公 二",
      "content": [
        "东都清风减，君子西归朝。",
        "独抱岁晏恨，泗吟不成谣。",
        "贵游意多味，贱别情易消。",
        "回鴈忆前叫，浪凫念后漂。",
        "悠悠孤飞景，耸耸衔霜条。",
        "昧趣多滞涩，嬾朋寡新僚。",
        "病深理方悟，悔至心自烧。",
        "寂静道何在，忧勤学空饶。",
        "乃知减闻见，始遂情逍遥。",
        "文字徒营织，声华谅疑骄。",
        "顾慙耕稼士，朴略气韵调。",
        "善士有余食，佳畦冬生苗。",
        "养人在养身，此旨清如韶。",
        "愿贡高古言，敢望锡类招。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267372,
      "title": "宇文秀才斋中海柳咏",
      "content": [
        "玉缕青葳蕤，结为芳树姿。",
        "忽惊明月钩，钩出珊瑚枝。",
        "灼灼不死花，蒙蒙长生丝。",
        "饮栢泛仙味，咏兰拟古词。",
        "霜风清飕飕，与君长相思。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267373,
      "title": "摇柳",
      "content": [
        "弱弱本易惊，看看势难定。",
        "因风似醉舞，尽日不能正。",
        "时邀咏花女，笑辍春妆镜。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267374,
      "title": "晓鹤",
      "content": [
        "晓鹤弹古舌，婆罗门叫音。",
        "应吹天上律，不使尘中寻。",
        "虚空梦皆断，歆唏安能禁。",
        "如开孤月口，似说明星心。",
        "既非人间韵，枉作人间禽。",
        "不如相将去，碧落窠巢深。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267375,
      "title": "和蔷薇花歌",
      "content": [
        "仙机札札织凤皇，花开七十有二行。",
        "天霞落地攒红光，风枝袅袅时一飏。",
        "飞散葩馥遶空王，忽惊锦浪洗新色。",
        "又似宫娃逞妆饰，终当一使移花根，还比蒲桃天上植。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267376,
      "title": "邀人赏蔷薇",
      "content": [
        "蜀色庶可比，楚丛亦应无。",
        "醉红不自力，狂艳如索扶。",
        "丽蘂惜未埽，宛枝长更纡。",
        "何人是花侯，诗老强相呼。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267377,
      "title": "和宣州钱判官使院厅前石楠树",
      "content": [
        "大朴既一剖，众材争万殊。",
        "懿兹南海华，来与北壤俱。",
        "生长如自惜，雪霜无凋渝。",
        "笼笼抱灵秀，簇簇抽芳肤。",
        "寒日吐丹艳，頳子流细珠。",
        "鸳鸯花数重，翡翠叶四铺。",
        "雨洗新妆色，一枝如一姝。",
        "耸异敷庭际，倾妍来坐隅。",
        "散彩饰机案，余辉盈盘盂。",
        "高意因造化，常情逐荣枯。",
        "主公方寸中，陶植在须臾。",
        "养此奉君子，赏觌日为娱。",
        "始觉石楠咏，价倾赋两都。",
        "棠颂庶可比，桂词难以逾。",
        "因谢丘墟木，空采落泥涂。",
        "时来开佳姿，道去卧枯株。",
        "争芳无由缘，受气如郁纡。",
        "抽肝在郢匠，叹息何踟蹰。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267378,
      "title": "酬郑毗踯躅咏",
      "content": [
        "不似人手致，岂关地势偏。",
        "孤光褭余翠，独影舞多妍。",
        "迸火烧闲地，红星堕青天。",
        "忽惊物表物，嘉客为留连。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267379,
      "title": "品松",
      "content": [
        "追悲谢灵运，不得殊常封。",
        "纵然孔与颜，亦莫及此松。",
        "此松天格高，耸异千万重。",
        "抓拏巨灵手，擘裂少室峰。",
        "擘裂风雨狞，抓拏指爪𦟛。",
        "道入难抱心，学生易堕踪。",
        "时时数点仙，袅袅一线龙。",
        "霏微岚浪际，游戏颢兴浓。",
        "品松徒高高，雌鸣讵噰噰。",
        "赏异尚可贵，赏潜谁能容。",
        "名华非典实，翦弃徒纤茸。",
        "刻削大雅文，所以不敢慵。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267380,
      "title": "答李员外小榼味",
      "content": [
        "一拳芙蓉水，倾玉何泠泠。",
        "仙情夙已高，诗味今更馨。",
        "试啜月入骨，再衔愁尽醒。",
        "荷君道古诚，使我善飞翎。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267381,
      "title": "井上枸杞架",
      "content": [
        "深锁银泉甃，高叶架云空。",
        "不与凡木并，自将仙盖同。",
        "影疎千点月，声细万条风。",
        "迸子邻沟外，飘香客位中。",
        "花杯承此饮，椿岁小无穷。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267382,
      "title": "蜘蛛讽",
      "content": [
        "万类皆有性，各各禀天和。",
        "蚕身与汝身，汝身何太讹。",
        "蚕身不为己，汝身不为佗。",
        "蚕丝为衣裳，汝丝为网罗。",
        "济物几无功，害物日已多。",
        "百虫虽切恨，其将奈尔何。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267383,
      "title": "蚊",
      "content": [
        "五月中夜息，饥蚊尚营营。",
        "但将膏血求，岂觉性命轻。",
        "顾己宁自愧，饮人以偷生。",
        "愿为天下幮，一使夜景清。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267384,
      "title": "烛蛾",
      "content": [
        "灯前双舞蛾，厌生何太切。",
        "想尔飞来心，恶明不恶灭。",
        "天若百尺高，应去掩明月。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267385,
      "title": "和钱侍郎甘露",
      "content": [
        "玄天何以言，瑞露青松繁。",
        "忽见垂书迹，还惊涌澧源。",
        "春枝晨袅袅，香味晓翻翻。",
        "子礼忽来献，臣心固易敦。",
        "清风惜不动，薄雾肯蒙昏。",
        "嘉昼色更晶，仁慈久乃存。",
        "一方难独占，天下恐争论。",
        "侧听飞中使，重荣华德门。",
        "从公乐万寿，余庆及儿孙。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267386,
      "title": "和令狐侍郎郭郎中题项羽庙",
      "content": [
        "碧草凌古庙，清尘锁秋窗。",
        "当时独宰割，猛志谁能降。",
        "鼓气雷作敌，劒光电为双。",
        "新悲徒自起，旧恨空浮江。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267387,
      "title": "读张碧集",
      "content": [
        "天宝太白殁，六艺已消歇。",
        "大哉国风本，丧而王泽竭。",
        "先生今复生，斯文信难缺。",
        "下笔证兴亡，陈词备风骨。",
        "高秋数奏琴，澄潭一轮月。",
        "谁作采诗官，忍之不挥发。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267388,
      "title": "听琴",
      "content": [
        "飒飒微雨收，翻翻橡叶鸣。",
        "月沈乱峰西，寥落三四星。",
        "前溪忽调琴，隔林寒琤琤。",
        "闻弹正弄声，不敢枕上听。",
        "回烛整头簪，漱泉立中庭。",
        "定步屐齿深，貌禅目冥冥。",
        "微风吹衣襟，亦认宫徵声。",
        "学道三十年，未免忧死生。",
        "闻弹一夜中，会尽天地情。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267389,
      "title": "闻夜啼赠刘正元",
      "content": [
        "寄泣须寄黄河泉，此中怨声流彻天。",
        "愁人独有夜灯见，一纸乡书泪滴穿。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 267390,
      "title": "喜雨",
      "content": [
        "朝见一片云，暮成千里雨。",
        "凄清湿高枝，散漫沾荒土。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 267391,
      "title": "终南山下作",
      "content": [
        "见此原野秀，始知造化偏。",
        "山村不假阴，流水自雨田。",
        "家家梯碧峰，门门锁青烟。",
        "因思蜕骨人，化作飞桂仙。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267392,
      "title": "观种树",
      "content": [
        "种树皆待春，春至难久留。",
        "君看朝夕花，谁免离别愁。",
        "心意已零落，种之仍未休。",
        "胡为好奇者，无事自买忧。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267393,
      "title": "春雨后",
      "content": [
        "昨夜一霎雨，天意苏群物。",
        "何物最先知，虚庭草争出。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 267394,
      "title": "答友人赠炭",
      "content": [
        "青山白屋有仁人，赠炭价重双乌银。",
        "驱却坐上千重寒，烧出炉中一片春。",
        "吹霞弄日光不定，暖得曲身成直身。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267395,
      "title": "烂柯石",
      "content": [
        "仙界一日内，人间千载穷。",
        "双碁未徧局，万物皆为空。",
        "樵客返归路，斧柯烂从风。",
        "唯余石桥在，犹自凌丹虹。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267396,
      "title": "寻言上人",
      "content": [
        "万里莓苔地，不见驱驰踪。",
        "唯开文字窗，时写日月容。",
        "竹韵漫萧屑，草花徒蒙茸。",
        "披霜入众木，独自识青松。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267397,
      "title": "喷玉布",
      "content": [
        "去尘咫尺步，山笑康乐岩。",
        "天开紫石屏，泉缕明月帘。",
        "仙凝刻削迹，灵绽云霞纤。",
        "悦闻若有待，瞥见终无厌。",
        "俗玩讵能近，道嬉方可淹。",
        "踏着不死机，欲归多浮嫌。",
        "古醉今忽醒，今求古仍潜。",
        "古今相共失，语默两难恬。",
        "赠君喷玉布，一濯高崭崭。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267398,
      "title": "姑蔑城",
      "content": [
        "劲越既成土，强吴亦为墟。",
        "皇风一已被，兹邑信平居。",
        "抚俗观旧迹，行春布新书。",
        "兴亡意何在，绵叹空踌蹰。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267399,
      "title": "峥嵘岭",
      "content": [
        "疏凿顺高下，结构横烟霞。",
        "坐啸郡斋肃，玩奇石路斜。",
        "古树浮绿气，高门结朱华。",
        "始见峥嵘状，仰止逾可嘉。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267400,
      "title": "寻裴处士",
      "content": [
        "涉水更登陆，所向皆清真。",
        "寒草不藏径，灵峰知有人。",
        "悠哉炼金客，独与烟霞亲。",
        "曾是欲轻举，谁言空隐沦。",
        "远心寄白月，华发回青春。",
        "对此钦胜事，胡为劳我身。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267401,
      "title": "子庆诗",
      "content": [
        "王家事已奇，孟氏庆无涯。",
        "献子还生子，羲之又有之。",
        "凤兮且莫叹，鲤也会闻诗。",
        "小小豫章甲，纤纤玉树姿。",
        "人来唯仰乳，母抱未知慈。",
        "我欲拣其养，放麛者是谁。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267402,
      "title": "憩淮上观公法堂",
      "content": [
        "动觉日月短，静知时岁长。",
        "自悲道路人，暂宿空闲堂。",
        "孤烛让清昼，纱巾歛辉光。",
        "高僧积素行，事外无刚强。",
        "我有岩下桂，愿为炉中香。",
        "不惜青翠姿，为君扬芬芳。",
        "淮水色不污，汴流徒浑黄。",
        "且将琉璃意，净缀芙蓉章。",
        "明日还独行，羇愁来旧肠。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267403,
      "title": "江邑春霖奉赠陈侍御",
      "content": [
        "江上花木冻，雨中零落春。",
        "应由放忠直，在此成漂沦。",
        "嘉艳皆损污，好音难殷勤。",
        "天涯多远恨，雪涕盈芳辰。",
        "坐哭青草上，卧吟幽水滨。",
        "兴言念风俗，得意唯波鳞。",
        "枕席病流湿，簷楹若飞津。",
        "始知吴楚水，不及京洛尘。",
        "风浦荡归棹，泥陂陷征轮。",
        "两途日无遂，相赠唯沾巾。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267404,
      "title": "溧阳秋霁",
      "content": [
        "晚雨晓犹在，萧寥激前阶。",
        "星星满衰鬓，耿耿入秋怀。",
        "旧识半零落，前心骤相乖。",
        "饱泉亦恐醉，惕宦肃如斋。",
        "上客处华池，下寮宅枯崖。",
        "叩高占生物，龃龉回难谐。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267405,
      "title": "列仙文 方诸青童君",
      "content": [
        "大霞霏晨晖，元气无常形。",
        "玄辔飞霄外，八景乘高清。",
        "手把玉皇袂，携我晨中生。",
        "玄庭自嘉会，金书拆华名。",
        "贤女密所妍，相期洛水𫐌。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267406,
      "title": "列仙文 清虚真人",
      "content": [
        "歘驾空清虚，徘徊西华馆。",
        "琼轮暨晨抄，虎骑逐烟散。",
        "惠风振丹旌，明烛朗八焕。",
        "解襟墉房内，神铃鸣璀璨。",
        "栖景若林柯，九弦空中弹。",
        "遗我积世忧，释此千载叹。",
        "怡眄无极已，终夜复待旦。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267407,
      "title": "列仙文 金母飞空歌",
      "content": [
        "驾我八景舆，歘然入玉清。",
        "龙群拂霄上，虎旗摄朱兵。",
        "逍遥三弦际，万流无暂停。",
        "哀此去留会，劫尽天地倾。",
        "当寻无中景，不死亦不生。",
        "体彼自然道，寂观合大冥。",
        "南岳挺直干，玉英曜颕精。",
        "有任靡期事，无心自虚灵。",
        "嘉会绛河内，相与乐未英。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267408,
      "title": "列仙文 安度明",
      "content": [
        "丹霞焕上清，八风鼓太和。",
        "回我神霄辇，遂造岭玉阿。",
        "咄嗟天地外，九围皆我家。",
        "上采白日精，下饮黄月华。",
        "灵观空无中，鹏路无间邪。",
        "顾见魏贤安，浊气伤汝和。",
        "勤研玄中思，道成更相过。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267409,
      "title": "夏日谒智远禅师",
      "content": [
        "吾师当几祖，说法云无空。",
        "禅心三界外，宴坐天地中。",
        "院静鬼神去，身与草木同。",
        "因知护王国，满钵盛毒龙。",
        "抖擞尘埃衣，谒师见真宗。",
        "何必千万劫，瞬息去樊笼。",
        "盛夏火为日，一堂十月风。",
        "不得为弟子，名姓挂儒宫。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267410,
      "title": "访嵩阳道士不遇",
      "content": [
        "先生五兵游，文焰藏金鼎。",
        "日下鹤过时，人间空落影。",
        "常言一粒药，不堕生死境。",
        "何当列御寇，去问仙人请。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267411,
      "title": "听蓝溪僧为元居士说维摩经",
      "content": [
        "古树少枝叶，真僧亦相依。",
        "山木自曲直，道人无是非。",
        "手持维摩偈，心向居士归。",
        "空景忽开霁，雪花犹在衣。",
        "洗然水溪昼，寒物生光辉。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267412,
      "title": "借车",
      "content": [
        "借车载家具，家具少于车。",
        "借者莫弹指，贫穷何足嗟。",
        "百年徒役走，万事尽随花。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267413,
      "title": "喜符郎诗有天纵",
      "content": [
        "念符不由级，屹得文章阶。",
        "白玉抽一毫，绿珉已难排。",
        "偷笔作文章，乞墨潜磨揩。",
        "海鲸始生尾，试摆蓬壶涡。",
        "幸当禁止之，勿使恣狂怀。",
        "自悲无子嗟，喜妬双喈喈。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267414,
      "title": "凭周况先辈于朝贤乞茶",
      "content": [
        "道意勿乏味，心绪病无悰。",
        "蒙茗玉花尽，越瓯荷叶空。",
        "锦水有鲜色，蜀山饶芳藂。",
        "云根才翦绿，印缝已霏红。",
        "曾向贵人得，最将诗叟同。",
        "幸为乞寄来，救此病劣躬。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267415,
      "title": "上昭成阁不得于从姪僧悟空院叹嗟",
      "content": [
        "欲上千级阁，问天三四言。",
        "未尽数十登，心目风浪翻。",
        "手手把惊魄，脚脚踏坠魂。",
        "却流至旧手，傍掣犹欲奔。",
        "老病但自悲，古蠹木万痕。",
        "老力安可夸，秋海萍一根。",
        "孤叟何所归，昼眼如黄昏。",
        "常恐失好步，入彼市井门。",
        "结僧为亲情，策竹为子孙。",
        "此诚徒切切，此意空存存。",
        "一寸地上语，高天何由闻。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267416,
      "title": "魏博田兴尚书听嫂命不立非夫人诗",
      "content": [
        "君子躭古礼，如馋鱼吞钩。",
        "昨闻敬嫂言，掣心东北流。",
        "魏博田尚书，与礼相绸缪。",
        "善词闻天下，一日一再周。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267417,
      "title": "读经",
      "content": [
        "垂老抱佛脚，教妻读黄经。",
        "经黄名小品，一纸千明星。",
        "曾读大般若，细感肸蚃听。",
        "当时把斋中，方寸抱万灵。",
        "忽复入长安，蹴踏日月宁。",
        "老方却归来，收拾可丁丁。",
        "拂拭尘几案，开函就孤亭。",
        "儒书难借索，僧签饶芳馨。",
        "驿驿不开手，铿铿闻异铃。",
        "得善如焚香，去恶如脱腥。",
        "安得颜子耳，曾未如此听。",
        "听之何有言，德教贵有形。",
        "何言中国外，有国如海萍。",
        "海萍国教异，天声各泠泠。",
        "安排未定时，心火竞荧荧。",
        "将如庶几者，声尽形元冥。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267418,
      "title": "谢李辀再到",
      "content": [
        "等闲拜日晚，夫妻独相疮。",
        "况是贤人冤，何必哭飞杨。",
        "昨夜梦得劒，为君藏中肠。",
        "会将当风烹，血染布衣裳。",
        "劳君又扣门，词句失寻常。",
        "我不忍出厅，血字湿土墙。",
        "血字耿不灭，我心惧惶惶。",
        "会有铿锵夫，见之目生光。",
        "生光非等闲，君其且安祥。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267419,
      "title": "忽不贫喜卢仝书船归洛",
      "content": [
        "贫孟忽不贫，请问孟何如。",
        "卢仝归洛船，崔嵬但载书。",
        "江潮清翻翻，淮潮碧徐徐。",
        "夜信为朝信，朝信良卷舒。",
        "江淮君子水，相送仁有余。",
        "我去官色衫，肩经入君庐。",
        "喃喃肩经郎，言语倾琪琚。",
        "琪琚铿好词，鸟鹊跃庭除。",
        "书船平安归，喜报乡里闾。",
        "我愿拾遗柴，巢经于空虚。",
        "下免尘土侵，上为云霞居。",
        "日月更相锁，道义分明储。",
        "不愿空岧峣，但愿实工夫。",
        "实空二理微，分别相起予。",
        "经书荒芜多，为君勉勉锄。",
        "勉勉不敢专，传之方在诸。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267420,
      "title": "吊国殇",
      "content": [
        "徒言人最灵，白骨乱纵横。",
        "如何当春死，不及群草生。",
        "尧舜宰乾坤，器农不器兵。",
        "秦汉盗山岳，铸杀不铸畊。",
        "天地莫生金，生金人竞争。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267421,
      "title": "吊比干墓",
      "content": [
        "殷辛帝天下，厌为天下尊。",
        "干刚既一断，贤愚无二门。",
        "佞是福身本，忠是丧己源。",
        "饿虎不食子，人无骨肉恩。",
        "日影不入地，下埋冤死魂。",
        "有骨不为土，应作直木根。",
        "今来过此乡，下马吊此坟。",
        "静念君臣间，有道谁敢论。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267422,
      "title": "吊元鲁山 一",
      "content": [
        "[搏]鸷有余饱，鲁山长饥空。",
        "豪人饫鲜肥，鲁山饭蒿蓬。",
        "食名皆霸官，食力乃尧农。",
        "君子耻新态，鲁山与古终。",
        "天璞本平一，人巧生异同。",
        "鲁山不自剖，全璞竟没躬。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267423,
      "title": "吊元鲁山 二",
      "content": [
        "自剖多是非，流滥将何归。",
        "奔竞立诡节，凌侮争怪辉。",
        "五常坐销铄，万类随衰微。",
        "以兹见鲁山，道蹇无所依。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267424,
      "title": "吊元鲁山 三",
      "content": [
        "君子不自蹇，鲁山蹇有因。",
        "苟含天地秀，皆是天地身。",
        "天地蹇既甚，鲁山道莫伸。",
        "天地气不足，鲁山食更贫。",
        "始知补元化，竟须得贤人。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267425,
      "title": "吊元鲁山 四",
      "content": [
        "贤人多自霾，道理与俗乖。",
        "细功不敢言，远韵方始谐。",
        "万物饱为饱，万人怀为怀。",
        "一声苟失所，众憾来相排。",
        "所以元鲁山，饥衰难与偕。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267426,
      "title": "吊元鲁山 五",
      "content": [
        "远阶无近级，造次不可升。",
        "贤人洁肠胃，寒日空澄凝。",
        "血誓竟讹谬，膏明易煎蒸。",
        "以之驱鲁山，疎迹去莫乘。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267427,
      "title": "吊元鲁山 六",
      "content": [
        "言从鲁山宦，尽化尧时心。",
        "豺狼耻狂噬，齿牙闭霜金。",
        "竞来辟田土，相与畊嵚岑。",
        "当宵无关锁，竟岁饶歌吟。",
        "善教复天术，美词非俗箴。",
        "精微自然事，视听不可寻。",
        "因书鲁山绩，庶合箫韶音。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267428,
      "title": "吊元鲁山 七",
      "content": [
        "箫韶太平乐，鲁山不虚作。",
        "千古若有知，百年幸如昨。",
        "谁能嗣教化，以此洗浮薄。",
        "君臣贵深遇，天地有灵橐。",
        "力运既艰难，德符方合漠。",
        "名位苟虚旷，声明自销铄。",
        "礼法虽相救，贞浓易糟粕。",
        "哀哀元鲁山，毕竟谁能度。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267429,
      "title": "吊元鲁山 八",
      "content": [
        "当今富教化，元后得贤相。",
        "冰心镜衰古，霜议清遐障。",
        "幽埋尽洸洗，滞旅免流浪。",
        "唯余鲁山名，未获旌廉让。",
        "二三贞苦士，刷视耸危望。",
        "发秋青山夜，目断丹阙亮。",
        "诱类幸从兹，嘉招固非妄。",
        "小生奏狂狷，感惕增万状。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267430,
      "title": "吊元鲁山 九",
      "content": [
        "黄犊不知孝，鲁山自驾车。",
        "非贤不可妻，鲁山竟无家。",
        "供养耻佗力，言词岂纤瑕。",
        "将谣鲁山德，赜海谁能涯。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267431,
      "title": "吊元鲁山 十",
      "content": [
        "遗婴尽雏乳，何况骨肉枝。",
        "心肠结苦诚，胸臆垂甘滋。",
        "事已出古表，谁言独今奇。",
        "贤人母万物，岂弟流前诗。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267432,
      "title": "哭李观",
      "content": [
        "志士不得老，多为直气伤。",
        "阮公终日哭，寿命固难长。",
        "颜子既殂谢，孔门无辉光。",
        "文星落奇曜，宝劒摧修铓。",
        "常作金应石，忽为宫别商。",
        "为尔吊琴瑟，断弦难再张。",
        "偏毂不可转，只翼不可翔。",
        "清尘无吹嘘，委地难飞扬。",
        "此义古所重，此风今则亡。",
        "自闻丧元宾，一日八九狂。",
        "沈痛此丈夫，惊呼彼穹苍。",
        "我有出俗韵，劳君疾恶肠。",
        "知音既已矣，微言谁能彰。",
        "旅葬无高坟，栽松不成行。",
        "哀歌动寒日，赠泪沾晨霜。",
        "神理本窅窅，今来更茫茫。",
        "何以荡悲怀，万事付一觞。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267433,
      "title": "李少府厅吊李元宾遗字",
      "content": [
        "零落三四字，忽成千万年。",
        "那知冥寞客，不有补亡篇。",
        "斜月吊空壁，旅人难独眠。",
        "一生能几时，百虑来相煎。",
        "戚戚故交泪，幽幽长夜泉。",
        "已矣难重言，一言一潸然。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267434,
      "title": "悼吴兴汤衡评事",
      "content": [
        "君生霅水清，君殁霅水浑。",
        "空令骨肉情，哭得白日昏。",
        "大夜不复晓，古松长闭门。",
        "琴弦绿水绝，诗句青山存。",
        "昔为芳春颜，今为荒草根。",
        "独问冥冥理，先儒未曾言。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267435,
      "title": "哀孟云卿嵩阳荒居",
      "content": [
        "戚戚抱幽独，宴宴沈荒居。",
        "不闻新欢笑，但覩旧诗书。",
        "艺蘗意弥苦，耕山食无余。",
        "定交昔何在，至戚今或疎。",
        "薄俗易销歇，淳风难久舒。",
        "秋芜上空堂，寒槿落枯渠。",
        "薙草恐伤蕙，摄衣自理锄。",
        "残芳亦可饵，遗秀谁忍除。",
        "徘徊未能去，为尔涕涟如。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267436,
      "title": "哭卢贞国",
      "content": [
        "一别难与期，存亡易寒燠。",
        "下马入君门，声悲不成哭。",
        "自能富才艺，当冀深荣禄。",
        "皇天负我贤，遗恨至两目。",
        "平生叹无子，家家亲相嘱。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267437,
      "title": "伤旧游",
      "content": [
        "去春会处今春归，花数不减人数稀。",
        "朝笑片时暮成泣，东风一向还西辉。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 267438,
      "title": "吊房十五次卿少府",
      "content": [
        "日高方得起，独赏些些春。",
        "可惜宛转鸎，好音与佗人。",
        "昔年此气味，还走曲江滨。",
        "逢著韩退之，结交方殷勤。",
        "蜀客骨目高，聪辩劒戟新。",
        "如何昨日欢，今日见无因。",
        "英奇一谢世，视听一为尘。",
        "谁言老泪短，泪短沾衣巾。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267439,
      "title": "逢江南故昼上人会中郑方回",
      "content": [
        "相逢失意中，万感因语至。",
        "追思东林日，掩抑北邙泪。",
        "筐箧有遗文，江山旧清气。",
        "尘生逍遥注，墨故飞动字。",
        "荒毁碧涧居，虚无青松位。",
        "珠沈百泉暗，月死群象闭。",
        "永谢平生言，知音岂容易。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 267440,
      "title": "哭秘书包大监",
      "content": [
        "哲人卧病日，贱子泣玉年。",
        "常恐宝镜破，明月难再圆。",
        "文字未改素，声容忽归玄。",
        "始知知音稀，千载一绝弦。",
        "旧馆有遗琴，清风那复传。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267441,
      "title": "悼幼子",
      "content": [
        "一闭黄蒿门，不闻白日事。",
        "生气散成风，枯骸化为地。",
        "负我十年恩，欠尔千行泪。",
        "洒之北原上，不待秋风至。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267442,
      "title": "悼亡",
      "content": [
        "山头明月夜增辉，增辉不照重泉下。",
        "泉下双龙无再期，金蚕玉燕空销化。",
        "朝云暮雨成古墟，萧萧野竹风吹亚。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267443,
      "title": "吊李元宾坟",
      "content": [
        "晓上荒凉原，吊彼寂寥魂。",
        "眼咽此时泪，耳凄在日言。",
        "冥冥千万年，坟锁孤松根。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267444,
      "title": "览崔爽遗文因纾幽怀",
      "content": [
        "堕泪数首文，悲结千里坟。",
        "苍旻且留我，白日空遗君。",
        "仙鹤未巢月，衰凤先坠云。",
        "清风独起时，旧语如再闻。",
        "瑶草罢葳蕤，桂花休氛氲。",
        "万物与我心，相感吴江𣸣。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267445,
      "title": "峡哀 一",
      "content": [
        "昔多相与笑，今谁相与哀。",
        "峡哀哭幽魂，噭噭风吹来。",
        "堕魄抱空月，出没难自裁。",
        "齑粉一闪间，春涛百丈雷。",
        "峡水声不平，碧沲牵清洄。",
        "沙棱箭箭急，波齿龂龂开。",
        "呀彼无底吮，待此不测灾。",
        "谷号相喷激，石怒争旋回。",
        "古醉有复乡，今缧多为能。",
        "字孤徒髣髴，衔雪犹惊猜。",
        "薄俗少直肠，交结须横财。",
        "黄金买相吊，幽泣无余漼。",
        "我有古心意，为君空摧颓。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267446,
      "title": "峡哀 二",
      "content": [
        "上天下天水，出地入地舟。",
        "石劒相劈斫，石波怒蛟虬。",
        "花木叠宿春，风飙凝古秋。",
        "幽怪窟穴语，飞闻肸蚃流。",
        "沈哀日已深，衔诉将何求。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267447,
      "title": "峡哀 三",
      "content": [
        "三峡一线天，三峡万绳泉。",
        "上仄碎日月，下掣狂漪涟。",
        "破魂一两点，凝幽数百年。",
        "峡晖不停午，峡险多饥涎。",
        "树根锁枯棺，孤骨褭褭悬。",
        "树枝哭霜栖，哀韵杳杳鲜。",
        "逐客零落肠，到此汤火煎。",
        "性命如纺绩，道路随索缘。",
        "奠泪吊波灵，波灵将闪然。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267448,
      "title": "峡哀 四",
      "content": [
        "峡乱鸣清磬，产石为鲜鳞。",
        "喷为腥雨涎，吹作黑井身。",
        "怪光闪众异，饿劒唯待人。",
        "老肠未曾饱，古齿崭岩嗔。",
        "嚼齿三峡泉，三峡声龂龂。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    }
