{
  "data": [
    {
      "id": 283095,
      "title": "偶书五首 五",
      "content": [
        "掩谤知迎吠，欺心见强颜。",
        "有名人易困，无契债难还。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 283096,
      "title": "杂题九首 一",
      "content": [
        "病来胜未病，名缚便忘名。",
        "今日甘为客，当时注愍征。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 283097,
      "title": "杂题九首 二",
      "content": [
        "暑湿深山雨，荒居破屋灯。",
        "此生无忏处，此去作高僧。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 283098,
      "title": "杂题九首 三",
      "content": [
        "不须频怅望，且喜脱喧嚣。",
        "亦有终焉意，陂南看稻苗。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 283099,
      "title": "杂题九首 四",
      "content": [
        "楼带猨吟迥，庭容鹤舞宽。",
        "晒书因阅画，封药偶和丹。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 283100,
      "title": "杂题九首 五",
      "content": [
        "宴罢论诗久，亭高拜表频。",
        "岸香蕃舶月，洲色海烟春。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 283101,
      "title": "杂题九首 六",
      "content": [
        "驿步堤萦阁，军城鼓振桥。",
        "鸥和湖鴈下，雪隔岭梅飘。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 283102,
      "title": "杂题九首 七",
      "content": [
        "带雪南山道，和钟北阙明。",
        "太平当共贺，开化喝来声。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 283103,
      "title": "杂题九首 八",
      "content": [
        "舴艋猨偷上，蜻蜓燕竞飞。",
        "樵香烧桂子，苔湿挂莎衣。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 283104,
      "title": "杂题九首 九",
      "content": [
        "溪涨渔家近，烟收鸟道高。",
        "松花飘可惜，睡里洒离骚。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 283105,
      "title": "古乐府",
      "content": [
        "一叶随西风，君行亦向东。",
        "知妾飞书意，无劳待早鸿。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 283106,
      "title": "有感",
      "content": [
        "灯影看须黑，墙阴惜草青。",
        "岁阑悲物我，同是冒霜萤。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 283107,
      "title": "休休亭",
      "content": [
        "且喜安能保，那堪病更忧。",
        "可怜藜杖者，真个种瓜侯。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 283108,
      "title": "漫书二首 一",
      "content": [
        "剩欲逢花折，判须冒雨频。",
        "晴明开渐少，莫怕湿新巾。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 283109,
      "title": "漫书二首 二",
      "content": [
        "小蝶尔何竞，追飞不惮劳。",
        "远教群雀见，宁悟祸梯高。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 283110,
      "title": "岁尽二首 一",
      "content": [
        "明日添一岁，端忧奈尔何。",
        "冲寒出洞口，犹校夕阳多。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 283111,
      "title": "岁尽二首 二",
      "content": [
        "莫话伤心事，投春满鬓霜。",
        "殷勤共尊酒，今岁只残阳。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 283112,
      "title": "牡丹",
      "content": [
        "得地牡丹盛，晓添龙麝香。",
        "主人犹自惜，锦幕护春霜。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 283113,
      "title": "乱后",
      "content": [
        "羽书传栈道，风火隔乡关。",
        "病眼那堪泣，伤心不到间。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 283114,
      "title": "春山",
      "content": [
        "可是武陵溪，春芳著路迷。",
        "花明催曙早，云腻惹空低。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 283115,
      "title": "乐府",
      "content": [
        "宝马跋尘光，双驰照路旁。",
        "喧传报戚里，明日幸长杨。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 283116,
      "title": "乱前上卢相",
      "content": [
        "虏黠虽多变，兵骄即易乘。",
        "犹须劳斥候，勿遣大河冰。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 283117,
      "title": "有感",
      "content": [
        "国事皆须救未然，汉家高阁漫凌烟。",
        "功臣尽遣词人赞，不省沧洲画鲁连。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283118,
      "title": "歌",
      "content": [
        "处处亭台只坏墙，军营人学内人妆。",
        "太平故事因君唱，马上曾听隔教坊。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283119,
      "title": "偈",
      "content": [
        "人若憎时我亦憎，逃名最要是无能。",
        "后生乞汝残风月，自作深林不语僧。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283120,
      "title": "鹂",
      "content": [
        "不是流莺独占春，林间彩翠四时新。",
        "应知拟上屏风画，偏坐横枝亦向人。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283121,
      "title": "白菊杂书四首 一",
      "content": [
        "黄昏寒立更披襟，露浥清香悦道心。",
        "却笑谁家扃绣户，正薰龙麝暖鸳衾。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283122,
      "title": "白菊杂书四首 二",
      "content": [
        "四面云屏一带天，是非断得自翛然。",
        "此生只是偿诗债，白菊开时最不眠。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283123,
      "title": "白菊杂书四首 三",
      "content": [
        "狂才不足自英雄，仆妾驱令学贩舂。",
        "侯印几人封万户，侬家只办买孤峰。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283124,
      "title": "白菊杂书四首 四",
      "content": [
        "黄鹂啭处谁同听，白菊开时且剩过。",
        "漫道南朝足流品，由来叔宝不宜多。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283125,
      "title": "漫题",
      "content": [
        "经乱年年厌别离，歌声喜似太平时。",
        "词臣更有中兴颂，磨取莲峰便作碑。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283126,
      "title": "率题",
      "content": [
        "宦路前衔闲不记，醉乡佳境兴方浓。",
        "一林高竹长遮日，四壁寒山更闰冬。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283127,
      "title": "磵户",
      "content": [
        "磵户芳烟接水邨，乱来归得道仍存。",
        "数竿新竹当轩上，不羡侯家立戟门。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283128,
      "title": "故乡杏花",
      "content": [
        "寄花寄酒喜新开，左把花枝右把杯。",
        "欲问花枝与杯酒，故人何得不同来。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283129,
      "title": "华下二首 一",
      "content": [
        "故国春归未有涯，小栏高槛别人家。",
        "五更惆怅回孤枕，犹自残灯照落花。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283130,
      "title": "华下二首 二",
      "content": [
        "关外风昏欲雨天，荠花耕倒枕河壖。",
        "邨南寂寞时回望，一只鸳鸯下渡船。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283131,
      "title": "梦中",
      "content": [
        "几多亲爱在人间，上彻霞梯会却还。",
        "须是蓬瀛长买得，一家同占作家山。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283132,
      "title": "牓下",
      "content": [
        "三十功名志未伸，初将文字竞通津。",
        "春风漫折一枝桂，烟阁英雄笑杀人。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283133,
      "title": "涔阳渡",
      "content": [
        "楚田人立带残晖，驿逈邨幽客路微。",
        "两岸芦花正萧飒，渚烟深处白牛归。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283134,
      "title": "偶作",
      "content": [
        "索得身归未保闲，乱来道在辱来顽。",
        "留侯万户虽无分，病骨应消一片山。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283135,
      "title": "寓居有感三首 一",
      "content": [
        "亦知世路薄忠贞，不忍残年负圣明。",
        "只待东封沾庆赐，碑阴别刻老臣名。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283136,
      "title": "寓居有感三首 二",
      "content": [
        "不放残年却到家，衔杯懒更问生涯。",
        "河堤往往人相送，一曲晴川隔蓼花。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283137,
      "title": "寓居有感三首 三",
      "content": [
        "黑须寄在白须生，一度秋风减几茎。",
        "客处不堪频送别，无多情绪更伤情。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283138,
      "title": "淮西",
      "content": [
        "鼇冠三山安海浪，龙盘九鼎镇皇都。",
        "莫夸十万兵威盛，消个忠良效顺无。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283139,
      "title": "河湟有感",
      "content": [
        "一自萧关起战尘，河湟隔断异乡春。",
        "汉儿尽作胡儿语，却向城头骂汉人。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283140,
      "title": "自䢵乡北归",
      "content": [
        "巴烟幂幂久萦恨，楚柳绵绵今送归。",
        "回避江边同去鴈，莫教惊起错南飞。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283141,
      "title": "青龙师安上人",
      "content": [
        "灾曜偏临许国人，雨中衰菊病中身。",
        "清香一炷知师意，应为昭陵惜老臣。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283142,
      "title": "山中",
      "content": [
        "凡鸟爱喧人静处，闲云似妬月明时。",
        "世间万事非吾事，只愧秋来未有诗。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283143,
      "title": "有感二首 一",
      "content": [
        "自古经纶足是非，阴谋最忌夺天机。",
        "留侯却粒商翁去，甲第何人意气归。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283144,
      "title": "有感二首 二",
      "content": [
        "古来贤俊共悲辛，长是豪家拒要津。",
        "从此当歌唯痛饮，不须经世为闲人。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283145,
      "title": "闲夜二首 一",
      "content": [
        "道侣难留为虐棋，邻家闻说厌吟诗。",
        "前峰月照分明见，夜合香中露卧时。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283146,
      "title": "闲夜二首 二",
      "content": [
        "此身闲得易为家，业是吟诗与看花。",
        "若使他生抛笔砚，更应无事老烟霞。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283147,
      "title": "雨中",
      "content": [
        "维摩居士陶居士，尽说高情未足夸。",
        "簷外莲峰堦下菊，碧莲黄菊是吾家。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283148,
      "title": "送道者二首 一",
      "content": [
        "洞天真侣昔曾逢，西岳今居第几峰。",
        "峰顶他时教我认，相招须把碧芙蓉。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283149,
      "title": "送道者二首 二",
      "content": [
        "殷勤不为学烧金，道侣惟应识此心。",
        "雪里千山访君易，微微鹿迹入深林。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283150,
      "title": "重阳阻雨",
      "content": [
        "重阳阻雨独衔杯，移得山家菊未开。",
        "犹胜登高闲望断，孤烟残照马嘶回。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283151,
      "title": "省试",
      "content": [
        "粉闱深锁唱同人，正是终南雪霁春。",
        "闲系长安千匹马，今朝似减六街尘。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283152,
      "title": "有赠",
      "content": [
        "有诗有酒有高歌，春色年年奈我何。",
        "试问羲和能驻否，不劳频借鲁阳戈。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283153,
      "title": "证因亭",
      "content": [
        "峰北幽亭愿证因，他生此地却容身。",
        "上方僧在时应到，笑认前衔记写真。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283154,
      "title": "顷年陪恩地赴甘棠之召感动留题",
      "content": [
        "去时憔悴青衿在，归路凄凉绛帐空。",
        "无限酬恩心未展，又将孤劒别从公。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283155,
      "title": "九月八日",
      "content": [
        "已是人间寂寞花，解怜寂寞傍贫家。",
        "老来不得登高看，更甚残春惜岁华。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283156,
      "title": "敷溪桥院有感",
      "content": [
        "昔岁攀游景物同，药炉今在鹤归空。",
        "青山满眼泪堪碧，绛帐无人花自红。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283157,
      "title": "寺阁",
      "content": [
        "昔岁登临未衰飒，不知何事爱伤情。",
        "今来揽镜翻堪喜，乱后霜须长几茎。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283158,
      "title": "武陵路",
      "content": [
        "橘岸舟间罾网挂，茶坡日暖鹧鸪啼。",
        "女郎指点行人笑，知向花间路已迷。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283159,
      "title": "南北史感遇十首 一",
      "content": [
        "雨淋麟阁名臣画，雪卧龙庭猛将碑。",
        "不用黄金铸侯印，尽输公子买蛾眉。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283160,
      "title": "南北史感遇十首 二",
      "content": [
        "汉世频封万户侯，云台空峻谢风流。",
        "江南不有名儒相，齿冷中原笑未休。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283161,
      "title": "南北史感遇十首 三",
      "content": [
        "天风斡海怒长鲸，永固南来百万兵。",
        "若向沧洲犹笑傲，江山虚有石头城。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283162,
      "title": "南北史感遇十首 四",
      "content": [
        "花迷公子玉楼恩，镜弄佳人红粉春。",
        "不信关山劳远戍，绮罗香外任行尘。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283163,
      "title": "南北史感遇十首 五",
      "content": [
        "兵围梁殿金瓯破，火发陈宫玉树摧。",
        "奸佞岂能惭误国，空令怀古更徘徊。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283164,
      "title": "南北史感遇十首 六",
      "content": [
        "行乐最宜连夜景，太平方觉有春风。",
        "千金尽把酬歌舞，犹胜三边赏战功。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283165,
      "title": "南北史感遇十首 七",
      "content": [
        "桃芳李艳年年发，羌管蛮弦处处多。",
        "海上应无三岛路，人间惟有一声歌。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283166,
      "title": "南北史感遇十首 八",
      "content": [
        "佳人自折一枝红，把唱新词曲未终。",
        "惟向眼前怜易落，不如抛掷任春风。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283167,
      "title": "南北史感遇十首 九",
      "content": [
        "景阳楼下花钿镜，玄武湖边锦绣旗。",
        "昔日繁华今日恨，雉媒声晚草芳时。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283168,
      "title": "南北史感遇十首 十",
      "content": [
        "乱后人间尽不平，秦川花木最伤情。",
        "无穷红艳红尘里，骤马分香散入营。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283169,
      "title": "狂题二首 一",
      "content": [
        "草堂旧隐犹招我，烟阁英才不见君。",
        "惆怅故山归未得，酒狂呌断暮天云。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283170,
      "title": "狂题二首 二",
      "content": [
        "须知世乱身难保，莫喜天晴菊并开。",
        "长短此身长是客，黄花更助白头催。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283171,
      "title": "红茶花",
      "content": [
        "景物诗人见即夸，岂怜高韵说红茶。",
        "牡丹枉用三春力，开得方知不是花。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283172,
      "title": "秋燕",
      "content": [
        "从扑香尘拂面飞，怜渠只为解相依。",
        "经冬好近深炉暖，何必千岩万水归。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283173,
      "title": "见后鴈有感",
      "content": [
        "笑尔穷通亦似人，高飞偶滞莫悲辛。",
        "却缘风雪频相阻，只向关中待得春。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283174,
      "title": "移桃栽",
      "content": [
        "独临官路易伤摧，从遣春风恣意开。",
        "禅客笑移山上看，流莺直到槛前来。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283175,
      "title": "忆中条",
      "content": [
        "燕辞旅舍人空在，萤出疎篱菊正芳。",
        "堪恨昔年联句地，念经僧扫过重阳。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283176,
      "title": "乐府",
      "content": [
        "五更窗下簇妆台，已怕堂前阿母催。",
        "满鸭香薰鹦鹉睡，隔帘灯照牡丹开。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 283177,
      "title": "放龟二首 一",
      "content": [
        "却为多知自不灵，今朝教汝卜长生。",
        "若求深处无深处，只有依人会有情。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283178,
      "title": "放龟二首 二",
      "content": [
        "世外犹迷不死庭，人间莫恃自无营。",
        "本期沧海堪投迹，却向朱门待放生。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283179,
      "title": "灯花三首 一",
      "content": [
        "蜀柳丝丝幂画楼，窗尘满镜不梳头。",
        "几时金鴈传归信，剪断香魂一缕愁。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283180,
      "title": "灯花三首 二",
      "content": [
        "姊姊教人且抱儿，逐他女伴卸头迟。",
        "明朝鬬草多应喜，剪得灯花自扫眉。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283181,
      "title": "灯花三首 三",
      "content": [
        "闰前小雪过经旬，犹自依依向主人。",
        "开尽菊花怜强舞，与教弟子待新春。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283182,
      "title": "偶题三首 一",
      "content": [
        "浮世悠悠旋一空，多情偏解挫英雄。",
        "风光只在歌声里，不必楼前万树红。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283183,
      "title": "偶题三首 二",
      "content": [
        "小池随事有风荷，烧酹倾壶一曲歌。",
        "欲待秋塘擎露看，自怜生意已无多。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283184,
      "title": "偶题三首 三",
      "content": [
        "辽阳音信近来稀，纵有虚传逼节归。",
        "永日无人新睡觉，小窗晴暖螖虫飞。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283185,
      "title": "华下对菊",
      "content": [
        "清香裛露对高斋，泛酒偏能浣旅怀。",
        "不似春风逞红艳，镜前空坠玉人钗。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283186,
      "title": "与都统参谋书有感",
      "content": [
        "惊鸾迸鹭尽归林，弱羽低垂分独沈。",
        "带病深山犹草檄，昭陵应识老臣心。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283187,
      "title": "漫题",
      "content": [
        "无宦无名拘逸兴，有歌有酒任他乡。",
        "看看万里休征戍，莫向新词寄断肠。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283188,
      "title": "商山二首 一",
      "content": [
        "清溪一路照羸身，不似云台画像人。",
        "国史数行犹有志，只将谈笑继英尘。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283189,
      "title": "商山二首 二",
      "content": [
        "马上搜奇已数篇，籍中犹愧是顽仙。",
        "关头传说开元事，指点多疑孟浩然。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283190,
      "title": "与伏牛长老偈二首 一",
      "content": [
        "不算菩提与阐提，惟应执著便生迷。",
        "无端指个清凉地，冻杀胡僧雪岭西。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283191,
      "title": "与伏牛长老偈二首 二",
      "content": [
        "长绳不见系空虚，半偈传心亦未疎。",
        "推倒我山无一事，莫将文字缚真如。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283192,
      "title": "客中重九",
      "content": [
        "楚老相逢泪满衣，片名薄宦已知非。",
        "他乡不似人间路，应共东流更不归。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283193,
      "title": "柳二首 一",
      "content": [
        "谁家按舞傍池塘，已见繁枝嫩眼黄。",
        "漫说早梅先得意，不知春力暗分张。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283194,
      "title": "柳二首 二",
      "content": [
        "似拟凌寒妬早梅，无端弄色傍高台。",
        "折来未有新枝长，莫遣佳人更折来。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    }
  ],
