{
  "data": [
    {
      "id": 44892,
      "title": "新居翦茅",
      "content": [
        "小筑初开一亩基，晚风散策已相宜。",
        "山童何急催归去，正是凉生月上时。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 44893,
      "title": "读罪己诏时有符离之溃  其一",
      "content": [
        "莫读轮台诏，令人泪点垂。",
        "天乎容此虏，帝者渴非罴。",
        "何罪良家子，知它大将谁。",
        "愿惩危度口，傥复雁门踦。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 44894,
      "title": "读罪己诏时有符离之溃  其二",
      "content": [
        "乱起吾降日，吾将强仕年。",
        "中原仍梦里，南纪且愁边。",
        "陛下非常主，群公莫自贤。",
        "金台尚未筑，乃至羡强燕。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 44895,
      "title": "读罪己诏时有符离之溃  其三",
      "content": [
        "只道六朝窄，渠犹数百春。",
        "国家祖宗泽，天地发生仁。",
        "历服端传远，君王但侧身。",
        "楚人要能惧，周命正惟新。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 44896,
      "title": "题代度寺",
      "content": [
        "一别重来十五年，残僧半在寺依然。",
        "黄杨当日绝低小，已过危簷也可怜。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 44897,
      "title": "又题寺后竹亭",
      "content": [
        "行尽空房忽画栏，竹光和月入亭寒。",
        "壁间题字知谁句，醉把残灯子细看。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 44898,
      "title": "中秋前两日别刘彦纯彭仲庄于白马山下",
      "content": [
        "匆匆离合梦非梦，续续谈谐眠不眠。",
        "莫道对床容易著，试思分手几何年。",
        "长亭更放金荷浅，后夜谁同璧月圆。",
        "要得长随二三友，不知由我定由天。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 44899,
      "title": "早发建安寺过大栎虚",
      "content": [
        "睡美那能动，朝凉强作行。",
        "吾方犯星起，人已趁虚声。",
        "近路还如许，长途作么生。",
        "两亲今正老，三釜又须营。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 44900,
      "title": "中秋前一夕翫月",
      "content": [
        "月拟来宵好，吾先今夕遭。",
        "才升半壁许，已复一轮高。",
        "迁坐明相就，群飞影得逃。",
        "望秋惟有此，彻夜敢辞劳。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 44901,
      "title": "赴调宿白沙渡族叔文远携酒追送走笔取别",
      "content": [
        "扁舟斜缆白沙虚，欲行未发小踟蹰。",
        "吾家子云来得得，为携碧酒买白鱼。",
        "谊风多年冷似铁，非公其谁主风月。",
        "尊前醉倒定不嗔，同来多半个中人。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 44902,
      "title": "醉后题壁",
      "content": [
        "夜寒星斗挂屋椽，我辈把酒不问天。",
        "语声未怕惊天上，只愁惊起白鸥眠。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 44903,
      "title": "夜雨泊新淦",
      "content": [
        "乱眼才迷树，回头已湿沙。",
        "萧萧打篷急，点点入船斜。",
        "此夕初为客，何时却到家。",
        "余樽曾卧否，唤取作生涯。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 44904,
      "title": "明发新淦晴快风顺约泊樟镇",
      "content": [
        "雨到中宵歇，心知逗晓晴。",
        "排云数峰出，漏日半江明。",
        "风借轻帆便，天催嬾客行。",
        "不应樟镇酒，无意待人倾。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 44905,
      "title": "泊樟镇",
      "content": [
        "北地三接淅，重来四肃霜。",
        "日斜秋树转，市散暮船忙。",
        "波卷清中白，霞翻紫外黄。",
        "汀沙浑换却，不记旧圜方。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 44906,
      "title": "午憩堆钱岭",
      "content": [
        "蚤作难为饭，前途又苦饥。",
        "尘劳正未了，眠食且随宜。",
        "小憩那思去，追程得更迟。",
        "馆人只冷眼，还为惜奔驰。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 44907,
      "title": "路逢故将军李显忠以符离之役私其府库士怨而溃谪居长沙",
      "content": [
        "贪将如中使，兵书不误今。",
        "只悲熊耳甲，谁怨褭蹄金。",
        "贾傅奚同郡，朱游独折心。",
        "书生何处说，诗罢自长吟。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 44908,
      "title": "宿杨塘店",
      "content": [
        "吾生行路何时了，旧馆重来身渐老。",
        "路旁松桂只十年，如今修修旧小小。",
        "昨宵宿处又云边，来宵还似今宵然。",
        "陈迹更待俛仰间，有酒不饮要称贤。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 44909,
      "title": "宿长林",
      "content": [
        "雾月撩人白，风灯恼客青。",
        "倦多资美睡，酒薄免迟醒。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 44910,
      "title": "午憩东塘近白干江西地尽于此",
      "content": [
        "日以秋还短，涂缘热故长。",
        "也知茅店小，奈此竹风凉。",
        "更远终然到，而吾有底忙。",
        "欲行犹小驻，咫尺便它乡。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 44911,
      "title": "初寒",
      "content": [
        "欲雨还晴又作阴，添衣已减却重寻。",
        "绝知不晚新寒到，更用先来破客心。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 44912,
      "title": "沙溪江亭",
      "content": [
        "渔舟竟日不知还，水碓无人也不闲。",
        "斫却江头一丛柳，当愁无地著江山。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 44913,
      "title": "宿张家店壁间有赵民则一绝句云舍策投床睡便浓觉来凉叶动西风惊秋念远无穷意客里知谁此夜同因次其韵",
      "content": [
        "督邮不敌客愁浓，那更秋宵一笛风。",
        "公子何曾知许事，旷怀也解与人同。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 44914,
      "title": "蒋莲店有书柳子厚寄吴武陵琴诗三读敬哦五言",
      "content": [
        "秋晴得凉行，壁阅遇佳读。",
        "已咽犹余滋，将烬忽剩馥。",
        "语妙古未多，听难今良独。",
        "追诵惜去眼，信步遑拟足。",
        "惊心一鸟鸣，隔溪两峰绿。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 44915,
      "title": "道逢王元龟阁学",
      "content": [
        "秋日才升却雾中，先生更去恐群空。",
        "古谁云远今犹古，公亦安知世重公。",
        "轩冕何缘关此老，江山所过总清风。",
        "我行安用相逢得，不得趋隅又北东。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 44916,
      "title": "宿枫平",
      "content": [
        "休说江西西路行，东来骨瘦却诗清。",
        "恐缘桂玉疎云子，敢对溪山唤曲生。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 44917,
      "title": "发枫平",
      "content": [
        "谷暗迷窗晓，山鸣报雨来。",
        "畦丁绝须喜，菜甲正新栽。",
        "倦路愁何那，冲泥惯岂才。",
        "吾诗未大好，也辱片云催。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 44918,
      "title": "过下梅",
      "content": [
        "不特山盘水亦回，溪山信美暇徘徊。",
        "行人自趁斜阳急，关得归鸦更苦催。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 44919,
      "title": "九日落莫忆同施少才集长沙",
      "content": [
        "九月九日今朝是，五里十里正未已。",
        "良辰美景只自美，不如且著黑棋子。",
        "浊醪不贱有如无，黄花新寄绝交书。",
        "三年客里两重九，去年却得登高友。",
        "醉吟岳麓道林间，天风吹帽挂君山。",
        "倒骑蹇馿下绝顶，眼花几落贾谊井。",
        "如今悔狂亦嬾游，不嫌清坐独醒休。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 44920,
      "title": "宿度息",
      "content": [
        "薄云翳佳月，风为作金篦。",
        "我行以事役，云行亦忙为。",
        "如何今夕寒，只与客子期。",
        "忘情岂我辈，能禁秋兴悲。",
        "短檠不解事，唤我哦新诗。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 44921,
      "title": "晓泊舟庙山",
      "content": [
        "平水长先晓，无风也自涛。",
        "烟昏山易远，岸阔树难高。",
        "去雁鸣相报，游鱼冷总逃。",
        "轻寒容可忍，清眺得辞劳。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 44922,
      "title": "到龙山头",
      "content": [
        "影静长安道，凉风响辔衔。",
        "海天低到水，江日晚明帆。",
        "潮遣先驱壮，声吞绝岛巉。",
        "黄尘征袖满，却愧著朝衫。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 44923,
      "title": "见澹庵胡先生舍人",
      "content": [
        "澹翁家近醉翁家，二老风流莫等差。",
        "黄帽朱耶饱烟雨，白头紫禁判鶑花。",
        "补天老手何须石，行地新堤早著沙。",
        "三岁别公千里见，端能解榻瀹春芽。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 44924,
      "title": "为王监簿先生求近诗",
      "content": [
        "林下诗中第一仙，西风吹到日轮边。",
        "杜陵野客还惊市，国子先生小著鞭。",
        "拈出老谋开宇宙，本来清尚只云泉。",
        "新篇未许儿童诵，但得真传敢浪传。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 44925,
      "title": "宿徐元达小楼",
      "content": [
        "楼迥眠曾著，秋寒夜更加。",
        "市声先晓动，窗月傍人斜。",
        "役役名和利，憧憧马又车。",
        "如何泉石耳，禁得许諠哗。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 44926,
      "title": "赠相士蓑衣道人杜需二首  其一",
      "content": [
        "与子生疎有底仇，谈间容易说封侯。",
        "病身更遣冰山倚，野鹤孤云也替愁。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 44927,
      "title": "赠相士蓑衣道人杜需二首  其二",
      "content": [
        "坐来小歇过眉拄，客里那能满眼酤。",
        "肯脱蓑衣借侬著，鸥边雨外且江湖。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 44928,
      "title": "跋马公弼省干出示山谷草圣浣花醉图歌",
      "content": [
        "涪翁浣花醉图歌，歌词自作复自写。",
        "少陵无人张颠死，此翁奄有二子者。",
        "不论钗股与锥沙，更数旱蛟及惊蛇。",
        "诗仙不合兼草圣，鬼妬天嗔教薄命。",
        "人言爱书缘爱贤，紫眉未必胜青编。",
        "旧时鬼门关外客，如今一字抵尺璧，何须千载空相忆。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 44929,
      "title": "送王监簿民瞻南归",
      "content": [
        "潮头打云云不留，月波泼窗窗欲流。",
        "夜寒报晴岂待晓，天公端为卢溪老。",
        "卢溪在山不知年，卢溪出山即日还。",
        "黄纸苦催得高卧，青霞成癖谁能那。",
        "诏谓先生式国人，掉头已复烟林深。",
        "路旁莫作两疎看，老儒不用橐中金。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 44930,
      "title": "澹庵坐上观显上人分茶",
      "content": [
        "分茶何似煎茶好，煎茶不似分茶巧。",
        "蒸水老禅弄泉手，隆兴元春新玉爪。",
        "二者相遭兔瓯面，怪怪奇奇真善幻。",
        "纷如擘絮行太空，影落寒江能万变。",
        "银瓶首下仍尻高，注汤作字势嫖姚。",
        "不须更师屋漏法，只问此瓶当响答。",
        "紫微仙人乌角巾，唤我起看清风生。",
        "京尘满袖思一洗，病眼生花得再明。",
        "汉鼎难调要公理，策勋茗椀非公事。",
        "不如回施与寒儒，归续茶经传衲子。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 44931,
      "title": "谢赵茂甫惠浙曹中笔蜀越薄牋二首  其一",
      "content": [
        "公子平生无长物，几研生涯敌玉冰。",
        "二妙端能并送似，便呼毛颖试谿藤。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 44932,
      "title": "谢赵茂甫惠浙曹中笔蜀越薄牋二首  其二",
      "content": [
        "百楮先生十兔尖，心知奇绝敢言贪。",
        "诗无好语书仍俗，喜气多多抵得惭。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 44933,
      "title": "和马公弼夜雨",
      "content": [
        "一雨未辞泥至腰，新寒疠气喜全消。",
        "都人得此正希阔，远客幡然成寂寥。",
        "声在疎簷与黄叶，梦听禁漏近丹霄。",
        "愁心却被诗勾引，始觉君家我里遥。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 44934,
      "title": "再和错综其韵",
      "content": [
        "家书希到恐缘遥，岂有全无雁拂霄。",
        "屈指大刀违破镜，负渠缩项及长腰。",
        "何当竹外扁舟去，趁取梅梢未雪消。",
        "頼有可人同舍客，破愁得句似参寥。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 44935,
      "title": "和赵彦德旅怀是夕渠诵诗鼓琴",
      "content": [
        "客间眼暗可逢人，公子诗琴却有神。",
        "频掉乌纱知得句，快挥绿绮更留尘。",
        "飘零不问今何夕，邂逅相欢意便亲。",
        "作许生涯浑不恶，只愁我辈转须贫。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 44936,
      "title": "至日前思亲",
      "content": [
        "节近亲庭远，天寒日暮时。",
        "未风窗已报，欲雪脚先知。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 44937,
      "title": "和汤叔度雪",
      "content": [
        "道得闲来尽未闲，颇缘幽事搅心间。",
        "卧听雪作披衣起，不待天明带月看。",
        "更觉梅枝殊摘索，只惊蓬鬓却羁单。",
        "飞花岂解知人意，风里时时戏作团。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 44938,
      "title": "和马公弼雪",
      "content": [
        "洒竹穿梅湖更山，客间得此未嫌寒。",
        "髯疎也被轻轻点，齿冷犹禁细细餐。",
        "晴了还成三日冻，销余留得半庭看。",
        "凭谁说似王郎妇，盐絮吟来总未安。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 44939,
      "title": "中书胡舍人玉堂夜直用万里所和汤君雪韵和寄逆旅再和谢焉",
      "content": [
        "紫禁仙人视草闲，宫云低到绮疏间。",
        "玉妃为作回风舞，金炬高烧带笑看。",
        "得句却嫌椽笔小，冲泥遣慰客毡单。",
        "夜哦妙语锵鸾鹤，不觉梅梢霁日团。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 44940,
      "title": "和符君俞卜邻",
      "content": [
        "朱崖柳色欲春风，庾岭梅花尚雪容。",
        "念子南归骑瘦马，只今谁解好真龙。",
        "吾乡端是山水窟，何日来同丘壑胸。",
        "白鹭青原不妨拣，诛茅结屋看何从。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 44941,
      "title": "引见前一夕寓宿徐元达小楼元达招符君俞胡季永小集走笔和君俞韵",
      "content": [
        "主宾呼酒卷沧溟，我亦何人与德星。",
        "高阁连云压潮白，前山倒影入杯青。",
        "细哦秀句清无底，匹似疎梅寒更馨。",
        "不惜坐间作颓玉，只愁宫漏又须听。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 44942,
      "title": "同君俞季永步至普济寺晚泛西湖以归得四绝句  其一",
      "content": [
        "阁日微阴不碍晴，杖藜小倦且须行。",
        "湖山有意留侬款，约束疎钟未要声。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 44943,
      "title": "同君俞季永步至普济寺晚泛西湖以归得四绝句  其二",
      "content": [
        "烟艇横斜柳港湾，云山出没柳行间。",
        "登山得似游湖好，却是湖心看尽山。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 44944,
      "title": "同君俞季永步至普济寺晚泛西湖以归得四绝句  其三",
      "content": [
        "西湖虽老为人容，不必花时十里红。",
        "卷取郭熙真水墨，枯荷折苇小霜风。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 44945,
      "title": "同君俞季永步至普济寺晚泛西湖以归得四绝句  其四",
      "content": [
        "曲曲都城缭翠微，鳞鳞湖浪动斜晖。",
        "天寒日暮游人少，两岸轻舟星散归。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 44946,
      "title": "同岳大用甫抚干雪后游西湖早饭显明寺步至四圣观访林和靖故居观鹤听琴得四绝句时去除夕二日  其一",
      "content": [
        "湖暖开冰已借春，山晴留雪要娱人。",
        "昨游未当清奇在，踏冻重来眼却新。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 44947,
      "title": "同岳大用甫抚干雪后游西湖早饭显明寺步至四圣观访林和靖故居观鹤听琴得四绝句时去除夕二日  其二",
      "content": [
        "紫陌微干未放尘，青鞋不惜涴泥痕。",
        "春风已入寒蒲节，残雪犹依古柳根。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 44948,
      "title": "同岳大用甫抚干雪后游西湖早饭显明寺步至四圣观访林和靖故居观鹤听琴得四绝句时去除夕二日  其三",
      "content": [
        "冰壶底里步金沙，真到林逋处士家。",
        "未办寒泉荐秋菊，且将瘦句了梅花。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 44949,
      "title": "同岳大用甫抚干雪后游西湖早饭显明寺步至四圣观访林和靖故居观鹤听琴得四绝句时去除夕二日  其四",
      "content": [
        "道堂高绝俯空明，上下跻攀取意行。",
        "浄阁虚廊人寂寂，鹤声断处忽琴声。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 44950,
      "title": "甲申上元前闻家君不快西归见梅有感二首  其一",
      "content": [
        "官路桐江西复西，野梅千树压疎篱。",
        "昨来都下筠篮底，三百青钱买一枝。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 44951,
      "title": "甲申上元前闻家君不快西归见梅有感二首  其二",
      "content": [
        "千里来为五斗谋，老亲望望且归休。",
        "春光尽好关侬事，细雨梅花只做愁。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 44952,
      "title": "晚春行田南原",
      "content": [
        "西畴前日尘作雾，南村今日波生路。",
        "云子从来疎广文，冲雨学稼当辞勤。",
        "农言秧好殊胜麦，其如绿针未堪吃。",
        "吾生十指不拈泥，毛锥便得傲蓑衣。",
        "只愿边头长无事，把耒耕云且吾志。",
        "不愁官马送还官，借牛骑归不用鞍。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 44953,
      "title": "闻鶑",
      "content": [
        "过雨溪山浄，新晴花柳明。",
        "来穿两好树，别作一家声。",
        "故欲撩诗兴，仍添怀友情。",
        "惊飞苦难见，那更绿阴成。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 44954,
      "title": "初夏日出且雨",
      "content": [
        "笑忆唐人句，无晴还有晴。",
        "斜阳白鸥影，疎雨子规声。",
        "台阁非吾事，溪山且此生。",
        "诗成何用好，诗好却难成。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 44955,
      "title": "和文远以作醮相疎",
      "content": [
        "涉夏天勤雨，今年定有秋。",
        "试思冲热出，何似带泥游。",
        "轩冕关庄子，江湖著魏牟。",
        "高人香火里，也到酒边不。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 44956,
      "title": "族叔祖彦通所居宛在水中央名之曰小蓬莱为作长句",
      "content": [
        "侬爱南溪不减公，南溪亲公却疎侬。",
        "为侬只作一两曲，为公绕尽云边屋。",
        "屋后有竹前有花，断桥才整已半斜。",
        "客来不恶去亦好，莫将汗脚涴瑶草。",
        "俗子只道无蓬莱，请渠且洗睫上埃。",
        "蓬莱不大亦不小，作诗示公公一笑。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 44957,
      "title": "彦通以诗送石菖蒲和谢之",
      "content": [
        "笑拂孤芳旋汲泉，忽如身堕晓霜天。",
        "一生寒瘦知何用，只得清名垂万年。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 44958,
      "title": "清晓出城别王宣子舍人",
      "content": [
        "月细惟愁落，阳升未要忙。",
        "出门鸡未觉，夹路稻初香。",
        "涉世宁容嬾，侵星幸稍凉。",
        "病来诗久废，觅句费商量。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 44959,
      "title": "送王吉州宣子舍人知明州二首  其一",
      "content": [
        "满听除书好，明州胜吉州。",
        "又为邦伯去，政坐治声优。",
        "过阙端能遇，居中定作留。",
        "新民莫漫喜，竹马不须休。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 44960,
      "title": "送王吉州宣子舍人知明州二首  其二",
      "content": [
        "碧海翻词笔，清霜逼谊风。",
        "不应盛名下，未著玉堂中。",
        "剩欲公留此，其如帝望公。",
        "从今摩病眼，看到火城红。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 44961,
      "title": "题王宣子新作吉州学前咏归亭",
      "content": [
        "使君见处我何言，且上斯亭一笑还。",
        "便有醒然新气象，何曾改却旧江山。",
        "咏归风味谁知点，克己工夫未减颜。",
        "个里诸生高著眼，仕和不仕得相关。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 44962,
      "title": "夜同文远祷雨老冈祠",
      "content": [
        "秋热常年无此例，今宵有月不能凉。",
        "槁苗似妬诗人嬾，作意催成祷雨章。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 44963,
      "title": "霜露",
      "content": [
        "落照红犹剩，初星白未真。",
        "霜威能夺月，寒力故欺人。",
        "哀雁知谁怨，吟蛩独我亲。",
        "老来忧患里，忍泪已霑巾。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 44964,
      "title": "理蔬",
      "content": [
        "小摘吾犹惜，频来迳自成。",
        "青虫捕仍有，蠹叶病还生。",
        "贫里犹存灶，霜余正可羹。",
        "窥园未妨学，抱瓮更须营。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 44965,
      "title": "送傅山人二绝句  其一",
      "content": [
        "江山有约未应疎，浪自忙中白却须。",
        "我昔属官今属我，子能略伴瘦藤无。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 44966,
      "title": "送傅山人二绝句  其二",
      "content": [
        "谈天渠外更谁先，聊复怜渠与酒钱。",
        "富贵不愁天不管，不应丘壑也关天。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 44967,
      "title": "悯农",
      "content": [
        "稻云不雨不多黄，荞麦空花早著霜。",
        "已分忍饥度残岁，更堪岁里闰添长。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 44968,
      "title": "绝句",
      "content": [
        "枫老颜方少，山晴气反昏。",
        "旧贫今更甚，已冷幸犹暄。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 44969,
      "title": "故少师张魏公挽词三章  其一",
      "content": [
        "出昼民犹望，回军敌尚疑。",
        "时非不吾以，天未胜人为。",
        "自别知何恙，从谁话许悲。",
        "一生长得忌，千载却空思。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 44970,
      "title": "故少师张魏公挽词三章  其二",
      "content": [
        "手麾日三舍，身驭月重轮。",
        "始是岷峨秀，前无社稷臣。",
        "向来元破斧，何用更洪钧。",
        "只使江淮草，明年不作春。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 44971,
      "title": "故少师张魏公挽词三章  其三",
      "content": [
        "读易堂边路，曾闻赤舄声。",
        "心从画前到，身在易中行。",
        "忧国何缘寿，思亲岂欲生。",
        "不应永州月，犹傍两窗明。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 44972,
      "title": "和周仲觉三首  其一",
      "content": [
        "书嬾聊遮眼，诗穷只掉头。",
        "寒醒非不睡，薄醉奈何愁。",
        "火细霜还重，风停叶自投。",
        "半生灾疾里，谁遣未休休。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 44973,
      "title": "和周仲觉三首  其二",
      "content": [
        "月淡犹明树，霜严不剩云。",
        "天寒一雁叫，夜半几人闻。",
        "诗只令吾瘦，清聊与子分。",
        "频来仍恨少，此去更离群。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 44974,
      "title": "和周仲觉三首  其三",
      "content": [
        "春在梅边动，寒从月外来。",
        "贫于萤不暖，心与烛俱灰。",
        "此意悠悠著，从谁细细开。",
        "病来更忧患，泪尽只余哀。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 44975,
      "title": "雪用欧阳公白战律仍禁用映雪访戴等故事赋三首示同社  其一",
      "content": [
        "夜映非真晓，山明不觉遥。",
        "尽寒无奈爽，且落未须销。",
        "体怯心仍爱，颜衰酒强潮。",
        "毛锥自堪战，寸铁亦何消。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 44976,
      "title": "雪用欧阳公白战律仍禁用映雪访戴等故事赋三首示同社  其二",
      "content": [
        "是雨还堪拾，非花却解飞。",
        "儿童最无頼，抟弄肯言归。",
        "向树翻投竹，欺人故点衣。",
        "肩寒未妨耸，笔冻可能挥。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 44977,
      "title": "雪用欧阳公白战律仍禁用映雪访戴等故事赋三首示同社  其三",
      "content": [
        "细听无仍有，贪看立又行。",
        "落时晨却暗，积处夜还明。",
        "幸自漫山好，何如到夏清。",
        "似知吾党意，未遣日华晴。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 44978,
      "title": "刘公佐亲家奉议挽词二首  其一",
      "content": [
        "已病身犹健，云瘳讣却闻。",
        "告存非不寿，有子更能文。",
        "嗟我何多难，丧亲又哭君。",
        "两家两翁好，作么并丘坟。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 44979,
      "title": "刘公佐亲家奉议挽词二首  其二",
      "content": [
        "一命华其老，诸昆半作官。",
        "相高仍孝悌，不但盛衣冠。",
        "近别那云诀，临丧独忍看。",
        "心知公不恨，我自泪难干。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 44980,
      "title": "送卢山人二首  其一",
      "content": [
        "行尽千山又万山，山真何好子能然。",
        "青乌纵妙侬曾问，著眼烟云也自贤。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 44981,
      "title": "送卢山人二首  其二",
      "content": [
        "有欠牛眠子为寻，剩将朽胔换华簪。",
        "家阡只免牛羊到，此外穷通得上心。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 44982,
      "title": "往安福宿代度寺",
      "content": [
        "春前腊后暖还寒，陌上泥中湿更干。",
        "野寺鸣钟招我宿，远峰留雪待谁看。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 44983,
      "title": "归途轿中读参寥诗",
      "content": [
        "车中无作惟生睡，卷里何佳却胜闲。",
        "会意贪看三五句，回头悔失数重山。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 44984,
      "title": "挽封州太守赵次公二首  其一",
      "content": [
        "国尔怀孤愤，麟兮嗣古风。",
        "谓宜空冀北，何意召河东。",
        "榕叶烝山祲，梨花惨殡宫。",
        "传家今有子，身后未应穷。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 44985,
      "title": "挽封州太守赵次公二首  其二",
      "content": [
        "雁峰三径古，融水贰车新。",
        "自此相从后，还成永别晨。",
        "只今耆旧传，谁是老成人。",
        "剩欲书遗德，心悲语不真。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 44986,
      "title": "和元举叔见谢载酒之韵二首  其一",
      "content": [
        "雪久自消犹半在，雨来正密更无休。",
        "硬黄字里真添瘦，重碧杯中且避愁。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 44987,
      "title": "和元举叔见谢载酒之韵二首  其二",
      "content": [
        "南溪溪北北山边，风月公何得独专。",
        "挈榼惭无桑落酒，赠诗如得汉阴鳊。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 44988,
      "title": "雪后晚晴四山皆青惟东山全白赋最爱东山晴后雪二绝句  其一",
      "content": [
        "只知逐胜忽忘寒，小立春风夕照间。",
        "最爱东山晴后雪，软红光里涌银山。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 44989,
      "title": "雪后晚晴四山皆青惟东山全白赋最爱东山晴后雪二绝句  其二",
      "content": [
        "群山雪不到新晴，多作泥融少作冰。",
        "最爱东山晴后雪，却愁宜看不宜登。"
      ],
