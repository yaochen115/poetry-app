{
  "data": [
    {
      "id": 258497,
      "title": "赋得寒云轻重色送子恂入京",
      "content": [
        "无限寒云色，苍茫浅更深。",
        "从龙如有瑞，捧日不成阴。",
        "积翠全低岭，虚明半出林。",
        "帝乡遥在目，铁马又骎骎。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 258498,
      "title": "赋得丛兰曙后色送梁侍御人京",
      "content": [
        "曙色传芳意，分明锦绣丛。",
        "兰生齐后日，花发夜来风。",
        "不向三峰里，全胜一县中。",
        "遥知大苑内，应待五花骢。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 258499,
      "title": "赋得余冰",
      "content": [
        "晓日余冰上，春池一镜明。",
        "多从履处薄，偏向饮时清。",
        "比雪光仍在，因风片不成。",
        "更随舟楫去，犹可助坚贞。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 258500,
      "title": "赋得浦口望斜月送皇甫判官",
      "content": [
        "起见西楼月，依依向浦斜。",
        "动摇生浅浪，明灭照寒沙。",
        "水渚犹疑雪，梅林不辨花。",
        "送君无可赠，持此代瑶华。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 258501,
      "title": "赋得绵绵思远道送岑判官入岭",
      "content": [
        "极目烟霞外，孤舟一使星。",
        "兴中寻白雪，梦里过沧溟。",
        "夜月松江戍，秋风竹坞亭。",
        "不知行远近，芳草日青青。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 258502,
      "title": "江宁春夜裴使君席送萧员外",
      "content": [
        "花院日扶疎，江云自卷舒。",
        "主人熊轼任，归客稚门车。",
        "曙月稀星里，春烟紫禁余。",
        "行看石头戍，记得是南徐。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 258503,
      "title": "送薛八谪居",
      "content": [
        "东水将孤客，南行路几千。",
        "虹翻潮上雨，鸟落瘴中天。",
        "谪去宁留恨，思归岂待年。",
        "衔杯且一醉，别泪莫潸然。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 258504,
      "title": "送衡阳归客",
      "content": [
        "归客爱鸣榔，南征忆旧乡。",
        "江山追宋玉，云雨忆荆王。",
        "醉里宜城近，歌中郢路长。",
        "怜君从此去，日夕望三湘。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 258505,
      "title": "送员外侍御入朝",
      "content": [
        "别思乱无绪，妖氛犹未清。",
        "含香五夜客，持赋十年兄。",
        "霜拂金波树，星回玉斗城。",
        "自怜江上鹤，垂翅羡飞鸣。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 258506,
      "title": "送李谏议归荆州",
      "content": [
        "归舟同不系，纤草剩忘忧。",
        "禁掖曾通籍，江城旧列侯。",
        "暮帆依夏口，春雨梦荆州。",
        "何日朝云陛，随君拜冕旒。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 258507,
      "title": "送元中丞江淮转运",
      "content": [
        "薄税归天府，轻徭赖使臣。",
        "欢霑赐帛老，恩及卷绡人。",
        "去问殊官俗，来经几劫春。",
        "东南御亭上，莫问有风尘。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 258508,
      "title": "送唐别驾赴郢州",
      "content": [
        "少年从事好，此去别愁轻。",
        "满座诗人兴，随君郢路行。",
        "蒹葭侵驿树，云水抱山城。",
        "遥爱下车日，江臯春草生。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 258509,
      "title": "送郑巨及第后归觐",
      "content": [
        "多才白华子，初擅桂枝名。",
        "嘉庆送归客，新秋带雨行。",
        "离人背水去，喜鹊近家迎。",
        "别赠难为此，衰年畏后生。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 258510,
      "title": "宿远上人兰若",
      "content": [
        "香花闭一林，真士此看心。",
        "行道白云近，然灯翠壁深。",
        "梵筵清水月，禅坐冷山阴。",
        "更说东溪好，明朝乘兴寻。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 258511,
      "title": "酬元秘书晚出蓝溪见寄",
      "content": [
        "野兴引才子，独行幽径迟。",
        "云留下山处，鸟静出溪时。",
        "拙宦不忘隐，归休常在兹。",
        "知音倘相访，炊黍扫茅茨。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 258512,
      "title": "别张起居",
      "content": [
        "有别时留恨，销魂况在今。",
        "风涛初振海，鹓鹭各辞林。",
        "旧国关河绝，新秋草露深。",
        "陆机婴世网，应负故山心。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 258513,
      "title": "郭司徒厅夜宴",
      "content": [
        "秋堂复夜阑，举目尽悲端。",
        "霜堞鸟声苦，更楼月色寒。",
        "美人深别意，斗酒少留欢。",
        "明发将何赠，平生双玉盘。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 258514,
      "title": "初至京口示诸弟",
      "content": [
        "还家百战后，访故几人存。",
        "兄弟得相见，荣枯何处论。",
        "新诗添卷轴，旧业见儿孙。",
        "点检平生事，焉能出荜门。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 258515,
      "title": "月下洗药",
      "content": [
        "汲井向新月，分流入众芳。",
        "湿花低桂影，翻叶静泉光。",
        "露下添余润，蜂惊引暗香。",
        "寄言养生客，来此共提筐。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 258516,
      "title": "晚春永宁墅小园独坐寄上王相公",
      "content": [
        "东阁一何静，莺声落日愁。",
        "夔龙暂为别，昏旦思兼秋。",
        "蕙草出篱外，花枝寄竹幽。",
        "上方传雅颂，七夕让风流。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 258517,
      "title": "岁暇题茅茨",
      "content": [
        "谷口逃名客，归来遂野心。",
        "薄田供岁酒，乔木待新禽。",
        "溪路春云重，山厨夜火深。",
        "桃源应渐好，仙客许相寻。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 258518,
      "title": "九日登玉山",
      "content": [
        "霞景青山上，谁知此胜游。",
        "龙沙传往事，菊酒对今秋。",
        "步石随云起，题诗向水流。",
        "忘归更有处，松下片云幽。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 258519,
      "title": "宴崔驸马玉山别业",
      "content": [
        "金榜开青琐，骄奢半隐沦。",
        "玉箫惟送酒，罗袖爱留宾。",
        "竹馆烟催瞑，梅园雪误春。",
        "满朝辞赋客，尽是入林人。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 258520,
      "title": "春谷幽居",
      "content": [
        "黄鸟鸣园柳，新阳改旧阴。",
        "春来此幽兴，宛是谢公心。",
        "扫迳兰芽出，添池山影深。",
        "虚名随振鹭，安得久栖林。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 258521,
      "title": "赋得池上双丁香树",
      "content": [
        "得地移根远，交柯遶指柔。",
        "露香浓结桂，池影鬬蟠虬。",
        "黛叶轻筠绿，金花笑菊秋。",
        "何如南海外，雨露隔炎洲。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 258522,
      "title": "题樊川杜相公别业",
      "content": [
        "数亩园林好，人知贤相家。",
        "结茅书阁俭，带水槿篱斜。",
        "古树生春藓，新荷卷落花。",
        "圣恩加玉铉，安得卧青霞。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 258523,
      "title": "酬卢十一过宿",
      "content": [
        "乞还方未遂，日夕望云林。",
        "况复逢青草，何妨问此心。",
        "闭门公务散，枉策故情深。",
        "遥夜他乡宿，同君梁甫吟。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 258524,
      "title": "崔十四宅问候",
      "content": [
        "晓日早莺啼，江城旅思迷。",
        "微官同寄傲，移疾阻招携。",
        "远水闾阎内，青山稚堞西。",
        "王孙莫久卧，春草欲萋萋。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 258525,
      "title": "山路见梅感而有作",
      "content": [
        "莫言山路僻，还被好风催。",
        "行客凄凉过，村篱冷落开。",
        "晚溪寒水照，晴日数蜂来。",
        "重忆江南酒，何因把一杯。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 258526,
      "title": "咏门上画松上元王杜三相公",
      "content": [
        "昔闻生涧底，今见起毫端。",
        "众草此时没，何人知岁寒。",
        "岂能裨栋宇，且欲出门阑。",
        "只在丹青笔，凌云也不难。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 258527,
      "title": "早发东阳",
      "content": [
        "信风催过客，早发梅花桥。",
        "数鴈起前渚，千艘争便潮。",
        "将随浮云去，日惜故山遥。",
        "惆怅烟波末，佳期在碧霄。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 258528,
      "title": "舟中寄李起居",
      "content": [
        "南行风景好，昏旦水臯闲。",
        "春色郢中树，晴霞湖上山。",
        "去家旅帆远，回首暮潮还。",
        "蕙草知何赠，故人云汉间。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 258529,
      "title": "夜雨寄寇校书",
      "content": [
        "秋馆烟雨合，重城钟漏深。",
        "佳期阻清夜，孤兴发离心。",
        "烛影出绡幕，虫声连素琴。",
        "此时蓬阁友，应念昔同衾。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 258530,
      "title": "喜李侍御拜郎官入省",
      "content": [
        "粉署花骢入，丹霄紫诰垂。",
        "直庐惊漏近，赐被觉霜移。",
        "汉主前瑶席，穰侯许凤池。",
        "应怜后行鴈，空羡上林枝。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 258531,
      "title": "苏端林亭对酒喜雨",
      "content": [
        "小雨飞林顶，浮凉入晚多。",
        "能知留客处，偏与好风过。",
        "濯锦飜红蕊，跳珠乱碧荷。",
        "芳尊深几许，此兴可酣歌。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 258532,
      "title": "见上林春鴈翔青云寄杨起居李员外",
      "content": [
        "上林春更好，宾鴈不知归。",
        "顾影怜青籞，传声入紫微。",
        "夜陪池鹭宿，朝出苑花飞。",
        "宁忆寒乡侣，鸾凰一见稀。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 258533,
      "title": "偶成",
      "content": [
        "含毫意不浅，微月上帘栊。",
        "门静吏人息，心闲囹圄空。",
        "繁星入疎树，惊鹊倦秋风。",
        "始觉牵卑剧，宵眠亦在公。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 258534,
      "title": "渔潭值雨",
      "content": [
        "日入林岛异，鹤鸣风草间。",
        "孤帆泊枉渚，飞雨来前山。",
        "客意念留滞，川途忽阻艰。",
        "赤亭仍数里，夜待安流还。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 258535,
      "title": "题萧丞小池",
      "content": [
        "莺鸣蕙草绿，朝兴情人期。",
        "林沼忘言处，鸳鸿养翮时。",
        "春泉滋药暖，晴日度花迟。",
        "此会无辞醉，良辰难再追。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 258536,
      "title": "送集贤崔八叔承恩括图书",
      "content": [
        "雨露满儒服，天心知子虚。",
        "还劳五经笥，更访百家书。",
        "赠别倾文苑，光华比使车。",
        "晚云随客散，寒树出关疎。",
        "相见应朝夕，归期在玉除。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 258537,
      "title": "送张五员外东归楚州",
      "content": [
        "缨佩不为美，人群宁免辞。",
        "杳然黄鹄去，未负白云期。",
        "此别清兴尽，高秋临水时。",
        "好山枉帆僻，浪迹到家迟。",
        "他日诏书下，梁鸿安可追。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 258538,
      "title": "闲居寄包何",
      "content": [
        "去名即栖遁，何必归沧浪。",
        "种药幽不浅，杜门喧自忘。",
        "林眠多晓梦，鸦散惊初阳。",
        "片雪幽云至，回风邻果香。",
        "佳期碧天末，惆怅紫兰芳。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 258539,
      "title": "津梁寺寻李侍御",
      "content": [
        "禅林绝过客，柱史正焚香。",
        "驯鸽不猜隼，慈云能护霜。",
        "骢声隔暗竹，吏事散空廊。",
        "霄汉期鸳鹭，狐狸避宪章。",
        "遶堦春色至，屈草待君芳。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 258540,
      "title": "山园秋晚寄杜黄裳少府",
      "content": [
        "惆怅佳期阻，园林秋景闲。",
        "终朝碧云外，唯见暮禽还。",
        "泉石思携手，烟霞不闭关。",
        "杖藜仍把菊，对卷也看山。",
        "望望离心起，非君谁解颜。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 258541,
      "title": "东溪杜野人致酒",
      "content": [
        "万重云树下，数亩子平居。",
        "野院罗泉石，荆扉背里闾。",
        "早冬耕凿暇，弋雁复烹鱼。",
        "静扫寒花径，唯邀傲吏车。",
        "晚来留客好，小雪下山初。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 258542,
      "title": "忆山中寄旧友",
      "content": [
        "数岁白云里，与君同采薇。",
        "树深烟不散，溪静鹭忘飞。",
        "更忆东岩趣，残阳破翠微。",
        "脱巾花下醉，洗药月前归。",
        "风景今还好，如何与世违。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 258543,
      "title": "东臯早春寄郎四校书",
      "content": [
        "禄微赖学稼，岁起归衡茅。",
        "穷达恋明主，耕桑亦近郊。",
        "夜来霁山雪，阳气动林梢。",
        "兰蕙暖初吐，春鸠鸣欲巢。",
        "蓬莱时入梦，知子忆贫交。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 258544,
      "title": "玉山东溪题李叟屋壁",
      "content": [
        "霞景已斜照，烟溪方暝投。",
        "山家归路僻，辙迹乱泉流。",
        "野老采薇暇，蜗庐招客幽。",
        "麏麚突荒院，鸬鹊步闲畴。",
        "偶此惬真性，令人轻宦游。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 258545,
      "title": "温泉宫礼见",
      "content": [
        "新丰佳气满，圣主在温泉。",
        "云暧龙行处，山明日驭前。",
        "顺风求至道，侧席问遗贤。",
        "灵雪瑶墀降，晨霞彩仗悬。",
        "沧溟不让水，疵贱也朝天。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 258546,
      "title": "游襄阳泉石晚归",
      "content": [
        "游目随山胜，回桡爱浦长。",
        "往来幽不浅，昏旦兴难忘。",
        "木末看归翼，莲西失夕阳。",
        "人声指闾井，野趣惜林塘。",
        "稍近垂杨路，菱舟拥岸香。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 258547,
      "title": "夏日陪史郎中宴杜郎中果园",
      "content": [
        "何事重逢迎，春醪晚更清。",
        "林端花自老，池上月初明。",
        "路入仙郎次，乌连柱史名。",
        "竹阴疎柰院，山翠傍芜城。",
        "引满不辞醉，风来待曙更。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 258548,
      "title": "南溪春耕",
      "content": [
        "荷蓑趣南迳，戴胜鸣条枚。",
        "溪雨有余润，土膏宁厌开。",
        "沟塍落花尽，耒耜度云回。",
        "谁道耦耕倦，仍兼胜赏催。",
        "日长农有暇，悔不带经来。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 258549,
      "title": "省试湘灵鼓瑟",
      "content": [
        "善鼓云和瑟，常闻帝子灵。",
        "冯夷空自舞，楚客不堪听。",
        "苦调凄金石，清音入杳冥。",
        "苍梧来怨慕，白芷动芳馨。",
        "流水传潇浦，悲风过洞庭。",
        "曲终人不见，江上数峰青。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 258550,
      "title": "观法驾自凤翔回",
      "content": [
        "欃枪一扫灭，阊阖九重开。",
        "海晏鲸鲵尽，天旋日月来。",
        "圣情苏品物，龙御辟云雷。",
        "晓漏移仙仗，朝阳出帝台。",
        "周惭散马出，禹让濬川回。",
        "欲识封人愿，南山举酒杯。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 258551,
      "title": "题玉山村叟屋壁",
      "content": [
        "谷口好泉石，居人能陆沈。",
        "牛羊下山小，烟火隔云深。",
        "一迳入溪色，数家连竹阴。",
        "藏虹辞晚雨，惊隼落残禽。",
        "涉趣皆流目，将归羡在林。",
        "却思黄绶事，辜负紫芝心。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 258552,
      "title": "县中池竹言怀",
      "content": [
        "官小志已足，时清免负薪。",
        "卑栖且得地，荣耀不关身。",
        "自爱赏心处，丛篁流水滨。",
        "荷香度高枕，山色满南邻。",
        "道在即为乐，机忘宁厌贫。",
        "却愁丹凤诏，来访漆园人。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 258553,
      "title": "山园栖隐",
      "content": [
        "守静信推分，灌园乐在兹。",
        "且忘尧舜力，宁顾尚书期。",
        "晚景采兰暇，空林散帙时。",
        "卷荷藏露滴，黄口触虫丝。",
        "三径与嚣远，一瓢常自怡。",
        "情人半云外，风月讵相思。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 258554,
      "title": "送王谏议任东都居守",
      "content": [
        "车徒凤掖东，去去洛阳宫。",
        "暂以青蒲隔，还看紫禁同。",
        "经过乘雨露，潇洒出鸳鸿。",
        "官署名台下，云山旧苑中。",
        "暮天双阙静，秋月九重空。",
        "且喜成周地，诗人播国风。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 258555,
      "title": "送郑书记",
      "content": [
        "决胜无遗策，辞天便起缨。",
        "出身唯殉死，报国且能兵。",
        "受命麒膦殿，参谋骠骑营。",
        "短箫催别酒，斜日驻前旌。",
        "义勇千夫敌，风沙万里行。",
        "几年丹阙下，侯印锡书生。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 258556,
      "title": "送族姪赴任",
      "content": [
        "林下不成兴，仲容微禄牵。",
        "客程千里远，别念一帆悬。",
        "欲欢卑栖去，其如胜趣偏。",
        "云山深郡郭，花木净潮田。",
        "坐啸帷应下，离居月复圆。",
        "此时知小阮，相忆绿尊前。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 258557,
      "title": "长安落第作",
      "content": [
        "始愿今如此，前途复若何。",
        "无媒献词赋，生事日蹉跎。",
        "不遇张华识，空悲宁戚歌。",
        "故山归梦远，新岁客愁多。",
        "刷羽思乔木，登龙恨失波。",
        "散才非世用，回音谢云萝。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 258558,
      "title": "酬长孙绎蓝溪寄杏",
      "content": [
        "爱君蓝水上，种杏近成田。",
        "拂迳清阴合，临流彩实悬。",
        "清香和宿雨，佳色出晴烟。",
        "懿此倾筐赠，想知怀橘年。",
        "芳馨来满袖，琼玖愿詶篇。",
        "把玩情何极，云林若眼前。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 258559,
      "title": "药堂秋暮",
      "content": [
        "隐来未得道，岁去媿云松。",
        "茅屋空山暮，荷衣白露浓。",
        "唯怜石苔色，不染世人踪。",
        "潭静宜孤鹤，山深绝远钟。",
        "有时丹灶上，数点彩霞重。",
        "勉事壶公术，仙期待赤龙。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 258560,
      "title": "哭常徴君",
      "content": [
        "万化一朝尽，穷泉悲此君。",
        "如何丹灶术，能误紫芝焚。",
        "不遂苍生望，空留封禅文。",
        "远年随逝水，真气尽浮云。",
        "山闭龙蛇蛰，林寒麋鹿群。",
        "伤心载酒地，仙菊为谁薰。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 258561,
      "title": "送鲍中丞赴太原军营",
      "content": [
        "年壮才仍美，时来道易行。",
        "宠兼三独任，威肃贰师营。",
        "将略过南仲，天心寄北京。",
        "云旗临塞色，龙笛出关声。",
        "汉月随霜去，边尘计日清。",
        "渐知王事好，文武用书生。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 258562,
      "title": "奉送刘相公江淮催转运",
      "content": [
        "国用资戎事，臣劳为主忧。",
        "将徴任土贡，更发济川舟。",
        "拥传星还去，过池凤不留。",
        "唯高饮水节，稍浅别家愁。",
        "落叶淮边雨，孤山海上秋。",
        "遥知谢公兴，微月上江楼。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 258563,
      "title": "送李秀才落第游荆楚",
      "content": [
        "翠羽虽成梦，迁莺尚后群。",
        "名逃郄诜策，兴发谢玄文。",
        "昏旦扁舟去，江山几路分。",
        "上潮吞海日，归雁出湖云。",
        "诗思应须苦，猨声莫厌闻。",
        "离居见新月，那得不思君。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 258564,
      "title": "奉陪郭常侍宴浐川山池",
      "content": [
        "掖垣携爱客，胜地赏年光。",
        "向竹过宾馆，寻山到妓堂。",
        "歌声掩金谷，舞态出平阳。",
        "地满簪裾影，花添兰麝香。",
        "莺啼春未老，酒冷日犹长。",
        "安石风流事，须归问省郎。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 258565,
      "title": "寇中送张司马归洛",
      "content": [
        "戎狄寇周日，衣冠适洛年。",
        "客亭新驿骑，归路旧人烟。",
        "吾道将东矣，秋风更飒然。",
        "云愁百战地，树隔两乡天。",
        "旅思蓬飘陌，惊魂雁怯弦。",
        "今朝一尊酒，莫惜醉离筵。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 258566,
      "title": "奉和宣城张太守南亭秋夕怀友",
      "content": [
        "池馆蟪蛄声，梧桐秋露晴。",
        "月临朱戟静，河近画楼明。",
        "卷幔浮凉入，闻钟永夜清。",
        "片云悬曙斗，数雁过秋城。",
        "羽扇扬风暇，瑶琴怅别情。",
        "江山飞丽藻，谢朓让前名。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 258567,
      "title": "过山人所居因寄诸遗补",
      "content": [
        "空谷春云满，愚公晦迹深。",
        "一随玄豹隐，几换绿萝阴。",
        "绝径人稀道，芳荪我独寻。",
        "厨烟住峭壁，酒气出重林。",
        "蝴蝶晴还舞，黄鹂晚暂吟。",
        "所思青琐客，瑶草寄幽心。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 258568,
      "title": "过鸣臯隐者",
      "content": [
        "磻石老红鲜，徴君卧几年。",
        "飞泉出林下，一径过崖巅。",
        "鸡犬逐人静，云霞宜地偏。",
        "终朝数峰胜，不远一壶前。",
        "仲月霁春雨，香风生药田。",
        "丹溪不可别，琼草色芊芊。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 258569,
      "title": "送杨𫓾归隐",
      "content": [
        "悔作扫门事，还吟招隐诗。",
        "今年芳草色，不失故山期。",
        "遥想白云里，采苓春日迟。",
        "溪花藏石径，岩翠带茅茨。",
        "九转莫飞去，三回良在兹。",
        "还嗤茂陵客，贫病老明时。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 258570,
      "title": "酬刘起居卧病见寄",
      "content": [
        "承颜看彩服，不觉别丹墀。",
        "味道能忘病，过庭更学诗。",
        "缭垣多画戟，远岫入书帷。",
        "竹静携琴处，林香让果时。",
        "声同叨眷早，交澹在年衰。",
        "更枉兼金赠，难为继组词。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 258571,
      "title": "陪南省诸公宴殿中李监宅",
      "content": [
        "将门高胜霍，相子宠过韦。",
        "宦贵攀龙后，心倾待士时。",
        "壶觞开雅宴，鸳鹭眷相随。",
        "舞退燕姬曲，歌徴谢朓诗。",
        "晚钟过竹静，醉客出花迟。",
        "莫惜留余兴，良辰不可追。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 258572,
      "title": "山斋读书寄时校书杜叟",
      "content": [
        "日爱蘅茅下，闲观山海图。",
        "幽人自守朴，穷谷也名愚。",
        "倒岭和溪雨，新泉到户枢。",
        "丛兰齐稚子，蟠木老潜夫。",
        "忆戴差过剡，游仙惯入壶。",
        "濠梁时一访，庄叟亦吾徒。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 258573,
      "title": "晚归蓝田旧居",
      "content": [
        "云卷东臯下，归来省故蹊。",
        "泉移怜石在，林长觉原低。",
        "旧里情难尽，前山赏未迷。",
        "引藤看古木，尝酒咒春鸡。",
        "兴与时髦背，年将野老齐。",
        "才微甘引退，应得遂霞栖。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 258574,
      "title": "寄袁州李嘉祐员外",
      "content": [
        "谁谓江山阻，心亲梦想偏。",
        "容辉常在目，离别任经年。",
        "郡国通流水，云霞共远天。",
        "行春莺几啭，迟客月频圆。",
        "雁有归乡羽，人无访戴船。",
        "愿徴黄霸入，相见玉堦前。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 258575,
      "title": "禁闱玩雪寄薛左丞",
      "content": [
        "玄云低禁苑，飞雪满神州。",
        "虚白生台榭，寒光入冕旒。",
        "粉凝宫壁静，乳结洞门幽。",
        "细绕回风转，轻随落羽浮。",
        "怒涛堆砌石，新月孕帘钩。",
        "为报诗人道，丰年颂圣猷。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 258576,
      "title": "春暮过石龟谷题温处士林园",
      "content": [
        "隐几无名老，何年此陆沈。",
        "丘园自得性，婚嫁不婴心。",
        "岁计因山薄，霞栖在谷深。",
        "设罝连草色，晒药背松阴。",
        "触兴云生岫，随耕鸟下林。",
        "搘颐笑来客，头上有朝簪。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 258577,
      "title": "宿毕侍御宅",
      "content": [
        "交情频更好，子有古人风。",
        "晤语清霜里，平生苦节同。",
        "心惟二仲合，室乃一瓢空。",
        "落叶寄秋菊，愁云低夜鸿。",
        "薄寒灯影外，残漏雨声中。",
        "明发南昌去，回看御史骢。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 258578,
      "title": "中书遇雨",
      "content": [
        "济旱惟宸虑，为霖即上台。",
        "云衔七曜起，雨拂九门来。",
        "纶阁飞丝度，龙渠激霤回。",
        "色翻池上藻，香裛鼎前杯。",
        "湘燕皆舒翼，沙鳞岂曝腮。",
        "尺波应万假，虞海载沿洄。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 258579,
      "title": "适楚次徐城",
      "content": [
        "去家随旅雁，几日到南荆。",
        "行迈改乡邑，苦辛淹晦明。",
        "畏途在淫雨，未暮息趋程。",
        "穷木对秋馆，寒鵶愁古城。",
        "迷津坐为客，对酒默含情。",
        "感激念知己，匣中孤劒鸣。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 258580,
      "title": "经李蒙颍阳旧居",
      "content": [
        "同心而早世，天道亦何论。",
        "独有山阳宅，平生永不谖。",
        "青溪引白鸟，流涕吊芳荪。",
        "蔓草入空室，丛篁深毁垣。",
        "旧游还在眼，神理更忘言。",
        "唯见东山月，人亡不去门。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 258581,
      "title": "赠汉阳隐者",
      "content": [
        "当年不出世，知子餐霞人。",
        "乐道复安土，遗荣长隐身。",
        "蘅茅古林曲，秔稻清江滨。",
        "桂棹为渔暇，荷衣御暑新。",
        "欵颜行在役，幽兴惜今晨。",
        "分手天涯去，再来芳杜春。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 258582,
      "title": "巨鱼纵大壑",
      "content": [
        "巨鱼纵大壑，遂性似乘时。",
        "奋跃风生鬣，腾凌浪鼓鳍。",
        "龙摅回地轴，鲲化想天池。",
        "方快吞舟意，尤殊在藻嬉。",
        "倾危嗟幕燕，隐晦诮泥龟。",
        "喻士逢明主，才猷得所施。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 258583,
      "title": "送李九归河北",
      "content": [
        "文武资人望，谋猷简圣情。",
        "南州初卧鼓，东土复维城。",
        "寄重分符去，威仍出阃行。",
        "斗牛移八座，日月送双旌。",
        "别恋瞻天起，仁风应物生。",
        "伫闻收组练，锵玉会承明。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 258584,
      "title": "送丁著作佐台郡",
      "content": [
        "多年金马客，名遂动归轮。",
        "佐郡紫书下，过门朱绶新。",
        "扬舲望海岳，入境背风尘。",
        "水驿偏乘月，梅园别受春。",
        "带经临府吏，鲙鲤待乡人。",
        "始见美高士，逍遥在搢绅。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 258585,
      "title": "送王使君赴太原行营",
      "content": [
        "太白明无象，皇威未戢戈。",
        "诸侯持节钺，千里控山河。",
        "汉驿双旌度，胡沙七骑过。",
        "惊蓬连雁起，牧马入云多。",
        "不卖卢龙塞，能消瀚海波。",
        "须传出师颂，莫奏式微歌。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 258586,
      "title": "送王使君移镇淮南",
      "content": [
        "共许徐方牧，能临河内人。",
        "郡移棠转茂，车至鹿还驯。",
        "吏事嘉师旅，鸳行惜搢绅。",
        "别心倾祖席，愁望尽征轮。",
        "紫诰徴黄晚，苍生借寇频。",
        "愿言青琐拜，早及上林春。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 258587,
      "title": "李四劝为尉氏尉李七勉为开封尉",
      "content": [
        "美政惟兄弟，时人数俊贤。",
        "皇枝双玉树，吏道二梅仙。",
        "自理尧唐俗，唯将礼让传。",
        "采兰花萼聚，就日雁行联。",
        "黄绶俄三载，青云未九迁。",
        "庙堂为宰制，几日试龙泉。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 258588,
      "title": "春夜宴任六昆季宅",
      "content": [
        "际晚绿烟起，入门芳树深。",
        "不才叨下客，喜宴齿诸簪。",
        "夜月仍携妓，清风更在林。",
        "彩毫挥露色，银烛动花阴。",
        "自接通家好，应知待士心。",
        "向隅逢故识，兹夕愿披襟。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 258589,
      "title": "闲居酬张起居见赠",
      "content": [
        "在林非避世，守拙自离群。",
        "弱羽谢风水，穷愁依典坟。",
        "良知不遐弃，新咏独相闻。",
        "能使幽兴苦，坐忘清景曛。",
        "前山带乔木，暮鸟联归云。",
        "向夕野人思，难忘骑省文。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 258590,
      "title": "奉和王相公秋日戏赠元校书",
      "content": [
        "才妙心仍远，名疎迹可追。",
        "清秋闻礼暇，新雨到山时。",
        "胜事唯愁尽，幽寻不厌迟。",
        "弄云怜鹤去，隔水许僧期。",
        "贤相敦高躅，雕龙忆所思。",
        "芙蓉洗清露，愿比谢公诗。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 258591,
      "title": "过杨驸马亭子",
      "content": [
        "衣冠在汉庭，台榭接天成。",
        "彩凤翻箫曲，祥鳣入馆名。",
        "歌钟芳月曙，林嶂碧云生。",
        "乱水归潭净，高花映竹明。",
        "退朝追宴乐，开合醉簪缨。",
        "长袖留嘉客，栖乌下禁城。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 258592,
      "title": "山下别杜少府",
      "content": [
        "把手意难尽，前山日渐低。",
        "情人那忍别，宿鸟尚同栖。",
        "寸晷恋言笑，佳期欲阻暌。",
        "离云愁出岫，去水咽分溪。",
        "庄叟几虚说，杨朱空自迷。",
        "伤心独归路，秋草更萋萋。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 258593,
      "title": "晚出青门望终南别业",
      "content": [
        "能清谢朓思，暂下承明庐。",
        "远山新水下，寒臯微雨余。",
        "更怜归鸟去，宛到卧龙居。",
        "笑指丛林上，闲云自卷舒。",
        "宁心鸣凤日，却意钓璜初。",
        "处贵有余兴，伊周位不如。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 258594,
      "title": "送严士良侍奉詹事南游",
      "content": [
        "疏傅独知止，曾参善爱亲。",
        "江山侍行迈，长幼出嚣尘。",
        "握手想千古，此心能几人。",
        "风光满长陌，草色傍征轮。",
        "日夕望荆楚，莺鸣芳杜新。",
        "渔烟月下浅，花屿水中春。",
        "点翰遥相忆，含情向白苹。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 258595,
      "title": "题秘书王迪城北池亭",
      "content": [
        "子乔来魏阙，明主赐衣簪。",
        "从宦辞人事，同尘即道心。",
        "还追大隐迹，寄此凤城阴。",
        "昨夜新烟雨，池台清且深。",
        "伏泉通粉壁，迸笋出花林。",
        "晚沐常多暇，春醪时独斟。",
        "西南汉宫月，复对绿窗琴。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 258596,
      "title": "过王舍人宅",
      "content": [
        "入门花柳暗，知是近臣居。",
        "大隐心何远，高风物自疎。",
        "翛然静者事，宛得上皇余。",
        "鸡犬偷仙药，儿童授道书。",
        "清吟送客后，微月上城初。",
        "彩笔有新咏，文星垂太虚。",
        "承恩金殿宿，应荐马相如。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
