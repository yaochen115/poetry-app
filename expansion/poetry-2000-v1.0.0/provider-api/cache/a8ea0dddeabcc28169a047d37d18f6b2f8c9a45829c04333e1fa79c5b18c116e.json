{
  "data": [
    {
      "id": 276201,
      "title": "旅夜怀远客",
      "content": [
        "异乡多远情，梦断落江城。",
        "病起慙书癖，贫家负酒名。",
        "过春花自落，竟晓月空明。",
        "独此一长啸，故人天际行。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276202,
      "title": "秋夜櫂舟访李隐君",
      "content": [
        "望月忆披襟，长溪柳半阴。",
        "高斋初酿酒，孤棹远携琴。",
        "犬吠秋山迥，鸡鸣晓树深。",
        "开门更攲枕，谁识野人心。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276203,
      "title": "卧病寄诸公",
      "content": [
        "飞盖集兰堂，清歌遰柏觞。",
        "高城榆柳荫，虚阁芰荷香。",
        "海月秋偏静，山风夜更凉。",
        "自怜书万卷，扶病对萤光。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276204,
      "title": "寓崇圣寺怀李校书",
      "content": [
        "几日卧南亭，卷帘秋月清。",
        "河关初罢梦，池阁更含情。",
        "寒露润金井，高风飘玉筝。",
        "前年共游客，刀笔事戎旌。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276205,
      "title": "秋日行次关西",
      "content": [
        "金风荡天地，关西群木凋。",
        "早霜鸡喔喔，残月马萧萧。",
        "紫陌秦山近，青枫楚树遥。",
        "还同长卿志，题字满河桥。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276206,
      "title": "山居冬夜喜魏扶见访因赠",
      "content": [
        "霜风露叶下，远思独裴回。",
        "夜久草堂静，月明山客来。",
        "遣贫相劝酒，忆字共书灰。",
        "何事清平世，干名待有媒。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276207,
      "title": "喜李诩秀才见访因赠",
      "content": [
        "浙南分首日，谁谓别经时。",
        "路远遥相访，家贫喜见知。",
        "不须辞小酌，更请续新诗。",
        "但得心中劒，酬恩会有期。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276208,
      "title": "晚投慈恩寺呈俊上人",
      "content": [
        "双岩泻一川，十里绝人烟。",
        "古庙阴风地，寒钟暮雨天。",
        "沙虚留虎迹，水滑带龙涎。",
        "不及曹溪侣，空林已夜禅。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276209,
      "title": "行次虎头岩酬寄路中丞",
      "content": [
        "樟亭去已远，来上虎头岩。",
        "滩急水移棹，山回风满帆。",
        "石梯迎雨滑，沙井落潮醎。",
        "何以慰行旅，如公书一缄。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276210,
      "title": "送荔浦蒋明府赴任",
      "content": [
        "路长春欲尽，歌怨酒初酣。",
        "白社莲宫北，青袍桂水南。",
        "驿行盘鸟道，船宿避龙潭。",
        "真得诗人趣，烟霞处处谙。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276214,
      "title": "闻范秀才自蜀游江湖",
      "content": [
        "蜀道下湘渚，客帆应不迷。",
        "江分三峡响，山并九华齐。",
        "秋泊鴈初宿，夜吟猨乍啼。",
        "归时慎行李，莫到石城西。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276215,
      "title": "惜春",
      "content": [
        "花开又花落，时节暗中迁。",
        "无计延春日，可能留少年。",
        "小藂初散蝶，高柳即闻蝉。",
        "繁艳归何处，满山啼杜鹃。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276216,
      "title": "题愁",
      "content": [
        "聚散竟无形，回肠百结成。",
        "古今销不得，离别觉潜生。",
        "降虏将军思，穷秋远客情。",
        "何人更憔悴，落第泣秦京。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276217,
      "title": "鸳鸯",
      "content": [
        "两两戏沙汀，长疑画不成。",
        "锦机争织样，歌曲爱呼名。",
        "好□顾栖息，堪怜泛浅情。",
        "凫鸥皆尔类，唯羡独含情。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276218,
      "title": "闻鴈",
      "content": [
        "带霜南去鴈，夜好宿汀沙。",
        "惊起向何处，高飞极海涯。",
        "入云声渐远，离岳路犹赊。",
        "归梦当时断，参差欲到家。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276219,
      "title": "不寝",
      "content": [
        "到晓不成梦，思量堪白头。",
        "多无百年命，长有万般愁。",
        "世事应难尽，营生卒未休。",
        "莫言名与利，名利是身讐。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276220,
      "title": "宿东横山",
      "content": [
        "孤舟路渐赊，时见碧桃花。",
        "溪雨滩声急，岩风树势斜。",
        "猕猴垂弱蔓，鹳鹤[睡]横槎。",
        "谩向仙林宿，无人[识]阮家。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276221,
      "title": "早行",
      "content": [
        "失枕惊先起，人家半梦中。",
        "闻鸡凭早晏，占斗认西东。",
        "辔湿知行露，衣单觉晓风。",
        "秋阳弄光影，忽吐半林红。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276222,
      "title": "陪郑史君泛舟晚归",
      "content": [
        "南郭望归处，郡楼高卷帘。",
        "平桥低皂盖，曲岸转彤襜。",
        "江晚笙歌促，山晴鼓角严。",
        "羊公莫先醉，清晓月纤纤。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276223,
      "title": "詶殷尧藩",
      "content": [
        "相如愧许询，寥落向溪滨。",
        "竹马儿犹小，荆钗妇惯贫。",
        "独愁忧过日，多病不如人。",
        "莫怪青袍选，长安隐旧春。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276224,
      "title": "赠迁客",
      "content": [
        "无机还得罪，直道不伤情。",
        "微雨昏山色，疎笼闭鹤声。",
        "闲居多野客，高枕见江城。",
        "门外长谿水，怜君又濯缨。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276225,
      "title": "征西旧卒",
      "content": [
        "少年乘勇气，百战过乌孙。",
        "力尽边城难，功加上将恩。",
        "晓风听戍角，残月倚营门。",
        "自说轻生处，金疮有旧痕。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276226,
      "title": "南陵留别段氏兄弟",
      "content": [
        "不知身老大，犹似旧时狂。",
        "为酒游山县，留诗遍草堂。",
        "归期秋未尽，离恨日偏长。",
        "更羡君兄弟，参差鴈一行。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276227,
      "title": "旅中别姪暐",
      "content": [
        "相见又南北，中宵泪满襟。",
        "旅游知世薄，贫别觉情深。",
        "歌管一尊酒，山川万里心。",
        "此身多在路，休诵异乡吟。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276228,
      "title": "松江渡送人",
      "content": [
        "故国今何在，扁舟竟不归。",
        "云移山漠漠，江阔树依依。",
        "晚色千帆落，秋声一鴈飞。",
        "此时兼送客，凭槛欲霑衣。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276229,
      "title": "过鲍溶宅有感",
      "content": [
        "寥落故人宅，重来身已亡。",
        "古苔残墨沼，深竹旧书堂。",
        "秋色馆池静，雨声云木凉。",
        "无因展交道，日暮倍心伤。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276230,
      "title": "金陵怀古",
      "content": [
        "玉树歌残王气终，景阳兵合戍楼空。",
        "松楸远近千官冢，禾黍高低六代宫。",
        "石燕拂云晴亦雨，江豚吹浪夜还风。",
        "英雄一去豪华尽，唯有青山似洛中。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276231,
      "title": "姑苏怀古",
      "content": [
        "宫馆余基辍棹过，黍苗无限独悲歌。",
        "荒台麋鹿争新草，空苑凫鹥占浅莎。",
        "吴岫雨来虚槛冷，楚江风急远帆多。",
        "可怜国破忠臣死，日日东流生白波。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276232,
      "title": "凌歊台",
      "content": [
        "宋祖凌高乐未回，三千歌舞宿层台。",
        "湘潭云尽暮山出，巴蜀雪消春水来。",
        "行殿有基荒荠合，寝园无主野棠开。",
        "百年便作万年计，嵒畔古碑空绿苔。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276233,
      "title": "骊山",
      "content": [
        "闻说先皇醉碧桃，日华浮动郁金袍。",
        "风随玉辇笙歌逈，云卷珠帘劒佩高。",
        "凤驾北归山寂寂，龙旟西幸水滔滔。",
        "贵妃没后巡游少，瓦落宫墙见野蒿。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276234,
      "title": "咸阳城东楼",
      "content": [
        "一上高城万里愁，蒹葭杨柳似汀洲。",
        "溪云初起日沈阁，山雨欲来风满楼。",
        "鸟下绿芜秦苑夕，蝉鸣黄叶汉宫秋。",
        "行人莫问当年事，故国东来渭水流。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276235,
      "title": "京口闲居寄京洛友人",
      "content": [
        "吴门烟月昔同游，枫叶芦花并客舟。",
        "聚散有期云北去，浮沈无计水东流。",
        "一尊酒尽青山暮，千里书回碧树秋。",
        "何处相思不相见，凤城龙阙楚江头。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276236,
      "title": "冬日登越王台怀归",
      "content": [
        "月沈高岫宿云开，万里归心独上来。",
        "河畔雪飞扬子宅，海边花盛越王台。",
        "泷分桂岭鱼难过，瘴近衡峰鴈却回。",
        "乡信渐稀人渐老，只应频看一枝梅。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276237,
      "title": "对雪",
      "content": [
        "云度龙山暗倚城，先飞淅沥引轻盈。",
        "素娥冉冉拜瑶阙，皓鹤纷纷朝玉京。",
        "阴岭有风梅艳散，寒林无月桂华生。",
        "剡溪一醉十年事，忽忆棹回天未明。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276238,
      "title": "送萧处士归缑岭别业",
      "content": [
        "醉斜乌帽髪如丝，曾看仙人一局棋。",
        "宾馆有鱼为客久，乡书无鴈到家迟。",
        "缑山住近吹笙庙，湘水行逢鼓瑟祠。",
        "今夜月明何处宿，九疑云尽碧参差。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276239,
      "title": "与郑二秀才同舟东下洛中亲朋送至景云寺",
      "content": [
        "三十六峰横一川，绿波无路草芊芊。",
        "牛羊晚食铺平地，雕鹗晴飞摩远天。",
        "洛客尽回临水寺，楚人皆逐下江船。",
        "东西未有相逢日，更把繁华共醉眠。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276240,
      "title": "长安岁暮",
      "content": [
        "独望天门倚劒歌，干时无计老关河。",
        "东归万里慙张翰，西上四年羞卞和。",
        "花暗楚城春醉少，月凉秦塞夜愁多。",
        "三山岁岁有人去，唯恐海风生白波。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276241,
      "title": "赠茅山高拾遗",
      "content": [
        "谏猎归来绮季歌，大茅峰影满秋波。",
        "山斋留客扫红叶，野艇送僧披绿莎。",
        "长覆旧图棋势尽，遍添新品药名多。",
        "云中黄鹄日千里，自宿自飞无网罗。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276242,
      "title": "李秀才近自涂口迁居新安适枉缄书见寛悲戚因以此答",
      "content": [
        "远书开罢更依依，晨坐高台竟落晖。",
        "颜巷雪深人已去，庾楼花盛客初归。",
        "东堂望绝迁莺起，南国哀余候鴈飞。",
        "今日劳君犹问讯，一官唯长故山薇。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276243,
      "title": "赠萧兵曹先辈",
      "content": [
        "广陵堤上昔离居，帆转潇湘万里余。",
        "楚客病时无𫛳鸟，越乡归处有鲈鱼。",
        "潮生水郭蒹葭响，雨过山城橘柚疎。",
        "闻说携琴兼载酒，邑人争识马相如。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276244,
      "title": "题舒女庙",
      "content": [
        "山乐来迎去不言，庙前高柳水禽喧。",
        "绮罗无色雨侵帐，珠翠有声风绕幡。",
        "妆镜尚疑山月满，寝屏犹认野花繁。",
        "孤舟梦断行云散，何限离心寄晓猨。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276245,
      "title": "姑孰官舍",
      "content": [
        "草生官舍似闲居，雪照南窗满素书。",
        "贫后始知为吏拙，病来还喜识人疎。",
        "青云岂有窥梁燕，浊水应无避钓鱼。",
        "不待秋风便归去，紫阳山下是吾庐。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276246,
      "title": "凌歊台送韦秀才",
      "content": [
        "云起高台日未沈，数村残照半岩阴。",
        "野蚕成茧桑柘尽，溪鸟引雏蒲稗深。",
        "帆势依依投极浦，钟声[杳杳]隔前林。",
        "故山迢遰故人去，一夜月明千里心。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276247,
      "title": "送岭南卢判官罢职归华阴山居",
      "content": [
        "曾事刘琨鴈塞空，十年书劒任飘蓬。",
        "东堂旧屈移山志，南国新留煮海功。",
        "还挂一帆青海上，更开三迳碧莲中。",
        "关西旧友如相问，已许沧浪伴钓翁。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276248,
      "title": "将度故城湖阻风夜泊永阳戍",
      "content": [
        "行尽青溪日已蹉，云容山影水嵯峨。",
        "楼前归客怨清梦，楼上美人凝夜歌。",
        "独树高高风势急，平湖渺渺月明多。",
        "终期一艇载樵去，来往使帆凌白波。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276249,
      "title": "郑侍御厅翫鹤",
      "content": [
        "碧天飞舞下晴莎，金阁瑶池绝网罗。",
        "嵒响数声风满树，岸移孤影雪凌波。",
        "缑山去远云霄迥，辽海归迟岁月多。",
        "双翅一开千万里，秖应栖隐恋乔柯。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276250,
      "title": "南亭夜坐贻开元禅定二道者",
      "content": [
        "暮暮焚香何处宿，西岩一室映疎藤。",
        "光阴难驻迹如客，寒暑不惊心似僧。",
        "高树有风闻夜磬，远山无月见秋灯。",
        "身闲境静日为乐，若问其余非我能。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276251,
      "title": "朱坡故少保杜公池亭",
      "content": [
        "杜陵池榭绮城东，孤岛回汀路不穷。",
        "高岫乍疑三峡近，远波初似五湖通。",
        "楸梧叶暗潇潇雨，菱荇花香淡淡风。",
        "还有昔时巢燕在，飞来飞去画堂中。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276252,
      "title": "秋日早朝",
      "content": [
        "宵衣应待绝更筹，环佩锵锵月下楼。",
        "井转辘轳千树晓，鏁开阊阖万山秋。",
        "龙旗尽列趋金殿，雉扇才分见玉旒。",
        "虚戴铁冠无一事，沧江归去老渔舟。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276253,
      "title": "沧浪峡",
      "content": [
        "缨带流尘髪半霜，独寻残月下沧浪。",
        "一声溪鸟暗云散，万片野花流水香。",
        "昔日未知方外乐，暮年初信梦中忙。",
        "红虾青鲫紫芹脆，归去不辞来路长。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276254,
      "title": "故洛城",
      "content": [
        "禾黍离离半野蒿，昔人城此岂知劳。",
        "水声东去市朝变，山势北来宫殿高。",
        "鸦噪暮云归古堞，鴈迷寒雨下空壕。",
        "可怜缑岭登仙子，犹自吹笙醉碧桃。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276255,
      "title": "闻释子栖玄欲奉道因寄",
      "content": [
        "欲求真诀恋禅扃，羽帔方袍尽有情。",
        "仙骨本微灵鹤远，法心潜动毒龙惊。",
        "三山未有偷桃计，四海初传问菊名。",
        "今日劝师师莫惑，长生难学证无生。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276256,
      "title": "南海府罢南康阻浅行侣稍登陆而迈主人燕饯至频暮宿东溪",
      "content": [
        "暗滩水落涨虚沙，滩去秦吴万里赊。",
        "马上折残江北柳，舟中开尽岭南花。",
        "离歌不断如留客，归梦初惊似到家。",
        "山鸟一声人未起，半床春月在天涯。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276257,
      "title": "秋晚云阳驿西亭莲池",
      "content": [
        "心忆莲池秉烛游，叶残花败尚维舟。",
        "烟开翠扇清风晓，水泥红衣白露秋。",
        "神女暂来云易散，仙娥初去月难留。",
        "空怀远道难持赠，醉倚阑干尽日愁。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276258,
      "title": "题勤尊师历阳山居",
      "content": [
        "二十知兵在羽林，中年潜识子房心。",
        "苍鹰出塞胡尘灭，白鹤还乡楚水深。",
        "春坼酒瓶浮药气，晚携棋局带松阴。",
        "鸡笼山上云多处，自𣃁黄精不可寻。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276259,
      "title": "怀旧居",
      "content": [
        "兵书一箧老无功，故国郊扉在梦中。",
        "藤蔓覆梨张谷暗，草花侵菊庾园空。",
        "朱门迹忝登龙客，白屋心期失马翁。",
        "楚水吴山何处是，北窗残月照屏风。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276260,
      "title": "祗命许昌自郊居移就公馆秋日寄茅山高拾遗",
      "content": [
        "一笛迎风万叶飞，强携刀笔换荷衣。",
        "潮寒水国秋砧早，月暗山城夜漏稀。",
        "岩响远闻樵客过，浦深遥送钓童归。",
        "中年未识从军乐，虚近三茅望少微。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276261,
      "title": "伤虞将军",
      "content": [
        "白首从军未有名，近将孤劒到江城。",
        "巴童戍久能番语，胡马调多解汉行。",
        "对雪夜穷黄石略，望云秋计黑山程。",
        "可怜身死家犹远，汴水东流无哭声。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276262,
      "title": "晚自朝台津至韦隐居郊园",
      "content": [
        "秋来凫鴈下方塘，系马朝台步夕阳。",
        "村径绕山松叶暗，野门临水稻花香。",
        "云连海气琴书润，风带潮声枕簟凉。",
        "西下磻溪犹万里，可能垂白待文王。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276263,
      "title": "寓居开元精舍酬薛秀才见贻",
      "content": [
        "知己萧条信陆沈，茂陵扶疾卧西林。",
        "芰荷风起客堂静，松桂月高僧院深。",
        "清露下时伤旅鬓，白云归处寄乡心。",
        "怜君诗句犹相忆，题在空斋夜夜吟。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276264,
      "title": "别刘秀才",
      "content": [
        "三献无功玉有瑕，更携书劒客天涯。",
        "孤帆夜别潇湘雨，广陌春期鄠杜花。",
        "灯照水萤千点灭，棹惊滩鴈一行斜。",
        "关河万里秋风急，望见乡山不到家。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276265,
      "title": "早发天台中岩寺度关岭次天姥岑",
      "content": [
        "来往天台天姥间，欲求真诀驻衰颜。",
        "星河半落岩前寺，云雾初开岭上关。",
        "丹壑树多风浩浩，碧溪苔浅水潺潺。",
        "可知刘阮逢人处，行尽深山又是山。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276266,
      "title": "游钱塘青山李隐居西斋",
      "content": [
        "小隐西亭为客开，翠萝深处遍苍苔。",
        "林间扫石安棋局，岩下分泉递酒杯。",
        "兰叶露光秋月上，芦花风起夜潮来。",
        "云山遶屋犹嫌浅，欲棹渔舟近钓台。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276267,
      "title": "春日郊园戏赠杨嘏评事",
      "content": [
        "十里蒹葭入薜萝，春风谁许暂鸣珂。",
        "相如渴后狂还减，曼倩归来语更多。",
        "门枕碧溪冰皓耀，槛齐青嶂雪嵯峨。",
        "野桥沽酒茅簷醉，谁羡红楼一曲歌。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276268,
      "title": "晚自东郭回留一二游侣",
      "content": [
        "乡心迢遰宦情微，吏散寻幽竟落晖。",
        "林下草腥巢鹭宿，洞前云湿雨龙归。",
        "钟随野艇回孤棹，鼓绝山城掩半扉。",
        "今夜西斋好风月，一瓢春酒莫相违。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276269,
      "title": "与郑秀才叔姪会送杨秀才昆仲东归",
      "content": [
        "书劒功迟白发新，异乡仍送故乡人。",
        "阮公留客竹林晚，田氏到家荆树春。",
        "雪尽塞鸿南翥少，风来胡马北嘶频。",
        "洞庭烟月如终老，谁是长杨谏猎臣。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276270,
      "title": "送郭秀才游天台",
      "content": [
        "云埋阴壑雪凝峰，半壁天台已万重。",
        "人度碧溪疑辍棹，僧归苍岭似闻钟。",
        "暖眠㶉𫛶晴滩草，高挂猕猴暮涧松。",
        "曾约共游今独去，赤城西面水溶溶。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276271,
      "title": "送张尊师归洞庭",
      "content": [
        "能琴道士洞庭西，风满归帆路不迷。",
        "对岸水花霜后浅，傍簷山果雨来低。",
        "杉松近晚移茶灶，岩谷初寒盖药畦。",
        "他日相思两行字，无人知处武陵溪。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276272,
      "title": "移摄太平寄前李明府",
      "content": [
        "病移嵒邑称闲身，何处风光贳酒频。",
        "溪柳遶门彭泽令，野花连洞武陵人。",
        "娇歌自驻壶中景，艳舞长留海上春。",
        "早晚高台更同醉，绿萝如帐草如茵。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276273,
      "title": "再游姑苏玉芝观",
      "content": [
        "高梧一叶下秋初，迢遰重廊旧寄居。",
        "月过碧窗今夜酒，雨昏红壁去年书。",
        "玉池露冷芙蓉浅，琼树风高薜荔疎。",
        "明日挂帆更东去，仙翁应笑为鲈鱼。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276274,
      "title": "夜归驿楼",
      "content": [
        "水晚云秋山不穷，自疑身在画屏中。",
        "孤舟移棹一江月，高阁卷帘千树风。",
        "窗下覆棋残局在，橘边沽酒半坛空。",
        "早炊香稻待鲈鲙，南渚未明寻钓翁。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276275,
      "title": "题灵山寺行坚师院",
      "content": [
        "西岩一迳不通樵，八十持杯未觉遥。",
        "龙在石潭闻夜雨，鴈移沙渚见秋潮。",
        "经函露湿文多暗，香印风吹字半销。",
        "应笑东归又南去，越山无路水迢迢。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276276,
      "title": "湖州韦长史山居",
      "content": [
        "一官唯买昼公堂，但得身闲日自长。",
        "琴曲少声重勘谱，药丸多忌更寻方。",
        "溪浮箬叶添醅绿，泉遶松根助茗香。",
        "明日鳜鱼何处钓，门前春水似沧浪。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276277,
      "title": "赠李伊阙",
      "content": [
        "桐履如飞不可寻，一壶双笈峄阳琴。",
        "舟横野度寒风急，门掩荒山夜雪深。",
        "贫笑白驹无去意，病慙黄鹄有归心。",
        "云间二室劳君画，水墨苍苍半壁阴。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276278,
      "title": "重游𦈌湖怀旧",
      "content": [
        "西风渺渺月连天，同醉兰舟未十年。",
        "𫛳鸟赋成人已没，嘉鱼诗在世空传。",
        "荣枯尽寄浮云外，哀乐犹惊逝水前。",
        "日暮长隄更回首，一声邻笛旧山川。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276279,
      "title": "乘月棹舟送大历寺灵聪上人不及",
      "content": [
        "万峰秋尽百泉清，旧锁禅扉在赤城。",
        "枫浦客来烟未散，竹窗僧去月犹明。",
        "杯浮野渡鱼龙远，锡响空山虎豹惊。",
        "一字不留何足讶，白云无路水无情。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276280,
      "title": "汴河亭",
      "content": [
        "广陵花盛帝东游，先劈昆仑一派流。",
        "百二禁兵辞象阙，三千宫女下龙舟。",
        "凝云鼓震星辰动，拂浪旗开日月浮。",
        "四海义师归有道，迷楼还似景阳楼。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276281,
      "title": "村舍二首 一",
      "content": [
        "自翦青莎织雨衣，南峰烟火是柴扉。",
        "莱妻早报蒸藜熟，童子遥迎种豆归。",
        "鱼下碧潭当镜跃，鸟还青嶂拂屏飞。",
        "花时未免人来往，欲买严光旧钓矶。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276282,
      "title": "村舍二首 二",
      "content": [
        "尚平多累自归难，一日身闲一日安。",
        "山迳晓云收猎网，水门凉月挂鱼竿。",
        "花间酒气春风暖，竹里棋声暮雨寒。",
        "三顷水田秋更熟，北窗谁拂旧尘冠。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276283,
      "title": "郑秀才东归凭达家书",
      "content": [
        "欲寄家书少客过，闭门心远洞庭波。",
        "两岩花落夜风急，一迳草荒春雨多。",
        "愁泛楚江吟浩渺，忆归吴岫梦嵯峨。",
        "贫居不问应知处，溪上闲船系绿萝。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276284,
      "title": "伤故湖州李郎中",
      "content": [
        "政成身没共兴衰，乡路兵戈旅榇回。",
        "城上暮云凝鼓角，海边春草闭池台。",
        "经年未葬家人散，昨夜因斋故吏来。",
        "南北相逢皆掩泣，白苹洲暖百花开。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276285,
      "title": "和友人送僧归桂州灵岩寺",
      "content": [
        "楚客送僧归桂阳，海门帆势极潇湘。",
        "碧云千里暮愁合，白雪一声春思长。",
        "柳絮拥堤添衲软，松花浮水注瓶香。",
        "南京长老几年别，闻道半岩多影堂。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276286,
      "title": "淮阴阻风寄呈楚州韦中丞",
      "content": [
        "垂钓京江欲白头，江鱼堪钓却西游。",
        "刘伶台下稻花晚，韩信庙前枫叶秋。",
        "淮月未明先倚槛，海云初起更维舟。",
        "河桥有酒无人醉，独上高城望庾楼。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276287,
      "title": "途经敷水",
      "content": [
        "修蛾颦翠倚柔桑，遥谢春风白面郎。",
        "五夜有情随暮雨，百年无节待秋霜。",
        "重寻绣带朱藤合，更认罗帬碧草长。",
        "何处野花何处水，下峰流出一渠香。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276288,
      "title": "和人贺杨仆射致政",
      "content": [
        "莲府公卿拜后尘，手持优诏挂朱轮。",
        "从军暮下三千客，闻礼庭中七十人。",
        "锦帐丽词推北巷，画堂清乐掩南邻。",
        "岂同王谢山阴会，空叙流杯醉暮春。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276289,
      "title": "题四皓庙",
      "content": [
        "桂香松暖庙门开，独泻椒浆奠一杯。",
        "秦法欲兴鸿已去，汉储将废凤还来。",
        "紫芝翳翳多青草，白石苍苍半绿苔。",
        "山下驿尘南窜路，不知冠盖几人回。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276290,
      "title": "鹤林寺中秋夜翫月",
      "content": [
        "待月东林月正圆，广庭无树草无烟。",
        "中秋云尽出沧海，半夜露寒当碧天。",
        "轮彩渐移金殿外，镜光犹挂玉楼前。",
        "莫辞达曙殷勤望，一堕西岩又隔年。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276291,
      "title": "南海府罢归京口经大庾岭赠张明府",
      "content": [
        "楼船旌斾极天涯，一剑从军两鬓华。",
        "回日眼明河畔草，去时肠断岭头花。",
        "陶诗尽写行过县，张赋初成卧到家。",
        "官满知君有归处，姑苏台上旧烟霞。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276292,
      "title": "题卫将军庙",
      "content": [
        "武牢关下护龙旗，挟槊弯弧马上飞。",
        "汉业未兴王霸在，秦军才散鲁连归。",
        "坟穿大泽埋金剑，庙枕长溪挂铁衣。",
        "欲奠忠魂何处问，苇花枫叶雨霏霏。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276293,
      "title": "访别韦隐居不值",
      "content": [
        "犬吠双岩碧树间，主人朝出半开关。",
        "汤师阁上留诗别，杜叟桥边载酒还。",
        "栎坞炭烟晴过岭，蓼村渔火夜移湾。",
        "故乡芜没兵戈后，凭向溪南买一山。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276294,
      "title": "送前东阳于明府由鄂渚归故林",
      "content": [
        "结束征车换黑貂，灞西风雨正潇潇。",
        "茂陵久病书千卷，彭泽初归酒一瓢。",
        "帆背夕阳湓水阔，棹经沧海甑山遥。",
        "殷勤为谢南溪客，白首萤窗未见招。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276295,
      "title": "听歌鹧鸪辞",
      "content": [
        "南国多情多艳词，鹧鸪清怨遶梁飞。",
        "甘棠城上客先醉，苦竹岭头人未归。",
        "响转碧霄云驻影，曲终清漏月沈晖。",
        "山行水宿不知远，犹梦玉钗金缕衣。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276296,
      "title": "寄题华严韦秀才院",
      "content": [
        "三面楼台百丈峰，西岩高枕树重重。",
        "晴攀翠竹题诗滑，秋摘黄花酿酒浓。",
        "山殿日斜喧鸟雀，石潭波动戏鱼龙。",
        "今来故国遥相忆，月照千山半夜钟。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276297,
      "title": "戏代李协律松江有赠",
      "content": [
        "蜀客操琴吴女歌，明珠十斛是天河。",
        "霜凝薜荔怯秋树，露滴芙蓉愁晚波。",
        "兰浦远乡应解珮，柳堤残月未鸣珂。",
        "西楼沈醉不知散，潮落洞庭洲渚多。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276298,
      "title": "送黄隐居归南海",
      "content": [
        "瘴雾南边久寄家，海中来往信流槎。",
        "林藏●●多残笋，树过猩猩少落花。",
        "深洞有云龙蜕骨，半岩无草象生牙。",
        "知君爱宿层峰顶，坐到三更见日华。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276299,
      "title": "朝台送客有怀",
      "content": [
        "赵佗西拜已登坛，马援南征土宇宽。",
        "越国旧无唐印绶，蛮乡今有汉衣冠。",
        "江云带日秋偏热，海雨随风夏亦寒。",
        "岭北归人莫回首，蓼花枫叶万重滩。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276300,
      "title": "自楞伽寺晨起泛舟道中有怀",
      "content": [
        "碧树苍苍茂苑东，佳期迢遰路何穷。",
        "一声山鸟曙云外，万点水萤秋草中。",
        "门掩竹斋微有月，棹移兰渚淡无风。",
        "欲知此路堪惆怅，菱叶蓼花连故宫。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276301,
      "title": "十二月拜起居表回",
      "content": [
        "一章西奏拜仙曹，回马天津北望劳。",
        "寒水欲春冰彩薄，晓山初霁雪峰高。",
        "楼形向日攒飞凤，宫势凌波压抃鼇。",
        "空锁烟霞绝巡幸，周人谁识郁金袍。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276302,
      "title": "观章中丞夜按歌舞",
      "content": [
        "夜按双娃禁曲新，东西箫鼓接云津。",
        "舞衫未换红铅湿，歌扇初移翠黛颦。",
        "彩槛烛烟光吐日，画屏香雾暖如春。",
        "西楼月在襄王醉，十二山高不见人。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276303,
      "title": "重游飞泉观题故梁道士宿龙池",
      "content": [
        "西岩泉落水容宽，灵物蜿蜒黑处蟠。",
        "松叶正秋琴韵响，菱花初晓镜光寒。",
        "云开星月浮山殿，雨过风雷遶石坛。",
        "仙客不归龙亦去，稻畦长满此池干。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
