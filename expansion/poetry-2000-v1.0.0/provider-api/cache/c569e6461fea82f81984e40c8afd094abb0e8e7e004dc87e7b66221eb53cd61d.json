{
  "data": [
    {
      "id": 366616,
      "title": "再经南阳",
      "content": [
        "平芜漠漠失楼台，昔日游人乱后来。",
        "寥落墙匡春欲暮，烧残官树有花开。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 366618,
      "title": "春阴",
      "content": [
        "推琴当酒度春阴，不解谋生只解吟。",
        "舞蝶歌莺莫相试，老郎心是老僧心。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 366619,
      "title": "送张逸人",
      "content": [
        "人间疏散更无人，浪兀孤舟酒兀身。",
        "芦笋鲈鱼抛不得，五陵珍重五湖春。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 366621,
      "title": "擢第后入蜀经罗村，路见海棠盛开偶有题咏",
      "content": [
        "上国休夸红杏艳，深溪自照绿苔矶。",
        "一枝低带流莺睡，",
        "手中已有新春桂，多谢烟香更入衣。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 366622,
      "title": "次韵和礼部卢侍郎江上秋夕寓怀",
      "content": [
        "卢郎到处觉风生，蜀郡留连亚相情。",
        "乱后江山悲庾信，",
        "未脱白衣头半白，叨陪属和倍为荣。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 366623,
      "title": "宜春再访芳公言公幽斋写怀叙事，因赋长言",
      "content": [
        "入门长恐先师在，香印纱灯似昔年，涧路萦回斋处远，",
        "顾渚一瓯春有味，中林话旧亦潸然。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 366625,
      "title": "卷末偶题三首",
      "content": [
        "一卷疏芜一百篇，名成未敢暂忘筌。",
        "何如海日生残夜，一句能令万古传。",
        "七岁侍行湖外去，岳阳楼上敢题诗。",
        "如今寒晚无功业，何以胜任国士知。",
        "一第由来是出身，垂名俱为国风陈。",
        "此生若不知骚雅，孤宦如何作近臣。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 366626,
      "title": "读前集二首",
      "content": [
        "殷璠裁鉴英灵集，颇觉同才得旨深。",
        "何事后来高仲武，品题间气未公心。",
        "风骚如线不胜悲，国步多艰即此时。",
        "爱日满阶看古集，只应陶集是吾师。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 366627,
      "title": "渚宫乱后作",
      "content": [
        "乡人来话乱离情，泪滴残阳问楚荆。",
        "白社已应无故老，",
        "牢落故居灰烬后，黄花紫蔓上墙生。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 366628,
      "title": "鹧鸪",
      "content": [
        "暖戏烟芜锦翼齐，品流应得近山鸡。",
        "雨昏青草湖边过，",
        "相呼相应湘江阔，苦竹丛深春日西。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 366629,
      "title": "燕",
      "content": [
        "年去年来来去忙，春寒烟暝渡潇湘。",
        "低飞绿岸和梅雨，",
        "千言万语无人会，又逐流莺过短墙。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 366630,
      "title": "侯家鹧鸪",
      "content": [
        "江天梅雨湿江蓠，到处烟香是此时。",
        "苦竹岭无归去日，",
        "唯有佳人忆南国，殷勤为尔唱愁词。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 366631,
      "title": "雁",
      "content": [
        "八月悲风九月霜，蓼花红淡苇条黄。",
        "石头城下波摇影，",
        "故乡闻尔亦惆怅，何况扁舟非故乡。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 366632,
      "title": "水",
      "content": [
        "竹院松廊分数派，不空清泚亦逶迤。",
        "落花相逐去何处，",
        "晚晴一片连莎绿，悔与沧浪有旧期。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 366633,
      "title": "海棠",
      "content": [
        "春风用意匀颜色，销得携觞与赋诗。",
        "秾丽最宜新著雨，",
        "朝醉暮吟看不足，羡他蝴蝶宿深枝。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 366634,
      "title": "竹",
      "content": [
        "宜烟宜雨又宜风，拂水藏村复间松。",
        "移得萧骚从远寺，",
        "无赖杏花多意绪，数枝穿翠好相容。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 366635,
      "title": "荔枝树",
      "content": [
        "二京曾见画图中，数本芳菲色不同。",
        "孤棹今来巴徼外，",
        "肠断渝泸霜霰薄，不教叶似灞陵红。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 366636,
      "title": "锦二首",
      "content": [
        "布素豪家定不看，若无文彩入时难。",
        "红迷天子帆边日，",
        "舞衣转转求新样，不问流离桑柘残。",
        "文君手里曙霞生，美号仍闻借蜀城。",
        "夺得始知袍更贵，",
        "礼部郎官人所重，省中别占好窠名。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 366637,
      "title": "蜡烛",
      "content": [
        "仙漏迟迟出建章，宫帘不动透清光。",
        "金闱露白新裁诏，",
        "多情更有分明处，照得歌尘下燕梁。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 366638,
      "title": "灯",
      "content": [
        "雨向莎阶滴未休，冷光孤恨两悠悠。",
        "船中闻雁洞庭宿，",
        "萧骚寒竹南窗静，一局闲棋为尔留。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 366639,
      "title": "宗人作尉唐昌官署幽胜而又博学精富得以言谈…留书屋壁",
      "content": [
        "公堂潇洒有林泉，只隔苔墙是渚田。",
        "宗党相亲离乱世，",
        "风雨夜长同一宿，旧游多共忆樊川。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 366640,
      "title": "为户部李郎中与令季端公寓止渠州江寺偶作寄献",
      "content": [
        "退居潇洒寄禅关，高挂朝簪净室间。",
        "孤岛虽留双鹤歇，",
        "仙署金闺虚位久，夜清应梦近天颜。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 366642,
      "title": "阙下春日",
      "content": [
        "建章宫殿紫云飘，春漏迟迟下绛霄。",
        "绮陌暖风嘶去马，",
        "秦楚年年有离别，扬鞭挥袖灞陵桥。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 366643,
      "title": "赠刘神童",
      "content": [
        "习读在前生，僧谈足可明。",
        "还家虽解喜，登第未知荣。",
        "时果曾沾赐，春闱不挂情。",
        "灯前犹恶睡，寤语读书声。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 366645,
      "title": "光化戊午年举公见示省试春草碧色诗偶赋是题",
      "content": [
        "苌弘血染新，含露满江滨。",
        "想得寻花径，应迷拾翠人。",
        "窗纱迎拥砌，簪玉姑成茵。",
        "天借新晴色，云饶落日春。",
        "岚光垂处合，眉黛看时嚬。",
        "愿与仙桃比，无令惹路尘。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 366646,
      "title": "江际",
      "content": [
        "杳杳渔舟破暝烟，疏疏芦苇旧江天。",
        "那堪流落逢摇落，",
        "兵车未息年华促，早晚闲吟向浐川。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 366647,
      "title": "将之泸郡旅次遂州遇裴晤员外谪居于此话旧凄凉因寄二首",
      "content": [
        "谁解登高问上玄，谪仙何事谪诗仙，云遮列宿离华省，",
        "不知几首南行曲，留与巴儿万古传。",
        "昔年共照松溪影，松折溪荒僧已无。",
        "今日重思锦城事，",
        "我拜师门更南去，荔枝春熟向渝泸。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 366648,
      "title": "次韵和秀上人长安寺居言怀寄渚宫禅者",
      "content": [
        "旧斋松老别多年，香社人稀丧乱间。",
        "出寺只知趋内殿，",
        "唯恐兴来飞锡去，老郎无路更追攀。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 366649,
      "title": "蜀中春日",
      "content": [
        "海棠风外独沾巾，襟袖无端惹蜀尘。",
        "和暖又逢挑菜日，",
        "何事晚来微雨后，锦江春学曲江春。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 366650,
      "title": "游蜀",
      "content": [
        "所向明知是暗投，两行清泪语前流。",
        "云横新塞遮秦甸，",
        "梅黄麦绿无归处，可得漂漂爱浪游。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 366651,
      "title": "峡中尝茶",
      "content": [
        "蔟蔟新英摘露光，小江园里火煎尝。",
        "吴僧漫说鸦山好，",
        "鹿门病客不归去，酒渴更知春味长。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 366652,
      "title": "辇下冬暮咏怀",
      "content": [
        "永巷闲吟一径蒿，轻肥大笑事风骚。",
        "烟含紫禁花期近，",
        "十年春泪催衰飒，羞向清流照鬓毛。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 366653,
      "title": "石城",
      "content": [
        "石城昔为莫愁乡，莫愁魂散石城荒。",
        "江人依旧棹舴艋，",
        "烟浓草远望不尽，千古汉阳闲夕阳。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 366654,
      "title": "蜀中三首",
      "content": [
        "马头春向鹿头关，远树平芜一望闲。",
        "雪下文君沾酒市，",
        "堤月桥灯好时景，汉庭无事不征蛮。",
        "夜无多雨晓生尘，草色岚光日日新。",
        "蒙顶茶畦千点露，",
        "却共海棠花有约，数年留滞不归人。",
        "渚远江清碧簟纹，小桃花绕薛涛坟。",
        "朱桥直指金门路，",
        "子规夜夜啼巴树，不并吴乡楚国闻。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 366655,
      "title": "少华甘露寺",
      "content": [
        "石门萝径与天邻，雨桧风篁远近闻。",
        "饮涧鹿喧双派水，",
        "长欲然香来此宿，北林猿鹤旧同群。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 366656,
      "title": "慈恩寺偶题",
      "content": [
        "往事悠悠添浩叹，劳生扰扰竟何能。",
        "故山岁晚不归去，",
        "吟余却起双峰念，曾看庵西瀑布冰。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 366657,
      "title": "石门山泉",
      "content": [
        "一脉清冷何所之，萦莎漱藓入僧池。",
        "云边野客穷来处，",
        "烟春雨晚闲吟去，不复远寻皇子陂。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 366658,
      "title": "渭阳楼闲望",
      "content": [
        "千重二华见皇州，望尽凝岚即此楼。",
        "细雨不藏秦树色，",
        "扰扰尘中犹未已，可能疏傅独能休。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 366659,
      "title": "送田光",
      "content": [
        "九陌低迷谁问我，五湖流浪可悲君。",
        "著书笑破苏司业，",
        "耒阳江口春山绿，恸哭应寻杜甫坟。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 366660,
      "title": "送进士吴延保及第后南游",
      "content": [
        "得意却思寻旧迹，新衔未切向兰台。",
        "吟看秋草出关去，",
        "江湖易有淹留兴，莫待春风落庾梅。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 366661,
      "title": "送进士王驾下第归蒲中",
      "content": [
        "失意离愁春不知，到家时是落花时。",
        "孤单取事休言命，",
        "应嗟我又巴江去，游子悠悠听子规。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 366662,
      "title": "作尉鄠郊送进士潘为下第南归",
      "content": [
        "归去宜春春水深，麦秋梅雨过湘阴。",
        "乡园几度经狂寇，",
        "灞陵桥上杨花里，酒满芳樽泪满襟。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 366663,
      "title": "送进士韦序赴举",
      "content": [
        "丹霞照上三清路，瑞锦裁成五色毫。",
        "波浪不能随世态，",
        "预想明年腾跃处，龙津春碧浸仙桃。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 366664,
      "title": "寄献狄右丞",
      "content": [
        "逐胜偷闲向杜陵，爱僧不爱紫衣僧。",
        "身为醉客思吟客，",
        "孤单小谏渔舟在，心恋清潭去未能。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 366665,
      "title": "转正郎后寄献集贤相公",
      "content": [
        "予名初在德门前，屈指年来三十年。",
        "自贺孤危终际会，",
        "平昔苦心何所恨，受恩多是旧诗篇。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 366666,
      "title": "所知从事近藩偶有怀寄",
      "content": [
        "官舍种莎僧对榻，生涯如在旧山贫。",
        "酒醒草檄闻残漏，",
        "霜台伏首思归切，莫把渔竿逐逸人。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 366667,
      "title": "献大京兆薛常侍能",
      "content": [
        "耻将官业竞前途，自爱篇章古不如。",
        "一炷香新开道院，",
        "唯有明公赏新句，秋风不敢忆鲈鱼。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 366668,
      "title": "寄赠孙路处士",
      "content": [
        "平生诗誉更谁过，归老东吴命若何。",
        "知己凋零垂白发，",
        "深入富春人不见，闲门空掩半庭莎。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 366669,
      "title": "献制诰杨舍人",
      "content": [
        "为郡东吴只饮冰，琐闱频降凤书征。",
        "随行已有朱衣吏，",
        "苇陂竹坞情无限，闲话毗陵问杜陵。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 366670,
      "title": "次韵酬张补阙因寒食见寄之什",
      "content": [
        "柳近清明翠缕长，多情右衮不相忘。",
        "开缄虽睹新篇丽，",
        "朝稀且莫轻春赏，胜事由来在帝乡。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 366671,
      "title": "赠宗人前公安宰君",
      "content": [
        "喧卑从宦出喧卑，别画能琴又解棋。",
        "海上春耕因乱废，",
        "孤散恨无推唱路，耿怀吟得赠君诗。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 366672,
      "title": "寄赠杨夔处士",
      "content": [
        "结茅只约钓鱼台，溅水鸬鹚去又回。",
        "春卧瓮边听酒熟，",
        "国步未安风雅薄，可能高尚掞天才。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 366673,
      "title": "寄同年礼部赵郎中",
      "content": [
        "仙步徐徐整羽衣，小仪澄澹转中仪。",
        "桦飘红烬趋朝路，",
        "自怜孤宦谁相念，祷祝空吟一首诗。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 366674,
      "title": "春暮咏怀寄集贤韦起居衮",
      "content": [
        "寂寂风帘信自垂，杨花笋箨正离披。",
        "长安一夜残春雨，",
        "五湖烟网非无意，未去难忘国士知。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 366675,
      "title": "多情",
      "content": [
        "赋分多情却自嗟，萧衰未必为年华。",
        "睡轻可忍风敲竹，",
        "莺春雁夜长如此，赖是幽居近酒家。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 366676,
      "title": "感怀投时相",
      "content": [
        "非才偶忝直文昌，两鬓年深一镜霜。",
        "待漏敢辞称小吏，",
        "丞相旧知为学苦，更教何处贡篇章。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 366677,
      "title": "自贻",
      "content": [
        "饮筵博席与心违，野眺春吟更是谁。",
        "琴有涧风声转淡，",
        "头角俊髦应指笑，权门踪迹独差池。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 366678,
      "title": "自遣",
      "content": [
        "强健宦途何足谓，入微章句更难论。",
        "谁知野性真天性，",
        "朝回何处消长日，紫阁峰南有旧村。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 366679,
      "title": "中年",
      "content": [
        "漠漠秦云淡淡天，新年景象入中年。",
        "情多最恨花无语，",
        "衰迟自喜添诗学，更把前题改数联。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 366680,
      "title": "自适",
      "content": [
        "紫陌宾士不暂停，送迎终日在郊坰。",
        "年来鬓畔未垂白，",
        "春风只有九十日，可合花前半日醒。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 366681,
      "title": "结绶鄠郊縻摄府署偶有自咏",
      "content": [
        "莺离寒谷士逢春，释褐来年暂种芸。",
        "自笑老为梅少府，",
        "推却簿书搔短发，落花飞絮正纷纷。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 366682,
      "title": "漂泊",
      "content": [
        "槿坠蓬疏池馆清，日光风绪淡无情。",
        "鲈鱼斫鲙输张翰，",
        "黄花催促重阳近，何处登高望二京。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 366683,
      "title": "吊故礼部韦员外序",
      "content": [
        "腊雪初晴花举杯，便期携手上春台。",
        "高情唯怕酒不满，",
        "杜陵芳草年年绿，醉魄吟魂无复回。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 366684,
      "title": "渼陂",
      "content": [
        "昔事东流共不回，春深独向渼陂来。",
        "乱前别业依稀在，",
        "潸然四顾难消遣，只有佯狂泥酒杯。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 366685,
      "title": "代秋扇词",
      "content": [
        "露入庭芜恨已深，热时天下是知音。",
        "汗流浃背曾施力，",
        "绿槐阴合清和后，不会何颜又见寻。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 366686,
      "title": "宣义里舍冬暮自贻",
      "content": [
        "幽居不称在长安，沟浅浮春岸雪残。",
        "板屋渐移方带野，",
        "满眼尘埃驰骛去，独寻烟竹剪渔竿。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 366687,
      "title": "省中偶作",
      "content": [
        "三转郎曹自勉旃，莎阶吟步想前贤。",
        "未如何逊无佳句，",
        "乳毛松雪春来好，直夜清闲且学禅。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 366688,
      "title": "同志顾云下第出京偶有寄勉",
      "content": [
        "凤策联华是国华，春来偶未上仙槎。",
        "乡连南渡思菰米，",
        "一般情绪应相信，门静莎深树影斜。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 366689,
      "title": "敷溪高士",
      "content": [
        "敷溪南岸掩柴荆，挂却朝衣爱净名。",
        "闲得林园栽树法，",
        "谪去征还何扰扰，片云相伴看衰荣。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 366690,
      "title": "九日偶怀寄左省张起居",
      "content": [
        "令节争欢我独闲，荒台尽日向晴山。",
        "浑无酒泛金英菊，",
        "羡君官重多吟兴，醉带南陂落照还。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 366691,
      "title": "春夕伴同年礼部赵员外省直",
      "content": [
        "锦帐名郎重锦科，清宵寓直纵吟哦。",
        "冰含玉镜春寒在，",
        "流莺百啭和残漏，犹把芳樽藉露莎。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 366692,
      "title": "倦客",
      "content": [
        "十年五年岐路中，千里万里西复东。",
        "匹马愁冲晚村雪，",
        "闲烹芦笋炊菰米，会向源乡作醉翁。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 366693,
      "title": "温处士能画鹭鹚以四韵换之",
      "content": [
        "昔年吟醉绕江蓠，爱把渔竿伴鹭鹚。",
        "闻说小毫能纵逸，",
        "得向晓窗闲挂玩，雪蓑烟艇恨无遗。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 366694,
      "title": "驾部郑郎中三十八丈尹贰东周荣加金紫谷以末派…因贺送",
      "content": [
        "香浮玉陛晓辞天，袍拂蒲茸称少年。",
        "郎署转曹虽久次，",
        "今日龙门看松雪，探春明日向平泉。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 366695,
      "title": "欹枕",
      "content": [
        "欹枕高眠日午春，酒酣睡足最闲身。",
        "明朝会得穷通理，未必输他马上人。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 366700,
      "title": "谷比岁受同年丈人故川守李侍郎教谕衰晏龙钟益用…自贻",
      "content": [
        "多感京河李丈人，童蒙受教便书绅。",
        "文章至竟无功业，",
        "孤单所得皆逾分，归种敷溪一亩春。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 366701,
      "title": "郊墅",
      "content": [
        "韦曲樊川雨半晴，竹庄花院遍题名。",
        "画成烟景垂杨色，",
        "渼陂水色澄于镜，何必沧浪始濯缨。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 366702,
      "title": "舟行",
      "content": [
        "九派迢迢九月残，舟人相语且相宽。",
        "村逢好处嫌风便，",
        "季鹰可是思鲈鲙，引退知时自古难。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 366703,
      "title": "奔问三峰寓止近墅",
      "content": [
        "半年奔走颇惊魂，来谒行宫泪眼昏。",
        "鸳鹭入朝同待漏，",
        "兵革未休无异术，不知何以受君恩。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 366704,
      "title": "朝直",
      "content": [
        "朝直叨居省阁间，由来疏退校安闲。",
        "落花夜静宫中漏，",
        "孤峰未得深归去，名画偏求水墨山。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 366705,
      "title": "巴江",
      "content": [
        "乱来奔走巴江滨，愁客多于江徼人。",
        "朝醉暮醉雪开霁，",
        "鬓秃又惊逢献岁，眼前浑不见交亲。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 366706,
      "title": "故许昌薛尚书能尝为都官郎中后数岁故建州…遂赋自贺",
      "content": [
        "都官虽未是名郎，践历曾闻薛许昌。",
        "复有李公陪雅躅，",
        "他日节旄如可继，不嫌曹冷在中行。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 366707,
      "title": "访题表兄王藻渭上别业",
      "content": [
        "桑林摇落渭川西，蓼水弥弥接稻泥。",
        "幽槛静来渔唱远，",
        "中表人稀离乱后，花时莫惜重相携。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 366708,
      "title": "题汝州从事厅",
      "content": [
        "诗人公署如山舍，只向阶前便采薇。",
        "惊燕拂帘闲睡觉，",
        "自说小池栽苇后，雨凉频见鹭鹚飞。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 366709,
      "title": "谷初忝谏垣今宪长薛公方在西阁知奖隆异以四韵代述荣感",
      "content": [
        "旧诗常得在高吟，不奈公心爱苦心。",
        "道自琐闱言下振，",
        "自拂青萍知有地，斋诚旦夕望为霖。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 366710,
      "title": "兵部卢郎中光济借示诗集，以四韵谢之",
      "content": [
        "七子风骚寻失主，五君歌诵久无声。",
        "调和雅乐归时正，",
        "叶公好尚浑疏阔，忽见真龙几丧明。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 366711,
      "title": "贺左省新除韦拾遗",
      "content": [
        "初升谏署是真仙，浪透桃花恰五年。",
        "垂白郎官居座末，",
        "从此追飞何处去，金鸾殿与玉堂连。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 366712,
      "title": "右省张补阙茂枢同在谏垣连居光德新春赋咏聊以寄怀",
      "content": [
        "小梅零落雪欺残，浩荡穷愁岂易宽。",
        "唯有朗吟偿晚景，",
        "十五年前谙苦节，知心不独为同官。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 366713,
      "title": "右省补阙张茂枢同在谏垣邻居光德迭和篇什…因抒酬寄",
      "content": [
        "何宋清名动粉闱，不才今日偶陈诗。",
        "考功岂敢闻题品，",
        "紫垣名士推扬切，为话心孤倍感知。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 366714,
      "title": "寄职方李员外",
      "content": [
        "曾袖篇章谒长卿，今来附凤事何荣。",
        "星临南省陪仙步，",
        "龙墀仗下天街暖，共看圭峰并马行。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 366715,
      "title": "寄题诗僧秀公",
      "content": [
        "灵一心传清塞心，可公吟后楚公吟。",
        "近来雅道相亲少，",
        "冷曹孤宦甘寥落，多谢携筇数访寻。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 366725,
      "title": "峨嵋山",
      "content": [
        "万仞白云端，经春雪未残。",
        "夏消江峡满，晴照蜀楼寒。",
        "造境知僧熟，归林认鹤难。",
        "会须朝阙去，只有画图看。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 366726,
      "title": "蜀江有吊",
      "content": [
        "孟子有良策，惜哉今已而。",
        "徒将心体国，不识道消时。",
        "折槛未为切，沈湘何足悲。",
        "苍苍无问处，烟雨遍江蓠。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 366729,
      "title": "题庄严寺休公院",
      "content": [
        "秋深庭色好，红叶间青松。",
        "病客残无著，吾师甚见容。",
        "疏钟和细溜，高塔等遥峰。",
        "未省求名侣，频于此地逢。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 366731,
      "title": "宿澄泉兰若",
      "content": [
        "山半古招提，空林雪月迷。",
        "乱流分石上，斜汉在松西。",
        "云集寒庵宿，猿先晓磬啼。",
        "此心如了了，即此是曹溪。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 366732,
      "title": "送举子下第东归",
      "content": [
        "夫子道何孤，青云未得途。",
        "诗书难舍鲁，山水暂游吴。",
        "野绿梅阴重，江春浪势粗。",
        "秣陵兵役后，旧业半成芜。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 366733,
      "title": "寄察院李侍御文炬",
      "content": [
        "古柏间疏篁，清阴在印床。",
        "宿郊虔点馔，秋寺静监香。",
        "参集行多揖，风仪见即庄。",
        "伫闻横擘去，帷集谏书囊。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 366738,
      "title": "恩门小谏雨中乞菊栽",
      "content": [
        "握兰将满岁，栽菊伴吟诗。",
        "老去慵趋世，朝回独绕篱。",
        "递香风细细，浇绿水弥弥。",
        "只共山僧赏，何当国士移。",
        "孤根深有托，微雨正相宜。",
        "更待金英发，凭君插一枝。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 366739,
      "title": "荆渚八月十五夜值雨寄同年李屿",
      "content": [
        "共待辉光夜，翻成黯澹秋。",
        "正宜清路望，潜起滴阶愁。",
        "棹倚袁宏渚，帘垂庾亮楼。",
        "桂无香实落，兰有露花休。",
        "玉漏添萧索，金尊阻献酬。",
        "明年佳景在，相约向神州。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 366741,
      "title": "前寄左省张起居一百言寻蒙唱酬见誉过实却用旧韵重答",
      "content": [
        "减瘦经多难，忧伤集晚年。",
        "吟高风过树，坐久夜凉天。",
        "旅退惭随众，孤飞怯向前。",
        "钓朋蓑叟在，药术衲僧传。",
        "鬓秃趋荣路，肠焦鄙盗泉。",
        "品徒诚有隔，推唱意何坚。",
        "寒地殊知感，秋灯耿不眠。",
        "从来甘默尔，自此倍怡然。",
        "兰为官须握，蒲因学更编。",
        "预愁摇落后，子美笑无毡。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    }
  ],
