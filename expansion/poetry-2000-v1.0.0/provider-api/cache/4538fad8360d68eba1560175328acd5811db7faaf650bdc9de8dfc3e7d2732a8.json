{
  "data": [
    {
      "id": 255096,
      "title": "鼓吹曲辞 巫山高二首 一",
      "content": [
        "巴山上峡重复重，阳台碧峭十二峰。",
        "荆王猎时逢暮雨，夜卧高丘梦神女。",
        "轻红流烟湿艳姿，行云飞去明星稀。",
        "目极魂断望不见，猨啼三声泪霑衣。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 255097,
      "title": "鼓吹曲辞 巫山高二首 二",
      "content": [
        "见尽数万里，不闻三声猨。",
        "但飞萧萧雨，中有亭亭魂。",
        "千载楚襄恨，遗文宋玉言。",
        "至今青冥里，云结深闺门。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 255112,
      "title": "鼓吹曲辞 有所思",
      "content": [
        "桔槔烽火昼不灭，客路迢迢信难越。",
        "古镇刀攒万片霜，寒江浪起千堆雪。",
        "此时西去定如何，空使南心远凄切。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 255205,
      "title": "横吹曲辞 折杨柳 一",
      "content": [
        "杨柳多短枝，短枝多别离。",
        "赠远累攀折，柔条安得垂。",
        "青春有定节，离别无定时。",
        "但恐人别促，不怨来迟迟。",
        "莫言短枝条，中有长相思。",
        "朱颜与绿杨，幷在别离期。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 255206,
      "title": "横吹曲辞 折杨柳 二",
      "content": [
        "楼上春风过，风前杨柳歌。",
        "枝疎缘别苦，曲怨为年多。",
        "花惊燕地雪，叶映楚池波。",
        "谁堪别离此，征戍在交河。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 255228,
      "title": "横吹曲辞 长安道",
      "content": [
        "胡风激秦树，贱子风中泣。",
        "家家朱门开，得见不可入。",
        "长安十二衢，投树鸟亦急。",
        "高阁何人家？",
        "笙簧正喧吸。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 255516,
      "title": "相和歌辞 怨诗",
      "content": [
        "试妾与君泪，两处滴池水。",
        "看取芙蓉花，今年为谁死。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 255580,
      "title": "相和歌辞 杂怨三首 一",
      "content": [
        "夭桃花清晨，游女红粉新。",
        "夭桃花薄暮，游女红粉故。",
        "树有百年花，人无一定颜。",
        "花送人老尽，人悲花自闲。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 255581,
      "title": "相和歌辞 杂怨三首 二",
      "content": [
        "贫女镜不明，寒花日少容。",
        "暗蛩有虚织，短线无长缝。",
        "浪水不可照，狂夫不可从。",
        "浪水多散影，狂夫多异踪。",
        "持此一生薄，空成百恨浓。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 255582,
      "title": "相和歌辞 杂怨三首 三",
      "content": [
        "忆人莫至悲，至悲空自衰。",
        "寄人莫翦衣，翦衣未必归。",
        "朝为双蒂花，暮为四散飞。",
        "花落却绕树，游子不顾期。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 255742,
      "title": "琴曲歌辞 湘妃怨",
      "content": [
        "南巡竟不返，帝子怨逾积。",
        "万里丧蛾眉，潇湘水空碧。",
        "冥冥荒山下，古庙收贞魄。",
        "乔木深青春，清光满瑶席。",
        "搴芳徒有荐，灵意殊脉脉。",
        "玉佩不可亲，裴回烟波夕。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 255763,
      "title": "琴曲歌辞 列女操",
      "content": [
        "梧桐相待老，鸳鸯会双死。",
        "贞妇贵徇夫，舍生亦如此。",
        "波澜誓不起，妾心井中水。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 255835,
      "title": "杂曲歌辞 出门行二首 一",
      "content": [
        "长河悠悠去无极，百龄同此可叹息。",
        "秋风白露霑人衣，壮心凋落夺颜色。",
        "少年出门将诉谁，川无梁兮路无岐。",
        "一闻陌上苦寒奏，使我伫立惊且悲。",
        "君今得意厌粱肉，岂复念我贫贱时。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 255836,
      "title": "杂曲歌辞 出门行二首 二",
      "content": [
        "海风萧萧天雨霜，穷愁独坐夜何长？",
        "驱车旧忆太行险，始知游子悲故乡。",
        "美人相思隔天阙，长望云端不可越。",
        "手持琅玕欲有赠，爱而不见心断绝。",
        "南山峨峨白石烂，碧海之波浩漫漫。",
        "参辰出没不相待，我欲横天无羽翰。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 255849,
      "title": "杂曲歌辞 伤歌行",
      "content": [
        "众毒蔓贞松，一枝难久荣。",
        "岂知黄庭客，仙骨生不成。",
        "春色舍芳蕙，秋风遶枯茎。",
        "弹琴不成曲，始觉知音倾。",
        "馆月改旧照，吊宾写余情。",
        "还舟空江上，波浪送铭旌。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 255861,
      "title": "杂曲歌辞 妾薄命",
      "content": [
        "不惜十指弦，为君千万弹。",
        "常恐新声至，坐使故声残。",
        "弃置今日悲，即是昨日欢。",
        "将新变故易，持故为新难。",
        "青山有蘼芜，泪叶长不干。",
        "空令后代人，采掇幽思攒。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 255871,
      "title": "杂曲歌辞 羽林行",
      "content": [
        "朔雪寒断指，朔风劲裂冰。",
        "胡中射雕者，此日犹不能。",
        "翩翩羽林儿，锦臂飞苍鹰。",
        "挥鞭决白马，走出黄河凌。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 255948,
      "title": "杂曲歌辞 灞上轻薄行",
      "content": [
        "长安无缓步，况值天景暮。",
        "相逢灞浐间，亲戚不相顾。",
        "自叹方拙身，忽随轻薄伦。",
        "常恐失所避，化为车辙尘。",
        "此中生白发，疾走亦未歇。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 255950,
      "title": "杂曲歌辞 游侠行",
      "content": [
        "壮士性刚决，火中见石裂。",
        "杀人不回头，轻生如暂别。",
        "岂知眼有泪，肯白头上发。",
        "平生无恩酬，劒闲一百月。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 255955,
      "title": "杂曲歌辞 游子吟",
      "content": [
        "慈母手中线，游子身上衣。",
        "临行密密缝，意恐迟迟归。",
        "谁言寸草心，报得三春晖。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 255978,
      "title": "杂曲歌辞 车遥遥",
      "content": [
        "路喜到江尽，江上又通舟。",
        "舟车两无阻，何处不得游？",
        "丈夫四方志，女子安可留？",
        "郎自别日言，无令生远愁。",
        "旅鴈忽叫月，断猨寒啼秋。",
        "此夕梦君梦，君在百城楼。",
        "寄泪无因波，寄恨无因辀。",
        "愿为驭者手，与郎回马头。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 256052,
      "title": "杂曲歌辞 古离别二首 一",
      "content": [
        "松山云缭绕，萍路水分离。",
        "云去有归日，水分无合时。",
        "春芳役双眼，春色柔四支。",
        "杨柳织别愁，千条万条丝。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 256053,
      "title": "杂曲歌辞 古离别二首 二",
      "content": [
        "山川古今路，纵横无断绝。",
        "来往天地间，人皆有离别。",
        "行衣未束带，中肠已先结。",
        "不用看镜中，自知生白发。",
        "欲陈去留意，声向言前咽。",
        "愁结填心胸，茫茫若为说。",
        "荒郊烟莽苍，旷野风凄切。",
        "处处得相随，人那不如月。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 256160,
      "title": "杂曲歌辞 乐府三首 一",
      "content": [
        "莲子不可得，荷花生水中。",
        "犹胜道傍柳，无事荡春风。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 256161,
      "title": "杂曲歌辞 乐府三首 二",
      "content": [
        "渌萍与荷叶，同时一水中。",
        "风吹荷叶在，渌萍西复东。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 256162,
      "title": "杂曲歌辞 乐府三首 三",
      "content": [
        "莲花未开时，苦心终日卷。",
        "春水徒荡漾，荷花未开展。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
