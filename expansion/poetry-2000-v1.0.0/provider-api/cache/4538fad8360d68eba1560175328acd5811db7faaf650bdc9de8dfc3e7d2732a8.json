        "name": "其他"
      }
    },
    {
      "id": 265975,
      "title": "长安羁旅行",
      "content": [
        "十日一理发，每梳飞旅尘。",
        "三旬九过饮，每食唯旧贫。",
        "万物皆及时，独余不觉春。",
        "失名谁肯访，得意争相亲。",
        "直木有恬翼，静流无躁鳞。",
        "始知喧竞场，莫处君子身。",
        "野策藤竹轻，山蔬薇蕨新。",
        "潜歌归去来，事外风景真。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 265976,
      "title": "长安道",
      "content": [
        "胡风激秦树，贱子风中泣。",
        "家家朱门开，得见不可入。",
        "长安十二衢，投树鸟亦急。",
        "高阁何人家，笙簧正喧吸。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265977,
      "title": "送远吟",
      "content": [
        "河水昏复晨，河边相送频。",
        "离杯有泪饮，别柳无枝春。",
        "一笑忽然歛，万愁俄已新。",
        "东波与西日，不惜远行人。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265978,
      "title": "古薄命妾",
      "content": [
        "不惜十指弦，为君千万弹。",
        "常恐新声至，坐使故声残。",
        "弃置今日悲，即是昨日欢。",
        "将新变故易，持故为新难。",
        "青山有蘼芜，泪叶长不干。",
        "空令后代人，采掇幽思攒。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 265979,
      "title": "古离别",
      "content": [
        "松山云缭绕，萍路水分离。",
        "云去有归日，水分无合时。",
        "春芳役双眼，春色柔四支。",
        "杨柳织别愁，千条万条丝。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265980,
      "title": "杂怨 一",
      "content": [
        "忆人莫至悲，至悲空自衰。",
        "寄人莫剪衣，剪衣未必归。",
        "朝为双蒂花，莫为四散飞。",
        "花落还遶树，游子不顾期。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265981,
      "title": "杂怨 二",
      "content": [
        "夭桃花清晨，游女红粉新。",
        "夭桃花薄暮，游女红粉故。",
        "树有百年花，人无一定颜。",
        "花送人老尽，人悲花自闲。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265982,
      "title": "杂怨 三",
      "content": [
        "贫女镜不明，寒花日少容。",
        "暗蛩有虚织，短线无长缝。",
        "浪水不可照，狂夫不可从。",
        "浪水多散影，狂夫多异踪。",
        "持此一生薄，空城万恨浓。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 265983,
      "title": "静女吟",
      "content": [
        "艳女皆妬色，静女独检踪。",
        "任礼耻任粧，嫁德不嫁容。",
        "君子易求聘，小人难自从。",
        "此志谁与谅，琴弦幽韵重。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265984,
      "title": "归信吟",
      "content": [
        "泪墨洒为书，将寄万里亲。",
        "书去魂亦去，兀然空一身。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 265985,
      "title": "山老吟",
      "content": [
        "不行山下地，唯种山上田。",
        "腰斧斫旅松，手飘汲家泉。",
        "讵知文字力，莫记日月迁。",
        "蟠木为我身，始得全天年。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265986,
      "title": "游子吟",
      "content": [
        "慈母手中线，游子身上衣。",
        "临行密密缝，意恐迟迟归。",
        "谁言寸草心，报得三春晖。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 265987,
      "title": "小隐吟",
      "content": [
        "我饮不在醉，我欢长寂然。",
        "酌溪四五盏，听弹两三弦。",
        "炼性静栖白，洗情深寄玄。",
        "号怒路傍子，贪败不贪全。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265988,
      "title": "苦寒吟",
      "content": [
        "天寒色青苍，北风呌枯桑。",
        "厚冰无裂文，短日有冷光。",
        "敲石不得火，壮阴夺正阳。",
        "苦调竟何言，冻吟成此章。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265989,
      "title": "猛将吟",
      "content": [
        "拟脍楼兰肉，蓄怒时未扬。",
        "秋鼙无退声，夜剑不隐光。",
        "虎队手驱出，豹篇心卷藏。",
        "古今皆有言，猛将出北方。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265990,
      "title": "伤哉行",
      "content": [
        "众毒蔓贞松，一枝难久荣。",
        "岂知黄庭客，仙骨生不成。",
        "春色舍芳蕙，秋风遶枯茎。",
        "弹琴不成曲，始觉知音倾。",
        "馆月改旧照，吊宾写余情。",
        "还舟空江上，波浪送铭旌。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 265991,
      "title": "怨诗",
      "content": [
        "试妾与君泪，两处滴池水。",
        "看取芙蓉花，今年为谁死。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 265992,
      "title": "湘弦怨",
      "content": [
        "昧者理芳草，蒿兰同一锄。",
        "狂飙怒秋林，曲直同一枯。",
        "嘉木忌深蠹，哲人悲巧诬。",
        "灵均入回流，靳尚为良谟。",
        "我愿分众泉，清浊各异渠。",
        "我愿分众巢，枭鸾相远居。",
        "此志谅难保，此情竟何如。",
        "湘弦少知音，孤响空踟蹰。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 265993,
      "title": "楚竹吟酬卢虔端公见和湘弦怨",
      "content": [
        "握中有新声，楚竹人未闻。",
        "识音者谓谁，清夜吹赠君。",
        "昔为潇湘引，曾动潇湘云。",
        "一呌凤改听，再惊鹤失群。",
        "江花匪秋落，山日当昼曛。",
        "众浊响杂沓，孤清思氛氲。",
        "欲知怨有形，愿向明月分。",
        "一掬灵均泪，千年湘水文。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 265994,
      "title": "远愁曲",
      "content": [
        "飘飖何所从，遗冢行未逢。",
        "东西不见人，哭向青青松。",
        "此地有时尽，此哀无处容。",
        "声翻太白云，泪洗蓝田峰。",
        "水涉七八曲，山登千万重。",
        "愿邀玄夜月，出视白日踪。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 265995,
      "title": "贫女词寄从叔先辈简",
      "content": [
        "蚕女非不勤，今年独无春。",
        "二月冰雪深，死尽万木身。",
        "时令自逆行，造化岂不仁。",
        "仰企碧霞仙，高控沧海云。",
        "永别劳苦场，飘飖游无垠。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 265996,
      "title": "边城吟",
      "content": [
        "西城近日天，俗禀气候偏。",
        "行子独自渴，主人仍卖泉。",
        "烧烽碧云外，牧马青坡巅。",
        "何处鹘突梦，归思寄仰眠。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265997,
      "title": "新平歌送许问",
      "content": [
        "边柳三四尺，暮春离别歌。",
        "早回儒士驾，莫饮土番河。",
        "谁识匣中宝，楚云章句多。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 265998,
      "title": "杀气不在边",
      "content": [
        "杀气不在边，凛然中国秋。",
        "道险不在山，平地有摧辀。",
        "河南又起兵，清浊俱锁流。",
        "岂唯私客艰，拥滞官行舟。",
        "况余隔晨昏，去家成阻修。",
        "忽然两鬓雪，同是一日愁。",
        "独寝夜难晓，起视星汉浮。",
        "凉风荡天地，日夕声飕飗。",
        "万物无少色，兆人皆老忧。",
        "长策苟未立，丈夫诚可羞。",
        "灵响复何事，剑鸣思戮讐。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 265999,
      "title": "结爱",
      "content": [
        "心心复心心，结爱务在深。",
        "一度欲离别，千回结衣襟。",
        "结妾独守志，结君早归意。",
        "始知结衣裳，不如结心肠。",
        "坐结行亦结，结尽百年月。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 266000,
      "title": "弦歌行",
      "content": [
        "驱傩击鼓吹长笛，瘦鬼染面惟齿白。",
        "暗中崒崒拽茅鞭，倮足朱[裈]行戚戚。",
        "相顾笑声冲庭燎，桃弧射矢时独呌。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 266001,
      "title": "覆巢行",
      "content": [
        "荒城古木枝多枯，飞禽嗷嗷朝哺雏。",
        "枝倾巢覆雏坠地，乌鸢下啄更相呼。",
        "阳和发生均孕育，鸟兽有情知不足。",
        "枝危巢小风雨多，未容长成已先覆。",
        "灵枝珍木满上林，凤巢阿阁重且深。",
        "尔今所托非本地，乌鸢何得同尔心。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 266002,
      "title": "出门行 一",
      "content": [
        "长河悠悠去无极，百龄同此可叹息。",
        "秋风白露霑人衣，壮心凋落夺颜色。",
        "少年出门将诉谁，川无梁兮路无岐。",
        "一闻陌上苦寒奏，使我伫立惊且悲。",
        "君今得意厌粱肉，岂复念我贫贱时。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 266003,
      "title": "出门行 二",
      "content": [
        "海风萧萧天雨霜，穷愁独坐夜何长。",
        "驱车旧忆太行险，始知游子悲故乡。",
        "美人相思隔天阙，长望云端不可越。",
        "手持琅玕欲有赠，爱而不见心断绝。",
        "南山峩峩白石烂，碧海之波浩漫漫。",
        "参辰出没不相待，我欲横天无羽翰。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 266004,
      "title": "湘妃怨",
      "content": [
        "南巡竟不返，二妃怨逾积。",
        "万里丧蛾眉，潇湘水空碧。",
        "冥冥荒山下，古庙收贞魄。",
        "乔木深青春，清光满瑶席。",
        "搴芳徒有荐，灵意殊脉脉。",
        "玉佩不可亲，徘徊烟波夕。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 266005,
      "title": "巫山曲",
      "content": [
        "巴江上峡重复重，阳台碧峭十二峰。",
        "荆王猎时逢暮雨，夜卧高丘梦神女。",
        "轻红流烟湿艳姿，行云飞去明星稀。",
        "目极魂断望不见，猿啼三声泪滴衣。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 266006,
      "title": "巫山高",
      "content": [
        "见尽数万里，不闻三声猿。",
        "但飞萧萧雨，中有亭亭魂。",
        "千载楚王恨，遗文宋玉言。",
        "至今晴明天，云结深闺门。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 266007,
      "title": "楚怨",
      "content": [
        "秋入楚江水，独照汨罗魂。",
        "手把绿荷泣，意愁珠泪翻。",
        "九门不可入，一犬吠千门。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 266008,
      "title": "塘下行",
      "content": [
        "塘边日欲斜，年少早还家。",
        "徒将白羽扇，调妾木兰花。",
        "不是城头树，那栖来去鸦。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 266009,
      "title": "临池曲",
      "content": [
        "池中春蒲叶如带，紫菱成角莲子大。",
        "罗裙蝉鬓倚迎风，双双伯劳飞向东。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 266010,
      "title": "车遥遥",
      "content": [
        "路喜到江尽，江上又通舟。",
        "舟车两无阻，何处不得游。",
        "丈夫四方志，女子安可留。",
        "郎自别日言，无令生远愁。",
        "旅雁忽呌月，断猿寒啼秋。",
        "此夕梦君梦，君在百城楼。",
        "寄泪无因波，寄恨无因辀。",
        "愿为驭者手，与郎回马头。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 266011,
      "title": "征妇怨 一",
      "content": [
        "良人昨日去，明月又不圆。",
        "别时各有泪，零落青楼前。",
        "君泪濡罗巾，妾泪满路尘。",
        "罗巾长在手，今得随妾身。",
        "路尘如得风，得上君车轮。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 266012,
      "title": "征妇怨 二",
      "content": [
        "渔阳千里道，近如中门限。",
        "中门逾有时，渔阳长在眼。",
        "生在绿罗下，不识渔阳道。",
        "良人自戍来，夜夜梦中到。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 266013,
      "title": "空城雀",
      "content": [
        "一雀入官仓，所食宁损几。",
        "祗虑往覆频，官仓终害尔。",
        "鱼网不在天，鸟罗不张水。",
        "饮啄要自然，可以空城里。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 266014,
      "title": "闲怨",
      "content": [
        "妾恨比斑竹，下盘烦冤根。",
        "有笋未出土，中已含泪痕。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 266015,
      "title": "羽林行",
      "content": [
        "朔雪寒断指，朔风劲裂冰。",
        "胡中射雕者，此日犹不能。",
        "翩翩羽林儿，锦臂飞苍鹰。",
        "挥鞭快白马，走出黄河凌。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 266016,
      "title": "古意",
      "content": [
        "河边织女星，河畔牵牛郎。",
        "未得渡清浅，相对遥相望。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 266017,
      "title": "古别离",
      "content": [
        "欲别牵郎衣，郎今到何处。",
        "不恨归来迟，莫向临邛去。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 266018,
      "title": "游侠行",
      "content": [
        "壮士性刚决，火中见石裂。",
        "杀人不回头，轻生如𫏐别。",
        "岂知眼有泪，肯白头上发。",
        "半生无恩酬，剑闲一百月。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 266019,
      "title": "黄雀吟",
      "content": [
        "黄雀舞承尘，倚恃主人仁。",
        "主人忽不仁，买弹弹尔身。",
        "何不远飞去，蓬蒿正繁新。",
        "蒿粒无人争，食之足为珍。",
        "莫覰翻车粟，覰翻罪有因。",
        "黄雀不知言，赠之徒慇懃。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 266020,
      "title": "有所思",
      "content": [
        "桔槔烽火昼不灭，客路迢迢信难越。",
        "古镇刀攒万片霜，寒江浪起千堆雪。",
        "此时西去定如何，空使南心远凄切。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 266021,
      "title": "求仙曲",
      "content": [
        "仙教生为门，仙宗静为根。",
        "持心若妄求，服食安足论。",
        "铲惑有灵药，饵真成本源。",
        "自当出尘网，驭凤登昆仑。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 266022,
      "title": "婵娟篇",
      "content": [
        "花婵娟，泛春泉。",
        "竹婵娟，笼晓烟。",
        "妓婵娟，不长妍。",
        "月婵娟，真可怜。",
        "夜半姮娥朝太一，人间本自无灵匹。",
        "汉宫承宠不多时，飞燕婕妤相妬嫉。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 266023,
      "title": "南浦篇",
      "content": [
        "南浦桃花亚水红，水边柳絮由春风。",
        "鸟鸣喈喈烟蒙蒙，自从远送对悲翁。",
        "此翁已与少年别，唯忆深山深谷中。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 266024,
      "title": "清东曲",
      "content": [
        "樱桃花参差，香雨红霏霏。",
        "含笑竞攀折，美人湿罗衣。",
        "采采清东曲，明眸艳圭玉。",
        "青巾艑上郎，上下看不足。",
        "南阳公首词，编入新乐录。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 266025,
      "title": "望远曲",
      "content": [
        "朝朝候归信，日日登高台。",
        "行人未去植庭梅，别来三见庭花开。",
        "庭花开尽复几时，春光骀荡阻佳期。",
        "愁来望远烟尘隔，空怜绿鬓风吹白，何当归见远行客。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 266026,
      "title": "织妇辞",
      "content": [
        "夫是田中郎，妾是田中女。",
        "当年嫁得君，为君秉机杼。",
        "筋力日已疲，不息窻下机。",
        "如何织纨素，自著蓝缕衣。",
        "官家牓村路，更索栽桑树。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 266027,
      "title": "古意",
      "content": [
        "荡子守边戍，佳人莫相从。",
        "去来年月多，苦愁改形容。",
        "上山复下山，踏草成古踪。",
        "徒言采蘼芜，十度一不逢。",
        "鉴独是明月，识志唯寒松。",
        "井桃始开花，一见悲万重。",
        "人颜不再春，桃色有再浓。",
        "捐气入空房，无憀乍从容。",
        "启贴理针线，非独学裁缝。",
        "手持未染彩，绣为白芙蓉。",
        "芙蓉无染污，将以表心素。",
        "欲寄未归人，当春无信去。",
        "无信反增愁，愁心缘陇头。",
        "愿君如陇水，冰镜水还流。",
        "宛宛青丝线，纤纤白玉钩。",
        "玉钩不亏缺，青丝无断绝。",
        "回还胜双手，解尽心中结。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 266028,
      "title": "折杨柳 一",
      "content": [
        "杨柳多短枝，短枝多别离。",
        "赠远屡攀折，柔条安得垂。",
        "青春有定节，离别无定时。",
        "但恐人别促，不怨来迟迟。",
        "莫言短枝条，中有长相思。",
        "朱颜与绿杨，并在别离期。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 266029,
      "title": "折杨柳 二",
      "content": [
        "楼上春风过，风前杨柳歌。",
        "枝疎缘别苦，曲怨为年多。",
        "花惊燕地云，叶映楚池波。",
        "谁堪别离此，征戍在交河。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 266030,
      "title": "和丁助教塞上吟",
      "content": [
        "哭雪复吟雪，广文丁夫子。",
        "江南万里寒，曾未及如此。",
        "整顿气候谁，言从生灵始。",
        "无令恻隐者，哀哀不能已。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 266031,
      "title": "古怨别",
      "content": [
        "飒飒秋风生，愁人怨离别。",
        "含情两相向，欲语气先咽。",
        "心曲千万端，悲来却难说。",
        "别后唯所思，天涯共明月。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 266032,
      "title": "古别曲",
      "content": [
        "山川古今路，纵横无断绝。",
        "来往天地间，人皆有离别。",
        "行衣未束带，中肠已先结。",
        "不用看镜中，自知生白发。",
        "欲陈去留意，声向言前咽。",
        "愁结填心胸，茫茫若为说。",
        "荒郊烟莽苍，旷野风凄切。",
        "处处得相随，人那不如月。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 266033,
      "title": "戏赠陆大夫十二丈 一",
      "content": [
        "莲子不可得，荷花生水中。",
        "犹胜道傍柳，无事荡春风。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 266034,
      "title": "戏赠陆大夫十二丈 二",
      "content": [
        "渌萍与荷叶，同此一水中。",
        "风吹荷叶在，渌萍西复东。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 266035,
      "title": "戏赠陆大夫十二丈 三",
      "content": [
        "莲叶未开时，苦心终日卷。",
        "春水徒荡漾，荷花未开展。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 266036,
      "title": "劝善吟",
      "content": [
        "瘦郭有志气，相哀老龙钟。",
        "劝我少吟诗，俗窄难尔容。",
        "一口百味别，况在醉会中。",
        "四座正当喧，片言何由通。",
        "顾余昧时调，居止多疎慵。",
        "见书眼始开，闻乐耳不聪。",
        "视听互相隔，一身且莫同。",
        "天疾难自医，诗癖将何攻。",
        "见君如见书，语善千万重。",
        "自悲咄咄感，变作烦恼翁。",
        "烦恼不可欺，古剑澁亦雄。",
        "知君方少年，少年怀古风。",
        "藏书拄屋脊，不惜与凡聋。",
        "我愿拜少年，师之学崇崇。",
        "从他笑为矫，矫善亦可宗。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 266037,
      "title": "望夫石",
      "content": [
        "望夫石，夫不来兮江水碧。",
        "行人悠悠朝与莫，千年万年色如故。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 266038,
      "title": "寒江吟",
      "content": [
        "冬至日光白，始知阴气凝。",
        "寒江波浪冻，千里无平冰。",
        "飞鸟绝高羽，行人皆晏兴。",
        "荻洲素浩渺，埼岸澌碐磳。",
        "烟舟忽自阻，风帆不相乘。",
        "何况异形体，信任为股肱。",
        "涉江莫涉凌，得意须得朋。",
        "结交非贤良，谁免生爱憎。",
        "冻水有再浪，失飞有载腾。",
        "一言纵丑词，万响无善应。",
        "取鉴谅不远，江水千万层。",
        "何当春风吹，利涉吾道弘。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 266039,
      "title": "审交",
      "content": [
        "种树须择地，恶土变木根。",
        "结交若失人，中道生谤言。",
        "君子芳桂性，春荣冬更繁。",
        "小人槿花心，朝在夕不存。",
        "莫蹑冬冰坚，中有潜浪翻。",
        "唯当金石交，可以贤达论。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 266040,
      "title": "怨别",
      "content": [
        "一别一回老，志士白发早。",
        "在富易为容，居贫难自好。",
        "沉忧损性灵，服药亦枯槁。",
        "秋风游子衣，落日行远道。",
        "君问去何之，贱身难自保。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 266041,
      "title": "百忧",
      "content": [
        "萱草女儿花，不解壮士忧。",
        "壮士心是剑，为君射斗牛。",
        "朝思除国讐，暮思除国讐。",
        "计尽山河画，意穷草木筹。",
        "智士日千虑，愚夫唯四愁。",
        "何必在波涛，然后惊沈浮。",
        "伯伦心不醉，四皓迹难留。",
        "出处各有时，众议徒啾啾。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 266042,
      "title": "路病",
      "content": [
        "病客无主人，艰哉求卧难。",
        "飞光赤道路，内火焦肺肝。",
        "欲饮井泉竭，欲医囊用单。",
        "稚颜能几日，壮志忽已残。",
        "人子不言苦，归书但云安。",
        "愁环在我肠，宛转终无端。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 266043,
      "title": "衰松",
      "content": [
        "近世交道衰，青松落颜色。",
        "人心忌孤直，木性随改易。",
        "既摧栖日干，未展擎天力。",
        "终是君子材，还思君子识。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 266044,
      "title": "遣兴",
      "content": [
        "弦贞五条音，松直百尺心。",
        "贞弦含古风，直松凌高岑。",
        "浮声与狂葩，胡为欲相侵。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 266045,
      "title": "退居",
      "content": [
        "退身何所食，败力不能闲。",
        "种稻耕白水，负薪斫青山。",
        "众听喜巴唱，独醒愁楚颜。",
        "日莫静归时，幽幽扣松关。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 266046,
      "title": "卧病",
      "content": [
        "贫病诚可羞，故床无新裘。",
        "春色烧肌肤，时餐苦咽喉。",
        "倦寝意蒙昧，强言声幽柔。",
        "承颜自俛仰，有泪不敢流。",
        "默默寸心中，朝愁续莫愁。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
