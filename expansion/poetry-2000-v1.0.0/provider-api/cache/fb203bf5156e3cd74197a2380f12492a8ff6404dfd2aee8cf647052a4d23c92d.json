{
  "data": [
    {
      "id": 272862,
      "title": "赠廖道士",
      "content": [
        "膏已明煎信矣哉，二年人世不归来。",
        "庭前为报仙桃树，今岁花时好好开。"
      ],
      "author": {
        "id": 5966,
        "name": "李涉"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 272863,
      "title": "山花",
      "content": [
        "六出花开赤玉盘，当中红湿耐春寒。",
        "长安若在五侯宅，谁肯将钱买牡丹。"
      ],
      "author": {
        "id": 5966,
        "name": "李涉"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 272864,
      "title": "听歌",
      "content": [
        "飒飒先飞梁上尘，朱唇不动翠眉颦。",
        "愿得春风吹更远，直教愁杀满城人。"
      ],
      "author": {
        "id": 5966,
        "name": "李涉"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 272865,
      "title": "送颜觉赴举",
      "content": [
        "颜子将才应四科，料量时辈更谁过。",
        "居然一片荆山玉，可怕无人是卞和。"
      ],
      "author": {
        "id": 5966,
        "name": "李涉"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 272866,
      "title": "题五松驿",
      "content": [
        "云木苍苍数万株，此中言命的应无。",
        "人生不得如松树，却遇秦封作大夫。"
      ],
      "author": {
        "id": 5966,
        "name": "李涉"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 272867,
      "title": "湘妃庙",
      "content": [
        "班竹林边有古祠，鸟啼花发尽堪悲。",
        "当时惆怅同今日，南北行人可得知。"
      ],
      "author": {
        "id": 5966,
        "name": "李涉"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 272868,
      "title": "赠长安小主人",
      "content": [
        "上清真子玉童颜，花态娇羞月思闲。",
        "仙路迷人应有术，桃源不必在深山。"
      ],
      "author": {
        "id": 5966,
        "name": "李涉"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 272869,
      "title": "邠州词献高尚书三首 一",
      "content": [
        "单于都护再分疆，西引双旌出帝乡。",
        "朝日诏书添战马，即闻千骑取河湟。"
      ],
      "author": {
        "id": 5966,
        "name": "李涉"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 272870,
      "title": "邠州词献高尚书三首 二",
      "content": [
        "将家难立是威声，不见多传卫霍名。",
        "一自元和平蜀后，马头行处即长城。"
      ],
      "author": {
        "id": 5966,
        "name": "李涉"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 272871,
      "title": "邠州词献高尚书三首 三",
      "content": [
        "朔方忠义旧来闲，尽是邠城父子军。",
        "今日兵符归上将，旄头不用更妖氛。"
      ],
      "author": {
        "id": 5966,
        "name": "李涉"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 272872,
      "title": "游西林寺",
      "content": [
        "十地初心在此身，水能生月即离尘。",
        "如今再结林中社，可羡当年会里人。"
      ],
      "author": {
        "id": 5966,
        "name": "李涉"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 272873,
      "title": "题白鹿兰若",
      "content": [
        "只去都门十里强，竹阴流水遶回廊。",
        "满城车马皆知有，每唤同游尽道忙。"
      ],
      "author": {
        "id": 5966,
        "name": "李涉"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 272874,
      "title": "寄赵准乞湘川山居",
      "content": [
        "闲说班超有旧居，山横水曲占商于。",
        "知君不用磻溪石，乞取终年独钓鱼。"
      ],
      "author": {
        "id": 5966,
        "name": "李涉"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 272875,
      "title": "晓过函谷关",
      "content": [
        "因韩为赵两游秦，十月冰霜渡孟津。",
        "纵使鸡鸣遇关吏，不知余也是何人。"
      ],
      "author": {
        "id": 5966,
        "name": "李涉"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 272876,
      "title": "奉和九弟渤见寄绝句",
      "content": [
        "忽启新缄吟近诗，诗中韵出碧云词。",
        "且喜陟冈愁已散，登舟只恨渡江迟。"
      ],
      "author": {
        "id": 5966,
        "name": "李涉"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 272877,
      "title": "赠友人孩子",
      "content": [
        "骊龙颔下亦生珠，便与人间众宝殊。",
        "他时若要追风日，须得君家万里驹。"
      ],
      "author": {
        "id": 5966,
        "name": "李涉"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 272878,
      "title": "奉宣慰使鱼十四郎",
      "content": [
        "年才二十众知名，孤鹤仪容彻骨清。",
        "口传天语来人世，却逐祥云上玉京。"
      ],
      "author": {
        "id": 5966,
        "name": "李涉"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 272879,
      "title": "题善光寺",
      "content": [
        "云门天竺旧姻缘，临老移家住玉泉。",
        "早到可中涢南寺，免得翻经住几年。"
      ],
      "author": {
        "id": 5966,
        "name": "李涉"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 272880,
      "title": "题宣化寺道光上人居",
      "content": [
        "二十年前不系身，草堂曾与雪为邻。",
        "常思和尚当时语，衣钵留将与此人。"
      ],
      "author": {
        "id": 5966,
        "name": "李涉"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 272881,
      "title": "柳枝词",
      "content": [
        "锦池江上柳垂桥，风引蝉声送寂寥。",
        "不必如丝千万缕，只禁离恨两三条。"
      ],
      "author": {
        "id": 5966,
        "name": "李涉"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 272882,
      "title": "竹枝词",
      "content": [
        "十二山晴花尽开，楚宫双阙对阳台。",
        "细腰争舞君沈醉，白日秦兵天下来。"
      ],
      "author": {
        "id": 5966,
        "name": "李涉"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 272883,
      "title": "竹里",
      "content": [
        "竹里编茅倚石[根]，竹茎疎处见前村。",
        "闲眠尽日无人到，自有春风为扫门。"
      ],
      "author": {
        "id": 5966,
        "name": "李涉"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 272884,
      "title": "失题",
      "content": [
        "华表千年一鹤归，丹砂为顶雪为衣。",
        "泠泠仙语人听尽，却向五云翻翅飞。"
      ],
      "author": {
        "id": 5966,
        "name": "李涉"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 298063,
      "title": "濉阳行",
      "content": [
        "黄昏日暮驱羸马，夜宿濉阳烽火下。",
        "此地新经杀戮来，墟落无烟空碎瓦。",
        "层冰塞断隋朝水，一道银河贯千里。",
        "愁心翻覆梦难成，病仆呻吟呼不起。",
        "泗水三千招义军，本是征战邀殊勋。",
        "十年麾下蓄壮气，一朝此地为愁人。",
        "昨日太阳回照烛，转见天心重含育。",
        "早晚东风的发生，古堤春草年年绿。"
      ],
      "author": {
        "id": 5966,
        "name": "李涉"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298064,
      "title": "六叹 一",
      "content": [
        "蓬莱岛边采珠客，西望人寰星汉隔。",
        "千重叠浪耸云高，万里平沙连月白。",
        "海中洞穴寻难极，水底鲛人半相识。",
        "玄蚌初开影暂明，骊龙欲近威难逼。",
        "辛苦风涛白首期，得珠却恨求珠时。",
        "隋侯殁世几千载，只今薄俗空嗤嗤。"
      ],
      "author": {
        "id": 5966,
        "name": "李涉"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298065,
      "title": "六叹 二",
      "content": [
        "燕王爱贤筑金台，四方豪俊承风来。",
        "秦王烧书杀儒客，肘腋之中千里隔。",
        "去年八月幽幷道，昭王陵边哭秋草。",
        "今年二月游函关，秦家城外悲河山。",
        "河上山边车马路，残日青烟五陵树。"
      ],
      "author": {
        "id": 5966,
        "name": "李涉"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298066,
      "title": "六叹 三",
      "content": [
        "关东病儒客梁城，五岁十回逢乱兵。",
        "烧人之家食人肉，狼虎炽心都未足。",
        "城里愁云不开城，城头野草春还绿。",
        "五十余年忠烈臣，临难守节羞谋身。",
        "堂上英髦沈白刃，门前舆隶乘朱轮。",
        "千古伤心汴河水，阴天落日悲风起。"
      ],
      "author": {
        "id": 5966,
        "name": "李涉"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298067,
      "title": "却归巴陵途中走笔寄唐知言",
      "content": [
        "去年腊月来夏口，黑风白浪打头吼。",
        "橹声轧轧摇不前，看他撩乱张帆走。",
        "逾月始到鹦鹉洲，呜呜暮角喧城头。",
        "逡巡未得见官长，梦寝但觉生愁忧。",
        "军中贤倅李监察，人马晓来兼手札。",
        "教令参谒礼数全，头头要处相称掣。",
        "唐氏一门今五龙，声华殷殷皆如钟。",
        "就中十一最年少，别有俊气横心胸。",
        "巧缀五言才刮骨，却怕柱天身硉矹。",
        "后辈无劳续出头，坳塘不合窥溟渤。",
        "君家三兄旧山侣，方寸久来常许与。",
        "不觉淹留两月余，风光漫烂生洲渚。",
        "宇文文学儒家子，竹绕书斋花映水。",
        "醉舞狂歌此地多，有时酩酊扶还起。",
        "猥蒙方伯怜饥贫，假名许得陪诸宾。",
        "酒家债负有填日，恣意颇敢排青缗。",
        "余瞿二家同爱客，园蔬任遣奴人摘。",
        "野狐泉头银叶方，一别十年今再觌。",
        "更有风流歙奴子，能将盘帕来欺尔。",
        "白马青袍豁眼明，许他真是查郎髓。",
        "良会芳时难再来，隟光电影长相催。",
        "扁舟惆怅人南去，目断江天凡几回。"
      ],
      "author": {
        "id": 5966,
        "name": "李涉"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298068,
      "title": "山中五无奈何 一",
      "content": [
        "无奈落叶何，纷纷满衰草。",
        "疾来无气力，拥户不能扫。",
        "欲访云外人，都迷上山道。"
      ],
      "author": {
        "id": 5966,
        "name": "李涉"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298069,
      "title": "山中五无奈何 二",
      "content": [
        "无奈涧水何，喧喧夜鸣石。",
        "疎林透斜月，散乱金光滴。",
        "欲访涧底人，路穷潭水碧。"
      ],
      "author": {
        "id": 5966,
        "name": "李涉"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298070,
      "title": "山中五无奈何 三",
      "content": [
        "无奈阿鼎何，娇啼索梨栗。",
        "柴门正风雨，千向千回出。",
        "欲识老病心，赖渠将过日。"
      ],
      "author": {
        "id": 5966,
        "name": "李涉"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298071,
      "title": "山中五无奈何 四",
      "content": [
        "无奈梅花何，满岩光似雪。",
        "春风总未至，独自惊时节。",
        "欲见惆怅心，又看花上月。"
      ],
      "author": {
        "id": 5966,
        "name": "李涉"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 300870,
      "title": "杪春再游庐山（吴汝煜、胡可先云此诗为涉兄李渤作，见《唐才子传校笺》卷五。）",
      "content": [
        "二十七年别，烟云如昨辞。",
        "偶逢行春日，得遂归山期。",
        "晓驾出湓城，晚会东林师。",
        "巡廊阅众院，遍读新旧诗。",
        "萧魏故已尘，符杨亦川驰。",
        "拂床归尘壁，再覔旧游诗。",
        "南访静（应作「靖」）节居，石台有遗基。",
        "红葩列涧艳，碧茑悬林丝。",
        "迢递二霄峰，晴云间出危。",
        "坛空仙驭远，谷断啼猿悲。",
        "白鹿旧洞门，五老东一枝。",
        "当时手结茅，聚族长在玆。",
        "孙姪皆后来，非我昔所知。",
        "生为前世翁，安得不涕垂？",
        "白髪唯两人，形骸久支离。",
        "虽同故山会，草草如路歧。",
        "惆怅尘中身，何由重来斯。",
        "无令诮余者，更效《北山移》。",
        "（见《分门纂类唐歌诗》残本第二册《天地山川类》卷二十二。"
      ],
      "author": {
        "id": 5966,
        "name": "李涉"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 303734,
      "title": "李独携酒见访",
      "content": [
        "晓斋独坐霜景寒，草堂逸士来相干。",
        "风神左峭心意濶。",
        "自言山中新酝熟，手挈一壶兼一轴。",
        "果然文字称仪容，已觉建安风彩俗。",
        "嗟予潦倒身无成，偶因章句生浮名。",
        "就中怜爱李景俭，酒狂大语欺奴兵。",
        "老夫昔逐巴江岸，唱得《竹枝》肠欲断。",
        "为君试发一声看，九派烟霞愁漫漫。",
        "（影印本《诗渊》第一册一三一页）。"
      ],
      "author": {
        "id": 5966,
        "name": "李涉"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 303735,
      "title": "赠苏小",
      "content": [
        "地人仙人家洛浦，闻道新年年十五。",
        "巧转明眸双剑连，开粧一面千花吐。",
        "流苏帐，云母屏，碧罗作卷花亭亭。",
        "昆仑阿母暗钩引，东海麻姑投姓名。",
        "梭能织诗筝解语，鸳鸯难称烟波侣。",
        "偶逢曼倩巧言词，不觉投花忽相许。",
        "自言夫婿心不骨，黄金买笑轻侯王。",
        "掌中看舞腰欲断，暗里听歌愁满堂。",
        "莫学为云去无迹，巫山高高接天碧。",
        "（同前第五五一页）。"
      ],
      "author": {
        "id": 5966,
        "name": "李涉"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 303736,
      "title": "商州（题拟）",
      "content": [
        "宫址蔓生草，洞门低枕泉。",
        "废兴人目击，何处是神仙？",
        "（《记纂渊海》卷二四）。"
      ],
      "author": {
        "id": 5966,
        "name": "李涉"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 335242,
      "title": "杂曲歌辞：鹧鸪词",
      "content": [
        "湘江烟水深，沙岸隔枫林。",
        "何处鹧鸪飞，日斜斑竹阴。",
        "二女虚垂泪，三闾枉自沉。",
        "惟有鹧鸪鸟，独伤行客心。",
        "越冈连越井，越鸟更南飞。",
        "何处鹧鸪啼，夕烟东岭归。",
        "岭头行人少，天涯北客稀。",
        "鹧鸪啼别处，相对泪沾衣。"
      ],
      "author": {
        "id": 5966,
        "name": "李涉"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 335266,
      "title": "杂曲歌辞：竹枝",
      "content": [
        "荆门滩急水潺潺，两岸猿啼烟满山。",
        "渡头年少应官去，月落西陵望不还。",
        "巫峡云开神女祠，绿潭红树影参差。",
        "下牢戍口初相问，无义滩头剩别离。",
        "石壁千重树万重，白云斜掩碧芙蓉。",
        "昭君溪上年年月，独自婵娟色最浓。",
        "十二峰头月欲低，空蒙江上子规啼。",
        "孤舟一夜东归客，泣向春风忆建溪。"
      ],
      "author": {
        "id": 5966,
        "name": "李涉"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 355794,
      "title": "题清溪鬼谷先生旧居",
      "content": [
        "翠壁开天池，青崖列云树。",
        "水容不可状，杳若清河雾。",
        "常闻先生教，指示秦仪路。",
        "二子才不同，逞词过尺度。",
        "偶因从吏役，远到冥栖处。",
        "松月想旧山，烟霞了如故。",
        "未遑炼金鼎，日觉容光暮。",
        "万虑随境生，何由返真素。",
        "寂寞天籁息，清迥鸟声曙。",
        "回首望重重，无期挹风驭。"
      ],
      "author": {
        "id": 5966,
        "name": "李涉"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 355796,
      "title": "鹧鸪词二首",
      "content": [
        "湘江烟水深，沙岸隔枫林。",
        "何处鹧鸪飞，日斜斑竹阴。",
        "二女空垂泪，三闾枉自沉。",
        "惟有鹧鸪啼，独伤行客心。",
        "越冈连越井，越鸟更南飞。",
        "何处鹧鸪啼，夕烟东岭归。",
        "岭外行人少，天涯北客稀。",
        "鹧鸪啼别处，相对泪沾衣。"
      ],
      "author": {
