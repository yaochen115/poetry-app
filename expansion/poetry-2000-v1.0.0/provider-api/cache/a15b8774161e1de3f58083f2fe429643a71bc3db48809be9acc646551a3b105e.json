{
  "data": [
    {
      "id": 3685,
      "title": "某以雨有嘉应遂占有秋辄采用家弟韵赋二绝句少赀勤恤之诚也  其二",
      "content": [
        "纪德刊碑不厌丰，龙眠深洞一言通。",
        "坐看绿浪摇千里，拔薤栽榆未当功。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 3686,
      "title": "梅",
      "content": [
        "爱歌纤影上窗纱，无限轻香夜遶家。",
        "一阵东风湿残雪，强将娇泪学梨花。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 3687,
      "title": "蒙知府宠示秋日郡圃佳制遂侍杖屦逍遥林水间辄次韵四篇上渎台览  其一",
      "content": [
        "岁月移文外，乾坤杖屦中。",
        "铿然五字律，健在百夫雄。",
        "秋入池深碧，寒欺叶递红。",
        "此间兼吏隐，端不减游嵩。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 3688,
      "title": "蒙知府宠示秋日郡圃佳制遂侍杖屦逍遥林水间辄次韵四篇上渎台览  其二",
      "content": [
        "鸟语知公乐，晴山及我游。",
        "尽排物外事，拚作酒中浮。",
        "菊蕊离双鬓，林声隐四愁。",
        "骚人例喜赋，政自不关秋。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 3689,
      "title": "蒙知府宠示秋日郡圃佳制遂侍杖屦逍遥林水间辄次韵四篇上渎台览  其三",
      "content": [
        "竹际笙簧起，回听众籁微。",
        "时陪物外赏，肯念日斜归。",
        "草色违秋意，池光浄客衣。",
        "吟公清绝句，政尔不能肥。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 3690,
      "title": "蒙知府宠示秋日郡圃佳制遂侍杖屦逍遥林水间辄次韵四篇上渎台览  其四",
      "content": [
        "一笑聊开口，千忧不上眉。",
        "林深受风得，柏老到霜知。",
        "小憩逢筠洞，幽寻及枳篱。",
        "愿公勤秉烛，裁咏枣离离。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 3691,
      "title": "送人归京师",
      "content": [
        "门外子规啼未休，山村日落梦悠悠。",
        "故园便是无兵马，犹有归时一段愁。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 3692,
      "title": "雪",
      "content": [
        "仙人手持白鸾尾，夜半朝元明月里。",
        "羽衣三振风不断，下视银潢一千里。",
        "玉轪载花分后前，欲落未落天恍然。",
        "余标从向人间去，乞与袁安破晓眠。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 3693,
      "title": "赋康平老铜雀砚",
      "content": [
        "邺城台殿已荒凉，依旧山河满夕阳。",
        "瓦砾却镵今日砚，似教人世写兴亡。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 3694,
      "title": "和颜持约",
      "content": [
        "半篙寒碧秋垂钓，一笛西风夜倚楼。",
        "多少巫山旧家事，老来分付水东流。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 3695,
      "title": "早行",
      "content": [
        "露侵驼褐晓寒轻，星斗阑干分外明。",
        "寂寞小桥和梦过，稻田深处草虫鸣。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 3696,
      "title": "寄题康平老眄柯亭",
      "content": [
        "高怀志丘壑，既足不愿余。",
        "惜哉三迳荒，滞彼天一隅。",
        "小筑聊自适，空园辟榛芜。",
        "清影吊高槐，气与西山俱。",
        "何以开子颜，庭柯作森疏。",
        "月露洗尘翳，天风吹笙竽。",
        "方其寓目时，万象供啸呼。",
        "终然成坐忘，天地犹空虚。",
        "券外果何有，浮云只须臾。",
        "乃知钟鼎丰，未胜山林癯。",
        "渊明死千年，日月走名誉。",
        "不肯见督邮，归来守旧庐。",
        "可怜骨已朽，后有谁继渠。",
        "愿子副名实，此事吾欲书。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3697,
      "title": "余识景纯家弟出其诗见示喜其同臭味也辄用大成黄字韵赋八句赠之",
      "content": [
        "阿奴喜气照人黄，传得新诗细作行。",
        "可爱悬知似杨柳，忘忧复不待槟榔。",
        "魏收已获崔昂誉，摩诘仍推相国长。",
        "曷不少留东合醉，剩收篇咏作归装。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 3698,
      "title": "次韵景纯道中寄大成",
      "content": [
        "闻道歌行伏李绅，古来贤守是诗人。",
        "久钦乐广怀披雾，一见周瑜胜饮醇。",
        "海内期公黄合老，尊前容我白纶巾。",
        "佳篇咀嚼真堪饱，此日何忧甑有尘。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 3699,
      "title": "再蒙宠示佳什殆无遗巧勉成二章一以报佳贶一以自贻  其一",
      "content": [
        "睆睆休嫌笏与绅，如公本是九包人。",
        "读书只用三冬足，学道从来一色醇。",
        "太尉谈辞仍玉麈，侍中风韵更纱巾。",
        "谁言上界多官府，亦许散仙追后尘。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 3700,
      "title": "再蒙宠示佳什殆无遗巧勉成二章一以报佳贶一以自贻  其二",
      "content": [
        "诸公衮衮坐垂绅，谁信北风欺得人。",
        "遮眼读书何用解，发颜要酒可须醇。",
        "十年白社空看镜，万里青天一岸巾。",
        "少待奇章到三日，试将冠盖拂埃尘。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 3701,
      "title": "同家弟用前韵谢判府惠酒  其一",
      "content": [
        "衔杯乐圣便称贤，无酒犹堪卧瓮间。",
        "使者在门催仆仆，曲车入梦正班班。",
        "不烦白水真人力，来自青城道士山。",
        "千载王弘同并美，未应杞菊赋寒悭。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 3702,
      "title": "同家弟用前韵谢判府惠酒  其二",
      "content": [
        "日饮知非贫士宜，要逃语穽税心鞿。",
        "所须唯酒非虚语，以醉为乡可径归。",
        "鹦鹉鸬鹚俱得道，螟蛉蜾蠃共忘机。",
        "狂言戏作麻姑送，无奈阍人与我违。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 3703,
      "title": "次韵家弟所赋",
      "content": [
        "曹刘方驾信优为，不废东郊坐保厘。",
        "投蚓问公逢老手，联珠及我愧连枝。",
        "定知来者倾三叹，共了流年费几诗。",
        "瘀絮车斜敢将去，乐天那畏一微之。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 3704,
      "title": "徙舍蒙大成赐诗",
      "content": [
        "南北东西共一尘，得坻随处可收身。",
        "卜居赋就知谋拙，入宅诗成觉意新。",
        "三径蓬蒿犹恨浅，九流宾客未嫌贫。",
        "不须更待高轩过，袖有珠玑已照邻。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 3705,
      "title": "次韵宋主簿诗",
      "content": [
        "九折湾中万斛舟，怪公随处得心休。",
        "未应菊径关心急，聊为鱼槎尽意留。",
        "陆子旧踪余马顶，羊公遗碣见龟头。",
        "遥知太白无多事，醉里诗成不待搜。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 3706,
      "title": "用大成四桂坊韵赋诗赠令狐昆仲",
      "content": [
        "乡人洗眼看银黄，得桂连枝手尚香。",
        "盛事固应传雁塔，新诗不减住鸡坊。",
        "醍酥乳酪元同味，羯末封胡更合堂。",
        "从此葛恢门下客，知名可但一杨方。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 3707,
      "title": "留别葛汝州",
      "content": [
        "平生师友尘莫数，两眼偏明向公许。",
        "一时盛德人中骥，四海知名地上虎。",
        "东序阶墀再靴板，西州杖屦三寒暑。",
        "我方庶兄汤惠休，公乃小儿杨德祖。",
        "未颁还朝尺一诏，不愧专城丈二组。",
        "为公剩买银管笔，容我时亲玉柄麈。",
        "近蒙五字落珠玑，如服一丸生翅羽。",
        "别离真成惜夜烛，感叹更值歌朝雨。",
        "行看入侍玉皇案，与进不待金刚杵。",
        "劝公慎勿学孔光，荐士何妨似张禹。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3708,
      "title": "蒙赐佳什钦叹不足不揆浅陋辄次元韵",
      "content": [
        "退之高文仰东岱，籍湜传盟其足赖。",
        "固知法嗣要龙象，先生端是毗陵派。",
        "方驾曹刘盖余力，压倒元白聊一快。",
        "向来班门收众材，宾履费公珠几琲。",
        "三熏会有堪此事，群犬未免惊所怪。",
        "但知楼仰百尺颠，岂觉波涵千顷外。",
        "南州短簿令公喜，巍峩峩冠陆离佩。",
        "有如若士那可无，笔势已超声律界。",
        "相将问道留十日，满座真成折床会。",
        "清诗忽复堕华牋，要使握瑜夸等辈。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3709,
      "title": "某蒙示咏家弟所撰班史属辞长句三叹之余辄用元韵以示家弟谨布师席",
      "content": [
        "隽永杂俎虽甚旨，何似三冬足文史。",
        "羡子皮里西京书，议论逼人惊亹亹。",
        "戏为语韵网所遗，人皆百能子千之。",
        "虽非张巡遍记诵，岂与李翰争毫厘。",
        "不待区区隶古定，便令景宗知去病。",
        "掇要虚烦四十篇，三卷之博能拟圣。",
        "儒林丈人摛藻春，作诗印可融心神。",
        "我亦从今悔迂学，不须更辨瓒称臣。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3710,
      "title": "蒙再示属辞三叹之余赞巨丽无地托言辄依元韵再成一章非独助家弟称谢区区少褒之使进学焉亦师席善诱之意也",
      "content": [
        "书如嘉殽要知旨，区区太冲空咏史。",
        "百年能挂几牛角，火急编摩时亹亹。",
        "柳家文类今无遗，可忍行事空违之。",
        "此书真是群玉府，事辞所不遗毫厘。",
        "子不见刘勰书成要人定，岂但令人愈头病。",
        "偶向车前问沈公，果符梦里随先圣。",
        "两诗入手喜生春，从今护持知有神。",
        "便可缮写持献御，注解不须烦五臣。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3711,
      "title": "昨日侍巾钵饭于天宁蒙示佳什谨次韵",
      "content": [
        "朱门未知禅悦义，富不期奢奢自至。",
        "二韮虽寒故是公，万羊贾祸徒封卫。",
        "我公居尘不染尘，便随一钵遗甘辛。",
        "出家虽非将相事，食菜要是英雄人。",
        "臞儒一生用心苦，何曾梦见鸡映黍。",
        "中丞惜福幸见分，晚食从公当羔羜。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3712,
      "title": "蒙再示佳什不敢虚辱厚赐谨再用韵",
      "content": [
        "先生明经今蔡义，念佛仍师大势至。",
        "食菜不待周颙书，要断贪杀兼自卫。",
        "颜回平生拾堕尘，蓼虫食蓼忘其辛。",
        "先生种福我无祸，成佛定是同功人。",
        "两诗见戒言甚苦，肯赋黄鸡啄秋黍。",
        "从今但见懒残芋，不敢求尝鉴虚羜。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3713,
      "title": "承知府待制诞生之辰辄广善怀菩萨故事成古诗一首仰惟经世之外深入佛海而某欲托辞以寄款款适获此事发寤于心似非偶然者独荒陋不足以侈此殊庆耳",
      "content": [
        "岁星欲吐芒不开，昴星避次光低佪。",
        "麒麟鸑鷟纷夹侍，善怀菩萨当重来。",
        "仙公风流今几岁，再托高门瑞当世。",
        "买香趁浴惊众聋，要识此僧今我是。",
        "金粟后身何足言，释迦亲送非虚传。",
        "稽首西来大菩萨，住世小劫须千年。",
        "宰官说法聊应会，余事文章亦三昧。",
        "世间底物堪寿公，本自金刚无可坏。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3714,
      "title": "游紫逻洞",
      "content": [
        "我不愿封万户侯，愿向紫逻从公游。",
        "郓州溪堂虢州洞，未有退之诗可留。",
        "水近山流清澈底，竹饱千霜节如此。",
        "廊庙之具千金躯，底事便著山岩里。",
        "蒲鞭挂壁一事无，环珮声中了朝晡。",
        "祝融不到林深处，客至五月怀貂狐。",
        "徇华大夫无此乐，从渠遮山用翠幙。",
        "若问此间奇绝处，但道胸中有丘壑。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3715,
      "title": "研铭",
      "content": [
        "无住庵，老居士。",
        "紫玉池，娱晚岁。",
        "不出庵，书诵偈。",
        "谁使之，践朝市。",
        "入承明，司帝制。",
        "如眢井，久不治。",
        "百尺泉，来莫冀。",
        "古之人，轻百计。",
        "惟出处，不敢易。",
        "嗟已晚，觉非是。",
        "勒斯铭，戒后世。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3716,
      "title": "曾徽言运判出张生所画马",
      "content": [
        "槃礴解衣处，胸中应不群。",
        "未呈千里足，空见五花文。",
        "良乐世难有，骥驽谁与分。",
        "高才喜能事，故遣画兰筋。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 3717,
      "title": "火蛾",
      "content": [
        "阳光不照临，积阴生此类。",
        "非无惜死心，素有贼明意。",
        "粉穿红焰燋，翅扑兰膏沸。",
        "为尔一伤嗟，自弃非天弃。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 3718,
      "title": "海棠",
      "content": [
        "红粧翠袖一番新，人向园林作好春。",
        "却笑华清夸睡足，只今罗袜久无尘。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 3719,
      "title": "烧香",
      "content": [
        "明窗延静昼，默坐息诸缘。",
        "聊将无穷意，寓此一炷烟。",
        "当时戒定慧，妙供均人天。",
        "我岂不清□，于今醒心然。",
        "炉香袅孤碧，云缕飞数千。",
        "悠然凌空去，缥缈随风还。",
        "世事有过现，薰性无变迁。",
        "应如水中月，波定还自丸。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3720,
      "title": "红葵",
      "content": [
        "恐是牡丹重换紫，又疑芍药再飞红。",
        "妖娆不辨桑间女，蔽芾深迷苎下翁。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 3721,
      "title": "山居",
      "content": [
        "耿耿虚堂一榻秋，人间高枕几王侯。",
        "乱云未放晓山出，片月不随寒水流。",
        "检校一身浑是懒，平章千古得无愁。",
        "湘波见说清人骨，恨不移家阿那州。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 3722,
      "title": "雨过",
      "content": [
        "水堂长日静鸥沙，便觉京尘隔鬓华。",
        "梦里不知凉是雨，卷帘微湿在荷花。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 3723,
      "title": "长干行",
      "content": [
        "妾家长干里，春慵晏未起。",
        "花香袭梦回，略略事梳洗。",
        "妆台罢窥镜，盛色照江水。",
        "郎帆十幅轻，浑不闻橹声。",
        "曲岸转掀篷，一见兮目成。",
        "羞闻媒致辞，心许郎深情。",
        "一床两年少，相看悔不早。",
        "酒懽娱藏阄，园嬉索鬬草。",
        "含笑盟春风，同心以偕老。",
        "郎行有程期，郎知妾未知。",
        "鹢首生羽翼，蛾眉无光辉。",
        "寄来纸上字，不尽心中事。",
        "问遍相逢人，不如自见真。",
        "心苦泪更苦，滴烂闺中土。",
        "寄语里中儿，莫作商人妇。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3724,
      "title": "九日家中",
      "content": [
        "风雨吴江冷，云天故国赊。",
        "扶头呼白酒，揩眼认黄花。",
        "客梦蛩声歇，边心雁字斜。",
        "明年又何处，高树莫啼鸦。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 3725,
      "title": "来禽",
      "content": [
        "粲粲来禽已著花，芳根谁徙向天涯。",
        "好寻青李相遮映，风味应同逸少家。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 3726,
      "title": "宣风楼",
      "content": [
        "楼迥云随画栱飞，卷帘又映雪晴时。",
        "千林冻解阴霾扫，放出青山分外奇。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 3727,
      "title": "万玉亭",
      "content": [
        "万玉中间作此亭，规模虽小意高深。",
        "稚篁畏日生檐下，老树禁风长绿阴。",
        "不道官中尽汤火，谁知闹里有山林。",
        "公余独在斜阳外，百岁顽身万古心。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 3728,
      "title": "句",
      "content": [
        "老对白桂花。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 330456,
      "title": "法驾导引",
      "content": [
        "朝元路，朝元路，同驾玉华君。",
        "千乘载花红一色，人间遥指是祥云。",
        "回望海光新。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 330457,
      "title": "法驾导引",
      "content": [
        "东风起，东风起，海上百花摇。",
        "十八风鬟云半动，飞花和雨著轻绡。",
        "归路碧迢迢。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 330458,
      "title": "法驾导引",
      "content": [
        "帘漠漠，帘漠漠，天澹一帘秋。",
        "自洗玉舟斟白醴，月华微映是空舟。",
        "歌罢海西流。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 330459,
      "title": "虞美人",
      "content": [
        "十年花底承潮露。",
        "看到江南树。",
        "洛阳城里又东风。",
        "未必桃花得似、旧时红。",
        "胭脂睡起春才好。",
        "应恨人空老。",
        "心情虽在只吟诗。",
        "白发刘郎孤负、可怜枝。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 330460,
      "title": "忆秦娥",
      "content": [
        "鱼龙舞。",
        "湘君欲下潇湘浦。",
        "潇湘浦。",
        "兴亡离合，乱波平楚。",
        "独无尊酒酬端午。",
        "移舟来听明山雨。",
        "明山雨。",
        "白头孤客，洞庭怀古。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 330461,
      "title": "临江仙",
      "content": [
        "高咏楚词酬午日，天涯节序匆匆。",
        "榴花不似舞裙红。",
        "无人知此意，歌罢满帘风。",
        "万事一身伤老矣，戌葵凝笑墙东。",
        "酒杯深浅去年同。",
        "试浇桥下水，今夕到湘中。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 330462,
      "title": "虞美人",
      "content": [
        "张帆欲去仍搔首。",
        "更醉君家酒。",
        "吟诗日日待春风。",
        "及至桃花开后、却匆匆。",
        "歌声频为行人咽。",
        "记著尊前雪。",
        "明朝酒醒大江流。",
        "满载一船离恨、向衡州。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 330463,
      "title": "点绛唇",
      "content": [
        "寒食今年，紫阳山下蛮江左。",
        "竹篱烟锁。",
        "何处求新火。",
        "不解乡音，只怕人嫌我。",
        "愁无那。",
        "短歌谁和。",
        "风动梨花朵。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 330464,
      "title": "虞美人",
      "content": [
        "超然堂上闲宾主。",
        "不受人间暑。",
        "冰盘围坐此州无。",
        "却有一瓶和露、玉芙蕖。",
        "亭亭风骨凉生牖。",
        "消尽尊中酒。",
        "酒阑明月转城西。",
        "照见纱巾藜杖、带香归。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 330465,
      "title": "渔家傲",
      "content": [
        "今日山头云欲举。",
        "青蛟素凤移时舞。",
        "行到石桥闻细雨。",
        "听还住。",
        "风吹却过溪西去。",
        "我欲寻诗宽久旅。",
        "桃花落尽春无所。",
        "渺渺篮舆穿翠楚。",
        "悠然处。",
        "高林忽送黄鹂语。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 330466,
      "title": "虞美人",
      "content": [
        "扁舟三日秋塘路。",
        "平度荷花去。",
        "病夫因病得来游。",
        "更值满川微雨、洗新秋。",
        "去年长恨拿舟晚。",
        "空见残荷满。",
        "今年何以报君恩。",
        "一路繁花相送、过青墩。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 330467,
      "title": "浣溪沙",
      "content": [
        "送了栖鸦复暮钟。",
        "栏干生影曲屏东。",
        "卧看孤鹤驾天风。",
        "起舞一尊明月下，秋空如水酒如空。",
        "谪仙已去与谁同。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 330468,
      "title": "玉楼春",
      "content": [
        "山人本合居岩岭。",
        "聊问支郎分半境。",
        "残年藜杖与纶巾，八尺庭中时弄影。",
        "呼儿汲水添茶鼎。",
        "甘胜吴山山下井。",
        "一瓯清露一炉云，偏觉平生今日永。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 330469,
      "title": "清平乐",
      "content": [
        "黄衫相倚。",
        "翠葆层层底。",
        "八月江南风日美。",
        "弄影山腰水尾。",
        "楚人未识孤妍。",
        "离骚遗恨千年。",
        "无住庵中新事，一枝唤起幽禅。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 330470,
      "title": "定风波",
      "content": [
        "九日登临有故常。",
        "随晴随雨一传觞。",
        "多病题诗无好句。",
        "孤负。",
        "黄花今日十分黄。",
        "记得眉山文翰老。",
        "曾道。",
        "四时佳节是重阳。",
        "江海满前怀古意。",
        "谁会。",
        "阑干三抚独凄凉。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 330471,
      "title": "菩萨蛮",
      "content": [
        "南轩面对芙蓉浦。",
        "宜风宜月还宜雨。",
        "红少绿多时。",
        "帘前光景奇。",
        "绳床乌木几。",
        "尽日繁香里。",
        "睡起一篇新。",
        "与花为主人。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 330472,
      "title": "南柯子・南歌子",
      "content": [
        "矫矫千年鹤，茫茫万里风。",
        "阑干三面看秋空。",
        "背插浮屠千尺、冷烟中。",
        "林坞村村暗，溪流处处通。",
        "此间何似玉霄峰。",
        "遥望蓬莱依约、晚云东。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 330473,
      "title": "临江仙",
      "content": [
        "忆昔午桥桥上饮，坐中多是豪英。",
        "长沟流月去无声。",
        "杏花疏影里，吹笛到天明。",
        "二十馀年如一梦，此身虽在堪惊。",
        "闲登小阁看新晴。",
        "古今多少事，渔唱起三更。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
