{
  "data": [
    {
      "id": 3285,
      "title": "窦园醉中前后五绝句  其三",
      "content": [
        "不见海棠相似人，空题诗句满花身。",
        "酒阑却度荒陂去，驱使风光又一春。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 3286,
      "title": "窦园醉中前后五绝句  其四",
      "content": [
        "三月碧桃惊动人，满园光景一时新。",
        "剩倾老子樽中玉，折尽残枝不要春。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 3287,
      "title": "窦园醉中前后五绝句  其五",
      "content": [
        "一樽相属莫辞空，报答今朝吹面风。",
        "自唱新诗与明月，碧桃开尽曲声中。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 3288,
      "title": "雨",
      "content": [
        "沙岸残春雨，茅檐古镇官。",
        "一时花带泪，万里客凭栏。",
        "日晚蔷薇重，楼高燕子寒。",
        "惜无陶谢手，尽力破忧端。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 3289,
      "title": "食笋",
      "content": [
        "竹君家多材，楚楚皆席珍。",
        "成行著锦袍，玉色映市人。",
        "惠然集吾宇，老眼檐光新。",
        "曲生亦税驾，共慰藜藿贫。",
        "不待月与影，三人宛相亲。",
        "可怜管城子，头秃事苦辛。",
        "按谱虽同宗，闻道隔几尘。",
        "诗成聊使写，一笑惊比邻。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3290,
      "title": "初夏游八关寺",
      "content": [
        "闭门睡过春，出门绿满城。",
        "八关池上柳，絮罢但藏莺。",
        "世故剧千猬，今朝此闲行。",
        "草木随时好，客恨终难平。",
        "寺有石壁胜，诗无康乐声。",
        "扶鞍不得上，新月水中生。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3291,
      "title": "题酒务壁",
      "content": [
        "野马本不羁，无奈卯与申。",
        "当时彭泽令，定是英雄人。",
        "客来两绳床，客去一欠伸。",
        "市声自杂沓，炉烟自轮囷。",
        "莺声时节改，杏叶雨气新。",
        "佳句忽堕前，追摹已难真。",
        "自题西轩壁，不杂徐庾尘。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3292,
      "title": "秋夜咏月",
      "content": [
        "庭树日日疏，稍觉夜月添。",
        "推愁了此段，卷我三间帘。",
        "黄花墙阴远，白发露气严。",
        "平生六尺影，随我送凉炎。",
        "踏破千忧地，投老乃自嫌。",
        "尚想采石江，宫锦映霜蟾。",
        "夜半赋诗成，起舞鱼龙兼。",
        "办此讵难事，取快端宜廉。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3293,
      "title": "入城",
      "content": [
        "竹舆声伊鸦，路转登古原。",
        "孟冬郊泽旷，细水鸣芦根。",
        "雾收浮屠立，天阔鸿雁奔。",
        "平生厌喧闹，快意三家村。",
        "思生长林内，故园归不存。",
        "欲为唐衢哭，声出且复吞。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3294,
      "title": "夜步隄上三首  其一",
      "content": [
        "世故生白发，意行无与期。",
        "平生木上座，临老始相知。",
        "月中沙岸永，岁暮河流迟。",
        "留侯庙前柳，叶尽空离离。",
        "百年信难料，剩赋奇绝诗。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3295,
      "title": "夜步隄上三首  其二",
      "content": [
        "人间睡声起，幽子方独步。",
        "倚杖看白云，亭亭水中度。",
        "十月雁背高，三更河流去。",
        "物生各扰扰，念此煎百虑。",
        "聊将忧世心，数遍桥西树。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3296,
      "title": "夜步隄上三首  其三",
      "content": [
        "旋买青芒鞋，去踏沙头月。",
        "争教冠盖地，著此影突兀。",
        "树寒栖鸟动，风转孤管发。",
        "月色夜夜佳，人生事如发。",
        "梦中续清游，浓露湿银阙。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3297,
      "title": "早起",
      "content": [
        "竟夜闻落木，雨歇窗如新。",
        "披衣有忙事，檐前看归云。",
        "初阳上林端，鸦背明纷纷。",
        "我亦迫经课，日计在一晨。",
        "再烧结愿香，稍洗三生勤。",
        "群公持世故，白发到幽人。",
        "幸不识奇字，门绝车马尘。",
        "谁能共此窗，竹影可与分。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3298,
      "title": "晚步",
      "content": [
        "手把古人书，闲读下广庭。",
        "荒村无车马，日落双桧青。",
        "旷然神虑静，浊俗非所宁。",
        "逍遥出荆扉，𥩟立瞻郊坰。",
        "须臾暮色至，野水皆晶荧。",
        "却步面空林，远意更杳冥。",
        "停云甚可爱，重叠如沙汀。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3299,
      "title": "同杨运干黄秀才村西买山药",
      "content": [
        "潦缩田路宽，委蛇散腰脚。",
        "胜日三枝杖，村西买山药。",
        "岗峦相吞去，远木互前却。",
        "天阴野水明，岁暮竹篱薄。",
        "田翁领客意，发筐堆磊落。",
        "玉质缃色裘，用世乃见缚。",
        "屠门几许快，夜语寻幽约。",
        "石鼎看云翻，门前北风恶。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3300,
      "title": "同二子观取鱼于窦家池以钱得数斗置驿",
      "content": [
        "闭户读书生白发，闲向村东看鱼穴。",
        "曾随树影数圆波，铁面渔师肝肺别。",
        "向来痴腹负此翁，只可买放莲溏中。",
        "万事成亏等闲里，佗年此地费雷风。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 3301,
      "title": "早起",
      "content": [
        "晓寒生木枕，窗白梦难续。",
        "自起开柴扉，空庭立乔木。",
        "蒙蒙井气上，澹澹天容肃。",
        "尘心忽昭旷，何异居涧谷。",
        "学道审不遥，忍饥差已熟。",
        "皇天赐丰年，菜本如白玉。",
        "一简了百事，狡狯嗤颜歜。",
        "幽鸟行屋山，悠然寄吾目。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3302,
      "title": "招张仲宗",
      "content": [
        "北风日日吹茅屋，幽子朝朝只地炉。",
        "客里赖诗增意气，老来唯懒是工夫。",
        "空庭乔木无时事，残雪疏篱当画图。",
        "亦有张侯能共此，焚香相待莫徐驱。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 3303,
      "title": "宴坐之地籧篨覆之名曰蓬斋",
      "content": [
        "不须杯勺了三冬，旋作蓬斋待朔风。",
        "会有打窗风雪夜，地炉孤坐策奇功。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 3304,
      "title": "寓居刘仓廨中晚步过郑仓台上",
      "content": [
        "纱巾竹杖过荒陂，满面东风二月时。",
        "世事纷纷人老易，春阴漠漠絮飞迟。",
        "士衡去国三间屋，子美登台七字诗。",
        "草遶天西青不尽，故园归计入支颐。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 3305,
      "title": "八关僧房遇雨",
      "content": [
        "脱履坐明窗，偶至晴更适。",
        "池上风忽来，斜雨满高壁。",
        "深松含岁暮，幽鸟立昼寂。",
        "世故方未阑，焚香破今夕。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 3306,
      "title": "赠黄家阿莘",
      "content": [
        "君家阿莘如白玉，呼出灯前语录续。",
        "可怜郎罢穷一生，只今有汝照茅屋。",
        "猪生十子豚复豚，阿莘明年可当门。",
        "阶庭一笑不外索，万事纷纷何足论。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 3307,
      "title": "发商水道中",
      "content": [
        "商水西门语，东风动柳枝。",
        "年华入危涕，世事本前期。",
        "草草檀公策，茫茫杜老诗。",
        "山川马前阔，不敢计归时。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 3308,
      "title": "次舞阳",
      "content": [
        "客子寒亦行，正月固多阴。",
        "马头东风起，绿色日夜深。",
        "大道不敢驱，山径费推寻。",
        "丈夫不逢此，何以知岖嵚。",
        "行投舞阳县，薄暮森众林。",
        "古城何年缺，跋马望日沉。",
        "忧世力不逮，有泪盈衣襟。",
        "嵯峩西北云，想像折寸心。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3309,
      "title": "次南阳",
      "content": [
        "今日东北云，景气何佳哉。",
        "我马且勿驱，当有吉语来。",
        "春寒欺客子，满意旗下杯。",
        "百年耳频热，万事首不回。",
        "卧龙今何之，有冢今半摧。",
        "空余乔木地，薄暮鸦徘徊。",
        "怀古视落日，愧我非长才。",
        "却凭破鞍去，风林生七哀。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3310,
      "title": "西轩寓居",
      "content": [
        "牢落西轩客，巡檐费独吟。",
        "桃花明薄暮，燕子闹微阴。",
        "辛苦元吾事，淹留更此心。",
        "小窗随意写，蛇蚓起相寻。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 3311,
      "title": "邓州西轩书事十首  其一",
      "content": [
        "小儒避贼南征日，皇帝行天第一春。",
        "走到邓州无脚力，桃花初动雨留人。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 3312,
      "title": "邓州西轩书事十首  其二",
      "content": [
        "千里空携一影来，白头更著乱蝉催。",
        "书生身世今如此，倚遍周家十二槐。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 3313,
      "title": "邓州西轩书事十首  其三",
      "content": [
        "瓦屋三间宽有余，可怜小陆不同居。",
        "易求苏子六国印，难觅河桥一字书。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 3314,
      "title": "邓州西轩书事十首  其四",
      "content": [
        "莫嫌啖蔗佳境远，橄榄甜苦亦相并。",
        "都将壮节供辛苦，准拟残年看太平。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 3315,
      "title": "邓州西轩书事十首  其五",
      "content": [
        "皇家卜年过周历，变故未必非天仁。",
        "东南鬼火成何事，终待胡锋作争臣。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 3316,
      "title": "邓州西轩书事十首  其六",
      "content": [
        "杨刘相倾建中乱，不待白首今同归。",
        "只今将相须廉蔺，五月并门未解围。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 3317,
      "title": "邓州西轩书事十首  其七",
      "content": [
        "不须夜夜看太白，天地景气今如斯。",
        "始行夷狄相攻策，可惜中原见事迟。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 3318,
      "title": "邓州西轩书事十首  其八",
      "content": [
        "诏书忧民十六事，父老祝君一万年。",
        "白发书生喜无寐，从今不仕可归田。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 3319,
      "title": "邓州西轩书事十首  其九",
      "content": [
        "范公深忧天下日，仁祖爱民全盛年。",
        "遗庙只今香火冷，时时风叶一骚然。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 3320,
      "title": "邓州西轩书事十首  其一○",
      "content": [
        "诸葛经行有夕风，千秋天地几英雄。",
        "吊古不须多感慨，人生半梦半醒中。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 3321,
      "title": "晚步顺阳门外",
      "content": [
        "六尺枯藜了此生，顺阳门外看新晴。",
        "树连翠筿围春昼，水泛青天入古城。",
        "梦里偶来那计日，人间多事更闻兵。",
        "只应千载溪桥路，欠我媻姗勃窣行。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 3322,
      "title": "纵步至董氏园亭三首  其一",
      "content": [
        "池光修竹里，筇杖季春头。",
        "客子愁无奈，桃花笑不休。",
        "百年今日胜，万里此生浮。",
        "莽莽樽前事，题诗记独游。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 3323,
      "title": "纵步至董氏园亭三首  其二",
      "content": [
        "槐树层层新绿生，客怀依旧不能平。",
        "自移一榻西窗下，要近丛篁听雨声。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 3324,
      "title": "纵步至董氏园亭三首  其三",
      "content": [
        "客子今年驼褐宽，邓州三月始春寒。",
        "帘钩挂尽蒲团稳，十丈虚庭借雨看。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 3325,
      "title": "海棠",
      "content": [
        "春雨夜有声，连林杏花落。",
        "海棠已复动，寒食岂寂寞。",
        "人间有此丽，赴我隔年约。",
        "花叶两分明，春阴耿帘幙。",
        "东风吹不断，日暮臙脂薄。",
        "何可无我吟，三叫恨诗恶。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3326,
      "title": "雨中观秉仲家月桂",
      "content": [
        "月桂花上雨，春归一凭栏。",
        "东西南北客，更得几回看。",
        "红衿映肉色，薄暮无乃寒。",
        "园中如许树，独觉赋诗难。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 3327,
      "title": "香林四首  其一",
      "content": [
        "绝爱公家花气新，一林清露百般春。",
        "是中宴坐应容我，只恐微风唤起人。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 3328,
      "title": "香林四首  其二",
      "content": [
        "丈人延客非俗物，百和香中进一杯。",
        "乞取齐奴锦步障，与春遮断晓风来。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 3329,
      "title": "香林四首  其三",
      "content": [
        "谁见繁香度牖时，碧天残月映花枝。",
        "固应撩我题新句，压倒韦郎宴寝诗。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 3330,
      "title": "香林四首  其四",
      "content": [
        "简斋居士不饮酒，一入香林更不醒。",
        "驱使小诗酬晓露，绝胜辛苦广骚经。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 3331,
      "title": "题简斋",
      "content": [
        "我窗三尺余，可以阅晦明。",
        "北省虽巨丽，无此风竹声。",
        "不著散花女，而况使鬼兄。",
        "世间多歧路，居士绳床平。",
        "未知阮遥集，几屐了平生。",
        "领军一屋鞋，千载笑绝缨。",
        "槐阴自入户，知我喜新晴。",
        "觅句方未了，简斋真虚名。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3332,
      "title": "印老索钝庵诗",
      "content": [
        "人言融公懒，床上揖宾客。",
        "我来两忘揖，团团一庵白。",
        "戏谈邓州禅，分食天宁麦。",
        "竹风亦喜我，萧瑟至日夕。",
        "出家丈夫事，轩裳本儿剧。",
        "愿香惊余烟，世故感陈迹。",
        "固应师未钝，使我不安席。",
        "时求一滴水，为洗三生石。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3333,
      "title": "春雨",
      "content": [
        "花尽春犹冷，羁心只自惊。",
        "孤莺啼永昼，细雨湿高城。",
        "扰扰成何事，悠悠送此生。",
        "蛛丝闪夕霁，随处有诗情。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 3334,
      "title": "难老堂周元翁家",
      "content": [
        "城南乌声和且都，我识丈人屋上乌。",
        "难老堂中一樽酒，不教霜雪上髭须。",
        "樊侯种梓用莫竭，丈人向来亦种德。",
        "挽回万事入绳床，花竹相看有佳色。",
        "人生知足一饱多，当时恨我弃渔蓑。",
        "题诗素壁蛇蚓集，五百年后公摩挲。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3335,
      "title": "登城楼",
      "content": [
        "去年梦陈留，今年梦邓州。",
        "几梦即了我，一笑城西楼。",
        "新晴草木丽，落日淡欲收。",
        "远川如动摇，景气明田畴。",
        "百年几凭栏，亦有似我不。",
        "城阴坐来失，白水光不流。",
        "丈夫贵快意，少住宽千忧。",
        "归嫌简斋陋，局促生白头。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3336,
      "title": "雨",
      "content": [
        "忽忽忘年老，悠悠负日长。",
        "小诗妨学道，微雨好烧香。",
        "檐鹊移时立，庭梧满意凉。",
        "此身南复北，彷佛是它乡。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 3337,
      "title": "游董园",
      "content": [
        "西园可散发，何必赋远游。",
        "地旷多雄风，叶声无时休。",
        "幸有济胜具，枯藜支白头。",
        "平生会心处，未觉身淹留。",
        "散坐青石床，松意淡欲秋。",
        "薄雨青众卉，深林耿微流。",
        "一凉天地德，物我俱夷犹。",
        "东北方用武，六月事戈矛。",
        "甲裳无乃重，腐儒故多忧。",
        "珍禽叫高树，且复寄悠悠。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3338,
      "title": "夏雨",
      "content": [
        "三伏过几日，坐数令人瘿。",
        "片云忽西行，庭树生光景。",
        "须臾万银竹，壮观发异境。",
        "天公终老手，一笑破日永。",
        "龙公勿惮烦，事了亦俄顷。",
        "修竹恬变化，依然半窗影。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3339,
      "title": "夏夜  其一",
      "content": [
        "闲弄玉如意，天河白练横。",
        "时无李供奉，谁识谢宣城。",
        "两鹤翻明月，孤松立快晴。",
        "南阳半年客，此夜满怀清。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 3340,
      "title": "夏夜  其二",
      "content": [
        "虚庭散策晚凉生，斟酌星河亦喜晴。",
        "不记墙西有修竹，夜风还作雨来声。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 3341,
      "title": "夏夜  其三",
      "content": [
        "待到天公放月时，东家乔柏两虬枝。",
        "悬知满地疏阴处，不及遥看突兀奇。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 3342,
      "title": "积雨喜霁",
      "content": [
        "积雨得一晴，开窗送吾目。",
        "叠云带余愤，远树增新绿。",
        "天公信难料，变化杂神速。",
        "夕霞尽意红，诘朝固难卜。",
        "西轩一杯酒，未负将军腹。",
        "竹林怀微风，余韵久回复。",
        "热官岂辨此，何必思烂熟。",
        "曳杖出门行，栖鸦息枯木。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3343,
      "title": "邓州城楼",
      "content": [
        "邓州城楼高百尺，楚岫秦云不相隔。",
        "傍城积水晚更明，照见纶巾倚楼客。",
        "李白上天不可呼，阴晴变化还须臾。",
        "独抚栏干咏奇句，满楼风月不枝梧。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 3344,
      "title": "北征",
      "content": [
        "世故信有力，挽我复北驰。",
        "独冲七月暑，行此无尽陂。",
        "百卉共山泽，各自有四时。",
        "华实相后先，盛过当同衰。",
        "亦复观我生，白发忽及期。",
        "夕云已不征，客子今何之。",
        "愿传飞仙术，一洗局促悲。",
        "被襟阆风观，濯发扶桑池。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3345,
      "title": "秋日客思",
      "content": [
        "南北东西俱我乡，聊从地主借绳床。",
        "诸公共得何侯力，远客新抄陆氏方。",
        "老去事多藜杖在，夜来秋到叶声长。",
        "蓬莱可托无因至，试觅人间千仞岗。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 3346,
      "title": "道中书事",
      "content": [
        "临老伤行役，篮舆岁月奔。",
        "客愁无处避，世事不堪论。",
        "白道含秋色，青山带雨痕。",
        "坏梁斜鬬水，乔木密藏村。",
        "易破还家梦，难招去国魂。",
        "一身从白首，随意答乾坤。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3347,
      "title": "将次叶城道中",
      "content": [
        "荒野少人去，竹舆伊轧声。",
        "晴云秋更白，野水暮还明。",
        "寂寞信吾道，淹留谙世情。",
        "王乔有余舄，借我一东征。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 3348,
      "title": "至叶城",
      "content": [
        "苏武初逢雁，王乔欲借凫。",
        "深知念行李，为报了长途。",
        "难稳三更枕，遥怜五岁雏。",
        "却思正月事，不敢恨榛芜。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 3349,
      "title": "晓发叶城",
      "content": [
        "竹舆开两牖，秋色为横分。",
        "左送廉纤月，右揖离披云。",
        "诗情满行色，何地著世纷。",
        "欲语王县令，三叫不能闻。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 3350,
      "title": "方城陪诸兄坐心远亭",
      "content": [
        "客中日食三斗尘，北去南来了今岁。",
        "暂时亭中一杯酒，与兄同宗复同味。",
        "博山云气终日留，竹君萧萧不负秋。",
        "世路明年傥无故，却携藜杖更来游。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 3351,
      "title": "美哉亭",
      "content": [
        "西出城皋关，土谷仅容驼。",
        "天挂一疋练，双崖鬬嵯峩。",
        "忽然五丈缺，亭构如危窠。",
        "青山丽中原，白日照大河。",
        "下视万里川，草木何其多。",
        "临高一吐气，却奈雄风何。",
        "辛苦生一快，造物巧揣摩。",
        "险易终不偿，翻身下残坡。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3352,
      "title": "山路晓行",
      "content": [
        "两崖夹晓月，万壑分秋风。",
        "今朝定何朝，孤赏莫与同。",
        "石路抱岩转，云气青蒙蒙。",
        "篮舆拂露枝，乱点惊仆童。",
        "微泉不知处，玉佩鸣深丛。",
        "平生慕李愿，得此行旅中。",
        "居人轻佳境，过客意无穷。",
        "山木好题诗，恨我行匆匆。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3353,
      "title": "题董宗禹园先志亭宗禹之父早失母万方求得之此其晚节色养之地也",
      "content": [
        "作客古南阳，问俗仁孝敦。",
        "坐读杜羔传，起访城西园。",
        "伟哉是家事，作传堪千言。",
        "当年怀橘处，华屋澹晓暾。",
        "大松荫后楹，小松罗前轩。",
        "风露所沐浴，千载当连根。",
        "我已废蓼莪，感兹泪河翻。",
        "叶声含三叹，送我出园门。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3354,
      "title": "同继祖民瞻游赋诗亭二首  其一",
      "content": [
        "邂逅今朝一段奇，从来华屋不关诗。",
        "诸君且作留连意，正是微风到竹时。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 3355,
      "title": "同继祖民瞻游赋诗亭二首  其二",
      "content": [
        "浩浩白云溪一色，冥冥青竹鸟三呼。",
        "只今那得王摩诘，画我凭栏觅句图。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 3356,
      "title": "题崇山",
      "content": [
        "短蓬如凫鹥，载我万斛愁。",
        "试登山上亭，却望沙际舟。",
        "世故莽相急，长江去悠悠。",
        "西南浸山影，晦明分中流。",
        "荡摇宝鉴面，翠髻千螺浮。",
        "去程虽云阻，兹地固堪留。",
        "客路惜胜日，临风搔白头。",
        "众色忽已晚，川光抱岩幽。",
        "三老呼不置，我兴方未收。",
        "下山事复多，题诗记曾游。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3357,
      "title": "与季申信道自光化复入邓书事  其一",
      "content": [
        "孙子白木杖，富子黑油笠。",
        "我独白竹篮，差池复相及。",
        "夕阳桥边画，岸帻归云急。",
        "勿语城中人，从渠慎出入。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 3358,
      "title": "与季申信道自光化复入邓书事  其二",
      "content": [
        "卖舟作归计，竹篮稳如舟。",
        "雾收青皋湿，行路当春游。",
        "老马不自知，意欲踏九州。",
        "依然还故枥，寂寞壮心休。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 3359,
      "title": "与季申信道自光化复入邓书事  其三",
      "content": [
        "再来生白发，重见邓州春。",
        "依旧城西路，桃花不记人。",
        "卜居得穷巷，日色满窗新。",
        "微吟惊市卒，独鹤语城闉。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 3360,
      "title": "与季申信道自光化复入邓书事  其四",
      "content": [
        "城西望城南，十日九相隔。",
        "何如三枝杖，共踏江上石。",
        "门前流水过，春意满渠碧。",
        "遥知千顷江，如今好颜色。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 3361,
      "title": "寄季申",
      "content": [
        "雨歇城南泥未干，遥知独立整衣冠。",
        "旧时邺下刘公干，今日辽东管幼安。",
        "绿阴展尽身犹远，黄鸟飞来节已阑。",
        "安得一樽生耳热，暂时相对说悲欢。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 3362,
      "title": "题继祖蟠室三首  其一",
      "content": [
        "云起炉山久未移，功名不恨十年迟。",
        "日斜疏竹可窗影，正是幽人睡足时。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 3363,
      "title": "题继祖蟠室三首  其二",
      "content": [
        "万卷吾今一字无，打包随处野僧如。",
        "短檠未尽残年债，欲问班生试借书。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 3364,
      "title": "题继祖蟠室三首  其三",
      "content": [
        "中兴天子要人才，当使生擒颉利来。",
        "正待吾曹红抹额，不须辛苦学颜回。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 3365,
      "title": "述怀",
      "content": [
        "闭户生白发，逍遥步城隅。",
        "野外晴林满，天末暮云孤。",
        "水容澹春归，草色带雨濡。",
        "物态纷如昨，世事再呜呼。",
        "京洛了在眼，山川一何迂。",
        "乘槎莽未办，且复小踟蹰。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3366,
      "title": "寄题赵景温筠居轩",
      "content": [
        "相逢汉江边，盗起方如云。",
        "当时苍黄意，亦可无此君。",
        "俗士固鲜欢，王孙终逸群。",
        "清秋不可负，牖壁看修筠。",
        "碧干立疏雨，丛梢冒斜曛。",
        "引君著胜地，世事从纷纷。",
        "何时微月夕，胡床与予分。",
        "高吟呼天风，夜半笙箫闻。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3367,
      "title": "重阳",
      "content": [
        "去岁重阳已百忧，今年依旧叹羁游。",
        "篱底菊花唯解笑，镜中头发不禁秋。",
        "凉风又落宫南木，老雁孤鸣汉北州。",
        "如许行年那可记，谩排诗句写新愁。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 3368,
      "title": "有感再赋",
      "content": [
        "忆昔甲辰重九日，天恩曾与宴城东。",
        "龙沙此日西风冷，谁折黄花寿两宫。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 3369,
      "title": "感事",
      "content": [
        "丧乱那堪说，干戈竟未休。",
        "公卿危左衽，江汉故东流。",
        "风断黄龙府，云移白鹭洲。",
        "云何舒国步，持底副君忧。",
        "世事非难料，吾生本自浮。",
        "菊花纷四野，作意为谁秋。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3370,
      "title": "送客出城西",
      "content": [
        "邓州谁亦解丹青，画我羸骖晚出城。",
        "残年政尔供愁了，末路那堪送客行。",
        "寒日满川分众色，暮林无叶寄秋声。",
        "垂鞭归去重回首，意落西南计未成。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 3371,
      "title": "得席大光书因以诗迓之",
      "content": [
        "十月高风客子悲，故人书到暂开眉。",
        "也知廊庙当推毂，无奈江山好赋诗。",
        "万事莫论兵动后，一杯当及菊残时。",
        "喜心翻倒相迎地，不怕荒林十里陂。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 3372,
      "title": "送大光赴石城",
      "content": [
        "石城高嵽嵲，城下是江波。",
        "莫愁织绮地，年来战马过。",
        "秀眉使君医国手，却把江头无事酒。",
        "山川勃鬰不平处，浇以三杯一搔首。",
        "半江楼影白逶迤，想见春流二月时。",
        "待予去扫仲宣赋，走马还朝亦未迟。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3373,
      "title": "梦中送僧觉而忘第三联戏足之",
      "content": [
        "两鸿同一天，羽翼不相及。",
        "偶然一识面，别意已超忽。",
        "去程秋光好，万里无断绝。",
        "虽无仁人言，赠子以明月。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 3374,
      "title": "无题",
      "content": [
        "六经在天如日月，万事随时更故新。",
        "江南丞相浮云坏，洛下先生宰木春。",
        "孟喜何妨改师法，京房底处有门人。",
        "旧喜读书今懒读，焚香阅世了闲身。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 3375,
      "title": "正月十二日自房州城遇虏至奔入南山十五日抵回谷张家",
      "content": [
        "久谓事当尔，岂意身及之。",
        "避虏连三年，行半天四维。",
        "我非洛豪士，不畏穷谷饥。",
        "但恨平生意，轻了少陵诗。",
        "今年奔房州，铁马背后驰。",
        "造物亦恶剧，脱命真毫厘。",
        "南山四程云，布袜傲险巇。",
        "篱间老炙背，无意管安危。",
        "知我是朝士，亦复颦其眉。",
        "呼酒软客脚，菜本濯玉肌。",
        "穷途士易德，欢喜不复辞。",
        "向来贪读书，闭户生白髭。",
        "岂知九州内，有山如此奇。",
        "自宽实不情，老人亦解颐。",
        "投宿恍世外，青灯耿茅茨。",
        "夜半不能眼，涧水鸣声悲。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3376,
      "title": "正月十六日夜二绝  其一",
      "content": [
        "正月十六夜，竹篱田父家。",
        "明月照树影，满山如龙蛇。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
