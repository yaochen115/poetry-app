      }
    },
    {
      "id": 3377,
      "title": "正月十六日夜二绝  其二",
      "content": [
        "二更风薄竹，悲吟连夜分。",
        "村西递余韵，应胜此间闻。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 3378,
      "title": "坐涧边石上",
      "content": [
        "三面青山围竹篱，人间无路访安危。",
        "扶筇共坐槎牙石，涧水悲鸣无歇时。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 3379,
      "title": "十七日夜咏月",
      "content": [
        "月轮隐东峰，奇彩在南岭。",
        "北崖草木多，苍茫映光景。",
        "玉盘忽微露，银浪泻千顷。",
        "岩谷散陆离，万象杂形影。",
        "不辞三更露，冒此白发顶。",
        "老筇无前游，危处有新警。",
        "涧光如翻鹤，变态发遥境。",
        "回首房州城，山中夜何永。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3380,
      "title": "独立",
      "content": [
        "篱门一徙倚，今夜天星繁。",
        "独立人世外，唯闻涧水喧。",
        "丛薄凝露气，群峰带春昏。",
        "偷生亦聊尔，难与众人言。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 3381,
      "title": "采菖蒲",
      "content": [
        "闲行涧底采菖蒲，千岁龙蛇抱石𦡱。",
        "明朝却觅房州路，飞下山颠不要扶。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 3382,
      "title": "与信道游涧边",
      "content": [
        "斜阳照乱石，颠崖下双筇。",
        "试从绝壑底，仰视最奇峰。",
        "回埼发涧怒，高霭生树容。",
        "半岩菖蒲根，翠葆森伏龙。",
        "岂无避世士，于此傥相逢。",
        "客心忽悄怆，归路迷行踪。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3383,
      "title": "咏西岭梅花",
      "content": [
        "雨后众崖碧，白处纷寒梅。",
        "遥遥迎客意，欲下山坡来。",
        "穷村受春晚，邂逅今日开。",
        "绛领承玉面，临风一低回。",
        "折归无可赠，孤赏心悠哉。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3384,
      "title": "游南嶂同孙信道",
      "content": [
        "遥瞻南嶂深复深，双崖与天藏太阴。",
        "青鞋济胜不能懒，踏破积雪穷崎嵚。",
        "空中朽树抱孤筿，无窍苍壁生横林。",
        "孤禽三叫危石裂，欲返未返神萧森。",
        "磴回忽然何处所，当面烟如翠蛟舞。",
        "石门泄风无昼夜，古木截道藏雷雨。",
        "丹丘赤城去几许，下视人间足尘土。",
        "放身天地不自知，导以龙蛇翼熊虎。",
        "山中异事记今晨，杖藜得道孙与陈。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    }
