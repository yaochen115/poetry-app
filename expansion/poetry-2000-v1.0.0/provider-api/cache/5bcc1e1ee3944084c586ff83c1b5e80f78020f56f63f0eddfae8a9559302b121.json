{
  "data": [
    {
      "id": 376973,
      "title": "临江仙·丝雨如尘云著水",
      "content": [
        "丝雨如尘云著水，嫣香碎拾吴宫",
        "百花冷暖避东风",
        "酷怜娇易散，燕子学偎红",
        "人说病宜随月减，恹恹却与春同",
        "可能留蝶抱花丛",
        "不成双梦影，翻笑杏梁空"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 376974,
      "title": "采桑子·严霜拥絮频惊起",
      "content": [
        "严霜拥絮频惊起，扑面霜空",
        "斜汉朦胧",
        "冷逼毡帷火不红",
        "香篝翠被浑闲事，回首西风",
        "何处疏钟，一穗灯花似梦中"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 376975,
      "title": "临江仙·孤雁",
      "content": [
        "霜冷离鸿惊失伴，有人同病相怜",
        "拟凭尺素寄愁边，愁多书屡易，双泪落灯前",
        "莫对月明思往事，也知消减年年",
        "无端嘹唳一声传，西风吹只影，刚是早秋天"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 376976,
      "title": "浣溪沙·谁道飘零不可怜",
      "content": [
        "西郊冯氏园看海棠，因忆《香严词》有感",
        "谁道飘零不可怜，旧游时节好花天",
        "断肠人去自经年",
        "一片晕红才著雨，几丝柔绿乍和烟",
        "倩魂销尽夕阳前"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 376977,
      "title": "浪淘沙·红影湿幽窗",
      "content": [
        "红影湿幽窗，瘦尽春光",
        "雨余花外却斜阳",
        "谁见薄衫低髻子，抱膝思量",
        "莫道不凄凉，早近持觞",
        "暗思何事断人肠",
        "曾是向他春梦里，瞥遇回廊"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 376978,
      "title": "菩萨蛮·朔风吹散三更雪",
      "content": [
        "朔风吹散三更雪，倩魂犹恋桃花月",
        "梦好莫催醒，由他好处行",
        "无端听画角，枕畔红冰薄",
        "塞马一声嘶，残星拂大旗"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 376979,
      "title": "鹧鸪天·背立盈盈故作羞",
      "content": [
        "背立盈盈故作羞，手挼梅蕊打肩头",
        "欲将离恨寻郎说，待得郎来恨却休",
        "云淡淡，水悠悠",
        "一声横笛锁空楼",
        "何时共泛春溪月，断岸垂杨一叶舟"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 376980,
      "title": "虞美人·残灯风灭炉烟冷",
      "content": [
        "残灯风灭炉烟冷，相伴唯孤影",
        "判教狼藉醉清樽，为问世间醒眼是何人",
        "难逢易散花间酒，饮罢空搔首",
        "闲愁总付醉来眠，只恐醒时依旧到樽前"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 376981,
      "title": "渔父·收却纶竿落照红",
      "content": [
        "收却纶竿落照红，秋风宁为翦芙蓉",
        "人淡淡，水蒙蒙，吹入芦花短笛中"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 376982,
      "title": "浣溪沙·消息谁传到拒霜",
      "content": [
        "消息谁传到拒霜",
        "两行斜雁碧天长",
        "晚秋风景倍凄凉",
        "银蒜押帘人寂寂，玉钗敲竹信茫茫",
        "黄花开也近重阳"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 376983,
      "title": "天仙子·月落城乌啼未了",
      "content": [
        "月落城乌啼未了，起来翻为无眠早",
        "薄霜庭院怯生衣，心悄悄，红阑绕",
        "此情待共谁人晓"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 376984,
      "title": "水调歌头·题西山秋爽图",
      "content": [
        "空山梵呗静，水月影俱沉",
        "悠然一境人外，都不许尘侵",
        "岁晚忆曾游处，犹记半竿斜照，一抹界疏林",
        "绝顶茅庵里，老衲正孤吟",
        "云中锡，溪头钓，涧边琴",
        "此生著几两屐，谁识卧游心?",
        "准拟乘风归去，错向槐安回首，何日得投簪",
        "布袜青鞋约，但向画图寻"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 376985,
      "title": "鹧鸪天·雁贴寒云次第飞",
      "content": [
        "雁帖寒云次第飞，向南犹自怨归迟",
        "谁能瘦马关山道，又到西风扑鬓时",
        "人杳杳，思依依，更无芳树有乌啼",
        "凭将扫黛窗前月，持向今宵照别离"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 376986,
      "title": "琵琶仙·中秋",
      "content": [
        "碧海年年，试问取、冰轮为谁圆缺",
        "吹到一片秋香，清辉了如雪",
        "愁中看、好天良夜，知道尽成悲咽",
        "只影而今，那堪重对，旧时明月",
        "花径里、戏捉迷藏，曾惹下萧萧井梧叶",
        "记否轻纨小扇，又几番凉热",
        "只落得，填膺百感，总茫茫、不关离别。",
        "一任紫玉无情，夜寒吹裂"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 376987,
      "title": "于中好·独背残阳上小楼",
      "content": [
        "独背残阳上小楼，谁家玉笛韵偏幽",
        "一行白雁遥天暮，几点黄花满地秋",
        "惊节序，叹沉浮，秾华如梦水东流",
        "人间所事堪惆怅，莫向横塘问旧游"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 376988,
      "title": "浪淘沙·夜雨做成秋",
      "content": [
        "夜雨做成秋，恰上心头",
        "教他珍重护风流",
        "端的为谁添病也，更为谁羞",
        "密意未曾休，密愿难酬",
        "珠帘四卷月当楼",
        "暗忆欢期真似梦，梦也须留"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 376989,
      "title": "南乡子·烟暖雨初收",
      "content": [
        "烟暖雨初收，落尽繁花小院幽",
        "摘得一双红豆子，低头，说著分携泪暗流",
        "人去似春休，卮酒曾将酹石尤",
        "别自有人桃叶渡，扁舟，一种烟波各自愁"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 376990,
      "title": "梦江南·新来好",
      "content": [
        "新来好，唱得虎头词",
        "一片冷香唯有梦，十分清瘦更无诗",
        "标格早梅知"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 376991,
      "title": "鹧鸪天·别绪如丝梦不成",
      "content": [
        "别绪如丝梦不成，那堪孤枕梦边城",
        "因听紫塞三更雨，却忆红楼半夜灯",
        "书郑重，恨分明，天将愁味酿多情",
        "起来呵手封题处，偏到鸳鸯两字冰"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 376992,
      "title": "临江仙·昨夜个人曾有约",
      "content": [
        "昨夜个人曾有约，严城玉漏三更",
        "一钩新月几疏星",
        "夜阑犹未寝，人静鼠窥灯",
        "原是瞿唐风间阻，错教人恨无情",
        "小阑干外寂无声",
        "几回肠断处，风动护花铃"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 376993,
      "title": "浪淘沙·望海",
      "content": [
        "蜃阙半模糊，踏浪惊呼",
        "任将蠡测笑江湖",
        "沐日光华还浴月，我欲乘桴",
        "钓得六鳌无",
        "竿拂珊瑚",
        "桑田清浅问麻姑",
        "水气浮天天接水，那是蓬壶"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 376994,
      "title": "清平乐·弹琴峡题壁",
      "content": [
        "泠泠彻夜，谁是知音者",
        "如梦前朝何处也，一曲边愁难写",
        "极天关塞云中，人随落雁西风",
        "唤取红襟翠袖，莫教泪洒英雄"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 376995,
      "title": "蝶恋花·又到绿杨曾折处",
      "content": [
        "又到绿杨曾折处，不语垂鞭，踏遍清秋路",
        "衰草连天无意绪，雁声远向萧关去",
        "不恨天涯行役苦，只恨西风，吹梦成今古",
        "明日客程还几许，沾衣况是新寒雨"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 376996,
      "title": "摊破浣溪沙·风絮飘残已化萍",
      "content": [
        "风絮飘残已化萍，泥莲刚倩藕丝萦",
        "珍重别拈香一瓣，记前生",
        "人到情多情转薄，而今真个悔多情",
        "又到断肠回首处，泪偷零"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 376997,
      "title": "于中好·十月初四夜风雨其明日是亡妇生辰",
      "content": [
        "尘满疏帘素带飘，真成暗度可怜宵",
        "几回偷拭青衫泪，忽傍犀奁见翠翘",
        "惟有恨，转无聊",
        "五更依旧落花朝",
        "衰杨叶尽丝难尽，冷雨凄风打画桥"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 376998,
      "title": "蝶恋花·眼底风光留不住",
      "content": [
        "眼底风光留不住，和暖和香，又上雕鞍去",
        "欲倩烟丝遮别路，垂杨那是相思树",
        "惆怅玉颜成间阻，何事东风，不作繁华主",
        "断带依然留乞句，斑骓一系无寻处"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 376999,
      "title": "临江仙·点滴芭蕉心欲碎",
      "content": [
        "点滴芭蕉心欲碎，声声催忆当初",
        "欲眠还展旧时书",
        "鸳鸯小字，犹记手生疏",
        "倦眼乍低缃帙乱，重看一半模糊",
        "幽窗冷雨一灯孤",
        "料应情尽，还道有情无"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 377000,
      "title": "踏莎行·倚柳题笺",
      "content": [
        "倚柳题笺，当花侧帽，赏心应比驱驰好",
        "错教双鬓受东风，看吹绿影成丝早",
        "金殿寒鸦，玉阶春草，就中冷暖和谁道",
        "小楼明月镇长闲，人生何事缁尘老"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 377001,
      "title": "金缕曲·姜西溟言别赋此赠之",
      "content": [
        "谁复留君住",
        "叹人生、几翻离合，便成迟暮",
        "最忆西窗同剪烛，却话家山夜雨",
        "不道只、暂时相聚",
        "衮衮长江萧萧木，送遥天、白雁哀鸣去",
        "黄叶下，秋如许",
        "曰归因甚添愁绪",
        "料强似、冷烟寒月，栖迟梵宇",
        "一事伤心君落魄，两鬓飘萧未遇",
        "有解忆、长安儿女",
        "裘敝入门空太息，信古来、才命真相负",
        "身世恨，共谁语？"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 377002,
      "title": "金缕曲·慰西溟",
      "content": [
        "何事添凄咽",
        "但由他、天公簸弄，莫教磨涅",
        "失意每多如意少，终古几人称屈",
        "须知道、福因才折",
        "独卧藜床看北斗，背高城、玉笛吹成血",
        "听谯鼓，二更彻",
        "丈夫未肯因人热，且乘闲、五湖料理，扁舟一叶",
        "泪似秋霖挥不尽，洒向野田黄蝶",
        "须不羡、承明班列",
        "马迹车尘忙未了，任西风吹冷长安月",
        "又萧寺，花如雪"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 377003,
      "title": "于中好·谁道阴山行路难",
      "content": [
        "谁道阴山行路难",
        "风毛雨血万人欢",
        "松梢露点沾鹰绁，芦叶溪深没马鞍",
        "依树歇，映林看",
        "黄羊高宴簇金盘",
        "萧萧一夕霜风紧，却拥貂裘怨早寒"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 377004,
      "title": "赤枣子·风淅淅",
      "content": [
        "风淅淅，雨纤纤",
        "难怪春愁细细添",
        "记不分明疑是梦，梦来还隔一重帘"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 377005,
      "title": "浣溪沙·欲寄愁心朔雁边",
      "content": [
        "欲寄愁心朔雁边，西风浊酒惨离颜",
        "黄花时节碧云天",
        "古戍烽烟迷斥堠，夕阳村落解鞍鞯",
        "不知征战几人还"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 377006,
      "title": "南楼令·塞外重九",
      "content": [
        "古木向人秋，惊蓬掠鬓稠",
        "是重阳、何处堪愁",
        "记得当年惆怅事，正风雨，下南楼",
        "断梦几能留，香魂一哭休",
        "怪凉蝉、空满衾裯",
        "霜落乌啼浑不睡，偏想出，旧风流"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 377007,
      "title": "浣溪沙·雨歇梧桐泪乍收",
      "content": [
        "雨歇梧桐泪乍收，遣怀翻自忆从头",
        "摘花销恨旧风流",
        "帘影碧桃人已去，屧痕苍藓径空留",
        "两眉何处月如钩"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 377008,
      "title": "浣溪沙·十里湖光载酒游",
      "content": [
        "十里湖光载酒游，青帘低映白苹洲",
        "西风听彻采菱讴",
        "沙岸有时双袖拥，画船何处一竿收",
        "归来无语晚妆楼"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 377009,
      "title": "浣溪沙·记绾长条欲别难",
      "content": [
        "记绾长条欲别难",
        "盈盈自此隔银湾",
        "便无风雪也摧残",
        "青雀几时裁锦字，玉虫连夜翦春旙",
        "不禁辛苦况相关"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 377010,
      "title": "浣溪沙·酒醒香销愁不胜",
      "content": [
        "酒醒香销愁不胜，如何更向落花行",
        "去年高摘斗径盈，夜雨几番销瘦了，繁华如梦总无凭",
        "人间何处问多情"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 377011,
      "title": "蝶恋花·辛苦最怜天上月",
      "content": [
        "辛苦最怜天上月，一夕如环，夕夕都成玦",
        "若似月轮终皎洁，不辞冰雪为卿热",
        "无那尘缘容易绝，燕子依然，软踏帘钩说",
        "唱罢秋坟愁未歇，春丛认取双栖蝶"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 377012,
      "title": "采桑子·那能寂寞芳菲节",
      "content": [
        "那能寂寞芳菲节，欲话生平",
        "夜已三更",
        "一阕悲歌泪暗零",
        "须知秋叶春花促，点鬓星星",
        "遇酒须倾，莫问千秋万岁名"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 377013,
      "title": "于中好·小构园林寂不哗",
      "content": [
        "小构园林寂不哗，疏篱曲径仿山家",
        "昼长吟罢风流子，忽听楸枰响碧纱",
        "添竹石，伴烟霞",
        "拟凭樽酒慰年华",
        "休嗟髀里今生肉，努力春来自种花"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 377014,
      "title": "秣陵怀古",
      "content": [
        "山色江声共寂寥，十三陵树晚萧萧",
        "中原事业如江左，芳草何须怨六朝"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 377015,
      "title": "淡黄柳·咏柳",
      "content": [
        "三眠未歇，乍到秋时节",
        "一树料阳蝉更咽，曾绾灞陵离别",
        "絮己为萍风卷叶，空凄切",
        "长条莫轻折，苏小恨，倩他说",
        "尽飘零、游冶章台客",
        "红板桥空，湔裙人去，依旧晓风残月"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 377016,
      "title": "红窗月·燕归花谢",
      "content": [
        "燕归花谢，早因循、又过清明",
        "是一般风景，两样心情",
        "犹记碧桃影里、誓三生",
        "乌丝阑纸娇红篆，历历春星",
        "道休孤密约，鉴取深盟",
        "语罢一丝香露、湿银屏"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 377017,
      "title": "浣溪沙·十八年来堕世间",
      "content": [
        "十八年来堕世间，吹花嚼蕊弄冰弦",
        "多情情寄阿谁边",
        "紫玉钗斜灯影背，红绵粉冷枕函偏",
        "相看好处却无言"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 377018,
      "title": "浣溪沙·已惯天涯莫浪愁",
      "content": [
        "已惯天涯莫浪愁，寒云衰草渐成秋",
        "漫因睡起又登楼",
        "伴我萧萧惟代马，笑人寂寂有牵牛，劳人只合一生休"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 377019,
      "title": "浣溪沙·燕垒空梁画壁寒",
      "content": [
        "燕垒空梁画壁寒，诸天花雨散幽关",
        "篆香清梵有无间",
        "蛱蝶乍从帘影度，樱桃半是鸟街残",
        "此时相对一忘言"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 377020,
      "title": "眼儿媚·中元夜有感",
      "content": [
        "手写香台金字经，惟愿结来生",
        "莲花漏转，杨枝露滴，想鉴微诚",
        "欲知奉倩神伤极，凭诉与秋擎",
        "西风不管，一池萍水，几点荷灯"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 377021,
      "title": "菩萨蛮·为春憔悴留春住",
      "content": [
        "为春憔悴留春住，那禁半霎催归雨",
        "深巷卖樱桃，雨余红更娇",
        "黄昏清泪阁，忍便花飘泊",
        "消得一声莺，东风三月情"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 377022,
      "title": "鬓云松令·枕函香",
      "content": [
        "枕函香，花径漏",
        "依约相逢，絮语黄昏后",
        "时节薄寒人病酒，刬地梨花，彻夜东风瘦",
        "掩银屏，垂翠袖",
        "何处吹箫，脉脉情微逗",
        "肠断月明红豆蔻，月似当时，人似当时否"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 377023,
      "title": "望江南·咏弦月",
      "content": [
        "初八月，半镜上青霄",
        "斜倚画阑娇不语，暗移梅影过红桥，裙带北风飘"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 377024,
      "title": "蝶恋花·出塞",
      "content": [
        "今古河山无定据",
        "画角声中，牧马频来去",
        "满目荒凉谁可语",
        "西风吹老丹枫树",
        "从前幽怨应无数",
        "铁马金戈，青冢黄昏路",
        "一往情深深几许",
        "深山夕照深秋雨"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 377025,
      "title": "荷叶杯·知己一人谁是",
      "content": [
        "知己一人谁是",
        "已矣",
        "赢得误他生",
        "有情终古似无情，别语悔分明",
        "莫道芳时易度，朝暮",
        "珍重好花天",
        "为伊指点再来缘，疏雨洗遗钿"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 377026,
      "title": "南乡子·为亡妇题照",
      "content": [
        "泪咽却无声",
        "只向从前悔薄情，凭仗丹青重省识",
        "盈盈",
        "一片伤心画不成",
        "别语忒分明",
        "午夜鹣鹣梦早醒",
        "卿自早醒侬自梦，更更",
        "泣尽风檐夜雨铃"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 377027,
      "title": "金人捧露盘·净业寺观莲有怀荪友",
      "content": [
        "藕风轻，莲露冷，断虹收，正红窗、初上帘钩",
        "田田翠盖，趁斜阳鱼浪香浮",
        "此时画阁垂杨岸，睡起梳头",
        "旧游踪，招提路，重到处，满离忧",
        "想芙蓉湖上悠悠",
        "红衣狼藉，卧看少妾荡兰舟",
        "午风吹断江南梦，梦里菱讴"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 377028,
      "title": "菩萨蛮·春云吹散湘帘雨",
      "content": [
        "春云吹散湘帘雨，絮黏蝴蝶飞还住",
        "人在玉楼中，楼高四面风",
        "柳烟丝一把，暝色笼鸳瓦",
        "休近小阑干，夕阳无限山"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 377029,
      "title": "南歌子·古戍",
      "content": [
        "古戍饥乌集，荒城野雉飞",
        "何年劫火剩残灰，试看英雄碧血，满龙堆",
        "玉帐空分垒，金笳已罢吹",
        "东风回首尽成非，不道兴亡命也，岂人为"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 377030,
      "title": "虞美人·银床淅沥青梧老",
      "content": [
        "银床淅沥青梧老，屧粉秋蛩扫",
        "采香行处蹙连钱，拾得翠翘何恨不能言",
        "回廊一寸相思地，落月成孤倚",
        "背灯和月就花阴，已是十年踪迹十年心"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 377031,
      "title": "忆江南·宿双林禅院有感",
      "content": [
        "心灰尽、有发未全僧",
        "风雨消磨生死别，似曾相识只孤檠，情在不能醒",
        "摇落后，清吹那堪听",
        "淅沥暗飘金井叶，乍闻风定又钟声，薄福荐倾城"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 377032,
      "title": "百字令·宿汉儿村",
      "content": [
        "无情野火，趁西风烧遍、天涯芳草",
        "榆塞重来冰雪里，冷入鬓丝吹老",
        "牧马长嘶，征笳乱动，并入愁怀抱",
        "定知今夕，庾郎瘦损多少",
        "便是脑满肠肥，尚难消受，此荒烟落照",
        "何况文园憔悴后，非复酒垆风调",
        "回乐峰寒，受降城远，梦向家山绕",
        "茫茫百感，凭高唯有清啸"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 377033,
      "title": "一络索·过尽遥山如画",
      "content": [
        "过尽遥山如画",
        "短衣匹马",
        "萧萧落木不胜秋， 莫回首、 斜阳下",
        "别是柔肠萦挂",
        "待归才罢",
        "却愁拥髻向灯前， 说不尽、 离人话"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 377034,
      "title": "清平乐·风鬟雨鬓",
      "content": [
        "风鬟雨鬓，偏是来无准",
        "倦倚玉兰看月晕，容易语低香近",
        "软风吹遍窗纱，心期便隔天涯",
        "从此伤春伤别，黄昏只对梨花"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 377035,
      "title": "清平乐·青陵蝶梦",
      "content": [
        "青陵蝶梦，倒挂怜么凤",
        "退粉收香情一种，栖傍玉钗偷共",
        "愔愔镜阁飞蛾，谁传锦字秋河",
        "莲子依然隐雾，菱花暗惜横波"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 377036,
      "title": "清平乐·添烟深漾",
      "content": [
        "麝烟深漾",
        "人拥缑笙氅",
        "新恨暗随新月长",
        "不辨眉尖心上",
        "六花斜扑疏帘",
        "地衣红锦轻沾",
        "记取暖香如梦，耐他一晌寒岩"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 377037,
      "title": "清平乐·角声哀咽",
      "content": [
        "角声哀咽，幞被驮残月",
        "过去华年如电掣，禁得番番离别",
        "一鞭冲破黄埃乱山影里徘徊",
        "蓦忆去年今日，十三陵下归来"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 377038,
      "title": "清平乐·参横月落",
      "content": [
        "参横月落，客绪从谁托",
        "望里家山云漠漠，似有红楼一角",
        "不如意事年年，消磨绝塞风烟",
        "输与五陵公子，此时梦绕花前"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 377039,
      "title": "天仙子·梦里藻芜青一剪",
      "content": [
        "梦里蘼芜青一剪，玉郎经岁音书远",
        "暗钟明月不归来，梁上燕，轻罗扇",
        "好风又落桃花片"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 377040,
      "title": "天仙子·天咫尺",
      "content": [
        "好在软绡红泪积，漏痕斜罥菱丝碧",
        "古钗封寄玉关秋，天咫尺，人南北，",
        "不信鸳鸯头不白"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 377041,
      "title": "天仙子·渌水亭秋夜",
      "content": [
        "水浴凉蟾风入袂，鱼鳞蹙损金波碎",
        "好天良夜酒盈尊，心自醉，愁难睡",
        "西风月落城乌起"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 377042,
      "title": "相见欢·落花如梦凄迷",
      "content": [
        "落花如梦凄迷，麝烟微，又是夕阳潜下小楼西",
        "愁无限，消瘦尽，有谁知",
        "闲教玉笼鹦鹉念郎诗"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 377043,
      "title": "昭君怨·深禁好春谁惜",
      "content": [
        "深禁好春谁惜，薄暮瑶阶伫立",
        "别院管弦声，不分明",
        "又是梨花欲谢，绣被春寒今夜",
        "寂寞锁朱门，梦承恩"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 377044,
      "title": "浣溪沙·藕荡桥边埋钓筒",
      "content": [
        "藕荡桥边埋钓筒，苎萝西去五湖东",
        "笔床茶灶太从容",
        "况有短墙银杏雨，更兼高阁玉兰风",
        "画眉闲了画芙蓉"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 377045,
      "title": "浣溪沙·身向云山那畔行",
      "content": [
        "身向云山那畔行，北风吹断马嘶声",
        "深秋远塞若为情",
        "一抹晚烟荒戍垒，半竿斜日旧关城",
        "古今幽恨几时平"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 377046,
      "title": "浣溪沙·桦屋鱼衣柳作城",
      "content": [
        "桦屋鱼衣柳作城，蛟龙鳞动浪花腥，飞扬应逐海东青",
        "犹记当年军垒迹，不知何处梵钟声，莫将兴废话分明"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 377047,
      "title": "菩萨蛮·回文",
      "content": [
        "雾窗寒对遥天暮，暮天遥对寒窗雾",
        "花落正啼鸦，鸦啼正落花",
        "袖罗垂影瘦，瘦影垂罗袖",
        "风翦一丝红，红丝一翦风"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 377048,
      "title": "菩萨蛮·阑风伏雨催寒食",
      "content": [
        "阑风伏雨催寒食，樱桃一夜花狼藉",
        "刚与病相宜，锁窗薰绣衣",
        "画眉烦女伴，央及流莺唤",
        "半晌试开奁，娇多直自嫌"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 377049,
      "title": "菩萨蛮·白日惊飚冬已半",
      "content": [
        "白日惊飚冬已半，解鞍正值昏鸦乱",
        "冰合大河流，茫茫一片愁",
        "烧痕空极望，鼓角高城上",
        "明日近长安，客心愁未阑"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 377050,
      "title": "菩萨蛮·萧萧几叶风兼雨",
      "content": [
        "萧萧几叶风兼雨，离人偏识长更苦",
        "欹枕数秋天，蟾蜍下早弦",
        "夜寒惊被薄，泪与灯花落",
        "无处不伤心，轻尘在玉琴"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 377051,
      "title": "菩萨蛮·窗前桃蕊娇如倦",
      "content": [
        "窗前桃蕊娇如倦，东风泪洗胭脂面",
        "人在小红楼，离情唱《石州》",
        "夜来双燕宿，灯背屏腰绿",
        "香尽雨阑珊，薄衾寒不寒"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 377052,
      "title": "菩萨蛮·雾窗寒对遥天暮",
      "content": [
        "雾窗寒对遥天暮，暮天遥对寒窗雾",
        "花落正啼鸦，鸦啼正落花",
        "袖罗垂影瘦，瘦影垂罗袖",
        "风翦一丝红，红丝一翦风"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 377053,
      "title": "菩萨蛮·飘蓬只逐惊飚转",
      "content": [
        "飘蓬只逐惊飚转，行人过尽烟光远",
        "立马认河流，茂陵风雨秋",
        "寂寥行殿锁，梵呗琉璃火",
        "塞雁与宫鸦，山深日易斜"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 377054,
      "title": "菩萨蛮·为陈其年题照",
      "content": [
        "晓寒瘦著西南月，丁丁漏箭余香咽",
        "春已十分宜，东风无是非",
        "蜀魂羞顾影，玉照斜红冷",
        "谁唱《后庭花》，新年忆旧家"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 377055,
      "title": "菩萨蛮·催花未歇花奴鼓",
      "content": [
        "催花未歇花奴鼓，酒醒已见残红舞",
        "不忍覆余觞，临风泪数行",
        "粉香看又别，空剩当时月",
        "月也异当时，凄清照鬓丝"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 377056,
      "title": "菩萨蛮·过张见阳山居，赋赠",
      "content": [
        "车尘马迹纷如织，羡君筑处真幽僻",
        "柿叶一林红，萧萧四面风",
        "功名应看镜，明月秋河影",
        "安得此山间，与君高卧闲"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 377057,
      "title": "菩萨蛮·玉绳斜转疑清晓",
      "content": [
        "玉绳斜转疑清晓，凄凄月白渔阳道",
        "星影漾寒沙，微茫织浪花",
        "金笳鸣故垒，唤起人难睡",
        "无数紫鸳鸯，共嫌今夜凉"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 377058,
      "title": "菩萨蛮·惜春春去惊新燠",
      "content": [
        "惜春春去惊新燠，粉融轻汗红绵扑",
        "妆罢只思眠，江南四月天",
        "绿阴帘半揭，此景清幽绝",
        "行度竹林风，单衫杏子红"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 377059,
      "title": "菩萨蛮·寄梁汾苕中",
      "content": [
        "知君此际情萧索，黄芦苦竹孤舟泊",
        "烟白酒旗青，水村鱼市晴",
        "柁楼今夕梦，脉脉春寒送",
        "直过画眉桥，钱塘江上潮"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 377060,
      "title": "菩萨蛮·乌丝画作回纹纸",
      "content": [
        "乌丝画作回纹纸，香煤暗蚀藏头字",
        "筝雁十三双，输他作一行",
        "相看仍似客，但道休相忆",
        "索性不还家，落残红杏花"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 377061,
      "title": "菩萨蛮·榛荆满眼山城路",
      "content": [
        "榛荆满眼山城路，征鸿不为愁人住",
        "何处是长安，湿云吹雨寒",
        "丝丝心欲碎，应是悲秋泪",
        "泪向客中多，归时又奈何"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 377062,
      "title": "菩萨蛮·隔花才歇廉纤雨",
      "content": [
        "隔花才歇廉纤雨，一声弹指混无语",
        "梁燕自双归，长条脉脉垂",
        "小屏山色远，妆薄铅华浅",
        "独自立瑶阶，透寒金缕鞋"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 377063,
      "title": "菩萨蛮·山城夜半催金柝",
      "content": [
        "山城夜半催金柝，酒醒孤馆灯花落",
        "窗白一声鸡，枕函闻马嘶",
        "门前乌桕树，霜月迷行处",
        "遥忆独眠人，早寒惊梦频"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 377064,
      "title": "虞美人·曲阑深处重相见",
      "content": [
        "曲阑深处重相见，匀泪偎人颤",
        "凄凉别后两应同，最是不胜清怨月明中",
        "半生已分孤眠过，山枕檀痕涴",
        "忆来何事最销魂，第一折枝花样画罗裙"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 377065,
      "title": "菩萨蛮·荒鸡再咽天难晓",
      "content": [
        "荒鸡再咽天难晓，星榆落尽秋将老",
        "毡幕绕牛羊，敲冰饮酪浆",
        "山程兼水宿，漏点清钲续",
        "正是梦回时，拥衾无限思"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 377066,
      "title": "菩萨蛮·砑笺银粉残煤画",
      "content": [
        "砑笺银粉残煤画，画煤残粉银笺砑",
        "清夜一灯明，明灯一夜清",
        "片花惊宿燕，燕宿惊花片",
        "亲自梦归人，人归梦自亲"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 377067,
      "title": "菩萨蛮·新寒中酒敲窗雨",
      "content": [
        "新寒中酒敲窗雨，残香细袅秋情绪",
        "才道莫伤神，青衫湿一痕",
        "无聊成独卧，弹指韶光过",
        "记得别伊时，桃花柳万丝"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 377068,
      "title": "长相思·一重山",
      "content": [
        "一重山，两重山，山远天高烟水寒，相思枫叶丹",
        "菊花开，菊花残，塞雁高飞人未还，一帘风月闲"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 377069,
      "title": "卜算子·新柳",
      "content": [
        "娇软不胜垂，瘦怯那禁舞",
        "多事年年二月风，翦出鹅黄缕",
        "一种可怜生，落日和烟雨",
        "苏小门前长短条，即渐迷行处"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 377070,
      "title": "采桑子·咏春雨",
      "content": [
        "嫩烟分染鹅儿柳，一样风丝",
        "似整如欹，才着春寒瘦不支",
        "凉侵晓梦轻蝉腻，约略红肥",
        "不惜葳蕤，碾取名香作地衣"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 377071,
      "title": "采桑子·桃花羞作无情死",
      "content": [
        "桃花羞作无情死，感激东风，吹落娇红，飞入窗间伴懊侬",
        "谁怜辛苦东阳瘦，也为春慵，不及芙蓉，一片幽情冷处浓"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
