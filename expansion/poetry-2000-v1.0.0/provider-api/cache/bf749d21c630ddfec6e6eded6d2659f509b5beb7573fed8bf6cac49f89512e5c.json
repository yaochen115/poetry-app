{
  "data": [
    {
      "id": 351742,
      "title": "公莫舞歌",
      "content": [
        "方花古础排九楹，刺豹淋血盛银罂。",
        "华筵鼓吹无桐竹，",
        "腰下三看宝玦光，项庄掉箾栏前起。",
        "材官小臣公莫舞，",
        "铁枢铁楗重束关，大旗五丈撞双镮。",
        "汉王今日颁秦印，"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351743,
      "title": "昌谷北园新笋四首",
      "content": [
        "箨落长竿削玉开，君看母笋是龙材。",
        "更容一夜抽千尺，别却池园数寸泥。",
        "斫取青光写楚辞，腻香春粉黑离离。",
        "无情有恨何人见，露压烟啼千万枝。",
        "家泉石眼两三茎，晓看阴根紫脉生。",
        "今年水曲春沙上，笛管新篁拔玉青。",
        "古竹老梢惹碧云，茂陵归卧叹清贫。",
        "风吹千亩迎雨啸，鸟重一枝入酒尊。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351744,
      "title": "恼公",
      "content": [
        "宋玉愁空断，娇饶粉自红。",
        "歌声春草露，门掩杏花丛。",
        "注口樱桃小，添眉桂叶浓。",
        "晓奁妆秀靥，夜帐减香筒。",
        "钿镜飞孤鹊，江图画水葓。",
        "陂陀梳碧凤，腰袅带金虫。",
        "杜若含清露，河蒲聚紫茸。",
        "月分蛾黛破，花合靥朱融。",
        "发重疑盘雾，腰轻乍倚风。",
        "密书题豆蔻，隐语笑芙蓉。",
        "莫锁茱萸匣，休开翡翠笼。",
        "弄珠惊汉燕，烧蜜引胡蜂。",
        "醉缬抛红网，单罗挂绿蒙。",
        "数钱教姹女，买药问巴賨。",
        "匀脸安斜雁，移灯想梦熊。",
        "肠攒非束竹，胘急是张弓。",
        "晚树迷新蝶，残霓忆断虹。",
        "古时填渤澥，今日凿崆峒。",
        "绣遝褰长幔，罗裙结短封。",
        "心摇如舞鹤，骨出似飞龙。",
        "井槛淋清漆，门铺缀白铜。",
        "隈花开兔径，向壁印狐踪。",
        "玳瑁钉帘薄，琉璃叠扇烘。",
        "象床缘素柏，瑶席卷香葱。",
        "细管吟朝幌，芳醪落夜枫。",
        "宜男生楚巷，栀子发金墉。",
        "龟甲开屏涩，鹅毛渗墨浓。",
        "黄庭留卫瓘，绿树养韩冯。",
        "鸡唱星悬柳，鸦啼露滴桐。",
        "黄娥初出座，宠妹始相从。",
        "蜡泪垂兰烬，秋芜扫绮栊。",
        "吹笙翻旧引，沽酒待新丰。",
        "短佩愁填粟，长弦怨削菘。",
        "曲池眠乳鸭，小阁睡娃僮。",
        "褥缝𥮾双线，钩绦辫五总。",
        "蜀烟飞重锦，峡雨溅轻容。",
        "拂镜羞温峤，熏衣避贾充。",
        "鱼生玉藕下，人在石莲中。",
        "含水弯蛾翠，登楼选马鬃。",
        "使君居曲陌，园令住临邛。",
        "桂火流苏暖，金炉细炷通。",
        "春迟王子态，莺啭谢娘慵。",
        "玉漏三星曙，铜街五马逢。",
        "犀株防胆怯，银液镇心忪。",
        "跳脱看年命，琵琶道吉凶。",
        "王时应七夕，夫位在三宫。",
        "无力涂云母，多方带药翁。",
        "符因青鸟送，囊用绛纱缝。",
        "汉苑寻官柳，河桥阂禁钟。",
        "月明中妇觉，应笑画堂空。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351745,
      "title": "感讽五首",
      "content": [
        "合浦无明珠，龙洲无木奴。",
        "足知造化力，不给使君须。",
        "越妇未织作，吴蚕始蠕蠕。",
        "县官骑马来，狞色虬紫须。",
        "怀中一方板，板上数行书。",
        "不因使君怒，焉得诣尔庐。",
        "越妇拜县官，桑牙今尚小。",
        "会待春日晏，丝车方掷掉。",
        "越妇通言语，小姑具黄粱。",
        "县官踏餐去，簿吏复登堂。",
        "奇俊无少年，日车何躃躃。",
        "我待纡双绶，遗我星星发。",
        "都门贾生墓，青蝇久断绝。",
        "寒食摇扬天，愤景长肃杀。",
        "皇汉十二帝，唯帝称睿哲。",
        "一夕信竖儿，文明永沦歇。",
        "南山何其悲，鬼雨洒空草。",
        "长安夜半秋，风前几人老。",
        "低迷黄昏径，袅袅青栎道。",
        "月午树无影，一山唯白晓。",
        "漆炬迎新人，幽圹萤扰扰。",
        "星尽四方高，万物知天曙。",
        "己生须己养，荷担出门去。",
        "君平久不反，康伯循国路。",
        "晓思何𫍢𫍢，阛阓千人语。",
        "石根秋水明，石畔秋草瘦。",
        "侵衣野竹香，蛰蛰垂叶厚。",
        "岑中月归来，蟾光挂空秀。",
        "桂露对仙娥，星星下云逗。",
        "凄凉栀子落，山璺泣清漏。",
        "下有张仲蔚，披书案将朽。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351747,
      "title": "追和何、谢铜雀妓",
      "content": [
        "佳人一壶酒，秋容满千里。",
        "石马卧新烟，忧来何所似。",
        "歌声且潜弄，陵树风自起。",
        "长裾压高台，泪眼看花机。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 351748,
      "title": "送秦光禄北征",
      "content": [
        "北虏胶堪折，秋沙乱晓鼙。",
        "髯胡频犯塞，骄气似横霓。",
        "灞水楼船渡，营门细柳开。",
        "将军驰白马，豪彦骋雄材。",
        "箭射欃枪落，旗悬日月低。",
        "榆稀山易见，甲重马频嘶。",
        "天远星光没，沙平草叶齐。",
        "风吹云路火，雪污玉关泥。",
        "屡断呼韩颈，曾然董卓脐。",
        "太常犹旧宠，光禄是新隮。",
        "宝玦麒麟起，银壶狒狖啼。",
        "桃花连马发，彩絮扑鞍来。",
        "呵臂悬金斗，当唇注玉罍。",
        "清苏和碎蚁，紫腻卷浮杯。",
        "虎鞟先蒙马，鱼肠且断犀。",
        "𫎺𧽼西旅狗，蹙额北方奚。",
        "守帐然香暮，看鹰永夜栖。",
        "黄龙就别镜，青冢念阳台。",
        "周处长桥役，侯调短弄哀。",
        "钱塘阶凤羽，正室擘鸾钗。",
        "内子攀琪树，羌儿奏落梅。",
        "今朝擎剑去，何日刺蛟回。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351749,
      "title": "酬答二首",
      "content": [
        "金鱼公子夹衫长，密装腰鞓割玉方。",
        "行处春风随马尾，柳花偏打内家香。",
        "雍州二月梅池春，御水䴔䴖暖白苹。",
        "试问酒旗歌板地，今朝谁是拗花人。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 351750,
      "title": "画角东城",
      "content": [
        "河转曙萧萧，鸦飞睥睨高。",
        "帆长摽越甸，壁冷挂吴刀。",
        "淡菜生寒日，鲕鱼潠白涛。",
        "水花沾抹额，旗鼓夜迎潮。",
        "谢秀才有妾缟练改从于人秀才引留之不得后生感忆座人制诗嘲谢贺复继四首",
        "谁知泥忆云，望断梨花春。",
        "荷丝制机练，竹叶剪花裙。",
        "月明啼阿姊，灯暗会良人。",
        "也识君夫婿，金鱼挂在身。",
        "铜镜立青鸾，燕脂拂紫绵。",
        "腮花弄暗粉，眼尾泪侵寒。",
        "碧玉破不复，瑶琴重拨弦。",
        "今日非昔日，何人敢正看。",
        "洞房思不禁，蜂子作花心。",
        "灰暖残香炷，发冷青虫簪。",
        "夜遥灯焰短，睡熟小屏深。",
        "好作鸳鸯梦，南城罢捣砧。",
        "寻常轻宋玉，今日嫁文鸯。",
        "戟干横龙簴，刀环倚桂窗。",
        "邀人裁半袖，端坐据胡床。",
        "泪湿红轮重，栖乌上井梁。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351752,
      "title": "巴童答",
      "content": [
        "巨鼻宜山褐，庞眉入苦吟。",
        "非君唱乐府，谁识怨秋深。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 351753,
      "title": "代崔家送客",
      "content": [
        "行尽柳烟下，马蹄白翩翩。",
        "恐随行处尽，何忍重扬鞭。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 351756,
      "title": "将发",
      "content": [
        "东床卷席罢，濩落将行去。",
        "秋白遥遥空，日满门前路。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 351757,
      "title": "追赋画江潭苑四首",
      "content": [
        "吴苑晓苍苍，宫衣水溅黄。",
        "小鬟红粉薄，骑马佩珠长。",
        "路指台城迥，罗熏袴褶香。",
        "行云沾翠辇，今日似襄王。",
        "宝袜菊衣单，蕉花密露寒。",
        "水光兰泽叶，带重剪刀钱。",
        "角暖盘弓易，靴长上马难。",
        "泪痕沾寝帐，匀粉照金鞍。",
        "剪翅小鹰斜，绦根玉旋花。",
        "秋垂妆钿粟，箭箙钉文牙。",
        "狒狒啼深竹，䴔䴖老湿沙。",
        "宫官烧蜡火，飞烬污铅华。",
        "十骑簇芙蓉，宫衣小队红。",
        "练香熏宋鹊，寻箭踏卢龙。",
        "旗湿金铃重，霜干玉镫空。",
        "今朝画眉早，不待景阳钟。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351758,
      "title": "潞州张大宅病酒，遇江使，寄上十四兄",
      "content": [
        "秋至昭关后，当知赵国寒。",
        "系书随短羽，写恨破长笺。",
        "病客眠清晓，疏桐坠绿鲜。",
        "城鸦啼粉堞，军吹压芦烟。",
        "岸帻褰沙幌，枯塘卧折莲。",
        "木窗银迹画，石磴水痕钱。",
        "旅酒侵愁肺，离歌绕懦弦。",
        "诗封两条泪，露折一枝兰。",
        "莎老沙鸡泣，松干瓦兽残。",
        "觉骑燕地马，梦载楚溪船。",
        "椒桂倾长席，鲈鲂斫玳筵。",
        "岂能忘旧路，江岛滞佳年。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351760,
      "title": "贾公闾贵婿曲",
      "content": [
        "朝衣不须长，分花对袍缝。",
        "嘤嘤白马来，满脑黄金重。",
        "今朝香气苦，珊瑚涩难枕。",
        "且要弄风人，暖蒲沙上饮。",
        "燕语踏帘钩，日虹屏中碧。",
        "潘令在河阳，无人死芳色。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351761,
      "title": "夜饮朝眠曲",
      "content": [
        "觞酣出座东方高，腰横半解星劳劳。",
        "柳苑鸦啼公主醉，",
        "夜饮朝眠断无事，楚罗之帏卧皇子。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351762,
      "title": "王浚墓下作",
      "content": [
        "人间无阿童，犹唱水中龙。",
        "白草侵烟死，秋梨绕地红。",
        "古书平黑石，袖剑断青铜。",
        "耕势鱼鳞起，坟科马鬣封。",
        "菊花垂湿露，棘径卧干蓬。",
        "松柏愁香涩，南原几夜风。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351764,
      "title": "崇义里滞雨",
      "content": [
        "落莫谁家子，来感长安秋。",
        "壮年抱羁恨，梦泣生白头。",
        "瘦马秣败草，雨沫飘寒沟。",
        "南宫古帘暗，湿景传签筹。",
        "家山远千里，云脚天东头。",
        "忧眠枕剑匣，客帐梦封侯。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351766,
      "title": "赠陈商",
      "content": [
        "长安有男儿，二十心已朽。",
        "楞伽堆案前，楚辞系肘后。",
        "人生有穷拙，日暮聊饮酒。",
        "只今道已塞，何必须白首。",
        "凄凄陈述圣，披褐鉏俎豆。",
        "学为尧舜文，时人责衰偶。",
        "柴门车辙冻，日下榆影瘦。",
        "黄昏访我来，苦节青阳皱。",
        "太华五千仞，劈地抽森秀。",
        "旁古无寸寻，一上戛牛斗。",
        "公卿纵不怜，宁能锁吾口。",
        "李生师太华，大坐看白昼。",
        "逢霜作朴樕，得气为春柳。",
        "礼节乃相去，憔悴如刍狗。",
        "风雪直斋坛，墨组贯铜绶。",
        "臣妾气态间，唯欲承箕帚。",
        "天眼何时开，古剑庸一吼。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351767,
      "title": "钓鱼诗",
      "content": [
        "秋水钓红渠，仙人待素书。",
        "菱丝萦独茧，蒲米蛰双鱼。",
        "斜竹垂清沼，长纶贯碧虚。",
        "饵悬春蜥蜴，钩坠小蟾蜍。",
        "詹子情无限，龙阳恨有余。",
        "为看烟浦上，楚女泪沾裾。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351768,
      "title": "奉和二兄罢使遣马归延州",
      "content": [
        "空留三尺剑，不用一丸泥。",
        "马向沙场去，人归故国来。",
        "笛愁翻陇水，酒喜沥春灰。",
        "锦带休惊雁，罗衣尚斗鸡。",
        "还吴已渺渺，入郢莫凄凄。",
        "自是桃李树，何畏不成蹊。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351769,
      "title": "答赠",
      "content": [
        "本是张公子，曾名萼绿华。",
        "沉香熏小像，杨柳伴啼鸦。",
        "露重金泥冷，杯阑玉树斜。",
        "琴堂沽酒客，新买后园花。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 351773,
      "title": "河阳歌",
      "content": [
        "染罗衣，秋蓝难著色。",
        "不是无心人，为作台邛客。",
        "花烧中潬城，颜郎身已老。",
        "惜许两少年，抽心似春草。",
        "今日见银牌，今夜鸣玉晏。",
        "牛头高一尺，隔坐应相见。",
        "月从东方来，酒从东方转。",
        "觥船饫口红，蜜炬千枝烂。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351775,
      "title": "春昼",
      "content": [
        "朱城报春更漏转，光风催兰吹小殿。",
        "草细堪梳，柳长如线。",
        "卷衣秦帝，扫粉赵燕。",
        "日含画幕，蜂上罗荐。",
        "平阳花坞，",
        "江南有情，塞北无恨。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351776,
      "title": "安乐宫",
      "content": [
        "深井桐乌起，尚复牵情水。",
        "未盥邵陵瓜，瓶中弄长翠。",
        "新成安乐宫，宫如凤凰翅。",
        "歌回蜡板鸣，左悺提壶使。",
        "绿蘩悲水曲，茱萸别秋子。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351777,
      "title": "蝴蝶飞",
      "content": [
        "杨花扑帐春云热，龟甲屏风醉眼缬。",
        "东家蝴蝶西家飞，白骑少年今日归。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 351778,
      "title": "梁公子",
      "content": [
        "风彩出萧家，本是菖蒲花。",
        "南塘莲子熟，洗马走江沙。",
        "御笺银沫冷，长簟凤窠斜。",
        "种柳营中暗，题书赐馆娃。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 351779,
      "title": "牡丹种曲",
      "content": [
        "莲枝未长秦蘅老，走马驮金㔉春草。",
        "水灌香泥却月盆，",
        "梁王老去罗衣在，拂袖风吹蜀国弦。",
        "归霞帔拖蜀帐昏，"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351780,
      "title": "后园凿井歌",
      "content": [
        "井上辘轳床上转。",
        "水声繁，弦声浅。",
        "情若何，荀奉倩。",
        "城头日，长向城头住。",
        "一日作千年，不须流下去。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351781,
      "title": "开愁歌",
      "content": [
        "秋风吹地百草干，华容碧影生晚寒。",
        "我当二十不得意，",
        "旗亭下马解秋衣，请贳宜阳一壶酒。",
        "壶中唤天云不开，"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351782,
      "title": "秦宫诗",
      "content": [
        "越罗衫袂迎春风，玉刻麒麟腰带红。",
        "楼头曲宴仙人语，",
        "飞窗复道传筹饮，十夜铜盘腻烛黄。",
        "秃衿小袖调鹦鹉，",
        "桐英永巷骑新马，内屋深屏生色画。",
        "开门烂用水衡钱，",
        "鸾篦夺得不还人，醉睡氍毹满堂月。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351783,
      "title": "古邺城童子谣，效王粲刺曹操",
      "content": [
        "邺城中，暮尘起。",
        "将黑丸，斫文吏。",
        "棘为鞭，虎为马。",
        "团团走，邺城下。",
        "切玉剑，射日弓。",
        "献何人，奉相公。",
        "扶毂来，关右儿。",
        "香扫涂，相公归。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351784,
      "title": "杨生青花紫石砚歌",
      "content": [
        "端州石工巧如神，踏天磨刀割紫云。",
        "佣刓抱水含满唇，",
        "干腻薄重立脚匀，数寸光秋无日昏。",
        "圆毫促点声静新，"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351786,
      "title": "石城晓",
      "content": [
        "月落大堤上，女垣栖乌起。",
        "细露湿团红，寒香解夜醉。",
        "女牛渡天河，柳烟满城曲。",
        "上客留断缨，残蛾斗双绿。",
        "春帐依微蝉翼罗，横茵突金隐体花。",
        "帐前轻絮鹤毛起，"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351787,
      "title": "苦昼短",
      "content": [
        "飞光飞光，劝尔一杯酒。",
        "吾不识青天高，黄地厚，",
        "神君何在，太一安有。",
        "天东有若木，下置衔烛龙。",
        "吾将斩龙足，嚼龙肉。",
        "使之朝不得回，夜不得伏。",
        "自然老者不死，少者不哭。",
        "何为服黄金，吞白玉。",
        "谁似任公子，云中骑碧驴。",
        "刘彻茂陵多滞骨，"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351788,
      "title": "章和二年中",
      "content": [
        "云萧索，田风拂拂，麦芒如篲黍如粟。",
        "关中父老百领襦，",
        "殷勤为我下田租，百钱携偿丝桐客。",
        "游春漫光坞花白，"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351789,
      "title": "春归昌谷",
      "content": [
        "束发方读书，谋身苦不早。",
        "终军未乘传，颜子鬓先老。",
        "天网信崇大，矫士常慅慅。",
        "逸目骈甘华，羁心如荼蓼。",
        "旱云二三月，岑岫相颠倒。",
        "谁揭赪玉盘，东方发红照。",
        "春热张鹤盖，兔目官槐小。",
        "思焦面如病，尝胆肠似绞。",
        "京国心烂漫，夜梦归家少。",
        "发轫东门外，天地皆浩浩。",
        "青树骊山头，花风满秦道。",
        "宫台光错落，装尽偏峰峤。",
        "细绿及团红，当路杂啼笑。",
        "香风下高广，鞍马正华耀。",
        "独乘鸡栖车，自觉少风调。",
        "心曲语形影，只身焉足乐。",
        "岂能脱负簷，刻鹤曾无兆。",
        "幽幽太华侧，老柏如建纛。",
        "龙皮相排戛，翠羽更荡掉。",
        "驱趋委憔悴，眺览强容貌。",
        "花蔓阂行辀，縠烟暝深徼。",
        "少健无所就，入门愧家老。",
        "听讲依大树，观书临曲沼。",
        "知非出柙虎，甘作藏雾豹。",
        "韩鸟处矰缴，湘鯈在笼罩。",
        "狭行无廓落，壮士徒轻躁。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351790,
      "title": "昌谷诗",
      "content": [
        "昌谷五月稻，细青满平水。",
        "遥峦相压叠，颓绿愁堕地。",
        "光洁无秋思，凉旷吹浮媚。",
        "竹香满凄寂，粉节涂生翠。",
        "草发垂恨鬓，光露泣幽泪。",
        "层围烂洞曲，芳径老红醉。",
        "攒虫锼古柳，蝉子鸣高邃。",
        "大带委黄葛，紫蒲交狭涘。",
        "石钱差复藉，厚叶皆蟠腻。",
        "汰沙好平白，立马印青字。",
        "晚鳞自遨游，瘦鹄暝单跱。",
        "嘹嘹湿蛄声，咽源惊溅起。",
        "纡缓玉真路，神娥蕙花里。",
        "苔絮萦涧砾，山实垂赪紫。",
        "小柏俨重扇，肥松突丹髓。",
        "鸣流走响韵，垄秋拖光穟。",
        "莺唱闵女歌，瀑悬楚练帔。",
        "风露满笑眼，骈岩杂舒坠。",
        "乱条迸石岭，细颈喧岛毖。",
        "日脚扫昏翳，新云启华閟。",
        "谧谧厌夏光，商风道清气。",
        "高眠服玉容，烧桂祀天几。",
        "雾衣夜披拂，眠坛梦真粹。",
        "待驾栖鸾老，故宫椒壁圮。",
        "鸿珑数铃响，羁臣发凉思。",
        "阴藤束朱键，龙帐著魈魅。",
        "碧锦帖花柽，香衾事残贵。",
        "歌尘蠹木在，舞彩长云似。",
        "珍壤割绣段，里俗祖风义。",
        "邻凶不相杵，疫病无邪祀。",
        "鲐皮识仁惠，丱角知腼耻。",
        "县省司刑官，户乏诟租吏。",
        "竹薮添堕简，石矶引钩饵。",
        "溪湾转水带，芭蕉倾蜀纸。",
        "岑光晃縠襟，孤景拂繁事。",
        "泉尊陶宰酒，月眉谢郎妓。",
        "丁丁幽钟远，矫矫单飞至。",
        "霞𪩘殷嵯峨，危溜听争次。",
        "淡蛾流平碧，薄月眇阴悴。",
        "凉光入涧岸，廓尽山中意。",
        "渔童下宵网，霜禽竦烟翅。",
        "潭镜滑蛟涎，浮珠𪡋鱼戏。",
        "风桐瑶匣瑟，萤星锦城使。",
        "柳缀长缥带，篁掉短笛吹。",
        "石根缘绿藓，芦笋抽丹渍。",
        "漂旋弄天影，古桧拏云臂。",
        "愁月薇帐红，罥云香蔓刺。",
        "芒麦平百井，闲乘列千肆。",
        "刺促成纪人，好学鸱夷子。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351792,
      "title": "自昌谷到洛后门",
      "content": [
        "九月大野白，苍岑竦秋门。",
        "寒凉十月末，露霰蒙晓昏。",
        "澹色结昼天，心事填空云。",
        "道上千里风，野竹蛇涎痕。",
        "石涧涷波声，鸡叫清寒晨。",
        "强行到东舍，解马投旧邻。",
        "东家名廖者，乡曲传姓辛。",
        "杖头非饮酒，吾请造其人。",
        "始欲南去楚，又将西适秦。",
        "襄王与武帝，各自留青春。",
        "闻道兰台上，宋玉无归魂。",
        "缃缥两行字，蛰虫蠹秋芸。",
        "为探秦台意，岂命余负薪。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351793,
      "title": "七月一日晓入太行山",
      "content": [
        "一夕绕山秋，香露溘蒙菉。",
        "新桥倚云阪，候虫嘶露朴。",
        "洛南今已远，越衾谁为熟。",
        "石气何凄凄，老莎如短镞。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 351794,
      "title": "秋凉诗，寄正字十二兄",
      "content": [
        "闭门感秋风，幽姿任契阔。",
        "大野生素空，天地旷肃杀。",
        "露光泣残蕙，虫响连夜发。",
        "房寒寸辉薄，迎风绛纱折。",
        "披书古芸馥，恨唱华容歇。",
        "百日不相知，花光变凉节。",
        "弟兄谁念虑，笺翰既通达。",
        "青袍度白马，草简奏东阙。",
        "梦中相聚笑，觉见半床月。",
        "长思剧寻环，乱忧抵覃葛。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351795,
      "title": "艾如张",
      "content": [
        "锦襜褕，绣裆襦。",
        "强饮啄，哺尔雏。",
        "陇东卧穟满风雨，",
        "网丝漠漠无形影，误尔触之伤首红。",
        "艾叶绿花谁剪刻，"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351796,
      "title": "上云乐",
      "content": [
        "飞香走红满天春，花龙盘盘上紫云。",
        "三千宫女列金屋，",
        "断烟素，缝衣缕，八月一日君前舞。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351799,
      "title": "日出行",
      "content": [
        "白日下昆仑，发光如舒丝。",
        "徒照葵藿心，不照游子悲。",
        "折折黄河曲，日从中央转。",
        "旸谷耳曾闻，若木眼不见。",
        "奈尔铄石，胡为销人。",
        "羿弯弓属矢那不中，"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351800,
      "title": "苦篁调啸引",
      "content": [
        "请说轩辕在时事，伶伦采竹二十四。",
        "伶伦采之自昆丘，",
        "当时黄帝上天时，二十三管咸相随，唯留一管人间吹。",
        "无德不能得此管，此管沉埋虞舜祠。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 351801,
      "title": "拂舞歌辞",
      "content": [
        "吴娥声绝天，空云闲裴回。",
        "门外满车马，亦须生绿苔。",
        "尊有乌程酒，劝君千万寿。",
        "全胜汉武锦楼上，",
        "丹成作蛇乘白雾，千年重化玉井土。",
        "从蛇作土一千载，"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 351802,
      "title": "夜坐吟",
      "content": [
        "踏踏马蹄谁见过，眼看北斗直天河。",
        "西风罗幕生翠波，",
        "明星烂烂东方陲，红霞梢出东南涯，陆郎去矣乘班骓。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351803,
      "title": "箜篌引",
      "content": [
        "公乎公乎，提壶将焉如。",
        "屈平沉湘不足慕，",
        "北里有贤兄，东邻有小姑。",
        "陇亩油油黍与葫，",
        "被发奔流竟何如，贤兄小姑哭呜呜。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351804,
      "title": "巫山高",
      "content": [
        "碧丛丛，高插天，大江翻澜神曳烟。",
        "楚魂寻梦风飔然，",
        "古祠近月蟾桂寒，椒花坠红湿云间。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351805,
      "title": "平城下",
      "content": [
        "饥寒平城下，夜夜守明月。",
        "别剑无玉花，海风断鬓发。",
        "塞长连白空，遥见汉旗红。",
        "青帐吹短笛，烟雾湿昼龙。",
        "日晚在城上，依稀望城下。",
        "风吹枯蓬起，城中嘶瘦马。",
        "借问筑城吏，去关几千里。",
        "惟愁裹尸归，不惜倒戈死。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351806,
      "title": "江南弄",
      "content": [
        "江中绿雾起凉波，天上叠𪩘红嵯峨。",
        "水风浦云生老竹，",
        "吴歈越吟未终曲，江上团团帖寒玉。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 351807,
      "title": "荣华乐",
      "content": [
        "鸢肩公子二十余，齿编贝，唇激朱。",
        "气如虹霓，饮如建瓴，",
        "玉堂调笑金楼子，台下戏学邯郸倡。",
        "口吟舌话称女郎，",
        "将回日月先反掌，欲作江河唯画地。",
        "峨峨虎冠上切云，",
        "十二门前张大宅，晴春烟起连天碧。",
        "金铺缀日杂红光，",
        "丹穴取凤充行庖，玃玃如拳那足食。",
        "金蟾呀呀兰烛香，",
        "嘈嘈弦吹匝天开，洪崖箫声绕天来。",
        "天长一矢贯双虎，",
        "能教刻石平紫金，解送刻毛寄新兔。",
        "三皇皇后七贵人，"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351808,
      "title": "相劝酒",
      "content": [
        "羲和骋六辔，昼夕不曾闲。",
        "弹乌崦嵫竹，抶马蟠桃鞭。",
        "蓐收既断翠柳，青帝又造红兰。",
        "尧舜至今万万岁，",
        "臛蠵臑熊何足云。",
        "会须钟饮北海，箕踞南山。",
        "歌淫淫，管愔愔，横波好送雕题金。",
        "人生得意且如此，",
        "伏愿陛下鸿名终不歇，子孙绵如石上葛。",
        "来长安，车骈骈。",
        "中有梁冀旧宅，石崇故园。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351809,
      "title": "瑶华乐",
      "content": [
        "穆天子，走龙媒。",
        "八辔冬珑逐天回，五精扫地凝云开。",
        "高门左右日月环，四方错镂棱层殷。",
        "舞霞垂尾长盘珊，",
        "列旆如松，张盖如轮。",
        "金风殿秋，清明发春。",
        "八銮十乘，",
        "熏梅染柳将赠君。",
        "铅华之水洗君骨，与君相对作真质。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351810,
      "title": "北中寒",
      "content": [
        "一方黑照三方紫，黄河冰合鱼龙死。",
        "三尺木皮断文理，",
        "争瀯海水飞凌喧，山瀑无声玉虹悬。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351811,
      "title": "梁台古愁",
      "content": [
        "梁王台沼空中立，天河之水夜飞入。",
        "台前斗玉作蛟龙，",
        "朝朝暮暮愁海翻，长绳系日乐当年。",
        "芙蓉凝红得秋色，"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351812,
      "title": "公无出门",
      "content": [
        "天迷迷，地密密。",
        "熊虺食人魂，雪霜断人骨。",
        "嗾犬狺狺相索索，舐掌偏宜佩兰客。",
        "帝遣乘轩灾自息，",
        "毒虬相视振金环，狻猊猰貐吐馋涎。",
        "鲍焦一世披草眠，"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351813,
      "title": "神弦别曲",
      "content": [
        "巫山小女隔云别，春风松花山上发。",
        "绿盖独穿香径归，",
        "南山桂树为君死，云衫浅污红脂花。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351815,
      "title": "沙路曲",
      "content": [
        "柳脸半眠丞相树，佩马钉铃踏沙路。",
        "断烬遗香袅翠烟，",
        "独垂重印押千官，金窠篆字红屈盘。",
        "沙路归来闻好语，"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351816,
      "title": "上之回",
      "content": [
        "上之回，大旗喜。",
        "悬红云，挞凤尾。",
        "剑匣破，舞蛟龙。",
        "蚩尤死，鼓逢逢。",
        "天高庆雷齐坠地，地无惊烟海千里。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351817,
      "title": "高轩过",
      "content": [
        "华裾织翠青如葱，金环压辔摇玲珑。",
        "马蹄隐耳声隆隆，",
        "二十八宿罗心胸，九精照耀贯当中。",
        "殿前作赋声摩空，",
        "我今垂翅附冥鸿，他日不羞蛇作龙。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 351818,
      "title": "贝宫夫人",
      "content": [
        "丁丁海女弄金环，雀钗翘揭双翅关。",
        "六宫不语一生闲，",
        "秋肌稍觉玉衣寒，空光帖妥水如天。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351819,
      "title": "兰香神女庙",
      "content": [
        "古春年年在，闲绿摇暖云。",
        "松香飞晚华，柳渚含日昏。",
        "沙砌落红满，石泉生水芹。",
        "幽篁画新粉，蛾绿横晓门。",
        "弱蕙不胜露，山秀愁空春。",
        "舞佩剪鸾翼，帐带涂轻银。",
        "兰桂吹浓香，菱藕长莘莘。",
        "看雨逢瑶姬，乘船值江君。",
        "吹箫饮酒醉，结绶金丝裙。",
        "走天呵白鹿，游水鞭锦鳞。",
        "密发虚鬟飞，腻颊凝花匀。",
        "团鬓分蛛巢，秾眉笼小唇。",
        "弄蝶和轻妍，风光怯腰身。",
        "深帏金鸭冷，奁镜幽凤尘。",
        "踏雾乘同归，撼玉山上闻。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351820,
      "title": "送韦仁实兄弟入关",
      "content": [
        "送客饮别酒，千觞无赭颜。",
        "何物最伤心，马首鸣金镮。",
        "野色浩无主，秋明空旷间。",
        "坐来壮胆破，断目不能看。",
        "行槐引西道，青梢长攒攒。",
        "韦郎好兄弟，叠玉生文翰。",
        "我在山上舍，一亩蒿硗田。",
        "夜雨叫租吏，春声暗交关。",
        "谁解念劳劳，苍突唯南山。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351822,
      "title": "溪晚凉",
      "content": [
        "白狐向月号山风，秋寒扫云留碧空。",
        "玉烟青湿白如幢，",
        "层岫回岑复叠龙，苦篁对客吟歌筒。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351823,
      "title": "官不来，题皇甫湜先辈厅",
      "content": [
        "官不来，官庭秋，老桐错干青龙愁。",
        "书司曹佐走如牛，"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351824,
      "title": "长平箭头歌",
      "content": [
        "漆灰骨末丹水沙，凄凄古血生铜花。",
        "白翎金簳雨中尽，",
        "风长日短星萧萧，黑旗云湿悬空夜。",
        "左魂右魄啼肌瘦，",
        "访古汍澜收断镞，折锋赤璺曾刲肉。",
        "南陌东城马上儿，"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351825,
      "title": "江楼曲",
      "content": [
        "楼前流水江陵道，鲤鱼风起芙蓉老。",
        "晓钗催鬓语南风，",
        "萧骚浪白云差池，黄粉油衫寄郎主。",
        "新槽酒声苦无力，"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351826,
      "title": "塞下曲",
      "content": [
        "胡角引北风，蓟门白于水。",
        "天含青海道，城头月千里。",
        "露下旗蒙蒙，寒金鸣夜刻。",
        "蕃甲锁蛇鳞，马嘶青冢白。",
        "秋静见旄头，沙远席羁愁。",
        "帐北天应尽，河声出塞流。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 351827,
      "title": "染丝上春机",
      "content": [
        "玉罂泣水桐花井，蒨丝沉水如云影。",
        "美人懒态燕脂愁，"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351828,
      "title": "五粒小松歌",
      "content": [
        "蛇子蛇孙鳞蜿蜿，新香几粒洪崖饭。",
        "绿波浸叶满浓光，",
        "月明白露秋泪滴，石笋溪云肯寄书。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351830,
      "title": "吕将军歌",
      "content": [
        "吕将军，骑赤兔。",
        "独携大胆出秦门，金粟堆边哭陵树。",
        "北方逆气污青天，剑龙夜叫将军闲。",
        "将军振袖挥剑锷，",
        "恒山铁骑请金枪，遥闻箙中花箭香。",
        "西郊寒蓬叶如刺，",
        "圆苍低迷盖张地，九州人事皆如此。",
        "赤山秀铤御时英，"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351832,
      "title": "神弦曲",
      "content": [
        "西山日没东山昏，旋风吹马马踏云。",
        "画弦素管声浅繁，",
        "古壁彩虬金帖尾，雨工骑入秋潭水。",
        "百年老鸮成木魅，"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351833,
      "title": "野歌",
      "content": [
        "鸦翎羽箭山桑弓，仰天射落衔芦鸿。",
        "麻衣黑肥冲北风，",
        "寒风又变为春柳，条条看即烟蒙蒙。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351834,
      "title": "神弦",
      "content": [
        "女巫浇酒云满空，玉炉炭火香冬冬。",
        "海神山鬼来座中，",
        "呼星召鬼歆杯盘，山魅食时人森寒。",
        "终南日色低平湾，"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351835,
      "title": "将进酒",
      "content": [
        "琉璃钟，琥珀浓，小槽酒滴真珠红。",
        "烹龙炮凤玉脂泣，",
        "况是青春日将暮，桃花乱落如红雨。",
        "劝君终日酩酊醉，"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 351836,
      "title": "美人梳头歌",
      "content": [
        "西施晓梦绡帐寒，香鬟堕髻半沉檀。",
        "辘轳咿哑转鸣玉，",
        "一编香丝云撒地，玉钗落处无声腻。",
        "纤手却盘老鸦色，",
        "妆成pE鬌欹不斜，云裾数步踏雁沙。",
        "背人不语向何处，"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351837,
      "title": "月漉漉篇",
      "content": [
        "月漉漉，波烟玉。",
        "莎青桂花繁，芙蓉别江木。",
        "粉态袷罗寒，雁羽铺烟湿。",
        "谁能看石帆，乘船镜中入。",
        "秋白鲜红死，水香莲子齐。",
        "挽菱隔歌袖，绿刺罥银泥。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351839,
      "title": "官街鼓",
      "content": [
        "晓声隆隆催转日，暮声隆隆呼月出。",
        "汉城黄柳映新帘，",
        "从君翠发芦花色，独共南山守中国。",
        "几回天上葬神仙，"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351840,
      "title": "许公子郑姬歌",
      "content": [
        "许史世家外亲贵，宫锦千端买沉醉。",
        "铜驼酒熟烘明胶，",
        "先将芍药献妆台，后解黄金大如斗。",
        "莫愁帘中许合欢，",
        "两马八蹄踏兰苑，情如合竹谁能见。",
        "夜光玉枕栖凤凰，",
        "自从小靥来东道，曲里长眉少见人。",
        "相如冢上生秋柏，"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351841,
      "title": "新夏歌",
      "content": [
        "晓木千笼真蜡彩，落蕊枯香数分在。",
        "阴枝秀牙卷缥茸，",
        "刺香满地菖蒲草，雨梁燕语悲身老。",
        "三月摇扬入河道，"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351844,
      "title": "出城别张又新酬李汉",
      "content": [
        "李子别上国，南山崆峒春。",
        "不闻今夕鼓，差慰煎情人。",
        "赵壹赋命薄，马卿家业贫。",
        "乡书何所报，紫蕨生石云。",
        "长安玉桂国，戟带披侯门。",
        "惨阴地自光，宝马踏晓昏。",
        "腊春戏草苑，玉挽鸣qX辚。",
        "绿网缒金铃，霞卷清池漘。",
        "开贯泻蚨母，买冰防夏蝇。",
        "时宜裂大袂，剑客车盘茵。",
        "小人如死灰，心切生秋榛。",
        "皇图跨四海，百姓拖长绅。",
        "光明霭不发，腰龟徒甃银。",
        "吾将噪礼乐，声调摩清新。",
        "欲使十千岁，帝道如飞神。",
        "华实自苍老，流采长倾湓。",
        "没没暗𫜬舌，涕血不敢论。",
        "今将下东道，祭酒而别秦。",
        "六郡无剿儿，长刀谁拭尘。",
        "地理阳无正，快马逐服辕。",
        "二子美年少，调道讲清浑。",
        "讥笑断冬夜，家庭疏筱穿。",
        "曙风起四方，秋月当东悬。",
        "赋诗面投掷，悲哉不遇人。",
        "此别定沾臆，越布先裁巾。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351845,
      "title": "南园",
      "content": [
        "方领蕙带折角巾，杜若已老兰苕春。",
        "南山削秀蓝玉合，",
        "郑公乡老开酒尊，坐泛楚奏吟招魂。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351846,
      "title": "假龙吟歌",
      "content": [
        "石轧铜杯，吟咏枯瘁。",
        "苍鹰摆血，白凤下肺。",
        "桂子自落，",
        "窞中跳汰截清涎，隈壖卧水埋金爪。",
        "崖蹬苍苔吊石发，"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351847,
      "title": "感讽六首",
      "content": [
        "人间春荡荡，帐暖香扬扬。",
        "飞光染幽红，夸娇来洞房。",
        "舞席泥金蛇，桐竹罗花床。",
        "眼逐春瞑醉，粉随泪色黄。",
        "王子下马来，曲沼鸣鸳鸯。",
        "焉知肠车转，一夕巡九方。",
        "苦风吹朔寒，沙惊秦木折。",
        "舞影逐空天，画鼓余清节。",
        "蜀书秋信断，黑水朝波咽。",
        "娇魂从回风，死处悬乡月。",
        "杂杂胡马尘，森森边士戟。",
        "天教胡马战，晓云皆血色。",
        "妇人携汉卒，箭箙囊巾帼。",
        "不惭金印重，踉跄腰鞬力。",
        "恂恂乡门老，昨夜试锋镝。",
        "走马遣书勋，谁能分粉墨。",
        "青门放弹去，马色连空郊。",
        "何年帝家物，玉装鞍上摇。",
        "去去走犬归，来来坐烹羔。",
        "千金不了馔，狢肉称盘臊。",
        "试问谁家子，乃老能佩刀。",
        "西山白盖下，贤俊寒萧萧。",
        "晓菊泫寒露，似悲团扇风。",
        "秋凉经汉殿，班子泣衰红。",
        "本无辞辇意，岂见入空宫。",
        "腰衱佩珠断，灰蝶生阴松。",
        "蝶飞红粉台，柳扫吹笙道。",
        "十日悬户庭，九秋无衰草。",
        "调歌送风转，杯池白鱼小。",
        "水宴截香腴，菱科映青罩。",
        "zv蒙梨花满，春昏弄长啸。",
        "唯愁苦花落，不悟世衰到。",
        "抚旧唯销魂，南山坐悲峭。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351848,
      "title": "莫愁曲",
      "content": [
        "草生龙坡下，鸦噪城堞头。",
        "何人此城里，城角栽石榴。",
        "青丝系五马，黄金络双牛。",
        "白鱼驾莲船，夜作十里游。",
        "归来无人识，暗上沈香楼。",
        "罗床倚瑶瑟，残月倾帘钩。",
        "今日槿花落，明朝桐树秋。",
        "莫负平生意，何名何莫愁。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351849,
      "title": "夜来乐",
      "content": [
        "红罗复帐金流苏，华灯九枝悬鲤鱼。",
        "丽人映月开铜铺，",
        "五丝封青凫，阿侯此笑千万余。",
        "南轩汉转帘影疏，",
        "漏长送佩承明庐，倡楼嵯峨明月孤。",
        "新客下马故客去，"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351851,
      "title": "春怀引",
      "content": [
        "芳蹊密影成花洞，柳结浓烟花带重。",
        "蟾蜍碾玉挂明弓，",
        "阿侯系锦觅周郎，凭仗东风好相送。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351852,
      "title": "白虎行",
      "content": [
        "火乌日暗崩腾云，秦皇虎视苍生群。",
        "烧书灭国无暇日，",
        "烧丹未得不死药，拏舟海上寻神仙。",
        "鲸鱼张鬣海波沸，",
        "谁最苦兮谁最苦，报人义士深相许。",
        "渐离击筑荆卿歌，",
        "天授秦封祚未移，衮龙衣点荆卿血。",
        "朱旗卓地白虎死，"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351853,
      "title": "有所思",
      "content": [
        "去年陌上歌离曲，今日君书远游蜀。",
        "帘外花开二月风，",
        "想君白马悬雕弓，世间何处无春风。",
        "君心未肯镇如石，",
        "西风未起悲龙梭，年年织素攒双蛾。",
        "江山迢递无休绝，",
        "鸦鸦向晓鸣森木，风过池塘响丛玉。",
        "白日萧条梦不成，"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 351854,
      "title": "啁少年",
      "content": [
        "青骢马肥金鞍光，龙脑入缕罗衫香。",
        "美人狭坐飞琼觞，",
        "有时半醉百花前，背把金丸落飞鸟。",
        "自说生来未为客，",
        "长得积玉夸豪毅，每揖闲人多意气。",
        "生来不读半行书，",
        "荣枯递传急如箭，天公不肯于公偏。",
        "莫道韶华镇长在，"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351855,
      "title": "高平县东私路",
      "content": [
        "侵侵槲叶香，木花滞寒雨。",
        "今夕山上秋，永谢无人处。",
        "石溪远荒涩，棠实悬辛苦。",
        "古者定幽寻，呼君作私路。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 351856,
      "title": "神仙曲",
      "content": [
        "碧峰海面藏灵书，上帝拣作神仙居。",
        "清明笑语闻空虚，",
        "鹤羽冲风过海迟，不如却使青龙去。",
        "犹疑王母不相许，"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351857,
      "title": "龙夜吟",
      "content": [
        "卷发胡儿眼睛绿，高楼夜静吹横竹。",
        "一声似向天上来，",
        "蜀道秋深云满林，湘江半夜龙惊起。",
        "玉堂美人边塞情，",
        "胡儿莫作陇头吟，隔窗暗结愁人心。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 351858,
      "title": "昆仑使者",
      "content": [
        "昆仑使者无消息，茂陵烟树生愁色。",
        "金盘玉露自淋漓，",
        "何处偏伤万国心，中天夜久高明月。"
      ],
      "author": {
