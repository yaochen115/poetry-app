{
  "data": [
    {
      "id": 283195,
      "title": "光启丁未别山",
      "content": [
        "草堂琴画已判烧，犹托邻僧护燕巢。",
        "此去不缘名利去，若逢逋客莫相嘲。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283196,
      "title": "石楠",
      "content": [
        "客处偷闲未是闲，石楠虽好懒频攀。",
        "如何风叶西归路，吹断寒云见故山。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283197,
      "title": "力疾马上走笔",
      "content": [
        "酿黍长添不尽杯，只忧花尽客空回。",
        "垂杨且为晴遮日，留遇重阳即放开。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283198,
      "title": "华阴县楼",
      "content": [
        "丹霄能有几层梯，懒更扬鞭耸翠蜺。",
        "偶凭危栏且南望，不劳高掌欲相携。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283199,
      "title": "南至四首 一",
      "content": [
        "今冬腊后无残日，故国烧来有几家。",
        "却恨早梅添旅思，强偷春力报年华。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283200,
      "title": "南至四首 二",
      "content": [
        "花时不是偏愁我，好事应难总取他。",
        "已被诗魔长役思，眼中莫厌早梅多。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283201,
      "title": "南至四首 三",
      "content": [
        "年华乱后偏堪惜，世路抛来已自生。",
        "犹有玉真长命缕，樽前时唱缓羇情。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283202,
      "title": "南至四首 四",
      "content": [
        "一任喧阗遶四邻，闲忙皆是自由身。",
        "人来客去还须议，莫遣他人作主人。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283203,
      "title": "莲峰前轩",
      "content": [
        "人间上寿若能添，只向人间也不嫌。",
        "看著四邻花竞发，高楼从此莫垂帘。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283204,
      "title": "步虚",
      "content": [
        "阿母亲教学步虚，三元长遣下蓬壶。",
        "云韶韵俗停瑶瑟，鸾鹤飞低拂宝炉。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283205,
      "title": "劒器",
      "content": [
        "楼下公孙昔擅场，空教女子爱军装。",
        "潼关一败吴儿喜，簇马骊山看御汤。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283206,
      "title": "乙丑人日",
      "content": [
        "自怪扶持七十身，归来又见故乡春。",
        "今朝人日逢人喜，不料偷生作老人。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283207,
      "title": "携仙箓九首 一",
      "content": [
        "岳北秋空渭北川，晴云渐薄薄如烟。",
        "坐来还见微风起，吹散残阳一片蝉。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283208,
      "title": "携仙箓九首 二",
      "content": [
        "一半晴空一半云，远笼仙掌日初曛。",
        "洞天有路不知处，绝顶异香难更闻。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283209,
      "title": "携仙箓九首 三",
      "content": [
        "决事还须更事酬，清谭妙理一时休。",
        "渔翁亦被机心误，眼暗汀边结钓钩。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283210,
      "title": "携仙箓九首 四",
      "content": [
        "迹不趋时分不侯，功名身外最悠悠。",
        "听君总画麒麟阁，还我闲眠舴艋舟。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283211,
      "title": "携仙箓九首 五",
      "content": [
        "仙凡路阻两难留，烟树人间一片秋。",
        "若道阴功能济活，且将方寸自焚修。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283212,
      "title": "携仙箓九首 六",
      "content": [
        "若有阴功救未然，玉皇品籍亦搜贤。",
        "应知谭笑还高谢，别就沧洲赞上仙。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283213,
      "title": "携仙箓九首 七",
      "content": [
        "英名何用苦搜奇，不朽才销一句诗。",
        "却赖风波阻三岛，老臣犹得恋明时。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283214,
      "title": "携仙箓九首 八",
      "content": [
        "剪取红云剩写诗，年年高会趂花时。",
        "水精楼阁分明见，只欠霞浆别着旗。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283215,
      "title": "携仙箓九首 九",
      "content": [
        "此生得作太平人，只向尘中便出尘。",
        "移取碧桃花万树，年年自乐故乡春。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283216,
      "title": "浪淘沙",
      "content": [
        "不必长漂玉洞花，曲中偏爱浪淘沙。",
        "黄河却胜天河水，万里萦纡入汉家。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 283217,
      "title": "赠日东鉴禅师",
      "content": [
        "故国无心度海潮，老禅方丈倚中条。",
        "夜深雨绝松堂静，一点飞萤照寂寥。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283218,
      "title": "暮春对柳二首 一",
      "content": [
        "萦愁惹恨奈杨花，闭户垂帘亦满家。",
        "恼得闲人作酒病，刚须又扑越溪茶。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283219,
      "title": "暮春对柳二首 二",
      "content": [
        "洞中犹说看桃花，轻絮狂飞自俗家。",
        "正是阶前开远信，小娥旋拂碾新茶。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283220,
      "title": "戊午三月晦二首 一",
      "content": [
        "随风逐浪剧蓬萍，圆首何曾解最灵。",
        "笔砚近来多自弃，不关妖气暗文星。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283221,
      "title": "戊午三月晦二首 二",
      "content": [
        "牛夸棋品无勍敌，谢占诗家作上流。",
        "岂似小敷春水涨，年年鸾鹤待仙舟。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283222,
      "title": "偶书五首 一",
      "content": [
        "情知了得未如僧，客处高楼莫强登。",
        "莺也解啼花也发，不关心事最堪憎。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283223,
      "title": "偶书五首 二",
      "content": [
        "自有池荷作扇摇，不关风动爱芭蕉。",
        "只怜直上抽红蘂，似我丹心向本朝。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283224,
      "title": "偶书五首 三",
      "content": [
        "曾看轻舟渡远津，无风著岸不经旬。",
        "只缘命蹇须知命，却是人争阻得人。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283225,
      "title": "偶书五首 四",
      "content": [
        "上谷何曾解有情，有情人自惜君行。",
        "证因池上今生愿，的的他生作化生。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283226,
      "title": "偶书五首 五",
      "content": [
        "新店南原后夜程，黄河风浪信难平。",
        "渡头杨柳知人意，为惹官船莫放行。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283227,
      "title": "喜山鹊初归三首 一",
      "content": [
        "翠衿红觜便知机，久避重罗稳处飞。",
        "只为从来偏护惜，窗前今贺主人归。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283228,
      "title": "喜山鹊初归三首 二",
      "content": [
        "山中只是惜珍禽，语不分明识尔心。",
        "若使解言天下事，燕台今筑几千金。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283229,
      "title": "喜山鹊初归三首 三",
      "content": [
        "阻他罗网到柴扉，不奈偷仓雀转肥。",
        "赖尔林塘添景趣，剩留山果引教归。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283230,
      "title": "虞乡北原",
      "content": [
        "泽北邨贫烟火狞，稚田冬旱倩牛耕。",
        "老人惆怅逢人诉，开尽黄花麦未金。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283231,
      "title": "洛中三首 一",
      "content": [
        "秋风团扇未惊心，笑看妆台落叶侵。",
        "绣鳯不教金缕暗，青楼何处有寒砧。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283232,
      "title": "洛中三首 二",
      "content": [
        "不用频嗟世路难，浮生各自系悲懽。",
        "风霜一夜添羇思，罗绮谁家待早寒。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283233,
      "title": "洛中三首 三",
      "content": [
        "燕巢空后谁相伴，鸳被缝来不忍薰。",
        "薄命敢辞长滴泪，倡家未必肯留君。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283234,
      "title": "寓笔",
      "content": [
        "年年镊鬓到花飘，依旧花繁鬓易凋。",
        "撩乱一塲人更恨，春风谁道胜轻飙。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283235,
      "title": "戏题试衫",
      "content": [
        "朝班尽说人宜紫，洞府应无鹤着绯。",
        "从此玉皇须破例，染霞裁赐地仙衣。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283236,
      "title": "汴柳半枯因悲柳中隐",
      "content": [
        "行人莫叹前朝树，已占河堤几百春。",
        "惆怅题诗柳中隐，柳衰犹在自无身。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283237,
      "title": "上方",
      "content": [
        "花落更同悲木落，莺声相续即蝉声。",
        "荣枯了得无多事，只是闲人漫系情。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283238,
      "title": "寄王赞学",
      "content": [
        "黄卷不关兼济业，青山自保老闲身。",
        "一行万里纤尘静，可要张仪更入秦。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283239,
      "title": "新节",
      "content": [
        "转悲新岁重于山，不似轻鸥肯复还。",
        "朱绂纵教金印换，青云未胜白头闲。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283240,
      "title": "自河西归山二首 一",
      "content": [
        "一水悠悠一叶危，往来长恨阻归期。",
        "乡关不是无华表，自为多惊独上迟。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283241,
      "title": "自河西归山二首 二",
      "content": [
        "水阔风惊去路危，孤舟欲上更迟迟。",
        "鹤群长扰三珠树，不借人间一只骑。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283242,
      "title": "王官二首 一",
      "content": [
        "风荷似醉和花舞，沙鸟无情伴客闲。",
        "总是此中皆有恨，更堪微雨半遮山。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283243,
      "title": "王官二首 二",
      "content": [
        "荷塘烟罩小斋虚，景物皆宜入画图。",
        "尽日无人只高卧，一双白鸟隔纱厨。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283244,
      "title": "贺翰林侍郎二首 一",
      "content": [
        "太白东归鹤背吟，镜湖空在酒船沈。",
        "今朝忽见银台事，早晚重征入翰林。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283245,
      "title": "贺翰林侍郎二首 二",
      "content": [
        "玉版征书洞里看，沈羲新拜侍郎官。",
        "文星喜气连台曜，圣主方知四海安。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283246,
      "title": "寄王十四舍人",
      "content": [
        "几年汶上约同游，拟为莲峰别置楼。",
        "今日凤皇池畔客，五千仞雪不回头。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283247,
      "title": "纶阁有感",
      "content": [
        "风涛曾阻化鳞来，谁料蓬瀛路却开。",
        "欲去迟迟还自笑，狂才应不是仙才。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283248,
      "title": "狂题十八首 一",
      "content": [
        "莫恨艰危日日多，时情其奈幸门何。",
        "貔貅睡稳蛟龙渴，犹把烧残朽铁磨。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283249,
      "title": "狂题十八首 二",
      "content": [
        "别鹤凄凉指法存，戴逵能耻近王门。",
        "世间第一风流事，借得王公玉枕痕。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283250,
      "title": "狂题十八首 三",
      "content": [
        "交疎自古戒言深，肝胆徒倾致铄金。",
        "不是史迁书与说，谁知孤负李陵心。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283251,
      "title": "狂题十八首 四",
      "content": [
        "南华落笔似荒唐，若肯经纶亦不狂。",
        "偶作客星侵帝座，却应虚薄是严光。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283252,
      "title": "狂题十八首 五",
      "content": [
        "不劳世路更相猜，忍到须休惜得材。",
        "几度懒乘风水便，抝船折舵恐难回。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283253,
      "title": "狂题十八首 六",
      "content": [
        "由来相爱只诗僧，怪石长松自得朋。",
        "却怕他生还识字，依前日下作孤灯。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283254,
      "title": "狂题十八首 七",
      "content": [
        "老禅乘仗莫过身，远岫孤云见亦频。",
        "应是佛边犹怕闹，信缘须作且闲人。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283255,
      "title": "狂题十八首 八",
      "content": [
        "止竟闲人不爱闲，只偷无事闭柴关。",
        "轰霆搅破蛟龙窟，也被狂风卷出山。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283256,
      "title": "狂题十八首 九",
      "content": [
        "地下修文著作郎，生前饥处倒空墙。",
        "何如神爽骑星去，犹自研几助玉皇。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283257,
      "title": "狂题十八首 十",
      "content": [
        "雨洗芭蕉叶上诗，独来凭槛晚晴时。",
        "故园虽恨风荷腻，新句闲题亦满池。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283258,
      "title": "狂题十八首 十一",
      "content": [
        "初时拄杖向邻村，渐到清明亦杜门。",
        "三十年来辞病表，今朝卧病感皇恩。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283259,
      "title": "狂题十八首 十二",
      "content": [
        "来时虽恨失青氊，自见芭蕉几十篇。",
        "应是阿刘还宿债，剩拚才思折供钱。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283260,
      "title": "狂题十八首 十三",
      "content": [
        "芭蕉丛畔碧婵娟，免更悠悠扰蜀川。",
        "应到去时题不尽，不劳分寄校书牋。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283261,
      "title": "狂题十八首 十四",
      "content": [
        "自伤衰病渐难平，永夜禅床雨滴声。",
        "闻道虎疮仍带镞，吼来和痛亦横行。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283262,
      "title": "狂题十八首 十五",
      "content": [
        "昨日流莺今日蝉，起来又是夕阳天。",
        "六龙飞辔长相窘，更忍乘危自着鞭。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283263,
      "title": "狂题十八首 十六",
      "content": [
        "有是有非还有虑，无心无迹亦无猜。",
        "不平便激风波险，莫向安时稔祸胎。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283264,
      "title": "狂题十八首 十七",
      "content": [
        "十年三署让官频，认得无才又索身。",
        "莫道太行同一路，大都安稳属闲人。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283265,
      "title": "狂题十八首 十八",
      "content": [
        "曾闻劫火到蓬壶，缩尽鼇头海亦枯。",
        "今日家山同此恨，人归未得鹤归无。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283266,
      "title": "游仙二首 一",
      "content": [
        "蛾眉新画觉婵娟，鬬走将花阿母边。",
        "仙曲教成慵不理，玉阶相簇打金钱。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283267,
      "title": "游仙二首 二",
      "content": [
        "刘郎相约事难谐，雨散云飞自此乖。",
        "月姊殷勤留不住，碧空遗下水精钗。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283268,
      "title": "漫书五首 一",
      "content": [
        "长拟求闲未得闲，又劳行役出秦关。",
        "逢人渐觉乡音异，却恨莺声似故山。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283269,
      "title": "漫书五首 二",
      "content": [
        "溪边随事有桑麻，尽日山程十数家。",
        "莫怪行人频怅望，杜鹃不是故乡花。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283270,
      "title": "漫书五首 三",
      "content": [
        "海上昔闻麋爱鹤，山中今日鹿憎龟。",
        "爱憎止竟须关分，莫把微才望所知。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283271,
      "title": "漫书五首 四",
      "content": [
        "世路快心无好事，恩门嘉话合书绅。",
        "神藏鬼伏能千变，亦胜忘机避要津。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283272,
      "title": "漫书五首 五",
      "content": [
        "四翁识势保安闲，须为生灵暂出山。",
        "一种老人能算度，磻溪心迹愧商颜。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283273,
      "title": "偶诗五首 一",
      "content": [
        "闲韵虽高不衒才，偶抛猨鸟乍归来。",
        "夕阳照个新红叶，似要题诗落砚台。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283274,
      "title": "偶诗五首 二",
      "content": [
        "芙蓉骚客空留怨，芍药诗家只寄情。",
        "谁似天才李山甫，牡丹属思亦纵横。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283275,
      "title": "偶诗五首 三",
      "content": [
        "贤豪出处尽沉吟，白日高悬只照心。",
        "一掬信陵坟上土，便如碣石累千金。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283276,
      "title": "偶诗五首 四",
      "content": [
        "声貌由来固绝伦，今朝共许占残春。",
        "当歌莫怪频垂泪，得地翻惭早失身。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283277,
      "title": "偶诗五首 五",
      "content": [
        "中宵茶鼎沸时惊，正是寒窗竹雪明。",
        "甘得寂寥能到老，一生心地亦应平。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283278,
      "title": "杂题二首 一",
      "content": [
        "先知左袒始同行，须待龙楼羽翼成。",
        "若使只凭三杰力，犹应汉鼎一毫轻。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283279,
      "title": "杂题二首 二",
      "content": [
        "鱼在枯池鸟在林，四时无奈雪霜侵。",
        "若教激劝由真宰，亦奖青松径寸心。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283280,
      "title": "光化踏青有感",
      "content": [
        "引得车回莫认恩，却成寂寞与谁论。",
        "到头不是君王意，羞插垂杨更傍门。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283281,
      "title": "丑年冬",
      "content": [
        "醉日昔闻都下酒，何如今喜折新茶。",
        "不堪病渴仍多虑，好向㴩湖便出家。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283282,
      "title": "白菊三首 一",
      "content": [
        "人间万恨已难平，栽得垂[杨]更系情。",
        "犹喜闰前霜未下，菊边依旧舞身轻。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283283,
      "title": "白菊三首 二",
      "content": [
        "莫惜西风又起来，犹能婀娜傍池台。",
        "不辞暂被霜寒挫，舞袖招香即却回。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283284,
      "title": "白菊三首 三",
      "content": [
        "为报繁霜且莫催，穷秋须到自低垂。",
        "横拖长袖招人别，只待春风却舞来。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283285,
      "title": "扇",
      "content": [
        "珍重逢秋莫弃捐，依依只仰故人怜。",
        "有时池上遮残日，承得霜林几个蝉。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283286,
      "title": "修史亭三首 一",
      "content": [
        "山前邻叟去纷纷，独强衰羸爱杜门。",
        "渐觉一家看冷落，地炉生火自温存。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283287,
      "title": "修史亭三首 二",
      "content": [
        "甘心七十且酣歌，自算平生幸已多。",
        "不似香山白居士，晚将心地著禅魔。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283288,
      "title": "修史亭三首 三",
      "content": [
        "乌纱巾上是青天，检束酬知四十年。",
        "谁料平生臂鹰手，挑灯自送佛前钱。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283289,
      "title": "力疾山下吴邨看杏花十九首 一",
      "content": [
        "春来渐觉一川明，马上繁花作阵迎。",
        "掉臂只将诗酒敌，不劳金鼓助横行。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283290,
      "title": "力疾山下吴邨看杏花十九首 二",
      "content": [
        "阊阖曾排捧御炉，犹看晓月认金铺。",
        "羸形不画凌烟阁，只为微才激壮图。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283291,
      "title": "力疾山下吴邨看杏花十九首 三",
      "content": [
        "镜留雪鬓暖消无，春到棃花日又晡。",
        "移取扶桑堦下种，年年看长碍金乌。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283292,
      "title": "力疾山下吴邨看杏花十九首 四",
      "content": [
        "折来未尽不须休，年少争来莫与留。",
        "更愿狂风知我意，一时吹向海西头。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283293,
      "title": "力疾山下吴邨看杏花十九首 五",
      "content": [
        "才情百巧鬬风光，却笑雕花刻叶忙。",
        "熨帖新巾来与裹，犹看腾踏少年场。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283294,
      "title": "力疾山下吴邨看杏花十九首 六",
      "content": [
        "浮世荣枯总不知，且忧花阵被风欺。",
        "侬家自有麒麟阁，第一功名只赏诗。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    }
  ],
