      }
    },
    {
      "id": 156620,
      "title": "葬无主墓碑",
      "content": [
        "路逢一石碑，亭亭傲风雨。",
        "停骖仿佛看，云是无主墓。",
        "末书戊申岁，屈指九十秋。",
        "是时龙渡江，甲子恍一周。",
        "借问葬者谁，承平百世祖。",
        "亦有周余民，战骨委黄土。",
        "太祖下江南，誓不戮一人。",
        "神孙再立国，天以报至仁。",
        "大河流血丹，屠毒谁之罪。",
        "潼关忽不守，皇皇依汴蔡。",
        "螳螂知捕蝉，不知黄雀来。",
        "今古有兴废，重为生人哀。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 156621,
      "title": "邳州哭母小祥",
      "content": [
        "我有母圣善，鸾飞星一周。",
        "去年哭海上，今年哭邳州。",
        "遥想仲季间，木主布筵几。",
        "我躬已不阅，祀事付支子。",
        "使我早沦落，如此终天何。",
        "及今毕亲丧，于分亦已多。",
        "母尝教我忠，我不违母志。",
        "及泉会相见，鬼神共欢喜。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 156622,
      "title": "哭母大祥",
      "content": [
        "前年惠州哭母歛，去年邳州哭母期。",
        "今年飘泊在何处，燕山狱里菊花时。",
        "哀哀黄花如昨日，两度星周俄箭疾。",
        "人间送死一大事，生儿富贵不得力。",
        "祇今谁人守坟墓，零落瘴乡一堆土。",
        "大儿狼狈勿复道，下有二儿并二女。",
        "一儿一女亦在燕，佛庐设供捐金钱。",
        "一儿一女家下祭，病脱麻衣日晏眠。",
        "夜来好梦归故国，忽然海上见颜色。",
        "一声鸡叫泪满床，化为清血衣裳湿。",
        "当年嫠纬意谓何，亲曾抚我夜枕戈。",
        "古来全忠不全孝，世事至此甘滂沱。",
        "夫人开国分齐魏，生荣死哀送天地。",
        "悠悠国破与家亡，平生无憾惟此事。",
        "二郎已作门户谋，江南葬母麦满舟。",
        "不知何日归兄骨，狐死犹应正首丘。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 156623,
      "title": "先太师忌日",
      "content": [
        "太师忌汗漫，二纪似跳丸。",
        "弟妹俱成立，家乡忍破残。",
        "衣冠晨月暗，坟墓夜风寒。",
        "万里逢先忌，无言把泪弹。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156624,
      "title": "己卯十月一日至燕越五日罹狴犴有感而赋  其一",
      "content": [
        "直弦不似曲如钩，自古圣贤多被囚。",
        "命有死时名不死，身无忧处道还忧。",
        "可怜杜宇空流血，惟愿严颜便斫头。",
        "结束长编犹在此，灶间婢子见人羞。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 156625,
      "title": "己卯十月一日至燕越五日罹狴犴有感而赋  其二",
      "content": [
        "落落南冠自结缨，桁杨卧起影纵横。",
        "坐移白石知何世，梦断青灯问几更。",
        "国破家亡双泪暗，天荒地老一身轻。",
        "黄粱得失俱成幻，五十年前元未生。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 156626,
      "title": "己卯十月一日至燕越五日罹狴犴有感而赋  其三",
      "content": [
        "心期耿耿浮云上，身事悠悠落日西。",
        "千古兴亡何限错，百年生死本来齐。",
        "沙边莫待哀黄鹄，雪里何须问牧羝。",
        "此处曾埋双宝剑，虹光夜指楚天低。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 156627,
      "title": "己卯十月一日至燕越五日罹狴犴有感而赋  其四",
      "content": [
        "寥阳殿上步黄金，一落颠崖地狱深。",
        "苏武窖中偏喜卧，刘琨囚里不妨吟。",
        "生前已见夜叉面，死去只因菩萨心。",
        "万里风沙知己尽，谁人会得广陵音。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 156628,
      "title": "己卯十月一日至燕越五日罹狴犴有感而赋  其五",
      "content": [
        "亦知戛戛楚囚难，无柰天生一寸丹。",
        "铁马行鏖南地热，赭衣坐拥北庭寒。",
        "朝餐淡薄神还爽，夜睡崎岖梦自安。",
        "亡国大夫谁为传，祇饶野史与人看。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 156629,
      "title": "己卯十月一日至燕越五日罹狴犴有感而赋  其六",
      "content": [
        "风雪重门老楚囚，梦回长夜意悠悠。",
        "熊鱼自古无双得，鹄雀如何可共谋。",
        "万里山河真堕甑，一家妻子枉填沟。",
        "儿时爱读忠臣传，不谓身当百六秋。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 156630,
      "title": "己卯十月一日至燕越五日罹狴犴有感而赋  其七",
      "content": [
        "听著啼鹃泪满襟，国亡家破见忠臣。",
        "关河历落三生梦，风雪飘零万死身。",
        "丞相岂能堪狱吏，故侯安得作园人。",
        "神农虞夏吾谁适，回首西山继绝尘。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 156631,
      "title": "己卯十月一日至燕越五日罹狴犴有感而赋  其八",
      "content": [
        "风前泣灯影，日下泣霜花。",
        "钟信忽然动，屋阴俄又斜。",
        "闷中聊度岁，梦里尚还家。",
        "地狱何须问，人间见夜叉。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156632,
      "title": "己卯十月一日至燕越五日罹狴犴有感而赋  其九",
      "content": [
        "风霜阴忽忽，天地澹悠悠。",
        "我自操吴语，谁来问楚囚。",
        "寂中惟灭想，达处尽忘忧。",
        "手有韦编在，朝闻夕死休。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156633,
      "title": "己卯十月一日至燕越五日罹狴犴有感而赋  其一○",
      "content": [
        "环堵尘如屋，累然一故吾。",
        "解衣烘稚虱，匀鏁救残须。",
        "坐处心如忘，吟余眼已枯。",
        "不应留滞久，何日裹籧篨。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156634,
      "title": "己卯十月一日至燕越五日罹狴犴有感而赋  其一一",
      "content": [
        "浩劫风尘暗，衣冠痛百罹。",
        "静传方外学，晴写狱中诗。",
        "烈士惟名殉，真人与物违。",
        "世间忙会错，认取去来时。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156635,
      "title": "己卯十月一日至燕越五日罹狴犴有感而赋  其一二",
      "content": [
        "俨然楚君子，一日造王庭。",
        "议论探坚白，精神入汗青。",
        "无书求出狱，有舌到临刑。",
        "宋故忠臣墓，真吾五字铭。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156636,
      "title": "己卯十月一日至燕越五日罹狴犴有感而赋  其一三",
      "content": [
        "两月缧囚里，一年忧患余。",
        "疏因随事直，忠故有时愚。",
        "道在身何拙，心安体自舒。",
        "近来都勘破，人世只蘧庐。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156637,
      "title": "己卯十月一日至燕越五日罹狴犴有感而赋  其一四",
      "content": [
        "衮衣坐缧絏，世事亦堪哀。",
        "枕外亲炊黍，炉边细画灰。",
        "无人泪垂血，何地骨生苔。",
        "风雪江南路，梦中行探梅。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156638,
      "title": "己卯十月一日至燕越五日罹狴犴有感而赋  其一五",
      "content": [
        "我自怜人丑，人方笑我愚。",
        "身生豫让癞，背发范增疽。",
        "已愧功臣传，犹堪烈士书。",
        "衣冠事至此，命也欲何如。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156639,
      "title": "己卯十月一日至燕越五日罹狴犴有感而赋  其一六",
      "content": [
        "久矣忘荣辱，今兹一死生。",
        "理明心自裕，神定气还清。",
        "欲了男儿事，几无妻子情。",
        "出门天宇阔，一笑暮云横。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    }
  ],
