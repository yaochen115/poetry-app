{
  "data": [
    {
      "id": 255273,
      "title": "相和歌辞 江南曲",
      "content": [
        "长乐花枝雨点消，江城日暮好相邀。",
        "春楼不闭葳蕤锁，绿水回通宛转桥。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 255922,
      "title": "杂曲歌辞 少年行",
      "content": [
        "千点斓斒喷玉骢，青丝结尾绣缠騣。",
        "鸣鞭晚出章台路，叶叶春依杨柳风。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 258991,
      "title": "令狐员外宅宴寄中丞",
      "content": [
        "寒色凝罗幕，同人清夜期。",
        "玉杯留醉处，银烛送归时。",
        "独坐隔千里，空吟对雪诗。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 258992,
      "title": "禇主簿宅会毕庶子钱员外郎使君",
      "content": [
        "开瓮腊酒熟，主人心赏同。",
        "斜阳疎竹上，残雪乱天中。",
        "更喜宣城印，朝廷与谢公。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 258993,
      "title": "送李明府赴滑州",
      "content": [
        "渭城寒食罢，送客归远道。",
        "乌帽背斜晖，青骊踏春草。",
        "酒醒孤烛夜，衣冷千山早。",
        "去事沈尚书，应怜词赋好。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 258994,
      "title": "送李司直赴江西使幕",
      "content": [
        "敛版辞汉廷，进帆归楚幕。",
        "三江城上转，九里人家泊。",
        "好酒近宜城，能诗谢康乐。",
        "雨晴西山树，日出南昌郭。",
        "竹露点衣巾，湖烟湿扃钥。",
        "主人苍玉佩，后骑黄金络。",
        "高视领八州，相期同一鹗。",
        "行当报知己，从此飞寥廓。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 258995,
      "title": "祭岳回重赠孟都督",
      "content": [
        "封作天齐王，清祠太山下。",
        "鲁公秋赛毕，晓日回高驾。",
        "从骑尽幽幷，同人皆沈谢。",
        "自矜文武足，一醉寒溪夜。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 258996,
      "title": "送南少府归寿春",
      "content": [
        "人言寿春远，此去先秋到。",
        "孤客小翼舟，诸生高翅帽。",
        "淮风生竹簟，楚雨移茶灶。",
        "若在八公山，题诗一相报。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 258997,
      "title": "赠别崔司直赴江东兼简常州独孤使君",
      "content": [
        "爱君青袍色，芳草能相似。",
        "官重法家流，名高墨曹吏。",
        "春衣淮上宿，美酒江边醉。",
        "楚酪沃雕胡，湘羹糁香饵。",
        "前朝山水国，旧日风流地。",
        "苏山逐青骢，江家驱白鼻。",
        "右军尚少年，三领东方骑。",
        "亦过小丹阳，应知百城贵。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 258998,
      "title": "经月岩山",
      "content": [
        "驱车过闽越，路出饶阳西。",
        "仙山翠如画，簇簇生虹蜺。",
        "群峰若侍从，众阜如婴提。",
        "岩峦互吞吐，岭岫相追携。",
        "中有月轮满，皎洁如圆珪。",
        "玉皇恣游览，到此神应迷。",
        "嫦娥曳霞帔，引我同攀跻。",
        "腾腾上天半，玉镜悬飞梯。",
        "瑶池何悄悄，鸾鹤烟中栖。",
        "回头望尘事，露下寒凄凄。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 258999,
      "title": "送客之江宁",
      "content": [
        "春流送客不应赊，南入徐州见柳花。",
        "朱雀桥边看淮水，乌衣巷里问王家。",
        "千闾万井无多事，辟户开门向山翠。",
        "楚云朝下石头城，江燕双飞瓦棺寺。",
        "吴士风流甚可亲，相逢嘉赏日应新。",
        "从来此地夸羊酪，自有莼羹定却人。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 259000,
      "title": "送山阴姚丞携妓之任兼寄山阴苏少府",
      "content": [
        "东风香草路，南客心容与。",
        "白皙吴王孙，青蛾柳家女。",
        "都门数骑出，河口片帆举。",
        "夜簟眠橘洲，春衫傍枫屿。",
        "山阴政简甚从容，到罢唯求物外踪。",
        "落日花边剡溪水，晴烟竹里会稽峰。",
        "才子风流苏伯玉，同官晓暮应相逐。",
        "加餐共爱鲈鱼肥，醒酒仍怜甘蔗熟。",
        "知君炼思本清新，季子如今德有邻。",
        "他日如寻始宁墅，题诗早晚寄西人。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 259001,
      "title": "和高平朱参军思归作",
      "content": [
        "髯参军，髯参军。",
        "身为北州吏，心寄东山云。",
        "坐见凄凄芳草绿，遥思往日晴江曲。",
        "刺船频向剡中回，捧被曾过越人宿。",
        "花里莺啼白日高，春楼把酒送车螯。",
        "狂歌好爱陶彭泽，佳句唯称谢法曹。",
        "平生乐事多如此，忍为浮名隔千里。",
        "一雁南飞动客心，思归何待秋风起。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 259002,
      "title": "赠别成明府赴劒南",
      "content": [
        "朝为三室印，晚为三蜀人。",
        "遥知下车日，正及巴山春。",
        "县道橘花里，驿流江水滨。",
        "公门輙无事，赏地能相亲。",
        "解衣初醉绿芳夕，应采蹲鸱荐佳客。",
        "霁水远暎西川时，闲望碧鸡飞古祠。",
        "爱君乐事佳兴发，天外铜梁多梦思。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 259003,
      "title": "送孙泼赴云中",
      "content": [
        "黄骢少年舞双戟，目视旁人皆辟易。",
        "百战能夸陇上儿，一身复作云中客。",
        "寒风动地气苍茫，横吹先悲出塞长。",
        "敲石军中传夜火，斧冰河畔汲朝浆。",
        "前锋直指阴山外，虏骑纷纷胆应碎。",
        "匈奴破尽人看归，金印酬功如斗大。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 259004,
      "title": "送客还江东",
      "content": [
        "还家不落春风后，数日应沽越人酒。",
        "池畔花深鬬鸭栏，桥边雨洗藏鸦柳。",
        "遥怜内舍著新衣，复向邻家醉落晖。",
        "把手闲歌香橘下，空山一望鹧鸪飞。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 259005,
      "title": "送夏侯侍郎",
      "content": [
        "元戎车右早飞声，御史府中新正名。",
        "翰墨已齐钟大理，风流好继谢宣城。",
        "从军晓别龙骧幕，六骑先驱嘶近郭。",
        "前路应留白玉台，行人輙美黄金络。",
        "使君下马爱瀛洲，简贵将求物外游。",
        "听讼不闻乌布帐，迎宾暂著紫绨裘。",
        "公庭日夕罗山翠，功遂心闲无一事。",
        "移书或问岛边人，立仗时呼铃下吏。",
        "事业初传小夏侯，中年劒笏在西州。",
        "浮云飞鸟两相忘，他日依依城上楼。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 259006,
      "title": "送李湜下第归卫州便游河北",
      "content": [
        "莫嗟太常屈，便入苏门啸。",
        "里在应未迟，勿作我身料。",
        "轻云日下不成阴，出对流芳搅别心。",
        "万雉城东春水阔，千人乡北晚花深。",
        "旧竹青青常绕宅，到时疎旷应自适。",
        "佳期纵得上宫游，旅食还为北邙客。",
        "路出司州胜景长，西山翠色带清漳。",
        "仙人矶近茱萸涧，铜雀台临野马冈。",
        "屡道主人多爱士，何辞策马千余里。",
        "高谭魏国访先生，修刺平原过内史。",
        "一举青云在早秋，恐君从此便淹留。",
        "有钱莫向河间用，载笔须来阙下游。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 259007,
      "title": "张山人草堂会王方士",
      "content": [
        "屿花晚，山日长，蕙带麻襦食草堂。",
        "一片水光飞入户，千竿竹影乱登墙。",
        "园梅熟，家酝香。",
        "新湿头巾不复𥮾，相看醉倒卧藜床。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 259008,
      "title": "送蓨县刘主簿楚",
      "content": [
        "起家得事平原侯，晚出都门辞旧游。",
        "草色连绵几千里，青骊躞蹀路旁子。",
        "花深近县宿河阳，竹暎春舟渡淇水。",
        "邺下淹留佳赏新，群公旧日心相亲。",
        "金盘晓鲙朱衣鲋，玉簟霄迎翠羽人。",
        "王程书使前期促，他日应知举鞭速。",
        "寒水浮瓜五月时，把君衣袖长河曲。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 259009,
      "title": "题玉山观禅师兰若",
      "content": [
        "玉山宴坐移年月，锡杖承恩诣丹阙。",
        "先朝亲与会龙华，紫禁鸣钟白日斜。",
        "宫女焚香把经卷，天人就席礼袈裟。",
        "禅床久卧虎溪水，兰若初开凤城里。",
        "不出嚣尘见远公，道成何必青莲宫。",
        "朝持药钵千家近，暮倚绳床一室空。",
        "掖垣挥翰君称美，远客陪游问真理。",
        "薄宦深知误此心，回心愿学雷居士。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 259010,
      "title": "赠别上元主簿张著",
      "content": [
        "上书一见平津侯，劒笏斜齐秣陵尉。",
        "朝垂绶带迎远客，暮锁印囊飞上吏。",
        "长乐花深万井时，同官无事有归期。",
        "回船对酒三生渚，系马焚香五愿祠。",
        "日日澄江带山翠，绿芳都在经过地。",
        "行人看射领军堂，游女题诗光宅寺。",
        "风流才调爱君偏，此别相逢定几年。",
        "惆怅浮云迷远道，张侯楼上月娟娟。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 259011,
      "title": "别泛水县尉",
      "content": [
        "未央宫殿金开钥，诏引贤良卷珠箔。",
        "花间赐食近丹墀，烟里挥毫对青阁。",
        "万年枝影转斜光，三道先成君激昂。",
        "谷水直言身不顾，郄诜高第转名香。",
        "绿槐阴阴出关道，上有蝉声下秋草。",
        "奴子平头骏马肥，少年白皙登王畿。",
        "五侯客舍偏留宿，一县人家争看归。",
        "南向千峰北临水，佳期赏地应穷此。",
        "赋诗或送郑行人，举酒常陪魏公子。",
        "自怜寂寞会君稀，犹著前时博士衣。",
        "我欲低眉问知己，若将无用废东归。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 259012,
      "title": "别李明府",
      "content": [
        "宠光五世要青组，出入珠宫引箫鼓。",
        "醉舞雄王玳瑁床，娇嘶骏马珊瑚柱。",
        "胡儿夹鼓越婢随，行捧玉盘尝荔枝。",
        "罗山道士请人送，林邑使臣调象骑。",
        "爱君一身游上国，阙下名公如旧识。",
        "万里初怀印绶归，湘江过尽岭花飞。",
        "五侯焦石烹江笋，千户沈香染客衣。",
        "别后想君难可见，苍梧云里空山县。",
        "汗苑芳菲入夏阑，待君障日蒲葵扇。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 259013,
      "title": "送中兄典邵州",
      "content": [
        "官骑连西向楚云，朱轩出饯昼纷纷。",
        "百城兼领安南国，双笔遥挥王左君。",
        "一路诸侯争馆谷，洪池高会荆台曲。",
        "玉颜送酒铜[鞮]歌，金管留人石头宿。",
        "北雁初回江燕飞，南湖春暖著春衣。",
        "湘君祠对空山掩，渔父焚香日暮归。",
        "百事无留到官后，重门寂寂垂高柳。",
        "零陵过赠石香溪，洞口人来饮醇酒。",
        "登楼暮结邵阳情，万里苍波烟霭生。",
        "他日新诗应见报，还如宣远在安城。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 259014,
      "title": "送万巨",
      "content": [
        "汉相见王陵，扬州事张禹。",
        "风帆木兰檝，水国莲花府。",
        "百丈清江十月天，寒城鼓角晓钟前。",
        "金炉促膝诸曹吏，玉管繁华美少年。",
        "有时过向长干地，远对湖光近山翠。",
        "好逢南苑看人归，也向西池留客醉。",
        "高柳垂烟橘带霜，朝游石渚暮横塘。",
        "红牋色夺风流座，白苎词倾翰墨场。",
        "夫子前年入朝后，高名籍籍时贤口。",
        "共怜诗兴转清新，继远家声在此身。",
        "屈指待为青琐客，回头莫羡白亭人。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 259015,
      "title": "送巴州杨使君",
      "content": [
        "白云县北千山口，青岁欲开残雪后。",
        "前驱锦带鱼皮鞮，侧佩金璋虎头绶。",
        "南郑侯家醉落晖，东关陌上著鞭归。",
        "愁看野马随官骑，笑取秦人带客旗。",
        "使者下车忧疾苦，豪吏销声出公府。",
        "万里歌钟相庆时，巴童声节渝儿舞。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 259016,
      "title": "送王侍御赴江西兼寄李袁州",
      "content": [
        "中朝理章服，南国随旌旆。",
        "腊酒湘城隅，春衣楚江外。",
        "垂帘白角簟，下筯鲈鱼鲙。",
        "雄笔佐名公，虚舟应时辈。",
        "按俗承流几路清，平明山霭春江云。",
        "湓城诗赠鱼司马，汝水人逢王右军。",
        "绿苹白芷遥相引，孤兴幽寻知不近。",
        "井上铜人行见无，湖中石燕飞应尽。",
        "礼门前直事仙郎，腰垂青绶领咸阳。",
        "花间五马迎君日，雨霁烟开玉女冈。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 259017,
      "title": "寄雍丘窦明府",
      "content": [
        "少年结绶骋金羁，许下如看琼树枝。",
        "入里亲过朗陵伯，出门高视颍川儿。",
        "西游太府东乘传，泗上诸侯谁不羡。",
        "时辈宁将白笔期，高流𥩟向丹霄见。",
        "何事飜飞不及群，虎班突骑来纷纷。",
        "吴江垂钓楚山醉，身寄沧波心白云。",
        "中岁胡尘静如扫，一官又罢行将老。",
        "薛公荐士得君初，囗领黄金千室余。",
        "机尽独亲沙上鸟，家贫唯向釜中鱼。",
        "囗囗囗囗囗囗囗，囗出重门烟树里。",
        "感物吟诗对暮天，怀人倚杖临秋水。",
        "别离几日问前期，鸣雁亭边人去时。",
        "独坐不堪朝与夕，高风萧索乱蝉悲。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 259018,
      "title": "赠衮州孟都督",
      "content": [
        "少年亲事冠军侯，中岁仍迁北衮州。",
        "露冕宁夸汉车服，下帷常讨鲁春秋。",
        "后斋草色连高阁，车简人稀独行乐。",
        "闲心近掩陶使君，诗兴遥齐谢康乐。",
        "远山重叠水逶迤，落日东城闲望时。",
        "不见双亲办丰膳，能留五马尽佳期。",
        "北场争转黄金勒，爱客华亭赏秋色。",
        "卷帘满地铺氍毹，吹角鸣弦开玉壶。",
        "愿学平原十日饮，此时不忍歌骊驹。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 259019,
      "title": "别孟都督",
      "content": [
        "平芜霁色寒城下，美酒百壶争劝把。",
        "连呼宝劒锐头儿，少驻金羁大头马。",
        "一饮留欢分有余，寸心怀思复何如。",
        "他时相忆若相问，青琐门前开素书。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 259020,
      "title": "送别郑明府",
      "content": [
        "长头大鼻鬓如雪，早岁连兵劒锋折。",
        "千金尽去无斗储，双袖破来空百结。",
        "独恋郊扉已十春，高阳酒徒连此身。",
        "路傍谁识郑公子，谷口应知汉逸人。",
        "儿女相悲探井臼，前功岂在他人后。",
        "劝君不得学渊明，且策驴车辞五柳。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 259021,
      "title": "赠别王侍御赴上都",
      "content": [
        "翩翩马上郎，执简佩银章。",
        "西向洛阳归鄠杜，回头结念莲花府。",
        "朝辞芳草万岁街，暮宿春山一泉坞。",
        "青青树色傍行衣，乳燕流莺相间飞。",
        "远过三峰临八水，幽寻佳赏偏如此。",
        "残花片片细柳风，落日疎钟小槐雨。",
        "相思掩泣复何如，公子门前人渐疎。",
        "幸有心期当小暑，葛衣纱帽望回车。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 259022,
      "title": "赠别太常李博士兼寄两省旧游",
      "content": [
        "两年戴武弁，趋侍明光殿。",
        "一朝簪惠文，客事信陵君。",
        "简异当朝执，香非寓直熏。",
        "差肩何记室，携手李将军。",
        "玉镫初回酸枣馆，金钿正舞石榴裙。",
        "忽惊万事随流水，不见双旌逐塞云。",
        "感旧抚心多寂寂，与君相遇头初白。",
        "暂夸五首军中诗，还忆万年枝下客。",
        "昨日留欢今送归，空披秋水暎斜晖。",
        "闲吟佳句对孤鹤，惆怅寒霜落叶稀。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 259023,
      "title": "寄哥舒仆射",
      "content": [
        "万里长城家，一生唯报国。",
        "腰垂紫文绶，手控黄金勒。",
        "高视黑头翁，遥吞白骑贼。",
        "先麾牙门将，转鬬黄河北。",
        "帐下亲兵皆少年，锦衣承日绣行缠。",
        "辘轳宝劒初出鞘，宛转角弓初上弦。",
        "步人抽箭大如笛，前把两矛后双戟。",
        "左盘右射红尘中，鹘入鸦群有谁敌。",
        "杀将破军白日余，回旃舞旆北风初。",
        "郡公楯鼻好磨墨，走马为君飞羽书。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 259024,
      "title": "赠别华阴道士",
      "content": [
        "紫府先生旧同学，腰垂彤管贮灵药。",
        "耻论方士小还丹，好饮仙人太玄酪。",
        "芙蓉山顶玉池西，一室平临万仞溪。",
        "昼洒瑶台五云湿，夜行金烛七星齐。",
        "回身暂下青冥里，方外相寻有知己。",
        "卖鲊市中何许人，钓鱼坐上谁家子。",
        "青青百草云台春，烟驾霓衣白角巾。",
        "露叶独归仙掌去，回风片雨谢时人。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 259025,
      "title": "送崔秀才赴上元兼省叔父",
      "content": [
        "寒塘敛暮雪，腊鼓迎春早。",
        "匹马五城人，重裘千里道。",
        "淮山轻露湿，江树狂风扫。",
        "楚县久酝醲，扬州百花好。",
        "练湖东望接云阳，女市西游入建康。",
        "行乐远夸红布旆，风流近赌紫香囊。",
        "诗家行辈如君少，极目苦心怀谢朓。",
        "烟开日上板桥南，吴岫青青出林表。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 259026,
      "title": "赠别韦兵曹归池州",
      "content": [
        "南陵八月天，暮色远峰前。",
        "楚竹青阳路，吴江赤马船。",
        "籝金诸客贵，佩玉主人贤。",
        "终日应相逐，归期定几年。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 259027,
      "title": "寄武陵李少府",
      "content": [
        "小县春山口，公孙吏隐时。",
        "楚歌催晚醉，蛮语入新诗。",
        "桂水遥相忆，花源暗有期。",
        "郢门千里外，莫怪尺书迟。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 259028,
      "title": "赠张建",
      "content": [
        "结客平陵下，当年倚侠游。",
        "传看辘轳剑，醉脱骦骕裘。",
        "翠羽双鬟妾，珠帘百尺楼。",
        "春风坐相待，晚日莫淹留。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 259029,
      "title": "送监军李判官",
      "content": [
        "上客佩双剑，东城喜再游。",
        "旧从张博望，新事郑长秋。",
        "踏水回金勒，看风试锦裘。",
        "知君不久住，汉将扫旄头。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 259030,
      "title": "送客归广平",
      "content": [
        "家在赵邯郸，归心輙自欢。",
        "晚杯狐腋暖，春雪马毛寒。",
        "孟月途中破，轻冰水上残。",
        "到时杨柳色，奈向故园看。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 259031,
      "title": "送张儋水路归北海",
      "content": [
        "千里东归客，孤心忆旧游。",
        "片帆依白水，高枕卧青州。",
        "柏寝寒芜变，梧台宿雨收。",
        "知君心兴远，每上海边楼。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 259032,
      "title": "送故人归鲁",
      "content": [
        "鲁客多归兴，居人怅别情。",
        "雨余衫袖冷，风急马蹄轻。",
        "秋草灵光殿，寒云曲阜城。",
        "知君拜亲后，少妇下机迎。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 259033,
      "title": "送故人归蜀",
      "content": [
        "一骑西南远，翩翩入剑门。",
        "客衣筒布润，山舍荔枝繁。",
        "古庙祠金马，春江带白鼋。",
        "自应成旅逸，爱客有王孙。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 259034,
      "title": "酬程延秋夜即事见赠",
      "content": [
        "长簟迎风早，空城澹月华。",
        "星河秋一雁，砧杵夜千家。",
        "节候看应晚，心期卧亦赊。",
        "向来吟秀句，不觉已鸣鸦。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 259035,
      "title": "送郭赞府归淮南",
      "content": [
        "骏马淮南客，归时引望新。",
        "江声六合暮，楚色万家春。",
        "白苎歌西曲，黄苞寄北人。",
        "不知心赏后，早晚见行尘。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 259036,
      "title": "题龙兴寺澹师房",
      "content": [
        "双林彼上人，诗兴转相亲。",
        "竹里经声晚，门前山色春。",
        "卷帘苔点净，下筯药苗新。",
        "记取无生理，归来问此身。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 259037,
      "title": "送客游江南",
      "content": [
        "南使孤帆远，东风任意吹。",
        "楚云殊不断，江鸟暂相随。",
        "月净鸳鸯水，春生豆蔻枝。",
        "赏称佳丽地，君去莫应知。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 259038,
      "title": "送高员外赴淄青使幕",
      "content": [
        "远水流春色，回风送落晖。",
        "人趋双节近，马递百花归。",
        "山驿尝官酒，关城度客衣。",
        "从来赤管笔，提向幕中稀。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 259039,
      "title": "寻胡处士不遇",
      "content": [
        "到来心自足，不见亦相亲。",
        "说法思居士，忘机忆丈人。",
        "微风吹药案，晴日照茶巾。",
        "幽兴殊未尽，东城飞暮尘。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 259040,
      "title": "赠张道者",
      "content": [
        "采药三山罢，乘风五日归。",
        "翦荷成旧屋，剉蘗染新衣。",
        "玉粒指应久，丹砂验不微。",
        "坐看青节引，要与白云飞。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 259041,
      "title": "题苏许公林亭",
      "content": [
        "平津东阁在，别是竹林期。",
        "万叶秋声里，千家落照时。",
        "门随深巷静，窗过远钟迟。",
        "客舍苔生处，依依又赋诗。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 259042,
      "title": "送元诜还江东",
      "content": [
        "过江秋色在，诗兴与归心。",
        "客路随枫岸，人家扫橘林。",
        "潮声当昼起，山翠近南深。",
        "几日华阳洞，寒花引独寻。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 259043,
      "title": "送客游江南",
      "content": [
        "桂水随去远，赏心知有余。",
        "衣香楚山橘，手鲙湘波鱼。",
        "芳芷不共把，浮云怅离居。",
        "遥想汩罗上，吊屈秋风初。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 259044,
      "title": "送海州姚别驾",
      "content": [
        "少年为长史，东去事诸侯。",
        "坐觉千闾静，闲随五马游。",
        "行人楚国道，暮雪郁林州。",
        "他日知相忆，春风海上楼。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 259045,
      "title": "送夏侯审",
      "content": [
        "谢公邻里在，日夕问佳期。",
        "春水人归后，东田花尽时。",
        "下楼闲待月，行乐笑题诗。",
        "他日吴中路，千山入梦思。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 259046,
      "title": "送赵评事赴洪州使幕",
      "content": [
        "孤舟行远近，一路过湘东。",
        "官属张廷尉，身随杜幼公。",
        "山河映湘竹，水驿带青枫。",
        "万里思君处，秋江夜雨中。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 259047,
      "title": "送李侍御赴徐州行营",
      "content": [
        "少年兼柱史，东至旧徐州。",
        "远属平津阁，前驱博望侯。",
        "向营淮水满，吹角楚天秋。",
        "客梦依依处，寒山对白楼。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 259048,
      "title": "送李秀才归江南",
      "content": [
        "过淮芳草歇，千里又东归。",
        "野水吴山出，家林越鸟飞。",
        "荷香随去棹，梅雨点行衣。",
        "无数沧江客，如君达者稀。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 259049,
      "title": "题僧房",
      "content": [
        "披衣闻客至，关锁此时开。",
        "鸣罄夕阳尽，卷帘秋色来。",
        "名香连竹径，清梵出花台。",
        "身在心无住，他方到几回。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 259050,
      "title": "送寿州陈录事",
      "content": [
        "寿阳南渡口，敛笏见诸侯。",
        "五两楚云暮，千家淮水秋。",
        "开帘对芳草，送客上春洲。",
        "请问山中桂，王孙几度游。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 259051,
      "title": "送赵陆司兵归使幕",
      "content": [
        "客路青芜遍，关城白日低。",
        "身趋双节近，名共五云齐。",
        "远水公田上，春山郡舍西。",
        "无因得携手，东望转凄凄。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 259052,
      "title": "送蒋员外端公归淮南",
      "content": [
        "淮南芳草色，日夕引归船。",
        "御史王元贶，郎官顾彦先。",
        "光风千日暖，寒食百花燃。",
        "惆怅佳期近，澄江与暮天。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 259053,
      "title": "题慈仁寺竹院",
      "content": [
        "千峰对古寺，何异到西林。",
        "幽罄蝉声下，闲窗竹翠阴。",
        "诗人谢客兴，法侣远公心。",
        "寂寂炉烟里，香花欲暮深。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 259054,
      "title": "赠郓州马使君",
      "content": [
        "东方千马骑，出望使君时。",
        "暮雪行看尽，春城到莫迟。",
        "路人趋墨帻，官柳度青丝。",
        "他日铃斋内，知君亦赋诗。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 259055,
      "title": "送张丞归使幕",
      "content": [
        "独受主恩归，当朝似者稀。",
        "玉壶分御酒，金殿赐春衣。",
        "拂席流莺醉，鸣鞭骏马肥。",
        "满台簪白笔，捧手恋清晖。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 259056,
      "title": "赠长洲何主簿",
      "content": [
        "挂席逐归流，依依望虎丘。",
        "残春过楚县，夜雨宿吴洲。",
        "野寺吟诗入，溪桥折笋游。",
        "到官无一事，清静有诸侯。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 259057,
      "title": "送崔过归淄青幕府",
      "content": [
        "平陵车马客，海上见旌旗。",
        "旧驿千山下，残花一路时。",
        "春衣过水冷，暮雨出关迟。",
        "莫道青州客，迢迢在梦思。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 259058,
      "title": "田仓曹东亭夏夜饮得春字",
      "content": [
        "薛公门下人，公子又相亲。",
        "玉佩迎初夜，金壶醉老春。",
        "葛衣香有露，罗幕静无尘。",
        "更羡风流外，文章是一秦。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 259059,
      "title": "赠王逖",
      "content": [
        "端笏事龙楼，思闲輙告休。",
        "新调赭白马，暂试黑貂裘。",
        "珠履迎佳客，金钱与莫愁。",
        "座中豪贵满，谁道不风流。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 259060,
      "title": "送深州吴司马归使幕",
      "content": [
        "东门送远客，车马正纷纷。",
        "旧识张京兆，新随刘领军。",
        "行骢看暮雨，归雁踏青云。",
        "一去藂台北，佳声几日闻。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 259061,
      "title": "华亭夜宴庾侍御宅",
      "content": [
        "世故他年别，心期此夜同。",
        "千峰孤烛外，片雨一更中。",
        "酒客逢山简，诗人得谢公。",
        "自怜驱匹马，拂曙向关东。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 259062,
      "title": "送客之上谷",
      "content": [
        "北客悲秋色，田园忆去来。",
        "披衣朝易水，匹马夕燕台。",
        "风翦荷花碎，霜迎栗罅开。",
        "赏心知不浅，累月故人杯。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 259063,
      "title": "同中书刘舍人题青龙上房",
      "content": [
        "西掖归来后，东林静者期。",
        "远峰春雪里，寒竹暮天时。",
        "笑说金人偈，闲听宝月诗。",
        "更怜茶兴在，好出下方迟。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 259064,
      "title": "宴吴王宅",
      "content": [
        "玉管箫声合，金杯酒色殷。",
        "听歌吴季札，纵饮汉中山。",
        "称寿争离席，留欢輙上关。",
        "莫言辞客醉，犹得曳裾还。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 259065,
      "title": "题荐福寺衡岳暕师房",
      "content": [
        "春城乞食还，高论此中闲。",
        "僧腊堦前树，禅心江上山。",
        "疎帘看雪卷，深户映花关。",
        "晚送门人出，钟声杳霭间。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 259066,
      "title": "送戴廸赴凤翔幕府",
      "content": [
        "青春带文绶，去事魏征西。",
        "上路金羇出，中人玉筯齐。",
        "当歌酒万斛，看猎马千蹄。",
        "自有从军乐，何须怨解携。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 259067,
      "title": "送郢州郎使君",
      "content": [
        "千人插羽迎，知是范宣城。",
        "暮雪楚山冷，春江汉水清。",
        "红鲜供客饭，翠竹引舟行。",
        "一别何时见，相思芳草生。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 259068,
      "title": "送李中丞赴辰州",
      "content": [
        "白羽逐青丝，翩翩南下时。",
        "巴人迎道路，蛮帅引旌旗。",
        "暮雨山开少，秋江叶落迟。",
        "功成益地日，应见竹郎祠。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 259069,
      "title": "送刘侍御赴陕州",
      "content": [
        "金羁映骕骦，后骑佩干将。",
        "把酒春城晚，鸣鞭晓路长。",
        "带冰新溜涩，间雪早梅香。",
        "明日怀贤处，依依御史床。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 259070,
      "title": "李中丞宅夜宴送丘侍御赴江东便往辰州",
      "content": [
        "积雪临阶夜，重裘对酒时。",
        "中丞违沈约，才子送丘迟。",
        "一路三江上，孤舟万里期。",
        "辰州佳兴在，他日寄新诗。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 259071,
      "title": "送李侍御归宣州使幕",
      "content": [
        "春草东江外，翩翩北路归。",
        "官齐魏公子，身逐谢玄晖。",
        "山色随行骑，莺声傍客衣。",
        "主人池上酌，携手暮花飞。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 259072,
      "title": "东城水亭宴李侍御副使",
      "content": [
        "东门留客处，沽酒用钱刀。",
        "秋水床下急，斜晖林外高。",
        "金羇络騕褭，玉匣闭豪曹。",
        "去日随戎幕，东风见伯劳。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 259073,
      "title": "送秘书谢监赴江西使幕",
      "content": [
        "谢监忆山程，辞家万里行。",
        "寒衣傍楚色，孤枕宿潮声。",
        "小寇不足问，新诗应渐清。",
        "府公相待日，引斾出江城。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 259074,
      "title": "送江陵元司录",
      "content": [
        "新领州从事，曾为朝大夫。",
        "江城竹使待，山路橘官扶。",
        "片雨三江道，残秋五叶湖。",
        "能令诗思好，楚色与寒芜。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 259075,
      "title": "送李舍人携家归江东觐省",
      "content": [
        "二十青宫吏，成名似者稀。",
        "承颜陆郎去，携手谢娘归。",
        "夜月回孤烛，秋风试夹衣。",
        "扁舟楚水上，来往速如飞。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 259076,
      "title": "送刘侍御赴令公行营",
      "content": [
        "东城跃紫骝，西路大刀头。",
        "上客刘公干，元戎郭细侯。",
        "一军偏许国，百战又防秋。",
        "请问萧关道，胡尘早晚收。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 259077,
      "title": "送苏州姚长史",
      "content": [
        "江城驿路长，烟树过云阳。",
        "舟领青丝缆，人歌白玉郎。",
        "葛衣行柳翠，花簟宿荷香。",
        "别有心期处，湖光满讼堂。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 259078,
      "title": "送金华王明府",
      "content": [
        "县舍江云里，心闲境又偏。",
        "家贫陶令酒，月俸沈郎钱。",
        "黄蘗香山路，青枫暮雨天。",
        "时闻引车骑，竹外到铜泉。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 259079,
      "title": "送田仓曹汴州觐省",
      "content": [
        "拜庆承天宠，朝来辞汉宫。",
        "玉杯分湛露，金勒借追风。",
        "古驿秋山下，平芜暮雨中。",
        "翩翩魏公子，人看渡关东。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 259080,
      "title": "送张渚赴越州",
      "content": [
        "白面谁家郎，青骊照地光。",
        "桃花开绶色，苏合借衣香。",
        "暮雪连峰近，春江海市长。",
        "风流似张绪，别后见垂杨。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 259081,
      "title": "奉和元相公家园即事寄王相公",
      "content": [
        "共列中台贵，能齐物外心。",
        "回车青阁晚，解带碧茸深。",
        "寒水分畦入，晴花度竹寻。",
        "题诗更相忆，一字重千金。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 259082,
      "title": "送道士姪归池阳",
      "content": [
        "银角桃枝杖，东门赠别初。",
        "幽州寻马客，灞岸送驴车。",
        "野饭秋山静，行衣落照余。",
        "燕南群从少，此去意何如。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 259083,
      "title": "送刘长上归城南别业",
      "content": [
        "数刻是归程，花间落照明。",
        "春衣香不散，骏马汗犹轻。",
        "南渡春流浅，西风片雨晴。",
        "朝还会相就，饭尔五侯鲭。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 259084,
      "title": "赠张五諲归濠州别业",
      "content": [
        "常知罢官意，果与世人疎。",
        "复此凉风起，仍闻濠上居。",
        "故山期采菊，秋水忆观鱼。",
        "一去蓬蒿迳，羡君闲有余。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 259085,
      "title": "送营城李少府",
      "content": [
        "怀录兼就养，更怀趋府心。",
        "晴山东里近，春水北门深。",
        "新绶映芳草，旧家依远林。",
        "还乘郑小驷，躞蹀县城阴。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 259086,
      "title": "鲁中送鲁使君归郑州",
      "content": [
        "城中金络骑，出饯沈东阳。",
        "九月寒露白，六关秋草黄。",
        "齐讴听处妙，鲁酒把来香。",
        "醉后著鞭去，梅山道路长。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 259087,
      "title": "送夏侯校书归上都",
      "content": [
        "后辈传佳句，高流爱美名。",
        "青春事贺监，黄卷问张生。",
        "暮雪重裘醉，寒山匹马行。",
        "此回将诣阙，几日谏书成。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 259088,
      "title": "送李明府赴连州",
      "content": [
        "万里向南湘，孤舟入桂阳。",
        "诸侯迎上客，小吏拜官郎。",
        "春服橦花细，初筵木槿芳。",
        "看承雨露速，不待荔枝香。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    }
  ],
