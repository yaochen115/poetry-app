{
  "data": [
    {
      "id": 280409,
      "title": "齐宫",
      "content": [
        "白马杂金饰，言从雕辇回。",
        "粉香随笑度，鬓态伴愁来。",
        "远水斜如剪，青莎绿似裁。",
        "所恨章华日，冉冉下层台。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280410,
      "title": "春日",
      "content": [
        "柳岸杏花稀，梅梁乳燕飞。",
        "美人鸾镜笑，嘶马雁门归。",
        "楚宫云影薄，台城心赏违。",
        "从来千里恨，边色满戎衣。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280411,
      "title": "咏春幡",
      "content": [
        "闲庭见早梅，花影为谁栽。",
        "碧烟随刃落，蝉鬓觉春来。",
        "代郡嘶金勒，梵声悲镜台。",
        "玉钗风不定，香步独徘徊。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280412,
      "title": "陈宫词",
      "content": [
        "鸡鸣人草草，香辇出宫花。",
        "妓语细腰转，马嘶金面斜。",
        "早莺随彩仗，惊雉避凝笳。",
        "淅沥湘风外，红轮映曙霞。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280413,
      "title": "春日野行",
      "content": [
        "骑马踏烟莎，青春奈怨何。",
        "蝶翎朝粉尽，鸦背夕阳多。",
        "柳艳欺芳带，山愁萦翠蛾。",
        "别情无处说，方寸是星河。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280414,
      "title": "咏嚬",
      "content": [
        "毛羽歛愁翠，黛娇攒艳春。",
        "恨容偏落泪，低态定思人。",
        "枕上梦随月，扇边歌遶尘。",
        "玉钩鸾不住，波浅石磷磷。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280415,
      "title": "中书令裴公挽歌词二首 一",
      "content": [
        "王俭风华首，萧何社稷臣。",
        "丹阳布衣客，莲渚白头人。",
        "铭勒燕山暮，碑沈汉水春。",
        "从今虚醉饱，无复污车茵。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280416,
      "title": "中书令裴公挽歌词二首 二",
      "content": [
        "箭下妖星落，风前杀气廻。",
        "国香荀令去，楼月庾公来。",
        "玉玺终无虑，金縢意不开。",
        "空嗟荐贤路，芳草满燕台。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280417,
      "title": "唐庄恪太子挽歌词二首 一",
      "content": [
        "叠鼓辞宫殿，悲笳降杳冥。",
        "影离云外日，光灭火前星。",
        "邺客瞻秦苑，商公下汉庭。",
        "依依陵树色，空绕古原青。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280418,
      "title": "唐庄恪太子挽歌词二首 二",
      "content": [
        "东府虚容卫，西园寄梦思。",
        "凤悬吹曲夜，鸡断问安时。",
        "尘陌都人恨，霜郊赗马悲。",
        "唯余埋璧地，烟草近丹墀。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280419,
      "title": "秘书刘尚书挽歌词二首 一",
      "content": [
        "王笔活鸾凤，谢诗生芙蓉。",
        "学筵开绛帐，谈柄发洪钟。",
        "粉署见飞𫛳，玉山猜卧龙。",
        "遗风丽清韵，萧散九原松。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280420,
      "title": "秘书刘尚书挽歌词二首 二",
      "content": [
        "麈尾近良玉，鹤裘吹素丝。",
        "坏陵殷浩谪，春墅谢安棋。",
        "京口贵公子，襄阳诸女儿。",
        "折花兼踏月，多唱柳郎词。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280421,
      "title": "太子西池二首 一",
      "content": [
        "梨花雪压枝，莺啭柳如丝。",
        "嬾逐粧成晓，春融梦觉迟。",
        "鬓轻全作影，嚬浅未成眉。",
        "莫信张公子，窗间断暗期。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280422,
      "title": "太子西池二首 二",
      "content": [
        "花红兰紫茎，愁草雨新晴。",
        "柳占三春色，莺偷百鸟声。",
        "日长嫌辇重，风暖觉衣轻。",
        "薄暮香尘起，长杨落照明。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280423,
      "title": "西陵道士茶歌",
      "content": [
        "乳窦溅溅通石脉，绿尘愁草春江色。",
        "涧花入井水味香，山月当人松影直。",
        "仙翁白扇霜鸟翎，拂坛夜读黄庭经。",
        "疎香皓齿有余味，更觉鹤心通杳冥。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 280424,
      "title": "过西堡塞北",
      "content": [
        "浅草干河阔，丛棘废城高。",
        "白马犀匕首，黑裘金佩刀。",
        "霜清彻兔目，风急吹雕毛。",
        "一经何用厄，日暮涕沾袍。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280425,
      "title": "送李亿东归",
      "content": [
        "黄山远隔秦树，紫禁斜通渭城。",
        "别路青青柳弱，前溪漠漠苔生。",
        "和风澹荡归客，落月殷勤早莺。",
        "灞上金樽未饮，䜩歌已有余声。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 280426,
      "title": "开圣寺",
      "content": [
        "路分谿石夹烟丛，十里萧萧古树风。",
        "出寺马嘶秋色里，向陵鸦乱夕阳中。",
        "竹间泉落山厨静，塔下僧归影殿空。",
        "犹有南朝旧碑在，耻将兴废问休公。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 280427,
      "title": "赠蜀府将",
      "content": [
        "十年分散劒关秋，万事皆随锦水流。",
        "志气已曾明汉节，功名犹自滞吴钩。",
        "雕边认箭寒云重，马上听笳塞草愁。",
        "今日逢君倍惆怅，灌婴韩信尽封侯。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 280428,
      "title": "西江贻钓叟骞生",
      "content": [
        "晴江如镜月如钩，泛滟苍茫送客愁。",
        "夜泪潜生竹枝曲，春潮遥上木兰舟。",
        "事随云去身难到，梦逐烟销水自流。",
        "昨日欢娱竟何在，一枝梅谢楚江头。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 280429,
      "title": "寄清源寺僧",
      "content": [
        "石路无尘竹径开，昔年曾伴戴颙来。",
        "窗间半偈闻钟后，松下残棋送客回。",
        "帘向玉峰藏夜雪，砌因蓝水长秋苔。",
        "白莲社裹如相问，为说游人是姓雷。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 280430,
      "title": "重游圭峰宗密禅师精庐",
      "content": [
        "百尺青崖三尺坟，微言已绝杳难闻。",
        "戴颙今日称居士，支遁他年识领军。",
        "暂对杉松如结社，偶同麋鹿自成群。",
        "故山弟子空廻首，葱岭唯应见宋云。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 280431,
      "title": "题李处士幽居",
      "content": [
        "水玉簪头白角巾，瑶琴寂历拂轻尘。",
        "浓阴似帐红薇晚，细雨如烟碧草春。",
        "隔竹见笼疑有鹤，卷帘看画静无人。",
        "南山自是忘年友，谷口徒称郑子真。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 280432,
      "title": "利州南渡",
      "content": [
        "澹然空水对斜晖，曲岛苍茫接翠微。",
        "波上马嘶看櫂去，柳边人歇待船归。",
        "数丛沙草群鸥散，万顷江田一鹭飞。",
        "谁解乘舟寻范蠡，五湖烟水独忘机。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 280433,
      "title": "赠李将军",
      "content": [
        "谁言荀羡爱功勋，年少登坛众所闻。",
        "曾以能书称内史，又因明易号将军。",
        "金沟故事春长在，玉轴遗文火半焚。",
        "不学龙骧画山水，醉乡无迹似闲云。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 280434,
      "title": "寒食日作",
      "content": [
        "红深绿暗迳相交，抱暖含芳披紫袍。",
        "彩索平时墙婉娩，轻毬落处晚寥梢。",
        "窗中草色妬鸡卵，盘上芹泥憎燕巢。",
        "自有玉楼春意在，不能骑马度烟郊。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 280435,
      "title": "李羽处士寄新酝走笔戏酬",
      "content": [
        "高谈有伴还成薮，沈醉无期即是乡。",
        "已恨流莺欺谢客，更将浮蚁与刘郎。",
        "簷前柳色分张绿，窗外花枝借助香。",
        "所恨玳筵红烛夜，草玄寥落近廻塘。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 280436,
      "title": "郊居秋日有怀一二知己",
      "content": [
        "稻田凫雁满晴沙，钓渚归来一迳斜。",
        "门带果林招邑吏，井分蔬圃属邻家。",
        "臯原寂历垂禾穗，桑竹参差映豆花。",
        "自笑谩怀经济策，不将心事许烟霞。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 280437,
      "title": "题友人池亭",
      "content": [
        "月榭风亭绕曲池，粉垣廻互瓦参差。",
        "侵帘片白摇翻影，落镜愁红写倒枝。",
        "㶉𫛶刷毛花荡漾，鹭鸶拳足雪离披。",
        "山翁醉后如相忆，羽扇清樽我自知。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 280438,
      "title": "南湖",
      "content": [
        "湖上微风入槛凉，翻翻菱荇满廻塘。",
        "野船著岸偎春草，水鸟带波飞夕阳。",
        "芦叶有声疑雾雨，浪花无际似潇湘。",
        "飘然篷艇东归客，尽日相看忆楚乡。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 280439,
      "title": "赠袁司录",
      "content": [
        "一朝辞满有心期，花发杨园雪压枝。",
        "刘尹故人谙往事，谢郎诸弟得新知。",
        "金钗醉就胡姬画，玉管闲留洛客吹。",
        "记得襄阳耆旧语，不堪风景岘山碑。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 280440,
      "title": "题西明寺僧院",
      "content": [
        "曾识匡山远法师，低松片石对前墀。",
        "为寻名画来过院，因访闲人得看棋。",
        "新雁参差云碧处，寒鸦辽乱叶红时。",
        "自知终有张华识，不向沧洲州理钓丝。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 280441,
      "title": "偶题",
      "content": [
        "微风和暖日鲜明，草色迷人向渭城。",
        "吴客卷帘闲不语，楚娥攀树独含情。",
        "红垂果蔕樱桃重，黄染花丛蝶粉轻。",
        "自恨青楼无近信，不将心事许卿卿。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 280442,
      "title": "寄湘阴阎少府乞钓轮子",
      "content": [
        "钓轮形与月轮同，独茧和烟影似空。",
        "若向三湘逢雁信，莫辞千里寄渔翁。",
        "篷声夜滴松江雨，菱叶秋传镜水风。",
        "终日垂钩还有意，尺书多在锦鳞中。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 280443,
      "title": "哭王元裕",
      "content": [
        "闻说萧郎逐逝川，伯牙因此绝清弦。",
        "柳边犹忆青骢影，坟上俄生碧草烟。",
        "箧里诗书疑谢后，梦中风貌似潘前。",
        "他时若到相寻处，碧树红楼自宛然。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 280444,
      "title": "法云寺双桧",
      "content": [
        "晋朝名辈此离群，想对浓阴去住分。",
        "题处尚寻王内史，画时应是顾将军。",
        "长廊夜静声疑雨，古殿秋深影胜云。",
        "一下南台到人世，晓泉清籁更难闻。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 280445,
      "title": "送陈嘏之侯官兼简李常侍",
      "content": [
        "纵得步兵无绿蚁，不缘句漏有丹砂。",
        "殷勤为报同袍友，我亦无心似海槎。",
        "春服照尘连草色，夜船闻雨滴芦花。",
        "梅仙自是青云客，莫羡相如却到家。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 280446,
      "title": "春日野行",
      "content": [
        "雨涨西塘金堤斜，碧草芊芊晴吐芽。",
        "野岸明媚山芍药，水田呌噪官虾蟇。",
        "镜中有浪动菱蔓，陌上无风飘柳花。",
        "何事轻桡句溪客，绿萍方好不归家。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 280447,
      "title": "溪上行",
      "content": [
        "绿塘漾漾烟蒙蒙，张翰此来情不穷。",
        "雪羽䙰褷立倒影，金鳞拨剌跳晴空。",
        "风翻荷叶一向白，雨湿蓼花千穗红。",
        "心羡夕阳波上客，片时归梦钓船中。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 280448,
      "title": "投翰林萧舍人",
      "content": [
        "人间鹓鹭杳难从，独恨金扉直九重。",
        "万象晚归仁寿镜，百花春隔景阳钟。",
        "紫微芒动词初出，红烛香残诰未封。",
        "每过朱门爱庭树，一枝何日许相容。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 280449,
      "title": "春日偶作",
      "content": [
        "西园一曲艳阳歌，扰扰车尘负薜萝。",
        "自欲放怀犹未得，不知经世竟如何。",
        "夜闻猛雨判花尽，寒恋重衾觉梦多。",
        "钓渚别来应更好，春风还为起微波。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 280450,
      "title": "春暮宴罢寄宋寿先辈",
      "content": [
        "斜掩朱门花外钟，晓莺时节好相逢。",
        "窗间桃蘂宿粧在，雨后牡丹春睡浓。",
        "苏小风姿迷下蔡，马卿才调似临邛。",
        "谁怜芳草生三径，参佐桥西陆士龙。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 280451,
      "title": "马嵬驿",
      "content": [
        "穆满曾为物外游，六龙经此暂淹留。",
        "返魂无验青烟灭，埋血空生碧草愁。",
        "香辇却归长乐殿，晓钟还下景阳楼。",
        "甘泉不复重相见，谁道文成是故侯。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 280452,
      "title": "和道溪君别业",
      "content": [
        "积润初销碧草新，凤阳晴日带雕轮。",
        "风飘弱柳平桥晚，雪点寒梅小苑春。",
        "屏上楼台陈后主，镜中金翠李夫人。",
        "花房透露红珠落，蛱蝶双飞护粉尘。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 280453,
      "title": "奉天西佛寺",
      "content": [
        "忆昔狂童犯顺年，玉虬闲暇出甘泉。",
        "宗臣欲舞千钧劒，追骑犹观七宝鞭。",
        "星背紫垣终埽地，日归黄道却当天。",
        "至今南顿诸耆旧，犹指榛芜作弄田。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 280454,
      "title": "题望苑驿",
      "content": [
        "弱柳千条杏一枝，半含春雨半垂丝。",
        "景阳寒井人难到，长乐晨钟鸟自知。",
        "花影至今通博望，树名从此号相思。",
        "分明十二楼前月，不向西陵照盛姬。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 280455,
      "title": "寄分司元庶子兼呈元处士",
      "content": [
        "闭门高卧莫长嗟，水木凝晖属谢家。",
        "缑岭参差残晓雪，洛波清浅露晴沙。",
        "刘公春尽芜菁色，华[廙]愁深苜蓿花。",
        "月榭知君还怅望，碧霄烟阔雁行斜。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 280456,
      "title": "题柳",
      "content": [
        "杨柳千条拂面丝，绿烟金穗不胜吹。",
        "香随静婉歌尘起，影伴娇娆舞袖垂。",
        "羌管一声何处曲，流莺百啭最高枝。",
        "千门九陌花如雪，飞过宫墙两自知。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 280457,
      "title": "和友人悼亡",
      "content": [
        "玉貌潘郎泪满衣，画罗轻鬓[雨]霏微。",
        "红兰委露愁难尽，白马朝天望不归。",
        "宝镜尘昏鸾影在，钿筝弦断雁行稀。",
        "春来多少伤心事，碧草侵堦粉蝶飞。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 280458,
      "title": "李羽处士故里",
      "content": [
        "柳不成丝草带烟，海槎东去鹤归天。",
        "愁肠断处春何限，病眼开时月正圆。",
        "花若有情还怅望，水应无事莫潺湲。",
        "终知此恨销难尽，辜负南华第一篇。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 280459,
      "title": "却经商山寄昔同行人",
      "content": [
        "曾道逍遥第一篇，尔来无处不恬然。",
        "便同南郭能忘象，兼笑东林学坐禅。",
        "人事转新花烂熳，客程依旧水潺湲。",
        "若教犹作当时意，应有垂丝在鬓边。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 280460,
      "title": "池塘七夕",
      "content": [
        "月出西南露气秋，绮罗河汉在斜沟。",
        "杨家绣作鸳鸯幔，张氏金为翡翠钩。",
        "香烛有花妨宿燕，画屏无睡待牵牛。",
        "万家砧杵三篙水，一夕横塘似旧游。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 280461,
      "title": "偶游",
      "content": [
        "曲巷斜临一水间，小门终日不开关。",
        "红珠斗帐樱桃熟，金尾屏风孔雀闲。",
        "云髻几迷芳草蝶，额黄无限夕阳山。",
        "与君便是鸳鸯侣，休向人间觅往还。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 280462,
      "title": "寄河南杜少尹",
      "content": [
        "十载归来鬓未凋，玳簪珠履见常僚。",
        "岂关名利分荣路，自有才华作庆霄。",
        "鸟影参差经上苑，骑声断续过中桥。",
        "夕阳亭畔山如画，应念田歌正寂寥。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 280463,
      "title": "赠知音",
      "content": [
        "翠羽花冠碧树鸡，未明先向短墙啼。",
        "窗间谢女青蛾歛，门外萧郎白马嘶。",
        "星汉渐移庭竹影，露珠犹缀野花迷。",
        "景阳宫里钟初动，不语垂鞭上柳堤。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 280464,
      "title": "过陈琳墓",
      "content": [
        "曾于青史见遗文，今日飘蓬过古坟。",
        "词客有灵应识我，霸才无主始怜君。",
        "石麟埋没藏春草，铜雀荒凉对暮云。",
        "莫怪临风倍惆怅，欲将书劒学从军。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 280465,
      "title": "题崔公池旧游",
      "content": [
        "皎镜方塘菡萏秋，此来重见采莲舟。",
        "谁能不逐当年乐，还恐添成异日愁。",
        "红艳影多风袅袅，碧空云断水悠悠。",
        "簷前依旧青山色，尽日无人独上楼。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 280466,
      "title": "回中作",
      "content": [
        "苍莽寒空远色愁，呜呜戍角上高楼。",
        "吴姬怨思吹双管，燕客悲歌别五侯。",
        "千里关山边草暮，一星烽火朔云秋。",
        "夜来霜重西风起，陇水无声冻不流。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 280467,
      "title": "西江上送渔父",
      "content": [
        "却逐严光向若耶，钓轮菱櫂寄年华。",
        "三秋梅雨愁枫叶，一夜篷舟宿苇花。",
        "不见水云应有梦，偶随鸥鹭便成家。",
        "白苹风起楼船暮，江燕双双五两斜。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 280468,
      "title": "经故秘书崔监扬州南塘旧居",
      "content": [
        "昔年曾识范安成，松竹风姿鹤性情。",
        "西掖曙河横漏响，北山秋月照江声。",
        "乘舟觅吏经舆县，为酒求官得步兵。",
        "千顷水流通故墅，至今留得谢公名。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 280469,
      "title": "经故秘书崔监扬州南塘旧居",
      "content": [
        "昔年曽识谢宣城，松竹风姿鹤性情。",
        "唯向旧山留月色，偶逢秋涧似琴声。",
        "乗舟覔吏经舆县，为酒求官得步兵。",
        "玉柄寂寥谭客散，却寻池阁泪纵横。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 280470,
      "title": "七夕",
      "content": [
        "鹊归燕去两悠悠，青琐西南月似钩。",
        "天上岁时星右转，世间离别水东流。",
        "金风入树千门夜，银汉横空万象秋。",
        "苏小横塘通桂檝，未应清浅隔牵牛。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 280471,
      "title": "题韦筹博士草堂",
      "content": [
        "玄晏先生已白头，不随鹓鹭狎群鸥。",
        "元卿谢免开三径，平仲朝归卧一裘。",
        "醉后独知殷甲子，病来犹作晋春秋。",
        "沧浪未濯尘缨在，野水无情处处流。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 280472,
      "title": "和友人题壁",
      "content": [
        "冲尚犹来出范围，肯将经世作风徽。",
        "三台位缺严陵卧，百战功高范蠡归。",
        "自欲一鸣惊鹤寝，不应孤愤学牛衣。",
        "西州未有看棋暇，涧户何由得掩扉。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 280473,
      "title": "春日将欲东归寄新及第苗绅先辈",
      "content": [
        "几年辛苦与君同，得丧悲欢尽是空。",
        "犹喜故人先折桂，自怜羁客尚飘蓬。",
        "三春月照千山道，十日花开一夜风。",
        "知有杏园无路入，马前惆怅满枝红。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 280474,
      "title": "经李征君故居",
      "content": [
        "露浓烟重草萋萋，树映阑干柳拂堤。",
        "一院落花无客醉，五更残月有莺啼。",
        "芳筵想像情难尽，故榭荒凉路已迷。",
        "惆怅羸骖往来惯，每经门巷亦长嘶。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 280475,
      "title": "送崔郎中赴幕",
      "content": [
        "一别黔巫似断弦，故交东去更凄然。",
        "心游目送三千里，雨散云飞二十年。",
        "发迹岂劳天上桂，属词还得幕中莲。",
        "相思休话长安远，江月随人处处圆。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 280476,
      "title": "经旧游",
      "content": [
        "珠箔金钩对彩桥，昔年于此见娇娆。",
        "香灯怅望飞琼鬓，凉月慇勤碧玉箫。",
        "屏倚故窗山六扇，柳垂寒砌露千条。",
        "坏墙经雨苍苔遍，拾得当时旧翠翘。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 280477,
      "title": "老君庙",
      "content": [
        "紫气氤氲捧半岩，莲峰仙掌共巉巉。",
        "庙前晚色连寒水，天外斜阳带远帆。",
        "百二关山扶玉座，五千文字閟瑶缄。",
        "自怜金骨无人识，知有飞龟在石函。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 280478,
      "title": "过五丈原",
      "content": [
        "铁马云雕久绝尘，柳阴高压汉营春。",
        "天晴杀气屯关右，夜半妖星照渭滨。",
        "下国卧龙空误主，中原逐鹿不因人。",
        "象床锦帐无言语，从此谯周是老臣。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 280479,
      "title": "和友人伤歌姬",
      "content": [
        "月缺花残莫怆然，花须终发月终圆。",
        "更能何事销芳念，亦有浓华委逝川。",
        "一曲艳歌留婉转，九原春草妬婵娟。",
        "王孙莫学多情客，自古多情损少年。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 280480,
      "title": "山中与诸道友夜坐闻边防不宁因示同志",
      "content": [
        "龙砂铁马犯烟尘，迹近群鸥意倍亲。",
        "风卷蓬根屯戊己，月移松影守庚申。",
        "韬钤岂足为经济，岩壑何尝是隐沦。",
        "心许故人知此意，古来知者竟谁人。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 280481,
      "title": "秘书省有贺监知章草题诗笔力遒健风尚高远拂尘寻玩因有此作",
      "content": [
        "越溪渔客贺知章，任达怜才爱酒狂。",
        "㶉𫛶苇花随钓艇，蛤蜊菰菜梦横塘。",
        "几年凉月拘华省，一宿秋风忆故乡。",
        "荣路脱身终自得，福庭回首莫相忘。",
        "出笼鸾鹤归辽海，落笔龙蛇满坏墙。",
        "李白死来无醉客，可怜神彩吊残阳。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 280482,
      "title": "题裴晋公林亭",
      "content": [
        "谢傅林亭暑气微，山丘零落閟音徽。",
        "东山终为苍生起，南浦虚言白首归。",
        "池凤已传春水浴，渚禽犹带夕阳飞。",
        "悠然到此忘情处，一日何妨有万几。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 280483,
      "title": "车驾西游因而有作",
      "content": [
        "宣曲长杨瑞气凝，上林狐兔待秋鹰。",
        "谁将词赋陪雕辇，寂寞相如卧茂林。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 280484,
      "title": "伤温德彝",
      "content": [
        "昔年戎虏犯榆关，一败龙城匹马还。",
        "侯印不闻封李广，他人丘垄似天山。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 280485,
      "title": "赠少年",
      "content": [
        "江海相逢客恨多，秋风叶下洞庭波。",
        "酒酣夜别淮阴市，月照高楼一曲歌。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 280486,
      "title": "赠郑征君家匡山首春与丞相赞皇公游止",
      "content": [
        "一抛兰櫂逐燕鸿，曾向江湖识谢公。",
        "每到朱门还怅望，故山多在画屏中。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 280487,
      "title": "夏中病痁作",
      "content": [
        "山鬼扬威正气愁，便辞珍簟袭狐裘。",
        "西窗一夕悲人事，团扇无情不待秋。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 280488,
      "title": "题友人居",
      "content": [
        "尽日松堂看画图，绮疏岑寂似清都。",
        "若教烟水无鸥鸟，张翰何由到五湖。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 280489,
      "title": "题李相公勅赐锦屏风",
      "content": [
        "丰沛曾为社稷臣，赐书名画墨犹新。",
        "几人同保山河誓，犹自栖栖九陌尘。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 280490,
      "title": "蔡中郎坟",
      "content": [
        "古坟零落野花春，闻说中郎有后身。",
        "今日爱才非昔日，莫抛心力作词人。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 280491,
      "title": "元处士池上",
      "content": [
        "蓼穗菱丛思蟪蛄，水萤江鸟满烟蒲。",
        "愁红一片风前落，池上秋波似五湖。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 280492,
      "title": "华阴韦氏林亭",
      "content": [
        "自有林亭不得闲，陌尘宫树是非间。",
        "终南长在茅簷外，别向人间看华山。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 280493,
      "title": "寄裴生乞钓钩",
      "content": [
        "一随菱櫂谒王侯，深媿移文负钓舟。",
        "今日太湖风色好，却将诗句乞鱼钩。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 280494,
      "title": "长安春晚二首 一",
      "content": [
        "曲江春半日迟迟，正是王孙怅望时。",
        "杏花落尽不归去，江上东风吹柳丝。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 280495,
      "title": "长安春晚二首 二",
      "content": [
        "四方无事太平年，万象鲜明禁火前。",
        "九重细雨惹春色，轻染龙池杨柳烟。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 280496,
      "title": "三月十八日雪中作",
      "content": [
        "芍药蔷薇语早梅，不知谁是艳阳才。",
        "今朝领得春风意，不复饶君雪里开。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 280497,
      "title": "咸阳值雨",
      "content": [
        "咸阳桥上雨如悬，万点空蒙隔钓船。",
        "还似洞庭春水色，晚云将入岳阳天。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 280498,
      "title": "弹筝人",
      "content": [
        "天宝年中事玉皇，曾将新曲教宁王。",
        "钿蝉金雁今零落，一曲伊州泪万行。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 280499,
      "title": "瑶瑟怨",
      "content": [
        "冰簟银床梦不成，碧天如水夜云轻。",
        "雁声远过潇湘去，十二楼中月自明。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 280500,
      "title": "题端正树",
      "content": [
        "路傍佳树碧云愁，曾侍金舆幸驿楼。",
        "草木荣枯似人事，绿阴寂寞汉陵秋。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 280501,
      "title": "渭上题三首 一",
      "content": [
        "吕公荣达子陵归，万古烟波遶钓矶。",
        "桥上一通名利迹，至今江鸟背人飞。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 280502,
      "title": "渭上题三首 二",
      "content": [
        "目极云霄思浩然，风帆一片水连天。",
        "轻桡便是东归路，不肯忘机作钓船。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 280503,
      "title": "渭上题三首 三",
      "content": [
        "烟水何曾息世机，暂时相向亦依依。",
        "所嗟白首磻谿叟，一下渔舟更不归。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 280504,
      "title": "经故翰林袁学士居",
      "content": [
        "劒逐惊波玉委尘，谢安门下更何人。",
        "西州城外花千树，尽是羊昙醉后春。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 280505,
      "title": "题城南杜邠公林亭",
      "content": [
        "卓氏垆前金线柳，隋家堤畔锦帆风。",
        "贪为两地分霖雨，不见池莲照水红。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 280506,
      "title": "夜看牡丹",
      "content": [
        "高低深浅一阑红，把火殷勤遶露丛。",
        "希逸近来成嬾病，不能容易向春风。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 280507,
      "title": "宿城南亡友别墅",
      "content": [
        "水流花落叹浮生，又伴游人宿杜城。",
        "还似昔年残梦里，透帘斜月独闻莺。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 280508,
      "title": "过分水岭",
      "content": [
        "溪水无情似有情，入山三日得同行。",
        "岭头更是分头处，惜别潺湲一夜声。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
