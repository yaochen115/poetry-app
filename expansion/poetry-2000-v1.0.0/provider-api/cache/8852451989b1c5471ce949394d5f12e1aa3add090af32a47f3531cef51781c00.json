{
  "data": [
    {
      "id": 261561,
      "title": "送友人还洛",
      "content": [
        "去国渡关河，蝉鸣古树多。",
        "平原正超忽，行子复蹉跎。",
        "去事不可想，旧游难再过。",
        "何当嵩岳下，相见在烟萝。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 261562,
      "title": "送戴征士还山",
      "content": [
        "柔桑锦臆雉，相送到烟霞。",
        "独隐空山里，闲门几树花。",
        "草生杨柳岸，鸟啭竹林家。",
        "不是谋生拙，无为末路赊。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261563,
      "title": "秋日旅舍别司空文明",
      "content": [
        "凉风飒穷巷，秋思满高云。",
        "吏隐俱不就，此心仍别君。",
        "素怀宗淡泊，羁旅念功勋。",
        "转忆西林寺，江声月下闻。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261564,
      "title": "旅舍对雪赠考功王员外",
      "content": [
        "杨花惊满路，面市忽狂风。",
        "骤下摇兰叶，轻飞集竹丛。",
        "欲将琼树比，不共玉人同。",
        "独望徽之棹，青山在雪中。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261565,
      "title": "送丁少府往唐上",
      "content": [
        "因君灞陵别，故国一回看。",
        "共食田文饭，先之梅福官。",
        "江风转日暮，山月满潮寒。",
        "不得同舟望，淹留岁月阑。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261566,
      "title": "赠李龟年",
      "content": [
        "青春事汉主，白首入秦城。",
        "遍识才人字，多知旧曲名。",
        "风流随故事，语笑合新声。",
        "独有垂杨树，偏伤日暮情。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261567,
      "title": "送郭补阙归江阳",
      "content": [
        "东门春尚浅，杨柳未成阴。",
        "雁影愁斜日，鸎声怨故林。",
        "隋宫江上远，梁苑雪中深。",
        "独有怀归客，难为欲别心。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261568,
      "title": "早春会王逵主人得蓬字",
      "content": [
        "今年华鬓色，半在故人中。",
        "欲写无穷恨，先期一醉同。",
        "绿丛犹覆雪，红萼已凋风。",
        "莫负归山契，君看陌上蓬。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261569,
      "title": "宿山寺思归",
      "content": [
        "僧房秋雨歇，愁卧夜更深。",
        "欹枕闻鸿雁，回灯见竹林。",
        "归萤入草尽，落月映窗沉。",
        "拭泪无人觉，长谣向壁阴。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261570,
      "title": "送客赴江陵寄郢州郎士元",
      "content": [
        "露下晚蝉愁，诗人旧怨秋。",
        "沅湘莫留滞，宛洛好遨游。",
        "饮马逢黄菊，离家值白头。",
        "竟陵明月夜，为上庾公楼。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261571,
      "title": "送客赋得巴江夜猿",
      "content": [
        "巴水天边路，啼猿伤客情。",
        "迟迟云外尽，杳杳树中生。",
        "残月暗将落，空霜寒欲明。",
        "楚人皆掩泪，闻到第三声。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261572,
      "title": "秋日忆暕上人",
      "content": [
        "一从持钵别，更未到人间。",
        "好静居贫寺，遗名弃近山。",
        "雨前缝百衲，叶下闭重关。",
        "若便浔阳去，须将旧客还。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261573,
      "title": "寄上舍人叔",
      "content": [
        "车马朝初下，看山忆独寻。",
        "会知逢水尽，且爱入云深。",
        "残雨开斜日，新蝉发迥林。",
        "阮咸虽别巷，遥识此时心。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261574,
      "title": "送古之奇赴安西幕",
      "content": [
        "畴昔十年兄，相逢五校营。",
        "今宵举杯酒，陇月见军城。",
        "堠火经阴绝，边人接晓行。",
        "殷勤送书记，强虏几时平。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261575,
      "title": "送张芬归江东兼寄柳中庸",
      "content": [
        "久是天涯客，偏伤落木时。",
        "如何故国见，更欲异乡期。",
        "鸟暮东西急，波寒上下迟。",
        "空将满眼泪，千里怨相思。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261576,
      "title": "送丘丹归江东",
      "content": [
        "故山霜落久，才子忆荆扉。",
        "旅舍寻人别，秋风逐雁归。",
        "梦愁枫叶尽，醉惜菊花稀。",
        "肯学求名者，经年未拂衣。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261577,
      "title": "卧病寄苗员外",
      "content": [
        "故人初未贵，相见得淹留。",
        "一自朝天去，因成计日游。",
        "月明应独醉，叶下肯同愁。",
        "因恨刘桢病，空园卧见秋。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261578,
      "title": "送杨臯擢第归江东",
      "content": [
        "隋堤望楚国，江上一归人。",
        "绿气千樯暮，青风万里春。",
        "试才初得桂，泊渚肯伤苹。",
        "拜手终凄怆，恭承中外亲。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261579,
      "title": "题郑少府林园",
      "content": [
        "谢家今日晚，词客愿抽毫。",
        "枥马方回影，池鹅正理毛。",
        "竹筒传水远，麈尾坐僧高。",
        "独有宗雷贱，过君著敝袍。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261580,
      "title": "送吉中孚拜官归业",
      "content": [
        "南入华阳洞，无人古树寒。",
        "吟诗开旧帙，带绶上荒坛。",
        "因病求归易，霑恩更隐难。",
        "孟宗应献鲊，家近守渔官。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261581,
      "title": "送杨少府赴阳翟",
      "content": [
        "冠带仁兄后，光辉寿母前。",
        "陆云还入洛，潘岳更张筵。",
        "井邑嵩山对，园林颍水连。",
        "东人欲相送，旅舍已潸然。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261582,
      "title": "慈恩寺暕上人房招耿拾遗",
      "content": [
        "悠然对惠远，共结故山期。",
        "汲井树阴下，闭门亭午时。",
        "地闲花落厚，石浅水流迟。",
        "愿与神仙客，同来事本师。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261583,
      "title": "宿山寺雪夜寄吉中孚",
      "content": [
        "独爱僧房竹，春来长到池。",
        "云遮皆晃朗，雪压半低垂。",
        "不见侵山叶，空闻拂地枝。",
        "鄙夫今夜兴，唯有子猷知。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261584,
      "title": "赠赵神童",
      "content": [
        "圣朝殊汉令，才子少登科。",
        "每见先鸣早，常惊后进多。",
        "独居方寂寞，相对觉蹉跎。",
        "不是通家旧，频劳文举过。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261585,
      "title": "宿云际寺赠深上人",
      "content": [
        "暂别青蓝寺，今来发欲斑。",
        "独眠孤烛下，风雨在前山。",
        "坏宅终须去，空门不易还。",
        "支公有方便，一愿启玄关。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261586,
      "title": "送从兄赴洪州别驾兄善琴",
      "content": [
        "援琴兼爱竹，遥夜在湘沅。",
        "鹤舞月将下，乌啼霜正繁。",
        "乱流喧橘岸，飞雪暗荆门。",
        "佐郡无辞屈，其如相府恩。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261587,
      "title": "山中期张芬不至",
      "content": [
        "石堤春草碧，双燕向西飞。",
        "怅望云天暮，佳人何处归。",
        "药栏虫网遍，苔井水痕稀。",
        "谁道嵇康嬾，山中自掩扉。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261588,
      "title": "寄畅当",
      "content": [
        "麦秀草芊芊，幽人好昼眠。",
        "云霞生岭上，猿鸟下床前。",
        "颜子方敦行，支郎久住禅。",
        "中林轻暂别，约略已经年。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261589,
      "title": "送义兴元少府",
      "content": [
        "逢君惠连第，初命[便]光辉。",
        "已得群公祖，终妨太傅讥。",
        "路长人反顾，草断燕回飞。",
        "本是江南客，还同衣锦归。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261590,
      "title": "卧病别郑锡",
      "content": [
        "病来喜无事，多卧竹林间。",
        "此日一相见，明朝还掩关。",
        "幽人爱芳草，志士惜颓颜。",
        "岁[晏]不我弃，期君在故山。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261591,
      "title": "书志赠畅当",
      "content": [
        "少喜神仙术，未去已蹉跎。",
        "壮志一为累，浮生事渐多。",
        "衰颜不相识，岁暮定相过。",
        "请问宗居士，君其奈老何。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261592,
      "title": "送诸曁裴少府",
      "content": [
        "山公访嵇绍，赵武见韩侯。",
        "事去恩犹在，名成泪却流。",
        "一官同北去，千里赴南州。",
        "才子清风后，无贻相府忧。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261593,
      "title": "送郑宥入蜀迎觐",
      "content": [
        "宁亲西陟险，君去异王阳。",
        "在世谁非客，还家即是乡。",
        "剑门千转尽，巴水一支长。",
        "请语愁猿道，无烦促泪行。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261594,
      "title": "送耿拾遗𣲗使江南括图书",
      "content": [
        "驱传草连天，回风满树蝉。",
        "将过夫子宅，前问孝廉船。",
        "汉使收三箧，周诗采百篇。",
        "别来将有泪，不是怨流年。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 261595,
      "title": "送王少府游河南",
      "content": [
        "马卿方失意，东去谒诸侯。",
        "过宋人应少，游梁客独愁。",
        "鸟翻千室暮，蝉急两河秋。",
        "仆本无媒者，因君泪亦流。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261596,
      "title": "送别驾赴晋陵即舍人叔之兄",
      "content": [
        "诸宗称叔父，从子亦光辉。",
        "谢脁中书直，王祥别乘归。",
        "江帆冲雨上，海树隔潮微。",
        "南阮贫无酒，唯将泪湿衣。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261597,
      "title": "卧病寄阎采",
      "content": [
        "病中贪好景，强步出幽居。",
        "紫葛垂山径，黄花遶野渠。",
        "荒林飞老鹤，败堰过游鱼。",
        "纵忆同年友，无人可寄书。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261598,
      "title": "晚夏闻蝉寄广文",
      "content": [
        "昨日莺啭声，今朝蝉忽鸣。",
        "朱颜向华发，定是几年程。",
        "故国白云远，闲居青草生。",
        "因垂数行泪，书报十年兄。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261599,
      "title": "归山居寄钱起",
      "content": [
        "怅望青山下，回头泪满巾。",
        "故乡多古树，落日少行人。",
        "发鬓将回色，簪缨未到身。",
        "谁知武陵路，亦有汉家臣。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261600,
      "title": "晓发瓜州",
      "content": [
        "晓发悲行客，停桡独未前。",
        "寒江半有月，野戍渐无烟。",
        "棹唱临高岸，鸿嘶发远田。",
        "谁知避徒御，对酒一潸然。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261601,
      "title": "江上喜逢司空文明",
      "content": [
        "秦人江上见，握手泪沾巾。",
        "落日见秋草，暮年逢故人。",
        "非夫长作客，多病浅谋身。",
        "台阁旧亲友，谁曾见苦辛。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261602,
      "title": "同苗发慈恩寺避暑",
      "content": [
        "追凉寻宝刹，畏日望璇题。",
        "卧草同鸳侣，临池似虎溪。",
        "树闲人迹外，山晚鸟行西。",
        "若问无心法，莲花隔淤泥。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261603,
      "title": "送潘述宏词下第归江外",
      "content": [
        "唱高人不和，此去泪难收。",
        "上国经年住，长江满目流。",
        "弈棋知胜偶，射策请焚舟。",
        "应是田囗囗，玄成许尔游。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261604,
      "title": "送张少府赴夏县",
      "content": [
        "虽为州县职，还欲抱琴过。",
        "树古闻风早，山枯见雪多。",
        "鸡声连绛市，马色傍黄河。",
        "太守新临郡，还逢五袴歌。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261605,
      "title": "酬秘书元丞郊园卧疾见寄",
      "content": [
        "闻说漳滨卧，题诗怨岁华。",
        "求医主高手，报疾到贫家。",
        "撒枕销行蚁，移杯失画蛇。",
        "明朝九衢上，应见玉人车。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261606,
      "title": "送成都韦丞还蜀",
      "content": [
        "蜀门云树合，高栈有猿愁。",
        "驱传加新命，之官向旧游。",
        "晨装逢酒雨，夜梦见刀州。",
        "远别长相忆，当年莫滞留。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261607,
      "title": "晚秋旅舍寄苗员外",
      "content": [
        "争途苦不前，贫病遂连牵。",
        "向暮同行客，当秋独长年。",
        "晚花唯有菊，寒叶已无蝉。",
        "吏部逢今日，还应瓮下眠。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261608,
      "title": "送惟良上人归润州",
      "content": [
        "拟诗偏不类，又送上人归。",
        "寄世同高鹤，寻仙称坏衣。",
        "雨行江草短，露坐海帆稀。",
        "正被空门缚，临岐乞解围。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261609,
      "title": "送何兆下第还蜀",
      "content": [
        "重江不可涉，孤客莫晨装。",
        "高木莎城小，残星栈道长。",
        "褭猿枫子落，过雨荔枝香。",
        "劝尔成都住，文翁有草堂。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261610,
      "title": "送友人宰湘阴",
      "content": [
        "从宦舟行远，浮湘又入闽。",
        "蒹葭无朔雁，柽栝有蛮神。",
        "传吏闲调象，山精暗讼人。",
        "唯须千树橘，暂救李衡贫。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 261611,
      "title": "送元晟归江东旧居",
      "content": [
        "泽国舟车接，关门雨雪乖。",
        "春天行故楚，夜月下清淮。",
        "讲易居山寺，论诗到郡斋。",
        "蒋家人暂别，三路草连堦。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261612,
      "title": "送黎少府赴阳翟",
      "content": [
        "诗礼称才子，神仙是丈人。",
        "玉山那惜醉，金谷已无春。",
        "白马如风疾，青袍夺草新。",
        "不嫌鸣吠客，愿用百年身。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261613,
      "title": "送夏侯审游蜀",
      "content": [
        "西望烟绵树，愁君上蜀时。",
        "同林息商客，隔栈见罛师。",
        "石滑羊肠险，山空杜宇悲。",
        "琴心正幽怨，莫奏凤凰诗。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261614,
      "title": "单推官厅前双桐咏",
      "content": [
        "封植因高兴，孤贞契素期。",
        "由来得地早，何事结花迟。",
        "叶重凝烟后，条寒过雨时。",
        "还同李家树，争赋角弓诗。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261615,
      "title": "送宋校书赴宣州幕",
      "content": [
        "浮舟压芳草，容裔逐江春。",
        "远避看书吏，行当入幕宾。",
        "夜潮冲老树，晓雨破轻苹。",
        "鸳鹭多伤别，栾家德在人。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261616,
      "title": "送赵给事姪尉丹阳",
      "content": [
        "太傅怜群从，门人亦贱回。",
        "入官先爱子，赐酒许同杯。",
        "淮海春多雨，蒹葭夜有雷。",
        "遥知拜庆后，梅尉称仙才。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261617,
      "title": "宿瓜洲寄柳中庸",
      "content": [
        "怀人同不寐，清夜起论文。",
        "月魄正出海，雁行斜上云。",
        "寒潮来滟滟，秋叶下纷纷。",
        "便送江东去，徘徊祗待君。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261618,
      "title": "夜宴虢县张明府宅逢宇文评事",
      "content": [
        "虢田留古宅，入夜足秋风。",
        "月影来窗里，灯光落水中。",
        "征诗逢谢客，饮酒得陶公。",
        "更爱疎篱下，繁霜湿菊丛。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261619,
      "title": "冬夜集张尹后阁",
      "content": [
        "乘龟兼戴豸，白面映朱衣。",
        "安石还须起，泉明不得归。",
        "譍门常吏在，登席旧寮稀。",
        "远客长先醉，那知亚相威。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261620,
      "title": "将之泽潞留别王郎中",
      "content": [
        "弱年知己少，前路主人稀。",
        "贫病期相惜，艰难又忆归。",
        "事成应未卜，身贱又无机。",
        "幸到龙门下，须因羽翼飞。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261621,
      "title": "晚次巴陵",
      "content": [
        "雪后柳条新，巴陵城下人。",
        "烹鱼邀水客，载酒奠山神。",
        "云去低斑竹，波回动白苹。",
        "不堪逢楚老，日暮正江春。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261622,
      "title": "送荀道士归庐山",
      "content": [
        "先生归有处，欲别笑无言。",
        "绿水到山口，青林连洞门。",
        "月明寻石路，云霁望花源。",
        "早晚还乘鹤，悲歌向故园。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261623,
      "title": "送张淑归觐叔父",
      "content": [
        "日惨长亭暮，天高大泽闲。",
        "风中闻草木，雪里见江山。",
        "马向塞云去，人随古道还。",
        "阮家今夜乐，应在竹林间。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261624,
      "title": "送郭参军赴绛州",
      "content": [
        "登车君莫望，故绛柳条春。",
        "蒲泽逢胡雁，桃源见晋人。",
        "佐军髯尚短，掷地思还新。",
        "小谢常携手，因之醉路尘。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261625,
      "title": "送袁稠游江南",
      "content": [
        "江南衰草遍，十里见长亭。",
        "客去逢摇落，鸿飞入杳冥。",
        "空城寒雨细，深院晓灯青。",
        "欲去行人起，徘徊恨酒醒。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 261626,
      "title": "送夏中丞赴宁国任",
      "content": [
        "楚县入青枫，长江一派通。",
        "板桥寻谢客，古邑事陶公。",
        "片雨收山外，连云上汉东。",
        "陆机犹滞洛，念子望南鸿。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261627,
      "title": "送衞雄下第归同州",
      "content": [
        "不才先上第，词客却空还。",
        "边地行人少，平芜尽日闲。",
        "一蝉陂树里，众火陇云间。",
        "羡汝归茅屋，书窗见远山。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261628,
      "title": "送单少府赴扶风",
      "content": [
        "少年趋盛府，颜色比花枝。",
        "范匄非童子，杨修岂小儿。",
        "叨陪丈人行，常恐阿戎欺。",
        "此去云霄近，看君逸足驰。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261629,
      "title": "题山中别业",
      "content": [
        "旧宅在山中，闲门与寺通。",
        "往来黄叶路，交结白头翁。",
        "晚笋难成竹，秋花不满丛。",
        "生涯祗麤粝，吾岂讳言穷。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261630,
      "title": "送司空文明归江上旧居",
      "content": [
        "野菊有黄花，送君千里还。",
        "鸿来燕又去，离别惜容颜。",
        "流水通归梦，行云失故关。",
        "江风正摇落，宋玉莫登山。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261631,
      "title": "送新城戴叔伦明府",
      "content": [
        "遥想隋堤路，春天楚国情。",
        "白云当海断，青草隔淮生。",
        "雁起斜还直，潮回远复平。",
        "莱芜不可到，一醉送君行。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261632,
      "title": "送雍丘任少府",
      "content": [
        "丛车饯才子，路走许东偏。",
        "远水同春色，繁花胜雪天。",
        "鸟行侵楚邑，树影向殷田。",
        "莫学生乡思，梅真正少年。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261633,
      "title": "送雍郢州",
      "content": [
        "厌郎思出守，遂领汉东军。",
        "望月逢殷浩，缘江送范云。",
        "城闲烟草遍，浦逈雪林分。",
        "谁伴楼中宿，吟诗估客闻。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261634,
      "title": "寄王密卿",
      "content": [
        "酒乐今年少，僧期近日频。",
        "买山多为竹，卜宅不缘贫。",
        "志业归初地，文章寄此身。",
        "嵇康虽有病，犹得见情人。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261635,
      "title": "与萧远上人游少华山寄皇甫侍御",
      "content": [
        "寻危兼采药，渡水又登山。",
        "独与高僧去，逍遥落日间。",
        "渐看闾里远，自觉性情闲。",
        "廻首知音在，因令怅望还。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261636,
      "title": "代村中老人答",
      "content": [
        "京洛风尘后，村乡烟火稀。",
        "少年曾失所，衰暮欲何依。",
        "夜静临江哭，天寒踏雪归。",
        "时清应不见，言罢泪盈衣。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261637,
      "title": "赠故将军",
      "content": [
        "平生在边日，鞍马若星流。",
        "独出间千里，相知满九州。",
        "恃功凌主将，作气见王侯。",
        "谁道廉颇老，犹能报远讐。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261638,
      "title": "送陆郎中归田司空幕",
      "content": [
        "汉家分列宿，东土佐诸侯。",
        "结束还军府，光辉过御沟。",
        "农桑连紫陌，分野入青州。",
        "覆被恩难报，西看成白头。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261639,
      "title": "酬晋侍御见寄",
      "content": [
        "野客蒙诗赠，殊恩欲报难。",
        "本求文举识，不在子真官。",
        "细雨双林暮，重阳九日寒。",
        "贫斋一丛菊，愿与上宾看。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261640,
      "title": "送铜泽王归城",
      "content": [
        "昔闻公族出，其从亦高车。",
        "为善唯求乐，分贫必及疎。",
        "身承汉枝叶，手习鲁诗书。",
        "尚说无功德，三年在石渠。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261641,
      "title": "江上别柳中庸",
      "content": [
        "秦人江上见，握手便霑衣。",
        "近日相知少，往年亲故稀。",
        "远游何处去，旧业几时归。",
        "更向巴陵宿，堪闻雁北飞。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261642,
      "title": "喜皇甫郎中拜谕德兼集贤学士",
      "content": [
        "为郎三载后，宠命一朝新。",
        "望苑迁词客，儒林拜丈人。",
        "莺飞绮阁曙，柳拂画堂春。",
        "几日调金鼎，诸君欲望尘。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261643,
      "title": "送黎兵曹往陕府结婚",
      "content": [
        "东方发车骑，君是上头人。",
        "奠雁逢良日，行媒及仲春。",
        "时称渡河妇，宜配坦床宾。",
        "安得同门吏，扬鞭入后尘。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261644,
      "title": "送窦兵曹",
      "content": [
        "梨花开上苑，游女著罗衣。",
        "闻道情人怨，应须走马归。",
        "御桥迟日暖，官渡早莺稀。",
        "莫遣佳期过，看看蝴蝶飞。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261645,
      "title": "留别故人",
      "content": [
        "此别不可道，此心当语谁。",
        "春风灞水上，饮马桃花时。",
        "误作好文士，祗应游宦迟。",
        "留书下朝客，我有故山期。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261646,
      "title": "奉送宋中丞使河源",
      "content": [
        "东周遣戍役，才子欲离群。",
        "部领河源去，悠悠陇水分。",
        "笳声悲塞草，马首渡关云。",
        "辛苦逢炎热，何时及汉军。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261647,
      "title": "都亭驿送郭判官之幽州幕府",
      "content": [
        "幕府参戎事，承明伏奏归。",
        "都亭使者出，杯酒故人违。",
        "细雨霑官骑，轻风拂客衣。",
        "还从大夫后，吾党亦光辉。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261648,
      "title": "送王羽林往秦州",
      "content": [
        "秦州贵公子，汉日羽林郎。",
        "事主来中禁，荣亲上北堂。",
        "輶车花拥路，宝劒雪生光。",
        "直扫三边靖，承恩向建章。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261649,
      "title": "送友入关",
      "content": [
        "闻君帝城去，西望一沾巾。",
        "落日见秋草，暮年逢故人。",
        "非才长作客，有命懒谋身。",
        "近更婴衰疾，空思老汉滨。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261650,
      "title": "代宗挽歌",
      "content": [
        "祖庭三献罢，严衞百灵朝。",
        "警跸移前殿，宫车上渭桥。",
        "寒霜凝羽葆，野吹咽笳箫。",
        "已向新京兆，谁云天路遥。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261651,
      "title": "张左丞挽歌二首 一",
      "content": [
        "素斾低寒水，清笳出晓风。",
        "鸟来伤贾傅，马立葬滕公。",
        "松柏青山上，城池白日中。",
        "一朝今古隔，唯有月明同。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261652,
      "title": "张左丞挽歌二首 二",
      "content": [
        "祸集钩方失，灾生劒忽飞。",
        "无由就日拜，空忆自天归。",
        "门吏看还葬，宫官识赐衣。",
        "东堂哀赠毕，从此故臣稀。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261653,
      "title": "奉和王元二相避暑怀杜太尉",
      "content": [
        "艰难尝共理，海晏更相悲。",
        "况复登堂处，分明避暑时。",
        "绿槐千穗绽，丹药一番迟。",
        "蓬荜今何幸，先朝大雅诗。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261654,
      "title": "青龙寺题故昙上人房",
      "content": [
        "远公留故院，一径雪中微。",
        "童子逢皆老，门人问亦稀。",
        "飜经徒有处，携履遂无归。",
        "空念寻巢鹤，时来傍影飞。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261655,
      "title": "早春夜望",
      "content": [
        "旧雪逐泥沙，新雷发草芽。",
        "晓霜应傍鬓，夜雨莫催花。",
        "行矣前途晚，归欤故国赊。",
        "不劳报春尽，从此惜年华。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261656,
      "title": "宴伊东岸",
      "content": [
        "晴洲无远近，一树一潭春。",
        "芳草留归骑，朱樱掷舞人。",
        "空花对酒落，小翠隔林新。",
        "竟日皆携手，何由遇此辰。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261657,
      "title": "云际中峰居喜见苗发",
      "content": [
        "自得中峰住，深林亦闭关。",
        "经秋无客到，入夜有僧还。",
        "暗涧泉声小，荒村树影闲。",
        "高窗不可望，星月满空山。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261658,
      "title": "宿洞庭",
      "content": [
        "白水连天暮，洪波带日流。",
        "风高云梦夕，月满洞庭秋。",
        "沙上渔人火，烟中贾客舟。",
        "西园与南浦，万里共悠悠。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261659,
      "title": "江上赛神",
      "content": [
        "疎鼓应繁丝，送神归九疑。",
        "苍龙随赤凤，帝子上天时。",
        "骤雨归山疾，长江下日迟。",
        "独怜游宦子，今夜泊天涯。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261660,
      "title": "奉和元丞侍从游南城别业",
      "content": [
        "垂朱领孙子，从宴在池塘。",
        "献寿回龟顾，和羹跃鲤香。",
        "高松先草晚，平石助泉凉。",
        "余橘期相及，门生有陆郎。"
      ],
