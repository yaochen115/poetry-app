{
  "data": [
    {
      "id": 176704,
      "title": "先春亭",
      "content": [
        "园林近铃阁，旦夕被仁风。",
        "自得芳菲早，岂将疏远同。",
        "冰开半塘绿，雨借数枝红。",
        "会待韶光徧，还应到野丛。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176705,
      "title": "寄扬州侯都监",
      "content": [
        "木落淮南树，秋风日夜高。",
        "月临扬子渡，雪卷广陵涛。",
        "不得同萧散，何因破鬰陶。",
        "空凭尺书速，未解夣魂劳。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176706,
      "title": "沉阴欲雪与同列会饮南斋",
      "content": [
        "簿领日沈迷，从容乐事稀。",
        "宾朋幸相值，樽酒不须违。",
        "惨澹愁云积，参差远树微。",
        "淹留勿轻散，待取雪花飞。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176707,
      "title": "感怀",
      "content": [
        "昨日春冰破水边，今朝腊雪坠风前。",
        "歳华过目疾飞鸟，壮志如何不着鞭。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 176708,
      "title": "之美举进士寓京师此诗寄之",
      "content": [
        "结髪声华盛，无疑屈未伸。",
        "何妨久垂翅，从此欲惊人。",
        "鹰击天风壮，鹏飞海浪春。",
        "行当解故褐，不惜化京尘。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176709,
      "title": "风雪数日不见叔度晚约公明共诣之  其一",
      "content": [
        "云雪连朝暗，朋从叹坐违。",
        "临文与谁共，开卷为君稀。",
        "趣扫六花散，聊通一径微。",
        "当携兔园赋，同映读书帏。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176710,
      "title": "风雪数日不见叔度晚约公明共诣之  其二",
      "content": [
        "南荣卮酒罢，君返道东居。",
        "坐作三朝别，杳疑千里余。",
        "闲门嗟雀网，深泞怯柴车。",
        "向晚开帘喜，彤云稍觉疏。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176711,
      "title": "赠吴之才",
      "content": [
        "胜冠自立艰难里，大器由来贵晚成。",
        "松柏傥非生磊落，岩崖何易出峥嵘。",
        "苏秦游困羞妻嫂，主父居贫厌弟兄。",
        "六印佗年拥车骑，会须重过洛阳城。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 176712,
      "title": "寒食许昌道中寄幕府诸君",
      "content": [
        "原上烟芜淡复浓，寂寥佳节思无穷。",
        "竹林近水半边绿，桃树连村一片红。",
        "尽日解鞍山店雨，晚天回首酒旗风。",
        "遥知幕府清明饮，应笑驱驰羁旅中。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 176713,
      "title": "和叔度独登天台水亭",
      "content": [
        "郊外灵潭阔，新亭占曲堤。",
        "戏鱼迎坠絮，惊雉出荒蹊。",
        "绿倒杨梢乱，光飜芰叶齐。",
        "雨余纤月偃，野迥断云低。",
        "水气常喷薄，天风助惨凄。",
        "何知尘外境，近在郡楼西。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 176714,
      "title": "五哀诗 屈平",
      "content": [
        "白玉徒为洁，幽兰未谓芳。",
        "穷羞事令尹，疏不忘怀王。",
        "冤骨消寒渚，忠魂失旧乡。",
        "空余楚辞在，犹与日争光。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176715,
      "title": "五哀诗 李牧",
      "content": [
        "椎牛飨壮士，拔距养奇材。",
        "虏帐方惊避，秦金已暗来。",
        "旌旗移幕府，荆棘蔓丛台。",
        "部曲依稀在，犹能话郭开。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176716,
      "title": "五哀诗 晁大夫",
      "content": [
        "人主恩犹盛，谗夫弄舌端。",
        "旋闻就斧质，不得解衣冠。",
        "反贼齿才冷，谋臣心尽寒。",
        "晁宗噍类尽，汉室泰山安。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176717,
      "title": "五哀诗 马伏波",
      "content": [
        "汉令班南海，蛮兵避鬰林。",
        "天涯柱分界，徼外贡输金。",
        "坐失奸臣意，谁明报国心。",
        "一棺忠勇骨，漂泊瘴烟深。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176718,
      "title": "五哀诗 斛律丞相",
      "content": [
        "君臣日荒宴，歌舞讳言愁。",
        "老相犹当国，强邻不敢谋。",
        "谣言虽未出，奸谤已先流。",
        "谁察忠臣意，通宵抱膝忧。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176719,
      "title": "留别东郡诸僚友  其一",
      "content": [
        "际日浮空涨海流，虫沙龙蜃各优游。",
        "津涯浩荡虽难测，不见惊澜曾覆舟。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 176720,
      "title": "留别东郡诸僚友  其二",
      "content": [
        "白璧紫金为世宝，贤愚知贵莫能名。",
        "庙堂祭器杯盘物，随处得之光彩生。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 176721,
      "title": "留别东郡诸僚友  其三",
      "content": [
        "楚国良金百炼精，深藏求售价连城。",
        "岂徒丰狱吹毛利，兼有秦台照胆明。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 176722,
      "title": "留别东郡诸僚友  其四",
      "content": [
        "祖帐飘扬堤柳边，北来飞盖复连翩。",
        "追随不忍轻言别，逥首城楼没晚烟。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 176723,
      "title": "留别东郡诸僚友  其五",
      "content": [
        "空府同来贤大夫，短亭门外即长涂。",
        "不辞烂醉樽前倒，明日此欢重得无。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 176724,
      "title": "遣兴",
      "content": [
        "京洛红尘里，闭门常独居。",
        "虽无守道愧，终与趣时疏。",
        "文举徒飞表，曹丘懒挟书。",
        "谁怜从宦久，不及策名初。",
        "待兔谋真拙，屠龙艺亦虚。",
        "何当治归计，松菊绕吾庐。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 176725,
      "title": "阍吏",
      "content": [
        "弊车羸马犯尘泥，愁到朱门徧徧辞。",
        "相国舍人难骤见，将军马监岂相知。",
        "因循岁月劳何补，颠倒风埃辱固宜。",
        "惆怅东冈旧陂在，素心空负白云期。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 176726,
      "title": "追和张学士从沂公游广固城",
      "content": [
        "苍鹅集宋幕，游鹿上燕台。",
        "霸气山河尽，王师江汉来。",
        "重围经岁合，严鎻夜深开。",
        "废殿余沙砾，颓墙蘙草莱。",
        "清时间千岁，良牧借三台。",
        "狱市乘余暇，芜城赋上才。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 176727,
      "title": "去岁与东郡幕府诸君同游河亭望太行雪饮酒赋诗今冬罢归京邑怅然有怀",
      "content": [
        "畴昔追清景，狂吟忘苦寒。",
        "河冰塞津口，山雪照林端。",
        "健笔千篇冨，醇醪一醉欢。",
        "困犹挥落麈，瞑不顾归鞍。",
        "多是光阴驶，离群会合难。",
        "谁知尘满袖，今日客长安。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 176728,
      "title": "哭马承之",
      "content": [
        "平生千里别，书问亦常来。",
        "隼拂秋云击，鸾兼霏雾回。",
        "向无高世艺，安见出伦才。",
        "有纸盈箱箧，扃封不忍开。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176729,
      "title": "山家",
      "content": [
        "林下脱双履，窗边挂幅巾。",
        "闲堂风掩户，断岭月窥人。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 176730,
      "title": "风",
      "content": [
        "陇首红旌急，罇前翠幕重。",
        "林端翻远刹，花外转疏钟。",
        "夜寂清机发，春阑别意浓。",
        "如何玉琴韵，并欲在青松。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176731,
      "title": "送王殿丞知眉山县  其一",
      "content": [
        "畴昔侍严亲，俱为彩服人。",
        "游兰已多益，得桂复同春。",
        "风树悲欢异，萍波聚散频。",
        "峡中尽遗事，何处不霑巾。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176732,
      "title": "送王殿丞知眉山县  其二",
      "content": [
        "君行杳何许，万里蜀云西。",
        "野色春期近，林烟晓意迷。",
        "天藏巴峡小，星逼剑关低。",
        "莫使乡愁乱，咬咬信子规。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176733,
      "title": "送朱校理知潍州",
      "content": [
        "东国连年水伤稼，使君到部即行春。",
        "茫茫四野潢污竭，欝欝万行桑柘新。",
        "俗不好奢田器贵，狱无留系吏家贫。",
        "齐人忽怨归朝速，自是承明侍从臣。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 176734,
      "title": "贡院中戏从元礼求酒",
      "content": [
        "顾我虚罍耻，知君余沥多。",
        "庭前有春雪，如此薄寒何。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 176735,
      "title": "黄甘",
      "content": [
        "黄金缀缥蒂，摇落楚江涯。",
        "采助杯盘胜，羞将橘柚偕。",
        "时移香不变，物远味尤佳。",
        "欲种沧洲树，何年此意谐。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176736,
      "title": "寒食南宫夜饮",
      "content": [
        "积旬留省署，容易度春华。",
        "芳草踏青晚，长楸行乐賖。",
        "云疏时送雨，风细暗飞花。",
        "直有黄金百，无因过酒家。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176737,
      "title": "送孟著作知济阴",
      "content": [
        "圣主焦劳意，谁云百里轻。",
        "东州比灾害，剧令选精明。",
        "水去良田阔，人归旅糓生。",
        "闾阎还旧观，鸡犬变新声。",
        "盗散疲民活，奸穷老吏惊。",
        "政成知不日，双耳为君倾。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 176738,
      "title": "同宋次道陪䜩琼林",
      "content": [
        "冠盖连翩数里尘，帝家全借上林春。",
        "鹓行不动烟霞秀，龙角正高雷雨新。",
        "喜气晴曛宫树绿，飞花醉堕玉巵频。",
        "蒲萄卢橘应相识，半是当年举酒人。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 176739,
      "title": "送冯状元归鄂州",
      "content": [
        "夙昔负奇节，琅然为众殊。",
        "下鞲连得俊，出手尽成卢。",
        "喜气兼邻曲，荣名溢道涂。",
        "风云俱动色，非复旧江湖。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176740,
      "title": "送吴耿先生",
      "content": [
        "儒服若烟海，几人潜圣心。",
        "难才成自昔，贱学况于今。",
        "夫子独神解，明时何陆沉。",
        "大羮无和味，至乐寡知音。",
        "磳磴貂裘弊，飘萧鹤发侵。",
        "游秦不得意，思越动长吟。",
        "甑米难求玉，经囊益少金。",
        "拂衣谢宾友，纵棹指云岑。",
        "积叶迷幽迳，荒藤络旧林。",
        "涧猿惊重至，野老喜相寻。",
        "山色犹当户，弦声不变琴。",
        "人生贵适意，何必慕华簪。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 176741,
      "title": "送高陟归金陵",
      "content": [
        "之子秣陵去，悠悠天堑东。",
        "帆开晓风疾，潮落夜江空。",
        "在昔才华盛，至今人物丰。",
        "山川气虽尽，龙虎势犹雄。",
        "卞玉已三献，齐禽会一冲。",
        "当令关下吏，洗目认终童。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 176742,
      "title": "子高有徐浩诗碑昌言借摹其文甫及数本石有微衅惧而归之子高答简有碎珊瑚之戏昌言以诗赠子高同舍皆和",
      "content": [
        "徐公精笔老生神，石刻犹能妙夺真。",
        "几为通书翻丧宝，愈令好事惜传人。",
        "锋铓半折犹能健，圭璧微瑕自足珍。",
        "直使尽随如意碎，石家玉树未全贫。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 176743,
      "title": "京送僧聪归蜀",
      "content": [
        "翠柏老精舍，红尘倦帝城。",
        "千山一锡远，万里片云轻。",
        "江栈纡还直，天星纵复横。",
        "听猿应更喜，还是故乡声。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176744,
      "title": "送史馆任祠部河东转运使",
      "content": [
        "问望簪绅旧，恩华雨露重。",
        "图书周内史，汾浍晋全封。",
        "秀发千寻壁，寒生百炼锋。",
        "归时门有戟，惜别更从容。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176745,
      "title": "送冲卿通判河中府",
      "content": [
        "闻道名都行有期，依然想见昔游时。",
        "寒光一曲秋河转，翠岭三条夕照移。",
        "孤竹旧风民有让，重华余教俗无疵。",
        "不须到日方登历，已在君家十二诗。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 176746,
      "title": "故翰林彭学士挽歌  其一",
      "content": [
        "夙昔游清贯，时流籍重名。",
        "讐书石渠秘，视草玉堂荣。",
        "吉兆虚三鱓，凶期告两楹。",
        "子云思故国，坟树必西倾。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176747,
      "title": "故翰林彭学士挽歌  其二",
      "content": [
        "平生对交旧，万日正如初。",
        "不复知荣贱，都能忘戚疏。",
        "遗灵瞻素几，伪物屏涂车。",
        "家事何萧索，空余万卷书。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176748,
      "title": "故翰林彭学士挽歌  其三",
      "content": [
        "祖奠垂将撤，笳箫俨欲行。",
        "野寒嘶故马，树转出新旌。",
        "泉路幽无底，鱼灯暧不明。",
        "如何赍美志，鬰鬰向佳城。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176749,
      "title": "景福东厢诗 夜意",
      "content": [
        "清夜四无哗，深严上帝家。",
        "星翻珠网白，斗挂玉楼斜。",
        "风静虚成韵，霜轻未作花。",
        "还疑汉津客，浩荡寄流槎。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176750,
      "title": "景福东厢诗 即日",
      "content": [
        "枍栺留深殿，仓琅秘九门。",
        "日长人对直，风迥鷰高翻。",
        "林有萧疏意，云无片缕痕。",
        "钧天真自到，不独暂飞魂。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176751,
      "title": "景福东厢诗 柏",
      "content": [
        "落落抱高节，秀出青云端。",
        "无言磵谷幽，自致宫庭难。",
        "芳风袭玉宇，余露分铜槃。",
        "不使万年木，嘉名高歳寒。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176752,
      "title": "御沟",
      "content": [
        "万户鬰相钩，枝分瑟瑟流。",
        "萦纡通桂观，隐见带龙楼。",
        "碧映千林曙，红飘一叶秋。",
        "寒波长不竭，歳歳奉宸游。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176753,
      "title": "御沟 赐酒",
      "content": [
        "和气盈金榼，恩光湛玉觞。",
        "应知北山羽，犹怯上林霜。",
        "醇味回秋色，清都近醉乡。",
        "山茅霑雨露，誓极寸心长。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176754,
      "title": "御沟 菊",
      "content": [
        "琐琐南阳菊，秋潭歳自开。",
        "孤根拥红叶，落蘂媚苍苔。",
        "正以参灵药，因之植紫台。",
        "愿兼金掌露，同入柏梁杯。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176755,
      "title": "御沟 同范景仁寄修书诸同舍",
      "content": [
        "烈火非不猛，不耗百炼金。",
        "寒霜非不严，不雕竹柏林。",
        "小人势利合，倾覆无常心。",
        "君子道德亲，白首犹视今。",
        "诸君闺台秀，相得如璆琳。",
        "离群一昔期，乃尔动悲吟。",
        "古风久已衰，交道日颓侵。",
        "愿名思友操，播之清徽琴。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 176756,
      "title": "御沟 赐果",
      "content": [
        "南海荔枝来，别馆蒲萄成。",
        "匪颁浃下陈，捧拜同驩荣。",
        "置黍敢先食，览槃多未名。",
        "怀核待归种，复愁千歳生。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176757,
      "title": "御沟 赐书",
      "content": [
        "上圣固天纵，英艺皆绝伦。",
        "时乘万几闲，翰动如有神。",
        "用之当豫游，不忘安四民。",
        "匪颁及群下，络绎来中宸。",
        "毰毸灵鳯翔，鬰怒虬龙振。",
        "清若四海秋，熙如天下春。",
        "愚臣土芥微，亦受雨露均。",
        "愿推赐书意，直以古义陈。",
        "士本学先王，所求谊与仁。",
        "农当服稼穯，昏作甽亩勤。",
        "百工备用器，不治刺绣文。",
        "万商迁有无，不通珠翠珍。",
        "四业既交修，坐令风化纯。",
        "人和衣食丰，天应殊祥臻。",
        "皇心正在此，非以能高人。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 176758,
      "title": "御沟 怪石",
      "content": [
        "昔去江湖乡，来与松桂接。",
        "圭角老龙脊，锋棱秋剑铗。",
        "历乱枯苔点，交横败莎叶。",
        "会使成都人，更取神蓍揲。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176759,
      "title": "御沟 未开木芙蓉",
      "content": [
        "木末采芙蓉，骚人歌所无。",
        "何言霜花艳，不与水芝殊。",
        "香苞麝脐结，茂叶桐阴敷。",
        "岂若龟巢类，飘零老五湖。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176760,
      "title": "御沟 读武士策",
      "content": [
        "汉家求猛士，云集未央宫。",
        "天外朝星淡，山西将种空。",
        "奇谋纷并进，壮节凛生风。",
        "八阵纵横势，依然见目中。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176761,
      "title": "御沟 观试骑射",
      "content": [
        "阊阖风正清，觚棱日初媚。",
        "材雄集便殿，玉座亲临视。",
        "三河侠少儿，初识天子贵。",
        "天山汗血骝，蹀躞金镮辔。",
        "扬鞭秋云高，顾盼有余锐。",
        "萦回势可观，罄控动如志。",
        "毫厘应心目，审固参身臂。",
        "鸣弦电雹惊，寸的冰瓦碎。",
        "龙颜薄笑春，喜色连傍侍。",
        "旦为徒步人，暮作彯缨使。",
        "扬扬出九门，亲友生意气。",
        "须知天地德，慎勿忘所自。",
        "黠羌犹旅拒，猃狁方繁炽。",
        "求为忠义臣，无负搜罗意。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 176762,
      "title": "喜景仁直秘阁",
      "content": [
        "延阁屹中天，积书云汉连。",
        "神宗重其选，国士此为偏。",
        "夫子岷嶓秀，声名俊造先。",
        "清标峻不极，胜气驶无前。",
        "待价犹怀璧，临岐肯著鞭。",
        "介推不求显，张季久方迁。",
        "玉槛钩陈上，丹梯北斗边。",
        "帝容瞻日角，宸翰照星躔。",
        "职秩曾无贵，光华在得贤。",
        "公卿殊未晚，尚少买臣年。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 176763,
      "title": "兴宗许菊久之未得",
      "content": [
        "菊栽许送定如何，庭下不堪秋草多。",
        "九日无花更无酒，便携藜杖直相过。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 176764,
      "title": "得菊并诗",
      "content": [
        "黄花小墢和烟𣃁，野兴萧萧已相逐。",
        "同来更得兼诗句，久立看诗忘栽菊。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 176765,
      "title": "送史馆唐祠部江南西路转运使",
      "content": [
        "豪杰争唐鹿，江南号富强。",
        "明时虽混一，余俗尚雕伤。",
        "税版诛求急，词曹牒诉忙。",
        "皇心愍颓弊，使节付才良。",
        "贫吏先投绂，奸民尽越乡。",
        "闾阎无插笔，田亩有栖粮。",
        "汉阁归期阔，隋河去驿长。",
        "风高片帆疾，钲鼓入秋光。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 176766,
      "title": "送张寺丞知富顺监",
      "content": [
        "汉家五尺道，置吏抚南夷。",
        "欲使文翁教，兼令孟获知。",
        "盘羞蒟酱实，歌杂竹枝辞。",
        "取酒须勤醉，乡关不可思。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176767,
      "title": "寄题李舍人蒲中新斋",
      "content": [
        "陇上家声勇气殊，边庭卧鼓欲安居。",
        "非同王翦私求宅，更似甘宁晚好书。",
        "剑倚寒窗风淅沥，门无杂客柳萧疏。",
        "蒲州风土平生爱，为问旁邻地有余。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 176768,
      "title": "赠太子太傅康靖李公挽歌词二首  其一",
      "content": [
        "黄髪今雕丧，苍生欲奈何。",
        "散金才极乐，曳杖已成歌。",
        "十郡余恩在，三台故吏多。",
        "位崇仍有后，五福更为多。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176769,
      "title": "赠太子太傅康靖李公挽歌词二首  其二",
      "content": [
        "卤簿去悠悠，西郊乱叶秋。",
        "旐翻寒日薄，笳咽断云愁。",
        "吊客门飞鹤，佳城山卧牛。",
        "灵车今不返，洧水日东流。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176770,
      "title": "送二同年使北 吕济叔",
      "content": [
        "华缨下玉除，天子宠匈奴。",
        "虽复夷风陋，犹知汉使殊。",
        "夜烽沈不举，秋柝寂无虞。",
        "何必燕然刻，苍生肝脑涂。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176771,
      "title": "送二同年使北 李公素",
      "content": [
        "云愁雪欲零，四牡出郊坰。",
        "古塞烟华紫，寒沙日气青。",
        "金门秘鸡树，朱节燿龙庭。",
        "几夜天街北，遥占汉使星。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176772,
      "title": "昌言有咏石髪诗三章模写精楷殆难复加仆虽未睹兹物而已若识之久者辄复强为三诗以继其后非敢庶几肩差适足为前诗之舆台耳  其一",
      "content": [
        "万古风涛浸石岩，老苔垂足细䰐𩭹。",
        "传闻海底珠无数，何事从来散不簪。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 176773,
      "title": "昌言有咏石髪诗三章模写精楷殆难复加仆虽未睹兹物而已若识之久者辄复强为三诗以继其后非敢庶几肩差适足为前诗之舆台耳  其二",
      "content": [
        "金阙银城仙客居，欲传消息问麻姑。",
        "蓬莱无物堪为信，剪寄苍龙一握须。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 176774,
      "title": "昌言有咏石髪诗三章模写精楷殆难复加仆虽未睹兹物而已若识之久者辄复强为三诗以继其后非敢庶几肩差适足为前诗之舆台耳  其三",
      "content": [
        "琅菜来从若木边，非膏非沐绿宛延。",
        "玉盘委积羞佳客，不是陶家无馔钱。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 176775,
      "title": "送沈寺丞知南昌县",
      "content": [
        "长江湛湛带枫林，古木寒云县寺深。",
        "老吏不能容狡狯，细民无复有冤侵。",
        "洪崖丹井闻犹在，徐孺衡门说可寻。",
        "宁复淹留如宝剑，更令牛斗气沈沈。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 176776,
      "title": "酬不疑雪中书怀见寄",
      "content": [
        "直道免三黜，敢云羞小官。",
        "盘餐红粟涩，衣桁黑貂寒。",
        "画府容身易，侯门曲意难。",
        "荆扉盈尺雪，有客问袁安。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176777,
      "title": "答师道对雪见寄",
      "content": [
        "阴风一夕惊，晓雪满都城。",
        "气覆千家白，光连万象清。",
        "恋空飞不下，弄态舞相萦。",
        "历乱看无定，飘飖转未成。",
        "缀垣时缺剥，压竹乍欹倾。",
        "细隙过无滞，寒窗拂有声。",
        "园林匀结练，观阁巧雕琼。",
        "草木情先喜，乾坤意亦荣。",
        "营魂顿疏健，病目暂虚明。",
        "郢曲高谁和，羞将叩缶并。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 176778,
      "title": "送王校理守瑯琊",
      "content": [
        "金门倦鸣玉，千骑出东方。",
        "封略依沧海，枌榆近故乡。",
        "秦碑苔蚀字，鄅稻日翻芒。",
        "国吏遥应识，当年丞相郎。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176779,
      "title": "哭尚颍",
      "content": [
        "操业五常备，艰难六极全。",
        "仲尼难语命，禆灶不知天。",
        "弱女飘何许，遗文散莫传。",
        "官轻史不录，后世孰称贤。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176780,
      "title": "故侍读学士张公哀辞二首  其一",
      "content": [
        "喜愠与荣枯，居之悉晏如。",
        "稍门多执笔，至老不抛书。",
        "常愧无能极，曾霑清论余。",
        "秋风郭门外，雨泣望丧车。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176781,
      "title": "故侍读学士张公哀辞二首  其二",
      "content": [
        "凶梦歌洹水，妖巢集戴鵀。",
        "未尝余俸禄，无以具衣衾。",
        "袁涣分仓谷，翁归赐府金。",
        "佗年纯固传，宁使令名沈。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176782,
      "title": "钱子高挽歌二首  其一",
      "content": [
        "炜烨传家学，连翩射策荣。",
        "走丸过省阁，破竹取公卿。",
        "埋玉嗟何早，为山惜未成。",
        "空令泽宫友，相顾泪纵横。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176783,
      "title": "钱子高挽歌二首  其二",
      "content": [
        "象设如平昔，升堂不见君。",
        "尚疑言笑在，忽念死生分。",
        "清论千秋雪，浮荣一片云。",
        "泉台多少路，何处复修文。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176784,
      "title": "题杨中正供奉洗心堂",
      "content": [
        "阀阅盛山西，朱门飏戟衣。",
        "雅知名教乐，深笑宴游非。",
        "一室琴书隘，三年园圃稀。",
        "异时论事业，肯复让轻肥。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176785,
      "title": "送龚章判官之衞州",
      "content": [
        "几砚昔年游，于今成十秋。",
        "松坚终发石，鱼变即辞流。",
        "近郡无飞檄，清时不借筹。",
        "淇园春竹美，军宴日椎牛。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176786,
      "title": "送王瓘同年河南府司录",
      "content": [
        "彩服昔为儿，随亲宦洛师。",
        "至今余梦想，常记旧游嬉。",
        "佐史头应白，书楼树已欹。",
        "闻君行有日，使我泪交颐。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176787,
      "title": "送王彦臣同年通判亳州",
      "content": [
        "先朝御六飞，亲谒濑乡祠。",
        "牛酒当时惠，衣冠此日思。",
        "仙踪丹有灶，天瑞桧生枝。",
        "圣主怜耆旧，题舆得吏师。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176788,
      "title": "正月二十四日夜雪",
      "content": [
        "叠瓦浮轻雪，参差粉画难。",
        "苦欺初变柳，故压未生兰。",
        "夜色微分白，春容不受寒。",
        "即为花卉夺，犹得暂供看。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176789,
      "title": "和道粹雪夜直宿",
      "content": [
        "天禄凝严近紫台，书帏夜对雪华开。",
        "层楼直倚寒空出，清漏还从深殿来。",
        "薄梦不成冰柱折，晓光先到玉花催。",
        "兔园终是诸侯事，虚费相如能赋才。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 176790,
      "title": "和次道大庆殿上元迎驾",
      "content": [
        "凤律年华到尚新，九重气象已成春。",
        "晓云低拂羽林仗，宿雨先清紫陌尘。",
        "玉殿鸣鞘传警跸，彤庭委珮集簪绅。",
        "阙前无复鱼龙戏，自有驩谣亿万人。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 176791,
      "title": "送茹屯田知无为军",
      "content": [
        "叠鼓鸣铙迎候新，军牙孑孑倚淮津。",
        "聊应衣绣过乡曲，不作引章惊故人。",
        "荻迸短芽淝水暖，荷浮圆叶漅湖春。",
        "使君此去荣多少，犹是当年书剑身。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 176792,
      "title": "田横墓",
      "content": [
        "昔时南面并称孤，今日还为绛灌徒。",
        "忍死祗能添屈辱，偷生不足爱须臾。",
        "一朝从殉倾群客，千古生风激懦夫。",
        "直使强颜臣汉帝，韩彭未必免同诛。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 176793,
      "title": "登平陆北山回瞰陜城奉寄李八丈学士使君二十二韵",
      "content": [
        "汉家二千石，体望向来尊。",
        "况复严徐客，从前益稷孙。",
        "公侯贵不绝，礼乐器长存。",
        "符竹临分陜，声光应列藩。",
        "亲闱先契重，子舍近交敦。",
        "柏垄依仁域，棠阴接故园。",
        "怀归聊露请，予告入推恩。",
        "荷祋烦彊候，停车下郡门。",
        "帷𪪞纷大馆，驺骑屈朱轓。",
        "不以黎苗待，还将臭味论。",
        "森罗牢礼重，灭裂俗仪烦。",
        "霜霁威严息，春生笑语温。",
        "草微侵碧甃，尘不染华轩。",
        "日影摇云栋，风痕过玉樽。",
        "落尘歌迥出，激楚褏双翻。",
        "雅戏象交局，珍肴熊荐蹯。",
        "河梁俄首路，汾曲访吹埙。",
        "举手辞双戟，腾装改北辕。",
        "乌飞城树晓，鴈泊野芜暄。",
        "耿耿清标阔，涔涔宿酒昏。",
        "百蟠萦阪道，数里豁川原。",
        "跋马风烟外，依稀鼓吹喧。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
