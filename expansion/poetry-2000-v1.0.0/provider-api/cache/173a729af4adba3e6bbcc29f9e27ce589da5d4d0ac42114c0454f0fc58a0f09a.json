      }
    },
    {
      "id": 176801,
      "title": "送峡州陈廉秘丞  其一",
      "content": [
        "宜都贤太守，治迹古人齐。",
        "虎负众子去，凤环群鸟栖。",
        "行增颍川秩，别降武都泥。",
        "正恐还朝速，春林未子规。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176802,
      "title": "送峡州陈廉秘丞  其二",
      "content": [
        "郡府猿声外，旌旗鸟道边。",
        "楼高出楚塞，烟霁识巴船。",
        "襦袴嗟来暮，簪绅惜外迁。",
        "皇仁矜远俗，非谓意疏贤。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
