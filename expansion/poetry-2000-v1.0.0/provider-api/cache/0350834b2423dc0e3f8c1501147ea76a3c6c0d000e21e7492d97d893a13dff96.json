{
  "data": [
    {
      "id": 277289,
      "title": "送使广州",
      "content": [
        "家在湘源住，君今海峤行。",
        "经过正中道，相送倍为情。",
        "心逐书邮去，形随世网婴。",
        "因声谢远别，缘义不缘名。"
      ],
      "author": {
        "id": 6652,
        "name": "张九龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 277290,
      "title": "送姚评事入蜀各赋一物得卜肆",
      "content": [
        "蜀严化已久，沈冥空所思。",
        "尝闻卖卜处，犹忆下帘时。",
        "驱传应经此，怀贤倘问之。",
        "归来说往事，历历偶心期。"
      ],
      "author": {
        "id": 6652,
        "name": "张九龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 277291,
      "title": "送窦校书见饯得云中辨江树",
      "content": [
        "江水天连色，无涯净野氛。",
        "微明岸傍树，凌乱渚前云。",
        "举棹形徐转，登舻意渐分。",
        "渺茫从此去，空复惜离群。"
      ],
      "author": {
        "id": 6652,
        "name": "张九龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 277292,
      "title": "饯王司马入计同用洲字",
      "content": [
        "元僚行上计，举饯出林丘。",
        "忽望题舆远，空思解榻游。",
        "别筵铺柳岸，征棹倚芦洲。",
        "独叹湘江水，朝宗向北流。"
      ],
      "author": {
        "id": 6652,
        "name": "张九龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 277293,
      "title": "东湖临泛饯王司马",
      "content": [
        "南土秋虽半，东湖草未黄。",
        "聊乘风日好，来泛芰荷香。",
        "兰棹无劳速，菱歌不厌长。",
        "忽怀京洛去，难与共清光。"
      ],
      "author": {
        "id": 6652,
        "name": "张九龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 277294,
      "title": "饯济阴梁明府各探一物得荷叶",
      "content": [
        "荷叶生幽渚，芳华信在兹。",
        "朝朝空此地，采采欲因谁。",
        "但恐星霜改，还将蒲稗衰。",
        "怀君美人别，聊以赠心期。"
      ],
      "author": {
        "id": 6652,
        "name": "张九龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 277295,
      "title": "饯陈学士还江南同用征字",
      "content": [
        "荷𦰏旋江澳，衔杯饯霸陵。",
        "别前林鸟息，归处海烟凝。",
        "风土乡情接，云山客念凭。",
        "圣朝岩穴选，应待鹤书征。"
      ],
      "author": {
        "id": 6652,
        "name": "张九龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 277296,
      "title": "通化门外送别",
      "content": [
        "屡别容华改，长愁意绪微。",
        "义将私爱隔，情与故人归。",
        "薄宦无时赏，劳生有事机。",
        "离魂今夕梦，先绕旧林飞。"
      ],
      "author": {
        "id": 6652,
        "name": "张九龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 277297,
      "title": "送杨道士往天台",
      "content": [
        "鬼谷还成道，天台去学仙。",
        "行应松子化，留与世人传。",
        "此地烟波远，何时羽驾旋？",
        "当须一把袂，城郭共依然。"
      ],
      "author": {
        "id": 6652,
        "name": "张九龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 277298,
      "title": "送杨府李功曹",
      "content": [
        "平生属良友，结绶望光辉。",
        "何知人事拙，相与宦情非。",
        "别路穿林尽，征帆际海归。",
        "居然已多意，况复两乡违。"
      ],
      "author": {
        "id": 6652,
        "name": "张九龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 277299,
      "title": "送宛句赵少府",
      "content": [
        "解巾行作吏，尊酒谢离居。",
        "修竹含清景，华池澹碧虚。",
        "地将幽兴惬，人与旧游疎。",
        "林下纷相送，多逢长者车。"
      ],
      "author": {
        "id": 6652,
        "name": "张九龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 277300,
      "title": "送韦城李少府",
      "content": [
        "送客南昌尉，离亭西候春。",
        "野花看欲尽，林鸟听犹新。",
        "别酒青门路，归轩白马津。",
        "相知无远近，万里尚为邻。"
      ],
      "author": {
        "id": 6652,
        "name": "张九龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 277301,
      "title": "送苏主簿赴偃师",
      "content": [
        "我与文雄别，胡然邑吏归。",
        "贤人安下位，鸷鸟欲卑飞。",
        "激节轻华冕，移官徇彩衣。",
        "羡君行乐处，从此拜庭闱。"
      ],
      "author": {
        "id": 6652,
        "name": "张九龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 277302,
      "title": "送广州周判官",
      "content": [
        "海郡雄蛮落，津亭壮越台。",
        "城隅百雉映，水曲万家开。",
        "里树桄榔出，时禽翡翠来。",
        "观风犹未尽，早晚使车回。"
      ],
      "author": {
        "id": 6652,
        "name": "张九龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 277303,
      "title": "郡江南上别孙侍御",
      "content": [
        "云嶂天涯尽，川途海县穷。",
        "何言此地僻，忽与故人同。",
        "身负邦君弩，情纡御史骢。",
        "王程不我驻，离思逐秋风。"
      ],
      "author": {
        "id": 6652,
        "name": "张九龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 277304,
      "title": "道逢北使题赠京邑亲知",
      "content": [
        "征骖稍靡靡，去国方迟迟。",
        "路遶南登岸，情摇北上旗。",
        "故人怜别日，旅雁逐归时。"
      ],
      "author": {
        "id": 6652,
        "name": "张九龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 277305,
      "title": "江上使风呈裴宣州耀卿",
      "content": [
        "江路与天连，风帆何淼然。",
        "遥林浪出没，孤舫鸟联翩。",
        "常爱千钧重，深思万事捐。",
        "报恩非徇禄，还逐贾人船。"
      ],
      "author": {
        "id": 6652,
        "name": "张九龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 277306,
      "title": "溪行寄王震",
      "content": [
        "山气朝来爽，溪流日向清。",
        "远心何处惬，闲棹此中行。",
        "丛桂林间待，群鸥水上迎。",
        "徒然适我愿，幽独为谁情。"
      ],
      "author": {
        "id": 6652,
        "name": "张九龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 277307,
      "title": "自豫章南还江上作",
      "content": [
        "归去南江水，磷磷见底清。",
        "转逢空阔处，聊洗滞留情。",
        "浦树遥如待，江鸥近若迎。",
        "津途别有趣，况乃濯吾缨。"
      ],
      "author": {
        "id": 6652,
        "name": "张九龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 277308,
      "title": "将至岳阳有怀赵二",
      "content": [
        "湘岸多深林，青冥昼结阴。",
        "独无谢客赏，况复贾生心。",
        "草色虽云发，天光或未临。",
        "江潭非所遇，为尔白头吟。"
      ],
      "author": {
        "id": 6652,
        "name": "张九龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 277309,
      "title": "使还湘水",
      "content": [
        "归舟宛何处，正值楚江平。",
        "夕逗烟村宿，朝缘浦树行。",
        "于役已弥岁，言旋今惬情。",
        "乡郊尚千里，流目夏云生。"
      ],
      "author": {
        "id": 6652,
        "name": "张九龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 277310,
      "title": "初发道中寄远",
      "content": [
        "日夜乡山远，秋风复此时。",
        "旧闻胡马思，今听楚猿悲。",
        "念别朝昏苦，怀归岁月迟。",
        "壮图空不息，常恐发如丝。"
      ],
      "author": {
        "id": 6652,
        "name": "张九龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 277311,
      "title": "自湘水南行",
      "content": [
        "落日摧行舫，逶迤洲渚间。",
        "虽云有物役，乘此更休闲。",
        "暝色生前浦，清晖发近山。",
        "中流澹容与，唯爱鸟飞还。"
      ],
      "author": {
        "id": 6652,
        "name": "张九龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 277312,
      "title": "初入湘中有喜",
      "content": [
        "征鞍穷郢路，归棹入湘流。",
        "望鸟唯贪疾，闻猿亦罢愁。",
        "两边枫作岸，数处橘为洲。",
        "却记从来意，翻疑梦里游。"
      ],
      "author": {
        "id": 6652,
        "name": "张九龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 277313,
      "title": "耒阳溪夜行",
      "content": [
        "乘夕棹归舟，缘源路转幽。",
        "月明看岭树，风静听溪流。",
        "岚气船间入，霜华衣上浮。",
        "猿声虽此夜，不是别家愁。"
      ],
      "author": {
        "id": 6652,
        "name": "张九龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 277314,
      "title": "江上",
      "content": [
        "长林何缭绕，远水复悠悠。",
        "尽日余无见，为心那不愁。",
        "忆将亲爱别，行为主恩酬。",
        "感激空如此，芳时屡已遒。"
      ],
      "author": {
        "id": 6652,
        "name": "张九龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 277315,
      "title": "自彭蠡湖初入江",
      "content": [
        "江岫殊空阔，云烟处处浮。",
        "上来群噪鸟，中去独行舟。",
        "牢落谁相顾，逶迤日自愁。",
        "更将心问影，于役复何求。"
      ],
      "author": {
        "id": 6652,
        "name": "张九龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 277316,
      "title": "赴使泷峡",
      "content": [
        "溪路日幽深，寒空入两嵚。",
        "霜清百丈水，风落万重林。",
        "夕鸟联归翼，秋猿断去心。",
        "别离多远思，况乃岁方阴。"
      ],
      "author": {
        "id": 6652,
        "name": "张九龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 277317,
      "title": "湖口望庐山瀑布泉",
      "content": [
        "万丈洪泉落，迢迢半紫氛。",
        "奔飞流杂树，洒落出重云。",
        "日照虹蜺似，天清风雨闻。",
        "灵山多秀色，空水共氤氲。"
      ],
      "author": {
        "id": 6652,
        "name": "张九龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 277318,
      "title": "浈阳峡",
      "content": [
        "行舟傍越岑，窈窕越溪深。",
        "水暗先秋冷，山晴当昼阴。",
        "重林间五色，对壁耸千寻。",
        "惜此生遐远，谁知造化心。"
      ],
      "author": {
        "id": 6652,
        "name": "张九龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 277319,
      "title": "使至广州",
      "content": [
        "昔年尝不调，兹地亦邅回。",
        "本谓双凫少，何知驷马来。",
        "人非汉使橐，郡是越王台。",
        "去去虽殊事，山川长在哉。"
      ],
      "author": {
        "id": 6652,
        "name": "张九龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 277320,
      "title": "春江晚景",
      "content": [
        "江林多秀发，云日复相鲜。",
        "征路那逢此，春心益渺然。",
        "兴来秪自得，佳气莫能传。",
        "薄暮津亭下，余花满客船。"
      ],
      "author": {
        "id": 6652,
        "name": "张九龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 277321,
      "title": "与王六履震广州津亭晓望",
      "content": [
        "明发临前渚，寒来净远空。",
        "水纹天上碧，日气海边红。",
        "景物纷为异，人情赖此同。",
        "乘槎自有适，非欲破长风。"
      ],
      "author": {
        "id": 6652,
        "name": "张九龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 277322,
      "title": "初发曲江溪中",
      "content": [
        "溪流清且深，松石复阴临。",
        "正尔可嘉处，胡为无赏心。",
        "我由不忍别，物亦有缘侵。",
        "自匪常行迈，谁能知此音。"
      ],
      "author": {
        "id": 6652,
        "name": "张九龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 277323,
      "title": "旅宿淮阳亭口号",
      "content": [
        "日暮荒亭上，悠悠旅思多。",
        "故乡临桂水，今夜渺星河。",
        "暗草霜华发，空亭雁影过。",
        "兴来谁与晤，劳者自为歌。"
      ],
      "author": {
        "id": 6652,
        "name": "张九龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 277324,
      "title": "望月怀远",
      "content": [
        "海上生明月，天涯共此时。",
        "情人怨遥夜，竟夕起相思。",
        "灭烛怜光满，披衣觉露滋。",
        "不堪盈手赠，还寝梦佳期。"
      ],
      "author": {
        "id": 6652,
        "name": "张九龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 277325,
      "title": "秋夕望月",
      "content": [
        "清逈江城月，流光万里同。",
        "所思如梦里，相望在庭中。",
        "皎洁青苔露，萧条黄叶风。",
        "含情不得语，频使桂华空。"
      ],
      "author": {
        "id": 6652,
        "name": "张九龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 277326,
      "title": "咏燕",
      "content": [
        "海燕何微眇，乘春亦𫏐来。",
        "岂知泥滓贱，秪见玉堂开。",
        "绣户时双入，华轩日几回。",
        "无心与物竞，鹰隼莫相猜。"
      ],
      "author": {
        "id": 6652,
        "name": "张九龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 277327,
      "title": "故刑部李尚书荆谷山集会",
      "content": [
        "尝闻继老耼，身退道弥耽。",
        "结宇倚青壁，疎泉喷碧潭。",
        "苔石随人古，烟花寄酒酣。",
        "山光纷向夕，归兴杜城南。"
      ],
      "author": {
        "id": 6652,
        "name": "张九龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 277328,
      "title": "戏题春意",
      "content": [
        "一作江南守，江林三四春。",
        "相鸣不及鸟，相乐喜关人。",
        "日守朱丝直，年催华发新。",
        "淮阳秪有卧，持此度芳辰。"
      ],
      "author": {
        "id": 6652,
        "name": "张九龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 277329,
      "title": "庭梅咏",
      "content": [
        "芳意何能早，孤荣亦自危。",
        "更怜花蔕弱，不受岁寒移。",
        "朝雪那相妬，阴风已屡吹。",
        "馨香虽尚尔，飘荡复谁知。"
      ],
      "author": {
        "id": 6652,
        "name": "张九龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 277330,
      "title": "听筝",
      "content": [
        "端居正无绪，那复发秦筝。",
        "纤指传新意，繁弦起怨情。",
        "悠扬思欲绝，掩抑态还生。",
        "岂是声能感，人心自不平。"
      ],
      "author": {
        "id": 6652,
        "name": "张九龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 277331,
      "title": "初秋忆金均两弟",
      "content": [
        "江渚秋风至，他乡离别心。",
        "孤云愁自远，一叶感何深。",
        "忧喜尝同域，飞鸣忽异林。",
        "青山西北望，堪作白头吟。"
      ],
      "author": {
        "id": 6652,
        "name": "张九龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 277332,
      "title": "秋怀",
      "content": [
        "感惜芳时换，谁知客思悬。",
        "忆随鸿向煖，愁学马思边。",
        "留滞机还息，纷拏网自牵。"
      ],
      "author": {
        "id": 6652,
        "name": "张九龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 277333,
      "title": "故刑部李尚书挽词三首 一",
      "content": [
        "仙宗出赵北，相业起山东。",
        "明德尝为礼，嘉谋屡作忠。",
        "论经白虎殿，献赋甘泉宫。",
        "与善今何在？",
        "苍生望已空。"
      ],
      "author": {
        "id": 6652,
        "name": "张九龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 277334,
      "title": "故刑部李尚书挽词三首 二",
      "content": [
        "宿昔三台践，荣华驷马归。",
        "印从青琐拜，翰入紫宸挥。",
        "题剑恩方重，藏舟事已非。",
        "龙门不可望，感激涕沾衣。"
      ],
      "author": {
        "id": 6652,
        "name": "张九龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 277335,
      "title": "故刑部李尚书挽词三首 三",
      "content": [
        "永叹常山宝，沈埋京兆阡。",
        "同盟会五月，华表记千年。",
        "渺漫野中草，微茫空里烟。",
        "共悲人事绝，唯对杜陵田。"
      ],
      "author": {
        "id": 6652,
        "name": "张九龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 277336,
      "title": "故徐州刺史赠吏部侍郎苏公挽歌词三首 一",
      "content": [
        "韦玄方继相，荀爽复齐名。",
        "在贵兼天爵，能贤出世卿。",
        "学闻金马诏，神见玉人清。",
        "藏壑今如此，为山遂不成。"
      ],
      "author": {
        "id": 6652,
        "name": "张九龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 277337,
      "title": "故徐州刺史赠吏部侍郎苏公挽歌词三首 二",
      "content": [
        "相如只谢病，子敬忽云亡。",
        "岂悟瑶台雪，分雕玉树行。",
        "清规留草议，故事在封章。",
        "本谓山公启，而今殁始扬。"
      ],
      "author": {
        "id": 6652,
        "name": "张九龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 277338,
      "title": "故徐州刺史赠吏部侍郎苏公挽歌词三首 三",
      "content": [
        "返葬长安陌，秋风箫鼓悲。",
        "奈何相送者，不是平生时。",
        "寒影催年急，哀歌助晚迟。",
        "宁知建旟罢，丹旐向京师。"
      ],
      "author": {
        "id": 6652,
        "name": "张九龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 277339,
      "title": "故荥阳君苏氏挽歌词三首 一",
      "content": [
        "门绪公侯列，嫔风诗礼行。",
        "松萝方有寄，桃李忽无成。",
        "剑去双龙别，雏哀九凤鸣。",
        "何言峄山树，还似半心生。"
      ],
      "author": {
        "id": 6652,
        "name": "张九龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 277340,
      "title": "故荥阳君苏氏挽歌词三首 二",
      "content": [
        "永叹芳魂断，行看草露滋。",
        "二宗荣盛日，千古别离时。",
        "竟罢生刍赠，空留画扇悲。"
      ],
      "author": {
        "id": 6652,
        "name": "张九龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 277341,
      "title": "故荥阳君苏氏挽歌词三首 三",
      "content": [
        "缟服纷相送，玄扃翳不开。",
        "更悲泉火灭，徒见柳车回。",
        "旧室容衣奠，新茔拱树栽。",
        "唯应月照簟，潘岳此时哀。"
      ],
      "author": {
        "id": 6652,
        "name": "张九龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 277342,
      "title": "眉州康司马挽歌词",
      "content": [
        "家受专门学，人称入室贤。",
        "刘桢徒有气，管辂独无年。",
        "谪去长沙国，魂归京兆阡。",
        "从兹匣中劒，埋没罢冲天。"
      ],
      "author": {
        "id": 6652,
        "name": "张九龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 277343,
      "title": "奉和圣制早发三乡山行",
      "content": [
        "羽衞森森西向秦，山川历历在清晨。",
        "晴云稍卷寒岩树，宿雨能销御路尘。",
        "圣德由来合天道，灵符即此应时巡。",
        "遗贤一一皆羁致，犹欲高深访隐沦。"
      ],
      "author": {
        "id": 6652,
        "name": "张九龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 277344,
      "title": "奉和圣制龙池篇",
      "content": [
        "天启神龙生碧泉，泉水灵源浸迤延。",
        "飞龙已向珠潭出，积水仍将银汉连。",
        "岸傍花柳看胜画，浦上楼台问是仙。",
        "我后元符从此得，方为万岁寿图川。"
      ],
      "author": {
        "id": 6652,
        "name": "张九龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 277345,
      "title": "奉和圣制南郊礼毕酺宴",
      "content": [
        "配天昭圣业，率土庆辉光。",
        "春发三条路，酺开百戏场。",
        "流恩均庶品，纵观聚康庄。",
        "妙舞来平乐，新声出建章。",
        "分曹日抱戴，赴节凤归昌。",
        "幸奏承云乐，同晞湛露阳。",
        "气和皆有感，泽厚自无疆。",
        "饱德君臣醉，连歌奉柏梁。"
      ],
      "author": {
        "id": 6652,
        "name": "张九龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 277346,
      "title": "奉和圣制早渡蒲津关",
      "content": [
        "魏武中流处，轩皇问道回。",
        "长堤春树发，高掌曙云开。",
        "龙负王舟渡，人占仙气来。",
        "河津会日月，天仗役风雷。",
        "东顾重关尽，西驰万国陪。",
        "还闻股肱郡，元首咏康哉。"
      ],
      "author": {
        "id": 6652,
        "name": "张九龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 277347,
      "title": "奉和圣制同二相南出雀鼠谷",
      "content": [
        "设险诸侯地，承平圣主巡。",
        "东君朝二月，南斾拥三辰。",
        "寒出重关尽，年随行漏新。",
        "瑞云丛捧日，芳树曲迎春。",
        "舞咏先驰道，恩华及从臣。",
        "汾川花鸟意，并奉属车尘。"
      ],
      "author": {
        "id": 6652,
        "name": "张九龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 277348,
      "title": "奉和圣制经河上公庙",
      "content": [
        "昔者河边叟，谁知隐与仙。",
        "姓名终不识，章句此空传。",
        "迹为坐忘晦，言犹强著诠。",
        "精灵竟何所，祠宇独依然。",
        "道在纡宸睠，风行动睿篇。",
        "从兹化天下，清净复何先。"
      ],
      "author": {
        "id": 6652,
        "name": "张九龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 277349,
      "title": "奉和圣制送尚书燕国公赴朔方",
      "content": [
        "宗臣事有征，庙筭在休兵。",
        "天与三台座，人当万里城。",
        "朔南方偃革，河右暂扬旌。",
        "宠锡从仙禁，光华出汉京。",
        "山川勤远畧，原隰轸皇情。",
        "为奏薰琴唱，仍题宝劒名。",
        "闻风六郡伏，计日五戎平。",
        "山甫归应疾，留侯功复成。",
        "歌钟旋可望，袵席岂难行。",
        "四牡何时入？",
        "吾君忆履声。"
      ],
      "author": {
        "id": 6652,
        "name": "张九龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 277350,
      "title": "奉和圣制途经华山",
      "content": [
        "万乘华山下，千岩云汉中。",
        "灵居虽窅密，睿览忽玄同。",
        "日月临高掌，神仙仰大风。",
        "攒峰势岌岌，翊辇气雄雄。",
        "揆物知幽赞，铭勋表圣衷。",
        "会应陪玉检，来此告成功。"
      ],
      "author": {
        "id": 6652,
        "name": "张九龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 277351,
      "title": "奉和圣制早登太行山率尔言志",
      "content": [
        "孟月摄提贞，乘时我后征。",
        "晨严九折度，暮戒六军行。",
        "日御驰中道，风师卷太清。",
        "戈鋋林表出，组练雪间明。",
        "动植希皇豫，高深奉睿情。",
        "陪游七圣列，望幸百神迎。",
        "气色烟犹喜，恩光草尚荣。",
        "之罘称万岁，今此复同声。"
      ],
      "author": {
        "id": 6652,
        "name": "张九龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 277352,
      "title": "奉和圣制登封礼毕洛城酺宴",
      "content": [
        "大君毕能事，端扆乐成功。",
        "运与千龄合，欢将万国同。",
        "汉酺歌圣酒，韶乐舞薰风。",
        "河洛荣光遍，云烟喜气通。",
        "春华顿觉早，天泽倍知崇。",
        "草木皆沾被，犹言不在躬。"
      ],
      "author": {
        "id": 6652,
        "name": "张九龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 277353,
      "title": "恩赐乐游园宴应制",
      "content": [
        "宝筵延厚命，供帐序群公。",
        "形胜宜春接，威仪建礼同。",
        "晞阳人似露，解愠物从风。",
        "朝庆千龄始，年华二月中。",
        "辉光遍草木，和气发丝桐。",
        "岁岁无为化，宁知乐九功。"
      ],
      "author": {
        "id": 6652,
        "name": "张九龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 277354,
      "title": "奉和圣制过王濬墓",
      "content": [
        "汉王思巨鹿，晋将在弘农。",
        "入蜀举长筭，平吴成大功。",
        "与浑虽不协，归皓实为雄。",
        "孤绩沦千载，流名感圣衷。",
        "万乘度荒陇，一顾凛生风。",
        "古节犹不弃，今人争效忠。"
      ],
      "author": {
        "id": 6652,
        "name": "张九龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 277355,
      "title": "奉和吏部崔尚书雨后大明朝堂望南山",
      "content": [
        "迢递终南顶，朝朝阊阖前。",
        "朅来青绮外，高在翠微先。",
        "双凤褰为阙，群龙俨若仙。",
        "还知到玄圃，更是谒甘泉。",
        "夜雨尘初灭，秋空月正悬。",
        "诡容纷入望，霁色宛成妍。",
        "东极华阴践，西弥嶓冢连。",
        "奔峰出岭外，瀑水落云边。",
        "汉帝宫将苑，商君陌与阡。",
        "林华铺近甸，烟霭遶晴川。",
        "既庶仁斯及，分忧政已宣。",
        "山公启事罢，吉甫颂声传。",
        "济济金门步，洋洋玉树篇。",
        "徒歌虽有属，清越岂同年。"
      ],
      "author": {
        "id": 6652,
        "name": "张九龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 277356,
      "title": "和崔尚书喜雨",
      "content": [
        "积阳虽有晦，经月未为灾。",
        "上念人天重，先祈云汉回。",
        "仁心及草木，号令起风雷。",
        "照烂阴霞止，交纷瑞雨来。",
        "三辰破黍稷，四达屏氛埃。",
        "池溜因添满，林芳为洒开。",
        "听中声滴沥，望处影徘徊。",
        "惠泽成丰岁，昌言发上才。",
        "无论验石鼓，不是御云台。",
        "直颂皇恩浃，崇朝遍九垓。"
      ],
      "author": {
        "id": 6652,
        "name": "张九龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 277357,
      "title": "和许给事中直夜简诸公",
      "content": [
        "未央钟漏晚，仙宇蔼沈沈。",
        "武衞千庐合，严扃万户深。",
        "左掖知天近，南窗见月临。",
        "树摇金掌露，庭徙玉楼阴。",
        "他日闻更直，中宵属所钦。",
        "声华大国宝，夙夜近臣心。",
        "逸兴乘高阁，雄飞在禁林。",
        "宁思窃抃者，情发为知音。"
      ],
      "author": {
        "id": 6652,
        "name": "张九龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 277358,
      "title": "和苏侍郎小园夕霁寄诸弟",
      "content": [
        "清风阊阖至，轩盖承明归。",
        "云月爱秋景，林堂开夜扉。",
        "何言兼济日，尚与宴私违。",
        "兴逐蒹葭变，文因棠棣飞。",
        "人伦用忠孝，帝德已光辉。",
        "赠弟今为贵，方知陆氏微。"
      ],
      "author": {
        "id": 6652,
        "name": "张九龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 277359,
      "title": "酬宋使君见赠之作",
      "content": [
        "时来不自意，宿昔谬枢衡。",
        "翊圣负明主，妨贤媿友生。",
        "罢归犹右职，待罪尚南荆。",
        "政有留棠旧，风因继组成。",
        "高轩问疾苦，烝庶荷仁明。",
        "衰废时所薄，秪言僚故情。"
      ],
      "author": {
        "id": 6652,
        "name": "张九龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 277360,
      "title": "酬宋使君见诒",
      "content": [
        "陟邻初禀训，献策幸逢时。",
        "朝列且云忝，君恩复若兹。",
        "庭闱际海曲，轺传荷天慈。",
        "顾己欢乌鸟，闻君泣素丝。",
        "才明应主召，福善岂神欺。",
        "但愿白心在，终然湼不淄。"
      ],
      "author": {
        "id": 6652,
        "name": "张九龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 277361,
      "title": "酬通事舍人寓直见示篇中兼起居陆舍人景献",
      "content": [
        "轩掖殊清秘，才华固在斯。",
        "兴因膏泽洒，情与惠风吹。",
        "所美应人誉，何私亦我仪。",
        "同声感乔木，比翼谢长离。",
        "价以陆生减，贤慙鲍叔知。",
        "薄游尝独媿，芳讯乃兼施。",
        "此夜金闺籍，伊人琼树枝。",
        "飞鸣复何远，相顾幸媞媞。"
      ],
      "author": {
        "id": 6652,
        "name": "张九龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 277362,
      "title": "与袁补阙寻蔡拾遗会此公出行后蔡有五韵诗见赠以此篇答焉",
      "content": [
        "辙迹陈家巷，诗书孟子邻。",
        "偶来乘兴者，不值草玄人。",
        "契是忘年合，情非累日申。",
        "闻君还薄暮，见眷及兹辰。"
      ],
      "author": {
        "id": 6652,
        "name": "张九龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 277363,
      "title": "酬赵二侍御使西军赠两省旧僚之作",
      "content": [
        "石室先鸣者，金门待制同。",
        "操刀尝愿割，持斧竟称雄。",
        "应敌兵初起，缘边虏欲空。",
        "使车经陇月，征斾绕河风。",
        "忽枉兼金讯，非徒秣马功。",
        "气清蒲海曲，声满柏台中。",
        "顾己尘华省，欣君震远戎。",
        "明时独匪报，尝欲退微躬。"
      ],
      "author": {
        "id": 6652,
        "name": "张九龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 277364,
      "title": "武司功初有幽庭春暄见贻夏首获见以诗报焉",
      "content": [
        "芳月尽离居，幽怀重起予。",
        "虽言春事晚，尚想物华初。",
        "迟日皦方照，高斋澹复虚。",
        "笋成林向密，花落树应疎。",
        "赠鲤情无间，求莺思有余。",
        "暄妍不相待，含叹欲焉如。"
      ],
      "author": {
        "id": 6652,
        "name": "张九龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 277365,
      "title": "酬王履震游园林见贻",
      "content": [
        "宅生惟海县，素业守郊园。",
        "中览霸王说，上徼明主恩。",
        "一行罢兰径，数载历金门。",
        "既负潘生拙，俄从周任言。",
        "逶迤恋轩陛，萧散反丘樊。",
        "旧迳稀人迹，前池耗水痕。",
        "并看芳树老，唯觉敝庐存。",
        "自我栖幽谷，逢君翳覆盆。",
        "孟轲应有命，贾谊得无冤。",
        "江上行伤远，林间偶避喧。",
        "地偏人事绝，时霁鸟声繁。",
        "独善心俱闭，穷居道共尊。",
        "乐因南涧藻，忧岂北堂萱。",
        "幽意加投漆，新诗重赠轩。",
        "平生徇知己，穷达与君论。"
      ],
      "author": {
        "id": 6652,
        "name": "张九龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 277366,
      "title": "饯王尚书出边",
      "content": [
        "汉相推人杰，殷宗伐鬼方。",
        "还闻出将重，坐见即戎良。",
        "上策应为豫，中权且用光。",
        "令申兵气倍，威憺虏魂亡。",
        "树比公孙大，城如道济长。",
        "夏云登陇首，秋露泫辽阳。",
        "武德舒宸睠，文思饯乐章。",
        "感恩身既许，激节胆犹尝。",
        "祖帐倾朝列，军麾驻道傍。",
        "诗人何所咏，尚父欲鹰扬。"
      ],
      "author": {
        "id": 6652,
        "name": "张九龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 277367,
      "title": "送赵都护赴安西",
      "content": [
        "将相有更践，简心良独难。",
        "远图尝画地，超拜乃登坛。",
        "戎即昆山序，车同渤海单。",
        "义无中国费，情必远人安。",
        "他日文兼武，而今栗且宽。",
        "自然来月窟，何用刺楼兰。",
        "南至三冬晚，西驰万里寒。",
        "封侯自有处，征马去啴啴。"
      ],
      "author": {
        "id": 6652,
        "name": "张九龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 277368,
      "title": "奉使自蓝田玉山南行",
      "content": [
        "征骖入云壑，始忆步金门。",
        "通籍微躯幸，归途明主恩。",
        "匪唯徇行役，兼得慰晨昏。",
        "是节暑云炽，纷吾心所尊。",
        "海县且悠缅，山邮日骏奔。",
        "徒知恶嚣事，未暇息阴论。",
        "峣武经陈迹，衡湘指故园。",
        "水闻南涧险，烟望北林繁。",
        "远霭千岩合，幽声百籁喧。",
        "阴泉夏犹冻，阳景昼方暾。",
        "懿此高深极，徒令梦想存。",
        "盛明期有报，长往复奚言。"
      ],
      "author": {
        "id": 6652,
        "name": "张九龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 277369,
      "title": "贺给事尝诣蔡起居郊馆有诗因命同作",
      "content": [
        "记言闻直史，筑室面层阿。",
        "岂不承明入，终云幽意多。",
        "沈冥高士致，休澣故人过。",
        "前岭游氛灭，中林芳气和。",
        "兹辰阻佳趣，望美独如何。"
      ],
      "author": {
        "id": 6652,
        "name": "张九龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 277370,
      "title": "南山下旧居闲放",
      "content": [
        "秪役已云久，乘闲返服初。",
        "块然屏尘事，幽独坐林闾。",
        "清旷前山远，纷喧此地疎。",
        "乔木凌青霭，修篁媚绿渠。",
        "耳和绣翼鸟，目畅锦鳞鱼。",
        "寂寞心还间，飘飖体自虚。",
        "兴来命旨酒，临罢阅仙书。",
        "但乐多幽意，宁知有毁誉。",
        "尚想争名者，谁云要路居。",
        "都忘下流叹，倾夺竟何如。"
      ],
      "author": {
        "id": 6652,
        "name": "张九龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 277371,
      "title": "高斋闲望言怀",
      "content": [
        "高斋复晴景，延眺属清秋。",
        "风物动归思，烟林生远愁。",
        "纷吾自穷海，薄宦此中州。",
        "取路无高足，随波适下流。",
        "岁华空冉冉，心曲且悠悠。",
        "坐惜芳时歇，胡然久滞留。"
      ],
      "author": {
        "id": 6652,
        "name": "张九龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 277372,
      "title": "别乡人南还",
      "content": [
        "橘柚南中暖，桑榆北地阴。",
        "何言荣落异，因见别离心。",
        "吾亦江乡子，思归梦寐深。",
        "闻君去水宿，结思渺云林。",
        "牵缀从浮事，迟回谢所钦。",
        "东南行舫远，秋浦念猿吟。"
      ],
      "author": {
        "id": 6652,
        "name": "张九龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 277373,
      "title": "初发江陵有怀",
      "content": [
        "极望涔阳浦，江天渺不分。",
        "扁舟从此去，鸥鸟自为群。",
        "他日怀真赏，中年负俗纷。",
        "适来果微尚，倏尔会斯文。",
        "复想金闺籍，何如梦渚云。",
        "我行多胜寄，浩思独氛氲。"
      ],
      "author": {
        "id": 6652,
        "name": "张九龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 277374,
      "title": "同綦毋学士月夜闻雁",
      "content": [
        "栖宿岂无意，飞飞更远寻。",
        "长途未及半，中夜有遗音。",
        "月思关山笛，风号流水琴。",
        "空声两相应，幽感一何深。",
        "避缴归南浦，离群呌北林。",
        "联翩俱不定，怜尔越乡心。"
      ],
      "author": {
        "id": 6652,
        "name": "张九龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 277375,
      "title": "登总持寺阁",
      "content": [
        "香阁起崔嵬，高高沙版开。",
        "攀跻千仞上，纷诡万形来。",
        "草间商君陌，云重汉后台。",
        "山从函谷断，川向斗城回。",
        "林里春容变，天边客思催。",
        "登临信为美，怀远独悠哉。"
      ],
      "author": {
        "id": 6652,
        "name": "张九龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 277376,
      "title": "晚憩王少府东阁",
      "content": [
        "披轩肆流览，云壑见深重。",
        "空水秋弥净，林烟晚更浓。",
        "坐隅分洞府，簷际列群峰。",
        "窈窕生幽意，参差多异容。",
        "还慙大隐迹，空想列仙踪。",
        "赖此升攀处，萧条得所从。"
      ],
      "author": {
        "id": 6652,
        "name": "张九龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 277377,
      "title": "登城楼望西山作",
      "content": [
        "城楼枕南浦，日夕顾西山。",
        "宛宛鸾鹤处，高高烟雾间。",
        "仙井今犹在，洪厓久不还。",
        "金编莫我授，羽驾亦难攀。",
        "簷际千峰出，云中一鸟闲。",
        "纵观穷水国，游思徧人寰。",
        "勿复尘埃事，归来且闭关。"
      ],
      "author": {
        "id": 6652,
        "name": "张九龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 277378,
      "title": "祠紫盖山经玉泉山寺",
      "content": [
        "指涂跻楚望，策马傍荆岑。",
        "稍稍松篁入，泠泠磵谷深。",
        "观奇逐幽暎，历险忘岖嵚。",
        "上界投佛影，中天扬梵音。",
        "焚香忏在昔，礼足誓来今。",
        "灵异若有对，神仙真可寻。",
        "高僧闻逝者，远俗是初心。",
        "藓驳经行处，猿啼燕坐林。",
        "归真已寂灭，留迹岂[湮沈]。",
        "法地自兹广，何云千万金。"
      ],
      "author": {
        "id": 6652,
        "name": "张九龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 277379,
      "title": "洪州西山祈雨是日辄应因赋诗言事",
      "content": [
        "兹山蕴灵异，走望良有归。",
        "丘祷虽已久，甿心难重违。",
        "迟明申藻荐，先夕旅岩扉。",
        "独宿云峰下，萧条人吏稀。",
        "我来不外适，幽抱自中微。",
        "静入风泉奏，凉生松栝围。",
        "穷年滞远想，寸晷阅清晖。",
        "虚美怅无属，素情缄所依。",
        "诡随嫌弱操，羇束谢贞肥。",
        "义济亦吾道，诚存为物祈。",
        "灵心倏已应，甘液幸而飞。",
        "闭阁且无责，随车安敢希。",
        "多慙德不感，知复是耶非。"
      ],
      "author": {
        "id": 6652,
        "name": "张九龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 277380,
      "title": "经江宁览旧迹至玄武湖",
      "content": [
        "南国更数世，北湖方十洲。",
        "天清华林苑，日晏景阳楼。",
        "果下回仙骑，津傍驻彩斿。",
        "凫鹥喧凤管，荷芰鬬龙舟。",
        "七子陪诗赋，千人和棹讴。",
        "应言在镐乐，不让横汾秋。",
        "风俗因纾慢，江山成易由。",
        "驹王信不武，孙叔是无谋。",
        "佳气日将歇，霸功谁与修。",
        "桑田东海变，麋鹿姑苏游。",
        "否运争三国，康时劣九州。",
        "山虽幕府在，馆岂豫章留。",
        "水淀还相阅，菱歌亦故遒。",
        "雄图不足问，唯想事风流。"
      ],
      "author": {
        "id": 6652,
        "name": "张九龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 277381,
      "title": "登襄阳岘山",
      "content": [
        "昔年亟攀践，征马复来过。",
        "信若山川旧，谁如岁月何。",
        "蜀相吟安在，羊公碣已磨。",
        "令图犹寂寞，嘉会亦蹉跎。",
        "宛宛樊城岸，悠悠汉水波。",
        "逶迤春日远，感寄客情多。",
        "地本原林秀，朝来烟景和。",
        "同心不同赏，留叹此岩阿。"
      ],
      "author": {
        "id": 6652,
        "name": "张九龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 277382,
      "title": "登荆州城楼",
      "content": [
        "天宇何其旷，江城坐自拘。",
        "层楼百余尺，迢递在西隅。",
        "暇日时登眺，荒郊临故都。",
        "累累见陈迹，寂寂想雄图。",
        "古往山川在，今来郡邑殊。",
        "北疆虽入郑，东距岂防吴。",
        "几代传荆国，当时敌陕郛。",
        "上流空有处，中土复何虞。",
        "枕席夷三峡，关梁豁五湖。",
        "承平无异境，守隘莫论夫。",
        "自罢金门籍，来参竹使符。",
        "端居向林薮，微尚在桑榆。",
        "直似王陵戆，非如宁武愚。",
        "今兹对南浦，乘雁与双凫。"
      ],
      "author": {
        "id": 6652,
        "name": "张九龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 277383,
      "title": "登乐游原春望书怀",
      "content": [
        "城隅有乐游，表里见皇州。",
        "策马既长远，云山亦悠悠。",
        "万壑清光满，千门喜气浮。",
        "花间直城路，草际曲江流。",
        "凭眺兹为美，离居方独愁。",
        "已惊玄发换，空度绿荑柔。",
        "奋翼笼中鸟，归心海上鸥。",
        "既伤日月逝，且欲桑榆收。",
        "豹变焉能及，莺鸣非可求。",
        "愿言从所好，初服返林丘。"
      ],
      "author": {
        "id": 6652,
        "name": "张九龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 277384,
      "title": "候使登石头驿楼作",
      "content": [
        "山槛凭南望，川途眇北流。",
        "远林天翠合，前浦日华浮。",
        "万井缘津渚，千艘咽渡头。",
        "渔商多末事，耕稼少良畴。",
        "自守陈蕃榻，尝登王粲楼。",
        "徒然骋目处，岂是获心游。",
        "向迹虽愚谷，求名异盗丘。",
        "息阴芳木所，空复越乡忧。"
      ],
      "author": {
        "id": 6652,
        "name": "张九龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 277385,
      "title": "登临沮楼",
      "content": [
        "高深不可厌，巡属复来过。",
        "本与众山绝，况兹韶景和。",
        "危楼入水倒，飞槛向空摩。",
        "杂树缘青壁，樛枝挂绿萝。",
        "潭清能彻底，鱼乐好跳波。",
        "有象言虽具，无端思转多。",
        "同怀不在此，孤赏欲如何。"
      ],
      "author": {
        "id": 6652,
        "name": "张九龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 277386,
      "title": "陪王司马登薛公逍遥台",
      "content": [
        "尝闻薛公泪，非直雍门琴。",
        "窜逐留遗迹，悲凉见此心。",
        "府中因暇豫，江上幸招寻。",
        "人事已成古，风流独至今。",
        "闲情多感叹，清景暂登临。",
        "无复甘棠在，空余蔓草深。",
        "晴光送远目，胜气入幽襟。",
        "水去朝沧海，春来换碧林。",
        "赋怀湘浦吊，碑想汉川沈。",
        "曾是陪游日，徒为梁父吟。"
      ],
      "author": {
        "id": 6652,
        "name": "张九龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 277387,
      "title": "尝与大理丞袁公太府丞田公偶诣一所林沼尤胜因并坐其次相得甚欢遂赋诗焉以咏其事",
      "content": [
        "方驾与吾友，同怀不异寻。",
        "偶逢池竹处，便会江湖心。",
        "夏近林方密，春余水更深。",
        "清华两辉暎，闲步亦窥临。",
        "苹藻复佳色，凫鹥亦好音。",
        "韶芳媚洲渚，蕙气袭衣襟。",
        "萧散皆为乐，裴回从所钦。",
        "谓予成夙志，岁晚共抽簪。"
      ],
      "author": {
        "id": 6652,
        "name": "张九龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 277388,
      "title": "与弟游家园",
      "content": [
        "定省荣君赐，来归是昼游。",
        "林乌飞旧里，园果让新秋。",
        "枝长南庭树，池临北涧流。",
        "星霜屡尔别，兰麝为谁幽。",
        "善积家方庆，恩深国未酬。",
        "栖栖将义动，安得久情留。"
      ],
      "author": {
        "id": 6652,
        "name": "张九龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    }
