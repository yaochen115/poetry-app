{
  "data": [
    {
      "id": 358869,
      "title": "江西郑常侍赴镇之日有寄，因酬和",
      "content": [
        "来暮亦何愁，金貂在鹢舟。",
        "旆随寒浪动，帆带夕阳收。",
        "布令滕王阁，裁诗郢客楼。",
        "即应归凤沼，中外赞天休。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 358870,
      "title": "蒙河南刘大夫见示与吏部张公喜雪酬唱，辄敢攀和",
      "content": [
        "风度龙山暗，云凝象阙阴。",
        "瑞花琼树合，仙草玉苗深。",
        "欲醉梁王酒，先调楚客琴。",
        "即应携手去，将此助商霖。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 358871,
      "title": "下第送宋秀才游岐下、杨秀才还江东",
      "content": [
        "年来不自得，一望几伤心。",
        "风转蕙兰色，月移松桂阴。",
        "马随边草远，帆落海云深。",
        "明旦各分首，更听梁甫吟。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 358874,
      "title": "太和初靖恭里感事",
      "content": [
        "清湘吊屈原，垂泪撷苹蘩。",
        "谤起乘轩鹤，机沉在槛猿。",
        "乾坤三事贵，华夏一夫冤。",
        "宁有唐虞世，心知不为言。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 358875,
      "title": "与侯春时同年南池夜话",
      "content": [
        "芦苇暮修修，溪禽上钓舟。",
        "露凉花敛夕，风静竹含秋。",
        "素志应难契，清言岂易求。",
        "相欢一瓢酒，明日醉西楼。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 358876,
      "title": "广陵送剡县薛明府赴任",
      "content": [
        "车马楚城壕，清歌送浊醪。",
        "露花羞别泪，烟草让归袍。",
        "鸟浴春塘暖，猿吟暮岭高。",
        "寻仙在仙骨，不用废牛刀。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 358878,
      "title": "题官舍",
      "content": [
        "燕雁水乡飞，京华信自稀。",
        "簟瓢贫守道，书剑病忘机。",
        "叠鼓吏初散，繁钟鸟独归。",
        "高梧与疏柳，风雨似郊扉。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 358880,
      "title": "晓过郁林寺戏呈李明府",
      "content": [
        "身闲白日长，何处不寻芳。",
        "山崦登楼寺，溪湾泊晚樯。",
        "洞花蜂聚蜜，岩柏麝留香。",
        "若指求仙路，刘郎学阮郎。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 358881,
      "title": "泛舟寻郁林寺道玄上人遇雨而返因寄",
      "content": [
        "禅扉倚石梯，云湿雨凄凄。",
        "草色分松径，泉声咽稻畦。",
        "棹移滩鸟没，钟断岭猿啼。",
        "入夜花如雪，回舟忆剡溪。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 358883,
      "title": "题崇圣寺",
      "content": [
        "西林本行殿，池榭日坡阤。",
        "雨过水初涨，云开山渐多。",
        "晓街垂御柳，秋院闭宫莎。",
        "借问龙归处，鼎湖空碧波。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 358887,
      "title": "忆长洲",
      "content": [
        "香径小船通，菱歌绕故宫。",
        "鱼沉秋水静，鸟宿暮山空。",
        "荷叶桥边雨，芦花海上风。",
        "归心无处托，高枕画屏中。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 358889,
      "title": "题邹处士隐居",
      "content": [
        "桑柘满江村，西斋接海门。",
        "浪冲高岸响，潮入小池浑。",
        "岩树阴棋局，山花落酒樽。",
        "相逢亦留宿，还似识王孙。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 358890,
      "title": "送僧归敬亭山寺",
      "content": [
        "十年剑中路，传尽本师经。",
        "晓月下黔峡，秋风归敬亭。",
        "开门新树绿，登阁旧山青。",
        "遥想论禅处，松阴水一瓶。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 358892,
      "title": "天街晓望",
      "content": [
        "明星低未央，莲阙迥苍苍。",
        "叠鼓催残月，疏钟迎早霜。",
        "关防浮瑞气，宫馆耀神光。",
        "再拜为君寿，南山高且长。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 358894,
      "title": "下第归朱方寄刘三复",
      "content": [
        "素衣京洛尘，归棹过南津。",
        "故里迹犹在，旧交心更新。",
        "月高萧寺夜，风暖庾楼春。",
        "诗酒应无暇，朝朝问旅人。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 358895,
      "title": "送人归吴兴",
      "content": [
        "绿水棹云月，洞庭归路长。",
        "春桥悬酒幔，夜栅集茶樯。",
        "箬叶沉溪暖，苹花绕郭香。",
        "应逢柳太守，为说过潇湘。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 358899,
      "title": "赠柳璟、冯陶二校书",
      "content": [
        "霄汉两飞鸣，喧喧动禁城。",
        "桂堂同日盛，芸阁间年荣。",
        "香掩蕙兰气，韵高鸾鹤声。",
        "应怜茂陵客，未有子虚名。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 358900,
      "title": "王秀才自越见寻不遇，题诗而回，因以酬寄",
      "content": [
        "南斋知数宿，半为木兰开。",
        "晴阁留诗遍，春帆载酒回。",
        "烟深扬子宅，云断越王台。",
        "自有孤舟兴，何妨更一来。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 358901,
      "title": "秋霁潼关驿亭",
      "content": [
        "霁色明高𪩘，关河独望遥。",
        "残云归太华，疏雨过中条。",
        "鸟散绿萝静，蝉鸣红树凋。",
        "何言此时节，去去任蓬飘。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 358902,
      "title": "送客归兰溪",
      "content": [
        "花下送归客，路长应过秋。",
        "暮随江鸟宿，寒共岭猿愁。",
        "众水喧严濑，群峰抱沉楼。",
        "因君几南望，曾向此中游。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 358904,
      "title": "送李文明下第鄜州觐兄",
      "content": [
        "征夫天一涯，醉赠别吾诗。",
        "雁迥参差远，龙多次第迟。",
        "宁歌还夜苦，宋赋更秋悲。",
        "的的遥相待，清风白露时。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 358905,
      "title": "送段觉归东阳兼寄窦使君",
      "content": [
        "山水引归路，陆郎从此谙。",
        "秋茶垂露细，寒菊带霜甘。",
        "台倚乌龙岭，楼侵白雁潭。",
        "沈公如借问，心在浙河南。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 358907,
      "title": "伤冯秀才",
      "content": [
        "旅葬不可问，茫茫西陇头。",
        "水云青草湿，山月白杨愁。",
        "琴信有时罢，剑伤无处留。",
        "淮南旧烟月，孤棹更逢秋。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 358908,
      "title": "送郑寂上人南行",
      "content": [
        "儒家有释子，年少学支公。",
        "心出是非外，迹辞荣辱中。",
        "锡寒秦岭月，杯急楚江风。",
        "离怨故园里，小秋梨叶红。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 358910,
      "title": "送友人归荆楚",
      "content": [
        "调瑟劝离酒，苦谙荆楚门。",
        "竹斑悲帝女，草绿怨王孙。",
        "潮落九疑迥，雨连三峡昏。",
        "同来不同去，迢递更伤魂。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 358911,
      "title": "重伤杨攀处士二首",
      "content": [
        "绿云多学术，黄发竟无成。",
        "酒纵山中性，诗留海上名。",
        "读书新树老，垂钓旧矶平。",
        "今日悲前事，西风闻哭声。",
        "从官任直道，几处脱长裾。",
        "殁后儿犹小，葬来人渐疏。",
        "新邻占池馆，长史觅图书。",
        "身贱难相报，平生恨有余。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 358912,
      "title": "送友人罢举归东海",
      "content": [
        "沧波天堑外，何岛是新罗。",
        "舶主辞番远，棋僧入汉多。",
        "海风吹白鹤，沙日晒红螺。",
        "此去知投笔，须求利剑磨。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 358919,
      "title": "西山草堂",
      "content": [
        "何处少人事，西山旧草堂。",
        "晒书秋日晚，洗药石泉香。",
        "浚岭有朝雨，北窗生夜凉。",
        "从劳问归路，峰叠绕家乡。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 358920,
      "title": "赠隐者",
      "content": [
        "回报隐居士，莫愁山兴阑。",
        "求人颜色尽，知道性情宽。",
        "信谱弹琴误，缘崖㔉药难。",
        "东皋亦自给，殊愧远相安。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 358921,
      "title": "舟次武陵寄天竺僧无昼",
      "content": [
        "溪长山几重，十里万株松。",
        "秋日下丹槛，暮云归碧峰。",
        "树栖新放鹤，潭隐旧降龙。",
        "还在孤舟宿，卧闻初夜钟。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 358922,
      "title": "寄小弟",
      "content": [
        "江城红叶尽，旅思复凄伤。",
        "孤梦家山远，独眠秋夜长。",
        "道存空倚命，身贱未归乡。",
        "南望空垂泪，天边雁一行。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 358926,
      "title": "行次白沙馆，先寄上河南王侍御",
      "content": [
        "夜程何处宿，山叠树层层。",
        "孤馆闭秋雨，空堂停曙灯。",
        "歌惭渔浦客，诗学雁门僧。",
        "此意无人识，明朝见李膺。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 358927,
      "title": "紫藤",
      "content": [
        "绿萝萦数匝，本在草堂间。",
        "秋色寄高树，昼阴笼远山。",
        "移花疏处种，㔉药困时攀。",
        "日暮微风起，难寻旧径还。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 358928,
      "title": "暝投灵智寺渡溪不得，却取沿江路往",
      "content": [
        "双岩泻一川，回马断桥前。",
        "古庙阴风地，寒钟暮雨天。",
        "沙虚留虎迹，水滑带龙涎。",
        "却下临江路，潮深无渡船。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 358929,
      "title": "下第归蒲城墅居",
      "content": [
        "失意归三径，伤春别九门。",
        "薄烟杨柳路，微雨杏花村。",
        "牧竖还呼犊，邻翁亦抱孙。",
        "不知余正苦，迎马问寒温。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 358932,
      "title": "深春",
      "content": [
        "故里千帆外，深春一雁飞。",
        "干名频恸哭，将老欲何归。",
        "未谷抛还忆，交亲晚更稀。",
        "空持望乡泪，沾洒寄来衣。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 358933,
      "title": "岁首怀甘露寺自省上人",
      "content": [
        "心悟觉身劳，云中弃宝刀。",
        "久闲生髀肉，多寿长眉毫。",
        "客棹春潮急，禅斋暮雪高。",
        "南da一回首，山碧水滔滔。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 358934,
      "title": "寻周炼师不遇留赠",
      "content": [
        "闭门池馆静，云访紫芝翁。",
        "零落槿花雨，参差荷叶风。",
        "夜棋全局在，春酒半壶空。",
        "长啸倚西阁，悠悠名利中。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 358935,
      "title": "题灞西骆隐居",
      "content": [
        "志凌三蜀客，心爱五湖人。",
        "co死酒中老，谋生书外贫。",
        "扫花眠石榻，捣药转溪轮。",
        "往往乘黄牸，鹿裘乌角巾。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 358936,
      "title": "旅夜怀远客",
      "content": [
        "异乡多远情，梦断落江城。",
        "病起惭书癖，贫家负酒名。",
        "过春花自落，竟晓月空明。",
        "独此一长啸，故人天际行。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 358937,
      "title": "秋夜棹舟访李隐君",
      "content": [
        "望月忆披襟，长溪柳半阴。",
        "高斋初酿酒，孤棹远携琴。",
        "犬吠秋山迥，鸡鸣晓树深。",
        "开门更欹枕，谁识野人心。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 358938,
      "title": "卧病寄诸公",
      "content": [
        "飞盖集兰堂，清歌递柏觞。",
        "高城榆柳荫，虚阁芰荷香。",
        "海月秋偏静，山风夜更凉。",
        "自怜书万卷，扶病对萤光。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 358942,
      "title": "喜李诩秀才见访因赠",
      "content": [
        "浙南分首日，谁谓别经时。",
        "路远遥相访，家贫喜见知。",
        "不须辞不酌，更请续新诗。",
        "但得心中剑，酬恩会有期。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 358944,
      "title": "行次虎头岩酬寄路中丞",
      "content": [
        "樟亭去已远，来上虎头岩。",
        "滩急水移棹，山回风满帆。",
        "石梯迎雨滑，沙井落潮咸。",
        "何以慰行旅，如公书一缄。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 358950,
      "title": "惜春",
      "content": [
        "花开又花落，时节暗中迁。",
        "无计延春日，可能留少年。",
        "小丛初散蝶，高柳即闻蝉。",
        "繁艳归何处，满山啼杜鹃。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 358952,
      "title": "鸳鸯",
      "content": [
        "两两戏沙汀，长疑画不成。",
        "锦机争织样，歌曲爱呼名。",
        "好□顾栖息，堪怜泛浅清。",
        "凫鸥皆尔类，唯羡独含情。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 358953,
      "title": "闻雁",
      "content": [
        "带霜南去雁，夜好宿汀沙。",
        "惊起向何处，高飞极海涯。",
        "入云声渐远，离岳路犹赊。",
        "归梦当时断，参差欲到家。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 358954,
      "title": "不寝",
      "content": [
        "到晓不成梦，思量堪白头。",
        "多无百年命，长有万般愁。",
        "世事应难尽，营生卒未休。",
        "莫言名与利，名利是身仇。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 358955,
      "title": "宿东横山",
      "content": [
        "孤舟路渐赊，时见碧桃花。",
        "溪雨滩声急，岩风树势斜。",
        "猕猴垂弱蔓，鹳鹤睡横槎。",
        "谩向仙林宿，无人识阮家。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 358958,
      "title": "酬殷尧藩",
      "content": [
        "相如愧许询，寥落向溪滨。",
        "竹马儿犹小，荆钗妇惯贫。",
        "独愁忧过日，多病不如人。",
        "莫怪青袍选，长安隐旧春。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 358959,
      "title": "赠迁客",
      "content": [
        "无机还得罪，直道不伤情。",
        "微雨昏山色，疏笼闭鹤声。",
        "闲居多野客，高枕见江城。",
        "门外长溪水，怜君又濯缨。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 358961,
      "title": "南陵留别段氏兄弟",
      "content": [
        "不知身老大，犹似旧时狂。",
        "为酒游山县，留诗遍草堂。",
        "归期秋未尽，离恨日偏长。",
        "更羡君兄弟，参差雁一行。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 358962,
      "title": "旅中别侄暐",
      "content": [
        "相见又南北，中宵泪满襟。",
        "旅游知世薄，贫别觉情深。",
        "歌管一尊酒，山川万里心。",
        "此身多在路，休诵异乡吟。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 358963,
      "title": "松江渡送人",
      "content": [
        "故国今何在，扁舟竟不归。",
        "云移山漠漠，江阔树依依。",
        "晚色千帆落，秋声一雁飞。",
        "此时兼送客，凭槛欲沾衣。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 358965,
      "title": "金陵怀古",
      "content": [
        "玉树歌残王气终，景阳兵合戍楼空。",
        "松楸远近千官冢，",
        "英雄一去豪华尽，唯有青山似洛中。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 358966,
      "title": "姑苏怀古",
      "content": [
        "宫馆余基辍棹过，黍苗无限独悲歌。",
        "荒台麋鹿争新草，",
        "可怜国破忠臣死，日日东流生白波。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 358967,
      "title": "凌歊台",
      "content": [
        "宋祖凌高乐未回，三千歌舞宿层台。",
        "湘潭云尽暮山出，",
        "百年便作万年计，岩畔古碑空绿苔。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 358968,
      "title": "骊山",
      "content": [
        "闻说先皇醉碧桃，日华浮动郁金袍。",
        "风随玉辇笙歌迥，",
        "贵妃没后巡游少，瓦落宫墙见野蒿。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 358969,
      "title": "咸阳城东楼",
      "content": [
        "一上高城万里愁，蒹葭杨柳似汀洲。",
        "溪云初起日沈阁，",
        "行人莫问当年事，故国东来渭水流。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 358970,
      "title": "京口闲居寄京洛友人",
      "content": [
        "吴门烟月昔同游，枫叶芦花并客舟。",
        "聚散有期云北去，",
        "何处相思不相见，凤城龙阙楚江头。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 358971,
      "title": "冬日登越王台怀归",
      "content": [
        "月沉高岫宿云开，万里归心独上来。",
        "河畔雪飞扬子宅，",
        "乡信渐稀人渐老，只应频看一枝梅。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 358972,
      "title": "对雪",
      "content": [
        "云度龙山暗倚城，先飞淅沥引轻盈。",
        "素娥冉冉拜瑶阙，",
        "剡溪一醉十年事，忽忆棹回天未明。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 358973,
      "title": "送萧处士归缑岭别业",
      "content": [
        "醉斜乌帽发如丝，曾看仙人一局棋。",
        "宾馆有鱼为客久，",
        "今夜月明何处宿，九疑云尽碧参差。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 358974,
      "title": "与郑二秀才同舟东下洛中，亲朋送至景云寺",
      "content": [
        "三十六峰横一川，绿波无路草芊芊。",
        "牛羊晚食铺平地，",
        "东西未有相逢日，更把繁华共醉眠。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 358975,
      "title": "长安岁暮",
      "content": [
        "独望天门倚剑歌，干时无计老关河。",
        "东归万里惭张翰，",
        "三山岁岁有人去，唯恐海风生白波。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 358976,
      "title": "赠茅山高拾遗",
      "content": [
        "谏猎归来绮季歌，大茅峰影满秋波。",
        "山斋留客扫红叶，",
        "云中黄鹄日千里，自宿自飞无网罗。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 358977,
      "title": "李秀才近自涂口迁居新安适枉缄书见宽悲戚因以此答",
      "content": [
        "远书开罢更依依，晨坐高台竟落晖。",
        "颜巷雪深人已去，",
        "今日劳君犹问讯，一官唯长故山薇。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 358978,
      "title": "赠萧兵曹先辈",
      "content": [
        "广陵堤上昔离居，帆转潇湘万里余。",
        "楚客病时无𫛳鸟，",
        "闻说携琴兼载酒，邑人争识马相如。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 358979,
      "title": "题舒女庙",
      "content": [
        "山乐来迎去不言，庙前高柳水禽喧。",
        "绮罗无色雨侵帐，",
        "孤舟梦断行云散，何限离心寄晓猿。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 358980,
      "title": "姑孰官舍",
      "content": [
        "草生宫舍似闲居，雪照南窗满素书。",
        "贫后始知为吏拙，",
        "不待秋风便归去，紫阳山下是吾庐。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 358981,
      "title": "凌歊台送韦秀才",
      "content": [
        "云起高台日未沉，数村残照半岩阴，野蚕成茧桑柘尽，",
        "故山迢递故人去，一夜月明千里心。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 358982,
      "title": "送岭南卢判官罢职归华阴山居",
      "content": [
        "曾事刘琨雁塞空，十年书剑任飘蓬。",
        "东堂旧屈移山志，",
        "关西旧友如相问，已许沧浪伴钓翁。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 358983,
      "title": "将度故城湖阻风夜泊永阳戍",
      "content": [
        "行尽青溪日已蹉，云容山影水嵯峨。",
        "楼前归客怨清梦，",
        "终期一艇载樵去，来往使帆凌白波。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 358984,
      "title": "郑侍御厅玩鹤",
      "content": [
        "碧天飞舞下晴莎，金阁瑶池绝网罗。",
        "岩响数声风满树，",
        "双翅一开千万里，只应栖隐恋乔柯。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 358985,
      "title": "南亭夜坐，贻开元禅定二道者",
      "content": [
        "暮暮焚香何处宿，西岩一室映疏藤。",
        "光阴难驻迹如客，",
        "身闲境静日为乐，若问其余非我能。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 358986,
      "title": "朱坡故少保杜公池亭",
      "content": [
        "杜陵池榭绮城东，孤岛回汀路不穷。",
        "高岫乍疑三峡近，",
        "还有昔时巢燕在，飞来飞去画堂中。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 358987,
      "title": "秋日早朝",
      "content": [
        "宵衣应待绝更筹，环佩锵锵月下楼。",
        "井转辘轳千树晓，",
        "虚戴铁冠无一事，沧江归去老渔舟。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 358988,
      "title": "沧浪峡",
      "content": [
        "缨带流尘发半霜，独寻残月下沧浪。",
        "一声溪鸟暗云散，",
        "红虾青鲫紫芹脆，归去不辞来路长。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 358989,
      "title": "故洛城",
      "content": [
        "禾黍离离半野蒿，昔人城此岂知劳。",
        "水声东去市朝变，",
        "可怜缑岭登仙子，犹自吹笙醉碧桃。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 358990,
      "title": "闻释子栖玄欲奉道因寄",
      "content": [
        "欲求真诀恋禅扃，羽帔方袍尽有情。",
        "仙骨本微灵鹤远，",
        "今日劝师师莫惑，长生难学证无生。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 358991,
      "title": "南海府罢南康阻浅行侣稍稍登陆而迈主人燕饯至频暮宿东溪",
      "content": [
        "暗滩水落涨虚沙，滩去秦吴万里赊。",
        "马上折残江北柳，",
        "山鸟一声人未起，半床春月在天涯。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 358992,
      "title": "秋晚云阳驿西亭莲池",
      "content": [
        "心忆莲池秉烛游，叶残花败尚维舟。",
        "烟开翠扇清风晓，",
        "空怀远道难持赠，醉倚阑干尽日愁。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 358993,
      "title": "题勤尊师历阳山居",
      "content": [
        "二十知兵在羽林，中年潜识子房心。",
        "苍鹰出塞胡尘灭。",
        "白鹤还乡楚水深。",
        "春坼酒瓶浮药气，晚携棋局带松阴。",
        "鸡笼山上云多处，自㔉黄精不可寻。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 358994,
      "title": "怀旧居",
      "content": [
        "兵书一箧老无功，故国郊扉在梦中。",
        "藤蔓覆梨张谷暗。",
        "草花侵菊庾园空。",
        "朱门迹忝登龙客，白屋心期失马翁。",
        "楚水吴山何处是，北窗残月照屏风。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 358995,
      "title": "祗命许昌自郊居，移就公馆秋日寄茅山高拾遗",
      "content": [
        "一笛迎风万叶飞，强携刀笔换荷衣。",
        "潮寒水国秋砧早，",
        "中年未识从军乐，虚近三茅望少微。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 358996,
      "title": "伤虞将军",
      "content": [
        "白首从军未有名，近将孤剑到江城。",
        "巴童戍久能番语，",
        "可怜身死家犹远，汴水东流无哭声。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 358997,
      "title": "晚自朝台津至韦隐居郊园",
      "content": [
        "秋来凫雁下方塘，系马朝台步夕阳。",
        "村径绕山松叶暗，",
        "西下磻溪犹万里，可能垂白待文王。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 358998,
      "title": "寓居开元精舍，酬薛秀才见贻",
      "content": [
        "知己萧条信陆沉，茂陵扶疾卧西林。",
        "芰荷风起客堂静，",
        "怜君诗句犹相忆，题在空斋夜夜吟。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 358999,
      "title": "别刘秀才",
      "content": [
        "三献无功玉有瑕，更携书剑客天涯。",
        "孤帆夜别潇湘雨，",
        "关河万里秋风急，望见乡山不到家。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359000,
      "title": "早发天台中岩寺度关岭次天姥岑",
      "content": [
        "来往天台天姥间，欲求真诀驻衰颜。",
        "星河半落岩前寺，",
        "可知刘阮逢人处，行尽深山又是山。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359001,
      "title": "游钱塘青山李隐居西斋",
      "content": [
        "小隐西亭为客开，翠萝深处遍苍苔。",
        "林间扫石安棋局，",
        "云山绕屋犹嫌浅，欲棹渔舟近钓台。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359002,
      "title": "春日郊园戏赠杨嘏评事",
      "content": [
        "十里蒹葭入薜萝，春风谁许暂鸣珂。",
        "相如渴后狂还减，",
        "野桥沽酒茅簷醉，谁羡红楼一曲歌。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359003,
      "title": "晚自东郭回留一二游侣",
      "content": [
        "乡心迢递宦情微，吏散寻幽竟落晖。",
        "林下草腥巢鹭宿，",
        "今夜西斋好风月，一瓢春酒莫相违。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359004,
      "title": "与郑秀才叔侄会送杨秀才昆仲东归",
      "content": [
        "书剑功迟白发新，异乡仍送故乡人。",
        "阮公留客竹林晚，",
        "洞庭烟月如终老，谁是长杨谏猎臣。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359005,
      "title": "送郭秀才游天台",
      "content": [
        "云埋阴壑雪凝峰，半壁天台已万重。",
        "人度碧溪疑辍棹，",
        "曾约共游今独去，赤城西面水溶溶。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359006,
      "title": "送张尊师归洞庭",
      "content": [
        "能琴道士洞庭西，风满归帆路不迷。",
        "对岸水花霜后浅，",
        "他日相思两行字，无人知处武陵溪。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359007,
      "title": "移摄太平寄前李明府",
      "content": [
        "病移岩邑称闲身，何处风光贳酒频。",
        "溪柳绕门彭泽令，",
        "早晚高台更同醉，绿萝如帐草如茵。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359008,
      "title": "再游姑苏玉芝观",
      "content": [
        "高梧一叶下秋初，迢递重廊旧寄居。",
        "月过碧窗今夜酒，",
        "明日挂帆更东去，仙翁应笑为鲈鱼。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359009,
      "title": "夜归驿楼",
      "content": [
        "水晚云秋山不穷，自疑身在画屏中。",
        "孤舟移棹一江月，",
        "早炊香稻待鲈鲙，南渚未明寻钓翁。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359010,
      "title": "题灵山寺行坚师院",
      "content": [
        "西岩一径不通樵，八十持杯未觉遥。",
        "龙在石潭闻夜雨，",
        "应笑东归又南去，越山无路水迢迢。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    }
  ],
