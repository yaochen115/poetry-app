        "name": "五言绝句"
      }
    },
    {
      "id": 25505,
      "title": "送王炎弼赴山阳守以兵卫森画戟宴寝凝清香为韵十首  其二",
      "content": [
        "别兄今几时，邦人指难弟。",
        "莫诵海沂康，两冯如鲁卫。"
      ],
      "author": {
        "id": 8698,
        "name": "曾协"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 25506,
      "title": "送王炎弼赴山阳守以兵卫森画戟宴寝凝清香为韵十首  其三",
      "content": [
        "公材如武库，剑槊方森森。",
        "亦复擅风流，坐继正始音。"
      ],
      "author": {
        "id": 8698,
        "name": "曾协"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 25507,
      "title": "送王炎弼赴山阳守以兵卫森画戟宴寝凝清香为韵十首  其四",
      "content": [
        "诗成啸诺余，谋出壶觞暇。",
        "却整进贤冠，麒麟要图画。"
      ],
      "author": {
        "id": 8698,
        "name": "曾协"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 25508,
      "title": "送王炎弼赴山阳守以兵卫森画戟宴寝凝清香为韵十首  其五",
      "content": [
        "公家西州烈，武事冠方册。",
        "祖孙世有人，要足门三戟。"
      ],
      "author": {
        "id": 8698,
        "name": "曾协"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 25509,
      "title": "送王炎弼赴山阳守以兵卫森画戟宴寝凝清香为韵十首  其六",
      "content": [
        "平生功名心，不肯事酣宴。",
        "向来话淮南，山川眼中见。"
      ],
      "author": {
        "id": 8698,
        "name": "曾协"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 25510,
      "title": "送王炎弼赴山阳守以兵卫森画戟宴寝凝清香为韵十首  其七",
      "content": [
        "楚国尚勇力，秉羽而甘寝。",
        "虽无倒载名，胜饮怀安鸩。"
      ],
      "author": {
        "id": 8698,
        "name": "曾协"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 25511,
      "title": "送王炎弼赴山阳守以兵卫森画戟宴寝凝清香为韵十首  其八",
      "content": [
        "疆事须长算，朝家得实能。",
        "坐来酬万务，心地自虚凝。"
      ],
      "author": {
        "id": 8698,
        "name": "曾协"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 25512,
      "title": "送王炎弼赴山阳守以兵卫森画戟宴寝凝清香为韵十首  其九",
      "content": [
        "复旦风云合，丹心日月明。",
        "江神回朗照，霁色向来清。"
      ],
      "author": {
        "id": 8698,
        "name": "曾协"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 25513,
      "title": "送王炎弼赴山阳守以兵卫森画戟宴寝凝清香为韵十首  其一○",
      "content": [
        "壶矢新油幕，春芜旧战场。",
        "候亭闲夜柝，归袖著天香。"
      ],
      "author": {
        "id": 8698,
        "name": "曾协"
      },
      "dynasty": {
