{
  "data": [
    {
      "id": 156240,
      "title": "纪事  其五",
      "content": [
        "慷慨轻身堕蒺藜，羝羊生乳是归期。",
        "岂无从史私袁盎，恨我从前少侍儿。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 156241,
      "title": "纪事  其六",
      "content": [
        "英雄未肯死前休，风起云飞不自由。",
        "杀我混同江外去，岂无曹翰守幽州。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 156242,
      "title": "纪事",
      "content": [
        "狼心那顾歃铜盘，舌在纵横击可汗。",
        "自分身为虀粉碎，虏中方作丈夫看。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 156243,
      "title": "纪事  其一",
      "content": [
        "不拚一死报封疆，忍使湖山牧虎狼。",
        "当日本为妻子计，而今何面见三光。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 156244,
      "title": "纪事  其二",
      "content": [
        "虎头牌子织金裳，北面三年蚁梦长。",
        "借问一门朱与紫，江南几世谢君王。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 156245,
      "title": "纪事  其三",
      "content": [
        "枭獍何堪共劝酬，衣冠涂炭可胜羞。",
        "袖中若有击贼笏，便使凶渠面血流。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 156246,
      "title": "纪事  其四",
      "content": [
        "麟笔严于首恶书，我将口舌击奸谀。",
        "虽非周勃安刘手，不愧当年产禄诛。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 156247,
      "title": "信云父  其一",
      "content": [
        "东鲁遗黎老子孙，南方心事北方身。",
        "几多江左腰金客，便把君王作路人。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 156248,
      "title": "信云父  其二",
      "content": [
        "肯从悟室课儿书，啮雪风流却减渠。",
        "我爱信陵冠带意，任教句法问何如。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 156249,
      "title": "则堂  其一",
      "content": [
        "山河四塞旧瓯金，艺祖高宗实鉴临。",
        "一日尽将输敌手，何人卖国独甘心。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 156250,
      "title": "则堂  其二",
      "content": [
        "中书堂帖下诸城，摇首庭中号独清。",
        "此后方知枢密事，从今北地转相惊。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 156251,
      "title": "思蒲塘",
      "content": [
        "扬旌来冉冉，卷旆去堂堂。",
        "恨我飞无翼，思君济有航。",
        "麒麟还共处，熊虎已何乡。",
        "南国应无恙，中兴事会长。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156252,
      "title": "思方将军",
      "content": [
        "始兴溪子下江淮，曾为东南再造来。",
        "如虎如熊今固在，将军何处上金台。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 156253,
      "title": "唆都",
      "content": [
        "虎牌毡笠号公卿，不直人间一唾轻。",
        "但愿扶桑红日上，江南匹士死犹荣。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 156254,
      "title": "二王",
      "content": [
        "一马渡江开晋土，五龙夹日复唐天。",
        "内家苗裔真隆准，虏运从来无百年。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 156255,
      "title": "气概",
      "content": [
        "气概如虹俺得知，留吴那肯竖降旗。",
        "北人不解欺心语，正恐南人作浅窥。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 156256,
      "title": "使北  其一",
      "content": [
        "自说家乡古相州，白麻风旨出狂酋。",
        "中书尽出降元表，北渡黄河衣锦游。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 156257,
      "title": "使北  其二",
      "content": [
        "至尊驰表献燕城，肉食那知以死争。",
        "当代老儒居首揆，殿前陪拜率公卿。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 156258,
      "title": "使北  其三",
      "content": [
        "江南浪子是何官，只当空庐杂剧看。",
        "拨取公卿如粪土，沐猴徒自辱衣冠。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 156259,
      "title": "使北  其四",
      "content": [
        "公子方张奉使旗，行行且尼复何为。",
        "似闻倾尽黄金坞，辛苦平生只为谁。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 156260,
      "title": "使北  其五",
      "content": [
        "廷争堂堂负直声，飘零沙漠若为情。",
        "程婴存赵真公志，頼有忠良壮此行。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 156261,
      "title": "使北  其六",
      "content": [
        "初修降表我无名，不是随班拜舞人。",
        "谁遣附庸祈请使，要教索虏识忠臣。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 156262,
      "title": "使北  其七",
      "content": [
        "客子漂摇万里程，北征情味似南征。",
        "小臣事主宁无罪，只作幽州谪吏行。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 156263,
      "title": "使北  其八",
      "content": [
        "使旃尽道有回期，独陷羁臣去牧羝。",
        "中尔含沙浑小事，白云飞处楚天低。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 156264,
      "title": "杜架阁  其一",
      "content": [
        "仗节辞王室，悠悠万里辕。",
        "诸君皆雨别，一士独星言。",
        "啼鸟乱人意，落花销客魂。",
        "东坡爱巢谷，颇恨晚登门。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156265,
      "title": "杜架阁  其二",
      "content": [
        "昔趋魏公子，今事霍将军。",
        "世态炎凉甚，交情贵贱分。",
        "黄沙扬暮霭，黑海起朝氛。",
        "独与君携手，行吟看白云。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156266,
      "title": "闻鸡",
      "content": [
        "军中二十日，此夕始闻鸡。",
        "尘暗天街静，沙长海路迷。",
        "铜驼随雨落，铁骑向风嘶。",
        "晓起呼詹尹，何时脱蒺藜。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156267,
      "title": "命里",
      "content": [
        "熊罴十万建行台，单骑谁教免胄来。",
        "一日捉将沙漠去，遭逢碧眼老回回。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 156268,
      "title": "留远亭  其一",
      "content": [
        "甘心卖国罪滔天，酒后猖狂诈作颠。",
        "把酒逢迎酋虏笑，从头骂坐数时贤。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 156269,
      "title": "留远亭  其二",
      "content": [
        "落得称呼浪子刘，樽前百媚佞旃裘。",
        "当年鲍老不如此，留远亭前犬也羞。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 156270,
      "title": "平江府",
      "content": [
        "楼台俯舟楫，城郭满干戈。",
        "故吏归心少，遗民出涕多。",
        "鸠居无鹊在，鱼网有鸿过。",
        "使遂睢阳志，安危今若何。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156271,
      "title": "无锡",
      "content": [
        "金山冉冉波涛雨，锡水泯泯草木春。",
        "二十年前曾去路，三千里外作行人。",
        "英雄未死心为碎，父老相逢鼻欲辛。",
        "夜读程婴存赵事，一回惆怅一沾巾。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 156272,
      "title": "吊五木",
      "content": [
        "首赴勤王役，成功事则天。",
        "富平名委地，好水泪成川。",
        "我作招魂想，谁为掩骼缘。",
        "中兴须再举，寄语慰重泉。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156273,
      "title": "哭尹玉",
      "content": [
        "团练濠州庙赣川，官其二子赐良田。",
        "西台捕逐多亡将，还有焚黄到墓前。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 156274,
      "title": "常州",
      "content": [
        "山河千里在，烟火一家无。",
        "壮甚睢阳守，冤哉马邑屠。",
        "苍天如可问，赤子果何辜。",
        "唇齿提封旧，抚膺三叹吁。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156275,
      "title": "镇江",
      "content": [
        "铁瓮山河旧，金瓯宇宙非。",
        "昔随西日上，今见北军飞。",
        "豪杰非无志，功名自有机。",
        "中流怀士稚，风雨湿双扉。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156276,
      "title": "渡瓜洲  其一",
      "content": [
        "跨江半壁阅千帆，虎在深山龙在潭。",
        "当日本为南制北，如今翻被北持南。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 156277,
      "title": "渡瓜洲  其二",
      "content": [
        "眼前风景异山河，无柰诸君笑语何。",
        "坐上有人正愁绝，胡儿便道是偻㑩。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 156278,
      "title": "吊战场",
      "content": [
        "连年淮水上，死者乱如麻。",
        "魂魄丘中土，英雄粪上花。",
        "士知忠厥主，人亦念其家。",
        "夷德无厌甚，皇天定福华。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156279,
      "title": "回京口",
      "content": [
        "早作田文去，终无苏武留。",
        "偷生宁伏剑，忍死欲焚舟。",
        "逸骥思超乘，飞鹰志脱鞲。",
        "登楼望江上，日日数行艘。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156280,
      "title": "思小村",
      "content": [
        "春云惨惨兮春水漫漫，思我故人兮行路难。",
        "君辕以南兮我辕以北，去日以远兮忧不可以终极。",
        "蹇予马兮江臯，式燕兮以游遨。",
        "念我平生兮思君鬰陶。",
        "在师中兮岂造次之可离，忠言不闻兮思君忸怩。",
        "毫厘之差兮天壤易位，驷不及舌兮脐不可噬。",
        "思我故人兮怀我亲，怀我亲兮思故人。",
        "怀哉怀哉，不可忍兮不如速死。",
        "慨百年之未半兮，胡中道而遄止。",
        "鲁连子兮义不帝秦，负玄德兮羽不名为人。",
        "委骨草莽兮时廼天命，自古孰无死兮首丘为正。",
        "我行我行兮梦寐所思，故人望我兮胡不归，胡不归。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 156281,
      "title": "沈颐家",
      "content": [
        "孤舟霜月逈，晓起入柴门。",
        "断岸行簪影，荒畦落履痕。",
        "江山浑在眼，宇宙付无言。",
        "昨夜三更梦，春风满故园。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156282,
      "title": "脱京口 定计难",
      "content": [
        "南北人人苦泣岐，壮心万折誓东归。",
        "若非斫案判生死，夜半何人敢突围。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 156283,
      "title": "脱京口 谋人难",
      "content": [
        "一片归心似乱云，逢人时漏话三分。",
        "当时若也私谋泄，春梦悠悠郭璞坟。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 156284,
      "title": "脱京口 踏路难",
      "content": [
        "烟火连甍铁瓮关，要寻间道走江干。",
        "何人肯为将军地，北府老兵思汉官。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 156285,
      "title": "脱京口 得船难",
      "content": [
        "经营十日苦无舟，惨惨椎心泪血流。",
        "渔父疑为神物遣，相逢扬子大江头。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 156286,
      "title": "脱京口 绐北难",
      "content": [
        "百计经营夜负舟，仓皇谁趣渡瓜洲。",
        "若非绐虏成宵遁，哭死界河天地愁。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 156287,
      "title": "脱京口 定变难",
      "content": [
        "老兵中变意差池，仓卒呼来朽索危。",
        "若使阿婆真一吼，目生随后悔何追。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 156288,
      "title": "脱京口 出门难",
      "content": [
        "罗刹盈庭夜色寒，人家灯火半阑珊。",
        "梦回跳出铁门限，世上一重人鬼关。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 156289,
      "title": "脱京口 出巷难",
      "content": [
        "不时徇铺路纵横，小队戎衣自出城。",
        "天假汉儿灯一炬，旁人只道是官行。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 156290,
      "title": "脱京口 出隘难",
      "content": [
        "袖携匕首学啣枚，横渡城关马欲猜。",
        "夜静天昏人影散，北军鼾睡正如雷。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 156291,
      "title": "脱京口 候船难",
      "content": [
        "待船三五立江干，眼欲穿时夜渐阑。",
        "若使长年期不至，江流便作汨罗看。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 156292,
      "title": "脱京口 上江难",
      "content": [
        "蒙冲两岸夹长川，鼠伏孤蓬棹向前。",
        "七里江边惊一喝，天教潮退阁巡船。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 156293,
      "title": "脱京口 得风难",
      "content": [
        "空中哨响到孤蓬，尽道江河田相公。",
        "神物自来扶正直，中流半夜一帆风。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 156294,
      "title": "脱京口 望城难",
      "content": [
        "自来百里半九十，望见城头路愈长。",
        "薄命只愁追者至，人人摇桨渡沧浪。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 156295,
      "title": "脱京口 上岸难",
      "content": [
        "岸行五里入真州，城外荒荒鬼也愁。",
        "忽听路人嗟叹说，昨朝哨马到江头。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 156296,
      "title": "脱京口 入城难",
      "content": [
        "轻身漂泊入銮江，太守欣然为避堂。",
        "若使闭城呼不应，人间生死路茫茫。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 156297,
      "title": "真州杂赋  其一",
      "content": [
        "四十羲娥落虎狼，今朝骑马入真阳。",
        "山川莫道非吾土，一见衣冠是故乡。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 156298,
      "title": "真州杂赋  其二",
      "content": [
        "聚观夹道卷红楼，夺得南朝一状头。",
        "将谓燕人骑屋看，而今马首向真州。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 156299,
      "title": "真州杂赋  其三",
      "content": [
        "卖却私盐一舸回，天教壮士果安排。",
        "子胥流向江南去，我独仓皇夜走淮。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 156300,
      "title": "真州杂赋  其四",
      "content": [
        "便把长江作界河，负舟半夜溯烟波。",
        "明朝方觉田文去，追骑如云可柰何。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 156301,
      "title": "真州杂赋  其五",
      "content": [
        "十二男儿夜出关，晓来到处捉南冠。",
        "博浪力士犹难觅，要觅张良更是难。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 156302,
      "title": "真州杂赋  其六",
      "content": [
        "我作朱金沙上游，诸君冠盖渡瓜洲。",
        "淮云一片不相隔，南北死生分路头。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 156303,
      "title": "真州杂赋  其七",
      "content": [
        "公卿北去共低眉，世事兴亡付不知。",
        "不是谋归全赵璧，东南那个是男儿。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 156304,
      "title": "天下赵",
      "content": [
        "皇王著姓复炎图，此是中兴受命符。",
        "独向迎銮呈瑞字，为言艺祖有灵无。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 156305,
      "title": "议纠合两淮复兴  其一",
      "content": [
        "清边堂上老将军，南望天家雨湿巾。",
        "为道两淮兵定出，相公同作歃盟人。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 156306,
      "title": "议纠合两淮复兴  其二",
      "content": [
        "扬州兵了约庐州，某向瓜洲某鹭洲。",
        "直下南徐侯自管，皇亲刺史统千舟。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 156307,
      "title": "议纠合两淮复兴  其三",
      "content": [
        "南八空归唐垒陷，包胥一出楚疆还。",
        "而今庙社存亡决，只看元戎进退间。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 156308,
      "title": "出真州  其一",
      "content": [
        "早约戎装去看城，联镳壕上叹风尘。",
        "谁知关出西门外，憔悴世间无告人。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 156309,
      "title": "出真州  其二",
      "content": [
        "扬州昨夜有人来，误把忠良按剑猜。",
        "怪道使君无见解，城门前日不应开。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 156310,
      "title": "出真州  其三",
      "content": [
        "琼花堂上意茫然，志士忠臣泪彻泉。",
        "頼有使君知义者，人方欲杀我犹怜。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 156311,
      "title": "出真州  其四",
      "content": [
        "秦庭痛哭血成川，翻讶中行背可鞭。",
        "南北共知忠义苦，平生只少两淮缘。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 156312,
      "title": "出真州  其五",
      "content": [
        "一别迎銮十八秋，重来意气落旄头。",
        "平山老子不收拾，南望端门泪雨流。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 156313,
      "title": "出真州  其六",
      "content": [
        "天地沉沉夜溯舟，鬼神未觉走何州。",
        "明朝遣间应无是，莫恐元戎逐客不。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 156314,
      "title": "出真州  其七",
      "content": [
        "人人争劝走淮西，莫犯翁翁按剑疑。",
        "我问平山堂下路，忠臣见诎有天知。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 156315,
      "title": "出真州  其八",
      "content": [
        "千金犯险脱旃裘，谁料南冠反见雠。",
        "记取小西门外事，年年上巳哭江头。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 156316,
      "title": "出真州  其九",
      "content": [
        "荒郊下马问何之，死活元来任便宜。",
        "不是白兵生眼孔，一团冤血有谁知。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 156317,
      "title": "出真州  其一○",
      "content": [
        "戎衣啧啧叹忠臣，为说城头不识人。",
        "押出相公州界去，真州城里牓安民。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 156318,
      "title": "出真州  其一一",
      "content": [
        "有客仓皇欲赴壕，一行性命等鸿毛。",
        "白兵送我扬州去，惟恐北军来捉逃。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 156319,
      "title": "出真州  其一二",
      "content": [
        "瓜洲相望隔山椒，烟树光中扬子桥。",
        "夜静啣枚莫轻语，草间惟恐有鸱鹗。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 156320,
      "title": "出真州  其一三",
      "content": [
        "真州送骏已回城，暗里依随马垛行。",
        "一阵西州三十里，摘星楼下打初更。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 156321,
      "title": "至扬州  其一",
      "content": [
        "此庙何神三十郎，问郎行客忒琅珰。",
        "荒阶枕籍无人问，风露满堂清夜长。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 156322,
      "title": "至扬州  其二",
      "content": [
        "谯鼓冬冬入四更，行行三五入西城。",
        "隔壕喝问无人应，怕恐人来捉眼生。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 156323,
      "title": "至扬州  其三",
      "content": [
        "怅怅乾坤靡所之，平山风露夜何其。",
        "翁翁岂有甘心事，何故高楼鼓角悲。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 156324,
      "title": "至扬州  其四",
      "content": [
        "城上兜鍪按剑看，四郊胡骑遶团团。",
        "平生不解杨朱泣，到此方知进退难。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 156325,
      "title": "至扬州  其五",
      "content": [
        "吾戴吾头向广陵，仰天无告可怜生。",
        "争如负命投东海，犹会乘风近玉京。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 156326,
      "title": "至扬州  其六",
      "content": [
        "海云渺渺楚天头，满路胡尘不自由。",
        "若使一朝俘上去，不如制命死扬州。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 156327,
      "title": "至扬州  其七",
      "content": [
        "路傍邂逅卖柴人，为说高沙可问津。",
        "此去侬家三十里，山坳聊可避风尘。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 156328,
      "title": "至扬州  其八",
      "content": [
        "且行且止正依违，仿佛长空曙影微。",
        "从者仓皇心绪急，各持议论泣牵衣。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 156329,
      "title": "至扬州  其九",
      "content": [
        "问谁攫去橐中金，僮仆双双不可寻。",
        "折节从今交国士，死生一片岁寒心。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 156330,
      "title": "至扬州  其一○",
      "content": [
        "颠崖一陷落千寻，奴仆偏生负主心。",
        "饥火相煎疲欲绝，满山荒草晓沉沉。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 156331,
      "title": "至扬州  其一一",
      "content": [
        "戴星欲赴野人家，曙色纷纷路愈赊。",
        "仓卒只从山半住，颓垣上有白云遮。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 156332,
      "title": "至扬州  其一二",
      "content": [
        "路逢败屋作鸡栖，白屋荒荒鬼哭悲。",
        "袖有金钱无米籴，假饶有米亦无炊。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 156333,
      "title": "至扬州  其一三",
      "content": [
        "扫退蜣蜋枕败墙，一朝何止九回肠。",
        "睡余扪虱沉沉坐，偏觉人间白昼长。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 156334,
      "title": "至扬州  其一四",
      "content": [
        "飘零无绪叹途穷，搔首踟蹰日已中。",
        "何处人声似潮溯，黑云骤起满山风。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 156335,
      "title": "至扬州  其一五",
      "content": [
        "昼阑万骑忽东行，鼠伏荒村命羽轻。",
        "隔壁但闻风雨过，人人顾影贺更生。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 156336,
      "title": "至扬州  其一六",
      "content": [
        "青衣山下汲荒泉，道遇腥风走不前。",
        "向晚归来号且哭，胡儿只为解腰缠。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 156337,
      "title": "至扬州  其一七",
      "content": [
        "眼穿只候卖柴回，今日堡城门不开。",
        "籴米已无消息至，黄昏惆怅下山来。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 156338,
      "title": "至扬州  其一八",
      "content": [
        "既投古庙觅藜羹，三五樵夫不识名。",
        "僮子似知予梦恶，生柴烧火到天明。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 156339,
      "title": "至扬州  其一九",
      "content": [
        "苦作江头乞食翁，一层破庙五更风。",
        "眼前境界身何许，始悟人间万法空。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    }
  ],
