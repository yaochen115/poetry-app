{
  "data": [
    {
      "id": 341906,
      "title": "凉州馆中与诸判官夜集",
      "content": [
        "弯弯月出挂城头，城头月出照梁州。",
        "凉州七里十万家，",
        "河西幕中多故人，故人别来三五春。",
        "花门楼前见秋草，"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 341907,
      "title": "酒泉太守席上醉后作",
      "content": [
        "琵琶长笛曲相和，羌儿胡雏齐唱歌。",
        "浑炙犁牛烹野驼，"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 341908,
      "title": "偃师东与韩樽同诣景云晖上人即事",
      "content": [
        "山阴老僧解楞伽，颍阳归客远相过。",
        "烟深草湿昨夜雨，",
        "尚书碛上黄昏钟，别驾渡头一归鸟。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 341909,
      "title": "醉题匡城周少府厅壁",
      "content": [
        "妇姑城南风雨秋，妇姑城中人独愁。",
        "愁云遮却望乡处，",
        "颍阳秋草今黄尽，醉卧君家犹未还。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 341910,
      "title": "敦煌太守后庭歌",
      "content": [
        "敦煌太守才且贤，郡中无事高枕眠。",
        "太守到来山出泉，",
        "城头月出星满天，曲房置酒张锦筵。",
        "美人红妆色正鲜，",
        "为君手把珊瑚鞭，射得半段黄金钱，此中乐事亦已偏。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 341911,
      "title": "喜韩樽相过",
      "content": [
        "三月灞陵春已老，故人相逢耐醉倒。",
        "瓮头春酒黄花脂，",
        "桃花点地红斑斑，有酒留君且莫还。",
        "与君兄弟日携手，"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 341912,
      "title": "银山碛西馆",
      "content": [
        "银山碛口风似箭，铁门关西月如练。",
        "双双愁泪沾马毛，"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 341913,
      "title": "感遇",
      "content": [
        "五花骢马七香车，云是平阳帝子家。",
        "凤凰城头日欲斜，",
        "昔来唯有秦王女，独自吹箫乘白云。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 341914,
      "title": "太白胡僧歌",
      "content": [
        "闻有胡僧在太白，兰若去天三百尺。",
        "一持楞伽入中峰，",
        "草衣不针复不线，两耳垂肩眉覆面。",
        "此僧年几那得知，",
        "商山老人已曾识，愿一见之何由得。",
        "山中有僧人不知，"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 341915,
      "title": "卫节度赤骠马歌",
      "content": [
        "君家赤骠画不得，一团旋风桃花色。",
        "红缨紫鞚珊瑚鞭，",
        "自矜诸马皆不及，却忆百金新买时。",
        "香街紫陌凤城内，",
        "紫髯胡雏金剪刀，平明剪出三鬃高。",
        "枥上看时独意气，",
        "草头一点疾如飞，却使苍鹰翻向后。",
        "忆昨看君朝未央，",
        "男儿称意得如此，骏马长鸣北风起。",
        "待君东去扫胡尘，"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 341916,
      "title": "田使君美人舞如莲花北鋋歌",
      "content": [
        "美人舞如莲花旋，世人有眼应未见。",
        "高堂满地红氍毹，",
        "慢脸娇娥纤复秾，轻罗金缕花葱茏。",
        "回裾转袖若飞雪，",
        "忽作出塞入塞声，白草胡沙寒飒飒。",
        "翻身入破如有神，",
        "世人学舞只是舞，恣态岂能得如此。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 341917,
      "title": "裴将军宅芦管歌",
      "content": [
        "辽东九月芦叶断，辽东小儿采芦管。",
        "可怜新管清且悲，",
        "白狼河北堪愁恨，玄兔城南皆断肠。",
        "辽东将军长安宅，",
        "夜半高堂客未回，只将芦管送君杯。",
        "巧能陌上惊杨柳，",
        "将军醉舞不肯休，更使美人吹一曲。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 341918,
      "title": "韦员外家花树歌",
      "content": [
        "今年花似去年好，去年人到今年老。",
        "始知人老不如花，",
        "朝回花底恒会客，花扑玉缸春酒香。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 341919,
      "title": "醉后戏与赵歌儿",
      "content": [
        "秦州歌儿歌调苦，偏能立唱濮阳女。",
        "座中醉客不得意，"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 341920,
      "title": "范公丛竹歌",
      "content": [
        "世人见竹不解爱，知君种竹府城内。",
        "此君托根幸得地，",
        "能清案牍帘下见，宜对琴书窗外看。",
        "为君成阴将蔽日，",
        "君莫爱南山松树枝，竹色四时也不移。",
        "寒天草木黄落尽，"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 341921,
      "title": "玉门关盖将军歌",
      "content": [
        "盖将军，真丈夫。",
        "行年三十执金吾，身长七尺颇有须。",
        "玉门关城迥且孤，黄沙万里白草枯。",
        "南邻犬戎北接胡，",
        "暖屋绣帘红地炉，织成壁衣花氍毹。",
        "灯前侍婢泻玉壶，",
        "美人一双闲且都，朱唇翠眉映明𪾦。",
        "清歌一曲世所无，",
        "野草绣窠紫罗襦，红牙缕马对樗蒱。",
        "玉盘纤手撒作卢，",
        "骑将猎向城南隅，腊日射杀千年狐。",
        "我来塞外按边储，"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 341922,
      "title": "赠酒泉韩太守",
      "content": [
        "太守有能政，遥闻如古人。",
        "俸钱尽供客，家计常清贫。",
        "酒泉西望玉关道，千山万碛皆白草。",
        "辞君走马归长安，"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 341923,
      "title": "赠西岳山人李冈",
      "content": [
        "君隐处，当一星。",
        "莲花峰头饭黄精，仙人掌上演丹经。",
        "鸟可到，人莫攀，隐来十年不下山。",
        "袖中短书谁为达，"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 341924,
      "title": "送张献心充副使归河西杂句",
      "content": [
        "将门子弟君独贤，一从受命常在边。",
        "未至三十已高位，",
        "箧中赐衣十重余，案上军书十二卷。",
        "看君谋智若有神，",
        "云中昨夜使星动，西门驿楼出相送。",
        "玉瓶素蚁腊酒香，"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 341925,
      "title": "送郭乂杂言",
      "content": [
        "地上青草出，经冬今始归。",
        "博陵无近信，犹未换春衣。",
        "怜汝不忍别，送汝上酒楼。",
        "初行莫早发，且宿霸桥头。",
        "功名须及早，岁月莫虚掷。",
        "早年已工诗，近日兼注易。",
        "何时过东洛，早晚度盟津。",
        "朝歌城边柳亸地，",
        "曾上君家县北楼，楼上分明见恒岳。",
        "中山明府待君来，"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 341926,
      "title": "送魏升卿擢第归东都，因怀魏校书、陆浑、乔潭",
      "content": [
        "井上桐叶雨，灞亭卷秋风。",
        "故人适战胜，匹马归山东。",
        "问君今年三十几，能使香名满人耳。",
        "君不见三峰直上五千仞，见君文章亦如此。",
        "如君兄弟天下稀，雄辞健笔皆若飞。",
        "将军金印亸紫绶，",
        "魏侯校理复何如，前日人来不得书。",
        "陆浑山下佳可赏，",
        "垆头青丝白玉瓶，别时相顾酒如倾。",
        "摇鞭举袂忽不见，"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 341927,
      "title": "送魏四落第还乡",
      "content": [
        "东归不称意，客舍戴胜鸣。",
        "腊酒饮未尽，春衫缝已成。",
        "长安柳枝春欲来，洛阳梨花在前开。",
        "魏侯池馆今尚在，",
        "莫令别后无佳句，只向垆头空醉眠。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 341928,
      "title": "送宇文南金放后归太原寓居，因呈太原郝主簿",
      "content": [
        "归去不得意，北京关路赊。",
        "却投晋山老，愁见汾阳花。",
        "翻作灞陵客，怜君丞相家。",
        "夜眠旅舍雨，晓辞春城鸦。",
        "送君系马青门口，胡姬垆头劝君酒。",
        "为问太原贤主人，"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 341929,
      "title": "西亭子送李司马",
      "content": [
        "高高亭子郡城西，直上千尺与云齐。",
        "盘崖缘壁试攀跻，",
        "坐来一望无端倪，红花绿柳莺乱啼。",
        "千家万井连回溪，",
        "草萋萋，没马蹄。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 341930,
      "title": "渔父",
      "content": [
        "扁舟沧浪叟，心与沧浪清。",
        "不自道乡里，无人知姓名。",
        "朝从滩上饭，暮向芦中宿。",
        "歌竟还复歌，手持一竿竹。",
        "竿头钓丝长丈余，鼓枻乘流无定居。",
        "世人那得识深意，"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 341931,
      "title": "登古邺城",
      "content": [
        "下马登邺城，城空复何见。",
        "东风吹野火，暮入飞云殿。",
        "城隅南对望陵台，漳水东流不复回。",
        "武帝宫中人去尽，"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 341932,
      "title": "邯郸客舍歌",
      "content": [
        "客从长安来，驱马邯郸道。",
        "伤心丛台下，一带生蔓草。",
        "客舍门临漳水边，垂杨下系钓鱼船。",
        "邯郸女儿夜沽酒，"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 341933,
      "title": "宿蒲关东店，忆杜陵别业",
      "content": [
        "关门锁归客，一夜梦还家。",
        "月落河上晓，遥闻秦树鸦。",
        "长安二月归正好，杜陵树边纯是花。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 341935,
      "title": "优钵罗花歌",
      "content": [
        "白山南，赤山北。",
        "其间有花人不识，绿茎碧叶好颜色。",
        "叶六瓣，花九房。",
        "夜掩朝开多异香，",
        "耻与众草之为伍，何亭亭而独芳。",
        "何不为人之所赏兮，"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 341936,
      "title": "蜀葵花歌",
      "content": [
        "昨日一花开，今日一花开。",
        "今日花正好，昨日花已老。",
        "始知人老不如花，可惜落花君莫扫。",
        "人生不得长少年，"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 341937,
      "title": "题李士曹厅壁画度雨云歌",
      "content": [
        "似出栋梁里，如和风雨飞。",
        "掾曹有时不敢归，"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 341939,
      "title": "长门怨",
      "content": [
        "君王嫌妾妒，闭妾在长门。",
        "舞袖垂新宠，愁眉结旧恩。",
        "绿钱侵履迹，红粉湿啼痕。",
        "羞被夭桃笑，看春独不言。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 341945,
      "title": "江行夜宿龙吼滩，临眺思峨眉隐者，兼寄幕中诸公",
      "content": [
        "官舍临江口，滩声人惯闻。",
        "水烟晴吐月，山火夜烧云。",
        "且欲寻方士，无心恋使君。",
        "异乡何可住，况复久离群。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 341946,
      "title": "汉川山行，呈成少尹",
      "content": [
        "西蜀方携手，南宫忆比肩。",
        "平生犹不浅，羁旅转相怜。",
        "山店云迎客，江村犬吠船。",
        "秋来取一醉，须待月光眠。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 341950,
      "title": "酬崔十三侍御登玉垒山思故园见寄",
      "content": [
        "玉垒天晴望，诸峰尽觉低。",
        "故园江树北，斜日岭云西。",
        "旷野看人小，长空共鸟齐。",
        "高山徒仰止，不得日攀跻。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 341954,
      "title": "崔驸马山池重送宇文明府",
      "content": [
        "竹里过红桥，花间藉绿苗。",
        "池凉醒别酒，山翠拂行镳。",
        "凤去妆楼闭，凫飞叶县遥。",
        "不逢秦女在，何处听吹箫。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 341959,
      "title": "浐水东店送唐子归嵩阳",
      "content": [
        "野店临官路，重城压御堤。",
        "山开灞水北，雨过杜陵西。",
        "归梦秋能作，乡书醉懒题。",
        "桥回忽不见，征马尚闻嘶。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 341961,
      "title": "水亭送刘颙使还归节度",
      "content": [
        "无计留君住，应须绊马蹄。",
        "红亭莫惜醉，白日眼看低。",
        "解带怜高柳，移床爱小溪。",
        "此来相见少，正事各东西。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 341962,
      "title": "送杨录事充潼关判官",
      "content": [
        "夫子方寸里，秋天澄霁江。",
        "关西望第一，郡内政无双。",
        "狭室下珠箔，连宵倾玉缸。",
        "平明犹未醉，斜月隐书窗。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 341964,
      "title": "送陕县王主簿赴襄阳成亲",
      "content": [
        "六月襄山道，三星汉水边。",
        "求凰应不远，去马剩须鞭。",
        "野店愁中雨，江城梦里蝉。",
        "襄阳多故事，为我访先贤。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 341965,
      "title": "送李卿，赋得孤岛石",
      "content": [
        "一片他山石，巉巉映小池。",
        "绿窠攒剥藓，尖硕坐鸬鹚。",
        "水底看常倒，花边势欲欹。",
        "君心能不转，卿月岂相离。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 341968,
      "title": "送郑堪归东京汜水别业",
      "content": [
        "客舍见春草，忽闻思旧山。",
        "看君灞陵去，匹马成皋还。",
        "对酒风与雪，向家河复关。",
        "因悲宦游子，终岁无时闲。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 341969,
      "title": "送崔全被放归都觐省",
      "content": [
        "夫子不自炫，世人知者稀。",
        "来倾阮氏酒，去著老莱衣。",
        "渭北草新出，关东花欲飞。",
        "楚王犹自惑，宋玉且将归。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 341972,
      "title": "送杨千牛趁岁赴汝南郡觐省便成婚",
      "content": [
        "问吉转征鞍，安仁道姓潘。",
        "归期明主赐，别酒故人欢。",
        "珠箔障炉暖，狐裘耐腊寒。",
        "汝南遥倚望，早去及春盘。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 341976,
      "title": "送张郎中赴陇右觐省卿公",
      "content": [
        "中郎凤一毛，世上独贤豪。",
        "弱冠已银印，出身唯宝刀。",
        "还家卿月迥，度陇将星高。",
        "幕下多相识，边书醉懒操。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 341977,
      "title": "送楚丘麹少府赴官",
      "content": [
        "青袍美少年，黄绶一神仙。",
        "微子城东面，梁王苑北边。",
        "桃花色似马，榆荚小于钱。",
        "单父闻相近，家书早为传。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 341978,
      "title": "送蜀郡李掾",
      "content": [
        "饮酒俱未醉，一言聊赠君。",
        "功曹善为政，明主还应闻。",
        "夜宿剑门月，朝行巴水云。",
        "江城菊花发，满道香氛氲。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 341980,
      "title": "还高冠潭口留别舍弟",
      "content": [
        "昨日山有信，只今耕种时。",
        "遥传杜陵叟，怪我还山迟。",
        "独向潭上酌，无人林下棋。",
        "东溪忆汝处，闲卧对鸬鹚。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 341981,
      "title": "醴泉东溪送程皓、元镜微入蜀",
      "content": [
        "蜀郡路漫漫，梁州过七盘。",
        "二人来信宿，一县醉衣冠。",
        "溪逼春衫冷，林交宴席寒。",
        "西南如喷酒，遥向雨中看。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 341986,
      "title": "送薛彦伟擢第东归",
      "content": [
        "时辈似君稀，青春战胜归。",
        "名登郤诜第，身著老莱衣。",
        "称意人皆羡，还家马若飞。",
        "一枝谁不折，棣萼独相辉。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 341992,
      "title": "送蒲秀才擢第归蜀",
      "content": [
        "去马疾如飞，看君战胜归。",
        "新登郤诜第，更著老莱衣。",
        "汉水行人少，巴山客舍稀。",
        "向南风候暖，腊月见春辉。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 341993,
      "title": "送郭司马赴伊吾郡请示李明府",
      "content": [
        "安西美少年，脱剑卸弓弦。",
        "不倚将军势，皆称司马贤。",
        "秋山城北面，古治郡东边。",
        "江上舟中月，遥思李郭仙。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 341997,
      "title": "送弘文李校书往汉南拜亲",
      "content": [
        "未识已先闻，清辞果出群。",
        "如逢祢处士，似见鲍参军。",
        "梦暗巴山雨，家连汉水云。",
        "慈亲思爱子，几度泣沾裙。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 341998,
      "title": "送李别将摄伊吾令充使赴武威，便寄崔员外",
      "content": [
        "词赋满书囊，胡为在战场。",
        "行间脱宝剑，邑里挂铜章。",
        "马疾飞千里，凫飞向五凉。",
        "遥知竹林下，星使对星郎。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 342000,
      "title": "送张都尉东归",
      "content": [
        "白羽绿弓弦，年年只在边。",
        "还家剑锋尽，出塞马蹄穿。",
        "逐虏西逾海，平胡北到天。",
        "封侯应不远，燕颔岂徒然。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 342004,
      "title": "赵少尹南亭送郑侍御归东台",
      "content": [
        "红亭酒瓮香，白面绣衣郎。",
        "砌冷虫喧坐，帘疏雨到床。",
        "钟催离兴急，弦逐醉歌长。",
        "关树应先落，随君满鬓霜。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 342007,
      "title": "送秘省虞校书赴虞乡丞",
      "content": [
        "花绶傍腰新，关东县欲春。",
        "残书厌科斗，旧阁别麒麟。",
        "虞阪临官舍，条山映吏人。",
        "看君有知己，坦腹向平津。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 342008,
      "title": "送江陵泉少府赴任，便呈卫荆州",
      "content": [
        "神仙吏姓梅，人吏待君来。",
        "渭北草新出，江南花已开。",
        "城边宋玉宅，峡口楚王台。",
        "不畏无知己，荆州甚爱才。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 342013,
      "title": "陕州月城楼送辛判官入奏",
      "content": [
        "送客飞鸟外，城头楼最高。",
        "樽前遇风雨，窗里动波涛。",
        "谒帝向金殿，随身唯宝刀。",
        "相思灞陵月，只有梦偏劳。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 342016,
      "title": "送羽林长孙将军赴歙州",
      "content": [
        "剖竹向江𣸣，能名计日闻。",
        "隼旗新刺史，虎剑旧将军。",
        "驿舫宿湖月，州城浸海云。",
        "青门酒楼上，欲别醉醺醺。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 342018,
      "title": "送梁判官归女几旧庐",
      "content": [
        "女几知君忆，春云相逐归。",
        "草堂开药裹，苔壁取荷衣。",
        "老竹移时小，新花旧处飞。",
        "可怜真傲吏，尘事到山稀。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 342023,
      "title": "送绵州李司马秩满归京，因呈李兵部",
      "content": [
        "久客厌江月，罢官思早归。",
        "眼看春光老，羞见梨花飞。",
        "剑北山居小，巴南音信稀。",
        "因君报兵部，愁泪日沾衣。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 342025,
      "title": "送柳录事赴梁州",
      "content": [
        "英掾柳家郎，离亭酒瓮香。",
        "折腰思汉北，随传过巴阳。",
        "江树连官舍，山云到卧床。",
        "知君归梦积，去去剑川长。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 342032,
      "title": "发临洮将赴北庭留别",
      "content": [
        "闻说轮台路，连年见雪飞。",
        "春风曾不到，汉使亦应稀。",
        "白草通疏勒，青山过武威。",
        "勤王敢道远，私向梦中归。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 342033,
      "title": "临洮泛舟，赵仙舟自北庭罢使还京",
      "content": [
        "白发轮台使，边功竟不成。",
        "云沙万里地，孤负一书生。",
        "池上风回舫，桥西雨过城。",
        "醉眠乡梦罢，东望羡归程。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 342034,
      "title": "春日醴泉杜明府承恩五品宴席上赋诗",
      "content": [
        "凫舄旧称仙，鸿私降自天。",
        "青袍移草色，朱绶夺花然。",
        "邑里雷仍震，台中星欲悬。",
        "吾兄此栖棘，因得贺初筵。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 342035,
      "title": "早春陪崔中丞同泛浣花溪宴",
      "content": [
        "旌节临溪口，寒郊陡觉暄。",
        "红亭移酒席，画舸逗江村。",
        "云带歌声飏，风飘舞袖翻。",
        "花间催秉烛，川上欲黄昏。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 342037,
      "title": "行军雪后月夜宴王卿家",
      "content": [
        "子夜雪华余，卿家月影初。",
        "酒香熏枕席，炉气暖轩除。",
        "晚岁宦情薄，行军欢宴疏。",
        "相逢剩取醉，身外尽空虚。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 342038,
      "title": "梁州陪赵行军龙冈寺北庭泛舟宴王侍御",
      "content": [
        "谁宴霜台使，行军粉署郎。",
        "唱歌江鸟没，吹笛岸花香。",
        "酒影摇新月，滩声聒夕阳。",
        "江钟闻已暮，归棹绿川长。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 342039,
      "title": "奉陪封大夫宴，得征字，时封公兼鸿胪卿",
      "content": [
        "西边虏尽平，何处更专征。",
        "幕下人无事，军中政已成。",
        "座参殊俗语，乐杂异方声。",
        "醉里东楼月，偏能照列卿。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 342040,
      "title": "陪封大夫宴瀚海亭纳凉",
      "content": [
        "细管杂青丝，千杯倒接z5。",
        "军中乘兴出，海上纳凉时。",
        "日没鸟飞急，山高云过迟。",
        "吾从大夫后，归路拥旌旗。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 342041,
      "title": "虢州西亭陪端公宴集",
      "content": [
        "红亭出鸟外，骏马系云端。",
        "万岭窗前睥，千家肘底看。",
        "开瓶酒色嫩，踏地叶声干。",
        "为逼霜台使，重裘也觉寒。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 342042,
      "title": "陪使君早春东郊游眺",
      "content": [
        "太守拥朱轮，东郊物候新。",
        "莺声随坐啸，柳色唤行春。",
        "谷口云迎马，溪边水照人。",
        "郡中叨佐理，何幸接芳尘。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 342043,
      "title": "雪后与群公过慈恩寺",
      "content": [
        "乘兴忽相招，僧房暮与朝。",
        "雪融双树湿，沙暗一灯烧。",
        "竹外山低塔，藤间院隔桥。",
        "归家如欲懒，俗虑向来销。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 342044,
      "title": "与鄠县群官泛渼陂",
      "content": [
        "万顷浸天色，千寻穷地根。",
        "舟移城入树，岸阔水浮村。",
        "闲鹭惊箫管，潜虬傍酒樽。",
        "暝来呼小吏，列火俨归轩。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 342046,
      "title": "终南东溪中作",
      "content": [
        "溪水碧于草，潺潺花底流。",
        "沙平堪濯足，石浅不胜舟。",
        "洗药朝与暮，钓鱼春复秋。",
        "兴来从所适，还欲向沧洲。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 342047,
      "title": "与鲜于庶子泛汉江",
      "content": [
        "急管更须吹，杯行莫遣迟。",
        "酒光红琥珀，江色碧琉璃。",
        "日影浮归棹，芦花罥钓丝。",
        "山公醉不醉，问取葛强知。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 342050,
      "title": "登总持阁",
      "content": [
        "高阁逼诸天，登临近日边。",
        "晴开万井树，愁看五陵烟。",
        "槛外低秦岭，窗中小渭川。",
        "早知清净理，常愿奉金仙。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 342053,
      "title": "宿岐州北郭严给事别业",
      "content": [
        "郭外山色暝，主人林馆秋。",
        "疏钟入卧内，片月到床头。",
        "遥夜惜已半，清言殊未休。",
        "君虽在青琐，心不忘沧洲。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 342054,
      "title": "暮秋会严京兆后厅竹斋",
      "content": [
        "京兆小斋宽，公庭半药阑。",
        "瓯香茶色嫩，窗冷竹声干。",
        "盛德中朝贵，清风画省寒。",
        "能将吏部镜，照取寸心看。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 342055,
      "title": "省中即事",
      "content": [
        "华省谬为郎，蹉跎鬓已苍。",
        "到来恒幞被，随例且含香。",
        "竹影遮窗暗，花阴拂簟凉。",
        "君王新赐笔，草奏向明光。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 342058,
      "title": "春寻河阳陶处士别业",
      "content": [
        "风暖日暾暾，黄鹂飞近村。",
        "花明潘子县，柳暗陶公门。",
        "药碗摇山影，鱼竿带水痕。",
        "南桥车马客，何事苦喧喧。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 342059,
      "title": "晚过磐石寺礼郑和尚",
      "content": [
        "暂诣高僧话，来寻野寺孤。",
        "岸花藏水碓，溪水映风炉。",
        "顶上巢新鹊，衣中带旧珠。",
        "谈禅未得去，辍棹且踟蹰。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 342060,
      "title": "寻少室张山人，闻与偃师周明府同入都",
      "content": [
        "中峰炼金客，昨日游人间。",
        "叶县凫共去，葛陂龙暂还。",
        "春云凑深水，秋雨悬空山。",
        "寂寂清溪上，空余丹灶闲。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 342061,
      "title": "虢州卧疾，喜刘判官相过水亭",
      "content": [
        "卧疾尝晏起，朝来头未梳。",
        "见君胜服药，清话病能除。",
        "低柳共系马，小池堪钓鱼。",
        "观棋不觉暝，月出水亭初。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 342062,
      "title": "武威春暮，闻宇文判官西使还，已到晋昌",
      "content": [
        "岸雨过城头，黄鹂上戍楼。",
        "塞花飘客泪，边柳挂乡愁。",
        "白发悲明镜，青春换敝裘。",
        "君从万里使，闻已到瓜州。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 342064,
      "title": "春兴思南山旧庐，招柳建正字",
      "content": [
        "终岁不得意，春风今复来。",
        "自怜蓬鬓改，羞见梨花开。",
        "西掖诚可恋，南山思早回。",
        "园庐幸接近，相与归蒿莱。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 342066,
      "title": "高冠谷口招郑鄠",
      "content": [
        "谷口来相访，空斋不见君。",
        "涧花然暮雨，潭树暖春云。",
        "门径稀人迹，簷峰下鹿群。",
        "衣裳与枕席，山霭碧氛氲。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 342068,
      "title": "题山寺僧房",
      "content": [
        "窗影摇群木，墙阴载一峰。",
        "野炉风自𦶟，山碓水能舂。",
        "勤学翻知误，为官好欲慵。",
        "高僧暝不见，月出但闻钟。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 342072,
      "title": "初授官题高冠草堂",
      "content": [
        "三十始一命，宦情多欲阑。",
        "自怜无旧业，不敢耻微官。",
        "涧水吞樵路，山花醉药栏。",
        "只缘五斗米，辜负一渔竿。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 342073,
      "title": "题虢州西楼",
      "content": [
        "错料一生事，蹉跎今白头。",
        "纵横皆失计，妻子也堪羞。",
        "明主虽然弃，丹心亦未休。",
        "愁来无去处，只上郡西楼。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 342074,
      "title": "夜过磐石，隔河望永乐，寄闺中，效齐梁体",
      "content": [
        "盈盈一水隔，寂寂二更初。",
        "波上思罗袜，鱼边忆素书。",
        "月如眉已画，云似鬓新梳。",
        "春物知人意，桃花笑索居。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 342076,
      "title": "过酒泉，忆杜陵别业",
      "content": [
        "昨夜宿祁连，今朝过酒泉。",
        "黄沙西际海，白草北连天。",
        "愁里难消日，归期尚来年。",
        "阳关万里梦，知处杜陵田。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 342077,
      "title": "早发焉耆，怀终南别业",
      "content": [
        "晓笛别乡泪，秋冰鸣马蹄。",
        "一身虏云外，万里胡天西。",
        "终日见征战，连年闻鼓鼙。",
        "故山在何处，昨日梦清溪。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 342079,
      "title": "首秋轮台",
      "content": [
        "异域阴山外，孤城雪海边。",
        "秋来唯有雁，夏尽不闻蝉。",
        "雨拂毡墙湿，风摇毳幕膻。",
        "轮台万里地，无事历三年。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 342080,
      "title": "北庭作",
      "content": [
        "雁塞通盐泽，龙堆接醋沟。",
        "孤城天北畔，绝域海西头。",
        "秋雪春仍下，朝风夜不休。",
        "可知年四十，犹自未封侯。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 342082,
      "title": "还东山洛上作",
      "content": [
        "春流急不浅，归枻去何迟。",
        "愁客叶舟里，夕阳花水时。",
        "云晴开䗖蝀，棹发起鸬鹚。",
        "莫道东山远，衡门在梦思。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 342083,
      "title": "杨固店",
      "content": [
        "客舍梨叶赤，邻家闻捣衣。",
        "夜来尝有梦，坠泪缘思归。",
        "洛水行欲尽，缑山看渐微。",
        "长安只千里，何事信音稀。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 342084,
      "title": "巴南舟中，思陆浑别业",
      "content": [
        "泸水南州远，巴山北客稀。",
        "岭云撩乱起，溪鹭等闲飞。",
        "镜里愁衰鬓，舟中换旅衣。",
        "梦魂知忆处，无夜不先归。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
