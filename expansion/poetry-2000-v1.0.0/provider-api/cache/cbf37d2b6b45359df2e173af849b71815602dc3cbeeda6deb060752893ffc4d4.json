{
  "data": [
    {
      "id": 210147,
      "title": "秋词二首  其一",
      "content": [
        "云惹低空不更飞，班班红叶欲辞枝。",
        "秋光未老仍微暖，恰似梅花结子时。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 210148,
      "title": "秋词二首  其二",
      "content": [
        "无数青莎绕玉阶，夕阳红浅过墙来。",
        "西风莫道无情思，未放芙蓉取次开。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 210149,
      "title": "齐逸亭",
      "content": [
        "燄发郎君更不归，故亭萧瑟异当时。",
        "玉笙金管浑如梦，只有梅花三四枝。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 210150,
      "title": "春日",
      "content": [
        "残腊渺茫云外日，新春仿佛梦中来。",
        "雪霜便觉都无力，只见桃花次第开。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 210151,
      "title": "宿干明方丈",
      "content": [
        "漫天白雪无端现，佛室夜艾乌更啼。",
        "相逢解颐足自慰，勿语俗子念心携。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 210152,
      "title": "新开湖送孙诚之有龙见于东北因成绝句",
      "content": [
        "狂客走影暗悠悠，菡萏吹风五月秋。",
        "黄绶不为无气概，苍龙垂尾送行舟。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 210153,
      "title": "呈李公择",
      "content": [
        "青笺擘处银钩断，红袂分时五筯悬。",
        "云脚渐收风色紧，半规斜日射归船。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 210154,
      "title": "落日马上",
      "content": [
        "日落荒阡白雾深，紫骝嘶顾出疏林。",
        "回头已失来时路，杳杳金盘堕翠岑。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 210155,
      "title": "次韵参寥三首  其一",
      "content": [
        "武陵渔子入花源，但见秦人不得仙。",
        "会有黄鹂鸣翠柳，何妨白眼望青天。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 210156,
      "title": "次韵参寥三首  其二",
      "content": [
        "长安仕路与云齐，倦仆羸骖不可跻。",
        "但得玄晖曾折简，何须平子更安题。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 210157,
      "title": "次韵参寥三首  其三",
      "content": [
        "且折花枝醉复醒，人间时节易峥嵘。",
        "屠龙肯自羞无用，画虎从人笑不成。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 210158,
      "title": "和书天庆观贺秘监堂三首  其一",
      "content": [
        "老仙旧地枕东城，古木参天警昼声。",
        "我亦愿为方外友，风流何必并时生。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 210159,
      "title": "和书天庆观贺秘监堂三首  其二",
      "content": [
        "史君平昔慕玄清，一到祠堂意一新。",
        "户外黄冠应指点，公应便是谪仙人。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 210160,
      "title": "和书天庆观贺秘监堂三首  其三",
      "content": [
        "衣屦萧条气久清，豪家门馆未尝行。",
        "朱甍碧瓦何从得，疑有阴兵夜助成。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 210161,
      "title": "和书观妙庵",
      "content": [
        "龙瑞宫中种玉人，诛茅结室傍秋云。",
        "自言洞里山川别，此处千分未一分。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 210162,
      "title": "早春题僧舍",
      "content": [
        "东园紫梅初破蕾，北涧渌水方通流。",
        "归去一春花月梦，定应多在此中游。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 210163,
      "title": "盆池钓翁",
      "content": [
        "谁刻仙材作钓翁，尺池终日钓微风。",
        "令人却忆鸱夷子，散发五湖狂醉中。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 210164,
      "title": "赏酴醾有感",
      "content": [
        "春来百物不入眼，唯见此花堪断肠。",
        "借问断肠缘底事，罗衣曾似此花香。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 210165,
      "title": "王昭君",
      "content": [
        "汉宫选女适单于，明妃敛袂登毡车。",
        "玉容寂寞花无主，顾影低回泣路隅。",
        "行行渐入阴山路，目送征鸿入云去。",
        "独抱琵琶恨更深，汉宫不见空回顾。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 210166,
      "title": "乐昌公主",
      "content": [
        "金陵往昔帝王州，乐昌主第最风流。",
        "一朝隋兵到江上，共抱凄凄去国愁。",
        "越公万骑鸣笳鼓，剑拥玉人天上去。",
        "空携破镜望红尘，千古江枫笼辇路。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 210167,
      "title": "崔徽",
      "content": [
        "蒲中有女号崔徽，轻似南山翡翠儿。",
        "使君当日最宠爱，坐中对客常拥持。",
        "一见裴郎心似醉，夜解罗衣与门吏。",
        "西门寺里乐未央，乐府至今歌翡翠。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 210168,
      "title": "无双",
      "content": [
        "尚书有女名无双，蛾眉如画学新妆。",
        "伊家仙客最明俊，舅母唯只呼王郎。",
        "尚书往日先曾许，数载暌违今复遇。",
        "闻说襄江二十年，当时未必轻相慕。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 210169,
      "title": "灼灼",
      "content": [
        "锦城春暖花欲飞，灼灼当庭舞柘枝。",
        "相公上客河东秀，自言那得傍人知。",
        "妾愿身为梁上燕，朝朝暮暮长相见。",
        "云收月堕海沉沉，泪满红绡寄肠断。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 210170,
      "title": "盼盼",
      "content": [
        "百尺楼高燕子飞，楼上美人颦翠眉。",
        "将军一去音容远，只有年年旧燕归。",
        "春风昨夜来深院，春色依然人不见。",
        "只余明月照孤眠，回望旧恩空恋恋。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 210171,
      "title": "崔鶑鶑",
      "content": [
        "崔家有女名鶑鶑，未识春光先有情。",
        "河桥兵乱依萧寺，红愁绿惨见张生。",
        "张生一见春情重，明月拂墙花影动。",
        "夜半红娘拥抱来，脉脉惊魂若春梦。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 210172,
      "title": "采莲",
      "content": [
        "若耶溪边天气秋，采莲女儿溪岸头。",
        "笑隔荷花共人语，烟波渺渺荡轻舟。",
        "数声水调红娇晚，棹转舟回笑人远。",
        "肠断谁家游冶郎，尽日踟蹰临柳岸。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 210173,
      "title": "烟中怨",
      "content": [
        "鉴湖楼阁与云齐，楼上女儿名阿溪。",
        "十五能为绮丽句，平生未解出幽闺。",
        "谢郎巧思诗裁剪，能使佳人动幽怨。",
        "琼枝璧月结芳期，斗帐双双成眷恋。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 210174,
      "title": "离魂记",
      "content": [
        "深闺女儿娇复痴，春愁春恨那复知。",
        "舅兄唯有相拘意，暗想花心临别时。",
        "离舟欲解春江暮，冉冉香魂逐君去。",
        "重来两身复一身，梦觉春风话心素。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 210175,
      "title": "遣朝华",
      "content": [
        "夜雾茫茫晓柝悲，玉人挥手断肠时。",
        "不须重向灯前泣，百岁终当一别离。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 210176,
      "title": "再遣朝华",
      "content": [
        "玉人前去却重来，此度分携更不回。",
        "肠断龟山离别处，夕阳孤塔自崔嵬。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 210177,
      "title": "闲燕堂联句",
      "content": [
        "黄叶山头初带雪，绿波尊酒暂回春。",
        "已闻璧月琼枝句，更看朝云暮雨人。",
        "老丑红妆翻曲妙，喜逢佳客放怀新。",
        "天明又出桃源去，仙境何时再问津。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 210178,
      "title": "纳凉",
      "content": [
        "携杖来追柳外凉，画桥南畔倚胡床。",
        "月明船笛参差起，风定池莲自在香。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 210179,
      "title": "东坡守杭",
      "content": [
        "十里荷花菡萏初，我公所至有西湖。",
        "欲将公事湖中了，见说官闲事亦无。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 210180,
      "title": "牵牛花",
      "content": [
        "银汉初移漏欲残，步虚人倚玉阑干。",
        "仙衣染得天边碧，乞与人间向晓看。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 210181,
      "title": "即席次君礼年兄韵",
      "content": [
        "情舒喜面山浮翠，袖满薰风凉透时。",
        "萍碎锦鳞金网举，影差帘燕玉钩垂。",
        "轻轻篆鼎凝香细，款款方壶转漏迟。",
        "清兴比来同约久，趣多深意古人诗。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 210182,
      "title": "醉眠亭",
      "content": [
        "醉来丰瘁同，眠去身世失。",
        "二乐擅一亭，夫子信超逸。",
        "杯行徂老春，肱枕颓升日。",
        "壮志未及伸，幽愿良自毕。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 210183,
      "title": "游杭州佛日水浄慧寺",
      "content": [
        "五里乔松径，千年古道场。",
        "泉声与岚影，收拾入僧房。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 210184,
      "title": "观音洞",
      "content": [
        "匹马骄嘶石路斜，观音洞口踏烟霞。",
        "普陀风景差相似，祇欠潮音小白花。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 210185,
      "title": "光华寺",
      "content": [
        "霞通海天曙，月来东山白。",
        "共是凭栏人，谁足当秋色。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 210186,
      "title": "玉井泉",
      "content": [
        "云蒸昆山液，月浸蓝田英。",
        "临风咽沆瀣，满腹珠玑鸣。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 210187,
      "title": "流杯桥",
      "content": [
        "曲水分山阴，舆梁胜溱洧。",
        "一咏见高风，驷马安足取。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 210188,
      "title": "江月楼  其一",
      "content": [
        "仙翁看月三百秋，江波日去月不流。",
        "肯因炎尘暝空阔，直与江月同清幽。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 210189,
      "title": "江月楼  其二",
      "content": [
        "苍梧云气眉山雨，玉箫三年无今古。",
        "九天雨露蛰蛟龙，琅玕长凭清虚府。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 210190,
      "title": "墨竹",
      "content": [
        "墨君飒飒风雨鸣，垂鸾舞凤翻青绶。",
        "一竿珍重几百缗，奚啻渭川三万亩。",
        "金锵玉戛空琴声，婢行奴颜谢花柳。",
        "得亭真从寂寞间，卓古高标压群丑。",
        "不须辨直致湘江，便觉满窗凉意透。",
        "挺然叶节抱风孤，顿应君子虚心受。",
        "雷迸箨龙龙欲走，樱笋纷纷徒适口。",
        "破除肉味若闻韶，王猷笑咏还依旧。",
        "藉槛湘阴净简书，接地春华幻尘垢。",
        "拂手笔端别有神，往来平安报良友。",
        "前时无偶后无继，奇宝秘灵宜永久。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 210191,
      "title": "白鹤观",
      "content": [
        "复殿重楼堕杳冥，故基乔木尚峥嵘。",
        "银河不改三千尺，铁马曾经十万兵。",
        "华表故应终化鹤，谪仙未解独骑鲸。",
        "井泉一一儿童旧，白发衰颜祇自惊。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 210192,
      "title": "清溪逢故人",
      "content": [
        "共约来春会，牙樯发画船。",
        "和风杨柳岸，微雨杏花天。",
        "故国应携手，前途共著鞭。",
        "吴儿看环佩，珠树秀婵娟。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 210193,
      "title": "文英阁二首  其一",
      "content": [
        "都门将酒惜分携，归路骎骎望欲迷。",
        "千里又看新燕语，一声初听子规啼。",
        "春风天上曾挥翰，迟日江边独杖藜。",
        "回首三山楼阁晚，断云流水自东去。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 210194,
      "title": "文英阁二首  其二",
      "content": [
        "流落天涯思故园，散愁郊外任蹒跚。",
        "云归邃谷知无雨，风卷寒溪没近滩。",
        "已见雁将归楚泽，遥知春又到长安。",
        "桑林垅麦依稀是，祇见秦川万里宽。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 210195,
      "title": "句  其一",
      "content": [
        "断霞一抹海天低。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 210196,
      "title": "句  其二",
      "content": [
        "梦魂思汝鸟工往，事故著人羊负来。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 210197,
      "title": "句  其三",
      "content": [
        "高邮西北多巨湖，累累相贯如连珠。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 210198,
      "title": "句  其四",
      "content": [
        "槿篱护药才通径，竹笕通泉白遍村。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 210199,
      "title": "句  其五",
      "content": [
        "泥新乌栋初巢燕，萍匝荒池已集蜻。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 210200,
      "title": "句  其六",
      "content": [
        "自是我翁多盛德，顿回秋色作春阴。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 210201,
      "title": "句  其七",
      "content": [
        "雨砌堕危芳，风簷纳飞凉。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 210202,
      "title": "句  其八",
      "content": [
        "城晚通云雾，亭深到芰荷。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 210203,
      "title": "存目  其一",
      "content": [
        "诗题：次韵莘老初至汤泉二首其二首句：年华行已老。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 210204,
      "title": "存目  其二",
      "content": [
        "诗题：过六合水亭怀裴博士次韵三首其一首句：昔同裴博士。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
