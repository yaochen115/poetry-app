      }
    },
    {
      "id": 210211,
      "title": "存目  其九",
      "content": [
        "诗题：圆通院白衣阁其一首句：白衣阁外遶朱栏。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
