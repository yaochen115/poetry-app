{
  "data": [
    {
      "id": 173988,
      "title": "人情",
      "content": [
        "人情当面蔽山丘，谁可论心向白头。",
        "天禄阁非真学士，玉麟符是假诸侯。",
        "诗书落落成孤论，耕钓依依忆旧游。",
        "早晚抽簪江海去，笑将风月上扁舟。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 173989,
      "title": "寄王乐道",
      "content": [
        "荆州南走困尘埃，应喜文章意自开。",
        "明世正逢多事日，要涂须用出伦材。",
        "不回霜雪天应惜，未得风云众忍摧。",
        "若向沙头吊杜甫，近诗悬望自书来。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 173990,
      "title": "戏书",
      "content": [
        "集贤自笑文章少，为郡谁言乐事多。",
        "报答书题亲笔砚，逢迎使客听笙歌。",
        "一心了了无人语，两鬓萧萧奈老何。",
        "还有不随流俗处，秋毫无累损天和。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 173991,
      "title": "赠张济",
      "content": [
        "忆初兰渚访沉沦，一亩萧然里舍贫。",
        "节行久穷弥好古，文章垂老更惊人。",
        "诗书就我论新意，冠剑投谁拂旧尘。",
        "山驿荒凉烦枉道，一觞相属莫嫌频。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 173992,
      "title": "北渚亭雨中",
      "content": [
        "振衣已出尘土外，卷箔更当风雨间。",
        "泉声渐落石沟涧，云气迥压金舆山。",
        "寒沙漠漠鸟飞去，野路悠悠人自还。",
        "耕桑千里正无事，况有樽酒聊开颜。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 173993,
      "title": "送赵资政",
      "content": [
        "镇抚西南众望倾，玉书天上辍持衡。",
        "春风不觉岷山远，和气还从锦水生。",
        "学舍却寻余教在，棠郊应喜旧阴成。",
        "归来促召调炉冶，莫为儿童竹马迎。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 173994,
      "title": "趵突泉",
      "content": [
        "一派遥从玉水分，暗来都洒历山尘。",
        "滋荣冬茹温常早，润泽春茶味更真。",
        "已觉路傍行似鉴，最怜沙际涌如轮。",
        "曾成齐鲁封疆会，况托娥英诧世人。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 173995,
      "title": "金线泉",
      "content": [
        "玉甃常浮灏气鲜，金丝不定路南泉。",
        "云依美藻争成缕，月照寒漪巧上弦。",
        "已绕渚花红灼灼，更萦沙竹翠娟娟。",
        "无风到底尘埃尽，界破冰绡一片天。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 173996,
      "title": "北池小会",
      "content": [
        "笑语从容酒慢巡，笙歌随赏北池春。",
        "波间镂槛花迷眼，沙际朱桥柳拂人。",
        "金缕暗移泉溜急，银簧相合鸟声新。",
        "幸时无事须行乐，物外乾坤一点尘。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 173997,
      "title": "送韩廷评",
      "content": [
        "谢庭冠盖旧追寻，僻郡相从喜更深。",
        "进道由来轻拱璧，传经知不羡籝金。",
        "骐骝要试风沙远，竹柏须忘霰雪侵。",
        "别后壮怀应努力，白头倾耳听徽音。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 173998,
      "title": "寄孙莘老湖州墨妙亭",
      "content": [
        "隆名盛位知难久，壮字丰碑亦易亡。",
        "枣木已非真篆刻，色丝空喜好文章。",
        "岘山汉水成虚掷，大厦深檐且秘藏。",
        "好事今推霅溪守，故开新馆集琳琅。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 173999,
      "title": "鹊山",
      "content": [
        "一峰孤起势崔嵬，秀色挼蓝入酒杯。",
        "灵药已从清露得，平湖长泛宿云回。",
        "翰林明月舟中过，司马虚亭竹外开。",
        "我亦退公思蜡屐，会看归路送人来。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 174000,
      "title": "华不注山",
      "content": [
        "虎牙千仞立巉巉，峻拔遥临济水南。",
        "翠岭嫩岚晴可掇，金舆陈迹久谁探。",
        "高标特起青云近，壮士三周战气酣。",
        "丑父遗忠无处问，空余一掬野泉甘。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 174001,
      "title": "灵岩寺兼简重元长老二刘居士",
      "content": [
        "法定禅房临峭谷，辟支灵塔冠层峦。",
        "轩窗势耸云林合，钟磬声高鸟道盘。",
        "白鹤已飞泉自涌，青龙无迹洞常寒。",
        "更闻雷远相从乐，世道嚣尘岂可干。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 174002,
      "title": "和孔平仲",
      "content": [
        "园池方喜共追寻，正是槐榆夹路阴。",
        "双烛纵谈樽酒绿，一枰销日纸窗深。",
        "波涛万字惊人笔，尘土千钟异俗心。",
        "佳句从来知寡和，愧将沙砾报黄金。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 174003,
      "title": "郡楼",
      "content": [
        "满眼青山更上楼，偶携闲客此闲游。",
        "飞花不尽随风起，野水无边带雨流。",
        "怀旧有情惟社燕，忘机相得更沙鸥。",
        "黄金驷马皆尘土，莫靳当欢酒百瓯。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 174004,
      "title": "鲍山",
      "content": [
        "云中一点鲍山青，东望能令两眼明。",
        "若道人心是矛戟，山前那得叔牙城。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 174005,
      "title": "郓州新堂",
      "content": [
        "百尺丰堂汶水滨，鲁侯清燕此逡巡。",
        "溪寒素砾偏宜月，壁莹黄金不受尘。",
        "引客笙歌行处是，赏心花木四时新。",
        "未应久作林泉主，天子今思旧学臣。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 174006,
      "title": "垓下",
      "content": [
        "三杰同归汉道兴，拔山余力尔徒矜。",
        "泫然垓下真儿女，不悟当从一范增。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 174007,
      "title": "离齐州后五首  其一",
      "content": [
        "云帆十幅顺风行，卧听随船白浪声。",
        "好在西湖波上月，酒醒还到纸窗明。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 174008,
      "title": "离齐州后五首  其二",
      "content": [
        "画船终日扒沙行，已去齐州一月程。",
        "千里相随是明月，水西亭上一般明。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 174009,
      "title": "离齐州后五首  其三",
      "content": [
        "文犀剡剡穿林笋，翠靥田田出水荷。",
        "正是西亭销暑日，却将离恨寄烟波。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 174010,
      "title": "离齐州后五首  其四",
      "content": [
        "将家须向习池游，难放西湖十顷秋。",
        "从此七桥风与月，梦魂长到木兰舟。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 174011,
      "title": "离齐州后五首  其五",
      "content": [
        "荷气夜凉生枕席，水声秋醉入帘帏。",
        "一帆千里空回首，寂寞船窗祇自知。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 174012,
      "title": "寄齐州同官",
      "content": [
        "西湖一曲舞霓裳，劝客花前白玉觞。",
        "谁对七桥今夜月，有情千里不相忘。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 174013,
      "title": "庭桧呈蒋颖叔",
      "content": [
        "樛枝高下秀森森，曾寄名卿异俗心。",
        "草舍一时成往事，松身千尺见新阴。",
        "声清不受笙竽杂，气劲能遗霰雪侵。",
        "汉节从来纵真赏，谢庭兰玉载芳音。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 174014,
      "title": "甘露寺多景楼",
      "content": [
        "欲收嘉景此楼中，徙倚阑干四望通。",
        "云乱水光浮紫翠，天含山气入青红。",
        "一川钟呗淮南月，万里帆樯海外风。",
        "老去衣衿尘土在，祇将心目羡冥鸿。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 174015,
      "title": "孙少述示近诗兼仰高致",
      "content": [
        "大句闳篇久擅场，一函初得胜琳琅。",
        "少陵雅健材孤出，彭泽清闲兴最长。",
        "世外麒麟谁可系，云中鸿雁本高翔。",
        "白头多病襄阳守，展卷临风欲自强。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 174016,
      "title": "金山寺",
      "content": [
        "尘外岧峣鹫岭宫，架虚排险出青红。",
        "林光巧转沧波上，海色遥涵白日东。",
        "夜静神龙听呪食，秋深苍鹘起抟风。",
        "连荆控蜀长江水，尽在回廊顾盼中。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 174017,
      "title": "水西亭书事",
      "content": [
        "一番雨熟林间杏，四面风开水上花。",
        "岸尽龙鳞盘翠筿，溪深鳌背露晴沙。",
        "陇头刈麦催行馌，桑下缲丝急转车。",
        "总是白头官长事，莫嫌粗俗向人夸。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 174018,
      "title": "高邮逢人约襄阳之游",
      "content": [
        "一川风月高邮夜，玉麈清谈画鹢舟。",
        "未把迂疏笑山简，更须同上习池游。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 174019,
      "title": "彭城道中",
      "content": [
        "百步洪声潦退初，白沙新岸凑舟车。",
        "一时屠钓英雄尽，千载河山战伐余。",
        "楚汉旧歌流俚耳，韩彭遗壁冠荒墟。",
        "可怜马上纵横略，只在邳桥一卷书。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 174020,
      "title": "送程殿丞还朝",
      "content": [
        "如云青发拥朝簪，佳誉喧喧动士林。",
        "自重肯悲三献玉，不欺常慎四知金。",
        "芝兰秀出清门盛，鸿鹭翻飞紫殿深。",
        "别后斋中挂尘榻，更将梁甫向谁吟。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 174021,
      "title": "送高秘丞",
      "content": [
        "簿书壅处精神健，风俗浇时质性淳。",
        "公退种花常满县，政成驯雉不惊人。",
        "指麾细柳通河外，歌咏甘棠付汉滨。",
        "惆怅不能留自助，谩将樽酒驻车轮。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 174022,
      "title": "康定军使高秘丞自襄阳司农寺勾业寺丞自光化相继迁拜签判程殿丞受代还朝预有惜别之意辄书长句奉呈",
      "content": [
        "千里分符汉上城，为僚方喜得时英。",
        "已无楚泽行吟意，便有南阳坐啸名。",
        "骥力用来精爽紧，鹓行归去羽翰轻。",
        "须知别后狂山简，梦寐清谈鄙吝生。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 174023,
      "title": "雨中王驾部席上",
      "content": [
        "鸠呼连日始成阴，薄雨聊宽望岁心。",
        "浴雁野塘新浪细，藏鸦宫柳嫩条深。",
        "春寒巧放花迟发，人老嗟辞酒满斟。",
        "英隽并游知最幸，名园偷暇更追寻。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 174024,
      "title": "赠张伯常之郢见过因话荆楚故事仍贶佳什",
      "content": [
        "一见心亲十载前，相望南北久茫然。",
        "喜倾白发论文酒，重访清江下濑船。",
        "志大肯同悲抱璞，识高宁许笑求田。",
        "已闚品藻传荆楚，更味阳春白雪篇。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 174025,
      "title": "伯常少留别业寄诗索酒因以奉报",
      "content": [
        "未拥双驺谒汉庭，暂留车马憩林坰。",
        "多情置驿邀佳客，好事磨铅勘旧经。",
        "芳草连门三径远，朝云临幌数峰青。",
        "春醪有禁无繇寄，谁为江潭访独醒。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 174026,
      "title": "赠黄降自宜城赴官许昌",
      "content": [
        "所学从谁得最完，豫章新出已难攀。",
        "不摇声利心能定，欲正哇淫手自删。",
        "颍水珠玑来席上，鄢城桃李在人间。",
        "高斋挂榻骊歌后，坐守尘编少往还。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 174027,
      "title": "招泽甫竹亭闲话",
      "content": [
        "偶归塞马应何定，粒食鹪鹩颇自安。",
        "云压楚山春后雪，风吹襄水坐来寒。",
        "诗豪已分材难强，酒圣还谙量未宽。",
        "頼有佳宾堪下榻，且将清话对檀栾。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 174028,
      "title": "和郑微之",
      "content": [
        "故人容下榻，清宴得传杯。",
        "地秀偏宜竹，天寒未见梅。",
        "云林千嶂出，烟艇一帆开。",
        "且醉休言别，归期信召催。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 174029,
      "title": "送陈世修",
      "content": [
        "沙渚鸿飞入楚云，远林樵爨宿烟昏。",
        "娟娟野菊经秋淡，漠漠沧江带雨浑。",
        "归路赏心应驻节，客亭离思暂开樽。",
        "莫嗟问俗淹翔久，从此频繁不次恩。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 174030,
      "title": "和张伯常自郢中将及敝境先寄长句",
      "content": [
        "拔薤威名高外服，握兰风力冠中台。",
        "好音忽有双鱼至，喜气遥知五马来。",
        "梨颗玉腴含雨重，菊房金粉傍寒开。",
        "池边且欲留同醉，思拙难酬白雪才。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 174031,
      "title": "和张伯常岘山亭晚起元韵",
      "content": [
        "挥手红尘意浩然，夙兴招客与扳联。",
        "烟云秀发春前地，草木清含雪后天。",
        "已卜耕桑临富水，暂抛鱼鸟去伊川。",
        "更追羊杜经行乐，况有风骚是谪仙。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 174032,
      "title": "岘山亭置酒",
      "content": [
        "石磴萦回入杳冥，筠松高下簇虚亭。",
        "春归野路梅争白，雪尽沙田麦正青。",
        "马窟飞云临画栋，凤林斜日照疏棂。",
        "长年酒量殊山简，却上篮舆恨独醒。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 174033,
      "title": "韩魏公挽歌词二首  其一",
      "content": [
        "堂堂风骨气如春，衮服貂冠社稷臣。",
        "天上立谈迎白日，握中随物转洪钧。",
        "忽骑箕尾精灵远，长誓山河宠数新。",
        "万里耕桑无一事，三朝功德在生民。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 174034,
      "title": "韩魏公挽歌词二首  其二",
      "content": [
        "锱铢赤舄无骄志，咳唾黄金有古风。",
        "复冒荒遐知大度，委蛇艰急见孤忠。",
        "谋谟邴魏丹青力，拥立昭宣柱石功。",
        "御笔新诗在新陇，哀荣谁得似初终。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 174035,
      "title": "酬吴仲庶龙图暮春感怀",
      "content": [
        "琐闱延阁腹心臣，籍甚声华动缙绅。",
        "药石言行天下雨，袴襦恩达国中春。",
        "召南去后余思在，纶氏归来壮志新。",
        "莫为流年嗟白发，济时须仗老成人。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 174036,
      "title": "陈君式恭轩",
      "content": [
        "不要墙头俗眼看，故开苍藓种檀栾。",
        "虚心得处从天性，劲节知来在岁寒。",
        "叶养风烟夸酒美，枝留冰雪送歌残。",
        "名郎感慕同桑梓，手植依然一亩宽。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 174037,
      "title": "僧正倚大师庵居",
      "content": [
        "兰裓方袍振锡回，结茅萧寺远尘埃。",
        "五峰日破朝云出，三谷花浮涧水来。",
        "风散异香禅榻静，鸟窥清呗法筵开。",
        "因过旧国枌榆地，松麈高谈喜暂陪。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 174038,
      "title": "以白山茶寄吴仲庶见贶佳篇依韵和酬",
      "content": [
        "山茶纯白是天真，筠笼封题摘尚新。",
        "秀色未饶三谷雪，清香先得五峰春。",
        "琼花散漫情终荡，玉蕊萧条迹更尘。",
        "远寄一枝随驿使，欲分芳种恨无因。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 174039,
      "title": "酬江西运使蒋颖叔",
      "content": [
        "收科同日曳华裾，砉划惊闻刃有余。",
        "骢马已腾双阙路，木牛还实太仓储。",
        "多歧易感千名别，置袖空荣一纸书。",
        "欲佩左符瓯越去，更从南斗望单车。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 174040,
      "title": "刁景纯挽歌词二章  其一",
      "content": [
        "史观郎闱得谢归，桓桓筋力未全衰。",
        "园林笑傲笙歌拥，山水追寻几杖随。",
        "尺牍百封虚有意，文章十帙更传谁。",
        "余花自出藏春坞，一点青灯照穗帷。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 174041,
      "title": "刁景纯挽歌词二章  其二",
      "content": [
        "八十登高步更轻，殷勤爱客是平生。",
        "能临缓急敦风谊，不向炎凉逐世情。",
        "北岳云烟思抗志，东门冠盖羡遗荣。",
        "可怜昨日壶觞地，呜咽唯闻薤露声。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 174042,
      "title": "寄留交代元子发",
      "content": [
        "青云宝构虽同直，白发鱼符各未归。",
        "倚玉讵应公论许，续貂还恐邑人非。",
        "莫辞海畔留连久，须惜天涯故旧稀。",
        "预想明年双节召，九霄鹏翼看横飞。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 174043,
      "title": "游东山示客",
      "content": [
        "虞寄庵余藓径通，满山台殿出青红。",
        "难逢堆案文书少，偶见凭栏笑语同。",
        "梅粉巧含溪上雪，柳黄微破日边风。",
        "从今准拟频行乐，日伴樽前白发翁。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 174044,
      "title": "大乘寺",
      "content": [
        "行春门外是东山，篮轝宁辞数往还。",
        "溪上鹿随人去远，洞中花照水长闲。",
        "楼台势出尘埃外，钟磬声来缥缈间。",
        "自笑粗官偷暇日，暂携妻子一开颜。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 174045,
      "title": "圣泉寺",
      "content": [
        "笑问并儿一举鞭，亦逢佳景暂留连。",
        "青冥日抱山腰阁，碧野云含石眼泉。",
        "蹑屐路通林北寺，落帆门系海东船。",
        "闽王旧事今何在，惟有村村供佛田。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 174046,
      "title": "升山灵岩寺",
      "content": [
        "修竹长松十里阴，任敦烧药洞门深。",
        "独闚金版惊人语，能到青霞出世心。",
        "鸡犬亦随云外去，蓬瀛何必海中寻。",
        "丹楼碧阁唐朝寺，钟呗香花满旧林。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 174047,
      "title": "凤池寺",
      "content": [
        "经年闻说凤池山，蜡屐方偷半日闲。",
        "笑语客随朱阁上，醉醒身在白云间。",
        "溪桥野水清犹急，海岸轻寒去却还。",
        "为郡天涯亦潇洒，莫嗟流落鬓毛斑。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 174048,
      "title": "上元",
      "content": [
        "金鞍驰骋属儿曹，夜半喧阗意气豪。",
        "明月满街流水远，华灯入望众星高。",
        "风吹玉漏穿花急，人近朱阑送目劳。",
        "自笑低心逐年少，祇寻前事撚霜毛。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 174049,
      "title": "元沙院",
      "content": [
        "升山南下一峰高，上尽层轩未厌劳。",
        "际海烟云常惨淡，大寒松竹更萧骚。",
        "经台日永销香篆，谈席风生落麈毛。",
        "我亦有心从自得，琉璃瓶水照秋毫。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 174050,
      "title": "酬柳国博",
      "content": [
        "行止恂恂众所褒，东南佳誉映时髦。",
        "洞无畦畛心常坦，凛若冰霜节最高。",
        "朱绂少留居客左，白头难敌是诗豪。",
        "须知别后山城守，怅望归艎送目劳。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 174051,
      "title": "闰正月十一日吕殿丞寄新茶",
      "content": [
        "偏得朝阳借力催，千金一胯过溪来。",
        "曾坑贡后春犹早，海上先尝第一杯。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 174052,
      "title": "旬休日过仁王寺",
      "content": [
        "杂花飞尽绿阴成，处处黄鹂百啭声。",
        "随分笙歌与樽酒，且偷闲日试闲行。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 174053,
      "title": "乱山",
      "content": [
        "乱山深处转山多，此地栖身奈远何。",
        "莫问吾亲在何处，举头东岸是新罗。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 174054,
      "title": "亲旧书报京师盛闻治声",
      "content": [
        "自知孤宦无材术，谁道京师有政声。",
        "默坐海边何计是，白头亲在凤凰城。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 174055,
      "title": "寄献新茶",
      "content": [
        "种处地灵偏得日，摘时春早未闻雷。",
        "京师万里争先到，应得慈亲手自开。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 174056,
      "title": "方推官寄新茶",
      "content": [
        "采摘东溪最上春，壑源诸叶品尤新。",
        "龙团贡罢争先得，肯寄天涯主诺人。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 174057,
      "title": "尝新茶",
      "content": [
        "麦粒收来品绝伦，葵花制出样争新。",
        "一杯永日醒双眼，草木英华信有神。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 174058,
      "title": "厚卿子中使高丽",
      "content": [
        "并使时推出众材，异方迎拜六城开。",
        "宣风直到东西部，仗节遥临大小梅。",
        "沧海路从三岛去，玉山人到二星回。",
        "黄金白㲲饶君用，铜器应余寄我来。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 174059,
      "title": "出郊",
      "content": [
        "葛叶催耕二月时，斜桥曲岸马行迟。",
        "家家卖酒清明近，红白花开一两枝。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 174060,
      "title": "蹇磻翁寄新茶二首  其一",
      "content": [
        "龙焙尝茶第一人，最怜溪岸两旗新。",
        "肯分方胯醒衰思，应恐慵眠过一春。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 174061,
      "title": "蹇磻翁寄新茶二首  其二",
      "content": [
        "贡时天上双龙去，斗处人间一水争。",
        "分得余甘慰憔悴，碾尝终夜骨毛清。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 174062,
      "title": "城南二首  其一",
      "content": [
        "雨过横塘水满堤，乱山高下路东西。",
        "一番桃李花开尽，惟有青青草色齐。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 174063,
      "title": "城南二首  其二",
      "content": [
        "水满横塘雨过时，一番红影杂花飞。",
        "送春无限情惆怅，身在天涯未得归。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 174064,
      "title": "寒食",
      "content": [
        "一麾飘泊在天涯，寒食园林不见花。",
        "唯有市亭酤酒客，俚歌声到日西斜。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 174065,
      "title": "夜出过利涉门",
      "content": [
        "红纱笼烛照斜桥，复观翚飞入斗杓。",
        "人在画船犹未睡，满堤明月一溪潮。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 174066,
      "title": "夜出城南祷雨",
      "content": [
        "海天重叠四山云，半出星辰亦半昏。",
        "上得篮轝是中夜，两街灯照九重门。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 174067,
      "title": "西楼",
      "content": [
        "海浪如云去却回，北风吹起数声雷。",
        "朱楼四面钩疏箔，卧看千山急雨来。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 174068,
      "title": "荔枝四首  其一",
      "content": [
        "剖见隋珠醉眼开，丹砂缘手落尘埃。",
        "谁能有力如黄犊，摘尽繁星始下来。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 174069,
      "title": "荔枝四首  其二",
      "content": [
        "玉润冰清不受尘，仙衣裁剪绛纱新。",
        "千门万户谁曾得，只有昭阳第一人。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 174070,
      "title": "荔枝四首  其三",
      "content": [
        "绛縠囊收白露团，未曾封植向长安。",
        "昭阳殿里才闻得，已道佳人不奈寒。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 174071,
      "title": "荔枝四首  其四",
      "content": [
        "金钗双捧玉纤纤，星宿光芒动宝奁。",
        "解笑诗人夸博物，祇知红颗味酸甜。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 174072,
      "title": "王虞部惠佳篇叙述昔与湘潭亡弟游从仍以亡弟旧诗见示",
      "content": [
        "薄宦红尘常拂面，早衰黄发已盈颠。",
        "棣华零落曾谁语，鸿羽萧条祇自怜。",
        "已矣空闻怀旧赋，泫然犹获济江篇。",
        "殷勤慰我如君少，更悟之他友最贤。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 174073,
      "title": "北归三首  其一",
      "content": [
        "终日思归今日归，著鞭鞭马尚嫌迟。",
        "曲台殿里官虽冷，须胜天涯海角时。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 174074,
      "title": "北归三首  其二",
      "content": [
        "拜捧恩书喜满颜，马蹄遥望斗杓还。",
        "从今步步行平地，出得千山与万山。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 174075,
      "title": "北归三首  其三",
      "content": [
        "江海多年似转蓬，白头归拜未央宫。",
        "堵墙学士惊相问，何处尘埃瘦老翁。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 174076,
      "title": "和酬孙少述",
      "content": [
        "自信箪瓢乐，宁羞猿鹤惊。",
        "论高知峻节，交淡见纯诚。",
        "自昔心无间，相逢眼更明。",
        "何当荐有道，坐想软轮迎。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 174077,
      "title": "和孙少述侯职方同燕席",
      "content": [
        "两翁头白喜追陪，好事铃斋燕席开。",
        "腊在未消盈尺雪，春归先放一枝梅。",
        "况无庭下书投缿，更尽筵中酒满杯。",
        "周召二南皆绝唱，抑扬赓和愧非材。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 174078,
      "title": "寄赵宫保",
      "content": [
        "铜扉得谢从今日，玉铉辞荣已十年。",
        "素节谠言留简册，高情清兴入林泉。",
        "海边爱日疲人恋，剑外仁风故老传。",
        "门外最应潇洒客，喜公平地作神仙。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 174079,
      "title": "和酬赵宫保致政言怀二首  其一",
      "content": [
        "谠论危言望素隆，独于声利性偏慵。",
        "龙楼调护官虽宠，鸠杖跻攀兴已浓。",
        "不变松篁心转劲，无边江海量兼容。",
        "磻溪纵老宁闲得，会为苍生起更重。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 174080,
      "title": "和酬赵宫保致政言怀二首  其二",
      "content": [
        "爱国忧民有古风，米盐亲省尚嫌慵。",
        "衮衣天上归何晚，霖雨人间望正浓。",
        "三少官仪虽赫赫，五湖心事肯容容。",
        "角巾藜杖经行处，知在云山第几重。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 174081,
      "title": "和赵宫保别杭州",
      "content": [
        "紞鼓留公岂是催，湖山得意且徘徊。",
        "更应准拟须乘兴，范蠡扁舟去却来。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 174082,
      "title": "过零壁张氏园三首  其一",
      "content": [
        "梨枣累累正熟时，粟田鹑兔亦争肥。",
        "园亭尽日追寻遍，只欠厌厌醉始归。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 174083,
      "title": "过零壁张氏园三首  其二",
      "content": [
        "汴水溶溶带雨流，黄花艳艳亦迎秋。",
        "看花引水园林主，应笑行人易白头。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 174084,
      "title": "过零壁张氏园三首  其三",
      "content": [
        "秫地成来多酿酒，杏林熟后亦留钱。",
        "不须置驿迎宾客，直到门前系画船。"
      ],
      "author": {
        "id": 8104,
        "name": "曾巩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 174085,
      "title": "雪亳州",
      "content": [
        "欲下苍凉日，全低黯霮天。",
        "飘飖投夜急，琐碎得风儇。",
        "秽壤弥缝遍，枯荄点缀妍。",
        "繁英飞面旋，艳舞起翩跹。",
        "已压穿林竹，还冰落涧泉。",
        "抵巇轻自肆，乘隙巧争先。",
        "壅隔书邮断，侵凌客履穿。",
        "恐倾贫巷屋，觉重溯溪船。",
        "唶有颜空姣，洵无质可镌。",
        "包藏兼海岳，蒙蔽匝坤干。",
        "枚叟招何晚，袁安卧正坚。",
        "会须逢见𪾢，万里豁晴川。"
      ],
