{
  "data": [
    {
      "id": 359011,
      "title": "湖州韦长史山居",
      "content": [
        "一官唯买昼公堂，但得身闲日自长。",
        "琴曲少声重勘谱，",
        "明日鳜鱼何处钓，门前春水似沧浪。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359012,
      "title": "赠李伊阙",
      "content": [
        "桐履如飞不可寻，一壶双笈峄阳琴。",
        "舟横野渡寒风急，",
        "云间二室劳君画，水墨苍苍半壁阴。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359013,
      "title": "重游练湖怀旧",
      "content": [
        "西风渺渺月连天，同醉兰舟未十年。",
        "𫛳鸟赋成人已没，",
        "日暮长堤更回首，一声邻笛旧山川。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359014,
      "title": "乘月棹舟送大历寺灵聪上人不及",
      "content": [
        "万峰秋尽百泉清，旧锁禅扉在赤城。",
        "枫浦客来烟未散，",
        "一字不留何足讶，白云无路水无情。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359015,
      "title": "汴河亭",
      "content": [
        "广陵花盛帝东游，先劈昆仑一派流。",
        "百二禁兵辞象阙，",
        "四海义师归有道，迷楼还似景阳楼。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359016,
      "title": "村舍二首",
      "content": [
        "自翦青莎织雨衣，南峰烟火是柴扉。",
        "莱妻早报蒸藜熟，",
        "花时未免人来往，欲买严光旧钓矶。",
        "尚平多累自归难，一日身闲一日安。",
        "山径晓云收猎网，",
        "三顷水田秋更熟，北窗谁拂旧尘冠。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359017,
      "title": "郑秀才东归凭达家书",
      "content": [
        "欲寄家书少客过，闭门心远洞庭波。",
        "两岩花落夜风急，",
        "贫居不问应知处，溪上闲船系绿萝。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359018,
      "title": "伤故湖州李郎中",
      "content": [
        "政成身没共兴衰，乡路兵戈旅榇回。",
        "城上暮云凝鼓角，",
        "南北相逢皆掩泣，白苹洲暖百花开。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359019,
      "title": "和友人送僧归桂州灵岩寺",
      "content": [
        "楚客送僧归桂阳，海门帆势极潇湘。",
        "碧云千里暮愁合，",
        "南京长老几年别，闻道半岩多影堂。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359020,
      "title": "淮阴阻风寄呈楚州韦中丞",
      "content": [
        "垂钓京江欲白头，江鱼堪钓却西游。",
        "刘伶台下稻花晚，",
        "河桥有酒无人醉，独上高城望庾楼。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359021,
      "title": "途经敷水",
      "content": [
        "修蛾颦翠倚柔桑，遥谢春风白面郎。",
        "五夜有情随暮雨，",
        "何处野花何处水，下峰流出一渠香。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359022,
      "title": "和人贺杨仆射致政",
      "content": [
        "莲府公卿拜后尘，手持优诏挂朱轮。",
        "从军幕下三千客，",
        "岂同王谢山阴会，空叙流杯醉暮春。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359023,
      "title": "题四皓庙",
      "content": [
        "桂香松暖庙门开，独泻椒浆奠一杯。",
        "秦法欲兴鸿已去，",
        "山下驿尘南窜路，不知冠盖几人回。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359024,
      "title": "鹤林寺中秋夜玩月",
      "content": [
        "待月东林月正圆，广庭无树草无烟。",
        "中秋云尽出沧海，",
        "莫辞达曙殷勤望，一堕西岩又来年。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359025,
      "title": "南海府罢归京口经大庾岭赠张明府",
      "content": [
        "楼船旌旆极天涯，一剑从军两鬓华。",
        "回日眼明河畔草。",
        "去时肠断岭头花。",
        "陶诗尽写行过县，张赋初成卧到家。",
        "官满知君有归处，姑苏台上旧烟霞。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 359026,
      "title": "题卫将军庙",
      "content": [
        "武牢关下护龙旗，挟槊弯弧马上飞。",
        "汉业未兴王霸在，",
        "欲奠忠魂何处问，苇花枫叶雨霏霏。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359027,
      "title": "访别韦隐居不值",
      "content": [
        "犬吠双岩碧树间，主人朝出半开关。",
        "汤师阁上留诗别，",
        "故乡芜没兵戈后，凭向溪南买一山。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359028,
      "title": "送前东阳于明府由鄂渚归故林",
      "content": [
        "结束征东换黑貂，灞西风雨正潇潇。",
        "茂陵久病书千卷，",
        "殷勤为谢南溪客，白首萤窗未见招。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359029,
      "title": "听歌鹧鸪辞",
      "content": [
        "南国多情多艳词，鹧鸪清怨绕梁飞。",
        "甘棠城上客先醉，",
        "山行水宿不知远，犹梦玉钗金缕衣。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359030,
      "title": "寄题华严韦秀才院",
      "content": [
        "三面楼台百丈峰，西岩高枕树重重。",
        "晴攀翠竹题诗滑，",
        "今来故国遥相忆，月照千山半夜钟。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359031,
      "title": "戏代李协律松江有赠",
      "content": [
        "蜀客操琴吴女歌，明珠十斛是天河。",
        "霜凝薜荔怯秋树，",
        "西楼沉醉不知散，潮落洞庭洲渚多。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359032,
      "title": "送黄隐居归南海",
      "content": [
        "瘴雾南边久寄家，海中来往信流槎。",
        "林藏狒狒多残笋，",
        "知君爱宿层峰顶，坐到三更见日华。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359033,
      "title": "朝台送客有怀",
      "content": [
        "赵佗西拜已登坛，马援南征土宇宽。",
        "越国旧无唐印绶，",
        "岭北归人莫回首，蓼花枫叶万重滩。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359034,
      "title": "自楞伽寺晨起泛舟，道中有怀",
      "content": [
        "碧树苍苍茂苑东，佳期迢递路何穷。",
        "一声山鸟曙云外，",
        "欲知此路堪惆怅，菱叶蓼花连故宫。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359035,
      "title": "十二月拜起居表回",
      "content": [
        "一章西奏拜仙曹，回马天津北望劳。",
        "寒水欲春冰彩薄，",
        "空锁烟霞绝巡幸，周人谁识郁金袍。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359036,
      "title": "观章中丞夜按歌舞",
      "content": [
        "夜按双娃禁曲新，东西箫鼓接云津。",
        "舞衫未换红铅湿，",
        "西楼月在襄王醉，十二山高不见人。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359037,
      "title": "重游飞泉观题故梁道士宿龙池",
      "content": [
        "西岩泉落水容宽，灵物蜿蜒黑处蟠。",
        "松叶正秋琴韵响，",
        "仙客不归龙亦去，稻畦长满此池干。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359038,
      "title": "下第贻友人",
      "content": [
        "身在关西家洞庭，夜寒歌苦烛荧荧。",
        "人心高下月中桂，",
        "花前失意共寥落，莫遣东风吹酒醒。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359039,
      "title": "晚登龙门驿楼",
      "content": [
        "鱼龙多处凿门开，万古人知夏禹材。",
        "青嶂远分从地断，",
        "心感膺门身过此，晚山秋树独徘徊。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359040,
      "title": "题故李秀才居",
      "content": [
        "曾醉笙歌日正迟，醉中相送易前期。",
        "橘花满地人亡后，",
        "河桥酒熟平生事，更向东流奠一厄。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359041,
      "title": "韶州韶阳楼夜宴",
      "content": [
        "待月西楼卷翠罗，玉杯瑶瑟近星河。",
        "帘前碧树穷秋密，",
        "使君莫惜通宵饮，刀笔初从马伏波。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359042,
      "title": "闻韶州李相公移拜郴州因寄",
      "content": [
        "诏移丞相木兰舟，桂水潺湲岭北流。",
        "青汉梦归双阙曙，",
        "闻说公卿尽南望，甘棠花暖凤池头。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359043,
      "title": "游江令旧宅",
      "content": [
        "身没南朝宅已荒，邑人犹赏旧风光。",
        "芹根生叶石池浅，",
        "闲愁此地更西望，潮浸台城春草长。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359044,
      "title": "灞上逢元九处士东归",
      "content": [
        "瘦马频嘶灞水寒，灞南高处望长安。",
        "何人更结王生袜，",
        "旧交已变新知少，却伴渔郎把钓竿。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359045,
      "title": "别张秀才",
      "content": [
        "不知何计写离忧，万里山川半旧游。",
        "风卷暮沙和雪起，",
        "青桂一枝年少事，莫因鲈鲙涉穷秋。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359046,
      "title": "别表兄军倅",
      "content": [
        "卢橘花香拂钓矶，佳人犹舞越罗衣。",
        "三洲水浅鱼来少，",
        "交亲不念征南吏，昨夜风帆去似飞。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359047,
      "title": "题苏州虎丘寺僧院",
      "content": [
        "暂引寒泉濯远尘，此生多是异乡人。",
        "荆溪夜雨花开疾，",
        "世间谁似西林客，一卧烟霞四十春。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359048,
      "title": "酬郭少府先奉使巡涝见寄兼呈裴明府",
      "content": [
        "载书携榼别池龙，十幅轻帆处处通。",
        "谢脁宅荒山翠里，",
        "饱食鲙鱼榜归楫，待君琴酒醉陶公。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359049,
      "title": "出永通门经李氏庄",
      "content": [
        "飞轩危槛百花堂，朝宴歌钟暮已荒。",
        "中散狱成琴自怨，",
        "力保山河家又庆，只应中令敌汾阳。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359050,
      "title": "汉水伤稼",
      "content": [
        "西北楼开四望通，残霞成绮月悬弓。",
        "江村夜涨浮天水，",
        "才微分薄忧何益，却欲回心学钓翁。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359051,
      "title": "送王总下第归丹阳",
      "content": [
        "秦楼心断楚江湄，系马春风酒一卮。",
        "汴水月明东下疾，",
        "凭寄家书为回报，旧乡还有故人知。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359052,
      "title": "南阳道中",
      "content": [
        "月斜孤馆傍村行，野店高低带古城。",
        "篱上晓花斋后落，",
        "荒草连天风动地，不知谁学武侯耕。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359053,
      "title": "破北虏太和公主归宫阙",
      "content": [
        "毳幕承秋极断蓬，飘飖一剑黑山空。",
        "匈奴北走荒秦垒，",
        "恩沾残类从归去，莫使华人杂犬戎。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359054,
      "title": "李定言自殿院衔命归阙，拜员外郎迁右史因寄",
      "content": [
        "白笔南征变二毛，越山愁瘴海惊涛。",
        "才归龙尾含鸡舌，",
        "吴中旧侣君先贵，曾忆王祥与佩刀。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359055,
      "title": "早秋韶阳夜雨",
      "content": [
        "宋玉含凄梦亦惊，芙蓉山响一猿声。",
        "阴云迎雨枕先润，",
        "西归万里未千里，应到故园春草生。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359056,
      "title": "将为南行陪尚书崔公宴海榴堂",
      "content": [
        "朝宴华堂暮未休，几人偏得谢公留。",
        "风传鼓角霜侵戟，",
        "谩夸书剑无知己，水远山长步步愁。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359057,
      "title": "赠王山人",
      "content": [
        "贳酒携琴访我频，始知城市有闲人。",
        "君臣药在宁忧病，",
        "近来闻说烧丹处，玉洞桃花万树春。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359058,
      "title": "宣城崔大夫召联句，偶疾不获赴因献",
      "content": [
        "心慕知音命自拘，画堂闻欲试吹竽。",
        "茂陵罢酒惭中圣，",
        "还愁旅棹空归去，枫叶荷花钓五湖。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359059,
      "title": "赠郑处士",
      "content": [
        "道傍年少莫矜夸，心在重霄鬓未华。",
        "杨子可曾过北里，",
        "且卖湖田酿春酒，与君书剑是生涯。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359060,
      "title": "正元",
      "content": [
        "高揭鸡竿辟帝阍，祥风微暖瑞云屯。",
        "千官共削奸臣迹，",
        "华夷一轨人方泰，莫学论兵误至尊。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359061,
      "title": "登尉佗楼",
      "content": [
        "刘项持兵鹿未穷，自乘黄屋岛夷中。",
        "南来作尉任嚣力，",
        "越人未必知虞舜，一奏熏弦万古风。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359062,
      "title": "韶州驿楼宴罢",
      "content": [
        "簷外千帆背夕阳，归心杳杳鬓苍苍。",
        "岭猿群宿夜山静，",
        "主人不醉下楼去，月在南轩更漏长。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359063,
      "title": "和淮南王相公与宾僚同游瓜洲别业，题旧书斋",
      "content": [
        "碧油红旆想青衿，积雪窗前尽日吟。",
        "巢鹤去时云树老，",
        "宾御莫辞岩下醉，武丁高枕待为霖。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359064,
      "title": "送卢先辈自衡岳赴复州嘉礼二首",
      "content": [
        "名振金闺步玉京，暂留沧海见高情。",
        "众花尽处松千尺，",
        "离心不异西江水，直送征帆万里行。",
        "湘南诗客海中行，鹏翅垂云不自矜。",
        "秋水静磨金镜土，",
        "醉倚西楼人已远，柳溪无浪月澄澄。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359065,
      "title": "哭杨攀处士",
      "content": [
        "先生忧道乐清贫，白发终为不仕身。",
        "嵇阮没来无酒客，",
        "昨夜回舟更惆怅，至今钟磬满南邻。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359066,
      "title": "宿松江驿却寄苏州一二同志",
      "content": [
        "候馆人稀夜自长，姑苏台远树苍苍。",
        "江湖潮落高楼迥，",
        "西园诗侣应多思，莫醉笙歌掩画堂。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359067,
      "title": "卢山人自巴蜀由湘潭归茅山因赠",
      "content": [
        "太乙灵方炼紫荷，紫荷飞尽发皤皤。",
        "猿啼巫峡晓云薄，",
        "华阳旧隐莫归去，水没芝田生绿莎。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359068,
      "title": "颍州从事西湖亭宴饯",
      "content": [
        "西湖清宴不知回，一曲离歌酒一杯。",
        "城带夕阳闻鼓角，",
        "独想征车过巩洛，此中霜菊绕潭开。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359069,
      "title": "瓜洲留别李诩",
      "content": [
        "泣玉三年一见君，白衣憔悴更离群。",
        "柳堤惜别春潮落，",
        "悲歌曲尽莫重奏，心绕关河不忍闻。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359070,
      "title": "余谢病东归，王秀才见寄，今潘秀才南棹奉酬",
      "content": [
        "酷似牢之玉不如，落星山下白云居。",
        "春耕旋构金门客，",
        "莫将年少轻时节，王氏家风在石渠。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359071,
      "title": "献韶阳相国崔公",
      "content": [
        "一匮为功极九层，康庄犹自剑棱棱。",
        "舟回北渚经年泊，",
        "贤臣会致唐虞世，独倚江楼笑范增。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359072,
      "title": "郡斋夜坐寄旧乡二侄",
      "content": [
        "千官奉职衮龙垂，旅卧淮阳鬓日衰。",
        "三月已乖棠树政，",
        "长欲挂帆君莫笑，越禽花晚梦南枝。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359073,
      "title": "病间寄郡中文士",
      "content": [
        "卢橘含花处处香，老人依旧卧清漳。",
        "心同客舍惊秋早，",
        "明朝欲醉文中彦，犹觉吟声带越乡。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359074,
      "title": "贺少师相公致政",
      "content": [
        "六十悬车自古稀，我公年少独忘机。",
        "门临二室留侯隐，",
        "龙城凤沼棠阴在，只恐归鸿更北飞。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359075,
      "title": "题崔处士山居",
      "content": [
        "坐穷今古掩书堂，二顷湖田一半荒。",
        "荆树有花兄弟乐，",
        "向夜欲归心万里，故园松月更苍苍。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359076,
      "title": "疾后与郡中群公宴李秀才",
      "content": [
        "强留佳客宴王孙，岩上余花落酒樽。",
        "书院欲开虫网户，",
        "莫引刘安倚西槛，夜来红叶下江村。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359077,
      "title": "晨起白云楼寄龙兴江准上人兼呈窦秀才",
      "content": [
        "兹楼今是望乡台，乡信全稀晓雁哀。",
        "山翠万重当槛出，",
        "欲吊灵均能赋否，秋风还有木兰开。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359078,
      "title": "宴饯李员外",
      "content": [
        "病守江城眼暂开，昔年吴越共衔杯。",
        "膺舟出镇虚陈榻，",
        "心期解印同君醉，九曲池西望月来。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359079,
      "title": "酬钱汝州",
      "content": [
        "白雪多随汉水流，谩劳旌旆晚悠悠。",
        "笙歌暗写终年恨，",
        "怪来雅韵清无敌，三十六峰当庾楼。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359080,
      "title": "将归姑苏南楼饯送李明府",
      "content": [
        "无处登临不系情，一凭春酒醉高城。",
        "暂移罗绮见山色，",
        "前期迢递今宵短，更倚朱阑待月明。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359081,
      "title": "和浙西从事刘三复送僧南归",
      "content": [
        "楚客送僧归故乡，海门帆势极潇湘。",
        "碧云千里暮愁合，",
        "怜师不得随师去，已戴儒冠事素王。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359082,
      "title": "送上元王明府赴任",
      "content": [
        "莫言名重懒驱鸡，六代江山碧海西。",
        "日照蒹葭明楚塞，",
        "官满定知归未得，九重霄汉有丹梯。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359083,
      "title": "送沈卓少府任江都",
      "content": [
        "炀帝都城春水边，笙歌夜上木兰船。",
        "三千宫女自涂地，",
        "少年作尉须兢慎，莫向楼前坠马鞭。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359084,
      "title": "酬邢杜二员外",
      "content": [
        "雪带东风洗画屏，客星悬处聚文星。",
        "未归嵩岭暮云碧，",
        "岂知京洛旧亲友，梦绕潺湲江上亭。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359085,
      "title": "经故丁补阙郊居",
      "content": [
        "死酬知己道终全，波暖孤冰且自坚。",
        "𫛳上承尘才一日，",
        "四尺孤坟何处是，阖闾城外草连天。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359086,
      "title": "陪宣城大夫崔公泛后池兼北楼宴二首",
      "content": [
        "陪泛芳池醉北楼，水花繁艳照膺舟。",
        "亭台阴合树初昼，",
        "昔时恩遇今能否，一尉沧洲已白头。",
        "江上西来共鸟飞，剪荷浮泛似轻肥。",
        "王珣作簿公曾喜，",
        "宛陵行乐金陵住，遥对家山未忆归。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359087,
      "title": "留别赵端公",
      "content": [
        "海门征棹赴龙泷，暂寄华筵倒玉缸。",
        "箫鼓散时逢夜雨，",
        "却愿烟波阻风雪，待君同拜碧油幢。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359088,
      "title": "寄阳陵处士",
      "content": [
        "旧隐青山紫桂阴，一书迢递寄归心。",
        "谢公楼上晚花盛。",
        "扬子宅前春草深。",
        "吴岫雨来溪鸟浴，楚江云暗岭猿吟，"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359089,
      "title": "与张道士同访李隐君不遇",
      "content": [
        "千岩万壑独携琴，知在陵阳不可寻。",
        "去辙已平秋草遍，",
        "唯有西邻张仲蔚，坐来同怆别离心。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359090,
      "title": "闻州中有宴寄崔大夫兼简邢群评事",
      "content": [
        "箫管筵间列翠蛾，玉杯金液耀金波。",
        "池边雨过飘帷幕，",
        "甘心不及同年友，卧听行云一曲歌。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359091,
      "title": "寄殷尧藩先辈",
      "content": [
        "十载功名翰墨林，为从知己信浮沈。",
        "青山有雪谙松性，",
        "思君一见如琼树，空把新诗尽日吟。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359092,
      "title": "赠河东虞押衙二首",
      "content": [
        "长剑高歌换素衣，君恩未报不言归。",
        "旧精鸟篆谙书体，",
        "生平志气何人见，空上西楼望落晖。",
        "吴门风水各萍流，月满花开懒独游。",
        "万里山川分晓梦，",
        "莫向尊前更惆怅，古来投笔尽封侯。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359093,
      "title": "陵阳春日",
      "content": [
        "百年身世似飘蓬，泽国移家叠嶂中。",
        "万里绿波鱼恋钓，",
        "纵倒芳尊心不醉，故人多在洛城东。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359094,
      "title": "酬杜补阙初春雨中舟次横江喜裴郎中相迎见寄",
      "content": [
        "江馆维舟为庾公，暖波微渌雨蒙蒙。",
        "红桥迤逦春岩下，",
        "郢歌莫问青山吏，鱼在深池鸟在笼。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359095,
      "title": "送张厚浙东谒丁常侍",
      "content": [
        "凉露清蝉柳陌空，故人遥指浙江东。",
        "青山有雪松当涧，",
        "定知洛下声名士，共说膺门得孔融。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359096,
      "title": "酬副使郑端公见寄",
      "content": [
        "一日高名遍九州，玄珠仍向道中求。",
        "郢中白雪惭新唱，",
        "柳营迢递江风阔，夜夜孤吟月下楼。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359097,
      "title": "酬绵州于中丞使君见寄",
      "content": [
        "故人书信越褒斜，新意虽多旧约赊。",
        "皆就一麾先去国，",
        "半月离居犹怅望，可堪垂白各天涯。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359098,
      "title": "春早郡楼书事寄呈府中群公",
      "content": [
        "两鬓垂丝发半霜，石城孤梦绕襄阳。",
        "鸳鸿幕里莲披槛，",
        "岘亭风起花千片，流入南湖尽日香。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359099,
      "title": "元处士自洛归宛陵山居见示詹事相公饯行之什因赠",
      "content": [
        "紫霄峰下绝韦编，旧隐相如结袜前。",
        "月落尚留东合醉，",
        "一顷豆花三顷竹，想应抛却钓鱼船。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359100,
      "title": "送元昼上人归苏州兼寄张厚二首",
      "content": [
        "自卜闲居荆水头，感时相别思悠悠。",
        "一樽酒尽青山暮，",
        "昼公此去应相问，为说沾巾忆旧游。",
        "三年无事客吴乡，南陌春园碧草长。",
        "共醉八门回画舸，",
        "经岁别离心自苦，何堪黄叶落清漳。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359101,
      "title": "送陆拾遗东归",
      "content": [
        "独振儒风遇盛时，紫泥初降世人知。",
        "文章报主非无意，",
        "东归自是缘清兴，莫比商山咏紫芝。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359102,
      "title": "湖南徐明府余之南邻，久不还家，因题林馆",
      "content": [
        "湘南官罢不归来，高阁经年掩绿苔。",
        "鱼溢池塘秋雨过，",
        "借问先生独何处，一篱疏菊又花开。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359103,
      "title": "酬和杜侍御",
      "content": [
        "花时曾省杜陵游，闻下书帷不举头。",
        "因过石城先访戴，",
        "正把新诗望南浦，棹歌应是木兰舟。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359104,
      "title": "酬河中杜侍御重寄",
      "content": [
        "五色如丝下碧空，片帆还绕楚王宫。",
        "文章已变南山雾，",
        "十千沽酒留君醉，莫道归心似转蓬。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359105,
      "title": "寄献三川守刘公",
      "content": [
        "三川歌颂彻咸秦，十二楼前侍从臣。",
        "休闭玉笼留鸑鷟，",
        "自笑东风过寒食，茂陵寥落未知春。",
        "半年三度转蓬居，锦帐心阑羡隼旟。",
        "老去自惊秦塞雁，",
        "春雪未晴春酒贵，莫教愁杀马相如。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359106,
      "title": "送段觉之西蜀结婚",
      "content": [
        "词赋名高身不闲，采衣如锦度函关。",
        "镜中鸾影胡威去，",
        "时人若问西游客，心在重霄鬓欲斑。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359107,
      "title": "长庆寺遇常州阮秀才",
      "content": [
        "高阁晴轩对一峰，毗陵书客此相逢。",
        "晚收红叶题诗遍，",
        "上方有路应知处，疏磬寒蝉树几重。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359108,
      "title": "赠闲师",
      "content": [
        "近日高僧更有谁，宛陵山下遇闲师。",
        "东林共许三乘学，",
        "秋江莫惜题佳句，正是磷磷见底时。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359109,
      "title": "东游留别李丛秀才",
      "content": [
        "烦君沽酒强登楼，罢唱离歌说远游。",
        "文字岂劳诸子重，",
        "起凭栏干各垂泪，又驱羸马向东州。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359110,
      "title": "竹林寺别友人",
      "content": [
        "骚人吟罢起乡愁，暗觉年华似水流。",
        "花满谢城伤共别，",
        "明日分襟又何处，江南江北路悠悠。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    }
  ],
