{
  "data": [
    {
      "id": 267742,
      "title": "送从弟彻东归",
      "content": [
        "缑山领印知公奏，才称同时尽不如。",
        "奉使贺成登册礼，陪班看出降恩书。",
        "去回在路秋尘里，受诏辞归晓漏初。",
        "早晚得为朝署拜，闲坊买宅作邻居。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 267743,
      "title": "哭胡十八遇",
      "content": [
        "早得声名年尚少，寻常志气出风尘。",
        "文场继续成三代，家族辉华在一身。",
        "幼子见生才满月，选书知写未呈人。",
        "送君帐下衣裳白，数尺坟头栢树新。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 267744,
      "title": "赠贾岛",
      "content": [
        "篱落荒凉僮仆饥，乐游原上住多时。",
        "蹇驴放饱骑将出，秋卷装成寄与谁。",
        "拄杖傍田寻野菜，封书乞米趂时炊。",
        "姓名未上登科记，身屈惟应内史知。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 267745,
      "title": "逢王建有赠",
      "content": [
        "年状皆齐初有髭，鹊山漳水每追随。",
        "使君座下朝听易，处士庭中夜会诗。",
        "新作句成相借问，闲求义尽共寻思。",
        "经今三十余年事，却说还同昨日时。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 267746,
      "title": "移居静安坊答元八郎中",
      "content": [
        "长安寺里多时住，虽守卑官不苦贫。",
        "作活每常嫌费力，移居祗是贵容身。",
        "初开井浅偏宜树，渐觉街闲省踏尘。",
        "更喜往还相去近，门前减却送书人。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 267747,
      "title": "送杨少尹赴凤翔",
      "content": [
        "诗名往日动长安，首首人家卷里看。",
        "西学已行秦博士，南宫新拜汉郎官。",
        "得钱祗了还书铺，借宅常时事药栏。",
        "今去岐州生计薄，移居偏近陇头寒。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 267748,
      "title": "送韩侍御归山",
      "content": [
        "闻君久卧在云间，为佐嫖姚未得还。",
        "新阶茆庐招隐逸，独骑骢马入深山。",
        "九灵洞口行应到，五粒松枝醉亦攀。",
        "明日珂声出城去，家僮不复埽柴关。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 267749,
      "title": "新除水曹郎答白舍人见贺",
      "content": [
        "年过五十到南宫，章句无名荷至公。",
        "黄纸开呈相府后，朱衣引入谢班中。",
        "诸曹纵许为仙侣，群吏多嫌是老翁。",
        "最幸紫薇郎见爱，独称官与古人同。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 267750,
      "title": "送杨少尹赴满城",
      "content": [
        "官为本府当身荣，因得还乡任野情。",
        "自废田园今作主，每逢耆老不呼名。",
        "旧游寺里僧应识，新别桥边树已成。",
        "公事况闲诗更好，将随相逐上山行。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 267751,
      "title": "哭元九少府",
      "content": [
        "平生志业独相知，早结云山老去期。",
        "初作学官常共宿，晚登朝列暂同时。",
        "闲来各数经过地，醉后齐吟唱和诗。",
        "今日春风花满宅，入门行哭见灵帷。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 267752,
      "title": "送侯判官赴广州从军",
      "content": [
        "年少才高求自展，将身万里赴军门。",
        "辟书远到开呈客，公服新成著谢恩。",
        "驿舫过江分白堠，戍亭当岭见红旛。",
        "海花蛮草连冬有，行处无家不满园。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 267753,
      "title": "答白杭州郡楼登望画图见寄",
      "content": [
        "画得江城登望处，寄来今日到长安。",
        "乍惊物色从诗出，更想工人下手难。",
        "将展书堂偏觉好，每来朝客尽求看。",
        "见君向此闲吟意，肯恨当时作外官。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 267754,
      "title": "赠赵将军",
      "content": [
        "当年胆略已纵横，每见妖星气不平。",
        "身贵早登龙尾道，功高自破鹿头城。",
        "寻常得对论边事，委曲承恩掌内兵。",
        "会取安西将报国，凌烟阁上大书名。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 267755,
      "title": "送和蕃公主",
      "content": [
        "塞上如今无战尘，汉家公主出和亲。",
        "邑司犹属宗卿寺，册号还同虏帐人。",
        "九姓旗旛先引路，一生衣服尽随身。",
        "毡城南望无回日，空见沙蓬水柳春。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 267756,
      "title": "寒食内宴二首 一",
      "content": [
        "朝光瑞气满宫楼，彩纛鱼龙四面稠。",
        "廊下御厨分冷食，殿前香骑逐飞毬。",
        "千官尽醉犹教坐，百戏皆呈未放休。",
        "共喜拜恩侵夜出，金吾不敢问行由。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 267757,
      "title": "寒食内宴二首 二",
      "content": [
        "城阙沈沈向晓寒，恩当令节赐余欢。",
        "瑞烟深处开三殿，春雨微时引百官。",
        "宝树楼前分绣幕，彩花廊下暎华栏。",
        "宫筵戏乐年年别，已得三廻对御看。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 267758,
      "title": "朝日勅赐百官樱桃",
      "content": [
        "仙果人间都未有，今朝忽见下天门。",
        "捧盘小吏初宣勅，当殿群臣共拜恩。",
        "日色遥分门下坐，露香才出禁中园。",
        "每年重此先偏待，愿得千春奉至尊。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 267759,
      "title": "太白老人",
      "content": [
        "日观东峰幽客住，竹巾藤带亦逢迎。",
        "暗修黄箓无人见，深种胡麻共犬行。",
        "洞里仙家常独往，壶中灵药自为名。",
        "春泉四面遶茅屋，日日唯闻杵臼声。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 267760,
      "title": "和裴司空酬满城杨少尹",
      "content": [
        "圣朝偏重大司空，人咏元和第一功。",
        "拥节高临汉水上，题诗远入舜城中。",
        "共惊向老多年别，更忆登科旧日同。",
        "谁不望归丞相府，江边杨柳又秋风。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 267761,
      "title": "寄和州刘使君",
      "content": [
        "别离已久犹为郡，闲向春风倒酒缾。",
        "送客特过沙口堰，看花多上水心亭。",
        "晓来江气连城白，雨后山光满郭青。",
        "到此诗情应更远，醉中高咏有谁听。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 267762,
      "title": "赠商州王使君",
      "content": [
        "衔命南来会郡堂，却思朝里接班行。",
        "才雄犹是山城守，道薄初为水部郎。",
        "选胜相留开客馆，寻幽更引到僧房。",
        "明朝从此辞君去，独出商关路渐长。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 267763,
      "title": "寄令狐宾客",
      "content": [
        "勋名尽得国家传，退狎琴僧与酒仙。",
        "还带郡符经几处，暂辞台座已三年。",
        "留司未到龙楼下，拜表长怀玉案前。",
        "秋日出城伊水好，领谁相逐上闲船。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 267764,
      "title": "寄梅处士",
      "content": [
        "扰扰人间是与非，官闲自觉省心机。",
        "六行班里身常下，九列符中事亦稀。",
        "市客惯曾赊贱药，家僮惊见著新衣。",
        "君今独得居山乐，应喜多时未办归。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 267765,
      "title": "送施肩吾东归",
      "content": [
        "知君本是烟霞客，被荐因来城阙间。",
        "世业偏临七里濑，仙游多在四明山。",
        "早闻诗句传人徧，新得科名到处闲。",
        "惆怅灞亭相送去，云中琪树不同攀。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 267766,
      "title": "昆仑儿",
      "content": [
        "昆仑家住海中州，蛮客将来汉地游。",
        "言语解教秦吉了，波涛初过郁林洲。",
        "金环欲落曾穿耳，螺髻长卷不裹头。",
        "自爱肌肤黑如漆，行时半脱木绵裘。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 267767,
      "title": "赠李杭州",
      "content": [
        "仙郎白首未归朝，应为苍生领六条。",
        "惠化州人尽清净，高情野鹤与逍遥。",
        "竹间虚馆无朝讼，山畔青田长夏苗。",
        "终日政声长独坐，开门长望浙江潮。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 267768,
      "title": "送郑尚书赴广州",
      "content": [
        "圣朝选将持符节，内使宣时百辟听。",
        "海北蛮夷来舞蹈，岭南封管送图经。",
        "白鹇飞遶迎官舫，红槿开当䜩客亭。",
        "此处莫言多瘴疠，天边看取老人星。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 267769,
      "title": "贺秘书王丞南郊摄将军",
      "content": [
        "正初天子亲郊礼，诏摄将军领卫兵。",
        "斜带银刀入黄道，先随玉辂到青城。",
        "坛边不在千官位，仗外唯闻再拜声。",
        "共喜与君逢此日，病中无计得随行。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 267770,
      "title": "送令狐尚书赴东都留守",
      "content": [
        "朝廷重寄在关东，共说从前选上公。",
        "勋业新城大梁镇，恩荣更守洛阳宫。",
        "行香暂出天桥上，巡礼常过禁殿中。",
        "每领群臣拜章庆，半开门仗日曈曈。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 267771,
      "title": "拜丰陵",
      "content": [
        "岁朝园寝遣公卿，学省班中亦摄行。",
        "身逐陵官齐再拜，手持木铎叩三声。",
        "寒更报点来山殿，晓炬分行照栢城。",
        "却下龙门看渐远，金峰高处日微明。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 267772,
      "title": "赠孔尚书",
      "content": [
        "能将直道历荣班，事著元和实录间。",
        "三表自陈辞北阙，一家相送入南山。",
        "买来侍女教人嫁，赐得朝衣在箧闲。",
        "宅近青山高静处，时归林下暂开关。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 267773,
      "title": "酬杭州白使君兼寄浙东元大夫",
      "content": [
        "相印暂离临远镇，掖垣出守复同时。",
        "一行已作三年别，两处空传七字诗。",
        "越地江山应共见，秦天风月不相知。",
        "人间聚散真难料，莫叹平生信所之。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 267774,
      "title": "寄苏州白二十二使君",
      "content": [
        "三朝出入紫微臣，头白金章未在身。",
        "登第早年同座主，题诗今日是州人。",
        "阊门柳色烟中远，茂苑莺声雨后新。",
        "此处吟诗向山寺，知君忘却曲江春。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 267775,
      "title": "送白宾客分司东都",
      "content": [
        "赫赫声名三十春，高情人独出埃尘。",
        "病辞省闼归闲地，恩许宫曹作上宾。",
        "诗里难同相得伴，酒边多见自由身。",
        "老人也拟休官去，便是君家池上人。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 267776,
      "title": "赠阎少保",
      "content": [
        "辞荣恋阙未还乡，修养年多气力强。",
        "半俸归烧伏火药，全家解说养生方。",
        "特承恩诏新开戟，每见公卿不下床。",
        "竹树晴深寒院静，长悬石磬在虚廊。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 267777,
      "title": "赠别王侍御赴任陕州司马",
      "content": [
        "京城在处闲人少，唯共君行并马蹄。",
        "更和诗篇名最出，时倾杯酒户常齐。",
        "同趋阙下听钟漏，独向军前闻鼓鼙。",
        "今日春明门外别，更无因得到街西。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 267778,
      "title": "田司空入朝",
      "content": [
        "西来将相位兼雄，不与诸君觐礼同。",
        "早变山东知顺命，新收济上立殊功。",
        "朝官叙谒趋门外，恩使喧迎满路中。",
        "阊阖晓开铜漏静，身当受册大明宫。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 267779,
      "title": "送浙西周判官",
      "content": [
        "由来自是烟霞客，早已闻名诗酒间。",
        "天阙因将贺表到，家乡新著赐衣远。",
        "常吟卷里新酬句，自话湖中旧住山。",
        "吴越主人偏爱重，多应不肯放君闲。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 267780,
      "title": "送吴炼师归王屋",
      "content": [
        "玉阳峰下学长生，玉洞仙中已有名。",
        "独戴熊须冠暂出，唯将鹤尾扇同行。",
        "炼成云母休炊爨，已得雷公当吏兵。",
        "却到瑶坛上头宿，应闻空里步虚声。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 267781,
      "title": "送邵州林使君",
      "content": [
        "词客南行宠命新，潇湘郡入曲江津。",
        "山幽自足探微处，俗朴应无争竞人。",
        "郭外相连排殿阁，市中多半用金银。",
        "知君不作家私计，迁日还同到日贫。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 267782,
      "title": "寄王六侍御",
      "content": [
        "渐觉近来筋力少，难堪今日在风尘。",
        "谁能借问功名事，祗自扶持老病身。",
        "贵得药资将助道，肯嫌家计不如人。",
        "洞庭已置新居处，归去安期与作邻。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 267783,
      "title": "送稽亭山寺僧",
      "content": [
        "师住稽亭高处寺，斜廊曲阁倚云开。",
        "山门十里松间入，泉涧三重洞里来。",
        "名岳寻游今已徧，家城礼谒便应回。",
        "旧房到日闲吟后，林下还登说法台。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 267784,
      "title": "送汀州源使君",
      "content": [
        "曾成赵北归朝计，因拜王门最好官。",
        "为郡暂辞双凤阙，全家远过九龙滩。",
        "山乡祗有输蕉户，水镇应多养鸭栏。",
        "地僻寻常来客少，刺桐花发共谁看。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 267785,
      "title": "寄孙洛阳格",
      "content": [
        "久持刑宪声名远，好是中朝正直臣。",
        "赤县上来应足事，青山老去未离身。",
        "常思从省连归马，乍觉同班少旧人。",
        "遥爱南桥秋日晚，雨边杨柳映天津。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 267786,
      "title": "胡山人归王屋因有赠",
      "content": [
        "转转无成到白头，人间举眼尽堪愁。",
        "此生已是蹉跎去，每事应从卤莽休。",
        "虽作闲官少拘束，难逢胜景可淹留。",
        "君归与访移家处，若个峰头最较幽。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 267787,
      "title": "寄虔州韩使君",
      "content": [
        "南康太守负才豪，五十如今未拥旄。",
        "早得一人知姓字，常闻三事说功劳。",
        "月明渡口漳江静，云散城头赣石高。",
        "郡政已成秋思远，闲吟应不问官曹。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 267788,
      "title": "送从弟蒙赴饶州",
      "content": [
        "京城南去鄱阳远，风月悠悠别思劳。",
        "三领郡符新寄重，再登科第旧名高。",
        "去程江上多看堠，迎吏船中亦带刀。",
        "到日更行清静化，春田应不见蓬蒿。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 267789,
      "title": "罗道士",
      "content": [
        "城里无人得实年，衣襟常带臭黄烟。",
        "楼中赊酒唯留药，洞里争棋不赌钱。",
        "闻客语声知贵贱，持花歌咏似狂颠。",
        "寻常行处皆逢见，世上多疑是谪仙。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 267790,
      "title": "寄陆浑赵明府",
      "content": [
        "与君学省同官处，常日相随说道情。",
        "新作陆浑山县长，早知三礼甲科名。",
        "郭中时有仙人住，城内应多药草生。",
        "公事稀疎来客少，无妨著屐独闲行。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 267791,
      "title": "同将作韦二少监赠水部李郎中",
      "content": [
        "旧年同是水曹郎，各罢鱼符自楚乡。",
        "重著青衫承诏命，齐趋紫殿异班行。",
        "别来同说经过事，老去相传补养方。",
        "忆得当时亦连步，如今独在读书堂。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 267792,
      "title": "赠王侍御",
      "content": [
        "心同野鹤与尘远，诗似冰壶见底清。",
        "府县同趋昨日事，升沈不改故人情。",
        "上阳春晚萧萧雨，洛水寒来夜夜声。",
        "自叹独为折腰吏，可怜騘马路傍行。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 267793,
      "title": "送金少卿副使归新罗",
      "content": [
        "云岛茫茫天畔微，向东万里一帆飞。",
        "久为侍子承恩重，今佐使臣衔命归。",
        "通海便应将国信，到家犹自著朝衣。",
        "从前此去人无数，光彩如君定是稀。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 267794,
      "title": "送李司空赴镇襄阳",
      "content": [
        "中外兼权社稷臣，千官齐出拜行尘。",
        "再调公鼎勋庸盛，三受兵符宠命新。",
        "商路雪开旗斾展，楚堤梅发驿亭春。",
        "襄阳风景由来好，重与江山作主人。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 267795,
      "title": "送李仆射愬赴镇凤翔",
      "content": [
        "由来勋业属英雄，兄弟连营列位同。",
        "先入贼城擒首恶，尽封筦库让元公。",
        "旌幢独继家声外，竹帛新添国史中。",
        "天子新收秦陇地，故教移镇古扶风。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 267796,
      "title": "寄白二十二舍人",
      "content": [
        "早知内诏过先辈，蹭蹬江南百事疎。",
        "湓浦成中为上佐，炉峰寺后著幽居。",
        "偏依仙法多求药，长共僧游不读书。",
        "三省比来名望重，肯容君去乐樵渔。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 267797,
      "title": "送友人卢处士游吴越",
      "content": [
        "羡君东去见残梅，惟有王孙独未回。",
        "吴苑夕阳明古堞，越宫春草上高台。",
        "波生野水雁初下，风满驿楼潮欲来。",
        "试问渔舟看雪浪，几多江燕荇花开。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 267798,
      "title": "苏州江岸留别乐天",
      "content": [
        "银泥裙暎锦障泥，画舸停桡马簇蹄。",
        "清管曲终鹦鹉语，红旗影动薄寒嘶。",
        "渐消酒色朱颜浅，欲话离情翠黛低。",
        "莫忘使君吟咏处，女坟湖北武丘西。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 267799,
      "title": "寒食看花",
      "content": [
        "早入公门到夜归，不因寒食少闲时。",
        "颠狂遶树猿离锁，踊跃缘冈马断羁。",
        "酒污衣裳从客笑，醉饶言语觅花知。",
        "老来自喜常无事，仰面西园得咏诗。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 267800,
      "title": "酬浙东元尚书见寄绫素",
      "content": [
        "越地缯纱纹样新，远封来寄学曹人。",
        "便令裁制为时服，顿觉光荣上病身。",
        "应念此官同弃置，独能相贺更殷勤。",
        "三千里外无由见，海上东风又一春。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 267801,
      "title": "赠项斯",
      "content": [
        "端坐吟诗忘忍饥，万人中觅似君稀。",
        "门连野水风长到，驴放秋原夜不归。",
        "日煖剩收新落叶，天寒更著旧生衣。",
        "曲江亭上频频见，为爱鸬鹚雨里飞。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 267802,
      "title": "和韦开州盛山十二首 宿云亭",
      "content": [
        "清净当深处，虚明向远开。",
        "卷帘无俗客，应只见云来。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 267803,
      "title": "和韦开州盛山十二首 梅溪",
      "content": [
        "自爱新梅好，行寻一径斜。",
        "不教人扫石，恐损落来花。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 267804,
      "title": "和韦开州盛山十二首 茶岭",
      "content": [
        "紫芽连白蘂，初向岭头生。",
        "自看家人摘，寻常触露行。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 267805,
      "title": "和韦开州盛山十二首 流杯渠",
      "content": [
        "渌酒白螺杯，随流去复回。",
        "似知人把处，各向面前来。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 267806,
      "title": "和韦开州盛山十二首 盘石磴",
      "content": [
        "垒石盘空远，层层势不危。",
        "不知行几匝，得到上头时。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 267807,
      "title": "和韦开州盛山十二首 桃坞",
      "content": [
        "春坞桃花发，多将野客游。",
        "日西殊未散，看望酒缸头。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 267808,
      "title": "和韦开州盛山十二首 竹岩",
      "content": [
        "独入千竿里，缘岩踏石层。",
        "笋头齐欲出，更不许人登。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 267809,
      "title": "和韦开州盛山十二首 琵琶台",
      "content": [
        "台上绿萝春，闲登不待人。",
        "每当休暇日，著履戴纱巾。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 267810,
      "title": "和韦开州盛山十二首 胡芦沼",
      "content": [
        "曲沼春流满，新蒲映野鹅。",
        "闲斋朝饭后，拄杖遶行多。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 267811,
      "title": "和韦开州盛山十二首 隐月岫",
      "content": [
        "月出深峰里，清凉夜亦寒。",
        "每嫌西落疾，不得到明看。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 267812,
      "title": "和韦开州盛山十二首 绣衣石榻",
      "content": [
        "山城无别味，药草兼鱼果。",
        "时到绣衣人，同来石上坐。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 267813,
      "title": "和韦开州盛山十二首 上士泉缾",
      "content": [
        "堦上一眼泉，四边青石甃。",
        "唯有护净僧，添缾将盥漱。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 267814,
      "title": "送远客",
      "content": [
        "憔悴远归客，殷勤欲别杯。",
        "九星坛下路，几日见重来。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 267815,
      "title": "寄西峰僧",
      "content": [
        "松暗水涓涓，夜凉人未眠。",
        "西峰月犹在，遥忆草堂前。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 267816,
      "title": "禅师",
      "content": [
        "独在西峰顶，年年闭石房。",
        "定中无弟子，人到为焚香。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 267817,
      "title": "惜花",
      "content": [
        "山中春已晚，处处见花稀。",
        "明日来应尽，林间宿不归。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 267818,
      "title": "题晖师影堂",
      "content": [
        "日早欲参禅，竟无相识缘。",
        "道场今独到，惆怅影堂前。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 267819,
      "title": "泾州塞",
      "content": [
        "行到泾州塞，唯闻羌戍鼙。",
        "道边古双堠，犹记向安西。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 267820,
      "title": "野田",
      "content": [
        "漠漠野田草，草中牛羊道。",
        "古墓无子孙，白杨不得老。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 267821,
      "title": "岸花",
      "content": [
        "可怜岸边树，红蘂发青条。",
        "东风吹渡水，冲着木兰桡。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 267822,
      "title": "别于鹄",
      "content": [
        "离灯及晨辉，行人起复思。",
        "出门两相顾，青山路逶迤。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 267823,
      "title": "送蜀客",
      "content": [
        "蜀客南行祭碧鸡，木棉花发锦江西。",
        "山桥日晚行人少，时见猩猩树上啼。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 267824,
      "title": "送元结",
      "content": [
        "昔日同游漳水边，如今重说恨绵绵。",
        "天涯相见还离别，客路秋风又几年。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 267825,
      "title": "宿山祠",
      "content": [
        "秋草宫人斜里墓，宫人谁送葬来时。",
        "千千万万皆如此，家在边城亦不知。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 267826,
      "title": "美人宫棋",
      "content": [
        "红烛台前出翠娥，海沙铺局巧相和。",
        "趂行移手巡收尽，数数看谁得最多。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 267827,
      "title": "蛮州",
      "content": [
        "瘴水蛮中入洞流，人家多住竹棚头。",
        "一山海上无城郭，唯见松牌记象州。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 267828,
      "title": "送元宗简",
      "content": [
        "貂帽垂肩窄皂裘，雪深骑马向西州。",
        "暂时相见还相送，却闭闲门依旧愁。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 267829,
      "title": "寄徐晦",
      "content": [
        "鄠陂鱼美酒偏浓，不出琴斋见雪峰。",
        "应胜昨来趋府日，簿书床上乱重重。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 267830,
      "title": "寄白学士",
      "content": [
        "自掌天书见客稀，纵因休沐锁双扉。",
        "几回扶病欲相访，知向禁中归未归。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 267831,
      "title": "喜王六同宿",
      "content": [
        "十八年来恨别离，唯同一宿咏新诗。",
        "更相借问诗中语，共说如今胜旧时。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 267832,
      "title": "题玉像堂",
      "content": [
        "玉毫不着世间尘，辉相分明十八身。",
        "入夜无烟灯更好，堂中唯有转经人。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 267833,
      "title": "与贾岛闲游",
      "content": [
        "水北原南草色新，雪消风暖不生尘。",
        "城中车马应无数，能解闲行有几人。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 267834,
      "title": "哭丘长史",
      "content": [
        "丘公已殁故人稀，欲过街西更访谁。",
        "每到子城东路上，忆君相逐入朝时。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 267835,
      "title": "哭孟寂",
      "content": [
        "曲江院里题名处，十九人中最少年。",
        "今日春光君不见，杏花零落寺门前。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 267836,
      "title": "患眼",
      "content": [
        "三年患眼今年[校]，[免]与风光便隔生。",
        "昨日韩家后园里，看花犹似未分明。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 267837,
      "title": "答刘竞",
      "content": [
        "刘君久被时抛掷，老向城中作选人。",
        "昨日街西相近住，每来存问老夫身。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 267838,
      "title": "赠华严院僧",
      "content": [
        "一身依止荒闲院，烛耀窗中有宿烟。",
        "徧礼华严经里字，不曾行到寺门前。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 267839,
      "title": "逢故人",
      "content": [
        "山东一十余年别，今日相逢在上都。",
        "说尽向来无限事，相看摩捋白髭须。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 267840,
      "title": "送萧远弟",
      "content": [
        "街北槐花傍马垂，病身相送出门迟。",
        "与君别后秋风夜，作得新诗说向谁。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 267841,
      "title": "送辛少府任乐安",
      "content": [
        "才多不肯浪容身，老大诗章转更新。",
        "选得天台山下住，一家全作学仙人。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    }
  ],
