{
  "data": [
    {
      "id": 347307,
      "title": "发渝州却寄韦判官",
      "content": [
        "红烛津亭夜见君，繁弦急管两纷纷。",
        "平明分手空江转，唯有猿声满水云。"
      ],
      "author": {
        "id": 1360,
        "name": "司空曙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 347308,
      "title": "送卢彻之太原谒马尚书",
      "content": [
        "榆落雕飞关塞秋，黄云画角见并州。",
        "翩翩羽骑双旌后，上客亲随郭细侯。"
      ],
      "author": {
        "id": 1360,
        "name": "司空曙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 347309,
      "title": "峡口送友人",
      "content": [
        "峡口花飞欲尽春，天涯去住泪沾巾。",
        "来时万里同为客，今日翻成送故人。"
      ],
      "author": {
        "id": 1360,
        "name": "司空曙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 347312,
      "title": "送吉校书东归",
      "content": [
        "少年芸阁吏，罢直暂归休。",
        "独与亲知别，行逢江海秋。",
        "听猿看楚岫，随雁到吴洲。",
        "处处园林好，何人待子猷。"
      ],
      "author": {
        "id": 1360,
        "name": "司空曙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 347314,
      "title": "秋日趋府上张大夫",
      "content": [
        "重城洞启肃秋烟，共说羊公在镇年。",
        "鞞鼓暗惊林叶落，",
        "谪吏何能沐风化，空将歌颂拜车前。"
      ],
      "author": {
        "id": 1360,
        "name": "司空曙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 347322,
      "title": "远寺钟",
      "content": [
        "杳杳疏钟发，因风清复引。",
        "中宵独听之，似与东林近。"
      ],
      "author": {
        "id": 1360,
        "name": "司空曙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 347324,
      "title": "新柳",
      "content": [
        "全欺芳蕙晚，似妒寒梅疾。",
        "撩乱发青条，春风来几日。"
      ],
      "author": {
        "id": 1360,
        "name": "司空曙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 347327,
      "title": "晚思",
      "content": [
        "蛩余窗下月，草湿阶前露。",
        "晚景凄我衣，秋风入庭树。"
      ],
      "author": {
        "id": 1360,
        "name": "司空曙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 347330,
      "title": "哭麹山人",
      "content": [
        "忆昔秋风起，君曾叹逐臣。",
        "何言芳草日，自作九泉人。"
      ],
      "author": {
        "id": 1360,
        "name": "司空曙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 347335,
      "title": "寄卫明府常见短靴褐裘，又务持诵是以有末句之赠",
      "content": [
        "柴桑官舍近东林，儿稚初髫即道心。",
        "侧寄绳床嫌凭几，",
        "翠竹黄花皆佛性，莫教尘境误相侵。"
      ],
      "author": {
        "id": 1360,
        "name": "司空曙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 347336,
      "title": "酬李端校书见赠",
      "content": [
        "绿槐垂穗乳乌飞，忽忆山中独未归。",
        "青镜流年看发变，",
        "昨日闻君到城阙，莫将簪弁胜荷衣。"
      ],
      "author": {
        "id": 1360,
        "name": "司空曙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 347337,
      "title": "过卢秦卿旧居",
      "content": [
        "五柳茅茨楚国贤，桔槔蔬圃水涓涓。",
        "黄花寒后难逢蝶。",
        "红叶晴来忽有蝉。",
        "韩康助采君臣药，支遁同看内外篇。",
        "为问潜夫空著论，如何侍从赋甘泉。"
      ],
      "author": {
        "id": 1360,
        "name": "司空曙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 347338,
      "title": "秋园",
      "content": [
        "伤秋不是惜年华，别忆春风碧玉家。",
        "强向衰丛见芳意，茱萸红实似繁花。"
      ],
      "author": {
        "id": 1360,
        "name": "司空曙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 347339,
      "title": "送王使君赴太原拜节度副使",
      "content": [
        "新从刘太尉，结束向并州。",
        "络脑青丝骑，盘囊锦带钩。",
        "出关逢将校，下岭拥戈矛。",
        "匣闭黄云冷，山传画角秋。",
        "剑锋将破虏，函道罢登楼。",
        "岂作书生老，当封万户侯。"
      ],
      "author": {
        "id": 1360,
        "name": "司空曙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 347340,
      "title": "拟百劳歌",
      "content": [
        "朱丝纽弦金点杂，双蒂芙蓉共开合。",
        "谁家稚女著罗裳，",
        "玉颜年几新上头，回身敛笑多自羞。",
        "红销月落不复见，"
      ],
      "author": {
        "id": 1360,
        "name": "司空曙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 347341,
      "title": "迎神",
      "content": [
        "吉日兮临水，沐青兰兮白芷。",
        "假山鬼兮请东皇，",
        "鸾旌圆盖望欲来，山雨霏霏江浪起。",
        "神既降兮我独知，"
      ],
      "author": {
        "id": 1360,
        "name": "司空曙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 347342,
      "title": "送神",
      "content": [
        "神之去，回风袅袅云容与。",
        "桂尊瑶席不复陈，"
      ],
      "author": {
        "id": 1360,
        "name": "司空曙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 347343,
      "title": "残莺百啭歌同王员外耿拾遗吉中孚李端游慈恩各赋一物",
      "content": [
        "残莺一何怨，百啭相寻续。",
        "始辨下将高，稍分长复促。",
        "绵蛮巧状语，机节终如曲。",
        "野客赏应迟，幽僧闻讵足。",
        "禅斋深树夏阴清，零落空余三两声。",
        "金谷筝中传不似，",
        "送暖初随柳色来，辞芳暗逐花枝尽。",
        "歌残莺，歌残莺，",
        "乃知众鸟非俦比，暮噪晨鸣倦人耳。",
        "共爱奇音那可亲，"
      ],
      "author": {
        "id": 1360,
        "name": "司空曙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 347344,
      "title": "过终南柳处士",
      "content": [
        "云起山苍苍，林居萝薜荒。",
        "幽人老深境，素发与青裳。",
        "雨涤莓苔绿，风摇松桂香。",
        "洞泉分溜浅，岩笋出丛长。",
        "败屦安松砌，余棋在石床。",
        "书名一为别，还路已堪伤。"
      ],
      "author": {
        "id": 1360,
        "name": "司空曙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 347347,
      "title": "同张参军喜李尚书寄新琴",
      "content": [
        "新琴传凤凰，晴景称高张。",
        "白玉连徽净，朱丝系爪长。",
        "轻埃随拂拭，杂籁满铿锵。",
        "暗想山泉合，如亲兰蕙芳。",
        "正声消郑卫，古状掩笙簧。",
        "远识贤人意，清风愿激扬。"
      ],
      "author": {
        "id": 1360,
        "name": "司空曙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 347348,
      "title": "苦热",
      "content": [
        "暑气发炎州，焦烟远未收。",
        "啸风兼炽焰，挥汗讶成流。",
        "鹳鹊投林尽，龟鱼拥石稠。",
        "漱泉齐饮酎，衣葛剧兼裘，"
      ],
      "author": {
        "id": 1360,
        "name": "司空曙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 347349,
      "title": "送人归黔府",
      "content": [
        "伏波箫鼓水云中，长戟如霜大旆红。",
        "油幕晓开飞鸟绝，翩翩上将独趋风。"
      ],
      "author": {
        "id": 1360,
        "name": "司空曙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 347355,
      "title": "送程秀才",
      "content": [
        "悠悠多路岐，相见又别离。",
        "东风催节换，焰焰春阳散。",
        "楚草渐烟绵，江云亦芜漫。",
        "送子恨何穷，故关如梦中。",
        "游人尽还北，旅雁辞南国。",
        "枫树几回青，逐臣归不得。"
      ],
      "author": {
        "id": 1360,
        "name": "司空曙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 347356,
      "title": "长林令卫象饧丝结歌",
      "content": [
        "主人雕盘盘素丝，寒女眷眷墨子悲。",
        "乃言假使饧为之，",
        "仰坼重衣倾万蕊，又如合欢交乱枝，红茸向暮花参差。",
        "吴蚕络茧抽尚绝，细缕纤毫看欲灭。",
        "雪发羞垂倭堕鬟，"
      ],
      "author": {
        "id": 1360,
        "name": "司空曙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 347357,
      "title": "酬崔峒见寄",
      "content": [
        "趋陪禁掖雁行随，迁放江潭鹤发垂。",
        "素浪遥疑太液水，",
        "共望汉朝多沛泽，苍蝇早晚得先知。"
      ],
      "author": {
        "id": 1360,
        "name": "司空曙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 347361,
      "title": "送史申之峡州",
      "content": [
        "峡口巴江外，无风浪亦翻。",
        "蒹葭新有雁，云雨不离猿。",
        "行客思乡远，愁人赖酒昏。",
        "檀郎好联句，共滞谢家门。"
      ],
      "author": {
        "id": 1360,
        "name": "司空曙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 347366,
      "title": "新蝉",
      "content": [
        "今朝蝉忽鸣，迁客若为情。",
        "便觉一年老，能令万感生。",
        "微风方满树，落日稍沉城。",
        "为问同怀者，凄凉听几声。"
      ],
      "author": {
        "id": 1360,
        "name": "司空曙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 347367,
      "title": "送张弋",
      "content": [
        "拥棹江天旷，苍然下郢城。",
        "冰霜葭菼变，云泽鹧鸪鸣。",
        "酒倦临流醉，人逢置榻迎。",
        "尝闻藉东观，不独鲁诸生。"
      ],
      "author": {
        "id": 1360,
        "name": "司空曙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 347368,
      "title": "送僧无言归山",
      "content": [
        "袈裟出尘外，山径几盘缘。",
        "人到白云树，鹤沉青草田。",
        "龛泉朝请盥，松籁夜和禅。",
        "自昔闻多学，逍遥注一篇。"
      ],
      "author": {
        "id": 1360,
        "name": "司空曙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 347369,
      "title": "和卢校书文若早入使院书事",
      "content": [
        "解带独裴回，秋风如水来。",
        "轩墀湿繁露，琴几拂轻埃。",
        "晨鸟犹在叶，夕虫余□苔。",
        "苍然发高兴，相仰坐难陪。"
      ],
      "author": {
        "id": 1360,
        "name": "司空曙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 347370,
      "title": "送史泽之长沙",
      "content": [
        "谢脁怀西府，单车触火云。",
        "野蕉依戍客，庙竹映湘君。",
        "梦渚巴山断，长沙楚路分。",
        "一杯从别后，风月不相闻。"
      ],
      "author": {
        "id": 1360,
        "name": "司空曙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 347374,
      "title": "送李嘉佑正字括图书兼往扬州觐省",
      "content": [
        "不事兰台贵，全多韦带风。",
        "儒官比刘向，使者得陈农。",
        "晚烧平芜外，朝阳叠浪东。",
        "归来喜调膳，寒笋出林中。"
      ],
      "author": {
        "id": 1360,
        "name": "司空曙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 347375,
      "title": "送刘侍御",
      "content": [
        "狱成收夜烛，整豸出登车。",
        "黄叶辞荆楚，青山背汉初。",
        "早朝新羽卫，晚下步徒胥。",
        "应念长沙谪，思乡不食鱼。"
      ],
      "author": {
        "id": 1360,
        "name": "司空曙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 347378,
      "title": "送曹同椅",
      "content": [
        "青春三十余，众艺尽无如。",
        "中散诗传画，将军扇续书。",
        "楚田晴下雁，江日暖游鱼。",
        "惆怅空相送，欢游自此疏。"
      ],
      "author": {
        "id": 1360,
        "name": "司空曙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 347382,
      "title": "玩花与卫象同醉",
      "content": [
        "衰鬓千茎雪，他乡一树花。",
        "今朝与君醉，忘却在长沙。"
      ],
      "author": {
        "id": 1360,
        "name": "司空曙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 347383,
      "title": "送王尊师归湖州",
      "content": [
        "烟芜满洞青山绕，幢节飘空紫凤飞。",
        "金阙乍看迎日丽，",
        "莫学辽东华表上，千年始欲一回归。"
      ],
      "author": {
        "id": 1360,
        "name": "司空曙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 347385,
      "title": "九日送人",
      "content": [
        "送人冠獬豸，值节佩茱萸。",
        "均赋征三壤，登车出五湖。",
        "水风凄落日，岸叶飒衰芜。",
        "自恨尘中使，何因在路隅。"
      ],
      "author": {
        "id": 1360,
        "name": "司空曙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 347387,
      "title": "遇谷口道士",
      "content": [
        "一见林中客，闲知州县劳。",
        "白云秋色远，苍岭夕阳高。",
        "自说名因石，谁逢手种桃。",
        "丹经倘相授，何用恋青袍。"
      ],
      "author": {
        "id": 1360,
        "name": "司空曙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 347391,
      "title": "送张炼师还峨嵋山",
      "content": [
        "太一天坛天柱西，垂萝为幌石为梯。",
        "前登灵境青霄绝，",
        "春山一入寻无路，鸟响烟深水满溪。"
      ],
      "author": {
        "id": 1360,
        "name": "司空曙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 347392,
      "title": "逢江客问南中故人因以诗寄",
      "content": [
        "南客何时去，相逢问故人。",
        "望乡空泪落，嗜酒转家贫。",
        "疏懒辞微禄，东西任老身。",
        "上楼多看月，临水共伤春。",
        "五柳终期隐，双鸥自可亲。",
        "应怜折腰吏，冉冉在风尘。"
      ],
      "author": {
        "id": 1360,
        "name": "司空曙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 347393,
      "title": "送皋法师",
      "content": [
        "江草知寒柳半衰，行吟怨别独迟迟。",
        "何人讲席投如意，唯有东林远法师。"
      ],
      "author": {
        "id": 1360,
        "name": "司空曙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 347398,
      "title": "关山月",
      "content": [
        "苍茫明月上，夜久光如积。",
        "野幕冷胡霜，关楼宿边客。",
        "陇头秋露暗，碛外寒沙白。",
        "唯有故乡人，沾裳此闻笛。"
      ],
      "author": {
        "id": 1360,
        "name": "司空曙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 347399,
      "title": "御制雨后出城观览，敕朝臣已下属和",
      "content": [
        "上上开鹑野，师师出凤城。",
        "因知圣主念，得遂老农情。",
        "陇麦垂秋合，郊尘得雨清。",
        "时新荐玄祖，岁足富苍生。",
        "却马川原静，闻鸡水土平。",
        "熏弦歌舜德，和鼎致尧名。",
        "览物欣多稼，垂衣御大明。",
        "史官何所录，称瑞满天京。"
      ],
      "author": {
        "id": 1360,
        "name": "司空曙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 347400,
      "title": "奉和常舍人晚秋集贤院即事寄徐薛二侍郎",
      "content": [
        "蔼蔼凤凰宫，兰台玉署通。",
        "夜霜凝树羽，朝日照相风。",
        "官附三台贵，儒开百氏宗。",
        "司言陈禹命，侍讲发尧聪。",
        "香卷青编内，铅分绿字中。",
        "缀签从太史，锵佩揖群公。",
        "池接天泉碧，林交御果红。",
        "寒龟登故叶，秋蝶恋疏丛。",
        "颜谢征文并，钟裴直事同。",
        "离群惊海鹤，属思怨江枫。",
        "地远姑苏外，山长越绝东。",
        "惭当哲匠后，下曲本难工。"
      ],
      "author": {
        "id": 1360,
        "name": "司空曙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 347403,
      "title": "独游寄卫长林",
      "content": [
        "草绿春阳动，迟迟泽畔游。",
        "恋花同野蝶，爱水剧江鸥。",
        "身外唯须醉，人间尽是愁。",
        "那知鸣玉者，不羡卖瓜侯。"
      ],
      "author": {
        "id": 1360,
        "name": "司空曙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 347406,
      "title": "题落叶",
      "content": [
        "霜景催危叶，今朝半树空。",
        "萧条故国异，零落旅人同。",
        "飒岸浮寒水，依阶拥夜虫。",
        "随风偏可羡，得到洛阳宫。"
      ],
      "author": {
        "id": 1360,
        "name": "司空曙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 347408,
      "title": "送况上人还荆州，因寄卫侍御象",
      "content": [
        "惠持游蜀久，策杖欲西还。",
        "共别此宵月，独归何处山。",
        "对鸥沙草畔，洗足野云间。",
        "知有玄晖会，斋心受八关。"
      ],
      "author": {
        "id": 1360,
        "name": "司空曙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 347409,
      "title": "别卢纶",
      "content": [
        "有月多同赏，无秋不共悲。",
        "如何与君别，又是菊黄时。"
      ],
      "author": {
        "id": 1360,
        "name": "司空曙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 347410,
      "title": "雪二首",
      "content": [
        "乐游春苑望鹅毛，宫殿如星树似毫。",
        "漫漫一川横渭水，太阳初出五陵高。",
        "王屋南崖见洛城，石龛松寺上方平。",
        "半山槲叶当窗下，一夜曾闻雪打声。"
      ],
      "author": {
        "id": 1360,
        "name": "司空曙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 347411,
      "title": "酬卫长林岁日见呈",
      "content": [
        "地暖雪花摧，天春斗柄回。",
        "朱泥一丸药，柏叶万年杯。",
        "旅雁辞人去，繁霜满镜来。",
        "今朝彩盘上，神燕不须雷。"
      ],
      "author": {
        "id": 1360,
        "name": "司空曙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 347412,
      "title": "杜鹃行",
      "content": [
        "古时杜宇称望帝，魂作杜鹃何微细。",
        "跳枝窜叶树木中，",
        "隳形不敢栖华屋，短翮唯愿巢深丛。",
        "穿皮啄朽觜欲秃，",
        "声音咽哕若有谓，号啼略与婴儿同。",
        "口干垂血转迫促，",
        "乃知变化不可穷，岂知昔日居深宫，嫔妃左右如花红。"
      ],
      "author": {
        "id": 1360,
        "name": "司空曙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 347413,
      "title": "寄胡居士",
      "content": [
        "日暖风微南陌头，青田红树起春愁。",
        "伯劳相逐行人别，",
        "为言惆怅嵩阳寺，明月高松应独游。"
      ],
      "author": {
        "id": 1360,
        "name": "司空曙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 347416,
      "title": "梁城老人怨",
      "content": [
        "朝为耕种人，暮作刀枪鬼。",
        "相看父子血，共染城壕水。"
      ],
      "author": {
        "id": 1360,
        "name": "司空曙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 376733,
      "title": "云阳馆与韩绅宿别",
      "content": [
        "故人江海别，几度隔山川。",
        "乍见翻疑梦，相悲各问年。",
        "孤灯寒照雨，深竹暗浮烟。",
        "更有明朝恨，离杯惜共传。"
      ],
      "author": {
        "id": 1360,
        "name": "司空曙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 376734,
      "title": "喜外弟卢纶见宿",
      "content": [
        "静夜四无邻，荒居旧业贫。",
        "雨中黄叶树，灯下白头人。",
        "以我独沉久，愧君相见频。",
        "平生自有分，况是蔡家亲。"
      ],
      "author": {
        "id": 1360,
        "name": "司空曙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    }
  ],
