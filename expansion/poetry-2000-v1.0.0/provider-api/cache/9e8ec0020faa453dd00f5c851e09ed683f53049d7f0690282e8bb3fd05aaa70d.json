{
  "data": [
    {
      "id": 299035,
      "title": "点绛唇",
      "content": [
        "荫绿围红，梦琼家在桃源住。",
        "画桥当路，临水开朱户。",
        "柳径春深，行到关情处。",
        "颦不语，意凭风絮，吹向郎边去。"
      ],
      "author": {
        "id": 8353,
        "name": "冯延巳"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 312199,
      "title": "点绛唇",
      "content": [
        "雨恨云愁，江南依旧称佳丽。",
        "水村渔市。",
        "一缕孤烟细。",
        "天际征鸿，遥认行如缀。",
        "平生事。",
        "此时凝睇。",
        "谁会凭阑意。"
      ],
      "author": {
        "id": 1721,
        "name": "王禹"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312204,
      "title": "点绛唇",
      "content": [
        "水陌轻寒，社公雨足东风慢。",
        "定巢新燕。",
        "湿雨穿花转。",
        "象尺熏炉，拂晓停针线。",
        "愁蛾浅。",
        "飞红零乱。",
        "侧卧珠帘卷。"
      ],
      "author": {
        "id": 12700,
        "name": "寇准"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312224,
      "title": "点绛唇",
      "content": [
        "金谷年年，乱生春色谁为主。",
        "馀花落处。",
        "满地和烟雨。",
        "又是离歌，一阕长亭暮。",
        "王孙去。",
        "萋萋无数。",
        "南北东西路。"
      ],
      "author": {
        "id": 11530,
        "name": "林逋"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312647,
      "title": "点绛唇",
      "content": [
        "露下风高，井梧宫簟生秋意。",
        "画堂筵启。",
        "一曲呈珠缀。",
        "天外行云，欲去凝香袂。",
        "炉烟起。",
        "断肠声里。",
        "敛尽双蛾翠。"
      ],
      "author": {
        "id": 6242,
        "name": "晏殊"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313053,
      "title": "点绛唇",
      "content": [
        "病起恹恹，画堂花谢添憔悴。",
        "乱红飘砌。",
        "滴尽胭脂泪。",
        "惆怅前春，谁向花前醉。",
        "愁无际。",
        "武陵回睇。",
        "人远波空翠。"
      ],
      "author": {
        "id": 12016,
        "name": "韩琦"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313286,
      "title": "点绛唇",
      "content": [
        "秋气微凉，梦回明月穿帘幕。",
        "井梧萧索。",
        "正绕南枝鹊。",
        "宝瑟尘生，金雁空零落。",
        "情无托。",
        "鬓云慵掠。",
        "不似君恩薄。"
      ],
      "author": {
        "id": 3916,
        "name": "王安国"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313484,
      "title": "点绛唇",
      "content": [
        "花信来时，恨无人似花依旧。",
        "又成春瘦。",
        "折断门前柳。",
        "天与多情，不与长相守。",
        "分飞后。",
        "泪痕和酒。",
        "占了双罗袖。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313485,
      "title": "点绛唇",
      "content": [
        "明日征鞭，又将南陌垂杨折。",
        "自怜轻别。",
        "拼得音尘绝。",
        "杏子枝边，倚处阑干月。",
        "依前缺。",
        "去年时节。",
        "旧事无人说。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313486,
      "title": "点绛唇",
      "content": [
        "碧水东流，漫题凉叶津头寄。",
        "谢娘春意。",
        "临水颦双翠。",
        "日日骊歌，空费行人泪。",
        "成何计。",
        "未如浓醉。",
        "闲掩红楼睡。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313487,
      "title": "点绛唇",
      "content": [
        "妆席相逢，旋匀红泪歌金缕。",
        "意中曾许。",
        "欲共吹花去。",
        "长爱荷香，柳色殷桥路。",
        "留人住。",
        "淡烟微雨。",
        "好个双栖处。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313488,
      "title": "点绛唇",
      "content": [
        "湖上西风，露花啼处秋香老。",
        "谢家春草。",
        "唱得清商好。",
        "笑倚兰舟，转尽新声了。",
        "烟波渺。",
        "暮云稀少。",
        "一点凉蟾小。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313587,
      "title": "点绛唇",
      "content": [
        "春睡腾腾，觉来鸳被堆香暖。",
        "起来慵懒。",
        "触目情何限。",
        "深院日斜，人静花阴转。",
        "柔肠断。",
        "凭高不见。",
        "芳草连天远。"
      ],
      "author": {
        "id": 13500,
        "name": "王安礼"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313609,
      "title": "点绛唇",
      "content": [
        "波上清风，画船明月人归后，渐消残酒。",
        "独自凭阑久。",
        "聚散匆匆，此恨年年有，重回首。",
        "淡烟疏柳。",
        "隐隐芜城漏。"
      ],
      "author": {
        "id": 2516,
        "name": "魏夫人"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313822,
      "title": "点绛唇",
      "content": [
        "我辈情锺，古来谁似龙山宴。",
        "而今楚甸。",
        "戏马馀飞观。",
        "顾谓佳人，不觉秋强半。",
        "筝声远。",
        "鬓云吹乱。",
        "愁入参差雁。"
      ],
      "author": {
        "id": 11678,
        "name": "苏轼"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313823,
      "title": "点绛唇",
      "content": [
        "不用悲秋，今年身健还高宴。",
        "江村海甸。",
        "总作空花观。",
        "尚想横汾，兰菊纷相半。",
        "楼船远。",
        "白云飞乱。",
        "空有年年雁。"
      ],
      "author": {
        "id": 11678,
        "name": "苏轼"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313824,
      "title": "点绛唇",
      "content": [
        "莫唱阳关，风流公子方终宴。",
        "秦山禹甸。",
        "缥缈真奇观。",
        "北望平原，落日山衔半。",
        "孤帆远。",
        "我歌君乱。",
        "一送西飞雁。"
      ],
      "author": {
        "id": 11678,
        "name": "苏轼"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313825,
      "title": "点绛唇",
      "content": [
        "醉漾轻舟，信流引到花深处。",
        "尘缘相误。",
        "无计花间住。",
        "烟水茫茫，千里斜阳暮。",
        "山无数。",
        "乱红如雨。",
        "不记来时路。"
      ],
      "author": {
        "id": 11678,
        "name": "苏轼"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313826,
      "title": "点绛唇",
      "content": [
        "月转乌啼，画堂宫征生离恨。",
        "美人愁闷。",
        "不管罗衣褪。",
        "清泪斑斑，挥断柔肠寸。",
        "嗔人问。",
        "背灯偷揾。",
        "拭尽残妆粉。"
      ],
      "author": {
        "id": 11678,
        "name": "苏轼"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313939,
      "title": "点绛唇",
      "content": [
        "闲倚胡床，庾公楼外峰千朵。",
        "与谁同坐。",
        "明月清风我。",
        "别乘一来，有唱应须和。",
        "还知么。",
        "自从添个。",
        "风月平分破。"
      ],
      "author": {
        "id": 11678,
        "name": "苏轼"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313940,
      "title": "点绛唇",
      "content": [
        "红杏飘香，柳含烟翠拖轻缕。",
        "水边朱户。",
        "尽卷黄昏雨。",
        "烛影摇风，一枕伤春绪。",
        "归不去。",
        "凤楼何处。",
        "芳草迷归路。"
      ],
      "author": {
        "id": 11678,
        "name": "苏轼"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314124,
      "title": "点绛唇",
      "content": [
        "独自临池，闷来强把阑干凭。",
        "旧愁新恨。",
        "耗却年时兴。",
        "鹭散鱼潜，烟敛风初定。",
        "波心静。",
        "照人如镜。",
        "少个年时影。"
      ],
      "author": {
        "id": 7173,
        "name": "舒氏"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314128,
      "title": "点绛唇",
      "content": [
        "紫雾香浓，岁华风转花随辇。",
        "洞天云暖。",
        "一片笙歌远。",
        "水殿龙舟，忆侍瑶池宴。",
        "闲庭院。",
        "梦回春半。",
        "雪鬓无人见。"
      ],
      "author": {
        "id": 6565,
        "name": "舒亶"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314610,
      "title": "点绛唇",
      "content": [
        "四到蕲州，今年更是逢重九。",
        "应时纳祐。",
        "随分开尊酒。",
        "屡舞婆娑，醉我平生友。",
        "休回首。",
        "世间何有。",
        "明月疏疏柳。"
      ],
      "author": {
        "id": 12402,
        "name": "张孝祥"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314611,
      "title": "点绛唇",
      "content": [
        "绮燕高张，玉潭月丽玻璃满。",
        "旆霞行卷。",
        "无复长安远。",
        "夏木阴阴，路袅薰风转。",
        "空留恋。",
        "细吹银管。",
        "别意随声缓。"
      ],
      "author": {
        "id": 12402,
        "name": "张孝祥"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314612,
      "title": "点绛唇",
      "content": [
        "萱草榴花，画堂永昼风清暑。",
        "麝团菰黍。",
        "助泛菖蒲醑。",
        "兵辟神符，命续同心缕。",
        "宜欢聚。",
        "绮筵歌舞。",
        "岁岁酬端午。"
      ],
      "author": {
        "id": 12402,
        "name": "张孝祥"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314743,
      "title": "点绛唇",
      "content": [
        "花落花开，等闲不管流年度。",
        "旧游何处。",
        "浅立空凝伫。",
        "惊拍栏干，忍见春将暮。",
        "凭风絮。",
        "为人飞去。",
        "散作愁无数。"
      ],
      "author": {
        "id": 1129,
        "name": "丘崈"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314820,
      "title": "点绛唇",
      "content": [
        "满路梅花，为谁开遍春风萼。",
        "短亭萧索。",
        "草草传杯酌。",
        "送子先归，我羡辽东鹤。",
        "他年约。",
        "瘦藤芒履。",
        "共子同丘壑。"
      ],
      "author": {
        "id": 11270,
        "name": "吕胜己"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314821,
      "title": "点绛唇",
      "content": [
        "日月无根，循环常共天难老。",
        "世间扰扰。",
        "只见闲烦恼。",
        "满酌高吟，便是今生了。",
        "还知道。",
        "旧时官好。",
        "几个新华表。"
      ],
      "author": {
        "id": 11270,
        "name": "吕胜己"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314822,
      "title": "点绛唇",
      "content": [
        "一叶扁舟，浮家来向江边住。",
        "这回归去。",
        "作个渔樵侣。",
        "不挂征帆，也莫遥双橹。",
        "天涯路。",
        "云山烟渚。",
        "总是留人处。"
      ],
      "author": {
        "id": 11270,
        "name": "吕胜己"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314823,
      "title": "点绛唇",
      "content": [
        "桂子飘香，江南秋老霜风作。",
        "自怜漂泊。",
        "几度伤离索。",
        "孤馆迢迢，满引村醪酌。",
        "情无著。",
        "好音难托。",
        "又失黄花约。"
      ],
      "author": {
        "id": 11270,
        "name": "吕胜己"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314824,
      "title": "点绛唇",
      "content": [
        "瑞气盈门，神仙谪下看看到。",
        "已知消耗。",
        "弧矢呈祥了。",
        "种德阴功，自有多男报。",
        "还知道。",
        "果生蓬岛。",
        "不比人间早。"
      ],
      "author": {
        "id": 11270,
        "name": "吕胜己"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314875,
      "title": "点绛唇",
      "content": [
        "密雨随风，咋来一夜檐声溜。",
        "奈何僝僽。",
        "官路梅花瘦。",
        "赋得多情，怕到春时候。",
        "如今一病非因酒。",
        "试问君知否。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314876,
      "title": "点绛唇",
      "content": [
        "春到垂杨，嫩黄染就金丝软。",
        "丽晴新暖。",
        "涌翠千山远。",
        "为甚年年，眉向东风展。",
        "闲消遣。",
        "欲归犹懒。",
        "渔笛天将晚。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314877,
      "title": "点绛唇",
      "content": [
        "轻暖轻寒，赏花天气春将半。",
        "柳摇金线。",
        "求友莺相唤。",
        "玉腕蛾眉，意眼频频眄。",
        "歌喉软。",
        "玉卮受劝。",
        "一醉应相拼。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314878,
      "title": "点绛唇",
      "content": [
        "夜雨如倾，满溪添涨桃花水。",
        "落红铺地。",
        "枝上堆浓翠。",
        "去年如今，常伴酴醿醉。",
        "今年里。",
        "离家千里。",
        "独猛东风泪。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314879,
      "title": "点绛唇",
      "content": [
        "啼鸟喃喃，恨春归去春谁管。",
        "日和风暖。",
        "绿暗闲庭院。",
        "还忆当年，绮席新相见。",
        "人已远。",
        "水流云散。",
        "空结多情怨。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314945,
      "title": "点绛唇",
      "content": [
        "开尽梅花，雪残庭户春来早。",
        "岁华偏好。",
        "只恐催人老。",
        "惟有诗情，犹被花枝恼。",
        "金樽倒。",
        "共成欢笑。",
        "终是清狂少。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315014,
      "title": "点绛唇",
      "content": [
        "蓼岸西风，小舟江上渔歌唱。",
        "倚栏凝想。",
        "幂幂云垂帐。",
        "好事因循，寂寞闲惆怅。",
        "如何向。",
        "又来心上。",
        "空向高亭望。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315046,
      "title": "点绛唇",
      "content": [
        "瓦湿鸳鸯，夜深霜重江风冷。",
        "月华明映。",
        "清浸梅梢粉。",
        "漏断寒浓，惹起当年恨。",
        "君休问。",
        "雁飞欲尽。",
        "没个南来信。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315047,
      "title": "点绛唇",
      "content": [
        "当日相逢，枕衾清夜纱窗冷。",
        "翠梅低映。",
        "汗湿香腮粉。",
        "美满风情，结下无穷恨。",
        "凭谁问。",
        "此心难尽。",
        "说与他争信。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315048,
      "title": "点绛唇",
      "content": [
        "云霁山横，翠涛拥起千重恨。",
        "砌成愁闷。",
        "那更梅花褪。",
        "凤管云笙，无不萦方寸。",
        "叮咛问。",
        "泪痕羞愠。",
        "界破香腮粉。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315061,
      "title": "点绛唇",
      "content": [
        "离绪千重，角声偏著羁人枕。",
        "那堪酒醒。",
        "句引愁难整。",
        "门锁黄昏，月浸梅花冷。",
        "人初静。",
        "斗垂天迥。",
        "雁落清江影。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315150,
      "title": "点绛唇",
      "content": [
        "云亸宫鬟，淡黄衫子轻香透。",
        "晚凉时候。",
        "睡起新妆就。",
        "冰枕生寒，玉浸纤纤手。",
        "沈吟久。",
        "眉山敛秀。",
        "爱道奴家瘦。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315206,
      "title": "点绛唇",
      "content": [
        "七里滩边，江光漠漠山如戟。",
        "渔舟一叶。",
        "径入寒烟碧。",
        "笑我尘劳，羞对双台石。",
        "身如织。",
        "年年行役。",
        "鱼鸟浑相识。"
      ],
      "author": {
        "id": 8155,
        "name": "方有开"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315691,
      "title": "点绛唇",
      "content": [
        "身后功名，古来不换生前醉。",
        "青鞋自喜。",
        "不踏长安市。",
        "竹外僧归，路指霜锺寺。",
        "孤鸿起。",
        "丹青手里。",
        "剪破松江水。"
      ],
      "author": {
        "id": 8618,
        "name": "辛弃疾"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315789,
      "title": "点绛唇",
      "content": [
        "隐隐轻雷，雨声不受春回护。",
        "落梅如许。",
        "吹尽墙边去。",
        "春水无情，碍断溪南路。",
        "凭谁诉。",
        "寄声传语。",
        "没个人知处。"
      ],
      "author": {
        "id": 8618,
        "name": "辛弃疾"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315963,
      "title": "点绛唇",
      "content": [
        "梅雨收黄，暑风依旧闲庭院。",
        "露荷轻颤。",
        "只有香浮面。",
        "挂起西窗，月澹无人见。",
        "幽情远。",
        "随钗低扇。",
        "好个凉方便。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316068,
      "title": "点绛唇",
      "content": [
        "纤手工夫，采丝五色交相映。",
        "同心端正。",
        "上有双鸳并。",
        "皓腕轻缠，结就相思病。",
        "凭谁信。",
        "玉肌宽尽。",
        "却系心儿紧。"
      ],
      "author": {
        "id": 2703,
        "name": "蔡戡"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316198,
      "title": "点绛唇",
      "content": [
        "霁景澄秋，晚风吹尽朝来雨。",
        "夕阳烟树。",
        "万里山光暮。",
        "一带长川，自在流今古。",
        "人何处。",
        "月波横素。",
        "冷浸蒹葭浦。"
      ],
      "author": {
        "id": 11721,
        "name": "石孝友"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316199,
      "title": "点绛唇",
      "content": [
        "缓解罗裳，十分鸳履低腰素。",
        "冰香微度。",
        "一罅殷红露。",
        "风折芳莲，影落盆池去。",
        "多羞处。",
        "怕人偷觑。",
        "粉面频回顾。"
      ],
      "author": {
        "id": 11721,
        "name": "石孝友"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316200,
      "title": "点绛唇",
      "content": [
        "著意栽银，砌成叶叶莲花舫。",
        "醉霞摇荡。",
        "恰似凌波样。",
        "自笑平生，鲸吸洪波量。",
        "孤心赏。",
        "不如深幌。",
        "一搦酬千想。"
      ],
      "author": {
        "id": 11721,
        "name": "石孝友"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316201,
      "title": "点绛唇",
      "content": [
        "杨柳腰枝，春来尚怯铢衣重。",
        "眼波偷送。",
        "笑把花枝弄。",
        "雨帐云屏，一枕高唐梦。",
        "春情动。",
        "𣨼人娇纵。",
        "困亸钗横凤。"
      ],
      "author": {
        "id": 11721,
        "name": "石孝友"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316202,
      "title": "点绛唇",
      "content": [
        "醉倚危墙，望中归思生天际。",
        "山腰渚尾。",
        "几簇渔樵市。",
        "帆落西风，一段芦花水。",
        "八千里。",
        "锦书欲寄。",
        "新雁曾来未。"
      ],
      "author": {
        "id": 11721,
        "name": "石孝友"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316203,
      "title": "点绛唇",
      "content": [
        "日薄风迟，柳眠无力花枝妥。",
        "燕楼空锁。",
        "好梦谁惊破。",
        "寒食清明，又等闲都过。",
        "愁无那。",
        "泪珠频堕。",
        "洒尽相思颗。"
      ],
      "author": {
        "id": 11721,
        "name": "石孝友"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316474,
      "title": "点绛唇",
      "content": [
        "日暖风喧，殿春琼蕊依台榭。",
        "雪堆花架。",
        "不用丹青写。",
        "莹彻精神，映月唯宜夜。",
        "幪香帕。",
        "倩风扶下。",
        "碎玉残妆卸。"
      ],
      "author": {
        "id": 9256,
        "name": "赵师侠"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316475,
      "title": "点绛唇",
      "content": [
        "漠漠春阴，褪花时候馀寒峭。",
        "数声啼鸟。",
        "唤起帘栊晓。",
        "云鬓慵梳，淡拂春山小。",
        "情多少。",
        "乱萦愁抱。",
        "风里垂杨袅。"
      ],
      "author": {
        "id": 9256,
        "name": "赵师侠"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316476,
      "title": "点绛唇",
      "content": [
        "袅袅娉娉，可人尤赛娘风韵。",
        "花娇玉润。",
        "一捻春期近。",
        "占路藏机，已向棋中进。",
        "俱休问。",
        "酒旗花阵。",
        "早晚争先胜。"
      ],
      "author": {
        "id": 9256,
        "name": "赵师侠"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316565,
      "title": "点绛唇",
      "content": [
        "一夜相思，水边清浅横枝瘦。",
        "小窗如昼。",
        "情共香俱透。",
        "清入梦魂，千里人长久。",
        "君知否。",
        "雨﹀人︽。",
        "格调还依旧。"
      ],
      "author": {
        "id": 13346,
        "name": "陈亮"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316566,
      "title": "点绛唇",
      "content": [
        "电绕璇枢，此时昌运生真主。",
        "庆聊簪组。",
        "喜气生绵宇。",
        "宴启需云，湛露恩均布。",
        "锵韶濩。",
        "凤歌鸾舞。",
        "玉斝飞香醑。"
      ],
      "author": {
        "id": 13346,
        "name": "陈亮"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316567,
      "title": "点绛唇",
      "content": [
        "碧落蟠桃，春风种在琼瑶苑。",
        "几回花绽。",
        "一子千年见。",
        "香染丹霞，摘向流虹旦。",
        "深深愿。",
        "万年天算。",
        "玉颗常来献。"
      ],
      "author": {
        "id": 13346,
        "name": "陈亮"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316568,
      "title": "点绛唇",
      "content": [
        "烟雨楼台，晓来独上无滋味。",
        "落花流水。",
        "掩映渔樵市。",
        "酒圣诗狂，只遣愁无计。",
        "频凝睇。",
        "问人天际。",
        "曾见归舟未。"
      ],
      "author": {
        "id": 13346,
        "name": "陈亮"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316637,
      "title": "点绛唇",
      "content": [
        "邂逅开尊，眼中有个人纤软。",
        "袖罗轻转。",
        "玉腕回春暖。",
        "韵处无多，只恼人肠断。",
        "词将半。",
        "近前相劝。",
        "扑扑清香满。"
      ],
      "author": {
        "id": 3541,
        "name": "杨炎正"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316638,
      "title": "点绛唇",
      "content": [
        "水载离怀，暮帆吹月寒欺酒。",
        "楚梅春透。",
        "忍放持杯手。",
        "莫唱阳关，免湿盈盈袖。",
        "君行后。",
        "那人消瘦。",
        "不恼诗肠否。"
      ],
      "author": {
        "id": 3541,
        "name": "杨炎正"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316650,
      "title": "点绛唇",
      "content": [
        "欲问东君，为谁重到江头路。",
        "断桥薄暮。",
        "香透溪云渡。",
        "细草平沙，愁入凌波步。",
        "今何许。",
        "怨春无语。",
        "片片随流水。"
      ],
      "author": {
        "id": 4047,
        "name": "俞灏"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316662,
      "title": "点绛唇",
      "content": [
        "二气工夫，河车搬入昆仑脑。",
        "世人谁晓。",
        "此是玄元道。",
        "存得阳精，年老身不老。",
        "三田饱。",
        "行动都了。",
        "拂袖游蓬岛。"
      ],
      "author": {
        "id": 11467,
        "name": "宋先生"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316663,
      "title": "点绛唇",
      "content": [
        "这个工夫，因师传授知元祖。",
        "论甚子午。",
        "说甚龙和虎。",
        "只在目前，明有神仙路。",
        "速修取。",
        "有朝归去。",
        "消了阴司簿。"
      ],
      "author": {
        "id": 11467,
        "name": "宋先生"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316826,
      "title": "点绛唇",
      "content": [
        "过眼溪山，向来都是经行处。",
        "骖鸾人去。",
        "冷落吹箫侣。",
        "小立江亭，愁对蒹葭浦。",
        "无情绪。",
        "酒杯慵举。",
        "闲看江枫舞。"
      ],
      "author": {
        "id": 1511,
        "name": "卢炳"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316853,
      "title": "点绛唇",
      "content": [
        "燕雁无心，太湖西畔随云去。",
        "数峰清苦。",
        "商略黄昏雨。",
        "第四桥边，拟共天随住。",
        "今何许。",
        "凭栏怀古。",
        "残柳参差舞。"
      ],
      "author": {
        "id": 3701,
        "name": "姜夔"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316854,
      "title": "点绛唇",
      "content": [
        "金谷人归，绿扬低扫吹笙道。",
        "数声啼鸟。",
        "也学相思调。",
        "月落潮生，掇送刘郎老。",
        "淮南好。",
        "甚时重到。",
        "陌上生春草。"
      ],
      "author": {
        "id": 3701,
        "name": "姜夔"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316929,
      "title": "点绛唇",
      "content": [
        "祝寿筵开，画堂深映花如绣。",
        "瑞烟喷兽。",
        "帘幕香风透。",
        "一点台星，化作人间秀。",
        "韶音奏。",
        "两行红袖。",
        "齐劝长生酒。"
      ],
      "author": {
        "id": 3701,
        "name": "姜夔"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316945,
      "title": "点绛唇",
      "content": [
        "数朵芙蕖，嫣然一笑凌清晓。",
        "谢家池沼。",
        "秋景偏宜少。",
        "气挟清霜，似把群花小。",
        "秋风袅。",
        "湘君来了。",
        "一曲烟波渺。"
      ],
      "author": {
        "id": 10066,
        "name": "汪莘"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316949,
      "title": "点绛唇",
      "content": [
        "晓角霜天，昼帘却是春天气。",
        "小园行处。",
        "双蝶相随至。",
        "恰向梅边，又向桃边觑。",
        "孜孜地。",
        "访兰寻蕙。",
        "谁会幽人意。"
      ],
      "author": {
        "id": 10066,
        "name": "汪莘"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 317163,
      "title": "点绛唇",
      "content": [
        "九十韶光，闲忙晴雨常相半。",
        "赏春有愿。",
        "乘兴宁论晚。",
        "纵饮筠溪，日午花阴转。",
        "杯行缓。",
        "量悭嫌浅。",
        "须索斟教满。"
      ],
      "author": {
        "id": 2985,
        "name": "郭应祥"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 317164,
      "title": "点绛唇",
      "content": [
        "小队郊坰，耄倪争看铜章史。",
        "来宣德意。",
        "劝相遵彝制。",
        "夜雨连明，百谷应滋遂。",
        "真奇事。",
        "开禧元二。",
        "总是丰登岁。"
      ],
      "author": {
        "id": 2985,
        "name": "郭应祥"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 317165,
      "title": "点绛唇",
      "content": [
        "五马归来，后车载得如花女。",
        "缓歌金缕。",
        "新样京华舞。",
        "主悦宾欢，一醉祛袢暑。",
        "停箫鼓。",
        "且须听取。",
        "三朵花能语。"
      ],
      "author": {
        "id": 2985,
        "name": "郭应祥"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 317166,
      "title": "点绛唇",
      "content": [
        "甲第初成，持杯酌酒来相庆。",
        "棣华辉映。",
        "相对开三径。",
        "小巧规模，百事都相称。",
        "年方盛。",
        "从容啸咏。",
        "不碍青云兴。"
      ],
      "author": {
        "id": 2985,
        "name": "郭应祥"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 317302,
      "title": "点绛唇",
      "content": [
        "山凹春生，探梅只道今年早。",
        "暗香迎晓。",
        "人与花能好。",
        "岁岁持杯，天地同难老。",
        "须吟啸。",
        "放开怀抱。",
        "更约寻瑶草。"
      ],
      "author": {
        "id": 11972,
        "name": "韩淲"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 317460,
      "title": "点绛唇",
      "content": [
        "又是年时，冷烟寒食梨花院。",
        "柳金拖线。",
        "一曲珠歌转。",
        "翠碧雕梁，风软帘通燕。",
        "何须劝。",
        "酒豪诗健。",
        "逸韵今重见。"
      ],
      "author": {
        "id": 11351,
        "name": "赵希"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 317637,
      "title": "点绛唇",
      "content": [
        "花落苔香，断无人肯行鹓甃。",
        "晚风翻绣。",
        "吹醒东窗酒。",
        "犹卧氍毹，明月知人瘦。",
        "香消后。",
        "乱愁依旧。",
        "开□胡酥手。"
      ],
      "author": {
        "id": 8948,
        "name": "史达祖"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 317638,
      "title": "点绛唇",
      "content": [
        "山月随人，翠苹分破秋山影。",
        "钓船归尽。",
        "桥外诗心迥。",
        "多少荷花，不盖鸳鸯冷。",
        "西风定。",
        "可怜潘鬓。",
        "偏浸秦台镜。"
      ],
      "author": {
        "id": 8948,
        "name": "史达祖"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 318176,
      "title": "点绛唇",
      "content": [
        "花事无多，笙歌绾取东风住。",
        "玉彝雕俎，楼外更筹屡。",
        "醉唤骊驹，催上天梯去。",
        "君知否。",
        "半边铜虎。",
        "邓艾经行路。"
      ],
      "author": {
        "id": 8088,
        "name": "洪咨夔"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 318314,
      "title": "点绛唇",
      "content": [
        "池馆春深，海棠枝上斑斑雨。",
        "酒旗斜举。",
        "风滚杨花絮。",
        "游子征衫，凭暖阑干处。",
        "空凝伫。",
        "杜鹃啼苦。",
        "还报南楼鼓。"
      ],
      "author": {
        "id": 11841,
        "name": "方千里"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 318328,
      "title": "点绛唇",
      "content": [
        "一朵千金，帝城谷雨初晴后。",
        "粉拖香透。",
        "雅称群芳首。",
        "把酒题诗，遐想欢如旧。",
        "花知否。",
        "故人清瘦。",
        "长忆同携手。"
      ],
      "author": {
        "id": 2769,
        "name": "李铨"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 318518,
      "title": "南浦月・点绛唇",
      "content": [
        "来翦莼丝，江头一阵鸣蓑雨。",
        "孤篷归路。",
        "吹得苹花暮。",
        "短发萧萧，笑与沙鸥语。",
        "休归去。",
        "玉龙嘶处。",
        "邀月过南浦。"
      ],
      "author": {
        "id": 1985,
        "name": "张辑"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 318519,
      "title": "沙头雨・点绛唇",
      "content": [
        "带醉归时，月华犹在吹箫处。",
        "晚愁情绪。",
        "忘却匆匆语。",
        "客里风霜，诗鬓空如许。",
        "江南去。",
        "岸花迎橹。",
        "遥隔沙头雨。"
      ],
      "author": {
        "id": 1985,
        "name": "张辑"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 318554,
      "title": "点绛唇",
      "content": [
        "竹翠藏烟，杏红流水归何处。",
        "透帘穿户。",
        "更洒黄昏雨。",
        "织锦题书，谁寄愁情去。",
        "浑无绪。",
        "绿杨千缕。",
        "不似真眉妩。"
      ],
      "author": {
        "id": 5312,
        "name": "苏茂一"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 319215,
      "title": "点绛唇",
      "content": [
        "山雨初晴，馀寒犹在东风软。",
        "满庭苔藓。",
        "青子无人见。",
        "好客不来，门外芳菲遍。",
        "难消遣。",
        "流莺声啭。",
        "坐看芭蕉展。"
      ],
      "author": {
        "id": 10413,
        "name": "宋自道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 319351,
      "title": "点绛唇",
      "content": [
        "秋满孤篷，翠蒲红蓼留人住。",
        "一帘香缕。",
        "边影惊鸿度。",
        "小据胡床，旧事新情绪。",
        "凭谁诉。",
        "蜡灯犀尘。",
        "拟共西风语。"
      ],
      "author": {
        "id": 728,
        "name": "冯去非"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 319431,
      "title": "点绛唇",
      "content": [
        "禁鼓三敲，参旗初挂阑干角。",
        "浅屏疏箔。",
        "夜气侵已薄。",
        "欸乃吴歌，艇子当溪泊。",
        "休休莫。",
        "五湖烟浪，不是鸱夷错。"
      ],
      "author": {
        "id": 8921,
        "name": "吴潜"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 319574,
      "title": "点绛唇",
      "content": [
        "岸舣扁舟，江南有个人归老。",
        "簇新亭沼。",
        "分付还他了。",
        "凝伫晴空，一抹天边鸟。",
        "嗟潦倒。",
        "去多来少。",
        "莫问钟昏晓。"
      ],
      "author": {
        "id": 8921,
        "name": "吴潜"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 319629,
      "title": "点绛唇",
      "content": [
        "午梦初回，卷帘尽放春愁去。",
        "昼长无侣。",
        "自对黄鹂语。",
        "絮影苹香，春在无人处。",
        "移舟去。",
        "未成新句。",
        "一砚梨花雨。"
      ],
      "author": {
        "id": 6,
        "name": "周晋"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 319780,
      "title": "点绛唇",
      "content": [
        "懒上巍楼，楚江一望天无际。",
        "漫游萍寄。",
        "莫挽东流水。",
        "一片秋光，直到山阴里。",
        "人还记。",
        "戍边归未。",
        "更忆鲈鱼美。"
      ],
      "author": {
        "id": 6149,
        "name": "李曾伯"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 320260,
      "title": "点绛唇",
      "content": [
        "春未来时，酒携不到千岩路。",
        "瘦还如许。",
        "晚色天寒处。",
        "无限新愁，难对风前语。",
        "行人去。",
        "暗消春素。",
        "横笛空山暮。"
      ],
      "author": {
        "id": 1043,
        "name": "吴文英"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 320270,
      "title": "点绛唇",
      "content": [
        "金井空阴，枕痕历尽秋声闹。",
        "梦长难晓。",
        "月树愁鸦悄。",
        "梅压檐梢，寒蝶寻香到。",
        "窗黏了。",
        "翠池春小。",
        "波冷鸳鸯觉。"
      ],
      "author": {
        "id": 1043,
        "name": "吴文英"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 320271,
      "title": "点绛唇",
      "content": [
        "明月茫茫，夜来应照南桥路。",
        "梦游熟处。",
        "一枕啼秋雨。",
        "可惜人生，不向吴城住。",
        "心期误。",
        "雁将秋去。",
        "天远青山暮。"
      ],
      "author": {
        "id": 1043,
        "name": "吴文英"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 320294,
      "title": "点绛唇",
      "content": [
        "香泛罗屏，夜寒著酒宜偎倚。",
        "翠偏红坠。",
        "唤起芙蓉睡。",
        "一曲伊州，秋色芭蕉里。",
        "娇和醉。",
        "眼情心事。",
        "愁隔湘江水。"
      ],
