{
  "data": [
    {
      "id": 156440,
      "title": "湖口",
      "content": [
        "江湖一都会，宇宙几兴亡。",
        "走马芦林外，买鱼茅舍傍。",
        "南人撑快桨，北客坐危樯。",
        "江水交岷水，东流日夜长。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156441,
      "title": "安庆府",
      "content": [
        "风雨宜城路，重来白发新。",
        "长江还有险，中国自无人。",
        "枭獍蕃遗育，鳣鲸蛰怒鳞。",
        "泊船休上岸，不忍见遗民。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156442,
      "title": "池州",
      "content": [
        "五老湖光远，九华山色昏。",
        "南冠前进士，北部故将军。",
        "芳草江头路，斜阳郭外村。",
        "匆匆十年梦，故国黯销魂。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156443,
      "title": "鲁港",
      "content": [
        "方夸金坞筑，岂料玉床摇。",
        "国体真三代，江流旧六朝。",
        "鞭投能几日，瓦解不崇朝。",
        "千古燕山恨，西风卷怒潮。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156444,
      "title": "采石",
      "content": [
        "不上峨眉二十岁，重来为堕山河泪。",
        "今人不见虞允文，古人曾有樊若水。",
        "长江阔处平如驿，况此介然衣带窄。",
        "欲从谪仙捉月去，安得然犀照神物。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 156445,
      "title": "建康",
      "content": [
        "金陵古会府，南渡旧陪京。",
        "山势犹盘礴，江流已变更。",
        "健儿徙幽土，新鬼哭台城。",
        "一片清溪月，偏于客有情。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156446,
      "title": "金陵驿  其一",
      "content": [
        "草合离宫转夕晖，孤云飘泊复何依。",
        "山河风景元无异，城郭人民半已非。",
        "满地芦花和我老，旧家燕子傍谁飞。",
        "从今别却江南日，化作啼鹃带血归。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 156447,
      "title": "金陵驿  其二",
      "content": [
        "万里金瓯失壮图，衮衣颠倒落泥涂。",
        "空流杜宇声中血，半脱骊龙颔下须。",
        "老去秋风吹我恶，梦回寒月照人孤。",
        "千年成败俱尘土，消得人间说丈夫。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 156448,
      "title": "怀忠襄",
      "content": [
        "平生王佐心，世运蹈衰末。",
        "齐虏谁复封，楚囚讵当脱。",
        "金陵虽怀古，尚友在风烈。",
        "褒忠侈遗庙，夫子我先达。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156449,
      "title": "早秋",
      "content": [
        "只影飘零天一涯，千秋摇落欲何之。",
        "朝看带缓方嫌瘦，夜怯衾单始觉衰。",
        "眼里游从惊死别，梦中儿女慰生离。",
        "六朝无限江山在，搔首斜阳独立时。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 156450,
      "title": "睡起",
      "content": [
        "空堂孤影起闻鸡，风起高楼鼓角悲。",
        "江海无情游子倦，岁年如梦美人迟。",
        "平生管鲍成何事，千古夷齐在一时。",
        "坐久日斜庭木落，浮云灭没漏朝曦。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 156451,
      "title": "中秋",
      "content": [
        "不教收骨瘴江边，驱向胡沙著去鞭。",
        "旧夺宫袍空独步，新食官饭饱孤眠。",
        "客程恰与秋天半，人影何如月倍圆。",
        "犹是江南佳丽地，徘徊把酒看苍天。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 156452,
      "title": "和中斋韵  其一",
      "content": [
        "功业飘零五丈原，如今局促傍谁辕。",
        "俛首北去明妃泪，啼血南飞望帝魂。",
        "骨肉凋残唯我在，形容变尽只声存。",
        "洪流千古英雄恨，兰作行舟柳作樊。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 156453,
      "title": "和中斋韵  其二",
      "content": [
        "见说黄沙接五原，飘零只影向南辕。",
        "江山有恨销人骨，风雨无情断客魂。",
        "泪似空花千点落，鬓如硕果数根存。",
        "肉飞不起真堪叹，江水为笼海作樊。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 156454,
      "title": "和友人",
      "content": [
        "落落南冠过故都，近来我意亦忘吾。",
        "骑来驿马身如寄，遣去家书字亦无。",
        "景伯未囚先立后，嵇康纵死不为孤。",
        "江南只有归来梦，休问田园芜不芜。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 156455,
      "title": "怀中甫",
      "content": [
        "久要何落落，末路重依依。",
        "风雨连兵幕，泥涂满客衣。",
        "人间龙虎变，天外燕鸿违。",
        "死矣烦公传，北方人是非。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156456,
      "title": "行宫  其一",
      "content": [
        "十里宫墙一聚尘，天津晚过客愁新。",
        "花啼杜宇归来血，树挂苍龙脱去鳞。",
        "福德傥存终有晋，秣陵未改已无秦。",
        "秋风禾黍空南北，见说铜驼会笑人。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 156457,
      "title": "行宫  其二",
      "content": [
        "怪底秦淮一水长，几多客泪洒斜阳。",
        "江流本是限南北，地气何曾减帝王。",
        "台沼渐荒基历落，鶑花犹在意凄凉。",
        "青天毕竟有情否，旧月东来失女墙。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 156458,
      "title": "送行中斋三首  其一",
      "content": [
        "秋风晚正烈，客衣早知寒。",
        "把衣不能别，更尽此日欢。",
        "出门一万里，风沙浩漫漫。",
        "岂无儿女情，为君思汍澜。",
        "百年有时尽，千载无余观。",
        "明明君臣义，公独为其难。",
        "愿持丹一寸，写入青琅玕。",
        "会有抚卷人，孤灯起长叹。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 156459,
      "title": "送行中斋三首  其二",
      "content": [
        "神龙荡失水，驯扰终未得。",
        "威凤虽在薮，肯顾鸡鹜食。",
        "所以古之人，受变心不易。",
        "亳鼎已迁周，西山竟肌瘠。",
        "豫子身自漆，长弘血成碧。",
        "何尝怨废兴，而或二心迹。",
        "坚白不在缁，羔裘良自惜。",
        "此谊公素明，俗见或未识。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 156460,
      "title": "送行中斋三首  其三",
      "content": [
        "嗟予抱区区，畴昔同里闬。",
        "过从三十年，知心不知面。",
        "零落忽重逢，家亡市朝变。",
        "惸惸蹈海余，踽踽南冠殿。",
        "剧谈泥涂际，握手鞍马倦。",
        "依依斯文意，苦恨十年晚。",
        "鲁仲偶不逢，随世本非愿。",
        "灵胥目未抉，端欲诣所见。",
        "及兹万里别，一夕肠百转。",
        "余生谅须臾，孤感横九县。",
        "庶几太尉事，万一中丞传。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 156461,
      "title": "发建康",
      "content": [
        "赏心亭下路，拍手唱吾歌。",
        "楼外梁时塔，城中秦氏河。",
        "江山如梦耳，天地柰愁何。",
        "回首清溪曲，长江一雁过。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156462,
      "title": "江行有感",
      "content": [
        "蒲萄肥汗马，荆棘冷铜驼。",
        "巫峡朝云湿，洞庭秋水波。",
        "穷愁空突兀，暗泪自滂沱。",
        "莫恨吾生悮，江东才俊多。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156463,
      "title": "真州驿",
      "content": [
        "山川如识我，故旧更无人。",
        "俯仰干戈迹，往来车马尘。",
        "英雄遗算晚，天地暗愁新。",
        "北首燕山路，凄凉夜向晨。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156464,
      "title": "望扬州",
      "content": [
        "阮籍临广武，杜甫登吹台。",
        "高情发慷慨，前人后人哀。",
        "江左遘阳运，铜驼化飞灰。",
        "二十四桥月，楚囚今日来。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156465,
      "title": "维扬驿",
      "content": [
        "三年别淮水，一夕宿扬州。",
        "南极山川古，北风江海秋。",
        "昭君愁出塞，王粲怕登楼。",
        "千载英雄泪，如今况楚囚。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156466,
      "title": "过邵伯镇",
      "content": [
        "今朝车马地，昔日战争场。",
        "我有扬州鹤，谁存邵伯棠。",
        "一湾流水小，数亩故城荒。",
        "回首江南路，青山断夕阳。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156467,
      "title": "高邮怀旧",
      "content": [
        "借问曾游处，高沙第几山。",
        "潜行鹰攫道，直上虎当关。",
        "一命虚空里，三年瞬息间。",
        "自怜今死晚，何复望生还。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156468,
      "title": "发高邮",
      "content": [
        "初出高沙门，轻舫遶城楼。",
        "一水何曲折，百年此绸缪。",
        "北望渺无际，飞鸟翔平畴。",
        "寒芜入荒落，日薄行人愁。",
        "行行行湖曲，万顷涵清秋。",
        "大风吹樯倒，如荡彭蠡舟。",
        "欲寄故乡泪，使入长江流。",
        "篙人为我言，此水通淮头。",
        "前与黄河合，同作沧海沤。",
        "踟蹰忽失意，拭泪泪不收。",
        "吴会日已远，回首重悠悠。",
        "驰驱梁赵郊，壮士何离忧。",
        "吾道久矣东，陆沈古神州。",
        "我今戴南冠，何异有北投。",
        "不能裂肝脑，直气摩斗牛。",
        "但愿光岳合，休明复商周。",
        "不使殊方魄，终为异物羞。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 156469,
      "title": "宝应道中",
      "content": [
        "天阔抟南雁，淮途长北驱。",
        "甘棠成传舍，细柳作康衢。",
        "田海随时变，山河往日殊。",
        "征袍共衮绣，夜壁一灯孤。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156470,
      "title": "淮安军",
      "content": [
        "楚州城门外，白杨吹悲风。",
        "累累死人冢，死向锋镝中。",
        "岂无匹妇冤，定无万夫雄。",
        "中原在其北，登城望何穷。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156471,
      "title": "过淮河宿阚石有感",
      "content": [
        "北征垂半年，依依只南土。",
        "今晨渡淮河，始觉非故宇。",
        "江乡已无家，三年一羁旅。",
        "龙翔在何方，乃我妻子所。",
        "昔也无柰何，忽已置念虑。",
        "今行日已近，使我泪如雨。",
        "我为纲常谋，有身不得顾。",
        "妻兮莫望夫，子兮莫望父。",
        "天长与地久，此恨极千古。",
        "来生业缘在，骨肉当如故。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 156472,
      "title": "发淮安",
      "content": [
        "九月初二日，车马发淮安。",
        "行行重行行，天地何不宽。",
        "烟火无一家，荒草青漫漫。",
        "恍如泛沧海，身坐玻瓈盘。",
        "时时逢北人，什伍扶征鞍。",
        "云我戍江南，当军身属官。",
        "北人适吴楚，所忧地少寒。",
        "江南有游子，风雪上燕山。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 156473,
      "title": "小清口初三日",
      "content": [
        "乍见惊胡妇，相嗟遇楚兵。",
        "北来鸿雁密，南去骆驼轻。",
        "芳草中原路，斜阳故国情。",
        "明朝五十里，错做武陵行。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156474,
      "title": "桃源道中",
      "content": [
        "漠漠地千里，垂垂天四围。",
        "隔溪胡骑过，傍草野鸡飞。",
        "风露吹青笠，尘沙薄素衣。",
        "吾家白云下，都伴北人归。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156475,
      "title": "桃源县",
      "content": [
        "清野百年久，中原千里赊。",
        "火烟新聚落，山水旧生涯。",
        "种麦十数亩，诛茅千百家。",
        "我来行正倦，何处觅桃花。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156476,
      "title": "崔镇驿",
      "content": [
        "万里中原役，北风天正凉。",
        "黄沙漫道路，苍耳满衣裳。",
        "野阔人声小，日斜驹影长。",
        "解鞍身似梦，游子意茫茫。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156477,
      "title": "发崔镇",
      "content": [
        "高雁空秋兴，寒螀破晓眠。",
        "淡烟白似海，野水碧于天。",
        "兴废嗟何及，行藏信自然。",
        "南人乍骑马，北客半乘船。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156478,
      "title": "发宿迁县",
      "content": [
        "夜梦入星槎，晓行随斗柄。",
        "衣暖露自干，鬓寒冰欲凝。",
        "将军戴铁笠，壮士敲金镫。",
        "白眼睨青天，我生不有命。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156479,
      "title": "中原",
      "content": [
        "中原方万里，明日是重阳。",
        "桑枣人家近，蓬蒿客路长。",
        "引弓虚射雁，失马为寻羊。",
        "见说今年旱，青青麦又秧。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156480,
      "title": "望邳州",
      "content": [
        "中原行几日，今日才见山。",
        "问山在何处，云在徐邳间。",
        "邳州山，徐州水，项籍不还韩信死。",
        "龙争虎鬭不肯止，烟草漫漫青万里。",
        "古来刘季号英雄，樊崇至今已千岁。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 156481,
      "title": "徐州道中",
      "content": [
        "彭城古官道，日中十马驰。",
        "咫尺不见人，扑面黄尘飞。",
        "白头汉王缟素师，美人燕罢项羽啼。",
        "一时混战四十万，天昏地黑睢水湄。",
        "乃知大风扬沙失白昼，自是地利非天时。",
        "汉王仓皇问道西，一儿一女嘻其危。",
        "太公吕后去不归，俎上宁有生还时。",
        "未央称寿太上皇，巍然女娲帝中闱。",
        "终然富贵自有命，造物颠倒真小儿。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 156482,
      "title": "彭城行",
      "content": [
        "连山四围合，吕梁贯其中。",
        "河南大都会，故有项王宫。",
        "晋牧连杨豫，虎视北方雄。",
        "唐时燕子楼，风流张建封。",
        "西望睢阳城，只与汴水通。",
        "太平黄楼赋，尚能想遗风。",
        "迩来百余年，正朔归江东。",
        "遗民死欲尽，莽然狐兔丛。",
        "我从南方来，停骖抚遗踪。",
        "故河蓄潢潦，荒城翳秋蓬。",
        "凄凉戏马台，憔悴巨佛峰。",
        "沧海变桑田，陵谷代不同。",
        "朝为朱门贵，暮作行旅穷。",
        "乘除信物理，感慨系所逢。",
        "古来贤达人，一醉万虑空。",
        "如此独醒何，悲风逐征鸿。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 156483,
      "title": "燕子楼",
      "content": [
        "自别张公子，婵娟不下楼。",
        "遂令楼上燕，百岁称风流。",
        "我游彭城门，来吊楚王阙。",
        "问楼在何处，城东草如雪。",
        "蛾眉代不乏，埋没安足论。",
        "因何张家妾，名与山川存。",
        "自古皆有死，忠义长不没。",
        "但传美人心，不说美人色。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 156484,
      "title": "戏马台",
      "content": [
        "九月初九日，客游戏马台。",
        "黄花弄朝露，古人花飞埃。",
        "今人哀后人，后人复今哀。",
        "世事那可及，泪落茱萸杯。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156485,
      "title": "发彭城",
      "content": [
        "今朝正重九，行人意迟迟。",
        "回首戏马台，野花发葳蕤。",
        "草埋范增冢，云见樊哙旗。",
        "时节正如此，道路将何之。",
        "我爱陶渊明，甲子题新诗。",
        "白衣送酒来，把菊卧东篱。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 156486,
      "title": "沛歌",
      "content": [
        "秦世失其鹿，丰沛发龙颜。",
        "王侯与将相，不出徐济间。",
        "当时数公起，四海王气闲。",
        "至今尚想见，虹光照人寰。",
        "我来千载下，吊古泪如潸。",
        "白云落荒草，隠隠芒砀山。",
        "黄河天下雄，南去不复还。",
        "乃知盈虚故，天道如循环。",
        "卢王旧封地，今日殽函关。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 156487,
      "title": "歌风台",
      "content": [
        "长陵有神气，万岁光如虹。",
        "有时风雪变，魂魄来沛宫。",
        "壮哉游子乡，一览万宇空。",
        "击筑戒复隍，帝业慎所终。",
        "重瞳爱梁父，此情岂不同。",
        "锦衣绚行昼，丈夫何浅中。",
        "缅怀首丘意，自足分雌雄。",
        "尚惜霸心存，慷慨怀勇功。",
        "不见往来事，烹狗与藏弓。",
        "早知致两生，礼乐三代隆。",
        "匹夫事已往，安用责乃翁。",
        "我来汤沐邑，白杨吹悲风。",
        "永言三侯章，隠隠闻儿童。",
        "叶落皆归根，飘零独秋蓬。",
        "登台共凄恻，目送南飞鸿。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 156488,
      "title": "固陵道中三首  其一",
      "content": [
        "九天云下垂，一雨作秋色。",
        "尘埃化泥涂，原野转萧瑟。",
        "十里一双堠，狐兔卧荆棘。",
        "见说数年来，中州乍苏息。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156489,
      "title": "固陵道中三首  其二",
      "content": [
        "茅舍荒凉旧固陵，汉王城对楚王城。",
        "徐州烟火连丰沛，天下还来屋角争。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 156490,
      "title": "固陵道中三首  其三",
      "content": [
        "固陵城下两龙争，不见齐王来会兵。",
        "勒取河山新分地，项王之后到韩彭。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 156491,
      "title": "发鱼台",
      "content": [
        "晨炊发鱼台，碎雨飞击面。",
        "团团四野周，冥冥万象变。",
        "疑是江南山，烟雾昏不见。",
        "岂知此中原，今古经百战。",
        "英雄化为土，飞雾洒郊甸。",
        "天寒日欲短，游子泪如霰。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 156492,
      "title": "自叹",
      "content": [
        "瑟瑟秋风悲，烈烈寒气骄。",
        "蒲柳先已零，松柏何后凋。",
        "天意重肃杀，造物无不销。",
        "强弱有异禀，忧患同一朝。",
        "惟有南山石，千载一岧峣。",
        "人苦不自足，空羡王子乔。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 156493,
      "title": "远游",
      "content": [
        "黄河流活活，太行高巍巍。",
        "王屋山以东，百泉山以西。",
        "邹鲁盛文献，燕赵多雄姿。",
        "右摩泰山碑，左蹑函谷泥。",
        "郏鄏吊周公，曲阜拜宣尼。",
        "或登广武叹，或上北邙悲。",
        "平生几两屐，汗漫以为期。",
        "绝交天下士，要为男子奇。",
        "吴会偏王业，中原隔遗黎。",
        "安得与黄鹤，比翼天上飞。",
        "江河异风景，击楫感且欷。",
        "阳运遘百六，兴否俄推移。",
        "桑田变沧海，楚囚发孔悲。",
        "我本槛车客，为我解絷维。",
        "青蝇附天骥，万里相追随。",
        "人生尚行乐，矧复新相知。",
        "周道思下泉，王风怀黍离。",
        "富贵岂不愿，忧患那自持。",
        "人命危且浅，忽若朝露晞。",
        "长恐折我轴，中道欲差池。",
        "去我父母邦，我行且迟迟。",
        "听我远游曲，寄我长相思。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 156494,
      "title": "六歌  其一",
      "content": [
        "有妻有妻出糟糠，自少结发不下堂。",
        "乱离中道逢虎狼，凤飞翩翩失其凰。",
        "将雏一二去何方，岂料国破家亦亡，不忍舍君罗襦裳。",
        "天长地久终茫茫，牛女夜夜遥相望。",
        "呜呼一歌兮歌正长，悲风北来起徬徨。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 156495,
      "title": "六歌  其二",
      "content": [
        "有妹有妹家流离，良人去后携诸儿。",
        "北风吹沙塞草凄，穷猿惨淡将安归。",
        "去年哭母南海湄，三男一女同歔欷，惟汝不在割我肌。",
        "汝家零落母不知，母知岂有瞑目时。",
        "呜呼再歌兮歌孔悲，鹡鸰在原我何为。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 156496,
      "title": "六歌  其三",
      "content": [
        "有女有女婉清扬，大者学帖临钟王，小者读字声琅琅。",
        "朔风吹衣白日黄，一双白璧委道傍。",
        "雁儿啄啄秋无粱，随母北首谁人将。",
        "呜呼三歌兮歌愈伤，非为儿女泪淋浪。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 156497,
      "title": "六歌  其四",
      "content": [
        "有子有子风骨殊，释氏抱送徐卿雏。",
        "四月八日摩尼珠，榴花犀钱络绣襦。",
        "兰汤百沸香似酥，欻随飞电飘泥涂。",
        "汝兄十三骑鲸鱼，汝今知在三岁无。",
        "呜呼四歌兮歌以吁，灯前老我明月孤。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 156498,
      "title": "六歌  其五",
      "content": [
        "有妾有妾今何如，大者手将玉蟾蜍，次者亲抱汗血驹。",
        "晨粧靓服临西湖，英英雁落飘璚琚。",
        "风花飞坠鸟鸣呼，金茎沆瀣浮污渠。",
        "天摧地裂龙凤殂，美人尘土何代无。",
        "呜呼五歌兮歌鬰纡，为尔溯风立斯须。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 156499,
      "title": "六歌  其六",
      "content": [
        "我生我生何不辰，孤根不识桃李春。",
        "天寒日短重愁人，北风随我铁马尘。",
        "初怜骨肉钟奇祸，而今骨肉相怜我。",
        "汝在北兮婴我怀，我死谁当收我骸。",
        "人生百年何丑好，黄粱得丧俱草草。",
        "呜呼六歌兮勿复道，出门一笑天地老。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 156500,
      "title": "发潭口",
      "content": [
        "吹面北风来，拂鬓坚冰至。",
        "轩冕委道途，衮绣易毡毳。",
        "百年杂丑好，始酬四方志。",
        "浩歌激浮云，亭亭复揽辔。",
        "羲驭几曾停，谁当扫幽翳。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 156501,
      "title": "新济州",
      "content": [
        "借问新济州，徐郓兄弟国。",
        "昔为大河南，今为大河北。",
        "垂云阴万里，平原望不极。",
        "百草尽枯死，黄花自秋色。",
        "时时见桑树，青青杂阡陌。",
        "路上无人行，烟火渺萧瑟。",
        "车辙分纵横，过者临岐泣。",
        "积潦流交衢，霜蹄破丛棘。",
        "江南寒未深，铜炉兽花赤。",
        "为知行路人，铁冷衣裳湿。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 156502,
      "title": "汶阳道中",
      "content": [
        "积雨不肯霁，行陆如涉川。",
        "青毡纩我后，白毡覆我前。",
        "我欲正衣冠，两手如纠缠。",
        "飞沫流被面，代我泣涕涟。",
        "鸿雁纷南翔，游子北入燕。",
        "平楚渺四极，雪风迷远天。",
        "昔闻济上军，又说汶阳田。",
        "我今履其地，吊古怆苍烟。",
        "男儿欲了事，长虹射寒泉。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 156503,
      "title": "汶阳馆",
      "content": [
        "去岁营船隩，今朝馆汶阳。",
        "海空沙漠漠，河广草茫茫。",
        "家国哀千古，男儿慨四方。",
        "老槐秋雨暗，孤影照淋浪。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156504,
      "title": "自汶阳至郓",
      "content": [
        "渺渺中原道，劳生叹百非。",
        "风雨吹打人，泥泞飞上衣。",
        "目力去天短，心事与时违。",
        "夫子昔相鲁，侵疆自齐归。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156505,
      "title": "来平馆",
      "content": [
        "憔悴江南客，萧条古郓州。",
        "雨声连五日，月色彻中流。",
        "万里山河梦，千年宇宙愁。",
        "欲鞭刘豫骨，烟草暗荒丘。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156506,
      "title": "发郓州喜晴",
      "content": [
        "烈风西北来，万窍号高秋。",
        "宿云蔽层空，浮潦迷中州。",
        "行人苦沮洳，道阻路且修。",
        "流澌被鞍𩍐，飞沫缀衣裘。",
        "昏鸦接翅落，原野惨以愁。",
        "城郭何萧条，闭户寒飕飕。",
        "中宵月色满，余光散衾禂。",
        "余子戒明发，飞雾霭郊丘。",
        "微见扶桑红，隠隠如沉浮。",
        "身游大荒野，海气吹蜃楼。",
        "须臾划当空，六合开沉幽。",
        "千年厌颜色，苍翠光欲流。",
        "太阳经天行，大化不暂留。",
        "辉光何曾灭，晻霭终当收。",
        "严霜下丰草，长歌夜悠悠。",
        "明日东阿道，方轨骤骅骝。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 156507,
      "title": "发东阿",
      "content": [
        "东原深处所，时或见人烟。",
        "秋雨桑麻地，春风桃李天。",
        "贪程频问堠，快马缓加鞭。",
        "多少飞樯过，噫吁是北船。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156508,
      "title": "宿高唐州",
      "content": [
        "早发东阿县，暮宿高唐州。",
        "哲人达几微，志士怀隠忧。",
        "山河已历历，天地空悠悠。",
        "孤馆一夜宿，北风吹白头。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156509,
      "title": "平原",
      "content": [
        "平原太守颜真卿，长安天子不知名。",
        "一朝渔阳动鼙鼓，大河以北无坚城。",
        "公家兄弟奋戈起，一十七郡连夏盟。",
        "贼闻失色分兵还，不敢长驱入咸京。",
        "明皇父子将西狩，由是灵武起义兵。",
        "唐家再造李郭力，若论牵制公威灵。",
        "哀哉常山惨钩舌，心归朝廷气不慑。",
        "崎岖坎坷不得志，出入四朝老忠节。",
        "当年幸脱安禄山，白首竟陷李希烈。",
        "希烈安能遽杀公，宰相卢杞欺日月。",
        "乱臣贼子归何处，茫茫烟草中原土。",
        "公死于今六百年，忠精赫赫雷行天。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 156510,
      "title": "发陵州",
      "content": [
        "中原似沧海，万顷与云连。",
        "大明朝东出，皎月正在天。",
        "远树乱如点，桑麻鬰苍烟。",
        "一雁入高空，千鸦落平田。",
        "我行天地中，如蚁磨上旋。",
        "雨痕留故衣，霜气袭重毡。",
        "健马嘶北风，潜鱼乐深渊。",
        "噫哉南方人，回首空自怜。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 156511,
      "title": "献州道中",
      "content": [
        "三年戎服行，五岭文玉会。",
        "跻攀上崖磴，厉揭涉潇濑。",
        "十步九崎岖，山水何破碎。",
        "坐令管仲小，自觉伯夷隘。",
        "乃今来中州，万里如一概。",
        "四望登原隰，桑麻蔚旆旆。",
        "骅骝出清庙，过都真历块。",
        "历历古战场，俯仰生感慨。",
        "吾常涉重湖，东海际南海。",
        "兹游冠平生，天宇更宏大。",
        "心与太虚际，目空九围内。",
        "男儿不出居，妇人坐帷盖。",
        "反身以自观，须弥纳一芥。",
        "以此处死生，超然万形内。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 156512,
      "title": "滹沱河二首  其一",
      "content": [
        "过了长江与大河，横流数仞绝滹沱。",
        "萧王麦饭曾仓卒，回首中天感慨多。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 156513,
      "title": "滹沱河二首  其二",
      "content": [
        "风沙睢水终亡楚，草木公山竟蹙秦。",
        "始信滹沱冰合事，世间兴废不由人。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 156514,
      "title": "河间  其一",
      "content": [
        "空有丹心贯碧霄，泮冰亡国不崇朝。",
        "小臣万死无遗慨，曾见天家十八朝。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 156515,
      "title": "河间  其二",
      "content": [
        "南归雁荡报郎君，老子精神健十分。",
        "不为瀛洲复相见，阿戎翻隔万山云。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 156516,
      "title": "河间  其三",
      "content": [
        "江南车盖走燕山，老子旁观袖手闲。",
        "见说新诗题甲子，桃源元只在人间。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 156517,
      "title": "保州道中",
      "content": [
        "昨日渡滹沱，今日望太行。",
        "白云何渺渺，天地何茫茫。",
        "落叶混西风，黄尘昏夕阳。",
        "牛车过不住，毡屋行相望。",
        "小儿骑蹇馿，壮士驾乘黄。",
        "高低叶万顷，黑白草千行。",
        "村落有古风，人间无时粧。",
        "宋辽旧分界，燕赵古战场。",
        "蚩尤乱涿野，共工谪幽邦。",
        "郭隗致乐毅，荆轲携舞阳。",
        "臧卢互反复，安史迭披猖。",
        "山川一今古，人物几兴亡。",
        "江南占毕生，往来习羊肠。",
        "天马戴青蝇，电秣驰康庄。",
        "适从何有来，如此醉梦乡。",
        "感时意踟蹰，惜往泪淋浪。",
        "厉阶起玉环，左计由石郎。",
        "天地行日月，万代乘景光。",
        "昼夜果可废，春秋诚荒唐。",
        "吾生直须臾，俯仰际八荒。",
        "来者不可见，远游赋彷徨。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 156518,
      "title": "保涿州三诗 赵太祖墓",
      "content": [
        "我行保州塞，御河直其东。",
        "山川犹有灵，佳气何鬰葱。",
        "顾我巾车囚，厉气转秋蓬。",
        "瓣香欲往拜，惆怅临长空。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156519,
      "title": "保涿州三诗 楼桑",
      "content": [
        "我过梁门城，楼桑在其北。",
        "玄德已千年，青烟遶故宅。",
        "道傍为挥泪，徘徊秋风客。",
        "天下卧龙人，多少空抱膝。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156520,
      "title": "保涿州三诗 涿鹿",
      "content": [
        "我瞻涿鹿野，古来战蚩尤。",
        "轩辕此立极，玉帛朝诸侯。",
        "历历关河雁，随风鸣寒秋。",
        "迩来三千年，王气行幽州。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156521,
      "title": "过梁门",
      "content": [
        "一一金瓯在，双双镇璧全。",
        "土花开旧国，风絮渡江船。",
        "南北分新统，江淮号极边。",
        "更和天堑失，回首惨啼鹃。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156522,
      "title": "白沟河",
      "content": [
        "昔时张叔夜，统兵赴勤王。",
        "东都一不守，羸马迁龙荒。",
        "适过白沟河，裂眦须欲张。",
        "绝粒不遄死，仰天扼其吭。",
        "群臣总奄奄，一土垂天光。",
        "读史识其地，抚卷为凄凉。",
        "我生何不辰，异世忽相望。",
        "皇图遘阳九，天堑满飞堭。",
        "引兵诣阙下，捧土障澜狂。",
        "出使义不屈，持节还中郎。",
        "六飞独南海，金钺将煌煌。",
        "武侯空威心，出狩惊四方。",
        "吾属竟为虏，世事吁彼苍。",
        "思公有奇节，一死何慨慷。",
        "江淮我分地，我欲投沧浪。",
        "沧浪却不受，中原行路长。",
        "初登项籍宫，次览刘季邦。",
        "涉足河与济，回首嵩与恒。",
        "下车抚梁门，上马指楼桑。",
        "戴星渡一水，惨淡天微茫。",
        "行人为我言，宋辽此分疆。",
        "悬知公死处，为公出涕滂。",
        "恨不持束刍，徘徊官道傍。",
        "我死还在燕，烈烈同肝肠。",
        "今我为公哀，后来谁我伤。",
        "天地垂日月，斯人未云亡。",
        "文武道不坠，我辈终堂堂。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 156523,
      "title": "怀孔明",
      "content": [
        "斜谷事不济，将星殒营中。",
        "至今出师表，读之泪沾胸。",
        "汉贼明大义，赤心贯苍穹。",
        "世以成败论，操懿真英雄。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156524,
      "title": "刘琨",
      "content": [
        "中原荡分崩，壮哉刘越石。",
        "连踪起幽并，只手扶晋室。",
        "福华天意乘，匹䃅生鬼蜮。",
        "公死百世名，天下分南北。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156525,
      "title": "祖逖",
      "content": [
        "平生祖豫州，白首起大事。",
        "东门长啸儿，为逊一头地。",
        "何哉戴若思，中道奋螳臂。",
        "豪杰事垂成，今古为短气。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156526,
      "title": "颜杲卿",
      "content": [
        "常山义旗奋，范阳哽喉咽。",
        "胡雏一狼狈，六飞入西川。",
        "哥舒降且拜，公舌膏戈鋋。",
        "人世谁不死，公死千万年。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156527,
      "title": "许远",
      "content": [
        "起师哭玄元，义气震天地。",
        "百战奋雄姿，脔妾士挥泪。",
        "睢阳水东流，双庙垂百世。",
        "当时令狐潮，乃为贼游说。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156528,
      "title": "过雪桥琉璃桥",
      "content": [
        "小桥度雪度琉璃，更有清霜滑马蹄。",
        "游子衣裳如铁冷，残星荒店野鸡啼。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 156529,
      "title": "五月二日生朝",
      "content": [
        "北风吹满楚冠尘，笑捧蟠桃梦里春。",
        "几岁已无笼鸽客，去年犹有送半人。",
        "江山如许非吾土，宇宙柰何多此身。",
        "不灭不生在何许，静中聊且养吾真。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 156530,
      "title": "胡笳曲 一拍",
      "content": [
        "风尘澒洞昏王室，天地惨惨无颜色。",
        "而今西北自反胡，西望千山万山赤。",
        "叹息人间万事非，被驱不异犬与鸡。",
        "不知明月为谁好，来岁如今归未归。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 156531,
      "title": "胡笳曲 二拍",
      "content": [
        "独立缥缈之飞楼，高视乾坤又何愁。",
        "江风萧萧云拂地，笛声愤怒哀中流。",
        "邻鸡野哭如昨日，昨日晚晴今日黑。",
        "苍皇已就长途往，欲往城南忘南北。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 156532,
      "title": "胡笳曲 三拍",
      "content": [
        "三年奔走空皮骨，三年笛里关山月。",
        "中天月色好谁看，豺狼塞路人烟绝。",
        "寒刮肌肤北风利，牛马毛零缩如猬。",
        "塞上风云接地阴，咫尺但愁雷雨至。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 156533,
      "title": "胡笳曲 四拍",
      "content": [
        "黄河北岸海西军，翻身向天仰射云。",
        "胡马长鸣不知数，衣冠南渡多崩奔。",
        "山木惨惨天欲雨，前有毒蛇后猛虎。",
        "欲问长安无使来，终日戚戚忍羁旅。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 156534,
      "title": "胡笳曲 五拍",
      "content": [
        "北庭数有关中使，飘飘远自流沙至。",
        "胡人高鼻动成群，仍唱胡歌饮都市。",
        "中原无书归不得，道路只今多拥隔。",
        "身欲奋飞病在床，时独看云泪沾臆。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 156535,
      "title": "胡笳曲 六拍",
      "content": [
        "胡人归来血洗箭，白马将军若雷电。",
        "蛮夷杂种错相干，洛阳宫殿烧焚尽。",
        "干戈兵革鬭未已，魑魅魍魉徒为尔。",
        "恸哭秋原何处村，千村万落生荆杞。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 156536,
      "title": "胡笳曲 七拍",
      "content": [
        "忆昔十五心尚孩，莫怪频频劝酒杯。",
        "孤城此日肠堪断，如何不饮令人哀。",
        "一去紫台连朔漠，月出云通雪山白。",
        "九度附书归洛阳，故国三年一消息。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 156537,
      "title": "胡笳曲 八拍",
      "content": [
        "只今年才十六七，风尘荏苒音书绝。",
        "胡骑长驱五六年，弊裘何啻连百结。",
        "愁对寒云雪满山，愁看冀北是长安。",
        "此身未知归定处，漂泊西南天地间。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 156538,
      "title": "胡笳曲 九拍",
      "content": [
        "午夜漏声催晓箭，寒尽春生洛阳殿。",
        "汉主山河锦绣中，可惜春光不相见。",
        "自胡之反持干戈，一生抱恨空咨嗟。",
        "我已无家寻弟妹，此身那得更无家。",
        "南极一星朝北斗，每依南斗望京华。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 156539,
      "title": "胡笳曲 十拍",
      "content": [
        "今年臈月冻全消，天涯涕泪一身遥。",
        "诸将亦自军中至，行人弓箭各在腰。",
        "白马嚼啮黄金勒，三尺角弓两斛力。",
        "胡雁翅湿高飞难，一箭正坠双飞翼。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    }
  ],
