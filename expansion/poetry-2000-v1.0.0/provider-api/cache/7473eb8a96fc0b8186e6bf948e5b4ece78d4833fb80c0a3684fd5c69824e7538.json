{
  "data": [
    {
      "id": 261952,
      "title": "残莺百啭歌同王员外耿拾遗吉中孚李端游慈恩各赋一物",
      "content": [
        "残莺一何怨，百啭相寻续。",
        "始辨下将高，稍分长复促。",
        "绵蛮巧状语，机节终如曲。",
        "野客赏应迟，幽僧闻讵足。",
        "禅斋深树夏阴清，零落空余三两声。",
        "金谷筝中传不似，山阳笛里写难成。",
        "忆昨乱啼无远近，晴宫晓色偏相引。",
        "送暖初随柳色来，辞芳暗逐花枝尽。",
        "歌残莺，歌残莺，悠然万感生。",
        "谢朓羇怀方一听，何郎闲吟本多情。",
        "乃知众鸟非俦比，暮噪晨鸣倦人耳。",
        "共爱奇音那可亲，年年出谷待新春。",
        "此时断绝为君惜，明日玄蝉催发白。"
      ],
      "author": {
        "id": 1360,
        "name": "司空曙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 261953,
      "title": "过终南柳处士",
      "content": [
        "云起山苍苍，林居萝薜荒。",
        "幽人老深境，素发与青裳。",
        "雨涤莓苔绿，风摇松桂香。",
        "洞泉分溜浅，岩笋出藂长。",
        "败屦安松砌，余棋在石床。",
        "书名一为别，还路已堪伤。"
      ],
      "author": {
        "id": 1360,
        "name": "司空曙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 261954,
      "title": "春送郭大之官",
      "content": [
        "明府之官官舍春，春风辞我两三人。",
        "可怜江县闲无事，手板支颐独咏贫。"
      ],
      "author": {
        "id": 1360,
        "name": "司空曙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 261955,
      "title": "送郑锡",
      "content": [
        "汉阳云树清无极，蜀国风烟思不堪。",
        "莫怪别君偏有泪，十年曾事晋征南。"
      ],
      "author": {
        "id": 1360,
        "name": "司空曙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 261956,
      "title": "同张参军喜李尚书寄新琴",
      "content": [
        "新琴传凤凰，晴景称高张。",
        "白玉连徽净，朱丝系爪长。",
        "轻埃随拂拭，杂籁满铿锵。",
        "暗想山泉合，如亲兰蕙芳。",
        "正声消郑衞，古状掩笙簧。",
        "远识贤人意，清风愿激扬。"
      ],
      "author": {
        "id": 1360,
        "name": "司空曙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 261957,
      "title": "苦热",
      "content": [
        "暑气发炎州，焦烟远未收。",
        "啸风兼炽燄，挥汗讶成流。",
        "鹳鹊投林尽，龟鱼拥石稠。",
        "漱泉齐饮酎，衣葛剧兼裘。",
        "长簟贪欹枕，轻巾嬾挂头。",
        "招商如有曲，一为取新秋。"
      ],
      "author": {
        "id": 1360,
        "name": "司空曙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 261958,
      "title": "送人归黔府",
      "content": [
        "伏波箫鼓水云中，长戟如霜大斾红。",
        "油幕晓开飞鸟绝，翩翩上将独趋风。"
      ],
      "author": {
        "id": 1360,
        "name": "司空曙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 261959,
      "title": "杂兴",
      "content": [
        "月没辽城暗出师，双龙金角晓天悲。",
        "黄尘满目随风散，不认将军燕尾旗。"
      ],
      "author": {
        "id": 1360,
        "name": "司空曙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 261960,
      "title": "岁暮怀崔峒耿𣲗",
      "content": [
        "腊月江天见春色，白花青柳疑寒食。",
        "洛阳旧社各东西，楚国游人不相识。"
      ],
      "author": {
        "id": 1360,
        "name": "司空曙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 261961,
      "title": "观妓",
      "content": [
        "翠蛾红脸不胜情，管绝弦余发一声。",
        "银烛摇摇尘暗下，却愁红粉泪痕生。"
      ],
      "author": {
        "id": 1360,
        "name": "司空曙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 261962,
      "title": "过长林湖西酒家",
      "content": [
        "湖草青青三两家，门前桃杏一般花。",
        "迁人到处唯求醉，闻说渔翁有酒赊。"
      ],
      "author": {
        "id": 1360,
        "name": "司空曙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 261963,
      "title": "过阎采病居",
      "content": [
        "每逢佳节何曾坐，唯有今年不得游。",
        "张邴卧来休送客，菊花枫叶向谁秋。"
      ],
      "author": {
        "id": 1360,
        "name": "司空曙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 261964,
      "title": "送程秀才",
      "content": [
        "悠悠多路岐，相见又别离。",
        "东风催节换，燄燄春阳散。",
        "楚草渐烟绵，江云亦芜漫。",
        "送子恨何穷，故关如梦中。",
        "游人尽还北，旅雁辞南国。",
        "枫树几回青，逐臣归不得。"
      ],
      "author": {
        "id": 1360,
        "name": "司空曙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 261965,
      "title": "长林令衞象饧丝结歌",
      "content": [
        "主人雕盘盘素丝，寒女眷眷墨子悲。",
        "乃言假使饧为之，八珍重沓失颜色。",
        "手援玉筯不敢持，始状芙蓉新出水。",
        "仰坼重衣倾万蕊，又如合欢交乱枝。",
        "红茸向暮花参差，吴蚕络茧抽尚绝。",
        "细缕纤毫看欲灭，雪发羞垂倭堕鬟。",
        "绣囊畏并茱萸结，我爱此丝巧。",
        "妙绝世间无，为君作歌陈座隅。"
      ],
      "author": {
        "id": 1360,
        "name": "司空曙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 261966,
      "title": "酬崔峒见寄",
      "content": [
        "趋陪禁掖雁行随，迁放江潭鹤发垂。",
        "素浪遥疑太液水，青枫忽似万年枝。",
        "嵩南春遍愁魂梦，壶口云深隔路岐。",
        "共望汉朝多沛泽，苍蝇早晚得先知。"
      ],
      "author": {
        "id": 1360,
        "name": "司空曙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 261967,
      "title": "闻春雷",
      "content": [
        "水国春雷早，阗阗若众车。",
        "自怜迁逐者，犹滞蛰藏余。"
      ],
      "author": {
        "id": 1360,
        "name": "司空曙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 261968,
      "title": "晚秋西省寄上李韩二舍人",
      "content": [
        "昼漏传清唱，天恩禁旅秋。",
        "雁亲承露掌，砧隔曝衣楼。",
        "赐膳中人送，余香侍女收。",
        "仍闻劳上直，晚步凤池头。"
      ],
      "author": {
        "id": 1360,
        "name": "司空曙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261969,
      "title": "下武昌江行望涔阳",
      "content": [
        "悠悠次楚乡，楚口下涔阳。",
        "雪隐洲渚暗，沙高芦荻黄。",
        "渔人共留滞，水鸟自喧翔。",
        "怀土年空尽，春风又淼茫。"
      ],
      "author": {
        "id": 1360,
        "name": "司空曙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261970,
      "title": "送史申之峡州",
      "content": [
        "峡口巴江外，无风浪亦翻。",
        "蒹葭新有雁，云雨不离猨。",
        "行客思乡远，愁人赖酒昏。",
        "檀郎好联句，共滞谢家门。"
      ],
      "author": {
        "id": 1360,
        "name": "司空曙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261971,
      "title": "送王闰",
      "content": [
        "相送临寒水，苍然望故关。",
        "江芜连梦泽，楚雪入商山。",
        "话我他年旧，看君此日还。",
        "因将自悲泪，一洒别离间。"
      ],
      "author": {
        "id": 1360,
        "name": "司空曙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261972,
      "title": "江园书事寄卢纶",
      "content": [
        "种柳南江边，闭门三四年。",
        "艳花那胜竹，凡鸟不如蝉。",
        "嗜酒渐婴渴，读书多欲眠。",
        "平生故交在，白首远相怜。"
      ],
      "author": {
        "id": 1360,
        "name": "司空曙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261973,
      "title": "送郑况往淮南",
      "content": [
        "西楚见南关，苍苍落日间。",
        "云离大雷树，潮入秣陵山。",
        "登戍因高望，停桡放溜闲。",
        "陈公有贤榻，君去岂空还。"
      ],
      "author": {
        "id": 1360,
        "name": "司空曙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261974,
      "title": "题江陵临沙驿楼",
      "content": [
        "江天清更愁，风柳入江楼。",
        "雁惜楚山晚，蝉知秦树秋。",
        "凄凉多独醉，零落半同游。",
        "岂复平生意，苍然兰杜洲。"
      ],
      "author": {
        "id": 1360,
        "name": "司空曙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261975,
      "title": "新蝉",
      "content": [
        "今朝蝉忽鸣，迁客若为情。",
        "便觉一年老，能令万感生。",
        "微风方满树，落日稍沈城。",
        "为问同怀者，凄凉听几声。"
      ],
      "author": {
        "id": 1360,
        "name": "司空曙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261976,
      "title": "送张弋",
      "content": [
        "拥櫂江天旷，苍然下郢城。",
        "冰霜葭菼变，云泽鹧鸪鸣。",
        "酒倦临流醉，人逢置榻迎。",
        "尝闻藉东观，不独鲁诸生。"
      ],
      "author": {
        "id": 1360,
        "name": "司空曙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261977,
      "title": "送僧无言归山",
      "content": [
        "袈裟出尘外，山径几盘缘。",
        "人到白云树，鹤沈青草田。",
        "龛泉朝请盥，松籁夜和禅。",
        "自昔闻多学，逍遥注一篇。"
      ],
      "author": {
        "id": 1360,
        "name": "司空曙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261978,
      "title": "和卢校书文若早入使院书事",
      "content": [
        "解带独裴回，秋风如水来。",
        "轩墀湿繁露，琴几拂轻埃。",
        "晨鸟犹在叶，夕虫余囗苔。",
        "苍然发高兴，相仰坐难陪。"
      ],
      "author": {
        "id": 1360,
        "name": "司空曙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261979,
      "title": "送史泽之长沙",
      "content": [
        "谢朓怀西府，单车触火云。",
        "野蕉依戍客，庙竹暎湘君。",
        "梦渚巴山断，长沙楚路分。",
        "一杯从别后，风月不相闻。"
      ],
      "author": {
        "id": 1360,
        "name": "司空曙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261980,
      "title": "田家",
      "content": [
        "田家喜雨足，邻老相招携。",
        "泉溢沟塍坏，麦高桑柘低。",
        "呼儿催放犊，宿客待烹鸡。",
        "搔首蓬门下，如将轩冕齐。"
      ],
      "author": {
        "id": 1360,
        "name": "司空曙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261981,
      "title": "送卢堪",
      "content": [
        "羁贫不易去，此日始西东。",
        "旅舍秋霖叶，行人寒草风。",
        "酒醒余恨在，野饯暂游同。",
        "莫使祢生刺，空留怀袖中。"
      ],
      "author": {
        "id": 1360,
        "name": "司空曙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261982,
      "title": "送柳震入蜀",
      "content": [
        "粉堞连青气，喧喧杂万家。",
        "夷人祠竹节，蜀鸟乳桐花。",
        "酒报新丰景，琴迎抵峡斜。",
        "多闻滞游客，不似在天涯。"
      ],
      "author": {
        "id": 1360,
        "name": "司空曙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261983,
      "title": "送李嘉祐正字括图书兼往扬州觐省",
      "content": [
        "不事兰台贵，全多韦带风。",
        "儒官比刘向，使者得陈农。",
        "晚烧平芜外，朝阳叠浪东。",
        "归来喜调膳，寒笋出林中。"
      ],
      "author": {
        "id": 1360,
        "name": "司空曙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261984,
      "title": "送刘侍御",
      "content": [
        "狱成收夜烛，整豸出登车。",
        "黄叶辞荆楚，青山背汉初。",
        "早朝新羽衞，晚下步徒胥。",
        "应念长沙谪，思乡不食鱼。"
      ],
      "author": {
        "id": 1360,
        "name": "司空曙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261985,
      "title": "送庞判官赴黔中",
      "content": [
        "天远风烟异，西南见一方。",
        "乱山来蜀道，诸水出辰阳。",
        "堆案青油暮，看棋画角长。",
        "论文谁可制，记室有何郎。"
      ],
      "author": {
        "id": 1360,
        "name": "司空曙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261986,
      "title": "送人游岭南",
      "content": [
        "万里南游客，交州见柳条。",
        "逢迎人易合，时日酒能消。",
        "浪晓浮青雀，风温解黑貂。",
        "囊金如未足，莫恨故乡遥。"
      ],
      "author": {
        "id": 1360,
        "name": "司空曙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261987,
      "title": "送曹同椅",
      "content": [
        "青春三十余，众艺尽无如。",
        "中散诗传画，将军扇续书。",
        "楚田晴下雁，江日暖游鱼。",
        "惆怅空相送，欢游自此疎。"
      ],
      "author": {
        "id": 1360,
        "name": "司空曙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261988,
      "title": "送鄂州张别驾襄阳觐省",
      "content": [
        "苍苍岘亭路，腊月汉阳春。",
        "带雪半山寺，行沙隔水人。",
        "王祥因就宦，莱子不违亲。",
        "正恨殊乡别，千条楚柳新。"
      ],
      "author": {
        "id": 1360,
        "name": "司空曙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261989,
      "title": "送魏季羔游长沙觐兄",
      "content": [
        "芦荻湘江水，萧萧万里秋。",
        "鹤高看迥野，蝉远入中流。",
        "访友多成滞，携家不厌游。",
        "惠连仍有作，知得从兄酬。"
      ],
      "author": {
        "id": 1360,
        "name": "司空曙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261990,
      "title": "杂言",
      "content": [
        "伏余西景移，风雨洒轻𫄨。",
        "燕拂青芜地，蝉鸣红叶枝。"
      ],
      "author": {
        "id": 1360,
        "name": "司空曙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 261991,
      "title": "翫花与衞象同醉",
      "content": [
        "衰鬓千茎雪，他乡一树花。",
        "今朝与君醉，忘却在长沙。"
      ],
      "author": {
        "id": 1360,
        "name": "司空曙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 261992,
      "title": "送王尊师归湖州",
      "content": [
        "烟芜满洞青山遶，幢节飘空紫凤飞。",
        "金阙乍看迎日丽，玉箫遥听隔花微。",
        "多开石髓供调膳，时御霓裳奉易衣。",
        "莫学辽东华表上，千年始欲一回归。"
      ],
      "author": {
        "id": 1360,
        "name": "司空曙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 261993,
      "title": "九日洛东亭",
      "content": [
        "风息斜阳尽，游人曲落间。",
        "采花因覆酒，行草转看山。",
        "柳散新霜下，天晴早雁还。",
        "伤秋非骑省，玄发白成斑。"
      ],
      "author": {
        "id": 1360,
        "name": "司空曙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261994,
      "title": "九日送人",
      "content": [
        "送人冠獬豸，值节佩茱萸。",
        "均覆征三壤，登车出五湖。",
        "水风凄落日，岸叶飒衰芜。",
        "自恨尘中使，何因在路隅。"
      ],
      "author": {
        "id": 1360,
        "name": "司空曙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261995,
      "title": "哭王注",
      "content": [
        "已叹漳滨卧，何言驻隙难。",
        "异才伤促短，诸友哭门阑。",
        "古道松声暮，荒阡草色寒。",
        "延陵今葬子，空使鲁人观。"
      ],
      "author": {
        "id": 1360,
        "name": "司空曙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261996,
      "title": "遇谷口道士",
      "content": [
        "一见林中客，闲知州县劳。",
        "白云秋色远，苍岭夕阳高。",
        "自说名因石，谁逢手种桃。",
        "丹经傥相授，何用恋青袍。"
      ],
      "author": {
        "id": 1360,
        "name": "司空曙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261997,
      "title": "喜外弟卢纶见宿",
      "content": [
        "静夜四无邻，荒居旧业贫。",
        "雨中黄叶树，灯下白头人。",
        "以我独沈久，愧君相见频。",
        "平生自有分，况是蔡家亲。"
      ],
      "author": {
        "id": 1360,
        "name": "司空曙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261998,
      "title": "深上人见访忆李端",
      "content": [
        "雁稀秋色尽，落日对寒山。",
        "避事多称疾，留僧独闭关。",
        "心归尘俗外，道胜有无间。",
        "仍忆东林友，相期久不还。"
      ],
      "author": {
        "id": 1360,
        "name": "司空曙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261999,
      "title": "宿青龙寺故昙上人院",
      "content": [
        "年深宫院在，旧客自相逢。",
        "闭户临寒竹，无人有夜钟。",
        "降龙今已去，巢鹤竟何从。",
        "坐见繁星晓，凄凉识旧峰。"
      ],
      "author": {
        "id": 1360,
        "name": "司空曙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 262000,
      "title": "送张炼师还峨嵋山",
      "content": [
        "太一天坛天柱西，垂萝为幌石为梯。",
        "前登灵境青霄绝，下视人间白日低。",
        "松籁万声和管磐，丹光五色杂虹蜺。",
        "春山一入寻无路，鸟响烟深水满溪。"
      ],
      "author": {
        "id": 1360,
        "name": "司空曙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 262001,
      "title": "逢江客问南中故人因以诗寄",
      "content": [
        "南客何时去，相逢问故人。",
        "望乡空泪落，嗜酒转家贫。",
        "疎嬾辞微禄，东西任老身。",
        "上楼多看月，临水共伤春。",
        "五柳终期隐，双鸥自可亲。",
        "应怜折腰吏，冉冉在风尘。"
      ],
      "author": {
        "id": 1360,
        "name": "司空曙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 262002,
      "title": "送臯法师",
      "content": [
        "江草知寒柳半衰，行吟怨别独迟迟。",
        "何人讲席投如意，唯有东林远法师。"
      ],
      "author": {
        "id": 1360,
        "name": "司空曙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262003,
      "title": "送郑佶归洛阳",
      "content": [
        "苍苍楚色水云间，一醉春风送尔还。",
        "何处乡心最堪羡，汝南初见洛阳山。"
      ],
      "author": {
        "id": 1360,
        "name": "司空曙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262004,
      "title": "分流水",
      "content": [
        "古时愁别泪，滴作分流水。",
        "日夜东西流，分流几千里。",
        "通塞两不见，波澜各自起。",
        "与君相背飞，去去心如此。"
      ],
      "author": {
        "id": 1360,
        "name": "司空曙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 262005,
      "title": "和耿拾遗元日观早朝",
      "content": [
        "元日争朝阙，奔流若会溟。",
        "路尘和薄雾，骑火接低星。",
        "门响双鱼钥，车喧百子铃。",
        "冕旒当翠殿，幢戟满彤庭。",
        "积岁方编瑞，乘春即省刑。",
        "大官陈禹玉，司历献尧蓂。",
        "寿酒三觞退，箫韶九奏停。",
        "太阳开物象，霈泽及生灵。",
        "南陌高山碧，东方晓气青。",
        "自怜扬子贱，归草太玄经。"
      ],
      "author": {
        "id": 1360,
        "name": "司空曙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 262006,
      "title": "塞下曲",
      "content": [
        "寒柳接胡桑，军门向大荒。",
        "幕营随月魄，兵气长星芒。",
        "横吹催春酒，重裘隔夜霜。",
        "冰开不防虏，青草满辽阳。"
      ],
      "author": {
        "id": 1360,
        "name": "司空曙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 262007,
      "title": "关山月",
      "content": [
        "苍茫明月上，夜久光如积。",
        "野幕冷胡霜，关楼宿边客。",
        "陇头秋露暗，碛外寒沙白。",
        "唯有故乡人，霑裳此闻笛。"
      ],
      "author": {
        "id": 1360,
        "name": "司空曙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 262008,
      "title": "御制雨后出城观览敕朝臣已下属和",
      "content": [
        "上上开鹑野，师师出凤城。",
        "因知圣主念，得遂老农情。",
        "陇麦垂秋合，郊尘得雨清。",
        "时新荐玄祖，岁足富苍生。",
        "却马川原静，闻鸡水土平。",
        "薰弦歌舜德，和鼎致尧名。",
        "览物欣多稼，垂衣御大明。",
        "史官何所录，称瑞满天京。"
      ],
      "author": {
        "id": 1360,
        "name": "司空曙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 262009,
      "title": "奉和常舍人晚秋集贤院即事寄徐薛二侍郎",
      "content": [
        "蔼蔼凤凰宫，兰台玉署通。",
        "夜霜凝树羽，朝日照相风。",
        "官附三台贵，儒开百氏宗。",
        "司言陈禹命，侍讲发尧聪。",
        "香卷青编内，铅分绿字中。",
        "缀签从太史，锵佩揖群公。",
        "池接天泉碧，林交御果红。",
        "寒龟登故叶，秋蝶恋疎藂。",
        "颜谢征文并，钟裴直事同。",
        "离群惊海鹤，属思怨江枫。",
        "地远姑苏外，山长越绝东。",
        "慙当哲匠后，下曲本难工。"
      ],
      "author": {
        "id": 1360,
        "name": "司空曙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 262010,
      "title": "题鲜于秋林园",
      "content": [
        "雨后园林好，幽行迥野通。",
        "远山芳草外，流水落花中。",
        "客醉悠悠惯，莺啼处处同。",
        "夕阳自一望，日暮杜陵东。"
      ],
      "author": {
        "id": 1360,
        "name": "司空曙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 262011,
      "title": "登秦岭",
      "content": [
        "南登秦岭头，回首始堪忧。",
        "汉阙青门远，商山蓝水流。",
        "三湘迁客去，九陌故人游。",
        "从此思乡泪，双垂不复收。"
      ],
      "author": {
        "id": 1360,
        "name": "司空曙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 262012,
      "title": "独游寄衞长林",
      "content": [
        "草绿春阳动，迟迟泽畔游。",
        "恋花同野蝶，爱水剧江鸥。",
        "身外唯须醉，人间尽是愁。",
        "那知鸣玉者，不羡卖瓜侯。"
      ],
      "author": {
        "id": 1360,
        "name": "司空曙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 262013,
      "title": "望水",
      "content": [
        "高楼晴见水，楚色霭相和。",
        "野极空如练，天遥不辨波。",
        "永无人迹到，时有鸟行过。",
        "况是苍茫外，残阳照最多。"
      ],
      "author": {
        "id": 1360,
        "name": "司空曙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 262014,
      "title": "望商山路",
      "content": [
        "南见青山道，依然去国时。",
        "已甘长避地，谁料有还期。",
        "雨霁残阳薄，人愁独望迟。",
        "空残华发在，前事不堪思。"
      ],
      "author": {
        "id": 1360,
        "name": "司空曙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 262015,
      "title": "题落叶",
      "content": [
        "霜景催危叶，今朝半树空。",
        "萧条故国异，零落旅人同。",
        "飒岸浮寒水，依堦拥夜虫。",
        "随风偏可羡，得到洛阳宫。"
      ],
      "author": {
        "id": 1360,
        "name": "司空曙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 262016,
      "title": "寄准上人",
      "content": [
        "昨闻归旧寺，暂别欲经年。",
        "樵客应同步，邻僧定伴禅。",
        "后峰秋有雪，远涧夜鸣泉。",
        "偶与支公论，人间自共传。"
      ],
      "author": {
        "id": 1360,
        "name": "司空曙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 262017,
      "title": "送况上人还荆州因寄衞侍御象",
      "content": [
        "惠持游蜀久，策杖欲西还。",
        "共别此宵月，独归何处山。",
        "对鸥沙草畔，洗足野云间。",
        "知有玄晖会，斋心受八关。"
      ],
      "author": {
        "id": 1360,
        "name": "司空曙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 262018,
      "title": "别卢纶",
      "content": [
        "有月多共赏，无秋不共悲。",
        "如何与君别，又是菊黄时。"
      ],
      "author": {
        "id": 1360,
        "name": "司空曙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 262019,
      "title": "雪二首 一",
      "content": [
        "乐游春苑望鹅毛，宫殿如星树似毫。",
        "漫漫一川横渭水，太阳初出五陵高。"
      ],
      "author": {
        "id": 1360,
        "name": "司空曙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262020,
      "title": "雪二首 二",
      "content": [
        "王屋南崖见洛城，石龛松寺上方平。",
        "半山槲叶当窗下，一夜曾闻雪打声。"
      ],
      "author": {
        "id": 1360,
        "name": "司空曙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262021,
      "title": "酬衞长林岁日见呈",
      "content": [
        "地暖雪花摧，天春斗柄回。",
        "朱泥一丸药，柏叶万年杯。",
        "旅雁辞人去，繁霜满镜来。",
        "今朝彩盘上，神燕不须雷。"
      ],
      "author": {
        "id": 1360,
        "name": "司空曙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 262022,
      "title": "杜鹃行",
      "content": [
        "古时杜宇称望帝，魂作杜鹃何微细。",
        "跳枝窜叶树木中，抢翔瞥捩雌随雄。",
        "毛衣惨黑自顦顇，众鸟安肯相尊崇。",
        "隳形不敢栖华屋，短翮唯愿巢深丛。",
        "穿皮啄朽觜欲秃，苦饥始得食一虫。",
        "谁言养雏不自哺，此语亦足为愚蒙。",
        "声音咽哕若有谓，号啼略与婴儿同。",
        "口干垂血转迫促，似欲上诉于苍穹。",
        "蜀人闻之皆起立，至今相效传遗风。",
        "乃知变化不可穷，岂知昔日居深宫，嫔妃左右如花红。"
      ],
      "author": {
        "id": 1360,
        "name": "司空曙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 262023,
      "title": "寄胡居士",
      "content": [
        "日暖风微南陌头，青田红树起春愁。",
        "伯劳相逐行人别，岐路空归野水流。",
        "徧地寻僧同看雪，谁期载酒共登楼。",
        "为言惆怅嵩阳寺，明月高松应独游。"
      ],
      "author": {
        "id": 1360,
        "name": "司空曙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 262024,
      "title": "寒塘",
      "content": [
        "晓发梳临水，寒塘坐见秋。",
        "乡心正无限，一雁度南楼。"
      ],
      "author": {
        "id": 1360,
        "name": "司空曙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 262025,
      "title": "为李魏公赋谢汧公",
      "content": [
        "白雪高吟际，青霄远望中。",
        "谁言路遐旷，宫征暗相通。"
      ],
      "author": {
        "id": 1360,
        "name": "司空曙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 262026,
      "title": "梁城老人怨",
      "content": [
        "朝为耕钟人，暮作刀枪鬼。",
        "相看父子血，共染城壕水。"
      ],
      "author": {
        "id": 1360,
        "name": "司空曙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 334860,
      "title": "琴曲歌辞：蔡氏五弄：秋思",
      "content": [
        "静与懒相偶，年将衰共催。",
        "前途欢不集，往事恨空来。",
        "昼景委红叶，月华铺绿苔。",
        "沉思更何有，结坐玉琴哀。"
      ],
      "author": {
        "id": 1360,
        "name": "司空曙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 347252,
      "title": "和李员外与舍人咏玫瑰花寄徐侍郎",
      "content": [
        "仙吏紫薇郎，奇花共玩芳。",
        "攒星排绿蒂，照眼发红光。",
        "暗妒翻阶药，遥连直署香。",
        "游枝蜂绕易，碍刺鸟衔妨。",
        "露湿凝衣粉，风吹散蕊黄。",
        "蒙茏珠树合，焕烂锦屏张。",
        "留客胜看竹，思人比爱棠。",
        "如传采苹咏，远思满潇湘。"
      ],
      "author": {
        "id": 1360,
        "name": "司空曙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 347259,
      "title": "卫明府寄枇杷叶以诗答",
      "content": [
        "倾筐呈绿叶，重叠色何鲜。",
        "讵是秋风里，犹如晓露前。",
        "仙方当见重，消疾本应便。",
        "全胜甘蕉赠，空投谢氏篇。"
      ],
      "author": {
        "id": 1360,
        "name": "司空曙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 347262,
      "title": "送严使君游山",
      "content": [
        "家楚依三户，辞州选一钱。",
        "酒杯同寄世，客棹任销年。",
        "赤烧兼山远，青芜与浪连。",
        "青春明月夜，知上鄂君船。"
      ],
      "author": {
        "id": 1360,
        "name": "司空曙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 347266,
      "title": "酬郑十四望驿不得同宿见赠因寄张参军",
      "content": [
        "逢君喜成泪，暂似故乡中。",
        "谪宦犹多惧，清宵不得终。",
        "月烟高有鹤，宿草净无虫。",
        "明日郤超会，应思下客同。"
      ],
      "author": {
        "id": 1360,
        "name": "司空曙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 347271,
      "title": "闲园书事招畅当",
      "content": [
        "闻蝉昼眠后，欹枕对蓬蒿。",
        "羸病懒寻戴，田园方咏陶。",
        "傍簷虫挂静，出树蝶飞高。",
        "惆怅临清镜，思君见鬓毛。"
      ],
      "author": {
        "id": 1360,
        "name": "司空曙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 347274,
      "title": "赠李端",
      "content": [
        "共忆南浮日，登高望若何。",
        "楚田湖草远，江寺海榴多。",
        "载酒寻山宿，思人带雪过。",
        "东西几回别，此会各蹉跎。"
      ],
      "author": {
        "id": 1360,
        "name": "司空曙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 347276,
      "title": "过胡居士睹王右丞遗文",
      "content": [
        "旧日相知尽，深居独一身。",
        "闭门空有雪，看竹永无人。",
        "每许前山隐，曾怜陋巷贫。",
        "题诗今尚在，暂为拂流尘。"
      ],
      "author": {
        "id": 1360,
        "name": "司空曙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 347277,
      "title": "送郎使君赴郢州",
      "content": [
        "使君持节去，云水满前程。",
        "楚寺多连竹，江樯远映城。",
        "登楼向月望，赛庙傍山行。",
        "若动思乡咏，应贻谢步兵。"
      ],
      "author": {
        "id": 1360,
        "name": "司空曙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 347280,
      "title": "同苗员外宿荐福常师房",
      "content": [
        "浮生共多故，聚宿喜君同。",
        "人息时闻磬，灯摇乍有风。",
        "霜阶疑水际，夜木似山中。",
        "一愿持如意，长来事远公。"
      ],
      "author": {
        "id": 1360,
        "name": "司空曙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 347288,
      "title": "送卢使君赴夔州",
      "content": [
        "铙管随旌旆，高秋远上巴。",
        "白波连雾雨，青壁断蒹葭。",
        "凭几双童静，登楼万井斜。",
        "政成知变俗，当应画轮车。"
      ],
      "author": {
        "id": 1360,
        "name": "司空曙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 347290,
      "title": "赋得的的帆向浦",
      "content": [
        "向浦参差去，随波远近还。",
        "初移芳草里，正在夕阳间。",
        "隐映回孤驿，微明出乱山。",
        "向空看不尽，归思满江关。"
      ],
      "author": {
        "id": 1360,
        "name": "司空曙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 347291,
      "title": "秋思呈尹植裴说",
      "content": [
        "静向懒相偶，年将衰共催。",
        "前途欢不集，往事恨空来。",
        "昼景委红叶，月华销绿苔。",
        "沈思竟何有，坐结玉琴哀。"
      ],
      "author": {
        "id": 1360,
        "name": "司空曙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 347292,
      "title": "闲园即事寄暕公",
      "content": [
        "欲就东林寄一身，尚怜儿女未成人。",
        "柴门客去残阳在，",
        "深山兰若何时到，羡与闲云作四邻。"
      ],
      "author": {
        "id": 1360,
        "name": "司空曙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 347293,
      "title": "题暕上人院",
      "content": [
        "闭门不出自焚香，拥褐看山岁月长。",
        "雨后绿苔生石井，",
        "更说本师同学在，几时携手见衡阳。"
      ],
      "author": {
        "id": 1360,
        "name": "司空曙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 347294,
      "title": "长安晓望寄程补阙",
      "content": [
        "迢递山河拥帝京，参差宫殿接云平。",
        "风吹晓漏经长乐，",
        "独有浅才甘未达，多惭名在鲁诸生。"
      ],
      "author": {
        "id": 1360,
        "name": "司空曙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 347295,
      "title": "下第日书情寄上叔父",
      "content": [
        "微才空觉滞京师，末学曾为叔父知。",
        "雪里题诗偏见赏，",
        "欲归江海寻山去，愿报何人得桂枝。"
      ],
      "author": {
        "id": 1360,
        "name": "司空曙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 347296,
      "title": "南原望汉宫",
      "content": [
        "荒原空有汉宫名，衰草茫茫雉堞平。",
        "连雁下时秋水在，",
        "故事悠悠不可问，寒禽野水自纵横。"
      ],
      "author": {
        "id": 1360,
        "name": "司空曙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 347297,
      "title": "早夏寄元校书",
      "content": [
        "独游野径送芳菲，高竹林居接翠微。",
        "绿岸草深虫入遍，",
        "蓬荜永无车马到，更当斋夜忆玄晖。"
      ],
      "author": {
        "id": 1360,
        "name": "司空曙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 347298,
      "title": "赠衡岳隐禅师",
      "content": [
        "拥褐安居南岳头，白云高寺见衡州。",
        "石窗湖水摇寒月，",
        "垂垂身老将传法，因下人间遂北游。"
      ],
      "author": {
        "id": 1360,
        "name": "司空曙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 347299,
      "title": "题凌云寺",
      "content": [
        "春山古寺绕沧波，石磴盘空鸟道过。",
        "百丈金身开翠壁，",
        "不与方袍同结社，下归尘世竟如何。"
      ],
      "author": {
        "id": 1360,
        "name": "司空曙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 347300,
      "title": "晦日益州北池陪宴",
      "content": [
        "临泛从公日，仙舟翠幕张。",
        "七桥通碧沼，双树接花塘。",
        "玉烛收寒气，金波隐夕光。",
        "野闻歌管思，水静绮罗香。",
        "游骑萦林远，飞桡截岸长。",
        "郊原怀灞浐，陂溠写江潢。",
        "常侍传花诏，偏裨问羽觞。",
        "岂令南岘首，千载播余芳。"
      ],
