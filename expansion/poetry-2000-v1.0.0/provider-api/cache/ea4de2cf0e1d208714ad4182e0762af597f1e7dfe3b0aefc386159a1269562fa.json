{
  "data": [
    {
      "id": 277120,
      "title": "赤壁",
      "content": [
        "折戟沈沙铁未销，自将磨洗认前朝。",
        "东风不与周郎便，铜雀春深锁二乔。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 277121,
      "title": "垂柳",
      "content": [
        "垂柳碧鬅茸，楼昏雨带容。",
        "思量成夜梦，束久废春慵。",
        "梳洗凭张敞，乘骑笑稚恭。",
        "碧虚随转笠，红烛近高舂。",
        "怨目明秋水，愁眉淡远峰。",
        "小阑花尽蝶，静院醉醒蛩。",
        "旧作琴台凤，今为药店龙。",
        "宝匳抛掷久，一任景阳钟。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 277122,
      "title": "清夜怨",
      "content": [
        "含泪坐春宵，闻君欲度辽。",
        "绿池荷叶嫩，红砌杏花娇。",
        "曙月当窗满，征云出塞遥。",
        "画楼终日闭，清管为谁调。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 277123,
      "title": "定子",
      "content": [
        "檀槽一抹广陵春，定子初开睡脸新。",
        "却笑吃虚隋炀帝，破家亡国为何人。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 277124,
      "title": "木兰花",
      "content": [
        "洞庭波冷晓侵云，日日征帆送远人。",
        "几度木兰舟上望，不知元是此花身。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 277125,
      "title": "游灵伽寺",
      "content": [
        "碧烟秋寺泛湖来，水打城根古堞摧。",
        "尽日伤心人不见，石榴花满旧琴台。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 277126,
      "title": "龙丘途中 一",
      "content": [
        "汉苑残花别，吴江盛夏来。",
        "惟看万树谷，不见一枝开。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 277127,
      "title": "龙丘途中 二",
      "content": [
        "水色饶湘浦，滩声怯建溪。",
        "泪流回月上，可得更猨蹄。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 277128,
      "title": "句",
      "content": [
        "兰膏𦶟处心犹浅，银烛烧残焰不馨。",
        "好向书生窗畔种，免教辛苦更囊萤。",
        "遥想故园陌，桃李正酣酣。",
        "头上金雀钗，腰珮翠琅玕。",
        "芦洲客雁报春来。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 301045,
      "title": "访白云山人",
      "content": [
        "瀑近悬崖屋，阴阴草木青。",
        "自言山底住，长向月中畊。",
        "晚雨无多点，初蝉第一声。",
        "煮茶归未去，刻竹为题名。",
        "（见《永乐大典》卷三○○四「九真」「人」字〖五函四十一册〗。",
        "）（周建国云此诗可信，义山另有《白云夫旧居》诗可参。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 301647,
      "title": "晋元帝庙",
      "content": [
        "青山遗庙与僧邻，断镞残碑锁暗尘。",
        "紫盖适符江左运，翠华空忆洛中春。",
        "夜台无月照珠户，秋殿有风开玉宸。",
        "弓剑神灵定何处？",
        "年年春绿上麒麟。",
        "（《浩然斋雅谈》（见《四库全书》本《浩然斋雅谈》卷中，四库馆臣注：「案此诗李商隐集不载，未详所据何本，疑姓名有误。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 301648,
      "title": "缺题",
      "content": [
        "重午云阴日正长，佳辰早至浴兰汤。",
        "凉风入座无消扇，彩索灵符映羽觞。",
        "（《锦绣花谷别集》）。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 301649,
      "title": "咏雪（句）",
      "content": [
        "郊野鹅毛满，江湖雁影空。",
        "（《合璧事类》）。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 301650,
      "title": "咏桃（句）",
      "content": [
        "酥胸酣暖日，玉脸笑春风。",
        "（《锦绣万花谷》）。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 304130,
      "title": "笋（题拟）",
      "content": [
        "昨夜春霞迸藓根，乱披烟箨出柴门。",
        "稚川龙过应回首，认得青青几代孙。",
        "（见《全芳备祖后集》卷二三）。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 304131,
      "title": "句",
      "content": [
        "斜倚绿窗□□□。",
        "（见李壁《王荆文公诗笺注》卷三五《金陵怀古》注引）。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 334455,
      "title": "相和歌辞：江南曲",
      "content": [
        "郎船安两桨，侬舸动双桡。",
        "扫黛开宫额，裁裙约楚腰。",
        "乖期方积思，临醉欲拼娇。",
        "莫以采菱唱，欲羡秦台箫。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 334499,
      "title": "相和歌辞：王昭君",
      "content": [
        "毛延寿画欲通神，忍为黄金不为人。",
        "马上琵琶行万里，汉宫长有隔生春。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 335094,
      "title": "杂曲歌辞：无愁果有愁曲",
      "content": [
        "东有青龙西白虎，中含福皇包世度。",
        "玉壶渭水笑清潭，",
        "秋娥点滴不成泪，十二玉楼无故钉。",
        "推烟唾月抛千里，",
        "日暮向风牵短丝，血凝血散今谁是。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 335273,
      "title": "杂曲歌辞：杨柳枝",
      "content": [
        "暂凭樽酒送无憀，莫损愁眉与细腰。",
        "人世死前唯有别，春风争拟惜长条。",
        "含烟惹雾每依依，万绪千条拂落晖。",
        "为报行人休尽折，半留相送半迎归。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 335344,
      "title": "杂歌谣辞：李夫人歌",
      "content": [
        "一带不结心，两股方安髻。",
        "惭愧白茅人，月没教星替。",
        "剩结茱萸枝，多擘秋莲的。",
        "独自有波光，彩囊盛不得。",
        "蛮丝系条脱，妍眼和香屑。",
        "寿宫不惜铸南人，",
        "不知瘦骨类冰井，更许夜帘通晓霜。",
        "土花漠碧云茫茫，"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359249,
      "title": "锦瑟",
      "content": [
        "锦瑟无端五十弦，一弦一柱思华年。",
        "庄生晓梦迷蝴蝶，",
        "此情可待成追忆，只是当时已惘然。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359250,
      "title": "重过圣女祠",
      "content": [
        "白石岩扉碧藓滋，上清沦谪得归迟。",
        "一春梦雨常飘瓦，",
        "玉郎会此通仙籍，忆向天阶问紫芝。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359251,
      "title": "寄罗劭兴",
      "content": [
        "棠棣黄花发，忘忧碧叶齐。",
        "人闲微病酒，燕重远兼泥。",
        "混沌何由凿，青冥未有梯。",
        "高阳旧徒侣，时复一相携。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 359252,
      "title": "令狐舍人说昨夜西掖玩月因戏赠",
      "content": [
        "昨夜玉轮明，传闻近太清。",
        "凉波冲碧瓦，晓晕落金茎。",
        "露索秦宫井，风弦汉殿筝。",
        "几时绵竹颂，拟荐子虚名。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 359254,
      "title": "自喜",
      "content": [
        "自喜蜗牛舍，相容燕子巢。",
        "绿筠遗粉箨，红药绽香苞。",
        "虎过遥知阱，鱼来且佐庖。",
        "慢行成酩酊，邻壁有松醪。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 359255,
      "title": "题僧壁",
      "content": [
        "舍生求道有前踪，乞脑剜身结愿重。",
        "大去便应欺粟颗，",
        "若信贝多真实语，三生同听一楼钟。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359256,
      "title": "霜月",
      "content": [
        "初闻征雁已无蝉，百尺楼高水接天。",
        "青女素娥俱耐冷，月中霜里斗婵娟。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 359257,
      "title": "异俗二首",
      "content": [
        "鬼疟朝朝避，春寒夜夜添。",
        "未惊雷破柱，不报水齐簷。",
        "虎箭侵肤毒，鱼钩刺骨铦。",
        "鸟言成谍诉，多是恨彤幨。",
        "户尽悬秦网，家多事越巫。",
        "未曾容獭祭，只是纵猪都。",
        "点对连鼇饵，搜求缚虎符。",
        "贾生兼事鬼，不信有洪炉。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359258,
      "title": "归墅",
      "content": [
        "行李逾南极，旬时到旧乡。",
        "楚芝应遍紫，邓橘未全黄。",
        "渠浊村舂急，旗高社酒香。",
        "故山归梦喜，先入读书堂。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 359260,
      "title": "和孙朴韦蟾孔雀咏",
      "content": [
        "此去三梁远，今来万里携。",
        "西施因网得，秦客被花迷。",
        "可在青鹦鹉，非关碧野鸡。",
        "约眉怜翠羽，刮目想金篦。",
        "瘴气笼飞远，蛮花向坐低。",
        "轻于赵皇后，贵极楚悬黎。",
        "都护矜罗幕，佳人炫绣袿。",
        "屏风临烛扣，捍拨倚香脐。",
        "旧思牵云叶，新愁待雪泥。",
        "爱堪通梦寐，画得不端倪。",
        "地锦排苍雁，帘钉镂白犀。",
        "曙霞星斗外，凉月露盘西。",
        "妒好休夸舞，经寒且少啼。",
        "红楼三十级，稳稳上丹梯。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359265,
      "title": "蝉",
      "content": [
        "本以高难饱，徒劳恨费声。",
        "五更疏欲断，一树碧无情。",
        "薄宦梗犹泛，故园芜已平。",
        "烦君最相警，我亦举家清。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 359267,
      "title": "潭州",
      "content": [
        "潭州官舍暮楼空，今古无端入望中。",
        "湘泪浅深滋竹色，",
        "目断故园人不至，松醪一醉与谁同。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359268,
      "title": "赠刘司户",
      "content": [
        "江风吹浪动云根，重碇危樯白日昏。",
        "已断燕鸿初起势，",
        "万里相逢欢复泣，凤巢西隔九重门。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359269,
      "title": "哭刘司户二首",
      "content": [
        "离居星岁易，失望死生分。",
        "酒瓮凝余桂，书签冷旧芸。",
        "江风吹雁急，山木带蝉曛。",
        "一叫千回首，天高不为闻。",
        "有美扶皇运，无谁荐直言。",
        "已为秦逐客，复作楚冤魂。",
        "湓浦应分派，荆江有会源。",
        "并将添恨泪，一洒问乾坤。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359272,
      "title": "北齐二首",
      "content": [
        "一笑相倾国便亡，何劳荆棘始堪伤。",
        "小怜玉体横陈夜，已报周师入晋阳。",
        "巧笑知堪敌万几，倾城最在著戎衣。",
        "晋阳已陷休回顾，更请君王猎一围。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 359273,
      "title": "街西池馆",
      "content": [
        "白阁他年别，朱门此夜过。",
        "疏帘留月魄，珍簟接烟波。",
        "太守三刀梦，将军一箭歌。",
        "国租容客旅，香熟玉山禾。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 359274,
      "title": "南朝",
      "content": [
        "玄武湖中玉漏催，鸡鸣埭口绣襦回。",
        "谁言琼树朝朝见，",
        "满宫学士皆颜色，江令当年只费才。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359278,
      "title": "柳",
      "content": [
        "动春何限叶，撼晓几多枝。",
        "解有相思否，应无不舞时。",
        "絮飞藏皓蝶，带弱露黄鹂。",
        "倾国宜通体，谁来独赏眉。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 359284,
      "title": "送崔玨往西川",
      "content": [
        "年少因何有旅愁，欲为东下更西游。",
        "一条雪浪吼巫峡，",
        "浣花笺纸桃花色，好好题诗咏玉钩。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359291,
      "title": "明日",
      "content": [
        "天上参旗过，人间烛焰销。",
        "谁言整双履，便是隔三桥。",
        "知处黄金锁，曾来碧绮寮。",
        "凭栏明日意，池阔雨萧萧。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 359292,
      "title": "饮席戏赠同舍",
      "content": [
        "洞中屐响省分携，不是花迷客自迷。",
        "珠树重行怜翡翠，",
        "唱尽阳关无限叠，半杯松叶冻颇黎。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359295,
      "title": "赠柳",
      "content": [
        "章台从掩映，郢路更参差。",
        "见说风流极，来当婀娜时。",
        "桥回行欲断，堤远意相随。",
        "忍放花如雪，青楼扑酒旗。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 359297,
      "title": "北禽",
      "content": [
        "为恋巴江好，无辞瘴雾蒸。",
        "纵能朝杜宇，可得值苍鹰。",
        "石小虚填海，芦铦未破矰。",
        "知来有干鹊，何不向雕陵。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 359302,
      "title": "韩碑",
      "content": [
        "元和天子神武姿，彼何人哉轩与羲。",
        "誓将上雪列圣耻，",
        "不据山河据平地，长戈利矛日可麾。",
        "帝得圣相相曰度，",
        "愬武古通作牙爪，仪曹外郎载笔随。",
        "行军司马智且勇，",
        "帝曰汝度功第一，汝从事愈宜为辞。",
        "愈拜稽首蹈且舞，",
        "当仁自古有不让，言讫屡颔天子颐。",
        "公退斋戒坐小阁，",
        "文成破体书在纸，清晨再拜铺丹墀。",
        "表曰臣愈昧死上，",
        "句奇语重喻者少，谗之天子言其私。",
        "长绳百尺拽碑倒，",
        "汤盘孔鼎有述作，今无其器存其辞。",
        "呜呼圣皇及圣相，",
        "愿书万本诵万过，口角流沫右手胝。",
        "传之七十有二代，"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359303,
      "title": "令狐八拾遗见招送裴十四归华州",
      "content": [
        "二十中郎未足希，骊驹先自有光辉。",
        "兰亭宴罢方回去，",
        "嗟予久抱临邛渴，便欲因君问钓矶。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359305,
      "title": "宿骆氏亭寄怀崔雍崔衮",
      "content": [
        "竹坞无尘水槛清，相思迢递隔重城。",
        "秋阴不散霜飞晚，留得枯荷听雨声。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 359308,
      "title": "赠歌妓二首",
      "content": [
        "水精如意玉连环，下蔡城危莫破颜。",
        "红绽樱桃含白雪，断肠声里唱阳关。",
        "白日相思可奈何，严城清夜断经过。",
        "只知解道春来瘦，不道春来独自多。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 359310,
      "title": "寄令狐学士",
      "content": [
        "秘殿崔嵬拂彩霓，曹司今在殿东西。",
        "赓歌太液翻黄鹄，",
        "钧天虽许人间听，阊阖门多梦自迷。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359311,
      "title": "酬令狐郎中见寄",
      "content": [
        "望郎临古郡，佳句洒丹青。",
        "应自丘迟宅，仍过柳恽汀。",
        "封来江渺渺，信去雨冥冥。",
        "句曲闻仙诀，临川得佛经。",
        "朝吟支客枕，夜读漱僧瓶。",
        "不见衔芦雁，空流腐草萤。",
        "土宜悲坎井，天怒识雷霆。",
        "象卉分疆近，蛟涎浸岸腥。",
        "补羸贪紫桂，负气托青萍。",
        "万里悬离抱，危于讼合铃。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359312,
      "title": "七月二十八日夜与王郑二秀才听雨后梦作",
      "content": [
        "初梦龙宫宝焰然，瑞霞明丽满晴天。",
        "旋成醉倚蓬莱树，",
        "逡巡又过潇湘雨，雨打湘灵五十弦。",
        "瞥见冯夷殊怅望，",
        "恍惚无倪明又暗，低迷不已断还连。",
        "觉来正是平阶雨，"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359314,
      "title": "漫成三首",
      "content": [
        "不妨何范尽诗家，未解当年重物华。",
        "远把龙山千里雪，将来拟并洛阳花。",
        "沈约怜何逊，延年毁谢庄。",
        "清新俱有得，名誉底相伤。",
        "雾夕咏芙蕖，何郎得意初。",
        "此时谁最赏，沈范两尚书。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359316,
      "title": "槿花二首",
      "content": [
        "燕体伤风力，鸡香积露文。",
        "殷鲜一相杂，啼笑两难分。",
        "月里宁无姊，云中亦有君。",
        "三清与仙岛，何事亦离群。",
        "珠馆熏燃久，玉房梳扫余。",
        "烧兰才作烛，襞锦不成书。",
        "本以亭亭远，翻嫌眽眽疏。",
        "回头问残照，残照更空虚。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359317,
      "title": "哭刘蕡",
      "content": [
        "上帝深宫闭九阍，巫咸不下问衔冤。",
        "广陵别后春涛隔，",
        "平生风义兼师友，不敢同君哭寝门。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359319,
      "title": "荆门西下",
      "content": [
        "一夕南风一叶危，荆云回望夏云时。",
        "人生岂得轻离别，",
        "洞庭湖阔蛟龙恶，却羡杨朱泣路岐。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359320,
      "title": "碧瓦",
      "content": [
        "碧瓦衔珠树，红轮结绮寮。",
        "无双汉殿鬓，第一楚宫腰。",
        "雾唾香难尽，珠啼冷易销。",
        "歌从雍门学，酒是蜀城烧。",
        "柳暗将翻巷，荷欹正抱桥。",
        "钿辕开道入，金管隔邻调。",
        "梦到飞魂急，书成即席遥。",
        "河流冲柱转，海沫近槎飘。",
        "吴市𧏗蛦甲，巴賨翡翠翘。",
        "他时未知意，重叠赠娇饶。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359321,
      "title": "蝶",
      "content": [
        "叶叶复翻翻，斜桥对侧门。",
        "芦花惟有白，柳絮可能温。",
        "西子寻遗殿，昭君觅故村。",
        "年年芳物尽，来别败兰荪。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 359322,
      "title": "蝇蝶鸡麝鸾凤等成篇",
      "content": [
        "韩蝶翻罗幕，曹蝇拂绮窗。",
        "斗鸡回玉勒，融麝暖金釭。",
        "玳瑁明书阁，琉璃冰酒缸。",
        "画楼多有主，鸾凤各双双。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 359326,
      "title": "杨本胜说于长安见小男阿衮",
      "content": [
        "闻君来日下，见我最娇儿。",
        "渐大啼应数，长贫学恐迟。",
        "寄人龙种瘦，失母凤雏痴。",
        "语甘休边角，青灯两鬓丝。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 359330,
      "title": "少年",
      "content": [
        "外戚平羌第一功，生年二十有重封。",
        "直登宣室螭头上，",
        "灞陵夜猎随田窦，不识寒郊自转蓬。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359332,
      "title": "玄微先生",
      "content": [
        "仙翁无定数，时入一壶藏。",
        "夜夜桂露湿，村村桃水香。",
        "醉中抛浩劫，宿处起神光。",
        "药裹丹山凤，棋函白石郎。",
        "弄河移砥柱，吞日倚扶桑。",
        "龙竹裁轻策，鲛绡熨下裳。",
        "树栽嗤汉帝，桥板笑秦王。",
        "径欲随关令，龙沙万里强。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359333,
      "title": "药转",
      "content": [
        "郁金堂北画楼东，换骨神方上药通。",
        "露气暗连青桂苑，",
        "忆事怀人兼得句，翠衾归卧绣帘中。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359336,
      "title": "岳阳楼",
      "content": [
        "汉水方城带百蛮，四邻谁道乱周班。",
        "如何一梦高唐雨，自此无心入武关。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 359337,
      "title": "越燕二首",
      "content": [
        "上国社方见，此乡秋不归。",
        "为矜皇后舞，犹著羽人衣。",
        "拂水斜纹乱，衔花片影微。",
        "卢家文杏好，试近莫愁飞。",
        "将泥红蓼岸，得草绿杨村。",
        "命侣添新意，安巢复旧痕。",
        "去应逢阿母，来莫害王孙。",
        "记取丹山凤，今为百鸟尊。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359338,
      "title": "杜工部蜀中离席",
      "content": [
        "人生何处不离群，世路干戈惜暂分。",
        "雪岭未归天外使，",
        "美酒成都堪送老，当垆仍是卓文君。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359339,
      "title": "隋宫",
      "content": [
        "紫泉宫殿锁烟霞，欲取芜城作帝家。",
        "玉玺不缘归日角，",
        "地下若逢陈后主，岂宜重问后庭花。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359340,
      "title": "二月二日",
      "content": [
        "二月二日江上行，东风日暖闻吹笙。",
        "花须柳眼各无赖，",
        "新滩莫悟游人意，更作风簷夜雨声。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359341,
      "title": "筹笔驿",
      "content": [
        "猿鸟犹疑畏简书，风云常为护储胥。",
        "徒令上将挥神笔，",
        "他年锦里经祠庙，梁父吟成恨有余。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359343,
      "title": "春日",
      "content": [
        "欲入卢家白玉堂，新春催破舞衣裳。",
        "蝶衔红蕊蜂衔粉，共助青楼一日忙。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 359345,
      "title": "风",
      "content": [
        "撩钗盘孔雀，恼带拂鸳鸯。",
        "罗荐谁教近，斋时锁洞房。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 359346,
      "title": "即日",
      "content": [
        "一岁林花即日休，江间亭下怅淹留。",
        "重吟细把真无奈，",
        "金鞍忽散银壶漏，更醉谁家白玉钩。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359347,
      "title": "九成宫",
      "content": [
        "十二层城阆苑西，平时避暑拂虹霓。",
        "云随夏后双龙尾，",
        "荔枝卢橘沾恩幸，鸾鹊天书湿紫泥。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359349,
      "title": "咏史",
      "content": [
        "历览前贤国与家，成由勤俭破由奢。",
        "何须琥珀方为枕，",
        "几人曾预南熏曲，终古苍梧哭翠华。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359351,
      "title": "无题二首",
      "content": [
        "昨夜星辰昨夜风，画楼西畔桂堂东。",
        "身无彩凤双飞翼，",
        "嗟余听鼓应官去，走马兰台类断蓬。",
        "闻道阊门萼绿华，昔年相望抵天涯。",
        "岂知一夜秦楼客，偷看吴王苑内花。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359353,
      "title": "无题四首",
      "content": [
        "来是空言去绝踪，月斜楼上五更钟。",
        "梦为远别啼难唤，",
        "刘郎已恨蓬山远，更隔蓬山一万重。",
        "飒飒东风细雨来，芙蓉塘外有轻雷。",
        "金蟾啮锁烧香入，",
        "春心莫共花争发，一寸相思一寸灰。",
        "含情春晼晚，暂见夜阑干。",
        "楼响将登怯，帘烘欲过难。",
        "多羞钗上燕，真愧镜中鸾。",
        "归去横塘晓，华星送宝鞍。",
        "何处哀筝随急管，樱花永巷垂杨岸。",
        "东家老女嫁不售，",
        "归来辗转到五更，梁间燕子闻长叹。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359354,
      "title": "赴职梓潼留别畏之员外同年",
      "content": [
        "佳兆联翩遇凤凰，雕文羽帐紫金床。",
        "桂花香处同高第，",
        "京华庸蜀三千里，送到咸阳见夕阳。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359356,
      "title": "无题",
      "content": [
        "照梁初有情，出水旧知名。",
        "裙衩芙蓉小，钗茸翡翠轻。",
        "锦长书郑重，眉细恨分明。",
        "莫近弹棋局，中心最不平。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 359357,
      "title": "蝶三首",
      "content": [
        "初来小苑中，稍与琐闱通。",
        "远恐芳尘断，轻忧艳雪融。",
        "只知防皓露，不觉逆尖风。",
        "回首双飞燕，乘时入绮栊。",
        "长眉画了绣帘开，碧玉行收白玉台。",
        "为问翠钗钗上凤，不知香颈为谁回。",
        "寿阳公主嫁时妆，八字宫眉捧额黄。",
        "见我佯羞频照影，不知身属冶游郎。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359358,
      "title": "无题二首",
      "content": [
        "八岁偷照镜，长眉已能画。",
        "十岁去踏青，芙蓉作裙衩。",
        "十二学弹筝，银甲不曾卸。",
        "十四藏六亲，悬知犹未嫁。",
        "十五泣春风，背面秋千下。",
        "幽人不倦赏，秋暑贵招邀。",
        "竹碧转怅望，池清尤寂寥。",
        "露花终裛湿，风蝶强娇饶。",
        "此地如携手，兼君不自聊。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359359,
      "title": "王十二兄与畏之员外相访见招小饮时予以悼亡日近不去因寄",
      "content": [
        "谢傅门庭旧末行，今朝歌管属檀郎。",
        "更无人处帘垂地，",
        "秋霖腹疾俱难遣，万里西风夜正长。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359361,
      "title": "落花",
      "content": [
        "高阁客竟去，小园花乱飞。",
        "参差连曲陌，迢递送斜晖。",
        "肠断未忍扫，眼穿仍欲归。",
        "芳心向春尽，所得是沾衣。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 359363,
      "title": "赠宗鲁筇竹杖",
      "content": [
        "大夏资轻策，全溪赠所思。",
        "静怜穿树远，滑想过苔迟。",
        "鹤怨朝还望，僧闲暮有期。",
        "风流真底事，常欲傍清羸。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 359365,
      "title": "曲池",
      "content": [
        "日下繁香不自持，月中流艳与谁期。",
        "迎忧急鼓疏钟断，",
        "从来此地黄昏散，未信河梁是别离。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359366,
      "title": "代应二首",
      "content": [
        "沟水分流西复东，九秋霜月五更风。",
        "离鸾别凤今何在，十二玉楼空更空。",
        "昨夜双钩败，今朝百草输。",
        "关西狂小吏，惟喝绕床卢。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359368,
      "title": "访隐者不遇成二绝",
      "content": [
        "秋水悠悠浸墅扉，梦中来数觉来稀。",
        "玄蝉去尽叶黄落，一树冬青人未归。",
        "城郭休过识者稀，哀猿啼处有柴扉。",
        "沧江白日樵渔路，日暮归来雨满衣。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 359375,
      "title": "过招国李家南园二首",
      "content": [
        "潘岳无妻客为愁，新人来坐旧妆楼。",
        "春风犹自疑联句，雪絮相和飞不休。",
        "长亭岁尽雪如波，此去秦关路几多。",
        "惟有梦中相近分，卧来无睡欲如何。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 359376,
      "title": "留赠畏之",
      "content": [
        "清时无事奏明光，不遣当关报早霜。",
        "中禁词臣寻引领，",
        "空寄大罗天上事，众仙同日咏霓裳。",
        "待得郎来月已低，寒暄不道醉如泥。",
        "五更又欲向何处，骑马出门乌夜啼。",
        "户外重阴黯不开，含羞迎夜复临台。",
        "潇湘浪上有烟景，安得好风吹汝来。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359377,
      "title": "为有",
      "content": [
        "为有云屏无限娇，凤城寒尽怕春宵。",
        "无端嫁得金龟婿，辜负香衾事早朝。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 359379,
      "title": "碧城三首",
      "content": [
        "碧城十二曲阑干，犀辟尘埃玉辟寒。",
        "阆苑有书多附鹤，",
        "若是晓珠明又定，一生长对水晶盘。",
        "对影闻声已可怜，玉池荷叶正田田。",
        "不逢萧史休回首，",
        "鄂君怅望舟中夜，绣被焚香独自眠。",
        "七夕来时先有期，洞房帘箔至今垂。",
        "玉轮顾兔初生魄，",
        "武皇内传分明在，莫道人间总不知。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359380,
      "title": "对雪二首",
      "content": [
        "寒气先侵玉女扉，清光旋透省郎闱。",
        "梅花大庾岭头发，",
        "龙山万里无多远，留待行人二月归。",
        "旋扑珠帘过粉墙，轻于柳絮重于霜。",
        "已随江令夸琼树，",
        "关河冻合东西路，肠断斑骓送陆郎。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359381,
      "title": "蜂",
      "content": [
        "小苑华池烂熳通，后门前槛思无穷。",
        "宓妃腰细才胜露，",
        "青陵粉蝶休离恨，长定相逢二月中。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359383,
      "title": "赋得鸡",
      "content": [
        "稻粱犹足活诸雏，妒敌专场好自娱。",
        "可要五更惊晓梦，不辞风雪为阳乌。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 359385,
      "title": "辛未七夕",
      "content": [
        "恐是仙家好别离，故教迢递作佳期。",
        "由来碧落银河畔，",
        "岂能无意酬乌鹊，惟与蜘蛛乞巧丝。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359386,
      "title": "壬申七夕",
      "content": [
        "已驾七香车，心心待晓霞。",
        "风轻惟响佩，日薄不嫣花。",
        "桂嫩传香远，榆高送影斜。",
        "成都过卜肆，曾妒识灵槎。"
      ],
      "author": {
