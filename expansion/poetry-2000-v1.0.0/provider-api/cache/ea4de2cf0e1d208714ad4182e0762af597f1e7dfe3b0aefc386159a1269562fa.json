      }
    },
    {
      "id": 359387,
      "title": "壬申闰秋题赠乌鹊",
      "content": [
        "绕树无依月正高，邺城新泪溅云袍。",
        "几年始得逢秋闰，两度填河莫告劳。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 359388,
      "title": "端居",
      "content": [
        "远书归梦两悠悠，只有空床敌素秋。",
        "阶下青苔与红树，雨中寥落月中愁。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 359389,
      "title": "夜半",
      "content": [
        "三更三点万家眠，露欲为霜月堕烟。",
        "斗鼠上堂蝙蝠出，玉琴时动倚窗弦。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 359390,
      "title": "玉山",
      "content": [
        "玉山高与阆风齐，玉水清流不贮泥。",
        "何处更求回日驭，",
        "闻道神仙有才子，赤箫吹罢好相携。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359394,
      "title": "牡丹",
      "content": [
        "锦帏初卷卫夫人，绣被犹堆越鄂君。",
        "垂手乱翻雕玉佩，",
        "我是梦中传彩笔，欲书花叶寄朝云。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359395,
      "title": "北楼",
      "content": [
        "春物岂相干，人生只强欢。",
        "花犹曾敛夕，酒竟不知寒。",
        "异域东风湿，中华上象宽。",
        "此楼堪北望，轻命倚危栏。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
