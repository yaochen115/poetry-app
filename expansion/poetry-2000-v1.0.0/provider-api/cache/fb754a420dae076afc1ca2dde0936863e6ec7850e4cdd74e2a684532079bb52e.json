{
  "data": [
    {
      "id": 215741,
      "title": "同杨十二缑氏寺宿草酌张正民秀才见访",
      "content": [
        "契阔千里别，恻怆难具言。",
        "殷勤一宵语，愿子未即眠。",
        "空堂灯火青，旅褐借僧毡。",
        "劳劳一杯酒，不解道路寒。",
        "经年相从乐，既别亦茫然。",
        "人间事尽尔，聚散亦何叹。",
        "但悲多难身，尚获朋友欢。",
        "间关百忧中，一笑有万钱。",
        "张子年未冠，已雄群少年。",
        "巉巉坐我侧，紫眸秀双颧。",
        "壮志激衰懦，清谈破愁煎。",
        "天明即分散，奈此情悁悁。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 215742,
      "title": "初到都下供职寄黄九",
      "content": [
        "千里不相见，劳劳复何辞。",
        "不远一城中，耿耿令我思。",
        "僦舍酒家楼，推垆卷其旗。",
        "鼠壤败晨炊，守翁噪群儿。",
        "马傍挟两羸，双踵待刻移。",
        "五日长安尘，故山梦中归。",
        "何以洗我心，望君青松姿。",
        "怀情久不吐，古屋弦悲诗。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 215743,
      "title": "次韵鲁直夏日斋中",
      "content": [
        "文章惭肮脏，谈舌罢隽永。",
        "年来屏百事，但愿两耳静。",
        "黄公安禅室，不觉在市井。",
        "客来饱清风，可是徒造请。",
        "牺尊与社樗，妄计幸不幸。",
        "愿君妙观察，金门等云岭。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 215744,
      "title": "晚归寄无咎二首  其一",
      "content": [
        "雨气入古屋，薄帷生夜清。",
        "想君拥鼻坐，端学苦吟生。",
        "泥深欺我马，归卧日半楹。",
        "浩然有奇想，非子定谁评。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 215745,
      "title": "晚归寄无咎二首  其二",
      "content": [
        "屋东云移山，屋西日半壁。",
        "余天一剑清，远雨万丝白。",
        "官事痴可了，未遭官长责。",
        "惟应晁夫子，不可别顷刻。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 215746,
      "title": "送吕际秀才南归",
      "content": [
        "咽咽幽谷泉，萧萧秋竹风。",
        "岂不爱孤洁，但伤愁且穷。",
        "吕子南国秀，沧溟贮其胸。",
        "出试辄不偶，低头避儿童。",
        "离家五千里，客饭苦不丰。",
        "冷落卧寒斋，苦吟和秋虫。",
        "昨者投我诗，九叹阅未终。",
        "欲知作者心，但视读者容。",
        "文章出贫贱，此事今古同。",
        "但愿子富贵，不愿文日工。",
        "今日告我别，出门若惊鸿。",
        "各在天一方，何当复相逢。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 215747,
      "title": "西山寒溪",
      "content": [
        "兹行颇闲暇，聊此山水间。",
        "幸有所携人，臭味同一源。",
        "山溪并修涧，嘉木间蒲莲。",
        "杉松鸣古刹，始觉此溪寒。",
        "孤亭出屋背，石磴相牵攀。",
        "迎客穷道人，俯偻须眉斑。",
        "释子具粗粝，虽贫有余欢。",
        "午登西山去，路作九曲弯。",
        "山禽惯不惊，夏木秀且繁。",
        "缅怀紫髯公，奠玉祠天坛。",
        "豪强有遗韵，兴废无留观。",
        "空岩一泓泉，引予掏清甘。",
        "至人悲热恼，遗此消昏烦。",
        "我茶非世间，天上苍月团。",
        "为尔惜不得，烹瀹浇晨餐。",
        "深谷晚易阴，快雨时斑斑。",
        "但见夹道松，龙髯湿苍颜。",
        "念我亦闲人，屏居闭柴关。",
        "不使倒珠玉，济我胸中悭。",
        "之官亦漫浪，遇胜却盘桓。",
        "平生据顽钝，信命傲忧患。",
        "言归徒旅疲，就荫休征鞍。",
        "却视来时舟，一叶系荒湾。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 215748,
      "title": "送张天觉使河东席上分题得将字",
      "content": [
        "张侯蜀都秀，玉立身堂堂。",
        "手持明光节，六月登太行。",
        "三晋雄中夏，朔方临大荒。",
        "传声贤使者，父老相扶将。",
        "控弦百万户，十年废耕桑。",
        "但使把锄犂，自然息桁杨。",
        "主人延阁老，别酒泛兰觞。",
        "寄声梁谏议，欲试紫参方。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 215749,
      "title": "答仲车",
      "content": [
        "先生居山阳，时事不挂齿。",
        "读书逾五车，不肯著一字。",
        "今朝苦叹嗟，告我将老矣。",
        "我意与子殊，欲去依禅子。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 215750,
      "title": "和仲车元夜戏述",
      "content": [
        "华灯耀广陌，皎月临重城。",
        "惟我二三子，柴门通夜扃。",
        "展书对明烛，浊酒徐徐倾。",
        "峥嵘千万虑，一醉皆能平。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 215751,
      "title": "和鲁直",
      "content": [
        "济物非仆仆，功名愧无心。",
        "倚市安能美，汲泉不厌深。",
        "老人夙有尚，瓶钵好丛林。",
        "安能红尘里，徒使老骎骎。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 215752,
      "title": "书馆直舍",
      "content": [
        "紫禁断人声，蓬山转春日。",
        "楼外晚鼓传，城阴卫番出。",
        "循除撷新秀，红紫间疏密。",
        "倚天黄金阙，龙虎气鬰律。",
        "明时赋铅椠，寓直守编帙。",
        "疏闲谢裨补，岁月感飘忽。",
        "谢公山林赏，不为轩冕屈。",
        "体道无朝野，达情惭利物。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 215753,
      "title": "宣城至日谒天庆观行香呈郡僚",
      "content": [
        "溪山惨残岁，况乃值深冬。",
        "清晨率其属，肆礼凝琳宫。",
        "漠漠冒原露，凄凄隔水风。",
        "南方异气候，霜叶未全红。",
        "忽忆簪史笔，早趋辟苍龙。",
        "拜舞东阁上，佳气鬰葱葱。",
        "谈笑出右掖，交游尽英雄。",
        "老大心已矣，依然魂梦中。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 215754,
      "title": "秋日独酌怀荣子邕",
      "content": [
        "新秋一杯酒，风雨早凉天。",
        "眷言西邻友，咫尺莫能前。",
        "岂无病羸马，泥滑不胜鞭。",
        "端居何为者，落寞掩书眠。",
        "高柳飒已疏，碧草留余鲜。",
        "衰怀感徂节，客舍悲流年。",
        "孤吟谁与和，独酌还醒然。",
        "新晴野路干，期子南山边。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 215755,
      "title": "夜初凉",
      "content": [
        "庭木舞风雨，清秋来我堂。",
        "衾裯偃宵寐，灯火照新凉。",
        "昔我来清颍，庭花有晚芳。",
        "坐看桐叶暗，已近菊枝黄。",
        "岁月忽流驶，形骸变老苍。",
        "淹留应有命，通塞讵能量。",
        "寂历年华晚，优游永日长。",
        "忧时非我事，黄卷有虞唐。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 215756,
      "title": "题陆羽祠堂兼寄李援援有诗殊佳二首  其一",
      "content": [
        "陆子不可招，寥寥风月魂。",
        "空堂掩遗像，幸此配老禅。",
        "举世人浇薄，云谁知子贤。",
        "竟陵樵牧地，陈迹岂复存。",
        "我欲歌子诗，三叹抚无弦。",
        "瓦登荐秋菊，酌此石井泉。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 215757,
      "title": "题陆羽祠堂兼寄李援援有诗殊佳二首  其二",
      "content": [
        "清诗吊陆子，味若堂下泉。",
        "陆子骨已朽，青松代之言。",
        "松亦安能言，风至时萧然。",
        "至谈非牙舌，陆子意已传。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 215758,
      "title": "万松亭有感",
      "content": [
        "微雨湿青松，松间多好风。",
        "翠光浓欲滴，对舞千蛟龙。",
        "可惜青玉钗，道边委蒿蓬。",
        "幽人不汝弃，应有绿毛翁。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 215759,
      "title": "今旦",
      "content": [
        "今旦寒气至，晨坐进一杯。",
        "一杯未能已，三酌竟空罍。",
        "我有胸臆事，欲言谁使陪。",
        "往往中夜叹，鬰结无由开。",
        "頼此樽中君，破闷有后来。",
        "时时从之游，报我以欢咍。",
        "古国多寒肴，老妻治炮煨。",
        "谁云一日富，此价万琼瑰。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 215760,
      "title": "摘梅花数枝插小瓶中辄数日不谢吟玩不足形为小诗",
      "content": [
        "疏梅插书瓶，洁白滋媚好。",
        "微香悠然起，鼻观默自了。",
        "秀色定可怜，仙姿宁解老。",
        "禅翁心土木，对此成魔恼。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 215761,
      "title": "霜后步西园",
      "content": [
        "浓霜失暄妍，短日淡无色。",
        "回风振中园，摇落声策策。",
        "草根饥鸟啄，飞舞时啧啧。",
        "野荒无遗粒，卒岁将何食。",
        "鲜鲜西墙下，幽草弄寒碧。",
        "四时不吾欺，聊假汝顷刻。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 215762,
      "title": "冬怀三首  其一",
      "content": [
        "悲笳奏已罢，落月在西壁。",
        "卧闻中林鸟，先晓鸣啧啧。",
        "尔求亦易供，固合事安息。",
        "夜归陵旦起，何尔更劳役。",
        "乾坤扰万物，不使轻有获。",
        "无求良独难，何以休吾力。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 215763,
      "title": "冬怀三首  其二",
      "content": [
        "扬雄老不遇，寂寞玩文史。",
        "厕身虎狼间，乃卒脱其死。",
        "中恬遗外慕，独乐异众喜。",
        "但有载酒人，何用求知己。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 215764,
      "title": "冬怀三首  其三",
      "content": [
        "年来百事懒，惟乐静中趣。",
        "天寒无来客，终日常闭户。",
        "进取乏时才，穷通有天数。",
        "委身付造物，已矣随所遇。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 215765,
      "title": "感春三首  其一",
      "content": [
        "东风吹桃李，花落已满地。",
        "摇摇新柳枝，薄荫才可芘。",
        "谁云同一时，荣谢两异意。",
        "由来何足较，要之归一致。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 215766,
      "title": "感春三首  其二",
      "content": [
        "默坐不复出，浮云作朝阴。",
        "离离簷间花，随雨下故林。",
        "物色一如此，朱颜坐凋侵。",
        "自歌阳春曲，吾不待知音。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 215767,
      "title": "感春三首  其三",
      "content": [
        "午日步西园，繁花乱相照。",
        "夭夭海棠枝，顾我如欲笑。",
        "殷红点轻素，含吐皆窈窕。",
        "持赠东邻子，愿言论久要。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 215768,
      "title": "春日杂诗六首  其一",
      "content": [
        "啼鸟唤我觉，簷日行且午。",
        "累累出叶莺，庭雀鸣欲乳。",
        "妻儿病酒睡，鸡犬乐其侣。",
        "风光不我违，舍醉何有度。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 215769,
      "title": "春日杂诗六首  其二",
      "content": [
        "东风入我园，落落如急霰。",
        "感之复携酒，抚树为三叹。",
        "离离墙间草，满地不可践。",
        "阴阳本无情，荣谢欲谁怨。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 215770,
      "title": "春日杂诗六首  其三",
      "content": [
        "春晏百草秀，野花无复名。",
        "悲哉桃李阑，念此聊掇英。",
        "翩翩双飞蝶，天静午日晴。",
        "悲忧浪自苦，有酒但知倾。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 215771,
      "title": "春日杂诗六首  其四",
      "content": [
        "堂南老榆柳，清阴渐交映。",
        "飘飘风花干，渥渥雨叶盛。",
        "鸟鸣日方迟，客去门逾静。",
        "自无济世略，耿耿欲谁省。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 215772,
      "title": "春日杂诗六首  其五",
      "content": [
        "三月行复至，青春坐侵寻。",
        "飞花去寂寂，新叶来骎骎。",
        "白日照芳草，荒园乱鸣禽。",
        "朱颜任自老，安事累吾心。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 215773,
      "title": "春日杂诗六首  其六",
      "content": [
        "东风忽无情，吹我园中花。",
        "繁红与艳紫，零落委泥沙。",
        "鸣鸟亦何事，啾啾竟諠哗。",
        "须知盛已极，委弃欲谁嗟。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 215774,
      "title": "官闲",
      "content": [
        "官闲吏归早，岁晏寒欲盛。",
        "槐稀庭日多，鸟下人语静。",
        "幽花破寒色，过雁惊秋听。",
        "酒贱莫厌沽，北风行欲劲。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 215775,
      "title": "秋池",
      "content": [
        "平生落寞意，况此秋池侧。",
        "寒水静无波，衰荷委余碧。",
        "萧萧动风鬓，照影感新白。",
        "来往双浴凫，尔生真自得。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 215776,
      "title": "杂咏三首  其一",
      "content": [
        "隆中卧龙公，平昔事耕钓。",
        "无言顾同侪，高视独长啸。",
        "彼宁惜开口，顾尔非同调。",
        "何事逢玄德，曹孙一言料。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 215777,
      "title": "杂咏三首  其二",
      "content": [
        "六槐当我庭，春叶密如幄。",
        "朝来南风起，已见萎叶落。",
        "盛衰同时来，岂必待萧索。",
        "鄙哉儿女痴，倩倩情所乐。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 215778,
      "title": "杂咏三首  其三",
      "content": [
        "鸟鸣高屋上，饥顾朝求食。",
        "扰扰市井人，日夜衣食迫。",
        "岂伊理当然，或者养未得。",
        "我歌南风诗，归坐还叹息。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 215779,
      "title": "飞云",
      "content": [
        "时雨久不施，飞云作朝阴。",
        "芃芃中原麦，頼此三日霖。",
        "朝阳忽清霁，披露南山岑。",
        "虽无济物迹，膏泽在民心。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 215780,
      "title": "和应之灯蛾",
      "content": [
        "万物皆畏死，尔生何独愚。",
        "由来附炎热，鲜不丧其躯。",
        "浅浅权利客，跹跹轻薄夫。",
        "高门甚烈火，相劝以奔趋。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 215781,
      "title": "自黄州至巴河游灵岩寺观孙仲谋刑马坛相传权于此刑马祀江神遂提师伐寿春云",
      "content": [
        "乔木隔尘埃，华堂敞深僻。",
        "人静好鸟鸣，睡余疏雨滴。",
        "悲愁感萧瑟，吊古披荒寂。",
        "尚溯紫髯翁，誓师沉马璧。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 215782,
      "title": "杂诗二首  其一",
      "content": [
        "独居无与往，况此阴雨天。",
        "起来复何有，诗书散我前。",
        "偃卧一榻上，读书疲复眠。",
        "经纶负夙志，跌荡穷吾年。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 215783,
      "title": "杂诗二首  其二",
      "content": [
        "高堂断四听，鸣雨晓未止。",
        "堂空雨声大，滴滴清我耳。",
        "朝眠引幽梦，遇我同心子。",
        "谈笑未容周，梦开坐千里。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 215784,
      "title": "捣药",
      "content": [
        "指可握而足，臂可攘无他。",
        "何为勤药物，杵臼日諠哗。",
        "指臂何与人，正欲使其佳。",
        "念此惭吝生，达人其我嗟。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 215785,
      "title": "乌臼",
      "content": [
        "乌臼强知晓，𫍢𫍢鸣暗天。",
        "我事不须早，援衾且复眠。",
        "朝晖方聩聩，惨凛蔽清妍。",
        "且复待午景，负此簷间暄。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 215786,
      "title": "春林",
      "content": [
        "春林露如雨，萧萧晓花寒。",
        "引手攀高红，微香来鼻端。",
        "何以比芳洁，置之青玉盘。",
        "持归供像佛，相对淡无言。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 215787,
      "title": "华月",
      "content": [
        "华月流春宵，散我高林影。",
        "披衣步其下，爱此扫地静。",
        "吾心方浩然，万境一澄莹。",
        "徙倚玉绳低，寂寥沈远听。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 215788,
      "title": "离楚夜泊高丽馆寄杨克一甥四首  其一",
      "content": [
        "去城未五里，夜缆系衰柳。",
        "水亭暗风雨，人散闻吠狗。",
        "平生足羁旅，沉此还往久。",
        "有感不自知，凄然独回首。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 215789,
      "title": "离楚夜泊高丽馆寄杨克一甥四首  其二",
      "content": [
        "水天夕云重，不雨衣自湿。",
        "夜寒更士语，鸡唱舟子急。",
        "青黄数宿莽，苍茫暗原隰。",
        "高城亦何有，倚樯成独立。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 215790,
      "title": "离楚夜泊高丽馆寄杨克一甥四首  其三",
      "content": [
        "客去水关闭，疏灯亦复收。",
        "川鸣半夜雨，卧冷五更秋。",
        "扁舟已寒暑，冉冉真乘桴。",
        "一灯照客睡，短梦良悠悠。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 215791,
      "title": "离楚夜泊高丽馆寄杨克一甥四首  其四",
      "content": [
        "士师我自出，爽迈凌清秋。",
        "年少不饮酒，昏灯夜问囚。",
        "尔家外大父，听狱代其忧。",
        "备饥朝煮饭，驱蚊夜张帱。",
        "狱成上府时，稽颡呼张侯。",
        "恕心临缧绁，相盗以戈矛。",
        "无令市死厉，请帝号重幽。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 215792,
      "title": "三月小园花已谢独芍药盛开",
      "content": [
        "霭霭春日晚，寂寂新阴繁。",
        "千红与万紫，盛极一时阑。",
        "西堂晚芍药，百萼乘露鲜。",
        "红妆诸美人，锦绣富春妍。",
        "东风时过之，舞态低昂翻。",
        "折赠怀溱洧，感之为三叹。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 215793,
      "title": "题焦山",
      "content": [
        "焦山如伏龟，万古浸碧浪。",
        "举头北顾海，尾负金刹壮。",
        "我闻城东楼，秀色日相向。",
        "松杉数毛发，人物见下上。",
        "欲携浮丘公，据壳恣潜漾。",
        "仙风如见引，金阙或可访。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 215794,
      "title": "春日杂兴四首  其一",
      "content": [
        "桃李用事辰，鲜明夺云绮。",
        "繁华一朝去，默默惭杞梓。",
        "时徂鹰化鸠，地迁橘为枳。",
        "独有羡门生，后天犹不死。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 215795,
      "title": "春日杂兴四首  其二",
      "content": [
        "昔我游京室，交通五陵间。",
        "主客各英妙，袍马相追攀。",
        "千金具饮啜，百金顾吹弹。",
        "缨弁罗广席，当头舞交竿。",
        "鲜妆耀渌酒，锦缬生风澜。",
        "灯烛暗夜艾，士女纷相班。",
        "欢娱易徂歇，转盼如飞翰。",
        "亹亹负孤愿，离离衔永叹。",
        "山鸟窥茗饮，簷花笑蔬餐。",
        "弃捐勿重陈，事定须盖棺。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 215796,
      "title": "春日杂兴四首  其三",
      "content": [
        "客从远方来，遗我昭华管。",
        "吹之幻人心，异境生虚窾。",
        "磝磝青嶂横，决决春流满。",
        "马蹄交狭斜，车毂错平坦。",
        "士女竞芳辰，禽鱼荫修笴。",
        "依微认涕笑，凌沉见纤短。",
        "停吹欻泯灭，耽耽复空馆。",
        "灵物信所直，顾恨知音罕。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 215797,
      "title": "春日杂兴四首  其四",
      "content": [
        "潭潭故邑井，猗猗上宫兰。",
        "不食自清渫，莫服更幽闲。",
        "志士耻穷极，卷迹甘饥寒。",
        "佳辰邈良觌，触物悬悲端。",
        "入途眇回远，经岁旷音翰。",
        "岂不慕裘马，诡得非所安。",
        "蝉冕多怵迫，绳枢鲜忧患。",
        "枉寻竟何补，方枘诚独难。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 215798,
      "title": "出长夏门",
      "content": [
        "出郭心已清，青山忽相对。",
        "游人傍流水，俯仰秀色内。",
        "谁张苍玉屏，中断神斧快。",
        "清伊泻其间，银汉曳天派。",
        "参差楼观出，杳霭林麓邃。",
        "岩声答远响，水影弄空翠。",
        "同游得君子，兴与烟霞会。",
        "选胜虽自兹，高怀已尘外。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 215799,
      "title": "饭昭果寺",
      "content": [
        "飘然乘兴游，殽酒笑俗具。",
        "僧居致野饭，草草亦有趣。",
        "山僧惯迎客，煮茗新泉注。",
        "岩花得春迟，晚秀见红素。",
        "萧萧野市井，人物自来去。",
        "溪光送孤舟，石色照素树。",
        "题名扫高壁，岁月记所遇。",
        "书罢迹已陈，出门犹反顾。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 215800,
      "title": "渡伊水",
      "content": [
        "双崖若争妍，秀色日相射。",
        "游人夸水东，挥榜渡清泻。",
        "潺潺溪边风，五月自潇洒。",
        "中流望南北，河汉自天下。",
        "嗟予水乡客，尘土困蹈藉。",
        "江湖久怀归，无地税征驾。",
        "临流动长想，照影久悲咤。",
        "沧洲倘有归，功业付高谢。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 215801,
      "title": "白公祠",
      "content": [
        "斯人不可见，千古怀清风。",
        "犹想鸾凤姿，翛然山水中。",
        "空祠遗像俨，过者为肃恭。",
        "同时富贵人，泯灭知何穷。",
        "公昔得所遇，慨然屡输忠。",
        "一伤巧舌刀，泯默类瘖聋。",
        "出处竟无祸，卷舒讵知踪。",
        "被获空叹麟，不制方为龙。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 215802,
      "title": "上皇龛",
      "content": [
        "升危蹑石梯，已觉毛骨异。",
        "玄龛剖山腹，六月霜雪至。",
        "佛台磨青瑶，绀滑不留水。",
        "巍巍数天人，苍玉刻冠佩。",
        "老僧拂高崖，上有昔人字。",
        "国都已萧瑟，山泽隠遗事。",
        "西轩俯空阔，昼夜纳苍翠。",
        "卜筑莫后时，林中有余地。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 215803,
      "title": "石楼",
      "content": [
        "清溪若奔虬，八锁束其颈。",
        "奔腾去莫脱，摆掣姿骁猛。",
        "嘈嘈战风霆，万鼓助其劲。",
        "声驱石崖动，气抱晴日冷。",
        "我来怯初登，注视久乃定。",
        "悠悠山川阔，寸目罗万景。",
        "平生林野趣，疏放谢鞭警。",
        "会期山月出，一啸清夜永。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 215804,
      "title": "上方",
      "content": [
        "足蹑青玉磴，跻攀不知劳。",
        "回头瞰木杪，始觉所历高。",
        "孤鸟去灭没，奔溪深怒号。",
        "白日当画梁，青云送微飚。",
        "坐久神虑平，微凉清骨毛。",
        "但警尘垢容，俯仰近赤霄。",
        "古壁有遗字，昔人嗟寂寥。",
        "南风不知暑，古木常萧萧。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 215805,
      "title": "三龛",
      "content": [
        "万穴列岩壁，三龛独雄夸。",
        "封山凿其骨，开像俨且呀。",
        "悲哉轻人功，不计岁月赊。",
        "像成竟何补，国破荒蓬麻。",
        "悠悠清伊水，去去萦山斜。",
        "晚渚栖暝鸥，夕波战余霞。",
        "陵谷良未迁，古今如转车。",
        "应有千年鹤，归顾如咨嗟。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 215806,
      "title": "晚饭宝应",
      "content": [
        "晚风吹古栢，落照明空山。",
        "深行得宝刹，崖岭相回环。",
        "人远草木邃，境幽鱼鸟闲。",
        "道人扫华堂，延我具晚餐。",
        "斋庖野菊美，石井新泉寒。",
        "既饱陟上方，浮香出林端。",
        "平生麋鹿志，强学伏车辕。",
        "尘怀造胜绝，欲去犹三叹。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 215807,
      "title": "广化遇雨",
      "content": [
        "浮云蔽高峰，台殿延晚色。",
        "风声转谷豪，雨脚射山白。",
        "东楼瞰虚明，龙甲排松栢。",
        "萧森异人境，坐视动神魄。",
        "撞钟寺门掩，晚霁尚残滴。",
        "相携下山去，尘静马无迹。",
        "归来解鞍歇，新月如破璧。",
        "但恐桃花源，回舟已青壁。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 215808,
      "title": "寄子瞻舍人二首  其一",
      "content": [
        "皎皎连城璧，实惟天地珍。",
        "足伤曾不售，宝气终氤氲。",
        "山川媚余秀，星斗揽奇氛。",
        "终然不可掩，三浴祓埃尘。",
        "天王斋戒受，严庭具九宾。",
        "贮之黄金台，籍以九龙茵。",
        "事称忘礼厚，人谁骇其新。",
        "车轮走四方，争睹快一陈。",
        "无瑕故易伤，敛辉志乃神。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 215809,
      "title": "寄子瞻舍人二首  其二",
      "content": [
        "纷纷名利场，向背不知丑。",
        "翟公书其门，客态自如旧。",
        "势去竞诋沮，有余丐升斗。",
        "高贤少畦畛，小子多状候。",
        "退之呼字生，房相肆琴叟。",
        "事奇出意表，欲辩不及口。",
        "神明劳忠孝，福禄日方厚。",
        "防微无早计，求福常恐后。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 215810,
      "title": "赠杨念三道孚",
      "content": [
        "黄鹤楼前月，清辉千里寒。",
        "娟娟过江北，送子别长安。",
        "长安百万家，车马无时闲。",
        "中天耸观阙，四海会衣冠。",
        "怜尔薜萝子，豪华骇新观。",
        "萧萧囊中句，饥坐奏清弹。",
        "漫郎久不惬，逸思生风翰。",
        "寄声武昌鱼，欲从伧父餐。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 215811,
      "title": "晓赴秘书省有感",
      "content": [
        "桃李欲开时，长安春正好。",
        "晴空倚阊阖，朝日散驰道。",
        "云收龙蛇榜，烂烂金碧晓。",
        "清都不容尘，虎士守洒扫。",
        "家无当关警，襟袂免颠倒。",
        "何惭驱款段，吾事不须早。",
        "儒生近卜祝，本自异时好。",
        "圣朝尚文雅，诏使窥鸿宝。",
        "平生一杯酒，江海送吾老。",
        "静喧非人事，不得守怀抱。",
        "跳梁干造物，乃取镆铘诮。",
        "委怀随所遭，千叶才一笑。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 215812,
      "title": "赠无咎以既见君子云胡不喜为韵八首  其一",
      "content": [
        "平生怀想人，握手良未易。",
        "接君同舍欢，此事非此世。",
        "十年淮海梦，一笑相逢地。",
        "投分白首期，愿言何有既。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 215813,
      "title": "赠无咎以既见君子云胡不喜为韵八首  其二",
      "content": [
        "贤愚譬观形，美丑不自见。",
        "医肱待三折，剑铁要百炼。",
        "磨君古青铜，汰简寄明辨。",
        "一智出千愚，食芹敢忘献。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 215814,
      "title": "赠无咎以既见君子云胡不喜为韵八首  其三",
      "content": [
        "文风还正始，磊落有诸君。",
        "长者进后生，亦使我有闻。",
        "譬如狸与虎，偶使并称文。",
        "终然不可及，困我力空勤。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 215815,
      "title": "赠无咎以既见君子云胡不喜为韵八首  其四",
      "content": [
        "文衰东京后，特起得韩子。",
        "支撑诽笑中，久乃化而靡。",
        "籍湜既洒扫，后生始归市。",
        "垂君拯溺手，请效我一指。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 215816,
      "title": "赠无咎以既见君子云胡不喜为韵八首  其五",
      "content": [
        "诗坛李杜后，黄子擅奇勋。",
        "平生执羁靮，开府与参军。",
        "举诗秉笔徒，吟哦谩云云。",
        "安知握奇律，一字有风云。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 215817,
      "title": "赠无咎以既见君子云胡不喜为韵八首  其六",
      "content": [
        "触有羸其角，进有跋其胡。",
        "膏车秣吾马，白日在修途。",
        "虽乏亡何杯，颇多未见书。",
        "力学致事功，良田本深锄。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 215818,
      "title": "赠无咎以既见君子云胡不喜为韵八首  其七",
      "content": [
        "黄子少年时，风流胜春柳。",
        "中年一钵饭，万事寒木朽。",
        "室有僧对谈，房无妾持帚。",
        "此道人人事，谁令予独不。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 215819,
      "title": "赠无咎以既见君子云胡不喜为韵八首  其八",
      "content": [
        "南山缚虎师，肯顾世书字。",
        "扬眉哦楚喉，鼎畔倒侯喜。",
        "诗声一苍蝇，下到霹雳耳。",
        "庸庸老寻常，物外有奇伟。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 215820,
      "title": "昨夜月中一睡殊有秋色觉书所见戏呈道孚",
      "content": [
        "幽人息遥夜，四听市声寂。",
        "月华清可掬，天色绀欲滴。",
        "候虫先知秋，微响出阴壁。",
        "精荧高露湿，断续残河白。",
        "兴怀我自出，抱器方待择。",
        "感时当有作，陋巷奏金石。",
        "予方问农圃，朝市嗟扫迹。",
        "先寒戒裘褐，岁暮养老客。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 215821,
      "title": "东园",
      "content": [
        "荒园何所有，落叶与衰丛。",
        "含芳未肯吐，惟有木芙蓉。",
        "黄菊如佳人，绿萼包金茸。",
        "床随重阳酒，娱此憔悴翁。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 215822,
      "title": "次韵渊明饮酒诗  其一",
      "content": [
        "我欲常饮酒，俗事苦夺之。",
        "饮酒不得醉，何如未饮时。",
        "颠倒众讥笑，佳处正在兹。",
        "念此虽杜门，浊醪日常持。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 215823,
      "title": "次韵渊明饮酒诗  其二",
      "content": [
        "出门惮应接，俗士不多情。",
        "对酒辄拜辞，好礼以求名。",
        "嗟嗟名几何，曷足善尔生。",
        "共处一泡中，倏忽风涛惊。",
        "好饮信无补，不饮亦何成。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 215824,
      "title": "次韵渊明饮酒诗  其三",
      "content": [
        "我久喜文词，思与鸿鹄飞。",
        "老来觉非是，念昔正可悲。",
        "买金铸杜康，百拜誓归依。",
        "晋陶与康伯，九原吾与归。",
        "涉世苦不谙，多病身早衰。",
        "惟有尊中酒，不与我心违。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 215825,
      "title": "次韵渊明饮酒诗  其四",
      "content": [
        "处乐非纵情，处静非避喧。",
        "豪夸与枯槁，彼各据一偏。",
        "悠然独乐处，在我不在山。",
        "羲皇迹已远，三酌呼可还。",
        "一罇每独睡，不待宾客言。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 215826,
      "title": "次韵渊明饮酒诗  其五",
      "content": [
        "所嗜人不得，一物百非是。",
        "犹有尊中酒，道胜无敢毁。",
        "彼哉讥谤者，诳口而信耳。",
        "当忧十八隔，罚此缪语绮。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 215827,
      "title": "次韵渊明饮酒诗  其六",
      "content": [
        "自庇无一椽，道人分半宅。",
        "屋西罗古殡，寒草无人迹。",
        "累累长与少，岂复待年百。",
        "鸦飞朝树疏，虫吊宵月白。",
        "平生或不饮，至此方知惜。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 215828,
      "title": "次韵渊明饮酒诗  其七",
      "content": [
        "曹参汉贤相，掾吏亦豪英。",
        "四海付醇酒，乃真知物情。",
        "亡秦余毒烈，一洗百壶倾。",
        "和气薰醉人，金革乃不鸣。",
        "卑卑谈治道，陋矣洛阳生。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 215829,
      "title": "次韵渊明饮酒诗  其八",
      "content": [
        "种树东簷下，雨来发幽姿。",
        "微阳动九地，光彩变新枝。",
        "荣衰一以异，枯槁易神奇。",
        "消息天使然，人工徒尔为。",
        "杜门沽酒饮，高悬吾马羁。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 215830,
      "title": "次韵渊明饮酒诗  其九",
      "content": [
        "里有好事者，我往罇辄开。",
        "我亦为之尽，每往亦开怀。",
        "尚虑数见厌，动作旬月乖。",
        "今晨起苦晚，独坐见乌栖。",
        "冬温雪作雨，里巷苦多泥。",
        "且复闭门坐，开卷理多谐。",
        "谁知无言中，独往不自迷。",
        "得意复终日，弭车不复回。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 215831,
      "title": "次韵渊明饮酒诗  其一○",
      "content": [
        "弱岁慕世名，中年颇探道。",
        "世间无非苦，病死与生老。",
        "相寻无穷已，递代作荣槁。",
        "奇哉竺干书，百遍读愈好。",
        "污泥虽云浊，本不害吾宝。",
        "酒虽破浄律，吾事在律表。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 215832,
      "title": "次韵渊明饮酒诗  其一一",
      "content": [
        "昔尝罹厄疾，一卧辄逾时。",
        "念无所归咎，乃誓与酒辞。",
        "那知偶不死，持杯复饮兹。",
        "既饮辄为尽，快哉复何疑。",
        "神畅病自失，此说信不欺。",
        "药石伤天和，此方吾笑之。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 215833,
      "title": "次韵渊明饮酒诗  其一二",
      "content": [
        "世间有醉乡，百世本一境。",
        "欲游不待驾，但畏足疾醒。",
        "其乡无限界，亦不阻岩岭。",
        "阴阳无疾疠，风俗尽箕颍。",
        "君往余请从，无待宵烛炳。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 215834,
      "title": "次韵渊明饮酒诗  其一三",
      "content": [
        "酒尽辄起沽，躭然待酒至。",
        "呼儿挈樽杓，未酌兀已醉。",
        "譬如念醯醢，流液不待味。",
        "醉客失揖让，醉语少伦次。",
        "坐客皆摇头，知稀故我贵。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 215835,
      "title": "次韵渊明饮酒诗  其一四",
      "content": [
        "儿童居宛丘，里巷昔所经。",
        "重来三十年，落魄竟何成。",
        "扣门问长老，主人多已更。",
        "萧萧城南道，松柏共坟庭。",
        "念此久兴叹，游不待鸡鸣。",
        "悠然且饮酒，聊以慰平生。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 215836,
      "title": "次韵渊明饮酒诗  其一五",
      "content": [
        "岁晏霰雪集，客庭号北风。",
        "老人不复出，兀睡小斋中。",
        "忽然身且老，惜此岁时穷。",
        "一弛不再张，吾身如挂弓。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 215837,
      "title": "次韵渊明饮酒诗  其一六",
      "content": [
        "渊明酒不足，种秫犹可得。",
        "无秫酒须求，时人嘲我惑。",
        "宁当且醉酣，慎勿疑通塞。",
        "但憎独醒人，岂有禁酒国。",
        "酩酊忘对言，满引常默默。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 215838,
      "title": "次韵渊明饮酒诗  其一七",
      "content": [
        "乐天好饮者，少亦登贵仕。",
        "八年浔阳谪，学道乃忘己。",
        "与时虽寡怨，行己终有耻。",
        "抗言立朝廷，放志傲闾里。",
        "优游祸福间，出处皆可纪。",
        "乘流与偕逝，遇坎辄复止。",
        "酣歌尽百年，天理端可恃。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 215839,
      "title": "次韵渊明饮酒诗  其一八",
      "content": [
        "吾知李太白，潇洒本天真。",
        "一饮三百杯，不问漓与醇。",
        "子云亦好饮，白发事亡新。",
        "奇穷易投阁，区区赋剧秦。",
        "两贤竟谁乐，千载同埃尘。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 215840,
      "title": "次韵渊明饮酒诗  其一九",
      "content": [
        "平生自百懒，而独于酒勤。",
        "生事万缘疏，而独于酒亲。",
        "皇皇东家丘，隠者笑知津。",
        "我欲去即去，柴车不劳巾。",
        "但饮百年中，不愧饮酒人。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    }
  ],
