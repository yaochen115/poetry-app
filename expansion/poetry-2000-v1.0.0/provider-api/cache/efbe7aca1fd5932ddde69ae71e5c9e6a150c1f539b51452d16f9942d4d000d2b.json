{
  "data": [
    {
      "id": 44992,
      "title": "和昌英主簿叔社雨",
      "content": [
        "愁已春相背，诗仍债未还。",
        "雨声宜小睡，竹户且深关。",
        "梦钓鸥边雪，衰忘镜里颜。",
        "起来聊觅句，句在眼中山。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 44993,
      "title": "送谈星辰吴山人",
      "content": [
        "牙筹入手风前快，玉李行天镜里看。",
        "紫闼青规吾不梦，子言欲试故应难。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 44994,
      "title": "寒食上冢",
      "content": [
        "迳直夫何细，桥危可免扶。",
        "远山枫外淡，破屋麦边孤。",
        "宿草春风又，新阡去岁无。",
        "梨花自寒食，时节只愁予。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 44995,
      "title": "和昌英主簿叔送花",
      "content": [
        "去岁归时正牡丹，亲庭上寿撚花看。",
        "共知春好毋虚掷，更复杯深肯剩残。",
        "谁料今兹千万感，强从叔也两相宽。",
        "风颠雨急关侬事，时序撩人只暗叹。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 44996,
      "title": "和萧伯振见赠",
      "content": [
        "愁里真成日似年，嬾边觅句此何缘。",
        "雨荒山谷江西社，苔卧曹瞒台底甎。",
        "顿有珠玑开病眼，旋生羽翼欲俱仙。",
        "车斜韵险难为继，聊复酬公莫浪传。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 44997,
      "title": "春晚往永和",
      "content": [
        "春事已如许，山居殊未知。",
        "绿光风度麦，白碎日翻池。",
        "景好怀翻恶，人嬉我独悲。",
        "郊行聊著眼，兴到漫成诗。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 44998,
      "title": "轿中风翻书卷",
      "content": [
        "挟册登车强出山，展来未读眼先昏。",
        "无端又被春风妬，叶叶吹开更揭翻。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 44999,
      "title": "农家叹",
      "content": [
        "两月春霖三日晴，久寒初暖稍秧青。",
        "春工只要花迟著，愁损农家管得星。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45000,
      "title": "三江小渡",
      "content": [
        "溪水将桥不复回，小舟犹倚短篙开。",
        "交情得似山溪渡，不管风波去又来。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45001,
      "title": "薄晚绝句二首  其一",
      "content": [
        "春气吹人不作醒，病身感物底心情。",
        "斜阳也不藏人老，偏照霜髭一两茎。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45002,
      "title": "薄晚绝句二首  其二",
      "content": [
        "暂出嫌喧可得除，漫游久废未全无。",
        "路逢盐裹知城近，店有鸡声觉日晡。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45003,
      "title": "与主簿叔蔬饮联句",
      "content": [
        "蕨含春味紫如椽，酒入春风浪似山。",
        "未信乾坤非细物，小吞螺浦半杯间。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45004,
      "title": "永和遇风",
      "content": [
        "未嫌春晚不多花，只爱青原绿似瓜。",
        "剩欲开怀纳岩壑，可堪病眼著风沙。",
        "待船小立看鸥没，倚杖微吟尽帽斜。",
        "客里更无诗遣闷，不愁两鬓不成华。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 45005,
      "title": "金罂花联句",
      "content": [
        "两日风狂雨更颠，取将暖去正衣单。",
        "金罂花发关谁事，何用夜来如许寒。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45006,
      "title": "彦通叔祖约游云水寺二首  其一",
      "content": [
        "出门天色阴晴半，著雨途间进退难。",
        "知得招提在何许，只凭田父指林间。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45007,
      "title": "彦通叔祖约游云水寺二首  其二",
      "content": [
        "竹深草长绿冥冥，有路如无又断行。",
        "风亦恐吾愁寺远，殷勤隔雨送钟声。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45008,
      "title": "和昌英主簿叔久雨",
      "content": [
        "积雨今晨也解休，殷勤日脚傍花流。",
        "半明衣桁烘梅润，全为农家放麦秋。",
        "更著好风堕清句，不知何地顿闲愁。",
        "新晴佳处无人会，隔柳一声黄栗留。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 45009,
      "title": "悯旱",
      "content": [
        "鸣鸠唤雨知唤晴，水车夜啼声彻明。",
        "乖龙嬾睡未渠醒，阿香推热呼不应。",
        "下田半湿高全坼，幼秧欲焦老差碧。",
        "书生所向便四壁，卖浆逢寒步逢棘。",
        "还家浪作饱饭谋，买田三岁两无秋。",
        "一门手指百二十，万斛量不尽穷愁。",
        "小儿察我惨不乐，旋沽村酒聊相酌。",
        "更哦子美醉时歌，焉知饿死填沟壑。",
        "水车哑哑止复作。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 45010,
      "title": "和萧伯振祷雨",
      "content": [
        "云气微升又霍然，虚疑数点长三川。",
        "渚东秔稻今无雨，社曲桑麻莫问天。",
        "饿死何愁更平籴，野夫半去只荒田。",
        "未辞托命长镵柄，黄独那能支一年。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 45011,
      "title": "旱后郴寇又作",
      "content": [
        "自怜秋蝶生不早，只与夜蛩声共悲。",
        "眼边未觉天地宽，身后更用文章为。",
        "去秋今夏旱相继，淮江未浄郴江沸。",
        "饿夫相语死不愁，今年官免和籴不。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 45012,
      "title": "旱后喜雨四首  其一",
      "content": [
        "云头造次便能开，雨脚商量半欲来。",
        "旧日催诗元要雨，如今雨却索诗催。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45013,
      "title": "旱后喜雨四首  其二",
      "content": [
        "检校西畴首忍回，雨佳小恨较迟来。",
        "抄云淅玉何曾梦，只拟禾孙作粥材。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45014,
      "title": "旱后喜雨四首  其三",
      "content": [
        "竟夏兴云只苦风，入秋今雨稍宜农。",
        "怪来霹雳轰枯树，知向前山起卧龙。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45015,
      "title": "旱后喜雨四首  其四",
      "content": [
        "密洒疎飘尽自由，通宵到晓未须休。",
        "平生愁听芭蕉雨，何事今来听不愁。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45016,
      "title": "秋日见橘花二首  其一",
      "content": [
        "花浄何须艳，林深不隔香。",
        "初闻无处觅，小摘莫令长。",
        "春落秋仍发，梅兼雪未强。",
        "缥瓷汲寒甃，浅浸一枝凉。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 45017,
      "title": "秋日见橘花二首  其二",
      "content": [
        "不夜非关月，舞风也自香。",
        "著花能许细，落子不多长。",
        "玉糁开犹半，金须撚更强。",
        "得秋何恨晚，映暑却生凉。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 45018,
      "title": "题吉水余端蒙明府县门飞凫阁",
      "content": [
        "尘外尘中尽静喧，阁前阁后且山川。",
        "秋生疎雨微云处，月仄青原白鹭边。",
        "眼冷庾楼聊复此，人如叶令更差贤。",
        "从公欲往其如嬾，著句无佳莫浪传。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 45019,
      "title": "题周鲠臣浩斋",
      "content": [
        "浩翁曲肱一浩斋，焉知廊庙与蒿莱。",
        "此翁定复死不死，旧斋又新有贤子。",
        "斋前种树初如椽，如今过云欲造天。",
        "作人谁无半点气，草动风惊便心醉。",
        "回山倒海不关身，古人与我各何人。",
        "杉溪老人是翁友，拈出问渠渠领否。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 45020,
      "title": "送胡季永赴漕试",
      "content": [
        "兔目著花官样黄，冰轮飘子秋风香。",
        "谁骑瘦马踏词场，澹翁庭阶玉雪郎。",
        "天于贤佞真不省，不应阿翁有阿永。",
        "景升儿子漫谷量，未识一丁惟啗餠。",
        "阿永胸中几许书，石渠奄有仍更余。",
        "毛锥半点不籧篨，羽镞一脱无犀渠。",
        "当家衣钵更谁付，锁厅小借梯云路。",
        "澹翁严冷纵不嬉，归来膝上安文度。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 45021,
      "title": "送瀛洲先生元举叔谈命郡城",
      "content": [
        "谁遣谈天太逼真，取憎造物得辞贫。",
        "不妨小隠君平肆，戏与人间阅贵人。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45022,
      "title": "四十二叔祖母刘氏太孺人挽词",
      "content": [
        "夫人自七十，有母尚期颐。",
        "不遣千山讣，犹应一病迟。",
        "孝留天下口，身立女中师。",
        "到得君羹美，翻令颍谷悲。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 45023,
      "title": "四十九叔祖母朱氏孺人挽词",
      "content": [
        "忆哭清湘掾，诸孤未裹头。",
        "盛年能素节，凛气却清秋。",
        "眼底生刍奠，身前泛柏舟。",
        "无龄还有德，此母不应愁。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 45024,
      "title": "黄太守元授挽词二首  其一",
      "content": [
        "五马新通贵，千牛旧不全。",
        "岂渠才作祟，从古命悬天。",
        "半世风波里，清名玉雪边。",
        "诸郎俱伟器，枢属更人先。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 45025,
      "title": "黄太守元授挽词二首  其二",
      "content": [
        "我忝通家子，公如父行亲。",
        "一书虽不欠，半面遂无因。",
        "旅榇千江远，铭旌两竹新。",
        "庆门宁有此，造物岂其仁。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 45026,
      "title": "梦亡友黄世永梦中犹喜谈佛既觉感念不已因和梦李白韵以记焉二首  其一",
      "content": [
        "子在人每憎，子亡憎者恻。",
        "自吾失此友，但觉生意息。",
        "犹解梦里来，岂子余此忆。",
        "死生知有无，贤圣或未测。",
        "浑作白日看，不记夜许黑。",
        "尚怜紫鸾姿，未举先折翼。",
        "只惊玉雪容，冷面带古色。",
        "梦泪觉犹湿，悲罢喜有得。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 45027,
      "title": "梦亡友黄世永梦中犹喜谈佛既觉感念不已因和梦李白韵以记焉二首  其二",
      "content": [
        "去年客京都，子去我未至。",
        "得书不得面，安用殷勤意。",
        "犹矜各未老，相见当亦易。",
        "不知此蹉跎，交道遽云坠。",
        "一抔胡不仁，埋此经世志。",
        "弦绝谅何益，蕙叹庸不顇。",
        "吾闻佛者流，正以生作累。",
        "梦中尚微言，子岂悲世事。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 45028,
      "title": "次主簿昌英叔镊白韵",
      "content": [
        "滴尽思亲泪，犹残影吊形。",
        "眼花浑作黑，颔底更能青。",
        "少也投三赋，今焉忽一星。",
        "此生成底事，有脚不曾停。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 45029,
      "title": "次昌英主簿叔晴望韵",
      "content": [
        "秋水冬全落，寒梅暖向荣。",
        "烟林明又灭，风雁仄还平。",
        "老岂愁能避，贫非嬾不营。",
        "犹须铲千嶂，剩与放双明。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 45030,
      "title": "次出门韵",
      "content": [
        "有酒何须富，无车却好行。",
        "眼中长得句，身外岂关情。",
        "远岭寒逾瘦，干枫落更声。",
        "好怀非自閟，且道向谁倾。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 45031,
      "title": "次霜月韵",
      "content": [
        "银浦寒无浪，金星澹不芒。",
        "初看霜是月，并爱月和霜。",
        "万里除纤翳，双清作一光。",
        "诗穷只欠许，穷我未渠央。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 45032,
      "title": "同主簿叔暮立",
      "content": [
        "旋旋前山没，骎骎半臂寒。",
        "鸥归势何嬾，林近意先安。",
        "待月迟云么，烦公小立看。",
        "未知立玉笋，何似立江干。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 45033,
      "title": "晚望二首  其一",
      "content": [
        "月是小春春未生，节名大雪雪何曾。",
        "夕阳不管西山暗，只照东山八九棱。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45034,
      "title": "晚望二首  其二",
      "content": [
        "万松不掩一枫丹，烟怕山狂约住山。",
        "却被沙鸥恼人损，作行飞去略无还。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45035,
      "title": "次主簿叔晚霞",
      "content": [
        "病眼何愁未苦佳，晓看霜了晚看霞。",
        "只惊天上三冬月，那得西湖十里花。",
        "景与诗争酣未退，兴如水涌去难遮。",
        "却嫌醉墨欹倾甚，整整斜斜半似鸦。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 45036,
      "title": "次乞米韵",
      "content": [
        "鲁公尚有粥为食，卢老今无僧作邻。",
        "文字借令真可煮，吾曹从古不应贫。",
        "诗肠幸自无烟火，句眼何愁著点尘。",
        "俗子岂知贫亦好，未须容易向渠陈。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 45037,
      "title": "夜雨不寐",
      "content": [
        "雨急点不疎，瓦干声可数。",
        "滴破江湖梦，合眼无复补。",
        "更长酒力短，睡甜诗思苦。",
        "已自不成眠，如何更遭许。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 45038,
      "title": "新寒",
      "content": [
        "寒力欺谁得，知侬典却衣。",
        "暮禽差慰眼，不作一行归。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 45039,
      "title": "和罗巨济教授雪二首  其一",
      "content": [
        "天悭聊尔落，地暖未教深。",
        "犹放遥岑碧，偏鸣密竹林。",
        "似供愁里眼，小恼客边心。",
        "诗卷开还阖，清寒溢素襟。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 45040,
      "title": "和罗巨济教授雪二首  其二",
      "content": [
        "飞来须面旋，欲堕更横斜。",
        "不遣诗人嬾，惟禁酒力加。",
        "镂冰初试手，翦水便成花。",
        "谁会欧苏律，吟边别一家。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 45041,
      "title": "次主簿叔雪韵",
      "content": [
        "向来一雪亦草草，天知诗人眼未饱。",
        "相传南风为雪骨，此言未试吾不晓。",
        "昨日忽惊冬作春，暖气吹人软欲倒。",
        "惟余桃李未著花，便恐蛰虫偷出窖。",
        "南风未了却北风，一夜吹翻青玉昊。",
        "今晨冷傍笔管生，似妬吟边事幽讨。",
        "司寒作意欲再雪，冻雀求哀不容祷。",
        "令人还忆柳柳州，解道千山绝飞鸟。",
        "谁教爱雪却嫌寒，欢喜十分九烦恼。",
        "诗人冻死不足怜，冻死犹应谈雪好。",
        "寄声滕六何似休，浄尽将云为侬扫。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 45042,
      "title": "次秦少游梅韵",
      "content": [
        "南枝外槁中不槁，未叶先花笑人倒。",
        "已从寒里著诗愁，可复溪边被花恼。",
        "非渠搀出百卉前，尔许清寒谁敢早。",
        "有花无雪花只俗，有雪无梅雪何好。",
        "冷蕊不风元自香，瘦柯写月真如扫。",
        "但令一壑莳横斜，便挂竹皮为渠老。",
        "秦七苏二冰玉词，绝唱寒盟几秋草。",
        "梅边尚有句可搜，更撚衰髯仰清昊。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 45043,
      "title": "次东坡先生蜡梅韵",
      "content": [
        "梅花已自不是花，冰魂谪堕玉皇家。",
        "不餐烟火更餐蜡，化作黄姑瞒造物。",
        "后山未觉坡先知，东坡勾引后山诗。",
        "金花劝饮金荷叶，两公醉吟许孤绝。",
        "人间姚魏漫如山，令人眼暗只欲眠。",
        "此花寒香来又去，恼损诗人难觅句。",
        "月兼花影恰三人，欠个文同作墨君。",
        "吾诗无复古清越，万水千山一瓶钵。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 45044,
      "title": "次东坡先生用六一先生雪诗律令龟字二十韵旧禁玉月梨梅练絮白舞鹅鹤等字新添访戴映雪高卧啮毡之类一切禁之",
      "content": [
        "病身柴立手亦龟，不要人怜天得知。",
        "一寒度夕抵度岁，恶风更将干雨吹。",
        "作祥只解诳饥腹，催老偏工欺短髭。",
        "透屋旋生衾里铁，隔窗也送砚中澌。",
        "揽衣起看端不恶，两耳已作冻菌危。",
        "似明还暗静复响，索我黄绢挥乌丝。",
        "误喜家贫屋骤富，不道天巧人能为。",
        "忽思向来旅京国，瘦马断鞭包袖持。",
        "红金何曾梦得见，茧生脚底粟生肌。",
        "残杯冷炙自无分，不是不肯叩富儿。",
        "独立西湖望东海，海神驾雪初来时。",
        "眼花只怪失天地，风横并作翻帘帏。",
        "飞来峰在水仙国，九里松无尘土姿。",
        "只欠杖头聘欢伯，安得醉倒衣淋漓。",
        "犹遭天子呼野客，催班声里趋丹墀。",
        "如今四壁一破褐，雪花密密巾披披。",
        "诗肩浑作远岭瘦，诗思浪与春江驰。",
        "茅柴乞暖却得冷，聊复尔耳三两巵。",
        "东坡逸足电雹去，天马肯放牦牛随。",
        "君不见溧阳县里一老尉，一句曾饶韩退之。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 45045,
      "title": "丙戌上元后和昌英叔李花",
      "content": [
        "春暖何缘雪压山，香来初认李花繁。",
        "露酣月蕊苍茫外，梅与山矾伯仲间。",
        "剩雨残风底无頼，明朝后日不堪看。",
        "泥深小忍春游脚，犹遣青童去一攀。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 45046,
      "title": "又和春雨",
      "content": [
        "向来一旱鬓成丝，敢道新年雨脚垂。",
        "未必催诗真强管，端令学稼失愁思。",
        "只今且莫倾三峡，此后时须示一犁。",
        "未爱少陵红湿句，可人却是道知时。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 45047,
      "title": "和周仲容春日二绝句  其一",
      "content": [
        "春半花全退，诗人尚道迟。",
        "惟应读书苦，声调作吾伊。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 45048,
      "title": "和周仲容春日二绝句  其二",
      "content": [
        "端忧更贫病，不分又花时。",
        "只说春何好，犹堪入小诗。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 45049,
      "title": "和周仲容春日二律句  其一",
      "content": [
        "饥民日夜去，也有不荒田。",
        "旧雨仍新雨，今年胜去年。",
        "未嫌诗得瘦，只苦茗妨眠。",
        "花气薰人醉，来从若个边。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 45050,
      "title": "和周仲容春日二律句  其二",
      "content": [
        "今晨晴颇嬾，昨夜雨犹声。",
        "欲社燕先觉，半春鶑未鸣。",
        "诗非一字苦，句岂十分清。",
        "参透江西社，无灯眼亦明。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 45051,
      "title": "和王才臣",
      "content": [
        "新诗不但不饶侬，便恐阴何立下风。",
        "每与胜谈千古事，不知拨尽一炉红。",
        "生儿底巧翁何恨，得子销愁我未穷。",
        "剩欲苛留老三迳，念渠何罪亦山中。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 45052,
      "title": "得省榜见罗仲谋曾无逸策名夜归喜甚通夕不寐得二绝句  其一",
      "content": [
        "淡墨高垂两客名，夜归到晓睡难成。",
        "却缘二喜添三喜，听得黄鹂第一声。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45053,
      "title": "得省榜见罗仲谋曾无逸策名夜归喜甚通夕不寐得二绝句  其二",
      "content": [
        "两日阴晴较不常，嫩寒轻暖杂花香。",
        "今晨天色休休问，卧看红光点屋梁。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45054,
      "title": "和萧伯和韵",
      "content": [
        "桃李何忙开又零，老怀易感扫还生。",
        "略无花片经人眼，谁道春风不世情。",
        "睡去恐遭诗作祟，愁来当遣酒行成。",
        "子能觅句庸非乐，未必胸中有不平。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 45055,
      "title": "又和风雨二首  其一",
      "content": [
        "东风未得颠如许，定被春光引得颠。",
        "晚雨何妨略弹压，不应犹自借渠权。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45056,
      "title": "又和风雨二首  其二",
      "content": [
        "风风雨雨又春穷，白白朱朱已眼空。",
        "拚却老红一万点，换将新绿百千重。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45057,
      "title": "和文远叔行春",
      "content": [
        "行脚宜晴翠，看云恐夕黄。",
        "何村不花柳，此社要柴桑。",
        "一笑当谁领，同来得许忙。",
        "老怀翻作恶，不剩半分狂。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 45058,
      "title": "和子上弟春雹",
      "content": [
        "雹子何孤竹屋声，只于花事较无情。",
        "青春已在残红里，更著渠侬何似生。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45059,
      "title": "和萧伯和春兴",
      "content": [
        "只道韶华不到侬，不妨软日媚柔风。",
        "愁心自对春无味，老面可能花似红。",
        "逢著诗狂兼酒圣，又忘人厄或天穷。",
        "圣人枉索方兄价，我与贤人也一中。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 45060,
      "title": "又和闻蛙",
      "content": [
        "春来真底好，此辈政纵横。",
        "身作泥中计，声从雨后增。",
        "北人餐未惯，南食眼犹生。",
        "灰洒知虚实，于渠似可行。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 45061,
      "title": "又和二绝句  其一",
      "content": [
        "一冬寒不到深山，岂有春来更会寒。",
        "幸自趁晴行脚好，却嫌沙入破鞋间。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45062,
      "title": "又和二绝句  其二",
      "content": [
        "翦翦轻风未是轻，犹吹花片作红声。",
        "一生情重嫌春浅，老去与春无点情。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45063,
      "title": "三月三日雨作遣闷十绝句  其一",
      "content": [
        "行春莫放一日一，修禊仍逢三月三。",
        "忍遣晴光作阴雨，更将急溅涴春衫。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45064,
      "title": "三月三日雨作遣闷十绝句  其二",
      "content": [
        "出门著雨不能归，借得青蓑著片时。",
        "春染万花知了未，云偷千嶂忽何之。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45065,
      "title": "三月三日雨作遣闷十绝句  其三",
      "content": [
        "归得茅斋松竹边，看风看雨亦欣然。",
        "空簷知与阶何故，须把青苔滴似穿。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45066,
      "title": "三月三日雨作遣闷十绝句  其四",
      "content": [
        "旧与酴醾颇不疎，今春半朶未逢渠。",
        "千花一雨俱红雨，问讯孤芳小住无。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45067,
      "title": "三月三日雨作遣闷十绝句  其五",
      "content": [
        "今年春事底匆匆，雨急风颠恼得侬。",
        "不见一林如许笋，犹嫌三日向来风。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45068,
      "title": "三月三日雨作遣闷十绝句  其六",
      "content": [
        "荒余只怪不愁声，好语烦君细细听。",
        "秧早不由田父懒，蚕迟端待柘阴成。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45069,
      "title": "三月三日雨作遣闷十绝句  其七",
      "content": [
        "迟日何缘似个长，睡乡未苦怯茶枪。",
        "春风解恼诗人鼻，非叶非花只是香。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45070,
      "title": "三月三日雨作遣闷十绝句  其八",
      "content": [
        "村落寻花特地无，有花亦自只愁予。",
        "不如卧听春山雨，一阵繁声一阵疎。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45071,
      "title": "三月三日雨作遣闷十绝句  其九",
      "content": [
        "报答春光酒一巵，贫中无酒著春欺。",
        "作诗细与东风道，未必东风肯要诗。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45072,
      "title": "三月三日雨作遣闷十绝句  其一○",
      "content": [
        "却是春残景更佳，诗人须记许生涯。",
        "平田涨绿村村麦，嫩水浮红岸岸花。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45073,
      "title": "和罗武冈钦若酴醾长句",
      "content": [
        "花飞十不啻五六，青子团枝失红簇。",
        "江南桃李总成阴，不论少城与韦曲。",
        "酴醾珍重不浪开，晚堆绿云点冰玉。",
        "体薰山麝非一脐，水洗银河费千斛。",
        "滴成小蓓密于糁，乱走长条柔可束。",
        "醉眸须及月下来，破鼻细从风处触。",
        "先生未必被花恼，偶与门人暮春浴。",
        "为怜压架十万枝，小立傍边领新馥。",
        "剩拚妙语宠琼蕤，更掇清英酿酃渌。",
        "先生何得便杜门，霜鬓犹烦玉堂宿。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 45074,
      "title": "再和",
      "content": [
        "春风一夜吹滕六，旋落旋销不成簇。",
        "只余架上万天花，照影清池三两曲。",
        "江东诗仙花下饮，小摘繁枝𥮾醉玉。",
        "惊飞雪片万许点，乱落酒船百余斛。",
        "旧枝掠削自萦回，新枝奔迸无拘束。",
        "诗仙诗满云梦胸，那更相逢此花触。",
        "只愁毛颖倦驱使，一日屡向陶泓浴。",
        "两章洗尽眼底尘，个字亦带花边馥。",
        "凭谁说与柳柳州，休道一声山水渌。",
        "愿参佳句法如何，夜雨何时对床宿。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 45075,
      "title": "贺澹庵先生胡侍郎新居落成二首  其一",
      "content": [
        "清庙欹斜一笑扶，归来四壁亦元无。",
        "可怜拙计输余子，住破僧房始结庐。",
        "三迳非遥人自远，万间不恶我何须。",
        "冥搜善颂终难好，贺厦真成燕不如。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 45076,
      "title": "贺澹庵先生胡侍郎新居落成二首  其二",
      "content": [
        "眼高不肯住清都，梦绕江南水竹居。",
        "却入青原更青处，饱看黄本硬黄书。",
        "翦裁风月聊堪醉，拆洗乾坤正要渠。",
        "赐宅不应公得免，未知北第似林庐。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 45077,
      "title": "见周子充舍人叙怀",
      "content": [
        "三年再谒一番逢，两舍相望几讯通。",
        "便有好怀安得尽，不知造物底相穷。",
        "公今贫贱庸非福，我更清愁恶似公。",
        "误辱相期千载事，云泥政自未应同。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 45078,
      "title": "和易公立投赠之句",
      "content": [
        "日者论文各少年，中间岁月似风旋。",
        "老来书册惟生睡，里许生涯未苦贤。",
        "好句撩人那得嬾，胜流觅纸便争传。",
        "诗坛正欠风骚将，君合为真不用权。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 45079,
      "title": "和昌英主簿叔求潘墨",
      "content": [
        "颇怯冥搜恼藏神，却思瘗砚学元宾。",
        "墨家何以得公重，诗债又来欺我贫。",
        "镜面松身纷楚楚，金华笏样本陈陈。",
        "嬾边此宝端无用，送似草玄扬子云。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 45080,
      "title": "之永和小憩资寿寺",
      "content": [
        "石子密铺迳，竹茎疎作行。",
        "不缘憩驺仆，几失此山房。",
        "佛像看都好，林花静自香。",
        "未须清兴尽，归更借僧床。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 45081,
      "title": "过神助桥亭",
      "content": [
        "下轿浑将野店看，只惊脚底水声寒。",
        "不知竹外长江近，忽有高桅出寸竿。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45082,
      "title": "过大皋渡",
      "content": [
        "隔岸横州十里青，黄牛无数放春晴。",
        "船行非与牛相背，何事黄牛却倒行。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45083,
      "title": "至永和",
      "content": [
        "出城即便见青原，正在长江出处天。",
        "却到青原望城里，楼台些子水云边。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45084,
      "title": "自值夏小溪泛舟出大江",
      "content": [
        "放溜山溪一叶轻，山溪尽处大江横。",
        "舟中寂寂无人语，只有波声及雨声。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45085,
      "title": "和文明主簿叔见寄之韵二首  其一",
      "content": [
        "古声弹九寡，妙学足三多。",
        "十载才重见，百年当几何。",
        "入州非不肯，出伏即相过。",
        "安得看云语，金盆仄白河。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 45086,
      "title": "和文明主簿叔见寄之韵二首  其二",
      "content": [
        "黄九陈三外，诸人总解诗。",
        "甘心休作许，苦语竟何为。",
        "所向公同我，何缘样入时。",
        "从来大小阮，一笑更谁知。"
      ],
