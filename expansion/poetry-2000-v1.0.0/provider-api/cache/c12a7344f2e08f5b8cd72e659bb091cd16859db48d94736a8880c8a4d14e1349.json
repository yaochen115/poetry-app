{
  "data": [
    {
      "id": 298301,
      "title": "浣溪沙",
      "content": [
        "风压轻云贴水飞，乍晴池馆燕争泥，沈郎多病不胜衣。",
        "沙上未闻鸿雁信，竹间时听鹧鸪啼，此情惟有落花知。"
      ],
      "author": {
        "id": 8690,
        "name": "南唐嗣主李璟"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298302,
      "title": "摊破浣溪沙 一",
      "content": [
        "菡萏香销翠叶残，西风愁起绿波间。",
        "还与韶光共顦顇，不堪看。",
        "细雨梦回鸡塞远，小楼吹彻玉笙寒。",
        "多少泪珠何限恨，倚阑干。"
      ],
      "author": {
        "id": 8690,
        "name": "南唐嗣主李璟"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298303,
      "title": "摊破浣溪沙 二",
      "content": [
        "手卷真珠上玉钩，依前春恨锁重楼。",
        "风里落花谁是主，思悠悠。",
        "青鸟不传云外信，丁香空结雨中愁。",
        "回首渌波三峡暮，接天流。"
      ],
      "author": {
        "id": 8690,
        "name": "南唐嗣主李璟"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298316,
      "title": "浣溪沙 一",
      "content": [
        "红日已高三丈透，金𬬻次第添香兽，红锦地衣随步皱。",
        "佳人舞点金钗溜，酒恶时拈花蘂齅，别殿遥闻箫鼓奏。"
      ],
      "author": {
        "id": 11675,
        "name": "后主煜"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298317,
      "title": "浣溪沙 二",
      "content": [
        "转烛飘蓬一梦归，欲寻陈迹怅人非，天教心愿与身违。",
        "待月池台空逝水，荫花楼阁漫斜晖，登临不惜更霑衣。"
      ],
      "author": {
        "id": 11675,
        "name": "后主煜"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298500,
      "title": "浣溪沙 一",
      "content": [
        "拢鬓新收玉步摇，背灯初解绣裙腰，枕寒衾冷异香焦。",
        "深院不关春寂寂，落花和雨夜迢迢，恨情残醉却无聊。"
      ],
      "author": {
        "id": 5551,
        "name": "韩偓"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298501,
      "title": "浣溪沙 二",
      "content": [
        "宿醉离愁慢髻鬟，六铢衣薄惹轻寒，慵红闷翠掩青鸾。",
        "罗韈况兼金菡萏，雪肌仍是玉琅玕，骨香腰细更沈檀。"
      ],
      "author": {
        "id": 5551,
        "name": "韩偓"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298502,
      "title": "浣溪沙",
      "content": [
        "枕障熏炉隔绣帷，二年终日苦相思，杏花明月始应知。",
        "天上人间何处去，旧欢新梦觉来时，黄昏微雨画帘垂。"
      ],
      "author": {
        "id": 7393,
        "name": "张曙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298522,
      "title": "浣溪沙 一",
      "content": [
        "清晓妆成寒食天，柳毬斜袅间花钿，卷帘直出画堂前。",
        "指点牡丹初绽朵，日高犹自凭朱阑，含嚬不语恨春残。"
      ],
      "author": {
        "id": 6755,
        "name": "韦庄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298523,
      "title": "浣溪沙 二",
      "content": [
        "欲上秋千四体慵，拟交人送又心忪，画堂帘幕月明风。",
        "此夜有情谁不极，隔墙梨雪又玲珑，玉容憔悴惹微红。"
      ],
      "author": {
        "id": 6755,
        "name": "韦庄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298524,
      "title": "浣溪沙 三",
      "content": [
        "惆怅梦余山月斜，孤灯照壁背红纱，小楼高阁谢娘家。",
        "暗想玉容何所似，一枝春雪冻梅花，满身香雾簇朝霞。"
      ],
      "author": {
        "id": 6755,
        "name": "韦庄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298525,
      "title": "浣溪沙 四",
      "content": [
        "绿树藏莺莺正啼，柳丝斜拂白铜鞮，弄珠江上草萋萋。",
        "日暮饮归何处客，绣鞍骢马一声嘶，满身兰麝醉如泥。"
      ],
      "author": {
        "id": 6755,
        "name": "韦庄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298526,
      "title": "浣溪沙 五",
      "content": [
        "夜夜相思更漏残，伤心明月凭阑干，想君思我锦衾寒。",
        "咫尺画堂深似海，忆来惟把旧书看，几时携手入长安。"
      ],
      "author": {
        "id": 6755,
        "name": "韦庄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298597,
      "title": "浣溪沙",
      "content": [
        "七夕年年信不违，银河清浅白云微，蟾光鹊影伯劳飞。",
        "每恨蟪蛄怜婺女，几回娇妒下鸳机，今宵嘉会两依依。"
      ],
      "author": {
        "id": 6339,
        "name": "毛文锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298598,
      "title": "摊破浣溪沙",
      "content": [
        "春水轻波浸绿苔，枇杷洲上紫檀开。",
        "晴日眠沙㶉𫛶稳，暖相偎。",
        "罗韈生尘游女过，有人逢著弄珠回。",
        "兰麝飘香初解佩，忘归来。"
      ],
      "author": {
        "id": 6339,
        "name": "毛文锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298657,
      "title": "浣溪沙 一",
      "content": [
        "红蓼渡头秋正雨，印沙鸥迹自成行，整鬟飘袖野风香。",
        "不语含嚬深浦里，几回愁煞櫂船郎，燕归帆尽水茫茫。"
      ],
      "author": {
        "id": 8953,
        "name": "薛昭蕴"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298658,
      "title": "浣溪沙 二",
      "content": [
        "钿匣菱花锦带垂，静临兰槛卸头时，约鬟低珥算归期。",
        "花茂草青湘渚阔，梦余空有漏依依，二年终日损芳菲。"
      ],
      "author": {
        "id": 8953,
        "name": "薛昭蕴"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298659,
      "title": "浣溪沙 三",
      "content": [
        "粉上依稀有泪痕，郡庭花落欲黄昏，远情深恨与谁论。",
        "记得去年寒食日，延秋门外卓金轮，日斜人散暗销魂。"
      ],
      "author": {
        "id": 8953,
        "name": "薛昭蕴"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298660,
      "title": "浣溪沙 四",
      "content": [
        "握手河桥柳似金，蜂须轻惹百花心，蕙风兰思寄清琴。",
        "意满便同春水满，情深还似酒杯深，楚烟湘月两沈沈。"
      ],
      "author": {
        "id": 8953,
        "name": "薛昭蕴"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298661,
      "title": "浣溪沙 五",
      "content": [
        "帘外三间出寺墙，满街垂柳绿阴长，嫩红轻翠间浓妆。",
        "瞥地见时犹可可，却来闲处暗思量，如今情事隔仙乡。"
      ],
      "author": {
        "id": 8953,
        "name": "薛昭蕴"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298662,
      "title": "浣溪沙 六",
      "content": [
        "江馆清秋缆客船，故人相送夜开筵，麝烟兰燄簇花钿。",
        "正是断魂迷楚雨，不堪离恨咽湘弦，月高霜白水连天。"
      ],
      "author": {
        "id": 8953,
        "name": "薛昭蕴"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298663,
      "title": "浣溪沙 七",
      "content": [
        "倾国倾城恨有余，几多红泪泣姑苏，倚风凝睇雪肌肤。",
        "吴主山河空落日，越王宫殿半平芜，藕花菱蔓满平湖。"
      ],
      "author": {
        "id": 8953,
        "name": "薛昭蕴"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298664,
      "title": "浣溪沙 八",
      "content": [
        "越女淘金春水上，步摇云鬓佩鸣珰，渚风江草又清香。",
        "不为远山凝翠黛，只应含恨向斜阳，碧桃花谢忆刘郎。"
      ],
      "author": {
        "id": 8953,
        "name": "薛昭蕴"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298699,
      "title": "浣溪沙 一",
      "content": [
        "春色迷人恨正赊，可堪荡子不还家，细风轻露著梨花。",
        "帘外有情双燕飏，槛前无力绿杨斜，小屏狂梦极天涯。"
      ],
      "author": {
        "id": 12325,
        "name": "顾敻"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298700,
      "title": "浣溪沙 二",
      "content": [
        "红藕香寒翠渚平，月笼虚阁夜蛩清，塞鸿惊梦两牵情。",
        "宝帐玉炉残麝冷，罗衣金缕暗尘生，小窗孤烛泪纵横。"
      ],
      "author": {
        "id": 12325,
        "name": "顾敻"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298701,
      "title": "浣溪沙 三",
      "content": [
        "荷芰风轻帘幕香，绣衣㶉𫛶泳回塘，小屏闲掩旧潇湘。",
        "恨入空帏鸾影独，泪凝双脸渚莲光，薄情年少悔思量。"
      ],
      "author": {
        "id": 12325,
        "name": "顾敻"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298702,
      "title": "浣溪沙 四",
      "content": [
        "惆怅经年别谢娘，月窗花院好风光，此时相望最情伤。",
        "青鸟不来传锦字，瑶姬何处锁兰房，忍教魂梦两茫茫。"
      ],
      "author": {
        "id": 12325,
        "name": "顾敻"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298703,
      "title": "浣溪沙 五",
      "content": [
        "庭菊飘黄玉露浓，冷莎偎砌隐鸣蛩，何期良夜得相逢。",
        "背帐风摇红蜡滴，惹香煖梦绣衾重，觉来枕上怯晨钟。"
      ],
      "author": {
        "id": 12325,
        "name": "顾敻"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298704,
      "title": "浣溪沙 六",
      "content": [
        "云澹风高叶乱飞，小庭寒雨绿苔微，深闺人静掩屏帷。",
        "粉黛暗愁金带枕，鸳鸯空绕画罗衣，那堪孤负不思归。"
      ],
      "author": {
        "id": 12325,
        "name": "顾敻"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298705,
      "title": "浣溪沙 七",
      "content": [
        "鴈响遥天玉漏清，小纱窗外月胧明，翠帏金鸭炷香平。",
        "何处不归音信断，良宵空使梦魂惊，簟凉枕冷不胜情。"
      ],
      "author": {
        "id": 12325,
        "name": "顾敻"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298706,
      "title": "浣溪沙 八",
      "content": [
        "露白蟾明又到秋，佳期幽会两悠悠，梦牵情役几时休。",
        "记得泥人微歛黛，无言斜倚小书楼，暗思前事不胜愁。"
      ],
      "author": {
        "id": 12325,
        "name": "顾敻"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298778,
      "title": "浣溪沙 一",
      "content": [
        "春暮黄莺下砌前，水精帘影露珠悬，绮霞低映晚晴天。",
        "弱柳万条垂翠带，残红满地碎香钿，蕙风飘荡散轻烟。"
      ],
      "author": {
        "id": 13554,
        "name": "毛熙震"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298779,
      "title": "浣溪沙 二",
      "content": [
        "花榭香红烟景迷，满庭芳草绿萋萋，金铺闲掩绣帘底。",
        "紫燕一双娇语碎，翠屏十二晚峰齐，梦魂消散醉空闺。"
      ],
      "author": {
        "id": 13554,
        "name": "毛熙震"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298780,
      "title": "浣溪沙 三",
      "content": [
        "晚起红房醉欲消，绿鬟云散袅金翘，雪香花语不胜娇。",
        "好是向人柔弱处，玉纤时急绣帬腰，春心牵惹转无憀。"
      ],
      "author": {
        "id": 13554,
        "name": "毛熙震"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298781,
      "title": "浣溪沙 四",
      "content": [
        "一只横钗坠髻丛，静眠珍簟起来慵，绣罗红嫩抹苏胸。",
        "羞歛细蛾魂暗断，因迷无语思犹浓，小屏香霭碧山重。"
      ],
      "author": {
        "id": 13554,
        "name": "毛熙震"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298782,
      "title": "浣溪沙 五",
      "content": [
        "云薄罗帬绶带长，满身新裛瑞龙香，翠钿斜映艳梅妆。",
        "佯不觑人空婉约，笑和娇语太猖狂，忍教牵恨暗形相。"
      ],
      "author": {
        "id": 13554,
        "name": "毛熙震"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298783,
      "title": "浣溪沙 六",
      "content": [
        "碧玉冠轻袅燕钗，捧心无语步香阶，缓移弓底绣罗鞋。",
        "暗想欢娱何计好，岂堪期约有时乖，日高深院正忘怀。"
      ],
      "author": {
        "id": 13554,
        "name": "毛熙震"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298784,
      "title": "浣溪沙 七",
      "content": [
        "半醉凝情卧绣茵，睡容无力卸罗裙，玉笼鹦鹉厌听闻。",
        "慵整落钗金翡翠，象梳欹鬓月生云，锦屏绡幌麝烟薰。"
      ],
      "author": {
        "id": 13554,
        "name": "毛熙震"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298829,
      "title": "浣溪沙 一",
      "content": [
        "入夏偏宜澹薄妆，越罗衣褪郁金黄，翠钿檀注助容光。",
        "相见无言还有恨，几回判却又思量，月窗香径梦悠飏。"
      ],
      "author": {
        "id": 12052,
        "name": "李珣"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298830,
      "title": "浣溪沙 二",
      "content": [
        "晚出闲庭看海棠，风流学得内家妆，小钗横戴一枝芳。",
        "镂玉梳斜云鬓腻，缕金衣透雪肌香，暗思何事立残阳。"
      ],
      "author": {
        "id": 12052,
        "name": "李珣"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298831,
      "title": "浣溪沙 三",
      "content": [
        "访旧伤离欲断魂，无因重见玉楼人，六街微雨镂香尘。",
        "早为不逢巫峡梦，那堪虚度锦江春，遇花倾酒莫辞频。"
      ],
      "author": {
        "id": 12052,
        "name": "李珣"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298832,
      "title": "浣溪沙 四",
      "content": [
        "红藕花香到槛频，可堪闲忆似花人，旧欢如梦绝音尘。"
      ],
      "author": {
        "id": 12052,
        "name": "李珣"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298885,
      "title": "浣溪沙 一",
      "content": [
        "落絮残莺半日天，玉柔花醉只思眠，惹窗映竹满炉烟。",
        "独掩画屏愁不语，斜欹瑶枕髻鬟偏，此时心在阿谁边。"
      ],
      "author": {
        "id": 7856,
        "name": "欧阳炯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298886,
      "title": "浣溪沙 二",
      "content": [
        "天碧罗衣拂地垂，美人初著更相宜，宛风如舞透香肌。",
        "独坐含嚬吹凤竹，园中缓步折花枝，有情无力泥人时。"
      ],
      "author": {
        "id": 7856,
        "name": "欧阳炯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298887,
      "title": "浣溪沙 三",
      "content": [
        "相见休言有泪珠，酒阑重得叙欢娱，凤屏鸳枕宿金铺。",
        "兰麝细香闻喘息，绮罗纤缕见肌肤，此时还恨薄情无。"
      ],
      "author": {
        "id": 7856,
        "name": "欧阳炯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298907,
      "title": "浣溪沙",
      "content": [
        "寂寞流苏冷绣茵，倚屏山枕惹香尘，小庭花露泣浓春。",
        "刘阮信非仙洞客，嫦娥终是月中人，此生无路访东邻。"
      ],
      "author": {
        "id": 3463,
        "name": "阎选"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298915,
      "title": "浣溪沙 一",
      "content": [
        "蓼岸风多橘柚香，江边一望楚天长，片帆烟际闪孤光。",
        "目送征鸿飞杳杳，思随流水去茫茫，兰红波碧忆潇湘。"
      ],
      "author": {
        "id": 12232,
        "name": "孙光宪"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298916,
      "title": "浣溪沙 二",
      "content": [
        "桃杏风香帘幕闲，谢家门户约花关，画梁幽语燕初还。",
        "绣阁数行题了壁，晓屏一枕酒醒山，却疑身是梦云间。"
      ],
      "author": {
        "id": 12232,
        "name": "孙光宪"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298917,
      "title": "浣溪沙 三",
      "content": [
        "花渐凋疎不耐风，画帘垂地晚堂空，堕阶萦藓舞愁红。",
        "腻粉半黏金靥子，残香犹煖绣薰笼，蕙心无处与人同。"
      ],
      "author": {
        "id": 12232,
        "name": "孙光宪"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298918,
      "title": "浣溪沙 四",
      "content": [
        "揽镜无言泪欲流，凝情半日嬾梳头，一庭疎雨湿春愁。",
        "杨柳祗知伤怨别，杏花应信损娇羞，泪霑魂断轸离忧。"
      ],
      "author": {
        "id": 12232,
        "name": "孙光宪"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298919,
      "title": "浣溪沙 五",
      "content": [
        "半踏长裾宛约行，晚帘疎处见分明，此时堪恨昧平生。",
        "早是[销]魂残烛影，更愁闻著品弦声，杳无消息若为情。"
      ],
      "author": {
        "id": 12232,
        "name": "孙光宪"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298920,
      "title": "浣溪沙 六",
      "content": [
        "兰沐初休曲槛前，暖风迟日洗头天，湿云新敛未梳蝉。",
        "翠袂半将遮粉臆，宝钗长欲坠香肩，此时模样不禁怜。"
      ],
      "author": {
        "id": 12232,
        "name": "孙光宪"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298921,
      "title": "浣溪沙 七",
      "content": [
        "风递残香出绣帘，团窠金凤舞襜襜，落花微雨恨相兼。",
        "何处去来狂太甚，空推宿酒睡无厌，争教人不别猜嫌。"
      ],
      "author": {
        "id": 12232,
        "name": "孙光宪"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298922,
      "title": "浣溪沙 八",
      "content": [
        "轻打银筝坠燕泥，断丝高罥画楼西，花冠闲上午墙啼。",
        "粉箨半开新竹径，红苞尽落旧桃蹊，不堪终日闭深闺。"
      ],
      "author": {
        "id": 12232,
        "name": "孙光宪"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298923,
      "title": "浣溪沙 九",
      "content": [
        "乌帽斜欹倒佩鱼，静街偷步访仙居，隔墙应认打门初。",
        "将见客时微掩敛，得人怜处且生疎，低头羞问壁边书。"
      ],
      "author": {
        "id": 12232,
        "name": "孙光宪"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298924,
      "title": "浣溪沙 十",
      "content": [
        "风撼芳菲满院香，四帘慵卷日初长，鬓云垂枕向微锽。",
        "春梦未成愁寂寂，佳期难会信茫茫。",
        "万般心，千点泪，泣兰堂。"
      ],
      "author": {
        "id": 12232,
        "name": "孙光宪"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298925,
      "title": "浣溪沙 十一",
      "content": [
        "碧玉衣裳白玉人，翠眉红脸小腰身，瑞云飞雨逐行云。",
        "除却弄珠兼解佩，便随西子与东邻，是谁容易比真真。"
      ],
      "author": {
        "id": 12232,
        "name": "孙光宪"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298926,
      "title": "浣溪沙 十二",
      "content": [
        "何事相逢不展眉，苦将情分恶猜疑，眼前行止想应知。",
        "半恨半嗔回面处，和娇和泪泥人时，万般饶得为怜伊。"
      ],
      "author": {
        "id": 12232,
        "name": "孙光宪"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298927,
      "title": "浣溪沙 十三",
      "content": [
        "落絮飞花满帝城，看看春尽又伤情，岁华频度想堪惊。",
        "风月岂惟今日恨，烟霄终待此身荣，未甘虚老负平生。"
      ],
      "author": {
        "id": 12232,
        "name": "孙光宪"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298928,
      "title": "浣溪沙 十四",
      "content": [
        "静想离愁暗泪零，欲栖云雨计难成，少年多是薄情人。"
      ],
      "author": {
        "id": 12232,
        "name": "孙光宪"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298929,
      "title": "浣溪沙 十五",
      "content": [
        "试问于谁分最多，便随人意转横波，缕金衣上小双鹅。",
        "醉后爱称娇姐姐，夜来留得好哥哥，不知情事久长么。"
      ],
      "author": {
        "id": 12232,
        "name": "孙光宪"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298930,
      "title": "浣溪沙 十六",
      "content": [
        "叶坠空阶折早秋，细烟轻雾锁妆楼，寸心双泪惨娇羞。",
        "风月但牵魂梦苦，岁华偏感别离愁，恨和相忆两难酬。"
      ],
      "author": {
        "id": 12232,
        "name": "孙光宪"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298931,
      "title": "浣溪沙 十七",
      "content": [
        "月淡风和画阁深，露桃烟柳影相侵，敛眉凝绪夜沈沈。"
      ],
      "author": {
        "id": 12232,
        "name": "孙光宪"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298932,
      "title": "浣溪沙 十八",
      "content": [
        "自入春来月夜稀，今宵蟾彩倍凝辉，强开襟抱出帘帷。",
        "囓指暗思花下约，凭阑羞覩泪痕衣，薄情狂荡几时归。"
      ],
      "author": {
        "id": 12232,
        "name": "孙光宪"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298933,
      "title": "浣溪沙 十九",
      "content": [
        "十五年来锦岸游，未曾行处不风流，好花长与万金酬。",
        "满眼利名浑信运，一生狂荡恐难休，且陪烟月醉红楼。"
      ],
      "author": {
        "id": 12232,
        "name": "孙光宪"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298993,
      "title": "浣溪沙 一",
      "content": [
        "钿毂香车过柳堤，桦烟分处马频嘶，为他沈醉不成泥。",
        "花满驿亭香露细，杜鹃声断玉蟾低，含情无语倚楼西。"
      ],
      "author": {
        "id": 645,
        "name": "张泌"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298994,
      "title": "浣溪沙 二",
      "content": [
        "马上凝情忆旧游，照花淹竹小溪流，钿筝罗幕玉搔头。",
        "早是出门长带月，可堪分袂又经秋，晚风斜日不胜愁。"
      ],
      "author": {
        "id": 645,
        "name": "张泌"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298995,
      "title": "浣溪沙 三",
      "content": [
        "独立寒堦望月华，露浓香泛小庭花，绣屏愁背一灯斜。",
        "云雨自从分散后，人间无路到仙家，但凭魂梦访天涯。"
      ],
      "author": {
        "id": 645,
        "name": "张泌"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298996,
      "title": "浣溪沙 四",
      "content": [
        "依约残眉理旧黄，翠鬟抛掷一簪长，暖风晴日罢朝妆。",
        "闲折海棠看又撚，玉纤无力惹余香，此情谁会倚斜阳。"
      ],
      "author": {
        "id": 645,
        "name": "张泌"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298997,
      "title": "浣溪沙 五",
      "content": [
        "翡翠屏开绣幄红，谢娥无力晓妆慵，锦帷鸳被宿香浓。",
        "微雨小庭春寂寞，燕飞莺语隔帘栊，杏花凝恨倚东风。"
      ],
      "author": {
        "id": 645,
        "name": "张泌"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298998,
      "title": "浣溪沙 六",
      "content": [
        "花月香寒悄夜尘，绮筵幽会暗伤神，婵娟依约画屏人。",
        "人不见时还暂语，令才抛后爱微嚬，越罗巴锦不胜春。"
      ],
      "author": {
        "id": 645,
        "name": "张泌"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298999,
      "title": "浣溪沙 七",
      "content": [
        "偏戴花冠白玉簪，睡容新起意沈吟，翠钿金缕镇眉心。",
        "小槛日斜风悄悄，隔帘零落杏花阴，断香轻碧锁愁深。"
      ],
      "author": {
        "id": 645,
        "name": "张泌"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 299000,
      "title": "浣溪沙 八",
      "content": [
        "晚逐香车入凤城，东风斜揭绣帘轻，慢回娇眼笑盈盈。",
        "消息未通何计是，便须佯醉且随行，依稀闻道太狂生。"
      ],
      "author": {
        "id": 645,
        "name": "张泌"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 299001,
      "title": "浣溪沙 九",
      "content": [
        "小市东门欲雪天，众中依约见神仙，蘂黄香画贴金蝉。",
        "饮散黄昏人草草，醉容无语立门前，马嘶尘烘一街烟。"
      ],
      "author": {
        "id": 645,
        "name": "张泌"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 312471,
      "title": "浣溪沙",
      "content": [
        "轻屉来时不破尘。",
        "石榴花映石榴裙。",
        "有情应得撞腮春。",
        "夜短更难留远梦，日高何计学行云。",
        "树深莺过静无人。"
      ],
      "author": {
        "id": 5040,
        "name": "张先"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312602,
      "title": "浣溪沙",
      "content": [
        "楼倚春江百尺高。",
        "烟中还未见归桡。",
        "几时期信似江潮。",
        "花片片飞风弄蝶，柳阴阴下水平桥。",
        "日长才过又今宵。"
      ],
      "author": {
        "id": 5040,
        "name": "张先"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312628,
      "title": "浣溪沙",
      "content": [
        "阆苑瑶台风露秋。",
        "整鬟凝思捧觥筹。",
        "欲归临别强迟留。",
        "月好谩成孤枕梦，酒阑空得两眉愁。",
        "此时情绪悔风流。"
      ],
      "author": {
        "id": 6242,
        "name": "晏殊"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312629,
      "title": "浣溪沙",
      "content": [
        "三月和风满上林。",
        "牡丹妖艳直千金。",
        "恼人天气又春阴。",
        "为我转回红脸面，向谁分付紫檀心。",
        "有情须𣨼酒杯深。"
      ],
      "author": {
        "id": 6242,
        "name": "晏殊"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312630,
      "title": "浣溪沙",
      "content": [
        "青杏园林著酒香。",
        "佳人初试薄罗裳。",
        "柳丝无力燕飞忙。",
        "乍雨乍晴花自落，闲愁闲闷日偏长。",
        "为谁消瘦减容光。"
      ],
      "author": {
        "id": 6242,
        "name": "晏殊"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312631,
      "title": "浣溪沙",
      "content": [
        "一曲新词酒一杯。",
        "去年天气旧亭台。",
        "夕阳西下几时回。",
        "无可奈何花落去，似曾相识燕归来。",
        "小园香径独徘徊。"
      ],
      "author": {
        "id": 6242,
        "name": "晏殊"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312632,
      "title": "浣溪沙",
      "content": [
        "红蓼花香夹岸稠。",
        "绿波春水向东流。",
        "小船轻舫好追游。",
        "渔父酒醒重拨棹，鸳鸯飞去却回头。",
        "一杯销尽两眉愁。"
      ],
      "author": {
        "id": 6242,
        "name": "晏殊"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312633,
      "title": "浣溪沙",
      "content": [
        "淡淡梳妆薄薄衣。",
        "天仙模样好容仪。",
        "旧欢前事入颦眉。",
        "闲役梦魂孤烛暗，恨无消息画帘垂。",
        "且留双泪说相思。"
      ],
      "author": {
        "id": 6242,
        "name": "晏殊"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312634,
      "title": "浣溪沙",
      "content": [
        "小阁重帘有燕过。",
        "晚花红片落庭莎。",
        "曲阑干影入凉波。",
        "一霎好风生翠幕，几回疏雨滴圆荷。",
        "酒醒人散得愁多。"
      ],
      "author": {
        "id": 6242,
        "name": "晏殊"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312635,
      "title": "浣溪沙",
      "content": [
        "宿酒才醒厌玉卮。",
        "水沈香冷懒熏衣。",
        "早梅先绽日边枝。",
        "寒雪寂寥初散后，春风悠扬欲来时。",
        "小屏闲放画帘垂。"
      ],
      "author": {
        "id": 6242,
        "name": "晏殊"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312636,
      "title": "浣溪沙",
      "content": [
        "绿叶红花媚晓烟。",
        "黄蜂金蕊欲披莲。",
        "水风深处懒回船。",
        "可惜异香珠箔外，不辞清唱玉尊前。",
        "使星归觐九重天。"
      ],
      "author": {
        "id": 6242,
        "name": "晏殊"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312637,
      "title": "浣溪沙",
      "content": [
        "湖上西风急暮蝉。",
        "夜来清露湿红莲。",
        "少留归骑促歌筵。",
        "为别莫辞金盏酒，入朝须近玉炉烟。",
        "不知重会是何年。"
      ],
      "author": {
        "id": 6242,
        "name": "晏殊"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312638,
      "title": "浣溪沙",
      "content": [
        "杨柳阴中驻彩旌。",
        "芰荷香里劝金觥。",
        "小词流入管弦声。",
        "只有醉饮宽别恨，不须朝暮促归程。",
        "雨条烟叶系人情。"
      ],
      "author": {
        "id": 6242,
        "name": "晏殊"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312639,
      "title": "浣溪沙",
      "content": [
        "一向年光有限身。",
        "等闲离别易消魂。",
        "酒筵歌席莫辞频。",
        "满目山河空念远，落花风雨更伤春。",
        "不如怜取眼前人。"
      ],
      "author": {
        "id": 6242,
        "name": "晏殊"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312640,
      "title": "浣溪沙",
      "content": [
        "玉碗冰寒滴露华。",
        "粉融香雪透轻纱。",
        "晚来妆面胜荷花。",
        "鬓亸欲迎眉际月，酒红初上脸边霞。",
        "一场春梦日西斜。"
      ],
      "author": {
        "id": 6242,
        "name": "晏殊"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312934,
      "title": "浣溪沙",
      "content": [
        "云曳香绵彩柱高。",
        "绛旗风飐出花梢。",
        "一梭红带往来抛。",
        "束素美人羞不打，却嫌裙慢褪纤腰。",
        "日斜深院影空摇。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312935,
      "title": "浣溪沙",
      "content": [
        "堤上游人逐画船。",
        "拍堤春水四垂天。",
        "绿杨楼外出秋千。",
        "白发戴花君莫笑，六么催拍盏频传。",
        "人生何处似尊前。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312936,
      "title": "浣溪沙",
      "content": [
        "湖上朱桥响画轮。",
        "溶溶春水浸春云。",
        "碧琉璃滑净无尘。",
        "当路游丝萦醉客，隔花啼鸟唤行人。",
        "日斜归去奈何春。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312937,
      "title": "浣溪沙",
      "content": [
        "叶底青青杏子垂。",
        "枝头薄薄柳绵飞。",
        "日高深院晚莺啼。",
        "堪恨风流成薄幸，断无消息道归期。",
        "托腮无语翠眉低。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312938,
      "title": "浣溪沙",
      "content": [
        "青杏园林著酒香。",
        "佳人初著薄罗裳。",
        "柳丝摇曳燕飞忙。",
        "乍雨乍晴花自落，闲愁闲闷昼偏长。",
        "为谁消瘦损容光。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312939,
      "title": "浣溪沙",
      "content": [
        "红粉佳人白玉杯。",
        "木兰船稳棹歌催。",
        "绿荷风里笑声来。",
        "细雨轻烟笼草树，斜桥曲水绕楼台。",
        "夕阳高处画屏开。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312940,
      "title": "浣溪沙",
      "content": [
        "翠袖娇鬟舞石州。",
        "两行红粉一时羞。",
        "新声难逐管弦愁。",
        "白发主人年未老，清时贤相望偏优。",
        "一尊风月为公留。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312941,
      "title": "浣溪沙",
      "content": [
        "灯尽垂花月似霜。",
        "薄帘映月两交光。",
        "酒醺红粉自生香。",
        "双手舞馀拖翠袖，一声歌已釂金觞。",
        "休回娇眼断人肠。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312942,
      "title": "浣溪沙",
      "content": [
        "十载相逢酒一卮。",
        "故人才见便开眉。",
        "老来游旧更同谁。",
        "浮世歌欢真易失，宦途离合信难期。",
        "尊前莫惜醉如泥。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313067,
      "title": "浣溪沙",
      "content": [
        "模样偏宜掌上怜。",
        "云如双鬓玉如颜。",
        "身材轻妙眼儿单。",
        "幽会未成双怅望，深情欲诉两艰难。",
        "空教魂梦到巫山。"
      ],
      "author": {
        "id": 11741,
        "name": "杜安世"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313068,
      "title": "浣溪沙",
      "content": [
        "横画功夫想未全。",
        "双双文彩羽仪鲜。",
        "和鸣偕老是天然。",
        "暮雨并深流细草，暖风交颈傍清涟。",
        "羡他真个好因缘。"
      ],
      "author": {
        "id": 11741,
        "name": "杜安世"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    }
  ],
