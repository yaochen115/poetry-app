{
  "data": [
    {
      "id": 339439,
      "title": "送程六",
      "content": [
        "冬夜伤离在五溪，青鱼雪落鲙橙齑。",
        "武冈前路看斜月，片片舟中云向西。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 339442,
      "title": "送柴侍御",
      "content": [
        "流水通波接武冈，送君不觉有离伤。",
        "青山一道同云雨，明月何曾是两乡。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 339444,
      "title": "送吴十九往沅陵",
      "content": [
        "沅江流水到辰阳，溪口逢君驿路长。",
        "远谪谁知望雷雨，明年春水共还乡。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 339446,
      "title": "送崔参军往龙溪",
      "content": [
        "龙溪只在龙标上，秋月孤山两相向。",
        "谴谪离心是丈夫，鸿恩共待春江涨。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 339452,
      "title": "武陵开元观黄炼师院三首",
      "content": [
        "松间白发黄尊师，童子烧香禹步时。",
        "欲访桃源入溪路，忽闻鸡犬使人疑。",
        "先贤盛说桃花源，尘忝何堪武陵郡。",
        "闻道秦时避地人，至今不与人通问。",
        "山观空虚清静门，从官役吏扰尘喧。",
        "暂因问俗到真境，便欲投诚依道源。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 376802,
      "title": "芙蓉楼送辛渐",
      "content": [
        "寒雨连江夜入吴，平明送客楚江孤。",
        "洛阳亲友如相问，一片冰心在玉壶。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 376803,
      "title": "出塞",
      "content": [
        "秦时明月汉时关，万里长征人未还。",
        "但使龙城飞将在，不教胡马度阴山。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 376804,
      "title": "塞下曲",
      "content": [
        "饮马渡秋水，水寒风似刀。",
        "平沙日未没，黯黯见临洮。",
        "昔日长城战，咸言意气高。",
        "黄尘足今古，白骨乱蓬蒿。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 376805,
      "title": "塞上曲",
      "content": [
        "蝉鸣空桑林，八月萧关道。",
        "出塞复入塞，处处共芦草。",
        "从来幽并客，皆共尘沙老。",
        "莫学游侠儿，矜夸紫骝好。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    }
  ],
