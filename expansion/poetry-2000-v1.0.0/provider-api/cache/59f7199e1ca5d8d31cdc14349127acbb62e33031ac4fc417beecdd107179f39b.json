      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267326,
      "title": "同茅郎中使君送河南裴文学",
      "content": [
        "河南有归客，江风绕行襟。",
        "送君无尘听，舞鹤清瑟音。",
        "菱蔓缀楚棹，日华正嵩岑。",
        "如何谢文学，还起会云吟。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267327,
      "title": "送李翺习之",
      "content": [
        "习之势翩翩，东南去遥遥。",
        "赠君双履足，一为上臯桥。",
        "臯桥路逶迤，碧水清风飘。",
        "新秋折藕花，应对吴语娇。",
        "千巷分渌波，四门生早潮。",
        "湖榜轻褭褭，酒旗高寥寥。",
        "小时屐齿痕，有处应未销。",
        "旧忆如雾星，怳见于梦消。",
        "言之烧人心，事去不可招。",
        "独孤宅前曲，箜篌醉中谣。",
        "壮年俱悠悠，逮兹各焦焦。",
        "执手复执手，唯道无枯凋。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267328,
      "title": "送丹霞子阮芳颜上人归山",
      "content": [
        "松色不肯秋，玉性不可柔。",
        "登山须正路，饮水须直流。",
        "倩鹤附书信，索云作衣裘。",
        "仙村莫道远，枉策招交游。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267329,
      "title": "送从舅端适楚地",
      "content": [
        "归情似泛空，飘荡楚波中。",
        "羽扇扫轻汗，布帆筛细风。",
        "江花折菡萏，岸影泊梧桐。",
        "元舅唱离别，贱生愁不穷。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267330,
      "title": "送卢汀侍御归天德幕",
      "content": [
        "仲宣领骑射，结束皆少年。",
        "匹马黄河岸，射雕清霜天。",
        "旌旗防日北，道路上云巅。",
        "古雪无销铄，新冰有堆填。",
        "清溪徒耸诮，白璧自招贤。",
        "岂比重恩者，闭门方独全。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267331,
      "title": "送草书献上人归庐山",
      "content": [
        "狂僧不为酒，狂笔自通天。",
        "将书云霞片，直至清明巅。",
        "手中飞黑电，象外泻玄泉。",
        "万物随指顾，三光为回旋。",
        "聚书云霮䨴，洗砚山晴鲜。",
        "忽怒画虵虺，喷然生风烟。",
        "江人愿停笔，惊浪恐倾船。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267332,
      "title": "和薛先辈送独孤秀才上都赴嘉会得青字",
      "content": [
        "秦云攀窈窕，楚桂搴芳馨。",
        "五色岂徒尔，万枝皆有灵。",
        "仙谣天上贵，林咏雪中青。",
        "持此一为赠，送君翔杳冥。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267333,
      "title": "送崔爽之湖南",
      "content": [
        "江与湖相通，二水洗高空。",
        "定知一日帆，使得千里风。",
        "雪唱与谁和，俗情多不通。",
        "何当逸翮纵，飞起泥沙中。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267334,
      "title": "送超上人归天台",
      "content": [
        "天台山最高，动蹑赤城霞。",
        "何以静双目，扫山除妄花。",
        "何以洁其性，滤泉去泥沙。",
        "灵境物皆直，万松无一斜。",
        "月中见心近，云外将俗赊。",
        "山兽护方丈，山猿捧袈裟。",
        "遗身独得身，笑我牵名华。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267335,
      "title": "同李益崔放送王炼师还楼观兼为群公先营山居",
      "content": [
        "十年白云士，一卷紫芝书。",
        "来结崆峒侣，还期缥缈居。",
        "霞冠遗彩翠，月帔上空虚。",
        "寄谢泉根水，清泠闲有余。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267336,
      "title": "张徐州席送岑秀才",
      "content": [
        "振振芝兰步，升自君子堂。",
        "泠泠松桂吟，生自楚客肠。",
        "羇鸟无定栖，惊蓬在他乡。",
        "去兹门馆闲，即彼道路长。",
        "雨余山川净，麦熟草木凉。",
        "楚泪滴章句，京尘染衣裳。",
        "赠君无余佗，久要不可忘。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267337,
      "title": "送黄构擢第后归江南",
      "content": [
        "澹澹沧海气，结成黄香才。",
        "幼龄思奋飞，弱冠游灵台。",
        "一鹗顾乔木，众禽不敢猜。",
        "一骥骋长衢，众兽不敢陪。",
        "遂得会风雨，感通如云雷。",
        "至矣小宗伯，确乎心不回。",
        "能令幽静人，声实喧九垓。",
        "却忆江南道，祖筵花里开。",
        "春风不能别，别罢空徘徊。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 267338,
      "title": "送道士",
      "content": [
        "千年山上行，山上无遗踪。",
        "一日人间游，六合人皆逢。",
        "自有意中侣，白寒徒相从。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267339,
      "title": "送孟寂赴举",
      "content": [
        "烈士不忧身，为君吟苦辛。",
        "男儿久失意，宝剑亦生尘。",
        "浮俗官是贵，君子道所珍。",
        "况当圣明主，岂乏证玉臣。",
        "浊水无白日，清流鉴苍旻。",
        "贤愚皎然别，结交当有因。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267340,
      "title": "同溧阳宰送孙秀才",
      "content": [
        "废瑟难为弦，南风难为歌。",
        "幽幽拙疾中，忽忽浮梦多。",
        "清韵始啸侣，雅言相与和。",
        "讼闲每往招，祖送奈若何。",
        "牵苦强为赠，邦邑光峨峨。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267341,
      "title": "溧阳唐兴寺观蔷薇花同诸公饯陈明府",
      "content": [
        "忽惊红琉璃，千艳万艳开。",
        "佛火不烧物，净香空徘徊。",
        "花下印文字，林间咏觞杯。",
        "群官饯宰官，此地车马来。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267342,
      "title": "送柳淳",
      "content": [
        "青山临黄河，下有长安道。",
        "世上名利人，相逢不知老。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 267343,
      "title": "送殷秀才南游",
      "content": [
        "诗句临离袂，酒花薰别颜。",
        "水程千里外，岸泊几宵间。",
        "风叶乱辞木，雪猿清叫山。",
        "南中多古事，咏遍始应还。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267344,
      "title": "送青阳上人游越",
      "content": [
        "秋风吹白发，微官自萧索。",
        "江僧何用叹，溪县饶寂寞。",
        "楚思物皆清，越山胜非薄。",
        "时看镜中月，独向衣上落。",
        "多谢入冥鸿，笑予在笼鹤。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267345,
      "title": "奉同朝贤送新罗使",
      "content": [
        "淼淼望远国，一萍秋海中。",
        "恩传日月外，梦在波涛东。",
        "浪兴豁胸臆，泛程舟虚空。",
        "既兹吟仗信，亦以难私躬。",
        "实怪赏不足，异鲜悦多丛。",
        "安危所系重，征役谁能穷。",
        "彼俗媚文史，圣朝富才雄。",
        "送行数百首，各以铿奇工。",
        "宂隶窃抽韵，孤属思将同。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267346,
      "title": "留弟郢不得送之江南",
      "content": [
        "刚有下水船，白日留不得。",
        "老人独自归，苦泪满眼黑。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 267347,
      "title": "送陆畅归湖州因凭题故人皎然塔陆羽坟",
      "content": [
        "淼淼霅寺前，白苹多清风。",
        "昔游诗会满，今游诗会空。",
        "孤吟玉凄恻，远思景蒙笼。",
        "杼山塼塔禅，竟陵广宵翁。",
        "饶彼草木声，髣髴闻余聪。",
        "因君寄数句，遍为书其藂。",
        "追吟当时说，来者实不穷。",
        "江调难再得，京尘徒满躬。",
        "送君溪鸳鸯，彩色双飞东。",
        "东多高静乡，芳宅冬亦崇。",
        "手自撷甘旨，供养欢冲融。",
        "待我遂前心，收拾使有终。",
        "不然洛岸亭，归死为大同。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267348,
      "title": "送淡公 一",
      "content": [
        "燕本冰雪骨，越淡莲花风。",
        "五言双宝刀，联响高飞鸿。",
        "翰苑钱舍人，诗韵铿雷公。",
        "识本未识淡，仰咏嗟无穷。",
        "清恨生物表，朗玉倾梦中。",
        "常于冷竹坐，相语道意冲。",
        "嵩洛兴不薄，稽江事难同。",
        "明年若不来，我作黄蒿翁。",
        "何以兀其心为君学虚空。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    }
  ],
