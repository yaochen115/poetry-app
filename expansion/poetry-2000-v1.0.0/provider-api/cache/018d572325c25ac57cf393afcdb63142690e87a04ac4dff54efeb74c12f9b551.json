{
  "data": [
    {
      "id": 89319,
      "title": "石假山",
      "content": [
        "潭溪散人方是闲，真山不爱爱假山。",
        "呼童积叠石磊磈，远近便拥峰与峦。",
        "晴岚滴翠明窗前，清影挂壁方池边。",
        "色侵书帙日华薄，丘壑坐上生云烟。",
        "云烟收霏苔藓绿，山石傍头更栽竹。",
        "三竿两竿韵不俗，摇荡清风凉意足。",
        "方是闲人当此时，以假像真人谓奇。",
        "或来静对酌美酒，或来宴坐哦新诗。",
        "吟诗搜索萦心脾，酒醉落魄精神痴。",
        "吟诗饮酒且不可，况复局上争枯棋。",
        "不如对山抚鸣琴，琴心三叠舞胎禽。",
        "高山流水存至音，古趣澹泊悦我心。",
        "老泉三峰烂木材，百年沉埋安在哉。",
        "东坡仇池九华石，只有佳篇传入集。",
        "此山亦犹今视昔，与我同生亦同没。"
      ],
      "author": {
        "id": 9534,
        "name": "刘学箕"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 126270,
      "title": "岑参醉落魄图",
      "content": [
        "醉里沈思世道危，不堪著眼只攒眉。",
        "空留忠愤声名在，不见招归旧日诗。"
      ],
      "author": {
        "id": 7471,
        "name": "叶茵"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 207319,
      "title": "次韵郭明叔长歌",
      "content": [
        "君不见悬车刘屯田，骑牛涧壑弄潺湲。",
        "八十唇红眼点漆，金钟举酒不留残。",
        "君不见征西徐尚书，为国捐躯矢石间。",
        "龙章凤姿委秋草，天马长辞十二闲。",
        "何如高阳郦生醉落魄，长揖辍洗惊龙颜。",
        "丈夫当年倾意气，安用蚓食而蝎跧。",
        "古人已作泉下土，风义可想犹班班。",
        "郭侯忠信如古人，荐书飞名上九关。",
        "诗书自可老斲轮，智略足以解连环。",
        "铜章屈宰山水县，友声相求不我顽。",
        "鹏翼垂天公直起，燕巢见社身思还。",
        "文思舜禹开言路，即看承诏著豸冠。",
        "尚趋手板事直指，少忍吏道之多艰。",
        "黄花零落一尊酒，别有天地非人寰。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 312527,
      "title": "醉落魄・一斛珠",
      "content": [
        "云轻柳弱。",
        "内家髻要新梳掠。",
        "生香真色人难学。",
        "横管孤吹，月淡天垂暮。",
        "朱唇浅破桃花萼。",
        "倚楼谁在阑干角。",
        "夜寒手冷罗衣薄。",
        "声入霜林，簌簌惊梅落。"
      ],
      "author": {
        "id": 5040,
        "name": "张先"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312599,
      "title": "醉落魄・一斛珠",
      "content": [
        "山围画障。",
        "风溪弄月清溶漾。",
        "玉楼苕馆人相望。",
        "下若醲醅，竞欲金钗当。",
        "使君劝醉青娥唱。",
        "分明仙曲云中响。",
        "南园百卉千家赏。",
        "和气兼春，不独花枝上。"
      ],
      "author": {
        "id": 5040,
        "name": "张先"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313545,
      "title": "醉落魄・一斛珠",
      "content": [
        "满街斜月。",
        "垂鞭自唱阳关彻。",
        "断尽柔肠思归切。",
        "都为人人，不许多时别。",
        "南桥昨夜风吹雪。",
        "短长亭下征尘歇。",
        "归时定有梅堪折。",
        "欲把离愁，细拈花枝说。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313546,
      "title": "醉落魄・一斛珠",
      "content": [
        "鸾孤月缺。",
        "两春惆怅音尘绝。",
        "如今若负当时节。",
        "信道欢缘，狂向衣襟结。",
        "若问相思何处歇。",
        "相逢便是相思彻。",
        "尽饶别后留心别。",
        "也待相逢，细把相思说。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313547,
      "title": "醉落魄・一斛珠",
      "content": [
        "天教命薄。",
        "青楼占得声名恶。",
        "对酒当歌寻思著。",
        "月户星窗，多少旧期约。",
        "相逢细语初心错。",
        "两行红泪尊前落。",
        "霞觞且共深深酌。",
        "恼乱春宵，翠被都闲却。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313548,
      "title": "醉落魄・一斛珠",
      "content": [
        "休休莫莫。",
        "离多还是因缘恶。",
        "有情无奈思量著。",
        "月夜佳期，近写青笺约。",
        "心心口口长恨昨。",
        "分飞容易当时错。",
        "后期休似前欢薄。",
        "买断青楼，莫放春闲却。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313619,
      "title": "醉落魄・一斛珠",
      "content": [
        "醉醒醒醉。",
        "凭君会取皆滋味。",
        "浓斟琥珀香浮蚁。",
        "一入愁肠，便有阳春意。",
        "须将席幕为天地。",
        "歌前起舞花前睡。",
        "从他兀兀陶陶里。",
        "犹胜醒醒，惹得闲憔悴。"
      ],
      "author": {
        "id": 2911,
        "name": "王仲甫"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313836,
      "title": "醉落魄・一斛珠",
      "content": [
        "醉醒醒醉。",
        "凭君会取这滋味。",
        "浓斟琥珀香浮蚁。",
        "一到愁肠，别有阳春意。",
        "须将幕席为天地。",
        "歌前起舞花前睡。",
        "从他落魄陶陶里。",
        "犹胜醒醒，惹得闲憔悴。"
      ],
      "author": {
        "id": 11678,
        "name": "苏轼"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313837,
      "title": "醉落魄・一斛珠",
      "content": [
        "分携如昨。",
        "人生到处萍飘泊。",
        "偶然相聚还离索。",
        "多病多愁，须信从来错。",
        "尊前一笑休辞却。",
        "天涯同是伤沦落。",
        "故山犹负平生约。",
        "西望峨嵋，长羡归飞鹤。"
      ],
      "author": {
        "id": 11678,
        "name": "苏轼"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313838,
      "title": "醉落魄・一斛珠",
      "content": [
        "苍颜华发。",
        "故山归计何时决。",
        "旧交新贵音书绝。",
        "惟有佳人，犹作殷勤别。",
        "离亭欲去歌声咽。",
        "潇潇细雨凉吹颊。",
        "泪珠不用罗巾裛。",
        "弹在罗衣，图得见时说。"
      ],
      "author": {
        "id": 11678,
        "name": "苏轼"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313839,
      "title": "醉落魄・一斛珠",
      "content": [
        "轻云微月。",
        "二更酒醒船初发。",
        "孤城回望苍烟合。",
        "公子佳人，不记归时节。",
        "巾偏扇坠藤床滑。",
        "觉来幽梦无人说。",
        "此生飘荡何时歇。",
        "家在西南，长作东南别。"
      ],
      "author": {
        "id": 11678,
        "name": "苏轼"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314255,
      "title": "醉落魄・一斛珠",
      "content": [
        "春城胜绝。",
        "暮林风舞催花发。",
        "垂云卷尽添空阔。",
        "吹上新年，美满十分月。",
        "红蕖影下勾丝抹。",
        "老来牵强随时节。",
        "无人知道心情别。",
        "唯有蛾儿，惊见鬓边雪。"
      ],
      "author": {
        "id": 9909,
        "name": "范成大"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314265,
      "title": "醉落魄・一斛珠",
      "content": [
        "马蹄尘扑。",
        "春风得意笙歌逐。",
        "款门不问谁家竹。",
        "只拣红装，高处烧银烛。",
        "碧鸡坊里花如屋。",
        "燕王宫下花成谷。",
        "不须悔唱关山曲。",
        "只为海棠，也合来西蜀。"
      ],
      "author": {
        "id": 9909,
        "name": "范成大"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314273,
      "title": "醉落魄・一斛珠",
      "content": [
        "雪晴风作。",
        "松梢片片轻鸥落。",
        "玉楼天半褰珠箔。",
        "一笛梅花，吹裂冻云幕。",
        "去年小猎漓山脚。",
        "弓刀湿遍犹横槊。",
        "今年翻怕貂裘薄。",
        "寒似去年，人比去年觉。"
      ],
      "author": {
        "id": 9909,
        "name": "范成大"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314279,
      "title": "醉落魄・一斛珠",
      "content": [
        "栖乌飞绝。",
        "绛河绿雾星明灭。",
        "烧香曳簟眠清樾。",
        "花久影吹笙，满地淡黄月。",
        "好风碎竹声如雪。",
        "昭华三弄临风咽。",
        "鬓丝撩乱纶巾折。",
        "凉满北窗，休共软红说。"
      ],
      "author": {
        "id": 9909,
        "name": "范成大"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314339,
      "title": "醉落魄・一斛珠",
      "content": [
        "野庵吹鼓。",
        "翻腾似与寻常异。",
        "笙萧筝笛皆非是。",
        "今日头场，看取些儿戏。",
        "心中无事无萦系。",
        "村歌数首新来制。",
        "参禅渐渐知滋味。",
        "细语粗言，俱是第一义。"
      ],
      "author": {
        "id": 5728,
        "name": "沈瀛"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314340,
      "title": "醉落魄・一斛珠",
      "content": [
        "时光盛逼。",
        "杯盘渐渐来收拾。",
        "主人便欲留连客。",
        "末后殷勤，一著怎生得。",
        "来时便有归时刻。",
        "归时便是来时迹。",
        "世间万事曾经历。",
        "只看如今，无不散筵席。"
      ],
      "author": {
        "id": 5728,
        "name": "沈瀛"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314341,
      "title": "醉落魄・一斛珠",
      "content": [
        "致知格物。",
        "初学工夫参圣域。",
        "天高地远无穷极。",
        "欲造精微，莫若守惟一。",
        "纯全天理明如日。",
        "都缘人欲来相惑。",
        "且将持敬为先入。",
        "若能持敬，真个是神力。"
      ],
      "author": {
        "id": 5728,
        "name": "沈瀛"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314342,
      "title": "醉落魄・一斛珠",
      "content": [
        "致知格物。",
        "孔颜学问从兹出。",
        "圣言句句皆真实。",
        "涵养功深，将见自家得。",
        "毋意毋我毋固必。",
        "视听言动非礼勿。",
        "胜己之私之谓克。",
        "克尽私心，天理甚明白。"
      ],
      "author": {
        "id": 5728,
        "name": "沈瀛"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314483,
      "title": "醉落魄・一斛珠",
      "content": [
        "红娇翠弱。",
        "春寒睡起慵匀掠。",
        "些儿心事谁能学。",
        "深院无人，时有燕穿幕。",
        "漏声滴尽莲花萼。",
        "静看月转西阑角。",
        "世情一任浮云薄。",
        "花与东君，却解慰流落。"
      ],
      "author": {
        "id": 474,
        "name": "沈端节"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314561,
      "title": "醉落魄・一斛珠",
      "content": [
        "轻黄澹绿。",
        "可人风韵闲装束。",
        "多情早是眉峰蹙。",
        "一点秋波，闲里观人毒。",
        "桃花庭院光阴速。",
        "铜鞮谁唱大堤曲。",
        "归时想是樱桃熟。",
        "不道秋千，谁伴那人蹴。"
      ],
      "author": {
        "id": 12402,
        "name": "张孝祥"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314874,
      "title": "醉落魄・一斛珠",
      "content": [
        "麦畦匀绿。",
        "枝头屑屑飞梅玉。",
        "伤心何事人南北。",
        "断尽回肠，忍听阳关曲。",
        "倚窗青荫亭亭竹。",
        "好风敲动声相续。",
        "夜阑怕见银台烛。",
        "会得离情，他也泪速速。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314962,
      "title": "醉落魄・一斛珠",
      "content": [
        "淡妆浓抹。",
        "西湖人面两奇绝。",
        "菖蒲角黍家家节。",
        "水戏鱼龙，十里画帘揭。",
        "凌波无限生尘袜。",
        "冰肌莹彻香罗雪。",
        "游船且莫催归楫。",
        "遮莫黄昏，天外有新月。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315010,
      "title": "醉落魄・一斛珠",
      "content": [
        "伤离恨别。",
        "愁肠又似丁香结。",
        "不应斗顿音书绝。",
        "烟水连天，何处认红叶。",
        "残更数尽银缸灭。",
        "边城画角声呜咽。",
        "罗衾泪滴相思血。",
        "花影移来，摇碎半窗月。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315855,
      "title": "醉落魄・一斛珠",
      "content": [
        "重阳时节。",
        "可怜又是天崖客。",
        "扁舟小泊花溪侧。",
        "细雨斜风，不见秦楼月。",
        "白衣望断无消息。",
        "举觞一笑真难得。",
        "归兮学取陶彭泽。",
        "采菊东篱，悠然见山色。"
      ],
      "author": {
        "id": 1313,
        "name": "赵善括"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315865,
      "title": "醉落魄・一斛珠",
      "content": [
        "梯横画阁。",
        "碧栏干外江风恶。",
        "笑声欢意浮杯酌。",
        "秋水春山，相对称行乐。",
        "谁家青鸟穿帘幕。",
        "暗传空有阳台约。",
        "天公著意称停著。",
        "寒色人情，都恁两清薄。"
      ],
      "author": {
        "id": 1313,
        "name": "赵善括"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315866,
      "title": "醉落魄・一斛珠",
      "content": [
        "梯横画阁。",
        "月明江静烟光薄。",
        "碧山回绕栏干角。",
        "一缕行云，忽向杯中落。",
        "樱歌柳舞俱柔弱。",
        "罗衣不耐江风恶。",
        "凭谁唤取双黄鹤。",
        "骑上瑶台，同赴金桃约。"
      ],
      "author": {
        "id": 1313,
        "name": "赵善括"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315920,
      "title": "醉落魄・一斛珠",
      "content": [
        "夏围初结。",
        "绿深深处红千叠。",
        "杜鹃过尽芳菲歇。",
        "只道无春，满意春犹惬。",
        "折来一点如猩血。",
        "透明冠子轻盈贴。",
        "芳心蹙破情尤切。",
        "不管花残，犹自拣双叶。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315943,
      "title": "醉落魄・一斛珠",
      "content": [
        "风催雨促。",
        "今番不似前欢足。",
        "早来最苦离情毒。",
        "唱我新词，掩著面儿哭。",
        "临行只怕人行远。",
        "殷勤更写多情曲。",
        "相逢已是腰如束。",
        "从此知他，还减几分玉。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315989,
      "title": "醉落魄・一斛珠",
      "content": [
        "晚凉时节。",
        "翠梧风定蝉声歇。",
        "有人睡起香浮颊。",
        "倚著阑干，笑拣青荷叶。",
        "如今往事愁难说。",
        "曲池依旧闲风月。",
        "田田翠盖香罗叠。",
        "留得露痕，都是泪珠结。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316146,
      "title": "醉落魄・一斛珠",
      "content": [
        "东风寒绝。",
        "江城待得花枝发。",
        "欲知此夜碧天阔。"
      ],
      "author": {
        "id": 650,
        "name": "陈三聘"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316180,
      "title": "醉落魄・一斛珠",
      "content": [
        "友莺梦蝶。",
        "寻花问柳深相结。",
        "教春去后群芳歇。",
        "零落朋游，辜负好时节。",
        "眼边愁绪多于发。",
        "迢迢一水通吴越。",
        "旧欢新恨都休说。",
        "坐暖残红，沈醉碧天阔。"
      ],
      "author": {
        "id": 11721,
        "name": "石孝友"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316181,
      "title": "醉落魄・一斛珠",
      "content": [
        "鸾孤凤只。",
        "而今怎忍轻抛掷。",
        "知他别后谁怜惜。",
        "一味恓惶，辜负我思忆。",
        "云山万叠烟波急。",
        "短书频寄征鸿翼。",
        "相逢后会知何日。",
        "去也奴哥，千万好将息。"
      ],
      "author": {
        "id": 11721,
        "name": "石孝友"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316182,
      "title": "醉落魄・一斛珠",
      "content": [
        "空庭草积。",
        "吹花风去春无迹。",
        "锁鸾深处应相忆。",
        "红染罗巾，颦损眉山碧。",
        "曲屏尘暗双㶉𫛶。",
        "醉衾不暖炉烟湿。",
        "一帘暝色人孤寂。",
        "梦里灯残，心上雨声滴。"
      ],
      "author": {
        "id": 11721,
        "name": "石孝友"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316183,
      "title": "醉落魄・一斛珠",
      "content": [
        "红娇翠弱。",
        "怨人珠泪频偷落。",
        "归期莫负青笺约。",
        "雨断云销，总是初情薄。",
        "夜深秋气生帘幕。",
        "半衾依旧空闲却。",
        "故人何处孤舟泊。",
        "两岸秋声，一夜风涛恶。"
      ],
      "author": {
        "id": 11721,
        "name": "石孝友"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316346,
      "title": "醉落魄・一斛珠",
      "content": [
        "春风开者。",
        "一时还共春风谢。",
        "柳条送我今槐夏。",
        "不饮香醪，孤负人生也。",
        "曲塘泉细幽琴写。",
        "胡床滑簟应无价。",
        "日迟睡起帘钩挂。",
        "何不归欤，花竹秀而野。"
      ],
      "author": {
        "id": 13128,
        "name": "刘光祖"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 317146,
      "title": "醉落魄・一斛珠",
      "content": [
        "琼楼玉宇。",
        "分明不受人间暑。",
        "寻常岂是无三五。",
        "惟有今宵，皓彩皆同普。",
        "素娥阅尽今和古。",
        "何妨小驻听吾语。",
        "当年弄影婆娑舞。",
        "妙曲虽传，毕竟人何许。"
      ],
      "author": {
        "id": 2985,
        "name": "郭应祥"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 317470,
      "title": "醉落魄・一斛珠",
      "content": [
        "龙山行乐。",
        "何如今日登黄鹤。",
        "风光政要人酬酢。",
        "欲赋归来，莫是渊明错。",
        "江山登览长如昨。",
        "飞鸿影里秋光薄。",
        "此怀祗有黄花觉。",
        "牢裹乌纱，一任西风作。"
      ],
      "author": {
        "id": 2561,
        "name": "戴复古"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 317552,
      "title": "醉落魄・一斛珠",
      "content": [
        "胸襟洒落。",
        "光风霁月澄寥廓。",
        "生平素志惟丘壑。",
        "随分田园，花木四时乐。",
        "儿孙不用千金橐。",
        "吾家自有诗书粕。",
        "生朝有酒团栾酌。",
        "因笑渠侬，痴呆画松鹤。"
      ],
      "author": {
        "id": 576,
        "name": "叶秀发"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 317688,
      "title": "醉落魄・一斛珠",
      "content": [
        "鸳鸯意惬。",
        "空分付、有情眉睫。",
        "齐家莲子黄金叶。",
        "争比秋苔，靴凤几番蹑。",
        "墙阴月白花重叠。",
        "匆匆软语屡惊怯。",
        "宫香锦字将盈箧。",
        "雨长新寒，今夜梦魂接。"
      ],
      "author": {
        "id": 8948,
        "name": "史达祖"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 317689,
      "title": "醉落魄・一斛珠",
      "content": [
        "江痕妥帖。",
        "日光熨动黄金叶。",
        "阑干直下愁相接。",
        "一朵红莲，飞上越人楫。",
        "鲤鱼波上丁宁切。",
        "诗筒如线不曾别。",
        "明年好个春风客。",
        "五鹗交飞，身在玉皇阙。"
      ],
      "author": {
        "id": 8948,
        "name": "史达祖"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 317718,
      "title": "醉落魄・一斛珠",
      "content": [
        "钩帘翠湿。",
        "寒江上、雨晴风急。",
        "乱峰低处明残日。",
        "雁字成行，写破暮天碧。",
        "故人天外长为客。",
        "倚阑一望情何极。",
        "新来得个归消息。",
        "去棹回舟，数过几千只。"
      ],
      "author": {
        "id": 5575,
        "name": "高观国"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 317773,
      "title": "醉落魄・一斛珠",
      "content": [
        "无边春色。",
        "试从汉谕堂边觅。",
        "儿前上寿孙扶掖。",
        "九十娘娘，身是五朝客。",
        "眼前富贵浑闲历。",
        "个中真乐天然的。",
        "儿孙强劝持馀沥。",
        "娘道休休，明日儿生日。"
      ],
      "author": {
        "id": 6995,
        "name": "魏了翁"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 317857,
      "title": "醉落魄・一斛珠",
      "content": [
        "才难如此。",
        "一门生许奇男子。",
        "长公更是惺惺底。",
        "千百年间，一寸心为纸。",
        "人知公在诗书里。",
        "天知公在诗书外。",
        "人间百顺由公起。",
        "公把无心，总备人间事。"
      ],
      "author": {
        "id": 6995,
        "name": "魏了翁"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 317884,
      "title": "醉落魄・一斛珠",
      "content": [
        "无边春色。",
        "人情苦向南山觅。",
        "村村箫鼓家家笛。",
        "祈麦祈蚕，来趁元正七。",
        "翁前子后孙扶掖。",
        "商行贾坐农耕织。",
        "许知此意无今昔。",
        "会得为人，日日是人日。"
      ],
      "author": {
        "id": 6995,
        "name": "魏了翁"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 318094,
      "title": "醉落魄・一斛珠",
      "content": [
        "江头离席。",
        "晚潮双橹催行色。",
        "往来属玉双飞白。",
        "笑我多情，犹作未归客。",
        "红尘奔走何时息。",
        "归心还似投林翼。",
        "角巾醉里从敧侧。",
        "独立东风，天际露岑碧。"
      ],
      "author": {
        "id": 9534,
        "name": "刘学箕"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 318339,
      "title": "醉落魄・一斛珠",
      "content": [
        "铜彝绣箔。",
        "风流不到临春阁。",
        "婆娑清影来岩壑。",
        "梅魄兰魂，香染九秋萼。",
        "蕊仙拥下青瑶幕。",
        "粟肌透入黄金约。",
        "有人奚酉逢鱼摸。",
        "欲插还羞，重把鬓云掠。"
      ],
      "author": {
        "id": 7541,
        "name": "岳珂"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 318456,
      "title": "醉落魄・一斛珠",
      "content": [
        "初藕花发。",
        "薰风庭院凉成霎。",
        "碧纱金缕笼香雪。",
        "记得年时，心事凭栏说。",
        "如今陡顿音书绝。",
        "夜窗羞见团团月。",
        "锦囊尘暗黄金玦。",
        "留取多情，归好时节。"
      ],
      "author": {
        "id": 6063,
        "name": "黄机"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 319194,
      "title": "醉落魄・一斛珠",
      "content": [
        "瑶姬妙格。",
        "冰姿微带霜痕拆。",
        "一般恼杀多情客。",
        "风弄横枝，残月半窗白。",
        "孤山仙种曾移得。",
        "结根久傍王猷宅。",
        "欲笺心事呼云翮。",
        "为报年芳，萍梗正南北。"
      ],
      "author": {
        "id": 12084,
        "name": "张矩"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 320286,
      "title": "醉落魄・一斛珠",
      "content": [
        "春温红玉。",
        "纤衣学翦娇鸦绿。",
        "夜香烧短银屏烛。",
        "偷掷金钱，重把寸心卜。",
        "翠深不碍鸳鸯宿。",
        "采菱谁记当时曲。",
        "青山南畔红云北。",
        "一叶波心，明灭澹妆束。"
      ],
      "author": {
        "id": 1043,
        "name": "吴文英"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 320330,
      "title": "醉落魄・一斛珠",
      "content": [
        "柔怀难托。",
        "老天如水人情薄。",
        "烛痕犹刻西窗约。",
        "歌断梨云，留梦绕罗幕。",
        "寒更唱遍吹梅角。",
        "香消臂趁弓弰削。",
        "主家衣在羞重著。",
        "独掩营门，春尽柳花落。"
      ],
      "author": {
        "id": 1043,
        "name": "吴文英"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 321247,
      "title": "醉落魄・一斛珠",
      "content": [
        "单衣乍著。",
        "滞寒更傍东风作。",
        "珠帘压定银钩索。",
        "雨弄新晴，轻旋玉尘落。",
        "花唇巧借妆红约。",
        "娇羞才放三分萼。",
        "樽前不用多评泊。",
        "春浅春深，都向杏梢觉。"
      ],
      "author": {
        "id": 6273,
        "name": "薛梦桂"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 321978,
      "title": "醉落魄・一斛珠",
      "content": [
        "寒侵径叶。",
        "雁风击碎珊瑚屑。",
        "砚凉闲试霜晴帖。",
        "颂菊骚兰，秋事正奇绝。",
        "故人又作江西别。",
        "书楼虚度中秋节。",
        "碧阑倚遍愁谁说。",
        "愁是新愁，月是旧时月。"
      ],
      "author": {
        "id": 10336,
        "name": "周密"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 322001,
      "title": "醉落魄・一斛珠",
      "content": [
        "忆忆忆忆。",
        "宫罗褶褶消金色。",
        "吹花有尽情无极。",
        "泪滴空帘，香润柳枝湿。",
        "春愁浩荡湘波窄。",
        "红兰梦绕江南北。",
        "燕莺都是东风客。",
        "移尽庭阴，风老杏花白。"
      ],
      "author": {
        "id": 10336,
        "name": "周密"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 322003,
      "title": "醉落魄・一斛珠",
      "content": [
        "馀寒正怯。",
        "金钗影卸东风揭。",
        "舞衣丝损愁千褶。",
        "一缕杨丝，犹是去年折。",
        "临窗拥髻愁难说。",
        "花庭一寸燕支雪。",
        "春花似旧心情别。",
        "待摘玫瑰，飞下粉黄蝶。"
      ],
      "author": {
        "id": 10336,
        "name": "周密"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 322325,
      "title": "醉落魄・一斛珠",
      "content": [
        "小窗银烛。",
        "轻鬟半拥钗横玉。",
        "数声春调清真曲。",
        "拂拂朱帘，残影乱红扑。",
        "垂杨学画蛾眉绿。",
        "年年芳草迷金谷。",
        "如今休把佳期卜。",
        "一掬春情，斜月杏花屋。"
      ],
      "author": {
        "id": 9246,
        "name": "王沂孙"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 322326,
      "title": "醉落魄・一斛珠",
      "content": [
        "揉碎花心，吟碎淡黄雪。"
      ],
      "author": {
        "id": 9246,
        "name": "王沂孙"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 322416,
      "title": "醉落魄・一斛珠",
      "content": [
        "西园饮歇。",
        "倚阑干、玉箫声彻。",
        "荷枯菊老秋芳歇。",
        "两蕊三花、九月南州雪。",
        "何郎情思逋仙骨。",
        "观桃墙杏成疏阔。",
        "醉骑玉凤游银阙。",
        "满树西风、吹动暗香月。"
      ],
      "author": {
        "id": 12170,
        "name": "赵必□"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 322492,
      "title": "醉落魄・一斛珠",
      "content": [
        "水西云北。",
        "锦苞泫露无颜色。",
        "夜寒花外眠双𫛶。",
        "莫唱江南，谁是鹧鸪客。",
        "薄情青女司花籍。",
        "粉愁红怨啼螀急。",
        "月明倦听山阳笛。",
        "渺渺征鸿，千里楚天碧。"
      ],
      "author": {
        "id": 2011,
        "name": "仇远"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 322837,
      "title": "醉落魄・一斛珠",
      "content": [
        "柳侵阑角。",
        "画帘风软红香泊。",
        "引人蝴蝶翻轻薄。",
        "已自关情，和梦近来恶。",
        "眉梢轻把闲愁著。",
        "如今愁重眉梢弱。",
        "双眉不画愁消却。",
        "不道愁痕，来傍眼边觉。"
      ],
      "author": {
        "id": 611,
        "name": "张炎"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 323485,
      "title": "醉落魄・一斛珠",
      "content": [
        "琼搓粉滴。",
        "南枝只报江南坼。",
        "横斜疏影溪边窄。",
        "翦碎白云，分付陇头客。",
        "冰肌绰约疑姑射。",
        "铅华消尽见真色。",
        "不随桃李开红白。",
        "我为东君，来报春消息。"
      ],
      "author": {
        "id": 5773,
        "name": "无名氏"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 323486,
      "title": "醉落魄・一斛珠",
      "content": [
        "梅花似雪。",
        "赏花记得同欢悦。",
        "更阑犹自贪攀折。",
        "不怯春寒，须要待明月。",
        "如今月上花争发。",
        "疏枝冷蕊对离缺。",
        "人心只道花争别。",
        "不道人心，不似旧时节。"
      ],
      "author": {
        "id": 5773,
        "name": "无名氏"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 324623,
      "title": "醉落魄・一斛珠",
      "content": [
        "风高木落。",
        "壮心万里空回薄。",
        "振衣待把尘埃濯。",
        "声里斜阳，孤起戍楼角。",
        "人生谁会谁为错。",
        "年来但觉多离索。",
        "黄花照地浑开却。",
        "华发如斯，同和醉落魄。"
      ],
      "author": {
        "id": 11972,
        "name": "韩淲"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 324904,
      "title": "醉落魄・一斛珠",
      "content": [
        "陶陶兀兀。",
        "尊前是我华胥国。",
        "争名争利休休莫。",
        "雪月风花，不醉怎生得。",
        "邯郸一枕谁忧乐。",
        "新诗新事因闲适。",
        "东山小妓携丝竹。",
        "家里乐天，村里谢安石。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 324905,
      "title": "醉落魄・一斛珠",
      "content": [
        "陶陶兀兀。",
        "人生无累何由得。",
        "杯中三万六千日。",
        "闷损旁观，自我解落魄。",
        "扶头不起还颓玉。",
        "日高春睡平生足。",
        "谁门可款新𥬠熟。",
        "安乐春泉，玉醴荔枝绿。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 324906,
      "title": "醉落魄・一斛珠",
      "content": [
        "陶陶兀兀。",
        "人生梦里槐安国。",
        "教公休醉公但莫。",
        "盏倒垂莲，一笑是赢得。",
        "街头酒贱民声乐。",
        "寻常行处寻欢适。",
        "醉看檐雨森银竹。",
        "我欲忧民，渠有二千石。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 324907,
      "title": "醉落魄・一斛珠",
      "content": [
        "陶陶兀兀。",
        "醉乡路远归不得。",
        "心情那似当年日。",
        "割爱金河，一碗淡莫托。",
        "异乡薪桂炊苍玉。",
        "摩挲经笥须知足。",
        "明年细麦能黄熟。",
        "不管轻霜，点尽鬓边绿。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 324958,
      "title": "醉落魄・一斛珠",
      "content": [
        "苍颜华发。",
        "故山归计无因得。",
        "旧交新贵音书绝。",
        "惟有家人，犹作殷勤别。",
        "离亭欲去歌声咽。",
        "潇潇细雨凉生颊。",
        "泪珠不用罗巾裛。",
        "弹在罗衫，图得见时说。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 325350,
      "title": "鹧鸪天",
      "content": [
        "烛影摇红玉漏迟。",
        "鹊桥仙子下瑶池。",
        "倾杯乐处笙歌沸，苏幕遮阑笑语随。",
        "醉落魄，阮郎归。",
        "传言玉女步轻移。",
        "凤凰台上深深愿，一日和鸣十二时。"
      ],
      "author": {
        "id": 5773,
        "name": "无名氏"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 326430,
      "title": "醉落魄・一斛珠",
      "content": [
        "芳尘休扑。",
        "名花唤我相追逐。",
        "浅妆不比梅敧竹。",
        "深注朱颜，娇面称红烛。",
        "阿娇合贮黄金屋。",
        "是谁却遣来空谷。",
        "酡颜遍倚阑干曲。",
        "一段风流，不枉到西蜀。"
      ],
      "author": {
        "id": 4545,
        "name": "京镗"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 326592,
      "title": "醉落魄・一斛珠",
      "content": [
        "镂花镌叶。",
        "满枝风露和香撷。",
        "引将芳思归吟箧。",
        "梦与魂同，闲了弄香蝶。",
        "小楼帘卷歌声歇。",
        "幽篁独处泉呜咽。",
        "短笺空在愁难说。",
        "霜角寒梅，吹碎半江月。"
      ],
      "author": {
        "id": 611,
        "name": "张炎"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 326764,
      "title": "醉落魄・一斛珠",
      "content": [
        "红牙板歇。",
        "韶声断、六么初彻。",
        "小槽酒滴真珠竭。",
        "紫玉瓯圆，浅浪泛春雪。",
        "香芽嫩蕊清心骨。",
        "醉中襟量与天阔。",
        "夜阑似觉归仙阙。",
        "走马章台，踏碎满街月。"
      ],
      "author": {
        "id": 5773,
        "name": "无名氏"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 326979,
      "title": "醉落魄・一斛珠",
      "content": [
        "风波未息。",
        "虚名浮利终无益。",
        "不如早去备蓑笠。",
        "高卧烟霞，千古企难及。",
        "君今既已装行色。",
        "定应雁塔题名籍。",
        "他年若到南雄驿。",
        "玉石休分，徒累卞和泣。"
      ],
      "author": {
        "id": 2473,
        "name": "哑女"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 327466,
      "title": "醉落魄・一斛珠",
      "content": [
        "高鸿远骛。",
        "溪山一带人烟簇。",
        "知君船近渔矶宿。",
        "轻素横溪，天淡挂寒玉。",
        "谁家红袖阑干曲。",
        "南陵风软波平绿。",
        "幽吟无伴芳尊独。",
        "清瘦休文，一夜伤单縠。"
      ],
      "author": {
        "id": 1022,
        "name": "晁补之"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 327739,
      "title": "醉落魄・一斛珠",
      "content": [
        "葺金细弱。",
        "秋风嫩、桂花初著。",
        "蕊珠宫里人难学。",
        "花染娇荑，羞映翠云幄。",
        "清香不与兰荪弱。",
        "一枝云鬓巧梳掠。",
        "夜凉轻撼蔷薇萼。",
        "香满衣襟，月在凤凰阁。"
      ],
      "author": {
        "id": 3026,
        "name": "周邦彦"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 327892,
      "title": "醉落魄・一斛珠",
      "content": [
        "霜砧声急。",
        "潇潇疏雨梧桐湿。",
        "无言独倚阑干立。",
        "帘卷黄昏，一阵西风入。",
        "年时画阁佳宾集。",
        "玉人檀板当筵执。",
        "银瓶已断丝绳汲。",
        "莫话前欢，忍对屏山泣。"
      ],
      "author": {
        "id": 10139,
        "name": "谢逸"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 328316,
      "title": "醉落魄・一斛珠",
      "content": [
        "梅花褪雪。",
        "赏心莫使慵欢悦。",
        "大家且恁同攀折。",
        "馀蕊残英，偏称淡笼月。",
        "当初相见花初发。",
        "如今花谢人离缺。",
        "一年又比一年别。",
        "惟有花枝，只似旧时节。"
      ],
      "author": {
        "id": 13526,
        "name": "吴则礼"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 328663,
      "title": "醉落魄・一斛珠",
      "content": [
        "小舟帘隙。",
        "佳人半露梅妆额。",
        "绿云低映花如刻。",
        "恰似秋宵，一半银蟾白。",
        "结儿梢朵香红扐。",
        "钿蝉隐隐摇金碧。",
        "春山秋水浑无迹。",
        "不露墙头，些子真消息。"
      ],
      "author": {
        "id": 7256,
        "name": "汪藻"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 328932,
      "title": "醉落魄・一斛珠",
      "content": [
        "海山叠翠。",
        "夕阳殷雨云堆雪。",
        "鹧鸪声里蛮花发。",
        "我共扁舟，江上两萍叶。",
        "东风落酒愁难说。",
        "谁教春梦分胡越。",
        "碧城芳草应销歇。",
        "曾识刘郎，惟有半弯月。"
      ],
      "author": {
        "id": 12624,
        "name": "朱敦儒"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 329147,
      "title": "醉落魄・一斛珠",
      "content": [
        "江天云薄。",
        "江头雪似杨花落。",
        "寒灯不管人离索。",
        "照得人来，真个睡不著。",
        "归期已负梅花约。",
        "又还春动空飘泊。",
        "晓寒谁看伊梳掠。",
        "雪满西楼，人在阑干角。"
      ],
      "author": {
        "id": 6553,
        "name": "周紫芝"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 329148,
      "title": "醉落魄・一斛珠",
      "content": [
        "柳边池阁。",
        "晚来卷地东风恶。",
        "人生不解频行乐。",
        "昨日花开，今日风吹落。",
        "杨花却似人飘泊。",
        "春云更似人情薄。",
        "如今始信从前错。",
        "为个蝇头，轻负青山约。"
      ],
      "author": {
        "id": 6553,
        "name": "周紫芝"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 329149,
      "title": "醉落魄・一斛珠",
      "content": [
        "薰风池阁。",
        "小红桥下荷花薄。",
        "沙平水浅山如削。",
        "水上鸳鸯，何处风吹落。",
        "今朝端午新梳掠。",
        "锦丝围腕花柔弱。",
        "人生只有尊前乐。",
        "前度刘郎，莫负重来约。"
      ],
      "author": {
        "id": 6553,
        "name": "周紫芝"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 329150,
      "title": "醉落魄・一斛珠",
      "content": [
        "云深海阔。",
        "天风吹上黄金阙。",
        "酒醒不记归时节。",
        "三十年来，往事无人说。",
        "浮生正似风中雪。",
        "丹砂岂是神仙诀。",
        "世间生死无休歇。",
        "长伴君闲，只有山中月。"
      ],
      "author": {
        "id": 6553,
        "name": "周紫芝"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 329778,
      "title": "醉落魄・一斛珠",
      "content": [
        "无言哽噎。",
        "看灯记得年时节。",
        "行行指月行行说。",
        "愿月常圆，休要暂时缺。",
        "今年华市灯罗列。",
        "好灯争柰人心别。",
        "人前不敢分明说。",
        "不忍抬头，羞见旧时月。"
      ],
      "author": {
        "id": 1395,
        "name": "赵佶"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 330280,
      "title": "醉落魄・一斛珠",
      "content": [
        "波纹如縠。",
        "池塘雨后添新绿。",
        "海棠初绽红生肉。",
        "双燕归来，还认旧巢宿。",
        "凝情凭暖阑干曲。",
        "新愁无限伤心目。",
        "谁人月下吹横玉。",
        "惊起鸳鸯，飞去自相逐。"
      ],
      "author": {
        "id": 13489,
        "name": "蔡伸"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 330281,
      "title": "醉落魄・一斛珠",
      "content": [
        "霜华摇落。",
        "亭亭皓月侵朱箔。",
        "梦回敧枕听残角。",
        "一片寒声，风送入寥廓。",
        "眼前风月都如昨。",
        "独眠无奈情怀恶。",
        "凭肩携手于飞约。",
        "料想人人，终是赋情薄。"
      ],
      "author": {
        "id": 13489,
        "name": "蔡伸"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 330282,
      "title": "醉落魄・一斛珠",
      "content": [
        "明眸秀色。",
        "双蛾巧画春山碧。",
        "盈盈标韵倾瑶席。",
        "一见尊前，宛是旧相识。",
        "深期密语虽端的。",
        "良宵无奈成轻掷。",
        "忍教只恁空相忆。",
        "得入手来，无限好则剧。"
      ],
      "author": {
        "id": 13489,
        "name": "蔡伸"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 330283,
      "title": "醉落魄・一斛珠",
      "content": [
        "阳关声咽。",
        "清歌响断云屏隔。",
        "溪山依旧连空碧。",
        "昨日主人，今日是行客。",
        "绿窗朱户应如昔。",
        "回头往事成陈迹。",
        "后期总便无端的。",
        "月下风前，应也解相忆。"
      ],
      "author": {
        "id": 13489,
        "name": "蔡伸"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 330524,
      "title": "醉落魄・一斛珠",
      "content": [
        "浮家泛宅。",
        "旧游记霅溪踪迹。",
        "此生已是天涯隔。",
        "投老谁知，还作三吴客。",
        "故人怪我疏髯黑。",
        "醉来犹似丁年日。",
        "光阴未肯成虚掷。",
        "蜀魄声中，著处有春色。"
      ],
      "author": {
        "id": 13570,
        "name": "张元干"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 330525,
      "title": "醉落魄・一斛珠",
      "content": [
        "绿枝红萼。",
        "江南芳信年年约。",
        "竹舆路转溪桥角。",
        "晴日烘香，的皪疏篱落。",
        "玉台粉面铅华薄。",
        "画堂长记深罗幕。",
        "惜花老去情犹著。",
        "客里惊春，生怕东风恶。"
      ],
      "author": {
        "id": 13570,
        "name": "张元干"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 330526,
      "title": "醉落魄・一斛珠",
      "content": [
        "一枝冰萼。",
        "鬓云低度横波约。",
        "醉扶曾罥乌巾角。",
        "长是春来，肠断宝钗落。",
        "罗衣乍怯香风薄。",
        "夜深花困遮垂幕。",
        "不堪往事寻思著。",
        "休问尊前，客恶主人恶。"
      ],
      "author": {
        "id": 13570,
        "name": "张元干"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 330527,
      "title": "醉落魄・一斛珠",
      "content": [
        "云鸿影落。",
        "风吹小艇敧沙泊。",
        "津亭古木浓阴合。",
        "一枕滩声，客睡何曾著。",
        "天涯万里情怀恶。",
        "年华垂暮犹离索。",
        "佳人想见猜疑错。",
        "莫数归期，已负当时约。"
      ],
      "author": {
        "id": 13570,
        "name": "张元干"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 330632,
      "title": "醉落魄・一斛珠",
      "content": [
        "明窗读易。",
        "时才人地俱超轶。",
        "偶然一坠槐安国。",
        "说利谈功，这事怎休得。",
        "何时置酒图书室。",
        "挥弦目送西飞翼。",
        "夜来已觉春笋溢。",
        "月影三人，一醉旧相识。"
      ],
      "author": {
        "id": 10747,
        "name": "吕渭老"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 330633,
      "title": "醉落魄・一斛珠",
      "content": [
        "纤鞋窄袜。",
        "红茵自称琵琶拍。",
        "明衣妆脸春梳掠。",
        "好好亭亭，那得恁标格。",
        "匆匆一醉霜华白。",
        "归来偏记蓝桥宅。",
        "五更残梦迷蝴蝶。",
        "觑著花枝，只被绣帘隔。"
      ],
      "author": {
        "id": 10747,
        "name": "吕渭老"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 330888,
      "title": "醉落魄・一斛珠",
      "content": [
        "点酥点蜡。",
        "凭君尽做风流骨。",
        "汉家旧样宫妆额。",
        "流落人间，真个没人识。",
        "佳人误拨龙香觅。",
        "一枝初向烟林得。",
        "被花惹起愁难说。",
        "恰恨西窗，酒醒乌啼月。"
      ],
      "author": {
        "id": 3058,
        "name": "冯时行"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 330929,
      "title": "醉落魄・一斛珠",
      "content": [
        "双心小萼。",
        "瑞炉慢炷轻烟初著。",
        "清香已透红绡幄。",
        "底事多情，玉笋更轻掠。",
        "鬓云侧畔□眉角。",
        "妆成曾印铅华薄。",
        "几回𣨼酒襟怀恶。",
        "莺舌偷传，低语教人嚼。"
      ],
      "author": {
        "id": 8894,
        "name": "杨无咎"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 331216,
      "title": "醉落魄・一斛珠",
      "content": [
        "百年强半。",
        "高秋犹在天南畔。",
        "幽怀已被黄花乱。",
        "更恨银蟾，故向愁人满。",
        "招呼诗酒颠狂伴。",
        "羽觞到手判无算。",
        "浩歌箕踞巾聊岸。",
        "酒欲醒时，兴在庐仝碗。"
      ],
      "author": {
        "id": 6120,
        "name": "胡铨"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    }
  ],
