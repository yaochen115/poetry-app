{
  "data": [
    {
      "id": 231890,
      "title": "句  其五五",
      "content": [
        "客里唯君数往还。"
      ],
      "author": {
        "id": 1056,
        "name": "徐俯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
