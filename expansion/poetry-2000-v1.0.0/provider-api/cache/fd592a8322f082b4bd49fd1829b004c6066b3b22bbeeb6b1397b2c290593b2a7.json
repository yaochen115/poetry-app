        "name": "其他"
      }
    },
    {
      "id": 231891,
      "title": "句  其五六",
      "content": [
        "故人特地为咨嗟。"
      ],
      "author": {
        "id": 1056,
        "name": "徐俯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 231892,
      "title": "句  其五七",
      "content": [
        "日落相携上小舟。"
      ],
      "author": {
        "id": 1056,
        "name": "徐俯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 231893,
      "title": "句  其五八",
      "content": [
        "无穷涧草纵横绿。"
      ],
      "author": {
        "id": 1056,
        "name": "徐俯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 231894,
      "title": "句  其五九",
      "content": [
        "露重冰清风日暖。"
      ],
      "author": {
        "id": 1056,
        "name": "徐俯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 231895,
      "title": "句  其六○",
      "content": [
        "篱落寒梅三两枝。"
      ],
      "author": {
        "id": 1056,
        "name": "徐俯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 231896,
      "title": "句  其六一",
      "content": [
        "但愿一生长若此。"
      ],
      "author": {
        "id": 1056,
        "name": "徐俯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 231897,
      "title": "句  其六二",
      "content": [
        "少不愁穷老岂愁。"
      ],
      "author": {
        "id": 1056,
        "name": "徐俯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 231898,
      "title": "句  其六三",
      "content": [
        "从吾所好烟波上。"
      ],
      "author": {
        "id": 1056,
        "name": "徐俯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 231899,
      "title": "句  其六四",
      "content": [
        "镜中老色日侵寻。"
      ],
      "author": {
        "id": 1056,
        "name": "徐俯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 231900,
      "title": "句  其六五",
      "content": [
        "镜中嬴得鬓成丝。"
      ],
      "author": {
        "id": 1056,
        "name": "徐俯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 231901,
      "title": "句  其六六",
      "content": [
        "临流谁复赋新诗。"
      ],
      "author": {
        "id": 1056,
        "name": "徐俯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 231902,
      "title": "句  其六七",
      "content": [
        "颇知鹤胫缘诗瘦，早弃鱼须伴我闲。"
      ],
      "author": {
        "id": 1056,
        "name": "徐俯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 231903,
      "title": "句  其六八",
      "content": [
        "向使不死贼，未必世能容。"
      ],
      "author": {
        "id": 1056,
        "name": "徐俯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 231904,
      "title": "句  其六九",
      "content": [
        "今时习主簿，还是鲁诸王。"
      ],
      "author": {
        "id": 1056,
        "name": "徐俯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 328344,
      "title": "念奴娇",
      "content": [
        "素光练静，照青山隐隐，修眉横绿。",
        "𫛛鹊楼高天似水，碧瓦寒生银粟。",
        "万丈辉光，奔云涌雾，飞过卢鸿屋。",
        "更无尘翳，皓然冷浸梧竹。",
        "因念鹤发仙翁，当时曾共赏，紫岩飞瀑。",
        "对影三人聊痛饮，一洗闲愁千斛。",
        "斗转参移，翻然归去，万里骑黄鹄。",
        "一川霜晓，叫云吹断横玉。"
      ],
      "author": {
        "id": 1056,
        "name": "徐俯"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 328345,
      "title": "浣溪沙",
      "content": [
        "章水何如颍水清。",
        "江山明秀发诗情。",
        "七言还我是长城。",
        "小小钿花开宝靥，纤纤玉笋见云英。",
        "十千名酒十分倾。"
      ],
      "author": {
        "id": 1056,
        "name": "徐俯"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 328346,
      "title": "虞美人",
      "content": [
        "梅花元自江南得。",
        "还醉江南客。",
        "雪中雨里为谁香。",
        "闻道数枝清笑、出东墙。",
        "多情宋玉还知否。",
        "梁苑无寻处。",
        "胭脂为萼玉为肌。",
        "却恨恼人桃杏、不同时。"
      ],
      "author": {
        "id": 1056,
        "name": "徐俯"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 328347,
      "title": "卜算子",
      "content": [
        "心空道亦空，风静林还静。",
        "卷尽浮云月自明，中有山河影。",
        "供养及修行。",
        "旧话成重省。",
        "豆爆生莲火里时，痛拨寒灰冷。"
      ],
      "author": {
        "id": 1056,
        "name": "徐俯"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 328348,
      "title": "卜算子",
      "content": [
        "天生百种愁，挂在斜阳树。",
        "绿叶阴阴占得春，草满莺啼处。",
        "不见生尘步。",
        "空忆如簧语。",
        "柳外重重叠叠山，遮不断、愁来路。"
      ],
      "author": {
        "id": 1056,
        "name": "徐俯"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 328349,
      "title": "卜算子",
      "content": [
        "清池过雨凉，暗有清香度。",
        "缥缈娉婷绝代歌，翠袖风中举。",
        "忽敛双眉去。",
        "总是关情处。",
        "一段江山一片云，又下阳台雨。"
      ],
      "author": {
        "id": 1056,
        "name": "徐俯"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 328350,
      "title": "鹧鸪天",
      "content": [
        "绿水名园不是村。",
        "淡妆浓笑两生春。",
        "笛中已自多愁怨，雨里因谁有泪痕。",
        "香旖旎，酒氤氲。",
        "多情生怕落纷纷。",
        "旧来好事浑如梦，年少风流付与君。"
      ],
      "author": {
        "id": 1056,
        "name": "徐俯"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 328351,
      "title": "鹧鸪天",
      "content": [
        "满眼纷纷恰似花。",
        "飘飘泊泊自天涯。",
        "雨中添得无穷湿，风里吹成一道斜。",
        "银作屋，玉为车。",
        "姮娥青女过人家。",
        "应嫌素面微微露，故着轻云薄薄遮。"
      ],
      "author": {
        "id": 1056,
        "name": "徐俯"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 328352,
      "title": "踏莎行",
      "content": [
        "素景将阑，黄花初笑。",
        "登高一望秋天杳。",
        "邀宾携妓数能来，醉中赢得闲多少。",
        "佳气氤氲，飞云缥缈。",
        "竹林更着清江绕。",
        "高歌屡舞莫催人，华筵直待华灯照。"
      ],
      "author": {
        "id": 1056,
        "name": "徐俯"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 328353,
      "title": "踏莎行",
      "content": [
        "画栋风生，绣筵花绕。",
        "层台胜日频高眺。",
        "清辉爽气自娱人，何妨称意开颜笑。",
        "水碧无穷，山青未了。",
        "斜阳浦口归帆少。",
        "云鬟烟鬓只供愁，琵琶更作相思调。"
      ],
      "author": {
        "id": 1056,
        "name": "徐俯"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 328354,
      "title": "踏莎行",
      "content": [
        "玉露团花，金风破雾。",
        "高台与上晴空去。",
        "举杯相属看前山，烟中乱叠青无数。",
        "皓齿明眸，肌香体素。",
        "恼人正在秋波注。",
        "因何欲雨又还晴，歌声遏得行云住。"
      ],
      "author": {
        "id": 1056,
        "name": "徐俯"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 328355,
      "title": "南歌子",
      "content": [
        "细蕊黄金嫩，繁花白雪香。",
        "共谁连璧向河阳。",
        "自是不须汤饼、试何郎。",
        "婀娜拢松髻，轻盈淡薄妆。",
        "莫令韩寿在伊傍。",
        "便逐游蜂惊蝶、过东墙。"
      ],
      "author": {
        "id": 1056,
        "name": "徐俯"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 328356,
      "title": "鹧鸪天",
      "content": [
        "宜笑宜颦掌上身。",
        "能歌能舞恶精神。",
        "脸边红入桃花嫩，眉上青归柳叶新。",
        "娇不语，易生嗔。",
        "尊前还是一番春。",
        "深杯百罚重拚却，只为妖饶醉得人。"
      ],
      "author": {
        "id": 1056,
        "name": "徐俯"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 328357,
      "title": "浣溪沙",
      "content": [
        "西塞山前白鹭飞。",
        "桃花流水鳜鱼肥。",
        "一波才动万波随。",
        "黄帽岂如青箬笠，羊裘何似绿蓑衣。",
        "斜风细雨不须归。"
      ],
      "author": {
        "id": 1056,
        "name": "徐俯"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 328358,
      "title": "浣溪沙",
      "content": [
        "新妇矶边秋月明。",
        "女儿浦口晚潮平。",
        "沙头鹭宿戏鱼惊。",
        "青箬笠前明此事，绿蓑衣底度平生。",
        "斜风细雨小舟轻。"
      ],
      "author": {
        "id": 1056,
        "name": "徐俯"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 328359,
      "title": "鹧鸪天",
      "content": [
        "西塞山前白鹭飞。",
        "桃花柳水鳜鱼肥。",
        "朝廷若觅元真子，晴在长江理钓丝。",
        "青箬笠，绿蓑衣。",
        "斜风细雨不须归。",
        "浮云万里烟波客，惟有沧浪孺子知。"
      ],
      "author": {
        "id": 1056,
        "name": "徐俯"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 328360,
      "title": "鹧鸪天",
      "content": [
        "七泽三湘碧草连。",
        "洞庭江汉水如天。",
        "朝廷若觅元真子，不在云边则酒边。",
        "明月棹，夕阳船。",
        "鲈鱼恰似镜中悬。",
        "丝纶钓饵都收却，八字山前听雨眠。"
      ],
      "author": {
        "id": 1056,
        "name": "徐俯"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    }
  ],
