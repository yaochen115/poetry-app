{
  "data": [
    {
      "id": 13340,
      "title": "呈胡希元进士二首  其二",
      "content": [
        "茕茕官绶解，落落饮瓢空。",
        "君惠容藏疾，交情助讳穷。",
        "倦谈嗟墨客，掉首觏鸿蒙。",
        "已卜良邻计，无忧吾道东。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13341,
      "title": "赠罢征边将",
      "content": [
        "罢征光禄塞，初入玉门关。",
        "残月边兵尽，寒风壮士还。",
        "旗光侵桂卷，箭镝半星闲。",
        "归赐将军第，长铭窦宪山。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13342,
      "title": "惠泉",
      "content": [
        "遥源辞叠嶂，澄派鉴晴虚。",
        "流迅无汾恶，波长尽楚余。",
        "隠之徒酌水，郑伯谩名渠。",
        "不必西江去，凭君起鲋鱼。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13343,
      "title": "寄沂州王学士",
      "content": [
        "旧租丞相国，新治使君州。",
        "坐树贪循政，怀铅倦雅游。",
        "猿惊乡岭树，蜃结海天楼。",
        "谁见行春盛，东方最上头。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13344,
      "title": "途中新岁忆三城兄长相公",
      "content": [
        "马上逢元朔，匆匆记物华。",
        "趁盘呈柏叶，偷笔弄椒花。",
        "臈暝残晨炬，春晖上早霞。",
        "三城今日酒，知我独思家。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13345,
      "title": "入壬辰新岁",
      "content": [
        "五十为衰始，仍余五岁衰。",
        "双眸不明鉴，残鬓已纷丝。",
        "铜虎虽频剖，荷囊信滥持。",
        "何须依老格，先作故山期。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13346,
      "title": "送余姚尉顾洵美先辈",
      "content": [
        "蓬葆已萧萧，从官越绝遥。",
        "山图禹穴近，涛气伍神骄。",
        "卧帐藏新论，舟行问故樵。",
        "寄声时谢我，江上足兰苕。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13347,
      "title": "送张士安同年赴上元尉",
      "content": [
        "千名联唱第，一尉滞徒劳。",
        "山入黄旗国，江浮白鹭涛。",
        "苑葩依日晚，官树共秋高。",
        "少赋思归恨，潘才是二毛。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13348,
      "title": "同赋饮舫",
      "content": [
        "饮有乘舟乐，舟因得饮名。",
        "能招习池客，便载景山铛。",
        "暂唇留颓玉，徐牵倒醉罂。",
        "莫辞沿溯远，双檝自逢迎。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13349,
      "title": "阅古堂",
      "content": [
        "堂皇对岑蔚，欢酌坐怡然。",
        "蟹美持螯日，鲂甘抑鲊天。",
        "渚翘幽处鹭，林响静时蝉。",
        "老去兴非浅，无妨清夜旋。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13350,
      "title": "胡寅赴明州慈溪尉",
      "content": [
        "久困天官调，东南亦第如。",
        "客篙新溜急，春树杂花余。",
        "越𦞦丰池鸭，吴袍竞库𦈌。",
        "还音与归梦，并附浙江鱼。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13351,
      "title": "孙景赴怀宁尉",
      "content": [
        "一行为吏日，千里背淮人。",
        "兰助朝昏膳，丝垂宛转纶。",
        "云容侵驿晓，江态引帆春。",
        "静治龙舒邑，牦生盗向秦。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13352,
      "title": "送王鼎同年尉荥阳",
      "content": [
        "毡毫联署榜，兰酒怅离杯。",
        "作吏缁衣国，工吟白社才。",
        "浮凉御风至，澄翠溢荥来。",
        "盗息连殊课，章封刺史台。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13353,
      "title": "奉节朱尉",
      "content": [
        "初命东南尉，征途上下弦。",
        "传家万石贵，结绶半纶鲜。",
        "邑籍饶岷芋，公囊满邓钱。",
        "仙才今有助，铭阁待新篇。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13354,
      "title": "送静海勾稽高洎",
      "content": [
        "豪锥残试墨，纶绶照恩裳。",
        "沿牒天官调，承家父任郎。",
        "曲长溪舫远，宴密酒螯香。",
        "得助江山国，仍缝古锦囊。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13355,
      "title": "送倪敦复朝奉",
      "content": [
        "倪侯喜清旷，遇物乃虚舟。",
        "富贵知轻视，胸怀肯误投。",
        "青云非近器，沧海纳群流。",
        "道在从藏显，功名晚可收。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13356,
      "title": "寄王共",
      "content": [
        "沸蚁云罍溢，离鹍雪苑开。",
        "吏催东府计，卿待楚人材。",
        "旧隠周萝月，前期禹凿雷。",
        "我惭芳岁晚，犹俊蹇修媒。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13357,
      "title": "寄叶道卿",
      "content": [
        "恳乞东南节，贪荣彩绣衣。",
        "禁中严助往，江上子牟归。",
        "并觉秋莼美，时惊夜鹤飞。",
        "遥知具鸡黍，日与故人挥。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13358,
      "title": "秋霁二首  其一",
      "content": [
        "晓河回北陆，夕雨净西郊。",
        "水足鱼忘喣，林寒鸟恋巢。",
        "阁苔浮绿晕，社橘老丹包。",
        "谁与同真想，清风是淡交。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13359,
      "title": "秋霁二首  其二",
      "content": [
        "气爽无余暑，天高不住阴。",
        "霞残仍是绮，风冷即名金。",
        "烟沼双鱼乐，霜郊一鹗心。",
        "此时灵运唱，无复答愁霖。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13360,
      "title": "玩晚菊",
      "content": [
        "佳节虽云晚，繁英尚独开。",
        "新醪相伴熟，寒蝶不空来。",
        "细折愁香破，长吟恐暝催。",
        "自嫌霜白鬓，将插重裴回。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13361,
      "title": "残秋霁景",
      "content": [
        "霜旻初毕雨，日气上熹微。",
        "寒水流无急，高云薄未归。",
        "书闲仍积箦，琴燥乍移徽。",
        "负郭泥妨辙，翻劳急掩扉。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13362,
      "title": "冬日呈应之",
      "content": [
        "宾席满浮埃，劳歌倦抚怀。",
        "囊风寒薄木，鹍雪夜平阶。",
        "庄室虚仍白，颜心静已斋。",
        "北山如借问，矫首谢丹崖。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13363,
      "title": "秋夕不寐",
      "content": [
        "槭槭始遥夜，骚骚无寐时。",
        "啼螀思岁晚，寒叶伴人衰。",
        "白发生将遍，丹砂化苦迟。",
        "多情是残月，通晓共遥帷。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13364,
      "title": "冬日野外  其一",
      "content": [
        "霜郊堪极目，万籁共骚骚。",
        "远水无穷绿，寒云自不高。",
        "候鸿差入渚，田雀短翔蒿。",
        "岁稔期民阜，中田馌冻醪。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13365,
      "title": "冬日野外  其二",
      "content": [
        "野迥人来少，天平鸟去长。",
        "鱼梁四寸罟，樵市五家浆。",
        "谷转留寒雾，霞休罢夕阳。",
        "不须教目极，即是到回肠。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13366,
      "title": "冬日野外  其三",
      "content": [
        "朔吹低凝野，层阴迥匝天。",
        "叶飘霜外柳，烟山烧余田。",
        "晼晚流芳后，峥嵘急景前。",
        "平生鱼鸟志，宁免为留连。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13367,
      "title": "行春野外",
      "content": [
        "绿野阳膏动，春旗出晓衢。",
        "川长罗后乘，林转隠前驱。",
        "早蕊红粘杏，轻苞紫缀榆。",
        "桑郊不敢问，直为使君愚。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13368,
      "title": "赠文雅度大士",
      "content": [
        "高腊颔髭霜，栖闲寄宝坊。",
        "秘园金侧布，薰夹字旁行。",
        "赐服恩华重，分灯祖意长。",
        "祗陀学久徧，余力在雕章。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13369,
      "title": "守岁",
      "content": [
        "已觉新杓动，犹闻促漏余。",
        "夜寒穷腊尾，春色并年初。",
        "事往成追计，身羁况索居。",
        "明朝为寿酒，无奈故人疏。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13370,
      "title": "岁晚私感",
      "content": [
        "已嗟官落魄，更值岁峥嵘。",
        "一絓区中累，千惭谷口耕。",
        "休文偏恨瘦，夷甫太钟情。",
        "借问长安米，侏儒有底荣。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13371,
      "title": "送同年叶文卿尉高邮",
      "content": [
        "桧檝舣河滣，东南再命新。",
        "还家倦游客，隠市谪仙人。",
        "驿舍霜梅早，乡壶蚁酎醇。",
        "疏林摇落尽，持底赠萧辰。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13372,
      "title": "春晏病体少悰退卧北斋有寄",
      "content": [
        "小有负薪疾，早成憔悴姿。",
        "无人来迓跛，頼酒与扶衰。",
        "朴斲知林短，腥𦝼厌席卑。",
        "西山一丸药，何忍独相遗。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13373,
      "title": "残花",
      "content": [
        "林下感余欢，流芳逐雨残。",
        "香归蜜房尽，红入燕泥干。",
        "梦短休成蝶，肠回却掩鸾。",
        "故应成异果，持去掷潘安。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13374,
      "title": "王秀才贽赋乞诗为别归毗陵",
      "content": [
        "矩步敝长裾，清漳访病夫。",
        "得交欣凤举，赏赋怯霓呼。",
        "道胜稽论秀，人遐亟去都。",
        "一篷江上雨，归思满菰芦。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13375,
      "title": "春郊晓望",
      "content": [
        "睡足犹欹枕，欢沉即掩樽。",
        "风花飞有态，烟絮坠无痕。",
        "野色兼山远，溪流涨雨浑。",
        "渊明有归意，惟是对桐孙。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13376,
      "title": "送王识游洛阳",
      "content": [
        "上京漫客刺，西道掺离裾。",
        "天倚呼嵩外，川横鬭谷余。",
        "敝𫋹琴晦轸，行笈简联书。",
        "却见槐花候，期君促计车。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13377,
      "title": "侨居二首  其一",
      "content": [
        "抱病苦幽忧，都城困倦游。",
        "身抛秃翁版，言入稗家流。",
        "世路风波恶，天涯日月遒。",
        "危心正无泊，持底喻穷愁。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13378,
      "title": "侨居二首  其二",
      "content": [
        "公宇静寥寥，居然俗意销。",
        "屐闲谁记齿，带适自忘腰。",
        "亩首秋残获，城西日暮樵。",
        "比来行乐熟，随意度溪桥。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13379,
      "title": "春晏北园三首  其一",
      "content": [
        "春物在无几，景随人意闲。",
        "笋生迷坞缺，花尽失林殷。",
        "坠絮来何所，轻云久未还。",
        "持杯问流照，肯信有朱颜。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13380,
      "title": "春晏北园三首  其二",
      "content": [
        "天意歇余芳，人闲日始长。",
        "落花风观阁，睡鸭雨池塘。",
        "稍倦持螯手，犹残婪尾觞。",
        "春归无所预，羁客自回肠。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13381,
      "title": "春晏北园三首  其三",
      "content": [
        "日晏休尘虑，中园眷物华。",
        "惊禽曳啼去，弱柳受吹斜。",
        "暝早月沈碧，凉生水进涯。",
        "悠然望层堞，千翅度昏鸦。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13382,
      "title": "屏居寄献侍讲孙尚书",
      "content": [
        "侨版农廛陋，飞灰岁琯周。",
        "危疴负薪困，生事播精求。",
        "雨露遗幽谷，乾坤占一丘。",
        "惟余道边树，独为报春游。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13383,
      "title": "和丞相小园雨霁",
      "content": [
        "霁碧凝天宙，规红转日车。",
        "鹊轻来燥枿，蜂湿抱寒花。",
        "林果高仍在，葅菘晚自嘉。",
        "须知穷僻处，要是酂侯家。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13384,
      "title": "送人归衡阳",
      "content": [
        "别曲惨鹍鸡，沿湘望翠微。",
        "人从南浦别，客向洞庭归。",
        "晓雁并芦远，宵禽负叶飞。",
        "还家落秋后，社橘老金衣。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13385,
      "title": "松",
      "content": [
        "冒雪虬枝密，凌空麈影匀。",
        "叶倾秦帝雨，华老宓妃尘。",
        "不见栖鸾客，多逢系马人。",
        "寄声遭匠石，千尺谢轮囷。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13386,
      "title": "闻蝉",
      "content": [
        "秋风日夕惊，庭树喝蝉声。",
        "衰意先𫛸鴂，繁音伴沸羹。",
        "斜阳挂高柳，落日淡遥城。",
        "此际君怀苦，非徒客子情。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13387,
      "title": "闻蝉有感三首  其一",
      "content": [
        "初闻蜀树蝉，含喝晚风前。",
        "便把凄凉意，催成摇落天。",
        "易惊惟远客，所得是流年。",
        "空腹悲何事，繁于五十弦。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13388,
      "title": "闻蝉有感三首  其二",
      "content": [
        "残蜕抛何处，新声集迥枝。",
        "岁芳鵙后妬，露信鹤前知。",
        "风坞嘶清御，霞梢咽暝规。",
        "此时兼一叶，并助长年悲。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13389,
      "title": "闻蝉有感三首  其三",
      "content": [
        "劳君惊暮节，助我思流年。",
        "嘒若横吹管，繁如未破弦。",
        "城残嘶外月，林暝噪余烟。",
        "块坐秋风里，潘郎鬓飒然。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13390,
      "title": "远行",
      "content": [
        "平原已超忽，山径亦纡余。",
        "匹练迷征马，孤蓬伴客车。",
        "江枫极目外，陇水断肠初。",
        "行行不顾返，秋露泫人裾。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13391,
      "title": "夜绪",
      "content": [
        "炎氛歇层宇，清气肃重帷。",
        "籁远天人杂，宵闲甲乙迟。",
        "江湖牵客虑，日月与人衰。",
        "经国谋安在，悠悠空我思。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13392,
      "title": "幽禽",
      "content": [
        "已伴传书燕，休随匝树鸦。",
        "春鸣变高柳，暮散落余花。",
        "格磔林烟迥，啁啾观月斜。",
        "宁同七十二，镇在莫愁家。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13393,
      "title": "集江渎池亭",
      "content": [
        "五月追凉地，沧江剩素涟。",
        "林烟昏午日，楼影压池天。",
        "筿密工迷径，荷欹巧避船。",
        "机忘更何事，鱼鸟亦留连。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13394,
      "title": "出郊",
      "content": [
        "茂草平堪藉，长杨绿自垂。",
        "郊晴艾帐远，桥迥犊车迟。",
        "有鹤迎飞盖，无蛇赌赐巵。",
        "秦楼何用识，马尾结青丝。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13395,
      "title": "清晖亭",
      "content": [
        "亭外大江流，亭前万里舟。",
        "春波赋别地，秋水送归愁。",
        "客路风烟阔，年光日月遒。",
        "瑶华何所为，从古伴离忧。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13396,
      "title": "不言",
      "content": [
        "不言非巧宦，要是乏高符。",
        "托社天教散，为公谷与愚。",
        "桂枝怀隠树，荆叶恋欢株。",
        "荣路多高足，争传八列呼。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13397,
      "title": "朝天岭",
      "content": [
        "天岭循归道，征旟面早暾。",
        "滩声逢石怒，山气附林昏。",
        "谷啭如禽哢，尘交作马痕。",
        "萋萋芳草意，无乃为王孙。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13398,
      "title": "读张巡故事",
      "content": [
        "叛将闚华日，英臣死节年。",
        "城当劲兵处，人甚缀旒然。",
        "直木摧贪隧，长隄制盗泉。",
        "羯尘虽覆马，不污沛南天。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13399,
      "title": "兔",
      "content": [
        "脱兔驰冈地，饥鹰厉吻天。",
        "为烦麋狗顾，遂给兽人鲜。",
        "狂目兼槐落，惊毫共月捐。",
        "可嗟多狡穴，归肉助庖膻。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13400,
      "title": "江休复潞掾",
      "content": [
        "君家能赋别，释褐重凄然。",
        "客袂移缁素，离杯并圣贤。",
        "坐曹烦折狱，奏牍𥩟怀铅。",
        "十载青袍困，须饶草色鲜。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13401,
      "title": "同年李宗太平法掾",
      "content": [
        "俊名参吏启，掾事补编堂。",
        "尽取黄金酒，重纡碧鹤裳。",
        "佐庖鲑菜厚，束帙秘厨香。",
        "认得公庭步，鬑须白皙郎。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13402,
      "title": "答安陆庞掾",
      "content": [
        "囊文尝奏御，军事此参卿。",
        "座隘升堂友，乡荣乞墅甥。",
        "清言飘麈毳，慎疾搴芝英。",
        "谈幄尸官久，烦襟怯报琼。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13403,
      "title": "出城暂憩林下",
      "content": [
        "下马清林下，翛然忘俗情。",
        "山禽不辨种，溪草尽无名。",
        "露笋披斑箬，风葩抗紫茎。",
        "徘徊漱岩溜，未忍濯尘缨。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13404,
      "title": "林下",
      "content": [
        "林下追凉久，山西反照初。",
        "兰苕香自怨，蝉腹饱犹虚。",
        "李暗倾冠外，棋残折屐余。",
        "萧然臯壤乐，何必羡池鱼。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13405,
      "title": "南国",
      "content": [
        "南国豪华地，东风骀荡天。",
        "露兰薰夕梦，烟柳重春眠。",
        "歌断云空度，书长燕未传。",
        "吟成休自许，芳草更绵绵。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13406,
      "title": "送巩汉卿同年赴五原理掾",
      "content": [
        "再赴天官调，仍还多士乡。",
        "华阴余雾散，光禄故垣长。",
        "春柳侵湖绿，秋云际幕黄。",
        "片言民讼息，编美冠州堂。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13407,
      "title": "冯彭年苏州法掾",
      "content": [
        "竹箭征舻驶，骊驹客袂分。",
        "倦游销仲产，参事厌卿军。",
        "象阙天中隔，乡朝月外闻。",
        "西山朝气爽，拄颊待谈云。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13408,
      "title": "吏上",
      "content": [
        "吏上重门钥，楼喧叠鼓挝。",
        "翠沈遥岭树，红敛暝丛花。",
        "杼促虫声急，眉拖月魄斜。",
        "烦心销热尽，不待镇嘉瓜。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13409,
      "title": "曲幌",
      "content": [
        "曲幌囊风入，前轩峡雨收。",
        "醉罗初解夕，珍簟暗知秋。",
        "衰柳金城恨，幽兰楚国愁。",
        "更堪闻短笛，珪月在西楼。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13410,
      "title": "林缺",
      "content": [
        "林缺榛苞绽，溪平芡嘴开。",
        "衰烟稍辞柳，寒雨并饶苔。",
        "天意凄凄早，乡愁衮衮来。",
        "此时论四戚，方验楚人材。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13411,
      "title": "送朱十翁",
      "content": [
        "手把临涡酒，人归如梦城。",
        "何言一欢笑，便作两离情。",
        "园树丹蕤老，家山钿髻明。",
        "不妨还轸促，芝崦趁春耕。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13412,
      "title": "司马相如琴台",
      "content": [
        "故台千古恨，犹对旧家山。",
        "半夜鸾凰去，他年驷马还。",
        "死忧封禅晚，生爱茂陵闲。",
        "惟有飘飘气，仍存天地间。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13413,
      "title": "黄孝基归上饶",
      "content": [
        "街徼曙冬喧，行人岸舣船。",
        "杓星背城隠，萍日过江圆。",
        "雾晦书囊竹，尘昏剑室莲。",
        "他时汉廷用，未减贾生年。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13414,
      "title": "送谢处士南归",
      "content": [
        "岁晏心无著，时清遁更肥。",
        "江莼萦箸滑，海鸟傍帆飞。",
        "乡思生闽雾，吟怀入楚霏。",
        "趋庭多令子，彩服间荷衣。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13415,
      "title": "登望台",
      "content": [
        "年华无限景，况复上高台。",
        "晓气先明树，春寒不著梅。",
        "幽禽仍早啭，戏蝶即双来。",
        "此地流霞意，同谁一釂杯。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13416,
      "title": "连秀才东归",
      "content": [
        "烟树徧云中，迎君马首东。",
        "鸣鸡关下晓，归鸟汉阳穷。",
        "倦客辞城阙，深耕托灌丛。",
        "还将数日恶，故故恼衰翁。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13417,
      "title": "徐帅北归",
      "content": [
        "旧国青山阔，仙岩绿桂春。",
        "金壶柱史客，玉札上清人。",
        "学雾应成市，泠风肯待旬。",
        "他年留半剂，牝谷愿凝神。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13418,
      "title": "北归",
      "content": [
        "一水清波驶，还将桧檝归。",
        "缨緌成素滥，猿鹤恐长违。",
        "斗外城隅出，云端阙影微。",
        "定知朝夕鸟，却望汉台飞。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13419,
      "title": "宣徽太尉郑公挽词二首  其一",
      "content": [
        "秘幄留高议，雄边倚茂勋。",
        "风流自南国，礼乐得中军。",
        "卧疾初无损，遗忠忍遽闻。",
        "寝门今日恸，长作死生分。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13420,
      "title": "宣徽太尉郑公挽词二首  其二",
      "content": [
        "谁为云亡恨，曾无可赎身。",
        "江山归国路，桃李泣蹊人。",
        "追册君恩厚，题功史笔新。",
        "所嗟经济事，不及相平津。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13421,
      "title": "肃简鲁公挽词四首  其一",
      "content": [
        "拂世谟谋盛，端朝载采熙。",
        "上前推汲直，天下咏曹随。",
        "密启多焚草，加餐餍嗜葵。",
        "不图霜露疾，奄忽丧元龟。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13422,
      "title": "肃简鲁公挽词四首  其二",
      "content": [
        "震邸陪翔凤，天坛侍祭牲。",
        "参谋大丞相，别对小延英。",
        "上栋方隆国，颓山遽奠楹。",
        "武公年不至，辅德是功名。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13423,
      "title": "肃简鲁公挽词四首  其三",
      "content": [
        "忧国神无爱，呼医体寖臞。",
        "人忧一台坼，帝遣两驺扶。",
        "临视回襄御，遗言入舜谟。",
        "七兵荣赠册，沉础贲龟趺。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13424,
      "title": "肃简鲁公挽词四首  其四",
      "content": [
        "密勿千龄旦，生平三命恭。",
        "承家男得凤，择婿女乘龙。",
        "酂邑穷遗产，邢山卜素封。",
        "空余吊客泪，倾海望长松。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13425,
      "title": "王沂公挽词三首  其一",
      "content": [
        "尽瘁辞当国，均劳得偃藩。",
        "幄中留秘画，天下满危言。",
        "日企还三事，宁图閟九原。",
        "谁将河海泪，一洒问乾坤。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13426,
      "title": "王沂公挽词三首  其二",
      "content": [
        "下阁成忧疢，飞邮走诏医。",
        "遵鸿徒望渚，浴凤不归池。",
        "宣室君朝罢，翘车客涕垂。",
        "正应廊庙上，画一奉萧规。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13427,
      "title": "王沂公挽词三首  其三",
      "content": [
        "翣路风号野，松阡水溢荥。",
        "滕君今见日，傅魄上骑星。",
        "诒训金籯满，图功籀史青。",
        "空嗟令君坐，千古掩余馨。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13428,
      "title": "卜居",
      "content": [
        "自乐颜居陋，非论晏市嚣。",
        "西山宜托疾，东路便归樵。",
        "穴邃狐情乐，巢完鸟意遥。",
        "居然深隠去，宁待左生招。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13429,
      "title": "访隠者不遇",
      "content": [
        "青萝白石扉，霞薄动春晖。",
        "鹤去书空在，凫闲舄自飞。",
        "骖鸾僊驭远，出岫昔心违。",
        "拂衽雄风动，犹疑御寇归。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13430,
      "title": "退居五首  其一",
      "content": [
        "干禄非三釜，躬耕恋一丘。",
        "才无作奏巧，穷有著书愁。",
        "雀噪门罗晚，蓬飞鬓葆秋。",
        "平生鸥鸟志，未去恋沧洲。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13431,
      "title": "退居五首  其二",
      "content": [
        "贫极非关病，忧多信自伤。",
        "悲歌一顷豆，惊馈五家浆。",
        "拥耒宜耕石，沈钩岂为璜。",
        "中林环室在，开径望求羊。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13432,
      "title": "退居五首  其三",
      "content": [
        "昔愧公车牍，今投海岸簪。",
        "逢齑还忌热，居陆更忧沈。",
        "楚岫偏藏玉，燕台岂乏金。",
        "前途见杨阮，只是有沾襟。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13433,
      "title": "退居五首  其四",
      "content": [
        "利固惭龙断，长非累纆牵。",
        "难求迎鲋水，空望戴盆天。",
        "喘急常悲月，惊多遂恶弦。",
        "诚非穷者叹，民颂正尧年。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13434,
      "title": "退居五首  其五",
      "content": [
        "勇退方藏密，营生信有涯。",
        "千株素封栗，五色故侯瓜。",
        "虞骨诚非媚，潘毛故易华。",
        "履穿谁复问，新进竞青緺。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13435,
      "title": "咏苔",
      "content": [
        "雨墙苍晕合，烟渚碧纹通。",
        "赋阁并尘掩，诗阶伴药红。",
        "萍流烦结实，絮乱枉因风。",
        "少閟回肠恨，春闺隔岁空。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13436,
      "title": "南斋二首  其一",
      "content": [
        "隠有山林愿，闲非江海身。",
        "孔书罕言命，庄意暗同人。",
        "敢衒能鸣雁，须惭不猎鹑。",
        "缘何无丽句，多病极漳滨。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13437,
      "title": "南斋二首  其二",
      "content": [
        "曩宦缘三釜，今归分一丘。",
        "杯棬非柳性，涂尾是龟谋。",
        "薪意矜来仕，瓜名托故侯。",
        "恍然桑下计，蚕妾讵相尤。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13438,
      "title": "哀故文节公  其一",
      "content": [
        "早传黄石系，未伴赤松游。",
        "暴疹惊床蚁，深恩赐养牛。",
        "谿璜俄碎玉，川檝遂藏舟。",
        "萧相今无嗣，夫人绍酂侯。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13439,
      "title": "哀故文节公  其二",
      "content": [
        "顺采思忠荩，宣谋叹巧劳。",
        "憗遗无一老，投吊剩三号。",
        "撤奠哀笳引，追荣敛衮褒。",
        "欲知凭厚庆，弟览得传刀。"
