{
  "data": [
    {
      "id": 314198,
      "title": "朝中措",
      "content": [
        "身闲身健是生涯。",
        "何况好年华。",
        "看了十分秋月，重阳更插黄花。",
        "消磨景物，瓦盆社酿，石鼎山茶。",
        "饱吃红莲香饭，侬家便是仙家。"
      ],
      "author": {
        "id": 9909,
        "name": "范成大"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314199,
      "title": "朝中措",
      "content": [
        "系船沽酒碧帘坊。",
        "酒满胜鹅黄。",
        "醉后西园入梦，东风柳色花香。",
        "水浮天处，夕阳如锦，恰似鲈乡。",
        "中有忆人双泪，几时流到横塘。"
      ],
      "author": {
        "id": 9909,
        "name": "范成大"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314200,
      "title": "朝中措",
      "content": [
        "海棠如雪殿春馀。",
        "禽弄晚晴初。",
        "倦客长惭杜宇，佳辰且醉提壶。",
        "逍遥放浪，还他渔子，输与樵夫。",
        "一棹何时归去，扁舟终要江湖。"
      ],
      "author": {
        "id": 9909,
        "name": "范成大"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314201,
      "title": "朝中措",
      "content": [
        "天容云意写秋光。",
        "木叶半青黄。",
        "珍重西风祛暑，轻衫早怯新凉。",
        "故人情分，留连病客，孤负轻觞。",
        "陌上千愁易散，尊前一笑难忘。"
      ],
      "author": {
        "id": 9909,
        "name": "范成大"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314202,
      "title": "蝶恋花",
      "content": [
        "春涨一篙添水面。",
        "芳草鹅儿，绿满微风岸。",
        "画舫夷犹湾百转。",
        "横塘塔近依前远。",
        "江国多寒农事晚。",
        "村北村南，谷雨才耕遍。",
        "秀麦连冈桑叶贱。",
        "看看尝面收新茧。"
      ],
      "author": {
        "id": 9909,
        "name": "范成大"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314203,
      "title": "南柯子・南歌子",
      "content": [
        "槁项诗馀瘦，愁肠酒后柔。",
        "晚凉团扇欲知秋。",
        "卧看明河银影、界天流。",
        "鹤警人初静，虫吟夜更幽。",
        "佳辰只合算花筹。",
        "除了一天风月、更何求。"
      ],
      "author": {
        "id": 9909,
        "name": "范成大"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314204,
      "title": "南柯子・南歌子",
      "content": [
        "怅望梅花驿，凝情杜若洲。",
        "香云低处有高楼。",
        "可惜高楼、不近木兰舟。",
        "缄素双鱼远，题红片叶秋。",
        "欲凭江水寄离愁。",
        "江已东流、那肯更西流。"
      ],
      "author": {
        "id": 9909,
        "name": "范成大"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314205,
      "title": "南柯子・南歌子",
      "content": [
        "银渚盈盈渡，金风缓缓吹。",
        "晚香浮动五云飞。",
        "月姊妒人、颦尽一弯眉。",
        "短夜难留处，斜河欲淡时。",
        "半愁半喜是佳期。",
        "一度相逢、添得两相思。"
      ],
      "author": {
        "id": 9909,
        "name": "范成大"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314206,
      "title": "水调歌头",
      "content": [
        "细数十年事，十处过中秋。",
        "今年新梦，忽到黄鹤旧山头。",
        "老子个中不浅，此会天教重见，今古一南楼。",
        "星汉淡无色，玉镜独空浮。",
        "敛秦烟，收楚雾，熨江流。",
        "关河离合，南北依旧照清愁。",
        "想见姮娥冷眼，应笑归来双鬓，空敞黑貂裘。",
        "酾酒问蟾兔，肯去伴沧洲。"
      ],
      "author": {
        "id": 9909,
        "name": "范成大"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314207,
      "title": "水调歌头",
      "content": [
        "万里汉家使，双节照清秋。",
        "旧京行遍，中夜呼禹济黄流。",
        "寥落桑榆西北，无限太行紫翠，相伴过芦沟。",
        "岁晚客多病，风露冷貂裘。",
        "对重九，须烂醉，莫牢愁。",
        "黄花为我，一笑不管鬓霜羞。",
        "袖里天书咫尺，眼底关河百二，歌罢此生浮。",
        "惟有平安信，随雁到南州。"
      ],
      "author": {
        "id": 9909,
        "name": "范成大"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314208,
      "title": "西江月",
      "content": [
        "十月谁云春小，一年两见风娇。",
        "云英此夕度蓝桥。",
        "人意花枝都好。",
        "百媚朝天淡粉，六铢步月生绡。",
        "人间霜叶满庭皋，别有东风不老。"
      ],
      "author": {
        "id": 9909,
        "name": "范成大"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314209,
      "title": "西江月",
      "content": [
        "北客开眉乐岁，东君著意华年。",
        "遮风藏雨晚云天。",
        "应怕杏梢红浅。",
        "不惜灯前放夜，从教雪后留寒。",
        "水晶帘箔万花钿。",
        "听彻南楼晓箭。"
      ],
      "author": {
        "id": 9909,
        "name": "范成大"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314210,
      "title": "鹊桥仙",
      "content": [
        "双星良夜，耕慵织懒，应被群仙相妒。",
        "娟娟月姊满眉颦，更无奈、风姨吹雨。",
        "相逢草草，争如休见，重搅别离心绪。",
        "新欢不抵旧愁多，倒添了、新愁归去。"
      ],
      "author": {
        "id": 9909,
        "name": "范成大"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314211,
      "title": "宜男草",
      "content": [
        "篱菊滩芦被霜后。",
        "袅长风、万重高柳。",
        "天为谁、展尽湖光渺渺，应为我、扁舟入手。",
        "橘中曾醉洞庭酒。",
        "辗云涛、挂帆南斗。",
        "追旧游、不减商山杳杳，犹有人、能相记否。"
      ],
      "author": {
        "id": 9909,
        "name": "范成大"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314212,
      "title": "宜男草",
      "content": [
        "舍北烟霏舍南浪。",
        "雪倾篱、雨荒薇涨。",
        "问小桥、别后谁过，惟有迷鸟羁雌来往。",
        "重寻山水问无恙。",
        "扫柴荆、土花尘网。",
        "留小桃、先试光风，从此芝草琅玕日长。"
      ],
      "author": {
        "id": 9909,
        "name": "范成大"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314213,
      "title": "秦楼月・忆秦娥",
      "content": [
        "窗纱薄。",
        "日穿红幔催梳掠。",
        "催梳掠。",
        "新晴天气，画檐闻鹊。",
        "海棠逗晓都开却。",
        "小云先在阑干角。",
        "阑干角。",
        "杨花满地，夜来风恶。"
      ],
      "author": {
        "id": 9909,
        "name": "范成大"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314214,
      "title": "秦楼月・忆秦娥",
      "content": [
        "珠帘狭。",
        "卷帘春院花围合。",
        "花围合。",
        "昼长人静，双双胡蝶。",
        "花前苦𣨼金蕉叶。",
        "瞢腾午睡扶头怯。",
        "扶头怯。",
        "闲愁无限，远山斜叠。"
      ],
      "author": {
        "id": 9909,
        "name": "范成大"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314215,
      "title": "秦楼月・忆秦娥",
      "content": [
        "香罗薄。",
        "带围宽尽无人觉。",
        "无人觉。",
        "东风日暮，一帘花落。",
        "西园空锁秋千索。",
        "帘垂帘卷闲池阁。",
        "闲池阁。",
        "黄昏香火，画楼吹角。"
      ],
      "author": {
        "id": 9909,
        "name": "范成大"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314216,
      "title": "秦楼月・忆秦娥",
      "content": [
        "楼阴缺。",
        "阑干影卧东厢月。",
        "东厢月。",
        "一天风露，杏花如雪。",
        "隔烟催漏金虬咽。",
        "罗帏暗淡灯花结。",
        "灯花结。",
        "片时春梦，江南天阔。"
      ],
      "author": {
        "id": 9909,
        "name": "范成大"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314217,
      "title": "秦楼月・忆秦娥",
      "content": [
        "浮云集。",
        "轻雷隐隐初惊蛰。",
        "初惊蛰。",
        "鹁鸠鸣怒，绿杨风急。",
        "玉炉烟重香罗浥。",
        "拂墙浓杏燕支湿。",
        "燕支湿。",
        "花梢缺处，画楼人立。"
      ],
      "author": {
        "id": 9909,
        "name": "范成大"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314218,
      "title": "念奴娇",
      "content": [
        "双峰叠障，过天风海雨，无边空碧。",
        "月姊年年应好在，玉阕琼宫愁寂。",
        "谁唤痴云，一杯为尽，夜气寒无色。",
        "碧城凝望，高楼飘渺西北。",
        "肠断桂冷蟾孤，佳期如梦，又把阑干拍。",
        "雾鬓风鬟相借问，浮世几回今夕。",
        "圆缺晴阴，古今同恨，我更长为客。",
        "婵娟明夜，尊前谁念南陌。"
      ],
      "author": {
        "id": 9909,
        "name": "范成大"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314219,
      "title": "念奴娇",
      "content": [
        "十年旧事，醉京花蜀酒，万葩千萼。",
        "一棹归来吴下看，俯仰心情今昨。",
        "强倚雕阑，羞簪雪鬓，老恐花枝觉。",
        "揩摹愁眼，雾中相对依约。",
        "闻道家宴团栾，光风转夜，月傍西楼落。",
        "打彻梁州春自远，不饮何时欢乐。",
        "沾惹天香，留连国艳，莫散灯前酌。",
        "袜尘生处，为君重赋河洛。"
      ],
      "author": {
        "id": 9909,
        "name": "范成大"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314220,
      "title": "念奴娇",
      "content": [
        "吴波浮动，看中流翻月，半江金碧。",
        "醉舞空明三万顷，不管姮娥愁寂。",
        "指点琼楼，凭虚有路，鲸背横东极。",
        "水云飘荡，阑干千丈无力。",
        "家世回首沧洲，烟波渔钓，有鸱夷仙迹。",
        "一笑闲身游物外，来访扁舟消息。",
        "天上今宵，人间此地，我是风前客。",
        "涛生残夜，鱼龙惊听横笛。"
      ],
      "author": {
        "id": 9909,
        "name": "范成大"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314221,
      "title": "念奴娇",
      "content": [
        "水乡霜落，望西山一寸，修眉横碧。",
        "南浦潮生帆影去，日落天青江白。",
        "万里浮云，被风吹散，又被风吹积。",
        "尊前歌罢，满空凝淡寒色。",
        "人世会少离多，都来名利，似蝇头蝉翼。",
        "赢得长亭车马路，千古羁愁如织。",
        "我辈情锺，匆匆相见，一笑真难得。",
        "明年谁健，梦魂飘荡南北。"
      ],
      "author": {
        "id": 9909,
        "name": "范成大"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314222,
      "title": "念奴娇",
      "content": [
        "湖山如画，系孤篷柳岸，莫惊鱼鸟。",
        "料峭春寒花未遍，先共疏梅索笑。",
        "一梦三年，松风依旧，萝月何曾老。",
        "邻家相问，这回真个归到。",
        "绿鬓新点吴霜，尊前强健，不怕衰翁号。",
        "赖有风流车马客，来觅香云花岛。",
        "似我粗豪，不通姓字，只有银瓶倒。",
        "奔名逐利，乱帆谁在天表。"
      ],
      "author": {
        "id": 9909,
        "name": "范成大"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314223,
      "title": "惜分飞",
      "content": [
        "易散浮云难再聚。",
        "遮莫相随百步。",
        "谁唤行人去。",
        "石湖烟浪渔樵侣。",
        "重别西楼肠断否。",
        "多少凄风苦雨。",
        "休梦江南路。",
        "路长梦短无寻处。"
      ],
      "author": {
        "id": 9909,
        "name": "范成大"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314224,
      "title": "梦玉人引",
      "content": [
        "送行人去，犹追路、再相觅。",
        "天末交情，长是合堂同席。",
        "从此尊前，便顿然少个，江南羁客。",
        "不忍匆匆，少驻船梅驿。",
        "酒斟虽满，尚少如、别泪万千滴。",
        "欲语吞声，结心相对呜咽。",
        "冬火凄清，笙歌无颜色。",
        "从别后，尽相忘，算也难忘今夕。"
      ],
      "author": {
        "id": 9909,
        "name": "范成大"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314225,
      "title": "梦玉人引",
      "content": [
        "共登临处，飘风袂、倚空碧。",
        "雨卷云飞，长有桂娥看客。",
        "箫鼓生春，遍锦城如画，雪山无色。",
        "一梦才成，恍天涯南北。",
        "舞馀歌罢，料宣华、回首尽陈迹。",
        "万里秦吴，有情应问消息。",
        "我欲归耕，如何重来得。",
        "故人若望江南，且折梅花相忆。"
      ],
      "author": {
        "id": 9909,
        "name": "范成大"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314226,
      "title": "如梦令",
      "content": [
        "罨画屏中客住。",
        "水色山光无数。",
        "斜日满江声，何处撑来小渡。",
        "休去。",
        "休去。",
        "惊散一舟鸥鹭。"
      ],
      "author": {
        "id": 9909,
        "name": "范成大"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314227,
      "title": "如梦令",
      "content": [
        "两两莺啼何许。",
        "寻遍绿阴浓处。",
        "天气润罗衣，病起却忺微暑。",
        "休雨。",
        "休雨。",
        "明日榴花端午。"
      ],
      "author": {
        "id": 9909,
        "name": "范成大"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314228,
      "title": "菩萨蛮",
      "content": [
        "小轩今日开窗了。",
        "揉蓝染碧绿阶草。",
        "檐佩可怜风。",
        "杏梢烟雨红。",
        "飘零欢事少。",
        "鬓点吴霜早。",
        "天色不愁人。",
        "眼前无限春。"
      ],
      "author": {
        "id": 9909,
        "name": "范成大"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314229,
      "title": "菩萨蛮",
      "content": [
        "雪林一夜收寒了。",
        "东风恰向灯前到。",
        "今夕是何年。",
        "新春新月圆。",
        "绮丛香雾隔。",
        "犹记疏狂客。",
        "留取缕金旛。",
        "夜蛾相并看。"
      ],
      "author": {
        "id": 9909,
        "name": "范成大"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314230,
      "title": "菩萨蛮",
      "content": [
        "黄梅时节春萧索。",
        "越罗香润吴纱薄。",
        "丝雨日昽明。",
        "柳梢红未晴。",
        "多愁多病后。",
        "不识会中酒。",
        "愁病送春归。",
        "恰如中酒时。"
      ],
      "author": {
        "id": 9909,
        "name": "范成大"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314231,
      "title": "临江仙",
      "content": [
        "羽扇纶巾风袅袅，东厢月到蔷薇。",
        "新声谁唤出罗帏。",
        "龙须将笛绕，雁字入筝飞。",
        "陶写中年须个里，留连月扇云衣。",
        "周郎去后赏音稀。",
        "为君持酒听，那肯带春归。"
      ],
      "author": {
        "id": 9909,
        "name": "范成大"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314232,
      "title": "临江仙",
      "content": [
        "万事灰心犹薄宦，尘埃未免劳形。",
        "故人相见似河清。",
        "恰逢梅柳动，高兴逐春生。",
        "卜昼匆匆还卜夜，仍须月坠河倾。",
        "明年我去白鸥盟。",
        "金闺三玉树，好问紫霄程。"
      ],
      "author": {
        "id": 9909,
        "name": "范成大"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314233,
      "title": "减字木兰花",
      "content": [
        "玉烟浮动。",
        "银阕三山连海冻。",
        "翠袖阑干。",
        "不怕楼高酒力寒。",
        "双松冻折。",
        "忽忆衰翁容易别。",
        "想见鸥边。",
        "压损年时小钓船。"
      ],
      "author": {
        "id": 9909,
        "name": "范成大"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314234,
      "title": "减字木兰花",
      "content": [
        "折残金菊。",
        "枨子香时新酒熟。",
        "谁伴芳尊。",
        "先问梅花借小春。",
        "道人破戒。",
        "染酒题诗金凤带。",
        "愁病相关。",
        "不似年时酒量宽。"
      ],
      "author": {
        "id": 9909,
        "name": "范成大"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314235,
      "title": "减字木兰花",
      "content": [
        "波娇鬓袅。",
        "中隐堂前人意好。",
        "不奈春何。",
        "拚却轻寒透薄罗。",
        "翦梅新曲。",
        "欲断还联三叠促。",
        "围坐风流。",
        "饶我尊前第一筹。"
      ],
      "author": {
        "id": 9909,
        "name": "范成大"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314236,
      "title": "减字木兰花",
      "content": [
        "枕书睡熟。",
        "珍重月明相伴宿。",
        "宝鸭金寒。",
        "香满围屏宛转山。",
        "鸡人声杳。",
        "瑶井玉绳相对晓。",
        "黯淡窗纱。",
        "却下风帘护烛花。"
      ],
      "author": {
        "id": 9909,
        "name": "范成大"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314237,
      "title": "减字木兰花",
      "content": [
        "腊前三白。",
        "春到西园还见雪。",
        "红紫花迟。",
        "借作东风万玉枝。",
        "归田计决。",
        "麦饭熟时应快活。",
        "身在高楼。",
        "心在山阴一叶舟。"
      ],
      "author": {
        "id": 9909,
        "name": "范成大"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314238,
      "title": "鹧鸪天",
      "content": [
        "休舞银貂小契丹。",
        "满堂宾客尽关山。",
        "从今袅袅盈盈处，谁复端端正正看。",
        "模泪易，写愁难。",
        "潇湘江上竹枝斑。",
        "碧云日暮无书寄，寥落烟中一雁寒。"
      ],
      "author": {
        "id": 9909,
        "name": "范成大"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314239,
      "title": "鹧鸪天",
      "content": [
        "荡漾西湖采绿苹。",
        "扬鞭南埭衮红尘。",
        "桃花暖日茸茸笑，杨柳光风浅浅颦。",
        "章贡水，郁孤云。",
        "多情争似桂江春。",
        "崔徽卷轴瑶姬梦，纵有相逢不是真。"
      ],
      "author": {
        "id": 9909,
        "name": "范成大"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314240,
      "title": "鹧鸪天",
      "content": [
        "嫩绿重重看得成。",
        "曲栏幽槛小红英。",
        "酴醿架上蜂儿闹，杨柳行间燕子轻。",
        "春婉娩，客飘零。",
        "残花浅酒片时清。",
        "一杯且买明朝事，送了斜阳月又生。"
      ],
      "author": {
        "id": 9909,
        "name": "范成大"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314241,
      "title": "鹧鸪天",
      "content": [
        "压蕊拈须粉作团。",
        "疏香辛苦颤朝寒。",
        "须知风月寻常见，不似层层带雪看。",
        "春髻重，晓眉弯。",
        "一枝斜并缕金旛。",
        "酒红不解东风冻，惊怪钗头玉燕干。"
      ],
      "author": {
        "id": 9909,
        "name": "范成大"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314242,
      "title": "好事近",
      "content": [
        "云暮暗千山，肠断玉楼金阕。",
        "应是高唐小妇，妒姮娥清绝。",
        "夜凉不放酒杯寒，醉眼渐生缬。",
        "何待桂花相照，有人人如月。"
      ],
      "author": {
        "id": 9909,
        "name": "范成大"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314243,
      "title": "好事近",
      "content": [
        "昨夜报春来，的皪岭梅开雪。",
        "携手玉人同赏，比看谁奇绝。",
        "阑干倚遍忆多情，怕角声呜咽。",
        "与折一枝斜戴，衬鬓云梳月。"
      ],
      "author": {
        "id": 9909,
        "name": "范成大"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314244,
      "title": "卜算子",
      "content": [
        "凉夜竹堂虚，小睡匆匆醒。",
        "银漏无声月上阶，满地阑干影。",
        "何处最知秋，风在梧桐井。",
        "不惜骖鸾弄玉箫，露湿衣裳冷。"
      ],
      "author": {
        "id": 9909,
        "name": "范成大"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314245,
      "title": "卜算子",
      "content": [
        "云压小桥深，月到重门静。",
        "冷蕊疏枝半不禁，更著横窗影。",
        "回首故园春，往事难重省。",
        "半夜清香入梦来，从此熏炉冷。"
      ],
      "author": {
        "id": 9909,
        "name": "范成大"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314246,
      "title": "三登乐",
      "content": [
        "一碧鳞鳞，横万里、天垂吴楚。",
        "四无人、橹声自语。",
        "向浮云、西下处，水村烟树。",
        "何处系船，暮涛涨浦。",
        "正江南、遥落后，好山无数。",
        "尽乘流、兴来便去。",
        "对青灯、独自叹，一生羁旅。",
        "敧枕梦寒，又还夜雨。"
      ],
      "author": {
        "id": 9909,
        "name": "范成大"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314247,
      "title": "三登乐",
      "content": [
        "路转横塘，风卷地、水肥帆饱。",
        "眼双明、旷怀浩渺。",
        "问菟裘、无恙否，天教重到。",
        "木落雾收，故山更好。",
        "过溪门、休荡桨，恐惊鱼鸟。",
        "算年来、识翁者少。",
        "喜山林、踪迹在，何曾如扫。",
        "归宾任霜，醉红未老。"
      ],
      "author": {
        "id": 9909,
        "name": "范成大"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314248,
      "title": "三登乐",
      "content": [
        "今夕何朝，披岫幌、云关重启。",
        "引冰壶、素空似洗。",
        "卷帘中、敧枕上，月星浮水。",
        "天镜夜明，半窗万里。",
        "盼庭柯、都老大，树犹如此。",
        "六年前、转头未几。",
        "唤邻翁、来话旧，同𥬠新蚁。",
        "秉烛夜阑，又疑梦里。"
      ],
      "author": {
        "id": 9909,
        "name": "范成大"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314249,
      "title": "三登乐",
      "content": [
        "方帽卫寒，重检校、旧时农圃。",
        "荒三径、不知何许。",
        "但姑苏台下，有苍然平楚。",
        "人笑此翁，又来访古。",
        "况五湖、元自有，扁舟祖武。",
        "记沧洲、白鸥伴侣。",
        "叹年来、孤负了，一蓑烟雨。",
        "寂寞暮潮，唤回棹去。"
      ],
      "author": {
        "id": 9909,
        "name": "范成大"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314250,
      "title": "浪淘沙",
      "content": [
        "黯淡养花天。",
        "小雨能悭。",
        "烟轻云薄有无间。",
        "官柳丝丝都绿遍，犹有春寒。",
        "空翠湿征鞍。",
        "马首千山。",
        "多情若是肯俱还。",
        "别有玉杯承露冷，留共君看。"
      ],
      "author": {
        "id": 9909,
        "name": "范成大"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314251,
      "title": "虞美人",
      "content": [
        "霜馀好探梅消息。",
        "日日溪桥侧。",
        "不如君有似梅人。",
        "歌里工颦妍笑、两眉春。",
        "疏枝冷蕊风情少。",
        "却称衰翁老。",
        "从教来作静中邻。",
        "冷淡无言无笑、也无颦。"
      ],
      "author": {
        "id": 9909,
        "name": "范成大"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314252,
      "title": "虞美人",
      "content": [
        "落梅时节冰轮满。",
        "何似中秋看。",
        "琼楼玉宇一般明。",
        "只为姮娥、添了万枝灯。",
        "锦江城下杯残后。",
        "还照鄞江酒。",
        "天东相见说天西。",
        "除却衰翁和月、更谁知。"
      ],
      "author": {
        "id": 9909,
        "name": "范成大"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314253,
      "title": "虞美人",
      "content": [
        "玉箫惊报同云重。",
        "仍怪金瓶冻。",
        "清明将近雪花翻。",
        "不道海堂消瘦、柳丝寒。",
        "王孙沈醉狨毡幕。",
        "谁怕罗衣薄。",
        "烛灯香雾两厌厌。",
        "仿佛有人愁损、上眉尖。"
      ],
      "author": {
        "id": 9909,
        "name": "范成大"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314254,
      "title": "虞美人",
      "content": [
        "谁将击碎珊瑚玉。",
        "装上交枝粟。",
        "恰如娇小万琼妃。",
        "涂罢额黄、嫌怕污燕支。",
        "夜深未觉清香绝。",
        "风露溶溶月。",
        "满身花影弄凄凉。",
        "无限月和风露、一齐香。"
      ],
      "author": {
        "id": 9909,
        "name": "范成大"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314255,
      "title": "醉落魄・一斛珠",
      "content": [
        "春城胜绝。",
        "暮林风舞催花发。",
        "垂云卷尽添空阔。",
        "吹上新年，美满十分月。",
        "红蕖影下勾丝抹。",
        "老来牵强随时节。",
        "无人知道心情别。",
        "唯有蛾儿，惊见鬓边雪。"
      ],
      "author": {
        "id": 9909,
        "name": "范成大"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314256,
      "title": "步虚词・西江月",
      "content": [
        "珠霄境，却似化人宫。",
        "梵气弥罗融万象，玉楼十二倚清空。",
        "一片宝光中。"
      ],
      "author": {
        "id": 9909,
        "name": "范成大"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314257,
      "title": "步虚词・西江月",
      "content": [
        "浮黎路，依约太微间。",
        "雪色宝阶千万丈，人间遥作白虹看。",
        "幢节度高寒。"
      ],
      "author": {
        "id": 9909,
        "name": "范成大"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314258,
      "title": "步虚词・西江月",
      "content": [
        "罡风起，背负玉虚廷。",
        "九素烟中寒一色，扶阑四面是青冥。",
        "环拱万珠星。"
      ],
      "author": {
        "id": 9909,
        "name": "范成大"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314259,
      "title": "步虚词・西江月",
      "content": [
        "流铃响，龙驭𥬞云来。",
        "夹道骞华龙彩仗，红云扶辂辗天街。",
        "迎驾鹤毰毸。"
      ],
      "author": {
        "id": 9909,
        "name": "范成大"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314260,
      "title": "步虚词・西江月",
      "content": [
        "钧天奏，流韵满空明。",
        "琪树玲珑珠网碎，仙风吹作步虚声。",
        "相和八鸾鸣。"
      ],
      "author": {
        "id": 9909,
        "name": "范成大"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314261,
      "title": "步虚词・西江月",
      "content": [
        "楼阑外，辇道插非烟。",
        "闲上郁萧台上看，空歌来自始青天。",
        "扬袂揖飞仙。"
      ],
      "author": {
        "id": 9909,
        "name": "范成大"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314262,
      "title": "玉楼春",
      "content": [
        "佳人无对甘幽独。",
        "竹雨松风相澡浴。",
        "山深翠袖自生寒，夜久玉肌元不粟。",
        "却寻千树烟江曲。",
        "道骨仙风终绝俗。",
        "绛裙缟袂各朝元，只有散仙名萼绿。"
      ],
      "author": {
        "id": 9909,
        "name": "范成大"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314263,
      "title": "霜天晓角",
      "content": [
        "晚晴风歇。",
        "一夜春折威。",
        "脉脉花疏天淡，云来去、数枝雪。",
        "胜绝。",
        "愁亦绝。",
        "此情谁共说。",
        "惟有两行低雁，知人倚、画楼月。"
      ],
      "author": {
        "id": 9909,
        "name": "范成大"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314264,
      "title": "玉楼春",
      "content": [
        "云横水绕芳尘陌。",
        "一万重花春拍拍。",
        "蓝桥仙路不崎岖，醉舞狂歌容倦客。",
        "真香解语人倾国。",
        "知是紫云谁敢觅。",
        "满蹊桃李不能言，分付仙家君莫惜。"
      ],
      "author": {
        "id": 9909,
        "name": "范成大"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314265,
      "title": "醉落魄・一斛珠",
      "content": [
        "马蹄尘扑。",
        "春风得意笙歌逐。",
        "款门不问谁家竹。",
        "只拣红装，高处烧银烛。",
        "碧鸡坊里花如屋。",
        "燕王宫下花成谷。",
        "不须悔唱关山曲。",
        "只为海棠，也合来西蜀。"
      ],
      "author": {
        "id": 9909,
        "name": "范成大"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314266,
      "title": "菩萨蛮",
      "content": [
        "冰明玉润天然色。",
        "凄凉拼作西风客。",
        "不肯嫁东风。",
        "殷勤霜露中。",
        "绿窗梳洗晚。",
        "笑把玻璃盏。",
        "斜日上妆台。",
        "酒红和困来。"
      ],
      "author": {
        "id": 9909,
        "name": "范成大"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314267,
      "title": "眼儿媚",
      "content": [
        "酣酣日脚紫烟浮。",
        "妍暖破轻裘。",
        "困人天色，醉人花气，午梦扶头。",
        "春慵恰似春塘水，一片縠纹愁。",
        "溶溶泄泄，东风无力，欲皱还休。"
      ],
      "author": {
        "id": 9909,
        "name": "范成大"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314268,
      "title": "惜分飞",
      "content": [
        "画戟锦车皆雅故。",
        "箫鼓留连客住。",
        "南浦春波暮。",
        "难望罗袜生尘处。",
        "明日船旗应不驻。",
        "且唱断肠新句。",
        "卷尽珠帘雨。",
        "雪花一夜随人去。"
      ],
      "author": {
        "id": 9909,
        "name": "范成大"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314269,
      "title": "菩萨蛮",
      "content": [
        "客行忽到湘东驿。",
        "明朝真是潇湘客。",
        "晴碧万重云。",
        "几时逢故人。",
        "江南如塞北。",
        "别后书难得。",
        "先自雁来稀。",
        "那堪春半时。"
      ],
      "author": {
        "id": 9909,
        "name": "范成大"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314270,
      "title": "满江红",
      "content": [
        "千古东流，声卷地、云涛如屋。",
        "横浩渺、樯竿十丈，不胜帆腹。",
        "夜雨翻江春浦涨，船头鼓急风初熟。",
        "似当年、呼禹乱黄川，飞梭速。",
        "击楫誓，空惊俗。",
        "休拊髀，都生肉。",
        "任炎天冰海，一杯相属。",
        "荻笋蒌芽新入馔，鹍弦凤吹能翻曲。",
        "笑人间、何处似尊前，添银烛。"
      ],
      "author": {
        "id": 9909,
        "name": "范成大"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314271,
      "title": "谒金门",
      "content": [
        "塘水碧。",
        "仍带曲尘颜色。",
        "泥泥縠纹无气力。",
        "东风如爱惜。",
        "恰似越来溪侧。",
        "也有一双㶉𫛶。",
        "只欠柳丝千百尺。",
        "系船春弄笛。"
      ],
      "author": {
        "id": 9909,
        "name": "范成大"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314272,
      "title": "秦楼月・忆秦娥",
      "content": [
        "湘江碧。",
        "故人同作湘中客。",
        "湘中客。",
        "东风回雁，杏花寒食。",
        "温温月到蓝桥侧。",
        "醒心弦里春无极。",
        "春无极。",
        "明朝残梦，马嘶南陌。"
      ],
      "author": {
        "id": 9909,
        "name": "范成大"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314273,
      "title": "醉落魄・一斛珠",
      "content": [
        "雪晴风作。",
        "松梢片片轻鸥落。",
        "玉楼天半褰珠箔。",
        "一笛梅花，吹裂冻云幕。",
        "去年小猎漓山脚。",
        "弓刀湿遍犹横槊。",
        "今年翻怕貂裘薄。",
        "寒似去年，人比去年觉。"
      ],
      "author": {
        "id": 9909,
        "name": "范成大"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314274,
      "title": "霜天晓角",
      "content": [
        "少年豪纵。",
        "袍锦团花凤。",
        "曾是京城游子，驰宝马、飞金鞚。",
        "旧游浑似梦。",
        "鬓点吴霜重。",
        "多少燕情莺意，都泻入、玻璃瓮。"
      ],
      "author": {
        "id": 9909,
        "name": "范成大"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314275,
      "title": "菩萨蛮",
      "content": [
        "彤楼鼓密催金轮。",
        "沈沈青琐重重幕。",
        "宣唤晚朝天。",
        "五云笼暝烟。",
        "风急东华路。",
        "暖扇遮微雨。",
        "香雾扑人衣。",
        "上林乌满枝。"
      ],
      "author": {
        "id": 9909,
        "name": "范成大"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314276,
      "title": "水调歌头",
      "content": [
        "万里汉都护。",
        "（下缺）"
      ],
      "author": {
        "id": 9909,
        "name": "范成大"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314277,
      "title": "水调歌头",
      "content": [
        "万里桥边客。",
        "（下缺）"
      ],
      "author": {
        "id": 9909,
        "name": "范成大"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314278,
      "title": "水调歌头",
      "content": [
        "万里吴船泊，归访菊篱秋。",
        "（下缺）"
      ],
      "author": {
        "id": 9909,
        "name": "范成大"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314279,
      "title": "醉落魄・一斛珠",
      "content": [
        "栖乌飞绝。",
        "绛河绿雾星明灭。",
        "烧香曳簟眠清樾。",
        "花久影吹笙，满地淡黄月。",
        "好风碎竹声如雪。",
        "昭华三弄临风咽。",
        "鬓丝撩乱纶巾折。",
        "凉满北窗，休共软红说。"
      ],
      "author": {
        "id": 9909,
        "name": "范成大"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314280,
      "title": "朝中措",
      "content": [
        "长年心事寄林扃。",
        "尘鬓已星星。",
        "芳意不如水远，归心欲与云平。",
        "留连一醉，花残日永，雨后山明。",
        "从此量船载酒，莫教闲却春情。"
      ],
      "author": {
        "id": 9909,
        "name": "范成大"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314281,
      "title": "水龙吟",
      "content": [
        "仙翁家在丛霄，五云八景来尘表。",
        "黄扉紫闼，化钧高妙，风霆挥扫。",
        "漠北寒烟，峤南和气，笑谈都了。",
        "自玉麟归去，金牛再款，却回首、人间少。",
        "天与丹台旧籍，笑苍生、祝公难老。",
        "春葩秋叶，喧寒易变，壶天长好。",
        "物外新闻，凤歌鸾翥，龙蟠虎绕。",
        "想如心高会，寒霜夜永，尽横参晓。"
      ],
      "author": {
        "id": 9909,
        "name": "范成大"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314282,
      "title": "满江红",
      "content": [
        "山绕西湖，曾同泛、一篙春绿。",
        "重会面、未温往事，先翻新曲。",
        "劲柏乔松霜雪后，知心惟有孤生竹。",
        "对荒园、犹解两高歌，空惊俗。",
        "人更健，情逾熟。",
        "樱共柳，冰和玉。",
        "恐相逢如梦，夜阑添烛，别后书来空怅望，尊前酒到休拘束。",
        "笑簟瓢、未足已能狂，那堪足。"
      ],
      "author": {
        "id": 9909,
        "name": "范成大"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314283,
      "title": "青玉案",
      "content": [
        "中央自有仙风度。",
        "散入千林去。",
        "万点秋芳洒飞露。",
        "舜裳赭色，尧眉黄彩，化作花无数。",
        "层层翠葆鸾旗舞。",
        "吹下天香遍瑶宇。",
        "万岁千秋奉明主。",
        "桂华月苑，蕊珠宝殿，长听黄金缕。"
      ],
      "author": {
        "id": 6162,
        "name": "王质"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314284,
      "title": "青玉案",
      "content": [
        "浮萍不碍鱼行路。",
        "细数鱼来去。",
        "静倚溪阴深觅句。",
        "碧鲜清润，影摇香度。",
        "易觉阑干暮。",
        "凫雏深傍苹根住。",
        "浴罢红衣褪残缕。",
        "一寸江湖无可付。",
        "渚兰汀草，卧烟敧雨。",
        "荒了垂纶处。"
      ],
      "author": {
        "id": 6162,
        "name": "王质"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314285,
      "title": "江城子",
      "content": [
        "细风微揭碧鳞鳞。",
        "绣帏深。",
        "不闻声。",
        "时见推帘，笼袖玉轻轻。",
        "不似绮楼高卷幔，相指点，总分明。",
        "斜湾丛柳暗阴阴。",
        "且消停。",
        "莫催行。",
        "只恨夕阳，虽好近黄昏。",
        "得到钗梁容略住，无分做，小蜻蜓。"
      ],
      "author": {
        "id": 6162,
        "name": "王质"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314286,
      "title": "江城子",
      "content": [
        "细风吹起翠田田。",
        "雨和烟。",
        "入梅天。",
        "鲜润繁阴，悄悄转清圆。",
        "十顷蒲萄深贮碧，鸥共鹭，各翩翩。",
        "影摇香度小婵娟。",
        "竹林贤。",
        "总神仙。",
        "滴露飞霜，雪壑注冰泉。",
        "伴了芙蓉城里客，无一事，北窗眠。"
      ],
      "author": {
        "id": 6162,
        "name": "王质"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314287,
      "title": "江城子",
      "content": [
        "柳梢无雪受风吹。",
        "绿垂垂。",
        "乳鸦啼。",
        "直下蒲萄，春水未平堤。",
        "却似今年春气早，白团扇，已相宜。",
        "红巾当日鸟衔飞。",
        "曲江湄。",
        "暮春时。",
        "孔雀麒麟，交蹙绣罗衣。",
        "何似野堂陪胜客，花影外，竹影移。"
      ],
      "author": {
        "id": 6162,
        "name": "王质"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314288,
      "title": "蓦山溪",
      "content": [
        "枯林荒陌，矮树敷鲜叶。",
        "不见雅风标，十二分、山容野色。",
        "因何嫩茁，舞动小旗枪，梅花后，杏花前，色味香三绝。",
        "含光隐耀，尘土埋豪杰。",
        "试看大粗疏，争知变、寒云飞雪。",
        "休说休说，世只两名花，芍药相，牡丹王，未尽人间舌。"
      ],
      "author": {
        "id": 6162,
        "name": "王质"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314289,
      "title": "满江红",
      "content": [
        "方丈维摩，蒙衲被、都齐不省。",
        "空怅望、锦裘绣帽，玉珂金镫。",
        "十月小春逢此日，一时胜事输公等。",
        "问短衣、匹马射南山，何人肯。",
        "山暮紫，峰如笋。",
        "江寒碧，沙如粉。",
        "望塞鸿杳杳，水遥天永。",
        "饮罢不妨瓶屡卧，归来自有风吹醒。",
        "试断桥、流水月明边，寻疏影。"
      ],
      "author": {
        "id": 6162,
        "name": "王质"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314290,
      "title": "满江红",
      "content": [
        "整顿乾坤，恨无袖、回旋不足。",
        "须付与、腰金叠赤，面槐参绿。",
        "功业岂无人可了，英豪自有心相伏。",
        "自孤窗、寒烛听经纶，常三复。",
        "举大白，倾醽醁。",
        "为公起，歌此曲。",
        "曲中意惟有，斯贤堪属。",
        "萱草喜除烦恼障，莲花妙享清凉福。",
        "愿年年、团扇弄生绡，长如玉。"
      ],
      "author": {
        "id": 6162,
        "name": "王质"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314291,
      "title": "满江红",
      "content": [
        "惨淡轻阴，都养就、朱朱白白。",
        "最好是、梨花带雨，海棠映日。",
        "暖雾烘成芳草色，娇风分与垂杨力。",
        "听红边、翠杪啭清圆，曾相识。",
        "春绪乱，还如织。",
        "春梦断，还堪觅。",
        "看青梅下有，游人啧啧。",
        "爱酒正香须满泛，怜花太嫩休轻摘。",
        "把领巾、收聚众香浓，凭风立。"
      ],
      "author": {
        "id": 6162,
        "name": "王质"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314292,
      "title": "满江红",
      "content": [
        "生縠平铺，吹不起、轻风无力。",
        "西江上、斗牛相射，水天一色。",
        "二妙风流今代少，一时光价何时息。",
        "更绛霄、白日下云𫐌，芙蓉客。",
        "整飞驭，成得得。",
        "寻前约、宽忆忆。",
        "正云飞雨卷，旧红新碧。",
        "茁茁抽长荷柄绿，毵毵吐净杨花白。",
        "渐衣篝、香润入梅天，红绡湿。"
      ],
      "author": {
        "id": 6162,
        "name": "王质"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314293,
      "title": "满江红",
      "content": [
        "莽莽云平，都不辨、近山远水。",
        "尽徘徊、尚留波面，未归湾尾。",
        "浪猛深深鸥抱稳，波寒缩缩鱼沈底。",
        "恐狂风、颠雨岸多摧，舟难舣。",
        "船篷重，拖不起。",
        "蓑衣湿，森如洗。",
        "想杖头未足，杯中无计。",
        "渔网吹翻无把捉，钓竿冻断成抛弃。",
        "到高歌、风静月明时，谁如你。"
      ],
      "author": {
        "id": 6162,
        "name": "王质"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314294,
      "title": "满江红",
      "content": [
        "落尽斜阳，尚有些、断霞残影。",
        "甚弯环、东溪西巷，南岩北岭。",
        "行熟更教羊引著，睡浓却被鸦惊醒。",
        "渐孤村、树暗颤山敧，霜风冷。",
        "人世里，嫌他蠢。",
        "牛背上，输他稳。",
        "但芒鞋一緉，蓑衣一领。",
        "五脏荒陂蔬荐口，双髽幽崦花漫顶。",
        "虽云乌、月黑路蒙笼，何曾窘。"
      ],
      "author": {
        "id": 6162,
        "name": "王质"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314295,
      "title": "满江红",
      "content": [
        "纸张梅花，有丛桂、又有修竹。",
        "是何声、雪飘远渚，泉鸣幽谷。",
        "红蓼白苹须拂袖，馀音尚带清香馥。",
        "挽素娥青女、问飞琼，谁家曲。",
        "韩退之，欧永叔。",
        "惚兮恍，恍兮惚。",
        "试侧耳，山常似黛，水常如玉。",
        "颜子操中何足怨，醉翁徽外无人续。",
        "正青天、明月上东南，芳时足。"
      ],
      "author": {
        "id": 6162,
        "name": "王质"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314296,
      "title": "水调歌头",
      "content": [
        "江水去无极，无地有青天。",
        "怒涛汹涌，卷浪成雪蔽长川。",
        "一望扬州苍莽，隐见烟竿双矗，何处卷珠帘。",
        "落日瓜洲渡，鸿鹭满风前。",
        "古战场，皆白草，更苍烟。",
        "清平犹有遗恨，久矣在江边。",
        "北固山前三杰，遥想当年意气，□□昵中原。",
        "上马促归去，风堕接罗翩"
      ],
      "author": {
        "id": 6162,
        "name": "王质"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314297,
      "title": "水调歌头",
      "content": [
        "细数十年梦，十处过中秋。",
        "今年清梦，还在黄鹤旧楼头。",
        "老子个中不浅，此会天教重见，今古一南楼。",
        "星汉淡无色，玉锦倚空浮。",
        "带秦烟，萦楚雾，熨江流。",
        "关河离合南北，依旧照清愁。",
        "想见姮娥冷笑，笑我归来霜鬓，空敝黑貂裘。",
        "把酒问清影，肯去伴沧洲。"
      ],
      "author": {
        "id": 6162,
        "name": "王质"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    }
  ],
