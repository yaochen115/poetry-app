        "name": "五言绝句"
      }
    },
    {
      "id": 347105,
      "title": "题云际寺暕上人故院",
      "content": [
        "白发匆匆色，青山草草心。",
        "远公仍下世，从此别东林。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 347119,
      "title": "问张山人疾",
      "content": [
        "先生沈病意何如，蓬艾门前客转疏。",
        "不见领徒过绛帐，唯闻与婢削丹书。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
