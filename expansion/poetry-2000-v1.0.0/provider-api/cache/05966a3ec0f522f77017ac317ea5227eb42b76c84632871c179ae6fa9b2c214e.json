{
  "data": [
    {
      "id": 346897,
      "title": "鲜于少府宅看花",
      "content": [
        "谢家能植药，万簇相萦倚。",
        "烂熳绿苔前，婵娟青草里。",
        "垂栏复照户，映竹仍临水。",
        "骤雨发芳香，回风舒锦绮。",
        "孤光杂新故，众色更重累。",
        "散碧出疏茎，分黄成细蕊。",
        "游蜂高更下，惊蝶坐还起。",
        "玉貌对应惭，霞标方不似。",
        "春阴怜弱蔓，夏日同短晷。",
        "回落报荣衰，交关斗红紫。",
        "花时苟未赏，老至谁能止。",
        "上客屡移床，幽僧劳凭几。",
        "初合虽薄劣，却得陪君子。",
        "敢问贤主人，何如种桃李。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 346898,
      "title": "慈恩寺怀旧",
      "content": [
        "去者不可忆，旧游相见时。",
        "凌霄徒更发，非是看花期。",
        "倚玉交文友，登龙年月久。",
        "东阁许联床，西郊亦携手。",
        "彼苍何暧昧，薄劣翻居后。",
        "重入远师溪，谁尝陶令酒。",
        "伊昔会禅宫，容辉在眼中。",
        "篮舆来问道，玉柄解谈空。",
        "孔席亡颜子，僧堂失谢公。",
        "遗文一书壁，新竹再移丛。",
        "始聚终成散，朝欢暮不同。",
        "春霞方照日，夜烛忽迎风。",
        "蚁斗声犹在，鸮灾道已穷。",
        "问天应默默，归宅太匆匆。",
        "凄其履还路，莽苍云林暮。",
        "九陌似无人，五陵空有雾。",
        "缅怀山阳笛，永恨平原赋。",
        "错莫过门栏，分明识行路。",
        "上智本全真，郤公况重臣。",
        "唯应抚灵运，暂是忆嘉宾。",
        "存信松犹小，缄哀草尚新。",
        "鲤庭埋玉树，那忍见门人。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 346899,
      "title": "赠薛戴",
      "content": [
        "晓雾忽为霜，寒蝉还罢响。",
        "行人在长道，日暮多归想。",
        "射策本何功，名登绛帐中。",
        "遂矜丘室重，不料阮途穷。",
        "交结惭时辈，龙钟似老翁。",
        "机非鄙夫正，懒是平生性。",
        "欹枕鸿雁高，闭关花药盛。",
        "厨烟当雨绝，阶竹连窗暝。",
        "欲赋苦饥行，无如消渴病。",
        "旧业历胡尘，荒原少四邻。",
        "田园空有处，兄弟未成人。",
        "毛义心长苦，袁安家转贫。",
        "今呈胸臆事，当为泪沾巾。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 346901,
      "title": "送韩绅卿",
      "content": [
        "春雨昨开花，秋霜忽沾草。",
        "荣枯催日夕，去住皆须老。",
        "君望汉家原，高坟渐成道。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 346902,
      "title": "襄阳曲",
      "content": [
        "襄阳堤路长，草碧柳枝黄。",
        "谁家女儿临夜妆，",
        "同居女伴正衣裳，中庭寒月白如霜。",
        "贾生十八称才子，"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 346903,
      "title": "胡腾儿",
      "content": [
        "胡腾身是凉州儿，肌肤如玉鼻如锥。",
        "桐布轻衫前后卷，",
        "安西旧牧收泪看，洛下词人抄曲与。",
        "扬眉动目踏花毡，",
        "环行急蹴皆应节，反手叉腰如却月。",
        "丝桐忽奏一曲终，"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 346904,
      "title": "赠康洽",
      "content": [
        "黄须康兄酒泉客，平生出入王侯宅。",
        "今朝醉卧又明朝，",
        "声名恒压鲍参军，班位不过扬执戟。",
        "迩来七十遂无机，",
        "自言万物有移改，始信桑田变成海。",
        "同时献赋人皆尽，",
        "汉家尚壮今则老，发短心长知奈何。",
        "华堂举杯白日晚，",
        "借问朦胧花树下，谁家畚插筑高台。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 346905,
      "title": "瘦马行",
      "content": [
        "城傍牧马驱未过，一马徘徊起还卧。",
        "眼中有泪皮有疮，",
        "往时汉地相驰逐，如雨如风过平陆。",
        "岂意今朝驱不前，",
        "玉勒金鞍既已远，追奔获兽有谁知。",
        "终身枥上食君草，"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 346906,
      "title": "杂歌呈郑锡司空文明",
      "content": [
        "昨宵梦到亡何乡，忽见一人山之阳。",
        "高冠长剑立石堂，",
        "啖我还丹拍我背，令我延年在人代。",
        "乃书数字与我持，",
        "东岭啼猿三四声，卷帘一望心堪碎。",
        "蓬莱有梯不可蹑，",
        "学仙去来辞故人，长安道路多风尘。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 346907,
      "title": "杂歌",
      "content": [
        "汉水至清泥则浊，松枝至坚萝则弱。",
        "十三女儿事他家，",
        "为姑偏忌诸嫂良，作妇翻嫌婿家恶。",
        "人生照镜须自知，",
        "伯奇掇蜂贤父逐，曾参杀人慈母疑。",
        "酒沽千日人不醉，",
        "山鸡锦翼岂凤凰，陇鸟人言止鹦鹉。",
        "向栩非才徒隐灶，",
        "乐生东去终居赵，阳虎北辕翻适楚。",
        "世间反复不易陈，"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 346908,
      "title": "乌栖曲",
      "content": [
        "白马逐朱车，黄昏入狭斜。",
        "狭斜柳树乌争宿，"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 346909,
      "title": "送客东归",
      "content": [
        "昨夜东风吹尽雪，两京路上梅花发。",
        "行人相见便东西，"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 346912,
      "title": "荆门歌送兄赴夔州",
      "content": [
        "余兄佐郡经西楚，饯行因赋荆门雨。",
        "sC々燮燮声渐繁，",
        "云间怅望荆衡路，万里青山一时暮。",
        "琵琶寺里响空廊。",
        "熨火陂前湿荒戍。",
        "沙尾长樯发渐稀，竹竿草𪨗涉流归。",
        "夷陵已远半成烧，汉上游倡始濯衣。",
        "船门相对多商估，",
        "曾为江客念江行，肠断秋荷雨打声。",
        "摩天古木不可见，"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 346913,
      "title": "妾薄命",
      "content": [
        "忆妾初嫁君，花鬟如绿云，回灯入绮帐，转面脱罗裙。",
        "折步教人学，偷香与客熏。",
        "容颜南国重，名字北方闻。",
        "一从失恩意，转觉身憔悴。",
        "对镜不梳头，倚窗空落泪。",
        "新人莫恃新，秋至会无春。",
        "从来闭在长门者，"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 346917,
      "title": "雨雪曲",
      "content": [
        "天山一丈雪，杂雨夜霏霏。",
        "湿马胡歌乱，经烽汉火微。",
        "丁零苏武别，疏勒范羌归。",
        "若看关头下，长榆叶定稀。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 346919,
      "title": "山下泉",
      "content": [
        "碧水映丹霞，溅溅度浅沙。",
        "暗通山下草，流出洞中花。",
        "净色和云落，喧声绕石斜。",
        "明朝更寻去，应到阮郎家。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 346921,
      "title": "与郑锡游春",
      "content": [
        "东门垂柳长，回首独心伤。",
        "日暖临芳草，天晴忆故乡。",
        "映花莺上下，过水蝶飞扬。",
        "借问同行客，今朝泪几行。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 346925,
      "title": "雨后游辋川",
      "content": [
        "骤雨归山尽，颓阳入辋川。",
        "看虹登晚墅，踏石过青泉。",
        "紫葛藏仙井，黄花出野田。",
        "自知无路去，回步就人烟。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 346927,
      "title": "同苗员外宿荐福寺僧舍",
      "content": [
        "潘安秋兴动，凉夜宿僧房。",
        "倚杖云离月，垂帘竹有霜。",
        "回风生远径，落叶飒长廊。",
        "一与交亲会，空贻别后伤。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 346932,
      "title": "过宋州",
      "content": [
        "睢阳陷虏日，外绝救兵来。",
        "世乱忠臣死，时清明主哀。",
        "荒郊春草遍，故垒野花开。",
        "欲为将军哭，东流水不回。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 346934,
      "title": "江上逢司空曙",
      "content": [
        "共尔髫年故，相逢万里余。",
        "新春两行泪，故国一封书。",
        "夏口帆初落，涔阳雁正疏。",
        "唯当执杯酒，暂食汉江鱼。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 346939,
      "title": "宿兴善寺后堂池",
      "content": [
        "草堂高树下，月向后池生。",
        "野客如僧静，新荷共水准。",
        "锦鳞沉不食，绣羽乱相鸣。",
        "即事思江海，谁能万里行。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 346945,
      "title": "早春雪夜寄卢纶兼呈秘书元丞",
      "content": [
        "闻君随谢脁，春夜宿前川。",
        "看竹云垂地，寻僧月满田。",
        "熊寒方入树，鱼乐稍离船。",
        "独夜羁愁客，惟知惜故年。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 346947,
      "title": "元丞宅送胡浚及第东归觐省",
      "content": [
        "登龙兼折桂，归去当高车。",
        "旧楚枫犹在，前隋柳已疏。",
        "月中逢海客，浪里得乡书。",
        "见说江边住，知君不厌鱼。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 346948,
      "title": "送魏广下第归扬州宁亲",
      "content": [
        "游宦今空返，浮淮一雁秋。",
        "白云阴泽国，青草绕扬州。",
        "调膳过花下，张筵到水头。",
        "昆山仍有玉，岁晏莫淹留。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 346952,
      "title": "韦员外东斋看花",
      "content": [
        "入花凡几步，此树独相留。",
        "发艳红枝合，垂烟绿水幽。",
        "并开偏觉好，未落已成愁。",
        "一到芳菲下，空招两鬓秋。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 346955,
      "title": "茂陵村行赠何兆",
      "content": [
        "春天黄鸟啭，野径白云间。",
        "解带依芳草，支颐想故山。",
        "人行九州路，树老五陵间。",
        "谁道临邛远，相如自忆还。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 346962,
      "title": "送郭补阙归江阳",
      "content": [
        "东门春尚浅，杨柳未成阴。",
        "雁影愁斜日，莺声怨故林。",
        "隋宫江上远，梁苑雪中深。",
        "独有怀归客，难为欲别心。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 346973,
      "title": "送杨皋擢第归江东",
      "content": [
        "隋堤望楚国，江上一归人。",
        "绿气千樯暮，青风万里春。",
        "试才初得桂，泊渚肯伤苹。",
        "拜手终凄怆，恭承中外亲。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 346975,
      "title": "送吉中孚拜官归业",
      "content": [
        "南入华阳洞，无人古树寒。",
        "吟诗开旧帙，带绶上荒坛。",
        "因病求归易，沾恩更隐难。",
        "孟宗应献鲊，家近守渔官。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 346982,
      "title": "山中期张芬不至",
      "content": [
        "石堤春草碧，双燕向西飞。",
        "怅望云天暮，佳人何处归。",
        "药栏虫网遍，苔井水痕稀。",
        "谁道嵇康懒，山中自掩扉。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 346984,
      "title": "送义兴元少府",
      "content": [
        "逢君惠连第，初命便光辉。",
        "已得群公祖，终妨太傅讥。",
        "路长人反顾，草断燕回飞。",
        "本是江南客，还同衣锦归。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 346985,
      "title": "卧病别郑锡",
      "content": [
        "病来喜无事，多卧竹林间。",
        "此日一相见，明朝还掩关。",
        "幽人爱芳草，志士惜颓颜。",
        "岁晏不我弃，期君在故山。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 346987,
      "title": "送诸暨裴少府",
      "content": [
        "山公访嵇绍，赵武见韩侯。",
        "事去恩犹在，名成泪却流。",
        "一官同北去，千里赴南州。",
        "才子清风后，无贻相府忧。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 346992,
      "title": "卧病寄阎采",
      "content": [
        "病中贪好景，强步出幽居。",
        "紫葛垂山径，黄花绕野渠。",
        "荒林飞老鹤，败堰过游鱼。",
        "纵忆同年友，无人可寄书。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 346997,
      "title": "同苗发慈恩寺避暑",
      "content": [
        "追凉寻宝刹，畏日望璿题。",
        "卧草同鸳侣，临池似虎溪。",
        "树闲人迹外，山晚鸟行西。",
        "若问无心法，莲花隔淤泥。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 346998,
      "title": "送潘述宏词下第归江外",
      "content": [
        "唱高人不和，此去泪难收。",
        "上国经年住，长江满目流。",
        "弈棋知胜偶，射策请焚舟。",
        "应是田□□，玄成许尔游。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 347004,
      "title": "送何兆下第还蜀",
      "content": [
        "重江不可涉，孤客莫晨装。",
        "高木莎城小，残星栈道长。",
        "袅猿枫子落，过雨荔枝香。",
        "劝尔成都住，文翁有草堂。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 347006,
      "title": "送元晟归江东旧居",
      "content": [
        "泽国舟车接，关门雨雪乖。",
        "春天行故楚，夜月下清淮。",
        "讲易居山寺，论诗到郡斋。",
        "蒋家人暂别，三路草连阶。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 347011,
      "title": "送赵给事侄尉丹阳",
      "content": [
        "太傅怜群从，门人亦贱回。",
        "入官先爱子，赐酒许同杯。",
        "淮海春多雨，蒹葭夜有雷。",
        "遥知拜庆后，梅尉称仙才。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 347012,
      "title": "宿瓜洲寄柳中庸",
      "content": [
        "怀人同不寐，清夜起论文。",
        "月魄正出海，雁行斜上云。",
        "寒潮来滟滟，秋叶下纷纷。",
        "便送江东去，徘徊只待君。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 347013,
      "title": "夜宴虢县张明府宅逢宇文评事",
      "content": [
        "虢田留古宅，入夜足秋风。",
        "月影来窗里，灯光落水中。",
        "征诗逢谢客，饮酒得陶公。",
        "更爱疏篱下，繁霜湿菊丛。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 347014,
      "title": "冬夜集张尹后阁",
      "content": [
        "乘龟兼戴豸，白面映朱衣。",
        "安石还须起，泉明不得归。",
        "应门常吏在，登席旧寮稀。",
        "远客长先醉，那知亚相威。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 347022,
      "title": "送卫雄下第归同州",
      "content": [
        "不才先上第，词客却空还。",
        "边地行人少，平芜尽日闲。",
        "一蝉陂树里，众火陇云间。",
        "羡汝归茅屋，书窗见远山。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 347024,
      "title": "题山中别业",
      "content": [
        "旧宅在山中，闲门与寺通。",
        "往来黄叶路，交结白头翁。",
        "晚笋难成竹，秋花不满丛。",
        "生涯只粗粝，吾岂讳言穷。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 347028,
      "title": "送雍郢州",
      "content": [
        "厌郎思出守，遂领汉东军。",
        "望月逢殷浩，缘江送范云。",
        "城闲烟草遍，浦迥雪林分。",
        "谁伴楼中宿，吟诗估客闻。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 347030,
      "title": "与萧远上人游少华山寄皇甫侍御",
      "content": [
        "寻危兼采药，渡水又登山。",
        "独与高僧去，逍遥落日间。",
        "渐看闾里远，自觉性情闲。",
        "回首知音在，因令怅望还。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 347032,
      "title": "赠故将军",
      "content": [
        "平生在边日，鞍马若星流。",
        "独出间千里，相知满九州。",
        "恃功凌主将，作气见王侯。",
        "谁道廉颇老，犹能报远雠。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 347035,
      "title": "送铜泽王归城",
      "content": [
        "昔闻公族出，其从亦高车。",
        "为善唯求乐，分贫必及疏。",
        "身承汉枝叶，手习鲁诗书。",
        "尚说无功德，三年在石渠。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 347036,
      "title": "江上别柳中庸",
      "content": [
        "秦人江上见，握手便沾衣。",
        "近日相知少，往年亲故稀。",
        "远游何处去，旧业几时归。",
        "更向巴陵宿，堪闻雁北飞。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 347040,
      "title": "留别故人",
      "content": [
        "此别不可道，此心当语谁。",
        "春风灞水上，饮马桃花时。",
        "误作好文士，只应游宦迟。",
        "留书下朝客，我有故山期。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 347042,
      "title": "都亭驿送郭判官之幽州幕府",
      "content": [
        "幕府参戎事，承明伏奏归。",
        "都亭使者出，杯酒故人违。",
        "细雨沾官骑，轻风拂客衣。",
        "还从大夫后，吾党亦光辉。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 347043,
      "title": "送王羽林往秦州",
      "content": [
        "秦州贵公子，汉日羽林郎。",
        "事主来中禁，荣亲上北堂。",
        "輶车花拥路，宝剑雪生光。",
        "直扫三边靖，承恩向建章。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 347045,
      "title": "代宗挽歌",
      "content": [
        "祖庭三献罢，严卫百灵朝。",
        "警跸移前殿，宫车上渭桥。",
        "寒霜凝羽葆，野吹咽笳箫。",
        "已向新京兆，谁云天路遥。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 347046,
      "title": "张左丞挽歌二首",
      "content": [
        "素旆低寒水，清笳出晓风。",
        "鸟来伤贾傅，马立葬滕公。",
        "松柏青山上，城池白日中。",
        "一朝今古隔，唯有月明同。",
        "祸集钩方失，灾生剑忽飞。",
        "无由就日拜，空忆自天归。",
        "门吏看还葬，宫官识赐衣。",
        "东堂哀赠毕，从此故臣稀。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 347048,
      "title": "青龙寺题故昙上人房",
      "content": [
        "远公留故院，一径雪中微。",
        "童子逢皆老，门人问亦稀。",
        "翻经徒有处，携履遂无归。",
        "空念寻巢鹤，时来傍影飞。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 347049,
      "title": "早春夜望",
      "content": [
        "旧雪逐泥沙，新雷发草芽。",
        "晓霜应傍鬓，夜雨莫催花。",
        "行矣前途晚，归与故国赊。",
        "不劳报春尽，从此惜年华。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 347053,
      "title": "江上赛神",
      "content": [
        "疏鼓应繁丝，送神归九疑。",
        "苍龙随赤凤，帝子上天时。",
        "骤雨归山疾，长江下日迟。",
        "独怜游宦子，今夜泊天涯。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 347056,
      "title": "赠郭驸马",
      "content": [
        "青春都尉最风流，二十功成便拜侯。",
        "金距斗鸡过上苑，",
        "日暮吹箫杨柳陌，路人遥指凤凰楼。",
        "方塘似镜草芊芊，初月如钩未上弦。",
        "新开金埒看调马，",
        "今朝都尉如相顾，原脱长裾学少年。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 347057,
      "title": "宿淮浦忆司空文明",
      "content": [
        "愁心一倍长离忧，夜思千重恋旧游。",
        "秦地故人成远梦，",
        "别恨转深何处写，前程唯有一登楼。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 347058,
      "title": "送濮阳录事赴忠州",
      "content": [
        "成名不遂双旌远，主印还为一郡雄。",
        "赤叶黄花随野岸，",
        "闻说古书多未校，肯令才子久西东。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 347059,
      "title": "送马尊师",
      "content": [
        "南入商山松路深，石床溪水昼阴阴。",
        "云中采药随青节，",
        "武陵花木应长在，愿与渔人更一寻。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 347060,
      "title": "题元注林园",
      "content": [
        "谢家门馆似山林，碧石青苔满树阴。",
        "乳鹊眄巢花巷静，",
        "独有野人箕踞惯，过君始得一长吟。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 347061,
      "title": "野寺病居喜卢纶见访",
      "content": [
        "青青麦垄白云阴，古寺无人新草深。",
        "乳燕拾泥依古井，",
        "一卧漳滨今欲老，谁知才子忽相寻。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 347062,
      "title": "送皎然上人归山",
      "content": [
        "适来世上岂缘名，适去人间岂为情。",
        "古寺山中几日到，",
        "法主欲归须有说，门人流泪厌浮生。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 347063,
      "title": "赠道士",
      "content": [
        "姓氏不书高士传，形神自得逸人风。",
        "已传花洞将秦接，",
        "终朝卖卜无人识，敝服徒行入市中。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 347064,
      "title": "题云际寺准上人房",
      "content": [
        "高僧居处似天台，锡仗铜瓶对绿苔。",
        "竹巷雨晴春鸟啭，",
        "独夜焚香礼遗像，空林月出始应回。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 347065,
      "title": "山中寄苗员外",
      "content": [
        "鸟鸣花发空山里，衡岳幽人藉草时。",
        "既近浅流安笔砚，",
        "闻说潘安方寓直，与君相见渐难期。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 347066,
      "title": "忆故山赠司空曙",
      "content": [
        "汉主金门正召才，马卿多病自迟回。",
        "旧山暂别老将至，",
        "知君素有栖禅意，岁晏蓬门迟尔开。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 347067,
      "title": "闲园即事赠考功王员外",
      "content": [
        "南陌晴云稍变霞，东风动柳水纹斜。",
        "园林带雪潜生草，",
        "今朝一望还成暮，欲别芳菲恋岁华。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 347068,
      "title": "寄庐山真上人",
      "content": [
        "高僧无迹本难寻，更得禅行去转深。",
        "青草湖中看五老，",
        "更说谢公南座好，烟萝到地几重阴。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 347069,
      "title": "题觉公新兰若",
      "content": [
        "头白禅师何处还，独开兰若树林间。",
        "鬼因巫祝传移社，",
        "新斋结誓如相许，愿与雷宗永闭关。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 347070,
      "title": "赠道者",
      "content": [
        "窗中忽有鹤飞声，方士因知道欲成。",
        "来取图书安枕里，",
        "送客自伤身易老，不知何处待先生。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 347071,
      "title": "代弃妇答贾客",
      "content": [
        "玉垒城边争走马，铜鞮市里共乘舟。",
        "鸣环动佩恩无尽，",
        "忍怀贱妾平生曲，独上襄阳旧酒楼。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 347072,
      "title": "和李舍人直中书对月见寄",
      "content": [
        "名卿步月正淹留，上客裁诗怨别游。",
        "素魄近成班女扇，",
        "盈手入怀皆不见，阳春曲丽转难酬。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 347073,
      "title": "卧病闻吉中孚拜官寄元秘书昆季",
      "content": [
        "汉家采使不求声，自慰文章道欲行。",
        "毛遂登门虽异赏，",
        "年少奉亲皆愿达，敢将心事向玄成。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 347074,
      "title": "江上逢柳中庸",
      "content": [
        "旧住衡山曾夜归，见君江客忆荆扉。",
        "星沉岭上人行早，",
        "今来唯有禅心在，乡路翻成向翠微。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 347075,
      "title": "戏赠韩判官绅卿",
      "content": [
        "少寻道士居嵩岭，晚事高僧住沃洲。",
        "齿发未知何处老，",
        "独怪子猷缘掌马，雪时不肯更乘舟。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 347076,
      "title": "送周长史",
      "content": [
        "青枫树里宣城郡，独佐诸侯上板桥。",
        "江客亦能传好信，",
        "别有空园落桃杏，知将丝组系兰桡。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 347077,
      "title": "题故将军庄",
      "content": [
        "曾将数骑过桑干，遥对单于饬马鞍。",
        "塞北征儿谙用剑，",
        "唯有老身如刻画，犹期圣主解衣看。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 347078,
      "title": "夜投丰德寺谒海上人",
      "content": [
        "半夜中峰有磬声，偶寻樵者问山名。",
        "上方月晓闻僧语，",
        "愿得远山知姓字，焚香洗钵过余生。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 347080,
      "title": "送彭将军云中觐兄",
      "content": [
        "闻说苍鹰守，今朝欲下鞲。",
        "因令白马将，兼道觅封侯。",
        "略地关山冷，防河雨雪稠。",
        "翻弓骋猿臂，承箭惜貂裘。",
        "设伏军谋密，坑降塞邑愁。",
        "报恩唯有死，莫使汉家羞。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 347081,
      "title": "奉赠苗员外",
      "content": [
        "朱户敞高扉，青槐碍落晖。",
        "八龙承庆重，三虎递朝归。",
        "坐竹人声绝，横琴鸟语稀。",
        "花惭潘岳貌，年称老莱衣。",
        "叶暗新樱熟，丝长粉蝶飞。",
        "应怜鲁儒贱，空与故山违。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 347082,
      "title": "酬丘拱外甥览余旧文见寄",
      "content": [
        "丘迟本才子，始冠即周旋。",
        "舅乏郤鉴爱，君如卫玠贤。",
        "礼将金友等，情向玉人偏。",
        "鄙俗那劳似，龙钟却要怜。",
        "投砖聊取笑，赠绮一何妍。",
        "野坐临黄菊，溪行踏绿钱。",
        "岩高云反下，洞黑水潜穿。",
        "僻岭猿偷栗，枯池雁唼莲。",
        "身居霞外寺，思发月明田。",
        "犹恨萦尘网，昏昏过岁年。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 347084,
      "title": "下第上薛侍郎",
      "content": [
        "蓬荜春风起，开帘却自悲。",
        "如何飘梗处，又到采兰时。",
        "明镜方重照，微诚寄一辞。",
        "家贫求禄早，身贱报恩迟。",
        "幸得皮存矣，须劳翼长之。",
        "铭肌非厚答，肉骨是前期。",
        "纵觉新人好，宁忘旧主疑。",
        "终惭太丘道，不为小生私。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 347087,
      "title": "暮春寻终南柳处士",
      "content": [
        "庞眉一居士，鹑服隐尧时。",
        "种豆初成亩，还丹旧日师。",
        "入溪花径远，向岭鸟行迟。",
        "紫葛垂苔壁，青菰映柳丝。",
        "偶来尘外事，暂与素心期。",
        "终恨游春客，同为岁月悲。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 347088,
      "title": "雪夜寻太白道士",
      "content": [
        "雪路夜朦胧，寻师杏树东。",
        "石坛连竹静，醮火照山红。",
        "再拜开金箓，焚香使玉童。",
        "蓬瀛三岛至，天地一壶通。",
        "别客曾留药，逢舟或借风。",
        "出游居鹤上，避祸入羊中。",
        "过洞偏回首，登门未发蒙。",
        "桑田如可见，沧海几时空。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 347089,
      "title": "得山中道友书寄苗钱二员外",
      "content": [
        "有谋皆𫐘轲，非病亦迟回。",
        "壮志年年减，驰晖日日催。",
        "还山不及伴，到阙又无媒。",
        "高卧成长策，微官称下才。",
        "诗人识何谢，居士别宗雷。",
        "迹向尘中隐，书从谷口来。",
        "药栏遭鹿践，涧户被猿开。",
        "野鹤巢云窦，游龟上水苔。",
        "新欢追易失，故思渺难裁。",
        "自有归期在，劳君示劫灰。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 347090,
      "title": "酬前驾部员外郎苗发",
      "content": [
        "马融方值校，阅简复持铅。",
        "素业高风继，青春壮思全。",
        "论文多在夜，宿寺不虚年。",
        "自署区中职，同荒郭外田。",
        "山邻三径绝，野意八行传。",
        "煮玉矜新法，留符识旧仙。",
        "涵苔溪溜浅，摇浪竹桥悬。",
        "复洞潜栖燕，疏杨半翳蝉。",
        "咏歌虽有和，云锦独成妍。",
        "应以冯唐老，相讥示此篇。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 347091,
      "title": "宿荐福寺东池有怀故园因寄元校书",
      "content": [
        "暮雨风吹尽，东池一夜凉。",
        "伏流回弱荇，明月入垂杨。",
        "石竹闲开碧，蔷薇暗吐黄。",
        "倚琴看鹤舞，摇扇引桐香。",
        "旧笋方辞箨，新莲未满房。",
        "林幽花晚发，地远草先长。",
        "抚枕愁华鬓，凭栏想故乡。",
        "露余清汉直，云卷白榆行。",
        "惊鹊仍依树，游鱼不过梁。",
        "系舟偏忆戴，炊黍愿期张。",
        "末路还思借，前恩讵敢忘。",
        "从来叔夜懒，非是接舆狂。",
        "众病婴公干，群忧集孝璋。",
        "惭将多误曲，今日献周郎。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 347092,
      "title": "送王副使还并州",
      "content": [
        "并州近胡地，此去事风沙。",
        "铁马垂金络，貂裘犯雪花。",
        "曾持两郡印，多比五侯家。",
        "继世新恩厚，从军旧国赊。",
        "戍烟千里直，边雁一行斜。",
        "想到清油幕，长谋出左车。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 347093,
      "title": "晚春过夏侯校书值其沉醉戏赠",
      "content": [
        "欹冠枕如意，独寝落花前。",
        "姚馥清时醉，边韶白日眠。",
        "曝裈还当屋，张幕便成天。",
        "谒客唯题凤，偷儿欲觇毡。",
        "失杯犹离席，坠履反登筵。",
        "本是墙东隐，今为瓮下仙。",
        "卧龙髯乍磔，栖蝶腹何便。",
        "阮籍供琴韵，陶潜余秫田。",
        "人逢毂阳望，春似永和年。",
        "顾我非工饮，期君行见怜。",
        "尝知渴羌好，亦觉醉胡贤。",
        "炙熟樽方竭，车回辖且全。",
        "噀风仍作雨，洒地即成泉。",
        "自鄙新丰过，迟回惜十年。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 347094,
      "title": "哭张南史因寄南史侄叔宗",
      "content": [
        "争路忽摧车，沈钩未得鱼。",
        "结交唯我少，丧旧自君初。",
        "谏草文难似，围棋智不如。",
        "仲宣新有赋，叔夜近无书。",
        "地闭滕公宅，山荒谢客庐。",
        "歼良从此恨，福善竟成虚。",
        "酿酒多同醉，烹鸡或取余。",
        "阮咸虽永别，岂共仲容疏。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 347095,
      "title": "长安感事呈卢纶",
      "content": [
        "十五事文翰，大儿轻孔融。",
        "长裾游邸第，笑傲五侯中。",
        "谏猎一朝寝，论边素未工。",
        "蹉跎潘鬓至，蹭蹬阮途穷。",
        "贷布怜宁与，无金命未通。",
        "王陵固似戆，郭最遂非雄。",
        "敛板辞群彦，回车访老农。",
        "咏诗怀洛下，送客忆山东。",
        "沈病魂神浊，清斋思虑空。",
        "羸将卫玠比，冷共邺侯同。",
        "草舍才遮雨，荆窗不碍风。",
        "梨教通子守，酒是远师供。",
        "扪虱欣时泰，迎猫达岁丰。",
        "原门唯有席，井饮但加葱。",
        "少壮矜齐德，高年觉宋聋。",
        "寓书先论懒，读易反求蒙。",
        "昔慕能鸣雁，今怜半死桐。",
        "秉心犹似矢，搔首忽如蓬。",
        "赤叶翻藤架，黄花盖菊丛。",
        "聊将呈匠伯，今已学愚公。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 347096,
      "title": "游终南山因寄苏奉礼士尊师苗员外",
      "content": [
        "半岭逢仙驾，清晨独采芝。",
        "壶中开白日，雾里卷朱旗。",
        "猿鸟知归路，松萝见会时。",
        "鸡声传洞远，鹤语报家迟。",
        "童子闲驱石，樵夫乐看棋。",
        "依稀醉后拜，恍惚梦中辞。",
        "海上终难接，人间益自疑。",
        "风尘甘独老，山水但相思。",
        "愿得烧丹诀，流沙永待师。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 347097,
      "title": "长安书事寄卢纶",
      "content": [
        "弱冠家庐岳，从师岁月深。",
        "翻同老夫见，殊寡少年心。",
        "及此时方晏，因之名亦沈。",
        "趋途非要路，避事乐空林。",
        "素业在山下，青泉当树阴。",
        "交游有凋丧，离别代追寻。",
        "向秀初闻笛，钟期久罢琴。",
        "残愁犹满貌，余泪可沾襟。",
        "勿以朱颜好，而忘白发侵。",
        "终期入灵洞，相与炼黄金。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 347102,
      "title": "溪行逢雨与柳中庸",
      "content": [
        "日落众山昏，萧萧暮雨繁。",
        "那堪两处宿，共听一声猿。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
