{
  "data": [
    {
      "id": 13240,
      "title": "四季花",
      "content": [
        "群葩各分荣，此独贯时序。",
        "聊披浅深艳，不易冬春虑。",
        "真宰竟何言，予将造形悟。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 13241,
      "title": "杂兴  其一",
      "content": [
        "寒暑亟徂谢，日月如崩波。",
        "稚容不再妍，戚戚奈老何。",
        "闻有遯世客，安处西山阿。",
        "手操九籥契，昼夜养丹砂。",
        "药成可化金，举身凌紫霞。",
        "我愿从之游，脱身此世罗。",
        "办装秣吾马，临路更自诃。",
        "古来松乔流，矜己好浮夸。",
        "万一为药误，得无我计差。",
        "速还具肴酒，毋为后人嗟。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 13242,
      "title": "杂兴  其二",
      "content": [
        "河东有贤守，帝念不能已。",
        "欲置之大夫，征轺疾于水。",
        "留邸月余罢，君恩讵可恃。",
        "召以一人誉，去由一人毁。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13243,
      "title": "杂兴  其三",
      "content": [
        "巨平名世贤，媢者强相轧。",
        "毁语填君聪，亡吴计中夺。",
        "人生不如意，在十常九八。",
        "兹事可奈何，惆怅千载末。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13244,
      "title": "杂兴  其四",
      "content": [
        "残暑辞遥夕，初凉澹萧辰。",
        "燕索西飞伴，雁作南来宾。",
        "霁峦静矗矗，远水清鳞鳞。",
        "由来摇落恨，先付长年人。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13245,
      "title": "锦亭晚瞩",
      "content": [
        "长夏宜高明，缓带散烦窘。",
        "凭轩一超然，目与天共尽。",
        "山从云端现，日就林外隠。",
        "风来草树披，烟生井闾近。",
        "自公况多暇，冲臆无留蕴。",
        "即此可宴居，何须事游轸。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 13246,
      "title": "初伏休沐",
      "content": [
        "伏时诏休偃，闭门谢朋侪。",
        "羲和挟升阳，晓气红崔嵬。",
        "炎林欝歊露，焦原横赭埃。",
        "怒甚崒崒云，旱始隆隆雷。",
        "况我庇茨宇，烦襟安得开。",
        "囚拘诉巾帻，仇怨被酒杯。",
        "汤沐未及具，反为虮虱咍。",
        "北风殊杳嘿，羲人安在哉。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 13247,
      "title": "游瞩",
      "content": [
        "颢风肃九旻，楼榭注明迥。",
        "林爽无剩繁，溪澄有余映。",
        "四阿延清霏，六幕尽高兴。",
        "号枝蝉腹厉，掠野鹘拳劲。",
        "山意日久高，差差插空净。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 13248,
      "title": "送蔡元翰贤良昆仲",
      "content": [
        "美箭出东南，之子裒然秀。",
        "绰绰令兄弟，茂器偕年就。",
        "九流无近讨，六艺乃遐究。",
        "诏书求异等，二惠兹来觏。",
        "牍均方朔多，辐比吾丘凑。",
        "蹀足蚁封埸，刷羽桐花囿。",
        "孤音或少和，至宝不期售。",
        "肇允褰褐衣，薄言返岩窦。",
        "江皋看鱼乐，山径怀雉嗅。",
        "无忽豫章材，行参柏梁构。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 13249,
      "title": "送伊阙郑著作",
      "content": [
        "君年已艾服，沿牒困风尘。",
        "硎新始发刃，鸣晚逾惊人。",
        "毋辞滞下邑，姑欲慰斯民。",
        "此路尘车往，明年郊雉驯。",
        "恨乏双凫舄，从子伊水滨。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 13250,
      "title": "揽镜",
      "content": [
        "晚匣写菱影，试观憔悴颜。",
        "支离骨不媚，萧飒鬓垂斑。",
        "安得长康画，致之岩壑间。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 13251,
      "title": "望月西庑作",
      "content": [
        "夏琯倐已新，夕杓见南指。",
        "孤月雾中来，余光淡前戺。",
        "赏襟初不浅，极睇天汉涘。",
        "浮云竟未还，多露已徐委。",
        "太虚本自寂，游氛强为滓。",
        "安得千里风，披霄玩澄晷。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 13252,
      "title": "岁丰",
      "content": [
        "皇天降丰年，本忧贫士食。",
        "贫士无良畴，安能得稼穑。",
        "工佣输富家，日落长叹息。",
        "为供豪者粮，役尽匹夫力。",
        "天地莫施恩，施恩强有得。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 13253,
      "title": "题信相院默庵",
      "content": [
        "对言方有默，因默乃名庵。",
        "庵留默不遣，一物遂为三。",
        "龟扫泥中痕，正恐力弗堪。",
        "自问呵默者，了然成妄谈。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13254,
      "title": "感怀",
      "content": [
        "夕风搜前林，坠叶快如剪。",
        "老月扣户低，倾河去人远。",
        "吉士感物化，劳劳意不展。",
        "辍饮屏樽杓，留釭讨坟典。",
        "触事孟轲迂，临途安国蹇。",
        "不叹岁月遒，所悼功名晚。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 13255,
      "title": "念衰",
      "content": [
        "岁月不待人，驱我向衰境。",
        "朱颜日辞貌，缟鬓飒垂领。",
        "意昏若坐雾，欢坠似羸井。",
        "病多兹及慵，志怯遂依静。",
        "问我何功德，乃玷鸡翘省。",
        "始愿常谬悠，薄霄图振景。",
        "栈车值塞路，蹇蹇莫吾骋。",
        "君恩盖如天，分虎向东郢。",
        "沈忧诚万绪，通宵付耿耿。",
        "失旦安暇鸣，值露徒能警。",
        "私计狭且偷，荣路浩方永。",
        "惟余昧死章，将露乞身请。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 13256,
      "title": "拟东武曲二首  其一",
      "content": [
        "甘泉烽火照黄昏，候骑骎骎入雁门。",
        "光禄塞前逢夜月，黄龙城下见愁云。",
        "隠隠轻雷逐车响，颜行使者乐相望。",
        "劳军细柳尊亚夫，持节云中赦魏尚。",
        "自从天子乐休牛，故障遗亭岂重修。",
        "李广不生高祖世，岂得今封万户侯。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 13257,
      "title": "拟东武曲二首  其二",
      "content": [
        "我家世世山西士，二十期门从天子。",
        "始随骠骑破祁连，晚逐楼船下䍧水。",
        "汉北雰雰飞雪暗，海中跕跕翔鸢坠。",
        "归来武库祭蚩尤，得从甘泉参豹尾。",
        "何意一朝兵后期，簿责侵诬属军吏。",
        "黄金纳赎为庶人，白首还家事田里。",
        "结发从军七十战，利镞金痍犹可记。",
        "龙钟虽入玉关门，止呵还遇灞陵尉。",
        "不及金张藉旧勋，七叶华貂长富贵。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 13258,
      "title": "少年行",
      "content": [
        "君不见汉家五陵诸少年，白马骊驹大道边。",
        "紫纶裁帽映两纽，黄金错带佩双鞬。",
        "经过主第赐绿帻，归宴前堂罗曲筵。",
        "长安多逐韩嫣弹，别藏仍收张氏钱。",
        "传言天子将羽猎，千乘万骑向甘泉。",
        "奉车金吾共驰骋，外家戚里见招延。",
        "径去平冈驰狡兔，虚弯天际落飞鸢。",
        "朅来别馆恣行乐，胡姬当罏酒十千。",
        "薄暮聊归渭桥曲，明旦复会黄山前。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 13259,
      "title": "天台梵才师长吉在都数以诗笔见授因答以转句  其一",
      "content": [
        "九霞凝标倚霄极，尔时师在云岩侧。",
        "坐中不起见诸方，满祴天香嗅薝卜。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 13260,
      "title": "天台梵才师长吉在都数以诗笔见授因答以转句  其二",
      "content": [
        "海峤崭崭万佛螺，赤髭半颔谁相过。",
        "卓锡时攀三宿树，翻经讵著四围驼。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 13261,
      "title": "天台梵才师长吉在都数以诗笔见授因答以转句  其三",
      "content": [
        "何年掷钵来京毂，抱蓬成畦紫兰馥。",
        "王公撇席争逢迎，不意当今有平叔。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 13262,
      "title": "天台梵才师长吉在都数以诗笔见授因答以转句  其四",
      "content": [
        "第一多闻师子儿，碧云余力嗣工诗。",
        "尽把天光注言语，真将清气入肝脾。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 13263,
      "title": "天台梵才师长吉在都数以诗笔见授因答以转句  其五",
      "content": [
        "有人官冷抱穷愁，客坐无毡尘影流。",
        "吃口倦谈真寂寞，移书避事喜旬休。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 13264,
      "title": "天台梵才师长吉在都数以诗笔见授因答以转句  其六",
      "content": [
        "愧惭禅嫡来相问，刮目探怀授珍蕴。",
        "已轻安石为老生，更恼王筠赋强韵。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 13265,
      "title": "天台梵才师长吉在都数以诗笔见授因答以转句  其七",
      "content": [
        "比来缁侣颇言文，局促啁啾宁足论。",
        "私地蛙鸣徒聒耳，长沙国小仅回身。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 13266,
      "title": "天台梵才师长吉在都数以诗笔见授因答以转句  其八",
      "content": [
        "惟师墨海多雄藻，具足身中无欠宝。",
        "先追御寇跨泠风，后伴骚人拾香草。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 13267,
      "title": "天台梵才师长吉在都数以诗笔见授因答以转句  其九",
      "content": [
        "嗟余投报乏琼瑰，目睇金园剩九回。",
        "篮轝媻姗两生举，定容元亮醉中来。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 13268,
      "title": "谢提点刑狱李郎中赠扇",
      "content": [
        "规裁珍素裂轻云，柄剪春篁燥丛露。",
        "制以为扇持赠君，拂君怀袖袪君暑。",
        "蜀天六月苦炎歊，赤龙秋秋驻云雾。",
        "火走肤脉汗若流，暗逗浮凉下天宇。",
        "画作飞蝇缘误点，徐隔游尘不成污。",
        "何以为报我知之，奉扬仁风慰黎庶。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 13269,
      "title": "咏西湖上寄颍州相公",
      "content": [
        "湖边烟树与天齐，独爱湖波照影时。",
        "崖蒋渚苹春披靡，佛楼僧阁暝参差。",
        "相君万一来湖上，手弄潺湲更忆谁。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 13270,
      "title": "和贾相公览杜工部北征篇",
      "content": [
        "唐家六叶太平罢，宫艳醉骨恬无忧。",
        "阿荦诟天翠华出，糢糊战血腥九州。",
        "干疮坤痍四海破，白日杀气寒飕飗。",
        "少陵背贼走行在，采梠拾橡填饥喉。",
        "眼前乱离不忍见，作诗感慨陈大猷。",
        "北征之篇辞最切，读者心陨如摧辀。",
        "莫肯念乱小雅怨，自然流涕袁安愁。",
        "才高位下言不入，愤气鬰屈蟠长虬。",
        "今日奔亡匪天作，向来颠倒皆庙谋。",
        "忠骸佞骨相撑拄，一燎同烬悲昆丘。",
        "相君览古慨前事，追美子美真诗流。",
        "前王不见后王见，愿以此语贻千秋。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 13271,
      "title": "罗承制自戎州罢归",
      "content": [
        "乘障一麾逮出守，终更三岁今来旋。",
        "巴云晨趣东北道，僰月晓背西南天。",
        "故人把酒数卷白，离亭赠柳长于鞭。",
        "属羌羁诏久款塞，归为天子细论边。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13272,
      "title": "高亭驻眺招宫苑张端臣",
      "content": [
        "蜀天向腊寒未极，倚槛绵睇亭臯分。",
        "一萍团红江上日，数盖淡白楼头云。",
        "杯中竹叶与谁举，笛里梅花那忍闻。",
        "愿君枉步数相劳，他时离绪徒纷纷。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13273,
      "title": "嘉祐庚子秋七月予还台明年始对家圃春物作",
      "content": [
        "十年去国老蒙召，今岁始见家园春。",
        "双燕初来即宾客，群鶑相逢如故人。",
        "蒙茸草树延野色，碎璅鲑菜供盘珍。",
        "多惭吾党共醒醉，收得泽边憔悴身。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13274,
      "title": "登齐云亭",
      "content": [
        "少城西北最高处，凭槛极眺襟怀开。",
        "糢糊烟树鸟边静，突兀云山天外来。",
        "归樯栉栉逗淮浦，凉飔猎猎生岩隈。",
        "虽非吾土信云美，伴客留连倾一杯。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13275,
      "title": "太庙侍祠雪霁有作",
      "content": [
        "喜雪静氛埃，繁云即日回。",
        "清光动冠剑，余素著楼台。",
        "树杂琼枝竦，途平玉辙开。",
        "惟应余两骑，知是海神来。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13276,
      "title": "和吴侍郎朝谒天庆宫",
      "content": [
        "上路鸣驺远，丛霄故馆开。",
        "华簪尧豸出，轻舄汉凫来。",
        "探妙云敷笈，蠲烦露溢杯。",
        "直须重缔约，飞盖一徘徊。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13277,
      "title": "后苑赏花钓鱼应制",
      "content": [
        "清籞披兰路，雕舆眷蕙辰。",
        "汉池平浴日，温树暗留春。",
        "乐石来威凤，恩波上翠鳞。",
        "成文传睿唱，赓曲徧华绅。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13278,
      "title": "元会诗",
      "content": [
        "宝典丛三朔，中闱辟九阍。",
        "群臣深拱宁，列仗俨屯门。",
        "辇出东房秘，辰居北极尊。",
        "熊罴连案负，日月傍旗翻。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13279,
      "title": "奉和圣制清明日",
      "content": [
        "璇杓临乙位，羲御届娄初。",
        "碧浪桃花涌，珍丛锦段舒。",
        "轮蹄晴缥缈，钟漏夕虚徐。",
        "穆穆宣温殿，披文日有余。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13280,
      "title": "晨赴书局",
      "content": [
        "上直蓬山远，轻轩截九逵。",
        "晓光衔睥睨，秋色静罘罳。",
        "渐觉苏裘敝，行嗟潘领衰。",
        "鹪鹩自有志，不羡帝梧枝。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13281,
      "title": "和道卿舍人奉祠太一斋宫  其一",
      "content": [
        "素秋来蕊馆，瑞祝达霄晨。",
        "苹荐祠无饩，楼居地不尘。",
        "掷波琴鲤乐，傍畤汉鸡驯。",
        "此际清怀极，盈杯沆瀣津。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13282,
      "title": "和道卿舍人奉祠太一斋宫  其二",
      "content": [
        "尘氛不可到，深注五城楼。",
        "素瑟少今韵，仙春无俗秋。",
        "晨杯三秀洁，夜檠九光流。",
        "顺报通霄极，纷纶瑞福遒。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13283,
      "title": "和道卿舍人奉祠太一斋宫  其三",
      "content": [
        "地占丛霄胜，人持禁橐来。",
        "诗长清夜徧，祠罢素秋回。",
        "爽籁天中发，虚弦月际开。",
        "无容以风解，身自到蓬莱。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13284,
      "title": "和天休舍人奉祠太一宫见寄",
      "content": [
        "顺祝斋琳馆，翛然隔世埃。",
        "空歌灵鹄下，祠节宝鸡来。",
        "瑞木千寻竦，仙图几卷开。",
        "如无清夜唱，谁识帝车回。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13285,
      "title": "玉堂感旧",
      "content": [
        "七年辞玉署，再入佐黄扉。",
        "树与青春换，人将素领归。",
        "砖花仍可记，厦雀稍惊飞。",
        "炉蕙非无意，逢人尚袭衣。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13286,
      "title": "旬沐二首  其一",
      "content": [
        "薄澣还私室，陶嘉属小园。",
        "笋余林向密，花后果初繁。",
        "燕口将泥重，蜂脾抱蜜喧。",
        "此时萧散意，都欲忘乘轩。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13287,
      "title": "旬沐二首  其二",
      "content": [
        "待诏官非急，还家体不勤。",
        "里无休汝骑，窗有上羲人。",
        "密树稍迎夏，晚花犹及春。",
        "幽怀谁与晤，杯酒强相亲。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13288,
      "title": "学舍直归晚霁三首  其一",
      "content": [
        "骤雨挫炎威，归轩广陌西。",
        "渠声流作瀑，日脚侧成霓。",
        "换锦龙媒埒，淹花燕子泥。",
        "比来巾角垫，李郭定相携。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13289,
      "title": "学舍直归晚霁三首  其二",
      "content": [
        "雨罢残阳在，风微酷暑收。",
        "余昏淡云翳，聚沫泛河流。",
        "桃簟双纹展，盘瓜五色浮。",
        "潘郎最多感，庭树莫先秋。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13290,
      "title": "学舍直归晚霁三首  其三",
      "content": [
        "密雾披层宙，浓云霁四溟。",
        "乱流初潄玉，红日不藏萍。",
        "万叶张晴幄，千山卓翠屏。",
        "无烦事铙吹，蛙响自堪听。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13291,
      "title": "赴直马上观市",
      "content": [
        "上直驱羸马，凌晨望百廛。",
        "垆喧涤器市，箫暖卖饧天。",
        "流水随轻毂，翻花送驶鞯。",
        "区区市门吏，无复子真仙。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13292,
      "title": "初到郡斋  其一",
      "content": [
        "专城四十外，中石二千余。",
        "旷日惭良术，班春頼细书。",
        "学慵前志忘，身远故人疏。",
        "姑俟天藏疾，雌堂日燕居。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13293,
      "title": "初到郡斋  其二",
      "content": [
        "省分由来拙，操心本自危。",
        "十年今得调，三匝此逢枝。",
        "攘臂贪丰粟，装怀倦诉词。",
        "竹林谁见忆，迢递始平麾。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13294,
      "title": "初到郡斋三首  其一",
      "content": [
        "暂解枢机任，来从海上闲。",
        "浮云富贵外，一马是非间。",
        "月衮生潮浦，风香堕桂山。",
        "苍生虽系望，要作冶城还。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13295,
      "title": "初到郡斋三首  其二",
      "content": [
        "我里诚云乐，公今况释劳。",
        "秋莼不下豉，霜蟹恣持螯。",
        "林静来晨燎，江喧入夜涛。",
        "功成奋嘉藻，宁欲傍离骚。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13296,
      "title": "初到郡斋三首  其三",
      "content": [
        "温省绸缪罢，乡州偃息时。",
        "鹤情归不怨，凤德老无衰。",
        "月树供园莳，仙囊续宴巵。",
        "自惭淮守薄，千里与言诗。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13297,
      "title": "到官三岁四首  其一",
      "content": [
        "芳岁已三换，宠名仍再迁。",
        "生平一丘壑，衰晚右櫜鞬。",
        "客眼登楼外，乡愁把酒前。",
        "巾箱多旧赋，只是欠归田。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13298,
      "title": "到官三岁四首  其二",
      "content": [
        "一忝中山守，仍班第四春。",
        "老应无所事，少尚不如人。",
        "适野愚谋短，将芜旧产贫。",
        "须惭丈二组，羁束最慵身。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13299,
      "title": "到官三岁四首  其三",
      "content": [
        "儒帅非真帅，瓜时定几时。",
        "丹心虽许壮，白发不藏衰。",
        "罟密游鳞骇，山遥倦翼迟。",
        "岁成无奏最，准拟雁门踦。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13300,
      "title": "到官三岁四首  其四",
      "content": [
        "塞下静无事，军中奚告劳。",
        "青山侧身远，白日举头高。",
        "作奏闲双笔，流年耗二毛。",
        "惟应不能饮，元解读离骚。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13301,
      "title": "颍上唐公张集仙相劳",
      "content": [
        "去时成恨恨，喜见眼中人。",
        "共束西昆帙，都为左虎邻。",
        "年华衰意早，酒所故情亲。",
        "后日孤舟远，离怀怯重陈。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13302,
      "title": "同张子春淮上作",
      "content": [
        "南风今日好，归棹上淮津。",
        "川迥舟如叶，山遥石似人。",
        "波光篙底动，沙垒涨余新。",
        "谁信机心少，溪鸥伴此身。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13303,
      "title": "思归",
      "content": [
        "去国倏三岁，颇知归思纷。",
        "南心晓城斗，北眼暮楼云。",
        "珥笔行将脱，朝珂冷不闻。",
        "莫论持帅节，畎亩尚思君。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13304,
      "title": "有诏换淮阳",
      "content": [
        "比出淮阳守，今移寰内州。",
        "真无弱翁治，只是茂陵求。",
        "换节矜新假，循襟释故愁。",
        "桑榆知未晚，前失庶能收。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13305,
      "title": "次江都  其一",
      "content": [
        "道险疑无地，岩高欲近天。",
        "家收代田粟，官铸即山钱。",
        "云变阴晴候，林容旦暮烟。",
        "落花真有意，时解拂行鞯。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13306,
      "title": "次江都  其二",
      "content": [
        "江溜滩滩急，崖腰栈栈新。",
        "天深罕见日，路险不容尘。",
        "远草夤缘绿，幽花落漠春。",
        "逢津何必问，夫我自知津。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13307,
      "title": "齐云亭晚瞩",
      "content": [
        "山暝日云稷，天清风寖和。",
        "树花红暗淡，城草绿坡陀。",
        "归艇冲烟去，昏凫接翅过。",
        "年华无限乐，判作是狂歌。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13308,
      "title": "惠民隄河晚瞩",
      "content": [
        "远水同萦带，联隄类筑垣。",
        "行舟压天底，卧木拥沙痕。",
        "鲂𫚈逃空罶，凫鹥泊迥村。",
        "层波真可羡，由此到都门。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13309,
      "title": "九日至卫南",
      "content": [
        "良辰独据鞍，节物强相干。",
        "酒驻衰颜浅，风吹客帽寒。",
        "暂吟非有属，倦曲不成欢。",
        "多谢黄花意，还如故国看。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13310,
      "title": "郑子产庙",
      "content": [
        "不知东里叟，遗迹但堪寻。",
        "语爱东家泪，论交季子心。",
        "故坟犹有石，遗鼎遂无金。",
        "谬政为邦久，千秋谢所钦。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13311,
      "title": "叠嶂楼",
      "content": [
        "霍射盘西北，高楼胜览并。",
        "景闲思谢守，名重拟宣城。",
        "天阙云来缓，风微鸟去轻。",
        "客忧销更有，须到此中倾。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13312,
      "title": "去郑暮次中牟",
      "content": [
        "暮投京县宿，气象已纷罗。",
        "菀树道旁密，侯田关内多。",
        "高城切星斗，秋水似天河。",
        "自问还台马，犹余几子珂。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13313,
      "title": "废郑河",
      "content": [
        "当年食溱洧，此地控长津。",
        "却见为陵日，难寻病涉人。",
        "落霞遥送鹜，荐草暗留麏。",
        "代往诗风变，田渠数报春。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13314,
      "title": "宛丘作",
      "content": [
        "宛丘真善地，承诏幸班春。",
        "铃下听无讼，日边来有人。",
        "吟余多感客，睡足本慵身。",
        "虮虱休相贺，吾今汤沐频。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13315,
      "title": "望汉江",
      "content": [
        "西导岷源阔，南浮楚望开。",
        "弄珠嫌蚌隠，投璧让蛟回。",
        "岸翠山烟逼，波红日影来。",
        "万艘徒扰扰，谁是济川材。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13316,
      "title": "次剑门",
      "content": [
        "昔驱千骑往，今解五鱼还。",
        "谁惮老销髀，自怜生入关。",
        "春风来迥野，晓斗挂空山。",
        "却整康成帢，依然愧腻颜。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13317,
      "title": "陇州鱼龙川石鱼",
      "content": [
        "纤鳞藏介石，物化自何年。",
        "无复西江水，长依东海田。",
        "苔纹堪代藻，云叶即成莲。",
        "琥珀藏蚊影，佳名共此传。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13318,
      "title": "次梓潼",
      "content": [
        "行行芳序深，秀色媚诸岑。",
        "早叶易经吹，暖云难久阴。",
        "拥条孤狖啸，戏荇一凫沈。",
        "不是无樽酒，其谁共献斟。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13319,
      "title": "张亚子庙",
      "content": [
        "伟哉真丈夫，庙食此山隅。",
        "生作百夫特，死为南面孤。",
        "鹿庖偿故约，雷杼验幽符。",
        "潼水无时腐，英名相与俱。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13320,
      "title": "敝俗",
      "content": [
        "陶姚民屋富，梁魏敝风存。",
        "士阙游乡校，人争倚市门。",
        "椎埋时结客，博掩竞成喧。",
        "谁与迁荼堇，移甘膴膴原。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13321,
      "title": "城外",
      "content": [
        "次舍梁陈外，风烟周郑间。",
        "徐驱四郊路，徧识属城山。",
        "野雪融残素，岑霞就暝殷。",
        "几宵星影动，知伴传车还。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13322,
      "title": "题蜀州修觉寺",
      "content": [
        "蜀嶂纷重沓，祇园隠寂寥。",
        "花供法界雨，江助梵音朝。",
        "海水闻钟下，天风引磬遥。",
        "少陵佳句后，物色付吾僚。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13323,
      "title": "巡视河防置酒晚归作二首  其一",
      "content": [
        "古戍连沙曲，层阿属岸隈。",
        "天长倦鸟没，山晚跛牂回。",
        "斜日低官树，轻寒犯客杯。",
        "还城闻暮角，三叠落江梅。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13324,
      "title": "巡视河防置酒晚归作二首  其二",
      "content": [
        "夹石双隄转，逍遥千骑留。",
        "川昏多昼雾，水落足寒洲。",
        "岸石危相倚，桥澌暮不流。",
        "风烟非渭曲，谁有钓璜钩。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13325,
      "title": "转运彭季长学士小集数辞宴集",
      "content": [
        "此日疾为解，遂将杯酒疏。",
        "多愁庾开府，苦瘦沈尚书。",
        "倦曲琴𫋹后，霏香药裹余。",
        "莫令诗思剧，正是落花初。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13326,
      "title": "送张法曹",
      "content": [
        "驶骑柳枝鞭，春逵望雒廛。",
        "赋才宾右俊，掾诺府中贤。",
        "宫楯含樱密，王渠泛醳联。",
        "胜期资一笑，刑矢措周年。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13327,
      "title": "送吕太初法曹之许田",
      "content": [
        "秋涯舣客舻，潘鬓不胜梳。",
        "去决卿军事，还亲城旦书。",
        "驿鸦啼月早，庖鲤跃冰余。",
        "白冲公庭步，翘材首曳裾。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13328,
      "title": "农歌",
      "content": [
        "农歌非度曲，新乐信蚩蚩。",
        "迺父知田事，吾王采谚辞。",
        "折杨时动笑，鼓腹自成嬉。",
        "日暮牛童笛，连声下远陂。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13329,
      "title": "初宿东阁追忆文简丁公作",
      "content": [
        "辞阁玉堂东，依然昔所从。",
        "旧池空叹凤，残友不成龙。",
        "制藁流尘积，砖花驳藓重。",
        "过车三步约，何日酹茔松。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13330,
      "title": "三司晏尚书西园玩菊",
      "content": [
        "涉园求胜赏，时菊艳秋光。",
        "散漫仙潭饵，褵褷瑞鹄裳。",
        "酒熏吹晚蕊，蜂冷抱残香。",
        "公意周盈感，留杯尽夕阳。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13331,
      "title": "玩斋前菊",
      "content": [
        "高秋玩佳菊，繁采照前除。",
        "似粟金无算，为裳鹄有余。",
        "不甘兴薏谤，长免共兰鉏。",
        "为尔浮罇酒，非邀栗里舆。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13332,
      "title": "望僊亭书所见  其一",
      "content": [
        "危轩冠层堞，永日付登临。",
        "寒雁犹能阵，乔柯自不林。",
        "溪流横趣岛，樵路侧依岑。",
        "西北虽堪望，浮云易作阴。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13333,
      "title": "望僊亭书所见  其二",
      "content": [
        "南国冬无雪，居然气候迷。",
        "柔蔬傲霜甲，幽鸟逆春啼。",
        "神鼓声无歇，樵歌韵不齐。",
        "举头看白日，还过太山西。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13334,
      "title": "和杨学士同晏尚书西园对菊",
      "content": [
        "岁秋无异卉，佳菊自成妍。",
        "薄采称觞客，繁开落帽天。",
        "抱池闲沮洳，留蝶小翩翾。",
        "为结胡公赏，并怀郦水边。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
