{
  "data": [
    {
      "id": 265229,
      "title": "和令狐相公以司空裴相见招南亭看雪四韵",
      "content": [
        "重门不下关，枢务有余闲。",
        "上客同看雪，高亭尽见山。",
        "瑞呈霄汉外，兴入笑言间。",
        "知是平阳会，人人带酒还。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265230,
      "title": "和郓州令狐相公春晚对花",
      "content": [
        "朱门退公后，高兴对花枝。",
        "望阙无穷思，看书欲尽时。",
        "含芳朝竞发，凝艳晚相宜。",
        "人意殷勤惜，狂风岂得知。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265231,
      "title": "酬令狐相公春日言怀见寄",
      "content": [
        "前陪看花处，邻里近王昌。",
        "今想临戎地，旌旗出汶阳。",
        "营飞柳絮雪，门耀戟枝霜。",
        "东望清河水，心随艑上郎。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265232,
      "title": "途次大梁雪中奉天平令狐相公书问兼示新什因思曩岁从此拜辞形于短篇以申仰谢",
      "content": [
        "远守宦情薄，故人书信来。",
        "共曾花下别，今独雪中回。",
        "纸尾得新什，眉头还暂开。",
        "此时同鴈鹜，池上一徘徊。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265233,
      "title": "酬令狐相公秋怀见寄",
      "content": [
        "寂寞蝉声静，差池燕羽回。",
        "秋风怜越绝，朔气想台骀。",
        "相去数千里，无因同一杯。",
        "殷勤望飞鴈，新自塞垣来。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 265234,
      "title": "酬[太]原令狐相公见寄",
      "content": [
        "书信来天外，琼瑶满匣中。",
        "衣冠南渡远，旌节北门雄。",
        "鹤唳华亭月，马嘶榆塞风。",
        "山川几千里，惟有两心同。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265235,
      "title": "酬令狐相公岁暮远怀见寄",
      "content": [
        "别侣孤鹤怨，冲天威凤归。",
        "容光一以间，梦想是耶非。",
        "芳讯远弥重，知音老更稀。",
        "不如湖上鴈，北向整毛衣。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265236,
      "title": "酬令狐相公亲仁郭家花下即事见寄",
      "content": [
        "荀令园林好，山公游赏频。",
        "岂无花下侣，远望眼中人。",
        "斜日渐移影，落英纷委尘。",
        "一吟相思曲，惆怅江南春。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265237,
      "title": "酬令狐相公首夏闲居书怀见寄",
      "content": [
        "蕙草芳未歇，绿槐阴已成。",
        "金罍唯独酌，瑶瑟有离声。",
        "翔泳各殊势，篇章空寄情。",
        "应怜三十载，未变使君名。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265238,
      "title": "酬令狐相公庭前白菊花谢偶书所怀见寄",
      "content": [
        "数丛如雪色，一旦冒霜开。",
        "寒蘂差池落，清香断续来。",
        "思深含别怨，芳谢惜年催。",
        "千里难同赏，看看又早梅。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265239,
      "title": "酬令狐相公季冬南郊宿斋见寄",
      "content": [
        "坛下雪初霁，南城冻欲生。",
        "斋心祠上帝，高步领名卿。",
        "沐浴含芳泽，周旋听佩声。",
        "犹怜广平守，寂寞竟何成。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265240,
      "title": "贞元中侍郎舅氏牧华州时余再忝科第前后由华觐谒陪登伏毒寺屡焉亦曾赋诗题于梁栋今典冯诩暇日登楼南望三峰浩然生思追想昔年之事因成篇题旧寺",
      "content": [
        "曾作关中客，频经伏毒岩。",
        "晴烟沙苑树，晚日渭川帆。",
        "昔是青春貌，今悲白雪髯。",
        "郡楼空一望，含意卷高帘。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265241,
      "title": "酬令狐相公杏园花下饮有怀见寄",
      "content": [
        "年年曲江望，花发即经过。",
        "未饮心先醉，临风思倍多。",
        "三春看又尽，两地欲如何。",
        "日望长安道，空成劳者歌。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265242,
      "title": "令狐相公见示题洋州崔侍郎宅双木瓜花顷接侍郎同舍陪宴树下吟翫来什辄成和章",
      "content": [
        "金牛蜀楼远，玉树帝城春。",
        "荣耀生华馆，逢迎欠主人。",
        "帘前疑小雪，墙外丽行尘。",
        "来去皆回首，情深是德邻。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265243,
      "title": "和令狐相公春早朝回盐铁使院中作",
      "content": [
        "柳动御沟清，威迟堤上行。",
        "城隅日未过，山色雨初晴。",
        "莺避传呼起，花临府署明。",
        "簿书盈几案，要自有高情。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265244,
      "title": "和令狐仆射相公题龙回寺",
      "content": [
        "兹地回銮日，皇家禅圣时。",
        "路无胡马迹，人识汉官仪。",
        "天子旌旗度，法王龙象随。",
        "知怀去家叹，经此益迟迟。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265245,
      "title": "令狐相公频示新什早春南望遐想汉中因抒短章以寄情愫",
      "content": [
        "军城临汉水，旌斾起春风。",
        "远思见江草，归心看塞鸿。",
        "野花沿古道，新叶映行宫。",
        "惟有诗兼酒，朝朝两不同。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265246,
      "title": "和令狐相公咏栀子花",
      "content": [
        "蜀国花已尽，越桃今已开。",
        "色疑琼树倚，香似玉京来。",
        "且赏同心处，那忧别叶催。",
        "佳人如拟咏，何必待寒梅。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265247,
      "title": "詶令狐相公新蝉见寄",
      "content": [
        "相去三千里，闻蝉同此时。",
        "清吟晓露叶，愁噪夕阳枝。",
        "忽尔弦断绝，俄闻管参差。",
        "洛桥碧云晚，西望佳人期。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265248,
      "title": "詶乐天闲卧见寄",
      "content": [
        "散诞向阳眠，将闲敌地仙。",
        "诗情茶助爽，药力酒能宣。",
        "风碎竹间日，露明池底天。",
        "同年未同隐，缘欠买山钱。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265249,
      "title": "詶乐天小亭寒夜有怀",
      "content": [
        "寒夜阴云起，疎林宿鸟惊。",
        "斜风闪灯影，迸雪打窗声。",
        "竟夕不能寐，同年知此情。",
        "汉皇无奈老，何况本书生。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265250,
      "title": "将之官留辞裴令公留守",
      "content": [
        "祖帐临伊水，前旌指渭河。",
        "风烟里数少，云雨别情多。",
        "重叠受恩久，邅回如命何。",
        "东山与东阁，终异再经过。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265251,
      "title": "詶喜相遇同州与乐天替代",
      "content": [
        "旧托松心契，新交竹使符。",
        "行年同甲子，筋力羡丁夫。",
        "别后诗成帙，携来酒满壶。",
        "今朝停五马，不独为罗敷。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265252,
      "title": "闲坐忆乐天以诗问酒熟未",
      "content": [
        "案头开缥帙，肘后检青囊。",
        "唯有达生理，应无治老方。",
        "减书存眼力，省事养心王。",
        "君酒何时熟，相携入醉乡。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265253,
      "title": "秋中暑退赠乐天",
      "content": [
        "暑服宜秋著，清琴入夜弹。",
        "人情皆向菊，风意欲摧兰。",
        "岁稔贫心泰，天凉病体安。",
        "相逢取次第，却甚少年欢。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265254,
      "title": "乐天池馆夏景方妍白莲初开彩舟空泊唯邀缁侣因以戏之",
      "content": [
        "池馆今正好，主人何寂然。",
        "白莲方出水，碧树未鸣蝉。",
        "静室宵闻磬，斋厨晚绝烟。",
        "蕃僧如共载，应不是神仙。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265255,
      "title": "詶乐天感秋凉见寄",
      "content": [
        "庭晚初辨色，林秋微有声。",
        "槿衰犹强笑，莲逈却多情。",
        "簷燕归心动，鞲鹰俊气生。",
        "闲人占闲景，酒熟且同倾。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265256,
      "title": "秋晚新晴夜月如练有怀乐天",
      "content": [
        "雨歇晚霞明，风调夜景清。",
        "月高微晕散，云薄细鳞生。",
        "露草百虫思，秋林千叶声。",
        "相望一步地，脉脉万重情。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265257,
      "title": "新秋对月寄乐天",
      "content": [
        "月露发光彩，此时方见秋。",
        "夜凉金气应，天静火星流。",
        "蛩响偏依井，萤飞直过楼。",
        "相知尽白首，清景复追游。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265258,
      "title": "詶乐天小台晚坐见忆",
      "content": [
        "小台堪远望，独上清秋时。",
        "有酒无人劝，看山秖自知。",
        "幽禽啭新竹，孤莲落静池。",
        "高门勿遽掩，好客无前期。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265259,
      "title": "早秋雨后寄乐天",
      "content": [
        "夜云起河汉，朝雨洒高林。",
        "梧叶先风落，草虫迎湿吟。",
        "簟凉扇恩薄，室静琴思深。",
        "且喜炎前别，安能怀寸阴。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265260,
      "title": "秋晚病中乐天以诗见问力疾奉酬",
      "content": [
        "耳虚多听远，展传晨鸡鸣。",
        "一室背灯卧，中宵扫叶声。",
        "兰芳经雨败，鹤病得秋轻。",
        "肯踏衡门草，唯应是友生。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265261,
      "title": "和乐天烧药不成命酒独醉",
      "content": [
        "九转欲成就，百神应主持。",
        "婴啼鼎上去，老貌镜前悲。",
        "却顾空丹灶，回心向酒巵。",
        "醺然耳热后，暂似少年时。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265262,
      "title": "元日乐天见过因举酒为贺",
      "content": [
        "渐入有年数，喜逢新岁来。",
        "震方天籁动，寅位帝车回。",
        "门巷扫残雪，林园惊早梅。",
        "与君同甲子，寿酒让先杯。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265263,
      "title": "詶马大夫以愚献通草茇葜酒感通拔二字因而寄别之作",
      "content": [
        "泥沙难振拔，谁复问穷通。",
        "莫讶提壶赠，家传枕曲风。",
        "成谣独酌后，深意片言中。",
        "不进终无已，应须荀令公。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265264,
      "title": "奉和司空裴相公中书即事通简旧僚之作",
      "content": [
        "谭笑在岩廊，人人尽所长。",
        "仪形见山立，文字动星光。",
        "日运丹青笔，时看赤白囊。",
        "伫闻戎马息，入贺领鸳行。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265265,
      "title": "微之镇武昌中路见寄蓝桥怀旧之作凄然继和兼寄安平",
      "content": [
        "今日油幢引，他年黄纸追。",
        "同为三楚客，独有九霄期。",
        "宿草恨长在，伤禽飞尚迟。",
        "武昌应已到，新柳映红旗。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265266,
      "title": "将赴苏州途出洛阳留守李相公累申宴饯宠行话旧形于篇章谨抒下情以申仰谢",
      "content": [
        "岁杪风物动，雪余宫苑晴。",
        "兔园宾客至，金谷管弦声。",
        "洛水故人别，吴宫新燕迎。",
        "越郎忧不浅，怀袖有琼英。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265267,
      "title": "牛相公留守见示城外新墅有溪竹秋月亲情多往宿游恨不得去因成四韵兼简洛中亲故之什兼命同作",
      "content": [
        "别墅洛城外，月明村野通。",
        "光辉满地上，丝管发舟中。",
        "堤艳菊花露，岛凉松叶风。",
        "高情限清禁，寒漏滴深宫。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265268,
      "title": "牛相公林亭雨后偶成",
      "content": [
        "飞雨过池阁，浮光生草树。",
        "新竹开粉奁，初莲𦶟香注。",
        "野花无时节，水鸟自来去。",
        "若问知境人，人间第一处。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265269,
      "title": "詶滑州李尚书秋日见寄",
      "content": [
        "一入石渠署，三闻宫树蝉。",
        "丹霄未得路，白发又添年。",
        "双节外台贵，孤箫中禁传。",
        "征黄在旦夕，早晚发南燕。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265270,
      "title": "和西川李尚书汉州微月游房太尉西湖",
      "content": [
        "木落汉川夜，西湖悬玉钩。",
        "旌旗环水次，舟檝泛中流。",
        "目极想前事，神交如共游。",
        "瑶琴久已绝，松韵自悲秋。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265271,
      "title": "和重题",
      "content": [
        "林端落照尽，湖上远岚清。",
        "水榭芝兰室，仙舟鱼鸟情。",
        "人琴久寂寞，烟月若平生。",
        "一泛钓璜处，再吟锵玉声。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265272,
      "title": "酬李相公喜归乡国自巩县夜泛洛水见寄",
      "content": [
        "巩树烟月上，清光含碧流。",
        "且无三已色，犹泛五湖州。",
        "鹏息风还起，凤归林正秋。",
        "虽攀小山桂，此地不淹留。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265273,
      "title": "和李相公平泉潭上喜见初月",
      "content": [
        "家山见初月，林壑悄无尘。",
        "幽境此何夕，清光如为人。",
        "潭空破镜入，风动翠蛾嚬。",
        "会向琐窗望，追思伊洛滨。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265274,
      "title": "和李相公初归平泉过龙门南岭遥望山居即事",
      "content": [
        "暂别明庭去，初随优诏还。",
        "曾为鹏鸟赋，喜过凿龙山。",
        "新墅烟火起，野程泉石间。",
        "岩廊人望在，只得片时闲。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265275,
      "title": "和李相公以平泉新墅获方外之名因为诗以报洛中士君子兼见寄之什",
      "content": [
        "业继韦平后，家依昆阆间。",
        "恩华辞北第，潇洒爱东山。",
        "满室图书在，入门松菊闲。",
        "垂天虽暂息，一举出人寰。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265276,
      "title": "发苏州后登武丘寺望海楼",
      "content": [
        "独宿望海楼，夜深珍木冷。",
        "僧房已闭户，山月方出岭。",
        "碧池涵劒彩，宝刹摇星影。",
        "却忆郡斋中，虚眠此时景。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265277,
      "title": "松江送处州奚使君",
      "content": [
        "吴越古今路，沧波朝夕流。",
        "从来别离地，能使管弦愁。",
        "江草带烟暮，海云含雨秋。",
        "知君五陵客，不乐石门游。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265278,
      "title": "题报恩寺",
      "content": [
        "云外支硎寺，名声敌虎丘。",
        "石文留马迹，峰势耸牛头。",
        "泉眼潜通海，松门预带秋。",
        "迟回好风景，王谢昔曾游。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265279,
      "title": "罢郡姑苏北归渡杨子津 一",
      "content": [
        "几岁悲南国，今朝赋北征。",
        "归心渡江勇，病体得秋轻。",
        "海阔石门小，城高粉堞明。",
        "金山旧游寺，过岸听钟声。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265280,
      "title": "罢郡姑苏北归渡杨子津 二",
      "content": [
        "故国荒台在，前临震泽波。",
        "绮罗随世尽，麋鹿古时多。",
        "筑用金锤力，摧因石鼠窠。",
        "昔年雕辇路，唯有采樵歌。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265281,
      "title": "寻汪道士不遇",
      "content": [
        "仙子东南秀，泠然善驭风。",
        "笙歌五云里，天地一壶中。",
        "受箓金华洞，焚香玉帝宫。",
        "我来君闭户，应是向崆峒。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265282,
      "title": "谢柳子厚寄叠石砚",
      "content": [
        "常时同砚席，寄砚感离群。",
        "清越敲寒玉，参差叠碧云。",
        "烟岚馀斐亹，水墨两氛氲。",
        "好与陶贞白，松窻写紫文。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265283,
      "title": "元日感怀",
      "content": [
        "振蛰春潜至，湘南人未归。",
        "身加一日长，心觉去年非。",
        "燎火委虚烬，儿童衒彩衣。",
        "异乡无旧识，车马到门稀。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265284,
      "title": "谢宣州崔相公赐马",
      "content": [
        "浮云金络膝，昨日别朱轮。",
        "衔草如怀恋，嘶风尚意频。",
        "曾将此君子，不是换佳人。",
        "从此西归路，应容蹑后尘。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265285,
      "title": "南中书来",
      "content": [
        "君书问风俗，此地接炎州。",
        "淫祀多青鬼，居人少白头。",
        "旅情偏在夜，乡思岂唯秋。",
        "每羡朝宗水，门前尽日流。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265286,
      "title": "题招隐寺",
      "content": [
        "隐士遗尘在，高僧精舍开。",
        "地形临渚断，江势触山回。",
        "楚野花多思，南禽声例哀。",
        "殷勤最高顶，闲即望乡来。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265287,
      "title": "思归寄山中友人",
      "content": [
        "萧条对秋色，相忆在云泉。",
        "木落病身死，潮平归思悬。",
        "凉钟山顶寺，暝火渡头船。",
        "此地非吾土，闲留又一年。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265288,
      "title": "有感",
      "content": [
        "死且不自觉，其余安可论。",
        "昨宵凤池客，今日雀罗门。",
        "骑吏尘未息，铭旌风已翻。",
        "平生红粉爱，惟解哭黄昏。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265289,
      "title": "途次敷水驿伏覩华州舅氏昔日行县题诗处潸然有感",
      "content": [
        "昔日股肱守，朱轮兹地游。",
        "繁华日已谢，章句此空留。",
        "蔓草佳城闭，故林棠树秋。",
        "今来重垂泪，不忍过西州。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265290,
      "title": "奉和郑相公以考功十弟山姜花俯赐篇咏",
      "content": [
        "采撷黄姜蘂，封题青琐闱。",
        "共闻调膳日，正是退朝归。",
        "响为纤筵发，情随彩翰飞。",
        "故将天下宝，万里与光辉。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265291,
      "title": "题淳于髠墓",
      "content": [
        "生为齐赘壻，死作楚先贤。",
        "应以客卿葬，故临官道边。",
        "寓言本多兴，放意能合权。",
        "我有一石酒，置君坟树前。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265292,
      "title": "送春词",
      "content": [
        "昨来楼上迎春处，今日登楼又送归。",
        "兰蘂残妆含露泣，柳条长袖向风挥。",
        "佳人对镜容颜改，楚客临江心事违。",
        "万古至今同此恨，无如一醉尽忘机。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 265293,
      "title": "送李尚书镇滑州",
      "content": [
        "南徐报政入文昌，东郡须才别建章。",
        "视草名高同蜀客，拥旄年少胜荀郎。",
        "黄河一曲当城下，缇骑千重照路傍。",
        "自古相门还出相，如今人望在岩廊。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 265294,
      "title": "送浑大夫赴丰州",
      "content": [
        "凤衔新诏降恩华，又见旌旗出浑家。",
        "故吏来辞辛属国，精兵愿逐李轻车。",
        "毡裘君长迎风驭，锦带酋豪踏雪衙。",
        "其奈明年好春日，无人唤看牡丹花。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 265295,
      "title": "送源中丞充新罗册立使",
      "content": [
        "相门才子称华簪，持节东行捧德音。",
        "身带霜威辞凤阙，口传天语到鸡林。",
        "烟开鳌背千寻碧，日浴鲸波万顷金。",
        "想见扶桑受恩处，一时西拜尽倾心。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 265296,
      "title": "送王司马之陕州",
      "content": [
        "暂辍清斋出太常，空携诗卷赴甘棠。",
        "府公既有朝中旧，司马应容酒后狂。",
        "案牍来时唯署字，风烟入兴便成章。",
        "两京大道多游客，每遇词人战一场。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 265297,
      "title": "洛中送杨处厚入关便游蜀",
      "content": [
        "洛阳秋日正凄凄，君去西秦更向西。",
        "旧学三冬今转富，曾伤六翮养初齐。",
        "王城晓入窥丹凤，蜀路晴来见碧鸡。",
        "早识卧龙应有分，不妨从此蹑丹梯。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 265298,
      "title": "送周使君罢渝州归郢州别墅",
      "content": [
        "君思郢上吟归去，故自渝南掷郡章。",
        "野戍岸边留画舸，绿萝阴下到山庄。",
        "池荷雨后依香起，庭草春深绶带长。",
        "只恐鸣驺催上道，不容待得晚菘尝。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 265299,
      "title": "奉送浙西李仆射相公赴镇",
      "content": [
        "建节东行是旧游，欢声喜气满吴州。",
        "郡人重得黄丞相，童子争迎郭细侯。",
        "诏下初辞温室树，梦中先到景阳楼。",
        "自怜不识平津阁，遥望旌旗汝水头。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 265300,
      "title": "重送浙西李相公顷廉问江南已经七载后歴滑台剑南两镇遂入相今复领旧地新加旌旄",
      "content": [
        "江北万人看玉节，江南千骑引金铙。",
        "凤从池上游沧海，鹤到辽东识旧巢。",
        "城下清波含百谷，窻中远岫列三茅。",
        "碧鸡白马回翔久，却忆朱方是乐郊。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 265301,
      "title": "送前进士蔡京赴学究科",
      "content": [
        "耳闻战鼓带经锄，振发声名自里闾。",
        "已是世间能赋客，更攻窻下绝编书。",
        "朱门达者谁能识，绛帐书生尽不如。",
        "幸遇天官旧丞相，知君无翼上空虚。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 265302,
      "title": "送唐舍人出镇闽中",
      "content": [
        "暂辞鸳鹭出蓬瀛，忽拥貔貅镇粤城。",
        "闽岭夏云迎皂盖，建溪秋树映红旌。",
        "山川远地由来好，富贵当年别有情。",
        "了却人间婚嫁事，复归朝右作公卿。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 265303,
      "title": "送李中丞赴楚州",
      "content": [
        "缇骑朱旗入楚城，士林皆贺振家声。",
        "儿童但喜迎宾守，故吏犹应记姓名。",
        "万顷水田连郭秀，四时烟月映淮清。",
        "忆君初得昆山玉，同向扬州携手行。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 265304,
      "title": "奉送李户部侍郎自河南尹再除本官归阙",
      "content": [
        "昔年内署振雄词，今日东都结去思。",
        "宫女犹传洞箫赋，国人先咏衮衣诗。",
        "华星却复文昌位，别鹤重归太乙池。",
        "想到金闺待通籍，一时惊喜见风仪。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 265305,
      "title": "送蕲州李郎中赴任",
      "content": [
        "楚关蕲水路非赊，东望云山日夕佳。",
        "薤叶照人呈夏簟，松花满盌试新茶。",
        "楼中饮兴因明月，江上诗情为晚霞。",
        "北地交亲长引领，早将玄鬓到京华。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 265306,
      "title": "送国子令狐博士赴兴元觐省",
      "content": [
        "相门才子高阳族，学省清资五品官。",
        "谏院过时荣棣萼，谢庭归去踏芝兰。",
        "山中花带烟岚晚，栈底江涵雪水寒。",
        "伯仲到家人尽贺，柳营莲府递相欢。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 265307,
      "title": "送李二十九兄员外赴邠宁使幕",
      "content": [
        "家袭韦平身业文，素风清白至今贫。",
        "南宫通籍新郎吏，西候从戎旧主人。",
        "城外草黄秋有雪，烽头烟静虏无尘。",
        "鼎门为别霜天晓，賸把离殇三五巡。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 265308,
      "title": "送分司陈郎中秖召直史馆重修三圣实录",
      "content": [
        "蝉鸣官树引行车，言自成周赴玉除。",
        "远取南朝贵公子，重修东观帝王书。",
        "常时载笔窥金匮，暇日登楼到石渠。",
        "若问旧人刘子政，如今白首在南徐。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 265309,
      "title": "送慧则法师归上都因呈广宣上人",
      "content": [
        "昨日东林看讲时，都人象马蹋琉璃。",
        "雪山童子应前世，金粟如来是本师。",
        "一锡言归九城路，三衣曾拂万年枝。",
        "休公久别如相问，楚客逢秋心更悲。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 265310,
      "title": "送义舟师却还黔南",
      "content": [
        "黔江秋水浸云霓，独泛慈航路不迷。",
        "猨狖窥斋林叶动，蛟龙闻咒浪花低。",
        "如莲半偈心常悟，问菊新诗手自携。",
        "常说摩围似灵鹫，却将山屐上丹梯。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 265311,
      "title": "送景玄师东归",
      "content": [
        "东林寺里一沙弥，心爱当时才子诗。",
        "山下偶随流水出，秋来却赴白云期。",
        "滩头蹑屐挑沙菜，路上停舟读古碑。",
        "想到旧房抛锡杖，小松应有过簷枝。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 265312,
      "title": "汉寿城春望",
      "content": [
        "汉寿城边野草春，荒祠古墓对荆榛。",
        "田中牧竖烧刍狗，陌上行人看石麟。",
        "华表半空经霹雳，碑文才见满埃尘。",
        "不知何日东瀛变，此地还成要路津。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 265313,
      "title": "荆门道怀古",
      "content": [
        "南国山川旧帝畿，宋台梁馆尚依稀。",
        "马嘶古道行人歇，麦秀空城野雉飞。",
        "风吹落叶填宫井，火入荒陵化宝衣。",
        "徒使词臣庾开府，咸阳终日苦思归。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 265314,
      "title": "朗州窦员外见示与澧州元郎中郡斋赠答长句二篇因以继和",
      "content": [
        "鸳鹭差池出建章，彩旗朱户蔚相望。",
        "新恩共理犬牙地，昨日同含鸡舌香。",
        "白芷江边分驿路，山桃蹊外接甘棠。",
        "应怜一罢金闺籍，枉渚逢春十度伤。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 265315,
      "title": "早春对雪奉寄澧州元郎中",
      "content": [
        "新赐鱼书墨未干，贤人暂出远人安。",
        "朝驱旌斾行时令，夜见星辰忆旧官。",
        "梅蘂覆堦铃阁暖，雪峰当户戟枝寒。",
        "宁知楚客思公子，北望长吟澧有兰。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 265316,
      "title": "窦朗州见示与澧州元郎中早秋赠荅命同作",
      "content": [
        "邻境诸侯同舍郎，芷江兰浦恨无梁。",
        "秋风门外旌旗动，晓露庭中橘柚香。",
        "玉簟微凉宜白昼，金笳入暮应清商。",
        "骚人昨夜闻𫛸鴂，不叹流年惜众芳。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 265317,
      "title": "松滋渡望峡中",
      "content": [
        "渡头轻雨洒寒梅，云际溶溶雪水来。",
        "梦渚草长迷楚望，夷陵土黑有秦灰。",
        "巴人泪应猿声落，蜀客船从鸟道回。",
        "十二碧峰何处所，永安宫外是荒台。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 265318,
      "title": "衢州徐员外使君遗以缟纻兼竹书箱因成一篇用答佳贶",
      "content": [
        "烂柯山下旧仙郎，列宿来添婺女光。",
        "远放歌声分白纻，知传家学与青箱。",
        "水朝沧海何时去，兰在幽林亦自芳。",
        "闻说天台有遗爱，人将琪树比甘棠。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 265319,
      "title": "唐秀才赠端州紫石砚以诗答之",
      "content": [
        "端州石砚人间重，赠我因知正草玄。",
        "阙里庙堂空旧物，开方灶下岂天然。",
        "玉蜍吐水霞光静，彩翰摇风绛锦鲜。",
        "此日佣工记名姓，因君数到墨池前。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 265320,
      "title": "览董评事思归之什因以诗赠",
      "content": [
        "几年油幕佐征东，却泛沧浪狎钓童。",
        "欹枕醉眠成戏蝶，抱琴闲望送归鸿。",
        "文儒自袭胶西相，倚伏能齐塞上翁。",
        "更说扁舟动乡思，青菰已熟奈秋风。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
