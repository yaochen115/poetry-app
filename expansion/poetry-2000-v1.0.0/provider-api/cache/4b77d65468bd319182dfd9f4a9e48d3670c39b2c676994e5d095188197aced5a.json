{
  "data": [
    {
      "id": 255077,
      "title": "鼓吹曲辞 朱鹭",
      "content": [
        "翩翩兮朱鹭，来泛春塘栖绿树。",
        "羽毛如翦色如染，远飞欲下双翅敛。",
        "避人引子入深壍，动处水纹开滟滟。",
        "谁知豪家网尔躯，不如饮啄江海隅。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 255140,
      "title": "横吹曲辞 陇头",
      "content": [
        "陇头已断人不行，胡骑夜入凉州城。",
        "汉家处处格鬬死，一朝尽没陇西地。",
        "驱我边人胡中去，散放牛羊食禾黍。",
        "去年中国养子孙，今著毡裘学胡语。",
        "谁能更使李轻车，收取凉州属汉家。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 255179,
      "title": "横吹曲辞 出塞",
      "content": [
        "秋塞雪初下，将军远出师。",
        "分营长记火，放马不收旗。",
        "月冷边帐湿，沙昏夜探迟。",
        "征人皆白首，谁见灭胡时。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 255210,
      "title": "横吹曲辞 望行人",
      "content": [
        "秋风窗下起，旅雁向南飞。",
        "日日出门望，家家行客归。",
        "无因见边使，空待寄寒衣。",
        "独闭青楼暮，烟深鸟雀稀。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 255221,
      "title": "横吹曲辞 关山月",
      "content": [
        "秋月朗朗关山上，山中行人马蹄响。",
        "关山秋来雨雪多，行人见月唱边歌。",
        "海边漠漠天气白，胡儿夜度黄龙碛。",
        "军中探骑暮出城，伏兵暗处低旌戟。",
        "溪水连地霜草平，野𫘞寻水碛中鸣。",
        "陇头风急雁不下，沙场苦战多流星。",
        "可怜万国关山道，年年战骨多秋草。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 255275,
      "title": "相和歌辞 江南曲",
      "content": [
        "江南人家多橘树，吴姬舟上织白纻。",
        "土地卑湿饶虫蛇，连木为牌入江住。",
        "江村亥日长为市，落帆渡桥来浦里。",
        "青莎覆城竹为屋，无井家家饮潮水。",
        "长江午日酤春酒，高高酒旗悬江口。",
        "倡楼两岸悬水栅，夜唱竹枝留北客。",
        "江南风土欢乐多，悠悠处处尽经过。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 255335,
      "title": "相和歌辞 楚妃叹",
      "content": [
        "湘云初起江沈沈，君王遥在云梦林。",
        "江南雨多旌旗暗，台下朝朝春水深。",
        "章华殿前朝万国，君心独自终无极。",
        "楚兵满地能逐禽，谁用一身继筋力。",
        "西江若飜云梦中，麋鹿死尽应还宫。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 255336,
      "title": "相和歌辞 楚妃怨",
      "content": [
        "梧桐叶下黄金井，横架辘轳牵素绠。",
        "美人初起天未明，手拂银缾秋水冷。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 255350,
      "title": "相和歌辞 短歌行",
      "content": [
        "青天荡荡高且虚，上有白日无根株。",
        "流光暂出还入地，催我少年不须臾。",
        "与君相逢不寂寞，衰老不复如今乐。",
        "玉卮盛酒置君前，再拜愿君千万年。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 255384,
      "title": "相和歌辞 猛虎行",
      "content": [
        "南山北山树冥冥，猛虎白日绕林行。",
        "向晚一身当道食，山中麋鹿尽无声。",
        "年年养子在深谷，雌雄上山不相逐。",
        "谷中近窟有山村，长向村家取黄犊。",
        "五陵年少不敢射，空来林下看行迹。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 255450,
      "title": "相和歌辞  董逃行",
      "content": [
        "洛阳城头火曈曈，乱兵烧我天子宫。",
        "宫城南面有深山，尽将老幼藏其间。",
        "重岩为屋橡为食，丁男夜行候消息。",
        "闻道官军犹掠人，旧里如今归未得。",
        "董逃行，汉家几时重太平。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 255500,
      "title": "相和歌辞 白头吟",
      "content": [
        "请君膝上琴，弹我白头吟。",
        "忆昔君前娇笑语，两情宛转如萦素。",
        "宫中为我起高楼，更开华池种芳树。",
        "春天百草秋始衰，弃我不待白头时。",
        "罗襦玉珥色未暗，今朝已道不相宜。",
        "扬州青铜作明镜，暗中持照不见影。",
        "人心回互自无穷，眼前好恶那能定。",
        "君恩已去若再返，菖蒲花生月长满。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 255642,
      "title": "相和歌辞 乌栖曲",
      "content": [
        "西山作宫潮满池，宫乌晓鸣茱萸枝。",
        "吴姬自唱采莲曲，君王昨夜舟中宿。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 255649,
      "title": "相和歌辞 贾客乐",
      "content": [
        "金陵向西贾客多，船中生长乐风波。",
        "欲发移船近江口，船头祭神各浇酒。",
        "停杯共说远行期，入蜀经蛮远别离。",
        "金多众中为上客，夜夜算缗眠独迟。",
        "秋江初月猩猩语，孤帆夜发满湘渚。",
        "水工持檝防暗滩，直过山边及前侣。",
        "年年逐利西复东，姓名不在县籍中。",
        "农夫税多长辛苦，弃业长为贩卖翁。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 255680,
      "title": "相和歌辞 采莲曲",
      "content": [
        "秋江岸边莲子多，采莲女儿凭船歌。",
        "青房圆实齐戢戢，争前竞折荡漾波。",
        "试牵绿茎下寻藕，断处丝多刺伤手。",
        "白练束腰袖半卷，不插玉钗妆梳浅。",
        "船中未满度前洲，借问谁家家住远。",
        "归时共待暮潮上，自弄芙蓉还荡桨。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 255721,
      "title": "舞曲歌辞 白纻歌",
      "content": [
        "皎皎白纻白且鲜，将作春衫称少年。",
        "裁缝长短不能定，自持刀尺向姑前。",
        "复恐兰膏污纤指，常遣傍人收堕珥。",
        "衣裳著时寒食下，还把玉鞭鞭白马。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 255767,
      "title": "琴曲歌辞 别鹤",
      "content": [
        "双鹤出云谿，分飞各自迷。",
        "空巢在松杪，折羽落江泥。",
        "寻水终不饮，逢林亦未栖。",
        "别离应易老，万里两凄凄。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 255813,
      "title": "琴曲歌辞 乌夜啼引",
      "content": [
        "秦乌啼哑哑，夜啼长安吏人家。",
        "吏人得罪囚在狱，倾家卖产将自赎。",
        "少妇起听夜啼乌，知是官家有赦书。",
        "下床心喜不重寐，未明上堂贺舅姑。",
        "少妇语啼乌，汝啼慎勿虚。",
        "借汝庭树作高巢，年年不令伤尔雏。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 255818,
      "title": "琴曲歌辞 宛转行",
      "content": [
        "华屋重翠幄，绮席雕象床。",
        "远漏微更疎，薄衾中夜凉。",
        "炉氲暗裴回，寒灯背斜光。",
        "妍姿结宵态，寝臂幽梦长。",
        "宛转复宛转，忆忆更未央。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 255848,
      "title": "杂曲歌辞 伤歌行",
      "content": [
        "黄门诏下促收捕，京兆君系御史府。",
        "出门无复部曲随，亲戚相逢不容语。",
        "辞成谪尉南海州，受命不得须臾留。",
        "身著青衫骑恶马，东门之东无送者。",
        "邮夫防吏急喧驱，往往惊堕马蹏下。",
        "长安里中荒大宅，朱门已除十二戟。",
        "高堂舞榭锁管弦，美人遥望西南天。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 255862,
      "title": "杂曲歌辞 妾薄命",
      "content": [
        "薄命妇，良家子，无事从军去万里。",
        "汉家天子平四夷，护羌都尉裹尸归。",
        "念君此行为死别，对君裁缝泉下衣。",
        "与君一日为夫妇，千年万岁亦相守。",
        "君爱龙城征战功，妾愿青楼欢乐同。",
        "人生各各有所欲，讵得将心入君腹。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 255884,
      "title": "杂曲歌辞 春日行",
      "content": [
        "春日融融池上暖，竹牙出土兰心短。",
        "草堂晨起酒半醒，家僮报我园花满。",
        "头上皮冠未曾整，直入花间不寻径。",
        "树树殷勤尽遶行，举枝未徧春日暝。",
        "不用积金著青天，不用服药求神仙。",
        "但愿园里花长好，一生饮酒花前老。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 255907,
      "title": "杂曲歌辞 少年行",
      "content": [
        "少年从出猎长杨，禁中新拜羽林郎。",
        "独到辇前射双虎，君王手赐黄金铛。",
        "日日鬬鸡都市里，赢得宝刀重刻字。",
        "百里报讐夜出城，平明还在倡楼醉。",
        "遥闻虏到平陵下，不待诏书行上马。",
        "斩得名王献桂宫，封侯起第一日中。",
        "不为六郡良家子，百战始取边城功。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 255979,
      "title": "杂曲歌辞 车遥遥",
      "content": [
        "征人遥遥出古城，双轮齐动驷马鸣。",
        "山川无处无归路，念君长作万里行。",
        "野田人稀秋草绿，日暮放马车中宿。",
        "惊麏游兔在我傍，独唱乡歌对僮仆。",
        "君家大宅凤城隅，年年道上随行车。",
        "愿为玉銮系华轼，终日有声在君侧。",
        "门前旧辙久已平，无由复得君消息。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 256015,
      "title": "杂曲歌辞 行路难",
      "content": [
        "湘东行人长叹息，十年离家归未得。",
        "弊裘羸马苦难行，童仆饥寒少筋力。",
        "君不见床头黄金尽，壮士无颜色。",
        "龙蟠泥中未有云，不能生彼升天翼。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 256060,
      "title": "杂曲歌辞 远别离",
      "content": [
        "莲叶团团杏花拆，长江鲤鱼鳍鬣赤。",
        "念君少年弃亲戚，千里万里独为客。",
        "谁言远别心不易，天星坠地能为石。",
        "几时断得城南陌，勿使居人有行役。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 256068,
      "title": "杂曲歌辞 别离曲",
      "content": [
        "行人结束出门去，马蹏几时踏门路。",
        "忆昔君初纳彩时，不言身属辽阳戍。",
        "早知今日当别离，成君家计良为谁。",
        "男儿生身自有役，那得悮我少年时。",
        "不如逐君征战死，谁能独老空闺里。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 256111,
      "title": "杂曲歌辞 筑城曲",
      "content": [
        "筑城去，千人万人齐抱杵。",
        "重重土坚试行锥，军吏执鞭催作迟。",
        "来时一年深碛里，著尽短衣渴无水。",
        "力尽不得抛杵声，杵声未定人皆死。",
        "家家养男当门户，今日作君城下土。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 256130,
      "title": "杂曲歌辞 秋夜长",
      "content": [
        "秋天如水夜未央，天汉东西月色光。",
        "愁人不寐畏枕席，暗虫唧唧遶我傍。",
        "荒城为村无更声，起看北斗天未明。",
        "白露满田风褭褭，千声万声鹖鸟鸣。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 256141,
      "title": "杂曲歌辞 春江曲",
      "content": [
        "春江无云潮水平，蒲心出水凫雏鸣。",
        "长干夫壻爱远行，自染春衣缝已成。",
        "妾身生长金陵侧，去年随夫住江北。",
        "春来未到父母家，舟小风多渡不得。",
        "欲辞舅姑先问人，私向江头祭水神。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 256215,
      "title": "杂曲歌辞 凉州词 一",
      "content": [
        "边城暮雨鴈飞低，芦笋初生渐欲齐。",
        "无数铃声遥过碛，应驮白练到安西。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 256216,
      "title": "杂曲歌辞 凉州词 二",
      "content": [
        "古镇城门白碛开，胡兵往往傍沙堆。",
        "巡边使客行应早，每待平安火到来。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 256217,
      "title": "杂曲歌辞 凉州词 三",
      "content": [
        "凤林关里水东流，白草黄榆六十秋。",
        "边将皆承主恩泽，无人解道取凉州。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 266567,
      "title": "杂歌谣辞 吴楚歌",
      "content": [
        "庭前春鸟啄林声，红夹罗襦缝未成。",
        "今朝社日停针线，起向朱樱树下行。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 266602,
      "title": "杂歌谣辞 白鼍鸣",
      "content": [
        "天欲雨，有东风，南谿白鼍鸣窟中。",
        "六月人家井无水，夜闻白鼍人尽起。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267477,
      "title": "寄远曲",
      "content": [
        "美人来去春江暖，江头无人湘水满。",
        "浣沙石上水禽栖，江南路长春日短。",
        "兰舟桂楫常渡江，无因重寄双琼珰。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267478,
      "title": "行路难",
      "content": [
        "湘东行人长叹息，十年离家归未得。",
        "弊裘羸马苦难行，僮仆饥寒少筋力。",
        "君不见床头黄金尽，壮士无颜色。",
        "龙蟠泥中未有云，不能生彼升天翼。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 267479,
      "title": "征妇怨",
      "content": [
        "九月匈奴杀边将，汉军全没辽水上。",
        "万里无人收白骨，家家城下招魂葬。",
        "妇人依倚子与夫，同居贫贱心亦舒。",
        "夫死战场子在腹，妾身虽存如昼烛。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 267480,
      "title": "白纻歌",
      "content": [
        "皎皎白纻白且鲜，将作春衣称少年。",
        "裁缝长短不能定，自持刀尺向姑前。",
        "复恐兰膏污纤指，常遣傍人收堕珥。",
        "衣裳著时寒食下，还把玉鞭鞭白马。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 267481,
      "title": "野老歌",
      "content": [
        "老农家贫在山住，耕种山田三四亩。",
        "苗疎税多不得食，输入官仓化为土。",
        "岁暮锄犂傍空室，呼儿登山收橡实。",
        "西江贾客珠百斛，船中养犬长食肉。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 267482,
      "title": "寄衣曲",
      "content": [
        "织素缝衣独苦辛，远因回使寄征人。",
        "官家亦自寄衣去，贵从妾手著君身。",
        "高堂姑老无侍子，不得自到边城里。",
        "殷勤为看初著时，征夫身上宜不宜。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 267483,
      "title": "送远曲",
      "content": [
        "戏马台南山簇簇，山边饮酒歌别曲。",
        "行人醉后起登车，席上回尊劝僮仆。",
        "青天漫漫覆长路，远游无家安得住。",
        "愿君到处自题名，他日知君从此去。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 267484,
      "title": "筑城词",
      "content": [
        "筑城处，千人万人齐把杵。",
        "重重土坚试行锥，军吏执鞭催作迟。",
        "来时一年深碛里，尽著短衣渴无水。",
        "力尽不得抛杵声，杵声未尽人皆死。",
        "家家养男当门户，今日作君城下土。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267485,
      "title": "猛虎行",
      "content": [
        "南山北山树冥冥，猛虎白日绕林行。",
        "向晚一身当道食，山中麋鹿尽无声。",
        "年年养子在空谷，雌雄上山不相逐。",
        "谷中近窟有山村，长向村家取黄犊。",
        "五陵年少不敢射，空来林下看行迹。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267486,
      "title": "别离曲",
      "content": [
        "行人结束出门去，几时更踏门前路。",
        "忆昔君初纳采时，不言身属辽阳戍。",
        "早知今日当别离，成君家计良为谁。",
        "男儿生身自有役，那得误我少年时。",
        "不如逐君征战死，谁能独老空闺里。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267487,
      "title": "牧童词",
      "content": [
        "远牧牛，遶村四面禾黍稠。",
        "陂中饥乌啄牛背，令我不得戏垅头。",
        "入陂草多牛散行，白犊时向芦中鸣。",
        "隔堤吹叶应同伴，还鼓长鞭三四声。",
        "牛牛食草莫相触，官家截尔头上角。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267488,
      "title": "沙堤行呈裴相公",
      "content": [
        "长安大道沙为堤，早风无尘雨无泥。",
        "宫中玉漏下三刻，朱衣导骑丞相来。",
        "路傍高楼息歌吹，千车不行行者避。",
        "街官闾吏相传呼，当前十里惟空衢。",
        "白麻诏下移相印，新堤未成旧堤尽。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267489,
      "title": "求仙行",
      "content": [
        "汉皇欲作飞仙子，年年采药东海里。",
        "蓬莱无路海无边，方士舟中相枕死。",
        "招摇在天回白日，甘泉玉树无仙实。",
        "九皇真人终不下，空向离宫祠太乙。",
        "丹田有气凝素华，君能保之升绛霞。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267490,
      "title": "古钗叹",
      "content": [
        "古钗堕井无颜色，百尺泥中今复得。",
        "凤凰宛转有古仪，欲为首饰不称时。",
        "女伴传看不知主，罗袖拂拭生光辉。",
        "兰膏已尽股半折，雕文刻样无年月。",
        "虽离井底入匣中，不用还与坠时同。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267491,
      "title": "各东西",
      "content": [
        "游人别，一东复一西。",
        "出门相背两不返，惟信车轮与马蹄。",
        "道路悠悠不知处，山高海阔谁辛苦。",
        "远游不定难寄书，日日空寻别时语。",
        "浮云上天雨堕地，暂时会合终离异。",
        "我今与子非一身，安得死生不相弃。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267492,
      "title": "节妇吟寄东平李司空师道",
      "content": [
        "君知妾有夫，赠妾双明珠。",
        "感君缠绵意，系在红罗襦。",
        "妾家高楼连苑起，良人执戟明光里。",
        "知君用心如日月，事夫誓拟同生死。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267493,
      "title": "䜩客词",
      "content": [
        "上客不用顾金羁，主人有酒君莫违。",
        "请君看取园中花，地上渐多枝上稀。",
        "山头树影不见石，溪水无风应更碧。",
        "人人齐醉起舞时，谁觉翻衣与倒帻。",
        "明朝花尽人已去，此地独来空绕树。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267494,
      "title": "永嘉行",
      "content": [
        "黄头鲜卑入洛阳，胡儿执戟升明堂。",
        "晋家天子作降虏，公卿奔走如牛羊。",
        "紫陌旌幡暗相触，家家鸡犬惊上屋。",
        "妇人出门随乱兵，夫死眼前不敢哭。",
        "九州诸侯自顾土，无人领兵来护主。",
        "北人避胡多在南，南人至今能晋语。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267495,
      "title": "采莲曲",
      "content": [
        "秋江岸边莲子多，采莲女儿凭船歌。",
        "青房圆实齐戢戢，争前竞折漾微波。",
        "试牵绿茎下寻藕，断处丝多刺伤手。",
        "白练束腰袖半卷，不插玉钗妆梳浅。",
        "船中未满度前洲，借问阿谁家住远。",
        "归时共待暮潮上，自弄芙蓉还荡桨。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 267496,
      "title": "伤歌行",
      "content": [
        "黄门诏下促收捕，京兆尹系御史府。",
        "出门无复部曲随，亲戚相逢不容语。",
        "辞成谪尉南海州，受命不得须臾留。",
        "身着青衫骑恶马，中门之外无送者。",
        "邮夫防吏急諠驱，往往惊堕马蹄下。",
        "长安里中荒大宅，朱门已除十二戟。",
        "高堂舞榭锁管弦，美人遥望西南天。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 267497,
      "title": "吴宫怨",
      "content": [
        "吴宫四面秋江水，江清露白芙蓉死。",
        "吴王醉后欲更衣，座上美人娇不起。",
        "宫中千门复万户，君恩反复谁能数。",
        "君心与妾既不同，徒向君前作歌舞。",
        "茱萸满宫红实垂，秋风袅袅生繁枝。",
        "姑苏台上夕燕罢，佗人侍寝还独归。",
        "白日在天光在地，君今那得长相弃。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267498,
      "title": "北邙行",
      "content": [
        "洛阳北门北邙道，丧车辚辚入秋草。",
        "车前齐唱薤露歌，高坟新起白峨峨。",
        "朝朝暮暮人送葬，洛阳城中人更多。",
        "千金立碑高百尺，终作谁家柱下石。",
        "山头松柏半无主，地下白骨多于土。",
        "寒食家家送纸钱，乌鸢作窠衔上树。",
        "人居朝市未解愁，请君暂向北邙游。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267499,
      "title": "关山月",
      "content": [
        "秋月朗朗关山上，山中行人马蹄响。",
        "关山秋来雨雪多，行人见月唱边歌。",
        "海边茫茫天气白，胡儿夜度黄龙碛。",
        "军中探骑暮出城，伏兵暗处低旌戟。",
        "溪水连天霜草平，野驼寻水碛中鸣。",
        "陇头风急雁不下，沙场苦战多流星。",
        "可怜万国关山道，年年战骨多秋草。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 267500,
      "title": "陇头行",
      "content": [
        "陇头路断人不行，胡骑夜入凉州城。",
        "汉兵处处格鬬死，一朝尽没陇西地。",
        "驱我边人胡中去，散放牛羊食禾黍。",
        "去年中国养子孙，今著毡裘学胡语。",
        "谁能更使李轻车，收取凉州入汉家。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267501,
      "title": "楚妃叹",
      "content": [
        "湘云初起江沉沉，君王遥在云梦林。",
        "江南雨多旌旗暗，台下朝朝春水深。",
        "章华殿前朝万国，君心独自无终极。",
        "楚兵满地能逐禽，谁用一身骋筋力。",
        "西江若飜云梦中，麋鹿死尽应还宫。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267502,
      "title": "春日行",
      "content": [
        "春日融融池上暖，竹牙出土兰心短。",
        "草堂晨起酒半醒，家僮报我园花满。",
        "头上皮冠未曾整，直入花间不寻径。",
        "树树殷勤尽遶行，攀枝未徧春日暝。",
        "不用积金著青天，不用服药求神仙。",
        "但愿园里花长好，一生饮酒花前老。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267503,
      "title": "秋夜长",
      "content": [
        "秋天如水夜未央，天汉东西月色光。",
        "愁人不寐畏枕席，暗虫唧唧遶我傍。",
        "荒城为村无更声，起看北斗天未明。",
        "白露满田风袅袅，千声万声鹖鸟鸣。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 267504,
      "title": "白鼍鸣",
      "content": [
        "天欲雨，有东风，南谿白鼍鸣窟中。",
        "六月人家井无水，夜闻鼍声人尽起。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267505,
      "title": "洛阳行",
      "content": [
        "洛阳宫阙当中州，城上峨峨十二楼。",
        "翠华西去几时返，枭巢乳鸟藏蛰燕。",
        "御门空锁五十年，税彼农夫修玉殿。",
        "六街朝暮鼓冬冬，禁兵持戟守空宫。",
        "百官月月拜章表，驿使相续长安道。",
        "上阳宫树黄复绿，野豺入苑食麋鹿。",
        "陌上老翁双泪垂，共说武皇巡幸时。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267506,
      "title": "春江曲",
      "content": [
        "春江无云潮水平，蒲心出水凫雏鸣。",
        "长干夫壻爱远行，自染春衣缝已成。",
        "妾身生长金陵侧，去年随夫住江北。",
        "春来未到父母家，舟小风多渡不得。",
        "欲辞舅姑先问人，私向江头祭水神。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267507,
      "title": "送远曲",
      "content": [
        "吴门向西流水长，水长柳暗烟茫茫。",
        "行人送客各惆怅，话离叙别倾清觞。",
        "吟丝竹，鸣笙簧，酒酣性逸歌猖狂。",
        "行人告我挂帆去，此去何时返故乡。",
        "殷勤振衣两相嘱，世事近来还浅促。",
        "愿君看取吴门山，带雪经春依旧绿。",
        "行人行处求知亲，送君去去徒酸辛。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267508,
      "title": "塞下曲",
      "content": [
        "边州八月修城堡，候骑先烧碛中草。",
        "胡风吹沙度陇飞，陇头林木无北枝。",
        "将军阅兵青塞下，鸣鼓逢逢促猎围。",
        "天寒山路石断裂，白日不销帐上雪。",
        "乌孙国乱多降胡，诏使名王持汉节。",
        "年年征战不得闲，边人杀尽唯空山。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 267509,
      "title": "董逃行",
      "content": [
        "洛阳城头火曈曈，乱兵烧我天子宫。",
        "宫城南面有深山，尽将老幼藏其间。",
        "重岩为屋橡为食，丁男夜行候消息。",
        "闻道官军犹掠人，旧里如今归未得。",
        "董逃行，汉家几时重太平。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267510,
      "title": "少年行",
      "content": [
        "少年从猎出长杨，禁中新拜羽林郎。",
        "独对辇前射双虎，君王手赐黄金珰。",
        "日日鬬鸡都市里，赢得宝刀重刻字。",
        "百里报仇夜出城，平明还在娼楼醉。",
        "遥闻虏到平陵下，不待诏书行上马。",
        "斩得名王献桂宫，封侯起第一日中。",
        "不为六郡良家子，百战始取边城功。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267511,
      "title": "白头吟",
      "content": [
        "请君漆上琴，弹我白头吟。",
        "忆昔君前娇笑语，两情宛转如萦素。",
        "宫中为我起高楼，更开花池种芳树。",
        "春天百草秋始衰，弃我不待白头时。",
        "罗襦玉珥色未暗，今朝已道不相宜。",
        "扬州青铜作明镜，暗中持照不见影。",
        "人心回互自无穷，眼前好恶那能定。",
        "君恩已去若再返，菖蒲花开月长满。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 267512,
      "title": "将军行",
      "content": [
        "弹筝峡东有胡尘，天子择日拜将军。",
        "蓬莱殿前赐六纛，还领禁兵为部曲。",
        "当朝受诏不辞家，夜向咸阳原上宿。",
        "战车彭彭旌旗动，三十六军齐上陇。",
        "陇头战胜夜亦行，分兵处处收旧城。",
        "胡儿杀尽阴碛暮，扰扰唯有牛羊声。",
        "边人亲戚曾战没，今逐官军收旧骨。",
        "碛西行见万里空，幕府独奏将军功。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267513,
      "title": "贾客乐",
      "content": [
        "金陵向西贾客多，船中生长乐风波。",
        "欲发移船近江口，船头祭神各浇酒。",
        "停杯共说远行期，入蜀经蛮谁别离。",
        "金多众中为上客，夜夜算缗眠独迟。",
        "秋江初月猩猩语，孤帆夜发潇湘渚。",
        "水工持檝防暗滩，直过山边及前侣。",
        "年年逐利西复东，姓名不在县籍中。",
        "农夫税多长辛苦，弃业长为贩宝翁。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267514,
      "title": "羁旅行",
      "content": [
        "远客出门行路难，停车敛策在门端。",
        "荒城无人霜满路，野火烧桥不得度。",
        "寒虫入窟鸟归巢，僮仆问我谁家去。",
        "行寻田头暝未息，双毂长辕碍荆棘。",
        "缘冈入涧投田家，主人舂米为夜食。",
        "晨鸡喔喔茅屋傍，行人起扫车上霜。",
        "旧山已别行已远，身计未成难复返。",
        "长安陌上相识稀，遥望天山白日晚。",
        "谁能听我辛苦行，为向君前歌一声。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267515,
      "title": "车遥遥",
      "content": [
        "征人遥遥出古城，双轮齐动驷马鸣。",
        "山川无处不归路，念君长作万里行。",
        "野田人稀秋草绿，日暮放马车中宿。",
        "惊麏游兔在我傍，独唱乡歌对僮仆。",
        "君家大宅凤城隅，年年道上随行车。",
        "愿为玉銮系华轼，终日有声在君侧。",
        "门前旧辙久已平，无由复得君消息。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267516,
      "title": "妾薄命",
      "content": [
        "薄命妇，良家子，无事从军去万里。",
        "汉家天子平四夷，护羌都尉裹尸归。",
        "念君此行为死别，对君裁缝泉下衣。",
        "与君一日为夫妇，千年万岁亦相守。",
        "君爱龙城征战功，妾愿青楼歌乐同。",
        "人生各各有所欲，讵得将心入君腹。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267517,
      "title": "朱鹭",
      "content": [
        "翩翩兮朱鹭，来泛春塘栖绿树。",
        "羽毛如翦色如染，远飞欲下双翅敛。",
        "避人引子入深壍，动处水纹开滟滟。",
        "谁知豪家网尔躯，不如饮啄江海隅。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267518,
      "title": "远别离",
      "content": [
        "莲叶团团杏花拆，长江鲤鱼鬐鬣赤。",
        "念君少年弃亲戚，千里万里独为客。",
        "谁言远别心不易，天星坠地能为石。",
        "几时断得城南陌，勿使居人有行役。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 267519,
      "title": "楚宫行",
      "content": [
        "章华宫中九月时，桂花半落红橘垂。",
        "江头骑火照辇道，君王夜从云梦归。",
        "霓旌凤盖到双阙，台上重重歌吹发。",
        "千门万户开相当，烛笼左右列成行。",
        "下辇更衣入洞房，洞房侍女尽焚香。",
        "玉阶罗幕微有霜，齐言此夕乐未央。",
        "玉酒湛湛盈华觞，丝竹次第鸣中堂。",
        "巴姬起舞向君王，回身垂手结明珰。",
        "愿君千年万年寿，朝出射麋夜饮酒。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267520,
      "title": "江南行",
      "content": [
        "江南人家多橘树，吴姬舟上织白苎。",
        "土地卑湿饶虫蛇，连木为牌入江住。",
        "江村亥日长为市，落帆度桥来蒲里。",
        "清莎覆城竹为屋，无井家家饮潮水。",
        "长干午日沽春酒，高高酒旗悬江口。",
        "娼楼两岸临水栅，夜唱竹枝留北客。",
        "江南风土欢乐多，悠悠处处尽经过。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 267521,
      "title": "乌夜啼引",
      "content": [
        "秦乌啼哑哑，夜啼长安吏人家。",
        "吏人得罪囚在狱，倾家卖产将自赎。",
        "少妇起听夜啼乌，知是官家有赦书。",
        "下床心喜不重寐，未明上堂贺舅姑。",
        "少妇语啼乌，汝啼慎勿虚。",
        "借汝庭树作高巢，年年不令伤尔雏。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267522,
      "title": "促促词",
      "content": [
        "促促复促促，家贫夫妇欢不足。",
        "今年为人送租船，去年捕鱼在江边。",
        "家中姑老子复小，自执吴绡输税钱。",
        "家家桑麻满地黑，念君一身空努力。",
        "愿教牛蹄团团羊角直，君身常在应不得。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267523,
      "title": "宛转行",
      "content": [
        "华屋重翠幄，绮席雕象床。",
        "远漏微更疎，薄衾中夜凉。",
        "炉气暗裴徊，寒灯背斜光。",
        "妍姿结宵态，寝臂幽梦长。",
        "宛转复宛转，忆君更未央。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267524,
      "title": "短歌行",
      "content": [
        "青天荡荡高且虚，上有白日无根株。",
        "流光暂出还入地，使我年少不须臾。",
        "与君相逢勿寂寞，衰老不复如今乐。",
        "玉巵盛酒置君前，再拜愿君千万年。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 267525,
      "title": "山头鹿",
      "content": [
        "山头鹿，角芟芟，尾促促。",
        "贫儿多租输不足，夫死未葬儿在狱。",
        "早日熬熬蒸野冈，禾黍不收无狱粮。",
        "县家唯忧少军食，谁能令尔无死伤。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267526,
      "title": "湘江曲",
      "content": [
        "湘水无潮秋水阔，湘中月落行人发。",
        "送人发，送人归，白苹茫茫鹧鸪飞。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267527,
      "title": "楚妃怨",
      "content": [
        "梧桐叶下黄金井，横架辘轳牵素绠。",
        "美人初起天未明，手拂银缾秋水冷。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 267528,
      "title": "离宫怨",
      "content": [
        "高堂别馆连湘渚，长向春光开万户。",
        "荆王去去不复来，宫中美人自歌舞。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 267529,
      "title": "成都曲",
      "content": [
        "锦江近西烟水绿，新雨山头荔枝熟。",
        "万里桥边多酒家，游人爱向谁家宿。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 267530,
      "title": "寒塘曲",
      "content": [
        "寒塘沉沉柳叶疎，水暗人语惊栖凫。",
        "舟中少年醉不起，持烛照水射游鱼。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 267531,
      "title": "春别曲",
      "content": [
        "长江春水绿堪染，莲叶出水大如钱。",
        "江头橘树君自种，那不长系木兰船。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 267532,
      "title": "春堤曲",
      "content": [
        "野塘䴔䴖飞树头，绿蒲紫菱盖碧流。",
        "狂客谁家爱云水，日日独来城下游。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 267533,
      "title": "乌栖曲",
      "content": [
        "西山作宫潮满池，宫鸟晓鸣茱萸枝。",
        "吴姬采莲自唱曲，君王昨夜舟中宿。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 267534,
      "title": "雀飞多",
      "content": [
        "雀飞多，触网罗，网罗高树颠。",
        "汝飞蓬蒿下，勿复投身网罗间。",
        "粟积仓，禾在田。",
        "巢之雏，望其母来还。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267535,
      "title": "泗水行",
      "content": [
        "泗水流急石纂纂，鲤鱼上下红尾短。",
        "春冰销散日华满，行舟往来浮桥断。",
        "城边鱼市人早行，水烟漠漠多棹声。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267536,
      "title": "废居行",
      "content": [
        "胡马崩腾满阡陌，都人避乱唯空宅。",
        "宅边青桑垂宛宛，野蚕食叶还成茧。",
        "黄雀衔草入燕窠，啧啧啾啾白日晚。",
        "去时禾黍埋地中，饥兵掘土翻重重。",
        "鸱枭养子庭树上，曲墙空屋多旋风。",
        "乱定几人还本土，唯有官家重作主。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267537,
      "title": "寄菖蒲",
      "content": [
        "石上生菖蒲，一寸十二节。",
        "仙人劝我食，令我头青面如雪。",
        "逢人寄君一绛囊，书中不得传此方。",
        "君能来作栖霞侣，与君同入丹玄乡。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267538,
      "title": "江村行",
      "content": [
        "南塘水深芦笋齐，下田种稻不作畦。",
        "耕场磷磷在水底，短衣半染芦中泥。",
        "田头刈莎结为屋，归来系牛还独宿。",
        "水淹手足尽有疮，山蝱遶身飞飏飏。",
        "桑林椹黑蚕再眠，妇姑采桑不向田。",
        "江南热旱天气毒，雨中移秧颜色鲜。",
        "一年耕种长苦辛，田熟家家将赛神。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267539,
      "title": "樵客吟",
      "content": [
        "上山采樵选枯树，深处樵多出辛苦。",
        "秋来野火烧栎林，枝柯已枯堪采取。",
        "斧声坎坎在幽谷，采得齐梢青葛束。",
        "日西待伴同下山，竹担弯弯向身曲。",
        "共知路傍多虎窟，未出深林不敢歇。",
        "村西地暗狐兔行，稚子呌时相应声。",
        "采樵客，莫采松与栢。",
        "松栢生枝直且坚，与君作屋成家宅。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267540,
      "title": "湖南曲",
      "content": [
        "潇湘多别离，风起芙蓉洲。",
        "江上人已远，夕阳满中流。",
        "鸳鸯东南飞，飞上青山头。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267541,
      "title": "春水曲",
      "content": [
        "鸭鸭，觜唼唼。",
        "青蒲生，春水狭。",
        "荡漾木兰船，中有双少年。",
        "少年醉，鸭不起。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    }
  ],
