{
  "data": [
    {
      "id": 276099,
      "title": "怀江南同志",
      "content": [
        "南国别经年，云晴波接天。",
        "蒲深㶉𫛶戏，花暖鹧鸪眠。",
        "竹暗湘妃庙，枫阴楚客船。",
        "唯应洞庭月，万里共婵娟。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 276100,
      "title": "洛中秋日",
      "content": [
        "故国无归处，官闲忆远游。",
        "吴僧秣陵寺，楚客洞庭舟。",
        "久病先知雨，长贫早觉秋。",
        "壮心能几许，伊水更东流。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276101,
      "title": "将赴京师蒜山津送客还荆渚",
      "content": [
        "尊前万里愁，楚塞与皇州。",
        "云识潇湘雨，风知鄠杜秋。",
        "潮平犹倚棹，月上更登楼。",
        "他日沧浪水，渔歌对白头。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276102,
      "title": "潼关兰若",
      "content": [
        "来往几经过，前轩枕大河。",
        "远帆春水阔，高寺夕阳多。",
        "蝶影下红药，鸟声喧绿萝。",
        "故山归未得，徒咏采芝歌。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276103,
      "title": "翫残雪寄江南尹刘大夫",
      "content": [
        "艳阳无处避，皎洁不成容。",
        "素质添瑶水，清光散玉峰。",
        "眠鸥犹恋草，栖鹤未离松。",
        "闻在金銮望，群仙对九重。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 276104,
      "title": "陪越中使院诸公镜波馆饯明台裴郑二使君",
      "content": [
        "倾幕来华馆，淹留二使君。",
        "舞移清夜月，歌断碧空云。",
        "海郡楼台接，江船劒戟分。",
        "明时自骞翥，无复叹离群。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276105,
      "title": "春泊弋阳",
      "content": [
        "江行春欲半，孤枕弋阳堤。",
        "云暗犹飘雪，潮寒未应溪。",
        "饮猿闻棹散，飞鸟背船低。",
        "此路成幽绝，家山巩洛西。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276106,
      "title": "晨别翛然上人",
      "content": [
        "吴僧诵经罢，败衲倚蒲团。",
        "钟韵花犹歛，楼阴月向残。",
        "晴山开殿响，秋水卷帘寒。",
        "独恨孤舟去，千滩复万滩。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276107,
      "title": "送客江行",
      "content": [
        "萧萧芦荻花，郢客独辞家。",
        "远棹依山响，危樯转浦斜。",
        "水寒澄浅石，潮落涨虚沙。",
        "莫与征徒望，乡园去渐赊。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276108,
      "title": "将归涂口宿郁林寺道玄上人院二首 一",
      "content": [
        "西岩一磬长，僧起树苍苍。",
        "开殿洒寒水，诵经焚晚香。",
        "竹风云渐散，杉露月犹光。",
        "无复重来此，归舟凌夕阳。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276109,
      "title": "将归涂口宿郁林寺道玄上人院二首 二",
      "content": [
        "春寻采药翁，归路宿禅宫。",
        "云起客眠处，月残僧定中。",
        "藤花深洞水，槲叶满山风。",
        "清境不能住，朝朝慙远公。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276110,
      "title": "题宣州元处士幽居",
      "content": [
        "潺湲遶门水，未省濯缨尘。",
        "鸟散千岩曙，蜂来一迳春。",
        "杉松还待客，芝术不求人。",
        "宁学磻溪叟，逢时罢隐沦。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276111,
      "title": "送李秀才",
      "content": [
        "南楼送郢客，西郭见荆门。",
        "凫鹄下寒渚，牛羊归远村。",
        "兰舟倚行掉，桂酒掩余尊。",
        "重此一留宿，前村烟水昏。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276112,
      "title": "题倪处士旧居",
      "content": [
        "儒翁九十余，旧向此山居。",
        "生寄一壶酒，死留千卷书。",
        "槛摧新竹少，池浅故莲疎。",
        "但有子孙在，带经还荷锄。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276113,
      "title": "赠梁将军",
      "content": [
        "曾经黑山虏，一劒出重围。",
        "年长穷书意，时清隐钓矶。",
        "高斋云外住，瘦马月中归。",
        "唯说乡心苦，春风鴈北飞。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276114,
      "title": "春望思旧游",
      "content": [
        "适意极春日，南台披薜萝。",
        "花光晴漾漾，山色昼峨峨。",
        "湘水美人远，信陵豪客多。",
        "唯凭一瓢酒，弹瑟纵高歌。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276115,
      "title": "病中二首 一",
      "content": [
        "三年婴酒渴，高卧似袁安。",
        "秋色鬓应改，夜凉心已宽。",
        "风衣藤簟滑，露井竹床寒。",
        "卧忆郊扉月，恩深未挂冠。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276116,
      "title": "病中二首 二",
      "content": [
        "私归人暂适，扶杖遶西林。",
        "风急柳溪响，露寒莎径深。",
        "一身仍白发，万虑只丹心。",
        "此意无言处，高窗托素琴。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276117,
      "title": "姑熟官舍寄汝洛友人",
      "content": [
        "[官]静亦无能，平生少面朋。",
        "务开唯印吏，公退只棋僧。",
        "药鼎初寒火，书龛欲夜灯。",
        "安知北溟水，终日送抟鹏。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276118,
      "title": "恩德寺",
      "content": [
        "楼台横复重，犹有半岩空。",
        "萝洞浅深水，竹廊高下风。",
        "晴山疎雨后，秋树断云中。",
        "未尽平生意，孤帆又向东。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276119,
      "title": "天竺寺题葛洪井",
      "content": [
        "羽客炼丹井，井留人已无。",
        "旧泉青石下，余甃碧山隅。",
        "云朗镜开匣，月寒冰在壶。",
        "仍闻酿仙酒，此水过琼酴。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276120,
      "title": "朗上人院晨坐",
      "content": [
        "簟凉襟袖清，月没尚残星。",
        "山果落秋院，水花开晓庭。",
        "疎藤风袅袅，圆桂露冥冥。",
        "正忆江南寺，岩斋闻诵经。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276122,
      "title": "过故友旧居",
      "content": [
        "往年公子宅，夜宴乐难忘。",
        "高竹动疎翠，早莲飘暗香。",
        "珠盘凝宝瑟，绮席遰华觞。",
        "今日皆何处，闭门春草长。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276123,
      "title": "送客归峡中",
      "content": [
        "津亭多别离，杨柳半无枝。",
        "住接猿啼处，行逢鴈过时。",
        "江风飏帆急，山月下楼迟。",
        "还就西斋宿，烟波劳梦思。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276124,
      "title": "题冲沼上人院",
      "content": [
        "𣃁石种松子，数根侵杳冥。",
        "天寒犹讲律，雨暗尚寻经。",
        "小殿灯千盏，深炉水一瓶。",
        "碧云多别思，休到望溪亭。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276125,
      "title": "和毕员外雪中见寄",
      "content": [
        "仙署淹清景，雪华松桂阴。",
        "夜凌瑶席宴，春寄玉京吟。",
        "烛晃垂罗幙，香寒重绣衾。",
        "相思不相访，烟月剡溪深。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276126,
      "title": "春醉",
      "content": [
        "酒醲花一树，何暇卓文君。",
        "客坐长先饮，公闲半已曛。",
        "水乡春足雨，山郭夜多云。",
        "何似参禅理，荣枯尽不闻。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276127,
      "title": "题岫上人院",
      "content": [
        "病客与僧闲，频来不掩关。",
        "高窗云外树，疎磬雨中山。",
        "离索秋虫响，登临夕鸟还。",
        "心知落帆处，明日淛河湾。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276128,
      "title": "送客南归有怀",
      "content": [
        "绿水暖青苹，湘潭万里春。",
        "瓦尊迎海客，铜鼓赛江神。",
        "避雨松枫岸，看云杨柳津。",
        "长安一杯酒，座上有归人。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276129,
      "title": "李生弃官入道因寄",
      "content": [
        "西岩一径通，知学采芝翁。",
        "寒暑丹心外，光阴白发中。",
        "水深鱼避钓，云迥鹤辞笼。",
        "坐想还家日，人非井邑空。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276130,
      "title": "长兴里夏日南邻避暑",
      "content": [
        "侯门大道傍，蝉噪树苍苍。",
        "开鏁洞门远，下帘宾馆凉。",
        "栏围红药盛，架引绿萝长。",
        "永日一欹枕，故山云水乡。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276131,
      "title": "送韩校书",
      "content": [
        "恨与前欢隔，愁因此会同。",
        "迹高芸阁吏，名散雪楼翁。",
        "城闭三秋雨，帆飞一夜风。",
        "酒醒鲈鲙美，应在竟陵东。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276132,
      "title": "秋晚登城",
      "content": [
        "城高不可下，永日一登临。",
        "曲槛凉飙急，空楼返照深。",
        "苇花迷夕棹，梧叶散秋砧。",
        "谩作归田赋，蹉跎岁欲阴。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276133,
      "title": "江西郑常侍赴镇之日有寄因酬和",
      "content": [
        "来暮亦何愁，金貂在鹢舟。",
        "斾随寒浪动，帆带夕阳收。",
        "布令滕王阁，裁诗郢客楼。",
        "即应归凤沼，中外赞天休。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276134,
      "title": "蒙河南刘大夫见示与吏部张公喜雪酬唱辄敢攀和",
      "content": [
        "风度龙山暗，云凝象阙阴。",
        "瑞花琼树合，仙草玉苗深。",
        "欲醉梁王酒，先调楚客琴。",
        "即应携手去，将此助商霖。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276135,
      "title": "下第送宋秀才游岐下杨秀才还江东",
      "content": [
        "年来不自得，一望几伤心。",
        "风转蕙兰色，月移松桂阴。",
        "马随边草远，帆落海云深。",
        "明旦各分首，更听梁甫吟。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276136,
      "title": "南亭偶题",
      "content": [
        "城下水萦回，潮冲野艇来。",
        "鸟惊山果落，龟泛绿萍开。",
        "白首书千卷，朱颜酒一杯。",
        "南轩自流涕，不是望燕台。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276137,
      "title": "与裴三十秀才自越西归望亭阻冻登虎丘山寺精舍",
      "content": [
        "春草越吴间，心期旦夕还。",
        "酒乡逢客病，诗境遇僧闲。",
        "倚棹冰生浦，登楼雪满山。",
        "东风不可待，归鬓坐斑斑。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276138,
      "title": "太和初靖恭里感事",
      "content": [
        "清湘吊屈原，垂泪撷苹蘩。",
        "谤起乘轩鹤，机沈在槛猨。",
        "乾坤三事贵，华夏一夫冤。",
        "宁有唐虞世，心知不为言。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276139,
      "title": "与侯春时同年南池夜话",
      "content": [
        "芦苇暮修修，溪禽上钓舟。",
        "露凉花歛夕，风静竹含秋。",
        "素志应难契，清言岂易求。",
        "相欢一瓢酒，明日醉西楼。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276140,
      "title": "广陵送剡县薛明府赴任",
      "content": [
        "车马楚城壕，清歌送浊醪。",
        "露花羞别泪，烟草让归袍。",
        "鸟浴春塘暖，猨吟暮岭高。",
        "寻仙在仙骨，不用废牛刀。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276141,
      "title": "游果昼二僧院",
      "content": [
        "何必老林泉，冥心便是禅。",
        "讲时开院去，斋后下帘眠。",
        "镜朗灯分焰，香销印绝烟。",
        "真乘不可到，云尽月明天。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276142,
      "title": "题官舍",
      "content": [
        "燕鴈水乡飞，京华信自稀。",
        "簟瓢贫守道，书劒病忘机。",
        "叠鼓吏初散，繁钟鸟独归。",
        "高梧与疎柳，风雨似郊扉。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276143,
      "title": "酬报先上人登楼见寄",
      "content": [
        "丹叶下西楼，知君万里愁。",
        "钟非黔峡寺，帆是敬亭舟。",
        "山色和云暮，湖光共月秋。",
        "天台多道侣，何惜更南游。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276144,
      "title": "晓过郁林寺戏呈李明府",
      "content": [
        "身闲白日长，何处不寻芳？",
        "山崦登楼寺，谿湾泊晚樯。",
        "洞花蜂聚蜜，岩栢麝留香。",
        "若指求仙路，刘郎学阮郎。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276145,
      "title": "泛舟寻郁林寺道玄上人遇雨而返因寄",
      "content": [
        "禅扉倚石梯，云湿雨凄凄。",
        "草色分松迳，泉声咽稻畦。",
        "棹移滩鸟没，钟断岭猨啼。",
        "入夜花如雪，回舟忆剡溪。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276146,
      "title": "郁林寺",
      "content": [
        "台殿冠嵯峨，春来日日过。",
        "水分诸院少，云近上方多。",
        "众籁凝丝竹，繁英耀绮罗。",
        "酒酣诗自逸，乘月棹寒波。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276147,
      "title": "题崇圣寺",
      "content": [
        "西林本行殿，池榭日坡陁。",
        "雨过水初涨，云开山渐多。",
        "晓街垂御柳，秋院闭宫莎。",
        "借问龙归处，鼎湖空碧波。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276148,
      "title": "赠高处士",
      "content": [
        "宅前云水满，高兴一书生。",
        "垂钓有深意，望山多远情。",
        "夜棋留客宿，春酒劝僧倾。",
        "未作干时计，何人问姓名。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276149,
      "title": "送僧归金山寺",
      "content": [
        "老归江上寺，不忘旧师恩。",
        "驻锡逢山色，停杯见浪痕。",
        "秋涛吞楚驿，晓月上荆门。",
        "为访题诗处，莓苔几字存。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276150,
      "title": "金谷桃花",
      "content": [
        "花在舞楼空，年年依旧红。",
        "泪光停晓露，愁态倚春风。",
        "开处妾先死，落时君亦终。",
        "东流两三片，应在夜泉中。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276151,
      "title": "忆长洲",
      "content": [
        "香径小船通，菱歌遶故宫。",
        "鱼沈秋水静，鸟宿暮山空。",
        "荷叶桥边雨，芦花海上风。",
        "归心无处托，高枕画屏中。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276152,
      "title": "寄殷尧藩",
      "content": [
        "直道知难用，经年向水滨。",
        "宅从栽竹贵，家为买书贫。",
        "就学多新客，登朝尽故人。",
        "蓬莱自有路，莫羡武陵春。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276153,
      "title": "题邹处士隐居",
      "content": [
        "桑柘满江村，西斋接海门。",
        "浪冲高岸响，潮入小池浑。",
        "嵒树阴棋局，山花落酒樽。",
        "相逢亦留宿，还似识王孙。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276154,
      "title": "送僧归敬亭山寺",
      "content": [
        "十年劒中路，传尽本师经。",
        "晓月下黔峡，秋风归敬亭。",
        "开门新树绿，登阁旧山青。",
        "遥想论禅处，松阴水一瓶。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276155,
      "title": "新卜原上居寄袁校书",
      "content": [
        "贫居乐游此，江海思迢迢。",
        "雪夜书千卷，花时酒一瓢。",
        "独愁秦树老，孤梦楚山遥。",
        "有路应相念，风尘满黑貂。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276156,
      "title": "天街晓望",
      "content": [
        "明星低未央，莲阙逈苍苍。",
        "叠鼓催残月，疎钟迎早霜。",
        "关防浮瑞气，宫馆耀神光。",
        "再拜为君寿，南山高且长。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276157,
      "title": "江上喜洛中亲友继至",
      "content": [
        "战马昔纷纷，风惊嵩少尘。",
        "全家南渡远，旧友北来频。",
        "罢酒松筠晚，赋诗杨柳春。",
        "谁言今夜月，同是洛阳人。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276158,
      "title": "下第归朱方寄刘三复",
      "content": [
        "素衣京洛尘，归棹过南津。",
        "故里迹犹在，旧交心更亲。",
        "月高萧寺夜，风暖庾楼春。",
        "诗酒应无暇，朝朝问旅人。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276159,
      "title": "送人归吴兴",
      "content": [
        "绿水棹云月，洞庭归路长。",
        "春桥悬酒幔，夜栅集茶樯。",
        "箬叶沈溪暖，苹花遶郭香。",
        "应逢柳太守，为说过潇湘。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276160,
      "title": "月夜期友人不至",
      "content": [
        "坐待故人宿，月华清兴秋。",
        "管弦谁处醉，池馆此时愁。",
        "风过渚荷动，露含山桂幽。",
        "孤吟不可曙，昨夜共登楼。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276161,
      "title": "白马寺不出院僧",
      "content": [
        "禅空心已寂，世路任多岐。",
        "到院客长见，闭关人不知。",
        "寺喧听讲绝，厨远送斋迟。",
        "墙外洛阳道，东西无尽时。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276162,
      "title": "寄袁校书",
      "content": [
        "扰扰换时节，旧山琪树阴。",
        "犹乖清汉志，空负白云心。",
        "广陌埃尘远，重门管吹深。",
        "劳歌极西望，芸省有知音。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276163,
      "title": "赠柳璟冯陶二校书",
      "content": [
        "霄汉两飞鸣，喧喧动禁城。",
        "桂堂同日盛，芸阁间年荣。",
        "香掩蕙兰气，韵高鸾鹤声。",
        "应怜茂陵客，未有子虚名。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276164,
      "title": "王秀才自越见寻不遇题诗而回因以酬寄",
      "content": [
        "南斋知数宿，半为木兰开。",
        "晴阁留诗遍，春帆载酒回。",
        "烟深杨子宅，云断越王台。",
        "自有孤舟兴，何妨更一来。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276165,
      "title": "秋霁潼关驿亭",
      "content": [
        "霁色明高𪩘，关河独望遥。",
        "残云归太华，疎雨过中条。",
        "鸟散绿萝静，蝉鸣红树凋。",
        "何言此时节，去去任蓬飘。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276166,
      "title": "送客归兰谿",
      "content": [
        "花下送归客，路长应过秋。",
        "暮随江鸟宿，寒共岭猨愁。",
        "众水喧严濑，群峰抱沈楼。",
        "因君几南望，曾向此中游。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276167,
      "title": "贻终南山隐者",
      "content": [
        "中岩多少隐，提榼抱琴游。",
        "潭冷薜萝晚，山香松桂秋。",
        "瓢闲高树挂，杯急曲池流。",
        "独有迷津客，东西南北愁。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276168,
      "title": "送李文明下第鄜州觐兄",
      "content": [
        "征夫天一涯，醉赠别吾诗。",
        "鴈迥参差远，龙多次第迟。",
        "宁歌还夜苦，宋赋更秋悲。",
        "的的遥相待，清风白露时。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276169,
      "title": "送段觉归东阳兼寄窦使君",
      "content": [
        "山水引归路，陆郎从此谙。",
        "秋茶垂露细，寒菊带霜甘。",
        "台倚乌龙岭，楼侵白鴈潭。",
        "沈公如借问，心在浙河南。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276170,
      "title": "韶州送窦司直北归",
      "content": [
        "江曲山如画，贪程亦驻舟。",
        "果随岩狖落，槎带水禽流。",
        "客散他乡夜，人归故国秋。",
        "樽前挂帆去，风雨下西楼。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276171,
      "title": "伤冯秀才",
      "content": [
        "旅葬不可问，茫茫西陇头。",
        "水云青草湿，山月白杨愁。",
        "琴信有时罢，劒伤无处留。",
        "淮南旧烟月，孤棹更逢秋。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276172,
      "title": "送郑寂上人南行",
      "content": [
        "儒家有释子，年少学支公。",
        "心出是非外，迹辞荣辱中。",
        "锡寒秦岭月，杯急楚江风。",
        "离怨故园思，小秋梨叶红。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276173,
      "title": "赠王处士",
      "content": [
        "归卧养天真，鹿裘乌角巾。",
        "茂陵闲久病，彭泽醉长贫。",
        "冠盖西园夜，笙歌北里春。",
        "谁怜清渭曲，又老钓鱼人。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276174,
      "title": "送友人归荆楚",
      "content": [
        "调瑟劝离酒，苦谙荆楚门。",
        "竹斑悲帝女，草绿怨王孙。",
        "潮落九疑迥，雨连三峡昏。",
        "同来不同去，迢遰更伤魂。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 276175,
      "title": "重伤杨攀处士二首 一",
      "content": [
        "绿云多学术，黄髪竟无成。",
        "酒纵山中性，诗留海上名。",
        "读书新树老，垂钓旧矶平。",
        "今日悲前事，西风闻哭声。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276176,
      "title": "重伤杨攀处士二首 二",
      "content": [
        "从官任直道，几处脱长裾。",
        "殁后儿犹小，葬来人渐疎。",
        "新隣占池馆，长史觅图书。",
        "身贱难相报，平生恨有余。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276177,
      "title": "送友人罢举归东海",
      "content": [
        "沧波天堑外，何岛是新罗。",
        "舶主辞番远，碁僧入汉多。",
        "海风吹白鹤，沙日晒红螺。",
        "此去知投笔，须求利劒磨。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 276178,
      "title": "西园",
      "content": [
        "西园春欲尽，芳草径难分。",
        "静语唯幽鸟，闲眠独使君。",
        "密林生雨气，古石带苔文。",
        "虽去清朝远，朝朝见白云。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276179,
      "title": "苦雨",
      "content": [
        "江昏山半晴，南阻绝人行。",
        "葭菼连云色，杉松共雨声。",
        "早秋仍燕舞，深夜更鼍鸣。",
        "为报迷津客，讹言未可轻。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276180,
      "title": "游茅山",
      "content": [
        "步步入山门，仙家鸟径分。",
        "渔樵不到处，麋鹿自成群。",
        "石面迸出水，松头穿破云。",
        "道人星月下，相次礼茅君。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276181,
      "title": "洛阳道中",
      "content": [
        "洛阳多旧迹，一日几堪愁。",
        "风起林花晚，月明陵树秋。",
        "兴亡不可问，自古水东流。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 276182,
      "title": "江上燕别",
      "content": [
        "云物如故乡，山川异岐路。",
        "年来未归客，马上春欲暮。",
        "一樽花下酒，残日水西树。",
        "不待管弦终，摇鞭背花去。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276184,
      "title": "西山草堂",
      "content": [
        "何处少人事，西山旧草堂。",
        "晒书秋日晚，洗药石泉香。",
        "浚岭有朝雨，北窗生夜凉。",
        "从劳问归路，峰叠遶家乡。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276185,
      "title": "赠隐者",
      "content": [
        "回报隐居士，莫愁山兴阑。",
        "求人颜色尽，知道性情宽。",
        "信谱弹琴误，缘崖㔉药难。",
        "东臯亦自给，殊愧远相安。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276186,
      "title": "舟次武陵寄天竺僧无昼",
      "content": [
        "谿长山几重，十里万株松。",
        "秋日下丹槛，暮云归碧峰。",
        "树栖新放鹤，潭隐旧降龙。",
        "还在孤舟宿，卧闻初夜钟。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276187,
      "title": "寄小弟",
      "content": [
        "江城红叶尽，旅思复凄伤。",
        "孤梦家山远，独眠秋夜长。",
        "道存空倚命，身贱未归乡。",
        "南望空垂泪，天边鴈一行。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276188,
      "title": "秋日",
      "content": [
        "有计自安业，秋风罢苦吟。",
        "买山兼种竹，对客更弹琴。",
        "烟起药园晚，杵声松院深。",
        "闲眠得真性，惆怅旧时心。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276189,
      "title": "石池",
      "content": [
        "通竹引泉脉，泓澄潋石盆。",
        "惊鱼翻藻叶，浴鸟上松根。",
        "残月留山影，高风耗水痕。",
        "谁家秋洗药，来往自开门。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276190,
      "title": "留题李侍御书斋",
      "content": [
        "昔话平生志，高斋曾见留。",
        "道孤心易感，恩重力难酬。",
        "独立千峰晓，频来一叶秋。",
        "鸡鸣应有处，不觉泪空流。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276191,
      "title": "行次白沙馆先寄上河南王侍御",
      "content": [
        "夜程何处宿，山叠树层层。",
        "孤馆闭秋雨，空堂停曙灯。",
        "歌慙渔浦客，诗学鴈门僧。",
        "此意无人识，明朝见李膺。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276192,
      "title": "紫藤",
      "content": [
        "绿萝萦数匝，本在草堂间。",
        "秋色寄高树，昼阴笼远山。",
        "移花疎处种，㔉药困时攀。",
        "日暮微风起，难寻旧径还。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276193,
      "title": "暝投灵智寺渡谿不得却取沿江路往",
      "content": [
        "双岩泻一川，回马断桥前。",
        "古庙阴风地，寒钟暮雨天。",
        "沙虚留虎迹，水滑带龙涎。",
        "却下临江路，潮深无渡船。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276194,
      "title": "下第归蒲城墅居",
      "content": [
        "失意归三径，伤春别九门。",
        "薄烟杨柳路，微雨杏花村。",
        "牧竖还呼犊，隣翁亦抱孙。",
        "不知余正苦，迎马问寒温。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276195,
      "title": "重赋鹭鸶",
      "content": [
        "何年去此地，南浦满凫雏。",
        "云汉知心远，林塘觉思孤。",
        "低飞下晚树，独睡映新蒲。",
        "为尔多归兴，前年在五湖。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276196,
      "title": "途中寒食",
      "content": [
        "处处哭声悲，行人马亦迟。",
        "店闲无火日，村暖斫桑时。",
        "泣路同杨子，烧山忆介推。",
        "清明明日是，甘负故园期。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276197,
      "title": "深春",
      "content": [
        "故里千帆外，深春一鴈飞。",
        "干名频恸哭，将老欲何归。",
        "未谷抛还忆，交亲晚更稀。",
        "空持望乡泪，霑洒寄来衣。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276198,
      "title": "岁首怀甘露寺自省上人",
      "content": [
        "心悟觉身劳，云中弃宝刀。",
        "久闲生䏶肉，多寿长眉毫。",
        "客棹春潮急，禅斋暮雪高。",
        "南𤃩一回首，山碧水滔滔。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276199,
      "title": "寻周炼师不遇留赠",
      "content": [
        "闭门池馆静，云访紫芝翁。",
        "零落槿花雨，参差荷叶风。",
        "夜碁全局在，春酒半壶空。",
        "长啸倚西阁，悠悠名利中。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
