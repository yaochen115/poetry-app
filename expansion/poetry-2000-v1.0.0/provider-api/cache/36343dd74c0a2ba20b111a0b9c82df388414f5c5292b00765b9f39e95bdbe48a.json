{
  "data": [
    {
      "id": 308603,
      "title": "山行入泾州",
      "content": [
        "倦此山路长，停骖问宾御。",
        "林峦信回惑，白日落何处。",
        "徙倚望长风，滔滔引归虑。",
        "微雨随云收，蒙蒙傍山去。",
        "西临有边邑，北走尽亭戍。",
        "泾水横白烟，州城隐寒树。",
        "所嗟异风俗，已自少情趣。",
        "岂伊怀土多，触目忻所遇。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 308604,
      "title": "小敷谷龙潭祠作",
      "content": [
        "崖谷歕疾流，地中有雷集。",
        "百泉势相荡，巨石皆却立。",
        "跳波沸峥嵘，深处不可挹。",
        "昏为蛟龙怒，清见云雨入。",
        "灵怪祟偏祠，废兴自兹邑。",
        "沈淫顷多昧，檐宇遂不葺。",
        "吾闻被明典，盛德惟世及。",
        "生人载山川，血食报原隰。",
        "岂伊骇微险，将以循甿揖。",
        "口飞振吕梁，忠信亦我习。",
        "波流浸已广，悔吝在所汲。",
        "谿水有清源，褰裳靡沾湿。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 308605,
      "title": "段宥廰孤桐",
      "content": [
        "凤皇所宿处，月暎孤桐寒。",
        "槁叶零落尽，空柯苍翠残。",
        "虚心谁能见，直影非无端。",
        "响发调尚苦，清商劳一弹。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 308606,
      "title": "琴",
      "content": [
        "孤桐秘虚鸣，朴素传幽真。",
        "髣髴弦指外，遂见初古人。",
        "意远风雪苦，时来江山春。",
        "高宴未终曲，谁能辨经纶。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 308607,
      "title": "初日",
      "content": [
        "初日净金闺，先照床前暖。",
        "斜光入罗幕，稍稍亲丝管。",
        "云发不能梳，杨花更吹满。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 308608,
      "title": "失题",
      "content": [
        "奸雄乃得志，遂使群心摇。",
        "赤风荡中原，烈火无遗巢。",
        "一人计不用，万里空萧条。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 308609,
      "title": "赠宇文中丞",
      "content": [
        "仆本濩落人，辱当州郡使。",
        "量力颇及早，谢归今即已。",
        "萧萧若凌虚，衿带顷消靡。",
        "车服卒然来，涔阳作游子。",
        "郁郁寡开颜，默默独行李。",
        "忽逢平生友，一笑方在此。",
        "秋清宁风日，楚思浩云水。",
        "为语弋林者，冥冥鸿远矣。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 308610,
      "title": "箜篌引",
      "content": [
        "卢谿郡南夜泊舟，夜闻两岸羌戎讴。",
        "其时月黑猿啾啾，微雨霑衣令人愁。",
        "有一迁客登高楼，不言不寐弹箜篌。",
        "弹作蓟门桑叶秋，风沙飒飒青冢头。",
        "将军铁骢汗血流，深入匈奴战未休。",
        "黄旗一点兵马收，乱杀胡人积如丘。",
        "疮病驱来配边州，仍披漠北羔羊裘。",
        "颜色饥枯掩面羞，眼眶泪滴深两眸。",
        "思还本乡食牦牛，欲语不得指咽喉。",
        "或有强壮能吚嚘，意说被他边将雠。",
        "五世属藩汉主留，碧毛毡帐河曲游。",
        "橐𫘞五万部落稠，勅赐飞凤金兜鍪。",
        "为君百战如过筹，静扫阴山无鸟投。",
        "家藏铁券特承优，黄金千斤不称求。",
        "九族分离作楚囚，深谿寂寞弦苦幽。",
        "草木悲感声飕飗，仆本东山为国忧。",
        "明光殿前论九畴，簏读兵书尽冥搜。",
        "为君掌上施权谋，洞晓山川无与俦。",
        "紫宸诏发远怀柔，摇笔飞霜如夺钩。",
        "鬼神不得知其由，怜爱苍生比蚍蜉。",
        "朔河屯兵须渐抽，尽遣降来拜御沟。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 308611,
      "title": "乌栖曲",
      "content": [
        "白马逐朱车，黄昏入狭邪。",
        "柳树乌争宿，争枝未得飞上屋。",
        "东房少妇壻从军，每听乌啼知夜分。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 308612,
      "title": "城傍曲",
      "content": [
        "秋风鸣桑条，草白狐兔骄。",
        "邯郸饮来酒未消，城北原平掣皂雕。",
        "射杀空营两腾虎，廻身却月佩弓弰。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 308613,
      "title": "行路难",
      "content": [
        "双丝作绠系银瓶，百尺寒泉辘轳上。",
        "悬丝一绝不可望，似妾倾心在君掌。",
        "人生意气好迁捐，只重狂花不重贤。",
        "宴罢调筝奏离鹤，廻娇转盼泣君前。",
        "君不见眼前事，岂保须臾心勿异。",
        "西山日下雨足稀，侧有浮云无所寄。",
        "但愿莫忘前者言，剉骨黄尘亦无愧。",
        "行路难，劝君酒，莫辞烦，美酒千钟犹可尽，心中片愧何可论。",
        "一闻汉主思故剑，使妾长嗟万古魂。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 308614,
      "title": "奉赠张荆州",
      "content": [
        "祝融之峰紫云衔，翠如何其雪崭嵓。",
        "邑西有路缘石壁，我欲从之卧穹嵌。",
        "鱼有心兮脱网罟，江无人兮鸣枫杉。",
        "王君飞舄仍未去，苏耽宅中意遥缄。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 308615,
      "title": "驾出长安",
      "content": [
        "圣德超千古，皇风扇九围。",
        "天廻万象出，驾动六龙飞。",
        "淑气来黄道，祥云覆紫微。",
        "太平多扈从，文物有光辉。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 308616,
      "title": "驾幸河东",
      "content": [
        "晋水千庐合，汾桥万国从。",
        "开唐天业盛，入沛圣恩浓。",
        "下辇廻三象，题碑任六龙。",
        "睿明悬日月，千岁此时逢。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 308617,
      "title": "胡笳曲",
      "content": [
        "城南虏已合，一夜几重围。",
        "自有金笳引，能霑出塞衣。",
        "听临关月苦，清入海风微。",
        "三奏高楼晓，胡人掩涕归。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 308618,
      "title": "潞府客亭寄崔凤童",
      "content": [
        "萧条郡城闭，旅馆空寒烟。",
        "秋月对愁客，山钟摇暮天。",
        "新知偶相访，斗酒情依然。",
        "一宿阻长会，清风徒满川。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 308619,
      "title": "和振上人秋夜怀士会",
      "content": [
        "白露伤草木，山风吹夜寒。",
        "遥林梦亲友，高兴发云端。",
        "郭外秋声急，城边月色残。",
        "瑶琴多远思，更为客中弹。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 308620,
      "title": "送李擢游江东",
      "content": [
        "清洛日夜涨，微风引孤舟。",
        "离肠便千里，远梦生江楼。",
        "楚国橙橘暗，吴门烟雨愁。",
        "东南具今古，归望山云秋。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 308621,
      "title": "沙苑南渡头",
      "content": [
        "秋雾连云白，归心浦溆悬。",
        "津人空守缆，村馆复临川。",
        "篷隔苍茫雨，波连演漾田。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 308622,
      "title": "客广陵",
      "content": [
        "楼头广陵近，九月在南徐。",
        "秋色明海县，寒烟生里闾。",
        "夜帆归楚客，昨日度江书。",
        "为问易名叟，垂纶不见鱼。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 308623,
      "title": "静法师东斋",
      "content": [
        "筑室在人境，遂得真隐情。",
        "春尽草木变，雨来池馆清。",
        "琴书全雅道，视听已无生。",
        "闭户脱三界，白云自虚盈。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 308624,
      "title": "素上人影塔",
      "content": [
        "物化同枯木，希夷明月珠。",
        "本来生灭尽，何者是虚无。",
        "一坐看如故，千龄独向隅。",
        "至人非别有，方外不应殊。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 308625,
      "title": "遇薛明府谒聪上人",
      "content": [
        "欣逢柏梁故，共谒聪公禅。",
        "石室无人到，绳床见虎眠。",
        "阴崖常抱雪，枯涧为生泉。",
        "出处虽云异，同欢在法筵。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 308626,
      "title": "谒焦炼师",
      "content": [
        "中峰青苔壁，一点云生时。",
        "岂意石堂里，得逢焦炼师。",
        "炉香净琴案，松影闲瑶墀。",
        "拜受长年药，翩翻西海期。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 308627,
      "title": "宿京江口期刘昚虚不至",
      "content": [
        "霜天起长望，残月生海门。",
        "风静夜潮满，城高寒气昏。",
        "故人何寂寞，久已乖清言。",
        "明发不能寐，徒盈江上尊。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 308628,
      "title": "寒食即事",
      "content": [
        "晋阳寒食地，风俗旧来传。",
        "雨灭龙蛇火，春生鸿雁天。",
        "泣多流水涨，歌发舞云旋。",
        "西见之推庙，空为人所怜。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 308629,
      "title": "九日登高",
      "content": [
        "青山远近带皇州，霁景重阳上北楼。",
        "雨歇亭臯仙菊润，霜飞天苑御梨秋。",
        "茱萸插鬓花宜寿，翡翠横钗舞作愁。",
        "谩说陶潜篱下醉，何曾得见此风流。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 308630,
      "title": "万岁楼",
      "content": [
        "江上巍巍万岁楼，不知经历几千秋。",
        "年年喜见山长在，日日悲看水独流。",
        "猿狖何曾离暮岭，鸬鹚空自泛寒洲。",
        "谁堪登望云烟里，向晚茫茫发旅愁。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 308631,
      "title": "夏月花萼楼酺宴应制",
      "content": [
        "土德三元正，尧心万国同。",
        "汾阴备冬礼，长乐应和风。",
        "赐庆垂天泽，流欢旧渚宫。",
        "楼台生海上，箫鼓出天中。",
        "雾晓筵初接，宵长曲未终。",
        "雨随青幕合，月照舞罗空。",
        "玉陛分朝列，文章发圣聪。",
        "愚臣忝书赋，歌咏颂丝桐。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 308632,
      "title": "送欧阳会稽之任",
      "content": [
        "怀禄贵心赏，东流山水长。",
        "官移会稽郡，地迩上虞乡。",
        "缓带屏纷杂，渔舟临讼堂。",
        "逶迤回谿趣，猿啸飞鸟行。",
        "万室霁朝雨，千峰迎夕阳。",
        "辉辉远洲暎，暧暧澄湖光。",
        "白发有高士，青春期上皇。",
        "应须枉车歇，为我访荷裳。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 308633,
      "title": "同王维集青龙寺昙壁上人兄院五韵",
      "content": [
        "本来清净所，竹树引幽阴。",
        "簷外含山翠，人间出世心。",
        "圆通无有象，圣境不能侵。",
        "真是吾兄法，何妨友弟深。",
        "天香自然会，灵异识钟音。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 308634,
      "title": "东谿翫月",
      "content": [
        "月从断山口，遥吐柴门端。",
        "万木分空霁，流阴中夜攒。",
        "光连虚象白，气与风露寒。",
        "谷静秋泉响，岩深青霭残。",
        "澄清入幽梦，破影抱空峦。",
        "恍惚琴窗里，松谿晓思难。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 308635,
      "title": "朝来曲",
      "content": [
        "月昃鸣珂动，花连绣户春。",
        "盘龙玉台镜，唯待画眉人。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 308636,
      "title": "从军行",
      "content": [
        "大将军出战，白日暗榆关。",
        "三面黄金甲，单于破胆还。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 308637,
      "title": "答武陵田太守",
      "content": [
        "仗劒行千里，微躯感一言。",
        "曾为大梁客，不负信陵恩。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 308638,
      "title": "题灞池二首 一",
      "content": [
        "腰镰欲何之，东园刈秋韭。",
        "世事不复论，悲歌和樵叟。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 308639,
      "title": "题灞池二首 二",
      "content": [
        "开门望长川，薄暮见渔者。",
        "借问白头翁，垂纶几年也。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 308640,
      "title": "题僧房",
      "content": [
        "椶榈花满院，苔藓入闲房。",
        "彼此名言绝，空中闻异香。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 308641,
      "title": "击磬老人",
      "content": [
        "双峰褐衣久，一磬白眉长。",
        "谁识野人意，徒看春草芳。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 308642,
      "title": "送胡大",
      "content": [
        "荆门不堪别，况乃潇湘秋。",
        "何处遥望君，江边明月楼。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 308643,
      "title": "送郭司仓",
      "content": [
        "暎门淮水绿，留骑主人心。",
        "明月随良掾，春潮夜夜深。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 308644,
      "title": "送李十五",
      "content": [
        "怨别秦楚深，江中秋云起。",
        "天长杳无隔，月影在寒水。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 308645,
      "title": "送张四",
      "content": [
        "枫林已愁暮，楚水复堪悲。",
        "别后冷山月，清猿无断时。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 308646,
      "title": "武陵田太守席送司马卢谿",
      "content": [
        "诸侯分楚郡，饮饯五谿春。",
        "山水清晖远，俱怜一逐臣。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 308647,
      "title": "送谭八之桂林",
      "content": [
        "客心仍在楚，江馆复临湘。",
        "别意猿鸟外，天寒桂水长。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 308648,
      "title": "送刘十五之郡",
      "content": [
        "平明江雾寒，客马江上发。",
        "扁舟事洛阳，窅窅含楚月。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 308649,
      "title": "从军行七首 一",
      "content": [
        "烽火城西百尺楼，黄昏独上海风秋。",
        "更吹羌笛关山月，无那金闺万里愁。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 308650,
      "title": "从军行七首 二",
      "content": [
        "琵琶起舞换新声，总是关山旧别情。",
        "撩乱边愁听不尽，高高秋月照长城。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 308651,
      "title": "从军行七首 三",
      "content": [
        "关城榆叶早疎黄，日暮云沙古战场。",
        "表请回军掩尘骨，莫教兵士哭龙荒。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 308652,
      "title": "从军行七首 四",
      "content": [
        "青海长云暗雪山，孤城遥望玉门关。",
        "黄沙百战穿金甲，不破楼兰终不还。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 308653,
      "title": "从军行七首 五",
      "content": [
        "大漠风尘日色昏，红旗半卷出辕门。",
        "前军夜战洮河北，已报生擒吐谷浑。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 308654,
      "title": "从军行七首 六",
      "content": [
        "胡瓶落膊紫薄汗，碎叶城西秋月团。",
        "明敕星驰封宝劒，辞君一夜取楼兰。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 308655,
      "title": "从军行七首 七",
      "content": [
        "玉门山嶂几千重，山北山南总是烽。",
        "人依远戍须看火，马踏深山不见踪。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 308656,
      "title": "出塞二首 一",
      "content": [
        "秦时明月汉时关，万里长征人未还。",
        "但使龙城飞将在，不教胡马度阴山。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 308657,
      "title": "出塞二首 二",
      "content": [
        "骝马新跨白玉鞍，战罢沙场月色寒。",
        "城头铁鼓声犹振，匣里金刀血未干。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 308658,
      "title": "采莲曲二首 一",
      "content": [
        "吴姬越艳楚王妃，争弄莲舟水湿衣。",
        "来时浦口花迎入，采罢江头月送归。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 308659,
      "title": "采莲曲二首 二",
      "content": [
        "荷叶罗裙一色裁，芙蓉向脸两边开。",
        "乱入池中看不见，闻歌始觉有人来。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 308660,
      "title": "殿前曲二首 一",
      "content": [
        "贵人妆梳殿前催，香风吹入殿后来。",
        "仗引笙歌大宛马，白莲花发照池台。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 308661,
      "title": "殿前曲二首 二",
      "content": [
        "胡部笙歌西殿头，梨园弟子和凉州。",
        "新声一段高楼月，圣主千秋乐未休。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 308662,
      "title": "春宫曲",
      "content": [
        "昨夜风开露井桃，未央前殿月轮高。",
        "平阳歌舞新承宠，帘外春寒赐锦袍。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 308663,
      "title": "西宫春怨",
      "content": [
        "西宫夜静百花香，欲卷珠帘春恨长。",
        "斜抱云和深见月，朦胧树色隐昭阳。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 308664,
      "title": "西宫秋怨",
      "content": [
        "芙蓉不及美人妆，水殿风来珠翠香。",
        "谁分含啼掩秋扇，空悬明月待君王。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 308665,
      "title": "长信秋词五首 一",
      "content": [
        "金井梧桐秋叶黄，珠帘不卷夜来霜。",
        "熏笼玉枕无颜色，卧听南宫清漏长。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 308666,
      "title": "长信秋词五首 二",
      "content": [
        "高殿秋砧响夜阑，霜深犹忆御衣寒。",
        "银灯青琐裁缝歇，还向金城明主看。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 308667,
      "title": "长信秋词五首 三",
      "content": [
        "奉帚平明金殿开，且将团扇暂裴回。",
        "玉颜不及寒鸦色，犹带[昭]阳日影来。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 308668,
      "title": "长信秋词五首 四",
      "content": [
        "真成薄命久寻思，梦见君王觉后疑。",
        "火照西宫知夜饮，分明复道奉恩时。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 308669,
      "title": "长信秋词五首 五",
      "content": [
        "长信宫中秋月明，昭阳殿下捣衣声。",
        "白露堂中细草迹，红罗帐里不胜情。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 308670,
      "title": "青楼曲二首 一",
      "content": [
        "白马金鞍从武皇，旌旗十万宿长杨。",
        "楼头小妇鸣筝坐，遥见飞尘入建章。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 308671,
      "title": "青楼曲二首 二",
      "content": [
        "驰道杨花满御沟，红妆缦绾上青楼。",
        "金章紫绶千余骑，夫壻朝回初拜侯。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 308672,
      "title": "青楼怨",
      "content": [
        "香帏风动花入楼，高调鸣筝缓夜愁。",
        "肠断关山不解说，依依残月下帘钩。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 308673,
      "title": "浣纱女",
      "content": [
        "钱塘江边是谁家，江上女儿全胜花。",
        "吴王在时不得出，今日公然来浣纱。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 308674,
      "title": "闺怨",
      "content": [
        "闺中少妇不曾愁，春日凝妆上翠楼。",
        "忽见陌头杨柳色，悔教夫壻觅封侯。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 308675,
      "title": "甘泉歌",
      "content": [
        "乘舆执玉已登坛，细草霑衣春殿寒。",
        "昨夜云生拜初月，万年甘露水晶盘。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 308676,
      "title": "萧驸马宅花烛",
      "content": [
        "青鸾飞入合欢宫，紫凤衔花出禁中。",
        "可怜今夜千门里，银汉星回一道通。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 308677,
      "title": "观猎",
      "content": [
        "角鹰初下秋草稀，铁骢抛鞚去如飞。",
        "少年猎得平原兔，马后横捎意气归。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 308678,
      "title": "寄穆侍御出幽州",
      "content": [
        "一从恩谴度潇湘，塞北江南万里长。",
        "莫道蓟门书信少，鴈飞犹得到衡阳。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 308679,
      "title": "寄陶副使",
      "content": [
        "闻道将军破海门，如何远谪渡湘沅。",
        "春来明主封西岳，自有还君紫绶恩。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 308680,
      "title": "至南陵答皇甫岳",
      "content": [
        "与君同病复漂沦，昨夜宣城别故人。",
        "明主恩深非岁久，长江还共五谿滨。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 308681,
      "title": "西江寄越弟",
      "content": [
        "南浦逢君岭外还，沅谿更远洞庭山。",
        "尧时恩泽如春雨，梦里相逢同入关。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 308682,
      "title": "李四仓曹宅夜饮",
      "content": [
        "霜天留后故情欢，银烛金炉夜不寒。",
        "欲问吴江别来意，青山明月梦中看。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 308683,
      "title": "宴春源",
      "content": [
        "源向春城花几重，江明深翠引诸峰。",
        "与君醉失松溪路，山馆寥寥传暝钟。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 308684,
      "title": "龙标野宴",
      "content": [
        "沅溪夏晚足凉风，春酒相携就竹丛。",
        "莫道弦歌愁远谪，青山明月不曾空。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 308685,
      "title": "听流人水调子",
      "content": [
        "孤舟微月对枫林，分付鸣筝与客心。",
        "岭色千重万重雨，断弦收与泪痕深。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 308686,
      "title": "梁苑",
      "content": [
        "梁园秋竹古时烟，城外风悲欲暮天。",
        "万乘旌旗何处在？",
        "平台宾客有谁怜。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 308687,
      "title": "武陵龙兴观黄道士房问易因题",
      "content": [
        "斋心问易太阳宫，八卦真形一气中。",
        "仙老言余鹤飞去，玉清坛上雨蒙蒙。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 308688,
      "title": "送魏二",
      "content": [
        "醉别江楼橘柚香，江风引雨入舟凉。",
        "忆君遥在潇湘月，愁听清猿梦里长。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 308689,
      "title": "别李浦之京",
      "content": [
        "故园今在灞陵西，江畔逢君醉不迷。",
        "小弟邻庄尚渔猎，一封书寄数行啼。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 308690,
      "title": "送狄宗亨",
      "content": [
        "秋在水清山暮蝉，洛阳树色鸣臯烟。",
        "送君归去愁不尽，又惜空度凉风天。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 308691,
      "title": "送薛大赴安陆",
      "content": [
        "津头云雨暗湘山，迁客离忧楚地颜。",
        "遥送扁舟安陆郡，天边何处穆陵关。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 308692,
      "title": "芙蓉楼送辛渐二首 一",
      "content": [
        "寒雨连天夜入湖，平明送客楚山孤。",
        "洛阳亲友如相问，一片冰心在玉壶。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 308693,
      "title": "芙蓉楼送辛渐二首 二",
      "content": [
        "丹阳城南秋海阴，丹阳城北楚云深。",
        "高楼送客不能醉，寂寂寒江明月心。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 308694,
      "title": "重别李评事",
      "content": [
        "莫道秋江离别难，舟船明日是长安。",
        "吴姬缓舞留君醉，随意青枫白露寒。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 308695,
      "title": "别陶副使归南海",
      "content": [
        "南越归人梦海楼，广陵新月海亭秋。",
        "宝刀留赠长相忆，当取戈船万户侯。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 308696,
      "title": "送人归江夏",
      "content": [
        "寒江绿水楚云深，莫道离忧迁远心。",
        "晓夕双帆归鄂渚，愁将孤月梦中寻。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 308697,
      "title": "送李五",
      "content": [
        "玉盌金罍倾送君，江西日入起黄云。",
        "扁舟乘月暂来去，谁道沧浪吴楚分。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 308698,
      "title": "送十五舅",
      "content": [
        "深林秋水近日空，归棹演漾清阴中。",
        "夕浦离觞意何已，草根寒露悲鸣虫。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 308699,
      "title": "留别郭八",
      "content": [
        "长亭驻马未能前，井邑苍茫含暮烟。",
        "醉别何须更惆怅，回头不语但垂鞭。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 308700,
      "title": "送窦七",
      "content": [
        "清江月色傍林秋，波上荧荧望一舟。",
        "鄂渚轻帆须早发，江边明月为君留。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 308701,
      "title": "巴陵送李十二",
      "content": [
        "摇曳巴陵洲渚分，清江传语便风闻。",
        "山长不见秋城色，日暮蒹葭空水云。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 308702,
      "title": "送裴图南",
      "content": [
        "黄河渡头归问津，离家几日茱萸新。",
        "漫道闺中飞破镜，犹看陌上别行人。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    }
  ],
