{
  "data": [
    {
      "id": 281100,
      "title": "即席送许□之曹南省兄",
      "content": [
        "梅烂荷圆六月天，归帆高背虎丘烟。",
        "到时自见成行雁，别处休听满树蝉。",
        "卖劒为赊吴市酒，携家犹借洞庭船。",
        "待看春榜来江外，名占蓬莱第几仙。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 281101,
      "title": "送罗著作两浙按狱",
      "content": [
        "使印星车适旧游，陶潜今日在瀛洲。",
        "科条尽晓三千罪，囹圄应空十二州。",
        "旧绶有香笼驿马，皇华无暇狎沙鸥。",
        "归来重过姑苏郡，莫忘题名在虎丘。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 281102,
      "title": "下第后屏居书怀寄张侍御",
      "content": [
        "刖足岂一生，良工隔千里。",
        "故山彭泽上，归梦向汾水。",
        "低催神气尽，僮仆心亦耻。",
        "未达谁不知，达者多忘此。",
        "行年忽已壮，去老年更几。",
        "功名如不彰，身殁岂为鬼。",
        "才看芳草歇，即叹凉风起。",
        "骢马未来朝，嘶声尚在耳。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 281103,
      "title": "荅韩中丞容不饮酒",
      "content": [
        "老大成名仍足病，强听丝竹亦无欢。",
        "高情太守容闲坐，借与青山尽日看。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 281104,
      "title": "句",
      "content": [
        "只将五字句，用破一生心。",
        "楚里八千里，槃槃此都会。",
        "巍峩数里城，远水相映带。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298099,
      "title": "南游湘汉寄友人",
      "content": [
        "南去远三京，三湘五月行。",
        "巴江雪水下，楚泽火云生。",
        "向野聊中饮，乘凉探暮程。",
        "离怀不可说，已近峡猨声。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 298100,
      "title": "送刘山人归洞庭",
      "content": [
        "却共孤云去，高眠最上峰。",
        "半湖乘早月，中路入疏钟。",
        "秋尽虫声急，夜深山雨重。",
        "当时同隐者，分得几株松。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 301676,
      "title": "望南郡城（《全唐诗》引《方舆胜览》缺题）",
      "content": [
        "楚地八千里，槃槃此都会。",
        "巍峨数里城，远水霜映带。",
        "（《舆地纪胜》六五《江陵府》）。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 301677,
      "title": "寄旧友西干耕隐童先辈",
      "content": [
        "种竹参差长，栽松次第成。",
        "戎衣遍江汉，未厌子真耕。",
        "（《四部业刊三编》影明抄本《梨岳诗集·辑补》（原注：「右见徐璈刊本。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 304296,
      "title": "宝贤堂",
      "content": [
        "游访曾经驻马看，窦犨遗像在林峦。",
        "泉分石洞千条碧，人在冰壶六月寒。",
        "时雨欲来腾雾霭，微风初动漾波澜。",
        "个中若置羊裘叟，绝胜当年七里滩。",
        "（《古今图书集成·职方典》卷三○五《太原府部》）。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 304297,
      "title": "苏州寒食日送人归觐",
      "content": [
        "江声寒食下，花木惨离魂。",
        "几宿投山寺，孤帆过海门。",
        "篷声泼火雨，柳色禁烟村。",
        "定看堂高后，斑衣灭泪痕。",
        "（见《择是居丛书》影宋绍定二年刊本宋范成大《吴郡志》卷四九）（按：《全唐诗》卷五八九录此诗，有缺字，今重录。",
        "另同卷《即席送许□之曹南省兄》，据《吴郡志》同卷，所缺一字为「制」字，诗不重录。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 304298,
      "title": "句",
      "content": [
        "恩深转无语，怀抱自分明。",
        "（见《吟窗杂录》卷十三王梦简《进士王氏诗要格律》）（按：原署「李颖」，收二联，另一联「天下已归汉，山中犹避秦」，为李频《四皓庙》句，知此二句亦为李频诗。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 362363,
      "title": "湘口送友人",
      "content": [
        "中流欲暮见湘烟，苇岸无穷接楚田。",
        "去雁远冲云梦雪，",
        "零落梅花过残腊，故园归醉及新年。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 362364,
      "title": "鄂州头陀寺上方",
      "content": [
        "高寺上方无不见，天涯行客思迢迢。",
        "西江帆挂东风急，",
        "感时叹物寻僧话，惟向禅心得寂寥。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 362365,
      "title": "寄远",
      "content": [
        "槐欲成阴分袂时，君期十日复金扉。",
        "槐今落叶已将尽，",
        "须知此意同生死，不学他人空寄衣。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 362366,
      "title": "题张司马别墅",
      "content": [
        "庭前树尽手中栽，先后花分几番开。",
        "巢鸟恋雏惊不起，",
        "门外寻常行乐处，重重履迹在莓苔。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 362367,
      "title": "长安即事",
      "content": [
        "长遇豪家不敢过，此身谁与取高科。",
        "故园久绝书来后，",
        "愁人白发自生早，我独少年能几何。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 362368,
      "title": "汉上逢同年崔八",
      "content": [
        "去岁曾游帝里春，杏花开过各离秦。",
        "偶先托质逢知己，",
        "一回相见一回别，能得几时年少身。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 362369,
      "title": "五月一日蒙替本官不得随例入阙，感怀献送相公",
      "content": [
        "五月倾朝谒紫宸，一朝无分在清尘。",
        "含香已去星郎位，",
        "知将何事酬公道，只养生灵似养身。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 362370,
      "title": "春闺怨",
      "content": [
        "红妆女儿灯下羞，画眉夫婿陇西头。",
        "自怨愁容长照镜，悔教征戍觅封侯。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 362371,
      "title": "送边将",
      "content": [
        "防秋戎马恐来奔，诏发将军出雁门。",
        "遥领短兵登陇首，",
        "若纵干戈更深入，应闻收得到昆仑。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 362372,
      "title": "太和公主还宫",
      "content": [
        "天骄发使犯边尘，汉将推功遂夺亲。",
        "离乱应无初去貌，",
        "重上凤楼追故事，几多愁思向青春。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 362373,
      "title": "将赴黔州先寄本府中丞",
      "content": [
        "八月瞿塘到底翻，孤舟上得已销魂。",
        "幕中职罢犹趋府，",
        "感知肺腑终难说，从此辞归便扫门。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 362374,
      "title": "和友人下第北游感怀",
      "content": [
        "圣代为儒可致身，谁知又别五陵春。",
        "青门独出空归鸟，",
        "且须共漉边城酒，何必陶家有白纶。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 362375,
      "title": "乐游原春望",
      "content": [
        "五陵佳气晚氛氲，霸业雄图势自分。",
        "秦地山河连楚塞，",
        "无那杨华起愁思，满天飘落雪纷纷。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 362376,
      "title": "黄雀行",
      "content": [
        "欲窃高仓集御河，翩翩疑渡畏秋波。",
        "朱宫晚树侵莺语，",
        "谁令不解高飞去，破宅荒庭有网罗。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 362377,
      "title": "长安寓居寄柏侍郎",
      "content": [
        "霜轻两鬓欲相侵，愁绪无端不可寻。",
        "秦女红妆空觅伴，",
        "独向灞陵东北望，一封书寄万重心。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 362378,
      "title": "春日思归",
      "content": [
        "春情不断若连环，一夕思归鬓欲斑。",
        "壮志未酬三尺剑，",
        "却羡浮云与飞鸟，因风吹去又吹还。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 362379,
      "title": "朔中即事",
      "content": [
        "关门南北杂戎夷，草木秋来即出师。",
        "落日风沙长暝早，",
        "自古边功何不立，汉家中外自相疑。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 362380,
      "title": "感怀献门下相公",
      "content": [
        "谁云郎选不由诗，上相怜才积有时。",
        "却是龙钟到门晚，",
        "日望南宫看列宿，迢迢婺女与乡比。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 362381,
      "title": "赠长城庾将军",
      "content": [
        "初年三十拜将军，近代英雄独未闻。",
        "向国报恩心比石，",
        "定拥节麾从此去，安西大破犬戎群。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 362382,
      "title": "浙东献郑大夫",
      "content": [
        "圣主东忧涨海滨，思移副相倚陶钧。",
        "楼台独坐江山月，",
        "几时入去调元化，天下同为尧舜人。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 362383,
      "title": "镜湖夜泊有怀",
      "content": [
        "广水遥堤利物功，因思太守惠无穷。",
        "自从版筑兴农隙，",
        "想当战国开时有，范蠡扁舟祗此中。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 362384,
      "title": "宣州献从叔大夫",
      "content": [
        "清时选地任贤明，从此观风辍尹京。",
        "日月天中辞洛邑，",
        "闻说圣朝同汉代，已愁征入拜公卿。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 362385,
      "title": "贺同年翰林从叔舍人知制诰",
      "content": [
        "仙禁何人蹑近踪，孔门先选得真龙。",
        "别居云路抛三省，",
        "芳年贵盛谁为比，郁郁青青岳顶松。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 362388,
      "title": "奉和郑熏相公",
      "content": [
        "三四株松匝草亭，便成彭泽柳为名。",
        "莲峰隐去难辞阙，浐水朝回与出城。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 362389,
      "title": "及第后还家过岘岭",
      "content": [
        "魏驮山前一朵花，岭西更有几千家。",
        "石斑鱼鲊香冲鼻，浅水沙田饭绕牙。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 362395,
      "title": "客洛酬刘驾",
      "content": [
        "浮世总应相送老，共君偏更远行多。",
        "此回不似前回别，听尽离歌逐棹歌。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 362399,
      "title": "游蜀回简友人",
      "content": [
        "别来十二月，去到漏天边。",
        "不是因逢闰，还应是来年。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 362400,
      "title": "赠泾州王侍御",
      "content": [
        "一旦天书下紫微，三年旌旆陇云飞。",
        "塞门无事春空到，边草青青战马肥。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 362408,
      "title": "夏日题盩厔友人书斋",
      "content": [
        "修竹齐高树，书斋竹树中。",
        "四时无夏气，三伏有秋风。",
        "黑处巢幽鸟，阴来叫候虫。",
        "窗西太白雪，万仞在遥空。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 362409,
      "title": "寻山",
      "content": [
        "一径入双崖，初疑有几家。",
        "行穷人不见，坐久日空斜。",
        "石上生灵草，泉中落异花。",
        "终须结茅屋，向此学餐霞。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 362413,
      "title": "赋得长城斑竹杖",
      "content": [
        "秦兴版筑时，翦伐不知谁。",
        "异代余根在，幽人得手持。",
        "细看生古意，闲倚动边思。",
        "莫作鸠形并，空将鹤发期。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 362420,
      "title": "蜀中逢友人",
      "content": [
        "自古有行役，谁人免别家。",
        "相欢犹陌上，一醉任天涯。",
        "积叠山藏蜀，潺湲水绕巴。",
        "他年复何处，共说海棠花。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 362422,
      "title": "南游过湘汉即事寄友人",
      "content": [
        "南去远驱逐，三湘五月行。",
        "巴山雪水下，楚泽火云生。",
        "向野聊中饭，乘凉探暮程。",
        "离怀不可说，已迫峡猿声。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 362428,
      "title": "秋夜对月寄凤翔范书记",
      "content": [
        "月过秋霖后，光应夜夜清。",
        "一回相忆起，几度独吟行。",
        "河汉东西直，山川远近明。",
        "寸心遥往处，新有雁来声。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 362430,
      "title": "八月十五夜对月",
      "content": [
        "阴盛此宵中，多为雨与风。",
        "坐无云雨至，看与雪霜同。",
        "抱湿离遥海，倾寒向迥空。",
        "年年不可值，还似命难通。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 362433,
      "title": "送友人往太原",
      "content": [
        "离亭聊把酒，此路彻边头。",
        "草白雁来尽，时清人去游。",
        "汾河流晋地，塞雪满并州。",
        "别后相思夜，空看北斗愁。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 362448,
      "title": "春日鄜州赠裴居言",
      "content": [
        "虽将身佐幕，出入似闲居。",
        "草色长相待，山情信不疏。",
        "灯前春睡足，酒后夜寒余。",
        "笔砚时时近，终非署簿书。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 362450,
      "title": "送许棠归泾县作尉",
      "content": [
        "青桂复青袍，一归荣一高。",
        "县人齐下拜，邑宰共分曹。",
        "绕郭看秧插，寻街听茧缫。",
        "封侯万里者，燕颔乃徒劳。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 362451,
      "title": "友人话别",
      "content": [
        "论交虽不早，话别且相亲。",
        "除却栖禅客，谁非南陌人。",
        "半生都返性，终老拟安贫。",
        "愿入白云社，高眠自致身。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 362453,
      "title": "寄范郎中",
      "content": [
        "藜杖山中出，吟诗对范家。",
        "相知从海峤，寄食向京华。",
        "名宦成何报，清眸未纵赊。",
        "临邛梦来往，雨雪满褒斜。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 362454,
      "title": "书怀",
      "content": [
        "宦途从不问，身事觉无差。",
        "华发初生女，沧洲未有家。",
        "却闲思洞穴，终老旷桑麻。",
        "别访栖禅侣，相期语劫沙。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 362465,
      "title": "送徐处士归江南",
      "content": [
        "行行野雪薄，寒气日通春。",
        "故国又芳草，沧江终白身。",
        "游归花落满，睡起鸟啼新。",
        "莫惜闲书劄，西来问旅人。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 362469,
      "title": "送刘山人归洞庭",
      "content": [
        "君逐云山去，人间又绝踪。",
        "半湖乘早月，中路入疏钟。",
        "秋尽草虫急，夜深山雨重。",
        "平生心未已，岂得更相从。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 362470,
      "title": "古意",
      "content": [
        "白马游何处，青楼日正长。",
        "凤箫抛旧曲，鸾镜懒新妆。",
        "玄鸟深巢静，飞花入户香。",
        "虽非窦滔妇，锦字已成章。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 362478,
      "title": "富春赠孙璐",
      "content": [
        "天柱与天目，曾栖绝顶房。",
        "青云求禄晚，白日坐家长。",
        "井气通潮信，窗风引海凉。",
        "平生诗称在，老达亦何妨。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 362479,
      "title": "送友人游蜀",
      "content": [
        "东堂虽不捷，西去复何愁。",
        "蜀马知归路，巴山似旧游。",
        "星临剑阁动，花落锦江流。",
        "鼓吹青林下，时闻祭武侯。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 362482,
      "title": "峡州送清澈上人归浙西",
      "content": [
        "风涛几千里，归路半乘舟。",
        "此地难相遇，何人更共游。",
        "坐经嵩顶夏，行值洛阳秋。",
        "到寺安禅夕，江云满石楼。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 362495,
      "title": "夏日过友人檀溪别业",
      "content": [
        "暑天宜野宅，林籁爽泠泠。",
        "沙月邀开户，岩风助扫庭。",
        "鹭栖依绿筱，鱼跃出清萍。",
        "客抱方如醉，因来得暂醒。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 362496,
      "title": "自江上入关",
      "content": [
        "尽室寄沧洲，孤帆独溯流。",
        "天涯心似梦，江上雨兼秋。",
        "文字为人弃，田园被债收。",
        "此名如不得，何处拟将休。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 362497,
      "title": "冬夜和范秘书宿秘省中作",
      "content": [
        "每日得闲吟，清曹阙下深。",
        "因知遥夜坐，别有远山心。",
        "芸细书中气，松疏雪后阴。",
        "归时高兴足，还复插朝簪。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 362498,
      "title": "送友人游太原",
      "content": [
        "孤帆几日悬，楚客思飘然。",
        "水宿南湖夜，山离旧国年。",
        "秋风高送雁，寒雨入停蝉。",
        "此去勤书劄，时常中路传。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 362499,
      "title": "江上居寄山中客",
      "content": [
        "山后与山前，相思隔叫猿。",
        "残云收树末，返照落江源。",
        "苦雨秋涛涨，狂风野火翻。",
        "朝来卖药客，遇我达无言。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 362502,
      "title": "送崔侍御书记赴山北座主尚书招辟",
      "content": [
        "书记向丘门，旌幢夹谷尊。",
        "从来游幕意，此去并酬恩。",
        "雁叫嫌冰合，骢嘶喜雪繁。",
        "同为入室士，不觉别销魂。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 362503,
      "title": "入朝遇雪",
      "content": [
        "霜鬓持霜简，朝天向雪天。",
        "玉阶初辨色，琼树乍相鲜。",
        "密翳空难曙，盈征瑞不愆。",
        "谁为洛阳客，是日更高眠。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 362514,
      "title": "宛陵东峰亭与友人话别",
      "content": [
        "坐举天涯目，停杯语日晡。",
        "修篁齐迥槛，列岫限平芜。",
        "乱水通三楚，归帆挂五湖。",
        "不知从此去，何处是前途。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 362515,
      "title": "华山寻隐者",
      "content": [
        "自入华山居，关东相见疏。",
        "瓢中谁寄酒，叶上我留书。",
        "巢鸟寒栖尽，潭泉暮冻余。",
        "长闻得药力，此说又何如。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 362516,
      "title": "题荐福寺僧栖白上人院",
      "content": [
        "空门有才子，得道亦吟诗。",
        "内殿频征入，孤峰久作期。",
        "高名何代比，密行几生持。",
        "长爱乔松院，清凉坐夏时。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 362517,
      "title": "游四明山刘樊二真人祠，题山下孙氏居",
      "content": [
        "久在仙坛下，全家是地仙。",
        "池塘来乳洞，禾黍接芝田。",
        "起看青山足，还倾白酒眠。",
        "不知尘世事，双鬓逐流年。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 362522,
      "title": "送凤翔范书记",
      "content": [
        "西京无暑气，夏景似清秋。",
        "天府来相辟，高人去自由。",
        "江山通蜀国，日月近神州。",
        "若共将军语，河兰地未收。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 362524,
      "title": "送友人陆肱往太原",
      "content": [
        "并州非故国，君去复寻谁。",
        "猃狁方为寇，嫖姚正用师。",
        "戍烟来自号，边雪下无时。",
        "更想经绵上，应逢禁火期。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 362525,
      "title": "赠李将军",
      "content": [
        "吾宗偏好武，汉代将家流。",
        "走马辞中禁，屯军向渭州。",
        "天心待破虏，阵面许封侯。",
        "却得河源水，方应洗国仇。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 362530,
      "title": "陕府上姚中丞",
      "content": [
        "关东领藩镇，阙下授旌旄。",
        "觅句秋吟苦，酬恩夜坐劳。",
        "天开吹角出，木落上楼高。",
        "闲话钱塘郡，半年听海潮。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 362532,
      "title": "之任建安渌溪亭偶作二首",
      "content": [
        "入境当春务，农蚕事正殷。",
        "逢溪难饮马，度岭更劳人。",
        "想取烝黎泰，无过赋敛均。",
        "不知成政后，谁是得为邻。",
        "维舟绿溪岸，绕郡白云峰。",
        "将幕连山起，人家向水重。",
        "短才无独见，长策未相逢。",
        "所幸分尧理，烝民悉可封。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 362533,
      "title": "送侯郎中任新定二首",
      "content": [
        "为郎非白头，作牧授沧洲。",
        "江界乘潮入，山川值胜游。",
        "暑气随转扇，凉月傍开楼。",
        "便欲归田里，抛官逐隐侯。",
        "罢郎东出守，半路得浮舟。",
        "大旆行当夏，桐江到未秋。",
        "云闲分岛寺，涛静见沙鸥。",
        "谁伴临清景，吟诗上郡楼。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 362535,
      "title": "陕州题河上亭",
      "content": [
        "岸拥洪流急，亭开清兴长。",
        "当轩河草晚，入坐水风凉。",
        "独鸟惊来客，孤云触去樯。",
        "秋声和远雨，暮色带微阳。",
        "浪静澄窗影，沙明发簟光。",
        "逍遥每尽日，谁识爱沧浪。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 362537,
      "title": "长安书怀投知己",
      "content": [
        "所学近雕虫，知难谒至公。",
        "徒随众人后，拟老一生中。",
        "间岁家书到，经荒世业空。",
        "心悬沧海断，梦与白云通。",
        "玉漏声连北，银河气极东。",
        "关门迢递月，禁苑寂寥鸿。",
        "地广身难束，时平道独穷。",
        "萧条苔长雨，淅沥叶危风。",
        "久愧干朝客，多惭别钓翁。",
        "因依非不忝，延荐况曾蒙。",
        "与善应无替，垂恩本有终。",
        "霜天摇落日，莫使逐孤蓬。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 362538,
      "title": "送姚侍御充渭北掌书记",
      "content": [
        "北境烽烟急，南山战伐频。",
        "抚绥初易帅，参画尽须人。",
        "书记才偏称，朝廷意更亲。",
        "绣衣行李日，绮陌别离尘。",
        "报国将临虏，之藩不离秦。",
        "豸冠严在首，雄笔健随身。",
        "饮马河声暮，休兵塞色春。",
        "败亡仍暴骨，冤哭可伤神。",
        "上策何当用，边情此是真。",
        "雕阴曾久客，拜送欲沾巾。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 362539,
      "title": "长安书情投知己",
      "content": [
        "陕服因诗句，从容已半年。",
        "一从归阙下，罕得到门前。",
        "每候朝轩出，常看列宿悬。",
        "重投期见奖，数首果蒙传。",
        "转觉功宜倍，兼令住更坚。",
        "都忘春暂醉，少省夜曾眠。",
        "烦暑灯谁读，孤云业自专。",
        "精华搜未竭，骚雅琢须全。",
        "此事勤虽过，他谋拙莫先。",
        "槐街劳白日，桂路在青天。",
        "取第殊无序，还乡可有缘。",
        "旅情长越鸟，秋思几秦蝉。",
        "月色千楼满，砧声万井连。",
        "江山阻迢递，时节暗推迁。",
        "道即穷通守，才应始末怜。",
        "书绅相戒语，藏箧赠行篇。",
        "致主当齐圣，为郎本是仙。",
        "人心期际会，凤翼许迁延。",
        "毕竟良图在，何妨逸性便。",
        "幽斋中寝觉，珍木正阴圆。",
        "隐几闲瞻夜，临云兴渺然。",
        "五陵供丽景，六义动花笺。",
        "倘与潜生翼，宁非助化权。",
        "免教垂素发，归种海隅田。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 362540,
      "title": "府试丹浦非乐战",
      "content": [
        "自古为君道，垂衣致理难。",
        "怀仁须去杀，用武即胜残。",
        "毒帜诛方及，兵临衅可观。",
        "居来彭蠡固，战罢洞庭宽。",
        "雪国知天远，霜林是血丹。",
        "吾皇则尧典，薄伐至桑干。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 362544,
      "title": "省试振鹭",
      "content": [
        "有鸟生江浦，霜华作羽翰。",
        "君臣将比洁，朝野共相欢。",
        "月影林梢下，冰光水际残。",
        "翻飞时共乐，饮啄道皆安。",
        "迥翥宜高咏，群栖入静看。",
        "由来鸳鹭侣，济济列千官。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 362546,
      "title": "苑中题友人林亭",
      "content": [
        "井邑藏岩穴，幽栖趣若何。",
        "春篁抽笋密，夏鸟杂雏多。",
        "坐有清风至，林无暑气过。",
        "乱书还就叶，真饮不听歌。",
        "片影明红藓，斜阴映绿萝。",
        "雄文终可惜，莫更弃高科。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 362549,
      "title": "闻北虏入灵州二首",
      "content": [
        "河冰一夜合，虏骑入灵州。",
        "岁岁征兵去，难防塞草秋。",
        "见说灵州战，沙中血未干。",
        "将军日告急，走马向长安。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 362555,
      "title": "嵩山夜还",
      "content": [
        "家住东皋去，好采旧山薇。",
        "自省游泉石，何曾不夜归。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 362560,
      "title": "即席送许□之曹南省兄",
      "content": [
        "梅烂荷圆六月天，归帆高背虎丘烟。",
        "到时自见成行雁，",
        "待看春榜来江外，名占蓬莱第几仙。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 362561,
      "title": "送罗著作两浙按狱",
      "content": [
        "使印星车适旧游，陶潜今日在瀛洲。",
        "科条尽晓三千罪，",
        "归来重过姑苏郡，莫忘题名在虎丘。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 362563,
      "title": "答韩中丞容不饮酒",
      "content": [
        "老大成名仍足病，强听丝竹亦无欢。",
        "高情太守容闲坐，借与青山尽日看。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 362564,
      "title": "句",
      "content": [
        "只将五字句，用破一生心。",
        "楚里八千里，盘盘此都会。",
        "巍峨数里城，远水相映带。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 376071,
      "title": "南游湘汉寄友人",
      "content": [
        "南去远三京，三湘五月行。",
        "巴江雪水下，楚泽火云生。",
        "向野聊中饮，乘凉探暮程。",
        "离怀不可说，已近峡猿声。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 376841,
      "title": "渡汉江",
      "content": [
        "岭外音书绝，经冬复立春。",
        "近乡情更怯，不敢问来人。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    }
  ],
