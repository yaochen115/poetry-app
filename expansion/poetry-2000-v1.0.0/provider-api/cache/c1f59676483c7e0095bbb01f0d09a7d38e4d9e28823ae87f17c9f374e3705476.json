{
  "data": [
    {
      "id": 262184,
      "title": "白纻歌二首 一",
      "content": [
        "天河漫漫北斗璨，宫中乌啼知夜半。",
        "新缝白纻舞衣成，来迟邀得吴王迎。",
        "低鬟转面掩双袖，玉钗浮动秋风生。",
        "酒多夜长夜未晓，月明灯光两相照，后庭歌声更窈窕。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 262185,
      "title": "白纻歌二首 二",
      "content": [
        "馆娃宫中春日暮，荔枝木瓜花满树。",
        "城头乌栖休击鼓，青蛾弹瑟白纻舞。",
        "夜天曈曈不见星，宫中火照西江明。",
        "美人醉起无次第，堕钗遗珮满中庭。",
        "此时但愿可君意，回昼为宵亦不寐，年年奉君君莫弃。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 262186,
      "title": "短歌行",
      "content": [
        "人初生，日初出，上山迟，下山疾。",
        "百年三万六千朝，夜里分将强半日。",
        "有歌有舞须早为，昨日健于今日时。",
        "人家见生男女好，不知男女催人老。",
        "短歌行，无乐声。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 262187,
      "title": "饮马长城窟",
      "content": [
        "长城窟，长城窟边多马骨。",
        "古来此地无井泉，赖得秦家筑城卒。",
        "征人饮马愁不回，长城变作望乡堆。",
        "蹄踪未干人去近，续后马来泥污尽。",
        "枕弓睡著待水生，不见阴山在前阵。",
        "马蹄足脱装马头，健儿战死谁封侯。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 262188,
      "title": "乌夜啼",
      "content": [
        "庭树乌，尔何不向别处栖？",
        "夜夜夜半当户啼。",
        "家人把烛出洞户，惊栖失群飞落树。",
        "一飞直欲飞上天，回回不离旧栖处。",
        "未明重绕主人屋，欲下空中黑相触。",
        "风飘雨湿亦不移，君家树头多好枝。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 262189,
      "title": "簇蚕辞",
      "content": [
        "蚕欲老，箔头作茧丝皓皓。",
        "场宽地高风日多，不向中庭晒蒿草。",
        "神蚕急作莫悠扬，年来为尔祭神桑。",
        "但得青天不下雨，上无苍蝇下无鼠。",
        "新妇拜簇愿茧稠，女洒桃浆男打鼓。",
        "三日开箔雪团团，先将新茧送县官。",
        "已闻乡里催织作，去与谁人身上著。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 262190,
      "title": "渡辽水",
      "content": [
        "渡辽水，此去咸阳五千里。",
        "来时父母知隔生，重著衣裳如送死。",
        "亦有白骨归咸阳，营家各与题本乡。",
        "身在应无回渡日，驻马相看辽水傍。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 262191,
      "title": "空城雀",
      "content": [
        "空城雀，何不飞来人家住？",
        "空城无人种禾黍，土间生子草间长。",
        "满地蓬蒿幸无主，近村虽有高树枝。",
        "雨中无食长苦饥，八月小儿挟弓箭。",
        "家家畏向田头飞，但能不出空城里。",
        "秋时百草皆有子，报言黄口莫啾啾，长尔得成无横死。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 262192,
      "title": "水运行",
      "content": [
        "西江运船立红帜，万棹千帆绕江水。",
        "去年六月无稻苗，已说水乡人饿死。",
        "县官部船日算程，暴风恶雨亦不停。",
        "在生有乐当有苦，三年作官一年行。",
        "坏舟畏鼠复畏漏，恐向太仓折升斗。",
        "辛勤耕种非毒药，看著不入农夫口。",
        "用尽百金不为贵，但得一金即为利。",
        "远征海稻供边食，岂如多种边头地。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 262193,
      "title": "当窗织",
      "content": [
        "叹息复叹息，园中有枣行人食。",
        "贫家女为富家织，翁母隔墙不得力。",
        "水寒手澁丝脆断，续来续去心肠烂。",
        "草虫促促机下啼，两日催成一匹半。",
        "输官上顶有零落，姑未得衣身不著。",
        "当窗却羡青楼倡，十指不动衣盈箱。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 262194,
      "title": "失钗怨",
      "content": [
        "贫女铜钗惜于玉，失却来寻一日哭。",
        "嫁时女伴与作妆，头戴此钗如凤凰。",
        "双杯行酒六亲喜，我家新妇宜拜堂。",
        "镜中乍无失髻样，初起犹疑在床上。",
        "高楼翠钿飘舞尘，明日从头一遍新。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 262195,
      "title": "春燕词",
      "content": [
        "新燕新燕何不定，东家绿池西家井。",
        "飞鸣当户影悠扬，一遶簷头一遶梁。",
        "黄姑说向新妇女，去年堕子污衣箱。",
        "已能辞山复过海，幸我堂前故巢在。",
        "求食慎勿爱高飞，空中饥鸢为尔害。",
        "辛勤作窠在画梁，愿得年年主人富。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 262196,
      "title": "主人故池",
      "content": [
        "高池高阁上连起，荷叶团团盖秋水。",
        "主人已远凉风生，旧客不来芙蓉死。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262197,
      "title": "古宫怨",
      "content": [
        "乳乌哑哑飞复啼，城头晨夕宫中栖。",
        "吴王别殿绕江水，后宫不开美人死。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262198,
      "title": "关山月",
      "content": [
        "关山月，营开道白前军发。",
        "冻轮当碛光悠悠，照见三堆两堆骨。",
        "边风割面天欲明，金沙岭西看看没。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 262199,
      "title": "赠离曲",
      "content": [
        "合欢叶堕梧桐秋，鸳鸯背飞水分流。",
        "少年使我忽相弃，雌号雄鸣夜悠悠。",
        "夜长月没虫切切，冷风入房灯焰灭。",
        "若知中路各西东，彼此不忘同心结。",
        "收取头边蛟龙枕，留著箱中双雉裳。",
        "我今焚却旧房物，免使他人登尔床。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 262200,
      "title": "宛转词",
      "content": [
        "宛宛转转胜上纱，红红绿绿苑中花。",
        "纷纷泊泊夜飞鵶，寂寂寞寞离人家。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262201,
      "title": "水夫谣",
      "content": [
        "苦哉生长当驿边，官家使我牵驿船。",
        "辛苦日多乐日少，水宿沙行如海鸟。",
        "逆风上水万斛重，前驿迢迢后淼淼。",
        "半夜缘堤雪和雨，受他驱遣还复去。",
        "衣寒衣湿披短蓑，臆穿足裂忍痛何。",
        "到明辛苦无处说，齐声腾踏牵船出。",
        "一间茆屋何所值，父母之乡去不得。",
        "我愿此水作平田，长使水夫不怨天。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 262202,
      "title": "田家行",
      "content": [
        "男声欣欣女颜悦，人家不怨言语别。",
        "五月虽热麦风清，簷头索索缲车鸣。",
        "野蚕作茧人不取，叶间扑扑秋蛾生。",
        "麦收上场绢在轴，的知输得官家足。",
        "不望入口复上身，且免向城卖黄犊。",
        "回家衣食无厚薄，不见县门身即乐。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 262203,
      "title": "去妇",
      "content": [
        "新妇去年腁手足，衣不暇缝蚕废簇。",
        "白头使我忧家事，还如夜里烧残烛。",
        "当初为取傍人语，岂道如今自辛苦。",
        "在时纵嫌织绢迟，有丝不上邻家机。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 262204,
      "title": "神树词",
      "content": [
        "我家家西老棠树，须晴即晴雨即雨。",
        "四时八节上杯盘，愿神莫离神处所。",
        "男不着丁女在舍，官事上下无言语。",
        "老身长健树婆娑，万岁千年作神主。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 262205,
      "title": "祝鹊",
      "content": [
        "神鹊神鹊好言语，行人早回多利赂。",
        "我今庭中栽好树，与汝作巢当报汝。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262206,
      "title": "古谣",
      "content": [
        "一东一西垅头水，一聚一散天边霞。",
        "一来一去道上客，一颠一倒池中麻。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262207,
      "title": "公无渡河",
      "content": [
        "渡头恶天两岸远，波涛塞川如叠坂。",
        "幸无白刃驱向前，何用将身自弃捐。",
        "蛟龙啮骨鱼食血，黄泥直下无青天。",
        "男儿纵轻妇人语，惜君性命还须取。",
        "妇人无力挽断衣，舟沈身死悔难追。",
        "公无渡河，公须自为。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 262208,
      "title": "海人谣",
      "content": [
        "海人无家海里住，采珠役象为岁赋。",
        "恶波横天山塞路，未央宫中常满库。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262209,
      "title": "行见月",
      "content": [
        "月初生，居人见月一月行。",
        "行行一年十二月，强半马上看盈缺。",
        "百年欢乐能几何，在家见少行见多。",
        "不缘衣食相驱遣，此身谁愿长奔波。",
        "箧中有帛仓有粟，岂向天涯走碌碌。",
        "家人见月望我归，正是道上思家时。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 262210,
      "title": "七夕曲",
      "content": [
        "河边独自看星宿，夜织天丝难接续。",
        "抛梭振镊动明珰，为有秋期眠不足。",
        "遥愁今夜河水隔，龙驾车辕鹊填石。",
        "流苏翠帐星渚间，环珮无声灯寂寂。",
        "两情缠绵忽如故，复畏秋风生晓路。",
        "幸回郎意且斯须，一年中别今始初，明星未出少停车。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 262211,
      "title": "两头纤纤",
      "content": [
        "两头纤纤青玉玦，半白半黑头上发。",
        "偪偪仆仆春冰裂，磊磊落落桃花结。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262212,
      "title": "独漉歌",
      "content": [
        "独独漉漉，鼠食猫肉。",
        "乌日中，鹤露宿，黄河水直人心曲。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 262213,
      "title": "寄远曲",
      "content": [
        "美人别来无处所，巫山月明湘江雨。",
        "千回相见不分明，井底看星梦中语。",
        "两心相对尚难知，何况万里不相疑。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 262214,
      "title": "伤韦令孔雀词",
      "content": [
        "可怜孔雀初得时，美人为尔别开池。",
        "池边凤凰作伴侣，羌声鹦鹉无言语。",
        "雕笼玉架嫌不栖，夜夜思归向南舞。",
        "如今憔悴人见恶，万里更求新孔雀。",
        "热眠雨水饥拾虫，翠尾盘泥金彩落。",
        "多时人养不解飞，海山风黑何处归。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 262215,
      "title": "伤邻家鹦鹉词",
      "content": [
        "东家小女不惜钱，买得鹦鹉独自怜。",
        "自从死却家中女，无人更共鹦鹉语。",
        "十日不饮一滴浆，泪渍绿毛头似鼠。",
        "舌关哑咽畜哀怨，开笼放飞离人眼。",
        "短声亦绝翠臆翻，新墓崔嵬旧巢远。",
        "此禽有志女有灵，定为连理相并生。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 262216,
      "title": "春来曲",
      "content": [
        "春欲来，每日望春门早开。",
        "黄衫白马带尘土，逢著探春人却回。",
        "御堤内园晓过急，九衢大宅家家入。",
        "青帝少女染桃花，露妆初出红犹湿。",
        "光风暾暾蝶宛宛，遶树气匝枝柯软。",
        "可怜寒食街中郎，早起著得单衣裳。",
        "少年即见春好处，似我白头无好树。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 262217,
      "title": "春去曲",
      "content": [
        "春已去，花亦不知春去处。",
        "缘冈绕涧却归来，百回看著无花树。",
        "就中一夜东风恶，收红拾紫无遗落。",
        "老夫不比少年儿，不中数与春别离。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 262218,
      "title": "东征行",
      "content": [
        "桐栢水西贼星落，枭雏夜飞林木恶。",
        "相国刻日波涛清，当朝自请东南征。",
        "舍人为宾侍郎副，晓觉蓬莱欠珮声。",
        "玉阶舞蹈谢旌节，生死向前山可穴。",
        "同时赐马幷赐衣，御楼看带弓刀发。",
        "马前猛士三百人，金书左右红旗新。",
        "司庖常膳皆得对，好事将军封尔身。",
        "男儿生杀在手里，营门老将皆忧死。",
        "曈曈白日当南山，不立功名终不还。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 262219,
      "title": "荆门行",
      "content": [
        "江边行人暮悠悠，山头殊未见荆州。",
        "岘亭西南路多曲，栎林深深石镞镞。",
        "看炊红米煮白鱼，夜向鸡鸣店家宿。",
        "南中三月蚊蚋生，黄昏不闻人语声。",
        "生纱帷疎薄如雾，隔衣噆肤耳边鸣。",
        "欲明不待灯火起，唤得官船过蛮水。",
        "女儿停客茆屋新，开门扫地桐花里。",
        "犬声扑扑寒溪烟，人家烧竹种山田。",
        "巴云欲雨薰石热，麋鹿度江虫出穴。",
        "大蛇过处一山腥，野牛惊跳双角折。",
        "斜分汉水横千山，山青水绿荆门关。",
        "向前问个长沙路，旧是屈原沈溺处。",
        "谁家丹旐已南来，逢著流人从此去。",
        "月明山鸟多不栖，下枝飞上高枝啼。",
        "主人念远心不怿，罗衫卧对章台夕。",
        "红烛交横各自归，酒醒还是他乡客。",
        "壮年留滞尚思家，况复白头在天涯。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 262220,
      "title": "镜听词",
      "content": [
        "重重摩挲嫁时镜，夫壻远行凭镜听。",
        "回身不遣别人知，人意丁宁镜神圣。",
        "怀中收拾双锦带，恐畏街头见惊怪。",
        "嗟嗟际际下堂阶，独自灶前来跪拜。",
        "出门愿不闻悲哀，郎在任郎回未回。",
        "月明地上人过尽，好语多同皆道来。",
        "卷帷上床喜不定，与郎裁衣失翻正。",
        "可中三日得相见，重绣锦囊磨镜面。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 262221,
      "title": "行宫词",
      "content": [
        "上阳宫到蓬莱殿，行宫岩岩遥相见。",
        "向前天子行幸多，马蹄车辙山川遍。",
        "当时州县每年修，皆留内人看玉案。",
        "禁兵夺得明堂后，长闭桃源与绮绣。",
        "开元歌舞古草头，梁州乐人世嫌旧。",
        "官家乏人作宫户，不泥宫墙斫宫树。",
        "两边仗屋半崩摧，夜火入林烧殿柱。",
        "休封中岳六十年，行宫不见人眼穿。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 262222,
      "title": "羽林行",
      "content": [
        "长安恶少出名字，楼下劫商楼上醉。",
        "天明下直明光宫，散入五陵松柏中。",
        "百回杀人身合死，赦书尚有收城功。",
        "九衢一日消息定，乡吏籍中重改姓。",
        "出来依旧属羽林，立在殿前射飞禽。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 262223,
      "title": "射虎行",
      "content": [
        "自去射虎得虎归，官差射虎得虎迟。",
        "独行以死当虎命，两人因疑终不定。",
        "朝朝暮暮空手回，山下绿苗成道径。",
        "远立不敢污箭镞，闻死还来分虎肉。",
        "惜留猛虎着深山，射杀恐畏终身闲。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 262224,
      "title": "远将归",
      "content": [
        "远将归，胜未别离时。",
        "在家相见热，新归欢不足。",
        "去愿车轮迟，回思马蹄速。",
        "但令在舍相对贫，不向天涯金遶身。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 262225,
      "title": "寻橦歌",
      "content": [
        "人间百戏皆可学，寻橦不比诸余乐。",
        "重梳短髻下金钿，红帽青巾各一边。",
        "身轻足捷胜男子，绕竿四面争先缘。",
        "习多依附攲竿滑，上下蹁跹皆著袜。",
        "翻身垂颈欲落地，却住把腰初似歇。",
        "大竿百夫擎不起，褭褭半在青云里。",
        "纤腰女儿不动容，戴行直舞一曲终。",
        "回头但觉人眼见，矜难恐畏天无风。",
        "险中更险何曾失，山鼠悬头猿挂膝。",
        "小垂一手当舞盘，斜惨双蛾看落日。",
        "斯须改变曲解新，贵欲欢他平地人。",
        "散时满面生颜色，行步依前无气力。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 262226,
      "title": "铜雀台",
      "content": [
        "娇爱更何日，高台空数层。",
        "含啼暎双袖，不忍看西陵。",
        "漳水东流无复来，百花辇路为苍苔。",
        "青楼月夜长寂寞，碧云日莫空裴回。",
        "君不见邺中万事非昔时，古人不在今人悲。",
        "春风不逐君王去，草色年年旧宫路。",
        "宫中歌舞已浮云，空指行日往来处。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 262227,
      "title": "鸡鸣曲",
      "content": [
        "鸡初鸣，明星照东屋。",
        "鸡再鸣，红霞生海腹。",
        "百官待漏双阙前，圣人亦挂山龙服。",
        "宝钗命妇灯下起，环珮玲珑晓光里。",
        "直内初烧玉案香，司更尚滴铜壶水。",
        "金吾衞里直郎妻，到明不睡听晨鸡。",
        "天头日月相送迎，夜栖旦鸣人不迷。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 262228,
      "title": "送衣曲",
      "content": [
        "去秋送衣渡黄河，今秋送衣上陇坂。",
        "妇人不知道径处，但问新移军近远。",
        "半年著道经雨湿，开笼见风衣领急。",
        "旧来十月初点衣，与郎著向营中集。",
        "絮时厚厚绵纂纂，贵欲征人身上暖。",
        "愿身莫著裹尸归，愿妾不死长送衣。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 262229,
      "title": "斜路行",
      "content": [
        "世间娶容非娶妇，中庭牡丹胜松树。",
        "九衢大道人不行，走马奔车逐斜路。",
        "斜路行熟直路荒，东西岂是横太行。",
        "南楼弹弦北户舞，行人到此多回徨。",
        "头白如丝面如茧，亦学少年行不返。",
        "纵令自解思故乡，轮折蹄穿白日晚。",
        "谁将古曲换斜音，回取行人斜路心。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 262230,
      "title": "织锦曲",
      "content": [
        "大女身为织锦户，名在县家供进簿。",
        "长头起样呈作官，闻道官家中苦难。",
        "回花侧叶与人别，唯恐秋天丝线干。",
        "红缕葳蕤紫茸软，蝶飞参差花宛转。",
        "一梭声尽重一梭，玉腕不停罗袖卷。",
        "窗中夜久睡髻偏，横钗欲堕垂著肩。",
        "合衣卧时参没后，停灯起在鸡鸣前。",
        "一匹千金亦不卖，限日未成宫里怪。",
        "锦江水涸贡转多，宫中尽著单丝罗。",
        "莫言山积无尽日，百丈高楼一曲歌。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 262231,
      "title": "捣衣曲",
      "content": [
        "月明中庭捣衣石，掩帷下堂来捣帛。",
        "妇姑相对神力生，双揎白腕调杵声。",
        "高楼敲玉节会成，家家不睡皆起听。",
        "秋天丁丁复冻冻，玉钗低昂衣带动。",
        "夜深月落冷如刀，湿著一双纤手痛。",
        "回编易裂看生熟，鸳鸯纹成水波曲。",
        "重烧熨斗帖两头，与郎裁作迎寒裘。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 262232,
      "title": "秋夜曲二首 一",
      "content": [
        "天清漏长霜泊泊，兰绿收荣桂膏涸。",
        "高楼云鬟弄婵娟，古瑟暗断秋风弦。",
        "玉关遥隔万里道，金刀不翦双泪泉。",
        "香囊火死香气少，向帷合眼何时晓。",
        "城乌作营啼野月，秦州少妇生离别。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 262233,
      "title": "秋夜曲二首 二",
      "content": [
        "秋灯向壁掩洞房，良人此夜直明光。",
        "天河悠悠漏水长，南楼北斗两相当。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262234,
      "title": "题台州隐静寺",
      "content": [
        "隐静灵仙寺天凿，杯度飞来建岩壑。",
        "五峰直上插银河，一涧当空泻寥廓。",
        "崆峒黯淡碧琉璃，白云吞吐红莲阁。",
        "不知势压天几重，钟声常闻月中落。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 262235,
      "title": "送人游塞",
      "content": [
        "初晴天堕丝，晚色上春枝。",
        "城下路分处，边头人去时。",
        "停车数行日，劝酒问回期。",
        "亦是茫茫客，还从此别离。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 262236,
      "title": "塞上逢故人",
      "content": [
        "百战一身在，相逢白发生。",
        "何时得乡信，每日算归程。",
        "走马登寒垅，驱羊入废城。",
        "羌笳三两曲，人醉海西营。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 262237,
      "title": "南中",
      "content": [
        "天南多鸟声，州县半无城。",
        "野市依蛮姓，山邨逐水名。",
        "瘴烟沙上起，阴火雨中生。",
        "独有求珠客，年年入海行。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 262238,
      "title": "汴路水驿",
      "content": [
        "晚泊水边驿，柳塘初起风。",
        "蛙鸣蒲叶下，鱼入稻花中。",
        "去舍已云远，问程犹向东。",
        "近来多怨别，不与少年同。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 262239,
      "title": "淮南使廻留别窦侍御",
      "content": [
        "恋恋春恨结，绵绵淮草深。",
        "病身愁至夜，远道畏逢阴。",
        "忽逐酒杯会，暂同风景心。",
        "从今一分散，还是晓枝禽。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 262240,
      "title": "汴路即事",
      "content": [
        "千里河烟直，青槐夹岸长。",
        "天涯同此路，人语各殊方。",
        "草市迎江货，津桥税海商。",
        "廻看故宫柳，憔悴不成行。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 262241,
      "title": "山居",
      "content": [
        "屋在瀑泉西，茅簷下有溪。",
        "闭门留野鹿，分食养山鸡。",
        "桂熟长收子，兰生不作畦。",
        "初开洞中路，深处转松梯。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 262242,
      "title": "醉后忆山中故人",
      "content": [
        "花开草复秋，云水自悠悠。",
        "因醉暂无事，在山难免愁。",
        "遇晴须看月，鬬健且登楼。",
        "暗想山中伴，如今尽白头。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 262243,
      "title": "送流人",
      "content": [
        "见说长沙去，无亲亦共愁。",
        "阴云鬼门夜，寒雨瘴江秋。",
        "水国山魈引，蛮乡洞主留。",
        "渐看归处远，垂白住炎州。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 262244,
      "title": "贫居",
      "content": [
        "眼底贫家计，多时总莫嫌。",
        "蠹生腾药纸，字暗换书签。",
        "避雨拾黄叶，遮风下黑帘。",
        "近来身不健，时就六壬占。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 262245,
      "title": "过赵居士拟置草堂处所",
      "content": [
        "休师竹林北，空可两三间。",
        "虽爱独居好，终来相伴闲。",
        "犹嫌近前树，为碍看南山。",
        "的有深耕处，春初须早还。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 262246,
      "title": "新开望山处",
      "content": [
        "新开望山处，今朝减病眠。",
        "应移千里道，犹自数峰偏。",
        "故欲遮春巷，还来遶暮天。",
        "老夫行步弱，免到寺门前。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 262247,
      "title": "题东华观",
      "content": [
        "路尽烟水外，院门题上清。",
        "鹤雏灵解语，琼叶软无声。",
        "白发道心熟，黄衣仙骨轻。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 262248,
      "title": "饭僧",
      "content": [
        "别屋炊香饭，薰辛不入家。",
        "温泉调葛面，净手摘藤花。",
        "蒲鲊除青叶，芹虀带紫芽。",
        "愿师常伴食，消气有姜茶。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 262249,
      "title": "照镜",
      "content": [
        "忽自见憔悴，壮年人亦疑。",
        "发缘多病落，力为不行衰。",
        "暖手揉双目，看图引四肢。",
        "老来真爱道，所恨觉还迟。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 262250,
      "title": "归昭应留别城中",
      "content": [
        "喜得近京城，官卑意亦荣。",
        "竝床欢未定，离室思还生。",
        "计拙偷闲住，经过买日行。",
        "如无自来分，一驿是遥程。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 262251,
      "title": "答寄芙蓉冠子",
      "content": [
        "一学芙蓉叶，初开映水幽。",
        "虽经小儿手，不称老夫头。",
        "枕上眠常戴，风前醉恐柔。",
        "明年有闺阁，此样必难求。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 262252,
      "title": "长安春游",
      "content": [
        "骑马傍闲坊，新衣著雨香。",
        "桃花红粉醉，柳树白云狂。",
        "不觉愁春去，何曾得日长。",
        "牡丹相次发，城里又须忙。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 262253,
      "title": "冬夜感怀",
      "content": [
        "晚年恩爱少，耳目静于僧。",
        "竟夜不闻语，空房唯有灯。",
        "气嘘寒被湿，霜入破窗凝。",
        "断得人间事，长如此亦能。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 262254,
      "title": "初到昭应呈同僚",
      "content": [
        "白发初为吏，有慙年少郎。",
        "自知身上拙，不称世间忙。",
        "秋雨悬墙绿，暮山宫树黄。",
        "同官若容许，长借老僧房。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 262255,
      "title": "县丞厅即事",
      "content": [
        "宫殿半山上，人家高下居。",
        "古厅眠受魇，老吏语多虚。",
        "雨水洗荒竹，溪沙填废渠。",
        "圣朝收外府，皆自九天除。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 262256,
      "title": "闲居即事",
      "content": [
        "老病贪光景，寻常不下帘。",
        "妻愁耽酒僻，人怪考诗严。",
        "小婢偷红纸，娇儿弄白髯。",
        "有时看旧卷，未免意中嫌。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 262257,
      "title": "林居",
      "content": [
        "荒林四面通，门在野田中。",
        "顽仆长如客，贫居未胜蓬。",
        "旧绵衣不煖，新草屋多风。",
        "唯去山南近，闲亲贩药翁。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 262258,
      "title": "原上新居十三首 一",
      "content": [
        "新占原头地，本无山可归。",
        "荒藤生叶晚，老杏著花稀。",
        "厨舍近泥灶，家人初饱薇。",
        "弟兄今四散，何日更相依。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 262259,
      "title": "原上新居十三首 二",
      "content": [
        "一家榆柳新，四面远无邻。",
        "人少愁闻病，庄孤幸得贫。",
        "耕牛长愿饱，樵仆每怜勤。",
        "终日忧衣食，何由[脱]此身。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 262260,
      "title": "原上新居十三首 三",
      "content": [
        "长安无旧识，百里是天涯。",
        "寂寞思逢客，荒凉喜见花。",
        "访僧求贱药，将马中豪家。",
        "乍得新蔬菜，朝盘忽觉奢。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 262261,
      "title": "原上新居十三首 四",
      "content": [
        "鸡鸣村舍遥，花发亦萧条。",
        "野竹初生笋，溪田未得苗。",
        "家贫僮仆瘦，春冷菜蔬焦。",
        "甘分长如此，无名在圣朝。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 262262,
      "title": "原上新居十三首 五",
      "content": [
        "春来梨枣尽，啼哭小儿饥。",
        "邻富鸡常去，庄贫客渐稀。",
        "借牛畊地晚，卖树纳钱迟。",
        "墙下当官路，依山补竹篱。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 262263,
      "title": "原上新居十三首 六",
      "content": [
        "自埽一间房，唯铺独卧床。",
        "野羹溪菜滑，山纸水苔香。",
        "陈药初和白，新经未入黄。",
        "近来心力少，休读养生方。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 262264,
      "title": "原上新居十三首 七",
      "content": [
        "拟作读经人，空房置净巾。",
        "锁茶藤箧密，曝药竹床新。",
        "老病应随业，因缘不离身。",
        "焚香向居士，无计出诸尘。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 262265,
      "title": "原上新居十三首 八",
      "content": [
        "移家近住邨，贫苦自安存。",
        "细问梨果植，远求花药根。",
        "倩人开废井，趂犊入新园。",
        "长爱当山立，黄昏不闭门。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 262266,
      "title": "原上新居十三首 九",
      "content": [
        "和煖遶林行，新贫足喜声。",
        "埽渠忧竹旱，浇地引兰生。",
        "山客凭栽树，家僮使入城。",
        "门前粉壁上，书著县官名。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 262267,
      "title": "原上新居十三首 十",
      "content": [
        "住处钟鼓外，免争当路桥。",
        "身闲时却困，儿病可来娇。",
        "鸡睡日阳暖，蜂狂花艳烧。",
        "长安足门户，叠叠看登朝。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 262268,
      "title": "原上新居十三首 十一",
      "content": [
        "近来年纪到，世事总无心。",
        "古碣凭人搨，闲诗任客吟。",
        "送经还野苑，移石入幽林。",
        "谷口春风恶，梨花盖地深。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 262269,
      "title": "原上新居十三首 十二",
      "content": [
        "嬾更学诸余，林中埽地居。",
        "腻衣穿不洗，白发短慵梳。",
        "苦相常多泪，劳生自悟虚。",
        "闲行人事绝，亲故亦无书。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 262270,
      "title": "原上新居十三首 十三",
      "content": [
        "住处去山近，傍园麋鹿行。",
        "野桑穿井长，荒竹过墙生。",
        "新识邻里面，未谙邨社情。",
        "石田无力及，贱赁与人耕。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 262271,
      "title": "送李评事使蜀",
      "content": [
        "劝酒不依巡，明朝万里人。",
        "转江云栈细，近驿板桥新。",
        "石冷啼猿影，松昏戏鹿尘。",
        "少年为客好，况是益州春。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 262272,
      "title": "新修道居",
      "content": [
        "世间无所入，学道处新成。",
        "两面有山色，六时闻磬声。",
        "闲加经遍数，老爱字分明。",
        "若得离烦恼，焚香过一生。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 262273,
      "title": "赠洪誓师",
      "content": [
        "老僧真古画，闲坐语中听。",
        "识病方书圣，谙山草木灵。",
        "人来多施药，愿满不持经。",
        "相伴寻溪竹，秋苔袜履青。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 262274,
      "title": "题法云禅院僧",
      "content": [
        "不剃头多日，禅来白发长。",
        "合邨迎住寺，同学乞修房。",
        "觉少持经力，忧无养病粮。",
        "上山犹得在，自解衲衣裳。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 262275,
      "title": "赠溪翁",
      "content": [
        "溪田借四邻，不省解忧身。",
        "看日和仙药，书符救病人。",
        "伴僧斋过夏，中酒卧经旬。",
        "应得丹砂力，春来黑发新。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 262276,
      "title": "谢李续主簿",
      "content": [
        "馆舍幸相近，因风及病身。",
        "一官虽隔水，四韵是同人。",
        "衰卧朦胧晓，贫居冷落春。",
        "少年无不好，莫恨满头尘。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 262277,
      "title": "寒食",
      "content": [
        "田舍清明日，家家出火迟。",
        "白衫眠古巷，红索搭高枝。",
        "纱带生难结，铜钗重欲垂。",
        "斩新衣踏尽，还似去年时。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 262278,
      "title": "贻小尼师",
      "content": [
        "新剃青头发，生来未埽眉。",
        "身轻礼拜稳，心慢记经迟。",
        "唤起犹侵晓，催斋已过时。",
        "春晴堦下立，私地弄花枝。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 262279,
      "title": "惜欢",
      "content": [
        "当欢须且欢，过后买应难。",
        "岁去停灯守，花开把火看。",
        "狂来欺酒浅，愁尽觉天宽。",
        "次第头皆白，齐年人已残。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 262280,
      "title": "山中惜花",
      "content": [
        "忽看花渐稀，罪过酒醒时。",
        "寻觅风来处，惊张夜落时。",
        "游丝缠故蘂，宿夜守空枝。",
        "开取当轩地，年年树底期。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 262281,
      "title": "和武门下伤韦令孔雀",
      "content": [
        "孤号秋阁阴，韦令在时禽。",
        "觅伴海山黑，思乡橘柚深。",
        "举头闻旧曲，顾尾惜残金。",
        "顦顇不飞去，重君池上心。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 262282,
      "title": "题所赁宅牡丹花",
      "content": [
        "赁宅得花饶，初开恐是妖。",
        "粉光深紫腻，肉色退红娇。",
        "且愿风留著，惟愁日炙燋。",
        "可怜零落蘂，收取作香烧。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 262283,
      "title": "隐者居",
      "content": [
        "山人住处高。",
        "看日上蟠桃，雪缕青山脉。",
        "云生白鹤毛，朱书护身咒。",
        "水噀断邪刀，何物中长食。",
        "胡麻慢火熬。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    }
  ],
