{
  "data": [
    {
      "id": 378215,
      "title": "后庭花·后庭花·越罗小袖新香蒨",
      "content": [
        "越罗小袖新香蒨，薄笼金钏。",
        "倚栏无语摇轻扇，半遮匀面。",
        "春残日暖莺娇懒，满庭花片。",
        "怎不教人长相见，画堂深院。"
      ],
      "author": {
        "id": 13554,
        "name": "毛熙震"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378216,
      "title": "酒泉子·酒泉子·闲卧绣纬",
      "content": [
        "闲卧绣纬，慵想万般情宠。",
        "锦檀偏，翘股重，翠云欹。",
        "暮天屏上春山碧，映香烟雾隔。",
        "蕙兰心，魂梦役，敛蛾眉。"
      ],
      "author": {
        "id": 13554,
        "name": "毛熙震"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378217,
      "title": "酒泉子·酒泉子·钿匣舞鸾",
      "content": [
        "钿匣舞鸾，隐映艳红修碧。",
        "月梳斜，云鬓腻，粉香寒。",
        "晓花微敛轻呵展，袅钗金燕软。",
        "日初升，帘半卷，对妆残。"
      ],
      "author": {
        "id": 13554,
        "name": "毛熙震"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378218,
      "title": "菩萨蛮·菩萨蛮·梨花满院飘香雪",
      "content": [
        "梨花满院飘香雪，高楼夜静风筝咽。",
        "斜月照帘帷，忆君和梦稀。",
        "小窗灯影背，燕语惊愁态。",
        "屏掩断香飞，行云山外归。"
      ],
      "author": {
        "id": 13554,
        "name": "毛熙震"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378219,
      "title": "菩萨蛮·菩萨蛮·绣帘高轴临塘看",
      "content": [
        "绣帘高轴临塘看，雨翻荷芰真珠散。",
        "残暑晚初凉，轻风渡水香。",
        "无聊悲往事，怎奈牵情思。",
        "光景暗相催，等闲秋又来。"
      ],
      "author": {
        "id": 13554,
        "name": "毛熙震"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378220,
      "title": "菩萨蛮·菩萨蛮·天含残碧融春色",
      "content": [
        "天含残碧融春色，五陵薄幸无消息。",
        "尽日掩朱门，离愁暗断魂。",
        "莺啼芳树暖，燕拂回塘满。",
        "寂寞对屏山，相思醉梦间。"
      ],
      "author": {
        "id": 13554,
        "name": "毛熙震"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378221,
      "title": "浣溪沙·浣溪沙·入夏偏宜淡薄妆",
      "content": [
        "入夏偏宜淡薄妆，越罗衣褪郁金黄，翠钿檀注助容光。",
        "相见无言还有恨，几回拚却又思量，月窗香径梦悠飏。"
      ],
      "author": {
        "id": 12052,
        "name": "李珣"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378222,
      "title": "浣溪沙·浣溪沙·晚出闲庭看海棠",
      "content": [
        "晚出闲庭看海棠，风流学得内家妆，小钗横戴一枝芳。",
        "镂玉梳斜云鬓腻，缕金衣透雪肌香，暗思何事立残阳。"
      ],
      "author": {
        "id": 12052,
        "name": "李珣"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378223,
      "title": "浣溪沙·浣溪沙·访旧伤离欲断魂",
      "content": [
        "访旧伤离欲断魂，无因重见玉楼人，六街微雨镂香尘。",
        "早为不逢巫峡梦，那堪虚度锦江春，遇花倾酒莫辞频。"
      ],
      "author": {
        "id": 12052,
        "name": "李珣"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378224,
      "title": "浣溪沙·浣溪沙·红藕花香到槛频",
      "content": [
        "红藕花香到槛频，可堪闲忆似花人，旧欢如梦绝音尘。",
        "翠叠画屏山隐隐，冷铺纹簟水潾潾，断魂何处一蝉新。"
      ],
      "author": {
        "id": 12052,
        "name": "李珣"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378225,
      "title": "渔歌子·渔歌子·楚山青",
      "content": [
        "楚山青，湘水绿，春风淡荡看不足。",
        "草芊芊，花簇簇，渔艇棹歌相续。",
        "信浮沉，无管束，钓回乘月归湾曲。",
        "酒盈樽，云满屋，不见人间荣辱。"
      ],
      "author": {
        "id": 12052,
        "name": "李珣"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378226,
      "title": "渔歌子·渔歌子·荻花秋",
      "content": [
        "荻花秋，潇湘夜，橘洲佳景如屏画。",
        "碧烟中，明月下，小艇垂纶初罢。",
        "水为乡，篷作舍，鱼羹稻饭常餐也。",
        "酒盈杯，书满架，名利不将心挂。"
      ],
      "author": {
        "id": 12052,
        "name": "李珣"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378227,
      "title": "渔歌子·渔歌子·柳垂丝",
      "content": [
        "柳垂丝，花满树，莺啼楚岸春山暮。",
        "棹轻舟，出深浦，缓唱渔歌归去。",
        "罢垂纶，还酌醑，孤村遥指云遮处。",
        "下长汀，临浅渡，惊起一行沙鹭。"
      ],
      "author": {
        "id": 12052,
        "name": "李珣"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378228,
      "title": "渔歌子·渔歌子·九疑山",
      "content": [
        "九疑山，三湘水，芦花时节秋风起。",
        "水云间，山月里，棹月穿云游戏。",
        "鼓清琴，倾绿蚁，扁舟自得逍遥志。",
        "任东西，无定止，不议人间醒醉。"
      ],
      "author": {
        "id": 12052,
        "name": "李珣"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378229,
      "title": "巫山一段云·巫山一段云·有客经巫峡",
      "content": [
        "有客经巫峡，停桡向水湄。",
        "楚王曾此梦瑶姬，一梦杳无期。",
        "尘暗珠帘卷，香消翠帷垂。",
        "西风回首不胜悲，暮雨洒空祠。"
      ],
      "author": {
        "id": 12052,
        "name": "李珣"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378230,
      "title": "巫山一段云·巫山一段云·古庙依青嶂",
      "content": [
        "古庙依青嶂，行宫枕碧流。",
        "水声山色锁妆楼，往事思悠悠。",
        "云雨朝还暮，烟花春复秋。",
        "啼猿何必近孤舟，行客自多愁。"
      ],
      "author": {
        "id": 12052,
        "name": "李珣"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378231,
      "title": "临江仙·临江仙·帘卷池心小阁虚",
      "content": [
        "帘卷池心小阁虚，暂凉闲步徐徐。",
        "芰荷经雨半凋疏，拂堤垂柳，蝉噪夕阳余。",
        "不语低鬟幽思远，玉钗斜坠双鱼。",
        "几回偷看寄来书，离情别恨，相隔欲何如。"
      ],
      "author": {
        "id": 12052,
        "name": "李珣"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378232,
      "title": "临江仙·临江仙·莺报帘前暖日红",
      "content": [
        "莺报帘前暖日红，玉炉残麝犹浓。",
        "起来闺思尚疏慵，别愁春梦，谁解此情悰。",
        "强整娇姿临宝镜，小池一朵芙蓉。",
        "旧欢无处再寻踪，更堪回顾，屏画九疑峰。"
      ],
      "author": {
        "id": 12052,
        "name": "李珣"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378233,
      "title": "南乡子·南乡子·烟漠漠",
      "content": [
        "烟漠漠，雨凄凄，岸花零落鹧鸪啼。",
        "远客扁舟临野渡，思乡处，潮退水平春色暮。"
      ],
      "author": {
        "id": 12052,
        "name": "李珣"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378234,
      "title": "南乡子·南乡子·兰棹举",
      "content": [
        "兰棹举，水纹开，竞携藤笼采莲来。",
        "回塘深处遥相见，邀同宴，绿酒一卮红上面。"
      ],
      "author": {
        "id": 12052,
        "name": "李珣"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378235,
      "title": "南乡子·南乡子·归路近",
      "content": [
        "归路近，扣舷歌，采真珠处水风多。",
        "曲岸小桥山月过，烟深锁，豆蔻花垂千万朵。"
      ],
      "author": {
        "id": 12052,
        "name": "李珣"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378236,
      "title": "南乡子·南乡子·乘彩舫",
      "content": [
        "乘彩舫，过莲塘，棹歌惊起睡鸳鸯。",
        "游女带香偎伴笑，争窈窕，竞折团荷遮晚照。"
      ],
      "author": {
        "id": 12052,
        "name": "李珣"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378237,
      "title": "南乡子·南乡子·倾绿蚁",
      "content": [
        "倾绿蚁，泛红螺，闲邀女伴簇笙歌。",
        "避暑信船轻浪里，闲游戏，夹岸荔枝红蘸水。"
      ],
      "author": {
        "id": 12052,
        "name": "李珣"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378238,
      "title": "南乡子·南乡子·云带雨",
      "content": [
        "云带雨，浪迎风，钓翁回棹碧湾中。",
        "春酒香熟鲈鱼美，谁同醉？",
        "缆却扁舟篷底睡。"
      ],
      "author": {
        "id": 12052,
        "name": "李珣"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378239,
      "title": "南乡子·南乡子·沙月静",
      "content": [
        "沙月静，水烟轻，芰荷香里夜船行。",
        "绿鬟红脸谁家女？",
        "遥相顾，缓唱棹歌极浦去。"
      ],
      "author": {
        "id": 12052,
        "name": "李珣"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378240,
      "title": "南乡子·南乡子·渔市散",
      "content": [
        "渔市散，渡船稀，越南云树望中微。",
        "行客待湘天欲暮，送春浦，愁听猩猩啼瘴雨。"
      ],
      "author": {
        "id": 12052,
        "name": "李珣"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378241,
      "title": "南乡子·南乡子·拢云髻",
      "content": [
        "拢云髻，背犀梳，焦红衫映绿罗裙。",
        "越王台下春风暖，药盈岸，游赏每邀邻女伴。"
      ],
      "author": {
        "id": 12052,
        "name": "李珣"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378242,
      "title": "南乡子·南乡子·相见处",
      "content": [
        "相见处，晚晴天，斜桐花下越台前。",
        "暗里回眸深属意，遗双翠，骑象背人先过水。"
      ],
      "author": {
        "id": 12052,
        "name": "李珣"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378243,
      "title": "女冠子·女冠子·星高月午",
      "content": [
        "星高月午，丹桂青松深处。",
        "醮坛开，金磬敲清露，珠幢立翠苔。",
        "步虚声缥缈，想象思徘徊。",
        "晓天归去路，指蓬莱。"
      ],
      "author": {
        "id": 12052,
        "name": "李珣"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378244,
      "title": "女冠子·女冠子·春山夜静",
      "content": [
        "春山夜静，愁闻洞天疏磬。",
        "玉堂虚，细雾垂珠佩，轻烟曳翠裙。",
        "对花情脉脉，望月步徐徐。",
        "刘阮今何处？",
        "绝来书。"
      ],
      "author": {
        "id": 12052,
        "name": "李珣"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378245,
      "title": "酒泉子·酒泉子·寂寞青楼",
      "content": [
        "寂寞青楼，风触绣帘珠碎撼。",
        "月朦胧，花暗淡，锁春愁。",
        "寻想往事依稀梦，泪脸桃红色重。",
        "鬓欹蝉。",
        "钗坠凤，思悠悠。"
      ],
      "author": {
        "id": 12052,
        "name": "李珣"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378246,
      "title": "酒泉子·酒泉子·雨渍花零",
      "content": [
        "雨渍花零，红散香凋池两岸。",
        "别情遥，春歌断，掩银屏。",
        "孤帆早晚离三楚，闲理钿筝愁几许？",
        "曲中情，弦上语，不堪听。"
      ],
      "author": {
        "id": 12052,
        "name": "李珣"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378247,
      "title": "酒泉子·酒泉子·秋雨联绵",
      "content": [
        "秋雨联绵，声散败荷丛里。",
        "那堪深夜枕前听，酒初醒。",
        "牵愁惹思更无停，烛暗香凝天欲曙。",
        "细和烟，冷和雨，透帘旌。"
      ],
      "author": {
        "id": 12052,
        "name": "李珣"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378248,
      "title": "酒泉子·酒泉子·秋月婵娟",
      "content": [
        "秋月婵娟，皎洁碧纱窗外。",
        "照花穿竹冷沉沉，印池心。",
        "凝露滴，砌蛩吟，惊觉谢娘残梦。",
        "夜深斜傍枕前来，影徘徊。"
      ],
      "author": {
        "id": 12052,
        "name": "李珣"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378249,
      "title": "望远行·望远行·春日迟迟思寂寥",
      "content": [
        "春日迟迟思寂寥，行客关山路遥。",
        "琼窗时听语莺娇，柳丝牵恨一条条。",
        "休晕绣，罢吹萧，貌逐残花暗凋。",
        "同心犹结旧裙腰，忍辜风月度良宵。"
      ],
      "author": {
        "id": 12052,
        "name": "李珣"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378250,
      "title": "望远行·望远行·露滴幽庭落叶时",
      "content": [
        "露滴幽庭落叶时，愁聚萧娘柳眉。",
        "玉郎一去负佳期，水云迢递雁书迟。",
        "屏半掩，枕斜欹，蜡泪无言对垂。",
        "吟蛩断续漏频移，入窗明月鉴空帷。"
      ],
      "author": {
        "id": 12052,
        "name": "李珣"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378251,
      "title": "菩萨蛮·菩萨蛮·回塘起波纹细",
      "content": [
        "回塘起波纹细，剌桐花里门斜闭。",
        "残日照平芜，双双飞鹧鸪。",
        "征帆何处客，相见还相隔。",
        "不语欲魂消，望中烟水遥。"
      ],
      "author": {
        "id": 12052,
        "name": "李珣"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378252,
      "title": "菩萨蛮·菩萨蛮·等闲将度三春景",
      "content": [
        "等闲将度三春景，帘垂碧砌参差影。",
        "曲槛日初斜，杜鹃啼落花。",
        "恨君容易处，又话潇湘去。",
        "凝思倚屏山，泪流红脸斑。"
      ],
      "author": {
        "id": 12052,
        "name": "李珣"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378253,
      "title": "菩萨蛮·菩萨蛮·隔帘微雨双飞燕",
      "content": [
        "隔帘微雨双飞燕，砌花零落红深浅。",
        "捻得宝筝凋，心随征棹遥。",
        "楚天云外路，动便经年去。",
        "香断画屏深，旧欢何处寻。"
      ],
      "author": {
        "id": 12052,
        "name": "李珣"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378254,
      "title": "西溪子·西溪子·金缕翠钿浮动",
      "content": [
        "金缕翠钿浮动，妆罢小窗圆梦。",
        "日高时，春已老，人来到，满地落花慵扫。",
        "无语倚屏风，泣残红。"
      ],
      "author": {
        "id": 12052,
        "name": "李珣"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378255,
      "title": "虞美人·虞美人·金笼莺报天将曙",
      "content": [
        "金笼莺报天将曙，惊起分飞处。",
        "夜来潜与玉郎期，多情不觉酒醒迟，失归期。",
        "映花避月遥相送，腻髻偏凤。",
        "欲回娇步入香闺，倚屏无语捻云篦，翠眉低。"
      ],
      "author": {
        "id": 12052,
        "name": "李珣"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378256,
      "title": "河传·河传·去去",
      "content": [
        "去去，何处？",
        "迢迢巴楚，山水相连。",
        "朝云暮雨，依旧十二峰前，猿声到客船。",
        "愁肠岂异丁香结？",
        "因离别，故国音书绝。",
        "想佳人花下，对明月春风，恨应同。"
      ],
      "author": {
        "id": 12052,
        "name": "李珣"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378257,
      "title": "河传·河传·春暮",
      "content": [
        "春暮，微雨。",
        "送君南浦，愁敛双蛾。",
        "落花深处，啼鸟似逐离散，粉檀珠泪和。",
        "临流更把同心结，情哽咽，后会何时节？",
        "不堪回首，相望已隔汀洲，檐声幽。"
      ],
      "author": {
        "id": 12052,
        "name": "李珣"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    }
