{
  "data": [
    {
      "id": 80285,
      "title": "步虚词",
      "content": [
        "玄根布灵叶，妙化无常人。",
        "结兹清阳气，挺我空洞神。",
        "炼度得长生，列籍齐众真。",
        "登宾玉皇家，执侍罗星嫔。",
        "欻往宴十洲，飞客成相亲。",
        "茫茫尘中区，荒秽何足邻。"
      ],
      "author": {
        "id": 7098,
        "name": "翁卷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 80286,
      "title": "游仙篇",
      "content": [
        "旭日升太虚，流光到萌芽。",
        "旁有五云气，焕烂含精华。",
        "所愿服食之，跻身眇长霞。",
        "带我清泠佩，飞我欻忽车。",
        "宁为世间游，世道纷以拏。",
        "三山不足期，千龄讵云赊。",
        "悟彼劳生人，无异芳春花。"
      ],
      "author": {
        "id": 7098,
        "name": "翁卷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 80287,
      "title": "思远客",
      "content": [
        "涉夏思已深，感秋念愈迫。",
        "思念皆为谁，为彼远行客。",
        "客行曷辰休，怅望朝复夕。",
        "出门虚有待，命驾焉所适。",
        "邈邈阻前欢，悠悠抱今戚。",
        "中庭一株橘，嘉实转金碧。",
        "爰意花开时，花边语离析。",
        "惜此不忍餐，留之候君摘。",
        "拟君君未来，囘肠更如折。",
        "何当乘梦时，傥遂徽容觌。"
      ],
      "author": {
        "id": 7098,
        "name": "翁卷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 80288,
      "title": "登飞霞山作",
      "content": [
        "局居厌纷丛，荡志寻岖嵚。",
        "拂衣出城隅，杖策循湖阴。",
        "何年彼真仙，遗宫寄幽岑。",
        "连树窈蒙密，灵洞疑虚沈。",
        "攀条承藓飙，立石弄澄深。",
        "眺睐增殊欢，超忽涓烦襟。",
        "美人逝云远，青草畴与吟。",
        "感昔兴重嗟，会意良在今。",
        "山公悦崇资，嵇氏陶清音。",
        "保真道无违，逐欲情易淫。",
        "顾乏安期资，华鬓能不侵。",
        "虽非尚子贤，傥遂毕娶心。"
      ],
      "author": {
        "id": 7098,
        "name": "翁卷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 80289,
      "title": "古道",
      "content": [
        "古道今不见，今交非古情。",
        "交情亦何难，难逢双目明。",
        "青松生青山，真节莫与并。",
        "植之廛郭旁，流俗多所轻。",
        "远道岂易行，出门悔吝生。",
        "君看天上云，何心更营营。",
        "勿言贫未安，安贫存令名。"
      ],
      "author": {
        "id": 7098,
        "name": "翁卷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 80290,
      "title": "和陈待制秋日湖楼宴集篇",
      "content": [
        "一夕鸣雨来，秋容变俄顷。",
        "湖山属初霁，风烟带微冷。",
        "侍臣设芳筵，开楼翫澄景。",
        "怀我林下人，招携共观省。",
        "碧草铺近洲，白云冒遥岭。",
        "依稀兰杜香，髣髴潇湘浄。",
        "抚化篇忽成，达生累全屏。",
        "即是造物游，何必神仙境。"
      ],
      "author": {
        "id": 7098,
        "name": "翁卷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 80291,
      "title": "送叶任道",
      "content": [
        "英英桥门彦，声动翰墨场。",
        "已就冲天翼，如何复低翔。",
        "兹辰首征途，言寻八桂乡。",
        "远士望模式，会府钦才良。",
        "莫以琼树姿，怨彼霜霰妨。",
        "委顺要达识，沮挫知坚刚。",
        "改序逢清和，飞花点行装。",
        "登涉山川异，经从道路长。",
        "听猿过南岳，采芷沿三湘。",
        "应怀古骚人，搦笔为篇章。",
        "行藏义在需，通塞时靡常。",
        "大器且自惜，晚成亦何伤。",
        "蓬瀛几仙伴，伫子归班行。"
      ],
      "author": {
        "id": 7098,
        "name": "翁卷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 80292,
      "title": "送戴汉老",
      "content": [
        "三洞耸奇秀，双溪泻澄鲜。",
        "上有婺女光，照耀无穷年。",
        "储灵复产异，人物相比肩。",
        "君虽生后来，识与先辈连。",
        "如筠挺修直，似玉抱贞坚。",
        "策名甲科上，初仕瓯海边。",
        "孰云簿领闲，文案方满前。",
        "敏手信无敌，虚怀常坦然。",
        "驾言指归期，通邑皆拳拳。",
        "乃知为政者，何苦用心偏。",
        "良才世所稀，华职当骤迁。",
        "愿君养盛业，益使芳誉传。",
        "明晨潮信来，挂席从中川。"
      ],
      "author": {
        "id": 7098,
        "name": "翁卷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 80293,
      "title": "送刘几道",
      "content": [
        "束发同执经，交分人莫如。",
        "我愚百无成，蹭蹬空林居。",
        "君文最奇崛，二十魁荐书。",
        "青衫何太晚，警捕殊区区。",
        "是月蝉始鸣，秀色连郊墟。",
        "俶装趋海邑，指期当憩车。",
        "老大恋亲友，暂别犹欷歔。",
        "况此一分手，归期三载余。",
        "积雨山川晦，新晴氛雾除。",
        "殷勤送客吟，掺执行子裾。",
        "愿言乘高风，矫翮凌太虚。"
      ],
      "author": {
        "id": 7098,
        "name": "翁卷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 80294,
      "title": "山中采药",
      "content": [
        "岩崖产灵药，等闲人顾稀。",
        "采掇获所愿，跻登倦忘归。",
        "沃叶带露滋，深根涵土肌。",
        "妍光媚幽笈，芳气盈我衣。",
        "濯以清涧泉，曝之太阳晖。",
        "制治拟如法，服食从所宜。",
        "除疴养天和，仙方岂吾欺。",
        "协彼古修意，庶用延将衰。",
        "将衰傥得延，万事焉足为。"
      ],
      "author": {
        "id": 7098,
        "name": "翁卷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 80295,
      "title": "酬友人",
      "content": [
        "常忧别时数，每苦欢事疎。",
        "矧兹同心人，契阔三月余。",
        "昨日携瘦藤，往访林间庐。",
        "差池不一见，出门恨何如。",
        "今晨苍童来，赠言委璠玙。",
        "吟翫弗忍释，绚彩摇襟裾。",
        "子有供世才，胡为未展舒。",
        "我无资身策，合守贫贱居。",
        "积疴困疲薾，焉得愁闷除。",
        "慇懃荷久要，尚肯念到予。",
        "南枝早梅白，古涧寒流虚。",
        "明当复相寻，行游带琴书。",
        "嚼花饮芳泉，哦诗更踌躇。"
      ],
      "author": {
        "id": 7098,
        "name": "翁卷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 80296,
      "title": "题林遂之真意亭",
      "content": [
        "结亭纳虚豁，崔嵬进南山。",
        "南山有佳致，白云多往还。",
        "繁英粲秋篱，幽芳复相关。",
        "浊醪对之饮，超此神虑闲。",
        "至乐岂外求，妙象非言间。",
        "妙哉靖节风，千载君能攀。"
      ],
      "author": {
        "id": 7098,
        "name": "翁卷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 80297,
      "title": "呈余伯皋",
      "content": [
        "木犀香残菊花拆，多少秋风吹陇陌。",
        "我行欲遍江西州，最后方作筠阳客。",
        "筠阳之州水中隔，古来称是神仙宅。",
        "今君住此将二年，应识神仙李八伯。"
      ],
      "author": {
        "id": 7098,
        "name": "翁卷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 80298,
      "title": "寄衣词",
      "content": [
        "手织白纻纤且长，生著宜热熟宜凉。",
        "以比妾心齐素洁，制成游子远衣裳。",
        "君心相厚未相薄，衣来还得称君目。",
        "愿君服之无弃捐，映君颜貌长如玉。"
      ],
      "author": {
        "id": 7098,
        "name": "翁卷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 80299,
      "title": "白纻词",
      "content": [
        "翩翩长袖光闪银，绣罗帐密流香尘。",
        "歌分四时舞一色，渌觞传处驰金轮。",
        "急竹繁丝互催逼，吴娘娇浓玉无力。",
        "呵星唤月留夜长，十二围屏暖山色。"
      ],
      "author": {
        "id": 7098,
        "name": "翁卷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 80300,
      "title": "送陈郎中棅知严州",
      "content": [
        "频年经虎害，人望使君来。",
        "地重分旄节，州清管钓台。",
        "凉天星象动，吉日印符开。",
        "帝擢平津策，曾知有用才。"
      ],
      "author": {
        "id": 7098,
        "name": "翁卷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 80301,
      "title": "寄赵灵秀",
      "content": [
        "千山落叶深，高树不藏禽。",
        "游子在何处，故人劳此心。",
        "闲灯妨远梦，寒雨乱愁吟。",
        "僧奭曾相约，花时共一寻。"
      ],
      "author": {
        "id": 7098,
        "name": "翁卷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 80302,
      "title": "送人赴沅州任",
      "content": [
        "旧贡包茅地，中存古意长。",
        "去程逢岳雪，上事带春阳。",
        "雾结朱砂气，波流白芷香。",
        "大夫祠寂寞，烦与奠椒浆。"
      ],
      "author": {
        "id": 7098,
        "name": "翁卷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 80303,
      "title": "悼雪庵禅师",
      "content": [
        "悟了无生妙，归空若故乡。",
        "竹房三尺像，石榻一炉香。",
        "坏衲犹悬树，新松忽过墙。",
        "僧中留不得，几日为凄凉。"
      ],
      "author": {
        "id": 7098,
        "name": "翁卷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 80304,
      "title": "寄沈洞主",
      "content": [
        "想当清夜醮，带月叩仙钟。",
        "指上雷霆诀，庵前虎豹踪。",
        "药收阳地草，薪采故枝松。",
        "拟即寻师去，茅峰叠几重。"
      ],
      "author": {
        "id": 7098,
        "name": "翁卷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 80305,
      "title": "晚秋送徐玑赴龙溪丞因过泉南旧里",
      "content": [
        "卷中风雅句，名匠亦难如。",
        "远邑亲微禄，他乡过旧庐。",
        "程途多见菊，行李半担书。",
        "未信文明代，无人荐子虚。"
      ],
      "author": {
        "id": 7098,
        "name": "翁卷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 80306,
      "title": "即事言怀",
      "content": [
        "赋得拙疎性，合令纵迹赊。",
        "相亲惟野客，所论是诗家。",
        "听雨眠僧屋，看云立钓槎。",
        "秋来有新句，多半为黄花。"
      ],
      "author": {
        "id": 7098,
        "name": "翁卷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 80307,
      "title": "寄远人",
      "content": [
        "秋气日凄清，秋衣纫未成。",
        "在家犹不乐，行路若为情。",
        "几处好山色，暮天群雁声。",
        "分明相忆梦，夜夜出江城。"
      ],
      "author": {
        "id": 7098,
        "name": "翁卷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 80308,
      "title": "太平山读书奉寄城间诸友",
      "content": [
        "寥寥钟磬音，永日在空林。",
        "多见僧家事，深便静者心。",
        "虚亭云片泊，侧径石根侵。",
        "此去城间远，君应嬾出寻。"
      ],
      "author": {
        "id": 7098,
        "name": "翁卷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 80309,
      "title": "冬日过道上人旧房",
      "content": [
        "已知超众相，假质任成灰。",
        "房是他僧住，门无旧客来。",
        "冰干半池水，花落一根梅。",
        "犹是疑行脚，何年见却囘。"
      ],
      "author": {
        "id": 7098,
        "name": "翁卷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 80310,
      "title": "送赵紫芝为江东从事",
      "content": [
        "非惟篇翰奇，吏道更深知。",
        "山水六朝地，登临三考时。",
        "泥沙多旧物，风日少全碑。",
        "正属黄花发，愁闻有别离。"
      ],
      "author": {
        "id": 7098,
        "name": "翁卷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 80311,
      "title": "春日和刘明远",
      "content": [
        "不奈滴簷声，风囘昨夜晴。",
        "一阶春草碧，几片落花轻。",
        "知分贫堪乐，无营梦亦清。",
        "看君话幽隠，如我愿逃名。"
      ],
      "author": {
        "id": 7098,
        "name": "翁卷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 80312,
      "title": "送薛子舒赴华亭船官",
      "content": [
        "君到云间日，应分二陆名。",
        "县图山色少，井味海潮并。",
        "剡局三年印，春风半月程。",
        "野人因买鹤，曾向此中行。"
      ],
      "author": {
        "id": 7098,
        "name": "翁卷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 80313,
      "title": "送包释可抚机",
      "content": [
        "州带福星明，君今指去程。",
        "乱山秋雨后，一路野蝉鸣。",
        "时静军书少，人闲官况清。",
        "归来话风土，尽识荔枝名。"
      ],
      "author": {
        "id": 7098,
        "name": "翁卷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 80314,
      "title": "喜蒋德瞻还里",
      "content": [
        "为官三载余，所得是清虚。",
        "学就金丹法，修成玉检书。",
        "乍归人客满，久出竹林疎。",
        "怪我吟髭白，相欢相见初。"
      ],
      "author": {
        "id": 7098,
        "name": "翁卷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 80315,
      "title": "送赵嗣勋",
      "content": [
        "休思孤屿峰，且往看吴中。",
        "一片太湖色，远涵秋气空。",
        "藕塘南北棹，芦港去来鸿。",
        "入幕多僚属，惟君事不同。"
      ],
      "author": {
        "id": 7098,
        "name": "翁卷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 80316,
      "title": "过太湖",
      "content": [
        "水跨三州地，苏州水最多。",
        "昔年僧为说，今日自经过。",
        "亡国岂无恨，渔人休更歌。",
        "洞庭山一抹，翠霭白云和。"
      ],
      "author": {
        "id": 7098,
        "name": "翁卷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 80317,
      "title": "信州草衣寺",
      "content": [
        "簷多山鸟啼，山外玉为溪。",
        "林树若又长，塔峰应更低。",
        "数僧归似客，一佛坏方泥。",
        "宴坐当时事，廊碑具刻题。"
      ],
      "author": {
        "id": 7098,
        "name": "翁卷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 80318,
      "title": "宿邬子寨下",
      "content": [
        "已谒龙君庙，明朝早过湖。",
        "傍沙船尽泊，经火地多枯。",
        "秋至昏星易，空长楚月孤。",
        "萧条村戍内，更点有如无。"
      ],
      "author": {
        "id": 7098,
        "name": "翁卷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 80319,
      "title": "同赵灵芝杜子野游豫章总持寺",
      "content": [
        "满寺是秋风，吹开黄菊丛。",
        "重林无日到，此地若山中。",
        "罢磬孤僧出，看碑两客同。",
        "相传化龙事，神怪理难通。"
      ],
      "author": {
        "id": 7098,
        "name": "翁卷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 80320,
      "title": "酬杜子野",
      "content": [
        "千葩开欲休，独客思悠悠。",
        "江水能相隔，春风不共游。",
        "数篇诗未答，一幅信重收。",
        "多少怀君意，鶑声高树头。"
      ],
      "author": {
        "id": 7098,
        "name": "翁卷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 80321,
      "title": "赠张亦",
      "content": [
        "兴兵又罢兵，策士耻无名。",
        "闲见秋风起，犹生万里情。",
        "借窗临水歇，沽酒对花倾。",
        "示我新诗卷，如编众玉成。"
      ],
      "author": {
        "id": 7098,
        "name": "翁卷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 80322,
      "title": "寄葛天民",
      "content": [
        "常日已清癯，那兼疾未除。",
        "传来五字好，吟了半年余。",
        "铁柱仙人观，梅花处士庐。",
        "江湖正相隔，岁晚更愁予。"
      ],
      "author": {
        "id": 7098,
        "name": "翁卷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 80323,
      "title": "送卢主簿归吴",
      "content": [
        "湖波长浩荡，苑绿遍幽奇。",
        "皆是全吴地，今非昔代时。",
        "鸱夷无旧舸，泰伯有新祠。",
        "吟苦曾游客，因君动远思。"
      ],
      "author": {
        "id": 7098,
        "name": "翁卷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 80324,
      "title": "题竹",
      "content": [
        "偶种得成阴，翛翛过别林。",
        "月寒双鸽睡，风静一蝉吟。",
        "映地添苔碧，临池觉水深。",
        "贫居来客少，頼尔慰人心。"
      ],
      "author": {
        "id": 7098,
        "name": "翁卷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 80325,
      "title": "晓对",
      "content": [
        "独对晓来晴，天寒景物清。",
        "梅花分地落，井气隔帘生。",
        "曾是吟招隠，何时遂耦耕。",
        "萧疎头上发，已白二三茎。"
      ],
      "author": {
        "id": 7098,
        "name": "翁卷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 80326,
      "title": "暮春病归",
      "content": [
        "朝朝风景添，吾病亦开帘。",
        "洗药花前晒，传方壁上黏。",
        "力微还省语，身老更看髯。",
        "昨日林僧至，茶杯始一拈。"
      ],
      "author": {
        "id": 7098,
        "name": "翁卷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 80327,
      "title": "送徐灵渊永州司理",
      "content": [
        "君向零陵日，分携又雪天。",
        "地遥行几郡，官小度三年。",
        "兰芷芳条洁，潇湘翠色连。",
        "从来苦吟思，归赋若多篇。"
      ],
      "author": {
        "id": 7098,
        "name": "翁卷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 80328,
      "title": "中秋步月",
      "content": [
        "幽兴苦相引，水边行复行。",
        "不知今夜月，曾动几人情。",
        "光逼流萤断，寒侵宿鸟惊。",
        "欲归犹未忍，清露滴三更。"
      ],
      "author": {
        "id": 7098,
        "name": "翁卷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 80329,
      "title": "道上人房老梅",
      "content": [
        "孤高不受埃，老怪昔谁栽。",
        "仙魄乘槎去，龙身带雪来。",
        "数枝寒照水，一点浄沾苔。",
        "头白狂诗客，花时屡往囘。"
      ],
      "author": {
        "id": 7098,
        "name": "翁卷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 80330,
      "title": "寄永州徐三掾曹",
      "content": [
        "闻说居官处，千峰近九疑。",
        "合流皆楚水，高石半唐碑。",
        "香草寒犹绿，清猿夜更悲。",
        "其中多隠者，君去得逢谁。"
      ],
      "author": {
        "id": 7098,
        "name": "翁卷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 80331,
      "title": "书隠者所居",
      "content": [
        "百事已无机，空林不掩扉。",
        "蜂沾朝露出，鹤带晚云归。",
        "石老苔为貌，松寒薜作衣。",
        "山翁与渔父，相过转依依。"
      ],
      "author": {
        "id": 7098,
        "name": "翁卷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 80332,
      "title": "赠不食姑",
      "content": [
        "嫁时衣尚著，忽自欲通仙。",
        "终日常持呪，经年只饮泉。",
        "瘦形非是病，怪语却如颠。",
        "金母还知尔，招邀归洞天。"
      ],
      "author": {
        "id": 7098,
        "name": "翁卷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 80333,
      "title": "送奭公抄化",
      "content": [
        "一锡出林去，风霜前路寒。",
        "自言缘事了，方得此身安。",
        "飘叶随禅步，饥禽傍野餐。",
        "旧房惟有佛，开著任人看。"
      ],
      "author": {
        "id": 7098,
        "name": "翁卷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 80334,
      "title": "能仁寺",
      "content": [
        "芙蓉峰入天，寺与此峰连。",
        "得见是冬月，要来从昔年。",
        "寒潭盛塔影，古木带厨烟。",
        "偶值高僧出，禅床坐默然。"
      ],
      "author": {
        "id": 7098,
        "name": "翁卷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 80335,
      "title": "赠东庵约公",
      "content": [
        "问今年八十，退院久清闲。",
        "白雪髭慵剃，青松户早关。",
        "取泉来煮茗，与客话游山。",
        "弟子何僧是，缁衣多往还。"
      ],
      "author": {
        "id": 7098,
        "name": "翁卷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 80336,
      "title": "石门庵",
      "content": [
        "山到极深处，石门为地岚蒸空寺坏，雪压小庵清。",
        "果落群猿拾，林昏独虎行。",
        "一僧何所得，高坐若无情。"
      ],
      "author": {
        "id": 7098,
        "name": "翁卷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 80337,
      "title": "宝冠寺",
      "content": [
        "山多猿鸟群，永日绝嚣氛。",
        "一涧水流出，几房僧共闻。",
        "拄筇黏落叶，拂石动寒云。",
        "谁昔来营此，寻碑看记文。"
      ],
      "author": {
        "id": 7098,
        "name": "翁卷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 80338,
      "title": "寄山友徐灵晖",
      "content": [
        "若非殊俗好，那肯爱幽居。",
        "深径无来客，空山自读书。",
        "树蝉经雨少，门柳望秋疎。",
        "相忆何时去，闲园共尔锄。"
      ],
      "author": {
        "id": 7098,
        "name": "翁卷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 80339,
      "title": "陈西老母氏挽词",
      "content": [
        "八十余年寿，孀居备苦辛。",
        "成家无别物，有子作诗人。",
        "远客移书吊，新坟得佛邻。",
        "秋堂挂遗像，癯若在时身。"
      ],
      "author": {
        "id": 7098,
        "name": "翁卷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 80340,
      "title": "题常州独孤桧",
      "content": [
        "此桧何时种，相传是独孤。",
        "年深成古物，名重入州图。",
        "老节坚难蠹，皴皮裂似枯。",
        "托根列帝庙，应不虑樵夫。"
      ],
      "author": {
        "id": 7098,
        "name": "翁卷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 80341,
      "title": "哭徐山民",
      "content": [
        "已是穷侵骨，何期早丧身。",
        "分明上天意，磨折苦吟人。",
        "花色连晴昼，鶑声在近邻。",
        "谁怜三尺像，犹带瘦精神。"
      ],
      "author": {
        "id": 7098,
        "name": "翁卷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 80342,
      "title": "秋日闲居呈赵端行",
      "content": [
        "闲居观物化，几叶又飞东。",
        "清气全归月，寒声半是风。",
        "病多怜骨瘦，吟苦笑身穷。",
        "折得邻家菊，还思靖节翁。"
      ],
      "author": {
        "id": 7098,
        "name": "翁卷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 80343,
      "title": "送姚主簿归龙溪",
      "content": [
        "三考今批足，应无愧此心。",
        "只将零月俸，买得一张琴。",
        "归处路犹远，到时冬必深。",
        "邑丞诗极好，闲暇可相寻。"
      ],
      "author": {
        "id": 7098,
        "name": "翁卷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 80344,
      "title": "送蒋德瞻节推",
      "content": [
        "八百里重湖，长涵太古波。",
        "君山云出少，梦泽雨来多。",
        "才子今方去，名楼必屡过。",
        "楚辞休要学，易得怨伤和。"
      ],
      "author": {
        "id": 7098,
        "name": "翁卷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 80345,
      "title": "赠滕处士",
      "content": [
        "识君戎马际，今叉十年余。",
        "环海才安息，先生便隠居。",
        "清风三亩宅，白日一床书。",
        "长是闲门掩，邻僧亦不如。"
      ],
      "author": {
        "id": 7098,
        "name": "翁卷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 80346,
      "title": "送赵明叔明府",
      "content": [
        "随行惟一琴，前路足幽寻。",
        "今夜维舟处，何村隔树林。",
        "鸿声秋浦冷，雨气海山深。",
        "若问三年政，知君尽此心。"
      ],
      "author": {
        "id": 7098,
        "name": "翁卷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 80347,
      "title": "初晴道中",
      "content": [
        "初晴残湿在，众树碧光鲜。",
        "幽鹭窥泉立，闲童跨犊眠。",
        "依山知有寺，过水恨无船。",
        "石路是谁作，姓名岩上镌。"
      ],
      "author": {
        "id": 7098,
        "name": "翁卷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 80348,
      "title": "福州黄檗寺",
      "content": [
        "天下两黄檗，此中山是真。",
        "碑看前代刻，僧值故乡人。",
        "一宿禅房雨，经时客路尘。",
        "将行更瞻礼，十二祖师身。"
      ],
      "author": {
        "id": 7098,
        "name": "翁卷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 80349,
      "title": "送翁应叟",
      "content": [
        "逢君亦姓翁，莫即是吾宗。",
        "远自刺桐里，来看孤屿峰。",
        "虽云相识晚，宛若故情浓。",
        "囘首秋风路，闽山复几重。"
      ],
      "author": {
        "id": 7098,
        "name": "翁卷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 80350,
      "title": "处州苍岭",
      "content": [
        "步步蹑飞云，初疑梦里身。",
        "村鸡数声远，山舍几家邻。",
        "不雨溪长急，非春树亦新。",
        "自从开此岭，便有客行人。"
      ],
      "author": {
        "id": 7098,
        "name": "翁卷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 80351,
      "title": "题武义赵提干林亭",
      "content": [
        "武陵诸胜状，如列在簷前。",
        "一郭楼台日，数村桑柘烟。",
        "鸟啼春满谷，秧绿水平田。",
        "中有渔樵影，吾诗咏不全。"
      ],
      "author": {
        "id": 7098,
        "name": "翁卷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 80352,
      "title": "春雪",
      "content": [
        "疑是梨花发，满园惊乍看。",
        "不能为腊瑞，空自作春寒。",
        "远遁营巢鹊，深埋吐叶兰。",
        "从教艳阳晒，流去作波澜。"
      ],
      "author": {
        "id": 7098,
        "name": "翁卷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 80353,
      "title": "即事",
      "content": [
        "省饮不成醉，牢愁将奈何。",
        "晚烟云半杂，春雪雨相和。",
        "巷湿人行少，空寒雁叫多。",
        "凭栏思无极，怀古谩悲歌。"
      ],
      "author": {
        "id": 7098,
        "name": "翁卷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 80354,
      "title": "题王法师房",
      "content": [
        "应有列仙至，观当灵洞安。",
        "月萝春长蔓，风竹暮生寒。",
        "印下鬼神役，鼎交龙虎欢。",
        "寻常应缘外，多把异书看。"
      ],
      "author": {
        "id": 7098,
        "name": "翁卷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 80355,
      "title": "赠鲍居士",
      "content": [
        "日日湖波畔，群鸥相共闲。",
        "全家皆好佛，独坐或看山。",
        "晒药嫌云在，留僧带月还。",
        "有时乘小艇，忽入到城间。"
      ],
      "author": {
        "id": 7098,
        "name": "翁卷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 80356,
      "title": "哭徐玑",
      "content": [
        "前时官上归，感怆失灵晖。",
        "不料三年后，俱随万化非。",
        "塔峰长入座，池色自临扉。",
        "无复乘闲屐，观棋访衲衣。"
      ],
      "author": {
        "id": 7098,
        "name": "翁卷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 80357,
      "title": "赠孙季蕃",
      "content": [
        "立谈飞絮中，相遇在吴宫。",
        "以我为生拙，怜君失计同。",
        "醉酣花落月，吟苦竹摇风。",
        "自作庐山记，幽奇欲遍穷。"
      ],
      "author": {
        "id": 7098,
        "name": "翁卷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 80358,
      "title": "周南仲挽词",
      "content": [
        "志以古人期，今人焉得知。",
        "学非无用处，命自不逢时。",
        "华省官如梦，闲居谤亦随。",
        "丧君于此日，师友最相悲。"
      ],
      "author": {
        "id": 7098,
        "name": "翁卷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 80359,
      "title": "寄张直翁",
      "content": [
        "若向筠州去，惟消一日宽。",
        "又无他事阻，自欲访君难。",
        "露下秋山洁，鸿飞楚水寒。",
        "近诗凡几首，专待写来看。"
      ],
      "author": {
        "id": 7098,
        "name": "翁卷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 80360,
      "title": "赠刘高士",
      "content": [
        "灵境康庐上，师曾此处家。",
        "今游在京国，谁为管烟霞。",
        "觅句行逢鹤，持经坐对花。",
        "笑予非酒户，相劝满瓯茶。"
      ],
      "author": {
        "id": 7098,
        "name": "翁卷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 80361,
      "title": "送曹西士宰建昌",
      "content": [
        "买得秋风棹，江行不问程。",
        "谁知书判笔，中有惠慈情。",
        "旧治川僧说，新衔楚吏迎。",
        "名山皆在望，应费好诗评。"
      ],
      "author": {
        "id": 7098,
        "name": "翁卷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 80362,
      "title": "送刘成道",
      "content": [
        "客中仍送客，羸病若为心。",
        "沿路万千景，费君多少吟。",
        "出门梅雨滑，浮棹浙河深。",
        "莫放旅愁起，闻蝉思旧林。"
      ],
      "author": {
        "id": 7098,
        "name": "翁卷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 80363,
      "title": "舟行寄赵端行",
      "content": [
        "离亭一分手，便送钓船行。",
        "虽是暂相别，那能忘此情。",
        "花飞春已老，云散晚方晴。",
        "诗句空吟得，无人可共评。"
      ],
      "author": {
        "id": 7098,
        "name": "翁卷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 80364,
      "title": "送人游天台",
      "content": [
        "暂游行李少，几日到天台。",
        "船带落潮发，月从前浦来。",
        "花源香不断，药地绿成堆。",
        "莫学他刘阮，经年忘却囘。"
      ],
      "author": {
        "id": 7098,
        "name": "翁卷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 80365,
      "title": "送徐评事赴省试",
      "content": [
        "早年通法后，已是立朝身。",
        "更道明经好，须为擢第人。",
        "马寒村驿暮，灯暖帝城春。",
        "花气多时节，高门有贺宾。"
      ],
      "author": {
        "id": 7098,
        "name": "翁卷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 80366,
      "title": "友人林居",
      "content": [
        "花石与林庐，皆非俗者居。",
        "铺沙为径软，因竹夹篱疎。",
        "留客同家食，教儿诵古书。",
        "常言治生意，只欲似樵渔。"
      ],
      "author": {
        "id": 7098,
        "name": "翁卷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 80367,
      "title": "送吉水包长官",
      "content": [
        "不耻身为令，惟存济物心。",
        "离家春雨足，入境夏苗深。",
        "吉字水初识，洞岩仙可寻。",
        "知君修浄化，白日只弹琴。"
      ],
      "author": {
        "id": 7098,
        "name": "翁卷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 80368,
      "title": "送赵嗣勋签书昭庆军幕",
      "content": [
        "当时一万言，亲擢自临轩。",
        "况有从前例，难辞不次恩。",
        "下峰云带寺，震泽水浮村。",
        "多少闻名者，争来识状元。"
      ],
      "author": {
        "id": 7098,
        "name": "翁卷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 80369,
      "title": "送周子静桂阳教官",
      "content": [
        "魁名人共说，直节世间闻。",
        "远地今崇学，诸生久待君。",
        "三湘鸿不到，五岭路初分。",
        "闲日登临作，应题赠屈文。"
      ],
      "author": {
        "id": 7098,
        "name": "翁卷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 80370,
      "title": "京口即事",
      "content": [
        "长流当下流，铁瓮此为州。",
        "前代多名迹，闲人欲遍游。",
        "夕阳波上寺，明月戍边楼。",
        "一曲渔家笛，生予无限愁。"
      ],
      "author": {
        "id": 7098,
        "name": "翁卷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 80371,
      "title": "赠熊炼师",
      "content": [
        "松边自掩扉，卖药罢方归。",
        "教客认仙草，笑人求紫衣。",
        "惜琴眠处放，玩易语时稀。",
        "见说沅砂贱，闲身去欲飞。"
      ],
      "author": {
        "id": 7098,
        "name": "翁卷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 80372,
      "title": "宿寺",
      "content": [
        "一宿此禅宫，身同落发翁。",
        "深窗难得月，老屋易生风。",
        "灯冷纱光淡，香残印篆空。",
        "独怜吟思苦，妨却梦西东。"
      ],
      "author": {
        "id": 7098,
        "name": "翁卷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 80373,
      "title": "留别吴中诸士友",
      "content": [
        "羁游虽不闲，幽思亦相关。",
        "今日经行处，他宵梦寐间。",
        "松江云在水，茂苑树成山。",
        "况复多吟客，令人懒欲还。"
      ],
      "author": {
        "id": 7098,
        "name": "翁卷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 80374,
      "title": "南涧寻韩仲止不遇",
      "content": [
        "树树有佳阴，山蝉不住吟。",
        "掬来南涧水，清若主人心。",
        "屋上云飞冷，篱根藓积深。",
        "留诗在岩壁，明日更相寻。"
      ],
      "author": {
        "id": 7098,
        "name": "翁卷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 80375,
      "title": "送于君锡节推",
      "content": [
        "历历渡遥程，仙山向赤城。",
        "同为忆家者，岂不羡君行。",
        "岁晚梅花白，天寒楚塞清。",
        "野人诗一首，相送莫言轻。"
      ],
      "author": {
        "id": 7098,
        "name": "翁卷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 80376,
      "title": "赠张韩伯",
      "content": [
        "暂得共论文，依然踪迹分。",
        "春来若为况，避远不相闻。",
        "一路水兼石，万重山隔云。",
        "何由比明月，到处可逢君。"
      ],
      "author": {
        "id": 7098,
        "name": "翁卷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 80377,
      "title": "秋居寄西里君",
      "content": [
        "每日看山山上立，满山风日又秋来。",
        "贫家岁计惟收菊，幽径时常不扫苔。",
        "新得酒方思欲试，旧存吟轴见还开。",
        "凉天在处清如水，能赋慙无宋玉才。"
      ],
      "author": {
        "id": 7098,
        "name": "翁卷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 80378,
      "title": "鲍使君闲居",
      "content": [
        "吟楼影在湖波上，吟景长从望处生。",
        "叠石拟成幽嶂色，种松移得远滩声。",
        "多谙药品曾因病，却著荷衣欲避名。",
        "闻说近来心更静，案头惟有一琴横。"
      ],
      "author": {
        "id": 7098,
        "name": "翁卷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 80379,
      "title": "山中",
      "content": [
        "山中凡事幸相宜，第一红尘免上衣。",
        "寻药每同丹客去，拾薪多趁牧儿归。",
        "鸣泉潄石寒蒲洁，宿雾蒸泥早蕨肥。",
        "不奈邻峰学禅伴，时时来此叩岩扉。"
      ],
