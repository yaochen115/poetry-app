{
  "data": [
    {
      "id": 336238,
      "title": "奉和春初幸太平公主南庄应制",
      "content": [
        "青门路接凤凰台，素浐宸游龙骑来。",
        "涧草自迎香辇合，",
        "此日侍臣将石去，共欢明主赐金回。"
      ],
      "author": {
        "id": 8710,
        "name": "宋之问"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 336239,
      "title": "三阳宫侍宴应制得幽字",
      "content": [
        "离宫秘苑胜瀛洲，别有仙人洞壑幽。",
        "岩边树色含风冷，",
        "微臣昔忝方明御，今日还陪八骏游。"
      ],
      "author": {
        "id": 8710,
        "name": "宋之问"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 336240,
      "title": "奉和晦日幸昆明池应制",
      "content": [
        "春豫灵池会，沧波帐殿开。",
        "舟凌石鲸度，槎拂斗牛回。",
        "节晦蓂全落，春迟柳暗催。",
        "象溟看浴景，烧劫辨沉灰。",
        "镐饮周文乐，汾歌汉武才。",
        "不愁明月尽，自有夜珠来。"
      ],
      "author": {
        "id": 8710,
        "name": "宋之问"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 336241,
      "title": "奉和幸大荐福寺",
      "content": [
        "香刹中天起，宸游满路辉。",
        "乘龙太子去，驾象法王归。",
        "殿饰金人影，窗摇玉女扉。",
        "稍迷新草木，遍识旧庭闱。",
        "水入禅心定，云从宝思飞。",
        "欲知皇劫远，初拂六铢衣。"
      ],
      "author": {
        "id": 8710,
        "name": "宋之问"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 336244,
      "title": "奉和幸神皋亭应制",
      "content": [
        "清跸喧黄道，乘舆降紫宸。",
        "霜戈凝晓日，云管发阳春。",
        "台古全疑汉，林余半识秦。",
        "宴酣诗布泽，节改令行仁。",
        "昔恃山河险，今依道德淳。",
        "多惭献嘉颂，空累属车尘。"
      ],
      "author": {
        "id": 8710,
        "name": "宋之问"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 336246,
      "title": "奉和幸韦嗣立山庄侍宴应制",
      "content": [
        "枢掖调梅暇，林园艺槿初。",
        "入朝荣剑履，退食偶琴书。",
        "地隐东岩室，天回北斗车。",
        "旌门临窈窕，辇道属扶疏。",
        "云罕明丹壑，霜笳彻紫虚。",
        "水疑投石处，溪似钓璜余。",
        "帝泽颁卮酒，人欢颂里闾。",
        "一承黄竹咏，长奉白茅居。"
      ],
      "author": {
        "id": 8710,
        "name": "宋之问"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 336247,
      "title": "扈从登封告成颂应制",
      "content": [
        "御路回中岳，天营接下都。",
        "百灵无后至，万国竞前驱。",
        "文卫严清跸，幽仙读宝符。",
        "贝花明汉果，芝草入尧厨。",
        "济济衣冠会，喧喧夷夏俱。",
        "宗禋仰神理，刊木望川途。",
        "抚己贫非病，时来本不愚。",
        "愿陪丹凤辇，率舞白云衢。"
      ],
      "author": {
        "id": 8710,
        "name": "宋之问"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 336248,
      "title": "宴安乐公主宅得空字",
      "content": [
        "英藩筑外馆，爱主出王宫。",
        "宾至星槎落，仙来月宇空。",
        "玳梁翻贺燕，金埒倚晴虹。",
        "箫奏秦台里，书开鲁壁中。",
        "短歌能驻日，艳舞欲娇风。",
        "闻有淹留处，山阿满桂丛。"
      ],
      "author": {
        "id": 8710,
        "name": "宋之问"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 336250,
      "title": "和姚给事寓直之作",
      "content": [
        "清论满朝阳，高才拜夕郎。",
        "还从避马路，来接珥貂行。",
        "宠就黄扉日，威回白简霜。",
        "柏台迁鸟茂，兰署得人芳。",
        "禁静钟初彻，更疏漏渐长。",
        "晓河低武库，流火度文昌。",
        "寓直恩徽重，乘秋藻翰扬。",
        "暗投空欲报，下调不成章。"
      ],
      "author": {
        "id": 8710,
        "name": "宋之问"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 336251,
      "title": "和库部李员外秋夜寓直之作",
      "content": [
        "相庭贻庆远，才子拜郎初。",
        "起草徯仙阁，焚香卧直庐。",
        "更深河欲断，节劲柳偏疏。",
        "气耿凌云笔，心摇待漏车。",
        "叨荣厕俦侣，省己恧空虚。",
        "徒斐阳春和，难参丽曲余。"
      ],
      "author": {
        "id": 8710,
        "name": "宋之问"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 336252,
      "title": "酬李丹徒见赠之作",
      "content": [
        "镇吴称奥里，试剧仰通才。",
        "近挹人披雾，遥闻境震雷。",
        "一朝逢解榻，累日共衔杯。",
        "连辔登山尽，浮舟望海回。",
        "以予惭拙宦，期子遇良媒。",
        "赠曲南凫断，征途北雁催。",
        "更怜江上月，还入镜中开。"
      ],
      "author": {
        "id": 8710,
        "name": "宋之问"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 336255,
      "title": "送合宫苏明府颋",
      "content": [
        "铉府诞英规，公才天下知。",
        "谓乘羔雁族，继入凤凰池。",
        "赤县求人隐，青门起路岐。",
        "翟回车少别，凫化舄遥驰。",
        "神哭周南境，童歌渭北垂。",
        "贤哉荀奉倩，衮职伫来仪。"
      ],
      "author": {
        "id": 8710,
        "name": "宋之问"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 336256,
      "title": "送杨六望赴金水",
      "content": [
        "借问梁山道，嵚岑几万重。",
        "遥州刀作字，绝壁剑为峰。",
        "惜别路穷此，留欢意不从。",
        "忧来生白发，时晚爱青松。",
        "勿以西南远，夷歌寝盛容。",
        "台阶有高位，宁复久临邛。"
      ],
      "author": {
        "id": 8710,
        "name": "宋之问"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 336258,
      "title": "入泷州江",
      "content": [
        "孤舟泛盈盈，江流日纵横。",
        "夜杂蛟螭寝，晨披瘴疠行。",
        "潭蒸水沫起，山热火云生。",
        "猿躩时能啸，鸢飞莫敢鸣。",
        "海穷南徼尽，乡远北魂惊。",
        "泣向文身国，悲看凿齿氓。",
        "地偏多育蛊，风恶好相鲸。",
        "余本岩栖客，悠哉慕玉京。",
        "厚恩尝愿答，薄宦不祈成。",
        "违隐乖求志，披荒为近名。",
        "镜愁玄发改，心负紫芝荣。",
        "运启中兴历，时逢外域清。",
        "只应保忠信，延促付神明。"
      ],
      "author": {
        "id": 8710,
        "name": "宋之问"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 336263,
      "title": "发藤州",
      "content": [
        "朝夕苦遄征，孤魂长自惊。",
        "泛舟依雁渚，投馆听猿鸣。",
        "石发缘溪蔓，林衣扫地轻。",
        "云峰刻不似，苔藓画难成。",
        "露裛千花气，泉和万籁声。",
        "攀幽红处歇，跻险绿中行。",
        "恋切芝兰砌，悲缠松柏茔。",
        "丹心江北死，白发岭南生。",
        "魑魅天边国，穷愁海上城。",
        "劳歌意无限，今日为谁明。"
      ],
      "author": {
        "id": 8710,
        "name": "宋之问"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 336265,
      "title": "游法华寺",
      "content": [
        "高岫拟耆阇，真乘引妙车。",
        "空中结楼殿，意表出云霞。",
        "后果缠三足，前因感六牙。",
        "宴林熏宝树，水溜滴金沙。",
        "寒谷梅犹浅，温庭橘未华。",
        "台香红药乱，塔影绿篁遮。",
        "果渐轮王族，缘超梵帝家。",
        "晨行踏忍草，夜诵得灵花。",
        "江郡将何匹，天都亦未加。",
        "朝来沿泛所，应是逐仙槎。"
      ],
      "author": {
        "id": 8710,
        "name": "宋之问"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 336266,
      "title": "夜渡吴松江怀古",
      "content": [
        "宿帆震泽口，晓渡松江𣸣。",
        "棹发鱼龙气，舟冲鸿雁群。",
        "寒潮顿觉满，暗浦稍将分。",
        "气出海生日，光清湖起云。",
        "水乡尽天卫，叹息为吴君。",
        "谋士伏剑死，至今悲所闻。"
      ],
      "author": {
        "id": 8710,
        "name": "宋之问"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 336267,
      "title": "谒禹庙",
      "content": [
        "夏王乘四载，兹地发金符。",
        "峻命终不易，报功畴敢渝。",
        "先驱总昌会，后至伏灵诛。",
        "玉帛空天下，衣冠照海隅。",
        "旋闻厌黄屋，更道出苍梧。",
        "林表祠转茂，山阿井讵枯。",
        "舟迁龙负壑，田变鸟芸芜。",
        "旧物森如在，天威肃未殊。",
        "玄夷届瑶席，玉女侍清都。",
        "奕奕扃闱邃，轩轩仗卫趋。",
        "气青连曙海，云白洗春湖。",
        "猿啸有时答，禽言常自呼。",
        "灵歆异蒸糈，至乐匪笙竽。",
        "茅殿今文袭，梅梁古制无。",
        "运遥日崇丽，业盛答昭苏。",
        "伊昔力云尽，而今功尚敷。",
        "揆材非美箭，精享愧生刍。",
        "郡职昧为理，邦空宁自诬。",
        "下车霰已积，摄事露行濡。",
        "人隐冀多佑，曷唯沾薄躯。"
      ],
      "author": {
        "id": 8710,
        "name": "宋之问"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 336268,
      "title": "游禹穴回出若邪",
      "content": [
        "禹穴今朝到，邪溪此路通。",
        "著书闻太史，炼药有仙翁。",
        "鹤往笼犹挂，龙飞剑已空。",
        "石帆摇海上，天镜落湖中。",
        "水低寒云白，山边坠叶红。",
        "归舟何虑晚，日暮使樵风。"
      ],
      "author": {
        "id": 8710,
        "name": "宋之问"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 336269,
      "title": "灵隐寺",
      "content": [
        "鹫岭郁岧峣，龙宫锁寂寥。",
        "楼观沧海日，门对浙江潮。",
        "桂子月中落，天香云外飘。",
        "扪萝登塔远，刳木取泉遥。",
        "霜薄花更发，冰轻叶未凋。",
        "夙龄尚遐异，搜对涤烦嚣。",
        "待入天台路，看余度石桥。"
      ],
      "author": {
        "id": 8710,
        "name": "宋之问"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 336270,
      "title": "游云门寺",
      "content": [
        "维舟探静域，作礼事尊经。",
        "投迹一萧散，为心自杳冥。",
        "龛依大禹穴，楼倚少微星。",
        "遝嶂围兰若，回溪抱竹庭。",
        "觉花涂砌白，甘露洗山青。",
        "雁塔鶱金地，虹桥转翠屏。",
        "人天宵现景，神鬼昼潜形。",
        "理胜常虚寂，缘空自感灵。",
        "入禅从鸽绕，说法有龙听。",
        "劫累终期灭，尘躬且未宁。",
        "摇摇不安寐，待月咏岩扃。"
      ],
      "author": {
        "id": 8710,
        "name": "宋之问"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 336272,
      "title": "早入清远峡",
      "content": [
        "传闻峡山好，旭日棹前沂。",
        "雨色摇丹嶂，泉声聒翠微。",
        "两岩天作带，万壑树披衣。",
        "秋菊迎霜序，春藤碍日辉。",
        "翳潭花似织，缘岭竹成围。",
        "寂历环沙浦，葱茏转石圻。",
        "露余江未热，风落瘴初稀。",
        "猿饮排虚上，禽惊掠水飞。",
        "榜童夷唱合，樵女越吟归。",
        "良候斯为美，边愁自有违。",
        "谁言望乡国，流涕失芳菲。"
      ],
      "author": {
        "id": 8710,
        "name": "宋之问"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 336273,
      "title": "发端州初入西江",
      "content": [
        "问我将何去，清晨溯越溪。",
        "翠微悬宿雨，丹壑饮晴霓。",
        "树影捎云密，藤阴覆水低。",
        "潮回出浦驶，洲转望乡迷。",
        "人意长怀北，江行日向西。",
        "破颜看鹊喜，拭泪听猿啼。",
        "骨肉初分爱，亲朋忽解携。",
        "路遥魂欲断，身辱理能齐。",
        "畴日三山意，于兹万绪暌。",
        "金陵有仙馆，即事寻丹梯。"
      ],
      "author": {
        "id": 8710,
        "name": "宋之问"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 336277,
      "title": "题鉴上人房二首",
      "content": [
        "落花双树积，芳草一庭春。",
        "玩之堪兴异，何必见幽人。",
        "晚入应真理，经行尚未回。",
        "房中无俗物，林下有青苔。"
      ],
      "author": {
        "id": 8710,
        "name": "宋之问"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 336278,
      "title": "答田征君",
      "content": [
        "山游杳何处，迟回伊洛间。",
        "归寝忽成梦，宛在嵩丘山。"
      ],
      "author": {
        "id": 8710,
        "name": "宋之问"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 336279,
      "title": "伤曹娘二首",
      "content": [
        "凤飞楼伎绝，鸾死镜台空。",
        "独怜脂粉气，犹著舞衣中。",
        "河伯怜娇态，冯夷要姝妓。",
        "寄言游戏人，莫弄黄河水。"
      ],
      "author": {
        "id": 8710,
        "name": "宋之问"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 336281,
      "title": "燕巢军幕",
      "content": [
        "非关怜翠幕，不是厌朱楼。",
        "故来呈燕颔，报导欲封侯。"
      ],
      "author": {
        "id": 8710,
        "name": "宋之问"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 336286,
      "title": "伤曹娘二首",
      "content": [
        "可怜冥漠去何之，独立丰茸无见期。",
        "君看水上芙蓉色，恰似生前歌舞时。",
        "前溪妙舞今应尽，子夜新歌遂不传。",
        "无复绮罗娇白日，直将珠玉闭黄泉。"
      ],
      "author": {
        "id": 8710,
        "name": "宋之问"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 336287,
      "title": "郡宅中斋",
      "content": [
        "郡宅枕层岭，春湖绕芳甸。",
        "云甍出万家，卧览皆已遍。",
        "渔商汗成雨，廨邑明若练。",
        "越俗镜中行，夏祠云表见。",
        "兹都信盘郁，英远常栖眄。",
        "王子事黄老，独乐恣游衍。",
        "谢公念苍生，同忧感推荐。",
        "灵越多秀士，运阔无由面。",
        "神理翳青山，风流满黄卷。",
        "揆予谬承奖，自昔从缨弁。",
        "瑶水执仙羁，金闺负时选。",
        "晨趋博望苑，夜直明光殿。",
        "一朝罢台阁，万里违乡县。",
        "风土足慰心，况悦年芳变。",
        "淮廪伫滋实，沂歌非所羡。",
        "讼寝归四明，龄颓亲九转。",
        "微尚本江海，少留岂交战。",
        "唯余后凋色，窃比东南箭。"
      ],
      "author": {
        "id": 8710,
        "name": "宋之问"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 336289,
      "title": "新年作",
      "content": [
        "乡心新岁切，天畔独潸然。",
        "老至居人下，春归在客先。",
        "岭猿同旦暮，江柳共风烟。",
        "已似长沙傅，从今又几年。"
      ],
      "author": {
        "id": 8710,
        "name": "宋之问"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 336290,
      "title": "剪彩",
      "content": [
        "驻想持金错，居然作管灰。",
        "绮罗纤手制，桃李向春开。",
        "拾藻蜂初泊，衔花鸟未回。",
        "不言将巧笑，翻逐美人来。"
      ],
      "author": {
        "id": 8710,
        "name": "宋之问"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 336291,
      "title": "七夕",
      "content": [
        "传道仙星媛，年年会水隅。",
        "停梭借蟋蟀，留巧付蜘蛛。",
        "去昼从云请，归轮伫日输。",
        "莫言相见阔，天上日应殊。"
      ],
      "author": {
        "id": 8710,
        "name": "宋之问"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 336293,
      "title": "和赵员外桂阳桥遇佳人",
      "content": [
        "江雨朝飞浥细尘，阳桥花柳不胜春。",
        "金鞍白马来从赵，",
        "荡舟为乐非吾事，自叹空闺梦寐频。"
      ],
      "author": {
        "id": 8710,
        "name": "宋之问"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 336294,
      "title": "函谷关",
      "content": [
        "至人□□识仙风，瑞霭丹光远郁葱。",
        "灵迹才辞周柱下，",
        "欲访乘牛求宝箓，愿随鹤驾遍瑶空。"
      ],
      "author": {
        "id": 8710,
        "name": "宋之问"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    }
