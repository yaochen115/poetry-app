{
  "data": [
    {
      "id": 281000,
      "title": "过四皓庙",
      "content": [
        "东西南北人，高迹自相亲。",
        "天下已归汉，山中犹避秦。",
        "龙楼曾作客，鹤氅不为臣。",
        "独有千年后，青青庙木春。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 281001,
      "title": "陕下怀归",
      "content": [
        "故园何处在，零落五湖东。",
        "日暮无来客，天寒有去鸿。",
        "大河冰彻塞，高岳雪连空。",
        "独夜悬归思，迢迢永漏中。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 281002,
      "title": "送徐处士归江南",
      "content": [
        "行行野雪薄，寒气日通春。",
        "故国又芳草，沧江终白身。",
        "游归花落满，睡起鸟啼新。",
        "莫惜闲书札，西来问旅人。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 281003,
      "title": "鄜州留别王从事",
      "content": [
        "相识未十日，相知如十年。",
        "从来易离别，此去忽留连。",
        "路险行冲雨，山高度隔天。",
        "难终清夜坐，更听说安边。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 281004,
      "title": "长安夜怀",
      "content": [
        "匹马西游日，从吴又转荆。",
        "风雷几夜坐，山水半年行。",
        "梦永秋灯灭，吟余晓露明。",
        "良时不我与，白发向秦生。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 281005,
      "title": "冬夜山中寻友",
      "content": [
        "何人山雪夜，相访不相思。",
        "若得长闲日，应无暂到时。",
        "叶寒凋欲尽，泉冻落还迟。",
        "即此天明去，重来未有期。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 281006,
      "title": "送刘山人归洞庭",
      "content": [
        "君逐云山去，人间又绝踪。",
        "半湖乘早月，中路入疎钟。",
        "秋尽草虫急，夜深山雨重。",
        "平生心未已，岂得更相从。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 281007,
      "title": "古意",
      "content": [
        "白马游何处，青楼日正长。",
        "凤箫抛旧曲，鸾镜嬾新妆。",
        "玄鸟深巢静，飞花入户香。",
        "虽非窦滔妇，锦字已成章。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 281008,
      "title": "避暑",
      "content": [
        "当暑忆归林，陶家借柳阴。",
        "蝉从初伏噪，客向晚凉吟。",
        "白日欺玄鬓，沧江负素心。",
        "神仙倘有术，引我出幽岑。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 281009,
      "title": "送吴秘书归杭州",
      "content": [
        "为客得从容，官清料复重。",
        "海崖归有业，天目近何峰。",
        "是处通春棹，无村不夜舂。",
        "马卿夸贵达，还说返临邛。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 281010,
      "title": "中秋对月",
      "content": [
        "秋分一夜停，阴魄最晶荧。",
        "好是生沧海，徐看历杳冥。",
        "层空疑洗色，万怪想潜形。",
        "他夕无相类，晨鸡不可听。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 281011,
      "title": "八月上峡",
      "content": [
        "万里巴江水，秋来满峡流。",
        "乱山无陆路，行客在孤舟。",
        "汹汹滩声急，冥冥树色愁。",
        "免为三不吊，已白一生头。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 281012,
      "title": "送狄明府赴九江",
      "content": [
        "字人修祖德，清白定闻传。",
        "匹马从秦去，孤帆入楚悬。",
        "关中寒食雨，湖上暑衣天。",
        "四考兼重请，相知住几年。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 281013,
      "title": "陕下投姚谏议",
      "content": [
        "旧业在东鄙，西游从楚荆。",
        "风雷几夜坐，山水半年行。",
        "梦永秋灯灭，吟孤晓露明。",
        "前心若不遂，有耻却归耕。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 281014,
      "title": "关东逢薛能",
      "content": [
        "何处不相思，相逢还有时。",
        "交心如到老，会面未为迟。",
        "苦学缘明代，劳生欲白髭。",
        "唯君一度别，便似见无期。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 281015,
      "title": "富春赠孙璐",
      "content": [
        "天柱与天目，曾栖绝顶房。",
        "青云求禄晚，白日坐家长。",
        "井气通潮信，牕风引海凉。",
        "平生诗称在，老达亦何妨。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 281016,
      "title": "送友人游蜀",
      "content": [
        "东堂虽不捷，西去复何愁。",
        "蜀马知归路，巴山似旧游。",
        "星临劒阁动，花落锦江流。",
        "鼓吹青林下，时闻祭武侯。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 281017,
      "title": "夏日盩厔郊居寄姚少府",
      "content": [
        "古木有清阴，寒泉有下深。",
        "蝉从初伏噪，客向晚凉吟。",
        "白日欺玄鬓，沧江负素心。",
        "甚思中夜话，何路许相寻。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 281018,
      "title": "送胡休处士归湘江",
      "content": [
        "见说湘江切，长愁有去时。",
        "江湖秋涉远，雷雨夜眠迟。",
        "旧业多归兴，空山尽老期。",
        "天寒一瓢酒，落日醉留谁。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 281019,
      "title": "峡州送清彻上人归浙西",
      "content": [
        "风涛几千里，归路半乘舟。",
        "此地难相遇，何人更共游。",
        "坐经嵩顶夏，行值洛阳秋。",
        "到寺安禅夕，江云满石楼。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 281020,
      "title": "送僧入天台",
      "content": [
        "一锡随缘赴，天台又去登。",
        "长亭旧别路，落日独行僧。",
        "夜烧山何处，秋帆浪几层。",
        "他时授巾拂，莫为老无能。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 281021,
      "title": "回山后寄范酂先辈",
      "content": [
        "高楼会月夜，北雁向南分。",
        "留住经春雪，辞来见夏云。",
        "遥空江不极，绝顶日难曛。",
        "一与山僧坐，无因得议文。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 281022,
      "title": "长安送友人东归",
      "content": [
        "白社思归处，青门见去人。",
        "乡遥茂苑树，路入广陵尘。",
        "海日潮浮晓，湖山雪露春。",
        "犹期来帝里，未是得闲人。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 281023,
      "title": "深秋过源宗上人房",
      "content": [
        "到日值摇落，相留山舍空。",
        "微寒生夜半，积雨向秋终。",
        "度讲多来雁，经禅少候虫。",
        "方从听话后，不省在愁中。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 281024,
      "title": "秋日登山阁",
      "content": [
        "苍苍山阁晚，杳杳隙尘秋。",
        "偶上多时立，翻成尽日愁。",
        "草平连邑动，河满逐江流。",
        "下视穷边路，行人在陇头。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 281025,
      "title": "秋宿慈恩寺遂上人院",
      "content": [
        "满阁终南色，清宵独倚栏。",
        "风高斜汉动，叶下曲江寒。",
        "帝里求名老，空门见性难。",
        "吾师无一事，不似在长安。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 281026,
      "title": "题栖霞寺庆上人院",
      "content": [
        "居与鸟巢邻，日将巢鸟亲。",
        "多生从此性，久集得无身。",
        "树老风终夜，山寒雪见春。",
        "不知诸祖后，传印是何人。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 281027,
      "title": "送友人入蜀",
      "content": [
        "天际蜀门开，西看举别杯。",
        "何人不异礼，上客自怀才。",
        "夜涧青林发，秋江渌水来。",
        "临邛行乐处，莫到白头回。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 281028,
      "title": "赠同官苏明府",
      "content": [
        "山中畿内邑，别觉大夫清。",
        "簿领分王事，官资寄野情。",
        "闲斋无狱讼，隐几向泉声。",
        "从此朝天路，门前是去程。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 281029,
      "title": "送厉图南往荆州觐伯",
      "content": [
        "云水入荆湘，古来鱼鸟乡。",
        "故关重隔远，春日独行长。",
        "山溜含清韵，江雷吐夜光。",
        "郡中词客会，游子更升堂。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 281030,
      "title": "山中夜坐",
      "content": [
        "归家来几夜，倏忽觉秋残。",
        "月满方塘白，风依老树寒。",
        "戏鱼重跃定，惊鸟却栖难。",
        "为有门前路，吾生不得安。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 281031,
      "title": "送台州唐兴陈明府",
      "content": [
        "见说海西隅，山川与俗殊。",
        "宦游如不到，仙分即应无。",
        "瀑布当公署，天台是县图。",
        "遥知为吏去，有术字惸孤。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 281032,
      "title": "夏日过友人檀溪别业",
      "content": [
        "暑天宜野宅，林籁爽泠泠。",
        "沙月邀开户，岩风助扫庭。",
        "鹭栖依绿筿，鱼跃出清萍。",
        "客抱方如醉，因来得暂醒。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 281033,
      "title": "自江上入关",
      "content": [
        "尽室寄沧洲，孤帆独溯流。",
        "天涯心似梦，江上雨兼秋。",
        "文字为人弃，田园被债收。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 281034,
      "title": "冬夜和范秘书宿秘省中作",
      "content": [
        "每日得闲吟，清曹阙下深。",
        "因知遥夜坐，别有远山心。",
        "芸细书中气，松疎雪后阴。",
        "归时高兴足，还复插朝簪。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 281035,
      "title": "送友人游太原",
      "content": [
        "孤帆几日悬，楚客思飘然。",
        "水宿南湖夜，山离旧国年。",
        "秋风高送雁，寒雨入停蝉。",
        "此去勤书札，时常中路传。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 281036,
      "title": "江上居寄山中客",
      "content": [
        "山后与山前，相思隔呌猿。",
        "残云收树末，返照落江源。",
        "苦雨秋涛涨，狂风野火翻。",
        "朝来卖药客，遇我达无言。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 281037,
      "title": "送张郎中赴睦州",
      "content": [
        "青山复渌水，想入富春西。",
        "夹岸清猿去，中流白日低。",
        "美兼华省出，荣共故乡齐。",
        "贱子遥攀送，归心逐马蹄。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 281038,
      "title": "送鄂渚韦尚书赴镇",
      "content": [
        "夏口本吴头，重城据上游。",
        "戈船转江汉，风月宿汀洲。",
        "执宪倾民望，衔恩赴主忧。",
        "谁知旧寮属，攀饯泪仍流。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 281039,
      "title": "送崔侍御书记赴山北座主尚书招辟",
      "content": [
        "书记向丘门，旌幢夹谷尊。",
        "从来游幕意，此去幷酬恩。",
        "雁呌嫌冰合，骢嘶喜雪繁。",
        "同为入室士，不觉别销魂。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 281040,
      "title": "入朝遇雪",
      "content": [
        "霜鬓持霜简，朝天向雪天。",
        "玉阶初辨色，琼树乍相鲜。",
        "密翳空难曙，盈徴瑞不愆。",
        "谁为洛阳客，是日更高眠。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 281041,
      "title": "勉力",
      "content": [
        "日月不并照，升沈俱有时。",
        "自媒徒欲速，孤立却宜迟。",
        "尽力唯求己，公心任遇谁。",
        "人间不得意，半是鬓先衰。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 281042,
      "title": "郊居寄友人",
      "content": [
        "林色树还曛，何时得见君。",
        "独居度永日，相去远浮云。",
        "故疾随秋至，离怀觉夜分。",
        "蛩声非自苦，偏是旅人闻。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 281043,
      "title": "送陆肱归吴兴",
      "content": [
        "雪后江上去，风光故国新。",
        "清浑天气晓，绿动浪花春。",
        "劝酒提壶鸟，乘舟震泽人。",
        "谁知沧海月，取桂却来秦。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 281044,
      "title": "暮秋重过山僧院",
      "content": [
        "却接良宵坐，明河几转流。",
        "安禅逢小暑，抱疾入高秋。",
        "静室闻玄理，深山可白头。",
        "朝朝献林果，亦欲学猕猴。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 281045,
      "title": "送新安少府",
      "content": [
        "南浮虽六月，风水已秋凉。",
        "日乱看江树，身飞逐楚樯。",
        "后期谁可定，临别语空长。",
        "远宦须清苦，幽兰贵独芳。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 281046,
      "title": "送人归吴",
      "content": [
        "何人不归去，君去是闲人。",
        "帝里求相识，山家即近邻。",
        "交情吾道可，离思柳条新。",
        "未饮青门酒，先如醉梦身。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 281047,
      "title": "送姚评事",
      "content": [
        "儒服从戎去，须知胜事全。",
        "使君开幕日，天子偃戈年。",
        "风雨依嵩岭，桑麻接楚田。",
        "新诗随过客，旋满洛阳传。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 281048,
      "title": "题栖云寺立上人院",
      "content": [
        "是法从生有，修持历劫尘。",
        "独居岩下室，长似定中身。",
        "树老风终夜，山寒雪见春。",
        "不知诸祖后，传印是何人。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 281049,
      "title": "黔中罢职过峡州题田使君北楼",
      "content": [
        "巴中初去日，已遇使君留。",
        "及得寻东道，还陪上北楼。",
        "江冲巫峡出，樯过洛宫收。",
        "好是从戎罢，看山觉自由。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 281050,
      "title": "江上送从兄群玉校书东游",
      "content": [
        "逍遥蓬阁吏，才子复诗流。",
        "坟籍因穷览，江湖却纵游。",
        "眠波听戍鼓，饭浦约鱼舟。",
        "处处迎高密，先应扫郡楼。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 281051,
      "title": "宛陵东峰亭与友人话别",
      "content": [
        "坐举天涯目，停杯语日晡。",
        "修篁齐逈槛，列岫限平芜。",
        "乱水通三楚，归帆挂五湖。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 281052,
      "title": "华山寻隐者",
      "content": [
        "自入华山居，关东相见疎。",
        "瓢中谁寄酒，叶上我留书。",
        "巢鸟寒栖尽，潭泉暮冻余。",
        "长闻得药力，此说又何如。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 281053,
      "title": "题荐福寺僧栖白上人院",
      "content": [
        "空门有才子，得道亦吟诗。",
        "内殿频徴入，孤峰久作期。",
        "高名何代比，密行几生持。",
        "长爱乔松院，清凉坐夏时。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 281054,
      "title": "游四明山刘樊二真人祠题山下孙氏居",
      "content": [
        "久在仙坛下，全家是地仙。",
        "池塘来乳洞，禾黍接芝田。",
        "起看青山足，还倾白酒眠。",
        "不知尘世事，双鬓逐流年。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 281055,
      "title": "和太学赵鸿博士归蔡中",
      "content": [
        "得禄从高第，还乡见后生。",
        "田园休问主，词赋已垂名。",
        "扫壁前题出，开窗旧景清。",
        "遥知贤太守，致席日邀迎。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 281056,
      "title": "送寿昌曹明府",
      "content": [
        "惠人须宰邑，为政贵通经。",
        "却用清琴理，犹嫌薄俗听。",
        "涨江晴渐渌，春峤烧还青。",
        "若宿严陵濑，谁当是客星。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 281057,
      "title": "哭贾岛",
      "content": [
        "秦楼吟苦夜，南望只悲君。",
        "一宦终遐徼，千山隔旅坟。",
        "恨声流蜀魄，冤气入湘云。",
        "无限风骚句，时来日夜闻。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 281058,
      "title": "送薛能赴镇徐方",
      "content": [
        "列土人间盛，彭门属九州。",
        "山河天设险，礼乐牧分忧。",
        "皎日为明信，清风占早秋。",
        "虽同郤縠举，郤縠不封侯。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 281059,
      "title": "送鳯翔范书记",
      "content": [
        "西京无暑气，夏景似清秋。",
        "天府来相辟，高人去自由。",
        "江山通蜀国，日月近神州。",
        "若共将军语，河兰地未收。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 281060,
      "title": "岐山逢陕下故人",
      "content": [
        "三秦一会面，二陕久分携。",
        "共忆黄河北，相留白日西。",
        "寄来书少达，别后梦多迷。",
        "早晚期于此，看花听鸟啼。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 281061,
      "title": "送友人陆肱往太原",
      "content": [
        "幷州非故国，君去复寻谁。",
        "猃狁方为寇，嫖姚正用师。",
        "戍烟来自号，边雪下无时。",
        "更想经绵上，应逢禁火期。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 281062,
      "title": "赠李将军",
      "content": [
        "吾宗偏好武，汉代将家流。",
        "走马辞中禁，屯军向渭州。",
        "天心待破虏，阵面许封侯。",
        "却得河源水，方应洗国讐。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 281063,
      "title": "送友人喻坦之归睦州",
      "content": [
        "归心常共知，归路不相随。",
        "彼此无依倚，东西又别离。",
        "山花含雨湿，江树近潮欹。",
        "莫恋渔樵兴，生涯各有为。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 281064,
      "title": "寻华阳隐者",
      "content": [
        "闲却白云居，行踪出去初。",
        "窗中聊取笔，架上独留书。",
        "日背林光冷，潭澄岳影虚。",
        "长闻得药力，此说复何如。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 281065,
      "title": "长安即事",
      "content": [
        "岂得有书名，徒为老帝京。",
        "关中秋气早，雨后夜凉生。",
        "沧海身终泛，青门梦已行。",
        "秦人纵相识，多少别离情。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 281066,
      "title": "送友人游塞北",
      "content": [
        "朔野正秋风，前程见碛鸿。",
        "日西身独远，山转路无穷。",
        "树隔高关断，沙连大漠空。",
        "君看河外将，早晚拟平戎。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 281067,
      "title": "陕府上姚中丞",
      "content": [
        "关东领藩镇，[阙]下授旌旄。",
        "觅句秋吟苦，酬恩夜坐劳。",
        "天开吹角出，木落上楼高。",
        "闲话钱塘郡，半年听海潮。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 281068,
      "title": "送供奉喻炼师归天目山",
      "content": [
        "承恩虽内殿，得道本深山。",
        "举世相看老，孤峰独自还。",
        "溪来青壁里，路在白云间。",
        "绝顶无人住，双峰是旧关。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 281069,
      "title": "之任建安渌溪亭偶作二首 一",
      "content": [
        "入境当春务，农蚕事正殷。",
        "逢溪难饮马，度岭更劳人。",
        "想取烝黎泰，无过赋歛均。",
        "不知成政后，谁是得为邻。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 281070,
      "title": "之任建安渌溪亭偶作二首 二",
      "content": [
        "维舟绿溪岸，绕郡白云峰。",
        "将幕连山起，人家向水重。",
        "短才无独见，长策未相逢。",
        "所幸分尧理，烝民悉可封。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 281071,
      "title": "送侯郎中任新定二首 一",
      "content": [
        "为郎非白头，作牧授沧洲。",
        "江界乘潮入，山川值胜游。",
        "暑气随转扇，凉月傍开楼。",
        "便欲归田里，抛官逐隐侯。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 281072,
      "title": "送侯郎中任新定二首 二",
      "content": [
        "罢郎东出守，半路得浮舟。",
        "大斾行当夏，桐江到未秋。",
        "云闲分岛寺，涛静见沙鸥。",
        "谁伴临清景，吟诗上郡楼。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 281073,
      "title": "送太学吴康仁及第南归",
      "content": [
        "因为太学选，志业彻春闱。",
        "首领诸生出，先登上第归。",
        "一荣犹未已，具庆且应稀。",
        "纵马行青草，临岐脱白衣。",
        "家遥楚国寄，帆对汉山飞。",
        "知己盈华省，看君再发机。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 281074,
      "title": "陕州题河上亭",
      "content": [
        "岸拥洪流急，亭开清兴长。",
        "当轩河草晚，入坐水风凉。",
        "独鸟惊来客，孤云触去樯。",
        "秋声和远雨，暮色带微阳。",
        "浪静澄牕影，沙阴发簟光。",
        "逍遥每尽日，谁识爱沧浪。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 281075,
      "title": "留题姚氏山斋",
      "content": [
        "未厌栖林趣，犹怀济世才。",
        "闲眠知道在，高步会时来。",
        "露滴从添砚，蝉吟便送杯。",
        "乱书离缥帙，迸笋出苔莓。",
        "异果因僧摘，幽窗为燕开。",
        "春游何处尽，欲别几迟回。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 281076,
      "title": "长安书怀投知己",
      "content": [
        "所学近雕虫，知难谒至公。",
        "徒随众人后，拟老一生中。",
        "间岁家书到，经荒世业空。",
        "心悬沧海断，梦与白云通。",
        "玉漏声连北，银河气极东。",
        "关门迢递月，禁苑寂寥鸿。",
        "地广身难束，时平道独穷。",
        "萧条苔长雨，淅沥叶危风。",
        "久媿干朝客，多惭别钓翁。",
        "因依非不忝，延荐况曾蒙。",
        "与善应无替，垂恩本有终。",
        "霜天摇落日，莫使逐孤蓬。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 281077,
      "title": "送姚侍御充渭北掌书记",
      "content": [
        "北境烽烟急，南山战伐频。",
        "抚绥初易帅，参画尽须人。",
        "书记才偏称，朝廷意更亲。",
        "绣衣行李日，绮陌别离尘。",
        "报国将临虏，之藩不离秦。",
        "豸冠严在首，雄笔健随身。",
        "饮马河声暮，休兵塞色春。",
        "败亡仍暴骨，冤哭可伤神。",
        "上策何当用，边情此是真。",
        "雕阴曾久客，拜送欲霑巾。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 281078,
      "title": "长安书情投知己",
      "content": [
        "陕服因诗句，从容已半年。",
        "一从归阙下，罕得到门前。",
        "每候朝轩出，常看列宿悬。",
        "重投期见奖，数首果蒙传。",
        "转觉功宜倍，兼令住更坚。",
        "都忘春暂醉，少省夜曾眠。",
        "烦暑灯谁读，孤云业自专。",
        "精华搜未竭，骚雅琢须全。",
        "此事勤虽过，他谋拙莫先。",
        "槐街劳白日，桂路在青天。",
        "取第殊无序，还乡可有缘。",
        "旅情长越鸟，秋思几秦蝉。",
        "月色千楼满，砧声万井连。",
        "江山阻迢递，时节暗推迁。",
        "道即穷通守，才应始末怜。",
        "书绅相戒语，藏箧赠行篇。",
        "致主当齐圣，为郎本是仙。",
        "人心期际会，凤翼许迁延。",
        "毕竟良图在，何妨逸性便。",
        "幽斋中寝觉，珍木正阴圆。",
        "隐几闲瞻夜，临云兴渺然。",
        "五陵供丽景，六义动花牋。",
        "倘与潜生翼，宁非助化权。",
        "免教垂素髪，归种海隅田。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 281079,
      "title": "府试丹浦非乐战",
      "content": [
        "自古为君道，垂衣致理难。",
        "怀仁须去杀，用武即胜残。",
        "毒帜诛方及，兵临衅可观。",
        "居来彭蠡固，战罢洞庭宽。",
        "雪国知天远，霜林是血丹。",
        "吾皇则尧典，薄伐至桑亁。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 281080,
      "title": "府试风雨闻鸡",
      "content": [
        "不为风雨变，鸡德一何贞。",
        "在暗长先觉，临晨即自鸣。",
        "阴霾方见信，顷刻讵移声。",
        "向晦如相警，知时似独清。",
        "萧萧和断漏，喔喔报重城。",
        "欲识诗人兴，中含君子情。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 281081,
      "title": "府试观兰亭图",
      "content": [
        "往会人何处，遗踪事可观。",
        "林亭今日在，草木古春残。",
        "笔想吟中驻，杯疑饮后干。",
        "向青穿峻岭，当白认回湍。",
        "月影窗间夜，湖光枕上寒。",
        "不知诗酒客，谁更慕前欢。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 281082,
      "title": "府试老人星见",
      "content": [
        "良宵出户庭，极目向青冥。",
        "海内逢康日，天边见寿星。",
        "临空遥的的，竟晓独荧荧。",
        "春后先依景，秋来忽近丁。",
        "垂休临有道，作瑞掩前经。",
        "岂比周王梦，徒言得九龄。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 281083,
      "title": "省试振鹭",
      "content": [
        "有鸟生江浦，霜华作羽翰。",
        "君臣将比洁，朝野共相欢。",
        "月影林梢下，冰光水际残。",
        "翻飞时共乐，饮啄道皆安。",
        "逈翥宜高咏，群栖入静看。",
        "由来鸳鹭侣，济济列千官。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 281084,
      "title": "寄辛明府",
      "content": [
        "何处无苛政，东南有子男。",
        "细将朝客说，须是邑人谙。",
        "别业空经稔，归田独未甘。",
        "目凝烟积树，心贮月明潭。",
        "晓鼓愁方乱，春山睡正酣。",
        "不任啼鸟思，乡社欲桑蚕。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 281085,
      "title": "苑中题友人林亭",
      "content": [
        "井邑藏嵓穴，幽栖趣若何。",
        "春篁抽笋密，夏鸟杂雏多。",
        "坐有清风至，林无暑气过。",
        "乱书还就叶，真饮不听歌。",
        "片影明红藓，斜阴映绿萝。",
        "雄文终可惜，莫更弃高科。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 281086,
      "title": "投京兆府试官任文学先辈",
      "content": [
        "高兴每论诗，非才独见推。",
        "应当明试日，不比暗投时。",
        "出口人皆信，操心自可知。",
        "孤单虽有托，际会别无期。",
        "取舍知由己，穷通断在兹。",
        "贱身何足数，公道自难欺。",
        "泽国违甘旨，渔舟积梦思。",
        "长安未归去，为倚鉴妍媸。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 281087,
      "title": "宋少府东溪泛舟",
      "content": [
        "登岸还入舟，水禽惊笑语。",
        "晚叶低众色，湿云带繁暑。",
        "落日乘醉归，溪流复几许。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 281088,
      "title": "闻北虏入灵州二首 一",
      "content": [
        "河冰一夜合，虏骑入灵州。",
        "岁岁徴兵去，难防塞草秋。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 281089,
      "title": "闻北虏入灵州二首 二",
      "content": [
        "见说灵州战，沙中血未干。",
        "将军日告急，走马向长安。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 281090,
      "title": "送友人下第归感怀",
      "content": [
        "帝里春无意，归山对物华。",
        "即应来日去，九陌踏槐花。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 281091,
      "title": "赠桂林友人",
      "content": [
        "君家桂林住，日伐桂枝炊。",
        "何事东堂树，年年待一枝。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 281092,
      "title": "长安感怀",
      "content": [
        "一第知何日，全家待此身。",
        "空将灞陵酒，酌送向东人。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 281093,
      "title": "题长孙桐树",
      "content": [
        "一去龙门侧，千年凤影移。",
        "空余剪圭处，无复在孙枝。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 281094,
      "title": "渡汉江",
      "content": [
        "岭外音书绝，经年复历春。",
        "近乡情更怯，不敢问来人。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 281095,
      "title": "嵩山夜还",
      "content": [
        "家住东臯去，好采旧山薇。",
        "自省游泉石，何曾不夜归。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 281096,
      "title": "暮秋宿清源上人院",
      "content": [
        "野客愁来日，山房木落中。",
        "微风生夜半，积雨向秋终。",
        "证道方离法，安禅不住空。",
        "迷途将觉路，语默见西东。"
      ],
      "author": {
        "id": 5772,
