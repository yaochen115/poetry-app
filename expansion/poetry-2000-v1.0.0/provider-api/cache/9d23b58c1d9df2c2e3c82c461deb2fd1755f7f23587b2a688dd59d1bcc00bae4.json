{
  "data": [
    {
      "id": 347626,
      "title": "汴路即事",
      "content": [
        "千里河烟直，青槐夹岸长。",
        "天涯同此路，人语各殊方。",
        "草市迎江货，津桥税海商。",
        "回看故宫柳，憔悴不成行。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 347628,
      "title": "醉后忆山中故人",
      "content": [
        "花开草复秋，云水自悠悠。",
        "因醉暂无事，在山难免愁。",
        "遇晴须看月，斗健且登楼。",
        "暗想山中伴，如今尽白头。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 347632,
      "title": "新开望山处",
      "content": [
        "新开望山处，今朝减病眠。",
        "应移千里道，犹自数峰偏。",
        "故欲遮春巷，还来绕暮天。",
        "老夫行步弱，免到寺门前。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 347633,
      "title": "题东华观",
      "content": [
        "路尽烟水外，院门题上清。",
        "鹤雏灵解语，琼叶软无声。",
        "白发道心熟，黄衣仙骨轻。",
        "寂寥虚境里，何处觅长生。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 347634,
      "title": "饭僧",
      "content": [
        "别屋炊香饭，熏辛不入家。",
        "温泉调葛面，净手摘藤花。",
        "蒲鲊除青叶，芹齑带紫芽。",
        "愿师常伴食，消气有姜茶。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 347636,
      "title": "归昭应留别城中",
      "content": [
        "喜得近京城，官卑意亦荣。",
        "并床欢未定，离室思还生。",
        "计拙偷闲住，经过买日行。",
        "如无自来分，一驿是遥程。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 347640,
      "title": "初到昭应呈同僚",
      "content": [
        "白发初为吏，有惭年少郎。",
        "自知身上拙，不称世间忙。",
        "秋雨悬墙绿，暮山宫树黄。",
        "同官若容许，长借老僧房。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 347643,
      "title": "林居",
      "content": [
        "荒林四面通，门在野田中。",
        "顽仆长如客，贫居未胜蓬。",
        "旧绵衣不暖，新草屋多风。",
        "唯去山南近，闲亲贩药翁。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 347644,
      "title": "原上新居十三首",
      "content": [
        "新占原头地，本无山可归。",
        "荒藤生叶晚，老杏著花稀。",
        "厨舍近泥灶，家人初饱薇。",
        "弟兄今四散，何日更相依。",
        "一家榆柳新，四面远无邻。",
        "人少愁闻病，庄孤幸得贫。",
        "耕牛长愿饱，樵仆每怜勤。",
        "终日忧衣食，何由脱此身。",
        "长安无旧识，百里是天涯。",
        "寂寞思逢客，荒凉喜见花。",
        "访僧求贱药，将马中豪家。",
        "乍得新蔬菜，朝盘忽觉奢。",
        "鸡鸣村舍遥，花发亦萧条。",
        "野竹初生笋，溪田未得苗。",
        "家贫僮仆瘦，春冷菜蔬焦。",
        "甘分长如此，无名在圣朝。",
        "春来梨枣尽，啼哭小儿饥。",
        "邻富鸡常去，庄贫客渐稀。",
        "借牛耕地晚，卖树纳钱迟。",
        "墙下当官路，依山补竹篱。",
        "自扫一间房，唯铺独卧床。",
        "野羹溪菜滑，山纸水苔香。",
        "陈药初和白，新经未入黄。",
        "近来心力少，休读养生方。",
        "拟作读经人，空房置净巾。",
        "锁茶藤箧密，曝药竹床新。",
        "老病应随业，因缘不离身。",
        "焚香向居士，无计出诸尘。",
        "移家近住村，贫苦自安存。",
        "细问梨果植，远求花药根。",
        "倩人开废井，趁犊入新园。",
        "长爱当山立，黄昏不闭门。",
        "和暖绕林行，新贫足喜声。",
        "扫渠忧竹旱，浇地引兰生。",
        "山客凭栽树，家僮使入城。",
        "门前粉壁上，书著县官名。",
        "住处钟鼓外，免争当路桥。",
        "身闲时却困，儿病可来娇。",
        "鸡睡日阳暖，蜂狂花艳烧。",
        "长安足门户，叠叠看登朝。",
        "近来年纪到，世事总无心。",
        "古碣凭人拓，闲诗任客吟。",
        "送经还野苑，移石入幽林。",
        "谷口春风恶，梨花盖地深。",
        "懒更学诸余，林中扫地居。",
        "腻衣穿不洗，白发短慵梳。",
        "苦相常多泪，劳生自悟虚。",
        "闲行人事绝，亲故亦无书。",
        "住处去山近，傍园麋鹿行。",
        "野桑穿井长，荒竹过墙生。",
        "新识邻里面，未谙村社情。",
        "石田无力及，贱赁与人耕。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 347648,
      "title": "题法云禅院僧",
      "content": [
        "不剃头多日，禅来白发长。",
        "合村迎住寺，同学乞修房。",
        "觉少持经力，忧无养病粮。",
        "上山犹得在，自解衲衣裳。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 347652,
      "title": "贻小尼师",
      "content": [
        "新剃青头发，生来未扫眉。",
        "身轻礼拜稳，心慢记经迟。",
        "唤起犹侵晓，催斋已过时。",
        "春晴阶下立，私地弄花枝。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 347654,
      "title": "山中惜花",
      "content": [
        "忽看花渐稀，罪过酒醒时。",
        "寻觅风来处，惊张夜落时。",
        "游丝缠故蕊，宿夜守空枝。",
        "开取当轩地，年年树底期。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 347655,
      "title": "和武门下伤韦令孔雀",
      "content": [
        "孤号秋阁阴，韦令在时禽。",
        "觅伴海山黑，思乡橘柚深。",
        "举头闻旧曲，顾尾惜残金。",
        "憔悴不飞去，重君池上心。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 347656,
      "title": "题所赁宅牡丹花",
      "content": [
        "赁宅得花饶，初开恐是妖。",
        "粉光深紫腻，肉色退红娇。",
        "且愿风留著，惟愁日炙燋。",
        "可怜零落蕊，收取作香烧。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 347657,
      "title": "隐者居",
      "content": [
        "山人住处高，看日上蟠桃。",
        "雪缕青山脉，云生白鹤毛。",
        "朱书护身咒，水噀断邪刀。",
        "何物中长食，胡麻慢火熬。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 347659,
      "title": "送严大夫赴桂州",
      "content": [
        "岭头分界候，一半属湘潭。",
        "水驿门旗出，山恋洞主参。",
        "辟邪犀角重，解酒荔枝甘。",
        "莫叹京华远，安南更有南。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 347662,
      "title": "杜中丞书院新移小竹",
      "content": [
        "此地本无竹，远从山寺移。",
        "经年求养法，隔日记浇时。",
        "嫩绿卷新叶，残黄收故枝。",
        "色经寒不动，声与静相宜。",
        "爱护出常数，稀稠看自知。",
        "贫来缘未有，客散独行迟。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 347663,
      "title": "同于汝锡赏白牡丹",
      "content": [
        "晓日花初吐，春寒白未凝。",
        "月光裁不得，苏合点难胜。",
        "柔腻于云叶，新鲜掩鹤膺。",
        "统心黄倒晕，侧茎紫重棱。",
        "乍敛看如睡，初开问欲应。",
        "并香幽蕙死，比艳美人憎。",
        "价数千金贵，形相两眼疼。",
        "自知颜色好，愁被彩光凌。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 347667,
      "title": "送郑权尚书南海",
      "content": [
        "七郡双旌贵，人皆不忆回。",
        "戍头龙脑铺，关口象牙堆。",
        "敕设熏炉出，蛮辞咒节开。",
        "市喧山贼破，金贱海船来。",
        "白氎家家织，红蕉处处栽。",
        "已将身报国，莫起望乡台。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 347668,
      "title": "题别遗爱草堂兼呈李十使君",
      "content": [
        "曾住炉峰下，书堂对药台。",
        "斩新萝径合，依旧竹窗开。",
        "砌水亲看决，池荷手自栽。",
        "五年方暂至，一宿又须回。",
        "纵未长归得，犹胜不到来。",
        "君家白鹿洞，闻道亦生苔。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 347669,
      "title": "赏牡丹",
      "content": [
        "此花名价别，开艳益皇都。",
        "香遍苓菱死，红烧踯躅枯。",
        "软光笼细脉，妖色暖鲜肤。",
        "满蕊攒黄粉，含棱缕绛苏。",
        "好和熏御服，堪画入宫图。",
        "晚态愁新妇，残妆望病夫。",
        "教人知个数，留客赏斯须。",
        "一夜轻风起，千金买亦无。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 347670,
      "title": "赠王枢密",
      "content": [
        "三朝行坐镇相随，今上春宫见小时。",
        "脱下御衣先赐著，",
        "自是姓同亲向说，九重争得外人知。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 347671,
      "title": "早秋过龙武李将军书斋",
      "content": [
        "高树蝉声秋巷里，朱门冷静似闲居。",
        "重装墨画数茎竹，",
        "就中爱读英雄传，欲立功勋恐不如。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 347672,
      "title": "江陵即事",
      "content": [
        "瘴云梅雨不成泥，十里津楼压大堤。",
        "蜀女下沙迎水客，",
        "夜半独眠愁在远，北看归路隔蛮溪。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 347673,
      "title": "题花子赠渭州陈判官",
      "content": [
        "腻如云母轻如粉，艳胜香黄薄胜蝉。",
        "点绿斜蒿新叶嫩，",
        "况复萧郎有情思，可怜春日镜台前。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 347674,
      "title": "送从侄拟赴江陵少尹",
      "content": [
        "江陵少尹好闲官，亲故皆来劝自宽。",
        "无事日长贫不易，",
        "应向章华台下醉，莫冲云雨夜深寒。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 347675,
      "title": "华清宫感旧",
      "content": [
        "尘到朝元边使急，千官夜发六龙回。",
        "辇前月照罗衫泪，",
        "有时云外闻天乐，知是先皇沐浴来。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 347676,
      "title": "九仙公主旧庄",
      "content": [
        "仙居五里外门西，石路亲回御马蹄。",
        "天使来栽宫里树，",
        "楼上凤凰飞去后，白云红叶属山鸡。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 347677,
      "title": "郭家溪亭",
      "content": [
        "高亭望见长安树，春草冈西旧院斜。",
        "光动绿烟遮岸竹，",
        "妆阁书楼倾侧尽，云山新卖与官家。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 347678,
      "title": "题金家竹溪",
      "content": [
        "少年因病离天仗，乞得归家自养身。",
        "买断竹溪无别主，",
        "乡使到来常款语，还闻世上有功臣。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 347679,
      "title": "题应圣观",
      "content": [
        "精思堂上画三身，回作仙宫度美人。",
        "赐额御书金字贵，",
        "头白女冠犹说得，蔷薇不似已前春。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 347680,
      "title": "同于汝锡游降圣观",
      "content": [
        "秦时桃树满山坡，骑鹿先生降大罗。",
        "路尽溪头逢地少，",
        "闻说开元斋醮日，晓移行漏帝亲过。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 347681,
      "title": "逍遥翁溪亭",
      "content": [
        "逍遥翁在此裴回，帝改溪名起石台。",
        "车马到春常借问，",
        "无主青山何所直，卖供官税不如灰。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 347682,
      "title": "寻李山人不遇",
      "content": [
        "山客长须少在时，溪中放鹤洞中棋。",
        "生金有气寻还远，",
        "从头石上留名去，独向南峰问老师。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 347683,
      "title": "题石瓮寺",
      "content": [
        "青崖白石夹城东，泉脉钟声内里通。",
        "地压龙蛇山色别，",
        "天子亲题诗总在，画扉长锁碧龛中。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 347684,
      "title": "早登西禅寺阁",
      "content": [
        "上方台殿第三层，朝壁红窗日气凝。",
        "烟雾开时分远寺，",
        "莫说城南月灯阁，自诸楼看总难胜。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 347685,
      "title": "题江寺兼求药子",
      "content": [
        "隋朝旧寺楚江头，深谢师僧引客游。",
        "空赏野花无过夜，",
        "愿乞野人三两粒，归家将助小庭幽。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 347686,
      "title": "题诜法师院",
      "content": [
        "三年说戒龙宫里，巡礼还来向水行。",
        "多爱贫穷人远请，",
        "僧院不求诸处好，转经唯有一窗明。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 347687,
      "title": "酬于汝锡晓雪见寄",
      "content": [
        "欲明天色白漫漫，打叶穿帘雪未干。",
        "薄落阶前人踏尽，",
        "劳动更裁新样绮，红灯一夜剪刀寒。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 347688,
      "title": "从军后寄山中友人",
      "content": [
        "爱仙无药住溪贫，脱却山衣事汉臣。",
        "夜半听鸡梳白发，",
        "劳动先生远相示，别来弓箭不离身。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 347689,
      "title": "寄汴州令狐相公",
      "content": [
        "三军江口拥双旌，虎帐长开自教兵。",
        "机锁恶徒狂寇尽，",
        "秋日梁王池阁好，新歌散入管弦声。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 347690,
      "title": "别李赞侍御",
      "content": [
        "同受艰难骠骑营，半年中听揭枪声。",
        "草头送酒驱村乐，",
        "荐书自入无消息，卖尽寒衣却出城。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 347691,
      "title": "和蒋学士新授章服",
      "content": [
        "五色箱中绛服春，笏花成就白鱼新。",
        "看宣赐处惊回眼，",
        "翰林同贺文章出，惊动茫茫下界人。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 347692,
      "title": "岁晚自感",
      "content": [
        "人皆欲得长年少，无那排门白发催。",
        "一向破除愁不尽，",
        "沥酒愿从今日后，更逢二十度花开。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 347693,
      "title": "昭应官舍",
      "content": [
        "痴顽终日羡人闲，却喜因官得近山。",
        "斜对寺楼分寂寂，",
        "文案把来看未会，虽书一字甚惭颜。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 347694,
      "title": "寄旧山僧",
      "content": [
        "因依老宿发心初，半学修心半读书。",
        "雪后每常同席卧，",
        "一向风尘取烦恼，不知衰病日难除。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 347695,
      "title": "武陵春日",
      "content": [
        "寻春何事却悲凉，春到他乡忆故乡。",
        "秦女洞桃欹涧碧，",
        "不似冥心叩尘寂，玉编金轴有仙方。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 347696,
      "title": "寄分司张郎中",
      "content": [
        "一别京华年岁久，卷中多见岭南诗。",
        "声名已压众人上，",
        "青天白日当头上，会有求闲不得时。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 347697,
      "title": "上武元衡相公",
      "content": [
        "旌旗坐镇蜀江雄，帝命重开旧合崇。",
        "褒贬唐书天历上，",
        "长得萧何为国相，自西流水尽朝宗。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 347698,
      "title": "上张弘靖相公",
      "content": [
        "传封三世尽河东，家占中条第一峰。",
        "旱岁天教作霖雨，",
        "卑散自知霄汉隔，若为门下赐从容。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 347699,
      "title": "上裴度舍人",
      "content": [
        "小松双对凤池开，履迹衣香逼上台。",
        "天意皆从彩毫出，",
        "仙侣何因记名姓，县丞头白走尘埃。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 347700,
      "title": "上杜元颖相公",
      "content": [
        "学士金銮殿后居，天中行坐侍龙舆。",
        "承恩不许离床谢，",
        "闲曹散吏无相识，犹记荆州拜谒初。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 347701,
      "title": "赠卢汀谏议",
      "content": [
        "青蛾不得在床前，空室焚香独自眠。",
        "功证诗篇离景象，",
        "近见兰台诸吏说，御诗新集未教传。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 347702,
      "title": "贺杨巨源博士拜虞部员外",
      "content": [
        "合归兰署已多时，上得金梯亦未迟。",
        "两省郎官开道路，",
        "残著几丸仙药在，分张还遣病夫知。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 347703,
      "title": "赠郭将军",
      "content": [
        "承恩新拜上将军，当直巡更近五云。",
        "天下表章经院过，",
        "向晚临阶看号簿，眼前风景任支分。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 347704,
      "title": "赠田将军",
      "content": [
        "初从学院别先生，便领偏师得战名。",
        "大小独当三百阵，",
        "自执金吾长上直，蓬莱宫里夜巡更。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 347705,
      "title": "赠胡泟将军",
      "content": [
        "书生难得是金吾，近日登科记总无。",
        "半夜进傩当玉殿，",
        "恐要蕃中新道路，指挥重画五城图。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 347706,
      "title": "留别田尚书",
      "content": [
        "拟报平生未杀身，难离门馆起居频。",
        "不看匣里钗头古，",
        "朝天路在骊山下，专望红旗拜旧尘。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 347707,
      "title": "送唐大夫罢节归山",
      "content": [
        "年少平戎老学仙，表求骸骨乞生全。",
        "不堪腰下悬金印，",
        "人间鸡犬同时去，遥听笙歌隔水烟。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 347708,
      "title": "送司空神童",
      "content": [
        "杏花坛上授书时，不废中庭趁蝶飞。",
        "暗写五经收部秩，",
        "独向凤城持荐表，万人丛里有光辉。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 347709,
      "title": "送振武张尚书",
      "content": [
        "回天转地是将军，扶助春宫上五云。",
        "抚背恩虽同骨肉，",
        "闲即单于台下猎，威声直到海西闻。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 347710,
      "title": "送吴谏议上饶州",
      "content": [
        "鄱阳太守是真人，琴在床头箓在身。",
        "曾向先皇边谏事，",
        "净扫水堂无侍女，下街唯共鹤殷勤。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 347711,
      "title": "赠阎少保",
      "content": [
        "髭须虽白体轻健，九十三来却少年。",
        "问事爱知天宝里，",
        "侍女常时教合药，亦闻私地学求仙。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 347712,
      "title": "送魏州李相公",
      "content": [
        "百代功勋一日成，三年五度换双旌。",
        "闲来不对人论战，",
        "当朝面受新恩去，算料妖星不敢生。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 347713,
      "title": "赠索暹将军",
      "content": [
        "浑身著箭瘢犹在，万槊千刀总过来。",
        "轮剑直冲生马队，",
        "泪滴先皇阶下土，南衙班里趁朝回。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 347714,
      "title": "赠王屋道士赴诏",
      "content": [
        "玉皇符诏下天坛，玳瑁头簪白角冠。",
        "鹤遣院中童子养，",
        "能断世间腥血味，长生只要一丸丹。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 347715,
      "title": "赠王处士",
      "content": [
        "松树当轩雪满池，青山掩障碧纱幮。",
        "鼠来案上常偷水，",
        "世间有似君应少，便乞从今作我师。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 347716,
      "title": "洛中张籍新居",
      "content": [
        "最是城中闲静处，更回门向寺前开。",
        "云山且喜重重见，",
        "自君移到无多日，墙上人名满绿苔。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 347717,
      "title": "题裴处士碧虚溪居",
      "content": [
        "鸟声真似深山里，平地人间自不同。",
        "春圃紫芹长卓卓，",
        "细问来时从近远，溪名载入县图中。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 347718,
      "title": "送阿史那将军安西迎旧使灵榇",
      "content": [
        "汉家都护边头没，旧将麻衣万里迎。",
        "阴地背行山下火，",
        "却入杜陵秋巷里，路人来去读铭旌。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 347719,
      "title": "赠崔礼驸马",
      "content": [
        "凤凰楼阁连宫树，天子崔郎自爱贫。",
        "金埒减添栽药地，",
        "一月一回陪内宴，马蹄犹厌踏香尘。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 347720,
      "title": "赠太清卢道士",
      "content": [
        "上清道士未升天，南岳中华作散仙。",
        "书卖八分通字学，",
        "想向诸山寻礼遍，却回还守老君前。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 347721,
      "title": "送宫人入道",
      "content": [
        "休梳丛鬓洗红妆，头戴芙蓉出未央。",
        "弟子抄将歌遍叠，",
        "发愿蓬莱见王母，却归人世施仙方。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 347722,
      "title": "上李吉甫相公",
      "content": [
        "圣朝齐贺说逢殷，霄汉无云日月真。",
        "金鼎调和天膳美，",
        "曾向山东为散吏，当今窦宪是贤臣。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 347723,
      "title": "上李益庶子",
      "content": [
        "紫烟楼阁碧纱亭，上界诗仙独自行。",
        "奇险驱回还寂寞，",
        "昏思愿因秋露洗，幸容阶下礼先生。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 347724,
      "title": "题元郎中新宅",
      "content": [
        "近移松树初栽药，经帙书签一切新。",
        "铺设暖房迎道士，",
        "惟有好诗名字出，倍教年少损心神。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 347725,
      "title": "初授太府丞言怀",
      "content": [
        "除书亦下属微班，唤作官曹便不闲。",
        "检案事多关市井，",
        "此去仙宫无一里，遥看松树众家攀。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 347726,
      "title": "赠李愬仆射",
      "content": [
        "唐州将士死生同，尽逐双旌旧镇空。",
        "独破淮西功业大，",
        "次第各分茅土贵，殊勋并在一门中。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 347727,
      "title": "书赠旧浑二曹长",
      "content": [
        "二年同在华清下，入县门中最近邻。",
        "替饮觥筹知户小，",
        "僮仆使来传语熟，至今行酒校殷勤。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 347728,
      "title": "上崔相公",
      "content": [
        "枯桂衰兰一遍春，唯将道德定君臣。",
        "施行圣泽山川润，",
        "应怜老病无知己，自别溪中满鬓尘。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 347729,
      "title": "寄杨十二秘书",
      "content": [
        "初移古寺正南方，静是浮山远是庄。",
        "人定犹行背街鼓，",
        "闲出天门醉骑马，可怜蓬阁秘书郎。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 347730,
      "title": "谢田赞善见寄",
      "content": [
        "五侯三任未相称，头白如丝作县丞。",
        "错判符曹群吏笑，",
        "年少力生犹不敌，况加憔悴闷腾腾。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 347731,
      "title": "晚秋病中",
      "content": [
        "万事风吹过耳轮，贫儿活计亦曾闻。",
        "偶逢新语书红叶，",
        "病多体痛无心力，更被头边药气熏。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 347732,
      "title": "薛二十池亭",
      "content": [
        "每个树边消一日，绕池行匝又须行。",
        "异花多是非时有，",
        "浮萍著岸风吹歇，水面无尘晚更清。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 347733,
      "title": "故梁国公主池亭",
      "content": [
        "平阳池馆枕秦川，门锁南山一朵烟。",
        "素柰花开西子面，",
        "寂寞空余歌舞地，玉箫声绝凤归天。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 347734,
      "title": "题柱国寺",
      "content": [
        "皇帝施钱修此院，半居天上半人间。",
        "丹梯暗出三重阁，",
        "行香天使长相续，早起离城日午还。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 347735,
      "title": "昭应官舍书事",
      "content": [
        "县在华清宫北面，晓看楼殿正相当。",
        "庆云出处依时报，",
        "两衙早被官拘束，登阁巡溪亦属忙。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 347736,
      "title": "昭应李郎中见贻佳作次韵奉酬",
      "content": [
        "窗户风凉四面开，陶公爱晚上高台。",
        "中庭不热青山入，",
        "诸生围绕新篇读，玉阙仙官少此才。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 347737,
      "title": "闲说",
      "content": [
        "桃花百叶不成春，鹤寿千年也未神。",
        "秦陇州缘鹦鹉贵，",
        "鼓动六街骑马出，相逢总是学狂人。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 347738,
      "title": "自伤",
      "content": [
        "衰门海内几多人，满眼公卿总不亲。",
        "四授官资元七品，",
        "独自在家长似客，黄昏哭向野田春。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 347739,
      "title": "田侍中宴席",
      "content": [
        "香熏罗幕暖成烟，火照中庭烛满筵。",
        "整顿舞衣呈玉腕，",
        "虽是沂公门下客，争将肉眼看云天。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 347740,
      "title": "寒食日看花",
      "content": [
        "早入公门到夜归，不因寒食少闲时。",
        "颠狂绕树猿离锁，",
        "老来自喜身无事，仰面西园得咏诗。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 347741,
      "title": "和少府崔卿微雪早朝",
      "content": [
        "蓬莱春雪晓犹残，点地成花绕百官。",
        "已傍祥鸾迷殿角，",
        "粉画南山棱郭出，初晴一半隔云看。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 347742,
      "title": "和胡将军寓直",
      "content": [
        "宫鸦栖定禁枪攒，楼殿深严月色寒。",
        "进状直穿金戟槊，",
        "遥见正南宣不坐，新栽松树唤人看。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 347743,
      "title": "春日五门西望",
      "content": [
        "百官朝下五门西。",
        "尘起春风过玉堤。",
        "黄帕盖鞍呈了马，",
        "唯有教坊南草绿，古苔阴地冷凄凄。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 347744,
      "title": "长安早春",
      "content": [
        "霏霏漠漠绕皇州，销雪欺寒不自由。",
        "先向红妆添晓梦，",
        "每度暗来还暗去，今年须遣蝶迟留。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 347745,
      "title": "早春病中",
      "content": [
        "日日春风阶下起，不吹光彩上寒株。",
        "师教绛服禳衰月，",
        "世间方法从谁问，卧处还看药草图。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 347746,
      "title": "上阳宫",
      "content": [
        "上阳花木不曾秋，洛水穿宫处处流。",
        "画阁红楼宫女笑，",
        "曾读列仙王母传，九天未胜此中游。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 347747,
      "title": "李处士故居",
      "content": [
        "露浓烟重草萋萋，树映阑干柳拂堤。",
        "一院落花无客醉，",
        "风景宛然人自改，却经门外马频嘶。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 347748,
      "title": "寄贾岛",
      "content": [
        "尽日吟诗坐忍饥，万人中觅似君稀。",
        "僮眠冷榻朝犹卧。",
        "驴放秋田夜不归。",
        "傍暖旋收红落叶，觉寒犹著旧生衣。",
        "曲江池畔时时到，为爱鸬鹚雨后飞。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    }
  ],
