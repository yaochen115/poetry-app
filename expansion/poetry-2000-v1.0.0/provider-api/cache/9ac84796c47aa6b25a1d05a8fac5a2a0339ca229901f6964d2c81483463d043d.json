{
  "data": [
    {
      "id": 313096,
      "title": "更漏子",
      "content": [
        "雪肌轻，花脸薄。",
        "愁困不忺梳掠。",
        "眉翠袅，眼波长。",
        "偎人言语香。",
        "看难厌，怜不足。",
        "苦恨别离何速。",
        "珠树远，彩鸾孤。",
        "今生重见无。"
      ],
      "author": {
        "id": 11741,
        "name": "杜安世"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313097,
      "title": "更漏子",
      "content": [
        "脸如花，花不笑。",
        "双脸胜花能笑。",
        "肌似玉，玉非温。",
        "肌温胜玉温。",
        "既相逢，情不重。",
        "何似当初休共。",
        "情既重，却分飞。",
        "争如不见伊。"
      ],
      "author": {
        "id": 11741,
        "name": "杜安世"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313098,
      "title": "更漏子",
      "content": [
        "镂金环，连玉珥。",
        "颗颗蚌蛤相缀。",
        "偎粉面，映莲腮。",
        "露浓花正开。",
        "冷光凝，员影重。",
        "几度偷期摇动。",
        "山枕上，恐人知。",
        "摘嫌纤手迟。"
      ],
      "author": {
        "id": 11741,
        "name": "杜安世"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313099,
      "title": "喜迁莺",
      "content": [
        "花不尽，柳无穷。",
        "应与我心同。",
        "觥船一棹百分空。",
        "何处不相逢。",
        "朱弦悄。",
        "知音少。",
        "天若有情应老。",
        "劝君看取利名场。",
        "今古梦忙忙。"
      ],
      "author": {
        "id": 11741,
        "name": "杜安世"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313100,
      "title": "杜韦娘",
      "content": [
        "暮春天气，莺老燕子忙如织。",
        "间嫩叶题诗哨梅小，乍遍水、新萍圆碧。",
        "初牡丹谢了，秋千搭起，垂杨暗锁深深陌。",
        "暖风轻，尽日闲把、榆钱乱掷。",
        "恨寂寂。",
        "芳容衰减，顿敧玳枕困无力。",
        "为少年、狂荡恩情薄，尚未有、归来消息。",
        "想当初、凤侣鸳俦，唤作平生，更不轻离拆。",
        "倚朱扉，泪眼滴损、红绡数尺。"
      ],
      "author": {
        "id": 11741,
        "name": "杜安世"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313101,
      "title": "胡捣练",
      "content": [
        "数枝半敛半开时，洞阁晓妆新注。",
        "宝香格艳姿天赋。",
        "甘被群芳妒。",
        "狂风横雨且相饶，又恐有彩云迎去。",
        "牵破少年心情，无计为长主。"
      ],
      "author": {
        "id": 11741,
        "name": "杜安世"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313102,
      "title": "少年游",
      "content": [
        "小楼归燕又黄昏。",
        "寂寞锁高门。",
        "轻风细雨，惜花天气，相次过春分。",
        "画堂无绪，初燃绛蜡，罗帐掩馀薰。",
        "多情不解怨王孙。",
        "任薄幸、一从君。"
      ],
      "author": {
        "id": 11741,
        "name": "杜安世"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313103,
      "title": "凤栖梧・蝶恋花",
      "content": [
        "整顿云鬟初睡起。",
        "庭院无风，尽日帘垂地。",
        "画阁巢新燕声喜。",
        "杨花狂散无拘系。",
        "近来早是添憔悴。",
        "金缕衣宽，赛过宫腰细。",
        "苒苒光阴似流水。",
        "春残莺老人千里。"
      ],
      "author": {
        "id": 11741,
        "name": "杜安世"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313104,
      "title": "凤栖梧・蝶恋花",
      "content": [
        "池上新秋帘幕卷。",
        "菡萏娇红，鉴里西施面。",
        "衰柳摇风尚柔软。",
        "眠沙㶉𫛶临清浅。",
        "新翻归翅云间燕。",
        "满地槐花，尽日蝉声乱。",
        "独倚阑干暮山远。",
        "一场寂寞无人见。"
      ],
      "author": {
        "id": 11741,
        "name": "杜安世"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313105,
      "title": "凤栖梧・蝶恋花",
      "content": [
        "闲上江楼初雨过。",
        "满袖清风，微散谁知我。",
        "莲脸佳人颜未破。",
        "沙洲两两鸳鸯卧。",
        "时有渔歌相应和。",
        "叠秀危横，黛拨山千朵。",
        "一片凄凉无计那。",
        "离愁还有些些个。"
      ],
      "author": {
        "id": 11741,
        "name": "杜安世"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313106,
      "title": "凤栖梧・蝶恋花",
      "content": [
        "惆怅留春留不住。",
        "欲到清和，背我堂堂去。",
        "飞絮落花和细雨。",
        "凄凉庭院流莺度。",
        "更被闲愁相赚误。",
        "梦断高唐，回首桃源路。",
        "一饷沈吟无意绪。",
        "分明往事今何处。"
      ],
      "author": {
        "id": 11741,
        "name": "杜安世"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313107,
      "title": "浪淘沙",
      "content": [
        "后约无凭。",
        "往事堪惊。",
        "秋蛩永夜绕床鸣。",
        "展转寻思求好梦，还又难成。",
        "愁思若浮云。",
        "消尽重生。",
        "佳人何处独盈盈。",
        "可惜一天无用月，照空为谁明。"
      ],
      "author": {
        "id": 11741,
        "name": "杜安世"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313108,
      "title": "浪淘沙",
      "content": [
        "又是春暮。",
        "落花飞絮。",
        "子规啼尽断肠声，秋千庭院，红旗彩索，淡烟疏雨。",
        "念念相思苦。",
        "黛眉长聚。",
        "碧池惊散睡鸳鸯，当初容易分飞去。",
        "恨孤儿欢侣。"
      ],
      "author": {
        "id": 11741,
        "name": "杜安世"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313109,
      "title": "浪淘沙",
      "content": [
        "帘外微风。",
        "云雨回踪。",
        "银釭烬冷锦帏中。",
        "枕上深盟，年少心事，陡顿成空。",
        "岭外白头翁。",
        "到没由逢。",
        "一床鸳被叠香红。",
        "明月满庭花似绣，闷不见虫虫。"
      ],
      "author": {
        "id": 11741,
        "name": "杜安世"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313110,
      "title": "更漏子",
      "content": [
        "庭远途程。",
        "算万山千水，路入神京。",
        "暖日春郊，绿柳红杏，香迳舞燕流莺。",
        "客馆悄悄闲庭，堪惹旧恨深。",
        "有多少驱驱，蓦岭涉水，枉费身心。",
        "思想厚利高名。",
        "谩惹得忧烦，枉度浮生。",
        "幸有青松，白云深洞，清闲且乐升平。",
        "长是宦游羁思，别离泪满襟。",
        "望江乡踪迹，旧游题书，尚自分明。"
      ],
      "author": {
        "id": 11741,
        "name": "杜安世"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313111,
      "title": "行香子",
      "content": [
        "黄金叶细，碧玉枝纤。",
        "初暖日、当乍晴天。",
        "向武昌溪畔，于彭泽门前。",
        "陶潜影，张绪态，两相牵。",
        "数株堤面，几树桥边。",
        "嫩垂条、絮荡轻绵。",
        "系长江舴艋，拂深院秋千。",
        "寒食下，半和雨，半和烟。"
      ],
      "author": {
        "id": 11741,
        "name": "杜安世"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313112,
      "title": "巫山一段云",
      "content": [
        "笑拟条风戏，装迟谷雨催。",
        "彩云飞下柳楼台。",
        "千朵一时开。",
        "惜恐尘埃染，惊疑紫府来。",
        "有时香喷入人怀。",
        "魂断客徘徊。"
      ],
      "author": {
        "id": 11741,
        "name": "杜安世"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313113,
      "title": "生查子",
      "content": [
        "关山魂梦长，寒雁音书少。",
        "两鬓可怜青，只为相思老。",
        "归傍碧纱窗，说向人人道。",
        "真个别离难，不似相逢好。"
      ],
      "author": {
        "id": 11741,
        "name": "杜安世"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313114,
      "title": "贺圣朝",
      "content": [
        "东君造物无凝滞。",
        "芳容相替。",
        "杏花桃萼一时开，就中明媚。",
        "绿丛金朵，枝长叶细。",
        "称花王相待。",
        "万般堪爱，暂时见了，断肠无计。"
      ],
      "author": {
        "id": 11741,
        "name": "杜安世"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313115,
      "title": "贺圣朝",
      "content": [
        "牡丹盛拆春将暮。",
        "群芳羞妒。",
        "几时流落在人间，半间仙露。",
        "馨香艳冶，吟看醉赏，叹谁能留住。",
        "莫辞持烛夜深深，怨等闲风雨。"
      ],
      "author": {
        "id": 11741,
        "name": "杜安世"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313116,
      "title": "安公子",
      "content": [
        "又是春将半。",
        "杏花零落闲庭院。",
        "天气有时阴淡淡，绿杨轻软。",
        "连画阁、绣帘半卷。",
        "招新燕。",
        "残黛敛、独倚阑干遍。",
        "暗思前事，月下风流，狂踪无限。",
        "惜恐莺花晚。",
        "更堪容易相抛远。",
        "离恨结成心上病，几时消散。",
        "空际有、断云片片。",
        "遥峰暖。",
        "闻杜宇、终日哀啼怨。",
        "暮烟芳草，写望迢迢，甚时重见。"
      ],
      "author": {
        "id": 11741,
        "name": "杜安世"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313117,
      "title": "苏幕遮",
      "content": [
        "尽思量，还叵耐。",
        "因甚当初，故故相招买。",
        "早是幽欢多障碍。",
        "更遣分飞，脉脉如天外。",
        "有心怜，无计奈。",
        "两处厌厌，一点虚恩爱。",
        "独上高楼临暮霭。",
        "凭暖朱阑，这意无人会。"
      ],
      "author": {
        "id": 11741,
        "name": "杜安世"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313118,
      "title": "渔家傲",
      "content": [
        "微雨初收月映云。",
        "巢栖燕子欲黄昏。",
        "花片不飞风力困。",
        "春色尽。",
        "蜡梅枝上樱□嫩。",
        "谁撼金环锁深洞。",
        "薰馀乍厌锦衾温。",
        "消灭玉肌谁与问。",
        "朱明近。",
        "日长无事添闲闷。"
      ],
      "author": {
        "id": 11741,
        "name": "杜安世"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313119,
      "title": "渔家傲",
      "content": [
        "疏雨才收淡泞天。",
        "微云绽处月婵娟。",
        "寒雁一声人正远。",
        "添幽怨。",
        "那堪往事思量遍。",
        "谁道绸缪两意坚。",
        "水萍风絮不相缘。",
        "舞鉴鸾肠虚寸断。",
        "芳容变。",
        "好将憔悴教伊见。"
      ],
      "author": {
        "id": 11741,
        "name": "杜安世"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313120,
      "title": "渔家傲",
      "content": [
        "每到春来长如病。",
        "玉容瘦与薄妆称。",
        "不惯被人抛掷。",
        "思当本。",
        "奈向后期全无定。",
        "早是厌厌愁欲凝。",
        "花间众禽愁难听。",
        "天赋多情翻成恨。",
        "有谁问。",
        "花屏一点炉烟暝。"
      ],
      "author": {
        "id": 11741,
        "name": "杜安世"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313121,
      "title": "剔银灯",
      "content": [
        "昨夜一场风雨。",
        "催促牡丹归去。",
        "孙武宫中，石崇楼下，多情怎生为主。",
        "真疑洛浦。",
        "云水算、杳无重数。",
        "独倚阑干凝伫。",
        "香片乱沾尘土。",
        "争似当初，不曾相见，免恁恼人肠肚。",
        "绿丛无语。",
        "空留得、宝刀翦处。"
      ],
      "author": {
        "id": 11741,
        "name": "杜安世"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313122,
      "title": "剔银灯",
      "content": [
        "夜永衾寒梦觉。",
        "翠屏共、绣帏灯照。",
        "就枕思量，离多会少。",
        "孤负小欢轻笑。",
        "风流争表。",
        "空惹尽、一生烦恼。",
        "写遍香笺，分剖鳞翼，路遥难到。",
        "泪眼愁肠，朝朝暮暮，去便不知音耗。",
        "终须拼了。",
        "别选个、如伊才调。"
      ],
      "author": {
        "id": 11741,
        "name": "杜安世"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313123,
      "title": "剔银灯",
      "content": [
        "好事争如不遇。",
        "可惜许、多情相误。",
        "月下风前，偷期窃会，共把衷肠分付。",
        "尤云𣨼雨。",
        "正缱绻、朝朝暮暮。",
        "无奈别离情绪。",
        "和酒病、双眉长聚。",
        "往事凄凉，佳音迢递，似此因缘谁做。",
        "洞云深处。",
        "暗回首、落花飞絮。"
      ],
      "author": {
        "id": 11741,
        "name": "杜安世"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313124,
      "title": "临江仙",
      "content": [
        "太史占天云物好，初阳律合黄锺。",
        "日缠南极北郊风。",
        "雪花先柳絮，飞舞透帘栊。",
        "圣运时和兼岁稔，歌欢处处皆同。",
        "簪声相庆晓光中。",
        "金炉红兽炭，一举寿杯空。"
      ],
      "author": {
        "id": 11741,
        "name": "杜安世"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313125,
      "title": "临江仙",
      "content": [
        "遍地残花庭院静，流莺对对相过。",
        "万条风柳间婆娑。",
        "樱桃初弄色，萱草自成窠。",
        "早是芳菲时节晚，追游期会无多。",
        "眉山敛翠近秋波。",
        "日长初睡起，愁与病相和。"
      ],
      "author": {
        "id": 11741,
        "name": "杜安世"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313126,
      "title": "采明珠",
      "content": [
        "雨乍收，小院尘消，云淡天高露冷。",
        "坐看月华生，射玉楼清莹。",
        "蟋蟀鸣金井。",
        "下帘帏、悄悄空阶，败叶坠风，惹动闲愁，千端万绪难整。",
        "秋夜永。",
        "凉天迥。",
        "可不念光景。",
        "嗟薄命。",
        "倏忽少年，忍交孤令。",
        "灯闪红窗影。",
        "步回廊、懒入香闺，暗落泪珠满面，谁人知我，为伊成病。"
      ],
      "author": {
        "id": 11741,
        "name": "杜安世"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313127,
      "title": "朝玉阶・朝天子",
      "content": [
        "春色欺人拂眼清。",
        "柳条绿丝软，雪花轻。",
        "黄金才钺掩银屏。",
        "阴沈深院静，语娇莺。",
        "美人春困宝钗横。",
        "惜花芳态，泪盈盈。",
        "风流何处最多情。",
        "千金一笑，须信倾城。"
      ],
      "author": {
        "id": 11741,
        "name": "杜安世"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313128,
      "title": "朝玉阶・朝天子",
      "content": [
        "帘卷春寒小雨天。",
        "牡丹花落尽，悄庭轩。",
        "高空双燕舞翩翩。",
        "无风轻絮坠，暗苔钱。",
        "拟将幽怨写香笺。",
        "中心多少事，语难传。",
        "思量真个恶因缘。",
        "那堪长梦见，在伊边。"
      ],
      "author": {
        "id": 11741,
        "name": "杜安世"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313129,
      "title": "卜算子",
      "content": [
        "深院花铺地。",
        "淡淡阴天气。",
        "水榭风亭朱明景，又别是、愁情味。",
        "有情奈无计。",
        "漫惹成憔悴。",
        "欲把罗巾暗传寄。",
        "细认取、斑点泪。"
      ],
      "author": {
        "id": 11741,
        "name": "杜安世"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313130,
      "title": "卜算子",
      "content": [
        "尊前一曲歌。",
        "歌里千重意，才欲歌时泪已流，恨应更、多于泪。",
        "试问缘何事。",
        "不语如痴醉。",
        "我亦情多不忍闻，怕和我、成憔悴。"
      ],
      "author": {
        "id": 11741,
        "name": "杜安世"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313131,
      "title": "瑞鹧鸪",
      "content": [
        "夜来风雨损馀芳。",
        "数片衰红落槛傍。",
        "媚景背人容易去，半轩飞絮日空长。",
        "从来不信相思切，及至如今倍感伤。",
        "独立黄昏绣帘外，可堪新月露圆光。"
      ],
      "author": {
        "id": 11741,
        "name": "杜安世"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313132,
      "title": "燕归梁",
      "content": [
        "风摆红绦卷画帘。",
        "宝鉴慵拈。",
        "日高梳洗几时忺。",
        "金盆水，弄纤纤。",
        "髻云松亸衣斜褪，和娇懒、瘦岩岩。",
        "离愁更被宿酲兼。",
        "空赢得，病厌厌。"
      ],
      "author": {
        "id": 11741,
        "name": "杜安世"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313133,
      "title": "菊花新",
      "content": [
        "怎奈花残又莺老。",
        "槛里青梅数枝小。",
        "新荷长池沼。",
        "当晴昼、燕子声闹。",
        "亭栏花绽颜色好。",
        "风雨催催、等闲开了。",
        "酒醒暗思量，无个事、甚刚烦恼。"
      ],
      "author": {
        "id": 11741,
        "name": "杜安世"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313134,
      "title": "菊花新",
      "content": [
        "坐卧双眉镇长敛。",
        "绣户初开花满院。",
        "罗帏翠屏空，风微动、玉炉烟飐。",
        "儿夫心肠多薄幸，百计思、难为拘捡。",
        "几回向伊言，交今后、更休抛闪。"
      ],
      "author": {
        "id": 11741,
        "name": "杜安世"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313135,
      "title": "鹊桥仙",
      "content": [
        "别离情绪，多方开解，却免厌厌似醉。",
        "楼高终日倚阑干，目断有、千山万水。",
        "妖娆薄媚，不禁抛摆，渐觉肌肤瘦悴。",
        "当初相见偶然间，不唤作、如今恁地。"
      ],
      "author": {
        "id": 11741,
        "name": "杜安世"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313136,
      "title": "鹊桥仙",
      "content": [
        "日长天气，深深庭院，又是春愁滋味。",
        "池边昨夜雨兼风，战红杏、馀香乱坠。",
        "阴阴亭榭，暖烟轻柳，万缕黄金窣地。",
        "一双新燕却重来，但暗把、罗巾掩泪。"
      ],
      "author": {
        "id": 11741,
        "name": "杜安世"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313137,
      "title": "虞美人",
      "content": [
        "红颜绿鬓催人老。",
        "世事何时了。",
        "君心天意与年光。",
        "春花未遍已秋霜。",
        "为谁忙。",
        "樽前正好闲风月。",
        "莫话生离别。",
        "直饶终日踏红尘。",
        "浮名浮利枉劳神。",
        "更愁萦。"
      ],
      "author": {
        "id": 11741,
        "name": "杜安世"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313138,
      "title": "虞美人",
      "content": [
        "江亭春晚芳菲尽。",
        "行色青天近。",
        "画桥杨柳也多情。",
        "暗抛飞絮惹前行。",
        "路尘清。",
        "彤庭早晚瞻虞舜。",
        "遥听恩迁峻。",
        "二年歌宴绮罗人。",
        "片云疏雨忍漂沦。",
        "泪沾巾。"
      ],
      "author": {
        "id": 11741,
        "name": "杜安世"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313139,
      "title": "虞美人",
      "content": [
        "炉香昼永龙烟白。",
        "风动金鸾额。",
        "画屏细展小山川。",
        "睡容初起枕痕圆。",
        "坠花钿。",
        "楼高不及烟霄半。",
        "望尽相思眼。",
        "艳阳刚爱挫愁天。",
        "故生芳草碧云连。",
        "怨王孙。"
      ],
      "author": {
        "id": 11741,
        "name": "杜安世"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313140,
      "title": "凤栖梧・蝶恋花",
      "content": [
        "秋日楼台在空际。",
        "画角声沈，历历寒更起。",
        "深院黄昏人独自。",
        "想伊遥共伤前事。",
        "懊恼当初无算计。",
        "些子欢娱，多少凄凉味。",
        "相去江山千万里。",
        "一回东望心如醉。"
      ],
      "author": {
        "id": 11741,
        "name": "杜安世"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313141,
      "title": "凤栖梧・蝶恋花",
      "content": [
        "任在芦花最深处。",
        "浪静风恬，又泛轻舟去。",
        "去到滩头遇俦侣。",
        "散唱狂歌鱼未取。",
        "不把身心干时务。",
        "一副轮竿，莫笑闲家具。",
        "待拟观光佐明主。",
        "将甚医他民病苦。"
      ],
      "author": {
        "id": 11741,
        "name": "杜安世"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313142,
      "title": "凤栖梧・蝶恋花",
      "content": [
        "别浦迟留恋清浅。",
        "菱蔓荷花，尽日妨钩线。",
        "向晚澄江静如练。",
        "风送归帆飞似箭。",
        "鸥鹭相将是家眷。",
        "坐对云山，一任炎凉变。",
        "定是寰区又清宴。",
        "不见龙骧波上战。"
      ],
      "author": {
        "id": 11741,
        "name": "杜安世"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313143,
      "title": "凤栖梧・蝶恋花",
      "content": [
        "闲把浮生细思算。",
        "百岁光阴，梦里销除半。",
        "白首为郎休浩叹。",
        "偷安自喜身强健。",
        "多少英贤裨圣旦。",
        "一个非才，深谢容疏懒。",
        "席上清歌珠一串。",
        "莫教欢会轻分散。"
      ],
      "author": {
        "id": 11741,
        "name": "杜安世"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313144,
      "title": "凤栖梧・蝶恋花",
      "content": [
        "新月羞光影庭树。",
        "窗外芭蕉，数点黄昏雨。",
        "何事秋来无意绪。",
        "玉容寂寞双眉聚。",
        "一点银釭扃绣户。",
        "莎砌寒蛩，历历啼声苦。",
        "孤枕夜长君信否。",
        "披衣颙坐魂飞去。"
      ],
      "author": {
        "id": 11741,
        "name": "杜安世"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313145,
      "title": "忆汉月",
      "content": [
        "红杏一枝遥见。",
        "凝露粉愁香怨。",
        "吹开吹谢任春风，恨流莺、不能拘管。",
        "曲池连夜雨，绿水上、碎红千片。",
        "直拟移来向深院。",
        "任凋零、不孤双眼。"
      ],
      "author": {
        "id": 11741,
        "name": "杜安世"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313146,
      "title": "诉衷情",
      "content": [
        "烧残绛蜡泪成痕。",
        "街鼓报黄昏。",
        "碧云又阻来信，廊上月侵门。",
        "愁永夜，拂香裀。",
        "待谁温。",
        "梦兰憔悴，掷果凄凉，两处消魂。"
      ],
      "author": {
        "id": 11741,
        "name": "杜安世"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313147,
      "title": "朝中措",
      "content": [
        "养花天气近清明。",
        "丝雨酿寒轻。",
        "满眼春工如绣。",
        "消磨不尽离情。",
        "行行又宿，小桃旧坞，芳草邮亭。",
        "唤起两眉新恨。",
        "绿杨深处啼莺。"
      ],
      "author": {
        "id": 11741,
        "name": "杜安世"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313148,
      "title": "折新荷引・折新荷",
      "content": [
        "雨过回廊，圆荷嫩绿新抽。",
        "越女轻盈，画桡稳泛兰舟。",
        "芳容艳粉，红香透、脉脉娇羞。",
        "菱歌隐隐渐遥，依约回眸。",
        "堤上郎心，波间妆影迟留。",
        "不觉归时，淡天碧衬蟾钩。",
        "风蝉噪晚，馀霞际、几点沙鸥。",
        "渔笛、不道有人，独倚危楼。"
      ],
      "author": {
        "id": 3680,
        "name": "赵"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313149,
      "title": "梅花曲",
      "content": [
        "汉宫中侍女，娇额半涂黄。",
        "盈盈粉色凌时，寒玉体、先透薄妆。",
        "好借月魂来，娉婷画烛旁。",
        "惟恐随、阳春好梦去，所思飞扬。",
        "宜向风亭把盏，酬孤艳，醉永夕何妨。",
        "雪径蕊、真凝密，降回舆、认暗香。",
        "不为藉我作和羹，肯放结子花狂。",
        "向上林，留此占年芳。"
      ],
      "author": {
        "id": 8955,
        "name": "刘几"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313150,
      "title": "梅花曲",
      "content": [
        "结子非贪，有香不俗，宜当鼎鼐尝。",
        "偶先红紫，度韶华、玉笛占年芳。",
        "众花杂色满上林，未能教、腊雪埋藏。",
        "却怕春风漏泄，一一尽天香。",
        "不须更御铅黄。",
        "知国色，禀自天真殊常。",
        "只裁云缕，奈芳滑、玉体想仙妆。",
        "少陵为尔东阁。",
        "美艳激诗肠。",
        "当已阴未雨春光。",
        "无心赋海棠。"
      ],
      "author": {
        "id": 8955,
        "name": "刘几"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313151,
      "title": "梅花曲",
      "content": [
        "浅浅池塘。",
        "深深庭院，复出短短垣墙。",
        "年年为尔，若九真巡会、宝惜流芳。",
        "向人自有，绵渺无言，深意深藏。",
        "倾国倾城，天教与、抵死芳香。",
        "袅须金色，轻危欲压，绰约冠中央。",
        "蒂团红蜡，兰肌粉艳巧能妆。",
        "婵娟一种风流，如雪如冰衣霓裳。",
        "永日依倚，春风笑野棠。"
      ],
      "author": {
        "id": 8955,
        "name": "刘几"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313152,
      "title": "花发状元红慢",
      "content": [
        "三春向暮，万卉成阴、有嘉艳方坼。",
        "娇姿嫩质。",
        "冠群品，共赏倾城倾国。",
        "上苑晴昼暄，千素万红尤奇特。",
        "绮筵开，会咏歌才子，压倒元白。",
        "别有芳幽苞小，步障华丝，绮轩油壁。",
        "与紫鸳鸯、素蛱蝶。",
        "自清旦、往往连夕。",
        "巧莺喧翠管，娇燕语雕梁留客。",
        "武陵人，念梦役意浓，堪遣情溺。"
      ],
      "author": {
        "id": 8955,
        "name": "刘几"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313153,
      "title": "减字木兰花",
      "content": [
        "绿杨阴下。",
        "短帽轻衫行信马。",
        "过尽春风。",
        "踏尽青青打尽红。",
        "舞鸾歌凤。",
        "人面湖光红影动。",
        "醉眼归时。",
        "人在朱楼曲角西。"
      ],
      "author": {
        "id": 6952,
        "name": "元绛"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313154,
      "title": "映山红慢",
      "content": [
        "谷雨风前，占淑景、名花独秀。",
        "露国色仙姿，品流第一，春工成就。",
        "罗帏护日金泥皱。",
        "映霞腮动檀痕溜。",
        "长记得天上，瑶池阆苑曾有。",
        "千匝绕、红玉阑干，愁只恐、朝云难久。",
        "须款折、绣囊剩戴，细把蜂须频嗅。",
        "佳人再拜抬娇面，敛红巾、捧金杯酒。",
        "献千千寿。",
        "愿长恁、天香满袖。"
      ],
      "author": {
        "id": 6952,
        "name": "元绛"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313155,
      "title": "渔家傲",
      "content": [
        "折柳赠君君且住。"
      ],
      "author": {
        "id": 7842,
        "name": "程师孟"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313156,
      "title": "望江南・忆江南",
      "content": [
        "中黄宝，须向胆中求。",
        "春帝令行生万物，乾坤膝下与吾俦。",
        "百脉自流通。",
        "施造化，左右火双抽。",
        "浩浩腾腾充宇宙，苦烟袅袅上环楼。",
        "夫妇渐相谋。"
      ],
      "author": {
        "id": 3886,
        "name": "陈朴"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313157,
      "title": "望江南・忆江南",
      "content": [
        "玄珠降，丹窟在中宫。",
        "九候息调重九数，赤波忽迸太阳东。",
        "心肾始交通。",
        "逢六变，重六息阴功。",
        "火自海门朝帝坐，水从莲沼佐丁公。",
        "紫电透玲珑。"
      ],
      "author": {
        "id": 3886,
        "name": "陈朴"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313158,
      "title": "望江南・忆江南",
      "content": [
        "毛发落，丹左运行阳。",
        "胎色渐红阴渐小，推移岁运助干刚。",
        "育火养中央。",
        "成物象，五岳辨微茫。",
        "出入尚迟形尚小，晨昏天籁奏笙簧。",
        "常饮玉壶浆。"
      ],
      "author": {
        "id": 3886,
        "name": "陈朴"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313159,
      "title": "望江南・忆江南",
      "content": [
        "丹往右，四转运行阴。",
        "逢六闭藏阳户气，玉关泉透合丁壬。",
        "龟戏任浮沉。",
        "时出入，无碍贯他心。",
        "游戏神通常出面，圆光周匝绕千寻。",
        "寒暑不相侵。"
      ],
      "author": {
        "id": 3886,
        "name": "陈朴"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313160,
      "title": "望江南・忆江南",
      "content": [
        "珠自右，飞电入丹城。",
        "内养婴儿盈尺象，时逢九数采阳精。",
        "火向水中生。",
        "烧鬼岳，紫殿势峥嵘。",
        "随意出游寰海内，寐如砂碛卧长鲸。",
        "时序与偕行。"
      ],
      "author": {
        "id": 3886,
        "name": "陈朴"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313161,
      "title": "望江南・忆江南",
      "content": [
        "日精满，阴魄化无形。",
        "每遇月圆开北户，神龟时饮碧瑶玲。",
        "形魄岂能停。",
        "阳砂赤，阴粉色微青。",
        "粉换肉肌砂换骨，凡胎换尽圣胎灵。",
        "飞举似流星。"
      ],
      "author": {
        "id": 3886,
        "name": "陈朴"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313162,
      "title": "望江南・忆江南",
      "content": [
        "形透日，七转任飞腾。",
        "幽入深岩图宴坐，息无来去使神凝。",
        "却粒著奇能。",
        "生神火，返本气清澄。",
        "九候浴时开地户，月中取火日求冰。",
        "五内换重新。"
      ],
      "author": {
        "id": 3886,
        "name": "陈朴"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313163,
      "title": "望江南・忆江南",
      "content": [
        "内外遍，八转始还元。",
        "地带长垂生坎户，周行胎息贯天门。",
        "太始道方存。",
        "纯一体，黑赤气常喷。",
        "丹火发来烧内境，冷泉深处浴猴孙。",
        "神水赤龟吞。"
      ],
      "author": {
        "id": 3886,
        "name": "陈朴"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313164,
      "title": "望江南・忆江南",
      "content": [
        "丹九转，纯一太初颜。",
        "内外无为常抱朴，纵横海外与人间。",
        "功行积丘山。",
        "青阙诏，玉简赐金环。",
        "饮罢刀圭乘羽驾，旌幢箫鼓过天关。",
        "朝帝列仙班。"
      ],
      "author": {
        "id": 3886,
        "name": "陈朴"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313165,
      "title": "西江月",
      "content": [
        "内药还同外药，内通外亦须通。",
        "丹头和合类相同。",
        "温养两般作用。",
        "内有天然真火，炉中赫赫长红。",
        "外炉增减要勤功。",
        "妙绝无过真种。"
      ],
      "author": {
        "id": 10808,
        "name": "张伯端"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313166,
      "title": "西江月",
      "content": [
        "此道至神至圣，忧君分薄难消。",
        "调和铅汞不终朝。",
        "早睹玄珠形兆。",
        "志士若能修炼，何妨在市居朝。",
        "工夫容易药非遥。",
        "说破人须失笑。"
      ],
      "author": {
        "id": 10808,
        "name": "张伯端"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313167,
      "title": "西江月",
      "content": [
        "白虎首经至宝，华池神水真金。",
        "故知上善利源深。",
        "不比寻常药品。",
        "若要修成九转，先须炼己持心。",
        "依时采取定浮沈。",
        "进火须防危甚。"
      ],
      "author": {
        "id": 10808,
        "name": "张伯端"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313168,
      "title": "西江月",
      "content": [
        "若要真铅留汞，亲中不离家臣。",
        "木金间隔会无因。",
        "须仗媒人勾引。",
        "本性爱金顺义，金情恋木慈仁。",
        "相吞相陷却相亲。",
        "始觉男儿有孕。"
      ],
      "author": {
        "id": 10808,
        "name": "张伯端"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313169,
      "title": "西江月",
      "content": [
        "二八谁家姹女，九三何处郎君。",
        "自称木液与金精。",
        "遇土却成三性。",
        "更假丁公煅炼，夫妻始结欢情。",
        "河车不敢暂留停。",
        "运入昆仑峰顶。"
      ],
      "author": {
        "id": 10808,
        "name": "张伯端"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313170,
      "title": "西江月",
      "content": [
        "七返朱砂反本，九还金液还真。",
        "休将寅子数坤申。",
        "但要五行成准。",
        "本是水银一味，周流遍历诸辰。",
        "阴阳数足自通神。",
        "出入岂离玄牝。"
      ],
      "author": {
        "id": 10808,
        "name": "张伯端"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313171,
      "title": "西江月",
      "content": [
        "雄里内含雌质，负阴抱却阳精。",
        "两般和合药方成。",
        "点化魄纤魂胜。",
        "信道金丹一粒，蛇吞立变龙形。",
        "鸡餐亦乃化鸾鹏。",
        "飞入真阳清境。"
      ],
      "author": {
        "id": 10808,
        "name": "张伯端"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313172,
      "title": "西江月",
      "content": [
        "天地才经否泰，朝昏好识屯蒙。",
        "辐来辏毂水朝宗。",
        "妙在抽添运用。",
        "得一万般皆毕，休分南北西东。",
        "损之又损慎前功。",
        "命宝不宜轻弄。"
      ],
      "author": {
        "id": 10808,
        "name": "张伯端"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313173,
      "title": "西江月",
      "content": [
        "冬至一阳来服，三旬增一阳爻。",
        "月中复卦溯晨潮。",
        "望罢干终姤兆。",
        "日又别为寒暑，阳生复起中宵。",
        "午时姤象一阴朝。",
        "炼药须知昏晓。"
      ],
      "author": {
        "id": 10808,
        "name": "张伯端"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313174,
      "title": "西江月",
      "content": [
        "不辨五行四象，那分朱汞铅银。",
        "修丹火候未曾闻。",
        "早便称呼居隐。",
        "不背自思己错，更将错路教人。",
        "误他永劫在迷津。",
        "似恁欺心安忍。"
      ],
      "author": {
        "id": 10808,
        "name": "张伯端"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313175,
      "title": "西江月",
      "content": [
        "德行修逾八百，阴功积满三千。",
        "均齐物我与亲冤。",
        "始合神仙本愿。",
        "虎兕刀兵不害，无常火宅难牵。",
        "宝符降后去朝天。",
        "稳驾鸾车凤辇。"
      ],
      "author": {
        "id": 10808,
        "name": "张伯端"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313176,
      "title": "西江月",
      "content": [
        "牛女情缘道合，龟蛇类秉天然。",
        "蟾乌遇朔合婵娟。",
        "二气相资运转。",
        "本是乾坤妙用，谁能达此深渊。",
        "阳阴否隔却成愆。",
        "怎得天长地远。"
      ],
      "author": {
        "id": 10808,
        "name": "张伯端"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313177,
      "title": "西江月",
      "content": [
        "丹是色身至宝，炼成变化无穷。",
        "更于性上究真宗。",
        "决了死生妙用。",
        "不待他身后世，现前获福神通。",
        "自从龙虎著斯功。",
        "尔后谁能继踵。"
      ],
      "author": {
        "id": 10808,
        "name": "张伯端"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313178,
      "title": "西江月",
      "content": [
        "妄想不须强灭，真如何必希求。",
        "本源自性佛齐修。",
        "迷悟岂拘先后。",
        "悟则刹那成佛。",
        "迷则万劫沦流。",
        "若能一念契真修。",
        "灭尽恒沙罪垢。"
      ],
      "author": {
        "id": 10808,
        "name": "张伯端"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313179,
      "title": "西江月",
      "content": [
        "本自无生无灭，强将生灭区分。",
        "只如罪福亦何根。",
        "妙体何曾增损。",
        "我有一轮明镜，从来只为蒙分。",
        "今朝磨莹照乾坤。",
        "万象超然难隐。"
      ],
      "author": {
        "id": 10808,
        "name": "张伯端"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313180,
      "title": "西江月",
      "content": [
        "我性入诸佛性，诸方佛性皆然。",
        "亭亭蟾影照寒泉。",
        "一月千潭普现。",
        "小则毫分莫识，大时遍满三千。",
        "高低不约信方圆。",
        "说甚短长深浅。"
      ],
      "author": {
        "id": 10808,
        "name": "张伯端"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313181,
      "title": "西江月",
      "content": [
        "法法法元无法，空空空亦非空。",
        "静喧语默本来同。",
        "梦里何曾说梦。",
        "有用用中无用，无功功里施功。",
        "还如果熟自然红。",
        "莫问如何修种。"
      ],
      "author": {
        "id": 10808,
        "name": "张伯端"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313182,
      "title": "西江月",
      "content": [
        "善恶一时妄念，荣枯都不关心。",
        "晦明隐显任浮沈。",
        "随分肌餐渴饮。",
        "神静湛然常寂，不妨坐卧歌吟。",
        "一池秋水碧仍深。",
        "风动鱼惊尽任。"
      ],
      "author": {
        "id": 10808,
        "name": "张伯端"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313183,
      "title": "西江月",
      "content": [
        "对镜不须强灭，假名权立菩提。",
        "色空明暗本来齐。",
        "真妄体分两种。",
        "悟则便名静土，更无天竺曹溪。",
        "谁言极乐在天西。",
        "了则弥陀出世。"
      ],
      "author": {
        "id": 10808,
        "name": "张伯端"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313184,
      "title": "西江月",
      "content": [
        "人我众生寿者，宁分彼此高低。",
        "法身通照没吾伊。",
        "念念体分同异。",
        "见是何曾是是，闻非未必非非。",
        "往来诸用不相知。",
        "生死谁能碍你。"
      ],
      "author": {
        "id": 10808,
        "name": "张伯端"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313185,
      "title": "西江月",
      "content": [
        "住想修行布施，果报不离天人。",
        "恰如仰箭射浮云。",
        "坠落祗缘力尽。",
        "争似无为实相，还须返朴归淳。",
        "境忘情性任天真。",
        "以证无生法忍。"
      ],
      "author": {
        "id": 10808,
        "name": "张伯端"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313186,
      "title": "西江月",
      "content": [
        "鱼兔若还入手，自然忘却筌蹄。",
        "渡河筏子上天梯。",
        "到彼悉皆遗弃。",
        "未悟须凭言说，悟来言说皆非。",
        "虽然四句属无为。",
        "此等何须脱离。"
      ],
      "author": {
        "id": 10808,
        "name": "张伯端"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313187,
      "title": "西江月",
      "content": [
        "悟了莫求寂灭，随缘只接群迷。",
        "寻常邪见及提携。",
        "方便指归实际。",
        "五眼三身四智，六度万行修齐。",
        "圆光一颗好摩尼。",
        "利物兼能自利。"
      ],
      "author": {
        "id": 10808,
        "name": "张伯端"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313188,
      "title": "西江月",
      "content": [
        "我见时人说性，只夸口急酬机。",
        "及逢境界转痴迷。",
        "又与愚人何异。",
        "说得便须行得，方名言行无亏。",
        "能将慧剑斩魔魑。",
        "此号如来正智。"
      ],
      "author": {
        "id": 10808,
        "name": "张伯端"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313189,
      "title": "西江月",
      "content": [
        "欲了无生妙道，莫如自见真心。",
        "真心无相亦无音。",
        "清净法身只恁。",
        "此道非无外有，非中亦莫求寻。",
        "二边俱遣弃中心。",
        "见了名为上品。"
      ],
      "author": {
        "id": 10808,
        "name": "张伯端"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313190,
      "title": "满庭芳",
      "content": [
        "真铁牛儿，形容丑恶，性刚偏好争驰。",
        "人人皆有，那角解牵骑。",
        "种就黄芽满院，更须用、神水浇之。",
        "宫里，若无此兽，安得似婴儿。",
        "乾坤真动静，生成家活，总赖于伊。",
        "饥餐虎髓，渴饮水银池。",
        "夜半牵车进火，霞光迸、海底腾辉。",
        "牧童笑，华池宴罢，乘个月明归。"
      ],
      "author": {
        "id": 10808,
        "name": "张伯端"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313191,
      "title": "凤栖梧・蝶恋花",
      "content": [
        "蜀道青天烟霭翳。",
        "帝里繁华、迢递何时至。",
        "回望锦川挥粉泪。",
        "凤钗斜亸乌云腻。",
        "钿带双垂金缕细。",
        "玉珮玎珰，露滴寒如水。",
        "从此鸾妆添远意。",
        "画眉学得遥山翠。"
      ],
      "author": {
        "id": 2438,
        "name": "卢氏"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313192,
      "title": "家山好",
      "content": [
        "挂冠归去旧烟萝。",
        "闲身健，养天和。",
        "功名富贵非由我，莫贪他。",
        "这歧路、足风波。",
        "水晶宫里家山好，物外胜游多。",
        "晴溪短棹，时时醉唱里棱罗。",
        "天公奈我何。"
      ],
      "author": {
        "id": 6102,
        "name": "刘述"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313193,
      "title": "合宫歌",
      "content": [
        "缵重明。",
        "端拱保凝命。",
        "广大孝休德，永锡四海有庆。",
        "觚坛寓礼正典名。",
        "幔室雅奏，彩仗崇制定。",
        "五位仿古甚盛。",
        "蒿宫光符辰星。",
        "高秋嘉时款芎灵。",
        "交累圣。",
        "上下来顾，寅畏歆纯诚。",
        "三阶平。",
        "金气肃，转和景。",
        "翠葆御双观，巽风兑泽布令。",
        "脂茶刬荡墨索清。",
        "远迩向附，动植咸遂性。",
        "表里穆悦，庶政醇醲，熙然胥庭。",
        "唐舜华封祝，如南山寿永。",
        "愿今广怀宁延，昌基扃。"
      ],
      "author": {
        "id": 10863,
        "name": "赵祯"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313194,
      "title": "沁园春",
      "content": [
        "华发青云。"
      ],
      "author": {
        "id": 886,
        "name": "王拱辰"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313195,
      "title": "好事近",
      "content": [
        "瑞雪满京都，宫殿尽成银阙。",
        "常对素光遥望，是江梅时节。",
        "如今江上见寒梅，幽香自清绝。",
        "重看落英残艳，想飘零如雪。"
      ],
      "author": {
        "id": 12840,
        "name": "蔡襄"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    }
