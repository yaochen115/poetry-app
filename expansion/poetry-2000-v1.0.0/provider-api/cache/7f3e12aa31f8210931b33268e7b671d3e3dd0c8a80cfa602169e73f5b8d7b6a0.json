{
  "data": [
    {
      "id": 377915,
      "title": "梦江南·梦江南·含泥燕",
      "content": [
        "含泥燕，飞到画堂前。",
        "占得杏梁安稳处，休轻唯有主人怜，堪羡好因缘。"
      ],
      "author": {
        "id": 12058,
        "name": "牛峤"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377916,
      "title": "梦江南·梦江南·红绣被",
      "content": [
        "红绣被，两两间鸳鸯。",
        "不是鸟中偏爱尔，为缘交颈睡南塘，全胜薄情郎。"
      ],
      "author": {
        "id": 12058,
        "name": "牛峤"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377917,
      "title": "感恩多·感恩多·两条红粉泪",
      "content": [
        "两条红粉泪，多少香闺意。",
        "强攀桃李枝，敛愁眉。",
        "陌上莺啼蝶舞，柳花飞。",
        "柳花飞，愿得郎心，忆家还早归。"
      ],
      "author": {
        "id": 12058,
        "name": "牛峤"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377918,
      "title": "感恩多·感恩多·自从南浦别",
      "content": [
        "自从南浦别，愁见丁香结。",
        "近来情转深，忆鸳衾。",
        "几度将书托烟雁，泪盈襟。",
        "泪盈襟，礼月求天，愿君知我心。"
      ],
      "author": {
        "id": 12058,
        "name": "牛峤"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377919,
      "title": "应天长·应天长·玉楼春望晴烟灭",
      "content": [
        "玉楼春望晴烟灭，舞衫斜卷金条脱。",
        "黄鹂娇啭声初歇，杏花飘尽龙山雪。",
        "凤钗低赴节，筵上王孙愁绝。",
        "鸳鸯对含罗结，两情深夜月。"
      ],
      "author": {
        "id": 12058,
        "name": "牛峤"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377920,
      "title": "应天长·应天长·双眉淡薄藏心事",
      "content": [
        "双眉淡薄藏心事，清夜背灯娇又醉。",
        "玉钗横，山枕腻，宝帐鸳鸯春睡美。",
        "别经时，无限意，虚道相思憔悴。",
        "莫信彩笺书里，赚人肠断字。"
      ],
      "author": {
        "id": 12058,
        "name": "牛峤"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377921,
      "title": "更漏子·更漏子·星渐稀",
      "content": [
        "星渐稀，漏频转，何处轮台声怨。",
        "香阁掩，杏花红，月明杨柳风。",
        "挑锦字，记情事，惟愿两心相似。",
        "收泪语，背灯眠，玉钗横枕边。"
      ],
      "author": {
        "id": 12058,
        "name": "牛峤"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377922,
      "title": "更漏子·更漏子·春夜阑",
      "content": [
        "春夜阑，更漏促，金烬暗挑残烛。",
        "惊梦断，锦屏深，两乡明月心。",
        "闺草碧，望归客，还是不知消息。",
        "辜负我，悔怜君，靠天天不闻。"
      ],
      "author": {
        "id": 12058,
        "name": "牛峤"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377923,
      "title": "更漏子·更漏子·南浦情",
      "content": [
        "南浦情，红粉泪，怎奈两人深意。",
        "低翠黛，卷征衣，马嘶霜叶飞。",
        "招手别，寸肠结，还是去年时节。",
        "书托雁，梦归家，觉来江月斜。"
      ],
      "author": {
        "id": 12058,
        "name": "牛峤"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377924,
      "title": "望江怨·望江怨·东风急",
      "content": [
        "东风急，惜别花时手频执。",
        "罗帷愁独入，马嘶残雨春芜湿。",
        "倚门立，寄语薄情郎，粉香和泪泣。"
      ],
      "author": {
        "id": 12058,
        "name": "牛峤"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377925,
      "title": "菩萨蛮·菩萨蛮·舞裙香暖金泥凤",
      "content": [
        "舞裙香暖金泥凤，画梁语燕惊残梦。",
        "门外柳花飞，玉郎犹未归。",
        "愁匀红粉泪，眉剪春山翠。",
        "何处是辽阳，锦屏春昼长。"
      ],
      "author": {
        "id": 12058,
        "name": "牛峤"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377926,
      "title": "菩萨蛮·菩萨蛮·柳花飞处莺声急",
      "content": [
        "柳花飞处莺声急，暗街春色香车立。",
        "金凤小帘开，脸波和恨来。",
        "今宵求梦想，难到青楼上。",
        "赢得一场愁，鸳衾谁并头。"
      ],
      "author": {
        "id": 12058,
        "name": "牛峤"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377927,
      "title": "菩萨蛮·菩萨蛮·玉钗风动春幡急",
      "content": [
        "玉钗风动春幡急，交枝红杏笼烟泣。",
        "楼上望卿卿，窗寒新雨晴。",
        "熏炉蒙翠被，绣帐鸳鸯睡。",
        "何处有相知，羡他初画眉。"
      ],
      "author": {
        "id": 12058,
        "name": "牛峤"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377928,
      "title": "菩萨蛮·菩萨蛮·画屏重叠巫阳翠",
      "content": [
        "画屏重叠巫阳翠，楚神尚有行云意。",
        "朝暮几般心，向他情漫深。",
        "风流今古隔，虚作瞿塘客。",
        "山月照山花，梦回灯影斜。"
      ],
      "author": {
        "id": 12058,
        "name": "牛峤"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377929,
      "title": "菩萨蛮·菩萨蛮·风帘燕舞莺啼柳",
      "content": [
        "风帘燕舞莺啼柳，妆台约鬓低纤手。",
        "钗重髻盘珊，一枝红牡丹。",
        "门前行乐客，白马嘶春色。",
        "故故坠金鞭，回头应眼穿。"
      ],
      "author": {
        "id": 12058,
        "name": "牛峤"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377930,
      "title": "菩萨蛮·菩萨蛮·绿云鬓上飞金雀",
      "content": [
        "绿云鬓上飞金雀，愁眉敛翠春烟薄。",
        "香阁掩芙蓉，画屏山几重。",
        "窗寒天欲曙，犹结同心苣。",
        "啼粉污罗衣，问郎何日归。"
      ],
      "author": {
        "id": 12058,
        "name": "牛峤"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377931,
      "title": "菩萨蛮·菩萨蛮·玉楼冰簟鸳鸯锦",
      "content": [
        "玉楼冰簟鸳鸯锦，粉融香汗流山枕。",
        "帘外辘轳声，敛眉含笑惊。",
        "柳阴烟漠漠，低鬓蝉钗落。",
        "须作一生拌，尽君今日欢。"
      ],
      "author": {
        "id": 12058,
        "name": "牛峤"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377932,
      "title": "酒泉子·酒泉子·记得去年",
      "content": [
        "记得去年，烟暖杏园。",
        "花正发，雪飘香，江草绿，柳丝长。",
        "钿车纤手卷帘望，眉学春山样。",
        "凤钗低袅翠鬟上，落梅妆。"
      ],
      "author": {
        "id": 12058,
        "name": "牛峤"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377933,
      "title": "定西番·定西番·紫塞月明千里",
      "content": [
        "紫塞月明千里，金甲冷，戍楼寒，梦长安。",
        "乡思望中天阔，漏残星亦残。",
        "画角数声呜咽，雪漫漫。"
      ],
      "author": {
        "id": 12058,
        "name": "牛峤"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377934,
      "title": "玉楼春·玉楼春·春入横塘摇浅浪",
      "content": [
        "春入横塘摇浅浪，花落小园空惆怅。",
        "此情谁信为狂夫，恨翠愁红流枕上。",
        "小玉窗前嗔燕语，红泪滴窗金线缕。",
        "雁归不见报郎归，织成锦字封过与。"
      ],
      "author": {
        "id": 12058,
        "name": "牛峤"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377935,
      "title": "西溪子·西溪子·捍拨双盘金凤",
      "content": [
        "捍拨双盘金凤，蝉鬓玉钗摇动。",
        "画堂前，人不语，弦解语。",
        "弹到《昭君怨》处，翠蛾愁，不抬头。"
      ],
      "author": {
        "id": 12058,
        "name": "牛峤"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377936,
      "title": "江城子·江城子·䴔䴖飞起郡城东",
      "content": [
        "䴔䴖飞起郡城东，碧江空，半滩风。",
        "越王宫殿，苹叶藕花中。",
        "帘卷水楼鱼浪起，千片雪，雨蒙蒙。"
      ],
      "author": {
        "id": 12058,
        "name": "牛峤"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377937,
      "title": "江城子·江城子·极浦烟消水鸟飞",
      "content": [
        "极浦烟消水鸟飞，离筵分首时，送金卮。",
        "渡口杨花，狂雪任风吹。",
        "日暮天空波浪急，芳草岸，雨如丝。"
      ],
      "author": {
        "id": 12058,
        "name": "牛峤"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377938,
      "title": "浣溪沙·浣溪沙·钿毂香车过柳堤",
      "content": [
        "钿毂香车过柳堤，桦烟分处马频嘶，为他沉醉不成泥。",
        "花满驿亭香露细，杜鹃声断玉蟾低，含情无语倚楼西。"
      ],
      "author": {
        "id": 645,
        "name": "张泌"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377939,
      "title": "浣溪沙·浣溪沙·马上凝情忆旧游",
      "content": [
        "马上凝情忆旧游，照花淹竹小溪流，钿筝罗幕玉搔头。",
        "早是出门长带月，可堪分袂又经秋，晚风斜日不胜愁。"
      ],
      "author": {
        "id": 645,
        "name": "张泌"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377940,
      "title": "浣溪沙·浣溪沙·独立寒阶望月华",
      "content": [
        "独立寒阶望月华，露浓香泛小庭花，绣屏愁背一灯斜。",
        "云雨自从分散后，人间无路到仙家，但凭魂梦访天涯。"
      ],
      "author": {
        "id": 645,
        "name": "张泌"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377941,
      "title": "浣溪沙·浣溪沙·依约残眉理旧黄",
      "content": [
        "依约残眉理旧黄，翠鬟抛掷一簪长，暖风晴日罢朝妆。",
        "闲折海棠看又捻，玉纤无力惹余香，此情谁会倚斜阳。"
      ],
      "author": {
        "id": 645,
        "name": "张泌"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377942,
      "title": "浣溪沙·浣溪沙·翡翠屏开绣幄红",
      "content": [
        "翡翠屏开绣幄红，谢娥无力晓妆慵，锦帷鸳被宿香浓。",
        "微雨小庭春寂寞，燕飞莺语隔帘栊，杏花凝恨倚东风。"
      ],
      "author": {
        "id": 645,
        "name": "张泌"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377943,
      "title": "浣溪沙·浣溪沙·枕障熏炉隔绣帷",
      "content": [
        "枕障熏炉隔绣帷，二年终日两相思，杏花明月始应知。",
        "天上人间何处去，旧欢新梦觉来时，黄昏微雨画帘垂。"
      ],
      "author": {
        "id": 645,
        "name": "张泌"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377944,
      "title": "浣溪沙·浣溪沙·花月香寒悄夜尘",
      "content": [
        "花月香寒悄夜尘，绮筵幽会暗伤神，婵娟依约画屏人。",
        "人不见时还暂语，令才抛后爱微颦，越罗巴锦不胜春。"
      ],
      "author": {
        "id": 645,
        "name": "张泌"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377945,
      "title": "浣溪沙·浣溪沙·偏戴花冠白玉簪",
      "content": [
        "偏戴花冠白玉簪，睡容新起意沉吟，翠钿金缕镇眉心。",
        "小槛日斜风悄悄，隔帘零落杏花阴，断香轻碧锁愁深。"
      ],
      "author": {
        "id": 645,
        "name": "张泌"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377946,
      "title": "浣溪沙·浣溪沙·晚逐香车入凤城",
      "content": [
        "晚逐香车入凤城，东风斜揭绣帘轻，慢回娇眼笑盈盈。",
        "消息未通何计是，便须佯醉且随行，依稀闻道太狂生。"
      ],
      "author": {
        "id": 645,
        "name": "张泌"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377947,
      "title": "浣溪沙·浣溪沙·小市东门欲雪天",
      "content": [
        "小市东门欲雪天，众中依约见神仙，蕊黄香画贴金蝉。",
        "饮散黄昏人草草，醉容无语立门前，马嘶尘烘一街烟。"
      ],
      "author": {
        "id": 645,
        "name": "张泌"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377948,
      "title": "临江仙·临江仙·烟收湘渚秋江静",
      "content": [
        "烟收湘渚秋江静，蕉花露泣愁红。",
        "五云双鹤去无踪，几回魂断，凝望向长空。",
        "翠竹暗留珠泪怨，闲调宝瑟波中，花鬟月鬓绿云重。",
        "古祠深殿，香冷雨和风。"
      ],
      "author": {
        "id": 645,
        "name": "张泌"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377949,
      "title": "女冠子·女冠子·露花烟草",
      "content": [
        "露花烟草，寂寞五云三岛，春正深。",
        "貌减潜消玉，香残尚惹襟。",
        "竹疏虚槛静，松密醮坛阴。",
        "何事刘郎去，信沉沉。"
      ],
      "author": {
        "id": 645,
        "name": "张泌"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377950,
      "title": "河传·河传·渺莽云水",
      "content": [
        "渺莽云水，惆怅暮帆，去程迢递。",
        "夕阳芳草，千里万里，雁声无限起。",
        "梦魂悄断烟波里，心如醉。",
        "相见何处是，锦屏香冷无睡，被头多少泪。"
      ],
      "author": {
        "id": 645,
        "name": "张泌"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377951,
      "title": "河传·河传·红杏",
      "content": [
        "红杏，交枝相映，密密蒙蒙。",
        "一庭浓艳倚东风，香融，透帘栊。",
        "斜阳似共春光语，蝶争舞，更引流莺妒。",
        "魂销千片玉樽前，神仙，瑶池醉暮天。"
      ],
      "author": {
        "id": 645,
        "name": "张泌"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377952,
      "title": "酒泉子·酒泉子·春雨打窗",
      "content": [
        "春雨打窗，惊梦觉来天气晓。",
        "画堂深，红焰小，背兰釭。",
        "酒香喷鼻懒开缸，惆怅更无人共醉。",
        "旧巢中，新燕子，语双双。"
      ],
      "author": {
        "id": 645,
        "name": "张泌"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377953,
      "title": "酒泉子·酒泉子·紫陌青门",
      "content": [
        "紫陌青门，三十六宫春色。",
        "御沟辇路暗相通，杏园风。",
        "咸阳沽酒宝钗空，笑指未央归去。",
        "插花走马落残红，月明中。"
      ],
      "author": {
        "id": 645,
        "name": "张泌"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377954,
      "title": "生查子·生查子·相见稀",
      "content": [
        "相见稀，喜相见，相见还相远。",
        "檀画荔枝红，金蔓晴蜓软。",
        "鱼雁疏，芳信断，花落庭阴晚。",
        "可怜玉肌肤，消瘦成慵懒。"
      ],
      "author": {
        "id": 645,
        "name": "张泌"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377955,
      "title": "思越人·思越人·燕双飞",
      "content": [
        "燕双飞，莺百啭，越波堤下长桥。",
        "斗钿花筐金匣，恰舞衣罗薄纤腰。",
        "东风淡荡慵无力，黛眉愁聚春碧。",
        "满地落花无消息，月明肠断空忆。"
      ],
      "author": {
        "id": 645,
        "name": "张泌"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377956,
      "title": "满宫花·满宫花·花正芳",
      "content": [
        "花正芳，楼似绮，寂寞上阳宫里。",
        "钿笼金销睡鸳鸯，帘冷露华珠翠。",
        "娇艳轻盈香雪腻，细雨黄莺双起。",
        "东风惆怅欲清明，公子桥边沉醉。"
      ],
      "author": {
        "id": 645,
        "name": "张泌"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377957,
      "title": "柳枝·柳枝·腻粉琼妆透碧纱",
      "content": [
        "腻粉琼妆透碧纱，雪休夸。",
        "金凤搔头堕鬓斜，发交加。",
        "倚着云屏新睡觉，思梦笑。",
        "红腮隐出枕函花，有些些。"
      ],
      "author": {
        "id": 645,
        "name": "张泌"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377958,
      "title": "南歌子·南歌子·柳色遮楼暗",
      "content": [
        "柳色遮楼暗，桐花落砌香。",
        "画堂开处远风凉，高卷水晶帘额，衬斜阳。"
      ],
      "author": {
        "id": 645,
        "name": "张泌"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377959,
      "title": "南歌子·南歌子·岸柳拖烟绿",
      "content": [
        "岸柳拖烟绿，庭花照日红。",
        "数声蜀魄入帘栊，惊断碧窗残梦，画屏空。"
      ],
      "author": {
        "id": 645,
        "name": "张泌"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377960,
      "title": "南歌子·南歌子·锦荐红㶉𫛶",
      "content": [
        "锦荐红㶉𫛶，罗衣绣凤凰。",
        "绮疏飘雪北风狂，帘幕尽垂无事，郁金香。"
      ],
      "author": {
        "id": 645,
        "name": "张泌"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377961,
      "title": "江城子·江城子·碧栏干外小中庭",
      "content": [
        "碧栏干外小中庭，雨初晴，晓莺声。",
        "飞絮落花，时节近清明。",
        "睡起卷帘无一事，匀面了，没心情。"
      ],
      "author": {
        "id": 645,
        "name": "张泌"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377962,
      "title": "江城子·江城子·浣花溪上见卿卿",
      "content": [
        "浣花溪上见卿卿，脸波明，黛眉轻。",
        "绿云高绾，金族小蜻蜓。",
        "好是问他来得么？",
        "和笑道：莫多情。"
      ],
      "author": {
        "id": 645,
        "name": "张泌"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377963,
      "title": "河渎神·河渎神·古树噪寒鸦",
      "content": [
        "古树噪寒鸦，满庭枫叶芦花。",
        "昼灯当午隔轻纱，画阁珠帘影斜。",
        "门外往来祈赛客，翩翩帆落天涯。",
        "回首隔江烟火，渡头三两人家。"
      ],
      "author": {
        "id": 645,
        "name": "张泌"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377964,
      "title": "蝴蝶儿·蝴蝶儿·蝴蝶儿",
      "content": [
        "蝴蝶儿，晚春时，阿娇初着淡黄衣，倚窗学画伊。",
        "还似花间见，双双对对飞。",
        "无端和泪拭胭脂，惹教双翅垂。"
      ],
      "author": {
        "id": 645,
        "name": "张泌"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377965,
      "title": "虞美人·虞美人·鸳鸯对浴银塘暖",
      "content": [
        "鸳鸯对浴银塘暖，水面蒲稍短。",
        "垂杨低拂曲尘波，蛛丝结网露珠多，滴圆荷。",
        "遥思桃叶吴江碧，便是天河隔。",
        "锦鳞红鬣影沉沉，相思空有梦相寻，意难任。"
      ],
      "author": {
        "id": 6339,
        "name": "毛文锡"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377966,
      "title": "虞美人·虞美人·宝檀金缕鸳鸯枕",
      "content": [
        "宝檀金缕鸳鸯枕，绶带盘宫锦。",
        "夕阳低映小窗明，南园绿树语莺莺，梦难成。",
        "玉炉香暖频添炷，满地飘轻絮。",
        "珠帘不卷度沉烟，庭前间立画秋千，艳阳天。"
      ],
      "author": {
        "id": 6339,
        "name": "毛文锡"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377967,
      "title": "酒泉子·酒泉子·绿树春深",
      "content": [
        "绿树春深，燕语莺啼声断续。",
        "蕙风飘荡入芳丛，惹残红。",
        "柳丝无力袅烟空，金盏不辞须满酌。",
        "海棠花下思朦胧，醉香风。"
      ],
      "author": {
        "id": 6339,
        "name": "毛文锡"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377968,
      "title": "喜迁莺·喜迁莺·芳春景",
      "content": [
        "芳春景，暖晴烟，乔木见莺迁。",
        "传枝偎叶语关关，飞过绮丛间。",
        "锦翼鲜，金毳软，百啭千娇相唤。",
        "碧纱窗晓怕闻声，惊破鸳鸯暖。"
      ],
      "author": {
        "id": 6339,
        "name": "毛文锡"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377969,
      "title": "赞成功·赞成功·海棠未坼",
      "content": [
        "海棠未坼，万点深红，香包缄结一熏熏。",
        "似含羞态，邀勒春风。",
        "蜂来蝶去，任绕芳丛。",
        "昨夜微雨，飘酒庭中。",
        "忽闻声滴井边桐，美人惊起，坐听晨钟。",
        "快教折取，戴玉璁。"
      ],
      "author": {
        "id": 6339,
        "name": "毛文锡"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377970,
      "title": "西溪子·西溪子·昨日西溪游赏",
      "content": [
        "昨日西溪游赏，芳树奇花千样，锁春光。",
        "金樽满，听弦管，娇妓舞衫香暖。",
        "不觉到斜晖，马驮归。",
        "中兴乐",
        "豆蔻花繁烟艳深，丁香软结同心。",
        "翠鬟女，相与共淘金。",
        "红蕉叶里猩猩语，鸳鸯浦，镜中鸾舞。",
        "丝雨隔，荔枝阴。"
      ],
      "author": {
        "id": 6339,
        "name": "毛文锡"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377971,
      "title": "更漏子·更漏子·春夜阑",
      "content": [
        "春夜阑，春恨切，花外子规啼月。",
        "人不见，梦难见，红纱一点灯。",
        "偏怨别，是芳节，庭中丁香千结。",
        "宵雾散，晓霞晖，梁同双燕飞。"
      ],
      "author": {
        "id": 6339,
        "name": "毛文锡"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377972,
      "title": "接贤宾·接贤宾·香鞯镂襜五花骢",
      "content": [
        "香鞯镂襜五花骢，值春景初融。",
        "流珠喷沫躞蹀，汗血流红。",
        "少年公子能乘驭，金镳玉辔珑璁。",
        "为惜珊瑚鞭不下，骄生百步千踪。",
        "信穿花，从拂柳，向九陌追风。"
      ],
      "author": {
        "id": 6339,
        "name": "毛文锡"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377973,
      "title": "赞浦子·赞浦子·锦帐添香睡",
      "content": [
        "锦帐添香睡，金炉换夕照。",
        "懒结芙蓉带，慵拖翡翠裙。",
        "正是桃夭柳媚，那堪暮雨朝云。",
        "宋玉高唐意，裁琼欲赠君。"
      ],
      "author": {
        "id": 6339,
        "name": "毛文锡"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377974,
      "title": "甘州遍·甘州遍·春光好",
      "content": [
        "春光好，公子爱闲游，足风流。",
        "金鞍白马，雕弓宝剑，红缨锦襜出长揪。",
        "花蔽膝，玉衔头。",
        "寻芳逐胜欢宴，丝竹不曾休。",
        "美人唱，揭调是《甘州》。",
        "醉红楼。",
        "尧年舜日，乐圣永无忧。"
      ],
      "author": {
        "id": 6339,
        "name": "毛文锡"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377975,
      "title": "甘州遍·甘州遍·秋风紧",
      "content": [
        "秋风紧，平碛雁行低，阵云齐。",
        "萧萧飒飒，边声四起，愁闻戍角与征鼙。",
        "青冢北，黑山西。",
        "沙飞聚散无定，往往路人迷。",
        "铁衣冷，战马血沾蹄，破番奚。",
        "凤凰诏下，步步蹑丹梯。"
      ],
      "author": {
        "id": 6339,
        "name": "毛文锡"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377976,
      "title": "纱窗恨·纱窗恨·新春燕子还来至",
      "content": [
        "新春燕子还来至，一双飞。",
        "垒巢泥湿时时坠，涴人衣。",
        "后园里看百花发，香风拂，绣户金扉。",
        "月照纱窗，恨依依。"
      ],
      "author": {
        "id": 6339,
        "name": "毛文锡"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377977,
      "title": "纱窗恨·纱窗恨·双双蝶翅涂铅粉",
      "content": [
        "双双蝶翅涂铅粉，咂花心。",
        "绮窗绣户飞来稳，画堂阴。",
        "二三月爱随飘絮，伴落花，来拂衣襟。",
        "更剪轻罗片，傅黄金。"
      ],
      "author": {
        "id": 6339,
        "name": "毛文锡"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377978,
      "title": "柳含烟·柳含烟·隋堤柳",
      "content": [
        "隋堤柳，汴河旁。",
        "夹岸绿阴千里，龙舟凤舸木兰香，锦帆张。",
        "因梦江南春景好，一路流苏羽葆。",
        "笙歌未尽起横流，锁春愁。"
      ],
      "author": {
        "id": 6339,
        "name": "毛文锡"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377979,
      "title": "柳含烟·柳含烟·河桥柳",
      "content": [
        "河桥柳，占芳春。",
        "映水含烟拂路，几回攀折赠行人，暗伤神。",
        "乐府吹为横笛曲，能使离肠断续。",
        "不如移植在金门，近天恩。"
      ],
      "author": {
        "id": 6339,
        "name": "毛文锡"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377980,
      "title": "柳含烟·柳含烟·章台柳",
      "content": [
        "章台柳，近垂旒。",
        "低拂往来冠盖，鞭胧春色满皇州，瑞烟浮。",
        "直与路边江畔别，免被离人攀折。",
        "最怜京兆画蛾眉，叶纤时。"
      ],
      "author": {
        "id": 6339,
        "name": "毛文锡"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377981,
      "title": "柳含烟·柳含烟·御沟柳",
      "content": [
        "御沟柳，占春多。",
        "半出宫墙婀娜，有时倒影蘸轻罗，曲尘波。",
        "昨日金銮巡上苑，风亚舞腰纤软。",
        "栽培得她近皇宫，瑞烟浓。"
      ],
      "author": {
        "id": 6339,
        "name": "毛文锡"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377982,
      "title": "醉花间·醉花间·休相问",
      "content": [
        "休相问，怕相问，相问还添恨。",
        "春水满塘生，㶉𫛶正相趁。",
        "咋夜雨霏霏，临明寒一阵。",
        "偏忆戍楼人，久绝边庭信。"
      ],
      "author": {
        "id": 6339,
        "name": "毛文锡"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377983,
      "title": "醉花间·醉花间·深相忆",
      "content": [
        "深相忆，莫相忆，相忆情难极。",
        "银汉是红墙，一带遥相隔。",
        "金盘珠露滴，两岸榆花白。",
        "风摇玉佩清，今夕为何夕。"
      ],
      "author": {
        "id": 6339,
        "name": "毛文锡"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377984,
      "title": "浣沙溪·浣沙溪·春水轻波浸绿苔",
      "content": [
        "春水轻波浸绿苔，楷杷洲上紫檀开。",
        "晴天眠沙㶉𫛶稳，暖相偎。",
        "罗袜生尘游女过，有人逢着弄珠回。",
        "兰麝飘香初解佩，忘归来。"
      ],
      "author": {
        "id": 6339,
        "name": "毛文锡"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377985,
      "title": "浣溪沙·浣溪沙·七夕年年信不违",
      "content": [
        "七夕年年信不违，银河清浅白云微，蟾光鹊影伯劳飞。",
        "每恨蟪蛄怜婺女，几回娇妒下鸳机，今宵嘉会两依依。"
      ],
      "author": {
        "id": 6339,
        "name": "毛文锡"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377986,
      "title": "月宫春·月宫春·水晶宫里桂花开",
      "content": [
        "水晶宫里桂花开，神仙探几回。",
        "红芳金蕊绣重台，低倾玛瑙杯。",
        "玉兔银蟾争夺护，嫦娥姹女戏相偎。",
        "遥听钧天九奏，玉皇亲看来。"
      ],
      "author": {
        "id": 6339,
        "name": "毛文锡"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377987,
      "title": "恋情深·恋情深·滴滴铜壶塞漏咽",
      "content": [
        "滴滴铜壶塞漏咽，醉红楼月。",
        "宴余香殿会鸳衾，荡春心。",
        "真珠帘下晓光侵，莺语隔琼林。",
        "宝帐欲开慵起，恋情深。"
      ],
      "author": {
        "id": 6339,
        "name": "毛文锡"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377988,
      "title": "恋情深·恋情深·玉殿春浓花烂熳",
      "content": [
        "玉殿春浓花烂熳，族神仙伴。",
        "罗裙窣地缕黄金，奏清音。",
        "酒阑歌罢两沉沉，一笑动君心。",
        "永作鸳鸯伴，恋情深。"
      ],
      "author": {
        "id": 6339,
        "name": "毛文锡"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377989,
      "title": "诉衷情·诉衷情·桃花流水漾纵横",
      "content": [
        "桃花流水漾纵横，春昼彩霞明。",
        "刘郎去，阮郎行，惆怅恨难平。",
        "愁坐对云屏，算归程。",
        "何时携手洞边迎，诉衷情。"
      ],
      "author": {
        "id": 6339,
        "name": "毛文锡"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377990,
      "title": "诉衷情·诉衷情·鸳鸯交颈绣衣轻",
      "content": [
        "鸳鸯交颈绣衣轻，碧沼藕花馨。",
        "偎藻荇，映兰汀，和雨浴浮萍。",
        "思妇对心惊，想边庭。",
        "何时解佩掩云屏，诉衷情。"
      ],
      "author": {
        "id": 6339,
        "name": "毛文锡"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377991,
      "title": "应天长·应天长·平江波暖鸳鸯语",
      "content": [
        "平江波暖鸳鸯语，两两镏般归极浦。",
        "芦州一夜风和雨，飞起浅沙翘雪鹭。",
        "渔灯明远渚，兰棹今宵何处。",
        "罗袂从风轻举，愁杀采莲女。"
      ],
      "author": {
        "id": 6339,
        "name": "毛文锡"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377992,
      "title": "河满子·河满子·红粉楼前月照",
      "content": [
        "红粉楼前月照，碧纱窗外莺啼。",
        "梦断辽阳音信，那堪独守空闺。",
        "恨对百花时节，王孙绿草萋萋。"
      ],
      "author": {
        "id": 6339,
        "name": "毛文锡"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377993,
      "title": "临江仙·临江仙·暮蝉声尽落斜阳",
      "content": [
        "暮蝉声尽落斜阳，银蟾影挂潇湘。",
        "黄陵庙侧水茫茫。",
        "楚山红树，烟雨隔高唐。",
        "岸泊渔灯风飐碎，白苹远散浓香。",
        "灵娥鼓瑟韵清商，朱弦凄切，云散碧云长。"
      ],
      "author": {
        "id": 6339,
        "name": "毛文锡"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377994,
      "title": "临江仙·临江仙·峭碧参差十二峰",
      "content": [
        "峭碧参差十二峰，冷烟寒树重重。",
        "瑶姬宫殿是仙踪，金炉珠帐，香霭昼偏浓。",
        "一自楚王惊梦断，人间无路相逢。",
        "至今云雨带愁容，月斜江上，征棹动晨钟。"
      ],
      "author": {
        "id": 838,
        "name": "牛希济"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377995,
      "title": "临江仙·临江仙·谢家仙观寄云岑",
      "content": [
        "谢家仙观寄云岑，岩萝拂地成阴。",
        "洞房不闭白云深，当时丹灶，一粒化黄金。",
        "石壁霞衣犹半挂，松风长似鸣琴。",
        "时间唳鹤起前林，十洲高会，何处许相寻？"
      ],
      "author": {
        "id": 838,
        "name": "牛希济"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377996,
      "title": "临江仙·临江仙·渭阙宫城秦树凋",
      "content": [
        "渭阙宫城秦树凋，玉楼独上无聊。",
        "含情不语自吹箫，调情和恨，天路逐风飘。",
        "何事乘龙入忽降，似知深意相招。",
        "三清携手路非遥，世间屏障，彩笔画娇娆。"
      ],
      "author": {
        "id": 838,
        "name": "牛希济"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377997,
      "title": "临江仙·临江仙·江绕黄陵春庙闲",
      "content": [
        "江绕黄陵春庙闲，娇莺独语关关。",
        "满庭重叠绿苔斑，阴云无事，四散自归山。",
        "箫鼓声稀香烬冷，月娥敛尽弯环。",
        "风流皆道胜人间，须知狂客，拼死为红颜。"
      ],
      "author": {
        "id": 838,
        "name": "牛希济"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377998,
      "title": "临江仙·临江仙·素洛春光潋滟平",
      "content": [
        "素洛春光潋滟平，千重媚脸初生。",
        "凌波罗袜势轻轻，烟笼日照，珠翠半分明。",
        "风引宝衣疑欲舞，鸾回凤翥堪惊。",
        "也知心许无恐成，陈王辞赋，千载有声名。"
      ],
      "author": {
        "id": 838,
        "name": "牛希济"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377999,
      "title": "临江仙·临江仙·柳带摇风汉水滨",
      "content": [
        "柳带摇风汉水滨，平芜两岸争匀。",
        "鸳鸯对浴浪痕新。",
        "弄珠游女，微笑自含春。",
        "轻步暗移蝉鬓动，罗裙风惹轻尘。",
        "水晶宫殿岂无因？",
        "空劳牵手，解佩赠情人。"
      ],
      "author": {
        "id": 838,
        "name": "牛希济"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378000,
      "title": "临江仙·临江仙·洞庭波浪飐晴天",
      "content": [
        "洞庭波浪飐晴天，君山一点凝烟。",
        "此中真境属神仙，玉楼珠殿，相映月轮边。",
        "万里平湖秋色冷，星辰垂影参然。",
        "桔林霜重更红鲜，罗浮山下，有路暗相连。"
      ],
      "author": {
        "id": 838,
        "name": "牛希济"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378001,
      "title": "酒泉子·酒泉子·枕转簟凉",
      "content": [
        "枕转簟凉，清晓远钟残梦。",
        "月光斜、帘影动，旧炉香。",
        "梦中说尽相思事，纤手匀双泪。",
        "去年春，今日意，断离肠。"
      ],
      "author": {
        "id": 838,
        "name": "牛希济"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378002,
      "title": "生查子·生查子·春山烟欲收",
      "content": [
        "春山烟欲收，天淡稀星小。",
        "残月脸边明，别泪临清晓。",
        "语已多，情未了，回首犹重道：",
        "记得绿罗裙，处处怜芳草。"
      ],
      "author": {
        "id": 838,
        "name": "牛希济"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378003,
      "title": "中兴乐·中兴乐·池塘暖碧浸晴晖",
      "content": [
        "池塘暖碧浸晴晖，蒙蒙柳絮轻飞。",
        "红蕊凋来，解梦还稀。",
        "春云空有雁归，珠帘垂。",
        "东风寂寞，恨郎抛掷，泪湿罗衣。"
      ],
      "author": {
        "id": 838,
        "name": "牛希济"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378004,
      "title": "谒金门·谒金门·秋已暮",
      "content": [
        "秋已暮，重叠关山岐路。",
        "嘶马摇鞭何处去，晓禽霜满树。",
        "梦断禁城神鼓，泪滴枕檀无数。",
        "一点凝红和薄雾，翠蛾愁不语。"
      ],
      "author": {
        "id": 838,
        "name": "牛希济"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378005,
      "title": "浣溪沙·浣溪沙·落絮残莺半日天",
      "content": [
        "落絮残莺半日天，玉柔花醉只思眠，惹窗映竹满炉烟。",
        "独掩画屏愁不语，斜掩瑶枕髻鬟偏，此时心在阿谁边。"
      ],
      "author": {
        "id": 7856,
        "name": "欧阳炯"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378006,
      "title": "浣溪沙·浣溪沙·天碧罗衣拂地垂",
      "content": [
        "天碧罗衣拂地垂，美人初着更相宜，宛风如舞透香肌。",
        "独坐含颦吹风竹，园中缓步折花枝，有情无力泥人时。"
      ],
      "author": {
        "id": 7856,
        "name": "欧阳炯"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378007,
      "title": "浣溪沙·浣溪沙·相见休言有泪珠",
      "content": [
        "相见休言有泪珠，酒阑重得叙欢娱，凤屏鸳枕宿金铺。",
        "兰麝细香闻喘息，绮罗纤缕见肌肤，此时还恨薄情无。"
      ],
      "author": {
        "id": 7856,
        "name": "欧阳炯"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378008,
      "title": "三字令·三字令·春欲尽",
      "content": [
        "春欲尽，日迟迟，牡丹时。",
        "罗幌卷，翠帘垂。",
        "彩笺书，红粉泪，两心知。",
        "人不在，燕空归，负佳期。",
        "香烬落，枕函欹。",
        "月分明，花淡薄，惹相思。"
      ],
      "author": {
        "id": 7856,
        "name": "欧阳炯"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378009,
      "title": "南乡子·南乡子·嫩草如烟",
      "content": [
        "嫩草如烟，石榴花发海南天。",
        "日暮江亭春影绿，鸳鸯浴。",
        "水远山长看不足。"
      ],
      "author": {
        "id": 7856,
        "name": "欧阳炯"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378010,
      "title": "南乡子·南乡子·画舸停桡",
      "content": [
        "画舸停桡，槿花篱外竹横桥。",
        "水上游人沙上女，回顾，笑指芭蕉林里住。"
      ],
      "author": {
        "id": 7856,
        "name": "欧阳炯"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378011,
      "title": "南乡子·南乡子·岸远沙平",
      "content": [
        "岸远沙平，日斜归路晚霞明。",
        "孔雀自怜金翠尾，临水，认得行人惊不起。"
      ],
      "author": {
        "id": 7856,
        "name": "欧阳炯"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378012,
      "title": "南乡子·南乡子·洞口谁家",
      "content": [
        "洞口谁家，木兰船系木兰花。",
        "红袖女郎相引去，游南浦，笑倚春风相对语。"
      ],
      "author": {
        "id": 7856,
        "name": "欧阳炯"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378013,
      "title": "南乡子·南乡子·二八花钿",
      "content": [
        "二八花钿，胸前如雪脸如莲。",
        "耳坠金环穿瑟瑟，霞衣窄，笑倚江头招远客。"
      ],
      "author": {
        "id": 7856,
        "name": "欧阳炯"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
