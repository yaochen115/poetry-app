        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 163071,
      "title": "济渎",
      "content": [
        "玉简投潭洞，金樽出石隈。",
        "龙光蟠窟宅，蜃气结楼台。",
        "卷地风雷起，掀天雨雹来。",
        "人间为济渎，水底即蓬莱。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 163072,
      "title": "孔子旧宅",
      "content": [
        "奉出天家一瓣香，著鞭东鲁谒灵光。",
        "堂堂圣像垂龙衮，济济贤生列雁行。",
        "屋壁诗书今绝响，衣冠人物只堪伤。",
        "可怜杏老空坛上，惟有寒鸦噪夕阳。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 163073,
      "title": "泰山",
      "content": [
        "敕使联镳上翠岑，飞泉跃涧吼雷音。",
        "凌高一览知天远，迂曲千蹊觉洞深。",
        "龙蛰沧溟蛟舞壑，枭横碧落凤归林。",
        "山灵护得神祠在，苔蚀秦碑古树阴。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 163074,
      "title": "降香回燕",
      "content": [
        "一从得玉旨，勒马幽燕起。",
        "河北与河南，一万五千里。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 163075,
      "title": "大元皇后游蓬莱岛",
      "content": [
        "午夜红云满太清，晓来王母下瑶京。",
        "日从万岁山头出，人在九重天上行。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 163076,
      "title": "太皇谢太后挽章  其一",
      "content": [
        "羯鼓喧吴越，伤心国破时。",
        "雨阑花洒泪，烟苑柳颦眉。",
        "事去千年速，愁来一死迟。",
        "旧臣相吊后，寒月堕燕支。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 163077,
      "title": "太皇谢太后挽章  其二",
      "content": [
        "大漠阴风起，羁孤血泪县。",
        "忽闻天下母，已赴月中仙。",
        "哀乐浮云外，荣枯逝水前。",
        "遗书乞骸骨，归葬越山边。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 163078,
      "title": "青阳提刑哀些",
      "content": [
        "提刑辞宋国，奉使到燕都。",
        "入贡能全璧，怀归不献图。",
        "看羊居北海，化鹤返西湖。",
        "楚客歌哀些，临棺奠酒壶。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 163079,
      "title": "女道士王昭仪仙游词",
      "content": [
        "吴国生如梦，幽州死未寒。",
        "金闺诗卷在，玉案道书闲。",
        "苦雾蒙丹旐，酸风射素棺。",
        "人间无葬地，海上有仙山。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 163080,
      "title": "平原郡公赵福王挽章",
      "content": [
        "大王无起日，草木尽伤悲。",
        "生在太平世，死当离乱时。",
        "南冠流远路，北面幸全尸。",
        "旧客行霜霰，呼天泪湿麾。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 163081,
      "title": "文山道人事毕壬午腊月初九日",
      "content": [
        "崖山禽得到燕山，此老从容就义难。",
        "生愧夷齐尚周粟，死同巡远只唐官。",
        "雪平绝塞魂何往，月满通衢骨未寒。",
        "一剑固知公所欠，要留青史与人看。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 163082,
      "title": "瀛国公入西域为僧号木波讲师",
      "content": [
        "木老西天去，袈裟说梵文。",
        "生前从此别，去后不相闻。",
        "忍听北方雁，愁看西域云。",
        "永怀心未已，梁月白纷纷。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 163083,
      "title": "全太后为尼",
      "content": [
        "南国旧王母，西方新世尊。",
        "头颅归妙相，富贵悟空门。",
        "传法优婆域，诵经孤独园。",
        "夜阑清磬罢，趺坐雪花繁。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 163084,
      "title": "幽州会饮",
      "content": [
        "客路相逢在异乡，佐尊先得杜韦娘。",
        "舞回锦臂花争艳，醉吸金波月鬬光。",
        "他日未忘今日乐，老年须记少年狂。",
        "五陵游侠休相笑，归去奚奴有锦囊。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 163085,
      "title": "余将南归燕赵诸公子携妓把酒饯别醉中作把酒听歌行  其一",
      "content": [
        "君把酒，听我歌。",
        "君不见陌上桑，鹑奔奔兮鹊疆疆。",
        "高堂今夕灯烛光，燕姝赵女吹笙簧。",
        "君把酒，听我歌。",
        "美人美人美如此，倾城倾国良有以。",
        "周惑褒姒烽火起，纣惑妲己贤人死。",
        "君把酒，听我歌。",
        "汉家之乱吕太后，唐家之乱武则天。",
        "魏公铜台化焦土，隋炀月殿成飞烟。",
        "君把酒，听我歌。",
        "美人美人色可食，美人美人笑可爱。",
        "美人命薄争奈何，美人色衰相弃背。",
        "美人一笑难再得，美人绝色今何在。",
        "君不见马嵬坡下杨太真，天生尤物不足珍。",
        "那及唐虞九妇人，千古万古名不湮。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 163086,
      "title": "余将南归燕赵诸公子携妓把酒饯别醉中作把酒听歌行  其二",
      "content": [
        "我把酒，听君歌。",
        "美人娟娟花灼灼，月照金樽光绰约。",
        "有酒有歌君亦愁，把酒听歌君亦乐。",
        "我有鹦鹉杯，君有鸬鹚杓。",
        "一杯一杯复一杯，酒尽还沽共君酌。",
        "我把酒，听君歌。",
        "天不荒，地不老，人生百年休草草。",
        "对花对酒且高歌，盖世功名亦枯槁。",
        "满堂金玉守者谁，万事何如酒杯好。",
        "君不见巢父许由空洗耳，伯夷叔齐空饿死。",
        "范蠡扁舟挟西子，五湖风浪兼天起。",
        "又不见相如怀璧空归来，廉颇善饭何壮哉。",
        "谢安携妓入东山，苍生望望霖雨干。",
        "把酒劝君饮，请君为我歌。",
        "燕昭筑台金满地，郭隗登台多意气。",
        "刘琨梦里起听鸡，班超万里封侯归。",
        "君不见浣花溪头老翁哭，白首为儒守茅屋。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 163087,
      "title": "出自蓟门行",
      "content": [
        "出自蓟门行，行行望天北。",
        "何处愁杀人，黑风走沙石。",
        "华裾者谁子，意气万人敌。",
        "金鞍鞁白马，奋飞虎生翼。",
        "书生尔何为，不草相如檄。",
        "徒有经济心，壮年已斑白。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 163088,
      "title": "涿州",
      "content": [
        "泸沟桥下水泠泠，落木无边秋正清。",
        "牛马乱铺黄帝野，鹰鹯高摩涿州城。",
        "柳亭日射旌旗影，花馆风传鼓吹声。",
        "归客偶然舒望眼，酒边触景又诗成。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 163089,
      "title": "真定官舍",
      "content": [
        "使君数问夜如何，灯烛高张照绮罗。",
        "白酒千杯浇客醉，红粧一面恼人多。",
        "风烟漠漠庭前树，霜月娟娟沼内荷。",
        "驿吏出门相语及，城南便是滹沱河。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 163090,
      "title": "云台",
      "content": [
        "荒亭驻马酌金罍，风卷黄埃丑上来。",
        "满地山河无汉业，赵州留得古云台。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 163091,
      "title": "比干墓",
      "content": [
        "卫州三十里，荒墩草无数。",
        "忽听路人言，此葬比干处。",
        "下马拊石碑，三叹不能去。",
        "斐然成歌章，聊书墓头树。",
        "我吊比干心，不吊比干墓。",
        "世间贤与愚，同尽成黄土。",
        "斯人亦人尔，千千万万古。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 163092,
      "title": "封丘",
      "content": [
        "今夜宿封丘，明朝过汴州。",
        "云横遮远塞，水落见长洲。",
        "树折枣初剥，藤枯瓜未收。",
        "倾囊沽一斗，聊以慰羁愁。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 163093,
      "title": "花石纲",
      "content": [
        "假山虽假总非真，未必中间可隠身。",
        "若使此山身可隠，上皇不作远行人。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 163094,
      "title": "扬州",
      "content": [
        "重到扬州十载余，画桥雨过月模糊。",
        "后皇庙里花何在，炀帝隄边柳亦枯。",
        "陂麦青青嘶乱马，城芜冉冉落群乌。",
        "人生聚散愁无尽，且小停鞭向酒罏。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 163095,
      "title": "金陵",
      "content": [
        "只见空城不见台，客行搔首重徘徊。",
        "风云旧日龙南渡，宇宙新秋雁北来。",
        "三国衣冠同草莽，六朝宫殿总尘埃。",
        "交游相见休相问，把手江头且一杯。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 163096,
      "title": "凤凰台",
      "content": [
        "草没高台凤不游，大江日夜自东流。",
        "齐梁地废鸦千树，王谢家空蚁一丘。",
        "骑马僧争淮口渡，捕鱼人据石头洲。",
        "玉箫声断悲风起，不见长安李白愁。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 163097,
      "title": "石头城",
      "content": [
        "石头城上小徘徊，世换僧残寺已灰。",
        "地接汴淮山北去，江吞吴越水东来。",
        "健鱼奋鬣随蛟舞，快鹘翻身猎雁回。",
        "一片降旗千古泪，前人留与后人哀。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 163098,
      "title": "采石",
      "content": [
        "夜泊青山下，江空不受尘。",
        "只看波底月，便是谪仙人。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 163099,
      "title": "凌歊台",
      "content": [
        "百尺凌歊事已非，古碑岩畔上苔衣。",
        "禁园风暖草争发，废殿雨寒花乱飞。",
        "海北天高鹏得运，江南春尽雁知归。",
        "三千歌舞今何处，惟有姑溪遶翠微。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 163100,
      "title": "乌江",
      "content": [
        "平生英烈世无双，汉骑飞来肯受降。",
        "早与虞姬帐下死，不教战血到乌江。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 163101,
      "title": "鲁港",
      "content": [
        "博徒无计解其纷，夜半鸣钲溃万军。",
        "鲁港朔风掀恶浪，吴山寒日翳愁云。",
        "周褒媚己终亡国，孟德欺孤忍负君。",
        "大木已颠天柱折，钱塘江上雁成群。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 163102,
      "title": "星子驿别客",
      "content": [
        "星江彼此系行舟，我向南州君北州。",
        "彭泽初归元亮醉，沙场远使子卿愁。",
        "人生离合花间蝶，世事浮沉柳外鸥。",
        "明日沾襟各分手，相思何处倚高楼。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 163103,
      "title": "豫章驿",
      "content": [
        "豫章门外尽青原，高阁临江喜尚存。",
        "鶑舌澜翻嘲鹤静，鸥心恬淡厌蛙喧。",
        "绿波淼淼投书渚，翠竹森森写韵轩。",
        "约客不来人已远，满天风雨又黄昏。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 163104,
      "title": "临川水驿",
      "content": [
        "羊角山高锁战尘，春风吹草绿孤城。",
        "鹊巢逊与鸠夫妇，燕幙能容雁弟兄。",
        "今古废兴棋一著，萍蓬聚散酒三行。",
        "悲歌曲尽故人去，笛响长江月正明。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 163105,
      "title": "岁暮过信州灵溪",
      "content": [
        "不弹长铗叹无车，独倚枯筇面碧虚。",
        "兵破乡村人住少，火烧桥道客行疏。",
        "云低天阔鹰呼隼，水落溪喧獭趁鱼。",
        "东骛西驰归未得，明朝又是岁将除。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 163106,
      "title": "三衢官舍和王府教",
      "content": [
        "十年牢落走穷荒，万里归来行路长。",
        "坐上佳宾能鼓瑟，窗前细雨好烧香。",
        "武淹某泽常思汉，甫寓鄜州只念唐。",
        "秉烛相看真梦寐，夜阑无语意茫茫。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 163107,
      "title": "钓台",
      "content": [
        "滩沙叠叠是潮痕，古木苍然叫断猿。",
        "此老不干天子贵，故人方讶布衣尊。",
        "雨甜春水鱼龙动，风暖寒林鸟雀喧。",
        "我恰扁舟台下过，桐花香处月黄昏。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 163108,
      "title": "钱塘",
      "content": [
        "踯躅吞声泪暗倾，杖藜徐步浙江行。",
        "青芜古路人烟绝，绿树新墟鬼火明。",
        "事去玉环沈异域，愁来金盌出佳城。",
        "十年草木都糜烂，留得南枝照浅清。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 163109,
      "title": "浙江亭和徐雪江",
      "content": [
        "朱甍突兀倚云寒，潮打孤城寂寞还。",
        "荒草断烟新驿路，夕阳古木旧江山。",
        "英雄聚散阑干外，今古兴亡欸乃间。",
        "一曲尊前空击剑，西风白髪泪斑斑。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 163110,
      "title": "答林石田见",
      "content": [
        "偶携降帜立诗坛，剪烛西窗共笑欢。",
        "落魄苏秦今席煖，猖狂阮籍尚毡寒。",
        "山中客老干茎白，海上人归一寸丹。",
        "世事本来愁不得，乾坤只好醉时看。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 163111,
      "title": "孤山和李鹤田",
      "content": [
        "湖上悲风舞白杨，英雄凋尽只堪伤。",
        "花飞废苑怜铜马，草没荒坟卧石羊。",
        "人在醉中春已晚，客于愁处日偏长。",
        "林西楼观青红湿，又逊僧官燕梵王。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 163112,
      "title": "湖山堂",
      "content": [
        "高堂寂寞半开门，草没颓墙竹满园。",
        "雨过湖天笼白昼，云归山市锁黄昏。",
        "忘机今古鸥来往，说梦兴亡燕语言。",
        "行尽六桥吟更好，万松岭上一声猿。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 163113,
      "title": "答徐雪江",
      "content": [
        "十载高居白玉堂，陈情一表乞还乡。",
        "孤云落日渡辽水，匹马西风上太行。",
        "行橐尚留官里俸，赐衣犹带御前香。",
        "只今对客难为答，千古中原话柄长。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 163114,
      "title": "歌楼感事",
      "content": [
        "昔年同辇载花仙，此日登楼籍妓员。",
        "恩赐舞衣香未歇，御书歌扇墨犹鲜。",
        "碧云翼翼金钗滑，红雪翩翩玉珮圆。",
        "却把向来供奉曲，酒边对客续朱弦。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 163115,
      "title": "九日次周义山",
      "content": [
        "杜陵清瘦不禁寒，白髪萧萧强笑欢。",
        "阶下决明难独立，庭前甘菊好谁看。",
        "一钱留得囊羞涩，九日沽来酒带酸。",
        "却忆大明朝谒罢，紫萸擎出赐千官。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 163116,
      "title": "寄李鹤田",
      "content": [
        "文江别后又三年，别后三年诗几篇。",
        "老去莫思身外事，命穷甘作饮中仙。",
        "天阴雨湿龙归海，云淡风轻鹤在田。",
        "回首西湖湖上路，新蒲细柳为谁妍。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 163117,
      "title": "读李鹤田钱塘百咏",
      "content": [
        "南浦亭边话别时，扁舟东下浙江湄。",
        "徧将越国千年事，吟作钱塘百咏诗。",
        "无火可能烧莽卓，有刀恨不斩高斯。",
        "五陵佳气飞扬尽，泪洒西风两鬓丝。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 163118,
      "title": "宫人为尼",
      "content": [
        "白髪今如此，无依实可怜。",
        "圣恩空旧想，佛相又新圆。",
        "镜晓容颜别，钟昏梦寐悬。",
        "百年心上事，怀古泪涟涟。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    }
  ],
