  "data": [
    {
      "id": 163019,
      "title": "庚辰正月旦早朝呈留忠斋",
      "content": [
        "庭燎明如昼，金壶漏水平。",
        "炉烟摇晓色，櫩□□□声。",
        "三祝圣人寿，一忠臣子情。",
        "新元奏封事，□□□苍生。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 163020,
      "title": "妾薄命呈文山道人",
      "content": [
        "妾初未嫁时，晨夕深闺中。",
        "年当十五余，颜色如花红。",
        "千里远结婚，出门山重重。",
        "与君盛容饰，一笑开芙蓉。",
        "君不顾妾色，剑气干长虹。",
        "耿耿丈夫□，□□天下雄。",
        "结髪未逾载，倏然各西东。",
        "妾独□□□，□养姑与翁。",
        "姑翁去年春，长梦随飘风。",
        "思君□□□，音信安可通。",
        "谅无双飞翼，焉得长相从。",
        "自服嫁时衣，荆钗淡为容。",
        "誓以守贞洁，与君生死同。",
        "君当立高节，杀身以为忠。",
        "岂无春秋笔，为君纪其功。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 163021,
      "title": "幽州送景僧录归钱塘",
      "content": [
        "天目山前景老禅，长安传法旧沙门。",
        "十年不见身为累，万里相逢舌尚存。",
        "漠漠尘埃凝破衲，凄凄风露袭归辕。",
        "到家定有秋光在，报答黄花满故园。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 163022,
      "title": "冬至日同舍会拜",
      "content": [
        "燕市人争看秀才，团栾此日会金台。",
        "葡萄酒熟浇驼髓，萝卜羹甜煮鹿胎。",
        "砚笔寂寥空洒泪，管弦呜咽自生哀。",
        "雪寒门户宾朋少，且拨红炉守泰来。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 163023,
      "title": "自笑",
      "content": [
        "释氏掀天官府，道家随世功名。",
        "俗子执鞭亦贵，书生无用分明。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 163024,
      "title": "斡鲁垛观猎",
      "content": [
        "黑风满天红日出，千里万里栖寒烟。",
        "快鹰已落蓟水畔，猎马更在燕山前。",
        "白旄黄钺左右绕，毡房殿帐东西旋。",
        "海青眇然从此去，天鹅正坠阴崖巅。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 163025,
      "title": "幽州月夜酒边赋西湖月",
      "content": [
        "西湖月，光皎洁，曾照钱王九重阙。",
        "钱王歌舞恋春风，月亦有情光不歇。",
        "一朝歌舞成尘土，断础荒宫走狐兔。",
        "月亦伤心不肯明，人亦吞声泪如雨。",
        "西湖月，几度圆，几度缺。",
        "人生南北岐路多，几度相逢几度别。",
        "去年月圆时，我在西湖十里荷花香，□□月吞酒巵。",
        "今年月缺时，我在燕山万里来□□，□酒招月来。",
        "劝月酒一杯，我酒饮尽□□□□□□饮，胡为乎来哉。",
        "停杯问月月变色，嫌□□□□□窄。",
        "人生如白驹之过隙，若不痛饮真可惜。",
        "□□□物如流水，何如月照金樽里。",
        "首阳二子忍□□，□丘盗跖成蝼蚁。",
        "我有长鲸吸川口，倒挽银河添我酒。",
        "我酒千年饮不干，月光与我长相守。",
        "酒酣拔剑斫地歌，钱王宫阙生白波。",
        "西湖月，光更多，有酒不饮将如之何。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 163026,
      "title": "泸沟桥王昭仪见寄回文次韵",
      "content": [
        "沟水泸边落木疏，旧家天远寄来书。",
        "秋风冷驿官行未，夜月虚窗客梦初。",
        "流雁断鸿飞旷野，舞鸾离鹤别穹庐。",
        "裘貂醉尽一樽酒，愁散方知独上车。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 163027,
      "title": "幽州除夜",
      "content": [
        "十年旅食在天涯，到处身安只是家。",
        "雪塞春回邹衍律，霜营寒入祢衡挝。",
        "壶倾卯酒杯浮粟，厨出辛盘饤簇花。",
        "奴仆不须喧鼓吹，恐惊枥马与林鸦。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 163028,
      "title": "关山月",
      "content": [
        "关山月，关山月，东边来，西边没。",
        "夜夜照关山，□□多战骨。",
        "男儿莫去学弓刀，女儿莫嫁关山□。",
        "□□母啼送爷去当军，今年妻啼送夫去当□。",
        "□□□老妻年少，养子嫁夫不得力。",
        "关山月，关山月，□□见月圆，月月见月缺。",
        "万里征夫泪流血。",
        "将军□□大羽箭，沙场格鬬无休歇。",
        "谁最苦兮谁□□，□□出戍当门户。",
        "只今头白未还乡，母死妻亡业无主。",
        "关山月，关山月，生离别，死离别。",
        "爷娘妻子顾不得，努力戎行当报国。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 163029,
      "title": "出居庸关",
      "content": [
        "平生爱读书，反被读书误。",
        "今辰出长城，未知死何处。",
        "下马古战场，荆榛莽回互。",
        "群狐正从横，野枭号古树。",
        "黑云满天飞，白日翳复吐。",
        "移时风扬沙，人马俱失路。",
        "踌躇默吞声，聊歌远游赋。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 163030,
      "title": "长城外",
      "content": [
        "饮马长城窟，马繁水枯竭。",
        "水竭将奈何，马嘶不肯歇。",
        "君看长城中，尽是骷髅骨。",
        "骷髅几千年，犹且未灭没。",
        "空衔千年冤，此冤何时雪。",
        "祖龙去已远，长城久迸裂。",
        "叹息此骷髅，夜夜泣秋月。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 163031,
      "title": "寰州道中",
      "content": [
        "穷荒六月天，地有一尺雪。",
        "孤儿可怜人，哀哀泪流血。",
        "书生不忍啼，尸坐愁欲绝。",
        "鼙鼓夜达明，角笳竞於邑。",
        "此时入骨寒，指堕肤亦裂。",
        "万里不同天，江南正炎热。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 163032,
      "title": "李陵台",
      "content": [
        "伊昔李少卿，筑台望汉月。",
        "月落泪纵横，凄然肠断裂。",
        "当时不受死，心怀归汉阙。",
        "岂谓壮士身，中道有摧折。",
        "我行到寰州，悠然见突兀。",
        "下马登斯台，台荒草如雪。",
        "妖氛霭冥蒙，六合何恍惚。",
        "伤彼古豪雄，清泪泫不歇。",
        "吟君五言诗，朔风共呜咽。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 163033,
      "title": "苏武洲毡房夜坐",
      "content": [
        "明发启帐房，冷气迸将入。",
        "饥鹰傍人飞，瘦马对人立。",
        "御寒挟貂裘，蒙头帽毡笠。",
        "凄然绝火烟，阴云压身湿。",
        "頼有葡萄醅，借煖敌风急。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 163034,
      "title": "居延",
      "content": [
        "忆昔苏子卿，持节入异域。",
        "淹留十九年，风霜毒颜色。",
        "啮毡曾牧羝，跣足涉沙碛。",
        "日夕思汉君，恨不生羽翼。",
        "一朝天气清，持节入汉国。",
        "胤子生别离，回视如块砾。",
        "丈夫抱赤心，安肯泪沾臆。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 163035,
      "title": "昭君墓",
      "content": [
        "一昔王昭君，远嫁单于去。",
        "上马出宫门，琵琶语如诉。",
        "昔为汉宫妃，今作胡虏妇。",
        "别来岁月深，竟入泉下路。",
        "还知身后名，青草覆孤墓。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 163036,
      "title": "开平雪霁",
      "content": [
        "雪霁山崔嵬，平荒绝人迹。",
        "猎猎大风寒，杳杳远天碧。",
        "腐儒策蹇馿，觅句绕沙碛。",
        "一吟三徘徊，日卓人影直。",
        "孤鸿云中来，对我声呖呖。",
        "迺知晴天好，物类各有适。",
        "顷刻片云生，雪花大如席。",
        "伟哉复伟哉，造物真戏剧。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 163037,
      "title": "天山观雪王昭仪相邀割驼肉",
      "content": [
        "北征已十年，抑鬰悲局促。",
        "拄杖看天山，雪光皎如玉。",
        "满目鹯鹰飞，晴天猎鸿鹄。",
        "羁人灶无炊，竟夕枵其腹。",
        "美人塞边来，邀我分豆粥。",
        "手持并铁刀，欣然割驼肉。",
        "勿诮草堂翁，一饱死亦足。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 163038,
      "title": "草地",
      "content": [
        "龌龊复龌龊，昔闻今始见。",
        "一月不梳头，一月不洗面。",
        "饥则嚼干粮，渴则啖雪片。",
        "困来卧毡房，重裘颇相恋。",
        "故衣连百结，虮虱似珠串。",
        "平明猎阴山，鹰犬逐人转。",
        "呱呱冻欲僵，老娃泪如霰。",
        "忽有使臣来，宣赐尚方饍。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 163039,
      "title": "开平",
      "content": [
        "冷霰撒行车，呻吟独搔首。",
        "须臾大如席，风卷半空走。",
        "母子鼻酸辛，依依自相守。",
        "书生倒行囊，沽来一樽酒。",
        "暂时借温和，耳热岂长久。",
        "万木舞阴风，言语冰在口。",
        "毡房耿无眠，兀兀听刁斗。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 163040,
      "title": "草地寒甚毡帐中读杜诗",
      "content": [
        "少年读杜诗，颇厌其枯槁。",
        "斯时熟读之，始知句句好。",
        "书生挟蠹鱼，流行万里道。",
        "朱颜日以衰，玄髪日已老。",
        "耿耿不圆卿，宁方自为皂。",
        "举目无寸亲，忧伤入怀抱。",
        "炎天冷如冰，碛地不生草。",
        "我马跑沙石，我饥面苍昊。",
        "人马不相离，冻死俱未保。",
        "何当回白日，阴云尽一扫。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 163041,
      "title": "阴山观猎和赵待制回文",
      "content": [
        "围猎看人放海青，黑山峡口路交横。",
        "飞鸿雨湿云天远，去马风寒雪塞平。",
        "归客北边关柝击，过军西畔寨灯明。",
        "巍巍殿帐毡房煖，衣铁冷深更鼓鸣。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 163042,
      "title": "万安殿夜直",
      "content": [
        "凤衔紫诏下云端，千载明良际会难。",
        "金阙早朝天表近，玉堂夜直月光寒。",
        "宫衣屡赐恩荣重，御宴时开礼数宽。",
        "却忆玄都人去后，桃花零落倚阑干。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 163043,
      "title": "送张舍人从军",
      "content": [
        "大笑出门去，谁能笔砚囚。",
        "十年浑不调，万里欲先侯。",
        "衰尔吾将老，飞扬子未休。",
        "他年身退遁，肯伴赤松游。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 163044,
      "title": "文山丞相丙子自京口脱去变姓名作清江刘洙今日相对得非梦耶",
      "content": [
        "昔年变姓走淮滨，虎豹从横独怆神。",
        "青海茫茫迷故国，黄尘黯黯泣孤臣。",
        "魏雎张禄梦中梦，越蠡陶朱身后身。",
        "今日相看论往事，刘洙元是姓文人。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 163045,
      "title": "读文山诗藁",
      "content": [
        "一朝禽瘴海，孤影落穷荒。",
        "恨极心难雪，愁浓鬓易霜。",
        "燕荆歌易水，苏李泣河梁。",
        "读到艰难际，梅花铁石肠。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 163046,
      "title": "送张总管归广西",
      "content": [
        "燕玉成行把酒巵，酒巵未尽即言离。",
        "宾鸿冒雨回峰日，旅燕冲风过海时。",
        "棹拨蓼湾秋斫脍，剑飞梅岭夜吟诗。",
        "明年有约重来否，一骑红尘贡荔枝。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 163047,
      "title": "易水",
      "content": [
        "芦苇萧森古渡头，征鞍卸却上孤舟。",
        "烟笼古木猿啼夜，月印平沙雁叫秋。",
        "砧杵远闻添客泪，鼓鼙才动起人愁。",
        "当年击筑悲歌处，一片寒光凝不流。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 163048,
      "title": "北岳降香呈严学士",
      "content": [
        "万里溟蒙起战埃，翩翩勒马出金台。",
        "同君远使山头去，如朕亲行岳顶来。",
        "野庙横斜挨老树，古碑颠倒枕荒苔。",
        "瞻天只有丹心在，香篆炉熏达九垓。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 163049,
      "title": "太华峰",
      "content": [
        "华山山木乱纷纷，铁锁垂垂袅袅猿。",
        "石齿齿前光烁烁，壁岩岩后势奔奔。",
        "奇奇怪怪云根耸，鬰鬰葱葱雾气昏。",
        "上上上头仍上上，最高高处有乾坤。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 163050,
      "title": "商山庙",
      "content": [
        "蹇柏枯松枕庙门，独瞻遗像酹清尊。",
        "紫芝奕奕浮香气，碧草纤纤没烧痕。",
        "羽翼已成犹有说，腹心相视更何言。",
        "高歌一曲归来隠，静看山禽哺子孙。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 163051,
      "title": "孟津",
      "content": [
        "寒芦风飒飒，时节近昏黄。",
        "木脱千山瘦，江空一水长。",
        "云高鹏北运，天阔雁南翔。",
        "读尽焚舟赋，持觞酹子桑。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 163052,
      "title": "少室山",
      "content": [
        "岩岩路径入空蒙，中有幽人旧日宫。",
        "野草败垣供暮雨，断碑古木管秋风。",
        "山川融结千年秀，天地包笼一世雄。",
        "从此不须高索价，高名过眼总飘蓬。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 163053,
      "title": "天坛山",
      "content": [
        "我登天坛山，洒然清吟目。",
        "群峰如儿孙，罗列三十六。",
        "支藤陟曾巅，中有少室屋。",
        "山人化飞仙，庭除生苜蓿。",
        "古碑野火烧，剥落字难读。",
        "雏鹿卧幽岩，孤鸟响空谷。",
        "解鞍小迟留，偷闲半日足。",
        "长啸归去来，题诗纪幽独。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 163054,
      "title": "阿房宫故基",
      "content": [
        "祖龙筑长城，雄关百二所。",
        "阿房高接天，六国收歌女。",
        "跨海觅仙方，蓬莱眇何许。",
        "欲为不死人，万代秦宫主。",
        "风吹鲍鱼腥，兹事竟虚语。",
        "乾坤反掌间，山河泪如雨。",
        "谁怜素车儿，奉玺纳季父。",
        "楚人斩关来，一炬成焦土。",
        "空余此余基，千秋泣禾黍。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 163055,
      "title": "洛阳桥",
      "content": [
        "日西来到洛阳城，下马桥边信步行。",
        "红紫已无花烂漫，青黄只有草从横。",
        "风吹渭水秋砧急，月满秦川夜柝清。",
        "我醉欲眠眠不得，更听人唱楚歌声。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 163056,
      "title": "马嵬坡",
      "content": [
        "霓裳惊破出宫门，马上香罗拭泪痕。",
        "到此竟为山下鬼，不堪鞞鼓似招魂。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 163057,
      "title": "北邙山",
      "content": [
        "芒芒北邙山，高坟尽无主。",
        "惟有石麒麟，相向立秋雨。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 163058,
      "title": "天津桥",
      "content": [
        "白杨猎猎柳青青，怒浪高低不肯平。",
        "一自尧夫分手后，更无人听杜鹃声。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 163059,
      "title": "华清池",
      "content": [
        "一夜春寒事可知，海棠无地避风吹。",
        "温泉自向东流去，不管飞红出禁池。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 163060,
      "title": "终南山馆",
      "content": [
        "夜凉金气转凄其，正是羁孤不寐时。",
        "千古伤心南渡曲，一襟清泪北征诗。",
        "霜凝鞞鼓星横剑，风卷旌旗月满巵。",
        "旅雁已离榆塞去，帛书摇曳过江迟。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 163061,
      "title": "函谷关",
      "content": [
        "西风吹我度函关，古壑泉声静自闲。",
        "老子骑牛沙上去，仙人化鹤苑中还。",
        "断崖木脱悬残日，绝域云横失好山。",
        "旧说度关珠履客，一声鸡唱翠微间。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 163062,
      "title": "潼关",
      "content": [
        "蔽日乌云拨不开，昏昏勒马度关来。",
        "绿芜迳路人千里，黄叶邮亭酒一杯。",
        "事去空垂悲国泪，愁来莫上望乡台。",
        "桃林塞外秋风起，大漠天寒鬼哭哀。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 163063,
      "title": "秦岭",
      "content": [
        "峻岭登临最上层，飞埃漠漠草棱棱。",
        "百年世路多翻覆，千古河山几废兴。",
        "红树青烟秦祖陇，黄茅白苇汉家陵。",
        "因思马上昌黎伯，回首云横泪湿膺。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 163064,
      "title": "蓝田",
      "content": [
        "寒更客起卷花毡，又勒青骢过玉田。",
        "一匊归心千涧外，十分秋思两峰前。",
        "蓝关月冷猿啼木，秦岭风高雁贴天。",
        "北望茂陵应咫尺，髑髅沙白草芊芊。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 163065,
      "title": "嵩山  其一",
      "content": [
        "客行天地中，嵩峰何突兀。",
        "鸟道阻且修，马烦行复歇。",
        "一入玉女窗，便觉幽兴发。",
        "好鸟鸣嘤嘤，细草乱如髪。",
        "石城荫青松，琼壁白喷雪。",
        "中有神圣居，飞甍半摧折。",
        "宝绘翳苔莓，古碑字亦灭。",
        "莫辩千载事，焉能踏仙辙。",
        "徒有感慨怀，脉脉泪不绝。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 163066,
      "title": "嵩山  其二",
      "content": [
        "行行太室峰，秋声若鸣镝。",
        "流目瞩崎岖，蓬莱应咫尺。",
        "上有神仙区，下有穆王宅。",
        "徘徊复徘徊，泫然感畴昔。",
        "八骏不重来，秋山空月白。",
        "安得会璆韶，共作瑶池客。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 163067,
      "title": "七月初七夜渡黄河",
      "content": [
        "长河界破东南天，怒涛日夜如奔川。",
        "此行适逢七月夕，妖氛散作空中烟。",
        "牛郎织女涉清浅，支机石上今何年。",
        "扬帆一纵万里目，身世恍若槎中仙。",
        "仰看银河忽倒泻，月明风露何娟娟。",
        "狂来拔剑斫河水，欲与祖逖争雄鞭。",
        "扣舷把酒酹河伯，低头细看河清涟。",
        "平生此怀具已久，到此欲说空回旋。",
        "嗟予不晓神灵意，咫尺雷雨心茫然。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 163068,
      "title": "汴都纪行",
      "content": [
        "寻僧入相国寺，领客过太师桥。",
        "行到汴隄西畔，柳阴阴处鱼跳。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 163069,
      "title": "夷山醉歌  其一",
      "content": [
        "楚狂醉歌歌正发，更上梁台望明月。",
        "朔风猎猎吹我衣，绝代佳人皎如雪。",
        "搥羯鼓，弹箜篌，烹羊宰牛坐糟丘，一笑再笑扬清讴。",
        "遥看汴水波声小，锦櫂忘还事多少。",
        "昨日金明池上来，艮岳凄凉麋鹿遶。",
        "麦青青，黍离离，万年枝上鸦乱啼。",
        "二龙北狩不复返，六龙南渡无还期。",
        "金铜泪迸露盘湿，画阑桂柱酸风急。",
        "鸠居鹊构苍隼入，蛇出燕巢白狐立。",
        "东南地陷妖氛黑，双凤高飞海南陌。",
        "吴山日落天沈沈，母子同行向天北。",
        "关河万里雨露深，小儒何必悲苦辛。",
        "归来耳热忘头白，买笑挥金莫相失。",
        "呼奚奴，吹觱篥，美人纵复横，今夕复何夕。",
        "楚狂醉歌歌欲辍，老猿为我啼竹裂。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 163070,
      "title": "夷山醉歌  其二",
      "content": [
        "呜呼再歌兮花满台，好月为我光徘徊。",
        "人生在世不满百，纷华过眼皆成灰。",
        "夷山青青汴水绿，西北高楼咽丝竹。",
        "美人十指纤如玉，为我行觞歌一曲。",
        "含宫嚼征当窗牖，露脚斜飞湿杨柳。",
        "就中有客话陈桥，如此山河落人手。",
        "客且住，听我语，楚汉中分两丘土。",
        "七雄争战总尘埃，三国鶑花浩无主。",
        "咸阳宫殿不复都，华清池沼温泉枯。",
        "世间兴废奔如电，沧海桑田几回变。",
        "人生得意且尽欢，何须苦苦为高官。",
        "人生有命且行乐，何必区区叹牢落。",
        "遮莫金章与玉珂，何如桐江披钓蓑。",
        "遮莫貂蝉贵此身，何如柴桑漉酒巾。",
        "君不见海上看羊手持节，饥来和雪和毡囓。",
        "又不见饭颗山头人见嗤，愁吟痛饮真吾师。",
        "美人美人劝我酒，有客有客听我歌。",
        "须臾客醉美人睡，我亦不知天与地。",
        "呜呼再歌兮无人听，月自落兮酒未醒。"
      ],
      "author": {
        "id": 5562,
        "name": "汪元量"
      },
      "dynasty": {
