{
  "data": [
    {
      "id": 177004,
      "title": "朔会堂",
      "content": [
        "朔旦集俺吏，兹堂簪组繁。",
        "舞空孤鹤下，映日两凫翻。",
        "花散东方骑，萍浮北海樽。",
        "须知太守贵，铙吹引朱轮。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 177005,
      "title": "浮醳亭",
      "content": [
        "曲水华榱下，浮觞去复还。",
        "浪摇花影碎，日射酒缸殷。",
        "灭没遥寻客，徘徊怯度湾。",
        "穷欢不知醉，清泚照心颜。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 177006,
      "title": "清燕亭",
      "content": [
        "波澄荫群木，永日湛清华。",
        "碧筿静秋色，白苹低晚花。",
        "松声工醒酒，泉味最便茶。",
        "外事付丞掾，无妨风景嘉。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 177007,
      "title": "流芳桥",
      "content": [
        "桥下流芳度，余春日夕催。",
        "呼人洗樽斚，招客藉莓苔。",
        "倚柱时流滞，随波乍往回。",
        "仙家如不近，安得此花来。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 177008,
      "title": "晓景亭",
      "content": [
        "帘栊分晓色，远树子规啼。",
        "浓露侵衣冷，晴烟压水低。",
        "神游灵境徤，身入画图迷。",
        "衙吏无烦报，河洲鹭正栖。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 177009,
      "title": "假山",
      "content": [
        "广汉土平远，已嫌丘壑疏。",
        "呼工刻岩洞，应手出庭除。",
        "缥渺神仙宅，嵌空虎豹居。",
        "人功与天力，秀绝两何如。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 177010,
      "title": "探花桥",
      "content": [
        "桥边春意近，五马屡徘徊。",
        "湖水旦暮渌，林花早晚开。",
        "适因尝酒到，又为赋诗来。",
        "借问双华表，经过日几回。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 177011,
      "title": "乐轩",
      "content": [
        "繁弦凝绿水，叠鼓掺渔阳。",
        "风结舞初急，尘飞歌正长。",
        "凫鹥争上下，栋宇为低昂。",
        "太守且安坐，新声未遽央。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 177012,
      "title": "坐船",
      "content": [
        "使君张皂盖，高宴碧湖心。",
        "苒蒻牵菱蔓，夷犹泊柳阴。",
        "晚风侵坐冷，春浪没篙深。",
        "倒载归何晚，波间夕照沈。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 177013,
      "title": "枇杷洲",
      "content": [
        "周官歛珍味，汉苑结芳根。",
        "何意荒洲上，犹余嘉树存。",
        "犯寒花已发，迎暑实尤繁。",
        "愿逐蒲萄使，离宫奉至尊。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 177014,
      "title": "寓泊郑圃寄献昌言舍人",
      "content": [
        "旅食缁衣馆，飘蓬怳自迷。",
        "树横寒雾远，山隐古原低。",
        "愁暮空庭雀，惊晨别墅鸡。",
        "故人何处在，依约玉绳西。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 177015,
      "title": "奉和始平公忆东平  其一",
      "content": [
        "相印东临汶水阳，两看春叶与秋霜。",
        "登山置酒延邹湛，上马回鞭问葛强。",
        "溪竹低垂寒滴翠，露荷相倚净交香。",
        "宵衣深念长城固，肯得从容傲醉乡。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 177016,
      "title": "奉和始平公忆东平  其二",
      "content": [
        "千岩秀色拥晴川，万顷陂光上下天。",
        "委地鱼盐随处市，蔽空桑柘不容田。",
        "讼庭虚静官曹乐，儒服寛长邑里贤。",
        "不为从知方负羽，独乘鱼艇老风烟。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 177017,
      "title": "和运使舍人北园饯别行憩三交僧舍冒雪宿百井关见寄",
      "content": [
        "骊驹北上雪孱颜，韊矢前驱度汉关。",
        "僧室松杉清照眼，驿亭烟火迥依山。",
        "马衔边草枯犹瘦，鴈怯胡云冷未还。",
        "贱子不须回首问，鬓毛萧飒簿书间。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 177018,
      "title": "又和留题定襄驿",
      "content": [
        "按节羊肠阪，褰帷并塞州。",
        "仁风熙爱日，清德凛高秋。",
        "甘泽随征盖，华星近戍楼。",
        "佗年叱驭事，直笔寄歆彪。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 177019,
      "title": "又寄献",
      "content": [
        "承明共直庐，瞬息八年余。",
        "幸托屏星驾，前迎使者车。",
        "迹虽殊贵贱，心不置亲疏。",
        "青眼披情素，犹如相见初。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 177020,
      "title": "自嘲",
      "content": [
        "英名愧终贾，高节谢巢由。",
        "直取云山笑，空为簪组羞。",
        "浮沈乖俗好，隐显拙身谋。",
        "惆怅临清鉴，霜毛不待秋。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 177021,
      "title": "晋阳三月未有春色",
      "content": [
        "天心均煦妪，物态异芬芳。",
        "上国花应烂，边城柳未黄。",
        "清明空改火，元已漫浮觞。",
        "仍说秋寒早，年年八月霜。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 177022,
      "title": "柳溪对雪",
      "content": [
        "春风不胜雪，散漫度龙沙。",
        "密映缘谿柳，争飞乱眼花。",
        "鸱夷赊美酒，油壁系轻车。",
        "塞下芳菲晚，聊将当物华。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 177023,
      "title": "酪羮",
      "content": [
        "军厨重羊酪，飨士旧风传。",
        "不数紫莼滑，徒夸素鲔鲜。",
        "𤐣蠡烦挏取，勺药助烹煎。",
        "莫与吴儿说，还令笑茂先。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 177024,
      "title": "奉同道矩谢始平公惠砚",
      "content": [
        "爵台今已倾，飘瓦出芜城。",
        "还入缣缃用，尤资笔墨精。",
        "相君怜古物，内史擅书名。",
        "聊用飞军檄，何愁楯鼻平。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 177025,
      "title": "陪始平公燕柳谿",
      "content": [
        "谿光不动柳风轻，玉帐森沈拥万兵。",
        "鸥入烟中闲自舞，鱼翻波面喜相迎。",
        "楼船下视晴天碧，鼓吹前驱远陌清。",
        "桃李归时应盛发，薫然和气满春城。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 177026,
      "title": "送王都官官满还都",
      "content": [
        "粹美清庙器，可嗟沉下僚。",
        "优游仲举坐，洋溢海沂谣。",
        "奏课应居首，知音况满朝。",
        "从今黄鹄举，眼冷看青霄。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 177027,
      "title": "到并州已复数月率尔成诗",
      "content": [
        "忽忽此何地，经时更自猜。",
        "深疑醉里得，复似梦中来。",
        "薄宦真何益，浮生信可咍。",
        "鹏蜩定有分，不若寸心灰。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 177028,
      "title": "和道矩送客汾西村舍杏花盛开置酒其下",
      "content": [
        "田家繁杏压枝红，远胜桃夭与李秾。",
        "何事偏宜闲处植，无端复向别时逢。",
        "林间暂系黄金勒，花下聊飞码碯钟。",
        "会待重来醉嘉树，只愁风雨不相容。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 177029,
      "title": "北轩老杏其大十围春色向晚止开一花予悯其憔悴作诗嘲之",
      "content": [
        "春木争秀发，嗟君独不材。",
        "须惭一花少，强逐众芳开。",
        "顽艶人谁采，微香蝶不来。",
        "直为无用物，空尔费栽培。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 177030,
      "title": "杏解嘲",
      "content": [
        "造物本非我，荣枯那足言。",
        "但余良干在，何必艶花繁。",
        "壮丽华林苑，欢娱梓泽园。",
        "芳菲如可采，岂得侍君轩。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 177031,
      "title": "寄陜西提刑江学士",
      "content": [
        "明主于庶狱，选才从本朝。",
        "鄼侯三尺律，汉使一封轺。",
        "郡国清名满，关河古意饶。",
        "凄凉乘障客，华髪日萧萧。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 177032,
      "title": "从始平公城西大阅",
      "content": [
        "沧溟浴日照春台，组练光中玉帐开。",
        "汾水腾凌金鼓震，西山宛转斾旌回。",
        "逍遥静散晴空雨，叱咤横飞迥野雷。",
        "坐镇四夷真汉相，武侯空复道英才。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 177033,
      "title": "陪诸君北园乐饮",
      "content": [
        "浩歌纵饮任天机，莫使欢娱与性违。",
        "玉枕醉人从独卧，金羁倦客听先归。",
        "须知会府闲时少，况复边城乐事稀。",
        "花卉正浓风日好，今年已不负春晖。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 177034,
      "title": "和道矩红梨花二首  其一",
      "content": [
        "繁枝细叶互低昂，香敌酴醾艶海棠。",
        "应为穷边太寥落，并将春色付秾芳。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 177035,
      "title": "和道矩红梨花二首  其二",
      "content": [
        "蜀江新锦濯朝阳，楚国纤腰傅薄粧。",
        "何事白花零落早，同时不改鬭芬芳。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 177036,
      "title": "和懋贤闻道矩小园置酒助以酒果副之以诗",
      "content": [
        "芙蓉幕下惜余闲，不使芳华取次残。",
        "珍果醇醪与新句，并将佳味助清欢。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 177037,
      "title": "数日不至后圃今晚偶来芳物都尽率然成诗",
      "content": [
        "烂漫不解赏，飘零空惨凄。",
        "残红正满地，不忍踏芳蹊。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 177038,
      "title": "和乐道自河外南辕过宜芳雨晴和气景物可爱马上偶成",
      "content": [
        "京洛春应老，河边初解颜。",
        "碧浮烟际草，翠滴雨余山。",
        "目极褰帷外，诗成揽辔间。",
        "满川桃李色，共喜传车还。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 177039,
      "title": "夏日",
      "content": [
        "穷边已深夏，气色耿清秋。",
        "鲜旭开山郭，凉烟澹戍楼。",
        "兠铃烽火息，区脱虏尘收。",
        "迨此军中暇，无妨文雅游。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 177040,
      "title": "晨发故关寄逢吉",
      "content": [
        "画戟衣中趋绛帐，驿亭门外拂征鞍。",
        "已嗟漂泊三年别，更负从容十日欢。",
        "暖席未穷谈笑乐，陟冈相望滞留难。",
        "扬鞭策马几多意，原上秋风作晓寒。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 177041,
      "title": "中秋夕始平公命与考校诸君置酒赋诗",
      "content": [
        "月华秋色雨鲜新，万里澄空不受尘。",
        "兔濯素毛腾浩露，桂飘香实下飞轮。",
        "光侵酒面寒无力，清入诗豪健有神。",
        "坐客何须辞醉倒，相君应不惜车茵。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 177042,
      "title": "病酒呈晋州李八丈",
      "content": [
        "身如五岭炎蒸里，心似三江高浪中。",
        "谁道醉乡风土好，舟车常愿不相通。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 177043,
      "title": "和李八丈小雪同会有怀邻几",
      "content": [
        "天禄淹回德齿尊，暂留汾曲两朱轓。",
        "闲轩坐啸正飞雪，同舍倦游来及门。",
        "空叹高歌如郢客，愧无佳赋似文园。",
        "坐中犹欠邻几在，深负棋枰与酒樽。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 177044,
      "title": "三月晦日登丰州故城",
      "content": [
        "春尽芜城天一涯，白榆生荚柳生花。",
        "满川战骨知谁罪，深属来人戒覆车。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 177045,
      "title": "送张学士两浙提点刑狱",
      "content": [
        "朝家重典刑，书府借时英。",
        "钲鼓喧江下，云山拂眼清。",
        "秋风鲈鲙美，书日锦衣荣。",
        "勿似朱翁子，空令守邸惊。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 177046,
      "title": "寄聂之美",
      "content": [
        "去岁双毛白，今春一齿零。",
        "人生浮似叶，客宦泛如萍。",
        "塞上貂裘弊，天涯海气腥。",
        "何当占箕颍，萧散并柴扃。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 177047,
      "title": "又寄",
      "content": [
        "心目悠悠逐去鸿，别来容易四秋风。",
        "莫嗟密密书连纸，万里经年信一通。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 177048,
      "title": "送昌言舍人得告还蜀三首  其一",
      "content": [
        "迢递铜梁道，凝严青琐闱。",
        "负书当日去，鸣玉此时归。",
        "乡树迎朱毂，江花照锦衣。",
        "临邛不足并，荣耀古今稀。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 177049,
      "title": "送昌言舍人得告还蜀三首  其二",
      "content": [
        "凄怆怀桑梓，劬劳咏蓼莪。",
        "树风今远矣，鼎食奈悲何。",
        "剑阁登车近，秦关屈指过。",
        "腾装才首路，夕梦已江沱。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 177050,
      "title": "送昌言舍人得告还蜀三首  其三",
      "content": [
        "富贵动归思，由来光里闾。",
        "戒门羞主父，负弩笑相如。",
        "外物有荣悴，中心无戚疏。",
        "遥知见亲旧，不改布衣初。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 177051,
      "title": "祁国正献公挽歌三首  其一",
      "content": [
        "舟楫才猷大，冰霜德操坚。",
        "陶钧成茂业，书史乐高年。",
        "瞻望簪绅共，吁嗟馆舍捐。",
        "举时无异论，方信令名全。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 177052,
      "title": "祁国正献公挽歌三首  其二",
      "content": [
        "钧玉吴台旧，诛茅梁苑新。",
        "位登华衮贵，家似布衣贫。",
        "直道高当世，清风遗后人。",
        "千秋寒照目，竹帛不栖尘。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 177053,
      "title": "祁国正献公挽歌三首  其三",
      "content": [
        "先子同乌府，知音诚皦然。",
        "脱缞来拜伏，抚首辱哀怜。",
        "迨此泉扃掩，空悲尘网牵。",
        "无由怀酒絮，撇涕望新阡。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 177054,
      "title": "侍读王文公挽歌二首  其一",
      "content": [
        "石室书编富，金华讲席重。",
        "荐神归愽洽，鸣玉称雍容。",
        "贰负累囚象，尸臣古瑑踪。",
        "老成今已矣，咨访欲谁从。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 177055,
      "title": "侍读王文公挽歌二首  其二",
      "content": [
        "杖底潜蛇影，门阴集戴鵀。",
        "玉楼新记就，石椁旧铭沈。",
        "箧有封峦札，籝无遗子金。",
        "寂寥封马鬛，秋色净松林。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 177056,
      "title": "相国广平文简程公挽歌二首  其一",
      "content": [
        "明直君臣合，安危将相兼。",
        "金章四辅贵，玉帐万兵严。",
        "御侮长城隐，临繁利刃铦。",
        "南山𫕥岩石，何以慰民瞻。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 177057,
      "title": "相国广平文简程公挽歌二首  其二",
      "content": [
        "帝诰封泥紫，皇坟杀简青。",
        "坐谈安玉垒，专对詟龙庭。",
        "黼黻昭文理，冰霜莹典刑。",
        "英灵入箕尾，终古作天星。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 177058,
      "title": "送王书记之官永兴",
      "content": [
        "白髪添新镊，红尘满弊衣。",
        "人生适未值，吾道岂云非。",
        "巩洛风烟远，函秦草树微。",
        "长安春酒美，行乐勿令希。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 177059,
      "title": "和钱学士呈邵兴宗",
      "content": [
        "霜露苍苍宰树高，累茵列鼎重鸿毛。",
        "蒹葭自幸犹依玉，髋髀何能学奏刀。",
        "才薄无由禆覆焘，命奇不得报劬劳。",
        "平生念此心先乱，蓼蓼难分莪与蒿。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 177060,
      "title": "晓思",
      "content": [
        "束带朝尚早，蓬门未脱扃。",
        "短篱潜落月，老树带孤星。",
        "隐几貂裘黑，开编竹简青。",
        "子云非执戟，何以得穷经。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 177061,
      "title": "送朱职方提举江淮运盐",
      "content": [
        "熬漉沧波耗，征输泽国贫。",
        "婴罗矜赤子，运䇲借能臣。",
        "拜手觚棱晓，浮舟狼汤春。",
        "东南待苏息，别酒莫逡巡。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 177062,
      "title": "送次道知太平州",
      "content": [
        "狼汤春流满，芜湖候吏迎。",
        "旌旟晓日丽，钲鼓野风清。",
        "暂喜红尘远，休嗟素髪生。",
        "专城方四十，自古以为荣。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 177063,
      "title": "送苏屯田知单州",
      "content": [
        "佳郡望都城，相闻击柝声。",
        "宾朋才执别，耆旧已前迎。",
        "彩服当年戏，骊驹此日荣。",
        "弦歌应尽在，琴调不须更。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 177064,
      "title": "钱君倚示诗有归吴之兴为诗三十二韵以赠",
      "content": [
        "吴越为君土，崤函是我家。",
        "濯缨从吏事，倾盖聚京华。",
        "奕世交朋重，同僚分谊加。",
        "声光尝耳剽，臭味辱肩差。",
        "选士参县石，烝髦应椓罝。",
        "帝畿围日月，蓬堵积烟霞。",
        "咨访倾肝胆，推褒借齿牙。",
        "后来惭瓦砾，旁倚愧蒹葭。",
        "谈论寥天一，诙谐老柏槎。",
        "虚舟坦莫逆，璞玉莹无瑕。",
        "信美陪游衍，胡为起咄嗟。",
        "劳歌尽乡思，旅梦各天涯。",
        "诚厌簪绅累，难堪狱讼哗。",
        "缿筩朝插猬，贯索暮如麻。",
        "霡霂霑朝服，蜩螗沸尹衙。",
        "宿奸牢窟宅，弊俗费鞭挝。",
        "𫚖鲙思吹絮，羊羮忆卧沙。",
        "梅林连雨熟，梨味得霜佳。",
        "秋色城临水，春风路入花。",
        "稻肥初断蟹，桑密不通鸦。",
        "蹙衂浮盘芡，钩联卧垅瓜。",
        "江莼半卷叶，石蕨乍舒芽。",
        "风物随乡乐，山川苦道遐。",
        "若人才有裕，修已德无邪。",
        "正恐临髋髀，安能舍镆鎁。",
        "怒飞期寖逼，肥遯迹犹賖。",
        "不比沟中木，微同井底蛙。",
        "果能真引去，谁复强邀遮。",
        "旋结蜗牛舍，还乘下泽车。",
        "闭门常反拒，醉帻任欹斜。",
        "林野游如鹿，泥涂蛰似蛇。",
        "故人时记忆，阳羡致新茶。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 177065,
      "title": "喜张圣民得登州",
      "content": [
        "昼日少闲暇，中宵梦亦劳。",
        "符移空浩浩，榜楚镇謷謷。",
        "敢说今求郡，番思昔坐曹。",
        "羡君乘五马，东去一何高。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 177066,
      "title": "诗寄云夫处士老兄兼呈知府待制八丈",
      "content": [
        "一鹗曾飞奏，中林下鹤书。",
        "今乘使君马，重到逸人居。",
        "松竹过从久，闾阎惠爱余。",
        "只应棠树影，比旧更扶疏。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 177067,
      "title": "和任屯田感旧叙怀",
      "content": [
        "结交英俊乐如何，风谊敦明寄咏歌。",
        "自致青云今有几，化为异物已居多。",
        "椟中本自沽良价，毫末安能滑至和。",
        "邻笛不堪频叹息，酒炉那得重经过。",
        "年华易度窗尘影，人事难期海水波。",
        "贤业著鞭犹可在，况君壮齿未蹉跎。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 177068,
      "title": "送李学士使北",
      "content": [
        "征盖霜空迥，飘飘迎塞鸿。",
        "虏牙侵海角，汉节下天中。",
        "酒薄阴山雪，裘寒易水风。",
        "边声不可听，归思浩无穷。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 177069,
      "title": "送薛水部十丈通判并州",
      "content": [
        "十万貔貅士，旌旗晋水阳。",
        "元戎倚耆硕，别乘选才良。",
        "秀直寒松节，精明利剑铓。",
        "知君留滞久，从此欲腾骧。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 177070,
      "title": "送祖泽之守陜",
      "content": [
        "声教空岩穴，夫君集帝庭。",
        "辞华动丹扆，光价塞青冥。",
        "俊德争推毂，荣涂易建瓴。",
        "陆离寒水玉，磊落曙天星。",
        "得丧谁先识，艰虞困屡经。",
        "蹉跎渥洼足，漂泊凤凰翎。",
        "粉署疏恩纪，甘棠寄典刑。",
        "仁风思布濩，疲俗待绥宁。",
        "贱子良多愧，余光每乞灵。",
        "题名联士版，占籍备民丁。",
        "种种颠毛白，萧萧垄栢青。",
        "陌头瞻皂盖，独立涕飘零。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 177071,
      "title": "奉和江邻几六月七日文德殿观文武百官等上尊号十五韵",
      "content": [
        "舜禹曾何与，羲农实强名。",
        "含灵徒叶赞，造物始无情。",
        "阊阖非烟澹，觚棱晓气清。",
        "葳蕤大衢隘，殷辚外朝盈。",
        "鲜旭分衣绘，薫风拂佩琼。",
        "华颠方内集，殊俗海隅倾。",
        "棨戟金闺奥，囊书赭案横。",
        "敷言齐列位，稽首从群卿。",
        "不报乾坤施，难图日月明。",
        "仁心由性得，治体与时行。",
        "金石皆中款，丹青岂外荣。",
        "功归元首重，泽及草茅轻。",
        "业业冲虚意，区区爱戴诚。",
        "何为犹让德，不以慰怀生。",
        "退复歌天保，期于采颂声。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 177072,
      "title": "和始平公郡斋偶书二首  其一",
      "content": [
        "文武从容两有余，公槐将幕往来居。",
        "已安四海如三杰，欲散千金比二疏。",
        "今日监边亲跪毂，佗年入殿赐乘车。",
        "武侯暂为苍生起，长忆隆中卧旧庐。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 177073,
      "title": "和始平公郡斋偶书二首  其二",
      "content": [
        "平安候火出云间，区脱无尘刁斗闲。",
        "汉相威声遥制敌，胡兵远迹夜开关。",
        "赤松雅意思轻举，黄阁群心望复还。",
        "玉帐牙旗空壮观，谢公高兴在东山。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 177074,
      "title": "感兴寄聂之美",
      "content": [
        "平生百无可，强为一官縻。",
        "世味偏予薄，心期独子知。",
        "林猿愁玉琐，枥马患金羁。",
        "年事今华髪，求荣欲为谁。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 177075,
      "title": "八月七日夜省直苦雨三首  其一",
      "content": [
        "夜色槐阴重，雨声官舍寒。",
        "野农安敢问，环堵未能完。",
        "尽日流云度，何时大块干。",
        "正愁开霁晚，霜雾满红栏。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 177076,
      "title": "八月七日夜省直苦雨三首  其二",
      "content": [
        "怅望中秋月，于今已上弦。",
        "明生圭様小，影露桂花偏。",
        "幽思邈难致，浮云去不还。",
        "何当出阴翳，清彻照中天。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 177077,
      "title": "八月七日夜省直苦雨三首  其三",
      "content": [
        "菊蘂如排粟，青青见叶心。",
        "未尝窥白日，何以散黄金。",
        "欹侧疏篱短，绵延蔓草深。",
        "寒蛩尔何与，终夕亦悲吟。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 177078,
      "title": "次韵和邻几秋雨十六韵",
      "content": [
        "气象殊朝夕，兴居错晦明。",
        "混元初不宰，霪雨浩无程。",
        "蛰隘宁天意，咨嗟固物情。",
        "曣㬈方有望，荟蔚已随生。",
        "杲杲升还隐，凄凄断复行。",
        "乱莎长被径，荒藓绿缘甍。",
        "辙迹康庄绝，潢污垅亩平。",
        "茅茨不足庇，禾黍若为成。",
        "蟋蟀颓墙泣，蛜蝛坏灶盈。",
        "乘时众鸥舞，得意怒蛙鸣。",
        "牛马谁分异，萧兰已混并。",
        "居闲犹叵度，负重况遐征。",
        "舟泊川无渚，轮摧路有阬。",
        "轑羹愁病妇，炀灶拥寒婴。",
        "灾不妨明德，神应格至诚。",
        "淳光终下烛，时藿久心倾。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 177079,
      "title": "紫微石舍人挽歌二首  其一",
      "content": [
        "地胜岷峨秀，时清隽乂生。",
        "扬雄晚得禄，何武少知名。",
        "性有图书癖，心忘绂冕荣。",
        "前年归谕蜀，不使里人惊。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 177080,
      "title": "紫微石舍人挽歌二首  其二",
      "content": [
        "顾我非君比，最为相得欢。",
        "平生游处久，美行始终完。",
        "长夜忍埋玉，秋霜不借兰。",
        "西风湿襟袖，空有泪阑干。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 177081,
      "title": "次韵和冲卿中秋胧月",
      "content": [
        "岂无锦幄翠帘垂，匝树明灯正赫曦。",
        "共惜月华方满夜，更当秋色中分时。",
        "乌皮几稳风侵鬓，白玉楼高冷透肌。",
        "千里浮云何处断，北来试问鴈应知。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 177082,
      "title": "次韵和江邻几九月五日省直",
      "content": [
        "群驺布路歆，瘦马解鞍回。",
        "雨阕虫声乐，秋深菊意催。",
        "图书纷自适，僚友邈谁陪。",
        "何以消寒夜，残醪不满杯。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 177083,
      "title": "吴正肃公挽歌辞三首  其一",
      "content": [
        "皇家延茂异，鹗立迥无伦。",
        "高议谁能夺，英才自有真。",
        "骅骝宁受絷，水鉴不栖尘。",
        "试为咨清论，风流第几人。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 177084,
      "title": "吴正肃公挽歌辞三首  其二",
      "content": [
        "辞华已独步，政治复无前。",
        "吏不容三宂，民皆戴二天。",
        "于今知和寡，自古愧才偏。",
        "惆怅棠阴下，仁风尚蔼然。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 177085,
      "title": "吴正肃公挽歌辞三首  其三",
      "content": [
        "念昔少年日，谬登君子堂。",
        "重言何以称，厚德不能忘。",
        "玉麈声容在，泉台岁月长。",
        "凭谁寄清泪，为我洒松冈。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 177086,
      "title": "和江邻几金铃菊",
      "content": [
        "何处见佳菊，秋风汶水阳。",
        "酒浮金铎细，露泛蜜房香。",
        "不谓红尘地，相逢君子堂。",
        "依然故人意，不减旧芬芳。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 177087,
      "title": "送贤良陈著作签书寿州判官",
      "content": [
        "海隅方万里，豪隽几何人。",
        "百汰求才尽，三薰得士新。",
        "声华四方耸，器业一朝伸。",
        "佗日苍生望，非徒泽寿春。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 177088,
      "title": "致政邵少卿挽词",
      "content": [
        "北固启佳城，东吴𫕥德星。",
        "穗帷长寂寞，羽扇遂飘零。",
        "泉烛千年碧，霜松数寸青。",
        "余庆知有在，玉树满阶庭。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 177089,
      "title": "之美访及不获展奉以诗为谢",
      "content": [
        "昔君来阙下，定馆必吾庐。",
        "今者虽相值，依然是索居。",
        "不堪休沐少，便使往还疏。",
        "深愧原思巷，空回长者车。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 177090,
      "title": "送聂秘丞宰桐城二首  其一",
      "content": [
        "问子青云器，胡为不少留。",
        "未能充禄养，安散及身谋。",
        "卓尔千人俊，居然百里忧。",
        "连城价终在，自是玉工羞。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 177091,
      "title": "送聂秘丞宰桐城二首  其二",
      "content": [
        "七载一相见，怳然如路衢。",
        "形骸渐枯槁，志业转荒芜。",
        "往事云过眼，新愁雪染须。",
        "明朝又分首，上马即重湖。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 177092,
      "title": "送蒲中舍霜致政归蜀  其一",
      "content": [
        "厌苦折腰久，飘然黄鹄飞。",
        "田园未芜没，邻曲有光辉。",
        "昔奋儒衣去，今纡朝绂归。",
        "人生贵知足，得此已为稀。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 177093,
      "title": "送蒲中舍霜致政归蜀  其二",
      "content": [
        "念昔两髦日，乌奴同燕游。",
        "随时自有乐，何物可为愁。",
        "岂意今头白，相逢欲涕流。",
        "凭君访题壁，好在水西楼。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 177094,
      "title": "苏门先生",
      "content": [
        "长啸苏门石，行藏世莫知。",
        "逍遥心迹远，寂寞姓名谁。",
        "郷在无何有，时方不可为。",
        "麒麟本神物，安得系而羁。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 177095,
      "title": "和冲卿喜雨偶成",
      "content": [
        "万里风随快雨来，尘昏消伏旱光开。",
        "物情濯热参差喜，天意为仁容易回。",
        "帘映薄寒灯有晕，窗含虚白麝成煤。",
        "君侯雅有江湖兴，萧洒何须气象催。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 177096,
      "title": "寄赠致仕刘都官",
      "content": [
        "星郎年未至，辞禄一何高。",
        "目莹栖灵气，眉疏出秀毫。",
        "胸中自有乐，身外尽徒劳。",
        "回首红尘地，纷纷笑我曹。",
        "解绂沱江外，诛茅井络边。",
        "老莱夫妇隐，韦孟子孙贤。",
        "浮蚁邀旁舍，蹲鸱种薄田。",
        "不须亲几杖，想望已萧然。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 177097,
      "title": "和宋郎中孟秋省直",
      "content": [
        "夜久残暑尽，好风来满襟。",
        "床空唯置枕，冠小不施簪。",
        "竹影乱凉月，林梢转晓参。",
        "人心有喧寂，何必欲云岑。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 177098,
      "title": "八月五日夜省直",
      "content": [
        "大火已西落，温风犹袭人。",
        "留连惜纨扇，散诞脱纱巾。",
        "蟾影夜色浅，蛩声秋意新。",
        "图书足自适，何物更关身。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 177099,
      "title": "送王著作西京签判",
      "content": [
        "古来都邑美，孰与雒阳先。",
        "况复元侯贵，兼之从事贤。",
        "玦离横阙塞，珠曲逗伊川。",
        "慰眼登临乐，送君空惘然。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 177100,
      "title": "梦稚子",
      "content": [
        "穷泉纤骨已成尘，幽草闲花二十春。",
        "昔日相逢犹是梦，今宵梦里更非真。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 177101,
      "title": "梅圣俞挽歌二首  其一",
      "content": [
        "兵形穷胜负，史法贯兴衰。",
        "落落虽殊众，恂恂不迕时。",
        "位卑名自重，才大命须奇。",
        "世俗那能识，伤嗟止为诗。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 177102,
      "title": "梅圣俞挽歌二首  其二",
      "content": [
        "漆灯无复曙，柏径不知春。",
        "南纪光华减，中朝俊秀贫。",
        "凄清千古韵，寂寞一丘尘。",
        "异日昭亭下，方多沥酒人。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 177103,
      "title": "次韵和王胜之十二月十五日朝退马上作",
      "content": [
        "瓦沟微白雪光清，阙角初红海日腾。",
        "尘息长街千骑入，鞘鸣深殿六龙升。",
        "云岩有客空回首，圭荜何人尚曲肱。",
        "自笑鲰生章绶缚，不容逃去正如罾。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
