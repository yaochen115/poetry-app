{
  "data": [
    {
      "id": 290937,
      "title": "续古二十九首 二十三",
      "content": [
        "魏宫薛家女，秀色倾三殿。",
        "武帝鼎湖归，一身似秋扇。"
      ],
      "author": {
        "id": 8770,
        "name": "陈陶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 290938,
      "title": "续古二十九首 二十四",
      "content": [
        "婵娟越机里，织得双栖凤。",
        "慰此殊世花，金梭忽停弄。"
      ],
      "author": {
        "id": 8770,
        "name": "陈陶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 290939,
      "title": "续古二十九首 二十五",
      "content": [
        "学古三十载，犹依白云居。",
        "每览班超传，令人慵读书。"
      ],
      "author": {
        "id": 8770,
        "name": "陈陶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 290940,
      "title": "续古二十九首 二十六",
      "content": [
        "雄剑久濩落，夜吟秋风起。",
        "不是懒为龙，此非延平水。"
      ],
      "author": {
        "id": 8770,
        "name": "陈陶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 290941,
      "title": "续古二十九首 二十七",
      "content": [
        "朝为杨柳色，暮作芙蓉好。",
        "春风若有情，江山相逐老。"
      ],
      "author": {
        "id": 8770,
        "name": "陈陶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 290942,
      "title": "续古二十九首 二十八",
      "content": [
        "景龙临太极，五凤当庭舞。",
        "谁信壁间梭，升天作云雨。"
      ],
      "author": {
        "id": 8770,
        "name": "陈陶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 290943,
      "title": "续古二十九首 二十九",
      "content": [
        "曾梦诸侯笑，康囚议脱枷。",
        "千根池底藕，一朵火中花。"
      ],
      "author": {
        "id": 8770,
        "name": "陈陶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 290944,
      "title": "永嘉赠别",
      "content": [
        "芳草温阳客，归心浙水西。",
        "临风青桂檝，几日白苹溪。"
      ],
      "author": {
        "id": 8770,
        "name": "陈陶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 290945,
      "title": "有所思",
      "content": [
        "欲唱玄云曲，知音复谁是。",
        "采掇情未来，临池画春水。"
      ],
      "author": {
        "id": 8770,
        "name": "陈陶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 290946,
      "title": "吴苑思",
      "content": [
        "今人地藏古人骨，古人花为今人发。",
        "江南何处葬西施，谢豹空闻采香月。"
      ],
      "author": {
        "id": 8770,
        "name": "陈陶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 290947,
      "title": "古意",
      "content": [
        "麻姑井边一株杏，花开不如古时红。",
        "西邻蔡家十岁女，年年二月卖东风。"
      ],
      "author": {
        "id": 8770,
        "name": "陈陶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 290948,
      "title": "朝元引四首 一",
      "content": [
        "帝烛荧煌下九天，蓬莱宫晓玉炉烟。",
        "无央鸾凤随金母，来贺熏风一万年。"
      ],
      "author": {
        "id": 8770,
        "name": "陈陶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 290949,
      "title": "朝元引四首 二",
      "content": [
        "正殿云开露冕旒，下方珠翠压鼇头。",
        "天鸡唱罢南山晓，春色光辉十二楼。"
      ],
      "author": {
        "id": 8770,
        "name": "陈陶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 290950,
      "title": "朝元引四首 三",
      "content": [
        "万宇灵祥拥帝居，东华元老荐屠苏。",
        "龙池遥望非烟拜，五色曈昽在玉壶。"
      ],
      "author": {
        "id": 8770,
        "name": "陈陶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 290951,
      "title": "朝元引四首 四",
      "content": [
        "宝祚河宫一向清，龟鱼天篆益分明。",
        "近臣谁献登封草，五岳齐呼万岁声。"
      ],
      "author": {
        "id": 8770,
        "name": "陈陶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 290952,
      "title": "宿天竺寺",
      "content": [
        "一宵何期此灵境，五粒松香金地冷。",
        "西僧示我高隐心，月在中峰葛洪井。"
      ],
      "author": {
        "id": 8770,
        "name": "陈陶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 290953,
      "title": "赋得古莲塘",
      "content": [
        "阖闾宫娃能采莲，明珠作佩龙为船。",
        "三千巧笑不复见，江头废苑花年年。"
      ],
      "author": {
        "id": 8770,
        "name": "陈陶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 290954,
      "title": "双桂咏",
      "content": [
        "青冥结根易倾倒，沃洲山中双树好。",
        "瑠璃宫殿无斧声，石上萧萧伴僧老。"
      ],
      "author": {
        "id": 8770,
        "name": "陈陶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 290955,
      "title": "夏日怀天台",
      "content": [
        "竹斋睡余柘浆清，麟凤诱我劳此生。",
        "勿忆天台掩书坐，涧云起尽红峥嵘。"
      ],
      "author": {
        "id": 8770,
        "name": "陈陶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 290956,
      "title": "临风叹",
      "content": [
        "芙蓉楼中饮君酒，骊驹结言春杨柳。",
        "豫章花落不见归，一望东风堪白首。"
      ],
      "author": {
        "id": 8770,
        "name": "陈陶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 290957,
      "title": "春日行",
      "content": [
        "𫛸鴂初鸣洲渚满，龙蛇洗鳞春水暖。",
        "病多欲问山寺僧，湖上人传石桥断。"
      ],
      "author": {
        "id": 8770,
        "name": "陈陶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 290958,
      "title": "春归去",
      "content": [
        "九十春光在何处，古人今人留不住。",
        "年年白眼向黔娄，唯放蛴螬飞上树。"
      ],
      "author": {
        "id": 8770,
        "name": "陈陶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 290959,
      "title": "蜀葵咏",
      "content": [
        "绿衣宛地红倡倡，熏风似舞诸女郎。",
        "南邻荡子妇无赖，锦机春夜成文章。"
      ],
      "author": {
        "id": 8770,
        "name": "陈陶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 290960,
      "title": "南昌道中",
      "content": [
        "古道夤缘蔓黄葛，桓伊冢西春水阔。",
        "村翁莫倚横浦罾，一半鱼虾属鹈獭。"
      ],
      "author": {
        "id": 8770,
        "name": "陈陶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 290961,
      "title": "子规思",
      "content": [
        "春山杜鹃来几日，夜啼南家复北家。",
        "野人听此坐惆怅，恐畏踏落东园花。"
      ],
      "author": {
        "id": 8770,
        "name": "陈陶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 290962,
      "title": "吴兴秋思二首 一",
      "content": [
        "不是苕溪厌看月，天涯有程云树凉。",
        "何意汀洲剩风雨，白苹今日似潇湘。"
      ],
      "author": {
        "id": 8770,
        "name": "陈陶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 290963,
      "title": "吴兴秋思二首 二",
      "content": [
        "日夕鲲鱼梦南国，苕阳水高迷渡头。",
        "故山秋风忆归去，白云又被王孙留。"
      ],
      "author": {
        "id": 8770,
        "name": "陈陶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 290964,
      "title": "闽川梦归",
      "content": [
        "千里潺湲建溪路，梦魂一夕西归去。",
        "龙舼欲上巴兽滩，越王金鸡报天曙。"
      ],
      "author": {
        "id": 8770,
        "name": "陈陶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 290965,
      "title": "竹十一首 一",
      "content": [
        "不压东溪绿玉君，天坛双凤有时闻。",
        "一峰晓似朝仙处，青节森森倚绛云。"
      ],
      "author": {
        "id": 8770,
        "name": "陈陶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 290966,
      "title": "竹十一首 二",
      "content": [
        "万枝朝露学潇湘，杳霭孤亭白石凉。",
        "谁道乖龙不得雨，春雷入地马鞭狂。"
      ],
      "author": {
        "id": 8770,
        "name": "陈陶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 290967,
      "title": "竹十一首 三",
      "content": [
        "啸入新篁一里行，万竿如罋锁龙泓。",
        "惊巢翡翠无寻处，闲倚云根刻姓名。"
      ],
      "author": {
        "id": 8770,
        "name": "陈陶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 290968,
      "title": "竹十一首 四",
      "content": [
        "青岚箒亚思吾祖，绿润偏多忆蔡邕。",
        "长听南园风雨夜，恐生鳞甲尽为龙。"
      ],
      "author": {
        "id": 8770,
        "name": "陈陶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 290969,
      "title": "竹十一首 五",
      "content": [
        "迸玉闲抽上钓矶，翠苗番次脱霞衣。",
        "山童泥乞青騘马，骑过春泉掣手飞。"
      ],
      "author": {
        "id": 8770,
        "name": "陈陶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 290970,
      "title": "竹十一首 六",
      "content": [
        "须题内史琅玕坞，几醉山阳瑟瑟村。",
        "剩养万茎将扫俗，莫教凡鸟闹云门。"
      ],
      "author": {
        "id": 8770,
        "name": "陈陶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 290971,
      "title": "竹十一首 七",
      "content": [
        "一溪云母间灵花，似到封侯逸士家。",
        "谁识雌雄九成律，子乔丹井在深涯。"
      ],
      "author": {
        "id": 8770,
        "name": "陈陶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 290972,
      "title": "竹十一首 八",
      "content": [
        "燕燕雏时紫米香，野溪羞色过东墙。",
        "诸儿莫抝成蹊笋，从结高笼养凤皇。"
      ],
      "author": {
        "id": 8770,
        "name": "陈陶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 290973,
      "title": "竹十一首 九",
      "content": [
        "一节呼龙万里秋，数茎垂海六鼇愁。",
        "更须瀑布峰前种，云里阑干过子猷。"
      ],
      "author": {
        "id": 8770,
        "name": "陈陶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 290974,
      "title": "竹十一首 十",
      "content": [
        "丘壑谁堪话碧鲜，静寻春谱认婵娟。",
        "会当小杀青瑶简，图写龟鱼把上天。"
      ],
      "author": {
        "id": 8770,
        "name": "陈陶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 290975,
      "title": "竹十一首 十一",
      "content": [
        "玄圃千春闭玉丛，湛阳一祖碧云空。",
        "不须骚屑愁江岛，今日南枝在国风。"
      ],
      "author": {
        "id": 8770,
        "name": "陈陶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 290976,
      "title": "钟陵秋夜",
      "content": [
        "洪崖岭上秋月明，野客枕底章江清。",
        "蓬壶宫阙不可梦，一一入楼归鴈声。"
      ],
      "author": {
        "id": 8770,
        "name": "陈陶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 290977,
      "title": "江上逢故人",
      "content": [
        "十年蓬转金陵道，长哭青云身不早。",
        "故乡逢尽白头人，清江颜色何曾老。"
      ],
      "author": {
        "id": 8770,
        "name": "陈陶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 290978,
      "title": "水调词十首 一",
      "content": [
        "黠虏迢迢未肯和，五陵年少重横戈。",
        "谁家不结空闺恨，玉筯阑干妾最多。"
      ],
      "author": {
        "id": 8770,
        "name": "陈陶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 290979,
      "title": "水调词十首 二",
      "content": [
        "羽管慵调怨别离，西园新月伴愁眉。",
        "容华不分随年去，独有妆楼明镜知。"
      ],
      "author": {
        "id": 8770,
        "name": "陈陶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 290980,
      "title": "水调词十首 三",
      "content": [
        "忆饯良人玉塞行，棃花三见换啼莺。",
        "边场岂得胜闺阁，莫逞雕弓过一生。"
      ],
      "author": {
        "id": 8770,
        "name": "陈陶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 290981,
      "title": "水调词十首 四",
      "content": [
        "惆怅江南早鴈飞，年年辛苦寄寒衣。",
        "征人岂不思乡国，只是皇恩未放归。"
      ],
      "author": {
        "id": 8770,
        "name": "陈陶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 290982,
      "title": "水调词十首 五",
      "content": [
        "水阁莲开燕引雏，朝朝攀折望金吾。",
        "闻道碛西春不到，花时还忆故园无。"
      ],
      "author": {
        "id": 8770,
        "name": "陈陶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 290983,
      "title": "水调词十首 六",
      "content": [
        "自从清野戍辽东，舞袖香销罗幌空。",
        "几度长安发梅柳，节旄零落不成功。"
      ],
      "author": {
        "id": 8770,
        "name": "陈陶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 290984,
      "title": "水调词十首 七",
      "content": [
        "长夜孤眠倦锦衾，秦楼霜月苦边心。",
        "征衣一倍装绵厚，犹虑交河雪冻深。"
      ],
      "author": {
        "id": 8770,
        "name": "陈陶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 290985,
      "title": "水调词十首 八",
      "content": [
        "瀚海长征古别离，华山归马是何时。",
        "仍闻万乘尊犹屈，装束千娇嫁郅支。"
      ],
      "author": {
        "id": 8770,
        "name": "陈陶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 290986,
      "title": "水调词十首 九",
      "content": [
        "沙塞依稀落日边，寒宵魂梦怯山川。",
        "离居渐觉笙歌懒，君逐嫖姚已十年。"
      ],
      "author": {
        "id": 8770,
        "name": "陈陶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 290987,
      "title": "水调词十首 十",
      "content": [
        "万里轮台音信稀，传闻移帐护金微。",
        "会须麟阁留踪迹，不斩天骄莫议归。"
      ],
      "author": {
        "id": 8770,
        "name": "陈陶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 290988,
      "title": "送谢山人归江夏",
      "content": [
        "黄鹤春风二千里，山人佳期碧江水。",
        "携琴一醉杨柳堤，日暮龙沙白云起。"
      ],
      "author": {
        "id": 8770,
        "name": "陈陶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 290989,
      "title": "闲居杂兴五首 一",
      "content": [
        "虞韶九奏音犹在，只是巴童自弃遗。",
        "闲卧清秋忆师旷，好风摇动古松枝。"
      ],
      "author": {
        "id": 8770,
        "name": "陈陶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 290990,
      "title": "闲居杂兴五首 二",
      "content": [
        "一顾成周力有余，白云闲钓五溪鱼。",
        "中原莫道无麟凤，自是皇家结网疎。"
      ],
      "author": {
        "id": 8770,
        "name": "陈陶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 290991,
      "title": "闲居杂兴五首 三",
      "content": [
        "长爱真人王子乔，五松山月伴吹箫。",
        "从他浮世悲生死，独驾苍鳞入九霄。"
      ],
      "author": {
        "id": 8770,
        "name": "陈陶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 290992,
      "title": "闲居杂兴五首 四",
      "content": [
        "越里娃童锦作襦，艳歌声压郢中姝。",
        "无人说向张京兆，一曲江南十斛珠。"
      ],
      "author": {
        "id": 8770,
        "name": "陈陶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 290993,
      "title": "闲居杂兴五首 五",
      "content": [
        "云堆西望贼连营，分阃何当举义兵。",
        "莫道羔裘无壮节，古来成事尽书生。"
      ],
      "author": {
        "id": 8770,
        "name": "陈陶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 290994,
      "title": "泉州刺桐花咏兼呈赵使君 一",
      "content": [
        "髣髴三株植世间，风光满地赤城闲。",
        "无因秉烛看奇树，长伴刘公醉玉山。"
      ],
      "author": {
        "id": 8770,
        "name": "陈陶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 290995,
      "title": "泉州刺桐花咏兼呈赵使君 二",
      "content": [
        "海曲春深满郡霞，越人多种刺桐花。",
        "可怜虎竹西楼色，锦帐三千阿母家。"
      ],
      "author": {
        "id": 8770,
        "name": "陈陶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 290996,
      "title": "泉州刺桐花咏兼呈赵使君 三",
      "content": [
        "石氏金园无此艳，南都旧赋乏灵材。",
        "只因赤帝宫中树，丹凤新衔出世来。"
      ],
      "author": {
        "id": 8770,
        "name": "陈陶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 290997,
      "title": "泉州刺桐花咏兼呈赵使君 四",
      "content": [
        "猗猗小艳夹通衢，晴日熏风笑越姝。",
        "只是红芳移不得，刺桐屏幛满中都。"
      ],
      "author": {
        "id": 8770,
        "name": "陈陶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 290998,
      "title": "泉州刺桐花咏兼呈赵使君 五",
      "content": [
        "不胜攀折怅年华，红树南看见海涯。",
        "故国春风归去尽，何人堪寄一枝花。"
      ],
      "author": {
        "id": 8770,
        "name": "陈陶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 290999,
      "title": "泉州刺桐花咏兼呈赵使君 六",
      "content": [
        "赤帝常闻海上游，三千幢盖拥炎州。",
        "今来树似离宫色，红翠斜欹十二楼。"
      ],
      "author": {
        "id": 8770,
        "name": "陈陶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 291000,
      "title": "投赠福建桂常侍二首 一",
      "content": [
        "后来台席更何人，都护朝天拜近臣。",
        "长笑当时汉卿士，等闲恩泽画麒麟。"
      ],
      "author": {
        "id": 8770,
        "name": "陈陶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 291001,
      "title": "投赠福建桂常侍二首 二",
      "content": [
        "匝地歌钟镇海隅，城池鞅掌旧名都。",
        "不知珠履三千外，更许侯嬴寄食无。"
      ],
      "author": {
        "id": 8770,
        "name": "陈陶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 291002,
      "title": "陇西行四首 一",
      "content": [
        "汉主东封报太平，无人金阙议边兵。",
        "纵饶夺得林胡塞，碛地桑麻种不生。"
      ],
      "author": {
        "id": 8770,
        "name": "陈陶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 291003,
      "title": "陇西行四首 二",
      "content": [
        "誓扫匈奴不顾身，五千貂锦丧胡尘。",
        "可怜无定河边骨，犹是春闺梦里人。"
      ],
      "author": {
        "id": 8770,
        "name": "陈陶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 291004,
      "title": "陇西行四首 三",
      "content": [
        "陇戍三看塞草青，楼烦新替护羌兵。",
        "同来死者伤离别，一夜孤魂哭旧营。"
      ],
      "author": {
        "id": 8770,
        "name": "陈陶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 291005,
      "title": "陇西行四首 四",
      "content": [
        "黠虏生擒未有涯，黑山营阵识龙蛇。",
        "自从贵主和亲后，一半胡风似汉家。"
      ],
      "author": {
        "id": 8770,
        "name": "陈陶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 291006,
      "title": "荅莲花妓",
      "content": [
        "近来诗思清于水，老去风情薄似云。",
        "已向升天得门户，锦衾深愧卓文君。"
      ],
      "author": {
        "id": 8770,
        "name": "陈陶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 291007,
      "title": "镜道中吹箫",
      "content": [
        "金栏白的善𥮾𥰭，双凤夜伴江南栖。",
        "十洲人听玉楼晓，空向千山桃杏枝。"
      ],
      "author": {
        "id": 8770,
        "name": "陈陶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 291008,
      "title": "赠野老",
      "content": [
        "何年种芝白云里，人传先生老莱子。",
        "消磨世上名利心，澹若岩间一流水。"
      ],
      "author": {
        "id": 8770,
        "name": "陈陶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 291009,
      "title": "酬元亨上人",
      "content": [
        "一衲净居云梦合，秋来诗思祝融高。",
        "何因知我津涯阔，远寄东溟六巨鼇。"
      ],
      "author": {
        "id": 8770,
        "name": "陈陶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 291010,
      "title": "题徐穉湖亭",
      "content": [
        "伏龙山横洲渚地，人如白苹自生死。",
        "洪崖成道二千年，唯有徐君播青史。"
      ],
      "author": {
        "id": 8770,
        "name": "陈陶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 291011,
      "title": "鄱阳秋夕",
      "content": [
        "忆昔鄱阳旅游日，曾听南家争捣衣。",
        "今夜重开旧砧杵，当时还见鴈南飞。"
      ],
      "author": {
        "id": 8770,
        "name": "陈陶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 291012,
      "title": "飞龙引",
      "content": [
        "长洲茂苑朝夕池，映日含风结细漪。",
        "坐当伏槛红莲披，雕轩洞户青苹吹。",
        "轻幌芳烟郁金馥，绮簷花簟桃李枝。",
        "苕苕翡翠但相逐，桂树鸳鸯恒并宿。"
      ],
      "author": {
        "id": 8770,
        "name": "陈陶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 291013,
      "title": "句",
      "content": [
        "蝉声将月短，草色与秋长。",
        "比屋歌黄竹，何人撼白榆。",
        "好看如镜夜，莫笑似弓时。",
        "江湖水清浅，不足掉鲸尾。",
        "饮水狼子瘦，思日鹧鸪寒。",
        "一鼎雄雌金液火，十年寒暑鹿麑裘。",
        "寄语东流任斑鬓，向隅终守铁梭飞。",
        "乾坤见了文章懒，龙虎成来印绶疎。",
        "近来世上无徐庶，谁向桑麻识卧龙。"
      ],
      "author": {
        "id": 8770,
        "name": "陈陶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 304293,
      "title": "和江西李助副使早登开元寺阁",
      "content": [
        "空（按：《全唐诗》卷七四五此诗，第十五句缺一字。",
        "检胡震亨《唐首戊签》八〖《统签》卷五九七〗，收此诗于雍陶名下，题作《登武昌江山寺》，第十五句不缺，作「书剑忽若空」。",
        "全诗较长，不重录。",
        "胡氏未云因何收归雍陶名下。",
        "《唐音戊签余》二八陈陶名下重收。"
      ],
