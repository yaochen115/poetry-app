      }
    },
    {
      "id": 308245,
      "title": "送綦毋三寺中赋得纱灯",
      "content": [
        "禅室吐香烬，轻纱笼翠烟。",
        "长绳挂青竹，百尺垂红莲。",
        "熠爚众星下，玲珑双塔前。",
        "含光待明发，此别岂徒然。"
      ],
      "author": {
        "id": 2684,
        "name": "李颀"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 308246,
      "title": "送人尉闽中",
      "content": [
        "可叹芳菲日，分为万里情。",
        "阊门折垂柳，御苑听残莺。",
        "海戍通闽邑，江航过楚城。",
        "客心君莫问，春草是王程。"
      ],
      "author": {
        "id": 2684,
        "name": "李颀"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 308247,
      "title": "送人归沔南",
      "content": [
        "梅花今正发，失路复何如。",
        "旧国云山在，新年风景余。",
        "春饶汉阳梦，日寄武陵书。",
        "可即明时老，临川莫羡鱼。"
      ],
      "author": {
        "id": 2684,
        "name": "李颀"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 308248,
      "title": "送卢逸人",
      "content": [
        "洛阳为此别，携手更何时。",
        "不复人间见，祗应海上期。",
        "清谿入云木，白首卧茅茨。",
        "共惜卢敖去，天边望所思。"
      ],
      "author": {
        "id": 2684,
        "name": "李颀"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 308249,
      "title": "送顾朝阳还吴",
      "content": [
        "寂寞俱不偶，裹粮空入秦。",
        "宦途已可识，归卧包山春。",
        "旧国指飞鸟，沧波愁旅人。",
        "开樽洛水上，怨别柳花新。"
      ],
      "author": {
        "id": 2684,
        "name": "李颀"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 308250,
      "title": "送窦参军",
      "content": [
        "城南送归客，举酒对林峦。",
        "暄鸟迎风啭，春衣度雨寒。",
        "桃花开翠幕，柳色拂金鞍。",
        "公子何时至，无令芳草阑。"
      ],
      "author": {
        "id": 2684,
        "name": "李颀"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 308251,
      "title": "望秦川",
      "content": [
        "秦川朝望迥，日出正东峰。",
        "远近山河净，逶迤城阙重。",
        "秋声万户竹，寒色五陵松。",
        "客有归欤叹，凄其霜露浓。"
      ],
      "author": {
        "id": 2684,
        "name": "李颀"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 308252,
      "title": "晚归东园",
      "content": [
        "荆扉带郊郭，稼穑满东葘。",
        "倚杖寒山暮，鸣梭秋叶时。",
        "回云覆阴谷，返景照霜梨。",
        "澹泊真吾事，清风别自兹。"
      ],
      "author": {
        "id": 2684,
