{
  "data": [
    {
      "id": 79322,
      "title": "寄梅圣俞",
      "content": [
        "青山四顾乱无涯，鸡犬萧条数百家。",
        "楚俗岁时多杂鬼，蛮乡言语不通华。",
        "绕城江急舟难泊，当县山高日易斜。",
        "击鼓踏歌成夜市，邀龟卜雨趁烧畬。",
        "丛林白昼飞妖鸟，庭砌非时见异花。",
        "惟有山川为胜绝，寄人堪作画图夸。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 79323,
      "title": "离峡州后回寄元珍表臣",
      "content": [
        "经年迁谪厌荆蛮，惟有江山兴未阑。",
        "醉里人归青草渡，梦中船下武牙滩。",
        "野花零落风前乱，飞雨萧条江上寒。",
        "荻笋时鱼方有味，恨无佳客共杯盘。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 79324,
      "title": "再至西都",
      "content": [
        "伊川不到十年间，鱼鸟今应怪我还。",
        "浪得浮名销壮节，羞将白发见青山。",
        "野花向客开如笑，芳草留人意自闲。",
        "却到谢公题壁处，向风清泪独潺潺。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 79325,
      "title": "过钱文僖公白莲庄",
      "content": [
        "城南车马地，行客过徘徊。",
        "野水寒犹入，余花晚自开。",
        "命宾曾授简，开府最多才。",
        "今日西州路，何人更独来。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 79326,
      "title": "谢公挽词三首  其一",
      "content": [
        "始见行春旆，俄闻引葬箫。",
        "笑言犹在耳，魂魄遂难招。",
        "天象奎星暗，辞林玉树凋。",
        "朔风吹霰雪，铭旐共飘飘。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 79327,
      "title": "谢公挽词三首  其二",
      "content": [
        "前日宾斋宴，今晨奠柩觞。",
        "死生公自达，存没世徒伤。",
        "旧国难归葬，余赀不给丧。",
        "平生公辅志，所得在文章。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 79328,
      "title": "谢公挽词三首  其三",
      "content": [
        "乐事与良辰，平生爱洛滨。",
        "皇台一闭夜，蒿里不知春。",
        "翰墨犹新泽，图书已素尘。",
        "堪怜寝门哭，犹有旧时宾。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 79329,
      "title": "愁牛岭",
      "content": [
        "邦人尽说畏愁牛，不独牛愁我亦愁。",
        "终日下山行百转，却从山脚望山头。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 79330,
      "title": "寄子山待制二绝  其一",
      "content": [
        "留滞西山独可嗟，残春过尽始还家。",
        "落花纵有那堪醉，何况归时无落花。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 79331,
      "title": "寄子山待制二绝  其二",
      "content": [
        "闻君屡醉赏红英，落尽残花酒未醒。",
        "嗟我落花无分看，莫嫌狼藉扫中庭。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 79332,
      "title": "寄秦州田元均",
      "content": [
        "由来边将用儒臣，坐以威名抚汉军。",
        "万马不嘶听号令，诸蕃无事著耕耘。",
        "梦回夜帐闻羌笛，诗就高楼对陇云。",
        "莫忘镇阳遗爱在，北潭桃李正氛氲。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 79333,
      "title": "送沈待制陜西都运",
      "content": [
        "几岁疮痍近息兵，经营方喜得时英。",
        "从来汉粟劳飞挽，当使秦人自战耕。",
        "道左旌旗诸将列，马前弓劒六蕃迎。",
        "知君材力多闲暇，剩听阳关醉后声。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 79334,
      "title": "栾城遇风效韩孟联句体",
      "content": [
        "岁暮氛霾恶，冬余气候争。",
        "吹嘘回暖律，号令发新正。",
        "远响来犹渐，狂奔势益横。",
        "颓城鏖战鼓，掠野过阴兵。",
        "扫荡无余霭，颠摧鲜立茎。",
        "五山摇岌嶪，九鼎沸煎烹。",
        "玉石焚冈裂，波涛卷海倾。",
        "遥听午合市，争呼夜惊营。",
        "惨极云无色，阴穷火自生。",
        "电鞭时砉划，雷轴助喧轰。",
        "孔窍千声出，阴幽百怪呈。",
        "狐妖凭莽苍，鬼焰走青荧。",
        "奋怒神增悚，中休耳暂清。",
        "胡兵占月晕，江客候鼍鸣。",
        "飘叶千艘失，飞空万瓦轻。",
        "猎豪添马健，舶稳想帆征。",
        "畏压频移席，阴祈屡整缨。",
        "冻消初醒蛰，枯活欲抽萌。",
        "病体愁山馆，春寒赖酒铛。",
        "鸡号天地白，登垅看晴明。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 79335,
      "title": "过中渡二首  其一",
      "content": [
        "中渡桥边十里堤，寒蝉落尽柳条衰。",
        "年年塞下春风晚，谁见轻黄弄色时。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 79336,
      "title": "过中渡二首  其二",
      "content": [
        "得归还自叹淹留，中渡桥边柳拂头。",
        "记得来时桥上过，断冰残雪满河流。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 79337,
      "title": "自河北贬滁州初入汴河闻鴈",
      "content": [
        "阳城淀里新来鴈，趁伴南飞逐越船。",
        "野岸柳黄霜正白，五更惊破客愁眠。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 79338,
      "title": "自勉",
      "content": [
        "引水浇花不厌勤，便须已有镇阳春。",
        "官居处处如邮传，谁得三年作主人。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 79339,
      "title": "席上送刘都官",
      "content": [
        "都城车马日喧喧，虽有离歌不惨颜。",
        "岂似客亭临野岸，暂留罇酒对青山。",
        "天街树绿腾归骑，玉殿霜清缀晓班。",
        "莫忘西亭曾醉处，月明风溜响潺潺。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 79340,
      "title": "寄刘都官",
      "content": [
        "别后山光寒更绿，秋深酒美色仍清。",
        "绕亭黄菊同君种，独对残芳醉不成。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 79341,
      "title": "书王元之画像侧",
      "content": [
        "偶然来继前贤迹，信矣皆如昔日言。",
        "诸县丰登少公事，一家饱暖荷君恩。",
        "想公风采常如在，顾我文章不足论。",
        "名姓已光青史上，壁间容貌任尘昏。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 79342,
      "title": "送京西提刑赵学士",
      "content": [
        "题舆尝屈佐留京，揽辔今行按属城。",
        "楚馆尚看淮月色，嵩云应虎过关迎。",
        "春寒酒力风中醒，日暖梅香雪后清。",
        "野俗经年留惠爱，莫辞临别醉冠倾。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 79343,
      "title": "寄题宜城县射亭",
      "content": [
        "作邑三年事事勤，宜城风物自君新。",
        "已能为政留遗爱，何必栽花遗后人。",
        "蔼若芝兰芳可袭，温如金玉粹而纯。",
        "友朋欣慕自如此，何况斯民父母亲。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 79344,
      "title": "丰乐亭游春三首  其一",
      "content": [
        "绿树交加山鸟啼，晴风荡落花飞。",
        "鸟歌花舞太守醉，明日酒醒春已归。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 79345,
      "title": "丰乐亭游春三首  其二",
      "content": [
        "春云淡淡日辉辉，草惹行襟絮拂衣。",
        "行到亭西逢太守，篮舆酩酊插花归。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 79346,
      "title": "丰乐亭游春三首  其三",
      "content": [
        "红树青山日欲斜，长郊草色绿无涯。",
        "游人不管春将老，来往亭前踏落花。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 79347,
      "title": "谢判官幽谷种花",
      "content": [
        "浅深红日宜相间，先后仍须次第栽。",
        "我欲四时携酒去，莫教一日不花开。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 79348,
      "title": "画眉鸟",
      "content": [
        "百啭千声随意移，山花红紫树高低。",
        "始知锁向金笼听，不及林间自在啼。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 79349,
      "title": "怀嵩楼新开南轩与郡僚小饮",
      "content": [
        "绕郭云烟匝几重，昔人曾此感怀嵩。",
        "霜林落后山争出，野菊开时酒正浓。",
        "解带西风飘画角，倚栏斜日照青松。",
        "会须乘醉携嘉客，踏雪来看群玉峰。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 79350,
      "title": "送张生",
      "content": [
        "一别相逢十七百，颓颜衰发互相询。",
        "江湖我再为迁客，道路君犹困旅人。",
        "老骥骨奇心尚壮，青松岁久色逾新。",
        "山城寂寞难为礼，浊酒无辞举爵频。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 79351,
      "title": "田家",
      "content": [
        "绿桑高下映平川，赛罢田神笑语喧。",
        "林外鸣鸠春雨歇，屋头初日杏花繁。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 79352,
      "title": "别滁",
      "content": [
        "花光浓烂柳轻明，酌酒花前送我行。",
        "我亦且如常日醉，莫教弦管作离声。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 79353,
      "title": "答谢判官独游幽谷见寄",
      "content": [
        "闻道西亭偶独登，怅然怀我未忘情。",
        "新花自向游人笑，啼鸟犹为旧日声。",
        "因拂醉题诗句在，应怜手种树阴成。",
        "须知别后无由到，莫厌频携野客行。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 79354,
      "title": "招许主客",
      "content": [
        "欲将何物招嘉客，惟有新秋一味凉。",
        "更扫广庭许宽百亩，少容明月放清光。",
        "楼头破鉴看将满，瓮面浮蛆拨已香。",
        "仍约多为诗准备，共防梅老敌难当。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 79355,
      "title": "金凤花",
      "content": [
        "忆绕朱栏手自栽，绿丛高下几番开。",
        "中庭雨过无人迹，狼籍深红点绿苔。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 79356,
      "title": "鹭鸶",
      "content": [
        "风格孤高尘外物，性情闲暇水边身。",
        "尽日独行溪浅处，青苔白石见纤鳞。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 79357,
      "title": "野鹊",
      "content": [
        "鲜鲜毛羽耀朝辉，红粉墙头绿树枝。",
        "日暖风轻言语软，应将喜报主人知。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 79358,
      "title": "木芙蓉",
      "content": [
        "种处雪消春始动，开时霜落鴈初过。",
        "谁栽金菊丛相近，织出新番蜀锦窠。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 79359,
      "title": "樵者",
      "content": [
        "云际依依认旧林，断崖荒磴路难寻。",
        "西山望见朝来雨，南涧归时渡处深。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 79360,
      "title": "咏雪",
      "content": [
        "至日阳初复，丰年瑞遽臻。",
        "飘飖初未积，散漫忽无垠。",
        "万木青烟灭，千门白昼新。",
        "往来冲更合，高下著何匀。",
        "望好登长榭，平堪走画轮。",
        "马寒毛缩猬，弓劲力添钧。",
        "客醉看成眩，儿娇咀且颦。",
        "虚堂明永夜，高阁照清晨。",
        "树石诗翁对，川原猎骑陈。",
        "冻狐迷旧穴，饥雀噪空囷。",
        "此土偏宜稼，而予滥长人。",
        "应须待和暖，载酒共行春。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 79361,
      "title": "送杨先辈登第还家",
      "content": [
        "解榻方欣待俊英，挂帆千里忽南征。",
        "锦衣白日还家乐，鹤发高堂献寿荣。",
        "残雪楚天寒料峭，春风淮水浪峥嵘。",
        "知君归意先飞鸟，莫惜停舟酒屡倾。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 79362,
      "title": "初至颍州西湖种瑞莲黄杨与郡官小酌其上聊书所见寄淮南转运吕度支发运许主客",
      "content": [
        "平湖十顷碧琉璃，四面清阴乍合时。",
        "柳絮已将春去远，海棠应恨我来迟。",
        "啼禽似与游人语，明月闲撑野艇随。",
        "每到最佳堪乐处，却思君共把芳巵。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 79363,
      "title": "三桥诗 宜远",
      "content": [
        "朱栏明绿水，古柳照斜阳。",
        "何处偏宜望，清涟对女郎。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 79364,
      "title": "三桥诗 飞盖",
      "content": [
        "鸣驺入远树，飞盖渡长桥。",
        "水阔鹭双起，波明鱼自跳。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 79365,
      "title": "三桥诗 望佳",
      "content": [
        "轻舟转孤屿，幽浦漾平波。",
        "回看望佳处，归路逐鱼歌。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 79366,
      "title": "答通判吕太博",
      "content": [
        "千顷芙蕖盖水平，扬州太守旧多情。",
        "画盆围处花光合，红袖传来酒令行。",
        "舞踏落晖留醉客，歌迟檀板换新声。",
        "如今寂寞西湖上，雨后无人看落英。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 79367,
      "title": "祈雨晓过湖上",
      "content": [
        "清晨驱马思悠然，渺渺平湖碧玉田。",
        "晓日未升先起雾，绿阴初合自生烟。",
        "身闲始觉时光好，春去犹余物色妍。",
        "更待四郊甘雨足，相随萧鼓乐丰年。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 79368,
      "title": "送谢中舍二首  其一",
      "content": [
        "滁南幽谷抱山斜，我凿清泉子种花。",
        "故事已传遗老说，世人今作画图夸。",
        "金闺引籍子方壮，白发盈簪我可嗟。",
        "试问弦歌为县政，何知罇俎乐无涯。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 79369,
      "title": "送谢中舍二首  其二",
      "content": [
        "喜闻嘉誉蔼淮壖，又看吴帆解画船。",
        "陇亩遗民谈旧政，江山余思入新篇。",
        "人生白首吾今尔，仕路青云子勉旃。",
        "举棹南风吹酒醒，禽觞莫惜少留连。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 79370,
      "title": "酬张器判官泛溪",
      "content": [
        "园林初夏有清香，人意乘闲味愈长。",
        "日暖鱼跳波面静，风轻鸟语树阴凉。",
        "野亭飞盖临芳草，曲渚回舟带夕阳。",
        "所得平时为郡乐，况多嘉客共衔觞。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 79371,
      "title": "西园石榴盛开",
      "content": [
        "荒台野径共跻攀，正见榴花出短垣。",
        "绿叶晚鸎啼处密，红房初日照时繁。",
        "最怜夏景铺珍簟，尤爱晴香入睡轩。",
        "乘兴便当携酒去，不须旌骑拥车辕。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 79372,
      "title": "西湖戏作示同游者",
      "content": [
        "菡萏香清画舸浮，使君宁复忆扬州。",
        "都将二十四桥月，换得西湖十顷秋。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 79373,
      "title": "梦中作",
      "content": [
        "夜凉吹笛千山月，路暗迷人百种花。",
        "棋罢不知人换世，酒阑无奈客思家。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 79374,
      "title": "秀才欧世英惠然见访其还也聊以赠之",
      "content": [
        "相逢十年旧，暂喜一罇同。",
        "昔日青衫令，今为白发翁。",
        "俟时君子守，求士有司公。",
        "况子之才美，焉能久困穷。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 79375,
      "title": "送杨君之任永康",
      "content": [
        "剑峰云栈未尝行，图画曾看已可惊。",
        "险若登天悬鸟道，下临无地泻江声。",
        "折腰莫以微官耻，为政须通异俗情。",
        "况子多才兼美行，荐章期即达承明。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 79376,
      "title": "纪德陈情上致政太傅杜相公二首  其一",
      "content": [
        "俭节清名世绝伦，坐令风俗可还淳。",
        "貌先年老因忧国，事与心违始乞身。",
        "四海仪刑瞻旧德，一罇谈笑作闲人。",
        "铃斋幸得亲师席，东向时容问治民。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 79377,
      "title": "纪德陈情上致政太傅杜相公二首  其二",
      "content": [
        "事国一心勤以瘁，还家五福寿而康。",
        "风波已出凭忠信，松栢难凋雪霜。",
        "昔日青衫遇知己，今来白首再升堂。",
        "里门每入从千骑，宾主俱荣道路光。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 79378,
      "title": "太傅杜相公索聚星堂诗谨成",
      "content": [
        "楚肆固知难衒玉，丘门安敢辄论诗。",
        "藏之十袭真无用，报以双金岂所宜。",
        "已恨语言多猥冗，况因杯杓正淋漓。",
        "愿投几格资咍噱，俗展须于欲睡时。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 79379,
      "title": "和太傅杜相公宠示之作",
      "content": [
        "平生孤拙荷公知，敢向公前自衒时。",
        "忧患飘流诚已甚，文辞衰落固其宜。",
        "非高仅比巴音下，少味还同鲁酒漓。",
        "两辱嘉篇永为宝，岂惟荣耀诧当时。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 79380,
      "title": "太傅杜相公有答兖州待制之句其卒章云独无风雅可流传因辄成",
      "content": [
        "南都已见成新集，东鲁休嗟未作诗。",
        "霖雨曾为天下福，甘棠何止郡人思。",
        "元刘事业时无取，姚宋篇章世不知。",
        "二美惟公所兼有，后生何者欲攀追。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 79381,
      "title": "依韵答杜相公宠示之作",
      "content": [
        "醉翁丰乐一闲身，憔悴今来汴水滨。",
        "每听鸟声知改节，因吹柳絮惜残春。",
        "平生未省降诗敌，到处何尝诉酒巡。",
        "壮志销磨都已尽，看花翻作饮茶人。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 79382,
      "title": "依韵和杜相公喜雨之什",
      "content": [
        "岁时丰俭若循环，天幸非由拙政然。",
        "一雨虽知为美泽，三登犹未补凶年。",
        "桑阴蔽日交垂路，麦穗含风秀满田。",
        "千里郊原想如画，正宜携酒望晴川。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 79383,
      "title": "谢太傅杜相公宠示嘉篇",
      "content": [
        "凛凛节奇霜涧栢，昭昭心莹玉壶冰。",
        "正身尚可清风俗，当暑何须厌鬰蒸。",
        "麈柄屡挥容请益，龙门虽峻忝先登。",
        "立朝行己师资久，宁止篇章此服膺。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 79384,
      "title": "答杜相公宠示去思堂诗",
      "content": [
        "当年丞相倦洪钧，弭节初来颍水𣸣。",
        "惟以琴罇乐嘉客，能将富贵比浮云。",
        "西溪水色春长绿，北渚花光暖自薰。",
        "得载公诗播人口，去思从此四夷闻。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 79385,
      "title": "答太傅相公见赠长韵",
      "content": [
        "踪迹本羁单，登门二十年。",
        "平生任愚拙，自进耻因缘。",
        "忧患经多矣，疲驽尚勉旃。",
        "凋零鸎谷友，憔悴鴈池边。",
        "忽忽良时失，区区俗虑阗。",
        "公斋每偷暇，师席屡攻坚。",
        "善诲常无倦，余谈亦可编。",
        "仰高虽莫及，希骥岂非贤。",
        "报国如乖顾，归耕宁买田。",
        "期无辱知己，肯逐利名迁。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 79386,
      "title": "借观五老诗次韵为谢",
      "content": [
        "脱遗轩冕就安闲，笑傲丘园纵倒冠。",
        "白发忧民虽种种，丹心许国尚桓桓。",
        "鸿冥得路高难慕，松老无风韵自寒。",
        "闻说优游多唱和，新篇何惜尽传看。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 79387,
      "title": "答杜相公惠诗",
      "content": [
        "药苗本是山家味，茶具偏于野客宜。",
        "敢以微诚将薄物，少资清兴入新诗。",
        "言无俗韵精而劲，笔有神锋老更奇。",
        "二宝收藏传百世，岂惟荣耀诧当时。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 79388,
      "title": "去思堂手植双柳今已成阴因而有感",
      "content": [
        "曲栏高柳拂层簷，却忆初栽映碧潭。",
        "人昔共游今孰在，树犹如此我何堪。",
        "壮心无复身从老，世事都销酒半酣。",
        "后日更来知有几，攀条莫惜驻征骖。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 79389,
      "title": "和陆子履再游城西李园",
      "content": [
        "京师花木类多奇，常恨春归人不归。",
        "车马喧喧走尘土，园林处处锁芳菲。",
        "残红已落香犹在，羁客多伤涕自挥。",
        "我亦悠然无事者，约君联骑访郊圻。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 79390,
      "title": "内直对月寄子华舍人持国廷评",
      "content": [
        "禁署沉沉玉漏传，月华云表溢金盘。",
        "纤埃不隔光初满，万物无声夜向阑。",
        "莲烛烧残愁梦断，蕙炉薰歇觉衣单。",
        "水精宫锁黄金阙，故比人间分外寒。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 79391,
      "title": "答子华舍人退朝小饮官舍",
      "content": [
        "玉阶朝罢卷晨班，官舍相留一笑间。",
        "与世渐疏嗟已老，得朋为乐偶偷闲。",
        "红牋搦管吟红药，绿酒盈罇舞绿鬟。",
        "自是风情年少事，多慙白发与苍颜。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 79392,
      "title": "内直晨出便赴奉慈斋宫马上口占",
      "content": [
        "凌晨更直九门开，驱马悠悠望禁街。",
        "霜后楼台明晓日，天寒烟雾著宫櫰。",
        "山林未去犹贪宠，罇酒何时共放怀。",
        "已觉萧条悲晚岁，更怜衰病怯清斋。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 79393,
      "title": "景灵朝谒从驾还宫",
      "content": [
        "琳馆清晨蔼瑞氛，玉旒朝罢奏诏钧。",
        "绿槐夹路飞黄盖，翠辇鸣鞘向紫宸。",
        "金阙日高犹泫露，彩旗风细不惊尘。",
        "自慙白首追时彦，行近储胥忝侍臣。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 79394,
      "title": "忆滁州幽谷",
      "content": [
        "滁南幽谷抱千峰，高下山花远近红。",
        "当日辛勤皆手植，而今开落任春风。",
        "主人不觉悲华发，野老犹能说醉翁。",
        "谁与援琴亲写取，夜泉声在翠微中。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 79395,
      "title": "和韩学士襄州闻喜亭置酒",
      "content": [
        "巀嶭高城汉水边，登临谁与共跻攀。",
        "清川万古流不尽，白鸟双飞意自闲。",
        "可笑沉碑忧岸谷，谁能把酒对江山。",
        "少年我亦曾游目，风物今思一梦还。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 79396,
      "title": "寄题梅龙图滑州溪园",
      "content": [
        "闻说溪园景渐佳，遥知清兴已无涯。",
        "饮阑归骑多乘月，雪后寻春自探花。",
        "百啭黄鹂消永日，双飞白鸟避鸣笳。",
        "平生喜接君酬唱，不得罇前咏落霞。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 79397,
      "title": "奉使道中五言长韵",
      "content": [
        "初旭瑞霞烘，都门祖帐供。",
        "亲持使者节，晓出大明宫。",
        "城阙青烟起，楼台白雾中。",
        "绣鞯骄跃跃，貂袖紫蒙蒙。",
        "朔野惊飙惨，边城画角雄。",
        "过桥分一水，回首羡南鸿。",
        "地里山川隔，天文日月同。",
        "儿童能走马，妇女亦腰弓。",
        "度险行愁失，盘高路欲穷。",
        "山深闻唤鹿，林黑自生风。",
        "松壑寒逾响，冰溪咽复通。",
        "望平愁驿迥，野旷觉天穹。",
        "骏足来山北，轻禽出海东。",
        "合围飞走尽，移帐水泉空。",
        "讲信邻方睦，尊贤礼亦隆。",
        "斫冰烧酒赤，冻脍缕霜红。",
        "白草经春在，黄沙尽日蒙。",
        "新年风渐变，归路雪初融。",
        "祗事须彊力，嗟予乃病翁。",
        "深慙汉苏武，归国不论功。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 79398,
      "title": "奉使契丹初至雄州",
      "content": [
        "古关衰柳聚寒鵶，驻马城头日欲斜。",
        "犹去西楼二千里，行人到此莫思家。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 79399,
      "title": "奉使契丹回出上京马上作",
      "content": [
        "紫貂裘暖朔风惊，潢水冰光射日明。",
        "笑语同来向公子，马头今日向南行。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 79400,
      "title": "送渭州王图",
      "content": [
        "汉军十万控山河，玉帐优游暇日多。",
        "夷狄从来怀信义，庙堂今不用干戈。",
        "吟余画角吹残月，醉里红灯炫绮罗。",
        "此乐直须年少壮，嗟余心志已蹉跎。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 79401,
      "title": "李留后家闻筝坐上作",
      "content": [
        "不听哀筝二十年，忽逢纤指弄鸣弦。",
        "緜蛮巧啭花间舌，呜咽交流冰下泉。",
        "常谓此声今已绝，问渠从小自谁传。",
        "樽前笑我闻弹罢，白发萧然涕泫然。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 79402,
      "title": "送郓州李留后",
      "content": [
        "北州遗颂蔼嘉声，东土还闻政有成。",
        "组甲光寒围夜帐，彩旗风暖看春耕。",
        "金钗坠鬓分行立，玉麈高谈四坐倾。",
        "富贵常情谁不羡，爱君风韵有余清。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 79403,
      "title": "子华学士儤直未满遽出馆伴病夫遂当轮宿辄成拙句奉呈",
      "content": [
        "万钉宝带烂腰镮，赐宴新陪一笑欢。",
        "金马并游年最少，玉堂初直夜犹寒。",
        "自嗟零落凋颜鬓，晚得飞翔接羽翰。",
        "今日遽闻催递宿，不容多病养衰残。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 79404,
      "title": "礼部贡院阅进士就试",
      "content": [
        "紫案焚香暖吹轻，广庭清晓席群英。",
        "无哗战士衔枚勇，下笔春蚕食叶声。",
        "乡里献贤先德行，朝廷列爵待公卿。",
        "自慙衰病心神耗，赖有群公鉴裁精。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 79405,
      "title": "和梅圣俞元夕登东楼",
      "content": [
        "游豫恩同万国懽，新年佳节候初还。",
        "华灯烁烁春风里，黄伞亭亭瑞雾间。",
        "可爱清光澄夜色，遥知喜气动天颜。",
        "自怜曾预称觞列，独宿冰厅梦帝关。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 79406,
      "title": "再和",
      "content": [
        "禁城东马夜喧喧，闲绕危栏去复还。",
        "遥望觚棱烟霭外，似闻天乐梦魂间。",
        "岂无罇酒当佳节，况有朋欢慰病颜。",
        "待得归时花在否，春禽簷际已关关。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 79407,
      "title": "又和",
      "content": [
        "凭高寓目偶乘闲，袨服游人见往还。",
        "明月正临双阙上，行歌遥听九衢间。",
        "黄金络马追朱幰，红烛笼纱照玉颜。",
        "与世渐疏嗟老矣，佳辰乐事岂相关。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 79408,
      "title": "忆鹤呈公仪",
      "content": [
        "一笑相驩乐得朋，诵君双鹤句尤清。",
        "高怀自喜凌云格，俗耳谁思警露声。",
        "所好与时虽异趣，累心于物岂非情。",
        "归休约我携琴去，共看婆娑舞月明。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 79409,
      "title": "答王禹玉见赠",
      "content": [
        "昔时叨入武成宫，曾看挥毫气吐虹。",
        "梦寐闲思十年旧，笑谈今此一罇同。",
        "喜君新赐黄金带，顾我宜为白发翁。",
        "自古荐贤为报国，幸依精识士称公。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 79410,
      "title": "答王内翰范舍人",
      "content": [
        "相从一笑欢无厌，屡获新篇喜可涯。",
        "自昔居前诮穅秕，幸容相倚媿蒹葭。",
        "白麻诏令追三代，青史文章自一家。",
        "我亦谏垣新忝命，君恩未报发先华。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 79411,
      "title": "戏答圣俞持烛之句",
      "content": [
        "辱君赠我言虽厚，听我酬君意不同。",
        "病眼自憎红蜡烛，何人肯伴白须翁。",
        "花时浪过如春梦，酒敌先甘伏下风。",
        "惟有吟哦殊不倦，始知文字乐无穷。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 79412,
      "title": "小桃",
      "content": [
        "雪里花开人未知，摘来相顾共惊疑。",
        "便当索酒花前醉，初见今年第一枝。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 79413,
      "title": "戏书",
      "content": [
        "支离多病叹衰颜，赖得群居一笑欢。",
        "人老思家甚年少，身闲泥酒过春寒。",
        "来时御柳天街冻，归去梨花禁籞残。",
        "纤使开门佳节晚，未妨双鹤舞霜翰。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 79414,
      "title": "春雪",
      "content": [
        "逗晓风声恶，褰帘雪势斜。",
        "应怜未归客，故勒欲开花。",
        "病思寒添睡，春愁梦在家。",
        "谁能慰寂寞，惟有酒如霞。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 79415,
      "title": "和梅公仪尝茶",
      "content": [
        "溪山击鼓助雷惊，逗晓灵芽发翠茎。",
        "摘处两旗香可爱，贡来双凤品尤精。",
        "寒侵病骨惟思睡，花落春愁未解酲。",
        "喜共紫瓯吟且酌，羡君萧洒有余清。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 79416,
      "title": "和较艺书事",
      "content": [
        "相随怀诏下天阍，一锁南宫隔几旬。",
        "玉麈清谈消永日，金罇美酒惜余春。",
        "杯盘饧粥春风冷，池馆榆钱夜雨新。",
        "犹是人间好时节，归休过我莫辞频。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 79417,
      "title": "和公仪赠白鹇",
      "content": [
        "梅公怜我髭如雪，赠以双禽意有云。",
        "但见寻常思白兔，便疑不解醉红裙。",
        "吟斋虽喜留闲客，野性宁忘在岭云。",
        "我有铜台方尺瓦，慙非玉案欲酬君。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 79418,
      "title": "再和",
      "content": [
        "佳翫能令百事忘，岂惟闲伴倒余缸。",
        "珍奇来自海千里，皎洁明如璧一双。",
        "日暖朝笼青石砌，春寒夜宿碧纱窗。",
        "蛮烟瘴雾虽生处，何必区区忆陋邦。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 79419,
      "title": "和圣俞春雨",
      "content": [
        "簷瓦萧萧雨势疏，寂寥官舍与君俱。",
        "身遭锁闭如鹦鹉，病识阴晴似鹁鸪。",
        "年少自愁花烂熳，春寒偏著老肌肤。",
        "莫嫌来往传诗句，不尔须当泥酒壶。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 79420,
      "title": "出省有日书事",
      "content": [
        "凌晨小雨压尘轻，闲忆登高望禁城。",
        "树色连云春泱漭，风光著草日晴明。",
        "看榆吐荚惊将落，见鹊移巢忽已成。",
        "谁向儿童报归日，为翁寒食少留饧。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 79421,
      "title": "和较艺将毕",
      "content": [
        "槐柳来时绿未匀，开门节物一番新。",
        "踏青寒食追游骑，赐火清明忝侍臣。",
        "拂面蜘蛛占喜事，入帘蝴蝶报家人。",
        "莫瞋年少思归切，白发衰翁尚惜春。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 6,
