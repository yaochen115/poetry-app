{
  "data": [
    {
      "id": 255141,
      "title": "横吹曲辞 陇头吟",
      "content": [
        "长安少年游侠客，夜上戍楼看太白。",
        "陇头明月迥临关，陇上行人夜吹笛。",
        "关西老将不胜愁，驻马听之双泪流。",
        "身经大小百余战，麾下偏裨万户侯。",
        "苏武才为典属国，节旄空尽海西头。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 255158,
      "title": "横吹曲辞 出塞",
      "content": [
        "居延城外猎天骄，白草连天野火烧。",
        "暮云空碛时驱马，秋日平原好射雕。",
        "护羌校尉朝乘障，破虏将军夜渡辽。",
        "玉靶角弓珠勒马，汉家将赐霍嫖姚。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 255404,
      "title": "相和歌辞 从军行",
      "content": [
        "吹角动行人，喧喧行人起。",
        "笳鸣马嘶乱，争渡金河水。",
        "日暮沙漠垂，战声烟尘里。",
        "尽系名王颈，归来报天子。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 255465,
      "title": "相和歌辞 陇西行",
      "content": [
        "十里一走马，五里一扬鞭。",
        "都护军书至，匈奴围酒泉。",
        "关山正飞雪，烽戍断无烟。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 255554,
      "title": "相和歌辞 班倢伃三首 一",
      "content": [
        "玉窗萤影度，金殿人声绝。",
        "秋夜守罗帏，孤灯耿不灭。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 255555,
      "title": "相和歌辞 班倢伃三首 二",
      "content": [
        "宫殿生秋草，君王恩幸疎。",
        "那堪闻凤吹，门外度金舆。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 255556,
      "title": "相和歌辞 班倢伃三首 三",
      "content": [
        "怪来妆阁闭，朝下不相迎。",
        "总向春园里，花间语笑声。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 255626,
      "title": "相和歌辞 祠渔山神女歌 迎神",
      "content": [
        "坎坎击鼓，渔山之下。",
        "吹洞箫，望极浦。",
        "女巫进，纷屡舞。",
        "陈瑶席，湛清酤。",
        "风凄凄，又夜雨。",
        "不知神之来兮不来，使我心兮苦复苦。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 255627,
      "title": "相和歌辞 祠渔山神女歌 送神",
      "content": [
        "纷进舞兮堂前，目眷眷兮琼筵。",
        "来不言兮意不传，作暮雨兮愁空山。",
        "悲急管兮思繁弦，神之驾兮俨欲旋。",
        "倏云收兮雨歇，山青青兮水潺湲。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 255877,
      "title": "杂曲歌辞 苦热行",
      "content": [
        "赤日满天地，火云成山岳。",
        "草木尽焦卷，川泽皆竭涸。",
        "轻纨觉衣重，密树苦阴薄。",
        "莞簟不可近，𫄨绤再三濯。",
        "思出宇宙外，旷然在寥廓。",
        "长风万里来，江海荡烦浊。",
        "却顾身为患，始知心未觉。",
        "忽入甘露门，宛然清凉乐。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 255901,
      "title": "杂曲歌辞 少年行四首 一",
      "content": [
        "新丰美酒斗十千，咸阳游侠多少年。",
        "相逢意气为君饮，系马高楼垂柳边。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 255902,
      "title": "杂曲歌辞 少年行四首 二",
      "content": [
        "汉家君臣欢宴终，高议云台论战功。",
        "天子临轩赐侯印，将军佩出明光宫。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 255903,
      "title": "杂曲歌辞 少年行四首 三",
      "content": [
        "出身仕汉羽林郎，初随骠骑战渔阳。",
        "孰知不向边庭苦，纵死犹闻侠骨香。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 255904,
      "title": "杂曲歌辞 少年行四首 四",
      "content": [
        "一身能臂两雕弧，虏骑千群只似无。",
        "偏坐金鞍调白羽，纷纷射杀五单于。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 266319,
      "title": "杂曲歌辞 渭城曲",
      "content": [
        "谓城朝雨浥轻尘，客舍青青柳色春。",
        "劝君更尽一杯酒，西出阳关无故人。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 299171,
      "title": "句",
      "content": [
        "自恨开迟还落早，纵横只是怨春风。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 300058,
      "title": "酬诸公见过",
      "content": [
        "嗟予未丧，哀此孤生。",
        "屏居蓝田，薄地躬耕。",
        "岁[晏]输税，以奉粢盛。",
        "晨往东臯，草露未晞。",
        "暮看烟火，负担来归。",
        "我闻有客，足埽荆扉。",
        "箪食伊何，疈瓜抓枣。",
        "仰厕群贤，皤然一老。",
        "媿无莞簟，班荆席藁。",
        "泛泛登陂，折彼荷花。",
        "静观素鲔，俯映白沙。",
        "山鸟群飞，日隐轻霞。",
        "登车上马，倏忽云散。",
        "雀噪荒村，鸡鸣空馆。",
        "还复幽独，重欷累叹。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 300059,
      "title": "奉和圣制登降圣观与宰臣等同望应制",
      "content": [
        "凤扆朝碧落，龙图耀金镜。",
        "维岳降二臣，戴天临万姓。",
        "山川八校满，井邑三农竟。",
        "比屋皆可封，谁家不相庆。",
        "林疎远村出，野旷寒山静。",
        "帝城云里深，渭水天边映。",
        "佳气含风景，颂声溢歌咏。",
        "端拱能任贤，弥彰圣君圣。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 300060,
      "title": "奉和圣制御春明楼临右相园亭赋乐贤诗应制",
      "content": [
        "复道通长乐，青门临上路。",
        "遥闻凤吹喧，暗识龙舆度。",
        "褰旒明四目，伏槛纡三顾。",
        "小苑接侯家，飞甍暎宫树。",
        "商山原上碧，浐水林端素。",
        "银汉下天章，琼筵承湛露。",
        "将非富人宠，信以平戎故。",
        "从来简帝心，讵得回天步。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 300061,
      "title": "奉和圣制送不蒙都护兼鸿胪卿归安西应制",
      "content": [
        "上卿增命服，都护扬归斾。",
        "杂虏尽朝周，诸胡皆自郐。",
        "鸣笳瀚海曲，按节阳关外。",
        "落日下河源，寒山静秋塞。",
        "万方氛祲息，六合乾坤大。",
        "无战是天心，天心同覆载。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 300062,
      "title": "扶南曲歌词五首 一",
      "content": [
        "翠羽流苏帐，春眠曙不开。",
        "羞从面色起，娇逐语声来。",
        "早向昭阳殿，君王中使催。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 300063,
      "title": "扶南曲歌词五首 二",
      "content": [
        "堂上青弦动，堂前绮席陈。",
        "齐歌卢女曲，双舞洛阳人。",
        "倾国徒相看，宁知心所亲。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 300064,
      "title": "扶南曲歌词五首 三",
      "content": [
        "香气传空满，妆华影箔通。",
        "歌闻天仗外，舞出御楼中。",
        "日暮归何处，花间长乐宫。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 300065,
      "title": "扶南曲歌词五首 四",
      "content": [
        "宫女还金屋，将眠复畏明。",
        "入春轻衣好，半夜薄妆成。",
        "拂曙朝前殿，玉墀多珮声。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 300066,
      "title": "扶南曲歌词五首 五",
      "content": [
        "朝日照绮窗，佳人坐临镜。",
        "散黛恨犹轻，插钗嫌未正。",
        "同心勿遽游，幸待春妆竟。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
