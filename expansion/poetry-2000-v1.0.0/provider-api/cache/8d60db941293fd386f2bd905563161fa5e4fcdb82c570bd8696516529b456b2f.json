{
  "data": [
    {
      "id": 206805,
      "title": "叔父钓亭",
      "content": [
        "槛外溪风拂面凉，四围春草自锄荒。",
        "陆沈霜发为钩直，柳贯锦鳞缘饵香。",
        "影落华亭千尺月，梦通岐下六州王。",
        "麒麟卧笑功名骨，不道山林日月长。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 206806,
      "title": "岩下放言五首 钓台",
      "content": [
        "林居野处，而贯万事。",
        "花落鸟啼，而成四时。",
        "物有才德，水为官师。",
        "空明湛群木之影，搏击下诸峰之巇。",
        "游鱼静而知机，君子乐而忘归。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206807,
      "title": "岩下放言五首 池亭",
      "content": [
        "水嬉者游鱼，林乐者啼鸟。",
        "志士仁人观其大，薪翁笱妇利其小。",
        "有美一人，独燕居万物之表。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206808,
      "title": "岩下放言五首 冠鼇台",
      "content": [
        "石生涯于寒藤，藤耈造于崖树。",
        "鼇插翼而成鹏，隘六合而未翥。",
        "我来兮自东，攀桂枝兮容与。",
        "倚嵌岩兮顾同来，谓公等其皆去。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206809,
      "title": "岩下放言五首 博山台",
      "content": [
        "石蕴玙璠，山得其来之泽。",
        "木无牺象，天开不材之祥。",
        "屹金炉之突兀，其山海之来翔。",
        "然以明哲之火，熏以忠信之香。",
        "俯仰一时，非智所及。",
        "付与万世，其存者长。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206810,
      "title": "岩下放言五首 灵椿台",
      "content": [
        "苍苔古木，相依涧壑之滨。",
        "黄葛女萝，自致风云之上。",
        "人就阴而息迹，鸟投暮而来归。",
        "水影林光，常相助发。",
        "溪声斧响，直下称提。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206811,
      "title": "寄傅君倚同年",
      "content": [
        "有情清江水，东下投豫章。",
        "故人江上居，不寄书一行。",
        "相思对明月，谈笑如清光。",
        "向风长叹息，孤雁起寒塘。",
        "倾写鬰结怀，因之东南翔。",
        "姑氏有淑质，幽林兰静芳。",
        "愿因奉箕帚，苹藻羞烝尝。",
        "念君方策名，要津迈腾骧。",
        "引车入里门，观者塞路旁。",
        "雝雝求匹好，羔雁委潘杨。",
        "顾惟蓬茅陋，岂能屈东床。",
        "眷言南鸣雁，七子伊在桑。",
        "幸缘一日雅，结好永不忘。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206812,
      "title": "答德甫弟",
      "content": [
        "鸟啼花发独愁思，怜子三章怨慕诗。",
        "鸿雁双飞弹射下，脊令同病急难时。",
        "功名所在犹争死，意气相须尚不移。",
        "何况极天无以报，林回投璧负婴儿。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 206813,
      "title": "赠元发弟放言",
      "content": [
        "亏功一篑，未成丘山。",
        "凿井九阶，不次水泽。",
        "行百里者半九十，小狐汔济濡其尾。",
        "故曰时乎，时不再来。",
        "终终始始，是谓君子。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206814,
      "title": "清明",
      "content": [
        "佳节清明桃李笑，野田荒垅只生愁。",
        "雷惊天地龙蛇蛰，雨足郊原草木柔。",
        "人乞祭余骄妾妇，士甘焚死不公侯。",
        "贤愚千载知谁是，满眼蓬蒿共一丘。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 206815,
      "title": "何造诚作浩然堂陈义甚高然颇喜度世飞升之说筑屋饭方士愿乘六气游天地间故作浩然词二章赠之  其一",
      "content": [
        "公欲轻身上紫霞，琼爢玉馔厌豪奢。",
        "百年世路同朝菌，九钥天关守夜叉。",
        "霜桧左纽空白鹿，金炉同契漫丹砂。",
        "要令心地闲如水，万物浮沈共我家。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 206816,
      "title": "何造诚作浩然堂陈义甚高然颇喜度世飞升之说筑屋饭方士愿乘六气游天地间故作浩然词二章赠之  其二",
      "content": [
        "万物浮沈共我家，清明心水徧河沙。",
        "无钩狂象听人语，露地白牛看月斜。",
        "小雨呼儿蓺桃李，疏帘帏客转琵琶。",
        "尘尘三昧开门户，不用丹田养素霞。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 206817,
      "title": "徐孺子祠堂",
      "content": [
        "乔木幽人三亩宅，生刍一束向谁论。",
        "藤萝得意干云日，箫鼓何心进酒樽。",
        "白屋可能无孺子，黄堂不是欠陈蕃。",
        "古人冷淡今人笑，湖水年年到旧痕。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 206818,
      "title": "思亲汝州作",
      "content": [
        "岁晚寒侵游子衣，拘留幕府报官移。",
        "五更归梦三百里，一日思亲十二时。",
        "车上吐茵元不逐，市中有虎竟成疑。",
        "秋毫得失关何事，总为平安书到迟。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 206819,
      "title": "次韵戏答彦和",
      "content": [
        "本不因循老镜春，江湖归去作闲人。",
        "天于万物定贫我，智效一官全为亲。",
        "布袋形骸增碨磊，锦囊诗句媿清新。",
        "杜门绝俗无行迹，相忆犹当遣化身。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 206820,
      "title": "次韵裴仲谋同年",
      "content": [
        "交盖春风汝水边，客床相对卧僧毡。",
        "舞阳去叶才百里，贱子与公皆少年。",
        "白发齐生如有种，青山好去坐无钱。",
        "烟沙篁竹江南岸，输与鸬鹚取次眠。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 206821,
      "title": "流民叹",
      "content": [
        "朔方频年无好雨，五种不入虚春秋。",
        "迩来后土中夜震，有似巨鼇复戴三山游。",
        "倾墙摧栋压老弱，冤声未定随洪流。",
        "地文划劙水觱沸，十户八九生鱼头。",
        "稍闻澶渊渡河日数万，河北不知虚几州。",
        "累累襁负襄叶间，问舍无所耕无牛。",
        "初来犹自得旷土，嗟尔后至将何怙。",
        "刺史守令真分忧，明诏哀痛如父母。",
        "庙堂已用伊吕徒，何时眼前见安堵。",
        "疏远之谋未易陈，市上三言或成虎。",
        "祸灾流行固无时，尧汤水旱人不知。",
        "桓侯之疾初无证，扁鹊入秦始治病。",
        "投胶盈掬俟河清，一箪岂能续民命。",
        "虽然犹愿及此春，略讲周公十二政。",
        "风生群口方出奇，老生常谈幸听之。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206822,
      "title": "次韵寄滑州舅氏",
      "content": [
        "舫斋闻有小溪山，便是壶公谪处天。",
        "想听琐窗深夜雨，似看叶水上江船。",
        "瞻相白马津亭路，寂寞双凫古县前。",
        "舅氏知甥最疏嬾，折腰尘土解哀怜。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 206823,
      "title": "张仲谋家堂前酴醾委地",
      "content": [
        "沈水衣笼白玉苗，不蒙湔拂苦无聊。",
        "烦君斫取西庄柳，扶起春风十万条。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206824,
      "title": "和答登封王晦之登楼见寄",
      "content": [
        "县楼三十六峰寒，王粲登临独倚阑。",
        "清坐一番春雨歇，相思千里夕阳残。",
        "诗来嗟我不同醉，别后喜君能自宽。",
        "举目尽妨人作乐，几时归得钓鲵桓。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 206825,
      "title": "和答孙不愚见赠",
      "content": [
        "诗比淮南似小山，酒名曲米出云安。",
        "且凭诗酒勤春事，莫爱儿郎作好官。",
        "簿领侵寻台相笔，风埃蓬勃使星鞍。",
        "小臣才力堪为掾，敢学前人便挂冠。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 206826,
      "title": "睡起",
      "content": [
        "仿佛江南一梦中，虚堂尽日转温风。",
        "春深稍觉裌衣重，昼永不知樽酒空。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206827,
      "title": "还家呈伯氏",
      "content": [
        "去日樱桃初破花，归来著子如红豆。",
        "四时驱迫少须臾，两鬓飘零成老丑。",
        "永怀往在江南日，原上急难风雨后。",
        "私田苦薄王税多，诸弟号寒诸妹瘦。",
        "扶将白发渡江来，吾二人如左右手。",
        "苟从禄仕我邅回，且慰家贫兄孝友。",
        "强趋手板汝阳城，更责愆期被诃诟。",
        "法官毒螫草自摇，丞相霜威人避走。",
        "贱贫孤远盖如此，此事端于我何有。",
        "一囊粟麦七十钱，五人兄弟二十口。",
        "官如元亮且折腰，心似次山羞曲肘。",
        "北窗书册久不开，筐箧黄尘生锁钮。",
        "何当略得共讨论，况乃雍容把杯酒。",
        "意气敷腴贵壮年，不早计之且衰朽。",
        "安得短船万里随江风，养鱼去作陶朱公。",
        "斑衣奉亲伯与侬，四方上下相依从。",
        "用舍由人不由己，乃是伏辕驹犊耳。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206828,
      "title": "次韵时进叔二十六韵",
      "content": [
        "时子河上园，竹间开栋宇。",
        "大儿胜衣冠，小儿丰颊辅。",
        "嫁女与朱公，伏腊可称举。",
        "发疏虽苍浪，齿嚼未龃龉。",
        "鸡栖牛羊下，各自有室处。",
        "四墙规摹小，易守若滕莒。",
        "舍前花木深，春物丽观睹。",
        "舍后曲池蛙，斋堂风月苦。",
        "此岂不足欤，叹岁不我与。",
        "客宦孤云耳，未知秦吴楚。",
        "向来千驷公，果媿一丘土。",
        "宁当损轩昂，聊欲效俯伛。",
        "时子听然笑，吾已悟仓鼠。",
        "少犹守章句，晚实爱农圃。",
        "鹊巢最知风，蚁穴识阴雨。",
        "世网事谙委，醉乡俗淳古。",
        "坐忘两家说，肉坚与肠腐。",
        "酒至即使倾，客来敢辞窭。",
        "时邀五柳陶，共过三径诩。",
        "往在少年场，豪气压颍汝。",
        "借令今尚尔，真复难共语。",
        "稍知怜曲糵，渐解等灉濋。",
        "朋友半山阿，光阴共行旅。",
        "人故义当亲，衣故义当补。",
        "飞凫王令尹，期我向君所。",
        "君为拂眠床，淹留暮城阻。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206829,
      "title": "寄黄从善",
      "content": [
        "故人千里隔谈经，想见牛刀刃发硎。",
        "渴雨芭蕉心不展，未春杨柳眼先青。",
        "凫飞叶县郎官宰，虹贯江南处士星。",
        "天子文思求逆耳，吾宗一为试雷霆。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 206830,
      "title": "薛乐道自南阳来入都留宿会饮作诗饯行",
      "content": [
        "薛侯本贵胄，射策一矢中。",
        "金兰托平生，瓜葛比诸从。",
        "数面尚成亲，况乃居连栋。",
        "交游及父子，讲学连伯仲。",
        "奴人通使令，孩稚接戏弄。",
        "相怜负米勤，同力采兰供。",
        "每持君家书，平安觑款缝。",
        "秦人与吾炙，忧乐一体共。",
        "释之廷尉曹，微过成系讼。",
        "从此张长公，不肯为时用。",
        "丘阿无梧桐，曲直不在凤。",
        "生涯谷口耕，世事邯郸梦。",
        "自君抱忧端，酒椀未忍齅。",
        "高秋自南归，意气稍宽纵。",
        "黄花尚满篱，白蚁方浮瓮。",
        "私言助燕喜，且莫戒辎重。",
        "霜风猎帷幕，银烛吐䗖蝀。",
        "密坐幸颇欢，剧饮宁辞痛。",
        "疏钟鸣晓撞，小雨作寒霿。",
        "廐马萧萧鸣，征人稍稍动。",
        "九衢槐柳中，纵缓青丝鞚。",
        "朱楼豪士集，红袖清歌送。",
        "河鲤献鲙材，江橙解包贡。",
        "蟹擘鹅子黄，酒倾琥珀冻。",
        "举觞遥酌我，发嚏知见颂。",
        "行行鞭箠倦，短句烦屡讽。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206831,
      "title": "戏咏江南土风",
      "content": [
        "十月江南未得霜，高林残水下寒塘。",
        "饭香猎户分熊白，酒熟渔家擘蟹黄。",
        "橘摘金苞随驿使，禾舂玉粒送官仓。",
        "踏歌夜结田神社，游女多随陌上郎。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 206832,
      "title": "弈棋二首呈任公渐  其一",
      "content": [
        "偶无公事负朝暄，三百枯棋共一樽。",
        "坐隠不知岩穴乐，手谈胜与俗人言。",
        "簿书堆积尘生案，车马淹留客在门。",
        "战胜将骄疑必败，果然终取敌兵翻。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 206833,
      "title": "弈棋二首呈任公渐  其二",
      "content": [
        "偶无公事客休时，席上谈兵校两棋。",
        "心似蛛丝游碧落，身如蜩甲化枯枝。",
        "湘东一目诚甘死，天下中分尚可持。",
        "谁谓吾徒犹爱日，参横月落不曾知。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 206834,
      "title": "谢晓纯送衲袜",
      "content": [
        "刬草曾升马祖堂，暖窗接膝话还乡。",
        "赠行百衲兜罗袜，处处相随入道场。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206835,
      "title": "冲雪宿新寨忽忽不乐",
      "content": [
        "县北县南何日了，又来新寨解征鞍。",
        "山衔斗柄三星没，雪共月明千里寒。",
        "小吏有时须束带，故人颇问不休官。",
        "江南长尽捎云竹，归及春风斩钓竿。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 206836,
      "title": "听崇德君鼓琴",
      "content": [
        "月明江静寂寥中，大家敛袂抚孤桐。",
        "古人已矣古乐在，仿佛雅颂之遗风。",
        "妙手不易得，善听良独难。",
        "犹如优昙华，时一出世间。",
        "两忘琴意与己意，迺似不著十指弹。",
        "禅心默默三渊静，幽谷清风淡相应。",
        "丝声谁道不如竹，我已忘言得真性。",
        "罢琴窗外月沈江，万籁俱空七弦定。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206837,
      "title": "郭明甫作西斋于颍尾请予赋诗二首  其一",
      "content": [
        "食贫自以官为业，闻说西斋意凛然。",
        "万卷藏书宜子弟，十年种木长风烟。",
        "未尝终日不思颍，想见先生多好贤。",
        "安得雍容一樽酒，女郎台下水如天。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 206838,
      "title": "郭明甫作西斋于颍尾请予赋诗二首  其二",
      "content": [
        "东京望重两并州，遂有汾阳整缀旒。",
        "翁伯入关倾意气，林宗异世想风流。",
        "君家旧事皆青史，今日高材未白头。",
        "莫倚西斋好风月，长随三径古人游。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 206839,
      "title": "劝交代张和父酒",
      "content": [
        "风流五日张京兆，今日诸孙困小官。",
        "作尹大都如广汉，画眉仍复近长安。",
        "三人成虎事多有，众口铄金君自宽。",
        "酒兴情亲俱不浅，贱生何取罄交欢。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 206840,
      "title": "过平舆怀李子先时在并州",
      "content": [
        "前日幽人佐吏曹，我行隄草认青袍。",
        "心随汝水春波动，兴与并门夜月高。",
        "世上岂无千里马，人中难得九方臯。",
        "酒船鱼网归来是，花落故溪深一篙。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 206841,
      "title": "以金沙酴醾送公寿",
      "content": [
        "天遣酴醾玉作花，紫绵揉色染金沙。",
        "凭君著意樽前看，便与春工立等差。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206842,
      "title": "寄怀公寿",
      "content": [
        "好赋梁王在日边，重帘复幕锁神仙。",
        "莫因酒病疏桃李，且把春愁付管弦。",
        "愚智相悬三十里，荣枯同有百余年。",
        "及身强健且行乐，一笑端须直万钱。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 206843,
      "title": "武陵",
      "content": [
        "武陵樵客出桃源，自许重游不作难。",
        "却觅洞门烟锁断，归舟风月夜深寒。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206844,
      "title": "呻吟斋睡起五首呈世弼  其一",
      "content": [
        "棐几坐清昼，博山凝妙香。",
        "兰芽依客土，柳色过邻墙。",
        "巷僻过从少，官闲气味长。",
        "江南一枕梦，高卧听鸣桹。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 206845,
      "title": "呻吟斋睡起五首呈世弼  其二",
      "content": [
        "学省非簿领，卧疴常闭关。",
        "雨余楼阁静，风晚鸟乌还。",
        "赏逐四时改，心安一味闲。",
        "古人虽已往，不废仰高山。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 206846,
      "title": "呻吟斋睡起五首呈世弼  其三",
      "content": [
        "疏食吾犹饱，曲肱哦古今。",
        "酒倾因好事，弦绝为知音。",
        "妬蘗长春木，争巢喧暮禽。",
        "长怀阮校尉，北望首阳岑。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 206847,
      "title": "呻吟斋睡起五首呈世弼  其四",
      "content": [
        "已把社公酒，春寒那得严。",
        "厌听鸿啄雪，喜有燕穿帘。",
        "璞玉深藏器，囊锥立见尖。",
        "儿时爱谈道，今日口如箝。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 206848,
      "title": "呻吟斋睡起五首呈世弼  其五",
      "content": [
        "墙下蓬蒿地，儿童课翦除。",
        "蔓莴随分种，杞菊未须游。",
        "河水传烽火，交州报捷书。",
        "无能落闲处，慙媿饱春蔬。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 206849,
      "title": "奉答子高见赠十韵",
      "content": [
        "柳径雨著绵，竹斋风陨箨。",
        "屏处人事少，晴余鸟声乐。",
        "诗卷堕我前，谓从天上落。",
        "君有古人风，诗如古人作。",
        "箪瓢谢膏粱，翰墨化糟粕。",
        "误蒙东海观，吾浅迺可酌。",
        "真成闻道百，自谓莫己若。",
        "谢生石韫玉，志尚本丘壑。",
        "虽无首阳粟，饮水亦不恶。",
        "跫然何时来，为我一发药。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206850,
      "title": "招子高二十二韵兼简常甫世弼",
      "content": [
        "我行向厌次，夏扇日在摇。",
        "甘瓜未除垄，高柳尚鸣蜩。",
        "驾言聊摄归，飞霜晓封条。",
        "负薪泣裘褐，公子御狐貂。",
        "岁月坐晼晚，鬓颜飒然凋。",
        "道德千古事，斯文非一朝。",
        "往者我不及，后生多见超。",
        "吾党二三子，士林耸孤标。",
        "小谢抱周易，忘言独参寥。",
        "崔郎楚左史，二典考舜尧。",
        "王生风雅学，谈辩秋江潮。",
        "洒笔惊有司，小敌谓可骄。",
        "安知摴蒱局，临关败三枭。",
        "三生数步隔，屡赴茗碗邀。",
        "小谢殊未来，我觉百里遥。",
        "问之忧菽水，心虑极无聊。",
        "父怜母不诃，日以浊酒浇。",
        "此道如鼎实，念子羹未调。",
        "古来有亲养，回也乐一瓢。",
        "不田鹑生宎，在物乃为妖。",
        "吾言有师承，可信如斗杓。",
        "诗以解子忧，亦用当子招。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206851,
      "title": "次韵谢子高读渊明传",
      "content": [
        "枯木嵌空微暗淡，古器虽在无古弦。",
        "袖中正有南风手，谁为听之谁为传。",
        "风流岂落正始后，甲子不数义熙前。",
        "一轩黄菊平生事，无酒令人意缺然。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 206852,
      "title": "奉和王世弼寄上七兄先生用其韵",
      "content": [
        "宫槐弄黄黄，莲叶绿婉婉。",
        "时同二三友，竹轩凉夏晚。",
        "驾言都城南，以望征车返。",
        "何知苦淹回，及此秋景短。",
        "愁思令人瘦，举目道路远。",
        "西风脱一叶，荐士闻乡选。",
        "简书催渡河，宾客不得展。",
        "亲忧对萱丛，妇病废巾盥。",
        "言趋厌次城，鞭马倦长阪。",
        "枣林蔽天日，交阴不容繖。",
        "仰看实离离，忆见花纂纂。",
        "异乡怀节物，不共斟酒盏。",
        "举场下马入，深锁严籥管。",
        "诸生所程书，捃束若稭秆。",
        "蜜灯坐回环，丹砚精料柬。",
        "披榛拔芝兰，断石收琰琬。",
        "纷争一日事，声实溷端窾。",
        "天球或弃遗，斗筲尚何算。",
        "西归到官舍，尘土昏案版。",
        "寒窗穿碧疏，润础闹苍藓。",
        "诗书鹊巢翻，帷幔蛛丝罥。",
        "果知兄未来，光阴坐晼晚。",
        "昨蒙叔父报，亦叹音书简。",
        "薄言使事重，激切被天遣。",
        "逋流一方病，责任媲和扁。",
        "咨询怀靡及，不遑暇息偃。",
        "嚼冰进糜餐，冲雪踏层𪩘。",
        "严霜八月飞，貂狐无余暖。",
        "念嗟叔母刘，穷年寄甥馆。",
        "尚怜公初黠，诱掖到昭宛。",
        "庭坚薄才资，行又出町疃。",
        "浮云与世疏，短绠及道浅。",
        "匠伯首暂回，大樗终偃蹇。",
        "学宫尸廪入，奉养阙丰腆。",
        "学徒日新闻，孤陋犹旧典。",
        "小材渠困我，持斲问轮扁。",
        "大材我屈渠，越鸡当鹄卵。",
        "未能引分去，恋禄幸苟免。",
        "平生报一饱，从事极黾勉。",
        "岂如不见收，放身就闲散。",
        "思伯卧江南，无心趣轩冕。",
        "庞翁迹颇亲，黄蘗门屡款。",
        "斋余佛饭香，茶沸甘露满。",
        "逢人问进退，余事寄一莞。",
        "仲父挟高才，甘为沟中断。",
        "青黄可牺樽，荐庙配瑚琏。",
        "季父有逸兴，未尝入都辇。",
        "临流呼钓船，拂石弄琴阮。",
        "雍容从朋交，林下追游衍。",
        "田园虽足乐，及时思还返。",
        "阴寒木鸣条，望损倚门眼。",
        "南枝喜鸣鹊，尺素托黄犬。",
        "又以窀穸留，归期指姑洗。",
        "寄声问僧护，儿发可以绾。",
        "妙言对宾客，称渠万金产。",
        "尔来弄笔砚，墨水恶翻建。",
        "大字如栖鸦，已不作肥软。",
        "鲁论未彻章，正苦诸叔嬾。",
        "新诗开累纸，欲罢不能卷。",
        "远怀托孤高，别思盈缱绻。",
        "秋月明夜潮，柘浆冻金碗。",
        "疏杵韵寒砧，幽泉流翠笕。",
        "吟哦口垂涎，嚼味有余隽。",
        "传示同好人，我家东床坦。",
        "风烟意气生，挥毫写藤茧。",
        "猎山穷鹑𫛪，罩海极虾蚬。",
        "银钩乱眼膜，嘉句濯肺脘。",
        "且言伯在野，朋友必推挽。",
        "五泰列清庙，圣绪今皇缵。",
        "真儒运斗枢，道化迪天显。",
        "朝论惜才难，逸民大搜狝。",
        "岂闻任方物，包贡遗羽簳。",
        "招车必翘翘，前席思謇謇。",
        "王甥欲好怀，高意恐难转。",
        "长篇题远筒，封寄泪空潸。",
        "遥知云际开，灰飞黄钟管。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206853,
      "title": "送吴彦归番阳",
      "content": [
        "学省困齑盐，人材任尊奖。",
        "倥侗祝螟蛉，小大器罂瓬。",
        "诸生厌晚成，躐学要侩驵。",
        "摹书说偏旁，破义析名象。",
        "九鼎奏箫韶，爰居端不飨。",
        "青衿少到门，庭除昼闲敞。",
        "竹风交槐阴，三见秋气爽。",
        "时頼解事人，载酒直心赏。",
        "吴郎楚国材，幽兰秀榛莽。",
        "彦国吐嘉言，子将喜标榜。",
        "平生钦豪俊，久客慕乡党。",
        "虚斋延洒扫，薄饭荐腒鲞。",
        "诗句唾成珠，笑嘲惬爬痒。",
        "春夏频谢除，曾未厌来往。",
        "归雁多喜声，寒蝉停哀响。",
        "黄花满篱落，白蚁闹瓮盎。",
        "留君待佳节，忽忽戒徂两。",
        "亲戚伤离居，交游念畴曩。",
        "棋局无对曹，摴蒱失朋长。",
        "问君去为何，云物愁莽苍。",
        "寿亲发斑斑，千里劳梦想。",
        "家鸡藁头肥，寒鱼受罾网。",
        "甘旨蔌中厨，伊哑弄文襁。",
        "此行乐未央，安知川涂广。",
        "深秋上沧江，远水平如掌。",
        "人生要得意，壮士多旷荡。",
        "野鹤被笼樊，江鸥恋菰蒋。",
        "本来丘壑姿，不著刍豢养。",
        "寄声谢乡邻，为我具两桨。",
        "有路即归田，君其信非诳。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206854,
      "title": "二月丁卯喜雨吴体为北门留守文潞公作",
      "content": [
        "乘舆斋祭甘泉宫，遣使骏奔河岳中。",
        "谁与至尊分旰食，北门卧镇司徒公。",
        "微风不动天如醉，润物无声春有功。",
        "三十余年霖雨手，淹留河外作时丰。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 206855,
      "title": "李右司以诗送梅花至潞公予虽不接右司想见其人用老杜和元次山诗例次韵",
      "content": [
        "凡花俗草败人意，晚见琼蕤不恨迟。",
        "江左风流尚如此，春功终到岁寒枝。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206856,
      "title": "次韵外舅喜王正仲三丈奉诏祷南岳回至襄阳舍驿马就舟见过三首  其一",
      "content": [
        "汉上思见庞德公，别来悲叹事无穷。",
        "声名借甚漫前日，须鬓索然成老翁。",
        "家酿已随刻漏下，园花更开三四红。",
        "相逢不饮未为得，听取百鸟啼匆匆。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 206857,
      "title": "次韵外舅喜王正仲三丈奉诏祷南岳回至襄阳舍驿马就舟见过三首  其二",
      "content": [
        "能来问疾好音传，蹇步昏花当日痊。",
        "烹鲤得书增目力，呼儿扶立候门前。",
        "游谈取重慙犀首，居物多赢昧计然。",
        "惟有交亲等金石，白头忘义复忘年。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 206858,
      "title": "次韵外舅喜王正仲三丈奉诏祷南岳回至襄阳舍驿马就舟见过三首  其三",
      "content": [
        "语言少味无阿堵，冰雪相看有此君。",
        "灯火诗书如梦寐，麒麟图画属浮云。",
        "平章息女能为妇，欢喜儿曹解缀文。",
        "忧乐同科惟石友，别离空复数朝曛。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 206859,
      "title": "次韵正仲三丈自衡山返命舍驿过外舅师厚赠答",
      "content": [
        "昏昏市井气，呫呫儿女语。",
        "禽喧声百种，春作事万绪。",
        "人间鸡黍期，天上德星聚。",
        "乖离略十年，发白齿龃龉。",
        "太史祷衡丘，佐王用貔虎。",
        "子云免大夫，草玄空自苦。",
        "人生只尔是，付与瓮头醑。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206860,
      "title": "次韵子瞻春菜",
      "content": [
        "北方春蔬嚼冰雪，妍暖思采南山蕨。",
        "韭苗水餠姑置之，苦菜黄鸡羹糁滑。",
        "莼丝色紫菰首白，蒌蒿芽甜蔊头辣。",
        "生葅入汤翻手成，芼以姜橙夸缕抹。",
        "惊雷菌子出万钉，白鹅截掌鼈解甲。",
        "琅玕森深未飘箨，软炊香秔煨短茁。",
        "万钱自是宰相事，一饭且从吾党说。",
        "公如端为苦笋归，明日青衫诚可脱。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206861,
      "title": "闰月访同年李夷伯子真于河上子真以诗谢次韵",
      "content": [
        "十年不见犹如此，未觉斯人叹滞留。",
        "白璧明珠多按剑，浊泾清渭要同流。",
        "日晴花色自深浅，风软鸟声相应酬。",
        "谈笑一樽非俗物，对公无地可言愁。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 206862,
      "title": "戏答李子真河上见招来诗颇夸河上风物聊以当嘲云",
      "content": [
        "浑浑旧水无新意，漫漫黄尘涴白鸥。",
        "安得江湖忽当眼，卧听禽语信船流。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206863,
      "title": "和答李子真读陶庾诗",
      "content": [
        "乐易陶彭泽，忧思庾义城。",
        "风流扫地尽，诗句识余情。",
        "往者不再作，前贤畏后生。",
        "君言得意处，此意少人明。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 206864,
      "title": "丙寅十四首效韦苏州  其一",
      "content": [
        "雪霁草木动，春融烟景和。",
        "嘉晨掩关坐，如此节物何。",
        "同游得二子，晤对不在多。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206865,
      "title": "丙寅十四首效韦苏州  其二",
      "content": [
        "不知鞍马倦，想见洲渚春。",
        "清昼锁芳园，谁家停画轮。",
        "高柳极有思，向风招游人。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206866,
      "title": "丙寅十四首效韦苏州  其三",
      "content": [
        "渐嘉楼外花，嘉赏亭边柳。",
        "作者归山丘，今春为谁有。",
        "千秋万岁后，还复来游否。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206867,
      "title": "丙寅十四首效韦苏州  其四",
      "content": [
        "城南有佳园，风物迎马首。",
        "但赏主人竹，不饮主人酒。",
        "红日媚紫苔，轻风泛春柳。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206868,
      "title": "丙寅十四首效韦苏州  其五",
      "content": [
        "三公未白发，十辈乘朱轮。",
        "只取人看好，何益百年身。",
        "但愿长今日，清樽对故人。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206869,
      "title": "丙寅十四首效韦苏州  其六",
      "content": [
        "江梅香冷淡，开徧未全疏。",
        "已有耐寒蜨，双飞上花须。",
        "今夜严城角，肯留花在无。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206870,
      "title": "丙寅十四首效韦苏州  其七",
      "content": [
        "我思五柳翁，解作一生事。",
        "得钱送酒家，便静寻山寺。",
        "念我还如此，翁应会人意。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206871,
      "title": "丙寅十四首效韦苏州  其八",
      "content": [
        "庭空日色静，楼迥钟声迟。",
        "褐叟已争席，驯鸦更不疑。",
        "同来复同去，竟别我为谁。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206872,
      "title": "丙寅十四首效韦苏州  其九",
      "content": [
        "谢甥有逸兴，李髯非不嘉。",
        "苦思梦春草，醉狂眠酒家。",
        "斯游无俗物，傲睨至昏鸦。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206873,
      "title": "丙寅十四首效韦苏州  其一○",
      "content": [
        "寺古老僧静，亭阴修竹多。",
        "莱公作州日，部曲屡经过。",
        "众推识公面，苍石眠绿莎。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206874,
      "title": "丙寅十四首效韦苏州  其一一",
      "content": [
        "盛时众吹嘘，谪去众毁辱。",
        "不为公存亡，幽兰春自绿。",
        "欲书名相传，安得南山竹。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206875,
      "title": "丙寅十四首效韦苏州  其一二",
      "content": [
        "昔公调鼎实，指顾九庙尊。",
        "郡国富士马，于今开塞垣。",
        "谁能起公死，为国守北门。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206876,
      "title": "丙寅十四首效韦苏州  其一三",
      "content": [
        "出身世丧道，解绶饥驱我。",
        "杯中得醉乡，去就不复果。",
        "岂为俗人言，达人傥余可。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206877,
      "title": "丙寅十四首效韦苏州  其一四",
      "content": [
        "少小尚狷介，与人常不款。",
        "置身稍雍容，遇酒辄引满。",
        "自是鹤足长，难齐凫胫短。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206878,
      "title": "催公静碾茶",
      "content": [
        "雪里过门多恶客，春阴只恼有情人。",
        "睡魔正仰茶料理，急遣溪童碾玉尘。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206879,
      "title": "用前韵戏公静",
      "content": [
        "偶逢携酒便与饮，竟别我为何等人。",
        "兔月龙团不当惜，长卿消渴肺生尘。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206880,
      "title": "对酒歌答谢公静",
      "content": [
        "我为北海饮，君作东武吟。",
        "看君平生用意处，萧洒定自知人心。",
        "南阳城边雪三日，愁阴不能分皂白。",
        "摧轮踠蹄泥数尺，城门昼开眠贾客。",
        "移人僵尸在旦夕，谁能忍饥待食麦。",
        "身忧天下自有人，寒士何者愁填臆。",
        "民生正自不愿材，可乘以车可鞭策。",
        "君不见海南水沈紫栴檀，碎身百炼金博山。",
        "岂如不蒙斧斤赏，老大绝崖霜雪间。",
        "投身有用祸所集，何况四达之衢井先汲。",
        "昨日青童天上回，手捧玉帝除书来。",
        "一番通籍清都阙，百身书名赤城台。",
        "飞升度世无虚日，怪我短褐趋尘埃。",
        "顾谓彼童子，此何预人事。",
        "但对清樽即眼开，一杯引人著胜地。",
        "传闻官酒亦自清，径须沽取续吾瓶。",
        "南山朝来似有意，今夜傥放春月明。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206881,
      "title": "种决明",
      "content": [
        "后皇富嘉种，决明著方术。",
        "耘锄一席地，时至观茂密。",
        "缥叶资芼羹，缃花马蹄实。",
        "霜丛风雨余，簸簸场功毕。",
        "枕囊代曲肱，甘寝听芬苾。",
        "老眼愿力余，读书真成癖。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206882,
      "title": "同世弼韵作寄伯氏在济南兼呈六舅祠部",
      "content": [
        "山光扫黛水挼蓝，闻说樽前惬笑谈。",
        "伯氏清修如舅氏，济南萧洒似江南。",
        "屡陪风月干吟笔，不解笙簧醉舞衫。",
        "只恐使君乘传去，拾遗今日是前衔。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 206883,
      "title": "伯氏到济南寄诗颇言太守居有湖山之胜同韵和",
      "content": [
        "西来黄犬传佳句，知是陆机思陆云。",
        "历下楼台追把酒，舅家宾客厌论文。",
        "山椒欲雨好云气，湖面逆风生水纹。",
        "想得争棋飞鸟上，行人不见只听闻。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 206884,
      "title": "次韵寄李六弟济南郡城桥亭之诗",
      "content": [
        "客心如头垢，日欲撩千篦。",
        "闻人说江南，喜气吐晴霓。",
        "伏枕梦归路，子规吟翠微。",
        "济南似江南，旧见今不疑。",
        "洗心欲成游，王事相夺移。",
        "驽马恋栈豆，岂能辞絷缧。",
        "本无封侯骨，见事又重迟。",
        "徒能多著酒，大腹如鸱夷。",
        "惟思一渔舟，载网横渺弥。",
        "矫贡历下亭，朱阑转清溪。",
        "春风吹桃李，三月自成蹊。",
        "翠叶张日幄，红英铺地衣。",
        "此中有佳兴，不醉定自非。",
        "况当郡政成，野茧麦两岐。",
        "与民同观游，永夜不阖扉。",
        "女墙上金枢，天如青琉璃。",
        "想子果下归，马饱生刍嘶。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206885,
      "title": "用明发不寐有怀二人为韵寄李秉彝德叟  其一",
      "content": [
        "竹贯四时清，月通云气明。",
        "外弟有佳质，妙年推老成。",
        "后凋对霜雪，不昧处阴晴。",
        "盛德当如此，古人畏后生。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 206886,
      "title": "用明发不寐有怀二人为韵寄李秉彝德叟  其二",
      "content": [
        "在昔授子书，髧彼垂两发。",
        "乖离今十年，树立映先达。",
        "青灯哦妙句，如酌春酒滑。",
        "把书念携手，惆怅至明发。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 206887,
      "title": "用明发不寐有怀二人为韵寄李秉彝德叟  其三",
      "content": [
        "人生不如意，十事恒八九。",
        "未见历下人，徒倾历城酒。",
        "从来亲骨肉，不免相可不。",
        "但愿崇事实，虚名等箕斗。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 206888,
      "title": "用明发不寐有怀二人为韵寄李秉彝德叟  其四",
      "content": [
        "蚤知鹊山亭，李杜发佳思。",
        "弥年听传夸，登览通梦寐。",
        "遥怜坐清旷，落笔富新制。",
        "尚因宾客集，沥酒使我醉。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 206889,
      "title": "用明发不寐有怀二人为韵寄李秉彝德叟  其五",
      "content": [
        "往在舅氏旁，获拚堂上帚。",
        "六经观圣人，明如夜占斗。",
        "索居废旧闻，独学无新有。",
        "羡子杞梓材，未曾离矫揉。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 206890,
      "title": "用明发不寐有怀二人为韵寄李秉彝德叟  其六",
      "content": [
        "安诗无恙时，学行超辈侪。",
        "华屋落丘山，百忧满人怀。",
        "此士如不亡，仲子抱奇材。",
        "不独典刑在，神明还观来。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 206891,
      "title": "用明发不寐有怀二人为韵寄李秉彝德叟  其七",
      "content": [
        "少时诵诗书，贯穿数万字。",
        "迩来窥陈编，记一忘三二。",
        "光阴如可玩，老境翻手至。",
        "良医曾折足，说病迺真意。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 206892,
      "title": "用明发不寐有怀二人为韵寄李秉彝德叟  其八",
      "content": [
        "桃李春成径，本自不期人。",
        "历下两寒士，箪瓢能悦亲。",
        "耻蒙伐国问，肯卧覆车尘。",
        "子既得此友，从之求日新。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 206893,
      "title": "陪师厚游百花洲槃礴范文正祠下道羊昙哭谢安石事因读生存华屋处零落归山丘为十诗  其一",
      "content": [
        "忆在昭陵日，倾心用老成。",
        "功归仁祖庙，正得一书生。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 206894,
      "title": "陪师厚游百花洲槃礴范文正祠下道羊昙哭谢安石事因读生存华屋处零落归山丘为十诗  其二",
      "content": [
        "羊生但著鞭，勿哭西州门。",
        "故有不亡者，南山相与存。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 206895,
      "title": "陪师厚游百花洲槃礴范文正祠下道羊昙哭谢安石事因读生存华屋处零落归山丘为十诗  其三",
      "content": [
        "庆州自不恶，借甚载声华。",
        "忠义可无憾，公今有世家。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 206896,
      "title": "陪师厚游百花洲槃礴范文正祠下道羊昙哭谢安石事因读生存华屋处零落归山丘为十诗  其四",
      "content": [
        "公归未百年，鹳巢荒古屋。",
        "我吟殄瘁诗，悲风韵乔木。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 206897,
      "title": "陪师厚游百花洲槃礴范文正祠下道羊昙哭谢安石事因读生存华屋处零落归山丘为十诗  其五",
      "content": [
        "伤心祠下亭，在时公燕处。",
        "临水不相猜，江鸥会人语。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 206898,
      "title": "陪师厚游百花洲槃礴范文正祠下道羊昙哭谢安石事因读生存华屋处零落归山丘为十诗  其六",
      "content": [
        "公有一杯酒，与人同醉醒。",
        "遗民能记忆，欲语涕飘零。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 206899,
      "title": "陪师厚游百花洲槃礴范文正祠下道羊昙哭谢安石事因读生存华屋处零落归山丘为十诗  其七",
      "content": [
        "委径问谣俗，高丘省佃作。",
        "昔游非苟然，今花几开落。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 206900,
      "title": "陪师厚游百花洲槃礴范文正祠下道羊昙哭谢安石事因读生存华屋处零落归山丘为十诗  其八",
      "content": [
        "在昔实方枘，成功见圆机。",
        "九原尚友心，白首要同归。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 206901,
      "title": "陪师厚游百花洲槃礴范文正祠下道羊昙哭谢安石事因读生存华屋处零落归山丘为十诗  其九",
      "content": [
        "人去洲渚在，春回花草斑。",
        "清谈值渊对，发兴如江山。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 206902,
      "title": "陪师厚游百花洲槃礴范文正祠下道羊昙哭谢安石事因读生存华屋处零落归山丘为十诗  其一○",
      "content": [
        "落日衔城壁，祠东更一游。",
        "悲来惜酒少，安得董糟丘。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 206903,
      "title": "百花洲杂题",
      "content": [
        "范公种竹水边亭，漂泊来游一客星。",
        "神理不应从此尽，百年草树至今青。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206904,
      "title": "竹下把酒",
      "content": [
        "竹下倾春酒，愁阴为我开。",
        "不知临水语，更得几回来。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    }
  ],
