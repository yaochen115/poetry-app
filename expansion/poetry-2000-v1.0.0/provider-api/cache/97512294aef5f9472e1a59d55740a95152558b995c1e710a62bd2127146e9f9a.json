{
  "data": [
    {
      "id": 12322,
      "title": "陇头吟  其二",
      "content": [
        "兵满天山雪满衣，汉家都护拥旌旗。",
        "衔枚一夜袭疎勒，度陇生兵尽潜出。",
        "不得戎王誓不归，归时杨柳正依依。",
        "正依依，占春色，与君同醉花阴侧。"
      ],
      "author": {
        "id": 1108,
        "name": "曹勋"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 16296,
      "title": "除夜次庆符",
      "content": [
        "白发无端苦见寻，十年孤负醉花阴。",
        "可怜独鹤轻浮海，未及昏鸦日伴林。",
        "天末醉眠千岭寂，江南梦绕五云深。",
        "一杯遥祝慈闱寿，松柏长春共有心。"
      ],
      "author": {
        "id": 6120,
        "name": "胡铨"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 66215,
      "title": "挽吴明可给事  其二",
      "content": [
        "忆上诸生谒，公方薄恙侵。",
        "欣然蒙絮帽，恨不醉花阴。",
        "自说看人熟，相期晚岁深。",
        "半天苍岭雪，回首为沾襟。"
      ],
      "author": {
        "id": 4860,
        "name": "陈傅良"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 98146,
      "title": "踏青",
      "content": [
        "四野春工遍，柔风动赏心。",
        "踏青喧柳陌，举白醉花阴。"
      ],
      "author": {
        "id": 8619,
        "name": "赵汝鐩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 143410,
      "title": "牡丹",
      "content": [
        "东风常带三分冷，春日自有一种香。",
        "百花合和不可拣，中人如酒令人狂。",
        "马塍卖花只贪早，野翁自爱开迟好。",
        "看花不可见花心，烂熳开时春已老。",
        "梢头茧栗幻柈杅，有许包藏费天巧。",
        "自携尊酒醉花阴，偃仰鹿皮听语少。"
      ],
      "author": {
        "id": 12114,
        "name": "舒岳祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 166494,
      "title": "咏妓",
      "content": [
        "谁去江云问牧之，玉楼人醉半离披。",
        "烛摇窗影三更月，人醉花阴十二时。",
        "访杜秋娘惟我老，梦扬州鹤有谁知。",
        "临风笑却垂杨下，重解连环寄所思。"
      ],
      "author": {
        "id": 7004,
        "name": "缪鉴"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 184777,
      "title": "和君实南园独酌三首  其三",
      "content": [
        "累日怀贤痗寸心，谁知独酌醉花阴。",
        "公诗字字如珠玉，并得三篇胜万金。"
      ],
      "author": {
        "id": 7674,
        "name": "范纯仁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 314130,
      "title": "醉花阴",
      "content": [
        "露芽初破云腴细。",
        "玉纤纤亲试。",
        "香雪透金瓶，无限仙风，月下人微醉。",
        "相如消渴无佳思。",
        "了知君此意。",
        "不信老卢郎，花底春寒，赢得空无睡。"
      ],
      "author": {
        "id": 6565,
        "name": "舒亶"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314131,
      "title": "醉花阴",
      "content": [
        "月幌风帘香一阵。",
        "正千山雪尽。",
        "冷对酒尊傍，无语含情，别是江南信。",
        "寿阳妆罢人微困。",
        "更玉钗斜衬。",
        "拟插一枝归，只恐风流，羞上潘郎鬓。"
      ],
      "author": {
        "id": 6565,
        "name": "舒亶"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314744,
      "title": "醉花阴",
      "content": [
        "碧玉槎桠金粟小。",
        "山路惊秋老。",
        "倒倚湿寒烟，似怯秋风，阁泪啼清晓。",
        "铜壶冷浸宜深窈。",
        "人试新妆巧。",
        "云鬓一枝斜，小阁幽窗，是处都香了。"
      ],
      "author": {
        "id": 1129,
        "name": "丘崈"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315029,
      "title": "醉花阴",
      "content": [
        "老去悲秋人转瘦。",
        "更异乡重九。",
        "人意自凄凉，只有茱萸，岁岁香依旧。",
        "登高无奈空搔首。",
        "落照归鸦后。",
        "六代旧江山，满眼兴亡，一洗黄花酒。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315695,
      "title": "醉花阴",
      "content": [
        "黄花谩说年年好。",
        "也趁秋光老。",
        "绿鬓不惊秋，若斗尊前，人好花堪笑。",
        "蟠桃结子知多少。",
        "家住三山岛。",
        "何日跨归鸾，沧海飞尘，人世因缘了。"
      ],
      "author": {
        "id": 8618,
        "name": "辛弃疾"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316592,
      "title": "醉花阴",
      "content": [
        "峻极云端潇洒寺。",
        "赋我登高意。",
        "好景属清游，玉友黄花，谩续龙山事。",
        "秋风满座芝兰媚。",
        "杯酒随宜醉。",
        "行乐任天真，一笑和同，休问无携妓。"
      ],
      "author": {
        "id": 13346,
        "name": "陈亮"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316593,
      "title": "醉花阴",
      "content": [
        "姓名未勒慈恩寺。",
        "谁作山林意。",
        "杯酒且同欢，不许时人，轻料吾曹事。",
        "可怜风月于人媚。",
        "那对花前醉。",
        "珍重主人情，闻说当年，宴出红妆妓。"
      ],
      "author": {
        "id": 13346,
        "name": "陈亮"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 322511,
      "title": "睡花阴令・醉花阴",
      "content": [
        "愁云歇雨，净洗一奁秋霁。",
        "枝上鹊、欲栖还起。",
        "曲阑人独倚。",
        "持杯酌月，月未醉、笑人先醉。",
        "忘醉倚、木犀花睡。",
        "满衣花影碎。"
      ],
      "author": {
        "id": 2011,
        "name": "仇远"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 323394,
      "title": "醉花阴",
      "content": [
        "粉妆一捻和香聚。",
        "教露华休妒。",
        "今日在尊前，只为情多，脉脉都无语。",
        "西湖雪过留难住。",
        "指广寒归去。",
        "去后又明年，人在江南。",
        "梦到花开处。"
      ],
      "author": {
        "id": 5773,
        "name": "无名氏"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 323395,
      "title": "醉花阴",
      "content": [
        "霓裳浅艳来何处。",
        "不是闲云雨。",
        "雪苑旧精神，燕席吟窗，昨夜生轻素。",
        "阑珊岂是东风妒。",
        "惜暗香分付。",
        "香在玉清宫，不惹年华，只带春寒去。"
      ],
      "author": {
        "id": 5773,
        "name": "无名氏"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 324226,
      "title": "醉花阴",
      "content": [
        "东皇已有来归耗。",
        "十里青山道。",
        "冻蘖万株梅，一夜妆成，似趁鸣鸡早。",
        "年时清赏曾同到。",
        "先仗游蜂报。",
        "抖擞旧心情，一笑酬春，不羡和羹诏。"
      ],
      "author": {
        "id": 6598,
        "name": "葛胜仲"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 324338,
      "title": "清平乐",
      "content": [
        "吴头楚尾。",
        "踏破芒鞋底。",
        "万壑千岩秋色里。",
        "不耐恼人风味。",
        "而今我老芗林。",
        "世间百不关心。",
        "独喜爱香韩寿，能来同醉花阴。"
      ],
      "author": {
        "id": 649,
        "name": "向子諲"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 325100,
      "title": "醉花阴",
      "content": [
        "轻红蔓引丝多少。",
        "剪青兰叶巧。",
        "人向月中归，留下星钿，弹破真珠小。",
        "等闲不管春知道。",
        "多著绣帘围绕。",
        "只恐被东风，偷得馀香，分付闲花草。"
      ],
      "author": {
        "id": 2732,
        "name": "仲殊"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 325847,
      "title": "醉花阴",
      "content": [
        "一双鹤绕蟠桃戏。",
        "说人间千岁。",
        "昨夜降元精，蓬矢桑弧，又报千家喜。",
        "绮罗庭院笙歌沸。",
        "拥玳簪珠履。",
        "五福一……。"
      ],
      "author": {
        "id": 2732,
        "name": "仲殊"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 326337,
      "title": "醉花阴",
      "content": [
        "紫菊红萸开犯早。",
        "独占秋光老。",
        "酝造一般清，比著芝兰，犹自争多少。",
        "霜刀剪叶呈纤巧。",
        "手拈迎人笑。",
        "云鬓一枝斜，小阁幽窗，是处都香了。"
      ],
      "author": {
        "id": 13570,
        "name": "张元干"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 328048,
      "title": "醉花阴",
      "content": [
        "檀板一声莺起速。",
        "山影穿疏木。",
        "人在翠阴中，欲觅残春，春在屏风曲。",
        "劝君对客杯须覆。",
        "灯照瀛洲绿。",
        "西去玉堂深，魄冷魂清，独引金莲烛。"
      ],
      "author": {
        "id": 13078,
        "name": "毛滂"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 328049,
      "title": "醉花阴",
      "content": [
        "金叶犹温香未歇。",
        "尘定歌初彻。",
        "暖透薄罗衣，一霎清风，人映团团月。",
        "持杯试听留春阕。",
        "此个情肠别。",
        "分付与莺莺，劝取东君，停待芳菲节。"
      ],
      "author": {
        "id": 13078,
        "name": "毛滂"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 328241,
      "title": "醉花阴",
      "content": [
        "微含清露真珠滴。",
        "怯晓寒脉脉。",
        "秉烛倚雕栏，今日尊前，尽是多情客。",
        "从来应与春相得。",
        "有动人标格。",
        "半笑倚春风，醉脸生红，不是胭脂色。"
      ],
      "author": {
        "id": 11581,
        "name": "沈蔚"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 328685,
      "title": "醉花阴",
      "content": [
        "九陌寒轻春尚早。",
        "灯火都门道。",
        "月下步莲人，薄薄香罗，峭窄春衫小。",
        "梅妆浅淡风蛾袅。",
        "随路听嬉笑。",
        "无限面皮儿，虽则不同，各是一般好。"
      ],
      "author": {
        "id": 11032,
        "name": "曹组"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 328774,
      "title": "醉花阴",
      "content": [
        "红尘紫阳春来早。",
        "晚市烟光好。",
        "灯发万枝莲，华月光中，天净开蓬岛。",
        "老人旧日曾年少。",
        "年少还须老。",
        "今夕在天涯，烛影星桥，也似长安道。"
      ],
      "author": {
        "id": 10698,
        "name": "王庭珪"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 328775,
      "title": "醉花阴",
      "content": [
        "玉妃谪堕烟村远。",
        "犹似瑶池见。",
        "缺月挂寒梢，时有幽香，飞到朱帘畔。",
        "春风岭上淮南岸。",
        "曾为谁魂断。",
        "依旧瘦棱棱，天若有情，天也应须管。"
      ],
      "author": {
        "id": 10698,
        "name": "王庭珪"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 328776,
      "title": "醉花阴",
      "content": [
        "月娥昨夜江头过。",
        "把素衫揉破。",
        "冷逐晓云归，留与东风，吹作千千朵。",
        "云残香瘦春犹可。",
        "玉笛愁无那。",
        "倚著画楼人，且莫教他，吹动些儿个。"
      ],
      "author": {
        "id": 10698,
        "name": "王庭珪"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 329275,
      "title": "醉花阴",
      "content": [
        "翠箔阴阴笼画阁。",
        "昨夜东风恶。",
        "香迳慢春泥，南陌东郊，惆怅妨行乐。",
        "伤春比似年时觉。",
        "潘鬓新来薄。",
        "何处不禁愁，雨滴花腮，和泪胭脂落。"
      ],
      "author": {
        "id": 5827,
        "name": "李弥逊"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 329276,
      "title": "醉花阴",
      "content": [
        "紫菊红萸开犯早。",
        "独占秋光老。",
        "酝造一般清，比著芝兰，犹自争多少。",
        "霜刀翦叶呈纤巧。",
        "手拈迎人笑。",
        "云鬓一枝斜，小阁幽窗，是处都香了。"
      ],
      "author": {
        "id": 5827,
        "name": "李弥逊"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 329292,
      "title": "醉花阴",
      "content": [
        "池面芙蕖红散绮。",
        "鹊噪朱门喜。",
        "环佩响天风，香霭杯盘，更约麻姑侍。",
        "尘寰不隔蓬莱水。",
        "束带岩廊戏。",
        "瘦鹤与长松，且伴臞仙，久住人间世。"
      ],
      "author": {
        "id": 5827,
        "name": "李弥逊"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 329293,
      "title": "醉花阴",
      "content": [
        "帘卷西风轻雨外。",
        "揖数峰横翠。",
        "楼上地行仙，压玉为醪，旋摘黄金蕊。",
        "一觞一阕千秋岁。",
        "不愿封侯贵。",
        "长伴紫髯翁，踏月吹箫，笑咏云山里。"
      ],
      "author": {
        "id": 5827,
        "name": "李弥逊"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 329949,
      "title": "醉花阴",
      "content": [
        "薄雾浓云愁永昼。",
        "瑞脑消金兽。",
        "佳节又重阳，玉枕纱厨，半夜凉初透。",
        "东篱把洒黄昏后，有暗香盈袖。",
        "莫道不消魂，帘卷西风，人似黄花瘦。"
      ],
      "author": {
        "id": 11433,
        "name": "李清照"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 330352,
      "title": "醉花阴",
      "content": [
        "平生五色江淹笔。",
        "合占金闺籍。",
        "桃李满城春，恨□屏□，只作三年客。",
        "画船暂系河桥侧。",
        "一醉分南北。",
        "惆怅酒醒时，雨笠风蓑，似旧无人识。"
      ],
      "author": {
        "id": 4552,
        "name": "王灼"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 330553,
      "title": "醉花阴",
      "content": [
        "紫枢泽笏趋龙尾。",
        "平入钧衡位。",
        "春殿听宣麻，争喜登庸，何似今番喜。",
        "昆台宜有神仙裔。",
        "奕世貂蝉贵。",
        "玉砌长兰芽，好拥笙歌，长向花前醉。"
      ],
      "author": {
        "id": 13570,
        "name": "张元干"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 330554,
      "title": "醉花阴",
      "content": [
        "翠箔阴阴笼画阁。",
        "昨夜东风恶。",
        "芳径满香泥，南陌东郊，惆怅妨行乐。",
        "伤春比似年时恶。",
        "潘鬓新来薄。",
        "何处不禁愁，雨滴花腮，和泪胭脂落。"
      ],
      "author": {
        "id": 13570,
        "name": "张元干"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 330997,
      "title": "醉花阴",
      "content": [
        "满城风雨无端恶。",
        "孤负登高约。",
        "佳节若为酬，盛与歌呼，胜却秋萧索。",
        "菊花旋摘揉青萼。",
        "满满浮杯杓。",
        "老鬓未侵霜，醉里乌纱，不怕风吹落。"
      ],
      "author": {
        "id": 8894,
        "name": "杨无咎"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 330998,
      "title": "醉花阴",
      "content": [
        "捧杯不管馀酲恶。",
        "玉腕宽金约。",
        "宛转一声清，戛玉敲冰，浑胜鸣弦索。",
        "朱唇浅破桃花萼。",
        "重注鸬鹚杓。",
        "夜永醉归来，细想罗襟，犹有梁尘落。"
      ],
      "author": {
        "id": 8894,
        "name": "杨无咎"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 330999,
      "title": "醉花阴",
      "content": [
        "楚乡易得天时恶。",
        "风雨长如约。",
        "不道有幽人，衣带秋深，犹自悬鹑索。",
        "招呼朋侣如花萼。",
        "有酒须同酌。",
        "世态任凋疏，却爱黄花，不似群花落。"
      ],
      "author": {
        "id": 8894,
        "name": "杨无咎"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 331000,
      "title": "醉花阴",
      "content": [
        "金铃玉屑嫌非巧。",
        "生作文鸳小。",
        "西帝也多情，偷取佳名，分付闲花草。",
        "渊明手把谁携酒。",
        "羞把簪乌帽。",
        "寄与绮窗人，百种妖娆，不似酴醿好。"
      ],
      "author": {
        "id": 8894,
        "name": "杨无咎"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 331001,
      "title": "醉花阴",
      "content": [
        "淋漓尽日黄梅雨。",
        "断送春光暮。",
        "目断向高楼，持酒停歌，无计留春住。",
        "扑人飞絮浑无数。",
        "总是添愁绪。",
        "回首问春风，争得春愁，也解随春去。"
      ],
      "author": {
        "id": 8894,
        "name": "杨无咎"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 331740,
      "title": "醉花阴",
      "content": [
        "弧门此日犹能记。",
        "叹居诸难系。",
        "弹指片声中，不觉流年，五十还加二。",
        "儿童寿酒邀翁醉。",
        "笑欣欣相戏。",
        "休画老人星，白发苍髯，怎解如翁似。"
      ],
      "author": {
        "id": 2346,
        "name": "王之望"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 378518,
      "title": "黄钟・醉花阴",
      "content": [
        "独倚屏山把玉纤屈，并鸳枕将归期算彻。",
        "一自玉人别，瘦骨岩岩，趱过裙腰折。"
      ],
      "author": {
        "id": 9405,
        "name": "白贲"
      },
      "dynasty": {
        "id": 9,
        "name": "元"
      },
      "type": {
        "id": 30,
        "name": "元曲"
      }
    },
    {
      "id": 379377,
      "title": "尉迟恭单鞭夺槊・黄钟/醉花阴",
      "content": [
        "大路上难行落荒里践，两只脚蓦岭登山快捻。",
        "走的我一口气似撺椽。",
        "若见俺军师，一一的都分辨。",
        "（见科，云）报、报、报！",
        "（徐茂公云）好探子，他从那阵上来。",
        "你只看他喜气旺色，那输赢胜败早可知了也！"
      ],
      "author": {
        "id": 12296,
        "name": "关汉卿"
      },
      "dynasty": {
        "id": 9,
        "name": "元"
      },
      "type": {
        "id": 30,
        "name": "元曲"
      }
    },
    {
      "id": 380418,
      "title": "迷青琐倩女离魂・黄钟/醉花阴",
      "content": [
        "行李萧萧倦修整，甘岁月淹留帝京。",
        "只听的花外杜鹃声，催起归程。",
        "将往事，从头省，我心坎上犹自不惺惺，做了场弃业抛家恶梦境。"
      ],
      "author": {
        "id": 4559,
        "name": "郑光祖"
      },
      "dynasty": {
        "id": 9,
        "name": "元"
      },
      "type": {
        "id": 30,
        "name": "元曲"
      }
    },
    {
      "id": 380673,
      "title": "雁门关存孝打虎・黄钟/醉花阴",
      "content": [
        "一托气直奔数十里，遍体汗浑如水洗。",
        "非是我说兵机，若论相持，大会垓应难比。"
      ],
      "author": {
        "id": 5773,
        "name": "无名氏"
      },
      "dynasty": {
        "id": 9,
        "name": "元"
      },
      "type": {
        "id": 30,
        "name": "元曲"
      }
    },
    {
      "id": 381838,
      "title": "汉高皇濯足气英布・黄钟/醉花阴",
      "content": [
        "俺则见楚汉争锋兢寰士，那楚霸王肯甘心伏输。",
        "此一阵不寻俗，这汉英布武勇谁如？",
        "据慷慨堪称许，善韬略晓兵书。",
        "(带云)出马来，出马来，(唱)没霎儿早熬翻了楚项羽。"
      ],
      "author": {
        "id": 2114,
        "name": "尚仲贤"
      },
      "dynasty": {
        "id": 9,
        "name": "元"
      },
      "type": {
        "id": 30,
        "name": "元曲"
      }
    },
    {
      "id": 382500,
      "title": "黄钟・醉花阴离思",
      "content": [
        "银甲挑灯玉荷小，黄篆冷香沉绣阁。",
        "清耿耿夜迢迢，寒透朱箔，倚枕和衣倒。",
        "纱窗外雨潇潇，我则见叶落闲庭风自扫。"
      ],
      "author": {
        "id": 11010,
        "name": "汤舜民"
      },
      "dynasty": {
        "id": 9,
        "name": "元"
      },
      "type": {
        "id": 30,
        "name": "元曲"
      }
    },
    {
      "id": 383941,
      "title": "黄钟・醉花阴走苏卿",
      "content": [
        "雪浪银涛大江迥，举目玻璃万顷，天际水云平。",
        "浩浩澄澄，越感的人孤另。",
        "一叶片帆轻，直赶到金山不见影。"
      ],
      "author": {
        "id": 3576,
        "name": "宋方壶"
      },
      "dynasty": {
        "id": 9,
        "name": "元"
      },
      "type": {
        "id": 30,
        "name": "元曲"
      }
    },
    {
      "id": 384682,
      "title": "鲁智深喜赏黄花峪・黄钟/醉花阴",
      "content": [
        "酒不醒贫僧怕见走，云岩寺权为宿头。",
        "且时住，暂停留，混践您些儿改日为友。",
        "常言道措大谒儒流，自古道客僧投寺宿。"
      ],
      "author": {
        "id": 5773,
        "name": "无名氏"
      },
      "dynasty": {
        "id": 9,
        "name": "元"
      },
      "type": {
        "id": 30,
        "name": "元曲"
      }
    },
    {
      "id": 384733,
      "title": "黄钟・醉花阴北闺情",
      "content": [
        "鸳鸯浦莲开并蒂长，桃源洞春光艳阳。",
        "花解语玉生香，月户云窗，忽被风飘荡。",
        "分莺燕，拆鸾凰，总是离人苦断肠。"
      ],
      "author": {
        "id": 9682,
        "name": "荆干臣"
      },
      "dynasty": {
        "id": 9,
        "name": "元"
      },
      "type": {
        "id": 30,
        "name": "元曲"
      }
    },
    {
      "id": 384897,
      "title": "包待制智赚灰栏记・黄钟/醉花阴",
      "content": [
        "头上雪何曾住半霎？",
        "摧林木狂风乱刮。",
        "我这更耽烦恼受嗟呀，走的来力尽筋乏，又加上些脓撼撼的棒疮发。",
        "(薛净云)着我们当这等苦差，还不走哩。",
        "(做打科)(正旦唱)怎当这嗔忿忿吖吖，但走的慢行的迟，他可便舍命的打。"
      ],
      "author": {
        "id": 7612,
        "name": "李行甫"
      },
      "dynasty": {
        "id": 9,
        "name": "元"
      },
      "type": {
        "id": 30,
        "name": "元曲"
      }
    },
    {
      "id": 385468,
      "title": "张孔目智勘魔合罗・黄钟/醉花阴",
      "content": [
        "干着我贩卖南昌利钱好，急叫来又早病魔缠着。",
        "盼家门咫尺似天遥，好教我这会儿心焦，按不住小鹿儿拘拘地跳。",
        "端的是最难熬，只一阵头疼险些就劈破了。"
      ],
      "author": {
        "id": 12568,
        "name": "孟汉卿"
      },
      "dynasty": {
        "id": 9,
        "name": "元"
      },
      "type": {
        "id": 30,
        "name": "元曲"
      }
    },
    {
      "id": 385547,
      "title": "二郎神醉射锁魔镜・黄钟/醉花阴",
      "content": [
        "两下里交锋喊声起，差小圣到天兵阵里，看胜败，辨真实。",
        "若说着那咤，众神将应难比。"
      ],
      "author": {
        "id": 5773,
        "name": "无名氏"
      },
      "dynasty": {
        "id": 9,
        "name": "元"
      },
      "type": {
        "id": 30,
        "name": "元曲"
      }
    },
    {
      "id": 385755,
      "title": "程咬金斧劈老君堂・黄钟/醉花阴",
      "content": [
        "百万天兵喊声炒，自古无今番战讨。",
        "凭虎略显龙韬，奉命兴师，有道伐无道。",
        "则-阵定唐朝，听小校从头，(做见科，云)报、报！",
        "喏！",
        "(唱)说这遭。"
      ],
      "author": {
        "id": 4559,
        "name": "郑光祖"
      },
      "dynasty": {
        "id": 9,
        "name": "元"
      },
      "type": {
        "id": 30,
        "name": "元曲"
      }
    },
    {
      "id": 387192,
      "title": "黄钟・醉花阴远宵忆旧",
      "content": [
        "冻雪才消腊梅谢，却早击碎泥牛应节，柳眼吐些些。",
        "时序相催，斗把鳌山结。"
      ],
      "author": {
        "id": 5599,
        "name": "曾瑞"
      },
      "dynasty": {
        "id": 9,
        "name": "元"
      },
      "type": {
        "id": 30,
        "name": "元曲"
      }
    },
    {
      "id": 387763,
      "title": "黄钟・醉花阴",
      "content": [
        "凉夜厌厌露华冷，天淡淡银河耿耿。",
        "秋月浸闲亭，雨过新凉，梧叶雕金并。"
      ],
      "author": {
        "id": 11986,
        "name": "侯正卿"
      },
      "dynasty": {
        "id": 9,
        "name": "元"
      },
      "type": {
        "id": 30,
        "name": "元曲"
      }
    },
    {
      "id": 388659,
      "title": "黄钟・醉花阴秋怀",
      "content": [
        "窗外芭樵战秋雨，又添上新愁几许。",
        "珊枕剩绣衾余，落雁沉鱼，眼底知何处。",
        "酒醒后细踌蹰，一寸柔肠千万缕。"
      ],
      "author": {
        "id": 5773,
        "name": "无名氏"
      },
      "dynasty": {
        "id": 9,
        "name": "元"
      },
      "type": {
        "id": 30,
        "name": "元曲"
      }
    }
  ],
