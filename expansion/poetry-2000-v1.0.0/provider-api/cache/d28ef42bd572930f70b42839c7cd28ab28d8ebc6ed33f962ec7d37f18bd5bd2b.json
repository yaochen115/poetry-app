{
  "data": [
    {
      "id": 265629,
      "title": "洛中送韩七中丞之吴兴口号五首 三",
      "content": [
        "今朝无意诉离杯，何况清弦急管催。",
        "本欲醉中轻远别，不知翻引酒悲来。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 265630,
      "title": "洛中送韩七中丞之吴兴口号五首 四",
      "content": [
        "骆驼桥上苹风急，鹦鹉杯中箬下春。",
        "水碧山青知好处，开颜一笑向何人。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 265631,
      "title": "洛中送韩七中丞之吴兴口号五首 五",
      "content": [
        "溪中士女出笆篱，溪上鸳鸯避画旗。",
        "何处人间似仙境，春山携妓采茶时。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 265632,
      "title": "送廖参谋东游二首 一",
      "content": [
        "九陌逢君又别离，行云别鹤本无期。",
        "望嵩楼上忽相见，看过花开花落时。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 265633,
      "title": "送廖参谋东游二首 二",
      "content": [
        "繁花落尽君辞去，绿草垂杨引征路。",
        "东道诸侯皆故人，留连必是多情处。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 265634,
      "title": "洛中春末送杜录事赴蕲州",
      "content": [
        "樽前花下长相见，明日忽为千里人。",
        "君过午桥回首望，洛城犹自有残春。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 265635,
      "title": "夜燕福建卢侍郎宅因送之镇",
      "content": [
        "暂驻旌旗洛水堤，绮筵红烛醉兰闺。",
        "美人美酒长相逐，莫怕猿声发建溪。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 265636,
      "title": "重送鸿举师赴江陵谒马逢侍御",
      "content": [
        "西北秋风凋蕙兰，洞庭波上碧云寒。",
        "茂陵才子江陵住，乞取新诗合掌看。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 265637,
      "title": "赠长沙赞头陀",
      "content": [
        "外道邪山千万重，真言一发尽摧峰。",
        "有时明月无人夜，独向昭潭制恶龙。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 265638,
      "title": "送霄韵上人游天台",
      "content": [
        "曲江僧向松江见，又到天台看石桥。",
        "鹤恋故巢云恋岫，比君犹自不逍遥。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 265639,
      "title": "台城怀古",
      "content": [
        "清江悠悠王气沉，六朝遗事何处寻。",
        "宫墙隐嶙围野泽，鹳鶂夜鸣秋色深。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 265640,
      "title": "戏赠崔千牛",
      "content": [
        "学道深山许老人，留名万代不关身。",
        "劝君多买长安酒，南陌东城占取春。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 265641,
      "title": "扬州春夜李端公益张侍御登段侍御平路密县李少府𪽈秘书张正字复元同会于水馆对酒联句追刻烛击铜钵故事迟辄举觥以饮之逮夜艾群公沾醉纷然就枕余偶独醒因题诗于段君枕上以志其事",
      "content": [
        "寂寂独看金烬落，纷纷只见玉山颓。",
        "自羞不是高阳侣，一夜星星骑马回。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 265642,
      "title": "逢王十二学士入翰林因以诗赠",
      "content": [
        "厩马翩翩禁外逢，星槎上汉杳难从。",
        "定知欲报淮南诏，促召王褒入九重。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 265643,
      "title": "阙下口号呈柳仪曹",
      "content": [
        "彩仗神旗猎晓风，鸡人一唱鼓蓬蓬。",
        "铜壶漏水何时歇，如此相催即老翁。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 265644,
      "title": "监祠夕月坛书事",
      "content": [
        "西皥司分昼夜平，羲和停午太阴生。",
        "铿锵揖让秋光里，观者如云出凤城。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 265645,
      "title": "元和甲午岁诏书尽征江湘逐客余自武陵赴京宿于都亭有怀续来诸君子",
      "content": [
        "雷雨江山起卧龙，武陵樵客蹑仙踪。",
        "十年楚水枫林下，今夜初闻长乐钟。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 265646,
      "title": "元和十一年自朗州召至京戏赠看花诸君子",
      "content": [
        "紫陌红尘拂面来，无人不道看花回。",
        "玄都观里桃千树，尽是刘郎去后栽。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 265647,
      "title": "再游玄都观",
      "content": [
        "百亩庭中半是苔，桃花净尽菜花开。",
        "种桃道士归何处，前度刘郎今又来。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 265648,
      "title": "与歌者米嘉荣",
      "content": [
        "唱得凉州意外声，旧人唯数米嘉荣。",
        "近来时世轻先辈，好染髭须事后生。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 265649,
      "title": "望夫石",
      "content": [
        "终日望夫夫不归，化为孤石苦相思。",
        "望来已是几千载，只似当时初望时。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 265650,
      "title": "听旧宫中乐人穆氏唱歌",
      "content": [
        "曾随织女渡天河，记得云间第一歌。",
        "休唱贞元供奉曲，当时朝士已无多。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 265651,
      "title": "金陵五题 石头城",
      "content": [
        "山围故国周遭在，潮打空城寂寞回。",
        "淮水东边旧时月，夜深还过女墙来。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 265652,
      "title": "金陵五题 乌衣巷",
      "content": [
        "朱雀桥边野草花，乌衣巷口夕阳斜。",
        "旧时王谢堂前燕，飞入寻常百姓家。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 265653,
      "title": "金陵五题 台城",
      "content": [
        "台城六代竞豪华，结绮临春事最奢。",
        "万户千门成野草，只缘一曲后庭花。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 265654,
      "title": "金陵五题 生公讲堂",
      "content": [
        "生公说法鬼神听，身后空堂夜不扃。",
        "高坐寂寥尘漠漠，一方明月可中庭。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 265655,
      "title": "金陵五题 江令宅",
      "content": [
        "南朝词臣北朝客，归来唯见秦淮碧。",
        "池台竹树三亩余，至今人道江家宅。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 265656,
      "title": "韩信庙",
      "content": [
        "将略兵机命世雄，苍黄钟室叹良弓。",
        "遂令后代登坛者，每一寻思怕立功。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 265657,
      "title": "李贾二大夫谏拜命后寄杨八寿州",
      "content": [
        "谏省新登二直臣，万方惊喜捧丝纶。",
        "则知天子明如日，肯放淮南高卧人。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 265658,
      "title": "美温尚书镇定兴元以诗寄贺",
      "content": [
        "旌旗入境犬无声，戮尽鲸鲵汉水清。",
        "从此世人开耳目，始知名将出书生。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 265659,
      "title": "酬瑞州吴大夫夜泊湘川见寄一绝",
      "content": [
        "夜泊湘川逐客心，月明猿苦血沾襟。",
        "湘妃旧竹痕犹浅，从此因君染更深。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 265660,
      "title": "征还京师见旧番官冯叔达",
      "content": [
        "前者匆匆幞被行，十年憔悴到京城。",
        "南宫旧吏来相问，何处淹留白发生。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 265661,
      "title": "与歌者何戡",
      "content": [
        "二十余年别帝京，重闻天乐不胜情。",
        "旧人唯有何戡在，更与殷勤唱渭城。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 265662,
      "title": "与歌童田顺郎",
      "content": [
        "天下能歌御史娘，花前叶底奉君王。",
        "九重深处无人见，分付新声与顺郎。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 265663,
      "title": "燕尔馆破屏风所画至精人多叹赏题之",
      "content": [
        "画时应遇空亡日，卖处难逢识别人。",
        "唯有多情往来客，强将衫袖拂埃尘。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 265664,
      "title": "赏牡丹",
      "content": [
        "庭前芍药妖无格，池上芙蕖净少情。",
        "唯有牡丹真国色，花开时节动京城。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 265665,
      "title": "题欹器图",
      "content": [
        "秦国功成思税驾，晋臣名遂叹危机。",
        "无因上蔡牵黄犬，愿作丹徒一布衣。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 265666,
      "title": "伤桃源薛道士",
      "content": [
        "坛边松在鹤巢空，白鹿闲行旧径中。",
        "手植红桃千树发，满山无主任春风。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 265667,
      "title": "王思道碑堂下作",
      "content": [
        "苍苍宰树起寒烟，尚有威名海内传。",
        "四府旧闻多故吏，几人垂泪拜碑前。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 265668,
      "title": "伤愚溪三首 一",
      "content": [
        "溪水悠悠春自来，草堂无主燕飞回。",
        "隔帘惟见中庭草，一树山榴依旧开。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 265669,
      "title": "伤愚溪三首 二",
      "content": [
        "草圣数行留坏壁，木奴千树属邻家。",
        "唯见里门通德牓，残阳寂寞出樵车。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 265670,
      "title": "伤愚溪三首 三",
      "content": [
        "柳门竹巷依依在，野草青苔日日多。",
        "纵有邻人解吹笛，山阳旧侣更谁过。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 265671,
      "title": "伤循州浑尚书",
      "content": [
        "贵人沦落路人衰，碧海连天丹旐回。",
        "遥想长安此时节，朱门深巷百花开。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 265672,
      "title": "代靖安佳人怨二首 一",
      "content": [
        "宝马鸣珂踏晓尘，鱼文匕首犯车茵。",
        "适来行哭里门外，昨夜华堂歌舞人。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 265673,
      "title": "代靖安佳人怨二首 二",
      "content": [
        "秉烛朝天遂不回，路人弹指望高台。",
        "墙东便是伤心地，夜夜流萤飞去来。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 265674,
      "title": "碧涧寺见元九侍御和展上人诗有三生之句因以和",
      "content": [
        "廊下题诗满壁尘，塔前松树已皴鳞。",
        "古来唯有王文度，重见平生竺道人。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 265675,
      "title": "思黯南墅赏牡丹",
      "content": [
        "偶然相遇人间世，合在增城阿姥家。",
        "有此倾城好颜色，天教晚发赛诸花。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 265676,
      "title": "和浙西尚书闻常州杨给事制新楼因寄之作",
      "content": [
        "文昌星象尽东来，油幕朱门次第开。",
        "且上新楼看风月，会乘云雨一时回。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 265677,
      "title": "从梁宣明二帝碑堂下作",
      "content": [
        "玉马朝周从此辞，园陵寂寞对丰碑。",
        "千行宰树荆州道，暮雨萧萧闻子规。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 265678,
      "title": "赠李司空妓",
      "content": [
        "高髻云鬟宫样妆，春风一曲杜韦娘。",
        "司空见惯浑闲事，断尽苏州刺史肠。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 265679,
      "title": "赠李司空妓",
      "content": [
        "髪鬓梳头宫様妆，春风一曲杜韦娘。",
        "司空见惯浑闲事，断尽苏州刺史肠。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 265680,
      "title": "和西川李尚书伤孔雀及薛涛之什",
      "content": [
        "玉儿已逐金镮葬，翠羽先随秋草萎。",
        "唯见芙蓉含晓露，数行红泪滴清池。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 265681,
      "title": "同乐天登栖灵寺塔",
      "content": [
        "步步相携不觉难，九层云外倚阑干。",
        "忽然笑语半天上，无限游人举眼看。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 265682,
      "title": "同乐天登栖灵寺塔",
      "content": [
        "步步相㩦不觉难，九霄云外倚栏杆。",
        "忽然语笑半天上，无限游人举眼看。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 265683,
      "title": "有所嗟二首 一",
      "content": [
        "庾令楼中初见时，武昌春柳似腰肢。",
        "相逢相笑尽如梦，为雨为云今不知。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 265684,
      "title": "有所嗟二首 二",
      "content": [
        "鄂渚蒙蒙烟雨微，女郎魂逐暮云归。",
        "只应长在汉阳渡，化作鸳鸯一只飞。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 265685,
      "title": "和裴相公傍水闲行",
      "content": [
        "为爱逍遥第一篇，时时闲步赏风烟。",
        "看花临水心无事，功业成来二十年。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 265686,
      "title": "杏园花下酬乐天见赠",
      "content": [
        "二十余年作逐臣，归来还见曲江春。",
        "游人莫笑白头醉，老醉花间有几人。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 265687,
      "title": "和乐天春词",
      "content": [
        "新妆面面下朱楼，深锁春光一院愁。",
        "行到中庭数花朵，蜻蜓飞上玉搔头。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 265688,
      "title": "和严给事闻唐昌观玉蘂花下有游仙二绝 一",
      "content": [
        "玉女来看玉蘂花，异香先引七香车。",
        "攀枝弄雪时廻顾，惊怪人间日易斜。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 265689,
      "title": "和严给事闻唐昌观玉蘂花下有游仙二绝 二",
      "content": [
        "雪蘂琼丝满院春，衣轻步步不生尘。",
        "君平帘下徒相问，长伴吹箫别有人。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 265690,
      "title": "忆乐天",
      "content": [
        "寻常相见意殷勤，别后相思梦更频。",
        "每遇登临好风景，羡他天性少情人。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 265691,
      "title": "醉答乐天",
      "content": [
        "洛城洛城何日归，故人故人今转稀。",
        "莫嗟雪里暂时别，终拟云间相逐飞。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 265692,
      "title": "虎丘寺见元相公二年前题名怆然有咏",
      "content": [
        "浐水送君君不还，见君题字虎丘山。",
        "因知早贵兼才子，不得多时在世间。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 265693,
      "title": "寄赠小樊",
      "content": [
        "花面丫头十三四，春来绰约向人时。",
        "终须买取名春草，处处将行步步随。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 265694,
      "title": "吟乐天自问怆然有作",
      "content": [
        "亲友关心皆不见，风光满眼倍伤神。",
        "洛阳城里多池馆，几处花开有主人。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 265695,
      "title": "和令狐相公别牡丹",
      "content": [
        "平章宅里一栏花，临到开时不在家。",
        "莫道两京非远别，春明门外即天涯。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 265696,
      "title": "和令狐相公闻思帝乡有感",
      "content": [
        "当初造曲者为谁，说得思乡恋阙时。",
        "沧海西头旧丞相，停杯处分不须吹。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 265697,
      "title": "酬令狐相公见寄",
      "content": [
        "群玉山头住四年，每闻笙鹤看诸仙。",
        "何时得把浮丘袖，白日将升第九天。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 265698,
      "title": "令狐相公春思见寄",
      "content": [
        "一纸书封四句诗，芳晨对酒远相思。",
        "长吟尽日西南望，犹及残春花落时。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 265699,
      "title": "城内花园颇曾游翫令公居守亦有素期适春霜一夕委谢书实以荅令狐相公见谑",
      "content": [
        "楼下芳园最占春，年年结侣采花频。",
        "繁霜一夜相撩治，不似佳人似老人。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 265700,
      "title": "奉和裴晋公凉风亭睡觉",
      "content": [
        "骊龙睡后珠元在，仙鹤行时步又轻。",
        "方寸莹然无一事，水声来似玉琴声。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 265701,
      "title": "荅裴令公雪中讶白二十二与诸公不相访之什",
      "content": [
        "玉树琼楼满眼新，的知开合待诸宾。",
        "迟迟未去非无意，拟作梁园坐右人。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 265702,
      "title": "吴方之见示听江西故吏朱幼恭歌三篇颇有怀故林之想吟讽不足因而和之",
      "content": [
        "侯家故吏歌声发，逸处能高怨处低。",
        "今岁洛中无雨雪，眼前风景是江西。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 265703,
      "title": "裴令公见示诮乐天寄奴买马绝句斐言仰和且戏乐天",
      "content": [
        "常奴安得似方回，争望追风绝足来。",
        "若把翠娥酬𫘧耳，始知天下有奇才。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 265704,
      "title": "酬思黯代书见戏",
      "content": [
        "官冷如浆病满身，凌寒不易过天津。",
        "少年留取多情兴，请待花时作主人。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 265705,
      "title": "荅张侍御贾喜再登科后自洛赴上都赠别",
      "content": [
        "又被时人写姓名，春风引路入京城。",
        "知君忆得前身事，分付莺花与后生。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 265706,
      "title": "赴连州途经洛阳诸公置酒相送张员外贾以诗见赠率尔酬之",
      "content": [
        "谪在三湘最远州，边鸿不到水南流。",
        "如今暂寄罇前笑，明日辞君步步愁。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 265707,
      "title": "赠元九侍御文石枕以诗奖之",
      "content": [
        "文章似锦气如虹，宜荐华簪绿殿中。",
        "纵使凉飙生旦夕，犹堪拂拭愈头风。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 265708,
      "title": "酬元九院长自江陵见寄",
      "content": [
        "无事寻花至仙境，等闲栽树比封君。",
        "金门通籍真多士，黄纸除书每日闻。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 265709,
      "title": "酬杨侍郎凭见寄",
      "content": [
        "翔鸾阙底谢皇恩，缨上沧浪旧水痕。",
        "疎傅挥金忽相忆，远擎长句与招魂。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 265710,
      "title": "酬马大夫登洭口戍见寄",
      "content": [
        "新辞将印拂朝缨，临水登山四体轻。",
        "犹念天涯未归客，瘴云深处守孤城。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 265711,
      "title": "荅杨八敬之绝句",
      "content": [
        "饱霜孤竹声偏切，带火焦桐韵本悲。",
        "今日知音一留听，是君心事不平时。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 265712,
      "title": "重寄表臣二首 一",
      "content": [
        "对酒临流奈别何，君今已醉我蹉跎。",
        "分明记取星星鬓，他日相逢应更多。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 265713,
      "title": "重寄表臣二首 二",
      "content": [
        "世间人事有何穷，过后思量尽是空。",
        "早晚同归洛阳陌，卜隣须近祝鸡翁。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 265714,
      "title": "重寄绝句",
      "content": [
        "淮西既是平安地，鸦路今无羽檄飞。",
        "闻道唐州最清静，战场耕尽野花稀。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 265715,
      "title": "酬杨八副使将赴湖南途中见寄一绝",
      "content": [
        "知逐征南冠楚材，远劳书信到阳台。",
        "明朝若上君山上，一道巴江自此来。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 265716,
      "title": "遥和韩睦州元相公二君子",
      "content": [
        "玉人紫绶相辉映，却要霜须一两茎。",
        "其奈无成空老去，每临明镜若为情。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 265717,
      "title": "吴兴敬郎中见惠斑竹杖兼示一绝聊以谢之",
      "content": [
        "一茎炯炯琅玕色，数节重重玳瑁文。",
        "挂到高山未登处，青云路上愿逢君。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 265718,
      "title": "奉和裴令公夜宴",
      "content": [
        "天下苍生望不休，东山虽有但时游。",
        "从来海上仙桃树，肯逐人间风露秋。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 265719,
      "title": "秋夜安国观闻笙",
      "content": [
        "织女分明银汉秋，桂枝梧叶共飕飗。",
        "月露满庭人寂寂，霓裳一曲在高楼。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 265720,
      "title": "酬仆射牛相公晋国池上别后至甘棠馆忽梦同游因成口号见寄",
      "content": [
        "已嗟池上别魂惊，忽报梦中携手行。",
        "此夜独归还乞梦，老人无睡到天明。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 265721,
      "title": "裴侍郎大尹雪中遗酒一壶兼示眼疾平一绝有闲行把酒之句斐然仰酬",
      "content": [
        "卷尽轻云月更明，金箆不用且闲行。",
        "若倾家酿招来客，何必池塘春草生。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 265722,
      "title": "和滑州李尚书上巳忆江南禊事",
      "content": [
        "白马津头春日迟，沙州归鴈拂旌旗。",
        "柳营唯有军中戏，不似江南三月时。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 265723,
      "title": "酬柳柳州家鸡之赠",
      "content": [
        "日日临池弄小雏，还思写论付官奴。",
        "柳家新样元和脚，且尽畺芽歛手徒。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 265724,
      "title": "荅前篇",
      "content": [
        "小儿弄笔不能嗔，涴壁书窗且当勤。",
        "闻彼梦熊犹未兆，女中谁是卫夫人。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 265725,
      "title": "荅后篇",
      "content": [
        "昔日慵工记姓名，远劳辛苦写西京。",
        "近来渐有临池兴，为报元常欲抗行。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 265726,
      "title": "重荅柳柳州",
      "content": [
        "弱冠同怀长者忧，临岐回想尽悠悠。",
        "耦耕若便遗身老，黄发相看万事休。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 265727,
      "title": "登清晖楼",
      "content": [
        "浔阳江色潮添满，彭蠡秋声鴈送来。",
        "南望庐山千万仞，共夸新出栋梁材。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 265728,
      "title": "赴和州于武昌县再遇毛仙翁十八兄因成一绝",
      "content": [
        "武昌山下蜀江东，重向仙舟见葛洪。",
        "又得案前亲礼拜，大罗天诀玉函封。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    }
  ],
