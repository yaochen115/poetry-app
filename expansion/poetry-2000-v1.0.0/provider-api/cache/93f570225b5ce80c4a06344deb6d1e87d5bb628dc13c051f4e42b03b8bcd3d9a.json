{
  "data": [
    {
      "id": 308253,
      "title": "觉公院施鸟石台",
      "content": [
        "石台置香饭，斋后施诸禽。",
        "童子亦知善，众生无惧心。",
        "苔痕苍晓露，盘势出香林。",
        "锡杖或围绕，吾师一念深。"
      ],
      "author": {
        "id": 2684,
        "name": "李颀"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 308254,
      "title": "篱笋",
      "content": [
        "东园长新笋，映日复穿篱。",
        "迸出依青嶂，攒生半绿池。",
        "色因林向背，行逐地高卑。",
        "但恐春将老，青青独尔为。"
      ],
      "author": {
        "id": 2684,
        "name": "李颀"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 308255,
      "title": "达奚吏部夫人寇氏挽歌",
      "content": [
        "存殁令名传，青青松柏田。",
        "事姑称孝妇，生子继先贤。",
        "露湿铭旌重，风吹卤簿前。",
        "阴堂从此闭，谁诵女师篇。"
      ],
      "author": {
        "id": 2684,
        "name": "李颀"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 308256,
      "title": "寄司勋卢员外",
      "content": [
        "流澌腊月下河阳，草色新年发建章。",
        "秦地立春传太史，汉宫题柱忆仙郎。",
        "归鸿欲度千门雪，侍女新添五夜香。",
        "早晚荐雄文似者，故人今已赋长杨。"
      ],
      "author": {
        "id": 2684,
        "name": "李颀"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 308257,
      "title": "寄綦毋三",
      "content": [
        "新加大邑绶仍黄，近与单车去洛阳。",
        "顾眄一过丞相府，风流三接令公香。",
        "南川稉稻花侵县，西岭云霞色满堂。",
        "共道进贤蒙上赏，看君几岁作台郎。"
      ],
      "author": {
        "id": 2684,
        "name": "李颀"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 308258,
      "title": "送魏万之京",
      "content": [
        "朝闻游子唱离歌，昨夜微霜初渡河。",
        "鸿鴈不堪愁里听，云山况是客中过。",
        "关城树色催寒近，御苑砧声向晚多。",
        "莫见长安行乐处，空令岁月易蹉跎。"
      ],
      "author": {
        "id": 2684,
        "name": "李颀"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 308259,
      "title": "送李回",
      "content": [
        "知君官属大司农，诏幸骊山职事雄。",
        "岁发金钱供御府，昼看仙液注离宫。",
        "千岩曙雪旌门上，十月寒花辇路中。",
        "不覩声明与文物，自伤流滞去关东。"
      ],
      "author": {
        "id": 2684,
        "name": "李颀"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 308260,
      "title": "宿莹公禅房闻梵",
      "content": [
        "花宫仙梵远微微，月隐高城钟漏稀。",
        "夜动霜林惊落叶，晓闻天籁发清机。",
        "萧条已入寒空静，飒沓仍随秋雨飞。",
        "始觉浮生无住著，顿令心地欲皈依。"
      ],
      "author": {
        "id": 2684,
        "name": "李颀"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 308261,
      "title": "题璿公山池",
      "content": [
        "远公遯迹庐山岑，开士幽居祇树林。",
        "片石孤峰窥色相，清池皓月照禅心。",
        "指挥如意天花落，坐卧闲房春草深。",
        "此外俗尘都不染，惟余玄度得相寻。"
      ],
      "author": {
        "id": 2684,
        "name": "李颀"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 308262,
      "title": "题卢五旧居",
      "content": [
        "物在人亡无见期，闲庭系马不胜悲。",
        "窓前绿竹生空地，门外青山如旧时。",
        "怅望秋天鸣坠叶，巑岏枯柳宿寒鸱。",
        "忆君泪落东流水，岁岁花开知为谁。"
      ],
      "author": {
        "id": 2684,
        "name": "李颀"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 308263,
      "title": "赠别张兵曹",
      "content": [
        "汉家萧相国，功盖五诸侯。",
        "勋业河山重，丹青锡命优。",
        "君为禁脔壻，争看玉人游。",
        "荀令焚香日，潘郎振藻秋。",
        "新成鹦鹉赋，能衣鹔鹴裘。",
        "不惮轩车远，仍寻薜荔幽。",
        "苑梨飞绛叶，伊水净寒流。",
        "雪满故关道，云遮祥凤楼。",
        "一身轻寸禄，万物任虚舟。",
        "别后如相问，沧波双白鸥。"
      ],
      "author": {
        "id": 2684,
        "name": "李颀"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 308264,
      "title": "宿香山寺石楼",
      "content": [
        "夜宿翠微半，高楼闻暗泉。",
        "渔舟带远火，山磬发孤烟。",
        "衣拂云松外，门清河汉边。",
        "峰峦低枕席，世界接人天。",
        "霭霭花出雾，辉辉星映川。",
        "东林曙莺满，惆怅欲言旋。"
      ],
      "author": {
        "id": 2684,
        "name": "李颀"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 308265,
      "title": "圣善阁送裴迪入京",
      "content": [
        "云华满高阁，苔色上钩栏。",
        "药草空阶静，梧桐返照寒。",
        "清吟可愈疾，携手暂同欢。",
        "堕叶和金磬，饥乌鸣露盘。",
        "伊流惜东别，灞水向西看。",
        "旧托含香署，云霄何足难。"
      ],
      "author": {
        "id": 2684,
        "name": "李颀"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 308266,
      "title": "奉送漪叔游颍川兼谒淮阳太守",
      "content": [
        "罢吏今何适，辞家方独行。",
        "嵩阳入归梦，颍水半前程。",
        "闻道淮阳守，东南卧理清。",
        "郡斋观政日，人马望乡情。",
        "叠岭雪初霁，寒砧霜后鸣。",
        "临川嗟拜手，寂寞事躬耕。"
      ],
      "author": {
        "id": 2684,
        "name": "李颀"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 308267,
      "title": "二妃庙送裴侍御使桂阳",
      "content": [
        "沅上秋草晚，苍苍尧女祠。",
        "无人见精魄，万古寒猿悲。",
        "桂水身殁后，椒浆神降时。",
        "回云迎赤豹，骤雨飒文狸。",
        "受命出炎海，焚香征楚词。",
        "乘骢感遗迹，一吊清川湄。"
      ],
      "author": {
        "id": 2684,
        "name": "李颀"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 308268,
      "title": "送暨道士还玉清观",
      "content": [
        "仙宫有名籍，度世吴江𣸣。",
        "大道本无我，青春长与君。",
        "中州俄已到，至理得而闻。",
        "明主降黄屋，时人看白云。",
        "空山何窈窕，三秀日氛氲。",
        "遂此留书客，超遥烟驾分。"
      ],
      "author": {
        "id": 2684,
        "name": "李颀"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 308269,
      "title": "送刘主簿归金坛",
      "content": [
        "与子十年旧，其如离别何。",
        "宦游邻故国，归梦是沧波。",
        "京口青山远，金陵芳草多。",
        "云帆晓容裔，江日昼清和。",
        "县郭舟人饮，津亭渔者歌。",
        "茅山有仙洞，羡尔再经过。"
      ],
      "author": {
        "id": 2684,
        "name": "李颀"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 308270,
      "title": "送卢少府赴延陵",
      "content": [
        "问君从宦所，何日府中趋。",
        "遥指金陵县，青山天一隅。",
        "行人怀寸禄，小吏献新图。",
        "北固波涛险，南天风俗殊。",
        "春江连橘柚，晚景媚菰蒲。",
        "漠漠花生渚，亭亭云过湖。",
        "滩沙映村火，水雾歛樯乌。",
        "回首东门路，乡书不可无。"
      ],
      "author": {
        "id": 2684,
        "name": "李颀"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 308271,
      "title": "送皇甫曾游襄阳山水兼谒韦太守",
      "content": [
        "岘山枕襄阳，滔滔江汉长。",
        "山深卧龙宅，水净斩蛟乡。",
        "元凯春秋传，昭明文选堂。",
        "风流满今古，烟岛思微茫。",
        "白鴈暮冲雪，青林寒带霜。",
        "芦花独戍晚，柑实万家香。",
        "旧国欲兹别，轻舟眇未央。",
        "百花亭漫漫，一柱观苍苍。",
        "按俗荆南牧，持衡吏部郎。",
        "逢君立五马，应醉习家塘。"
      ],
      "author": {
        "id": 2684,
        "name": "李颀"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 308272,
      "title": "龙门送裴侍御监五岭选",
      "content": [
        "万里番禺地，官人继帝忧。",
        "君为柱下史，将命出东周。",
        "歇马傍川路，张灯临石楼。",
        "棱棱静疎木，濞濞响寒流。",
        "榔叶四荒外，梅花五岭头。",
        "明珠尉佗国，翠羽夜郎洲。",
        "夷俗富珍产，土风资宦游。",
        "心清物不杂，弊革事无留。",
        "举善必称最，持奸当去尤。",
        "何辞桂江远，今日用贤秋。"
      ],
      "author": {
        "id": 2684,
        "name": "李颀"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 308273,
      "title": "送乔琳",
      "content": [
        "草绿小平津，花开伊水滨。",
        "今君不得意，孤负帝乡春。",
        "口不言金帛，心常任屈伸。",
        "阮公惟饮酒，陶令肯羞贫。",
        "阳羡风流地，沧海游寓人。",
        "菱歌五湖远，桂树八公邻。",
        "青鸟迎孤棹，白云随一身。",
        "潮随秣陵上，月映石头新。",
        "未可逃名利，应须在缙绅。",
        "汀洲芳杜色，劝尔暂垂纶。"
      ],
      "author": {
        "id": 2684,
        "name": "李颀"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 308274,
      "title": "题少府监李丞山池",
      "content": [
        "能向府亭内，置兹山与林。",
        "他人骕骦马，而我薜萝心。",
        "雨止禁门肃，莺啼官柳深。",
        "长廊閟军器，积水背城阴。",
        "窓外王孙草，床头中散琴。",
        "清风多仰慕，吾亦尔知音。"
      ],
      "author": {
        "id": 2684,
        "name": "李颀"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 308275,
      "title": "长寿寺粲公院新甃井",
      "content": [
        "僧房来往久，露井每同观。",
        "白石抱新甃，苍苔依旧栏。",
        "空瓶宛转下，长绠辘轳盘。",
        "境界因心净，泉源见底寒。",
        "钟鸣时灌顶，对此日闲安。"
      ],
      "author": {
        "id": 2684,
        "name": "李颀"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 308276,
      "title": "魏仓曹宅各赋一物得当轩石竹",
      "content": [
        "罗生殊众色，独为表华滋。",
        "虽杂蕙兰处，无争桃李时。",
        "同人趋府暇，落日后庭期。",
        "密叶散红点，灵条惊紫蕤。",
        "芳菲看不厌，采摘愿来兹。"
      ],
      "author": {
        "id": 2684,
        "name": "李颀"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 308277,
      "title": "奉送五叔入京兼寄綦毋三",
      "content": [
        "云阴带残日，怅别此何时。",
        "欲望黄山道，无由见所思。"
      ],
      "author": {
        "id": 2684,
        "name": "李颀"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 308278,
      "title": "寄韩鹏",
      "content": [
        "为政心闲物自闲，朝看飞鸟暮飞还。",
        "寄书河上神明宰，羡尔城头姑射山。"
      ],
      "author": {
        "id": 2684,
        "name": "李颀"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 308279,
      "title": "百花原",
      "content": [
        "百花原头望京师，黄河水流无已时。",
        "穷秋旷野行人绝，马首东来知是谁。"
      ],
      "author": {
        "id": 2684,
        "name": "李颀"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 308280,
      "title": "遇刘五",
      "content": [
        "洛阳一别梨花新，黄鸟飞飞逢故人。",
        "携手当年共为乐，无惊蕙草惜残春。"
      ],
      "author": {
        "id": 2684,
        "name": "李颀"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 308281,
      "title": "送崔婴赴汉阳",
      "content": [
        "中外相连弟与兄，新加小县子男名。",
        "才年三十佩铜印，知尔弦歌汉水清。"
      ],
      "author": {
        "id": 2684,
        "name": "李颀"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 308282,
      "title": "送五叔入京兼寄綦毋三",
      "content": [
        "吏部明年拜官后，西城必与故人期。",
        "寄书春草年年色，莫道相逢玉女祠。"
      ],
      "author": {
        "id": 2684,
        "name": "李颀"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 308283,
      "title": "野老曝背",
      "content": [
        "百岁老翁不种田，惟知曝背乐残年。",
        "有时扪虱独搔首，目送归鸿篱下眠。"
      ],
      "author": {
        "id": 2684,
        "name": "李颀"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 308284,
      "title": "送东阳王太守",
      "content": [
        "江臯杜蘅绿，芳草日迟迟。",
        "桧楫今何去，星郎出守时。",
        "彤襜问风俗，明主寄惸嫠。",
        "令下不徒尔，人和当在兹。",
        "昔年经此地，微月有佳期。",
        "洞口桂花白，岩前春草滋。",
        "素沙静津濑，青壁带川坻。",
        "野鹤每孤立，林鼯常昼悲。"
      ],
      "author": {
        "id": 2684,
        "name": "李颀"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 308285,
      "title": "咏张諲山水",
      "content": [
        "小山破体闲支策，落日梨花照空壁。",
        "诗堪记室妬风流，画与将军作勍敌。"
      ],
      "author": {
        "id": 2684,
        "name": "李颀"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 308286,
      "title": "失题",
      "content": [
        "紫极殿前朝伏奏，龙华会里日相望。",
        "别离岁岁如流水，谁辨他乡与故乡。"
      ],
      "author": {
        "id": 2684,
        "name": "李颀"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 334558,
      "title": "相和歌辞：从军行",
      "content": [
        "白日登山望烽火，昏黄饮马傍交河。",
        "行人刁斗风砂暗，",
        "胡雁哀鸣夜夜飞，胡儿眼泪双双落。",
        "闻道玉门犹被遮，"
      ],
      "author": {
        "id": 2684,
        "name": "李颀"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 334824,
      "title": "琴曲歌辞：湘夫人",
      "content": [
        "九嶷日已暮，三湘云复愁。",
        "窅蔼罗袂色，潺湲江水流。",
        "佳期来北渚，捐玦在芳洲。"
      ],
      "author": {
        "id": 2684,
        "name": "李颀"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 334929,
      "title": "杂曲歌辞：缓歌行",
      "content": [
        "小来托身攀贵游，倾财破产无所忧。",
        "暮拟经过石渠署，",
        "一沉一浮会有时，弃我翻然如脱屣。",
        "男儿立身须自强，",
        "二八蛾眉梳堕马，美酒清歌曲房下。",
        "文昌宫中赐锦衣，",
        "早知今日读书是，悔作从来任侠非。"
      ],
      "author": {
        "id": 2684,
        "name": "李颀"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 335016,
      "title": "杂曲歌辞：行路难",
      "content": [
        "汉家名臣杨德祖，四代五公享茅土。",
        "父兄子弟绾银黄，",
        "宾客填街复满坐，片言出口生辉光。",
        "世人逐势争奔走，",
        "一朝谢病还乡里，穷巷苍茫绝知己。",
        "秋风落叶闭重门，",
        "鲁连所以蹈沧海，古往今来称达人。"
      ],
      "author": {
        "id": 2684,
        "name": "李颀"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 335351,
      "title": "杂歌谣辞：郑樱桃歌",
      "content": [
        "石季龙，僭天禄，擅雄豪，美人姓郑名樱桃。",
        "樱桃美颜香且泽，娥娥侍寝专宫掖。",
        "后庭卷衣三万人，",
        "织成花映红纶巾，红旗掣曳卤簿新。",
        "鸣鼙走马接飞鸟，",
        "自言富贵不可量，女为公主男为王。",
        "赤花双簟珊瑚床，",
        "邺城苍苍白露微，世事翻覆黄云飞。"
      ],
      "author": {
        "id": 2684,
        "name": "李颀"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 338976,
      "title": "古塞下曲",
      "content": [
        "行人朝走马，直指蓟城傍。",
        "蓟城通漠北，万里别吾乡。",
        "海上千烽火，沙中百战场。",
        "军书发上郡，春色度河阳。",
        "袅袅汉宫柳，青青胡地桑。",
        "琵琶出塞曲，横笛断君肠。"
      ],
      "author": {
        "id": 2684,
        "name": "李颀"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 338978,
      "title": "东京寄万楚",
      "content": [
        "濩落久无用，隐身甘采薇。",
        "仍闻薄宦者，还事田家衣。",
        "颍水日夜流，故人相见稀。",
        "春山不可望，黄鸟东南飞。",
        "濯足岂长往，一樽聊可依。",
        "了然潭上月，适我胸中机。",
        "在昔同门友，如今出处非。",
        "优游白虎殿，偃息青琐闱。",
        "且有荐君表，当看携手归。",
        "寄书不待面，兰茝空芳菲。"
      ],
      "author": {
        "id": 2684,
        "name": "李颀"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 338979,
      "title": "寄焦炼师",
      "content": [
        "得道凡百岁，烧丹惟一身。",
        "悠悠孤峰顶，日见三花春。",
        "白鹤翠微里，黄精幽涧滨。",
        "始知世上客，不及山中人。",
        "仙境若在梦，朝云如可亲。",
        "何由睹颜色，挥手谢风尘。"
      ],
      "author": {
        "id": 2684,
        "name": "李颀"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 338980,
      "title": "望鸣皋山白云寄洛阳卢主簿",
      "content": [
        "饮马伊水中，白云鸣皋上。",
        "氛氲山绝顶，行子时一望。",
        "照日龙虎姿，攒空冰雪状。",
        "嵡嵸殊未已，崚嶒忽相向。",
        "皎皎横绿林，霏霏澹青嶂。",
        "远映村更失，孤高鹤来傍。",
        "胜气欣有逢，仙游且难访。",
        "故人吏京剧，每事多闲放。",
        "室画峨眉峰，心格洞庭浪。",
        "惜哉清兴里，不见予所尚。"
      ],
      "author": {
        "id": 2684,
        "name": "李颀"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 338981,
      "title": "寄万齐融",
      "content": [
        "名高不择仕，委世随虚舟。",
        "小邑常叹屈，故乡行可游。",
        "青枫半村户，香稻盈田畴。",
        "为政日清净，何人同海鸥。",
        "摇巾北林夕，把菊东山秋。",
        "对酒池云满，向家湖水流。",
        "岸阴止鸣鹄，山色映潜虬。",
        "靡靡俗中理，萧萧川上幽。",
        "昔年至吴郡，常隐临江楼。",
        "我有一书劄，因之芳杜洲。"
      ],
      "author": {
        "id": 2684,
        "name": "李颀"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 338982,
      "title": "赠张旭",
      "content": [
        "张公性嗜酒，豁达无所营。",
        "皓首穷草隶，时称太湖精。",
        "露顶据胡床，长叫三五声。",
        "兴来洒素壁，挥笔如流星。",
        "下舍风萧条，寒草满户庭。",
        "问家何所有，生事如浮萍。",
        "左手持蟹螯，右手执丹经。",
        "瞪目视霄汉，不知醉与醒。",
        "诸宾且方坐，旭日临东城。",
        "荷叶裹江鱼，白瓯贮香粳。",
        "微禄心不屑，放神于八纮。",
        "时人不识者，即是安期生。"
      ],
      "author": {
        "id": 2684,
        "name": "李颀"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 338985,
      "title": "谒张果先生",
      "content": [
        "先生谷神者，甲子焉能计。",
        "自说轩辕师，于今几千岁。",
        "寓游城郭里，浪迹希夷际。",
        "应物云无心，逢时舟不系。",
        "餐霞断火粒，野服兼荷制。",
        "白雪净肌肤，青松养身世。",
        "韬精殊豹隐，炼骨同蝉蜕。",
        "忽去不知谁，偶来宁有契。",
        "二仪齐寿考，六合随休憩。",
        "彭聃犹婴孩，松期且微细。",
        "尝闻穆天子，更忆汉皇帝。",
        "亲屈万乘尊，将穷四海裔。",
        "车徒遍草木，锦帛招谈说。",
        "八骏空往还，三山转亏蔽。",
        "吾君感至德，玄老欣来诣。",
        "受箓金殿开，清斋玉堂闭。",
        "笙歌迎拜首，羽帐崇严卫。",
        "禁柳垂香炉，宫花拂仙袂。",
        "祈年宝祚广，致福苍生惠。",
        "何必待龙髯，鼎成方取济。"
      ],
      "author": {
        "id": 2684,
        "name": "李颀"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 338986,
      "title": "光上座廊下众山五韵",
      "content": [
        "名岳在庑下，吾师居一床。",
        "每闻楞伽经，只对清翠光。",
        "百谷聚雪色，莓苔侵屋梁。",
        "气盘古壁转，势引幽阶长。",
        "愿游薜叶下，日见金炉香。"
      ],
      "author": {
        "id": 2684,
        "name": "李颀"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 338988,
      "title": "宋少府东溪泛舟",
      "content": [
        "登岸还入舟，水禽惊笑语。",
        "晚叶低众色，湿云带残暑。",
        "落日乘醉归，溪流复几许。"
      ],
      "author": {
        "id": 2684,
        "name": "李颀"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 338989,
      "title": "与诸公游济渎泛舟",
      "content": [
        "济水出王屋，其源来不穷。",
        "洑泉数眼沸，平地流清通。",
        "皇帝崇祀典，诏书视三公。",
        "分官祷灵庙，奠璧沉河宫。",
        "神应每如答，松篁气葱茏。",
        "苍螭送飞雨，赤鲤喷回风。",
        "洒酒布瑶席，吹箫下玉童。",
        "玄冥掌阴事，祝史告年丰。",
        "百谷趋潭底，三光悬镜中。",
        "浅深露沙石，苹藻生虚空。",
        "晚景临泛美，亭皋轻霭红。",
        "晴山傍舟楫，白鹭惊丝桐。",
        "我本家颍北，开门见维嵩。",
        "焉知松峰外，又有天坛东。",
        "左手正接z5，浩歌眄青穹。",
        "夷犹傲清吏，偃仰狎渔翁。",
        "对此川上闲，非君谁与同。",
        "霜凝远村渚，月净蒹葭丛。",
        "兹境信难遇，为欢殊未终。",
        "淹留怅言别，烟屿夕微蒙。"
      ],
      "author": {
        "id": 2684,
        "name": "李颀"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 338990,
      "title": "送綦毋三谒房给事",
      "content": [
        "夫子大名下，家无钟石储。",
        "惜哉湖海上，曾校蓬莱书。",
        "外物非本意，此生空澹如。",
        "所思但乘兴，远适唯单车。",
        "高道时坎坷，故交愿吹嘘。",
        "徒言青琐闼，不爱承明庐。",
        "百里人户满，片言争讼疏。",
        "手持莲花经，目送飞鸟余。",
        "晚景南路别，炎云中伏初。",
        "此行傥不遂，归食芦洲鱼。"
      ],
      "author": {
        "id": 2684,
        "name": "李颀"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 338992,
      "title": "送裴腾",
      "content": [
        "养德为众许，森然此丈夫。",
        "放情白云外，爽气连虬须。",
        "衡镜合知子，公心谁谓无。",
        "还令不得意，单马遂长驱。",
        "桑野蚕忙时，怜君久踟踌。",
        "新晴荷卷叶，孟夏雉将雏。",
        "令弟为县尹，高城汾水隅。",
        "相将簿领闲，倚望恒峰孤。",
        "香露团百草，紫梨分万株。",
        "归来授衣假，莫使故园芜。"
      ],
      "author": {
        "id": 2684,
        "name": "李颀"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 338993,
      "title": "送司农崔丞",
      "content": [
        "黄鹂鸣官寺，香草色未已。",
        "同时皆省郎，而我独留此。",
        "维监太仓粟，常对府小史。",
        "清阴罗广庭，政事如流水。",
        "奉使往长安，今承朝野欢。",
        "宰臣应记识，明主必迁官。",
        "塞外貔将虎，池中鸳与鸾。",
        "词人洞箫赋，公子鵕鸃冠。",
        "邑里春方晚，昆明花欲阑。",
        "行行取高位，当使路傍看。"
      ],
      "author": {
        "id": 2684,
        "name": "李颀"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 338996,
      "title": "赠别高三十五",
      "content": [
        "五十无产业，心轻百万资。",
        "屠酤亦与群，不问君是谁。",
        "饮酒或垂钓，狂歌兼咏诗。",
        "焉知汉高士，莫识越鸱夷。",
        "寄迹栖霞山，蓬头睢水湄。",
        "忽然辟命下，众谓趋丹墀。",
        "沐浴著赐衣，西来马行迟。",
        "能令相府重，且有函关期。",
        "黾勉从寸禄，旧游梁宋时。",
        "皤皤邑中叟，相候鬓如丝。",
        "官舍柳林静，河梁杏叶滋。",
        "摘芳云景晏，把手秋蝉悲。",
        "小县情未惬，折腰君莫辞。",
        "吾观主人意，不久召京师。"
      ],
      "author": {
        "id": 2684,
        "name": "李颀"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 338997,
      "title": "崔五宅送刘跂入京",
      "content": [
        "行人惜寸景，系马暂留欢。",
        "昨日辞小沛，何时到长安。",
        "乡中饮酒礼，客里行路难。",
        "清洛云鸿度，故关风日寒。",
        "维将道可乐，不念身无官。",
        "生事东山远，田园芳岁阑。",
        "东归余谢病，西去子加餐。",
        "宋伯非徒尔，明时正可干。",
        "躬耕守贫贱，失计在林端。",
        "宿昔奉颜色，惭无双玉盘。"
      ],
      "author": {
        "id": 2684,
        "name": "李颀"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 338998,
      "title": "送马录事赴永阳",
      "content": [
        "子为郡从事，主印清淮边。",
        "谈笑一州里，从容群吏先。",
        "手持三尺令，遣决如流泉。",
        "太守既相许，诸公谁不然。",
        "孤城连海树，万室带山烟。",
        "春日溪湖净，芳洲葭菼连。",
        "炊粳蟹螯熟，下箸鲈鱼鲜。",
        "野鹤宿簷际，楚云飞面前。",
        "听歌送离曲，且驻木兰船。",
        "赠尔八行字，当闻佳政传。"
      ],
      "author": {
        "id": 2684,
        "name": "李颀"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 338999,
      "title": "临别送张諲入蜀",
      "content": [
        "出门便为客，惘然悲徒御。",
        "四海维一身，茫茫欲何去。",
        "经山复历水，百恨将千虑。",
        "剑阁望梁州，是君断肠处。",
        "孤云伤客心，落日感君深。",
        "梦里蒹葭渚，天边橘柚林。",
        "蜀江流不测，蜀路险难寻。",
        "木有相思号，猿多愁苦音。",
        "莫向愚山隐，愚山地非近。",
        "故乡可归来，眼见芳菲尽。"
      ],
      "author": {
        "id": 2684,
        "name": "李颀"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 339000,
      "title": "送王昌龄",
      "content": [
        "漕水东去远，送君多暮情。",
        "淹留野寺出，向背孤山明。",
        "前望数千里，中无蒲稗生。",
        "夕阳满舟楫，但爱微波清。",
        "举酒林月上，解衣沙鸟鸣。",
        "夜来莲花界，梦里金陵城。",
        "叹息此离别，悠悠江海行。"
      ],
      "author": {
        "id": 2684,
        "name": "李颀"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 339003,
      "title": "不调归东川别业",
      "content": [
        "寸禄言可取，托身将见遗。",
        "惭无匹夫志，悔与名山辞。",
        "绂冕谢知己，林园多后时。",
        "葛巾方濯足，蔬食但垂帷。",
        "十室对河岸，渔樵祗在兹。",
        "青郊香杜若，白水映茅茨。",
        "昼景彻云树，夕阴澄古逵。",
        "渚花独开晚，田鹤静飞迟。",
        "且复乐生事，前贤为我师。",
        "清歌聊鼓楫，永日望佳期。"
      ],
      "author": {
        "id": 2684,
        "name": "李颀"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 339007,
      "title": "无尽上人东林禅居",
      "content": [
        "草堂每多暇，时谒山僧门。",
        "所对但群木，终朝无一言。",
        "我心爱流水，此地临清源。",
        "含吐山上日，蔽亏松外村。",
        "孤峰隔身世，百衲老寒暄。",
        "禅户积朝雪，花龛来暮猿。",
        "顾余守耕稼，十载隐田园。",
        "萝筱慰舂汲，岩潭恣讨论。",
        "泄云岂知限，至道莫探元。",
        "且愿启关锁，于焉微尚存。"
      ],
      "author": {
        "id": 2684,
        "name": "李颀"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 339009,
      "title": "题卢道士房",
      "content": [
        "秋砧响落木，共坐茅君家。",
        "惟见两童子，林前汲井华。",
        "空坛静白日，神鼎飞丹砂。",
        "麈尾拂霜草，金铃摇霁霞。",
        "上章人世隔，看弈桐阴斜。",
        "稽首问仙要，黄精堪饵花。"
      ],
      "author": {
        "id": 2684,
        "name": "李颀"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 339010,
      "title": "题神力师院",
      "content": [
        "大师神杰貌，五岳森禅房。",
        "坚持日月珠，豁见沧江长。",
        "随病拔诸苦，致身如法王。",
        "阶庭药草遍，饭食天花香。",
        "树色向高阁，昼阴横半墙。",
        "每闻第一义，心净琉璃光。"
      ],
      "author": {
        "id": 2684,
        "name": "李颀"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 339014,
      "title": "题合欢",
      "content": [
        "开花复卷叶，艳眼又惊心。",
        "蝶绕西枝露，风披东干阴。",
        "黄衫漂细蕊，时拂女郎砧。"
      ],
      "author": {
        "id": 2684,
        "name": "李颀"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 339015,
      "title": "古从军行",
      "content": [
        "白日登山望烽火，黄昏饮马傍交河。",
        "行人刁斗风沙暗，",
        "胡雁哀鸣夜夜飞，胡儿眼泪双双落。",
        "闻道玉门犹被遮，"
      ],
      "author": {
        "id": 2684,
        "name": "李颀"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 339016,
      "title": "行路难",
      "content": [
        "汉家名臣杨德祖，四代五公享茅土。",
        "父子兄弟绾银黄，",
        "宾客填街复满座，片言出口生辉光。",
        "世人逐势争奔走，",
        "一朝谢病还乡里，穷巷苍苔绝知己。",
        "秋风落叶闭重门，",
        "鲁连所以蹈东海，古往今来称达人。"
      ],
      "author": {
        "id": 2684,
        "name": "李颀"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 339017,
      "title": "缓歌行",
      "content": [
        "小来托身攀贵游，倾财破产无所忧。",
        "暮拟经过石渠署，",
        "一沉一浮会有时，弃我翻然如脱屣。",
        "男儿立身须自强，",
        "二八蛾眉梳堕马，美酒清歌曲房下。",
        "文昌宫中赐锦衣，",
        "早知今日读书是，悔作从前任侠非。"
      ],
      "author": {
        "id": 2684,
        "name": "李颀"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 339018,
      "title": "琴歌",
      "content": [
        "主人有酒欢今夕，请奏鸣琴广陵客。",
        "月照城头乌半飞，",
        "一声已动物皆静，四座无言星欲稀。",
        "清淮奉使千余里，"
      ],
      "author": {
        "id": 2684,
        "name": "李颀"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 339019,
      "title": "放歌行答从弟墨卿",
      "content": [
        "小来好文耻学武，世上功名不解取。",
        "虽沾寸禄已后时，",
        "敛迹俯眉心自甘，高歌击节声半苦。",
        "由是蹉跎一老夫，",
        "徒尔当年声籍籍，滥作词林两京客。",
        "故人斗酒安陵桥，",
        "兴来逸气如涛涌，千里长江归海时。",
        "别离短景何萧索，"
      ],
      "author": {
        "id": 2684,
        "name": "李颀"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 339020,
      "title": "王母歌",
      "content": [
        "武皇斋戒承华殿，端拱须臾王母见。",
        "霓旌照耀麒麟车，",
        "头上复戴九星冠，总领玉童坐南面。",
        "欲闻要言今告汝，",
        "顾谓侍女董双成，酒阑可奏云和笙。",
        "红霞白日俨不动，",
        "复道歌钟杳将暮，深宫桃李花成雪。",
        "为看青玉五枝灯，"
      ],
      "author": {
        "id": 2684,
        "name": "李颀"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 339021,
      "title": "鲛人歌",
      "content": [
        "鲛人潜织水底居，侧身上下随游鱼。",
        "轻绡文彩不可识，",
        "泣珠报恩君莫辞，今年相见明年期。",
        "始知万族无不有，"
      ],
      "author": {
        "id": 2684,
        "name": "李颀"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 339022,
      "title": "夏宴张兵曹东堂",
      "content": [
        "重林华屋堪避暑，况乃烹鲜会佳客。",
        "主人三十朝大夫，",
        "羽扇摇风却珠汗，玉盆贮水割甘瓜。",
        "云峰峨峨自冰雪，"
      ],
      "author": {
        "id": 2684,
        "name": "李颀"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 339023,
      "title": "同张员外諲酬答之作",
      "content": [
        "洛中高士日沉冥，手自灌园方带经。",
        "王湛床头见周易，",
        "清言只到卫家儿，用笔能夸钟太尉。",
        "东篱二月种兰荪，"
      ],
      "author": {
        "id": 2684,
        "name": "李颀"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 339024,
      "title": "欲之新乡答崔颢綦毋潜",
      "content": [
        "数年作吏家屡空，谁道黑头成老翁。",
        "男儿在世无产业，",
        "铜炉将炙相欢饮，星宿纵横露华白。",
        "寒风卷叶度滹沱，",
        "明朝东路把君手，腊日辞君期岁首。",
        "自知寂寞无去思，"
      ],
      "author": {
        "id": 2684,
        "name": "李颀"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 339025,
      "title": "答高三十五留别便呈于十一",
      "content": [
        "累荐贤良皆不就，家近陈留访耆旧。",
        "韩康虽复在人间，",
        "妻子欢同五株柳，云山老对一床书。",
        "昨日公车见三事，",
        "散诞由来自不羁，低头授职尔何为。",
        "故园壁挂乌纱帽，",
        "藜羹被褐环堵中，岁晚将贻故人耻。"
      ],
      "author": {
        "id": 2684,
        "name": "李颀"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 339026,
      "title": "送康洽入京进乐府歌",
      "content": [
        "识子十年何不遇，只爱欢游两京路。",
        "朝吟左氏娇女篇，",
        "柳色偏浓九华殿，莺声醉杀五陵儿。",
        "曳裾此日从何所，",
        "新诗乐府唱堪愁，御妓应传𫛛鹊楼。",
        "西上虽因长公主，"
      ],
      "author": {
        "id": 2684,
        "name": "李颀"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 339027,
      "title": "送刘十",
      "content": [
        "三十不官亦不娶，时人焉识道高下。",
        "房中唯有老氏经，",
        "西林独鹤引闲步，南涧飞泉清角巾。",
        "前年上书不得意，",
        "烹葵摘果告我行，落日夏云纵复横。",
        "闻道谢安掩口笑，"
      ],
      "author": {
        "id": 2684,
        "name": "李颀"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 339028,
      "title": "送王道士还山",
      "content": [
        "嵩阳道士餐柏实，居处三花对石室。",
        "心穷伏火阳精丹，",
        "出入彤庭佩金印，承恩赫赫如王侯。",
        "双峰树下曾受业，",
        "玉膏清泠瀑泉水，白云溪中日方此。",
        "后今不见数十年，",
        "当有岩前白蝙蝠，迎君日暮双来飞。"
      ],
      "author": {
        "id": 2684,
        "name": "李颀"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 339029,
      "title": "别梁锽",
      "content": [
        "梁生倜傥心不羁，途穷气盖长安儿。",
        "回头转眄似雕鹗，",
        "抗辞请刃诛部曲，作色论兵犯二帅。",
        "一言不合龙额侯，",
        "庭中犊鼻昔尝挂，怀里琅玕今在无。",
        "时人见子多落魄，",
        "洛阳城头晓霜白，层冰峨峨满川泽。",
        "但闻行路吟新诗，",
        "莫言富贵长可托，木槿朝看暮还落。",
        "不见古时塞上翁，"
      ],
      "author": {
        "id": 2684,
        "name": "李颀"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 339030,
      "title": "送从弟游江淮兼谒鄱阳刘太守",
      "content": [
        "都门柳色朝朝新，念尔今为江上人。",
        "穆陵关带清风远，"
      ],
      "author": {
        "id": 2684,
        "name": "李颀"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 339031,
      "title": "双笋歌送李回兼呈刘四",
      "content": [
        "并抽新笋色渐绿，迥出空林双碧玉。",
        "春风解箨雨润根，",
        "再三抱此怅为别，嵩洛故人与之说。"
      ],
      "author": {
        "id": 2684,
        "name": "李颀"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 339032,
      "title": "送刘四赴夏县",
      "content": [
        "九霄特立红鸾姿，万仞孤生玉树枝。",
        "刘侯致身能若此，",
        "举世皆亲丞相阁，我心独爱伊川水。",
        "脱略势利犹埃尘，",
        "明主拜官麒麟阁，光车骏马看玉童。",
        "高人往来庐山远，",
        "赤县繁词满剧曹，白云孤峰晖永日。",
        "朝持手板望飞鸟，",
        "端坐讼庭更无事，开门咫尺巫咸山。",
        "男耕女织蒙惠化，",
        "闻道桐乡有遗老，邑中还欲置生祠。"
      ],
      "author": {
        "id": 2684,
        "name": "李颀"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 339033,
      "title": "少室雪晴送王宁",
      "content": [
        "少室众峰几峰别，一峰晴见一峰雪。",
        "隔城半山连青松，",
        "行人与我玩幽境，北风切切吹衣冷。",
        "惜别浮桥驻马时，"
      ],
      "author": {
        "id": 2684,
        "name": "李颀"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 339034,
      "title": "送陈章甫",
      "content": [
        "四月南风大麦黄，枣花未落桐阴长。",
        "青山朝别暮还见，",
        "腹中贮书一万卷，不肯低头在草莽。",
        "东门酤酒饮我曹，",
        "长河浪头连天黑，津口停舟渡不得。",
        "郑国游人未及家，"
      ],
      "author": {
        "id": 2684,
        "name": "李颀"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 339035,
      "title": "听安万善吹觱篥歌",
      "content": [
        "南山截竹为觱篥，此乐本自龟兹出。",
        "流传汉地曲转奇，",
        "世人解听不解赏，长飙风中自来往。",
        "枯桑老柏寒飕飗，",
        "忽然更作渔阳掺，黄云萧条白日暗。",
        "变调如闻杨柳春，"
      ],
      "author": {
        "id": 2684,
        "name": "李颀"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 339036,
      "title": "魏仓曹东堂柽树",
      "content": [
        "爱君双柽一树奇，千叶齐生万叶垂。",
        "长头拂石带烟雨，",
        "洛阳墨客游云间，若到麻源第三谷。"
      ],
      "author": {
        "id": 2684,
        "name": "李颀"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 339037,
      "title": "照公院双橙",
      "content": [
        "种橙夹阶生得地，细叶隔帘见双翠。",
        "抽条向长未及肩，",
        "永愿香炉洒甘露，夕阳时映东枝斜。",
        "南庭黄竹尔不敌，"
      ],
      "author": {
        "id": 2684,
        "name": "李颀"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 339038,
      "title": "爱敬寺古藤歌",
      "content": [
        "古藤池水盘树根，左攫右拏龙虎蹲。",
        "横空直上相陵突，",
        "空庭落叶乍开合，十月苦寒常倒垂。",
        "忆昨花飞满空殿，"
      ],
      "author": {
        "id": 2684,
        "name": "李颀"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 339039,
      "title": "崔五六图屏风各赋一物得乌孙佩刀",
      "content": [
        "乌孙腰间佩两刀，刃可吹毛锦为带。",
        "握中枕宿穹庐室，",
        "磨用阴山一片玉，洗将胡地独流泉。",
        "主人屏风写奇状，"
      ],
      "author": {
        "id": 2684,
        "name": "李颀"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 339040,
      "title": "古意",
      "content": [
        "男儿事长征，少小幽燕客。",
        "赌胜马蹄下，由来轻七尺。",
        "杀人莫敢前，须如猬毛磔。",
        "黄云陇底白雪飞，",
        "今为羌笛出塞声，使我三军泪如雨。"
      ],
      "author": {
        "id": 2684,
        "name": "李颀"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 339041,
      "title": "采莲",
      "content": [
        "越溪女，越溪莲。",
        "齐菡萏，双婵娟。",
        "嬉游向何处，"
      ],
      "author": {
        "id": 2684,
        "name": "李颀"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 339042,
      "title": "杂兴",
      "content": [
        "沉沉牛渚矶，旧说多灵怪。",
        "行人夜秉生犀烛，",
        "波惊海若潜幽石，龙抱胡髯卧黑泉。",
        "水滨丈人曾有语，",
        "青青兰艾本殊香，察见泉鱼固不祥。",
        "济水自清河自浊，",
        "善恶死生齐一贯，只应斗酒任苍苍。"
      ],
      "author": {
        "id": 2684,
        "name": "李颀"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 339043,
      "title": "绝缨歌",
      "content": [
        "楚王宴客章华台，章华美人善歌舞。",
        "玉颜艳艳空相向，",
        "宁爱贤，不爱色，青娥买死谁能识，果却一军全社稷。"
      ],
      "author": {
        "id": 2684,
        "name": "李颀"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 339044,
      "title": "郑樱桃歌",
      "content": [
        "石季龙，僭天禄，擅雄豪，美人姓郑名樱桃。",
        "樱桃美颜香且泽，娥娥侍寝专宫掖。",
        "后庭卷衣三万人，",
        "织成花映红纶巾，红旗掣曳卤簿新。",
        "鸣鼙走马接飞鸟，",
        "自言富贵不可量，女为公主男为王。",
        "赤花双簟珊瑚床，",
        "邺城苍苍白露微，世事翻覆黄云飞。"
      ],
      "author": {
        "id": 2684,
        "name": "李颀"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 339045,
      "title": "送刘昱",
      "content": [
        "八月寒苇花，秋江浪头白。",
        "北风吹五两，谁是浔阳客。",
        "鸬鹚山头微雨晴，扬州郭里暮潮生。",
        "行人夜宿金陵渚，"
      ],
      "author": {
        "id": 2684,
        "name": "李颀"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 339046,
      "title": "送郝判官",
      "content": [
        "楚城木叶落，夏口青山遍。",
        "鸿雁向南时，君乘使者传。",
        "枫林带水驿，夜火明山县。",
        "千里送行人，蔡州如眼见。",
        "江连清汉东逶迤，遥望荆云相蔽亏。",
        "应问襄阳旧风俗，"
      ],
      "author": {
        "id": 2684,
        "name": "李颀"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 339047,
      "title": "送刘方平",
      "content": [
        "绮纨游上国，多作少年行。",
        "二十二词赋，惟君著美名。",
        "童颜且白皙，佩德如瑶琼。",
        "荀氏风流盛，胡家公子清。",
        "有才不偶谁之过，肯即藏锋事高卧。",
        "洛阳草色犹自春，",
        "别离斗酒心相许，落日青郊半微雨。",
        "请君骑马望西陵，"
      ],
      "author": {
        "id": 2684,
        "name": "李颀"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 339048,
      "title": "听董大弹胡笳声兼寄语弄房给事",
      "content": [
        "蔡女昔造胡笳声，一弹一十有八拍。",
        "胡人落泪沾边草，",
        "先拂商弦后角羽，四郊秋叶惊摵摵。",
        "董夫子，通神明，",
        "空山百鸟散还合，万里浮云阴且晴。",
        "嘶酸雏雁失群夜，",
        "乌孙部落家乡远，逻娑沙尘哀怨生。",
        "幽音变调忽飘洒，",
        "长安城连东掖垣，凤凰池对青琐门。",
        "高才脱略名与利，"
      ],
      "author": {
        "id": 2684,
        "name": "李颀"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 339049,
      "title": "弹棋歌",
      "content": [
        "崔侯善弹棋，巧妙尽于此。",
        "蓝田美玉清如砥，",
        "缘边度陇未可嘉，鸟跂星悬危复斜。",
        "回飙转指速飞电，",
        "一别常山道路遥，为余更作三五势。"
      ],
      "author": {
        "id": 2684,
        "name": "李颀"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 339050,
      "title": "送山阴姚丞携妓之任兼寄苏少府",
      "content": [
        "东风香草路，南客心容与。",
        "白皙吴王孙，青蛾柳家女。",
        "都门数骑出，河口片帆举。",
        "夜簟眠橘洲，春衫傍枫屿。",
        "山阴政简甚从容，到罢惟求物外踪。",
        "落日花边剡溪水，",
        "加餐共爱鲈鱼肥，醒酒仍怜甘蔗熟。",
        "知君练思本清新，"
      ],
      "author": {
        "id": 2684,
        "name": "李颀"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 339051,
      "title": "塞下曲",
      "content": [
        "少年学骑射，勇冠并州儿。",
        "直爱出身早，边功沙漠垂。",
        "戎鞭腰下插，羌笛雪中吹。",
        "膂力今应尽，将军犹未知。"
      ],
      "author": {
        "id": 2684,
        "name": "李颀"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 339053,
      "title": "宴陈十六楼",
      "content": [
        "西楼对金谷，此地古人心。",
        "白日落庭内，黄花生涧阴。",
        "四邻见疏木，万井度寒砧。",
        "石上题诗处，千年留至今。"
      ],
      "author": {
        "id": 2684,
        "name": "李颀"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    }
  ],
