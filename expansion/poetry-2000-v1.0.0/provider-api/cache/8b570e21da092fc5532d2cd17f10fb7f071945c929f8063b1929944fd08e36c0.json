{
  "data": [
    {
      "id": 206305,
      "title": "次韵文潜休沐不出二首  其二",
      "content": [
        "与世自少味，闭关非有心。",
        "戎葵一笑粲，露井百尺深。",
        "著书洒风雨，枯笔束如林。",
        "苏公叹妙墨，逼人太骎骎。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 206306,
      "title": "奉同子瞻韵寄定国",
      "content": [
        "风云开古镜，淮海熨冰纨。",
        "王孙醉短舞，罗袜步微澜。",
        "老骥心虽在，白鸥盟已寒。",
        "斯人气金玉，视世一鼠肝。",
        "南归脱虫蛊，入对随孔鸾。",
        "忽以口语去，鼓船下惊湍。",
        "收身薄冰释，置枕泰山安。",
        "后土花药丽，海门天水宽。",
        "伐木思我友，知人良独难。",
        "遥怜须鬓绿，犹复耐悲欢。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206307,
      "title": "次韵王定国扬州见寄",
      "content": [
        "清洛思君昼夜流，北归何日片帆收。",
        "未生白发犹堪酒，垂上青云却佐州。",
        "飞雪堆盘鲙鱼腹，明珠论斗煮鸡头。",
        "平生行乐自不恶，岂有竹西歌吹愁。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 206308,
      "title": "往岁过广陵值早春尝作诗云春风十里珠帘卷仿佛三生杜牧之红药梢头初茧栗扬州风物鬓成丝今春有自淮南来者道扬州事戏以前韵寄王定国二首  其一",
      "content": [
        "淮南二十四桥月，马上时时梦见之。",
        "想得扬州醉年少，正围红袖写乌丝。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206309,
      "title": "往岁过广陵值早春尝作诗云春风十里珠帘卷仿佛三生杜牧之红药梢头初茧栗扬州风物鬓成丝今春有自淮南来者道扬州事戏以前韵寄王定国二首  其二",
      "content": [
        "日边置论诚深矣，圣处时中乃得之。",
        "莫作秋虫促机杼，贫家能有几絇丝。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206310,
      "title": "次韵钱穆父赠松扇",
      "content": [
        "银钩玉唾明茧纸，松箑轻凉并送似。",
        "可怜远度帻沟娄，适堪今时褦襶子。",
        "丈人玉立气高寒，三韩持节见神山。",
        "合得安期不死药，使我蝉蜕尘埃间。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 206311,
      "title": "戏和文潜谢穆父松扇",
      "content": [
        "猩毛束笔鱼网纸，松柎织扇清相似。",
        "动摇怀袖风雨来，想见僧前落松子。",
        "张侯哦诗松韵寒，六月火云蒸肉山。",
        "持赠小君聊一笑，不须射雉彀黄间。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 206312,
      "title": "谢郑闳中惠高丽画扇二首  其一",
      "content": [
        "会稽内史三韩扇，分送黄门画省中。",
        "海外人烟来眼界，全胜博物注鱼虫。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206313,
      "title": "谢郑闳中惠高丽画扇二首  其二",
      "content": [
        "苹汀游女能骑马，传道蛾眉画不如。",
        "宝扇真成集陈隼，史臣今得杀青书。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206314,
      "title": "次韵王炳之惠玉版纸",
      "content": [
        "王侯须若缘坡竹，哦诗清风起空谷。",
        "古田小纸惠我百，信知溪翁能解玉。",
        "鸣踸千杵动秋山，裹粮万里来辇毂。",
        "儒林丈人有苏公，相如子云再生蜀。",
        "往时翰墨颇横流，此公归来有边幅。",
        "小楷多传乐毅论，高词欲奏云门曲。",
        "不持去扫苏公门，乃令小人今拜辱。",
        "去骚甚远文气卑，画虎不成书势俗。",
        "董狐南史一笔无，误掌杀青司记录。",
        "虽然此中有公议，或辱五鼎荣半菽。",
        "愿公进德使见书，不敢求公米千斛。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206315,
      "title": "谢王炳之惠石香鼎",
      "content": [
        "薰炉宜小寝，鼎制琢晴岚。",
        "香润云生础，烟明虹贯岩。",
        "法从空处起，人向鼻头参。",
        "一炷听秋雨，何时许对谈。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 206316,
      "title": "次韵柳通叟寄王文通",
      "content": [
        "故人昔有凌云赋，何意陆沈黄绶间。",
        "头白眼花行作吏，儿婚女嫁望还山。",
        "心犹未死杯中物，春不能朱镜里颜。",
        "寄语诸公肯湔祓，割鸡今得近乡关。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 206317,
      "title": "送张天觉得登字",
      "content": [
        "张侯起巴渝，翼若垂天鹏。",
        "历诋汉诸公，霜风拂觚棱。",
        "去国行万里，淡如云水僧。",
        "归来头亦白，小试不尽能。",
        "湖海尚豪气，有人议陈登。",
        "持节三晋邦，典刑寄哀矜。",
        "公家有闲日，禅窟问香灯。",
        "因来叙行李，斩寄老崖藤。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206318,
      "title": "次韵徐文将至国门见寄二首  其一",
      "content": [
        "槐催举子著花黄，来食邯郸道上粱。",
        "便欲扫床悬麈尾，正愁喘月似灯光。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206319,
      "title": "次韵徐文将至国门见寄二首  其二",
      "content": [
        "千头剖蚌明珠熟，百尺垂丝鲙缕长。",
        "柳下石门君有此，可能冲雪厌清凉。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206320,
      "title": "博士王扬休碾密云龙同事十三人饮之戏作",
      "content": [
        "矞云苍璧小盘龙，贡包新样出元丰。",
        "王郎坦腹饭床东，大官分物来妇翁。",
        "棘围深锁武成宫，谈天进士雕虚空。",
        "鸣鸠欲雨唤雌雄，南岭北岭宫征同。",
        "午窗欲眠视蒙蒙，喜君开包碾春风，注汤官焙香出笼。",
        "非君灌顶甘露椀，几为谈天干舌本。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206321,
      "title": "答黄冕仲索煎双井并简扬休",
      "content": [
        "江夏无双乃吾宗，同舍颇似王安丰。",
        "能浇茗椀湔祓我，风袂欲挹浮丘翁。",
        "吾宗落笔赏幽事，秋月下照澄江空。",
        "家山鹰爪是小草，敢与好赐云龙同。",
        "不嫌水厄幸来辱，寒泉汤鼎听松风，夜堂朱墨小灯笼。",
        "惜无纤纤来捧椀，惟倚新诗可传本。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206322,
      "title": "再答冕仲",
      "content": [
        "丘壑诗书虽数穷，田园芋栗颇时丰。",
        "小桃源口雨繁红，春溪蒲稗没凫翁。",
        "投身世网梦归去，摘山鼓声雷隠空。",
        "秋堂一笑共灯火，与公草木臭味同。",
        "安用茗浇垒块胸，他日过饭随家风，买鱼贯柳鸡著笼。",
        "更当力贫开酒椀，走谒邻翁称子本。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206323,
      "title": "戏答陈元舆",
      "content": [
        "平生所闻陈汀州，蝗不入境年屡丰。",
        "东门拜书始识面，鬓发幸未成老翁。",
        "官饔同盘厌腥腻，茶瓯破睡秋堂空。",
        "自言不复娥眉梦，枯淡颇与小人同。",
        "但忧迎笑花枝红，夜窗冷雨打斜风，秋衣沉水换薰笼。",
        "银屏宛转复宛转，意根难拔如薤本。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206324,
      "title": "再答元舆",
      "content": [
        "君不能入身帝城结子公，又不能击强有如诸葛丰。",
        "法当顦顇百僚底，五十天涯一秃翁。",
        "问君何自今为郎，便殿作赋声摩空。",
        "偶然樽酒相劳苦，牛铎调与黄钟同。",
        "安得朱轓各凭熊，江南楼阁白苹风，劝归啼鸟晓窗笼。",
        "男儿邂逅功补衮，鸟倦归巢叶归本。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206325,
      "title": "次韵冕仲考进士试卷",
      "content": [
        "少年迷翰墨，无异虫蠹木。",
        "诸生程艺文，承诏当品目。",
        "床敷设箱篚，赋纳忽数束。",
        "变名混甲乙，誊写失句读。",
        "昼窗过白驹，夜几跋红烛。",
        "钩深思嘉鱼，攻璞愿良玉。",
        "谈天用一律，呻讯压重复。",
        "丝布涩难缝，快意忽破竹。",
        "圣言裨曲学，割衮缀邪幅。",
        "注金无全巧，窃发或中鹄。",
        "翟公辟廱老，薪槱茂棫朴。",
        "御史威降霜，行私不容粟。",
        "吏部提英鉴，片善蒙采录。",
        "博士刈其楚，铨量颇三复。",
        "因人享成事，贱子真碌碌。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206326,
      "title": "王圣美三子补中广文生",
      "content": [
        "王家人物从来远，今见诸孙总好贤。",
        "三级定知鱼尾进，一鸣已作雁行连。",
        "愧无藻鉴能推毂，愿卷囊书当赠钱。",
        "归去雄夸向儿姪，舍中犊子賸狂颠。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 206327,
      "title": "次韵游景叔闻洮河捷报寄诸将四首  其一",
      "content": [
        "千仞溪中石转雷，汉家万骑捣虚回。",
        "定知献马胡雏入，看即称觞都护来。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206328,
      "title": "次韵游景叔闻洮河捷报寄诸将四首  其二",
      "content": [
        "中原日月九夷知，不用禽胡衅鼓旗。",
        "更向天阶舞干羽，降书剩破一年迟。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206329,
      "title": "次韵游景叔闻洮河捷报寄诸将四首  其三",
      "content": [
        "汉得洮州箭有神，斩关禽敌不逡巡。",
        "将军快上屯田计，要纳降胡十万人。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206330,
      "title": "次韵游景叔闻洮河捷报寄诸将四首  其四",
      "content": [
        "遥知一炬绝河津，生缚青宜不动尘。",
        "付与山河印如斗，忍为鼠子腹心人。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206331,
      "title": "和游景叔月报三捷",
      "content": [
        "汉家飞将用庙谋，复我匹夫匹妇雠。",
        "真成折箠禽胡月，不是黄榆牧马秋。",
        "幄中已断匈奴臂，军前可饮月氏头。",
        "愿见呼韩朝渭上，诸将不用万户侯。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 206332,
      "title": "次韵崔伯易席上所赋因以赠行二首  其一",
      "content": [
        "迎新与送故，渠已不胜勤。",
        "民卖腰间剑，公宽柱后文。",
        "诸郎投赐沐，高会惜临分。",
        "去国虽千里，分忧即近君。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 206333,
      "title": "次韵崔伯易席上所赋因以赠行二首  其二",
      "content": [
        "老惜交情别，追随车马勤。",
        "临朝思共理，治郡复斯文。",
        "讼息常休吏，民贫更劝分。",
        "西湖十顷月，自比汉封君。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 206334,
      "title": "同子瞻和赵伯充团练",
      "content": [
        "金玉堂中寂寞人，仙班时得共朝真。",
        "两宫无事安磐石，万国归心有老臣。",
        "家酿可供开口笑，侍儿工作捧心颦。",
        "醉乡乃是安身处，付与升平作幸民。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 206335,
      "title": "戏答赵伯充劝莫学书及为席子泽解嘲",
      "content": [
        "平生饮酒不尽味，五鼎餽肉如嚼蜡。",
        "我醉欲眠便遣客，三年窥墙亦面壁。",
        "空余小来翰墨场，松烟兔颖傍明窗。",
        "偶随儿戏洒墨汁，众人许在崔杜行。",
        "晚学长沙小三昧，幻出万物真成狂。",
        "龙蛇起陆雷破柱，自喜奇观绕绳床。",
        "家人骂笑宁有道，污染黄素败粉墙。",
        "诚不如南邻席明府，蛛网锁砚蜗书梁。",
        "怀中探丸起九死，才术颇似汉太仓。",
        "感君诗句唤梦觉，邯郸初未熟黄粱。",
        "身如朝露无牢强，翫此白驹过隙光。",
        "从此永明书百卷，自公退食一炉香。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206336,
      "title": "谢景叔惠冬笋雍酥水梨三物",
      "content": [
        "玉人怜我长蔬食，走送厨珍自不尝。",
        "秦牛肥腻酥胜雪，汉苑甘泉梨得霜。",
        "冰底斲春生笋束，豹文解箨馔寒玉。",
        "见他桃李忆故园，馋獠应残遶窗竹。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 206337,
      "title": "再答景叔",
      "content": [
        "女三为粲当献王，三珍同盘乃得尝。",
        "甘泉下浇藜苋肠，令我诗句挟风霜。",
        "小人食珍敢取足，都城一饭炊白玉。",
        "赐钱千万民犹饥，雪后排簷冻银竹。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 206338,
      "title": "次韵几复和答所寄",
      "content": [
        "海南海北梦不到，会合乃非人力能。",
        "地褊未堪长袖舞，夜寒空对短檠灯。",
        "相看鬓发时窥镜，曾共诗书更曲肱。",
        "作个生涯终未是，故山松长到天藤。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 206339,
      "title": "寄上叔父夷仲三首  其一",
      "content": [
        "少年有功翰墨林，中岁作吏几陆沉。",
        "庖丁解牛妙世故，监市履狶知民心。",
        "万里书来儿女瘦，十月山行冰雪深。",
        "梦魂和月绕秦陇，汉节落毛何处寻。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 206340,
      "title": "寄上叔父夷仲三首  其二",
      "content": [
        "艰难闻道有归音，部曲霜行璧月沉。",
        "王春正月调玉烛，使星万里朝天心。",
        "颇令山海藏国用，乃见县官恤民深。",
        "经心陇蜀封疆守，必有人材备访寻。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 206341,
      "title": "寄上叔父夷仲三首  其三",
      "content": [
        "关寒塞雪欲嗣音，燕雁拂天河鲤沉。",
        "百书不如一见面，几日归来两慰心。",
        "弓刀陌上望行色，儿女灯前语夜深。",
        "更怀父子东归得，手种江头柳十寻。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 206342,
      "title": "考试局与孙元忠博士竹间对窗夜闻元忠诵书声调悲壮戏作竹枝歌三章和之  其一",
      "content": [
        "南窗读书声吾伊，北窗见月歌竹枝。",
        "我家白发问乌鹊，他家红妆占蛛丝。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206343,
      "title": "考试局与孙元忠博士竹间对窗夜闻元忠诵书声调悲壮戏作竹枝歌三章和之  其二",
      "content": [
        "屋山啼乌儿当归，玉钗罥蛛郎马嘶。",
        "去时灯火正月半，阶前雪消萱草齐。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206344,
      "title": "考试局与孙元忠博士竹间对窗夜闻元忠诵书声调悲壮戏作竹枝歌三章和之  其三",
      "content": [
        "勃姑夫妇喜相唤，街头雪泥即渐干。",
        "已放游丝高百尺，不应桃李尚春寒。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206345,
      "title": "观伯时画马",
      "content": [
        "仪鸾供帐饕虱行，翰林湿薪爆竹声，风帘官烛泪纵横。",
        "木穿石槃未渠透，坐窗不遨令人瘦，贫马百藖逢一豆。",
        "眼明见此玉花骢，径思著鞭随诗翁，城西野桃寻小红。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206346,
      "title": "题伯时画揩痒虎",
      "content": [
        "猛虎肉醉初醒时，揩磨苛痒风助威。",
        "枯楠未觉草先低，木末应有行人知。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206347,
      "title": "题伯时画观鱼僧",
      "content": [
        "横波一网腥城市，日暮江空烟水寒。",
        "当时万事心已死，犹恐鱼作故时看。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206348,
      "title": "题伯时画顿尘马",
      "content": [
        "竹头抢地风不举，文书堆案睡自语。",
        "忽看高马顿风尘，亦思归家洗袍袴。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206349,
      "title": "题伯时画严子陵钓滩",
      "content": [
        "平生久要刘文叔，不肯为渠作三公。",
        "能令汉家重九鼎，桐江波上一丝风。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206350,
      "title": "题伯时画松下渊明",
      "content": [
        "南渡诚草草，长沙慰艰难。",
        "终风霾八表，半夜失前山。",
        "远公香火社，遗民文字禅。",
        "虽非老翁事，幽尚亦可观。",
        "松风自度曲，我琴不须弹。",
        "客来欲开说，觞至不得言。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206351,
      "title": "出礼部试院王才元惠梅花三种皆妙绝戏答三首  其一",
      "content": [
        "城南名士遣春来，三月乃见腊前梅。",
        "定知锁著江南客，故放绿阴春晚回。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206352,
      "title": "出礼部试院王才元惠梅花三种皆妙绝戏答三首  其二",
      "content": [
        "舍人梅坞无关锁，携酒俗人来未曾。",
        "旧时爱菊陶彭泽，今作梅花树下僧。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206353,
      "title": "出礼部试院王才元惠梅花三种皆妙绝戏答三首  其三",
      "content": [
        "病夫中岁屏杯杓，百叶缃梅触拨人。",
        "拂杀官黄春有思，满城桃李不能春。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206354,
      "title": "王立之承奉诗报梅花已落尽次韵戏答",
      "content": [
        "南枝北枝春事休，榆钱可穿柳带柔。",
        "定是沈郎作诗瘦，不应春能生许愁。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206355,
      "title": "乞姚花二首  其一",
      "content": [
        "正是风光嬾困时，姚黄开晚落应迟。",
        "欲雕好句乞春色，日历如山不到诗。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206356,
      "title": "乞姚花二首  其二",
      "content": [
        "青春日月鸟飞过，汗简文书山叠重。",
        "乞取好花天上看，宫衣黄带御炉烘。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206357,
      "title": "效王仲至少监咏姚花用其韵四首  其一",
      "content": [
        "映日低风整复斜，绿玉眉心黄袖遮。",
        "大梁城里虽罕见，心知不是牛家花。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206358,
      "title": "效王仲至少监咏姚花用其韵四首  其二",
      "content": [
        "九疑山中萼绿华，黄云承袜到羊家。",
        "真筌虫蚀诗句断，犹托余情开此花。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206359,
      "title": "效王仲至少监咏姚花用其韵四首  其三",
      "content": [
        "仙衣襞积驾黄鹄，草木无光一笑开。",
        "人间风日不可奈，故待成阴叶下来。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206360,
      "title": "效王仲至少监咏姚花用其韵四首  其四",
      "content": [
        "汤沐冰肌照春色，海牛压帘风不开。",
        "直言红尘无路入，犹傍蜂须蝶翅来。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206361,
      "title": "寄杜家父二首  其一",
      "content": [
        "红紫争春触处开，九衢终日犊车雷。",
        "闲情欲被春将去，鸟唤花惊只么回。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206362,
      "title": "寄杜家父二首  其二",
      "content": [
        "风尘点污青春面，自汲寒泉洗醉红。",
        "径欲题诗嫌浪许，杜郎觅句有新功。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206363,
      "title": "王才元舍人许牡丹求诗",
      "content": [
        "闻道潜溪千叶紫，主人不剪要题诗。",
        "欲搜佳句恐春老，试遣七言赊一枝。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206364,
      "title": "谢王舍人剪送状元红",
      "content": [
        "清香拂袖剪来红，似绕名园晓露丛。",
        "欲作短章凭阿素，缓歌夸与落花风。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206365,
      "title": "戏答陈季常寄黄州山中连理松枝二首  其一",
      "content": [
        "故人折松寄千里，想听万壑风泉音。",
        "谁言五鬣苍烟面，犹作人间儿女心。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206366,
      "title": "戏答陈季常寄黄州山中连理松枝二首  其二",
      "content": [
        "老松连枝亦偶然，红紫事退独参天。",
        "金沙滩头锁子骨，不妨随俗暂婵娟。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206367,
      "title": "次韵子瞻送李廌",
      "content": [
        "骥子堕地追风日，未试千里谁能识。",
        "习之实录葬皇祖，斯文如女有正色。",
        "今年持橐佐春官，遂失此人难塞责。",
        "虽然一哄有奇偶，博悬于投不在德。",
        "君看巨浸朝百川，此岂有意潢潦前。",
        "愿为雾豹怀文隠，莫爱风蝉蜕骨仙。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206368,
      "title": "次韵宋懋宗三月十四日到西池都人盛观翰林公出遨",
      "content": [
        "金狨系马晓鶑边，不比春江上水船。",
        "人语车声喧法曲，花光楼影倒晴天。",
        "人间化鹤三千岁，海上看羊十九年。",
        "还作遨头惊俗眼，风流文物属苏仙。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 206369,
      "title": "韩献肃公挽词三首  其一",
      "content": [
        "鬰鬰高阳里，生才世不孤。",
        "八龙归月旦，三凤继天衢。",
        "梁坏吾安仰，人亡道固癯。",
        "空令湖海士，愁绝奠生刍。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 206370,
      "title": "韩献肃公挽词三首  其二",
      "content": [
        "物产原希世，风流更折冲。",
        "决疑京兆尹，富国大司农。",
        "远业终三事，仁声达九宗。",
        "方祈酌周斗，何意辍秦舂。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 206371,
      "title": "韩献肃公挽词三首  其三",
      "content": [
        "泪尽才难日，斯人遽陨倾。",
        "冰枝忧木稼，食昴恨长庚。",
        "名与具茨重，心如颍水清。",
        "堂堂万夫表，直作闭佳城。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 206372,
      "title": "次韵子瞻以红带寄王宣义",
      "content": [
        "参军但有四立壁，初无临江千木奴。",
        "白头不是折腰具，桐帽棕鞋称老夫。",
        "沧江鸥鹭野心性，阴壑虎豹雄牙须。",
        "鹔鷞作裘初服在，猩血染带邻翁无。",
        "昨来杜鹃劝归去，更待把酒听提壶。",
        "当今人材不乏使，天上二老须人扶。",
        "儿无饱饭尚勤书，妇无复裈且著襦。",
        "社瓮可漉溪可渔，更问黄鸡肥与癯。",
        "林间醉著人伐木，犹梦官下闻追呼。",
        "万钉围腰莫爱渠，富贵安能润黄垆。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206373,
      "title": "听宋宗儒摘阮歌",
      "content": [
        "翰林尚书宋公子，文采风流今尚尔。",
        "自疑耆域是前身，囊中探丸起人死。",
        "貌如千岁枯松枝，落魄酒中无定止。",
        "得钱百万送酒家，一笑不问今余几。",
        "手挥琵琶送飞鸿，促弦聒醉惊客起。",
        "寒虫催织月笼秋，独雁叫群天拍水。",
        "楚国羁臣放十年，汉宫佳人嫁千里。",
        "深闺洞房语恩怨，紫燕黄鹂韵桃李。",
        "楚狂行歌惊市人，渔父拏舟在葭苇。",
        "问君枯木著朱绳，何能道人意中事。",
        "君言此物传数姓，玄璧庚庚有横理。",
        "闭门三月传国工，身今亲见阮仲容。",
        "我有江南一丘壑，安得与君醉其中，曲肱听君写松风。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206374,
      "title": "自门下后省归卧酺池寺观卢鸿草堂图",
      "content": [
        "黄尘逆帽马辟易，归来下帘卧书空。",
        "不知绣鞍万人立，何如卢郎驾飞鸿。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206375,
      "title": "题子瞻寺壁小山枯木二首  其一",
      "content": [
        "烂肠五斗对狱吏，白发千丈濯沧浪。",
        "却来献纳云台表，小山桂枝不相忘。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206376,
      "title": "题子瞻寺壁小山枯木二首  其二",
      "content": [
        "海内文章非画师，能回笔力作枯枝。",
        "豫章从小有梁栋，也似郑公双鬓丝。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206377,
      "title": "题子瞻枯木",
      "content": [
        "折冲儒墨阵堂堂，书入颜杨鸿雁行。",
        "胸中元自有丘壑，故作老木蟠风霜。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206378,
      "title": "和子瞻戏书伯时画好头赤",
      "content": [
        "李侯画骨不画肉，笔下马生如破竹。",
        "秦驹虽入天仗图，犹恐真龙在空谷。",
        "精神权奇汗沟赤，有头赤乌能逐日。",
        "安得身为汉都护，三十六城看历历。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 206379,
      "title": "咏伯时画太初所获大宛虎脊天马图",
      "content": [
        "笔端那有此，千里在胸中。",
        "四蹄雷电去，一顾马群空。",
        "谁能乘此物，超俗驾长风。",
        "逸材归辔勒，岁在执徐同。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 206380,
      "title": "咏伯时画冯奉世所获大宛象龙图",
      "content": [
        "上党良家子，挽强如屈肘。",
        "三十学春秋，岂为莎车首。",
        "谁言冯光禄，不如甘延寿。",
        "虽无千户封，乃得六龙友。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 206381,
      "title": "题竹石牧牛",
      "content": [
        "野次小峥嵘，幽篁相倚绿。",
        "阿童三尺箠，御此老觳觫。",
        "石吾甚爱之，勿遣牛砺角。",
        "牛砺角尚可，牛鬭残我竹。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 206382,
      "title": "题伯时天育骠骑图二首  其一",
      "content": [
        "玉花照夜今无种，枥上追风亦不传。",
        "想见真龙如此笔，蒺藜沙晚草迷川。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206383,
      "title": "题伯时天育骠骑图二首  其二",
      "content": [
        "明窗槃礴万物表，写出人间真乘黄。",
        "邂逅今身犹姓李，可非前世江都王。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206384,
      "title": "姨母李夫人墨竹二首  其一",
      "content": [
        "深闺静几试笔墨，白头腕中百斛力。",
        "荣荣枯枯皆本色，悬之高堂风动壁。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206385,
      "title": "姨母李夫人墨竹二首  其二",
      "content": [
        "小竹扶疏大竹枯，笔端真有造化炉。",
        "人间俗气一点无，健妇果胜大丈夫。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206386,
      "title": "次韵子瞻子由题憩寂图二首  其一",
      "content": [
        "松寒风雨石骨瘦，法窟寂寥僧定时。",
        "李侯有句不肯吐，淡墨写出无声诗。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206387,
      "title": "次韵子瞻子由题憩寂图二首  其二",
      "content": [
        "龙眠不似虎头痴，笔妙天机可并时。",
        "苏仙漱墨作苍石，应解种花开此诗。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206388,
      "title": "次韵答曹子方杂言",
      "content": [
        "酺池寺，汤餠一斋盂，曲肱懒著书。",
        "骑马天津看逝水，满船风月忆江湖。",
        "往时尽醉冷卿酒，侍儿琵琶春风手。",
        "竹间一夜鸟声春，明朝醉起雪塞门。",
        "当年闻说冷卿客，黄须邺下曹将军。",
        "挽弓石八不好武，读书卧看三峰云。",
        "谁怜相逢十载后，釜里生鱼甑生尘。",
        "冷卿白首大官寺，樽前不复如花人。",
        "曹将军，江湖之上可相忘，舂鉏对立鸳鸯双。",
        "无机与游不乱行，何时解缨濯沧浪。",
        "唤取张侯来平章，烹茶煮餠坐僧房。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206389,
      "title": "次韵子瞻和王子立风雨败书屋有感",
      "content": [
        "妇翁不可挝，王郎非娇客。",
        "十年为从学，苦淡共陻厄。",
        "燕雀嗤鸿渐，犬羊睨麟获。",
        "遇逢泾渭分，昨梦春冰释。",
        "平生五车书，才吐二三策。",
        "已作谤薰天，金朱果何益。",
        "君穷一窗下，风雨更削迹。",
        "诗工知学进，词苦见意迫。",
        "俗情傲秦赘，妇舍不煖席。",
        "南冶从东家，不闻被嘲剧。",
        "师儒并世难，日月过箭疾。",
        "公今未有田，把笔耕六籍。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206390,
      "title": "嘲小德",
      "content": [
        "中年举儿子，漫种老生涯。",
        "学语啭春鸟，涂窗行暮鸦。",
        "欲嗔王母惜，稍慧女兄夸。",
        "解著潜夫论，不妨无外家。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 206391,
      "title": "戏答张秘监馈羊",
      "content": [
        "细肋柔毛饱卧沙，烦公遣骑送寒家。",
        "忍令无罪充庖宰，留与儿童驾小车。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206392,
      "title": "戏答王定国题门两绝句  其一",
      "content": [
        "非复三五少年日，把酒偿春颊生红。",
        "白鸥入群颇相委，不谓惊起来宾鸿。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206393,
      "title": "戏答王定国题门两绝句  其二",
      "content": [
        "颇知歌舞无窍凿，我心块然如帝江。",
        "花里雄蜂雌蛱蝶，同时本自不作双。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206394,
      "title": "情人怨戏效徐庾慢体三首  其一",
      "content": [
        "秋水无言度，荷花称意红。",
        "主人敬爱客，催唤出房笼。",
        "一斛明珠曲，何时落塞鸿。",
        "莫藏春笋手，且为剥莲蓬。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 206395,
      "title": "情人怨戏效徐庾慢体三首  其二",
      "content": [
        "翡翠钗梁碧，石榴裙折红。",
        "隙光斜斗帐，香字冷薰笼。",
        "闻道西飞燕，将随北固鸿。",
        "鸳鸯会独宿，风雨打船蓬。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 206396,
      "title": "情人怨戏效徐庾慢体三首  其三",
      "content": [
        "障羞罗袂薄，承汗领巾红。",
        "晚风斜虿发，逸艳照窗笼。",
        "胡琴抱明月，宝瑟阵归鸿。",
        "倚壁生蛛网，年光如转蓬。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 206397,
      "title": "呈外舅孙莘老二首  其一",
      "content": [
        "九陌黄尘乌帽底，五湖春水白鸥前。",
        "扁舟不为鲈鱼去，收取声名四十年。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206398,
      "title": "呈外舅孙莘老二首  其二",
      "content": [
        "甓社湖中有明月，淮南草木借光辉。",
        "故应剖蚌登王府，不若行沙弄夕霏。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206399,
      "title": "以天坛灵寿杖送莘老",
      "content": [
        "王屋千霜老紫藤，扶公休沐对亲朋。",
        "异时驷马安车去，拄到天坛愿力能。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206400,
      "title": "戏答俞清老道人寒夜三首  其一",
      "content": [
        "索索叶自雨，月寒遥夜阑。",
        "马嘶车铎鸣，群动不遑安。",
        "有人梦超俗，去发脱儒冠。",
        "平明视清镜，正尔良独难。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 206401,
      "title": "戏答俞清老道人寒夜三首  其二",
      "content": [
        "闻道一稊米，出身缚簪缨。",
        "怀我伐木友，寒衾梦丁丁。",
        "富贵但如此，百年半曲肱。",
        "早晚相随去，松根有茯苓。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 206402,
      "title": "戏答俞清老道人寒夜三首  其三",
      "content": [
        "牧羊金华山，早通玉帝籍。",
        "至今风低草，𧥄𧥄见白石。",
        "金华风烟下，亦有君履迹。",
        "何为红尘里，颔须欲雪白。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 206403,
      "title": "秘书省冬夜宿直寄怀李德素",
      "content": [
        "曲肱惊梦寒，皎皎入牖下。",
        "出门问何祥，岑寂省中夜。",
        "姮娥携青女，一笑粲万瓦。",
        "怀我金玉人，幽独秉大雅。",
        "古来绝朱弦，盖为知音者。",
        "同床有不察，而况子在野。",
        "独立占少微，长怀何由写。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
