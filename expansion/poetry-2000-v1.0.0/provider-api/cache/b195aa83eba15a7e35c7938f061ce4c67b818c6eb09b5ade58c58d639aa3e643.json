{
  "data": [
    {
      "id": 93952,
      "title": "陪徐渊子使君登白雪楼约各赋一诗必以宋玉石对莫愁村",
      "content": [
        "楼名白雪因词胜，千古江山春雨余。",
        "宋玉遗踪两苍石，莫愁居处一荒墟。",
        "风横烟艇客呼渡，水落沙洲人网鱼。",
        "借问风流贤太守，孟亭添得野夫无。"
      ],
      "author": {
        "id": 2561,
        "name": "戴复古"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 94360,
      "title": "凌歊台",
      "content": [
        "几年听客话凌歊，不似台边目力遥。",
        "千古江山犹昨日，六宫歌舞自前朝。",
        "苔碑有字多漫灭，野寺无僧转寂寥。",
        "碧聚双蛾愁不敛，阑干落照重魂消。"
      ],
      "author": {
        "id": 7360,
        "name": "杜耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 106377,
      "title": "李宰和唐子西芙蓉溪诗索同赋",
      "content": [
        "子西诗律伤于严，掉头沉吟春饮酣。",
        "何曾一字低处著，有似国工精手谈。",
        "千古江山长媚好，水曹依旧清风扫。",
        "只慙次补较非才，更愿乞灵依此老。",
        "天涯憔悴一诗穷，溪流泯泯山丛丛。",
        "事须登临作酬赏，剩破酒榼官泥红。"
      ],
      "author": {
        "id": 6168,
        "name": "程公许"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 129590,
      "title": "过黄州和共山高寒韵",
      "content": [
        "千古江山一览间，老瞒于此胆曾寒。",
        "凭高要起乘风志，肯把闲情作鸭栏。"
      ],
      "author": {
        "id": 6149,
        "name": "李曾伯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 134725,
      "title": "东西二眺",
      "content": [
        "千古江山归雅量，犹今二眺有遗踪。",
        "要知当日经纶志，问取丹崖几树松。"
      ],
      "author": {
        "id": 770,
        "name": "释文珦"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 243621,
      "title": "翠光亭",
      "content": [
        "千古江山好树新，翠光亭上一伤春。",
        "碧波无尽愁无尽，留与今人复后人。"
      ],
      "author": {
        "id": 7409,
        "name": "滕宗谅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 317890,
      "title": "卜算子",
      "content": [
        "江横山簇。",
        "柏箭森如束。",
        "满眼飞蓬撩乱，知几几、未膏沐。",
        "快意忽破竹。",
        "一奁明翠玉。",
        "千古江山只么，人都道、为君绿。"
      ],
      "author": {
        "id": 6995,
        "name": "魏了翁"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 326530,
      "title": "永遇乐",
      "content": [
        "千古江山，英雄无觅，孙仲谋处。",
        "舞榭歌台，风流总被，雨打风吹去。",
        "斜阳草树，寻常巷陌，人道寄奴曾住。",
        "想当年，金戈铁马，气吞万里如虎。",
        "元嘉草草，封狼居胥，赢得仓皇北顾。",
        "四十三年，望中犹记，烽火扬州路。",
        "可堪回首，佛狸祠下，一片神鸦社鼓。",
        "凭谁问，廉颇老矣，尚能饭否。"
      ],
      "author": {
        "id": 8618,
        "name": "辛弃疾"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
