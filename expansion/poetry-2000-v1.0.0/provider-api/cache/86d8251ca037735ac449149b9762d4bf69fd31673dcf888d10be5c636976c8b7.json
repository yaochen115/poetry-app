{
  "data": [
    {
      "id": 298498,
      "title": "生查子 一",
      "content": [
        "侍女动妆匳，故故惊人睡。",
        "那知本未眠，背面偷垂泪。"
      ],
      "author": {
        "id": 5551,
        "name": "韩偓"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 298499,
      "title": "生查子 二",
      "content": [
        "嬾卸凤凰钗，羞入鸳鸯被。",
        "时复见残灯，和烟坠金穗。"
      ],
      "author": {
        "id": 5551,
        "name": "韩偓"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 298641,
      "title": "生查子 一",
      "content": [
        "春山烟欲收，天澹星稀小。",
        "残月脸边明，别泪临清晓。",
        "语已多，情未了，回首犹重道。",
        "记得绿罗帬，处处怜芳草。"
      ],
      "author": {
        "id": 838,
        "name": "牛希济"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298642,
      "title": "生查子 二",
      "content": [
        "新月曲如眉，未有团𪢮意。",
        "红豆不堪看，满眼相思泪。",
        "终日劈桃穰，人在心儿里。",
        "两朵隔墙花，早晚成连理。"
      ],
      "author": {
        "id": 838,
        "name": "牛希济"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 298738,
      "title": "生查子 一",
      "content": [
        "烟雨晚晴天，零落花无语。",
        "难话此时心，梁燕双来去。",
        "琴韵对薰风，有恨和情抚。",
        "肠断断弦频，泪滴黄金缕。"
      ],
      "author": {
        "id": 12827,
        "name": "魏承班"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 298739,
      "title": "生查子 二",
      "content": [
        "寂寞画堂空，深夜垂罗幕。",
        "灯暗锦屏欹，月冷珠帘薄。",
        "愁恨梦难成，何处贪欢乐。",
        "看看又春来，还是长萧索。"
      ],
      "author": {
        "id": 12827,
        "name": "魏承班"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 298740,
      "title": "生查子 三",
      "content": [
        "离别又经年，独对芳菲景。",
        "嫁得薄情夫，长抱相思病。",
        "花红柳绿间晴空，蝶舞双双影。",
        "羞看绣罗衣，为有金鸾竝。"
      ],
      "author": {
        "id": 12827,
        "name": "魏承班"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298902,
      "title": "生查子",
      "content": [
        "竟日画堂欢，入夜重开宴。",
        "翦烛蜡烟香，促席花光颤。",
        "待得月华来，满院如铺练。",
        "门外簇骅骝，直待更深散。"
      ],
      "author": {
        "id": 3004,
        "name": "欧阳彬"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 298949,
      "title": "生查子 一",
      "content": [
        "寂寞掩朱门，正是天将暮。",
        "暗澹小庭中，滴滴梧桐雨。",
        "绣工夫，牵心绪，配尽鸳鸯缕。",
        "待得没人时，偎倚论私语。"
      ],
      "author": {
        "id": 12232,
        "name": "孙光宪"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298950,
      "title": "生查子 二",
      "content": [
        "暖日策花骢，亸鞚垂杨陌。",
        "芳草惹烟青，落絮随风白。",
        "谁家绣毂动香尘，隐映神仙客。",
        "狂杀玉鞭郎，咫尺音容隔。"
      ],
      "author": {
        "id": 12232,
        "name": "孙光宪"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298951,
      "title": "生查子 三",
      "content": [
        "金井堕高梧，玉殿笼斜月。",
        "永巷寂无人，敛态愁堪绝。",
        "玉炉寒，香烬灭，还似君恩歇。",
        "翠辇不归来，幽恨将谁说。"
      ],
      "author": {
        "id": 12232,
        "name": "孙光宪"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298952,
      "title": "生查子 四",
      "content": [
        "春病与春愁，何事年年有。",
        "半为枕前人，半为花间酒。",
        "醉金尊，携玉手，共作鸳鸯偶。",
        "倒载卧云屏，雪面腰如柳。"
      ],
      "author": {
        "id": 12232,
        "name": "孙光宪"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298953,
      "title": "生查子 五",
      "content": [
        "为惜美人娇，长有如花笑。",
        "半醉倚红妆，转语传青鸟。",
        "眷方深，怜恰好，唯恐相逢少。",
        "似这一般情，肯信春光老。"
      ],
      "author": {
        "id": 12232,
        "name": "孙光宪"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298954,
      "title": "生查子 六",
      "content": [
        "清晓牡丹芳，红艳凝金蘂。",
        "乍占锦江春，永认笙歌地。",
        "感人心，为物瑞，烂熳烟花里。",
        "戴上玉钗时，迥与凡花异。"
      ],
      "author": {
        "id": 12232,
        "name": "孙光宪"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298955,
      "title": "生查子 七",
      "content": [
        "密雨阻佳期，尽日凝然坐。",
        "帘外正淋漓，不觉愁如锁。",
        "梦难裁，心欲破，泪逐簷声坠。",
        "想得玉人情，也合思量我。"
      ],
      "author": {
        "id": 12232,
        "name": "孙光宪"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 299008,
      "title": "生查子",
      "content": [
        "相见稀，喜相见，相见还相远。",
        "檀画荔支红，金蔓蜻蜓輭。",
        "鱼雁疎，芳信断，花落庭阴晚。",
        "可惜玉肌肤，消瘦成慵嬾。"
      ],
      "author": {
        "id": 645,
        "name": "张泌"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 299104,
      "title": "生查子",
      "content": [
        "深秋更漏长，滴尽银台烛。",
        "独步出幽闺，月晃波澄绿。",
        "菱荷风乍触，一对鸳鸯宿。",
        "虚櫂玉钗惊，惊起还相续。"
      ],
      "author": {
        "id": 2197,
        "name": "刘侍读"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 312228,
      "title": "生查子",
      "content": [
        "朝庭数擢贤，旋占凌霄路。",
        "自是郁陶人，险难无移处。",
        "也知没药疗饥寒，食薄何相误。",
        "大幅纸连粘，甘草归田赋。"
      ],
      "author": {
        "id": 7391,
        "name": "陈亚"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312229,
      "title": "生查子",
      "content": [
        "相思意已深，白纸书难足。",
        "字字苦参商，故要槟郎读。",
        "分明记得约当归，远至樱桃熟。",
        "何事菊花时，犹未回乡曲。"
      ],
      "author": {
        "id": 7391,
        "name": "陈亚"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312230,
      "title": "生查子",
      "content": [
        "小院雨馀凉，石竹风生砌。",
        "罢扇尽从容，半下纱厨睡。",
        "起来闲坐北亭中，滴尽真珠泪。",
        "为念婿辛勤，去折蟾宫桂。"
      ],
      "author": {
        "id": 7391,
        "name": "陈亚"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312231,
      "title": "生查子",
      "content": [
        "浪荡去未来，踯躅花频换。",
        "可惜石榴裙，兰麝香销半。",
        "琵琶闲抱理相思，必拨朱弦断。",
        "拟续断朱弦，待这冤家看。"
      ],
      "author": {
        "id": 7391,
        "name": "陈亚"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312504,
      "title": "生查子",
      "content": [
        "当初相见时，彼此心萧洒。",
        "近日见人来，却恁相谩諕。",
        "休休休便休，美底教他且。",
        "匹似没伊时，更不思量也。"
      ],
      "author": {
        "id": 5040,
        "name": "张先"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312820,
      "title": "生查子",
      "content": [
        "去年元夜时，花市灯如昼。",
        "月到柳梢头，人约黄昏后。",
        "今年元夜时，月与灯依旧。",
        "不见去年人，泪满春衫袖。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312821,
      "title": "生查子",
      "content": [
        "含羞整翠鬟，得意频相顾。",
        "雁柱十三弦，一一春莺语。",
        "娇云容易飞，梦断知何处。",
        "深院锁黄昏，阵阵芭蕉雨。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313113,
      "title": "生查子",
      "content": [
        "关山魂梦长，寒雁音书少。",
        "两鬓可怜青，只为相思老。",
        "归傍碧纱窗，说向人人道。",
        "真个别离难，不似相逢好。"
      ],
      "author": {
        "id": 11741,
        "name": "杜安世"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313252,
      "title": "生查子",
      "content": [
        "雨打江南树。",
        "一夜花开无数。",
        "绿叶渐成阴，下有游人归路。",
        "与君相逢处。",
        "不道春将暮。",
        "把酒祝东风，且莫恁、匆匆去。"
      ],
      "author": {
        "id": 9366,
        "name": "王安石"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313350,
      "title": "生查子",
      "content": [
        "金鞭美少年，去跃青骢马。",
        "牵系玉楼人，绣被春寒夜。",
        "消息未归来，寒食梨花谢。",
        "无处说相思，背面秋千下。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313351,
      "title": "生查子",
      "content": [
        "轻匀两脸花，淡扫双眉柳。",
        "会写锦笺时，学弄朱弦后。",
        "今春玉钏宽，昨夜罗裙皱。",
        "无计奈情何，且醉金杯酒。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313352,
      "title": "生查子",
      "content": [
        "关山魂梦长，鱼雁音尘少。",
        "两鬓可怜青，只为相思老。",
        "归梦碧纱窗，说与人人道。",
        "真个别离难，不似相逢好。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313353,
      "title": "生查子",
      "content": [
        "坠雨已辞云，流水难归浦。",
        "遗恨几时休，心抵秋莲苦。",
        "忍泪不能歌，试托哀弦语。",
        "弦语愿相逢，知有相逢否。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313354,
      "title": "生查子",
      "content": [
        "一分残酒霞，两点愁蛾晕。",
        "罗幕夜犹寒，玉枕春先困。",
        "心情翦彩慵，时节烧灯近。",
        "见少别离多，还有人堪恨。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313355,
      "title": "生查子",
      "content": [
        "轻轻制舞衣，小小裁歌扇。",
        "三月柳浓时，又向津亭见。",
        "垂泪送行人，湿破红妆面。",
        "玉指袖中弹，一曲清商怨。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313356,
      "title": "生查子",
      "content": [
        "红尘陌上游，碧柳堤边住。",
        "才趁彩云来，又逐飞花去。",
        "深深美酒家，曲曲幽香路。",
        "风月有情时，总是相思处。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313357,
      "title": "生查子",
      "content": [
        "长恨涉江遥，移近溪头住。",
        "闲荡木兰舟，误入双鸳浦。",
        "无端轻薄云，暗作廉纤雨。",
        "翠袖不胜寒，欲向荷花语。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313358,
      "title": "生查子",
      "content": [
        "远山眉黛长，细柳腰肢袅。",
        "妆罢立春风，一笑千金少。",
        "归去凤城时，说与青楼道。",
        "遍看颍川花，不似师师好。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313359,
      "title": "生查子",
      "content": [
        "落梅庭榭香，芳草池塘绿。",
        "春恨最关情，日过阑干曲。",
        "几时花里闲，看得花枝足。",
        "醉后莫思家，借取师师宿。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313360,
      "title": "生查子",
      "content": [
        "狂花顷刻香，晚蝶缠绵意。",
        "天与短因缘，聚散常容易。",
        "传唱入离声，恼乱双蛾翠。",
        "游子不堪闻，正是衷肠事。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313361,
      "title": "生查子",
      "content": [
        "官身几日闲，世事何时足。",
        "君貌不长红，我鬓无重绿。",
        "榴花满盏香，金缕多情曲。",
        "且尽眼中欢，莫叹时光促。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313362,
      "title": "生查子",
      "content": [
        "春从何处归，试向溪边问。",
        "岸柳弄娇黄，陇麦回青润。",
        "多情美少年，屈指芳菲近。",
        "谁寄岭头梅，来报江南信。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313577,
      "title": "生查子",
      "content": [
        "关山魂梦长，塞雁音书少。",
        "两鬓可怜青，一夜相思老。",
        "归傍碧纱窗，说与人人道。",
        "真个别离难，不似相逢好。"
      ],
      "author": {
        "id": 8647,
        "name": "王观"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313812,
      "title": "生查子",
      "content": [
        "三度别君来，此别真迟暮。",
        "白尽老髭须，明日淮南去。",
        "酒罢月随人，泪湿花如雾。",
        "后月逐君还，梦绕湖边路。"
      ],
      "author": {
        "id": 11678,
        "name": "苏轼"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314435,
      "title": "生查子",
      "content": [
        "家承阀阅高，人擅闺房秀。",
        "嫁得伯鸾夫，直是齐眉偶。",
        "榴花著子时，萱草宜男候。",
        "一笑捧觥船，共祝人常寿。"
      ],
      "author": {
        "id": 8294,
        "name": "李漳"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314643,
      "title": "生查子",
      "content": [
        "庭户小光中，帘幕秋光里。",
        "曲沼绮疏横，几处新妆洗。",
        "红脸露轻匀，翠袖风频倚。",
        "鸾鉴不须开，自有窗前水。"
      ],
      "author": {
        "id": 6695,
        "name": "李处全"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314644,
      "title": "生查子",
      "content": [
        "温柔属东西，和冷经三五。",
        "几夜德星明，果应荀陈聚。",
        "分虎屈雄姿，展骥淹遐步。",
        "除诏已涂芝，便看朝天去。"
      ],
      "author": {
        "id": 6695,
        "name": "李处全"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315267,
      "title": "生查子",
      "content": [
        "娇莺恰恰啼，过水翻回去。",
        "欲共诉芳心，故绕池边树。",
        "人去绮窗闲，弦断秦筝柱。",
        "百啭听新声，总是伤心处。"
      ],
      "author": {
        "id": 8242,
        "name": "杨冠卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315268,
      "title": "生查子",
      "content": [
        "消瘦不胜寒，独立江南路。",
        "罗袜暗生尘，不见凌波步。",
        "兰佩解鸣珰，往事凭谁诉。",
        "一纸彩云笺，好寄青鸾去。"
      ],
      "author": {
        "id": 8242,
        "name": "杨冠卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315269,
      "title": "生查子",
      "content": [
        "潇湘日暮时，倚棹蒹葭浦。",
        "不见独醒人，愁对湘妃语。",
        "璧月送归云，一叶莲舟举。",
        "宝瑟奏清商，波底鱼龙舞。"
      ],
      "author": {
        "id": 8242,
        "name": "杨冠卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315405,
      "title": "生查子",
      "content": [
        "昨宵醉里行，山吐三更月。",
        "不见可怜人，一夜头如雪。",
        "今宵醉里归，明月关山笛。",
        "收拾锦囊诗，要寄扬雄宅。"
      ],
      "author": {
        "id": 8618,
        "name": "辛弃疾"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315406,
      "title": "生查子",
      "content": [
        "谁倾沧海珠，簸弄千明月。",
        "唤取酒边来，软语裁春雪。",
        "人间无凤凰，空费穿云笛。",
        "醉倒却归来，松菊陶潜宅。"
      ],
      "author": {
        "id": 8618,
        "name": "辛弃疾"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315505,
      "title": "生查子",
      "content": [
        "溪边照影行，天在清溪底。",
        "天上有行云，人在行云里。",
        "高歌谁和余，空谷清音起。",
        "非鬼亦非仙，一曲桃花水。"
      ],
      "author": {
        "id": 8618,
        "name": "辛弃疾"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315519,
      "title": "生查子",
      "content": [
        "青山非不佳，未解留侬住。",
        "赤脚踏沧浪，为爱清溪故。",
        "朝来山鸟啼，劝上山高处。",
        "我意不关渠，自要寻兰去。"
      ],
      "author": {
        "id": 8618,
        "name": "辛弃疾"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315630,
      "title": "生查子",
      "content": [
        "漫天春雪来，才抵梅花半。",
        "最爱雪边人，楚些裁成乱。",
        "雪儿偏解歌，只要金杯满。",
        "谁道雪天寒，翠袖阑干暖。"
      ],
      "author": {
        "id": 8618,
        "name": "辛弃疾"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315631,
      "title": "生查子",
      "content": [
        "去年燕子来，帘幕深深处。",
        "香径得泥归，都把琴书污。",
        "今年燕子来，谁听呢喃语。",
        "不见卷帘人，一阵黄昏雨。"
      ],
      "author": {
        "id": 8618,
        "name": "辛弃疾"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315790,
      "title": "生查子",
      "content": [
        "梅子褪花时，直与黄梅接。",
        "烟雨几曾开，一春江里活。",
        "富贵使人忙，也有闲时节。",
        "莫作路旁花，长教人看杀。"
      ],
      "author": {
        "id": 8618,
        "name": "辛弃疾"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315791,
      "title": "生查子",
      "content": [
        "悠悠万世功，矻矻当年苦。",
        "鱼自入深渊，人自居平土。",
        "红日又西沉，白浪长东去。",
        "不是望金山，我自思量禹。"
      ],
      "author": {
        "id": 8618,
        "name": "辛弃疾"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315795,
      "title": "生查子",
      "content": [
        "一天霜月明，几处砧声起。",
        "客梦已难成，秋色无边际。",
        "旦夕是重阳，菊有黄花蕊。",
        "只怕又登高，未饮心先醉。"
      ],
      "author": {
        "id": 8618,
        "name": "辛弃疾"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315827,
      "title": "生查子",
      "content": [
        "百花头上开，冰雪寒中见。",
        "霜月定相知，先识春风面。",
        "主人情意深，不管江妃怨。",
        "折我最繁枝，还许冰壶荐。"
      ],
      "author": {
        "id": 8618,
        "name": "辛弃疾"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315945,
      "title": "生查子",
      "content": [
        "溪光曲曲村，花影重重树。",
        "风物小桃源，春事还如许。",
        "情知送客来，又作寻芳去。",
        "可惜一春诗，总为闲愁赋。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315946,
      "title": "生查子",
      "content": [
        "长记别郎时，月淡梅花影。",
        "梅影又横窗，不见江南信。",
        "无心换夕香，有分怜朝镜。",
        "不怕瘦棱棱，只怕梅开尽。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316047,
      "title": "生查子",
      "content": [
        "兰帷夜色高，绣被春寒拥。",
        "何事玉楼人，屡踏杨花梦。",
        "分明相见陈，不道幽情重。",
        "乞个好因缘，莫待来生种。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316064,
      "title": "生查子",
      "content": [
        "烟雨不多时，肥得梅如许。",
        "早有点儿酸，诮没星儿苦。",
        "飞燕恶禁持，又待衔春去。",
        "容著水精盐，觅个调羹处。"
      ],
      "author": {
        "id": 2355,
        "name": "黄人杰"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316322,
      "title": "生查子",
      "content": [
        "裙拖簇石榴，髻绾偏荷叶。",
        "头上短金钗，轻重还相压。",
        "轻颦月入眉，浅笑花生颊。",
        "夫婿不风流，取次看承别。"
      ],
      "author": {
        "id": 11823,
        "name": "韩玉"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316504,
      "title": "生查子",
      "content": [
        "梅从陇首传，柳向邮亭折。",
        "鸳瓦晓霜浓，掠面凝寒色。",
        "相逢意便亲，欲去如何说。",
        "我亦是行人，更与行人别。"
      ],
      "author": {
        "id": 9256,
        "name": "赵师侠"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316505,
      "title": "生查子",
      "content": [
        "千山拥翠屏，一水萦罗带。",
        "雨过水痕添，云散山容在。",
        "亭高景最幽，天回风尤快。",
        "啼鸟一声闲，唤起情无奈。"
      ],
      "author": {
        "id": 9256,
        "name": "赵师侠"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316506,
      "title": "生查子",
      "content": [
        "迟迟春昼长，冉冉东风软。",
        "寒食乍晴天，红紫芳菲遍。",
        "前峰积翠横，新涨挼蓝远。",
        "向晚淡烟迷，一段屏山展。"
      ],
      "author": {
        "id": 9256,
        "name": "赵师侠"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316507,
      "title": "生查子",
      "content": [
        "春光不肯留，风雨催将去。",
        "红逐故园尘，绿满江南树。",
        "阴晴寒食天，寂寞西郊路。",
        "芳草织新愁，怅望人何处。"
      ],
      "author": {
        "id": 9256,
        "name": "赵师侠"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316508,
      "title": "生查子",
      "content": [
        "庭虚任雀喧，院静无人到。",
        "回首十年非，赖得知几早。",
        "心随香篆销，意与梅花好。",
        "万事转头空，一笑吾身老。"
      ],
      "author": {
        "id": 9256,
        "name": "赵师侠"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316645,
      "title": "生查子",
      "content": [
        "金莲照夜红，玉腕扶春碧。",
        "曲妙遏云行，人好欺花色。",
        "欢生酒面浓，笑染炉香湿。",
        "饮尽十玻璃，月堕东方白。"
      ],
      "author": {
        "id": 3541,
        "name": "杨炎正"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316942,
      "title": "生查子",
      "content": [
        "春来春色佳，秋至秋光好。",
        "无计奈春归，又看秋光老。",
        "去年飞雪时，病与梅花道。",
        "来岁雪飞时，为把金樽倒。"
      ],
      "author": {
        "id": 10066,
        "name": "汪莘"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316982,
      "title": "生查子",
      "content": [
        "天上不知天，洞里休寻洞。",
        "洞府天宫在眼前，春日都浮动。",
        "我自觉来看，他在迷时梦。",
        "觉则人人总是仙，步步乘鸾凤。"
      ],
      "author": {
        "id": 10066,
        "name": "汪莘"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 317161,
      "title": "生查子",
      "content": [
        "尊前主与宾，欠一还成九。",
        "休唱木犀词，预饮黄花酒。",
        "开怀今夕同，分手明朝又。",
        "不管岁年催，且把馨香嗅。"
      ],
      "author": {
        "id": 2985,
        "name": "郭应祥"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 317162,
      "title": "生查子",
      "content": [
        "银烛印红衫，薄暮新梳洗。",
        "一笑奉宾欢，未解东君意。",
        "回廊月转初，忆趁良宵会。",
        "喜事在明年，剧饮拼先醉。"
      ],
      "author": {
        "id": 2985,
        "name": "郭应祥"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 317235,
      "title": "生查子",
      "content": [
        "霜叶柳塘风，烟蕊梅溪渡。",
        "茅店问村醪，未许空归去。",
        "倚杖小徘徊，写我吟边句。",
        "醉眼复何之，落日孤鸿处。"
      ],
      "author": {
        "id": 11972,
        "name": "韩淲"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 317274,
      "title": "生查子",
      "content": [
        "山意入春晴，都是梅和柳。",
        "白白与青青，日映风前酒。",
        "归去也如何，路上休回首。",
        "各自做新年，柳袅梅枝瘦。"
      ],
      "author": {
        "id": 11972,
        "name": "韩淲"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 317363,
      "title": "生查子",
      "content": [
        "吴山与越山，相对摩今古。",
        "袅缆浙江亭，回首西兴渡。",
        "区区名利人，无分香闺住。",
        "匆遽促征鞍，又入临平路。"
      ],
      "author": {
        "id": 9877,
        "name": "吴礼之"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 317558,
      "title": "生查子",
      "content": [
        "湘江贯地维，衡岳生人杰。",
        "谁遣益州星，暂伴峨眉月。",
        "初度庆今朝，绣斧双龙节。",
        "为国罩嘉鱼，趣觐黄金阙。"
      ],
      "author": {
        "id": 11296,
        "name": "李刘"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 317563,
      "title": "生查子",
      "content": [
        "万里彩衣远，旬日黄花后。",
        "蓬矢纪佳辰，莲幕翻新奏。",
        "更看桂枝香，归献灵椿寿。",
        "同对小蟠桃，共醉长生酒。"
      ],
      "author": {
        "id": 11296,
        "name": "李刘"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 317729,
      "title": "生查子",
      "content": [
        "野泉春吐芽，泥湿随飞燕。",
        "碧涧一杯羹，夜韭无人翦。",
        "玉钗和露香，鹅管随春软。",
        "野意重殷勤，持以君王献。"
      ],
      "author": {
        "id": 5575,
        "name": "高观国"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 317730,
      "title": "生查子",
      "content": [
        "芙蓉羞粉香，倚竹窥烟霁。",
        "眼带楚波寒，骨艳春风醉。",
        "谁传侧帽情，想解遗鞭意。",
        "红叶可怜秋，不寄相思字。"
      ],
      "author": {
        "id": 5575,
        "name": "高观国"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 317731,
      "title": "生查子",
      "content": [
        "蓬莱一捻云，彻骨龙涎染。",
        "风味韵而芳，笑语柔而婉。",
        "花娇绿鬓寒，酒凝清歌怨。",
        "翠幄已烟浓，银烛重休翦。"
      ],
      "author": {
        "id": 5575,
        "name": "高观国"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 317732,
      "title": "生查子",
      "content": [
        "春笼云润香，露湿青蛟瘦。",
        "偷学汉宫妆，舞彻霓裳后。",
        "酥胸紫领巾，冰翦柔荑手。",
        "有意入罗囊，不肯成春酒。"
      ],
      "author": {
        "id": 5575,
        "name": "高观国"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 317733,
      "title": "生查子",
      "content": [
        "飞花澹澹风，破暖疏疏雨。",
        "香润玉阶尘，翠湿纱窗雾。",
        "钿筝离雁行，宝箧留钗股。",
        "惟有凤楼魂，夜夜江南路。"
      ],
      "author": {
        "id": 5575,
        "name": "高观国"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 317734,
      "title": "生查子",
      "content": [
        "香惊楚驿寒，瘦倚湘筠暮。",
        "一笛已黄昏，片月尤清楚。",
        "沈沈冰玉魂，漠漠烟云浦。",
        "酸泪不成弹，又向春心聚。"
      ],
      "author": {
        "id": 5575,
        "name": "高观国"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 318244,
      "title": "生查子",
      "content": [
        "愁盈镜里山，心叠琴中恨。",
        "露湿玉阑秋，香伴银屏冷。",
        "云归月正圆，雁到人无信。",
        "孤损凤皇钗，立尽梧桐影。"
      ],
      "author": {
        "id": 5392,
        "name": "魏子敬"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 318341,
      "title": "生查子",
      "content": [
        "芙蓉清夜游，杨柳黄昏约。",
        "小院碧苔深，润透双鸳薄。",
        "暖玉惯春娇，簌簌花钿落。",
        "缺月故窥人，影转阑干角。"
      ],
      "author": {
        "id": 7541,
        "name": "岳珂"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 318786,
      "title": "生查子",
      "content": [
        "繁灯夺霁华。",
        "戏鼓侵明发。",
        "物色旧时同，情味中年别。",
        "浅画镜中眉，深拜楼西月。",
        "人散市声收，渐入愁时节。"
      ],
      "author": {
        "id": 8873,
        "name": "刘克庄"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 319465,
      "title": "生查子",
      "content": [
        "谁家白面郎，画舫朱帘挂。",
        "十二列金钗，一局文楸罢。",
        "歌舞不知休，醉倒荷花下。",
        "归棹踏烟波，灯火芜城夜。"
      ],
      "author": {
        "id": 8921,
        "name": "吴潜"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 319592,
      "title": "生查子",
      "content": [
        "坐临芳沼边，荷气侵衣湿。",
        "唧唧暗蛩鸣，点点流萤入。",
        "人生歧路中，底用杨朱泣。",
        "一笑倚阑干，颓玉当风立。"
      ],
      "author": {
        "id": 8921,
        "name": "吴潜"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 319593,
      "title": "生查子",
      "content": [
        "夜夜云气浮，带得香烟湿。",
        "万籁本无情，一一秋声入。",
        "须臾离合间，应笑儿曹泣。",
        "新雨涨鄞江，明日桅樯立。"
      ],
      "author": {
        "id": 8921,
        "name": "吴潜"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 320258,
      "title": "生查子",
      "content": [
        "暮云千万重，寒梦家乡远。",
        "愁见越溪娘，镜里梅花面。",
        "醉情啼枕冰，往事分钗燕。",
        "三月灞陵桥，心翦东风乱。"
      ],
      "author": {
        "id": 1043,
        "name": "吴文英"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 320319,
      "title": "生查子",
      "content": [
        "当楼月半奁，曾买菱花处。",
        "愁影背阑干，素发残风露。",
        "神前鸡酒盟，歌断秋香户。",
        "泥落画梁空，梦想青春语。"
      ],
      "author": {
        "id": 1043,
        "name": "吴文英"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 320468,
      "title": "生查子",
      "content": [
        "罗襦隐绣茸，玉合消红豆。",
        "深院落梅钿，寒峭收灯后。",
        "心事卜金钱，月上鹅黄柳。",
        "拜了夜香休，翠被听春漏。"
      ],
      "author": {
        "id": 9233,
        "name": "李彭老"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 320484,
      "title": "生查子",
      "content": [
        "妾情歌柳枝，郎意怜桃叶。",
        "罗带绾同心，谁信愁千结。",
        "楼上数残更，马上看新月。",
        "绣被怨春寒，怕学鸳鸯叠。"
      ],
      "author": {
        "id": 3606,
        "name": "李莱老"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 322105,
      "title": "生查子",
      "content": [
        "痴多故恼人，妆晚翻嫌趣。",
        "只为眼波长，嗔笑娇难触。",
        "春心不肯深，春睡何曾足。",
        "莫待柳花飞，飞去无拘束。"
      ],
      "author": {
        "id": 2335,
        "name": "彭元逊"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 322380,
      "title": "生查子",
      "content": [
        "三两信凉风，七八分圆月。",
        "愁绪到今年，又与前年别。",
        "衾单容易寒，独暗相将灭。",
        "欲识此时情，听取鸣蛩说。"
      ],
      "author": {
        "id": 244,
        "name": "莫"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 322491,
      "title": "生查子",
      "content": [
        "飞尘入建章，乐事难重见。",
        "白发故宫娃，闲说沈香宴。",
        "霓裳秋梦寒，□靸黏冰片。",
        "萤火起庭莎，犹忆轻罗扇。"
      ],
      "author": {
        "id": 2011,
        "name": "仇远"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 322553,
      "title": "生查子",
      "content": [
        "钗头缀玉虫，耿耿东窗晓。",
        "京洛少年游，犹恨归来早。",
        "寒食正梨花，古道多芳草。",
        "今夜试青镫，依旧春花小。"
      ],
      "author": {
        "id": 2011,
        "name": "仇远"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 323493,
      "title": "生查子",
      "content": [
        "朔风吹冻云，云破天容碧。",
        "新月过溪来，隐见横云色。",
        "天与水争妍，花与月争白。",
        "一倩管城君，寄此春消息。"
      ],
      "author": {
        "id": 5773,
        "name": "无名氏"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 324331,
      "title": "生查子",
      "content": [
        "我爱木中犀，不是凡花数。",
        "清似水沈香，色染蔷薇露。",
        "芗林月冷时，玉笋云深处。",
        "归梦托秋风，夜夜江头路。"
      ],
      "author": {
        "id": 649,
        "name": "向子諲"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 324332,
      "title": "生查子",
      "content": [
        "月姊倚秋风，香度青林杪。",
        "吹堕酒杯中，笑靥撩人小。",
        "芗林万事休，独此情未了。",
        "醉里又题诗，不觉花前老。"
      ],
      "author": {
        "id": 649,
        "name": "向子諲"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    }
  ],
