        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 317950,
      "title": "谒金门",
      "content": [
        "人寂寞。",
        "帘外翠阴如幄。",
        "团扇藤床花间错。",
        "雨边残梦觉。",
        "翠浅粉销香薄。",
        "临镜不忺梳掠。",
        "新恨悠悠无处托。",
        "棋声闲院落。"
      ],
      "author": {
        "id": 12933,
        "name": "卢祖皋"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 317951,
      "title": "谒金门",
      "content": [
        "闲睡足。",
        "冰柱乱敲寒玉。",
        "簇簇庭阴嘉树绿。",
        "晚蝉声断续。",
        "一雨藕花新浴。",
        "香破小窗幽独。",
        "重理焦桐寻旧曲。",
        "隔墙风动竹。"
      ],
      "author": {
        "id": 12933,
        "name": "卢祖皋"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 317952,
      "title": "谒金门",
      "content": [
        "香漠漠。",
        "低卷水风池阁。",
        "玉腕笼纱金半约。",
        "睡浓团扇落。",
        "雨后凉生云薄。",
        "女伴棹歌声乐。",
        "采得双莲迎笑剥。",
        "柳阴多处泊。"
      ],
      "author": {
        "id": 12933,
        "name": "卢祖皋"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 317953,
      "title": "谒金门",
      "content": [
        "秋几许。",
        "荒蓼败荷烟渚。",
        "贴水飞鸥江欲暮。",
        "风帆追急羽。",
        "蝶梦转头无据。",
        "愁到曲屏深处。",
        "寒入双城扃绣户。",
        "也应闻细雨。"
      ],
      "author": {
        "id": 12933,
        "name": "卢祖皋"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 317954,
      "title": "谒金门",
      "content": [
        "罗袖褪。",
        "短鬓独搔谁恨。",
        "叶叶秋声风衮衮。",
        "万端心一寸。",
        "钗凤镜鸾谁问。",
        "想见粉香啼损。",
        "倩尽飞鸿终未稳。",
        "夜来寒陡顿。"
      ],
      "author": {
        "id": 12933,
        "name": "卢祖皋"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 318191,
      "title": "谒金门",
      "content": [
        "春正美。",
        "满眼万红千紫。",
        "收拾群香归瓮蚁。",
        "长年花信里。",
        "深院帘栊如水。",
        "双燕呢喃芳垒。",
        "唾碧轻衫人送喜。",
        "梅梢新结子。"
      ],
      "author": {
        "id": 8088,
        "name": "洪咨夔"
      },
