{
  "data": [
    {
      "id": 11800,
      "title": "和宣风寺壁间韵",
      "content": [
        "客梦到何许，南山桃李园。",
        "未能忘蜡屐，何意谒金门。",
        "愿举汉三杰，尽戡周陆浑。",
        "虎皮包剑㦸，农务看村村。"
      ],
      "author": {
        "id": 10733,
        "name": "胡寅"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 15550,
      "title": "有怀十首  其九",
      "content": [
        "翁侯满腹是精神，三谒金门计未成。",
        "却跨蹇馿游霅上，秋风雄剑匣中鸣。"
      ],
      "author": {
        "id": 12138,
        "name": "刘子翚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 136608,
      "title": "宫词  其一",
      "content": [
        "汉宫春色傍黄昏，曾谒金门奉至尊。",
        "月上海棠人寂寂，焚香百拜感皇恩。"
      ],
      "author": {
        "id": 12428,
        "name": "胡仲弓"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 265473,
      "title": "送周鲁儒赴举诗",
      "content": [
        "宋日营阳内史孙，因家占得九疑村。",
        "童心便有爱书癖，手指今余把笔痕。",
        "自握蛇珠辞白屋，欲凭鸡卜谒金门。",
        "若逢广坐问羊酪，从此知名在一言。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 298536,
      "title": "谒金门 一",
      "content": [
        "春雨足，染就一溪新绿。",
        "柳外飞来双羽玉，弄晴相对浴。",
        "楼外翠帘高轴，倚遍阑干几曲。",
        "云淡水平烟树簇，寸心千里目。"
      ],
      "author": {
        "id": 6755,
        "name": "韦庄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298537,
      "title": "谒金门 二",
      "content": [
        "春漏促，金烬暗挑残烛。",
        "一夜帘前风撼竹，梦魂相断续。",
        "有个娇饶如玉，夜夜绣屏孤宿。",
        "闲抱琵琶寻旧曲，远山眉黛绿。"
      ],
      "author": {
        "id": 6755,
        "name": "韦庄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298538,
      "title": "谒金门 三",
      "content": [
        "空相忆，无记得传消息。",
        "天上嫦娥人不识，寄书何处觅。",
        "新睡觉来无力，不忍把君书迹。",
        "满院落花春寂寂，断肠芳草碧。"
      ],
      "author": {
        "id": 6755,
        "name": "韦庄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298645,
      "title": "谒金门",
      "content": [
        "秋已暮，重叠关山岐路。",
        "嘶马摇鞭何处去，晓禽霜满树。",
        "梦断禁城钟鼓，泪滴枕檀无数。",
        "一点凝红和薄雾，翠蛾愁不语。"
      ],
      "author": {
        "id": 838,
        "name": "牛希济"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298665,
      "title": "谒金门",
      "content": [
        "春满院，叠损罗衣金线。",
        "睡觉水精帘未卷，帘前双语燕。",
        "斜掩金铺一扇，满地落花千片。",
        "早是相思肠欲断，忍教频梦见。"
      ],
      "author": {
        "id": 8953,
        "name": "薛昭蕴"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298747,
      "title": "谒金门 一",
      "content": [
        "烟水阔，人值清明时节。",
        "雨细花零莺语切，愁肠千万结。",
        "鴈去音徽断绝，有恨欲凭谁说。",
        "无事伤心犹不彻，春时容易别。"
      ],
      "author": {
        "id": 12827,
        "name": "魏承班"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298748,
      "title": "谒金门 二",
      "content": [
        "春欲半，堆砌落花千片。",
        "早是潘郎长不见，忍听双语燕。",
        "飞絮晴空飏远，风送谁家弦管。",
        "愁倚画屏凡事嬾，泪霑金缕线。"
      ],
      "author": {
        "id": 12827,
        "name": "魏承班"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298749,
      "title": "谒金门 三",
      "content": [
        "长思忆，思忆佳辰轻掷。",
        "霜月透帘澄夜色，小屏山凝碧。",
        "恨恨君何太极，记得娇娆无力。",
        "独坐思量愁似织，断肠烟水隔。"
      ],
      "author": {
        "id": 12827,
        "name": "魏承班"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298911,
      "title": "谒金门",
      "content": [
        "美人浴，碧沼莲开芬馥。",
        "双髻绾云颜似玉，素娥辉淡绿。",
        "雅态芳姿闲淑，雪映钿装金斛。",
        "水溅青丝珠断续，酥融香透肉。"
      ],
      "author": {
        "id": 3463,
        "name": "阎选"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298982,
      "title": "谒金门",
      "content": [
        "留不得，留得也应无益。",
        "白纻春衫如雪色，扬州初去日。",
        "轻别离，甘抛掷，江上满帆风疾。",
        "却羡彩鸳三十六，孤鸾还一只。"
      ],
      "author": {
        "id": 12232,
        "name": "孙光宪"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 299061,
      "title": "谒金门 一",
      "content": [
        "风乍起，吹皱一池春水。",
        "闲引鸳鸯芳径里，手挼红杏蘂。",
        "鬬鸭阑干独倚，碧玉搔头斜坠。",
        "终日望君君不至，举头闻鹊喜。"
      ],
      "author": {
        "id": 8353,
        "name": "冯延巳"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 299062,
      "title": "谒金门 二",
      "content": [
        "杨柳陌，宝马嘶空无迹。",
        "新著荷衣人未识，年年江海客。",
        "梦觉巫山春色，醉眼飞花狼藉。",
        "起舞不辞无气力，爱君吹玉笛。"
      ],
      "author": {
        "id": 8353,
        "name": "冯延巳"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 312623,
      "title": "谒金门",
      "content": [
        "秋露坠。",
        "滴尽楚兰红泪。",
        "往事旧欢何限意。",
        "思量如梦寐。",
        "人貌老于前岁。",
        "风月宛然无异。",
        "座有嘉宾尊有桂。",
        "莫辞终夕醉。"
      ],
      "author": {
        "id": 6242,
        "name": "晏殊"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313253,
      "title": "谒金门",
      "content": [
        "春又老。",
        "南陌酒香梅小。",
        "遍地落花浑不扫。",
        "梦回情意悄。",
        "红笺寄与添烦恼。",
        "细写相思多少。",
        "醉后几行书字小。",
        "泪痕都揾了。"
      ],
      "author": {
        "id": 9366,
        "name": "王安石"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313567,
      "title": "谒金门",
      "content": [
        "溪声急。",
        "无数落花漂出。",
        "燕子分泥蜂酿蜜。",
        "迟迟艳风日。",
        "须信芳菲随失。",
        "况复佳期难必。",
        "拟把此情书万一。",
        "愁多翻阁笔。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313840,
      "title": "谒金门",
      "content": [
        "秋帷里。",
        "长漏伴人无寐。",
        "低玉枕凉轻绣被。",
        "一番秋气味。",
        "晓色又侵窗纸。",
        "窗外鸡声初起。",
        "声断几声还到耳。",
        "已明声未已。"
      ],
      "author": {
        "id": 11678,
        "name": "苏轼"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313841,
      "title": "谒金门",
      "content": [
        "秋池阁。",
        "风傍晓庭帘幕。",
        "霜叶未衰吹未落。",
        "半惊鸦喜鹊。",
        "自笑浮名情薄。",
        "似与世人疏略。",
        "一片懒心双懒脚。",
        "好教闲处著。"
      ],
      "author": {
        "id": 11678,
        "name": "苏轼"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313842,
      "title": "谒金门",
      "content": [
        "今夜雨。",
        "断送一年残暑。",
        "坐听潮声来别浦。",
        "明朝何处去。",
        "孤负金尊绿醑。",
        "来岁今宵圆否。",
        "酒醒梦回愁几许。",
        "夜阑还独语。"
      ],
      "author": {
        "id": 11678,
        "name": "苏轼"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314271,
      "title": "谒金门",
      "content": [
        "塘水碧。",
        "仍带曲尘颜色。",
        "泥泥縠纹无气力。",
        "东风如爱惜。",
        "恰似越来溪侧。",
        "也有一双㶉𫛶。",
        "只欠柳丝千百尺。",
        "系船春弄笛。"
      ],
      "author": {
        "id": 9909,
        "name": "范成大"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314485,
      "title": "谒金门",
      "content": [
        "真个忆。",
        "花下雨声初息。",
        "猛记乌衣曾旧识。",
        "丁宁教去觅。",
        "春半峭寒犹力。",
        "泪滴两襟成迹。",
        "独倚危阑清昼寂。",
        "草长流翠碧。"
      ],
      "author": {
        "id": 474,
        "name": "沈端节"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314486,
      "title": "谒金门",
      "content": [
        "春欲去。",
        "人瘦不胜金缕。",
        "门巷阴阴飞絮舞。",
        "断肠双燕语。",
        "孤坐晚窗闲处。",
        "月到花心亭午。",
        "寒色著人无意绪。",
        "竹鸣风似雨。"
      ],
      "author": {
        "id": 474,
        "name": "沈端节"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314487,
      "title": "谒金门",
      "content": [
        "寻胜去。",
        "湖色净涵疏树。",
        "欸乃一声何处起。",
        "风铃相应语。",
        "目断遥林修渚。",
        "画出江南烟雨。",
        "山水照人人楚楚。",
        "锦肠生秀句。"
      ],
      "author": {
        "id": 474,
        "name": "沈端节"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314731,
      "title": "谒金门",
      "content": [
        "风又雨。",
        "吹面落花红舞。",
        "把酒不禁春思苦。",
        "别离闻杜宇。",
        "叠嶂楼头佳处。",
        "犹想襞笺容与。",
        "思入云山便好语。",
        "莫辞频寄取。"
      ],
      "author": {
        "id": 1129,
        "name": "丘崈"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314732,
      "title": "谒金门",
      "content": [
        "槐阴绿。",
        "帘卷翠屏山曲。",
        "照眼冰壶寒并玉。",
        "赐衣便雾縠。",
        "熊梦又惊初卜。",
        "好在掖垣梧竹。",
        "应讶人归犹未速。",
        "已颁新诏墨。"
      ],
      "author": {
        "id": 1129,
        "name": "丘崈"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314733,
      "title": "谒金门",
      "content": [
        "罗袖薄。",
        "玉臂镂花金约。",
        "起晚欠伸莲步弱。",
        "倚床娇韵恶。",
        "独自青楼珠箔。",
        "怎向日长花落。",
        "门掩东风春寂寞。",
        "误人瞋喜鹊。"
      ],
      "author": {
        "id": 1129,
        "name": "丘崈"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314734,
      "title": "谒金门",
      "content": [
        "花雨润。",
        "烟锁玉炉香韵。",
        "笑度华年春不尽。",
        "寿觞寒食近。",
        "甲子才周一瞬。",
        "争羡珠颜青鬓。",
        "咫尺朝元仙路稳。",
        "碧云新有信。"
      ],
      "author": {
        "id": 1129,
        "name": "丘崈"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314768,
      "title": "谒金门",
      "content": [
        "花满树。",
        "两个黄鹂相语。",
        "恰似碧城双玉女。",
        "对歌还对舞。",
        "可惜娟娟楚楚。",
        "同伴彩云归去。",
        "居士心如泥上絮。",
        "那能无恨处。"
      ],
      "author": {
        "id": 11270,
        "name": "吕胜己"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314769,
      "title": "谒金门",
      "content": [
        "嗟久客。",
        "又见他乡寒食。",
        "流水断桥春寂寂。",
        "孤村烟火息。",
        "白去红飞无迹。",
        "千树总成新碧。",
        "醉里伤春愁似织。",
        "东风欺酒力。"
      ],
      "author": {
        "id": 11270,
        "name": "吕胜己"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314770,
      "title": "谒金门",
      "content": [
        "芳思切，旧事不堪重说。",
        "浓露凝香花喷血。",
        "花心双蛱蝶。",
        "燕语莺啼都歇。",
        "又过清明时节。",
        "记得离歌三两阕。",
        "未歌先哽咽。"
      ],
      "author": {
        "id": 11270,
        "name": "吕胜己"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314774,
      "title": "谒金门",
      "content": [
        "春又过。",
        "那更雨摧风挫。",
        "留得浅红三两朵。",
        "竹梢烟雾锁。",
        "把酒对花危坐。",
        "多病多愁都可。",
        "舞蝶游蜂迷道左。",
        "惜春忙似我。"
      ],
      "author": {
        "id": 11270,
        "name": "吕胜己"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314775,
      "title": "谒金门",
      "content": [
        "秋夜静。",
        "屋上狂风初定。",
        "两两啼蛄相答应。",
        "灯蛾摇烛影。",
        "枕上鸡声遥听。",
        "起舞良宵偏永。",
        "明日谩寻弓剑整。",
        "衰颜重揽镜。"
      ],
      "author": {
        "id": 11270,
        "name": "吕胜己"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314776,
      "title": "谒金门",
      "content": [
        "芳信拆。",
        "漏泄东君消息。",
        "帝殿宝炉烟未熄。",
        "龙香飘片白。",
        "点缀枯梢的皪。",
        "疏影摇荡寒碧。",
        "指与纤纤教自摘。",
        "枝横云鬓侧。"
      ],
      "author": {
        "id": 11270,
        "name": "吕胜己"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314777,
      "title": "谒金门",
      "content": [
        "天气暖。",
        "开了荼䕷一半。",
        "红日迟迟风拂面。",
        "阶前花影乱。",
        "俊雅风流不见。",
        "定被莺花留恋。",
        "千尺游丝舒又罥。",
        "系人心上线。"
      ],
      "author": {
        "id": 11270,
        "name": "吕胜己"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314778,
      "title": "谒金门",
      "content": [
        "歌罢奏。",
        "敛步拂开罗袖。",
        "宝扇轻摇香汗透。",
        "软香沾素手。",
        "小立偎人良久。",
        "一寸娇波横溜。",
        "心事未言眉已皱。",
        "无端催劝酒。"
      ],
      "author": {
        "id": 11270,
        "name": "吕胜己"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314938,
      "title": "谒金门",
      "content": [
        "风又雨。",
        "满地残红无数。",
        "花不能言莺解语。",
        "晓来啼更苦。",
        "把酒东皋日暮。",
        "抵死留春春去。",
        "拟倩杨花寻去处。",
        "杨花无定据。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314991,
      "title": "谒金门",
      "content": [
        "今夜雨。",
        "扫尽一番袢暑。",
        "宛似潇潇鸣远浦。",
        "短蓬何日去。",
        "自漉床头玉醑。",
        "清兴有谁知否。",
        "反笑功名能几许。",
        "槐宫非浪语。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315149,
      "title": "谒金门",
      "content": [
        "灯乍灭。",
        "忽见一天明月。",
        "恰舞霓裳歌未歇。",
        "露寒回绛阙。",
        "羽服明晖玉雪。",
        "笑语轻参环玦。",
        "香泽恼人情不彻。",
        "夜长窗自白。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315181,
      "title": "谒金门",
      "content": [
        "春睡足。",
        "帘卷翠屏山曲。",
        "芳草沿阶横地轴。",
        "垂杨相映绿。",
        "暗忆旧欢难续。",
        "又是禁烟传烛。",
        "陌上踏青新结束。",
        "秋千谁共促。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315281,
      "title": "谒金门",
      "content": [
        "伤漂泊。",
        "负了花前期约。",
        "寒食清明都过却。",
        "愁怀无处著。",
        "晴日柳阴池阁。",
        "风絮斜穿帘幕。",
        "帘外秋千闲彩索。",
        "断肠人寂寞。"
      ],
      "author": {
        "id": 8242,
        "name": "杨冠卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315692,
      "title": "谒金门",
      "content": [
        "遮素月。",
        "云外金蛇明灭。",
        "翻树啼鸦声未彻。",
        "雨声惊落叶。",
        "宝蜡成行嫌热。",
        "玉腕藕花谁雪。",
        "流水高山弦断绝。",
        "怒蛙声自咽。"
      ],
      "author": {
        "id": 8618,
        "name": "辛弃疾"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315693,
      "title": "谒金门",
      "content": [
        "山吐月。",
        "画烛从教风灭。",
        "一曲瑶琴才听彻。",
        "金蕉三两叶。",
        "骤雨微凉还热。",
        "似欠舞琼歌雪。",
        "近日醉乡音问绝。",
        "有时清泪咽。"
      ],
      "author": {
        "id": 8618,
        "name": "辛弃疾"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315786,
      "title": "谒金门",
      "content": [
        "归去未。",
        "风雨送春行李。",
        "一枕离愁头澈尾。",
        "如何消遣是。",
        "遥想归舟天际。",
        "绿鬓珑璁慵理。",
        "好梦未成莺唤起。",
        "粉香犹有𣨼。"
      ],
      "author": {
        "id": 8618,
        "name": "辛弃疾"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315810,
      "title": "谒金门",
      "content": [
        "山共水。",
        "美满一千馀里。",
        "不避晓行并早起。",
        "此情都为你。",
        "不怕与人尤𣨼。",
        "只怕被人调戏。",
        "因甚无个阿鹊地。",
        "没工夫说里。"
      ],
      "author": {
        "id": 8618,
        "name": "辛弃疾"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315836,
      "title": "谒金门",
      "content": [
        "新雨霁。",
        "开遍满园桃李。",
        "波暖池塘风细细。",
        "一双花鸭戏。",
        "唤起春融睡美。",
        "扶醉宿妆慵理。",
        "移步避入花影里。",
        "绣裙低窣地。"
      ],
      "author": {
        "id": 10450,
        "name": "赵善扛"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315991,
      "title": "谒金门",
      "content": [
        "春悄悄。",
        "红到一枝先巧。",
        "酒入半腮微带卯。",
        "粉寒香未饱。",
        "芳意枝头偏闹。",
        "困尽蜂须莺爪。",
        "拟倩玉纤和露拗。",
        "情多愁易搅。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315992,
      "title": "谒金门",
      "content": [
        "花簇簇。",
        "触眼万条垂玉。",
        "小院春深窗锁绿。",
        "水沈风断续。",
        "明月又侵楼曲。",
        "羞向枕囊拘束。",
        "只待夜深清影足。",
        "醉来花底宿。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315993,
      "title": "谒金门",
      "content": [
        "乌帽侧。",
        "行遍杏花春色。",
        "野意青青分陇麦。",
        "人家烟水隔。",
        "春事莫催行客。",
        "弹指青梅堪摘。",
        "醉倚暮天江拍拍。",
        "雨晴沙路白。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315994,
      "title": "谒金门",
      "content": [
        "花半湿。",
        "一霎晚云笼密。",
        "天气未佳风又急。",
        "小庭愁独立。",
        "酒病起来无力。",
        "懊恼篆烟锁碧。",
        "一饷春情无处觅。",
        "小屏山数尺。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315995,
      "title": "谒金门",
      "content": [
        "春夜雨。",
        "催润柳塘花坞。",
        "小院深深门几许。",
        "画帘香一缕。",
        "独立晚庭凝伫。",
        "细把花枝闲数。",
        "燕子不来天欲暮。",
        "说愁无处所。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315996,
      "title": "谒金门",
      "content": [
        "风阵阵。",
        "吹落杨花无定。",
        "酒病厌厌三月尽。",
        "花檀红自隐。",
        "新绿轩窗清润。",
        "月影又移墙影。",
        "手拈青梅无处问。",
        "一春长闷损。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315997,
      "title": "谒金门",
      "content": [
        "浓睡醒。",
        "惊对一帘秋影。",
        "桐叶乍零风不定。",
        "半窗疏雨影。",
        "愁与年光不尽。",
        "老入星星双鬓。",
        "只拟上楼寻远信。",
        "雁遥烟水暝。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316248,
      "title": "谒金门",
      "content": [
        "归不去。",
        "归去又还春暮。",
        "洞里小桃音信阻。",
        "几番风更雨。",
        "相伴竹筇芒履。",
        "穿尽松溪花坞。",
        "早是行人贪道路。",
        "声声闻杜宇。"
      ],
      "author": {
        "id": 11721,
        "name": "石孝友"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316249,
      "title": "谒金门",
      "content": [
        "云树直。",
        "雨歇半空犹湿。",
        "山影插尖高几尺。",
        "依依衔落日。",
        "远岸双飞㶉𫛶。",
        "一水无情自碧。",
        "飒飒白苹风正急。",
        "断肠人独立。"
      ],
      "author": {
        "id": 11721,
        "name": "石孝友"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316250,
      "title": "谒金门",
      "content": [
        "春睡重。",
        "睡起烟销鸾凤。",
        "著雨柳绵吹易动。",
        "风帘花影弄。",
        "过雁空劳目送。",
        "纵有音书何用。",
        "有意相思无意共。",
        "不如休做梦。"
      ],
      "author": {
        "id": 11721,
        "name": "石孝友"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316251,
      "title": "谒金门",
      "content": [
        "风又雨。",
        "断送残春归去。",
        "人面桃花在何处。",
        "绿阴空满路。",
        "立马垂杨官渡。",
        "一寸柔肠万缕。",
        "回首碧云迷洞府。",
        "杜鹃啼日暮。"
      ],
      "author": {
        "id": 11721,
        "name": "石孝友"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316252,
      "title": "谒金门",
      "content": [
        "山雨绝。",
        "山重冷如冰雪。",
        "窗外芭蕉三两叶。",
        "影排窗上月。",
        "醉枕惊回蝴蝶。",
        "好梦无人共说。",
        "心事悠悠芳草歇。",
        "不眠听鼠啮。"
      ],
      "author": {
        "id": 11721,
        "name": "石孝友"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316494,
      "title": "谒金门",
      "content": [
        "风和雨。",
        "又送一番春去。",
        "春去不知何处住。",
        "惜春无觅处。",
        "柳老空抟香絮。",
        "莺娇乍迁芳树。",
        "回念故园如旧否。",
        "不堪闻杜宇。"
      ],
      "author": {
        "id": 9256,
        "name": "赵师侠"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316495,
      "title": "谒金门",
      "content": [
        "江水绿。",
        "江山数峰如簇。",
        "唤渡小舟来岸北。",
        "笋舆行太速。",
        "素艳窗纱笼玉。",
        "埠负看花心目。",
        "今夜知他何处宿。",
        "断魂沙路曲。"
      ],
      "author": {
        "id": 9256,
        "name": "赵师侠"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316496,
      "title": "谒金门",
      "content": [
        "沙畔路。",
        "记得旧时行处。",
        "蔼蔼疏烟迷远树。",
        "野航横不渡。",
        "竹里疏花梅吐。",
        "照眼一川鸥鹭。",
        "家在清江江上住。",
        "水流愁不去。"
      ],
      "author": {
        "id": 9256,
        "name": "赵师侠"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316497,
      "title": "谒金门",
      "content": [
        "风雨急。",
        "红紫又还狼藉。",
        "嫩绿团枝苔径湿。",
        "帘开双燕入。",
        "院静昼闲人寂。",
        "一缕水沈烟直。",
        "心事有谁能会得。",
        "阶前芳草碧。"
      ],
      "author": {
        "id": 9256,
        "name": "赵师侠"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316498,
      "title": "谒金门",
      "content": [
        "风策策。",
        "山迥暮烟横白。",
        "淅沥穿林翻败叶。",
        "羁怀愁倦客。",
        "问宿荒村山驿。",
        "谁识离情脉脉。",
        "雁足无书孤夜色。",
        "音尘千里隔。"
      ],
      "author": {
        "id": 9256,
        "name": "赵师侠"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316499,
      "title": "谒金门",
      "content": [
        "花夜雨。",
        "渺渺绿波南浦。",
        "擘絮晴云山外吐。",
        "凝情谁共语。",
        "十二玉梯空伫。",
        "闲却琐窗朱户。",
        "久客念归归未许。",
        "寸心愁万缕。"
      ],
      "author": {
        "id": 9256,
        "name": "赵师侠"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316500,
      "title": "谒金门",
      "content": [
        "风雨半。",
        "春锁绿杨深院。",
        "幕浪不翻香穗卷。",
        "轻寒闲便面。",
        "归兴新来不浅。",
        "勾引闲愁撩乱。",
        "一枕春酲谁与管。",
        "晓莺惊梦断。"
      ],
      "author": {
        "id": 9256,
        "name": "赵师侠"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316556,
      "title": "谒金门",
      "content": [
        "新雨足。",
        "洗尽山城袢褥。",
        "见说好峰三十六。",
        "峰峰如立玉。",
        "四海英游追逐。",
        "事业相时伸缩。",
        "入境德星须做福。",
        "只愁金诏趣。"
      ],
      "author": {
        "id": 13346,
        "name": "陈亮"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316728,
      "title": "谒金门",
      "content": [
        "归不去。",
        "船泊早春梅渚。",
        "试听玉人歌白苎。",
        "行云无觅处。",
        "翦烛写诗无语。",
        "漠漠寒生窗户。",
        "明日短篷眠夜雨。",
        "宝钗留半股。"
      ],
      "author": {
        "id": 4984,
        "name": "刘过"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316729,
      "title": "谒金门",
      "content": [
        "秋兴恶。",
        "愁怯罗衾风弱。",
        "雨线垂垂晴又落。",
        "轻烟笼翠箔。",
        "休道旅怀萧索。",
        "生怕香浓灰薄。",
        "桂子莫教孤酒约。",
        "诗情浑落魄。"
      ],
      "author": {
        "id": 4984,
        "name": "刘过"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316787,
      "title": "谒金门",
      "content": [
        "春寂寂。",
        "节物又催寒食。",
        "楼上卷帘双燕入。",
        "断魂愁似织。",
        "门外雨馀风急。",
        "满地落英红湿。",
        "好梦惊回无处觅。",
        "天涯芳草碧。"
      ],
      "author": {
        "id": 1511,
        "name": "卢炳"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316788,
      "title": "谒金门",
      "content": [
        "春事寂。",
        "苦笋鲥鱼初食。",
        "风卷绣帘飞絮入。",
        "柳丝萦似织。",
        "迅速韶光去急。",
        "过雨绿阴尤湿。",
        "回首旧游何处觅。",
        "远山空伫碧。"
      ],
      "author": {
        "id": 1511,
        "name": "卢炳"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316789,
      "title": "谒金门",
      "content": [
        "门巷寂。",
        "梅豆微酸怯食。",
        "别恨萦心愁易入。",
        "寸肠如网织。",
        "去橹咿哑声急。",
        "泪滴春衫轻湿。",
        "尺素待凭鱼雁觅。",
        "远烟凝处碧。"
      ],
      "author": {
        "id": 1511,
        "name": "卢炳"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316995,
      "title": "谒金门",
      "content": [
        "檐溜滴。",
        "都是春归消息。",
        "带雨牡丹无气力。",
        "黄鹂愁雨湿。",
        "争看洛阳春色。",
        "忘却连天草碧。",
        "南浦绿波双桨急。",
        "沙头人伫立。"
      ],
      "author": {
        "id": 10066,
        "name": "汪莘"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 317017,
      "title": "谒金门",
      "content": [
        "天色晚。",
        "云外一筝斜雁。",
        "独凭阑干秋满眼。",
        "菊花寒尚浅。",
        "叶落香沟红泛。",
        "懒把新诗题怨。",
        "何处笛声三弄断。",
        "月迟帘未卷。"
      ],
      "author": {
        "id": 3680,
        "name": "赵"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 317056,
      "title": "谒金门",
      "content": [
        "春睡起。",
        "小阁明窗儿底。",
        "帘外雨声花积水。",
        "薄寒犹在里。",
        "欲起还慵未起。",
        "好是孤眠滋味。",
        "一曲广陵应忘记。",
        "起来调绿绮。"
      ],
      "author": {
        "id": 8887,
        "name": "张履信"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 317058,
      "title": "谒金门",
      "content": [
        "秋欲暮。",
        "路入乱山深处。",
        "扑面西风吹雾雨。",
        "驿亭欣暂驻。",
        "可惜国香风度。",
        "空谷寂寥谁顾。",
        "已作竹枝传楚女。",
        "客愁推不去。"
      ],
      "author": {
        "id": 9121,
        "name": "徐"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 317059,
      "title": "谒金门",
      "content": [
        "春欲半。",
        "重到寂寥山馆。",
        "修竹连山青不断。",
        "谁家门可款。",
        "红晕花梢未半。",
        "绿蘸柳芽犹短。",
        "金缕香消春不管。",
        "素蟾光又满。"
      ],
      "author": {
        "id": 9121,
        "name": "徐"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 317184,
      "title": "谒金门",
      "content": [
        "香篆袅。",
        "瓶里梅英犹小。",
        "鸳瓦霜华睛欲晓。",
        "今年生日好。",
        "鬓绿颜朱不老。",
        "女嫁儿婚将了。",
        "四世团栾同一笑。",
        "人间如此少。"
      ],
      "author": {
        "id": 2985,
        "name": "郭应祥"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 317252,
      "title": "谒金门",
      "content": [
        "花影半。",
        "晴色乍开云卷。",
        "择胜寻春愁日短。",
        "雨馀山路晚。",
        "涧底桃深红满。",
        "人意不禁闲远。",
        "胡蝶绕枝啼鸟怨。",
        "东风吹酒面。"
      ],
      "author": {
        "id": 11972,
        "name": "韩淲"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 317263,
      "title": "谒金门",
      "content": [
        "花肃肃。",
        "杨柳三眠未足。",
        "一棹溪山新涨绿。",
        "旧欢无梦续。",
        "莫问杜鹃啼蜀。",
        "只有江南水竹。",
        "北客凄凉无伴独。",
        "春山生草木。"
      ],
      "author": {
        "id": 11972,
        "name": "韩淲"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 317264,
      "title": "谒金门",
      "content": [
        "幽意熟。",
        "吟啸春风自足。",
        "爽气初生晴未燠。",
        "相逢休问卜。",
        "画出高山盘谷。",
        "岩上飞云相逐。",
        "他日江东思渭北。",
        "断舷谁为续。"
      ],
      "author": {
        "id": 11972,
        "name": "韩淲"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 317298,
      "title": "谒金门",
      "content": [
        "春尚早。",
        "春入湖山渐好。",
        "人去人来虽未老。",
        "酒徒犹恨少。",
        "梅落桃开烟岛。",
        "日日更吹香草。",
        "一片芳心拚醉倒。",
        "冷云藏落照。"
      ],
      "author": {
        "id": 11972,
        "name": "韩淲"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 317312,
      "title": "谒金门",
      "content": [
        "行又住。",
        "水远山遥村路。",
        "把酒问春春几许。",
        "老年花似雾。",
        "坐上风流张绪。",
        "留我我还难去。",
        "却忆章台飞柳絮。",
        "只愁萦暮雨。"
      ],
      "author": {
        "id": 11972,
        "name": "韩淲"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 317360,
      "title": "谒金门",
      "content": [
        "风乍扇。",
        "帘外落红千片。",
        "飞尽落花春不管。",
        "斗忙莺与燕。",
        "往事上心撩乱。",
        "睡起日高犹倦。",
        "料得伊家情眷眷。",
        "近来长梦见。"
      ],
      "author": {
        "id": 9877,
        "name": "吴礼之"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 317376,
      "title": "谒金门",
      "content": [
        "花过雨。",
        "又是一番红素。",
        "燕子归来衔绣幕。",
        "旧巢无觅处。",
        "谁在玉楼歌舞。",
        "谁在玉关辛苦。",
        "若使胡尘吹得去。",
        "东风侯万户。"
      ],
      "author": {
        "id": 3785,
        "name": "李好义"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 317423,
      "title": "谒金门",
      "content": [
        "烟漠漠。",
        "醉里看春都错。",
        "过了清明迟一著。",
        "牡丹重约摸。",
        "晓日渐明檐角。",
        "天与芳辰难却。",
        "驻得韶华元有药。",
        "桃源谁共约。"
      ],
      "author": {
        "id": 10711,
        "name": "程珌"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 317778,
      "title": "谒金门",
      "content": [
        "那复有。",
        "气味醲于春酒。",
        "犹向故乡怀印绶。",
        "相过何日又。",
        "吐出心肠锦绣。",
        "问我阿娘依旧。",
        "娘亦祝君如柏寿。",
        "相看霜雪后。"
      ],
      "author": {
        "id": 6995,
        "name": "魏了翁"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 317918,
      "title": "谒金门",
      "content": [
        "花似匝。",
        "两点翠蛾愁压。",
        "人又不来春且恰。",
        "谁留春一霎。",
        "消尽水沈金鸭。",
        "写尽杏笺红蜡。",
        "可奈薄情如此黠。",
        "寄书浑不答。"
      ],
      "author": {
        "id": 7033,
        "name": "李从周"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 317945,
      "title": "谒金门",
      "content": [
        "风不定。",
        "移去移来帘影。",
        "一雨林塘新绿净。",
        "杏梁归燕并。",
        "翠袖玉屏金镜。",
        "日薄绮疏人静。",
        "心事一春疑酒病。",
        "鸟啼花满径。"
      ],
      "author": {
        "id": 12933,
        "name": "卢祖皋"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 317946,
      "title": "谒金门",
      "content": [
        "兰棹举。",
        "相趁落红飞去。",
        "一隙轻帘凝睇处。",
        "柳丝牵不住。",
        "昨日翠蛾金缕。",
        "今夜碧波烟渚。",
        "好梦无凭窗又雨。",
        "天涯知几许。"
      ],
      "author": {
        "id": 12933,
        "name": "卢祖皋"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 317947,
      "title": "谒金门",
      "content": [
        "间院宇。",
        "独自行来行去。",
        "花片无声帘外雨。",
        "峭寒生碧树。",
        "做弄清明时序。",
        "料理春酲情绪。",
        "忆得归时停棹处。",
        "画桥看落絮。"
      ],
      "author": {
        "id": 12933,
        "name": "卢祖皋"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 317948,
      "title": "谒金门",
      "content": [
        "深院静。",
        "隔叶鸣禽相应。",
        "金鸭云寒闲梦醒。",
        "转帘花月影。",
        "闲步碧阶香径。",
        "亸翠残红慵整。",
        "明日阴晴犹未定。",
        "试教移小艇。"
      ],
      "author": {
        "id": 12933,
        "name": "卢祖皋"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 317949,
      "title": "谒金门",
      "content": [
        "寒半退。",
        "斜掩小屏珠翠。",
        "柳眼才醒桃欲醉。",
        "日高帘影碎。",
        "暗解鸳鸯罗带。",
        "独立晚风谁会。",
        "心事悠悠人好在。",
        "画桥流水外。"
      ],
      "author": {
        "id": 12933,
        "name": "卢祖皋"
      },
      "dynasty": {
