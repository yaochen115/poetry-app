        "name": "七言律诗"
      }
    },
    {
      "id": 197745,
      "title": "次韵毛君绝句",
      "content": [
        "中池有士闭重关，夜发天光走玉环。",
        "白日对人人不识，幅巾破褐任尘漫。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
