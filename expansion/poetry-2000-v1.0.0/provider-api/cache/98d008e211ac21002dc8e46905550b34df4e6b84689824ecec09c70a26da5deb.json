{
  "data": [
    {
      "id": 197648,
      "title": "衢州赵阅道少师濯缨亭",
      "content": [
        "挂冠缨上已无尘，犹爱溪光碧照人。",
        "点检旧游黄石在，扫除诸念白鸥亲。",
        "一尊父老囊金尽，三径松筠生事贫。",
        "他日南公数人物，丹青添入县图新。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 197649,
      "title": "茶花二首  其一",
      "content": [
        "黄蘗春芽大麦粗，倾山倒谷采无余。",
        "久疑残枿阳和尽，尚有幽花霰雪初。",
        "耿耿清香崖菊淡，依依秀色岭梅如。",
        "经冬结子犹堪种，一亩荒园试为鉏。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 197650,
      "title": "茶花二首  其二",
      "content": [
        "细嚼花须味亦长，新芽一粟叶间藏。",
        "稍经腊雪侵肌瘦，旋得春雷发地狂。",
        "开落空山谁比数，烝烹来岁最先尝。",
        "枝枯叶硬天真在，踏遍牛羊未改香。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 197651,
      "title": "次韵毛君山房即事十首  其一",
      "content": [
        "案牍稀疏意自开，夜阑幽梦晓方回。",
        "青苔红叶骚人事，时见诗筒去又来。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 197652,
      "title": "次韵毛君山房即事十首  其二",
      "content": [
        "东晋仙人借旧山，定应天意许公闲。",
        "郡人欲问史君处，笑指峰峦紫翠间。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 197653,
      "title": "次韵毛君山房即事十首  其三",
      "content": [
        "蛩知秋候时鸣壁，香碍蒲帘不出门。",
        "隠几无言心有得，南窗晴日暖侵轩。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 197654,
      "title": "次韵毛君山房即事十首  其四",
      "content": [
        "溪山付与醉中仙，美酒何曾斗十千。",
        "就得江边贱鱼稻，闲官未用苦相怜。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 197655,
      "title": "次韵毛君山房即事十首  其五",
      "content": [
        "忘身先要解忘名，分别须臾起不平。",
        "请看早朝霜入屦，何如卧听打衙声。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 197656,
      "title": "次韵毛君山房即事十首  其六",
      "content": [
        "禽哢秋来不复圆，桐阴霜后亦成穿。",
        "黄花强欲招酣饮，白发偏工报老年。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 197657,
      "title": "次韵毛君山房即事十首  其七",
      "content": [
        "邂逅清欢屡不期，病来无奈羽觞飞。",
        "醉乘篮轝江边去，长伴渔舟月下归。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 197658,
      "title": "次韵毛君山房即事十首  其八",
      "content": [
        "醉里题诗偏韵恶，秋来劝酒益杯深。",
        "不才多病俱非敌，绿绮缘何得报金。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 197659,
      "title": "次韵毛君山房即事十首  其九",
      "content": [
        "庵中独宿雨垂垂，永夜无人款竹扉。",
        "灰冷铜炉香欲灭，床头一点葛灯微。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 197660,
      "title": "次韵毛君山房即事十首  其一○",
      "content": [
        "触事随缘不用多，华堂玉食奈忧何。",
        "美人未厌山阿陋，薜荔为裳带女萝。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 197661,
      "title": "再和十首  其一",
      "content": [
        "涧草岩花日日开，江南秋尽似春回。",
        "旋开还落无人顾，惟有山蜂暖尚来。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 197662,
      "title": "再和十首  其二",
      "content": [
        "江上孤城面面山，居人也自不曾闲。",
        "蜂游蚁聚知何事，日夜长桥南北间。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 197663,
      "title": "再和十首  其三",
      "content": [
        "城郭村墟共水云，槿篱竹屋映柴门。",
        "隠居亦有高人在，岸帻无言倚钓轩。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 197664,
      "title": "再和十首  其四",
      "content": [
        "一官疏散自疑仙，三考应成醉日千。",
        "早病固须闲地著，多忧长被达人怜。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 197665,
      "title": "再和十首  其五",
      "content": [
        "养生尤复要功圆，溜滴南溪石自穿。",
        "近见牢山陈道士，微言约我更三年。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 197666,
      "title": "再和十首  其六",
      "content": [
        "张公诗社见公名，白首山城叹不平。",
        "坐客要闻新乐府，应须湓口琵琶声。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 197667,
      "title": "再和十首  其七",
      "content": [
        "高情日与故山期，鸿鹄谁言也倦飞。",
        "且听渔人强哺啜，坐中羁客畏公归。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 197668,
      "title": "再和十首  其八",
      "content": [
        "天为多才故欲禁，府门摧落涨江深。",
        "鼎新翠壁排精铁，涌出飞楼直百金。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 197669,
      "title": "再和十首  其九",
      "content": [
        "楼上青山绕四垂，画桥百步引朱扉。",
        "落成当与公同上，一看长江白练微。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 197670,
      "title": "再和十首  其一○",
      "content": [
        "歌舞留宾意自多，华灯数问夜如何。",
        "白头病客无才思，惯卧茅檐长薜萝。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 197671,
      "title": "筠州二咏 牛尾狸",
      "content": [
        "首如狸，尾如牛，攀条捷险如猱猴。",
        "橘柚为浆栗为糇，筋肉不足惟膏油。",
        "深居简出善自谋，寻踪发窟并执囚，蓄租分散身为羞。",
        "松薪瓦甑烝浮浮，压入糟盎肥欲流，熊肪羊酪真比俦。",
        "引筯将举讯何尤，无功窃食人所仇。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 197672,
      "title": "筠州二咏 黄雀",
      "content": [
        "秋风下，黄雀飞。",
        "禾田熟，黄雀肥。",
        "群飞蔽空日色薄，逡巡百顷禾为稀，翾翻巧捷多且微。",
        "精丸妙缴举辄违，乘时席势不可挥。",
        "一朝风雨寒霏霏，肉多翅重天时非，农夫举网惊合围。",
        "悬颈系足肤无衣，百个同缶仍相依，头颅万里行不归。",
        "北方居人厌羔豨，咀噍聊发一笑欷。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 197673,
      "title": "和毛君新葺囷庵船斋",
      "content": [
        "厌居华屋住东庵，真味全胜食荠甘。",
        "多病维摩长隠几，无心弥勒便同龛。",
        "误游田舍空成笑，谬入僧房即欲参。",
        "风霁不知吹有万，月明聊共影成三。",
        "斋如小舫才容住，室类空囷定不贪。",
        "拥褐放衙人寂寂，脱巾漉酒鬓𩭹𩭹。",
        "画囊书帙堆窗案，药裹瓢樽挂壁蓝。",
        "檐竹风霜曾不到，盆花蜂蝶未全谙。",
        "公余野鹊惊初睡，宾醉佳人笑剧谈。",
        "劝客巨觥那得避，和诗难韵不容探。",
        "晓来霏雾连江气，冬后温风带岭岚。",
        "去国屡成还蜀梦，忘忧惟有对公酣。",
        "终身狥禄知何益，投檄归耕贫未堪。",
        "借我此庵泥药灶，古书鸿宝试淮南。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 197674,
      "title": "寒雨",
      "content": [
        "江南殊气候，冬雨作春寒。",
        "冰雪期方远，蕉𫄨意始阑。",
        "未妨溪草绿，先恐岭梅残。",
        "忽发中原念，貂裘据锦鞍。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 197675,
      "title": "积雨二首  其一",
      "content": [
        "山雨无时歇，江波上岸流。",
        "泥深未免出，桥断更堪忧。",
        "房浅邻糟瓮，宵寒揽絮裘。",
        "朝来势未已，归路恐操舟。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 197676,
      "title": "积雨二首  其二",
      "content": [
        "微阳力尚浅，未解破重阴。",
        "云气山川满，江流日夜深。",
        "冻牙生滞穗，余润及重衾。",
        "泥泞沉车毂，农输绝苦心。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 197677,
      "title": "戏赠李朝散",
      "content": [
        "江雾霏霏作雪天，樽前醉倒不知寒。",
        "后堂桃李春犹晚，试觅酥花子细看。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 197678,
      "title": "戏答",
      "content": [
        "银瓶泻酒正霜天，玉麈生风夜更寒。",
        "下客不辞投辖饮，好花犹恐隔帘看。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 197679,
      "title": "临江萧氏家宝堂",
      "content": [
        "高人不解作生涯，唯有中堂书五车。",
        "竹简多于孔氏壁，牙签新似邺侯家。",
        "田园岂是子孙计，青紫今为里巷夸。",
        "富贵早知皆有命，君应未厌十年赊。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 197680,
      "title": "和萧刓察推贺族叔司理登科还乡四首  其一",
      "content": [
        "家声籍籍大江西，临老挥毫捧御题。",
        "得意何殊少年乐，还家不惜醉如泥。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 197681,
      "title": "和萧刓察推贺族叔司理登科还乡四首  其二",
      "content": [
        "读尽家藏万卷书，萧然华发宦游初。",
        "区区狱掾何须愧，聊把春秋试绪余。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 197682,
      "title": "和萧刓察推贺族叔司理登科还乡四首  其三",
      "content": [
        "作官未减读书勤，簿领从今日日新。",
        "汗简韦编谁付予，传家应有下帷人。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 197683,
      "title": "和萧刓察推贺族叔司理登科还乡四首  其四",
      "content": [
        "巷南诸子足才贤，邂逅相逢秀句传。",
        "强作短章同寄与，异时见我一依然。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 197684,
      "title": "次韵吴厚秀才见赠三首  其一",
      "content": [
        "骚人思苦骨岩岩，百里携诗相就谈。",
        "故作微词挑迁客，不嫌春雨湿归衫。",
        "少年旧喜登高赋，老病今成见敌惭。",
        "问我近来谁复可，对君聊拟诵周南。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 197685,
      "title": "次韵吴厚秀才见赠三首  其二",
      "content": [
        "久欲归田计未成，羡君负郭足为生。",
        "躬耕不用千钟禄，高卧谁知万里征。",
        "已觉安闲真乐事，可怜辛苦尽浮名。",
        "隠居便作江南计，为觅佳山早寄声。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 197686,
      "title": "次韵吴厚秀才见赠三首  其三",
      "content": [
        "一卷新诗锦一端，掉头吟讽识芳酸。",
        "哀歌永夜悲牛角，朗咏扁舟笑杏坛。",
        "间发笙簧犹可拟，弃捐斤斧定知难。",
        "继君高韵君应笑，咀嚼归途久据鞍。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 197687,
      "title": "次韵毛君烧松花六绝  其一",
      "content": [
        "茅庵纸帐学僧眠，炉𦶟松花取易然。",
        "唯有未能忘酒在，手倾金盏斗垂莲。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 197688,
      "title": "次韵毛君烧松花六绝  其二",
      "content": [
        "餠杂松黄二月天，盘敲松子早霜寒。",
        "山家一物都无弃，狼籍干花最后般。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 197689,
      "title": "次韵毛君烧松花六绝  其三",
      "content": [
        "松老香多气自严，余烟勃鬰透疏帘。",
        "须臾过尽惟灰在，借问谁收一番炎。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 197690,
      "title": "次韵毛君烧松花六绝  其四",
      "content": [
        "美人寒甚懒开扉，金作松花插羃䍠。",
        "几度低头疑堕落，青烟已断未消时。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 197691,
      "title": "次韵毛君烧松花六绝  其五",
      "content": [
        "枯萼鳞皴不复坚，重重正似半开莲。",
        "曾经樵舍砖炉见，未许邦君画合然。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 197692,
      "title": "次韵毛君烧松花六绝  其六",
      "content": [
        "黄蜡供炊自一家，锱铢贫富递矜夸。",
        "都城争买方薪贵，却顾松花已自奢。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 197693,
      "title": "陪毛君游黄仙观",
      "content": [
        "李叟仙居仍近市，黄公道院亦依城。",
        "定应昔日山林地，未有今时鸡犬声。",
        "白鹤翻飞终不返，黄冠憔悴只躬耕。",
        "试从车骑寻遗迹，恐有居人解养生。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 197694,
      "title": "次韵王适梅花",
      "content": [
        "江梅似欲竞新年，照水窥林态愈妍。",
        "霜重清香浑欲滴，月明素质自生烟。",
        "未成细实酸犹薄，半落南枝意可怜。",
        "谁写江西风物样，徐家旧有数枝传。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 197695,
      "title": "次韵王适春雪二首  其一",
      "content": [
        "江南春候寒犹剧，细雨风吹作雪花。",
        "中夜窗扉初晃漾，平明草木半低斜。",
        "润催江柳排金绿，光杂山茶点绛葩。",
        "老病不堪乘晓出，纷纷能使发增华。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 197696,
      "title": "次韵王适春雪二首  其二",
      "content": [
        "春雪飘摇旋不成，依稀履迹散空庭。",
        "山藏复阁犹残白，日照南峰已半青。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 197697,
      "title": "毛君惠温柑荔支二绝  其一",
      "content": [
        "楚山黄橘弹丸小，未识洞庭三寸柑。",
        "不有风流吴越客，谁令千里送江南。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 197698,
      "title": "毛君惠温柑荔支二绝  其二",
      "content": [
        "荔子生红无奈远，陈家晒白到犹难。",
        "虽无驿骑红尘起，尚得佳人一笑欢。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 197699,
      "title": "次韵王适游真如寺",
      "content": [
        "江上春雨过，城中春草深。",
        "扰扰市井尘，悠悠溪谷心。",
        "东郊大愚山，自古薝卜林。",
        "微言久不闻，坠绪谁当寻。",
        "道俗数百人，请闻海潮音。",
        "斋罢车马散，万籁俱消沉。",
        "新亭面南山，积雾开重阴。",
        "萧然偶有得，怀抱方愔愔。",
        "我坐米盐间，日被尘垢侵。",
        "不知山中趣，强作山中吟。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 197700,
      "title": "次韵王适新燕",
      "content": [
        "好雨纤纤润客衣，新来双燕力犹微。",
        "似嫌春早无人见，故待帘开掠地飞。",
        "南国花期知不远，中原寒剧未应归。",
        "养雏不怕巢成早，记取朝朝为启扉。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 197701,
      "title": "官居即事",
      "content": [
        "官局纷纭簿领迷，生缘琐细老农齐。",
        "偷安旋种十年木，肉食还须五母鸡。",
        "对酒不尝怜酤榷，钓鱼无术漫临溪。",
        "此身已分长贫贱，执爨缝裳愧老妻。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 197702,
      "title": "陪毛君夜游北园",
      "content": [
        "池塘草生春尚浅，桃李飞花初片片。",
        "一尊花下夜忘归，灯火寻春畏春晚。",
        "春风暗度人不知，满园红白已离披。",
        "江南春雨少晴日，露坐青天能几时。",
        "折花只恐伤花意，携客就花花定喜。",
        "落蕊飘香翠袖中，交柯接叶灯光里。",
        "雨练风柔雪不如，精神炫转影扶疏。",
        "夜看飞燕胜朝日，月暗还须明月珠。",
        "美人劝我殊非恶，明日雨来无此乐。",
        "醉归不用怕山公，马上接䍠先倒著。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 197703,
      "title": "山橙花口号",
      "content": [
        "故乡寒食荼䕷发，百和香浓村巷深。",
        "漂泊江南春欲尽，山橙仿佛慰人心。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 197704,
      "title": "次韵冯弋同年",
      "content": [
        "细雨蒙蒙江雾昏，坐曹聊且免泥奔。",
        "卖盐酤酒知同病，一笑何劳赋北门。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 197705,
      "title": "送王适徐州赴举",
      "content": [
        "送别江南春雨淫，北方谁是子知音。",
        "性如白玉烧犹冷，文似朱弦叩愈深。",
        "万里同舟宽老病，一杯分袂发悲吟。",
        "明年榜上看名姓，杨柳春风正似今。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 197706,
      "title": "游吴氏园",
      "content": [
        "细雨作寒晴便暖，好风吹袂意初佳。",
        "清池解洗春心热，红艳能添醉眼花。",
        "紫竹暗生岷岫笋，山丹强比洛人家。",
        "怜渠巧与闲官便，申退来游未觉赊。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 197707,
      "title": "江州周寺丞泳夷亭",
      "content": [
        "行过庐山不得上，湓江城边一惆怅。",
        "羡君山下有夷亭，千岩万壑长相向。",
        "山中李生好读书，出山作郡山前居。",
        "手开平湖浸山脚，未肯即与庐山疏。",
        "道州一去应嫌远，千里思山梦中见。",
        "青山长见恐君嫌，要须罢郡归来看。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 197708,
      "title": "次韵毛君游陈氏园",
      "content": [
        "增筑园亭草木新，损花风雨怨频频。",
        "筼筜似欲迎初暑，芍药犹堪送晚春。",
        "薄暮出城仍有伴，携壶藉草更无巡。",
        "归轩有喜知谁见，道上从横满醉人。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 197709,
      "title": "江涨",
      "content": [
        "山中三日雨，江水一丈高。",
        "崩腾没洲渚，淫溢浸蓬蒿。",
        "凌晨我有适，出门舟自操。",
        "中廛已易肆，下道先容舠。",
        "鸡犬萃坟冢，牛羊逾圈牢。",
        "厨薪散流枿，囷米为浮糟。",
        "卧席不遑卷，剥茧仍未缫。",
        "老弱但坐视，闾里将安逃。",
        "徙居共扰扰，来势方滔滔。",
        "嗟余偶同病，哀尔为生劳。",
        "晴日慰人愿，寒风送惊涛。",
        "藩篱出旧趾，蠃蚌遗平皋。",
        "流窜非择地，艰难理宜遭。",
        "胡为苦戚戚，一夕生二毛。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 197710,
      "title": "和子瞻铁拄杖",
      "content": [
        "截竹为杖瘦且轻，石坚竹破误汝行。",
        "削木为杖轻且好，道远木折恐不到。",
        "闽君铁杖七尺长，色如黑蛇气如霜。",
        "提携但恐汝无力，撞坚过崄安能伤。",
        "柳公虽老尚强健，闭门却扫不复将。",
        "知公足力无险阻，怜公未有登山侣。",
        "回生四海惟一身，袖中长剑为两人。",
        "洞庭漫天不觉过，半酣起舞惊鬼神。",
        "愿公此杖亦如此，适意遨游日千里。",
        "归来倚壁示时人，海外苍茫空自记。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 197711,
      "title": "竞渡",
      "content": [
        "史君欲听榜人讴，一夜江波拍岸流。",
        "父老不知招屈恨，少年争作弄潮游。",
        "长鲸破浪聊堪比，小旆逆风殊未收。",
        "角胜争先非老事，凭栏寓目思悠悠。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 197712,
      "title": "登郡谯偶见姜应明司马醉归",
      "content": [
        "苍然莫色映楼台，江市游人夜未回。",
        "何处酒仙无一事，肩舆鼾睡过桥来。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 197713,
      "title": "送姜司马",
      "content": [
        "七岁立谈明主前，江湖晚节弄渔船。",
        "斗鸡谁识城东老，丧马方知塞上贤。",
        "生计未成归去咏，草书时发醉中颠。",
        "当年不解看齐物，气踊如山谁见怜。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 197714,
      "title": "寄题赵㞦承事戏彩堂",
      "content": [
        "春晚安舆遍浙东，永嘉别乘喜无穷。",
        "橐装已笑分诸子，吏道何劳问薛公。",
        "堂上寿樽诸掾集，室中禅论衲僧通。",
        "兴阑却返林泉去，幕府长留孝弟风。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 197715,
      "title": "次韵温守李钧见寄兼简毛大夫",
      "content": [
        "梁苑相从簿领中，清风相逐画船东。",
        "婆娑江海凌云鹤，饮啄笼樊失渚鸿。",
        "别后丹砂迷旧诀，愁来白发变衰翁。",
        "此间诗老仍勍敌，正忆高吟酒盏空。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 197716,
      "title": "次韵洞山克文长老",
      "content": [
        "无地容锥卓，年来转觉贫。",
        "偶知珠在手，一任甑生尘。",
        "窜逐非关性，颠狂却甚真。",
        "此心谁复识，试语洞山人。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 197717,
      "title": "试院唱酬十一首 戏呈试官吕防",
      "content": [
        "新秋风月正凉天，空馆相看学坐禅。",
        "满榻诗书愁病眼，隔墙砧杵思高眠。",
        "霜飞一叶凋琼玉，风绕双松奏管弦。",
        "闻道熊罴归梦数，侵天闱棘漫森然。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 197718,
      "title": "试院唱酬十一首 次韵吕君丰城宝气亭",
      "content": [
        "紫气飞空不自谋，谁怜黾勉匣中留。",
        "西山猛兽横行甚，北海长鲸何日收。",
        "星斗不堪供醉舞，蛟龙会看反重湫。",
        "功成变化无踪迹，望断中原百尺楼。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 197719,
      "title": "试院唱酬十一首 次韵吕君见赠",
      "content": [
        "偶然倾盖接清言，不觉门前昼漏传。",
        "老病低摧方伏枥，壮心坚锐正当年。",
        "莫嫌客舍一杯酒，试论灊山三祖禅。",
        "明日程文堆几案，只应衰懒得安眠。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 197720,
      "title": "试院唱酬十一首 次韵吕君兴善寺静轩",
      "content": [
        "自恨寻山计苦迟，年过四十始知非。",
        "小轩迎客如招隠，野鸟窥人自识机。",
        "窗外竹深孤鹤下，阶前菊秀晚蜂飞。",
        "老僧战胜长幽寂，瘦骨缘何未肯肥。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 197721,
      "title": "试院唱酬十一首 观试进士呈试官",
      "content": [
        "松庭散朝日，棘户启秋风。",
        "鹄鹭纷来下，旌旗俨未攻。",
        "驰词看倚马，余力送征鸿。",
        "逸足谁先到，孤标想暗空。",
        "晶荧双镜并，高下片言公。",
        "老病方耽睡，飞沉一梦中。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 197722,
      "title": "试院唱酬十一首 次前韵",
      "content": [
        "南国号多士，几人洙泗风。",
        "英材自入彀，坏阵不劳攻。",
        "文缛山藏豹，飞高弋慕鸿。",
        "蚩妍归品藻，得失付虚空。",
        "考行先推本，登贤旋奏公。",
        "期君缓归辔，一醉鹿鸣中。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 197723,
      "title": "试院唱酬十一首 戏呈试官",
      "content": [
        "只隔墙东便是家，悁悁还似在天涯。",
        "客心不耐听松雨，归信犹堪饮菊花。",
        "翦烛看书良寂寞，披沙见玉忽喧哗。",
        "自惭空馆难留客，试问姮娥稍驻车。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 197724,
      "title": "试院唱酬十一首 次前韵三首 其一",
      "content": [
        "老去在家同出家，楞伽四卷即生涯。",
        "粗诗怪我心犹壮，细字怜君眼未花。",
        "霜落初惊衾簟冷，酒酣犹喜笑言哗。",
        "归心知有三秋恨，莫学匆匆下坂车。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 197725,
      "title": "试院唱酬十一首 次前韵三首 其二",
      "content": [
        "门前溪水似渔家，流浪江湖归未涯。",
        "邂逅高人来说法，支离枯木旋开花。",
        "诸生试罢书如积，剧县归时讼正哗。",
        "安得骑鲸从李白，试看牛女转云车。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 197726,
      "title": "试院唱酬十一首 次前韵三首 其三",
      "content": [
        "浊醪能使客忘家，屈指归期已有涯。",
        "鱼化昨宵惊细雨，鹿鸣他日饮寒花。",
        "已谙江上肴蔬薄，莫笑衙前鼓笛哗。",
        "太守况兼乡曲旧，会须投辖止行车。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 197727,
      "title": "试院唱酬十一首 试罢后偶作",
      "content": [
        "重门闭不开，乌鸟相呼乐。",
        "晨晖转帘影，微风响松末。",
        "喧哗适已定，寂历方有觉。",
        "人生竟何事，外物巧相缚。",
        "当时不自悟，已过空成怍。",
        "耕耘亦何苦，游宦殊自恶。",
        "弃彼既已误，就此良应错。",
        "谁能即两忘，随缘更无作。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 197728,
      "title": "放榜后次韵毛守见招",
      "content": [
        "饱食安眠愧不材，疏帘翠帟幸相陪。",
        "深居正厌银袍乱，失喜初闻铁锁开。",
        "佳句径蒙探古锦，小槽仍报滴新醅。",
        "诸人欲见风流伯，不用招呼亦自来。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 197729,
      "title": "送毛滂斋郎",
      "content": [
        "先志承颜善养亲，束装骑马试为臣。",
        "酒肠天予浑无敌，诗律家传便出人。",
        "拥鼻高吟方自得，折腰奔走渐劳神。",
        "归来一笑须勤取，花发陈吴二月春。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 197730,
      "title": "燕贡士",
      "content": [
        "泮水生芹藻，干旄在浚城。",
        "桑鸮同变响，苹鹿共和鸣。",
        "秋晚槐先堕，霜多桂向荣。",
        "清尊助劝驾，急管发欢声。",
        "勇锐青衿士，淹通白发生。",
        "芬芳杂兰菊，变化等鹍鲸。",
        "去日衣冠盛，归时里巷惊。",
        "坐中词赋客，愧尔一经明。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 197731,
      "title": "次韵毛君清居探菊",
      "content": [
        "眼前黄叶畏秋霜，耳畔啼蛩怨夜长。",
        "佳节欣闻近萸菊，清商试为奏伊凉。",
        "疏狂久笑谋生拙，贫病应怜为口忙。",
        "今日共君拚一醉，从教人道亦高阳。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 197732,
      "title": "次韵毛君见赠",
      "content": [
        "江国骚人不耐秋，夜吟清句晓相投。",
        "锋藏岂愿囊中脱，尾断终非俎上羞。",
        "择地何年真得意，𫗦糟是处可同游。",
        "南迁尚有公知我，人事何须更预谋。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 197733,
      "title": "次韵毛君偶成",
      "content": [
        "年来衰病正相兼，薄宦奔驰尚未厌。",
        "诗句空多浑漫兴，俗缘已重不须添。",
        "聱牙向物知难合，疏懒怜公独未嫌。",
        "时听渊明咏归去，犹应为我故迟淹。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 197734,
      "title": "孔平仲著作江州官舍小庵",
      "content": [
        "近山不作看山计，引水新成照水庵。",
        "闭口忘言中自饱，安心度日更谁参。",
        "简编围绕穿书蠹，窗户低回作茧蚕。",
        "我亦一轩容膝住，敝裘粗饭有余甘。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 197735,
      "title": "送饶州周沃秀才免解",
      "content": [
        "少年工作赋，中岁复穷经。",
        "骥老终知道，剑埋新发硎。",
        "束装邻里助，答策友朋听。",
        "还似临淄贡，随风起北溟。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 197736,
      "title": "雪中洞山黄蘗二禅师相访",
      "content": [
        "江南气暖冬未回，北风吹雪真快哉。",
        "雪中访我二大士，试问此雪从何来。",
        "君不见六月赤日起冰雹，又不见腊月幽谷寒花开。",
        "纷然变化一弹指，不妨明镜无纤埃。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 197737,
      "title": "毛国镇生日二绝  其一",
      "content": [
        "生日元同小赵公，里闾相接往还通。",
        "怪公日夜归心切，欲寄此生丹灶中。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 197738,
      "title": "毛国镇生日二绝  其二",
      "content": [
        "闻公归橐尚空虚，近送楞严十卷书。",
        "心地本无生灭处，定逢生日亦如如。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 197739,
      "title": "次韵毛君将归",
      "content": [
        "疏傅思归不待时，孟轲出昼苦行迟。",
        "新诗尚许留章句，故事谁从问典彝。",
        "金马尚应堪避世，石泉未信可忘饥。",
        "不才似我真当去，零落衡茅隔雍岐。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 197740,
      "title": "送杨腾山人",
      "content": [
        "胸中万卷书，不如一囊钱。",
        "不见杨夫子，岁晚走道边。",
        "夜归空床卧，两手摩涌泉。",
        "窗前雪花落，真火中自然。",
        "涣然发微润，飞上昆仑颠。",
        "霏霏雨甘露，稍稍流丹田。",
        "闭目内自视，色如黄金妍。",
        "至阳不独凝，当与纯阴坚。",
        "一穷百不遂，此事终无缘。",
        "君看抱朴子，共推古神仙。",
        "无钱买丹砂，遗恨盈尘编。",
        "归去守茅屋，道成要有年。"
      ],
