{
  "data": [
    {
      "id": 268698,
      "title": "生春二十首 十四",
      "content": [
        "何处生春早，春生人意中。",
        "晓妆虽近火，晴戏渐怜风。",
        "暗入心情嬾，先添酒思融。",
        "预知花好恶，偏在最深丛。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 268699,
      "title": "生春二十首 十五",
      "content": [
        "何处生春早，春生半睡中。",
        "见灯如见雾，闻雨似闻风。",
        "开眼犹残梦，抬身便恐融。",
        "却成双翅蝶，还绕庳花丛。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 268700,
      "title": "生春二十首 十六",
      "content": [
        "何处生春早，春生晓镜中。",
        "手寒匀面粉，鬟动倚帘风。",
        "宿雾梅心滴，朝光幕上融。",
        "思牵梳洗嬾，空拔绿丝丛。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 268701,
      "title": "生春二十首 十七",
      "content": [
        "何处生春早，春生绮户中。",
        "玉栊穿细日，罗幔张轻风。",
        "柳软腰支嫩，梅香密气融。",
        "独眠傍妬物，偷铲合欢丛。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 268702,
      "title": "生春二十首 十八",
      "content": [
        "何处生春早，春生老病中。",
        "土膏蒸足肿，天暖痒头风。",
        "似觉肌肤展，潜知血气融。",
        "又添新一岁，衰白转成丛。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 268703,
      "title": "生春二十首 十九",
      "content": [
        "何处生春早，春生客思中。",
        "旅魂惊北鴈，乡信是东风。",
        "纵有心灰动，无由鬓雪融。",
        "未知开眼日，空绕未开丛。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 268704,
      "title": "生春二十首 二十",
      "content": [
        "何处生春早，春生蒙雨中。",
        "裛尘微有气，拂面细如风。",
        "柳误啼珠密，梅惊粉汗融。",
        "满空愁淡淡，应豫忆芳丛。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 268705,
      "title": "嘉陵水",
      "content": [
        "尔是无心水，东流有恨无。",
        "我心无说处，也共尔何殊。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 268706,
      "title": "漫天岭赠僧",
      "content": [
        "五上两漫天，因师忏业缘。",
        "漫天无尽日，浮世有穷年。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 268707,
      "title": "百牢关",
      "content": [
        "天上无穷路，生期七十间。",
        "那堪九年内，五度百牢关。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 268708,
      "title": "二月十九日酬王十八全素",
      "content": [
        "君念世上川，嗟予老瘴天。",
        "那堪十日内，又长白头年。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 268709,
      "title": "荥阳郑公以稹寓居严茅有池塘之胜寄诗四首因有意献",
      "content": [
        "激射分流阔，湾环此地多。",
        "暂停随梗浪，犹阅败霜荷。",
        "恨阻还江势，思深到海波。",
        "自伤才畎浍，其奈赠珠何。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 268710,
      "title": "酬乐天寄蕲州簟",
      "content": [
        "蕲簟未经春，君先拭翠筠。",
        "知为热时物，预与瘴中人。",
        "碾玉连心润，编牙小片珍。",
        "霜凝青汗简，冰透碧游鳞。",
        "水魄轻涵黛，琉璃薄带尘。",
        "梦成伤冷滑，惊卧老龙身。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 268711,
      "title": "酬李浙西先因从事见寄之作",
      "content": [
        "近日金銮直，亲于汉珥貂。",
        "内人传帝命，丞相让吾僚。",
        "浙郡悬旌远，长安谕日遥。",
        "因君蘂珠赠，还一梦烟霄。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 268712,
      "title": "酬周从事望海亭见寄",
      "content": [
        "年老无流辈，行稀足薜萝。",
        "热时怜水近，高处见山多。",
        "衣袖长堪舞，喉咙转解歌。",
        "不辞狂复醉，人世有风波。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 268713,
      "title": "代杭民答乐天",
      "content": [
        "翠幕笼斜日，朱衣俨别筵。",
        "管弦凄欲罢，城郭望依然。",
        "路溢新城市，农开旧废田。",
        "春坊幸无事，何惜借三年。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 268714,
      "title": "杏园",
      "content": [
        "浩浩长安车马尘，狂风吹送每年春。",
        "门前本是虚空界，何事栽花误世人。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268715,
      "title": "菊花",
      "content": [
        "秋丛绕舍似陶家，遍绕篱边日渐斜。",
        "不是花中偏爱菊，此花开尽更无花。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268716,
      "title": "酬哥舒大少府寄同年科第",
      "content": [
        "前年科第偏年少，未解知羞最爱狂。",
        "九陌争驰好鞍马，八人同著彩衣裳。",
        "自言行乐朝朝是，岂料浮生渐渐忙。",
        "赖得官闲且疎散，到君花下忆诸郎。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 268717,
      "title": "幽栖",
      "content": [
        "野人自爱幽栖所，近对长松远是山。",
        "尽日望云心不系，有时看月夜方闲。",
        "壶中天地乾坤外，梦里身名旦暮间。",
        "辽海若思千岁鹤，且留城市会飞还。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 268718,
      "title": "清都春霁寄胡三吴十一",
      "content": [
        "蘂珠宫殿经微雨，草树无尘耀眼光。",
        "白日当空天气暖，好风飘树柳阴凉。",
        "蜂怜宿露攒芳久，燕得新泥拂户忙。",
        "时节催年春不住，武陵花谢忆诸郎。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 268719,
      "title": "华岳寺",
      "content": [
        "山前古寺临长道，来往淹留为爱山。",
        "双燕营巢始西别，百花成子又东还。",
        "暝驱羸马频看堠，晓听鸣鸡欲度关。",
        "羞见窦师无外役，竹窗依旧老身闲。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 268720,
      "title": "天坛上境",
      "content": [
        "野人性僻穷深僻，芸署官闲不似官。",
        "万里洞中朝玉帝，九光霞外宿天坛。",
        "洪涟浩渺东溟曙，白日低回上境寒。",
        "因为南昌检仙籍，马君家世奉还丹。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 268721,
      "title": "寻西明寺僧不在",
      "content": [
        "春来日日到西林，飞锡经行不可寻。",
        "莲池旧是无波水，莫逐狂风起浪心。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268722,
      "title": "与吴侍御春游",
      "content": [
        "苍龙阙下陪骢马，紫阁峰头见白云。",
        "满眼流光随日度，今朝花落更纷纷。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268723,
      "title": "晚春",
      "content": [
        "昼静帘疎燕语频，双双鬬雀动阶尘。",
        "柴扉日暮随风掩，落尽闲花不见人。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268724,
      "title": "先醉",
      "content": [
        "今日樽前败饮名，三桮未尽不能倾。",
        "怪来花下长先醉，半是春风荡酒情。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268725,
      "title": "独醉",
      "content": [
        "一树芳菲也当春，漫随车马拥行尘。",
        "桃花解笑莺能语，自醉自眠那藉人。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268726,
      "title": "宿醉",
      "content": [
        "风引春心不自由，等闲冲席饮多筹。",
        "朝来始向花前觉，度却醒时一夜愁。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268727,
      "title": "惧醉",
      "content": [
        "闻道秋来怯夜寒，不辞泥水为桮盘。",
        "殷勤惧醉有深意，愁到醒时灯火阑。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268728,
      "title": "羡醉",
      "content": [
        "绮陌高楼竞醉眠，共期顦顇不相怜。",
        "也应自有寻春日，虚度而今正少年。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268729,
      "title": "忆醉",
      "content": [
        "自叹旅人行意速，每嫌桮酒缓归期。",
        "今朝偏遇醒时别，泪落风前忆醉时。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268730,
      "title": "病醉",
      "content": [
        "醉伴见侬因病酒，道侬无酒不相窥。",
        "那知下药还沽底，人去人来剩一巵。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268731,
      "title": "拟醉",
      "content": [
        "九月闲宵初向火，一尊清酒始行桮。",
        "怜君城外遥相忆，冒雨冲泥黑地来。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268732,
      "title": "劝醉",
      "content": [
        "窦家能酿销愁酒，但是愁人便与销。",
        "愿我共君俱寂寞，只应连夜复连朝。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268733,
      "title": "任醉",
      "content": [
        "本怕酒醒浑不饮，因君相劝觉情来。",
        "殷勤满酌从听醉，乍可欲醒还一桮。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268734,
      "title": "同醉",
      "content": [
        "柏树台中推事人，杏花坛上链形真。",
        "心源一种闲如水，同醉樱桃林下春。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268735,
      "title": "狂醉",
      "content": [
        "一自柏台为御史，二年辜负两京春。",
        "岘亭今日颠狂醉，舞引红娘乱打人。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268736,
      "title": "伴僧行",
      "content": [
        "春来求事百无成，因向愁中识道情。",
        "花满杏园千万树，几人能伴老僧行。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268737,
      "title": "古寺",
      "content": [
        "古寺春余日半斜，竹风萧爽胜人家。",
        "花时不到有花院，意在寻僧不在花。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268738,
      "title": "定僧",
      "content": [
        "落魄闲行不著家，徧寻春寺赏年华。",
        "野僧偶向花前定，满树狂风满树花。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268739,
      "title": "观心处",
      "content": [
        "满坐喧喧笑语频，独怜方丈了无尘。",
        "灯前便是观心处，要似观心有几人。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268740,
      "title": "智度师二首 一",
      "content": [
        "四十年前马上飞，功名藏尽拥禅衣。",
        "石榴园下擒生处，独自闲行独自归。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268741,
      "title": "智度师二首 二",
      "content": [
        "三陷思明三突围，铁衣抛尽衲禅衣。",
        "天津桥上无人识，闲凭栏干望落晖。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268742,
      "title": "西明寺牡丹",
      "content": [
        "花向琉璃地上生，光风炫转紫云英。",
        "自从天女盘中见，直至今朝眼更明。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268743,
      "title": "忆杨十二",
      "content": [
        "去时芍药才堪赠，看却残花已度春。",
        "只为情深偏怆别，等闲相见莫相亲。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268744,
      "title": "送复梦赴韦令幕",
      "content": [
        "世上于今重检身，吾徒耽酒作狂人。",
        "西曹旧事多持法，慎莫吐他丞相茵。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268745,
      "title": "送刘太白",
      "content": [
        "洛阳大底居人少，从善坊西最寂寥。",
        "想得刘君独骑马，古堤愁树隔中桥。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268746,
      "title": "奉诚园",
      "content": [
        "萧相深诚奉至尊，旧居求作奉诚园。",
        "秋来古巷无人扫，树满空墙闭戟门。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268747,
      "title": "与太白同之东洛至栎阳太白染疾驻行予九月二十五日至华岳寺雪后望山",
      "content": [
        "共作洛阳千里伴，老刘因疾驻行轩。",
        "今朝独自山前立，雪满三峰倚寺门。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268748,
      "title": "野狐泉柳林",
      "content": [
        "去日野狐泉上柳，紫牙初绽拂眉低。",
        "秋来寥落惊风雨，叶满空林踏作泥。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268749,
      "title": "酬胡三凭人问牡丹",
      "content": [
        "窃见胡三问牡丹，为言依旧满西栏。",
        "花时何处偏相忆，寥落衰红雨后看。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268750,
      "title": "酬乐天秋兴见赠本句云莫怪独吟秋兴苦比君校近二毛年",
      "content": [
        "劝君休作悲秋赋，白发如星也任垂。",
        "毕竟百年同是梦，长年何异少何为。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268751,
      "title": "雪后宿同轨店上法护寺钟楼望月",
      "content": [
        "满山残雪满山风，野寺无门院院空。",
        "烟火渐稀孤店静，月明深夜古楼中。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268752,
      "title": "陪韦尚书丈归履信宅因赠韦氏兄弟",
      "content": [
        "紫垣驺骑入华居，公子文衣护锦舆。",
        "眠阁书生复何事，也骑羸马从尚书。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268753,
      "title": "永贞二年正月二日上御丹凤楼赦天下予与李公垂庾顺之闲行曲江不及盛观",
      "content": [
        "春来饶梦慵朝起，不看千官拥御楼。",
        "却著闲行是忙事，数人同傍曲江头。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268754,
      "title": "韦居守晚岁常言退休之志因署其居曰大隐洞命予赋诗因赠绝句",
      "content": [
        "谢公潜有东山意，已向朱门启洞门。",
        "大隐犹疑恋朝市，不如名作罢归园。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268755,
      "title": "赠李十二牡丹花片因以饯行",
      "content": [
        "鸎澁余声絮堕风，牡丹花尽叶成丛。",
        "可怜颜色经年别，收取朱阑一片红。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268756,
      "title": "题李十一修行里居壁",
      "content": [
        "云阙朝回尘骑合，杏花春尽曲江闲。",
        "怜君虽在城中住，不隔人家便是山。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268757,
      "title": "靖安穷居",
      "content": [
        "喧静不由居远近，大都车马就权门。",
        "野人住处无名利，草满空阶树满园。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268758,
      "title": "赠乐天",
      "content": [
        "等闲相见销长日，也有闲时更学琴。",
        "不是眼前无外物，不关心事不经心。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268759,
      "title": "使东川 骆口驿二首 一",
      "content": [
        "邮亭壁上数行字，崔李题名王白诗。",
        "尽日无人共言语，不离墙下至行时。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268760,
      "title": "使东川 骆口驿二首 二",
      "content": [
        "二星徼外通蛮服，五夜灯前草御文。",
        "我到东川恰相半，向南看月北看云。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268761,
      "title": "使东川 清明日",
      "content": [
        "常年寒食好风轻，触处相随取次行。",
        "今日清明汉江上，一身骑马县官迎。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268762,
      "title": "使东川 亚枝红",
      "content": [
        "平阳池上亚枝红，怅望山邮事事同。",
        "还向万竿深竹里，一枝浑卧碧流中。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268763,
      "title": "使东川 梁州梦",
      "content": [
        "梦君同绕曲江头，也向慈恩院院游。",
        "亭吏呼人排去马，忽惊身在古梁州。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268764,
      "title": "使东川 南秦雪",
      "content": [
        "帝城寒尽临寒食，骆谷春深未有春。",
        "才见岭头云似盖，已惊岩下雪如尘。",
        "千峰笋石千株玉，万树松萝万朵银。",
        "飞鸟不飞猿不动，青骢御史上南秦。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 268765,
      "title": "使东川 江楼月",
      "content": [
        "嘉陵江岸驿楼中，江在楼前月在空。",
        "月色满床兼满地，江声如鼓复如风。",
        "诚知远近皆三五，但恐阴晴有异同。",
        "万一帝乡还洁白，几人潜傍杏园东。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 268766,
      "title": "使东川 慙问囚",
      "content": [
        "司马子微坛上头，与君深结白云俦。",
        "尚平村落拟连买，王屋山泉为别游。",
        "各待陆浑求一尉，共资三径便同休。",
        "那知今日蜀门路，带月夜行缘问囚。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 268767,
      "title": "使东川 江上行",
      "content": [
        "闷见汉江流不息，悠悠漫漫竟何成。",
        "江流不语意相问，何事远来江上行。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268768,
      "title": "使东川 汉江上笛",
      "content": [
        "小年为写游梁赋，最说汉江闻笛愁。",
        "今夜听时在何处，月明西县驿南楼。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268769,
      "title": "使东川 邮亭月",
      "content": [
        "君多务实我多情，大抵偏嗔步月明。",
        "今夜山邮与蛮嶂，君应坚卧我还行。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268770,
      "title": "使东川 嘉陵驿二首 一",
      "content": [
        "嘉陵驿上空床客，一夜嘉陵江水声。",
        "仍对墙南满山树，野花撩乱月胧明。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268771,
      "title": "使东川 嘉陵驿二首 二",
      "content": [
        "墙外花枝压短墙，月明还照半张床。",
        "无人会得此时意，一夜独眠西畔廊。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268772,
      "title": "使东川 百牢关",
      "content": [
        "嘉陵江上万重山，何事临江一破颜。",
        "自笑只缘任敬仲，等闲身度百牢关。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268773,
      "title": "使东川 江花落",
      "content": [
        "日暮嘉陵江水东，棃花万片逐江风。",
        "江花何处最肠断，半落江流半在空。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268774,
      "title": "使东川 嘉陵江二首 一",
      "content": [
        "秦人惟识秦中水，长想吴江与蜀江。",
        "今日嘉川驿楼下，可怜如练绕明窗。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268775,
      "title": "使东川 嘉陵江二首 二",
      "content": [
        "千里嘉陵江水声，何年重绕此江行。",
        "只应添得清宵梦，时见满江流月明。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268776,
      "title": "使东川 西县驿",
      "content": [
        "去时楼上清明夜，月照楼前撩乱花。",
        "今日成阴复成子，可怜春尽未还家。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268777,
      "title": "使东川 望喜驿",
      "content": [
        "满眼文书堆案边，眼昏偷得暂时眠。",
        "子规惊觉灯又灭，一道月光横枕前。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268778,
      "title": "使东川 好时节",
      "content": [
        "身骑骢马峨眉下，面带霜威卓氏前。",
        "虚度东川好时节，酒楼元被蜀儿眠。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268779,
      "title": "使东川 夜深行",
      "content": [
        "夜深犹自绕江行，震地江声似鼓声。",
        "渐见戍楼疑近驿，百牢关吏火前迎。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268780,
      "title": "使东川 望驿台",
      "content": [
        "可怜三月三旬足，怅望江边望驿台。",
        "料得孟光今日语，不曾春尽不归来。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268781,
      "title": "赠咸阳少府萧郎",
      "content": [
        "莫怪逢君泪每盈，仲由多感有深情。",
        "陆家幼女托良壻，阮氏诸房无外生。",
        "顾我自伤为弟拙，念渠能继事姑名。",
        "别时何处最肠断，日暮渭阳驱马行。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 268782,
      "title": "赠吕三校书",
      "content": [
        "同年同拜校书郎，触处潜行烂熳狂。",
        "共占花园争赵辟，竞添钱贯定秋娘。",
        "七年浮世皆经眼，八月闲宵忽竝床。",
        "语到欲明欢又泣，傍人相笑两相伤。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 268783,
      "title": "封书",
      "content": [
        "鹤台南望白云关，城市犹存暂一还。",
        "书出步虚三百韵，蘂珠文字在人间。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268784,
      "title": "仁风李著作园醉后寄李十",
      "content": [
        "胧明春月照花枝，花下音声是管儿。",
        "却笑西京李员外，五更骑马趁朝时。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268785,
      "title": "灯影",
      "content": [
        "洛阳昼夜无车马，漫挂红纱满树头。",
        "见说平时灯影里，玄宗潜伴太真游。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268786,
      "title": "贬江陵途中寄乐天杓直杓直以员外郎判盐铁乐天以拾遗在翰林",
      "content": [
        "想到江陵无一事，酒杯书卷缀新文。",
        "紫芽嫩茗和枝采，朱橘香苞数瓣分。",
        "暇日上山狂逐鹿，凌晨过寺饱看云。",
        "算缗草诏终须解，不敢将心远羡君。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 268787,
      "title": "渡汉江",
      "content": [
        "嶓冢去年寻漾水，襄阳今日渡江𣸣。",
        "山遥远树才成点，浦静沈碑欲辨文。",
        "万里朝宗诚可羡，百川流入渺难分。",
        "鲵鲸归穴东溟溢，又作波涛随伍员。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 268788,
      "title": "哀病骢呈致用",
      "content": [
        "枥上病骢啼褭褭，江边废宅路迢迢。",
        "自经梅雨长垂耳，乍食菰蒋欲折腰。",
        "金络头衔光未灭，玉花衫色瘦来燋。",
        "曾听禁漏惊衙鼓，惯蹋康衢怕小桥。",
        "半夜雄嘶心不死，日高饥卧尾还摇。",
        "龙媒薄地天池远，何事牵牛在碧霄。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 268789,
      "title": "送岭南崔侍御",
      "content": [
        "我是北人长北望，每嗟南雁更南飞。",
        "君今又作岭南别，南雁北归君未归。",
        "洞主参承惊豸角，岛夷安集慕霜威。",
        "黄家贼用镩刀利，白水郎行旱地稀。",
        "蜃吐朝光楼隐隐，鼇吹细浪雨霏霏。",
        "毒龙蜕骨轰雷鼓，野象埋牙𣃁石矶。",
        "火布垢尘须火浣，木绵温软当绵衣。",
        "桄榔面碜槟榔涩，海气常昏海日微。",
        "蛟老变为妖妇女，舶来多卖假珠玑。",
        "此中无限相忧事，请为殷勤事事依。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 268790,
      "title": "酬乐天八月十五夜禁中独直玩月见寄",
      "content": [
        "一年秋半月偏深，况就烟霄极赏心。",
        "金凤台前波漾漾，玉钩帘下影沈沈。",
        "宴移明处清兰路，歌待新词促翰林。",
        "何意枚臯正承诏，瞥然尘念到江阴。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 268791,
      "title": "予病瘴乐天寄通中散碧腴垂云膏仍题四韵以慰远怀开坼之间因有酬答",
      "content": [
        "紫河变炼红霞散，翠液煎研碧玉英。",
        "金籍真人天上合，盐车病骥轭前惊。",
        "愁肠欲转蛟龙吼，醉眼初开日月明。",
        "唯有思君治不得，膏销雪尽意还生。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 268792,
      "title": "陪诸公游故江西韦大夫通德湖旧居有感题四韵兼呈李六侍御即韦大夫旧寮也",
      "content": [
        "高墉行马接通湖，巨壑藏舟感大夫。",
        "尘壁暗埋悲旧札，风帘吹断落残珠。",
        "烟波漾日侵隤岸，狐兔奔丛拂坐隅。",
        "唯有满园桃李下，膺门偏拜阮元瑜。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 268793,
      "title": "送友封二首 一",
      "content": [
        "桃叶成阴燕引雏，南风吹浪飐樯乌。",
        "瘴云拂地黄梅雨，明月满帆青草湖。",
        "迢递旅魂归去远，颠狂酒兴病来孤。",
        "知君兄弟怜诗句，徧为姑将恼大巫。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 268794,
      "title": "送友封二首 二",
      "content": [
        "惠和坊里当时别，岂料江陵送上船。",
        "鹏翼张风期万里，马头无角已三年。",
        "甘将泥尾随龟后，尚有云心在鹤前。",
        "若见中丞忽相问，为言腰折气冲天。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 268795,
      "title": "放言五首 一",
      "content": [
        "近来逢酒便高歌，醉舞诗狂渐欲魔。",
        "五斗解酲犹恨少，十分飞盏未嫌多。",
        "眼前讐敌都休问，身外功名一任他。",
        "死是等闲生也得，拟将何事奈吾何。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 268796,
      "title": "放言五首 二",
      "content": [
        "莫将心事厌长沙，云到何方不是家。",
        "酒熟𫗦糟学渔父，饭来开口似神鵶。",
        "竹枝待凤千茎直，柳树迎风一向斜。",
        "总被天公霑雨露，等头成长尽生涯。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 268797,
      "title": "放言五首 三",
      "content": [
        "霆轰电烻数声频，不奈狂夫不藉身。",
        "纵使被雷烧作烬，宁殊埋骨飏为尘。",
        "得成蝴蝶寻花树，傥化江鱼掉锦鳞。",
        "必若乖龙在诸处，何须惊动自来人。"
      ],
      "author": {
        "id": 3560,
        "name": "元稹"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    }
  ],
