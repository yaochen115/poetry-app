{
  "data": [
    {
      "id": 217550,
      "title": "题东坡卜算子后",
      "content": [
        "空江月明鱼龙眠，月中孤鸿影翩翩。",
        "有人清吟立江边，葛巾藜杖眼窥天。",
        "夜凉月堕幽虫急，鸿影翘沙衣露湿。",
        "仙人采诗作步虚，玉皇饮之碧琳腴。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 298503,
      "title": "卜算子慢",
      "content": [
        "桃花院落，烟重露寒，寂寞禁烟晴昼。",
        "风拂珠帘，还记去年时候，惜春心，不喜闲窗绣。",
        "倚屏山，和衣睡觉，醺醺暗消残酒。",
        "独倚危阑久，把玉笋偷弹，黛蛾轻鬬。",
        "一点相思，万般自家甘受，抽金钗，欲买丹青手。",
        "写别来，容颜寄与，使知人清瘦。"
      ],
      "author": {
        "id": 11831,
        "name": "钟辐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 299149,
      "title": "卜算子",
      "content": [
        "心空道亦空，风静林还静。",
        "卷尽浮云月自明，中有山河影。",
        "供养及修行，旧话成重省。",
        "豆爆生莲火里时，痛拨寒灰冷。"
      ],
      "author": {
        "id": 4292,
        "name": "吕岩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 312313,
      "title": "卜算子",
      "content": [
        "江风渐老，汀蕙半凋，满目败红衰翠。",
        "楚客登临，正是暮秋天气。",
        "引疏砧、断续残阳里。",
        "对晚景、伤怀念远，新愁旧恨相继。",
        "脉脉人千里。",
        "念两处风情，万重烟水。",
        "雨歇天高，望断翠峰十二。",
        "尽无言、谁会凭高意。",
        "纵写得、离肠万种，奈归云谁寄。"
      ],
      "author": {
        "id": 3061,
        "name": "柳永"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312509,
      "title": "卜算子慢",
      "content": [
        "溪山别意，烟树去程，日落采苹春晚。",
        "欲上征鞍，更掩翠帘相眄。",
        "惜弯弯浅黛长长眼。",
        "奈画阁欢游，也学狂花乱絮轻散。",
        "水影横池馆。",
        "对静夜无人，月高云远。",
        "一饷凝思，两袖泪痕还满。",
        "恨私书、又逐东风断。",
        "纵西北层楼万尺，望重城那见。"
      ],
      "author": {
        "id": 5040,
        "name": "张先"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312584,
      "title": "卜算子",
      "content": [
        "梦断寒夜长，坐待清霜晓。",
        "临镜无人为整妆，但自学、孤鸾照。",
        "楼台红树杪。",
        "风月依前好。",
        "江水东流郎在西，问尺素、何由到。"
      ],
      "author": {
        "id": 5040,
        "name": "张先"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312998,
      "title": "卜算子",
      "content": [
        "极得醉中眠，迤逦翻成病。",
        "莫是前生负你来，今世里、教孤冷。",
        "言约全无定。",
        "是谁先薄幸。",
        "不惯孤眠惯成双，奈奴子、心肠硬。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313129,
      "title": "卜算子",
      "content": [
        "深院花铺地。",
        "淡淡阴天气。",
        "水榭风亭朱明景，又别是、愁情味。",
        "有情奈无计。",
        "漫惹成憔悴。",
        "欲把罗巾暗传寄。",
        "细认取、斑点泪。"
      ],
      "author": {
        "id": 11741,
        "name": "杜安世"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313130,
      "title": "卜算子",
      "content": [
        "尊前一曲歌。",
        "歌里千重意，才欲歌时泪已流，恨应更、多于泪。",
        "试问缘何事。",
        "不语如痴醉。",
        "我亦情多不忍闻，怕和我、成憔悴。"
      ],
      "author": {
        "id": 11741,
        "name": "杜安世"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313571,
      "title": "卜算子",
      "content": [
        "水是眼波横，山是眉峰聚。",
        "欲问行人去那边，眉眼盈盈处。",
        "才始送春归，又送君归去。",
        "若到江东赶上春，千万和春住。"
      ],
      "author": {
        "id": 8647,
        "name": "王观"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313750,
      "title": "卜算子",
      "content": [
        "蜀客到江南，长忆吴山好。",
        "吴蜀风流自古同，归去应须早。",
        "还与去年人，共藉西湖草。",
        "莫惜尊前仔细看，应是容颜老。"
      ],
      "author": {
        "id": 11678,
        "name": "苏轼"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313751,
      "title": "卜算子",
      "content": [
        "缺月挂疏桐，漏断人初静。",
        "时见幽人独往来，缥缈孤鸿影。",
        "惊起却回头，有恨无人省。",
        "拣尽寒枝不肯栖，枫落吴江冷。"
      ],
      "author": {
        "id": 11678,
        "name": "苏轼"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314036,
      "title": "卜算子",
      "content": [
        "我住长江头，君住长江尾。",
        "日日思君不见君，共饮长江水。",
        "此水几时休，此恨何时已。",
        "只愿君心似我心，定不负相思意。"
      ],
      "author": {
        "id": 8599,
        "name": "李之仪"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314126,
      "title": "卜算子",
      "content": [
        "欲整别离情，怯对尊中酒。",
        "野梵幽幽石上飘，搴落楼头柳。",
        "不系黄金绶。",
        "粉黛愁成垢。",
        "春风三月有时阑，遮不尽、梨花丑。"
      ],
      "author": {
        "id": 12065,
        "name": "琴操"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314141,
      "title": "卜算子",
      "content": [
        "池台小雨干，门巷香轮少。",
        "谁把青钱衬落红，满地无人扫。",
        "何时斗草归，几度寻花了。",
        "留得佳人莲步痕，宫样鞋儿小。"
      ],
      "author": {
        "id": 6565,
        "name": "舒亶"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314244,
      "title": "卜算子",
      "content": [
        "凉夜竹堂虚，小睡匆匆醒。",
        "银漏无声月上阶，满地阑干影。",
        "何处最知秋，风在梧桐井。",
        "不惜骖鸾弄玉箫，露湿衣裳冷。"
      ],
      "author": {
        "id": 9909,
        "name": "范成大"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314245,
      "title": "卜算子",
      "content": [
        "云压小桥深，月到重门静。",
        "冷蕊疏枝半不禁，更著横窗影。",
        "回首故园春，往事难重省。",
        "半夜清香入梦来，从此熏炉冷。"
      ],
      "author": {
        "id": 9909,
        "name": "范成大"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314347,
      "title": "卜算子",
      "content": [
        "睡觉五更钟，正好深提省。",
        "只看如今梦几般，觉后原无影。",
        "明暗若从来，且道来从甚。",
        "不是空生不是根，认取真如性。"
      ],
      "author": {
        "id": 5728,
        "name": "沈瀛"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314348,
      "title": "卜算子",
      "content": [
        "那里是闲时，这里何曾定。",
        "毕竟忙时恼杀人，到了还他静。",
        "静处又如何，莫被顽空引。",
        "一道神光总现前，受用无穷尽。"
      ],
      "author": {
        "id": 5728,
        "name": "沈瀛"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314349,
      "title": "卜算子",
      "content": [
        "只管要参禅，又被禅萦绕。",
        "好笑西来老秃奴，赚了人多少。",
        "你待更瞒咱，咱也今知晓。",
        "只这喃喃说底人，又被傍人笑。"
      ],
      "author": {
        "id": 5728,
        "name": "沈瀛"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314430,
      "title": "卜算子",
      "content": [
        "南国小春时，常是寒威浅。",
        "玉缀香苞已有梅，疏影无人见。",
        "愁忆故园芳，梦断扬州远。",
        "不御铅华自出尘，赛过徐妃面。"
      ],
      "author": {
        "id": 793,
        "name": "李洪"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314467,
      "title": "卜算子",
      "content": [
        "去又如何去。",
        "住又如何住。",
        "但得山花插满头。",
        "休问奴归处。"
      ],
      "author": {
        "id": 8478,
        "name": "高宣教"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314468,
      "title": "卜算子",
      "content": [
        "不是爱风尘，似被前身误。",
        "花落花开自有时，总是东君主。",
        "去也终须去。",
        "住也如何住。",
        "若得山花插满头，莫问奴归处。"
      ],
      "author": {
        "id": 5886,
        "name": "严蕊"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314474,
      "title": "卜算子",
      "content": [
        "愁极强登临，毕竟愁难避。",
        "千里江山黯淡中，总是悲秋意。",
        "谁插菊花枝，谁带茱萸佩。",
        "独倚阑干醉不成，日暮西风起。"
      ],
      "author": {
        "id": 474,
        "name": "沈端节"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314475,
      "title": "卜算子",
      "content": [
        "冷蕊伴疏枝，一笑何时共。",
        "江北江南两处愁，忍看花影动。",
        "旅泊怕逢春，卜睡都无梦。",
        "岁暮何郎未得归，手拈频呵冻。"
      ],
      "author": {
        "id": 474,
        "name": "沈端节"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314476,
      "title": "卜算子",
      "content": [
        "踏雪探孤芳，只有诗人共。",
        "守定南枝待得开，不觉冰轮动。",
        "却月与凌风，谩说扬州梦。",
        "想见雕阑曲沼边，残雪和烟冻。"
      ],
      "author": {
        "id": 474,
        "name": "沈端节"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314477,
      "title": "卜算子",
      "content": [
        "客里见梅花，独赏无人共。",
        "风度精神总是伊，又是归心动。",
        "把酒破忧端，熏被寻佳梦。",
        "梦觉香残一味寒，有泪都成冻。"
      ],
      "author": {
        "id": 474,
        "name": "沈端节"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314478,
      "title": "卜算子",
      "content": [
        "烘手熨笙簧，呵冻匀酥面。",
        "闲向梅花树下行，拜月遥相见。",
        "何处托春心，乐府流深怨。",
        "却拈寒窗傍绮疏，恨极东风远。"
      ],
      "author": {
        "id": 474,
        "name": "沈端节"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314613,
      "title": "卜算子",
      "content": [
        "雪月最相宜，梅雪都清绝。",
        "去岁江南见雪时，月底梅花发。",
        "今岁早梅开，依旧年时月。",
        "冷艳孤光照眼明，只欠些儿雪。"
      ],
      "author": {
        "id": 12402,
        "name": "张孝祥"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314655,
      "title": "卜算子",
      "content": [
        "春事忆松江，江上花无数。",
        "一枕匆匆醉梦中，芳草臞庵路。",
        "携手度虹梁，洗眼看渔具。",
        "盐豆莼羹是处无，早买扁舟去。"
      ],
      "author": {
        "id": 6695,
        "name": "李处全"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314656,
      "title": "卜算子",
      "content": [
        "芍药斗新妆，杨柳飞轻雪。",
        "著意留连不放春，已向东皇说。",
        "况是谪仙家，自有长生诀。",
        "方士呼来借玉蟾，要吸杯中月。"
      ],
      "author": {
        "id": 6695,
        "name": "李处全"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314741,
      "title": "卜算子",
      "content": [
        "翠被怯轻寒，花气撩幽梦。",
        "梦蹑飞云驾彩鸾，惊觉花枝动。",
        "宿酒未全醒，屋角闻晴哢。",
        "爱著荼シ彻骨香，嗅了还重□。"
      ],
      "author": {
        "id": 1129,
        "name": "丘崈"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314800,
      "title": "卜算子",
      "content": [
        "人事几时穷，我性偏宜静。",
        "世上谁无富贵心，到了须由命。",
        "闲里且偷安，醉后休教醒。",
        "醉里高歌妙入神，妙处君须听。"
      ],
      "author": {
        "id": 11270,
        "name": "吕胜己"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314801,
      "title": "卜算子",
      "content": [
        "梅蕾破香时，雪后交光夜。",
        "何处飞来两玉蛾，体态双闲雅。",
        "纵目碧城楼，劝酒留云榭。",
        "唱底仙家古道情，分付知音者。"
      ],
      "author": {
        "id": 11270,
        "name": "吕胜己"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314942,
      "title": "卜算子",
      "content": [
        "春水满江南，三月多芳草。",
        "幽鸟闲将远恨来，一一都啼了。",
        "不学鸳鸯老。",
        "回首临平道。",
        "人道长眉似远山，山不似长眉好。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314971,
      "title": "卜算子",
      "content": [
        "执手送行人，水满荷花浦。",
        "旧恨新愁不忍论，泪压潇潇雨。",
        "行计已匆匆，无计留伊住。",
        "一点相思万里心，谁怕关山阻。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314977,
      "title": "卜算子",
      "content": [
        "闲路踏花来，闲逐清和云。",
        "来去虽然总是闲，有多少伤心处。",
        "红碧好池塘，朱绿深庭户。",
        "随分山歌社舞中，且乐陶陶趣。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315013,
      "title": "卜算子",
      "content": [
        "凉夜竹堂空，小睡匆匆醒。",
        "庭院无人月上阶，满地栏干影。",
        "何处最知秋，风在梧桐井。",
        "夜半骖鸾弄玉笙，露湿衣裳冷。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315145,
      "title": "卜算子",
      "content": [
        "十载仰高明，一见心相许。",
        "来日孤舟西水门。",
        "风饱征帆腹。",
        "后夜起相思，明月清江曲。",
        "若见秋风寒雁来，能寄音书否。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315228,
      "title": "卜算子",
      "content": [
        "渡口唤扁舟，雨后青绡皱。",
        "轻暖相重护病躯，料峭还寒透。",
        "老大自伤春，非为花枝瘦。",
        "那得心情似少年，双燕归时候。"
      ],
      "author": {
        "id": 2810,
        "name": "王炎2"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315229,
      "title": "卜算子",
      "content": [
        "散策问芳菲，春半花犹未。",
        "蓓蕾枝头怯苦寒，恰似人憔悴。",
        "人莫恨花迟，天自催寒去。",
        "雨意才收日气浓，玉靥红如醉。"
      ],
      "author": {
        "id": 2810,
        "name": "王炎2"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315242,
      "title": "卜算子",
      "content": [
        "腻玉染深红，艳丽难常好。",
        "已是人间祓禊时，花亦随春老。",
        "唤起曲生来，醉赏惟宜早。",
        "此去阴晴十日间，点点粘芳草。"
      ],
      "author": {
        "id": 2810,
        "name": "王炎2"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315273,
      "title": "卜算子",
      "content": [
        "苍生喘未苏，贾笔论孤愤。",
        "文采风流今尚存，毫发无遗恨。",
        "凄恻近长沙，地僻秋将尽。",
        "长使英雄泪满襟，天意高难问。"
      ],
      "author": {
        "id": 8242,
        "name": "杨冠卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315452,
      "title": "卜算子",
      "content": [
        "百郡怯登车，千里输流马。",
        "乞得胶胶扰扰身，却笑区区者。",
        "野水玉鸣渠，急雨珠跳瓦。",
        "一榻清风方是闲，真得归来也。"
      ],
      "author": {
        "id": 8618,
        "name": "辛弃疾"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315688,
      "title": "卜算子",
      "content": [
        "修竹翠罗寒，迟日江山暮。",
        "幽迳无人独自芳，此恨知无数。",
        "只共梅花语。",
        "懒逐游丝去。",
        "著意寻春不肯香，香在无寻处。"
      ],
      "author": {
        "id": 8618,
        "name": "辛弃疾"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315689,
      "title": "卜算子",
      "content": [
        "欲行且起行，欲坐重来坐。",
        "坐坐行行有倦时，更枕闲书卧。",
        "病是近来身，懒是从前我。",
        "静扫瓢泉竹树阴，且凭随缘过。"
      ],
      "author": {
        "id": 8618,
        "name": "辛弃疾"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315690,
      "title": "卜算子",
      "content": [
        "红粉靓梳妆，翠盖低风雨。",
        "占断人间六月凉，期月鸳鸯浦。",
        "根底藕丝长，花里莲心苦。",
        "只为风流有许愁，更衬佳人步。"
      ],
      "author": {
        "id": 8618,
        "name": "辛弃疾"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315760,
      "title": "卜算子",
      "content": [
        "万里𥬞浮云，一喷空凡马。",
        "叹息曹瞒《老骥》诗，伏枥如公者。",
        "山鸟哢窥檐，野鼠饥翻瓦。",
        "老我痴顽合住山，此地菟裘也。"
      ],
      "author": {
        "id": 8618,
        "name": "辛弃疾"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315948,
      "title": "卜算子",
      "content": [
        "枕簟暑风消，帘幕秋风动。",
        "月到夜来愁处明，只照团衾凤。",
        "去意杳无凭，别语愁难送。",
        "一纸鱼笺枕底香，且做新来梦。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315949,
      "title": "卜算子",
      "content": [
        "独自上层楼，楼外青山远。",
        "望到斜阳欲尽时，不见西飞雁。",
        "独自下层楼，楼下蛩声怨。",
        "待到黄昏月上时，依旧柔肠断。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315950,
      "title": "卜算子",
      "content": [
        "几日赏花天，月淡荼䕷小。",
        "写尽相思唤不来，又是花飞了。",
        "春在怕愁多，春去怜欢少。",
        "一夜安排梦不成，月堕西窗晓。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316135,
      "title": "卜算子",
      "content": [
        "雪后竹枝风，醉梦风吹醒。",
        "瘦立寒阶满地春，淡月梅花影。",
        "门外辘轳寒，晓汲喧金井。",
        "长笛何人更倚楼，玉指风前冷。"
      ],
      "author": {
        "id": 650,
        "name": "陈三聘"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316136,
      "title": "卜算子",
      "content": [
        "涧下水声寒，壑底松风静。",
        "时有清香度竹来，步月寻疏影。",
        "往事属东风，试问花应省。",
        "曾是花前把酒人，别梦溪堂冷。"
      ],
      "author": {
        "id": 650,
        "name": "陈三聘"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316166,
      "title": "卜算子",
      "content": [
        "人自蕊宫来，微步香云拥。",
        "小试樽前白雪歌，叶叶秋声动。",
        "一剪艳波横，两点愁山重。",
        "收拾眉尖眼尾情，作个鸳鸯梦。"
      ],
      "author": {
        "id": 11721,
        "name": "石孝友"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316167,
      "title": "卜算子",
      "content": [
        "见也如何暮。",
        "别也如何遽。",
        "别也应难见也难，后会难凭据。",
        "去也如何去。",
        "住也如何住。",
        "住也应难去也难，此际难分付。"
      ],
      "author": {
        "id": 11721,
        "name": "石孝友"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316168,
      "title": "卜算子",
      "content": [
        "折得月中枝，坐惜青春老。",
        "及至归来能几时，又踏关山道。",
        "满眼秋光好。",
        "相见应须早。",
        "若趁重阳不到家，只怕黄花笑。"
      ],
      "author": {
        "id": 11721,
        "name": "石孝友"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316169,
      "title": "卜算子",
      "content": [
        "冷蕊閟红香，瘦节攒苍玉。",
        "更著堂堂十八翁，取友三人足。",
        "惜此岁寒姿，移向屏山曲。",
        "纸帐熏炉结胜缘，故伴仙郎宿。"
      ],
      "author": {
        "id": 11721,
        "name": "石孝友"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316323,
      "title": "卜算子",
      "content": [
        "杨柳绿成阴，初过寒食节。",
        "门掩金铺独自眠，那更逢寒夜。",
        "强起立东风，惨惨梨花谢。",
        "何事王孙不早归，寂寞秋千月。"
      ],
      "author": {
        "id": 11823,
        "name": "韩玉"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316530,
      "title": "卜算子",
      "content": [
        "晴日敛春泥，陌上东风软。",
        "料峭寒禁花柳闲，枉恨春工浅。",
        "绿涨一江深，黛泼千山远。",
        "目断平芜无际愁，数尽征鸿点。"
      ],
      "author": {
        "id": 9256,
        "name": "赵师侠"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316531,
      "title": "卜算子",
      "content": [
        "杨柳褪金丝，艳杏摇红影。",
        "欲雨还晴二月天，春色浑无定。",
        "晓梦不堪惊，午昼新来永。",
        "一掬归心万叠愁，空惹长亭恨。"
      ],
      "author": {
        "id": 9256,
        "name": "赵师侠"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316532,
      "title": "卜算子",
      "content": [
        "娇艳醉杨妃，轻袅怜飞燕。",
        "人在昭阳睡足时，初试妆深浅。",
        "一段锦新裁，万里来何远。",
        "高烛休教照夜寒，媚脸融春艳。"
      ],
      "author": {
        "id": 9256,
        "name": "赵师侠"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316533,
      "title": "卜算子",
      "content": [
        "绿暗柳藏烟，红淡花经雨。",
        "更著如花似玉人，艳态娇波注。",
        "纤手捧瑶卮，缓遏歌云缕。",
        "只恐莺花不解留，还逐东风去。"
      ],
      "author": {
        "id": 9256,
        "name": "赵师侠"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316534,
      "title": "卜算子",
      "content": [
        "云敛料寒轻，雨涨春波渺。",
        "旅枕无堪梦易惊，啼鴂声催晓。",
        "尚忆故园花，红紫为容好。",
        "世路崎岖长短亭，来往何时了。"
      ],
      "author": {
        "id": 9256,
        "name": "赵师侠"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316551,
      "title": "卜算子",
      "content": [
        "悄静菊花天，洗尽梧桐雨。",
        "倍九周遭烂熳开，祝寿当头取。",
        "顶戴玉袍黄，叠秀金棱吐。",
        "仙种花容晚节香，人愿争先睹。"
      ],
      "author": {
        "id": 13346,
        "name": "陈亮"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316913,
      "title": "卜算子",
      "content": [
        "江左咏梅人，梦绕青青路。",
        "因向凌风台下看，心事还将与。",
        "忆别庾郎时，又过林逋处。",
        "万古西湖寂寞春，惆怅谁能赋。"
      ],
      "author": {
        "id": 3701,
        "name": "姜夔"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316914,
      "title": "卜算子",
      "content": [
        "月上海云沈，鸥去吴波回。",
        "行过西泠有一枝，竹暗人家静。",
        "又见水沈亭，举目悲风景。",
        "花下铺毡把一杯，缓饮春风影。"
      ],
      "author": {
        "id": 3701,
        "name": "姜夔"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316915,
      "title": "卜算子",
      "content": [
        "藓干石斜妨，玉蕊松低覆。",
        "日暮冥冥一见来，略比年时瘦。",
        "凉观酒初醒，竹阁吟才就。",
        "犹恨幽香作许悭，小迟春心透。"
      ],
      "author": {
        "id": 3701,
        "name": "姜夔"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316916,
      "title": "卜算子",
      "content": [
        "家在马城西，今赋梅屏雪。",
        "梅雪相兼不见花，月影玲珑彻。",
        "前度带愁看，一饷和愁折。",
        "若使逋仙及见之，定自成愁绝。"
      ],
      "author": {
        "id": 3701,
        "name": "姜夔"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316917,
      "title": "卜算子",
      "content": [
        "摘蕊暝禽飞，倚树悬冰落。",
        "下竺桥边浅立时，香已漂流却。",
        "空径晚烟平，古寺春寒恶。",
        "老子寻花第一番，常恐吴儿觉。"
      ],
      "author": {
        "id": 3701,
        "name": "姜夔"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316918,
      "title": "卜算子",
      "content": [
        "绿萼更横枝，多少梅花样。",
        "惆怅西村一坞春，开遍无人赏。",
        "细草藉金舆，岁岁长吟想。",
        "枝上么禽一两声，犹似宫娥唱。"
      ],
      "author": {
        "id": 3701,
        "name": "姜夔"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316919,
      "title": "卜算子",
      "content": [
        "象笔带香题，龙笛吟春咽。",
        "杨柳娇痴未觉愁，花管人离别。",
        "路出古昌源，石瘦冰霜洁。",
        "折得青须碧藓花，持向人间说。"
      ],
      "author": {
        "id": 3701,
        "name": "姜夔"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316920,
      "title": "卜算子",
      "content": [
        "御苑接湖波，松下春风细。",
        "云绿峨峨玉万枝，别有仙风味。",
        "长信昨来看，忆共东皇醉。",
        "此树婆娑一惘然，苔藓生春意。"
      ],
      "author": {
        "id": 3701,
        "name": "姜夔"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316978,
      "title": "卜算子",
      "content": [
        "夏则饮红泉，冬则餐红术。",
        "一片新春入手来，不费些儿力。",
        "春在水无痕，春在山无迹。",
        "李白桃红未吐时，好个春消息。"
      ],
      "author": {
        "id": 10066,
        "name": "汪莘"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 317150,
      "title": "卜算子",
      "content": [
        "春事到清明，过了三之二。",
        "秾李夭桃委路尘，太半成泥滓。",
        "只有海棠花，恰似杨妃醉。",
        "折向铜壶把烛看，且莫教渠睡。"
      ],
      "author": {
        "id": 2985,
        "name": "郭应祥"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 317151,
      "title": "卜算子",
      "content": [
        "谁把洛阳花，翦送河阳县。",
        "魏紫姚黄此地无，随分红深浅。",
        "小插向铜瓶，一段真堪羡。",
        "十二人簪十二枝，面面交相看。"
      ],
      "author": {
        "id": 2985,
        "name": "郭应祥"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 317181,
      "title": "卜算子",
      "content": [
        "午夜一声雷，急雨如飞雹。",
        "枝上残红半点无，密叶都成幄。",
        "苦恨薄书尘，刚把闲身缚。",
        "却意湄湘春暮时，处处堪行乐。"
      ],
      "author": {
        "id": 2985,
        "name": "郭应祥"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 317182,
      "title": "卜算子",
      "content": [
        "城上著裴亭，亭下临湘水。",
        "泼黛揉蓝画不成，暝色仍含紫。",
        "忙里不知春，却问今馀几。",
        "相与偷将半日闲，共把尘襟洗。"
      ],
      "author": {
        "id": 2985,
        "name": "郭应祥"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 317187,
      "title": "卜算子",
      "content": [
        "绿烛间红花，绝艳交相照。",
        "不分花时雨又风，折取供吟笑。",
        "拟把插乌巾，却恨非年少。",
        "点笔舒笺领略渠，座客词俱妙。"
      ],
      "author": {
        "id": 2985,
        "name": "郭应祥"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 317224,
      "title": "卜算子",
      "content": [
        "花底醉东风，好景宜同寿。",
        "海角天涯今几春，邂逅新丰酒。",
        "内集记高阳，南渡闲回首。",
        "但愿长年饱饭休，一笑风尘表。"
      ],
      "author": {
        "id": 11972,
        "name": "韩淲"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 317265,
      "title": "卜算子",
      "content": [
        "一雨已秋深，月色寒而静。",
        "夜半披衣草树间，玉露团清影。",
        "长笛倚楼声，听彻还重省。",
        "手启柴门倦复关，云卧衣裳冷。"
      ],
      "author": {
        "id": 11972,
        "name": "韩淲"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 317324,
      "title": "卜算子",
      "content": [
        "草际雪痕消，梅上春心动。",
        "碧幕红裙簇画筵，横玉声三弄。",
        "雅兴杂鱼龙，妙舞回鸾凤。",
        "莫道司空眼惯□，还入清宵梦。"
      ],
      "author": {
        "id": 1676,
        "name": "李廷忠"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 317327,
      "title": "卜算子",
      "content": [
        "双桨浪花平，夹岸青山锁。",
        "你自归家我自归，说着如何过。",
        "我断不思量，你莫思量我。",
        "将你从前与我心，付与他人可。"
      ],
      "author": {
        "id": 9378,
        "name": "谢直"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 317373,
      "title": "卜算子",
      "content": [
        "翦烛写香笺，拨火温寒醑。",
        "门外东风将我愁，欲作三更雨。",
        "夜夜玉楼心，日日长亭路。",
        "豆蔻花开信不来，尘满金钗股。"
      ],
      "author": {
        "id": 9863,
        "name": "俞国宝"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 317547,
      "title": "卜算子",
      "content": [
        "满二望三时，春景方明媚。",
        "又见蟠桃结子来，王母初筵启。",
        "无数桂林山，不尽漓江水。",
        "总入今朝祝寿杯，永保千千岁。"
      ],
      "author": {
        "id": 4018,
        "name": "邹应龙"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 317890,
      "title": "卜算子",
      "content": [
        "江横山簇。",
        "柏箭森如束。",
        "满眼飞蓬撩乱，知几几、未膏沐。",
        "快意忽破竹。",
        "一奁明翠玉。",
        "千古江山只么，人都道、为君绿。"
      ],
      "author": {
        "id": 6995,
        "name": "魏了翁"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 317892,
      "title": "卜算子",
      "content": [
        "携月上南楼，月已穿云去。",
        "莫照峨眉最上峰，同在峰前住。",
        "东望极青齐，西顾穷商许。",
        "酒到忧边总未知，犹认胡床处。"
      ],
      "author": {
        "id": 6995,
        "name": "魏了翁"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 317893,
      "title": "卜算子",
      "content": [
        "能得几时留，王事催人去。",
        "翠荡涵空酒满船，苦要留人住。",
        "身世两悠悠，飘泊知何许。",
        "但得心亲志合时，都是相逢处。"
      ],
      "author": {
        "id": 6995,
        "name": "魏了翁"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 317894,
      "title": "卜算子",
      "content": [
        "风雨满空霏，总得江山妙。",
        "洗出湖光镜似明，不受纤尘涴。",
        "心事竟堪凭，天意真难料。",
        "呼吸丰年倾刻间，也合轩渠笑。"
      ],
      "author": {
        "id": 6995,
        "name": "魏了翁"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 317987,
      "title": "卜算子",
      "content": [
        "续续露蛩鸣，索索风梧语。",
        "瘦骨从来不奈秋，一夜秋如许。",
        "簟冷卷风漪，髻滑抛云缕。",
        "展转无人共此情，画角吹残雨。"
      ],
      "author": {
        "id": 12933,
        "name": "卢祖皋"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 317988,
      "title": "卜算子",
      "content": [
        "双鬓晚风前，一笛秋云外。",
        "木叶飞时看好山，山亦于人耐。",
        "意到偶题诗，饮少先成醉。",
        "笑折花枝步短檐，此意无人会。"
      ],
      "author": {
        "id": 12933,
        "name": "卢祖皋"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 317989,
      "title": "卜算子",
      "content": [
        "佩解洛波遥，弦冷湘江渺。",
        "月底盈盈误不归，独立风尘表。",
        "窗绮护幽妍，瓶玉扶轻袅。",
        "别后知谁语素心，寂寞山寒峭。"
      ],
      "author": {
        "id": 12933,
        "name": "卢祖皋"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 317990,
      "title": "卜算子",
      "content": [
        "寒谷耿春姿，遥夜乘幽兴。",
        "忆得和香载月归，醉里清魂醒。",
        "霜月解随人，不解将疏影。",
        "想见江南万斛愁，云卧衣裳冷。"
      ],
      "author": {
        "id": 12933,
        "name": "卢祖皋"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 318193,
      "title": "卜算子",
      "content": [
        "簸弄柳梢春，呼吸花心露。",
        "倦粉娇黄扇底风，尽向眉心度。",
        "唤醒海棠红，约住樱桃素。",
        "上到瑶台最上层，共跨青鸾去。"
      ],
      "author": {
        "id": 8088,
        "name": "洪咨夔"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 318194,
      "title": "卜算子",
      "content": [
        "芍药打团红，萱草成窝绿。",
        "帘卷疏风燕子归，依旧卢仝屋。",
        "贫放曲生疏，闻到青奴熟。",
        "扫地焚香伴老仙，人胜连环玉。"
      ],
      "author": {
        "id": 8088,
        "name": "洪咨夔"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 318454,
      "title": "卜算子",
      "content": [
        "忆自别郎时，数到郎归日。",
        "及至郎归郎又行，泪脸香红湿。",
        "残梦怕寻思，罥绣慵收拾。",
        "夏簟青青白昼长，背倚阑干立。"
      ],
      "author": {
        "id": 6063,
        "name": "黄机"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 318671,
      "title": "卜算子",
      "content": [
        "云散雨初晴，蝉噪林逾静。",
        "古寺敲钟暮掩门，灯映琉璃影。",
        "浩气镇长存，昨梦还重省。",
        "独倚阑干啸一声，毛发萧萧冷。"
      ],
      "author": {
        "id": 10628,
        "name": "葛长庚"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 318672,
      "title": "卜算子",
      "content": [
        "古寺枕空山，楼上昏钟静。",
        "饥鼠偷灯尾蘸油，悄悄无人影。",
        "长剑匣中鸣，今古深思省。",
        "此夕行藏独倚楼，风雨凄凄冷。"
      ],
      "author": {
        "id": 10628,
        "name": "葛长庚"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 318673,
      "title": "卜算子",
      "content": [
        "渔火海边明，烟锁千山静。",
        "独坐僧窗夜未央，寂寞孤灯影。",
        "感慨辄兴怀，往事无人省。",
        "江汉飘浮二十年，一枕西风冷。"
      ],
      "author": {
        "id": 10628,
        "name": "葛长庚"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 319010,
      "title": "卜算子",
      "content": [
        "尽是手成持，合得天饶借。",
        "风雨于花有底雠，著意相陵藉。",
        "做暖逼教开，做冷催教谢。",
        "不负明年花下人，只负栽花者。"
      ],
      "author": {
        "id": 8873,
        "name": "刘克庄"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 319011,
      "title": "卜算子",
      "content": [
        "片片蝶衣轻，点点猩红小。",
        "道是天公不惜花，百种千般巧。",
        "朝见树头繁，暮见枝头少。",
        "道是天公果惜花，雨洗风吹了。"
      ],
      "author": {
        "id": 8873,
        "name": "刘克庄"
