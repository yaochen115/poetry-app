{
  "data": [
    {
      "id": 3085,
      "title": "次韵谢文骥主簿见寄兼示刘宣叔",
      "content": [
        "断蓬随天风，飘荡去何许。",
        "寒草不自振，生死依墙堵。",
        "两途俱寂寞，众手剧云雨。",
        "坐令习主簿，下与鸡鹜伍。",
        "遥知竹林交，未肯一时数。",
        "翩翩三语掾，智与谩相补。",
        "髯刘吾所畏，道屈空去鲁。",
        "子才亦落落，倾盖极许予。",
        "四夔照河滨，一笑宽逆旅。",
        "堂堂吾景方，去作泉下土。",
        "未知我露电，能复几寒暑。",
        "思莼久未决，食荠转觉苦。",
        "我不逮诸子，要先诸子去。",
        "不种杨恽田，但灌吕安圃。",
        "未知谁善酿，可作孔文举。",
        "十年亦晚矣，请便事斯语。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3086,
      "title": "题刘路宣义风月堂",
      "content": [
        "长风将佳月，万里到此堂。",
        "天游本无待，邂逅今夕凉。",
        "北窗旧竹短，南窗新竹长。",
        "此君本无心，风月不相忘。",
        "道人方燕坐，万物凝清光。",
        "不独揖霜雪，似闻笙鹤翔。",
        "乃知一念静，可洗千劫忙。",
        "明当携曲生，往问安心方。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3087,
      "title": "送吕钦问监酒受代归",
      "content": [
        "以我千金帚，逢君万斛船。",
        "要知穷有自，未觉懒相先。",
        "盆盎三年梦，篇章四海传。",
        "怱怱秣归马，离恨满霜天。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 3088,
      "title": "次韵周教授秋怀",
      "content": [
        "一官不办作生涯，几见秋风卷岸沙。",
        "宋玉有文悲落木，陶潜无酒对黄花。",
        "天机衮衮山新瘦，世事悠悠日自斜。",
        "误矣载书三十乘，东门何地不宜瓜。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 3089,
      "title": "次韵张矩臣迪功见示建除体",
      "content": [
        "建德我故国，归哉遄我驱。",
        "除道得欢伯，荆棘无复余。",
        "满怀秋月色，未觉饥肠虚。",
        "平林过西风，为我起笙竽。",
        "定知张公子，能共寂寞娱。",
        "执此以赠君，意重貂襜褕。",
        "破帽与青鞋，耐久心亦舒。",
        "危处要进步，安处勿停车。",
        "成亏在道德，不在功利区。",
        "收视以为期，问君此何如。",
        "开尊且复饮，辞费道已迂。",
        "闭口味更长，香断窗棂疏。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3090,
      "title": "八音歌  其一",
      "content": [
        "金张与许史，不知寒士名。",
        "石交少瑕疵，但有一曲生。",
        "丝色随染异，择交士所贵。",
        "竹林固皆贤，山王以官累。",
        "匏酌可延客，藜羹无是非。",
        "土思非不深，无屋未能归。",
        "革华虽可侯，不敢践危地。",
        "木奴会足饱，宽作十年计。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3091,
      "title": "八音歌  其二",
      "content": [
        "金章笑鹑衣，玉堂陋茅茨。",
        "石火不须臾，白驹隙中驰。",
        "丝鬓那可避，会当来如期。",
        "竹固不如肉，飞觞莫辞速。",
        "匏竹且勿喧，听我歌此曲。",
        "土花玩四时，未觉有荣辱。",
        "革木要一声，好异乖人情。",
        "木公不可待，且复举吾觥。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3092,
      "title": "题牧牛图",
      "content": [
        "千里烟草绿，连山雨新足。",
        "老牛抱朝饥，向山影觳觫。",
        "犊儿狂走先过浦，却立长鸣待其母。",
        "母子为人实仓廪，汝饱不惭人愧汝。",
        "牧童生来日日娱，只忧身大当把鉏。",
        "日斜睡足牛背上，不信人间有广舆。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3093,
      "title": "题易元吉画麞",
      "content": [
        "纷纷骑马尘及腹，名利之窟争驰逐。",
        "眼明见此山中吏，怪底吾庐有林谷。",
        "雌雄相对目炯炯，意闲不受荣与辱。",
        "掇皮皆真岂自知，坐令猫犬羞奴仆。",
        "我不是李卫公，欺尔无魂规尔肉。",
        "又不是曹将军，数肋射尔不遗镞。",
        "明窗无尘帘有香，与尔共此春日长。",
        "戏弄竹枝聊卒岁，不羡晋宫车下羊。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3094,
      "title": "题唐希雅画寒江图",
      "content": [
        "江头云黄天酝雪，树枝惨惨冻欲折。",
        "耐寒野鸭不知归，犹向沙边弄羽衣。",
        "黄茅终日不自力，影乱弱藻相因依。",
        "惟有苍石如卧虎，不受阴晴与寒暑。",
        "舟中过客莫敢侮，闲伴长江了今古。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3095,
      "title": "江南春",
      "content": [
        "雨后江上绿，客愁随眼新。",
        "桃花十里影，摇荡一江春。",
        "朝风迎船波浪恶，暮风送船无处泊。",
        "江南虽好不如归，老荠遶墙人得肥。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 3096,
      "title": "蜡梅",
      "content": [
        "智琼额黄且勿夸，回眼视此风前葩。",
        "家家融蜡作杏蔕，岁岁逢梅是蜡花。",
        "世间真伪非两法，映日细看真是蜡。",
        "我今嚼蜡已甘腴，况此有味蜡不如。",
        "只愁繁香欺定力，薰我欲醉须人扶。",
        "不辞花前醉倒卧经月，是酒是香君试别。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3097,
      "title": "次韵张元方春雪",
      "content": [
        "云黄天为低，窗白雪初作。",
        "幽人睡方觉，帘外舞万鹤。",
        "斜斜既可人，整整亦不恶。",
        "不知来何暮，遂失梅花约。",
        "东风桃杏暖，不受珠玑络。",
        "聊回万斛润，点点付藜藿。",
        "幽人无酒饮，一笑供酬酢。",
        "岁晚会复来，相期在丘壑。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3098,
      "title": "舍弟逾日不知雪势密因再赋",
      "content": [
        "密雪来催诗，似怪子不作。",
        "蔽天白漫漫，谁辨鹭与鹤。",
        "坐令天回笑，未受风作恶。",
        "急飞既繁丽，缓舞尤绰约。",
        "稍积草木上，断缟莽联络。",
        "终然要白日，印彼葵与藿。",
        "满眼丰岁意，空诗信难酢。",
        "慎勿辞典衣，已不虑填壑。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3099,
      "title": "杂书示陈国佐胡元茂四首  其一",
      "content": [
        "一官专为口，俯仰汗我颜。",
        "顾将千日饥，换此三岁闲。",
        "冥冥云表雁，时节自往还。",
        "不忧稻粱绝，忧在罗网间。",
        "绝胜杜拾遗，一饱常间关。",
        "晚知儒冠误，犹恋终南山。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3100,
      "title": "杂书示陈国佐胡元茂四首  其二",
      "content": [
        "杜门十日疾，因得观妄身。",
        "勿云千金躯，今视如埃尘。",
        "平生老赤脚，每见生怒嗔。",
        "挥汗煮我药，见此愧其勤。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 3101,
      "title": "杂书示陈国佐胡元茂四首  其三",
      "content": [
        "巨源邦之栋，急士如拾珍。",
        "定知柳下锻，远胜崔史陈。",
        "绝交虽已隘，益见叔夜真。",
        "士要虽衣食，求仁今得仁。",
        "释之与王生，盛美俱绝伦。",
        "吾评竹林咏，未可少若人。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3102,
      "title": "杂书示陈国佐胡元茂四首  其四",
      "content": [
        "昔吾同年友，壮志各南溟。",
        "十年风雨过，见此落落星。",
        "秀者吾元茂，众器见鼎铏。",
        "许身稷契间，不但醉六经。",
        "时逢下车揖，慰我两眼青。",
        "勿忧事不理，伯始在朝廷。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3103,
      "title": "书怀示友十首  其一",
      "content": [
        "俗子令我病，纷然来座隅。",
        "贤士费怀思，不受折简呼。",
        "城东陈孟公，久阔今何如。",
        "明月照天下，此夕与君俱。",
        "不难十里勤，畏借东家驴。",
        "似闻有老眼，能作荐鹗书。",
        "功名勿念我，此心已扫除。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3104,
      "title": "书怀示友十首  其二",
      "content": [
        "张子霜后鹰，眉骨非凡曹。",
        "不肯兄事钱，但欲仆命骚。",
        "胡为随我辈，碌碌著青袍。",
        "相逢车马边，伎痒不得搔。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 3105,
      "title": "书怀示友十首  其三",
      "content": [
        "平生诗作祟，肠肚困藿食。",
        "使我忘隐忧，亦自得诗力。",
        "绝知是余蔽，且复求今日。",
        "不如付杯酒，一笑万事毕。",
        "毛颖仅升堂，曲生真入室。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3106,
      "title": "书怀示友十首  其四",
      "content": [
        "我梦钟鼎食，或作山林游。",
        "当其适意时，略与人间侔。",
        "觉来迹便扫，我已不悲忧。",
        "人间安可比，梦中无悔尤。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 3107,
      "title": "书怀示友十首  其五",
      "content": [
        "我策三十六，第一当归田。",
        "柴门种杂树，婆娑乐余年。",
        "是中三益友，不减二仲贤。",
        "柏树解说法，桑叶能通禅。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 3108,
      "title": "书怀示友十首  其六",
      "content": [
        "有钱可使鬼，无钱鬼揶揄。",
        "百年堂前燕，万事屋上乌。",
        "微官不救饥，出处违壮图。",
        "相牛岂无经，种树亦有书。",
        "如何求二顷，归卧渊明庐。",
        "曝背对青山，鸟鸣人意舒。",
        "试数门前客，终岁几覆车。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3109,
      "title": "书怀示友十首  其七",
      "content": [
        "仲舒老一经，策世非所长。",
        "瓦鼎荐蔬食，但取充饥肠。",
        "伟哉贾生书，开阖有耿光。",
        "既珍亦可饱，举俗不见尝。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 3110,
      "title": "书怀示友十首  其八",
      "content": [
        "扬雄平生学，肝肾困雕𫔔。",
        "晚于玄有得，始悔赋甘泉。",
        "使雄早大悟，亦何事于玄。",
        "赖有一言善，酒箴真可传。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 3111,
      "title": "书怀示友十首  其九",
      "content": [
        "萧萧十月菊，耿耿照白草。",
        "开窗逢一笑，未觉徐娘老。",
        "风霜要饱更，独立晚更好。",
        "韩公真躁人，顾用扰怀抱。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 3112,
      "title": "书怀示友十首  其一○",
      "content": [
        "青青堂西竹，岁寒不缁磷。",
        "蓬蒿众小中，拭眼见长身。",
        "澹然冬日影，此处极可人。",
        "子猷幸见过，一洗声色尘。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 3113,
      "title": "风雨",
      "content": [
        "风雨破秋夕，梧叶窗前惊。",
        "不愁黄落近，满意作秋声。",
        "客子无定力，梦中波撼城。",
        "觉来俱不见，微月照残更。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 3114,
      "title": "曼陀罗花",
      "content": [
        "我圃殊不俗，翠蕤敷玉房。",
        "秋风不敢吹，谓是天上香。",
        "烟迷金钱梦，露醉木蕖粧。",
        "同时不同调，晓月照低昂。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 3115,
      "title": "萤火",
      "content": [
        "翩翩飞蛾掩明烛，见烹膏油罪莫赎。",
        "嘉尔萤火不自欺，草间相照光煜煜。",
        "却马已录仙人方，映书曾登君子堂。",
        "不畏月明见陋质，但畏风雨难为光。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 3116,
      "title": "北风",
      "content": [
        "北风掠野悲岁暮，黄尘涨街人不度。",
        "孤鸿抱饥客千里，性命么微不当怒。",
        "梅花欲动天作难，蓬飞上天得盘桓。",
        "千里卧木枝叶尽，独自人间不受寒。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 3117,
      "title": "送张仲宗押戟归闽中",
      "content": [
        "翩然鸿鹄本不群，亦复为口长纷纷。",
        "去年弄影河北月，今年迎面江南云。",
        "还家不比陶令冷，持节正效相如勤。",
        "青天白日映徒御，玄发绛旆明江𣸣。",
        "舟前落花慰野老，浦口杜若愁湘君。",
        "遥知诗成寄驿使，万里春色当见分。",
        "赠人以言予岂敢，不忍负子聊云云。",
        "旧山虽好慎勿过，恐有德璋能勒文。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3118,
      "title": "襄邑道中",
      "content": [
        "飞花两岸照船红，百里榆堤半日风。",
        "卧看满天云不动，不知云与我俱东。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 3119,
      "title": "寄新息家叔",
      "content": [
        "风雨淮西梦，危魂费九升。",
        "一官遮日手，两地读书灯。",
        "见客深藏舌，吟诗不负丞。",
        "竹林虽有约，门户要人兴。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 3120,
      "title": "年华",
      "content": [
        "去国频更岁，为官不救饥。",
        "春生残雪外，酒尽落梅时。",
        "白日山川映，青天草木宜。",
        "年华不负客，一一入吾诗。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 3121,
      "title": "茅屋",
      "content": [
        "茅屋年年破，春风岁岁来。",
        "寒从草根退，花值客愁开。",
        "时序添诗卷，乾坤进酒杯。",
        "片云无思极，日暮却空回。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 3122,
      "title": "酴醾",
      "content": [
        "雨过无桃李，唯余雪覆墙。",
        "青天映妙质，白日照繁香。",
        "影动春微透，花寒韵更长。",
        "风流到尊酒，犹足助诗狂。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 3123,
      "title": "雨",
      "content": [
        "萧萧十日雨，稳送祝融归。",
        "燕子经年梦，梧桐昨暮非。",
        "一凉恩到骨，四壁事多违。",
        "衮衮繁华地，西风吹客衣。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 3124,
      "title": "西风",
      "content": [
        "木末西风起，中含万里凉。",
        "浮云不愁思，尽日只飞扬。",
        "梦断头将白，诗成叶自黄。",
        "不关明主弃，本出涸阴乡。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 3125,
      "title": "题许道宁画",
      "content": [
        "满眼长江水，苍然何郡山。",
        "向来万里意，今在一窗间。",
        "众木俱含晚，孤云遂不还。",
        "此中有佳句，吟断不相关。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 3126,
      "title": "和张规臣水墨梅五绝  其一",
      "content": [
        "巧画无盐丑不除，此花风韵更清姝。",
        "从教变白能为黑，桃李依然是仆奴。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 3127,
      "title": "和张规臣水墨梅五绝  其二",
      "content": [
        "病见昏花已数年，只应梅蕊固依然。",
        "谁教也作陈玄面，眼乱初逢未敢怜。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 3128,
      "title": "和张规臣水墨梅五绝  其三",
      "content": [
        "粲粲江南万玉妃，别来几度见春归。",
        "相逢京洛浑依旧，唯恨缁尘染素衣。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 3129,
      "title": "和张规臣水墨梅五绝  其四",
      "content": [
        "含章檐下春风面，造化功成秋兔毫。",
        "意足不求颜色似，前身相马九方皋。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 3130,
      "title": "和张规臣水墨梅五绝  其五",
      "content": [
        "自读西湖处士诗，年年临水看幽姿。",
        "晴窗画出横斜影，绝胜前村夜雪时。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 3131,
      "title": "夜雨",
      "content": [
        "经岁柴门百事乖，此身只合卧苍苔。",
        "蝉声未足秋风起，木叶俱鸣夜雨来。",
        "棋局可观浮世理，灯花应为好诗开。",
        "独无宋玉悲歌念，但喜新凉入酒杯。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 3132,
      "title": "连雨不能出有怀同年陈国佐",
      "content": [
        "雨师风伯不吾谋，漠漠穷阴断送秋。",
        "欲过苏端泥浩荡，定知高凤麦漂流。",
        "檐前甘菊已无益，阶下决明还可忧。",
        "安得如鸿六尺马，暂时相对说新愁。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 3133,
      "title": "目疾",
      "content": [
        "天公嗔我眼常白，故著昏花阿堵中。",
        "不怪参军谈瞎马，但妨中散送飞鸿。",
        "著篱令恶谁能继，损读方奇定有功。",
        "九恼从来是佛种，会如那律证圆通。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 3134,
      "title": "以事走郊外示友",
      "content": [
        "二十九年知已非，今年依旧壮心违。",
        "黄尘满面人犹去，红叶无言秋又归。",
        "万里天寒鸿雁瘦，千村岁暮鸟乌微。",
        "往来屑屑君应笑，要就南池照客衣。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 3135,
      "title": "十月",
      "content": [
        "十月北风催岁阑，九衢黄土污儒冠。",
        "归鸦落日天机熟，老雁长云行路难。",
        "欲诣热官忧冷语，且求浊酒寄清欢。",
        "孤吟坐到三更月，枯木无枝不受寒。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 3136,
      "title": "题小室",
      "content": [
        "暂脱朝衣不当闲，澶州梦断已多年。",
        "诸公自致青云上，病客长斋绣佛前。",
        "随意时为师子卧，安心懒作野狐禅。",
        "炉烟忽散无踪迹，屋上寒云自黯然。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 3137,
      "title": "次韵张迪功春日",
      "content": [
        "年年春日寒欺客，今日春无一半寒。",
        "不觉转头逢岁换，便须揩目待花看。",
        "争新游女幡垂鬓，依旧先生日照盘。",
        "从此不忧风雪厄，杖藜时可过苏端。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 3138,
      "title": "又和岁除感怀用前韵",
      "content": [
        "宦情吾与岁俱阑，只有诗盟偶未寒。",
        "鬓色定从今夜改，梅花已判隔年看。",
        "高门召客车稠叠，下里烧香篆屈盘。",
        "我亦三杯聊复尔，梦回鹓鹭出朝端。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 3139,
      "title": "张迪功携诗见过次韵谢之二首  其一",
      "content": [
        "黄纸红旗意未阑，青衫俱不救饥寒。",
        "久荒三径未得返，偶有一钱何足看。",
        "世事岂能磨铁砚，诗盟聊可歃铜盘。",
        "不嫌野外时迂盖，政要相从叩两端。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 3140,
      "title": "张迪功携诗见过次韵谢之二首  其二",
      "content": [
        "黄鸡白日唱初阑，便觉杯觞耐薄寒。",
        "坐上客多真足乐，床头易在不须看。",
        "更思深径挼红蕊，政待移厨洗玉盘。",
        "苦恨重城催兴尽，归时落日尚云端。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 3141,
      "title": "即席重赋且约再游  其一",
      "content": [
        "墙头花定觉风阑，墙外池深酒亦寒。",
        "马健莫愁归路远，诗成未许俗人看。",
        "钓鱼不用寻温水，濯发真如到洧盘。",
        "一笑得君天所借，尊前无地著忧端。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 3142,
      "title": "即席重赋且约再游  其二",
      "content": [
        "诗情不与岁情阑，春气犹兼水气寒。",
        "怪我问花终不语，须公走马更来看。",
        "共知浮世悲驹隙，即见平波散芡盘。",
        "得一老兵虽可饮，从今取友要须端。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 3143,
      "title": "次韵家叔",
      "content": [
        "衮衮诸公车马尘，先生孤唱发阳春。",
        "黄花不负秋风意，白发空随世事新。",
        "闭户读书真得计，载肴从学岂无人。",
        "只应又被支郎笑，从者依前困在陈。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 3144,
      "title": "次韵答张迪功坐上见贻张将赴南都任  其一",
      "content": [
        "足钱便可不须侯，免对妻儿赋百忧。",
        "一笑相逢亦奇事，平生所得是清流。",
        "谈天安用如邹子，扫地还应学赵州。",
        "南北东西底非梦，心闲随处有真游。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 3145,
      "title": "次韵答张迪功坐上见贻张将赴南都任  其二",
      "content": [
        "千首能轻万户侯，诵君佳句解人忧。",
        "梦阑尘里功名晚，笑罢尊前岁月流。",
        "世事无穷悲客子，梅花欲动忆吾州。",
        "明朝又作河梁别，莫负平生马少游。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 3146,
      "title": "送张迪功赴南京掾  其一",
      "content": [
        "士固难推挽，君其自宠珍。",
        "诗成建安子，名到斗南人。",
        "晚岁还为客，微官只为身。",
        "向来书尽熟，去不愧张巡。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 3147,
      "title": "送张迪功赴南京掾  其二",
      "content": [
        "岸阔舟仍小，林空风更多。",
        "能堪几寒暑，又作隔山河。",
        "看客休题凤，将书莫换鹅。",
        "功名大槐国，终要白鸥波。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 3148,
      "title": "梅花",
      "content": [
        "高花玉质照穷臈，破雪数枝春已多。",
        "一时倾倒东风意，桃李争春奈晚何。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 3149,
      "title": "与周绍祖分茶",
      "content": [
        "竹影满幽窗，欲出腰髀懒。",
        "何以同岁暮，共此晴云椀。",
        "摩挲蛰雷腹，自笑计常短。",
        "异时分忧虞，小杓勿辞满。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 3150,
      "title": "题画兔",
      "content": [
        "碎身鹰犬惭何忍，埋骨诗书事亦微。",
        "霜露深林可终岁，雌雄暖日莫忘机。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 3151,
      "title": "寄若拙弟兼呈二十家叔",
      "content": [
        "退之送穷穷不去，乐天待富富不来。",
        "政须青山映白发，顾著皂盖争黄埃。",
        "何如父子共一壑，庞家活计良不恶。",
        "阿奴况自不碌碌，白鸥之盟可同诺。",
        "三间瓦屋亦易求，著子东头我西头。",
        "中间共作老莱戏，世上乐复有此不。",
        "问梦膏肓应已瘳，归来归来无久留。",
        "竹林步兵非俗流，为道此意思同游。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3152,
      "title": "次韵谢表兄张元东见寄",
      "content": [
        "平生张翰极风流，好事工文妙九州。",
        "灯里偶然同一笑，书来已似隔三秋。",
        "林泉入梦吾当隐，花鸟催诗岁不留。",
        "安得清谈一陶写，令人绝忆许文休。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 3153,
      "title": "若拙弟说汝州可居已卜约一丘用韵寄元东",
      "content": [
        "四岁冷官桑濮地，三年羸马帝王州。",
        "陶潜迷路已良远，张翰思归那待秋。",
        "病鹤欲飞还踯躅，孤云欲去更迟留。",
        "盍簪共结鸡豚社，一笑相从万事休。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 3154,
      "title": "元方用韵见寄次韵奉谢兼呈元东  其一",
      "content": [
        "大难词源三峡流，小难诗不数苏州。",
        "了无徐生齐气累，正值宁子商歌秋。",
        "鹄飞千里从此始，骥绝九衢谁得留。",
        "岁晚烦君起我病，两篇三叹不能休。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 3155,
      "title": "元方用韵见寄次韵奉谢兼呈元东  其二",
      "content": [
        "一欢玄发水东流，两脚黄尘阅几州。",
        "王湛时须看周易，虞卿未敢著春秋。",
        "不辞彭泽腰常折，却得邯郸梦少留。",
        "有句惊人虽可喜，无钱使鬼故宜休。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 3156,
      "title": "元方用韵寄若拙弟邀同赋元方将托若拙觅颜渊之五十亩故诗中见意",
      "content": [
        "梦中与世极周流，错认三刀是得州。",
        "拟学耕田给公上，要为同社燕春秋。",
        "囊间已办青芒屦，桑间想闻黄栗留。",
        "傥有幽人咨出处，为言无况莫来休。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 3157,
      "title": "西郊春事渐入老境元方欲出游以无马未果今日得诗又有举鞭何日之叹因次韵招之",
      "content": [
        "毛颖陈玄虽胜流，也须从事到青州。",
        "重吟玉树怀崔子，欲唱金衣无杜秋。",
        "官柳正须工部出，园花犹为退之留。",
        "篮舆自可烦儿辈，一笑来从樾下休。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 3158,
      "title": "答元方述怀作",
      "content": [
        "不见圆机论九流，纷纷骑鹤上扬州。",
        "令之敢恨松桂冷，君叔但伤蒲柳秋。",
        "汝海蛇杯应已悟，襄陵驹隙竟难留。",
        "来牛去马无穷债，未盖棺前盍少休。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 3159,
      "title": "六言二首  其一",
      "content": [
        "莫赋涧松鬰鬰，但吟陂麦青青。",
        "为妇读刘伶传，教儿书宁戚经。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3160,
      "title": "六言二首  其二",
      "content": [
        "种竹可侔千户，拥书不假百城。",
        "何必思之烂熟，热官无用分明。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3161,
      "title": "闻葛工部写华严经成随喜赋诗",
      "content": [
        "如来性海深复深，著书与世湔蓬心。",
        "画沙累土皆佛事，况乃一字能千金。",
        "老郎居尘念不起，法中龙象人师子。",
        "前身智永心了然，结习未空犹寄此。",
        "怪公聚笔如须弥，经成笔尽手不知。",
        "凌云题就韦诞老，愿力所到公何疑。",
        "珠函绣帙芝兰室，护持金刚竦神物。",
        "枯葵应感不足论，毛颕陶泓俱见佛。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3162,
      "title": "次韵家弟碧线泉",
      "content": [
        "七孔穿针可得过，冰蚕映日吐寒波。",
        "练飞空咏徐凝水，带断疑分汉帝河。",
        "川后不愁微步袜，鲛人暗动卷绡梭。",
        "才高下视玄虚赋，对此区区转患多。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 3163,
      "title": "同家弟赋蜡梅诗得四绝句  其一",
      "content": [
        "朱朱与白白，著意待春开。",
        "那知洞房里，已傍额黄来。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 3164,
      "title": "同家弟赋蜡梅诗得四绝句  其二",
      "content": [
        "韵胜谁能舍，色庄那得亲。",
        "朝阳一映树，到骨不留尘。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 3165,
      "title": "同家弟赋蜡梅诗得四绝句  其三",
      "content": [
        "黄罗作广袂，绛帐作中单。",
        "人间谁敢著，留得护春寒。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 3166,
      "title": "同家弟赋蜡梅诗得四绝句  其四",
      "content": [
        "一花香十里，更值满枝开。",
        "承恩不在貌，谁敢鬬香来。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 3167,
      "title": "次韵光化宋唐年主簿见寄二首  其一",
      "content": [
        "茂林当日映群贤，也唤畸人到席间。",
        "弃我便惊车辙远，怀君端合鬓毛班。",
        "梦中犹得攀珠树，别后能忘倒玉山。",
        "遥想诗成记来日，笔端风雨发天悭。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 3168,
      "title": "次韵光化宋唐年主簿见寄二首  其二",
      "content": [
        "高人主簿固非宜，天马何妨畧受鞿。",
        "会有梅花堪寄远，可因莼菜便怀归。",
        "相如未免家徒壁，季子行看嫂下机。",
        "且复哦诗置此事，江山相助莫相违。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 3169,
      "title": "再用景纯韵咏怀二首  其一",
      "content": [
        "路断赤墀青琐贤，士龙同此屋三间。",
        "愁边潘令鬓先白，梦里老莱衣更班。",
        "欲学大招那有赋，试谋小隐可无山。",
        "一钱留得真堪笑，未到囊空犹是悭。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 3170,
      "title": "再用景纯韵咏怀二首  其二",
      "content": [
        "木枕蒲团病更宜，从教恶少事鞍鞿。",
        "元无王老又何怨，不有曲生谁与归。",
        "六日取蟾乖世用，三年刻楮费天机。",
        "只应杖屦从公处，未觉平生与愿违。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 3171,
      "title": "谢杨工曹",
      "content": [
        "借屋三间稍离尘，携书一束谩娱身。",
        "客居最负青春好，世事空随白发新。",
        "造化小儿真薄相，市朝大隐亦长贫。",
        "独无芋粟供宾客，虚辱先生赋北邻。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 3172,
      "title": "谨次十七叔去郑诗韵二章以寄家叔一章以自咏  其一",
      "content": [
        "乡里小儿真可怜，市朝大隐正陶然。",
        "固应聊颂屈原橘，底事便歌杨恽田。",
        "广陌遥知驹款段，曲池犹记鹭联拳。",
        "对床夜雨平生约，话旧应惊岁月迁。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 3173,
      "title": "谨次十七叔去郑诗韵二章以寄家叔一章以自咏  其二",
      "content": [
        "蚍蜉堪笑亦堪怜，撼树无功更怫然。",
        "赋就柳州聊解祟，诗成彭泽要归田。",
        "身谋共悔蛇安足，理遣须看佛举拳。",
        "怀祖定知当晚合，次君未可怨稀迁。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
