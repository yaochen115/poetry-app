{
  "data": [
    {
      "id": 3385,
      "title": "游东岩",
      "content": [
        "散策东岩路，梦中曾记经。",
        "斜晖射残雪，岩谷遍晶荧。",
        "鸦鸣山寂寂，意迥川冥冥。",
        "乘兴欲穷讨，会心还少停。",
        "新晴远村白，薄暮群峰青。",
        "危途通仙境，胜日行画屏。",
        "岂独净一念，将期朝百灵。",
        "不同南涧咏，悲慨满中扃。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3386,
      "title": "晚望信道立竹林边",
      "content": [
        "修竹林边烟过迟，幅巾藜杖立疏篱。",
        "恨无顾陆同携手，写取孙郎觅句诗。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 3387,
      "title": "雨晴徐步",
      "content": [
        "百年几晴朝，徐步山径湿。",
        "忽悟春已深，鸣禽飞相及。",
        "雪消众绿净，雾罢群峰立。",
        "涧边千嵁岩，今日何复集。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 3388,
      "title": "同信道晚登古原",
      "content": [
        "幽怀忽牢落，起望登古原。",
        "微吹度修竹，半林白翻翻。",
        "日暮纷物态，山空销客魂。",
        "惜无一樽酒，与子醉中言。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 3389,
      "title": "岸帻",
      "content": [
        "岸帻立清晓，山头生薄阴。",
        "乱云交翠壁，细雨湿青林。",
        "时改客心动，鸟鸣春意深。",
        "穷乡百不理，时得一闲吟。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 3390,
      "title": "雨",
      "content": [
        "云起谷全暗，雨时山复明。",
        "青春望中色，白涧晚来声。",
        "远树鸟群集，高原人独耕。",
        "老夫逃世日，坚坐听阴晴。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 3391,
      "title": "醉中至西径梅花下已盛开",
      "content": [
        "梅花乱发雨晴时，褪尽红绡见玉肌。",
        "醉中忘却头边雪，横插繁枝归竹篱。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 3392,
      "title": "出山二首  其一",
      "content": [
        "阴岩不知晴，路转见朝日。",
        "独行修竹尽，石崖千丈碧。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 3393,
      "title": "出山二首  其二",
      "content": [
        "山空樵斧响，隔岭有人家。",
        "日落潭照树，川明风动花。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 3394,
      "title": "入山二首  其一",
      "content": [
        "出山复入山，路随溪水转。",
        "东风不惜花，一暮都开遍。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 3395,
      "title": "入山二首  其二",
      "content": [
        "都迷去时景，策杖烟漫漫。",
        "微雨洗春色，诸峰生晚寒。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 3396,
      "title": "寒食",
      "content": [
        "竹篱寒食节，微雨澹春意。",
        "喧哗少所便，寂寞今有味。",
        "空山花动摇，乱石水经纬。",
        "倚杖忽已晚，人生本何冀。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 3397,
      "title": "清明",
      "content": [
        "雨晴闲步涧边沙，行入荒林闻乱鸦。",
        "寒食清明惊客意，暖风迟日醉梨花。",
        "书生投老王官谷，壮士偷生漂母家。",
        "不用秋千与蹴游，只将诗句答年华。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 3398,
      "title": "与夏致宏孙信道张巨山同集涧边以散发岩岫为韵赋四小诗  其一",
      "content": [
        "哦诗谷虚响，散发下岩半。",
        "披丛涧影摇，集鸟纷然散。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 3399,
      "title": "与夏致宏孙信道张巨山同集涧边以散发岩岫为韵赋四小诗  其二",
      "content": [
        "乱石披浅流，水纹如绀发。",
        "驰晖忽西没，林光相映发。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 3400,
      "title": "与夏致宏孙信道张巨山同集涧边以散发岩岫为韵赋四小诗  其三",
      "content": [
        "举头山围天，濯足树映潭。",
        "山中记今日，四士集空岩。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 3401,
      "title": "与夏致宏孙信道张巨山同集涧边以散发岩岫为韵赋四小诗  其四",
      "content": [
        "张子卧石榻，夏子理泉窦。",
        "孙子独不言，搘颐数烟岫。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 3402,
      "title": "出山宿向翁家",
      "content": [
        "纸坊山绝顶，直下夕阳斜。",
        "却看来路处，南北两岩花。",
        "田翁邀客宿，笑指林下家。",
        "问我出山意，无乃贵喧哗。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 3403,
      "title": "出山道中",
      "content": [
        "雨歇澹春晓，云气山腰流。",
        "高崖落绛叶，恍如人世秋。",
        "避地时忽忽，出山意悠悠。",
        "溪急竹阴动，谷虚禽响幽。",
        "同行得快士，胜处频淹留。",
        "乘除了身世，未恨落房州。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3404,
      "title": "咏青溪石壁",
      "content": [
        "青溪宜晓日，曲处千丈晦。",
        "天开苍石屏，影落西村外。",
        "虚无元气立，明灭河汉对。",
        "人行峥嵘下，鸟急浩荡内。",
        "向来千万峰，琐细等蓬块。",
        "老夫倚杖久，三叹造物大。",
        "惜哉太史公，意短遗此快。",
        "更欲访野人，穷探视其背。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3405,
      "title": "闻王道济陷虏",
      "content": [
        "海内堂堂友，如今在贼围。",
        "虚传袁盎脱，不见华元归。",
        "浮世身难料，危途计易非。",
        "云孤马息岭，老泪不胜挥。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 3406,
      "title": "均阳官舍有安榴数株著花绝稀更增妍丽",
      "content": [
        "庭际安榴树，花稀更可怜。",
        "青旌拥绛节，伴我作神仙。",
        "迟日耿不暮，微阴眩弥鲜。",
        "一樽兼百虑，心赏竟悠然。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 3407,
      "title": "和王东卿绝句四首  其一",
      "content": [
        "少年走马洛阳城，今作江边瓶锡僧。",
        "说与虎头须画我，三更月里影崚嶒。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 3408,
      "title": "和王东卿绝句四首  其二",
      "content": [
        "来日安榴花尚稀，压墙丹实已垂垂。",
        "何时著我扁舟尾，满袖西风信所之。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 3409,
      "title": "和王东卿绝句四首  其三",
      "content": [
        "只今当代功名手，不数平生粥饭僧。",
        "独立江风吹短发，暮云千里倚崚嶒。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 3410,
      "title": "和王东卿绝句四首  其四",
      "content": [
        "平生不得吟诗力，空使秋霜入鬓垂。",
        "太岳峰前满尊月，为君聊复一中之。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 3411,
      "title": "观江涨",
      "content": [
        "涨江临眺足消忧，倚杖江边地欲浮。",
        "叠浪并翻孤日去，两津横卷半天流。",
        "鼋鼍杂怒争新穴，鸥鹭惊飞失故洲。",
        "可为一官妨快意，眼中唯觉欠扁舟。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 3412,
      "title": "同左通老用陶潜还旧居韵",
      "content": [
        "故园非无路，今已不念归。",
        "秋入汉水白，叶脱行人悲。",
        "东西与南北，欲往还觉非。",
        "勿云去年事，兵火偶脱遗。",
        "可怜竛竮影，残岁聊相依。",
        "天涯一尊酒，细酌君勿催。",
        "持觞望江山，路永悲身衰。",
        "百感醉中起，清泪对君挥。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3413,
      "title": "同通老用渊明独酌韵",
      "content": [
        "纷纷吏民散，遗我以兀然。",
        "悄悄今夕意，鸟影驰隙间。",
        "向来房州谷，采药危得仙。",
        "忽驾太守车，出处宁非天。",
        "何妨暂阅世，谋行要当先。",
        "西斋一壶酒，微雨新秋还。",
        "蛛网闪明晦，叶声饯岁年。",
        "呼儿具纸笔，录我醉中言。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3414,
      "title": "欲离均阳而雨不止书八句寄何子应",
      "content": [
        "江城八月枫叶凋，城头哦诗江动摇。",
        "秋雨留人意恋恋，水风泛树声萧萧。",
        "纶巾老子无远策，长作东西南北客。",
        "不如何逊在扬州，坐待梅花映粧额。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 3415,
      "title": "均阳舟中夜赋",
      "content": [
        "游子不能寐，船头语轻波。",
        "开窗望两津，烟树何其多。",
        "晴江涵万象，夜半光荡摩。",
        "客愁弥世路，秋气入天河。",
        "汝洛尘未销，几人不负戈。",
        "长吟宇宙内，激烈悲蹉跎。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3416,
      "title": "舟次高舍书事",
      "content": [
        "涨水东流满眼黄，泊舟高舍更情伤。",
        "一川木叶明秋序，两岸人家共夕阳。",
        "乱后江山元历历，世间歧路极茫茫。",
        "遥指长沙非谪去，古今出处两凄凉。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 3417,
      "title": "石城夜赋",
      "content": [
        "初月光满江，断处知急流。",
        "沉沉石城夜，漠漠西汉秋。",
        "为客寐常晚，临风意难收。",
        "三更柁楼底，身世入搔头。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 3418,
      "title": "登岳阳楼  其一",
      "content": [
        "洞庭之东江水西，帘旌不动夕阳迟。",
        "登临吴蜀横分地，徙倚湖山欲暮时。",
        "万里来游还望远，三年多难更凭危。",
        "白头吊古风霜里，老木沧波无恨悲。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 3419,
      "title": "登岳阳楼  其二",
      "content": [
        "天入平湖晴不风，夕帆和雁正浮空。",
        "楼头客子杪秋后，日落君山元气中。",
        "北望可堪回白首，南游聊得看丹枫。",
        "翰林物色分留少，诗到巴陵还未工。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 3420,
      "title": "巴丘书事",
      "content": [
        "三分书里识巴丘，临老避胡初一游。",
        "晚木声酣洞庭野，晴天影抱岳阳楼。",
        "四年风露侵游子，十月江湖吐乱洲。",
        "未必上流须鲁萧，腐儒空白九分头。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 3421,
      "title": "晚步湖边",
      "content": [
        "客间无胜日，世故可暂逃。",
        "杖藜迎落照，寒彩遍平皋。",
        "夕湖光景丽，晴鹳声音豪。",
        "天长蒹葭响，水落城堞高。",
        "万象各摇动，慰此老不遭。",
        "楚累经行地，处处余离骚。",
        "幸无大夫责，得伴诸子遨。",
        "终然动怀抱，白发风中搔。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3422,
      "title": "再登岳阳楼感慨赋诗",
      "content": [
        "岳阳壮观天下传，楼阴背日堤绵绵。",
        "草木相连南服内，江湖异态栏干前。",
        "乾坤万事集双鬓，臣子一谪今五年。",
        "欲题文字吊古昔，风壮浪涌心茫然。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 3423,
      "title": "里翁行",
      "content": [
        "里翁无人支缓急，天雨墙坏百忧集。",
        "卖衣雇人筑得墙，不虑偷儿披户入。",
        "夜寒干陬不经过，偷儿若来知奈何。",
        "君不见巴丘古城如培𪣻，鲁肃当年万人守。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3424,
      "title": "居夷行",
      "content": [
        "遭乱始知承平乐，居夷更觉中原好。",
        "巴陵十月江不平，万里北风吹客倒。",
        "洞庭叶稀秋声歇，黄帝乐罢川杲杲。",
        "君山偃蹇横岁暮，天映湖南白如扫。",
        "人世多违壮士悲，干戈未定书生老。",
        "扬州云气鬰不动，白首频回费私祷。",
        "后胜误齐已莫追，范蠡图越当若为。",
        "皇天岂无悔祸意，君子慎惜经纶时。",
        "愿闻群公张王室，臣也安眠送余日。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3425,
      "title": "又登岳阳楼",
      "content": [
        "岳阳楼前丹叶飞，栏干留我不须归。",
        "洞庭镜面平千里，却要君山相发挥。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 3426,
      "title": "除夜二首  其一",
      "content": [
        "城中爆竹已残更，朔吹翻江意未平。",
        "多事鬓毛随节换，尽情灯火向人明。",
        "比量旧岁聊堪喜，流转殊方又可惊。",
        "明日岳阳楼上去，岛烟湖雾看春生。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 3427,
      "title": "除夜二首  其二",
      "content": [
        "万里江湖憔悴身，冬冬街鼓不饶人。",
        "只愁一夜梅花老，看到天明付与春。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 3428,
      "title": "火后问舍至城南有感",
      "content": [
        "魂伤瓦砾旧曾游，尚想奔烟万马遒。",
        "遂替胡儿作正月，绝知回禄相巴丘。",
        "书生性命惊频试，客子茅茨费屡谋。",
        "唯有君山故窈窕，一眉晴绿向人浮。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 3429,
      "title": "晓登燕公楼",
      "content": [
        "栏干纳清晓，拄杖追黄鹄。",
        "燕公不相待，使我立于独。",
        "雾收天落川，日动春浮木。",
        "举手谢时人，微风吹野服。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 3430,
      "title": "火后借居君子亭书事四绝呈粹翁  其一",
      "content": [
        "天公恶剧逐番新，赖是今年有主人。",
        "君子亭中眠白昼，燕公楼上眺青春。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 3431,
      "title": "火后借居君子亭书事四绝呈粹翁  其二",
      "content": [
        "祝融回禄意佳哉，挽我梅花树下来。",
        "一夜东风不知惜，月明满树十分开。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 3432,
      "title": "火后借居君子亭书事四绝呈粹翁  其三",
      "content": [
        "斫竹和梢编作篱，微风如在竹林时。",
        "无人来访庞居士，晚日疏阴光陆离。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 3433,
      "title": "火后借居君子亭书事四绝呈粹翁  其四",
      "content": [
        "入山从此不须深，君子亭中人不寻。",
        "青竹短篱围昼静，梅花两树照春阴。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 3434,
      "title": "再赋  其一",
      "content": [
        "西园芳气雨余新，唤起亭中入定人。",
        "为报使君多酿酒，梅花落尽不关春。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 3435,
      "title": "再赋  其二",
      "content": [
        "扬州云气鬰佳哉，百虑方横吉语来。",
        "却看诗书安隐在，竹篱阴里得时开。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 3436,
      "title": "再赋  其三",
      "content": [
        "危楼只隔一重篱，谁见扶筇独上时。",
        "如许江山懒搜句，燕公应笑我支篱。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 3437,
      "title": "再赋  其四",
      "content": [
        "欲识道人门径深，水仙多处试来寻。",
        "青裳素面天应惜，乞与西园十日阴。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 3438,
      "title": "二十一日风甚明日梅花无在者独红萼留枝间甚可爱也",
      "content": [
        "昨日梅花犹可攀，今朝残萼便斓班。",
        "群仙已御东风去，总脱绛袂留林间。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 3439,
      "title": "咏水仙花五韵",
      "content": [
        "仙人缃色裘，缟衣以裼之。",
        "青帨纷委地，独立东风时。",
        "吹香洞庭暖，弄影清昼迟。",
        "寂寂篱落阴，亭亭与予期。",
        "谁知园中客，能赋会真诗。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3440,
      "title": "望燕公楼下李花",
      "content": [
        "燕公楼下繁华树，一日遥看一百回。",
        "羽盖梦余当昼立，缟衣风急过墙来。",
        "洛阳路不容春到，南国花应为客开。",
        "今日岂堪簪短发，感时伤旧意难裁。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 3441,
      "title": "陪粹翁举酒于君子亭下海棠方开",
      "content": [
        "世故驱人殊未央，聊从地主借绳床。",
        "春风浩浩吹游子，暮雨霏霏湿海棠。",
        "去国衣冠无态度，隔帘花叶有辉光。",
        "使君礼数能宽否，酒味撩人我欲狂。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 3442,
      "title": "春夜感怀寄席大光",
      "content": [
        "管宁白帽且蹁跹，孤鹤归期难计年。",
        "倚杖东南观北变，伤心云雾隔三川。",
        "江湖气动春还冷，鸿雁声回人不眠。",
        "苦忆西州老太守，何时相伴一灯前。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 3443,
      "title": "夜赋寄友",
      "content": [
        "卖药韩康伯，谈经管幼安。",
        "向来甘寂寞，不是为艰难。",
        "微月扶疏树，空园浩荡寒。",
        "细题今夕景，持与故人看。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 3444,
      "title": "阴风",
      "content": [
        "阴风三日吹南极，二月巴陵寒裂石。",
        "长林巨木受轩轾，洞庭倒流潇湘黑。",
        "君不见古庐竹扉声策策，中有竛竮落南客。",
        "曾经破胆向炎官，敢不修容待风伯。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3445,
      "title": "雨",
      "content": [
        "霏霏三日雨，蔼蔼一园青。",
        "雾泽含元气，风花过洞庭。",
        "地偏寒浩荡，春半客竛竮。",
        "多少人间事，天涯醉又醒。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 3446,
      "title": "春寒",
      "content": [
        "二月巴陵日日风，春寒未了怯园公。",
        "海棠不惜臙脂色，独立蒙蒙细雨中。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 3447,
      "title": "次韵傅子文绝句",
      "content": [
        "风雨门前十日泥，荒街相伴只筇枝。",
        "从今老子都无事，落尽园花不赋诗。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 3448,
      "title": "周尹潜雪中过门不我顾遂登西楼作诗见寄次韵谢之三首  其一",
      "content": [
        "晓窗飞雪惬幽听，起觅新诗自启扃。",
        "不觉高轩墙外过，贪看万鹤舞中庭。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 3449,
      "title": "周尹潜雪中过门不我顾遂登西楼作诗见寄次韵谢之三首  其二",
      "content": [
        "堪笑臞仙也耐寒，飞花端合上楼看。",
        "深知壮观增诗律，洗尽元和到建安。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 3450,
      "title": "周尹潜雪中过门不我顾遂登西楼作诗见寄次韵谢之三首  其三",
      "content": [
        "敲门俗子令我病，面有三寸康衢埃。",
        "风饕雪虐君驰去，蓬户那无酒一杯。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 3451,
      "title": "城上晚思",
      "content": [
        "独凭危堞望苍梧，落日君山如画图。",
        "无数柳花飞满岸，晚风吹过洞庭湖。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 3452,
      "title": "雨中对酒庭下海棠经雨不谢",
      "content": [
        "巴陵二月客添衣，草草杯觞恨醉迟。",
        "燕子不禁连夜雨，海棠犹待老夫诗。",
        "天翻地覆伤春色，齿豁头童祝圣时。",
        "白竹篱前湖海阔，茫茫身世两堪悲。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 3453,
      "title": "寻诗两绝句  其一",
      "content": [
        "楚酒困人三日醉，园花经雨百般红。",
        "无人画出陈居士，亭角寻诗满袖风。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 3454,
      "title": "寻诗两绝句  其二",
      "content": [
        "爱把山瓢莫笑侬，愁时引睡有奇功。",
        "醒来推户寻诗去，乔木峥嵘明月中。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 3455,
      "title": "寒食日游百花亭",
      "content": [
        "晴气已复浊，虚馆可淹留。",
        "微花耿寒食，始觉在他州。",
        "自闻鼙鼓聒，不恨岁月流。",
        "乱代有今夕，兹园况堪游。",
        "云移树阴失，风定川华收。",
        "曳杖新城下，日暮禽语幽。",
        "群行意易分，独赏兴难周。",
        "永啸以自畅，片月生城头。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3456,
      "title": "王应仲欲附张恭甫舟过湖南久不决今日忽闻遂登舟作诗送之并简恭甫",
      "content": [
        "我身如孤云，随风堕湖边。",
        "墙东木阴好，初识避世贤。",
        "从来有名士，不用无名钱。",
        "披君三迳草，分我一味禅。",
        "胡为黄鹄举，忽上湖南船。",
        "竟随文若去，聊伴元礼仙。",
        "洞庭烟发渚，潇湘雨鸣川。",
        "三老好看客，天高柁楼前。",
        "子鱼独留滞，坐送管邴迁。",
        "作诗相棹讴，寄恨余酸然。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3457,
      "title": "周尹潜以仆有郢州之命作诗见赠有横槊之句次韵谢之",
      "content": [
        "一岁忧兵四阅时，偷生不恨隙驹驰。",
        "如何南纪持竿手，却把西州破贼旗。",
        "傥有青油盛快士，何妨画戟入新诗。",
        "因君调我还增气，男子平生政要奇。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 3458,
      "title": "次韵尹潜感怀",
      "content": [
        "胡儿又看绕淮春，叹息犹为国有人。",
        "可使翠华周宇县，谁持白羽静风尘。",
        "五年天地无穷事，万里江湖见在身。",
        "共说金陵龙虎气，放臣迷路感烟津。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 3459,
      "title": "五月二日避贵寇入洞庭湖绝句",
      "content": [
        "鼓发嘉鱼千面雷，乱帆和雨向湖开。",
        "何妨南北东西客，一听湘妃瑶瑟来。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 3460,
      "title": "过君山不获登览",
      "content": [
        "我梦君山好，万里来南州。",
        "青眉横玉镜，色照城中楼。",
        "胜日空倚眺，经年未成游。",
        "今朝过山下，贼急不敢留。",
        "嵌空浪吞吐，荟蔚风飕飗。",
        "龙吟杂虎啸，九夏含三秋。",
        "了与遥赏异，况乃行岩幽。",
        "蚍蜉何当扫，延伫回我舟。",
        "掷去九节筇，褰裳走林丘。",
        "会逢湘君降，翠气衣上浮。",
        "山椒望苍梧，寄恨舒冥搜。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3461,
      "title": "细雨",
      "content": [
        "避寇烦三老，那知是胜游。",
        "平湖受细雨，远岸送轻舟。",
        "天地悲深阻，山川慰久留。",
        "参差发邻舫，未觉壮心休。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 3462,
      "title": "泊宋田遇厉风作",
      "content": [
        "逐队避狂寇，湖中可盘嬉。",
        "泊舟宋田港，俯仰看云移。",
        "造物犹不借，颠风忽横吹。",
        "洞庭何其大，浪挟雷车驰。",
        "可怜岸上竹，翻倒不自持。",
        "老夫元耐事，淹速本无期。",
        "会有天风定，见汝亭亭时。",
        "五月念貂裘，竟生薄暮悲。",
        "萧萧不自畅，耿耿独题诗。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3463,
      "title": "二十二日自北沙移舟作是日闻贼革面",
      "content": [
        "宛宛转湖滩，遥遥隔城邑。",
        "是时雨初霁，众绿带余湿。",
        "晓泽澹不波，菰浦觉风入。",
        "我生莽未定，世故纷相袭。",
        "腼然贺兰面，安视一坐泣。",
        "岂知虎与狼，义感功反集。",
        "尧俗可尽封，呜呼吾何及。",
        "气苏巨浸内，未恨乏供给。",
        "日历会有穷，吾行岂须急。",
        "近树背人去，远树久凝立。",
        "聊以忧世心，寄兹忘怏悒。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3464,
      "title": "赠傅子文",
      "content": [
        "渔子牧儿谈笑新，先生胜日步湖滣。",
        "沙边忽见长身士，头上仍欹折角巾。",
        "豺虎不能宽远俗，山川终要识诗人。",
        "芦丛如画斜阳里，拄杖相寻无杂宾。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 3465,
      "title": "晚晴野望",
      "content": [
        "洞庭微雨后，凉气入纶巾。",
        "水底归云乱，芦藂返照新。",
        "遥汀横薄暮，独鸟度长津。",
        "兵甲无归日，江湖送老身。",
        "悠悠只倚杖，悄悄自伤神。",
        "天意苍茫里，村醪亦醉人。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3466,
      "title": "雨中",
      "content": [
        "雨打船蓬声百般，白头当夏不禁寒。",
        "五湖七泽经行遍，终忆吾乡八节滩。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 3467,
      "title": "舟抵华容县",
      "content": [
        "篙舟入华容，白水绕城堞。",
        "夹津列茂树，倒影青相接。",
        "远色分村坞，微凉动芦叶。",
        "天地困腐儒，江湖托孤檝。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 3468,
      "title": "夜赋",
      "content": [
        "泊舟华容县，湖水终夜明。",
        "凄然不能寐，左右菰蒲声。",
        "穷途事多违，胜处亦心惊。",
        "三更萤火闹，万里天河横。",
        "阿瞒狼狈地，山泽空峥嵘。",
        "强弱与兴衰，今古莽难评。",
        "腐儒忧平世，况复值甲兵。",
        "终然无寸策，白发满头生。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3469,
      "title": "月夜",
      "content": [
        "独立夜𫐖轕，芦声泛遥津。",
        "月下风起波，莽莽白龙鳞。",
        "阴彩凝草木，暑气森星辰。",
        "天地尘未消，江湖气聊伸。",
        "人生几今夕，乱代偶此身。",
        "胡为不少乐，况乃迹易陈。",
        "三更大鱼舞，悄怆惊心神。",
        "永怀骑鲸士，发兴烟中新。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3470,
      "title": "晚晴",
      "content": [
        "幽卧不知晴，樯梢见斜日。",
        "披衣起四望，天际山争出。",
        "光辉渚蒲净，意气沙鸥逸。",
        "避盗半九围，两脚不遗力。",
        "川陵各异态，艰险常一律。",
        "胡为作弧矢，前圣意莫诘。",
        "岂知百代后，反使奸宄密。",
        "腐儒徒叹嗟，救弊知无术。",
        "人生如归云，空行杂徐疾。",
        "薄暮俱到山，各不见踪迹。",
        "念此百年内，可复受忧戚。",
        "林木方翳然，放怀陶兹夕。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3471,
      "title": "寥落",
      "content": [
        "寥落洞庭野，微风泛客裾。",
        "袁宏咏史罢，孙登清啸余。",
        "月明流水去，夜静芙蓉舒。",
        "城郭方多事，野兴一萧疏。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 3472,
      "title": "自五月二日避寇转徙湖中复从华容道乌沙还郡七月十六日夜半出小江口宿焉徙倚柁楼书事十二句",
      "content": [
        "回环三百里，行尽力都穷。",
        "巴丘左移右，章华西转东。",
        "江声摇斗柄，秋色弥葭丛。",
        "群木立波上，芙蕖披月中。",
        "镜湖应足比，剡溪那可同。",
        "世将非识事，孤啸聊延风。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3473,
      "title": "闰八月十二日过奇父共坐翠窦轩赏木犀花玲珑满枝光气动人念风日不贷此花无五日香矣而王使君未之知作小诗报之",
      "content": [
        "清露香浮黄玉枝，使君未到意低迷。",
        "极知有日交铜虎，可使无情向木犀。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 3474,
      "title": "再赋二首呈奇父  其一",
      "content": [
        "国香薰坐先生醉，秋叶藏花客子迷。",
        "驱使晚风同胜地，东轩不用镇帷犀。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 3475,
      "title": "再赋二首呈奇父  其二",
      "content": [
        "香遍东园花一枝，寻花觅路忽成迷。",
        "先生莫道心如铁，喜气朝来横角犀。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 3476,
      "title": "十三日再赋二首其一以赞使君是日对花赋此韵诗笔落纵横而郡中修水战之具方大阅于燕公楼下也其一自叙所感忆年十五在杭州始识此花皆三丈高木尝赋诗焉  其一",
      "content": [
        "我丈风流元祐枝，晴轩雨雹笔端迷。",
        "从容文武一时了，赋罢木犀观水犀。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 3477,
      "title": "十三日再赋二首其一以赞使君是日对花赋此韵诗笔落纵横而郡中修水战之具方大阅于燕公楼下也其一自叙所感忆年十五在杭州始识此花皆三丈高木尝赋诗焉  其二",
      "content": [
        "武林曾识最高枝，百感重逢岁月迷。",
        "向日擘牋须彩凤，如今执楯要文犀。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 3478,
      "title": "九月八日登高作重九奇父赋三十韵与义拾余意亦赋十二韵  其一",
      "content": [
        "九月风景好，节意满天涯。",
        "书生尊所闻，登高乱城鸦。",
        "虽无后乘丽，前驱载黄花。",
        "两楼压波壮，众泽分夭斜。",
        "居夷惊有苗，访古悲章华。",
        "萧条湖海事，胜日一笑哗。",
        "兴移三里亭，木影杂蛟蛇。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3479,
      "title": "九月八日登高作重九奇父赋三十韵与义拾余意亦赋十二韵  其二",
      "content": [
        "二士醉藜杖，两禅风袈裟。",
        "奇哉古无有，未觉欠孟嘉。",
        "天公亦喜我，催诗出微霞。",
        "赋罢迹已陈，忧乐如转车。",
        "却后五百岁，远俗增雄夸。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3480,
      "title": "两绝句  其一",
      "content": [
        "西风吹日弄晴阴，酒罢三巡湖海深。",
        "岳阳楼上登高节，不负南来万里心。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 3481,
      "title": "两绝句  其二",
      "content": [
        "二士相随风满巾，两禅同队景弥新。",
        "但得黄花不牢落，莫嫌惊倒岳州人。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 3482,
      "title": "粹翁用奇父韵赋九日与义同赋兼呈奇父",
      "content": [
        "安隐轻节序，艰难惜欢娱。",
        "先生守苜蓿，朝士夸茱萸。",
        "前年邓州城，风雨倾客居。",
        "何尝疏曲生，曲生自我疏。",
        "岂无登高地，送目与云俱。",
        "门生及儿子，劝我升篮舆。",
        "出门复入门，戈旆填街衢。",
        "去年郢州岸，孤檝对坏郛。",
        "莫招大夫魂，谁揽使君须。",
        "独题怀古句，枯砚生明珠。",
        "亦复跻荒戍，日暮野踟蹰。",
        "白衣终不至，眇眇空愁予。",
        "今年洞庭上，九折余崎岖。",
        "时凭岳阳楼，山川看萦纡。",
        "孙兄语蝉连，王丈色敷腴。",
        "不用踏筵舞，秋风摇菊株。",
        "乐哉未曾有，是梦其非欤。",
        "丈夫各堂堂，坐受世故驱。",
        "会须明年节，醉倒还相扶。",
        "此花期复对，勿令堕空虚。",
        "明日风景佳，南翔先一凫。",
        "可言知机早，政尔因鲈鱼。",
        "分襟肺肝热，抚事岁月迂。",
        "归家问瓶锡，生理何必余。",
        "相期衡山南，追步凌忽区。",
        "回首望尧云，中原莽榛芜。",
        "臣岂专爱死，有怀竟不舒。",
        "老谋与壮事，二者惭俱无。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3483,
      "title": "送王因叔赴试",
      "content": [
        "枫落南纪明，秋高洞庭白。",
        "自是天涯人，更送湖上客。",
        "人生险易乘除里，富贵功名从此始。",
        "不须惜别作酸然，满路新诗付吾子。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3484,
      "title": "己酉九月自巴丘过湖南别粹翁",
      "content": [
        "离合不可常，去处两无策。",
        "眇眇孤飞雁，严霜欺羽翼。",
        "使君南道主，终岁好看客。",
        "江湖尊前深，日月梦中疾。",
        "世事不相贷，秋风撼瓶锡。",
        "南云本同征，变化知无极。",
        "四年孤臣泪，万里游子色。",
        "临别不得言，清愁涨胸臆。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
