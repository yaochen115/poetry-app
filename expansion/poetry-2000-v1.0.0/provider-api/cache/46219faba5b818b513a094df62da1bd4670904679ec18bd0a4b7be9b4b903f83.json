{
  "data": [
    {
      "id": 249386,
      "title": "读书四首  其三",
      "content": [
        "朝游夕泳一窗书，只要今吾胜昔吾。",
        "未识此间真气味，直缘圣处少工夫。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 249387,
      "title": "读书四首  其四",
      "content": [
        "勿谓微言久绝弦，六经正用此心传。",
        "假令坏壁无余烬，日月堂堂故丽天。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 249388,
      "title": "校书戏成",
      "content": [
        "旧时天禄校书郎，习气薰人老未忘。",
        "可笑当窗楮生面，郤成宫额半涂黄。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 249389,
      "title": "病起始浴二首  其一",
      "content": [
        "无数尘埃一病身，不蒙湔拂几经旬。",
        "政须皂荚相料理，可笑梁州阴子春。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 249390,
      "title": "病起始浴二首  其二",
      "content": [
        "欲著床头澣濯衣，汗流成雨垢成泥。",
        "呼儿为我供汤事，今日身轻好杖藜。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 249391,
      "title": "雪后月窗戏题",
      "content": [
        "青女翻空一笑开，天花散尽更徘徊。",
        "嫦娥相与有瓜葛，也向读书窗下来。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 249392,
      "title": "题陆务观草堂",
      "content": [
        "草堂人去客来游，竹笕泉鸣山更幽。",
        "向使经营无陆子，残僧古寺不宜秋。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 249393,
      "title": "人日",
      "content": [
        "雪意垂垂体不佳，十年人日寄天涯。",
        "老来只有穷相守，忍使奴星结柳车。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 249394,
      "title": "寒食日诵老杜示宗文宗武诗寄二子",
      "content": [
        "衰年寒食又清明，欹枕诗成字不成。",
        "欲寄宗文与宗武，一春风雨大江横。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 249395,
      "title": "春晴",
      "content": [
        "莫春已办曾点服，急雨又垫林宗巾。",
        "一晴政为吾辈设，速载家酿羞厨珍。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 249396,
      "title": "己巳歳夏旱大热睡起偶成  其一",
      "content": [
        "年年暑去皆有期，今年暑去何迟迟。",
        "不知摇败几团扇，得到西风吹面时。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 249397,
      "title": "己巳歳夏旱大热睡起偶成  其二",
      "content": [
        "青天无云日亭午，群巫祷祈且呼舞。",
        "老夫饶睡昏昏然，鼻息如雷汗如雨。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 249398,
      "title": "夏夜闻雨",
      "content": [
        "凉风急雨夜萧萧，便恐江南草木雕。",
        "自为丰年喜无寐，不关窗外有芭蕉。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 249399,
      "title": "久雨",
      "content": [
        "小雨飞空十日余，苔钱称意上阶除。",
        "芒鞋不踏门前路，坐听呕哑过竹舆。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 249400,
      "title": "道中遇雨",
      "content": [
        "客子祈晴意未公，林间布谷劝春农。",
        "雨师若有分风手，留取车轮一道通。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 249401,
      "title": "郑顾道冲雨见过",
      "content": [
        "荷橐临门门未开，多泥穷巷遍苍苔。",
        "始知犹胜杜陵老，旧雨客来今亦来。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 249402,
      "title": "九日二首  其一",
      "content": [
        "尊前韵度落乌纱，却是西风识孟嘉。",
        "当日龙山无数客，问谁整整复斜斜。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 249403,
      "title": "九日二首  其二",
      "content": [
        "儋耳重阳菊满头，恰如佳月即中秋。",
        "归来唱著中原句，却道黄花蝶也愁。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 249404,
      "title": "雪晴",
      "content": [
        "未快溪桥踏雪心，朝阳已复上遥岑。",
        "可怜昨夜琼瑶迹，化作春泥尺许深。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 249406,
      "title": "疏山一览亭",
      "content": [
        "青云梯尽得朱栏，不但令人六月寒。",
        "无限江南好山水，庵摩勒果掌中看。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 249407,
      "title": "鸣水驿",
      "content": [
        "一道溪流百转深，挼蓝如色珮如音。",
        "青蔬几叶来何处，知有幽人底事寻。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 249408,
      "title": "次奄中二陆韵",
      "content": [
        "问石寻泉到竹斋，木犀花尽菊花开。",
        "老僧有约君知否，乘兴前村雪里来。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 249409,
      "title": "游张公善权二洞四首  其一",
      "content": [
        "此邦胜处名天下，今日争来入眼中。",
        "笻杖一枝舟一叶，山行冲雨水冲风。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 249410,
      "title": "游张公善权二洞四首  其二",
      "content": [
        "缦缨乳盖张公洞，风驭云𫐌定不无。",
        "勿以衰翁作生客，旧时相识选仙图。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 249411,
      "title": "游张公善权二洞四首  其三",
      "content": [
        "自疑身是洞中仙，才出张公又善权。",
        "只道石田无用处，种成玉粒至今传。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 249412,
      "title": "游张公善权二洞四首  其四",
      "content": [
        "善权石状说不尽，怪怪奇奇惊倒人。",
        "大屋修廊岩下路，凄风冷雨洞中春。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 249413,
      "title": "禽声四首  其一",
      "content": [
        "劝我行沽聒昼眠，看人烂醉买江天。",
        "兴来亦欲提壶去，未有苏公乞酒钱。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 249414,
      "title": "禽声四首  其二",
      "content": [
        "幽禽竟日引圆吭，脱袴催人有底忙。",
        "不但春天无衣著，凄风冷雨绝须防。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 249415,
      "title": "禽声四首  其三",
      "content": [
        "春泥滑滑强知时，野日荒荒已露机。",
        "政与鹁鸠同一律，朝来唤得阿姑归。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 249416,
      "title": "禽声四首  其四",
      "content": [
        "有酒如淮肉如坻，何如麦饭滑流匙。",
        "但看此物丰登日，即是侬家快活时。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 249417,
      "title": "三衢道中",
      "content": [
        "梅子黄时日日晴，小溪泛尽却山行。",
        "绿阴不减来时路，添得黄鹂四五声。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 249418,
      "title": "途中二首  其一",
      "content": [
        "鹁鸠晴雨报人知，更问农家底事宜。",
        "村落泥干收麦地，稻田水满插秧时。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 249419,
      "title": "途中二首  其二",
      "content": [
        "小麦青青大麦黄，新蚕满箔稻移秧。",
        "绿阴马倦休亭午，芳草牛闲卧夕阳。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 249420,
      "title": "痁病  其一",
      "content": [
        "谁言似病元非病，一日之间行四时。",
        "不用文殊来问疾，个中实怕有人知。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 249421,
      "title": "痁病  其二",
      "content": [
        "老身危似草头露，疾势来如江上潮。",
        "寒热自无安著处，不然何以脱今朝。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 249422,
      "title": "诗催",
      "content": [
        "练裙染翰初不惜，布袋写真殊未来。",
        "并作山房一奇事，临岐更著小诗催。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 249423,
      "title": "道逢王左丞不及避谢之二首  其一",
      "content": [
        "西风黄叶北门街，有句无人为翦裁。",
        "冲突前驱公会否，要求一语定敲推。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 249424,
      "title": "道逢王左丞不及避谢之二首  其二",
      "content": [
        "黄童白叟趁虚回，左辖车前拨不开。",
        "记得绿槐阴御路，万人辟易绣鞌来。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 249425,
      "title": "独步小园四首  其一",
      "content": [
        "江梅落尽红梅在，百叶缃梅賸欲开。",
        "园里无人园外静，暗香引得数蜂来。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 249426,
      "title": "独步小园四首  其二",
      "content": [
        "只道江梅发不迟，最先零落使人悲。",
        "从今秾李花千树，未抵前村雪一枝。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 249427,
      "title": "独步小园四首  其三",
      "content": [
        "谁将山杏臙脂色，来作江梅玉颊红。",
        "但得暗香疏影在，不妨妆面对春风。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 249428,
      "title": "独步小园四首  其四",
      "content": [
        "山衣重叠六铢轻，淡拂槐花染不成。",
        "报答春工选何物，鹅儿黄酒十分倾。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 249429,
      "title": "书陆务观所藏阿罗汉像一轴",
      "content": [
        "大阿罗汉十有六，一一腾空见人足。",
        "手持贝叶坐禅林，称不动尊惟我独。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 249430,
      "title": "送李商叟秀才还临川",
      "content": [
        "一春雾雨暗溪山，城北城南断往还。",
        "政是晴时君又去，望君烟艇有无间。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 249431,
      "title": "题天衣寺",
      "content": [
        "布袜青鞋踏欲无，登山临水未成疏。",
        "十峰双涧天衣寺，万壑千岩总不如。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 249432,
      "title": "再题天衣寺",
      "content": [
        "画舫珠帘出缭墙，天风吹到芰荷乡。",
        "水光入座杯盘莹，花气侵人笑语香。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 249433,
      "title": "再过翠屏",
      "content": [
        "蛮荒乃有此巑岏，石黛因依碧玉寒。",
        "须信佳山如绝色，凭谁貌取一生看。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 249434,
      "title": "求李生画山水屏",
      "content": [
        "乞君山石洪涛句，来作围床六幅屏。",
        "持向岭南烟雨里，梦成江上数峰青。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 249435,
      "title": "书左举善秀才乞米图",
      "content": [
        "乞米鲁公书作帖，睎颜处士画成图。",
        "若教浑似侏儒饱，还有流传翰墨无。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 249436,
      "title": "书徐明叔访戴图",
      "content": [
        "小艇相从本不期，剡中雪月并明时。",
        "不因兴尽回船去，那得山阴一段奇。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 249437,
      "title": "乞猫二首  其一",
      "content": [
        "春来鼠壤有余蔬，乞得猫奴亦已无。",
        "青蒻裹盐仍裹茗，烦君为致小於菟。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 249438,
      "title": "乞猫二首  其二",
      "content": [
        "江茗吴盐雪不如，更令女手缀红𢄼。",
        "小诗却欠涪翁句，为问衔蝉聘得无。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 249439,
      "title": "木鱼戏成",
      "content": [
        "缘木求鱼却得鱼，击鲜日日向斋盂。",
        "可怜钩挂濠梁上，大胜冯驩每食无。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 249440,
      "title": "怪石",
      "content": [
        "眼前突兀见此石，怪怪奇奇俱可人。",
        "为问何如潘骑省，世间妍丑本非真。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 249441,
      "title": "竹奴",
      "content": [
        "雾帐桃笙昼寝余，此君那可一朝无。",
        "秋来冷落同班扇，歳晚温柔是锡奴。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 249442,
      "title": "绿毛龟",
      "content": [
        "若为介物成毛物，颜色挼蓝省见稀。",
        "定是多生捕鱼子，至今犹著绿蓑衣。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 249443,
      "title": "白龟",
      "content": [
        "一种龟儿玉雪然，故人为寄小如钱。",
        "会当放汝江湖去，小住盆池慰眼前。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 249444,
      "title": "荔子六言",
      "content": [
        "蕉叶定成哙伍，梅花应愧卢前。",
        "金谷危楼魂断，白州旧井名传。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 249445,
      "title": "绝句",
      "content": [
        "自公退食入僧定，心与香字俱寒灰。",
        "小儿了不解人意，正用此时持事来。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 249446,
      "title": "读吕居仁旧诗有怀其人作诗寄之",
      "content": [
        "学诗如参禅，慎勿参死句。",
        "纵横无不可，乃在欢喜处。",
        "又如学仙子，辛苦终不遇。",
        "忽然毛骨换，正用口诀故。",
        "居仁说活法，大意欲人悟。",
        "常言古作者，一一从此路。",
        "岂惟如是说，实亦造佳处。",
        "其圆如金弹，所向若脱兔。",
        "风吹春空云，顷刻多态度。",
        "锵然奏琴筑，间以八珍具。",
        "人谁无口耳，宁不起欣慕。",
        "一编落吾手，贪读不能去。",
        "尝疑君胸中，食饮但风露。",
        "经年阙亲近，方寸满尘雾。",
        "足音何时来，招唤亦云屡。",
        "贱子当为君，移家七闽住。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 249447,
      "title": "剡溪竹纸三首  其一",
      "content": [
        "会稽竹箭东南美，来伴陶泓住管城。",
        "可惜不逢韩吏部，相从但说楮先生。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 249448,
      "title": "剡溪竹纸三首  其二",
      "content": [
        "会稽竹箭东南美，化作经黄纸叠层。",
        "旧日土毛无用处，剡中老却一溪藤。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 249449,
      "title": "剡溪竹纸三首  其三",
      "content": [
        "会稽竹箭东南美，研席之间见此君。",
        "为间溪工底方法，杀青书字有前闻。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 249450,
      "title": "放猿",
      "content": [
        "孤猿锁槛岁年深，放出城南百丈林。",
        "绿水任从联臂饮，青山不用断肠吟。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 249451,
      "title": "过水东",
      "content": [
        "出郭市声远，过溪山色多。",
        "稻畦春雨足，野水晚迎波。",
        "客自无轩冕，今谁在涧阿。",
        "相逢不相识，归去梦松萝。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 249452,
      "title": "三霄亭和韵",
      "content": [
        "新亭崛起最高峰，无数遥岑翠扫空。",
        "恐有谢公留屐齿，为闻摩诘画屏风。",
        "倚江杨柳自高下，照水杏花能白红。",
        "正欠渭川千亩竹，清阴分借赖邻翁。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 249453,
      "title": "寄空同山中道士",
      "content": [
        "昨夜清霜重，念此山中客。",
        "落叶聚堆床，暗虫吟败壁。",
        "泬漻天宇肃，疏林风瑟瑟。",
        "曳杖挂诗瓢，悠然适所适。",
        "息心归冥漠，山深万籁寂。",
        "散髪排天闼，叱咤鞭龙脊。",
        "何时共采药，相与对晨夕。",
        "月夜供洪崖，啸吟铿金石。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 249454,
      "title": "蟹",
      "content": [
        "旧交髯簿久相忘，公子相从独味长。",
        "醉死糟丘终不悔，看来端的是无肠。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 249455,
      "title": "糟蟹",
      "content": [
        "风味端宜配曲生，无肠公子藉糟成。",
        "可怜不作空虚腹，尚想能为郭索行。",
        "张翰莼鲈休发兴，洞庭虾蟹可忘情。",
        "君看醉死真奇事，不受人间五鼎烹。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 249456,
      "title": "钱仲修饷新蟹",
      "content": [
        "开奁破壳喜新黄，此物移来所未尝。",
        "一手正宜深把酒，二螯已是饱经霜。",
        "横行足使班寅惧，干死能令疟鬼亡。",
        "毕竟爬沙能底事，祇应大嚼慰枯肠。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 249457,
      "title": "赠王明清",
      "content": [
        "吾宗择婿得羲之，令子传家又绝奇。",
        "甥舅从来多酷似，弟兄如此信难为。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 249458,
      "title": "题意大师房",
      "content": [
        "头白高僧心已灰，石菖蒲长水蕉开。",
        "庄严茗事炉烟起，不用关防俗子来。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 249459,
      "title": "长淮有感",
      "content": [
        "目送长淮去不回，登临万感集层台。",
        "波间定有隋渠水，曾向大梁城下来。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 249460,
      "title": "寄许子礼",
      "content": [
        "草堂竹坞闭门中，吏部持身有古风。",
        "老去一麾还作病，归来四壁又成空。",
        "今朝札翰如无恙，旧日诗书却未穷。",
        "拭目看君进明德，乃兄事业付天公。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 249461,
      "title": "赠外甥吕祖谦",
      "content": [
        "昔别溪南寺，奇庞总角儿。",
        "传闻不好弄，賸喜更能诗。",
        "弦术真吾道，躬行是汝师。",
        "掖垣家学在，何以徧参为。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 249462,
      "title": "将适台州",
      "content": [
        "风林何许著惊禽，惟有台州旧所临。",
        "避地妻孥虽在眼，藏山文字却关心。",
        "维扬大将金城固，建业名臣天椠深。",
        "说与单于归去好，长淮边是杀胡林。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 249463,
      "title": "冬",
      "content": [
        "岁事空余数行历，年劳绕得几篇诗。",
        "犹悭雪片下弥陇，已放梅花开满枝。",
        "便是东风来解冻，春盘生菜属群儿。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 249464,
      "title": "寄空禅师",
      "content": [
        "江西句法空公得，一向逃禅挽不回。",
        "深密伽陀妙天下，无人知道派中来。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 249465,
      "title": "海棠",
      "content": [
        "空谷嫣然笑靥开，春风元自蜀山来。",
        "少陵忘却浑闲事，更有离骚忘却梅。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 249466,
      "title": "水仙花",
      "content": [
        "坐令簪一枝，蛾眉淡初扫。",
        "笑弄黄金杯，连台盘拗倒。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 249467,
      "title": "山矾",
      "content": [
        "青云叶底雪花繁，只与田家插髻鬟。",
        "不枉涪翁初着句，能令大士久开颜。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 249468,
      "title": "石菖蒲",
      "content": [
        "窗明几净室空虚，尽道幽人一事无。",
        "莫道幽人无一事，汲泉承露养菖蒲。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 249469,
      "title": "芭蕉",
      "content": [
        "以此叶阴凉，代彼青瑯玕。",
        "但恐本质脆，不堪期岁寒。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 249470,
      "title": "荠",
      "content": [
        "盘餐到野荠，曳杖闲挑根。",
        "幽人此味熟，俗子谁知津。",
        "微物经品题，便作席上珍。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 249471,
      "title": "把酒思闲事二首  其一",
      "content": [
        "把酒思闲事，春愁谁最深。",
        "乞钱羁客面，落第举人心。",
        "月下低眉立，灯前抱膝吟。",
        "凭君劝一醉，胜与万黄金。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 249472,
      "title": "把酒思闲事二首  其二",
      "content": [
        "把酒思闲事，春娇何处多。",
        "试鞍新白马，弄镜小青娥。",
        "掌上初教舞，花头欲按歌。",
        "凭君劝一醉，劝了又如何。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 249473,
      "title": "晚春酒醒寻梦得",
      "content": [
        "料合同惆怅，花残酒亦残。",
        "醉心忘老易，醒眼别春难。",
        "独出虽慵懒，相逢定喜欢。",
        "还携小蛮去，试觅老刘看。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 249474,
      "title": "投壶",
      "content": [
        "连朝赐沐吏功休，请以陶壶竹矢投。",
        "整整斜斜森剑戟，纷纷借借委戈矛。",
        "坐人各自庆多马，老子不惟输一筹。",
        "中否何关兴废事，天公应解笑齐侯。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 249475,
      "title": "投壶全中戏成",
      "content": [
        "寸心只在所投中，出手何曾一箭空。",
        "不作秋风铺落叶，端如春草种成丛。",
        "旁观讵敢当勍敌，俯拾无劳命短童。",
        "说与妻孥须办取，如山酒肉贺全功。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 249476,
      "title": "次韵陈鲁山正字社日同西湖  其一",
      "content": [
        "昔在儿童岁，湖山入眼新。",
        "只今余白髪，何以报青春。",
        "日暖繁游子，年丰乐社神。",
        "诸公勤载酒，四事每参辰。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 249477,
      "title": "次韵陈鲁山正字社日同西湖  其二",
      "content": [
        "鬓髪垂领白，尘埃迎面红。",
        "相从林下寸，一洗水边风。",
        "写物诗无敌，蠲愁酒有功。",
        "夕阳应更好，可惜在城中。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 249478,
      "title": "郡斋偶成",
      "content": [
        "卧病江东久，饥驱强作官。",
        "年丰双雪鬓，心事一蒲团。",
        "帘影垂昼寂，竹阴生夏寒。",
        "无人知老子，于此有余欢。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 249479,
      "title": "观四种梅  其一",
      "content": [
        "花信风从底处来，水边探得一枝开。",
        "箯舆日日溪南北，看尽江梅看腊梅。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 249480,
      "title": "观四种梅  其二",
      "content": [
        "斩新梅蕊破东风，一树鹅黄一树红。",
        "不着铅华元自好，未妨时世略相同。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 249481,
      "title": "舟中",
      "content": [
        "滩声送我入严州，过得州来水漫流。",
        "一夜好风潮信早，满船明月荻花秋。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 249482,
      "title": "江涨",
      "content": [
        "雾里江流欲到天，旅人合眼梦归船。",
        "雨声竹屋晓来急，误喜全家蓬底眠。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 249483,
      "title": "闻禽声有感",
      "content": [
        "寂寂禅房闭，阴阴夏木繁。",
        "坐闻幽鸟语，胜与俗人言。",
        "脱袴高低树，提壶远近村。",
        "汝曹知底事，独与子规论。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 249484,
      "title": "雪台",
      "content": [
        "白昼俯层台，千山万山月。",
        "若不犯高寒，安知此奇绝。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 249485,
      "title": "有山堂",
      "content": [
        "江南家家窗，何处无远岫。",
        "唯有谢玄晖，眼中揖其秀。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 249486,
      "title": "岁寒亭",
      "content": [
        "饱霜犹鬰葱，立雪故清润。",
        "下有老成人，持心以相印。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    }
  ],
