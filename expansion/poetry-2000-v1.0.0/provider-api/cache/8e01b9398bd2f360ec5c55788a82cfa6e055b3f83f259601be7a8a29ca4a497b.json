{
  "data": [
    {
      "id": 344526,
      "title": "送崔秀才赴上元兼省叔父",
      "content": [
        "寒塘敛暮雪，腊鼓迎春早。",
        "匹马五城人，重裘千里道。",
        "淮山轻露湿，江树狂风扫。",
        "楚县九酝醲，扬州百花好。",
        "练湖东望接云阳，女市西游入建康。",
        "行乐远夸红布旆，",
        "烟开日上板桥南，吴岫青青出林表。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 344529,
      "title": "赠张建",
      "content": [
        "结客平陵下，当年倚侠游。",
        "传看辘轳剑，醉脱骕骦裘。",
        "翠羽双鬟妾，珠帘百尺楼。",
        "春风坐相待，晚日莫淹留。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 344531,
      "title": "送客归广平",
      "content": [
        "家在赵邯郸，归心辄自欢。",
        "晚杯狐腋暖，春雪马毛寒。",
        "孟月途中破，轻冰水上残。",
        "到时杨柳色，奈向故园看。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 344537,
      "title": "题龙兴寺澹师房",
      "content": [
        "双林彼上人，诗兴转相亲。",
        "竹里经声晚，门前山色春。",
        "卷帘苔点净，下箸药苗新。",
        "记取无生理，归来问此身。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 344541,
      "title": "赠张道者",
      "content": [
        "采药三山罢，乘风五日归。",
        "翦荷成旧屋，剉蘖染新衣。",
        "玉粒指应久，丹砂验不微。",
        "坐看青节引，要与白云飞。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 344544,
      "title": "送客游江南",
      "content": [
        "桂水随去远，赏心知有余。",
        "衣香楚山橘，手鲙湘波鱼。",
        "芳芷不共把，浮云怅离居。",
        "遥想汨罗上，吊屈秋风初。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 344547,
      "title": "送赵评事赴洪州使幕",
      "content": [
        "孤舟行远近，一路过湘东。",
        "官属张廷尉，身随杜幼公。",
        "公河映湘竹，水驿带青枫。",
        "万里思君处，秋江夜雨中。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 344550,
      "title": "题僧房",
      "content": [
        "披衣闻客至，关锁此时开。",
        "鸣磬夕阳尽，卷帘秋色来。",
        "名香连竹径，清梵出花台。",
        "身在心无住，他方到几回。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 344554,
      "title": "题慈仁寺竹院",
      "content": [
        "千峰对古寺，何异到西林。",
        "幽磬蝉声下，闲窗竹翠阴。",
        "诗人谢客兴，法侣远公心。",
        "寂寂炉烟里，香花欲暮深。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 344555,
      "title": "赠郓州马使君",
      "content": [
        "东方千万骑，出望使君时。",
        "暮雪行看尽，春城到莫迟。",
        "路人趋墨帻，官柳度青丝。",
        "他日铃斋内，知君亦赋诗。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 344560,
      "title": "赠王逖",
      "content": [
        "端笏事龙楼，思闲辄告休。",
        "新调赭白马，暂试黑貂裘。",
        "珠履迎佳客，金钱与莫愁。",
        "座中豪贵满，谁道不风流。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 344561,
      "title": "送深州吴司马归使幕",
      "content": [
        "东门送远客，车马正纷纷。",
        "旧识张京兆，新随刘领军。",
        "行骢看暮雨，归雁踏青云。",
        "一去丛台北，佳声几日闻。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 344565,
      "title": "宴吴王宅",
      "content": [
        "玉管箫声合，金杯酒色殷。",
        "听歌吴季劄，纵饮汉中山。",
        "称寿争离席，留欢辄上关。",
        "莫言辞客醉，犹得曳裾还。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 344566,
      "title": "题荐福寺衡岳暕师房",
      "content": [
        "春城乞食还，高论此中闲。",
        "僧腊阶前树，禅心江上山。",
        "疏帘看雪卷，深户映花关。",
        "晚送门人出，钟声杳霭间。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 344567,
      "title": "送戴迪赴凤翔幕府",
      "content": [
        "青春带文绶，去事魏征西。",
        "上路金羁出，中人玉箸齐。",
        "当歌酒万斛，看猎马千蹄。",
        "自有从军乐，何须怨解携。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 344573,
      "title": "东城水亭宴李侍御副使",
      "content": [
        "东门留客处，沽酒用钱刀。",
        "秋水床下急，斜晖林外高。",
        "金羁络騕褭，玉匣闭豪曹。",
        "去日随戎幕，东风见伯劳。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 344574,
      "title": "送秘书谢监赴江西使幕",
      "content": [
        "谢监忆山程，辞家万里行。",
        "寒衣傍楚色，孤枕宿潮声。",
        "小寇不足问，新诗应渐清。",
        "府公相待日，引旆出江城。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 344579,
      "title": "送金华王明府",
      "content": [
        "县舍江云里，心闲境又偏。",
        "家贫陶令酒，月俸沈郎钱。",
        "黄蘖香山路，青枫暮雨天。",
        "时闻引车骑，竹外到铜泉。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 344583,
      "title": "送道士侄归池阳",
      "content": [
        "银角桃枝杖，东门赠别初。",
        "幽州寻马客，灞岸送驴车。",
        "野饭秋山静，行衣落照余。",
        "燕南群从少，此去意何如。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 344585,
      "title": "赠张五諲归濠州别业",
      "content": [
        "常知罢官意，果与世人疏。",
        "复此凉风起，仍闻濠上居。",
        "故山期采菊，秋水忆观鱼。",
        "一去蓬蒿径，羡君闲有余。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 344586,
      "title": "送营城李少府",
      "content": [
        "怀禄兼就养，更怀趋府心。",
        "晴山东里近，春水北门深。",
        "新绶映芳草，旧家依远林。",
        "还乘郑小驷，躞蹀县城阴。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 344590,
      "title": "送卢大理赵侍御祭东岳兼寄孟兖州",
      "content": [
        "东岳昔有事，两臣朝望归。",
        "驿亭开岁酒，斋舍著新衣。",
        "上客钟大理，主人陶武威。",
        "仍随御史马，山路满光辉。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 344591,
      "title": "送皇甫大夫赴浙东",
      "content": [
        "舟师分水国，汉将领秦官。",
        "麾下同心吏，军中□□端。",
        "吴门秋露湿，楚驿暮天寒。",
        "豪贵东山去，风流胜谢安。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 344592,
      "title": "送韦秀才",
      "content": [
        "东人相见罢，秋草独归时。",
        "几日孙弘阁，当年谢脁诗。",
        "寒山叶落早，多雨路行迟。",
        "好忆金门步，功名自有期。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 344593,
      "title": "送客一归襄阳二归浔阳",
      "content": [
        "南驱匹马会心期，东望扁舟惬梦思。",
        "熨斗山前春色早，",
        "两地由来堪取兴，三贤他日幸留诗。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 344594,
      "title": "送故人赴江陵寻庾牧",
      "content": [
        "主人持节拜荆州，走马应从一路游。",
        "斑竹冈连山雨暗，",
        "文体此时看又别，吾知小庾甚风流。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 344595,
      "title": "送客水路归陕",
      "content": [
        "相风竿影晓来斜，渭水东流去不赊。",
        "枕上未醒秦地酒，",
        "好是吾贤佳赏地，行逢三月会连沙。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 344596,
      "title": "送丹阳刘太真",
      "content": [
        "长干道上落花朝，羡尔当年赏事饶。",
        "下箸已怜鹅炙美，",
        "相访不辞千里远，西风好借木兰桡。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 344597,
      "title": "送客归江州",
      "content": [
        "东归复得采真游，江水迎君日夜流。",
        "客舍不离青雀舫，",
        "闻道泉明居止近，篮舆相访为淹留。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 344598,
      "title": "题张逸人园林",
      "content": [
        "花源一曲映茅堂，清论闲阶坐夕阳。",
        "麈尾手中毛已脱，",
        "更道小山宜助赏，呼儿舒簟醉岩芳。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 344599,
      "title": "又题张逸人园林",
      "content": [
        "藏头不复见时人，爱此云山奉养真。",
        "露色点衣孤屿晓，",
        "兴罢归来还对酌，茅簷挂著紫荷巾。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 344600,
      "title": "送刘将军",
      "content": [
        "明光细甲照铔鍜，昨日承恩拜虎牙。",
        "胆大欲期姜伯约，",
        "阙下来时亲伏奏，胡尘未尽不为家。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 344601,
      "title": "送郑员外",
      "content": [
        "风流不减杜陵时，五十为郎未是迟。",
        "孺子亦知名下士，",
        "要路眼青知己在，不应穷巷久低眉。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 344602,
      "title": "寄徐州郑使君",
      "content": [
        "江城五马楚云边，不羡雍容画省年。",
        "才子旧称何水部，",
        "虽卧郡斋千里隔，与君同见月初圆。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 344603,
      "title": "送襄垣王君归南阳别墅",
      "content": [
        "都门霁后不飞尘，草色萋萋满路春。",
        "双兔坡东千室吏，",
        "少妇比来多远望，应知蟢子上罗巾。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 344604,
      "title": "送王诞渤海使赴李太守行营",
      "content": [
        "少年结客散黄金，中岁连兵扫绿林。",
        "渤海名王曾折首，",
        "喜见明时钟太尉，功名一似旧淮阴。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 344605,
      "title": "送王少府归杭州",
      "content": [
        "归舟一路转青苹，更欲随潮向富春。",
        "吴郡陆机称地主，",
        "早晚重过鱼浦宿，遥怜佳句箧中新。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 344606,
      "title": "赠王随",
      "content": [
        "青云自致晚应遥，朱邸新婚乐事饶。",
        "饮罢更怜双袖舞，",
        "更说球场新雨歇，王孙今日定相邀。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 344607,
      "title": "同题仙游观",
      "content": [
        "仙台下见五城楼，风物凄凄宿雨收。",
        "山色遥连秦树晚，",
        "何用别寻方外去，人间亦自有丹丘。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 344608,
      "title": "访王起居不遇留赠",
      "content": [
        "双龙阙下拜恩初，天子令君注起居。",
        "载笔已齐周右史，",
        "贺客自知来独晚，青骊不见意何如。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 344609,
      "title": "送刘评事赴广州使幕",
      "content": [
        "征南官属似君稀，才子当今刘孝威。",
        "蛮府参军趋传舍，",
        "为报苍梧云影道，明年早送客帆归。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 344610,
      "title": "送冷朝阳还上元",
      "content": [
        "青丝dh引木兰船，名遂身归拜庆年。",
        "落日澄江乌榜外，",
        "别后依依寒食里，共君携手在东田。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 344611,
      "title": "送高别驾归汴州",
      "content": [
        "信陵门下识君偏，骏马轻裘正少年。",
        "寒雨送归千里外，",
        "久客未知何计是，参差去借汶阳田。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 344612,
      "title": "送康洗马归滑州",
      "content": [
        "腰佩雕弓汉射声，东归衔命见双旌。",
        "青丝玉勒康侯马，",
        "怀君又隔千山远，别后春风百草生。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 344613,
      "title": "寄上田仆射",
      "content": [
        "家封薛县异诸田，报主荣亲义两全。",
        "仆射临戎谢安石，",
        "应念一身留阙下，阖门遥寄鲁西偏。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 344614,
      "title": "送王光辅归青州兼寄储侍郎",
      "content": [
        "几回奏事建章宫，圣主偏知汉将功。",
        "身著紫衣趋阙下，",
        "远忆故人沧海别，当年好跃五花骢。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 344615,
      "title": "宴杨驸马山池",
      "content": [
        "垂杨拂岸草茸茸，绣户帘前花影重。",
        "鲙下玉盘红缕细，",
        "落日泛舟同醉处，回潭百丈映千峰。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 344616,
      "title": "送长史李少府入蜀",
      "content": [
        "行行独出故关迟，南望千山无尽期。",
        "见舞巴童应暂笑，",
        "别后此心君自见，山中何事不相思。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 344617,
      "title": "送客还江东",
      "content": [
        "不妨高卧顺流归，五两行看扫翠微。",
        "鼯鼠夜喧孤枕近，",
        "君到新林江口泊，吟诗应赏谢玄晖。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 344618,
      "title": "寄令狐尚书",
      "content": [
        "立身荣贵复何如，龙节红旗从板舆。",
        "妙略多推霍骠骑，",
        "他日感恩惭未报，举家犹似涸池鱼。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 344619,
      "title": "扈从郊庙因呈两省诸公",
      "content": [
        "丹墀列士主恩同，厩马翩翩出汉宫。",
        "奉引乘舆金仗里，",
        "明日驾回承雨露，齐将万岁及春风。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 344620,
      "title": "送端州冯使君",
      "content": [
        "白皙风流似有须，一门豪贵领苍梧。",
        "三峰亭暗橘边宿，",
        "怀君乐事不可见，鬃马翩翩新虎符。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 344621,
      "title": "送王府张参军附学及第东归",
      "content": [
        "邻家不识斗鸡翁，闭户能齐隐者风。",
        "顾步曾为小山客，",
        "寂寂故园行见在，暮天残雪洛城东。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 344622,
      "title": "送齐明府赴东阳",
      "content": [
        "绿丝帆𫄴桂为樯，过尽淮山楚水长。",
        "万里移家背春谷，",
        "别后心期如在眼，猿声烟色树苍苍。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 344623,
      "title": "鲁中送从事归荥阳",
      "content": [
        "故园衰草带荥波，岁晚知如君思何。",
        "轻橐归时鲁缟薄，",
        "累路尽逢知己在，曾无对酒不高歌。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 344624,
      "title": "兖州送李明府使苏州便赴告期",
      "content": [
        "莫言水国去迢迢，白马吴门见不遥。",
        "枫树林中经楚雨，"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 344625,
      "title": "送田明府归终南别业",
      "content": [
        "故园此日多心赏，窗下泉流竹外云。",
        "近馆应逢沈道士，",
        "相劝早移丹凤阙，不须常恋白鸥群。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 344626,
      "title": "家兄自山南罢归献诗叙事",
      "content": [
        "时辈已争先，吾兄未著鞭。",
        "空嗟镊须日，犹是屈腰年。",
        "不以殊方远，仍论水地偏。",
        "襄橙随客路，汉竹引归船。",
        "云木巴东峡，林泉岘北川。",
        "池余骑马处，宅似卧龙边。",
        "夜簟千峰月，朝窗万井烟。",
        "朱荷江女院，青稻楚人田。",
        "县舍多潇洒，城楼入醉眠。",
        "黄苞柑正熟，红缕鲙仍鲜。",
        "坐厌牵丝倦，因从解绶旋。",
        "初辞五斗米，唯奉一囊钱。",
        "室好生虚白，书耽守太玄。",
        "枥中嘶款段，阶下引潺湲。",
        "落照渊明柳，春风叔夜弦。",
        "绛纱儒客帐，丹诀羽人篇。",
        "雅论承安石，新诗与惠连。",
        "兴清湖见底，襟豁雾开天。",
        "魏阙心犹系，周才道岂捐。",
        "一丘无自逸，三府会招贤。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 344629,
      "title": "送李中丞赴商州",
      "content": [
        "五马渭桥东，连嘶逐晓风。",
        "当年紫髯将，他日黑头公。",
        "不异金吾宠，兼齐玉帐雄。",
        "闭营春雪下，吹角暮山空。",
        "香麝松阴里，寒猿黛色中。",
        "郡斋多赏事，好与故人同。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 344630,
      "title": "汉宫曲二首",
      "content": [
        "骏马绣障泥，红尘扑四蹄。",
        "归时何太晚，日照杏花西。",
        "绣幕珊瑚钩，春开翡翠楼。",
        "深情不肯道，娇倚钿箜篌。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 344634,
      "title": "送陈明府赴淮南",
      "content": [
        "年华近逼清明，落日微风送行。",
        "黄鸟绵蛮芳树，",
        "应渡淮南信宿，诸侯拥旆相迎。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 344643,
      "title": "汉宫曲二首",
      "content": [
        "五柞宫中过腊看，万年枝上雪花残。",
        "绮窗夜闭玉堂静，素绠朝穿金井寒。",
        "家在长陵小市中，珠帘绣户对春风。",
        "君王昨日移仙仗，玉辇迎将入汉宫。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 344645,
      "title": "少年行",
      "content": [
        "千点斓斒玉勒骢，青丝结尾绣缠鬃。",
        "鸣鞭晓出章台路，叶叶春衣杨柳风。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 344646,
      "title": "题玉真观李秘书院",
      "content": [
        "白云斜日影深松，玉宇瑶坛知几重。",
        "把酒题诗人散后，华阳洞里有疏钟。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 344647,
      "title": "送客之潞府",
      "content": [
        "官柳青青匹马嘶，回风暮雨入铜鞮。",
        "佳期别在春山里，应是人参五叶齐。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 344648,
      "title": "送客贬五溪",
      "content": [
        "南过猿声一逐臣，回看秋草泪沾巾。",
        "寒天暮雪空山里，几处蛮家是主人。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 344651,
      "title": "梁城赠一二同幕",
      "content": [
        "五营河畔列旌旗，吹角鸣鼙日暮时。",
        "曾是信陵门下客，雨回相吊不胜悲。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 344652,
      "title": "河上寄故人",
      "content": [
        "河流晓天，濮水清烟。",
        "日暖昆吾台上，春深颛顼城边。",
        "莺声乱啁鹄□，花片细点龙泉。",
        "西望情人早至，"
