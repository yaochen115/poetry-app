{
  "data": [
    {
      "id": 28118,
      "title": "仙坛院",
      "content": [
        "蕉闻王子晋，云卧夜吹笙。",
        "控鹤冲天去，松风千古声。"
      ],
      "author": {
        "id": 8385,
        "name": "洪适"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 136244,
      "title": "送丁炼师归福堂",
      "content": [
        "易东流派远，千载见斯人。",
        "金鼎烹龙虎，丹书役鬼神。",
        "形臞心更古，食淡语尤真。",
        "野鹤冲天去，空余华表身。"
      ],
      "author": {
        "id": 12428,
        "name": "胡仲弓"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 187627,
      "title": "题双流保国观古柏",
      "content": [
        "孔明庙前古柏奇，此木气象犹过之。",
        "干东彷佛烟焰起，铁龙空驾焚一枝。",
        "真人丹诚何所适，世传乘鹤冲天飞。",
        "求诗道士心弥坚，试听一诵工曹诗。"
      ],
      "author": {
        "id": 11786,
        "name": "胡宗师"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 198989,
      "title": "宫词  其七八",
      "content": [
        "陇山鹦鹉羽毛鲜，养在金笼已数年。",
        "应为能言人爱惜，教成御制鹤冲天。"
      ],
      "author": {
        "id": 8495,
        "name": "王仲修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 221241,
      "title": "送僧归护国寺",
      "content": [
        "南宗开士共推贤，语默忘机合自然。",
        "上国经游云出岫，故山归去鹤冲天。",
        "舣舟却指灵溪岸，烹茗还资瀑布泉。",
        "宴坐草堂诸念息，只应余习在诗篇。"
      ],
      "author": {
        "id": 1089,
        "name": "冯元"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 247033,
      "title": "李丞相挽诗三首  其一",
      "content": [
        "旧学邈难继，相期从少年。",
        "初看骥伏枥，遽作鹤冲天。",
        "烈所平生志，高名万代传。",
        "如何事未济，此老下黄泉。"
      ],
      "author": {
        "id": 12151,
        "name": "吕本中"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 287535,
      "title": "癸丑年下第献新先辈",
      "content": [
        "五更残月省墙边，绛斾蜺旌卓晓烟。",
        "千炬火中莺出谷，一声钟后鹤冲天。",
        "皆乘骏马先归去，独被羸童笑晚眠。",
        "对酒暂时情豁尔，见花依旧涕潸然。",
        "未酬阚泽佣书债，犹欠君平卖卜钱。",
        "何事欲休休不得，来年公道似今年。"
      ],
      "author": {
        "id": 6755,
        "name": "韦庄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 296656,
      "title": "题赤松宫",
      "content": [
        "松老赤松原，松间庙宛然。",
        "人皆有兄弟，谁得共神仙。",
        "双鹤冲天去，群羊化石眠。",
        "至今丹井水，香满北山边。"
      ],
      "author": {
        "id": 4314,
        "name": "舒道纪"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 296764,
      "title": "七言 五十二",
      "content": [
        "箕星昴宿下长天，凡景宁教不愕然。",
        "龙出水来鳞甲就，鹤冲天气羽毛全。",
        "尘中教化千人眼，世上人知尔雅篇。",
        "自是凡流福命薄，忍教微妙略轻传。"
      ],
      "author": {
        "id": 4292,
        "name": "吕岩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 298546,
      "title": "喜迁莺 二",
      "content": [
        "街鼓动，禁城开，天上探人回。",
        "凤衔金牓出云来，平地一声雷。",
        "莺已迁，龙已化，一夜满城车马。",
        "家家楼上簇神仙，争看鹤冲天。"
      ],
      "author": {
        "id": 6755,
        "name": "韦庄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 307051,
      "title": "青童君别赵旭诗",
      "content": [
        "与君宿世有仙缘，衾枕交欢岂偶然。",
        "十载为期君记取，洞明山上鹤冲天。"
      ],
      "author": {
        "id": 7199,
        "name": "不详"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 307786,
      "title": "西方歌",
      "content": [
        "西方白虎本属阴，为男为女亦为金。",
        "长立子宫胎产午，成形兑体坎同心。",
        "娇姿玉貌欺冰雪，素质含光洒轻血。",
        "则知唤作白琅玕，怎识我身是明月。",
        "无媒自嫁得黄芽，生死在归戊己家。",
        "炎烈下时寒国上，阴阳催强緫成砂。",
        "若人会得吾此语，目前便是三清路。",
        "驾鹤冲天日有菁定知永劫抛尘土。"
      ],
      "author": {
        "id": 5773,
        "name": "无名氏"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 309707,
      "title": "岘山送萧员外之荆州",
      "content": [
        "岘山江岸曲，郢水郭门前。",
        "自古登临处，非今独黯然。",
        "亭楼明落照，井邑秀通川。",
        "涧竹生幽兴，林风入管弦。",
        "再飞鹏激水，一举鹤冲天。",
        "伫立三荆使，看君驷马旋。"
      ],
      "author": {
        "id": 10243,
        "name": "孟浩然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 312269,
      "title": "鹤冲天",
      "content": [
        "闲窗漏永，月冷霜华堕。",
        "悄悄下帘幕，残灯火。",
        "再三追往事，离魂乱、愁肠锁。",
        "无语沉吟坐。",
        "好天好景，未省展眉则个。",
        "从前早是多成破。",
        "何况经岁月，相抛亸。",
        "假使重相见，还得似、旧时么。",
        "悔恨无计那。",
        "迢迢良夜，自家只恁摧挫。"
      ],
      "author": {
        "id": 3061,
        "name": "柳永"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312438,
      "title": "鹤冲天",
      "content": [
        "黄金榜上。",
        "偶失龙头望。",
        "明代暂遗贤，如何向。",
        "未遂风云便，争不恣狂荡。",
        "何须论得丧。",
        "才子词人，自是白衣卿相。",
        "烟花巷陌，依约丹青屏障。",
        "幸有意中人，堪寻访。",
        "且恁偎红翠，风流事、平生畅。",
        "青春都一饷。",
        "忍把浮名，换了浅斟低唱。"
      ],
      "author": {
        "id": 3061,
        "name": "柳永"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312945,
      "title": "鹤冲天",
      "content": [
        "梅谢粉，柳拖金。",
        "香满旧园林。",
        "养花天气半晴阴。",
        "花好却愁深。",
        "花无数。",
        "愁无数。",
        "花好却愁春去。",
        "戴花持酒祝东风。",
        "千万莫匆匆。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313064,
      "title": "鹤冲天",
      "content": [
        "清明天气。",
        "永日愁如醉。",
        "台榭绿阴浓，薰风细。",
        "燕子巢方就，盆池小，新荷蔽。",
        "恰是逍遥际。",
        "单夹衣裳，半栊软玉肌体。",
        "石榴美艳，一撮红绡比。",
        "窗外数修篁，寒相倚。",
        "有个关心处，难相见、空凝睇。",
        "行坐深闺里。",
        "懒更妆梳，自知新来憔悴。"
      ],
      "author": {
        "id": 11741,
        "name": "杜安世"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 325044,
      "title": "鹤冲天",
      "content": [
        "冬冬鼓动，花外沈残漏。",
        "华月万枝灯，还清昼。",
        "广陌衣香度，飞盖影、相先后。",
        "个处频回首。",
        "锦房西去，期约武陵西口。",
        "当时早恨欢难偶。",
        "可堪流浪远，分携久。",
        "小畹兰英在，轻付与、何人手。",
        "不似长亭柳。",
        "舞枫眠雨，伴我一春销瘦。"
      ],
      "author": {
        "id": 2900,
        "name": "贺铸"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 327776,
      "title": "鹤冲天",
      "content": [
        "梅雨霁，暑风和。",
        "高柳乱蝉多。",
        "小园台榭远池波。",
        "鱼戏动新荷。",
        "薄纱厨，轻羽扇。",
        "枕冷簟凉深院。",
        "此时情绪此时天。",
        "无事小神仙。"
      ],
      "author": {
        "id": 3026,
        "name": "周邦彦"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 327777,
      "title": "鹤冲天",
      "content": [
        "白角簟，碧纱厨。",
        "梅雨乍晴初。",
        "谢家池畔正清虚。",
        "香散嫩芙蕖。",
        "日流金，风解愠。",
        "一弄素琴歌舞。",
        "慢摇纨扇诉花笺。",
        "吟待晚凉天。"
      ],
      "author": {
        "id": 3026,
        "name": "周邦彦"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 329285,
      "title": "鹤冲天",
      "content": [
        "𥬠玉液，酿花光。",
        "来趁北窗凉。",
        "为君小摘蜀葵黄。",
        "一似嗅枝香。",
        "饮中仙，山中相。",
        "也道十分宫样。",
        "一般时候最宜尝。",
        "竹院月侵床。"
      ],
      "author": {
        "id": 5827,
        "name": "李弥逊"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 377874,
      "title": "喜迁莺·喜迁莺·街鼓动",
      "content": [
        "街鼓动，禁城开，天上探人回，凤衔金榜出云来，平地一声雷。",
        "莺已迁，龙已化，一夜满城车马。",
        "家家楼上簇神仙，争看鹤冲天。"
      ],
      "author": {
        "id": 6755,
        "name": "韦庄"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 380770,
      "title": "鹤冲天",
      "content": [
        "沉吟一和，猛省孩儿事未员。",
        "袅娜巧身材，桃腮和杏脸。",
        "每日把珠翠若神女貌，玉女面。",
        "百事尽皆能，试看它能写染，强一京好宅眷。"
      ],
      "author": {
        "id": 6562,
        "name": "无名氏《张协状元》"
      },
      "dynasty": {
        "id": 9,
        "name": "元"
      },
      "type": {
        "id": 30,
        "name": "元曲"
      }
    }
