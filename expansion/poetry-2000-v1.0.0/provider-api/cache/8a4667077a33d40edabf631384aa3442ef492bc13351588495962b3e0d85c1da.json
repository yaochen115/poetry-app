{
  "data": [
    {
      "id": 377815,
      "title": "诉衷情·诉衷情·莺语花舞春昼午",
      "content": [
        "莺语花舞春昼午，雨霏微。",
        "金带枕，宫锦，凤凰帷。",
        "柳弱蝶交飞，依依。",
        "辽阳音信稀，梦中归。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377816,
      "title": "思帝乡·思帝乡·花花",
      "content": [
        "花花，满枝红似霞。",
        "罗袖画帘肠断，卓香车。",
        "回面共人闲语，战篦金凤斜。",
        "惟有阮郎春尽，不归家。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377817,
      "title": "梦江南·梦江南·千万恨",
      "content": [
        "千万恨，恨极在天涯。",
        "山月不知心里事，水风空落眼前花，摇曳碧云斜。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377818,
      "title": "梦江南·梦江南·梳洗罢",
      "content": [
        "梳洗罢，独倚望江楼。",
        "过尽千帆皆不是，斜晖脉脉水悠悠，肠断白苹洲。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377819,
      "title": "河传·河传·江畔",
      "content": [
        "江畔，相唤。",
        "晓妆鲜，仙景个女采莲。",
        "请君莫向那岸边，少年，好花新满船。",
        "红袖摇曳逐风暖，垂玉腕，肠向柳丝断。",
        "浦南归，浦北归，莫知，晚来人已稀。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377820,
      "title": "河传·河传·湖上",
      "content": [
        "湖上，闲望。",
        "雨萧萧，烟浦花桥路遥。",
        "谢娘翠蛾愁不消，终朝，梦魂迷晚潮。",
        "荡子天涯归棹远，春已晚，莺语空肠断。",
        "若耶溪，溪水西，柳堤，不闻郎马嘶。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377821,
      "title": "河传·河传·同伴",
      "content": [
        "同伴，相唤。",
        "杏花稀，梦里每愁依违。",
        "仙客一去燕已飞，不归，泪痕空满衣。",
        "天际云鸟引晴远，春已晚，烟霭渡南苑。",
        "雪梅香，柳带长，小娘，转令人意伤。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377822,
      "title": "番女怨·番女怨·万枝香雪开已遍",
      "content": [
        "万枝香雪开已遍，细雨双燕。",
        "钿蝉筝，金雀扇，画梁相见。",
        "雁门消息不归来，又飞回。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377823,
      "title": "番女怨·番女怨·碛南沙上惊雁起",
      "content": [
        "碛南沙上惊雁起，飞雪千里。",
        "玉连环，金镞箭，年年征战。",
        "画楼离恨锦屏空，杏花红。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377824,
      "title": "荷叶杯·荷叶杯·一点露珠凝冷",
      "content": [
        "一点露珠凝冷，波影。",
        "满池塘。",
        "绿茎红艳两相乱，肠断。",
        "水风凉。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377825,
      "title": "荷叶杯·荷叶杯·镜水夜来秋月",
      "content": [
        "镜水夜来秋月，如雪。",
        "采莲时。",
        "小娘红粉对寒浪，惆怅。",
        "正思惟。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377826,
      "title": "荷叶杯·荷叶杯·楚女欲归南浦",
      "content": [
        "楚女欲归南浦，朝雨。",
        "湿愁红。",
        "小船摇漾入花里，波起。",
        "隔西风。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377827,
      "title": "天仙子·天仙子·晴野鹭鸶飞一只",
      "content": [
        "晴野鹭鸶飞一只，水荭花发秋江碧。",
        "刘郎此日别天仙，登绮席，泪珠滴，十二晚峰高历历。"
      ],
      "author": {
        "id": 11403,
        "name": "皇甫松"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377828,
      "title": "天仙子·天仙子·踯躅花开红照水",
      "content": [
        "踯躅花开红照水，鹧鸪飞绕青山觜。",
        "行人经岁始归来，千万里，错相倚，懊恼天仙应有以。"
      ],
      "author": {
        "id": 11403,
        "name": "皇甫松"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377829,
      "title": "浪淘沙·浪淘沙·滩头细草接疏林",
      "content": [
        "滩头细草接疏林，浪恶罾船半欲沉。",
        "宿鹭眠鸥飞旧浦，去年沙嘴是江心。"
      ],
      "author": {
        "id": 11403,
        "name": "皇甫松"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377830,
      "title": "浪淘沙·浪淘沙·蛮歌豆蔻北人愁",
      "content": [
        "蛮歌豆蔻北人愁，蒲雨杉风野艇秋。",
        "浪起䴔䴖眠不得，寒沙细细入江流。"
      ],
      "author": {
        "id": 11403,
        "name": "皇甫松"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377831,
      "title": "杨柳枝·杨柳枝·春入行宫映翠微",
      "content": [
        "春入行宫映翠微，玄宗侍女舞烟丝。",
        "如今柳向空城绿，玉笛何人更把吹。"
      ],
      "author": {
        "id": 11403,
        "name": "皇甫松"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377832,
      "title": "杨柳枝·杨柳枝·烂漫春归水国时",
      "content": [
        "烂漫春归水国时，吴王宫殿柳丝垂。",
        "黄莺长叫空闺畔，西子无因更得知。"
      ],
      "author": {
        "id": 11403,
        "name": "皇甫松"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377833,
      "title": "摘得新·摘得新·酌一卮",
      "content": [
        "酌一卮，须教玉笛吹。",
        "锦筵红蜡烛，莫来迟。",
        "繁红一夜经风雨，是空枝。"
      ],
      "author": {
        "id": 11403,
        "name": "皇甫松"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377834,
      "title": "摘得新·摘得新·摘得新",
      "content": [
        "摘得新，枝枝叶叶春。",
        "管弦兼美酒，最关人。",
        "平生都得几十度，展香茵。"
      ],
      "author": {
        "id": 11403,
        "name": "皇甫松"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377835,
      "title": "梦江南·梦江南·兰烬落",
      "content": [
        "兰烬落，屏上暗红蕉。",
        "闲梦江南梅熟日，夜船吹笛雨萧萧，人语驿边桥。"
      ],
      "author": {
        "id": 11403,
        "name": "皇甫松"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377836,
      "title": "梦江南·梦江南·楼上寝",
      "content": [
        "楼上寝，残月下帘旌。",
        "梦见秣陵惆怅事，桃花柳絮满江城，双髻坐吹笙。"
      ],
      "author": {
        "id": 11403,
        "name": "皇甫松"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377837,
      "title": "采莲子·采莲子·菡萏香莲十顷陂",
      "content": [
        "菡萏香莲十顷陂（举棹），小姑贪戏采莲迟（年少）。",
        "晚来弄水船头湿（举棹），更脱红裙裹鸭儿（年少）。"
      ],
      "author": {
        "id": 11403,
        "name": "皇甫松"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377838,
      "title": "采莲子·采莲子·船动湖光滟滟秋",
      "content": [
        "船动湖光滟滟秋（举棹），贪看年少信船流（年少）。",
        "无端隔水抛莲子（举棹），遥被人知半日羞（年少）。"
      ],
      "author": {
        "id": 11403,
        "name": "皇甫松"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377839,
      "title": "浣溪沙·浣溪沙·清晓妆成寒食天",
      "content": [
        "清晓妆成寒食天，柳球斜袅间花钿，卷帘直出画堂前。",
        "指点牡丹初绽朵，日高犹自凭朱栏，含颦不语恨春残。"
      ],
      "author": {
        "id": 6755,
        "name": "韦庄"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377840,
      "title": "浣溪沙·浣溪沙·欲上秋千四体慵",
      "content": [
        "欲上秋千四体慵，拟教人送又心忪。",
        "画堂帘幕月明风。",
        "此夜有情谁不极，隔墙梨雪又玲珑，玉容憔悴惹微红。"
      ],
      "author": {
        "id": 6755,
        "name": "韦庄"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377841,
      "title": "浣溪沙·浣溪沙·惆怅梦余山月斜",
      "content": [
        "惆怅梦余山月斜，孤灯照壁背窗纱，小楼高阁谢娘家。",
        "暗想玉容何所似，一枝春雪冻梅花，满身香雾簇朝霞。"
      ],
      "author": {
        "id": 6755,
        "name": "韦庄"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377842,
      "title": "浣溪沙·浣溪沙·绿树藏莺莺玉啼",
      "content": [
        "绿树藏莺莺玉啼，柳丝斜拂白铜堤，弄珠江上草萋萋。",
        "日暮饮归何处客，绣鞍骢马一声嘶，满身兰麝醉如泥。"
      ],
      "author": {
        "id": 6755,
        "name": "韦庄"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377843,
      "title": "浣溪沙·浣溪沙·夜夜相思更漏残",
      "content": [
        "夜夜相思更漏残，伤心明月凭栏干，想君思我锦衾寒。",
        "咫尺画堂深似海，忆来唯把旧书看，几时携手入长安。"
      ],
      "author": {
        "id": 6755,
        "name": "韦庄"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377844,
      "title": "菩萨蛮·菩萨蛮·红楼别夜堪惆怅",
      "content": [
        "红楼别夜堪惆怅，香灯半卷流苏帐。",
        "残月出门时，美人和泪辞。",
        "琵琶金翠羽，弦上黄莺语。",
        "劝我早归家，绿窗人似花。"
      ],
      "author": {
        "id": 6755,
        "name": "韦庄"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377845,
      "title": "菩萨蛮·菩萨蛮·人人尽说江南好",
      "content": [
        "人人尽说江南好，游人只合江南老。",
        "春水碧于天，画船听雨眠。",
        "垆边人似月，皓腕凝双雪。",
        "未老莫还乡，还乡须断肠。"
      ],
      "author": {
        "id": 6755,
        "name": "韦庄"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377846,
      "title": "菩萨蛮·菩萨蛮·如今却忆江南乐",
      "content": [
        "如今却忆江南乐，当时年少春衫薄。",
        "骑马倚斜桥，满楼红袖招。",
        "翠屏金屈曲，醉入花丛宿。",
        "此度见花枝，白头誓不归。"
      ],
      "author": {
        "id": 6755,
        "name": "韦庄"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377847,
      "title": "菩萨蛮·菩萨蛮·劝君今夜须沉醉",
      "content": [
        "劝君今夜须沉醉，樽前莫话明朝事。",
        "珍重主人心，酒深情亦深。",
        "须愁春漏短，莫诉金杯满。",
        "遇酒且呵呵，人生能几何。"
      ],
      "author": {
        "id": 6755,
        "name": "韦庄"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377848,
      "title": "菩萨蛮·菩萨蛮·洛阳城里春光好",
      "content": [
        "洛阳城里春光好，洛阳才子他乡老。",
        "柳暗魏王堤，此时心转迷。",
        "桃花春水绿，水上鸳鸯浴。",
        "凝恨对残晖，忆君君不知。"
      ],
      "author": {
        "id": 6755,
        "name": "韦庄"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377849,
      "title": "归国遥·归国遥·春欲暮",
      "content": [
        "春欲暮，满地落花红带雨。",
        "惆怅玉笼鹦鹉，单栖无伴侣。",
        "南望去程何许，问花花不语。",
        "早晚得同归去，恨无双翠羽。"
      ],
      "author": {
        "id": 6755,
        "name": "韦庄"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377850,
      "title": "归国遥·归国遥·金翡翠",
      "content": [
        "金翡翠，为我南飞传我意。",
        "罨画桥边春水，几年花下醉。",
        "别后只知相愧，泪珠难远寄。",
        "罗幕绣帷鸳被，旧欢如梦里。"
      ],
      "author": {
        "id": 6755,
        "name": "韦庄"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377851,
      "title": "归国遥·归国遥·春欲晚",
      "content": [
        "春欲晚，戏蝶游蜂花烂漫。",
        "日落谢家池馆，柳丝金缕断。",
        "睡觉绿鬟风乱，画屏云雨散。",
        "闲倚博山长叹，泪流沾皓腕。"
      ],
      "author": {
        "id": 6755,
        "name": "韦庄"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377852,
      "title": "应天长·应天长·绿槐阴里黄莺语",
      "content": [
        "绿槐阴里黄莺语，深院无人春昼午。",
        "画帘垂，金凤舞，寂寞绣屏香一炷。",
        "碧天云，无定处，空有梦魂来去。",
        "夜夜绿窗风雨，断肠君信否。"
      ],
      "author": {
        "id": 6755,
        "name": "韦庄"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377853,
      "title": "应天长·应天长·别来半岁音书绝",
      "content": [
        "别来半岁音书绝，一寸离肠千万结。",
        "难相见，易相别，又是玉楼花似雪。",
        "暗相思，无处说，惆怅夜来烟月。",
        "想得此时情切，泪沾红袖黦。"
      ],
      "author": {
        "id": 6755,
        "name": "韦庄"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377854,
      "title": "荷叶杯·荷叶杯·绝代佳人难得",
      "content": [
        "绝代佳人难得，倾国，花下见无期。",
        "一双愁黛远山眉，不忍更思惟。",
        "闲掩翠屏金凤，残梦，罗幕画堂空。",
        "碧天无路信难通，惆怅旧房栊。"
      ],
      "author": {
        "id": 6755,
        "name": "韦庄"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377855,
      "title": "荷叶杯·荷叶杯·记得那年花下",
      "content": [
        "记得那年花下，深夜，初识谢娘时。",
        "水堂西面画帘垂，携手暗相期。",
        "惆怅晓莺残月，相别，从此隔音尘。",
        "如今俱是异乡人，相见更无因。"
      ],
      "author": {
        "id": 6755,
        "name": "韦庄"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377856,
      "title": "清平乐·清平乐·春愁南陌",
      "content": [
        "春愁南陌，故国音书隔。",
        "细雨霏霏梨花白，燕拂画帘金额。",
        "尽日相望王孙，尘满衣上泪痕。",
        "谁向桥边吹笛，驻马西望销魂。"
      ],
      "author": {
        "id": 6755,
        "name": "韦庄"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377857,
      "title": "清平乐·清平乐·野花芳草",
      "content": [
        "野花芳草，寂寞关山道。",
        "柳吐金丝莺语早，惆怅香闺暗老。",
        "罗带悔结同心，独凭朱栏思深。",
        "梦觉半床斜月，小窗风触鸣琴。"
      ],
      "author": {
        "id": 6755,
        "name": "韦庄"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377858,
      "title": "清平乐·清平乐·何处游女",
      "content": [
        "何处游女，蜀国多云雨。",
        "云解有情花解语，窣地绣罗金缕。",
        "妆成不整金钿，含羞待月秋千。",
        "住在绿槐阴里，门临春水桥边。"
      ],
      "author": {
        "id": 6755,
        "name": "韦庄"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377859,
      "title": "清平乐·清平乐·莺啼残月",
      "content": [
        "莺啼残月，绣阁香灯灭。",
        "门外马嘶郎欲别，正是落花时节。",
        "妆成不画蛾眉，含愁独倚金扉。",
        "云路香尘莫扫，扫即郎去归迟。"
      ],
      "author": {
        "id": 6755,
        "name": "韦庄"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377860,
      "title": "望远行·望远行·欲别无言倚画屏",
      "content": [
        "欲别无言倚画屏，含恨暗伤情。",
        "谢家庭树锦鸡鸣，残月落边城。",
        "人欲别，马频嘶，绿槐千里长堤。",
        "出门芳草路萋萋，云雨别来易东西。",
        "不忍别君后，却入旧香闺。"
      ],
      "author": {
        "id": 6755,
        "name": "韦庄"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377861,
      "title": "谒金门·谒金门·春漏促",
      "content": [
        "春漏促，金烬暗挑残烛。",
        "一夜帘前风撼竹，梦魂相断续。",
        "有个娇娆如玉，夜夜绣屏孤宿。",
        "宋袍琵琶寻旧曲，远山眉黛绿。"
      ],
      "author": {
        "id": 6755,
        "name": "韦庄"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377862,
      "title": "谒金门·谒金门·空相忆",
      "content": [
        "空相忆，无计得传消息。",
        "天上嫦娥人不识，寄书何处觅。",
        "新睡觉来无力，不忍把伊书迹。",
        "满院落花春寂寂，断肠芳草碧。"
      ],
      "author": {
        "id": 6755,
        "name": "韦庄"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377863,
      "title": "江城子·江城子·恩重娇多情易伤",
      "content": [
        "恩重娇多情易伤，漏更长，解鸳鸯。",
        "朱唇未动，先觉口脂香。",
        "缓揭绣衾抽皓腕，移凤枕，枕潘郎。"
      ],
      "author": {
        "id": 6755,
        "name": "韦庄"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377864,
      "title": "江城子·江城子·髻鬟狼藉黛眉长",
      "content": [
        "髻鬟狼藉黛眉长，出兰房，别檀郎。",
        "角声呜咽，星斗渐微茫。",
        "露冷月残人未起，留不住，泪千行。"
      ],
      "author": {
        "id": 6755,
        "name": "韦庄"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377865,
      "title": "河传·河传·何处",
      "content": [
        "何处，烟雨，隋堤春暮。",
        "柳色葱笼，画桡金缕，翠旗高飐香风，水光融。",
        "青娥殿脚春妆媚，轻云里，绰约司花妓。",
        "江都宫阙，清淮月映迷楼，古今愁。"
      ],
      "author": {
        "id": 6755,
        "name": "韦庄"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377866,
      "title": "河传·河传·春晚",
      "content": [
        "春晚，风暖，锦城花满。",
        "狂杀游人，玉鞭金勒，寻胜驰骤轻尘，惜良晨。",
        "翠娥争劝临邛酒，纤纤手，拂面垂丝柳。",
        "归时烟里，钟鼓正是黄昏，暗销魂。"
      ],
      "author": {
        "id": 6755,
        "name": "韦庄"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377867,
      "title": "河传·河传·锦浦",
      "content": [
        "锦浦，春女，绣衣金缕。",
        "雾薄云轻，花深柳暗，时节正是清明，雨初晴。",
        "玉鞭魂断烟霞路，莺莺语，一望巫山雨。",
        "香尘隐映，遥见翠槛红楼，黛眉愁。"
      ],
      "author": {
        "id": 6755,
        "name": "韦庄"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377868,
      "title": "天仙子·天仙子·怅望前回梦里期",
      "content": [
        "怅望前回梦里期，看花不语苦寻思。",
        "露桃花里小腰肢，眉眼细，鬓云垂，唯有多情宋玉知。"
      ],
      "author": {
        "id": 6755,
        "name": "韦庄"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377869,
      "title": "天仙子·天仙子·深夜归来长酩酊",
      "content": [
        "深夜归来长酩酊，扶入流苏犹未醒。",
        "醺醺酒气麝兰和，惊睡觉，笑呵呵，长道人生能几何。"
      ],
      "author": {
        "id": 6755,
        "name": "韦庄"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377870,
      "title": "天仙子·天仙子·蟾彩霜华夜不分",
      "content": [
        "蟾彩霜华夜不分，天外鸿声枕上闻，绣衾香冷懒重熏。",
        "人寂寂，叶纷纷，才睡依前梦见君。"
      ],
      "author": {
        "id": 6755,
        "name": "韦庄"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377871,
      "title": "天仙子·天仙子·梦觉云屏依旧空",
      "content": [
        "梦觉云屏依旧空，杜鹃声咽隔帘栊，玉郎薄幸去无踪。",
        "一日日，恨重重，泪界莲腮两线红。"
      ],
      "author": {
        "id": 6755,
        "name": "韦庄"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377872,
      "title": "天仙子·天仙子·金似衣裳玉似身",
      "content": [
        "金似衣裳玉似身，眼如秋水鬓如云，霞裙月帔一群群。",
        "来洞口，望烟分，刘阮不归春日曛。"
      ],
      "author": {
        "id": 6755,
        "name": "韦庄"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377873,
      "title": "喜迁莺·喜迁莺·人汹汹",
      "content": [
        "人汹汹，鼓冬冬，襟袖五更风。",
        "大罗天上月朦胧，骑马上虚空。",
        "香满衣，云满路，鸾凤绕身飞舞。",
        "霓旌绛节一群群，引见玉华君。"
      ],
      "author": {
        "id": 6755,
        "name": "韦庄"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377874,
      "title": "喜迁莺·喜迁莺·街鼓动",
      "content": [
        "街鼓动，禁城开，天上探人回，凤衔金榜出云来，平地一声雷。",
        "莺已迁，龙已化，一夜满城车马。",
        "家家楼上簇神仙，争看鹤冲天。"
      ],
      "author": {
        "id": 6755,
        "name": "韦庄"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377875,
      "title": "思帝乡·思帝乡·云髻坠",
      "content": [
        "云髻坠，凤钗垂。",
        "髻坠钗垂无力，枕函欹。",
        "翡翠屏深月落，漏依依。",
        "说尽人间天上，两心知。"
      ],
      "author": {
        "id": 6755,
        "name": "韦庄"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377876,
      "title": "思帝乡·思帝乡·春日游",
      "content": [
        "春日游，杏花吹满头。",
        "陌上谁家年少，足风流。",
        "妾拟将身嫁与，一生休。",
        "纵被无情弃，不能羞！"
      ],
      "author": {
        "id": 6755,
        "name": "韦庄"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377877,
      "title": "诉衷情·诉衷情·烛尽香残帘半卷",
      "content": [
        "烛尽香残帘半卷，梦初惊。",
        "花欲谢，深夜，月胧明。",
        "何处按歌声，轻轻。",
        "舞衣尘暗生，负春情。"
      ],
      "author": {
        "id": 6755,
        "name": "韦庄"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377878,
      "title": "诉衷情·诉衷情·碧沼红芳烟雨静",
      "content": [
        "碧沼红芳烟雨静，倚兰桡。",
        "垂玉珮，交带，袅纤腰。",
        "鸳梦隔星桥，迢迢。",
        "越罗香暗销，坠花翘。"
      ],
      "author": {
        "id": 6755,
        "name": "韦庄"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377879,
      "title": "上行杯·上行杯·芳草灞陵春岸",
      "content": [
        "芳草灞陵春岸，柳烟深，满楼弦管，一曲离声肠寸断。",
        "今日送君千万，红楼玉盘金镂盏，须劝珍重意，莫辞满。"
      ],
      "author": {
        "id": 6755,
        "name": "韦庄"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377880,
      "title": "上行杯·上行杯·白马玉鞭金辔",
      "content": [
        "白马玉鞭金辔，少年郎，离别容易，迢递去程千万里。",
        "惆怅异乡云水，满酌一杯劝和泪，须愧珍重意，莫辞醉。"
      ],
      "author": {
        "id": 6755,
        "name": "韦庄"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377881,
      "title": "女冠子·女冠子·四月十七",
      "content": [
        "四月十七，正是去年今日。",
        "别君时，忍泪佯低面，含羞半敛眉。",
        "不知魂已断，空有梦相随。",
        "除却天边月，没人知。"
      ],
      "author": {
        "id": 6755,
        "name": "韦庄"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377882,
      "title": "女冠子·女冠子·昨夜夜半",
      "content": [
        "昨夜夜半，枕上分明梦见：语多时，依旧桃花面，频低柳叶眉。",
        "半羞还半喜，欲去又依依。",
        "觉来知是梦，不胜悲。"
      ],
      "author": {
        "id": 6755,
        "name": "韦庄"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377883,
      "title": "更漏子·更漏子·钟鼓寒",
      "content": [
        "钟鼓寒，楼阁暝，月照古桐金井。",
        "深院闭，小庭空，落花香露红。",
        "烟柳重，春雾薄，灯背水窗高阁。",
        "闲倚户，暗沾衣，待郎郎不归。"
      ],
      "author": {
        "id": 6755,
        "name": "韦庄"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377884,
      "title": "酒泉子·酒泉子·月落星沉",
      "content": [
        "月落星沉，楼上美人春睡。",
        "绿云倾，金枕腻，画屏深。",
        "子规啼破相思梦，曙色东方才动。",
        "柳烟轻，花露重，思难任。"
      ],
      "author": {
        "id": 6755,
        "name": "韦庄"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377885,
      "title": "木兰花·木兰花·独上小楼春欲暮",
      "content": [
        "独上小楼春欲暮，愁望玉关芳草路。",
        "消息断，不逢人，欲敛细眉归绣户。",
        "坐看落花空叹息，罗袂湿斑红泪滴。",
        "千山万水不曾行，魂梦欲教何处觅。"
      ],
      "author": {
        "id": 6755,
        "name": "韦庄"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377886,
      "title": "小重山·小重山·一闭昭阳春又春",
      "content": [
        "一闭昭阳春又春，夜寒宫漏永，梦君恩。",
        "昏思陈事暗消魂，罗衣湿，红袂有啼痕。",
        "歌吹隔重阍，绕庭芳草绿，倚长门。",
        "万般惆怅向谁论？",
        "凝情立，宫殿欲黄昏。"
      ],
      "author": {
        "id": 6755,
        "name": "韦庄"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377887,
      "title": "浣溪沙·浣溪沙·红蓼渡头秋正雨",
      "content": [
        "红蓼渡头秋正雨，印沙鸥迹自成行，整鬟飘袖野风香。",
        "不语含颦深浦里，几回愁煞棹船郎，燕归帆尽水茫茫。"
      ],
      "author": {
        "id": 8953,
        "name": "薛昭蕴"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377888,
      "title": "浣溪沙·浣溪沙·钿匣菱花锦带垂",
      "content": [
        "钿匣菱花锦带垂，静临栏槛卸头时，约鬟低珥算归期。",
        "茂苑草青湘渚阔，梦余空有漏依依，二年终日损芳菲。"
      ],
      "author": {
        "id": 8953,
        "name": "薛昭蕴"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377889,
      "title": "浣溪沙·浣溪沙·粉上依稀有泪痕",
      "content": [
        "粉上依稀有泪痕，郡庭花落欲黄昏，远情深恨与谁论。",
        "记得去年寒食日，延秋门外卓金轮，日斜人散暗消魂。"
      ],
      "author": {
        "id": 8953,
        "name": "薛昭蕴"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377890,
      "title": "浣溪沙·浣溪沙·握手河桥柳似金",
      "content": [
        "握手河桥柳似金，蜂须轻惹百花心，蕙风兰思寄清琴。",
        "意满便同春水满，情深还似酒杯深，楚烟湘月两沉沉。"
      ],
      "author": {
        "id": 8953,
        "name": "薛昭蕴"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377891,
      "title": "浣溪沙·浣溪沙·帘下三间出寺墙",
      "content": [
        "帘下三间出寺墙，满街垂杨绿阴长，嫩红轻翠间浓妆。",
        "瞥地见时犹可可，却来闲处暗思量，如今情事隔仙乡。"
      ],
      "author": {
        "id": 8953,
        "name": "薛昭蕴"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377892,
      "title": "浣溪沙·浣溪沙·江馆清秋缆客船",
      "content": [
        "江馆清秋缆客船，故人相送夜开筵，麝烟兰焰簇花钿。",
        "正是断魂迷楚雨，不堪离恨咽湘弦，月高霜白水连天。"
      ],
      "author": {
        "id": 8953,
        "name": "薛昭蕴"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377893,
      "title": "浣溪沙·浣溪沙·倾国倾城恨有余",
      "content": [
        "倾国倾城恨有余，几多红泪泣姑苏，倚风凝睇雪肌肤。",
        "吴主山河空落日，越王宫殿半平芜，藕花菱蔓满重湖。"
      ],
      "author": {
        "id": 8953,
        "name": "薛昭蕴"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377894,
      "title": "浣溪沙·浣溪沙·越女淘金春水上",
      "content": [
        "越女淘金春水上，步摇云鬓珮鸣珰，渚风江草又清香。",
        "不为远山凝翠黛，只应含恨向斜阳，碧桃花谢忆刘郎。"
      ],
      "author": {
        "id": 8953,
        "name": "薛昭蕴"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377895,
      "title": "喜迁莺·喜迁莺·残蟾落",
      "content": [
        "残蟾落，晓钟鸣，羽化觉身轻。",
        "乍无春睡有余酲，杏苑雪初晴。",
        "紫陌长，襟袖冷，不是人间风景。",
        "回看尘土似前生，休羡谷中莺。"
      ],
      "author": {
        "id": 8953,
        "name": "薛昭蕴"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377896,
      "title": "喜迁莺·喜迁莺·金门晓",
      "content": [
        "金门晓，玉京春，骏马骤轻尘。",
        "桦烟深处白衫新，认得化龙身。",
        "九陌喧，千户启，满袖桂香风细。",
        "杏园欢宴曲江滨，自此占芳辰。"
      ],
      "author": {
        "id": 8953,
        "name": "薛昭蕴"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377897,
      "title": "喜迁莺·喜迁莺·清明节",
      "content": [
        "清明节，雨晴天，得意正当年。",
        "马骄泥软绵连干，香袖半笼鞭。",
        "花色融，人竞赏，尽是绣鞍朱鞅。",
        "日斜无计更留连，归路草和烟。"
      ],
      "author": {
        "id": 8953,
        "name": "薛昭蕴"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377898,
      "title": "小重山·小重山·春到长门春草青",
      "content": [
        "春到长门春草青，玉阶华露滴，月胧明。",
        "东风吹断紫箫声，宫漏促，帘外晓啼莺。",
        "愁极梦难成，红妆流宿泪，不胜情。",
        "手挼裙带绕阶行，思君切，罗幌暗尘生。"
      ],
      "author": {
        "id": 8953,
        "name": "薛昭蕴"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377899,
      "title": "小重山·小重山·秋到长门秋草黄",
      "content": [
        "秋到长门秋草黄，画梁双燕去，出宫墙。",
        "玉箫无复理霓裳，金蝉坠，鸾镜掩休妆。",
        "忆昔在昭阳，舞衣红绶带，绣鸳鸯。",
        "至今犹惹御炉香，魂梦断，愁听漏更长。"
      ],
      "author": {
        "id": 8953,
        "name": "薛昭蕴"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377900,
      "title": "离别难·离别难·宝马晓鞲雕鞍",
      "content": [
        "宝马晓鞲雕鞍，罗帷乍别情难。",
        "那堪春景媚，送君千万里。",
        "半妆珠翠落，露华寒。",
        "红蜡烛，青丝曲，偏能钩引泪阑干。",
        "良夜促，香尘绿，魂欲迷，檀眉半敛愁低。",
        "未别心先咽，欲语情难说。",
        "出芳草，路东西。",
        "摇袖立，春风急，樱花杨柳雨凄凄。"
      ],
      "author": {
        "id": 8953,
        "name": "薛昭蕴"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377901,
      "title": "相见欢·相见欢·罗襦绣袂香红",
      "content": [
        "罗襦绣袂香红，画堂中。",
        "细草平沙番马，小屏风。",
        "卷罗幕，凭妆阁，思无穷。",
        "暮雨轻烟魂断，隔帘栊。"
      ],
      "author": {
        "id": 8953,
        "name": "薛昭蕴"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377902,
      "title": "醉公子·醉公子·慢绾青丝发",
      "content": [
        "慢绾青丝发，光砑吴绫袜。",
        "床上小熏笼，韶州新退红。",
        "叵耐无端处，捻得从头污。",
        "恼得眼慵开，问人闲事来。"
      ],
      "author": {
        "id": 8953,
        "name": "薛昭蕴"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377903,
      "title": "女冠子·女冠子·求仙去也",
      "content": [
        "求仙去也，翠钿金篦尽舍，入崖峦。",
        "雾卷黄罗帔，云雕白玉冠。",
        "野烟溪洞冷，林月石桥寒。",
        "静夜松风下，礼天坛。"
      ],
      "author": {
        "id": 8953,
        "name": "薛昭蕴"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377904,
      "title": "女冠子·女冠子·云罗雾縠",
      "content": [
        "云罗雾縠，新授明威法箓，降真函。",
        "髻绾青丝发，冠抽碧玉簪。",
        "往来云过五，去往岛经三。",
        "正遇刘郎使，启瑶缄。"
      ],
      "author": {
        "id": 8953,
        "name": "薛昭蕴"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377905,
      "title": "谒金门·谒金门·春满院",
      "content": [
        "春满院，叠损罗衣金线。",
        "睡觉水晶帘未卷，檐前双语燕。",
        "斜掩金铺一扇，满地落花千片。",
        "早是相思肠欲断，忍教频梦见。"
      ],
      "author": {
        "id": 8953,
        "name": "薛昭蕴"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377906,
      "title": "柳枝·柳枝·解冻风来末上青",
      "content": [
        "解冻风来末上青，解垂罗袖拜卿。",
        "无端袅娜临官路，舞送行人过一生。"
      ],
      "author": {
        "id": 12058,
        "name": "牛峤"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377907,
      "title": "柳枝·柳枝·吴王宫里色偏深",
      "content": [
        "吴王宫里色偏深，一簇纤条万缕金。",
        "不愤钱塘苏小小，引郎松下结同心。"
      ],
      "author": {
        "id": 12058,
        "name": "牛峤"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377908,
      "title": "柳枝·柳枝·桥北桥南千万条",
      "content": [
        "桥北桥南千万条，恨伊张绪不相饶。",
        "金羁白马临风望，认得杨家静婉腰。"
      ],
      "author": {
        "id": 12058,
        "name": "牛峤"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377909,
      "title": "柳枝·柳枝·狂雪随风扑马飞",
      "content": [
        "狂雪随风扑马飞，惹烟无力被春欺。",
        "莫教移入灵和殿，宫女三千又妒伊。"
      ],
      "author": {
        "id": 12058,
        "name": "牛峤"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377910,
      "title": "柳枝·柳枝·袅翠笼烟拂暖波",
      "content": [
        "袅翠笼烟拂暖波，舞裙新染麹尘罗。",
        "章华台畔隋堤上，傍得春风尔许多。"
      ],
      "author": {
        "id": 12058,
        "name": "牛峤"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 377911,
      "title": "女冠子·女冠子·绿云高髻",
      "content": [
        "绿云高髻，点翠匀红时世。",
        "月如眉。",
        "浅笑含双靥，低声唱小词。",
        "眼看唯恐化，魂荡欲相随。",
        "玉趾回娇步，约佳期。"
      ],
