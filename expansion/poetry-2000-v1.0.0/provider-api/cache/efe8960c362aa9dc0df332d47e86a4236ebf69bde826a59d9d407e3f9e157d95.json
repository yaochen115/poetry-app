{
  "data": [
    {
      "id": 258597,
      "title": "过瑞龙观道士",
      "content": [
        "不知谁氏子，炼魄家洞天。",
        "鹤待成丹日，人寻种杏田。",
        "灵山含道气，物性皆自然。",
        "白鹿顾瑞草，骊龙蟠玉泉。",
        "得兹象外趣，便割区中缘。",
        "石窦采云母，霞堂陪列仙。",
        "主人善止客，柯烂忘归年。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 258598,
      "title": "送沈仲",
      "content": [
        "天朴非外假，至人常晏如。",
        "心期邈霄汉，词律响琼琚。",
        "举酒常叹息，无人达子虚。",
        "夜光失隋掌，骥𫘧伏盐车。",
        "考室晋山下，归田秦岁初。",
        "寒云随路合，落照下城余。",
        "千里还同术，无劳怨索居。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 258599,
      "title": "和韦侍御寓直对雨",
      "content": [
        "名贯四科首，班宜二妙齐。",
        "如何厌白简，未得步金闺。",
        "寓直晦秋雨，吟余闻远鸡。",
        "漏声过旦冷，云色向窗低。",
        "谁谓霄汉近，翻嗟心事暌。",
        "兰滋人未握，霜晓鹗还栖。",
        "伫见田郎字，亲劳御笔题。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 258600,
      "title": "奉和圣制登朝元阁",
      "content": [
        "六合纡玄览，重轩启上清。",
        "石林飞栋出，霞顶泰堦平。",
        "拂曙銮舆上，晞阳瑞雪晴。",
        "翠微回日驭，丹𪩘驻天行。",
        "御气升银汉，垂衣俯锦城。",
        "山通玉苑迥，河抱紫关明。",
        "感物干文动，凝神道化成。",
        "周王陟乔岳，列辟让英声。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 258601,
      "title": "奉和杜相公移长兴宅奉呈元相公",
      "content": [
        "守贵常思俭，平津此意深。",
        "能卑丞相宅，何谢故人心。",
        "种蕙初抽带，移篁不改阴。",
        "院梅朝助鼎，池凤夕归林。",
        "觉路经中得，沧州梦里寻。",
        "道高仍济代，恩重岂投簪。",
        "报国谁知己，推贤共作霖。",
        "兴来文雅振，清韵掷双金。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 258602,
      "title": "送任先生任唐山丞",
      "content": [
        "再命果良愿，几年勤说诗。",
        "上公频握发，才子共垂帷。",
        "琢玉成良器，出门偏怆离。",
        "腰章佐墨绶，耀锦到茅茨。",
        "树老见家日，潮平归县时。",
        "衣催莲女织，颂听海人词。",
        "鸿鹄志应在，荃兰香未衰。",
        "金门定回音，云路有佳期。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 258603,
      "title": "送外甥怀素上人归乡侍奉",
      "content": [
        "释子吾家宝，神清慧有余。",
        "能翻梵王字，妙尽伯英书。",
        "远鹤无前侣，孤云寄太虚。",
        "狂来轻世界，醉里得真如。",
        "飞锡离乡久，宁亲喜腊初。",
        "故池残雪满，寒柳霁烟疎。",
        "寿酒还尝药，晨餐不荐鱼。",
        "遥知禅诵外，健笔赋闲居。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 258604,
      "title": "送张中丞赴桂州",
      "content": [
        "出守求人瘼，推贤动圣情。",
        "紫台初下诏，皂盖始专城。",
        "宠借飞霜简，威加却月营。",
        "云衢降五马，林木引双旌。",
        "夙仰敦诗礼，尝闻偃甲兵。",
        "戍楼云外静，讼阁竹间清。",
        "化伫还珠美，心将片玉贞。",
        "寇恂朝望重，计日谒承明。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 258605,
      "title": "送王相公赴范阳",
      "content": [
        "翊圣衔恩重，频年按节行。",
        "安危皆报国，文武不缘名。",
        "受脤乃调鼎，为霖更洗兵。",
        "幕开丞相阁，旗总贰师营。",
        "料敌知无战，安边示有征。",
        "代云横马首，燕雁拂笳声。",
        "去镇关河静，归看日月明。",
        "欲知瞻恋切，迟暮一书生。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 258606,
      "title": "送蒋尚书居守东都",
      "content": [
        "凤辇幸秦久，周人徯帝情。",
        "若非君敏德，谁镇洛阳城。",
        "前席命才彦，举朝推令名。",
        "纶言动北斗，职事守东京。",
        "郑履下天去，蘧轮满路声。",
        "出关秋树直，对阙远山明。",
        "肃肃保厘处，水流宫苑清。",
        "长安日西笑，朝夕衮衣迎。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 258607,
      "title": "送李兵曹赴河中",
      "content": [
        "能荷钟鼎业，不矜纨绮荣。",
        "侯门三事后，儒服一书生。",
        "昔志学文史，立身为士英。",
        "骊珠难隐耀，臯鹤会长鸣。",
        "休命且随牒，候时常振缨。",
        "寒蝉思关柳，匹马向蒲城。",
        "秋日黯将暮，黄河如欲清。",
        "黎人思坐啸，知子树佳声。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 258608,
      "title": "罢官后酬元校书见赠",
      "content": [
        "心期怅已阻，交道复何如。",
        "自我辞丹阙，惟君到故庐。",
        "忘机贫负米，忆戴出无车。",
        "邻犬吠初服，家人愁斗储。",
        "秋堂入闲夜，云月思离居。",
        "穷巷闻砧冷，荒枝应鹊疎。",
        "宦名随落叶，生事感枯鱼。",
        "临水仍挥手，知音未弃余。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 258609,
      "title": "同邬戴关中旅寓",
      "content": [
        "文士皆求遇，今人谁至公。",
        "灵台一寄宿，杨柳再春风。",
        "更惜忘形友，频年失志同。",
        "羽毛齐燕雀，心事阻鸳鸿。",
        "留滞惭归养，飞鸣恨触笼。",
        "橘怀乡梦里，书去客愁中。",
        "残雪迷归雁，韶光弃断蓬。",
        "吞悲问唐举，何路出屯蒙。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 258610,
      "title": "新丰主人",
      "content": [
        "明代少知己，夜光频暗投。",
        "迍邅终薄命，动息尽穷愁。",
        "自欲归飞鹢，当为不系舟。",
        "双垂素丝泪，几弊皂貂裘。",
        "暮鸟栖幽树，孤云出旧丘。",
        "蛩悲衣褐夕，雨暗转蓬秋。",
        "客里冯谖劒，歌中宁戚牛。",
        "主人能纵酒，一醉且忘忧。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 258611,
      "title": "夕游覆釜山道士观因登玄元庙",
      "content": [
        "冥搜过物表，洞府次溪傍。",
        "已入瀛洲远，谁言仙路长。",
        "孤烟出深竹，道侣正焚香。",
        "鸣磬爱山静，步虚宜夜凉。",
        "仍同象帝庙，更上紫霞冈。",
        "霁月悬琪树，明星映碧堂。",
        "倾思丹灶术，愿采玉芝芳。",
        "傥把浮丘袂，乘云别旧乡。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 258612,
      "title": "陪郭常侍令公东亭宴集",
      "content": [
        "盛业山河列，重名劒履荣。",
        "珥貂为相子，开合引时英。",
        "美景池台色，佳期宴赏情。",
        "词人载笔至，仙妓出花迎。",
        "暗竹朱轮转，回塘玉佩鸣。",
        "舞衫招戏蝶，歌扇隔啼莺。",
        "饮德心皆醉，披云兴转清。",
        "不愁懽乐尽，积庆在和羹。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 258613,
      "title": "太子李舍人城东别业与二三文友逃暑",
      "content": [
        "下马失炎暑，重门深绿篁。",
        "宫臣礼嘉客，林表开兰堂。",
        "兹夕兴难尽，澄罍照墨塲。",
        "鲜风吹印绶，密坐皆馨香。",
        "美景惜文会，清吟迟羽觞。",
        "东林晚来好，目极趣何长。",
        "鸟道挂疎雨，人家残夕阳。",
        "城隅拥归骑，留醉恋琼芳。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 258614,
      "title": "柏崖老人号无名先生男削发女黄冠自以云泉独乐命予赋诗",
      "content": [
        "古也忧婚嫁，君能乐性肠。",
        "长男栖月宇，少女炫霓裳。",
        "问尔餐霞处，春山芝桂旁。",
        "鹤前飞九转，壶里驻三光。",
        "与我开龙峤，披云静药堂。",
        "胡麻兼藻绿，石髓隔花香。",
        "帝力言何有，椿年喜渐长。",
        "窅然高象外，宁不傲羲皇。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 258615,
      "title": "赠李十六",
      "content": [
        "半面喜投分，数年钦盛名。",
        "常思梦颜色，谁忆访柴荆。",
        "忽听欵扉响，欣然倒屣迎。",
        "蓬蒿驻驺驭，鸡犬傍簪缨。",
        "酌水即嘉宴，新知甚故情。",
        "仆夫视日色，栖鸟催车声。",
        "自尔宴言后，至今门馆清。",
        "何当更乘兴，林下已苔生。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 258616,
      "title": "裴仆射东亭",
      "content": [
        "凤扆任匡济，云溪难退还。",
        "致君超列辟，得道在荣班。",
        "朱戟缭垣下，高斋芳树间。",
        "隔花开远水，废卷爱晴山。",
        "晚沐值清兴，知音同解颜。",
        "藉兰开赐酒，留客下重关。",
        "仙犬逐人静，朝车映竹闲。",
        "则知真隐逸，未必谢区寰。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 258617,
      "title": "中书王舍人辋川旧居",
      "content": [
        "几年家绝壑，满径种芳兰。",
        "带石买松贵，通溪涨水宽。",
        "诵经连谷响，吹律减云寒。",
        "谁谓桃源里，天书问考槃。",
        "一从解蕙带，三入偶蝉冠。",
        "今夕复何夕，归休寻旧欢。",
        "片云隔苍翠，春雨半林湍。",
        "藤长穿松盖，花繁压药栏。",
        "景深青眼下，兴绝彩毫端。",
        "笑向同来客，登龙此地难。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 258618,
      "title": "送襄阳卢判官奏开河事",
      "content": [
        "千里趋魏阙，一言简圣聪。",
        "河流引关外，国用赡秦中。",
        "有诏许其策，随山兴此功。",
        "连云积石阻，计日安波通。",
        "飞櫂转年谷，利人胜岁丰。",
        "言归汉阳路，拜手蓬莱宫。",
        "紫殿赐衣出，青门酣酌同。",
        "晚阳过微雨，秋水见新鸿。",
        "坐惜去车远，愁看离馆空。",
        "因思郢川守，南楚满清风。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 258619,
      "title": "奉送户部李郎中充晋国副节度出塞",
      "content": [
        "德佐调梅用，忠输击虏年。",
        "子房推庙略，汉主托兵权。",
        "受命荣中禁，分麾镇左贤。",
        "风生黑山道，星下紫微天。",
        "始愿文经国，俄看武定边。",
        "鬼方尧日远，幕府代云连。",
        "汗马将行矣，卢龙已肃然。",
        "关防驱使节，花月眷离筵。",
        "自忝知音遇，而今感义偏。",
        "泪闻横吹落，心逐去旌悬。",
        "帝念夔能政，时须说济川。",
        "劳还应即尔，朝暮玉墀前。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 258620,
      "title": "奉和中书常舍人晚秋集贤院即事寄徐薛二侍御",
      "content": [
        "文星垂太虚，辞伯综群书。",
        "彩笔下鸳掖，褒衣来石渠。",
        "典坟探奥旨，造化覩权舆。",
        "述圣鲁宣父，通经汉仲舒。",
        "窗明宜缥带，地肃近丹除。",
        "清昼删诗暇，高秋作赋初。",
        "露盘侵汉耸，宫柳度鵶疎。",
        "静对连云阁，晴闻过阙车。",
        "旧僚云出矣，晚岁复何如。",
        "海峤瞻归路，江城梦直庐。",
        "含毫思两凤，望远寄双鱼。",
        "定笑巴歌拙，还参丽曲余。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 258621,
      "title": "和范郎中宿直中书晓翫清池赠南省同僚两垣遗补",
      "content": [
        "青琐留才子，春池静禁林。",
        "自矜仙岛胜，宛在掖垣深。",
        "引派彤庭里，含虚玉砌阴。",
        "涨来知圣泽，清处见天心。",
        "兰气飘红岸，文星动碧浔。",
        "凤栖长近日，虬卧欲为霖。",
        "席宠虽高位，流谦乃素襟。",
        "焚香春漏尽，假寐晓莺吟。",
        "丹地宜清泚，朝阳复照临。",
        "司言兼逸趣，鼓兴接知音。",
        "六义惊摛藻，三台响掷金。",
        "为怜风水外，落羽此漂沈。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 258622,
      "title": "同程九早入中书",
      "content": [
        "汉家贤相重英奇，蟠木何材也见知。",
        "不意云霄能自致，空惊鹓鹭忽相随。",
        "腊雪初明柏子殿，春光欲上万年枝。",
        "独慙皇鉴明如日，未厌春光向玉墀。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 258623,
      "title": "仲春宴王补阙城东小池",
      "content": [
        "王孙兴至幽寻好，芳草春深景气和。",
        "药院爱随流水入，山斋喜与白云过。",
        "犹嫌巢鹤窥人远，不厌丛花对客多。",
        "醉来倚玉无余事，目送归鸿笑复歌。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 258624,
      "title": "夜宿灵台寺寄郎士元",
      "content": [
        "西日横山含碧空，东方吐月满禅宫。",
        "朝瞻双顶青冥上，夜宿诸天色界中。",
        "石潭倒献莲花水，塔院空闻松柏风。",
        "万里故人能尚尔，知君视听我心同。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 258625,
      "title": "题郎士元半日吴村别业兼呈李长官",
      "content": [
        "半日吴村带晚霞，闲门高柳乱飞鵶。",
        "横云岭外千重树，流水声中一两家。",
        "愁人昨夜相思苦，闰月今年春意赊。",
        "自叹梅生头似雪，却怜潘令县如花。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 258626,
      "title": "猷川雪后送僧粲临还京时避世卧疾",
      "content": [
        "连步青溪几万重，有时共立在孤峰。",
        "斋到盂空餐雪麦，经传金字坐云松。",
        "呻吟独卧猷川水，振锡先闻长乐钟。",
        "回望群山携手处，离心一一涕无从。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 258627,
      "title": "和李员外扈驾幸温泉宫",
      "content": [
        "未央月晓度疎钟，凤辇时巡出九重。",
        "雪霁山门迎瑞日，云开水殿候飞龙。",
        "经寒不入宫中树，佳气常薰仗外峰。",
        "遥羡枚臯扈仙跸，偏承霄汉渥恩浓。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 258628,
      "title": "长信怨",
      "content": [
        "长信萤来一叶秋，蛾眉泪尽九重幽。",
        "𫛛鹊观前明月度，芙蓉阙下绛河流。",
        "鸳衾久别难为梦，凤管遥闻更起愁。",
        "谁分昭阳夜歌舞，君王玉辇正淹留。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 258629,
      "title": "送河南陆少府",
      "content": [
        "云间陆生美且奇，银章朱绶暎金羁。",
        "自料抱材将致远，宁嗟趋府暂牵卑。",
        "东城社日催巢燕，上苑秋声散御梨。",
        "朝夕诏书还柏署，行看飞隼集高枝。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 258630,
      "title": "送李评事赴潭州使幕",
      "content": [
        "湖南远去有余情，苹叶初齐白芷生。",
        "谩说简书催物役，遥知心赏缓王程。",
        "兴过山寺先云到，啸引江帆带月行。",
        "幕下由来贵无事，伫闻谈笑静黎甿。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 258631,
      "title": "送李九贬南阳",
      "content": [
        "玉柱金罍醉不欢，云山驿道向东看。",
        "鸿声断续暮天远，柳影萧疎秋日寒。",
        "霜降幽林霑蕙若，弦惊翰苑失鸳鸾。",
        "秋来回首君门阻，马上应歌行路难。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 258632,
      "title": "送裴頔侍御使蜀",
      "content": [
        "柱史才年四十强，须髯玄发美清扬。",
        "朝天绣服乘恩贵，出使星轺满路光。",
        "锦水繁花添丽藻，峨嵋明月引飞觞。",
        "多才自有云霄望，计日应追鸳鹭行。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 258633,
      "title": "送韦信爱子归觐",
      "content": [
        "离舟解缆到斜晖，春水东流燕北飞。",
        "才子学诗趋露冕，棠花含笑待斑衣。",
        "稍闻江树啼猨近，转觉山林过客稀。",
        "借问还珠盈合浦，何如鲤也入庭闱。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 258634,
      "title": "送兴平王少府游梁",
      "content": [
        "旧识相逢情更亲，攀欢甚少怆离频。",
        "黄绶罢来多远客，青山何处不愁人。",
        "日斜官树闻蝉满，雨过关城见月新。",
        "梁国遗风重词赋，诸侯应念马卿贫。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 258635,
      "title": "送张员外出牧岳州",
      "content": [
        "凤凰衔诏与何人，善政多才宠寇恂。",
        "台上鸳鸾争送远，岳阳云树待行春。",
        "自怜黄阁知音在，不厌彤幨出守频。",
        "应笑冯唐衰且拙，世情相见白头新。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 258636,
      "title": "送孙十尉温县",
      "content": [
        "飞花落絮满河桥，千里伤心送客遥。",
        "不惜芸香染黄绶，惟怜鸿羽下青霄。",
        "云衢有志终骧首，吏道无媒且折腰。",
        "急管繁弦催一醉，颓阳不驻引征镳。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 258637,
      "title": "送钟评事应宏词下第东归",
      "content": [
        "芳岁归人嗟转蓬，含情回首灞陵东。",
        "蛾眉不入秦台镜，鹢羽还惊宋国风。",
        "世事悠扬春梦里，年光寂寞旅愁中。",
        "劝君稍尽离筵酒，千里佳期难再同。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 258638,
      "title": "送严维尉河南",
      "content": [
        "蕙叶青青花乱开，少年趋府下蓬莱。",
        "甘泉未献扬雄赋，吏道何劳贾谊才。",
        "征陌独愁飞盖远，离筵只惜暝钟催。",
        "欲知别后相思处，愿植琼枝向柏台。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 258639,
      "title": "送马员外拜官觐省",
      "content": [
        "二十为郎事汉文，鸳雏骥子自为群。",
        "笔精已许台中妙，劒术还令世上闻。",
        "归觐屡经槐里月，出师常笑棘门军。",
        "莫言来往朝天远，看取鸣鞘入断云。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 258640,
      "title": "送冷朝阳擢第后归金陵觐省",
      "content": [
        "莱子昼归今始好，潘园景色夏偏浓。",
        "夕阳流水吟诗去，明月青山出竹逢。",
        "兄弟相欢初让果，乡人争贺旧登龙。",
        "佳期少别俄千里，云树愁看过几重。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 258641,
      "title": "九日宴浙江西亭",
      "content": [
        "诗人九日怜芳菊，筵客高斋宴浙江。",
        "渔浦浪花摇素壁，西陵树色入秋窗。",
        "木奴向熟悬金实，桑落新开泻玉缸。",
        "四子醉时争讲习，笑论黄霸旧为邦。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 258642,
      "title": "和王员外雪晴早朝",
      "content": [
        "紫微晴雪带恩光，绕仗偏随鸳鹭行。",
        "长信月留宁避晓，宜春花满不飞香。",
        "独看积素凝清禁，已觉轻寒让太阳。",
        "题柱盛名兼绝唱，风流谁继汉田郎。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 258643,
      "title": "避暑纳凉",
      "content": [
        "木槿花开畏日长，时摇轻扇倚绳床。",
        "初晴草蔓缘新笋，频雨苔衣染旧墙。",
        "十旬河朔应虚醉，八柱天台好纳凉。",
        "无事始然知静胜，深垂纱帐咏沧浪。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 258644,
      "title": "早夏",
      "content": [
        "楚狂身世恨情多，似病如忧正是魔。",
        "花萼败春多寂寞，叶阴迎夏已清和。",
        "鹂黄好鸟摇深树，细白佳人著紫罗。",
        "军旅阅诗裁不得，可怜风景遣如何。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 258645,
      "title": "题嵩阳焦道士石壁",
      "content": [
        "三峰花畔碧堂悬，锦里真人此得仙。",
        "玉体才飞西蜀雨，霓裳欲向大罗天。",
        "彩云不散烧丹灶，白鹿时藏种玉田。",
        "幸入桃源因去世，方期丹诀一延年。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 258646,
      "title": "题延州圣僧穴",
      "content": [
        "定力无涯不可称，未知何代坐禅僧。",
        "默默山门宵闭月，荧荧石壁昼然灯。",
        "四时树长书经叶，万岁岩悬拄杖藤。",
        "昔日舍身缘救鸽，今时出见有飞鹰。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 258647,
      "title": "乐游原晴望上中书李侍郎",
      "content": [
        "爽气朝来万里清，凭高一望九秋轻。",
        "不知凤沼霖初霁，但觉尧天日转明。",
        "四野山河通远色，千家砧杵共秋声。",
        "遥想青云丞相府，何时开合引书生。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 258648,
      "title": "幽居春暮书怀",
      "content": [
        "自哂鄙夫多野性，贫居数亩半临湍。",
        "谿云杂雨来茅屋，山雀将雏到药栏。",
        "仙箓满床闲不厌，阴符在箧老羞看。",
        "更怜童子宜春服，花里寻师指杏坛。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 258649,
      "title": "谒许由庙",
      "content": [
        "故向箕山访许由，林泉物外自清幽。",
        "松上挂瓢枝几变，石间洗耳水空流。",
        "绿苔唯见遮三径，青史空传谢九州。",
        "缅想古人增叹惜，飒然云树满岩秋。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 258650,
      "title": "过张成侍御宅",
      "content": [
        "丞相幕中题凤人，文章心事每相亲。",
        "从军谁谓仲宣乐，入室方知颜子贫。",
        "杯里紫茶香代酒，琴中绿水静留宾。",
        "欲知别后相思意，唯愿琼枝入梦频。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 258651,
      "title": "酬考功杨员外见赠佳句",
      "content": [
        "上林谏猎知才薄，尺组承恩愧命牵。",
        "潢潦难滋沧海润，萤光空尽太阳前。",
        "虚名滥接登龙士，野性宁忘种黍田。",
        "相国无私人守朴，何辞老去上皇年。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 258652,
      "title": "寄永嘉王十二",
      "content": [
        "永嘉风景入新年，才子诗成定可怜。",
        "梦里还乡不相见，天涯忆戴复谁传。",
        "花倾晓露垂如泪，莺拂游丝断若弦。",
        "愿得回风吹海雁，飞书一宿到君边。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 258653,
      "title": "七盘岭阻寇闻李端公先到南楚",
      "content": [
        "日暮穷途泪满襟，云天南望羡飞禽。",
        "阮肠暗与孤鸿断，江水遥连别恨深。",
        "明月既能通忆梦，青山何用隔同心。",
        "秦楚眼看成绝国，相思一寄白头吟。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 258654,
      "title": "酬赵给事相寻不遇留赠",
      "content": [
        "谁忆颜生穷巷里，能劳马迹破春苔。",
        "忽看童子扫花处，始愧夕郎题凤来。",
        "斜景适随诗兴尽，好风才送珮声回。",
        "岂无鸡黍期他日，惜此残春阻绿杯。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 258655,
      "title": "山中酬杨补阙见过",
      "content": [
        "日暖风恬种药时，红泉翠壁薜萝垂。",
        "幽溪鹿过苔还静，深树云来鸟不知。",
        "青琐同心多逸兴，春山载酒远相随。",
        "却慙身外牵缨冕，未胜杯前倒接䍠。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 258656,
      "title": "同王𫓾起居程浩郎中韩翃舍人题安国寺用上人院",
      "content": [
        "慧眼沙门真远公，经行宴坐有儒风。",
        "香缘不绝簪裾会，禅想宁妨藻思通。",
        "曙后𬬻烟生不灭，晴来堦色并归空。",
        "狂夫入室无余事，唯与天花一笑同。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 258657,
      "title": "寻司勋李郎中不遇",
      "content": [
        "知己知音同舍郎，如何咫尺阻清扬。",
        "每恨蒹葭傍芳树，多惭新燕入华堂。",
        "重花不隔陈蕃榻，修竹能深夫子墙。",
        "唯有早朝趋凤合，朝时怜羽接鸳行。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 258658,
      "title": "赠张南史",
      "content": [
        "紫泥何日到沧州，笑向东阳沈隐侯。",
        "黛色晴峰云外出，縠文江水县前流。",
        "使臣自欲论公道，才子非关厌薄游。",
        "溪畔秋兰虽可佩，知君不得少停舟。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 258659,
      "title": "暇日览旧诗因以题咏",
      "content": [
        "逍遥心地得关关，偶被功名涴我闲。",
        "有寿亦将归象外，无诗兼不恋人间。",
        "何穷默识轻洪范，未丧斯文胜大还。",
        "筐箧静开难似此，蕊珠春色海中山。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 258660,
      "title": "汉武出猎",
      "content": [
        "汉家无事乐时雍，羽猎年年出九重。",
        "玉帛不朝金阙路，旌旗长绕彩霞峰。",
        "且贪原兽轻黄屋，宁畏渔人犯白龙。",
        "薄暮方归长乐观，垂杨几处绿烟浓。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 258661,
      "title": "宴曹王宅",
      "content": [
        "贤王驷马退朝初，小苑三春带雨余。",
        "林沼葱茏多贵气，楼台隐暎接天居。",
        "仙鸡引敌穿红药，宫燕衔泥落绮疏。",
        "自叹平生相识愿，何如今日厕应徐。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 258662,
      "title": "重赠赵给事",
      "content": [
        "久飞鸳掖出时髦，耻负平生稽古劳。",
        "玉树满庭家转贵，云衢独步位初高。",
        "能迂驺驭寻蜗舍，不惜瑶华报木桃。",
        "应念潜郎守贫病，常悲休沐对蓬蒿。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 258663,
      "title": "赠阙下裴舍人",
      "content": [
        "二月黄莺飞上林，春城紫禁晓阴阴。",
        "长乐钟声花外尽，龙池柳色雨中深。",
        "阳和不散穷途恨，霄汉长怀捧日新。",
        "献赋十年犹未遇，羞将白发对华簪。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 258664,
      "title": "登刘宾客高斋",
      "content": [
        "能以功成疎宠位，不将心赏负云霞。",
        "林间客散孙弘阁，城上山宜绮季家。",
        "蝴蝶晴连池岸草，黄鹂晚出柳园花。",
        "日陪鲤也趋文苑，谁道门生隔绛纱。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 258665,
      "title": "哭辛霁",
      "content": [
        "流水辞山花别枝，随风一去绝还期。",
        "昨夜故人泉下宿，今朝白发镜中垂。",
        "音徽寂寂空成梦，容范朝朝无见时。",
        "旦暮余生几息在，不应存没未尝悲。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 258666,
      "title": "和慕容法曹寻渔者寄城中故人",
      "content": [
        "孤烟一点绿溪湄，渔父幽居即旧基。",
        "饥鹭不惊收钓处，闲麛应乳负暄时。",
        "茅斋对雪开尊好，穉子焚枯饭客迟。",
        "胜事宛然怀抱里，顷来新得谢公诗。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 258667,
      "title": "山花",
      "content": [
        "山花照坞复烧溪，树树枝枝尽可迷。",
        "野客未来枝畔立，流莺已向树边啼。",
        "从容只是愁风起，眷恋常须向日西。",
        "别有妖妍胜桃李，攀来折去亦成蹊。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 258668,
      "title": "送杨著作归东海",
      "content": [
        "杨柳出关色，东行千里期。",
        "酒酣暂轻别，路远始相思。",
        "欲识离心尽，斜阳到海时。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 258669,
      "title": "送李协律还东京",
      "content": [
        "芳草忽无色，王孙复入关。",
        "长河侵驿道，匹马傍云山。",
        "愁见离居久，萤飞秋月闲。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 258670,
      "title": "秋馆言怀",
      "content": [
        "蟋蟀已秋思，蕙兰仍碧滋。",
        "蹉跎献赋客，叹息此良时。",
        "日夕云台下，商歌空自悲。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 258671,
      "title": "和刘明府宴县前山亭",
      "content": [
        "城隅劳心处，雪后岁芳开。",
        "山暎千花出，泉经万井来。",
        "翔鸾欲下舞，上客且留杯。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 258672,
      "title": "新雨喜得王卿书问",
      "content": [
        "苦雨暗秋径，寒花垂紫苔。",
        "愁中绿尊尽，梦里故人来。",
        "果有相思字，银钩新月开。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 258673,
      "title": "赋得巢燕送客",
      "content": [
        "能栖杏梁际，不与黄雀群。",
        "夜影寄红烛，朝飞高碧云。",
        "含情别故侣，花月惜春分。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 258674,
      "title": "题张蓝田讼堂",
      "content": [
        "角巾高枕向晴山，讼简庭空不用关。",
        "秋风窗下琴书静，夜景门前人吏闲。",
        "稍觉渊明归思远，东臯月出片云还。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 258675,
      "title": "江行无题一百首 一",
      "content": [
        "倾酒向涟漪，乘流东去时。",
        "寸心同尺璧，投此报冯夷。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 258676,
      "title": "江行无题一百首 二",
      "content": [
        "江曲全萦楚，雪飞半自秦。",
        "岘山回首望，如别故关人。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 258677,
      "title": "江行无题一百首 三",
      "content": [
        "浦烟函夜色，冷日转秋旻。",
        "自有沈碑石，清光不照人。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 258678,
      "title": "江行无题一百首 四",
      "content": [
        "楚岸云空合，楚城人不来。",
        "只今谁善舞，莫恨发阳台。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 258679,
      "title": "江行无题一百首 五",
      "content": [
        "行背青山郭，吟当白露秋。",
        "风流无屈宋，空咏古荆州。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 258680,
      "title": "江行无题一百首 六",
      "content": [
        "晚来渔父喜，罾重欲收迟。",
        "恐有长江使，金钱愿赎龟。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 258681,
      "title": "江行无题一百首 七",
      "content": [
        "去指龙沙路，徒悬象阙心。",
        "夜凉无远梦，不为偶闻砧。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 258682,
      "title": "江行无题一百首 八",
      "content": [
        "霁云疎有叶，雨浪细无花。",
        "稳放扁舟去，江天自有涯。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 258683,
      "title": "江行无题一百首 九",
      "content": [
        "好日当秋半，层波动旅肠。",
        "已行千里外，谁与共秋光。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 258684,
      "title": "江行无题一百首 十",
      "content": [
        "润色非东里，官曹更建章。",
        "宦游难自定，来唤櫂船郎。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 258685,
      "title": "江行无题一百首 十一",
      "content": [
        "夜江清未晓，徒惜月光沈。",
        "不是因行乐，堪伤老大心。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 258686,
      "title": "江行无题一百首 十二",
      "content": [
        "翳日多乔木，维舟取束薪。",
        "静听江叟语，俱是厌兵人。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 258687,
      "title": "江行无题一百首 十三",
      "content": [
        "箭漏日初短，汀烟草未衰。",
        "雨余虽更绿，不是采苹时。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 258688,
      "title": "江行无题一百首 十四",
      "content": [
        "山雨夜来涨，喜鱼跳满江。",
        "岸沙平欲尽，垂蓼入船窗。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 258689,
      "title": "江行无题一百首 十五",
      "content": [
        "渚边新雁下，舟上独凄凉。",
        "俱是南来客，怜君缀一行。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 258690,
      "title": "江行无题一百首 十六",
      "content": [
        "牵路沿江狭，沙崩岸不平。",
        "尽知行处险，谁肯载时轻。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 258691,
      "title": "江行无题一百首 十七",
      "content": [
        "云密连江暗，风斜著物鸣。",
        "一杯真战将，笑尔作愁兵。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 258692,
      "title": "江行无题一百首 十八",
      "content": [
        "柳拂斜开路，篱边数户村。",
        "可能还有意，不掩向江门。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 258693,
      "title": "江行无题一百首 十九",
      "content": [
        "不识桓公渴，徒吟子美诗。",
        "江清唯独看，心外更谁知。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 258694,
      "title": "江行无题一百首 二十",
      "content": [
        "憔悴异灵均，非谗作逐臣。",
        "如逢渔父问，未是独醒人。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 258695,
      "title": "江行无题一百首 二十一",
      "content": [
        "水涵秋色静，云带夕阳高。",
        "诗癖非吾病，何妨吮短毫。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 258696,
      "title": "江行无题一百首 二十二",
      "content": [
        "登舟非古岸，还似阻西陵。",
        "箕伯无多少，回头讵不能。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    }
  ],
