      }
    },
    {
      "id": 335614,
      "title": "益州城西张超亭观妓",
      "content": [
        "落日明歌席，行云逐舞人。",
        "江南飞暮雨，梁上下轻尘。",
        "冶服看疑画，妆台望似春。",
        "高车勿遽返，长袖欲相亲。"
      ],
      "author": {
        "id": 289,
        "name": "王绩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
