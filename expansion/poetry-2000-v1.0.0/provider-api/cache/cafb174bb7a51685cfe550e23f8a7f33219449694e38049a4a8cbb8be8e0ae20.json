  "data": [
    {
      "id": 302260,
      "title": "山中独坐自赠",
      "content": [
        "幽人似不平，独坐北山楹。",
        "携妻梁处士，别妇许先生。",
        "摈俗劳长叹，寻山倦远行。",
        "空山斜照落，古树寒烟生。",
        "解组陶元亮，辞家向子平。",
        "是非何处在？",
        "潭泊苦纵横。"
      ],
      "author": {
        "id": 289,
        "name": "王绩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 302261,
      "title": "自答",
      "content": [
        "公子澹无为，非关怀□移。",
        "老莱犹[有]（据李抄本补）妇，王霸岂无儿。",
        "人世何劳隔，生涯故可知。",
        "溪流无限水，树长自然枝。",
        "竹林横□□，梧桐倚惠施。",
        "杨朱那早计，烦此泣途歧。"
      ],
      "author": {
        "id": 289,
        "name": "王绩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 302262,
      "title": "过郑处士山庄二首 一",
      "content": [
        "凿溪南浦曲，栽援北岩阿。",
        "野膳调藜荏，山依缉薜萝。",
        "钓潭因旧迹，樵路起新歌。",
        "欲知幽赏处，青青松桂多。"
      ],
      "author": {
        "id": 289,
        "name": "王绩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 302263,
      "title": "过郑处士山庄二首 二",
      "content": [
        "僻处开三径，幽居无四隣。",
        "横文彪子褥，碎点鹿胎巾。",
        "断篱栖夜雉，荒砌起朝麕。",
        "薄暮东溪上，犹言在渭滨。"
      ],
      "author": {
        "id": 289,
        "name": "王绩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 302264,
      "title": "病后醮宅",
      "content": [
        "公干苦沉绵，居山畏不延。",
        "白驴迎蒯子，青牛下葛仙。",
        "度符南灶曲，写咒北阶前。",
        "龙行初禁火，鸟步即凌烟。",
        "净席三天坐，香𬬻五帝筵。",
        "埋沙禳疫气，镇石御凶年。",
        "鬼用泥为壁，神将纸作钱。",
        "山精愁镜厌，野魅怯灯然。",
        "今日扬雄宅，应堪草《太玄》。"
      ],
      "author": {
        "id": 289,
        "name": "王绩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 302265,
      "title": "过乡学",
      "content": [
        "杖蔾寻学舍，抠衣向讲堂。",
        "杏坛花正落，槐市叶新长。",
        "聚徒疑鲁国，游人即郑乡。",
        "先生坐不议，弟子入成行。",
        "邴元（韩理洲云应作「邴原」）供洒埽，刘俊脱衣裳。",
        "组带填中塾，青衿溢下庠。",
        "佩猳情已变，术蚁艺应光。",
        "寄语安眠者，无为粪二墙。"
      ],
      "author": {
        "id": 289,
        "name": "王绩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 302266,
      "title": "春庄酒后",
      "content": [
        "郊扉乘晓辟，山酝及年开。",
        "柏叶投新酿，松花泼旧醅。",
        "野妻临瓮倚，村竖捧瓶来。",
        "竹瘤还作杓，树瘿即成杯。",
        "北潭因醉往，南亩带星回。"
      ],
      "author": {
        "id": 289,
        "name": "王绩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 302267,
      "title": "题酒店楼壁绝句八首 一",
      "content": [
        "欲识幽人伴，非是俗情量。",
        "有业开屠肆，无名坐饼行。"
      ],
      "author": {
        "id": 289,
        "name": "王绩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 302268,
      "title": "题酒店楼壁绝句八首 二",
      "content": [
        "或问游人道，那能独步忧？",
        "饮时含救药，醉罢不能愁。"
      ],
      "author": {
        "id": 289,
        "name": "王绩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 302269,
      "title": "题酒店楼壁绝句八首 三",
      "content": [
        "仲任书卷尽，平君（韩理洲疑为「君平」之倒文，即严君平）不（韩校改为「卜」）数充。",
        "相逢何以慰？",
        "细酌对春风。",
        "（按：《全唐诗》卷三七收入其一、其二、其三、其六、其七等五首，题作《过酒家五首》。"
      ],
      "author": {
        "id": 289,
        "name": "王绩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 302270,
      "title": "山中避暑",
      "content": [
        "幽人自可怜，避暑更萧然。",
        "片云堪度雨，小树即生烟。",
        "岩雪频经夏，溪冰定几年？",
        "横阶看卧石，隔牖听飞泉。",
        "地使炎凉变，人疑岁序迁。",
        "讵知来遁俗，更似得逃年。"
      ],
      "author": {
        "id": 289,
        "name": "王绩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 302271,
      "title": "围碁",
      "content": [
        "饱食端居暇，披襟[弈]（奕）思专。",
        "雕盘蜃胫饰，帖局象牙缘。",
        "裂地四维举，分麾两阵前。",
        "攒眉思上策，屈指计中权。",
        "劲卒衡（韩校疑为「冲」）围度，奇军略地旋。",
        "鱼鳞张九拒，鹤翅拥三边。",
        "逐征何待应，争锋岂厌先。",
        "双关防易断，只眼畏难全。",
        "将骄多受辱，敌耻屡摧坚。",
        "骤覩成为败，频看绝更连。",
        "许知愁越复，恤弱贵邢迁。",
        "诽俗韦弘嗣，邀名葛稚川。",
        "分阴虽可重，小道讵宜捐？",
        "相公摧屐日，樵客烂柯年。",
        "唐尧犹不弃，孔父尚称贤。",
        "博术存书录，壶经著礼篇。",
        "寄言陆士衡，无嗤王仲宣。",
        "（按：《韵语阳秋》卷十七、《全唐诗》卷三七收「全」、「边」二韵，题作《围棋长篇》。"
      ],
      "author": {
        "id": 289,
        "name": "王绩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 302272,
      "title": "咏隐",
      "content": [
        "独有幽栖趣，能令俗网赊。",
        "耕夫田作业，巢叟树为家。",
        "晚令柔残黍，春园扫落花。",
        "恝然乘兴往，何必御云车？"
      ],
      "author": {
        "id": 289,
        "name": "王绩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 302273,
      "title": "春夜过翟处士正师饮酒醉后自问答二首 一",
      "content": [
        "樽酒泛流霞，相将临岁华。",
        "酣歌吹树叶，醉舞拂灯花。",
        "对饮情何已，思归月渐斜。"
      ],
      "author": {
        "id": 289,
        "name": "王绩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 302274,
      "title": "春夜过翟处士正师饮酒醉后自问答二首 二",
      "content": [
        "春来物候妍，夜饮但留连。",
        "晚鎗交鬓侧，残樽倚膝前。",
        "纵横抱琴舞，狼籍枕书眠。",
        "解酲须及曙，路远莫言旋。"
      ],
      "author": {
        "id": 289,
        "name": "王绩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 302275,
      "title": "被举应征别乡中故人",
      "content": [
        "皇明照区域，帝思属风云。",
        "烧山出隐士，治道送征君。",
        "自惟[蓬]（逢）艾影，叨名兰桂芬。",
        "使君留白璧，天子降玄𫄸。",
        "山鸡终失望，野鹿暂辞群。",
        "川气含丹日，乡烟间白云。",
        "停骖无以赠，握管遂成文。",
        "（按：祝尚书《〈全唐诗〉小补》云宋潘自牧《记纂渊海》卷六九引「自惟蓬艾影，叨名兰桂芳」二句。"
      ],
      "author": {
        "id": 289,
        "name": "王绩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 302276,
      "title": "同蔡学士君知咏云",
      "content": [
        "固阳阴正密，侍族□方和。",
        "巫山臣作赋，汾水帝为歌。",
        "绘色还成锦，轻飞更作罗。"
      ],
      "author": {
        "id": 289,
        "name": "王绩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 302277,
      "title": "赠山居黄道士",
      "content": [
        "洁身何必是，避俗岂能全？",
        "动息都无隔，浮沉最可怜。",
        "嵇山《高士传》，庄叟《让王篇》。",
        "逃名遂得志，□□若为传？"
      ],
      "author": {
        "id": 289,
        "name": "王绩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 302278,
      "title": "新园旦坐",
      "content": [
        "林宅资余搆，园亭今创营。",
        "［接梨过半箸］（据李抄本补），从此近全生。",
        "凿沼三泉漏，为山九仞成。",
        "草香罗户穴，茅茹结簷楹。",
        "松栽一当伴，柳种五为名。",
        "独对三春酌，无人来共倾。"
      ],
      "author": {
        "id": 289,
        "name": "王绩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 302279,
      "title": "阅家书",
      "content": [
        "张氏前钞本，班家旧赐余。",
        "尚应千许帙，何啻五盈车。",
        "缝悉龟文印，题皆龙爪书。",
        "牙签过半在，玉轴已全疎。",
        "蘖系防黏蠹，芸香辟纸鱼。",
        "下帷堪发愤，闭户足为储。",
        "为向扬雄说，无劳羡石渠。"
      ],
      "author": {
        "id": 289,
        "name": "王绩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 302280,
      "title": "九月九日",
      "content": [
        "九日重阳节，三秋季月残。",
        "菊花催晚［气］（据《古今岁时杂咏》补），萸房避早寒。",
        "霜浓鹰击远，雾重雁飞难。",
        "谁忆龙山外，萧条边兴阑？",
        "（按：《古今岁时杂咏》卷三十三以此诗为崔善为作，《全唐诗》卷八八二据以收入。",
        "今移正重收。"
      ],
      "author": {
        "id": 289,
        "name": "王绩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 302281,
      "title": "登陇坂二首 一",
      "content": [
        "客行登陇坂，长望一思归。",
        "地险关山密，天平鸿雁稀。",
        "转蓬无定去，惊叶但知飞。",
        "目极征途远，劳情歌《式微》。"
      ],
      "author": {
        "id": 289,
        "name": "王绩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 302282,
      "title": "登陇坂二首 二",
      "content": [
        "陇坂三秦望，游人万里悲。",
        "何关呜咽水，自是断肠时。",
        "风高黄叶散，日下白云滋。",
        "怅望东飞翼，忧来不自持。"
      ],
      "author": {
        "id": 289,
        "name": "王绩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 302283,
      "title": "游山寺",
      "content": [
        "赤城仙观启，青山梵宇裁。",
        "中天疏宝座，半景出香台。",
        "雁翼金桥转，鱼鳞石道回。",
        "经文连树刻，仙影对岩开。",
        "别有迷方者，终慙无碍才。",
        "抠衣祇杖锡，敛袂谒浮杯。",
        "暂识𡺸阇岭，联询劫烬灰。",
        "持花龙女至，献菓象王来。",
        "讲坐真乘阐，谈筵外法催。",
        "方希除八难，从此涤三灾。"
      ],
      "author": {
        "id": 289,
        "name": "王绩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 302284,
      "title": "观石壁诸龛礼拜成咏",
      "content": [
        "万里疏烟壁，千龛对日宫。",
        "瞻颜犹不暇，合掌更难穷。",
        "岭路横携断，山心暗凿通。",
        "真如何处泊？",
        "坐费计人功。"
      ],
      "author": {
        "id": 289,
        "name": "王绩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 302285,
      "title": "久客斋府病归言志",
      "content": [
        "君王[邸茅]（据李抄本补）宽，[修]（行）竹正檀栾。",
        "搆山临下杜，穿渠入上兰。",
        "天人多晏喜，宾宷盛鹓鸾。",
        "玉舄镇花簟，金环□果盘。",
        "鬭鸡新市望，走马章台看。",
        "别有恩光重，恒嗟报答难。",
        "沉绵赴漳浦，羁旅别长安。",
        "玄渚芦花白，黄山梨叶丹。",
        "故人傥相念，应知归路寒。"
      ],
      "author": {
        "id": 289,
        "name": "王绩"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 302286,
      "title": "秋园夜坐",
      "content": [
        "秋来木叶黄，半夜坐林塘。",
        "浅溜含新冻，轻云护早霜。",
        "落萤飞未起，惊鸟乱无行。",
        "寂寞知何事？",
        "东篱菊稍芳。",
        "（以上二十八首均见北京图馆藏清陈氏晚晴轩钞本五卷本《王无功文集》卷三。",
        "此本承郑永晓同志抄示。",
        "另参校之李抄本，即东武李氏研录山房钞本，转引自韩理洲同志校点本《王无功文集》）（五卷本会校）。",
        "）（按：《王无功文集》五卷本所录王绩诗题，有几首与《全唐诗》所录者有较大不同，录如次：《夜还东溪中口号》，《全唐诗》作《夜还东溪》；《题黄颊山壁》，《全唐诗》作《黄颊山》；《山中别李处士播》，《全唐诗》缺「播」字；《秋夜喜遇姚处士义》，《全唐诗》作《秋夜喜遇王处士》；《过山观寻苏道士不见题壁四首》，《全唐诗》作《游仙四首》；《卢新平宅赋古题得策杖寻隐士》，《全唐诗》仅作《策杖寻隐士》；《裴仆射宅咏妓》，《全唐诗》作《咏妓》。"
      ],
      "author": {
