{
  "data": [
    {
      "id": 361646,
      "title": "送沈鹤",
      "content": [
        "家楚婿于秦，携妻云养亲。",
        "陆行千里外，风卷一帆新。",
        "夜泊疏山雨，秋吟捣药轮。",
        "芜城登眺作，才动广陵人。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 361647,
      "title": "秋夜仰怀钱孟二公琴客会",
      "content": [
        "月色四时好，秋光君子知。",
        "南山昨夜雨，为我写清规。",
        "独鹤耸寒骨，高杉韵细飔。",
        "仙家缥缈弄，仿佛此中期。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 361648,
      "title": "赠李金州",
      "content": [
        "绮里祠前后，山程践白云。",
        "溯流随大旆，登岸见全军。",
        "晓角吹人梦，秋风卷雁群。",
        "雾开方露日，汉水底沙分。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 361650,
      "title": "送独孤马二秀才居明月山读书",
      "content": [
        "濯志俱高洁，儒科慕冉颜。",
        "家辞临水郡，雨到读书山。",
        "栖鸟棕花上，声钟砾阁间。",
        "寂寥窗户外，时见一舟还。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 361651,
      "title": "病蝉",
      "content": [
        "病蝉飞不得，向我掌中行。",
        "拆翼犹能薄，酸吟尚极清。",
        "露华凝在腹，尘点误侵睛。",
        "黄雀并鸢鸟，俱怀害尔情。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 361652,
      "title": "青门里作",
      "content": [
        "燕存鸿已过，海内几人愁。",
        "欲问南宗理，将归北岳修。",
        "若无攀桂分，只是卧云休。",
        "泉树一为别，依稀三十秋。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 361654,
      "title": "寄李辀侍郎",
      "content": [
        "终过盟津书，分明梦不虚。",
        "人从清渭别，地隔太行余。",
        "宾幕谁嫌静，公门但晏如。",
        "櫑鞞干霹雳，斜汉湿蟾蜍。",
        "追琢垂今后，敦庞得古初。",
        "井台怜操筑，漳岸想丕疏。",
        "亦翼铿瑉佩，终当直石渠。",
        "此身多抱疾，幽里近营居。",
        "忆漱苏门涧，经浮楚泽潴。",
        "松栽侵古影，荤断尚芹菹。",
        "语嘿曾延接，心源离滓淤。",
        "谁言姓琴氏，独跨角生鱼。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361655,
      "title": "寄令狐绹相公",
      "content": [
        "驴骏胜羸马，东川路匪赊。",
        "一缄论贾谊，三蜀寄严家。",
        "澄澈霜江水，分明露石沙。",
        "话言声及政，栈阁谷离斜。",
        "自著衣偏暖，谁忧雪六花。",
        "裹裳留阔幞，防患与通茶。",
        "山馆中宵起，星河残月华。",
        "双僮前日雇，数口向天涯。",
        "良乐知骐骥，张雷验镆铘。",
        "谦光贤将相，别纸圣龙蛇。",
        "岂有斯言玷，应无白璧瑕。",
        "不妨圆魄里，人亦指虾蟆。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361658,
      "title": "过杨道士居",
      "content": [
        "先生修道处，茆屋远嚣氛。",
        "叩齿坐明月，支颐望白云。",
        "精神含药色，衣服带霞纹。",
        "无话瀛洲路，多年别少君。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 361660,
      "title": "送友人游塞",
      "content": [
        "飘蓬多塞下，君见益潸然。",
        "迥碛沙衔日，长河水接天。",
        "夜泉行客火，晓戍向京烟。",
        "少结相思恨，佳期芳草前。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 361664,
      "title": "和孟逸人林下道情",
      "content": [
        "四气相陶铸，中庸道岂销。",
        "夏云生此日，春色尽今朝。",
        "陋巷贫无闷，毗耶疾未调。",
        "已栽天末柏，合抱岂非遥。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 361665,
      "title": "宿姚少府北斋",
      "content": [
        "石溪同夜泛，复此北斋期。",
        "鸟绝吏归后，蛩鸣客卧时。",
        "锁城凉雨细，开印曙钟迟。",
        "忆此漳川岸，如今是别离。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 361668,
      "title": "寄朱锡珪",
      "content": [
        "远泊与谁同，来从古木中。",
        "长江人钓月，旷野火烧风。",
        "梦泽吞楚大，闽山厄海丛。",
        "此时樯底水，涛起屈原通。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 361669,
      "title": "马戴居华山因寄",
      "content": [
        "玉女洗头盆，孤高不可言。",
        "瀑流莲岳顶，河注华山根。",
        "绝雀林藏鹘，无人境有猿。",
        "秋蟾才过雨，石上古松门。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 361670,
      "title": "寄胡遇",
      "content": [
        "一自残春别，经炎复到凉。",
        "萤从枯树出，蛩入破阶藏。",
        "落叶书胜纸，闲砧坐当床。",
        "东门因送客，相访也何妨。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 361672,
      "title": "送孙逸人",
      "content": [
        "衣屡犹同俗，妻儿亦宛然。",
        "不餐能累月，无病已多年。",
        "是药皆谙性，令人渐信仙。",
        "杖头书数卷，荷入翠微烟。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 361674,
      "title": "送李登少府",
      "content": [
        "伊阳耽酒尉，朗咏醉醒新。",
        "应见嵩山里，明年踯躅春。",
        "一千寻树直，三十六峰邻。",
        "流水潺潺处，坚贞玉涧瑉。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 361676,
      "title": "酬鄠县李廓少府见寄",
      "content": [
        "稍怜公事退，复遇夕阳时。",
        "北朔霜凝竹，南山水入篱。",
        "吟怀沧海侣，空问白云师。",
        "恨不相从去，心惟野鹤知。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 361677,
      "title": "净业寺与前鄠县李廓少府同宿",
      "content": [
        "来从城上峰，京寺暮相逢。",
        "往往语复默，微微雨洒松。",
        "家贫初罢吏，年长畏闻蛩。",
        "前日犹拘束，披衣起晓钟。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 361678,
      "title": "送南卓归京",
      "content": [
        "残春别镜陂，罢郡未霜髭。",
        "行李逢炎暑，山泉满路岐。",
        "云藏巢鹤树，风触啭莺枝。",
        "三省同虚位，双旌带去思。",
        "入城宵梦后，待漏月沉时。",
        "长策并忠告，从容写玉墀。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361679,
      "title": "卧疾走笔酬韩愈书问",
      "content": [
        "一卧三四旬，数书惟独君。",
        "愿为出海月，不作归山云。",
        "身上衣频寄，瓯中物亦分。",
        "欲知强健否，病鹤未离群。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 361682,
      "title": "郑尚书新开涪江二首",
      "content": [
        "岸凿青山破，江开白浪寒。",
        "日沉源出海，春至草生滩。",
        "梓匠防波溢，蓬仙畏水干。",
        "从今疏决后，任雨滞峰峦。",
        "不侵南亩务，已拔北江流。",
        "涪水方移岸，浔阳有到舟。",
        "潭澄初捣药，波动乍垂钩。",
        "山可疏三里，从知历亿秋。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361685,
      "title": "送蔡京",
      "content": [
        "跃蹄归鲁日，带漏别秦星。",
        "易折芳条桂，难穷邃义经。",
        "登封多泰岳，巡狩遍沧溟。",
        "家在何林下，梁山翠满庭。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 361688,
      "title": "送黄知新归安南",
      "content": [
        "池亭沉饮遍，非独曲江花。",
        "地远路穿海，春归冬到家。",
        "火山难下雪，瘴土不生茶。",
        "知决移来计，相逢期尚赊。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 361691,
      "title": "重与彭兵曹",
      "content": [
        "故人在城里，休寄海边书。",
        "渐去老不远，别来情岂疏。",
        "砚冰催腊日，山雀到贫居。",
        "每有平戎计，官家别敕除。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 361692,
      "title": "赠庄上人",
      "content": [
        "不语焚香坐，心知道已成。",
        "流年衰此世，定力见他生。",
        "暮雪余春冷，寒灯续昼明。",
        "寻常五侯至，敢望下阶迎。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 361696,
      "title": "喜雍陶至",
      "content": [
        "今朝笑语同，几日百忧中。",
        "鸟度剑门静，蛮归泸水空。",
        "步霜吟菊畔，待月坐林东。",
        "且莫孤此兴，勿论穷与通。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 361700,
      "title": "寄韩湘",
      "content": [
        "过岭行多少，潮州涨满川。",
        "花开南去后，水冻北归前。",
        "望鹭吟登阁，听猿泪滴船。",
        "相思堪面话，不著尺书传。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 361703,
      "title": "寄毗陵彻公",
      "content": [
        "身依吴寺老，黄叶几回看。",
        "早讲林霜在，孤禅隙月残。",
        "井通潮浪远，钟与角声寒。",
        "已有南游约，谁言礼谒难。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 361705,
      "title": "寄刘侍御",
      "content": [
        "衣多苔藓痕，犹拟更趋门。",
        "自夏虽无病，经秋不过原。",
        "积泉留岱鸟，叠岫隔巴猿。",
        "琴月西斋集，如今岂复言。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 361706,
      "title": "送穆少府知眉州",
      "content": [
        "剑门倚青汉，君昔未曾过。",
        "日暮行人少，山深异鸟多。",
        "猿啼和峡雨，栈尽到江波。",
        "一路白云里，飞泉洒薜萝。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 361711,
      "title": "宿山寺",
      "content": [
        "众岫耸寒色，精庐向此分。",
        "流星透疏木，走月逆行云。",
        "绝顶人来少，高松鹤不群。",
        "一僧年八十，世事未曾闻。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 361713,
      "title": "题竹谷上人院",
      "content": [
        "禅庭高鸟道，回望极川原。",
        "樵径连峰顶，石泉通竹根。",
        "木深犹积雪，山浅未闻猿。",
        "欲别尘中苦，愿师贻一言。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 361720,
      "title": "蒋亭和蔡湘州",
      "content": [
        "蒋宅为亭榭，蔡城东郭门。",
        "潭连秦相井，松老汉朝根。",
        "已积苍苔遍，何曾旧径存。",
        "高斋无事后，时复一携尊。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 361721,
      "title": "光州王建使君水亭作",
      "content": [
        "楚水临轩积，澄鲜一亩余。",
        "柳根连岸尽，荷叶出萍初。",
        "极浦清相似，幽禽到不虚。",
        "夕阳庭际眺，槐雨滴疏疏。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 361724,
      "title": "哭张籍",
      "content": [
        "精灵归恍惚，石磬韵曾闻。",
        "即日是前古，谁人耕此坟。",
        "旧游孤棹远，故域九江分。",
        "本欲蓬瀛去，餐芝御白云。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 361727,
      "title": "送玄岩上人归西蜀",
      "content": [
        "玉垒山中寺，幽深胜概多。",
        "药成彭祖捣，顶受七轮摩。",
        "去腊催今夏，流光等逝波。",
        "会当依粪扫，五岳遍头陀。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 361728,
      "title": "寄宋州田中丞",
      "content": [
        "古郡近南徐，关河万里余。",
        "相思深夜后，未答去秋书。",
        "自别知音少，难忘识面初。",
        "旧山期已久，门掩数畦蔬。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 361729,
      "title": "送朱休归剑南",
      "content": [
        "剑南归受贺，太学赋声雄。",
        "山路长江岸，朝阳十月中。",
        "芽新抽雪茗，枝重集猿枫。",
        "卓氏琴台废，深芜想径通。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 361731,
      "title": "送皇甫侍御",
      "content": [
        "晓钟催早期，自是赴嘉招。",
        "舟泊湘江阔，田收楚泽遥。",
        "雁惊起衰草，猿渴下寒条。",
        "来使黔南日，时应问寂寥。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 361734,
      "title": "喜李余自蜀至",
      "content": [
        "迢递岷峨外，西南驿路高。",
        "几程寻崄栈，独宿听寒涛。",
        "白鸟飞还立，青猿断更号。",
        "往来从此过，词体近风骚。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 361738,
      "title": "寄魏少府",
      "content": [
        "来时乖面别，终日使人惭。",
        "易记卷中句，难忘灯下谈。",
        "湿苔粘树瘿，瀑布溅房庵。",
        "音信如相惠，移居古井南。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 361739,
      "title": "原居即事言怀赠孙员外",
      "content": [
        "出入土门偏，秋深石色泉。",
        "径通原上草，地接水中莲。",
        "采菌依余枿，拾薪逢刈田。",
        "镊挦白发断，兵阻尺书传。",
        "避路来华省，抄诗上彩笺。",
        "高斋久不到，犹喜未经年。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361740,
      "title": "登楼",
      "content": [
        "秋日登高望，凉风吹海初。",
        "山川明已久，河汉没无余。",
        "远近涯寥夐，高低中太虚。",
        "赋因王阁笔，思比谢游疏。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 361742,
      "title": "昆明池泛舟",
      "content": [
        "一枝青竹榜，泛泛绿萍里。",
        "不见钓鱼人，渐入秋塘水。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 361746,
      "title": "送饶州张使君",
      "content": [
        "终南云雨连城阙，去路西江白浪头。",
        "滁上郡斋离昨日，",
        "借问泊帆干谒者，谁人曾听峡猿愁。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361747,
      "title": "观冬设上东川杨尚书",
      "content": [
        "匏革奏冬非独乐，军城未晓启重门。",
        "何时却入三台贵，",
        "逐迁属吏随宾列，拨棹扁舟不忘恩。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361748,
      "title": "巴兴作",
      "content": [
        "三年未省闻鸿叫，九月何曾见草枯。",
        "寒暑气均思白社，",
        "乡味朔山林果别，北归期挂海帆孤。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361749,
      "title": "早蝉",
      "content": [
        "早蝉孤抱芳槐叶，噪向残阳意度秋。",
        "也任一声催我老，",
        "若问此心嗟叹否，天人不可怨而尤。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361750,
      "title": "投元郎中",
      "content": [
        "心在潇湘归未期，卷中多是得名诗。",
        "高台聊望清秋色，",
        "旧文去岁曾将献，蒙与人来说始知。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361753,
      "title": "送陕府王建司马",
      "content": [
        "司马虽然听晓钟，尚犹高枕恣疏慵。",
        "请诗僧过三门水，",
        "杜陵惆怅临相饯，未寝月前多屐踪。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361754,
      "title": "上谷旅夜",
      "content": [
        "世难那堪恨旅游，龙钟更是对穷秋。",
        "故园千里数行泪，",
        "此心不向常人说，倚识平津万户侯。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361755,
      "title": "寄无得头陀",
      "content": [
        "夏腊今应三十余，不离树下冢间居。",
        "貌堪良匠抽毫写，",
        "白衣只在青门里，心每相亲迹且疏。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361756,
      "title": "崔卿池上双白鹭",
      "content": [
        "鹭雏相逐出深笼，顶各有丝茎数同。",
        "洒石多霜移足冷，",
        "见此池潭卿自凿，清泠太液底潜通。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361757,
      "title": "送胡道士",
      "content": [
        "短褐身披满渍苔，灵溪深处观门开。",
        "却从城里移琴去，",
        "丹梯愿逐真人上，日夕归心白发催。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361758,
      "title": "寄韩潮州愈",
      "content": [
        "此心曾与木兰舟，直到天南潮水头。",
        "隔岭篇章来华岳，",
        "一夕瘴烟风卷尽，月明初上浪西楼。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361759,
      "title": "酬张籍王建",
      "content": [
        "疏林荒宅古坡前，久住还因太守怜。",
        "渐老更思深处隐，",
        "身是龙钟应是分，水曹芸阁枉来篇。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361760,
      "title": "逢博陵故人彭兵曹",
      "content": [
        "曲阳分散会京华，见说三年住海涯。",
        "别后解餐蓬蔂子，",
        "蹋雪携琴相就宿，夜深开户斗牛斜。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361761,
      "title": "赠牛山人",
      "content": [
        "二十年中饵茯苓，致书半是老君经。",
        "东都旧住商人宅，",
        "古来隐者多能卜，欲就先生问丙丁。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361762,
      "title": "送于中丞使回纥册立",
      "content": [
        "君立天骄发使车，册文字字著金书。",
        "渐通青冢乡山尽，",
        "旌旗来往几多日，应向途中见岁除。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361763,
      "title": "送刘侍御重使江西",
      "content": [
        "时当苦热远行人，石壁飞泉溅马身。",
        "又到钟陵知务大，",
        "前者已闻廉使荐，兼言有画静边尘。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361764,
      "title": "赠圆上人",
      "content": [
        "诵经千纸得为僧，麈尾持行不拂蝇。",
        "古塔月高闻咒水，",
        "且说近来心里事，仇雠相对似亲朋。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361765,
      "title": "处州李使君改任遂州因寄赠",
      "content": [
        "庭树几株阴入户，主人何在客闻蝉。",
        "钥开原上高楼锁，",
        "仙都山水谁能忆，西去风涛书满船。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361766,
      "title": "酬慈恩寺文郁上人",
      "content": [
        "袈裟影入禁池清，犹忆乡山近赤城。",
        "篱落罅间寒蟹过，",
        "闻说又寻南岳去，无端诗思忽然生。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361767,
      "title": "访鉴玄师侄",
      "content": [
        "维摩青石讲初休，缘访亲宗到普州。",
        "我有军持凭弟子，岳阳溪里汲寒流。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 361772,
      "title": "送于总持归京",
      "content": [
        "出家初隶何方寺，上国西明御水东。",
        "却见旧房阶下树，别来二十一春风。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 361773,
      "title": "崔卿池上鹤",
      "content": [
        "月中时叫叶纷纷，不异洞庭霜夜闻。",
        "翎羽如今从放长，犹能飞起向孤云。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 361780,
      "title": "酬姚合",
      "content": [
        "黍穗豆苗侵古道，晴原午后早秋时。",
        "故人相忆僧来说，杨柳无风蝉满枝。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 361783,
      "title": "渡桑干",
      "content": [
        "客舍并州已十霜，归心日夜忆咸阳。",
        "无端更渡桑干水，却望并州是故乡。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 361788,
      "title": "早秋寄题天竺灵隐寺",
      "content": [
        "峰前峰后寺新秋，绝顶高窗见沃洲。",
        "人在定中闻蟋蟀，",
        "心忆悬帆身未遂，谢公此地昔年游。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361789,
      "title": "黎阳寄姚合",
      "content": [
        "魏都城里曾游熟，才子斋中止泊多。",
        "去日绿杨垂紫陌，",
        "惆怅心思滑台北，满杯浓酒与愁和。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361790,
      "title": "送崔约秀才",
      "content": [
        "归宁仿佛三千里，月向船窗见几宵。",
        "野鼠独偷高树果，",
        "重入石头城下寺，南朝杉老未干燋。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361791,
      "title": "咏怀",
      "content": [
        "纵把书看未省勤，一生生计只长贫。",
        "可能在世无成事，",
        "经年抱疾谁来问，野鸟相过啄木频。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361792,
      "title": "夏日寄高洗马",
      "content": [
        "三十年来长在客，两三行泪忽然垂。",
        "白衣苍鬓经过懒，",
        "不缘马死西州去，画角堪听是晓吹。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361793,
      "title": "送周判官元范赴越",
      "content": [
        "原下相逢便别离，蝉鸣关路使回时。",
        "过淮渐有悬帆兴，",
        "已曾几遍随旌旆，去谒荒郊大禹祠。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361794,
      "title": "送罗少府归牛渚",
      "content": [
        "作尉长安始三日，忽思牛渚梦天台。",
        "楚山远色独归去，",
        "白云多处应频到，寒涧泠泠漱古苔。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361795,
      "title": "题童真上人",
      "content": [
        "江上修持积岁年，滩声未拟住潺湲。",
        "誓从五十身披衲，",
        "昨宵忽梦游沧海，万里波涛在目前。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361796,
      "title": "赠温观主",
      "content": [
        "一别罗浮竟未还，观深廊古院多关。",
        "君来几日行虚洞，",
        "弊庐道室虽邻近，自乐冬阳炙背闲。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361797,
      "title": "贺庞少尹除太常少卿",
      "content": [
        "太白山前终日见，十旬假满拟秋寻。",
        "中峰绝顶非无路，",
        "省中石镫陪随步，唯赏烟霞不厌深。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361798,
      "title": "上邠宁刑司徒",
      "content": [
        "箭头破帖浑无敌，杖底敲球远有声。",
        "马走千蹄朝万乘，",
        "不是邢公来镇此，长安西北未能行。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361799,
      "title": "欲游嵩岳留别李少尹益",
      "content": [
        "孤策迟回洛水湄，孤禽嘹唳幸人知。",
        "嵩岳望中常待我，",
        "微眇此来将敢问，凤凰何日定归池。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361800,
      "title": "病鹘吟",
      "content": [
        "俊鸟还投高处栖，腾身戛戛下云梯。",
        "有时透雾凌空去，",
        "不缘毛羽遭零落，焉肯雄心向尔低。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361801,
      "title": "赠僧",
      "content": [
        "从来多是游山水，省泊禅舟月下涛。",
        "初过石桥年尚少，",
        "常恐画工援笔写，身长七尺有眉毫。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361802,
      "title": "赠翰林",
      "content": [
        "清重无过知内制，从前礼绝外庭人。",
        "看花在处多随驾，",
        "应怜独向名场苦，曾十余年浪过春。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361803,
      "title": "颂德上贾常侍",
      "content": [
        "边臣说使朝天子，发语轰然激夏雷。",
        "高节羽书期独传，",
        "自顾此身无所立，恭谈祖德朵颐开。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361804,
      "title": "田将军书院",
      "content": [
        "满庭花木半新栽，石自平湖远岸来。",
        "笋迸邻家还长竹，",
        "行背曲江谁到此，琴书锁著未朝回。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361805,
      "title": "投庞少尹",
      "content": [
        "闭户息机搔白首，中庭一树有清阴。",
        "年年不改风尘趣，",
        "庞公相识元和岁，眷分依依直至今。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361806,
      "title": "夏夜登南楼",
      "content": [
        "水岸寒楼带月跻，夏林初见岳阳溪。",
        "一点新萤报秋信，不知何处是菩提。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 361809,
      "title": "题虢州三堂赠吴郎中",
      "content": [
        "无穷草树昔谁栽，新起临湖白石台。",
        "半岸泥沙孤鹤立，",
        "昨夜北楼堪朗咏，虢城初锁月裴回。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361829,
      "title": "题郑常侍厅前竹",
      "content": [
        "绿竹临诗酒，婵娟思不穷。",
        "乱枝低积雪，繁叶亚寒风。",
        "萧飒疑泉过，萦回有径通。",
        "侵庭根出土，隔壁笋成丛。",
        "疏影纱窗外，清音宝瑟中。",
        "卷帘终日看，欹枕几秋同。",
        "万顷歌王子，千竿伴阮公。",
        "露光怜片片，雨润爱蒙蒙。",
        "嶰谷蛮湖北，湘川灀水东。",
        "何如轩槛侧，苍翠袅长空。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361831,
      "title": "送人南归",
      "content": [
        "分手向天涯，迢迢泛海波。",
        "虽然南地远，见说北人多。",
        "山暖花常发，秋深雁不过。",
        "炎方饶胜事，此去莫蹉跎。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 361832,
      "title": "送人南游",
      "content": [
        "此别天涯远，孤舟泛海中。",
        "夜行常认火，帆去每因风。",
        "蛮国人多富，炎方语不同。",
        "雁飞难度岭，书信若为通。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 361835,
      "title": "清明日园林寄友人",
      "content": [
        "今日清明节，园林胜事偏。",
        "晴风吹柳絮，新火起厨烟。",
        "杜草开三径，文章忆二贤。",
        "几时能命驾，对酒落花前。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 361836,
      "title": "上杜驸马",
      "content": [
        "玉山突兀压乾坤，出得朱门入戟门。",
        "妻是九重天子女，",
        "今日澧阳非久驻，伫为霖雨拜新恩。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361837,
      "title": "莲峰歌",
      "content": [
        "锦砾潺湲玉溪水，晓来微雨藤花紫。",
        "冉冉山鸡红尾长，",
        "阳崖一梦伴云根，仙菌灵芝梦魂里。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361843,
      "title": "送友人之南陵",
      "content": [
        "莫叹徒劳向宦途，不群气岸有谁如。",
        "南陵暂掌仇香印，",
        "少年跃马同心使，免得诗中道跨驴。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 371902,
      "title": "过海联句",
      "content": [
        "沙鸟浮还没，山云断复连。",
        "——高丽使",
        "棹穿波底月，船压水中天。",
        "——贾岛"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    }
  ],
