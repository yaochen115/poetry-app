{
  "data": [
    {
      "id": 176904,
      "title": "双井茶寄赠范景仁",
      "content": [
        "春睡无端巧逐人，驱诃不去苦相亲。",
        "欲凭洪井真茶力，试遣刀圭报谷神。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 176905,
      "title": "送王殿丞西京签判",
      "content": [
        "清白世风存，王公复有孙。",
        "挺生如玉树，不竭似淮源。",
        "日背嵩峰紫，春添洛水喧。",
        "幕中多胜友，肯使负芳樽。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176906,
      "title": "和子渊元夕",
      "content": [
        "神岳嶕峣阙角齐，银蟾无影玉绳低。",
        "风传丝管交加发，灯滉星河上下迷。",
        "清醴横飞金凿落，香尘不染锦障泥。",
        "谁知此夕斋祠客，近在宫城槐柳西。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 176907,
      "title": "送谢都官知光化军",
      "content": [
        "廐吏整车马，匆匆办晓装。",
        "青緺出阊阖，朱斾指沧浪。",
        "野店杏初发，津亭柳已黄。",
        "行行不可驻，犹及劝耕桑。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176908,
      "title": "送仲更归泽州",
      "content": [
        "太行横拥巨川回，三晋由来产异才。",
        "展墓乘春走乡陌，负书拂晓下兰台。",
        "河阳路侧花应合，天井关头雪未开。",
        "会使乡人惊六印，莫羞今日弊裘来。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 176909,
      "title": "二月二日太常致斋晨起呈景仁次道二同舍",
      "content": [
        "官舍春萧瑟，朝来尚薄寒。",
        "人虽繁陌上，尘不近门端。",
        "已负踏青约，仍无举白欢。",
        "凭君御沟上，试折柳条看。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176910,
      "title": "送刘观察知洺州",
      "content": [
        "汉家英俊士，衮衮出金阊。",
        "久袭通侯籍，新腰太守章。",
        "畛封连故赵，庐井带清漳。",
        "春色迎铙吹，应忘道路长。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176911,
      "title": "寒食御筵口号二首  其一",
      "content": [
        "雨意沉沉泼火余，夔龙盛集退朝初。",
        "酒殽络绎来丹禁，冠剑参差下玉除。",
        "紫凤归飞云烂漫，黄鹂新啭柳扶疏。",
        "麦禾满野边烽息，佳节何妨赋乐胥。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 176912,
      "title": "寒食御筵口号二首  其二",
      "content": [
        "圣主褒优鼎轴臣，金觞玉醴照青春。",
        "万家烟火朝来静，九陌风光雨后新。",
        "高燕翔飞惊紫绶，余光点缀托朱轮。",
        "问牛因得观民俗，不独嬉游惜令辰。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 176913,
      "title": "致政杨侍郎挽歌  其一",
      "content": [
        "时论归清德，皇心重老臣。",
        "祖风终鲠直，家学本深淳。",
        "便殿谈经久，安车就第新。",
        "如何金未尽，奄忽弃乡人。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176914,
      "title": "致政杨侍郎挽歌  其二",
      "content": [
        "忧国心如石，当朝有古风。",
        "挂冠虽在远，遗札不忘忠。",
        "飞旐西归洛，新阡背倚嵩。",
        "还令往来客，下马白杨中。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176915,
      "title": "送晁校理知怀州",
      "content": [
        "鸡犬相闻桑柘春，风光明润帝乡邻。",
        "群峰斜转太行角，万谷同趋马颊津。",
        "簪组倾都邀别袂，壶浆满路候行尘。",
        "非君厌薄承明直，天子方今重治人。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 176916,
      "title": "席上赋得榛",
      "content": [
        "微物生山泽，萧条荆棘邻。",
        "何人掇秋实，此日待嘉宾。",
        "虽无木桃赠，投此寄情亲。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 176917,
      "title": "二月三十日与同舍宴李氏园晚归马上赋诗",
      "content": [
        "门前蹀躞金羁满，坐上连翩玉斚飞。",
        "数尺游丝留客醉，一行垂柳送人归。",
        "同邀胜友时难得，重到名园花已稀。",
        "莫惜芳辰剩行乐，无端风雨横相违。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 176918,
      "title": "送师道知长溪因归觐省",
      "content": [
        "羁旅帝城久，逢人青眼稀。",
        "闻君又当去，使我益思归。",
        "佳色邻乡树，高堂望彩衣。",
        "春流先自疾，心出片帆飞。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176919,
      "title": "双竹诗",
      "content": [
        "上苑通丹禁，修林绕玉堂。",
        "周阿纡镂槛，并干擢新篁。",
        "萧洒骈瑶甃，连翩拂璧珰。",
        "虬腾双角直，鲸喷两须长。",
        "晓泊烟华重，晴留雨气凉。",
        "分音成律吕，齐秀待鸾凰。",
        "碧借云霞润，清依日月光。",
        "物情知有谓，天造固无方。",
        "比节群诚合，虚心至道彰。",
        "吾君愈勤德，不敢有嘉祥。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 176920,
      "title": "和次道奉慈斋宫见寄",
      "content": [
        "去住邈如霄与尘，依依欲别更相亲。",
        "虽知洛邑饶英俊，莫忘斋庐并直人。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 176921,
      "title": "送次道通判西京",
      "content": [
        "相府新承檄，兰台旧校文。",
        "题舆荣得士，把袂惜离群。",
        "首夏郊原秀，晴阳草树曛。",
        "觚棱日边远，关塞雾中分。",
        "翠岭林端出，飞泉竹外闻。",
        "金羁游烂熳，珠履醉缤纷。",
        "人服声光重，官无薄领勤。",
        "归期肯留滞，汉主待渊云。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 176922,
      "title": "送刘仪先辈大名尉",
      "content": [
        "潭潭相府开，旌骑拥三台。",
        "闻道廷中吏，无非天下才。",
        "策名新振拔，把板尚低回。",
        "勿为卑飞困，青冥尽此来。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176923,
      "title": "送皇甫寺丞知蓝田县",
      "content": [
        "南山三辅剧，百里古诸侯。",
        "谁为弦歌小，不分宵旰忧。",
        "烟横辋川暝，云照武关秋。",
        "安得无羁束，从君一纵游。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176924,
      "title": "酬次道板桥晚望见寄",
      "content": [
        "春来曾约醉河桥，深负垂杨千万条。",
        "今日都门相望处，西风乱叶正萧萧。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 176925,
      "title": "送祁峤颍阳主簿",
      "content": [
        "苍山临县郭，云木冷萧骚。",
        "人有渔樵乐，官无簿领劳。",
        "垂天起肤寸，合抱本纤毫。",
        "志意诚修立，归飞羽翼高。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176926,
      "title": "送李尉以监丞致仕归闽中",
      "content": [
        "行行歌式微，浩叹返荆扉。",
        "却著登山屐，尽焚趋府衣。",
        "溪清鱼影乱，竹暗笋牙肥。",
        "应悔浮名误，空将白髪归。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176927,
      "title": "和伯镇再入馆",
      "content": [
        "甘泉献赋人，流落浙江滨。",
        "自叹三年谪，归来万事新。",
        "铨衡时进对，户牖日相亲。",
        "明主方思贾，非徒问鬼神。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176928,
      "title": "和同舍对菊无酒",
      "content": [
        "黄花倚秋色，晔晔为谁开。",
        "更使窥残榼，空令洗旧杯。",
        "嗅香行缭绕，撚蘂立徘徊。",
        "尽日柴门外，白衣来不来。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176929,
      "title": "文太师挽歌三首  其一",
      "content": [
        "汾晋地形美，古今多巨贤。",
        "况承勋烈后，宜有庆灵传。",
        "著位登朝古，声华出众先。",
        "起家从此始，圭组遂蝉联。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176930,
      "title": "文太师挽歌三首  其二",
      "content": [
        "美化流民物，薰然遗爱多。",
        "栾公当日社，邵父至今歌。",
        "庭有三鳣集，门容驷马过。",
        "欲知余庆在，公鼎格平和。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176931,
      "title": "文太师挽歌三首  其三",
      "content": [
        "夏屋封何处，山田有卧牛。",
        "蟠根走伊水，回首负嵩丘。",
        "忠孝家风备，哀荣礼秩优。",
        "龙鸾舞宸翰，万古照松楸。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176932,
      "title": "送李祠部知滑州",
      "content": [
        "东郡堤繇苦，向来烟火疏。",
        "提封百里远，生齿万家余。",
        "贤守车才下，疲人意已纾。",
        "行闻谣五袴，京廪满郊墟。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176933,
      "title": "和王道粹垂拱早朝王范二直阁班列在前戏成小诗",
      "content": [
        "霁日扶霜仗，祥烟覆晓班。",
        "帝居回北斗，天阙竦南山。",
        "紫殿鸿鸾肃，金门虎豹环。",
        "蓬莱两仙伯，迥立白云间。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176934,
      "title": "答刘邍父贺庞公惠炭",
      "content": [
        "东郭先生履半穿，御冬深愧主人贤。",
        "应怜道上雪欲积，意使炉中灰复然。",
        "曲糵暗添寒酒力，图书共免湿薪烟。",
        "茅斋斗似饶光彩，客至何忧腊后天。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 176935,
      "title": "送田校理知晋州",
      "content": [
        "铨筦萃贤豪，夫君主剧曹。",
        "长才沛余裕，众论蔚推高。",
        "逮此分符贵，知无顿刃劳。",
        "公卿如有缺，不独赐金褒。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176936,
      "title": "正月三日与广渊同出南薫门分趋斋宫涂中有作",
      "content": [
        "并辔出都门，葱茏日欲昕。",
        "野寒余宿雪，树暗湿春云。",
        "未望郊宫近，先愁马首分。",
        "一朝犹恋恋，可复久离群。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176937,
      "title": "寄题常州东山亭二首  其一",
      "content": [
        "谢傅英声高可攀，结茅积土想东山。",
        "常忧胜概一朝尽，岂信风流千古还。",
        "麈尾蒲葵供永日，酒樽棋局奉欢颜。",
        "贤侯心迹遥相望，不使兰陵风月闲。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 176938,
      "title": "寄题常州东山亭二首  其二",
      "content": [
        "阀阅崔嵬动四方，入门鸾鹤自成行。",
        "青緺旧已临佳郡，墨客新归耀故乡。",
        "醉舞几应摧屐齿，对棋正欲赌香囊。",
        "阶庭玉树寒相照，更使东山逸气长。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 176939,
      "title": "送人为闽宰",
      "content": [
        "万里东瓯外，溪山秀出群。",
        "乡人皆嗜学，太守复工文。",
        "正用慈良化，居无牒诉纷。",
        "谁云远京国，佳政日相闻。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176940,
      "title": "送才元守广安军归成都觐省",
      "content": [
        "皂盖五骅骝，今来异昔游。",
        "箪壶交里舍，铙吹下瀛州。",
        "寿酒行当举，归鞭不可留。",
        "春光久相待，先在锦江头。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176941,
      "title": "送上雒王推官",
      "content": [
        "墨绶百里宰，红蕖幕府僚。",
        "民淳无鬬辩，地胜得逍遥。",
        "日上云未散，春深雪不消。",
        "知音已交荐，勿茹紫芝苗。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176942,
      "title": "送瀛州签判苏秘丞",
      "content": [
        "高阳十万兵，幕府藉时英。",
        "塞上风犹劲，关南春未生。",
        "投壶边柝静，倚马檄书成。",
        "不忘尘中客，征鸿可寄声。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176943,
      "title": "和宋次道西都元日怀不疑并见寄",
      "content": [
        "露冕优分竹，题舆佐画圻。",
        "比年携手乐，兹日赏心违。",
        "斋祀春来并，娱游别后稀。",
        "谁怜从窭卒，草际犯寒归。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176944,
      "title": "王金吾北园",
      "content": [
        "丞相后园天籞邻，年年分借上林春。",
        "目前但识禽鱼乐，门外何妨车马尘。",
        "花蘤祗疑名品尽，图书方验古今贫。",
        "将军朝下无余事，端为风烟作主人。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 176945,
      "title": "二月二十四日馆宿兴宗舍后桃花盛开偶书牖上",
      "content": [
        "金马春寂寂，秾桃随意开。",
        "夕风零落尽，不待主人来。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 176946,
      "title": "送周寺丞畋知洛南",
      "content": [
        "太华指商于，中间百里余。",
        "稍行山驿远，渐与世尘疏。",
        "楚塞参差接，秦民错杂居。",
        "惜哉非綮肯，不足试投虚。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176947,
      "title": "送齐学士知荆南",
      "content": [
        "汉家太守治才高，楚国山川气象豪。",
        "旗斾逶迤蟠梦泽，楼船赑屭压江涛。",
        "雄名谁复知宣武，遗爱犹应祀叔敖。",
        "何必三年求奏计，诏书朝夕赐金褒。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 176948,
      "title": "送王待制知陜府",
      "content": [
        "畴昔诚相契，间关分不渝。",
        "绝弦悲宿草，抚首念诸孤。",
        "位略尊荣间，年忘德齿殊。",
        "清阴容息足，重语辱嘘枯。",
        "鶠阁骞云表，虹旌拂海隅。",
        "明光新出綍，陜陌重分符。",
        "丰润还桑梓，讙讴复路衢。",
        "宁须更条教，耆旧已箪壶。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 176949,
      "title": "送张景淳知邵武军",
      "content": [
        "闽岭窅何在，东南千里遥。",
        "仳离伤草草，会合更迢迢。",
        "隋岸微吹絮，吴江欲上潮。",
        "肯无同舍念，回首弭轻桡。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176950,
      "title": "送章伯镇知湖州",
      "content": [
        "江外饶佳郡，吴兴天下稀。",
        "莼羮紫丝滑，鲈脍雪花肥。",
        "星斗寒相照，烟波碧四围。",
        "柳侯还作牧，草树转清辉。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176951,
      "title": "送王伯初通判婺州",
      "content": [
        "煜爚屏星驾，迢遥婺女区。",
        "岚光晴向背，溪溜暖萦纡。",
        "万室鸣机杼，千艘隘舶舻。",
        "若逢耆旧问，能说隐侯无。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176952,
      "title": "送张少卿学士知洪州",
      "content": [
        "相府典刑在，朝闺望实高。",
        "䌷书荣史观，典乐重卿曹。",
        "夷路迎飞鞚，桑林应奏刀。",
        "家籝传旧学，庙鼎刻前劳。",
        "袨服屯千骑，连樯阅万艘。",
        "剑芒冲夜气，阁影动秋涛。",
        "风色传花信，烟光拂酒膏。",
        "使君专问俗，无意在游遨。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 176953,
      "title": "送昭远兄归陜",
      "content": [
        "种种亲头白，帝城难少留。",
        "倚门应有望，列鼎本无求。",
        "清夜多归梦，红尘厌久游。",
        "此行殊捧檄，辕下五骅骝。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176954,
      "title": "寄清逸魏处士",
      "content": [
        "乡树三摇落，临风歌式微。",
        "徒嗟俗缘重，端使素心违。",
        "茅阁松杉冷，山园药草肥。",
        "不能如海燕，岁岁一西飞。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176955,
      "title": "送云卿知衞州",
      "content": [
        "汗简成新令，褰帷刺剧州。",
        "韦平家法在，邵杜治声优。",
        "野竹交淇水，秋瓜蔓帝邱。",
        "三年归奉计，肯顾石渠游。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176956,
      "title": "送昌言知宿州",
      "content": [
        "炜炜符离守，中流簇鼓旗。",
        "柳阴浓不断，舟势激如飞。",
        "魏阙行归奏，承明秪暂违。",
        "星轺晨夜度，尺素勿令稀。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176957,
      "title": "送济川知汉州二首  其一",
      "content": [
        "金马从容乐，问君何所之。",
        "客心彯若梗，亲髪暠如丝。",
        "旧学已孤陋，素交仍别离。",
        "执经时有问，使我复从谁。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176958,
      "title": "送济川知汉州二首  其二",
      "content": [
        "千骑拥朱轓，青霞昼绣还。",
        "复寻题柱迹，重过弃𦈡关。",
        "晓栈流云湿，秋湖脱叶殷。",
        "久游今得意，真不愧江山。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176959,
      "title": "哭公素  其一",
      "content": [
        "负书游上国，拾芹取荣名。",
        "雅度津涯阔，高文风雨惊。",
        "忘怀飜得谤，纵酒遂伤生。",
        "忍使泉台客，悁悁不自明。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176960,
      "title": "哭公素  其二",
      "content": [
        "丹旌倚輤车，荣辱尽虚无。",
        "半道骅骝顿，先秋兰雨枯。",
        "儿痴才过齓，亲老不胜扶。",
        "家事今萧瑟，宁将未第殊。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176961,
      "title": "送程端明知成都",
      "content": [
        "高阳将幕开，濯锦使旌来。",
        "欲识关头雪，正如江上梅。",
        "宵衣矜远俗，露冕寄良才。",
        "岂待三年最，修梧茂帝台。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176962,
      "title": "丁尚书挽词二首  其一",
      "content": [
        "凤跸游汾曲，非熊得伟人。",
        "闺台尤显重，训诰愈深淳。",
        "论道参黄阁，横经侍紫宸。",
        "如何天不愸，志业未全伸。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176963,
      "title": "丁尚书挽词二首  其二",
      "content": [
        "丹阙晨趋退，萧然忘世荣。",
        "闲斋虚自白，永日澹无营。",
        "脱落簪缨累，沈冥丘壑情。",
        "贪夫诚有激，千载素风清。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176964,
      "title": "奉和济川代书三十韵寄诸同舍",
      "content": [
        "金马延群俊，芸香聚众书。",
        "杳疑神境绝，深与世尘疏。",
        "气逼烟霄爽，光分日月余。",
        "不材叨误选，故友幸联居。",
        "云盖森胡骑，天阍谨契鱼。",
        "后先陪贾马，左右揖严徐。",
        "朱阁霜清外，璇题日上初。",
        "辞林精采撷，艺圃纵游渔。",
        "决胜楸枰暝，穷欢绮席舒。",
        "朝昏升紫闼，咫尺待雕舆。",
        "玉垒俄乡思，铜符忽诏除。",
        "彩衣承几杖，华毂照园庐。",
        "四郭柑垂荫，千塍稻散渠。",
        "壶浆迎露冕，铙吹拥高旟。",
        "有德能仁虎，无欺耻怒狙。",
        "道途繁揖让，犴狱绝沦胥。",
        "滞穗栖场圃，鸣桴静里闾。",
        "贫宁费官烛，饥不茹家蔬。",
        "翁子怀青绶，文园驾赤车。",
        "古今相与校，胜负定何如。",
        "上正开宣室，人方诵子虚。",
        "追锋行入谒，委佩复传胪。",
        "抚已聊晞骥，临民遽起予。",
        "居然耗廪禄，岂不愧簪裙。",
        "鹈翼颜何厚，锥囊意未摅。",
        "因循恋糠籺，汩没老涂淤。",
        "自顾徒为尔，诚非益者欤。",
        "俄承吕公檄，遂策阮生驴。",
        "驿骑传巴徼，诗筒达鲁墟。",
        "琳琅固无价，燕石敢沽诸。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 176965,
      "title": "和始平公贻一二宾僚",
      "content": [
        "儒冠蔼蔼从平津，东阁由来盛众宾。",
        "终始何尝忘教育，高卑曾不间疏亲。",
        "共陪樽俎无虚日，空喜谿山得主人。",
        "白雪屡歌殊未和，自知羞愧后车尘。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 176966,
      "title": "留客",
      "content": [
        "酒烟漠漠自生春，舞袖飘飖拍拍新。",
        "须信客归丝竹散，清风白月解愁人。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 176967,
      "title": "和始平公长句寄汉州何学士",
      "content": [
        "势交倐忽易萧条，赖有伊人尚建标。",
        "须信松筠凌雪茂，肯为蒲柳望秋凋。",
        "钦贤高馆三年别，广汉专城百舍遥。",
        "书纸如云诗叩玉，数凭疾翼度青霄。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 176968,
      "title": "济川有书见贻云以亲老须守远郡以便禄养不得如光在主人幕下因以诗答",
      "content": [
        "千骑骎骎簇画辀，高旌大盖五骅骝。",
        "斋中酒美连翩醉，湖上花繁烂漫游。",
        "鸡犬相闻通故里，旨甘不绝奉晨羞。",
        "只应朝夕平津阁，得向君前立胜筹。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 176969,
      "title": "阏逢敦牂二月十一日与一二僚友游叔礼园亭以诗戏呈",
      "content": [
        "下马久徘徊，林芳殊未开。",
        "春风真有意，须待主翁来。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 176970,
      "title": "十四日小园置茶招宗圣应之皆辞以醉为诗赠之",
      "content": [
        "草树弄春晖，家家倒载归。",
        "谁怜独醒客，日暝掩双扉。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 176971,
      "title": "同僚有独游东游者小诗寄之  其一",
      "content": [
        "车马东城路，芬芳数里尘。",
        "风光不相待，愁杀未游人。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 176972,
      "title": "同僚有独游东游者小诗寄之  其二",
      "content": [
        "咫尺东园乐，无如簿领何。",
        "春风连夜恶，闻道落花多。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 176973,
      "title": "同僚有独游东游者小诗寄之  其三",
      "content": [
        "城楼传晚鼓，稍稍讼庭稀。",
        "起拂衣中土，还骑款段归。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 176974,
      "title": "小诗招僚友晚游后园二首  其一",
      "content": [
        "五陵年少竞春晖，肥马银鞍白玉羁。",
        "何似松间煮新茗，更来花底覆残棋。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 176975,
      "title": "小诗招僚友晚游后园二首  其二",
      "content": [
        "麦田小雨陇微青，草树欣欣照晚晴。",
        "花下客来醒亦好，犹胜闭户过清明。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 176976,
      "title": "小园晚饮",
      "content": [
        "公府丰暇豫，真成弃掷春。",
        "招邀俱胜友，烂漫醉芳辰。",
        "花艶秾无敌，文锋健有神。",
        "犹胜拥朱墨，终日坐埃尘。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176977,
      "title": "李花",
      "content": [
        "嘉李繁相倚，园林淡泊春。",
        "齐纨剪衣薄，吴纻下机新。",
        "色与晴光乱，香和露气匀。",
        "望中皆玉树，环堵不为贫。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176978,
      "title": "东窗",
      "content": [
        "临风梳短髪，萧飒晚凉新。",
        "不识市朝客，何如江海人。",
        "沈吟凭棐几，欹侧带纱巾。",
        "浊世事无尽，东窗聊放神。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176979,
      "title": "奉和始平公酬大资政吴侍郎  其一",
      "content": [
        "道盛经纶业，文高翰墨场。",
        "雍容偃藩地，密迩钓璜乡。",
        "回首红尘远，清心白日长。",
        "山形抱城堞，谿影照公堂。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176980,
      "title": "奉和始平公酬大资政吴侍郎  其二",
      "content": [
        "𫁂䅉千塍碧，芙蕖万顷香。",
        "跨波横略彴，逼地亚筼筜。",
        "大野禾麻溢，高斋几席凉。",
        "夔龙屡赓唱，东壁正垂光。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176981,
      "title": "晚行后园见菊戏宜甫",
      "content": [
        "野菊荒无数，班班初见花。",
        "径须求一醉，试遣问东家。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 176982,
      "title": "野菊",
      "content": [
        "野菊未尝种，秋花何处来。",
        "羞随众草没，故犯早霜开。",
        "寒蝶舞不去，夜蛬吟更哀。",
        "幽人自移席，小摘泛青杯。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176983,
      "title": "秋夜",
      "content": [
        "城上调秋角，烟间发暝钟。",
        "风枝摇宿鸟，霜草覆寒蛬。",
        "久负观书乐，端愁束带恭。",
        "暂因群吏散，还得遂幽慵。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176984,
      "title": "再呈宜甫",
      "content": [
        "西家壶已倒，次第向东邻。",
        "朱户如坚闭，黄花恶笑人。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 176985,
      "title": "宜甫家有金铃菊客未之识因代菊赠宜甫",
      "content": [
        "主人倦邀客，寂寞委苍苔。",
        "此日开无益，明年不复开。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 176986,
      "title": "深夜",
      "content": [
        "疏星映户月流天，群动收声四寂然。",
        "嗟尔寒蛬怨何事，悲吟彻曙亦无眠。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 176987,
      "title": "奉和始平公喜闻昌言修注",
      "content": [
        "凤口除书下九阍，簪绅拭目仰殊恩。",
        "晓提麟笔依华盖，日就螭坳记圣言。",
        "桃李新阴方蔼蔼，骅骝老志更轩轩。",
        "主人喜见相如达，趣召邹枚洗玉樽。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 176988,
      "title": "秋雨霁倏闻宗圣案伎应之饮酒诗呈宜甫",
      "content": [
        "寒风细雨未晴天，密似轻尘薄似烟。",
        "一室独吟图史乱，四邻高会绮罗鲜。",
        "鴈飞斜柱弦随指，蟹荐新螯酒满船。",
        "自笑不歌仍不饮，昏昏只解枕床眠。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 176989,
      "title": "宜甫东楼晚饮",
      "content": [
        "宾主俱欢醉，高楼迥倚空。",
        "形忘羁检外，酒散笑谈中。",
        "晚市烟初白，秋园叶半红。",
        "登临不厌数，朝夕是寒风。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176990,
      "title": "送魏寺丞赴辟秦州判官",
      "content": [
        "征西大府开，后乘得高才。",
        "区脱烽烟静，渠搜职贡来。",
        "陇云低玉帐，羌舞奉金罍。",
        "信美从军乐，修梧茂帝台。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176991,
      "title": "昌言谪官符离有病鹤折翼舟载以行及还修注始平公以诗问之命光同赋二首  其一",
      "content": [
        "曾下青田啄玉苗，泥沙病羽久萧条。",
        "谪仙不欲留尘世，依旧提携上碧霄。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 176992,
      "title": "昌言谪官符离有病鹤折翼舟载以行及还修注始平公以诗问之命光同赋二首  其二",
      "content": [
        "相阁书传紫闼深，破缄先问九臯禽。",
        "不令一物伤天理，仁爱方知真宰心。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 176993,
      "title": "和聂之美重游东郡二首  其一",
      "content": [
        "跃马津亭未几何，宦游容易十年过。",
        "飘飖空似随流梗，寂寞犹为挂壁梭。",
        "西岭应余当日翠，南湖真减几分波。",
        "输君尚得飞征盖，重向春园听旧歌。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 176994,
      "title": "和聂之美重游东郡二首  其二",
      "content": [
        "南湖重过又逢春，官柳虽疏亦解新。",
        "台榭倾欹宾友散，临风愁杀独游人。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 176995,
      "title": "大热",
      "content": [
        "山泽欲焦枯，炎光满太虚。",
        "不知天地外，暑气复何如。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 176996,
      "title": "夷齐",
      "content": [
        "夷齐双骨已成尘，独有清名日日新。",
        "饿死沟中人不识，可怜今古几何人。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 176997,
      "title": "清风台",
      "content": [
        "太守金闺客，天朝应对才。",
        "非因板舆恋，宁驾使车来。",
        "水鉴秋毫尽，霜锋错节开。",
        "清风偏千里，不独此高台。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
