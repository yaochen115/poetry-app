{
  "data": [
    {
      "id": 265129,
      "title": "洛中送崔司业使君扶侍赴唐州",
      "content": [
        "绿野芳城路，残春柳絮飞。",
        "风鸣骕骦马，日照老莱衣。",
        "洛苑鱼书至，江村鴈户归。",
        "相思望淮水，双鲤不应稀。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265130,
      "title": "送李友路秀才赴举",
      "content": [
        "谁怜相门子，不语望秋山。",
        "生长绮纨内，辛勤笔砚间。",
        "荣亲在名字，好学弃官班。",
        "伫俟明年桂，高堂开笑颜。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265131,
      "title": "送从弟郎中赴浙西",
      "content": [
        "衔命出尚书，新恩换使车。",
        "汉庭无右者，梁苑重归欤。",
        "又食建业水，曾依京口居。",
        "共经何限事，宾主两如初。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265132,
      "title": "送元上人归稽亭",
      "content": [
        "重叠稽亭路，山僧归独行。",
        "远峰斜日影，本寺旧钟声。",
        "徒侣问新事，烟云怆别情。",
        "应夸乞食处，踏遍凤凰城。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265133,
      "title": "赠别君素上人诗",
      "content": [
        "穷巷唯秋草，高僧独扣门。",
        "相欢如旧识，问法到无言。",
        "水为风生浪，珠非尘可昏。",
        "悟来皆是道，此别不销魂。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265134,
      "title": "送深法师游南岳",
      "content": [
        "师在白云乡，名登善法堂。",
        "十方传句偈，八部会坛场。",
        "飞锡无定所，宝书留旧房。",
        "唯应衔果鴈，相送至衡阳。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265135,
      "title": "赠别约师",
      "content": [
        "师逢吴兴守，相伴住禅扃。",
        "春雨同栽树，秋灯对讲经。",
        "庐山曾结社，桂水远扬舲。",
        "话旧还惆怅，天南望柳星。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265136,
      "title": "秋日过鸿举法师寺院便送归江陵",
      "content": [
        "看画长廊遍，寻僧一径幽。",
        "小池兼鹤净，古木带蝉秋。",
        "客至茶烟起，禽归讲席收。",
        "浮杯明日去，相望水悠悠。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265137,
      "title": "春日退朝",
      "content": [
        "紫陌夜来雨，南山朝下看。",
        "戟枝迎日动，阁影助松寒。",
        "瑞气转绡縠，游光泛波澜。",
        "御沟新柳色，处处拂归鞍。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265138,
      "title": "蜀先主庙",
      "content": [
        "天地英雄气，千秋尚凛然。",
        "势分三足鼎，业复五铢钱。",
        "得相能开国，生儿不象贤。",
        "凄凉蜀故妓，来舞魏宫前。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265139,
      "title": "经东都安国观九仙公主旧院作",
      "content": [
        "仙院御沟东，今来事不同。",
        "门开青草日，楼闭绿杨风。",
        "将犬升天路，披云赴月宫。",
        "武皇曾驻跸，亲问主人翁。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265140,
      "title": "观八阵图",
      "content": [
        "轩皇传上略，蜀相运神机。",
        "水落龙蛇出，沙平鹅鹳飞。",
        "波涛无动势，鳞介避余威。",
        "会有知兵者，临流指是非。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265141,
      "title": "八月十五日夜翫月",
      "content": [
        "天将今夜月，一遍洗寰瀛。",
        "暑退九霄净，秋澄万景清。",
        "星辰让光彩，风露发晶英。",
        "能变人间世，翛然是玉京。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265142,
      "title": "太和戊申岁大有年诏赐百僚出城观秋稼谨书盛事以俟采诗者",
      "content": [
        "长安铜雀鸣，秋稼与云平。",
        "玉烛调寒暑，金风报顺成。",
        "川原呈上瑞，恩泽赐闲行。",
        "欲反重城掩，犹闻歌吹声。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265143,
      "title": "金陵怀古",
      "content": [
        "潮满冶城渚，日斜征虏亭。",
        "蔡洲新草绿，幕府旧烟青。",
        "兴废由人事，山川空地形。",
        "后庭花一曲，幽怨不堪听。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265144,
      "title": "昼居池上亭独吟",
      "content": [
        "日午树阴正，独吟池上亭。",
        "静看蜂教诲，闲想鹤仪形。",
        "法酒调神气，清琴入性灵。",
        "浩然机已息，几杖复何铭。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265145,
      "title": "分司东都蒙襄阳李司徒相公书问因以奉寄",
      "content": [
        "早忝金马客，晚为商洛翁。",
        "知名四海内，多病一生中。",
        "举世往还尽，何人心事同。",
        "几时登岘首，恃旧揖三公。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265146,
      "title": "门下相公荣加册命天下同欢忝沐眷私辄感申贺",
      "content": [
        "册命出宸衷，官仪自古崇。",
        "特膺平土拜，光赞格天功。",
        "再佩扶阳印，常乘鲍氏骢。",
        "七贤遗老在，犹得咏清风。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265147,
      "title": "病中一二禅客见问因以谢之",
      "content": [
        "劳动诸贤者，同来问病夫。",
        "添炉烹雀舌，洒水净龙须。",
        "身是芭蕉喻，行须筇竹扶。",
        "医王有妙药，能乞一丸无。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265148,
      "title": "秋江晚泊",
      "content": [
        "长泊起秋色，空江涵霁晖。",
        "暮霞千万状，宾鸿次第飞。",
        "古戍见旗逈，荒村闻犬稀。",
        "轲峨艑上客，劝酒夜相依。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265149,
      "title": "步出武陵东亭临江寓望",
      "content": [
        "鹰至感风候，霜余变林麓。",
        "孤颿带日来，寒江转沙曲。",
        "戍摇旗影动，津晚橹声促。",
        "月上彩霞收，渔歌远相续。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265150,
      "title": "秋日送客至潜水驿",
      "content": [
        "候吏立沙际，田家连竹溪。",
        "枫林社日鼓，茅屋午时鸡。",
        "鹊噪晚禾地，蝶飞秋草畦。",
        "驿楼宫树近，疲马再三嘶。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265151,
      "title": "湖州崔郎中曹长寄三癖诗自言癖在诗与琴酒其词逸而高吟咏不足昔柳吴兴亭臯陇首之句王融书之白团扇故为四韵以谢之",
      "content": [
        "视事画屏中，自称三癖翁。",
        "管弦泛春渚，旌斾拂晴虹。",
        "酒对青山月，琴韵白苹风。",
        "会书团扇上，知君文字工。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265152,
      "title": "为郎分司寄上都同舍",
      "content": [
        "籍通金马门，家在铜𫘞陌。",
        "省闼昼无尘，宫树朝凝碧。",
        "荒街浅深辙，古渡潺湲石。",
        "唯有嵩丘云，堪夸早朝客。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265153,
      "title": "登陕州北楼却忆京师亲友",
      "content": [
        "独上百尺楼，目穷思亦愁。",
        "初日徧露草，野田荒悠悠。",
        "尘息长道白，林清宿烟收。",
        "回首云深处，永怀乡旧游。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265154,
      "title": "途中早发",
      "content": [
        "中庭望启明，促促事晨征。",
        "寒树鸟初动，霜桥人未行。",
        "水流白烟起，日上彩霞生。",
        "隐士应高枕，无人问姓名。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265155,
      "title": "陕州河亭陪韦五大夫雪后眺望因以留别与韦有布衣之旧一别二纪经迁贬而归",
      "content": [
        "雪霁太阳津，城池表里春。",
        "河流添马颊，原色动龙鳞。",
        "万里独归客，一杯逢故人。",
        "登高向西望，关路正飞尘。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265156,
      "title": "城东闲游",
      "content": [
        "借问池台主，多居要路津。",
        "千金买绝境，永日属闲人。",
        "竹径萦纡入，花林委曲巡。",
        "斜阳众客散，空锁一园春。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265157,
      "title": "罢郡归洛阳闲居",
      "content": [
        "十年江海守，旦夕有归心。",
        "及此西还日，空成东武吟。",
        "花间数杯酒，月下一张琴。",
        "闻说功名事，依前惜寸阴。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265158,
      "title": "晚泊牛渚",
      "content": [
        "芦苇晚风起，秋江鳞甲生。",
        "残霞忽变色，游雁有余声。",
        "戍鼓音响绝，渔家灯火明。",
        "无人能咏史，独自月中行。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265159,
      "title": "宿诚禅师山房题赠二首 一",
      "content": [
        "宴坐白云端，清江直下看。",
        "来人望金刹，讲席绕香坛。",
        "虎啸夜林动，鼍鸣秋涧寒。",
        "众音徒起灭，心在净中观。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265160,
      "title": "宿诚禅师山房题赠二首 二",
      "content": [
        "不出孤峰上，人间四十秋。",
        "视身如传舍，阅世似东流。",
        "法为因缘立，心从次第修。",
        "中宵问真偈，有住是吾忧。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265161,
      "title": "赠澧州高大夫司马霞[寓]",
      "content": [
        "前年牧锦城，马蹋血泥行。",
        "千里追戎首，三军许勇名。",
        "残兵疑鹤唳，空垒辩乌声。",
        "一误云中级，南游湘水清。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265162,
      "title": "闻董评事疾因以书赠",
      "content": [
        "繁露传家学，青莲译梵书。",
        "火风乖四大，文字废三余。",
        "欹枕昼眠静，折巾秋鬓疎。",
        "武皇思视草，谁许茂陵居。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265163,
      "title": "咏庭梅寄人",
      "content": [
        "蚤花常犯寒，繁实常苦酸。",
        "何事上春日，坐令芳意阑。",
        "夭桃定相笑，游妓肯回看。",
        "君问调金鼎，方知正味难。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265164,
      "title": "德宗神武孝文皇帝挽歌二首 一",
      "content": [
        "出震清多难，乘时播大钧。",
        "操弦调六气，挥翰动三辰。",
        "运偶升天日，哀深率土人。",
        "瑶池无辙迹，谁见属车尘。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265165,
      "title": "德宗神武孝文皇帝挽歌二首 二",
      "content": [
        "凤翣拥铭旌，威迟异吉行。",
        "汉仪陈秘器，楚挽咽繁声。",
        "驻綍辞清庙，凝笳背直城。",
        "唯应留内传，知是向蓬瀛。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265166,
      "title": "敬宗睿武昭愍孝皇帝挽歌三首 一",
      "content": [
        "宝历方无限，仙期忽有涯。",
        "事亲崇汉礼，传圣法殷家。",
        "晚出芙蓉阙，春归棠棣华。",
        "玉轮今日动，不是画云车。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265167,
      "title": "敬宗睿武昭愍孝皇帝挽歌三首 二",
      "content": [
        "任贤劳梦寐，登位富春秋。",
        "欲遂东人幸，宁虞杞国忧。",
        "长杨收羽骑，太液泊龙舟。",
        "惟有衣冠在，年年怆月游。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265168,
      "title": "敬宗睿武昭愍孝皇帝挽歌三首 三",
      "content": [
        "讲学金华殿，亲畊钩盾田。",
        "侍臣容谏猎，方士信求仙。",
        "虹影俄侵日，龙髯不上天。",
        "空余水银海，长照夜灯前。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265169,
      "title": "文宗元圣昭献孝皇帝挽歌三首",
      "content": [
        "继体三才理，承颜九族亲。",
        "禹功留海内，殷历付天伦。",
        "调露曲常在，秋风词尚新。",
        "本支方百代，先让棣华春。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265170,
      "title": "文宗元圣昭献孝皇帝挽歌三首 二",
      "content": [
        "月落宫车动，风凄仪杖闲。",
        "路唯瞻凤翣，人尚想龙颜。",
        "御宇方无事，乘云遂不还。",
        "圣情悲望处，沈日下西山。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265171,
      "title": "文宗元圣昭献孝皇帝挽歌三首 三",
      "content": [
        "享国十五载，升天千万年。",
        "龙镳仙路远，骑吹礼容全。",
        "日下初陵外，人悲旧劒前。",
        "周南有遗老，掩泪望秦川。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265172,
      "title": "故相国燕国公于司空挽歌二首 一",
      "content": [
        "雕弓封旧国，黑弰继前功。",
        "十年镇南雍，九命作司空。",
        "池台乐事尽，箫鼓葬仪雄。",
        "一代英豪气，晓散白杨风。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265173,
      "title": "故相国燕国公于司空挽歌二首 二",
      "content": [
        "阴山贵公子，来葬五陵西。",
        "前马悲无主，犹带朔风嘶。",
        "汉水晋山郭，襄杨白铜鞮。",
        "至今有遗爱，日暮人凄凄。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265174,
      "title": "伤丘中丞",
      "content": [
        "邺下杀才子，苍茫冤气凝。",
        "枯杨映漳水，野火上西陵。",
        "马鬣今无所，龙门昔共登。",
        "何人为吊客，唯是有青蝇。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265175,
      "title": "河南观察使故相国袁公挽歌三首 一",
      "content": [
        "五驱龙虎节，一入凤凰池。",
        "令尹自无喜，羊公人不疑。",
        "天归京兆日，叶下洞庭时。",
        "湘水秋风至，凄凉吹素旗。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265176,
      "title": "河南观察使故相国袁公挽歌三首 二",
      "content": [
        "丹旐发江臯，人悲雁亦号。",
        "湘南罢亥市，汉上改词曹。",
        "表墓双碑立，尊名一字褒。",
        "尝闻平楚狱，为报里门高。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265177,
      "title": "河南观察使故相国袁公挽歌三首 三",
      "content": [
        "返葬三千里，荆衡达帝畿。",
        "逢人即故吏，拜奠尽沾衣。",
        "地得青乌相，宾惊白鹤飞。",
        "五公碑尚在，今日亦同归。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265178,
      "title": "哭王仆射相公",
      "content": [
        "子侯一日病，滕公千载归。",
        "门庭怆已变，风物澹无辉。",
        "群吏谒新府，旧宾沾素衣。",
        "歌堂忽暮哭，贺雀尽惊飞。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265179,
      "title": "伤韦宾客",
      "content": [
        "韦公八十余，位至六尚书。",
        "五福唯无富，一生谁得如。",
        "桂枝攀最久，兰省出仍初。",
        "海内时流尽，何人动素车。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265180,
      "title": "再经故元九相公宅池上作",
      "content": [
        "故池春又至，一到一伤情。",
        "雁鹜群犹下，蛙螟衣已生。",
        "竹丛身后长，台势雨来倾。",
        "六尺孤安在，人间未有名。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265181,
      "title": "请告东归发灞桥却寄诸僚友",
      "content": [
        "征徒出灞涘，回首伤如何。",
        "故人云雨散，满目山川多。",
        "行车无停轨，流景同迅波。",
        "前欢渐成昔，感叹益劳歌。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265182,
      "title": "初至长安",
      "content": [
        "左迁凡二纪，重见帝城春。",
        "老大归朝客，平安出岭人。",
        "每行经旧处，却想似前身。",
        "不改南山色，其余事事新。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265183,
      "title": "岁杪将发楚州呈乐天",
      "content": [
        "楚泽雪初霁，楚城春欲归。",
        "清淮变寒色，远树含清晖。",
        "原野已多思，风霜潜减威。",
        "与君同旅雁，北向刷毛衣。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265184,
      "title": "鹤叹二首 一",
      "content": [
        "寂寞一双鹤，主人在西京。",
        "故巢吴苑树，深院洛阳城。",
        "徐引竹间步，远含云外情。",
        "谁怜好风月，邻舍夜吹笙。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265185,
      "title": "鹤叹二首 二",
      "content": [
        "丹顶宜承日，霜翎不染泥。",
        "爱池能久立，看月未成栖。",
        "一院春草长，三山归路迷。",
        "主人朝谒早，贪养汝南鸡。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265186,
      "title": "答白刑部闻新蝉",
      "content": [
        "蝉声未发前，已自感流年。",
        "一入凄凉耳，如闻断续弦。",
        "晴清依露叶，晚急畏霞天。",
        "何事秋卿咏，逢时亦悄然。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265187,
      "title": "和裴相公寄白侍郎求双鹤",
      "content": [
        "皎皎华亭鹤，来随太守船。",
        "青云意长在，沧海别经年。",
        "留滞清洛苑，裴回明月天。",
        "何如凤池上，双舞入祥烟。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265188,
      "title": "终南秋雪",
      "content": [
        "南岭见秋雪，千门生早寒。",
        "闲时驻马望，高处卷帘看。",
        "雾散琼枝出，日斜铅粉残。",
        "偏宜曲江上，倒影入清澜。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265189,
      "title": "和乐天早寒",
      "content": [
        "雨引苔侵壁，风驱叶拥堦。",
        "久留闲客话，宿请老僧斋。",
        "酒瓮新陈接，书签次第排。",
        "翛然自有处，摇落不伤怀。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265190,
      "title": "曲江春望",
      "content": [
        "凤城烟雨歇，万象含佳气。",
        "酒后人倒狂，花时天似醉。",
        "三春车马客，一代繁华地。",
        "何事独伤怀，少年曾得意。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265191,
      "title": "同乐天和微之深春二十首 一",
      "content": [
        "何处深春好，春深万乘家。",
        "宫门皆映柳，辇路尽穿花。",
        "池色连天汉，城形象帝车。",
        "旌旗暖风里，猎猎向西斜。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265192,
      "title": "同乐天和微之深春二十首 二",
      "content": [
        "何处深春好，春深阿母家。",
        "瑶池长不夜，珠树正开花。",
        "桥峻通星渚，楼暄近日车。",
        "层城十二阙，相对日西斜。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265193,
      "title": "同乐天和微之深春二十首 三",
      "content": [
        "何处深春好，春深执政家。",
        "恩光贪捧日，贵重不看花。",
        "玉馔堂交印，沙隄柱碍车。",
        "多门一已闭，直道更无斜。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265194,
      "title": "同乐天和微之深春二十首 四",
      "content": [
        "何处深春好，春深大镇家。",
        "前旌光照日，后骑蹙成花。",
        "节院收衙队，毬场簇看车。",
        "广筵歌舞散，书号夕阳斜。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265195,
      "title": "同乐天和微之深春二十首 五",
      "content": [
        "何处深春好，春深贵戚家。",
        "枥嘶无价马，庭发有名花。",
        "欲进宫人食，先薰命妇车。",
        "晚归长带酒，冠盖任倾斜。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265196,
      "title": "同乐天和微之深春二十首 六",
      "content": [
        "何处深春好，春深恩泽家。",
        "炉添龙脑炷，绶结虎头花。",
        "宾客珠成履，婴孩锦缚车。",
        "画堂帘幕外，来去燕飞斜。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265197,
      "title": "同乐天和微之深春二十首 七",
      "content": [
        "何处深春好，春深京兆家。",
        "人眉新柳叶，马色醉桃花。",
        "盗息无鸣鼓，朝回自走车。",
        "能令帝城外，不敢迳由斜。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265198,
      "title": "同乐天和微之深春二十首 八",
      "content": [
        "何处深春好，春深刺史家。",
        "夜阑犹命乐，雨甚亦寻花。",
        "傲客多凭酒，新姬苦上车。",
        "公门吏散后，风摆戟衣斜。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265199,
      "title": "同乐天和微之深春二十首 九",
      "content": [
        "何处深春好，春深羽客家。",
        "芝田绕舍色，杏树满山花。",
        "云是淮王宅，风为列子车。",
        "古坛操简处，一迳入林斜。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265200,
      "title": "同乐天和微之深春二十首 十",
      "content": [
        "何处深春好，春深小隐家。",
        "芟庭留野菜，撼树去狂花。",
        "醉酒一千日，贮书三十车。",
        "雉衣从露体，不敢有余斜。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265201,
      "title": "同乐天和微之深春二十首 十一",
      "content": [
        "何处深春好，春深富室家。",
        "唯多贮金帛，不拟负莺花。",
        "国乐呼连辔，行厨载满车。",
        "归来看理曲，灯下宝钗斜。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265202,
      "title": "同乐天和微之深春二十首 十二",
      "content": [
        "何处深春好，春深豪士家。",
        "多沽味浓酒，贵买色深花。",
        "已臂鹰随马，连催妓上车。",
        "城南踏青处，村落逐原斜。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265203,
      "title": "同乐天和微之深春二十首 十三",
      "content": [
        "何处深春好，春深贵胄家。",
        "迎呼偏熟客，拣选最多花。",
        "饮馔开华幄，笙歌出钿车。",
        "兴酣罇易罄，连泻酒瓶斜。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265204,
      "title": "同乐天和微之深春二十首 十四",
      "content": [
        "何处深春好，春深唱第家。",
        "名传一纸榜，兴管九衢花。",
        "荐听诸侯乐，来随计吏车。",
        "杏园抛曲处，挥袖向风斜。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265205,
      "title": "同乐天和微之深春二十首 十五",
      "content": [
        "何处深春好，春深少妇家。",
        "能偷新禁曲，自剪入时花。",
        "追逐同游伴，平章贵价车。",
        "从来不堕马，故谴髻鬟斜。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265206,
      "title": "同乐天和微之深春二十首 十六",
      "content": [
        "何处深春好，春深幼女家。",
        "双鬟梳顶髻，两面绣帬花。",
        "妆坏频临镜，身轻不占车。",
        "秋千争次第，牵拽彩绳斜。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265207,
      "title": "同乐天和微之深春二十首 十七",
      "content": [
        "何处深春好，春深兰若家。",
        "当香收柏叶，养蜜近梨花。",
        "野迳宜行乐，游人尽驻车。",
        "菜园篱落短，遥见桔槔斜。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265208,
      "title": "同乐天和微之深春二十首 十八",
      "content": [
        "何处深春好，春深老宿家。",
        "小栏围蕙草，高架引藤花。",
        "四字香书印，三乘壁画车。",
        "迟回听句偈，双树晚阴斜。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265209,
      "title": "同乐天和微之深春二十首 十九",
      "content": [
        "何处深春好，春深种莳家。",
        "分畦十字水，接树两般花。",
        "栉比栽篱槿，咿哑转井车。",
        "可怜高处望，棋布不曾斜。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265210,
      "title": "同乐天和微之深春二十首 二十",
      "content": [
        "何处春深好，春深稚子家。",
        "争骑一竿竹，偷折四邻花。",
        "笑击羊皮鼓，行牵犊颔车。",
        "中庭贪夜戏，不觉玉绳斜。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265211,
      "title": "赠眼医婆罗门僧",
      "content": [
        "三秋伤望眼，终日哭途穷。",
        "两目今先暗，中年似老翁。",
        "看朱渐成碧，羞日不禁风。",
        "师有金篦术，如何为发蒙。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265212,
      "title": "海门潮别浩初师",
      "content": [
        "前日过萧寺，看师上讲筵。",
        "都人礼白足，施者散金钱。",
        "方便无非教，经行不废禅。",
        "还知习居士，发论侍弥天。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265213,
      "title": "始闻蝉有怀白宾客去岁白有闻蝉见寄诗云秖应催我老兼遣报君知之句",
      "content": [
        "蝉韵极清切，始闻何处悲。",
        "人含不平意，景值欲秋时。",
        "此岁方晼晚，谁家无别离。",
        "君言催我老，已是去年诗。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265214,
      "title": "赠乐天",
      "content": [
        "一别旧游尽，相逢俱涕零。",
        "在人虽晚达，于树似冬青。",
        "痛饮连宵醉，狂吟满坐听。",
        "终期抛印绶，共占少微星。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265215,
      "title": "到郡未浃日登西楼见乐天题诗因即事因寄",
      "content": [
        "湖上收宿雨，城中无昼尘。",
        "楼依新柳贵，池带乱苔春。",
        "云水正一望，簿书来绕身。",
        "烟波洞庭路，愧彼扁舟人。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265216,
      "title": "秋夕不寐寄乐天",
      "content": [
        "洞户夜帘卷，华堂秋簟清。",
        "萤飞过池影，蛩思绕阶声。",
        "老枕知将雨，高窗报欲明。",
        "何人谙此景，远问白先生。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265217,
      "title": "冬日晨兴寄乐天",
      "content": [
        "庭树晓禽动，郡楼残点声。",
        "灯挑红烬落，酒煖白光生。",
        "髪少嫌梳利，颜衰恨镜明。",
        "独吟谁应和，须寄洛阳城。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265218,
      "title": "答乐天见忆",
      "content": [
        "与老无期约，到来如等闲。",
        "偏伤朋友尽，移兴子孙间。",
        "笔底心无毒，杯前胆不{犭豖}。",
        "唯余忆君梦，飞过武牢关。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 265219,
      "title": "和乐天诮失婢牓者",
      "content": [
        "把镜朝犹在，添香夜不归。",
        "鸳鸯拂瓦去，鹦鹉透笼飞。",
        "不逐张公子，即随刘武威。",
        "新知正相乐，从此脱青衣。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265220,
      "title": "八月十五日夜半云开然后翫月因书一时之景寄呈乐天",
      "content": [
        "半夜碧云收，中天素月流。",
        "开城邀好客，置酒赏清秋。",
        "影透衣香润，光凝歌黛愁。",
        "斜辉犹可翫，移宴上西楼。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265221,
      "title": "秋日书怀寄白宾客",
      "content": [
        "州远雄无益，年高健亦衰。",
        "兴情逢酒在，筋力上楼知。",
        "蝉噪芳意尽，鴈来愁望时。",
        "商山紫芝客，应不向秋悲。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265222,
      "title": "詶乐天初冬早寒见寄",
      "content": [
        "乍起衣犹冷，微吟帽半欹。",
        "霜凝南屋瓦，鸡唱后园枝。",
        "洛水碧云晓，吴宫黄叶时。",
        "两传千里意，书札不如诗。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265223,
      "title": "和令狐相公郡斋对紫薇花",
      "content": [
        "明丽碧天霞，丰茸紫绶花。",
        "香闻荀令宅，艳入孝王家。",
        "几岁自荣乐，高情方叹嗟。",
        "有人移上苑，犹足占年华。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265224,
      "title": "令狐相公俯赠篇章斐然仰谢",
      "content": [
        "鄂渚临流别，梁园冲雪来。",
        "旅愁随冻释，欢意待花开。",
        "城晓乌频起，池春鴈欲回。",
        "饮和心自醉，何必管弦催。"
      ],
      "author": {
        "id": 6589,
        "name": "刘禹锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 265225,
      "title": "酬令狐相公早秋见寄",
      "content": [
        "公来第四秋，乐国号无愁。",
        "军士游书肆，商人占酒楼。",
        "熊罴交黑矟，宾客满青油。",
        "今日文章主，梁王不姓刘。"
      ],
      "author": {
        "id": 6589,
