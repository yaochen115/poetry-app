{
  "data": [
    {
      "id": 13640,
      "title": "闻归雁",
      "content": [
        "故岁东南客，新来西北飞。",
        "声迷江月老，阵入塞云稀。",
        "远恨抛书素，余音付玉徽。",
        "行人落君后，搔首未成归。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13641,
      "title": "春夕闻雁",
      "content": [
        "声繁知并举，阵急想斜分。",
        "臆饱江南稻，身随代北云。",
        "足书烦远寄，箭道怯虚闻。",
        "口噤悲黄鹄，相望不及群。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13642,
      "title": "送黄寺丞谪濠梁",
      "content": [
        "间关羁籍远，跌宕壮心违。",
        "倦逐淮禽去，欣同塞马归。",
        "时来富且贵，事往是耶非。",
        "姑共春清酌，徐徐遣世机。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13643,
      "title": "咏菊",
      "content": [
        "寿客若为情，风流友曲生。",
        "殿秋安晚节，为隠被香名。",
        "曼衍南阳种，凄凉楚泽英。",
        "见山应自语，今古几渊明。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13644,
      "title": "黄花道",
      "content": [
        "驿道云山里，悠悠千骑行。",
        "猿禽互啼啸，崖岭各阴晴。",
        "树合天疑窄，川回地忽平。",
        "锦官何日到，菖叶已催耕。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13645,
      "title": "中秋对月",
      "content": [
        "圆期压秋半，飞影破云端。",
        "明极翻无夜，清余遂作寒。",
        "桂繁团露湿，轮驶渡河干。",
        "且置穷边思，何殊故国看。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13646,
      "title": "孙抗寺丞宰晋陵",
      "content": [
        "旧笔刑丹燥，新辞苑雪妍。",
        "一名迟上月，再击始垂天。",
        "鹢首凌波稳，凫翁赐绶鲜。",
        "邑歌丰暇日，擿句暮争传。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13647,
      "title": "有怀旧隠",
      "content": [
        "官事未易了，田家胡不归。",
        "烟原射雉乐，春糁养鱼肥。",
        "菜密成岩幄，萝长代石衣。",
        "无为落吾事，坐老故山薇。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13648,
      "title": "属疾五首  其一",
      "content": [
        "腐肉填鸱素，华轩载鹤身。",
        "闭关吾有谓，当路彼何人。",
        "带眼移仍数，颠毛变愈新。",
        "惟无公干誉，他味似漳滨。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13649,
      "title": "属疾五首  其二",
      "content": [
        "淹卧日无聊，年侵葆鬓凋。",
        "久衰翻似凤，危息乍成鷮。",
        "笔倦长栖格，琴慵不褫𫋹。",
        "心知烦虑苦，宁望一丸销。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13650,
      "title": "属疾五首  其三",
      "content": [
        "自昔闻称疾，于今是养疴。",
        "三杯留客案，五子倦朝珂。",
        "落落堪忧苦，星星奈老何。",
        "酒希非所嗜，扬宅竟谁过。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13651,
      "title": "属疾五首  其四",
      "content": [
        "天假支离养，人怀寂寞惭。",
        "衰容行得老，苦节遂无甘。",
        "飞鸟惟宜下，疲馿讵可骖。",
        "吾生知所守，嘲客勿多谈。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13652,
      "title": "属疾五首  其五",
      "content": [
        "里旅居仍隘，台家疾见宽。",
        "何言汉朴学，正似楚枝官。",
        "煦渚藏劳尾，投林戢倦翰。",
        "上恩何日报，怯步已蹒跚。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13653,
      "title": "祗答公序相国二兄见寄二首  其一",
      "content": [
        "前时同出守，星鬓各萧萧。",
        "蹊李伐不食，原禽行自摇。",
        "棹前饶沸浪，蓬处但惊飚。",
        "素愿山林隠，公乎不在招。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13654,
      "title": "祗答公序相国二兄见寄二首  其二",
      "content": [
        "壮引朱颜往，衰招白发生。",
        "危心几何折，劳尾自然赪。",
        "把酒天涯恨，搔头岁暮情。",
        "将何献康乐，衰思顿如酲。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13655,
      "title": "智成上人奉陪中山公赴淝上",
      "content": [
        "宗工方出守，大士此相亲。",
        "不有今平叔，难酬彼上人。",
        "毡毹连榻具，笋脯对盂珍。",
        "别后临川偈，同翻几叶新。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13656,
      "title": "江南木芙蓉张子春云其高如树中山地寒才数尺花瘠色淡八月已开",
      "content": [
        "江南高比树，塞北仅成丛。",
        "向晚谁争艳，防寒浅作红。",
        "弄条风淅淅，衔蕊蝶匆匆。",
        "且作黄花伴，无令叹斝空。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 13657,
      "title": "通判茹太博惠家园新茗",
      "content": [
        "雷鼓殷山春，枪苗第一新。",
        "云供烹处碧，露饷摘时津。",
        "瓯洁凝芳乳，罗纤撼练尘。",
        "贶予知有为，多渴思迟人。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13658,
      "title": "秋兴  其一",
      "content": [
        "天地西风徧，亭臯衰意生。",
        "寒云终不雨，危叶自多声。",
        "晚蟪犹嘶树，啼鸦稍著城。",
        "默然孤客思，年序共峥嵘。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13659,
      "title": "秋兴  其二",
      "content": [
        "遥夕何曾寐，孤怀有为忧。",
        "谋多真逗挠，师老但诛求。",
        "朔雾摩边垒，羌风殷战枹。",
        "吾生诚用寡，叹罢只搔头。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13660,
      "title": "秋兴  其三",
      "content": [
        "先日二毛生，秋来无复惊。",
        "南风随楚俗，北斗望都城。",
        "坞栗霜开罅，池莲雨折茎。",
        "停罇问天意，何适付枯荣。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13661,
      "title": "夜分",
      "content": [
        "夜分群动息，秋意久劳劳。",
        "林净月华上，河明天界高。",
        "街风遥叠鼓，园露暗僵桃。",
        "万事蹉跎外，惟应得二毛。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13662,
      "title": "送驾部俞员外良孺知江州",
      "content": [
        "朝弁辞清晓，斋艎泛暮秋。",
        "官华飞雉省，地剧左鱼州。",
        "湓水遥浮郭，天章近占楼。",
        "知君乘月夕，不浅是风流。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13663,
      "title": "赋得新秋似旧秋",
      "content": [
        "新秋摇落意，只似旧秋时。",
        "流景预何事，长年真自悲。",
        "芙蕖兼露歇，杨柳带蝉衰。",
        "叹罢蹉跎在，惟应素领知。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13664,
      "title": "老去",
      "content": [
        "老去惯摇落，第看芳岁阴。",
        "穗残饥鸟集，荷破曝龟沈。",
        "远岫多余紫，寒溪有定浔。",
        "残蝉何所畏，缄口抱秋林。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13665,
      "title": "衰感  其一",
      "content": [
        "眩罢目还暗，花残鬓益稀。",
        "长吟病庄舄，孤愤老韩非。",
        "坊酒叨常秩，雕花滥赐衣。",
        "家田耕熟未，元亮欲言归。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13666,
      "title": "衰感  其二",
      "content": [
        "秋色徧华颠，真成私自怜。",
        "身慵宁复事，秋早不依年。",
        "作吏惟思隠，从僧寖悟禅。",
        "支离果如此，只称据梧眠。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13667,
      "title": "张转运席上",
      "content": [
        "偃藩多式宴，佳雪屡飘霙。",
        "意感年将尽，欢容酒剩行。",
        "伊公调鼎乐，羊祜衣裘轻。",
        "况属輶轩暇，须容心赏并。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13668,
      "title": "答张学士西湖即席",
      "content": [
        "胜地纡佳客，高秋会赏心。",
        "返霞延落照，余岫补疏林。",
        "捉麈谈方熟，持螯酒屡斟。",
        "无烦命丝竹，擿句是清音。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13669,
      "title": "回堞",
      "content": [
        "回堞巑岏极，长天苍莽中。",
        "远溪寒不浪，高木暝饶风。",
        "栈廥休王马，枪累隔苑熊。",
        "残霞牵望眼，时到夕阳东。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13670,
      "title": "嵇中散画像",
      "content": [
        "彼美云章子，翛然天外情。",
        "凝眉逐层翥，俯手散余清。",
        "霄迥心逾远，徽迁曲暗成。",
        "千秋想萧散，方觉绘毫精。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13671,
      "title": "泉",
      "content": [
        "容与下层岑，飞流界百寻。",
        "记方谁辨玉，杂溜自成琴。",
        "细浪浮烟阔，回波逗月深。",
        "我来聊挹注，嚼药有初心。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13672,
      "title": "芭蕉",
      "content": [
        "逃腊藏深柢，乘春发故荄。",
        "雨障单盖侧，风偃半旗开。",
        "脆理缯争裂，斜规扇欲裁。",
        "无坚喻浮世，金粟信多才。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13673,
      "title": "言志",
      "content": [
        "志岂观非圣，才犹耻壮夫。",
        "穷愁五经笥，感慨八驺呼。",
        "昔隠思投耒，今行誓裂𦈡。",
        "莫邪方有请，谁为鼓洪炉。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13674,
      "title": "寄题元华书斋",
      "content": [
        "比日投簪隠，孟逢列舍椽。",
        "值岩因凿牖，仍磵即疏泉。",
        "斧烂仙棋路，花飞佛雨天。",
        "谏帷他夜梦，犹在翠微颠。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13675,
      "title": "小酌感春邀坐客并赋",
      "content": [
        "林下复池边，其如春暮天。",
        "花仍无数落，柳亦第三眠。",
        "强饮非能剧，狂歌不取妍。",
        "流芳何预事，只是自怡然。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13676,
      "title": "喜药山贤师见过",
      "content": [
        "风林曾语别，王舍此相逢。",
        "净月常涵水，孤云易去峰。",
        "供缘宾阁饮，耳界帝城钟。",
        "却举当年话，无言促麈松。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13677,
      "title": "寄题药山牛栏庵壁",
      "content": [
        "昔人牛口下，胥宇化南州。",
        "祖地千灯续，荒垣八字留。",
        "漏长莲叶晦，园胜柰阴稠。",
        "后嗣推崇意，同风古佛流。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13678,
      "title": "送天雄监兵李中吉",
      "content": [
        "督府监军重，清时握节荣。",
        "长云抱汉垒，残月偃边兵。",
        "戍雾渔挝叠，衢风鹤盖平。",
        "不应烦暑路，河朔趁飞觥。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13679,
      "title": "万秀才园斋",
      "content": [
        "仁里乐丘园，茨茅构回轩。",
        "槛风丛筿密，畦雨晚菘繁。",
        "列岫非他境，疏流即故源。",
        "彦伦回驾日，于此愧惊猿。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13680,
      "title": "水声",
      "content": [
        "淙波声可爱，最与静相宜。",
        "激射不平处，潺湲无罢时。",
        "拥花含骤咽，碍石溅空危。",
        "便作山林趣，宁妨吏隠师。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13681,
      "title": "长安道中怅然作三首  其一",
      "content": [
        "三辅古风烟，征骖怅未前。",
        "山园蓬颗外，宫室黍离边。",
        "树老经唐日，碑残刻汉年。",
        "便须真陨涕，不待雍门弦。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13682,
      "title": "长安道中怅然作三首  其二",
      "content": [
        "兴亡作今古，事往始堪悲。",
        "宫破黄山在，城空北斗移。",
        "走冈寒兔急，啼戍暮鸦饥。",
        "灞岸重回首，惟余王粲诗。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13683,
      "title": "长安道中怅然作三首  其三",
      "content": [
        "城阙今安在，关河昔所凭。",
        "种祠秦故畤，抔土汉诸陵。",
        "花树圆排荠，楼云淡引缯。",
        "南山不改色，千古恨相仍。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13684,
      "title": "晚晴",
      "content": [
        "积晦澄天宇，浮凉湛物华。",
        "远雷犹送电，残照即成霞。",
        "贺燕翻空迥，倾梧叠影斜。",
        "披襟无内热，宁忆郑生瓜。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13685,
      "title": "闻圜丘礼成肆眚",
      "content": [
        "斋幄连蜷驻玉虬，万灵遥护翠云裘。",
        "宝鸡竝雊迎神曲，卓马争趋助祭侯。",
        "封屋都人差赐帛，贱星牢口閴无囚。",
        "露萧雷解疏恩美，万和欢声速置邮。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13686,
      "title": "癸酉六月奉诏修耤田记十一月诏罢赋诗",
      "content": [
        "三时受诏拥缇油，曲笔无功苦思抽。",
        "不得成书同太史，须知非我异春秋。",
        "空言自合因人废，残藁犹应盖瓿留。",
        "归卧私庭深阁笔，饱尝鸡膳太悠悠。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13687,
      "title": "和晏公圜丘诗",
      "content": [
        "仗外鲜云敛夕容，跸声遥下紫营东。",
        "迎神秘座𪭢金密，腏食清坛烈火红。",
        "七萃禁戈攒月冷，万侯朝璧照霜空。",
        "天心帝意通欢豫，并在柴薰缥缈中。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13688,
      "title": "元夜观正阳锡宴",
      "content": [
        "云端峣阙下呼鞭，彩树遥分坐狄前。",
        "山戏百层平乐地，佛轮千影瑞陁天。",
        "祥风入助银花丽，宝月来供雉扇圆。",
        "献岁承平多乐事，击靴谁美唱唐年。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13689,
      "title": "初侍讲筵有感上呈经筵诸公",
      "content": [
        "迩英何幸奉经筵，俗状婆娑艾服年。",
        "兰叶初窥图上字，奎钩乍识禁中天。",
        "坐凭重席惭清问，能读三坟頼众贤。",
        "犹藉向来稽古力，不然须合早归田。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13690,
      "title": "再侍经筵有感",
      "content": [
        "露门重幄紫云开，何意孤臣得重陪。",
        "攀树已惊刘放老，受厘犹及贾生来。",
        "华绨藉暖瞻宸几，甘露浮香入赐杯。",
        "稽古虽勤成底力，心知不及汉儒才。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13691,
      "title": "奉和晏相公摄事圜丘中书致斋",
      "content": [
        "相阁斋居政事西，兹辰正值朔云低。",
        "雪园鹍冷应先舞，雀树鸡闲欲早栖。",
        "搁笔暂停黄纸尾，解骖犹放紫茸题。",
        "仙谣唱罢微阳动，谁见林间荔甲齐。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13692,
      "title": "礼局致斋",
      "content": [
        "枌榆秋报汉家坛，斋誓先朝令不刊。",
        "抱𫈵一身依礼署，饭蔬三日属祠官。",
        "天池唳鹤惊宵滴，宫堞栖乌噪暮寒。",
        "倦枕不烦神栎梦，有人无用亦常叹。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13693,
      "title": "禁门待漏",
      "content": [
        "破月余光淡禁街，驻车聊候九门开。",
        "双蟠晓阙苍龙动，斜倚春城北斗回。",
        "漏箭急传催叠鼓，酒炉争拥卖寒醅。",
        "元规尘影真堪畏，已傍游人要路来。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13694,
      "title": "仲冬二日使到颁翠毛锦旋襕",
      "content": [
        "翠裘朝罢转昕霞，颁服诸方走使车。",
        "泥和五芳中出诏，锦裁双兽织成花。",
        "官叨侍橐恩加等，例及和门赐有差。",
        "坐袭余温身更宠，不惭多病带镮赊。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13695,
      "title": "朝阳",
      "content": [
        "腷膊鸡声夜向晨，东方飞景到云林。",
        "帘帏已是曈曈晓，庭户全无曀曀阴。",
        "可是梧桐长得地，也应葵藿久倾心。",
        "日边早晚来环赐，见说清光注意深。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13696,
      "title": "观上朝",
      "content": [
        "鬰葱佳气护天台，衔尾茸题隘路槐。",
        "金箭忽鸣衡漏尽，火城争扑相车来。",
        "黄人日映仙盘上，阊阖天随禁钥开。",
        "规地凝深谁得见，渚鸾雝鹭自趋陪。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13697,
      "title": "再入翰林",
      "content": [
        "银台路入复门赊，四载重来鬓愈华。",
        "况自秋毫皆帝力，何言旧物是吾家。",
        "宫盘浩气浮襟爽，省树珍阴叠殿斜。",
        "书枕梦残闻吏报，日痕还复度砖花。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13698,
      "title": "闻后苑赐宴",
      "content": [
        "汉家殿幄紫云连，万品仙葩匝赐筵。",
        "露蕊半晞仙掌外，斗杓长在帝车前。",
        "液池綷鸟栖连籞，钩盾祥麰徧弄田。",
        "病客无阶陪槀饫，除因断梦到钧天。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13699,
      "title": "陪季秋大宴",
      "content": [
        "秘殿霞暾几刻移，天临法座俨朝緌。",
        "鱼龙雾暗充庭后，羯鼓风干解渴时。",
        "山答欢声来广座，花留和气入繁枝。",
        "自怜侍从非方朔，不识壶𪙾是隠词。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13700,
      "title": "忆上苑锡宴",
      "content": [
        "长怀禁籞宴嬉年，帐殿深沉望碧莲。",
        "秦地河流疑象汉，上林宫缭欲扪天。",
        "恩杯兰末流霞溢，跸道梧阴綷羽鲜。",
        "紫陌暮归人籍籍，汗帷挥雨杏粘鞯。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13701,
      "title": "谒四陵下宫",
      "content": [
        "四陵烟柏蔽团晖，晓束朝绅拜庙闱。",
        "台下俗无西向射，寝中人护月游衣。",
        "垂髯上汉龙难见，耘野连天鸟自飞。",
        "酹毕驱车循故道，经时回望怅依依。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13702,
      "title": "直讲周岁",
      "content": [
        "本自悲凉葆发多，何缘末至滥中阿。",
        "马肝不食非论味，狗曲犹轻枉为歌。",
        "旧学空疏缘病废，壮情牢落伴年过。",
        "终然野鹿江鱼性，长在云林与素波。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13703,
      "title": "寄南郡直讲王圣源",
      "content": [
        "良辰酒所独持杯，目极南云首重回。",
        "荣路久嗟冠一免，经筵贪爱㰅三摧。",
        "多年道胜胸中战，即席人推客右才。",
        "深诏糊名求异等，伫看挥笔映天台。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13704,
      "title": "赐禁中所种稻米",
      "content": [
        "中天铜雀长鸣罢，清籞滮池告稔初。",
        "刈敛方从弄田出，颁分更自导官余。",
        "霜茎矗秀纡宸玩，玉粒凝甘剩禁储。",
        "惭愧有年君赐厚，等闲欹枕梦为鱼。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13705,
      "title": "灯夕在告闻游人甚盛",
      "content": [
        "火树缯山凤阙前，皇都美景属新年。",
        "烟花并作长春国，日月潜移不夜天。",
        "道上落梅飘脆管，陌头繁杏著游鞯。",
        "须知钧会人同乐，莫叹秦侯抱疾眠。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13706,
      "title": "休沐",
      "content": [
        "出休连日似山郎，坐有蛩毡沐有汤。",
        "缸面酒华随日转，琴中松韵共风长。",
        "宫卑宁为今无巧，愚极曾闻古是狂。",
        "自顾支离身碌碌，幞归囊被亦何妨。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13707,
      "title": "归沐",
      "content": [
        "弥旬出沐道山头，僦庑萧萧避世游。",
        "枉是胸中存垒块，可能皮里有阳秋。",
        "驾车款段惭乡品，托乘鸱夷笑客愁。",
        "曲突不黔宾坐冷，时闻庭雀一啁啾。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13708,
      "title": "休日",
      "content": [
        "病粟支离月有储，汉家汤沐许家居。",
        "材同曲社真无用，拙比河阳恐有余。",
        "半夜羁魂随鹤警，九秋嘶腹共蝉虚。",
        "谁言舐痔非长策，却得君王五乘车。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13709,
      "title": "旬休  其一",
      "content": [
        "火云叠影抱炎曦，霑沐身闲与胜宜。",
        "卷叶初开芰荷沼，轻房半系石榴枝。",
        "茶枪早翠吟魂适，蔗境余佳渴肺知。",
        "汗马属鞬非我事，到头攘臂是支离。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13710,
      "title": "旬休  其二",
      "content": [
        "门依北郭最闲坊，休令归来白昼长。",
        "司马苦消非我事，次公无酒是真狂。",
        "午鸡初下繁阴合，梦蝶徐翻倦枕凉。",
        "自笑此生疲挟䇲，不知呼塞亦亡羊。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13711,
      "title": "旬休  其三",
      "content": [
        "散带家居首任蓬，闭关穷巷避雌风。",
        "官非言责如余裕，流在儒家觉少功。",
        "慢态已成书几积，黠姿无半画厨空。",
        "此生信有天年乐，堪置蒙庄大社中。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13712,
      "title": "和枢密晏太尉元日雪",
      "content": [
        "寒云万里送残宵，面旋祥霙集岁朝。",
        "繁影未能藏夜燎，薄花仍欲伴春椒。",
        "光含象阙苍龙舞，气勒交衢卓马骄。",
        "丰兆欢歌谁不尔，百官兼放五门朝。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13713,
      "title": "学舍石榴",
      "content": [
        "曾见芳英上舞裙，缘何此地寄轮囷。",
        "烟滋黛叶千条困，露裂星房百子匀。",
        "未羡扶南收作酿，曾经骑省赋为珍。",
        "须知博望来时晚，莫促幽芳趁暮春。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13714,
      "title": "秋日与天章侍讲王原叔曾明仲正言余安道三学士集普光院",
      "content": [
        "长廊尽北到禅扃，宴坐林间共褫缨。",
        "秋气只知双鹤唳，尘喧已去一牛鸣。",
        "晨钟暮磬无时歇，翠竹黄花相间明。",
        "妙墨仙郎题爵里，他年为寄此中行。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13715,
      "title": "太学建讲殿割王第西偏营置",
      "content": [
        "王家赐第曾开府，天子营宫此向儒。",
        "坏壁有经还阙里，废台无鹿叹姑苏。",
        "泉疑自涌供池溜，柱欲飞来荷栋桴。",
        "献岁成工观盛礼，愿陪希瑟趁风雩。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13716,
      "title": "落花  其一",
      "content": [
        "紫房丹萼旋辞春，素瑟悲多不忍闻。",
        "暮雨便从巫峡散，余香犹上魏台分。",
        "魂销南浦波空绿，望绝长门日易曛。",
        "翠被已空桃檝远，自今搔首更离群。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13717,
      "title": "落花  其二",
      "content": [
        "坠素翻红各自伤，青楼烟雨忍相忘。",
        "将飞更作回风舞，已落犹成半面妆。",
        "沧海客归珠迸泪，章台人去骨遗香。",
        "可能无意传双蝶，尽委芳心与蜜房。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13718,
      "title": "回郡将东还献梁相公",
      "content": [
        "留滞符鱼素领垂，十年方喜觐彤闱。",
        "平台雪罢邹阳老，宣室厘残贾谊归。",
        "疲马有情依枥叹，倦禽知困傍林飞。",
        "相君门下余尘在，拥篲应容一叩扉。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13719,
      "title": "老还",
      "content": [
        "老还东观复怀铅，坐对秋风鬓飒然。",
        "怨曲未平曾破瑟，故疮虽愈尚惊弦。",
        "萧条门巷张罗外，閴寂曹司搁笔前。",
        "借问不才为累否，古来山水尽天年。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13720,
      "title": "雪后与张转运任通判何都官游湖上",
      "content": [
        "湖天初日驻彤幨，雪霁楼台朔气严。",
        "浮隰浅花全裂缟，拂沙残白暂成盐。",
        "澌迎客棹容徐进，寒著宾罍喜细添。",
        "农壤徧膏民疠息，相君余兴付厌厌。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13721,
      "title": "离宛丘舟中作",
      "content": [
        "孑孑归樯五两斜，浮云尽处是京华。",
        "不随东鲁人浮海，正似新丰犬识家。",
        "笏首新荷寻珥笔，腰间故印解垂緺。",
        "多年蹇足蹒跚甚，却畏丹泥九墄赊。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13722,
      "title": "将还都寄献臣",
      "content": [
        "茂陵移病在穷年，尚省长安在日边。",
        "生意不随枯树尽，危心重伴死灰燃。",
        "秋风压苑檀栾近，夕斗横台睥睨连。",
        "侧注旧冠尘满屋，定须弹拂故人前。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13723,
      "title": "还都",
      "content": [
        "一封东走罢州麾，却趁清班上赤墀。",
        "侍史香炉留直夜，王孙春草见归时。",
        "虚名所頼天藏拙，晚岁无如病与衰。",
        "要在属车何所用，只堪盛酒比鸱夷。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13724,
      "title": "丞相庞公归政就第数有新诗传播都下偶成拙句上纪盛德二首  其一",
      "content": [
        "方道逍遥一品身，尽收和气付凝神。",
        "小车殿里抛丞相，南极星边伴老人。",
        "双鹤对眠云帐月，五芝催耨雨岩春。",
        "支离旧客公知否，私计东山作近邻。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13725,
      "title": "丞相庞公归政就第数有新诗传播都下偶成拙句上纪盛德二首  其二",
      "content": [
        "第门行马护清埃，拂席时时宴具开。",
        "安石风流今日是，平津宾客几人来。",
        "幄中谋熟君筹在，川上身闲汝檝回。",
        "绝俗新章满都纸，向时疏傅定无才。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13726,
      "title": "寄献南京致政杜相公",
      "content": [
        "调元罢后久忘机，三见东山拜诏时。",
        "言在典谟经舜问，规留廊庙许曹随。",
        "人间岁月尊黄发，方外讴谣续紫芝。",
        "举酒祝公千万寿，逍遥长与赤松期。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13727,
      "title": "答安陆王工部早春郡园见寄次韵",
      "content": [
        "五马新回金络头，方春稀讼释南囚。",
        "荆岑汉浒联形胜，渚月台风递宴游。",
        "自许良辰偏有感，不知清唱遂无俦。",
        "比来酒所闻相忆，对倚层城近此楼。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13728,
      "title": "送刘学士守衡阳兼还故里",
      "content": [
        "名帖唐家十二时，囊封自乞阮咸麾。",
        "三行牛酒过乡墅，九向云山驻使旗。",
        "兰露夕薰欢洁膳，桂风秋遣怨丛枝。",
        "不应晚计还台约，紫掖深沈𥩟演辞。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13729,
      "title": "晚秋北园二首  其一",
      "content": [
        "寂寥台榭使君家，日涉中园到日斜。",
        "林下归心纷似叶，菊前衰鬓晚于花。",
        "支离粟饱宁无愧，漫漶书成未足夸。",
        "犹有一杯相伴在，判从𫛸鴂耗年华。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13730,
      "title": "晚秋北园二首  其二",
      "content": [
        "午阴初转歇余喧，暂到高斋一凭轩。",
        "蒲芡因依残涨沼，枣梨狼藉晚秋园。",
        "轻凉著衽如堪掇，静境留人自不烦。",
        "须信吏中逢隠趣，随宜鲑菜伴芳樽。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13731,
      "title": "过洛阳有作",
      "content": [
        "鬰葱喜气抱天回，飞柱门深拂晓开。",
        "树绿远随驰道出，尘清曾傍属车来。",
        "雾中温洛浮仙牒，云表神崧荐寿杯。",
        "何日东都参第赋，班生犹是令兰台。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13732,
      "title": "闻中山公淝上家园新成秘奉阁辄抒拙诗寄献",
      "content": [
        "为乐东平得再麾，别营层阁驻经帏。",
        "溢囊秘简青皆汗，署榜宸毫白正飞。",
        "罇喜客来衔酒数，画疑仙去启厨稀。",
        "门前即枕春溪路，几曲歌成使舫归。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13733,
      "title": "移病还台凡阅半岁乃愈始到家园视园夫治畦植花因成自叹二首  其一",
      "content": [
        "十年独漉走天涯，耗尽流光得鬓华。",
        "犹喜此身随社燕，拟将何面对林花。",
        "牢骚续罢文谁读，块垒浇平酒自赊。",
        "旧隠不须相掉罄，要须归种邵平瓜。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13734,
      "title": "移病还台凡阅半岁乃愈始到家园视园夫治畦植花因成自叹二首  其二",
      "content": [
        "卧治无功赐告回，骤叨鸣履上中台。",
        "壶公天壤非真死，蒙叟轩裳是傥来。",
        "经灌早蔬扶陇出，失刊园蕊犯簷开。",
        "此身疏拙真丘壑，不是当年王佐才。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13735,
      "title": "送长兄游随阳",
      "content": [
        "汉东烟树露蝉嘶，回首周南涕易危。",
        "梁苑谩传居右赋，扶风谁识最良眉。",
        "仙巾雨垫愁怀路，素壁尘凝忆问诗。",
        "他夜梦魂知不远，蘧蘧长绕越禽枝。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13736,
      "title": "假节",
      "content": [
        "误持军印摄中牙，朔雪添成两鬓华。",
        "大抵不侯宁战罪，由来寡要是儒家。",
        "山南近暖先迎日，树北缘寒晚作花。",
        "岁晏知非宦情薄，颍田归兴满苍霞。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13737,
      "title": "览从兄咸剑池编",
      "content": [
        "竞爽吾宗属俊翘，凌云辞气剩飘飘。",
        "十年缔思轻伧赋，一骨评风压楚谣。",
        "纵玩书窗迷野马，长吟秋社续寒蜩。",
        "夫君自有何郎恨，枉使东阳臂肉销。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13738,
      "title": "少年",
      "content": [
        "关外车徒籍籍归，章街柳色绿如丝。",
        "薰衣别馆香三日，卜夜重楼烛九枝。",
        "雪市云回翻秘曲，蘅臯波暖寄微辞。",
        "十年酒美俄星弁，肯信尚书对有期。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13739,
      "title": "自咏  其一",
      "content": [
        "四十为郎信倦游，虚名缰锁太悠悠。",
        "危心正似葵倾日，衰质先于柳望秋。",
        "要路风尘疲骥足，故潭烟雨废槎头。",
        "颍滩渐报耕畴熟，终乞闲身守一丘。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
