{
  "data": [
    {
      "id": 257371,
      "title": "蒹葭",
      "content": [
        "摧折不自守，秋风吹若何。",
        "暂时花戴雪，几处叶沈波。",
        "体弱春风早，丛长夜露多。",
        "江湖后摇落，亦恐岁蹉跎。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 257372,
      "title": "苦竹",
      "content": [
        "青冥亦自守，輭弱强扶持。",
        "味苦夏虫避，丛卑春鸟疑。",
        "轩墀曾不重，剪伐欲无辞。",
        "幸近幽人屋，霜根结在兹。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 257373,
      "title": "除架",
      "content": [
        "束薪已零落，瓠叶转萧疎。",
        "幸结白花了，宁辞青蔓除。",
        "秋虫声不去，暮雀意何如。",
        "寒事今牢落，人生亦有初。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 257374,
      "title": "废畦",
      "content": [
        "秋蔬拥霜露，岂敢惜凋残。",
        "暮景数枝叶，天风吹汝寒。",
        "绿霑泥滓尽，香与岁时阑。",
        "生意春如昨，悲君白玉盘。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 257375,
      "title": "夕烽",
      "content": [
        "夕峰来不近，每日报平安。",
        "塞上传光小，云边落点残。",
        "照秦通警急，过陇自艰难。",
        "闻道蓬莱殿，千门立马看。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 257376,
      "title": "秋笛",
      "content": [
        "清商欲尽奏，奏苦血霑衣。",
        "他日伤心极，征人白骨归。",
        "相逢恐恨过，故作发声微。",
        "不见秋云动，悲风稍稍飞。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 257377,
      "title": "送远",
      "content": [
        "带甲满天地，胡为君远行。",
        "亲朋尽一哭，鞍马去孤城。",
        "草木岁月晚，关河霜雪清。",
        "别离已昨日，因见古人情。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 257378,
      "title": "观兵",
      "content": [
        "北庭送壮士，貔虎数尤多。",
        "精锐旧无敌，边隅今若何。",
        "妖氛拥白马，元帅待雕戈。",
        "莫守邺城下，斩鲸辽海波。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 257379,
      "title": "不归",
      "content": [
        "河间尚征伐，汝骨在空城。",
        "从弟人皆有，终身恨不平。",
        "数金怜俊迈，总角爱聪明。",
        "而上三年土，春风草又生。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 257380,
      "title": "天末忆李白",
      "content": [
        "凉风起天末，君子意如何。",
        "鸿雁几时到，江湖秋水多。",
        "文章憎命达，魑魅喜人过。",
        "应共冤魂语，投诗赠汩罗。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 257381,
      "title": "独立",
      "content": [
        "空外一鸷鸟，河间双白鸥。",
        "飘飖搏击便，容易往来游。",
        "草露亦多湿，蛛丝仍未收。",
        "天机近人事，独立万端忧。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 257382,
      "title": "日暮",
      "content": [
        "日落风亦起，城头鸟尾讹。",
        "黄云高未动，白水已扬波。",
        "羌妇语还哭，胡儿行且歌。",
        "将军别换马，夜出拥雕戈。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 257383,
      "title": "空囊",
      "content": [
        "翠柏苦犹食，晨霞高可餐。",
        "世人共卤莽，吾道属艰难。",
        "不爨井晨冻，无衣床夜寒。",
        "囊空恐羞涩，留得一钱看。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 257384,
      "title": "病马",
      "content": [
        "乘尔亦已久，天寒关塞深。",
        "尘中老尽力，岁晚病伤心。",
        "毛骨岂殊众，驯良犹至今。",
        "物微意不浅，感动一沈吟。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 257385,
      "title": "蕃劒",
      "content": [
        "致此自僻远，又非珠玉装。",
        "如何有奇怪，每夜吐光芒。",
        "虎气必腾趠，龙身宁久藏。",
        "风尘苦未息，持汝奉明王。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 257386,
      "title": "铜缾",
      "content": [
        "Ｂ乱后碧井废，时清瑶殿深。",
        "铜缾未失水，百丈有哀音。",
        "侧想美人意，应非寒甃沈。",
        "蛟龙半缺落，犹得折黄金。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 257387,
      "title": "观安西兵过赴关中待命二首 一",
      "content": [
        "四镇富精锐，摧锋皆绝伦。",
        "还闻献士卒，足以静风尘。",
        "老马夜知道，苍鹰饥著人。",
        "临危经久战，用急始如神。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 257388,
      "title": "观安西兵过赴关中待命二首 二",
      "content": [
        "奇兵不在众，万马救中原。",
        "谈笑无河北，心肝奉至尊。",
        "孤云随杀气，飞鸟避辕门。",
        "竟日留欢乐，城池未觉喧。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 257389,
      "title": "送人从军",
      "content": [
        "弱水应无地，阳关已近天。",
        "今君渡沙碛，累月断人烟。",
        "好武宁论命，封侯不计年。",
        "马寒防失道，雪没锦鞍鞯。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 257390,
      "title": "野望",
      "content": [
        "清秋望不极，迢遰起曾阴。",
        "远水兼天净，孤城隐雾深。",
        "叶稀风更落，山迥日初沈。",
        "独鹤归何晚，昏鸦已满林。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 257391,
      "title": "示姪佐",
      "content": [
        "多病秋风落，君来慰眼前。",
        "自闻茅屋趣，只想竹林眠。",
        "满谷山云起，侵篱涧水悬。",
        "嗣宗诸子姪，早觉仲容贤。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 257392,
      "title": "佐还山后寄三首 一",
      "content": [
        "山晚浮云合，归时恐路迷。",
        "涧寒人欲到，村黑鸟应栖。",
        "野客茅茨小，田家树木低。",
        "旧谙疎嬾叔，须汝故相携。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 257393,
      "title": "佐还山后寄三首 二",
      "content": [
        "白露黄粱熟，分张素有期。",
        "已应舂得细，颇觉寄来迟。",
        "味岂同金菊，香宜配绿葵。",
        "老人佗日爱，正想滑流匙。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 257394,
      "title": "佐还山后寄三首 三",
      "content": [
        "几道泉浇圃，交横落慢坡。",
        "葳蕤秋叶少，隐映野云多。",
        "隔沼连香芰，通林带女萝。",
        "甚闻霜薤白，重惠意如何。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 257395,
      "title": "从人觅小胡孙许寄",
      "content": [
        "人说南州路，山猨树树悬。",
        "举家闻若骇，为寄小如拳。",
        "预哂愁胡面，初调见马鞭。",
        "许求聪慧者，童稚捧应癫。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 257396,
      "title": "秋日阮隐居致薤三十束",
      "content": [
        "隐者柴门内，畦蔬绕舍秋。",
        "盈筐承露薤，不待致书求。",
        "束比青刍色，圆齐玉箸头。",
        "衰年关鬲冷，味煖幷无忧。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 257397,
      "title": "秦州见敕目薛三璩授司议郎毕四曜除监察与二子有故远喜迁官兼述索居凡三十韵",
      "content": [
        "大雅何寥阔，斯人尚典刑。",
        "交期余潦倒，材力尔精灵。",
        "二子声同日，诸生困一经。",
        "文章开穾奥，迁擢润朝廷。",
        "旧好何由展，新诗更忆听。",
        "别来头幷白，相见眼终青。",
        "伊昔贫皆甚，同忧心不宁。",
        "栖遑分半菽，浩荡逐流萍。",
        "俗态犹猜忌，妖氛忽杳冥。",
        "独慙投汉阁，俱议哭秦庭。",
        "远蜀祗无补，囚梁亦固扃。",
        "华夷相混合，宇宙一膻腥。",
        "帝力收三统，天威总四溟。",
        "旧都俄望幸，清庙肃惟馨。",
        "杂种虽高垒，长驱甚建瓴。",
        "焚香淑景殿，涨水望云亭。",
        "法驾初还日，群公若会星。",
        "宫臣仍点染，柱史正零丁。",
        "官忝趋栖凤，朝回叹聚萤。",
        "唤人看腰褭，不嫁惜娉婷。",
        "掘劒知埋狱，提刀见发硎。",
        "侏儒应共饱，渔父忌偏醒。",
        "旅泊穷清渭，长吟望浊泾。",
        "羽书还似急，烽火未全停。",
        "师老资残寇，戎生及近坰。",
        "忠臣辞愤激，烈士涕飘零。",
        "上将盈边鄙，元勋溢鼎铭。",
        "仰思调玉烛，谁定握青萍。",
        "陇俗轻鹦鹉，原情类鹡鸰。",
        "秋风动关塞，高卧想仪行。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 257398,
      "title": "寄彭州高三十五使君适虢州岑二十七长史参三十韵",
      "content": [
        "故人何寂寞，今我独凄凉。",
        "老去才难尽，秋来兴甚长。",
        "物情尤可见，辞客未能忘。",
        "海内知名士，云端各异方。",
        "高岑殊缓步，沈鲍得同行。",
        "意惬关飞动，篇终接混茫。",
        "举天悲富骆，近代惜卢王。",
        "似尔官仍贵，前贤命可伤。",
        "诸侯非弃掷，半刺已翱翔。",
        "诗好几时见，书成无信将。",
        "男儿行处是，客子鬬身强。",
        "羁旅推贤圣，沈绵抵咎殃。",
        "三年犹疟疾，一鬼不销亡。",
        "隔日搜脂髓，增寒抱雪霜。",
        "徒然潜隙地，有腼屡鲜妆。",
        "何太龙钟极，于今出处妨。",
        "无钱居帝里，尽室在边疆。",
        "刘表虽遗恨，庞公至死藏。",
        "心微傍鱼鸟，肉瘦怯豺狼。",
        "陇草萧萧白，洮云片片黄。",
        "彭门劒阁外，虢略鼎湖旁。",
        "荆玉簪头冷，巴笺染翰光。",
        "乌麻蒸续晒，丹橘露应尝。",
        "岂异神仙宅，俱兼山水乡。",
        "竹斋烧药灶，花屿读书床。",
        "更得清新否，遥知对属忙。",
        "旧宫宁改汉，淳俗本归唐。",
        "济世宜公等，安贫亦士常。",
        "蚩尤终戮辱，胡羯漫猖狂。",
        "会待祅氛静，论文暂裹粮。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 257399,
      "title": "寄岳州贾司马六丈巴州严八使君两阁老五十韵",
      "content": [
        "衡岳啼猨里，巴州鸟道边。",
        "故人俱不利，谪宦两悠然。",
        "开辟乾坤正，荣枯雨露偏。",
        "长沙才子远，钓濑客星悬。",
        "忆昨趋行殿，殷忧捧御筵。",
        "讨胡愁李广，奉使待张骞。",
        "无复云台仗，虚修水战船。",
        "苍茫城七十，流落劒三千。",
        "画角吹秦晋，旄头俯涧瀍。",
        "小儒轻董卓，有识笑苻坚。",
        "浪作禽填海，那将血射天。",
        "万方思助顺，一鼓气无前。",
        "阴散陈仓北，晴熏太白巅。",
        "乱麻尸积卫，破竹势临燕。",
        "法驾还双阙，王师下八川。",
        "此时霑奉引，佳气拂周旋。",
        "貔虎开金甲，麒麟受玉鞭。",
        "侍臣谙入仗，厩马解登仙。",
        "花动朱楼雪，城凝碧树烟。",
        "衣冠心惨怆，故老泪潺湲。",
        "哭庙悲风急，朝正霁景鲜。",
        "月分梁汉米，春得水衡钱。",
        "内蘂繁于缬，宫莎輭胜緜。",
        "恩荣同拜手，出入最随肩。",
        "晚著华堂醉，寒重绣被眠。",
        "辔齐兼秉烛，书枉满怀牋。",
        "每觉升元辅，深期列大贤。",
        "秉钧方咫尺，铩翮再聊翩。",
        "禁掖朋从改，微班性命全。",
        "青蒲甘受戮，白发竟谁怜。",
        "弟子贫原宪，诸生老伏虔。",
        "师资谦未达，乡党敬何先。",
        "旧好肠堪断，新愁眼欲穿。",
        "翠干危栈竹，红腻小湖莲。",
        "贾笔论孤愤，严诗赋几篇。",
        "定知深意苦，莫使众人传。",
        "贝锦无停织，朱丝有断弦。",
        "浦鸥防碎首，霜鹘不空拳。",
        "地僻昏炎瘴，山稠隘石泉。",
        "且将棋度日，应用酒为年。",
        "典郡终微眇，治中实弃捐。",
        "安排求傲吏，比兴展归田。",
        "去去才难得，苍苍理又玄。",
        "古人称逝矣，吾道卜终焉。",
        "陇外飜投迹，渔阳复控弦。",
        "笑为妻子累，甘与岁时迁。",
        "亲故行稀少，兵戈动接联。",
        "他乡饶梦寐，失侣自屯邅。",
        "多病加淹泊，长吟阻静便。",
        "如公尽雄俊，志在必腾骞。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 257400,
      "title": "寄张十二山人彪三十韵",
      "content": [
        "独卧蒿阳客，三违颍水春。",
        "艰难随老母，惨澹向时人。",
        "谢氏寻山屐，陶公漉酒巾。",
        "群凶弥宇宙，此物在风尘。",
        "历下辞姜被，关西得孟邻。",
        "早通交契密，晚接道流新。",
        "静者心多妙，先生艺绝伦。",
        "草书何太苦，诗兴不无神。",
        "曹植休前辈，张芝更后身。",
        "数篇吟可老，一字买堪贫。",
        "将恐曾防寇，深潜托所亲。",
        "宁闻倚门夕，尽力洁飧晨。",
        "疎嬾为名误，驱驰丧我真。",
        "索居犹寂寞，相遇益悲辛。",
        "流转依边徼，逢迎念席珍。",
        "时来故旧少，乱后别离频。",
        "世祖修高庙，文公赏从臣。",
        "商山犹入楚，源水不离秦。",
        "存想青龙秘，骑行白鹿驯。",
        "耕岩非谷口，结草即河滨。",
        "肘后符应验，囊中药未陈。",
        "旅怀殊不惬，良觌渺无因。",
        "自古皆悲恨，浮生有屈伸。",
        "此邦今尚武，何处且依仁。",
        "鼓角凌天籁，关山信月轮。",
        "官场罗镇碛，贼火近洮岷。",
        "萧索论兵地，苍茫鬬将辰。",
        "大军多处所，余孽尚纷纶。",
        "高兴知笼鸟，斯文起获麟。",
        "穷秋正摇落，回首望松筠。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 257401,
      "title": "寄李十二白二十韵",
      "content": [
        "昔年有狂客，号尔谪仙人。",
        "笔落惊风雨，诗成泣鬼神。",
        "声名从此大，汩没一朝伸。",
        "文彩承殊渥，流传必绝伦。",
        "龙舟移櫂晚，兽锦夺袍新。",
        "白日来深殿，青云满后尘。",
        "乞归优诏许，遇我宿心亲。",
        "未负幽栖志，兼全宠辱身。",
        "剧谈怜野逸，嗜酒见天真。",
        "醉舞梁园夜，行歌泗水春。",
        "才高心不展，道屈善无邻。",
        "处士祢衡俊，诸生原宪贫。",
        "稻粱求未足，薏苡谤何频。",
        "五岭炎蒸地，三危放逐臣。",
        "几年遭𫛳鸟，独泣向麒麟。",
        "苏武先还汉，黄公岂事秦。",
        "楚筵辞醴日，梁狱上书辰。",
        "已用当时法，谁将此义陈。",
        "老吟秋月下，病起暮江滨。",
        "莫怪恩波隔，乘槎与问津。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 257402,
      "title": "蜀相",
      "content": [
        "丞相祠堂何处寻，锦官城外柏森森。",
        "映堦碧草自春色，隔叶黄鹂空好音。",
        "三顾频烦天下计，两朝开济老臣心。",
        "出师未捷身先死，长使英雄泪满襟。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 257403,
      "title": "卜居",
      "content": [
        "浣花流水水西头，主人为卜林塘幽。",
        "已知出郭少尘事，更有澄江销客愁。",
        "无数蜻蜓齐上下，一双㶉𫛶对沈浮。",
        "东行万里堪乘兴，须向山阴上小舟。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 257404,
      "title": "一室",
      "content": [
        "一室他乡远，空林暮景悬。",
        "正愁闻塞笛，独立见江船。",
        "巴蜀来多病，荆蛮去几年。",
        "应同王粲宅，留井岘山前。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 257405,
      "title": "梅雨",
      "content": [
        "南京西浦道，四月熟黄梅。",
        "湛湛长江去，冥冥细雨来。",
        "茅茨疎易湿，云雾密难开。",
        "竟日蛟龙喜，盘涡与岸回。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 257406,
      "title": "为农",
      "content": [
        "锦里烟尘外，江村八九家。",
        "圆荷浮小叶，细麦落轻花。",
        "卜宅从兹老，为农去国赊。",
        "远惭句漏令，不得问丹砂。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 257407,
      "title": "有客",
      "content": [
        "幽栖地僻经过少，老病人扶再拜难。",
        "岂有文章惊海内，漫劳车马驻江干。",
        "竟日淹留佳客坐，百年麤粝腐儒餐。",
        "不嫌野外无供给，乘兴还来看药栏。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 257408,
      "title": "狂夫",
      "content": [
        "万里桥西一，草堂，百花潭水即沧浪。",
        "风含翠筿娟娟静，雨裛红蕖冉冉香。",
        "厚禄故人书断绝，恒饥稚子色凄凉。",
        "欲填沟壑唯疎放，自笑狂夫老更狂。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 257409,
      "title": "宾至",
      "content": [
        "患气经时久，临江卜宅新。",
        "喧卑方避俗，疎快颇宜人。",
        "有客过茅宇，呼儿正葛巾。",
        "自锄稀菜甲，小摘为情亲。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 257410,
      "title": "王十五司马弟出郭相访兼遗营茅屋赀",
      "content": [
        "客里何迁次，江边正寂寥。",
        "肯来寻一老，愁破是今朝。",
        "忧我营茅栋，携钱过野桥。",
        "他乡唯表弟，还往莫辞遥。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 257411,
      "title": "堂成",
      "content": [
        "背郭堂成荫白茅，缘江路熟俯青郊。",
        "桤林碍日吟风叶，笼竹和烟滴露梢。",
        "暂止飞乌将数子，频来语燕定新巢。",
        "旁人错比扬雄宅，嬾惰无心作解嘲。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 257412,
      "title": "田舍",
      "content": [
        "田舍清江曲，柴门古道旁。",
        "草深迷市井，地僻嬾衣裳。",
        "榉柳枝枝弱，枇杷树树香。",
        "鸬鹚西日照，晒翅满鱼梁。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 257413,
      "title": "进艇",
      "content": [
        "南京久客耕南亩，北望伤神坐北窗。",
        "昼引老妻乘小艇，晴看稚子浴清江。",
        "俱飞蛱蝶元相逐，并蔕芙蓉本自双。",
        "茗饮蔗浆携所有，瓷甖无谢玉为缸。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 257414,
      "title": "西郊",
      "content": [
        "时出碧鸡坊，西郊向草堂。",
        "市桥官柳细，江路野梅香。",
        "傍架齐书帙，看题减药囊。",
        "无人觉来往，疎嬾意何长。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 257415,
      "title": "所思",
      "content": [
        "苦忆荆州醉司马，谪官樽俎定常开。",
        "九江日落醒何处，一柱观头眠几回。",
        "可怜怀抱向人尽，欲问平安无使来。",
        "故凭锦水将双泪，好过瞿塘滟滪堆。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 257416,
      "title": "江村",
      "content": [
        "清江一曲抱村流，长夏江村事事幽。",
        "自去自来堂上燕，相亲相近水中鸥。",
        "老妻画纸为碁局，稚子敲针作钓钩。",
        "多病所须唯药物，微躯此外更何求。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 257417,
      "title": "江涨",
      "content": [
        "江涨柴门外，儿童报急流。",
        "下床高数尺，倚杖没中洲。",
        "细动迎风燕，轻摇逐浪鸥。",
        "渔人萦小楫，容易拔船头。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 257418,
      "title": "野老",
      "content": [
        "野老篱前江岸回，柴门不正逐江开。",
        "渔人网集澄潭下，贾客船随返照来。",
        "长路关心悲劒阁，片云何意傍琴台。",
        "王师未报收东郡，城阙秋生画角哀。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 257419,
      "title": "云山",
      "content": [
        "京洛云山外，音书静不来。",
        "神交作赋客，力尽望乡台。",
        "衰疾江边卧，亲朋日暮回。",
        "白鸥元水宿，何事有余哀。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 257420,
      "title": "遣兴",
      "content": [
        "干戈犹未定，弟妹各何之。",
        "拭泪霑襟血，梳头满面丝。",
        "地卑荒野大，天远暮江迟。",
        "衰疾那能久，应无见汝时。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 257421,
      "title": "北邻",
      "content": [
        "明府岂辞满，藏身方告劳。",
        "青钱买野竹，白帻岸江臯。",
        "爱酒晋山简，能诗何水曹。",
        "时来访老疾，步屧到蓬蒿。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 257422,
      "title": "南邻",
      "content": [
        "锦里先生乌角巾，园收芋粟不全贫。",
        "惯看宾客儿童喜，得食阶除鸟雀驯。",
        "秋水才深四五尺，野航恰受两三人。",
        "白沙翠竹江村暮，相对柴门月色新。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 257423,
      "title": "出郭",
      "content": [
        "霜露晚凄凄，高天逐望低。",
        "远烟盐井上，斜景雪峰西。",
        "故国犹兵马，他乡亦鼓鼙。",
        "江城今夜客，还与旧乌啼。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 257424,
      "title": "过南邻朱山人水亭",
      "content": [
        "相近竹参差，相过人不知。",
        "幽花欹满树，小水细通池。",
        "归客村非远，残樽席更移。",
        "看君多道气，从此数追随。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 257425,
      "title": "恨别",
      "content": [
        "洛城一别四千里，胡骑长驱五六年。",
        "草木变衰行劒外，兵戈阻绝老江边。",
        "思家步月清宵立，忆弟看云白日眠。",
        "闻道河阳近乘胜，司徒急为破幽燕。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 257426,
      "title": "寄贺兰铦",
      "content": [
        "朝野欢娱后，乾坤震荡中。",
        "相随万里日，总作白头翁。",
        "岁晚仍分袂，江边更转蓬。",
        "勿云俱异域，饮啄几回同。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 257427,
      "title": "寄杨五桂州谭",
      "content": [
        "五岭皆炎热，宜人独桂林。",
        "梅花万里外，雪片一冬深。",
        "闻此宽相忆，为邦复好音。",
        "江边送孙楚，远附白头吟。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 257428,
      "title": "逢唐兴刘主簿弟",
      "content": [
        "分手开元末，连年绝尺书。",
        "江山且相见，戎马未安居。",
        "劒外官人冷，关中驿骑疎。",
        "轻舟下吴会，主簿意何如。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 257429,
      "title": "和裴迪登新津寺寄王侍郎",
      "content": [
        "何限倚山木，吟诗秋叶黄。",
        "蝉声集古寺，鸟影度寒塘。",
        "风物悲游子，登临忆侍郎。",
        "老夫贪佛日，随意宿僧房。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 257430,
      "title": "敬简王明府",
      "content": [
        "叶县郎官宰，周南太史公。",
        "神仙才有数，流落意无穷。",
        "骥病思偏秣，鹰愁怕苦笼。",
        "看君用高义，耻与万人同。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 257431,
      "title": "重简王明府",
      "content": [
        "甲子西南异，冬来只薄寒。",
        "江云何夜尽，蜀雨几时干。",
        "行李须相问，穷愁岂有宽。",
        "君听鸿鴈响，恐致稻粱难。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 257432,
      "title": "建都十二韵",
      "content": [
        "苍生未苏息，胡马半乾坤。",
        "议在云台上，谁扶黄屋尊。",
        "建都分魏阙，下韶辟荆门。",
        "恐失东人望，其如西极存。",
        "时危当雪耻，计大岂轻论。",
        "虽倚三阶正，终愁万国飜。",
        "牵裾恨不死，漏网荷殊恩。",
        "永负汉庭哭，遥怜湘水魂。",
        "穷冬客江劒，随事有田园。",
        "风断青蒲节，霜埋翠竹根。",
        "衣冠空穰穰，关辅久昏昏。",
        "愿枉长安日，光辉照北原。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 257433,
      "title": "岁暮",
      "content": [
        "岁暮远为客，边隅还用兵。",
        "烟尘犯雪岭，鼓角动江城。",
        "天地日流血，朝廷谁请缨。",
        "济时敢爱死，寂寞壮心惊。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 257434,
      "title": "和裴迪登蜀州东亭送客逢早梅相忆见寄",
      "content": [
        "东阁官梅动诗兴，还如何逊在扬州。",
        "此时对雪遥相忆，送客逢春可自由。",
        "幸不折来伤岁暮，若为看去乱乡愁。",
        "江边一树垂垂发，朝夕催人自白头。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 257435,
      "title": "寄赠王十将军承俊",
      "content": [
        "将军胆气雄，臂悬两角弓。",
        "缠结青骢马，出入锦城中。",
        "时危未授钺，势屈难为功。",
        "宾客满堂上，何人高义同。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 257436,
      "title": "暮登四安寺钟楼寄裴十",
      "content": [
        "暮倚高楼对雪峰，僧来不语自鸣钟。",
        "孤城返照红将歛，近市浮烟翠且重。",
        "多病独愁常閴寂，故人相见未从容。",
        "知君苦思缘诗瘦，大向交游万事慵。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 257437,
      "title": "散愁二首 一",
      "content": [
        "久客宜旋斾，兴王未息戈。",
        "蜀星阴见少，江雨夜闻多。",
        "百万传深入，寰区望匪它。",
        "司徒下燕赵，收取旧山河。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 257438,
      "title": "散愁二首 二",
      "content": [
        "闻道幷州镇，尚书训士齐。",
        "几时通蓟北，当日报关西。",
        "恋阙丹心破，霑衣皓首啼。",
        "老魂招不得，归路恐长迷。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 257439,
      "title": "奉酬李都督表丈早春作",
      "content": [
        "力疾坐清晓，来时悲早春。",
        "转添愁伴客，更觉老随人。",
        "红入桃花嫩，青归柳叶新。",
        "望乡应未已，四海尚风尘。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 257440,
      "title": "客至",
      "content": [
        "舍南舍北皆春水，但见群鸥日日来。",
        "花径不曾缘客扫，蓬门今始为君开。",
        "盘餐市远无兼味，樽酒家贫只旧醅。",
        "肯与邻翁相对饮，隔篱呼取尽余桮。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 257441,
      "title": "遣意二首 一",
      "content": [
        "啭枝黄鸟近，泛渚白鸥轻。",
        "一径野花落，孤村春水生。",
        "衰年催酿黍，细雨更移橙。",
        "渐喜交游绝，幽居不用名。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 257442,
      "title": "遣意二首 二",
      "content": [
        "簷影微微落，津流脉脉斜。",
        "野船明细火，宿鴈聚圆沙。",
        "云掩初弦月，香传小树花。",
        "邻人有美酒，稚子夜能赊。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 257443,
      "title": "漫成二首 一",
      "content": [
        "野日荒荒白，春流泯泯清。",
        "渚蒲随地有，村径逐门成。",
        "只作披衣惯，常从漉酒生。",
        "眼前无俗物，多病也身轻。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 257444,
      "title": "漫成二首 二",
      "content": [
        "江臯已仲春，花下复清晨。",
        "仰面贪看鸟，回头错应人。",
        "读书难字过，对酒满壶频。",
        "近识峨眉老，知予嬾是真。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 257445,
      "title": "春夜喜雨",
      "content": [
        "好雨知时节，当春乃发生。",
        "随风潜入夜，润物细无声。",
        "野径云俱黑，江船火独明。",
        "晓看红湿处，花重锦官城。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 257446,
      "title": "春水",
      "content": [
        "三月桃花浪，江流复旧痕。",
        "朝来没沙尾，碧色动柴门。",
        "接缕垂芳饵，连筒灌小园。",
        "已添无数鸟，争浴故相喧。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 257447,
      "title": "春水生二绝 一",
      "content": [
        "二月六夜春水生。",
        "门前小滩浑欲平，鸬鹚㶉𫛶莫漫喜。",
        "吾与汝曹俱眼明。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 257448,
      "title": "春水生二绝 二",
      "content": [
        "一夜水高二尺强，数日不可更禁当。",
        "南市津头有船卖，无钱即买系篱旁。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 257449,
      "title": "江亭",
      "content": [
        "坦腹江亭暖，长吟野望时。",
        "水流心不竞，云在意俱迟。",
        "寂寂春将晚，欣欣物自私。",
        "故林归未得，排闷强裁诗。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 257450,
      "title": "村夜",
      "content": [
        "萧萧风色暮，江头人不行。",
        "村舂雨外急，邻火夜深明。",
        "胡羯何多难，渔樵寄此生。",
        "中原有兄弟，万里正含情。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 257451,
      "title": "早起",
      "content": [
        "春来常早起，幽事颇相关。",
        "帖石防隤岸，开林出远山。",
        "一丘藏曲折，缓步有跻攀。",
        "童仆来城市，瓶中得酒还。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 257452,
      "title": "可惜",
      "content": [
        "花飞有底急，老去愿春迟。",
        "可惜欢娱地，都非少壮时。",
        "宽心应是酒，遣兴莫过诗。",
        "此意陶潜解，吾生后汝期。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 257453,
      "title": "落日",
      "content": [
        "落日在帘钩，溪边春事幽。",
        "芳菲缘岸圃，樵爨倚滩舟。",
        "啅雀争枝坠，飞虫满院游。",
        "浊醪谁造汝，一酌散千忧。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 257454,
      "title": "独酌",
      "content": [
        "步屦深林晚，开樽独酌迟。",
        "仰蜂黏落絮，行蚁上枯梨。",
        "薄劣惭真隐，幽偏得自怡。",
        "本无轩冕意，不是傲当时。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 257455,
      "title": "徐步",
      "content": [
        "整履步青芜，荒庭日欲晡。",
        "芹泥随燕觜，花蘂上蜂须。",
        "把酒从衣湿，吟诗信杖扶。",
        "敢论才见忌，实有醉如愚。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 257456,
      "title": "寒食",
      "content": [
        "寒食江村路，风花高下飞。",
        "汀烟轻冉冉，竹日静晖晖。",
        "田父要皆去，邻家闹不违。",
        "地偏相识尽，鸡犬亦忘归。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 257457,
      "title": "高柟",
      "content": [
        "柟树色冥冥，江边一盖青。",
        "近根开药圃，接叶制茅亭。",
        "落景阴犹合，微风韵可听。",
        "寻常绝醉困，卧此片时醒。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 257458,
      "title": "恶树",
      "content": [
        "独遶虚斋径，常持小斧柯。",
        "幽阴成颇杂，恶木剪还多。",
        "枸杞因吾有，鸡栖奈汝何。",
        "方知不材者，生长漫婆娑。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 257459,
      "title": "石镜",
      "content": [
        "蜀王将此镜，送死置空山。",
        "冥寞怜香骨，提携近玉颜。",
        "众妃无复叹，千骑亦虚还。",
        "独有伤心石，埋轮月宇间。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 257460,
      "title": "琴台",
      "content": [
        "茂陵多病后，尚爱卓文君。",
        "酒肆人间世，琴台日暮云。",
        "野花留宝靥，蔓草见罗帬。",
        "归凤求皇意，寥寥不复闻。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 257461,
      "title": "闻斛斯六官未归",
      "content": [
        "故人南郡去，去索作碑钱。",
        "本卖文为活，飜令室倒悬。",
        "荆扉深蔓草，土锉冷疎烟。",
        "老罢休无赖，归来省醉眠。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 257462,
      "title": "游修觉寺",
      "content": [
        "野寺江天豁，山扉花竹幽。",
        "诗应有神助，吾得及春游。",
        "径石相萦带，川云自去留。",
        "禅枝宿众鸟，漂转暮归愁。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 257463,
      "title": "后游",
      "content": [
        "寺忆新游处，桥怜再渡时。",
        "江山如有待，花柳更无私。",
        "野润烟光薄，沙暄日色迟。",
        "客愁全为减，舍此复何之。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 257464,
      "title": "题新津北桥楼",
      "content": [
        "望极春城上，开筵近鸟巢。",
        "白花簷外朵，青柳槛前梢。",
        "池水观为政，厨烟觉远庖。",
        "西川供客眼，唯有此江郊。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 257465,
      "title": "江涨",
      "content": [
        "江发蛮夷涨，山添雨雪流。",
        "大声吹地转，高浪蹴天浮。",
        "鱼鳖为人得，蛟龙不自谋。",
        "轻帆好去便，吾道付沧洲。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 257466,
      "title": "晚晴",
      "content": [
        "村晚惊风度，庭幽过雨霑。",
        "夕阳薰细草，江色映疎帘。",
        "书乱谁能帙，桮干可自添。",
        "时闻有余论，未怪老夫潜。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 257467,
      "title": "朝雨",
      "content": [
        "凉气晚萧萧，江云乱眼飘。",
        "风鸳藏近渚，雨燕集深条。",
        "黄绮终辞汉，巢由不见尧。",
        "草堂樽酒在，幸得过清朝。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 257468,
      "title": "江上值水如海势聊短述",
      "content": [
        "为人性僻耽佳句，语不惊人死不休。",
        "老去诗篇浑漫兴，春来花鸟莫深愁。",
        "新添水槛供垂钓，故著浮槎替入舟。",
        "焉得思如陶谢手，令渠述作与同游。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 257469,
      "title": "送裴五赴东川",
      "content": [
        "故人亦流落，高义动乾坤。",
        "何日通燕塞，相看老蜀门。",
        "东行应暂别，北望苦销魂。",
        "凛凛悲秋意，非君谁与论。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 257470,
      "title": "赴青城县出成都寄陶王二少尹",
      "content": [
        "老耻妻孥笑，贫嗟出入劳。",
        "客情投异县，诗态忆吾曹。",
        "东郭沧江合，西山白雪高。",
        "文章差底病，回首兴滔滔。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    }
  ],
