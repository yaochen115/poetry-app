{
  "data": [
    {
      "id": 209847,
      "title": "海康书事十首  其九",
      "content": [
        "一雨复一旸，苍茫飓风发。",
        "怒号兼昼夜，山海为颠蹶。",
        "云何大块噫，乃尔不可遏。",
        "黎明众窍虚，白日丽空阔。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 209848,
      "title": "海康书事十首  其一○",
      "content": [
        "合浦古珠池，一熟胎如山。",
        "试问池边蜑，云今累年闲。",
        "岂无明月珍，转徙溟渤间。",
        "何关二千石，时至自当还。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 209849,
      "title": "次韵曾存之啸竹轩",
      "content": [
        "翩翩曾公子，子猷定前身。",
        "嗜好准畴昔，了然不缁磷。",
        "寄食平准官，植竹当比邻。",
        "朝与竹相对，暮与竹相亲。",
        "安可一日无，此君真可人。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 209850,
      "title": "游仙二首  其一",
      "content": [
        "服形百神朝，刳心万缘尽。",
        "我无退转境，何以有精进。",
        "戏为汗漫游，八极一何近。",
        "渺渺东海水，累累北邙坟。",
        "向来歌舞处，忽复成荒村。",
        "愚人如鹿耳，其死了无魂。",
        "孰知九霄间，玄圃枕昆仑。",
        "缁尘化人衣，苍萝谁与扪。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 209851,
      "title": "游仙二首  其二",
      "content": [
        "云车自天来，驾言游混茫。",
        "手持太一节，身佩使者章。",
        "龙虎傍夭矫，马龟伏以翔。",
        "朝元紫微上，所睹浩难量。",
        "宝网结万珠，参伍相焜煌。",
        "花品不知数，妙英拆玄房。",
        "宫殿随人身，处处辄清凉。",
        "危髾擢贞玉，高谢人间妆。",
        "二三古须眉，冠云带含光。",
        "遗我飞霞佩，副以明月珰。",
        "再拜敬服之，百毛发灵香。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 209852,
      "title": "次韵答张文潜病中见寄",
      "content": [
        "与君涉世网，所得如钩温。",
        "念昔相乖离，俯仰变寒暄。",
        "把袂安可期，寄书嘱加餐。",
        "三年汝水滨，孤怀谁与言。",
        "末路非所望，联镳金马门。",
        "校文多豫暇，玄谈到羲轩。",
        "孰云笭箵小，史书垂后昆。",
        "匪惟以旧闻，抵牾良可刊。",
        "比枉病中作，笔端淮海奔。",
        "亟驾问所苦，兀坐一室闲。",
        "晤对不知夕，归途斗星翻。",
        "平时带十围，颇复减臂环。",
        "君其专精神，微恙不足论。",
        "恺悌神所劳，此理直如弦。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 209853,
      "title": "送乔希圣",
      "content": [
        "鷃翔蓬蒿非所悲，鹏击风云非所喜。",
        "贵贱穷通尽偶然，回头总是东海水。",
        "我思田文昔相齐，朱袍照日如云霓。",
        "三千冠珮醉明月，清歌一曲倾玻璃。",
        "如今陈迹知何在，但见荒冢烟芜迷。",
        "又思原宪昔居鲁，门户东西闭环堵。",
        "杖藜对客骋高谈，自觉胸襟辈尧禹。",
        "如今寂寞已成尘，空有声名挂千古。",
        "送君去，何时回，世间如此令人哀。",
        "我徒驻足不可久，笑指白云归去来。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 209854,
      "title": "与子瞻会松江得浪字",
      "content": [
        "松江浩无旁，垂虹跨其上。",
        "漫然衔洞庭，领略非一状。",
        "怳如阵平野，万马攒穹帐。",
        "离离云抹山，窅窅天粘浪。",
        "烟中渔唱起，鸟外征帆飏。",
        "愈知宇宙宽，斗觉东南壮。",
        "太史主文盟，诸豪尽诗将。",
        "超摇外形检，语笑供颉顽。",
        "㛹娟弃不追，拨剌亦从放。",
        "独留三百缸，聊用沃轩旷。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 209855,
      "title": "德清道中还寄子瞻",
      "content": [
        "投晓理竿栧，溪行耳目醒。",
        "虫鱼各萧散，云日共晶荧。",
        "水荇重深翠，烟山叠乱青。",
        "路回逢短榜，崖断点孤翎。",
        "丛薄开罗帐，沦漪写镜屏。",
        "疏篱窥窅窕，支港泛笭箵。",
        "远溆依微见，哀猱断续听。",
        "梦长天杳杳，人远树冥冥。",
        "旅思摇风旆，归期数月蓂。",
        "何时燃蜜炬，复听合前铃。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 209856,
      "title": "次韵子由题斗野亭",
      "content": [
        "满市花风起，平堤漕水流。",
        "不堪春解手，更为晚停舟。",
        "古埭天连雁，荒祠木蔽牛。",
        "杖藜聊复尔，转盼夕烟浮。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 209857,
      "title": "鲜于子骏使君生日",
      "content": [
        "惟昔高堂梦，熊罴兆吉占。",
        "气钟西蜀秀，时应仲秋严。",
        "江汉挥犀尾，风云下笔尖。",
        "微辞追屈宋，精义到黄炎。",
        "操履森寒栢，名声耿夜蟾。",
        "击彊雕鹗健，治剧䴙鹈铦。",
        "使者旌旄易，将军印绶添。",
        "鸳鸿随步武，虎豹入韬钤。",
        "锦覆郎官被，彤垂太守襜。",
        "两行分蜜炬，十里上珠帘。",
        "礼士常悬榻，诛奸或奋髯。",
        "雨堂昏绛帐，风帙乱牙签。",
        "银汉星初换，金茎露已霑。",
        "欢声连北固，寿邑亘东渐。",
        "丽句充文几，奇香牣玉奁。",
        "簪绅五福具，罇俎四难兼。",
        "贱子真殊幸，清标获屡觇。",
        "误蒙雕朽木，猥辱画无盐。",
        "嘉运方熙洽，英才岂滞淹。",
        "伫公归法从，行道慰民瞻。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 209858,
      "title": "辇下春晴",
      "content": [
        "楼阙过朝雨，参差动霁光。",
        "衣冠纷禁路，云气绕宫墙。",
        "乱絮迷春阔，荐花困日长。",
        "经旬辜酒伴，犹未献长杨。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 209859,
      "title": "睡起",
      "content": [
        "睡起东轩下，悠悠春绪长。",
        "爬搔失幽啭，款欠堕危芳。",
        "蛛网留晴絮，蜂房受晚香。",
        "欲寻初断梦，云雾已冥茫。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 209860,
      "title": "次韵莘老初至汤泉",
      "content": [
        "夹路山重复，参天树老苍。",
        "一区成小市，数埒引温汤。",
        "洗沐同幽客，𫗦餐就梵坊。",
        "未输朝市子，斗酒得西凉。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 209861,
      "title": "过六合水亭怀裴博士次韵",
      "content": [
        "晚憩孤亭上，羸骖系断柯。",
        "荒门寒带路，空槛阔增波。",
        "往事青山在，余生白鸟过。",
        "诵言成绝唱，亹亹迫阴何。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 209862,
      "title": "怀孙子实",
      "content": [
        "举眼趋浮末，斯人独好修。",
        "青春三不惑，黄卷百无忧。",
        "玉出方流润，鸾停翠竹幽。",
        "相思自成韵，不必寄西邮。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 209863,
      "title": "对淮南诏狱二首  其一",
      "content": [
        "一室如悬磬，人音尽不闻。",
        "老兵随卧起，漂母给朝曛。",
        "樊雉思秋野，鞲鹰望暮云。",
        "念归忘食事，日减臂环分。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 209864,
      "title": "对淮南诏狱二首  其二",
      "content": [
        "淮海行摇落，文书亦罢休。",
        "风霜欺独宿，灯火伴冥搜。",
        "笳动朱楼晓，参横粉堞秋。",
        "更拚飞镜破，应得大刀头。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 209865,
      "title": "次韵答米元章",
      "content": [
        "嗜好清无滓，周旋粲有文。",
        "挥毫春在手，岸帻海生云。",
        "花鸟空撩我，莼鲈正属君。",
        "惟应读雌蜺，差不愧王筠。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 209866,
      "title": "宿参寥房",
      "content": [
        "乡国秋行暮，房栊日已暝。",
        "惊风多犯竹，破月不藏星。",
        "钩箔簷花动，抄书烛烬零。",
        "非关相见喜，自是眼长青。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 209867,
      "title": "次韵蒋颖叔南郊祭告上清储祥宫",
      "content": [
        "特起朝阳内，祠宫极邃清。",
        "高窗闚玉女，巨𫔶守昌明。",
        "盛掩秦诸畤，雄逾汉两京。",
        "垣横天上紫，洲露海中瀛。",
        "黄帝初龙跃，中原罢虎争。",
        "樵夫亦谈道，行旅不持兵。",
        "此地修禳禬，于时保利亨。",
        "栢梁灾未几，陈宝诏重营。",
        "御帑金缯出，慈闱服玩并。",
        "标题动宸翰，撰次属鸿生。",
        "玉刻黄冠印，金书秘殿名。",
        "妙经藏洞观，真箓佩威盟。",
        "仙溜花间静，琼枝物外荣。",
        "肇禋承帝祉，肆眚顺民情。",
        "天施宁论报，风行不计程。",
        "近传闻磬管，时或见旄旌。",
        "海岳朝双阙，星辰集上楹。",
        "礼如尊太一，事异宠文成。",
        "大以圆丘报，长于至日迎。",
        "侍臣来祭告，法驾欲时行。",
        "厘事通元气，高真达孝诚。",
        "庆增黄帝系，寿续太阴精。",
        "西北夷门峻，东南辇路倾。",
        "云行博山气，风卷步虚声。",
        "符贶方期应，英髦各汇征。",
        "讴歌兴法从，可见泰阶平。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 209868,
      "title": "次韵米元章斋居即事",
      "content": [
        "庭木双株茂，盆池一掬悭。",
        "支颐鱼出乐，入眦鸟知还。",
        "老境行将及，仙书读未闲。",
        "因君歌凤过，通昔梦归山。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 209869,
      "title": "次韵酬陈传道",
      "content": [
        "白发三冬学，青衫八尺身。",
        "谁知人上杰，聊作吏中循。",
        "挥翰通元气，开编友古人。",
        "寄声张氏子，曲逆岂长贫。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 209870,
      "title": "次韵传道自适兼呈都司芸叟学士",
      "content": [
        "楚国陈夫子，周南颇滞留。",
        "弊袍披槁叶，瘦马兀扁舟。",
        "药饵过三伏，文书散百忧。",
        "何人共禅悦，居士有浮休。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 209871,
      "title": "拟郡学试东风解冻",
      "content": [
        "宝历开新岁，春回斗柄东。",
        "漪生天际水，冻解日边风。",
        "浩荡依苹起，侵寻带雪融。",
        "江河霜练静，池沼玉奁空。",
        "鱼藻雍容里，云霄俯仰中。",
        "更无舟楫碍，从此百川通。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 209872,
      "title": "驾幸太学",
      "content": [
        "原庙初更十二章，还舆诏跸幸诸庠。",
        "法天辟水遥迎仗，应月深衣不乱行。",
        "风动四夷将遣子，礼行三舍遂宾王。",
        "前知此举追虞氏，果有球音发舜堂。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 209873,
      "title": "题阎求仁虚乐亭",
      "content": [
        "长官平昔嗜林丘，僧与开亭待胜游。",
        "修竹回环扶碧瓦，小池方折转清流。",
        "春深𫛸鴂催诗句，夜静蟾蜍入酒舟。",
        "只恐政成留不得，县人空此忆韦游。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 209874,
      "title": "怀李公择学士",
      "content": [
        "一辞行旆楚亭皋，几为登临挂鬰陶。",
        "蓬断草枯时节晚，山长水远梦魂劳。",
        "流传玉刻皆黄绢，早晚金闺报大刀。",
        "宣室方疑鬼神事，顺风行看驶鸿毛。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 209875,
      "title": "题汤泉二首  其一",
      "content": [
        "满斛泠泠注不穷，幻尘干慧洗皆空。",
        "法流水接诸天上，神瀵香闻一国中。",
        "金粟示为除病恼，跋陀仍已获圆通。",
        "马蹄又入风埃去，回首吴吟谢迮翁。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 209876,
      "title": "题汤泉二首  其二",
      "content": [
        "温井霜寒碧甃澄，飞尘不动玉奁清。",
        "老翁仙去羸骖共，太子东归废沼平。",
        "据石聊为宝陀观，决渠还落堰溪声。",
        "浣肠灌顶虽殊事，一洗劳生病恼轻。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 209877,
      "title": "寄题王钦之自圆庵",
      "content": [
        "诛茅北户结圆庐，从事风流入画图。",
        "珠箔粉垣藏混沌，葛巾藜杖造虚无。",
        "春闲居士天花室，昼静仙人白玉壶。",
        "遥想吏行凫鹜散，沉烟一穗对团蒲。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 209878,
      "title": "流觞亭并次韵二首  其一",
      "content": [
        "缥缈云峦欲尽头，洒然华构引飞流。",
        "朱盘潋滟开冰鉴，碧甃萦纡走玉虬。",
        "毛骨渐惊超浊界，风烟骤觉变清秋。",
        "更怜白足如霜句，可羡溪边六逸游。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 209879,
      "title": "流觞亭并次韵二首  其二",
      "content": [
        "卧龙西畔北池头，水擘华堂瑟瑟流。",
        "几曲漪涟盘翠带，一峰孤秀浴苍虬。",
        "香囊近午清无汗，素扇生凉爽入秋。",
        "待唤画师来貌取，图成便是竹溪游。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 209880,
      "title": "游龙门山次程公韵",
      "content": [
        "路转横塘入乱峰，遍寻萧洒兴无穷。",
        "楼台特起喧卑外，村落随生指点中。",
        "溪傍五云清逗玉，松分八面翠成宫。",
        "归途父老欣相语，今日程公昔谢公。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 209881,
      "title": "游龙瑞宫次程公韵",
      "content": [
        "灵祠真馆閟山隈，形势相高对越台。",
        "莓径翠依屏上转，藕花红绕鉴中开。",
        "鹤衔宝箭排烟去，龙护金书带雨来。",
        "夹道万星攒骑火，满城争看使君回。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 209882,
      "title": "次韵朱李二君见寄二首    其一",
      "content": [
        "东阡北陌坐淹时，偶为高风振羽仪。",
        "十丈莲花开处远，三年楮叶刻成迟。",
        "鬓毛但速安仁老，钱粟难输曼倩饥。",
        "尚頼故人遥省忆，发挥春色有新诗。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 209883,
      "title": "次韵朱李二君见寄二首    其二",
      "content": [
        "万古流空一鸟沉，衣冠常苦事违心。",
        "七行俱下知君旧，四者难并笑我今。",
        "梅已偷春成国色，云犹凭腊造天阴。",
        "美人绿绮烦遥赠，莫致南金增永吟。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 209884,
      "title": "睡足轩二首    其一",
      "content": [
        "长年忧患百端慵，开斥僧坊颇有功。",
        "地撤蔽亏僧界浄，人除荒秽玉奁空。",
        "青天并入挥毫里，白鸟时兴隠几中。",
        "最是人间佳绝处，梦残风铁响丁东。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 209885,
      "title": "睡足轩二首    其二",
      "content": [
        "数椽空屋枕清流，一榻萧然散百忧。",
        "终日掩关尘境谢，有时开卷古人游。",
        "鸣鸠去后沧浪晚，飞雨来初菡萏秋。",
        "此处便令君睡足，何须云梦泽南州。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 209886,
      "title": "寄孙莘老少监",
      "content": [
        "一出承明七换麾，君恩复许上彤墀。",
        "白衣苍狗无常态，璞玉浑金有定姿。",
        "天上图书森似旧，人间岁月浪如驰。",
        "鼇头只在蓬山畔，行赴蟠桃熟后期。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 209887,
      "title": "次韵马忠玉喜王定国还自滨州",
      "content": [
        "淮海相逢一解颜，纷纷岁月梦魂间。",
        "初惊渔艇迷花去，忽认星槎拂斗还。",
        "桂岭暮登猿断续，槐堂春到鸟绵蛮。",
        "石渠旧议行当复，未信佳时得自闲。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 209888,
      "title": "寄李公择郎中",
      "content": [
        "节旄淮畔脱秋风，忽跨鲸鱼上碧空。",
        "华秀两跗当重露，文成五色在高桐。",
        "江南又说衣冠盛，廷右仍瞻礼乐隆。",
        "朝𪾢既升淮海见，瀌瀌雨雪自消融。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 209889,
      "title": "寄李端叔编修",
      "content": [
        "旗亭解手屡冬春，闻道归来白发新。",
        "马革裹尸心未艾，金龟换酒气方震。",
        "梦魂偷遶边城月，道从公穿禁路尘。",
        "知有新编号横槊，为凭东使寄淮滨。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 209890,
      "title": "寄题倪敦复北轩",
      "content": [
        "倪郎才韵照冰壶，北向开轩颇自娱。",
        "簷度蕙风鸣鴶鵴，壁经梅雨画螔蝓。",
        "觥筹交错银河挂，文史纵横角簟铺。",
        "官舍私居同是漫，莫嗟三径就荒芜。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 209891,
      "title": "寄题卢君斗斋",
      "content": [
        "侠气轩轩翰墨场，邅回世路鬓成霜。",
        "出从车马行千里，归与琴书寄一方。",
        "鸟啭入帘春欲破，炉香侵梦日初长。",
        "扁舟会有山阳役，聊借狂夫挹酒浆。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 209892,
      "title": "次韵酬周开祖宣义",
      "content": [
        "并州令尹古人风，淮海相忘十载中。",
        "丽句晓披花绰约，清谈初扣玉丁东。",
        "追攀昔共猗玕子，嗜好今同桑苎翁。",
        "所惜华船轻解𫄴，未窥笠泽故书丛。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 209893,
      "title": "送王元龙赴泗州",
      "content": [
        "子猷风味最诸王，试吏聊怀筦库章。",
        "鹄峙碧桐初振羽，珠遗沧海渐腾光。",
        "淮山暮眺千峰擢，洛水秋输万鹢翔。",
        "顾我行为大梁役，一巵薄酒话愁肠。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 209894,
      "title": "广陵五题 次韵子由题九曲池",
      "content": [
        "萧瑟通池閟茂林，岸傍无复属车音。",
        "涵春似恨隋家远，涨晓疑连蜀井深。",
        "鬭草事空烟冉冉，司花人远树阴阴。",
        "劳生俛仰成陈迹，纵有遗声可用寻。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 209895,
      "title": "广陵五题 次韵子由题平山堂",
      "content": [
        "栋宇高开古寺间，尽收佳处入雕栏。",
        "山浮海上青螺远，天转江南碧玉宽。",
        "雨槛幽花滋浅泪，风巵清酒涨微澜。",
        "游人若论登临美，须作淮东第一观。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 209896,
      "title": "广陵五题 次韵子由题蜀井",
      "content": [
        "蜀冈精气滀多年，故有清泉发石田。",
        "乍饮肺肝俱澡雪，久窥杖屦亦轻便。",
        "炊成香稻流珠滑，煮出新茶泼乳鲜。",
        "坐使二公乡思动，放杯西望欲挥鞭。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 209897,
      "title": "广陵五题 次韵子由题摘星亭",
      "content": [
        "昆仑左右两招提，中起孤高雉堞西。",
        "不见烧香成宿雾，虚传裁锦作障泥。",
        "萤流花苑飞星乱，芜满春城绿发齐。",
        "长忆凭栏风雨后，断虹明处海天低。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 209898,
      "title": "广陵五题 次韵子由题光化塔",
      "content": [
        "古佛悲怜得度人，应缘来现比丘身。",
        "水流月落知何处，花发鶑啼又一春。",
        "方外笑谈清似玉，梦中烦恼细如尘。",
        "老僧自说从居此，却悔平时事远巡。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 209899,
      "title": "次韵子瞻赠金山宝觉大师",
      "content": [
        "云峰一变隔炎凉，犹喜重来饭积香。",
        "宿鸟水干迎晓闹，乱帆天际受风忙。",
        "青鞋踏雨寻幽径，朱火笼纱语上方。",
        "珍重故人敦妙契，自怜身世两微茫。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 209900,
      "title": "游鉴湖",
      "content": [
        "画舫珠帘出缭墙，天风吹到芰荷乡。",
        "水光入座杯盘莹，花气侵人笑语香。",
        "翡翠侧身窥渌酒，蜻蜓偷眼避红妆。",
        "蒲萄力缓单衣怯，始信湖中五月凉。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 209901,
      "title": "谒禹庙",
      "content": [
        "阴阴古殿注修廊，海伯川灵俨在傍。",
        "一代衣冠埋石窆，千年风雨锁梅梁。",
        "碧云暮合稽山暗，红芰秋开鉴水香。",
        "令我免鱼繇帝力，恨无歌舞奠椒浆。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 209902,
      "title": "蓬莱阁",
      "content": [
        "雄簷杰槛跨峥嵘，席上风云指顾生。",
        "千里胜形归俎豆，七州和气入箫笙。",
        "人游晚岸朱楼远，鸟度晴空碧嶂横。",
        "今夜请看东越分，藩星应带少微明。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 209903,
      "title": "别程公辟给事",
      "content": [
        "人物风流推镇东，夕郎持节作元戎。",
        "罇前倦客刘师命，月下清歌盛小丛。",
        "裘弊黑貂霜正急，书传黄犬岁将穷。",
        "买舟江上辞公去，回首蓬莱梦寐中。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 209904,
      "title": "中秋口号",
      "content": [
        "云山簷楯接低空，公宴初开气鬰葱。",
        "照海旌幢秋色里，激天鼓吹月明中。",
        "香槽旋滴珠千颗，歌扇惊围玉一丛。",
        "二十四桥人望处，台星正在广寒宫。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 209905,
      "title": "客有传朝议欲以子瞻使高丽大臣有惜其去者白罢之作诗以纪其事",
      "content": [
        "学士风流异域传，几航云海使南天。",
        "不因名动五千里，岂见文高二百年。",
        "贡外别题求妙札，锦中翻样织新篇。",
        "淹留却恨鸳行旧，不得飞觞驻跸前。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 209906,
      "title": "显之禅老许以草庵见处作诗以约之",
      "content": [
        "橡叶冈头释马衔，区中奇观得穷探。",
        "崖空飞鼠声相应，江静群峰影倒涵。",
        "居士碧云裁秀句，道人哀玉扣清谈。",
        "偶成二老风流事，不是三乘宿草庵。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 209907,
      "title": "和莘老游龙洞",
      "content": [
        "苇萧传火度冥冥，乍入清都醉魄醒。",
        "草隠月崖垂凤尾，风生阴穴带龙腥。",
        "壁间泉贮千钟碧，门外天横数尺青。",
        "更欲仗笻留顷刻，却疑朝市已千龄。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 209908,
      "title": "送蒋颖叔帅熙河二首  其一",
      "content": [
        "侍臣不合出都门，为有威名蕃汉尊。",
        "户部左曹回妙手，匈奴右臂落清罇。",
        "挥毫珠璧生谈笑，转盼龙鸾在梦魂。",
        "瀚海一空何足道，归来黄合坐调元。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 209909,
      "title": "送蒋颖叔帅熙河二首  其二",
      "content": [
        "天马蒲萄隔玉门，汉廷谁更勇如尊。",
        "行台晓日屯千骑，祖道春风属一罇。",
        "莫许留犁轻结好，便令瓯脱复游魂。",
        "要须尽取熙河地，打鼓梁州看上元。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 209910,
      "title": "和刘仆射感旧言怀寄苏左丞左丞昔守南京仆射方为幕客今同为执政作此诗仆射诗略记其一联云论文青眼今犹在报国丹心老更同",
      "content": [
        "三禁提衡系扰龙，拜无烧尾有家风。",
        "班行旧号青云士，宾主今为黄合公。",
        "烱烱坐屏云母隔，珊珊行佩水苍同。",
        "自惊初到蓬莱上，便见骊珠出海宫。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 209911,
      "title": "西城宴集元祐七年三月上巳日诏赐馆阁官花酒以中澣日游金明池琼林苑又会于国夫人园会者二十有六人二首  其一",
      "content": [
        "春溜泱泱初满池，晨光欲转万年枝。",
        "楼台四望烟云合，帘幕千家锦绣垂。",
        "风过忽闻花外笑，日长时奏水中嬉。",
        "太平谁谓全无象，寓在群仙把酒时。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 209912,
      "title": "西城宴集元祐七年三月上巳日诏赐馆阁官花酒以中澣日游金明池琼林苑又会于国夫人园会者二十有六人二首  其二",
      "content": [
        "宜秋门外喜参寻，豪竹哀丝发妙音。",
        "金爵日边栖壮丽，彩虹天际卧清深。",
        "已烦逸少书陈迹，更属相如赋上林。",
        "犹恨真人足官府，不如鱼鸟自飞沉。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 209913,
      "title": "清明前一日李观察席上得风字",
      "content": [
        "病躯寒食百无悰，偶到平阳旧第中。",
        "池籞信为三辅冠，杯盘真有五陵风。",
        "美人赋韵分春色，上客挥毫夺化工。",
        "白发渐于花柳薄，但怜流水碧相通。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 209914,
      "title": "次韵罗正之惠绵扇",
      "content": [
        "吴扇新翻制素绵，名郎持赠意俱圆。",
        "有人充户修明月，无女乘鸾向紫烟。",
        "供奉宜升清暑殿，动摇合作御风仙。",
        "谁知挥却青蝇辈，功在春蚕一觉眠。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 209915,
      "title": "寄新息王令藏春坞",
      "content": [
        "令尹才高寺为空，岁时行乐与民同。",
        "旋开小坞藏春色，更制新声写土风。",
        "客向罇前忘尔汝，路穿花去失西东。",
        "无言妫女今焉在，桃李相传恨未穷。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 209916,
      "title": "送刘承议解职归养",
      "content": [
        "征马萧萧柳外鸣，议郎归养洛阳城。",
        "登山尚记飞云处，罢吏端如弃唾轻。",
        "为米折腰知我拙，下车入里见君荣。",
        "堂前嵩少宜秋色，献寿还应旋制声。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 209917,
      "title": "次韵王仲至侍郎",
      "content": [
        "螭口清漪下玉栏，隔花时听鸟关关。",
        "酒行寒食清明际，人在蓬壶阆苑间。",
        "天近省闱卿月丽，春偏戚里将星闲。",
        "忽思归去焚香坐，静取楞严看入还。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 209918,
      "title": "庆张君俞都尉留后得子",
      "content": [
        "天上吹箫玉作楼，蟠桃熟后更无忧。",
        "内家报喜车凌晓，太史占祥斗挂秋。",
        "龙得一珠应献佛，虎生三日便吞牛。",
        "鲁元福禄何人似，坐见张敖数子侯。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 209919,
      "title": "寄题赵侯澄碧轩",
      "content": [
        "风流公子四难并，更引清漪作小亭。",
        "润及玉阶春涨雨，光浮藻井夜涵星。",
        "卷帘几砚成图画，倚槛须鬟入镜屏。",
        "何日解衣容借榻，卧听螭口泻泠泠。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 209920,
      "title": "寄张文潜右史",
      "content": [
        "解手亭皋才几月，春风已复动林塘。",
        "稍迁右史公何泰，初阅除书国为狂。",
        "日出想惊儒发冢，风行应罢女争桑。",
        "东坡手种千株柳，闻说邦人比召棠。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 209921,
      "title": "次韵裴秀才上太守向公二首  其一",
      "content": [
        "东风已动北风归，寒气侵寻自霁威。",
        "何处管弦传腊酒，谁家刀尺制春衣。",
        "使君英妙开莲幕，别驾风流出粉闱。",
        "唯有广文官独冷，终年如坐水边矶。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 209922,
      "title": "次韵裴秀才上太守向公二首  其二",
      "content": [
        "上客新从颍尾归，使君高会列南威。",
        "风将沉燎萦歌扇，雪带梅香上舞衣。",
        "翻样云团分御帑，如椽蜜炬出宫闱。",
        "食前方丈罗珍怪，却讶犀燃牛渚矶。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 209923,
      "title": "次韵太守向公登楼眺望二首  其一",
      "content": [
        "茫茫汝水抱城根，野色偷春入烧痕。",
        "千点湘妃枝上泪，一声杜宇水边魂。",
        "遥怜鸿隙陂穿路，尚想元和贼负恩。",
        "粉堞女墙都已尽，恍如陶侃梦天门。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 209924,
      "title": "次韵太守向公登楼眺望二首  其二",
      "content": [
        "庖烟起处认孤村，天色清寒不见痕。",
        "车辋湖边梅溅泪，壶公祠畔月销魂。",
        "封疆尽是春秋国，庙食多怀将相恩。",
        "试问李斯长叹后，谁牵黄犬出东门。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 209925,
      "title": "寄钱节",
      "content": [
        "论月柴门不浪开，命车良为故人来。",
        "茫然极目春千里，尚想愁肠日九回。",
        "绿水池边聊复尔，黄粱枕上信悠哉。",
        "何时共约参寥子，自撷青菁作饭材。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 209926,
      "title": "赠刘使君景文",
      "content": [
        "落落衣冠八尺雄，鱼符新赐大河东。",
        "穰苴兵法申司马，曹植诗原出国风。",
        "拈笔古心生篆刻，引觞侠气上云空。",
        "石渠病客君应笑，手校黄书两鬓蓬。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 209927,
      "title": "答龚深之",
      "content": [
        "深巷茅簷日渐长，卧看花鸟竞朝阳。",
        "惜无好事携罇酒，頼有邻家振烛光。",
        "尚友颇存书万卷，封侯正阙木千章。",
        "错刀锦段相仍至，小子都忘进取狂。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 209928,
      "title": "次韵答裴仲谟",
      "content": [
        "十年淮海闲居草，偶遣儿童次第成。",
        "方愧贫家矜敝帚，忽蒙邻壁借余明。",
        "文昌但愿花前老，张翰何须身后名。",
        "移病阖门参拜阻，卧听车马去来声。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 209929,
      "title": "答曾存之",
      "content": [
        "环堵萧然汝水隈，孤怀烱烱向谁开。",
        "青春不觉书边过，白发无端镜上来。",
        "祭灶请邻聊复尔，卖刀买犊岂难哉。",
        "故人休说封侯事，归钓江天有旧台。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 209930,
      "title": "春日寓直有怀参寥",
      "content": [
        "觚棱金爵自岧峣，藏室春深更寂寥。",
        "扪虱幽花欹露叶，岸巾高柳转风条。",
        "文书几上须髯变，鞍马尘中岁月销。",
        "何日一筇江海上，与君徐步看生潮。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 209931,
      "title": "次韵裴仲谟和何先辈二首  其一",
      "content": [
        "闻说何郎操行端，萧然环堵若为安。",
        "鸟啼花发阻携手，水远山高空凭栏。",
        "别后想多黄绢作，春来尤厌惠文弹。",
        "两章读罢知高义，贵贱交情自古难。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 209932,
      "title": "次韵裴仲谟和何先辈二首  其二",
      "content": [
        "汝南古郡寡参寻，兀兀长如鹤在阴。",
        "支枕星河横醉后，入帘风絮报春深。",
        "青山未落诗人手，白发谁知国士心。",
        "多谢名郎传绿绮，愧无佳句比南金。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 209933,
      "title": "答阎求仁谢参寥彦温访于坟所",
      "content": [
        "老濞城西木半摧，昆仑冈下路新开。",
        "故人此地衔忧去，禅客他时问疾回。",
        "闻为树风增永感，却因水鸟证西来。",
        "已谋寒食驱羸马，细听清谈动玉哀。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 209934,
      "title": "次韵刘逊父以宁斋诗二轴作以还之",
      "content": [
        "扬舲偶过海边州，一见名郎破百忧。",
        "荀氏诸龙俱俊伟，河东小凤最风流。",
        "明珠白璧俱投报，细草幽花入献酬。",
        "别驾旧斋何足念，文昌新府待公游。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 209935,
      "title": "次韵何子温",
      "content": [
        "一星就起海隅傍，县弩前驱过射阳。",
        "行见斯民无重困，坐令吾道有余光。",
        "簿书不碍诗人笔，猿鸟常窥使者章。",
        "谈笑自然群吏肃，何须酒后次公狂。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 209936,
      "title": "次韵宋履中近谒大庆退食馆中",
      "content": [
        "翠华初到殿中间，三馆诸儒共一班。",
        "迎谒晓廷清跸近，退穿春仗彩旓闲。",
        "病来怕饮东西玉，老去惭陪大小山。",
        "知续春明退朝录，借观当奉一鸱还。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 209937,
      "title": "与邓慎思沐于启圣遇李端叔",
      "content": [
        "羸兵瘦马犯黄尘，自笑区区梦里身。",
        "不是对花能伏老，自缘无酒可浇春。",
        "校书天禄陪群彦，晞发阳阿遇故人。",
        "三百六旬如此少，更添香火坐逡巡。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 209938,
      "title": "和程给事赟阇黎化去之什",
      "content": [
        "风流云散越王城，珍重阇黎愿力成。",
        "不使邓尼惊倒化，祇教白傅叹先行。",
        "早因妙契窥曹洞，竟以清芬继肇生。",
        "回首中庭旌骑散，月华还可一方明。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 209939,
      "title": "再赋流觞亭",
      "content": [
        "仙山游观甲寰瀛，不比人间自雨亭。",
        "歌断瑶池云杳杳，酒行金谷水泠泠。",
        "珠帘卷雨惊秋近，罗袜凌波笑客醒。",
        "月下珮环声更好，应容挥麈伴公听。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 209940,
      "title": "燕觞亭",
      "content": [
        "碧流如镜羽觞飞，夏木阴阴五月时。",
        "清渭日长游女困，武陵春去落花迟。",
        "玉笙吹罢觥筹错，蜜炬烧残簪珥遗。",
        "吴越风流公第一，未输山简习家池。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 209941,
      "title": "会蓬莱阁",
      "content": [
        "冠裳盖座洒清风，轩外时闻韵箨龙。",
        "人面春生红玉液，银盘烟覆紫驼峰。",
        "天涵秋色山山共，树搅乡思叶叶重。",
        "便欲买船江北去，为怀明德更从容。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 209942,
      "title": "次韵侍祠南郊",
      "content": [
        "风马云车下九天，郊柴初告帝心虔。",
        "天如倚盖临坛上，星若连珠绕御前。",
        "缥缈珮环参雅奏，岧峣楼阁抱非烟。",
        "侍臣举酒欣相属，醉看参横左右肩。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 209943,
      "title": "与李端叔游智海用前韵",
      "content": [
        "点目谁能化两龙，超然想见古人风。",
        "红尘稍与僧家远，白发偏于我辈公。",
        "休计浮名千载后，且欣汤餠一杯同。",
        "何时并筑邗沟上，引水浇花半亩宫。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 209944,
      "title": "和黄冕仲寄题延平泠风阁",
      "content": [
        "泠风三伏是清秋，虽有炎蒸不汝留。",
        "满地溪山归藻井，有时丝管下沧洲。",
        "快哉便得逍遥趣，偶尔还成汗漫游。",
        "谁为发挥无妙手，赋凌楚玉有家丘。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 209945,
      "title": "次韵谢李安上惠茶",
      "content": [
        "故人早岁佩飞霞，故遣长须致茗芽。",
        "寒橐遽收诸品玉，午瓯初试一团花。",
        "著书懒复追鸿渐，辨水时能效易牙。",
        "从此道山春困少，黄书剩校两三家。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 209946,
      "title": "次韵范纯夫戏答李方叔馈笋兼简邓慎思",
      "content": [
        "楚山冬笋𣃁寒空，北客长嗟食不重。",
        "秀色可怜刀切玉，清香不断鼎烹龙。",
        "论羹未愧莼千里，入贡当随传一封。",
        "薄禄养亲甘旨少，满包时頼故人供。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    }
  ],
