{
  "data": [
    {
      "id": 300142,
      "title": "过太乙观贾生房",
      "content": [
        "昔余栖遯日，之子烟霞邻。",
        "共携松叶酒，俱𥮾竹皮巾。",
        "攀林遍岩洞，采药无冬春。",
        "谬以道门子，征为骖御臣。",
        "常恐丹液就，先我紫阳宾。",
        "夭促万涂尽，哀伤百虑新。",
        "迹峻不容俗，才多反累真。",
        "泣对双泉水，还山无主人。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 300143,
      "title": "燕子龛禅师",
      "content": [
        "山中燕子龛，路剧羊肠恶。",
        "裂地竞盘屈，插天多峭崿。",
        "瀑泉吼而喷，怪石看欲落。",
        "伯禹访未知，五丁愁不凿。",
        "上人无生缘，生长居紫阁。",
        "六时自搥磬，一饮常带索。",
        "种田烧白云，斫漆响丹壑。",
        "行随拾栗猿，归对巢松鹤。",
        "时许山神请，偶逢洞仙博。",
        "救世多慈悲，即心无行作。",
        "周商倦积阻，蜀物多淹泊。",
        "岩腹乍旁穿，涧唇时外拓。",
        "桥因倒树架，栅值垂藤缚。",
        "鸟道悉已平，龙宫为之涸。",
        "跳波谁揭厉，绝壁免扪摸。",
        "山木日阴阴，结跏归旧林。",
        "一向石门里，任君春草深。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 300144,
      "title": "羽林骑闺人",
      "content": [
        "秋月临高城，城中管弦思。",
        "离人堂上愁，稚子阶前戏。",
        "出门复暎户，望望青丝骑。",
        "行人过欲尽，狂夫终不至。",
        "左右寂无言，相看共垂泪。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 300145,
      "title": "偶然作六首 一",
      "content": [
        "楚国有狂夫，茫然无心想。",
        "散髪不冠带，行歌南陌上。",
        "孔丘与之言，仁义莫能奖。",
        "未尝肯问天，何事须击壤。",
        "复笑采薇人，胡为乃长往。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 300146,
      "title": "偶然作六首 二",
      "content": [
        "田舍有老翁，垂白衡门里。",
        "有时农事闲，斗酒呼邻里。",
        "喧聒茅簷下，或坐或复起。",
        "短褐不为薄，园葵固足美。",
        "动则长子孙，不曾向城市。",
        "五帝与三王，古来称天子。",
        "干戈将揖让，毕竟何者是。",
        "得意苟为乐，野田安足鄙。",
        "且当放怀去，行行没余齿。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 300147,
      "title": "偶然作六首 三",
      "content": [
        "日夕见太行，沈吟未能去。",
        "问君何以然，世网婴我故。",
        "小妹日成长，兄弟未有娶。",
        "家贫禄既薄，储蓄非有素。",
        "几回欲奋飞，踟蹰复相顾。",
        "孙登长啸台，松竹有遗处。",
        "相去讵几许，故人在中路。",
        "爱染日已薄，禅寂日已固。",
        "忽乎吾将行，宁俟岁云暮。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 300148,
      "title": "偶然作六首 四",
      "content": [
        "陶潜任天真，其性颇躭酒。",
        "自从弃官来，家贫不能有。",
        "九月九日时，菊花空满手。",
        "中心窃自思，傥有人送否。",
        "白衣携壶觞，果来遗老叟。",
        "且喜得斟酌，安问升与斗。",
        "奋衣野田中，今日嗟无负。",
        "兀傲迷东西，蓑笠不能守。",
        "倾倒强行行，酣歌归五柳。",
        "生事不曾问，肯媿家中妇。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 300149,
      "title": "偶然作六首 五",
      "content": [
        "赵女弹箜篌，复能邯郸舞。",
        "夫壻轻薄儿，鬬鸡事齐主。",
        "黄金买歌笑，用钱不复数。",
        "许史相经过，高门盈四牡。",
        "客舍有儒生，昂藏出邹鲁。",
        "读书三十年，腰间无尺组。",
        "被服圣人教，一生自穷苦。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 300150,
      "title": "偶然作六首 六",
      "content": [
        "老来懒赋诗，惟有老相随。",
        "宿世谬词客，前身应画师。",
        "不能舍余习，偶被世人知。",
        "名字本皆是，此心还不知。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 300151,
      "title": "寓言二首 一",
      "content": [
        "朱绂谁家子，无乃金张孙。",
        "骊驹从白马，出入铜龙门。",
        "问尔何功德，多承明主恩。",
        "鬬鸡平乐馆，射雉上林园。",
        "曲陌车骑盛，高堂珠翠繁。",
        "奈何轩冕贵，不与布衣言。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 300152,
      "title": "寓言二首 二",
      "content": [
        "君家御沟上，垂柳夹朱门。",
        "列鼎会中贵，鸣珂朝至尊。",
        "生死在八议，穷达由一言。",
        "须识苦寒士，莫矜狐白温。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 300153,
      "title": "冬夜书怀",
      "content": [
        "冬宵寒且永，夜漏宫中发。",
        "草白霭繁霜，木衰澄清月。",
        "丽服暎颓颜，朱灯照华髪。",
        "汉家方尚少，顾影慙朝谒。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 300154,
      "title": "送康太守",
      "content": [
        "城下沧江水，江边黄鹤楼。",
        "朱阑将粉堞，江水映悠悠。",
        "铙吹发夏口，使君居上头。",
        "郭门隐枫岸，候吏趋芦洲。",
        "何异临川郡，还劳康乐侯。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 300155,
      "title": "送权二",
      "content": [
        "高人不可有，清论复何深。",
        "一见如旧识，一言知道心。",
        "明时当薄宦，解薜去中林。",
        "芳草空隐处，白云余故岑。",
        "韩侯久携手，河岳共幽寻。",
        "怅别千余里，临堂鸣素琴。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 300156,
      "title": "休假还旧业便使",
      "content": [
        "谢病始告归，依依入桑梓。",
        "家人皆𥩟立，相候衡门里。",
        "时辈皆长年，成人旧童子。",
        "上堂嘉庆毕，顾与姻亲齿。",
        "论旧忽余悲，目存皆相喜。",
        "田园转芜没，但有寒泉水。",
        "衰柳日萧条，秋光清邑里。",
        "入门乍如客，休骑非便止。",
        "中饮顾王程，离忧从此始。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 300157,
      "title": "叹白髪",
      "content": [
        "我年一何长，鬓髪日已白。",
        "俛仰天地间，能为几时客。",
        "惆怅故山云，俳徊空日夕。",
        "何事与时人，东城复南陌。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 300158,
      "title": "别弟妹二首 一",
      "content": [
        "两妹日成长，双鬟将及人。",
        "已能持宝瑟，自解掩罗巾。",
        "念昔别时小，未知疎与亲。",
        "今来始离恨，拭泪方殷勤。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 300159,
      "title": "别弟妹二首 二",
      "content": [
        "小弟更孩幼，归来不相识。",
        "同居虽渐惯，见人犹未觅。",
        "宛作越人语，殊甘水乡食。",
        "别此最为难，泪尽有余忆。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 300160,
      "title": "哭殷遥",
      "content": [
        "人生能几何，毕竟归无形。",
        "念君等为死，万事伤人情。",
        "慈母未及葬，一女才十龄。",
        "泱漭寒郊外，萧条闻哭声。",
        "浮云为苍茫，飞鸟不能鸣。",
        "行人何寂寞，白日自凄清。",
        "忆昔君在时，问我学无生。",
        "劝君苦不早，令君无所成。",
        "故人各有赠，又不及生平。",
        "负尔非一途，恸哭返柴荆。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 300161,
      "title": "故南阳夫人樊氏挽歌",
      "content": [
        "石窌恩荣重，金吾车骑盛。",
        "将朝每赠言，入室还相敬。",
        "叠鼓秋城动，悬旌寒日映。",
        "不言长不归，环珮犹将听。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 300162,
      "title": "夷门歌",
      "content": [
        "七雄雄雌犹未分，攻城杀将何纷纷。",
        "秦兵益围邯郸急，魏王不救平原君。",
        "公子为嬴停驷马，执辔愈恭意愈下。",
        "亥为屠肆鼓刀人，嬴乃夷门抱关者。",
        "非但慷慨献良谋，意气兼将身命酬。",
        "向风刎颈送公子，七十老翁何所求。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 300163,
      "title": "陇头吟",
      "content": [
        "长安少年游侠客，夜上戍楼看太白。",
        "陇头明月迥临关，陇上行人夜吹笛。",
        "关西老将不胜愁，驻马听之双泪流。",
        "身经大小百余战，麾下偏裨万户侯。",
        "苏武才为典属国，节旄落尽海西头。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 300164,
      "title": "老将行",
      "content": [
        "少年十五二十时，步行夺得胡马射。",
        "射杀中山白额虎，肯数邺下黄须儿。",
        "一身转战三千里，一劒曾当百万师。",
        "汉兵奋迅如霹雳，虏骑崩腾畏蒺藜。",
        "衞青不败由天幸，李广无功缘数奇。",
        "自从弃置便衰朽，世事磋跎成白首。",
        "昔时飞箭无全目，今日垂杨生左肘。",
        "路傍时卖故侯瓜，门前学种先生柳。",
        "苍茫古木连穷巷，寥落寒山对虚牖。",
        "誓令疏勒出飞泉，不似颍川空使酒。",
        "贺兰山下阵如云，羽檄交驰日夕闻。",
        "节使三河募年少，诏书五道出将军。",
        "试拂铁衣如雪色，聊持宝劒动星文。",
        "愿得燕弓射天将，耻令越甲鸣吴军。",
        "莫嫌旧日云中守，犹堪一战取功勋。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 300165,
      "title": "燕支行",
      "content": [
        "汉家天将才且雄，来时谒帝明光宫。",
        "万乘亲推双阙下，千官出饯五陵东。",
        "誓辞甲第金门里，身作长城玉塞中。",
        "衞霍才堪一骑将，朝廷不数贰师功。",
        "赵魏燕韩多劲卒，关西侠少何咆勃。",
        "报讐只是闻尝胆，饮酒不曾妨刮骨。",
        "画戟雕戈白日寒，连旗大斾黄尘没。",
        "叠鼓遥翻瀚海波，鸣笳乱动天山月。",
        "麒麟锦带佩吴钩，飒沓青骊跃紫骝。",
        "拔劒已断天骄臂，归鞍共饮月支头。",
        "汉兵大呼一当百，虏骑相看哭且愁。",
        "教战虽令赴汤火，终知上将先伐谋。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 300166,
      "title": "桃源行",
      "content": [
        "渔舟逐水爱山春，两岸桃花夹去津。",
        "坐看红树不知远，行尽青溪不见人。",
        "山口潜行始隈隩，山开旷望旋平陆。",
        "遥看一处攒云树，近入千家散花竹。",
        "樵客初传汉姓名，居人未改秦衣服。",
        "居人共住武陵源，还从物外起田园。",
        "月明松下房栊静，日出云中鸡犬喧。",
        "惊闻俗客争来集，竞引还家问都邑。",
        "平明闾巷埽花开，薄暮渔樵乘水入。",
        "初因避地去人间，及至成仙遂不还。",
        "峡里谁知有人事，世中遥望空云山。",
        "不疑灵境难闻见，尘心未尽思乡县。",
        "出洞无论隔山水，辞家终拟长游衍。",
        "自谓经过旧不迷，安知峰壑今来变。",
        "当时只记入山深，青溪几曲到云林。",
        "春来遍是桃花水，不辨仙源何处寻。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 300167,
      "title": "洛阳女儿行",
      "content": [
        "洛阳女儿对门居，才可容颜十五余。",
        "良人玉勒乘骢马，侍女金盘鲙鲤鱼。",
        "画阁朱楼尽相望，红桃绿柳垂簷向。",
        "罗帏送上七香车，宝扇迎归九华帐。",
        "狂夫富贵在青春，意气骄奢剧季伦。",
        "自怜碧玉亲教舞，不惜珊瑚持与人。",
        "春窗曙灭九微火，九微片片飞花璅。",
        "戏罢曾无理曲时，妆成秪是薰香坐。",
        "城中相识尽繁华，日夜经过赵李家。",
        "谁怜越女颜如玉，贫贱江头自浣纱。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 300168,
      "title": "同崔傅答贤弟",
      "content": [
        "洛阳才子姑苏客，桂苑殊非故乡陌。",
        "九江枫树几回青，一片扬州五湖白。",
        "扬州时有下江兵，兰陵镇前吹笛声。",
        "夜火人归富春郭，秋风鹤唳石头城。",
        "周郎陆弟为俦侣，对舞前溪歌白纻。",
        "曲几书留小史家，草堂棋赌山阴墅。",
        "衣冠若话外台臣，先数夫君席上珍。",
        "更闻台阁求三语，遥想风流第一人。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 300169,
      "title": "赠吴官",
      "content": [
        "长安客舍热如煮，无个茗糜难御暑。",
        "空摇白团其谛苦，欲向缥囊还归旅。",
        "江乡鲭鲊不寄来，秦人汤饼那堪许。",
        "不如侬家任挑达，草𪨗捞虾富春渚。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 300170,
      "title": "故人张諲工诗善易卜兼能丹青草隶顷以诗见赠聊获酬之",
      "content": [
        "不逐城东游侠儿，隐囊纱帽坐弹棋。",
        "蜀中夫子时开卦，洛下书生解咏诗。",
        "药阑花迳衡门里，时复据梧聊隐几。",
        "屏风误点惑孙郎，团扇草书轻内史。",
        "故园高枕度三春，永日垂帷绝四邻。",
        "自想蔡邕今已老，更将书籍使何人。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 300171,
      "title": "送崔五太守",
      "content": [
        "长安厩吏来到门，朱文露网动行轩。",
        "黄花县西九折坂，玉树宫南五丈原。",
        "襃斜谷中不容幰，唯有白云当露冕。",
        "子午山里杜鹃啼，嘉陵水头行客饭。",
        "劒门忽断蜀川开，万井双流满眼来。",
        "雾中远树刀州出，天际澄江巴字回。",
        "使君年纪三十余，少年白皙专城居。",
        "欲持画省郎官笔，回与临邛父老书。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 300172,
      "title": "寒食城东即事",
      "content": [
        "清溪一道穿桃李，演漾绿蒲涵白芷。",
        "溪上人家凡几家，落花半落东流水。",
        "蹴鞠屡过飞鸟上，秋千竞出垂杨里。",
        "少年分日作遨游，不用清明兼上巳。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 300173,
      "title": "不遇咏",
      "content": [
        "北阙献书寝不报，南山种田时不登。",
        "百人会中身不预，五侯门前心不能。",
        "身投河朔饮君酒，家在茂陵平安否。",
        "且此登山复临水，莫问春风动杨柳。",
        "今人昨人多自私，我心不说君应知。",
        "济人然后拂衣去，肯作徒尔一男儿。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 300174,
      "title": "赠裴迪",
      "content": [
        "不相见，不相见来久。",
        "日日泉水头，常忆同携手。",
        "携手本同心，复叹忽分襟。",
        "相忆今如此，相思深不深。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 300175,
      "title": "青雀歌",
      "content": [
        "青雀翅羽短，未能远食玉山禾。",
        "犹胜黄雀争上下，唧唧空仓复若何。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 300176,
      "title": "黄雀痴",
      "content": [
        "黄雀痴，黄雀痴，谓言青鷇是我儿。",
        "一一口衔食，养得成毛衣。",
        "到大啁啾解游飏，各自东西南北飞。",
        "薄暮空巢上，羇雌独自归。",
        "凤凰九雏亦如此，慎莫愁思顦顇损容辉。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 300177,
      "title": "新秦郡松树歌",
      "content": [
        "青青山上松，数里不见今更逢。",
        "不见君，心相忆，此心向君君应识。",
        "为君颜色高且闲，亭亭迥出浮云间。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 300178,
      "title": "楡林郡歌",
      "content": [
        "山头松柏林，山下泉声伤客心。",
        "千里万里春草色，黄河东流流不息。",
        "黄龙戍上游侠儿，愁逢汉使不相识。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 300179,
      "title": "问寇校书双谿",
      "content": [
        "君家少室西，为复少室东。",
        "别来几日今春风，新买双谿定何似。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 300180,
      "title": "寄崇梵僧",
      "content": [
        "崇梵僧，崇梵僧，秋归覆釜春不还。",
        "落花啼鸟纷纷乱，涧户山窗寂寂闲。",
        "峡里谁知有人事，郡中遥望空云山。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 300181,
      "title": "同比部杨员外十五夜游有怀静者季",
      "content": [
        "承明少休沐，建礼省文书。",
        "夜漏行人息，归鞍落日余。",
        "悬知三五夕，万户千门辟。",
        "夜出曙翻归，倾城满南陌。",
        "陌头驰骋尽繁华，王孙公子五侯家。",
        "由来月明如白日，共道春灯胜百花。",
        "聊看侍中千宝骑，强识小妇七香车。",
        "香车宝马共喧阗，个里多情侠少年。",
        "竞向长杨柳市北，肯过精舍竹林前。",
        "独有仙郎心寂寞，却将宴坐为行乐。",
        "傥觉忘怀共往来，幸霑同舍甘藜藿。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 300182,
      "title": "荅张五弟",
      "content": [
        "终南有茅屋，前对终南山。",
        "终年无客常闭关，终日无心长自闲。",
        "不妨饮酒复垂钓，君但能来相往还。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 300183,
      "title": "雪中忆李楫",
      "content": [
        "积雪满阡陌，故人不可期。",
        "长安千门复万户，何处躞蹀黄金羁。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 300184,
      "title": "送李睢阳",
      "content": [
        "将置酒，思悲翁。",
        "使君去，出城东。",
        "麦渐渐，雉子斑。",
        "槐阴阴，到潼关。",
        "骑连连，车迟迟。",
        "心中悲，宋又远。",
        "周间之，南淮夷。",
        "东齐儿，碎碎织练与素丝。",
        "游人贾客信难持，五谷前熟方可为。",
        "下车闭合君当思，天子当殿俨衣裳。",
        "大官尚食陈羽觞，彤庭散绶垂鸣珰。",
        "黄纸诏书出东厢，轻纨叠绮烂生光。",
        "宗室子弟君最贤，分忧当为百辟先。",
        "布衣一言相为死，何况圣主恩如天。",
        "鸾声哕哕鲁侯旗，明年上计朝京师。",
        "须忆今日斗酒别，慎勿富贵忘我为。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 300185,
      "title": "奉和圣制天长节赐宰臣歌应制",
      "content": [
        "太阳升兮照万方，开阊阖兮临玉堂。",
        "俨冕旒兮垂衣裳，金天净兮丽三光。",
        "彤庭曙兮延八荒，德合天兮礼神徧。",
        "灵芝生兮庆云见，唐尧后兮稷卨臣。",
        "匝宇宙兮华胥人，尽九服兮皆四邻，干降瑞兮坤降珍。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 300186,
      "title": "登楼歌",
      "content": [
        "聊上君兮高楼，飞甍鳞次兮在下。",
        "俯十二兮通衢，绿槐参差兮车马。",
        "却瞻兮龙首，前眺兮宜春。",
        "王畿郁兮千里，山河壮兮咸秦。",
        "舍人下兮青宫，据胡床兮书空。",
        "执戟疲于下位，老夫好隐兮墙东。",
        "亦幸有张伯英草圣兮龙腾蚪跃，摆长云兮捩回风。",
        "琥珀酒兮雕胡饭，君不御兮日将晚。",
        "秋风兮吹衣，夕鸟兮争返。",
        "孤砧发兮东城，林薄暮兮蝉声远。",
        "时不可兮再得，君何为兮偃蹇。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 300187,
      "title": "双黄鹄歌送别",
      "content": [
        "天路来兮双黄鹄，云上飞兮水上宿。",
        "抚翼和鸣整羽族，不得已，忽分飞。",
        "家在玉京朝紫微，主人临水送将归。",
        "悲笳嘹唳垂舞衣，宾欲散兮复相依。",
        "几往返兮极浦，尚裴回兮落晖。",
        "岸上火兮相迎，将夜入兮边城。",
        "鞍马归兮佳人散，怅离忧兮独含情。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 300188,
      "title": "赠徐中书望终南山歌",
      "content": [
        "晚下兮紫微，怅尘事兮多违。",
        "驻马兮双树，望青山兮不归。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 300189,
      "title": "送友人归山歌二首 一",
      "content": [
        "山寂寂兮无人，又苍苍兮多木。",
        "群龙兮满朝，君何为兮空谷。",
        "文寡和兮思深，道难知兮行独。",
        "悦石上兮流泉，与松间兮草屋。",
        "入云中兮养鸡，上山头兮抱犊。",
        "神与枣兮如瓜，虎卖杏兮收谷。",
        "愧不才兮妨贤，嫌既老兮贪禄。",
        "誓解印兮相从，何詹尹兮何卜。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 300190,
      "title": "送友人归山歌二首 二",
      "content": [
        "山中人兮欲归，云冥冥兮雨霏霏，水惊波兮翠菅靡。",
        "白鹭忽兮翻飞，君不可兮褰衣。",
        "山万重兮一云，混天地兮不分。",
        "树晻暧兮氛氲，猿不见兮空闻。",
        "忽山西兮夕阳，见东臯兮远村。",
        "平芜绿兮千里，眇惆怅兮思君。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 300191,
      "title": "鱼山神女祠歌 迎神",
      "content": [
        "坎坎击鼓，鱼山之下。",
        "吹洞箫，望极浦，女巫进，纷屡舞。",
        "陈瑶席，湛清酤，风凄凄兮夜雨。",
        "不知神之来兮不来，使我心兮苦复苦。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 300192,
      "title": "鱼山神女祠歌 送神",
      "content": [
        "纷进舞兮堂前，目眷眷兮琼筵。",
        "来不言兮意不传，作暮雨兮愁空山。",
        "悲急管兮思繁弦，神之驾兮俨欲旋。",
        "倏云收兮雨歇，山青青兮水潺湲。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 300193,
      "title": "白鼋涡",
      "content": [
        "南山之瀑水兮，激石瀥瀑似雷惊。",
        "人相对兮，不闻语声。",
        "翻涡跳沫兮苍苔湿，藓老且厚，春草为之不生。",
        "兽不敢惊动，鸟不敢飞鸣。",
        "白鼋涡涛戏濑兮，委身以纵横。",
        "王人之仁兮，不网不钓，得遂性以生成。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 300194,
      "title": "宋进马哀词",
      "content": [
        "背春涉夏兮，众木蔼以繁阴。",
        "连金华与玉堂兮，宫阁郁其沈沈。",
        "百官并入兮，何语笑之哑哑。",
        "君独静嘿以伤心，草王言兮不得辞。",
        "我悲减思兮少时，仆夫命驾兮。",
        "出阊阖，历通逵，陌上人兮如故。",
        "识不识兮往来，眼中不见兮吾儿。",
        "骖紫骝兮从青骊，低光垂彩兮。",
        "怳不知其所之，辟朱户兮望华轩。",
        "意斯子兮候门，忽思瘗兮城南。",
        "心瞀乱兮重昏，仰诉天之不仁兮。",
        "家唯一身，身止一子。",
        "何胤嗣之不繁，就单尠而又死。",
        "将清白兮遗谁，问诗礼兮已矣。",
        "哀从中兮不可胜，岂暇料余年兮复几。",
        "日黯黯兮颓晔，鸟翩翩兮疾飞。",
        "邈穷天兮不返，疑有日兮来归。",
        "静言思兮永绝，复惊叫兮沾衣。",
        "客有吊之者曰：观未始兮有物，同委蜕兮胡悲。",
        "且延陵兮未至，况西河兮不知。",
        "学无生兮庶可，幸能听于吾师。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 300195,
      "title": "奉和圣制赐史供奉曲江䜩应制",
      "content": [
        "侍从有邹枚，琼筵就水开。",
        "言陪柏梁宴，新下建章来。",
        "对酒山河满，移舟草树廻。",
        "天文同丽日，驻景惜行杯。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 300196,
      "title": "从岐王过杨氏别业应教",
      "content": [
        "杨子谈经所，淮王载酒过。",
        "兴阑啼鸟换，坐久落花多。",
        "迳转廻银烛，林开散玉珂。",
        "严城时未启，前路拥笙歌。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 300197,
      "title": "从岐王夜宴衞家山池应教",
      "content": [
        "座客香貂满，宫娃绮幔张。",
        "涧花轻粉色，山月少灯光。",
        "积翠纱窗暗，飞泉绣户凉。",
        "还将歌舞出，归路莫愁长。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 300198,
      "title": "早朝",
      "content": [
        "柳暗百花明，春深五凤城。",
        "城乌睥睨晓，宫井辘轳声。",
        "方朔金门侍，班姬玉辇迎。",
        "仍闻遣方士，东海访蓬瀛。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 300199,
      "title": "同崔员外秋宵寓直",
      "content": [
        "建礼高秋夜，承明候晓过。",
        "九门寒漏彻，万井曙钟多。",
        "月迥藏珠斗，云消出绛河。",
        "更慙衰朽质，南陌共鸣珂。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 300200,
      "title": "辋川闲居赠裴秀才迪",
      "content": [
        "寒山转苍翠，秋水日潺湲。",
        "倚杖柴门外，临风听暮蝉。",
        "渡头余落日，墟里上孤烟。",
        "复值接舆醉，狂歌五柳前。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 300201,
      "title": "寄荆州张丞相",
      "content": [
        "所思竟何在，怅望深荆门。",
        "举世无相识，终身思旧恩。",
        "方将与农圃，艺植老丘园。",
        "目尽南飞鴈，何由寄一言。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 300202,
      "title": "冬晚对雪忆胡居士家",
      "content": [
        "寒更传晓箭，清镜览衰颜。",
        "隔牖风惊竹，开门雪满山。",
        "洒空深巷静，积素广庭闲。",
        "借问袁安舍，翛然尚闭关。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 300203,
      "title": "和尹谏议史馆山池",
      "content": [
        "云馆接天居，霓裳侍玉除。",
        "春池百子外，芳树万年余。",
        "洞有仙人箓，山藏太史书。",
        "君恩深汉帝，且莫上空虚。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 300204,
      "title": "奉和杨驸马六郎秋夜即事",
      "content": [
        "高楼月似霜，秋夜郁金堂。",
        "对坐弹卢女，同看舞凤凰。",
        "少儿多送酒，小玉更焚香。",
        "结束平阳骑，明朝入建章。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 300205,
      "title": "酬虞部苏员外过蓝田别业不见留之作",
      "content": [
        "贫居依谷口，乔木带荒村。",
        "石路枉廻驾，山家谁候门。",
        "渔舟胶冻浦，猎火烧寒原。",
        "唯有白云外，疎钟闻夜猿。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 300206,
      "title": "酬比部杨员外暮宿琴台朝跻书阁率尔见赠之作",
      "content": [
        "旧简拂尘看，鸣琴候月弹。",
        "桃源迷汉姓，松树有秦官。",
        "空谷归人少，青山背日寒。",
        "羡君栖隐处，遥望白云端。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 300207,
      "title": "酬严少尹徐舍人见过不遇",
      "content": [
        "公门暇日少，穷巷故人稀。",
        "偶值乘篮轝，非关避白衣。",
        "不知炊黍谷，谁解埽荆扉。",
        "君但倾茶椀，无妨骑马归。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 300208,
      "title": "酬张少府",
      "content": [
        "晚年唯好静，万事不关心。",
        "自顾无长策，空知返旧林。",
        "松风吹解带，山月照弹琴。",
        "君问穷通理，渔歌入浦深。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 300209,
      "title": "酬贺四赠葛巾之作",
      "content": [
        "野巾传惠好，兹贶重兼金。",
        "嘉此幽栖物，能齐隐吏心。",
        "早朝方暂挂，晚沐复来簪。",
        "坐觉嚣尘远，思君共入林。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 300210,
      "title": "送丘为落第归江东",
      "content": [
        "怜君不得意，况复柳条春。",
        "为客黄金尽，还家白发新。",
        "五湖三亩宅，万里一归人。",
        "知尔不能荐，羞称献纳臣。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 300211,
      "title": "送李判官赴东江",
      "content": [
        "闻道皇华使，方随皂盖臣。",
        "封章通左语，冠冕化文身。",
        "树色分扬子，潮声满富春。",
        "遥知辨璧吏，恩到泣珠人。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 300212,
      "title": "送封太守",
      "content": [
        "忽解羊头削，聊驰熊首轓。",
        "扬舲发夏口，按节向吴门。",
        "帆暎丹阳郭，枫攒赤岸村。",
        "百村多候吏，露冕一何尊。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 300213,
      "title": "送严秀才还蜀",
      "content": [
        "宁亲为令子，似舅即贤甥。",
        "别路经花县，还乡入锦城。",
        "山临青塞断，江向白云平。",
        "献赋何时至，明君忆长卿。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 300214,
      "title": "送张判官赴河西",
      "content": [
        "单车曾出塞，报国敢邀勋。",
        "见逐张征虏，今思霍冠军。",
        "沙平连白雪，蓬卷入黄云。",
        "慷慨倚长劒，高歌一送君。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 300215,
      "title": "送岐州源长史归",
      "content": [
        "握手一相送，心悲安可论。",
        "秋风正萧索，客散孟尝门。",
        "故驿通槐里，长亭下槿原。",
        "征西旧旌节，从此向河源。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 300216,
      "title": "送张道士归山",
      "content": [
        "先生何处去，王屋访茅君。",
        "别妇留丹诀，驱鸡入白云。",
        "人间若剩住，天上复离群。",
        "当作辽城鹤，仙歌使尔闻。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 300217,
      "title": "同崔兴宗送衡岳瑗公南归",
      "content": [
        "言从石菌阁，新下穆陵关。",
        "独向池阳去，白云留故山。",
        "绽衣秋日里，洗钵古松间。",
        "一施传心法，唯将戒定还。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 300218,
      "title": "送钱少府还蓝田",
      "content": [
        "草色日向好，桃源人去稀。",
        "手持平子赋，目送老莱衣。",
        "每候山樱发，时同海燕归。",
        "今年寒食酒，应是返柴扉。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 300219,
      "title": "送丘为往唐州",
      "content": [
        "宛洛有风尘，君行多苦辛。",
        "四愁连汉水，百口寄随人。",
        "槐色阴清昼，杨花惹暮春。",
        "朝端肯相送，天子绣衣臣。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 300220,
      "title": "送元中丞转运江淮",
      "content": [
        "薄赋归天府，轻徭赖使臣。",
        "欢霑赐帛老，恩及卷绡人。",
        "去问珠官俗，来经石𧉧春。",
        "东南御亭上，莫使有风尘。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 300221,
      "title": "送崔九兴宗游蜀",
      "content": [
        "送君从此去，转觉故人稀。",
        "徒御犹廻首，田园方掩扉。",
        "出门当旅食，中路授寒衣。",
        "江汉风流地，游人何岁归。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 300222,
      "title": "送崔兴宗",
      "content": [
        "已恨亲皆远，谁怜友复稀。",
        "君王未西顾，游宦尽东归。",
        "塞迥山河净，天长云树微。",
        "方同菊花节，相待洛阳扉。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 300223,
      "title": "送平澹然判官",
      "content": [
        "不识阳关路，新从定远侯。",
        "黄云断春色，画角起边愁。",
        "瀚海经年到，交河出塞流。",
        "须令外国使，知饮月氏头。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 300224,
      "title": "送刘司直赴安西",
      "content": [
        "绝域阳关道，胡沙与塞尘。",
        "三春时有雁，万里少行人。",
        "苜蓿随天马，葡萄逐汉臣。",
        "当令外国惧，不敢觅和亲。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 300225,
      "title": "送赵都督赴代州得青字",
      "content": [
        "天官动将星，汉上柳条青。",
        "万里鸣刁斗，三军出井陉。",
        "忘身辞凤阙，报国取龙庭。",
        "岂学书生辈，窗间老一经。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 300226,
      "title": "送方城韦明府",
      "content": [
        "遥思葭菼际，寥落楚人行。",
        "高鸟长淮水，平芜故郢城。",
        "使车听雉乳，县鼓应鸡鸣。",
        "若见州从事，无嫌手板迎。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 300227,
      "title": "送李员外贤郎",
      "content": [
        "少年何处去，负米上铜梁。",
        "借问阿戎父，知为童子郎。",
        "鱼牋请诗赋，橦布作衣裳。",
        "薏苡扶衰病，归来幸可将。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 300228,
      "title": "送梓州李使君",
      "content": [
        "万壑树参天，千山响杜鹃。",
        "山中一夜雨，树杪百重泉。",
        "汉女输橦布，巴人讼芋田。",
        "文翁翻教授，不敢倚先贤。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 300229,
      "title": "送张五諲归宣城",
      "content": [
        "五湖千万里，况复五湖西。",
        "渔浦南陵郭，人家春谷谿。",
        "欲归江淼淼，未到草萋萋。",
        "忆想兰陵镇，可宜猿更啼。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 300230,
      "title": "送友人南归",
      "content": [
        "万里春应尽，三江雁亦稀。",
        "连天汉水广，孤客郢城归。",
        "郧国稻苗秀，楚人菰米肥。",
        "悬知倚门望，遥识老莱衣。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 300231,
      "title": "送贺遂员外外甥",
      "content": [
        "南国有归舟，荆门溯上流。",
        "苍茫葭菼外，云水与昭丘。",
        "樯带城乌去，江连暮雨愁。",
        "猿声不可听，莫待楚山秋。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 300232,
      "title": "送杨长史赴果州",
      "content": [
        "襃斜不容幰，之子去何之。",
        "鸟道一千里，猿声十二时。",
        "官桥祭酒客，山木女郎祠。",
        "别后同明月，君应听子规。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 300233,
      "title": "送邢桂州",
      "content": [
        "铙吹喧京口，风波下洞庭。",
        "赭圻将赤岸，击汰复扬舲。",
        "日落江湖白，潮来天地青。",
        "明珠归合浦，应逐使臣星。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 300234,
      "title": "送宇文三赴河西充行军司马",
      "content": [
        "横吹杂繁笳，边风卷塞沙。",
        "还闻田司马，更逐李轻车。",
        "蒲类成秦地，莎车属汉家。",
        "当令犬戎国，朝聘学昆邪。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 300235,
      "title": "送孙二",
      "content": [
        "郊外谁相送，夫君道术亲。",
        "书生邹鲁客，才子洛阳人。",
        "祖席依寒草，行车起暮尘。",
        "山川何寂寞，长望泪沾巾。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 300236,
      "title": "送崔三往密州觐省",
      "content": [
        "南陌去悠悠，东郊不少留。",
        "同怀扇枕恋，独念倚门愁。",
        "路遶天山雪，家临海树秋。",
        "鲁连功未报，且莫蹈沧洲。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 300237,
      "title": "送孟六归襄阳",
      "content": [
        "杜门不复出，久与世情疎。",
        "以此为良策，劝君归旧庐。",
        "醉歌田舍酒，笑读古人书。",
        "好是一生事，无劳献子虚。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 300238,
      "title": "初出济州别城中故人",
      "content": [
        "微官易得罪，谪去济川阴。",
        "执政方持法，明君照此心。",
        "闾阎河润上，井邑海云深。",
        "纵有归来日，各愁年鬓侵。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 300239,
      "title": "与卢象集朱家",
      "content": [
        "主人能爱客，终日有逢迎。",
        "贳得新丰酒，复闻秦女筝。",
        "柳条疎客舍，槐叶下秋城。",
        "语笑且为乐，吾将达此生。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 300240,
      "title": "登裴秀才迪小台",
      "content": [
        "端居不出户，满目望云山。",
        "落日鸟边下，秋原人外闲。",
        "遥知远林际，不见此簷间。",
        "好客多乘月，应门莫上关。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 300241,
      "title": "游李山人所居因题屋壁",
      "content": [
        "世上皆如梦，狂来止自歌。",
        "问年松树老，有地竹林多。",
        "药倩韩康卖，门容尚子过。",
        "翻嫌枕席上，无那白云何。"
      ],
      "author": {
        "id": 7756,
        "name": "王维"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    }
  ],
