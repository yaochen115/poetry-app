{
  "data": [
    {
      "id": 206405,
      "title": "东观读未见书",
      "content": [
        "汉规群玉府，东观近宸居。",
        "诏许无双士，来观未见书。",
        "皇文开万卷，家学陋三余。",
        "竹帛森延阁，星辰绕直庐。",
        "诸生起孤贱，天子自吹嘘。",
        "愿以多闻力，论思补帝裾。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206406,
      "title": "被褐怀珠玉",
      "content": [
        "国士怀珠玉，通津不易扛。",
        "椟藏心有待，褐短义难降。",
        "宝唾归青简，晴虹贯夜窗。",
        "直言方按剑，岂是故迷邦。",
        "弹雀轻千仞，连城买一双。",
        "安知蓝缕底，明月弄寒江。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206407,
      "title": "款塞来享",
      "content": [
        "前朝夏州守，来款塞门西。",
        "圣主敷文德，降书付狄鞮。",
        "毡裘瞻日月，剺面带金犀。",
        "殿陛闲干羽，边亭息鼓鼙。",
        "永输量谷马，不作触藩羝。",
        "声势常相倚，今闻定五溪。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206408,
      "title": "忆邢惇夫",
      "content": [
        "诗到随州更老成，江山为助笔纵横。",
        "眼看白璧埋黄壤，何况人间父子情。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206409,
      "title": "次韵秦少章晁适道赠答诗",
      "content": [
        "二子论文地，阴风雪塞庐。",
        "宁穿东郭履，不遗子公书。",
        "士固难推挽，时闻有诏除。",
        "负暄真得计，献御恐成疏。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 206410,
      "title": "次韵答秦少章乞酒",
      "content": [
        "朝事鞍马早，吏曹文墨拘。",
        "初无尺寸补，但于朋友疏。",
        "岂如箪瓢子，卧起一床书。",
        "炙背道尧舜，雪屋相与娱。",
        "步出城东门，野鸟吟废墟。",
        "颇知富贵事，势穷心亦舒。",
        "诗来献穷状，水餠嚼冰蔬。",
        "斗酒得醉否，枵腹如瓠壶。",
        "亦可召西舍，侯嬴非博徒。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206411,
      "title": "颐轩诗六首  其一",
      "content": [
        "金石不随波，松竹知岁寒。",
        "冥此芸芸境，回向自心观。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 206412,
      "title": "颐轩诗六首  其二",
      "content": [
        "知足是灵龟，无厌乃朵颐。",
        "虚心万物表，寒暑自四时。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 206413,
      "title": "颐轩诗六首  其三",
      "content": [
        "无外一精明，六合同出自。",
        "公能知本源，佛亦不相似。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 206414,
      "title": "颐轩诗六首  其四",
      "content": [
        "辱莫辱多欲，乐莫乐无求。",
        "人生强学耳，万古一东流。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 206415,
      "title": "颐轩诗六首  其五",
      "content": [
        "枢机要发迟，饮食戒味厚。",
        "渔人溺于波，君子溺于口。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 206416,
      "title": "颐轩诗六首  其六",
      "content": [
        "泾流不浊渭，种桃无李实。",
        "养心去尘缘，光明生虚室。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 206417,
      "title": "寺斋睡起二首  其一",
      "content": [
        "小黠大痴螳捕蝉，有余不足夔怜蚿。",
        "退食归来北窗梦，一江风月桃李船。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206418,
      "title": "寺斋睡起二首  其二",
      "content": [
        "桃李无言一再风，黄鹂惟见绿葱葱。",
        "人言九事八为律，傥有江船吾欲东。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206419,
      "title": "记梦",
      "content": [
        "众真绝妙拥灵君，晓然梦之非纷纭。",
        "窗中远山是眉黛，席上榴花皆舞裙。",
        "借问琵琶得闻否，灵君色庄妓摇手。",
        "两客争棋烂斧柯，一儿坏局君不呵。",
        "杏梁归燕语空多，奈此云窗雾阁何。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206420,
      "title": "同元明过洪福寺戏题",
      "content": [
        "洪福僧园拂绀纱，旧题尘壁似昏鸦。",
        "春残已是风和雨，更著游人撼落花。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206421,
      "title": "戏答晁深道乞消梅二首  其一",
      "content": [
        "青莎径里香未干，黄鸟阴中实已团。",
        "蒸豆作乌盐作白，属闻丹杏荐牙盘。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206422,
      "title": "戏答晁深道乞消梅二首  其二",
      "content": [
        "北客未尝眉自颦，南人夸说齿生津。",
        "磨钱和蜜谁能许，去蒂供盐亦可人。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206423,
      "title": "以梅餽晁深道戏赠二首  其一",
      "content": [
        "带叶连枝摘未残，依依茶坞竹篱间。",
        "相如病渴应须此，莫与文君蹙远山。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206424,
      "title": "以梅餽晁深道戏赠二首  其二",
      "content": [
        "渴梦吞江起解颜，诗成有味齿牙间。",
        "前身邺下刘公干，今日江南庾子山。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206425,
      "title": "次韵孙子实题少章寄寂斋",
      "content": [
        "虚名误壮夫，今古可笑闵。",
        "尸裹万里归，书载五车稛。",
        "安知衡门下，身与天地准。",
        "秦晁两美士，内行颇修谨。",
        "余欲造之深，抽琴去其轸。",
        "寄寂喧哄间，此道有汲引。",
        "狱户闻笞榜，市声杂嘲辴。",
        "二生对曲肱，圭玉发石蕴。",
        "大小穷鹏鷃，短长见椿槿。",
        "欲闻寂时声，黄钟在龙笋。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206426,
      "title": "次韵孙子实寄少游",
      "content": [
        "薛宣欲吏云，季氏或招闵。",
        "此公胸中秋，万物欲收稛。",
        "卖药偶知名，草玄非近准。",
        "才难不易得，志大略细谨。",
        "士生要弘毅，天地为盖轸。",
        "骥来盐车骖，井下短绠引。",
        "难甘呼尔食，聊寄粲然辴。",
        "谁能借前筹，还妇用束缊。",
        "吾闻调羹鼎，异味及枌堇。",
        "岂其供王羞，而弃会稽笋。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206427,
      "title": "戏书秦少游壁",
      "content": [
        "丁令威，化作辽东白鹤归，朱颜未改故人非。",
        "微服过宋风退飞，宋父拥篲待来归，谁馈百牢鸜鹆妃。",
        "秦氏乌生八九子，鸦乌之兄毕逋尾。",
        "忆炊门牡烹伏雌，未肯增巢令汝栖。",
        "莫愁野雉疏家鸡，但愿主人印累累。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206428,
      "title": "赠秦少仪",
      "content": [
        "汝南许文休，马磨自衣食。",
        "但闻郡功曹，满世名籍籍。",
        "渠命有显晦，非人作通塞。",
        "秦氏多英俊，少游眉最白。",
        "颇闻鸿雁行，笔皆万人敌。",
        "吾早知有觏，而不知有觌。",
        "少仪袖诗来，剖蚌珠的皪。",
        "乃能持一镞，与我箭锋直。",
        "自吾得此诗，三日卧向壁。",
        "挽士不能寸，推去辄数尺。",
        "才难不其然，有亦未易识。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206429,
      "title": "送少章从翰林苏公余杭",
      "content": [
        "东南淮海惟扬州，国士无双秦少游。",
        "欲攀天关守九虎，但有笔力回万牛。",
        "文学纵横乃如此，故应当家有季子。",
        "时来谁能力作难，鸿雁行飞入道山。",
        "斑衣儿啼真自乐，从师学道也不恶。",
        "但使新年胜故年，即如常在郎罢前。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206430,
      "title": "题浄因壁二首  其一",
      "content": [
        "暝倚蒲团挂钵囊，半窗疏箔度微凉。",
        "蕉心不展待时雨，葵叶为谁倾太阳。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206431,
      "title": "题浄因壁二首  其二",
      "content": [
        "门外黄尘不见山，此中草木亦常闲。",
        "履声如度薄冰过，催粥华鲸吼夜阑。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206432,
      "title": "六月十七日昼寝",
      "content": [
        "红尘席帽乌韡里，想见沧洲白鸟双。",
        "马龁枯萁喧午枕，梦成风雨浪翻江。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206433,
      "title": "北窗",
      "content": [
        "生物趋功日夜流，园林才夏麦先秋。",
        "绿阴黄鸟北窗簟，付与来禽安石榴。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206434,
      "title": "赵子充示竹夫人诗盖凉寝竹器憩臂休膝似非夫人之职予为名曰青奴并以小诗取之二首  其一",
      "content": [
        "青奴元不解梳妆，合在禅斋梦蝶床。",
        "公自有人同枕簟，肌肤冰雪助清凉。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206435,
      "title": "赵子充示竹夫人诗盖凉寝竹器憩臂休膝似非夫人之职予为名曰青奴并以小诗取之二首  其二",
      "content": [
        "秾李四弦风拂席，昭华三弄月侵床。",
        "我无红袖堪娱夜，正要青奴一味凉。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206436,
      "title": "范蜀公挽词二首  其一",
      "content": [
        "信道虽常尔，知人乃独亨。",
        "书林身老大，谏纸字敧倾。",
        "鼇去三山动，人危五鼎烹。",
        "保全天子圣，几杖送余生。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 206437,
      "title": "范蜀公挽词二首  其二",
      "content": [
        "公在昭陵日，文章近赤墀。",
        "空嗟伏生老，不侍迩英帷。",
        "去国几三虎，闻韶待一夔。",
        "谁言盖棺了，新乐锁蛛丝。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 206438,
      "title": "宗室公寿挽词二首  其一",
      "content": [
        "昔在熙宁日，葭莩接贵游。",
        "题诗奉先寺，横笛宝津楼。",
        "天网恢中夏，宾筵禁列侯。",
        "但闻刘子政，头白更清修。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 206439,
      "title": "宗室公寿挽词二首  其二",
      "content": [
        "昧旦鸣珂路，春朝禁殿班。",
        "方看分宝玉，何意作丘山。",
        "燕入风荣舞，花开日笑颜。",
        "空余杜陵泪，一为汉中潸。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 206440,
      "title": "出城送客过故人东平侯赵景珍墓",
      "content": [
        "朱颜苦留不肯住，白发正尔欺得人。",
        "婵娟去作谁家妾，意气都成一聚尘。",
        "今日牛羊上丘垄，当时近前左右嗔。",
        "花开鸟啼荆棘里，谁与平章作好春。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 206441,
      "title": "黄颍州挽词三首  其一",
      "content": [
        "恭惟同自出，累世复通家。",
        "惠沫霑枯涸，忠规补过差。",
        "胸中明玉石，仕路困风沙。",
        "尚有平生酒，秋原洒菊花。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 206442,
      "title": "黄颍州挽词三首  其二",
      "content": [
        "临民次公老，论事长舆通。",
        "袖有投虚刃，时无斲鼻工。",
        "风流前辈近，名实后人公。",
        "不谓三日别，今成万事空。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 206443,
      "title": "黄颍州挽词三首  其三",
      "content": [
        "公与汝阳守，人间孝友稀。",
        "脊令鸣夜雨，常棣倚春晖。",
        "粉省双飞入，泉台相与归。",
        "哀笳宛丘道，衰涕不胜挥。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 206444,
      "title": "乐寿县君吕氏挽词二首  其一",
      "content": [
        "归装衣楚楚，家世印累累。",
        "来作箕帚妇，不忘苹藻诗。",
        "居然成万古，何啻谒三医。",
        "骑省还秋直，霜侵鬓脚衰。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 206445,
      "title": "乐寿县君吕氏挽词二首  其二",
      "content": [
        "剪髻宾筵盛，齐眉妇礼闲。",
        "谓宜俱白发，忽去作青山。",
        "大梦惊蝴蝶，何时识佩环。",
        "哀歌行欲绝，丹旐雨斑斑。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 206446,
      "title": "叔父给事挽词十首  其一",
      "content": [
        "元祐宗臣考十科，公居八九未为多。",
        "功名身后无瑕点，孝友生知不琢磨。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206447,
      "title": "叔父给事挽词十首  其二",
      "content": [
        "平生治狱有阴功，忠孝临民父母同。",
        "赣上樵夫谈卓令，宣城老吏识于公。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206448,
      "title": "叔父给事挽词十首  其三",
      "content": [
        "三晋山河数十州，频年水旱不能秋。",
        "我公出把司农节，粟麦还于地上流。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206449,
      "title": "叔父给事挽词十首  其四",
      "content": [
        "更生苦讼石中书，宰掾非人欲引裾。",
        "两猾论兵几败国，同时御史更谁如。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206450,
      "title": "叔父给事挽词十首  其五",
      "content": [
        "曾发公家钜万钱，沟中襁褓却生全。",
        "三齐水后皆禾稼，不杀耕牛更可传。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206451,
      "title": "叔父给事挽词十首  其六",
      "content": [
        "晋地无戎卧贼曹，民兵赐笏解弓刀。",
        "六年讲武儒冠在，不踏金门著战袍。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206452,
      "title": "叔父给事挽词十首  其七",
      "content": [
        "军容百万转风雷，独料王师不战摧。",
        "三箧飞书公对狱，元丰天子照奸回。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206453,
      "title": "叔父给事挽词十首  其八",
      "content": [
        "陇上千山汉节回，扫除民蜮不为灾。",
        "蜀茶总入诸蕃市，胡马常从万里来。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206454,
      "title": "叔父给事挽词十首  其九",
      "content": [
        "廊庙从来不在边，黄扉青琐庆登贤。",
        "除书未试回天笔，何意佳城到马前。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206455,
      "title": "叔父给事挽词十首  其一○",
      "content": [
        "荣禄常思泽九宗，山摧梁坏床成空。",
        "百年遗恨谁昭洗，他日诸郎有父风。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206456,
      "title": "寂住阁",
      "content": [
        "庄周梦为胡蝶，胡蝶不知庄周。",
        "当处出生随意，急流水上不流。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206457,
      "title": "深明阁",
      "content": [
        "象踏恒河彻底，日行阎浮破冥。",
        "若问深明宗旨，风花时度窗棂。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206458,
      "title": "竹枝词二首  其一",
      "content": [
        "撑崖拄谷蝮蛇愁，入箐攀天猿掉头。",
        "鬼门关外莫言远，五十三驿是皇州。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 206459,
      "title": "竹枝词二首  其二",
      "content": [
        "浮云一百八盘萦，落日四十八渡明。",
        "鬼门关外莫言远，四海一家皆弟兄。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 206460,
      "title": "梦李白诵竹枝词三叠  其一",
      "content": [
        "一声望帝花片飞，万里明妃雪打围。",
        "马上胡儿那解听，琵琶应道不如归。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 206461,
      "title": "梦李白诵竹枝词三叠  其二",
      "content": [
        "竹竿坡面蛇倒退，摩围山腰胡孙愁。",
        "杜鹃无血可续泪，何日金鸡赦九州。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 206462,
      "title": "梦李白诵竹枝词三叠  其三",
      "content": [
        "命轻人鲊瓮头船，日瘦鬼门关外天。",
        "北人堕泪南人笑，青壁无梯闻杜鹃。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 206463,
      "title": "和答元明黔南赠别",
      "content": [
        "万里相看忘逆旅，三声清泪落离觞。",
        "朝云往日攀天梦，夜雨何时对榻凉。",
        "急雪脊令相并影，惊风鸿雁不成行。",
        "归舟天际常回首，从此频书慰断肠。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 206464,
      "title": "题苏若兰回文锦诗图",
      "content": [
        "千诗织就回文锦，如此阳台暮雨何。",
        "亦有英灵苏蕙手，只无悔过窦连波。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206465,
      "title": "次韵杨明叔四首  其一",
      "content": [
        "鱼去游濠上，鸮来止坐隅。",
        "吉凶终我在，忧乐与生俱。",
        "决定不是物，方名大丈夫。",
        "今观由也果，老子欲乘桴。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 206466,
      "title": "次韵杨明叔四首  其二",
      "content": [
        "道常无一物，学要反三隅。",
        "喜与嗔同本，嗔时喜自俱。",
        "心随物作宰，人谓我非夫。",
        "利用兼精义，还成到岸桴。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 206467,
      "title": "次韵杨明叔四首  其三",
      "content": [
        "全德备万物，大方无四隅。",
        "身随腐草化，名与太山俱。",
        "道学归吾子，言诗起老夫。",
        "无为蹈东海，留作济川桴。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 206468,
      "title": "次韵杨明叔四首  其四",
      "content": [
        "匹士能光国，三孱不满隅。",
        "窃观今日事，君与古人俱。",
        "气类鶑求友，精诚石望夫。",
        "雷门震惊手，待汝一援桴。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 206469,
      "title": "再次韵",
      "content": [
        "穷奇投有北，鸿鹄止丘隅。",
        "我已魑魅御，君方燕雀俱。",
        "道应无蒂芥，学要尽工夫。",
        "莫斩猿狙杙，明堂待栋桴。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 206470,
      "title": "谪居黔南十首  其一",
      "content": [
        "相望六千里，天地隔江山。",
        "十书九不到，何用一开颜。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 206471,
      "title": "谪居黔南十首  其二",
      "content": [
        "霜降水反壑，风落木归山。",
        "冉冉岁华晚，昆虫皆闭关。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 206472,
      "title": "谪居黔南十首  其三",
      "content": [
        "冷淡病心情，暄和好时节。",
        "故园音信断，远郡亲宾绝。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 206473,
      "title": "谪居黔南十首  其四",
      "content": [
        "山郭灯火稀，峡天星汉少。",
        "年光东流水，生计南枝鸟。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 206474,
      "title": "谪居黔南十首  其五",
      "content": [
        "冥怀齐远近，委顺随南北。",
        "归去诚可怜，天涯住亦得。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 206475,
      "title": "谪居黔南十首  其六",
      "content": [
        "老色日上面，欢悰日去心。",
        "今既不如昔，后当不如今。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 206476,
      "title": "谪居黔南十首  其七",
      "content": [
        "啧啧雀引雏，梢梢笋成竹。",
        "时物感人情，忆我故乡曲。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 206477,
      "title": "谪居黔南十首  其八",
      "content": [
        "苦雨初入梅，瘴云稍含毒。",
        "泥秧水畦稻，灰种畬田粟。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 206478,
      "title": "谪居黔南十首  其九",
      "content": [
        "轻纱一幅巾，小簟六尺床。",
        "无客尽日静，有风终夜凉。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 206479,
      "title": "谪居黔南十首  其一○",
      "content": [
        "病人多梦医，囚人多梦赦。",
        "如何春来梦，合眼在乡社。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 206480,
      "title": "赠黔南贾使君",
      "content": [
        "绿发将军领百蛮，横戈得句一开颜。",
        "少年圯下传书客，老去崆峒问道山。",
        "春入鶑花空自笑，秋成梨枣为谁攀。",
        "何时定作风光主，待得征西鼓吹还。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 206481,
      "title": "次韵雨丝云鹤二首  其一",
      "content": [
        "烟云杳霭合中稀，雾雨空蒙密更微。",
        "园客茧丝抽万绪，蛛蝥网面罩群飞。",
        "风光错综天经纬，草木文章帝杼机。",
        "愿染朝霞成五色，为君王补坐朝衣。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 206482,
      "title": "次韵雨丝云鹤二首  其二",
      "content": [
        "几片云如薛公鹤，精神态度不曾齐。",
        "安知陇鸟樊笼密，便觉南鹏羽翼低。",
        "风散又成千里去，夜寒应上九天栖。",
        "坐来改变如苍狗，试欲挥毫意自迷。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 206483,
      "title": "从斌老乞苦笋",
      "content": [
        "南园苦笋味胜肉，箨龙称冤莫采录。",
        "烦君更致苍玉束，明日风雨皆成竹。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206484,
      "title": "次韵黄斌老所画横竹",
      "content": [
        "酒浇胸次不能平，吐出苍竹岁峥嵘。",
        "卧龙偃蹇雷不惊，公与此君俱忘形。",
        "晴窗影落石泓处，松煤浅染饱霜兔。",
        "中安三石使屈蟠，亦恐形全便飞去。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 206485,
      "title": "次韵谢黄斌老送墨竹十二韵",
      "content": [
        "古今作生竹，能者未十辈。",
        "吴生勒枝叶，筌采远不逮。",
        "江南铁钩锁，最许诚悬会。",
        "燕公洒墨成，落落与时背。",
        "譬如刳心松，中有岁寒在。",
        "湖州三百年，笔与前哲配。",
        "规模转银钩，幽赏非俗爱。",
        "披图风雨入，咫尺莽苍外。",
        "吾宗学湖州，师逸功已倍。",
        "有来竹四幅，冬夏生变态。",
        "预知更入神，后出遂无对。",
        "吾诗被压倒，物固不两大。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206486,
      "title": "用前韵谢子舟为予作风雨竹",
      "content": [
        "子舟诗书客，画手睨前辈。",
        "挹袂拍其肩，余力左右逮。",
        "摩拂造化炉，经营鬼神会。",
        "光煤叠乱叶，世与作者背。",
        "看君回腕笔，犹喜汉仪在。",
        "岁寒十三本，与可可追配。",
        "小山苍苔面，突兀谢憎爱。",
        "风斜兼雨重，意出笔墨外。",
        "吾闻绝一源，战胜自十倍。",
        "荣枯转时机，生死付交态。",
        "狙公倒七芧，勿用嗔喜对。",
        "此物当更工，请以小喻大。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206487,
      "title": "再用前韵咏子舟所作竹",
      "content": [
        "森萷一山竹，壮士十三辈。",
        "自干云天去，草芥肯下逮。",
        "虚心听造物，颠沛风云会。",
        "荣枯偶同时，终不相弃背。",
        "谁云湖州没，笔力今尚在。",
        "阿筌虽墨妙，好以桃李配。",
        "国工裁主意，冷淡恐不爱。",
        "子舟落心画，荣观不在外。",
        "耆年道机熟，增胜当倍倍。",
        "祖述今百家，小纸弄姿态。",
        "虽云出湖州，卷置懒开对。",
        "非公笔如椽，孰能为之大。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206488,
      "title": "戏咏子舟画两竹两鸜鹆",
      "content": [
        "风晴日暖摇双竹，竹间相语两鸜鹆。",
        "鸜鹆之肉不可肴，人生不材果为福。",
        "子舟之笔利如锥，千变万化皆天机。",
        "未知笔下鸜鹆语，何似梦中胡蝶飞。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 206489,
      "title": "次韵答斌老病起独游东园二首  其一",
      "content": [
        "万事同一机，多虑乃禅病。",
        "排闷有新诗，忘蹄出兔径。",
        "莲花生淤泥，可见嗔喜性。",
        "小立近幽香，心与晚色静。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 206490,
      "title": "次韵答斌老病起独游东园二首  其二",
      "content": [
        "主人心安乐，花竹有和气。",
        "时从物外赏，自益酒中味。",
        "𣃁枯蚁改穴，扫箨笋迸地。",
        "万籁寂中生，乃知风雨至。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 206491,
      "title": "又和二首  其一",
      "content": [
        "西风鏖残暑，如用霍去病。",
        "疏沟满莲塘，扫叶明竹迳。",
        "中有寂寞人，自知圆觉性。",
        "心猿方睡起，一笑六窗静。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 206492,
      "title": "又和二首  其二",
      "content": [
        "外物攻伐人，钟鼓作声气。",
        "待渠弓箭尽，我自味无味。",
        "宴安衽席间，蛟鳄垂涎地。",
        "君子履微霜，即知坚冰至。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 206493,
      "title": "又答斌老病愈遣闷二首  其一",
      "content": [
        "百疴从中来，悟罢本谁病。",
        "西风将小雨，凉入居士径。",
        "苦竹遶莲塘，自悦鱼鸟性。",
        "红荷倚翠盖，不点禅心静。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 206494,
      "title": "又答斌老病愈遣闷二首  其二",
      "content": [
        "风生高竹凉，雨送新荷气。",
        "鱼游悟世网，鸟语入禅味。",
        "一挥四百病，智刃有余地。",
        "病来每厌客，今乃思客至。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 206495,
      "title": "次韵黄斌老晚游池亭二首  其一",
      "content": [
        "路入东园无俗驾，忽逢佳士喜同游。",
        "绿荷菡萏稍觉晚，黄菊拒霜殊未秋。",
        "客位正须悬榻下，主人自爱小塘幽。",
        "老夫多病蛮江上，颇忆平生马少游。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 206496,
      "title": "次韵黄斌老晚游池亭二首  其二",
      "content": [
        "岑寂东园可散愁，胶胶扰扰梦神游。",
        "万竿苦竹旌旗卷，一部鸣蛙鼓吹休。",
        "雨后月前天欲冷，身闲心远地常幽。",
        "杜门谢客恐生谤，且作人间鹏鷃游。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 206497,
      "title": "戏答史应之三首  其一",
      "content": [
        "先生早擅屠龙学，袖有新硎不试刀。",
        "岁晚亦无鸡可割，庖蛙煎鳝荐松醪。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206498,
      "title": "戏答史应之三首  其二",
      "content": [
        "老莱有妇怀高义，不厌夫家苜蓿盘。",
        "收得千金不龟药，短裙漂絖暮江寒。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206499,
      "title": "戏答史应之三首  其三",
      "content": [
        "甑有轻尘釜有鱼，汉庭日日召严徐。",
        "不嫌藜藿来同饭，更展芭蕉看学书。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206500,
      "title": "题也足轩",
      "content": [
        "道人手种两三竹，使君忽来唾珠玉。",
        "不须客赋千首诗，若是赏音一夔足。",
        "世人爱处但同流，一丝不挂似太俗。",
        "客来若问有何好，道人优昙远山绿。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 206501,
      "title": "寄题荣州祖元大师此君轩",
      "content": [
        "王师学琴三十年，响如清夜落涧泉。",
        "满堂洗尽筝琶耳，请师停手恐断弦。",
        "神人传书道人命，死生贵贱如看镜。",
        "晚知直语触憎嫌，深藏幽寺听钟磬。",
        "有酒如渑客满门，不可一日无此君。",
        "当时手栽数寸碧，声挟风雨今连云。",
        "此君倾盖如故旧，骨相奇怪清且秀。",
        "程婴杵臼立孤难，伯夷叔齐采薇瘦。",
        "霜钟堂上弄秋月，微风入弦此君悦。",
        "公家周彦笔如椽，此君语意当能传。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206502,
      "title": "答李任道谢分豆粥",
      "content": [
        "豆粥能驱晚瘴寒，与公同味更同餐。",
        "安知天上养贤鼎，且作山中煮菜看。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206503,
      "title": "赠知命弟离戎州",
      "content": [
        "道人终岁学陶朱，西子同舟泛五湖。",
        "船窗卧读书万卷，还有新诗来起予。"
