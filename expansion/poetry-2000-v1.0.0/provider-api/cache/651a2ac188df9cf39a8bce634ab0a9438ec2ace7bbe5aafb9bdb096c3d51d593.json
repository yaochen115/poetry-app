{
  "data": [
    {
      "id": 13740,
      "title": "自咏  其二",
      "content": [
        "上都频见岁华阴，偃息由来本茂林。",
        "醉若有乡须裂地，吏如逢隠即投簪。",
        "衔无窭数知容冗，病似支离亦挫针。",
        "况自疏家兄弟约，他年擉鼈故溪浔。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13741,
      "title": "自咏  其三",
      "content": [
        "误怀手版应弓招，汩汩尘容葆鬓凋。",
        "潘拙本无乡曲誉，嵇驽偏恃母兄骄。",
        "雨畦菘叶晨羞薄，风灶茶烟午睡销。",
        "纵到北山堪自笑，春萝秋桂久寥寥。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13742,
      "title": "闻王侍郎请老",
      "content": [
        "未老辞荣上所褒，官闲犹寄白云曹。",
        "海边人乐鸥先下，笼外天多鹤始高。",
        "此路逍遥真有趣，他年侍从信为劳。",
        "清商弟子歌声妙，谁判挥金引冻醪。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13743,
      "title": "步药北园",
      "content": [
        "倦持尘簿著纶巾，清眺城隅夏物新。",
        "幽鹭仪容高似客，晚鶑言语巧于人。",
        "雨边斜照犹衔岭，风后余凉自舞苹。",
        "天借使君仁智地，此来山水更相亲。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13744,
      "title": "将解职抒怀上郡守",
      "content": [
        "空函檄草聚浮埃，日愧西园缀上才。",
        "著帽每容司马进，脱巾多伴使君来。",
        "孤根易变江南橘，归梦先随陇首梅。",
        "惟有酬恩无限泪，异时应溅别离杯。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13745,
      "title": "抒怀上南京常山公",
      "content": [
        "缁帷怅别倏经年，荣路心危重惘然。",
        "宁死道边终自直，狂歌河上欲谁怜。",
        "魂随夜蝶星垂地，信断秋鳞水接天。",
        "早晚承明庆三入，愿持云汉续遗篇。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13746,
      "title": "段释之客都下作诗道其怀",
      "content": [
        "密雪天街客履穿，更将羁思敌雕年。",
        "无人载酒谁同乐，有物烧愁便许燃。",
        "腷臆文章千牍上，萧条光景二毛边。",
        "我能知子今何頼，无用长于马腹鞭。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13747,
      "title": "献外台王侍御",
      "content": [
        "滥陪坐诺已三年，始望霜威绀弩前。",
        "旧业久辞南郡帐，深恩独戴故人天。",
        "头欹解散惭星弁，腹饱侏儒费月钱。",
        "欲托牙琴愬真赏，流尘无奈晦幺弦。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13748,
      "title": "送蒋御史漕江南",
      "content": [
        "柱后峨冠久未还，江南行府使旗鲜。",
        "陈陈洪庾催输粟，往往吴山即铸钱。",
        "暝月早霞千里国，废楼残社六朝天。",
        "时清宪笔无弹劾，供助骚人藻思妍。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 13749,
      "title": "荷花",
      "content": [
        "晚雨跳珠万盖匀，红房高下照池新。",
        "采时双艇须加桨，行罢微波不见尘。",
        "解把清香贻密坐，忍将芳意付萧晨。",
        "如何老帅残风味，三占秋英作主人。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13750,
      "title": "翰长再有北门之拜",
      "content": [
        "病褫荷囊避禁闱，弥年专气养琼枝。",
        "仙都去后桃寻熟，温室重来树更滋。",
        "宫月旧蟾涵静滴，武泥前劄燥残芝。",
        "宝钉赐带辉腰组，尚苦春来几眼移。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13751,
      "title": "李处士",
      "content": [
        "江天退卧久沈冥，秋入颠毛翠葆惊。",
        "原宪桑枢贫不病，子真岩石老归耕。",
        "樵风挂席晨昏至，屐齿登山上下平。",
        "鄅稻已收霜橘熟，深心宁逐彻侯荣。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13752,
      "title": "学舍诸生罕至或累旬倚席不讲愧而成咏",
      "content": [
        "直舍沈沈掩回廊，古坛槐柳对苍凉。",
        "一囊有客愁饥死，三尺无人问喙长。",
        "瞑据槁梧真用拙，束归高阁分深藏。",
        "日斜广陌驱归鞅，更似笭箵作漫郎。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13753,
      "title": "寄题相台太尉韩公昼锦堂",
      "content": [
        "瑞节前驱昼锦身，堂成署榜示州民。",
        "迁鶑贺燕翩翻集，大树甘棠次第春。",
        "漳岸夕波能沼溜，魏堂暾日弄梁尘。",
        "君看千古青编上，得意如公有几人。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13754,
      "title": "秋日射堂寓目呈应之",
      "content": [
        "射圃云堋枕庾园，危亭虚白敞南轩。",
        "霜柯橘嫩金衣薄，风沼荷倾钿扇翻。",
        "谢枕吟魂迷带草，嵇襟真虑属堂萱。",
        "岸巾昼日聊相对，坐听凝笳出缭垣。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13755,
      "title": "偶作寄季长学士",
      "content": [
        "已是南宫素发郎，尚持衰味对风光。",
        "爱吟讵敢追梁甫，倚醉时能问葛彊。",
        "才苦空疏残史牒，分从澄汰幞衣囊。",
        "江楼夜月清高地，试问同君一据床。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13756,
      "title": "送常州陈商学士",
      "content": [
        "红梨秋老石渠霜，并欲萧萧伴祖觞。",
        "台上幞绫收柘枕，水边古兽得鞶囊。",
        "浮云并盖辞京辇，晓月将潮促使艎。",
        "缘饰有文成政速，剩储灵气茹芝房。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13757,
      "title": "寄会稽天休学士",
      "content": [
        "凫乙天遥水驿长，笠车贪贰会稽章。",
        "风从射的迎仙舸，水是山阴作禊堂。",
        "铃阁宴盘留薤白，书林官笔燥雌黄。",
        "庾郎于此情非浅，应许诸人共据床。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13758,
      "title": "寄弋阳王学士",
      "content": [
        "新年给札汉家台，爱伏枚臯受诏才。",
        "偃蹇不随虞弁进，栖迟翻逐阮麾来。",
        "倡优技拙飞觞浅，寒具盘空秘画开。",
        "早暮传车趋一节，敝冠犹望振穷埃。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13759,
      "title": "喜得当涂叶学士手笔",
      "content": [
        "随岸秋风惨别袪，峥嵘岁晏得双鱼。",
        "定因南浦传能赋，却到西河问索居。",
        "夜月连江金液动，晓山围国钿螺疏。",
        "端倪欲报怀人恨，滴尽瑶蟾尚有余。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13760,
      "title": "送越州陆学士",
      "content": [
        "梅天霞破候旗干，乡树依然越绝间。",
        "挟策当年逢掖去，怀章此地绣衣还。",
        "亭余内史浮觞水，路入仙人取箭山。",
        "牛酒盛夸先墅宴，不妨春诏得亲班。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13761,
      "title": "陕府祖择之学士",
      "content": [
        "白发书林作丈人，陕郊迢递驾朱轮。",
        "谩夸燕许文章手，未得严徐侍从臣。",
        "列岫倚窗吟榭晓，乱花窥酒宴堂春。",
        "几篇新咏留珉刻，首记銮舆八月巡。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13762,
      "title": "和待制庞学士寄献宫师相公之作",
      "content": [
        "溢荥清溜接家田，白首辞荣铉席贤。",
        "直使斯人歌画法，后容吾党记归年。",
        "五禽习戏探仙术，万法观空证佛缘。",
        "闻道岩谿春更好，许谁飞盖奉周旋。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13763,
      "title": "河南希深学士",
      "content": [
        "洛雾嵩云满眼春，仙郎清路拥双轮。",
        "却陪宾客趋东阁，已为阳秋得素臣。",
        "渊秘图书探汉旧，地交风雨访周人。",
        "岁时献寿严君府，谁见家庭玉树新。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13764,
      "title": "寄临江知军刘子先学士",
      "content": [
        "文惠祠前旌旆飞，茫然南望涕横衣。",
        "勤劳塞外凋双鬓，萧散江头把一麾。",
        "都水酒樽花下倒，青塘钓艇月中归。",
        "荐书继上公怜旧，何力酬恩与意违。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13765,
      "title": "送杨学士三首  其一",
      "content": [
        "左幡彤赤抗前旌，捧诏西归觐大庭。",
        "汉署余香薰锦帐，唐家新政纪云屏。",
        "迎秋画隼开朱旆，别夜哀乌动列星。",
        "从此回翔宸渥厚，冠緌清晓俯阶蓂。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13766,
      "title": "送杨学士三首  其二",
      "content": [
        "青丝千骑汉台郎，入奏星藩解郡章。",
        "荷橐再亲文石陛，班春初卷赤帷裳。",
        "百壶帐饮杯醽釂，一劄泥封诏检香。",
        "几日西清劳侍从，鬰葱佳气接明光。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13767,
      "title": "送杨学士三首  其三",
      "content": [
        "觚棱初日九天开，躞蹀桑郊五马回。",
        "群玉三山藏册府，偃壶双笔给中台。",
        "编堂旧政盘留薤，画省新辞砌有苔。",
        "阙里诸生弥属望，雪园他日待延枚。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13768,
      "title": "题景陵干明院湖亭",
      "content": [
        "东眺湖波十里平，竹椽疏舍瞰澄瀛。",
        "山花暗落谈经地，水鸟时闻念佛声。",
        "荠树绕天春色晚，彩云垂地夕凉生。",
        "后车官冷曾过此，祗得幽人笑缚缨。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13769,
      "title": "秋阴",
      "content": [
        "拥栋溪云暝夕霏，萧辰寥落意多违。",
        "寒蝉自为齐王怨，归燕长逢阿母飞。",
        "杜若汀洲残绿暗，芙蓉池沼坠红稀。",
        "流尘满席宾綦绝，谁问西河战胜肥。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13770,
      "title": "和叶道卿连日阴曀坐曹无绪见寄",
      "content": [
        "雾著青旗燕尾斜，轻阴连日徧天涯。",
        "上林已暖先催雁，细柳犹疏不碍鸦。",
        "积润未妨铿画瑟，薄寒仍欲定流霞。",
        "问君何事贪官事，只倚雕章念岁华。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13771,
      "title": "贺中丞晏尚书春阴",
      "content": [
        "轻寒剪剪著春旗，楼外晨光已暗移。",
        "小雾不还添柳弱，余寒未去恼花迟。",
        "幺弦促柱愁成曲，远水迎船巧作漪。",
        "谁在河桥望归客，莫将雷响误轻辎。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13772,
      "title": "题翠樾亭",
      "content": [
        "茂树交轩地不尘，江光野气望中新。",
        "客来鱼鸟皆知乐，梦罢池塘并得春。",
        "烟竹有痕时拂户，风花无意自飘人。",
        "当年幕客今追恨，不共山公岸醉巾。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13773,
      "title": "梦野亭在景陵集仙王君为郡日所创",
      "content": [
        "州堞巑岏迥势回，一翚斜翥四轩开。",
        "晴光猎草雄风度，晓气浮江赤日来。",
        "望极长天闲倚杵，醉残严角暝休梅。",
        "须知故楚多余感，剩费登高作赋才。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13774,
      "title": "送连氏昆仲还省侍",
      "content": [
        "酥酪君家伯仲贤，相从黉舍倏经年。",
        "三巵酒薄难为圣，一腹书空但喜眠。",
        "庾信刻筠怀旧坞，隠侯题壁有新篇。",
        "糅甘调滑思归养，溢握陔兰照露鲜。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13775,
      "title": "秋夕池上",
      "content": [
        "楚江枫老树无烟，池上悲秋一惘然。",
        "素蚌亏盈长伴月，戏鱼南北各依莲。",
        "风驱野燐寒争出，露警臯禽怨不眠。",
        "伏槛临流未成下，紫荷声外转珠躔。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13776,
      "title": "屈原祠",
      "content": [
        "楚江南望见修门，灵鼓声沈蕙卷樽。",
        "五日长蛟虚望祭，九关雕虎枉招魂。",
        "兰苕猎翠凄寒露，枫叶摇丹啸暝猿。",
        "贾谊扬生成感后，沈沙投阁两衔冤。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13777,
      "title": "州举俊民以艺中第为诗驰贺",
      "content": [
        "曾联郡将署乡书，目见函关卖出符。",
        "奏颂一挥云落纸，赐袍三浴蕙飘炉。",
        "高轩竝照连干锦，饮膳分颁萐莆厨。",
        "病幕日期迎昼绣，尘容甘预弩前驱。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13778,
      "title": "渑池道中",
      "content": [
        "月枢残白伴征轮，雪岭萧萧久垫巾。",
        "此去崤函天设险，古来京洛地多尘。",
        "翠含山气犹疑夜，紫动林梢已放春。",
        "自笑衰翁应分定，宠光行役两平均。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13779,
      "title": "屡乞近郡诏不许",
      "content": [
        "避贤求假左朱轮，衡石通章触罢频。",
        "十驾似驽宁取道，五能如鼠不藏身。",
        "危心事国区区在，短领侵年种种新。",
        "君惠转深无报日，长教猿鹤怨归人。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13780,
      "title": "祗役邻郡道中晓发",
      "content": [
        "故园回眼隔云罗，野马征尘拂袂过。",
        "息影有时悲恶木，回车无暇避朝歌。",
        "风号万响天衢籁，山矗千头佛国螺。",
        "游子行行归计晚，庾心一寸奈愁何。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13781,
      "title": "将道洛先寄太师文相公",
      "content": [
        "两鬓蓬飞岁月侵，收还秘殿上恩深。",
        "鸟毛落尽那胜弹，桐尾烧焦敢望琴。",
        "前日化工依大冶，今兹旧物恃遗簪。",
        "尘容喜接荧煌座，未忍公然动越吟。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13782,
      "title": "登楼望郡中美人物之盛",
      "content": [
        "晓色青烟万瓦间，飞谯极望尽通阛。",
        "轮音闹过丛台市，岁计多于畏垒山。",
        "猎路向寒鹰眼疾，戍亭无事犬声闲。",
        "邑民讼息风谣乐，坐饫双鸡止厚颜。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13783,
      "title": "送史温虞部佐郡四明",
      "content": [
        "外署清郎出佐州，嘲辞不畏上山头。",
        "天中倦目迷云阙，江上归帆避石邮。",
        "佳设自随宾早晏，还书宁畏渚沈浮。",
        "疁田越镈农知劝，时伴春旗暗绿畴。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13784,
      "title": "有诏解郡作  其一",
      "content": [
        "二年憔悴拥州旗，尺诏初容觐帝晖。",
        "何幸复燃灰不死，未应为失马重归。",
        "蛟螭对舞瞻层阁，翁仲双扶识故扉。",
        "病骨多忧黧黑甚，豫惭台史与薰衣。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13785,
      "title": "有诏解郡作  其二",
      "content": [
        "尘晦荷囊裂旧缝，惊闻台召计匆匆。",
        "忽从楚水枫林下，还入甘泉豹尾中。",
        "即日遂收西望涕，方春便趁北归鸿。",
        "休夸四入高凉地，已是人间素领翁。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13786,
      "title": "送太常边博士守永嘉郡",
      "content": [
        "稷野英僚抱𫈵新，东瓯假守左朱轮。",
        "吴刀列卫州仪盛，越镈催耕海葑春。",
        "萍渚日华摇使旆，蜃天楼影暗潮津。",
        "射堂西出宾簪乐，飞尽歌梁几夕尘。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13787,
      "title": "送薛学士伯垂同理嘉兴郡兼简太守集仙柳著作",
      "content": [
        "广内多年铁㰅摧，监州新命诏函开。",
        "河东世擅鹓雏誉，江左人瞻竹箭才。",
        "即席离弦凄鹄韵，几程残魄晦珠胎。",
        "兴禾善俗蓬仙友，剩舞吴歈耻宴罍。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13788,
      "title": "谢都官监建安郡",
      "content": [
        "郎署新畴出宰功，海闽关夹使旌雄。",
        "晨涂倦伏双毫奏，暮席贪随五两风。",
        "芳荈摘山唐贡远，薧鱼升豆汉祠丰。",
        "赌囊贵胄膏腴盛，丽唱行闻溢褚中。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13789,
      "title": "江渎池亭",
      "content": [
        "一翚掀翅压溪隅，吏事初闲此晏居。",
        "断岸有时通略彴，轻风尽日战栟榈。",
        "云鸿送目挥弦后，客板看山拄颊余。",
        "芰碧蒲青来更数，江人多识使君旟。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13790,
      "title": "古意",
      "content": [
        "博妖齐许取侯封，褒贬都归竹帛中。",
        "三虎有无空逞辩，一狐埋伏妄贪功。",
        "轮囷自许先枯木，首鼠何曾忌秃翁。",
        "堪笑云罗弥薮泽，不知天外有冥鸿。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 13791,
      "title": "寒食野外书所见",
      "content": [
        "一雨初回逗晚凉，近郊连帟俨相望。",
        "乞浆易醉墦间客，就养初闲灶下郎。",
        "暖吹未休缘迥野，低烟不散为垂杨。",
        "家家钟鼓争行乐，肯信龙蛇是怨章。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13792,
      "title": "将到都先献枢密太尉相公",
      "content": [
        "再试州旟验不才，却将憔悴到中台。",
        "相车问罢同牛喘，大厦成时与燕来。",
        "今日谋猷须丙魏，他年宾客但邹枚。",
        "西园闻道余春在，尚及花前滟滟杯。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13793,
      "title": "送太尉相公赴镇安军二首  其一",
      "content": [
        "连章得请避洪钧，赭案除书天下闻。",
        "久冠鹓鸾为上宰，别驱貔虎作中军。",
        "单车款曲怀辽帐，一燧平安出陇云。",
        "今日朝绅回首看，始知知退是元勋。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13794,
      "title": "送太尉相公赴镇安军二首  其二",
      "content": [
        "碧波三宿暂沿洄，豹尾双驱大旆开。",
        "堂上谟成萧宰去，人间事少赤松来。",
        "岩霖旧润为轩雨，醴曲余甘作宴醅。",
        "下客无缘陪后乘，只应前席欠邹枚。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13795,
      "title": "答庞丞相",
      "content": [
        "安车就第上优贤，不使当关损晏眠。",
        "勋重旧更三府地，体强初过六身年。",
        "游篮净贮茶经具，醉幕闲垂酒颂天。",
        "独念相如久称疾，时时令预雪台篇。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13796,
      "title": "宫保庞丞相以诗见寄次韵和答",
      "content": [
        "本乏微功辅斗枢，避贤仍忝领州旟。",
        "病依一室由旬坐，老愧专城四十居。",
        "憩石雨苔同发短，啸轩霜竹伴心虚。",
        "挂冠尚有三年调，高躅空瞻广武庐。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13797,
      "title": "送张司勋福建转运使",
      "content": [
        "晚花吹酒送行人，迢递风烟上七闽。",
        "江海身孤虽恋阙，豺狼路静不埋轮。",
        "阳林撷露茶腴早，侧树烘霞荔子新。",
        "毛竹干鱼仙祀古，请君寻徧武夷春。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13798,
      "title": "送友人赴举",
      "content": [
        "玉树扶疏入紫烟，鸣驺偕计望甘泉。",
        "十行深诏言成綍，三道摛华藻掞天。",
        "泽国东风占鹊喜，杏园初日待鸾迁。",
        "自嗟拥鼻沈冥极，生看青云著祖鞭。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 13799,
      "title": "送令狐秀才赴举",
      "content": [
        "荐衡上表独垂蜺，密雪梁园逼赋期。",
        "秦市千金怀拱璧，舜韶九奏待长离。",
        "刘桢病久曾淹卧，宋玉才多故剩悲。",
        "几日绣衣荣白昼，郡章惊绂驷车驰。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13800,
      "title": "孙景随侍赴举",
      "content": [
        "蜡凤当筵占美名，文斋大被集时英。",
        "人同颍水将车乐，赋待尚书给笔成。",
        "乡酒出郊浮蚁釂，故林驰雾暝猿惊。",
        "省知唱第藂云幄，归梦因君到斗城。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13801,
      "title": "黄注昆仲赴举",
      "content": [
        "君家日下有高名，骥子双驰嗣世灵。",
        "沧海赋毫多洒白，南山书简偏蒸青。",
        "县歌酒釂催鸣鹿，学舍𦈌寒乱散萤。",
        "昆玉林枝期帝问，差肩唱第迩尧蓂。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13802,
      "title": "送朱进士赴举",
      "content": [
        "汉家廉诏举翘英，银纻观宾望斗城。",
        "北地高门传玉节，西京旧学秘金籯。",
        "邮亭续食星轺急，岭路驰烟月狖惊。",
        "几日东归荣昼锦，度关遥识弃𦈡生。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13803,
      "title": "答转运王工部谢公醪",
      "content": [
        "老依涡曲作藩侯，月例黄堂给宴醅。",
        "敢把百壶夸显父，且将三品敌荆州。",
        "味新聊称长螯蟹，酌浅尤宜小样瓯。",
        "珍重故人贻丽句，纵倾家酿若为酬。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13804,
      "title": "提刑张都官回文诗",
      "content": [
        "欢余惜对清谈剧，远路行嗟又怆违。",
        "寒蚁酒空催客别，晓骊歌罢怨人归。",
        "干风摆柳衰条短，骤霰迷鸿侧阵微。",
        "残岁念君同恨恨，丽章贻我慰依依。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13805,
      "title": "祗答延州安抚吴宣徽",
      "content": [
        "共看仙山玉树秋，从簪朝笏记同游。",
        "调元遂庆登三府，抱帙惟堪读九丘。",
        "重印垂腰荣拥节，征鞍摩体忝为州。",
        "如何却舐投残笔，敢与阳春接唱酬。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13806,
      "title": "李秘校省觐毕却赴乘氏",
      "content": [
        "谢遏香囊奕思余，短亭暾景驾骊驹。",
        "客盘饮嗜丰千蹠，仙舄归飞伴两凫。",
        "官柳摇摇萦早絮，县花的的照晴跗。",
        "东阳玉骨春偏瘦，省对霞朝忆上都。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13807,
      "title": "陈济赴举兼省觐",
      "content": [
        "相从同是日边人，两见江南碧草生。",
        "冯铗车鱼初倦客，梁山风雨苦思亲。",
        "虹桥刻柱前盟苦，兽锦裁囊丽曲新。",
        "袍雪纷纷君莫顾，汉皇终自识平津。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13808,
      "title": "同年梅鼎臣赴凤翔幕兼省觐",
      "content": [
        "酪和盘樱旧宴空，凤岐新辟逐旌弓。",
        "坐陪府幄谈成薮，趋问家庭史有公。",
        "春斝促浮萍叶紫，夜章催刻密枝红。",
        "青袍玉骨英游盛，上路争看侧帽风。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13809,
      "title": "梁子材宰叶州郑县",
      "content": [
        "岁满林光会计期，天缗还赏动慈帷。",
        "贪荣寿母咳兰养，不过忠臣坂道危。",
        "云表晨凫翻舄影，斋中夜鹤应琴丝。",
        "未妨休沐邀清赏，市雾峰莲共蔽亏。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13810,
      "title": "北楼",
      "content": [
        "危楼孤堞共巑岏，怒激号风结暝寒。",
        "校尉登临非广武，王孙回望即长安。",
        "来麰蔽陇蹊牛下，密网横山猎骑攒。",
        "梁霰楚氛催岁晏，有人惆怅悔凭栏。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13811,
      "title": "转运李宥学士",
      "content": [
        "栈外秋高荠树繁，一星飞影伴輶轩。",
        "属城导骑賨歌密，近野迎浆蜀老喧。",
        "濯锦万梭催贡箧，熬盐千井算牢盆。",
        "行台自昔书林宠，不为伤离更黯魂。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13812,
      "title": "送江西转运李定度支",
      "content": [
        "江西使节拥朱轮，正用中台鹤发人。",
        "漕米争衔千鹢舶，即山催铸万蚨缗。",
        "宴斋螺岫披云出，醉馆星苞照露匀。",
        "双笔讵能藏藻思，落霞孤鹜向萧辰。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13813,
      "title": "送王太尉被召归觐",
      "content": [
        "汉廷择日筑韩坛，绿诏连催觐帝关。",
        "十乘元戎方叔贵，九天鸣鼓亚夫还。",
        "袍薰瑞气葱葱外，仗入清尘九九间。",
        "好为君王言敌事，早将功业勒燕山。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13814,
      "title": "春霁",
      "content": [
        "一雨初晴小雾披，海天羊胛报晨晖。",
        "寒消艳雪沈楼唱，暖入重帘御袷衣。",
        "柳外轻黄纷漠漠，梅梢残白怅微微。",
        "烟臯笑电无穷乐，行御鲸牙逐锦翚。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13815,
      "title": "寄鄂渚胡从事",
      "content": [
        "红蕖薰幕得僚英，膝下斑裳捧檄荣。",
        "露茗一枪蠲蜀渴，丝莼千里佐吴羹。",
        "驻车吏识官桥柳，作赋人传陇坻鹦。",
        "夜席两宫求士切，天官宁复带糊名。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13816,
      "title": "成都",
      "content": [
        "风物繁雄古奥区，十年伧父巧论都。",
        "云藏海客星间石，花识文君酒处垆。",
        "两剑作关屏对绕，二江联派练平铺。",
        "此时全盛超西汉，还有渊云抒颂无。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13817,
      "title": "寄题滑台园亭",
      "content": [
        "有处行春住杏鞯，列亭相望鬭翚联。",
        "花衔晓圃三竿日，树遶洪河一曲天。",
        "芳草细迎吟路屐，翠篙徐转饮溪船。",
        "胜游惠政成双纪，乞与州图后世传。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13818,
      "title": "史逸人",
      "content": [
        "菑停滞穗壤余蔬，亩首东南乐隠居。",
        "席地雕觞千日酒，振缗丹水百金鱼。",
        "潺湲弄月苹汀晚，嗢噱调琴菌阁虚。",
        "霄外高情思把袂，西畴何日一巾车。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13819,
      "title": "送保定张员外",
      "content": [
        "倾座仙风冠颍奇，枳鸾移调位犹卑。",
        "兰薰夕膳三林案，草妬春袍一彩丝。",
        "烟戍星残低序雁，陇天云断送歌骊。",
        "报成结课行堪待，慰荐连章达帝帷。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13820,
      "title": "岁稔务闲因美成都繁富",
      "content": [
        "岷峨俗美汉条宽，野实呈秋照露寒。",
        "卖剑得牛人息盗，乞浆逢酒里余欢。",
        "锦波濯彩霞湔浦，硙浪催轮雪沸滩。",
        "告稔不须腾驿奏，自应铜爵报长安。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13821,
      "title": "兰轩初成公退独坐因念若得一怪石立于梅竹间以临兰上隔轩望之当差胜也然未尝以语人沈吟之际适髯生历阶而上抱一石至规制虽不大而巉岩可喜欲得一书籍易之时予几上适有二书乃插架之重者即遣持去寻命小童置石轩南花木之精彩顿增数倍因作长句书以遗髯生聊志一时之偶然也",
      "content": [
        "竹石梅兰号四清，艺兰栽竹种梅成。",
        "一峰久矣思湖玉，三物居然阙友生。",
        "頼得髯参令我喜，飞来灵鹫遣人惊。",
        "小轩从此完无恨，急扫新诗为发明。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13822,
      "title": "白兆山寺值雨呈同坐",
      "content": [
        "飞轩凭望俯丹梯，星雨囊风暝夕曦。",
        "翠阜天遥云待簇，绀园花老树低枝。",
        "巾车预畏烟畴迥，蜡屐先忧磴道危。",
        "未似庾公年最少，桑郊盘马帽簷敧。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13823,
      "title": "祗答洛台资政房春卿侍郎",
      "content": [
        "青绫幞罢歇徐薰，粗吏多年叹不文。",
        "病合避贤抛内署，老堪为帅忝中军。",
        "声名已愧空如餠，富贵原知薄似云。",
        "多谢翔鸾念笼鹄，不然谁信旧同群。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13824,
      "title": "答屯田齐员外见赠",
      "content": [
        "淹卧清漳续畔牢，平时赋笔谢登高。",
        "决科漫欲当三道，作颂何曾敌二豪。",
        "久侍经帏惭肉缓，骤歌楼雪觉心劳。",
        "兼金满橐萱忧释，空仰文星在汉曹。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13825,
      "title": "送冯彭寺丞长兴知县",
      "content": [
        "天外仙凫舄影翻，河干画鹢棹声喧。",
        "奇才欲向菰芦国，丽赋空留霰雪园。",
        "短柳摇摇迎去袂，初花的的伴离罇。",
        "汀苹续赏饶清思，为拂吴兴旧墨痕。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13826,
      "title": "寄赠高知县",
      "content": [
        "绿发如云艾绶青，弦歌百里久沈英。",
        "琴台滞讼投刀释，月观雕章梦草成。",
        "紫芋蹲鸱编富籍，飞觞浮蚁析朝酲。",
        "何当入会甘泉计，玉树扶疏倚太清。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13827,
      "title": "送梅学密赴并州",
      "content": [
        "连天橐笔侍天台，始见东方画隼开。",
        "路避晚风崤外转，人瞻冬日绛中来。",
        "笳箫后队联幽侠，璧马中军聘楚材。",
        "自昔河东股肱地，不应归节叹淹徊。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13828,
      "title": "送河中司马待制",
      "content": [
        "从祀天坛歇翠薰，西门征𫐈怆离群。",
        "暂违册府三重阁，先过楼船一曲汾。",
        "賨炙击鱼开左席，戏壶争马宴中军。",
        "鹳楼西北怀都思，尽日凭高不碍云。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13829,
      "title": "抒怀恭答待制施正臣",
      "content": [
        "谁谓斯人玷玉堂，忧怀易得复难忘。",
        "素书不答还堆案，长簟无情但竟床。",
        "涸思论文成轧轧，流年著鬓有苍苍。",
        "病襟殊忘支离丑，为恃君家白雪章。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13830,
      "title": "喜屯田凌员外至",
      "content": [
        "昔岁裁诗送为郡，今年把袂喜还台。",
        "遒妍赋笔悲秋罢，寂寞衣囊被谤回。",
        "劲节肯凋霜外叶，惊湍须畏岸前堆。",
        "抚尘旧友今皆在，笑口何妨为数开。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13831,
      "title": "寄连元礼屯田员外",
      "content": [
        "忆共西州把酒巵，酒酣风味未全衰。",
        "人惊李郭同舟日，句索羊何共和时。",
        "省帐飘香君觐早，箧书腾谤我归迟。",
        "他年会面须惊怅，瘦尽昆山玉树枝。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13832,
      "title": "张生南归",
      "content": [
        "谒舍修容倦刺毛，纷纷朱紫笑银袍。",
        "吴天破月愁归晚，楚俗伤春忌唱高。",
        "江步挐舟双打桨，酒亭横帜一持螯。",
        "平台邹马英游盛，霏霰连天待赋毫。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13833,
      "title": "冬夕酌酒",
      "content": [
        "艾夜更壶几沸残，尚持杯酒御轻寒。",
        "半分沈令伤多瘦，数刻刘郎惜暂欢。",
        "天外月痕迷倦鹊，庭中霜气伴衰兰。",
        "接䍠不倒糟难藉，坐见丹煤委烛盘。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13834,
      "title": "答常山屯田张中行寄赠",
      "content": [
        "紫荷焦脱燥宫毫，万里边霜扰鬓毛。",
        "不称衰年开幕府，只堪平世掾功曹。",
        "飞蓬转野初无定，疮雁惊弦久未高。",
        "犹有一愁何计奈，掷䃉难报美人刀。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13835,
      "title": "答郭仲微以予记注见庆之作",
      "content": [
        "晓趁霞暾立殿螭，翠凹濡墨庆逢时。",
        "褚生徒记为郎事，方朔犹惭待诏饥。",
        "目极天关趋䆗窱，步依宫柞荫华滋。",
        "故人雅意相怜厚，亲唱阳春护草衰。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13836,
      "title": "送袁进士赴举",
      "content": [
        "秋郊帐饮曙烟销，素籥凉飔满泬寥。",
        "南国大沽三献玉，西京催驾一封轺。",
        "频年衣敝缁尘化，几夕文成密雪飘。",
        "奏御前期深底处，紫清仙阙鬰岧峣。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13837,
      "title": "次韵宫师相公答太傅相公秋书",
      "content": [
        "岩树萧萧秋兴归，师臣仍此褫朝衣。",
        "羽觞聊欲同宾寿，玉体何曾待战肥。",
        "风圃薄寒浮醉衽，雨荥新浪拍渔矶。",
        "清篇自有夔龙旧，方外相从屏世机。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13838,
      "title": "登楼",
      "content": [
        "百尺危楼照彩霓，凭高不见羽人归。",
        "桑田海上悲深浅，城郭人间叹是非。",
        "急桨征帆来未定，远云低树去相依。",
        "古欢今恨成多少，讵减江声与翠微。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 13839,
      "title": "送元诤归中岩",
      "content": [
        "景陵同坐贯花筵，日月飞驰三十年。",
        "两股寻回江上锡，一灯分照剑南天。",
        "岩云护钵龙降呪，林露侵衣鹤警眠。",
        "此地相逢须重别，在家灵运已华颠。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    }
