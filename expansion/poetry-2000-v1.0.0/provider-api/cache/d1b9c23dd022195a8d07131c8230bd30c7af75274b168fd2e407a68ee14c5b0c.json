{
  "data": [
    {
      "id": 284974,
      "title": "岁除夜",
      "content": [
        "官历行将尽，村醪强自倾。",
        "厌寒思暖律，畏老惜残更。",
        "岁月已如此，寇戎犹未平。",
        "儿童不谙事，歌吹待天明。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 284975,
      "title": "雪",
      "content": [
        "尽道丰年瑞，丰年事若何。",
        "长安有贫者，为瑞不宜多。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 284976,
      "title": "旅梦",
      "content": [
        "旅梦思迁次，穷愁有叹嗟。",
        "子鹅京口远，粳米会稽赊。",
        "漏涩才成滴，灯寒不作花。",
        "出门聊一望，蟾桂向人斜。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 284977,
      "title": "秋寄张坤",
      "content": [
        "庭树已黄落，闭门俱寂寥。",
        "未知栖托处，空羡圣明朝。",
        "酒醒乡心阔，云晴客思遥。",
        "吾徒自多感，颜子只箪瓢。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 284978,
      "title": "伤华髪",
      "content": [
        "旧国迢迢远，清秋种种新。",
        "已衰曾轸虑，初见忽霑巾。",
        "日薄梳兼嬾，根危镊恐频。",
        "青铜不自见，只拟老他人。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 284979,
      "title": "九江早秋",
      "content": [
        "雨过晚凉生，楼中枕簟清。",
        "海风吹乱木，岩磬落孤城。",
        "百岁几多日，四蹄无限程。",
        "西邻莫高唱，俱是别离情。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 284980,
      "title": "初秋寄友人",
      "content": [
        "九华曾屏迹，罹乱与心违。",
        "是处堪终老，新秋又未归。",
        "病中芳草歇，愁里白云飞。",
        "樵侣兼同志，音书近亦稀。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 284981,
      "title": "秋居有寄",
      "content": [
        "端居湖岸东，生计有无中。",
        "魇处千般鬼，寒时百种风。",
        "性灵纵道拙，心事奈成空。",
        "多谢金台客，何当一笑同。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 284982,
      "title": "雪霁",
      "content": [
        "南山雪乍晴，寒气转峥嵘。",
        "销却闲门出，随他骏马行。",
        "一竿如有计，五鼎岂须烹。",
        "愁见天街草，青青又欲生。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 284983,
      "title": "堠子",
      "content": [
        "终日路岐旁，前程亦可量。",
        "未能慙面黑，只是恨头方。",
        "雅旨逾千里，高文近两行。",
        "君知不识字，第一莫形相。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 284984,
      "title": "初夏寄顾绍宗",
      "content": [
        "江上偶分袂，四回寒暑更。",
        "青山无路入，白发满头生。",
        "郢浦鴈寻过，镜湖蝉又鸣。",
        "怜君未归日，杯酒若为情。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 284985,
      "title": "寄第五尊师",
      "content": [
        "苕溪烟月久因循，野鹤衣裘独茧纶。",
        "只说泊船无定处，不知携手是何人。",
        "朱黄拣日囚尸鬼，青白临时注脑神。",
        "欲访先生问经诀，世间难得不由身。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 284986,
      "title": "寄西华黄炼师",
      "content": [
        "西华有路入中华，依约山川认永嘉。",
        "羽客昔时留筿簜，故人今又种烟霞。",
        "坛高已降三清鹤，海近应通八月槎。",
        "盛事两般君总得，老莱衣服戴颙家。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 284987,
      "title": "所思",
      "content": [
        "西上青云未有期，东归沧海一何迟。",
        "酒阑梦觉不称意，花落月明空所思。",
        "长恐病侵多事日，可堪贫过少年时。",
        "鬬鸡走狗五陵道，惆怅输他轻薄儿。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 284988,
      "title": "送支使萧中丞赴阙",
      "content": [
        "八年刀笔到京华，归去青冥路未赊。",
        "今日风流卿相客，旧时基业帝王家。",
        "彤庭彩凤虽添瑞，望府红莲已减花。",
        "从此常僚如有问，海边麇鹿斗边槎。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 284989,
      "title": "送人归湘中兼寄旧知",
      "content": [
        "青溪烟雨九华山，乱后应同梦寐间。",
        "万里分飞休掩袂，两旬相见且开颜。",
        "君依宰相貉蝉贵，我恋王门鬓髪斑。",
        "为谢伏波筵上客，几时金印拟西还。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 284990,
      "title": "自贻",
      "content": [
        "衰老应难更进趋，药畦经卷自朝晡。",
        "纵无显效亦藏拙，若有所成甘守株。",
        "汉武巡游虚轧轧，秦皇吞并谩驱驱。",
        "如何只见丁家鹤，依旧辽东叹绿芜。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 284991,
      "title": "暇日感怀因寄同院吴蜕拾遗",
      "content": [
        "璧池清秩访燕台，曾捧瀛州札翰来。",
        "今日二难俱大夜，当时三幅谩高才。",
        "戏悲槐市便便笥，狂忆樟亭满满杯。",
        "犹幸小兰同舍在，每因相见即衔哀。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 284992,
      "title": "偶兴",
      "content": [
        "逐队随行二十春，曲江池畔避车尘。",
        "如今赢得将衰老，闲看人间得意人。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 284993,
      "title": "题凿石山僧院",
      "content": [
        "日夜潮声送是非，一回登眺一忘机。",
        "怜师好事无人见，不把兰芽染褐衣。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 284994,
      "title": "圉城偶作",
      "content": [
        "东望陈留日欲曛，每因刀笔想夫君。",
        "自从郭泰碑铭后，只见黄金不见文。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 284995,
      "title": "乌程",
      "content": [
        "两府攀陪十五年，郡中甘雨幕中莲。",
        "一瓶犹是乌程酒，须对霜风度泫然。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 284996,
      "title": "送杨炼师却归贞浩岩",
      "content": [
        "宦途不复更经营，归去东南任意行。",
        "别后几回思会面，到来相见似前生。",
        "久居竹盖知勤苦，旧业莲峰想变更。",
        "为谢佯狂吴道士，耳中时有铁船声。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 284997,
      "title": "暇日投钱尚父",
      "content": [
        "牛斗星边女宿间，栋梁虚敞丽江关。",
        "望高汉相东西阁，名重淮王大小山。",
        "礼设鬬倾金凿落，马蹄争撼玉连环。",
        "自慙麇鹿无能事，未报深恩鬓已斑。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 284998,
      "title": "览晋史",
      "content": [
        "齐王僚属好男儿，偶觅东归便得归。",
        "满目路岐抛似梦，一船风雨去如飞。",
        "盘擎紫线莼初熟，箸拨红丝鲙正肥。",
        "惆怅途中无限事，与君千载两忘机。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 284999,
      "title": "感别元帅尚父",
      "content": [
        "玉函瑶检下台司，记得当时捧领时。",
        "半壁龙虵蟠造化，满筐山岳动神祇。",
        "疲牛舐犊心犹切，阴鹤鸣雏力已衰。",
        "稚子不才身抱疾，日窥贞迹泪双垂。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285000,
      "title": "尚父偶建小楼特摛丽藻绝句不敢称扬三首 一",
      "content": [
        "结构叨冯柱石才，敢期幢盖此裴回。",
        "阳春曲调高谁和，尽日焚香倚隗台。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 285001,
      "title": "尚父偶建小楼特摛丽藻绝句不敢称扬三首 二",
      "content": [
        "瑇簪珠履愧非才，时凭阑干首重回。",
        "只待淮妖翦除后，别倾巵酒贺行台。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 285002,
      "title": "尚父偶建小楼特摛丽藻绝句不敢称扬三首 三",
      "content": [
        "阑槛初成愧楚才，不知星彩尚迂回。",
        "风流孔令陶钧外，犹记山妖逼小台。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 285003,
      "title": "题玄同先生草堂三首 一",
      "content": [
        "杳杳诸天路，苍苍大涤山。",
        "景舆留不得，毛节去应闲。",
        "相府旧知己，教门新启关。",
        "太平匡济术，流落在人间。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 285004,
      "title": "题玄同先生草堂三首 二",
      "content": [
        "先生诀行日，曾奉数行书。",
        "意密寻难会，情深恨有余。",
        "石桥春暖后，句漏药成初。",
        "珍重云兼鹤，从来不定居。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 285005,
      "title": "题玄同先生草堂三首 三",
      "content": [
        "常时忆讨论，历历事犹存。",
        "酒向余杭尽，云从大涤昏。",
        "往来无道侣，归去有台恩。",
        "自此玄言绝，长应闭洞门。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 285006,
      "title": "城西作",
      "content": [
        "从军无一事，终日掩空斋。",
        "道薄交游少，才疎进取乖。",
        "野禽鸣聒耳，庭草绿侵阶。",
        "幸自同樗栎，何妨惬所怀。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 285007,
      "title": "冬暮城西晚眺",
      "content": [
        "谬忝莲华幕，虚霑柏署官。",
        "欹危长抱疾，衰老不禁寒。",
        "时事已日过，世途行转难。",
        "千崖兼万壑，只向望中看。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 285008,
      "title": "秋霁后",
      "content": [
        "净碧山光冷，圆明露点匀。",
        "渚莲丹脸恨，堤柳翠眉颦。",
        "蝉已送行客，鴈应辞主人。",
        "蝇蚊渐无况，日晚自相亲。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 285009,
      "title": "茅斋",
      "content": [
        "从事不从事，养生非养生。",
        "职为尸禄本，官是受恩名。",
        "时态已相失，岁华从自惊。",
        "西斋一巵酒，衰老与谁倾。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 285010,
      "title": "使者",
      "content": [
        "使者衔中旨，崎岖万里行。",
        "人心犹未革，天意似难明。",
        "四海霍光第，六宫张奉营。",
        "陪臣无以报，西望不胜情。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 285011,
      "title": "途中逢刘知远",
      "content": [
        "吴楚烟波里，巢由季孟间。",
        "只言无事贵，不道致身闲。",
        "别渚莲根断，归心桂树顽。",
        "空劳钟璞意，尘世隔函关。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 285012,
      "title": "遁迹",
      "content": [
        "遁迹知安住，霑襟欲奈何。",
        "朝廷犹礼乐，郡邑忍干戈。",
        "华马凭谁问，胡尘自此多。",
        "因思汉明帝，中夜忆廉颇。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 285013,
      "title": "陇头水",
      "content": [
        "借问陇头水，年年恨何事。",
        "全疑呜咽声，中有征人泪。",
        "自古无长策，况我非深智。",
        "何计谢潺湲，一宵空不寐。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 285014,
      "title": "秦中富人",
      "content": [
        "高高起华堂，区区引流水。",
        "粪土金玉珍，犹嫌未奢侈。",
        "陋巷满蓬蒿，谁知有颜子。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 285015,
      "title": "思归行",
      "content": [
        "不耕南亩田，为爱东堂桂。",
        "身同树上花，一落又经岁。",
        "交亲亦相薄，知己恩潜替。",
        "日开十二门，自是无归计。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 285016,
      "title": "即事中元甲子",
      "content": [
        "三秦流血已成川，塞上黄云战[马]闲。",
        "只有羸兵填渭水，终无奇事出商山。",
        "田园已没红尘内，弟姪相逢白刃间。",
        "惆怅翠华犹未返，泪痕空滴劒文斑。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285017,
      "title": "魏城逢故人",
      "content": [
        "一年两度锦江游，前值东风后值秋。",
        "芳草有情皆碍马，好云无处不遮楼。",
        "山将别恨和心断，水带离声入梦流。",
        "今日因君试回首，澹烟乔木隔绵州。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285018,
      "title": "游江夏口",
      "content": [
        "醉别江东酒一杯，往年曾此驻尘埃。",
        "鱼听建业歌声过，水看瞿塘雪影来。",
        "黄祖不能容贱客，费祎终是负仙才。",
        "平生胆气平生恨，今日江边首嬾回。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285019,
      "title": "春思",
      "content": [
        "荡漾春风渌似波，惹情摇恨去傞傞。",
        "燕翻永日音声好，柳舞空城意绪多。",
        "蜀国暖回溪峡浪，卫娘清转遏云歌。",
        "可怜户外桃兼李，仲蔚蓬蒿奈尔何。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 285020,
      "title": "黄鹤驿寓题",
      "content": [
        "野云芳草绕离鞭，敢对青楼倚少年。",
        "秋色未催榆塞鴈，人心先下洞庭船。",
        "高歌酒市非狂者，大嚼屠门亦偶然。",
        "车马同归莫同恨，古人头白尽林泉。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285021,
      "title": "安陆赠徐砺",
      "content": [
        "灵虵桥下水声声，曾向桥边话别情。",
        "一榻偶依陈太守，三年深忆祢先生。",
        "尘欺鬓色非前事，火𦶟蓬根有去程。",
        "还把余杯重相劝，不堪秋色背郧城。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285022,
      "title": "寄钟常侍",
      "content": [
        "一从朱履步金台，蘗苦冰寒奉上台。",
        "峻节不由人学得，远途终是自将来。",
        "风高渐展摩天翼，干耸方呈构厦材。",
        "应笑樟亭旧同舍，九州无验满炉灰。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285023,
      "title": "中秋夜不见月",
      "content": [
        "阴云薄雾上空虚，此夕清光已破除。",
        "只恐异时开霁后，玉轮依旧养蟾蜍。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 285024,
      "title": "魏博罗令公附卷有回",
      "content": [
        "寒门虽得在诸宗，栖北巢南恨不同。",
        "马上固慙消髀肉，幄中由羡愈头风。",
        "蹉跎岁月心仍切，迢遰江山梦未通。",
        "深荷吾宗有知己，好将刀笔为英雄。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285025,
      "title": "寄处默师",
      "content": [
        "甘露卷帘看雨脚，樟亭倚柱望潮头。",
        "十年顾我醉中过，两地与师方外游。",
        "久隔兵戈常寄梦，近无书信更堪忧。",
        "香炉烟霭虎溪月，终棹铁船寻惠休。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285026,
      "title": "病中上钱尚父",
      "content": [
        "左脚方行右臂挛，每慙名迹污宾筵。",
        "纵饶吴土容衰病，争奈燕台费料钱。",
        "藜杖已干难更把，竹舆虽在不堪悬。",
        "深恩重德无言处，回首浮生泪泫然。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285027,
      "title": "送梅处士归宁国",
      "content": [
        "十五年前即别君，别时天下未纷纭。",
        "乱罹且喜身俱在，存没那堪耳更闻。",
        "良会谩劳悲曩迹，旧交谁去吊荒坟。",
        "殷勤为谢逃名客，想望千秋岭上云。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285028,
      "title": "经故友所居",
      "content": [
        "槐花漠漠向人黄，此地追游迹已荒。",
        "清论不知庄叟达，死交空欢赵岐忙。",
        "病来未忍言闲事，老去唯知觅醉乡。",
        "日暮街东策羸马，一声横笛似山阳。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285029,
      "title": "大梁从事居汜水",
      "content": [
        "前年帝里望行尘，记得仙家第四人。",
        "泉暖旧谙龙偃息，露寒初见鹤精神。",
        "歌声上榻梁园晚，梦遶残钟汜水春。",
        "知有箧中编集在，只应从此是经纶。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285030,
      "title": "杜处士新居",
      "content": [
        "翠敛王孙草，荒诛宋玉茅。",
        "寇余无故物，时薄少深交。",
        "迸笋穿行径，饥雏出坏巢。",
        "小园吾亦有，多病近来抛。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 285031,
      "title": "绝境",
      "content": [
        "绝境非身事，流年但物华。",
        "水梳苔髪直，风引蕙心斜。",
        "凡客从题凤，肤音未胜蛙。",
        "小船兼有桨，始与问渔家。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 285032,
      "title": "雪中怀友人",
      "content": [
        "腊酒复腊雪，故人今越乡。",
        "所思谁把醆，端坐恨无航。",
        "兔苑旧游尽，龟台仙路长。",
        "未知邹孟子，何以奉梁王。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 285033,
      "title": "秋晚",
      "content": [
        "宰邑慙良术，为文愧壮图。",
        "纵饶长委命，争奈渐非夫。",
        "杯酒有时有，乱罹无处无。",
        "金庭在何域，回首一踟蹰。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 285034,
      "title": "升仙桥",
      "content": [
        "危梁枕路岐，驻马问前时。",
        "价自友朋得，名因妇女知。",
        "直须论运命，不得逞文词。",
        "执戟君乡里，荣华竟若为。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 285035,
      "title": "姑苏[真]娘墓",
      "content": [
        "春草荒坟墓，萋萋向虎丘。",
        "死犹嫌寂寞，生肯不风流。",
        "皎镜山泉冷，轻裾海雾秋。",
        "还应伴西子，香迳夜深游。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 285036,
      "title": "灵山寺",
      "content": [
        "晚景聊摅抱，凭栏几荡魂。",
        "槛虚从四面，江阔奈孤根。",
        "幽径薜萝色，小山菭藓痕。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 285037,
      "title": "倚櫂",
      "content": [
        "倚櫂听邻笛，霑衣认酒垆。",
        "自缘悲巨室，谁复为穷途。",
        "树解将军梦，城遗御史乌。",
        "直应齐始了，倾酌向寒芜。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 285038,
      "title": "秋夕对月",
      "content": [
        "夜月色可掬，倚楼聊解颜。",
        "未能分寇盗，徒欲满关山。",
        "背冷金蟾滑，毛寒玉兔顽。",
        "姮娥谩偷药，长寡老中闲。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 285039,
      "title": "寄征士魏员外",
      "content": [
        "家遁苏门节，清贫粉署官。",
        "不矜朝命重，只恨路行难。",
        "窗晓鸡谭倦，庭秋蝶梦阑。",
        "羡君归未得，还有钓鱼竿。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 285040,
      "title": "宿彭蠡馆",
      "content": [
        "孤馆少行旅，解鞍增别愁。",
        "远山矜薄暮，高柳怯清秋。",
        "病里见时态，醉中思旧游。",
        "所怀今已矣，何必恨东流。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 285041,
      "title": "萤",
      "content": [
        "空庭夜未央，点点度西墙。",
        "抱影何微细，乘时忽发扬。",
        "不思因腐草，便拟倚孤光。",
        "若道能通照，车公业肯长。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 285042,
      "title": "早秋宿叶堕所居",
      "content": [
        "池荷叶正圆，长历报时殚。",
        "旷野云蒸热，空庭雨始寒。",
        "蝇蚊犹得志，簟席若为安。",
        "浮世知谁是，劳歌共一懽。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 285043,
      "title": "蜨",
      "content": [
        "汉王刀笔精，写尔逼天生。",
        "舞巧何妨急，飞高所恨轻。",
        "野田黄雀虑，山馆主人情。",
        "此物那堪作，庄周梦不成。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 285044,
      "title": "春居",
      "content": [
        "春风百卉摇，旧国路迢迢。",
        "偶病成疎散，因贫得寂寥。",
        "倚帘高柳弱，乘露小桃夭。",
        "春色常无处，村醪更一瓢。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 285045,
      "title": "轻飙",
      "content": [
        "轻飙掠晚莎，秋物惨关河。",
        "战垒平时少，斋坛上处多。",
        "楚虽屈子重，汉亦忆廉颇。",
        "不及云台议，空山老薜萝。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 285046,
      "title": "燕",
      "content": [
        "不必嫌漂露，何妨养羽毛。",
        "汉妃金屋远，卢女杏梁高。",
        "野迥双飞急，烟晴对语劳。",
        "犹胜黄雀在，栖息是蓬蒿。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 285047,
      "title": "陕西晚思",
      "content": [
        "长途已自穷，此去便西东。",
        "树色荣衰里，人心往返中。",
        "别情流水急，归梦故山空。",
        "莫忘交游分，从来事一同。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 285048,
      "title": "除夜寄张达",
      "content": [
        "梅花已著眼，竹叶况黏唇。",
        "只此留残岁，那堪忆故人。",
        "乱罹书不远，衰病日相亲。",
        "江浦思归意，明朝又一春。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 285049,
      "title": "寄酬邺王罗令公五首 一",
      "content": [
        "营室东回荫斥丘，少年承袭拥青油。",
        "坐调金鼎尊明主，横把雕戈拜列侯。",
        "书札二王争巧拙，篇章七子避风流。",
        "西园旧迹今应在，衰老无因奉胜游。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285050,
      "title": "寄酬邺王罗令公五首 二",
      "content": [
        "脉散源分历几朝，纵然官宦只卑僚。",
        "正忧末派沦沧海，忽见高枝拂绛霄。",
        "十万貔貅趋玉帐，三千宾客珥金貂。",
        "良时难得吾宗少，应念寒门更寂寥。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285051,
      "title": "寄酬邺王罗令公五首 三",
      "content": [
        "敢将衰弱附强宗，细筭还缘血脉同。",
        "湘浦烟波无旧迹，邺都兰菊有遗风。",
        "每怜罹乱书犹达，所恨云泥路不通。",
        "珍重珠玑兼绣段，草玄堂下寄扬雄。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285052,
      "title": "寄酬邺王罗令公五首 四",
      "content": [
        "水云开霁立高亭，依约黎阳对福星。",
        "只见篇章矜镂管，不知勋业柱青冥。",
        "早缘入梦金方砺，晚为传家鼎始铭。",
        "鹤髪四垂烟阁远，此生何处拜仪形。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285053,
      "title": "寄酬邺王罗令公五首 五",
      "content": [
        "锦笈朱囊连复连，紫鸾飞下浙江边。",
        "绡从海室夺烟雾，乐奏帝官胜管弦。",
        "长笑应刘悲显达，每嫌伊霍少诗篇。",
        "戴湾老圃根基薄，虚费工夫八十年。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285054,
      "title": "春日投钱塘元帅尚父二首 一",
      "content": [
        "正忧衰老辱金台，敢望昭王顾问来。",
        "门外旌旗屯[虎豹]，壁闲章句动风雷。",
        "三都节已联翩降，两地花应次第开。",
        "若比紫髯分鼎足，未闻余力有琼环。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285055,
      "title": "春日投钱塘元帅尚父二首 二",
      "content": [
        "征东幕府十三州，敢望非才忝上游。",
        "官秩已叨吴品职，姓名兼显鲁春秋。",
        "盐车顾后声方重，火井窥来焰始浮。",
        "一句黄河千载事，麦城王粲谩登楼。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285056,
      "title": "钱塘府亭",
      "content": [
        "新恩别启馆娃宫，还拜吴王向此中。",
        "九牧土田周制在，两藩茅社汉仪同。",
        "春生旧苑芳洲雨，香入高台小径风。",
        "更有宠光人未见，问安调膳尽三公。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285057,
      "title": "野狐泉",
      "content": [
        "潏潏寒光溅路尘，相传妖物此潜身。",
        "又应改换皮毛后，何处人间作好人。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 285058,
      "title": "宿纪南驿",
      "content": [
        "策蹇南游忆楚朝，阴风淅淅树萧萧。",
        "不知无忌奸邪骨，又作何山野葛苗。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 285059,
      "title": "赠无相禅师",
      "content": [
        "人人尽道事空王，心里忙于市井忙。",
        "惟有马当山上客，死门生路两相忘。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 285060,
      "title": "遣兴",
      "content": [
        "青云路不通，归计奈长蒙。",
        "老恐医方误，穷忧酒醆空。",
        "何堪罹乱后，更入是非中。",
        "长短遭讥笑，回头避钓翁。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 285061,
      "title": "江夏酬高崇节",
      "content": [
        "腊雪都堂试，春风汴水行。",
        "十年虽抱疾，何处不无情？",
        "群盗正当路，此游应隔生。",
        "劳君问流落，山下已躬耕。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 285062,
      "title": "鸎声",
      "content": [
        "井上梧桐暗，花间雾露晞。",
        "一枝晴复暖，百啭是兼非。",
        "金屋梦初觉，玉关人未归。",
        "不堪闲日听，因尔又霑衣。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 285063,
      "title": "倣玉台体",
      "content": [
        "青楼枕路隅，壁甃复椒涂。",
        "晚梦通帘柙，春寒逼酒罏。",
        "解吟怜芍药，难见恨菖蒲。",
        "试问年多少，邻姬亦姓胡。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 285064,
      "title": "夜泊义兴戏呈邑宰",
      "content": [
        "溪畔维舟问戴星，此中三害有图经。",
        "长桥可避南山远，却恐难防是最灵。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 285065,
      "title": "听琵琶",
      "content": [
        "香筵酒散思朝散，偶向梧桐暗处闻。",
        "大底曲中皆有恨，满楼人自不知君。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 285066,
      "title": "经耒阳杜工部墓",
      "content": [
        "紫菊馨香覆楚醪，奠君江畔雨萧骚。",
        "旅魂自是才相累，闲骨何妨冢更高。",
        "𫘧骥丧来空蹇蹶，芝兰衰后长蓬蒿。",
        "屈原宋玉邻君处，几驾青螭缓郁陶。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285067,
      "title": "题袁溪张逸人所居",
      "content": [
        "蒲梢猎猎燕差差，数里溪光日落时。",
        "芳树文君机上锦，远山孙寿镜中眉。",
        "鸡窗夜静开书卷，鱼槛春深展钓丝。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 285068,
      "title": "升平公主旧第",
      "content": [
        "乘凤仙人降此时，玉篇才罢到文词。",
        "两轮水硙光明照，百尺鲛绡换好诗。",
        "带砺山河今尽在，风流罇俎见无期。",
        "坛场客散香街暝，惆怅齐竽取次吹。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285069,
      "title": "寄黔中王从事",
      "content": [
        "故人刀笔事军书，南转黔江半月余。",
        "别后乡关情几许，近来诗酒兴何如。",
        "贪将醉袖矜莺谷，不把瑶缄附鲤鱼。",
        "今日举觞君莫问，生涯牢落鬓萧疎。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285070,
      "title": "关亭春望",
      "content": [
        "关畔春云拂马头，马前春事共悠悠。",
        "风摇岸柳长条困，露裛山花小朵愁。",
        "信越功名高似狗，裴王气力大于牛。",
        "未知至竟将何用，渭水泾川一向流。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285071,
      "title": "寄徐济进士",
      "content": [
        "往年疎嬾共江湖，月满花香记得无。",
        "霜压楚莲秋后折，雨催蛮酒夜深酤。",
        "红尘偶别迷前事，丹桂相倾媿后徒。",
        "出得函关抽得手，从来不及阮元瑜。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285072,
      "title": "寄韦赡",
      "content": [
        "石城蓑笠阻心期，落尽山花有所思。",
        "羸马二年蓬转后，故人何处月明时？",
        "风催晓雁看看别，雨胁秋蝇渐渐痴。",
        "禅智阑干市桥酒，纵然相见只相悲。"
      ],
      "author": {
