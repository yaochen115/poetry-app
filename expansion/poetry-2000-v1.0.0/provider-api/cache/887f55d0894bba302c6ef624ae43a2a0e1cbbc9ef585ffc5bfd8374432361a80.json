{
  "data": [
    {
      "id": 315201,
      "title": "玉楼春",
      "content": [
        "绿波春早青烟暮。",
        "翠幕船如天上去。",
        "深杯浊酒醉贤人，隔岸幽花怜静女。",
        "浮云散乱流萍聚。",
        "恨满韩张离合处。",
        "欲招骑龙帝乡人，来咏叉鱼春岸句。"
      ],
      "author": {
        "id": 257,
        "name": "张孝忠"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315202,
      "title": "鹧鸪天",
      "content": [
        "豆蔻梢头春意浓。",
        "薄罗衫子柳腰风。",
        "人间乍识瑶池似，天上浑疑月殿空。",
        "眉黛小，髻云松。",
        "背人欲整又还慵。",
        "多应没个藏娇处，满镜桃花带雨红。"
      ],
      "author": {
        "id": 257,
        "name": "张孝忠"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315203,
      "title": "菩萨蛮",
      "content": [
        "娇红隐映花稍雾。",
        "金莲容与歌声度。",
        "得句写香笺。",
        "江山此意传。",
        "醉当春好处。",
        "不道因风絮。",
        "去并锦闱眠。",
        "青绫被底仙。"
      ],
      "author": {
        "id": 257,
        "name": "张孝忠"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315204,
      "title": "西江月",
      "content": [
        "堂上簪缨交错，花间帘幕高张。",
        "与君一咏一飞觞。",
        "莫笑诗狂饮畅。",
        "满路光风转蕙，吟边宫柳斜行。",
        "新词妙绝动宫墙。",
        "紫诰黄麻天上。"
      ],
      "author": {
        "id": 257,
        "name": "张孝忠"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315205,
      "title": "霜天晓角",
      "content": [
        "楚山浮碧。",
        "江汉无终极。",
        "鄂渚几行云树，天何意、限南北。",
        "使君觞醉客。",
        "健倒曾何惜。",
        "三国英雄谁在，斜阳外、尽陈迹。"
      ],
      "author": {
        "id": 257,
        "name": "张孝忠"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315206,
      "title": "点绛唇",
      "content": [
        "七里滩边，江光漠漠山如戟。",
        "渔舟一叶。",
        "径入寒烟碧。",
        "笑我尘劳，羞对双台石。",
        "身如织。",
        "年年行役。",
        "鱼鸟浑相识。"
      ],
      "author": {
        "id": 8155,
        "name": "方有开"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315207,
      "title": "满江红",
      "content": [
        "跳出红尘，都不顾、是非荣辱。",
        "垂钓处、月明风细，水清山绿。",
        "七里滩头帆落尽，长山泷口潮回速。",
        "问有谁、特为上钩来，刘文叔。",
        "貂蝉贵，无人续。",
        "金带重，难拘束。",
        "这白麻黄纸，岂曾经目。",
        "昨夜客星侵帝座，且容伸脚加君腹。",
        "问高风、今古有谁同，先生独。"
      ],
      "author": {
        "id": 8155,
        "name": "方有开"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315208,
      "title": "贺新郎",
      "content": [
        "旧俗传荆楚。",
        "正江城、梅炎藻夏，做成重午。",
        "门艾钗符关何事，付与痴儿呆女。",
        "耳不听、湖边鼍鼓。",
        "独炷炉香熏衣润，对潇潇、翠竹都忘暑。",
        "时展卷，诵骚语。",
        "新愁不障西山雨。",
        "问楼头、登临倦客，有谁怀古。",
        "回首独醒人何在，空把清尊酹与。",
        "漾不到、潇湘江渚。",
        "我又相将湖南去，已安排、吊屈嘲渔父。",
        "君有语，但分付。"
      ],
      "author": {
        "id": 9163,
        "name": "许及之"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315209,
      "title": "水调歌头",
      "content": [
        "草草三间屋，爱竹旋添栽。",
        "碧沙窗户，眼前都是翠云堆。",
        "一月山翁高卧，踏雪水村清冷，木落远山开。",
        "唯有平安竹，留得伴寒梅。",
        "唤家童，开门看，有谁来。",
        "客来一笑，清话煮茗更传杯。",
        "有酒只愁无客，有客又愁无酒，酒熟且徘徊。",
        "明日人间事，天自有安排。"
      ],
      "author": {
        "id": 11479,
        "name": "傅大询"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315210,
      "title": "锦堂春・锦堂春慢",
      "content": [
        "梅要疏开，雪教迟下，怕他寒入江天。",
        "有月桥仙客，相伴婵娟。",
        "巷陌升平气象，一时都在鸣弦。",
        "望东家锦里，雁到云边。",
        "书到云边。",
        "尊前翠眉环唱，道新腔字稳，花折声圆。",
        "此去凤池游戏，碧波添插金莲。",
        "看长生叶上，龟寿千年，人寿千年。"
      ],
      "author": {
        "id": 11479,
        "name": "傅大询"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315211,
      "title": "柳梢青",
      "content": [
        "春到江南，今年寒少，早有疏梅。",
        "相伴双松，吟哦风月，着意花开。",
        "天香甚处安排。",
        "便何似、调羹去来。",
        "劲节仙姿，玉堂难老，身在蓬莱。"
      ],
      "author": {
        "id": 11479,
        "name": "傅大询"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315212,
      "title": "念奴娇",
      "content": [
        "江梅破腊，把一枝来报，□春消息。",
        "锦帐银瓶龙麝暖，画烛光摇金碧。",
        "雨径桃花，一溪流水，路入神仙宅。",
        "云裳羽佩，洞天相会今夕。",
        "堂下乐问灵鼍，玉人清唱，舞袖低回雪。",
        "富贵风流须道是，天上人间难得。",
        "玉镜台边，琼浆盏畔，共说春心切。",
        "百年偕老，凤凰楼上风月。"
      ],
      "author": {
        "id": 11479,
        "name": "傅大询"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315213,
      "title": "行香子",
      "content": [
        "玉佩簪缨。",
        "罗袜生尘。",
        "问何时、来到湘滨。",
        "尧蓂五叶，二月阳春。",
        "一霎时风，一霎时雨，一霎时晴。",
        "有子鸣琴。",
        "有路登瀛。",
        "戏斑衣、温酒重斟。",
        "蟠桃难老，相伴长生。",
        "一千年花，一千年果，一千年人。"
      ],
      "author": {
        "id": 11479,
        "name": "傅大询"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315214,
      "title": "贺新郎",
      "content": [
        "雨沐秋荣薄。",
        "莹湖光、琉璃千顷，浪平如削。",
        "步绕湖边佳绝处，时涌琼楼珠阁。",
        "记一一、经行皆昨。",
        "十万人家空翠里，借姮娥、玉鉴相依约。",
        "卷雾箔，飞烟幕。",
        "天机云锦才收却。",
        "放芙蓉、岸花十里，翠红成幄。",
        "向晚买舟撑月去，笑引银汉共酌。",
        "醉欲起、骑鲸碧落。",
        "试唤坡仙哦妙句，问淡妆、此夕如何著。",
        "只云月，是梳掠。"
      ],
      "author": {
        "id": 12382,
        "name": "刘德秀"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315215,
      "title": "水调歌头",
      "content": [
        "澄彻北湖水，圆镜莹青铜。",
        "客槎星汉天上，隐隐暗朝通。",
        "六月浮云落日，十顷增冰积雪，胜绝与谁同。",
        "罗袜步新月，翠袖倚凉风。",
        "子韩子，叫虞帝，傲祝融。",
        "御风凌雾来去，邂逅此从容。",
        "欲问骑驎何处，试举叉鱼故事，惊起碧潭龙。",
        "乞我飞霞佩，从子广寒宫。"
      ],
      "author": {
        "id": 4760,
        "name": "吴镒"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315216,
      "title": "水调歌头",
      "content": [
        "三楚上游地，五岭翠眉横。",
        "杜诗韩笔难尽，身到眼增明。",
        "最好流泉百道，НН绕城萦市，唯见洛阳城。",
        "化鹤三千岁，橘井尚凄清。",
        "阆风客，紫贝阙，白玉京。",
        "不堪天上官府，时此驻霓旌。",
        "岁晚朔云边雪，压尽蛮烟瘴雨，过雁落寒汀。",
        "况有如泉酒，细与故人倾。"
      ],
      "author": {
        "id": 4760,
        "name": "吴镒"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315217,
      "title": "水调歌头",
      "content": [
        "潇洒东湖上，夜雨洗清秋。",
        "朝来尘霁，凝望千里兴悠悠。",
        "山色揉蓝深染，波影青铜新铸，□冷翠光浮。",
        "蓑笠真吾事，聊整钓鱼钩。",
        "坐中客，凌王谢，更风流。",
        "一觞一咏，豪俊谈笑气吞牛。",
        "花月连环长好，到处名园池□，遇景且遨游。",
        "试问陶元亮，底事赋归休。"
      ],
      "author": {
        "id": 1037,
        "name": "林淳"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315218,
      "title": "鹧鸪天",
      "content": [
        "天近袄知雨露浓。",
        "湖山无日不春风。",
        "闲花野草皆掀舞，曾在君王顾盼中。",
        "时易得，会难逢。",
        "朝为逆旅暮三公。",
        "蛟龙得雨飞无便，鸡犬腾云夙有功。"
      ],
      "author": {
        "id": 1037,
        "name": "林淳"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315219,
      "title": "柳梢青",
      "content": [
        "富贵园林。",
        "清虚清馆，随意登临。",
        "物外风光，云明花媚，鸟语烟深。",
        "徐徐缓辔微吟。",
        "迤逦度、松间柳阴。",
        "览遍幽奇，小舟归晚，月映波心。"
      ],
      "author": {
        "id": 1037,
        "name": "林淳"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315220,
      "title": "浣溪沙",
      "content": [
        "却忆西湖烂漫游。",
        "水涵山影翠光浮。",
        "轻舟短棹不惊鸥。",
        "带露精神花妩媚，依风情态柳温柔。",
        "莺歌燕语巧相留。"
      ],
      "author": {
        "id": 1037,
        "name": "林淳"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315221,
      "title": "阮郎归",
      "content": [
        "落花时节近清明。",
        "南园芳草青。",
        "东风料峭雨难晴。",
        "那堪中宿酲。",
        "回首处，自销凝。",
        "谁知人瘦生。",
        "倚阑无语不禁情。",
        "杜鹃啼数声。"
      ],
      "author": {
        "id": 2810,
        "name": "王炎2"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315222,
      "title": "青玉案",
      "content": [
        "深红数点吹花絮。",
        "又燕子、飞来语。",
        "远水平芜春欲暮。",
        "年年长是，清明时候，故遣人憔悴。",
        "竹鸡啼罢山村雨。",
        "正寥落、无情绪。",
        "猛省从前多少事。",
        "绿杨堤上，楼台如画，此景今何处。"
      ],
      "author": {
        "id": 2810,
        "name": "王炎2"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315223,
      "title": "浪淘沙令",
      "content": [
        "流水绕孤村。",
        "杨柳当门。",
        "昔年此地往来频。",
        "认得绿杨携手处，笑语如存。",
        "往事不堪论。",
        "强对清尊。",
        "梅花香里月黄昏。",
        "白首重来谁是伴，独自销魂。"
      ],
      "author": {
        "id": 2810,
        "name": "王炎2"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315224,
      "title": "木兰花慢",
      "content": [
        "缃桃花树下，记罗袜、昔经行。",
        "至今日重来，人惟独自，花亦凋零。",
        "青鸟杳无信息，遍人间、何处觅云𫐌。",
        "红锦织残旧字，玉箫吹断馀声。",
        "销凝。",
        "衣故几时更。",
        "又谁复卿卿。",
        "念镜里琴中，离鸾有恨，别鹄无情。",
        "齐眉处同笑语，但有时、梦见似平生。",
        "愁对婵娟三五，素光暂缺还盈。"
      ],
      "author": {
        "id": 2810,
        "name": "王炎2"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315225,
      "title": "清平乐",
      "content": [
        "呢喃燕语。",
        "共诉春归去。",
        "春去从他留不住。",
        "落尽枝头红雨。",
        "老翁袖手优游。",
        "闲愁不到眉头。",
        "过了麦黄椹紫，归期只在新秋。"
      ],
      "author": {
        "id": 2810,
        "name": "王炎2"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315226,
      "title": "清平乐",
      "content": [
        "儿曹耳语。",
        "借问何处去。",
        "家在翠微深处住。",
        "生计一犁春雨。",
        "客中且恁浮游。",
        "莫将事挂心头。",
        "纵使人生满百，算来更几春秋。"
      ],
      "author": {
        "id": 2810,
        "name": "王炎2"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315227,
      "title": "浪淘沙",
      "content": [
        "月色十分圆。",
        "风露娟娟。",
        "木犀香里凭阑干。",
        "河汉横斜天似水，玉鉴光寒。",
        "草草具杯盘。",
        "相对苍颜。",
        "素娥莫惜少留连。",
        "秋气平分蟾兔满，动是经年。"
      ],
      "author": {
        "id": 2810,
        "name": "王炎2"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315228,
      "title": "卜算子",
      "content": [
        "渡口唤扁舟，雨后青绡皱。",
        "轻暖相重护病躯，料峭还寒透。",
        "老大自伤春，非为花枝瘦。",
        "那得心情似少年，双燕归时候。"
      ],
      "author": {
        "id": 2810,
        "name": "王炎2"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315229,
      "title": "卜算子",
      "content": [
        "散策问芳菲，春半花犹未。",
        "蓓蕾枝头怯苦寒，恰似人憔悴。",
        "人莫恨花迟，天自催寒去。",
        "雨意才收日气浓，玉靥红如醉。"
      ],
      "author": {
        "id": 2810,
        "name": "王炎2"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315230,
      "title": "江城子",
      "content": [
        "清波渺渺日晖晖。",
        "柳依依。",
        "草离离。",
        "老大逢春，情绪有谁知。",
        "帘箔四垂庭院静，人独处，燕双飞。",
        "怯寒未敢试春衣。",
        "踏青时。",
        "懒追随。",
        "野蔌山淆，村酿可从宜。",
        "不向花边拼一醉，花不语，笑人痴。"
      ],
      "author": {
        "id": 2810,
        "name": "王炎2"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315231,
      "title": "虞美人",
      "content": [
        "镜中失画双青鬓。",
        "懒更占花信。",
        "小梅半谢雨垂垂。",
        "未许轻红破蕾、缀桃枝。",
        "社前归燕穿帘语。",
        "似说人憔悴。",
        "自缘老去少欢悰。",
        "不是春寒料峭、怯东风。"
      ],
      "author": {
        "id": 2810,
        "name": "王炎2"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315232,
      "title": "南乡子",
      "content": [
        "云淡日昽明。",
        "久雨潺潺乍得晴。",
        "社近东皋农务急，催耕。",
        "又见菖蒲出水清。",
        "池面縠纹平。",
        "掠水迎风燕羽轻。",
        "试出访寻春色看，相迎。",
        "巧笑花枝似有情。"
      ],
      "author": {
        "id": 2810,
        "name": "王炎2"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315233,
      "title": "忆秦娥",
      "content": [
        "胭脂点。",
        "海棠落尽青春晚。",
        "青春晚。",
        "少年游乐，而今慵懒。",
        "春光不可无人管。",
        "花边酌酒随深浅。",
        "随深浅。",
        "牡丹红透，荼䕷香远。"
      ],
      "author": {
        "id": 2810,
        "name": "王炎2"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315234,
      "title": "临江仙",
      "content": [
        "欲近上元人意好，月如人意团圆。",
        "暖风催趣养花天。",
        "三山来鹤驾，万户识凫仙。",
        "手种河阳桃李树，暂时来看春妍。",
        "彩衣一笑棹觥船。",
        "明年当此日，人到凤池边。"
      ],
      "author": {
        "id": 2810,
        "name": "王炎2"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315235,
      "title": "好事近",
      "content": [
        "时节近元宵，天意人情都好。",
        "烟柳露桃枝上，觉今年春早。",
        "遏云一曲凤将雏，疑是在蓬岛。",
        "玉笋扶杯潋滟，愿黑头难老。"
      ],
      "author": {
        "id": 2810,
        "name": "王炎2"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315236,
      "title": "水调歌头",
      "content": [
        "爱日护轻暖，酝造小春时。",
        "桃溪云敛，一点郎星吐青辉。",
        "炼玉颜容难老，点漆精神如旧，不用摘霜髭。",
        "厌薄蓬莱景，戏踏两凫飞。",
        "潘花底，陶柳外，细民肥。",
        "万家喜色，融瑞气拥牙绯。",
        "凭仗春葱洗玉，领略朱樱度曲，引满又何辞。",
        "只待琴歌毕，安步上丹墀。"
      ],
      "author": {
        "id": 2810,
        "name": "王炎2"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315237,
      "title": "念奴娇",
      "content": [
        "晓来雨过，正海棠枝上，胭脂如滴。",
        "桃杏不敢来比似，信是倾城倾国。",
        "藏韵收香，谁能描貌，阁尽诗人笔。",
        "从教睡去，为留银烛终夕。",
        "不待过了清明，绿阴结子，无处寻春色。",
        "簌簌轻红飞一片，便觉临风凄恻。",
        "莫道无情，嫣然一笑，也似曾相识。",
        "惜花无主，自怜身是行客。"
      ],
      "author": {
        "id": 2810,
        "name": "王炎2"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315238,
      "title": "浪淘沙令",
      "content": [
        "秋色满东篱。",
        "露滴风吹。",
        "凭谁折取泛芳卮。",
        "长是年年重九日，苦恨开迟。",
        "因记得当时。",
        "共拈纤枝。",
        "而今寂寞凤孤飞。",
        "不似旧来心绪好，惟有花知。"
      ],
      "author": {
        "id": 2810,
        "name": "王炎2"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315239,
      "title": "采桑子",
      "content": [
        "一番飞次春风巧，细看工夫。",
        "点缀红酥。",
        "此际多应别处无。",
        "玉人不与花为主，辜负芳菲。",
        "香透帘帏。",
        "谁向钗头插一枝。"
      ],
      "author": {
        "id": 2810,
        "name": "王炎2"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315240,
      "title": "好事近",
      "content": [
        "玉颊映红绡，才报东风消息。",
        "虽则清臞如许，有生香真色。",
        "相看动是隔年期，忍不饮涓滴。",
        "莫待轻飞一片，却说花堪惜。"
      ],
      "author": {
        "id": 2810,
        "name": "王炎2"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315241,
      "title": "临江仙",
      "content": [
        "雪片幻成肌骨，月华借与精神。",
        "一声羌笛怨黄昏。",
        "吹香飘缟袂，脱迹委红裙。",
        "枝上青青结子，子中白白藏仁。",
        "那时别是一家春。",
        "劈泥尝煮酒，拂席卧清阴。"
      ],
      "author": {
        "id": 2810,
        "name": "王炎2"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315242,
      "title": "卜算子",
      "content": [
        "腻玉染深红，艳丽难常好。",
        "已是人间祓禊时，花亦随春老。",
        "唤起曲生来，醉赏惟宜早。",
        "此去阴晴十日间，点点粘芳草。"
      ],
      "author": {
        "id": 2810,
        "name": "王炎2"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315243,
      "title": "木兰花慢",
      "content": [
        "博山香雾冷，新雨过、怯单衣。",
        "正飞絮蒙蒙，平芜杳杳，家在天涯。",
        "春难住、人易老，又等闲过了踏青时。",
        "枝上红稀绿暗，杜鹃刚向人啼。",
        "依依。",
        "谩叹歌生弹铗，尘满弦徽。",
        "想北山猿鹤，南溪鸥鹭，怪我归迟。",
        "青云事、今已晚，倚小窗、谁与话襟期。",
        "对酒有愁可解，擘笺无怨休题。"
      ],
      "author": {
        "id": 2810,
        "name": "王炎2"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315244,
      "title": "小重山",
      "content": [
        "日脚才添一线长。",
        "葭灰吹玉管，转新阳。",
        "老来添得鬓边霜。",
        "年华换，归思满沧浪。",
        "唤客对凝香。",
        "公庭凫骛散，缓行觞。",
        "何须红袖立成行。",
        "清淡好，胜似听丝簧。"
      ],
      "author": {
        "id": 2810,
        "name": "王炎2"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315245,
      "title": "阮郎归",
      "content": [
        "几回幽梦绕家山。",
        "怯闻梅弄残。",
        "潇潇黄落客毡寒。",
        "不禁衣带宽。",
        "身外事，意阑珊。",
        "人间行路难。",
        "寻思百计不如闲。",
        "休贪朱两轓。"
      ],
      "author": {
        "id": 2810,
        "name": "王炎2"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315246,
      "title": "临江仙",
      "content": [
        "试问休官林下去，何人得似高年。",
        "壶中不记岁时迁。",
        "吹箫新有伴，餐玉共求仙。",
        "有客尊前曾得见，月眉云鬓娟娟。",
        "断肠刺史独无眠。",
        "谁能闻一曲，偷向笛中传。"
      ],
      "author": {
        "id": 2810,
        "name": "王炎2"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315247,
      "title": "临江仙",
      "content": [
        "思忆故园花又发，等闲过了流年。",
        "休论升擢与平迁。",
        "拂衣归去好，无事即神仙。",
        "况是老人头雪白，羞看红粉婵娟。",
        "鸾孤凤只且随缘。",
        "莫将桃叶曲，留与世人传。"
      ],
      "author": {
        "id": 2810,
        "name": "王炎2"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315248,
      "title": "水调歌头",
      "content": [
        "新涨鸭头绿，春满白苹洲。",
        "小停画鹢，莫便折柳话离愁。",
        "飘渺觚棱在望，不用东风借便，一瞬到皇州。",
        "别酒十分酌，何惜覆瑶舟。",
        "从此去，上华顶，入清流。",
        "人门如许，自合唾手复公侯。",
        "老我而今衰谢，梦绕故园松菊，底事更迟留。",
        "早晚挂冠去，江上狎浮鸥。"
      ],
      "author": {
        "id": 2810,
        "name": "王炎2"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315249,
      "title": "南柯子・南歌子",
      "content": [
        "天末家何许，津头客未归。",
        "柳梢绿暗早莺啼。",
        "蝴蝶不知春去、绕园飞。",
        "选胜多游冶，当垆有丽姝。",
        "青翰载酒泛晴晖。",
        "不忍十分寥落、负花时。"
      ],
      "author": {
        "id": 2810,
        "name": "王炎2"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315250,
      "title": "好事近",
      "content": [
        "闲日似年长，又在他乡春暮。",
        "柳外一声𫛸鴂，怨落花飞絮。",
        "苎罗只似旧时村，佳人在何处。",
        "试问鸱夷因甚，载轻颦同去。"
      ],
      "author": {
        "id": 2810,
        "name": "王炎2"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315251,
      "title": "朝中措",
      "content": [
        "杜鹃声断日曈昽。",
        "过雨湿残红。",
        "老色菱花影里，客愁蕉叶香中。",
        "柳梢飞絮，桃梢结子，断送春风。",
        "莫恨春无觅处，明年还在芳丛。"
      ],
      "author": {
        "id": 2810,
        "name": "王炎2"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315252,
      "title": "南柯子・南歌子",
      "content": [
        "对镜鸾休舞，求凰凤自飞。",
        "珠钿翠珥密封题。",
        "中有鸾笺细字、没人知。",
        "环佩灯前结，辎𫐌月下归。",
        "笑他织女夜鸣机。",
        "空与牛郎相望、不相随。"
      ],
      "author": {
        "id": 2810,
        "name": "王炎2"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315253,
      "title": "朝中措",
      "content": [
        "蔷薇露染玉肌肤。",
        "欲试缕金衣。",
        "一种出尘态度，偏宜月伴风随。",
        "初疑邂逅，湘妃洛女，似是还非。",
        "只恐乘云轻举，翩然飞度瑶池。"
      ],
      "author": {
        "id": 2810,
        "name": "王炎2"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315254,
      "title": "西江月",
      "content": [
        "蔌蔌落红都尽，依然见此清姝。",
        "水沈为骨玉为肤。",
        "留得春光少住。",
        "鸳帐巧藏翠幔，燕钗斜亸纤枝。",
        "休将往事更寻思。",
        "且为浓香一醉。"
      ],
      "author": {
        "id": 2810,
        "name": "王炎2"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315255,
      "title": "柳梢青",
      "content": [
        "葭管风微。",
        "莱衣香软，歌凤将雏。",
        "笑酌流霞，问人何处，别有瑶池。",
        "相将月佩霞裾。",
        "领凫舄、归朝玉墀。",
        "管取长年，进封大国，稳住清都。"
      ],
      "author": {
        "id": 2810,
        "name": "王炎2"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315256,
      "title": "踏莎行",
      "content": [
        "木落天寒，年华又暮。",
        "老来多病须调护。",
        "诗编酒榼总无缘，闲中赢得瞢腾睡。",
        "尘暗犀梳，香消翠被。",
        "悄无音信来青羽。",
        "新愁正上自眉峰，黄昏庭院潇潇雨。"
      ],
      "author": {
        "id": 2810,
        "name": "王炎2"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315257,
      "title": "清平乐",
      "content": [
        "一杯椒醑。",
        "惜饮难成醉。",
        "爆竹声中人未睡。",
        "共道今宵守岁。",
        "不如且就衾裯。",
        "谁能细数更筹。",
        "三百六旬过了，明朝却是年头。"
      ],
      "author": {
        "id": 2810,
        "name": "王炎2"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315258,
      "title": "南柯子・南歌子",
      "content": [
        "山冥云阴重，天寒雨意浓。",
        "数枝幽艳湿啼红。",
        "莫为惜花惆怅、对东风。",
        "蓑笠朝朝出，沟塍处处通。",
        "人间辛苦是三农。",
        "要得一犁水足、望年丰。"
      ],
      "author": {
        "id": 2810,
        "name": "王炎2"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315259,
      "title": "夜行船",
      "content": [
        "淡饭粗衣随分过。",
        "新成就、庵寮一个。",
        "静处藏身，十分自在，只恁么、有何不可。",
        "过眼空花都看破。",
        "红尘外、独行独坐。",
        "也没筹量，也没系绊，更觅甚、三乘四果。"
      ],
      "author": {
        "id": 2810,
        "name": "王炎2"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315260,
      "title": "临江仙",
      "content": [
        "𫛸鴂一声春事了，不知苦劝谁归。",
        "花梢香露染蔷薇。",
        "小梅酸著齿，酒榼正堪携。",
        "鸭绿一篙新雨过，远山半出修眉。",
        "仙翁理棹欲来时。",
        "绕檐乌鹊喜，报与主人知。"
      ],
      "author": {
        "id": 2810,
        "name": "王炎2"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315261,
      "title": "蓦山溪",
      "content": [
        "莺啼花谢，断送春归去。",
        "雨后听鹃声，恰似诉、留春不住。",
        "韶光易迈，暗被老相催，无个事，没些愁，方是安身处。",
        "载松种菊，相对为宾主。",
        "终日掩柴扉，但只有、清风时度。",
        "不忺把酒，又不喜观书，饥时饭，饱时茶，困即齁齁睡。"
      ],
      "author": {
        "id": 2810,
        "name": "王炎2"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315262,
      "title": "忆秦娥",
      "content": [
        "头如雪。",
        "尘缘滚滚无休歇。",
        "无休歇。",
        "买田筑屋，是何时节。",
        "从今事事都休说。",
        "巢安寮里藏疏拙。",
        "藏疏拙。",
        "许谁为伴，溪山风月。"
      ],
      "author": {
        "id": 2810,
        "name": "王炎2"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315263,
      "title": "满江红",
      "content": [
        "宦海浮沉，名与字、不能彰彻。",
        "青云上、诸公衮衮，难登狭劣。",
        "结绶弹冠成底事，解颐折角皆虚说。",
        "待黄粱、梦觉始归来，非明哲。",
        "易消释，空中雪。",
        "多亏缺，天边月。",
        "算人生必有，衰羸时节。",
        "恁是一阳来复后，梅花柳眼先春发。",
        "料明年、又老似今年，当休歇。"
      ],
      "author": {
        "id": 2810,
        "name": "王炎2"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315264,
      "title": "玉楼春",
      "content": [
        "往年糊口谋升斗。",
        "朱墨尘埃粘两袖。",
        "黄粱梦断始归来，依旧琴书当左右。",
        "而今藏取持螯手。",
        "林下独居闲散又。",
        "问之何以得长年，寡欲少思安老朽。"
      ],
      "author": {
        "id": 2810,
        "name": "王炎2"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315265,
      "title": "玉楼春",
      "content": [
        "大都四绪阴晴半。",
        "天上油云舒又卷。",
        "若还心也似云闲，老色何由来上面。",
        "生平辛苦今潇散。",
        "得丧荣枯皆历遍。",
        "人言不死是神仙，我但耳闻非眼见。"
      ],
      "author": {
        "id": 2810,
        "name": "王炎2"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315266,
      "title": "如梦令",
      "content": [
        "满院落花春寂。",
        "风絮一帘斜日。",
        "翠钿晓寒轻，独倚千秋无力。",
        "无力。",
        "无力。",
        "蹙破远山愁碧。"
      ],
      "author": {
        "id": 8242,
        "name": "杨冠卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315267,
      "title": "生查子",
      "content": [
        "娇莺恰恰啼，过水翻回去。",
        "欲共诉芳心，故绕池边树。",
        "人去绮窗闲，弦断秦筝柱。",
        "百啭听新声，总是伤心处。"
      ],
      "author": {
        "id": 8242,
        "name": "杨冠卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315268,
      "title": "生查子",
      "content": [
        "消瘦不胜寒，独立江南路。",
        "罗袜暗生尘，不见凌波步。",
        "兰佩解鸣珰，往事凭谁诉。",
        "一纸彩云笺，好寄青鸾去。"
      ],
      "author": {
        "id": 8242,
        "name": "杨冠卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315269,
      "title": "生查子",
      "content": [
        "潇湘日暮时，倚棹蒹葭浦。",
        "不见独醒人，愁对湘妃语。",
        "璧月送归云，一叶莲舟举。",
        "宝瑟奏清商，波底鱼龙舞。"
      ],
      "author": {
        "id": 8242,
        "name": "杨冠卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315270,
      "title": "浣溪沙",
      "content": [
        "洞口春深长薜萝。",
        "幽栖地僻少经过。",
        "一溪新绿涨晴波。",
        "惊梦觉来啼鸟近，惜春归去落花多。",
        "东风独倚奈愁何。"
      ],
      "author": {
        "id": 8242,
        "name": "杨冠卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315271,
      "title": "浣溪沙",
      "content": [
        "银叶香销暑簟清。",
        "枕鸳醉倚玉钗横。",
        "起来红日半窗明。",
        "多病情怀无可奈，惜花天气恼馀酲。",
        "瑶琴谁弄晓莺声。"
      ],
      "author": {
        "id": 8242,
        "name": "杨冠卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315272,
      "title": "霜天晓角",
      "content": [
        "渔舟簇簇。",
        "西塞山前宿。",
        "流水落红香远，春江涨、葡萄绿。",
        "蕲竹。",
        "奏新曲。",
        "惊回幽梦独。",
        "却把渔竿远去，骑鲸背、钓璜玉。"
      ],
      "author": {
        "id": 8242,
        "name": "杨冠卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315273,
      "title": "卜算子",
      "content": [
        "苍生喘未苏，贾笔论孤愤。",
        "文采风流今尚存，毫发无遗恨。",
        "凄恻近长沙，地僻秋将尽。",
        "长使英雄泪满襟，天意高难问。"
      ],
      "author": {
        "id": 8242,
        "name": "杨冠卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315274,
      "title": "垂丝钓",
      "content": [
        "翠帘昼卷。",
        "庭花日影初转。",
        "酒力未醒，眉黛还敛。",
        "停歌扇。",
        "背画阑倚遍。",
        "情无限。",
        "怅韶华又晚。",
        "锦鞯去后，愁宽珠袖金钏。",
        "碧云信远。",
        "难托西楼雁。",
        "空写银筝怨。",
        "肠欲断。",
        "更落红万点。"
      ],
      "author": {
        "id": 8242,
        "name": "杨冠卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315275,
      "title": "菩萨蛮",
      "content": [
        "飞云障碧江天暮。",
        "杏花帘幕黄昏雨。",
        "翠袖怯春寒。",
        "有人愁倚阑。",
        "天涯芳草路。",
        "目送征鸿去。",
        "人远玉关长。",
        "尺书难寄将。"
      ],
      "author": {
        "id": 8242,
        "name": "杨冠卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315276,
      "title": "菩萨蛮",
      "content": [
        "春山愁对修眉绿。",
        "春衫谁为裁冰縠。",
        "日暮倚阑干。",
        "不禁烟雾寒。",
        "湖边归去路。",
        "犹记传觞处。",
        "往事等空花。",
        "客心惊岁华。"
      ],
      "author": {
        "id": 8242,
        "name": "杨冠卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315277,
      "title": "菩萨蛮",
      "content": [
        "冰肌玉衬香绡薄。",
        "无言独倚阑干角。",
        "相见又还休。",
        "可堪归去愁。",
        "碧波溪上路。",
        "几阵黄昏雨。",
        "归去断人肠。",
        "纱厨枕簟凉。"
      ],
      "author": {
        "id": 8242,
        "name": "杨冠卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315278,
      "title": "菩萨蛮",
      "content": [
        "玉妃夜宴瑶池冷。",
        "翩然飞下霓旌影。",
        "天阔水云长。",
        "风飘舞袖香。",
        "姑山人似旧。",
        "清压红梅瘦。",
        "同凭玉阑干。",
        "光摇银海寒。"
      ],
      "author": {
        "id": 8242,
        "name": "杨冠卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315279,
      "title": "好事近",
      "content": [
        "晚起倦梳妆，斜压翠鬟云鬓。",
        "手拈花枝辄笑，问青鸾音信。",
        "绣帘慵卷玉钩垂，风篁奏馀韵。",
        "灯火黄昏院落，报雕鞍人近。"
      ],
      "author": {
        "id": 8242,
        "name": "杨冠卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315280,
      "title": "好事近",
      "content": [
        "细雨落檐花，帘卷金泥红湿。",
        "楼外远山横翠，染修眉愁碧。",
        "旧游春梦了无痕，香尘暗瑶瑟。",
        "凭仗青鸾飞去，问新来消息。"
      ],
      "author": {
        "id": 8242,
        "name": "杨冠卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315281,
      "title": "谒金门",
      "content": [
        "伤漂泊。",
        "负了花前期约。",
        "寒食清明都过却。",
        "愁怀无处著。",
        "晴日柳阴池阁。",
        "风絮斜穿帘幕。",
        "帘外秋千闲彩索。",
        "断肠人寂寞。"
      ],
      "author": {
        "id": 8242,
        "name": "杨冠卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315282,
      "title": "忆秦娥",
      "content": [
        "东风恶。",
        "雪花乱舞穿帘幕。",
        "穿帘幕。",
        "寒侵绿绮，音断弦索。",
        "宫梅已破香红萼。",
        "梅妆想称伊梳掠。",
        "伊梳掠。",
        "十分全似，旧时京洛。"
      ],
      "author": {
        "id": 8242,
        "name": "杨冠卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315283,
      "title": "忆秦娥",
      "content": [
        "云垂幕。",
        "江天雪似杨花落。",
        "杨花落。",
        "翠衾不暖，晓寒偏觉。",
        "起来独倚西楼角。",
        "客怀无耐伤离索。",
        "伤离索。",
        "蛮笺欲寄，塞鸿难托。"
      ],
      "author": {
        "id": 8242,
        "name": "杨冠卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315284,
      "title": "清平乐",
      "content": [
        "翠团嘉树。",
        "杜宇呼春去。",
        "帘卷金泥凝望处。",
        "几点红薇香雨。",
        "等闲过了花时。",
        "殷勤来问酴醿。",
        "恰有一枝春在，画楼红日林西。"
      ],
      "author": {
        "id": 8242,
        "name": "杨冠卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315285,
      "title": "柳梢青",
      "content": [
        "红药翻阶。",
        "天香国艳，辉映楼台。",
        "解语浑如，三千粉黛，十二金钗。",
        "青鞋踏破苍苔。",
        "趁舞蝶、游蜂去来。",
        "宿粉偷香，也应难似，年少情怀。"
      ],
      "author": {
        "id": 8242,
        "name": "杨冠卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315286,
      "title": "柳梢青",
      "content": [
        "金蕊飘残。",
        "江城秋晚，月冷霜寒。",
        "一种幽芳，雕冰镂玉，舞凤翔鸾。",
        "悠然静对南山。",
        "笑琼沼、鸳飞翠澜。",
        "小玉惊呼，太真娇困，俯槛慵看。"
      ],
      "author": {
        "id": 8242,
        "name": "杨冠卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315287,
      "title": "柳梢青",
      "content": [
        "归梦迢迢。",
        "分明曾见，舞遍云韶。",
        "解道相思，愁宽金钏，瘦损宫腰。",
        "觉来情绪无聊。",
        "正戍角、声翻丽谯。",
        "楚塞山长，巫阳人远，斗帐香消。"
      ],
      "author": {
        "id": 8242,
        "name": "杨冠卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315288,
      "title": "西江月",
      "content": [
        "妙墨龙蛇飞动，新词雪月交光。",
        "论文齿颊带冰霜。",
        "凤阁从来宫样。",
        "寿菊丛开三径，清姿高压群芳。",
        "折花聊尔问行藏。",
        "会见横飞直上。"
      ],
      "author": {
        "id": 8242,
        "name": "杨冠卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315289,
      "title": "西江月",
      "content": [
        "罗袜浪传仙子，宫梅休写华光。",
        "人言寿客饱经霜。",
        "不趁凡花入样。",
        "万玉森罗素节，一枝剩有馀芳。",
        "孤高肯使蝶蜂藏。",
        "特立甘泉顶上。"
      ],
      "author": {
        "id": 8242,
        "name": "杨冠卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315290,
      "title": "西江月",
      "content": [
        "昨梦钧天帝所，曾陪奏赋明光。",
        "玉除金蕊映秋霜。",
        "尽道宫花别样。",
        "娇额涂黄牢就，金莲衬步齐芳。",
        "舞鸾仪凤巧难藏。",
        "羞杀繁红陌上。"
      ],
      "author": {
        "id": 8242,
        "name": "杨冠卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315291,
      "title": "东坡引",
      "content": [
        "绿波芳草路。",
        "别离记南浦。",
        "香云翦赠青丝缕。",
        "钗分金半股。",
        "钗分金半股。",
        "阳关一曲声凄楚。",
        "惹起离筵愁绪。",
        "梦魂拟逐征鸿去。",
        "行云无定据。",
        "行云无定据。"
      ],
      "author": {
        "id": 8242,
        "name": "杨冠卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315292,
      "title": "鹧鸪天",
      "content": [
        "岁月如驰乌兔飞。",
        "情怀著酒强支持。",
        "经年不见宫妆面，秾碧谁斟翡翠卮。",
        "江路晚，夕阳低。",
        "奚奴空负锦囊归。",
        "欲凭驿使传芳信，未放东风第一枝。"
      ],
      "author": {
        "id": 8242,
        "name": "杨冠卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315293,
      "title": "小重山",
      "content": [
        "一笑回眸百媚生。",
        "娇羞佯不语，艳波横。",
        "缓移莲步绕阶行。",
        "凝情久，幽怨托银筝。",
        "些事那回曾。",
        "水晶双枕冷，簟纹平。",
        "窥人燕子苦无情。",
        "惊梦断，何处觅云行。"
      ],
      "author": {
        "id": 8242,
        "name": "杨冠卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315294,
      "title": "蝶恋花",
      "content": [
        "舞处曾看花满面。",
        "独倚东风，往事思量遍。",
        "绿怨红愁春不管。",
        "天涯芳草人肠断。",
        "一纸云笺鱼雁远。",
        "归凤求凰，谁识琴心怨。",
        "臂枕香消眉黛敛。",
        "也应为我宽金钏。"
      ],
      "author": {
        "id": 8242,
        "name": "杨冠卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315295,
      "title": "蝶恋花",
      "content": [
        "月冷花寒宫漏促。",
        "人在虚檐，玉体温无粟。",
        "弦断鸾胶还再续。",
        "娇云时霎情难足。",
        "解道双鸳愁独宿。",
        "宿翠偎红，蛱蝶元相逐。",
        "蓬海路遥天六六。",
        "终须伴我骑黄鹄。"
      ],
      "author": {
        "id": 8242,
        "name": "杨冠卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315296,
      "title": "水调歌头",
      "content": [
        "春涨一篙绿，江阔暮涛寒。",
        "龙骧万斛飞举，鲸饮酒杯宽。",
        "醉倚舵楼清啸，目送孤鸿杳霭，景意与俱闲。",
        "恍若驭风去，蓬岛旧家山。",
        "记吾庐，环翠竹，拱苍官。",
        "碧云信杳，谁为日日报平安。",
        "桂棹桃溪归后，流水落红香寂，春事想阑珊。",
        "赖有锦囊句，写向此中看。"
      ],
      "author": {
        "id": 8242,
        "name": "杨冠卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315297,
      "title": "水调歌头",
      "content": [
        "形胜访淮楚，骑鹤到扬州。",
        "春风十里帘幕，香霭小红楼。",
        "楼外长江今古，谁是济川舟楫，烟浪拍天浮。",
        "喜见紫芝宇，儒雅更风流。",
        "气吞虹，才倚马，烂银钩。",
        "功名年少馀事，雕鹗几横秋。",
        "行演丝纶天上，环倚玉皇香案，仙袂揖浮丘。",
        "落笔惊风雨，润色焕皇猷。"
      ],
      "author": {
        "id": 8242,
        "name": "杨冠卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315298,
      "title": "水调歌头",
      "content": [
        "年少青云客，怀抱百忧宽。",
        "北窗醉卧春晓，归梦趁吴帆。",
        "来访鸱夷仙迹，极目平湖烟浪，万象一毫端。",
        "云海渺空阔，咫尺是蓬山。",
        "佩飞霞，囊古锦，几凭阑。",
        "赤城应有居士，凤举更龙蟠。",
        "待向玉霄东望，相与神游八极，身未似云闲。",
        "长剑倚天外，功业镜频看。"
      ],
      "author": {
        "id": 8242,
        "name": "杨冠卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315299,
      "title": "水调歌头",
      "content": [
        "曳杖罗浮去，辽鹤正南翔。",
        "青鸾为报消息，岩壑久相望。",
        "无奈渔溪欸乃，唤起苹洲昨梦，风雨趁归航。",
        "万里家何许，天阔水云长。",
        "历五湖，转湘楚，下三江。",
        "兴亡千古馀恨，收拾付诗囊。",
        "重到然犀矶渚，不见骑鲸仙子，客意转凄凉。",
        "举酒酹江月，襟袖泪淋浪。"
      ],
      "author": {
        "id": 8242,
        "name": "杨冠卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315300,
      "title": "水龙吟",
      "content": [
        "渡江天马龙飞，翠华小住兴王地。",
        "石城锺阜，雄依天堑，鼎安神器。",
        "𫛛鹊楼高，建章宫阔，玉绳低坠。",
        "望郁葱佳气，非烟非雾，方呈瑞、璇霄际。",
        "貔虎云屯羽卫。",
        "壮金汤、更隆国势。",
        "天骄胆落，狼烽昼熄，玉门晏闭。",
        "祗谒陵园，长安□远，中兴可冀。",
        "笑六朝旧事，空随流水，千古恨、无人记。"
      ],
      "author": {
        "id": 8242,
        "name": "杨冠卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    }
