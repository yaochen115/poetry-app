{
  "data": [
    {
      "id": 346588,
      "title": "同崔峒补阙慈恩寺避暑",
      "content": [
        "寺凉高树合，卧石绿阴中。",
        "伴鹤惭仙侣，依僧学老翁。",
        "鱼沉荷叶露，鸟散竹林风。",
        "始悟尘居者，应将火宅同。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 346590,
      "title": "长安春望",
      "content": [
        "东风吹雨过青山，却望千门草色闲。",
        "家在梦中何日到，",
        "谁念为儒逢世难，独将衰鬓客秦关。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 346591,
      "title": "冬日登城楼有怀因赠程腾",
      "content": [
        "生涯何事多羁束，赖此登临畅心目。",
        "郭南郭北无数山，",
        "风声肃肃雁飞绝，云色茫茫欲成雪。",
        "遥思海客天外归，",
        "谁知白首窗下人，不接朱门坐中客。",
        "贱亦不足叹，",
        "如今万乘方用武，国命天威借貔虎。",
        "穷达皆为身外名，"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 346600,
      "title": "同薛存诚登栖岩寺",
      "content": [
        "衰蹇步难前，上山如上天。",
        "尘泥来自晚，猿鹤到何先。",
        "万壑应孤磬，百花通一泉。",
        "苍苍此明月，下界正沈眠。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 346602,
      "title": "冬日宴郭监林亭",
      "content": [
        "玉勒聚如云，森森鸾鹤群。",
        "据梧花罽接，沃盥石泉分。",
        "华味惭初识，新声喜尽闻。",
        "此山招老贱，敢不谢夫君。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 346604,
      "title": "同耿𣲗、司空曙二拾遗题韦员外东斋花树",
      "content": [
        "绿砌红花树，狂风独未吹。",
        "光中疑有焰，密处似无枝。",
        "鸟动香轻发，人愁影屡移。",
        "今朝数片落，为报汉郎知。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 346605,
      "title": "观袁修侍郎涨新池",
      "content": [
        "引水香山近，穿云复绕林。",
        "才闻篱外响，已觉石边深。",
        "满处侵苔色，澄来见柳阴。",
        "微风月明夜，知有五湖心。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 346606,
      "title": "和徐法曹赠崔洛阳斑竹杖以诗见答",
      "content": [
        "玉干一寻余，苔花锦不如。",
        "劲堪和醉倚，轻好向空书。",
        "采拂稽山曲，因依释氏居。",
        "方辰将独步，岂与此君疏。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 346607,
      "title": "早秋望华清宫中树因以成咏",
      "content": [
        "可怜云木丛，满禁碧蒙蒙。",
        "色润灵泉近，阴清辇路通。",
        "玉坛标八桂，金井识双桐。",
        "交映凝寒露，相和起夜风。",
        "数枝磐石上，几叶落云中。",
        "燕拂宜秋霁，蝉鸣觉昼空。",
        "翠屏更隐见，珠缀共玲珑。",
        "雷雨生成早，樵苏禁令雄。",
        "野藤高助绿，仙果迥呈红。",
        "惆怅缭垣暮，兹山闻暗蛩。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 346612,
      "title": "陈翃中丞东斋赋白玉簪",
      "content": [
        "美矣新成太华峰，翠莲枝折叶重重。",
        "松阴满涧闲飞鹤，",
        "因声远报浮丘子，不奏登封时不容。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 346615,
      "title": "晚次鄂州",
      "content": [
        "云开远见汉阳城，犹是孤帆一日程。",
        "估客昼眠知浪静，",
        "旧业已随征战尽，更堪江上鼓鼙声。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 346616,
      "title": "夜投丰德寺谒海上人",
      "content": [
        "半夜中峰有磬声，偶逢樵者问山名。",
        "上方月晓闻僧语，",
        "愿得远公知姓字，焚香洗钵过浮生。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 346623,
      "title": "山中咏古木",
      "content": [
        "高木已萧索，夜雨复秋风。",
        "坠叶鸣丛竹，斜根拥断蓬。",
        "半侵山色里，长在水声中。",
        "此地何人到，云门去亦通。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 346624,
      "title": "酬李端公野寺病居见寄",
      "content": [
        "野寺钟昏山正阴，乱藤高竹水声深。",
        "田夫就饷还依草，",
        "寂寞日长谁问疾，料君惟取古方寻。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 346630,
      "title": "送李校书赴东川幕",
      "content": [
        "泥阪望青城，浮云与栈平。",
        "字形知国号，眉势识山名。",
        "编简尘封阁，戈鋋雪照营。",
        "男儿须聘用，莫信笔堪耕。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 346632,
      "title": "春日灞亭同苗员外寄皇甫侍御",
      "content": [
        "坐见春云暮，无因报所思。",
        "川平人去远，日暖雁飞迟。",
        "对酒山长在，看花鬓自衰。",
        "谁堪登灞岸，还作旧乡悲。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 346635,
      "title": "宝泉寺送李益端公归邠宁幕",
      "content": [
        "参差岩障东，云日晃龙宫。",
        "石净非因雨，松凉不为风。",
        "恋泉将鹤并，偷果与猿同。",
        "眼界尘虽染，心源蔽已通。",
        "莲花国何限，贝叶字无穷。",
        "早晚登麟阁，慈门欲付公。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 346636,
      "title": "送何召下第后归蜀",
      "content": [
        "褒斜行客过，栈道响危空。",
        "路湿云初上，山明日正中。",
        "水程通海货，地利杂吴风。",
        "一别金门远，何人复荐雄。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 346637,
      "title": "宿定陵寺",
      "content": [
        "古塔荒台出禁墙，磬声初尽漏声长。",
        "云生紫殿幡花湿，",
        "谁悟威灵同寂灭，更堪砧杵发昭阳。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 346638,
      "title": "送彭开府往云中觐使君兄",
      "content": [
        "一门三代贵，非是主恩偏。",
        "破虏山铭在，承家剑艺全。",
        "夺旗貂帐侧，射虎雪林前。",
        "雁塞逢兄弟，云州发管弦。",
        "冻河光带日，枯草净无烟。",
        "儒者曾修武，因贻上将篇。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 346639,
      "title": "送李缃",
      "content": [
        "旧国仍连五将营，儒衣何处谒公卿。",
        "波翻远水蒹葭动，",
        "为问西来雨中客，空山几处是前程。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 346640,
      "title": "送内弟韦宗仁归信州觐省",
      "content": [
        "常嗟外族弟兄稀，转觉心孤是送归。",
        "醉掩壶觞人有泪，",
        "闻说江楼长卷幔，几回风起望胡威。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 346641,
      "title": "长安疾后首秋夜即事",
      "content": [
        "九重深锁禁城秋，月过南宫渐映楼。",
        "紫陌夜深槐露滴，",
        "楚客病来乡思苦，寂寥灯下不胜愁。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 346642,
      "title": "送崔琦赴宣州幕",
      "content": [
        "五马临流待幕宾，羡君谈笑出风尘。",
        "身闲就养宁辞远，",
        "何处遥知最惆怅，满湖青草雁声春。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 346643,
      "title": "送杨皞东归",
      "content": [
        "登楼掩泣话归期，楚树荆云发远思。",
        "日里扬帆闻戍鼓，",
        "若说湓城杨司马，知君望国有新诗。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 346644,
      "title": "至德中途中书事却寄李僴",
      "content": [
        "乱离无处不伤情，况复看碑对古城。",
        "路绕寒山人独去，",
        "今日主人还共醉，应怜世故一儒生。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 346645,
      "title": "奉和太常王卿酬中书李舍人中书寓直春夜对月见寄",
      "content": [
        "露如轻雨月如霜，不见星河见雁行。",
        "虚晕入池波自泛，",
        "是夜巴歌应金石，岂殊萤影对清光。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 346646,
      "title": "酬包佶郎中览拙卷后见寄",
      "content": [
        "令伯支离晚读书，岂知词赋称相如。",
        "枉逢花木无新思，",
        "沉忧敢望金门召，空愧巴歈并子虚。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 346648,
      "title": "送鲍中丞赴太原",
      "content": [
        "分路引鸣驺，喧喧似陇头。",
        "暂移西掖望，全解北门忧。",
        "专幕临都护，分曹制督邮。",
        "积冰营不下，盛雪猎方休。",
        "白草连胡帐，黄云拥戍楼。",
        "今朝送旌旆，一减鲁儒羞。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 346650,
      "title": "送郭判官赴振武",
      "content": [
        "黄河九曲流，缭绕古边州。",
        "鸣雁飞初夜，羌胡正晚秋。",
        "凄凉金管思，迢递玉人愁。",
        "七叶推多庆，须怀杀敌忧。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 346651,
      "title": "春江夕望",
      "content": [
        "洞庭芳草遍，楚客莫思归。",
        "经难人空老，逢春雁自飞。",
        "东西兄弟远，存没友朋稀。",
        "独立还垂泪，天南一布衣。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 346657,
      "title": "落第后归终南别业",
      "content": [
        "久为名所误，春尽始归山。",
        "落羽羞言命，逢人强破颜。",
        "交疏贫病里，身老是非间。",
        "不及东溪月，渔翁夜往还。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 346659,
      "title": "送李方东归",
      "content": [
        "故交三四人，闻别共沾巾。",
        "举目是陈事，满城无至亲。",
        "身从丧日病，家自俭年贫。",
        "此去何堪远，遗孤在旧邻。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 346666,
      "title": "送恒操上人归江外觐省",
      "content": [
        "依佛不违亲，高堂与寺邻。",
        "问安双树晓，求膳一僧贫。",
        "持咒过龙庙，翻经化海人。",
        "还同惠休去，儒者亦沾巾。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 346668,
      "title": "寒食",
      "content": [
        "孤客飘飘岁载华，况逢寒食倍思家。",
        "莺啼远墅多从柳，",
        "驱车西近长安好，宫观参差半隐霞。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 346669,
      "title": "舟中寒食",
      "content": [
        "寒食空江曲，孤舟渺水前。",
        "斗鸡沙鸟异，禁火岸花然。",
        "日霁开愁望，波喧警醉眠。",
        "因看数茎鬓，倍欲惜芳年。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 346671,
      "title": "元日朝回中夜书情，寄南宫二故人",
      "content": [
        "鸣佩随鹓鹭，登阶见冕旒。",
        "无能裨圣代，何事别沧洲。",
        "闲夜贫还醉，浮名老渐羞。",
        "凤城春欲晚，郎吏忆同游。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 346672,
      "title": "裴给事宅白牡丹",
      "content": [
        "长安豪贵惜春残，争玩街西紫牡丹。",
        "别有玉盘承露冷，无人起就月中看。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 346676,
      "title": "割飞二刀子歌",
      "content": [
        "我家有翦刀，人云鬼国铁。",
        "裁罗裁绮无钝时，",
        "改锻割飞二刀子，色迎霁雪锋含霜。",
        "两条神物秋冰薄，",
        "日试曾磨汉水边，掌中恄栗声冷然。",
        "神惊魄悸却收得，",
        "若非良工变尔形，只向裁缝委箱箧。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 346678,
      "title": "春词",
      "content": [
        "北苑罗裙带，尘衢锦绣鞋。",
        "醉眠芳树下，半被落花埋。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 346679,
      "title": "清如玉壶冰",
      "content": [
        "玉壶冰始结，循吏政初成。",
        "既有虚心鉴，还如照胆清。",
        "瑶池惭洞澈，金镜让澄明。",
        "气若朝霜动，形随夜月盈。",
        "临人能不蔽，待物本无情。",
        "怯对圆光里，妍蚩自此呈。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 376709,
      "title": "晚次鄂州",
      "content": [
        "云开远见洛阳城，犹见孤帆一日程。",
        "估客昼眠知浪静，舟人夜语觉潮生。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 376710,
      "title": "塞下曲",
      "content": [
        "林暗草惊风，将军夜引弓。",
        "平明寻白羽，没在石棱中。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
