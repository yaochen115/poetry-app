{
  "data": [
    {
      "id": 286041,
      "title": "前寄左省张起居一百言寻蒙唱酬见誉过实却用旧韵重荅",
      "content": [
        "减瘦经多难，忧伤集晚年。",
        "吟高风过树，坐久夜凉天。",
        "旅退慙随众，孤飞怯向前。",
        "钓朋蓑叟在，药术衲僧传。",
        "鬓秃趋荣路，肠焦鄙盗泉。",
        "品徒诚有隔，推唱意何坚。",
        "寒地殊知感，秋灯耿不眠。",
        "从来甘默尔，自此倍怡然。",
        "兰为官须握，蒲因学更编。",
        "预愁摇落后，子美笑无毡。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 286042,
      "title": "读故许昌薛尚书诗集",
      "content": [
        "篇篇高且真，真为国风陈。",
        "澹薄虽师古，纵横得意新。",
        "翦裁成几箧，唱和是谁人。",
        "华岳题无敌，黄河句绝伦。",
        "吟残荔枝雨，咏彻海棠春。",
        "李白欺前辈，陶潜仰后尘。",
        "难忘嵩室下，不负蜀江滨。",
        "属思看山眼，冥搜倚树身。",
        "楷模劳梦想，讽诵爽精神。",
        "落笔空追怆，曾蒙借斧斤。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 286043,
      "title": "送水部张郎中彦回宰洛阳",
      "content": [
        "何逊兰休握，陶潜柳正垂。",
        "官清真塞诏，事简好吟诗。",
        "春漏怀丹阙，凉船泛碧伊。",
        "已虚西阁位，朝夕凤书追。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 286044,
      "title": "赠咸阳王主簿",
      "content": [
        "可爱咸阳王主簿，穷经尽到昔贤心。",
        "登科未足酬多学，执卷犹闻惜寸阴。",
        "自与山妻舂斗粟，祗凭邻叟典孤琴。",
        "我来赊酒相留宿，听我披衣看雪吟。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 286045,
      "title": "松",
      "content": [
        "下视垂杨拂路尘，双峰石上覆苔文。",
        "浓霜满迳无红叶，晚日高枝有白云。",
        "春砌花飘僧旋扫，寒溪子落鹤先闻。",
        "那堪寂寞悲风起，千树深藏李白坟。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 286046,
      "title": "梅",
      "content": [
        "江国正寒春信稳，岭头枝上雪飘飘。",
        "何言落处堪惆怅，直是开时也寂寥。",
        "素艳照尊桃莫比，孤香黏袖李须饶。",
        "离人南去肠应断，片片随鞭过楚桥。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 286047,
      "title": "鹤",
      "content": [
        "一自王乔放自由，俗人行处嬾回头。",
        "睡轻旋觉松花堕，舞罢闲听涧水流。",
        "羽翼光明欺积雪，风神洒落占高秋。",
        "应嫌白鹭无仙骨，长伴渔翁宿苇洲。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 286048,
      "title": "重阳夜旅怀",
      "content": [
        "强插黄花三两枝，还图一醉浸愁眉。",
        "半床斜月醉醒后，惆怅多于未醉时。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 286049,
      "title": "壬戌西幸后",
      "content": [
        "武德门前颢气新，雪融鸳瓦土膏春。",
        "夜来梦到宣麻处，草没龙墀不见人。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 286050,
      "title": "多虞",
      "content": [
        "多虞难住人稀处，近耗浑无战罢碁。",
        "向阙归山俱未得，且沽春酒且吟诗。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 286051,
      "title": "短褐",
      "content": [
        "闲披短褐杖山藤，头不是僧心是僧。",
        "坐睡觉来清夜半，芭蕉影动道场灯。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 286052,
      "title": "曲江红杏",
      "content": [
        "遮莫江头柳色遮，日浓莺睡一枝斜。",
        "女郎折得殷勤看，道是春风及第花。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 286053,
      "title": "折得梅",
      "content": [
        "寒步江村折得梅，孤香不肯待春催。",
        "满枝尽是愁人泪，莫𣨼朝来露湿来。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 286054,
      "title": "牡丹",
      "content": [
        "画堂帘卷张清宴，含香带雾情无限。",
        "春风爱惜未放开，柘枝鼓振红英绽。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 286055,
      "title": "寂寞",
      "content": [
        "江郡人稀便是村，踏青天气欲黄昏。",
        "春愁不破还成醉，衣上泪痕和酒痕。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 286056,
      "title": "乱后灞上",
      "content": [
        "柳丝牵水杏房红，烟岸人稀草色中。",
        "日暮一行高鸟处，依稀合是望春宫。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 286057,
      "title": "长门怨二首 一",
      "content": [
        "闲把罗衣泣凤皇，先朝曾教舞霓裳。",
        "春来却羡庭花落，得逐晴风出禁墙。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 286058,
      "title": "长门怨二首 二",
      "content": [
        "流水君恩共不回，杏花争忍扫成堆。",
        "残春未必多烟雨，泪滴闲堦长绿苔。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 286059,
      "title": "郊野戏题",
      "content": [
        "竹巷溪桥天气凉，荷开稻熟村酒香。",
        "唯忧野叟相回避，莫道侬家是汉郎。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 286060,
      "title": "宗人惠四药",
      "content": [
        "宗人忽惠西山药，四味清新香助茶。",
        "爽得心神便骑鹤，何须烧得白朱砂。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 286061,
      "title": "题张衡庙",
      "content": [
        "远俗只凭淫祀切，多年平子固悠悠。",
        "江烟日午无箫鼓，直到如今咏四愁。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 286062,
      "title": "山鸟",
      "content": [
        "惊飞失势粉墙高，好个声音好羽毛。",
        "小婢不须催柘弹，且从枝上吃樱桃。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 286063,
      "title": "黯然",
      "content": [
        "搢绅奔避复沦亡，消息春来到水乡。",
        "屈指故人能几许，月明花好更悲凉。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 286064,
      "title": "借薛尚书集",
      "content": [
        "江天冬暖似花时，上国音尘杳未知。",
        "正被虫声喧老耳，今君又借薛能诗。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 286065,
      "title": "小北廰闲题",
      "content": [
        "冷曹孤宦本相宜，山在墙南落照时。",
        "洗竹浇莎足公事，一来赢写一联诗。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 286066,
      "title": "菊",
      "content": [
        "日日池边载酒行，黄昏犹自遶黄英。",
        "重阳过后频来此，甚觉多情胜薄情。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 286067,
      "title": "赠杨夔二首 一",
      "content": [
        "散赋宂书高且奇，百篇仍有百篇诗。",
        "江湖休洒春风泪，十轴香于一桂枝。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 286068,
      "title": "赠杨夔二首 二",
      "content": [
        "时无韩柳道难穷，也觉天公不至公。",
        "看取年年金牓上，几人才气似扬雄。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 304631,
      "title": "赠齐己（题拟）",
      "content": [
        "敲门谁访□，□客即□师。",
        "应是逢新雪，高吟得好诗。",
        "格清无俗字，思苦有苍髭。",
        "讽味但忘倦，抛琴复舍碁。",
        "（见《四部丛刊》本《白莲集》卷首孙光宪《白莲集序》引。",
        "此首承赵昌平同志录志。",
        "）（〖1〗《白莲集序》：「郑谷郎中与师□□□□□□〖下引诗，略〗其为诗家流之之称许也如此。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 304632,
      "title": "荷花（题拟）",
      "content": [
        "佛爱我亦爱，清香蝶不偷。",
        "一般奇特处，不上妇人头。",
        "（见《全芳备祖前集》卷十一）。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 304633,
      "title": "笔峰",
      "content": [
        "似笔挺然秀，山川亦好文。",
        "宕渠花里发，秦垅竹间分。",
        "石臼生春水，香龛积暮云。",
        "道经难久住，日后忆离群。",
        "（见民国十七年刊曾瀛藻纂《大竹县志》卷十四）。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 304634,
      "title": "春日即事",
      "content": [
        "典衣估酒得，伴客看闲花。",
        "（见《吟窗杂录》卷十四正字王玄《诗中旨格》）。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 304635,
      "title": "秋扇",
      "content": [
        "汗流浃背曾施力，气爽中宵便负心。",
        "（同前）。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 304636,
      "title": "赠王贞白",
      "content": [
        "殿前新进士，阙下校书郎。",
        "（《唐才子传》卷九。",
        "此则承陶先生见告）。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 334671,
      "title": "相和歌辞：长门怨二首",
      "content": [
        "闲把罗衣泣凤凰，先朝曾教舞霓裳。",
        "春来却羡庭花落，得逐晴风出禁墙。",
        "流水君恩共不回，杏花争忍扫成堆。",
        "残春未必多烟雨，泪滴闲阶长绿苔。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 366458,
      "title": "采桑",
      "content": [
        "晓陌携笼去，桑林路隔淮。",
        "何如斗百草，赌取凤凰钗。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 366460,
      "title": "中台五题：乳毛松",
      "content": [
        "松格一何高，何人号乳毛。",
        "霜天寓直夜，愧尔伴闲曹。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 366461,
      "title": "中台五题：樗里子墓",
      "content": [
        "贤人骨已销，墓树几荣凋。",
        "正直魂如在，斋心愿一招。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 366462,
      "title": "中台五题：牡丹",
      "content": [
        "乱前看不足，乱后眼偏明。",
        "却得蓬蒿力，遮藏见太平。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 366463,
      "title": "中台五题：玉蕊",
      "content": [
        "唐昌树已荒，天意眷文昌。",
        "晓入微风起，春时雪满墙。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 366464,
      "title": "中台五题：石柱",
      "content": [
        "暴乱免遗折，森罗贤达名。",
        "末郎何所取，叨继外门荣。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 366465,
      "title": "别同志",
      "content": [
        "所立共寒苦，平生同与游。",
        "相看临远水，独自上孤舟。",
        "天淡沧浪晚，风悲兰杜秋。",
        "前程吟此景，为子上高楼。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 366467,
      "title": "从叔郎中𫍯辍自秋曹分符安陆属，群盗倡致炽流毒江壖，竟以援兵不来，城池失守例削，今任却叙省衔退居荆汉之间，颇得琴尊之趣，因有寄献",
      "content": [
        "华省称前任，何惭削一麾。",
        "沧洲失孤垒，白发出重围。",
        "苦节翻多难，空山自喜归。",
        "悠悠清汉上，渔者日相依。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 366474,
      "title": "送进士赵能卿下第南归",
      "content": [
        "不归何慰亲，归去旧风尘。",
        "洒泪惭关吏，无言对越人。",
        "远帆花月夜，微岸水天春。",
        "莫便随渔钓，平生已苦辛。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 366484,
      "title": "寄边上从事",
      "content": [
        "男儿怀壮节，何不事嫖姚。",
        "高叠观诸寨，全师护大朝。",
        "浅山寒放马，乱火夜防苗。",
        "下第春愁甚，劳君远见招。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 366490,
      "title": "寄献湖州从叔员外",
      "content": [
        "顾渚山边郡，溪将罨画通。",
        "远看城郭里，全在水云中。",
        "西阁归何晚，东吴兴未穷。",
        "茶香紫笋露，洲回白苹风。",
        "歌缓眉低翠，杯明蜡翦红。",
        "政成寻往事，辍棹问渔翁。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 366493,
      "title": "顺动后蓝田偶作",
      "content": [
        "小谏升中谏，三年侍玉除。",
        "且言无所补，浩叹欲何如。",
        "宫阙飞灰烬，嫔嫱落里闾。",
        "蓝峰秋更碧，沾洒望銮舆。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 366495,
      "title": "峡中寓止二首",
      "content": [
        "荆州未解围，小县结茅茨。",
        "强对官人笑，甘为野鹤欺。",
        "江春铺网阔，市晚鬻蔬迟。",
        "子美犹如此，翻然不敢悲。",
        "传闻殊不定，銮辂几时还。",
        "俗易无常性，江清见老颜。",
        "夜船归草市，春步上茶山。",
        "寨将来相问，儿童竞启关。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 366496,
      "title": "颜惠詹事即孤侄舅氏谪官黔巫舟中相遇怆然有寄",
      "content": [
        "犹子在天末，念渠怀渭阳。",
        "巴山偶会遇，江浦共悲凉。",
        "谪宦君何远，穷游我自强。",
        "瘴村三月暮，雨熟野梅黄。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 366497,
      "title": "访题进士孙秦延福南街居",
      "content": [
        "多病久离索，相寻聊解颜。",
        "短墙通御水，疏树出南山。",
        "岁月何难老，园林未得还。",
        "无门共荣达，孤坐却如闲。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 366499,
      "title": "寄南浦谪官",
      "content": [
        "多才翻得罪，天末抱穷忧。",
        "白首为迁客，青山绕万州。",
        "醉欹梅障晓，歌厌竹枝秋。",
        "望阙怀乡泪，荆江水共流。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 366504,
      "title": "闻进士许彬罢举归睦州怅然怀寄",
      "content": [
        "桐庐归旧庐，垂老复樵渔。",
        "吾子虽言命，乡人懒读书。",
        "烟舟撑晚浦，雨屐剪春蔬。",
        "异代名方振，哀吟莫废初。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 366508,
      "title": "赠尚颜上人",
      "content": [
        "相寻喜可知，放锡便论诗。",
        "酷爱山兼水，唯应我与师。",
        "风雷吟不觉，猿鹤老为期。",
        "近辈推栖白，其如趣向卑。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 366509,
      "title": "赠泗口苗居士",
      "content": [
        "岁晏乐园林，维摩契道心。",
        "江云寒不散，庭雪夜方深。",
        "酒劝渔人饮，诗怜稚子吟。",
        "四郊多垒日，勉我舍朝簪。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 366510,
      "title": "梁烛处士辞金陵，相国杜公归旧山，因以寄赠",
      "content": [
        "相庭留不得，江野有苔矶。",
        "两浙寻山遍，孤舟载鹤归。",
        "世间书读尽，云外客来稀。",
        "谏署搜贤急，应难惜布衣。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 366512,
      "title": "哭进士李洞二首",
      "content": [
        "所惜绝吟声，不悲君不荣。",
        "李端终薄宦，贾岛得高名。",
        "旅葬新坟小，遗孤远俗轻。",
        "犹疑随计晚，昨夜草虫鸣。",
        "自闻东蜀病，唯我独关情。",
        "若近长江死，想君胜在生。",
        "瘴蒸丹旐湿，灯隔素帷清。",
        "冢树僧栽后，新蝉一两声。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 366513,
      "title": "南康郡牧陆肱郎中辟许棠先辈为郡从事，因有寄赠",
      "content": [
        "末路思前侣，犹为恋故巢。",
        "江山多胜境，宾主是贫交。",
        "饮舫闲依苇，琴堂雅结茅。",
        "夜清僧伴宿，水月在松梢。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 366516,
      "title": "赵璘郎中席上赋蝴蝶",
      "content": [
        "寻艳复寻香，似闲还似忙。",
        "暖烟沈蕙径，微雨宿花房。",
        "书幌轻随梦，歌楼误采妆。",
        "王孙深属意，绣入舞衣裳。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 366517,
      "title": "贺进士骆用锡登第",
      "content": [
        "苦辛垂二纪，擢第却沾裳。",
        "春榜到春晚，一家荣一乡。",
        "题名登塔喜，醵宴为花忙。",
        "好是东归日，高槐蕊半黄。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 366518,
      "title": "兴州东池",
      "content": [
        "南连乳郡流，阔碧浸晴楼。",
        "彻底千峰影，无风一片秋。",
        "垂杨拂莲叶，返照媚渔舟。",
        "鉴貌还惆怅，难遮两鬓羞。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 366519,
      "title": "渠江旅思",
      "content": [
        "流落复蹉跎，交亲半逝波。",
        "谋身非不切，言命欲如何。",
        "故楚春田废，穷巴瘴雨多。",
        "引人乡泪尽，夜夜竹枝歌。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 366521,
      "title": "曲江",
      "content": [
        "细草岸西东，酒旗摇水风。",
        "楼台在烟杪，鸥鹭下沙中。",
        "翠幄晴相接，芳洲夜暂空。",
        "何人赏秋景，兴与此时同。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 366522,
      "title": "沙苑",
      "content": [
        "茫茫信马行，不似近都城。",
        "苑吏犹迷路，江人莫问程。",
        "聚来千嶂出，落去一川平。",
        "日暮客心速，愁闻雁数声。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 366524,
      "title": "潼关道中",
      "content": [
        "白道晓霜迷，离灯照马嘶。",
        "秋风满关树，残月隔河鸡。",
        "来往非无倦，穷通岂易齐。",
        "何年归故社，披雨剪春畦。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 366528,
      "title": "信美寺岑上人",
      "content": [
        "巡礼诸方遍，湘南颇有缘。",
        "焚香老山寺，乞食向江船。",
        "纱碧笼名画，灯寒照净禅。",
        "我来能永日，莲漏滴阶前。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 366542,
      "title": "郊园",
      "content": [
        "相近复相寻，山僧与水禽。",
        "烟蓑春钓静，雪屋夜棋深。",
        "雅道谁开口，时风未醒心。",
        "溪光何以报，只有醉和吟。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 366543,
      "title": "郊野",
      "content": [
        "蓼水菊篱边，新晴有乱蝉。",
        "秋光终寂寞，晚醉自留连。",
        "野湿禾中露，村闲社后天。",
        "题诗满红叶，何必浣花笺。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 366544,
      "title": "旅寓洛南村舍",
      "content": [
        "村落清明近，秋千稚女夸。",
        "春阴妨柳絮，月黑见梨花。",
        "白鸟窥鱼网，青帘认酒家。",
        "幽栖虽自适，交友在京华。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 366545,
      "title": "杏花",
      "content": [
        "不学梅欺雪，轻红照碧池。",
        "小桃新谢后，双燕却来时。",
        "香属登龙客，烟笼宿蝶枝。",
        "临轩须貌取，风雨易离披。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 366546,
      "title": "水林檎花",
      "content": [
        "一露一朝新，帘栊晓景分。",
        "艳和蜂蝶动，香带管弦闻。",
        "笑拟春无力，妆浓酒渐醺。",
        "直疑风起夜，飞去替行云。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 366547,
      "title": "蓼花",
      "content": [
        "蔟蔟复悠悠，年年拂漫流。",
        "差池伴黄菊，冷淡过清秋。",
        "晚带鸣虫急，寒藏宿鹭愁。",
        "故溪归不得，凭仗系渔舟。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 366549,
      "title": "荔枝",
      "content": [
        "平昔谁相爱，骊山遇贵妃。",
        "枉教生处远，愁见摘来稀。",
        "晚夺红霞色，晴欺瘴日威。",
        "南荒何所恋，为尔即忘归。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 366551,
      "title": "谷自乱离之后在西蜀半纪之余多寓止精舍…四韵以吊之",
      "content": [
        "每思闻净话，雨夜对禅床。",
        "未得重相见，秋灯照影堂。",
        "孤云终负约，薄宦转堪伤。",
        "梦绕长松塔，遥焚一炷香。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 366554,
      "title": "夕阳",
      "content": [
        "夕阳秋更好，敛敛蕙兰中。",
        "极浦明残雨，长天急远鸿。",
        "僧窗留半榻，渔舸透疏篷。",
        "莫恨清光尽，寒蟾即照空。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 366556,
      "title": "西蜀净众寺松溪八韵兼寄小笔崔处士",
      "content": [
        "松因溪得名，溪吹答松声。",
        "缭绕能穿寺，幽奇不在城。",
        "寒烟斋后散，春雨夜中平。",
        "染岸苍苔古，翘沙白鸟明。",
        "澄分僧影瘦，光彻客心清。",
        "带梵侵云响，和钟击石鸣。",
        "淡烹新茗爽，暖泛落花轻。",
        "此景吟难尽，凭君画入京。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 366557,
      "title": "迁客",
      "content": [
        "离夜闻横笛，可堪吹鹧鸪。",
        "雪冤知早晚，雨泣渡江湖。",
        "秋树吹黄叶，腊烟垂绿芜。",
        "虞翻归有日，莫便哭穷途。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 366559,
      "title": "予尝有雪景一绝为人所讽吟段赞善小笔精微…诗谢之",
      "content": [
        "赞善贤相后，家藏名画多。",
        "留心于绘素，得事在烟波。",
        "属兴同吟咏，成功更琢磨。",
        "爱予风雪句，幽绝写渔蓑。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 366561,
      "title": "咸通十四年府试木向荣",
      "content": [
        "园林青气动，众木散寒声。",
        "败叶墙阴在，滋条雪后荣。",
        "欣欣春令早，蔼蔼日华轻。",
        "庾岭梅先觉，隋堤柳暗惊。",
        "山川应物候，皋壤起农情。",
        "只待花开日，连栖出谷莺。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 366564,
      "title": "咏怀",
      "content": [
        "迂疏虽可欺，心路甚男儿。",
        "薄宦浑无味，平生粗有诗。",
        "淡交终不破，孤达晚相宜。",
        "直夜花前唤，朝寒雪里追。",
        "竹声输我听，茶格共僧知。",
        "景物还多感，情怀偶不卑。",
        "溪莺喧午寝，山蕨止春饥。",
        "险事销肠酒，清欢敌手棋。",
        "香锄抛药圃，烟艇忆莎陂。",
        "自许亨途在，儒纲复振时。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 366566,
      "title": "华山",
      "content": [
        "峭仞耸巍巍，晴岚染近畿。",
        "孤高不可状，图写尽应非。",
        "绝顶神仙会，半空鸾鹤归。",
        "云台分远霭，树谷隐斜晖。",
        "坠石连村响，狂雷发庙威。",
        "气中寒渭阔，影外白楼微。",
        "云对莲花落，泉横露掌飞。",
        "乳悬危磴滑，樵彻上方稀。",
        "淡泊生真趣，逍遥息世机。",
        "野花明涧路，春藓涩松围。",
        "远洞时闻磬，群僧昼掩扉。",
        "他年洗尘骨，香火愿相依。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 366567,
      "title": "入阁",
      "content": [
        "秘殿临轩日，和銮返正年。",
        "两班文武盛，百辟羽仪全。",
        "霜漏清中禁，风旗拂曙天。",
        "门严新勘契，仗入乍承宣。",
        "玉几当红旭，金炉纵碧烟。",
        "对扬称法吏，赞引出宫钿。",
        "言动挥毫疾，雍容执簿专。",
        "寿山晴叆叇，颢气暖连延。",
        "礼有鸳鸾集，恩无雨露偏。",
        "小臣叨备位，歌咏泰阶前。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 366568,
      "title": "故少师从翁隐岩别墅乱后榛芜感旧怆怀遂有追纪",
      "content": [
        "风骚为主人，凡俗仰清尘。",
        "密行称闺阃，明诚动搢绅。",
        "周旋居显重，内外掌丝纶。",
        "妙主蓬壶籍，忠为社稷臣。",
        "大仪墙仞峻，东辖纪纲新。",
        "闻善常开口，推公岂为身。",
        "立朝鸣佩重，归宅典衣贫。",
        "半醉看花晚，中餐煮菜春。",
        "晴台随鹿上，幽墅结僧邻。",
        "理论知清越，生徒得李频。",
        "药香沾笔砚，竹色染衣巾。",
        "寄鹤眠云叟，骑驴入室宾。",
        "近将姚监比，僻与段卿亲。",
        "叶积池边路，茶迟雪后薪。",
        "所难留著述，谁不秉陶钧。",
        "丧乱时多变，追思事已陈。",
        "浮华重发作，雅正甚湮沦。",
        "宗从今何在，依栖素有因。",
        "七松无影响，双泪益悲辛。",
        "犹喜于门秀，年来屈复伸。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 366569,
      "title": "送吏部曹郎中免官南归",
      "content": [
        "高名向己求，古韵古无俦。",
        "风月抛兰省，江山复桂州。",
        "贤人知止足，中岁便归休。",
        "云鹤深相待，公卿不易留。",
        "满朝张祖席，半路上仙舟。",
        "箧重藏吴画，茶新换越瓯。",
        "郡迎红烛宴，寺宿翠岚楼。",
        "触目成幽兴，全家是胜游。",
        "篷声渔叟雨，苇色鹭鸶秋。",
        "久别郊园改，将归里巷修。",
        "桑麻胜禄食，节序免乡愁。",
        "阳朔花迎棹，崇贤叶满沟。",
        "席春欢促膝，簷日暖梳头。",
        "道畅应为蝶，时来必问牛。",
        "终须康庶品，未爽漱寒流。",
        "议在归群望，情难恋自由。",
        "小生诚浅拙，早岁便依投。",
        "夏课每垂奖，雪天常见忧。",
        "远招陪宿直，首荐向公侯。",
        "攀送偏挥洒，龙钟志未酬。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 366572,
      "title": "蜀中寓止夏日自贻",
      "content": [
        "辗转欹孤枕，风帏信寂寥。",
        "涨江垂䗖蝀，骤雨闹芭蕉。",
        "道阻归期晚，年加记性销。",
        "故人衰飒尽，相望在行朝。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 366573,
      "title": "试笔偶书",
      "content": [
        "沙鸟与山麋，由来性不羁。",
        "可凭唯在道，难解莫过诗。",
        "任笑孤吟僻，终嫌巧宦卑。",
        "乖慵恩地恕，冷淡好僧知。",
        "华省惭公器，沧江负钓师。",
        "露花春直夜，烟鼓早朝时。",
        "世路多艰梗，家风免坠遗。",
        "殷勤一蓑雨，只得梦中披。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 366576,
      "title": "贫女吟",
      "content": [
        "尘压鸳鸯废锦机，满头空插丽春枝。",
        "东邻舞妓多金翠，笑剪灯花学画眉。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 366579,
      "title": "下峡",
      "content": [
        "忆子啼猿绕树哀，雨随孤棹过阳台。",
        "波头未白人头白，瞥见春风滟滪堆。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 366580,
      "title": "文昌寓直",
      "content": [
        "何逊空阶夜雨平，朝来交直雨新晴。",
        "落花乱上花砖上，不忍和苔蹋紫英。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 366583,
      "title": "鹭鸶",
      "content": [
        "闲立春塘烟淡淡，静眠寒苇雨飕飕。",
        "渔翁归后汀沙晚，飞下滩头更自由。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 366584,
      "title": "柳",
      "content": [
        "半烟半雨江桥畔，映杏映桃山路中。",
        "会得离人无限意，千丝万絮惹春风。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 366585,
      "title": "下第退居二首",
      "content": [
        "年来还未上丹梯，且著渔蓑谢故溪。",
        "落尽梨花春又了，破篱残雨晚莺啼。",
        "未尝青杏出长安，豪士应疑怕牡丹。",
        "只有退耕耕不得，茫然村落水吹残。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 366590,
      "title": "题慈恩寺默公院",
      "content": [
        "虽近曲江居古寺，旧山终忆九华峰。",
        "春来老病厌迎送，剪却牡丹栽野松。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 366591,
      "title": "江上阻风",
      "content": [
        "水天春暗暮寒浓，船闭篷窗细雨中。",
        "闻道渔家酒初熟，晚来翻喜打头风。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 366593,
      "title": "忍公小轩二首",
      "content": [
        "松溪水色绿于松，每到松溪到暮钟。",
        "闲得心源只如此，问禅何必向双峰。",
        "旧游前事半埃尘，多向林中结净因。",
        "一念一炉香火里，后身唯愿似师身。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 366598,
      "title": "定水寺行香",
      "content": [
        "听经看画绕虚廊，风拂金炉待赐香。",
        "丞相未来春雪密，暂偷闲卧老僧床。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 366601,
      "title": "重访黄神谷策禅者",
      "content": [
        "初尘芸阁辞禅阁，却访支郎是老郎。",
        "我趣转卑师趣静，数峰秋雪一炉香。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
