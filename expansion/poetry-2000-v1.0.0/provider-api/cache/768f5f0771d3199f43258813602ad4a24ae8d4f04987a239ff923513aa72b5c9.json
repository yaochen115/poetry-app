{
  "data": [
    {
      "id": 255790,
      "title": "琴曲歌辞  秋思",
      "content": [
        "身病时亦危，逢秋多恸哭。",
        "风波一摇荡，天地几翻覆。",
        "孤萤出荒池，落叶穿破屋。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 282996,
      "title": "塞上",
      "content": [
        "万里隋城在，三边虏气衰。",
        "沙填孤障角，烧断故关碑。",
        "马色经寒惨，雕声带晚悲。",
        "将军正闲暇，留客换歌辞。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 282997,
      "title": "寄永嘉崔道融",
      "content": [
        "旅寓虽难定，乘闲是胜游。",
        "碧云萧寺霁，红树谢邨秋。",
        "戍鼓和潮暗，船灯照岛幽。",
        "诗家多滞此，风景似相留。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 282998,
      "title": "下方",
      "content": [
        "三十年来往，中间京洛尘。",
        "倦行今白首，归卧已清神。",
        "坡暖冬抽笋，松凉夏健人。",
        "更惭征诏起，避世迹非真。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 282999,
      "title": "华下",
      "content": [
        "日炙旱云裂，迸为千道血。",
        "天地沸一镬，竟自烹妖孽。",
        "尧汤遇灾数，灾数还中辍。",
        "何事奸与邪，古来难扑灭。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 283000,
      "title": "僧舍贻友",
      "content": [
        "笑破人间事，吾徒莫自欺。",
        "解吟僧亦俗，爱舞鹤终卑。",
        "竹上题幽梦，溪边约敌棋。",
        "旧山归有阻，不是故迟迟。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 283001,
      "title": "下方",
      "content": [
        "昏旦松轩下，怡然对一瓢。",
        "雨微吟思足，花落梦无聊。",
        "细事当棋遣，衰容喜镜饶。",
        "溪僧有深趣，书至又相邀。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 283002,
      "title": "华下送文浦",
      "content": [
        "郊居谢名利，何事最相亲。",
        "渐与论诗久，皆知得句新。",
        "川明虹照雨，树密鸟冲人。",
        "应念从今去，还来岳下频。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 283003,
      "title": "自诫",
      "content": [
        "我祖铭座右，嘉谋贻厥孙。",
        "勤此苟不怠，令名日可存。",
        "媒衒士所耻，慈俭道所尊。",
        "松柏岂不茂，桃李亦自繁。",
        "众人皆察察，而我独昏昏。",
        "取训于老氏，大辩欲讷言。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 283004,
      "title": "效陈拾遗子昂感遇二首 一",
      "content": [
        "高燕飞何捷，啄害恣群雏。",
        "人岂玩其暴，华轩容尔居。",
        "强欺自天禀，刚吐信吾徒。",
        "乃知不平者，矫世道终孤。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 283005,
      "title": "效陈拾遗子昂感遇二首 二",
      "content": [
        "阳和含煦润，卉木竞纷华。",
        "当为众所悦，私已汝何夸。",
        "北里秘秾艳，东园锁名花。",
        "豪夺乃常理，笑君徒咄嗟。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 283006,
      "title": "效陈拾遗子昂",
      "content": [
        "丑妇竞簪花，花多映愈丑。",
        "邻女恃其姿，掇之不盈手。",
        "量已苟自私，招损乃谁咎。",
        "宠禄既非安，于吾竟何有。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 283007,
      "title": "感时",
      "content": [
        "好鸟无恶声，仁兽肯狂噬。",
        "宁教鹦鹉哑，不遣麒麟细。",
        "人人语与默，唯观利与势。",
        "爱毁亦自遭，掩谤终失计。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 283008,
      "title": "秋思",
      "content": [
        "身病时亦危，逢秋多恸哭。",
        "风波一摇荡，天地几翻覆。",
        "孤萤出荒池，落叶穿破屋。",
        "势利长草草，何人访幽独。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 283009,
      "title": "早春",
      "content": [
        "伤怀同客处，病眼却花朝。",
        "草嫩侵沙短，冰轻著雨消。",
        "风光知可爱，容髪不相饶。",
        "早晚丹丘去，飞书肯见招。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 283010,
      "title": "上陌梯寺怀旧僧二首 一",
      "content": [
        "云根禅客居，皆说旧无庐。",
        "松日明金像，山风向木鱼。",
        "依栖应不阻，名利本来疎。",
        "纵有人相问，林间懒拆书。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 283011,
      "title": "上陌梯寺怀旧僧二首 二",
      "content": [
        "高鸦隔谷见，路转寺西门。",
        "塔影荫泉脉，山苗侵烧痕。",
        "钟疎含杳霭，合迥亘黄昏。",
        "更待他僧到，长如前信存。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 283012,
      "title": "寄怀元秀上人",
      "content": [
        "悠悠干禄利，草草废渔樵。",
        "身世堪惆怅，风骚顿寂寥。",
        "高秋期步野，积雨放趋朝。",
        "得句如相忆，莎斋且见招。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 283013,
      "title": "次韵和秀上人游南五台",
      "content": [
        "中峰曾到处，题记没苍苔。",
        "振锡传深谷，翻经想旧台。",
        "危松临砌偃，惊鹿蓦溪来。",
        "内殿御诗切，身回心未回。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 283014,
      "title": "赠圆昉公",
      "content": [
        "天阶让紫衣，冷格鹤犹卑。",
        "道胜嫌名出，身闲觉老迟。",
        "晓香延宿火，寒磬度高枝。",
        "每说长松寺，他年与我期。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 283015,
      "title": "赠信美寺岑上人",
      "content": [
        "巡礼诸方遍，湘南频有缘。",
        "焚香老山寺，乞食向江船。",
        "纱碧笼名画，灯寒照净禅。",
        "我来能永日，莲漏滴寒泉。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 283016,
      "title": "江行二首 一",
      "content": [
        "地阔分吴塞，枫高映楚天。",
        "曲塘春尽雨，方响夜深船。",
        "行纪添新梦，羇愁甚往年。",
        "何时京洛路，马上见人烟。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 283017,
      "title": "江行二首 二",
      "content": [
        "初程风信好，回望失津楼。",
        "日带潮声晚，烟含楚色秋。",
        "戍旗当远客，岛树转惊鸥。",
        "此去非名利，孤帆任白头。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 283018,
      "title": "长安赠王注",
      "content": [
        "正下搜贤诏，多君独避名。",
        "客来当意惬，花发遇歌成。",
        "乐地留高趣，权门让后生。",
        "东方御闲驷，园外好同行。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 283019,
      "title": "赠步寄李员外",
      "content": [
        "危桥转溪路，经雨石丛荒。",
        "幽瀑下仙果，孤巢悬夕阳。",
        "病辞青琐秘，心在紫芝房。",
        "更喜谐招隐，诗家有望郎。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 283020,
      "title": "寄郑仁规",
      "content": [
        "清才郑小戎，标的贵游中。",
        "万里云无侣，三山鹤不笼。",
        "香和丹地暖，晚着彩衣风。",
        "荣路期经济，唯应在至公。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 283021,
      "title": "寄考功王员外",
      "content": [
        "喜闻三字耗，闲客是陪游。",
        "白鸟闲疎索，青山日滞留。",
        "琴如高韵称，诗愧逸才酬。",
        "更勉匡君志，论思在献谋。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 283022,
      "title": "杂言",
      "content": [
        "鸟飞飞，兔蹶蹶，朝来暮去驱时节。",
        "女娲只解补青天，不解煎胶黏日月。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 283023,
      "title": "陈疾",
      "content": [
        "自怜旅舍亦酣歌，世路无机奈尔何。",
        "霄汉逼来心不动，鬓毛白尽兴犹多。",
        "残阳暂照乡关近，远鸟因投岳庙过。",
        "闲得此身归未得，磬声深夏隔烟萝。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 283024,
      "title": "淅上 一",
      "content": [
        "华下支离已隔河，又来此地避干戈。",
        "山田渐广猨时到，邨舍新添燕亦多。",
        "丹桂石楠宜并长，秦云楚雨暗相和。",
        "儿童栗熟迷归路，归得仍随牧竖歌。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 283025,
      "title": "淅上 二",
      "content": [
        "西北乡关近帝京，烟尘一片正伤情。",
        "愁看地色连空色，静听歌声似哭声。",
        "红蓼满邨人不在，青山遶槛路难平。",
        "从他烟棹更南去，休向津头问去程。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 283026,
      "title": "山中",
      "content": [
        "全家与我恋孤岑，蹋得苍苔一径深。",
        "逃难人多分隙地，放生麋大出寒林。",
        "名应不朽轻仙骨，理到忘机近佛心。",
        "昨夜前溪骤雷雨，晚晴闲步数峰吟。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 283027,
      "title": "寄赠诗僧秀公",
      "content": [
        "灵一心传清塞心，可公吟后础公吟。",
        "近来雅道相亲少，惟仰吾师所得深。",
        "好句未停无暇日，旧山归老有东林。",
        "冷曹孤宦甘寥落，多谢携筇数访寻。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 283028,
      "title": "重阳日访元秀上人",
      "content": [
        "红叶黄花秋景宽，醉吟朝夕在樊川。",
        "却嫌今日登山俗，且共高僧对榻眠。",
        "别画长怀吴寺壁，宜茶偏赏霅溪泉。",
        "归来童穉争相笑，何事无人与酒船。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 283029,
      "title": "丁未岁归王官谷",
      "content": [
        "家山牢落战尘西，匹马偷归路已迷。",
        "冢上卷旗人簇立，花边移寨鸟惊啼。",
        "本来薄俗轻文字，却致中原动鼓鼙。",
        "将取一壶闲日月，长歌深入武陵溪。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 283030,
      "title": "书怀",
      "content": [
        "病来犹强引雏行，力上东原欲试耕。",
        "几处马嘶春麦长，一川人喜雪峰晴。",
        "闲知有味心难肯，道贵谋安迹易平。",
        "陶令若能兼不饮，无弦琴亦是沽名。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 283031,
      "title": "退栖",
      "content": [
        "宦游萧索为无能，移住中条最上层。",
        "得劒乍如添健仆，亡书久似失良朋。",
        "燕昭不是空怜马，支遁何妨亦爱鹰。",
        "自此致身绳检外，肯教世路日兢兢。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 283032,
      "title": "五十",
      "content": [
        "闲身事少只题诗，五十今来觉陡衰。",
        "清秩偶叨非养望，丹方频试更堪疑。",
        "髭须强染三分折，弦管遥听一半悲。",
        "漉酒有巾无黍酿，负他黄菊满东篱。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 283033,
      "title": "新岁对写真",
      "content": [
        "得见明时下寿身，须甘岁酒更移巡。",
        "生情暗结千重恨，寒势常欺一半春。",
        "文武轻销丹灶火，市朝偏贵黑头人。",
        "自伤衰飒慵开镜，拟与儿童别写真。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 283034,
      "title": "华下",
      "content": [
        "箨冠新带步池塘，逸韵偏宜夏景长。",
        "扶起绿荷承早露，惊回白鸟入残阳。",
        "久无书去干时贵，时有僧来自故乡。",
        "不用名山访真诀，退休便是养生方。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 283035,
      "title": "重阳山居",
      "content": [
        "诗人自古恨难穷，暮节登临且喜同。",
        "四望交亲兵乱后，一川风物笛声中。",
        "菊残深处回幽蝶，陂动晴光下早鸿。",
        "明日更期来此醉，不堪寂寞对衰翁。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 283036,
      "title": "争名",
      "content": [
        "争名岂在更搜奇，不朽才消一句诗。",
        "穷辱未甘英气阻，乖疎还有正人知。",
        "荷香浥露侵衣润，松影和风傍枕移。",
        "只此共栖尘外境，无妨亦恋好文时。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 283037,
      "title": "光启四年春戊申",
      "content": [
        "乱后烧残数架书，峰前犹自恋吾庐。",
        "忘机渐喜逢人少，览镜空怜待鹤疎。",
        "孤屿池痕春涨满，小阑花韵午晴初。",
        "酣歌自适逃名久，不必门多长者车。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 283038,
      "title": "丁巳重阳",
      "content": [
        "重阳未到已登临，探得黄花且独斟。",
        "客舍喜逢连日雨，家山似响隔河砧。",
        "乱来已失耕桑计，病后休论济活心。",
        "自贺逢时能自弃，归鞭唯拍马鞯吟。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 283039,
      "title": "喜王驾小仪重阳相访",
      "content": [
        "白菊初开卧内明，闻君相访病身轻。",
        "樽前且拨伤心事，谿上还随觅句行。",
        "幽鹤傍人疑旧识，残蝉向日噪新晴。",
        "拟将寂寞同留住，且劝康时立大名。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 283040,
      "title": "酬张芬赦后见寄",
      "content": [
        "紫凤朝衔五色书，阳春忽布网罗除。",
        "已将心变寒灰后，岂料光生腐草余。",
        "建水风烟收客泪，杜陵花烛梦郊居。",
        "劳君故有诗相赠，欲报琼瑶愧不如。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 283041,
      "title": "上元放二雉",
      "content": [
        "婴网虽皆困，搴笼喜共归。",
        "无心期尔报，相见莫惊飞。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 283042,
      "title": "中秋",
      "content": [
        "闲吟秋景外，万事觉悠悠。",
        "此夜若无月，一年虚过秋。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 283043,
      "title": "偶题",
      "content": [
        "水榭花繁处，春晴日午前。",
        "鸟窥临槛镜，马过隔墙鞭。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 283044,
      "title": "闲步",
      "content": [
        "几处白烟断，一川红树时。",
        "坏桥侵辙水，残照背邨碑。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 283045,
      "title": "春中",
      "content": [
        "伏溜侵堦润，繁花隔竹香。",
        "娇莺方晓听，无事过南塘。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 283046,
      "title": "独望",
      "content": [
        "绿树连邨暗，黄花出陌稀。",
        "远陂春草绿，犹有水禽飞。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 283047,
      "title": "杂题",
      "content": [
        "孤枕闻莺起，幽怀独悄然。",
        "地融春力润，花泛晓光鲜。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 283048,
      "title": "漫题三首 一",
      "content": [
        "乱后他乡节，烧残故国春。",
        "自怜垂白首，犹伴踏青人。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 283049,
      "title": "漫题三首 二",
      "content": [
        "齿落伤情久，心惊健忘频。",
        "蜗庐经岁客，蚕市异乡人。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 283050,
      "title": "漫题三首 三",
      "content": [
        "率怕人言谨，闲宜酒韵高。",
        "山林若无虑，名利不难逃。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 283051,
      "title": "河上二首 一",
      "content": [
        "惨惨日将暮，驱羸独到庄。",
        "沙痕傍墟落，风色入牛羊。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 283052,
      "title": "河上二首 二",
      "content": [
        "新霁田园处，夕阳禾黍明。",
        "沙邨平见水，深巷有鸥声。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 283053,
      "title": "早朝",
      "content": [
        "白日新年好，青春上国多。",
        "街平双阙近，尘起五云和。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 283054,
      "title": "即事二首 一",
      "content": [
        "茶爽添诗句，天清莹道心。",
        "只留鹤一只，此外是空林。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 283055,
      "title": "即事二首 二",
      "content": [
        "御礼征奇策，人心注盛时。",
        "从来留振滞，只待济临危。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 283056,
      "title": "永夜",
      "content": [
        "永夜疑无日，危时只赖山。",
        "旷怀休戚外，孤迹是非间。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 283057,
      "title": "秦关",
      "content": [
        "形胜今虽在，荒凉恨不穷。",
        "虎狼秦国破，狐兔汉陵空。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 283058,
      "title": "渡江",
      "content": [
        "秋江共僧渡，乡泪滴船回。",
        "一夜吴船梦，家书立马开。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 283059,
      "title": "退居漫题七首 一",
      "content": [
        "花缺伤难缀，莺喧奈细听。",
        "惜春春已晚，珍重草青青。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 283060,
      "title": "退居漫题七首 二",
      "content": [
        "堤柳自绵绵，幽人无恨牵。",
        "只忧诗病发，莫寄校书牋。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 283061,
      "title": "退居漫题七首 三",
      "content": [
        "燕语曾来客，花催欲别人。",
        "莫愁春又过，看著又新春。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 283062,
      "title": "退居漫题七首 四",
      "content": [
        "身外都无事，山中久避喧。",
        "破巢看乳燕，留果待啼猨。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 283063,
      "title": "退居漫题七首 五",
      "content": [
        "诗家通籍美，工部与司勋。",
        "高贾虽难敌，微官偶胜君。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 283064,
      "title": "退居漫题七首 六",
      "content": [
        "努力省前非，人生上寿稀。",
        "青云无直道，暗室有危机。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 283065,
      "title": "退居漫题七首 七",
      "content": [
        "燕拙营巢苦，鱼贪触网惊。",
        "岂缘身外事，亦似我劳形。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 283066,
      "title": "即事九首 一",
      "content": [
        "宿雨川原霁，凭高景物新。",
        "陂痕侵牧马，云影带耕人。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 283067,
      "title": "即事九首 二",
      "content": [
        "十年深隐地，一雨太平心。",
        "匣涩休看劒，窗明复上琴。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 283068,
      "title": "即事九首 三",
      "content": [
        "明时那弃置，多病自迟留。",
        "疎磬和吟断，残灯照卧幽。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 283069,
      "title": "即事九首 四",
      "content": [
        "衰鬓闲生少，丹梯望觉危。",
        "松须依石长，鹤不傍人卑。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 283070,
      "title": "即事九首 五",
      "content": [
        "落叶频惊鹿，连峰欲映雕。",
        "此生诗病苦，此病更萧条。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 283071,
      "title": "即事九首 六",
      "content": [
        "旅思又惊夏，庭前长小松。",
        "远峰生贵气，残月歛衰容。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 283072,
      "title": "即事九首 七",
      "content": [
        "林鸟频窥静，家人亦笑慵。",
        "旧居留稳枕，归卧听秋钟。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 283073,
      "title": "即事九首 八",
      "content": [
        "华宇知难保，烧来又却修。",
        "只应巢燕惜，未必主人留。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 283074,
      "title": "即事九首 九",
      "content": [
        "幽鸟穿篱去，邻翁采药回。",
        "云从潭底出，花向佛前开。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 283075,
      "title": "松滋渡二首 一",
      "content": [
        "步上短亭久，看回官渡船。",
        "江乡宜晚霁，楚老语丰年。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 283076,
      "title": "松滋渡二首 二",
      "content": [
        "楚岫接乡思，茫茫归路迷。",
        "更堪斑竹驿，初听鹧鸪啼。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 283077,
      "title": "华清宫",
      "content": [
        "帝业山河固，离宫宴幸频。",
        "岂知驱战马，只是太平人。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 283078,
      "title": "牛头寺",
      "content": [
        "终南最佳处，禅诵出青霄。",
        "群木澄幽寂，疎烟泛泬寥。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 283079,
      "title": "感时上卢相",
      "content": [
        "兵待皇威振，人随国步安。",
        "万方休望幸，封岳始鸣銮。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 283080,
      "title": "乱后三首 一",
      "content": [
        "丧乱家难保，艰虞病懒医。",
        "空将忧国泪，犹拟洒丹墀。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 283081,
      "title": "乱后三首 二",
      "content": [
        "流芳能几日，惆怅又闻蝉。",
        "行在多新贵，幽栖独长年。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 283082,
      "title": "乱后三首 三",
      "content": [
        "世事尝艰险，僧居惯寂寥。",
        "美香闻夜合，清景见寅朝。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 283083,
      "title": "秋景",
      "content": [
        "景物皆难驻，伤春复怨秋。",
        "旋书红叶落，拟画碧云收。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 283084,
      "title": "避乱",
      "content": [
        "离乱身偶在，窜迹任浮沈。",
        "虎暴荒居逈，萤孤黑夜深。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 283085,
      "title": "长亭",
      "content": [
        "梅雨和乡泪，终年共酒衣。",
        "殷勤华表鹤，羡尔亦曾归。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 283086,
      "title": "邨西杏花二首 一",
      "content": [
        "薄腻力偏羸，看看怆别时。",
        "东风狂不惜，西子病难医。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 283087,
      "title": "邨西杏花二首 二",
      "content": [
        "肌细分红脉，香浓破紫苞。",
        "无因留得翫，争忍折来抛。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 283088,
      "title": "独坐",
      "content": [
        "幽径入桑麻，坞西逢一家。",
        "编篱薪带茧，补屋草和花。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 283089,
      "title": "借居",
      "content": [
        "借住郊园久，仍逢夏景新。",
        "绿苔行屐稳，黄鸟傍窗频。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 283090,
      "title": "重阳",
      "content": [
        "菊开犹阻雨，蝶意切于人。",
        "亦应知暮节，不比惜残春。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 283091,
      "title": "偶书五首 一",
      "content": [
        "衰榭当何忏，惟应悔壮图。",
        "磬声花外远，人影塔前孤。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 283092,
      "title": "偶书五首 二",
      "content": [
        "色变莺雏长，竿齐笋箨垂。",
        "白头身偶在，清夏景还移。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 283093,
      "title": "偶书五首 三",
      "content": [
        "蜀妓轻成妙，吴娃狎共纤。",
        "晚妆留拜月，卷上水精帘。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 283094,
      "title": "偶书五首 四",
      "content": [
        "独步荒郊暮，沉思远墅幽。",
        "平生多少事，弹指一时休。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    }
  ],
