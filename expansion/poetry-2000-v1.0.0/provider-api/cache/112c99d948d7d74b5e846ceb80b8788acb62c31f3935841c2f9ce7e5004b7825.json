{
  "data": [
    {
      "id": 370173,
      "title": "步虚引",
      "content": [
        "小隐山人十洲客，莓苔为衣双耳白。",
        "青编为我忽降书，",
        "朝天半夜闻玉鸡，星斗离离碍龙翼。"
      ],
      "author": {
        "id": 8770,
        "name": "陈陶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 370174,
      "title": "独摇手",
      "content": [
        "汉宫新燕矜蛾眉，春台艳妆莲一枝。",
        "迎春侍宴瑶华池，",
        "愁鸿连翾蚕曳丝，飒遝明珠掌中移。",
        "仙人龙凤云雨吹，",
        "仙蛾泣月清露垂，六宫烧烛愁风欷。"
      ],
      "author": {
        "id": 8770,
        "name": "陈陶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 370175,
      "title": "空城雀",
      "content": [
        "古城蒙蒙花覆水，昔日住人今住鬼。",
        "野雀荒台遗子孙，",
        "近村红栗香压枝，嗷嗷黄口诉朝饥。",
        "生来未见凤凰语，"
      ],
      "author": {
        "id": 8770,
        "name": "陈陶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 370176,
      "title": "鸡鸣曲",
      "content": [
        "鸡声春晓上林中，一声惊落虾蟆宫。",
        "二声唤破枕边梦，",
        "愧君饮食长相呼，为君昼鸣下高树。"
      ],
      "author": {
        "id": 8770,
        "name": "陈陶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 370177,
      "title": "小笛弄",
      "content": [
        "一尺玲珑握中翠，仙娥月浦呼龙子。",
        "五夜流珠粲梦卿，",
        "蛇蝎愁闻骨髓寒，江山恨老眠秋雾。",
        "绮席鸳鸯冷朱翠，"
      ],
      "author": {
        "id": 8770,
        "name": "陈陶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 370178,
      "title": "将进酒",
      "content": [
        "金尊莫倚青春健，龌龊浮生如走电。",
        "琴瑟盘倾从世珠，",
        "灵鼇柱骨半枯朽，骊龙德悔愁耕人。",
        "周孔蓍龟久沦没，",
        "姮娥弄箫香雨收，江滨迸瑟鱼龙愁。",
        "灵芝九折楚莲醉，",
        "银鸭金鹅言待谁，隋家岳渎皇家有。",
        "珊瑚座上凌香云，",
        "文康调笑麒麟起，一曲飞龙寿天地。"
      ],
      "author": {
        "id": 8770,
        "name": "陈陶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 370179,
      "title": "钱塘对酒曲",
      "content": [
        "风天雁悲西陵愁，使君红旗弄涛头。",
        "东海神鱼骑未得，",
        "南州彩凤为君生，古狱愁蛇待恩泽。",
        "三清羽童来何迟，",
        "鸱夷公子休悲悄，六鼇如镜天始老。",
        "尊前事去月团圆，"
      ],
      "author": {
        "id": 8770,
        "name": "陈陶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 370180,
      "title": "巫山高",
      "content": [
        "玉峰青云十二枝，金母和云赐瑶姬。",
        "花宫磊砢楚宫外，",
        "青鸾不在懒吹箫，斑竹题诗寄江妾。",
        "飘飖丝散巴子天，"
      ],
      "author": {
        "id": 8770,
        "name": "陈陶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 370181,
      "title": "赠别离",
      "content": [
        "碧玉飞天星坠地，玉剑分风交合水。",
        "杨柳听歌莫向隅，",
        "蛮天列嶂俨相待，风官扫道迎游龙。",
        "天姥剪霞铺晓空，",
        "山妖水魅骑旋风，魇梦啮魂黄瘴中。",
        "借君朗鉴入崆峒，"
      ],
      "author": {
        "id": 8770,
        "name": "陈陶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 370182,
      "title": "关山月",
      "content": [
        "昔年嫖姚护羌月，今照嫖姚双鬓雪。",
        "青冢曾无尺寸归，",
        "汉城应期破镜时，胡尘万里婵娟隔。",
        "度碛冲云朔风起，"
      ],
      "author": {
        "id": 8770,
        "name": "陈陶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 370183,
      "title": "殿前生桂树",
      "content": [
        "仙娥玉宫秋夜明，桂枝拂槛参差琼。",
        "香风下天漏丁丁，",
        "东海即为郎斟酌，绮疏长悬七星杓。"
      ],
      "author": {
        "id": 8770,
        "name": "陈陶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 370184,
      "title": "古镜篇",
      "content": [
        "紫皇玉镜蟾蜍字，堕地千年光不死。",
        "发匣身沈古井寒，",
        "野老曾耕太白星，神狐夜哭秋天片。",
        "下国青铜旋磨灭，"
      ],
      "author": {
        "id": 8770,
        "name": "陈陶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 370185,
      "title": "自归山",
      "content": [
        "海岳南归远，天门北望深。",
        "暂为青琐客，难换白云心。",
        "富贵老闲事，猿猱思旧林。",
        "清平无乐志，尊酒有瑶琴。"
      ],
      "author": {
        "id": 8770,
        "name": "陈陶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 370192,
      "title": "题居上人法华新院",
      "content": [
        "浮名深般若，方寺设莲华。",
        "钟呗成僧国，湖山称法家。",
        "一尘多宝塔，千佛大牛车。",
        "能诱泥犁客，超然识聚沙。"
      ],
      "author": {
        "id": 8770,
        "name": "陈陶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 370193,
      "title": "送秦炼师",
      "content": [
        "紫府静沉沉，松轩思别吟。",
        "水流宁有意，云泛本无心。",
        "锦洞桃花远，青山竹叶深。",
        "不因时卖药，何路更相寻。"
      ],
      "author": {
        "id": 8770,
        "name": "陈陶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 370197,
      "title": "赠温州韩使君",
      "content": [
        "康乐风流五百年，永嘉铃阁又登贤。",
        "严城鼓动鱼惊海，",
        "今来谁似韩家贵，越绝麾幢雁影连。"
      ],
      "author": {
        "id": 8770,
        "name": "陈陶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 370198,
      "title": "闲居寄太学卢景博士",
      "content": [
        "无路青冥夺锦袍，耻随黄雀住蓬蒿。",
        "碧云梦后山风起，",
        "闲来长得留侯癖，罗列楂梨校六韬。"
      ],
      "author": {
        "id": 8770,
        "name": "陈陶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 370199,
      "title": "赠漳州张怡使君",
      "content": [
        "旧德徐方天下闻，当年熊轼继清芬。",
        "井田异政光蛮竹，",
        "几时征拜征西越，学著缦胡从使君。"
      ],
      "author": {
        "id": 8770,
        "name": "陈陶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 370200,
      "title": "赠容南韦中丞",
      "content": [
        "普宁都护军威重，九驿梯航压要津。",
        "十二铜鱼尊画戟，",
        "不独来苏发歌咏，天涯半是泣珠人。"
      ],
      "author": {
        "id": 8770,
        "name": "陈陶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 370201,
      "title": "投赠福建路罗中丞",
      "content": [
        "越艳新谣不厌听，楼船高卧静南溟。",
        "未闻建水窥龙剑，",
        "皇恩几日西归去，玉树扶疏正满庭。"
      ],
      "author": {
        "id": 8770,
        "name": "陈陶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 370202,
      "title": "赠江南李偕副使",
      "content": [
        "世禄三朝压凤池，杜陵公子汉庭知。",
        "雷封始贺堂溪剑，",
        "从军莫厌千场醉，即是金銮宠命时。"
      ],
      "author": {
        "id": 8770,
        "name": "陈陶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 370203,
      "title": "贺容府韦中丞大府贤兄新除黔南经略",
      "content": [
        "蓬瀛簪笏旧联行，紫极差池降宠章。",
        "列国山河分雁字，",
        "烽戍悠悠限巴越，伫听歌咏两甘棠。"
      ],
      "author": {
        "id": 8770,
        "name": "陈陶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 370204,
      "title": "和容南韦中丞题瑞亭白燕、白鼠、六眸龟、嘉莲",
      "content": [
        "伏波恩信动南夷，交趾喧传四瑞诗。",
        "燕鼠孕灵褒上德，",
        "尽写流传在轩槛，嘉祥从此百年知。"
      ],
      "author": {
        "id": 8770,
        "name": "陈陶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 370205,
      "title": "题豫章西山香城寺",
      "content": [
        "十地严宫礼竺皇，栴檀楼阁半天香。",
        "祇园树老梵声小，",
        "何年七七金人降，金锡珠坛满上方。"
      ],
      "author": {
        "id": 8770,
        "name": "陈陶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 370206,
      "title": "送江西周尚书赴滑台",
      "content": [
        "楚谣襦袴整三千，喉舌新恩下九天。",
        "天角雄都分节钺，",
        "多病无因酬一顾，鄢陵千骑去翩翩。"
      ],
      "author": {
        "id": 8770,
        "name": "陈陶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 370207,
      "title": "闽中送任畹端公还京",
      "content": [
        "燕台下榻玉为人，月桂曾输次第春。",
        "几日酬恩坐炎瘴，",
        "多少嘉谟奏风俗，斗牛孤剑在平津。"
      ],
      "author": {
        "id": 8770,
        "name": "陈陶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 370208,
      "title": "豫章江楼望西山有怀",
      "content": [
        "水护星坛列太虚，烟霓十八上仙居。",
        "时人未识辽东鹤，",
        "桃花谷口春深浅，欲访先生赤鲤鱼。"
      ],
      "author": {
        "id": 8770,
        "name": "陈陶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 370209,
      "title": "经徐稚墓",
      "content": [
        "郏鄏妖兴炎汉衰，先生南国卧明夷。",
        "凤凰屡降玄𫄸礼，",
        "千年垄树何人哭，寂寞苍苔内史碑。"
      ],
      "author": {
        "id": 8770,
        "name": "陈陶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 370210,
      "title": "钟陵道中作",
      "content": [
        "原隰经霜蕙草黄，塞鸿消息怨流芳。",
        "秋山落照见麋鹿，",
        "曾逢啮缺话东海，长忆萧家青玉床。"
      ],
      "author": {
        "id": 8770,
        "name": "陈陶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 370211,
      "title": "旅泊涂江",
      "content": [
        "烟雨南江一叶微，松潭渔父夜相依。",
        "断沙雁起金精出，",
        "无因得似沧溟叟，始忆离巢已倦飞。"
      ],
      "author": {
        "id": 8770,
        "name": "陈陶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 370212,
      "title": "上建溪",
      "content": [
        "崆峒一派泻苍烟，长揖丹丘逐水仙。",
        "云树杳冥通上界，",
        "已判猿催鬓先白，几重滩濑在秋天。"
      ],
      "author": {
        "id": 8770,
        "name": "陈陶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 370213,
      "title": "冬日暮旅泊庐陵",
      "content": [
        "螺亭倚棹哭飘蓬，白浪欺船自向东。",
        "楚国蕙兰增怅望，",
        "弃置侯鲭任羁束，不劳龟瓦问穷通。"
      ],
      "author": {
        "id": 8770,
        "name": "陈陶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 370214,
      "title": "登宝历寺阁",
      "content": [
        "金碧高层世界空，凭蜺长啸八蛮风。",
        "横轩水壮蛟龙府，",
        "不堪怀古劳悲笑，安得鹏抟颢气中。"
      ],
      "author": {
        "id": 8770,
        "name": "陈陶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 370215,
      "title": "寄兵部任畹郎中",
      "content": [
        "常思剑浦越清尘，豆蔻花红十二春。",
        "昆玉已成廊庙器，",
        "好向昌时荐遗逸，莫教千古吊灵均。"
      ],
      "author": {
        "id": 8770,
        "name": "陈陶"
      },
      "dynasty": {
        "id": 6,
