{
  "data": [
    {
      "id": 298336,
      "title": "临江仙",
      "content": [
        "樱桃落尽春归去，蝶飜轻粉双飞。",
        "子规啼月小楼西，玉钩罗幕，惆怅暮烟垂。",
        "别巷寂寥人散后，望残烟草低迷。",
        "炉香闲袅凤皇儿，空持罗带，回首恨依依。"
      ],
      "author": {
        "id": 11675,
        "name": "后主煜"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298612,
      "title": "临江仙",
      "content": [
        "暮蝉声尽落斜阳，银蟾影挂潇湘。",
        "黄陵庙侧水茫茫，楚山红树，烟雨隔高唐。",
        "岸泊渔灯风飐碎，白苹远散浓香。",
        "灵娥鼓瑟韵清商，朱弦凄切，云散碧天长。"
      ],
      "author": {
        "id": 6339,
        "name": "毛文锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298636,
      "title": "临江仙 一",
      "content": [
        "海棠香老春江晚，小楼雾縠空蒙。",
        "翠鬟初出绣帘中，麝烟鸾佩惹苹风。",
        "碾玉钗摇㶉𫛶战，雪肌云鬓将融。",
        "含情遥指碧波东，越王台殿蓼花红。"
      ],
      "author": {
        "id": 7016,
        "name": "和凝"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298637,
      "title": "临江仙 二",
      "content": [
        "披袍窣地红宫锦，莺语时转轻音。",
        "碧罗冠子稳犀簪，凤凰双飐步摇金。",
        "肌骨细匀红玉輭，脸波微送春心。",
        "娇羞不肯入鸳衾，兰膏光里两情深。"
      ],
      "author": {
        "id": 7016,
        "name": "和凝"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298646,
      "title": "临江仙 一",
      "content": [
        "峭碧参差十二峰，冷烟寒树重重。",
        "瑶姬宫殿是仙踪。",
        "金炉珠帐，香霭昼偏浓。",
        "一自楚王惊梦断，人间无路相逢。",
        "至今云雨带愁容。",
        "月斜江上，征櫂动晨钟。"
      ],
      "author": {
        "id": 838,
        "name": "牛希济"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298647,
      "title": "临江仙 二",
      "content": [
        "谢家仙观寄云岑，嵒萝拂地成阴。",
        "洞房不闭白云深。",
        "当时丹灶，一粒化黄金。",
        "石壁霞衣犹半挂，松风长似鸣琴。",
        "时闻唳鹤起前林。"
      ],
      "author": {
        "id": 838,
        "name": "牛希济"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298648,
      "title": "临江仙 三",
      "content": [
        "渭阙宫城秦树凋，玉楼独上无憀。",
        "含情不语自吹箫。",
        "调清和恨，天路逐风飘。",
        "何事乘龙人忽降，似知深意相招。",
        "三清携手路非遥。",
        "世间屏障，彩笔画娇饶。"
      ],
      "author": {
        "id": 838,
        "name": "牛希济"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298649,
      "title": "临江仙 四",
      "content": [
        "江绕黄陵春庙闲，娇莺独语关关。",
        "满庭重叠绿苔斑。",
        "阴云无事，四散自归山。",
        "箫鼓声稀香烬冷，月娥敛尽弯环。",
        "风流皆道胜人间。",
        "须知狂客，判死为红颜。"
      ],
      "author": {
        "id": 838,
        "name": "牛希济"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298650,
      "title": "临江仙 五",
      "content": [
        "素洛春光潋滟平，千重媚脸初生。",
        "凌波罗韈势轻轻。",
        "烟笼日照，珠翠半分明。",
        "风引宝衣疑欲舞，鸾回凤翥堪惊。",
        "也知心许恐无成。",
        "陈王辞赋，千载有声名。"
      ],
      "author": {
        "id": 838,
        "name": "牛希济"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298651,
      "title": "临江仙 六",
      "content": [
        "柳带摇风汉水滨，平芜两岸争匀。",
        "鸳鸯对浴浪痕新。",
        "弄珠游女，微笑自含春。",
        "轻步暗移蝉鬓动，罗帬风惹轻尘。",
        "水精宫殿岂无因。",
        "空劳纤手，解佩赠情人。"
      ],
      "author": {
        "id": 838,
        "name": "牛希济"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298652,
      "title": "临江仙 七",
      "content": [
        "洞庭波浪飐晴天，君山一点凝烟。",
        "此中真境属神仙。",
        "玉楼珠殿，相映月轮边。",
        "万里平湖秋色冷，星辰垂影参然。",
        "橘林霜重更红鲜。",
        "罗浮山下，有路暗相连。"
      ],
      "author": {
        "id": 838,
        "name": "牛希济"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298723,
      "title": "临江仙 一",
      "content": [
        "碧染长空池似镜，倚楼闲望凝情。",
        "满衣红藕细香清。",
        "象床珍簟，山障掩，玉琴横。",
        "暗想昔时欢笑事，如今赢得愁生。",
        "博山炉煖澹烟轻。",
        "蝉吟人静，残日傍，小窗明。"
      ],
      "author": {
        "id": 12325,
        "name": "顾敻"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298724,
      "title": "临江仙 二",
      "content": [
        "幽闺小槛春光晚，柳浓花澹莺稀。",
        "旧欢思想尚依依。",
        "翠嚬红歛，终日损芳菲。",
        "何事狂夫音信断，不如梁燕犹归。",
        "画堂深处麝烟微。",
        "屏虚枕冷，风细雨霏霏。"
      ],
      "author": {
        "id": 12325,
        "name": "顾敻"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298725,
      "title": "临江仙 三",
      "content": [
        "月色穿帘风入竹，倚屏双黛愁时。",
        "砌花含露两三枝。",
        "如啼恨脸，魂断损容仪。",
        "香烬暗销金鸭冷，可堪孤负前期。",
        "绣襦不整鬓鬟攲。",
        "几多惆怅，情绪在天涯。"
      ],
      "author": {
        "id": 12325,
        "name": "顾敻"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298731,
      "title": "临江仙 一",
      "content": [
        "金锁重门荒苑静，绮窗愁对秋空。",
        "翠华一去寂无踪。",
        "玉楼歌吹，声断已随风。",
        "烟月不知人事改，夜阑还照深宫。",
        "藕花相向野塘中。",
        "暗伤亡国，清露泣香红。"
      ],
      "author": {
        "id": 3625,
        "name": "鹿虔扆"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298732,
      "title": "临江仙 二",
      "content": [
        "无赖晓莺惊梦断，起来残酒初醒。",
        "映窗丝柳袅烟青。",
        "翠帘慵卷，约砌杏花零。",
        "一自玉郎游冶去，莲凋月惨仪形。",
        "暮天微雨洒闲庭。",
        "手挼裙带，无语倚云屏。"
      ],
      "author": {
        "id": 3625,
        "name": "鹿虔扆"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298765,
      "title": "临江仙 一",
      "content": [
        "一番荷芰生池沼，槛前风送馨香。",
        "昔年于此伴萧娘。",
        "相偎伫立，牵惹叙衷肠。",
        "时逞笑容无限态，还如菡萏争芳。",
        "别来虚遣思悠飏。",
        "慵窥往事，金锁小兰房。"
      ],
      "author": {
        "id": 3776,
        "name": "尹鹗"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298766,
      "title": "临江仙 二",
      "content": [
        "深秋寒夜银河静，月明深院中庭。",
        "西窗幽梦等闲成。",
        "逡巡觉后，特地恨难平。",
        "红烛半条残焰短，[依]稀暗背银屏。",
        "枕前何事最伤情。",
        "梧桐叶上，点点露珠零。"
      ],
      "author": {
        "id": 3776,
        "name": "尹鹗"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298798,
      "title": "临江仙 一",
      "content": [
        "南齐天子宠婵娟，六宫罗绮三千，潘妃娇艳独芳妍。",
        "椒房兰洞，云雨降神仙。",
        "纵态迷欢心不足，风流可惜当年，纤腰婉约步金莲。",
        "妖君倾国，犹自至今传。"
      ],
      "author": {
        "id": 13554,
        "name": "毛熙震"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298799,
      "title": "临江仙 二",
      "content": [
        "幽闺欲曙闻莺转，红窗月影微明，好风频谢落花声。",
        "隔帏残烛，犹照绮屏筝。",
        "绣被锦茵眠玉煖，炷香斜袅烟轻，淡蛾羞敛不胜情。"
      ],
      "author": {
        "id": 13554,
        "name": "毛熙震"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298847,
      "title": "临江仙 一",
      "content": [
        "帘卷池心小阁虚，暂凉闲步徐徐。",
        "芰荷经雨半凋疎，拂堤垂柳，蝉噪夕阳余。",
        "不语低鬟幽思远，玉钗斜坠双鱼。",
        "几回偷看寄来书，离情别恨，相隔欲何如。"
      ],
      "author": {
        "id": 12052,
        "name": "李珣"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298848,
      "title": "临江仙 二",
      "content": [
        "莺报帘前暖日红，玉炉残麝犹浓。",
        "起来闺思尚疎慵，[别]愁春梦，谁解此情悰。",
        "彊整娇姿临宝镜，小池一朵芙蓉。",
        "旧欢无处再寻踪，更堪回顾，屏画九疑峰。"
      ],
      "author": {
        "id": 12052,
        "name": "李珣"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298905,
      "title": "临江仙 一",
      "content": [
        "雨停荷芰逗浓香，岸边蝉噪垂杨。",
        "物华空有旧池塘，不逢仙子，何处梦襄王。",
        "珍簟对欹鸳枕冷，此来尘暗凄凉。",
        "欲凭危槛恨偏长，藕花珠缀，犹似汗凝妆。"
      ],
      "author": {
        "id": 3463,
        "name": "阎选"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298906,
      "title": "临江仙 二",
      "content": [
        "十二高峰天外寒，竹梢轻拂仙坛。",
        "宝衣行雨在云端，画帘深殿，香雾冷风残。",
        "欲问楚王何处去，翠屏犹掩金鸾。",
        "猨啼明月照空滩，孤舟行客，惊梦亦艰难。"
      ],
      "author": {
        "id": 3463,
        "name": "阎选"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298956,
      "title": "临江仙 一",
      "content": [
        "霜拍井梧干叶堕，翠帏雕槛初寒。",
        "薄铅残黛称花冠，含情无语，延伫倚阑干。",
        "杳杳征轮何处去，离愁别恨千般。",
        "不堪心绪正多端，镜匳长掩，无意对孤鸾。"
      ],
      "author": {
        "id": 12232,
        "name": "孙光宪"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298957,
      "title": "临江仙 二",
      "content": [
        "暮雨凄凄深院闭，灯前凝坐初更。",
        "玉钗低压鬓云横，半垂罗幕，相映烛光明。",
        "终是有心投汉珮，低头但理秦筝。",
        "燕双鸾偶不胜情，只愁明发，将逐楚云行。"
      ],
      "author": {
        "id": 12232,
        "name": "孙光宪"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 299002,
      "title": "临江仙",
      "content": [
        "烟收湘渚秋江静，蕉花露泣愁红。",
        "五云双鹤去无踪，几回魂断，凝望向长空。",
        "翠竹暗留珠泪怨，闲调宝瑟波中。",
        "花鬟月鬓绿云重，古祠深殿，香冷雨和风。"
      ],
      "author": {
        "id": 645,
        "name": "张泌"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 299083,
      "title": "临江仙",
      "content": [
        "冷红飘起桃花片，青春意绪阑珊。",
        "高楼帘幕卷轻寒，酒余人散，独自倚阑干。",
        "夕阳千里连芳草，风光愁杀王孙。",
        "徘徊飞尽碧天云，凤城何处，明月照黄昏。"
      ],
      "author": {
        "id": 8353,
        "name": "冯延巳"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 299099,
      "title": "临江仙",
      "content": [
        "饮散离亭西去，浮生常恨飘蓬。",
        "回头烟柳渐重重，淡云孤鴈远，寒日暮天红。",
        "今夜画船何处，潮平淮月朦胧。",
        "酒醒人静奈愁浓，残灯孤枕梦，轻浪五更风。"
      ],
      "author": {
        "id": 3281,
        "name": "徐昌图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 312396,
      "title": "临江仙",
      "content": [
        "梦觉小庭院，冷风淅淅，疏雨潇潇。",
        "绮窗外，秋声败叶狂飘。",
        "心摇。",
        "奈寒漏永，孤帏悄，泪烛空烧。",
        "无端处，是绣衾鸳枕，闲过清宵。",
        "萧条。",
        "牵情系恨，争向年少偏饶。",
        "觉新来、憔悴旧日风标。",
        "魂消。",
        "念欢娱事，烟波阻、后约方遥。",
        "还经岁，问怎生禁得，如许无聊。"
      ],
      "author": {
        "id": 3061,
        "name": "柳永"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312405,
      "title": "临江仙",
      "content": [
        "鸣珂碎撼都门晓，旌幢拥下天人。",
        "马摇金辔破香尘。",
        "壶浆盈路，欢动一城春。",
        "扬州曾是追游地，酒台花径仍存。",
        "凤箫依旧月中闻。",
        "荆王魂梦，应认岭头云。"
      ],
      "author": {
        "id": 3061,
        "name": "柳永"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312422,
      "title": "临江仙引",
      "content": [
        "渡口、向晚，乘瘦马、陟平冈。",
        "西郊又送秋光。",
        "对暮山横翠，衬残叶飘黄。",
        "凭高念远，素景楚天，无处不凄凉。",
        "香闺别来无信息，云愁雨恨难忘。",
        "指帝城归路，但烟水茫茫。",
        "凝情望断泪眼，尽日独立斜阳。"
      ],
      "author": {
        "id": 3061,
        "name": "柳永"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312423,
      "title": "临江仙引",
      "content": [
        "上国。",
        "去客。",
        "停飞盖、促离筵。",
        "长安古道绵绵。",
        "见岸花啼露，对堤柳愁烟。",
        "物情人意，向此触目，无处不凄然。",
        "醉拥征骖犹伫立，盈盈泪眼相看。",
        "况绣帏人静，更山馆春寒。",
        "今宵怎向漏永，顿成两处孤眠。"
      ],
      "author": {
        "id": 3061,
        "name": "柳永"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312424,
      "title": "临江仙引",
      "content": [
        "画舸、荡桨，随浪箭、隔岸虹。",
        "□荷占断秋容。",
        "疑水仙游泳，向别浦相逢。",
        "鲛丝雾吐渐收，细腰无力转娇慵。",
        "罗袜凌波成旧恨，有谁更赋惊鸿。",
        "想媚魂香信，算密锁瑶宫。",
        "游人漫劳倦□，奈何不逐东风。"
      ],
      "author": {
        "id": 3061,
        "name": "柳永"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312538,
      "title": "临江仙",
      "content": [
        "自古伤心惟远别，登山临水迟留。",
        "暮尘衰草一番秋。",
        "寻常景物，到此尽成愁。",
        "况与佳人分凤侣，盈盈粉泪难收。",
        "高城深处是青楼。",
        "红尘远道，明日忍回头。"
      ],
      "author": {
        "id": 5040,
        "name": "张先"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312751,
      "title": "临江仙",
      "content": [
        "资善堂中三十载，旧人多是凋零。",
        "与君相见最伤情。",
        "一尊如旧，聊且话平生。",
        "此别要知须强饮，雪残风细长亭。",
        "待君归觐九重城。",
        "帝宸思旧，朝夕奉皇明。"
      ],
      "author": {
        "id": 6242,
        "name": "晏殊"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312760,
      "title": "临江仙",
      "content": [
        "湖水连天天连水，秋来分外澄清。",
        "君山自是小蓬瀛。",
        "气蒸云梦泽，波撼岳阳城。",
        "帝子有灵能鼓瑟，凄然依旧伤情。",
        "微闻兰芝动芳馨。",
        "曲终人不见，江上数峰青。"
      ],
      "author": {
        "id": 7409,
        "name": "滕宗谅"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312919,
      "title": "临江仙",
      "content": [
        "柳外轻雷池上雨，雨声滴碎荷声。",
        "小楼西角断虹明。",
        "阑干倚处，待得月华生。",
        "燕子飞来窥画栋，玉钩垂下帘旌。",
        "凉波不动簟纹平。",
        "水精双枕，傍有堕钗横。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312920,
      "title": "临江仙",
      "content": [
        "记得金銮同唱第，春风上国繁华。",
        "如今薄宦老天涯。",
        "十年歧路，空负曲江花。",
        "闻说阆山通阆苑，楼高不见君家。",
        "孤城寒日等闲斜。",
        "离愁难尽，红树远连霞。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313124,
      "title": "临江仙",
      "content": [
        "太史占天云物好，初阳律合黄锺。",
        "日缠南极北郊风。",
        "雪花先柳絮，飞舞透帘栊。",
        "圣运时和兼岁稔，歌欢处处皆同。",
        "簪声相庆晓光中。",
        "金炉红兽炭，一举寿杯空。"
      ],
      "author": {
        "id": 11741,
        "name": "杜安世"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313125,
      "title": "临江仙",
      "content": [
        "遍地残花庭院静，流莺对对相过。",
        "万条风柳间婆娑。",
        "樱桃初弄色，萱草自成窠。",
        "早是芳菲时节晚，追游期会无多。",
        "眉山敛翠近秋波。",
        "日长初睡起，愁与病相和。"
      ],
      "author": {
        "id": 11741,
        "name": "杜安世"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313211,
      "title": "临江仙",
      "content": [
        "一夜东风穿绣户，融融暖应佳时。",
        "春来何处最先知。",
        "平明堤上柳。",
        "染遍郁金枝。",
        "姊妹嬉游时节近，今朝应怨来迟。",
        "凭谁说与到家期。",
        "玉钗头上胜，留待远人归。"
      ],
      "author": {
        "id": 11355,
        "name": "苏氏"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313259,
      "title": "临江仙",
      "content": [
        "弄水亭前千万景，登临不忍空回。",
        "水轻墨澹写蓬莱。",
        "莫教世眼，容易洗尘埃。",
        "收去雨昏都不见，展时还似云开。",
        "先生高趣更多才。",
        "人人尽道，小杜却重来。"
      ],
      "author": {
        "id": 4757,
        "name": "俞紫芝"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313308,
      "title": "临江仙",
      "content": [
        "斗草阶前初见，穿针楼上曾逢。",
        "罗裙香露玉钗风。",
        "靓妆眉沁绿，羞脸粉生红。",
        "流水便随春远，行云终与谁同。",
        "酒醒长恨锦屏空。",
        "相寻梦里路，飞雨落花中。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313309,
      "title": "临江仙",
      "content": [
        "身外闲愁空满，眼中欢事常稀。",
        "明年应赋送君诗。",
        "细从今夜数，相会几多时。",
        "浅酒欲邀谁劝，深情惟有君知。",
        "东溪春近好同归。",
        "柳垂江上影，梅谢雪中枝。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313310,
      "title": "临江仙",
      "content": [
        "淡水三年欢意，危弦几夜离情。",
        "晓霜红叶舞归程。",
        "客情今古道，秋梦短长亭。",
        "渌酒尊前清泪，阳关叠里离声。",
        "少陵诗思旧才名。",
        "云鸿相约处，烟雾九重城。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313311,
      "title": "临江仙",
      "content": [
        "浅浅馀寒春半，雪消蕙草初长。",
        "烟迷柳岸旧池塘。",
        "风吹梅蕊闹，雨细杏花香。",
        "月堕枝头欢意，从前虚梦高唐，觉来何处放思量。",
        "如今不是梦，真个到伊行。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313312,
      "title": "临江仙",
      "content": [
        "长爱碧阑干影，芙蓉秋水开时。",
        "脸红凝露学娇啼。",
        "霞觞熏冷艳，云髻袅纤枝。",
        "烟雨依前时候，霜丛如旧芳菲。",
        "与谁同醉采香归。",
        "去年花下客，今似蝶分飞。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313313,
      "title": "临江仙",
      "content": [
        "旖旎仙花解语，轻盈春柳能眠。",
        "玉楼深处绮窗前。",
        "梦回芳草夜，歌罢落梅天。",
        "沈水浓熏绣被，流霞浅酌金船。",
        "绿娇红小正堪怜。",
        "莫如云易散，须似月频圆。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313314,
      "title": "临江仙",
      "content": [
        "梦后楼台高锁，酒醒帘幕低垂。",
        "去年春恨却来时。",
        "落花人独立，微雨燕双飞。",
        "记得小苹初见，两重心字罗衣。",
        "琵琶弦上说相思。",
        "当时明月在，曾照彩云归。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313315,
      "title": "临江仙",
      "content": [
        "东野亡来无丽句，于君去后少交亲。",
        "追思往事好沾巾。",
        "白头王建在，犹见咏诗人。",
        "学道深山空自老，留名千载不干身。",
        "酒筵歌席莫辞频。",
        "争如南陌上，占取一年春。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313584,
      "title": "临江仙",
      "content": [
        "别岸相逢何草草，扁舟两岸垂杨。",
        "绣屏珠箔绮香囊。",
        "酒深歌拍缓，愁入翠眉长。",
        "燕子归来人去也，此时无奈昏黄。",
        "桃花应是我心肠。",
        "不禁微雨，流泪湿红妆。"
      ],
      "author": {
        "id": 8647,
        "name": "王观"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313600,
      "title": "临江仙",
      "content": [
        "庭院深深深几许，云窗雾阁春迟。",
        "为谁憔悴损芳姿。",
        "夜来清梦好，应是发南枝。",
        "玉瘦檀轻无限恨，南楼羌管休吹。",
        "浓香吹尽有谁知。",
        "暖风迟日也，别到杏花肥。"
      ],
      "author": {
        "id": 2516,
        "name": "魏夫人"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313684,
      "title": "临江仙",
      "content": [
        "细马远驮双侍女，青巾玉带红靴。",
        "溪山好处便为家。",
        "谁知巴峡路，却见洛城花。",
        "面旋落英飞玉蕊，人间春日初斜。",
        "十年不见紫云车。",
        "龙丘新洞府，铅鼎养丹砂。"
      ],
      "author": {
        "id": 11678,
        "name": "苏轼"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313685,
      "title": "临江仙",
      "content": [
        "诗句端来磨我钝，钝锥不解生铓。",
        "欢颜为我解冰霜。",
        "酒阑清梦觉，春草满池塘。",
        "应念雪堂坡下老，昔年共采芸香。",
        "功成名遂早还乡。",
        "回车来过我，乔木拥千章。"
      ],
      "author": {
        "id": 11678,
        "name": "苏轼"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313686,
      "title": "临江仙",
      "content": [
        "我劝髯张归去好，从来自己忘情。",
        "尘心消尽道心平。",
        "江南与塞北，何处不堪行。",
        "俎豆庚桑真过矣，凭君说与南荣。",
        "愿闻吴越报丰登。",
        "君王如有问，结袜赖王生。"
      ],
      "author": {
        "id": 11678,
        "name": "苏轼"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313687,
      "title": "临江仙",
      "content": [
        "自古相从休务日，何妨低唱微吟。",
        "天垂云重作春阴。",
        "坐中人半醉，帘外雪将深。",
        "闻道分司狂御史，紫云无路追寻。",
        "凄风寒雨是骎骎。",
        "问囚长损气，见鹤忽惊心。"
      ],
      "author": {
        "id": 11678,
        "name": "苏轼"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313688,
      "title": "临江仙",
      "content": [
        "忘却成都来十载，因君未免思量。",
        "凭将清泪洒江阳。",
        "故山知好在，孤客自悲凉。",
        "坐上别愁君未见，归来欲断无肠。",
        "殷勤且更尽离觞。",
        "此身如传舍，何处是吾乡。"
      ],
      "author": {
        "id": 11678,
        "name": "苏轼"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313689,
      "title": "临江仙",
      "content": [
        "尊酒何人怀李白，草堂遥指江东。",
        "珠帘十里卷香风。",
        "花开又花谢，离恨几千重。",
        "轻舸渡江连夜到，一时惊笑衰容。",
        "语音犹自带吴侬。",
        "夜阑对酒处，依旧梦魂中。"
      ],
      "author": {
        "id": 11678,
        "name": "苏轼"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313690,
      "title": "临江仙",
      "content": [
        "九十日春都过了，贪忙何处追游。",
        "三分春色一分愁。",
        "雨翻榆荚阵，风转柳花球。",
        "阆苑先生须自责，蟠桃动是千秋。",
        "不知人世苦厌求。",
        "东皇不拘束，肯为使君留。"
      ],
      "author": {
        "id": 11678,
        "name": "苏轼"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313691,
      "title": "临江仙",
      "content": [
        "四大从来都遍满，此间风水何疑。",
        "故应为我发新诗。",
        "幽花香涧谷，寒藻舞沦漪。",
        "借与玉川生两腋，天仙未必相思。",
        "还凭流水送人归。",
        "层巅馀落日，草露已沾衣。"
      ],
      "author": {
        "id": 11678,
        "name": "苏轼"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313692,
      "title": "临江仙",
      "content": [
        "一别都门三改火，天涯踏尽红尘。",
        "依然一笑作春温。",
        "无波真古井，有节是秋筠。",
        "惆怅孤帆连夜发，送行淡月微云。",
        "尊前不用翠眉颦。",
        "人生如逆旅，我亦是行人。"
      ],
      "author": {
        "id": 11678,
        "name": "苏轼"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313693,
      "title": "临江仙",
      "content": [
        "多病休文都瘦损，不堪金带垂腰。",
        "望湖楼上暗香飘。",
        "和风春弄袖，明月夜闻箫。",
        "酒醒梦回清漏永，隐床无限更潮。",
        "佳人不见董娇饶。",
        "徘徊花上月，空度可怜宵。"
      ],
      "author": {
        "id": 11678,
        "name": "苏轼"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313694,
      "title": "临江仙",
      "content": [
        "夜饮东坡醒复醉，归来仿佛三更。",
        "家童鼻息已雷鸣。",
        "敲门都不应，倚杖听江声。",
        "长恨此身非我有，何时忘却营营。",
        "夜阑风静縠纹平。",
        "小舟从此逝，江海寄馀生。"
      ],
      "author": {
        "id": 11678,
        "name": "苏轼"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313695,
      "title": "临江仙",
      "content": [
        "冬夜夜寒冰合井，画堂明月侵帏。",
        "青缸明灭照悲啼。",
        "青缸挑欲尽，粉泪裛还垂。",
        "未尽一尊先掩泪，歌声半带清悲。",
        "情声两尽莫相违。",
        "欲知肠断处，梁上暗尘飞。"
      ],
      "author": {
        "id": 11678,
        "name": "苏轼"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313936,
      "title": "临江仙",
      "content": [
        "谁道东阳都瘦损，凝然点漆精神。",
        "瑶林终自隔风尘，试看披鹤氅，仍是谪仙人。",
        "省可清言挥玉麈，真须保器全真。",
        "风流何似道家纯。",
        "不应同蜀客，惟爱卓文君。"
      ],
      "author": {
        "id": 11678,
        "name": "苏轼"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313962,
      "title": "临江仙",
      "content": [
        "昨夜渡江何处宿，望中疑是秦淮。",
        "月明谁起笛中哀。",
        "多情王谢女，相逐过江来。",
        "云雨未成还又散，思量好事难谐。",
        "凭陵急桨两相催。",
        "想伊归去后，应似我情怀。"
      ],
      "author": {
        "id": 11678,
        "name": "苏轼"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314025,
      "title": "临江仙",
      "content": [
        "知有阆风花解语，从来只许传闻。",
        "光明休咏汉宫新。",
        "拥身疑有月，衬步恨无云。",
        "莫把金樽容易劝，坐来几度销魂。",
        "不知仙骨在何人。",
        "好将千岁日，占断四时春。"
      ],
      "author": {
        "id": 8599,
        "name": "李之仪"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314026,
      "title": "临江仙",
      "content": [
        "九十日春都过了，寻常偶到江皋。",
        "水容山态两相饶。",
        "草平天一色，风暖燕双高。",
        "酒病厌厌何计那，飞红更送无聊。",
        "莺声又似耳边娇。",
        "难回巫峡梦，空恨武陵桃。"
      ],
      "author": {
        "id": 8599,
        "name": "李之仪"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314063,
      "title": "临江仙",
      "content": [
        "偶向凌歊台上望，春光已过三分。",
        "江山重叠倍销魂。",
        "风花飞有态，烟絮醉无痕。",
        "已是年来伤感甚，那堪旧恨仍存。",
        "清愁满眼共谁论。",
        "却应台下草，不解忆王孙。"
      ],
      "author": {
        "id": 8599,
        "name": "李之仪"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314064,
      "title": "临江仙",
      "content": [
        "难得今朝风日好，春光佳思平分。",
        "虽然公子暗招魂。",
        "其如抬眼看，都是旧时痕。",
        "酒到强寻欢日路，坐来谁为温存。",
        "落花流水不堪论。",
        "何时弦上意，重为拂桐孙。"
      ],
      "author": {
        "id": 8599,
        "name": "李之仪"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314098,
      "title": "临江仙",
      "content": [
        "初破晓寒无限思，融融腊意全迷。",
        "春工从此被人知。",
        "不随蜂蝶，长伴玉蟾低。",
        "缥缈云间应好在，盈盈泪湿征衣。",
        "背人偷拗向东枝。",
        "清香满袖，犹记画堂西。"
      ],
      "author": {
        "id": 8599,
        "name": "李之仪"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314099,
      "title": "临江仙",
      "content": [
        "病里不知春早晚，惊心绿暗红稀。",
        "起来初拭薄罗衣。",
        "多情海燕，还傍旧梁飞。",
        "瘦损休文谁记得，空将销臂频围。",
        "眼前都是去年时。",
        "不堪追想，魂断画楼西。"
      ],
      "author": {
        "id": 8599,
        "name": "李之仪"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314103,
      "title": "临江仙",
      "content": [
        "圣主临轩亲策试，集英佳气葱葱。",
        "鸣鞘声震未央宫。",
        "卷帘龙影动，挥翰御烟浓。",
        "上第归来何事好，迎人花面争红。",
        "蓝袍香散六街风。",
        "一鞭春色里，骄损玉花骢。"
      ],
      "author": {
        "id": 12769,
        "name": "许将"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314104,
      "title": "临江仙",
      "content": [
        "不比寻常三五夜，万家齐望清辉。",
        "烂银盘透碧琉璃。",
        "莫辞终夕看，动是隔年期。",
        "试问嫦娥还记否，玉人曾折高枝。",
        "明年此夜再圆时。",
        "合开东府宴，身在凤凰池。"
      ],
      "author": {
        "id": 4417,
        "name": "郑无党"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314127,
      "title": "临江仙",
      "content": [
        "折柳门前鹦鹉绿，河梁小驻归船。",
        "不堪华发对离筵。",
        "孤村啼鴂日，深院落花天。",
        "文采弟兄真叠玉，赤宵去路谁先。",
        "明朝便恐各风烟。",
        "江山如有恨，桃李自无言。"
      ],
      "author": {
        "id": 6565,
        "name": "舒亶"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314231,
      "title": "临江仙",
      "content": [
        "羽扇纶巾风袅袅，东厢月到蔷薇。",
        "新声谁唤出罗帏。",
        "龙须将笛绕，雁字入筝飞。",
        "陶写中年须个里，留连月扇云衣。",
        "周郎去后赏音稀。",
        "为君持酒听，那肯带春归。"
      ],
      "author": {
        "id": 9909,
        "name": "范成大"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314232,
      "title": "临江仙",
      "content": [
        "万事灰心犹薄宦，尘埃未免劳形。",
        "故人相见似河清。",
        "恰逢梅柳动，高兴逐春生。",
        "卜昼匆匆还卜夜，仍须月坠河倾。",
        "明年我去白鸥盟。",
        "金闺三玉树，好问紫霄程。"
      ],
      "author": {
        "id": 9909,
        "name": "范成大"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314563,
      "title": "临江仙",
      "content": [
        "试问梅花何处好，与君藉草携壶。",
        "西园清夜片尘无。",
        "一天云破碎，两树玉扶疏。",
        "谁𢬍昭华吹古怨，散花便满衣裾。",
        "只疑幽梦在清都。",
        "星稀河影转，霜重月华孤。"
      ],
      "author": {
        "id": 12402,
        "name": "张孝祥"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314564,
      "title": "临江仙",
      "content": [
        "试问宜楼楼下竹，年来应长新篁。",
        "使君五岭又三湘。",
        "旧游知好在，熟处更难忘。",
        "尚念论心舒歗否，只今湖海相望。",
        "遥怜阴过酒尊凉。",
        "举觞须酹我，门外是清江。"
      ],
      "author": {
        "id": 12402,
        "name": "张孝祥"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314627,
      "title": "临江仙",
      "content": [
        "畴昔方壶游戏地，群仙步履相从。",
        "明黄衫子御西风。",
        "佩环金错落，羽葆翠璁珑。",
        "骑鹄翩然归去路，吹箫横度青峰。",
        "夜深河汉冷秋容。",
        "前驱香十里，飘坠月轮东。"
      ],
      "author": {
        "id": 6695,
        "name": "李处全"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314710,
      "title": "临江仙",
      "content": [
        "天上玉卮称万寿，人间湛露初匀。",
        "种萱堂上阅青春。",
        "薰风频送喜，同日拜丝纶。",
        "班在蕊珠仙缀立，等闲历遍燕秦。",
        "紫皇先付与佳名。",
        "宜家更宜国，宜子又宜孙。"
      ],
      "author": {
        "id": 1129,
        "name": "丘崈"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314805,
      "title": "临江仙",
      "content": [
        "忽忆裴公台上去，远空秋气棱棱。",
        "万山一水秀还明。",
        "此时三楚客，何意续骚经。",
        "爱竹子犹参杖履，能诗候喜同登。",
        "赓酬不尽古今情。",
        "清风生白尘，侧月照疏星。"
      ],
      "author": {
        "id": 11270,
        "name": "吕胜己"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314860,
      "title": "临江仙",
      "content": [
        "忆昔去年花下饮，团蛮争看酴醿。",
        "酒浓花艳两相宜。",
        "醉中尝记得，裙带写新诗。",
        "还是春光惊已暮，此身犹在天涯。",
        "断肠无奈苦相思。",
        "忧心徒耿耿，分付与他谁。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314871,
      "title": "临江仙",
      "content": [
        "春事犹馀十日，吴蚕早已三眠。",
        "多情忍对落花前。",
        "酴醿飘暖雪，荷叶媚晴天。",
        "香淡无心浸酒，绿浮可意邀船。",
        "时光堪恨也堪怜。",
        "单衣三月暮，歌扇一番圆。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314949,
      "title": "临江仙",
      "content": [
        "过尽征鸿来尽燕，故园消息茫然。",
        "一春憔悴有谁怜。",
        "怀家寒食夜，中酒落花天。",
        "见说江头春浪渺，殷勤欲送归船。",
        "别来此处最萦牵。",
        "断篷南浦雨，疏柳断桥烟。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314968,
      "title": "临江仙",
      "content": [
        "帘幕轻风洒洒，园林绿荫垂垂。",
        "楝花开遍麦秋时。",
        "雨深芳草渡，蝴蝶正慵飞。",
        "憔悴三春心事，风流一弄金衣。",
        "韶光老尽起深思。",
        "日长庭院里，徙倚听催归。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314972,
      "title": "临江仙",
      "content": [
        "柳上斜阳红万缕，烘人满院荷香。",
        "晚凉初浴略梳妆。",
        "冠儿轻替枕，衫子染莺黄。",
        "蓄意新词轻缓唱，殷勤满捧瑶觞。",
        "醉乡日月得能长。",
        "仙源正闲散，伴我老高唐。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315006,
      "title": "临江仙",
      "content": [
        "万里西风吹去旆，满城无奈离情。",
        "甘棠也似戴公深。",
        "晓来风露里，叶叶做秋声。",
        "十载两番遗爱在，须知愁满宜春。",
        "楚天低处是归程。",
        "夕阳疏雨外，莫遣乱蝉鸣。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315007,
      "title": "临江仙",
      "content": [
        "枫叶白苹秋未老，晚风吹泛轻艎。",
        "青山沥沥水茫茫。",
        "情随流水远，恨逐暮山长。",
        "一点相思千点泪，眼前无限情伤。",
        "佳人犹自捧离觞。",
        "阳关休唱彻，唱彻断人肠。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315037,
      "title": "临江仙",
      "content": [
        "日欲低时江景好，暮山紫翠重重。",
        "钓筒收尽碧潭空。",
        "一船霜夜月，两岸荻花风。",
        "遥忆暖春新向火，黄昏下了帘栊。",
        "水村渔浦舣孤篷。",
        "单衾愁梦断，无梦转愁浓。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315086,
      "title": "临江仙",
      "content": [
        "十里春风杨柳路，年年带雨披云。",
        "柔条万缕不胜情。",
        "还将无意眼，识遍有心人。",
        "饿损宫腰终不似，效颦总是难成。",
        "只愁秋色入高林。",
        "残蝉和落叶，此际不堪论。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315107,
      "title": "临江仙",
      "content": [
        "蕊嫩花房无限好，东风一样春工。",
        "百年欢笑酒樽同。",
        "笙吹雏凤语，裙染石榴红。",
        "且向五云深处住，锦衾绣幌从容。",
        "如何即是出樊笼。",
        "蓬莱人少到，云雨事难穷。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315108,
      "title": "临江仙",
      "content": [
        "破靥盈盈巧笑，举杯滟滟迎逢。",
        "慧心端有谢娘风。",
        "烛花香雾，娇困面微红。",
        "别恨彩笺虽寄，清歌浅酌难同。",
        "梦回楚馆雨云空。",
        "相思春暮，愁满绿芜中。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315109,
      "title": "临江仙",
      "content": [
        "夜久笙箫吹彻，更深星斗还稀。",
        "醉拈裙带写新诗。",
        "锁窗风露，烛灺月明时。",
        "水调悠扬声美，幽情彼此心知。",
        "古香烟断彩云归。",
        "满倾蕉叶，齐唱传花枝。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315127,
      "title": "临江仙",
      "content": [
        "人在梦云楼上别，残灯影里迟留。",
        "依稀绿惨更红羞。",
        "露痕双脸湿，山样两眉愁。",
        "几幅片帆天际去，云涛烟浪悠悠。",
        "今宵独立古江头。",
        "水腥鱼菜市，风碎荻花舟。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315141,
      "title": "临江仙",
      "content": [
        "天外浓云云外雨，雨声初上檐牙。",
        "红蕖应褪洗妆花。",
        "晚凉如有意，霫霫到山家。",
        "为唤山童多索酒，金锺细酌流霞。",
        "晕生玉颊酒潮斜。",
        "闲中无宠辱，醉里是生涯。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315167,
      "title": "临江仙",
      "content": [
        "天祐炎图生国瑞，蓝田暂屈英僚。",
        "始知文宿降璇霄。",
        "中元前五日，七夕后三朝。",
        "江𢽾风流临此政，少年潇洒奇标。",
        "行看峻擢相熙朝。",
        "功名前稷契，寿算等松乔。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315175,
      "title": "临江仙",
      "content": [
        "远岫螺头湿翠，流霞赪尾疏明。",
        "断虹斜界雨新晴。",
        "烟村灯火晚，江浦画难成。",
        "我向其间泛叶，终朝露渚风汀。",
        "老来心事最关情。",
        "不堪三弄笛，吹作断肠声。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315234,
      "title": "临江仙",
      "content": [
        "欲近上元人意好，月如人意团圆。",
        "暖风催趣养花天。",
        "三山来鹤驾，万户识凫仙。",
        "手种河阳桃李树，暂时来看春妍。",
        "彩衣一笑棹觥船。",
        "明年当此日，人到凤池边。"
      ],
      "author": {
        "id": 2810,
        "name": "王炎2"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    }
  ],
