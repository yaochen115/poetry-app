      "id": 323499,
      "title": "调笑・调笑令",
      "content": [
        "非雾。",
        "花无语。",
        "远似朝云何处去。",
        "凌波不过横塘路。",
        "燕燕莺莺飞舞。",
        "风吹仙袂飘飘举。",
        "拟倩游丝惹住。"
      ],
      "author": {
        "id": 5773,
        "name": "无名氏"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
