{
  "data": [
    {
      "id": 276620,
      "title": "岳阳楼",
      "content": [
        "欲为平生一散愁，洞庭湖上岳阳楼。",
        "可怜万里堪乘兴，枉是蛟龙解覆舟。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276621,
      "title": "寄成都高苗二从事",
      "content": [
        "家近红蕖曲水滨，全家罗袜起秋尘。",
        "莫将越客千丝网，网得西施别赠人。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276622,
      "title": "岳阳楼",
      "content": [
        "汉水方城带百蛮，四隣谁道乱周班。",
        "如何一梦高唐雨，自此无心入武关。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276623,
      "title": "越燕二首 一",
      "content": [
        "上国社方见，此乡秋不归。",
        "为矜皇后舞，犹著羽人衣。",
        "拂水斜纹乱，衔花片影微。",
        "卢家文杏好，试近莫愁飞。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276624,
      "title": "越燕二首 二",
      "content": [
        "将泥红蓼岸，得草绿杨村。",
        "命侣添新意，安巢复旧痕。",
        "去应逢阿母，来莫害王孙。",
        "记取丹山凤，今为百鸟尊。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276625,
      "title": "杜工部蜀中离席",
      "content": [
        "人生何处不离群，世路干戈惜暂分。",
        "雪岭未归天外使，松州犹驻殿前军。",
        "座中醉客延醒客，江上晴云杂雨云。",
        "美酒成都堪送老，当垆仍是卓文君。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276626,
      "title": "隋宫",
      "content": [
        "紫泉宫殿锁烟霞，欲取芜城作帝家。",
        "玉玺不缘归日角，锦帆应是到天涯。",
        "于今腐草无萤火，终古垂杨有暮鸦。",
        "地下若逢陈后主，岂宜重问后庭花。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276627,
      "title": "二月二日",
      "content": [
        "二月二日江上行，东风日暖闻吹笙。",
        "花须柳眼各无赖，紫蝶黄蜂俱有情。",
        "万里忆归元亮井，三年从事亚夫营。",
        "新滩莫悟游人意，更作风簷夜雨声。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276628,
      "title": "筹笔驿",
      "content": [
        "猿鸟犹疑畏简书，风云常为护储胥。",
        "徒令上将挥神笔，终见降王走传车。",
        "管乐有才终不忝，关张无命欲何如。",
        "他年锦里经祠庙，梁父吟成恨有余。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276629,
      "title": "屏风",
      "content": [
        "六曲连环接翠帷，高楼半夜酒醒时。",
        "掩灯遮雾密如此，雨落月明俱不知。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276630,
      "title": "春日",
      "content": [
        "欲入卢家白玉堂，新春催破舞衣裳。",
        "蝶衔红蘂蜂衔粉，共助青楼一日忙。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276631,
      "title": "武侯庙古柏",
      "content": [
        "蜀相阶前柏，龙蛇捧閟宫。",
        "阴成外江畔，老向惠陵东。",
        "大树思冯异，甘棠忆召公。",
        "叶凋湘燕雨，枝拆海鹏风。",
        "玉垒经纶远，金刀历数终。",
        "谁将出师表，一为问昭融。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 276632,
      "title": "风",
      "content": [
        "撩钗盘孔雀，恼带拂鸳鸯。",
        "萝荐谁教近，斋时锁洞房。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 276633,
      "title": "即日",
      "content": [
        "一岁林花即日休，江间亭下怅淹留。",
        "重吟细把真无奈，已落犹开未放愁。",
        "山色正来衔小苑，春阴只欲傍高楼。",
        "金鞍忽散银壶漏，更醉谁家白玉钩。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276634,
      "title": "九成宫",
      "content": [
        "十二层城阆苑西，平时避暑拂虹霓。",
        "云随夏后双龙尾，风逐周王八骏蹄。",
        "吴岳晓光连翠𪩘，甘泉晚景上丹梯。",
        "荔枝卢橘沾恩幸，鸾鹊天书湿紫泥。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276635,
      "title": "少将",
      "content": [
        "族亚齐安陆，风高汉武威。",
        "烟波别墅醉，花月后门归。",
        "青海闻传箭，天山报合围。",
        "一朝携剑起，上马即如飞。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276636,
      "title": "咏史",
      "content": [
        "历览前贤国与家，成由勤俭破由奢。",
        "何须琥珀方为枕，岂得真珠始是车。",
        "运去不逢青海马，力穷难拔蜀山蛇。",
        "几人曾预南薰曲，终古苍梧哭翠华。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276637,
      "title": "赠白道者",
      "content": [
        "十二楼前再拜辞，灵风正满碧桃枝。",
        "壶中若是有天地，又向壶中伤别离。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276638,
      "title": "无题二首 一",
      "content": [
        "昨夜星辰昨夜风，画楼西畔桂堂东。",
        "身无彩凤双飞翼，心有灵犀一点通。",
        "隔座送钩春酒暖，分曹射复蜡灯红。",
        "嗟余听鼓应官去，走马兰台类断蓬。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276639,
      "title": "无题二首 二",
      "content": [
        "闻到阊门萼绿华，昔年相望抵天涯。",
        "岂知一夜秦楼客，偷看吴王苑内花。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276640,
      "title": "汉宫词",
      "content": [
        "青雀西飞竟未回，君王长在集灵台。",
        "侍臣最有相如渴，不赐金茎露一杯。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276641,
      "title": "无题四首 一",
      "content": [
        "来是空言去绝踪，月斜楼上五更钟。",
        "梦为远别啼难唤，书被催成墨未浓。",
        "蜡照半笼金翡翠，麝熏微度绣芙蓉。",
        "刘郎已恨蓬山远，更隔蓬山一万重。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276642,
      "title": "无题四首 二",
      "content": [
        "飒飒东风细雨来，芙蓉塘外有轻雷。",
        "金蟾啮鏁烧香入，玉虎牵丝汲井回。",
        "贾氏窥帘韩掾少，宓妃留枕魏王才。",
        "春心莫共花争发，一寸相思一寸灰。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276643,
      "title": "无题四首 三",
      "content": [
        "含情春晼晚，暂见夜阑干。",
        "楼响将登怯，帘烘欲过难。",
        "多羞钗上燕，真媿镜中鸾。",
        "归去横塘晓，华星送宝鞍。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276644,
      "title": "无题四首 四",
      "content": [
        "何处哀筝随急管，樱花永巷垂杨岸。",
        "东家老女嫁不售，白日当天三月半。",
        "溧阳公主年十四，清明暖后同墙看。",
        "归来展转到五更，梁间燕子闻长叹。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276645,
      "title": "赴职梓潼留别畏之员外同年",
      "content": [
        "佳兆联翩遇凤凰，雕文羽帐紫金床。",
        "桂花香处同高第，柿叶翻时独悼亡。",
        "乌鹊失栖长不定，鸳鸯何事自相将。",
        "京华庸蜀三千里，送到咸阳见夕阳。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276646,
      "title": "桂林路中作",
      "content": [
        "地暖无秋色，江晴有暮晖。",
        "空余蝉嘒嘒，犹向客依依。",
        "村小犬相护，沙平僧独归。",
        "欲成西北望，又见鹧鸪飞。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276647,
      "title": "无题",
      "content": [
        "照梁初有情，出水旧知名。",
        "帬衩芙蓉小，钗茸翡翠轻。",
        "锦长书郑重，眉细恨分明。",
        "莫近弹碁局，中心最不平。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276648,
      "title": "蝶三首 一",
      "content": [
        "初来小苑中，稍与琐闱通。",
        "远恐芳尘断，轻忧艳雪融。",
        "只知防皓露，不觉逆尖风。",
        "回首双飞燕，乘时入绮栊。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276649,
      "title": "蝶三首 二",
      "content": [
        "长眉画了绣帘开，碧玉行收白玉台。",
        "为问翠钗钗上凤，不知香颈为谁回。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276650,
      "title": "蝶三首 三",
      "content": [
        "寿阳公主嫁时妆，八字宫眉捧额黄。",
        "见我佯羞频照影，不知身属冶游郎。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276651,
      "title": "无题二首 一",
      "content": [
        "八岁偷照镜，长眉已能画。",
        "十岁去踏青，芙蓉作帬衩。",
        "十二学弹筝，银甲不曾卸。",
        "十四藏六亲，悬知犹未嫁。",
        "十五泣春风，背面秋千下。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 276652,
      "title": "无题二首 二",
      "content": [
        "幽人不倦赏，秋暑贵招邀。",
        "竹碧转怅望，池清尤寂寥。",
        "露花终裛湿，风蝶强娇饶。",
        "此地如携手，兼君不自聊。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276653,
      "title": "王十二兄与畏之员外相访见招小饮时予以悼亡日近不去因寄",
      "content": [
        "谢傅门庭旧末行，今朝歌管属檀郎。",
        "更无人处帘垂地，欲拂尘时簟竟床。",
        "嵇氏幼男犹可悯，左家娇女岂能忘。",
        "秋霖腹疾俱难遣，万里西风夜正长。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276654,
      "title": "隋宫",
      "content": [
        "乘兴南游不戒严，九重谁省谏书函。",
        "春风举国裁宫锦，半作障泥半作帆。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276655,
      "title": "落花",
      "content": [
        "高阁客竟去，小园花乱飞。",
        "参差连曲陌，迢遰送斜晖。",
        "肠断未忍扫，眼穿仍欲归。",
        "芳心向春尽，所得是沾衣。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276656,
      "title": "月",
      "content": [
        "池上与桥边，难忘复可怜。",
        "帘开最明夜，簟卷已凉天。",
        "流处水花急，吐时云叶鲜。",
        "姮娥无粉黛，只是逞婵娟。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276657,
      "title": "赠宗鲁笻竹杖",
      "content": [
        "大夏资轻策，全溪赠所思。",
        "静怜穿树远，滑想过苔迟。",
        "鹤怨朝还望，僧闲暮有期。",
        "风流真底事，常欲傍清羸。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276658,
      "title": "垂柳",
      "content": [
        "娉婷小苑中，婀娜曲池东。",
        "朝佩皆垂地，仙衣尽带风。",
        "七贤宁占竹，三品且饶松。",
        "肠断灵和殿，先皇玉座空。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276659,
      "title": "曲池",
      "content": [
        "日下繁香不自持，月中流艳与谁期。",
        "迎忧急鼓疎钟断，分隔休灯灭烛时。",
        "张盖欲判江滟滟，回头更望柳丝丝。",
        "从来此地黄昏散，未信河梁是别离。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276660,
      "title": "代应二首 一",
      "content": [
        "沟水分流西复东，九秋霜月五更风。",
        "离鸾别凤今何在，十二玉楼空更空。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276661,
      "title": "代应二首 二",
      "content": [
        "昨夜双钩败，今朝百草输。",
        "关西狂小吏，惟喝遶床卢。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 276662,
      "title": "席上作",
      "content": [
        "淡云轻雨拂高唐，玉殿秋来夜正长。",
        "料得也应怜宋玉，一生惟事楚襄王。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276663,
      "title": "访隐者不遇成二绝 一",
      "content": [
        "秋水悠悠浸墅扉，梦中来数觉来稀。",
        "玄蝉去尽叶黄落，一树冬青人未归。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276664,
      "title": "访隐者不遇成二绝 二",
      "content": [
        "城郭休过识者稀，哀猿啼处有柴扉。",
        "沧江白日樵渔路，日暮归来雨满衣。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276665,
      "title": "破镜",
      "content": [
        "玉匣清光不复持，菱花散乱月轮亏。",
        "秦台一照山鸡后，便是孤鸾罢舞时。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276666,
      "title": "无题",
      "content": [
        "紫府仙人号宝灯，云浆未饮结成冰。",
        "如何雪月交光夜，更在瑶台十二层。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276667,
      "title": "赠庾十二朱版",
      "content": [
        "固漆投胶不可开，赠君珍重抵琼瑰。",
        "君王晓坐金銮殿，只待相如草诏来。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276668,
      "title": "李花",
      "content": [
        "李径独来数，愁情相与悬。",
        "自明无月夜，强笑欲风天。",
        "减粉与园箨，分香沾渚莲。",
        "徐妃久已嫁，犹自玉为钿。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276669,
      "title": "柳",
      "content": [
        "曾逐东风拂舞筵，乐游春苑断肠天。",
        "如何肯到清秋日，已带斜阳又带蝉。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276670,
      "title": "三月十日流杯亭",
      "content": [
        "身属中军少得归，木兰花尽失春期。",
        "偷随柳絮到城外，行过水西闻子规。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276671,
      "title": "过招国李家南园二首 一",
      "content": [
        "潘岳无妻客为愁，新人来坐旧妆楼。",
        "春风犹自疑联句，雪絮相和飞不休。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276672,
      "title": "过招国李家南园二首 二",
      "content": [
        "长亭岁尽雪如波，此去秦关路几多。",
        "惟有梦中相近分，卧来无睡欲如何。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276673,
      "title": "留赠畏之 一",
      "content": [
        "清时无事奏明光，不遣当关报早霜。",
        "中禁词臣寻引领，左川归客自回肠。",
        "郎君下笔惊鹦鹉，侍女吹笙弄凤凰。",
        "空寄大罗天上事，众仙同日咏霓裳。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276674,
      "title": "留赠畏之 二",
      "content": [
        "待得郎来月已低，寒暄不道醉如泥。",
        "五更又欲向何处，骑马出门乌夜啼。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276675,
      "title": "留赠畏之 三",
      "content": [
        "户外重阴黯不开，含羞迎夜复临台。",
        "潇湘浪上有烟景，安得好风吹汝来。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276676,
      "title": "为有",
      "content": [
        "为有云屏无限娇，凤城寒尽怕春宵。",
        "无端嫁得金龟壻，辜负香衾事早朝。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276677,
      "title": "无题",
      "content": [
        "相见时难别亦难，东风无力百花残。",
        "春蚕到死丝方尽，蜡炬成灰泪始干。",
        "晓镜但愁云鬓改，夜吟应觉月光寒。",
        "蓬山此去无多路，青鸟殷勤为探看。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276678,
      "title": "碧城三首 一",
      "content": [
        "碧城十二曲阑干，犀辟尘埃玉辟寒。",
        "阆苑有书多附鹤，女床无树不栖鸾。",
        "星沉海底当窗见，雨过河源隔座看。",
        "若是晓珠明又定，一生长树水晶盘。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276679,
      "title": "碧城三首 二",
      "content": [
        "对影闻声已可怜，玉池荷叶正田田。",
        "不逢萧史休回首，莫见洪崖又拍肩。",
        "紫凤放娇衔楚佩，赤鳞狂舞拨湘弦。",
        "鄂君怅望舟中夜，绣被焚香独自眠。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276680,
      "title": "碧城三首 三",
      "content": [
        "七夕来时先有期，洞房帘箔至今垂。",
        "玉轮顾兔初生魄，铁网珊瑚未有枝。",
        "检与神方教驻景，收将凤纸写相思。",
        "武皇内传分明在，莫道人间总不知。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276681,
      "title": "对雪二首 一",
      "content": [
        "寒气先侵玉女扉，清光旋透省郎闱。",
        "梅花大庾岭头发，柳絮章台街里飞。",
        "欲舞定随曹植马，有情应湿谢庄衣。",
        "龙山万里无多远，留待行人二月归。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276682,
      "title": "对雪二首 二",
      "content": [
        "旋扑珠帘过粉墙，轻于柳絮重于霜。",
        "已随江令夸琼树，又入卢家妬玉堂。",
        "侵夜可能争桂魄，忍寒应欲试梅妆。",
        "关河冻合东西路，肠断斑骓送陆郎。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276683,
      "title": "蜂",
      "content": [
        "小苑华池烂熳通，后门前槛思无穷。",
        "宓妃腰细才胜露，赵后身轻欲倚风。",
        "红壁寂寥崖蜜尽，碧帘迢遰雾巢空。",
        "青陵粉碟休离恨，长定相逢二月中。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276684,
      "title": "公子",
      "content": [
        "外戚封侯自有恩，平明通籍九华门。",
        "金唐公主年应小，二十君王未许婚。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276685,
      "title": "赋得鸡",
      "content": [
        "稻粱犹足活诸雏，妬敌专场好自娱。",
        "可要五更惊晓梦，不辞风雪为阳乌。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276686,
      "title": "明神",
      "content": [
        "明神司过岂令冤，暗室由来有祸门。",
        "莫为无人欺一物，他时须虑石能言。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276687,
      "title": "辛未七夕",
      "content": [
        "恐是仙家好别离，故教迢遰作佳期。",
        "由来碧落银河畔，可要金风玉露时。",
        "清漏渐移相望久，微云未接过来迟。",
        "岂能无意酬乌鹊，惟与蜘蛛乞巧丝。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276688,
      "title": "壬申七夕",
      "content": [
        "已驾七香车，心心待晓霞。",
        "风轻惟响珮，日薄不嫣花。",
        "桂嫩传香远，榆高送影斜。",
        "成都过卜肆，曾妬识灵槎。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276689,
      "title": "壬申闰秋题赠鸟鹊",
      "content": [
        "绕树无衣月正高，邺城新泪溅云袍。",
        "几年始得逢秋闰，两度填河莫告劳。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276690,
      "title": "端居",
      "content": [
        "远书归梦两悠悠，只有空床敌素秋。",
        "堦下青苔与红树，雨中寥落月中愁。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276691,
      "title": "夜半",
      "content": [
        "三更三点万家眠，露欲为霜月堕烟。",
        "鬬鼠上堂蝙蝠出，玉琴时动倚窗弦。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276692,
      "title": "玉山",
      "content": [
        "玉山高与阆风齐，玉水清流不贮泥。",
        "何处更求回日驭，此中兼有上天梯。",
        "珠容百斛龙休睡，桐拂千寻凤要栖。",
        "闻道神仙有才子，赤箫吹罢好相携。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276693,
      "title": "张恶子庙",
      "content": [
        "下马捧椒浆，迎神白玉堂。",
        "如何铁如意，独自与姚苌。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 276694,
      "title": "雨",
      "content": [
        "摵摵度瓜园，依依傍竹轩。",
        "秋池不自冷，风叶共成喧。",
        "窗迥有时见，簷高相续翻。",
        "侵宵送书雁，应为稻粱恩。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276695,
      "title": "菊",
      "content": [
        "暗暗淡淡紫，融融冶冶黄。",
        "陶令篱边色，罗含宅里香。",
        "几时禁重露，实是怯残阳。",
        "愿泛金鹦鹉，升君白玉堂。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276696,
      "title": "牡丹",
      "content": [
        "锦帏初卷卫夫人，绣被犹堆越鄂君。",
        "垂手乱翻雕玉佩，招腰争舞郁金帬。",
        "石家蜡烛何曾剪，荀令香炉可待熏。",
        "我是梦中传彩笔，欲书花叶寄朝云。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276697,
      "title": "北楼",
      "content": [
        "春物岂相干，人生只强欢。",
        "花犹曾敛夕，酒竟不知寒。",
        "异城东风湿，中华上象宽。",
        "此楼堪北望，轻命倚危栏。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276698,
      "title": "拟沈下贤",
      "content": [
        "千二百轻鸾，春衫瘦著宽。",
        "倚风行稍急，含雪语应寒。",
        "带火遗金斗，兼珠碎玉盘。",
        "河阳看花过，曾不问潘安。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276699,
      "title": "蝶",
      "content": [
        "飞来绣户阴，穿过画楼深。",
        "重傅秦台粉，轻涂汉殿金。",
        "相兼惟柳絮，所得是花心。",
        "可要凌孤客，邀为子夜吟。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276700,
      "title": "饮席代官妓赠两从事",
      "content": [
        "新人桥上著春衫，旧主江边侧帽簷。",
        "愿得化为红绶带，许教双凤一时衔。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276701,
      "title": "代魏宫私赠",
      "content": [
        "来时西馆阻佳期，去后漳河隔梦思。",
        "知有宓妃无限意，春松秋菊可同时。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276702,
      "title": "代元城吴令暗为荅",
      "content": [
        "背阙归藩路欲分，水边风日半西曛。",
        "荆王枕上原无梦，莫枉阳台一片云。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276703,
      "title": "牡丹",
      "content": [
        "压迳复缘沟，当窗又映楼。",
        "终销一国破，不啻万金求。",
        "鸾凤戏三岛，神仙居十洲。",
        "应怜萱草淡，却得号忘忧。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276704,
      "title": "百果嘲樱桃",
      "content": [
        "珠实虽先熟，琼莩纵早开。",
        "流鸎犹故在，争得讳含来。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 276705,
      "title": "樱桃答",
      "content": [
        "众果莫相诮，天生名品高。",
        "何因古乐府，惟有郑樱桃。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 276706,
      "title": "晓坐",
      "content": [
        "后合罢朝眠，前墀思黯然。",
        "梅应未假雪，柳自不胜烟。",
        "泪续浅深绠，肠危高下弦。",
        "红颜无定所，得失在当年。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276707,
      "title": "咏史",
      "content": [
        "北湖南埭水漫漫，一片降旗百尺竿。",
        "三百年间同晓梦，钟山何处有龙盘。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276708,
      "title": "一片",
      "content": [
        "一片非烟隔九枝，蓬峦仙仗俨云旗。",
        "天泉水暖龙吟细，露畹春多凤舞迟。",
        "榆荚散来星斗转，桂花寻去月轮移。",
        "人间桑海朝朝变，莫遣佳期更后期。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276709,
      "title": "日射",
      "content": [
        "日射纱窗风撼扉，香罗拭手春事违。",
        "回廊四合掩寂寞，碧鹦鹉对红蔷薇。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276710,
      "title": "题鹅",
      "content": [
        "眠沙卧水自成群，曲岸残阳极浦云。",
        "那解将心怜孔翠，羁雌长共故雄分。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276711,
      "title": "华清宫",
      "content": [
        "朝元阁迥羽衣新，首按昭阳第一人。",
        "当日不来高处舞，可能天下有胡尘。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276712,
      "title": "梓潼望长卿山至巴西复怀谯秀",
      "content": [
        "梓潼不见马相如，更欲南行问酒垆。",
        "行到巴西觅谯秀，巴西惟是有寒芜。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276713,
      "title": "齐宫词",
      "content": [
        "永寿兵来夜不扃，金莲无复印中庭。",
        "梁台歌管三更罢，犹自风摇九子铃。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276714,
      "title": "十一月中旬至扶风界见梅花",
      "content": [
        "匝路亭亭艳，非时裛裛香。",
        "素娥惟与月，青女不饶霜。",
        "赠远虚盈手，伤离适断肠。",
        "为谁成早秀，不待作年芳。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276715,
      "title": "青陵台",
      "content": [
        "青陵台畔日光斜，万古贞魂倚暮霞。",
        "莫讶韩凭为蛱蝶，等闲飞上别枝花。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276716,
      "title": "东还",
      "content": [
        "自有仙才自不知，十年长梦采华芝。",
        "秋风动地黄云暮，归去嵩阳寻旧师。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276717,
      "title": "酬崔八早梅有赠兼示之作",
      "content": [
        "知访寒梅过野塘，久留金勒为回肠。",
        "谢郎衣袖初翻雪，荀令熏炉更换香。",
        "何处拂胸资蝶粉，几时涂额藉蜂黄。",
        "维摩一室虽多病，亦要天花作道场。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276718,
      "title": "春风",
      "content": [
        "春风虽自好，春物太昌昌。",
        "若教春有意，惟遣一枝芳。",
        "我意殊春意，先春已断肠。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 276719,
      "title": "蜀桐",
      "content": [
        "玉垒高桐拂玉绳，上含非雾下含冰。",
        "枉教紫凤无栖处，斵作秋琴弹坏陵。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    }
  ],
