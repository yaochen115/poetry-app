{
  "data": [
    {
      "id": 7290,
      "title": "和潘泽之沈元吉泛舟湖上",
      "content": [
        "散骑真前辈，休文即当家。",
        "泛舟成丽句，散绮见余霞。",
        "惊去沙鸥没，招来酒斾斜。",
        "春归何处覔，篱角见金沙。"
      ],
      "author": {
        "id": 13381,
        "name": "王之道"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 69205,
      "title": "和龚同叔春日即事五首  其二",
      "content": [
        "柳绵飞扑扑，荷叶散田田。",
        "物幻无穷意，春归何处天。",
        "事随鸾镜改，人逐燕巢迁。",
        "一笑千金价，吾羞鲁仲连。"
      ],
      "author": {
        "id": 1313,
        "name": "赵善括"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 112191,
      "title": "送春",
      "content": [
        "花菲菲，柳依依，留春不住送春归。",
        "春归何处堪图画，春尽江南日暮时。",
        "黄鹂啼多芳草远，青梅子重杨花飞。",
        "人生三万六千日，与君复有明年期。"
      ],
      "author": {
        "id": 2023,
        "name": "田锡"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 124458,
      "title": "年老逢春十三首  其一二",
      "content": [
        "年老逢春春不任，不任缘被老来侵。",
        "一身老去恶足惜，满眼春归何处寻。",
        "红日坠时风更急，落花流处水仍深。",
        "流鶑不悟芳菲歇，犹向枝头送好音。"
      ],
      "author": {
        "id": 6872,
        "name": "邵雍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 312867,
      "title": "玉楼春",
      "content": [
        "残春一夜狂风雨。",
        "断送红飞花落树。",
        "人心花意待留春，春色无情容易去。",
        "高楼把酒愁独语。",
        "借问春归何处所。",
        "暮云空阔不知音，惟有绿杨芳草路。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314442,
      "title": "踏莎行",
      "content": [
        "红药香残，绿筠粉嫩。",
        "春归何处寻春信。",
        "绣鞍初上马啼轻，举头便觉长安近。",
        "别酒无情，啼妆有恨。",
        "山城向晚斜阳褪。",
        "清江极目带寒烟，锦鳞去后凭谁问。"
      ],
      "author": {
        "id": 1341,
        "name": "李淛"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315377,
      "title": "朝中措",
      "content": [
        "绿萍池沼絮飞忙。",
        "花入蜜脾香。",
        "长怪春归何处，谁知个里迷藏。",
        "残云剩雨，些儿意思，直恁思量。",
        "不是莺声惊觉，梦中啼损红妆。"
      ],
      "author": {
        "id": 8618,
        "name": "辛弃疾"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315379,
      "title": "祝英台令",
      "content": [
        "宝钗分，桃叶渡。",
        "烟柳暗南浦。",
        "怕上层楼，十日九风雨。",
        "断肠片片飞红，都无人管，倩谁唤、流莺声住。",
        "鬓边觑。",
        "试把花卜心期，才簪又重数。",
        "罗帐灯昏，呜咽梦中语。",
        "是他春带愁来，春归何处。",
        "却不解、将愁归去。"
      ],
      "author": {
        "id": 8618,
        "name": "辛弃疾"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316502,
      "title": "东坡引",
      "content": [
        "飞花红不聚。",
        "都因夜来雨。",
        "枝头冷落情如许。",
        "东风谁是主。",
        "看看满地，堆却香絮。",
        "但目断、章台路。",
        "残英剩蕊留春住。",
        "春归何处去。",
        "春归何处去。"
      ],
      "author": {
        "id": 9256,
        "name": "赵师侠"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 321794,
      "title": "摸鱼儿",
      "content": [
        "怎知他、春归何处，相逢且尽尊酒。",
        "少年袅袅天涯恨，长结西湖烟柳。",
        "休回首。",
        "但细雨断桥，憔悴人归后。",
        "东风似旧。",
        "问前度桃花，刘郎能记，花复认郎否。",
        "君且住，草草留君翦韭。",
        "前宵更恁时候。",
        "深杯欲共歌声滑，翻湿春衫半袖。",
        "空眉皱。",
        "看白发尊前，已似人人有。",
        "临分把手。",
        "叹一笑论文，清狂顾曲，此会几时又。"
      ],
      "author": {
        "id": 13144,
        "name": "刘辰翁"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 323183,
      "title": "如梦令",
      "content": [
        "没计断春归路。",
        "借问春归何处。",
        "莺燕也含愁，总对落花无语。",
        "春去。",
        "春去。",
        "门掩一庭疏雨。"
      ],
      "author": {
        "id": 13003,
        "name": "刘南翁"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 323863,
      "title": "如梦令",
      "content": [
        "试问春归何处。",
        "红入小桃花树。",
        "同访古章台，把盏重听金缕。",
        "休去。",
        "休去。",
        "应被好山留住。"
      ],
      "author": {
        "id": 5773,
        "name": "无名氏"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 324890,
      "title": "清平乐",
      "content": [
        "春归何处。",
        "寂寞无行路。",
        "若有人知春去处。",
        "唤取归来同住。",
        "春无踪迹谁知。",
        "除非问取黄鹂。",
        "百啭无人能解，因风飞过蔷薇。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 325176,
      "title": "醉桃园・桃源忆故人",
      "content": [
        "青春不与花为主。",
        "花正开时春暮。",
        "花下醉眠休诉。",
        "看取春归去。",
        "莺愁蝶怨春知否。",
        "欲问春归何处。",
        "只有一尊芳醑。",
        "留得青春住。"
      ],
      "author": {
        "id": 4182,
        "name": "赵鼎"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 327025,
      "title": "如梦令",
      "content": [
        "池上春归何处。",
        "满目落花飞絮。",
        "孤馆悄无人，梦断月堤归路。",
        "无绪。",
        "无绪。",
        "帘外五更风雨。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 327508,
      "title": "感皇恩",
      "content": [
        "终岁忆春回，西园行尽。",
        "欢喜梅梢上春信。",
        "去年携手，暗约芳时还近。",
        "燕来莺又到，人无准。",
        "凭谁向道，流光一瞬。",
        "佳景闲无事衣褪。",
        "春归何处，又对飞花难问。",
        "旧欢都未遇，成新恨。"
      ],
      "author": {
        "id": 1022,
        "name": "晁补之"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 330162,
      "title": "忆仙姿・如梦令",
      "content": [
        "试问春归何处。",
        "蜂懒蝶忙来去。",
        "婉娩倦寻芳，偶遂涉园成趣。",
        "莺语。",
        "莺语。",
        "唤起小鱼吹絮。"
      ],
      "author": {
        "id": 8686,
        "name": "洪皓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 331628,
      "title": "鹧鸪天",
      "content": [
        "桃李飘零春已深。",
        "可怜轻负惜花心。",
        "尊前赖有红千叠，窗外休惊绿满林。",
        "灯灼灼，醉沈沈。",
        "笙歌丛里酒频斟。",
        "留欢且莫匆匆去，怅望春归何处寻。"
      ],
      "author": {
        "id": 9206,
        "name": "曾觌"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    }
  ],
