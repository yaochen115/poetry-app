{
  "data": [
    {
      "id": 280509,
      "title": "鄠杜郊居",
      "content": [
        "槿篱芳援近樵家，垅麦青青一迳斜。",
        "寂寞游人寒食后，夜来风雨送梨花。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 280510,
      "title": "题河中紫极宫",
      "content": [
        "昔年曾伴玉真游，每到仙宫即是秋。",
        "曼倩不归花落尽，满丛烟露月当楼。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 280511,
      "title": "四皓",
      "content": [
        "商于甪里便成功，一寸沈机万古同。",
        "但得戚姬甘定分，不应真有紫芝翁。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 280512,
      "title": "赠张炼师",
      "content": [
        "丹溪药尽变金骨，清洛月寒吹玉笙。",
        "他日隐居无访处，碧桃花发水纵横。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 280513,
      "title": "病中书怀呈友人",
      "content": [
        "逸足皆先路，穷郊独向隅。",
        "顽童逃广柳，羸马卧平芜。",
        "黄卷嗟谁问，朱弦偶自娱。",
        "鹿鸣皆缀士，雌伏竟非夫。",
        "采地荒遗野，爰田失故都。",
        "亡羊犹博簺，牧马倦呼卢。",
        "奕世参周禄，承家学鲁儒。",
        "功庸留劒舃，铭戒在盘盂。",
        "经济怀良画，行藏识远图。",
        "未能鸣楚玉，空欲握隋珠。",
        "定为鱼缘木，曾因兔守株。",
        "五车堆缥帙，三迳阖绳枢。",
        "适与群英集，将期善价沽。",
        "叶龙图夭矫，燕鼠笑胡卢。",
        "赋分知前定，寒心畏厚诬。",
        "蹑尘追庆忌，操劒学班输。",
        "文囿陪多士，神州试大巫。",
        "对虽希鼓瑟，名亦滥吹竽。",
        "正使猜奔竞，何尝计有无。",
        "镏惔虚访觅，王霸竟揶揄。",
        "市义虚焚券，关讥谩弃𦈡。",
        "至言今信矣，微尚亦悲夫。",
        "白雪调歌响，清风乐舞雩。",
        "胁肩难黾勉，搔首易嗟吁。",
        "角胜非能者，推贤见射乎。",
        "兕觥增恐竦，杯水失锱铢。",
        "粉垛收丹采，金髇隐仆姑。",
        "垂櫜羞尽爵，扬觯辱弯弧。",
        "虎拙休言画，龙希莫学屠。",
        "转蓬随欵段，耘草辟墁垆。",
        "受业乡名郑，藏机谷号愚。",
        "质文精等贯，琴筑韵相须。",
        "筑室连中野，诛茅接上腴。",
        "苇花纶虎落，松瘿鬬栾栌。",
        "静语莺相对，闲眠鹤浪俱。",
        "蘂多劳蝶翅，香酷坠蜂须。",
        "芳草迷三岛，澄波似五湖。",
        "跃鱼翻藻荇，愁鹭睡葭芦。",
        "暝洘藏㶉𫛶，幽屏卧鹧鸪。",
        "苦辛随蓻殖，甘旨仰樵苏。",
        "笑语空怀橘，穷愁亦据梧。",
        "尚能甘半菽，非敢薄生刍。",
        "钓石封苍藓，芳蹊艳绛跗。",
        "树兰畦缭绕，穿竹路萦纡。",
        "机杼非桑女，林园异木奴。",
        "横竿窥赤鲤，持翳望青鸬。",
        "泮水思芹味，琅琊得稻租。",
        "杖轻藜拥肿，衣破芰披敷。",
        "芳意忧𫛸鴂，愁声觉蟪蛄。",
        "短簷喧语燕，高木堕饥鼯。",
        "事迫离幽墅，贫牵犯畏途。",
        "爱憎防杜挚，悲叹似杨朱。",
        "旅食常过卫，羇游欲渡泸。",
        "塞歌伤督护，边角思单于。",
        "堡戍标枪槊，关河鏁舳舻。",
        "威容尊大树，邢法避秋荼。",
        "远目穷千里，归心寄九衢。",
        "寝甘诚系滞，浆馈贵睢盱。",
        "怀刺名先远，干时道自孤。",
        "齿牙频激发，簦笈尚崎岖。",
        "莲府侯门贵，霜台帝命俞。",
        "骥蹄初蹑景，鹏翅欲抟扶。",
        "寓直廻骢马，分曹对暝乌。",
        "百神歆仿佛，孤竹韵含胡。",
        "凤阙分班立，鹓行竦劒趋。",
        "触邪承密勿，持法奉訏谟。",
        "鸣玉锵登降，衡牙向曳娄。",
        "祀亲和氏璧，香近博山𬬻。",
        "瑞景森琼树，轻冰莹玉壶。",
        "豸冠簪铁柱，螭首对金铺。",
        "内史书千卷，将军画一厨。",
        "眼明惊气象，心死伏规模。",
        "岂意观文物，何劳琢碔砆。",
        "草肥牧騕褭，苔涩淬昆吾。",
        "乡思巢枝鸟，年华过隙驹。",
        "衔恩空抱影，酬德未捐躯。",
        "时辈推良友，家声继令图。",
        "致身伤短翮，骧首顾疲驽。",
        "班马方齐骛，陈雷亦并驱。",
        "昔皆言尔志，今亦畏吾徒。",
        "有气干牛斗，无人辩辘轳。",
        "客来斟绿蚁，妻试踏青蚨。",
        "积毁方销骨，微瑕惧掩瑜。",
        "蛇矛犹转战，鱼服自囚拘。",
        "欲就欺人事，何能逭鬼诛。",
        "是非迷觉梦，行役议秦吴。",
        "凛冽风埃惨，萧条草木枯。",
        "低徊伤志气，蒙犯变肌肤。",
        "旅雁唯闻呌，饥鹰不待呼。",
        "梦梭抛促织，心茧学蜘蛛。",
        "宁复机难料，庸非信未孚。",
        "激扬衔箭虎，疑惧听冰狐。",
        "处己将营窟，论心若合符。",
        "浪言辉棣萼，何所托葭莩。",
        "乔木能求友，危巢莫吓雏。",
        "风华飘领袖，诗礼拜衾𦈡。",
        "欹枕情何苦，同舟道岂殊。",
        "放怀亲蕙芷，收迹异桑榆。",
        "赠远聊攀柳，栽书欲截蒲。",
        "瞻风无限泪，廻首更踟蹰。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 280514,
      "title": "感旧陈情五十韵献淮南李仆射",
      "content": [
        "嵇绍垂髫日，山涛筮仕年。",
        "琴樽陈席上，纨绮拜床前。",
        "邻里才三徙，云霄已九迁。",
        "感深情戃怳，言发泪潺湲。",
        "忆昔龙图盛，方今鹤羽全。",
        "桂枝香可袭，杨叶旧频穿。",
        "玉籍标人瑞，金丹化地仙。",
        "赋成攒笔写，歌出满城传。",
        "既矫排虚翅，将持造物权。",
        "万灵思鼓铸，群品待陶甄。",
        "视草丝纶出，持纲雨露悬。",
        "法行黄道内，居近翠华边。",
        "书迹临汤鼎，吟声接舜弦。",
        "白麻红烛夜，清漏紫微天。",
        "雷电随神笔，鱼龙落彩牋。",
        "闲宵陪雍畤，清暑在甘泉。",
        "耿介非持禄，优游是养贤。",
        "冰清临百粤，风靡化三川。",
        "委寄崇推毂，威仪压控弦。",
        "梁园提彀骑，淮水换戎旃。",
        "照日青油湿，迎风锦帐鲜。",
        "黛蛾陈二八，珠履列三千。",
        "舞转廻红袖，歌愁歛翠钿。",
        "满堂开照曜，分座俨婵娟。",
        "油额芙蓉帐，香尘玳瑁筵。",
        "绣旗随影合，金阵似波旋。",
        "缇幕深廻互，朱门暗接连。",
        "彩虬蟠画戟，花马立金鞭。",
        "有客将谁托，无媒窃自怜。",
        "抑扬中散曲，漂泊孝廉船。",
        "未展干时策，徒抛负郭田。",
        "转蓬犹邈尔，怀橘更澘然。",
        "投足乖蹊迳，冥心向简编。",
        "未知鱼跃地，空媿鹿鸣篇。",
        "稷下期方至，漳滨病未痊。",
        "定非笼外鸟，真是壳中蝉。",
        "蕙迳邻幽澹，荆扉兴静便。",
        "草堂苔点点，蔬囿水溅溅。",
        "钓罢溪云重，樵归涧月圆。",
        "嬾多成宿疢，愁甚似春眠。",
        "木直终难怨，膏明只自煎。",
        "郑乡空健羡，陈榻未招延。",
        "旅食逢春尽，羁游为事牵。",
        "宦无毛义檄，婚乏阮修钱。",
        "冉弱营中柳，披敷幕下莲。",
        "傥能容委质，非敢望差肩。",
        "涩劒犹堪淬，余朱或可研。",
        "从师当鼓箧，穷理久忘筌。",
        "折简能荣瘁，遗簪莫弃捐。",
        "韶光如见借，寒谷变风烟。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 280515,
      "title": "题翠微寺二十二韵",
      "content": [
        "邠土初成邑，虞宾竟让王。",
        "干符初得位，天弩夜收铓。",
        "偃息齐三代，优游念四方。",
        "万灵扶正寝，千嶂抱重冈。",
        "幽石归阶陛，乔柯入栋梁。",
        "火云如沃雪，汤殿似含霜。",
        "涧籁添仙曲，岩花借御香。",
        "野麋陪兽舞，林鸟逐鹓行。",
        "镜写三秦色，窗摇八水光。",
        "问云征楚女，疑粉试何郎。",
        "兰芷承雕辇，杉萝入画堂。",
        "受朝松露晓，颁朔桂烟凉。",
        "岚湿金铺外，溪鸣锦幄傍。",
        "倚丝忧汉祖，持璧告秦皇。",
        "短景催风驭，长星属羽觞。",
        "储君犹问竖，元老已登床。",
        "鹤盖趋平乐，鸡人下建章。",
        "龙髯悲满眼，螭首泪沾裳。",
        "叠鼓严灵杖，吹笙送夕阳。",
        "断泉辞劒佩，昏日伴旗常。",
        "遗庙青莲在，颓垣碧草芳。",
        "无因奏韶濩，流涕对幽篁。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 280516,
      "title": "过孔北海墓二十韵",
      "content": [
        "抚事如神遇，临风独涕零。",
        "墓平春草绿，碑折古苔青。",
        "珪玉埋英气，山河孕炳灵。",
        "发言惊辨囿，㧑翰动文星。",
        "蕴策期干世，持权欲反经。",
        "激扬思壮志，流落叹颓龄。",
        "恶木人皆息，贪泉我独醒。",
        "轮辕无匠石，刀几有庖丁。",
        "碌碌迷藏器，规规守挈瓶。",
        "愤容凌鼎镬，公议动朝廷。",
        "故国将辞宠，危邦竟缓刑。",
        "钝工磨白璧，凡石砺青萍。",
        "揭日昭东夏，抟风滞北溟。",
        "后尘遵轨辙，前席咏仪型。",
        "木秀当忧悴，弦伤不底宁。",
        "矜夸遭斥鷃，光彩困飞萤。",
        "白羽留谈柄，清风袭德馨。",
        "鸾凰婴雪刃，狼虎犯云屏。",
        "兰蕙荒遗址，榛芜蔽旧坰。",
        "轘辕近沂水，何事恋明庭。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 280517,
      "title": "过华清宫二十二韵",
      "content": [
        "忆昔开元日，承平事胜游。",
        "贵妃专宠幸，天子富春秋。",
        "月白霓裳殿，风干羯鼓楼。",
        "鬬鸡花蔽膝，骑马玉搔头。",
        "绣毂千门妓，金鞍万户侯。",
        "薄云欹雀扇，轻雪犯貂裘。",
        "过客闻韶濩，居人识冕旒。",
        "气和春不觉，烟暖霁难收。",
        "涩浪和琼甃，晴阳上彩斿。",
        "卷衣轻鬓嬾，窥镜澹蛾羞。",
        "屏掩芙蓉帐，帘褰玳瑁钩。",
        "重瞳分渭曲，纤手指神州。",
        "御案迷萱草，天袍妬石榴。",
        "深岩藏浴凤，鲜隰媚潜虬。",
        "不料邯郸虱，俄成即墨牛。",
        "劒锋挥太皞，旗焰拂蚩尤。",
        "内嬖陪行在，孤臣预坐筹。",
        "瑶簪遗翡翠，霜仗驻骅骝。",
        "艳笑双飞断，[香]魂一哭休。",
        "早梅悲蜀道，高树隔昭丘。",
        "朱阁重霄近，苍崖万古愁。",
        "至今汤殿水，呜咽县前流。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 280518,
      "title": "洞户二十二韵",
      "content": [
        "洞户连珠网，方疏隐碧浔。",
        "烛盘烟坠烬，帘压月通阴。",
        "粉白仙郎署，霜清玉女砧。",
        "醉乡高窈窈，棋阵静愔愔。",
        "素手琉璃扇，玄髫玳瑁簪。",
        "昔邪看寄迹，栀子咏同心。",
        "树列千秋胜，楼悬七夕针。",
        "旧词翻白纻，新赋换黄金。",
        "唳鹤调蛮鼓，惊蝉应宝琴。",
        "舞疑繁易度，歌转断难寻。",
        "露委花相妬，风欹柳不禁。",
        "桥弯双表逈，池涨一篙深。",
        "清跸传恢囿，黄旗幸上林。",
        "神鹰参翰苑，天马破蹄涔。",
        "武库方题品，文园有好音。",
        "朱茎殊菌蠢，丹桂欲萧森。",
        "黼帐廻瑶席，华灯对锦衾。",
        "画图惊走兽，书帖得来禽。",
        "河曙秦楼映，山晴魏阙临。",
        "绿囊逢赵后，青锁见王沈。",
        "任达嫌孤愤，疎慵倦九箴。",
        "若为南遁客，犹作卧龙吟。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 280519,
      "title": "送洛南李主簿",
      "content": [
        "想君秦塞外，因见楚山青。",
        "槲叶晓迷路，枳花春满庭。",
        "禄优仍侍膳，官散得专经。",
        "子敬怀愚谷，归心在翠屏。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280520,
      "title": "巫山神女庙",
      "content": [
        "黯黯闭宫殿，霏霏荫薜萝。",
        "晓峰眉上色，春水脸前波。",
        "古树芳菲尽，扁舟离恨多。",
        "一丛斑竹夜，环佩响如何。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280521,
      "title": "地肺山春日",
      "content": [
        "冉冉花明岸，涓涓水绕山。",
        "几时抛俗事，来共白云闲。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 280522,
      "title": "题陈处士幽居",
      "content": [
        "松轩尘外客，高枕自萧疎。",
        "雨后苔侵井，霜来叶满渠。",
        "闲看镜湖画，秋得越僧书。",
        "若待前溪月，谁人伴钓鱼。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280523,
      "title": "握柘词",
      "content": [
        "杨柳萦桥绿，玫瑰拂地红。",
        "绣衫金騕褭，花髻玉珑璁。",
        "宿雨香潜润，春流水暗通。",
        "画楼初梦断，晓日照湘风。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280524,
      "title": "题卢处士山居",
      "content": [
        "西溪问樵客，遥识楚人家。",
        "古树老连石，急泉清露沙。",
        "千峰随雨暗，一迳入云斜。",
        "日暮飞鸦集，满山荞麦花。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280525,
      "title": "初秋寄友人",
      "content": [
        "闲梦正悠悠，凉风生竹楼。",
        "夜琴知欲雨，晓簟觉新秋。",
        "独鸟楚山远，一蝉关树愁。",
        "凭将离别恨，江外问同游。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280526,
      "title": "题丰安里王相林亭二首 一",
      "content": [
        "花竹有薄埃，嘉游集上才。",
        "白苹安石渚，红叶子云台。",
        "朱户雀罗设，黄门驭骑来。",
        "不知淮水浊，丹藕为谁开。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280527,
      "title": "题丰安里王相林亭二首 二",
      "content": [
        "偶到乌衣巷，含情更惘然。",
        "西州曲堤柳，东府旧池莲。",
        "星坼悲元老，云归送墨仙。",
        "谁知济川檝，今作野人船。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280528,
      "title": "早秋山居",
      "content": [
        "山近觉寒早，草堂霜气晴。",
        "树凋窗有日，池满水无声。",
        "果落见猿过，叶干闻鹿行。",
        "素琴机虑静，空伴夜泉清。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280529,
      "title": "和友人盘石寺逢旧友",
      "content": [
        "楚寺上方宿，满堂皆旧游。",
        "月溪逢远客，烟浪有归舟。",
        "江馆白苹夜，水关红叶秋。",
        "西风吹暮雨，汀草更堪愁。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280530,
      "title": "送人南游",
      "content": [
        "送君游楚国，江浦树苍然。",
        "沙净有波迹，岸平多草烟。",
        "角悲临海郡，月到渡淮船。",
        "唯以一桮酒，相思高楚天。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280531,
      "title": "赠郑处士",
      "content": [
        "飘然随钓艇，云水是天涯。",
        "红叶下荒井，碧梧侵古槎。",
        "醉收陶令菊，贫卖邵平瓜。",
        "更有相期处，南篱一树花。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280532,
      "title": "江岸即事",
      "content": [
        "水容侵古岸，峰影度青苹。",
        "庙竹唯闻鸟，江帆不见人。",
        "雀声花外暝，客思柳边春。",
        "别恨转难尽，行行汀草新。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280533,
      "title": "赠隐者",
      "content": [
        "茅堂对薇蕨，炉暧一裘轻。",
        "醉后楚山梦，觉来春鸟声。",
        "采茶溪树绿，煮药石泉清。",
        "不问人间事，忘机过此生。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280534,
      "title": "渚宫晚春寄秦地友人",
      "content": [
        "风华已眇然，独立思江天。",
        "凫鴈野塘水，牛羊春草烟。",
        "秦原晓重叠，灞浪夜潺湲。",
        "今日思归客，愁容在镜悬。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280535,
      "title": "碧涧驿晓思",
      "content": [
        "香灯伴残梦，楚国在天涯。",
        "月落子规歇，满庭山杏花。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 280536,
      "title": "送幷州郭书记",
      "content": [
        "宾筵得佳客，侯印有光辉。",
        "候骑不传箭，回文空上机。",
        "塞城收马去，烽火射雕归。",
        "惟有严家濑，回环迳草微。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280537,
      "title": "赠越僧岳云二首 一",
      "content": [
        "世机消已尽，巾屦亦飘然。",
        "一室故山月，满瓶秋涧泉。",
        "禅庵过微雪，乡寺隔寒烟。",
        "应共白莲客，相期松桂前。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280538,
      "title": "赠越僧岳云二首 二",
      "content": [
        "兰亭旧都讲，今日意如何。",
        "有树关深院，无尘到浅莎。",
        "僧居随处好，人事出门多。",
        "不及新春雁，年年镜水波。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280539,
      "title": "咏山鸡",
      "content": [
        "万壑动晴景，山禽凌翠微。",
        "绣翎翻草去，红觜啄花归。",
        "巢暖碧云色，影孤清镜辉。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 280540,
      "title": "清旦题采药翁草堂",
      "content": [
        "幽人寻药迳，来自晓云边。",
        "衣湿术花雨，语成松岭烟。",
        "解藤开涧户，踏石过溪泉。",
        "林外晨光动，山昏鸟满天。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280541,
      "title": "商山早行",
      "content": [
        "晨起动征铎，客行悲故乡。",
        "鸡声茅店月，人迹板桥霜。",
        "槲叶落山路，枳花明驿墙。",
        "因思杜陵梦，凫雁满回塘。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280542,
      "title": "题竹谷神祠",
      "content": [
        "苍苍松竹晚，一迳入荒祠。",
        "古树风吹马，虚廊日照旗。",
        "烟煤朝奠处，风雨夜归时。",
        "寂寞东湖客，空看蒋帝碑。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280543,
      "title": "途中有怀",
      "content": [
        "驱车何日闲，扰扰路岐间。",
        "岁暮自多感，客程殊未还。",
        "亭臯汝阳道，风雪穆陵关。",
        "腊后寒梅发，谁人在故山。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280544,
      "title": "经李处士杜城别业",
      "content": [
        "忆昔几游集，今来倍叹伤。",
        "百花情易老，一笑事难忘。",
        "白社已萧索，青楼空艳阳。",
        "不闲云雨梦，犹欲过高唐。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280545,
      "title": "登李羽士东楼",
      "content": [
        "经客有余音，他年终故林。",
        "高楼本危睇，凉月更伤心。",
        "此意竟难折，伊人成古今。",
        "流尘其可欲，非复嬾鸣琴。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280546,
      "title": "题僧泰恭院二首 一",
      "content": [
        "昔岁东林下，深公识姓名。",
        "尔来辞半偈，空复叹劳生。",
        "忧患慕禅味，寂寥遗世情。",
        "所归心自得，何事倦尘缨。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280547,
      "title": "题僧泰恭院二首 二",
      "content": [
        "微生竟劳止，晤言犹是非。",
        "出门还有泪，看竹暂忘机。",
        "爽气三秋近，浮生一笑稀。",
        "故山松菊在，终欲掩荆扉。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280548,
      "title": "西游书怀",
      "content": [
        "渭川通野戍，有路上桑干。",
        "独鸟青天暮，惊麏赤烧残。",
        "高秋辞故国，昨日梦长安。",
        "客意自如此，非关行路难。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280549,
      "title": "送人东游",
      "content": [
        "荒戍落黄叶，浩然离故关。",
        "高风汉阳渡，初日郢门山。",
        "江上几人在，天涯孤櫂还。",
        "何当重相见，尊酒慰离颜。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280550,
      "title": "寄山中友人",
      "content": [
        "惟昔有归趣，今兹固愿言。",
        "啸歌成往事，风雨坐凉轩。",
        "时物信佳节，岁华非故园。",
        "固知春草色，何意为王孙。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280551,
      "title": "偶题",
      "content": [
        "孔雀眠高阁，樱桃拂短簷。",
        "画明金冉冉，筝语玉纤纤。",
        "细雨无妨烛，轻寒不隔帘。",
        "欲将红锦段，因梦寄江淹。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280552,
      "title": "赠考功卢郎中",
      "content": [
        "白首方辞满，荆扉对渚田。",
        "雪中无陋巷，醉后似当年。",
        "一笈负山药，两瓶携涧泉。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 280553,
      "title": "题萧山庙",
      "content": [
        "故道木阴浓，荒祠山影东。",
        "杉松一庭雨，幡盖满堂风。",
        "客奠晓莎湿，马嘶秋庙空。",
        "夜深池上歇，龙入古潭中。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280554,
      "title": "春日寄岳州从事李员外二首 一",
      "content": [
        "苒弱楼前柳，轻空花外窗。",
        "蝶高飞有伴，莺早语无双。",
        "剪胜裁春字，开屏见晓江。",
        "从来共情战，今日欲归降。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280555,
      "title": "春日寄岳州从事李员外二首 二",
      "content": [
        "从小识宾卿，恩深若弟兄。",
        "相逢在何日，此别不胜情。",
        "红粉座中客，彩斿江上城。",
        "尚平婚嫁累，无路逐双旌。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280556,
      "title": "和段少常柯古",
      "content": [
        "称觞慙座客，怀刺即门人。",
        "素向宁知贵，清淡不厌贫。",
        "野梅江上晚，堤柳雨中春。",
        "未报淮南诏，何劳问白苹。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280557,
      "title": "海榴",
      "content": [
        "海榴开似火，先解报春风。",
        "叶乱裁牋绿，花宜插鬓红。",
        "蜡珠攒作蔕，缃彩剪成丛。",
        "郑驿多归思，相期一笑同。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280558,
      "title": "李先生别墅望僧舍宝刹因作双韵声",
      "content": [
        "栖息消心象，簷楹溢艳阳。",
        "帘栊兰露落，邻里柳林凉。",
        "高阁过空谷，孤竿隔古冈。",
        "潭庐同淡荡，髣髴复芬芳。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280559,
      "title": "敷水小桃盛开因作",
      "content": [
        "敷水小桥东，娟娟照露丛。",
        "所嗟非胜地，堪恨是春风。",
        "二月艳阳节，一枝惆怅红。",
        "定知留不住，吹落路尘中。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280560,
      "title": "寄山中人",
      "content": [
        "月中一双鹤，石上千尺松。",
        "素琴入爽籁，山酒和春容。",
        "幽瀑有时断，片云无所从。",
        "何事苏门生，携手东南峰。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280561,
      "title": "送淮阴孙令之官",
      "content": [
        "隋堤杨柳烟，孤櫂正悠然。",
        "萧寺通淮戍，芜城枕楚壖。",
        "鱼盐桥上市，灯火雨中船。",
        "故老青葭岸，先知虙子贤。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280562,
      "title": "宿辉公精舍",
      "content": [
        "禅房无外物，清话此宵同。",
        "林彩水烟里，涧声[山]月中。",
        "橡霜诸壑霁，杉火一炉空。",
        "拥褐寒更彻，心知觉路通。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280563,
      "title": "旅泊新津却寄一二知己",
      "content": [
        "维舟息行役，霁景近江村。",
        "并起别离恨，似闻歌吹喧。",
        "高林月初上，远水雾犹昏。",
        "王粲平生感，登临几断魂。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280564,
      "title": "赠僧云栖",
      "content": [
        "麈尾与筇杖，几年离石坛。",
        "梵余林雪厚，棋罢岳钟残。",
        "开卷喜先悟，漱缾知早寒。",
        "衡阳寺前雁，今日到长安。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280565,
      "title": "雪夜与友生同宿晓寄近邻",
      "content": [
        "闭门群动息，积雪透疎林。",
        "有客寒方觉，无声晓已深。",
        "正繁闻近雁，并落起栖禽。",
        "寂寞寒塘路，怜君独阻寻。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280566,
      "title": "题造微禅师院",
      "content": [
        "夜香闻偈后，岑寂掩双扉。",
        "照竹灯和雪，看松月到衣。",
        "草堂疎磬断，江寺故人稀。",
        "唯忆湘南雨，春风独鸟归。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280567,
      "title": "正见寺晓别生公",
      "content": [
        "清晓盥秋水，高窗留夕阴。",
        "初阳到古寺，宿鸟起寒林。",
        "香火有良愿，宦名非素心。",
        "灵山缘未绝，他日重来寻。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280568,
      "title": "旅次盱眙县",
      "content": [
        "离离麦擢芒，楚客意偏伤。",
        "波上旅愁起，天边归路长。",
        "孤桡投楚驿，残月在淮樯。",
        "外杜三千里，谁人数雁行。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280569,
      "title": "鄠郊别墅寄所知",
      "content": [
        "持颐望平绿，万景集所思。",
        "南塘遇新雨，百草生容姿。",
        "幽鸟不相识，美人如何期。",
        "徒然委摇荡，惆怅春风时。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280570,
      "title": "京兆公池上作",
      "content": [
        "稻香山色叠，平野接荒陂。",
        "莲折舟行远，萍多钓下迟。",
        "坏堤泉落处，凉簟雨来时。",
        "京口兵堪用，何因入梦思。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280571,
      "title": "卢氏池上遇雨赠同游者",
      "content": [
        "簟翻凉气集，溪上润残棋。",
        "萍皱风来后，荷喧雨到时。",
        "寂寥闲望久，飘洒独归迟。",
        "无限松江恨，烦君解钓丝。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280572,
      "title": "题薛昌之所居",
      "content": [
        "所得乃清旷，寂寥常掩关。",
        "独来春尚在，相得暮方还。",
        "花白风露晚，柳青街陌闲。",
        "翠微应有雪，窗外见南山。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280573,
      "title": "东归有怀",
      "content": [
        "晴川通野陂，此地昔伤离。",
        "一去迹常在，独来心自知。",
        "鹭眠茭叶折，鱼静蓼花垂。",
        "无限高秋泪，扁舟极路岐。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280574,
      "title": "休澣日西掖谒所知",
      "content": [
        "赤墀高阁自从容，玉女窗扉报曙钟。",
        "日丽九门青锁闼，雨晴双阙翠微峰。",
        "毫端蕙露滋仙草，琴上薰风入禁松。",
        "荀令凤池春婉娩，好将余润变鱼龙。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 280575,
      "title": "博山",
      "content": [
        "博山香重欲成云，锦段机丝妬鄂君。",
        "粉蝶团飞花转影，彩鸳双泳水生纹。",
        "青楼二月春将半，碧瓦千家日未曛。",
        "见说杨朱无限泪，岂能空为路岐分。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 280576,
      "title": "送卢处士游吴越",
      "content": [
        "羡君东去见残梅，唯有王孙独未廻。",
        "吴苑夕阳明古堞，越宫春草上高台。",
        "波生野水雁初下，风满驿楼潮欲来。",
        "试逐渔舟看雪浪，几多江燕荇花开。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 280577,
      "title": "过新丰",
      "content": [
        "一劒乘时帝业成，沛中乡里到咸京。",
        "寰区已作皇居贵，风月犹含白社情。",
        "泗水旧亭春草徧，千门遗瓦古苔生。",
        "至今留得离家恨，鸡犬相闻落照明。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 280578,
      "title": "过潼关",
      "content": [
        "地形盘屈带河流，景气澄明是胜游。",
        "十里晓鸡关树暗，一行寒雁陇云愁。",
        "片时无事溪泉好，尽日凝眸岳色秋。",
        "麈尾角巾应旷望，更嗟芳霭隔秦楼。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 280579,
      "title": "题西平王旧赐屏风",
      "content": [
        "曾向金扉玉砌来，百花鲜湿隔尘埃。",
        "披香殿下樱桃熟，结绮楼前芍药开。",
        "朱鹭已随新卤簿，黄鹂犹湿旧池台。",
        "世间刚有东流水，一送恩波更不廻。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 280580,
      "title": "河中陪帅游亭",
      "content": [
        "倚阑愁立独徘徊，欲赋慙非宋玉才。",
        "满座山光摇劒戟，绕城波色动楼台。",
        "鸟飞天外斜阳尽，人过桥心倒影来。",
        "添得五湖多少恨，柳花飘荡似寒梅。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 280581,
      "title": "和赵嘏题岳寺",
      "content": [
        "疎钟细响乱鸣泉，客省高临似水天。",
        "岚翠暗来空觉润，涧茶余爽不成眠。",
        "越僧寒立孤灯外，岳月秋当万木前。",
        "张邴宦情何太薄，远公窗外有池莲。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 280582,
      "title": "苏武庙",
      "content": [
        "苏武魂销汉使前，古祠高树两茫然。",
        "云边雁断胡天月，陇上羊归塞草烟。",
        "廻日楼台非甲帐，去时冠劒是丁年。",
        "茂陵不见封侯印，空向秋波哭逝川。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 280583,
      "title": "送客偶作",
      "content": [
        "石路荒凉接野蒿，西风吹马利如刀。",
        "小桥连驿杨柳晚，废寺入门禾黍高。",
        "鸡犬夕阳喧县市，凫鹥秋水曝城壕。",
        "故山有梦不归去，官树陌尘何太劳。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 280584,
      "title": "寒食前有怀",
      "content": [
        "万物鲜华雨乍晴，春寒寂历近清明。",
        "残芳荏苒双飞蝶，晓睡朦胧百啭莺。",
        "旧侣不归成独酌，故园虽在有谁耕。",
        "悠然更起严滩恨，一宿东风蕙草生。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 280585,
      "title": "宿云际寺",
      "content": [
        "白盖微云一迳深，东峰弟子远相寻。",
        "苍苔路熟僧归寺，红叶声干鹿在林。",
        "高阁清香生静境，夜堂疎磬发禅心。",
        "自从紫桂岩前别，不见南能直至今。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 280586,
      "title": "寄岳州李外郎远",
      "content": [
        "含嚬不语坐持颐，天远楼高宋玉悲。",
        "湖上残棋人散后，岳阳微雨鸟来迟。",
        "早梅犹得廻歌扇，春水还应理钓丝。",
        "独有袁宏正憔悴，一罇惆怅落花时。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 280587,
      "title": "游南塘寄知者",
      "content": [
        "白鸟梳翎立岸莎，藻花菱刺泛微波。",
        "烟光似带侵垂柳，露点如珠落卷荷。",
        "楚水晓凉催客早，杜陵秋思傍蝉多。",
        "镏公不信归心切，听取江楼一曲歌。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 280588,
      "title": "寄卢生",
      "content": [
        "遗业荒凉近故都，门前堤路枕平湖。",
        "绿杨阴里千家月，红藕香中万点珠。",
        "此地别来双鬓改，几时归去片帆孤。",
        "他年犹拟金貂换，寄语黄公旧酒垆。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 280589,
      "title": "春日访李十四处士",
      "content": [
        "花深桥转水潺潺，甪里先生自闭关。",
        "看竹已知行处好，望云空得暂时闲。",
        "谁言有策堪经世，自是无钱可买山。",
        "一局残棋千点雨，绿萍池上暮方还。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 280590,
      "title": "宿松门寺",
      "content": [
        "白石青崖世界分，卷帘孤坐对氛氲。",
        "林间禅室春深雪，潭上龙堂夜半云。",
        "落月苍凉登阁在，晓钟摇荡隔江闻。",
        "西山旧是经行地，愿漱寒缾逐领军。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 280591,
      "title": "咏寒宵",
      "content": [
        "寒宵何耿耿，良䜩有余姿。",
        "宝靺徘徊处，熏𬬻怅望时。",
        "曲琼垂翡翠，斜月到罘罳。",
        "委坠金釭烬，阑珊玉局棋。",
        "话穷犹注睇，歌罢尚持颐。",
        "晻暖遥相属，氛氲积所思。",
        "秦蛾卷衣晚，胡雁度云迟。",
        "上郡归来梦，那知锦字诗。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 280592,
      "title": "寄渚宫遗民弘里生",
      "content": [
        "柳弱湖堤曲，篱疎水巷深。",
        "酒阑初促席，歌罢欲分襟。",
        "波月欺华烛，汀云润故琴。",
        "镜清花并蔕，床冷簟连心。",
        "荷叠平桥暗，萍稀败舫沈。",
        "城头五通鼓，窗外万家砧。",
        "异县鱼投浪，当年鸟共林。",
        "八行香未灭，千里梦难寻。",
        "未肯暌良愿，空期嗣好音。",
        "他时因咏作，犹得比南金。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 280593,
      "title": "春尽与友人入裴氏林探渔竿",
      "content": [
        "一迳互纡直，茅棘亦已繁。",
        "晴阳入荒竹，暧暧如春园。",
        "倚杖息惭倦，徘徊恋微暄。",
        "历寻婵娟节，翦破苍筤根。",
        "地闭修茎孤，林振余箨翻。",
        "适心在所好，非必寻湘沅。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 280594,
      "title": "春日",
      "content": [
        "问君何所思，迢递艳阳时。",
        "门静人归晚，墙高蝶过迟。",
        "一双青琐燕，千万绿杨丝。",
        "屏上吴山远，楼中朔管悲。",
        "宝书无寄处，香毂有来期。",
        "草色将林彩，相添入黛眉。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 280595,
      "title": "洛阳",
      "content": [
        "巩树先春雪满枝，上阳宫柳啭黄鹂。",
        "桓谭未便忘西笑，岂为长安有凤池。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 280596,
      "title": "题贺知章故居叠韵作",
      "content": [
        "废砌翳薜荔，枯湖无菰蒲。",
        "老媪饱藁草，愚儒输逋租。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 280597,
      "title": "雨中与李先生期垂钓先后相失因作叠韵",
      "content": [
        "隔石觅屐迹，西溪迷鸡啼。",
        "小鸟扰晓沼，犂泥齐低畦。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 280598,
      "title": "春日雨",
      "content": [
        "细雨蒙蒙入绛纱，湖亭寒食孟珠家。",
        "南朝漫自称流品，宫体何曾为杏花。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 280599,
      "title": "细雨",
      "content": [
        "凭轩望秋雨，凉入暑衣清。",
        "极目鸟频没，片时云复轻。",
        "沼萍开更歛，山叶动还鸣。",
        "楚客秋江上，萧萧故国情。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280600,
      "title": "秋雨",
      "content": [
        "云满鸟行灭，池凉龙气腥。",
        "斜飘看棋簟，疎洒望山亭。",
        "细响鸣林叶，圆文破沼萍。",
        "秋阴杳无际，平野但冥冥。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280601,
      "title": "春初对暮雨",
      "content": [
        "淅沥生丛筿，空蒙泫网轩。",
        "暝姿看远树，春意入尘根。",
        "点细飘风急，声轻入夜繁。",
        "雀喧争槿树，人静出蔬园。",
        "瓦湿光先起，房深影易昏。",
        "不应江上草，相与滞王孙。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 280602,
      "title": "雪二首 一",
      "content": [
        "砚水池先冻，窗风酒易消。",
        "鸦声出山郭，人迹过村桥。",
        "稍急方萦转，才深未寂寥。",
        "细光穿暗隟，轻白驻寒条。",
        "草静封还折，松攲堕复摇。",
        "谢庄今病眼，无意坐通宵。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 280603,
      "title": "雪二首 二",
      "content": [
        "羸骖出更慵，林寺已疎钟。",
        "踏紧寒声涩，飞交细点重。",
        "圃斜人过迹，皆静鸟行踪。",
        "寂寞梁鸿病，谁人代夜舂。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280604,
      "title": "送人游淮海",
      "content": [
        "背樯灯色暗，宿客梦初成。",
        "半夜竹窗雨，满池荷叶声。",
        "簟凉秋合思，木落故山情。",
        "明发又愁起，桂花溪水清。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280605,
      "title": "原隰荑绿柳",
      "content": [
        "逈野韶光早，晴川柳满堤。",
        "拂尘生嫩绿，披雪见柔荑。",
        "碧玉牙犹短，黄金缕未齐。",
        "腰肢弄寒吹，眉意入春闺。",
        "预恐狂夫折，迎牵逸客迷。",
        "新莺将出谷，应借一枝栖。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 280606,
      "title": "宿秦生山斋",
      "content": [
        "衡巫路不同，结室在东峰。",
        "岁晚得支遁，夜寒逢戴颙。",
        "龛灯落叶寺，山雪隔林钟。",
        "行解无由发，曹溪欲施舂。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280607,
      "title": "赠楚云上人",
      "content": [
        "松根满苔石，尽日闭禅关。",
        "有伴年年月，无家处处山。",
        "烟波五湖远，瓶屦一身闲。",
        "岳寺蕙兰晚，几时幽鸟还。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280608,
      "title": "宿白盖峰寺寄僧",
      "content": [
        "山房霜气晴，一宿遂平生。",
        "合上见林影，月中闻涧声。",
        "佛灯销永夜，僧磬彻寒更。",
        "不学何居士，焚香为宦情。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    }
  ],
