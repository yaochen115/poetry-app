{
  "data": [
    {
      "id": 299308,
      "title": "初达驩州",
      "content": [
        "自昔闻铜柱，行来向一年。",
        "不知林邑地，犹隔道明天。",
        "雨露何时及？",
        "京华若个边。",
        "思君无限泪，堪作日南泉。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 299309,
      "title": "岭表逢寒食",
      "content": [
        "岭外无寒食，春来不见饧。",
        "洛阳新甲子，何日是清明？",
        "花柳争朝发，轩车满路迎。",
        "帝乡遥可念，肠断报亲情。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 299310,
      "title": "驩州南亭夜望",
      "content": [
        "昨夜南亭望，分明梦洛中。",
        "室家谁道别，儿女案尝同。",
        "忽觉犹言是，沈思始悟空。",
        "肝肠余几寸，拭泪坐春风。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 299311,
      "title": "少游荆湘因有是题",
      "content": [
        "岘北焚蛟浦，巴东射雉田。",
        "岁时宜楚俗，耆旧在襄川。",
        "忆昨经过处，离今二十年。",
        "因君访生死，相识几人全。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 299312,
      "title": "咸阳览古",
      "content": [
        "咸阳秦帝居，千载坐盈虚。",
        "版筑林光尽，坛场霤听疎。",
        "野桥疑望日，山火类焚书。",
        "唯有骊峰在，空闻厚葬余。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 299313,
      "title": "览镜",
      "content": [
        "霏霏日摇蕙，骚骚风洒莲。",
        "时芳固相夺，俗态岂恒坚。",
        "恍忽夜川里，蹉跎朝镜前。",
        "红颜与壮志，太息此流年。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 299314,
      "title": "题椰子树",
      "content": [
        "日南椰子树，香褭出风尘。",
        "丛生调木首，圆实槟榔身。",
        "玉房九霄露，碧叶四时春。",
        "不及涂林果，移根随汉臣。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 299315,
      "title": "同狱者叹狱中无燕",
      "content": [
        "何许乘春燕，多知辨夏台。",
        "三时欲并尽，双影未尝来。",
        "食蕋嫌丛棘，衔泥怯死灰。",
        "不如黄雀语，能雪冶长猜。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 299316,
      "title": "则天门赦改年",
      "content": [
        "圣人宥天下，幽钥动圜狴。",
        "六甲迎黄气，三元降紫泥。",
        "笼僮上西鼓，振迅广阳鸡。",
        "歌舞将金帛，汪洋被远黎。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 299317,
      "title": "喜赦",
      "content": [
        "去岁投荒客，今春肆眚归。",
        "律通幽谷暖，盆举太阳辉。",
        "喜气迎冤气，青衣报白衣。",
        "还将合浦叶，俱向洛城飞。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 299318,
      "title": "秦州薛都督挽词",
      "content": [
        "十里绛山幽，千年汾水流。",
        "碑传门客建，劒是故人留。",
        "陇树烟含夕，山门月对秋。",
        "古来钟鼎盛，共尽一蒿丘。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 299319,
      "title": "天官崔侍郎夫人卢氏挽歌",
      "content": [
        "偕老言何谬，香魂事永违。",
        "潘鱼从此隔，陈凤宛然飞。",
        "埋镜泉中暗，藏镫地下微。",
        "犹凭少君术，仿佛覩容辉。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 299320,
      "title": "章怀太子靖妃挽词",
      "content": [
        "彤史佳声载，青宫懿范留。",
        "形将鸾镜隐，魂伴凤笙游。",
        "送马嘶残日，新萤落晚秋。",
        "不知蒿里曙，空见陇云愁。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 299321,
      "title": "奉和立春游苑迎春",
      "content": [
        "东郊暂转迎春仗，上苑初飞行庆杯。",
        "风射蛟冰千片断，气冲鱼钥九关开。",
        "林中觅草才生蕙，殿里争花并是梅。",
        "歌吹衔恩归路晚，栖乌半下凤城来。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 299322,
      "title": "人日重宴大明宫赐彩缕人胜应制",
      "content": [
        "拂旦鸡鸣仙衞陈，凭高龙首帝城春。",
        "千官黼帐杯前寿，百福香匳胜里人。",
        "山鸟初来犹怯啭，林花未发已偷新。",
        "天文正应韶光转，设报悬知用此辰。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 299323,
      "title": "奉和春初幸太平公主南庄应制",
      "content": [
        "主家山第早春归，御辇春游绕翠微。",
        "买地铺金曾作埒，寻河取石旧支机。",
        "云间树色千花满，竹里泉声百道飞。",
        "自有神仙鸣凤曲，并将歌舞报恩晖。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 299324,
      "title": "奉和春日幸望春宫应制",
      "content": [
        "芳郊绿野散春晴，复道离宫烟雾生。",
        "杨柳千条花欲绽，蒲萄百丈蔓初萦。",
        "林香酒气元相入，鸟啭歌声各自成。",
        "定是风光牵宿醉，来晨复得幸昆明。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 299325,
      "title": "侍宴安乐公主新宅应制",
      "content": [
        "皇家贵主好神仙，别业初开云汉边。",
        "山出尽如鸣凤岭，池成不让饮龙川。",
        "妆楼翠幌教春住，舞阁金铺借日悬。",
        "敬从乘舆来此地，称觞献寿乐钧天。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 299326,
      "title": "龙池篇",
      "content": [
        "龙池跃龙龙已飞，龙德先天天不违。",
        "池开天汉分黄道，龙向天门入紫微。",
        "邸第楼台多气色，君王凫雁有光辉。",
        "为报寰中百川水，来朝此地莫东归。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 299327,
      "title": "兴庆池侍宴应制",
      "content": [
        "碧水澄潭暎远空，紫云香驾御微风。",
        "汉家城阙疑天上，秦地山川似镜中。",
        "向浦回舟萍已绿，分林蔽殿槿初红。",
        "古来徒羡横汾赏，今日宸游圣藻雄。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 299328,
      "title": "从幸香山寺应制",
      "content": [
        "南山奕奕通丹禁，北阙峨峨连翠云。",
        "岭上楼台千地起，城中钟鼓四天闻。",
        "旃檀晓阁金舆度，鹦鹉晴林采眊分。",
        "愿以醍醐参圣酒，还将[衹]苑当秋汾。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 299329,
      "title": "红楼院应制",
      "content": [
        "红楼疑见白毫光，寺逼宸居福盛唐。",
        "支遁爱山情谩切，昙摩泛海路空长。",
        "经声夜息闻天语，炉气晨飘接御香。",
        "谁谓此中难可到，自怜深院得徊翔。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 299330,
      "title": "再入道场纪事应制",
      "content": [
        "南方归去再生天，内殿今年异昔年。",
        "见辟乾坤新定位，看题日月更高悬。",
        "行随香辇登仙路，坐近炉烟讲法筵。",
        "自喜恩深陪侍从，两朝长在圣人前。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 299331,
      "title": "嵩山石淙侍宴应制",
      "content": [
        "金舆旦下绿云衢，彩殿晴临碧涧隅。",
        "溪水泠泠杂行漏，山烟片片绕香炉。",
        "仙人六膳调神鼎，玉女三浆捧帝壶。",
        "自惜汾阳纡道驾，无如太室览真图。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 299332,
      "title": "古意呈补阙乔知之",
      "content": [
        "卢家少妇郁金堂，海燕双栖玳瑁梁。",
        "九月寒砧催木叶，十年征戍忆辽阳。",
        "白狼河北音书断，丹凤城南秋夜长。",
        "谁谓含愁独不见，更教明月照流黄。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 299333,
      "title": "遥同杜员外审言过岭",
      "content": [
        "天长地阔岭头分，去国离家见白云。",
        "洛浦风光何所似，崇山瘴疠不堪闻。",
        "南浮涨海人何处？",
        "北望衡阳雁几群。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 299334,
      "title": "和上巳连寒食有怀京洛",
      "content": [
        "天津御柳碧遥遥，轩骑相从半下朝。",
        "行乐光辉寒食借，太平歌舞晚春饶。",
        "红妆楼下东回辇，青草洲边南渡桥。",
        "坐见司空扫西第，看君侍从落花朝。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 299335,
      "title": "陪幸太平公主南庄诗",
      "content": [
        "主第山门起灞川，宸游风景入初年。",
        "凤皇楼下交天仗，乌鹊桥头敞御筵。",
        "往往花间逢彩石，时时竹里见红泉。",
        "今朝扈跸平阳馆，不羡乘槎云汉边。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 299336,
      "title": "守岁应制",
      "content": [
        "南渡轻冰解渭桥，东方树色起招摇。",
        "天子迎春取今夜，王公献寿用明朝。",
        "殿上灯人争烈火，宫中侲子乱驱妖。",
        "宜将岁酒调神药，圣祚千春万国朝。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 299337,
      "title": "陪幸韦嗣立山庄",
      "content": [
        "台阶好赤松，别业对青峰。",
        "茆室承三顾，花源接九重。",
        "虹旗萦秀木，凤辇拂疎筇。",
        "迳直千官拥，溪长万骑容。",
        "水堂开禹膳，山阁献尧钟。",
        "皇鉴清居远，天文睿奖浓。",
        "岩泉他夕梦，渔钓往年逢。",
        "共荣丞相府，偏降逸人封。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 299338,
      "title": "扈从出长安应制",
      "content": [
        "汉宅规模壮，周都景命隆。",
        "西宾让东主，法驾幸天中。",
        "太史占星应，春官奏日同。",
        "旌门起长乐，帐殿出新丰。",
        "翕习黄山下，纡徐清渭东。",
        "金麾张画月，珠幰戴松风。",
        "是节严阴始，寒郊散野蓬。",
        "薄霜沾上路，残雪绕离宫。",
        "赐帛矜耆老，褰旒问小童。",
        "复除恩载洽，望秩礼新崇。",
        "臣忝承明召，多慙献赋雄。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 299339,
      "title": "初冬从幸汉故青门应制",
      "content": [
        "汉王建都邑，渭水对青门。",
        "朝市俱东逝，坟陵共北原。",
        "荒凉萧相阙，芜没邵平园。",
        "全盛今何在，英雄难重论。",
        "故基仍岳立，遗堞尚云屯。",
        "当极土功壮，安知人力烦。",
        "天游戒东首，怀昔驻龙轩。",
        "何必金汤固，无如道德藩。",
        "微臣谅多幸，参乘偶殊恩。",
        "预此陈古事，敢奏兴亡言。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 299340,
      "title": "昆明池侍宴应制",
      "content": [
        "武帝伐昆明，穿池习五兵。",
        "水同河汉在，馆有豫章名。",
        "我后光天德，垂衣文教成。",
        "黩兵非帝念，劳物岂皇情。",
        "春仗过鲸沼，云旗出凤城。",
        "灵鱼衔宝跃，仙女废机迎。",
        "柳拂旌门暗，兰依帐殿生。",
        "还如流水曲，日晚棹歌清。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 299341,
      "title": "白莲花亭侍宴应制",
      "content": [
        "九日陪天仗，三秋幸禁林。",
        "霜威变绿树，云气落青岑。",
        "水殿黄花合，山亭绛叶深。",
        "朱旗夹小径，宝马驻清浔。",
        "苑吏收寒果，饔人膳野禽。",
        "承欢不觉暝，遥响素秋砧。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 299342,
      "title": "仙萼池亭侍宴应制",
      "content": [
        "步辇寻丹嶂，行宫在翠微。",
        "川长看鸟灭，谷转听猿稀。",
        "天磴扶阶迥，云泉透户飞。",
        "闲花开石竹，幽叶吐蔷薇。",
        "径狭难留骑，亭寒欲进衣。",
        "白龟来献寿，仙吹返彤闱。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 299343,
      "title": "奉和晦日驾幸昆明池应制",
      "content": [
        "法驾乘春转，神池象汉廻。",
        "双星移旧石，孤月隐残灰。",
        "战鹢逢时去，恩鱼望幸来。",
        "山花缇骑绕，堤柳幔城开。",
        "思逸横汾唱，欢留宴镐杯。",
        "微臣雕朽质，羞覩豫章材。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 299344,
      "title": "奉和圣制幸礼部尚书窦希玠宅",
      "content": [
        "北阙垂旒暇，南宫听履廻。",
        "天临翔凤转，恩向跃龙开。",
        "兰气薰仙帐，榴花引御杯。",
        "水从金穴吐，云是玉衣来。",
        "池影摇歌席，林香散舞台。",
        "不知行漏晚，清跸尚裴徊。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 299345,
      "title": "钓竿篇",
      "content": [
        "朝日敛红烟，垂竿向绿川。",
        "人疑天上坐，鱼似镜中悬。",
        "避檝时惊透，猜钩每误牵。",
        "湍危不理辖，潭静欲留船。",
        "钓玉君徒尚，征金我未贤。",
        "为看芳饵下，贪得会无筌。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 299346,
      "title": "和户部岑尚书参迹枢揆",
      "content": [
        "大君制六合，良佐参万机。",
        "大业永开泰，臣道日光辉。",
        "盐梅和鼎食，家声众所归。",
        "汉章题楚劒，郑武袭缁衣。",
        "理识当朝远，文华振古希。",
        "风云神契合，舟檝道心微。",
        "庙堂喜容与，时物逓芳菲。",
        "御柳垂仙掖，公槐覆礼闱。",
        "昔陪鹓鹭后，今望鹍鹏飞。",
        "徒御清风颂，巴歌聊自挥。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 299347,
      "title": "同李舍人冬日集安乐公主山池",
      "content": [
        "尝闻天女贵，家即帝宫连。",
        "亭插宜春果，山冲太液泉。",
        "桥低乌鹊夜，台起凤皇年。",
        "故事犹如此，新图更可怜。",
        "紫岩妆阁透，青嶂妓楼悬。",
        "峰夺香炉巧，池偷明镜圆。",
        "梅花寒待雪，桂叶晚留烟。",
        "兴尽方投辖，金声还复传。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 299348,
      "title": "酬苏员外味道夏晚寓直省中见赠",
      "content": [
        "并命登仙阁，分曹直礼闱。",
        "大官供宿膳，侍史护朝衣。",
        "卷幔天河入，开窗月露微。",
        "小池残暑退，高树早凉归。",
        "冠劒无时释，轩车待漏飞。",
        "明朝题汉柱，三署有光辉。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 299349,
      "title": "和韦舍人早朝",
      "content": [
        "阊阖连云起，岩廊拂雾开。",
        "玉珂龙影度，珠履雁行来。",
        "长乐宵钟尽，明光晓奏催。",
        "一经推旧德，五字擢英才。",
        "俨若神仙去，纷从霄汉廻。",
        "千春奉休历，分禁喜趋陪。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 299350,
      "title": "自考功员外授给事中",
      "content": [
        "南省推丹地，东曹拜琐闱。",
        "惠移双管笔，恩降五时衣。",
        "出入宜真选，遭逢每滥飞。",
        "器慙公理拙，才谢子云微。",
        "案牍遗常礼，朋僚隔等威。",
        "上台行揖让，中禁动光辉。",
        "旭日千门起，初春八舍归。",
        "赠兰闻宿昔，谈树隐芳菲。",
        "何幸盐梅处，唯忧对问机。",
        "省躬知任重，宁止冒荣非。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 299351,
      "title": "和元舍人万顷临池翫月戏为新体",
      "content": [
        "春风摇碧树，秋雾卷丹台。",
        "复有相宜夕，池清月正开。",
        "玉流含吹动，金魄度云来。",
        "熠爚光如沸，翩翾景若摧。",
        "半环投积草，碎璧聚流杯。",
        "夜久平无焕，天晴皎未隤。",
        "镜将池作匣，珠以岸为胎。",
        "有美司言暇，高兴独悠哉。",
        "挥翰初难拟，飞名岂易陪。",
        "夜光殊在握，了了见沈灰。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 299352,
      "title": "酬杨给事兼见赠台中",
      "content": [
        "子云推辨博，公理擅词雄。",
        "始自尚书省，旋闻给事中。",
        "言从温室秘，籍向琐闱通。",
        "顾我叨郎署，慙无草奏功。",
        "分曹八舍断，解袂五时空。",
        "宿昔陪余论，平生赖击蒙。",
        "神仙应东掖，云雾限南宫。",
        "忽枉琼瑶赠，长歌兰渚风。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 299353,
      "title": "九真山净居寺谒无碍上人",
      "content": [
        "大士生天竺，分身化日南。",
        "人中出烦恼，山下即伽蓝。",
        "小涧香为刹，危峰石作龛。",
        "候禅青鸽乳，窥讲白猿参。",
        "藤爱云间壁，花怜石下潭。",
        "泉行幽供好，林挂浴衣堪。",
        "弟子哀无识，医王惜未谈。",
        "机疑闻不二，蒙昧即朝三。",
        "欲究因缘理，聊宽放弃慙。",
        "超然虎溪夕，双树下虚岚。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 299354,
      "title": "夜游",
      "content": [
        "今夕重门启，游春得夜芳。",
        "月华连昼色，灯影杂星光。",
        "南陌青丝骑，东邻红粉妆。",
        "管弦遥辨曲，罗绮暗闻香。",
        "人拥行歌路，车攒鬬舞场。",
        "经过犹未已，钟鼓出长杨。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 299355,
      "title": "登瀛州南城楼寄远",
      "content": [
        "层城起丽谯，凭览出重霄。",
        "兹地多形胜，中天宛寂寥。",
        "四荣摩鹳鹤，百拱厉风飙。",
        "北际燕王馆，东连秦帝桥。",
        "晴光七郡满，春色两河遥。",
        "傲睨非吾土，踌躇适远嚣。",
        "离居欲有赠，春草寄长谣。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 299356,
      "title": "塞北二首 一",
      "content": [
        "虏障天骄起，秦城地脉分。",
        "柏坛飞五将，梅吹动三军。",
        "锋刃奔涛色，旌旗焰火文。",
        "朔风吹汗漫，飘砾洒轒辒。",
        "海气如秋雨，边烽似夏云。",
        "二庭无岁月，百战有功勋。",
        "形影随鱼贯，音书在雁群。",
        "归来拜天子，凯乐助南薰。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 299357,
      "title": "塞北二首 二",
      "content": [
        "胡骑犯边埃，风从丑上来。",
        "五原烽火急，六郡羽书催。",
        "冰壮飞狐[冷]，霜浓候雁哀。",
        "将军朝授钺，战士夜衔枚。",
        "紫塞金河里，葱山铁勒隈。",
        "莲花秋劒发，桂叶晓旗开。",
        "秘略三军动，妖氛百战摧。",
        "何言投笔去，终作勒铭回。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 299358,
      "title": "李员外秦援宅观妓",
      "content": [
        "盈盈粉署郎，五日宴春光。",
        "选客虚前馆，徵声徧后堂。",
        "玉钗翠羽饰，罗袖郁金香。",
        "拂黛随时广，挑鬟出意长。",
        "啭歌遥合态，度舞暗成行。",
        "巧落梅庭里，斜光暎晓妆。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 299359,
      "title": "送韦商州弼",
      "content": [
        "会府应文昌，商山镇国阳。",
        "闻君监郡史，𫏐罢尚书郎。",
        "王事嗟相失，人情贵不忘。",
        "累年同画省，四海接文场。",
        "点翰芳春色，传杯明月光。",
        "故交从此去，遥忆紫芝香。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 299360,
      "title": "夏日梁王席送张岐州",
      "content": [
        "秦鸡常下雍，周凤昔鸣岐。",
        "此地推雄抚，惟良寄在斯。",
        "家传七豹贵，人擅八龙奇。",
        "高传生光彩，长林叹别离。",
        "天人开祖席，朝采候征麾。",
        "翠帟当郊敞，彤幨向野披。",
        "芃芃秋麦盛，苒苒夏条垂。",
        "奏计何时入？",
        "台阶望羽仪。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 299361,
      "title": "夏日都门送司马员外逸客孙员外佺北征",
      "content": [
        "二庭追虏骑，六月动周师。",
        "庙略天人授，军麾相国持。",
        "复言征二妙，才命重当时。",
        "画省连征橐，横门共别词。",
        "云迎出塞马，风卷度河旗。",
        "计日方夷寇，旋闻杕杜诗。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 299362,
      "title": "送卢管记仙客北伐",
      "content": [
        "羽檄西北飞，交城日夜围。",
        "庙堂盛征选，戎幕生光辉。",
        "雁行度函谷，马首向金微。",
        "湛湛山川暮，萧萧凉气稀。",
        "饯途予悯默，赴敌子英威。",
        "今日杨朱泪，无将洒铁衣。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
