        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 334053,
      "title": "郊庙歌辞：享龙池乐章：第三章",
      "content": [
        "龙池跃龙龙已飞，龙德光天天不违。",
        "池开天汉分黄道，",
        "为报寰中百川水，来朝此地莫东归。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 334307,
      "title": "乐府杂曲：鼓吹曲辞：巫山高二首",
      "content": [
        "巫山峰十二，环合隐昭回。",
        "俯眺琵琶峡，平看云雨台。",
        "古槎天外倚，瀑水日边来。",
        "何忽啼猿夜，荆王枕席开。",
        "神女向高唐，巫山下夕阳。",
        "裴回作行雨，婉娈逐荆王。",
        "电影江前落，雷声峡外长。",
        "霁云无处所，台馆晓苍苍。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 334321,
      "title": "乐府杂曲：鼓吹曲辞：芳树",
      "content": [
        "何地早芳菲，宛在长门殿。",
        "夭桃色若绶，秾李光如练。",
        "啼鸟弄花疏，游蜂饮香遍。",
        "叹息春风起，飘零君不见。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 334327,
      "title": "乐府杂曲：鼓吹曲辞：有所思",
      "content": [
        "君子事行役，再空芳岁期。",
        "美人旷延伫，万里浮云思。",
        "园槿绽红艳，郊桑柔绿滋。",
        "坐看长夏晚，秋月生罗帏。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 334338,
      "title": "乐府杂曲：鼓吹曲辞：钓竿篇",
      "content": [
        "朝日敛红烟，垂竿向绿川。",
        "人疑天上坐，鱼似镜中悬。",
        "避楫时惊透，猜钩每误牵。",
        "湍危不理辖，潭静欲留船。",
        "钓玉君徒尚，征金我未贤。",
        "为看芳饵下，贪得会无全。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 334368,
      "title": "横吹曲辞：出塞",
      "content": [
        "十年通大漠，万里出长平。",
        "寒日生戈剑，阴云摇旆旌。",
        "饥乌啼旧垒，疲马恋空城。",
        "辛苦皋兰北，胡霜损汉兵。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 334387,
      "title": "横吹曲辞：折杨柳",
      "content": [
        "玉窗朝日映，罗帐春风吹。",
        "拭泪攀杨柳，长条宛地垂。",
        "白花飞历乱，黄鸟思参差。",
        "妾自肝肠断，旁人那得知。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 334403,
      "title": "横吹曲辞：关山月",
      "content": [
        "汉月生辽海，曈昽出半晖。",
        "合昏玄兔郡，中夜白登围。",
        "晕落关山迥，光含霜霰微。",
        "将军听晓角，战马欲南归。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 334425,
      "title": "横吹曲辞：长安道",
      "content": [
        "秦地平如掌，层城出云汉。",
        "楼阁九衢春，车马千门旦。",
        "绿柳开复合，红尘聚还散。",
        "日晚斗鸡回，经过狭斜看。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 334427,
      "title": "横吹曲辞：梅花落",
      "content": [
        "铁骑几时回，金闺怨早梅。",
        "雪中花已落，风暖叶应开。",
        "夕逐新春管，香迎小岁杯。",
        "感时何足贵，书里报轮台。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 334485,
      "title": "相和歌辞：王昭君",
      "content": [
        "非君惜鸾殿，非妾妒蛾眉。",
        "薄命由骄虏，无情是画师。",
        "嫁来胡地恶，不并汉宫时。",
        "心苦无聊赖，何堪上马辞。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 334528,
      "title": "相和歌辞：铜雀妓",
      "content": [
        "昔年分鼎地，今日望陵台。",
        "一旦雄图尽，千秋遗令开。",
        "绮罗君不见，歌舞妾空来。",
        "恩共漳河水，东流无重回。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 334653,
      "title": "相和歌辞：长门怨",
      "content": [
        "月皎风泠泠，长门次掖庭。",
        "玉阶闻坠叶，罗幌见飞萤。",
        "清露凝珠缀，流尘下翠屏。",
        "妾心君未察，愁叹剧繁星。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 334781,
      "title": "相和歌辞：凤笙曲",
      "content": [
        "忆昔王子晋，凤笙游云空。",
        "挥手弄白日，安能恋青宫。",
        "岂无婵娟子，结念罗帐中。",
        "怜寿不贵色，身世两无穷。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 334826,
      "title": "琴曲歌辞：霹雳引",
      "content": [
        "岁七月，火伏而金生。",
        "客有鼓瑟于门者，奏霹雳之商声。",
        "始戛羽以騞砉，终扣宫而砰駖。",
        "电耀耀兮龙跃，",
        "有如驱千旗，制五兵，截荒虺，斫长鲸。",
        "孰与广陵比，"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 335029,
      "title": "杂曲歌辞：古别离",
      "content": [
        "白水东悠悠，中有西行舟。",
        "舟行有返棹，水去无还流。",
        "奈何生别者，戚戚怀远游。",
        "远游谁当惜，所悲会难收。",
        "自君间芳屣，青阳四五遒。",
        "皓月掩兰室，光风虚蕙楼。",
        "相思无明晦，长叹累冬秋。",
        "离居分迟暮，驾高何淹留。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 335097,
      "title": "杂曲歌辞：独不见",
      "content": [
        "卢家小妇郁金堂，海燕双栖玳瑁梁。",
        "九月寒砧催下叶，",
        "谁知含愁独不见，使妾明月照流黄。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 335363,
      "title": "杂歌谣辞：古歌",
      "content": [
        "落叶流风向玉台，夜寒秋思洞房开。",
        "水精帘外金波下，",
        "璿闺窈窕秋夜长，绣户徘徊秋月光。",
        "燕姬彩帐芙蓉色，"
      ],
