{
  "data": [
    {
      "id": 156140,
      "title": "早起偶成  其二",
      "content": [
        "江山如有意，天地可无秋。",
        "夜月冯驩铗，西风王粲楼。",
        "露蛩令我喜，烟草为谁愁。",
        "且醉杯中物，相看尚黑头。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156141,
      "title": "晓起  其一",
      "content": [
        "梦破风烟逈，衾寒不自由。",
        "钟声到枕曙，月影入帘秋。",
        "雁过江山老，蛩吟草树愁。",
        "整冠人共笑，两月不梳头。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156142,
      "title": "晓起  其二",
      "content": [
        "远寺鸣金铎，疏窗试宝熏。",
        "秋声江一片，曙影月三分。",
        "倦鹤行黄叶，痴猿坐白云。",
        "道人无一事，抱膝看回文。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156143,
      "title": "夜坐",
      "content": [
        "淡烟枫叶路，细雨蓼花时。",
        "宿雁半江画，寒蛩四壁诗。",
        "少年成老大，吾道付逶迟。",
        "终有剑心在，闻鸡坐欲驰。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156144,
      "title": "和朱松坡",
      "content": [
        "学医未至大医王，笑杀年年折臂伤。",
        "屏里江山如出色，亭皋松菊已成行。",
        "细参不语禅三昧，静对无弦琴一张。",
        "多谢岭头诗寄我，满园梅意弄春光。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 156145,
      "title": "陈贯道摘坡诗如寄以自号达者之流也为赋浩浩歌一首",
      "content": [
        "浩浩歌，人生如寄可奈何。",
        "春秋去来传鸿燕，朝暮出没奔羲娥。",
        "青丝冉冉上霜雪，百年欻若弹指过。",
        "封侯未必胜瓜圃，青门老子聊婆娑。",
        "江湖流浪何不可，亦曾力士为脱靴。",
        "清风明月不用买，何处不是安乐窝。",
        "鹤胫岂长凫岂短，夔足非少蚿非多。",
        "浩浩歌，人生如寄可奈何。",
        "不能高飞与远举，天荒地老悬网罗。",
        "到头北邙一抔土，万事碌碌空奔波。",
        "金张许史久寂寞，古来贤圣闻丘轲。",
        "乃知世间为长物，惟有真我难灭磨。",
        "浩浩歌，人生如寄可奈何。",
        "春梦婆，春梦婆，拍手笑呵呵。",
        "是亦一东坡，非亦一东坡。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 156146,
      "title": "借朱约山韵就贺挂冠",
      "content": [
        "身健尚堪松下饭，眼明正好橘中棋。",
        "青山有约当朱户，白首何心上彩闱。",
        "栗里田园供雅兴，午桥钟鼓赏清时。",
        "晚来倦客秋江上，坐看半天黄鹄飞。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 156147,
      "title": "用前人韵赋招隠",
      "content": [
        "钓鱼船上听吹笛，煨芋炉头看下棋。",
        "賸有晚愁归别浦，已无春梦到端闱。",
        "去年尚忆桃红处，好景重逢橘绿时。",
        "珍重山人招隠意，猿啼鹤啸白云飞。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 156148,
      "title": "用前人韵招山行以春为期",
      "content": [
        "扫残竹径随人坐，凿破苔矶到处棋。",
        "一水楼台开晓镜，万山花木放春闱。",
        "雪中便有回舟兴，林下岂无烧笋时。",
        "莫待东风吹柳絮，眼穿笼鹤遶湖飞。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 156149,
      "title": "翰林权直罢归和朱约山韵",
      "content": [
        "闲云舒卷无声画，醉石敲推一色棋。",
        "试问挂瓢栖碧洞，何如幞被卧彤闱。",
        "梦中芳草还成路，别后黄花又是时。",
        "羞杀今年堂上燕，片心寄与雁南飞。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 156150,
      "title": "庆罗氏祖母百岁",
      "content": [
        "丽日萱花照五云，升堂风采见干淳。",
        "蓬莱会上逢王母，婺女光中见老人。",
        "雨露一门华发润，江山满座彩衣新。",
        "只将千载苓为寿，更住人间九百春。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 156151,
      "title": "拜罗氏百岁母之明日主人举酒客张千载心赋诗某喜赞不自已见之趁韵",
      "content": [
        "翠微三岛近，画阁五云横。",
        "春水鸥声滑，夕阳鸦背明。",
        "尊前持一笑，花下卧余酲。",
        "曾见瑶池母，不为虚此生。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156152,
      "title": "醉清湖上三日存叟独不在坐即席有怀",
      "content": [
        "石鼎吟方透，瑶觞醉未阑。",
        "疏林花密缀，旧垒燕新安。",
        "春半湖山好，夜深江海寒。",
        "王孙隔芳草，初月正相看。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156153,
      "title": "罗山长存叟兄弟来谢宴山中",
      "content": [
        "天开盘谷隠，春到浣溪家。",
        "一水楼台影，满山桃李花。",
        "春风寄横笛，夜月拟乘槎。",
        "政好逢佳客，江空北斗斜。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156154,
      "title": "寿朱约山八十韵",
      "content": [
        "翠袖琼楼八十翁，平安晓宇看孤鸿。",
        "五湖图里添彭祖，南极光中约祝融。",
        "日日青山醉春色，年年黄菊饱西风。",
        "鹰扬但愿无施处，臣老婆娑一钓蓬。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 156155,
      "title": "寿朱约山八十三岁",
      "content": [
        "八十余翁雪满颠，深衣大带耳垂肩。",
        "磻溪回首今三载，绛县论心又十年。",
        "归去来兮真富贵，美哉寿也活神仙。",
        "门前燕雀纷如雨，媿我白云深处眠。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 156156,
      "title": "贺秘书欧阳巽斋先生迁居",
      "content": [
        "先生挟册当菑畬，不待辛勤有屋庐。",
        "宅样只还齐里旧，乡风好似颍川居。",
        "镜湖今日贺外监，瀛馆前年虞秘书。",
        "天下经纶犹一室，时人尚敢说吾迂。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 156157,
      "title": "挽李制帅二首  其一",
      "content": [
        "上下荆淮剑气雄，进担全蜀凛英风。",
        "将坛歃血金汤志，白腹填天竹帛功。",
        "治法征谋关世道，精忠定力简皇衷。",
        "伤哉生出瞿塘险，翻落黄粱一梦中。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 156158,
      "title": "挽李制帅二首  其二",
      "content": [
        "世变江河渺未涯，如公真是济时危。",
        "几年荆益龙骧誉，一日潇湘𫛳谶悲。",
        "天下皆传清献节，人心自有武侯碑。",
        "郎君昔共慈恩约，抆泪西风寄些词。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 156159,
      "title": "挽孙庸斋",
      "content": [
        "淮水奇人物，枢星伟弟兄。",
        "泰山开学谱，云谷发诗源。",
        "委吏初行志，修文莫返魂。",
        "功名传久远，頼有二郎存。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156160,
      "title": "挽龚用和",
      "content": [
        "结屋南陵三十秋，田园旧隠隔江流。",
        "鄜州避乱杜工部，下泽乘车马少游。",
        "名利无心付隍鹿，诗书有种出烟楼。",
        "长淮清野难归玉，魂魄犹应恋故丘。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 156161,
      "title": "挽万监丞益之",
      "content": [
        "文华时辈右，质朴古风余。",
        "壁上舂陵记，屏间太极图。",
        "云山居士屋，风雪故人书。",
        "一梦中观化，尧夫以后无。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156162,
      "title": "哭秘书彭止所",
      "content": [
        "人物孤中秘，神山返异仙。",
        "目穿陪绋处，梦断曝书年。",
        "玉质应无死，韦编岂不传。",
        "奠刍和泪遣，此月向谁圆。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156163,
      "title": "挽湖守吴西林  其一",
      "content": [
        "凛凛千军笔，堂堂一面威。",
        "荆流春浪涌，峡树莫云飞。",
        "素壁琴犹在，中桥鹤不归。",
        "剑亭遗迹古，丰石照山辉。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156164,
      "title": "挽湖守吴西林  其二",
      "content": [
        "倾盖岁年晚，相知江海深。",
        "春天思北树，夜雨话西林。",
        "五岭生前梦，中原地下心。",
        "英雄凋落尽，慷慨一霑襟。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156165,
      "title": "挽高邮守晏桂山",
      "content": [
        "淮南已仙去，桂树鬰青青。",
        "五马贤声望，三丞旧典刑。",
        "邦人多感叹，诸老半凋零。",
        "何日持鸡酒，伤心请葬铭。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156166,
      "title": "挽鄢晋叔主簿",
      "content": [
        "此君何坦坦，回首杏园游。",
        "魂魄湘潭去，声名彭泽休。",
        "百年中道短，千里故乡愁。",
        "六子三方幼，遗言可泪流。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156167,
      "title": "挽王远叔",
      "content": [
        "孟尝生五日，白首叹遭逢。",
        "灯火残编雨，虀盐短褐风。",
        "八天下雕鹗，半水偃蛟龙。",
        "原上诸生哭，黄花衰草中。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156168,
      "title": "挽萧帅机虎溪",
      "content": [
        "世以千金重，谁能学隠君。",
        "一门名似雨，满座客如云。",
        "志愿生无憾，声华死有闻。",
        "韩碑照原草，含笑有斯文。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156169,
      "title": "挽朱尚书貔孙",
      "content": [
        "一代文昌贵，千年谏议名。",
        "天球声浑厚，玄酒韵和平。",
        "岩穴思风采，朝廷惜老成。",
        "东西生死别，江水泪为倾。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156170,
      "title": "挽太博朱古平  其一",
      "content": [
        "白氏贤司马，昌黎真学官。",
        "江湖惊落笔，朝野望弹冠。",
        "天马高风骨，秋鹰折羽翰。",
        "莱庭人白发，烟雨万松寒。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156171,
      "title": "挽太博朱古平  其二",
      "content": [
        "铁砚伤同志，青灯忆旧游。",
        "临轩朝凤阙，驰道听鸡筹。",
        "魏野神仙宅，元龙湖海楼。",
        "西风一挥泪，世事盖棺休。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156172,
      "title": "挽黎致政",
      "content": [
        "楚峰天地阔，四世百年家。",
        "鹤发垂袍叶，龙孙上榜花。",
        "诗书新雨露，松柏老烟霞。",
        "白马苍山路，斯人忽已遐。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156173,
      "title": "古心江先生以旧弼出镇长沙癸酉十月乙亥是为七十六岁门人文某以一节趋走部内谨拟古体一首为寿",
      "content": [
        "炎图启丕运，皇路熙以平。",
        "蜿蟺发令姿，有美洵一人。",
        "鸿藻舒朝华，大音锵韶钧。",
        "黼珽丽三阶，火龙昭紞纮。",
        "桓圭殿南服，熊旗被金城。",
        "瞻彼鹑为火，翼轸宣其精。",
        "祥鸾舞瑶席，鸣凤翔娲笙。",
        "孟冬兆阳气，西北无浮云。",
        "驾言酌春酒，可以写我情。",
        "扬旍下祝融，躧履朝泰清。",
        "嘉猷扇九垓，还以邃古淳。",
        "君子保金石，所以永国成。",
        "纯嘏锡千岁，绵绵赞休明。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 156174,
      "title": "送张宗甫兄弟楚观登舟赴湖北试",
      "content": [
        "金螺晓气照人寒，手把天浆领佩环。",
        "夜月送鱼来赤壁，秋风吹雁发衡山。",
        "东南折处旗花见，牛女光中槎影还。",
        "见说青年文赋好，士龙一笑共云间。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 156175,
      "title": "衡州送胡端逸赴漕",
      "content": [
        "楚观簷花晓，舟人击鼓东。",
        "蛟龙噀灵雨，雕鹗展雄风。",
        "此客云霄士，斯文造化工。",
        "捷来君饮此，我亦凯元戎。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156176,
      "title": "题楚观楼",
      "content": [
        "西风吹感慨，晓气薄登临。",
        "半壁楚云立，一川湘雨深。",
        "乾坤横笛影，江海倚楼心。",
        "遗恨飞鸿外，南来访远音。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156177,
      "title": "安序宋吏部来牧衡阳某将指联事好也会以便郡归养获忝交承临发赋诗湘水千里",
      "content": [
        "倾盖年华晚，行人早发湘。",
        "白云虹浪小，明月燕花香。",
        "明浦春何急，巴山日正长。",
        "祝君加一饭，我意为桐乡。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156178,
      "title": "赠周东卿画鱼",
      "content": [
        "观君潇湘图，起我濠上心。",
        "短褐波涛旧，秋雨菰蒲深。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 156179,
      "title": "某叨臬衡湘蒙恩以便郡归养肯斋大卿实寓衡我十年前邦君也一再见间即分南北五言启之所以致今旧雨缱绻云",
      "content": [
        "潇湘一夜雨，湖海十年云。",
        "相见皆成老，重逢便作分。",
        "啼鹃春浩荡，回雁晓殷勤。",
        "江阔人方健，月明思对君。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156180,
      "title": "幕客载酒舟中即席序别",
      "content": [
        "故人满江海，游子下潇湘。",
        "梦载月千里，意行云一方。",
        "橹声人语小，岸影客心长。",
        "总是浮萍迹，飞花莫近樯。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156181,
      "title": "用韵谢诸客和章",
      "content": [
        "传鼓发船去，我秦君向湘。",
        "持螯思太白，占鹊问东方。",
        "世味秋云薄，交情江水长。",
        "相期天路晓，阵马度风樯。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156182,
      "title": "湘潭道中赠丁碧眼相士  其一",
      "content": [
        "自诡衡山道士孙，至今句法有轩辕。",
        "世人未见题尧庙，尽把昌黎作寓言。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 156183,
      "title": "湘潭道中赠丁碧眼相士  其二",
      "content": [
        "收拾衡云作羽衣，便如屈子远游归。",
        "离骚忘却题天柱，为立斜阳问翠微。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 156184,
      "title": "咸淳甲戌第二朔予道槠洲里徐畋方谏自长沙来为别问客几何曰半年矣临别为赋",
      "content": [
        "君为湘水燕，我作衡阳雁。",
        "雁去燕方留，白云草迷岸。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 156185,
      "title": "和衡守宋安序送行诗  其一",
      "content": [
        "玉立湘西第一州，丹梯小为岳云留。",
        "东风城郭人行乐，春日旌旗公出游。",
        "便趁绨香摩碧汉，莫嫌绣影涴清流。",
        "两君相见衣冠好，记取儿孙好话头。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 156186,
      "title": "和衡守宋安序送行诗  其二",
      "content": [
        "方共衡云把酒杯，春风吹向鬰孤台。",
        "雁将回处惊帆落，花未开时怯笛催。",
        "别草可堪游子去，寄梅应为故人来。",
        "临行笑觅凝香谱，十驾那追逸骥材。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 156187,
      "title": "赠萍乡道士",
      "content": [
        "道上观行人，半似重相见。",
        "古云性相近，性岂不如面。",
        "万形本一性，万心方一殊。",
        "世固难绝圣，亦恐难绝愚。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156188,
      "title": "白髭行",
      "content": [
        "忆昔守宣时，白上一根发。",
        "去之四五年，一化为七八。",
        "今年客衡湘，黑髭已多黄。",
        "众黄忽一白，惊见如陵阳。",
        "白发已为常，白髭何足怪。",
        "岁月不可歇，雪霜日长大。",
        "世人竞染缁，厌之固足嗤。",
        "谁服芦菔汤，避老亦奚为。",
        "少老如春秋，造物以为俦。",
        "吾方乐吾天，乐天故不忧。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 156189,
      "title": "将母赴赣道西昌",
      "content": [
        "重来鸥阁晓，帆影涨新晴。",
        "倚槛云来去，闭帘花送迎。",
        "江湖春汗漫，岁月老峥嵘。",
        "手把忘忧草，夔夔绕太清。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156190,
      "title": "快阁遇雨观澜",
      "content": [
        "一笑登临晚，江流接太虚。",
        "自惭云出岫，争讶雨随车。",
        "慷慨十围柳，周回千里鱼。",
        "故园隄好在，夜梦绕吾庐。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156191,
      "title": "题鬰孤台",
      "content": [
        "城郭春声阔，楼台昼影迟。",
        "并天浮雪界，盖海出云旗。",
        "风雨十年梦，江湖万里思。",
        "倚阑时北顾，空翠湿朝曦。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156192,
      "title": "予题鬰孤泉管五湖翁姚濂为之和翁官满归里因韵贽别并谢前辱",
      "content": [
        "巢龟君往好，涌翠我来迟。",
        "夜雨呼三韭，春风试一旗。",
        "飞花行客梦，芳草故人思。",
        "何日五湖上，同看浴海曦。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156193,
      "title": "用韵谢前人",
      "content": [
        "兹游良邂逅，吾道未逶迟。",
        "斗野横双剑，牛津直两旗。",
        "此风应小住，明日便相思。",
        "输与君家近，扶桑五色曦。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156194,
      "title": "翠玉楼晚雨",
      "content": [
        "晚楼一曲转梅花，官事无多报放衙。",
        "林木蔽亏烟断续，江流曲折雨横斜。",
        "年华冉冉风前影，岁莫悠悠客里家。",
        "一雁近从沙觜落，更饶片雪入天涯。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 156195,
      "title": "翠玉楼观雪",
      "content": [
        "矫矫临清泚，蒙蒙认翠微。",
        "绨春生客袖，铁冷上戎衣。",
        "柳眼惊何老，梅花觉半肥。",
        "新来有公事，白战破重围。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156196,
      "title": "翠玉楼和胡端逸韵",
      "content": [
        "客影鱼千里，年华柳十围。",
        "白云栖石密，黄鹄出烟微。",
        "江海秋风老，湖山晚日晖。",
        "鬰孤台上望，野阔犊初肥。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156197,
      "title": "翠玉楼",
      "content": [
        "昏鸦何处落，野渡少人行。",
        "黄叶声在地，青山影入城。",
        "江湖行客梦，风雨故乡情。",
        "试问南来信，梅花三两英。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156198,
      "title": "合江楼  其一",
      "content": [
        "天上名鹑尾，人间说虎头。",
        "春风千万岫，秋水两三洲。",
        "客晚惊黄叶，官闲笑白鸥。",
        "双江日东下，我欲赋扁舟。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156199,
      "title": "合江楼  其二",
      "content": [
        "西楚惊鸿晚，东淮落木秋。",
        "蒸湘今石鼓，句宛古宣州。",
        "白日聊清赏，青山总旧游。",
        "不知沧海水，何处接天流。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156200,
      "title": "皂盖楼",
      "content": [
        "一水楼台绕，半空图画开。",
        "蜗涎行薜荔，雀影上莓苔。",
        "碧落人千载，青山酒一杯。",
        "晚烟看不尽，待月却归来。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156201,
      "title": "石楼",
      "content": [
        "晓色重帘卷，春声叠鼓催。",
        "长垣连草树，远水照楼台。",
        "八境烟浓淡，六街人往来。",
        "平安消息好，看到岭头梅。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156202,
      "title": "马祖岩",
      "content": [
        "曾将飞锡破苔痕，一片云根锁洞门。",
        "山外人家山下路，石头心事付无言。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 156203,
      "title": "禅关",
      "content": [
        "秋风吹日上禅关，路入松花第一弯。",
        "只愿四时烟雾少，满城楼阁见青山。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 156204,
      "title": "吸江",
      "content": [
        "绝壁千寻俯雪潭，春花秋草有䰐𩭹。",
        "当年误著蒲团坐，惹得人称马祖岩。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 156205,
      "title": "尘外",
      "content": [
        "半山风雨截江城，未脱人间总是尘。",
        "中夜起看衣上月，青天如水露华新。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 156206,
      "title": "云端",
      "content": [
        "半空夭矫起层台，传道刘安车马来。",
        "山上自晴山下雨，倚阑平立看风雷。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 156207,
      "title": "清江何汉英再见于空同读欧阳先生诗感慨为赋",
      "content": [
        "采芝云满山，采檗瀑垂涧。",
        "当年有清徽，为寄南来雁。",
        "雁去人已逝，岁月剨云晏。",
        "流水失声音，西河老忧患。",
        "往日志士悲，穷途行子惯。",
        "君为梁宋游，我复江汉宦。",
        "十年耿相逢，千里欠一盼。",
        "玄机寄糟粕，美疢堕刍豢。",
        "赠子归东方，聊荐吴兴苋。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 156208,
      "title": "送曹倅岩山官满归里",
      "content": [
        "春陵光霁落苍苔，葛水神仙立翠槐。",
        "万里云霞麒骥路，三年风月凤凰台。",
        "兴同老子复不浅，歌曰先生归去来。",
        "庾岭梅花开渐徧，一枝就与寄蓬莱。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 156209,
      "title": "和前人赋别  其一",
      "content": [
        "翠松三万顷，松雪著神仙。",
        "柳院催金钥，江花送玉鞭。",
        "晓岩云壁立，晚棹浪规圆。",
        "未了醉翁事，重寻颍上田。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156210,
      "title": "和前人赋别  其二",
      "content": [
        "当年童子见，今见二毛翁。",
        "海月三秋别，江云一日同。",
        "鸥心驰舍北，龙尾曳天东。",
        "定有延和奏，南来寄一通。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156211,
      "title": "赠明脉萧信叔",
      "content": [
        "枚乘擅七发，郭玉明四难。",
        "微言起沈痼，此道今漫漫。",
        "云何东海生，而乃绪真要。",
        "砉然以神遇，契彼镜经妙。",
        "我欲炊雕胡，俯凿菊水泉。",
        "寿彼方舆人，六气何由諐。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 156212,
      "title": "赠林碧鉴相士",
      "content": [
        "咸阳宫中四尺镜，照人五脏何烱烱。",
        "桑田沧海千余年，百炼依然化为矿。",
        "君从何处得此物，铸就双瞳敌秋月。",
        "向来照心今照形，不事澜翻三寸舌。",
        "远冲风雪肯我过，看来犹未深知我。",
        "我方蓑笠立钓矶，万事浮云都勘破。",
        "噫嘻吁，只今神目鬼眼纷道途，暗中许负应卢胡。",
        "试问何如林家老碧鉴，不知天津桥上复有龙钟无。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 156213,
      "title": "送吉州陈守解任",
      "content": [
        "美人策良马，弭节螺江湄。",
        "岁年忽晼晚，桃李已成蹊。",
        "遥遥一水间，复复东与西。",
        "晴川夹修杨，行舟何能维。",
        "朱凤翔海山，层汉扬音徽。",
        "高冈有梧桐，驾言览朝晖。",
        "赠君以白云，白云不我持。",
        "赠君以明月，明月不我携。",
        "白云与明月，远道相追随。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 156214,
      "title": "赠蜀医钟正甫",
      "content": [
        "炎皇览众草，异种多西州。",
        "为君望岷峨，使我双泪流。",
        "向来秦越人，朝洛夕邯郸。",
        "子持鹊经来，自西亦徂南。",
        "江南有羁羽，岂不怀故营。",
        "何当同皇风，六气和且平。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 156215,
      "title": "改题万安县凝祥观",
      "content": [
        "古道松花空翠香，风前鬓影照沧浪。",
        "飞泉半壁朝云湿，啼鸟满山春日长。",
        "须信神仙元有国，不知蛮触是何乡。",
        "道人横笛招归鹤，坐到斜晖上壁珰。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 156216,
      "title": "西昌倪氏有山谷书杜陵山水图障歌作江山堂堂废其后人以黄书求题跋感慨一绝",
      "content": [
        "杜二已无黄九去，长歌大字落江山。",
        "百年风物今何似，春水晚烟飞白鹇。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 156217,
      "title": "山中再次胡德昭韵  其一",
      "content": [
        "不将颜色汗黄金，落得灞桥馿上吟。",
        "是处江山生酒兴，满天风雪得梅心。",
        "觥筹堂里春声沸，灯火林臯夜色深。",
        "人世可能行乐耳，重游不用卜晴阴。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 156218,
      "title": "山中再次胡德昭韵  其二",
      "content": [
        "人生柳絮鬭坚牢，过眼春光叹伯劳。",
        "蜀道谩传千古险，庐山方许一人高。",
        "眼前见赤徒妨道，耳后生风未当豪。",
        "明月芦花随处有，扁舟自在不须篙。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 156219,
      "title": "山中再次胡德昭韵  其三",
      "content": [
        "曾见尊前此客哉，笑携麈尾拂莓苔。",
        "水边飞雁年年见，湖上新亭日日来。",
        "酹菊醉余披草坐，探梅吟罢带花回。",
        "北崖尚被刚风隔，笑按匆匆上马杯。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 156220,
      "title": "山中泛舟觞客",
      "content": [
        "便作乘槎客，萧萧骨发清。",
        "尊前山月过，笛里水风生。",
        "半夜鱼龙沸，三秋河汉明。",
        "雪堂眠二客，梦与白鸥盟。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156221,
      "title": "病中作",
      "content": [
        "六月廿四夜，人间热欲炊。",
        "病怀如酒困，倦睫似书痴。",
        "梦与千年接，心随万里驰。",
        "客来相问讯，寄语有新诗。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156222,
      "title": "山中即事",
      "content": [
        "山中方雨笠，天外忽晴丝。",
        "夕钓江澄练，春行路布棋。",
        "乾坤供俯仰，岁月任差池。",
        "有酒如渑在，何妨日问奇。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156223,
      "title": "挽巽斋先生欧阳大著",
      "content": [
        "徘徊西河上，月落众星稀。",
        "哲人萎中道，雨绝将安之。",
        "昔者丽鸿藻，玉振含清晖。",
        "名理轶晋魏，雅言袭轲思。",
        "连驾觐驰道，并坐侍端闱。",
        "及门怀燕婉，升堂接逶迤。",
        "方期黄鹄翔，忽作朝露晞。",
        "黔娄不盖体，延陵有遗悲。",
        "层阿翳寒树，平楚暧希微。",
        "帷㡛衣广柳，缟冠涕如縻。",
        "水从章江去，云遶楚山飞。",
        "已矣如有闻，斯文不在兹。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 156224,
      "title": "送刘其发入蜀",
      "content": [
        "秋风凄已寒，蜀道阻且长。",
        "虎狼伏原野，欲济川无梁。",
        "客从何处来，云我之西方。",
        "萧萧骕骦鸣，熠熠湛卢光。",
        "昔时荣华地，今为争战场。",
        "将军扬天戈，壮士发戎行。",
        "江南有羁鸟，悠悠怀故乡。",
        "驾言与子游，云天何茫茫。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 156225,
      "title": "周苍崖入吾山作图诗赠之",
      "content": [
        "三生石上结因缘，袍笏横斜学米颠。",
        "渔父几忘山下路，仙人时访岭头船。",
        "乌猨白鹤无根树，淡月疏星一线天。",
        "为我醉呼添蒙澒，倦来平卧看云烟。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 156226,
      "title": "题罗次说竹岩摘藁",
      "content": [
        "游子西南来，出门道何悠。",
        "文章会有用，意气轻身谋。",
        "纷纷食粱肉，藜藿当其忧。",
        "君看百川水，何处不东流。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156227,
      "title": "挽刘知县",
      "content": [
        "玉海渊源懿，金闺步武高。",
        "功名千载意，翰墨一时豪。",
        "天马含风骨，秋鹰折羽毛。",
        "相逢俱白发，流涕湿征袍。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156228,
      "title": "古乐府",
      "content": [
        "珊瑚香点胭脂雪，芙蓉帐压春云热。",
        "明朝早弄灯前月，潋滟九霞碧藕折。",
        "璇杓高耸婺女明，金波漾晓辉郎星。",
        "赤琼曲里长眉青，头上更有瑶池君。",
        "六九五十四东风，西蟠桃花花未红。",
        "鸣鸾鼓玉声玲珑，绿毛蒙茸莲水龟。",
        "媥斓五色人间稀，春多瑞叶不敢飞。",
        "冰壶光满鱼龙转，笑中低舞玉钗燕。",
        "明年今日长秋殿，安舆入侍金桃宴。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 156229,
      "title": "赴阙",
      "content": [
        "楚月穿春袖，吴霜透晓鞯。",
        "壮心欲填海，苦胆为忧天。",
        "役役慙金注，悠悠叹瓦全。",
        "丈夫竟何事，一日定千年。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156230,
      "title": "所怀",
      "content": [
        "只把初心看，休将近事论。",
        "誓为天出力，疑有鬼迷魂。",
        "明月夜推枕，春风昼闭门。",
        "故人万山外，俯仰向谁言。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
