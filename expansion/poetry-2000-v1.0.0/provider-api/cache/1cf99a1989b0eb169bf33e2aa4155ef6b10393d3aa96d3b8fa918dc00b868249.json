        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156231,
      "title": "自叹",
      "content": [
        "长安不可诣，何故会臯亭。",
        "倦鸟非无翼，神龟弗自灵。",
        "乾坤增感慨，身世付飘零。",
        "回首西湖晓，雨余山更青。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156232,
      "title": "铁错",
      "content": [
        "貔貅十万众，日夜望南辕。",
        "老马翻迷路，羝羊竟触藩。",
        "武夫伤铁错，达士笑金昏。",
        "单骑见回纥，汾阳岂易言。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156233,
      "title": "和言字韵",
      "content": [
        "悠悠天地阔，世事与谁论。",
        "清夜为挥涕，白云空断魂。",
        "死生苏子节，贵贱翟公门。",
        "前辈如瓶戒，无言胜有言。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156234,
      "title": "愧故人",
      "content": [
        "九门一夜涨风尘，何事痴儿竟误身。",
        "子产片言图救郑，仲连本志为排秦。",
        "但知慷慨称男子，不料蹉跎愧故人。",
        "玉勒雕鞍南上去，天高月冷泣孤臣。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 156235,
      "title": "求客",
      "content": [
        "眼看铜驼燕雀羞，东风花柳自皇州。",
        "白云万里易成梦，明月一间都是愁。",
        "男子铁心无地著，故人血泪向天流。",
        "鸡鸣曾脱函关厄，还有当年此客不。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 156236,
      "title": "纪事  其一",
      "content": [
        "三宫九庙事方危，狼子心肠未可知。",
        "若使无人折狂虏，东南那个是男儿。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 156237,
      "title": "纪事  其二",
      "content": [
        "春秋人物类能言，宗国常因口舌存。",
        "我亦濒危专对出，北风满野负乾坤。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 156238,
      "title": "纪事  其三",
      "content": [
        "单骑堂堂诣虏营，古今祸福了如陈。",
        "北方相顾称男子，似谓江南尚有人。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 156239,
      "title": "纪事  其四",
      "content": [
        "百色无厌不可支，甘心卖国问为谁。",
        "豺狼尚畏忠臣在，相戒勿令丞相知。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    }
  ],
