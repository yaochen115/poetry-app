{
  "data": [
    {
      "id": 269591,
      "title": "叹老三首 二",
      "content": [
        "我有一握发，梳理何稠直。",
        "昔似玄云光，今如素丝色。",
        "匣中有旧镜，欲照先叹息。",
        "自从头白来，不欲明磨拭。",
        "鵶头与鹤颈，至老常如墨。",
        "独有人鬓毛，不得终身黑。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 269592,
      "title": "叹老三首 三",
      "content": [
        "前年种桃核，今岁成花树。",
        "去岁新婴儿，今年已学步。",
        "但惊物长成，不觉身衰暮。",
        "去矣欲何如，少年留不住。",
        "因书今日意，徧寄诸亲故。",
        "壮岁不欢娱，长年当悔悟。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 269593,
      "title": "送兄弟回雪夜",
      "content": [
        "日晦云气黄，东北风切切。",
        "时从村南还，新与兄弟别。",
        "离襟泪犹湿，回马嘶未歇。",
        "欲归一室坐，天阴多无月。",
        "夜长火消尽，岁暮雨凝结。",
        "寂莫满炉灰，飘零上阶雪。",
        "对雪画寒灰，残灯明复灭。",
        "灰死如我心，雪白如我发。",
        "所隅皆如此，顷刻堪愁绝。",
        "回念入坐忘，转忧作禅悦。",
        "平生洗心法，正为今宵设。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 269594,
      "title": "溪中早春",
      "content": [
        "南山雪未尽，阴岭留残白。",
        "西涧冰已消，春溜含新碧。",
        "东风来几日，蛰动萌草坼。",
        "潜知阳和功，一日不虚掷。",
        "爱此天气暖，来拂溪边石。",
        "一坐欲忘归，暮禽声啧啧。",
        "蓬蒿隔桑枣，隐映烟火夕。",
        "归来问夜餐，家人烹荠麦。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 269595,
      "title": "同友人寻涧花",
      "content": [
        "闻有涧底花，贳得村中酒。",
        "与君来校迟，已逢摇落后。",
        "临觞有遗恨，怅望空溪口。",
        "记取花发时，期君重携手。",
        "我生日日老，春色年年有。",
        "且作来岁期，不知身健否。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 269596,
      "title": "登村东古冢",
      "content": [
        "高低古时冢，上有牛羊道。",
        "独立最高头，悠哉此怀抱。",
        "回头向村望，但见荒田草。",
        "村人不爱花，多种栗与枣。",
        "自来此村住，不觉风光好。",
        "花少莺亦稀，年年春暗老。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 269597,
      "title": "梦裴相公",
      "content": [
        "五年生死隔，一夕魂梦通。",
        "梦中如往日，同直金銮宫。",
        "髣髴金紫色，分明冰玉容。",
        "勤勤相眷意，亦与平生同。",
        "既寤知是梦，悯然情未终。",
        "追想当时事，何殊昨夜中。",
        "自我学心法，万缘成一空。",
        "今朝为君子，流涕一霑胷。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 269598,
      "title": "昼寝",
      "content": [
        "坐整白单衣，起穿黄草屦。",
        "朝餐盥漱毕，徐下阶前步。",
        "暑风微变候，昼刻渐加数。",
        "院静地阴阴，鸟鸣新叶树。",
        "独行还独卧，夏景殊未暮。",
        "不作午时眠，日长安可度。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 269599,
      "title": "别行简",
      "content": [
        "漠漠病眼花，星星愁鬓雪。",
        "筋骸已衰惫，形影仍分诀。",
        "梓州二千里，劒门五六月。",
        "岂是远行时，火云烧栈热。",
        "何言巾上泪，乃是肠中血。",
        "念此早归来，莫作经年别。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 269600,
      "title": "观儿戏",
      "content": [
        "髫龀七八岁，绮纨三四儿。",
        "弄尘复鬭草，尽日乐嬉嬉。",
        "堂上长年客，鬓间新有丝。",
        "一看竹马戏，每忆童𫘤时。",
        "童𫘤饶戏乐，老大多忧悲。",
        "静念彼与此，不知谁是痴。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 269601,
      "title": "叹常生",
      "content": [
        "西村常氏子，卧疾不须臾。",
        "前旬犹访我，今日忽云殂。",
        "时我病多暇，与之同野居。",
        "园林青蔼蔼，相去数里余。",
        "村邻无好客，所遇唯农夫。",
        "之子何如者，往还犹胜无。",
        "于今亦已矣，可为一长吁。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 269602,
      "title": "寄元九",
      "content": [
        "一病经四年，亲朋书信断。",
        "穷通合易交，自笑知何晚。",
        "元君在荆楚，去日唯云远。",
        "彼独是何人，心如石不转。",
        "忧我贫病身，书来唯劝勉。",
        "上言少愁苦，下道加餐饭。",
        "怜君为谪吏，穷薄家贫褊。",
        "三寄衣食资，数盈二十万。",
        "岂是贪衣食，感君心缱绻。",
        "念我口中食，分君身上暖。",
        "不因身病久，不因命多蹇。",
        "平生亲友心，岂得知深浅。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 269603,
      "title": "以镜赠别",
      "content": [
        "人言似明月，我道胜明月。",
        "明月非不明，一年十二缺。",
        "岂如玉匣里，如水常澄澈。",
        "月破天暗时，圆明独不歇。",
        "我慙貌丑老，绕鬓斑斑雪。",
        "不如赠少年，回照青丝发。",
        "因君千里去，持此将为别。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 269604,
      "title": "城上对月期友人不至",
      "content": [
        "古人惜昼短，劝令秉烛游。",
        "况此迢迢夜，明月满西楼。",
        "复有盈尊酒，置在城上头。",
        "期君君不至，人月两悠悠。",
        "照水烟波白，照人肌发秋。",
        "清光正如此，不醉即须愁。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 269605,
      "title": "念金銮子二首 一",
      "content": [
        "衰病四十身，娇痴三岁女。",
        "非男犹胜无，慰情时一抚。",
        "一朝舍我去，魂影无处所。",
        "况念夭札时，呕哑初学语。",
        "始知骨肉爱，乃是忧悲聚。",
        "唯思未有前，以理遣伤苦。",
        "忘怀日已久，三度移寒暑。",
        "今日一伤心，因逢旧乳母。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 269606,
      "title": "念金銮子二首 二",
      "content": [
        "与尔为父子，八十有六旬。",
        "忽然又不见，迩来三四春。",
        "形质本非实，气聚偶成身。",
        "恩爱元是妄，缘合暂为亲。",
        "念兹庶有悟，聊用遣悲辛。",
        "暂将理自夺，不是忘情人。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 269607,
      "title": "对酒",
      "content": [
        "人生一百岁，通计三万日。",
        "何况百岁人，人间百无一。",
        "贤愚共零落，贵贱同埋没。",
        "东岱前后魂，北邙新旧骨。",
        "复闻药误者，为爱延年术。",
        "又有忧死者，为贪政事笔。",
        "药误不得老，忧死非因疾。",
        "谁言人最灵，知得不知失。",
        "何如会亲友，饮此杯中物。",
        "能沃烦虑消，能陶真性出。",
        "所以刘阮辈，终年醉兀兀。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 269608,
      "title": "渭村雨归",
      "content": [
        "渭水寒渐落，离离蒲稗苗。",
        "闲傍沙边立，看人刈苇苕。",
        "近水风景冷，晴明犹寂寥。",
        "复兹夕阴起，野色重萧条。",
        "萧条独归路，暮雨湿村桥。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 269609,
      "title": "谕怀",
      "content": [
        "黑头日已白，白面日已黑。",
        "人生未死间，变化何终极。",
        "常言在己者，莫若形与色。",
        "一朝改变来，止遏不能得。",
        "况彼身外事，悠悠通与塞。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 269610,
      "title": "喜友至留宿",
      "content": [
        "村中少宾客，柴门多不开。",
        "忽闻车马至，云是故人来。",
        "况值风雨夕，愁心正悠哉。",
        "愿君且同宿，尽此手中杯。",
        "人生开口笑，百年都几回。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 269611,
      "title": "西原晚望",
      "content": [
        "花菊引闲行，行上西原路。",
        "原上晚无人，因高聊四顾。",
        "南阡有烟火，北陌连墟墓。",
        "村邻何萧疎，近者犹百步。",
        "吾庐在其下，寂莫风日暮。",
        "门外转枯蓬，篱根伏寒兔。",
        "故园汴水上，离乱不堪去。",
        "近岁始移家，飘然此村住。",
        "新屋五六间，古槐八九树。",
        "便是衰病身，此生终老处。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 269612,
      "title": "感镜",
      "content": [
        "美人与我别，留镜在匣中。",
        "自从花颜去，秋水无芙蓉。",
        "经年不开匣，红埃覆青铜。",
        "今朝一拂拭，自照顦顇容。",
        "照罢重惆怅，背有双盘龙。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 269613,
      "title": "村居卧病三首 一",
      "content": [
        "戚戚抱羸病，悠悠度朝暮。",
        "夏木才结阴，秋兰已含露。",
        "前日巢中卵，化作雏飞去。",
        "昨日穴中虫，蜕为蝉上树。",
        "四时未尝歇，一物不暂住。",
        "唯有病客心，沈然独如故。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 269614,
      "title": "村居卧病三首 二",
      "content": [
        "新秋久病客，起步村南道。",
        "尽日不逢人，虫声徧荒草。",
        "西风吹白露，野绿秋仍早。",
        "草木犹为伤，先伤我怀抱。",
        "朱颜与玄鬓，强健几时好。",
        "况为忧病侵，不得依年老。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 269615,
      "title": "村居卧病三首 三",
      "content": [
        "种黍三十亩，雨来苗渐大。",
        "种薤二十畦，秋来欲堪刈。",
        "望黍作冬酒，留薤为春菜。",
        "荒村百物无，待此养衰瘵。",
        "葺庐备阴雨，补褐防寒岁。",
        "病身知几时，且作明年计。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 269616,
      "title": "沐浴",
      "content": [
        "经年不沐浴，尘垢满肌肤。",
        "今朝一澡濯，衰瘦颇有余。",
        "老色头鬓白，病形支体虚。",
        "衣宽有賸带，发少不胜梳。",
        "自问今年岁，春秋四十初。",
        "四十已如此，七十复何如。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 269617,
      "title": "栽松二首 一",
      "content": [
        "小松未盈尺，心爱手自移。",
        "苍然涧底色，云湿烟霏霏。",
        "栽植我年晚，长成君性迟。",
        "如何过四十，种此数寸枝。",
        "得见成阴否，人生七十稀。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 269618,
      "title": "栽松二首 二",
      "content": [
        "爱君抱晚节，怜君含直文。",
        "欲得朝朝见，阶前故种君。",
        "知君死则已，不死会凌云。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 269619,
      "title": "病中友人相访",
      "content": [
        "卧久不记日，南窗昏复昏。",
        "萧条草檐下，寒雀朝夕闻。",
        "强扶床前杖，起向庭中行。",
        "偶逢故人至，便当一逢迎。",
        "移榻就斜日，披裘倚前楹。",
        "闲谈胜服药，稍觉有心情。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 269620,
      "title": "自觉二首 一",
      "content": [
        "四十未为老，忧伤早衰恶。",
        "前岁二毛生，今年一齿落。",
        "形骸日损耗，心事同萧索。",
        "夜寝与朝餐，其间味亦薄。",
        "同岁崔舍人，容光方灼灼。",
        "始知年与貌，衰盛随忧乐。",
        "畏老老转迫，忧病病弥缚。",
        "不畏复不忧，是除老病药。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 269621,
      "title": "自觉二首 二",
      "content": [
        "朝哭心所爱，暮哭心所亲。",
        "亲爱零落尽，安用身独存。",
        "几许平生欢，无限骨肉恩。",
        "结为肠间痛，聚作鼻头辛。",
        "悲来四支缓，泣尽双眸昏。",
        "所以年四十，心如七十人。",
        "我闻浮屠教，中有解脱门。",
        "置心为止水，视身如浮云。",
        "斗擞垢秽衣，度脱生死轮。",
        "胡为恋此苦，不去犹逡巡。",
        "回念发弘愿，愿此见在身。",
        "但受过去报，不结将来因。",
        "誓以智慧水，永洗烦恼尘。",
        "不将恩爱子，更种悲忧根。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 269622,
      "title": "夜雨有念",
      "content": [
        "以道治心气，终岁得晏然。",
        "何乃戚戚意，忽来风雨天。",
        "既非慕荣显，又不恤饥寒。",
        "胡为悄不乐，抱膝残灯前。",
        "形影暗相问，心默对以言。",
        "骨肉能几人，各在天一端。",
        "吾兄寄宿州，吾弟客东川。",
        "南北五千里，吾身在中间。",
        "欲去病未能，欲住心不安。",
        "有如波上舟，此缚而彼牵。",
        "自我向道来，于今六七年。",
        "炼成不二性，消尽千万缘。",
        "唯有恩爱火，往往犹熬煎。",
        "岂是药无効，病多难尽蠲。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 269623,
      "title": "寄杨六",
      "content": [
        "青宫官冷静，赤县事繁剧。",
        "一闲复一忙，动作经时隔。",
        "清觞久废酌，白日顿虚掷。",
        "念此忽踟蹰，悄然心不适。",
        "岂无旧交结，久别或迁易。",
        "亦有新往还，相见多形迹。",
        "唯君于我分，坚久如金石。",
        "何况老大来，人情重姻戚。",
        "会稀岁月急，此事真可惜。",
        "几回开口笑，便到髭须白。",
        "公门苦鞅掌，尽日无闲隙。",
        "犹冀乘暝来，静言同一夕。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 269624,
      "title": "送春",
      "content": [
        "三月三十日，春归日复暮。",
        "惆怅问春风，明朝应不住。",
        "送春曲江上，眷眷东西顾。",
        "但见扑水花，纷纷不知数。",
        "人生似行客，两足无停步。",
        "日日进前程，前程几多路。",
        "兵刀与水火，尽可违之去。",
        "唯有老到来，人间无避处。",
        "感时良为已，独倚池南树。",
        "今日送春心，心如别亲故。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 269625,
      "title": "哭李三",
      "content": [
        "去年渭水曲，秋时访我来。",
        "今年常乐里，春日哭君回。",
        "哭君仰问天，天意安在哉。",
        "若必夺其寿，何如不与才。",
        "落然身后事，妻病女婴孩。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 269626,
      "title": "别李十一后重寄",
      "content": [
        "秋日正萧条，驱车出蓬荜。",
        "回望青门道，目极心郁郁。",
        "岂独恋乡土，非关慕簪绂。",
        "所怆别李君，平生同道术。",
        "俱承金马诏，联秉谏臣笔。",
        "共上青云梯，中途一相失。",
        "江湖我方往，朝廷君不出。",
        "蕙带与华簪，相逢是何日。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 269627,
      "title": "初出蓝田路作",
      "content": [
        "停骖问前路，路在秋云里。",
        "苍苍县南道，去途从此始。",
        "绝顶忽上盘，众山皆下视。",
        "下视千万峰，峰头如浪起。",
        "朝经韩公坡，夕次蓝桥水。",
        "浔阳近四千，始行七十里。",
        "人烦马蹄跙，劳苦已如此。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 269628,
      "title": "仙娥峰下作",
      "content": [
        "我为东南行，始登商山道。",
        "商山无数峰，最爱仙娥好。",
        "参差树若插，匼匝云如抱。",
        "渴望寒玉泉，香闻紫芝草。",
        "青崖屏削碧，白石床铺缟。",
        "向无如此物，安足留四皓。",
        "感彼私自问，归山何不早？",
        "可能尘土中，还随众人老。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 269629,
      "title": "微雨夜行",
      "content": [
        "漠漠秋云起，稍稍夜寒生。",
        "但觉衣裳湿，无点亦无声。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 269630,
      "title": "再到襄阳访问旧居",
      "content": [
        "昔到襄阳日，髯髯初有髭。",
        "今过襄阳日，髭鬓半成丝。",
        "旧游都是梦，乍到忽如归。",
        "东郭蓬蒿宅，荒凉今属谁。",
        "故知多零落，闾井亦迁移。",
        "独有秋江水，烟波似旧时。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 269631,
      "title": "寄微之三首 一",
      "content": [
        "江州望通州，天涯与地末。",
        "有山万丈高，有江千里阔。",
        "间之以云雾，飞鸟不可越。",
        "谁知千古险，为我二人设。",
        "通州君初到，郁郁愁如结。",
        "江州我方去，迢迢行未歇。",
        "道路日乖隔，音信日断绝。",
        "因风欲寄语，地远声不彻。",
        "生当复相逢，死当从此别。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 269632,
      "title": "寄微之三首 二",
      "content": [
        "君游襄阳日，我在长安住。",
        "今君在通州，我过襄阳去。",
        "襄阳九里郭，楼堞连云树。",
        "顾此稍依依，是君旧游处。",
        "苍茫蒹葭水，中有浔阳路。",
        "此去更相思，江西少亲故。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 269633,
      "title": "寄微之三首 三",
      "content": [
        "去国日已远，喜逢物似人。",
        "如何含此意，江上坐思君。",
        "有如河岳气，相合方氛氲。",
        "狂风吹中绝，两处成孤云。",
        "风回终有时，云合岂无因。",
        "努力各自爱，穷通我尔身。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 269634,
      "title": "舟中雨夜",
      "content": [
        "江云暗悠悠，江风冷修修。",
        "夜雨滴船背，风浪打船头。",
        "船中有病客，左降向江州。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 269635,
      "title": "夜闻歌者",
      "content": [
        "夜泊鹦鹉洲，江月秋澄澈。",
        "邻船有歌者，发词堪愁绝。",
        "歌罢继以泣，泣声通复咽。",
        "寻声见其人，有妇颜如雪。",
        "独倚帆樯立，娉婷十七八。",
        "夜泪如真珠，双双堕明月。",
        "借问谁家妇，歌泣何凄切。",
        "一问一霑襟，低眉终不说。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 269636,
      "title": "江楼闻砧",
      "content": [
        "江人授衣晚，十月始闻砧。",
        "一夕高楼月，万里故园心。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 269637,
      "title": "宿东林寺",
      "content": [
        "经窗灯燄短，僧炉火气深。",
        "索落庐山夜，风雪宿东林。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 269638,
      "title": "忆洛下故园",
      "content": [
        "浔阳迁谪地，洛阳离乱年。",
        "烟尘三川上，炎瘴九江边。",
        "乡心坐如此，秋风仍飒然。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 269639,
      "title": "赠别崔五",
      "content": [
        "朝送南去客，暮迎北来宾。",
        "孰云当大路，少遇心所亲。",
        "劳者念息肩，热者思濯身。",
        "何如愁独日，忽见平生人。",
        "平生已不浅，是日重殷勤。",
        "问从何处来，及此江亭春。",
        "江天春多阴，夜月隔重云。",
        "移尊树间饮，灯照花纷纷。",
        "一会不易得，余事何足云。",
        "明旦又分手，今夕且欢忻。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 269640,
      "title": "春晚寄微之",
      "content": [
        "三月江水阔，悠悠桃花波。",
        "年芳与心事，此地共蹉跎。",
        "南国方谴谪，中原正兵戈。",
        "眼前故人少，头上白发多。",
        "通州更迢遰，春尽复如何。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 269641,
      "title": "渐老",
      "content": [
        "今朝复明日，不觉年齿暮。",
        "白发逐梳落，朱颜辞镜去。",
        "当春颇愁寂，对酒寡欢趣。",
        "遇境多怆辛，逢人益敦故。",
        "形质属天地，推迁从不住。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 269642,
      "title": "送幼史",
      "content": [
        "淮右寇未散，江西岁再徂。",
        "故里干戈地，行人风雪途。",
        "此时与尔别，江畔立踟蹰。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 269643,
      "title": "夜雪",
      "content": [
        "已讶衾枕冷，复见窗户明。",
        "夜深知雪重，时闻折竹声。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 269644,
      "title": "寄行简",
      "content": [
        "郁郁眉多敛，默默口寡言。",
        "岂是愿如此，举目谁与欢。",
        "去春尔西征，从事巴蜀间。",
        "今春我南谪，抱疾江海壖。",
        "相去六千里，地绝天邈然。",
        "十书九不达，何以开忧颜。",
        "渴人多梦饮，饥人多梦餐。",
        "春来梦何处，合眼到东川。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 269645,
      "title": "首夏",
      "content": [
        "孟夏百物滋，动植一时好。",
        "麋鹿乐深林，虫蛇喜丰草。",
        "翔禽爱密叶，游鳞悦新藻。",
        "天和遗漏处，而我独枯槁。",
        "一身在天末，骨肉皆远道。",
        "旧国无来人，寇戎尘浩浩。",
        "沈忧竟何益，祗自劳怀抱。",
        "不如放身心，冥然任天造。",
        "浔阳多美酒，可使杯不燥。",
        "湓鱼贱如泥，烹炙无昏早。",
        "朝饭山下寺，暮醉湖中岛。",
        "何必归故乡，兹焉可终老。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 269646,
      "title": "孟夏思渭村旧居寄舍弟",
      "content": [
        "啧啧雀引雏，稍稍笋成竹。",
        "时物感人情，忆我故乡曲。",
        "故园渭水上，十载事樵牧。",
        "手种榆柳成，阴阴覆墙屋。",
        "兔隐豆苗肥，鸟鸣桑椹熟。",
        "前年当此时，与尔同游瞩。",
        "诗书课弟姪，农圃资童仆。",
        "日暮麦登场，天晴蚕坼簇。",
        "弄泉南涧坐，待月东亭宿。",
        "兴发饮数杯，闷来棋一局。",
        "一朝忽分散，万里仍羁束。",
        "井鲋思反泉，笼莺悔出谷。",
        "九江地卑湿，四月天炎燠。",
        "苦雨初入梅，瘴云稍含毒。",
        "泥秧水畦稻，灰种畬田粟。",
        "已讶殊岁时，仍嗟异风俗。",
        "闲登郡楼望，日落江山绿。",
        "归雁拂乡心，平湖断人目。",
        "殊方我漂泊，旧里君幽独。",
        "何时同一瓢，饮水心亦足。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 269647,
      "title": "早蝉",
      "content": [
        "六月初七日，江头蝉始鸣。",
        "石楠深叶里，薄暮两三声。",
        "一催衰鬓色，再动故园情。",
        "西风殊未起，秋思先秋生。",
        "忆昔在东掖，宫槐花下听。",
        "今朝无限思，云树绕湓城。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 269648,
      "title": "感情",
      "content": [
        "中庭晒服玩，忽见故乡履。",
        "昔赠我者谁，东邻婵娟子。",
        "因思赠时语，特用结终始。",
        "永愿如履綦，双行复双止。",
        "自吾谪江郡，漂荡三千里。",
        "为感长情人，提携同到此。",
        "今朝一惆怅，反复看未已。",
        "人只履犹双，何曾得相似。",
        "可嗟复可惜，锦表绣为里。",
        "况经梅雨来，色黯花草死。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 269649,
      "title": "南湖晚秋",
      "content": [
        "八月白露降，湖中水方老。",
        "旦夕秋风多，衰荷半倾倒。",
        "手攀青枫树，足蹋黄芦草。",
        "惨澹老容颜，冷落秋怀抱。",
        "有兄在淮楚，有弟在蜀道。",
        "万里何时来，烟波白浩浩。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 269650,
      "title": "郡厅有树晚荣早凋人不识名因题其上",
      "content": [
        "浔阳郡厅后，有树不知名。",
        "秋先梧桐落，春后桃李荣。",
        "五月始萌动，八月已凋零。",
        "左右皆松桂，四时郁青青。",
        "岂量雨露恩，霑濡不均平。",
        "荣枯各有分，天地本无情。",
        "顾我亦相类，早衰向晚成。",
        "形骸少多病，三十不丰盈。",
        "毛鬓早改变，四十白髭生。",
        "谁教两萧索，相对此江城。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 269651,
      "title": "感秋怀微之",
      "content": [
        "叶下湖又波，秋风此时至。",
        "谁知濩落心，先纳萧条气。",
        "推移感流岁，漂泊思同志。",
        "昔为烟霄侣，今作泥涂吏。",
        "白鸥毛羽弱，青凤文章异。",
        "各闭一笼中，岁晚同顦顇。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 269652,
      "title": "因沐感发寄朗上人二首 一",
      "content": [
        "年长身转慵，百事无所欲。",
        "乃至头上发，经年方一沐。",
        "沐稀发苦落，一沐仍半秃。",
        "短鬓经霜蓬，老面辞春木。",
        "强年过犹近，衰相来何速。",
        "应是烦恼多，心焦血不足。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 269653,
      "title": "因沐感发寄朗上人二首 二",
      "content": [
        "渐少不满把，渐短不盈尺。",
        "况兹短少中，日夜落复白。",
        "既无神仙术，何除老死籍。",
        "祗有解脱门，能度衰苦厄。",
        "掩镜望东寺，降心谢禅客。",
        "衰白何足言，剃落犹不惜。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 269654,
      "title": "早蝉",
      "content": [
        "月出先照山，风生先动水。",
        "亦如早蝉声，先入闲人耳。",
        "一闻愁意结，再听乡心起。",
        "渭上新蝉声，先听浑相似。",
        "衡门有谁听，日暮槐花里。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 269655,
      "title": "苦热喜凉",
      "content": [
        "经时苦炎暑，心体但烦倦。",
        "白日一何长，清秋不可见。",
        "岁功成者去，天数极则变。",
        "潜知寒燠间，迁次如乘传。",
        "火云忽朝敛，金风俄夕扇。",
        "枕簟遂清凉，筋骸稍轻健。",
        "因思望月侣，好卜迎秋宴。",
        "竟夜无客来，引杯还自劝。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 269656,
      "title": "早秋晚望兼呈韦侍郎",
      "content": [
        "九派绕孤城，城高生远思。",
        "人烟半在船，野水多于地。",
        "穿霞日脚直，驱雁风头利。",
        "去国来几时，江上秋三至。",
        "夫君亦沦落，此地同飘寄。",
        "悯默向隅心，摧颓触笼翅。",
        "且谋眼前计，莫问胸中事。",
        "浔阳酒甚浓，相劝时时醉。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 269657,
      "title": "司马宅",
      "content": [
        "雨径绿芜合，霜园红叶多。",
        "萧条司马宅，门巷无人过。",
        "唯对大江水，秋风朝夕波。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 269658,
      "title": "司马厅独宿",
      "content": [
        "荒凉满庭草，偃亚侵檐竹。",
        "府吏下厅帘，家僮开被幞。",
        "数声城上漏，一点窗间烛。",
        "官曹冷似冰，谁肯来同宿。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 269659,
      "title": "梦与李七庾三十三同访元九",
      "content": [
        "夜梦归长安，见我故亲友。",
        "损之在我左，顺之在我右。",
        "云是二月天，春风出携手。",
        "同过靖安里，下马寻元九。",
        "元九正独坐，见我笑开口。",
        "还指西院花，仍开北亭酒。",
        "如言各有故，似惜欢难久。",
        "神合俄顷间，神离欠伸后。",
        "觉来疑在侧，求索无所有。",
        "残灯影闪墙，斜月光穿牖。",
        "天明西北望，万里君知否。",
        "老去无见期，踟蹰搔白首。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 269660,
      "title": "秋槿",
      "content": [
        "风露飒已冷，天色亦黄昏。",
        "中庭有槿花，荣落同一晨。",
        "秋开已寂莫，夕陨何纷纷。",
        "正怜少颜色，复叹不逡巡。",
        "感此因念彼，怀哉聊一陈。",
        "男儿老富贵，女子晚婚姻。",
        "头白始得志，色衰方事人。",
        "后时不获已，安得如青春。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 269661,
      "title": "荅元郎中杨员外喜乌见寄",
      "content": [
        "南宫鸳鸯地，何忽乌来止。",
        "故人锦帐郎，闻乌笑相视。",
        "疑乌报消息，望我归乡里。",
        "我归应待乌头白，慙媿元郎误欢喜。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 269662,
      "title": "初入峡有感",
      "content": [
        "上有万仞山，下有千丈水。",
        "苍苍两崖间，阔狭容一苇。",
        "瞿唐呀直泻，滟滪屹中峙。",
        "未夜黑岩昏，无风白浪起。",
        "大石如刀劒，小石如牙齿。",
        "一步不可行，况千三百里。",
        "苒蒻竹篾𥮘，欹危檝师趾。",
        "一跌无完舟，吾生系于此。",
        "常闻仗忠信，蛮貊可行矣。",
        "自古漂沈人，岂尽非君子。",
        "况吾时与命，蹇舛不足恃。",
        "常恐不才身，复作无名死。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 269663,
      "title": "过昭君村",
      "content": [
        "灵珠产无种，彩云出无根。",
        "亦如彼姝子，生此遐陋村。",
        "至丽物难掩，遽选入君门。",
        "独美众所嫉，终弃出塞垣。",
        "唯此希代色，岂无一顾恩。",
        "事排势须去，不得由至尊。",
        "白黑既可变，丹青何足论。",
        "竟埋代北骨，不返巴东魂。",
        "惨澹晚云水，依稀旧乡园。",
        "妍姿化已久，但有村名存。",
        "村中有遗老，指点为我言。",
        "不敢往者戒，恐贻来者冤。",
        "至今村女面，烧灼成瘢痕。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 269664,
      "title": "自江州至忠州",
      "content": [
        "前在浔阳日，已叹宾朋寡。",
        "忽忽抱忧怀，出门无处写。",
        "今来转深僻，穷峡巅山下。",
        "五月断行舟，滟堆正如马。",
        "巴人类猨狖，矍铄满山野。",
        "敢望见交亲，喜逢似人者。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 269665,
      "title": "初到忠州登东楼寄万州杨八使君",
      "content": [
        "山束邑居窄，峡牵气候偏。",
        "林峦少平地，雾雨多阴天。",
        "隐隐煮盐火，漠漠烧畬烟。",
        "赖此东楼夕，风月时翛然。",
        "凭轩望所思，目断心涓涓。",
        "背春有去雁，上水无来船。",
        "我怀巴东守，本是关西贤。",
        "平生已不浅，流落重相怜。",
        "水梗漂万里，笼禽囚五年。",
        "新恩同雨露，远郡邻山川。",
        "书信虽往复，封疆徒接连。",
        "其如美人面，欲见杳无缘。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 269666,
      "title": "郡中",
      "content": [
        "乡路音信断，山城日月迟。",
        "欲知州近远，阶前摘荔枝。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 269667,
      "title": "西楼夜",
      "content": [
        "悄悄复悄悄，城隅隐林杪。",
        "山郭灯火稀，峡天星汉少。",
        "年光东流水，生计南枝鸟。",
        "月没江沈沈，西楼殊未晓。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 269668,
      "title": "东楼晓",
      "content": [
        "脉脉复脉脉，东楼无宿客。",
        "城暗云雾多，峡深田地窄。",
        "宵灯尚留燄，晨禽初展翮。",
        "欲知山高低，不见东方白。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 269669,
      "title": "寄王质夫",
      "content": [
        "忆始识君时，爱君世缘薄。",
        "我亦吏王畿，不为名利著。",
        "春寻仙游洞，秋上云居阁。",
        "楼观水潺潺，龙潭花漠漠。",
        "吟诗石上坐，引酒泉边酌。",
        "因话出处心，心期老岩壑。",
        "忽从风雨别，遂被簪缨缚。",
        "君作出山云，我为入笼鹤。",
        "笼深鹤残顇，山远云飘泊。",
        "去处虽不同，同负平生约。",
        "今来各何在，老去随所托。",
        "我守巴南城，君佐征西幕。",
        "年颜渐衰飒，生计仍萧索。",
        "方含去国愁，且羡从军乐。",
        "旧游疑是梦，往事思如昨。",
        "相忆春又深，故山花正落。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 269670,
      "title": "南宾郡斋即事寄杨万州",
      "content": [
        "山上巴子城，山下巴江水。",
        "中有穷独人，强名为刺史。",
        "时时窃自哂，刺史岂如是。",
        "仓粟𫗪家人，黄缣裹妻子。",
        "莓苔翳冠带，雾雨霾楼雉。",
        "衙鼓暮复朝，郡斋卧还起。",
        "回头望南浦，亦在烟波里。",
        "而我复何嗟，夫君犹滞此。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 269671,
      "title": "招萧处士",
      "content": [
        "峡内岂无人，所逢非所思。",
        "门前亦有客，相对不相知。",
        "仰望但云树，俯顾惟妻儿。",
        "寝食起居外，端然无所为。",
        "东郊萧处士，聊可与开眉。",
        "能饮满杯酒，善吟长句诗。",
        "庭前吏散后，江畔路干时。",
        "请君携竹杖，一赴郡斋期。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 269672,
      "title": "庭槐",
      "content": [
        "南方饶竹树，唯有青槐稀。",
        "十种七八死，纵活亦支离。",
        "何此郡庭下，一株独华滋。",
        "蒙蒙碧烟叶，袅袅黄花枝。",
        "我家渭水上，此树荫前墀。",
        "忽向天涯见，忆在故园时。",
        "人生有情感，遇物牵所思。",
        "树木犹复尔，况见旧亲知。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 269673,
      "title": "送客回晚兴",
      "content": [
        "城上云雾开，沙头风浪定。",
        "参差乱山出，澹泞平江净。",
        "行客舟已远，居人酒初醒。",
        "袅袅秋竹梢，巴蝉声似磬。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 269674,
      "title": "东楼竹",
      "content": [
        "潇洒城东楼，绕楼多修竹。",
        "森然一万竿，白粉封青玉。",
        "卷帘睡初觉，欹枕看未足。",
        "影转色入楼，床席生浮绿。",
        "空城绝宾客，向夕弥幽独。",
        "楼上夜不归，此君留我宿。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 269675,
      "title": "九日登巴台",
      "content": [
        "黍香酒初熟，菊暖花未开。",
        "闲听竹枝曲，浅酌茱萸杯。",
        "去年重阳日，漂泊湓城隈。",
        "今岁重阳日，萧条巴子台。",
        "旅鬓寻已白，乡书久不来。",
        "临觞一搔首，座客亦裴回。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 269676,
      "title": "东城寻春",
      "content": [
        "老色日上面，欢情日去心。",
        "今既不如昔，后当不如今。",
        "今犹未甚衰，每事力可任。",
        "花时仍爱出，酒后尚能吟。",
        "但恐如此兴，亦随日销沈。",
        "东城春欲老，勉强一来寻。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 269677,
      "title": "江上送客",
      "content": [
        "江花已萎绝，江草已消歇。",
        "远客何处归，孤舟今日发。",
        "杜鹃声似哭，湘竹斑如血。",
        "共是多感人，仍为此中别。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 269678,
      "title": "桐花",
      "content": [
        "春令有常候，清明桐始发。",
        "何此巴峡中，桐花开十月。",
        "岂伊物理变，信是土宜别。",
        "地气反寒暄，天时倒生杀。",
        "草木坚强物，所禀固难夺。",
        "风候一参差，荣枯遂乖剌。",
        "况吾北人性，不耐南方热。",
        "强羸寿夭间，安得依时节。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 269679,
      "title": "早祭风伯因怀李十一舍人",
      "content": [
        "远郡虽褊陋，时祀奉朝经。",
        "夙兴祭风伯，天气晓冥冥。",
        "导骑与从吏，引我出东坰。",
        "水雾重如雨，山火高于星。",
        "忽忆早朝日，与君趋紫庭。",
        "步登龙尾道，却望终南青。",
        "一别身向老，所思心未宁。",
        "至今想在耳，玉音尚玲玲。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 269680,
      "title": "花下对酒二首 一",
      "content": [
        "蔼蔼江气春，南宾闰正月。",
        "梅樱与桃杏，次第城上发。",
        "红房烂簇火，素艳纷团雪。",
        "香惜委风飘，愁牵压枝折。",
        "楼中老太守，头上新白发。",
        "冷澹病心情，暄和好时节。",
        "故园音信断，远郡亲宾绝。",
        "欲问花前尊，依然为谁设。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 269681,
      "title": "花下对酒二首 二",
      "content": [
        "引手攀红樱，红樱落似霰。",
        "仰首看白日，白日走如箭。",
        "年芳与时景，顷刻犹衰变。",
        "况是血肉身，安能长强健。",
        "人心苦迷执，慕贵忧贫贱。",
        "愁色常在眉，欢容不上面。",
        "况吾头半白，把镜非不见。",
        "何必花下杯，更待他人劝。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 269682,
      "title": "不二门",
      "content": [
        "两眼日将暗，四肢渐衰瘦。",
        "束带賸昔围，穿衣妨宽袖。",
        "流年似江水，奔注无昏昼。",
        "志气与形骸，安得长依旧。",
        "亦曾登玉陛，举措多纰缪。",
        "至今金阙籍，名姓独遗漏。",
        "亦曾烧大药，消息乖火候。",
        "至今残丹砂，烧干不成就。",
        "行藏事两失，忧恼心交鬬。",
        "化作顦顇翁，抛身在荒陋。",
        "坐看老病逼，须得医王救。",
        "唯有不二门，其间无夭寿。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 269683,
      "title": "我身",
      "content": [
        "我身何所似，似彼孤生蓬。",
        "秋霜翦根断，浩浩随长风。",
        "昔游秦雍间，今落巴蛮中。",
        "昔为意气郎，今作寂寥翁。",
        "外貌虽寂莫，中怀颇冲融。",
        "赋命有厚薄，委心任穷通。",
        "通当为大鹏，举翅摩苍穹。",
        "穷则为鹪鹩，一枝足自容。",
        "苟知此道者，身穷心不穷。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 269684,
      "title": "哭王质夫",
      "content": [
        "仙游寺前别，别来十年余。",
        "生别犹怏怏，死别复何如。",
        "客从梓潼来，道君死不虚。",
        "惊疑心未信，欲哭复踟蹰。",
        "踟蹰寝门侧，声发涕亦俱。",
        "衣上今日泪，箧中前月书。",
        "怜君古人风，重有君子儒。",
        "篇咏陶谢辈，风流嵇阮徒。",
        "出身既蹇屯，生世仍须臾。",
        "诚知天至高，安得不一呼。",
        "江南有毒蟒，江北有妖狐。",
        "皆享千年寿，多于王质夫。",
        "不知彼何德，不识此何辜。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 269685,
      "title": "东坡种花二首 一",
      "content": [
        "持钱买花树，城东坡上栽。",
        "但购有花者，不限桃杏梅。",
        "百果参杂种，千枝次第开。",
        "天时有早晚，地力无高低。",
        "红者霞艳艳，白者雪皑皑。",
        "游蠭逐不去，好鸟亦来栖。",
        "前有长流水，下有小平台。",
        "时拂台上石，一举风前杯。",
        "花枝荫我头，花蘂落我怀。",
        "独酌复独咏，不觉月平西。",
        "巴俗不爱花，竟春无人来。",
        "唯此醉太守，尽日不能回。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 269686,
      "title": "东坡种花二首 二",
      "content": [
        "东坡春向暮，树木今何如。",
        "漠漠花落尽，翳翳叶生初。",
        "每日领童仆，荷鉏仍决渠。",
        "刬土壅其本，引泉溉其枯。",
        "小树低数尺，大树长丈余。",
        "封植来几时，高下随扶疎。",
        "养树既如此，养民亦何殊。",
        "将欲茂枝叶，必先救根株。",
        "云何救根株，劝农均赋租。",
        "云何茂枝叶，省事宽刑书。",
        "移此为郡政，庶几甿俗苏。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 269687,
      "title": "登城东古台",
      "content": [
        "迢迢东郊上，有土青崔嵬。",
        "不知何代物，疑是巴王台。",
        "巴歌久无声，巴宫没黄埃。",
        "靡靡春草合，牛羊缘四隈。",
        "我来一登眺，目极心悠哉。",
        "始见江山势，峰叠水环回。",
        "凭高视听旷，向远胷襟开。",
        "唯有故园念，时时东北来。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 269688,
      "title": "哭诸故人因寄元八",
      "content": [
        "昨日哭寝门，今日哭寝门。",
        "借问所哭谁，无非故交亲。",
        "伟卿既长往，质夫亦幽沦。",
        "屈指数年世，收涕自思身。",
        "彼皆少于我，先为泉下人。",
        "我今头半白，焉得身久存。",
        "好狂元郎中，相识二十春。",
        "昔见君生子，今闻君抱孙。",
        "存者尽老大，逝者已成尘。",
        "早晚升平宅，开眉一见君。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 269689,
      "title": "郡中春䜩因赠诸客",
      "content": [
        "仆本儒家子，待诏金马门。",
        "尘忝亲近地，孤负圣明恩。",
        "一旦奉优诏，万里牧远人。",
        "可怜岛夷帅，自称为使君。",
        "身骑牂牁马，口食涂江鳞。",
        "暗澹绯衫故，斓斑白发新。",
        "是时岁二月，玉历布春分。",
        "颁条示皇泽，命宴及良辰。",
        "冉冉趋府吏，蚩蚩聚州民。",
        "有如蛰虫鸟，亦应天地春。",
        "薰草席铺坐，藤枝酒注樽。",
        "中庭无平地，高下随所陈。",
        "蛮鼓声坎坎，巴女舞蹲蹲。",
        "使君居上头，掩口语众宾。",
        "勿笑风俗陋，勿欺官府贫。",
        "蠭巢与蚁穴，随分有君臣。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 269690,
      "title": "开元寺东池早春",
      "content": [
        "池水暖温暾，水清波潋滟。",
        "簇簇青泥中，新蒲叶如劒。",
        "梅房小白裹，柳彩轻黄染。",
        "顺气草熏熏，适情鸥泛泛。",
        "旧游成梦寐，往事随阳焱。",
        "芳物感幽怀，一动平生念。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    }
  ],
