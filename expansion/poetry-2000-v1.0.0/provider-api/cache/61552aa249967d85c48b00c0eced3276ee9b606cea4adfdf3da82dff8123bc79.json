{
  "data": [
    {
      "id": 45392,
      "title": "南溪山居秋日睡起",
      "content": [
        "客至从嗔不著冠，起来信手揽书看。",
        "小蜂得计欺侬睡，偷饮晴窗砚滴干。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45393,
      "title": "秋夕书怀",
      "content": [
        "老去还多感，归来政倦游。",
        "数峰愁外月，一叶静边秋。",
        "偶忆平生事，真供独笑休。",
        "灯花吾会得，村酒恰当𥬠。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 45394,
      "title": "秋暑二首  其一",
      "content": [
        "一年强半走尘埃，触热还山亦快哉。",
        "幸自西风归较早，却教秋暑伴将来。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45395,
      "title": "秋暑二首  其二",
      "content": [
        "追凉能到竹溪无，隔水斜阳未肯晡。",
        "剩暑不蒙蕉扇扇，细云聊倩月梳梳。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45396,
      "title": "观稼",
      "content": [
        "三年再旱独堪闻，一熟诸村稍作欣。",
        "老子朝朝弄田水，眼看翠浪作黄云。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45397,
      "title": "感秋",
      "content": [
        "旧不悲秋只爱秋，风中吹笛月中楼。",
        "如今秋色浑如旧，欲不悲秋不自由。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45398,
      "title": "送翁志道",
      "content": [
        "平生翁子妙谈天，谁爱青山不爱官。",
        "一笑同看岩下井，秋来能更起微澜。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45399,
      "title": "表弟周明道工于传神而山水亦佳久别来访赠以绝句二首  其一",
      "content": [
        "笔端人物更江山，外弟周郎两不难。",
        "可把吴松半江水，博他头上进贤冠。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45400,
      "title": "表弟周明道工于传神而山水亦佳久别来访赠以绝句二首  其二",
      "content": [
        "侬家有轴郭熙山，堕在冰溪雪岭间。",
        "有弟新来眼如月，为侬洗手拾将还。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45401,
      "title": "送彭元忠司户二首  其一",
      "content": [
        "触热能相访，言归有底忙。",
        "百闻才半面，一别又三湘。",
        "诗入江西社，心传肘后方。",
        "木天须此士，丹笔校官黄。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 45402,
      "title": "送彭元忠司户二首  其二",
      "content": [
        "浯石高仍瘦，愚溪绀且寒。",
        "凭君聊杖屦，道我问平安。",
        "句好今逾进，书来剩寄看。",
        "只言官舍小，簷下过湘滩。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 45403,
      "title": "乙未和杨谨仲教授春兴",
      "content": [
        "归欤还复换年芳，不分官梅恼石肠。",
        "黄帽政堪供短棹，白头可更献长杨。",
        "忽逢社里催搜句，安得花边对举觞。",
        "天上含香有知己，弹冠端复为王阳。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 45404,
      "title": "寄广东提刑林谦之司业",
      "content": [
        "玉节星槎下九天，祝融海若让云烟。",
        "故人一别还三岁，新句如今更几篇。",
        "忆昨待班南内否，论诗看雪未央前。",
        "梦中若个韶州路，庾岭梅花正可怜。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 45405,
      "title": "送子上弟之石井",
      "content": [
        "我生苦终鲜，四海皆弟兄。",
        "四海尚如许，而况吾宗盟。",
        "君年甫弱冠，已有俊异声。",
        "作赋拟三都，著论追过秦。",
        "平生一瓣香，何曾举似人。",
        "子上与济翁，真若吾同生。",
        "我穷无人共，二子慰眼明。",
        "济翁往荆州，君作石井行。",
        "一老便落莫，有话从谁评。",
        "怀哉勿重陈，呼酒且细倾。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 45406,
      "title": "雨中送客",
      "content": [
        "闲人也解有忙时，送客谁令作许痴。",
        "一夜黑风吹白雪，昨朝紫陌总黄泥。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45407,
      "title": "送客夜归呈萧岳英县丞",
      "content": [
        "并舍频过亦几曾，却因送客得同行。",
        "风船逆水四十里，雪屋吹灯三二更。",
        "老去病身禁底苦，向来危宦若为情。",
        "天台香火侬当觅，且伴先生学养生。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 45408,
      "title": "二月望日",
      "content": [
        "海棠著意唤诗愁，桃李才开又落休。",
        "小雨轻风春一半，去年今日在严州。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45409,
      "title": "醉笔呈尚长道",
      "content": [
        "晚风一雨生新涨，只送仙槎到天上。",
        "十年相别一相逢，和气春风谈笑中。",
        "如今耆旧晨星似，犹及先生说遗事。",
        "舌端往往疏九河，只有剩浪无欠波。",
        "汉渠周柱几青竹，却在先生一泓腹。",
        "诸公道是今乏才，如何此士尚尘埃。",
        "此行青规更黄阁，拭目孤鸿径寥廓。",
        "能念南溪病客无，风来肯寄半行书。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 45410,
      "title": "初夏三绝句  其一",
      "content": [
        "麦黄秧碧百家衣，已热犹寒四月时。",
        "雨后觅春无一寸，野蔷薇发酽燕脂。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45411,
      "title": "初夏三绝句  其二",
      "content": [
        "手种琅玕劣十年，今年新笋不胜繁。",
        "不知明早添多少，日暮闲来数一番。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45412,
      "title": "初夏三绝句  其三",
      "content": [
        "竹间露重午方干，松里云深夏亦寒。",
        "只道一溪无十里，为谁百屈更千盘。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45413,
      "title": "行圃",
      "content": [
        "薤本新痕割复齐，豆苗初叶合仍离。",
        "鶑声政好还飞去，不为诗人更许时。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45414,
      "title": "看笋六言",
      "content": [
        "笋如滕薛争长，竹似夷齐独清。",
        "只爱锦绷满地，暗林忽两三茎。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 45415,
      "title": "农家六言",
      "content": [
        "插秧已盖田面，疎苗犹逗水光。",
        "白鸥飞处极浦，黄犊归时夕阳。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 45416,
      "title": "山居",
      "content": [
        "鬓秃犹云少，书多却道穷。",
        "柴门疎竹处，茅屋万山中。",
        "幽梦时能忆，闲题底要工。",
        "不知蝉报夏，为复自吟风。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 45417,
      "title": "有叹",
      "content": [
        "老来无面见毛锥，犹把闲愁付小诗。",
        "若道愁多头易白，鹭鸶从小鬓成丝。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45418,
      "title": "梅熟小雨",
      "content": [
        "风从独树忽然来，雨去前山远却回。",
        "留许枝间慰愁眼，儿童抵死打黄梅。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45419,
      "title": "书王右丞诗后",
      "content": [
        "晚因子厚识渊明，早学苏州得右丞。",
        "忽梦少陵谈句法，劝参庾信谒阴铿。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45420,
      "title": "饭罢登山",
      "content": [
        "树远通鶑响，花晴带雨痕。",
        "登山偶回首，隔水见前村。",
        "澹往孤无伴，清归笑不言。",
        "还家更迟著，松菊未应存。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 45421,
      "title": "待次临漳诸公荐之易地毗陵自媿无济剧才上章丐祠",
      "content": [
        "亦岂真辞禄，谁令自不才。",
        "更须三釜恋，未放两眉开。",
        "道我今贫却，何朝不饭来。",
        "商量若为可，杜宇一声催。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 45422,
      "title": "栀子花",
      "content": [
        "树恰人来短，花将雪样看。",
        "孤姿妍外浄，幽馥暑中寒。",
        "有朶𥮾瓶子，无风忽鼻端。",
        "如何山谷老，只为赋山矾。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 45423,
      "title": "谢傅宣州安道郎中送宣城笔",
      "content": [
        "忽惊骑吏叩柴荆，厚禄移书访死生。",
        "今日犹迟傅岩雨，前身端是谢宣城。",
        "解包兔颖霜盈把，试墨山泉月一泓。",
        "老里苦吟翻作拙，撚须枉断两三茎。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 45424,
      "title": "病疟无聊",
      "content": [
        "病身兀兀意昏昏，急挂东窗避夕曛。",
        "坐看云生还有雨，忽然雨止并无云。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45425,
      "title": "秋典",
      "content": [
        "宿有青霞愿，惟应白鹭知。",
        "风烟聊晚望，山水入秋宜。",
        "老里还多病，贫中却剩诗。",
        "浪愁余热在，会自有凉时。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 45426,
      "title": "中秋与诸子果饮",
      "content": [
        "几年今夕一番逢，千古何人此兴同。",
        "酒入银河波底月，笛吹玉桂树梢风。",
        "莫言秋色无多巧，浄洗清光也费工。",
        "老子病来浑不饮，如何频报绿尊空。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 45427,
      "title": "挽邹彦明",
      "content": [
        "野渡无冰涉，荒民不木饥。",
        "桥横侍郎记，墓立舍人碑。",
        "自古谁无死，何人没后思。",
        "淙淙富川水，便是挽歌词。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 45428,
      "title": "探梅偶李判官餽熊掌",
      "content": [
        "小摘梅花𥮾玉壶，旋糟熊掌削琼肤。",
        "灯前雪里新醅熟，放却先生不醉无。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45429,
      "title": "醉后撚梅花近壁以灯照之宛然如墨梅",
      "content": [
        "老子年来画入神，凿空幻出墨梅春。",
        "壁为玉板灯为笔，整整斜斜样样新。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45430,
      "title": "钓雪舟倦睡",
      "content": [
        "小阁明窗半掩门，看书作睡政昏昏。",
        "无端却被梅花恼，特地吹香破梦魂。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45431,
      "title": "晚步南溪弄水",
      "content": [
        "吾庐在南溪，溪北北山半。",
        "山空谁肯邻，影静鹤为伴。",
        "万松当篱落，千岩上几案。",
        "花草岂厌多，不多亦堪翫。",
        "一丘万事足，半点无外羡。",
        "如何濯双缨，独欠泉一眼。",
        "晚晴漫野步，偶到溪侧畔。",
        "颇怪清浅流，雪后劣如线。",
        "相将二三子，一笑出奇观。",
        "琼砂杂瑶砾，掇拾作微堰。",
        "锵然便淙琤，清若奏琴阮。",
        "当流立孤石，滟滪忽童丱。",
        "不塞势何怒，惟激声故远。",
        "从今日日来，愁肺要湔浣。",
        "儿童俾勿坏，鸥鹭好看管。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 45432,
      "title": "醉眠夜闻霜风甚紧起坐达旦二首  其一",
      "content": [
        "玉酒醺人底易醒，月低梅影恰三更。",
        "只嫌老眼清无睡，不道松声听到明。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45433,
      "title": "醉眠夜闻霜风甚紧起坐达旦二首  其二",
      "content": [
        "雪花旋落旋成融，横作清霜阵阵风。",
        "一夜急吹君会否，妬它残叶恋丹枫。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45434,
      "title": "霜夜望月",
      "content": [
        "人静蛩喧天欲霜，不眠独自步风廊。",
        "闲看月走仍云走，知是云忙复月忙。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45435,
      "title": "瓶中梅花长句",
      "content": [
        "幽人蚤作月满阶，月随幽人登舫斋。",
        "推门欲开犹未开，猛香排门扑我怀。",
        "径从鼻孔上灌顶，拂拂吹尽发底埃。",
        "恍然堕我众香国，欲问何祥无处觅。",
        "冥搜一室一物无，瓶里一枝梅的皪。",
        "平生为梅判断肠，何曾知渠有许香。",
        "夜来偶忘挂南窗，贮此幽馥万斛强。",
        "却忆去年西湖上，锦屏下瞰千青嶂。",
        "谷深梅盛一万株，十顷雪花浮欲涨。",
        "是时雨后初晴前，日光烘花香作烟。",
        "政如新火炷博山，烝出沉水和龙涎。",
        "醉登绝顶撼疎影，掇蕊餐花照冰井。",
        "蜀人老张同舍郎，唤作谪仙侬笑领。",
        "如今茅屋卧山村，更无载酒来叩门。",
        "一尊孤斟懒论文，犹有梅花是故人。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 45436,
      "title": "夜饮以白糖嚼梅花",
      "content": [
        "剪雪作梅只堪嗅，点蜜如霜新可口。",
        "一花自可咽一杯，嚼尽寒花几杯酒。",
        "先生清贫似饥蚊，馋涎流到瘦胫根。",
        "赣江压糖白于玉，好伴梅花聊当肉。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 45437,
      "title": "钓雪舟中霜夜望月",
      "content": [
        "溪边小立苦待月，月知人意偏迟出。",
        "归来闭户闷不看，忽然飞上千峰端。",
        "却登钓雪聊一望，冰轮正挂松梢上。",
        "诗人爱月爱中秋，有人问侬侬掉头。",
        "一年月色只腊里，雪汁揩磨霜水洗。",
        "八荒万里一青天，碧潭浮出白玉盘。",
        "更约梅花作渠伴，中秋不是欠此段。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 45438,
      "title": "梅花下小饮",
      "content": [
        "今年春在腊前回，怪底空山早见梅。",
        "数点有情吹面过，一花无頼背人开。",
        "为携竹叶浇琼树，旋折冰葩浸玉杯。",
        "近节雨晴谁料得，明朝无兴也重来。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 45439,
      "title": "幽居三咏 钓雪舟",
      "content": [
        "青鞋黄帽绿蓑衣，钓雪舟中雪政飞。",
        "归自严州无一物，扁舟载得钓台归。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45440,
      "title": "幽居三咏 云卧庵",
      "content": [
        "十年两袖软红尘，归濯沧浪且幅巾。",
        "不是白云留我住，我留云住卧闲身。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45441,
      "title": "幽居三咏 诚斋",
      "content": [
        "浯溪见了紫岩回，独笑春风尽放怀。",
        "谩向世人谈昨梦，便来唤我作诚斋。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45442,
      "title": "寄题更好轩二首  其一",
      "content": [
        "经丘寻壑恰忙时，更有工夫到得诗。",
        "政用此时索诗债，素兄青士若为痴。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45443,
      "title": "寄题更好轩二首  其二",
      "content": [
        "无梅有竹竹无朋，有竹无梅梅独醒。",
        "雪里霜中两清绝，梅花白白竹青青。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45444,
      "title": "郡中送春盘",
      "content": [
        "餠如茧纸不可风，菜如缥茸劣可缝。",
        "韭芽卷黄苣舒紫，芦菔削冰寒脱齿。",
        "卧沙压玉割红香，部署五珍访诗肠。",
        "野人未见新历日，忽得春盘还太息。",
        "新年五十奈老何，霜须看镜几许多。",
        "曲生嗔人不解事，且为春盘作春醉。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 45445,
      "title": "腊里立春蜂蝶辈出",
      "content": [
        "嫩日催青出冻荄，小风吹白落疎梅。",
        "残冬未放春交割，早有黄蜂紫蝶来。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45446,
      "title": "梅花落尽有感",
      "content": [
        "五树梅花一树迟，花迟花早总离披。",
        "春风只解吹梅落，不为愁人染鬓丝。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45447,
      "title": "丙申岁朝",
      "content": [
        "椒盘又颂一年初，多拜犹欣未要扶。",
        "山色长供青篛笠，春光不为白髭须。",
        "仙家风土闲中是，岁后鶑花较早无。",
        "人事驰驱不须叹，倦来添得睡工夫。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 45448,
      "title": "与刘景明晚步",
      "content": [
        "行尽南溪溪北涯，李花看了看桃花。",
        "归来倦卧呼童子，旋煮山泉瀹建茶。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45449,
      "title": "赠刘景明来访",
      "content": [
        "研席相从昔少年，白头谁信两苍然。",
        "来从八桂三湘外，忆折双松十载前。",
        "告我明朝还又别，对床终夕不成眠。",
        "交游存没休休说，且为梅花釂玉船。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 45450,
      "title": "晓看牡丹呈彭仲庄",
      "content": [
        "牡丹新植旧来无，早起看花花更苏。",
        "晴翠满空天政晓，暖红蒸雾汗成珠。",
        "绝怜嫩日偏催老，犹喜轻寒为给扶。",
        "来岁一株应百朶，只今紫笋绕根须。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 45451,
      "title": "和彭仲庄对牡丹止酒二首  其一",
      "content": [
        "病身无伴卧空山，石友相从慰眼寒。",
        "呼酒撚花谈旧事，牡丹匹似梦中看。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45452,
      "title": "和彭仲庄对牡丹止酒二首  其二",
      "content": [
        "老里心情客里怀，逢花不饮若为开。",
        "虚名身后真何用，更判生前酒一杯。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45453,
      "title": "暮春小雨",
      "content": [
        "宿酒微醒尚小醺，似痴如病不多欣。",
        "深深池沼轻轻雨，独倚栏干看水纹。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45454,
      "title": "夏日绝句",
      "content": [
        "不但春妍夏亦佳，随缘花草是生涯。",
        "鹿葱解插纤长柄，金凤仍开最小花。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45455,
      "title": "小池",
      "content": [
        "泉眼无声惜细流，树阴照水爱晴柔。",
        "小荷才露尖尖角，早有蜻蜓立上头。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45456,
      "title": "题左正卿寿慈堂",
      "content": [
        "万事丝窠黏露珠，奉亲最乐天下无。",
        "丘明远孙千里驹，有母七十发漆如。",
        "雪底笋生冰底鱼，人间无觅天赐渠。",
        "三更月落堂西隅，母自挑灯儿读书。",
        "去年生日不用扶，今年生日健过初。",
        "冰桃碧藕脆如酥，一觞千岁母子俱。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 45457,
      "title": "挽谢母安人胡氏",
      "content": [
        "玉树仍双桂，金花不一书。",
        "雪封青竹笋，雾失白藤舆。",
        "天下谁无母，江西未有渠。",
        "西峰半轮月，松槚政疎疎。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 45458,
      "title": "雨霁幽兴寄张钦夫",
      "content": [
        "大官有重荷，丰廪无薄忧。",
        "草茹我岂腴，饱亦与彼侔。",
        "积雨久自霁，曙光清以幽。",
        "欣然出荆扉，不出旬已周。",
        "初意欲看竹，信步偶临流。",
        "北惊失故岸，东见生新洲。",
        "怀哉古与今，与此岂不犹。",
        "归来翻不乐，隠几到昔游。",
        "平生忘年友，草草相应酬。",
        "暂梦不多款，唤人苦鸣鸠。",
        "山林本无事，亦复扰扰休。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 45459,
      "title": "题刘伯山蕃殖图二首画禾黍稌菽麦  其一",
      "content": [
        "老子平生只荷锄，误携破砚到清都。",
        "归来荒尽西畴却，媿见刘家蕃殖图。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45460,
      "title": "题刘伯山蕃殖图二首画禾黍稌菽麦  其二",
      "content": [
        "黄云翠荚杂玄珠，上熟今年不负渠。",
        "说似田家早收拾，一番风雨一番疎。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45461,
      "title": "极暑题钓雪",
      "content": [
        "暑中北阁望南窗，将谓南窗分外凉。",
        "到得南窗还更热，芙蕖和蕊落幽香。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45462,
      "title": "读书",
      "content": [
        "读书不厌勤，勤甚倦且昏。",
        "不如卷书坐，人书两忘言。",
        "兴来忽开卷，径到百圣源。",
        "说悟本无悟，谈玄初未玄。",
        "当其会心处，只有一欣然。",
        "此乐谁为者，非我亦非天。",
        "自笑终未是，拨书枕头眠。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 45463,
      "title": "六月二十三日立秋",
      "content": [
        "暑中剩喜立秋初，特地西风半点无。",
        "旋汲井花浇睡眼，洒将荷叶看跳珠。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45464,
      "title": "听雨",
      "content": [
        "归舟昔岁宿严陵，雨打疎篷听到明。",
        "昨夜茅簷疎雨作，梦中唤作打篷声。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45465,
      "title": "中秋前二夕钓雪舟中静坐二首  其一",
      "content": [
        "月到南窗小半扉，无灯始觉室生辉。",
        "人间何处冰壶是，身在冰壶却道非。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45466,
      "title": "中秋前二夕钓雪舟中静坐二首  其二",
      "content": [
        "去岁中秋政病余，爱它月色强支吾。",
        "今年老矣差无病，后夜中秋有月无。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45467,
      "title": "中秋无月既望月甚佳二首  其一",
      "content": [
        "中秋无月莫尤天，月入秋来夜夜妍。",
        "且道今宵明月色，何曾减却半分圜。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45468,
      "title": "中秋无月既望月甚佳二首  其二",
      "content": [
        "月到中秋故故无，今宵月好莫渠孤。",
        "旧传月径圜千里，影落金杯只粒珠。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45469,
      "title": "晚兴",
      "content": [
        "双井茶芽醒骨甜，蓬莱香烬倦人添。",
        "蜘蛛政苦空庭阔，风为将丝度别簷。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45470,
      "title": "约刘彦纯会建安寺",
      "content": [
        "邂逅何时可，平章后月凉。",
        "前期来一夕，古寺作重阳。",
        "白酒多多载，黄花急急香。",
        "遣诗愁已遣，何况更连床。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 45471,
      "title": "送客山行",
      "content": [
        "岭云为作小凉天，山店重来忆去年。",
        "独树丹枫谁不见，何须更立万松前。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45472,
      "title": "秋月",
      "content": [
        "夜气凉于水，高斋可当楼。",
        "古来除却月，此外更无秋。",
        "寒入兰心劲，光随菊脚流。",
        "惟愁清不极，清极却成愁。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 45473,
      "title": "雨夜",
      "content": [
        "岁晚能无感，诗成只独哦。",
        "萤光寒欲淡，秋雨暮偏多。",
        "伴老贫无恙，留愁酒肯么。",
        "吟虫将落叶，为我拍还歌。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 45474,
      "title": "秋雨叹十解  其一",
      "content": [
        "雨入秋宵滴到明，不知有意复无情。",
        "若言不搅愁人梦，为许千千万万声。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45475,
      "title": "秋雨叹十解  其二",
      "content": [
        "霖霖滴滴未休休，不解教侬不白头。",
        "却把穷愁比秋雨，犹应秋雨少于愁。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45476,
      "title": "秋雨叹十解  其三",
      "content": [
        "湿侵团扇不能轻，冷逼孤灯分外明。",
        "蕉叶半黄荷叶碧，两家秋雨一家声。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45477,
      "title": "秋雨叹十解  其四",
      "content": [
        "厌听点滴井边桐，起看空蒙一望中。",
        "横著东山三十里，真珠帘外翠屏风。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45478,
      "title": "秋雨叹十解  其五",
      "content": [
        "篱下黄花最恨它，金钿香少泪痕多。",
        "仙人解补银河漏，天上无泥奈许何。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45479,
      "title": "秋雨叹十解  其六",
      "content": [
        "老子愁来只苦吟，一吟一叹为秋霖。",
        "居人只道秋霖苦，不道行人泥更深。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45480,
      "title": "秋雨叹十解  其七",
      "content": [
        "昼落无声夜有声，只堪醉听不堪醒。",
        "簷牙半点能多少，滴入苔阶一寸青。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45481,
      "title": "秋雨叹十解  其八",
      "content": [
        "晓起穷忙作么生，雨中安否问秋英。",
        "枯荷倒尽饶渠著，滴损兰花太薄情。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45482,
      "title": "秋雨叹十解  其九",
      "content": [
        "似雾如尘有却无，须臾密密复疎疎。",
        "忽忘九月清霜晓，唤作蒙蒙二月初。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45483,
      "title": "秋雨叹十解  其一○",
      "content": [
        "不是簷声不放眠，只将愁思压衰年。",
        "道他滴沥浑无頼，不到侯门舞袖边。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45484,
      "title": "寄题刘直卿冰壶二首  其一",
      "content": [
        "外看积翠玉千峰，中有清池月半弓。",
        "更拓长堤三十里，剩栽杨柳与芙蓉。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45485,
      "title": "寄题刘直卿冰壶二首  其二",
      "content": [
        "壶里清冰冰里人，个边无地可留尘。",
        "何时去弄池中月，照我星星白发新。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45486,
      "title": "寄题王国华环秀楼二首  其一",
      "content": [
        "近山远岫不知重，暖翠晴岚只满空。",
        "珍重主人将好手，尽驱秀色入楼中。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45487,
      "title": "寄题王国华环秀楼二首  其二",
      "content": [
        "平地看山山绝低，上楼山色逐层奇。",
        "不知山与楼争长，为复楼随山却移。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45488,
      "title": "赠尚长道签判",
      "content": [
        "今代高人尚子平，风流文采旧家声。",
        "合于玉笋班中立，却向红莲幕里行。",
        "天色恼人浑欲雪，烛花照别若为情。",
        "日边已办除书著，莫恋南楼秋月明。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 45489,
      "title": "赠尚献之",
      "content": [
        "老凤苍然姿，雏凤锵然鸣。",
        "一见渠父子，令人英气生。",
        "大尚傲一世，不肯揖公卿。",
        "小尚刷羽毛，势欲追风鹏。",
        "吾州八千士，下笔电雹声。",
        "小尚洒墨汁，一笑万人惊。",
        "姓名登天府，纸价高帝城。",
        "勗哉更摩厉，制胜在此行。",
        "相遭又相别，勿作儿女情。",
        "舟行得秀句，寄我增双明。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 45490,
      "title": "题陈叔虎绣梅花扇",
      "content": [
        "指下生寒影，针端即化工。",
        "冰痕将雪点，不受烛光融。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 45491,
      "title": "和彭仲庄七言",
      "content": [
        "向来年少今老翁，随身不去只有穷。",
        "请君与我共看镜，岂复平生冰雪容。",
        "秋霖暗天瘦日色，满掇黄花当朝食。",
        "何人裹饭问子桑，穷里逢君自为客。",
        "空山冻吟只自奇，故人之外谁相知。",
        "今年相从岂不好，安得到老长追随。",
        "喜君诗思未渠薄，秋后花鹰兔边落。",
        "惭我短才涩欲无，霜余冰涧流还涸。",
        "君游宣溪何日来，愁城封闭待君开。",
        "定知此行脱寒谷，领取阳春一并回。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    }
  ],
