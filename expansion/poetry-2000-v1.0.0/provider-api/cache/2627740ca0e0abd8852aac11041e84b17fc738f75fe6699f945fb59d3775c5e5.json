{
  "data": [
    {
      "id": 280030,
      "title": "过唐校书书斋",
      "content": [
        "池满风吹竹，时时得爽神。",
        "声齐雏鸟语，画卷老僧真。",
        "月出行几步，花开到四邻。",
        "江湖心自切，未可挂头巾。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280031,
      "title": "送杜秀才东游",
      "content": [
        "东游谁见待，尽室寄长安。",
        "别后叶频落，去程山已寒。",
        "大河风色度，旷野烧烟残。",
        "匣有青铜镜，时将照鬓看。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280032,
      "title": "送天台僧",
      "content": [
        "远梦归华顶，扁舟背岳阳。",
        "寒蔬修净食，夜浪动禅床。",
        "鴈过孤峰晓，猨啼一树霜。",
        "身心无别念，余习在诗章。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280033,
      "title": "怀紫阁隐者",
      "content": [
        "寂寥思隐者，孤烛坐秋霖。",
        "梨栗猨喜熟，云山僧说深。",
        "寄书应不到，结伴拟同寻。",
        "废寝方终夕，迢迢紫阁心。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280034,
      "title": "雨夜同厉玄怀皇甫荀",
      "content": [
        "桐竹遶庭匝，雨多风更吹。",
        "还如旧山夜，卧听瀑泉时。",
        "碛鴈来期近，秋钟到梦迟。",
        "沟西吟苦客，中夕话兼思。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280035,
      "title": "秋暮",
      "content": [
        "北门杨柳叶，不觉已缤纷。",
        "值鹤因临水，迎僧忽背云。",
        "白须相并出，清泪两行分。",
        "默默空朝夕，苦吟谁喜闻。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280036,
      "title": "哭胡遇",
      "content": [
        "夭寿知齐理，何曾免叹嗟。",
        "祭回收朔雪，吊后折寒花。",
        "野水秋吟断，空山暮影斜。",
        "弟兄相识徧，犹得到君家。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280037,
      "title": "送丹师归闽中",
      "content": [
        "波涛路杳然，衰柳落阳蝉。",
        "行李经雷电，禅前漱岛泉。",
        "归林久别寺，过越未离船。",
        "自说从今去，身应老海边。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280038,
      "title": "送安南惟鉴法师",
      "content": [
        "讲经春殿里，花遶御床飞。",
        "南海几回渡，旧山临老归。",
        "潮摇蛮草落，月湿岛松微。",
        "空水既如彼，往来消息稀。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280039,
      "title": "题李凝幽居",
      "content": [
        "闲居少邻并，草径入荒园。",
        "鸟宿池边树，僧敲月下门。",
        "过桥分野色，移石动云根。",
        "暂去还来此，幽期不负言。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280040,
      "title": "送韩湘",
      "content": [
        "挂席从古路，长风起广津。",
        "楚城花未发，上苑蝶来新。",
        "半没湖波月，初生岛草春。",
        "孤霞临石镜，极浦映村神。",
        "细响吟干苇，余馨动远苹。",
        "欲凭将一札，寄与沃洲人。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 280041,
      "title": "寄董武",
      "content": [
        "虽同一城里，少省得从容。",
        "门掩园林僻，日高巾帻慵。",
        "孤鸿来半夜，积雪在诸峰。",
        "正忆毗陵客，声声隔水钟。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280042,
      "title": "宿赟上人房",
      "content": [
        "堦前多是竹，闲地拟栽松。",
        "朱点草书疏，雪平麻履踪。",
        "御沟寒夜雨，宫寺静时钟。",
        "此时无他事，来寻不厌重。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280043,
      "title": "访李甘原居",
      "content": [
        "原西居处静，门对曲江开。",
        "石缝衔枯草，查根上净苔。",
        "翠微泉夜落，紫阁鸟时来。",
        "仍忆寻淇岸，同行采蕨回。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280044,
      "title": "题山寺井",
      "content": [
        "沈沈百尺余，功就岂斯须。",
        "汲早僧出定，凿新虫自无。",
        "藏源重嶂底，澄翳大空隅。",
        "此地如经劫，凉潭会共枯。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280045,
      "title": "僻居无可上人相访",
      "content": [
        "自从居此地，少有事相关。",
        "积雨荒邻圃，秋池照远山。",
        "砚中枯叶落，枕上断云闲。",
        "野客将禅子，依依偏往还。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280046,
      "title": "送李余及第归蜀",
      "content": [
        "知音伸久屈，觐省去光辉。",
        "津渡逢清夜，途程尽翠微。",
        "云当绵竹叠，鸟离锦江飞。",
        "肯寄书来否，原居出亦稀。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280047,
      "title": "荒斋",
      "content": [
        "草合径微微，终南对掩扉。",
        "晚凉疎雨绝，初晓远山稀。",
        "落叶无青地，闲身著白衣。",
        "朴愚犹本性，不是学忘机。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280048,
      "title": "夜喜贺兰三见访",
      "content": [
        "漏钟仍夜浅，时节欲秋分。",
        "泉聒栖松鹤，风除翳月云。",
        "踏苔行引兴，枕石卧论文。",
        "即此寻常静，来多秖是君。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280049,
      "title": "题青龙寺镜公房",
      "content": [
        "一夕曾留宿，终南摇落时。",
        "孤灯冈舍掩，残磬雪风吹。",
        "树老因寒折，泉深出井迟。",
        "疎慵岂有事，多失上方期。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280050,
      "title": "送陈判官赴绥德",
      "content": [
        "将军邀入幕，束带便离家。",
        "身暖蕉衣窄，天寒碛日斜。",
        "火烧冈断苇，风卷雪平沙。",
        "丝竹丰州有，春来秖欠花。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280051,
      "title": "送唐环归敷水庄",
      "content": [
        "毛女峰当户，日高头未梳。",
        "地侵山影扫，叶带露痕书。",
        "松径僧寻药，沙泉鹤见鱼。",
        "一川风景好，恨不有吾庐。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280052,
      "title": "原东居喜唐温琪频至",
      "content": [
        "曲江春草生，紫阁雪分明。",
        "汲井尝泉味，听钟问寺名。",
        "墨研秋日雨，茶试老僧铛。",
        "地近劳频访，乌纱出送迎。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280053,
      "title": "送敭法师",
      "content": [
        "度岁不相见，严冬始出关。",
        "孤烟寒色树，高雪夕阳山。",
        "瀑布寺应到，牡丹房甚闲。",
        "南朝遗迹在，此去几时还。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280054,
      "title": "寄钱庶子",
      "content": [
        "曲江春水满，北岸掩柴关。",
        "秖有僧邻舍，全无物映山。",
        "树阴终日扫，药债隔年还。",
        "犹记听琴夜，寒灯竹屋间。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280055,
      "title": "原上秋居",
      "content": [
        "关西又落木，心事复如何。",
        "岁月辞山久，秋霖入夜多。",
        "鸟从井口出，人自洛阳过。",
        "倚杖聊闲望，田家未翦禾。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280056,
      "title": "夏夜",
      "content": [
        "原寺偏邻近，开门物景澄。",
        "磬通多叶罅，月离片云棱。",
        "寄宿山中鸟，相寻海畔僧。",
        "唯愁秋色至，乍可在炎蒸。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280057,
      "title": "冬夜",
      "content": [
        "羁旅复经冬，瓢空盎亦空。",
        "泪流寒枕上，迹绝旧山中。",
        "凌结浮萍水，雪和衰柳风。",
        "曙光鸡未报，嘹唳两三鸿。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280058,
      "title": "送厉宗上人",
      "content": [
        "拥策背岷峨，终南雨雪和。",
        "漱泉秋鹤至，禅树夜猨过。",
        "高顶白云尽，前山黄叶多。",
        "曾吟庐岳上，月动九江波。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280059,
      "title": "寄李存穆",
      "content": [
        "闻道船中病，似忧亲弟兄。",
        "信来从水路，身去到柴城。",
        "久别长须鬓，相思书姓名。",
        "忽然消息绝，频梦却还京。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280060,
      "title": "赠无怀禅师",
      "content": [
        "身从劫劫修，果以此生周。",
        "禅定石床暖，月移山树秋。",
        "捧盂观宿饭，敲磬过清流。",
        "不掩玄关路，教人问白头。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280061,
      "title": "寄武功姚主簿",
      "content": [
        "居枕江沱北，情悬渭曲西。",
        "数宵曾梦见，几处得书披。",
        "驿路穿荒坂，公田带淤泥。",
        "静棋功奥妙，闲作韵清凄。",
        "锄草留丛药，寻山上石梯。",
        "客回河水涨，风起夕阳低。",
        "空地苔连井，孤村火隔溪。",
        "卷帘黄叶落，锁印子规啼。",
        "陇色澄秋月，边声入战鼙。",
        "会须过县去，况是屡招携。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 280062,
      "title": "题刘华书斋",
      "content": [
        "白石床无尘，青松树有鳞。",
        "一莺啼带雨，两树合从春。",
        "荒榭苔胶砌，幽丛果堕榛。",
        "偶来疎或数，当暑夕胜晨。",
        "露滴星河水，巢重草木薪。",
        "终南同往意，赵北独游身。",
        "渡叶司天漏，惊蛩远地人。",
        "机清公干族，也莫卧漳滨。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 280063,
      "title": "送卢秀才游潞府",
      "content": [
        "雨余滋润在，风不起尘沙。",
        "边日寡文思，送君吟月华。",
        "过山干相府，临水宿僧家。",
        "能赋焉长屈，芳春宴杏花。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280064,
      "title": "送南康姚明府",
      "content": [
        "铜章美少年，小邑在南天。",
        "版籍多迁客，封疆接洞田。",
        "静江鸣野鼓，发缆带村烟。",
        "却笑陶元亮，何须忆醉眠。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280065,
      "title": "送友人弃官游江左",
      "content": [
        "羡君休作尉，万事且全身。",
        "寰海多虞日，江湖独往人。",
        "姓名何处变，鸥鸟几时亲。",
        "别后吴中使，应须访子真。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 280066,
      "title": "雨中怀友人",
      "content": [
        "对雨思君子，尝茶近竹幽。",
        "儒家邻古寺，不到又逢秋。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 280067,
      "title": "寄远",
      "content": [
        "家住锦水上，身征辽海边。",
        "十书九不到，一到忽经年。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 280068,
      "title": "南斋",
      "content": [
        "独自南斋卧，神闲景亦空。",
        "有山来枕上，无事到心中。",
        "帘卷侵床月，屏遮入座风。",
        "望春春未至，应在海门东。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280069,
      "title": "早春题友人湖上新居二首 一",
      "content": [
        "近得云中路，门长侵早开。",
        "到时犹有雪，行处已无苔。",
        "劝酒客初醉，留茶僧未来。",
        "每逢晴暖日，惟见乞花栽。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280070,
      "title": "早春题友人湖上新居二首 二",
      "content": [
        "门不当官道，行人到亦稀。",
        "故从餐后出，多是夜深归。",
        "开箧收诗卷，扫床移卧衣。",
        "几时同买宅，相送有柴扉。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280071,
      "title": "送雍陶入蜀",
      "content": [
        "江山事若谙，那肯滞云南。",
        "草色分危磴，杉阴近古潭。",
        "日斜襃谷鸟，夏浅巂州蚕。",
        "吾自疑双鬓，相逢更不堪。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280072,
      "title": "张郎中过原东居",
      "content": [
        "年长惟添嬾，经旬止掩关。",
        "高人餐药后，下马此林间。",
        "对坐天将暮，同来客亦闲。",
        "几时能重至，水味似深山。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280073,
      "title": "荅王建秘书",
      "content": [
        "人皆闻蟋蟀，我独恨蹉跎。",
        "白发无心镊，青山去意多。",
        "信来漳浦岸，期负洞庭波。",
        "时扫高槐影，朝回或恐过。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280074,
      "title": "送李余往湖南",
      "content": [
        "昔去候温凉，秋山满楚乡。",
        "今来从辟命，春物徧涔阳。",
        "岳石挂海雪，野枫堆渚樯。",
        "若寻吾祖宅，寂寞在潇湘。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280075,
      "title": "偶作",
      "content": [
        "野步随吾意，那知是与非。",
        "稔年时雨足，闰月暮蝉稀。",
        "独树依冈老，遥峰出草微。",
        "园林自有主，宿鸟且同归。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280076,
      "title": "过雍秀才居",
      "content": [
        "夏木鸟巢边，终南岭色鲜。",
        "就凉安坐石，煮茗汲邻泉。",
        "钟远清霄半，蜩稀暑雨前。",
        "幽斋如葺罢，约我一来眠。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280077,
      "title": "寄顾非熊",
      "content": [
        "知君归有处，山水亦难齐。",
        "犹去潇湘远，不闻猨狖啼。",
        "穴通茆岭下，潮满石头西。",
        "独立生遥思，秋原日渐低。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280078,
      "title": "送神邈法师",
      "content": [
        "柳絮落蒙蒙，西州道路中。",
        "相逢春忽尽，独去讲初终。",
        "行疾遥山雨，眠迟后夜风。",
        "绕房三两树，回日叶应红。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280079,
      "title": "送慈恩寺霄韵法师谒太原李司空",
      "content": [
        "何故谒司空，云山知几重。",
        "碛遥来鴈尽，雪急去僧逢。",
        "清磬先寒角，禅灯彻晓烽。",
        "旧房闲片石，倚著最高松。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280080,
      "title": "送知兴上人",
      "content": [
        "久住巴兴寺，如今始拂衣。",
        "欲临秋水别，不向故园归。",
        "锡挂天涯树，房开岳顶扉。",
        "下看千里晓，霜海日生微。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280081,
      "title": "送惠雅法师归玉泉",
      "content": [
        "秖到潇湘水，洞庭湖未游。",
        "饮泉看月别，下峡听猨愁。",
        "讲不停雷雨，吟当近海流。",
        "降霜归楚夕，星冷玉泉秋。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280082,
      "title": "忆江上吴处士",
      "content": [
        "闽国扬帆去，蟾蜍亏复团。",
        "秋风生渭水，落叶满长安。",
        "此地聚会夕，当时雷雨寒。",
        "兰桡殊未返，消息海云端。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280083,
      "title": "题张博士新居",
      "content": [
        "青枫何不种，林在洞庭村。",
        "应为三湘远，难移万里根。",
        "斗牛初过伏，菡萏欲香门。",
        "旧即湖山隐，新庐葺此原。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280084,
      "title": "石门陂留辞从叔謩",
      "content": [
        "幽鸟飞不远，此行千里间。",
        "寒冲陂水雾，醉下菊花山。",
        "有耻长为客，无成又入关。",
        "何时临涧柳，吾党共来攀。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280085,
      "title": "送朱兵曹回越",
      "content": [
        "星彩练中见，澄江岂有泥。",
        "潮生垂钓罢，楚尽去樯西。",
        "碛鸟辞沙至，山鼯隔水啼。",
        "会稽半侵海，涛白禹祠溪。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280086,
      "title": "怀博陵故人",
      "content": [
        "孤城易水头，不忘旧交游。",
        "雪压围碁石，风吹饮酒楼。",
        "路遥千万里，人别十三秋。",
        "吟苦相思处，天寒水急流。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280087,
      "title": "夕思",
      "content": [
        "秋宵已难曙，漏向二更分。",
        "我忆山水坐，虫当寂寞闻。",
        "洞庭风落木，天姥月离云。",
        "会自东浮去，将何欲致君。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280088,
      "title": "寄河中杨少尹",
      "content": [
        "非惟咎曩时，投刺诣门迟。",
        "怅望三秋后，参差万里期。",
        "禹留疏凿迹，舜在寂寥祠。",
        "此到杳难共，回风逐所思。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280089,
      "title": "孟融逸人",
      "content": [
        "孟君临水居，不食水中鱼。",
        "衣褐唯麤帛，筐箱秖素书。",
        "树林幽鸟恋，世界此心疎。",
        "拟棹孤舟去，何峰又结庐。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280090,
      "title": "晚晴见终南诸峰",
      "content": [
        "秦分积多峰，连巴势不穷。",
        "半旬藏雨里，此日到窗中。",
        "圆魄将升兔，高空欲呌鸿。",
        "故山思不见，碣石泬寥东。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280091,
      "title": "宿池上",
      "content": [
        "泉来从绝壑，亭敞在中流。",
        "竹密无空岸，松长可绊舟。",
        "蟪蛄潭上夜，河汉岛前秋。",
        "异夕期深涨，携琴却此游。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280092,
      "title": "喜姚郎中自杭州回",
      "content": [
        "路多枫树林，累日泊清阴。",
        "来去泛流水，翛然适此心。",
        "一披江上作，三起月中吟。",
        "东省期司谏，云门悔不寻。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280093,
      "title": "送郑长史之岭南",
      "content": [
        "云林颇重叠，岑渚复幽奇。",
        "汨水斜阳岸，骚人正则祠。",
        "苍梧多蟋蟀，白露湿江蓠。",
        "擢第荣南去，晨昏近九疑。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280094,
      "title": "送李溟谒宥州李权使君",
      "content": [
        "英雄典宥州，迢遰苦吟游。",
        "风宿骊山下，月斜灞水流。",
        "去时初落叶，回日定非秋。",
        "太守携才子，看鹏百尺楼。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280095,
      "title": "永福湖和杨郑州",
      "content": [
        "积水还平岸，春来引郑溪。",
        "旧渠通郭下，新堰绝湖西。",
        "嵩少分明对，潇湘阔狭齐。",
        "客游随庶子，孤屿草萋萋。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280096,
      "title": "题长江",
      "content": [
        "言心俱好静，廨署落晖空。",
        "归吏封宵钥，行蛇入古桐。",
        "长江频雨后，明月众星中。",
        "若任迁人去，西溪与剡通。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280097,
      "title": "泥阳馆",
      "content": [
        "客愁何并起，暮送故人回。",
        "废馆秋萤出，空城寒雨来。",
        "夕阳飘白露，树影扫青苔。",
        "独坐离容惨，孤灯照不开。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280098,
      "title": "送徐员外赴河中",
      "content": [
        "原野正萧瑟，中间分散情。",
        "吏从甘扈罢，诏许朔方行。",
        "边日沈残角，河关截夜城。",
        "云居闲独往，长老出房迎。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280099,
      "title": "送贺兰上人",
      "content": [
        "野僧来别我，略坐傍泉沙。",
        "远道擎空钵，深山蹋落花。",
        "无师禅自解，有格句堪夸。",
        "此去非缘事，孤云不定家。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280100,
      "title": "送令狐绹相公",
      "content": [
        "梁园趋戟节，海草几枯春。",
        "风水难遭便，差池未振鳞。",
        "姓名犹语及，门馆阻何因。",
        "苦拟修文卷，重擎献匠人。",
        "吟看青岛处，朝退赤墀晨。",
        "根爱杉栽活，枝怜雪霰新。",
        "缀篇嗟调逸，不知揣才贫。",
        "早晚还霖雨，滂沱洗月轮。",
        "揠苗方灭裂，成器待陶钧。",
        "困坂思回顾，迷邦輙问津。",
        "数行望外札，绝句握中珍。",
        "是日荣游汴，当时怯往陈。",
        "鸿舂乖汉爵，[桢]病卧漳滨。",
        "岳整五千仞，云惟一片身。",
        "故山离未死，秋水宿经旬。",
        "下第能无恧，高科恐有神。",
        "罢耕田料废，省钓岸应榛。",
        "慷慨知音在，谁能泪堕巾。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 280101,
      "title": "寄沧州李尚书",
      "content": [
        "沧溟深绝阔，西岸郭东门。",
        "弋者罗夷鸟，桴人思峤猨。",
        "威棱高腊冽，煦育极春温。",
        "陂淀封疆内，蒹葭壁垒根。",
        "摇鞞边地脉，愁箭虎狼魂。",
        "水县卖纱市，盐田煮海村。",
        "枝条分御叶，家世食唐恩。",
        "武可纵横讲，功从战伐论。",
        "天涯生月片，屿顶涌泉源。",
        "非是泥池物，方因雷雨尊。",
        "沈谋藏未露，隣境帖无喧。",
        "青冢骄回鹘，萧关陷吐蕃。",
        "何时霖岁旱，早晚雪邦冤。",
        "迢遰瞻旌纛，浮阳寄咏言。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 280102,
      "title": "逢旧识",
      "content": [
        "几岁阻干戈，今朝劝酒歌。",
        "羡君无白发，走马过黄河。",
        "旧宅兵烧尽，新宫日奏多。",
        "妖星还有角，数尺铁重磨。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280103,
      "title": "崇圣寺斌公房",
      "content": [
        "近来惟一食，树下掩禅扉。",
        "落日寒山磬，多年坏衲衣。",
        "白须长更剃，青霭远还归。",
        "仍说游南岳，经行是息机。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280104,
      "title": "送李傅侍郎劒南行营",
      "content": [
        "走马从边事，新恩受外台。",
        "勇看双节出，期破八蛮回。",
        "许国家无恋，盘江栈不摧。",
        "移军刁斗逐，报捷劒门开。",
        "角咽狝猴呌，鼙干霹雳来。",
        "去年新甸邑，犹滞佐时才。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 280105,
      "title": "别徐明府",
      "content": [
        "抱琴非本意，生事偶相萦。",
        "口尚袁安节，身无子贱名。",
        "地寒春雪盛，山浅夕风轻。",
        "百战余荒野，千夫渐耦耕。",
        "一杯宜独夜，孤客恋交情。",
        "明日疲骖去，萧条过古城。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 280106,
      "title": "岐下送友人归襄阳",
      "content": [
        "蹉跎随泛梗，羁旅到西州。",
        "举翮笼中鸟，知心海上鸥。",
        "山光分首暮，草色向家秋。",
        "若更登高岘，看碑定泪流。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 280107,
      "title": "送友人游蜀",
      "content": [
        "万岑深积翠，路向此中难。",
        "欲暮多羁思，因高莫远看。",
        "卓家人寂寞，扬子业凋残。",
        "唯有岷江水，悠悠带月寒。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 280108,
      "title": "送郑少府",
      "content": [
        "江岸一相见，空令惜此分。",
        "夕阳行带月，酌水少留君。",
        "野地初烧草，荒山过雪云。",
        "明年还调集，蝉可在家闻。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280109,
      "title": "子规",
      "content": [
        "游魂自相呌，宁复记前身。",
        "飞过隣家月，声连野路春。",
        "梦边催晓急，愁处送风频。",
        "自有霑花血，相和雨滴新。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280110,
      "title": "送僧归天台",
      "content": [
        "辞秦经越过，归寺海西峰。",
        "石磵双流水，山门九里松。",
        "曾闻清禁漏，却听赤城钟。",
        "妙宇研磨讲，应齐智者踪。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280111,
      "title": "让𫄙曹上乐使君",
      "content": [
        "战战复兢兢，犹如履薄冰。",
        "虽然叨一掾，还似说三乘。",
        "瓶汲南溪水，书来北岳僧。",
        "戆愚兼抱疾，权纪不相应。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280112,
      "title": "赠友人",
      "content": [
        "五字诗成卷，清新韵具偕。",
        "不同狂客醉，自伴律僧斋。",
        "春别和花树，秋辞带月淮。",
        "却归登第日，名近榜头排。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280113,
      "title": "送雍陶及第归成都宁亲",
      "content": [
        "不唯诗著籍，兼又赋知名。",
        "议论于题称，春秋对问精。",
        "半应阴隲与，全赖有司平。",
        "归去峰峦众，别来松桂生。",
        "涨江流水品，当道白云坑。",
        "勿以攻文捷，而将学劒轻。",
        "制衣新濯锦，开酝旧烧罂。",
        "同日升科士，谁同膝下荣。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 280114,
      "title": "谢令狐绹相公赐衣九事",
      "content": [
        "长江飞鸟外，主簿跨驴归。",
        "逐客寒前夜，元戎予厚衣。",
        "雪来松更绿，霜降月弥辉。",
        "即日调殷鼎，朝分是与非。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280115,
      "title": "送金州鉴周上人",
      "content": [
        "地必寻天目，溪仍住若耶。",
        "帆随风便发，月不要云遮。",
        "极浦浮霜雁，回潮落海查。",
        "峨嵋省春上，立雪指流沙。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280116,
      "title": "送谭远上人",
      "content": [
        "下视白云时，山房盖树皮。",
        "垂枝松落子，侧顶鹤听棋。",
        "清净从沙劫，中终未日欹。",
        "金光明本行，同侍出峨嵋。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280117,
      "title": "新年",
      "content": [
        "嗟以龙钟身，如何岁复新。",
        "石门思隐久，铜镜强窥频。",
        "花发新移树，心知故国春。",
        "谁能平此恨，岂是北宗人。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280118,
      "title": "送僧",
      "content": [
        "出家从丱岁，解论造玄门。",
        "不惜挥谈柄，谁能听至言。",
        "中时山果熟，后夏竹阴繁。",
        "此去逢何日，峨嵋晓复昏。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280119,
      "title": "送姚杭州",
      "content": [
        "白云峰下城，日夕白云生。",
        "人老江波钓，田侵海树耕。",
        "吴山钟入越，莲叶吹摇旌。",
        "诗异石门思，涛来向越迎。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280120,
      "title": "夜集田卿宅",
      "content": [
        "朗咏高斋下，如将古调弹。",
        "翻鸿向桂水，来雪渡桑干。",
        "滴滴玉漏曙，翛翛竹籁残。",
        "曩年曾宿此，亦值五陵寒。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280121,
      "title": "寄山友长孙栖峤",
      "content": [
        "此时气萧飒，琴院可应关。",
        "鹤似君无事，风吹雨遍山。",
        "松生青石上，泉落白云间。",
        "有径连高顶，心期相与还。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280122,
      "title": "詶厉玄",
      "content": [
        "我来从北鄙，子省涉西陵。",
        "白发初相识，秋山拟共登。",
        "邻居帝城雨，会宿御沟冰。",
        "未报见贻作，耿然中夜兴。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280123,
      "title": "送刘式洛中觐省",
      "content": [
        "晴峰三十六，侍立上春台。",
        "同宿别离恨，共看星月回。",
        "野莺临苑语，河櫂历江来。",
        "便寄相思札，缄封花下开。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280124,
      "title": "送空公往金州",
      "content": [
        "七百里山水，手中楖栗麤。",
        "松生师坐石，潭涤祖传盂。",
        "长拟老岳峤，又闻思海湖。",
        "惠能同俗姓，不是岭南卢。"
      ],
      "author": {
        "id": 1817,
        "name": "贾岛"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280125,
      "title": "赠绍明上人",
      "content": [
        "未住青云室，中秋独往年。",
        "上方嵩若寺，下视雨和烟。",
        "祖岂无言去，心因断臂传。",
        "不知能已后，更有几灯然。"
      ],
