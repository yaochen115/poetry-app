{
  "data": [
    {
      "id": 132136,
      "title": "开元天宝杂咏 美人呵笔",
      "content": [
        "冻笔能回雪殿春，君恩珍重遣宫嫔。",
        "金花牋上清平乐，倚得词工却误人。"
      ],
      "author": {
        "id": 5359,
        "name": "萧立之"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 298324,
      "title": "清平乐",
      "content": [
        "别来春半，触目愁肠断。",
        "砌下落梅如雪乱，拂了一身还满。",
        "雁来音信无凭，路遥归梦难成。",
        "离恨却如春草，更行更远还生。"
      ],
      "author": {
        "id": 11675,
        "name": "后主煜"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298362,
      "title": "清平乐 一",
      "content": [
        "禁庭春昼，莺羽披新绣。",
        "百草巧求花下鬬，祗赌珠玑满斗。",
        "日晚却理残妆，御前闲舞霓裳。",
        "谁道腰肢窈窕，折旋笑得君王。"
      ],
      "author": {
        "id": 2045,
        "name": "李白"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298363,
      "title": "清平乐 二",
      "content": [
        "禁闱秋夜，月探金窗罅。",
        "玉帐鸳鸯喷兰麝，时落银灯香灺。",
        "女伴莫话孤眠，六宫罗绮三千。",
        "一笑皆生百媚，宸衷教在谁边。"
      ],
      "author": {
        "id": 2045,
        "name": "李白"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298364,
      "title": "清平乐 三",
      "content": [
        "烟深水阔，音信无由达。",
        "惟有碧天云外月，偏照悬悬离别。",
        "尽日感事伤怀，愁眉似锁难开。",
        "夜夜长留半被，待君魂梦归来。"
      ],
      "author": {
        "id": 2045,
        "name": "李白"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298365,
      "title": "清平乐 四",
      "content": [
        "鸾衾凤褥，夜夜常孤宿。",
        "更被银台红蜡烛，学妾泪珠相续。",
        "花貌些子时光，抛人远泛潇湘。",
        "欹枕悔听寒漏，声声滴断愁肠。"
      ],
      "author": {
        "id": 2045,
        "name": "李白"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298366,
      "title": "清平乐 五",
      "content": [
        "画堂晨起，来报雪花坠。",
        "高卷帘栊看佳瑞，皓色远迷庭砌。",
        "盛气光引炉烟，素草寒生玉佩。",
        "应是天仙狂醉，乱把白云揉碎。"
      ],
      "author": {
        "id": 2045,
        "name": "李白"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298464,
      "title": "清平乐 一",
      "content": [
        "上阳春晚，宫女愁蛾浅。",
        "新岁清平思同辇，争奈长安路远。",
        "凤帐鸳被徒熏，寂寞花琐千门。",
        "竞把黄金买赋，为妾将上明君。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298465,
      "title": "清平乐 二",
      "content": [
        "洛阳愁绝，杨柳花飘雪。",
        "终日行人争攀折，桥下水流呜咽。",
        "上马争劝离觞，南浦鸎声断肠。",
        "愁杀平原年少，回首挥泪千行。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298539,
      "title": "清平乐 一",
      "content": [
        "春愁南陌，故国音书隔。",
        "细雨霏霏梨花白，燕拂画帘金额。",
        "尽日相望王孙，尘满衣上泪痕。",
        "谁向桥边吹笛，驻马西望销魂。"
      ],
      "author": {
        "id": 6755,
        "name": "韦庄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298540,
      "title": "清平乐 二",
      "content": [
        "野花芳草，寂寞关山道。",
        "柳吐金丝莺语早，惆怅香闺暗老。",
        "罗带悔结同心，独凭朱阑思深。",
        "梦觉半床斜月，小窗风触鸣琴。"
      ],
      "author": {
        "id": 6755,
        "name": "韦庄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298541,
      "title": "清平乐 三",
      "content": [
        "何处游女，蜀国多云雨。",
        "云解有情花解语，窣地绣罗金缕。",
        "妆成不整金钿，含羞待月秋千。",
        "住在绿槐阴里，门临春水桥边。"
      ],
      "author": {
        "id": 6755,
        "name": "韦庄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298542,
      "title": "清平乐 四",
      "content": [
        "莺啼残月，绣阁香灯灭。",
        "门外马嘶郎欲别，正是落花时节。",
        "妆成不画蛾眉，含愁独倚金扉。",
        "去路香尘莫扫，扫即郎去归迟。"
      ],
      "author": {
        "id": 6755,
        "name": "韦庄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298543,
      "title": "清平乐 五",
      "content": [
        "琐窗春暮，满地梨花雨。",
        "君不归来情又去，红泪散霑金缕。",
        "梦魂飞断烟波，伤心不奈春何。",
        "空把金针独坐，鸳鸯愁绣双窠。"
      ],
      "author": {
        "id": 6755,
        "name": "韦庄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298544,
      "title": "清平乐 六",
      "content": [
        "绿杨春雨，金线飘千缕。",
        "花拆香枝黄鹂语，玉勒雕鞍何处。",
        "碧窗望断燕鸿，翠帘睡眼溟蒙。",
        "宝瑟谁家弹罢，含悲斜倚屏风。"
      ],
      "author": {
        "id": 6755,
        "name": "韦庄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298762,
      "title": "清平乐 一",
      "content": [
        "偎红歛翠，尽日思闲事。",
        "髻滑凤皇钗欲坠，雨打梨花满地。",
        "绣衣独倚阑干，玉容似怯春寒。",
        "应待少年公子，鸳帏深处同欢。"
      ],
      "author": {
        "id": 3776,
        "name": "尹鹗"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298763,
      "title": "清平乐 二",
      "content": [
        "芳年妙妓，淡拂铅华翠。",
        "轻笑自然生百媚，争那尊前人意。",
        "酒倾琥珀杯时，更堪能唱新词。",
        "赚得王孙狂处，断肠一搦腰肢。"
      ],
      "author": {
        "id": 3776,
        "name": "尹鹗"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298791,
      "title": "清平乐",
      "content": [
        "春光欲暮，寂寞闲庭户。",
        "粉蝶双双穿槛舞，帘卷晚天疎雨。",
        "含愁独倚闺帏，玉炉烟断香微。",
        "正是销魂时节，东风满院花飞。"
      ],
      "author": {
        "id": 13554,
        "name": "毛熙震"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298880,
      "title": "清平乐",
      "content": [
        "春来街砌，春雨如丝细。",
        "春地满飘红杏蔕，春燕舞随风势。",
        "春幡细缕春缯，春闺一点春灯。",
        "自是春心撩乱，非干春梦无凭。"
      ],
      "author": {
        "id": 7856,
        "name": "欧阳炯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298961,
      "title": "清平乐 一",
      "content": [
        "愁肠欲断，正是青春半。",
        "连理分枝鸾失伴，又是一场离散。",
        "掩镜无语眉低，思随芳草凄凄。",
        "凭仗东风吹梦，与郎终日东西。"
      ],
      "author": {
        "id": 12232,
        "name": "孙光宪"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298962,
      "title": "清平乐 二",
      "content": [
        "等闲无语，春恨如何去。",
        "终是疎狂留不住，花暗柳浓何处。",
        "尽日目断魂飞，晚窗斜界残晖。",
        "长恨朱门薄暮，绣鞍骢马空归。"
      ],
      "author": {
        "id": 12232,
        "name": "孙光宪"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 299063,
      "title": "清平乐 一",
      "content": [
        "深冬寒月，庭户凝霜雪。",
        "风鴈过时魂断绝，塞管数声呜咽。",
        "披衣独立披香，流苏乱结愁肠。",
        "往事总堪惆怅，前欢休更思量。"
      ],
      "author": {
        "id": 8353,
        "name": "冯延巳"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 299064,
      "title": "清平乐 二",
      "content": [
        "雨晴烟晚，绿水新池满。",
        "双燕飞来垂柳院，小阁画帘高卷。",
        "黄昏独倚朱阑，西南新月眉弯。",
        "砌下落花风起，罗衣特地春寒。"
      ],
      "author": {
        "id": 8353,
        "name": "冯延巳"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 299065,
      "title": "清平乐 三",
      "content": [
        "西园春早，夹迳抽新草。",
        "冰散漪澜生碧沼，寒在梅花先老。",
        "与君同饮金杯，饮余相取徘徊。",
        "次第小桃将发，轩车莫厌频来。"
      ],
      "author": {
        "id": 8353,
        "name": "冯延巳"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 301935,
      "title": "咏浑家乐（二首） 一",
      "content": [
        "晨起梳头午不休，一窠精魅闹啾啾。",
        "阿家解舞《清平乐》，新妇能抛白木毬。",
        "著绿桃牌吹觱篥，赐绯盟器和《梁州》。",
        "天明任你浑家乐，雨下还须满舍愁。"
      ],
      "author": {
        "id": 11341,
        "name": "陈裕"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 312449,
      "title": "清平乐",
      "content": [
        "繁华锦烂。",
        "已恨归期晚。",
        "翠减红稀莺似懒。",
        "特地柔肠欲断。",
        "不堪尊酒频倾。",
        "恼人转转愁生。",
        "□□□□□□，多情争似无情。"
      ],
      "author": {
        "id": 3061,
        "name": "柳永"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312485,
      "title": "清平乐",
      "content": [
        "屏山斜展。",
        "帐卷红绡半。",
        "泥浅曲池飞海燕。",
        "风度杨花满院。",
        "云情雨意空深。",
        "觉来一枕春阴。",
        "陇上梅花落尽，江南消息沈沈。"
      ],
      "author": {
        "id": 5040,
        "name": "张先"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312486,
      "title": "清平乐",
      "content": [
        "清歌逐酒。",
        "腻脸生红透。",
        "樱小杏青寒食后。",
        "衣换缕金轻绣。",
        "画堂新月朱扉。",
        "严城夜鼓声迟。",
        "细看玉人娇面，春光不在花枝。"
      ],
      "author": {
        "id": 5040,
        "name": "张先"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312573,
      "title": "清平乐",
      "content": [
        "青袍如草。",
        "得意还年少。",
        "马跃绿螭金络脑。",
        "寒食乍临新晓。",
        "曲池斜度鸾桥。",
        "西园一片笙箫。",
        "自欲剩留春住，风花无奈飘飘。"
      ],
      "author": {
        "id": 5040,
        "name": "张先"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312651,
      "title": "清平乐",
      "content": [
        "春花秋草。",
        "只是催人老。",
        "总把千山眉黛扫。",
        "未抵别愁多少。",
        "劝君绿酒金杯。",
        "莫嫌丝管声催。",
        "兔走乌飞不住，人生几度三台。"
      ],
      "author": {
        "id": 6242,
        "name": "晏殊"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312652,
      "title": "清平乐",
      "content": [
        "秋光向晚。",
        "小阁初开宴。",
        "林叶殷红犹未遍。",
        "雨后青苔满院。",
        "萧娘劝我金卮。",
        "殷勤更唱新词。",
        "暮去朝来节老，人生不饮何为。"
      ],
      "author": {
        "id": 6242,
        "name": "晏殊"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312653,
      "title": "清平乐",
      "content": [
        "春来秋去。",
        "往事知何处。",
        "燕子归飞兰泣露。",
        "光景千留不住。",
        "酒阑人散忡忡。",
        "闲阶独倚梧桐。",
        "记得去年今日，依前黄叶西风。"
      ],
      "author": {
        "id": 6242,
        "name": "晏殊"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312654,
      "title": "清平乐",
      "content": [
        "金风细细。",
        "叶叶梧桐坠。",
        "绿酒初尝人易醉。",
        "一枕小窗浓睡。",
        "紫微朱槿花残。",
        "斜阳却照阑干。",
        "双燕欲归时节，银屏昨夜微寒。"
      ],
      "author": {
        "id": 6242,
        "name": "晏殊"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312655,
      "title": "清平乐",
      "content": [
        "红笺小字。",
        "说尽平生意。",
        "鸿雁在云鱼在水。",
        "惆怅此情难寄。",
        "斜阳独倚西楼。",
        "遥山恰对帘钩。",
        "人面不知何处，绿波依旧东流。"
      ],
      "author": {
        "id": 6242,
        "name": "晏殊"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312954,
      "title": "清平乐",
      "content": [
        "小庭春老。",
        "碧砌红萱草。",
        "长忆小阑闲共绕。",
        "携手绿丛含笑。",
        "别来音信全乖。",
        "旧期前事堪猜。",
        "门掩日斜人静，落花愁点青苔。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313215,
      "title": "清平乐",
      "content": [
        "小山丛桂。",
        "最有留人意。",
        "拂叶攀花无限思。",
        "雨湿浓香满袂。",
        "别来过了秋光。",
        "翠帘昨夜新霜。",
        "多少月宫闲地，姮娥与借微芳。"
      ],
      "author": {
        "id": 12140,
        "name": "刘敞"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313235,
      "title": "清平乐",
      "content": [
        "云垂平野。",
        "掩映竹篱茅舍。",
        "阒寂幽居实潇洒。",
        "是处绿娇红冶。",
        "丈夫运用堂堂。",
        "且莫五角六张。",
        "若有一卮芳酒，逍遥自在无妨。"
      ],
      "author": {
        "id": 9366,
        "name": "王安石"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313251,
      "title": "清平乐",
      "content": [
        "留春不住。",
        "费尽莺儿语。",
        "满地残红宫锦污。",
        "昨夜南园风雨。",
        "小怜初上琵琶。",
        "晓来思绕天涯。",
        "不肯画堂朱户，春风自在杨花。"
      ],
      "author": {
        "id": 9366,
        "name": "王安石"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313287,
      "title": "清平乐",
      "content": [
        "留春不住。",
        "费尽莺儿语。",
        "满地残红宫锦污。",
        "昨夜南园风雨。",
        "小怜初上琵琶。",
        "晓来思绕天涯。",
        "不肯画堂朱户，春风自在梨花。"
      ],
      "author": {
        "id": 3916,
        "name": "王安国"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313370,
      "title": "清平乐",
      "content": [
        "留人不住。",
        "醉解兰舟去。",
        "一棹碧涛春水路。",
        "过尽晓莺啼处。",
        "渡头杨柳青青。",
        "枝枝叶叶离情。",
        "此后锦书休寄，画楼云雨无凭。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313371,
      "title": "清平乐",
      "content": [
        "千花百草。",
        "送得春归了。",
        "拾蕊人稀红渐少。",
        "叶底杏青梅小。",
        "小琼闲抱琵琶。",
        "雪香微透轻纱。",
        "正好一枝娇艳，当筵独占韶华。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313372,
      "title": "清平乐",
      "content": [
        "烟轻雨小。",
        "紫陌香尘少。",
        "谢客池塘生绿草。",
        "一夜红梅先老。",
        "旋题罗带新诗。",
        "重寻杨柳佳期。",
        "强半春寒去后，几番花信来时。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313373,
      "title": "清平乐",
      "content": [
        "可怜娇小。",
        "掌上承恩早。",
        "把镜不知人易老。",
        "欲占朱颜长好。",
        "画堂秋月佳期。",
        "藏钩赌酒归迟。",
        "红烛泪前低语，绿笺花里新词。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313374,
      "title": "清平乐",
      "content": [
        "红英落尽。",
        "未有相逢信。",
        "可恨流年凋绿鬓。",
        "睡得春酲欲醒。",
        "钿筝曾醉西楼。",
        "朱弦玉指梁州。",
        "曲罢翠帘高卷，几回新月如钩。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313375,
      "title": "清平乐",
      "content": [
        "春云绿处。",
        "又见归鸿去。",
        "侧帽风前花满路。",
        "冶叶倡条情绪。",
        "红楼桂酒新开。",
        "曾携翠袖同来。",
        "醉弄影娥池水，短箫吹落残梅。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313376,
      "title": "清平乐",
      "content": [
        "波纹碧皱。",
        "曲水清明后。",
        "折得疏梅香满袖。",
        "暗喜春红依旧。",
        "归来紫陌东头。",
        "金钗换酒消愁。",
        "柳影深深细路，花梢小小层楼。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313377,
      "title": "清平乐",
      "content": [
        "西池烟草。",
        "恨不寻芳早。",
        "满路落花红不扫。",
        "春色渐随人老。",
        "远山眉黛娇长。",
        "清歌细逐霞觞。",
        "正在十洲残梦，水心宫殿斜阳。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313378,
      "title": "清平乐",
      "content": [
        "蕙心堪怨。",
        "也逐春风转。",
        "丹杏墙东当日见。",
        "幽会绿窗题遍。",
        "眼中前事分明。",
        "可怜如梦难凭。",
        "都把旧时薄幸，只消今日无情。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313379,
      "title": "清平乐",
      "content": [
        "幺弦写意。",
        "意密弦声碎。",
        "书得凤笺无限事。",
        "犹恨春心难寄。",
        "卧听疏雨梧桐。",
        "雨馀淡月朦胧。",
        "一夜梦魂何处，那回杨叶楼中。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313380,
      "title": "清平乐",
      "content": [
        "笙歌宛转。",
        "台上吴王宴。",
        "宫女如花倚春殿。",
        "舞绽缕金衣线。",
        "酒阑画烛低迷。",
        "彩鸳惊起双栖。",
        "月底三千绣户，云间十二琼梯。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313381,
      "title": "清平乐",
      "content": [
        "暂来还去。",
        "轻似风头絮。",
        "纵得相逢留不住。",
        "何况相逢无处。",
        "去时约略黄昏。",
        "月华却到朱门。",
        "别后几番明月，素娥应是消魂。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313382,
      "title": "清平乐",
      "content": [
        "双纹彩袖。",
        "笑捧金船酒。",
        "娇妙如花轻似柳。",
        "劝客千春长寿。",
        "艳歌更倚疏弦。",
        "有情须醉尊前。",
        "恰是可怜时候，玉娇今夜初圆。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313383,
      "title": "清平乐",
      "content": [
        "寒催酒醒。",
        "晓陌飞霜定。",
        "背照画帘残烛影。",
        "斜月光中人静。",
        "锦衣才子西征。",
        "万重云水初程。",
        "翠黛倚门相送，鸾肠断处离声。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313384,
      "title": "清平乐",
      "content": [
        "莲开欲遍。",
        "一夜秋声转。",
        "残绿断红香片片。",
        "长是西风堪怨。",
        "莫愁家住溪边。",
        "采莲心事年年。",
        "谁管水流花谢，月明昨夜兰船。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313385,
      "title": "清平乐",
      "content": [
        "沈思暗记。",
        "几许无凭事。",
        "菊靥开残秋少味。",
        "闲却画阑风意。",
        "梦云归处难寻。",
        "微凉暗入香襟。",
        "犹恨那回庭院，依前月浅灯深。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313386,
      "title": "清平乐",
      "content": [
        "莺来燕去。",
        "宋玉墙东路。",
        "草草幽欢能几度。",
        "便有系人心处。",
        "碧天秋月无端。",
        "别来长照关山。",
        "一点恹恹谁会，依前凭暖阑干。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313387,
      "title": "清平乐",
      "content": [
        "心期休问。",
        "只有尊前分。",
        "勾引行人添别恨。",
        "因是语低香近。",
        "劝人满酌金锺。",
        "清歌唱彻还重。",
        "莫道后期无定，梦魂犹有相逢。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313572,
      "title": "清平乐",
      "content": [
        "黄金殿里。",
        "烛影双龙戏。",
        "劝得官家真个醉。",
        "进酒犹呼万岁。",
        "折旋舞彻伊州。",
        "君恩与整搔头。",
        "一夜御前宣住，六宫多少人愁。"
      ],
      "author": {
        "id": 8647,
        "name": "王观"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313575,
      "title": "清平乐",
      "content": [
        "宜春小苑。",
        "处处花开满。",
        "学得红妆红要浅。",
        "催上金车要看。",
        "君王曲宴瑶池。",
        "小舟掠水如飞。",
        "夺得锦标归去，匆匆不惜罗衣。"
      ],
      "author": {
        "id": 8647,
        "name": "王观"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313614,
      "title": "清平乐",
      "content": [
        "黄金殿里。",
        "烛影双龙戏。",
        "劝得官家真个醉，进酒犹呼万岁。",
        "锦裀舞彻凉州，君恩与整搔头。",
        "一夜御前宣唤，六宫多少人愁。"
      ],
      "author": {
        "id": 2911,
        "name": "王仲甫"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313754,
      "title": "清平乐",
      "content": [
        "清淮蜀汴。",
        "更在江西岸。",
        "红旆到时黄叶乱。",
        "霜入梁王故苑。",
        "秋原何处携壶。",
        "停骖访古踟蹰。",
        "双庙遗风尚在，漆园傲吏应无。"
      ],
      "author": {
        "id": 11678,
        "name": "苏轼"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314030,
      "title": "清平乐",
      "content": [
        "西江霜后，万点暄晴昼。",
        "璀璨寄来光欲溜。",
        "正值文君病酒。",
        "画屏斜倚窗纱。",
        "睡痕犹带朝霞。",
        "为问清香绝韵，何如解语梅花。"
      ],
      "author": {
        "id": 8599,
        "name": "李之仪"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314031,
      "title": "清平乐",
      "content": [
        "萧萧风叶。",
        "似与更声接。",
        "欲寄明珰非为怯。",
        "梦断兰舟桂楫。",
        "学书只写鸳鸯。",
        "却应无奈愁肠。",
        "安得一双飞去，春风芳草池塘。"
      ],
      "author": {
        "id": 8599,
        "name": "李之仪"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314032,
      "title": "清平乐",
      "content": [
        "殷勤仙友。",
        "劝我千年酒。",
        "一曲履霜谁与奏。",
        "邂逅麻姑妙手。",
        "坐来休叹尘劳。",
        "相逢难似今朝。",
        "不待亲移玉指，自然痒处都消。"
      ],
      "author": {
        "id": 8599,
        "name": "李之仪"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314033,
      "title": "清平乐",
      "content": [
        "当时命友。",
        "曾借邻家酒。",
        "旧曲不知何处奏。",
        "梦断空思纤手。",
        "却应去路非遥。",
        "今朝还有明朝。",
        "谩道人能化石，须知石被人消。"
      ],
      "author": {
        "id": 8599,
        "name": "李之仪"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314034,
      "title": "清平乐",
      "content": [
        "仙家庭院。",
        "红日看看晚。",
        "一朵梅花挨枕畔。",
        "玉指几回拈看。",
        "拥衾不比寻常。",
        "天涯无限思量。",
        "看了又还重嗅，分明不为清香。"
      ],
      "author": {
        "id": 8599,
        "name": "李之仪"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314111,
      "title": "清平乐",
      "content": [
        "鬓云斜坠。",
        "莲步弯弯细。",
        "笑脸双蛾生多媚。",
        "百步兰麝香喷。",
        "从前万种愁烦。",
        "枕边未可明言。",
        "好是蓝桥再渡，玉篦还胜金钿。"
      ],
      "author": {
        "id": 8829,
        "name": "陈睦"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314472,
      "title": "清平乐",
      "content": [
        "风韶雨秀。",
        "春已平分后。",
        "陡顿故人疏把酒。",
        "闲恁画阑搔首。",
        "争须携手踏青。",
        "人生几度清明。",
        "待得燕慵莺懒，杨花点点浮萍。"
      ],
      "author": {
        "id": 7138,
        "name": "徐逸"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314605,
      "title": "清平乐",
      "content": [
        "光尘扑扑。",
        "宫柳低迷绿。",
        "斗鸭阑干春诘曲。",
        "帘额微风绣蹙。",
        "碧云轻翼无凭。",
        "困来小倚银屏。",
        "楚梦未禁春晚，黄鹂犹自声声。"
      ],
      "author": {
        "id": 12402,
        "name": "张孝祥"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314606,
      "title": "清平乐",
      "content": [
        "油幢画戟。",
        "玉铉调春色。",
        "勋阀诸郎俱第一。",
        "风流前辈敌。",
        "玉人双鞚华□。",
        "翠云深处消摇。",
        "有客留君东阁，时闻风下笙箫。"
      ],
      "author": {
        "id": 12402,
        "name": "张孝祥"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314607,
      "title": "清平乐",
      "content": [
        "吹香嚼蕊。",
        "独立东风里。",
        "玉冻云娇天似水。",
        "羞杀夭桃秾李。",
        "如今见说阑干。",
        "不禁月冷霜寒。",
        "垅上驿程人远，楼头戍角声干。"
      ],
      "author": {
        "id": 12402,
        "name": "张孝祥"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314608,
      "title": "清平乐",
      "content": [
        "英姿慷慨。",
        "独立风尘外。",
        "湖海平生豪气在。",
        "行矣云龙际会。",
        "充庭兰玉森森。",
        "一觞共祝修铃。",
        "此地去天尺五，明年持櫜西清。"
      ],
      "author": {
        "id": 12402,
        "name": "张孝祥"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314609,
      "title": "清平乐",
      "content": [
        "向来省户。",
        "谋国参伊吕。",
        "暂借良筹非再举。",
        "谈笑肃清三楚。",
        "良辰上客徜佯。",
        "奏篇犹记传香。",
        "此日一尊相属，它时同在岩廊。"
      ],
      "author": {
        "id": 12402,
        "name": "张孝祥"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314765,
      "title": "清平乐",
      "content": [
        "红尘久住。",
        "仙驭凌波去。",
        "本似行云无定处。",
        "那更腊残风雨。",
        "瑶芳片片轻飞。",
        "但留青子栾枝。",
        "孤负岁寒幽意，如今却与春宜。"
      ],
      "author": {
        "id": 11270,
        "name": "吕胜己"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314766,
      "title": "清平乐",
      "content": [
        "灵心暗属。",
        "髻垒黄金粟。",
        "寂静虚堂情不足。",
        "微步徘徊山麓。",
        "蕊珠宫里新妆。",
        "生香全似瑶芳。",
        "应为莺花留恋，人间暂歇鸾凤。"
      ],
      "author": {
        "id": 11270,
        "name": "吕胜己"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314909,
      "title": "清平乐",
      "content": [
        "楚梅娇小。",
        "好是霜天晓。",
        "宿酒恼人香暗绕。",
        "浸影碧波池沼。",
        "生成素淡芳容。",
        "不须抹黛匀红。",
        "准拟凝成阴结子，莫教枉费春工。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314910,
      "title": "清平乐",
      "content": [
        "绮疏新晓。",
        "学语雏莺巧。",
        "烟暖瑶阶梧叶老。",
        "满地东风芳草。",
        "少年不合风流。",
        "偿他酒债花愁。",
        "望断绿芜春去，销魂懒上层楼。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314978,
      "title": "清平乐",
      "content": [
        "水乡清楚。",
        "襟袖销袢暑。",
        "绰约藕花初过雨。",
        "出浴杨妃无语。",
        "葡萄满酌玻璃。",
        "已拼一醉酬伊。",
        "浪卷夕阳红碎，池光飞上帘帏。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314979,
      "title": "清平乐",
      "content": [
        "清和时候。",
        "底事休交瘦。",
        "满酌流霞看舞袖。",
        "步步锦裀红皱。",
        "六么舞到虚催。",
        "几多深意徘徊。",
        "拼了明朝中酒，为伊更饮琼杯。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315025,
      "title": "清平乐",
      "content": [
        "鸿来燕去。",
        "又是秋光暮。",
        "冉冉流年嗟暗度。",
        "这心事还无据。",
        "寒窗露冷风清。",
        "旅魂幽梦频惊。",
        "何日利名俱赛，为予笑下愁城。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315026,
      "title": "清平乐",
      "content": [
        "秋容眼界。",
        "随寓浑堪爱。",
        "远岫连天横淡霭。",
        "望断孤鸿飞外。",
        "夕阳红树林坰。",
        "重重锦障横陈。",
        "一段江南景色，倩谁为下丹青。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315184,
      "title": "清平乐",
      "content": [
        "紫箫声断。",
        "窗底春愁乱。",
        "试著春衫羞自看。",
        "窄似年时一半。",
        "一春长病厌厌。",
        "新来愁病重添。",
        "香冷倦熏金鸭，日高不卷珠帘。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315225,
      "title": "清平乐",
      "content": [
        "呢喃燕语。",
        "共诉春归去。",
        "春去从他留不住。",
        "落尽枝头红雨。",
        "老翁袖手优游。",
        "闲愁不到眉头。",
        "过了麦黄椹紫，归期只在新秋。"
      ],
      "author": {
        "id": 2810,
        "name": "王炎2"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315226,
      "title": "清平乐",
      "content": [
        "儿曹耳语。",
        "借问何处去。",
        "家在翠微深处住。",
        "生计一犁春雨。",
        "客中且恁浮游。",
        "莫将事挂心头。",
        "纵使人生满百，算来更几春秋。"
      ],
      "author": {
        "id": 2810,
        "name": "王炎2"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315257,
      "title": "清平乐",
      "content": [
        "一杯椒醑。",
        "惜饮难成醉。",
        "爆竹声中人未睡。",
        "共道今宵守岁。",
        "不如且就衾裯。",
        "谁能细数更筹。",
        "三百六旬过了，明朝却是年头。"
      ],
      "author": {
        "id": 2810,
        "name": "王炎2"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315284,
      "title": "清平乐",
      "content": [
        "翠团嘉树。",
        "杜宇呼春去。",
        "帘卷金泥凝望处。",
        "几点红薇香雨。",
        "等闲过了花时。",
        "殷勤来问酴醿。",
        "恰有一枝春在，画楼红日林西。"
      ],
      "author": {
        "id": 8242,
        "name": "杨冠卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315400,
      "title": "清平乐",
      "content": [
        "柳边飞鞚。",
        "露湿征衣重。",
        "宿鹭惊窥沙影动。",
        "应有鱼虾入梦。",
        "一川淡月疏星。",
        "浣沙人影娉婷。",
        "笑背行人归去，门前稚子啼声。"
      ],
      "author": {
        "id": 8618,
        "name": "辛弃疾"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315401,
      "title": "清平乐",
      "content": [
        "茅檐低小。",
        "溪上青青草。",
        "醉里蛮音相媚好。",
        "白发谁家翁媪。",
        "大儿锄豆溪东。",
        "中儿正织鸡笼。",
        "最喜小儿亡赖，溪头卧剥莲蓬。"
      ],
      "author": {
        "id": 8618,
        "name": "辛弃疾"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315402,
      "title": "清平乐",
      "content": [
        "断崖修竹。",
        "竹里藏冰玉。",
        "路绕清溪三百曲。",
        "香满黄昏雪屋。",
        "行人系马疏篱。",
        "折残犹有高枝。",
        "留得东风数点，只缘娇懒春迟。"
      ],
      "author": {
        "id": 8618,
        "name": "辛弃疾"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315403,
      "title": "清平乐",
      "content": [
        "绕床饥鼠。",
        "蝙蝠翻灯舞。",
        "屋上松风吹急雨。",
        "破纸窗间自语。",
        "平生塞北江南。",
        "归来华发苍颜。",
        "布被秋宵梦觉，眼前万里江山。"
      ],
      "author": {
        "id": 8618,
        "name": "辛弃疾"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315404,
      "title": "清平乐",
      "content": [
        "连云松竹。",
        "万事从今足。",
        "拄杖东家分社肉。",
        "白酒床头初熟。",
        "西风梨枣山园。",
        "儿童偷把长竿。",
        "莫遣旁人惊去，老夫静处闲看。"
      ],
      "author": {
        "id": 8618,
        "name": "辛弃疾"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315512,
      "title": "清平乐",
      "content": [
        "此身长健。",
        "还却功名愿。",
        "枉读平生三万卷。",
        "满酌金杯听劝。",
        "男儿玉带金鱼。",
        "能消几许诗书。",
        "料得今宵醉也，两行红袖争扶。"
      ],
      "author": {
        "id": 8618,
        "name": "辛弃疾"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315513,
      "title": "清平乐",
      "content": [
        "诗书万卷。",
        "合上明光殿。",
        "案上文书看未遍。",
        "眉里阴功早见。",
        "十分竹瘦松坚。",
        "看君自是长年。",
        "若解尊前痛饮，精神便是神仙。"
      ],
      "author": {
        "id": 8618,
        "name": "辛弃疾"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315514,
      "title": "清平乐",
      "content": [
        "清溪奔快。",
        "不管青山碍。",
        "千里盘盘平世界。",
        "更著溪山襟带。",
        "古今陵谷茫茫。",
        "市朝往往耕桑。",
        "此地居然形胜，似曾小小兴亡。"
      ],
      "author": {
        "id": 8618,
        "name": "辛弃疾"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315638,
      "title": "清平乐",
      "content": [
        "少年痛饮。",
        "忆向吴江醒。",
        "明月团圆高树影。",
        "十里蔷薇水冷。",
        "大都一点宫黄。",
        "人间直恁芳芬。",
        "怕是九天风露，染教世界都香。"
      ],
      "author": {
        "id": 8618,
        "name": "辛弃疾"
      },
