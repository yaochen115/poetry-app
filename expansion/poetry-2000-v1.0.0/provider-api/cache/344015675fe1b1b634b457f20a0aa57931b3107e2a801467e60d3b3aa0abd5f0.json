{
  "data": [
    {
      "id": 261036,
      "title": "詶李益端公夜宴见赠",
      "content": [
        "戚戚一西东，十年今始同。",
        "可怜歌酒夜，相对两衰翁。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 261037,
      "title": "和陈翃郎中拜本府少尹兼侍御史献上侍中因呈同院诸公",
      "content": [
        "金印垂鞍白马肥，不同疏广老方归。",
        "三千士里文章伯，四十年来锦绣衣。",
        "节比青松当涧直，心随黄雀绕簷飞。",
        "乡中贺者唯争路，不识传呼獬豸威。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 261038,
      "title": "和王仓少尹暇日言怀",
      "content": [
        "清秋多暇日，况乃是夫君。",
        "习静通仙事，书空阅篆文。",
        "劒飞终上汉，鹤梦不离云。",
        "无限烟霄路，何嗟迹未分。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261039,
      "title": "和崔侍郎游万固寺",
      "content": [
        "闻说中方高树林，曙华先照啭春禽。",
        "风云才子冶游思，蒲柳老人惆怅心。",
        "石路青苔花漫漫，雪簷垂溜玉森森。",
        "贺君此去君方至，河水东流西日沈。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 261040,
      "title": "和裴延龄尚书寄题果州谢舍人仙居",
      "content": [
        "飘然去谒八仙翁，自地从天香满空。",
        "紫盖迥标双鹤上，语音犹在五云中。",
        "青溪不接渔樵路，丹井唯传草木风。",
        "歌此因思捧金液，露盘长庆汉皇宫。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 261041,
      "title": "詶崔侍御早秋卧病书情见寄时君亦抱疾在假中",
      "content": [
        "掷地金声信有之，莹然冰玉见清词。",
        "元凯癖成官始贵，相如渴甚貌逾衰。",
        "荒园每觉虫鸣早，华馆常闻客散迟。",
        "寂寞罢琴风满树，几多黄叶落蛛丝。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 261042,
      "title": "詶灵澈上人",
      "content": [
        "军人奉役本无期，落叶花开总不知。",
        "走马城中头雪白，若为将面见汤师。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 261043,
      "title": "敬詶大府二十四舅览诗卷因以见示",
      "content": [
        "郄公怜戆亦怜愚，忽赠金盘径寸珠。",
        "彻底碧潭滋涸溜，压枝红艳照枯株。",
        "九门洞启延高论，百辟联行挹大儒。",
        "顾己文章非酷似，敢将幽劣俟洪炉。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 261044,
      "title": "雨中酬友人",
      "content": [
        "看山独行归竹院，水遶前堦草生遍。",
        "空林细雨暗无声，唯有愁心两相见。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 261045,
      "title": "詶人失题",
      "content": [
        "孤鸾将鹤群，晴日丽春云。",
        "何幸晚飞者，清音长此闻。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 261046,
      "title": "哭司农苗主簿",
      "content": [
        "原头殡御遶新茔，原下行人望哭声。",
        "更想秋山连古木，唯应石上见君名。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 261047,
      "title": "得耿𣲗司法书因叙长安故友零落兵部苗员外发秘省李校书端相次倾逝潞府崔功曹峒长林司空丞曙俱谪远方余以摇落之时对书增叹因呈河中郑仓曹畅参军昆季",
      "content": [
        "鬓似衰蓬心似灰，惊悲相集老相催。",
        "故友九泉留语别，逐臣千里寄书来。",
        "尘容带病何堪问，泪眼逢秋不喜开。",
        "幸接野居宜屣步，冀君清夜一申哀。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 261048,
      "title": "同兵部李纾侍郎刑部包佶侍郎哭皇甫侍御曾",
      "content": [
        "攀龙与泣麟，哀乐不同尘。",
        "九陌霄汉侣，一灯冥漠人。",
        "舟沈惊海阔，兰折怨霜频。",
        "已矣复何见，故山应更春。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261049,
      "title": "纶与吉侍郎中孚司空郎中曙苗员外发崔补阙峒耿拾遗𣲗李校书端风尘追游向三十载数公皆负当时盛称荣耀未几俱沈下泉畅博士当感怀前踪有五十韵见寄輙有所詶以申悲旧兼寄夏侯侍御审侯仓曹钊",
      "content": [
        "禀命孤且贱，少为病所婴。",
        "八岁始读书，四方遂有兵。",
        "童心幸不羁，此去负平生。",
        "是月胡入洛，明年天陨星。",
        "夜行登灞陵，惝怳靡所征。",
        "云海一翻荡，鱼龙俱不宁。",
        "因浮襄江流，远寄鄱阳城。",
        "鄱阳富学徒，诮我戆无营。",
        "谕以诗礼义，朂随宾荐名。",
        "舟车更滞留，水陆互阴晴。",
        "晓望怯云阵，夜愁惊鹤声。",
        "凄凄指宋郊，浩浩入秦京。",
        "沴气既风散，皇威如日明。",
        "方逢粟比金，未识公与卿。",
        "十上不可待，三年竟无成。",
        "偶为达者知，扬我于王廷。",
        "素志且不立，青袍徒见萦。",
        "昏孱夙自保，静躁本殊形。",
        "始趋甘棠阴，旋遇密人迎。",
        "考实绩无取，责能才固轻。",
        "新丰古离宫，宫树锁云扃。",
        "中复莅兹邑，往惟曾所经。",
        "缭垣何逶迤，水殿亦峥嵘。",
        "夜雨滴金砌，阴风吹玉楹。",
        "官曹虽检率，国步日夷平。",
        "命蹇固安分，祸来非有萌。",
        "因逢骇浪飘，几落无辜刑。",
        "巍巍登坛臣，独正天柱倾。",
        "悄悄失途子，分将秋草幷。",
        "百年甘守素，一顾乃拾青。",
        "相逢十月交，众卉飘已零。",
        "感旧谅戚戚，问孤恳茕茕。",
        "侍郎文章宗，杰出淮楚灵。",
        "掌赋若吹籁，司言如建瓴。",
        "郎中善余庆，雅韵与琴清。",
        "郁郁松带雪，萧萧鸿入冥。",
        "员外真贵儒，弱冠被华缨。",
        "月香飘桂实，乳溜滴琼英。",
        "补阙思冲融，巾拂艺亦精。",
        "彩蝶戏芳圃，瑞云凝翠屏。",
        "拾遗兴难侔，逸调旷无程。",
        "九酝贮弥洁，三花寒转馨。",
        "校书才智雄，举世一娉婷。",
        "赌墅鬼神变，属词鸾凤惊。",
        "差肩曳长裾，总辔奉和铃。",
        "共赋瑶台雪，同观金谷筝。",
        "倚天方比劒，沈井忽如瓶。",
        "神昧不可问，天高莫尔听。",
        "君持玉盘珠，泻我怀袖盈。",
        "读罢涕交颐，愿言跻百龄。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 261050,
      "title": "詶李叔度秋夜喜相遇因伤关东僚友丧逝见赠",
      "content": [
        "寒月照秋城，秋风泉涧鸣。",
        "过时见兰蕙，独夜感衰荣。",
        "酒散同移疾，心悲似远行。",
        "以愚求作友，何德敢称兄。",
        "谷变波长急，松枯药未成。",
        "恐看新鬓色，怯问故人名。",
        "野泽云阴散，荒原日气生。",
        "羁飞本难定，非是恶弦惊。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 261051,
      "title": "同李益伤秋",
      "content": [
        "岁去人头白，秋来树叶黄。",
        "搔头向黄叶，与尔共悲伤。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 261052,
      "title": "白发叹",
      "content": [
        "发白晓梳头，女惊妻泪流。",
        "不知丝色后，堪得几回秋。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 261053,
      "title": "逢病军人",
      "content": [
        "行多有病住无粮，万里还乡未到乡。",
        "蓬鬓哀吟古城下，不堪秋气入金疮。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 261054,
      "title": "村南逢病叟",
      "content": [
        "双膝过颐顶在肩，四邻知姓不知年。",
        "卧驱鸟雀惜禾黍，犹恐诸孙无社钱。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 261055,
      "title": "七夕诗",
      "content": [
        "祥光若可求，闺女夜登楼。",
        "月露浩方下，河云凝不流。",
        "铅华潜警曙，机杼暗传秋。",
        "回想歛余睠，人天俱是愁。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261056,
      "title": "七夕诗",
      "content": [
        "凉风吹玉露，河汉有幽期。",
        "星彩光仍隐，云容掩复离。",
        "良宵惊曙早，闰岁怨秋迟。",
        "何事金闺子，空传得网丝。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261057,
      "title": "长门怨",
      "content": [
        "空空古廊殿，寒月落斜晖。",
        "卧听未央曲，满箱歌舞衣。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 261058,
      "title": "妾薄命",
      "content": [
        "妾年初二八，两度嫁狂夫。",
        "薄命今犹在，坚贞扫地无。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 261059,
      "title": "伦开府席上赋得咏美人名解愁",
      "content": [
        "不敢苦相留，明知不自由。",
        "嚬眉乍欲语，歛笑又低头。",
        "舞态兼些醉，歌声似带羞。",
        "今朝总见也，只不解人愁。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261060,
      "title": "王评事驸马花烛诗 一",
      "content": [
        "万条银烛引天人，十月长安半夜春。",
        "步障三千隘将断，几多珠翠落香尘。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 261061,
      "title": "王评事驸马花烛诗 二",
      "content": [
        "一人女壻万人怜，一夜调疎抵百年。",
        "为报司徒好将息，明珠解转又能圆。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 261062,
      "title": "王评事驸马花烛诗 三",
      "content": [
        "人主人臣是亲家，千秋万岁保荣华。",
        "几时曾向高天上，得见今宵月里花。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 261063,
      "title": "王评事驸马花烛诗 四",
      "content": [
        "比翼和鸣双凤皇，欲栖金帐满城香。",
        "平明却入天泉里，日气曈昽五色光。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 261064,
      "title": "和赵给事白蝇拂歌",
      "content": [
        "华堂多众珍，白拂称殊异。",
        "柄裁沈节香袭人，上结为文下垂穗。",
        "霜缕霏微莹且柔，虎须乍细龙髯稠。",
        "皎然素色不因染，淅尔凉风非为秋。",
        "群蝇青苍恣游息，广庖万品无颜色。",
        "金屏成点玉成瑕，昼眠宛转空咨嗟。",
        "此时满筵看一举，荻花忽旋杨花舞。",
        "砉如寒隼惊暮禽，飒若繁埃得轻雨。",
        "主人说是故人留，每诫如新比白头。",
        "若将挥玩闲临水，愿接波中一白鸥。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 261065,
      "title": "萧常侍瘿柏亭歌",
      "content": [
        "柏之异者山中灵，何人断绝为君亭。",
        "云翻浪卷不可识，鸟兽成形花倒植。",
        "莓苔旧点色尚青，霹雳残痕节犹黑。",
        "金貂主人汉三老，构此穷年下朝早。",
        "心规目制不暂疲，匠者受之无一词。",
        "清晨拂匣菱生镜，落日凭阑星满池。",
        "攒甍鬬拱无斤迹，根瘿联悬同素壁。",
        "数层乱泻云里峰，万片争呈雪中石。",
        "重帘不动自飘香，似到瀛洲白玉堂。",
        "水精如意刁金色，云母屏风透掩光。",
        "四堦绵绵被纤草，草上依微众山道。",
        "松间汲井烟翠寒，洞里围碁天景好。",
        "愚儒敢欲贺成功，鸾凤栖翔固不同。",
        "应念废材今接地，一枝思寄户庭中。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 261066,
      "title": "慈恩寺石磬歌",
      "content": [
        "灵山石磬生海西，海涛平处与山齐。",
        "长眉老僧同佛力，呪使鲛人往求得。",
        "珠穴沈成绿浪痕，天衣拂尽苍苔色。",
        "星汉徘徊山有风，禅翁静扣月明中。",
        "群仙下云龙出水，鸾鹤交飞半空里。",
        "山精木魅不可听，落叶秋砧一时起。",
        "花宫杳杳响泠泠，无数沙门昏梦醒。",
        "古廊灯下见行道，疎林池边闻诵经。",
        "徒壮洪钟秘高阁，万金费尽工雕凿。",
        "岂如全质挂青松，数叶残云一片峰。",
        "吾师宝之寿中国，愿同劫石无终极。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 261067,
      "title": "送张郎中还蜀歌",
      "content": [
        "秦家御史汉家郎，亲专两印征殊方。",
        "功成走马朝天子，伏槛论边若流水。",
        "晓离僊署趋紫微，夜接高儒读青史。",
        "泸南五将望君还，愿以天书示百蛮。",
        "曲栈重江初过雨，前旌后骑不同山。",
        "迎车拜舞多耆老，旧卒新营遍青草。",
        "塞口云生火候迟，烟中鹤唳军行早。",
        "黄花川下水交横，远映孤霞蜀国晴。",
        "邛竹笋长椒瘴起，荔枝花发杜鹃鸣。",
        "回首岷峨半天黑，传觞接膝何由得。",
        "空令豪士仰威名，无复贫交恃颜色。",
        "垂杨不动雨纷纷，锦帐胡瓶争送君。",
        "须臾醉起箫笳发，空见红旌入白云。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 261068,
      "title": "宴席赋得姚美人拍筝歌",
      "content": [
        "出帘仍有钿筝随，见罢翻令恨识迟。",
        "微收皓腕缠红袖，深遏朱弦低翠眉。",
        "忽然高张应繁节，玉指回旋若飞雪。",
        "凤箫韶管寂不喧，绣幕纱窗俨秋月。",
        "有时轻弄和郎歌，慢处声迟情更多。",
        "已愁红脸能佯醉，又恐朱门难再过。",
        "昭阳伴里最聪明，出到人间才长成。",
        "遥知禁曲难翻处，犹是君王说小名。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 261069,
      "title": "陈翃郎中北亭送侯钊侍御赋得带冰流歌",
      "content": [
        "溪中鸟鸣春景旦，一派寒冰忽开散。",
        "璧方镜员流不断，白云鳞鳞满河汉。",
        "叠处浅，旋处深。",
        "撇捩寒鱼上复沈，群鹅鼓舞扬清音。",
        "主人有客簪白笔，玉壶贮水光如一。",
        "持此赠君君饮之，圣君识君冰玉姿。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 261070,
      "title": "栖岩寺隋文帝马脑盏歌",
      "content": [
        "天宫宝器隋朝物，鏁在金函比金骨。",
        "开函捧之光乃发，阿修罗王掌中月。",
        "五云如拳轻复浓，昔曾噀酒今藏龙。",
        "规形环影相透彻，乱雪繁花千万重。",
        "可怜贞质无今名，可叹隋陵一抔土。",
        "宫中艳女满宫春，得亲此宝能几人。",
        "一留寒殿殿将坏，唯有幽光通隙尘。",
        "山中老僧眉似雪，忍死相传保扃𫔎。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 261071,
      "title": "难绾刀子歌",
      "content": [
        "黄金鞘里青芦叶，丽若翦成铦且翣。",
        "轻冰薄玉状不分，一尺寒光堪决云。",
        "吹毛可试不可触，似有虫搜阙裂文。",
        "淬之几堕前池水，焉知不是蛟龙子。",
        "割鸡刺虎皆若空，愿应君心逐君指。",
        "幷州难绾竟何人，每成此物如有神。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 261072,
      "title": "腊日观咸宁王部曲娑勒擒豹歌",
      "content": [
        "山头曈曈日将出，山下猎围照初日。",
        "前林有兽未识名，将军促骑无人声。",
        "潜形踠伏草不动，双雕旋转群鸦鸣。",
        "阴方质子才三十，译语受词蕃语揖。",
        "舍鞍解甲疾如风，人忽虎蹲兽人立。",
        "歘然扼颡批其颐，爪牙委地涎淋漓。",
        "既苏复吼拗仍怒，果叶英谋生致之。",
        "拖自深丛目如电，万夫失容千马战。",
        "传呼贺拜声相连，杀气腾凌阴满川。",
        "始知缚虎如缚鼠，败虏降羌生眼前。",
        "祝尔嘉词尔无苦，献尔将随犀象舞。",
        "苑中流水禁中山，期尔攫搏开天颜。",
        "非熊之兆庆无极，愿纪雄名传百蛮。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 261073,
      "title": "赋得白鸥歌送李伯康归使",
      "content": [
        "积水深源，白鸥翻翻。",
        "倒影光素，于潭之间。",
        "衔鱼鱼落乱惊鸣，争扑莲藂莲叶倾。",
        "尔不见波中鸥鸟闲无营，何必汲汲劳其生。",
        "柳花冥蒙大堤口，悠扬相和乍无有。",
        "轻随去浪杳不分，细舞清风亦何有。",
        "似君换得白鹅时，独凭阑干雪满池。",
        "今日还同看鸥鸟，如何羽翮复参差。",
        "复参差，海涛澜漫何由期。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 261074,
      "title": "皇帝感词 一",
      "content": [
        "提劒风雷动，垂衣日月明。",
        "禁花呈瑞色，国老见星精。",
        "发棹鱼先跃，窥巢鸟不惊。",
        "山呼一万岁，直入九重城。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261075,
      "title": "皇帝感词 二",
      "content": [
        "天香五凤彩，御马六龙文。",
        "雨露清驰道，风雷翊上军。",
        "高旍花外转，行漏乐前闻。",
        "时见金鞭举，空中指瑞云。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261076,
      "title": "皇帝感词 三",
      "content": [
        "妙算干戈止，神谋宇宙清。",
        "两堦文物盛，七德武功成。",
        "校猎长杨苑，屯军细柳营。",
        "归来献明主，歌舞溢春城。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261077,
      "title": "皇帝感词 四",
      "content": [
        "天乐下天中，云輧俨在空。",
        "铅黄艳河汉，笑语合笙镛。",
        "已见长随凤，仍闻不避熊。",
        "君王亲试舞，阊阖静无风。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261078,
      "title": "天长久词 一",
      "content": [
        "玉砌红花树，香风不敢吹。",
        "春光解天意，偏发殿南枝。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 261079,
      "title": "天长久词 二",
      "content": [
        "虹桥千步廊，半在水中央。",
        "天子方清暑，宫娃起夜妆。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 261080,
      "title": "天长久词 三",
      "content": [
        "辞辇复当熊，倾心奉六宫。",
        "君王若看貌，甘在众妃中。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 261081,
      "title": "天长久词 四",
      "content": [
        "云日呈祥礼物殊，彤庭生献五单于。",
        "塞垣万里无飞鸟，可是边城用郅都。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 261082,
      "title": "天长久词 五",
      "content": [
        "台殿云深秋色微，君王初赐六宫衣。",
        "楼船泛罢归犹早，行遣才人鬬射飞。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 261083,
      "title": "和张仆射塞下曲 一",
      "content": [
        "鹫翎金仆姑，燕尾绣蝥弧。",
        "独立扬新令，千营共一呼。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 261084,
      "title": "和张仆射塞下曲 二",
      "content": [
        "林暗草惊风，将军夜引弓。",
        "平明寻白羽，没在石棱中。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 261085,
      "title": "和张仆射塞下曲 三",
      "content": [
        "月黑鴈飞高，单于夜遁逃。",
        "欲将轻骑逐，大雪满弓刀。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 261086,
      "title": "和张仆射塞下曲 四",
      "content": [
        "野幕敞琼筵，羌戎贺劳旋。",
        "醉和金甲舞，雷鼓动山川。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 261087,
      "title": "和张仆射塞下曲 五",
      "content": [
        "调箭又呼鹰，俱闻出世能。",
        "奔狐将迸雉，扫尽古丘陵。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 261088,
      "title": "和张仆射塞下曲 六",
      "content": [
        "亭亭七叶贵，荡荡一隅清。",
        "他日题麟阁，唯应独不名。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 261089,
      "title": "古艳诗 一",
      "content": [
        "残妆色浅髻鬟开，笑映朱帘覰客来。",
        "推醉谁知弄花钿，潘郎不敢使人催。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 261090,
      "title": "古艳诗 二",
      "content": [
        "自拈裙带结同心，暖处偏知香气深。",
        "爱捉狂夫问闲事，不知歌舞用黄金。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 261091,
      "title": "孤松吟詶浑赞善",
      "content": [
        "深山荒松枝，雪压半离披。",
        "朱门青松树，万叶承清露。",
        "露重色逾鲜，吟风似远泉。",
        "天寒香自发，日丽影常圆。",
        "阴郊一夜雪，榆柳皆枯折。",
        "回首望君家，翠盖满琼花。",
        "捧君青松曲，自顾同衰木。",
        "曲罢不相亲，深山头白人。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 261092,
      "title": "从军行",
      "content": [
        "二十在边城，军中得勇名。",
        "卷旗收败马，占碛拥残兵。",
        "覆阵乌鸢起，烧山草木明。",
        "塞闲思远猎，师老厌分营。",
        "雪岭无人迹，冰河足鴈声。",
        "李陵甘此没，惆怅汉公卿。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 261093,
      "title": "和马郎中画鹤赞",
      "content": [
        "高高华亭，有鹤在屏。",
        "削玉点漆，乘轩姓丁。",
        "暮云冥冥，双垂雪翎。",
        "晨光炯炯，一直朱顶。",
        "含音俨容，绝粒遗影。",
        "君以为真，相期缑岭。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 261094,
      "title": "送朝长史赴荆南旧幕",
      "content": [
        "元瑜思旧幕，几夜梦旌旃。",
        "暑退蒹葭雨，秋生鼓角天。",
        "月明三峡路，浪里九江船。",
        "囗囗囗囗囗，囗囗囗囗囗。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261095,
      "title": "送渭南崔少府归徐郎中幕",
      "content": [
        "叶下山边路，行人见自悲。",
        "夜寒逢雪处，日暖到村时。",
        "语少心常苦，愁深醉自迟。",
        "囗囗囗囗囗，羡有幕中期。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261096,
      "title": "寄郑七纲",
      "content": [
        "小来落托复迍邅，一辱君知二十年。",
        "舍去形骸容傲慢，引随兄弟共团圆。",
        "羁游不定同云聚，薄宦相萦若网牵。",
        "他日吴公如记问，愿将黄绶比青毡。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 261097,
      "title": "逢南中使因寄岭外故人",
      "content": [
        "见说南来处，苍梧接桂林。",
        "过秋天更暖，边海日长阴。",
        "巴路缘云出，蛮乡入洞深。",
        "信回人自老，梦到月应沈。",
        "碧水通春色，青山寄远心。",
        "炎方难久客，为尔一沾襟。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 261098,
      "title": "代员将军罢战后归旧里赠朔北故人",
      "content": [
        "结发事疆场，全生俱到乡。",
        "连云防铁岭，同日破渔阳。",
        "牧马胡天晚，移军碛路长。",
        "枕戈眠古戍，吹角立繁霜。",
        "归老勋仍在，酬恩虏未亡。",
        "独行过邑里，多病对农桑。",
        "雄劒依尘橐，阴符寄药囊。",
        "空余麾下将，犹逐羽林郎。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 261099,
      "title": "江北忆崔汶",
      "content": [
        "夜问江西客，还知在楚乡。",
        "全身出部伍，尽室逐渔商。",
        "晴日游瓜步，新年对汉阳。",
        "月昏惊浪白，瘴起觉云黄。",
        "望岭家何处，登山泪几行。",
        "闽中传有雪，应且住南康。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 261100,
      "title": "早春归盩厔旧居却寄耿拾遗𣲗李校书端",
      "content": [
        "野日初晴麦垅分，竹园相接鹿成群。",
        "几家废井生青草，一树繁花傍古坟。",
        "引水忽惊冰满涧，向田空见石和云。",
        "可怜荒岁青山下，惟有松枝好寄君。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 261101,
      "title": "春日山中忆崔峒吉中孚",
      "content": [
        "延步爱清晨，空山日照春。",
        "蜜房那有主，石室自无邻。",
        "泉急鱼依藻，花繁鸟近人。",
        "谁言失徒侣，唯与老相亲。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261102,
      "title": "客舍喜崔补阙司空拾遗访宿",
      "content": [
        "步月访诸邻，蓬居宿近臣。",
        "乌裘先醉客，清镜早朝人。",
        "坏壁烟垂网，香街火照尘。",
        "悲荣俱是分，吾亦乐吾贫。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261103,
      "title": "苦雨闻包谏议欲见访戏赠",
      "content": [
        "草气厨烟咽不开，绕床连壁尽生苔。",
        "常时多病因多雨，那敢烦君车马来。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 261104,
      "title": "客舍苦雨即事寄钱起郎士元二员外",
      "content": [
        "积雨暮凄凄，羁人状鸟栖。",
        "响空宫树接，覆水野云低。",
        "穴蚁多随草，巢蜂半坠泥。",
        "遶池墙藓合，拥溜瓦松齐。",
        "旧圃平如海，新沟曲似溪。",
        "坏阑留众蝶，欹栋止群鸡。",
        "莠盛终无实，槎枯返有荑。",
        "绿萍藏废井，黄叶隐危堤。",
        "闾里欢将绝，朝昏望亦迷。",
        "不知霄汉侣，何路可相携。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 261105,
      "title": "郊居对雨寄赵涓给事包佶郎中",
      "content": [
        "暑雨青山里，随风到野居。",
        "乱沤浮曲砌，悬溜响前除。",
        "尘镜愁多掩，蓬头嬾更梳。",
        "夜窗凄枕席，阴壁润图书。",
        "萧飒宜新竹，龙钟拾野蔬。",
        "石泉空自咽，药圃不堪锄。",
        "浊水淙深辙，荒兰拥败渠。",
        "繁枝留宿鸟，碎浪出寒鱼。",
        "桑屐时登望，荷衣自卷舒。",
        "应怜在泥滓，无路托高车。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 261106,
      "title": "蓝溪期萧道士采药不至",
      "content": [
        "春风生百药，几处术苗香。",
        "人远花空落，溪深日复长。",
        "病多知药性，老近忆仙方。",
        "清节何由见，三山桂自芳。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261107,
      "title": "雪谤后书事上皇甫大夫",
      "content": [
        "盛德总群英，高标仰国桢。",
        "独安巡狩日，曾掩赵张名。",
        "业就难辞宠，朝回更授兵。",
        "晓川分牧马，夜雪覆连营。",
        "长策威殊俗，嘉谋翊圣明。",
        "画图规阵势，梦笔纪山行。",
        "绶拂池中影，珂摇竹外声。",
        "赐欢征妓乐，陪醉问公卿。",
        "却忆经前事，翻疑得此生。",
        "分深存没感，恩在子孙荣。",
        "览镜愁将老，扪心喜复惊。",
        "岂言沈族重，但觉杀身轻。",
        "有泪沾坟典，无家集弟兄。",
        "东西遭世难，流浪识交情。",
        "阅古宗文举，推才慕正平。",
        "应怜守贫贱，又欲事躬耕。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 261108,
      "title": "春日忆司空文明",
      "content": [
        "桃李风多日欲阴，百劳飞处落花深。",
        "贫居静久难逢信，知隔春山不可寻。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 261109,
      "title": "卧病寓居龙兴观枉冯十七著作书知罢摄洛阳赴缑氏因题十四韵寄冯生幷赠乔尊师",
      "content": [
        "乞假依山宅，蹉跎属岁周。",
        "弱荑轻采拾，钝质称归休。",
        "潘岳衰将至，刘桢病未瘳。",
        "步迟乘羽客，起晏滞书邮。",
        "幸以编方验，终贻骨肉忧。",
        "灼龟炉气冷，曝药树阴稠。",
        "语命心堪醉，伤离梦亦愁。",
        "荤膻居已绝，鸾鹤见无由。",
        "世累如尘积，年光剧水流。",
        "蹑云知有路，济海岂无舟。",
        "倚玉翻成难，投砖敢望詶。",
        "卑栖君就禄，羸惫我逢秋。",
        "腐叶填荒辙，阴萤出古沟。",
        "依然在遐想，愿子励风猷。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 261110,
      "title": "秋夜寄冯著作",
      "content": [
        "河汉净无云，鸿声此夜闻。",
        "素心难比石，苍鬓欲如君。",
        "露槿月中落，风萤池上分。",
        "何言千载友，同迹不同群。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261111,
      "title": "洛阳早春忆吉中孚校书司空曙主簿因寄清江上人",
      "content": [
        "值迥逢高驻马频，雪晴闲看洛阳春。",
        "莺声报远同芳信，柳色邀欢似故人。",
        "酒貌昔将花共艳，鬓毛今与草争新。",
        "年来百事皆无绪，唯与汤师结净因。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 261112,
      "title": "偶逢姚校书凭附书达河南郄推官因以戏赠",
      "content": [
        "寄书常切到常迟，今日凭君君莫辞。",
        "若问玉人殊易识，莲花府里最清羸。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 261113,
      "title": "夜中得循州赵司马侍郎书因寄回使",
      "content": [
        "瘴海寄双鱼，中宵达我居。",
        "两行灯下泪，一纸岭南书。",
        "地说炎蒸极，人称老病余。",
        "殷勤报贾傅，莫共酒杯疎。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261114,
      "title": "晚次新丰北野老家书事呈赠韩质明府",
      "content": [
        "机鸣舂响日暾暾，鸡犬相和汉古村。",
        "数派清泉黄菊盛，一林寒露紫棃繁。",
        "衰翁正席矜新社，稚子齐襟读古论。",
        "共说年来但无事，不知何者是君恩。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 261115,
      "title": "书情上大尹十兄",
      "content": [
        "紫陌绝纤埃，油幢千骑来。",
        "剖辞纷若雨，犇吏殷成雷。",
        "圣泽初忧壅，群心本在台。",
        "海鳞方泼刺，云翼暂徘徊。",
        "芳室芝兰茂，春蹊桃李开。",
        "江湖余派少，鸿鴈远声哀。",
        "命厌蓍龟诱，年惊弟姪催。",
        "磨铅慙砥砺，挥策愧驽骀。",
        "玉管能喧谷，金炉可变灰。",
        "应怜费思者，衔泪亦衔枚。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 261116,
      "title": "春思贻李方陵",
      "content": [
        "长安三月春，难别复难亲。",
        "不识冶游伴，多逢憔悴人。",
        "渐知欢澹薄，转觉老殷勤。",
        "去矣尽如此，此辞悲未陈。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 261117,
      "title": "驿中望山戏赠渭南陆贽主簿",
      "content": [
        "官微多惧事多同，拙性偏无主驿功。",
        "山在门前登不得，鬓毛衰尽路尘中。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 261118,
      "title": "太白西峰偶宿车祝二尊师石室晨登前𪩘凭眺书怀即事寄呈凤翔齐员外张侍御",
      "content": [
        "弱龄诚昧鄙，遇胜惟求止。",
        "如何羁滞中，得步青冥里。",
        "青冥有桂藂，冰雪两仙翁。",
        "毛节未归海，丹梯闲倚空。",
        "逍遥拟上清，洞府不知名。",
        "醮罢雨雷至，客辞山忽明。",
        "山明鸟声乐，日气生嵓壑。",
        "嵓壑树修修，白云如水流。",
        "白云消散尽，陇塞俨然秋。",
        "积阻关河固，绵联烽戍稠。",
        "五营承庙略，四野失边愁。",
        "吁嗟系尘役，又负灵仙迹。",
        "芝术自芳香，泥沙几沈溺。",
        "书此欲沾衣，平生事每违。",
        "烟霄不可仰，鸾鹤自追随。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 261119,
      "title": "赠韩山人",
      "content": [
        "见君何事不慙颜，白发生来未到山。",
        "更叹无家又无药，往来唯在酒徒间。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 261120,
      "title": "赠李果毅",
      "content": [
        "向日磨金镞，当风著锦衣。",
        "上城邀贼语，走马截雕飞。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 261121,
      "title": "春日书情赠别司空曙",
      "content": [
        "壮志随年尽，谋身意未安。",
        "风尘交契阔，老大别离难。",
        "腊近晴多暖，春迟夜却寒。",
        "谁堪少兄弟，三十又无官。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261122,
      "title": "冬晓呈邻里",
      "content": [
        "终夜寝衣冷，开门思曙光。",
        "空堦一藂叶，华室四邻霜。",
        "望阙觉天迥，忆山愁路荒。",
        "途中一留滞，双鬓飒然苍。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261123,
      "title": "首冬寄河东昭德里书事贻郑损仓曹",
      "content": [
        "清冬和暖天，老钝昼多眠。",
        "日爱闾巷静，每闻官吏贤。",
        "寒葅供家食，腐叶宿厨烟。",
        "且复执杯酒，无烦轻议边。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261124,
      "title": "浑赞善东斋戏赠陈归",
      "content": [
        "长裾珠履飒轻尘，闲以琴书列上宾。",
        "公子无讐可邀请，侯嬴此坐是何人。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 261125,
      "title": "春日卧病示赵季黄",
      "content": [
        "病中饶泪眼常昏，闻说花开亦闭门。",
        "语少渐知琴思苦，卧多唯觉鸟声喧。",
        "黄埃满市图书贱，黑雾连山虎豹尊。",
        "今日支离顾形影，向君凡在几重恩。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 261126,
      "title": "秋幕中夜独坐迟明因陪陈翃郎中晨谒上公因书即事兼呈同院诸公",
      "content": [
        "风凄露泫然，明月在山巅。",
        "独倚古庭树，仰看深夜天。",
        "叶翻萤不定，虫思草无边。",
        "南舍机杼发，东方云景鲜。",
        "簪裘肃已整，车骑俨将前。",
        "百雉拱双戟，万夫尊一贤。",
        "琳瑯多谋蕴，律吕更相宣。",
        "晓桂香浥露，新鸿晴满川。",
        "熙熙造化功，穆穆唐尧年。",
        "顾己草同贱，誓心金匪坚。",
        "蹇辞慙自寡，渴病老难痊。",
        "书此更何问，边韶唯昼眠。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 261127,
      "title": "寄赠库部王郎中",
      "content": [
        "谔谔汉名臣，从天令若春。",
        "叙辞皆诏旨，称宦即星辰。",
        "草木承风偃，云雷施泽均。",
        "威惩治粟尉，恩洽让田人。",
        "泉货方将散，京坻自此陈。",
        "五营俱益灶，千里不停轮。",
        "未远金门籍，旋清玉塞尘。",
        "硕儒推庆重，良友颂公频。",
        "鹤发逢新镜，龙门跃旧鳞。",
        "荷君偏有问，深感浩难申。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 261128,
      "title": "寄赠畅当山居",
      "content": [
        "古村荒石路，岁晏独言归。",
        "山雪厚三尺，社楡麄十围。",
        "虬龙宁守蛰，鸾鹤岂矜飞。",
        "君子固安分，毋听劳者讥。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261129,
      "title": "偶宿山中忆畅当",
      "content": [
        "深山夜雪晴，坐忆晓山明。",
        "读易罢三卷，弹琴当五更。",
        "薜萝枯有影，嵓壑冻无声。",
        "此夕一相望，君应知我诚。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261130,
      "title": "秋中野望寄舍弟绶兼令呈上西川尚书舅",
      "content": [
        "忧来思远望，高处殊非惬。",
        "夜露湿苍山，秋陂满黄叶。",
        "人随鴈迢遰，栈与云重叠。",
        "骨肉暂分离，形神遂疲薾。",
        "红旌渭阳骑，几日劳登涉。",
        "蜀道蔼松筠，巴江盛舟檝。",
        "小生即何限，简诲偏盈箧。",
        "旧恨尚填膺，新悲复萦睫。",
        "因求种瓜利，自喜归耕捷。",
        "井臼赖依邻，儿童亦胜汲。",
        "尘容不在照，雪鬓那堪镊。",
        "唯有飡霞心，知夫与天接。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 261131,
      "title": "行药前轩呈董山人",
      "content": [
        "不觉老将至，瘦来方自惊。",
        "朝昏多病色，起坐有劳声。",
        "腠暖苦肌痒，藏虚唯耳鸣。",
        "桑公富灵术，一为保余生。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261132,
      "title": "翫春因寄冯衞二补阙戏呈李益",
      "content": [
        "掖垣春色自天来，红药当堦次第开。",
        "萱草藂藂尔何物，等闲穿破绿莓苔。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 261133,
      "title": "新移北厅因贻同院诸公兼呈畅博士",
      "content": [
        "华轩迩台座，顾影忝时伦。",
        "弱质偃弥旷，清风来亦频。",
        "恩辉坐凌迈，景物恣芳新。",
        "终乃愧吾友，无容私此身。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261134,
      "title": "与张擢对酌",
      "content": [
        "张翁对卢叟，一榼山村酒。",
        "倾酒请予歌，忽蒙张翁呵。",
        "呵予官非屈，曲有怨词多。",
        "歌罢谢张翁，所思殊不同。",
        "予悲方为老，君责一何空。",
        "曾看乐官录，向是悲翁曲。",
        "张老闻此词，汪汪泪盈目。",
        "卢叟醉言麄，一杯凡数呼。",
        "回头顾张老，敢欲戏为儒。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 261135,
      "title": "喜从弟激初至",
      "content": [
        "儒服策羸车，惠然过我庐。",
        "叙年慙已长，称从意何疎。",
        "作吏清无比，为文丽有余。",
        "应嗤受恩者，头白读兵书。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    }
  ],
