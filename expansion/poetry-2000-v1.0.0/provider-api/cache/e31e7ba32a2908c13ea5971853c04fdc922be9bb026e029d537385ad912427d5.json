{
  "data": [
    {
      "id": 13440,
      "title": "哀故文节公  其三",
      "content": [
        "霜露才婴疾，龙蛇已丧贤。",
        "神骑尾星次，家托寝丘田。",
        "长乐申君吊，东堂罢禊筵。",
        "佳城白日掩，从此即千年。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13441,
      "title": "章靖冯公哀词  其一",
      "content": [
        "华殿推名学，南宫重亚卿。",
        "心无二何佞，身有两龚清。",
        "归沐宾綦鲜，幽通笔思精。",
        "邦人为公恨，不见相承平。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13442,
      "title": "章靖冯公哀词  其二",
      "content": [
        "读易三编断，当朝万事知。",
        "由来不语怪，何意遂无儿。",
        "酒德欢长绝，书林藁尚遗。",
        "异时逢玉尺，方为阮咸悲。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13443,
      "title": "章靖冯公哀词  其三",
      "content": [
        "睆箦绵疴革，中楹奠梦还。",
        "𫈵仪犹在野，书副即藏山。",
        "友酹生刍洁，君恩刻印颁。",
        "一朝交臂失，宁复易睎颜。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13444,
      "title": "章靖冯公哀词  其四",
      "content": [
        "风旌引素辕，歌绋远犹喧。",
        "此路成千古，何人叹九原。",
        "未亡钟淑俪，不朽寄空言。",
        "兄子今为后，春秋无馁魂。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13445,
      "title": "光禄叶大卿哀词  其一",
      "content": [
        "八十浮龄尽，三千去日长。",
        "丛兰秋寂寞，卿月夜苍茫。",
        "里友歌迎绋，州民酹续浆。",
        "英魂知所托，桥梓蔼成行。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13446,
      "title": "光禄叶大卿哀词  其二",
      "content": [
        "偃息朋三寿，生平定四知。",
        "乡人荣衣绣，光禄号能诗。",
        "未赴安车召，遽成埋玉悲。",
        "方珉纪遗爱，无诳冢中辞。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13447,
      "title": "辨才少白师归天台",
      "content": [
        "壤色拥行肩，南方应有缘。",
        "归艎素车浪，宝戺赤城天。",
        "宴树春园密，谈花画祴鲜。",
        "凭师无阂智，呵黜二宗禅。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13448,
      "title": "怀滕秘校书",
      "content": [
        "解职青袍困，惊年素发多。",
        "囊中彭泽米，门外下邽罗。",
        "露鹤惊霄岛，风蜩喝暝柯。",
        "此时潘簟冷，争奈近秋何。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13449,
      "title": "送黄秘校书",
      "content": [
        "妙龄看试牍，共叹俊登喧。",
        "十载重来调，犹参军事烦。",
        "吴艎沿迅溜，京炙伴芳樽。",
        "东观他年选，当求江夏孙。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13450,
      "title": "公会亭  其一",
      "content": [
        "日下炎氛歇，风生凉意添。",
        "树花闲纂纂，楼月静纤纤。",
        "倦绠仍垂缶，昏钩半上帘。",
        "畦瓜已堪摘，纳履自无嫌。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13451,
      "title": "公会亭  其二",
      "content": [
        "吏罢得休沐，襟怀萧散中。",
        "静时飞蝶梦，闲处上皇风。",
        "稚筿因依碧，疏花磔索红。",
        "素餐无所事，天幸一衰翁。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13452,
      "title": "和小饮",
      "content": [
        "天帟暮云消，飞觞夜正遥。",
        "洛吟聊拥鼻，陶舞惜回腰。",
        "露晓蝉嘶树，河秋鹊映桥。",
        "客欢殊未几，离恨又霞朝。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13453,
      "title": "夏日江渎亭小饮",
      "content": [
        "飞槛枕溪光，欢言客徧觞。",
        "暂云消树影，骤雨发荷香。",
        "辛臼橙齑熟，庖刀脍缕长。",
        "苹风如有意，盈衽借浮凉。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13454,
      "title": "朝阳",
      "content": [
        "缩宿沈榆彩，沧溟转若华。",
        "才晞汉盘露，便映洛神霞。",
        "鸣凤梧冈迥，桑柔桂笼斜。",
        "照梁休自许，城上已啼鸦。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13455,
      "title": "唐李卫公庙",
      "content": [
        "斯人天挺杰，贼胆畏膏肓。",
        "疾战江陵破，长驱颉利亡。",
        "成功在不伐，垂烈付无疆。",
        "血食雄京辅，于今异姓王。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13456,
      "title": "夜出溪上",
      "content": [
        "陇首孤云断，坳塘绿水周。",
        "萤光不欺夜，虫织自悲秋。",
        "早雁离离度，归舟泛泛流。",
        "萱苏共摇落，底处是忘忧。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13457,
      "title": "秋晚溪上",
      "content": [
        "积水增波润，苍霞变露余。",
        "断烟随鸟远，寒叶向人疏。",
        "萍老犹迎日，莲衰尚戏鱼。",
        "临川方病涉，谁借郑卿舆。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13458,
      "title": "出城所见赋五题  其一",
      "content": [
        "二月雨堪爱，霏霏膏泽盈。",
        "添成竹箭浪，催发杏花耕。",
        "迥湿风头冷，微含日脚明。",
        "居然嘉应在，谁是束长生。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13459,
      "title": "出城所见赋五题  其二",
      "content": [
        "二月水堪爱，泮流清复浑。",
        "影深天在底，红乱日摇痕。",
        "鹜没小舟度，鱼喁新藻翻。",
        "有人无限思，惭愧仲长言。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13460,
      "title": "出城所见赋五题  其三",
      "content": [
        "二月花堪爱，全开未落时。",
        "香轻长抱蕊，霞破即团枝。",
        "舞蝶何曾定，流鶑不待期。",
        "劳君金缕唱，更尽拍浮巵。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13461,
      "title": "出城所见赋五题  其四",
      "content": [
        "二月草堪爱，一番芳意还。",
        "远迷天泱泱，低隠雉斑斑。",
        "细雨鲜原润，东风古道闲。",
        "王孙归定否，持问桂枝山。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13462,
      "title": "出城所见赋五题  其五",
      "content": [
        "二月风堪爱，悠悠天际生。",
        "向空鸣籁细，乘暝作寒轻。",
        "拂水纹层浪，穿条杌紫茎。",
        "烦君期素魄，相伴倒春清。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13463,
      "title": "重葺敝庐有作",
      "content": [
        "屦市喧卑极，家林改筑初。",
        "藩倾犹置笔，楹破尚逢书。",
        "径草临江府，园畦洛涘居。",
        "凭谁遣真意，仁义亦蘧庐。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13464,
      "title": "华州西溪",
      "content": [
        "山近重岚逼，溪长匹练分。",
        "霁波平撼日，寒崦侧藏云。",
        "弄荇鱼差尾，投汀鹭列群。",
        "如何去寻丈，尘路已纷纷。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13465,
      "title": "送客",
      "content": [
        "西出都门路，横参送客鞍。",
        "低云能作暝，轻吹不成寒。",
        "天势高无极，原姿秀可餐。",
        "长年伤别甚，作恶叵能欢。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13466,
      "title": "僖宗在蜀谏官孟昭图上疏言田令孜屏书不奏沈之虾蟆津诗人郑谷伤之略曰徒将心许国不识道消时予钦其人作诗投吊",
      "content": [
        "密疏即储胥，指言刀锯余。",
        "难排赵高鹿，竟葬楚江鱼。",
        "愤魄栖长濑，冤氛犯太虚。",
        "无人抉君目，他日见诛除。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13467,
      "title": "李九言寺丞知怀安军金堂县",
      "content": [
        "云栈马萧萧，铜章庇邑遥。",
        "晨晖碧鸡路，春色锦官桥。",
        "美政方宣布，斯人旧富饶。",
        "早须飞两舄，归趁汉家朝。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13468,
      "title": "挽张元常葬母夫人二首  其一",
      "content": [
        "象服流恩贵，轻舆就养荣。",
        "新成大家赋，经饷颍封羹。",
        "过隙诚难驻，藏舟自不惊。",
        "子贤能顺礼，三月祔佳城。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13469,
      "title": "挽张元常葬母夫人二首  其二",
      "content": [
        "婴病曾无苦，期颐未满年。",
        "风酸吹棘地，露泣采兰天。",
        "庀具藏分泽，张琴委暗弦。",
        "江流终不竭，懿范此俱传。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13470,
      "title": "遣吏视诸公茔树回有感 文正王丞相",
      "content": [
        "两朝推巨德，万务罄斯猷。",
        "汉日左右手，尧年忠孝侯。",
        "名言天下满，故事省中留。",
        "宸篆旌碑首，刊文又几秋。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13471,
      "title": "遣吏视诸公茔树回有感 文靖吕丞相",
      "content": [
        "庆历公三入，边陲扰太平。",
        "啖金真间敌，挠酒不寒盟。",
        "上印情虽切，然髭病遽轻。",
        "惜哉天弗憗，宸幄泪先横。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13472,
      "title": "遣吏视诸公茔树回有感 宣献宋公",
      "content": [
        "昔去劝明辟，俄归参大钧。",
        "公孙未及相，诸葛已伤神。",
        "名待天渊蔽，文争日月新。",
        "英魂同玉树，不向土中春。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13473,
      "title": "遣吏视诸公茔树回有感 文惠陈丞相",
      "content": [
        "岩廊号元老，礼数盛中台。",
        "万石父子贵，八元兄弟才。",
        "新诗玉可扣，奇隶鹊争回。",
        "今日看碑字，真缘洒泪来。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13474,
      "title": "答客",
      "content": [
        "贱子空虚甚，何烦跪自陈。",
        "摧藏不鸣雁，排迮后来薪。",
        "栉短三秋发，途奔四海尘。",
        "安能得所欲，况是数奇人。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13475,
      "title": "送同年吴瑴尉乌程",
      "content": [
        "冬冬报曙天，归趁越人船。",
        "闽月长留梦，吴门自是仙。",
        "漆书多汗竹，圭祀有名田。",
        "剩著凌云赋，囊帷待奏篇。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13476,
      "title": "送王庾  其一",
      "content": [
        "土甑残炊黍，津航促扣舷。",
        "云迷孝王苑，星认太丘躔。",
        "破瑟弦鹍舞，吟囊锦兽鲜。",
        "晚淮他夜月，离思共娟娟。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13477,
      "title": "送王庾  其二",
      "content": [
        "倦客衣空化，求知刺欲漫。",
        "孤飞回鹢路，别泪溢鲛盘。",
        "待举秋槐老，承颜夏枕安。",
        "新篇时寄我，鱼信接长澜。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13478,
      "title": "送祝熙载",
      "content": [
        "昔誓𦈡仍在，今行绶已新。",
        "春鶑得迁友，夜鹤怨归人。",
        "倦枕低潮月，征帆截渚苹。",
        "清时偏乐职，寒鼈佐吴醇。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13479,
      "title": "寒食日送李公佐归汉东",
      "content": [
        "有客改南辕，春郊驻祖筵。",
        "罇寒禁火国，风暖浴沂天。",
        "茂草平无际，残花惨更妍。",
        "鹿鸣偕计近，簪盍约初年。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13480,
      "title": "送连庶",
      "content": [
        "之子远参卿，劳劳千里行。",
        "素衣因客变，华发看秋生。",
        "遇鲤频为讯，逢莼试作羹。",
        "尘埃半通绶，何地免将迎。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13481,
      "title": "送陈动之",
      "content": [
        "绨帙抛蓬观，军牙佐柳屯。",
        "伏熊均轼宠，睡貉袭裘温。",
        "睢苑寒云隔，渔挝暝鼓喧。",
        "帛书无厌数，知有雁为门。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13482,
      "title": "送梅尧臣",
      "content": [
        "祖帟都门路，秋风满客衣。",
        "台舟三鹢驶，官舄两凫飞。",
        "乡思临波远，离忧傍酒微。",
        "不应缘事事，手自废谈围。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13483,
      "title": "春晖寓目二首  其一",
      "content": [
        "春序倏云晚，高台芳意多。",
        "花成风地缬，鸟作暝林歌。",
        "树气薰繁幄，池文叠细波。",
        "夹城归骑散，烟絮徧铜驼。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13484,
      "title": "春晖寓目二首  其二",
      "content": [
        "春意都无几，还持欢绪归。",
        "游蜂抱蕊去，惊燕失泥飞。",
        "风下幡幡影，霞留暝暝霏。",
        "既知瑶席恨，不减欲沾衣。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13485,
      "title": "累夕大风",
      "content": [
        "乘秋万窍怒，拂野恣离披。",
        "祭鸟东门酒，鸣鸢上将旗。",
        "有谁樵旦暮，无客赋雄雌。",
        "何用呼号甚，枯桑了不知。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13486,
      "title": "武安侯",
      "content": [
        "贵甚宫中势，轩然帝右趋。",
        "所贪惟狗马，宁是学盘盂。",
        "骄取武库地，气凌辕下驹。",
        "淮南他日语，悔不共严诛。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13487,
      "title": "庭石",
      "content": [
        "嗟尔一拳质，块生天地中。",
        "柱云蒸作润，山溜滴成空。",
        "松盖何年化，星槎此路穷。",
        "无邀什袭裹，近出宋台东。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13488,
      "title": "感秋",
      "content": [
        "乐事行将晚，华年怯早衰。",
        "翻车壮士速，落叶长年悲。",
        "别燕风帘静，惊乌月树危。",
        "播精宁有用，皮骨极支离。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13489,
      "title": "秋日四首  其一",
      "content": [
        "短影悠扬日，薄寒憀栗天。",
        "林声蝉后老，陂影雁宾联。",
        "凄感客自尔，变衰时适然。",
        "何须问容鬓，所遇是凋年。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13490,
      "title": "秋日四首  其二",
      "content": [
        "客心惊暮节，天意歇余芳。",
        "莲罢池收子，榴成露罅房。",
        "绨袍亲故暖，纨扇委空凉。",
        "庾信真愁否，仍能用斛量。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13491,
      "title": "秋日四首  其三",
      "content": [
        "禁林成宿忝，愚谷负深归。",
        "未识前途远，容知昨日非。",
        "巧劳真物役，静胜乃天机。",
        "君看琴中意，何尝在玉徽。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13492,
      "title": "秋日四首  其四",
      "content": [
        "秋气飒然爽，宴居差有情。",
        "蝇休几案洁，蝉罢亭臯清。",
        "溪水照心碧，云山刮眼明。",
        "其如岁云晏，天地莽峥嵘。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13493,
      "title": "晚发  其一",
      "content": [
        "候鼓遥喧岸，行舟逆上湍。",
        "轻烟著波面，斜月罢林端。",
        "飒沓凫鹥乱，苍茫葭苇寒。",
        "致君何所惮，便道许之官。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13494,
      "title": "晚发  其二",
      "content": [
        "晓濑虽能迅，寒波不复扬。",
        "林声散栖鸟，隄影度风樯。",
        "兹岁方云暮，吾行未遽央。",
        "病身非汲黯，安敢薄淮阳。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13495,
      "title": "游海云寺",
      "content": [
        "十里云边寺，重驱千骑来。",
        "天形欹野尽，江势让山回。",
        "园竹浓成幄，楼钟近殷雷。",
        "斜阳归鞅促，飞盖冒轻埃。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13496,
      "title": "行药",
      "content": [
        "行药徧城闉，仍逢摇落辰。",
        "坞风焦粟罅，园露饱梨津。",
        "远水多成浦，高云自作鳞。",
        "匕丹无复得，魂断小山人。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13497,
      "title": "湖上晚瞩",
      "content": [
        "湖平潦已收，清兴暂夷犹。",
        "风舸时摇缆，眠凫自去洲。",
        "荒藤依树老，残芡听波浮。",
        "珍重芣山色，苍苍到暝楼。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13498,
      "title": "答京西提刑张司封次韵",
      "content": [
        "乞得二千石，终非循吏才。",
        "霜蓬根易动，笼鸟翅难开。",
        "梦寤惭封邑，陶埏仰铉台。",
        "报言殊丽藻，虚附驿筩回。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13499,
      "title": "闰月晦日",
      "content": [
        "春物都城晚，欢游一倍慵。",
        "轻风生树态，暖日淡云容。",
        "小阁时翻燕，闲花更少蜂。",
        "幽襟真濩落，所得是无悰。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13500,
      "title": "赠楞严舒上人",
      "content": [
        "丈室锦城隈，庭闲地徧苔。",
        "饭从香积取，花续少林开。",
        "讲昼经残叶，禅宵烛委煤。",
        "无嫌一时学，要是暮云才。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13501,
      "title": "柔上人",
      "content": [
        "行年逾八十，安坐布金园。",
        "指柏仍余树，栽桐遂见孙。",
        "岩泉晨自濯，经叶夜能翻。",
        "顾我生多病，劳师默遣言。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13502,
      "title": "寿上人南游",
      "content": [
        "拂晓镮鸣月，迎寒毳拥霞。",
        "众香摩诘饭，五叶祖师花。",
        "托宿林枝俯，分风夕影斜。",
        "前期逢晤赏，持对碧云夸。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13503,
      "title": "送梵才长吉还天台",
      "content": [
        "归祴卷兰芽，城标拂曙霞。",
        "溪行鸥避锡，岩供马衔花。",
        "翠柰经园密，苍莓渡彴斜。",
        "暮云他日合，相望在天涯。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13504,
      "title": "寄药山长老省贤",
      "content": [
        "南方有尊者，卓锡恋林丘。",
        "演法三千界，多闻第一流。",
        "炉烟熏定几，笋脯供斋瓯。",
        "社约惭成负，霜莲落几秋。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13505,
      "title": "访僧舍",
      "content": [
        "近郭一牛鸣，金园界宝绳。",
        "众花天作雨，千焰佛传灯。",
        "碧柰垂园老，青莲杂漏凝。",
        "病襟多俗物，时此访南能。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13506,
      "title": "寥寥",
      "content": [
        "寥寥私沐地，索索晚秋时。",
        "高树足危响，寒花无媚姿。",
        "远砧投会急，昏雁赴行迟。",
        "抚物能无感，年华及始衰。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13507,
      "title": "早秋",
      "content": [
        "脱叶惊雕岁，翻车送落晖。",
        "蔗浆晨渴减，桃簟夜凉归。",
        "怨月收纨扇，轻云怯纻衣。",
        "沈愁知几许，带眼不胜围。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13508,
      "title": "山中晚春",
      "content": [
        "新火暮春天，穷山寄一廛。",
        "畹兰催酒熟，溪草作茵眠。",
        "落絮轻无定，残花浅自怜。",
        "缁帷谈久倦，江上问挐船。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13509,
      "title": "早春  其一",
      "content": [
        "春来人暗知，何物验来时。",
        "林暖树改色，山晴云弄姿。",
        "归鸿高的的，生浪细差差。",
        "老帅非行乐，劭农一驻旗。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13510,
      "title": "早春  其二",
      "content": [
        "鹍雪锁平苑，乌风袅迥竿。",
        "暖容侵柳动，寒意向梅残。",
        "云薄来无定，天晴望更宽。",
        "杯霞莫辞醉，朝野日多欢。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13511,
      "title": "西园早春二首  其一",
      "content": [
        "芳意稍菲菲，春城浓淡晖。",
        "霞留早阴住，风遣薄寒归。",
        "细溜兼沙漾，初禽隠叶飞。",
        "要知刀笔暇，文酒得相依。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13512,
      "title": "西园早春二首  其二",
      "content": [
        "樽酒不常满，年华祗自春。",
        "言归虽薄澣，业已负良辰。",
        "野翠欣欣徧，林红扑扑新。",
        "其如好风景，料理爱诗人。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13513,
      "title": "答翁愈赋卷",
      "content": [
        "登高大夫事，感物古诗流。",
        "韵变齐风缓，辞凌汉气遒。",
        "恨非雌霓赏，惟祝洞箫求。",
        "病客无盘玉，琅玕未易酬。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13514,
      "title": "池上  其一",
      "content": [
        "晚瞩西池上，池清暑气微。",
        "云烟互明灭，蒲荇两因依。",
        "戏𫚢来无定，眠凫久自飞。",
        "纷吾刀笔虑，逢此憺忘归。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13515,
      "title": "池上  其二",
      "content": [
        "雨止菰蒲老，风生杜若秋。",
        "水光晴动日，莲气晚薰舟。",
        "暗坞飞萤出，疏丛白鸟留。",
        "此时成丽赋，宁减翫游鯈。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13516,
      "title": "北园池上",
      "content": [
        "中园稍萧槭，日脚净空埃。",
        "寒蝶飞还下，饥鸥去又回。",
        "林高风搅叶，垣暗雨留苔。",
        "颇赋高秋兴，人非骑省才。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13517,
      "title": "避暑江渎祠池",
      "content": [
        "溪浅容篙短，舟移觉岸长。",
        "烟稠芰荷叶，霞热荔支房。",
        "技叠参挝鼓，杯寒十馈浆。",
        "便成逃暑醉，官事底相妨。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13518,
      "title": "夏日池上  其一",
      "content": [
        "溪流来不近，永日映霞霏。",
        "水荇自相缭，汀禽无次飞。",
        "颓沙时损路，幽濑忽藏矶。",
        "谁欲留连我，相将日暮归。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13519,
      "title": "夏日池上  其二",
      "content": [
        "独坐溪堂上，炎天客少过。",
        "红垂初熟果，碧卷未开荷。",
        "曳絮云更坞，摇金日弄波。",
        "一杯聊自举，凉意雨前多。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13520,
      "title": "扬雄墨池",
      "content": [
        "宅废经池在，人亡墨溜干。",
        "蟾蜍兼滴破，科斗共书残。",
        "蠹罢芸犹翠，蒸余竹自寒。",
        "他杨无可问，抚物费长叹。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13521,
      "title": "秋热",
      "content": [
        "风物连南国，炎威逼早秋。",
        "堕飞波上翼，误喘月中牛。",
        "云杼衣全解，冰壶渴未瘳。",
        "此时班女怨，虚为素纨愁。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13522,
      "title": "晚冬行园",
      "content": [
        "官舍同山舍，萧然日杖藜。",
        "饥鸥守冰沼，寒荠犯蔬畦。",
        "霜逼晴空迥，霞牵晚照低。",
        "城鸦栖已定，无事莫惊啼。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13523,
      "title": "过惠崇旧居  其一",
      "content": [
        "人往名长在，钦风历故居。",
        "社残莲即老，园废柰仍疏。",
        "麈忆清谈外，云经合座余。",
        "裴回视斋壁，行草暗残书。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13524,
      "title": "过惠崇旧居  其二",
      "content": [
        "虽昧平生契，怀贤要可伤。",
        "生涯与薪尽，法意共灯长。",
        "遗画空观貌，残诗孰补亡。",
        "神期通一语，无乃困津梁。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13525,
      "title": "和鉴宗游南禅别墅",
      "content": [
        "鹿园开别墅，牛驾此回轮。",
        "花识庄严界，林容宴坐人。",
        "远烟时误晚，静坞若遗春。",
        "共照前溪水，烦师洗六尘。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13526,
      "title": "对月  其一",
      "content": [
        "林梢霞尾暗，海面月华新。",
        "一水开天鉴，千金上佛轮。",
        "幽岩涵静桂，潜蚌溢凉津。",
        "不必姑山去，翛然自玉人。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13527,
      "title": "对月  其二",
      "content": [
        "月华真可爱，堂上共徘徊。",
        "白露方徐贶，清风适共来。",
        "蚌津随照满，乌阁为啼开。",
        "万虑方岑寂，愁看云汉回。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13528,
      "title": "望月",
      "content": [
        "早月始娟娟，西南寥泬天。",
        "魄中藏暗树，轮外上虚弦。",
        "傍汉含银浅，过云漏叶鲜。",
        "遥知今夜鹊，犹得稳枝眠。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13529,
      "title": "同小姪珪璞溪上泛舟",
      "content": [
        "出郭晓云霁，泛舟春日迟。",
        "诗怀随物放，酒面任风吹。",
        "循岸烦鸥起，看山惜棹移。",
        "州人轻此乐，頼与汝曹期。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13530,
      "title": "拟明月逐人来",
      "content": [
        "玉漏催成夜，兰釭换作晨。",
        "并花排彩树，分月送游人。",
        "醉幕星临酒，天街露禁尘。",
        "轻雷与流水，随意伴香轮。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13531,
      "title": "月",
      "content": [
        "西颢凉飚度，金枢宿霭收。",
        "映波休混璧，入幔且迷钩。",
        "蚌冷侵珠润，罗疏逼帐秋。",
        "风流知不浅，庾令在江楼。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13532,
      "title": "新月",
      "content": [
        "几宵闲北寝，始见映西楼。",
        "曲篆临钩误，残黄映额羞。",
        "桂稀山自冷，珠浅蚌兼愁。",
        "巧作纤纤句，才能喻两头。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13533,
      "title": "残月",
      "content": [
        "阴光随落宿，有意待朝阳。",
        "晕缺灰余影，潮平鹭息狂。",
        "残兵骄子国，隠语大刀郎。",
        "此夜方诸泪，宁能减数行。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13534,
      "title": "马上见残月",
      "content": [
        "娟娟天外月，正见上朝人。",
        "老桂欹藏树，纤钩侧抱轮。",
        "气清仍泛露，光淡即迎晨。",
        "尚作裴回意，西楼对结邻。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13535,
      "title": "落月",
      "content": [
        "已照金枢穴，初乘玉女扉。",
        "望花愁桂老，数叶畏蓂稀。",
        "汉蚌兼珠隠，边兵背塞归。",
        "持将离妾恨，一问上天飞。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13536,
      "title": "答劝农李渊宗嘉州江行",
      "content": [
        "嘉月嘉州路，轲峨按部船。",
        "山围杜宇国，江入夜郎天。",
        "霁引溪楼望，凉供水馆眠。",
        "愧君舟檝意，遂欲济长川。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13537,
      "title": "早发大堰",
      "content": [
        "晓戍胧胧白，春流纳纳深。",
        "生烟才著树，罢月稍依林。",
        "野路趋斜岸，渔舠泊暗浔。",
        "尚缘归国意，差足慰离襟。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13538,
      "title": "新竹",
      "content": [
        "最爱中唐竹，春来百个鲜。",
        "笋残霞落泊，梢散粉婵娟。",
        "早叶危衔露，昏枝巧住烟。",
        "宁孤一日赏，况在此君前。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 13539,
      "title": "永兴郑资政巩县路逢雪见寄",
      "content": [
        "大旆关河远，同云天地浮。",
        "凌晨逢朔雪，此路向西州。",
        "寒袭生犀健，光催畅毂流。",
