{
  "data": [
    {
      "id": 45292,
      "title": "和王元驹",
      "content": [
        "向来淮海说三秦，脚踏苏门最绝尘。",
        "莫道江山歇英气，如今文物有斯人。",
        "黄埃九陌谁知子，青竹千年独问津。",
        "未得相看已相识，只惭空叹蜀庄珍。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 45293,
      "title": "题丘成之司理明远阁",
      "content": [
        "决曹据按尘似海，高阁退食心如冰。",
        "夜将官本校家本，万山围里短檠灯。",
        "能文未得傲能吏，好官不应博丁字。",
        "何时著脚最高层，目送归鸿挥绿绮。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 45294,
      "title": "和谢昌国送韦俊臣相访",
      "content": [
        "芒𪨗为车不必巾，天穷未害子能文。",
        "谢家有句元无继，枉却催诗头上云。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45295,
      "title": "岁晚出城",
      "content": [
        "温饱能消底，奔忙自作痴。",
        "平生脚已茧，今日鬓将丝。",
        "山刻霜余骨，梅临水底枝。",
        "只嫌长落莫，不道许幽奇。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 45296,
      "title": "至鹧鸪洞",
      "content": [
        "岸冻树逾瘦，日高林始明。",
        "瑶草密如积，玉泉中暗鸣。",
        "初至心为动，欲归脚还停。",
        "江湖千万峰，穿侬两鞋青。",
        "如何鹧鸪岭，咫尺来未曾。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 45297,
      "title": "读张忠献公谥册感叹",
      "content": [
        "恩视韩兼赵，名均献与忠。",
        "礼中非不极，勋外若为同。",
        "三圣无多学，千年仅一翁。",
        "犹怜公议在，拚泪乞秋风。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 45298,
      "title": "寄张钦夫二首  其一",
      "content": [
        "作郡才佳政，留中即好音。",
        "还将著书手，拈出正君心。",
        "岳麓风霜饱，修门雨露深。",
        "登庸何恨晚，廊庙要山林。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 45299,
      "title": "寄张钦夫二首  其二",
      "content": [
        "工瑟曾缘利，鸣琴岂负予。",
        "发于贫里白，诗亦病来疎。",
        "知己俱霄汉，孤踪且簿书。",
        "三年知免矣，一饱会归欤。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 45300,
      "title": "和庆长怀麻阳叔二诗  其一",
      "content": [
        "旧雪才追送，新梅又作繁。",
        "欣逢上林雁，聊免管城冠。",
        "酒债多多在，诗盟久久寒。",
        "忽思十年事，有枕不能安。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 45301,
      "title": "和庆长怀麻阳叔二诗  其二",
      "content": [
        "自幼仍投老，相懽不解愁。",
        "政缘湖外别，负却竹林秋。",
        "佳政真余事，闻人说甚休。",
        "不应野水渡，横此济川舟。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 45302,
      "title": "送罗永年归永丰",
      "content": [
        "谁道三年聚，能胜一别多。",
        "岁寒知子可，心折奈吾何。",
        "所喜如椽笔，能挥却日戈。",
        "老夫留病眼，看子中文科。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 45303,
      "title": "夜坐小集",
      "content": [
        "霜余雪后夜无风，人在灯前梅影中。",
        "玉作寒蔬冰作酒，诗人犹自怨天穷。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45304,
      "title": "和谢昌国送管相士韵",
      "content": [
        "半世缘痴自作劳，万人争处我方逃。",
        "怜渠识尽公卿得，一马归来骨转高。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45305,
      "title": "郭汉卿母挽诗",
      "content": [
        "妇节今安仰，斯人古有光。",
        "鸡鸣不知雨，荠茂独凌霜。",
        "未拜金花诰，空悲玉树郎。",
        "藤舆帘蹙绣，无复出萱堂。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 45306,
      "title": "庚寅正月送罗季周游学禾川",
      "content": [
        "眼边相识蚕样密，如子岁寒万才一。",
        "我往西山子义山，老里一别堪三年。",
        "外舅阴功不知数，诸孙太半廊庙具。",
        "学文先要学忍饥，明年看子刺天飞。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 45307,
      "title": "过秀溪长句",
      "content": [
        "去年来此上巳日，今年重来未寒食。",
        "临溪照影老自羞，惭愧春光尚相识。",
        "秀溪何许好春容，最是溪深树密中。",
        "海棠开尽却成白，桃花欲落翻深红。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 45308,
      "title": "题荐福寺",
      "content": [
        "千山底里著楼台，半夜松风万壑哀。",
        "晓起巡簷看题壁，雨声一片隔林来。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45309,
      "title": "晚过黄洲铺二绝  其一",
      "content": [
        "数峰残日紫将销，一片新秧绿未交。",
        "道是今年春水小，涨痕也到岸花梢。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45310,
      "title": "晚过黄洲铺二绝  其二",
      "content": [
        "仆夫已倦路犹赊，脚底殊劳眼底佳。",
        "绿锦堆中半团雪，千枫拥出一桐花。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45311,
      "title": "过白沙渡得长句呈澹庵先生",
      "content": [
        "收红拾紫消几许，也费一春强半雨。",
        "不辞长江万波阻，来听先生夜深语。",
        "尚忆向来侍樽俎，微雪斜飞小梅吐。",
        "先生半酣染霜兔，金章玉句空万古。",
        "今年寒食还相聚，明年寒食知何处。",
        "只道先生押班去，不道门生折腰苦。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 45312,
      "title": "长句寄周舍人子充",
      "content": [
        "省斋先生太高寒，肯将好官博好山。",
        "又告君王觅闲散，要读短檠三万卷。",
        "州家新画瑞雾图，渠莫错认何关渠。",
        "青原两公复双起，山川出云不在此。",
        "自怜无地寄病身，四海知己非无人。",
        "老穷只是诗自悮，春色撩人又成句。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 45313,
      "title": "题峡江谭温父咏斋",
      "content": [
        "渔郎载我下峡水，夜寻故人有谭子。",
        "柴门竹屋断崖底，艮斋手题咏斋字。",
        "巴丘花草一番新，玉笥峰头月半轮。",
        "如今政是暮春者，三叹春风舞雩下。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 45314,
      "title": "浅夏独行奉新县圃",
      "content": [
        "我来官下未多时，梅已黄深李绿肥。",
        "只怪南风吹紫雪，不知屋角楝花飞。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45315,
      "title": "晚登清心阁望雨",
      "content": [
        "悯雨喜见云，喜云愁不雨。",
        "长风将怒点，慰此楼中暮。",
        "喜雨不但人，松竹亦鼓舞。",
        "未知今年熟，得似去年否。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 45316,
      "title": "登清心阁",
      "content": [
        "苦遭好月唤登楼，脚力虽慵不自由。",
        "上得金梯一回首，冰轮已过树梢头。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45317,
      "title": "立秋后一日雨天欲暮小立问月亭",
      "content": [
        "雨后林中别样凉，意行幽径不知长。",
        "风蝉幸自无星事，强为闲人报夕阳。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45318,
      "title": "七月十二日夜登清心阁醉吟",
      "content": [
        "小楼秋夜月明底，仰不见天惟见水。",
        "岸巾独立四无人，白月青天伴杨子。",
        "谁知横玉作秋声，一声吹尽九陌尘。",
        "月轮半仄吾未睡，楼角风生凉杀人。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 45319,
      "title": "月夜散策县圃有飞蝶仍闻笛声",
      "content": [
        "月明未许人早睡，笛声解与秋争清。",
        "夜深不应有飞蝶，渠侬似欲伴人行。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45320,
      "title": "中秋后一夕登清心阁二首  其一",
      "content": [
        "昨夜云为祟，今宵月始妍。",
        "如何一日隔，便减半分圆。",
        "影里偏宜竹，光中不剩天。",
        "客来休遣去，我醉正无眠。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 45321,
      "title": "中秋后一夕登清心阁二首  其二",
      "content": [
        "秋夜真成昼，西山却在东。",
        "吹高半轮月，正頼一襟风。",
        "清景今年过，何人此兴同。",
        "青天忽成纸，似欲借诗翁。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 45322,
      "title": "木犀",
      "content": [
        "天将秋气蒸寒馥，月借金波滴小黄。",
        "不会溪堂老居士，更谈桂子是天香。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45323,
      "title": "送客既归晚登清心阁",
      "content": [
        "谁不知侬嬾，其如送客何。",
        "叶声和雨细，山色上楼多。",
        "出处俱为累，升沉尽听他。",
        "疎钟暮相答，也解说愁么。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 45324,
      "title": "戏嘲金灯花上皂蝶",
      "content": [
        "花须为饭露为浆，黑雾玄霜剪薄裳。",
        "飞绕金灯来又去，不知能有几多香。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45325,
      "title": "刘世臣先生挽诗",
      "content": [
        "策第仍为邑，于公未足论。",
        "眼中无佛国，户外即韩门。",
        "道大功非细，人亡德则存。",
        "西风寄双泪，吹到秀峰原。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 45326,
      "title": "罗元通挽诗",
      "content": [
        "奏赋曾三北，兴能竟二南。",
        "如何双桂子，枉著拜亲衫。",
        "旧事余诗酒，何人续笑谈。",
        "生前孝友在，伐石为公镵。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 45327,
      "title": "罗价卿母李氏挽诗",
      "content": [
        "孝岂天无报，慈如古所称。",
        "百年得偕老，二子看同升。",
        "未拜鸾回纸，先虚绣蹙藤。",
        "他时颍考叔，清泪落君羹。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 45328,
      "title": "过西山",
      "content": [
        "一年两踏西山路，西山笑人应解语。",
        "胸中百斛朱墨尘，雨卷珠帘无半句。",
        "殷勤买酒谢西山，惭愧山光开我颜。",
        "鬓丝浑为催科白，尘埃满胸独遑惜。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 45329,
      "title": "豫章江皋二绝句  其一",
      "content": [
        "幸自轻阴好片秋，如何余热未全休。",
        "大江欲近风先冷，平野无边草亦愁。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45330,
      "title": "豫章江皋二绝句  其二",
      "content": [
        "只今秋稼满江郊，犹记春船掠屋茅。",
        "可是北风寒入骨，荻花争作向南梢。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45331,
      "title": "同李簿养直登秋屏",
      "content": [
        "大范今无寺，秋屏故有基。",
        "看山非不好，吊古却成悲。",
        "行役真何苦，同来也未迟。",
        "题诗只恶语，差胜不题诗。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 45332,
      "title": "送别吴帅",
      "content": [
        "我公四海不数人，小烦江西作好春。",
        "落霞秋水只似旧，如何入笔事事新。",
        "即今诸公方衮衮，一老不应闲里顿。",
        "政缘山水太殷勤，日夜叫阍乞此身。",
        "二天去人忽觉远，两地起公端不免。",
        "苍生未要怨东山，未必东山当此怨。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 45333,
      "title": "归自豫章复过西山",
      "content": [
        "一眼苕花十里明，忽疑九月雪中行。",
        "我行莫笑无驺从，自有西山管送迎。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45334,
      "title": "送何主簿归丰城",
      "content": [
        "众里非无士，难中却几人。",
        "如何新帅泽，偏作此邦春。",
        "未要栖鸾恨，方看报主身。",
        "青灯一樽酒，聊复话酸辛。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 45335,
      "title": "诏追供职学省晓发鸣山驿",
      "content": [
        "数店疎仍密，千峰整复斜。",
        "冰痕犹带浪，霜草自成花。",
        "录录堪朝列，星星已鬓华。",
        "帝城万事好，得似早还家。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 45336,
      "title": "望见灵山",
      "content": [
        "旱后催科恼杀侬，且随尺一解而东。",
        "灵山忽近西山远，回首新吴一梦中。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45337,
      "title": "登乌石寺",
      "content": [
        "回头身忽在树杪，一览千山万山小。",
        "怪崖不落欹欲摧，令人仰看怯眼开。",
        "小亭解事知侬倦，翼然飞出青山半。",
        "上头最上却镜平，百亩金碧千衲僧。",
        "高峰高寺更高阁，进步竿头若为脚。",
        "兹游胜绝庸非天，山下虚行二十年。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 45338,
      "title": "夜宿杨溪晓起见雪",
      "content": [
        "茅簷无声风不起，误喜夜来雨应止。",
        "开门送眼忽心惊，失却前山万堆翠。",
        "江南只说浙西山，更令著雪与人看。",
        "诸峰尽处一峰出，凛然玉立最高寒。",
        "溪声细伴吟声苦，客心冷趁波心去。",
        "掉头得句恐天嗔，且唤征夫问前路。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 45339,
      "title": "辛卯五月送丘宗卿太博出守秀州二首  其一",
      "content": [
        "冯翊端谁可，丘迟肯去么。",
        "茧丝臣敢后，饥馑帝云何。",
        "身达当难免，能称未要多。",
        "但无田里叹，不必袴襦歌。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 45340,
      "title": "辛卯五月送丘宗卿太博出守秀州二首  其二",
      "content": [
        "老矣渠怜我，超然我爱渠。",
        "论诗春雨夜，解手藕花初。",
        "梦只江湖去，情知伎俩疎。",
        "未应五马贵，不寄一行书。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 45341,
      "title": "代钱塘宰莫子章贺皇太子生辰",
      "content": [
        "寒外乾坤浄，霜前殿阁新。",
        "如何震一索，顿有月重轮。",
        "甲观堂初画，青宫牓更银。",
        "三天同日晓，一气八荒春。",
        "东序繙周学，南阳摘汉亲。",
        "承祧英类祖，问寝孝通神。",
        "帝子临京邑，藩寮著野人。",
        "天将重九节，瑞应诞弥辰。",
        "萸菊双为寿，山河总效珍。",
        "前星环紫极，长照漆园椿。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 45342,
      "title": "题吕子明国谕退庵",
      "content": [
        "笔砚工为祟，湖山苦约盟。",
        "坐忘非圣处，行乐且吾生。",
        "一笑谁当会，孤斟句恰成。",
        "何时却乘兴，雪外叩柴荆。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 45343,
      "title": "送蜀士张之源二子维焘中童子科西归",
      "content": [
        "岷山玉样清，岷水眼样明。",
        "风流文彩故应尔，又见张家双骥子。",
        "小儿八岁骨未成，诵书新作鸾鹤声。",
        "大儿十二气已老，觅句谈经人绝倒。",
        "豫章七年人得知，𫘝𫘨三日世便奇。",
        "天生异材能几许，更饱风霜也未迟。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 45344,
      "title": "壬辰别头胡元伯丞公折双梅见赠作一绝以谢之",
      "content": [
        "一花怪结双青子，独蔕还藏两玉花。",
        "薄相春工宁底巧，眼明初见雪枝斜。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45345,
      "title": "四月二日进士唱名万里以省试官待罪殿庐遇林谦之说诗夜归又得林柬因纪其事",
      "content": [
        "清晓朝帝所，就列复少须。",
        "不逢林夫子，于何得故吾。",
        "宫云霁犹未，宸风爽亦初。",
        "说诗怜新体，信美古则无。",
        "将无古人拙，未必今制疎。",
        "夜归辱良讯，送似谈笑余。",
        "病怀翻不乐，此意从谁舒。",
        "短歌纪幽事，老矣复焉如。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 45346,
      "title": "送黄仲秉少卿知泸州二首  其一",
      "content": [
        "滟滪方如象，余皇底似飞。",
        "相将刺天去，收拾大名归。",
        "西掖桐阴静，泸南荔子肥。",
        "未应经世具，便欲闭山扉。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 45347,
      "title": "送黄仲秉少卿知泸州二首  其二",
      "content": [
        "补外公何幸，求归我尚留。",
        "还为万里别，又费半生愁。",
        "安得欹黄帽，相从却白头。",
        "醉中有话在，欲说忘来休。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 45348,
      "title": "晚立西湖惠照寺石桥上",
      "content": [
        "船于镜面入烟丛，寺在湖心更柳中。",
        "暮色欲来吾欲去，其如南北两高峰。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45349,
      "title": "谒永祐陵归途游龙瑞宫观禹穴",
      "content": [
        "我昔骑凤超九疑，今复御风登会稽。",
        "禹穴下窥正深黑，地老天荒知是非。",
        "好峰高处偏薄雾，秋热苦时恰轻雨。",
        "回头却望昭陵松，云气成龙或成虎。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 45350,
      "title": "寄马会叔",
      "content": [
        "影转郎官宿，春随刺史天。",
        "相从忽相别，同舍况同年。",
        "我爱吴儿说，兄如邵父然。",
        "赐金真浪费，唤取从甘泉。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 45351,
      "title": "送傅安道郎中将漕七闽二首  其一",
      "content": [
        "一代风骚将，百年忠义家。",
        "出关称使者，踏雪度梅花。",
        "梦破南宫被，春生北斗槎。",
        "悬知入奏日，不待贡新茶。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 45352,
      "title": "送傅安道郎中将漕七闽二首  其二",
      "content": [
        "把酒春如许，论诗夜未央。",
        "相逢便金石，何必试冰霜。",
        "离合知难免，愁思自不忘。",
        "它年一茅屋，公肯访荒凉。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 45353,
      "title": "故恭人刘氏挽词",
      "content": [
        "雨露低苹沼，芝兰上桂林。",
        "鱼轩帘蹙绣，鸾纸诰涂金。",
        "死者夫何恨，归欤乃宿心。",
        "不偕君子老，愁绝白头吟。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 45354,
      "title": "王龟龄挽词",
      "content": [
        "佛以偏师胜，天能一手回。",
        "横空立万仞，不为作三魁。",
        "道大身无著，人亡世却哀。",
        "溪梅那解事，寂寞为谁开。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 45355,
      "title": "吴母叶氏太孺人挽词",
      "content": [
        "发以留宾短，家从教子贫。",
        "斑衣奉常署，象服镜湖春。",
        "许穆诗还废，班姑史尚新。",
        "不堪萱草露，也解泣慈亲。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 45356,
      "title": "答章汉直",
      "content": [
        "诗人今代谢宣城，举手新年章子平。",
        "雨剩风残忽春暮，花催草唤又诗成。",
        "五湖烟水三冬卧，万里云霄一日程。",
        "老里睡多吟里少，旧来句熟近来生。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 45357,
      "title": "西湖晚归",
      "content": [
        "际晚游人也合归，画船犹自弄斜晖。",
        "西湖两岸千株柳，絮不因风暖自飞。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45358,
      "title": "癸巳省宿咏南宫小桃",
      "content": [
        "孤坐南宫悄，桃花故故红。",
        "晴曛半脸日，寒惨数须风。",
        "昔岁山村里，春光痛饮中。",
        "不烦渠伴宿，今我已衰翁。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 45359,
      "title": "送李童子西归",
      "content": [
        "江西李家童子郎，腹载五车干玉皇。",
        "选德殿后春昼长，天子呼来傍御床。",
        "口角诵书如布谷，眼光骨法俱冰玉。",
        "紫绡轻衫发锦束，万人回头看不足。",
        "莫言幼慧长不奇，杨文公与晏临淄。",
        "老翁笞儿也太痴，欲鞭辕下追霜蹄。",
        "六岁取官曲肱似，春风昼绣归吾里。",
        "生子当如李童子，至如吾儿豚犬耳。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 45360,
      "title": "送林谦之司业出为桂路提刑",
      "content": [
        "雨眠起宵坐，搔首偶不欣。",
        "孤念元无感，怀我同社人。",
        "昨日林先生，抱经出成均。",
        "初闻为渠喜，忽悟谁我亲。",
        "缅然记宿昔，夜款水际门。",
        "微月耿秋寂，幽蛩慨凉新。",
        "论诗煮豆粥，粥熟天已晨。",
        "先生补天手，万象焉能春。",
        "若非千载仰，却要今世珍。",
        "圣门旧传业，不在先生身。",
        "雪前何有松，毁中谅非珉。",
        "论思尺有咫，决去曾逡巡。",
        "谁言我无耳，老矣未有闻。",
        "先生又舍我，离别尚足云。",
        "桂山玉笋立，桂水罗带纹。",
        "得句能寄似，不须持岭云。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 45361,
      "title": "寄题天台临海县白鹤庙西泉",
      "content": [
        "东泉千年流不休，西泉千年秘不流。",
        "临海令君一念作，猿鸟未知泉已觉。",
        "殿脚西头苍石根，向来元无泉眼痕。",
        "一朝擘崖迸膏乳，却与东泉作宾主。",
        "令君已升金掌中，白鹤古祠烟雨蒙。",
        "父老思君难再得，登亭饮泉三叹息，祝君公台寿千百。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 45362,
      "title": "和韩子云惠诗",
      "content": [
        "幸自同裘好，谁令异巷居。",
        "恭承五个字，不但百车渠。",
        "句法端何样，先生肯乞余。",
        "只容弹剑铗，敢道出无车。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 45363,
      "title": "送丁子章将漕湖南三首  其一",
      "content": [
        "岳麓猿声里，湘流雁影边。",
        "自天持一节，到日是新年。",
        "身退名逾重，今稀古则然。",
        "黄花非不好，只是插离筵。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 45364,
      "title": "送丁子章将漕湖南三首  其二",
      "content": [
        "湖外游曾漫，荒余好在么。",
        "山应依样瘦，民岂似田多。",
        "不是无风物，其如费拊摩。",
        "人言补外乐，且道定如何。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 45365,
      "title": "送丁子章将漕湖南三首  其三",
      "content": [
        "半世行天下，同心寡友生。",
        "故人今又去，此意向谁倾。",
        "白发三更语，青灯一点明。",
        "看渠还玉署，老我正归耕。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 45366,
      "title": "送叶叔羽寺丞持节淮东二首  其一",
      "content": [
        "呼酒东西玉，探梅南北枝。",
        "相逢长不款，此别有余思。",
        "古道寒如水，吾侪鬓已丝。",
        "一生商略此，更待赠临岐。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 45367,
      "title": "送叶叔羽寺丞持节淮东二首  其二",
      "content": [
        "煮海谁为祟，沿淮困不胜。",
        "民思贤使者，帝遣大农丞。",
        "玉节寒侵斗，牙樯冻作冰。",
        "来归闻早著，紫禁要渠登。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 45368,
      "title": "题张兴伯主簿经训堂",
      "content": [
        "范家尚有釜生鱼，张家无鱼釜也无。",
        "屠沽儿亦莫笑渠，渠有至富汝不如。",
        "一翁冻吟拥竹炉，诸郎映雪夜读书。",
        "山鬼来听鹤惊起，万壑无人霁月孤。",
        "不论取官大门闾，始是经训为菑畬。",
        "父子每腹百斛珠，出门掩鼻马牛裾。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 45369,
      "title": "马郎中母蒋夫人挽章",
      "content": [
        "文物余三迳，芝兰秀五常。",
        "鱼轩来粉省，象服去黄堂。",
        "此母今谁似，清名死不亡。",
        "一生令吏部，废却蓼莪章。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 45370,
      "title": "送韩子云检正将漕江东二首  其一",
      "content": [
        "宰士仍名士，诗人更德人。",
        "还家桐树古，揽辔绣衣新。",
        "不以髯边雪，而忘句里春。",
        "登庸衣钵在，得恋大江滨。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 45371,
      "title": "送韩子云检正将漕江东二首  其二",
      "content": [
        "名下得佳句，梦中哦半生。",
        "未逢心已契，相见眼偏明。",
        "复此匆匆别，苍然惘惘情。",
        "非关风外树，侬自作离声。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 45372,
      "title": "送陈行之寺丞出守南剑二首  其一",
      "content": [
        "甫尔丞农扈，翩然牧剑津。",
        "诸公谁不相，有子几何人。",
        "气节霜余凛，辞章玉样新。",
        "飞腾可轻料，渠亦正青春。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 45373,
      "title": "送陈行之寺丞出守南剑二首  其二",
      "content": [
        "我召公先到，公归我亦行。",
        "三年如梦尔，一笑可怜生。",
        "野店缘山去，春风并辔轻。",
        "先愁饶水上，话别若为情。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 45374,
      "title": "送乡僧德璘二首  其一",
      "content": [
        "衲子向来元士子，诗僧遮莫更禅僧。",
        "不妨参透诸方得，别有宫墙第一层。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45375,
      "title": "送乡僧德璘二首  其二",
      "content": [
        "湖上诸峰紫翠间，三年欲到几曾闲。",
        "侬今去处渠知么，不是南山即北山。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45376,
      "title": "别萧挺之泉州二首  其一",
      "content": [
        "郎署春同宿，州麾晚卜邻。",
        "出山成底事，借手得斯人。",
        "名实今无对，云霄早致身。",
        "再逢应互笑，谁发不如银。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 45377,
      "title": "别萧挺之泉州二首  其二",
      "content": [
        "八叶今成九，一枝谁敢双。",
        "野人应补外，贤者亦为邦。",
        "夹岸梅临水，孤帆雪涌江。",
        "别愁才半掬，不遣我心降。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 45378,
      "title": "甲午出知漳州晚发船龙山暮宿桐庐二首  其一",
      "content": [
        "一席清风万壑云，送将华发得归身。",
        "海潮也怯桐江浄，不遣涛头过富春。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45379,
      "title": "甲午出知漳州晚发船龙山暮宿桐庐二首  其二",
      "content": [
        "道涂奔走不曾安，却羡山家住得闲。",
        "记取还山安住日，更忘奔走道涂间。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45380,
      "title": "上严州乌石滩",
      "content": [
        "人语相闻数尺间，其如滩恶费人牵。",
        "已从滩下过滩上，却立前船待后船。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45381,
      "title": "雨里问讯张定叟通判西园杏花二首  其一",
      "content": [
        "白白红红一树春，晴光炫眼看难真。",
        "无端昨夜萧萧雨，细锦全机卸作茵。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45382,
      "title": "雨里问讯张定叟通判西园杏花二首  其二",
      "content": [
        "梅不嫌疎杏要繁，主人何忍折令残。",
        "也知雨意将无恶，为勒芳菲故故寒。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45383,
      "title": "携家小歇严州建德县簿厅晓起",
      "content": [
        "不堪久客只思归，晓起巡簷强撚髭。",
        "偶听梅梢啼一鸟，举头立看独多时。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45384,
      "title": "题严州新堂",
      "content": [
        "新堂略有次第否，忙里从公一来觑。",
        "是时新晴收旧雨，小风吹花掠巾屦。",
        "江山只道不解语，云何惠然堂上聚。",
        "北山故挽南山住，东溪不遣西溪去。",
        "向来天藏在何处，遭公拈出天不拒。",
        "旧亭不为山作主，背山起楼何以故。",
        "更烦好手铲东阜，放出钓台寸来许。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 45385,
      "title": "和冯倅投赠韵二首  其一",
      "content": [
        "先生弹铗冻吟时，此岂求他一世知。",
        "只怨送穷穷不去，元来却不怨工诗。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45386,
      "title": "和冯倅投赠韵二首  其二",
      "content": [
        "茧纸松煤细作行，两诗字字可珍藏。",
        "书生伎俩成何事，只博虚名万古香。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45387,
      "title": "积雨小霁暮立卷书亭前二首  其一",
      "content": [
        "报晴底用暮寒为，薄薄春衫横见欺。",
        "似有如无风细甚，柳丝无頼恰先知。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45388,
      "title": "积雨小霁暮立卷书亭前二首  其二",
      "content": [
        "淡紫斜阳嫩碧天，一春今夕始开颜。",
        "看山偶忘归来却，月到西廊第二间。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
