{
  "data": [
    {
      "id": 206205,
      "title": "谢公定和二范秋怀五首邀予同作  其一",
      "content": [
        "西风一叶脱，迹亦不可扫。",
        "巷有白马生，朝回焚谏草。",
        "谁云事君难，是亦父子间。",
        "所要功补衮，不言能犯颜。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 206206,
      "title": "谢公定和二范秋怀五首邀予同作  其二",
      "content": [
        "四会有黄令，学古著勋多。",
        "白头对红叶，奈此摇落何。",
        "虽怀斲鼻巧，有斧且无柯。",
        "安得五十弦，奏此寒士歌。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 206207,
      "title": "谢公定和二范秋怀五首邀予同作  其三",
      "content": [
        "采莲涉江湖，采菊度林薮。",
        "插鬓不成妍，谁怜飞蓬首。",
        "平生耦耕地，风雨深稂莠。",
        "谢公遂如此，永袖绝弦手。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 206208,
      "title": "谢公定和二范秋怀五首邀予同作  其四",
      "content": [
        "往日孙阳翟，才可任遗补。",
        "击强如摧枯，食蘗不知苦。",
        "属者缺谏垣，时论或未许。",
        "傥可假一邦，使民作邹鲁。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 206209,
      "title": "谢公定和二范秋怀五首邀予同作  其五",
      "content": [
        "用智常恨耄，用决常恨早。",
        "推毂天下士，诚心要倾倒。",
        "海宇日清明，庙堂勤洒扫。",
        "何为陈师道，白发三径草。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 206210,
      "title": "送谢公定作竟陵主簿",
      "content": [
        "谢公文章如虎豹，至今斑斑在儿孙。",
        "竟陵主簿极多闻，万事不理专讨论。",
        "涧松无心古须鬣，天球不瑑中粹温。",
        "落笔尘沙百马奔，剧谈风霆九河翻。",
        "胸中恢疏无怨恩，当官持廉庭不烦。",
        "吏民欺公亦可忍，慎勿惊鱼使水浑。",
        "汉滨耆旧今谁存，驷马高盖徒纷纷。",
        "安知四海习凿齿，拄笏看度南山云。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206211,
      "title": "奉答谢公静与荣子邕论狄元规孙少述诗长韵",
      "content": [
        "谢公遂如此，宰木已三霜。",
        "无人知句法，秋月自澄江。",
        "二子学迈俗，窥杜见牖窗。",
        "试斲郢人鼻，未免伤手创。",
        "蟹胥与竹萌，乃不美羊腔。",
        "自往见谢公，论诗得濠梁。",
        "世方尊两耳，未敢筑受降。",
        "丹穴凤凰羽，风林虎豹章。",
        "小谢有家法，闻此不听冰。",
        "相思北风恶，归雁落斜行。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206212,
      "title": "赠送张叔和",
      "content": [
        "张侯温如邹子律，能令阴谷黍生春。",
        "有齐先君之季女，十年择对无可人。",
        "箕帚扫公堂上尘，家风孝友故相亲。",
        "庙中时荐南涧苹，儿女衣袴得补纫。",
        "两家俱为白头计，察公与人意甚真。",
        "吏能束缚老奸手，要使鳏寡无颦呻。",
        "但回此光还照己，平生倦学皆日新。",
        "我提养生之四印，君家所有更赠君。",
        "百战百胜不如一忍，万言万当不如一默。",
        "无可简择眼界平，不藏秋毫心地直。",
        "我肱三折得此医，自觉两踵生光辉。",
        "团蒲日静鸟吟时，炉薰一炷试观之。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206213,
      "title": "送顾子敦赴河东三首  其一",
      "content": [
        "头白书林二十年，印章今领晋山川。",
        "紫参可掘宜包贡，青铁无多莫铸钱。",
        "劝课农桑诚有道，折冲樽俎不临边。",
        "要知使者功多少，看取春郊处处田。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 206214,
      "title": "送顾子敦赴河东三首  其二",
      "content": [
        "家在江东不系怀，爱民忧国有从来。",
        "月斜汾沁催驿马，雪暗岢岚传酒杯。",
        "塞上金汤惟粟粒，胸中水镜是人材。",
        "遥知更解青牛句，一寸功名心已灰。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 206215,
      "title": "送顾子敦赴河东三首  其三",
      "content": [
        "揽辔都城风露秋，行台无妾护衣篝。",
        "虎头妙墨能频寄，马乳蒲萄不待求。",
        "上党地寒应强饮，两河民病要分忧。",
        "犹闻昔在军兴日，一马人间费十牛。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 206216,
      "title": "司马文正公挽词四首  其一",
      "content": [
        "元祐开皇极，功归用老成。",
        "惟深万物表，不令四时行。",
        "日者倾三接，天乎奠两楹。",
        "堂堂宁复有，埋玉恸佳城。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 206217,
      "title": "司马文正公挽词四首  其二",
      "content": [
        "国在多艰日，人如大雅诗。",
        "忠清俱没世，孝友是生知。",
        "加璧延诸老，櫜弓抚四夷。",
        "公身与宗社，同作太平基。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 206218,
      "title": "司马文正公挽词四首  其三",
      "content": [
        "献纳无虚日，居然迹已陈。",
        "清班区玉石，宝历顺星辰。",
        "更化思鸣鵙，遗书似获麟。",
        "易名无异论，今代两三人。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 206219,
      "title": "司马文正公挽词四首  其四",
      "content": [
        "毁誉盖棺了，于今名实尊。",
        "哀荣有王命，终始酌民言。",
        "蝉冕三公府，深衣独乐园。",
        "公心两无累，忧国爱元元。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 206220,
      "title": "次韵子瞻武昌西山",
      "content": [
        "漫郎江南酒隠处，古木参天应手栽。",
        "石坳为尊酌花鸟，自许作鼎调盐梅。",
        "平生四海苏太史，酒浇不下胸崔嵬。",
        "黄州副使坐闲散，谏疏无路通银台。",
        "鹦鹉洲前弄明月，江妃起舞袜生埃。",
        "次山醉魂招仿佛，步入寒溪金碧堆。",
        "洗湔尘痕饮嘉客，笑倚武昌江作罍。",
        "谁知文章照今古，野老争席渔争隈。",
        "邓公勒铭留刻画，刳剔银钩洗绿苔。",
        "琢磨十年烟雨晦，摸索一读心眼开。",
        "谪去长沙忧𫛳入，归来杞国痛天摧。",
        "玉堂却对邓公直，北门唤仗听风雷。",
        "山川悠远莫浪许，富贵峥嵘今鼎来。",
        "万壑松声如在耳，意不及此文生哀。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206221,
      "title": "子瞻诗句妙一世乃云效庭坚体盖退之戏效孟郊樊宗师之比以文滑稽耳恐后生不解故次韵道之",
      "content": [
        "我诗如曹郐，浅陋不成邦。",
        "公如大国楚，吞五湖三江。",
        "赤壁风月笛，玉堂云雾窗。",
        "句法提一律，坚城受我降。",
        "枯松倒涧壑，波涛所舂撞。",
        "万牛挽不前，公乃独力扛。",
        "诸人方嗤点，渠非晁张双。",
        "但怀相识察，床下拜老庞。",
        "小儿未可知，客或许敦厖。",
        "诚堪婿阿巽，买红缠酒缸。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206222,
      "title": "柳闳展如子瞻甥也其才德甚美有意于学故以桃李不言下自成蹊八字作诗赠之  其一",
      "content": [
        "柳君文武甚，睨视万人豪。",
        "老气鼓不作，卷旗解弓刀。",
        "上为朝阳桐，下为涧溪毛。",
        "囊中有美实，期子种蟠桃。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 206223,
      "title": "柳闳展如子瞻甥也其才德甚美有意于学故以桃李不言下自成蹊八字作诗赠之  其二",
      "content": [
        "浮阳愧嘉鱼，道傍多苦李。",
        "古来贤达人，不争咸阳市。",
        "吾子富春秋，日月东趋水。",
        "潜圣有玉音，闻道而已矣。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 206224,
      "title": "柳闳展如子瞻甥也其才德甚美有意于学故以桃李不言下自成蹊八字作诗赠之  其三",
      "content": [
        "霜威能折绵，风力欲冰酒。",
        "勤子来访道，枵然我何有。",
        "寝兴与时俱，由我屈伸肘。",
        "饭羹自知味，如此是道不。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 206225,
      "title": "柳闳展如子瞻甥也其才德甚美有意于学故以桃李不言下自成蹊八字作诗赠之  其四",
      "content": [
        "任世万钧重，载言以为轩。",
        "空文误来世，圣达欲无言。",
        "咸池浴日月，深宅养灵根。",
        "胸中浩然气，一家同化元。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 206226,
      "title": "柳闳展如子瞻甥也其才德甚美有意于学故以桃李不言下自成蹊八字作诗赠之  其五",
      "content": [
        "陆沈百世师，寄食鲁柳下。",
        "我今见诸孙，风味窥大雅。",
        "大雅久不作，图王忽成霸。",
        "伟哉居移气，兰鲍在所化。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 206227,
      "title": "柳闳展如子瞻甥也其才德甚美有意于学故以桃李不言下自成蹊八字作诗赠之  其六",
      "content": [
        "圣学鲁东家，恭惟同出自。",
        "乘流去本远，遂有作书肆。",
        "日中驾肩来，薄晚常掉臂。",
        "徒嚣终无赢，归矣求己事。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 206228,
      "title": "柳闳展如子瞻甥也其才德甚美有意于学故以桃李不言下自成蹊八字作诗赠之  其七",
      "content": [
        "清润玉泉冰，高明秋景晴。",
        "妙年勤翰墨，银钩烂纵横。",
        "蓝田生美璞，未琢价连城。",
        "思为万乘器，柱下贵晚成。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 206229,
      "title": "柳闳展如子瞻甥也其才德甚美有意于学故以桃李不言下自成蹊八字作诗赠之  其八",
      "content": [
        "八方去求道，渺渺困多蹊。",
        "归来坐虚室，夕阳在吾西。",
        "君今秣高马，夙驾先鸣鸡。",
        "慎勿取我语，亲行乃不迷。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 206230,
      "title": "戏咏蜡梅二首  其一",
      "content": [
        "金蓓锁春寒，恼人香未展。",
        "虽无桃李颜，风味极不浅。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 206231,
      "title": "戏咏蜡梅二首  其二",
      "content": [
        "体薰山麝脐，色染蔷薇露。",
        "披拂不满襟，时有暗香度。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 206232,
      "title": "蜡梅",
      "content": [
        "天工戏剪百花房，夺尽人工更有香。",
        "埋玉地中成故物，折枝镜里忆新妆。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206233,
      "title": "从张仲谋乞蜡梅",
      "content": [
        "闻君寺后野梅发，香蜜染成宫样黄。",
        "不拟折来遮老眼，欲知春色到池塘。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206234,
      "title": "贾天锡惠宝薰乞诗予以兵卫森画戟燕寝凝清香十字作诗报之  其一",
      "content": [
        "险心游万仞，躁欲生五兵。",
        "隠几香一炷，灵台湛空明。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 206235,
      "title": "贾天锡惠宝薰乞诗予以兵卫森画戟燕寝凝清香十字作诗报之  其二",
      "content": [
        "昼食鸟窥台，宴坐日过砌。",
        "俗氛无因来，烟霏作舆卫。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 206236,
      "title": "贾天锡惠宝薰乞诗予以兵卫森画戟燕寝凝清香十字作诗报之  其三",
      "content": [
        "石蜜化螺甲，榠樝煮水沈。",
        "博山孤烟起，对此作森森。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 206237,
      "title": "贾天锡惠宝薰乞诗予以兵卫森画戟燕寝凝清香十字作诗报之  其四",
      "content": [
        "轮囷香事已，郁郁著书画。",
        "谁能入吾室，脱汝世俗械。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 206238,
      "title": "贾天锡惠宝薰乞诗予以兵卫森画戟燕寝凝清香十字作诗报之  其五",
      "content": [
        "贾侯怀六韬，家有十二戟。",
        "天资喜文事，如我有香癖。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 206239,
      "title": "贾天锡惠宝薰乞诗予以兵卫森画戟燕寝凝清香十字作诗报之  其六",
      "content": [
        "林花飞片片，香归衔泥燕。",
        "闭合和春风，还寻蔚宗传。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 206240,
      "title": "贾天锡惠宝薰乞诗予以兵卫森画戟燕寝凝清香十字作诗报之  其七",
      "content": [
        "公虚采苹宫，行乐在小寝。",
        "香光当发闻，色败不可稔。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 206241,
      "title": "贾天锡惠宝薰乞诗予以兵卫森画戟燕寝凝清香十字作诗报之  其八",
      "content": [
        "床帷夜气馥，衣桁晚烟凝。",
        "瓦沟鸣急雪，睡鸭照华灯。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 206242,
      "title": "贾天锡惠宝薰乞诗予以兵卫森画戟燕寝凝清香十字作诗报之  其九",
      "content": [
        "雉尾映鞭声，金炉拂太清。",
        "班近闻香早，归来学得成。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 206243,
      "title": "贾天锡惠宝薰乞诗予以兵卫森画戟燕寝凝清香十字作诗报之  其一○",
      "content": [
        "衣篝丽纨绮，有待乃芬芳。",
        "当念真富贵，自薰知见香。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 206244,
      "title": "次韵张仲谋过酺池寺斋",
      "content": [
        "十年醉锦幄，酴醾照金沙。",
        "敧眠春风底，不去留君家。",
        "是时应门儿，紫兰茁其芽。",
        "只今将弟妹，嬉戏牵羊车。",
        "忽书满窗纸，整整复斜斜。",
        "平生悲欢事，头绪乱如麻。",
        "苟禄无补报，几成来食嗟。",
        "喜君崇名节，青云似有涯。",
        "我梦江湖去，钓船刺芦花。",
        "江滨开园宅，畦蔗莳梨柤。",
        "梦惊如昨日，炊玉困京华。",
        "公来或藜羹，爱我不疵瑕。",
        "深念烦乡里，忍穷禁贷赊。",
        "夜谈帘幕冷，霜月动金蛇。",
        "即是桃李月，春虫语交加。",
        "我亦无酒饮，一室可盘蜗。",
        "要公共文字，朱墨勘舛差。",
        "非复少年日，声名取嫮姱。",
        "诸阮有二妙，能诗定自嘉。",
        "何时来煮餠，蟹眼试官茶。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206245,
      "title": "常父惠示丁卯雪十四韵谨同韵赋之",
      "content": [
        "春皇赋上瑞，来宁黄屋忧。",
        "下令走百神，大云庇九丘。",
        "风声将仁气，艳艳生瓦沟。",
        "寒花舞零乱，表里照皇州。",
        "千门委圭璧，晓日不肯收。",
        "元年冬无泽，穴处长螟蟊。",
        "两宫初旰食，补衮献良筹。",
        "有道四夷守，无征万邦休。",
        "耆年秉国论，泾渭极分流。",
        "辍耒入班品，逸民尽归周。",
        "股肱共一体，间不容戈矛。",
        "人材如金玉，同美异刚柔。",
        "正须众贤和，乃可疏共吺。",
        "改弦张敝法，病十九已瘳。",
        "王指要不匿，蚀非日月羞。",
        "桑林请六事，河水问九畴。",
        "天意果然得，玄功与吾谋。",
        "此物有嘉德，占年在麦秋。",
        "近臣知天喜，玉色动冕旒。",
        "儒馆无他事，作诗配崇丘。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206246,
      "title": "咏雪奉呈广平公",
      "content": [
        "连空春雪明如洗，忽忆江清水见沙。",
        "夜听疏疏还密密，晓看整整复斜斜。",
        "风回共作婆娑舞，天巧能开顷刻花。",
        "正使尽情寒至骨，不妨桃李用年华。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 206247,
      "title": "次韵宋懋宗僦居甘泉坊雪后书怀",
      "content": [
        "汉家太史宋公孙，漫逐班行谒帝阍。",
        "燕颔封侯空有相，蛾眉倾国自难昏。",
        "家徒四壁书侵坐，马瘦三山叶拥门。",
        "安得风帆随雪水，江南石上对漥尊。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 206248,
      "title": "和答子瞻和子由常父忆馆中故事",
      "content": [
        "二苏上连璧，三孔立分鼎。",
        "少小看飞腾，中年嗟远屏。",
        "风撼鹡鸰枝，波寒鸿雁影。",
        "天不椓斯文，俱来集台省。",
        "日月黄道明，桃李春昼永。",
        "时平少犴狱，地禁绝蛙黾。",
        "颇怀修故事，文会陈果茗。",
        "当时群玉府，人物殊秀整。",
        "下直马阗阗，杯盘具俄顷。",
        "共醉凌波袜，谁窥投辖井。",
        "天网极恢疏，道山非簿领。",
        "何曾归闭门，灯火生寒冷。",
        "欲观太平象，复古望公等。",
        "贱子托后车，当烦煮汤餠。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206249,
      "title": "双井茶送子瞻",
      "content": [
        "人间风日不到处，天上玉堂森宝书。",
        "想见东坡旧居士，挥毫百斛泻明珠。",
        "我家江南摘云腴，落硙霏霏雪不如。",
        "为君唤起黄州梦，独载扁舟向五湖。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 206250,
      "title": "和答子瞻",
      "content": [
        "一月空回长者车，报人问疾遣儿书。",
        "翰林贻我东南句，窗间默坐得玄珠。",
        "故园溪友脍腹腴，远包春茗问何如。",
        "玉堂下直长廊静，为君满意说江湖。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 206251,
      "title": "子瞻以子夏丘明见戏聊复戏答",
      "content": [
        "化工见弹太早计，端为失明能著书。",
        "迩来似天会事发，泪睫见光犹陨珠。",
        "喜公新赐紫琳腴，上清虚皇对久如。",
        "请天还我读书眼，愿载轩辕讫鼎湖。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 206252,
      "title": "省中烹茶怀子瞻用前韵",
      "content": [
        "合门井不落第二，竟陵谷帘定误书。",
        "思公煮茗共汤鼎，蚯蚓窍生鱼眼珠。",
        "置身九州之上腴，争名燄中沃焚如。",
        "但恐次山胸垒块，终便酒舫石鱼湖。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 206253,
      "title": "以双井茶送孔常父",
      "content": [
        "校经同省并门居，无日不闻公读书。",
        "故持茗椀浇舌本，要听六经如贯珠。",
        "心知韵胜舌知腴，何似宝云与真如。",
        "汤餠作魔应午寝，慰公渴梦吞江湖。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 206254,
      "title": "常父答诗有煎点径须烦绿珠之句复次韵戏答",
      "content": [
        "小鬟虽丑巧妆梳，扫地如镜能检书。",
        "欲买娉婷供煮茗，我无一斛明月珠。",
        "知公家亦阙扫除，但有文君对相如。",
        "正当为公乞如愿，作牋远寄宫亭湖。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 206255,
      "title": "戏呈孔毅父",
      "content": [
        "管城子无肉食相，孔方兄有绝交书。",
        "文章功用不经世，何异丝窠缀露珠。",
        "校书著作频诏除，犹能上车问何如。",
        "忽忆僧床同野饭，梦随秋雁到东湖。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 206256,
      "title": "谢黄从善司业寄惠山泉",
      "content": [
        "锡谷寒泉撱石俱，并得新诗虿尾书。",
        "急呼烹鼎供茗事，晴江急雨看跳珠。",
        "是功与世涤膻腴，令我屡空常晏如。",
        "安得左轓清颍尾，风炉煮茗卧西湖。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 206257,
      "title": "次韵奉酬刘景文河上见寄",
      "content": [
        "省中岑寂坐云窗，忽有归鸿拂建章。",
        "珍重多情惟石友，琢磨佳句问潜郎。",
        "遥怜部曲风沙里，不废平生翰墨场。",
        "想见哦诗煮春茗，向人怀抱绝关防。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 206258,
      "title": "见诸人唱和酴醾诗辄次韵戏咏",
      "content": [
        "梅残红药迟，此物共春归。",
        "名字因壶酒，风流付枕帏。",
        "坠钿香径草，飘雪浄垣衣。",
        "玉气晴虹发，沉材锯屑霏。",
        "直知多不厌，何忍摘令稀。",
        "常恨金沙学，颦时正可挥。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206259,
      "title": "次韵秦觏过陈无己书院观鄙句之作",
      "content": [
        "陈侯大雅姿，四壁不治第。",
        "碌碌盆盎中，见此古罍洗。",
        "薄饭不能羹，墙阴老春荠。",
        "惟有文字性，万古抱根柢。",
        "我学少师承，坎井可窥底。",
        "何因蒙赏味，相享当牲醴。",
        "试问求志君，文章自有体。",
        "玄钥锁灵台，渠当为君启。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206260,
      "title": "陈留市隠",
      "content": [
        "市井怀珠玉，往来人未逢。",
        "乘肩娇小女，邂逅此生同。",
        "养性霜刀在，阅人清镜空。",
        "时时能举酒，弹镊送飞鸿。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 206261,
      "title": "晁张和答秦觏五言予亦次韵",
      "content": [
        "山林与心违，日月使鬓换。",
        "儒衣相诟病，文字奉娱玩。",
        "自古非一秦，六籍盖多难。",
        "诗书或发冢，熟念令人惋。",
        "秦君锐本学，骥子已血汗。",
        "相期骖天衢，伯乐尝一盼。",
        "士为欲心缚，寸勇辄尺懦。",
        "要当观此心，日照云雾散。",
        "扶疏万物影，宇宙同璀璨。",
        "置规岂惟君，亦自警弛慢。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206262,
      "title": "刘晦叔许洮河绿石砚",
      "content": [
        "久闻岷石鸭头绿，可磨桂溪龙文刀。",
        "莫嫌文吏不知武，要试饱霜秋兔毫。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206263,
      "title": "以团茶洮州绿石砚赠无咎文潜",
      "content": [
        "晁子智囊可以括四海，张子笔端可以回万牛。",
        "自我得二士，意气倾九州。",
        "道山延阁委竹帛，清都太微望冕旒。",
        "贝宫胎寒弄明月，天网下罩一日收。",
        "此地要须无不有，紫皇访问富春秋。",
        "晁无咎，赠君越侯所贡苍玉璧，可烹玉尘试春色。",
        "浇君胸中过秦论，斟酌古今来活国。",
        "张文潜，赠君洮州绿石含风漪，能淬笔锋利如锥。",
        "请书元祐开皇极，第入思齐访落诗。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206264,
      "title": "谢王仲至惠洮州砺石黄玉印材",
      "content": [
        "洮砺发剑虹贯日，印章不琢色蒸栗。",
        "磨砻顽钝印此心，佳人持赠意坚密。",
        "佳人鬓雕文字工，藏书万卷胸次同。",
        "日临天闲豢真龙，新诗得意挟雷风。",
        "我贫无句当二物，看公倒海取明月。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206265,
      "title": "次韵文潜同游王舍人园",
      "content": [
        "移竹淇园下，买花洛水阳。",
        "风烟二十年，花竹可迷藏。",
        "九衢流车马，相值各匆忙。",
        "岂有道边宅，静居如宝坊。",
        "幅巾延客酒，妙歌小红裳。",
        "主人有班缀，衣拂御炉香。",
        "常恐𫛴鴂鸣，百草为不芳。",
        "故作龟曳尾，颇深漆园方。",
        "初开蜗牛庐，中置师子床。",
        "买田宛丘间，江汉起滥觞。",
        "今此百亩宫，冬温夏清凉。",
        "身闲阅世故，宇静发天光。",
        "安肯声利场，牵黄臂老苍。",
        "张侯笔瑞世，三秀丽斋房。",
        "作诗盛推赏，明珠计斛量。",
        "扫花坐晚吹，妙语益难忘。",
        "重游樊素病，捧心不能妆。",
        "来日犹可追，听我歌楚狂。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206266,
      "title": "卧陶轩",
      "content": [
        "陶公白头卧，宇宙一北窗。",
        "但闻窗风雨，平陆漫成江。",
        "卯金扛九鼎，把菊醉胡床。",
        "城南晁正字，国器无等双。",
        "日月丽宸极，大明朝万邦。",
        "假版未通班，晓严梦逄逄。",
        "万卷曲肱里，胸中湛秋霜。",
        "亦有好事人，叩门提酒缸。",
        "欲眠不遣客，佳处更难忘。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206267,
      "title": "次韵寄晁以道",
      "content": [
        "河汉牛与女，咫尺不得语。",
        "欢然共秋盘，以兹不忘故。",
        "我友在天末，问天许见否。",
        "云雨隔九关，日月不我与。",
        "念公坐臞禅，守心如缚虎。",
        "颇思携法喜，举案馌南亩。",
        "不闻犯斋收，犹闻画眉诩。",
        "良为鼻祖来，渠伊为伴侣。",
        "我有桂溪刀，聊凭东风去。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206268,
      "title": "次以道韵寄范子夷子默",
      "content": [
        "鼓缶多秦声，琵琶作胡语。",
        "是中非神奇，根器如此故。",
        "范公秉文德，断国极可否。",
        "至今筦枢机，大度而少与。",
        "蝉嫣世有人，风壑啸两虎。",
        "小心学忠孝，鄙事能垅亩。",
        "持论不籧筿，奉身谢夸诩。",
        "颇知城南园，文会英俊侣。",
        "何当休沐归，怀茗就煎去。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206269,
      "title": "僧景宗相访寄法王航禅师",
      "content": [
        "抱牍稍退凫鹜行，倦禅时作橐驼坐。",
        "忽忆头陀云外人，闭门作夏与僧过。",
        "一丝不挂鱼脱渊，万古同归蚁旋磨。",
        "山中雨熟瓜芋田，唤取小僧休乞钱。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 206270,
      "title": "次韵子瞻送顾子敦河北都运二首  其一",
      "content": [
        "儒者给事中，顾公甚魁伟。",
        "经明往行河，商略颇应史。",
        "劳人又费乏，国计安能已。",
        "成功渠有命，得人斯可喜。",
        "似闻阻饥余，恶少惊邑里。",
        "启钥探珠金，夺怀取姝美。",
        "部中十盗发，一二书奏纸。",
        "西连魏三河，东尽齐四履。",
        "此岂小事哉，何但行治水。",
        "使民皆农桑，乃是真儒耳。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206271,
      "title": "次韵子瞻送顾子敦河北都运二首  其二",
      "content": [
        "今代顾虎头，骨相自雄伟。",
        "不令长天官，亦合丞御史。",
        "能贫安四壁，无愠可三已。",
        "昨来立清班，国士相顾喜。",
        "何因将使节，风日按千里。",
        "汲黯不居中，似非朝廷美。",
        "太任录万事，御坐留谏纸。",
        "发政恐伤民，天步薄冰履。",
        "苍生忧其鱼，南亩多被水。",
        "公行图安集，信目勿信耳。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206272,
      "title": "慈孝寺饯子敦席上奉同孔经父八韵",
      "content": [
        "日永知槐夏，云黄喜麦秋。",
        "同朝国士集，赐沐吏功休。",
        "祇园冠盖地，清与耳目谋。",
        "晴云浮茗椀，飞雹落文楸。",
        "一客众主人，醉此顾虎头。",
        "虎头持龙节，排河使东流。",
        "厥田惟上上，桑麻十数州。",
        "计功不汗马，可致万户侯。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206273,
      "title": "次韵张昌言给事喜雨",
      "content": [
        "三雨全清六合尘，诗翁喜雨句凌云。",
        "垤漂战蚁余追北，柱击乖龙有裂文。",
        "减去鲜肥忧玉食，徧宗河岳起炉薰。",
        "圣功惠我丰年食，未有涓埃可报君。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 206274,
      "title": "送李德素归舒城",
      "content": [
        "僧夏莫问途，麦秋宜煮餠。",
        "北寺旬休归，长廊六月冷。",
        "簟翻寒江浪，茶破苍璧影。",
        "李侯为我来，遽以归期请。",
        "青衿废诗书，白发违定省。",
        "荒畦当鉏灌，蠹简要签整。",
        "挽衣不可留，决去事幽屏。",
        "天恢猎德网，日饎养贤鼎。",
        "此士落江湖，熟思令人瘿。",
        "胸中吉祥宅，膜外荣辱境。",
        "婆娑万物表，藏刃避肯綮。",
        "人生要当学，安宴不彻警。",
        "古来惟深地，相待汲修绠。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206275,
      "title": "咏李伯时摹韩干三马次子由韵简伯时兼寄李德素",
      "content": [
        "太史琐窗云雨垂，试开三马拂蛛丝。",
        "李侯写影韩干墨，自有笔如沙画锥。",
        "绝尘超日精爽紧，若失其一望路驰。",
        "马官不语臂指挥，乃知仗下非新羁。",
        "吾尝览观在坰马，驽骀成列无权奇。",
        "缅怀胡沙英妙质，一雄可将千万雌。",
        "决非皂枥所成就，天骥生驹人得之。",
        "千金市骨今何有，士或不价五羖皮。",
        "李侯画隠百僚底，初不自期人误知。",
        "戏弄丹青聊卒岁，身如阅世老禅师。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206276,
      "title": "次韵子瞻和子由观韩干马因论伯时画天马",
      "content": [
        "于阗花骢龙八尺，看云不受络头丝。",
        "西河骢作蒲萄锦，双瞳夹镜耳卓锥。",
        "长楸落日试天步，知有四极无由驰。",
        "电行山立气深稳，可耐珠鞯白玉羁。",
        "李侯一顾叹绝足，领略古法生新奇。",
        "一日真龙入图画，在坰群雄望风雌。",
        "曹霸弟子沙苑丞，喜作肥马人笑之。",
        "李侯论干独不尔，妙画骨相遗毛皮。",
        "翰林评书乃如此，贱肥贵瘦渠未知。",
        "况我平生赏神骏，僧中云是道林师。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206277,
      "title": "次韵答王眘中",
      "content": [
        "有身犹缚律，无梦到行云。",
        "俗里光尘合，胸中泾渭分。",
        "我搴江南秀，一见空马群。",
        "夸士慕钟鼎，寒儒守典坟。",
        "吾欲超万古，乃如负山蚊。",
        "能来商略此，趺坐对炉芬。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206278,
      "title": "子瞻去岁春侍立迩英子由秋冬间相继入侍作诗各述所怀予亦次韵四首  其一",
      "content": [
        "赤壁归来入紫清，堂堂心在鬓雕零。",
        "江沙踏破青鞋底，却结丝絇侍禁庭。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206279,
      "title": "子瞻去岁春侍立迩英子由秋冬间相继入侍作诗各述所怀予亦次韵四首  其二",
      "content": [
        "胸蟠万卷夜光寒，笔倒三江砚滴干。",
        "大似不蒙稽古力，只今犹著侍臣冠。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206280,
      "title": "子瞻去岁春侍立迩英子由秋冬间相继入侍作诗各述所怀予亦次韵四首  其三",
      "content": [
        "封掌丝纶罢记言，职亲黄屋傍尧轩。",
        "雁行飞上犹回首，不受青云富贵吞。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206281,
      "title": "子瞻去岁春侍立迩英子由秋冬间相继入侍作诗各述所怀予亦次韵四首  其四",
      "content": [
        "乐天名位聊相似，却是初无富贵心。",
        "只欠小蛮樊素在，我知造物爱公深。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206282,
      "title": "再次韵四首  其一",
      "content": [
        "隆儒殿阁对横经，咫尺清都雨露零。",
        "见说文星环北极，人间无路仰天庭。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206283,
      "title": "再次韵四首  其二",
      "content": [
        "风棂倒影日光寒，尧日当中露正干。",
        "殿上给扶鸣汉履，螭头簪笔见秦冠。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206284,
      "title": "再次韵四首  其三",
      "content": [
        "万国归心天不言，诸儒争席异临轩。",
        "圣功典学形歌颂，更觉曹刘不足吞。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206285,
      "title": "再次韵四首  其四",
      "content": [
        "延和西路古槐阴，不隔朝宗夙夜心。",
        "公有胸中五色线，平生补衮用功深。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206286,
      "title": "次韵子瞻题郭熙画秋山",
      "content": [
        "黄州逐客未赐环，江南江北饱看山。",
        "玉堂卧对郭熙画，发兴已在青林间。",
        "郭熙官画但荒远，短纸曲折开秋晚。",
        "江村烟外雨脚明，归雁行边余叠𪩘。",
        "坐思黄柑洞庭霜，恨身不如雁随阳。",
        "熙今头白有眼力，尚能弄笔映窗光。",
        "画取江南好风日，慰此将老镜中发。",
        "但熙肯画宽作程，十日五日一水石。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206287,
      "title": "题郭熙山水扇",
      "content": [
        "郭熙虽老眼犹明，便面江山取意成。",
        "一段风烟且千里，解如明月逐人行。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206288,
      "title": "题惠崇画扇",
      "content": [
        "惠崇笔下开江面，万里晴波向落晖。",
        "梅影横斜人不见，鸳鸯相对浴红衣。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206289,
      "title": "题郑防画夹五首  其一",
      "content": [
        "惠崇烟雨归雁，坐我潇湘洞庭。",
        "欲唤扁舟归去，故人言是丹青。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206290,
      "title": "题郑防画夹五首  其二",
      "content": [
        "能作山川远势，白头惟有郭熙。",
        "欲写李成骤雨，惜无六幅鹅溪。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206291,
      "title": "题郑防画夹五首  其三",
      "content": [
        "徐生脱水双鱼，吹沫相看晚图。",
        "老矣个中得计，作书远寄江湖。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206292,
      "title": "题郑防画夹五首  其四",
      "content": [
        "折苇枯荷共晚，红榴苦竹同时。",
        "睡鸭不知飘雪，寒雀四顾风枝。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206293,
      "title": "题郑防画夹五首  其五",
      "content": [
        "子母猿号槲叶，山南山北危机。",
        "世故谁能樗里，彀中皆是由基。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206294,
      "title": "戏题小雀捕飞虫画扇",
      "content": [
        "小虫心在一啄间，得失与世同轻重。",
        "丹青妙处不可传，轮扁斲轮如此用。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206295,
      "title": "题画孔雀",
      "content": [
        "桄榔暗天蕉叶长，终露文章婴世网。",
        "故山桂子落秋风，无因雌雄青云上。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206296,
      "title": "睡鸭",
      "content": [
        "山鸡照影空自爱，孤鸾舞镜不作双。",
        "天下真成长会合，两凫相倚睡秋江。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206297,
      "title": "小鸭",
      "content": [
        "小鸭看从笔下生，幻法生机全得妙。",
        "自知力小畏沧波，睡起晴沙依晚照。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206298,
      "title": "题刘将军雁二首  其一",
      "content": [
        "滕王蛱蝶双穿花，东丹胡马歕胡沙。",
        "祁连将军一笔雁，生不并世俱名家。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206299,
      "title": "题刘将军雁二首  其二",
      "content": [
        "将军一矢万人看，雪洒晴空碎羽翰。",
        "乞与失群沙宿雁，笔间千顷暮江寒。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206300,
      "title": "题刘将军鹅",
      "content": [
        "箭羽不霑春水，籀文时印平沙。",
        "想见山阴书罢，举群驱向王家。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206301,
      "title": "题晁以道雪雁图",
      "content": [
        "飞雪洒芦如银箭，前雁惊飞后回眄。",
        "凭谁说与谢玄晖，莫道澄湖静如练。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206302,
      "title": "次韵子瞻题无咎所得与可竹二首粥字韵戏嘲无咎人字韵咏竹  其一",
      "content": [
        "十字供笼餠，一水试茗粥。",
        "忽忆故人来，壁间风动竹。",
        "舍前粲戎葵，舍后荒苜蓿。",
        "此郎如竹瘦，十饭九不肉。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 206303,
      "title": "次韵子瞻题无咎所得与可竹二首粥字韵戏嘲无咎人字韵咏竹  其二",
      "content": [
        "地下文夫子，风流绝此人。",
        "能和晚烟色，幻出岁寒身。",
        "马鬣松成拱，鹅溪墨尚新。",
        "应怀斲泥手，去作主林神。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 206304,
      "title": "次韵文潜休沐不出二首  其一",
      "content": [
        "风尘车马逐，得失两关心。",
        "惟有张仲蔚，门前蓬藋深。",
        "自公及归沐，毕愿诗书林。",
        "墙东作瘦马，万里气骎骎。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    }
  ],
