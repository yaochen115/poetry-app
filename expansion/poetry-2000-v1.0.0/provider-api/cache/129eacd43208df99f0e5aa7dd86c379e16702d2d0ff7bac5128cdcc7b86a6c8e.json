        "鸳鸯池上两两飞，凤凰楼下双双度。",
        "物色正如此，佳期那不顾。",
        "银鞍绣毂盛繁华，可怜今夜宿娼家。",
        "娼家少妇不须颦，东园桃李片时春。",
        "君看旧日高台处，柏梁铜雀生黄尘。"
      ],
      "author": {
        "id": 3286,
        "name": "王勃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 277701,
      "title": "滕王阁",
      "content": [
        "滕王高阁临江渚，珮玉鸣鸾罢歌舞。",
        "画栋朝飞南浦云，珠帘暮卷西山雨。",
        "闲云潭影日悠悠，物换星移几度秋。",
        "阁中帝子今何在？",
        "槛外长江空自流。"
      ],
      "author": {
        "id": 3286,
        "name": "王勃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 277702,
      "title": "江南弄",
      "content": [
        "江南弄，巫山连楚梦，行雨行云几相送。",
        "瑶轩金谷上春时，玉童仙女无见期。",
        "紫露香烟渺难托，清风明月遥相思。",
        "遥相思，草徒绿，为听双飞凤凰曲。"
      ],
      "author": {
        "id": 3286,
        "name": "王勃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 277703,
      "title": "圣泉宴",
      "content": [
        "披襟乘石磴，列籍俯春泉。",
        "兰气熏山酌，松声韵野弦。",
        "影飘垂叶外，香度落花前。",
        "兴洽林塘晚，重岩起夕烟。"
      ],
      "author": {
        "id": 3286,
        "name": "王勃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 277704,
      "title": "寻道观",
      "content": [
        "芝廛光分野，蓬阙盛规模。",
        "碧坛清桂阈，丹洞肃松枢。",
        "玉笈三山记，金箱五岳图。",
        "苍虬不可得，空望白云衢。"
      ],
      "author": {
        "id": 3286,
        "name": "王勃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 277705,
      "title": "散关晨度",
      "content": [
        "关山凌旦开，石路无尘埃。",
        "白马高谭去，青牛真气来。",
        "重门临巨壑，连栋起崇隈。",
        "即今扬策度，非是弃𦈡回。"
      ],
      "author": {
        "id": 3286,
        "name": "王勃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 277706,
      "title": "别薛华",
      "content": [
        "送送多穷路，遑遑独问津。",
        "悲凉千里道，凄断百年身。",
        "心事同漂泊，生涯共苦辛。",
        "无论去与住，俱是梦中人。"
      ],
      "author": {
        "id": 3286,
        "name": "王勃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 277707,
      "title": "重别薛华",
      "content": [
        "明月沈珠浦，秋风濯锦川。",
        "楼台临绝岸，洲渚亘长天。",
        "旅泊成千里，栖遑共百年。",
        "穷途唯有泪，还望独潸然。"
      ],
      "author": {
        "id": 3286,
        "name": "王勃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 277708,
      "title": "游梵宇三觉寺",
      "content": [
        "杏阁披青磴，雕台控紫岑。",
        "叶齐山路狭，花积野坛深。",
        "萝幌栖禅影，松门听梵音。",
        "遽忻陪妙躅，延赏涤烦襟。"
      ],
      "author": {
        "id": 3286,
        "name": "王勃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 277709,
      "title": "麻平晚行",
      "content": [
        "百年怀土望，千里倦游情。",
        "高低寻戍道，远近听泉声。",
        "磵叶才分色，山花不辨名。",
        "羁心何处尽？",
        "风急暮猨清。"
      ],
      "author": {
        "id": 3286,
        "name": "王勃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 277710,
      "title": "送卢主簿",
      "content": [
        "穷途非所恨，虚室自相依。",
        "城阙居年满，琴尊俗事稀。",
        "开襟方未已，分袂忽多违。",
        "东岩富松竹，岁暮幸同归。"
      ],
      "author": {
        "id": 3286,
        "name": "王勃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 277711,
      "title": "饯韦兵曹",
      "content": [
        "征骖临野次，别袂惨江垂。",
        "川霁浮烟歛，山明落照移。",
        "鹰风凋晚叶，蝉露泣秋枝。",
        "亭臯分远望，延想间云涯。"
      ],
      "author": {
        "id": 3286,
        "name": "王勃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 277712,
      "title": "白下驿饯唐少府",
      "content": [
        "下驿穷交日，昌亭旅食年。",
        "相知何用早，怀抱即依然。",
        "浦楼低晚照，乡路隔风烟。",
        "去去如何道，长安在日边。"
      ],
      "author": {
        "id": 3286,
        "name": "王勃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 277713,
      "title": "杜少府之任蜀州",
      "content": [
        "城阙辅三秦，风烟望五津。",
        "与君离别意，同是宦游人。",
        "海内存知己，天涯若比隣。",
        "无为在岐路，儿女共霑巾。"
      ],
      "author": {
        "id": 3286,
        "name": "王勃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 277714,
      "title": "仲春郊外",
      "content": [
        "东园垂柳径，西堰落花津。",
        "物色连三月，风光绝四隣。",
        "鸟飞村觉曙，鱼戏水知春。"
      ],
      "author": {
        "id": 3286,
        "name": "王勃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 277715,
      "title": "郊兴",
      "content": [
        "空园歌独酌，春日赋闲居。",
        "泽兰侵小径，河柳覆长渠。",
        "雨去花光湿，风归叶影疎。",
        "山人不惜醉，唯畏绿尊虚。"
      ],
      "author": {
        "id": 3286,
        "name": "王勃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 277716,
      "title": "郊园即事",
      "content": [
        "烟霞春旦赏，松竹故年心。",
        "断山疑画障，县溜泻鸣琴。",
        "草徧南亭合，花开北院深。",
        "闲居饶酒赋，随兴欲抽簪。"
      ],
      "author": {
        "id": 3286,
        "name": "王勃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 277717,
      "title": "观佛迹寺",
      "content": [
        "莲座神容俨，松崖圣趾余。",
        "年长金迹浅，地久石文疎。",
        "颓华临曲磴，倾影赴前除。",
        "共嗟陵谷远，俄视化城虚。"
      ],
      "author": {
        "id": 3286,
        "name": "王勃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 277718,
      "title": "山居晚眺赠王道士",
      "content": [
        "金坛疎俗宇，玉洞侣仙群。",
        "花枝栖晚露，峰叶度晴云。",
        "斜照移山影，回沙拥籀文。",
        "琴尊方待兴，竹树已迎曛。"
      ],
      "author": {
        "id": 3286,
        "name": "王勃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 277719,
      "title": "八仙迳",
      "content": [
        "柰园欣八正，松岩访九仙。",
        "援萝窥雾术，攀林俯云烟。",
        "代北鸾骖至，辽西鹤骑旋。",
        "终希脱尘网，连翼下芝田。"
      ],
      "author": {
        "id": 3286,
        "name": "王勃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 277720,
      "title": "春日还郊",
      "content": [
        "闲情兼嘿语，携杖赴岩泉。",
        "草绿萦新带，榆青缀古钱。",
        "鱼床侵岸水，鸟路入山烟。",
        "还题平子赋，花树满春田。"
      ],
      "author": {
        "id": 3286,
        "name": "王勃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 277721,
      "title": "对酒春园作",
      "content": [
        "投簪下山阁，携酒对河梁。",
        "狭水牵长镜，高花送断香。",
        "繁莺歌似曲，疎蝶舞成行。",
        "自然催一醉，非但阅年光。"
      ],
      "author": {
        "id": 3286,
        "name": "王勃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 277722,
      "title": "观内怀仙",
      "content": [
        "玉架残书隐，金坛旧迹迷。",
        "牵花寻紫涧，步叶下清谿。",
        "琼浆犹类乳，石髓尚如泥。",
        "自能成羽翼，何必仰云梯。"
      ],
      "author": {
        "id": 3286,
        "name": "王勃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 277723,
      "title": "秋日别王长史",
      "content": [
        "别路余千里，深恩重百年。",
        "正悲西候日，更动北梁篇。",
        "野色笼寒雾，山光歛暮烟。",
        "终知难再奉，怀德自潸然。"
      ],
      "author": {
        "id": 3286,
        "name": "王勃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 277724,
      "title": "上巳浮江宴韵得遥字",
      "content": [
        "上巳年光促，中川兴绪遥。",
        "绿齐山叶满，红泄片花销。",
        "泉声喧后涧，虹影照前桥。",
        "遽悲春望远，江路积波潮。"
      ],
      "author": {
        "id": 3286,
        "name": "王勃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 277725,
      "title": "长柳",
      "content": [
        "晨征犯烟磴，夕憩在云关。",
        "晚风清近壑，新月照澄湾。",
        "郊童樵唱返，津叟钓歌还。",
        "客行无与晤，赖此释愁颜。"
      ],
      "author": {
        "id": 3286,
        "name": "王勃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 277726,
      "title": "铜雀妓二首 一",
      "content": [
        "金凤隣铜雀，漳河望邺城。",
        "君王无处所，台榭若平生。",
        "舞席纷何就，歌梁俨未倾。",
        "西陵松槚冷，谁见绮罗情。"
      ],
      "author": {
        "id": 3286,
        "name": "王勃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 277727,
      "title": "铜雀妓二首 二",
      "content": [
        "妾本深宫妓，层城闭九重。",
        "君王欢爱尽，歌舞为谁容。",
        "锦衾不复襞，罗衣谁再缝。",
        "高台西北望，流涕向青松。"
      ],
      "author": {
        "id": 3286,
        "name": "王勃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 277728,
      "title": "羁游饯别",
      "content": [
        "客心悬陇路，游子倦江干。",
        "槿丰朝砌静，筿密夜窗寒。",
        "琴声销别恨，风景驻离欢。",
        "宁觉山川远，悠悠旅思难。"
      ],
      "author": {
        "id": 3286,
        "name": "王勃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 277729,
      "title": "易阳早发",
      "content": [
        "饬装侵晓月，奔策候残星。",
        "危阁寻丹障，回梁属翠屏。",
        "云间迷树影，雾里失峰形。",
        "复此凉飙至，空山飞夜萤。"
      ],
      "author": {
        "id": 3286,
        "name": "王勃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 277730,
      "title": "焦岸早行和陆四",
      "content": [
        "侵星违旅馆，乘月戒征俦。",
        "复嶂迷晴色，虚岩辨暗流。",
        "猿吟山漏晓，萤散野风秋。",
        "故人渺何际，乡关云雾浮。"
      ],
      "author": {
        "id": 3286,
        "name": "王勃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 277731,
      "title": "深湾夜宿",
      "content": [
        "津涂临巨壑，村宇架危岑。",
        "堰绝滩声隐，风交树影深。",
        "江童暮理楫，山女夜调砧。",
        "此时故乡远，宁知游子心。"
      ],
      "author": {
        "id": 3286,
        "name": "王勃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 277732,
      "title": "伤裴录事丧子",
      "content": [
        "兰阶霜候早，松露穸台深。",
        "魄散珠胎没，芳销玉树沈。",
        "露文晞宿草，烟照惨平林。",
        "芝焚空欢息，流恨满籝金。"
      ],
      "author": {
        "id": 3286,
        "name": "王勃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 277733,
      "title": "泥谿",
      "content": [
        "弭櫂凌奔壑，低鞭蹑峻岐。",
        "江涛出岸险，峰磴入云危。",
        "溜急船文乱，岩斜骑影移。",
        "水烟笼翠渚，山照落丹崖。",
        "风生苹浦叶，露泣竹潭枝。",
        "泛水虽云美，劳歌谁复知。"
      ],
      "author": {
        "id": 3286,
        "name": "王勃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 277734,
      "title": "三月曲水宴得烟字",
      "content": [
        "彭泽官初去，河阳赋始传。",
        "田园归旧国，诗酒间长筵。",
        "列室窥丹洞，分楼瞰紫烟。",
        "萦回亘津渡，出没控郊鄽。",
        "凤琴调上客，龙辔俨群仙。",
        "松石偏宜古，藤萝不记年。",
        "重簷交密树，复磴拥危泉。",
        "抗石晞南岭，乘沙眇北川。",
        "傅岩来筑处，磻谿入钓前。",
        "日斜真趣远，幽思梦凉蝉。"
      ],
      "author": {
        "id": 3286,
        "name": "王勃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 277735,
      "title": "秋日仙游观赠道士",
      "content": [
        "石图分帝宇，银牒洞灵宫。",
        "回丹萦岫室，复翠上岩栊。",
        "雾浓金灶静，云暗玉坛空。",
        "野花常捧露，山叶自吟风。",
        "林泉明月在，诗酒故人同。",
        "待余逢石髓，从尔命飞鸿。"
      ],
      "author": {
        "id": 3286,
        "name": "王勃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 277736,
      "title": "晚留凤州",
      "content": [
        "宝鸡辞旧役，仙凤历遗墟。",
        "去此近城阙，青山明月初。"
      ],
      "author": {
        "id": 3286,
        "name": "王勃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 277737,
      "title": "羁春",
      "content": [
        "客心千里倦，春事一朝归。",
        "还伤北园里，重见落花飞。"
      ],
      "author": {
        "id": 3286,
        "name": "王勃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 277738,
      "title": "林塘怀友",
      "content": [
        "芳屏画春草，仙杼织朝霞。",
        "何如山水路，对面即飞花。"
      ],
      "author": {
        "id": 3286,
        "name": "王勃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 277739,
      "title": "山扉夜坐",
      "content": [
        "抱琴开野室，携酒对情人。",
        "林塘花月下，别似一家春。"
      ],
      "author": {
        "id": 3286,
        "name": "王勃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 277740,
      "title": "春庄",
      "content": [
        "山中兰叶径，城外李桃园。",
        "岂知人事静，不觉鸟声喧。"
      ],
      "author": {
        "id": 3286,
        "name": "王勃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 277741,
      "title": "春游",
      "content": [
        "客念纷无极，春泪倍成行。",
        "今朝花树下，不觉恋年光。"
      ],
      "author": {
        "id": 3286,
        "name": "王勃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 277742,
      "title": "春园",
      "content": [
        "山泉两处晚，花柳一园春。",
        "还持千日醉，共作百年人。"
      ],
      "author": {
        "id": 3286,
        "name": "王勃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 277743,
      "title": "林泉独饮",
      "content": [
        "丘壑经涂赏，花柳遇时春。",
        "相逢今不醉，物色自轻人。"
      ],
      "author": {
        "id": 3286,
        "name": "王勃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 277744,
      "title": "登城春望",
      "content": [
        "物外山川近，晴初景霭新。",
        "芳郊花柳遍，何处不宜春。"
      ],
      "author": {
        "id": 3286,
        "name": "王勃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 277745,
      "title": "他乡叙兴",
      "content": [
        "缀叶归烟晚，乘花落照春。",
        "边城琴酒处，俱是越乡人。"
      ],
      "author": {
        "id": 3286,
        "name": "王勃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 277746,
      "title": "夜兴",
      "content": [
        "野烟含夕渚，山月照秋林。",
        "还将中散兴，来偶步兵琴。"
      ],
      "author": {
        "id": 3286,
        "name": "王勃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 277747,
      "title": "临江二首 一",
      "content": [
        "泛泛东流水，飞飞北上尘。",
        "归骖将别櫂，俱是倦游人。"
      ],
      "author": {
        "id": 3286,
        "name": "王勃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 277748,
      "title": "临江二首 二",
      "content": [
        "去骖嘶别路，归櫂隐寒洲。",
        "江臯木叶下，应想故城秋。"
      ],
      "author": {
        "id": 3286,
        "name": "王勃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 277749,
      "title": "江亭夜月送别二首 一",
      "content": [
        "江送巴南水，山横塞北云。",
        "津亭秋月夜，谁见泣离群。"
      ],
      "author": {
        "id": 3286,
        "name": "王勃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 277750,
      "title": "江亭夜月送别二首 二",
      "content": [
        "乱烟笼碧砌，飞月向南端。",
        "寂寂离亭掩，江山此夜寒。"
      ],
      "author": {
        "id": 3286,
        "name": "王勃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 277751,
      "title": "别人四首 一",
      "content": [
        "久客逢余闰，他乡别故人。",
        "自然堪下泪，谁忍望征尘。"
      ],
      "author": {
        "id": 3286,
        "name": "王勃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 277752,
      "title": "别人四首 二",
      "content": [
        "江上风烟积，山幽云雾多。",
        "送君南浦外，还望将如何。"
      ],
      "author": {
        "id": 3286,
        "name": "王勃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 277753,
      "title": "别人四首 三",
      "content": [
        "桂轺虽不驻，兰筵幸未开。",
        "林塘风月赏，还待故人来。"
      ],
      "author": {
        "id": 3286,
        "name": "王勃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 277754,
      "title": "别人四首 四",
      "content": [
        "霜华净天末，雾色笼江际。",
        "客子常畏人，何为久留滞。"
      ],
      "author": {
        "id": 3286,
        "name": "王勃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 277755,
      "title": "赠李十四四首 一",
      "content": [
        "野客思茅宇，山人爱竹林。",
        "琴尊唯待处，风月自相寻。"
      ],
      "author": {
        "id": 3286,
        "name": "王勃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 277756,
      "title": "赠李十四四首 二",
      "content": [
        "小径偏宜草，空庭不厌花。",
        "平生诗与酒，自得会仙家。"
      ],
      "author": {
        "id": 3286,
        "name": "王勃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 277757,
      "title": "赠李十四四首 三",
      "content": [
        "乱竹开三径，飞花满四邻。",
        "从来扬子宅，别有尚玄人。"
      ],
      "author": {
        "id": 3286,
        "name": "王勃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 277758,
      "title": "赠李十四四首 四",
      "content": [
        "风筵调桂轸，月径引藤杯。",
        "直当花院里，书斋望晓开。"
      ],
      "author": {
        "id": 3286,
        "name": "王勃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 277759,
      "title": "早春野望",
      "content": [
        "江旷春潮白，山长晓岫青。",
        "他乡临睨极，花柳映边亭。"
      ],
      "author": {
        "id": 3286,
        "name": "王勃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 277760,
      "title": "山中",
      "content": [
        "长江悲已滞，万里念将归。",
        "况属高风晚，山山黄叶飞。"
      ],
      "author": {
        "id": 3286,
        "name": "王勃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 277761,
      "title": "冬郊行望",
      "content": [
        "桂密岩花白，梨疎林叶红。",
        "江臯寒望尽，归念断征篷。"
      ],
      "author": {
        "id": 3286,
        "name": "王勃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 277762,
      "title": "寒夜思友三首 一",
      "content": [
        "久别侵怀抱，他乡变容色。",
        "月下调鸣琴，相思此何极。"
      ],
      "author": {
        "id": 3286,
        "name": "王勃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 277763,
      "title": "寒夜思友三首 二",
      "content": [
        "云间征思断，月下归愁切。",
        "鸿雁西南飞，如何故人别。"
      ],
      "author": {
        "id": 3286,
        "name": "王勃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 277764,
      "title": "寒夜思友三首 三",
      "content": [
        "朝朝翠山下，夜夜苍江曲。",
        "复此遥相思，清尊湛芳绿。"
      ],
      "author": {
        "id": 3286,
        "name": "王勃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 277765,
      "title": "始平晚息",
      "content": [
        "观阙长安近，江山蜀路赊。",
        "客行朝复夕，无处是乡家。"
      ],
      "author": {
        "id": 3286,
        "name": "王勃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 277766,
      "title": "扶风昼届离京浸远",
      "content": [
        "帝里金茎去，扶风石柱来。",
        "山川殊未已，行路方悠哉。"
      ],
      "author": {
        "id": 3286,
        "name": "王勃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 277767,
      "title": "普安建阴题壁",
      "content": [
        "江汉深无极，梁岷不可攀。",
        "山川云雾里，游子几时还。"
      ],
      "author": {
        "id": 3286,
        "name": "王勃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 277768,
      "title": "九日",
      "content": [
        "九日重阳节，开门有菊花。",
        "不知来送酒，若个是陶家。"
      ],
      "author": {
        "id": 3286,
        "name": "王勃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 277769,
      "title": "秋江送别二首 一",
      "content": [
        "早是他乡值早秋，江亭明月带江流。",
        "已觉逝川伤别念，复看津树隐离舟。"
      ],
      "author": {
        "id": 3286,
        "name": "王勃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 277770,
      "title": "秋江送别二首 二",
      "content": [
        "归舟归骑俨成行，江南江北互相望。",
        "谁谓波澜才一水，已觉山川是两乡。"
      ],
      "author": {
        "id": 3286,
        "name": "王勃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 277771,
      "title": "蜀中九日",
      "content": [
        "九月九日望乡台，他席他乡送客杯。",
        "人情已厌南中苦，鸿雁那从北地来。"
      ],
      "author": {
        "id": 3286,
        "name": "王勃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 277772,
      "title": "寒夜怀友杂体二首 一",
      "content": [
        "北山烟雾始茫茫，南津霜月正苍苍。",
        "秋深客思纷无已，复值征鸿中夜起。"
      ],
      "author": {
        "id": 3286,
        "name": "王勃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 277773,
      "title": "寒夜怀友杂体二首 二",
      "content": [
        "复阁重楼向浦开，秋风明月度江来。",
        "故人故情怀故宴，相望相思不相见。"
      ],
      "author": {
        "id": 3286,
        "name": "王勃"
      },
      "dynasty": {
