{
  "data": [
    {
      "id": 261661,
      "title": "送从舅成都丞广南归蜀",
      "content": [
        "巴字天边水，秦人去是归。",
        "栈长山雨响，溪乱火田稀。",
        "俗富行应乐，官雄禄岂微。",
        "魏舒终有泪，还湿宁家衣。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261662,
      "title": "赠郭驸马 一",
      "content": [
        "青春都尉最风流，二十功成便拜侯。",
        "金距鬬鸡过上苑，玉鞭骑马出长楸。",
        "熏香荀令偏怜少，傅粉何郎不解愁。",
        "日暮吹箫杨柳陌，路人遥指凤凰楼。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 261663,
      "title": "赠郭驸马 二",
      "content": [
        "方塘似镜草芊芊，初月如钩未上弦。",
        "新开金埒看调马，旧赐铜山许铸钱。",
        "杨柳入楼吹玉笛，芙蓉出水妬花钿。",
        "今朝都尉如相顾，愿脱长裾学少年。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 261664,
      "title": "宿淮浦忆司空文明",
      "content": [
        "愁心一倍长离忧，夜思千重恋旧游。",
        "秦地故人成远梦，楚天凉雨在孤舟。",
        "诸溪近海潮皆应，独树边淮叶尽流。",
        "别恨转深何处写，前程唯有一登楼。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 261665,
      "title": "送濮阳录事赴忠州",
      "content": [
        "成名不遂双旌远，主印还为一郡雄。",
        "赤叶黄花随野岸，青山白水映江枫。",
        "巴人夜语孤舟里，越鸟春啼万壑中。",
        "闻说古书多未校，肯令才子久西东。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 261666,
      "title": "送马尊师",
      "content": [
        "南入商山松路深，石床溪水昼阴阴。",
        "云中采药随青节，洞里耕田映绿林。",
        "直上烟霞空举手，回经丘垅自伤心。",
        "武陵花木应长在，愿与渔人更一寻。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 261667,
      "title": "题元注林园",
      "content": [
        "谢家门馆似山林，碧石青苔满树阴。",
        "乳鹊眄巢花巷静，鸣鸠鼓翼竹园深。",
        "桔槔转水兼通药，方丈留僧共听琴。",
        "独有野人箕踞惯，过君始得一长吟。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 261668,
      "title": "野寺病居喜卢纶见访",
      "content": [
        "青青麦垅白云阴，古寺无人新草深。",
        "乳燕拾泥依古井，鸣鸠拂羽历花林。",
        "千年驳藓明山履，万尺垂萝入水心。",
        "一卧漳滨今欲老，谁知才子忽相寻。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 261669,
      "title": "送皎然上人归山",
      "content": [
        "适来世上岂缘名，适去人间岂为情。",
        "古寺山中几日到，高松月下一僧行。",
        "云阴鸟道苔方合，雪映龙潭水更清。",
        "法主欲归须有说，门人流泪厌浮生。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 261670,
      "title": "赠道士",
      "content": [
        "姓氏不书高士传，形神自得逸人风。",
        "已传花洞将秦接，更指茅山与蜀通。",
        "嬾说岁年齐绛老，甘为乡曲号涪翁。",
        "终朝卖卜无人识，敝服徒行入市中。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 261671,
      "title": "题云际寺准上人房",
      "content": [
        "高僧居处似天台，锡杖铜瓶对绿苔。",
        "竹巷雨晴春鸟啭，山房日午老人来。",
        "园中鹿过椒枝动，潭底龙游水沫开。",
        "独夜焚香礼遗像，空林月出始应回。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 261672,
      "title": "山中寄苗员外",
      "content": [
        "鸟鸣花发空山里，衡岳幽人藉草时。",
        "既近浅流安笔砚，还因平石布蓍龟。",
        "千寻楚水横琴望，万里秦城带酒思。",
        "闻说潘安方寓直，与君相见渐难期。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 261673,
      "title": "忆故山赠司空曙",
      "content": [
        "汉主金门正召才，马卿多病自迟回。",
        "旧山𫏐别老将至，芳草欲阑归去来。",
        "云在高天风会起，年如流水日长催。",
        "知君素有栖禅意，岁晏蓬门迟尔开。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 261674,
      "title": "闲园即事赠考功王员外",
      "content": [
        "南陌晴云稍变霞，东风动柳水纹斜。",
        "园林带雪潜生草，桃李虽春未有花。",
        "幸接上宾登郑驿，羞为长女似黄家。",
        "今朝一望还成暮，欲别芳菲恋岁华。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 261675,
      "title": "寄庐山真上人",
      "content": [
        "高僧无迹本难寻，更得禅行去转深。",
        "青草湖中看五老，白云山上宿双林。",
        "月明潭色澄空性，夜静猨声证道心。",
        "更[说谢]公南座好，烟萝到地几重阴。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 261676,
      "title": "题觉公新兰若",
      "content": [
        "头白禅师何处还，独开兰若树林间。",
        "鬼因巫祝传移社，神见天人请施山。",
        "猛虎听经金磬动，猕猴献蜜雪窗闲。",
        "新斋结誓如相许，愿与雷宗永闭关。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 261677,
      "title": "赠道者",
      "content": [
        "窗中忽有鹤飞声，方士因知道欲成。",
        "来取图书安枕里，便驱鸡犬向山行。",
        "花开深洞仙门小，路过悬桥羽节轻。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 261678,
      "title": "代弃妇答贾客",
      "content": [
        "玉垒城边争走马，铜鞮市里共乘舟。",
        "鸣环动珮恩无尽，掩袖低巾泪不流。",
        "畴昔将歌邀客醉，如今欲舞对君羞。",
        "忍怀贱妾平生曲，独上襄阳旧酒楼。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 261679,
      "title": "和李舍人直中书对月见寄",
      "content": [
        "名卿步月正淹留，上客裁诗怨别游。",
        "素魄近成班女扇，清光远似庾公楼。",
        "婵娟更称凭高望，皎洁能传自古愁。",
        "盈手入怀皆不见，阳春曲丽转难酬。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 261680,
      "title": "卧病闻吉中孚拜官寄元秘书昆季",
      "content": [
        "汉家采使不求声，自慰文章道欲行。",
        "毛遂登门虽异赏，韩非入传滥齐名。",
        "云归暂爱青山出，客去还愁白发生。",
        "年少奉亲皆愿达，敢将心事向玄成。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 261681,
      "title": "江上逢柳中庸",
      "content": [
        "旧住衡山曾夜归，见君江客忆荆扉。",
        "星沉岭上人行早，月过湖西鹤唳稀。",
        "弱竹万株频碍帻，新泉数步一褰衣。",
        "今来唯有禅心在，乡路翻成向翠微。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 261682,
      "title": "戏赠韩判官绅卿",
      "content": [
        "少寻道士居嵩岭，晚事高僧住沃洲。",
        "齿发未知何处老，身名且被外人愁。",
        "欲随山水居茅洞，已有田园在虎丘。",
        "独怪子猷缘掌马，雪时不肯更乘舟。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 261683,
      "title": "送周长史",
      "content": [
        "青枫树里宣城郡，独佐诸侯上板桥。",
        "江客亦能传好信，山僧多解说南朝。",
        "云阴出浦看帆小，草色连天见雁遥。",
        "别有空园落桃杏，知将丝组系兰桡。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 261684,
      "title": "题故将军庄",
      "content": [
        "曾将数骑过桑干，遥对单于饬马鞍。",
        "塞北征儿谙用剑，关西宿将许登坛。",
        "田园芜没归耕晚，弓箭开离出猎难。",
        "唯有老身如刻画，犹期圣主解衣看。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 261685,
      "title": "夜投丰德寺谒海上人",
      "content": [
        "半夜中峰有磬声，偶寻樵者问山名。",
        "上方月晓闻僧语，下界林疎见客行。",
        "野鹤巢边松最老，毒龙潜处水偏清。",
        "愿得远山知姓字，焚香洗钵过余生。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 261686,
      "title": "塞上",
      "content": [
        "二十在边城，军中得勇名。",
        "卷旗收败马，占碛拥残兵。",
        "覆阵乌鸢起，烧山草木明。",
        "塞闲思远猎，师老厌分营。",
        "雪岭无人迹，冰河足雁声。",
        "李陵甘此没，惆怅汉公卿。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 261687,
      "title": "送彭将军云中觐兄",
      "content": [
        "闻说苍鹰守，今朝欲下𫖔。",
        "因令白马将，兼道觅封侯。",
        "略地关山冷，防河雨雪稠。",
        "飜弓骋猨臂，承箭惜貂裘。",
        "设伏军谋密，坑降塞邑愁。",
        "报恩唯有死，莫使汉家羞。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 261688,
      "title": "奉赠苗员外",
      "content": [
        "朱户敞高扉，青槐碍落晖。",
        "八龙承庆重，三虎递朝归。",
        "坐竹人声绝，横琴鸟语稀。",
        "花慙潘岳貌，年称老莱衣。",
        "叶暗新樱熟，丝长粉蝶飞。",
        "应怜鲁儒贱，空与故山违。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 261689,
      "title": "酬丘拱外甥览余旧文见寄",
      "content": [
        "丘迟本才子，始冠即周旋。",
        "舅乏郄鉴爱，君如衞玠贤。",
        "礼将金友等，情向玉人偏。",
        "鄙俗那劳似，龙钟却要怜。",
        "投甎聊取笑，赠绮一何妍。",
        "野坐临黄菊，溪行踏绿钱。",
        "岩高云反下，洞黑水潜穿。",
        "僻岭猿偷栗，枯池雁唼莲。",
        "身居霞外寺，思发月明田。",
        "犹恨萦尘网，昏昏过几年。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 261690,
      "title": "赠岐山姜明府",
      "content": [
        "昨夜闻山雨，归心便似迟。",
        "几回惊叶落，即到白头时。",
        "雁影将魂去，虫声与泪期。",
        "马卿兼病老，宋玉对秋悲。",
        "谢客才为别，陶公已见思。",
        "非关口腹累，自是雪霜姿。",
        "酿酒栽黄菊，炊粳折绿葵。",
        "山河方入望，风日正宜诗。",
        "牧竖寒骑马，边烽晚立旗。",
        "兰凋犹有气，柳脆不成丝。",
        "别后如相问，高僧知所之。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 261691,
      "title": "下第上薛侍郎",
      "content": [
        "蓬荜春风起，开帘却自悲。",
        "如何飘梗处，又到采兰时。",
        "明镜方重照，微城寄一辞。",
        "家贫求禄早，身贱报恩迟。",
        "幸得皮存矣，须劳翼长之。",
        "铭肌非厚荅，肉骨是前期。",
        "纵觉新人好，宁忘旧主疑。",
        "终慙太丘道，不为小生私。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 261692,
      "title": "奉和秘书元丞杪秋忆终南旧居",
      "content": [
        "高门有才子，能履古人踪。",
        "白社陶元亮，青云阮仲容。",
        "田园忽归去，车马杳难逢。",
        "废巷临秋水，支颐向暮峰。",
        "行鱼避杨柳，惊鸭触芙蓉。",
        "石窦红泉细，山桥紫菜重。",
        "凤雏终食竹，鹤侣暂巢松。",
        "愿接烟霞赏，羁离计不从。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 261693,
      "title": "送归中丞使新罗",
      "content": [
        "东望扶桑日，何年是到时。",
        "片帆通雨露，积水隔华夷。",
        "浩淼风来远，虚冥鸟去迟。",
        "长波静云月，孤岛宿旌旗。",
        "别叶传秋意，回潮动客思。",
        "沧溟无旧路，何处问前期。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 261694,
      "title": "暮春寻终南柳处士",
      "content": [
        "庞眉一居士，鹑服隐尧时。",
        "种荳初成亩，还丹旧日师。",
        "入溪花径远，向岭鸟行迟。",
        "紫葛垂苔壁，青菰映柳丝。",
        "偶来尘外事，暂与素心期。",
        "终恨游春宫，同为岁月悲。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 261695,
      "title": "雪夜寻太白道士",
      "content": [
        "雪路夜朦胧，寻师杏树东。",
        "石坛连竹静，醮火照山红。",
        "再拜开金箓，焚香使玉童。",
        "篷瀛三岛至，天地一壶通。",
        "别客曾留药，逢舟或借风。",
        "出游居鹤上，避祸入羊中。",
        "过洞偏回首，登门未发蒙。",
        "桑田如可见，沧海几时空。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 261696,
      "title": "得山中道友书寄苗銭二员外",
      "content": [
        "有谋皆𫐘轲，非病亦迟回。",
        "壮志年年减，驰晖日日催。",
        "还山不及伴，到阙又无媒。",
        "高卧成长策，微官称下才。",
        "诗人识何谢，居士别宗雷。",
        "迹向尘中隐，书从谷口来。",
        "药栏遭鹿践，涧户被猿开。",
        "野鹤巢云窦，游龟上水苔。",
        "新欢追易失，故思渺难裁。",
        "自有归期在，劳君示劫灰。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 261697,
      "title": "酬前驾部员外郎苗发",
      "content": [
        "马融方直校，阅简复持铅。",
        "素业高风继，青春壮思全。",
        "论文多在夜，宿寺不虚年。",
        "自署区中职，同荒郭外田。",
        "山邻三径绝，野意八行传。",
        "煮玉矜新法，留符识旧仙。",
        "涵苔溪溜浅，摇浪竹桥悬。",
        "复洞潜栖燕，疎杨半翳蝉。",
        "咏歌虽有和，云锦独成妍。",
        "应以冯唐老，相讥示此篇。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 261698,
      "title": "宿荐福寺东池有怀故园因寄元校书",
      "content": [
        "暮雨风吹尽，东池一夜凉。",
        "伏流回弱荇，明月入垂杨。",
        "石竹闲开碧，蔷薇暗吐黄。",
        "倚琴看鹤舞，摇扇引桐香。",
        "旧笋方辞箨，新莲未满房。",
        "林幽花晚发，地远草先长。",
        "抚枕愁华鬓，凭栏想故乡。",
        "露余清汉直，云卷白榆行。",
        "惊鹊仍依树，游鱼不过粱。",
        "系舟偏忆戴，炊黍愿期张。",
        "末路还思借，前恩讵敢忘。",
        "从来叔夜嬾，非是接舆狂。",
        "众病婴公干，群忧集孝璋。",
        "慙将多误曲，今日献周郎。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 261699,
      "title": "送王副使还幷州",
      "content": [
        "幷州近胡地，此去事风沙。",
        "铁马垂金络，貂裘犯雪花。",
        "曾持两郡印，多比五侯家。",
        "继世新恩厚，从军旧国赊。",
        "戍烟千里直，边雁一行斜。",
        "想到清油幕，长谋出左军。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 261700,
      "title": "晚春过夏侯校书值其沉醉戏赠",
      "content": [
        "欹冠枕如意，独寝落花前。",
        "姚馥清时醉，边韶白日眠。",
        "曝裈还当屋，张幕便成天。",
        "谒客唯题凤，偷儿欲觇毡。",
        "失杯犹离席，坠履反登筵。",
        "本是墙东隐，今为瓮下僊。",
        "卧龙髯乍磔，栖蝶腹何便。",
        "阮籍供琴韵，陶潜余秫田。",
        "人逢毂阳望，春似永和年。",
        "愿我非工饮，期君行见怜。",
        "尝知渴羌好，亦觉醉胡贤。",
        "炙熟樽方竭，车回辖且全。",
        "噀风仍作雨，洒地即成泉。",
        "自鄙新丰过，迟回惜十年。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 261701,
      "title": "哭张南史因寄南史姪叔宗",
      "content": [
        "争路忽摧车，沈钩未得鱼。",
        "结交唯我少，丧旧自君初。",
        "谏草文难似，围棋智不如。",
        "仲宣新有赋，叔夜近无书。",
        "地闭滕公宅，山荒谢客庐。",
        "歼良从此恨，福善竟成虚。",
        "酿酒多同醉，烹鸡或取余。",
        "阮咸虽永别，岂共仲容疎。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 261702,
      "title": "长安感事呈卢纶",
      "content": [
        "十五事文翰，大儿轻孔融。",
        "长裾游邸第，笑傲五侯中。",
        "谏猎一朝寝，论边素未工。",
        "蹉跎潘鬓至，蹭蹬阮途穷。",
        "贷布怜宁兴，无金命未通。",
        "王陵固似戆，郭最遂非雄。",
        "敛板辞群彦，回车访老农。",
        "咏诗怀洛下，送客忆山东。",
        "沈病魂神浊，清斋思虑空。",
        "羸将衞玠比，冷共邺侯同。",
        "草舍才遮雨，荆窗不碍风。",
        "梨教通子守，酒是远师供。",
        "扪虱欣时泰，迎猫达岁丰。",
        "原门唯有席，井饮但加葱。",
        "少壮衿齐德，高年觉宋聋。",
        "寓书先论嬾，读易反求蒙。",
        "昔慕能鸣雁，今怜半死桐。",
        "秉心犹似矢，搔首忽如蓬。",
        "赤叶翻藤架，黄花盖菊丛。",
        "聊将呈匠伯，今已学愚公。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 261703,
      "title": "游终南山因寄苏奉礼士尊师苗员外",
      "content": [
        "半岭逢仙驾，清晨独采芝。",
        "壶中开白日，雾里卷朱旗。",
        "猨鸟知归路，松萝见会时。",
        "鸡声传洞远，鹤语报家迟。",
        "童子闲驱石，樵夫乐看棋。",
        "依稀醉后拜，恍惚梦中辞。",
        "海上终难接，人间益自疑。",
        "风尘甘独老，山水但相思。",
        "愿得烧丹诀，流沙永待师。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 261704,
      "title": "长安书事寄卢纶",
      "content": [
        "弱冠家庐岳，从师岁月深。",
        "翻同老夫见，殊寡少年心。",
        "及此时方晏，因之名亦沈。",
        "趋途非要路，避事乐空林。",
        "素业在山下，青泉当树阴。",
        "交游有凋丧，离别代追寻。",
        "向秀初闻笛，钟期久罢琴。",
        "残愁犹满貌，余泪可霑襟。",
        "勿以朱颜好，而忘白发侵。",
        "终期入灵洞，相与炼黄金。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 261705,
      "title": "送郭良辅下第东归",
      "content": [
        "献策不得意，驰车东出秦。",
        "暮年千里客，落日万家春。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 261706,
      "title": "妾薄命",
      "content": [
        "自从君弃妾，憔悴不羞人。",
        "唯余坏粉泪，未免映衫匀。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 261707,
      "title": "送暕上人游春",
      "content": [
        "独将支遁去，欲往戴颙家。",
        "晴野人临水，春山树发花。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 261708,
      "title": "晦日同苗员外游曲江",
      "content": [
        "晦日同携手，临流一望春。",
        "可怜杨柳陌，愁杀故乡人。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 261709,
      "title": "溪行逢雨与柳中庸",
      "content": [
        "日落众山昏，萧萧暮雨繁。",
        "那堪两处宿，共听一声猨。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 261710,
      "title": "和张尹忆东篱菊",
      "content": [
        "传书报刘尹，何事忆陶家。",
        "若为篱边菊，山中有此花。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 261711,
      "title": "幽居作",
      "content": [
        "山舍千年树，江亭万里云。",
        "回潮迎伍相，骤雨送湘君。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 261712,
      "title": "题云际寺暕上人故院",
      "content": [
        "白发怱怱色，青山草草心。",
        "远公仍下世，从此别东林。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 261713,
      "title": "观邻老栽松",
      "content": [
        "虽过老人宅，不解老人心。",
        "何事残阳里，栽松欲待阴。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 261717,
      "title": "客行赠冯著",
      "content": [
        "旅行虽别路，日暮各思归。",
        "欲下今朝泪，知君亦湿衣。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 261718,
      "title": "芜城",
      "content": [
        "风吹城上树，草没城边路。",
        "城里月明时，精灵自来去。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 261719,
      "title": "赠山中老人",
      "content": [
        "白首独一身，青山为四邻。",
        "虽行故乡陌，不见故乡人。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 261720,
      "title": "拜新月",
      "content": [
        "开帘见新月，便即下阶拜。",
        "细语人不闻，北风吹裙带。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 261721,
      "title": "听筝",
      "content": [
        "鸣筝金粟柱，素手玉房前。",
        "欲得周郎顾，时时误拂弦。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 261722,
      "title": "赠何兆",
      "content": [
        "文章似扬马，风骨又清羸。",
        "江汉君犹在，英灵信未衰。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 261723,
      "title": "同司空文明过坚上人故院",
      "content": [
        "我与雷居士，平生事远公。",
        "无人知是旧，共到影堂中。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 261724,
      "title": "杂诗",
      "content": [
        "主第辞高饮，石家赴宵会。",
        "金谷走车来，玉人骑马待。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 261725,
      "title": "感兴",
      "content": [
        "香炉最高顶，中有高人住。",
        "日暮下山来，月明上山去。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 261726,
      "title": "问张山人疾",
      "content": [
        "先生沈病意何如，蓬艾门前客转疎。",
        "不见领徒过绛帐，唯闻与婢削丹书。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 261727,
      "title": "江上送客",
      "content": [
        "故人南去汉江阴，秋雨萧萧云梦深。",
        "江上见人应下泪，由来远客易伤心。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 261728,
      "title": "闺情",
      "content": [
        "月落星稀天欲明，孤灯未灭梦难成。",
        "披衣更向门前望，不忿朝来鹊喜声。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 261729,
      "title": "送刘侍郎",
      "content": [
        "几人同去谢宣城，未及酬恩隔死生。",
        "唯有夜猨知客恨，峄阳溪路第三声。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 261730,
      "title": "重送郑宥归蜀因寄何兆",
      "content": [
        "黄花西上路何如，青壁连天雁亦疎。",
        "为报长卿休涤器，汉家思见茂陵书。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 261731,
      "title": "宿石涧店闻妇人哭",
      "content": [
        "山店门前一妇人，哀哀夜哭向秋云。",
        "自说夫因征战死，朝来逢著旧将军。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 261732,
      "title": "与道者别",
      "content": [
        "闻说沧溟今已浅，何当白鹤更归来。",
        "旧师唯有先生在，忍见门人掩泪回。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 261733,
      "title": "长门怨",
      "content": [
        "金壶漏尽禁门开，飞燕昭阳侍寝回。",
        "随分独眠秋殿里，遥闻语笑自天来。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 261734,
      "title": "忆友怀野寺旧居",
      "content": [
        "自嫌野性共人疎，忆向西林更结庐。",
        "寄谢山阴许都讲，昨来频得远公书。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 261735,
      "title": "听夜雨寄卢纶",
      "content": [
        "暮雨萧条过凤城，霏霏飒飒重还轻。",
        "闻君此夜东林宿，听得荷池几番声。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 261736,
      "title": "昭君词",
      "content": [
        "李陵初送子卿回，汉月明时惆怅来。",
        "忆著长安旧游处，千门万户玉楼台。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 261737,
      "title": "春晚游鹤林寺寄使府诸公",
      "content": [
        "野寺寻春花已迟，背岩惟有两三枝。",
        "明朝携酒犹堪醉，为报春风且莫吹。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 266461,
      "title": "杂曲歌辞 拜新月",
      "content": [
        "开帘见新月，便即下阶拜。",
        "细语人不闻，北风吹裙带。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 303273,
      "title": "早梅",
      "content": [
        "不知近水花先发，疑是经冬雪未销。",
        "（《千载佳句》卷下《草木部·梅》）。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 303274,
      "title": "湖南归梦",
      "content": [
        "归梦不知湖水濶，夜来还到洛阳城。",
        "（同前《别离部·旅情》）。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 334312,
      "title": "乐府杂曲：鼓吹曲辞：巫山高",
      "content": [
        "巫山十二峰，皆在碧虚中。",
        "回合云藏日，霏微雨带风。",
        "猿声寒过水，树色暮连空。",
        "愁向高唐望，清秋见楚宫。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 334398,
      "title": "横吹曲辞：折杨柳",
      "content": [
        "东城攀柳叶，柳叶低著草。",
        "少壮莫轻年，轻年有人老。",
        "柳发遍川岗，登高堪断肠。",
        "雨烟轻漠漠，何树近君乡。",
        "赠君折杨柳，颜色岂能久。",
        "上客莫沾巾，佳人正回首。",
        "新柳送君行，古柳伤君情。",
        "突兀临荒渡，婆娑出旧营。",
        "隋家两岸尽，陶宅五株平。",
        "日暮偏愁望，春山有鸟声。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 334409,
      "title": "横吹曲辞：关山月",
      "content": [
        "露湿月苍苍，关头榆叶黄。",
        "回轮照海远，分彩上楼长。",
        "水冻频移幕，兵疲数望乡。",
        "只应城影外，万里共如霜。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 334435,
      "title": "横吹曲辞：雨雪曲",
      "content": [
        "天山一丈雪，杂雨夜霏霏。",
        "湿马胡歌乱，经烽汉火微。",
        "丁零苏武别，疏勒范羌归。",
        "若著关头过，长榆叶定稀。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 334462,
      "title": "相和歌辞：度关山",
      "content": [
        "雁塞日初晴，胡关雪复平。",
        "危竿缘广漠，古窦傍长城。",
        "拔剑金星出，弯弧玉羽鸣。",
        "谁知系虏者，贾谊是书生。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 334504,
      "title": "相和歌辞：昭君词",
      "content": [
        "李陵初送子卿回，汉月明明照帐来。",
        "忆著长安旧游处，千门万户玉楼台。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 334740,
      "title": "相和歌辞：乌栖曲",
      "content": [
        "白马逐牛车，黄昏入狭斜。",
        "柳树乌争宿，"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 334754,
      "title": "相和歌辞：襄阳曲",
      "content": [
        "襄阳堤路长，草碧杨柳黄。",
        "谁家女儿临夜妆，",
        "同居女伴正衣裳，中庭寒月白如霜。",
        "贾生十八称才子，"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 334869,
      "title": "琴曲歌辞：王敬伯歌",
      "content": [
        "妾本舟中客，闻君江上琴。",
        "君初感妾叹，妾亦感君心。",
        "遂出合欢被，同为交颈禽。",
        "传杯惟畏浅，接膝犹嫌远。",
        "侍婢奏箜篌，女郎歌宛转。",
        "宛转怨如何，中庭霜渐多。",
        "霜多叶可惜，昨日非今夕。",
        "徒结万里欢，终成一宵客。",
        "王敬伯，渌水青山从此隔。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 334907,
      "title": "杂曲歌辞：妾薄命三首",
      "content": [
        "忆妾初嫁君，花鬟如绿云。",
        "回灯入绮帐，对面脱罗裙。",
        "折步教人学，偷香与客熏。",
        "容颜南国重，名字北方闻。",
        "一从失恩意，转觉身憔悴。",
        "对镜不梳头，倚窗空落泪。",
        "新人莫恃新，秋至会无春。",
        "从来闭在长门者，",
        "玉垒城边争走马，铜蹄市里共乘舟。",
        "鸣环动佩思无尽，",
        "忍怀贱妾平生曲，独上襄阳旧酒楼。",
        "自从君弃妾，憔悴不羞人。",
        "惟余坏粉泪，未免映衫匀。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 335009,
      "title": "杂曲歌辞：千里思",
      "content": [
        "凉州风月美，遥望居延路。",
        "泛泛下天云，青青缘塞树。",
        "燕山苏武上，海岛田横住。",
        "更是草生时，行人出门去。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 335033,
      "title": "杂曲歌辞：古别离二首",
      "content": [
        "水国叶黄时，洞庭霜落夜。",
        "行舟闻商估，宿在枫林下。",
        "此地送君还，茫茫似梦间。",
        "后期知几日，前路转多山。",
        "巫峡通湘浦，迢迢隔云雨。",
        "天晴见海樯，月落闻津鼓。",
        "人老自多愁，水深难急流。",
        "清宵歌一曲，白首对汀洲。",
        "与君桂阳别，令君岳阳待。",
        "后事忽差池，前期日空在。",
        "木落雁嗷嗷，洞庭波浪高。",
        "远山云似盖，极浦树如毫。",
        "朝发能几里，暮来风又起。",
        "如何两处愁，皆在孤舟里。",
        "昨夜天月明，长川寒且清。",
        "菊花开欲尽，荠菜拍来生。",
        "下江帆势速，五两遥相逐。",
        "欲问去时人，知投何处宿。",
        "空令猿啸时，泣对湘潭竹。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 335063,
      "title": "杂曲歌辞：荆州泊",
      "content": [
        "南楼西下时，月里闻来棹。",
        "桂水舳舻回，荆州津济闹。",
        "移帷望星汉，引带思容貌。",
        "今夜一江人，惟应妾身觉。"
      ],
      "author": {
        "id": 4196,
        "name": "李端"
      },
      "dynasty": {
        "id": 6,
