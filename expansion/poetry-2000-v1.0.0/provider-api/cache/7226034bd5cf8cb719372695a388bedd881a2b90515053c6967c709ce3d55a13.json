{
  "data": [
    {
      "id": 344017,
      "title": "长安客舍，赠李行父明府",
      "content": [
        "藏器待时少，知人自古难。",
        "遂令丹穴凤，晚食金琅玕。",
        "谁谓兵戈际，鸣琴方一弹。",
        "理烦善用简，济猛能兼宽。",
        "夙夜念黎庶，寝兴非宴安。",
        "洪波未静壑，何树不惊鸾。",
        "凫舄傍京辇，甿心悬灌坛。",
        "高槐暗苦雨，长剑生秋寒。",
        "旅食还为客，饥年亦尽欢。",
        "亲劳携斗水，往往救泥蟠。",
        "但恐酬明义，蹉跎芳岁阑。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 344019,
      "title": "山居新种花药，与道士同游赋诗",
      "content": [
        "自乐鱼鸟性，宁求农牧资。",
        "浅深爱岩壑，疏凿尽幽奇。",
        "雨花相助好，莺鸣春草时。",
        "种兰入山翠，引葛上花枝。",
        "风露拆红紫，缘溪复映池。",
        "新泉香杜若，片石引江蓠。",
        "宛谓武陵洞，潜应造化移。",
        "杖策携烟客，满袖掇芳蕤。",
        "蝴蝶舞留我，仙鸡闲傍篱。",
        "但令黄精熟，不虑韶光迟。",
        "笑指云萝径，樵人那得知。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 344020,
      "title": "初黄绶赴蓝田县作",
      "content": [
        "蟠木无匠伯，终年弃山樊。",
        "苦心非良知，安得入君门。",
        "忽忝英达顾，宁窥造化恩。",
        "萤光起腐草，云翼腾沉鲲。",
        "片石世何用，良工心所存。",
        "一叨尉京甸，三省惭黎元。",
        "贤尹正趋府，仆夫俨归轩。",
        "眼中县胥色，耳里苍生言。",
        "居人散山水，即景真桃源。",
        "鹿聚入田径，鸡鸣隔岭村。",
        "餐和俗久清，到邑政空论。",
        "且嘉讼庭寂，前阶满芳荪。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 344023,
      "title": "省中对雪寄元判官、拾遗昆季",
      "content": [
        "万点瑶台雪，飞来锦帐前。",
        "琼枝应比净，鹤发敢争先。",
        "散影成花月，流光透竹烟。",
        "今朝谢家兴，几处郢歌传。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 344024,
      "title": "山斋独坐，喜玄上人夕至",
      "content": [
        "舍下虎溪径，烟霞入暝开。",
        "柴门兼竹静，山月与僧来。",
        "心莹红莲水，言忘绿茗杯。",
        "前峰曙更好，斜汉欲西回。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 344025,
      "title": "秋夜寄张、韦二主簿",
      "content": [
        "凉夜褰帘好，轻云过月初。",
        "碧空河色浅，红叶露声虚。",
        "道阻天难问，机忘世易疏。",
        "不知双翠凤，栖棘复何如。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 344026,
      "title": "归故山路逢邻居隐者",
      "content": [
        "握手云栖路，潸然恨几重。",
        "谁知绿林盗，长占彩霞峰。",
        "心死池塘草，声悲石径松。",
        "无因芳杜月，琴酒更相逢。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 344027,
      "title": "落第，刘拾遗相送东归",
      "content": [
        "不醉百花酒，伤心千里归。",
        "独收和氏玉，还采旧山薇。",
        "出处离心尽，荣枯会面稀。",
        "预愁芳草色，一径入衡闱。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 344029,
      "title": "早下江宁",
      "content": [
        "暮天微雨散，凉吹片帆轻。",
        "云物高秋节，山川孤客情。",
        "霜苹留楚水，寒雁别吴城。",
        "宿浦有归梦，愁猿莫夜鸣。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 344030,
      "title": "登复州南楼",
      "content": [
        "孤树延春日，他山卷曙霞。",
        "客心湖上雁，归思日边花。",
        "行李迷方久，归期涉岁赊。",
        "故人云路隔，何处寄瑶华。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 344032,
      "title": "县城秋夕",
      "content": [
        "山城日易夕，愁生先掩扉。",
        "俸薄不沽酒，家贫忘授衣。",
        "露重蕙花落，月冷莎鸡飞。",
        "效拙惭无补，云林叹再归。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 344033,
      "title": "秋夜梁七兵曹同宿二首",
      "content": [
        "一笑不可得，同心相见稀。",
        "摘菱频贳酒，待月未扃扉。",
        "星影低惊鹊，虫声傍旅衣。",
        "卑栖岁已晚，共羡雁南飞。",
        "好欲弃吾道，今宵又遇君。",
        "老夫相劝酒，稚子待题文。",
        "月下谁家笛，城头几片云。",
        "如何此幽兴，明日重离群。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 344034,
      "title": "和万年成少府寓直",
      "content": [
        "赤县新秋夜，文人藻思催。",
        "钟声自仙掖，月色近霜台。",
        "一叶兼萤度，孤云带雁来。",
        "明朝紫书下，应问长卿才。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 344038,
      "title": "赠邻居齐六司仓",
      "content": [
        "沉冥众所遗，咫尺绝佳期。",
        "始觉衡门下，翛然太古时。",
        "鸡声共邻巷，烛影隔茅茨。",
        "坐惜牛羊径，芳荪白露滋。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 344039,
      "title": "送征雁",
      "content": [
        "秋空万里净，嘹唳独南征。",
        "风急翻霜冷，云开见月惊。",
        "塞长怯去翼，影灭有余声。",
        "怅望遥天外，乡愁满目生。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 344040,
      "title": "宴郁林观张道士房",
      "content": [
        "灭迹人间世，忘归象外情。",
        "竹坛秋月冷，山殿夜钟清。",
        "仙侣披云集，霞杯达曙倾。",
        "同欢不可再，朝暮赤龙迎。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 344042,
      "title": "哭空寂寺玄上人",
      "content": [
        "凄然双树下，垂泪远公房。",
        "灯续生前火，炉添没后香。",
        "阴阶明片雪，寒竹响空廊。",
        "寂灭应为乐，尘心徒自伤。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 344045,
      "title": "和人秋归终南山别业",
      "content": [
        "旧居三顾后，晚节重幽寻。",
        "野径到门尽，山窗连竹阴。",
        "昔年莺出谷，今日凤归林。",
        "物外凌云操，谁能继此心。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 344047,
      "title": "酬刘员外雨中见寄",
      "content": [
        "苦雨滴兰砌，秋风生葛衣。",
        "潢污三径绝，砧杵四邻稀。",
        "分与玄豹隐，不为湘燕飞。",
        "惭君角巾折，犹肯问衡闱。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 344048,
      "title": "赋得归云送李山人归华山",
      "content": [
        "秀色横千里，归云积几重。",
        "欲依毛女岫，初卷少姨峰。",
        "盖影随征马，衣香拂卧龙。",
        "只应函谷上，真气日溶溶。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 344050,
      "title": "寄郢州郎士元使君",
      "content": [
        "龙节知无事，江城不掩扉。",
        "诗传过客远，书到故人稀。",
        "坐啸看潮起，行春送雁归。",
        "望舒三五夜，思尽谢玄晖。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 344052,
      "title": "下第题长安客舍",
      "content": [
        "不遂青云望，愁看黄鸟飞。",
        "梨花度寒食，客子未春衣。",
        "世事随时变，交情与我违。",
        "空余主人柳，相见却依依。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 344053,
      "title": "陪考功王员外城东池亭宴",
      "content": [
        "无双锦帐郎，绝境有林塘。",
        "鹤静疏群羽，蓬开失众芳。",
        "晴山看不厌，流水趣何长。",
        "日晚催归骑，钟声下夕阳。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 344056,
      "title": "穷秋对雨",
      "content": [
        "晦日连苦雨，动息更邅回。",
        "生事萍无定，愁心云不开。",
        "翟门悲暝雀，墨灶上寒苔。",
        "始信宣城守，乘流畏曝腮。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 344059,
      "title": "晚归蓝田，酬王维给事赠别",
      "content": [
        "卑栖却得性，每与白云归。",
        "徇禄仍怀橘，看山免采薇。",
        "暮禽先去马，新月待开扉。",
        "霄汉时回首，知音青琐闱。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 344060,
      "title": "再得华侍御书，闻巴中卧病",
      "content": [
        "芳信来相续，同心远更亲。",
        "数重云外树，不隔眼中人。",
        "梦寐花骢色，相思黄鸟春。",
        "更闻公干病，一夜二毛新。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 344061,
      "title": "宿新里馆",
      "content": [
        "愁人待晓鸡，秋雨暗凄凄。",
        "度烛萤时灭，传书雁渐低。",
        "客来知计误，梦里泣津迷。",
        "无以逃悲思，寒螀处处啼。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 344062,
      "title": "谷口书斋寄杨补阙",
      "content": [
        "泉壑带茅茨，云霞生薜帷。",
        "竹怜新雨后，山爱夕阳时。",
        "闲鹭栖常早，秋花落更迟。",
        "家童扫萝径，昨与故人期。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 344063,
      "title": "衡门春夜",
      "content": [
        "不厌晴林下，微风度葛巾。",
        "宁唯北窗月，自谓上皇人。",
        "丛筱轻新暑，孤花占晚春。",
        "寄言庄叟蝶，与尔得天真。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 344064,
      "title": "题吴通微主人",
      "content": [
        "食贫无尽日，有愿几时谐。",
        "长啸秋光晚，谁知志士怀。",
        "朝烟不起灶，寒叶欲连阶。",
        "饮水仍留我，孤灯点夜斋。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 344065,
      "title": "晚次宿预馆",
      "content": [
        "乡心不可问，秋气又相逢。",
        "飘泊方千里，离悲复几重。",
        "回云随去雁，寒露滴鸣蛩。",
        "延颈遥天末，如闻故国钟。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 344068,
      "title": "新昌里言怀",
      "content": [
        "性拙偶从宦，心闲多掩扉。",
        "虽看北堂草，不望旧山薇。",
        "花月霁来好，云泉堪梦归。",
        "如何建章漏，催著早朝衣。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 344069,
      "title": "秋夜寄袁中丞、王员外",
      "content": [
        "一夕盈千念，方知别者劳。",
        "衰荣难会面，魂梦暂同袍。",
        "片月临阶早，晴河度雁高。",
        "应怜蒋生径，秋露满蓬蒿。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 344071,
      "title": "晚入宣城界",
      "content": [
        "斜日片帆阴，春风孤客心。",
        "山来指樵路，岸去惜花林。",
        "海气蒸云黑，潮声隔雨深。",
        "乡愁不可道，浦宿听猿吟。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 344072,
      "title": "静夜酬通上人问疾",
      "content": [
        "东林生早凉，高枕远公房。",
        "大士看心后，中宵清漏长。",
        "惊蝉出暗柳，微月隐回廊。",
        "何事沈疴久，舍毫问药王。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 344078,
      "title": "銮驾避狄岁寄别韩云卿",
      "content": [
        "白发壮心死，愁看国步移。",
        "关山惨无色，亲爱忽惊离。",
        "影绝龙分剑，声哀鸟恋枝。",
        "茫茫云海外，相忆不相知。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 344080,
      "title": "蓝上采石芥寄前李明府",
      "content": [
        "渊明遗爱处，山芥绿芳初。",
        "玩此春阴色，犹滋夜雨余。",
        "隔溪烟叶小，覆石雪花舒。",
        "采采还相赠，瑶华信不如。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 344081,
      "title": "送赟法师往上都",
      "content": [
        "远近化人天，王城指日边。",
        "宰君迎说法，童子伴随缘。",
        "到处花为雨，行时杖出泉。",
        "今宵松月下，门闭想安禅。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 344083,
      "title": "送虞说擢第东游",
      "content": [
        "湖山不可厌，东望有余情。",
        "片玉登科后，孤舟任兴行。",
        "月中严子濑，花际楚王城。",
        "岁暮云皋鹤，闻天更一鸣。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 344084,
      "title": "送少微师西行",
      "content": [
        "随缘忽西去，何日返东林。",
        "世路宁嗟别，空门久息心。",
        "人烟一饭少，山雪独行深。",
        "天外猿啼处，谁闻清梵音。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 344086,
      "title": "送屈突司马充安西书记",
      "content": [
        "制胜三军劲，澄清万里余。",
        "星飞庞统骥，箭发鲁连书。",
        "海月低云旆，江霞入锦车。",
        "遥知太阿剑，计日斩鲸鱼。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 344091,
      "title": "送陈供奉恩敕放归觐省",
      "content": [
        "得意今如此，清光不可攀。",
        "臣心尧日下，乡思楚云间。",
        "杨柳依归棹，芙蓉栖旧山。",
        "采兰兼衣锦，何似买臣还。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 344097,
      "title": "送郭秀才制举下第南游",
      "content": [
        "失志思浪迹，知君晦近名。",
        "出关尘渐远，过郢兴弥清。",
        "山尽溪初广，人闲舟自行。",
        "探幽无旅思，莫畏楚猿鸣。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 344101,
      "title": "送郎四补阙东归",
      "content": [
        "无事共干世，多时废隐沦。",
        "相看恋簪组，不觉老风尘。",
        "劝酒怜今别，伤心倍去春。",
        "徒言树萱草，何处慰离人。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 344108,
      "title": "送杨皞擢第游江南",
      "content": [
        "行人临水去，新咏复新悲。",
        "万里高秋月，孤山远别时。",
        "挂帆严子濑，酹酒敬亭祠。",
        "岁晏无芳杜，如何寄所思。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 344110,
      "title": "送张管书记",
      "content": [
        "边事多劳役，儒衣逐鼓鼙。",
        "日寒关树外，峰尽塞云西。",
        "河广篷难度，天遥雁渐低。",
        "班超封定远，之子去思齐。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 344111,
      "title": "送萧常侍北使",
      "content": [
        "绛节引雕戈，鸣驺动玉珂。",
        "戎城去日远，汉使来年多。",
        "雁宿常连雪，沙飞半渡河。",
        "明光朝即迩，杕杜早成歌。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 344118,
      "title": "送原公南游",
      "content": [
        "有意兼程去，飘然二翼轻。",
        "故乡多久别，春草不伤情。",
        "洗钵泉初暖，焚香晓更清。",
        "自言难解缚，何日伴师行。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 344119,
      "title": "送万兵曹赴广陵",
      "content": [
        "秋日思还客，临流语别离。",
        "楚城将坐啸，郢曲有余悲。",
        "山晚桂花老，江寒苹叶衰。",
        "应须杨得意，更诵长卿辞。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 344120,
      "title": "送李判官赴桂州幕",
      "content": [
        "欲知儒道贵，缝掖见诸侯。",
        "且感千金诺，宁辞万里游。",
        "雁峰侵瘴远，桂水出云流。",
        "坐惜离居晚，相思绿蕙秋。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 344122,
      "title": "赋得寒云轻重色，送子恂入京",
      "content": [
        "无限寒云色，苍茫浅更深。",
        "从龙如有瑞，捧日不成阴。",
        "积翠全低岭，虚明半出林。",
        "帝乡遥在目，铁马又骎骎。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 344123,
      "title": "赋得丛兰曙后色，送梁侍御入京",
      "content": [
        "曙色传芳意，分明锦绣丛。",
        "兰生霁后日，花发夜来风。",
        "不向三峰里，全胜一县中。",
        "遥知大苑内，应待五花骢。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 344125,
      "title": "赋得浦口望斜月，送皇甫判官",
      "content": [
        "起见西楼月，依依向浦斜。",
        "动摇生浅浪，明灭照寒沙。",
        "水渚犹疑雪，梅林不辨花。",
        "送君无可赠，持此代瑶华。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 344126,
      "title": "赋得绵绵思远道，送岑判官入岭",
      "content": [
        "极目烟霞外，孤舟一使星。",
        "兴中寻白雪，梦里过沧溟。",
        "夜月松江戍，秋风竹坞亭。",
        "不知行远近，芳草日青青。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 344127,
      "title": "江宁春夜裴使君席送萧员外",
      "content": [
        "花院日扶疏，江云自卷舒。",
        "主人熊轼任，归客雉门车。",
        "曙月稀星里，春烟紫禁余。",
        "行看石头戍，记得是南徐。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 344132,
      "title": "送元中丞江淮转运",
      "content": [
        "薄税归天府，轻徭赖使臣。",
        "欢沾赐帛老，恩及卷绡人。",
        "去问殊官俗，来经几劫春。",
        "东南御亭上，莫问有风尘。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 344133,
      "title": "送唐别驾赴郢州",
      "content": [
        "少年从事好，此去别愁轻。",
        "满座诗人兴，随君郢路行。",
        "蒹葭侵驿树，云水抱山城。",
        "遥爱下车日，江皋春草生。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 344135,
      "title": "宿远上人兰若",
      "content": [
        "香花闭一林，真士此看心。",
        "行道白云近，燃灯翠壁深。",
        "梵筵清水月，禅坐冷山阴。",
        "更说东溪好，明朝乘兴寻。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 344141,
      "title": "晚春永宁墅小园独坐，寄上王相公",
      "content": [
        "东阁一何静，莺声落日愁。",
        "夔龙暂为别，昏旦思兼秋。",
        "蕙草出篱外，花枝寄竹幽。",
        "上方传雅颂，七夕让风流。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 344144,
      "title": "宴崔驸马玉山别业",
      "content": [
        "金榜开青琐，骄奢半隐沦。",
        "玉箫惟送酒，罗袖爱留宾。",
        "竹馆烟催暝，梅园雪误春。",
        "满朝辞赋客，尽是入林人。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 344145,
      "title": "春谷幽居",
      "content": [
        "黄鸟鸣园柳，新阳改旧阴。",
        "春来此幽兴，宛是谢公心。",
        "扫径兰芽出，添池山影深。",
        "虚名随振鹭，安得久栖林。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 344146,
      "title": "赋得池上双丁香树",
      "content": [
        "得地移根远，交柯绕指柔。",
        "露香浓结桂，池影斗蟠虬。",
        "黛叶轻筠绿，金花笑菊秋。",
        "何如南海外，雨露隔炎洲。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 344149,
      "title": "崔十四宅问候",
      "content": [
        "晓日早莺啼，江城旅思迷。",
        "微官同寄傲，移疾阻招携。",
        "远水闾阎内，青山雉堞西。",
        "王孙莫久卧，春草欲萋萋。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 344150,
      "title": "山路见梅，感而有作",
      "content": [
        "莫言山路僻，还被好风催。",
        "行客凄凉过，村篱冷落开。",
        "晚溪寒水照，晴日数蜂来。",
        "重忆江南酒，何因把一杯。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 344151,
      "title": "咏门上画松，上元、王、杜三相公",
      "content": [
        "昔闻生涧底，今见起毫端。",
        "众草此时没，何人知岁寒。",
        "岂能裨栋宇，且欲出门阑。",
        "只在丹青笔，凌云也不难。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 344152,
      "title": "早发东阳",
      "content": [
        "信风催过客，早发梅花桥。",
        "数雁起前渚，千艘争便潮。",
        "将随浮云去，日惜故山遥。",
        "惆怅烟波末，佳期在碧霄。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 344153,
      "title": "舟中寄李起居",
      "content": [
        "南行风景好，昏旦水皋闲。",
        "春色郢中树，晴霞湖上山。",
        "去家旅帆远，回首暮潮还。",
        "蕙草知何赠，故人云汉间。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 344155,
      "title": "喜李侍御拜郎官入省",
      "content": [
        "粉署花骢入，丹霄紫诰垂。",
        "直庐惊漏近，赐被觉霜移。",
        "汉主前瑶席，穰侯许凤池。",
        "应怜后行雁，空羡上林枝。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 344156,
      "title": "苏端林亭对酒喜雨",
      "content": [
        "小雨飞林顶，浮凉入晚多。",
        "能知留客处，偏与好风过。",
        "濯锦翻红蕊，跳珠乱碧荷。",
        "芳尊深几许，此兴可酣歌。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 344157,
      "title": "见上林春雁翔青云，寄杨起居、李员外",
      "content": [
        "上林春更好，宾雁不知归。",
        "顾影怜青籞，传声入紫微。",
        "夜陪池鹭宿，朝出苑花飞。",
        "宁忆寒乡侣，鸾凰一见稀。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 344158,
      "title": "偶成",
      "content": [
        "含毫意不浅，微月上帘栊。",
        "门静吏人息，心闲囹圄空。",
        "繁星入疏树，惊鹊倦秋风。",
        "始觉牵卑剧，宵眠亦在公。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 344160,
      "title": "题萧丞小池",
      "content": [
        "莺鸣蕙草绿，朝与情人期。",
        "林沼忘言处，鸳鸿养翮时。",
        "春泉滋药暖，晴日度花迟。",
        "此会无辞醉，良辰难再追。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 344161,
      "title": "送集贤崔八叔承恩括图书",
      "content": [
        "雨露满儒服，天心知子虚。",
        "还劳五经笥，更访百家书。",
        "赠别倾文苑，光华比使车。",
        "晚云随客散，寒树出关疏。",
        "相见应朝夕，归期在玉除。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 344164,
      "title": "津梁寺寻李侍御",
      "content": [
        "禅林绝过客，柱史正焚香。",
        "驯鸽不猜隼，慈云能护霜。",
        "骢声隔暗竹，吏事散空廊。",
        "霄汉期鸳鹭，狐狸避宪章。",
        "绕阶春色至，屈草待君芳。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 344168,
      "title": "东皋早春寄郎四校书",
      "content": [
        "禄微赖学稼，岁起归衡茅。",
        "穷达恋明主，耕桑亦近郊。",
        "夜来霁山雪，阳气动林梢。",
        "兰蕙暖初吐，春鸠鸣欲巢。",
        "蓬莱时入梦，知子忆贫交。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 344172,
      "title": "夏日陪史郎中宴杜郎中果园",
      "content": [
        "何事重逢迎，春醪晚更清。",
        "林端花自老，池上月初明。",
        "路入仙郎次，乌连柱史名。",
        "竹阴疏柰院，山翠傍芜城。",
        "引满不辞醉，风来待曙更。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 344173,
      "title": "南溪春耕",
      "content": [
        "荷蓑趣南径，戴胜鸣条枚。",
        "溪雨有余润，土膏宁厌开。",
        "沟塍落花尽，耒耜度云回。",
        "谁道耦耕倦，仍兼胜赏催。",
        "日长农有暇，悔不带经来。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 344175,
      "title": "观法驾自凤翔回",
      "content": [
        "欃抢一扫灭，阊阖九重开。",
        "海晏鲸鲵尽，天旋日月来。",
        "圣情苏品物，龙御辟云雷。",
        "晓漏移仙仗，朝阳出帝台。",
        "周惭散马出，禹让浚川回。",
        "欲识封人愿，南山举酒杯。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 344176,
      "title": "题玉山村叟屋壁",
      "content": [
        "谷口好泉石，居人能陆沈。",
        "牛羊下山小，烟火隔云深。",
        "一径入溪色，数家连竹阴。",
        "藏虹辞晚雨，惊隼落残禽。",
        "涉趣皆流目，将归羡在林。",
        "却思黄绶事，辜负紫芝心。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 344180,
      "title": "送郑书记",
      "content": [
        "决胜无遗策，辞天便请缨。",
        "出身唯殉死，报国且能兵。",
        "受命麒麟殿，参谋骠骑营。",
        "短箫催别酒，斜日驻前旌。",
        "义勇千夫敌，风沙万里行。",
        "几年丹阙下，侯印锡书生。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 344181,
      "title": "送族侄赴任",
      "content": [
        "林下不成兴，仲容微禄牵。",
        "客程千里远，别念一帆悬。",
        "欲叹卑栖去，其如胜趣偏。",
        "云山深郡郭，花木净潮田。",
        "坐啸帷应下，离居月复圆。",
        "此时知小阮，相忆绿尊前。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 344182,
      "title": "长安落第作",
      "content": [
        "始愿今如此，前途复若何。",
        "无媒献词赋，生事日蹉跎。",
        "不遇张华识，空悲宁戚歌。",
        "故山归梦远，新岁客愁多。",
        "刷羽思乔木，登龙恨失波。",
        "散才非世用，回首谢云萝。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 344183,
      "title": "酬长孙绎蓝溪寄杏",
      "content": [
        "爱君蓝水上，种杏近成田。",
        "拂径清阴合，临流彩实悬。",
        "清香和宿雨，佳色出晴烟。",
        "懿此倾筐赠，想知怀橘年。",
        "芳馨来满袖，琼玖愿酬篇。",
        "把玩情何极，云林若眼前。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 344184,
      "title": "药堂秋暮",
      "content": [
        "隐来未得道，岁去愧云松。",
        "茅屋空山暮，荷衣白露浓。",
        "唯怜石苔色，不染世人踪。",
        "潭静宜孤鹤，山深绝远钟。",
        "有时丹灶上，数点彩霞重。",
        "勉事壶公术，仙期待赤龙。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 344185,
      "title": "哭常征君",
      "content": [
        "万化一朝尽，穷泉悲此君。",
        "如何丹灶术，能误紫芝焚。",
        "不遂苍生望，空留封禅文。",
        "远年随逝水，真气尽浮云。",
        "山闭龙蛇蛰，林寒麋鹿群。",
        "伤心载酒地，仙菊为谁熏。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 344187,
      "title": "奉送刘相公江淮催转运",
      "content": [
        "国用资戎事，臣劳为主忧。",
        "将征任土贡，更发济川舟。",
        "拥传星还去，过池凤不留。",
        "唯高饮水节，稍浅别家愁。",
        "落叶淮边雨，孤山海上秋。",
        "遥知谢公兴，微月上江楼。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 344188,
      "title": "送李秀才落第游荆楚",
      "content": [
        "翠羽虽成梦，迁莺尚后群。",
        "名逃郤诜策，兴发谢玄文。",
        "昏旦扁舟去，江山几路分。",
        "上潮吞海日，归雁出湖云。",
        "诗思应须苦，猿声莫厌闻。",
        "离居见新月，那得不思君。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 344191,
      "title": "奉和宣城张太守南亭秋夕怀友",
      "content": [
        "池馆蟪蛄声，梧桐秋露晴。",
        "月临朱戟静，河近画楼明。",
        "卷幔浮凉入，闻钟永夜清。",
        "片云悬曙斗，数雁过秋城。",
        "羽扇扬风暇，瑶琴怅别情。",
        "江山飞丽藻，谢脁让前名。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 344192,
      "title": "过山人所居因寄诸遗补",
      "content": [
        "空谷春云满，愚公晦迹深。",
        "一随玄豹隐，几换绿萝阴。",
        "绝径人稀到，芳荪我独寻。",
        "厨烟住峭壁，酒气出重林。",
        "蝴蝶晴还舞，黄鹂晚暂吟。",
        "所思青琐客，瑶草寄幽心。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 344193,
      "title": "过鸣皋隐者",
      "content": [
        "磻石老红鲜，征君卧几年。",
        "飞泉出林下，一径过崖巅。",
        "鸡犬逐人静，云霞宜地偏。",
        "终朝数峰胜，不远一壶前。",
        "仲月霁春雨，香风生药田。",
        "丹溪不可别，琼草色芊芊。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 344196,
      "title": "陪南省诸公宴殿中李监宅",
      "content": [
        "将门高胜霍，相子宠过韦。",
        "宦贵攀龙后，心倾待士时。",
        "壶觞开雅宴，鸳鹭眷相随。",
        "舞退燕姬曲，歌征谢脁诗。",
        "晚钟过竹静，醉客出花迟。",
        "莫惜留余兴，良辰不可追。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 344197,
      "title": "山斋读书寄时校书杜叟",
      "content": [
        "日爱蘅茅下，闲观山海图。",
        "幽人自守朴，穷谷也名愚。",
        "倒岭和溪雨，新泉到户枢。",
        "丛阑齐稚子，蟠木老潜夫。",
        "忆戴差过剡，游仙惯入壶。",
        "濠梁时一访，庄叟亦吾徒。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 344198,
      "title": "晚归蓝田旧居",
      "content": [
        "云卷东皋下，归来省故蹊。",
        "泉移怜石在，林长觉原低。",
        "旧里情难尽，前山赏未迷。",
        "引藤看古木，尝酒咒春鸡。",
        "兴与时髦背，年将野老齐。",
        "才微甘引退，应得遂霞栖。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 344199,
      "title": "寄袁州李嘉佑员外",
      "content": [
        "谁谓江山阻，心亲梦想偏。",
        "容辉常在目，离别任经年。",
        "郡国通流水，云霞共远天。",
        "行春莺几啭，迟客月频圆。",
        "雁有归乡羽，人无访戴船。",
        "愿征黄霸入，相见玉阶前。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 344201,
      "title": "春暮过石龟谷题温处士林园",
      "content": [
        "隐几无名老，何年此陆沈。",
        "丘园自得性，婚嫁不婴心。",
        "岁计因山薄，霞栖在谷深。",
        "设罝连草色，晒药背松阴。",
        "触兴云生岫，随耕鸟下林。",
        "支颐笑来客，头上有朝簪。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 344203,
      "title": "中书遇雨",
      "content": [
        "济旱惟宸虑，为霖即上台。",
        "云衔七曜起，雨拂九门来。",
        "纶阁飞丝度，龙渠激溜回。",
        "色翻池上藻，香裛鼎前杯。",
        "湘燕皆舒翼，沙鳞岂曝腮。",
        "尺波应万假，虞海载沿洄。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 344204,
      "title": "适楚次徐城",
      "content": [
        "去家随旅雁，几日到南荆。",
        "行迈改乡邑，苦辛淹晦明。",
        "畏途在淫雨，未暮息趋程。",
        "穷木对秋馆，寒鸦愁古城。",
        "迷津坐为客，对酒默含情。",
        "感激念知己，匣中孤剑鸣。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 344206,
      "title": "赠汉阳隐者",
      "content": [
        "当年不出世，知子餐霞人。",
        "乐道复安土，遗荣长隐身。",
        "衡茅古林曲，粳稻清江滨。",
        "桂棹为渔暇，荷衣御暑新。",
        "款颜行在役，幽兴惜今晨。",
        "分首天涯去，再来芳杜春。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 344211,
      "title": "送王使君移镇淮南",
      "content": [
        "共许徐方牧，能临河内人。",
        "郡移棠转茂，车至鹿还驯。",
        "吏事嘉师旅，鸳行惜搢绅。",
        "别心倾祖席，愁望尽征轮。",
        "紫诰征黄晚，苍生借寇频。",
        "愿言青琐拜，早及上林春。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 344212,
      "title": "李四劝为尉氏尉，李七勉为开封尉",
      "content": [
        "美政惟兄弟，时人数俊贤。",
        "皇枝双玉树，吏道二梅仙。",
        "自理尧唐俗，唯将礼让传。",
        "采兰花萼聚，就日雁行联。",
        "黄绶俄三载，青云未九迁。",
        "庙堂为宰制，几日试龙泉。"
      ],
      "author": {
        "id": 2428,
        "name": "钱起"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
