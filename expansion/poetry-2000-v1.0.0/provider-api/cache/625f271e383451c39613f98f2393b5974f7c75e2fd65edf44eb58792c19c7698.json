{
  "data": [
    {
      "id": 8943,
      "title": "清明",
      "content": [
        "园幽春去远，山暗绿初成。",
        "雨过林姿润，风回池面平。",
        "十年空潦倒，万里近清明。",
        "泪尽新阡树，如今青叶生。"
      ],
      "author": {
        "id": 12966,
        "name": "张嵲"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 9342,
      "title": "劝农六首  其二",
      "content": [
        "皇恩力本劝农耕，老稚争随刺史行。",
        "杨柳垂村曲尘色，殊乡时节近清明。"
      ],
      "author": {
        "id": 12966,
        "name": "张嵲"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 15316,
      "title": "海棠花",
      "content": [
        "幽姿淑态弄春晴，梅借风流柳借轻。",
        "初种直教围野水，半开长是近清明。",
        "几经夜雨香犹在，染尽烟脂画不成。",
        "诗老无心为题拂，至今惆怅似含情。"
      ],
      "author": {
        "id": 12138,
        "name": "刘子翚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 23183,
      "title": "次韵何宪太平道中书事",
      "content": [
        "明刑清诏使，行部近清明。",
        "况有太平象，想亡愁叹声。",
        "问民知疾苦，按郡戒将迎。",
        "更向金陵看，六朝余故城。"
      ],
      "author": {
        "id": 9239,
        "name": "王十朋"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 25315,
      "title": "句  其二",
      "content": [
        "地连巴楚峰岚见，节近清明柳色知。"
      ],
      "author": {
        "id": 2784,
        "name": "刘望之"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 32556,
      "title": "桃花",
      "content": [
        "衣裁缃缬态纤秾，犹在瑶池午醉中。",
        "嫌近清明时节令，趁渠新火一番红。"
      ],
      "author": {
        "id": 9300,
        "name": "曾季貍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 41186,
      "title": "春感",
      "content": [
        "老厌纷纷懒入城，长亭小市近清明。",
        "陇头下漏初芸草，陌上吹箫正卖饧。",
        "多病更知生是赘，九原那恨死无名。",
        "但余一事犹关念，万里唐安阙寄声。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 59498,
      "title": "次韵张守劝农  其一",
      "content": [
        "东郊春好近清明，小队相羊为省耕。",
        "扶路人归皆喜色，应时雷殷亦和声。",
        "不妨密雨催花放，有底屯云妬月盈。",
        "遥想一尊同客夜，烛花未剪已诗成。"
      ],
      "author": {
        "id": 39,
        "name": "陈造"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 65373,
      "title": "春日途中",
      "content": [
        "人家二月燕始归，春阴还近清明期。",
        "我行东指来江上，杰木夹径如旌旗。",
        "驱驰不惮百里远，解后时醉青帘垂。",
        "悬知故人隠山市，相见甫迩黄生眉。"
      ],
      "author": {
        "id": 869,
        "name": "廖行之"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 88434,
      "title": "春江",
      "content": [
        "半阴天气近清明，柳色花光画不成。",
        "行到远村山尽处，一江春水縠纹平。"
      ],
      "author": {
        "id": 11972,
        "name": "韩淲"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 91281,
      "title": "送谯回庵作江东宪",
      "content": [
        "千骑前驱拥旆旌，鸟啼花发近清明。",
        "斯文自是域中大，廷尉旧持天下平。",
        "春到十连皆化日，风清万窍只秋声。",
        "庐山面目无人识，应喜重来为主盟。"
      ],
      "author": {
        "id": 4995,
        "name": "释居简"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 105014,
      "title": "与国军道上",
      "content": [
        "时节近清明，云官未放晴。",
        "落花春绪懒，飞絮客情轻。",
        "新上谁家冢，深林宿处程。",
        "相看一巵酒，为尔暂忘情。"
      ],
      "author": {
        "id": 3112,
        "name": "郑会"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 118330,
      "title": "春日湖上  其二",
      "content": [
        "柳絮漫空雪样轻，梨花风起近清明。",
        "山南山北游人閙，屋后屋前春鸟鸣。"
      ],
      "author": {
        "id": 7304,
        "name": "吴惟信"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 120206,
      "title": "绯桃  其二",
      "content": [
        "衣裁缃缬态纤秾，犹在瑶池午醉中。",
        "嫌近清明时节冷，趁渠新火一番红。"
      ],
      "author": {
        "id": 7188,
        "name": "李龏"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 124449,
      "title": "年老逢春十三首  其三",
      "content": [
        "年老逢春雨乍晴，雨晴况复近清明。",
        "天低宫殿初长日，风暖园林未啭鶑。",
        "花似锦时高阁望，草如茵处小车行。",
        "东君见赐何多也，又复人间久太平。"
      ],
      "author": {
        "id": 6872,
        "name": "邵雍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 129072,
      "title": "清明",
      "content": [
        "节近清明长是阴，黄花间在麦苗深。",
        "倦行却上高楼望，烟锁前村一半林。"
      ],
      "author": {
        "id": 7939,
        "name": "赵孟坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 131171,
      "title": "绯桃",
      "content": [
        "衣裁缃缬态纤秾，犹在瑶池半醉中。",
        "嫌近清明时节冷，趁渠新火一番红。"
      ],
      "author": {
        "id": 1921,
        "name": "施清臣"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 131593,
      "title": "饯翁丹山发南浦",
      "content": [
        "鸣鸠语燕近清明，柳絮风轻秧水平。",
        "一带春流多断岸，尽缘倒树当桥行。"
      ],
      "author": {
        "id": 11237,
        "name": "张至龙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 133023,
      "title": "偶成",
      "content": [
        "东风玉勒马蹄轻，多少游人上凤城。",
        "燕子不来春寂寞，海棠花发近清明。"
      ],
      "author": {
        "id": 3955,
        "name": "释斯植"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 135977,
      "title": "开州园纵民游乐二首  其二",
      "content": [
        "节候近清明，游人已踏青。",
        "插花穿戟户，酤酒向旗亭。",
        "日迥林光润，风回海气腥。",
        "未知何处乐，归路已严扃。"
      ],
      "author": {
        "id": 12840,
        "name": "蔡襄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 144350,
      "title": "锦溪次赵令韵二首  其二",
      "content": [
        "困人天气近清明，花信风来拂面轻。",
        "屏却鸣驺成独往，绿杨阴里听鶑声。"
      ],
      "author": {
        "id": 4814,
        "name": "王执礼"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 148750,
      "title": "舟行青谿道中入歙十二首  其一一",
      "content": [
        "蕨拳欲动茗抽芽，节近清明路近家。",
        "五日缓行三百里，夹溪随处有桃花。"
      ],
      "author": {
        "id": 6125,
        "name": "方回"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 150794,
      "title": "清明",
      "content": [
        "踏歌槌鼓近清明，小雨霏霏欲弄晴。",
        "唤起十年心上事，春风楼下卖花声。"
      ],
      "author": {
        "id": 13350,
        "name": "何应龙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 151161,
      "title": "苦雨",
      "content": [
        "滴碎空阶颇厌听，恼人况又近清明。",
        "三分春忽二分过，十日天无一日晴。",
        "寒沁柳眉愁寂寂，湿凝花脸泪盈盈。",
        "苍穹好悯云霓望，留作甘霖助有成。"
      ],
      "author": {
        "id": 3247,
        "name": "杨公远"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 160533,
      "title": "偶题",
      "content": [
        "一春过半近清明，点滴簷声未肯晴。",
        "细柳雨中垂绿重，残花风里落红轻。",
        "世间白发在公道，眼底青山不世情。",
        "富贵倘来忙不得，人生何必苦营营。"
      ],
      "author": {
        "id": 542,
        "name": "黄庚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 186948,
      "title": "春日述怀",
      "content": [
        "祥风灵雨过二月，陈根新种苗争抽。",
        "早蚕生齐渐如蚁，温饱指此无歳忧。",
        "春酒未尽社已过，节物又近清明头。",
        "茜裙缬袖事来往，方盘小榼相饷酬。",
        "田家之乐世皆慕，贵仕难去贱易谋。",
        "行矣请谢茂陵病，一廛一耒归先畴。"
      ],
      "author": {
        "id": 4663,
        "name": "刘摰"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 192932,
      "title": "重题公纯池亭",
      "content": [
        "凭栏尽日看山色，欹枕连宵听水声。",
        "一点红尘无入处，戴家池馆近清明。"
      ],
      "author": {
        "id": 13404,
        "name": "郭祥正"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 198934,
      "title": "宫词  其二三",
      "content": [
        "汉殿东风弄晓晴，百花烘日近清明。",
        "披香博士今华髪，教得六宫歌舞成。"
      ],
      "author": {
        "id": 8495,
        "name": "王仲修"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 203864,
      "title": "随倅入京师答同列赠别",
      "content": [
        "挥鞭西指凤凰城，疏野之心无所营。",
        "预约牡丹花下酒，归时节物近清明。"
      ],
      "author": {
        "id": 1788,
        "name": "孔平仲"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 204265,
      "title": "和刘尉赤岸上巳  其二",
      "content": [
        "采兰时节近清明，朝野欢娱值太平。",
        "坦率从来如庾亮，穷愁素不学虞卿。",
        "三年阳渚成何事，一觉邯郸悟此生。",
        "把酒花前须醉倒，肯教风雨落繁英。"
      ],
      "author": {
        "id": 3788,
        "name": "张商英"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 217586,
      "title": "近清明二首  其一",
      "content": [
        "斜日去不驻，好风来有情。",
        "江城过风雨，花木近清明。",
        "水树闲照影，山禽时引声。",
        "吾年行老矣，淹泊蹇何成。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 217587,
      "title": "近清明二首  其二",
      "content": [
        "冉冉春向老，昏昏日复斜。",
        "鲜欢常止酒，不睡更烹茶。",
        "幡起烟中刹，鸡鸣林外家。",
        "陈王鬭鸡道，风柳不胜斜。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 226106,
      "title": "冯太冲置酒即事次公实韵",
      "content": [
        "故人同客寓，萧寺近清明。",
        "春事一樽酒，夜阑三尺檠。",
        "风流孔北海，文字汉西京。",
        "苦劝加餐饭，年来太瘦生。"
      ],
      "author": {
        "id": 824,
        "name": "洪炎"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 228092,
      "title": "送因觉先",
      "content": [
        "南涧茶香咲语新，西洲春涨小舟横。",
        "困顿人归烂熳晴，天迥游丝长百尺。",
        "日高飞絮满重城，一番花信近清明。"
      ],
      "author": {
        "id": 2106,
        "name": "释德洪"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 228113,
      "title": "清明前一日闻杜宇示清道芬",
      "content": [
        "篱外花如海，闲轩小寝惊。",
        "最先闻杜宇，更觉近清明。",
        "云怒必为雨，风和抝得晴。",
        "阿芬甘劣我，笑里恰诗成。"
      ],
      "author": {
        "id": 2106,
        "name": "释德洪"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 233306,
      "title": "春日怀秦髯",
      "content": [
        "山雨萧萧作快晴，郊园物物近清明。",
        "花如解语迎人笑，草不知名随意生。",
        "晚节渐于春事懒，病躯却怕酒壶倾。",
        "睡余若忆旧交友，应在日边听晓莺。"
      ],
      "author": {
        "id": 8177,
        "name": "李彭"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 238612,
      "title": "绯桃",
      "content": [
        "衣裁相缬态纤秾，犹在瑶池午醉中。",
        "嫌近清明时节冷，趁渠新火一番红。"
      ],
      "author": {
        "id": 10698,
        "name": "王庭珪"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 245612,
      "title": "春半",
      "content": [
        "拭目凭阑久，柔风拂面吹。",
        "莺花争妩媚，诗酒鬬清奇。",
        "已近清明节，初过上巳时。",
        "莫萦寻俗事，随意乐春熙。"
      ],
      "author": {
        "id": 6432,
        "name": "朱淑真"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 245801,
      "title": "春日有作",
      "content": [
        "景近清明节，垂杨翠缕长。",
        "塞鸿归朔漠，海燕度潇湘。",
        "花丽繁争锦，莺娇巧转簧。",
        "西园正明媚，收拾入吟乡。"
      ],
      "author": {
        "id": 6432,
        "name": "朱淑真"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 245803,
      "title": "春晴",
      "content": [
        "日暖风和明媚天，最宜吟咏入诗篇。",
        "庭花吐蕊红如锦，岸柳飞丝白似锦。",
        "深院雕梁巢燕返，高林乔木谷莺迁。",
        "韶光正近清明节，花坞楼台酒旆悬。"
      ],
      "author": {
        "id": 6432,
        "name": "朱淑真"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 246588,
      "title": "离新郑",
      "content": [
        "荒村更柳色，节物近清明。",
        "去国三年恨，还家一日程。",
        "故人投晓别，驘马傍山行。",
        "何事逢寒食，春来苦要饧。"
      ],
      "author": {
        "id": 12151,
        "name": "吕本中"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267734,
      "title": "喜王起侍郎放牒",
      "content": [
        "东风节气近清明，车马争来满禁城。",
        "二十八人初上牒，百千万里尽传名。",
        "谁家不借花园看，在处多将酒器行。",
        "共贺春司能鉴识，今年定合有公卿。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 280584,
      "title": "寒食前有怀",
      "content": [
        "万物鲜华雨乍晴，春寒寂历近清明。",
        "残芳荏苒双飞蝶，晓睡朦胧百啭莺。",
        "旧侣不归成独酌，故园虽在有谁耕。",
        "悠然更起严滩恨，一宿东风蕙草生。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 283344,
      "title": "杨柳枝寿杯词十八首 十七",
      "content": [
        "大堤时节近清明，霞衬烟笼遶郡城。",
        "好是梨花相映处，更胜松雪日初晴。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 285969,
      "title": "次韵酬张补阙因寒食见寄之什",
      "content": [
        "柳近清明翠缕长，多情右衮不相忘。",
        "开缄虽覩新篇丽，破鼻须闻冷酒香。",
        "时态嬾随人上下，花心甘被蝶分张。",
        "朝稀且莫轻春赏，胜事由来在帝乡。"
      ],
      "author": {
        "id": 41,
        "name": "郑谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 298217,
      "title": "柳 三",
      "content": [
        "金堤堤上一林烟，况近清明二月天。",
        "别有数枝遥望见，画桥南面拂秋千。"
      ],
      "author": {
        "id": 2071,
        "name": "孙鲂"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 299015,
      "title": "江城子 一",
      "content": [
        "碧阑干外小中庭，雨初晴，晓莺声。",
        "飞絮落花，时节近清明。",
        "睡起卷帘无一事，匀面了，没心情。"
      ],
      "author": {
        "id": 645,
        "name": "张泌"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 312336,
      "title": "抛球乐",
      "content": [
        "晓来天气浓淡，微雨轻洒。",
        "近清明，风絮巷陌，烟草池塘，尽堪图画。",
        "艳杏暖、妆脸匀开，弱柳困、宫腰低亚。",
        "是处丽质盈盈，巧笑嬉嬉，手簇秋千架。",
        "戏彩球罗绶，金鸡芥羽，少年驰骋，芳郊绿野。",
        "占断五陵游，奏脆管、繁弦声和雅。",
        "向名园深处，争泥画轮，竞羁宝马。",
        "取次罗列杯盘，就芳树、绿阴红影下。",
        "舞婆娑，歌宛转，仿佛莺娇燕姹。",
        "寸珠片玉，争似此、浓欢无价。",
        "任他美酒，十千一斗，饮竭仍解金貂贳。",
        "恣幕天席地，陶陶尽醉太平，且乐唐虞景化。",
        "须信艳阳天，看未足、已觉莺花谢。",
        "对绿蚁翠蛾，怎忍轻舍。"
      ],
      "author": {
        "id": 3061,
        "name": "柳永"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312512,
      "title": "南歌子",
      "content": [
        "醉后和衣倒，愁来𣨼酒醺。",
        "困人天气近清明。",
        "尽日厌厌□脸、浅含颦。",
        "睡觉□□恨，依然月映门。",
        "楚天何处觅行云。",
        "唯有暗灯残漏、伴消魂。"
      ],
      "author": {
        "id": 5040,
        "name": "张先"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312615,
      "title": "青门引・青门饮",
      "content": [
        "乍暖还轻冷。",
        "风雨晚来方定。",
        "庭轩寂寞近清明，残花中酒，又是去年病。",
        "楼头画角风吹醒。",
        "入夜重门静。",
        "那堪更被明月，隔墙送过秋千影。"
      ],
      "author": {
        "id": 5040,
        "name": "张先"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313147,
      "title": "朝中措",
      "content": [
        "养花天气近清明。",
        "丝雨酿寒轻。",
        "满眼春工如绣。",
        "消磨不尽离情。",
        "行行又宿，小桃旧坞，芳草邮亭。",
        "唤起两眉新恨。",
        "绿杨深处啼莺。"
      ],
      "author": {
        "id": 11741,
        "name": "杜安世"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313463,
      "title": "愁倚阑令・春光好",
      "content": [
        "花阴月，柳梢莺。",
        "近清明。",
        "长恨去年今夜雨，洒离亭。",
        "枕上怀远诗成。",
        "红笺纸、小砑吴绫。",
        "寄与征人教念远，莫无情。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313732,
      "title": "南歌子",
      "content": [
        "日薄花房绽，风和麦浪轻。",
        "夜来微雨洗郊坰。",
        "正是一年春好、近清明。",
        "已改煎茶火，犹调入粥饧。",
        "使君高会有馀清。",
        "此乐无声无味、最难名。"
      ],
      "author": {
        "id": 11678,
        "name": "苏轼"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313885,
      "title": "浣溪沙",
      "content": [
        "道字娇讹苦未成。",
        "未应春阁梦多情。",
        "朝来何事绿鬟倾。",
        "彩索身轻长趁燕，红窗睡重不闻莺。",
        "困人天气近清明。"
      ],
      "author": {
        "id": 11678,
        "name": "苏轼"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315221,
      "title": "阮郎归",
      "content": [
        "落花时节近清明。",
        "南园芳草青。",
        "东风料峭雨难晴。",
        "那堪中宿酲。",
        "回首处，自销凝。",
        "谁知人瘦生。",
        "倚阑无语不禁情。",
        "杜鹃啼数声。"
      ],
      "author": {
        "id": 2810,
        "name": "王炎2"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316292,
      "title": "蓦山溪",
      "content": [
        "莺莺燕燕。",
        "摇荡春光懒。",
        "时节近清明，雨初晴、娇云弄暖。",
        "醉红湿翠，春意酿成愁，花似染。",
        "草如剪。",
        "已是春强半。",
        "小鬟微盼。",
        "分付多情管。",
        "痴呆不知愁，想怕晚、贪春未惯。",
        "主人好事，应许玳筵开，歌眉敛。",
        "舞腰软。",
        "怎向轻分散。"
      ],
      "author": {
        "id": 11721,
        "name": "石孝友"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 319622,
      "title": "湘春夜月",
      "content": [
        "近清明。",
        "翠禽枝上消魂。",
        "可惜一片清歌，都付与黄昏。",
        "欲共柳花低诉，怕柳花轻薄，不解伤春。",
        "念楚乡旅宿，柔情别绪，谁与温存。",
        "空樽夜泣，青山不语，残月当门。",
        "翠玉楼前，惟是有、一波湘水，摇荡湘云。",
        "天长梦短，问甚时、重见桃根。",
        "这次第，算人间没个并刀，翦断心上愁痕。"
      ],
      "author": {
        "id": 1693,
        "name": "黄孝迈"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 320453,
      "title": "阮郎归",
      "content": [
        "一帘疏雨细于尘。",
        "春寒愁杀人。",
        "桐花庭院近清明。",
        "新烟浮旧城。",
        "寻蝶梦，怯莺声。",
        "柳丝如妾情。",
        "丙丁帖子画教成。",
        "妆台求晚晴。"
      ],
      "author": {
        "id": 3615,
        "name": "王同祖"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 320491,
      "title": "小重山",
      "content": [
        "画檐簪柳碧如城。",
        "一帘风雨里，近清明。",
        "吹箫门巷冷无声。",
        "梨花月，今夜负中庭。",
        "远岫敛修颦。",
        "春愁吟入谱，付莺莺。",
        "红尘没马翠埋轮。",
        "西泠曲，欢梦絮飘零。"
      ],
      "author": {
        "id": 3606,
        "name": "李莱老"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 321098,
      "title": "八声甘州",
      "content": [
        "两台帘对卷，燕芹香、风花近清明。",
        "望春弥柳际，流红水布，暖縠天晴。",
        "谁信闲襟似水，时忆语溪耕。",
        "襟抱番江阔，云远波平。",
        "静昼轻挥玉尘，见春扉草绿，暮冶烟青。",
        "问清华姓字，几度录虬屏。",
        "看西湖、一汀鸳鹭，正晓风、残月两三星。",
        "早归来，赴花鱼宴，宫树闻莺。"
      ],
      "author": {
        "id": 5020,
        "name": "陈允平"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 322163,
      "title": "蝶恋花",
      "content": [
        "年去年来来去早。",
        "怪底不来，庭院春光老。",
        "知过谁家翻别调。",
        "家家望断飞踪窅。",
        "千里潇湘烟渺渺。",
        "不记雕梁，旧日恩多少。",
        "匝近清明檐外叫。",
        "故巢犹在朱檐晓。"
      ],
      "author": {
        "id": 1758,
        "name": "汪宗臣"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 323021,
      "title": "鹧鸪天",
      "content": [
        "柳色青青罩翠烟。",
        "花光灼灼映临川。",
        "欲知窈窕呈祥日，恰近清明淑景天。",
        "浮瑞霭，庆真仙。",
        "不须男女祝椿年。",
        "异时早约西王母，剩折蟠桃荐寿筵。"
      ],
      "author": {
        "id": 6634,
        "name": "刘清之"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 323789,
      "title": "西江月",
      "content": [
        "梁上喃喃燕语，纸间戢戢蚕生。",
        "满城风雨近清明。",
        "不道有人新病。",
        "春事一溪流水，杨花千点浮萍。",
        "好风一霎为吹晴。",
        "独步小园清影。"
      ],
      "author": {
        "id": 5773,
        "name": "无名氏"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 328245,
      "title": "浣溪沙",
      "content": [
        "南涧茶香笑语新。",
        "西州春涨小舟横。",
        "困顿人归烂熳晴。",
        "天迥游丝长百尺，日高飞絮满重城。",
        "一番花信近清明。"
      ],
      "author": {
        "id": 4827,
        "name": "惠洪"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
