{
  "data": [
    {
      "id": 312237,
      "title": "苏幕遮",
      "content": [
        "碧云天，黄叶地。",
        "秋色连波，波上寒烟翠。",
        "山映斜阳天接水。",
        "芳草无情，更在斜阳外。",
        "黯乡魂，追旅思。",
        "夜夜除非，好梦留人睡。",
        "明月楼高休独倚。",
        "酒入愁肠，化作相思泪。"
      ],
      "author": {
        "id": 12150,
        "name": "范仲淹"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312597,
      "title": "苏幕遮",
      "content": [
        "柳飞绵，花实少。",
        "镂板音清，浅发江南调。",
        "斜日两竿留碧□。",
        "马足重重，又近青门道。",
        "去尘浓，人散了。",
        "回首旗亭，渐渐红裳小。",
        "莫讶安仁头白早。",
        "天若有情，天也终须老。"
      ],
      "author": {
        "id": 5040,
        "name": "张先"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312787,
      "title": "苏幕遮",
      "content": [
        "露堤平，烟墅杳。",
        "乱碧萋萋，雨后江天晓。",
        "独有庾郎年最少。",
        "窣地春袍，嫩色宜相照。",
        "接长亭，迷远道。",
        "堪怨王孙，不记归期早。",
        "落尽梨花春又了。",
        "满地残阳，翠色和烟老。"
      ],
      "author": {
        "id": 10648,
        "name": "梅尧臣"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313117,
      "title": "苏幕遮",
      "content": [
        "尽思量，还叵耐。",
        "因甚当初，故故相招买。",
        "早是幽欢多障碍。",
        "更遣分飞，脉脉如天外。",
        "有心怜，无计奈。",
        "两处厌厌，一点虚恩爱。",
        "独上高楼临暮霭。",
        "凭暖朱阑，这意无人会。"
      ],
      "author": {
        "id": 11741,
        "name": "杜安世"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313260,
      "title": "苏幕遮",
      "content": [
        "地锺灵，天应瑞。",
        "簇簇香苞、团作真珠蕊。",
        "玉宇瑶台分十二。",
        "要伴姮娥，月里双双睡。",
        "月如花，花似月。",
        "花月生香，添此真奇异。",
        "不许扬州夸间气。",
        "昨夜春风，唤醒琼琼醉。"
      ],
      "author": {
        "id": 4757,
        "name": "俞紫芝"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313785,
      "title": "苏幕遮",
      "content": [
        "暑笼晴，风解愠。",
        "雨后馀清，暗袭衣裾润。",
        "一局选仙逃暑困。",
        "笑指尊前、谁向青霄近。",
        "整金盆，轮玉笋。",
        "凤驾鸾车，谁敢争先进。",
        "重五休言升最紧。",
        "纵有碧油，到了输堂印。"
      ],
      "author": {
        "id": 11678,
        "name": "苏轼"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314664,
      "title": "苏幕遮",
      "content": [
        "不忧贫，不念富。",
        "大悟之人，开著波罗铺。",
        "内心真知无价宝，欲识真如，正照菩提路。",
        "贪爱心，须除去。",
        "清静法身，直是堪凭据。",
        "忍辱波罗为妙乐，服了一圆，万病都新愈。"
      ],
      "author": {
        "id": 12003,
        "name": "韩仙姑"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316381,
      "title": "苏幕遮",
      "content": [
        "地偏灵，天应瑞。",
        "簇簇银花，团绕真珠蕊。",
        "金阕玉楼分十二。",
        "要伴姮娥，与月循环睡。",
        "月如花，花表岁。",
        "人到闰年，添个真奇异。",
        "不许扬州夸间气。",
        "昨夜春风，吹送柴门里。"
      ],
      "author": {
        "id": 2560,
        "name": "马子严"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316653,
      "title": "苏幕遮",
      "content": [
        "气随神，神随气。",
        "神气相随，透入泥丸里。",
        "长把金关牢锁闭。",
        "捉得金晶，暗地添欢喜。",
        "下辛勤，须发志。",
        "十二时中，莫把工夫弃。",
        "阴尽阳全神出体。",
        "功行成时，名列神仙位。"
      ],
      "author": {
        "id": 11467,
        "name": "宋先生"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 320636,
      "title": "苏幕遮",
      "content": [
        "日烘晴，风却暑。",
        "帘幕中间，紫燕呢喃语。",
        "嫩竹新荷初沐雨。",
        "曲栏幽轩，四面明窗举。",
        "夏初临，春又去。",
        "不愿封侯，祗怕为羁旅。",
        "溪上故人无恙否。",
        "欲唱菱歌，发棹归南浦。"
      ],
      "author": {
        "id": 7010,
        "name": "杨泽民"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 322126,
      "title": "苏幕遮",
      "content": [
        "绿秧平，烟树远，村落声喧，凫雁归来晚。",
        "自倚阑干舒困眼。",
        "一架葡萄，青得池塘满。",
        "饮先愁，吟又懒。",
        "几许闲情，百计难消遣。",
        "客落不如归梦短。",
        "何况啼鹃，怎不教肠断。"
      ],
      "author": {
        "id": 8092,
        "name": "赵文"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 322368,
      "title": "苏幕遮",
      "content": [
        "晚晴初，斜照里。",
        "远水连天，天外帆千里。",
        "百尺高楼谁独倚。",
        "滴落梧桐，一片相思泪。",
        "马又嘶，风又起。",
        "断续寒砧，又送黄昏至。",
        "明月照人人不睡。",
        "愁雁声声，更切愁人耳。"
      ],
      "author": {
        "id": 12374,
        "name": "柴元彪"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 322403,
      "title": "苏幕遮",
      "content": [
        "远迎风，回避暑。",
        "人似荷花，笑隔荷花语。",
        "无限情云并意雨。",
        "惊散鸳鸯，兰棹波心举。",
        "约重游，轻别去。",
        "断桥风月，梦断飘蓬旅。",
        "旧日秋娘犹在否。",
        "雁足不来，声断衡阳浦。"
      ],
      "author": {
        "id": 12170,
        "name": "赵必□"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 323217,
      "title": "苏幕遮",
      "content": [
        "与君别，情易许。",
        "执手相将，永远成鸳侣。",
        "一去音书千万里。",
        "望断阳关，泪滴如秋雨。",
        "到如今，成间阻。",
        "等候郎来，细把相思诉。",
        "看著梅花花不语。",
        "花已成梅，结就心中苦。"
      ],
      "author": {
        "id": 6675,
        "name": "陶氏"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 324536,
      "title": "苏幕遮",
      "content": [
        "水风轻，吹不皱。",
        "上下浮光，两镜光相就。",
        "云锦摇香吹散酒。",
        "细听清谈，玉屑津津嗽。",
        "明月前，斜阳后。",
        "竹露秋声，拂拂寒生袖。",
        "掇取湖山聊入手。",
        "紫阁黄扉，到了终须有。"
      ],
      "author": {
        "id": 6162,
        "name": "王质"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 324537,
      "title": "苏幕遮",
      "content": [
        "驿尘飞，天意紧。",
        "香雪芝封，犹带吴泥润。",
        "昨夜宝奁开玉镜。",
        "一点西风，便觉寒秋近。",
        "白苹洲，红蓼径。",
        "风露凄清，快促黄金镫。",
        "叠叠重重听好信。",
        "掷了碧油幢，更掷双堂印。"
      ],
      "author": {
        "id": 6162,
        "name": "王质"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 324714,
      "title": "苏幕遮",
      "content": [
        "扇留风，冰却暑。",
        "夏木阴阴，相对黄鹂语。",
        "薄晚轻阴还阁雨。",
        "远岸烟深，仿佛菱歌举。",
        "燕归来，花落去。",
        "几度逢迎，几度伤羁旅。",
        "油壁西陵人识否。",
        "好约追凉，小舣蒹葭浦。"
      ],
      "author": {
        "id": 11841,
        "name": "方千里"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 325266,
      "title": "苏幕遮",
      "content": [
        "陇云沈，新月小。",
        "杨柳梢头，能有春多少。",
        "试著罗裳寒尚峭。",
        "帘卷青楼，占得东风早。",
        "翠屏深，香篆袅。",
        "流水落花，不管刘郎到。",
        "三叠阳关声渐杳。",
        "断雨残云，只怕巫山晓。"
      ],
      "author": {
        "id": 5773,
        "name": "无名氏"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 325350,
      "title": "鹧鸪天",
      "content": [
        "烛影摇红玉漏迟。",
        "鹊桥仙子下瑶池。",
        "倾杯乐处笙歌沸，苏幕遮阑笑语随。",
        "醉落魄，阮郎归。",
        "传言玉女步轻移。",
        "凤凰台上深深愿，一日和鸣十二时。"
      ],
      "author": {
        "id": 5773,
        "name": "无名氏"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 325783,
      "title": "苏幕遮",
      "content": [
        "遇荒年，每常见。",
        "就中今年，洪水皆淹遍。",
        "父母分离无可恋。",
        "幸望豪民，救取庄家汉。",
        "最堪伤，何忍见。",
        "古寺禅林，翻作悲田院。",
        "日夜烧香频□□，祷告皇天，救护开方便。"
      ],
      "author": {
        "id": 4513,
        "name": "净端"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 325810,
      "title": "苏幕遮",
      "content": [
        "水中金，冲牛斗。",
        "玉锁金关，护法灵童守。",
        "赤水丹台龙虎走。",
        "万象森罗，勃勃投珠口。",
        "饮灵源，明火候。",
        "太乙炉开，丹熟神光透。",
        "浮名浮利终不久。",
        "下手速修。",
        "穷取无中有。"
      ],
      "author": {
        "id": 5773,
        "name": "无名氏"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 326223,
      "title": "苏幕遮",
      "content": [
        "柳垂金，梅褪玉。",
        "昴宿呈祥，符应生公族。",
        "盖世功名夸九牧。",
        "黼衮褒扬，庆阀辉南北。",
        "赐宫醪，分笃耨。",
        "天与长生，谩把仙椿祝。",
        "好继平阳腾茂躅。",
        "富贵千秋，饮听瑶池曲。"
      ],
      "author": {
        "id": 5276,
        "name": "史佐尧"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 326886,
      "title": "苏幕遮",
      "content": [
        "碧桃花，春婉娩。",
        "未断尘缘，暂别瑶池宴。",
        "谪限迢迢应未满。",
        "乘月骖鸾，曾有深深愿。",
        "帝城赊，凤楼远。",
        "长寿杯深，此际谁人劝。",
        "闷倚屏山凝泪眼。",
        "百和烟中，细想千娇面。"
      ],
      "author": {
        "id": 7703,
        "name": "晁端礼"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 327645,
      "title": "苏幕遮",
      "content": [
        "燎沈香，消溽暑。",
        "鸟雀呼晴，侵晓窥檐语。",
        "叶上初阳干宿雨，水面清圆，一一风荷举。",
        "故乡遥，何日去。",
        "家住吴门，久作长安旅。",
        "五月渔郎相忆否。",
        "小楫轻舟，梦入芙蓉浦。"
      ],
      "author": {
        "id": 3026,
        "name": "周邦彦"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 328443,
      "title": "苏幕遮",
      "content": [
        "先天生，后天久。",
        "道有真诠，谛听当时受。",
        "恰是迷天迷望斗。",
        "只恐微躯，薄幸随枯朽。"
      ],
      "author": {
        "id": 13290,
        "name": "张继先"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 328444,
      "title": "苏幕遮",
      "content": [
        "抱孤琴，弹小操。",
        "独坐幽轩，尽日无人到。",
        "惟乐烟霞长啸傲。",
        "明月清风，今古长为道。",
        "识乾坤，知牝牡。",
        "懒共尘劳，汨汨争奔走。",
        "爱杀高眠消白昼。",
        "一任他家，玉兔金乌走。"
      ],
      "author": {
        "id": 13290,
        "name": "张继先"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 328943,
      "title": "苏幕遮",
      "content": [
        "瘦仙人，穷活计。",
        "不养丹砂，不肯参同契。",
        "两顿家餐三觉睡。",
        "闭著门儿，不管人闲事。",
        "又经年，知几岁。",
        "老屋穿空，幸有天遮蔽。",
        "不饮香醪常似醉。",
        "白鹤飞来，笑我颠颠地。"
      ],
      "author": {
        "id": 12624,
        "name": "朱敦儒"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 328944,
      "title": "苏幕遮",
      "content": [
        "酒壶空，歌扇去。",
        "独倚危楼，无限伤心处。",
        "芳草连天云薄暮。",
        "故国山河，一阵黄梅雨。",
        "有奇才，无用处。",
        "壮节飘零，受尽人间苦。",
        "欲指虚无问征路。",
        "回首风云，未忍辞明主。"
      ],
