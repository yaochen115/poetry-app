{
  "data": [
    {
      "id": 45092,
      "title": "闲居初夏午睡起二绝句  其二",
      "content": [
        "松阴一架半弓苔，偶欲看书又嬾开。",
        "戏掬清泉洒蕉叶，儿童误认雨声来。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45093,
      "title": "携酒夜饯罗季周",
      "content": [
        "夜深未要掩柴门，且放清风入绿尊。",
        "淡月轻云相映著，浅黄帊子裹金盆。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45094,
      "title": "雨后独登舍北山顶",
      "content": [
        "山下生愁热不除，山头小立气全苏。",
        "自缘著脚高低别，万壑清风岂是无。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45095,
      "title": "题罗巨济教授蓬山堂",
      "content": [
        "蓬莱藏室盛东都，只著古书并老儒。",
        "后来许事晓星疎，登车不落问何如。",
        "广文先生自有饭，诸公衮衮端无羡。",
        "著脚金坡不作难，问津木天何足办。",
        "作堂聊尔题蓬山，此岂有意亦偶然。",
        "登瀛仙人多姓许，未必先生肯为伍。",
        "书生饶舌定可憎，此话姑置莫葛藤。",
        "先生诸孙皆玉冰，诵书已作鸾鹤声，请来欹枕细细听。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 45096,
      "title": "和昌英叔夏至喜雨",
      "content": [
        "清酣暑雨不缘求，犹似梅黄麦欲秋。",
        "去岁如今禾半死，吾曹遍祷汗交流。",
        "此生未用愠三已，一饱便应哦四休。",
        "花外绿畦深没鹤，来看莫惜下邳侯。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 45097,
      "title": "和昌英叔觅松枝作日棚  其一",
      "content": [
        "先人手种一川松，为栋为杗似未中。",
        "只合茅斋听驱使，为公六月唤秋风。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45098,
      "title": "和昌英叔觅松枝作日棚  其二",
      "content": [
        "欲和新诗且撚髯，岸巾百匝绕前簷。",
        "茅斋或恐清阴薄，更遣苍官去一添。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45099,
      "title": "秋夜不寐",
      "content": [
        "秋气侵人冷欲冰，不由老境不愁生。",
        "雨声已遣侬无睡，更著寒蛩泣到明。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45100,
      "title": "元举叔莲花",
      "content": [
        "不著芙蓉近路栽，菰蒲深处却花开。",
        "晚香特地清人骨，多谢西风得得来。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45101,
      "title": "昌英叔门外小树木犀早开",
      "content": [
        "触鼻无从觅，看林小缀黄。",
        "旋开三两粟，已作十分香。",
        "入夜偏相恼，搀先有底忙。",
        "移床月枝下，坐对略传觞。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 45102,
      "title": "寄题张商弼葵堂堂下元不种葵花但取面势向阳二首  其一",
      "content": [
        "行尽葵堂西复东，葵花元自不曾逢。",
        "客来问讯名堂意，雪里芭蕉笑杀侬。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45103,
      "title": "寄题张商弼葵堂堂下元不种葵花但取面势向阳二首  其二",
      "content": [
        "主人未肯便山林，赏月吟风酒更琴。",
        "每一登堂一揩眼，谁知半点向阳心。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45104,
      "title": "南溪暮立",
      "content": [
        "溪影明霞新月底，水声乱石嫩沙间。",
        "欲归小为鱼儿住，更看跳波玉一环。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45105,
      "title": "晚望",
      "content": [
        "病身似怯暮来风，老眼还惊霁后虹。",
        "落日偏明松表里，好山分占水西东。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45106,
      "title": "秋夜",
      "content": [
        "挑落寒灯一点青，方知斜月半窗明。",
        "无端一阵秋声起，唤作铜瓶蟹眼鸣。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45107,
      "title": "夜闻萧伯和与子上弟读书",
      "content": [
        "少日耽书病得臞，何曾灯火稍相疎。",
        "如今老懒那能许，卧听邻斋夜读书。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45108,
      "title": "中秋雨过月出",
      "content": [
        "欲遣清风扫乱云，先将一雨浄游尘。",
        "今年大作中秋事，月色何孤我辈人。",
        "照却八方还剩在，看来千古许清新。",
        "不眠不惜明朝补，报答孤光醉是真。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 45109,
      "title": "和李天麟二首  其一",
      "content": [
        "学诗须透脱，信手自孤高。",
        "衣钵无千古，丘山只一毛。",
        "句中池有草，子外目俱蒿。",
        "可口端何似，霜螯略带糟。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 45110,
      "title": "和李天麟二首  其二",
      "content": [
        "句法天难秘，工夫子但加。",
        "参时且柏树，悟罢岂桃花。",
        "要共东西王，其如南北涯。",
        "肯来谈个事，分坐白鸥沙。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 45111,
      "title": "寄题刘元明环翠阁二首  其一",
      "content": [
        "阁在青围翠绕中，何时我辈略搘筇。",
        "亦闻佳处无多子，只有千峰与万峰。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45112,
      "title": "寄题刘元明环翠阁二首  其二",
      "content": [
        "一夜秋声恼井桐，梦回得句寄西风。",
        "诗成却问题诗处，正在东山东复东。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45113,
      "title": "濠原路中",
      "content": [
        "长亭短亭三复五，总是儿时行底路。",
        "尚忆天寒日小黄，先君前行我后顾。",
        "如今悲不为涂穷，病雁孤飞失老鸿。",
        "三年闭户松风里，行路又还从此始。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 45114,
      "title": "小雨",
      "content": [
        "雨来细细复疎疎，纵不能多不肯无。",
        "似妬诗人山入眼，千峰故隔一帘珠。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45115,
      "title": "连岭遇雨",
      "content": [
        "肩舆正好看山色，雨里两窗开不得。",
        "此外只有书可观，斜点又来湿书册。",
        "一月秋晴一月泥，南翁此谚似可疑。",
        "山寒却要日暴背，吾衰不用雨催诗。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 45116,
      "title": "题赤孤同亭馆",
      "content": [
        "数菊能令客眼明，三峰端为此堂横。",
        "仆夫不敢催侬去，只道长沙尚八程。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45117,
      "title": "分宜逆旅逢同郡客子",
      "content": [
        "在家儿女亦心轻，行路逢人总弟兄。",
        "未问后来相忆否，其如临别不胜情。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45118,
      "title": "袁州路遇晴",
      "content": [
        "晴意久不果，天容今一新。",
        "如何半轮日，销却许多云。",
        "积雨还休雨，小春真似春。",
        "客心君莫问，山鸟亦欣欣。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 45119,
      "title": "将至萍乡欲宿为重客据馆乃出西郊",
      "content": [
        "哦诗浑忘路高低，忽怪松梢与路齐。",
        "准拟醉眠萍实驿，驿西西去更山西。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45120,
      "title": "将至醴陵",
      "content": [
        "行尽崎岖峡，初逢熨帖坡。",
        "寒从平野有，雨傍远山多。",
        "也自长沙近，其如此路何。",
        "披文浑不恶，冻手奈频呵。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 45121,
      "title": "见张钦夫二首  其一",
      "content": [
        "克己今颜子，承家小吕申。",
        "只愁无好手，不道欠斯人。",
        "一别时飞几，重来事总新。",
        "祥琴声尚苦，可更话酸辛。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 45122,
      "title": "见张钦夫二首  其二",
      "content": [
        "不见所知久，有怀何许开。",
        "百书终作恶，千里为渠来。",
        "邹鲁期程远，风霜鬓发催。",
        "不应师友地，只么遣空回。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 45123,
      "title": "见张定叟",
      "content": [
        "蜀士冠朝士，最谈苏与张。",
        "少公今是似，相国未应亡。",
        "黄阁如寒素，青春已老苍。",
        "新功知更进，余事出文章。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 45124,
      "title": "宿龙回",
      "content": [
        "大熟虚成喜，微生亦可嗟。",
        "禾头已生耳，雨脚尚如麻。",
        "顷者官收米，精于玉绝瑕。",
        "四山云又合，奈尔老农家。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 45125,
      "title": "见潭帅刘恭父舍人二首  其一",
      "content": [
        "云雾开衡岳，波涛息洞庭。",
        "是邦谁岳牧，西掖一文星。",
        "有眼难人物，斯人尚典刑。",
        "如何闲处著，不遣肃朝廷。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 45126,
      "title": "见潭帅刘恭父舍人二首  其二",
      "content": [
        "道合宁嫌晚，心期不用多。",
        "于公犹未见，此恨独如何。",
        "颇辱谈间问，端须雪里过。",
        "门阑当欠士，许寄病身么。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 45127,
      "title": "蜀士甘彦和寓张魏公门馆用予见张钦夫诗韵作二诗见赠和以谢之  其一",
      "content": [
        "说著岷江士，未逢眉已申。",
        "殷勤来相府，解逅得诗人。",
        "不是胸中别，何缘句子新。",
        "谈今还悼昔，喜罢反悲辛。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 45128,
      "title": "蜀士甘彦和寓张魏公门馆用予见张钦夫诗韵作二诗见赠和以谢之  其二",
      "content": [
        "夜把新诗读，灯前阖且开。",
        "一行私独喜，两脚不虚来。",
        "天似嫌梅晚，冬初遣雪催。",
        "与君问花信，能绕百千回。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 45129,
      "title": "和侯彦周知县招饮",
      "content": [
        "乘兴山阴更灞桥，人间此事久寥寥。",
        "客心也欲将归去，小为故人留一宵。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45130,
      "title": "和吴伯承提宫孟冬风雨",
      "content": [
        "旧雨新更寒，昼歇夜复陨。",
        "我行十日泥，屦迹故未泯。",
        "吟声正酸苦，已似琴促轸。",
        "更遭雪作祟，不由弦不紧。",
        "与公无诗债，何得便见窘。",
        "半生领盛名，一面辱倾囷。",
        "眼底过浮云，谁见柳下悯。",
        "觅句许奇险，有底恼肝肾。",
        "开怀爱我多，落笔为渠尽。",
        "独怜禾头湿，可欢不可哂。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 45131,
      "title": "题清江胡民瞻忍堂",
      "content": [
        "俗物茫茫奈我何，儿女昵昵不用呵。",
        "先生笑问有酒么，醉来得句自长哦。",
        "家风孝友春风软，床无黄金且青简。",
        "君不见多愁多恼张公艺，枉却御前百余字。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 45132,
      "title": "除夕宿临川战平",
      "content": [
        "一腊天频雪，千山梅未花。",
        "终年不为客，除夕恰辞家。",
        "雨又垂垂落，风仍故故斜。",
        "难开愁里眼，只益鬓边华。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 45133,
      "title": "纪闻",
      "content": [
        "人道真虚席，心知必数公。",
        "宾王欺钓筑，君实误儿童。",
        "天在升平外，春归小雪中。",
        "何曾忘诸老，渠自爱松风。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 45134,
      "title": "又除夕绝句",
      "content": [
        "紫陌相逢谁不客，青灯作伴未为孤。",
        "何须家里作时节，只问旗亭有酒无。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45135,
      "title": "丁亥正月新晴晚步二首  其一",
      "content": [
        "嫩水春来别样光，草芽绿甚却成黄。",
        "东风似与行人便，吹尽寒云放夕阳。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45136,
      "title": "丁亥正月新晴晚步二首  其二",
      "content": [
        "急下柴车踏晚晴，青鞋步步有沙声。",
        "忽逢野沼无人处，两鸭浮沉最眼明。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45137,
      "title": "过安仁岸",
      "content": [
        "野水工穿石，疎林不掩巢。",
        "雨蒲拳病叶，风筿秃危梢。",
        "短胫知难续，长腰强自抄。",
        "兹游良不恶，物色困诙嘲。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 45138,
      "title": "早行鸣山二首  其一",
      "content": [
        "淡淡清霜薄薄冰，晓寒端为作新晴。",
        "殷勤唤醒梅花睡，枝上春禽一两声。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45139,
      "title": "早行鸣山二首  其二",
      "content": [
        "灵山未见见龟山，且卷诗书子细看。",
        "春日幸从年后暖，春风须带腊前寒。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45140,
      "title": "明发弋阳县",
      "content": [
        "灯市通宵沸，朝来解一空。",
        "梅边霜似雪，雾外日如虹。",
        "句妙元非作，人穷未必工。",
        "忽惊家已远，身在大江东。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 45141,
      "title": "雾中见灵山依约不真",
      "content": [
        "东来两眼不曾寒，四顾千峰掠晓鬟。",
        "天欲恼人消几许，只教和雾看灵山。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45142,
      "title": "题小沙溪郑氏店江亭",
      "content": [
        "隔水千山又万山，大江仍合小溪湾。",
        "岸巾独立东风里，眼趁凫雏下急滩。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45143,
      "title": "又题郑店立春后一日",
      "content": [
        "石壁仍丛竹，江亭更小楼。",
        "滩声清客梦，灯影动诗愁。",
        "春日已虚过，元宵看又休。",
        "谁令不行乐，蹙破两眉头。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 45144,
      "title": "上元日晚过顺溪",
      "content": [
        "恰恰元宵雨脚垂，天风为我扫除之。",
        "怪来平地寒如许，雪满远峰人未知。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45145,
      "title": "白沙买船晚至严州",
      "content": [
        "重雾疑朝雨，斜阳竟晚晴。",
        "万山江外尽，一塔岭尖明。",
        "舟小宁嫌窄，途长已倦行。",
        "子陵台下水，未酌意先清。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 45146,
      "title": "题钓台二绝句  其一",
      "content": [
        "断崖初未有人踪，只合先生著此中。",
        "汉室也无一抔土，钓台今是几春风。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45147,
      "title": "题钓台二绝句  其二",
      "content": [
        "同学书生已冕旒，未将换与一羊裘。",
        "子云到老不晓事，不信人间有许由。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45148,
      "title": "和周子中韵",
      "content": [
        "清愁政尔喜逢兄，一笑那知客帝城。",
        "海气不曾晴色好，梨花半落嫩寒生。",
        "刑书夜诵端何苦，诗句春来想不平。",
        "我亦有怀无处说，对床只欲为渠倾。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 45149,
      "title": "都下无忧馆小楼春尽旅怀二首  其一",
      "content": [
        "病眼逢书不敢开，春泥谢客亦无来。",
        "更无短计销长日，且遶栏干一百回。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45150,
      "title": "都下无忧馆小楼春尽旅怀二首  其二",
      "content": [
        "不关老去愿春迟，只恨春归我未归。",
        "最是杨花欺客子，向人一一作西飞。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45151,
      "title": "新热送同邸归客有感二首  其一",
      "content": [
        "日日思亲未拜亲，何时乞我自由身。",
        "同来客子送归尽，更送后来无数人。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45152,
      "title": "新热送同邸归客有感二首  其二",
      "content": [
        "瘦不缘诗不为春，只教悬罄未教行。",
        "清和天里不归去，六月长途作么生。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45153,
      "title": "跋蜀人魏致尧抚干万言书",
      "content": [
        "雨里短檠头似雪，客间长铗食无鱼。",
        "上书恸哭君何苦，政是时人重子虚。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45154,
      "title": "桐庐道中",
      "content": [
        "肩舆坐睡茶力短，野堠无文山路长。",
        "鸦鹊声欢人不会，枇杷一树十分黄。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45155,
      "title": "金溪道中",
      "content": [
        "野花垂路止人行，田水偏寻缺处鸣。",
        "近浦人家随曲折，插秧天气半阴晴。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45156,
      "title": "将至建昌",
      "content": [
        "梅雨芹泥路不佳，闷来小歇野人家。",
        "绿萍池沼垂杨里，初见芙蕖第一花。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45157,
      "title": "见王宣子侍郎二首  其一",
      "content": [
        "不作伾文客，投闲可得辞。",
        "高名真自累，了事竟成痴。",
        "到底须良匠，非渠更阿谁。",
        "莫嫌风雪恶，要试岁寒枝。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 45158,
      "title": "见王宣子侍郎二首  其二",
      "content": [
        "老去浑多难，愁来敢怨天。",
        "生遭文字误，更结簿书缘。",
        "苦忆悬间榻，难回雪后船。",
        "三年才一见，百岁几三年。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 45159,
      "title": "都下和同舍客李元老承信赠诗之韵",
      "content": [
        "论交何必星霜久，白头得似倾盖友。",
        "长安市上李将军，挽弓旧不论石斗。",
        "只今有子似渠长，清夜读书雪边牖。",
        "云端烽烟半点无，怪来将军不好武。",
        "遗我骊珠三百颗，字字镌镵未曾苟。",
        "得得且看钱塘潮，莫莫言攀渭城柳。",
        "朝家金印斗样大，情知不上书生肘。",
        "儒冠多误侬饱谙，毛锥焉用君知否。",
        "便应早请终军缨，径须系取单于首。",
        "居延蒲类水如天，吹作春风一杯酒。",
        "归来冠剑上凌烟，剩作功名落人口。",
        "如何收敛许光芒，也趁槐花黄里走。",
        "献璞虽真不救胫，绝弦何如只停手。",
        "人生匹似风中花，荣瘁升沈岂非偶。",
        "与君早赋归去来，名垂万古知何有。",
        "不如耳热歌呜呜，醉帽欹倾衣不纽。",
        "诗流唱和秋虫鸣，僧房问答狮子吼。",
        "尽令俗客不妨来，白眼相看勿分剖。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 45160,
      "title": "新淦抛江",
      "content": [
        "烟雨横江水著天，不曾夏涝似今年。",
        "缘堤何用千株柳，只与行人碍过船。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45161,
      "title": "还家秋夕饮中喜雨",
      "content": [
        "好风有意入金台，白酒无声落玉杯。",
        "秋雨亦嫌秋热在，打荷飘竹为人来。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45162,
      "title": "和李天麟秋怀五绝句  其一",
      "content": [
        "漫浪归来岁又秋，依然风月替人愁。",
        "奉酬只么随缘句，嬾更雕肝与探钩。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 45163,
      "title": "和李天麟秋怀五绝句  其二",
      "content": [
        "双井无人后山死，只今谁子定传灯。",
        "老夫言语浑无味，不但秋来面可憎。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 45164,
      "title": "和李天麟秋怀五绝句  其三",
      "content": [
        "小立南溪暮未还，略容老子照衰颜。",
        "颇惊暝色来天外，未必秋声在树间。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 45165,
      "title": "和李天麟秋怀五绝句  其四",
      "content": [
        "缀玉联珠辱见投，要知词客解悲秋。",
        "侬家幸自无烦恼，却被新诗嫁许愁。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 45166,
      "title": "和李天麟秋怀五绝句  其五",
      "content": [
        "夜把新诗百遍开，句如红药与苍苔。",
        "如何作许无端甚，押尽车斜始送来。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 45167,
      "title": "送相士高元善二首  其一",
      "content": [
        "选官选佛两悠悠，元不关人浪自愁。",
        "洙泗生涯久春草，老夫作么晚回头。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45168,
      "title": "送相士高元善二首  其二",
      "content": [
        "穉子烦君一一看，丁宁莫道好求官。",
        "老来正要团栾坐，伴我秋风把钓竿。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45169,
      "title": "出城途中小憩",
      "content": [
        "未到江城已日斜，山烟白处是人家。",
        "秋风毕竟无多巧，只把燕支滴蓼花。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45170,
      "title": "题周子中司户乘成台三首  其一",
      "content": [
        "不烦营筑便成台，自有青松不用栽。",
        "只道先生忙更嬾，也须一日一回来。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45171,
      "title": "题周子中司户乘成台三首  其二",
      "content": [
        "只须独立领秋光，何用安排石鼓双。",
        "平揖青原未为差，更于竹外见长江。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45172,
      "title": "题周子中司户乘成台三首  其三",
      "content": [
        "先生无劓何须补，上到乘成尽放怀。",
        "松树尚堪驱使在，为公一一捧诗牌。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45173,
      "title": "三辰砚屏歌",
      "content": [
        "天小紫，日淡红，月光正与日相通。",
        "一星雪白大于黍，走近月旁无半武。",
        "吾闻三辰不并明，如何日中见月星。",
        "霜后梨花定非瑞，春秋获麟不应贵。",
        "君不见八月十五夜向晨，东方亭亭升火轮，西有玉李伴金盆。",
        "是时三辰正如许，君不著眼君莫论。",
        "吾家大阮嗜文字，看书到晓那能睡。",
        "三辰并光射窗几，影落砚屏不容洗。",
        "就中月轮景特奇，桂树可数叶与枝。",
        "炯如秋水涵荇藻，天巧此岂人能为。",
        "怀璧未为罪，借书未为痴。",
        "公当十袭古锦帊，如何传翫十手把，不防夜半有力者。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 45174,
      "title": "题文发叔所藏潘子真水墨江湖八境小轴 洞庭波涨",
      "content": [
        "湖水吞天去，湖风送浪还。",
        "银山何处是，青底是君山。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 45175,
      "title": "题文发叔所藏潘子真水墨江湖八境小轴 武昌春色",
      "content": [
        "花外庾楼月，鶑边吴宫柳。",
        "我欲问废兴，春风独无口。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 45176,
      "title": "题文发叔所藏潘子真水墨江湖八境小轴 庐山霁色",
      "content": [
        "彭泽收积雨，庐山放嫩晴。",
        "多情是瀑布，只作雨中声。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 45177,
      "title": "题文发叔所藏潘子真水墨江湖八境小轴 海门残照",
      "content": [
        "万里长江白，半规斜日黄。",
        "焦山浑欲到，宛在水中央。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 45178,
      "title": "题文发叔所藏潘子真水墨江湖八境小轴 太湖秋晚",
      "content": [
        "水气清空外，人家秋色中。",
        "细看千万落，户户水精宫。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 45179,
      "title": "题文发叔所藏潘子真水墨江湖八境小轴 浙江观潮",
      "content": [
        "海涌银为郭，江横玉系腰。",
        "吴侬只言黠，到老也看潮。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 45180,
      "title": "题文发叔所藏潘子真水墨江湖八境小轴 西湖夏日",
      "content": [
        "四月曾湖上，荷钱劣可穿。",
        "归来开短纸，十里已红莲。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 45181,
      "title": "题文发叔所藏潘子真水墨江湖八境小轴 灵隠冷泉",
      "content": [
        "小潘诗家子，解作无声诗。",
        "八境俱妙绝，冷泉天下奇。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 45182,
      "title": "和文黼主簿叔惠诗之韵",
      "content": [
        "薄宦江湖苦异途，十年骨肉隔音书。",
        "此行政尔见公面，又迫归欤巾我车。",
        "安得从容林下去，相从漫浪物之初。",
        "念公不是渔竿客，合结丝絇立玉除。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 45183,
      "title": "秋晓出郊二绝句  其一",
      "content": [
        "初日新寒政晓霞，残山剩水稍人家。",
        "霜红半脸金罂子，雪白一川荞麦花。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45184,
      "title": "秋晓出郊二绝句  其二",
      "content": [
        "野菊相依露下丛，冷香自送水边风。",
        "丰年气象无多子，只在鸡鸣犬吠中。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45185,
      "title": "送杨山人善谈相及地理",
      "content": [
        "相人何似相山难，慙媿渠侬眼不寒。",
        "木末凉风无半点，如何又欲跨归鞍。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45186,
      "title": "胡英彦得欧阳公二帖盖训其子仲纯叔弼之语其一公自书之其一东坡书之英彦刻石以遗朋友吾叔父春卿得一本有诗谢英彦和焉万里用其韵以简英彦",
      "content": [
        "圣处眇安在，谈者一何易。",
        "注瓦矜细巧，岑鼎丧良贵。",
        "群儿有新舌，六学无故意。",
        "向来孟韩息，不有欧苏继。",
        "庸知后死者，未渠乡愿弃。",
        "同时鸱鸦噪，并起爪觜利。",
        "两公察膏肓，与世作姜桂。",
        "挟山初作难，破竹忽乘势。",
        "双明日配月，再立仁与义。",
        "我有香一瓣，恨不生并世。",
        "厥今圣域里，澹叟真守器。",
        "怪来兰玉秀，渠以清白遗。",
        "当家有学林，满腹惟典记。",
        "人间市井言，眼底寇雠视。",
        "独于两公帖，费此半生喜。",
        "麝煤叩山骨，卧听丁丁美。",
        "令我竹林老，亦复拜嘉惠。",
        "敢云赓绝唱，颇欲与兹事。",
        "朝来窗几爽，尽室问何瑞。",
        "宝帖更新诗，小子汝其志。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 45187,
      "title": "寄题张钦夫春风楼",
      "content": [
        "乐斋先生子张子，独立春风望洙泗。",
        "四海无人万古空，咏歌一声满天地。",
        "不应东阁胜东山，浮云于渠了不关。",
        "只余平生医国手，未忍旁观缩袖间。",
        "楼中古书积至斗，楼外春江绿如酒。",
        "权门得似圣门寒，万波横流独回首。",
        "向来沂上瑟声希，由求相顾只心知。",
        "至今留取一转语，不知何咏亦何归。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 45188,
      "title": "四印室长句效刘信夫作呈信夫",
      "content": [
        "广文眼力自超然，作室题诗字字研。",
        "愤世嫉邪聊尔耳，未必崔君真鹤言。",
        "涪州别驾亦浪语，渠家四印何曾铸。",
        "漫向世人言养生，涪州却回宜州去。",
        "广文平生不解愁，只将诗句敌清秋。",
        "白浪如山风打头，江南江北一虚舟。",
        "坐上无毡惟有客，青灯枉草强边策。",
        "万言万当不如默，误人又指庭前柏。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 45189,
      "title": "题刘德夫真意亭二首  其一",
      "content": [
        "湖上轩窗岸岸开，谁家不傍读书台。",
        "新亭自有人知处，只拣风烟好处来。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45190,
      "title": "题刘德夫真意亭二首  其二",
      "content": [
        "渊明有意自忘言，真处如今底处传。",
        "客子若来问真意，镜中人影水中天。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45191,
      "title": "题萧岳英常州草虫轴盖画师之女朱氏之笔二首  其一",
      "content": [
        "常州草虫天下奇，女郎新样不缘师。",
        "未应好手传轮扁，便恐前身是郭熙。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    }
