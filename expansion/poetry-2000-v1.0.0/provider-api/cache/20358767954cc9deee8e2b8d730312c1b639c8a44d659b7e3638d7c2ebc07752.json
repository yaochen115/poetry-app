    {
      "id": 289231,
      "title": "拟古别离",
      "content": [
        "白水东悠悠，中有西行舟。",
        "舟行有返櫂，水去无还流。",
        "奈何生别者，戚戚怀远游。",
        "远游谁当惜，所悲会难收。",
        "自君阒芳躧，青阳四五遒。",
        "皓月掩兰室，光风虚蕙楼。",
        "相思无明晦，长叹累冬秋。",
        "离居久迟暮，高驾何淹留。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 289232,
      "title": "辛丑岁十月上幸长安时扈从出西岳作",
      "content": [
        "西镇何穹崇，壮哉信灵造。",
        "诸岭皆峻秀，中峰特美好。",
        "傍见巨掌存，势如石东倒。",
        "颇闻首阳去，开坼此河道。",
        "磅礴压洪源，巍峨壮清昊。",
        "云泉纷乱瀑，天磴屹横抱。",
        "子先呼其巅，宫女世不老。",
        "下有府君庙，历载传洒扫。",
        "皇明应天游，十月戒丰镐。",
        "微未忝闲从，兼得事苹藻。",
        "宿心爱兹山，意欲拾灵草。",
        "阴壑已永閟，云窦绝探讨。",
        "芳月期来过，回策思方浩。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 289233,
      "title": "和杜麟台元志春情",
      "content": [
        "嘉树满中园，氛氲罗秀色。",
        "不见仙山云，倚琴空太息。",
        "沈思若在梦，缄怨似无忆。",
        "青春坐南移，白日忽西匿。",
        "蛾眉返清镜，闺中不相识。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 289234,
      "title": "别侍御严凝",
      "content": [
        "七泽云梦林，三湘洞庭水。",
        "自古传剽俗，有时逋恶子。",
        "令君出使车，行迈方靡靡。",
        "静言芟枳棘，慎勿伤兰芷。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 289235,
      "title": "送乔随州侃",
      "content": [
        "结交三十载，同游一万里。",
        "情为契阔生，心由别离死。",
        "拜恩前后人，从宦差池起。",
        "今尔归汉东，明珠报知己。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 289236,
      "title": "送友人任括州",
      "content": [
        "青春浩无际，白日乃迟迟。",
        "胡为赏心客，叹迈此芳时。",
        "瓯粤迫兹守，京阙从此辞。",
        "茫茫理云帆，草草念行期。",
        "纷吾结远佩，帐饯出河湄。",
        "太息东流水，盈觞难再持。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 289237,
      "title": "饯远",
      "content": [
        "任子徇遐禄，结友开旧襟。",
        "撰酌辍行叹，指途勤远心。",
        "秋皛澄回壑，霁色肃明林。",
        "暧然青轩暮，浩思非所任。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 289238,
      "title": "同工部李侍郎适访司马子微",
      "content": [
        "紫微降天仙，丹地投云藻。",
        "上言华顶事，中问长生道。",
        "华顶居最高，大壑朝阳早。",
        "长生术何妙，童颜后天老。",
        "清晨朝凤京，静夜思鸿宝。",
        "凭崖饮蕙气，过涧摘灵草。",
        "人非冢已荒，海变田应燥。",
        "昔尝游此郡，三霜弄溟岛。",
        "绪言霞上开，机事尘外扫。",
        "顷来迫世务，清旷未云保。",
        "崎岖待漏恩，怵惕司言造。",
        "轩皇重斋拜，汉武爱祈祷。",
        "顺风怀崆峒，承露在丰镐。",
        "泠然魏轻驭，复得散幽抱。",
        "柱下留伯阳，储闱登四皓。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 289239,
      "title": "自昌乐郡溯流至白石岭下行入郴州",
      "content": [
        "兹山界夷夏，天险横寥廓。",
        "太史漏登探，文命限开凿。",
        "北流自南泻，群峰回众壑。",
        "驰波如电腾，激石似雷落。",
        "崖留盘古树，涧蓄神农药。",
        "乳窦何淋漓，苔藓更彩错。",
        "娟娟潭里虹，渺渺滩边鹤。",
        "岁杪应流火，天高云物薄。",
        "金风吹绿梢，玉露洗红箨。",
        "溯舟始兴廨，登践桂阳郭。",
        "匍匐缘修坂，穹窿曳长䋏。",
        "碍林阻往来，遇堰每前却。",
        "救艰不遑饭，毕昏无暇泊。",
        "濯溪宁足惧，磴道谁云恶。",
        "我行山水间，湍险皆不若。",
        "安能独见闻，书此贻京洛。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 289240,
      "title": "过蜀龙门",
      "content": [
        "龙门非禹凿，诡怪乃天功。",
        "西南出巴峡，不与众山同。",
        "长窦亘五里，宛转复嵌空。",
        "伏湍喣潜石，瀑水生轮风。",
        "流水无昼夜，喷薄龙门中。",
        "潭河势不测，藻葩垂彩虹。",
        "我行当季月，烟景共舂融。",
        "江关勤亦甚，𪩘崿意难穷。",
        "势将息机事，炼药此山东。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 289241,
      "title": "入衞作",
      "content": [
        "淇上风日好，纷纷沿岸多。",
        "绿芳幸未歇，泛滥此明波。",
        "采蘩忆幽吹，理棹想荆歌。",
        "郁然怀君子，浩旷将如何。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 298343,
      "title": "回波乐",
      "content": [
        "回波尔时佺期，流向岭外生归。",
        "身名已蒙齿录，袍笏未复牙绯。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 299242,
      "title": "夜泊越州逢北使",
      "content": [
        "天地降雷雨，放逐还国都。",
        "重以风潮事，年月戒回舻。",
        "容颜荒外老，心想域中愚。",
        "憩泊在兹夜，炎云逐斗枢。",
        "𫗊{风兪}萦海若，霹雳耿天吴。",
        "鼇抃群岛失，鲸吞众流输。",
        "偶逢金华使，握手泪相濡。",
        "饥共噬齐枣，眠共席秦蒲。",
        "既北思攸济，将南睿所图。",
        "往来固无咎，何忽惮前桴。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 299243,
      "title": "绍隆寺",
      "content": [
        "吾从释迦久，无上师涅槃。",
        "探道三十载，得道天南端。",
        "非胜适殊方，起諠归理难。",
        "放弃乃良缘，世虑不曾干。",
        "香界萦北渚，花龛隐南峦。",
        "危昂阶下石，演漾窗中澜。",
        "云盖看木秀，天空见藤盘。",
        "处俗勒宴坐，居贫业行坛。",
        "试将有漏躯，聊作无生观。",
        "了然究诸品，弥觉静者安。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 299244,
      "title": "神龙初废逐南荒途出郴口北望苏耽山",
      "content": [
        "少曾读仙史，知有苏耽君。",
        "流望来南国，依然会昔闻。",
        "泊舟问耆老，遥指孤山云。",
        "孤山郴郡北，不与众山群。",
        "重崖下萦映，嶛峣上乣纷。",
        "碧峰泉附落，红壁树傍分。",
        "选地今方尔，升天因可云。",
        "不才予窜迹，羽化子遗芬。",
        "将览成麟凤，旋惊御鬼文。",
        "此中迷出处，含思独氛氲。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 299245,
      "title": "初达驩州",
      "content": [
        "流子一十八，命予偏不偶。",
        "配远天遂穷，到迟日最后。",
        "水行儋耳国，陆行雕题薮。",
        "魂魄游鬼门，骸骨遗鲸口。",
        "夜则忍饥卧，朝则抱病走。",
        "搔首向南荒，拭泪看北斗。",
        "何年赦书来？",
        "重饮洛阳酒。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 299246,
      "title": "被弹",
      "content": [
        "知人昔不易，举非贵易失。",
        "尔何按国章，无罪见呵叱。",
        "平生守直道，遂为众所嫉。",
        "少以文作吏，手不曾开律。",
        "一旦法相持，荒忙意如漆。",
        "幼子双囹圄，老夫一念室。",
        "昆弟两三人，相次俱囚桎。",
        "万铄当众怒，千谤无片实。",
        "庶以白黑谗，显此泾渭质。",
        "劾吏何咆哮，晨夜闻扑抶。",
        "事间拾虚证，理外存枉笔。",
        "怀痛不见伸，抱冤竟难悉。",
        "穷囚多垢腻，愁坐饶虮虱。",
        "三日唯一饭，两旬不再栉。",
        "是时盛夏中，暵赫多瘵疾。",
        "瞪目眠欲闭，暗呜气不出。",
        "有风自扶摇，鼓荡无伦匹。",
        "安得吹浮云，令我见白日。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 299247,
      "title": "枉系二首 一",
      "content": [
        "吾怜曾家子，昔有投杼疑。",
        "吾怜姬公旦，非无鸱鸮诗。",
        "臣子竭忠孝，君亲惑谗欺。",
        "萋斐离骨肉，含愁兴此辞。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 299248,
      "title": "枉系二首 二",
      "content": [
        "昔日公冶长，非罪遇缧絏。",
        "圣人降其子，古来叹独绝。",
        "我无毫髪瑕，苦心怀冰雪。",
        "今代多秀士，谁能继明辙。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 299249,
      "title": "黄鹤",
      "content": [
        "黄鹤佐丹凤，不能群白鹇。",
        "拂云游四海，弄影到三山。",
        "遥忆君轩上，来下天池间。",
        "明珠世不重，知有报恩环。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 299250,
      "title": "伤王学土",
      "content": [
        "闭囚断外事，昧坐半余朞。",
        "有言颕叔子，亡来已一时。",
        "初闻宛不信，中话涕涟洏。",
        "痛哉玄夜重，何遽青春姿。",
        "忆汝曾旅食，屡空瀍涧湄。",
        "吾徒禄未厚，筲斗愧相贻。",
        "原宪贫无愁，颜回乐自持。",
        "诏书择才善，君为王子师。",
        "宠儒名可尚，论秩官犹欺。",
        "化往不复见，情来安可思。",
        "目绝毫翰洒，耳无歌讽期。",
        "灵柩寄何处，精魂今何之？",
        "恨予在丹棘，不得看素旗。",
        "孀妻知己叹，幼子路人悲。",
        "感游值商日，绝弦留此词。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 299251,
      "title": "古镜",
      "content": [
        "莓苔翳清池，虾蟆蚀明月。",
        "埋落今如此，照心未尝歇。",
        "愿垂拂拭恩，为君鉴玄髪。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 299252,
      "title": "凤箫曲",
      "content": [
        "八月凉风动高阁，千金丽人卷绡幕。",
        "已怜池上歇芳菲，不念君恩坐摇落。",
        "世上荣华如转蓬，朝随阡陌暮云中。",
        "飞燕侍寝昭阳殿，班姬饮恨长信宫。",
        "长信宫，昭阳殿，春来歌舞妾自知，秋至帘栊君不见。",
        "昔时嬴女厌世纷，学吹凤箫乘彩云。",
        "含情转睐向萧史，千载红颜持赠君。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 299253,
      "title": "古歌",
      "content": [
        "落叶流风向玉台，夜寒秋思洞房开。",
        "水晶帘外金波下，云母窗前银汉回。",
        "玉阶阴阴苔藓色，君王屡綦难再得。",
        "璇闺窈窕秋夜长，绣户徘徊明月光。",
        "燕姬彩帐芙蓉色，秦女金炉兰麝香。",
        "北斗七星横夜半，清歌一曲断君肠。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 299254,
      "title": "七夕曝衣篇",
      "content": [
        "君不见昔日宜春太液边，披香画阁与天连。",
        "灯火灼烁九微暎，香气氛氲百和然。",
        "此夜星繁河正白，人传织女牵牛客。",
        "宫中扰扰曝衣楼，天上娥娥红粉席。",
        "曝衣何许曛半黄，宫中彩女提玉箱。",
        "珠履奔腾上兰砌，金梯宛转出梅梁。",
        "绛河里，碧烟上，双花伏兔画屏风，四子盘龙擎斗帐。",
        "舒罗散縠云雾开，缀玉垂珠星汉回。",
        "朝霞散彩羞衣架，晚月分光劣镜台。",
        "上有仙人长命绺，中看玉女迎欢绣。",
        "玳瑁帘中别作春，珊瑚窗里翻成昼。",
        "椒房金屋宠新流，意气娇奢不自由。",
        "汉文宜惜露台费，晋武须焚前殿裘。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 299255,
      "title": "入少密溪",
      "content": [
        "云峰苔壁绕溪斜，江路香风夹岸花。",
        "树密不言通鸟道，鸡鸣始觉有人家。",
        "人家更在深岩口，涧水周流宅前后。",
        "游鱼瞥瞥双钓童，伐木丁丁一樵叟。",
        "自言避喧非避秦，薜衣耕凿帝尧人。",
        "相留且待鸡黍熟，夕卧深山萝月春。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 299256,
      "title": "霹雳引",
      "content": [
        "岁七月，火伏而金生。",
        "客有鼓琴于门者，奏霹雳之商声。",
        "始戛羽以騞砉，终扣宫而砰駖。",
        "电耀耀兮龙跃，雷阗阗兮雨冥。",
        "气呜唅以会雅，态歘翕以横生。",
        "有如驱千旗，制五兵。",
        "截荒虺，斮长鲸。",
        "孰与广陵比，意别鹤俦精而已。",
        "俾我雄子魄动，毅夫髪立。",
        "怀恩不浅，武义双辑。",
        "视胡若芥，剪羯如拾。",
        "岂徒慷慨中筵，备群娱之翕习哉。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 299257,
      "title": "立春日内出彩花应制",
      "content": [
        "合殿春应早，开箱彩预知。",
        "花迎宸翰发，叶待御筵披。",
        "梅讶香全少，桃惊色顿移。",
        "轻生承剪拂，长伴万年枝。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 299258,
      "title": "晦日浐水应制",
      "content": [
        "素浐接宸居，青门盛祓除。",
        "摘兰喧凤野，浮藻溢龙渠。",
        "苑蝶飞殊懒，宫莺啭不疎。",
        "星移天上入，歌舞向储胥。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 299259,
      "title": "奉和洛阳翫雪应制",
      "content": [
        "周王甲子旦，汉后德阳宫。",
        "洒瑞天庭里，惊春御苑中。",
        "氛氲生浩气，飒杳舞回风。",
        "宸藻光盈尺，赓歌乐岁丰。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 299260,
      "title": "三日梨园侍宴",
      "content": [
        "九重驰道出，三巳禊堂开。",
        "画鹢中流动，青龙上苑来。",
        "野花飘御座，河柳拂天杯。",
        "日晚迎祥处，笙镛下帝台。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 299261,
      "title": "幸梨园亭观打毬应制",
      "content": [
        "今春芳苑游，接武上琼楼。",
        "宛转萦香骑，飘飖拂画毬。",
        "俯身迎未落，回辔逐傍流。",
        "秖为看花鸟，时时误失筹。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 299262,
      "title": "九日临渭亭侍宴应制得长字",
      "content": [
        "御气幸金方，凭高荐羽觞。",
        "魏文颁菊蕋，汉武赐萸房。",
        "秋变铜池色，晴添银树光。",
        "年年重九庆，日月奉天长。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 299263,
      "title": "岁夜安乐公主满月侍宴",
      "content": [
        "除夜子星回，天孙满月杯。",
        "咏歌麟趾合，箫管凤雏来。",
        "岁炬常然桂，春盘预折梅。",
        "圣皇千万寿，垂晓御楼开。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 299264,
      "title": "安乐公主移入新宅",
      "content": [
        "初闻衡汉来，移住斗城隈。",
        "锦帐迎风转，琼筵拂雾开。",
        "马香遗旧埒，凤吹绕新台。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 299265,
      "title": "仙萼亭初成侍宴应制",
      "content": [
        "山中气色和，宸赏第中过。",
        "辇路披仙掌，帷宫拂帝萝。",
        "泉临香涧落，峰入翠云多。",
        "无异登玄圃，东南望白河。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 299266,
      "title": "送金城公主适西蕃应制",
      "content": [
        "金牓扶丹掖，银河属紫阍。",
        "那堪将凤女，还以嫁乌孙。",
        "玉就歌中怨，珠辞掌上恩。",
        "西戎非我匹，明主至公存。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 299267,
      "title": "幸白鹿观应制",
      "content": [
        "紫凤真人府，斑龙太上家。",
        "天流芝盖下，山转桂旗斜。",
        "圣藻垂寒露，仙杯落晚霞。",
        "唯应问王母，桃作几时花。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 299268,
      "title": "洛阳道",
      "content": [
        "九门开洛邑，双阙对河桥。",
        "白日青春道，轩裳半下朝。",
        "乘羊稚子看，拾翠美人娇。",
        "行乐归恒晚，香尘扑地遥。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 299269,
      "title": "骢马",
      "content": [
        "西北五花骢，来时道向东。",
        "四蹄碧玉片，双眼黄金瞳。",
        "鞍上留明月，嘶间动朔风。",
        "借君驰沛艾，一战取云中。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 299271,
      "title": "长门怨",
      "content": [
        "月皎风泠泠，长门次掖庭。",
        "玉阶闻坠叶，罗幌见飞萤。",
        "清露凝珠缀，流尘下翠屏。",
        "妾心君未察，愁叹剧繁星。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 299272,
      "title": "巫山高二首 一",
      "content": [
        "巫山峰十二，合沓隐昭回。",
        "俯眺琵琶峡，平看云雨台。",
        "古槎天外倚，瀑水日边来。",
        "何忍猿啼夜，荆王枕席开。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 299273,
      "title": "巫山高二首 二",
      "content": [
        "神女向高唐，巫山下夕阳。",
        "裴回作行雨，婉娈逐荆王。",
        "电影江前落，雷声峡外长。",
        "霁云无处所，台馆晓苍苍。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 299274,
      "title": "巫山高",
      "content": [
        "巫山高不极，合沓状奇新。",
        "暗谷疑风雨，阴崖若鬼神。",
        "月明三峡曙，潮满九江春。",
        "为问阳台客，应知入梦人。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 299275,
      "title": "七夕",
      "content": [
        "秋近雁行稀，天高鹊夜飞。",
        "妆成应懒织，今夕渡河归。",
        "月皎宜穿线，风轻得曝衣。",
        "来时不可觉，神验有光辉。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 299276,
      "title": "春闺",
      "content": [
        "铁马三军去，金闺二月还。",
        "边愁离上国，春梦失阳关。",
        "池水琉璃净，园花玳瑁斑。",
        "岁华空自掷，忧思不胜颜。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 299277,
      "title": "奉和圣制同皇太子游慈恩寺应制",
      "content": [
        "肃肃莲花界，荧荧贝叶宫。",
        "金人来梦里，白马出城中。",
        "涌塔初从地，焚香欲遍空。",
        "天歌应春籥，非是为春风。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 299278,
      "title": "和洛州康士曹庭芝望月有怀",
      "content": [
        "天使下西楼，光含万象秋。",
        "台前疑挂镜，帘外似悬钩。",
        "张尹将眉学，班姬取扇俦。",
        "佳期应借问，为报在刀头。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 299279,
      "title": "寿阳王花烛",
      "content": [
        "仙媛乘龙夕，天孙捧雁来。",
        "可怜桃李树，更遶凤皇台。",
        "烛送香车入，花临宝扇开。",
        "莫令银箭晓，为尽合欢杯。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 299280,
      "title": "陇头水",
      "content": [
        "陇山飞落叶，陇雁度寒天。",
        "愁见三秋水，分为两地泉。",
        "西流入羗郡，东下向秦川。",
        "征客重回首，肝肠空自怜。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 299281,
      "title": "关山月",
      "content": [
        "汉月生辽海，朣胧出半晖。",
        "合昏玄菟郡，中夜白登围。",
        "晕落关山迥，光含霜霰微。",
        "将军听晓角，战马欲南归。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 299282,
      "title": "折杨柳",
      "content": [
        "玉窗朝日暎，罗帐春风吹。",
        "拭泪攀杨柳，长条踠地垂。",
        "白花飞历乱，黄鸟思参差。",
        "妾自肝肠断，傍人那得知。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 299283,
      "title": "梅花落",
      "content": [
        "铁骑几时回，金闺怨早梅。",
        "雪寒花已落，风暖叶应开。",
        "夕逐新春管，香迎小岁杯。",
        "盛时何足贵，书里报轮台。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 299284,
      "title": "紫骝马",
      "content": [
        "青玉紫骝鞍，骄多影屡盘。",
        "荷君能剪拂，躞蹀喷桑干。",
        "踠足追奔易，长鸣遇赏难。",
        "𪭢金一万里，霜露不辞寒。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 299285,
      "title": "上之回",
      "content": [
        "制书下关右，天子问回中。",
        "坛墠经过远，威仪侍从雄。",
        "黄麾摇昼日，青幰曳松风。",
        "回望甘泉道，龙山隐汉宫。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 299286,
      "title": "王昭君",
      "content": [
        "非君惜鸾殿，非妾妬蛾眉。",
        "薄命由骄虏，无情是画师。",
        "嫁来胡地日，不并汉宫时。",
        "心苦无聊赖，何堪马上辞。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 299287,
      "title": "被试出塞",
      "content": [
        "十年通大漠，万里出长平。",
        "寒日生戈劒，阴云拂斾旌。",
        "饥乌啼旧垒，疲马恋空城。",
        "辛苦臯兰北，胡霜损汉兵。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 299288,
      "title": "牛女",
      "content": [
        "粉席秋期缓，针楼别怨多。",
        "奔龙争度日，飞鹊乱填河。",
        "失喜先临镜，含羞未解罗。",
        "谁能留夜色，来夕倍还梭。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 299289,
      "title": "杂诗三首 一",
      "content": [
        "落叶惊秋妇，高砧促暝机。",
        "蜘蛛寻月度，萤火傍人飞。",
        "清镜红埃入，孤灯绿焰微。",
        "怨啼能至晓，独自懒缝衣。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 299290,
      "title": "杂诗三首 二",
      "content": [
        "妾家临渭北，春梦著辽西。",
        "何苦朝鲜郡，年年事鼓鼙。",
        "燕来红壁语，莺向绿窗啼。",
        "为许长相忆，阑干玉筯齐。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 299291,
      "title": "杂诗三首 三",
      "content": [
        "闻道黄龙戍，频年不解兵。",
        "可怜闺里月，长在汉家营。",
        "少妇今春意，良人昨夜情。",
        "谁能将旗鼓，一为取龙城。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 299292,
      "title": "剪彩",
      "content": [
        "宫女怜芳树，裁花竞早荣。",
        "寒依刀尺尽，春向绮罗生。",
        "弱蔕盘丝发，香蕤结素成。",
        "纤枝幸不弃，长就玉阶倾。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 299293,
      "title": "和中书侍郎杨再思春夜宿直",
      "content": [
        "西禁青春满，南端皓月微。",
        "千庐宵驾合，五夜晓钟稀。",
        "星斗横纶阁，天河度琐闱。",
        "烟光章奏里，纷向夕郎飞。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 299294,
      "title": "和常州崔使君寒食夜",
      "content": [
        "闻道清明近，春闱向夕阑。",
        "行游昼不厌，风物夜宜看。",
        "斗柄更初转，梅香暗里残。",
        "无劳秉华烛，晴月在南端。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 299295,
      "title": "和崔正谏登秋日早朝",
      "content": [
        "鸡鸣朝谒满，露白禁门秋。",
        "爽气临旌戟，朝光暎冕旒。",
        "河宗来献宝，天子命焚裘。",
        "独负池阳议，言从建礼游。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 299296,
      "title": "答宁处州书",
      "content": [
        "书报天中赦，人从海上闻。",
        "九泉开白日，六翮起青云。",
        "质幸恩先贷，情孤枉未分。",
        "自怜泾渭别，谁与奏明君。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 299297,
      "title": "李舍人山园送庞邵",
      "content": [
        "符传有光辉，諠諠出帝畿。",
        "东隣借山水，南陌驻骖騑。",
        "握手凉风至，当歌秋日微。",
        "高幨去勿缓，人吏待霜威。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 299298,
      "title": "送陆侍御余庆北使",
      "content": [
        "古人贵将命，之子出輶轩。",
        "受委当不辱，随时敢赠言。",
        "朔途际辽海，春思绕轘辕。",
        "安得回白日，留欢尽绿樽。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 299299,
      "title": "洛州萧司兵谒兄还赴洛成礼",
      "content": [
        "棠棣日光辉，高襟应序归。",
        "来成鸿雁聚，去作凤皇飞。",
        "细草乘轻传，惊花惨别衣。",
        "灞亭春有酒，岐路惜芬菲。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 299300,
      "title": "饯高唐州询",
      "content": [
        "弱冠相知早，中年不见多。",
        "生涯在王事，客鬓各蹉跎。",
        "良守初分岳，嘉声即润河。",
        "还从汉阙下，倾耳听中和。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 299301,
      "title": "饯唐郎中洛阳令",
      "content": [
        "一台推往妙，三史伫来修。",
        "应宰凫还集，辞郎雉少留。",
        "郊筵乘落景，亭传理残秋。",
        "愿以弦歌暇，芝兰想旧游。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 299302,
      "title": "乐城白鹤寺",
      "content": [
        "碧海开龙藏，青云起雁堂。",
        "潮声迎法鼓，雨气湿天香。",
        "树接前山暗，溪承瀑水凉。",
        "无言谪居远，清净得空王。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 299303,
      "title": "游少林寺",
      "content": [
        "长歌游宝地，徙倚对珠林。",
        "雁塔风霜古，龙池岁月深。",
        "绀园澄夕霁，碧殿下秋阴。",
        "归路烟霞晚，山蝉处处吟。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 299304,
      "title": "岳馆",
      "content": [
        "洞壑仙人馆，孤峰玉女台。",
        "空蒙朝气合，窈窕夕阳开。",
        "流涧含轻雨，虚岩应薄雷。",
        "正逢鸾与鹤，歌舞出天来。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 299305,
      "title": "早发平昌岛",
      "content": [
        "解缆春风后，鸣榔晓涨前。",
        "阳乌出海树，云雁下江烟。",
        "积气冲长岛，浮光溢大川。",
        "不能怀魏阙，心赏独泠然。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 299306,
      "title": "夜宿七盘岭",
      "content": [
        "独游千里外，高卧七盘西。",
        "晓月临窗近，天河入户低。",
        "芳春平仲绿，清夜子规啼。",
        "浮客空留听，褒城闻曙鸡。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 299307,
      "title": "十三四时尝从巫峡过他日偶然有思",
      "content": [
        "小度巫山峡，荆南春欲分。",
        "使君滩上草，神女馆前云。",
        "树悉江中见，猿多天外闻。",
        "别来如梦里，一想一氛氲。"
      ],
      "author": {
        "id": 5932,
        "name": "沈佺期"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    }
  ],
