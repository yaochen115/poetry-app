{
  "data": [
    {
      "id": 206105,
      "title": "古诗二首上苏子瞻  其一",
      "content": [
        "江梅有佳实，托根桃李场。",
        "桃李终不言，朝露借恩光。",
        "孤芳忌皎洁，冰雪空自香。",
        "古来和鼎实，此物升庙廊。",
        "岁月坐成晚，烟雨青已黄。",
        "得升桃李盘，以远初见尝。",
        "终然不可口，掷置官道傍。",
        "但使本根在，弃捐果何伤。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206106,
      "title": "古诗二首上苏子瞻  其二",
      "content": [
        "青松出涧壑，十里闻风声。",
        "上有百尺丝，下有千岁苓。",
        "自性得久要，为人制颓龄。",
        "小草有远志，相依在平生。",
        "医和不并世，深根且固蒂。",
        "人言可医国，可用太早计。",
        "小大材则殊，气味固相似。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206107,
      "title": "醇道得蛤蜊复索舜泉舜泉已酌尽官酝不堪不敢送",
      "content": [
        "青州从事难再得，墙底数樽犹未眠。",
        "商略督邮风味恶，不堪持到蛤蜊前。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206108,
      "title": "次韵王穉川客舍二首  其一",
      "content": [
        "五更归梦常苦短，一寸客愁无奈多。",
        "慈母每占乌鹊喜，家人应赋扊扅歌。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206109,
      "title": "次韵王穉川客舍二首  其二",
      "content": [
        "身如病鹤翅翎短，心似乱丝头绪多。",
        "此曲朱门歌不得，湖南湖北竹枝歌。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206110,
      "title": "欵乃歌二章戏王穉川  其一",
      "content": [
        "花上盈盈人不归，枣下纂纂实已垂。",
        "腊雪在时听马嘶，长安城中花片飞。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206111,
      "title": "欵乃歌二章戏王穉川  其二",
      "content": [
        "从师学道鱼千里，盖世成功黍一炊。",
        "日日倚门人不见，看尽林乌反哺儿。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206112,
      "title": "咏史呈徐仲车",
      "content": [
        "诸葛见益州，释耒答三顾。",
        "川流恨未平，武功原上路。",
        "杜微对诸葛，舆致但求去。",
        "倾心倚经纶，坐上漫书疏。",
        "白鸥渺蒹葭，霜鹘在指呼。",
        "借问诸葛公，如何迎主簿。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206113,
      "title": "宿旧彭泽怀陶令",
      "content": [
        "潜鱼愿深渺，渊明无由逃。",
        "彭泽当此时，沈冥一世豪。",
        "司马寒如灰，礼乐卯金刀。",
        "岁晚以字行，更始号元亮。",
        "凄其望诸葛，肮脏犹汉相。",
        "时无益州牧，指挥用诸将。",
        "平生本朝心，岁月阅江浪。",
        "空余诗语工，落笔九天上。",
        "向来非无人，此友独可尚。",
        "属予刚制酒，无用酌杯盎。",
        "欲招千载魂，斯文或宜当。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206114,
      "title": "题山谷石牛洞",
      "content": [
        "司命无心播物，祖师有记传衣。",
        "白云横而不度，高鸟倦而犹飞。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206115,
      "title": "题灊峰阁",
      "content": [
        "徐老海棠巢上，王翁主簿峰庵。",
        "梅蘤破颜冰雪，绿丛不见黄甘。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206116,
      "title": "次韵公择舅",
      "content": [
        "昨梦黄粱半熟，立谈白璧一双。",
        "惊鹿要须野草，鸣鸥本愿秋江。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206117,
      "title": "赣上食莲有感",
      "content": [
        "莲实大如指，分甘念母慈。",
        "共房头𧥄𧥄，更深兄弟思。",
        "实中有幺荷，拳如小儿手。",
        "令我忆众雏，迎门索梨枣。",
        "莲心正自苦，食苦何能甘。",
        "甘餐恐腊毒，素食则怀慙。",
        "莲生淤泥中，不与泥同调。",
        "食莲谁不甘，知味良独少。",
        "吾家双井塘，十里秋风香。",
        "安得同袍子，归制芙蓉裳。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206118,
      "title": "秋思寄子由",
      "content": [
        "黄落山川知晚秋，小虫催女献功裘。",
        "老松阅世卧云壑，挽著沧江无万牛。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 206119,
      "title": "赠别李次翁",
      "content": [
        "利欲薰心，随人翕张。",
        "国好骏马，尽为王良。",
        "不有德人，俗无津梁。",
        "德人天游，秋月寒江。",
        "映彻万物，玲珑八窗。",
        "于爱欲泥，如莲生塘。",
        "处水超然，出泥而香。",
        "孔窍穿穴，明冰其相。",
        "维乃根华，其本含光。",
        "大雅次翁，用心不忘。",
        "日问月学，旅人念乡。",
        "能如斯莲，汔可小康。",
        "在俗行李，密密堂堂。",
        "观物慈哀，涖民爱庄。",
        "成功万年，付之面墙。",
        "草衣石质，与世低昂。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206120,
      "title": "演雅",
      "content": [
        "桑蚕作茧自缠裹，蛛蝥结网工遮逻。",
        "燕无居舍经始忙，蝶为风光勾引破。",
        "老鸧衔石宿水饮，穉蜂趋衙供蜜课。",
        "鹊传吉语安得闲，鸡催晨兴不敢卧。",
        "气陵千里蝇附骥，枉过一生蚁旋磨。",
        "虱闻汤沸尚血食，雀喜宫成自相贺。",
        "晴天振羽乐蜉蝣，空穴祝儿成蜾蠃。",
        "蛣蜣转丸贱苏合，飞蛾赴烛甘死祸。",
        "井边蠹李螬苦肥，枝头饮露蝉常饿。",
        "天蝼伏隙录人语，射工含沙须影过。",
        "训狐啄屋真行怪，蟏蛸报喜太多可。",
        "鸬鹚密伺鱼虾便，白鹭不禁尘土涴。",
        "络纬何尝省机织，布谷未应勤种播。",
        "五技鼯鼠笑鸠拙，百足马蚿怜鼈跛。",
        "老蚌胎中珠是贼，醯鸡瓮里天几大。",
        "螳螂当辙恃长臂，熠燿宵行矜照火。",
        "提壶犹能劝沽酒，黄口只知贪饭颗。",
        "伯劳饶舌世不问，鹦鹉才言便关鏁。",
        "春蛙夏蜩更嘈杂，土蚓壁蟫何碎琐。",
        "江南野水碧于天，中有白鸥闲似我。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206121,
      "title": "戏和答禽语",
      "content": [
        "南村北村雨一犁，新妇饷姑翁哺儿。",
        "田中啼鸟自四时，催人脱袴著新衣。",
        "著新替旧亦不恶，去年租重无袴著。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206122,
      "title": "赠郑交",
      "content": [
        "高居大士是龙象，草堂丈人非熊罴。",
        "不逢坏衲乞香饭，唯见白头垂钓丝。",
        "鸳鸯终日爱水镜，菡萏晚风雕舞衣。",
        "开径老禅来煮茗，还寻密竹迳中归。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 206123,
      "title": "平阴张澄居士隠处三诗 仁亭",
      "content": [
        "无心经世网，有道藏丘山。",
        "养生息天黥，艺木印岁寒。",
        "德人墙九仞，强学窥一斑。",
        "张侯大雅质，结发闯儒关。",
        "奇赢或谐偶，老大尝艰难。",
        "筑亭上云雨，日月转朱栏。",
        "床敷听万籁，我家颇宽闲。",
        "牧牛有坦途，亡羊自多端。",
        "市声鏖午枕，常以此心观。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206124,
      "title": "平阴张澄居士隠处三诗 复庵",
      "content": [
        "舂粮出求仁，行李弥宇宙。",
        "久客渺愁人，马饥仆夫瘦。",
        "归来一丘中，万事不改旧。",
        "禾黍锄其骄，牛羊鞭在后。",
        "隠几天籁寒，六凿忽通透。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206125,
      "title": "平阴张澄居士隠处三诗 亨泉",
      "content": [
        "水德通万物，发源会时亨。",
        "伏坎非心愿，成川且意行。",
        "栖迟林丘下，欲濯无尘缨。",
        "杖藜逢载酒，一瓢酌余清。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 206126,
      "title": "留王郎",
      "content": [
        "河外吹沙尘，江南水无津。",
        "骨肉常万里，寄声何由频。",
        "我随简书来，顾影将一身。",
        "留我左右手，奉承白头亲。",
        "小邦王事略，虫鸟声无人。",
        "王甥解鞍马，夜语鸡唤晨。",
        "母慈家人肥，女惠男垂绅。",
        "有田为酒事，豚韭及秋春。",
        "生涯得如此，旧学更光新。",
        "索去何草草，小留慰艰勤。",
        "百年才一炊，六籍经几秦。",
        "要知胸中有，不与迹同陈。",
        "郢人怀妙质，聊欲运吾斤。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206127,
      "title": "送王郎",
      "content": [
        "酌君以蒲城桑落之酒，泛君以湘累秋菊之英。",
        "赠君以黟川点漆之墨，送君以阳关堕泪之声。",
        "酒浇胸次之垒块，菊制短世之颓龄。",
        "墨以传万古文章之印，歌以写一家兄弟之情。",
        "江山千里俱头白，骨肉十年终眼青。",
        "连床夜语鸡戒晓，书囊无底谈未了。",
        "有功翰墨乃如此，何恨远别音书少。",
        "炊沙作糜终不饱，镂冰文章费工巧。",
        "要须心地收汗马，孔孟行世日杲杲。",
        "有弟有弟力持家，妇能养姑供珍鲑。",
        "儿大诗礼女丝麻，公但读书煮春茶。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206128,
      "title": "次韵刘景文登邺王台见思五首  其一",
      "content": [
        "黄浊归大壑，涟漪遶重城。",
        "西风一横笛，金气与高明。",
        "归鸦度晚景，落雁带边声。",
        "平生知音处，别离空复情。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 206129,
      "title": "次韵刘景文登邺王台见思五首  其二",
      "content": [
        "旧时刘子政，憔悴邺王城。",
        "把笔已头白，见书犹眼明。",
        "平原秋树色，沙麓暮钟声。",
        "归雁南飞尽，无因寄此情。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 206130,
      "title": "次韵刘景文登邺王台见思五首  其三",
      "content": [
        "系匏两相忆，极目十余城。",
        "积潦干斗极，山河皆夜明。",
        "白璧按剑起，朱弦流水声。",
        "乖逢四时尔，木石了无情。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 206131,
      "title": "次韵刘景文登邺王台见思五首  其四",
      "content": [
        "茗花浮曾坑，酒泛酌宜城。",
        "路寻西九曲，人似汉三明。",
        "千户非无相，五言空有声。",
        "何时郭池晚，照影写闲情。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 206132,
      "title": "次韵刘景文登邺王台见思五首  其五",
      "content": [
        "公诗如美色，未嫁已倾城。",
        "嫁作荡子妇，寒机泣到明。",
        "绿琴蛛网徧，弦绝不成声。",
        "想见鸱夷子，江湖万里情。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 206133,
      "title": "次韵吴宣义三径怀友",
      "content": [
        "佳眠未知晓，屋角闻晴哢。",
        "万事颇忘怀，犹牵故人梦。",
        "采兰秋蓬深，汲井短绠冻。",
        "起看冥飞鸿，乃见天宇空。",
        "甚念故人寒，谁省机与综。",
        "在者天一方，日月老宾送。",
        "往者不可言，古柏守翁仲。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206134,
      "title": "送刘季展从军雁门二首  其一",
      "content": [
        "刘郎才力耐百战，苍鹰下鞲秋未晚。",
        "千里荷戈防犬羊，十年读书厌藜苋。",
        "试寻北产汗血驹，莫杀南飞寄书雁。",
        "人生有禄亲白头，可能一日无甘馔。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 206135,
      "title": "送刘季展从军雁门二首  其二",
      "content": [
        "石趺谷中玉子瘦，金刚窟前药草肥。",
        "仙家耕耘成白璧，道人煮掘起风痱。",
        "绛囊璀璨思盈斗，竹畚香甘要百围。",
        "到官莫道无来使，日日北风鸿雁归。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 206136,
      "title": "题宛陵张待举曲肱亭",
      "content": [
        "仲蔚蓬蒿宅，宣城诗句中。",
        "人贤忘巷陋，境胜失途穷。",
        "寒葅书万卷，零乱刚直胸。",
        "偃蹇勋业外，啸歌山水重。",
        "晨鸡催不起，拥被听松风。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206137,
      "title": "寄裴仲谟",
      "content": [
        "交游二十年，义等亲骨肉。",
        "风雨漂我巢，公亦未有屋。",
        "寄声来问安，足音到空谷。",
        "我家辇毂下，薪桂炊白玉。",
        "在官与影俱，衣绽发曲局。",
        "天机行日月，春事勤草木。",
        "念公笃行李，野饭中道宿。",
        "惊沙卷旍旗，乌尾城角谡。",
        "骚骚家治具，夫子且归沐。",
        "作书寄后乘，为我遣臣仆。",
        "起居太夫人，并问相与睦。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206138,
      "title": "寄黄几复",
      "content": [
        "我居北海君南海，寄雁传书谢不能。",
        "桃李春风一杯酒，江湖夜雨十年灯。",
        "持家但有四立壁，治病不蕲三折肱。",
        "想得读书头已白，隔溪猿哭瘴溪藤。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 206139,
      "title": "神宗皇帝挽词三首  其一",
      "content": [
        "文思昭日月，神武用雷霆。",
        "制作深垂统，忧勤减梦龄。",
        "孙谋开二圣，末命对三灵。",
        "今代谁班马，能书汗简青。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 206140,
      "title": "神宗皇帝挽词三首  其二",
      "content": [
        "钓筑收贤辅，天人与圣能。",
        "辉光唐六典，度越汉中兴。",
        "百世神宗庙，千秋永裕陵。",
        "帝乡无马迹，空望白云乘。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 206141,
      "title": "神宗皇帝挽词三首  其三",
      "content": [
        "昔在基皇极，师臣论九畴。",
        "丘陵忽为谷，天地不藏舟。",
        "河洛功无憾，幽燕策未收。",
        "嗣皇朝万国，任姒正兴周。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 206142,
      "title": "王文恭公挽词二首  其一",
      "content": [
        "先皇凭玉几，末命寄元勋。",
        "宾日行黄道，攀髯上白云。",
        "四时成岁律，五色补天文。",
        "不谓堂堂去，今为马鬣坟。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 206143,
      "title": "王文恭公挽词二首  其二",
      "content": [
        "宥密深黄阁，光辉极上台。",
        "藏舟移夜壑，华屋落泉台。",
        "雨绋谁为挽，寒笳故作哀。",
        "伤心具瞻地，无复衮衣来。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 206144,
      "title": "谢送碾壑源拣芽",
      "content": [
        "矞云从龙小苍璧，元丰至今人未识。",
        "壑源包贡第一春，缃奁碾香供玉食。",
        "睿思殿东金井栏，甘露荐椀天开颜。",
        "桥山事严庀百局，补衮诸公省中宿。",
        "中人传赐夜未央，雨露恩光照宫烛。",
        "右丞似是李元礼，好事风流有泾渭。",
        "肯怜天禄校书郎，亲敕家庭遣分似。",
        "春风饱识大官羊，不惯腐儒汤餠肠。",
        "搜搅十年灯火读，令我胸中书传香。",
        "已戒应门老马走，客来问字莫载酒。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206145,
      "title": "以小团龙及半挺赠无咎并诗用前韵为戏",
      "content": [
        "我持玄圭与苍璧，以暗投人渠不识。",
        "城南穷巷有佳人，不索宾郎常晏食。",
        "赤铜茗椀雨斑斑，银粟翻光解破颜。",
        "上有龙文下棋局，探囊赠君诺已宿。",
        "此物已是元丰春，先皇圣功调玉烛。",
        "晁子胸中开典礼，平生自期莘与渭。",
        "故用浇君磊隗胸，莫令鬓毛雪相似。",
        "曲几团蒲听煮汤，煎成车声绕羊肠。",
        "鸡苏胡麻留渴羌，不应乱我官焙香。",
        "肥如瓠壶鼻雷吼，幸君饮此勿饮酒。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206146,
      "title": "和答外舅孙莘老",
      "content": [
        "西风挽不来，残暑推不去。",
        "出门厌靴帽，税驾喜巾屦。",
        "道山邻日月，清樾深牖户。",
        "同舍多望郎，闲官无窘步。",
        "少监岩壑姿，宿昔廊庙具。",
        "行趋补衮职，黼黻我王度。",
        "归休饮热客，觞豆愆调护。",
        "浩然养灵根，勿药有神助。",
        "寄声旧僚属，训诂及匕箸。",
        "尚怜费谏纸，玉唾洒新句。",
        "北焙碾玄璧，谷帘煮甘露。",
        "何时临书几，剥芡谈至暮。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206147,
      "title": "次韵定国闻子由卧病绩溪",
      "content": [
        "炎洲冬无冰，十月雷虺虺。",
        "及春疟疠行，用人祭非鬼。",
        "巫师司民命，药石不入市。",
        "溪弩潜发机，土风甚不美。",
        "苏子卧江南，感叹中夜起。",
        "闻道病在床，食鱼不知旨。",
        "寒暑战胸中，士穷有如此。",
        "此公天机深，爵禄心已死。",
        "养生遗形骸，观妙得骨髓。",
        "后皇莳嘉橘，中岁多成枳。",
        "佳人何时来，为天启玉齿。",
        "湔祓瘴雾姿，朝趋去天咫。",
        "诸公转洪钧，国器方荐砥。",
        "矢诗写予心，庄语不加绮。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206148,
      "title": "次韵子由绩溪病起被召寄王定国",
      "content": [
        "种萱盈九畹，苏子忧国病。",
        "炎蒸卧百战，山立有余劲。",
        "斯人廊庙器，不合从远屏。",
        "江湖摇归心，毛发侵老境。",
        "艰难喜归来，如晴月生岭。",
        "仍怀阻归舟，风水蛟鳄横。",
        "补衮谏官能，用儒吾道盛。",
        "上书诋平津，蠹藁初记省。",
        "至今民社计，非事颊舌竞。",
        "方来立本朝，献纳继晨暝。",
        "人材包新旧，王度济宽猛。",
        "必开曲突谋，满慰倾耳听。",
        "斯文吕与张，泉下亦苏醒。",
        "天聪四门辟，国势九鼎定。",
        "身得遭太平，分甘守闲冷。",
        "天津十年面，想见颀而整。",
        "何时及国门，休暇过煮茗。",
        "烧灯留夜语，鸿雁看对影。",
        "但恐张罗地，颇复多造请。",
        "维此礼部公，寒泉甃旧井。",
        "谪去久羸瓶，召还汲修绠。",
        "太任决斋宫，陛下天统庆。",
        "日月进亨衢，经纬寒耿耿。",
        "西走已和戎，南迁无哀郢。",
        "谁言两逐臣，朝辔天街并。",
        "王子窜炎洲，万死保躯命。",
        "还家颊故红，信亦抱渊静。",
        "税屋待车音，扫门亲帚柄。",
        "行当怀书传，载酒求是正。",
        "端如尝橄榄，苦过味方永。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206149,
      "title": "次韵李之纯少监惠砚",
      "content": [
        "黄公山下黄鸡秋，持节恤刑曾少休。",
        "小人负弩得开道，扫叶张饮林岩幽。",
        "相传有石非地产，列仙持来自罗浮。",
        "酒酣步出云雨上，南抚方城西嵩丘。",
        "林端乃见石空洞，猛兽赑屭踞上头。",
        "鸟道兔迒谋挽致，万牛不动五丁愁。",
        "道家蓬莱见仙伯，我亦洗湔与清流。",
        "探囊赠研颇宜墨，近出黄山非远求。",
        "乃知此山自才美，物欲致用当穷搜。",
        "迷邦故令成器晚，不琢元非匠石羞。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206150,
      "title": "送舅氏野夫之宣城二首  其一",
      "content": [
        "借甚宣城郡，风流数贡毛。",
        "霜林收鸭脚，春网荐琴高。",
        "共理须良守，今年辍省曹。",
        "平生割鸡手，聊试发硎刀。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 206151,
      "title": "送舅氏野夫之宣城二首  其二",
      "content": [
        "试说宣城郡，停杯且细听。",
        "晚楼明宛水，春骑簇昭亭。",
        "𫁂䅉丰圩户，桁杨卧讼庭。",
        "谢公歌舞处，时对换鹅经。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 206152,
      "title": "送范德孺知庆州",
      "content": [
        "乃翁知国如知兵，塞垣草木识威名。",
        "敌人开户玩处女，掩耳不及惊雷霆。",
        "平生端有活国计，百不一试薶九京。",
        "阿兄两持庆州节，十年骐驎地上行。",
        "潭潭大度如卧虎，边头耕桑长儿女。",
        "折冲千里虽有余，论道经邦正要渠。",
        "妙年出补父兄处，公自才力应时须。",
        "春风旍旗拥万夫，幕下诸将思草枯。",
        "智名勇功不入眼，可用折箠笞羌胡。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206153,
      "title": "题王黄州墨迹后",
      "content": [
        "掘地与断木，智不如机舂。",
        "圣人怀余巧，故为万物宗。",
        "世有斲泥手，或不待郢工。",
        "往时王黄州，谋国极匪躬。",
        "朝闻不及夕，百壬避其锋。",
        "九鼎安盘石，一身转孤蓬。",
        "浮云当日月，白发照秋空。",
        "诸君发蒙耳，汲直与臣同。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206154,
      "title": "题王仲弓兄弟巽亭",
      "content": [
        "大隗七圣迷，许田连城重。",
        "里中多佳树，与世作梁栋。",
        "市门行清渠，潩水可抱瓮。",
        "翚飞城东南，隠几抚群动。",
        "人境要俱尔，我乃得大用。",
        "乌衣之云孙，昆弟不好弄。",
        "木末风雨来，卷箔醉宾从。",
        "事常超然观，乐与贤者共。",
        "人登断龙求，我自归鸿送。",
        "溪毛乱锦缬，候虫响机综。",
        "世纷甚峥嵘，胸次欲空洞。",
        "读书开万卷，谋国妙百中。",
        "傥无斲鼻工，聊付曲肱梦。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206155,
      "title": "寄尉氏仓官王仲弓",
      "content": [
        "啸台有佳人，玄发鉴䈂珥。",
        "登高歌一曲，听者倾城市。",
        "门无行媒迹，草木倚憔悴。",
        "人物方眇然，谁能委圭币。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 206156,
      "title": "有惠江南帐中香者戏答六言二首  其一",
      "content": [
        "百炼香螺沉水，宝薰近出江南。",
        "一穟黄云绕几，深禅想对同参。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 206157,
      "title": "有惠江南帐中香者戏答六言二首  其二",
      "content": [
        "螺甲割昆仑耳，香材屑鹧鸪斑。",
        "欲雨鸣鸠日永，下帷睡鸭春闲。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 206158,
      "title": "子瞻继和复答二首  其一",
      "content": [
        "置酒未容虚左，论诗时要指南。",
        "迎笑天香满袖，喜公新赴朝参。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206159,
      "title": "子瞻继和复答二首  其二",
      "content": [
        "迎燕温风旎旎，润花小雨斑斑。",
        "一炷烟中得意，九衢尘里偷闲。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206160,
      "title": "有闻帐中香以为熬蝎者戏用前韵二首  其一",
      "content": [
        "海上有人逐臭，天生鼻孔司南。",
        "但印香严本寂，不必丛林徧参。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206161,
      "title": "有闻帐中香以为熬蝎者戏用前韵二首  其二",
      "content": [
        "我读蔚宗香传，文章不减二班。",
        "误以甲为浅俗，却知麝要防闲。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206162,
      "title": "谢公择舅分赐茶三首  其一",
      "content": [
        "外家新赐苍龙璧，北焙风烟天上来。",
        "明日蓬山破寒月，先甘和梦听春雷。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206163,
      "title": "谢公择舅分赐茶三首  其二",
      "content": [
        "文书满案惟生睡，梦里鸣鸠唤雨来。",
        "乞与降魔大圆镜，真成破柱作惊雷。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206164,
      "title": "谢公择舅分赐茶三首  其三",
      "content": [
        "细题叶字包青箬，割取丘郎春信来。",
        "拚洗一春汤餠睡，亦知清夜有蚊雷。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206165,
      "title": "便粜王丞送碧香酒用子瞻韵戏赠郑彦能",
      "content": [
        "食贫好酒尝自嘲，日给上尊无骨相。",
        "大农部丞送新酒，碧香窃比主家酿。",
        "应怜坐客竟无毡，更遭官长颇讥谤。",
        "银杯同色试一倾，排遣春寒出帷帐。",
        "浮蛆翁翁杯底滑，坐想康成论泛盎。",
        "重门著关不为君，但备恶客来仇饷。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206166,
      "title": "送郑彦能宣德知福昌县",
      "content": [
        "往时河北盗横行，白昼驱人取城郭。",
        "唯闻不犯郑冠氏，犬卧不惊民气乐。",
        "秖今化民作锄耰，田舍老翁百不忧。",
        "铜章去作福昌县，山中读书民有秋。",
        "福昌爱民如父母，当官不扰万事举。",
        "用才之地要得人，眼中虚席十四五。",
        "不知诸公用心许，鲁恭卓茂可人否。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206167,
      "title": "显圣寺庭枸杞",
      "content": [
        "仙苗寿日月，佛界承露雨。",
        "谁为万年计，乞此一抔土。",
        "扶疏上翠盖，磊落缀丹乳。",
        "去家尚不食，出家何用许。",
        "正恐落人间，采剥四时苦。",
        "养成九节杖，持献西王母。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206168,
      "title": "次韵子瞻赠王定国",
      "content": [
        "远志作小草，蛙衣生陵屯。",
        "但为居移气，其实何足言。",
        "名下难为人，丑好随手翻。",
        "百年炊未熟，一垤蚁追奔。",
        "夏日蓬山永，戎葵茂墙藩。",
        "王子吐佳句，如茧丝出盆。",
        "风姿极洒落，云气画罍樽。",
        "属有补衮章，自当宠频烦。",
        "鄙夫无他能，上车问寒温。",
        "惟思穷山去，抱犊长儿孙。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206169,
      "title": "次韵张询斋中晚春",
      "content": [
        "学古编简残，怀人江湖永。",
        "非无车马客，心远境亦静。",
        "挽蔬夜雨畦，煮茗寒泉井。",
        "春去不窥园，黄鹂颇三请。",
        "立朝无物望，补外傥天幸。",
        "想乘沧浪船，濯发晞翠岭。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206170,
      "title": "次韵答晁无咎见赠",
      "content": [
        "翕翕一日炎，耽耽万年永。",
        "四海仰首观，顷复归根静。",
        "时雨泻玉除，潢流涨天井。",
        "性不耐衣冠，入门疏造请。",
        "煮餠卧北窗，保此已徼幸。",
        "空余见贤心，忍渴望梅岭。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206171,
      "title": "次韵答张文潜惠寄",
      "content": [
        "短褐不磷缁，文章近楚辞。",
        "未识想风采，别去令人思。",
        "斯文已战胜，凯歌偃旍旗。",
        "君行鱼上冰，忽复燕哺儿。",
        "学省得佳士，催来费符移。",
        "方观追金玉，如许遽言归。",
        "南山有君子，握兰怀令姿。",
        "但应洁斋俟，勿咏无生诗。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206172,
      "title": "同钱志仲饭藉田钱孺文官舍",
      "content": [
        "帝藉开千亩，农功先九州。",
        "王孙守耒耜，吏隠极风流。",
        "永夏丰草木，五云卫郊丘。",
        "牛羊卧篱落，宾客解衣裘。",
        "汲井羞热啜，挽溪供甘柔。",
        "倒靫收莲的，剖蚌煮鸿头。",
        "野日草光合，水风荷气浮。",
        "稻畦下白鹭，林樾应鸣鸠。",
        "主人发清赏，况复佳同游。",
        "归扇障小雨，真成一赐休。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206173,
      "title": "次韵曾子开舍人游藉田载荷花归",
      "content": [
        "维王调玉烛，时夏雨我田。",
        "壁挂苍龙骨，溜渠故溅溅。",
        "三推劝根本，百谷收皂坚。",
        "官司极斋明，崇丘见升烟。",
        "系马西门柳，忆听去夏蝉。",
        "剥芡珠走盘，钓鱼柳贯鲜。",
        "扫堂延枕簟，公子气翩翩。",
        "自尔欲继往，阻心如壅泉。",
        "紫微乐暇日，披襟咏风涟。",
        "红妆倚荷盖，水镜写明蠲。",
        "美物亦有实，剪房助加笾。",
        "珠宫紫贝阙，足此水府仙。",
        "鬰鬰冠盖宅，追奔易雕年。",
        "能从物外赏，真是区中贤。",
        "仍闻载后乘，笼烛照婵娟。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206174,
      "title": "送刘士彦赴福建转运判官",
      "content": [
        "秋叶雨堕来，冥鸿天资高。",
        "车马气成雾，九衢行滔滔。",
        "中有寂寞人，灵府扃锁牢。",
        "西风持汉节，骑从严弓刀。",
        "惟闽七聚落，惸独困吏饕。",
        "土弊禾黍恶，水烦鳞介劳。",
        "南驱将仁气，百城共一陶。",
        "察人极泾渭，问俗及豚羔。",
        "官闲得胜日，杖屦之林臯。",
        "人间阅忠厚，物外访英豪。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206175,
      "title": "次韵韩川奉祠西太乙宫四首  其一",
      "content": [
        "万灵未对甘泉，五福问祀迎年。",
        "旍旗三斿半偃，风马云车闯然。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206176,
      "title": "次韵韩川奉祠西太乙宫四首  其二",
      "content": [
        "白髦下金神节，青祝携御炉香。",
        "百礼尽修亳祀，九歌不取沈湘。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206177,
      "title": "次韵韩川奉祠西太乙宫四首  其三",
      "content": [
        "紫府侍臣鸣玉，霜台御史生风。",
        "官烛论诗未了，知秋自属梧桐。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206178,
      "title": "次韵韩川奉祠西太乙宫四首  其四",
      "content": [
        "泰坛下瑞云黄，雨师洒道尘香。",
        "便面犹承坠露，金钲半吐东墙。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206179,
      "title": "次韵王荆公题西太乙宫壁二首  其一",
      "content": [
        "风急啼乌未了，雨来战蚁方酣。",
        "真是真非安在，人间北看成南。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206180,
      "title": "次韵王荆公题西太乙宫壁二首  其二",
      "content": [
        "晚风池莲香度，晓日宫槐影西。",
        "白下长干梦到，青门紫曲尘迷。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206181,
      "title": "有怀半山老人再次韵二首  其一",
      "content": [
        "短世风惊雨过，成功梦迷酒酣。",
        "草玄不妨准易，论诗终近周南。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206182,
      "title": "有怀半山老人再次韵二首  其二",
      "content": [
        "啜羹不如放麑，乐羊终愧巴西。",
        "欲问老翁归处，帝乡无路云迷。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206183,
      "title": "和答钱穆父咏猩猩毛笔",
      "content": [
        "爱酒醉魂在，能言机事疏。",
        "平生几两屐，身后五车书。",
        "物色看王会，勋劳在石渠。",
        "拔毛能济世，端为谢杨朱。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 206184,
      "title": "戏咏猩猩毛笔二首  其一",
      "content": [
        "桄榔叶暗宾郎红，朋友相呼堕酒中。",
        "正以多知巧言语，失身来作管城公。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206185,
      "title": "戏咏猩猩毛笔二首  其二",
      "content": [
        "明窗脱帽见蒙茸，醉著青鞋在眼中。",
        "束缚归来傥无辱，逢时犹作黑头公。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206186,
      "title": "奉和文潜赠无咎篇末多见及以既见君子云胡不喜为韵  其一",
      "content": [
        "龟以灵故焦，雉以文故翳。",
        "本心如日月，利欲食之既。",
        "后生玩华藻，照影终没世。",
        "安得八纮罝，以道猎众智。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 206187,
      "title": "奉和文潜赠无咎篇末多见及以既见君子云胡不喜为韵  其二",
      "content": [
        "谈经用燕说，束弃诸儒传。",
        "滥觞虽有罪，末派弥九县。",
        "张侯真理窟，坚壁不与战。",
        "难以口舌争，水清石自见。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 206188,
      "title": "奉和文潜赠无咎篇末多见及以既见君子云胡不喜为韵  其三",
      "content": [
        "野性友麋鹿，君非我同群。",
        "文明近日月，我亦不如君。",
        "十载长相望，逝川水沄沄。",
        "何当谈绝倒，茗椀对炉薰。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 206189,
      "title": "奉和文潜赠无咎篇末多见及以既见君子云胡不喜为韵  其四",
      "content": [
        "北寺锁斋房，尘钥时一启。",
        "晁张跫然来，连璧照书几。",
        "庭柏鬰葱葱，红榴罅多子。",
        "时蒙吐佳句，幽处万籁起。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 206190,
      "title": "奉和文潜赠无咎篇末多见及以既见君子云胡不喜为韵  其五",
      "content": [
        "先皇元丰未，极厌士浅闻。",
        "只今举秀孝，天未丧斯文。",
        "晁张班马首，崔蔡不足云。",
        "当令横笔阵，一战静楚氛。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 206191,
      "title": "奉和文潜赠无咎篇末多见及以既见君子云胡不喜为韵  其六",
      "content": [
        "张侯窘炊玉，僦屋得空垆。",
        "但见索酒郎，不见酒家胡。",
        "虽肥如瓠壶，胸中殊不麤。",
        "何用知如此，文彩似於菟。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 206192,
      "title": "奉和文潜赠无咎篇末多见及以既见君子云胡不喜为韵  其七",
      "content": [
        "荆公六艺学，妙处端不朽。",
        "诸生用其短，颇复凿户牖。",
        "譬如学捧心，初不悟己丑。",
        "玉石恐俱焚，公为区别不。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 206193,
      "title": "奉和文潜赠无咎篇末多见及以既见君子云胡不喜为韵  其八",
      "content": [
        "吾友陈师道，抱独门扫轨。",
        "晁张作荐书，射雉用一矢。",
        "吾闻举逸民，故得天下喜。",
        "两公阵堂堂，此士可摩垒。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 206194,
      "title": "次韵答邢惇夫",
      "content": [
        "为山不能山，过在一篑止。",
        "渥洼骐驎儿，堕地志千里。",
        "岷江初滥觞，入楚乃无底。",
        "将升圣人堂，道固有廉陛。",
        "邢子好少年，如世有源水。",
        "方求无津涯，不作蛙井喜。",
        "儿中兀老苍，趣造甚奇异。",
        "过阅王公门，袖中有漫刺。",
        "别来阻河山，望远每障袂。",
        "斯文向千载，有志常寡遂。",
        "后生文楚楚，照影若孔翠。",
        "不应太玄草，睎价咸阳市。",
        "雨作枕箪秋，官闲省中睡。",
        "梦不到汉东，茗椀乃为祟。",
        "闻君肺渴减，颇复佳食寐。",
        "读书得新功，来雁寄一字。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206195,
      "title": "和邢惇夫秋怀十首  其一",
      "content": [
        "残暑已俶装，好风方来归。",
        "未能疏团扇，且复制秋衣。",
        "高蝉遽如许，长吟送落晖。",
        "相戒趣女功，莎虫能表微。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 206196,
      "title": "和邢惇夫秋怀十首  其二",
      "content": [
        "曩时高唐客，暮雨朝行云。",
        "阴居怀天匹，楚观梦纷纭。",
        "我欲睹光仪，斋明炷炉薰。",
        "天高万物肃，谁为帝子魂。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 206197,
      "title": "和邢惇夫秋怀十首  其三",
      "content": [
        "七均师无声，五和常主淡。",
        "芸芸观此归，一德贯真滥。",
        "梦临秋江水，鱼虾避窥瞰。",
        "明月本无心，谁令作寒鉴。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 206198,
      "title": "和邢惇夫秋怀十首  其四",
      "content": [
        "王度无畦畛，包荒用冯河。",
        "秦收郑渠成，晋得楚材多。",
        "用人当其物，不但轴与薖。",
        "六通而四辟，玉烛四时和。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 206199,
      "title": "和邢惇夫秋怀十首  其五",
      "content": [
        "相如用全赵，留侯开有汉。",
        "名登太山重，功略天下半。",
        "让颇封韩彭，事成群疑泮。",
        "天道当曲全，小智骜后患。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 206200,
      "title": "和邢惇夫秋怀十首  其六",
      "content": [
        "庆州名父子，忠勇横八区。",
        "许身如稷契，初不学孙吴。",
        "荷戈去防秋，面皱鬓欲疏。",
        "虽折千里冲，岂若秉事枢。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 206201,
      "title": "和邢惇夫秋怀十首  其七",
      "content": [
        "谢公蕴风流，诗作鲍照语。",
        "丝虫萦草纸，笔力挟风雨。",
        "万里投谏书，石交化豺虎。",
        "世方用贤髦，先成泉下土。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 206202,
      "title": "和邢惇夫秋怀十首  其八",
      "content": [
        "今日吕虢州，堂堂古遗直。",
        "许国输九死，补天炼五色。",
        "颇修谏员缺，人寿无金石。",
        "西风壮夫泪，多为程颢滴。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 206203,
      "title": "和邢惇夫秋怀十首  其九",
      "content": [
        "吾友陈师道，抱瑟不吹竽。",
        "文章似扬马，欬唾落明珠。",
        "固穷有胆气，风壑啸於菟。",
        "秋来入诗律，陶谢不枝梧。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 206204,
      "title": "和邢惇夫秋怀十首  其一○",
      "content": [
        "邢子卧北窗，吟秋意少悰。",
        "读书用意苦，呕血惊乃翁。",
        "安得和扁辈，为浣学古胸。",
        "肺热今好否，微凉生井桐。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    }
  ],
