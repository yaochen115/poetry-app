{
  "data": [
    {
      "id": 176604,
      "title": "虎牢关",
      "content": [
        "天险限西东，难知造化功。",
        "路邀三晋会，势压两河雄。",
        "余雪霑枯草，惊飚卷断蓬。",
        "徒观争战处，今古索然空。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176605,
      "title": "和李殿丞仓中对菊  其一",
      "content": [
        "高士寄朝市，迥然心迹殊。",
        "秋风太仓里，黄菊满庭隅。",
        "陶令成诗后，王公送酒无。",
        "遥知厌俗事，未免强踌蹰。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176606,
      "title": "和李殿丞仓中对菊  其二",
      "content": [
        "文案渐消散，仓闲吏已稀。",
        "庭空数蝶下，夜静一萤飞。",
        "爱赏忽成句，淹留时忘归。",
        "高情虽不系，遇此独依依。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176607,
      "title": "和李殿丞仓中对菊  其三",
      "content": [
        "凉风正萧瑟，好月复徘徊。",
        "幽兴眇不尽，芳罇时一开。",
        "余英盖红叶，坠露湿苍苔。",
        "从此东篱下，应忘归去来。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176608,
      "title": "送何万下第归蜀  其一",
      "content": [
        "十上终无就，才高定复论。",
        "清时守儒术，白首在丘园。",
        "远树隐残日，孤烟生暮村。",
        "扬鞭万里去，几许不销魂。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176609,
      "title": "送何万下第归蜀  其二",
      "content": [
        "失意流年老，残春对夕阳。",
        "可堪临远道，更复举离觞。",
        "花柳已萧索，云山复渺茫。",
        "西风如有意，音信勿相忘。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176610,
      "title": "执酒",
      "content": [
        "执酒劝君君尽之，今朝取醉不当疑。",
        "好风好景心无事，闲利闲名何足知。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 176611,
      "title": "河桥春别",
      "content": [
        "河桥春尽送君归，又惜无欢度此时。",
        "乱花满眼遮人望，不见行尘空酒旗。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 176612,
      "title": "答陈进士谓之忆江东旧游见赠",
      "content": [
        "客路今东去，亭臯木叶飞。",
        "居然不堪恨，况与赏心违。",
        "顾渚烟波阔，长洲草树微。",
        "江边好春色，行望锦标归。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176613,
      "title": "又赠谓之  其一",
      "content": [
        "文藻兼名理，三吴第一贤。",
        "乡心几千里，飞鴈满秋天。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 176614,
      "title": "又赠谓之  其二",
      "content": [
        "篱下多新菊，渊明归思长。",
        "主人方爱客，未得傲羲皇。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 176615,
      "title": "又赠谓之  其三",
      "content": [
        "君念东归日，应须昼绣荣。",
        "当令故关吏，还识弃𦈡生。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 176616,
      "title": "重九日忆菊",
      "content": [
        "节物都何晚，佳辰容易过。",
        "黄花不足念，当奈酒杯何。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 176617,
      "title": "客思",
      "content": [
        "客思倦漂泊，居然感物华。",
        "关头望红叶，马上见黄花。",
        "薄宦终无定，闲愁讵有涯。",
        "今朝书至否，几夕梦还家。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176618,
      "title": "前年春与楚正叔同游陟屺寺今兹已复周歳窅然思之",
      "content": [
        "陟屺寺南山，曾陪半日闲。",
        "春来梦携手，宛在白云间。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 176619,
      "title": "晓霁",
      "content": [
        "梦觉繁声绝，林光透隙来。",
        "开门惊乌鸟，余滴堕苍苔。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 176620,
      "title": "观江上人壁许道宁画寒林",
      "content": [
        "昔曾驱瘦马，冲雪过荥阳。",
        "不悟当时景，萧然在此堂。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 176621,
      "title": "自都往余杭怀聂之美",
      "content": [
        "阁上新文卷，欲逢知已开。",
        "相思不能已，欹枕梦君来。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 176622,
      "title": "梦与之美为寒食游",
      "content": [
        "寒食无佳赏，芳菲半已空。",
        "夜来逢胜友，末至负东风。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 176623,
      "title": "秋日登观信亭",
      "content": [
        "西风连夜雨，草树已萧条。",
        "宿霭稍零落，寒山更寂寥。",
        "林红犹带日，岸白欲生潮。",
        "新鴈来何处，离离天际遥。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176624,
      "title": "湖上村家",
      "content": [
        "万顷寒烟外，茅茨枕碧流。",
        "枫林巢乳鹤，沙溆乱鸣鸥。",
        "漠漠菰蒲晚，苍苍芦荻秋。",
        "欲过南浦去，篱下出渔舟。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176625,
      "title": "别聂之美",
      "content": [
        "客宦常漂泊，离怀徒自劳。",
        "贫无衣换酒，空有涕霑袍。",
        "木叶寒犹在，江湖暮更豪。",
        "行舟远不见，赖有片帆高。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176626,
      "title": "松江  其一",
      "content": [
        "吴山黯黯江水清，欲雨未雨伤交情。",
        "扁舟荡漾泊何处，红蓼白苹相映生。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 176627,
      "title": "松江  其二",
      "content": [
        "秋风索索连江起，暮过烟波十余里。",
        "长芦瘦竹映渔家，灯火渺茫寒照水。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 176628,
      "title": "潮水  其一",
      "content": [
        "平江欲上潮，古木自萧萧。",
        "两岸饶葭苇，寒波浸寂寥。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 176629,
      "title": "潮水  其二",
      "content": [
        "淋淋出海门，百里雪花喷。",
        "坐看东归去，平沙空有痕。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 176630,
      "title": "双竹",
      "content": [
        "双干标枯腹，青青凡几霜。",
        "龙腾双角直，鲸喷两须长。",
        "但欲寻支遁，安能问辟疆。",
        "屡来非别意，未与此君忘。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176631,
      "title": "旅宿睢阳南湖",
      "content": [
        "梁王弃宫馆，时世古今违。",
        "犹有南湖水，春来鴈鹜飞。",
        "楼台沈倒影，林薄挂余晖。",
        "豪侈终何在，行人得暂依。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176632,
      "title": "南湖  其一",
      "content": [
        "宋都南野水，花柳媚名园。",
        "鸟起沙留迹，鱼惊浪结痕。",
        "朱桥通别岛，白路出荒村。",
        "城邑虽云迩，常无车马喧。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176633,
      "title": "南湖  其二",
      "content": [
        "海鴈长桥北，乘闲日日来。",
        "游鱼自应乐，宿鸟不相猜。",
        "弱柳周遭合，芳花次第开。",
        "梁王昔游集，后乘列邹枚。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176634,
      "title": "西谿公䜩  其一",
      "content": [
        "五马非从乐，西城念劝功。",
        "翠帷低映水，红斾不胜风。",
        "叶脱青山静，云归碧落空。",
        "淹留尽佳兴，新月渐朦胧。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176635,
      "title": "西谿公䜩  其二",
      "content": [
        "谢守爱山水，军城况不賖。",
        "鱼惊避落叶，鸟倦立浮查。",
        "古柏依冈远，垂杨带岸斜。",
        "秋风吹急管，一曲度荷花。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176636,
      "title": "西湖",
      "content": [
        "佳丽三吴国，湖光荡日华。",
        "鱼惊动苹叶，鷰喜掠杨花。",
        "云过山腰黑，风驱雨脚斜。",
        "烟波遥尽处，仿佛见渔家。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176637,
      "title": "金山寺",
      "content": [
        "香刹冠嵳峨，松门络薜萝。",
        "风清尘不到，岸阔鸟难过。",
        "欲雨江声怒，新晴海气多。",
        "行舟未摇棹，回望隔烟波。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176638,
      "title": "出塞",
      "content": [
        "边草荒无路，星河秋夜明。",
        "卷旗遮远塞，歇马受降城。",
        "霜重征衣薄，风高战鼓鸣。",
        "将军功未厌，士卒不须生。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 176639,
      "title": "古松",
      "content": [
        "摧颓岩壑间，磊落得天顽。",
        "香叶低渐水，余根倒挂山。",
        "白猿窥子落，黄鹤认巢还。",
        "不久应为石，莓苔旧已班。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176640,
      "title": "闻龚伯建下第",
      "content": [
        "文章真长物，堪叹又遗贤。",
        "利器空埋土，灵光久照天。",
        "赵锥犹未出，荆璧会须传。",
        "道在虽穷困，知君不慨然。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176641,
      "title": "故绛城",
      "content": [
        "文公恢霸略，征讨辅周衰。",
        "奕世为盟主，诸侯听会期。",
        "山河表里在，朝市古今移。",
        "欲访虒祁处，乡人亦不知。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176642,
      "title": "题陈秀才园林",
      "content": [
        "剧谈惊满座，音貌独琅然。",
        "可惜郦生老，谁知苏季贤。",
        "青囊世外药，碧幕醉中天。",
        "不佩黄金印，都缘负郭田。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176643,
      "title": "九日登麻蔺坂",
      "content": [
        "客路逢佳节，无欢更益愁。",
        "前山造云日，登陟不因游。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 176644,
      "title": "游延安宿马太博东馆",
      "content": [
        "高馆寂无哗，安闲胜在家。",
        "暮烟凝塞上，堠火落天涯。",
        "坐久笔生冻，夜阑灯作花。",
        "主人意未尽，归路不为賖。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176645,
      "title": "塞上  其一",
      "content": [
        "节物正防秋，关山落叶稠。",
        "霜风壮金鼓，雾气湿旌裘。",
        "未得西羌灭，终为大汉羞。",
        "惭非班定远，弃笔取封侯。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176646,
      "title": "塞上  其二",
      "content": [
        "鸿鴈秋先到，牛羊夕未还。",
        "旌旗遥背水，亭堠远依山。",
        "落日衔西塞，阴烟澹北关。",
        "何时献戎捷，鞍甲一朝闲。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176647,
      "title": "塞上  其三",
      "content": [
        "瀚海秋风至，萧萧木叶飞。",
        "如何逢汉使，犹未寄征衣。",
        "不叹千里远，难甘一信稀。",
        "年年沙漠鴈，随意得南归。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176648,
      "title": "塞上  其四",
      "content": [
        "剑客苍鹰队，将军白虎牙。",
        "分兵逻圁水，纵骑猎鸣沙。",
        "浪有书藏袖，难凭信达家。",
        "不堪闻晓角，吹尽落梅花。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176649,
      "title": "送何济川为庞公使庆阳席上探得冬字",
      "content": [
        "幕府遥三舍，传车乘一封。",
        "忠深轻远道，醉暖失严冬。",
        "圁水犹飞檄，芦阕未灭烽。",
        "贤侯虽喜士，难得久从容。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176650,
      "title": "延安道中作",
      "content": [
        "羁旅兼边思，川原蹀血新。",
        "烟云长带雨，草树不知春。",
        "细水淘沙骨，惊飚转路尘。",
        "今朝见烽火，白首太平人。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176651,
      "title": "鄜州怀聂之美",
      "content": [
        "何言内外家，忧患两如麻。",
        "别泪行三歳，思心各一涯。",
        "海边昏雾雨，塞外惨风沙。",
        "安得云飞术，乘空去不遐。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176652,
      "title": "和张推官同年春阴无绪偶成  其一",
      "content": [
        "澹泊轻云寒不收，未成春雨只添愁。",
        "风烟寂寞几何限，尽入凭高一寸眸。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 176653,
      "title": "和张推官同年春阴无绪偶成  其二",
      "content": [
        "薄寒未去腊才过，春色先知在绿波。",
        "不是宿云能作思，大都王粲自情多。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 176654,
      "title": "归田诗  其一",
      "content": [
        "秋水风波大，嗟嗟未可游。",
        "渔樵自应乐，珪组为谁忧。",
        "直木知先伐，明珠忌暗投。",
        "果然钩可曲，不惜取封侯。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176655,
      "title": "归田诗  其二",
      "content": [
        "绂冕诚虚器，簪裳悉畏途。",
        "触机身未保，好直道先孤。",
        "甔石曾何有，田园浪更无。",
        "可能推两耜，沮溺共为徒。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176656,
      "title": "归田诗  其三",
      "content": [
        "圣哲虽云远，遗文幸未亡。",
        "沈冥观礼乐，仿佛见虞黄。",
        "鸡黍延三迳，琴书乐一堂。",
        "逍遥名教内，富贵亦微茫。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176657,
      "title": "归田诗  其四",
      "content": [
        "松菊陶潜宅，蓬蒿仲蔚家。",
        "行游筇杖瘦，啸傲幅巾斜。",
        "屋小疏茅覆，门深乱柳遮。",
        "村童迎客至，竹箒扫桃花。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176658,
      "title": "归田诗  其五",
      "content": [
        "桑柘绿无际，田间戴胜飞。",
        "清醪迎社熟，鸣雉向春肥。",
        "执耒时将急，衔杯日渐稀。",
        "四邻能共乐，招饮莫相违。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176659,
      "title": "春晓",
      "content": [
        "钟漏初传晓，满窗风雨寒。",
        "东冈行可种，欹枕不成安。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 176660,
      "title": "咏史  其一",
      "content": [
        "不事王侯者，翛然郑子真。",
        "开田谷口美，荷锸白渠春。",
        "德化移乡曲，声光动搢绅。",
        "一时钟鼎贵，磨灭彼何人。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176661,
      "title": "咏史  其二",
      "content": [
        "延陵腰利剑，上国使初通。",
        "待我周游徧，逢君遣奠终。",
        "晶荧系高树，萧瑟动寒风。",
        "谁敢欺生死，苍苍照尔衷。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176662,
      "title": "咏史  其三",
      "content": [
        "春风三阁上，珠翠日纷纷。",
        "乐饮陶江月，清歌遏海云。",
        "醉中失陈国，梦里入隋军。",
        "玉树庭花曲，凄凉不可闻。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176663,
      "title": "秋夜望月",
      "content": [
        "万里氛昏歇，金波秋更明。",
        "星连河渚暗，风绕桂枝生。",
        "𫛛鹊临华馆，新丰落故城。",
        "古今佳赏尽，殊自有余清。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176664,
      "title": "汉宫词",
      "content": [
        "苜蓿花犹短，昌蒲叶未齐。",
        "更衣过柏谷，走马宿棠棃。",
        "逆旅聊怀玺，田间共鬭鸡。",
        "犹思饮云露，高举出虹蜺。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176665,
      "title": "读汉武帝纪",
      "content": [
        "方士陈仙术，飘飘意不疑。",
        "云浮仲山鼎，风降寿宫祠。",
        "上药行当就，殊庭庶可期。",
        "蓬莱何日返，五利不吾欺。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176666,
      "title": "鹭鸶",
      "content": [
        "清闲自合无忧累，白髪何因更飒然。",
        "遥望孤飞下秋水，雪花一片落晴天。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 176667,
      "title": "待诏  其一",
      "content": [
        "京洛风尘里，相逢眼尽青。",
        "故人多密近，谁诵四隅铭。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 176668,
      "title": "待诏  其二",
      "content": [
        "待诏久公车，囊装半已虚。",
        "雄文虽雅丽，未得似相如。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 176669,
      "title": "观僧室画山水",
      "content": [
        "画精禅室冷，方暑久徘徊。",
        "不尽林端雪，长青石上苔。",
        "心闲对岩岫，目浄失尘埃。",
        "坐久清风至，疑从翠涧来。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176670,
      "title": "咏寒士",
      "content": [
        "洋洋泌水侧，蓬室苦萧条。",
        "衣薄难胜夜，厨闲空过朝。",
        "笑谈东郭履，歌诵买臣樵。",
        "但问才何似，无疑卿相遥。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176671,
      "title": "赠外兄吴之才",
      "content": [
        "何须亲始重，友分固非疏。",
        "况复羁孤极，同经忧患余。",
        "晚成应大器，先得类凡鱼。",
        "游衍陪严忌，声华诵子虚。",
        "蒲轮诏枚叔，驷马宠相如。",
        "莫忘西都日，寒窗夜读书。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 176672,
      "title": "九日怀聂之美  其一",
      "content": [
        "钱唐江里扁舟上，别后篱花几度黄。",
        "忧患萦心何缭绕，风光满目尽凄凉。",
        "谁同凿落杯中酒，独系茱茰肘后囊。",
        "可复无书道情素，云间空有鴈南翔。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 176673,
      "title": "九日怀聂之美  其二",
      "content": [
        "太室横山蔽十里，相思空复上高台。",
        "瓮头白酒行当熟，篱下黄花稍复开。",
        "陶令不无同醉兴，孟君况有解嘲才。",
        "欲凭西北高风势，飞度轘辕劝一杯。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 176674,
      "title": "饮吴之才家",
      "content": [
        "京洛相逢设主人，富家鼎食不如贫。",
        "解衣换酒同为乐，知是交情百倍亲。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 176675,
      "title": "晚秋洛中思归东园",
      "content": [
        "不利不名空去国，鴈飞叶落未归来。",
        "秋风肯待主人至，篱下黄花随意开。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 176676,
      "title": "普明寺荷塘上置酒",
      "content": [
        "菡萏飘零水寂寥，败荷疏柳共萧条。",
        "烟斜雨细愁无限，醇酒千分不易消。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 176677,
      "title": "送孟仲习宜君令",
      "content": [
        "合抱生毫末，无为厌小官。",
        "政成心更逸，道胜意常寛。",
        "野迥山形秀，云疏雪意阑。",
        "离杯如不尽，何用御祁寒。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176678,
      "title": "野庙",
      "content": [
        "古庙崩榱在，墙间杂树荒。",
        "依稀设余像，寂寞閟祠堂。",
        "旧日牲豭地，今晨狐兔乡。",
        "英灵如未灭，何以度凄凉。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176679,
      "title": "吕禄庙",
      "content": [
        "赤帝祚四百，徒然诸吕谋。",
        "出游逢友卖，未返见家收。",
        "弊冢昔无记，遗祠今幸留。",
        "士心俱左袒，何怨曲周侯。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176680,
      "title": "雪霁登普贤阁",
      "content": [
        "积雪明朝日，山河坐可分。",
        "崭岩初解冻，片段未归云。",
        "阔望穷人境，高寻俯鴈群。",
        "开门枝鸟散，玉絮堕纷纷。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176681,
      "title": "上郡南三十里有相思亭在太山之麓二水所交平臯之上往来者徒习其名莫详其义庆历甲申歳余适延安过于其下于时夏虏梗边征戍未息窃感东山采薇之义叙其情而愍其劳因作五诗庶几不违周公之指且以释亭之名尔  其一",
      "content": [
        "岭上双流水，犹知会合时。",
        "行人过于此，那得不相思。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 176682,
      "title": "上郡南三十里有相思亭在太山之麓二水所交平臯之上往来者徒习其名莫详其义庆历甲申歳余适延安过于其下于时夏虏梗边征戍未息窃感东山采薇之义叙其情而愍其劳因作五诗庶几不违周公之指且以释亭之名尔  其二",
      "content": [
        "偃蹇登修阪，高侵云日间。",
        "几人征戍客，跋马望家山。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 176683,
      "title": "上郡南三十里有相思亭在太山之麓二水所交平臯之上往来者徒习其名莫详其义庆历甲申歳余适延安过于其下于时夏虏梗边征戍未息窃感东山采薇之义叙其情而愍其劳因作五诗庶几不违周公之指且以释亭之名尔  其三",
      "content": [
        "塞下春寒在，东风雪满须。",
        "河阳机上妇，知我苦辛无。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 176684,
      "title": "上郡南三十里有相思亭在太山之麓二水所交平臯之上往来者徒习其名莫详其义庆历甲申歳余适延安过于其下于时夏虏梗边征戍未息窃感东山采薇之义叙其情而愍其劳因作五诗庶几不违周公之指且以释亭之名尔  其四",
      "content": [
        "柳似妖饶舞，花如烂漫粧。",
        "那堪陇头水，呜咽断人肠。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 176685,
      "title": "上郡南三十里有相思亭在太山之麓二水所交平臯之上往来者徒习其名莫详其义庆历甲申歳余适延安过于其下于时夏虏梗边征戍未息窃感东山采薇之义叙其情而愍其劳因作五诗庶几不违周公之指且以释亭之名尔  其五",
      "content": [
        "空外游丝转，飘扬似妾心。",
        "别来今几日，仿佛近雕阴。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 176686,
      "title": "梅花  其一",
      "content": [
        "从与夫君别，寒花几度春。",
        "坐愁芳树老，况乃鉴中人。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 176687,
      "title": "梅花  其二",
      "content": [
        "塞北为君戍，江南是妾家。",
        "遥知关外雪，只似岭头花。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 176688,
      "title": "梅花  其三",
      "content": [
        "驿使何时发，凭君寄一枝。",
        "陇头人不识，空向笛中吹。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 176689,
      "title": "友人楚孟德过余纵言及神仙余谓之无孟德谓之有伊人也非诞妄者盖有以知之矣然余俗士终疑之故作游仙曲五章以佐戏笑云  其一",
      "content": [
        "神仙谓无还似有，秦汉可怜空白首。",
        "会须一蹑青云梯，与子同袪千古疑。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 176690,
      "title": "友人楚孟德过余纵言及神仙余谓之无孟德谓之有伊人也非诞妄者盖有以知之矣然余俗士终疑之故作游仙曲五章以佐戏笑云  其二",
      "content": [
        "仙术有无终未知，眼看白髪乱如丝。",
        "何时得接浮丘袂，沧海横飞万余里。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 176691,
      "title": "友人楚孟德过余纵言及神仙余谓之无孟德谓之有伊人也非诞妄者盖有以知之矣然余俗士终疑之故作游仙曲五章以佐戏笑云  其三",
      "content": [
        "若士北游穷地角，还食蛤蜊养龟壳。",
        "卢敖尸骨不能飞，今朝九垓何处期。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 176692,
      "title": "友人楚孟德过余纵言及神仙余谓之无孟德谓之有伊人也非诞妄者盖有以知之矣然余俗士终疑之故作游仙曲五章以佐戏笑云  其四",
      "content": [
        "仙家不似人间欢，瑶浆琅菜青玉盘。",
        "乘醉东游憩阳谷，酒瓢闲挂扶桑木。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 176693,
      "title": "友人楚孟德过余纵言及神仙余谓之无孟德谓之有伊人也非诞妄者盖有以知之矣然余俗士终疑之故作游仙曲五章以佐戏笑云  其五",
      "content": [
        "柂师知子能操舟，稳过茫茫沧海流。",
        "白浪驾天千万里，真令挂骨长鲸齿。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 176694,
      "title": "云际亭",
      "content": [
        "高齐杳冥际，迥与世尘违。",
        "席上山河近，天边桑柘微。",
        "人间已飘洒，栋里始纷霏。",
        "草树收残照，逍遥久未归。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176695,
      "title": "和孙器之清风楼",
      "content": [
        "贤侯宴枚马，歌鼓事繁华。",
        "晚吹来千里，清商落万家。",
        "平原转疏雨，远树隔残霞。",
        "宋玉虽能赋，还须念景差。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176696,
      "title": "龙女祠后塘自生荷花数枝与史诚之更相酬和  其一",
      "content": [
        "平湖漠漠芰荷稠，水国芳春不胜秋。",
        "空有棹歌人不见，晚风一曲去悠悠。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 176697,
      "title": "龙女祠后塘自生荷花数枝与史诚之更相酬和  其二",
      "content": [
        "越女行歌纵棹轻，苍茫别浦晚烟凝。",
        "荷花折尽不归去，潋灔扁舟不易胜。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 176698,
      "title": "龙女祠后塘自生荷花数枝与史诚之更相酬和  其三",
      "content": [
        "荷底清涟照绮罗，长安公子旧情多。",
        "踌躇不去知君意，重唱吴音白纻歌。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 176699,
      "title": "龙女祠后塘自生荷花数枝与史诚之更相酬和  其四",
      "content": [
        "贺监家居逸兴饶，枝分鉴水阔容舠。",
        "穿荷宜去邀渔叟，共醉船头半榼醪。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 176700,
      "title": "龙女祠后塘自生荷花数枝与史诚之更相酬和  其五",
      "content": [
        "清江向晚采莲稀，独倚兰舟久未归。",
        "目断可堪人不至，斜风细雨湿罗衣。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 176701,
      "title": "龙女祠后塘自生荷花数枝与史诚之更相酬和  其六",
      "content": [
        "素舸朱篷青竹篙，棹歌风散近还遥。",
        "斜阳借问归何处，家住水村郎姓萧。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 176702,
      "title": "龙女祠后塘自生荷花数枝与史诚之更相酬和  其七",
      "content": [
        "别殿无人梨自芳，玉阶朱槛绕金塘。",
        "馆娃寂寞无西子，羞与吴宫竞晓粧。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 176703,
      "title": "赠楚法曹叔度",
      "content": [
        "夫君能直节，不耻杨曹轻。",
        "道果因时屈，官无当已荣。",
        "松杉虽偃蹇，霜霰苦峥嵘。",
        "会有良工识，终观大器成。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    }
  ],
