{
  "data": [
    {
      "id": 193678,
      "title": "六月二十七日望湖楼醉书五绝  其一",
      "content": [
        "黑云翻墨未遮山，白雨跳珠乱入船。",
        "卷地风来忽吹散，望湖楼下水如天。"
      ],
      "author": {
        "id": 11678,
        "name": "苏轼"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 193679,
      "title": "六月二十七日望湖楼醉书五绝  其二",
      "content": [
        "放生鱼鳖逐人来，无主荷花到处开。",
        "水枕能令山俯仰，风船解与月徘徊。"
      ],
      "author": {
        "id": 11678,
        "name": "苏轼"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 193680,
      "title": "六月二十七日望湖楼醉书五绝  其三",
      "content": [
        "乌菱白芡不论钱，乱系青菰裹绿盘。",
        "忽忆尝新会灵观，滞留江海得加餐。"
      ],
      "author": {
        "id": 11678,
        "name": "苏轼"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 193681,
      "title": "六月二十七日望湖楼醉书五绝  其四",
      "content": [
        "献花游女木兰桡，细雨斜风湿翠翘。",
        "无限芳洲生杜若，吴儿不识楚辞招。"
      ],
      "author": {
        "id": 11678,
        "name": "苏轼"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 193682,
      "title": "六月二十七日望湖楼醉书五绝  其五",
      "content": [
        "未成小隠聊中隠，可得长闲胜暂闲。",
        "我本无家更安往，故乡无此好湖山。"
      ],
      "author": {
        "id": 11678,
        "name": "苏轼"
      },
      "dynasty": {
        "id": 6,
