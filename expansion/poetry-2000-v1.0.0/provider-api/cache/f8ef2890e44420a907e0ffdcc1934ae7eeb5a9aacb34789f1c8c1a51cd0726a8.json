{
  "data": [
    {
      "id": 259089,
      "title": "送卢大理赵侍御祭东岳兼寄孟衮州",
      "content": [
        "东岳昔有事，两臣朝望归。",
        "驿亭开岁酒，斋舍著新衣。",
        "上客钟大理，主人陶武威。",
        "仍随御史马，山路满光辉。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 259090,
      "title": "送皇甫大夫赴浙东",
      "content": [
        "舟师分水国，汉将领秦官。",
        "麾下同心吏，军中囗囗端。",
        "吴门秋露湿，楚驿暮天寒。",
        "豪贵东山去，风流胜谢安。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 259091,
      "title": "送韦秀才",
      "content": [
        "东人相见罢，秋草独归时。",
        "几日孙弘阁，当年谢朓诗。",
        "寒山叶落早，多雨路行迟。",
        "好忆金门步，功名自有期。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 259092,
      "title": "送客一归襄阳二归浔阳",
      "content": [
        "南驱匹马会心期，东望扁舟惬梦思。",
        "熨斗山前春色早，香炉峰顶暮烟时。",
        "空林欲访庞居士，古寺应怀远法师。",
        "两地由来堪取兴，三贤他日幸留诗。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 259093,
      "title": "送故人赴江陵寻庾牧",
      "content": [
        "主人持节拜荆州，走马应从一路游。",
        "斑竹冈连山雨暗，枇杷门向楚天秋。",
        "佳期笑把斋中酒，远意闲登城上楼。",
        "文体此时看又别，吾知小庾甚风流。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 259094,
      "title": "送客水路归陕",
      "content": [
        "相风竿影晓来斜，渭水东流去不赊。",
        "枕上未醒秦地酒，舟前已见陕人家。",
        "春桥杨柳应齐叶，古县棠棃也作花。",
        "好是吾贤佳赏地，行逢三月会连沙。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 259095,
      "title": "送丹阳刘太真",
      "content": [
        "长干道上落花朝，羡尔当年赏事饶。",
        "下筯已怜鹅炙美，开笼不奈鸭媒娇。",
        "春衣晚入青杨巷，细马初过皂荚桥。",
        "相访不辞千里远，西风好借木兰桡。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 259096,
      "title": "送客归江州",
      "content": [
        "东归复得采真游，江水迎君日夜流。",
        "客舍不离青雀舫，人家旧在白鸥洲。",
        "风吹山带遥知雨，露湿荷裳已报秋。",
        "闻道泉明居止近，篮舆相访为淹留。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 259097,
      "title": "题张逸人园林",
      "content": [
        "花源一曲映茅堂，清论闲阶坐夕阳。",
        "麈尾手中毛已脱，蟹螯尊上味初香。",
        "春深黄口传窥树，雨后青苔散点墙。",
        "更道小山宜助赏，呼儿舒簟醉岩芳。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 259098,
      "title": "又题张逸人园林",
      "content": [
        "藏头不复见时人，爱此云山奉养真。",
        "露色点衣孤屿晓，花枝妨帽小园春。",
        "时携幼稚诸峰上，闲濯眉须一水滨。",
        "兴罢归来还对酌，茅檐挂著紫荷巾。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 259099,
      "title": "送刘将军",
      "content": [
        "明光细甲照铔锻，昨日承恩拜虎牙。",
        "胆大欲期姜伯约，功多不让李轻车。",
        "青巾校尉遥相许，墨矟将军莫大夸。",
        "阙下来时亲伏奏，胡尘未尽不为家。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 259100,
      "title": "送郑员外",
      "content": [
        "风流不减杜陵时，五十为郎未是迟。",
        "孺子亦知名下士，乐人争唱卷中诗。",
        "身齐吏部还多醉，心顾尚书自有期。",
        "要路眼青知己在，不应穷巷久低眉。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 259101,
      "title": "寄徐州郑使君",
      "content": [
        "江城五马楚云边，不羡雍容画省年。",
        "才子旧称何水部，使君还继谢临川。",
        "射堂草遍收残雨，官路人稀对夕天。",
        "虽卧郡斋千里隔，与君同见月初圆。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 259102,
      "title": "送襄垣王君归南阳别墅",
      "content": [
        "都门霁后不飞尘，草色萋萋满路春。",
        "双兔坡东千室吏，三鸦水上一归人。",
        "愁眠客舍衣香满，走渡河桥马汗新。",
        "少妇比来多远望，应知蟢子上罗巾。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 259103,
      "title": "送王诞渤海使赴李太守行营",
      "content": [
        "少年结客散黄金，中岁连兵扫绿林。",
        "渤海名王曾折首，汉家诸将尽倾心。",
        "行人去指徐州近，饮马回看泗水深。",
        "喜见明时钟太尉，功名一似旧淮阴。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 259104,
      "title": "送王少府归杭州",
      "content": [
        "归舟一路转青苹，更欲随潮向富春。",
        "吴郡陆机称地主，钱塘苏小是乡亲。",
        "葛花满把能消酒，栀子同心好赠人。",
        "早晚重过鱼浦宿，遥怜佳句箧中新。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 259105,
      "title": "赠王随",
      "content": [
        "青云自致晚应遥，朱邸新婚乐事饶。",
        "饮罢更怜双袖舞，试来偏爱五花骄。",
        "帐里炉香春梦晓，堂前烛影早更朝。",
        "更说毬场新雨歇，王孙今日定相邀。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 259106,
      "title": "同题仙游观",
      "content": [
        "仙台下见五城楼，风物凄凄宿雨收。",
        "山色遥连秦树晚，砧声近报汉宫秋。",
        "疎松影落空坛静，细草香闲小洞幽。",
        "何用别寻方外去，人间亦自有丹丘。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 259107,
      "title": "访王起居不遇留赠",
      "content": [
        "双龙阙下拜恩初，天子令君注起居。",
        "载笔已齐周右史，论诗更事谢中书。",
        "行闻漏滴随金仗，入对炉烟侍玉除。",
        "贺客自知来独晚，青骊不见意何如。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 259108,
      "title": "送刘评事赴广州使幕",
      "content": [
        "征南官属似君稀，才子当今刘孝威。",
        "蛮府参军趋传舍，交州刺史拜行衣。",
        "前临瘴海无人过，却望衡阳少雁飞。",
        "为报苍梧云影道，明年早送客帆归。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 259109,
      "title": "送冷朝阳还上元",
      "content": [
        "青丝䋏引木兰船，名遂身归拜庆年。",
        "落日澄江乌榜外，秋风疎柳白门前。",
        "桥通小市家林近，山带平湖野寺连。",
        "别后依依寒食里，共君携手在东田。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 259110,
      "title": "送高别驾归汴州",
      "content": [
        "信陵门下识君偏，骏马轻裘正少年。",
        "寒雨送归千里外，东风沈醉百花前。",
        "身随玉帐心应惬，官佐龙符势又全。",
        "久客未知何计是，参差去借汶阳田。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 259111,
      "title": "送康洗马归滑州",
      "content": [
        "腰佩雕弓汉射声，东归衔命见双旌。",
        "青丝玉勒康侯马，孟水金堤滑伯城。",
        "腊雪夜看宜纵饮，寒芜昼猎不妨行。",
        "怀君又隔千山远，别后春风百草生。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 259112,
      "title": "寄上田仆射",
      "content": [
        "家封薛县异诸田，报主荣亲义两全。",
        "仆射临戎谢安石，大夫持宪杜延年。",
        "金装昼出罗千骑，玉案晨飡直万钱。",
        "应念一身留阙下，阖门遥寄鲁西偏。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 259113,
      "title": "送王光辅归青州兼寄储侍郎",
      "content": [
        "几回奏事建章宫，圣主偏知汉将功。",
        "身著紫衣趋阙下，口衔丹诏出关东。",
        "蝉声驿路秋山里，草色河桥落照中。",
        "远忆故人沧海别，当年好跃五花骢。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 259114,
      "title": "宴杨驸马山池",
      "content": [
        "垂杨拂岸草茸茸，绣户帘前花影重。",
        "鲙下玉盘红缕细，酒开金瓮绿醅浓。",
        "中朝驸马何平叔，南国词人陆士龙。",
        "落日泛舟同醉处，回潭百丈映千峰。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 259115,
      "title": "送长史李少府入蜀",
      "content": [
        "行行独出故关迟，南望千山无尽期。",
        "见舞巴童应暂笑，闻歌蜀道又堪悲。",
        "孤城晚闭清江上，匹马寒嘶白露时。",
        "别后此心君自见，山中何事不相思。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 259116,
      "title": "送客还江东",
      "content": [
        "不妨高卧顺流归，五两行看扫翠微。",
        "鼯鼠夜喧孤枕近，䴔䴖晓避客船飞。",
        "一壶先醉桃枝簟，百和初熏苎布衣。",
        "君到新林江口泊，吟诗应赏谢玄晖。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 259117,
      "title": "寄令狐尚书",
      "content": [
        "立身荣贵复何如，龙节红旗从板舆。",
        "妙略多推霍骠骑，能文独见沈尚书。",
        "临风高会千门帐，映水连营百乘车。",
        "他日感恩慙未报，举家犹似涸池鱼。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 259118,
      "title": "扈从郊庙因呈两省诸公",
      "content": [
        "丹墀列士主恩同，厩马翩翩出汉宫。",
        "奉引乘舆金仗里，亲尝赐食玉盘中。",
        "昼趋行殿旌门北，夜宿斋房刻漏东。",
        "明日驾回承雨露，齐将万岁及春风。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 259119,
      "title": "送端州冯使君",
      "content": [
        "白皙风流似有须，一门豪贵领苍梧。",
        "三峰亭暗橘边宿，八桂林香节下趋。",
        "玉树群儿争翠羽，金盘少妾拣明珠。",
        "怀君乐事不可见，騣马翩翩新虎符。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 259120,
      "title": "送王府张参军附学及第东归",
      "content": [
        "邻家不识鬬鸡翁，闭户能齐隐者风。",
        "顾步曾为小山客，成名因事大江公。",
        "一身千里寒芜上，单马重裘腊月中。",
        "寂寂故园行见在，暮天残雪洛城东。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 259121,
      "title": "送齐明府赴东阳",
      "content": [
        "绿丝帆𫄴桂为樯，过尽淮山楚水长。",
        "万里移家背春谷，一官行府向东阳。",
        "风流好爱杯中物，豪荡仍欺陌上郎。",
        "别后心期如在眼，猨声烟色树苍苍。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 259122,
      "title": "鲁中送从事归荥阳",
      "content": [
        "故园衰草带荥波，岁晚知如君思何。",
        "轻橐归时鲁缟薄，寒衣缝处郑绵多。",
        "万人都督鸣骝送，百里邦君枉骑过。",
        "累路尽逢知己在，曾无对酒不高歌。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 259123,
      "title": "衮州送李明府使苏州便赴告期",
      "content": [
        "莫言水国去迢迢，白马吴门见不遥。",
        "枫树林中经楚雨，木兰舟上蹋江潮。",
        "空山古寺千年石，草色寒隄百尺桥。",
        "早晚卢家兰室在，珊瑚玉佩彻青霄。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 259124,
      "title": "送田明府归终南别业",
      "content": [
        "故园此日多心赏，窗下泉流竹外云。",
        "近馆应逢沈道士，比邻自识卞田君。",
        "离宫树影登山见，上苑钟声过雪闻。",
        "相劝早移丹凤阙，不须常恋白鸥群。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 259125,
      "title": "家兄自山南罢归献诗叙事",
      "content": [
        "时辈已争先，吾兄未著鞭。",
        "空嗟镊须日，犹是屈腰年。",
        "不以殊方远，仍论水地偏。",
        "襄橙随客路，汉竹引归船。",
        "云木巴东峡，林泉岘北川。",
        "池余骑马处，宅似卧龙边。",
        "夜簟千峰月，朝窗万井烟。",
        "朱荷江女院，青稻楚人田。",
        "县舍多潇洒，城楼入醉眠。",
        "黄苞柑正熟，红缕鲙仍鲜。",
        "坐厌牵丝倦，因从解绶旋。",
        "初辞五斗米，唯奉一囊钱。",
        "室好生虚白，书耽守太玄。",
        "枥中嘶欵段，阶下引潺湲。",
        "落照渊明柳，春风叔夜弦。",
        "绛纱儒客帐，丹诀羽人篇。",
        "雅论承安石，新诗与惠连。",
        "兴清湖见底，襟豁雾开天。",
        "魏阙心犹系，周才道岂捐。",
        "一丘无自逸，三府会招贤。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 259126,
      "title": "奉送王相公缙赴幽州巡边",
      "content": [
        "黄阁开帷幄，丹墀侍冕旒。",
        "位高汤左相，权总汉诸侯。",
        "不改周南化，仍分赵北忧。",
        "双旌过易水，千骑入幽州。",
        "塞草连天暮，边风动地秋。",
        "无因随远道，结束佩吴钩。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 259127,
      "title": "寄赠虢州张参军",
      "content": [
        "三十事诸侯，贤豪冠北州。",
        "桃花迎骏马，苏合染轻裘。",
        "观妓将军第，题诗关尹楼。",
        "青林朝送客，绿屿晚回舟。",
        "好栗分通子，名香赠莫愁。",
        "洗杯新酒熟，把烛故人留。",
        "百雉归云过，千峰宿雨收。",
        "蒹葭露下晚，菡萏水中秋。",
        "忆昨陪行乐，常时接献酬。",
        "佳期虽雾散，惠问亦川流。",
        "开卷酲堪解，含毫思苦抽。",
        "无因达情意，西望日悠悠。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 259128,
      "title": "送李中丞赴商州",
      "content": [
        "五马渭桥东，连嘶逐晓风。",
        "当年紫髯将，他日黑头公。",
        "不异金吾宠，兼齐玉帐雄。",
        "闭营春雪下，吹角暮山空。",
        "香麝松阴里，寒猨黛色中。",
        "郡斋多赏事，好与故人同。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 259129,
      "title": "汉宫曲二首 一",
      "content": [
        "骏马绣障泥，红尘扑四蹄。",
        "归时何太晚，日照杏花西。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 259130,
      "title": "汉宫曲二首 二",
      "content": [
        "绣幕珊瑚钩，春开翡翠楼。",
        "深情不肯道，娇倚钿箜篌。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 259131,
      "title": "陪孟都督祭岳途中有赠",
      "content": [
        "封疆七百里，禄秩二千石。",
        "拥节祠太山，寒天霜草白。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 259132,
      "title": "宿甑山",
      "content": [
        "山中今夜何人，阙下当年近臣。",
        "青琐应须早去，白云何用相亲。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 259133,
      "title": "别甑山",
      "content": [
        "一身趋侍丹墀，西路翩翩去时。",
        "惆怅青山绿水，何年更是来期。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 259134,
      "title": "送陈明府赴淮南",
      "content": [
        "年华近逼清明，落日微风送行。",
        "黄鸟绵蛮芳树，紫骝躞蹀东城。",
        "花间一杯促膝，烟外千里含情。",
        "应渡淮南信宿，诸侯拥斾相迎。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 259135,
      "title": "送客知鄂州",
      "content": [
        "江口千家带楚云，江花乱点雪纷纷。",
        "春风落日谁相见，青翰舟中有鄂君。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 259136,
      "title": "寒食",
      "content": [
        "春城无处不飞花，寒食东风御柳斜。",
        "日暮汉宫传蜡烛，轻烟散入五侯家。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 259137,
      "title": "羽林骑",
      "content": [
        "骏马牵来御柳中，鸣鞭欲向渭桥东。",
        "红蹄乱蹋春城雪，花颔骄嘶上苑风。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 259138,
      "title": "看调马",
      "content": [
        "鸳鸯赭白齿新齐，晚日花中散碧蹄。",
        "玉勒斗回初喷沫，金鞭欲下不成嘶。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 259139,
      "title": "寄赠衡州杨使君",
      "content": [
        "湘竹斑斑湘水春，衡阳太守虎符新。",
        "朝来笑向归鸿道，早晚南飞见主人。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 259140,
      "title": "宿石邑山中",
      "content": [
        "浮云不共此山齐，山霭苍苍望转迷。",
        "晓月暂飞高树里，秋河隔在数峰西。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 259141,
      "title": "江南曲",
      "content": [
        "长乐花枝雨点销，江城日暮好相邀。",
        "春楼不闭葳蕤锁，绿水回通宛转桥。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 259142,
      "title": "赠张千牛",
      "content": [
        "蓬莱阙下是天家，上路新回白鼻䯄。",
        "急管昼催平乐酒，春衣夜宿杜陵花。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 259143,
      "title": "汉宫曲二首 一",
      "content": [
        "五柞宫中过腊看，万年枝上雪花残。",
        "绮窗夜闭玉堂静，素绠朝穿金井寒。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 259144,
      "title": "汉宫曲二首 二",
      "content": [
        "家在长陵小市中，珠帘绣户对春风。",
        "君王昨日移仙仗，玉辇迎将入汉宫。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 259145,
      "title": "赠李翼",
      "content": [
        "王孙别舍拥朱轮，不羡空名乐此身。",
        "门外碧潭春洗马，楼前红烛夜迎人。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 259146,
      "title": "少年行",
      "content": [
        "千点斓斒玉勒骢，青丝结尾绣缠騣。",
        "鸣鞭晓出章台路，叶叶春衣杨柳风。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 259147,
      "title": "题玉真观李秘书院",
      "content": [
        "白云斜日影深松，玉宇瑶坛知几重。",
        "把酒题诗人散后，华阳洞里有疎钟。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 259148,
      "title": "送客之潞府",
      "content": [
        "官柳青青匹马嘶，回风暮雨入铜鞮。",
        "佳期别在春山里，应是人蓡五叶齐。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 259149,
      "title": "送客贬五溪",
      "content": [
        "南过猨声一逐臣，回看秋草泪霑巾。",
        "寒天暮雪空山里，几处蛮家是主人。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 259150,
      "title": "送齐山人归长白山",
      "content": [
        "旧事仙人白兔公，掉头归去又乘风。",
        "柴门流水依然在，一路寒山万木中。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 259151,
      "title": "寄裴郓州",
      "content": [
        "乌纱灵寿对秋风，怅望浮云济水东。",
        "官树阴阴铃阁暮，州人转忆白头翁。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 259152,
      "title": "梁城赠一二同幕",
      "content": [
        "五营河畔列旌旗，吹角鸣鼙日暮时。",
        "曾是信陵门下客，两回相吊不胜悲。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 259153,
      "title": "河上寄故人",
      "content": [
        "河流晓天，濮水清烟。",
        "日暖昆吾台上，春深颛顼城边。",
        "莺声乱啁鹄囗，花片细点龙泉。",
        "西望情人早至，犹应得醉芳年。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 259154,
      "title": "留题宁川香盖寺壁",
      "content": [
        "爱远登高尘眼开。",
        "为怜萧寺上经台，山川谁识龙蛇蛰。",
        "天地自迎风雨来，柳放寒条秋已老。",
        "雁摇孤翼暮空回，何人会得其中事。",
        "又被残花落日催。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 259155,
      "title": "寄柳氏",
      "content": [
        "章台柳，章台柳，颜色青青今在否？",
        "纵使长条似旧垂，也应攀折他人手。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298378,
      "title": "章台柳",
      "content": [
        "章台柳，章台柳，往日依依今在否？",
        "纵使长条似旧垂，也应攀折他人手。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 300843,
      "title": "秋斋（题拟）",
      "content": [
        "山月皎如昼，霜风时动竹。",
        "夜半鸟惊栖，窗间人独宿。",
        "（见《永乐大典》卷二五三九「七皆」「秋斋」条〖三函三十册〗《全唐诗所未收》。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 300844,
      "title": "河上寄故人",
      "content": [
        "河流杳霭晓天，濮水黯澹秋烟。",
        "日暖昆吾台上，春深颛顼城边。",
        "莺声乱鸣鸿塞，花片细点龙泉。",
        "西望情人早至，尤应得醉芳年。",
        "（按《全唐诗》卷二百四十五有此诗。",
        "惟前半残缺不可句读。",
        "此见《永乐大典》卷三○○五「九真」「人」字〖五函四十二册〗。",
        "完整可读，故录存之。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 334456,
      "title": "相和歌辞：江南曲",
      "content": [
        "长乐花枝雨点消，江城日暮好相邀。",
        "春楼不闭葳蕤锁，绿水回通宛转桥。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 334949,
      "title": "杂曲歌辞：少年行",
      "content": [
        "千点斓斒喷玉骢，青丝结尾绣缠鬃。",
        "鸣鞭晚出章台路，叶叶春依杨柳风。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 344493,
      "title": "褚主簿宅会毕庶子钱员外郎使君",
      "content": [
        "开瓮腊酒熟，主人心赏同。",
        "斜阳疏竹上，残雪乱天中。",
        "更喜宣城印，朝廷与谢公。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 344496,
      "title": "祭岳回重赠孟都督",
      "content": [
        "封作天齐王，清祠太山下。",
        "鲁公秋赛毕，晓日回高驾。",
        "从骑尽幽并，同人皆沈谢。",
        "自矜文武足，一醉寒溪夜。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 344500,
      "title": "送客之江宁",
      "content": [
        "春流送客不应赊，南入徐州见柳花。",
        "朱雀桥边看淮水，",
        "楚云朝下石头城，江燕双飞瓦棺寺。",
        "吴士风流甚可亲，"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 344501,
      "title": "送山阴姚丞携妓之任兼寄山阴苏少府",
      "content": [
        "东风香草路，南客心容与。",
        "白皙吴王孙，青蛾柳家女。",
        "都门数骑出，河口片帆举。",
        "夜簟眠橘洲，春衫傍枫屿。",
        "山阴政简甚从容，到罢唯求物外踪。",
        "落日花边剡溪水，",
        "加餐共爱鲈鱼肥，醒酒仍怜甘蔗熟。",
        "知君炼思本清新，"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 344502,
      "title": "和高平朱参军思归作",
      "content": [
        "髯参军，髯参军，身为北州吏，心寄东山云。",
        "坐见萋萋芳草绿。",
        "遥思往日晴江曲。",
        "刺船频向剡中回，",
        "狂歌好爱陶彭泽，佳句唯称谢法曹。",
        "平生乐事多如此，"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 344503,
      "title": "赠别成明府赴剑南",
      "content": [
        "朝为三室印，晚为三蜀人。",
        "遥知下车日，正及巴山春。",
        "县道橘花里，驿流江水滨。",
        "公门辄无事，赏地能相亲。",
        "解衣初醉绿芳夕，应采蹲鸱荐佳客。",
        "霁水远映西川时，"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 344504,
      "title": "送孙泼赴云中",
      "content": [
        "黄骢少年舞双戟，目视旁人皆辟易。",
        "百战能夸陇上儿，",
        "敲石军中传夜火，斧冰河畔汲朝浆。",
        "前锋直指阴山外，"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 344505,
      "title": "送客还江东",
      "content": [
        "还家不落春风后，数日应沽越人酒。",
        "池畔花深斗鸭栏，",
        "把手闲歌香橘下，空山一望鹧鸪飞。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 344506,
      "title": "送夏侯侍郎",
      "content": [
        "元戎车右早飞声，御史府中新正名。",
        "翰墨已齐钟大理，",
        "前路应留白玉台，行人辄美黄金络。",
        "使君下马爱瀛洲，",
        "公庭日夕罗山翠，功遂心闲无一事。",
        "移书或问岛边人，",
        "浮云飞鸟两相忘，他日依依城上楼。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 344507,
      "title": "送李湜下第归卫州便游河北",
      "content": [
        "莫嗟太常屈，便入苏门啸。",
        "里在应未迟，勿作我身料。",
        "轻云日下不成阴，出对流芳搅别心。",
        "万雉城东春水阔，",
        "佳期纵得上宫游，旅食还为北邙客。",
        "路出司州胜景长，",
        "屡道主人多爱士，何辞策马千余里。",
        "高谭魏国访先生，",
        "有钱莫向河间用，载笔须来阙下游。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 344508,
      "title": "张山人草堂会王方士",
      "content": [
        "屿花晚，山日长，蕙带麻襦食草堂。",
        "一片水光飞入户，"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 344509,
      "title": "送蓚县刘主簿楚",
      "content": [
        "起家得事平原侯，晚出都门辞旧游。",
        "草色连绵几千里，",
        "邺下淹留佳赏新，群公旧日心相亲。",
        "金盘晓鲙朱衣鲋，",
        "寒水浮瓜五月时，把君衣袖长河曲。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 344510,
      "title": "题玉山观禅师兰若",
      "content": [
        "玉山宴坐移年月，锡杖承恩诣丹阙。",
        "先朝亲与会龙华，",
        "禅床久卧虎溪水，兰若初开凤城里。",
        "不出嚣尘见远公，",
        "掖垣挥翰君称美，远客陪游问真理。",
        "薄宦深知误此心，"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 344511,
      "title": "赠别上元主簿张著",
      "content": [
        "上书一见平津侯，剑笏斜齐秣陵尉。",
        "朝垂绶带迎远客，",
        "回船对酒三生渚，系马焚香五愿祠。",
        "日日澄江带山翠，",
        "风流才调爱君偏，此别相逢定几年。",
        "惆怅浮云迷远道，"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 344512,
      "title": "别汜水县尉",
      "content": [
        "未央宫殿金开钥，诏引贤良卷珠箔。",
        "花间赐食近丹墀，",
        "谷永直言身不顾，郤诜高第转名香。",
        "绿槐阴阴出关道，",
        "五侯客舍偏留宿，一县人家争看归。",
        "南向千峰北临水，",
        "自怜寂寞会君稀，犹著前时博士衣。",
        "我欲低眉问知己，"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 344513,
      "title": "别李明府",
      "content": [
        "宠光五世腰青组，出入珠宫引箫鼓。",
        "醉舞雄王玳瑁床，",
        "罗山道士请人送，林邑使臣调象骑。",
        "爱君一身游上国，",
        "五侯焦石烹江笋，千户沉香染客衣。",
        "别后想君难可见，"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 344514,
      "title": "送中兄典邵州",
      "content": [
        "官骑连西向楚云，朱轩出饯昼纷纷。",
        "百城兼领安南国，",
        "玉颜送酒铜鞮歌，金管留人石头宿。",
        "北雁初回江燕飞，",
        "百事无留到官后，重门寂寂垂高柳。",
        "零陵过赠石香溪，",
        "他日新诗应见报，还如宣远在安城。"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 344515,
      "title": "送万巨",
      "content": [
        "汉相见王陵，扬州事张禹。",
        "风帆木兰楫，水国莲花府。",
        "百丈清江十月天，寒城鼓角晓钟前。",
        "金炉促膝诸曹吏，",
        "好逢南苑看人归，也向西池留客醉。",
        "高柳垂烟橘带霜，",
        "夫子前年入朝后，高名籍籍时贤口。",
        "共怜诗兴转清新，"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 344516,
      "title": "送巴州杨使君",
      "content": [
        "白云县北千山口，青岁欲开残雪后。",
        "前驱锦带鱼皮鞮，",
        "愁看野马随官骑，笑取秦人带客旗。",
        "使者下车忧疾苦，"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 344517,
      "title": "送王侍御赴江西兼寄李袁州",
      "content": [
        "中朝理章服，南国随旌旆。",
        "腊酒湘城隅，春衣楚江外。",
        "垂帘白角簟，下箸鲈鱼鲙。",
        "雄笔佐名公，虚舟应时辈。",
        "按俗承流几路清，平明山霭春江云。",
        "湓城诗赠鱼司马，",
        "井上铜人行见无，湖中石燕飞应尽。",
        "礼门前直事仙郎，"
      ],
      "author": {
        "id": 795,
        "name": "韩翃"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 344518,
      "title": "寄雍丘窦明府",
      "content": [
        "少年结绶骋金羁，许下如看琼树枝。",
        "入里亲过朗陵伯，",
        "时辈宁将白笔期，高流伫向丹霄见。",
        "何事翻飞不及群，",
        "中岁胡尘静如扫，一官又罢行将老。",
        "薛公荐士得君初，",
        "□□□□□□□，□出重门烟树里。",
        "感物吟诗对暮天，",
        "独坐不堪朝与夕，高风萧索乱蝉悲。"
      ],
