{
  "data": [
    {
      "id": 32873,
      "title": "留樊亭三日王觉民检详日携酒来饮海棠下比去花亦衰矣二首  其二",
      "content": [
        "石卫尉家锦步障，移在樊家园馆中。",
        "醉到花残呼马去，聊将侠气压春风。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 32874,
      "title": "柳林酒家小楼",
      "content": [
        "桃花如烧酒如油，缓辔郊原当出游。",
        "微倦放教成午梦，宿酲留得伴春愁。",
        "远途始悟乾坤大，晚节偏惊岁月遒。",
        "记取晴明果州路，半天高柳小青楼。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32875,
      "title": "南池",
      "content": [
        "二月莺花满阆中，城南搔首立衰翁。",
        "数茎白发愁无那，万顷苍池事已空。",
        "陂复岂惟民食足，渠成终助霸图雄。",
        "眼前碌碌谁知此，漫走樷祠乞岁丰。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32876,
      "title": "唐长庆中南池新亭碑在汉高帝庙侧亭已失所在矣",
      "content": [
        "池废新亭亦已无，遗碑半灭卧春芜。",
        "文章绮靡虽非古，今代词人不办渠。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 32877,
      "title": "闻杜鹃戏作绝句",
      "content": [
        "半世羁游厌路岐，凭鞍日日数归期。",
        "劳君树杪丁寜语，似劝饥人食肉糜。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 32878,
      "title": "鼓楼铺醉歌",
      "content": [
        "书生迫饥寒，一饱轻三巴。",
        "三巴未云已，北首趋褒斜。",
        "匆匆出门去，裘马不复华。",
        "短帽障赤日，烈风吹黄沙。",
        "俶装先晨鸡，投鞭后昏鸦。",
        "壮哉利阆间，崖谷何谽谺。",
        "地荒多牧卒，往往闻芦笳。",
        "我行春未动，原野今无花。",
        "稚子入旅梦，挽须劝还家。",
        "起坐不能寐，愁肠如转车。",
        "四方丈夫事，行矣勿咨嗟。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 32879,
      "title": "登慧照寺小阁",
      "content": [
        "少年富贵已悠悠，老大功名定有不。",
        "岁月消磨阅亭传，山川辽邈弊衣裘。",
        "杀身有地初非惜，报国无时未免愁。",
        "局促每思舒望眼，虽非吾土强登楼。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32880,
      "title": "春雨",
      "content": [
        "江头一夜雨，晓路无新花。",
        "我今为陈人，感此重叹嗟。",
        "羲和挟两曜，疾走不可遮。",
        "古今俛仰间，那暇惜物华。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 32881,
      "title": "风雨中过龙洞阁",
      "content": [
        "飘然醉袖怒人扶，个里何曾有畏涂。",
        "卷地黑风吹惨澹，半天朱阁插虚无。",
        "阑边归鹤如争捷，云表飞仙定可呼。",
        "莫怪衰翁心胆壮，此身元是一枯株。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32882,
      "title": "驿舍海棠已过有感",
      "content": [
        "凄凉古驿官道傍，朱门沈沈春日长。",
        "暄妍光景老海棠，颠风吹花满空廊。",
        "物生荣顇固其常，惜哉无与持一觞。",
        "游蜂戏蝶空自忙，岂知美人在西厢。",
        "我虽已老犹能狂，𥩟立为尔悲容光。",
        "盛时不遇诚可伤，零落逢知更断肠。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 32883,
      "title": "筹笔驿",
      "content": [
        "运筹陈迹故依然，想见旌旗驻道边。",
        "一等人间管城子，不堪谯叟作降牋。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 32884,
      "title": "嘉川铺遇小雨景物尤奇",
      "content": [
        "一春客路厌风埃，小雨山行亦乐哉。",
        "危栈巧依青嶂出，飞花并下绿岩来。",
        "面前云气翔孤鳯，脚底江声转疾雷。",
        "堪笑书生轻性命，每逢险处更徘徊。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32885,
      "title": "老君洞",
      "content": [
        "丹鳯楼头语未终，崎岖蜀道复相逢。",
        "太清宫阙俱煨烬，岂亦南来避贼锋。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 32886,
      "title": "大安病酒留半日王守复来招不往送酒解酲因小饮江月馆",
      "content": [
        "江驿春酲半日留，更烦送酒为扶头。",
        "柳花漠漠嘉陵岸，别是天涯一段愁。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 32887,
      "title": "金牛道中遇寒食",
      "content": [
        "乍换春衫一倍轻，况逢寒食十分晴。",
        "莺穿驿树惺愡语，马过溪桥蹀躞行。",
        "画柱彩绳喧笑乐，艳粧丽服角鲜明。",
        "谁知此日金牛道，非复当时铁马声。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32888,
      "title": "晓发金牛",
      "content": [
        "客枕何时穏，匆匆又束装。",
        "快晴生马影，新暖坼花房。",
        "沮水春流绿，嶓山晓色苍。",
        "阿瞒狼狈地，千古有遗伤。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 32889,
      "title": "山南行",
      "content": [
        "我行山南已三日，如绳大路东西出。",
        "平川沃野望不尽，麦陇青青桑郁郁。",
        "地近函秦气俗豪，秋千蹴鞠分朋曹。",
        "苜蓿连云马蹄健，杨柳夹道车声高。",
        "古来歴歴兴亡处，举目山川尚如故。",
        "将军坛上冷云低，丞相祠前春日暮。",
        "国家四纪失中原，师出江淮未易吞。",
        "会看金鼓从天下，却用关中作本根。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 32890,
      "title": "南郑马上作",
      "content": [
        "南郑春残信马行，通都气象尚峥嵘。",
        "迷空游絮凭陵去，曵线飞鸢跋扈鸣。",
        "落日断云唐阙废，淡烟芳草汉坛平。",
        "犹嫌未豁胸中气，目断南山天际横。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32891,
      "title": "和高子长参议道中二绝  其一",
      "content": [
        "梁州四月晚莺啼，共忆扁舟罨画谿。",
        "莫作世间儿女态，明年万里驻安西。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 32892,
      "title": "和高子长参议道中二绝  其二",
      "content": [
        "丰年食少厌儿啼，觅得微官落五谿。",
        "大似无家老禅衲，打包还度栈云西。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 32893,
      "title": "次韵张季长题龙洞",
      "content": [
        "我昔谒紫皇，翳鳯骖虬龙。",
        "俯不见尘世，浩浩万里空。",
        "谪堕尚远游，忽到汉始封。",
        "西望接蜀道，北顾连秦中。",
        "壮哉形胜区，有此蜿蜒宫。",
        "雷霆自鞺鞳，环玦亦璁珑。",
        "石屋如建章，万户交相通。",
        "来者各有得，尽取知无从。",
        "凭高三叹息，自古几英雄。",
        "老我文字衰，挥毫看诸公。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 32894,
      "title": "次韵子长题吴太尉云山亭",
      "content": [
        "参谋健笔落纵横，太尉清罇赏快晴。",
        "文雅风流虽可爱，关中遗虏要人平。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 32895,
      "title": "送刘戒之东归",
      "content": [
        "去国三年恨未平，东城况复送君行。",
        "难凭魂梦寻言笑，空向除书见姓名。",
        "残日半竿斜谷路，西风万里玉关情。",
        "兰台粉署朝回晚，肻记麤官数寄声。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32896,
      "title": "周元吉蟠室诗",
      "content": [
        "天下有广居，非阿房建章。",
        "賔饯日及月，阖辟阴与阳。",
        "山川坦然平，何者为藩墙。",
        "孔公暨瞿聃，同坐此道塲。",
        "哀哉世日隘，肝胆分界疆。",
        "蹙缩战蜗角，崎岖走羊肠。",
        "周先早得道，所证非复常。",
        "小室古城隅，宛如野僧房。",
        "能容人天众，杂沓来烧香。",
        "三万二千人，各据狮子床。",
        "实际正如此，切忌错商量。",
        "须弥芥子话，今夕当举扬。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 32897,
      "title": "送范西叔赴召二首  其一",
      "content": [
        "天涯流落过重阳，枫叶揺丹已著霜。",
        "衰病强陪莲幕客，凄凉又送石渠郎。",
        "杜陵雁下悲徂岁，笠泽鱼肥梦故乡。",
        "便恐从今长隔濶，旧交新贵例相忘。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32898,
      "title": "送范西叔赴召二首  其二",
      "content": [
        "欲驾征车劝小留，南山南畔更逢秋。",
        "数声过雁催行色，一醆昏灯话别愁。",
        "自昔文章关治道，即今台阁要名流。",
        "白头尚作书痴在，剩乞朱黄与校讐。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32899,
      "title": "寄邓公寿",
      "content": [
        "高标瑶树与琼林，灵府清寒出苦吟。",
        "海内十年求识面，江边一见即论心。",
        "纷纷俗子常成市，亹亹微言孰赏音。",
        "闻道南池梅最早，要君携手试同寻。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32900,
      "title": "简章德茂",
      "content": [
        "殊方邂逅岂无缘，世事多乖复怅然。",
        "造物无情吾辈老，古人不死此心传。",
        "冷云黯黯朝横栈，红叶萧萧夜满船。",
        "个里约君同著句，不应输与灞桥边。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32901,
      "title": "自三泉泛嘉陵至利州",
      "content": [
        "日日邅途处处诗，书生活计绝堪悲。",
        "江云垂地滩风急，一似前年上硖时。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 32902,
      "title": "木瓜铺短歌",
      "content": [
        "鼓楼坡前木瓜铺，岁晚悲辛利州路。",
        "当车礧礧石如屋，百里夷途无十步。",
        "溪桥缺断水啮沙，崖腹崩頺风拔树。",
        "虎狼妥尾择肉食，狐狸竖毛啼日莫。",
        "冢丘短草声窸窣，往往精灵与人遇。",
        "我生胡为忽在此，正坐一饥忘百虑。",
        "五更出门寒裂面，半夜燎衣泥满袴。",
        "妻孥八月离夔州，寄书未到今何处。",
        "余年有几百忧集，日夜朱颜不如故。",
        "即今台省盛诸贤，细思寜是儒冠误。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 32903,
      "title": "夜抵葭萌惠照寺寓榻小阁",
      "content": [
        "亭驿驱驰髀肉消，故山归梦愈迢迢。",
        "夜行触尉那能避，旦过随僧不待招。",
        "雨后风云犹惨澹，霜前草木已萧条。",
        "衰迟事事非平日，醉里题诗亦复聊。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32904,
      "title": "太息二首  其一",
      "content": [
        "太息重太息，吾行无终极。",
        "冰霜迫残岁，鸟兽号落日。",
        "秋砧满孤村，枯叶拥破驿。",
        "白头乡万里，堕此虎豹宅。",
        "道边新食人，膏血染草棘。",
        "平生铁石心，忘家思报国。",
        "即今冒九死，家国两无益。",
        "中原久丧乱，志士泪横臆。",
        "切勿轻书生，上马能击贼。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 32905,
      "title": "太息二首  其二",
      "content": [
        "凄凄复凄凄，山路穷攀跻。",
        "仆病卧草间，马困声酸嘶。",
        "脱兔截道奔，穷狖上树啼。",
        "崩湍一何哀，下落万仞谿。",
        "昏黑投孤戍，洗我衣上泥。",
        "下愚不可迁，大惑终身迷。",
        "仕宦十五年，曾不饱糠粞。",
        "客路少睡眠，月白闻号鸡。",
        "欲行且复止，虎来茆叶低。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 32906,
      "title": "阆中作二首  其一",
      "content": [
        "残年作客遍天涯，下马长亭便似家。",
        "三叠凄凉渭城曲，数枝闲澹阆中花。",
        "襞牋授管相逢晚，理鬓熏衣一笑哗。",
        "俱是邯郸枕中梦，坠鞭不用忆京华。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32907,
      "title": "阆中作二首  其二",
      "content": [
        "挽住征衣为濯尘，阆州斋酿绝芳醇。",
        "莺花旧识非生客，山水曾游是故人。",
        "遨乐无时冠巴蜀，语音渐正带咸秦。",
        "平生賸有寻梅债，作意城南看小春。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32908,
      "title": "游锦屏山谒少陵祠堂",
      "content": [
        "城中飞阁连危亭，处处轩窗临锦屏。",
        "涉江亲到锦屏上，却望城郭如丹青。",
        "虚堂奉祠子杜子，眉宇高寒照江水。",
        "古来磨灭知几人，此老至今元不死。",
        "山川寂寞客子迷，草木揺落壮士悲。",
        "文章垂世自一事，忠义凛凛令人思。",
        "夜归沙头雨如注，北风吹船横半渡。",
        "亦知此老愤未平，万窍争号泄悲怒。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 32909,
      "title": "仙鱼铺得仲高兄书",
      "content": [
        "病酒今朝载卧舆，秋云漠漠雨疏疏。",
        "阆州城北仙鱼铺，忽得山阴万里书。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 32910,
      "title": "自阆复还汉中次益昌",
      "content": [
        "北首褒斜又几程，骄云未放十分晴。",
        "马经断栈危无路，风掠枯茆飒有声。",
        "季子貂裘端已弊，吴中菰菜正堪烹。",
        "朱颜渐改功名晚，击筑悲歌一再行。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32911,
      "title": "驿亭小憩遣兴",
      "content": [
        "淡日微云共陆离，曲阑危栈出参差。",
        "老松临道阅千载，杜宇号山连四时。",
        "汉水东流那有极，秦关北望不胜悲。",
        "邮亭下马开孤剑，老大功名颇自期。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32912,
      "title": "再过龙洞阁",
      "content": [
        "天险龙门道，霜清客子游。",
        "一笻缘绝壁，万仞俯洪流。",
        "著脚初疑梦，回头始欲愁。",
        "危身无补国，忠孝两堪羞。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 32913,
      "title": "自笑",
      "content": [
        "自笑谋生事事疏，年来锥与地俱无。",
        "平章春韭秋菘味，拆补天吴紫鳯图。",
        "食肉定知无骨相，珥貂空自诳头颅。",
        "惟余数卷残书在，破箧萧然笑獠奴。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32914,
      "title": "三泉驿舍",
      "content": [
        "残钟断角度黄昏，小驿孤灯早闭门。",
        "霜气峭深摧草木，风声浩荡卷郊原。",
        "故山有约频回首，末路无归易断魂。",
        "短鬓萧萧不禁白，强排幽恨近清罇。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32915,
      "title": "嘉川铺得檄遂行中夜次小柏",
      "content": [
        "黄旗传檄趣归程，急服单装破夜行。",
        "肃肃霜飞当十月，离离斗转欲三更。",
        "酒消顿觉衣裘薄，驿近先看炬火迎。",
        "渭水函关元不远，著鞭无日涕空横。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32916,
      "title": "归次汉中境上",
      "content": [
        "云栈屏山阅月游，马蹄初喜蹋梁州。",
        "地连秦雍川原壮，水下荆杨日夜流。",
        "遗虏孱孱寜远略，孤臣耿耿独私忧。",
        "良时恐作他年恨，大散关头又一秋。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32917,
      "title": "沔阳夜行",
      "content": [
        "夜发沔阳驿，坡陁冈阜重。",
        "月斜欹帽影，霜重湿裘茸。",
        "野岸鸣枯叶，烟林度晓钟。",
        "梁州明日到，一笑解衰容。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 32918,
      "title": "道中累日不肉食至西县市中得羊因小酌",
      "content": [
        "门外倚车辕，頺然就醉昏。",
        "栈余羊绝美，压近酒微浑。",
        "一洗穷边恨，重招去国魂。",
        "客中无晤语，灯烬为谁繁。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 32919,
      "title": "初离兴元",
      "content": [
        "梦里何曾有去来，高城无奈角声哀。",
        "连林秋叶吹初尽，满路寒泥蹋欲开。",
        "笠泽决归犹小憩，锦城未到莫轻回。",
        "炊菰斫脍明年事，却忆斯游亦壮哉。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32920,
      "title": "自兴元赴官成都",
      "content": [
        "平生无远谋，一饱百念已。",
        "造物戏饥之，聊遣行万里。",
        "梁州在何处，飞蓬起孤垒。",
        "凭高望杜陵，烟树略可指。",
        "今朝忽梦破，跋马临漾水。",
        "此生均是客，处处皆可死。",
        "剑南亦何好，小憩聊尔尔。",
        "舟车有通涂，吾行良未止。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 32921,
      "title": "书事",
      "content": [
        "生长江湖狎钓船，跨鞍塞上亦前缘。",
        "云埋废苑呼鹰处，雪暗荒郊射虎天。",
        "醪酒芳醇偏易醉，胡羊肥美了无膻。",
        "杨州虽有东归日，闭置车中定怅然。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32922,
      "title": "雨中过临溪古堠",
      "content": [
        "道边相送驿边迎，水隔山遮似有情。",
        "岁晚无聊莫相笑，君方雨立我泥行。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 32923,
      "title": "南沮水道中",
      "content": [
        "硙舍临湍濑，罾船聚小潭。",
        "山形寒渐瘦，雪意暮方酣。",
        "久客情怀恶，频来道路谙。",
        "家山空怅望，无梦到江南。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 32924,
      "title": "长木晚兴",
      "content": [
        "沮水嶓山名古今，聊将行役当登临。",
        "断桥烟雨梅花瘦，绝磵风霜槲叶深。",
        "末路清愁常衮衮，残冬急景易骎骎。",
        "故巢东望知何处，空羡归鸦解满林。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32925,
      "title": "遣兴",
      "content": [
        "貂裘破弊色凄凉，塞上归来路更长。",
        "老骥嘶鸣常伏枥，寒龟藏缩正支床。",
        "雕零客路新霜鬓，扫洒先师旧草堂。",
        "九折阪头休绝叹，世间何地不羊肠。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32926,
      "title": "长木夜行抵金堆市",
      "content": [
        "夜行长木村，重雾杂零雨。",
        "湿萤粘野蔓，寒犬吠云坞。",
        "道坏交细泉，亭废立遗堵。",
        "时时过农家，灯火照鸣杼。",
        "嗟予独何事，无岁得安处。",
        "即今穷谷中，性命寄豺虎。",
        "三更投小市，买酒慰羁旅。",
        "高咏东山诗，怅望怀往古。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 32927,
      "title": "赴成都泛舟自三泉至益昌谋以明年下三峡",
      "content": [
        "诗酒清狂二十年，又摩病眼看西川。",
        "心如老骥常千里，身似春蚕已再眠。",
        "暮雪乌奴停醉帽，秋风白帝放归船。",
        "飘零自是关天命，错被人呼作地仙。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32928,
      "title": "壬辰十月十三日自阆中还兴元游三泉龙门十一月二日自兴元适成都复携儿曹往游赋诗",
      "content": [
        "胜地惜轻别，短笻成后游。",
        "门呀一境异，木落四山秋。",
        "野鸽翔深窦，蟠蛟擅古湫。",
        "栈危萦峭壁，桥逈跨奔流。",
        "白雨穿林至，腥风卷地浮。",
        "真成起衰病，不但洗孤愁。",
        "登陟知难再，吟哦为小留。",
        "回头即万里，雪满戴谿舟。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 32929,
      "title": "予行蜀汉间道出潭毒关下每憩罗汉院山光轩今复过之怅然有感",
      "content": [
        "山光轩上几闲游，潭毒关前又小留。",
        "麦陇雪苗寒剡剡，柘林风叶莫飕飕。",
        "马行剑阁从今始，门泊吴船亦已谋。",
        "醉眼每嫌天地迮，尽将万里著吾愁。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32930,
      "title": "栈路书事",
      "content": [
        "危阁闻铃驮，湍流见硙船。",
        "汲江人负盎，骑马客蒙氊。",
        "梨美来秦地，橙香接楚天。",
        "痴顽殊耐事，随处一欣然。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 32931,
      "title": "雪晴行益昌道中颇有春意",
      "content": [
        "杜陵雁下岁将残，疋马西游雪拥关。",
        "憔悴敢忘双阙路，淹迟遍看两川山。",
        "春回柳眼梅须里，愁在鞭丝帽影间。",
        "安得黄金成大药，为人千载驻頺颜。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32932,
      "title": "思归引",
      "content": [
        "善泅不如稳乘舟，善骑不如谨持辔。",
        "妙于服食不如寡欲，工于揣摩不如省事。",
        "在天有命谁得逃，在我无求直差易。",
        "散人家风脱纠缠，烟蓑雨笠全其天。",
        "莼丝老尽归不得，但坐长饥须俸钱。",
        "此身不堪阿堵役，寜待秋风始投檄。",
        "山林聊复取熊掌，仕宦真当弃鸡肋。",
        "锦城小憩不淹迟，即是轻舠下硖时。",
        "那用更为麟阁梦，从今正有鹿门期。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 32933,
      "title": "志公院在剑门东五里院东石壁间有若僧负杖者杖端髣髴有刀尺拂子之状",
      "content": [
        "江东争夺缠妖祲，哀哉斯民乱方甚。",
        "锦幪老人盖古佛，现身为作大慈荫。",
        "萧翁八十尚儿痴，旛盖钟螺閙中禁。",
        "当时此老黙笑渠，大法栋梁身独任。",
        "杖头示人三转语，开口丧身如饮鸩。",
        "纷纷放弑但可怜，何曾为汝陈符谶。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 32934,
      "title": "剑门道中遇微雨",
      "content": [
        "衣上征尘杂酒痕，远游无处不消魂。",
        "此身合是诗人未，细雨骑驴入剑门。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 32935,
      "title": "剑门关",
      "content": [
        "剑门天设险，北乡控函秦。",
        "客主固殊势，存亡终在人。",
        "栈云寒欲雨，关柳暗知春。",
        "羁客垂垂老，凭高一怆神。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 32936,
      "title": "剑门城北回望剑关诸峰青入云汉感蜀亡事慨然有赋",
      "content": [
        "自昔英雄有屈信，危机变化亦逡巡。",
        "阴平穷宼非难御，如此江山坐付人。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 32937,
      "title": "丹芝行",
      "content": [
        "剑山峨峨插穹苍，千林万谷蟠其阳。",
        "大丹九转古所藏，灵芝三秀夜吐光。",
        "如火非火森有芒，朝阳欲升尚煌煌。",
        "何由㔉取换肝肠，往驾素虬朝紫皇。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32938,
      "title": "过武连县北柳池安国院煮泉试日铸顾渚茶院有二泉皆甘寒传云唐僖宗幸蜀在道不豫至此饮泉而愈赐名报国灵泉云三首  其一",
      "content": [
        "滴沥珠玑翠壁间，遭时曾得奉龙颜。",
        "栏倾甃缺无人管，满院松风昼掩关。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 32939,
      "title": "过武连县北柳池安国院煮泉试日铸顾渚茶院有二泉皆甘寒传云唐僖宗幸蜀在道不豫至此饮泉而愈赐名报国灵泉云三首  其二",
      "content": [
        "行殿凄凉迹已陈，至今父老记南巡。",
        "一泓寒碧无今古，付与闲人作主人。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 32940,
      "title": "过武连县北柳池安国院煮泉试日铸顾渚茶院有二泉皆甘寒传云唐僖宗幸蜀在道不豫至此饮泉而愈赐名报国灵泉云三首  其三",
      "content": [
        "我是江南桑苎家，汲泉闲品故园茶。",
        "只应碧缶苍鹰爪，可压红囊白雪芽。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 32941,
      "title": "宿武连县驿",
      "content": [
        "平日功名浪自期，头颅到此不难知。",
        "宦情薄似秋蝉翼，乡思多于春茧丝。",
        "野店风霜俶装早，县桥灯火下程迟。",
        "鞭寒熨手戎衣窄，忽忆南山射虎时。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32942,
      "title": "初入西州境述怀",
      "content": [
        "我无飞仙术，御气周八极。",
        "寸步常依人，艰哉万里役。",
        "自行剑关南，大道平如席。",
        "日高徐驾车，薄暮亦两驿。",
        "及兹山愈远，原野若加辟。",
        "茂树冬不凋，寒花晚犹拆。",
        "昔我卜远游，至蜀龟辄食。",
        "弛装有定处，呜呼岂人力。",
        "颇传岷山下，清淑无疠疫。",
        "士风尚豪举，意气喜远客。",
        "薪米家可求，借书亦易得。",
        "思吴虽不忘，所愿少休息。",
        "吾闻右达人，雅志在山泽。",
        "岂无及物心，但恨俗褊迫。",
        "揽德虽成留，引去常勇决。",
        "骇机满人间，著脚无上策。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 32943,
      "title": "绵州魏成县驿有罗江东诗云芳草有情皆碍马好云无处不遮楼戏用其韵",
      "content": [
        "老夫乘兴忽西游，远跨秦吴万里秋。",
        "尊酒登临遍山寺，歌辞散落满江楼。",
        "孤城木叶萧萧下，古驿滩声㶁㶁流。",
        "未许诗人夸此地，茂林修竹忆吾州。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32944,
      "title": "即事",
      "content": [
        "渭水岐山不出兵，却携琴剑锦官城。",
        "醉来身外穷通小，老去人间毁誉轻。",
        "扪虱雄豪空自许，屠龙工巧竟何成。",
        "雅闻岷下多区芋，聊试寒炉玉糁羮。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32945,
      "title": "青村寺",
      "content": [
        "十年淹泊望修门，临水登山几断魂。",
        "短鬓星星身欲老，小楼微月宿青村。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 32946,
      "title": "行绵州道中",
      "content": [
        "三年客江硖，万死脱鱼鼋。",
        "平地从今始，穷涂敢复论。",
        "园畦棋局整，坡垄海涛翻。",
        "瘦犊应多恨，泥涂伏短辕。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 32947,
      "title": "越王楼二首  其一",
      "content": [
        "上尽江边百尺楼，倚栏极目莫江秋。",
        "未甘便作衰翁在，两脚犹堪蹋九州。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 32948,
      "title": "越王楼二首  其二",
      "content": [
        "蒲萄酒绿似江流，夜燕唐家帝子楼。",
        "约住筦弦呼羯鼓，要渠打散醉中愁。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 32949,
      "title": "东津",
      "content": [
        "岁暮涪江水归壑，白沙渺然石荦确。",
        "蜀天常燠少雪霜，绿树青林不揺落。",
        "阑干诘曲临官道，烟霭参差望城郭。",
        "打鱼斫脍修故事，豪竹哀丝奉欢乐。",
        "乐莫乐于新相知，美人一笑回春姿。",
        "四方本是丈夫事，安用一生无别离。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 32950,
      "title": "东山",
      "content": [
        "今日之集何佳哉，入关剧饮始此回。",
        "登山正可小天下，跨海何用寻蓬莱。",
        "青天肯为陆子见，妍日似趣梅花开。",
        "有酒如涪绿可爱，一醉直欲空千罍。",
        "𫘞酥鹅黄出陇右，熊肪玉白黔南来。",
        "眼花耳热不知夜，但见银烛高花摧。",
        "京华故人死太半，欢极往往潜生哀。",
        "聊将豪纵压忧患，鼓吹动地声如雷。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 32951,
      "title": "绵州录参厅观姜楚公画鹰少陵为作诗者",
      "content": [
        "我来访古涪之滨，不辞百罔冀一真。",
        "走马朝寻海椶馆，斫脍夜醉鲂鱼津。",
        "越王高楼亦已换，俯仰今古堪悲辛。",
        "督邮官舍最卑陋，栋挠楹腐知几春。",
        "岿然此壁独亡恙，老槎劲翮完如新。",
        "向来劫火何自免，叱呵守护疑有神。",
        "妖狐九尾穴中国，共置不问如越秦。",
        "天时此物合致用，下鞲指呼端在人。",
        "会当原野洒毛血，坐令万里清烟尘。",
        "老眼还忧不及见，诗成肝胆空轮囷。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 32952,
      "title": "罗江驿翠望亭读宋景文公诗",
      "content": [
        "扑马征尘拂不开，高亭欹帽一徘徊。",
        "蜀山地暖稀逢雪，闰岁春迟未见梅。",
        "陂水近人无鹭下，烟林藏寺有钟来。",
        "宋公出牧曾题壁，锦段虽残试剪裁。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32953,
      "title": "鹿头关过庞士元庙",
      "content": [
        "士元死千载，凄恻过遗祠。",
        "海内常难合，天心岂易知。",
        "英雄今古恨，父老岁时思。",
        "苍藓无情极，秋来满断碑。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 32954,
      "title": "游汉州西湖",
      "content": [
        "房公一跌樷众毁，八年汉州为刺史。",
        "遶城凿湖一百顷，岛屿曲折三四里。",
        "小庵静院穿竹入，危榭飞楼压城起。",
        "空蒙烟雨媚松楠，颠倒风霜老葮苇。",
        "日月苦长身苦闲，万事不理看湖水。",
        "向来爱琴虽一癖，观过自足知夫子。",
        "画船载酒凌湖光，想公乐饮千万场。",
        "叹息风流今未泯，两川名酝避鹅黄。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 32955,
      "title": "严君平卜台",
      "content": [
        "先生久已蜕氛埃，道上犹传旧卜台。",
        "乞得寒泉濯肝肺，真成万里不虚来。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 32956,
      "title": "梅花",
      "content": [
        "家是江南友是兰，水边月底怯新寒。",
        "画图省识惊春早，玉笛孤吹怨夜残。",
        "冷淡合教闲处著，清臞难遣俗人看。",
        "相逢剩作樽前恨，索笑情怀老渐阑。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32957,
      "title": "拜张忠定公祠二十韵",
      "content": [
        "张公世外人，与蜀偶有缘。",
        "天将靖蜀乱，生公在人间。",
        "厥初大盗兴，乐祸迭相挻。",
        "天子辍玉食，贵臣拥戎旃。",
        "生杀出喜怒，死者常差肩。",
        "公曰此何哉，从之吾欺天。",
        "河流触地轴，砥柱屹不迁。",
        "胁从尽纵舍，飞章交帝前。",
        "上意竟开悟，至仁胜凶残。",
        "贵臣不极赏，追还黜其权。",
        "安危关社稷，岂惟蜀民全。",
        "后来有阿童，握兵事开边。",
        "晚策睦州功，上公珥金蝉。",
        "势张不可御，北乡挑幽燕。",
        "神京遂丘墟，迄今天步艰。",
        "时无忠定公，孰能折其姧。",
        "我来拜遗祠，乔木含苍烟。",
        "死者不可作，愀然衰涕澘。",
        "愤切感虏祸，慷慨思公贤。",
        "春秋送迎神，谁为歌此篇。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 32958,
      "title": "成都岁暮始微寒小酌遣兴",
      "content": [
        "革带频移纱帽宽，茶铛欲熟篆香残。",
        "疏梅已报先春信，小雨初成十月寒。",
        "身似野僧犹有发，门如村舍强名官。",
        "鼠肝虫臂元无择，遇酒犹能罄一欢。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32959,
      "title": "再赋梅花",
      "content": [
        "老来爱酒賸狂颠，况复梅花到眼边。",
        "不怕幽香妨静观，正须疏影伴癯仙。",
        "松筠共叹冰霜晚，桃李从教雨露偏。",
        "此去西湖八千里，破愁一笑得无缘。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32960,
      "title": "登塔",
      "content": [
        "冷官无一事，日日得闲游。",
        "壮哉千尺塔，摄衣上上头。",
        "眼力老未减，足疾新有瘳。",
        "幸兹济胜具，俯仰隘九州。",
        "雪山西北横，大江东南流。",
        "画栋云气涌，铁铎风声遒。",
        "旅怀忽恻怆，涕下不能收。",
        "十年辞象魏，万里怀松楸。",
        "仰视去天咫，绝叫当闻不。",
        "帝阍守虎豹，此计终悠悠。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 32961,
      "title": "先主庙次唐贞元中张俨诗韵三首  其一",
      "content": [
        "猾贼挟至尊，天命矜在已。",
        "岂知高帝业，煌煌汉中起。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 32962,
      "title": "先主庙次唐贞元中张俨诗韵三首  其二",
      "content": [
        "吴蜀本唇齿，悲哉乃连兵。",
        "尽锐下三峡，谁使复两京。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 32963,
      "title": "先主庙次唐贞元中张俨诗韵三首  其三",
      "content": [
        "洛阳化为灰，棘生铜𫘞陌。",
        "讨贼志不成，父老泣陵柏。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 32964,
      "title": "睡起书事",
      "content": [
        "京华豪饮釂千钟，濯锦江边怯酒浓。",
        "烈士壮心虽未减，狂奴故态有谁容。",
        "折梅著句聊排闷，闭户焚香剩放慵。",
        "午枕如雷君莫怪，西风吹梦过吴松。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32965,
      "title": "西郊寻梅",
      "content": [
        "西郊梅花矜绝艳，走马独来看不厌。",
        "似羞流落蒙市尘，寜堕荒寒傍茆店。",
        "翛然自是世外人，过去生中差一念。",
        "浅颦常鄙桃李学，独立不容莺蝶觇。",
        "山矾水仙晚角出，大是春秋吴楚僭。",
        "余花岂无好颜色，病在一俗无由砭。",
        "朱栏玉砌渠有命，断桥流水君何欠。",
        "嗟余相与颇同调，身客剑南家在剡。",
        "凄凉万里归无日，萧飒二毛衰有渐。",
        "尚能作意晚相从，烂醉不辞杯潋滟。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 32966,
      "title": "分韵作梅花诗得东字",
      "content": [
        "浅寒篱落清霜后，疏影池塘淡月中。",
        "北客同春俱税驾，南枝与我两飘蓬。",
        "从来遇酒千钟少，此外评花四海空。",
        "惟恨广平风味减，坐看徐庾擅江东。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32967,
      "title": "宇文子友闻予有西郊寻梅诗以诗借观次其韵",
      "content": [
        "拾遗遗迹付缁郎，槁叶凝尘欲满堂。",
        "已恨罇罍孤胜饯，更堪风雨病幽芳。",
        "兰荪千古有同调，蜂蝶一春空自忙。",
        "马上得诗归绝叹，故园三径久成荒。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32968,
      "title": "海棠",
      "content": [
        "谁道名花独故宫，东城盛丽足争雄。",
        "横陈锦障阑干外，尽吸红云酒醆中。",
        "贪看不辞持夜烛，倚狂直欲擅春风。",
        "拾遗旧咏悲零落，瘦损腰围拟未工。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32969,
      "title": "简南禅勤长老",
      "content": [
        "宦游处处是君恩，归去无期莫更论。",
        "眼正修行新有力，心空忧患已无根。",
        "钵盂分我云堂饭，拄杖敲君竹院门。",
        "屈宋向来堪一笑，故乡何恋更招魂。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32970,
      "title": "和谭德称送牡丹二首  其一",
      "content": [
        "洛阳春色擅中州，檀晕鞓红总胜流。",
        "憔悴剑南人不管，问渠情味似侬不。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 32971,
      "title": "和谭德称送牡丹二首  其二",
      "content": [
        "吾生何拙亦何工，忧患如山一笑空。",
        "犹有余情被花恼，醉搔华发倚屏风。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 32972,
      "title": "初到蜀州寄成都诸友",
      "content": [
        "流落天涯鬓欲丝，年来用短始能奇。",
        "无材藉作长闲地，有懑留为剧饮资。",
        "万里不通京洛梦，一春最负牡丹时。",
        "襞牋报与诸公道，罨画亭边第一诗。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
