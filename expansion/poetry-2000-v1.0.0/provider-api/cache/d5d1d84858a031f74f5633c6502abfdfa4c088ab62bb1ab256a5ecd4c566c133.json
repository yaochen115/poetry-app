{
  "data": [
    {
      "id": 315701,
      "title": "丑奴儿・采桑子",
      "content": [
        "鹅湖山下长亭路，明月临关。",
        "明月临关。",
        "几阵西风落叶干。",
        "新词谁解裁冰雪，笔墨生寒。",
        "笔墨生寒。",
        "会说离愁千万般。"
      ],
      "author": {
        "id": 8618,
        "name": "辛弃疾"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315702,
      "title": "破阵子",
      "content": [
        "掷地刘郎玉斗，挂帆西子扁舟。",
        "千古风流今在此，万里功名莫放休。",
        "君王三百州。",
        "燕雀岂知鸿鹄，貂蝉元出兜鍪。",
        "却笑泸溪如斗大，肯把牛刀试手不。",
        "寿君双玉瓯。"
      ],
      "author": {
        "id": 8618,
        "name": "辛弃疾"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315703,
      "title": "破阵子",
      "content": [
        "醉里挑灯看剑，梦回吹角连营。",
        "八百里分麾下炙，五十弦翻塞外声。",
        "沙场秋点兵。",
        "马作的卢飞快，弓如霹雳弦惊。",
        "了却君王天下事，赢得生前身后名。",
        "可怜白发生。"
      ],
      "author": {
        "id": 8618,
        "name": "辛弃疾"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315704,
      "title": "千年调",
      "content": [
        "左手把青霓，右手挟明月。",
        "吾使丰隆前导，叫开阊阖。",
        "周游上下，径入寥天一。",
        "览县圃，万斛泉，千丈石。",
        "钧天广乐，燕我瑶之席。",
        "帝饮予觞甚乐，赐汝苍璧。",
        "嶙峋突兀，正在一丘壑。",
        "余马怀，仆夫悲，下恍惚。"
      ],
      "author": {
        "id": 8618,
        "name": "辛弃疾"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315705,
      "title": "祝英台近",
      "content": [
        "水纵横，山远近。",
        "拄杖占千顷。",
        "老眼羞将，水底看山影。",
        "试教水动山摇，吾生堪笑，似此个、青山无定。",
        "一瓢饮。",
        "人问翁爱飞泉，来寻个中静。",
        "绕屋生喧，怎做静中境。",
        "我眠君且归休，维摩方丈，待天女、散花时问。"
      ],
      "author": {
        "id": 8618,
        "name": "辛弃疾"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315706,
      "title": "祝英台近",
      "content": [
        "绿杨堤，青草渡。",
        "花片水流去。",
        "百舌声中，唤起海棠睡。",
        "断肠几点愁红，蹄痕犹在，多应怨、夜来风雨。",
        "别情苦。",
        "马蹄踏遍长亭，归期又成误。",
        "帘卷青楼，回首在何处。",
        "画梁燕子双双，能言能语，不解说、相思一句。"
      ],
      "author": {
        "id": 8618,
        "name": "辛弃疾"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315707,
      "title": "江神子・江城子",
      "content": [
        "看君人物汉西都。",
        "过吾庐。",
        "笑谈初。",
        "便说公卿，元自要通儒。",
        "一自梅花开了后，长怕说，赋归欤。",
        "而今别恨满江湖。",
        "怎消除。",
        "算何如。",
        "杖屦当时，闻早放教疏。",
        "今代故交新贵后，浑不寄，数行书。"
      ],
      "author": {
        "id": 8618,
        "name": "辛弃疾"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315708,
      "title": "清平乐",
      "content": [
        "云烟草树。",
        "山北山南雨。",
        "溪上行人相背去。",
        "惟有啼鸦一处。",
        "门前万斛春寒。",
        "梅花可㬠摧残。",
        "使我长忘酒易，要君不作诗难。"
      ],
      "author": {
        "id": 8618,
        "name": "辛弃疾"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315709,
      "title": "临江仙",
      "content": [
        "莫笑吾家苍壁小，棱层势欲摩空。",
        "相知惟有主人翁。",
        "有心雄泰华，无意巧玲珑。",
        "天作高山谁得料，解嘲试倩扬雄。",
        "君看当日仲尼穷。",
        "从人贤子贡，自欲学周公。"
      ],
      "author": {
        "id": 8618,
        "name": "辛弃疾"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315710,
      "title": "临江仙",
      "content": [
        "记取年年为寿客，只今明月相随。",
        "莫教弦管便生衣。",
        "引壶觞自酌，须富贵何时。",
        "入手清风词更好，细书白茧乌丝。",
        "海山问我几时归。",
        "枣瓜如可啖，直欲觅安期。"
      ],
      "author": {
        "id": 8618,
        "name": "辛弃疾"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315711,
      "title": "临江仙",
      "content": [
        "忆醉三山芳树下，几层风韵忘怀。",
        "黄金颜色五花开。",
        "味如庐橘熟。",
        "贵似荔枝来。",
        "闻道商山馀四老，橘中自酿秋醅。",
        "试呼名品细推排。",
        "重重香腑脏，偏𣨼圣贤杯。"
      ],
      "author": {
        "id": 8618,
        "name": "辛弃疾"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315712,
      "title": "临江仙",
      "content": [
        "夜语南堂新瓦响，三更急雨珊珊。",
        "交情莫作细沙团。",
        "死生贫富际，试向此中看。",
        "记取他年《耆旧传》，与君名字牵连。",
        "清风一枕晚凉天。",
        "觉来还自笑，此梦倩谁园。"
      ],
      "author": {
        "id": 8618,
        "name": "辛弃疾"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315713,
      "title": "南乡子",
      "content": [
        "日日老莱衣。",
        "更解风流蜡凤嬉。",
        "膝上放教文度去，须知。",
        "要使人看玉树枝。",
        "剩记乃翁诗。",
        "绿水红莲觅旧题。",
        "归骑春衫花满路，相期。",
        "来岁流觞曲水时。"
      ],
      "author": {
        "id": 8618,
        "name": "辛弃疾"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315714,
      "title": "玉楼春",
      "content": [
        "有无一理谁差别。",
        "乐令区区浑未达。",
        "事言无处未尝无，试把所无凭理说。",
        "伯夷饥采西山蕨。",
        "何异捣齑餐杵铁。",
        "仲尼去卫又之陈，此是乘车入鼠穴。"
      ],
      "author": {
        "id": 8618,
        "name": "辛弃疾"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315715,
      "title": "玉楼春",
      "content": [
        "客来底事逢迎晚。",
        "竹里鸣禽寻未见。",
        "日高犹苦圣贤中，门外谁酣蛮触战。",
        "多方为渴寻泉遍。",
        "何日成阴松种满。",
        "不辞长向水云来，只怕频烦鱼鸟倦。"
      ],
      "author": {
        "id": 8618,
        "name": "辛弃疾"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315716,
      "title": "玉楼春",
      "content": [
        "何人半夜推山去。",
        "四面浮云猜是汝。",
        "常时相对两三峰，走遍溪头无觅处。",
        "西风瞥起云横渡。",
        "忽见东南天一柱。",
        "老僧拍手笑相夸，且喜青山依旧住。"
      ],
      "author": {
        "id": 8618,
        "name": "辛弃疾"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315717,
      "title": "玉楼春",
      "content": [
        "青山不会乘云去。",
        "怕有愚公惊著汝。",
        "人间踏地出租钱，借使移将无著处。",
        "三星昨夜光移度。",
        "妙语来题桥上柱。",
        "黄花不插满头归，定倩白云遮且住。"
      ],
      "author": {
        "id": 8618,
        "name": "辛弃疾"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315718,
      "title": "玉楼春",
      "content": [
        "少年才把笙歌𧣴",
        "夏日非长秋夜短。",
        "因他老病不相饶，把好心情都做懒。",
        "故人别后书来劝。",
        "乍可停杯强吃饭。",
        "云何相遇酒边时，却道达人须饮满。"
      ],
      "author": {
        "id": 8618,
        "name": "辛弃疾"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315719,
      "title": "玉楼春",
      "content": [
        "君如九酝台黏𧣴",
        "我似茅柴风味短。",
        "几时秋水美人来，长恐扁舟乘兴懒。",
        "高怀自饮无人劝。",
        "马有青刍奴白饭。",
        "向来珠履玉簪人，颇觉斗量车载满。"
      ],
      "author": {
        "id": 8618,
        "name": "辛弃疾"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315720,
      "title": "玉楼春",
      "content": [
        "狂歌击碎村醪𧣴",
        "欲舞还怜衫袖短。",
        "身如溪上钓矶闲，心似道旁官堠懒。",
        "山中有酒提壶劝。",
        "好语多君堪鲊饭。",
        "至今有句落人间，渭水西风黄叶满。"
      ],
      "author": {
        "id": 8618,
        "name": "辛弃疾"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315721,
      "title": "鹧鸪天",
      "content": [
        "趁得东风汗漫游。",
        "见他歌后怎生愁。",
        "事如芳草春长在，人似浮云影不留。",
        "眉黛敛，眼波流。",
        "十年薄幸谩扬州。",
        "明朝短棹轻衫梦，只在溪南罨画楼。"
      ],
      "author": {
        "id": 8618,
        "name": "辛弃疾"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315722,
      "title": "鹧鸪天",
      "content": [
        "叹息频年廪未高。",
        "新词空贺此丘遭。",
        "遥知醉帽时时落，见说吟鞭步步摇。",
        "干玉唾，秃锥毛。",
        "只今明月费招邀。",
        "最怜乌鹊南飞句，不解风流见二乔。"
      ],
      "author": {
        "id": 8618,
        "name": "辛弃疾"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315723,
      "title": "鹧鸪天",
      "content": [
        "戏马台前秋雁飞。",
        "管弦歌舞更旌旗。",
        "要知黄菊清高处，不入当年二谢诗。",
        "倾白酒，绕东篱。",
        "只于陶令有心期。",
        "明朝重九浑潇洒，莫使尊前欠一枝。"
      ],
      "author": {
        "id": 8618,
        "name": "辛弃疾"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315724,
      "title": "鹧鸪天",
      "content": [
        "水荇参差动绿波。",
        "一池蛇影噤群蛙。",
        "因风野鹤饥犹舞，积雨山栀病不花。",
        "名利处，战争多。",
        "门前蛮触日干戈。",
        "不知更有槐安国，梦觉南柯日未斜。"
      ],
      "author": {
        "id": 8618,
        "name": "辛弃疾"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315725,
      "title": "鹧鸪天",
      "content": [
        "出处从来自不齐。",
        "后车方载太公归。",
        "谁知孤竹夷齐子，正向空山赋采薇。",
        "黄菊嫩，晚香枝。",
        "一般同是采花时。",
        "蜂儿辛苦多官府，蝴蝶花间自在飞。"
      ],
      "author": {
        "id": 8618,
        "name": "辛弃疾"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315726,
      "title": "鹧鸪天",
      "content": [
        "秋水长廊水石间。",
        "有谁来共听潺湲。",
        "羡君人物东西晋，分我诗名大小山。",
        "穷自乐，懒方闲。",
        "人间路窄酒杯宽。",
        "看君不了痴儿事，又似风流靖长官。"
      ],
      "author": {
        "id": 8618,
        "name": "辛弃疾"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315727,
      "title": "鹧鸪天",
      "content": [
        "壮岁旌旗拥万夫。",
        "锦襜突骑渡江初。",
        "燕兵夜娖银胡䩮，汉箭朝飞金仆姑。",
        "追往事，叹今吾。",
        "春风不染白髭须。",
        "都将万字平戎策，换得东家种树书。"
      ],
      "author": {
        "id": 8618,
        "name": "辛弃疾"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315728,
      "title": "鹧鸪天",
      "content": [
        "上巳风光好放怀。",
        "忆君犹未看花回。",
        "茂林映带谁家竹，曲水流传第几杯。",
        "摛锦绣，写玫瑰。",
        "长年富贵属多才。",
        "要知此日生男好，曾有周公祓禊来。"
      ],
      "author": {
        "id": 8618,
        "name": "辛弃疾"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315729,
      "title": "鹧鸪天",
      "content": [
        "去岁君家把酒杯。",
        "雪中曾见牡丹开。",
        "而今纨扇薰风里，又见疏枝月下梅。",
        "欢几许，醉方回。",
        "明朝归路有人摧。",
        "低声待向他家道，带得歌声满耳来。"
      ],
      "author": {
        "id": 8618,
        "name": "辛弃疾"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315730,
      "title": "鹊桥仙",
      "content": [
        "溪边白鹭。",
        "来吾告汝。",
        "溪里鱼儿堪数。",
        "主人怜汝汝怜鱼，要物我、欣然一处。",
        "白沙远浦。",
        "青泥别渚。",
        "剩有虾跳鳅舞。",
        "任君飞去饱时来，看头上、风吹一缕。"
      ],
      "author": {
        "id": 8618,
        "name": "辛弃疾"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315731,
      "title": "西江月",
      "content": [
        "画栋新垂帘幕，华灯未放笙歌。",
        "一杯潋滟泛金波。",
        "先向太夫人贺。",
        "富贵吾应自有，功名不用渠多。",
        "只将绿鬓抵羲娥。",
        "金印须教斗大。"
      ],
      "author": {
        "id": 8618,
        "name": "辛弃疾"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315732,
      "title": "西江月",
      "content": [
        "风月亭危致爽，管弦声脆休催。",
        "主人只是旧时怀。",
        "锦瑟旁边须醉。",
        "玉殿何须侬去，沙堤只要公来。",
        "看看红药又翻阶。",
        "趁取西湖春会。"
      ],
      "author": {
        "id": 8618,
        "name": "辛弃疾"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315733,
      "title": "西江月",
      "content": [
        "贪数明朝重九。",
        "不知过了中秋。",
        "人生有得许多愁。",
        "惟有黄花如旧。",
        "万象亭中𣨼酒。",
        "九江阁上扶头。",
        "城鸦唤我醉归休。",
        "细雨斜风时候。"
      ],
      "author": {
        "id": 8618,
        "name": "辛弃疾"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315734,
      "title": "西江月",
      "content": [
        "醉里且贪欢笑，要愁那得工夫。",
        "近来始觉古人书。",
        "信著全无是处。",
        "昨夜松边醉倒，问松我醉何如。",
        "只疑松动要来扶。",
        "以手推松曰去。"
      ],
      "author": {
        "id": 8618,
        "name": "辛弃疾"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315735,
      "title": "瑞鹧鸪",
      "content": [
        "江头日日打头风。",
        "憔悴归来邴曼容。",
        "郑贾正应求死鼠，叶公岂是好真龙。",
        "孰居无事陪犀首，未办求封遇万松。",
        "却笑千年曹孟德，梦中相对也龙锺。"
      ],
      "author": {
        "id": 8618,
        "name": "辛弃疾"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315736,
      "title": "瑞鹧鸪",
      "content": [
        "期思溪上日千回。",
        "樟木桥边酒数杯。",
        "人影不随流水去，醉颜重带少年来。",
        "疏蝉响涩林逾静，冷蝶飞轻菊半开。",
        "不是长卿终慢世，只缘多病又非才。"
      ],
      "author": {
        "id": 8618,
        "name": "辛弃疾"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315737,
      "title": "玉楼春",
      "content": [
        "无心云自来还去。",
        "元共青山相尔汝。",
        "霎时迎雨障崔嵬，雨过却寻归路处。",
        "侵天翠竹何曾度。",
        "遥见屹然星砥柱。",
        "今朝不管乱云深，来伴仙翁山下住。"
      ],
      "author": {
        "id": 8618,
        "name": "辛弃疾"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315738,
      "title": "玉楼春",
      "content": [
        "瘦筇倦作登高去。",
        "却怕黄花相尔汝。",
        "岭头拭目望龙安，更在云烟遮断处。",
        "思量落帽人风度。",
        "休说当年功纪柱。",
        "谢公直是爱东山，毕竟东山留不住。"
      ],
      "author": {
        "id": 8618,
        "name": "辛弃疾"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315739,
      "title": "玉楼春",
      "content": [
        "风前欲劝春光住。",
        "春在城南芳草路。",
        "未随流落水边花，且作飘零泥上絮。",
        "镜中已觉星星误。",
        "人不负春春自负。",
        "梦回人远许多愁，只在梨花风雨处。"
      ],
      "author": {
        "id": 8618,
        "name": "辛弃疾"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315740,
      "title": "玉楼春",
      "content": [
        "悠悠莫向文山去。",
        "要把襟裾牛马汝。",
        "遥知书带草边行，正在雀罗门里住。",
        "平生插架昌黎句。",
        "不似拾柴东野苦。",
        "侵天且拟凤凰巢，扫地从他鸖鹆舞。"
      ],
      "author": {
        "id": 8618,
        "name": "辛弃疾"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315741,
      "title": "玉楼春",
      "content": [
        "琵琶亭畔多芳草。",
        "时对香炉峰一笑。",
        "偶然重傍玉溪东，不是白头谁觉老。",
        "普陀大士神通妙。",
        "影入石头光了了。",
        "看来持献可无言，长似慈悲颜色好。"
      ],
      "author": {
        "id": 8618,
        "name": "辛弃疾"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315742,
      "title": "玉楼春",
      "content": [
        "江头一带斜阳树。",
        "总是六朝人住处。",
        "悠悠兴废不关心，惟有沙洲双白鹭。",
        "仙人矶下多风雨。",
        "好卸征帆留不住。",
        "直须抖擞尽尘埃，却趁新凉秋水去。"
      ],
      "author": {
        "id": 8618,
        "name": "辛弃疾"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315743,
      "title": "鹊桥仙",
      "content": [
        "少年风月，少年歌舞，老去方知堪羡。",
        "叹折腰、五斗赋归来，问走了、羊肠几遍。",
        "高车驷马，金章紫绶，传语渠侬稳便。",
        "问东湖、带得几多春，且看凌云笔健。"
      ],
      "author": {
        "id": 8618,
        "name": "辛弃疾"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315744,
      "title": "西江月",
      "content": [
        "且对东君痛饮，莫教华发空催。",
        "琼瑰千字已盈怀。",
        "消得津头一醉。",
        "休唱《阳关》别去，只今凰诏归来。",
        "五云两两望三台。",
        "已觉精神聚会。"
      ],
      "author": {
        "id": 8618,
        "name": "辛弃疾"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315745,
      "title": "西江月",
      "content": [
        "剩欲读书已懒，只因多病长闲。",
        "听风听雨小窗眠。",
        "过了春光太半。",
        "往事如寻去鸟，清愁难解连环。",
        "流莺不肯入西园。",
        "唤起画梁飞燕。"
      ],
      "author": {
        "id": 8618,
        "name": "辛弃疾"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315746,
      "title": "西江月",
      "content": [
        "金粟如来出世，蕊宫仙子乘风。",
        "清香一袖意无穷。",
        "洗尽尘缘千种。",
        "长为西风作主，更居明月光中。",
        "十分秋意与玲珑。",
        "拼却今宵无梦。"
      ],
      "author": {
        "id": 8618,
        "name": "辛弃疾"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315747,
      "title": "西江月",
      "content": [
        "八万四千偈后，更谁妙语披襟。",
        "纫兰结佩有同心。",
        "唤取诗翁来饮。",
        "镂玉栽冰著句，高山流水知音。",
        "胸中不受一尘侵。",
        "却怕灵均独醒。"
      ],
      "author": {
        "id": 8618,
        "name": "辛弃疾"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315748,
      "title": "西江月",
      "content": [
        "粉面都成醉梦，霜髯能几春秋。",
        "来时诵我《伴牢愁》。",
        "一见尊前似旧。",
        "诗在阴何侧畔，字居罗赵前头。",
        "锦囊来往几时休。",
        "已遣蛾眉等候。"
      ],
      "author": {
        "id": 8618,
        "name": "辛弃疾"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315749,
      "title": "朝中措",
      "content": [
        "年年黄菊滟秋风。",
        "更有拒霜红。",
        "黄似旧时宫额，红如此日芳容。",
        "青青未老，尊前要看，儿辈平戎。",
        "试酿西江为寿，西江绿水无穷。"
      ],
      "author": {
        "id": 8618,
        "name": "辛弃疾"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315750,
      "title": "清平乐",
      "content": [
        "溪回沙浅。",
        "红杏都开遍。",
        "㶉𫛶不知春水暖。",
        "犹傍垂杨春岸。",
        "片帆千里轻船。",
        "行人想见敧眠。",
        "谁似先生高举，一行白鹭青天。"
      ],
      "author": {
        "id": 8618,
        "name": "辛弃疾"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315751,
      "title": "好事近",
      "content": [
        "明月到今宵，长是不如人约。",
        "想见广寒宫殿，正云梳风掠。",
        "夜深休更唤笙歌，檐头雨声恶。",
        "不是小山词就，这一场寥索。"
      ],
      "author": {
        "id": 8618,
        "name": "辛弃疾"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315752,
      "title": "好事近",
      "content": [
        "云气上林梢，毕竟非空非色。",
        "风景不随人去，到而今留得。",
        "老无情味到篇章，诗债怕人索。",
        "却笑近来林下，有许多词客。"
      ],
      "author": {
        "id": 8618,
        "name": "辛弃疾"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315753,
      "title": "菩萨蛮",
      "content": [
        "江摇病眼昏如雾。",
        "送愁直到津头路。",
        "归念乐天诗。",
        "人生足别离。",
        "云屏深夜语。",
        "梦到君知否。",
        "玉箸莫偷垂。",
        "断肠天不知。"
      ],
      "author": {
        "id": 8618,
        "name": "辛弃疾"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315754,
      "title": "菩萨蛮",
      "content": [
        "西风都是行人恨。",
        "马头渐喜归期近。",
        "试上小红楼。",
        "飞鸿字字愁。",
        "阑干闲倚处。",
        "一带山无数。",
        "不似远山横。",
        "秋波相共明。"
      ],
      "author": {
        "id": 8618,
        "name": "辛弃疾"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315755,
      "title": "菩萨蛮",
      "content": [
        "功名饱听儿童说。",
        "看公两眼明如月。",
        "万里勒燕然。",
        "老人书一编。",
        "玉阶方寸地。",
        "好趁风云会。",
        "他日赤松游。",
        "依然万户侯。"
      ],
      "author": {
        "id": 8618,
        "name": "辛弃疾"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315756,
      "title": "菩萨蛮",
      "content": [
        "送君直上金銮殿。",
        "情知不久须相见。",
        "一日甚三秋。",
        "愁来不自由。",
        "九重天一笑。",
        "定是留中了。",
        "白发少经过。",
        "此时愁奈何。"
      ],
      "author": {
        "id": 8618,
        "name": "辛弃疾"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315757,
      "title": "菩萨蛮",
      "content": [
        "人间岁月堂堂去。",
        "劝君快上青云路。",
        "圣处一灯传。",
        "工夫萤雪边。",
        "曲生风味恶。",
        "辜负西窗约。",
        "沙岸片帆开。",
        "寄书无雁来。"
      ],
      "author": {
        "id": 8618,
        "name": "辛弃疾"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315758,
      "title": "菩萨蛮",
      "content": [
        "红牙签上群仙格。",
        "翠罗盖底倾城色。",
        "和雨泪阑干。",
        "沈香亭北看。",
        "东风休放去。",
        "怕有流莺诉。",
        "试问赏花人。",
        "晓妆匀未匀。"
      ],
      "author": {
        "id": 8618,
        "name": "辛弃疾"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315759,
      "title": "菩萨蛮",
      "content": [
        "君家玉雪花如屋。",
        "未应山下成三宿。",
        "啼鸟几曾催。",
        "西风犹未来。",
        "山房连石径。",
        "云卧衣裳冷。",
        "倩得李延年。",
        "清歌送上天。"
      ],
      "author": {
        "id": 8618,
        "name": "辛弃疾"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315760,
      "title": "卜算子",
      "content": [
        "万里𥬞浮云，一喷空凡马。",
        "叹息曹瞒《老骥》诗，伏枥如公者。",
        "山鸟哢窥檐，野鼠饥翻瓦。",
        "老我痴顽合住山，此地菟裘也。"
      ],
      "author": {
        "id": 8618,
        "name": "辛弃疾"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315761,
      "title": "丑奴儿・采桑子",
      "content": [
        "晚来云淡秋光薄，落日晴天。",
        "落日晴天。",
        "堂上风斜画烛烟。",
        "从渠去买人间恨，字字都圆。",
        "字字都圆。",
        "肠断西风十四弦。"
      ],
      "author": {
        "id": 8618,
        "name": "辛弃疾"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315762,
      "title": "丑奴儿・采桑子",
      "content": [
        "寻常中酒扶头后，歌舞支持。",
        "歌舞支持。",
        "谁把新词唤住伊。",
        "临歧也有旁人笑，笑己争知。",
        "笑己争知。",
        "明月楼空燕子飞。"
      ],
      "author": {
        "id": 8618,
        "name": "辛弃疾"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315763,
      "title": "丑奴儿・采桑子",
      "content": [
        "此生自断天休问，独倚危楼。",
        "独倚危楼。",
        "不信人间别有愁。",
        "君来正是眠时节，君且归休。",
        "君且归休。",
        "说与西风一任秋。"
      ],
      "author": {
        "id": 8618,
        "name": "辛弃疾"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315764,
      "title": "丑奴儿・采桑子",
      "content": [
        "近来愁似天来大，谁解相怜。",
        "谁解相怜。",
        "又把愁来做个天。",
        "都将今古无穷事，放在愁边。",
        "放在愁边。",
        "却自移家向酒泉。"
      ],
      "author": {
        "id": 8618,
        "name": "辛弃疾"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315765,
      "title": "丑奴儿・采桑子",
      "content": [
        "年年索尽梅花笑，疏影黄昏。",
        "疏影黄昏。",
        "香满东风月一痕。",
        "清诗冷落无人寄，雪艳冰魂。",
        "雪艳冰魂。",
        "浮玉溪头烟树村。"
      ],
      "author": {
        "id": 8618,
        "name": "辛弃疾"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315766,
      "title": "浣溪沙",
      "content": [
        "寿酒同斟喜有馀。",
        "朱颜却对白髭须。",
        "两人百岁恰乘除。",
        "婚嫁剩添儿女拜，平安频拆外家书。",
        "年年堂上寿星图。"
      ],
      "author": {
        "id": 8618,
        "name": "辛弃疾"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315767,
      "title": "浣溪沙",
      "content": [
        "歌串如珠个个匀。",
        "被花勾引笑和颦。",
        "向来惊动画梁尘。",
        "莫倚笙歌多乐事，相看红紫又抛人。",
        "旧巢还有燕泥新。"
      ],
      "author": {
        "id": 8618,
        "name": "辛弃疾"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315768,
      "title": "浣溪沙",
      "content": [
        "父老争言雨水匀。",
        "眉头不似去年颦。",
        "殷勤谢却甑中尘。",
        "啼鸟有时能劝客，小桃无赖已撩人。",
        "梨花也作白头新。"
      ],
      "author": {
        "id": 8618,
        "name": "辛弃疾"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315769,
      "title": "浣溪沙",
      "content": [
        "这里裁诗话别离。",
        "那边应是望归期。",
        "人言心急马行迟。",
        "去雁无凭传锦字，春泥抵死污人衣。",
        "海棠过了有荼䕷。"
      ],
      "author": {
        "id": 8618,
        "name": "辛弃疾"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315770,
      "title": "浣溪沙",
      "content": [
        "妙手都无斧凿瘢。",
        "饱参佳处却成颦。",
        "恰如春入浣花村。",
        "笔墨今宵光有艳，管弦从此悄无言。",
        "主人席次两眉轩。"
      ],
      "author": {
        "id": 8618,
        "name": "辛弃疾"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315771,
      "title": "添字浣溪沙・山花子",
      "content": [
        "句里明珠字字排。",
        "多情应也被春催。",
        "怪得名花和泪送，雨中栽。",
        "赤脚未安芳斛稳，娥眉早把橘枝来。",
        "报道锦薰笼底下，麝脐开。"
      ],
      "author": {
        "id": 8618,
        "name": "辛弃疾"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315772,
      "title": "添字浣溪沙・山花子",
      "content": [
        "记得瓢泉快活时。",
        "长年耽酒更吟诗。",
        "蓦地捉将来断送，老头皮。",
        "绕屋人扶行不得，闲窗学得鹧鸪啼。",
        "却有杜鹃能劝道，不如归。"
      ],
      "author": {
        "id": 8618,
        "name": "辛弃疾"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315773,
      "title": "添字浣溪沙・山花子",
      "content": [
        "日日闲看燕子飞。",
        "旧巢新垒画帘低。",
        "玉历今朝推戊己，住衔泥。",
        "先自春光留不住，那堪更著子规啼。",
        "一阵晚香吹不断，落花溪。"
      ],
      "author": {
        "id": 8618,
        "name": "辛弃疾"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315774,
      "title": "添字浣溪沙・山花子",
      "content": [
        "杨柳温柔是故乡。",
        "纷纷蜂蝶去年场。",
        "大率一春风雨事，最难量。",
        "满把携来红粉面，堆盘更觉紫芝香。",
        "幸自曲生闲去了，又教忙。"
      ],
      "author": {
        "id": 8618,
        "name": "辛弃疾"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315775,
      "title": "减字木兰花",
      "content": [
        "僧窗夜雨。",
        "茶鼎熏炉宜小住。",
        "却恨春风。",
        "勾引诗来恼杀翁。",
        "狂歌未可。",
        "且把一尊料理我。",
        "我到亡何。",
        "却听侬家陌上歌。"
      ],
      "author": {
        "id": 8618,
        "name": "辛弃疾"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315776,
      "title": "减字木兰花",
      "content": [
        "昨朝官告。",
        "一百五年村父老。",
        "更莫惊疑。",
        "刚道人生七十稀。",
        "使君喜见。",
        "恰限华堂开寿宴。",
        "问寿如何。",
        "百代儿孙拥太婆。"
      ],
      "author": {
        "id": 8618,
        "name": "辛弃疾"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315777,
      "title": "醉太平",
      "content": [
        "态浓意远。",
        "眉颦笑浅。",
        "薄罗衣窄絮风软。",
        "鬓云欺翠卷。",
        "南园花树春光暖。",
        "红香径里榆钱满。",
        "欲上秋千又惊懒。",
        "且归休怕晚。"
      ],
      "author": {
        "id": 8618,
        "name": "辛弃疾"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315778,
      "title": "太常引",
      "content": [
        "仙机似欲织纤罗。",
        "仿佛度金梭。",
        "无奈玉纤何。",
        "却弹作、清商恨多。",
        "珠帘影里，如花半面，绝胜隔帘歌。",
        "世路苦风波。",
        "且痛饮、公无度河。"
      ],
      "author": {
        "id": 8618,
        "name": "辛弃疾"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315779,
      "title": "太常引",
      "content": [
        "论公耆德旧宗英。",
        "吴季子、百馀龄。",
        "奉使老于行。",
        "更看舞、听歌最精。",
        "须同卫武，九十入相，绿竹自青青。",
        "富贵出长生。",
        "记门外、清溪姓彭。"
      ],
      "author": {
        "id": 8618,
        "name": "辛弃疾"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315780,
      "title": "东坡引",
      "content": [
        "君如梁上燕。",
        "妾如手中扇。",
        "团团青影双双伴。",
        "秋来肠欲断。",
        "黄昏泪眼。",
        "秋来肠欲断。",
        "青山隔岸。",
        "但咫尺、如天远。",
        "病来只谢傍人劝。",
        "龙华三会愿。",
        "龙华三会愿。"
      ],
      "author": {
        "id": 8618,
        "name": "辛弃疾"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315781,
      "title": "东坡引",
      "content": [
        "花梢红未足。",
        "条破惊新绿。",
        "重帘下遍阑干曲。",
        "有人春睡熟。",
        "有人春睡熟。",
        "鸣禽破梦，云偏目蹙。",
        "起来香腮褪红玉。",
        "花时爱与愁相续。",
        "罗裙过半幅。",
        "罗裙过半幅。"
      ],
      "author": {
        "id": 8618,
        "name": "辛弃疾"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315782,
      "title": "恋绣衾",
      "content": [
        "长夜偏冷添被儿。",
        "枕头儿、移了又移。",
        "我自是笑别人底，却元来、当局者迷。",
        "如今只恨因缘浅，也不曾、抵死恨伊。",
        "合手下、安排了，那筵席、须有散时。"
      ],
      "author": {
        "id": 8618,
        "name": "辛弃疾"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315783,
      "title": "杏花天",
      "content": [
        "牡丹昨夜方开遍。",
        "毕竟是、今年春晚。",
        "荼䕷付与薰风管。",
        "燕子忙时莺懒。",
        "多病起、日长人倦。",
        "不待得、酒阑歌散。",
        "副能得见茶瓯面。",
        "却早安排肠断。"
      ],
      "author": {
        "id": 8618,
        "name": "辛弃疾"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315784,
      "title": "柳梢青",
      "content": [
        "白鸟相迎，相怜相笑，满面尘埃。",
        "华发苍颜，去时曾劝，闻早归来。",
        "而今岂是高怀。",
        "为千里、莼羹计哉。",
        "好把《移文》，从今日日，读取千回。"
      ],
      "author": {
        "id": 8618,
        "name": "辛弃疾"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315785,
      "title": "武陵春",
      "content": [
        "走去走来三百里，五日以为期。",
        "六日归时已是疑。",
        "应是望多时。",
        "鞭个马儿归去也，心急马行迟。",
        "不免相烦喜鹊儿。",
        "先报那人知。"
      ],
      "author": {
        "id": 8618,
        "name": "辛弃疾"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315786,
      "title": "谒金门",
      "content": [
        "归去未。",
        "风雨送春行李。",
        "一枕离愁头澈尾。",
        "如何消遣是。",
        "遥想归舟天际。",
        "绿鬓珑璁慵理。",
        "好梦未成莺唤起。",
        "粉香犹有𣨼。"
      ],
      "author": {
        "id": 8618,
        "name": "辛弃疾"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315787,
      "title": "酒泉子",
      "content": [
        "流水无情，潮到空城头尽白，离歌一曲怨残阳。",
        "断人肠。",
        "东风官柳舞雕墙。",
        "三十六宫花溅泪，春声何处说兴亡。",
        "燕双双。"
      ],
      "author": {
        "id": 8618,
        "name": "辛弃疾"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315788,
      "title": "霜天晓角",
      "content": [
        "暮山层碧。",
        "掠岸西风急。",
        "一叶软红深处，应不是、利名客。",
        "玉人还伫立。",
        "绿窗生怨泣。",
        "万里衡阳归恨，先倩雁、寄消息。"
      ],
      "author": {
        "id": 8618,
        "name": "辛弃疾"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315789,
      "title": "点绛唇",
      "content": [
        "隐隐轻雷，雨声不受春回护。",
        "落梅如许。",
        "吹尽墙边去。",
        "春水无情，碍断溪南路。",
        "凭谁诉。",
        "寄声传语。",
        "没个人知处。"
      ],
      "author": {
        "id": 8618,
        "name": "辛弃疾"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315790,
      "title": "生查子",
      "content": [
        "梅子褪花时，直与黄梅接。",
        "烟雨几曾开，一春江里活。",
        "富贵使人忙，也有闲时节。",
        "莫作路旁花，长教人看杀。"
      ],
      "author": {
        "id": 8618,
        "name": "辛弃疾"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315791,
      "title": "生查子",
      "content": [
        "悠悠万世功，矻矻当年苦。",
        "鱼自入深渊，人自居平土。",
        "红日又西沉，白浪长东去。",
        "不是望金山，我自思量禹。"
      ],
      "author": {
        "id": 8618,
        "name": "辛弃疾"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315792,
      "title": "昭君怨",
      "content": [
        "夜雨剪残春韭。",
        "明日重斟别酒。",
        "君去问曹瞒。",
        "好公安。",
        "试看如今白发。",
        "却为中年离别。",
        "风雨正崔嵬。",
        "早归来。"
      ],
      "author": {
        "id": 8618,
        "name": "辛弃疾"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315793,
      "title": "一落索",
      "content": [
        "锦帐如云处。",
        "高不知重数。",
        "夜深银烛泪成行，算都把、心期付。",
        "莫待燕飞泥污。",
        "问花花诉。",
        "不知花定有情无，似却怕、新词妒。"
      ],
      "author": {
        "id": 8618,
        "name": "辛弃疾"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315794,
      "title": "如梦令",
      "content": [
        "燕子几曾归去。",
        "只在翠岩深处。",
        "重到画梁间，谁与旧巢为主。",
        "深许。",
        "深许。",
        "闻道凤凰来住。"
      ],
      "author": {
        "id": 8618,
        "name": "辛弃疾"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315795,
      "title": "生查子",
      "content": [
        "一天霜月明，几处砧声起。",
        "客梦已难成，秋色无边际。",
        "旦夕是重阳，菊有黄花蕊。",
        "只怕又登高，未饮心先醉。"
      ],
      "author": {
        "id": 8618,
        "name": "辛弃疾"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315796,
      "title": "满江红",
      "content": [
        "老子当年，饱经惯、花期酒约。",
        "行乐处，轻裘缓带，绣鞍金络。",
        "明月楼台箫鼓夜，梨花院落秋千索。",
        "共何人、对饮五三锺，颜如玉。",
        "嗟往事，空萧索。",
        "怀新恨，又飘泊。",
        "但年来何待，许多幽独。",
        "海水连天凝望远，山风吹雨征衫薄。",
        "向此际、羸马独骎骎，情怀恶。"
      ],
      "author": {
        "id": 8618,
        "name": "辛弃疾"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315797,
      "title": "菩萨蛮",
      "content": [
        "与君欲赴西楼约。",
        "西楼风急征衫薄。",
        "且莫上兰舟。",
        "怕人青泪流。",
        "临风横玉管。",
        "声散江天满。",
        "一夜旅中愁。",
        "蛩吟不忍休。"
      ],
      "author": {
        "id": 8618,
        "name": "辛弃疾"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315798,
      "title": "一翦梅",
      "content": [
        "尘洒衣裾客路长。",
        "霜林已晚，秋蕊犹香。",
        "别离触处是悲凉。",
        "梦里青楼，不忍思量。",
        "天字沈沈落日黄。",
        "云遮望眼，山割愁肠。",
        "满怀珠玉泪浪浪。",
        "欲倩西风，吹到兰房。"
      ],
      "author": {
        "id": 8618,
        "name": "辛弃疾"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315799,
      "title": "一翦梅",
      "content": [
        "歌罢尊空月坠西。",
        "百花门外，烟翠霏微。",
        "降纱笼烛照于飞。",
        "归去来兮。",
        "归去来兮。",
        "酒入香腮分外宜。",
        "行行问道，还肯相随。",
        "娇羞无力应人迟。",
        "何幸如之。",
        "何幸如之。"
      ],
      "author": {
        "id": 8618,
        "name": "辛弃疾"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315800,
      "title": "念奴娇",
      "content": [
        "西真姊妹，料凡心忽起，共辞瑶阙。",
        "燕燕莺莺相并比，的当两团儿雪。",
        "合韵歌喉，同茵舞袖，举措□□别。",
        "江梅影里，迥然双蕊奇绝。",
        "还听别院笙歌，仓皇走报，笑语浑重叠。",
        "拾翠洲边携手处，疑是桃根桃叶。",
        "并蒂芳莲，双头红药，不意俱攀折。",
        "今宵鸳帐，有同对影明月。"
      ],
      "author": {
        "id": 8618,
        "name": "辛弃疾"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
