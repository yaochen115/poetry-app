        "name": "七言绝句"
      }
    },
    {
      "id": 156018,
      "title": "赠墨林曹大崧",
      "content": [
        "巍峨幼妇碑，伶俜七步诗。",
        "又得墨林墨淋漓，凑作曹家三绝奇。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
