{
  "data": [
    {
      "id": 249085,
      "title": "尝建茗二首  其一",
      "content": [
        "破除汤饼睡，倚赖建溪春。",
        "往日惟求旧，今朝遽食新。",
        "不辞浓似粥，少待细于尘。",
        "宝胯无多子，留须我辈人。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 249086,
      "title": "尝建茗二首  其二",
      "content": [
        "茅宇已初夏，茶瓯方早春。",
        "真成汤沃雪，无复渴生尘。",
        "有客嘲三韭，其谁送八珍。",
        "不如藏去好，孤负一年新。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 249087,
      "title": "煎茶",
      "content": [
        "贫中有佳设，石鼎事煎烹。",
        "顾渚草芽白，惠山泉水清。",
        "酌多风可御，薫歇雾犹横。",
        "饮罢妻孥笑，枯肠百转鸣。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 249088,
      "title": "郑侍郎招赏瑞香感旧有作",
      "content": [
        "郑驿留宾处，看花又一年。",
        "香囊依叶密，锦繖向人圆。",
        "子敬新游岱，吾宗复在边。",
        "小诗相促迫，感旧一凄然。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 249089,
      "title": "榴花",
      "content": [
        "树阴看已合，榴朵见初明。",
        "当夏岂无意，避春真有情。",
        "花虽后文杏，实可待瓌橙。",
        "病叟缘何喜，留苔看落英。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 249090,
      "title": "九日小圃菊花有开者病疡不能泛一杯把玩而已",
      "content": [
        "黄菊开何许，疏篱小隐家。",
        "似知重九日，故放两三花。",
        "病著杯无渌，衰年发半华。",
        "佳辰辜负汝，满把但成嗟。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 249091,
      "title": "宫祠满秩",
      "content": [
        "云水天台郡，祠庭我所监。",
        "几年真傲吏，今日是前衔。",
        "禄米谁周急，园蔬不疗馋。",
        "上书端未免，定不达空函。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 249092,
      "title": "送曾宏甫守天台",
      "content": [
        "此地多朋好，惟君似弟兄。",
        "不堪轻作别，那得易为情。",
        "秋日行漓水，春风上赤城。",
        "莫言无过雁，略不寄佳声。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 249093,
      "title": "送戚弼甫解官盐场二首  其一",
      "content": [
        "听说君中外，堂堂世上名。",
        "文华张右史，正素老先生。",
        "已上三年课，相期万里程。",
        "赠行无好句，聊用一杯倾。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 249094,
      "title": "送戚弼甫解官盐场二首  其二",
      "content": [
        "访旧今无几，惟君昔有连。",
        "笑谈倾一坐，笔札富诸贤。",
        "作恶又数日，从游经二年。",
        "勉旃绳祖武，穷达自关天。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 249095,
      "title": "送李商叟",
      "content": [
        "好去皇华使，佳哉所领州。",
        "职除天禄阁，家近岳阳楼。",
        "一别谁青眼，相逢各白头。",
        "西来多驿骑，能寄短书不。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 249096,
      "title": "送绍兴张耆年教授之永嘉学官",
      "content": [
        "海内孤寒士，江头独冷官。",
        "胡为涉修阻，不肯近长安。",
        "蠲纸无留笔，生枝不带酸。",
        "名山天下少，行矣雪消残。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 249097,
      "title": "送洪州西山香城长老通公惠通",
      "content": [
        "闻说香城寺，孤峰叆叇间。",
        "公今怀祖印，老去入乡关。",
        "稳泛春波水，深藏暮雨山。",
        "笔头多语句，寄我不当悭。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 249098,
      "title": "逮子赴湖南漕司举寄之",
      "content": [
        "举子忙如此，槐花细细开。",
        "吾儿承诏去，有客附书来。",
        "鹤发风前帽，鸡头月下杯。",
        "衰年余几许，胜日不同陪。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 249099,
      "title": "逮子以今歳正月十六日之毗陵而以十二月十五日还舍铨试第二且得新雏以诗示之",
      "content": [
        "不见吾儿久，今朝慰眼前。",
        "分襟灯火夜，回櫂雪霜天。",
        "中鹄令人喜，将雏得我怜。",
        "一杯欢笑后，急急理尘编。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 249100,
      "title": "挽李泰发参政三首  其一",
      "content": [
        "公昔遭前政，忠精不少衰。",
        "立谈廷争地，上疏里居时。",
        "意气南山在，名声北斗垂。",
        "心知不亡者，送往得无悲。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 249101,
      "title": "挽李泰发参政三首  其二",
      "content": [
        "汉室推元礼，唐家得卫公。",
        "龙门倾后辈，鲸海伏孤忠。",
        "守护多神物，旋归一老翁。",
        "如何九江路，万事并成空。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 249102,
      "title": "挽李泰发参政三首  其三",
      "content": [
        "道义曾无间，因依遂有连。",
        "旋闻新雨露，亟返旧林泉。",
        "父老门庭下，儿孙几杖前。",
        "不令成此段，泣涕问苍天。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 249103,
      "title": "挽石参议",
      "content": [
        "人物千岩秀，家风万石余。",
        "刘侯深爱画，杜氏富藏书。",
        "卿寺曾亲擢，藩方有诏除。",
        "遽随丹旐去，老泪溅衣裾。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 249104,
      "title": "挽焦适道寺丞二首  其一",
      "content": [
        "气质推浑厚，言谈见切磋。",
        "过从方里巷，挽送忽山阿。",
        "吉士今如此，高穹定若何。",
        "交游虽不乏，耆旧已无多。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 249105,
      "title": "挽焦适道寺丞二首  其二",
      "content": [
        "岂意初秋事，俄闻远日期。",
        "在公无可憾，有客不胜悲。",
        "宅兆溪山好，郊原草木衰。",
        "给孤园上路，无复往还时。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 249106,
      "title": "挽陈丞相",
      "content": [
        "身已栖岩壑，公初冠庙堂。",
        "奉祠方德庇，次对复恩光。",
        "政尔为舟楫，如何坏栋梁。",
        "绋讴争点笔，衰谢独难忘。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 249107,
      "title": "挽梁元功谏议",
      "content": [
        "岂弟更三郡，题评冠一乡。",
        "绳愆御史疏，补阙谏臣章。",
        "直叹牙弦绝，明嗟魏鉴亡。",
        "皇情应震悼，追贲盛龙光。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 249108,
      "title": "挽程伯禹尚书三首  其一",
      "content": [
        "诚明犹博学，直谅更多闻。",
        "休父中兴杰，宣王上圣君。",
        "精忠自金石，感会合风云。",
        "不谓生刍奠，今来下马坟。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 249109,
      "title": "挽程伯禹尚书三首  其二",
      "content": [
        "璧水三千士，文闱第一人。",
        "煌煌持紫槖，亹亹逼鸿钧。",
        "得郡还辞剧，居家更乞身。",
        "期颐如可料，愁绝上元春。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 249110,
      "title": "挽程伯禹尚书三首  其三",
      "content": [
        "昔在宣和日，雍容接俊游。",
        "横经临璧沼，提椠上瀛洲。",
        "去德俄千里，依仁复两州。",
        "岂知垂老别，华屋落山丘。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 249111,
      "title": "挽王元渤舍人二首  其一",
      "content": [
        "早得文章誉，仍高政事科。",
        "珠玑随咳唾，襦袴起讴歌。",
        "老去贫逾甚，归来病更多。",
        "善人今已矣，施报果如何。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 249112,
      "title": "挽王元渤舍人二首  其二",
      "content": [
        "觞咏陪真率，言谈见坦夷。",
        "凄凉今日事，牢落暮年悲。",
        "有泪看诗卷，无情对酒巵。",
        "哀哉王子敬，吾党一何衰。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 249113,
      "title": "挽郑禹功",
      "content": [
        "山海淮壖利，吾徒职骏奔。",
        "长官惟我在，同事只公存。",
        "句法深深见，心宗细细论。",
        "清风今已矣，微月耿黄昏。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 249114,
      "title": "挽向伯恭侍郎三首  其一",
      "content": [
        "忠义云霄逼，声名日月悬。",
        "剧谈风满坐，杰作气无前。",
        "诗酒今彭泽，山林昔辋川。",
        "不随秋露尽，家集灿成编。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 249115,
      "title": "挽向伯恭侍郎三首  其二",
      "content": [
        "用舍行藏事，如公世所难。",
        "谁能奉香火，直作挂衣冠。",
        "国论言犹在，宸毫墨未干。",
        "一生无限好，留与后人看。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 249116,
      "title": "挽向伯恭侍郎三首  其三",
      "content": [
        "昔在儿童歳，曾陪竹马游。",
        "芗林叨共席，泛宅幸同舟。",
        "忽忽三年别，堂堂万事休。",
        "孤风亭下梦，犹记曩时不。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 249117,
      "title": "挽晁恭道侍郎二首  其一",
      "content": [
        "家令西京杰，文元圣世贤。",
        "大参名更重，学士集争传。",
        "此道长回首，惟公早比肩。",
        "呜呼百年半，赍志遂沈泉。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 249118,
      "title": "挽晁恭道侍郎二首  其二",
      "content": [
        "往日趋金马，中年剖玉麟。",
        "论思贰卿事，歌咏别都民。",
        "久矣穷诸妄，归欤契一真。",
        "东园尊俎地，俯仰迹成陈。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 249119,
      "title": "挽吕惇智直阁二首  其一",
      "content": [
        "吕卿豪杰士，家世两申公。",
        "小试为郎日，深知有祖风。",
        "名高中兴后，病著半生中。",
        "遂作青山去，呜呼万事空。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 249120,
      "title": "挽吕惇智直阁二首  其二",
      "content": [
        "历数交游内，公家雅有连。",
        "舍人先即世，驾部复沈泉。",
        "远讣闻今夏，高谈记昔年。",
        "离穷一片影，大似老夫然。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 249121,
      "title": "戏同诸孙课春日迟迟",
      "content": [
        "昼漏今多少，人闲只自知。",
        "帘垂春色静，窗度日华迟。",
        "柳影徐徐转，花阴缓缓移。",
        "助成耕野事，添得读书时。",
        "醉著三竿睡，忧来一局棋。",
        "吾徒须爱惜，看即是冬曦。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 249122,
      "title": "王履道左丞见访",
      "content": [
        "近市三椽屋，斜阳一席门。",
        "故人空厚禄，过我独高轩。",
        "转刻求巾屦，忘形奉笑言。",
        "性容安石缓，道许穆生存。",
        "暝色遥岑合，归途涨水浑。",
        "传呼听已远，依旧雀声喧。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 249123,
      "title": "雪中登王正中书阁",
      "content": [
        "对雪同谁语，登楼似欲仙。",
        "人家修月户，丈室散花天。",
        "山拥钩帘外，江横隐几前。",
        "寒深落雁渚，清集钓鱼船。",
        "扶病从摩诘，销忧得仲宣。",
        "展书明细字，烹茗湿疏烟。",
        "月好还同梦，诗成已下弦。",
        "明年傥相忆，一为到关边。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 249125,
      "title": "食蜂儿有感",
      "content": [
        "蜂儿虽小物，各自有君臣。",
        "夺食已非义，焚巢兹不仁。",
        "杀身缘底罪，作俑定何人。",
        "不惮高论直，宁辞远送珍。",
        "解包颜有喜，入坐齿生津。",
        "海错休前列，山肴且不陈。",
        "其谁心恻怛，为汝鼻酸辛。",
        "愿下孩虫令，恩倾雨露春。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 249126,
      "title": "辞召命呈子忱侍郎",
      "content": [
        "嬾慢无端世所遗，独怜衰病少光辉。",
        "惠然投我有华衮，何以报公无纻衣。",
        "末学虚声惭取誉，旧章多识恐成非。",
        "侍郎清鉴悬明镜，莫道尘埃一点飞。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 249127,
      "title": "王周士显谟自闽中归沩山旧隐道经临川惠然先辱且出示吕居仁送行诗有见及语因次其韵赠周士",
      "content": [
        "此生寡偶固其宜，何况身从老得衰。",
        "门外设罗谁一顾，道旁倾盖子相知。",
        "断金已定交逰事，伐木仍传故旧诗。",
        "闻说沩山堪避世，卜邻他日更无疑。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 249128,
      "title": "雪中陆务观数来问讯用其韵奉赠",
      "content": [
        "江湖迥不见飞禽，陆子殷勤有使临。",
        "问我家居谁暖眼，为言忧国只寒心。",
        "官军渡口战复战，贼垒淮壖深又深。",
        "坐看天威扫除了，一壶相贺小丛林。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 249129,
      "title": "陆务观效孔方四舅氏体倒用二舅氏题云门草堂韵某亦依韵",
      "content": [
        "陆子家风有自来，胸中所患郤多才。",
        "学如大令仓盛笔，文似若耶溪转雷。",
        "襟抱极知非世俗，簿书那解作氛埃。",
        "集贤旧体君拈出，诗卷从今盥水开。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 249130,
      "title": "以汤饼招韩伯周王岩起二提举郑深道曾宏甫二使君宏甫有诗次其韵",
      "content": [
        "镜湖淮渎旧刺史，庐阜赤城新使君。",
        "敢持汤饼一取饱，更用尊酒重论文。",
        "玉川遣奴致双鲤，吏部呼儿书八分。",
        "不如哦君七字句，举首看度南山云。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 249131,
      "title": "曾宏甫见招看海裳而郡城新有更初阖扉之令予闻鼔亟归一诗呈宏甫",
      "content": [
        "西蜀名花得许秾，晚来呼客醉花中。",
        "可怜朵朵枝枝弱，自占深深浅浅红。",
        "收拾虽微少陵老，宠光还有翰林公。",
        "无聊独出城闉去，烧烛看时恨不同。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 249132,
      "title": "次曾宏甫社日赏海棠吴守宅且试新茗韵",
      "content": [
        "一树深深地主家，外边谁复见秾华。",
        "却因社日治聋酒，得醉春时近眼花。",
        "著粉施朱俱惬当，吹风洗雨但惊嗟。",
        "酴釄芍药垂垂发，更试头纲一饼茶。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 249133,
      "title": "苏秀道中自七月二十五日夜大雨三日秋苖以苏喜而有作",
      "content": [
        "一夕骄阳转作霖，梦回凉冷润衣襟。",
        "不愁屋漏床床湿，且喜溪流岸岸深。",
        "千里稻花应秀色，五更桐叶最佳音。",
        "无田似我犹欣舞，何况田间望岁心。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 249134,
      "title": "喻子才提举招昌源观梅倦不克往苏仁仲有诗次韵",
      "content": [
        "问公何许看花回，賸说郊坰十里梅。",
        "树杂古今他处少，枝分南北一齐开。",
        "昌源已办行厨去，离渚犹须使节来。",
        "况复兰亭公所葺，清流九曲要传杯。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 249135,
      "title": "闻降湖北提盐",
      "content": [
        "一为散吏寄郊坰，三见南山木叶零。",
        "病著不能朝帝所，老来只合奉祠庭。",
        "绣衣玉节官仍作，流水桃花路再经。",
        "洞口故人应问我，淹留何处髪星星。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 249136,
      "title": "南山除夜",
      "content": [
        "薫风吹船落江潭，日月除尽犹湖南。",
        "百年忽已度强半，十事不能成二三。",
        "青编中语要细读，蒲团上禅须饱参。",
        "儿时颜状听渠改，潇湘水色深挼蓝。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 249137,
      "title": "喜闻天兵已临衢寇",
      "content": [
        "野宿溪行各晏然，吴头楚尾接风烟。",
        "岂知苻泽深为祟，不道柯山最近天。",
        "境上音邮多浪语，殿前兵马是真传。",
        "未能日报书三捷，竹簟纱厨到晓眠。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 249138,
      "title": "至日述事时江海大捷",
      "content": [
        "观台四望楚氛开，云物轮囷瑞九垓。",
        "大雪山阴消得尽，微阳井底放令回。",
        "江心皂帜千艘没，海角黄旗一骑来。",
        "想像天颜知有喜，正衙入贺荐金罍。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 249139,
      "title": "寄泉南守赵表之",
      "content": [
        "天遣高人下别峰，谅无官事汩胸中。",
        "香来海外沈烟碧，果熟林间荔子红。",
        "曹植诗篇疏入社，裴休参问远同风。",
        "萧然丈室维摩诘，何日文殊对此翁。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 249140,
      "title": "寄浙漕韩公圭琎",
      "content": [
        "故人官达更相求，不但寒温札翰投。",
        "深贮炉薫来岭海，远包书帙到林丘。",
        "未知挽粟飞刍外，尚及哦诗把酒不。",
        "千里往还殊不隔，梦魂常绕日边州。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 249141,
      "title": "寄浙东参议郑禹功",
      "content": [
        "忆昨分携自日边，星辰忽忽几回天。",
        "故人老作诸侯客，今我初无二顷田。",
        "安得诗书同保社，敢烦札翰访林泉。",
        "万山不隔襟期处，赖有渠侬一味禅。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 249142,
      "title": "寄十扇与陈述之",
      "content": [
        "饶阳轻箑人共知，封书寄与今其时。",
        "清风两腋想披拂，眀月千里能追随。",
        "一朝贵重得谢傅，中道捐弃怜班姬。",
        "吾徒且当置是事，鲁缟如雪题新诗。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 249143,
      "title": "寄信守徐穉山侍郎",
      "content": [
        "归去来兮莫问津，有船即买系江滨。",
        "自应一学陶元亮，不用更呼祁孔宾。",
        "已卜春前春后日，重寻水北水南人。",
        "使君为我新茅栋，数有书来意甚真。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 249144,
      "title": "寄何晋之直阁",
      "content": [
        "别来不寄一行书，贝叶琅函想自娱。",
        "喜得直庐新内阁，梦成同舍旧东都。",
        "绝知笔底鶱腾在，未省体中安隐无。",
        "见说闽山小儿子，夤缘即罢数趋隅。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 249145,
      "title": "寄提舶王季羔",
      "content": [
        "外台隐吏极风流，记得衰翁旧日不。",
        "三岛十洲曾接武，千岩万壑更从游。",
        "官曹闲似云间鹤，贾舶纷如海上鸥。",
        "幸有西湖应著我，时操艇子过明州。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 249146,
      "title": "抚州呈韩子苍待制",
      "content": [
        "一时翰墨颇横流，谁以斯文坐镇浮。",
        "后学不虚称吏部，此生曾是识荆州。",
        "相逢未改旧青眼，自笑无成今白头。",
        "闻道少林新得髓，离言语次许参不。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 249147,
      "title": "子苍携和章见过用韵为谢",
      "content": [
        "胡岭三年自窜流，归来差慰此生浮。",
        "政缘天下无双士，非为江东第一州。",
        "悬榻坐中难入眼，设罗门外少回头。",
        "袖诗不意高轩过，问里人曾到此不。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 249148,
      "title": "次子苍追忆馆中纳凉韵",
      "content": [
        "饭罢蓬瀛屧响廊，薫风啜茗倚绳床。",
        "草荒老氏藏书屋，山绕王家避世墙。",
        "汤饼承公荐槐绿，炉芬遣我梦芸香。",
        "欲论旧事愁无奈，愿挽天河作酒浆。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 249149,
      "title": "闻李泰发参政得旨自便将归以诗迓之",
      "content": [
        "苦遭前政堕危机，二十余年咏式微。",
        "天上谪仙皆欲杀，海滨大老竟来归。",
        "故园松菊犹存否，旧日人民果是非。",
        "最小郎君今弱冠，别时闻道不胜衣。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 249150,
      "title": "李子长县丞示诗卷",
      "content": [
        "乃祖天边太白星，裔孙名字见家声。",
        "官曹卑似崔斯立，句律清如庾义城。",
        "赠我不知相报答，投人政恐未分明。",
        "丞哉于子元无负，松竹成阴水乱鸣。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 249151,
      "title": "汪彦章内翰除守临川以诗贺之",
      "content": [
        "临川内史诏除谁，里巷传闻报客知。",
        "金马门深曾草制，水精宫冷近题诗。",
        "行看画省旌旗入，定把书麟笔札随。",
        "若访毗耶旧居士，无人问疾鬓成丝。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 249152,
      "title": "贺曾裘甫得解",
      "content": [
        "南风盛事昔无闻，乃祖词场笔有神。",
        "一牓豪英收几士，同年伯仲看三人。",
        "今君科第欲惊世，他日文章当致身。",
        "意惬归来能访我，亦令宗派倚生春。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 249153,
      "title": "吴元中少宰复官守长沙以诗贺之",
      "content": [
        "眼看乱后几凋年，神护灵光独岿然。",
        "镜里未添新白髪，囊中初得旧青氊。",
        "寄书地正当回雁，晤语身方走跕鸢。",
        "社稷于公端可卜，一篇江汉咏周宣。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 249154,
      "title": "题徐子礼自觉斋时子礼为江阴抱麾之行",
      "content": [
        "徐子长吟复短吟，奇书窗下日幽寻。",
        "谁知密密深深地，参得明明了了心。",
        "千里澄江空更濶，中秋素月古犹今。",
        "使君胸次端如许，愿以余光照所临。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 249155,
      "title": "题巾山广轩次韩无咎韵",
      "content": [
        "铃斋偪仄未销忧，暇日聊为帢帻游。",
        "乔木中间藏古寺，篮舆直上得名流。",
        "岂无云水连孤屿，亦有山林望一州。",
        "后日玉霄峰顶去，忆经行处为回头。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 249156,
      "title": "张子公招饭灵感院",
      "content": [
        "竹舆响肩舻哑呕，芙蕖城晓六月秋。",
        "露华犹泫草光合，晨气欲动荷香浮。",
        "给孤独园赖君到，伊蒲塞供为我羞。",
        "僧窗各自占山色，处处薫炉茶一瓯。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 249157,
      "title": "吕居仁力疾作诗送行次其韵",
      "content": [
        "雪屋风窗逼岁穷，一杯情话与谁同。",
        "向人寡偶无如我，抵老相知独有公。",
        "文字欲求千古事，簿书还费二年功。",
        "新诗已佩临分语，况复哦诗是病中。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 249158,
      "title": "次韩叔夏送行韵",
      "content": [
        "乃祖曾为文送穷，儿孙气味略相同。",
        "立朝有疏慕汲直，去国无书干子公。",
        "竹椅蒲团深著意，雪窗萤案坐收功。",
        "自怜无补朝廷事，又向蛮烟瘴雨中。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 249159,
      "title": "次苏守朱新仲舍人留会稽之行韵",
      "content": [
        "公知此老发船时，不作河梁送别诗。",
        "但说江湖留我住，为言岩壑与人期。",
        "凝香燕寝定自好，怀绶稽山无不宜。",
        "早晚欢迎剡溪上，去公亦复意迟迟。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 249160,
      "title": "适越留别朱新仲",
      "content": [
        "扁舟绿涨漕渠时，解释离怀政用诗。",
        "管鲍交朋无变态，朱陈嫁娶有佳期。",
        "长洲茂苑著身久，秦望镜湖行脚宜。",
        "二浙中间才一水，短书莫使寄来迟。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 249161,
      "title": "寓居有招客者戏成",
      "content": [
        "蓬蒿小院立秋天，秃鬓凄风雨飒然。",
        "丈室何人问摩诘，后堂无地著彭宣。",
        "床头白酒新浮瓮，案上黄诗屡绝编。",
        "不厌寒家淡生活，书窗期与子周旋。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 249162,
      "title": "次劝农韵",
      "content": [
        "典郡治中总得贤，郊原一出万人传。",
        "山行野渡时时雨，妇饷夫耕处处田。",
        "说与老农无罪歳，但当力作有逢年。",
        "驱儿播种贫家事，可奈西畴只仰天。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 249163,
      "title": "处守谢景思寄劝农诗次其韵",
      "content": [
        "使君小队出田间，郤拥旌旗鼔吹还。",
        "走送劳农诗俊逸，悬知领客事清闲。",
        "坐曹已白儿时鬓，置酒聊朱病后颜。",
        "无路从公上烟雨，梦魂长遶处州山。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 249164,
      "title": "乙卯岁江南大旱七月六日临川得雨奉呈程伯禹待制",
      "content": [
        "缥缈炉烟上帝阍，朝来一洗旱如焚。",
        "垄头无复成龟兆，水面初看起縠纹。",
        "政使夏畦炊白玉，未妨秋稼割黄云。",
        "使君闵雨心犹在，化得邦人不茹荤。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 249165,
      "title": "空公长老一出即住雪峰书来以建茗为寄长句奉呈空公时以笔砚作佛事也",
      "content": [
        "此公出世使人惊，道眼看来郤未曾。",
        "政尔雪峰千百众，澹然云水一孤僧。",
        "不妨诗笔作佛事，已用茗瓯传祖灯。",
        "我老尚堪行脚在，因风为寄古崖藤。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 249166,
      "title": "送曾宏甫赴光山守",
      "content": [
        "千里光山去拊循，长淮练静属城闉。",
        "开门自少公家事，领客宁无我辈人。",
        "网户得鱼肌切玉，兵厨有酒色镕银。",
        "老翁生死谁相访，札翰时时到水滨。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 249167,
      "title": "曾宏甫到光山遣送鹅梨淮鱼等数种",
      "content": [
        "吾宗席未暖淮滨，遣骑持书賸送珍。",
        "美实来从压沙寺，巨鱼长比藉糟人。",
        "欲雕好语略为报，但愧新诗如有神。",
        "领客不无桃李树，知君忆著故园春。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 249168,
      "title": "次秘丞李希声新省韵",
      "content": [
        "吾皇德泽小沧溟，倒载干戈不用刑。",
        "天以图书效河洛，人如兰玉秀堦庭。",
        "石渠尽日蓬山影，金殿凌虚帝座星。",
        "从此崇文三万卷，权舆甲部圣师经。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 249169,
      "title": "次何德器见赠韵",
      "content": [
        "德器交情素所敦，乃翁虽逝典型存。",
        "不惟歆向皆书府，况复封胡是相门。",
        "意气君方凌碧落，年龄我已到黄昏。",
        "今晨镜里如膏沐，欢喜仁人有赠言。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 249170,
      "title": "和李宗丞",
      "content": [
        "海邦西渡即朝廷，双阙琼台天下名。",
        "跋马望君真屡矣，拏舟过我太迟生。",
        "门阑不日登元礼，句律今朝得少卿。",
        "已办黄花一尊酒，有如江水莫寒盟。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 249171,
      "title": "次冯子容主簿信州筑居韵",
      "content": [
        "闻君卜居水云乡，欲往从之各异方。",
        "屋角树阴倾老盖，溪南山色过浮梁。",
        "薫风自在翻书叶，梅雨相欺败堵墙。",
        "长铗高歌归去好，幽栖为我觅阳冈。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 249172,
      "title": "郑深道饯曾宏甫台州之行见招风雨不能度溪桥作此赠宏甫",
      "content": [
        "一觞相属费招呼，况复吾宗揽辔初。",
        "春雨春风俱作恶，溪南溪北顿成疏。",
        "刻残红蜡君哦句，挑尽青灯我读书。",
        "细故乖违犹似此，功名不必问何如。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 249173,
      "title": "送曾宏甫守天台",
      "content": [
        "莫作阳关堕泪声，丹丘胜事要君听。",
        "兴公赋里云霞赤，子美诗中岛屿青。",
        "天近岂无宣室召，地偏犹有草堂灵。",
        "銮坡飞上勤回首，记取来游旧客星。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 249174,
      "title": "送李似举尚书帅桂州二首  其一",
      "content": [
        "桂林佳事我能言，四座停杯且勿喧。",
        "人物豪华真乐国，江山清绝胜中原。",
        "亲尝荔子薫风浦，静对梅花小雪村。",
        "边锁无虞庭少讼，不妨仙释问真源。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 249175,
      "title": "送李似举尚书帅桂州二首  其二",
      "content": [
        "整整三朝玉笋班，几年流落奉祠官。",
        "不令归曳尚书履，亦合先登大将坛。",
        "从昔南荒除帅重，只今西顾倚公寛。",
        "长途不惜身为御，欲上龙门自作难。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 249176,
      "title": "送周德修侍郎守武陵郡",
      "content": [
        "倾盖江头许定交，谈经论事听忘劳。",
        "辙环万里犹持橐，门掩三秋却梦刀。",
        "流水落花公境界，摘山煑海我官曹。",
        "人生五马从来贵，行乐何须叹二毛。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 249177,
      "title": "送王亚之",
      "content": [
        "执手河梁有赠言，樯乌端为小留连。",
        "无风浪起勤看客，不尽江来隐放船。",
        "烟雨楼台空梦到，云天鸿雁只书传。",
        "不须更问西归日，定是彤庭射策年。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 249178,
      "title": "送苏伯益提干代还侍下",
      "content": [
        "幕下官曹寄玉溪，溪边野老借光辉。",
        "啮毡校尉冲寒去，扇枕郎君触热归。",
        "大父正携灵寿杖，尊公更著老莱衣。",
        "赠行未说功名事，此事如公世上稀。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 249179,
      "title": "送王宣子赴庐陵守",
      "content": [
        "秋风送远庐陵守，车骑光华鬓未斑。",
        "早岁名高天下士，同时身到海中山。",
        "淹回二水分流处，邂逅千岩竞秀间。",
        "行矣衰翁如未死，锦衣白昼候君还。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 249180,
      "title": "送贺子忱参议之官闽中",
      "content": [
        "越侯宾客有辉光，领袖今年得望郎。",
        "诗似拾遗留剑外，才如处士去河阳。",
        "到时晚荔论园买，旧日春茶洗盏尝。",
        "璧水同寮几人在，賸将书疏及沧浪。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 249181,
      "title": "送路应求赴郢守",
      "content": [
        "一雨全清去路尘，石城风物话临分。",
        "了无狱讼劳官长，賸有江山奉使君。",
        "楼上今谁能和曲，鼻端那复可挥斤。",
        "吾人莫道知音少，千里欢谣入听闻。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 249182,
      "title": "送尹叔之象州",
      "content": [
        "歳星一别又回天，贫贱交情老更坚。",
        "传世典型清彻骨，向人怀抱直如弦。",
        "经营象郡三椽屋，漂泛龙城一叶船。",
        "风雨萧萧鸡自晓，此心常与子周旋。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 249183,
      "title": "送吕仓部治先守齐安",
      "content": [
        "齐安剖竹要循良，分付吾家坦腹郎。",
        "賸有江山连赤壁，略无讼狱到黄堂。",
        "铃斋昼永宜深念，边锁秋高合过防。",
        "此地元之余烈在，勉旃幸未鬓毛苍。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 249184,
      "title": "送周仲固寺正提举湖北茶盐余建炎己酉岁尝为此官",
      "content": [
        "洞庭湖北饱知闻，尝以輶轩犯楚氛。",
        "远有光华新令尹，分投闲散故将军。",
        "武陵源口自碧水，古德山头多白云。",
        "一路澄清纵幽讨，不妨书札细论文。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 249185,
      "title": "送方务德将漕广西时余亦有此除",
      "content": [
        "壮时一别鬓成丝，忽漫同盘又语离。",
        "底事不为三日款，相逢犹是半年迟。",
        "溪边赠策正杨柳，境上开尊应荔枝。",
        "莫叹峤南荒绝好，光华最有远人知。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
