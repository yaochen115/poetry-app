      }
    },
    {
      "id": 285168,
      "title": "晚眺",
      "content": [
        "凭古城边眺晚晴，远村高树转分明。",
        "天如镜面都来静，地似人心总不平。",
        "云向岭头闲不彻，水流溪里太忙生。",
        "谁人得及庄居老，免被荣枯宠辱惊。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285169,
      "title": "野花",
      "content": [
        "万点红芳血色殷，为无名字对空山。",
        "多映戏蜨寻香住，少有行人辍櫂攀。",
        "若在侯门看不足，为生江岸见如闲。",
        "结根必竟输桃李，长向春城紫陌间。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285170,
      "title": "病骢马",
      "content": [
        "枥上病骢蹄褭褭，江边废宅路迢迢。",
        "自经梅雨长垂耳，乍食菰浆欲折腰。",
        "金络衔头光未灭，玉花毛色瘦来焦。",
        "曾听禁漏惊街鼓，惯踏康庄怕小桥。",
        "夜半雄声心尚壮，日中高卧尾还摇。",
        "龙媒落地天池远，何事牵牛在碧霄。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 285171,
      "title": "狄浦",
      "content": [
        "晴川倚落晖，极目思依依。",
        "野色寒来浅，人家乱后稀。",
        "久贫身不达，多病意长违。",
        "还有渔舟在，时时梦里归。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 285172,
      "title": "南康道中",
      "content": [
        "弱冠负文翰，此中听鹿鸣。",
        "使君延上榻，时辈仰前程。",
        "丹桂竟多故，白云空有情。",
        "唯余路旁泪，霑洒向尘缨。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 285173,
      "title": "北固亭东望寄默师",
      "content": [
        "高亭暮色中，往事更谁同。",
        "水谩矜天阔，山应到此穷。",
        "病怜京口酒，老怯海门风。",
        "唯有言堪解，何由见远公。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
