{
  "data": [
    {
      "id": 285074,
      "title": "送姚安之赴任秋浦",
      "content": [
        "官罢春坊地象雷，片帆高指贵池开。",
        "五侯水暖鱼鳞去，九子山晴雁叙来。",
        "江夏黄童徒逞辩，广都庞令恐非才。",
        "到头称意须年少，赢得时光向酒杯。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285075,
      "title": "寄乔逸人",
      "content": [
        "南经湘浦北扬州，别后风帆几度游。",
        "春酒谁家禁烂熳，野花何处最淹留？",
        "欲凭尺素边鸿嬾，未定雕梁海燕愁。",
        "长短此行须入手，更饶君占一年秋。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285076,
      "title": "塞外",
      "content": [
        "塞外偷儿塞内兵，圣君宵旰望升平。",
        "碧幢未作朝廷计，白梃犹驱妇女行。",
        "可使御戎无上策，只应忧国是虚声。",
        "汉王第宅秦田土，今日将军已自荣。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285077,
      "title": "裴庶子除太仆卿因贺",
      "content": [
        "楚珪班序未为轻，莫惜良途副圣明。",
        "宫省旧推皇甫谧，寺曹今得夏侯婴。",
        "秩随科第临时贵，官逐簪裾到处清。",
        "应笑马安虚巧宦，四回迁转始为卿。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285078,
      "title": "咏史",
      "content": [
        "蠹简遗编试一寻，寂寥前事似如今。",
        "徐陵笔砚珊瑚架，赵胜宾朋瑇瑁簪。",
        "未必片言资国计，只应邪说动人心。",
        "九原郝泚何由起，虚误西蕃八尺金。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285079,
      "title": "中元夜泊淮口",
      "content": [
        "木叶回飘水面平，偶因孤棹已三更。",
        "秋凉雾露侵灯下，夜静鱼龙逼岸行。",
        "欹枕正牵题柱思，隔楼谁转遶梁声。",
        "锦帆天子狂魂魄，应过扬州看月明。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285080,
      "title": "寄池州郑员外",
      "content": [
        "兽遶朱轮酒满船，郡城萧洒贵池边。",
        "衣同莱子曾分笔，扇似袁宏别有天。",
        "九点好山楼上客，两行高柳雨中烟。",
        "陵阳百姓将何福，社舞村歌又一年。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285081,
      "title": "归梦",
      "content": [
        "陆海波涛渐渐深，一回归梦抵千金。",
        "路傍草色休多事，墙外莺声肯有心。",
        "日晚向隅悲断梗，夜阑浇酒哭知音。",
        "贪财败阵谁相悉，鲍叔如今不可寻。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285082,
      "title": "送溪州使君",
      "content": [
        "兵寇伤残国力衰，就中南土藉良医。",
        "凤衔泥诏辞丹阙，雕倚霜风上画旗。",
        "官职不须轻远地，生灵只是计临时。",
        "灞桥酒醆黔巫月，从此江心两所思。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285083,
      "title": "送霅川郑员外",
      "content": [
        "明时塞诏列分麾，东拥朱轮出帝畿。",
        "铜虎贵提天子印，银鱼荣傍老莱衣。",
        "歌听茗坞春山暖，诗咏苹洲暮鸟飞。",
        "知有掖垣南步在，可能须待政成归。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285084,
      "title": "酬寄右司李员外",
      "content": [
        "当年忆见桂枝春，自此清途未四旬。",
        "左省望高推健笔，右曹官重得名人。",
        "闲摛丽藻嫌秋兴，静猎遗编笑过秦。",
        "犹把随和向泥滓，应怜疎散任天真。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285085,
      "title": "莲塘驿",
      "content": [
        "莲塘馆东初日明，莲塘馆西行人行。",
        "隔林啼鸟似相应，当路好花疑有情。",
        "一梦不须追往事，数杯犹可慰劳生。",
        "莫言来去只如此，君看鬓边霜几茎。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285086,
      "title": "甘露寺火后",
      "content": [
        "六朝胜事已尘埃，犹有闲人怅望来。",
        "只道鬼神能护物，不知龙象自成灰。",
        "犀慙水府浑非怪，燕说吴宫未是灾。",
        "还识平泉故侯否，一生踪迹比楼台。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285087,
      "title": "春日登上元石头故城",
      "content": [
        "万里伤心极目春，东南王气只逡巡。",
        "野花相笑落满地，山鸟自惊啼傍人。",
        "谩道城池须险阻，可知豪杰亦埃尘。",
        "太平寺主惟轻薄，却把三公与贼臣。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285088,
      "title": "送宣武徐巡官",
      "content": [
        "傲睨公卿二十年，东来西去只悠然。",
        "白知关畔元非马，玄觉壶中别有天。",
        "汉帝诏衔应异日，梁王风雪是初筵。",
        "临行不惜刀圭便，愁杀长安买笑钱。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285089,
      "title": "冬暮寄裴郎中",
      "content": [
        "晓髪星星入镜宜，早年容易近年悲。",
        "敢言得事时将晚，只恐酬恩日渐迟。",
        "南国倾心应望速，东堂开口欲从谁。",
        "仙郎旧有黄金约，沥胆隳肝更祷祈。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285090,
      "title": "中元甲子以辛丑驾幸蜀四首 一",
      "content": [
        "子仪不起浑瑊亡，西幸谁人从武皇。",
        "四海为家虽未远，九州多事竟难防。",
        "已闻旰食思真将，会待畋游致假王。",
        "应感两朝巡狩迹，绿槐端正驿荒凉。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285091,
      "title": "中元甲子以辛丑驾幸蜀四首 二",
      "content": [
        "爪牙柱石两俱销，一点渝尘九土摇。",
        "敢恨甲兵为弃物，所嗟流品误清朝。",
        "几时睿算歼张角，何处愚人戴隗嚣？",
        "跪望嵕山重启告，可能余烈不胜妖。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285092,
      "title": "中元甲子以辛丑驾幸蜀四首 三",
      "content": [
        "邪气奔屯瑞气移，清平过尽到艰危。",
        "纵饶犬彘迷常理，不奈豺狼幸此时。",
        "九庙有灵思李令，三川悲忆恨张仪。",
        "可怜一曲还京乐，重对红蕉教蜀儿。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285093,
      "title": "中元甲子以辛丑驾幸蜀四首 四",
      "content": [
        "白丁攘臂犯长安，翠辇苍黄路屈盘。",
        "丹凤有情尘外远，玉龙无迹渡头寒。",
        "静怜贵族谋身易，危惜文皇创业难。",
        "不将不侯何计是，钓鱼船上泪阑干。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285094,
      "title": "题润州妙善前石羊",
      "content": [
        "紫髯桑盖此沈吟，很石犹存事可寻。",
        "汉鼎未安聊把手，楚醪虽满肯同心。",
        "英雄已往时难问，苔藓何知日渐深。",
        "还有市鄽沽酒客，雀喧鸠聚话蹄涔。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285095,
      "title": "登宛陵条风楼寄窦常侍",
      "content": [
        "乱罹时节懒登临，试借条风半日吟。",
        "只有远山含煖律，不知高阁动归心。",
        "溪喧晚棹千声浪，云护寒郊数丈阴。",
        "自笑疎慵似麇鹿，也教台上费黄金。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285096,
      "title": "台城",
      "content": [
        "晚云阴暎下空城，六代累累夕照明。",
        "玉井已干龙不起，金瓯虽破虎曾争。",
        "亦知霸世才难得，却是蒙尘事最平。",
        "深谷作陵山作海，茂弘流辈莫伤情。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285097,
      "title": "甘露寺看雪上周相公",
      "content": [
        "筛寒洒白乱溟蒙，祷请功兼造化功。",
        "光薄乍迷京口月，影交初展海门风。",
        "细黏谢客衣裾上，轻堕梁王酒醆中。",
        "一种为祥君看取，半禳灾沴半年丰。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285098,
      "title": "寄京阙陆郎中昆仲",
      "content": [
        "柏台兰署四周旋，宾榻何妨雁影连。",
        "才见玳簪欹细柳，便知油幕胜红莲。",
        "家从入洛声名大，迹为依刘事分偏。",
        "争奈乱罹人渐少，麦城新赋许谁传。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285099,
      "title": "偶题",
      "content": [
        "钟陵醉别十余春，重见云英掌上身。",
        "我未成名君未嫁，可能俱是不如人。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 285100,
      "title": "故都",
      "content": [
        "江南江北两风流，一作迷津一拜侯。",
        "至竟不如隋炀帝，破家犹得到扬州。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 285101,
      "title": "董仲舒",
      "content": [
        "灾变儒生不合闻，谩将刀笔指乾坤。",
        "偶然留得阴阳术，闭却南门又北门。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 285102,
      "title": "献尚父大王",
      "content": [
        "数年铁甲定东瓯，夜渡江山瞻斗牛。",
        "今日朱方平殄后，虎符龙节十三州。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 285103,
      "title": "蜂",
      "content": [
        "不论平地与山尖，无限风光尽被占。",
        "采得百花成蜜后，为谁辛苦为谁甜。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 285104,
      "title": "帘二首 一",
      "content": [
        "叠影重纹暎画堂，玉钩银烛共荧煌。",
        "会应得见神仙在，休下真珠十二行。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 285105,
      "title": "帘二首 二",
      "content": [
        "翡翠佳名世共稀，玉堂高下巧相宜。",
        "殷勤为嘱纤纤手，卷上银钩莫放垂。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 285106,
      "title": "送顾云下第",
      "content": [
        "行行杯酒莫辞频，怨叹劳歌两未伸。",
        "汉帝后宫犹识字，楚王前殿更无人。",
        "年深旅舍衣裳敝，潮打村田活计贫。",
        "百岁都来多几日，不堪相别又伤春。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285107,
      "title": "村桥",
      "content": [
        "村桥酒斾月明楼，偶逐渔舟系叶舟。",
        "莫学鲁人疑海鸟，须知庄叟恶牺牛。",
        "心寒已分灰无焰，事往曾将水共流。",
        "除却思量太平在，肯抛疎散换公侯。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285108,
      "title": "送刘校书之新安寄吴常侍",
      "content": [
        "野云如火照行尘，会绩溪边去问津。",
        "才子省衔非幕客，楚君科第是同人。",
        "狂思下国千场醉，病负东堂两度春。",
        "他日酒筵应见问，鹿裘渔艇隔朱轮。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285109,
      "title": "官池秋夕",
      "content": [
        "池边月影闲婆娑，池上醉来成短歌。",
        "芙渠抵死怨珠露，蟋蟀苦口嫌金波。",
        "往事向人言不得，旧游临老恨空多。",
        "松醪作酒兰为棹，十载烟尘奈尔何。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285110,
      "title": "奉使宛陵别二三从事",
      "content": [
        "梁王雪里有深知，偶别家乡隔路岐。",
        "官品共传胜曩日，酒杯争肯忍当时。",
        "豫章地暖矜千尺，越峤天寒愧一枝。",
        "还有钓鱼蓑笠在，不堪风雨失归期。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285111,
      "title": "金陵思古",
      "content": [
        "杜秋在时花解言，杜秋死后花更繁。",
        "柔姿曼态葬何处，天红腻白愁荒原。",
        "高洞紫箫吹梦想，小窗残雨湿精魂。",
        "绮筵金缕无消息，一阵征帆过海门。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285112,
      "title": "送王使君赴苏台",
      "content": [
        "东南一望可长吁，犹忆王孙领虎符。",
        "两地干戈连越绝，数年麋鹿卧姑苏。",
        "疲甿赋重全家尽，旧族兵侵太半无。",
        "料得伍员兼旅寓，不妨招取好揶揄。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285113,
      "title": "忆九华",
      "content": [
        "九华巉崪荫柴扉，长忆前时此息机。",
        "黄菊倚风村酒熟，绿蒲低雨钓鱼归。",
        "干戈已是三年别，尘土那堪万事违。",
        "回首佳期恨多少，夜阑霜露又霑衣。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285114,
      "title": "送裴饶归会稽",
      "content": [
        "金庭路指剡川隈，珍重良朋自此来。",
        "两鬓不堪悲岁月，一巵犹得话尘埃。",
        "家通曩分心空在，世逼横流眼未开。",
        "笑杀山阴雪中客，等闲乘兴又须回。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285115,
      "title": "送程尊师之晋陵",
      "content": [
        "栋间云出认行轩，郊外阴阴夏木繁。",
        "高道乍为张翰侣，使君兼是世龙孙。",
        "溪含句曲清连底，酒贳余杭渌满罇。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 285116,
      "title": "吴门晚泊寄句曲道友",
      "content": [
        "采香径在人不留，采香径下停叶舟。",
        "桃花李花鬬红白，山鸟水鸟自献酬。",
        "十万梅𫓶空寸土，三分孙策竟荒丘。",
        "未知到了关身否，笑杀雷平许远游。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285117,
      "title": "贵池晓望",
      "content": [
        "稂莠参天剪未平，且乘孤櫂且行行。",
        "计疎狡兔无三窟，羁甚宾鸿欲一生。",
        "合眼亦知非本意，伤心其奈是多情。",
        "前溪好泊谁为主，昨夜沙禽占月明。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285118,
      "title": "寄崔庆孙",
      "content": [
        "故人何处又留连，月冷风高镜水边。",
        "文阵解围才昨日，醉乡分袂已三年。",
        "交情澹泊应长在，俗态流离且勉旃。",
        "还拟山阴一乘兴，雪寒难得渡江船。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285119,
      "title": "寄杨秘书",
      "content": [
        "萧萧檐雪打窗声，因忆江东阮步兵。",
        "两信海潮书不达，数峰稽岭眼长明。",
        "梅繁几处垂鞭看，酒好何人倚槛倾。",
        "会待与君开秫瓮，满船般载镜中行。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285120,
      "title": "酬章处士见寄",
      "content": [
        "中原甲马未曾安，今日逢君事万端。",
        "乱后几回乡梦隔，别来何处路行难。",
        "霜鳞共落三门浪，雪鬓同归七里滩。",
        "何必新诗更相戏，小楼吟罢暮天寒。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285121,
      "title": "送丁明府赴紫溪任",
      "content": [
        "金徽玉轸肯躇[蹰]，偶滞良途半月余。",
        "楼上酒阑梅拆后，马前山好雪晴初。",
        "栾公社在怜乡树，潘令花繁贺版舆。",
        "县谱莫辞留旧本，异时量度更何如。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285122,
      "title": "寄前宣州窦常侍",
      "content": [
        "往年西谒谢玄晖，罇酒留欢醉始归。",
        "曲槛柳浓莺未老，小园花煖蝶初飞。",
        "喷香瑞兽金三尺，舞雪佳人玉一围。",
        "今日乱罹寻不得，满蓑风雨钓鱼矶。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285123,
      "title": "秦望山僧院",
      "content": [
        "巉巉危岫倚沧洲，闻说秦皇亦此游。",
        "霸主卷衣才二世，老僧传锡已千秋。",
        "阴崖水赖松梢直，藓壁苔侵画像愁。",
        "各是病来俱未了，莫将烦恼问汤休。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285124,
      "title": "送光禄崔卿赴阙",
      "content": [
        "一年极目望西辕，此日殷勤圣主恩。",
        "上国已留虞寄命，中朝应听范汪言。",
        "官从府幕归卿寺，路向干戈见禁门。",
        "鹓侣寂寥曹署冷，更堪呜咽问田园。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285125,
      "title": "寄程尊师",
      "content": [
        "鹤信虽然到五湖，烟波迢遰路崎岖。",
        "玉书分薄花生眼，金鼎功迟雪满须。",
        "三秀紫芝劳梦寐，一番红槿恨朝晡。",
        "未知朽败凡间骨，中授先生指教无。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285126,
      "title": "定远楼",
      "content": [
        "前年上将定妖氛，曾筑岩城驻大军。",
        "近日关防虽弛柝，旧时栏槛尚侵云。",
        "蛮兵绩盛人皆伏，坐石名高世共闻。",
        "唯恐乱来良吏少，不知谁解叙功勋。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285127,
      "title": "送程尊师东游有寄",
      "content": [
        "华盖峰前拟卜耕，主人无奈又闲行。",
        "且凭鹤驾寻沧海，又恐犀轩过赤城。",
        "绛简便应朝右弼，紫旄兼合见东卿。",
        "劝君莫忘归时节，芝似萤光处处生。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285128,
      "title": "江亭别裴饶",
      "content": [
        "行杯且待怨歌终，多病怜君事事同。",
        "衰鬓别来光景里，故乡归去乱罹中。",
        "乾坤垫裂三分在，井邑摧残一半空。",
        "日晚长亭问西使，不堪车马尚萍蓬。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285129,
      "title": "江南寄所知周仆射",
      "content": [
        "曾陪公子醉西园，岘首碑前事嬾言。",
        "世乱共嗟王粲老，时危俱受信陵恩。",
        "潮怜把醆吟江徼，雨忆凭阑望海门。",
        "飞盖寂寥清宴罢，不知簪履更谁存。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 285130,
      "title": "钱唐见芮逢",
      "content": [
        "蔡伦池北雁峰前，罹乱相兼十九年。",
        "所喜故人犹会面，不堪良牧已重泉。",
        "醉思把筯欹歌席，狂忆判身入酒船。",
        "今日与君赢得在，戴家湾里两皤然。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285131,
      "title": "江都",
      "content": [
        "淮王高䜩动江都，曾忆狂生亦坐隅。",
        "九里楼台牵翡翠，两行鸳鹭踏真珠。",
        "歌听丽句秦云咽，诗转新题蜀锦铺。",
        "惆怅晋阳星拆后，世间兵革地荒芜。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285132,
      "title": "湖上岁暮感怀有寄友人",
      "content": [
        "雪天萤席几辛勤，同志当时四五人。",
        "兰版地寒俱[受]露，桂堂风恶独伤春。",
        "音书久绝应埋玉，编简难言竟委尘。",
        "唯有广都庞令在，白头罇酒忆交亲。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285133,
      "title": "送张绾游钟陵",
      "content": [
        "南忆龙沙两岸行，当时天下尚清平。",
        "醉眠野寺花方落，吟倚江楼月欲明。",
        "老去亦知难重到，乱来争肯不牵情。",
        "西山十二真人在，从此烦君语姓名。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285134,
      "title": "送{巩/言}光大师",
      "content": [
        "禹祠分首戴湾逢，健笔寻知达九重。",
        "圣主赐衣怜绝艺，侍臣摛藻许高踪。",
        "宁亲久别街西寺，待诏初离海上峰。",
        "一种苦心师得了，不须回首笑龙钟。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285135,
      "title": "息夫人庙",
      "content": [
        "百雉摧残连野青，庙门犹见昔朝廷。",
        "一生虽抱楚王恨，千载终为息地灵。",
        "虫网翠环终缥缈，风吹宝瑟助微冥。",
        "玉颜浑似羞来客，依旧无言照画屏。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285136,
      "title": "漂母冢",
      "content": [
        "寂寂荒坟一水滨，芦洲绝岛自相亲。",
        "青娥已落淮边月，白骨甘为泉下尘。",
        "原上荻花飘素髪，道傍菰叶碎罗巾。",
        "虽然寂寞千秋魄，犹是韩侯旧主人。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285137,
      "title": "感怀",
      "content": [
        "石径松轩亦自由，谩随浮世逐飘流。",
        "驽骀路结前程恨，蟋蟀床生半夜秋。",
        "揜耳恶闻宫妾语，低颜须向路人羞。",
        "虽教小事相催逼，未到青云拟白头。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285138,
      "title": "扇上画牡丹",
      "content": [
        "为爱红芳满砌堦，教人扇上画将来。",
        "叶随彩笔参差长，花逐轻风吹第开。",
        "闲挂几曾停蛱蜨，频摇不怕落莓苔。",
        "根生无地如仙桂，疑是姮娥月里栽。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285139,
      "title": "书怀",
      "content": [
        "钓船抛却异乡来，拟向何门用不才。",
        "日晚独登楼上望，马蹄车辙满尘埃。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 285140,
      "title": "七夕",
      "content": [
        "月帐星房次第开，两情惟恐曙光催。",
        "时人不用穿针待，没得心情送巧来。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 285141,
      "title": "柳",
      "content": [
        "一簇青烟锁玉楼，半垂阑畔半垂沟。",
        "明年更有新条在，绕乱春风卒未休。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 285142,
      "title": "罗敷水",
      "content": [
        "雉声角角野田春，试驻征车问水滨。",
        "数树枯桑虽不语，思量应合识秦人。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 285143,
      "title": "京中正月七日立春",
      "content": [
        "一二三四五六七，万木生芽是今日。",
        "远天归雁拂云飞，近水游鱼迸冰出。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 285144,
      "title": "贵游",
      "content": [
        "馆陶园外雨初晴，绣毂香车入凤城。",
        "八尺家僮三尺箠，何知高祖要苍生。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 285145,
      "title": "严陵滩",
      "content": [
        "中都九鼎勤英髦，渔钓牛蓑且遁逃。",
        "世祖升遐夫子死，原陵不及钓台高。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 285146,
      "title": "虚白堂前牡丹相传云太傅手植在钱塘",
      "content": [
        "欲询往事奈无言，六十年来托此根。",
        "香暖几飘袁虎扇，格高常对孔融罇。",
        "曾忧世乱阴难合，且喜春残色上存。",
        "莫背阑干便相笑，与君俱受主人恩。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285147,
      "title": "县斋秋晚酬友人朱瓒见寄",
      "content": [
        "中和节后捧琼瑰，坐读行吟数月来。",
        "只叹雕龙方擅价，不知赪尾竟空回。",
        "千枝白露陶潜柳，百尺黄金郭隗台。",
        "惆怅报君无玉案，水天东望一裴回。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285148,
      "title": "第五将军于余杭天柱宫入道因题寄",
      "content": [
        "交棃火枣味何如，闻说苕川已下车。",
        "瓦榼尚携京口酒，草堂应写颍阳书。",
        "亦知得意须乘鹤，未必忘机便钓鱼。",
        "欲恐武皇还望祀，软轮征入问玄虚。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285149,
      "title": "寄无相禅师",
      "content": [
        "老住西峰第几层，为师回首忆南能。",
        "有缘有相应非佛，无我无人始是僧。",
        "烂椹作袍名复利，铄金为讲爱兼憎。",
        "何如一衲尘埃外，日日香烟夜夜灯。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285150,
      "title": "秋日有寄",
      "content": [
        "丹青未合便回头，见尽人闲事始休。",
        "只有百神朝宝镜，永无纤浪犯虚舟。",
        "曾临铁瓮虽分职，近得金陵亦偶游。",
        "东去西来人不会，上卿踪迹本玄洲。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285151,
      "title": "送前南昌崔令替任映摄新城县",
      "content": [
        "五年苛政甚虫螟，深喜夫君已戴星。",
        "大族不唯专礼乐，上才终是惜生灵。",
        "亦知单父琴犹在，莫厌东归酒未醒。",
        "二月春风何处好，亚夫营畔柳青青。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285152,
      "title": "下第作",
      "content": [
        "年年模样一般般，何似东归把钓竿。",
        "嵒谷谩劳思雨露，彩云终是逐鹓鸾。",
        "尘迷魏阙身应老，水到吴门叶欲残。",
        "至竟穷途也须达，才能长与世人看。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285153,
      "title": "丁亥岁作",
      "content": [
        "病想医门渴望梅，十年心地仅成灰。",
        "早知世事长如此，自是孤寒不合来。",
        "谷畔气浓高蔽日，蛰边声煖乍闻雷。",
        "满城桃李君看取，一一还从旧处开。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285154,
      "title": "北邙山",
      "content": [
        "一种山前路入秦，嵩山堪爱此伤神。",
        "魏明未死虚留意，庄叟虽生酌满巾。",
        "何必更寻无主骨，也知曾有弄权人。",
        "羡他缑岭吹箫客，闲访云头看俗尘。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285155,
      "title": "重过三衢哭孙员外",
      "content": [
        "烂柯山下忍重到，双桧楼前日欲残。",
        "华屋未移春照灼，故侯何在泪汍澜。",
        "不唯济物工夫大，长忆容才尺度宽。",
        "一恸旁人莫相笑，知音衰尽路行难。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285156,
      "title": "送蕲州裴员外",
      "content": [
        "六枝仙桂最先春，萧洒高辞九陌尘。",
        "两晋家声须有主，六朝文雅别无人。",
        "荣驱豹尾抛同辈，贵上螭头见近臣。",
        "蕲水苍生莫相羡，早看归去掌丝纶。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285157,
      "title": "重九日广陵道中",
      "content": [
        "秋山抱病何处登，前时韦曲今广陵。",
        "广陵大醉不解闷，韦曲旧游堪拊膺。",
        "佳节纵饶随分过，流年无奈得人憎。",
        "却驱羸马向前去，牢落路岐非所能。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285158,
      "title": "东归别所知",
      "content": [
        "芙蓉宫阙二妃坛，两处因依五岁寒。",
        "邹律有风吹不变，郄枝无分住应难。",
        "愁心似火还烧鬓，别泪非珠谩落盘。",
        "却羡淮南好鸡犬，也能终始逐刘安。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285159,
      "title": "旅舍书怀寄所知二首 一",
      "content": [
        "思量前事不堪寻，牢落余情满素琴。",
        "四海岂无腾跃路，一家长有别离心。",
        "道从汩没甘雌伏，迹恐因循更陆沈。",
        "寂寞谁应吊空馆，异乡时节独霑襟。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285160,
      "title": "旅舍书怀寄所知二首 二",
      "content": [
        "簟卷两床琴瑟秋，暂凭前计奈相尤。",
        "尘飘马尾甘蓬转，酒忆江边有梦留。",
        "隋帝旧祠虽寂寞，楚妃清唱亦风流。",
        "可怜别恨无人见，独背残阳下寺楼。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285161,
      "title": "西京道中",
      "content": [
        "半夜秋声独断蓬，百年身事筭成空。",
        "祢生词赋抛江夏，汉祖精神忆沛中。",
        "未必他时能富贵，只应从此见穷通。",
        "边禽陇水休相笑，自有沧洲一棹风。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285162,
      "title": "粉",
      "content": [
        "每持纤白助君时，霜自无憀雪自疑。",
        "郎若姓何应解傅，女能窥宋不劳施。",
        "妆成丽色唯花妬，落尽啼痕只镜知。",
        "最好玉京仙署里，更知秋月照琼枝。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285163,
      "title": "赠渔翁",
      "content": [
        "叶艇悠扬鹤髪垂，生涯空托一纶丝。",
        "是非不向眼前起，寒暑任从波上移。",
        "风瀁长歌笼月里，梦和春雨昼眠时。",
        "逍遥此意谁人会，应有青山渌水知。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 285164,
      "title": "下第寄张坤",
      "content": [
        "谩费精神掉五侯，破琴孤劒是身讐。",
        "九衢护阙拟何去，玉垒铜梁空旧游。",
        "蝴蝶有情牵晚梦，杜鹃无赖伴春愁。",
        "思量不及张公子，经岁池江倚酒楼。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285165,
      "title": "东归别常修",
      "content": [
        "六载辛勤九陌中，却寻归路五湖东。",
        "名慙桂苑一枝绿，鲙忆松江两筯红。",
        "浮世到头须适性，男儿何必尽成功。",
        "唯慙鲍叔深知我，他日蒲帆百尺风。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285166,
      "title": "言",
      "content": [
        "珪玷由来尚可磨，似簧终日复如何。",
        "成名成事皆因慎，亡国亡家只为多。",
        "须信祸胎生利口，莫将讥思逞悬河。",
        "猩猩鹦鹉无端解，长向人间被网罗。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 285167,
      "title": "简令生日",
      "content": [
        "祥烟霭霭拂楼台，庆积玄元节后来。",
        "已向青阳标四序，便从嵩岳应三台。",
        "龟衔玉柄增年筭，鹤舞琼筵献寿杯。",
        "自顾下儒何以祝，柱天功业济时才。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
