{
  "data": [
    {
      "id": 365738,
      "title": "夜泊毗陵无锡县有寄",
      "content": [
        "草虫幽咽树初团，独系孤舟夜已阑。",
        "浊浪势奔吴苑急，",
        "他日亲朋应大笑，始知书剑是无端。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365739,
      "title": "桃花",
      "content": [
        "暖触衣襟漠漠香，间梅遮柳不胜芳。",
        "数枝艳拂文君酒，",
        "旧山山下还如此，回首东风一断肠。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365740,
      "title": "筹笔驿",
      "content": [
        "抛掷南阳为主忧，北征东讨尽良筹。",
        "时来天地皆同力，",
        "唯余岩下多情水，犹解年年傍驿流。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365741,
      "title": "重过随州故兵部李侍郎恩知因抒长句",
      "content": [
        "庄周高论伯牙琴，闲夜思量泪满襟。",
        "四海共谁言近事，",
        "惭愧苍生还有意，解歌襦袴至如今。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365742,
      "title": "商于驿楼东望有感",
      "content": [
        "山川去接汉江东，曾伴隋侯醉此中。",
        "歌绕夜梁珠宛转，",
        "惆怅知音竟难得，两行清泪白杨风。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365743,
      "title": "寄南城韦逸人",
      "content": [
        "杜甫诗中韦曲花，至今无赖尚豪家。",
        "美人晓折露沾袖，",
        "羡他南涧高眠客，春去春来任物华。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365744,
      "title": "梅花",
      "content": [
        "吴王醉处十余里，照野拂衣今正繁。",
        "经雨不随山鸟散，",
        "欲寄所思无好信，为人惆怅又黄昏。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365745,
      "title": "淮南高骈所造迎仙楼",
      "content": [
        "鸾音鹤信杳难回，凤驾龙车早晚来。",
        "仙境是谁知处所，",
        "子细思量成底事，露凝风摆作尘埃。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365746,
      "title": "和禅月大师见赠",
      "content": [
        "高僧惠我七言诗，顿豁尘心展白眉。",
        "秀似谷中花媚日，",
        "漂荡秦吴十余载，因循犹恨识师迟。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365747,
      "title": "谒文宣王庙",
      "content": [
        "晚来乘兴谒先师，松柏凄凄人不知。",
        "九仞萧墙堆瓦砾，",
        "傥使小儒名稍立，岂教吾道受栖迟。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365748,
      "title": "代文宣王答",
      "content": [
        "三教之中儒最尊，止戈为武武尊文。",
        "吾今尚自披蓑笠，",
        "若教颜闵英灵在，终不羞他李老君。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365749,
      "title": "重送朗州张员外",
      "content": [
        "朱轮此去正春风，且驻青云听断蓬。",
        "一榻早年容孺子，",
        "酬德酬恩两无路，谩劳惆怅凤城东。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365750,
      "title": "广陵秋夜读进士常修三篇因题",
      "content": [
        "入蜀归吴三首诗，藏于笥箧重于师。",
        "剑关夜读相如听，",
        "明年二月春风里，江岛闲人慰所思。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365751,
      "title": "逼试投所知",
      "content": [
        "桃在仙翁旧苑傍，暖烟轻霭扑人香。",
        "十年此地频偷眼，",
        "寻思仙骨终难得，始与回头问玉皇。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365752,
      "title": "汉江上作",
      "content": [
        "汉江波浪渌于苔，每到江边病眼开。",
        "半雨半风终日恨，",
        "对此空惭圣明代，忍教缨上有尘埃。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365753,
      "title": "秋夜寄进士顾荣",
      "content": [
        "秋河耿耿夜沉沉，往事三更尽到心。",
        "多病谩劳窥圣代，",
        "空羡良朋尽高价，可怜东箭与南金。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365754,
      "title": "寄渭北徐从事",
      "content": [
        "暖云慵堕柳垂条，骢马徐郎过渭桥。",
        "官秩旧参荀秘监，",
        "莫恨东风促行李，不多时节却归朝。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365755,
      "title": "徐寇南逼感事献江南知己次韵",
      "content": [
        "酒阑离思浩无穷，西望维扬忆数公。",
        "万里飘零身未了，",
        "今日便成卢子谅，满襟珠泪堕霜风。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 365756,
      "title": "寄三衢孙员外",
      "content": [
        "小敷文伯见何时，南望三衢渴复饥。",
        "天子未能崇典诰，",
        "尽是数旬陪奉处，使君争肯不相思。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365757,
      "title": "淮南送卢端公归台",
      "content": [
        "凤鸾势逸九霄宽，北去南来任羽翰。",
        "朱绂两参王俭府，",
        "应笑张纲谩生事，埋轮不得在长安。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365763,
      "title": "秦纪",
      "content": [
        "长策东鞭及海隅，鼋鼍奔走鬼神趋。",
        "怜君未到沙丘日，肯信人间有死无。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 365765,
      "title": "咏月",
      "content": [
        "湖上风高动白苹，暂延清景此逡巡。",
        "来年违别成何事，",
        "嫦娥老大应惆怅，倚泣苍苍桂一轮。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365766,
      "title": "宿荆州江陵驿",
      "content": [
        "西游象阙愧知音，东下荆溪称越吟。",
        "风动芰荷香四散，",
        "薜荔衣裳木兰楫，异时烟雨好追寻。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365767,
      "title": "抚州别阮兵曹",
      "content": [
        "雪晴天外见诸峰，幽轧行轮有去踪。",
        "内史宅边今独恨，",
        "若不他时更青眼，未知谁肯荐临邛。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365768,
      "title": "新安投所知",
      "content": [
        "少年容易舍樵渔，曾辱明公荐子虚。",
        "汉殿夜寒时不食，",
        "长剑一寻歌一奏，此心争肯为鲈鱼。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365769,
      "title": "江边有寄",
      "content": [
        "江边旧业半雕残，每轸归心即万端。",
        "狂折野梅山店暖，",
        "同病同忧更何事，为君提笔划渔竿。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365770,
      "title": "送友人归夷门",
      "content": [
        "二年流落大梁城，每送君归即有情。",
        "别路算来成底事，",
        "至竟男儿分应定，不须惆怅谷中莺。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 365771,
      "title": "湘中见进士乔诩",
      "content": [
        "吴公台下别经秋，破虏城边暂驻留。",
        "一笑有情堪解梦，",
        "且酌松醪依旧醉，谁能相见向春愁。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365772,
      "title": "上霅川裴郎中",
      "content": [
        "贵提金印出咸秦，潇洒江城两度春。",
        "一派水清疑见胆，",
        "自是受恩心未足，却垂双翅羡吴均。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365773,
      "title": "钱塘江潮",
      "content": [
        "怒声汹汹势悠悠，罗刹江边地欲浮。",
        "漫道往来存大信，",
        "至竟朝昏谁主掌，好骑赪鲤问阳侯。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365774,
      "title": "送人赴职任褒中",
      "content": [
        "物态时情难重陈，夫君此去莫伤春。",
        "男儿只要有知己，",
        "海棠花谢东风老，应念京都共苦辛。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365775,
      "title": "临川投穆中丞",
      "content": [
        "试将生计问蓬根，心委寒灰首戴盆。",
        "翅弱未知三岛路，",
        "家在碧江归不得，十年鱼艇长苔痕。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365776,
      "title": "早春送张坤归大梁",
      "content": [
        "萧萧羸马正尘埃，又送輶轩向吹台。",
        "别酒莫辞今夜醉，",
        "为谢东门抱关吏，不堪惆怅满离杯。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365777,
      "title": "东归途中作",
      "content": [
        "松橘苍黄覆钓矶，早年生计近年违。",
        "老知风月终堪恨，",
        "买臣严助精灵在，应笑无成一布衣。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365778,
      "title": "送进士臧𣸣下第后归池州",
      "content": [
        "赋成无处换黄金，却向春风动越吟。",
        "天子爱才虽仄席，",
        "珍重彩衣归正好，莫将闲事系升沈。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365779,
      "title": "湘中赠范郧",
      "content": [
        "丹桂无心彼此谙，二年疏懒共江潭。",
        "愁知酒醆终难舍，",
        "劳歌一曲霜风暮，击折湘妃白玉簪。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365780,
      "title": "寄张侍郎",
      "content": [
        "衰羸岂合话荆州，争奈思多不自由。",
        "无路重趋桓典马，",
        "一种人间太平日，独教零落忆沧洲。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365781,
      "title": "渚宫秋思",
      "content": [
        "楚城日暮烟霭深，楚人驻马还登临。",
        "襄王台下水无赖，",
        "欲招屈宋当时魄，兰败荷枯不可寻。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 365782,
      "title": "闲居早秋",
      "content": [
        "槐杪清蝉烟雨余，萧萧凉叶堕衣裾。",
        "噪槎乌散沈苍岭，",
        "六宫谁买相如赋，团扇恩情日日疏。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365783,
      "title": "建康",
      "content": [
        "潮平远岸草侵沙，东晋衰来最可嗟。",
        "庾舅已能窥帝室，",
        "欲起九原看一遍，秦淮声急日西斜。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365784,
      "title": "送舒州宿松县傅少府",
      "content": [
        "江蓠漠漠树重重，东过清淮到宿松。",
        "县好也知临浣水，",
        "留取余杯待张翰，明年归棹一从容。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365785,
      "title": "经故洛阳城",
      "content": [
        "败垣危堞迹依稀，试驻羸骖吊落晖。",
        "跋扈以成梁冀在，",
        "千载昆阳好功业，与君门下作恩威。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365786,
      "title": "夏州胡常侍",
      "content": [
        "百尺高台勃勃州，大刀长戟汉诸侯。",
        "征鸿过尽边云阔，",
        "仍闻陇蜀由多事，深喜将军未白头。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365787,
      "title": "寄进士卢休",
      "content": [
        "半年池口恨萍蓬，今日思量已梦中。",
        "游子马蹄难重到，",
        "从此客程君不见，麦秋梅雨遍江东。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365788,
      "title": "赠先辈令狐补阙",
      "content": [
        "中间声迹早熏然，阻避钧衡过十年。",
        "碧海浪高终济物，",
        "应念凄凉洞庭客，夜深双泪忆渔船。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365789,
      "title": "送秦州从事",
      "content": [
        "一枝何足解人愁，抛却还随定远侯。",
        "紫陌红尘今别恨，",
        "若到边庭有来使，试批书尾话梁州。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365790,
      "title": "湖州裴郎中赴阙后投简寄友生",
      "content": [
        "锦帐郎官塞诏年，汀洲曾驻木兰船。",
        "祢衡酒醒春瓶倒，",
        "使君入拜吾徒在，宣室他时岂偶然。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365791,
      "title": "秋日泊平望驿寄太常裴郎中",
      "content": [
        "苹洲重到杳难期，西倚邮亭忆往时。",
        "北海尊中常有酒，",
        "闻说江南旧歌曲，至今犹自唱吴姬。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365792,
      "title": "西塞山",
      "content": [
        "吴塞当时指此山，吴都亡后绿孱颜。",
        "岭梅乍暖残妆恨，",
        "会将一副寒蓑笠，来与渔翁作往还。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365793,
      "title": "秋日汴河客舍酬友人",
      "content": [
        "梁宋追游早岁同，偶然违别事皆空。",
        "年如流水催何急，",
        "烦君更枉骚人句，白凤灵蛇满袖中。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365794,
      "title": "东归",
      "content": [
        "仙桂高高似有神，貂裘敝尽取无因。",
        "难将白发期公道，",
        "盈盘紫蟹千卮酒，添得临岐泪满巾。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365795,
      "title": "广陵李仆射借示近诗因投献",
      "content": [
        "朝论国计暮论兵，余力犹随凤藻生。",
        "语继盘盂抛俗格，",
        "天柄已持尧典在，更堪回首问缘情。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365796,
      "title": "三衢哭孙员外",
      "content": [
        "燕恋雕梁马恋轩，此心从此更何言。",
        "直将尘外三生命，",
        "忍看明发衣襟上，珠泪痕中见酒痕。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365797,
      "title": "箧中得故王郎中书",
      "content": [
        "凤里前年别望郎，丁宁唯恐滞吴乡。",
        "劝疏杯酒知妨事，",
        "九原自此无因见，反复遗踪泪万行。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365801,
      "title": "王浚墓",
      "content": [
        "男儿未必尽英雄，但到时来即命通。",
        "若使吴都犹王气，将军何处立殊功。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 365803,
      "title": "寄窦泽处士二首",
      "content": [
        "兰亭醉客旧知闻，欲问平安隔海云。",
        "不是金陵钱太尉，世间谁肯更容身。",
        "鼇背楼台拂白榆，此中槎客亦踟踌。",
        "牢山道士无仙骨，却向人间作酒徒。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 365808,
      "title": "秋江",
      "content": [
        "秋江待晚潮，客思旆旌摇。",
        "细雨翻芦叶，高风却柳条。",
        "兵戈村落破，饥俭虎狼骄。",
        "吾土兼连此，离魂望里消。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 365809,
      "title": "寄制诰李舍人",
      "content": [
        "梁王握豹韬，雪里见枚皋。",
        "上客趋丹陛，游人叹二毛。",
        "门闲知待诏，星动想濡毫。",
        "一首长杨赋，应嫌索价高。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 365810,
      "title": "秋日怀孟夷庚",
      "content": [
        "秋日黄陂下，孤舟忆共谁。",
        "江山三楚分，风雨二妃祠。",
        "知己秦貂没，流年贾𫛳悲。",
        "中原正兵马，相见是何时。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 365812,
      "title": "郴江迁客",
      "content": [
        "不是逢清世，何由见皂囊。",
        "事虽危虎尾，名胜泊鹓行。",
        "毒雾郴江阔，愁云楚驿长。",
        "归时有诗赋，一为吊沉湘。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 365813,
      "title": "感旧",
      "content": [
        "剑佩孙弘阁，戈鋋太尉营。",
        "重言虚有位，孤立竟无成。",
        "丘陇笳箫咽，池台岁月平。",
        "此恩何以报，归处是柴荆。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 365814,
      "title": "鹰",
      "content": [
        "越海霜天暮，辞韬野草干。",
        "俊通司隶职，严奉武夫官。",
        "眼恶藏蜂在，心粗逐物殚。",
        "近来脂腻足，驱遣不妨难。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 365816,
      "title": "寄易定公乘亿侍郎",
      "content": [
        "谢舞仍宫柳，高奇世少双。",
        "侍中生不到，园令死须降。",
        "班秩通乌府，樽罍奉碧幢。",
        "昭王有余烈，试为祷迷邦。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 365818,
      "title": "寄苏拾遗",
      "content": [
        "早岁长杨赋，当年谏猎书。",
        "格高时辈伏，言数宦情疏。",
        "慷慨传丹桂，艰难保旧居。",
        "退朝观槁草，能望马相如。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 365819,
      "title": "寄许融",
      "content": [
        "多病仍疏拙，唯君与我同。",
        "帝乡年共老，江徼业俱空。",
        "燕冷辞华屋，蛩凉恨晓丛。",
        "白云高几许，全属采芝翁。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 365820,
      "title": "寄礼部郑员外",
      "content": [
        "栾郤门风大，裴王礼乐优。",
        "班资冠鸡舌，人品压龙头。",
        "夜直炉香细，晴编疏草稠。",
        "近闻潘散骑，三十二悲秋。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 365821,
      "title": "菊",
      "content": [
        "篱落岁云暮，数枝聊自芳。",
        "雪裁纤蕊密，金拆小苞香。",
        "千载白衣酒，一生青女霜。",
        "春丛莫轻薄，彼此有行藏。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 365826,
      "title": "寒食日早出城东",
      "content": [
        "青门欲曙天，车马已喧阗。",
        "禁柳疏风雨，墙花拆露鲜。",
        "向谁夸丽景，只是叹流年。",
        "不得高飞便，回头望纸鸢。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 365827,
      "title": "秋日怀贾随进士",
      "content": [
        "边寇日骚动，故人音信稀。",
        "长缨惭贾谊，孤愤忆韩非。",
        "晓匣鱼肠冷，春园鸭掌肥。",
        "知君安未得，聊且示忘机。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 365828,
      "title": "乱后逢友人",
      "content": [
        "沧海去未得，倚舟聊问津。",
        "生灵寇盗尽，方镇改更贫。",
        "梦里旧行处，眼前新贵人。",
        "从来事如此，君莫独沾巾。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 365830,
      "title": "秋日富春江行",
      "content": [
        "远岸平如剪，澄江静似铺。",
        "紫鳞仙客驭，金颗李衡奴。",
        "冷叠群山阔，清涵万象殊。",
        "严陵亦高见，归卧是良图。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 365833,
      "title": "寄袁皓侍郎",
      "content": [
        "东台失路岐，荣辱事堪悲。",
        "我寝牛衣敝，君居豸角危。",
        "风尘惭上品，才业愧明时。",
        "千里芙蓉幕，何由话所思。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 365836,
      "title": "封禅寺居",
      "content": [
        "盛礼何由睹，嘉名偶寄居。",
        "周南太史泪，蛮徼长卿书。",
        "砌竹摇风直，庭花泣露疏。",
        "谁能赋秋兴，千里隔吾庐。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 365838,
      "title": "投寄韦右丞",
      "content": [
        "赤壁征文聘，中台拜郤诜。",
        "官资参令仆，曹署辖星辰。",
        "幞被从谁起，持纲自此新。",
        "举朝明典教，封纳诏书频。",
        "禁树曾摛藻，台乌旧避尘。",
        "便应酬倚注，何处话穷鳞。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365845,
      "title": "伤华发",
      "content": [
        "旧国迢迢远，清秋种种新。",
        "已衰曾轸虑，初见忽沾巾。",
        "日薄梳兼懒，根危镊恐频。",
        "青铜不自见，只拟老他人。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 365848,
      "title": "秋居有寄",
      "content": [
        "端居湖岸东，生计有无中。",
        "魇处千般鬼，寒时百种风。",
        "性灵从道拙，心事奈成空。",
        "多谢金台客，何当一笑同。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 365849,
      "title": "雪霁",
      "content": [
        "南山雪乍晴，寒气转峥嵘。",
        "锁却闲门出，随他骏马行。",
        "一竿如有计，五鼎岂须烹。",
        "愁见天街草，青青又欲生。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 365850,
      "title": "堠子",
      "content": [
        "终日路岐旁，前程亦可量。",
        "未能惭面黑，只是恨头方。",
        "雅旨逾千里，高文近两行。",
        "君知不识字，第一莫形相。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 365851,
      "title": "初夏寄顾绍宗",
      "content": [
        "江上偶分袂，四回寒暑更。",
        "青山无路入，白发满头生。",
        "郢浦雁寻过，镜湖蝉又鸣。",
        "怜君未归日，杯酒若为情。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 365852,
      "title": "寄第五尊师",
      "content": [
        "苕溪烟月久因循，野鹤衣裘独茧纶。",
        "只说泊船无定处，",
        "欲访先生问经诀，世间难得不由身。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365853,
      "title": "寄西华黄炼师",
      "content": [
        "西华有路入中华，依约山川认永嘉。",
        "羽客昔时留筱簜，",
        "盛事两般君总得，老莱衣服戴颙家。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365854,
      "title": "所思",
      "content": [
        "西上青云未有期，东归沧海一何迟。",
        "酒阑梦觉不称意，",
        "斗鸡走狗五陵道，惆怅输他轻薄儿。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365855,
      "title": "送支使萧中丞赴阙",
      "content": [
        "八年刀笔到京华，归去青冥路未赊。",
        "今日风流卿相客，",
        "从此常僚如有问，海边麋鹿斗边槎。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365856,
      "title": "送人归湘中兼寄旧知",
      "content": [
        "青溪烟雨九华山，乱后应同梦寐间。",
        "万里分飞休掩袂，",
        "为谢伏波筵上客，几时金印拟西还。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365857,
      "title": "自贻",
      "content": [
        "衰老应难更进趋，药畦经卷自朝晡。",
        "纵无显效亦藏拙，",
        "如何只见丁家鹤，依旧辽东叹绿芜。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365858,
      "title": "暇日感怀因寄同院吴蜕拾遗",
      "content": [
        "璧池清秩访燕台，曾捧瀛洲劄翰来。",
        "今日二难俱大夜，",
        "犹幸小兰同舍在，每因相见即衔哀。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365863,
      "title": "送杨炼师却归贞浩岩",
      "content": [
        "宦途不复更经营，归去东南任意行。",
        "别后几回思会面，",
        "为谢佯狂吴道士，耳中时有铁船声。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365864,
      "title": "暇日投钱尚父",
      "content": [
        "牛斗星边女宿间，栋梁虚敞丽江关。",
        "望高汉相东西阁，",
        "自惭麋鹿无能事，未报深恩鬓已斑。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365865,
      "title": "览晋史",
      "content": [
        "齐王僚属好男儿，偶觅东归便得归。",
        "满目路岐抛似梦，",
        "惆怅途中无限事，与君千载两忘机。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365866,
      "title": "感别元帅尚父",
      "content": [
        "玉函瑶检下台司，记得当时捧领时。",
        "半壁龙蛇蟠造化，",
        "稚子不才身抱疾，日窥贞迹泪双垂。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365867,
      "title": "尚父偶建小楼，特摛丽藻绝句不敢称扬三首",
      "content": [
        "结构叨冯柱石才，敢期幢盖此裴回。",
        "阳春曲调高谁和，尽日焚香倚隗台。",
        "玳簪珠履愧非才，时凭阑干首重回。",
        "只待淮妖剪除后，别倾卮酒贺行台。",
        "阑槛初成愧楚才，不知星彩尚迂回。",
        "风流孔令陶钧外，犹记山妖逼小台。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365868,
      "title": "题玄同先生草堂三首",
      "content": [
        "杳杳诸天路，苍苍大涤山。",
        "景舆留不得，毛节去应闲。",
        "相府旧知己，教门新启关。",
        "太平匡济术，流落在人间。",
        "先生诀行日，曾奉数行书。",
        "意密寻难会，情深恨有余。",
        "石桥春暖后，句漏药成初。",
        "珍重云兼鹤，从来不定居。",
        "常时忆讨论，历历事犹存。",
        "酒向余杭尽，云从大涤昏。",
        "往来无道侣，归去有台恩。",
        "自此玄言绝，长应闭洞门。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365869,
      "title": "城西作",
      "content": [
        "从军无一事，终日掩空斋。",
        "道薄交游少，才疏进取乖。",
        "野禽鸣聒耳，庭草绿侵阶。",
        "幸自同樗栎，何妨惬所怀。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 365870,
      "title": "冬暮城西晚眺",
      "content": [
        "谬忝莲华幕，虚沾柏署官。",
        "欹危长抱疾，衰老不禁寒。",
        "时事已日过，世途行转难。",
        "千崖兼万壑，只向望中看。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 365871,
      "title": "秋霁后",
      "content": [
        "净碧山光冷，圆明露点匀。",
        "渚莲丹脸恨，堤柳翠眉颦。",
        "蝉已送行客，雁应辞主人。",
        "蝇蚊渐无况，日晚自相亲。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 365872,
      "title": "茅斋",
      "content": [
        "从事不从事，养生非养生。",
        "职为尸禄本，官是受恩名。",
        "时态已相失，岁华徒自惊。",
        "西斋一卮酒，衰老与谁倾。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 365875,
      "title": "遁迹",
      "content": [
        "遁迹知安住，沾襟欲奈何。",
        "朝廷犹礼乐，郡邑忍干戈。",
        "华马凭谁问，胡尘自此多。",
        "因思汉明帝，中夜忆廉颇。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 365879,
      "title": "即事中元甲子",
      "content": [
        "三秦流血已成川，塞上黄云战马闲。",
        "只有羸兵填渭水，",
        "惆怅翠华犹未返，泪痕空滴剑文斑。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365880,
      "title": "魏城逢故人",
      "content": [
        "一年两度锦江游，前值东风后值秋。",
        "芳草有情皆碍马，",
        "今日因君试回首，淡烟乔木隔绵州。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 365881,
      "title": "游江夏口",
      "content": [
        "醉别江东酒一杯，往年曾此驻尘埃。",
        "鱼听建业歌声过，",
        "平生胆气平生恨，今日江边首懒回。"
      ],
      "author": {
        "id": 6955,
        "name": "罗隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    }
  ],
