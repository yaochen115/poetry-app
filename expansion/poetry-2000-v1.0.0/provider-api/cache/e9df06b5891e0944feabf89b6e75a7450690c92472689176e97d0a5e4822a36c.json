{
  "data": [
    {
      "id": 156340,
      "title": "至扬州  其二○",
      "content": [
        "樵夫偏念客途长，肯向城中为裹粮。",
        "晓指高沙移处泊，司徒庙下贾家庄。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 156341,
      "title": "贾家庄",
      "content": [
        "行边无鸟雀，卧处有腥臊。",
        "露打须眉硬，风搜颧颊高。",
        "流离外颠沛，饥渴内煎熬。",
        "多少偷生者，孤臣叹所遭。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156342,
      "title": "扬州地分官  其一",
      "content": [
        "五骑驰来号徼巡，咆哮按剑一何嗔。",
        "金钱买命方无语，何必豺狼骂北人。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 156343,
      "title": "扬州地分官  其二",
      "content": [
        "便当缟素驾戎车，畏贼何当畏虎如。",
        "看取摘星楼咫尺，可怜城下哭包胥。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 156344,
      "title": "思则堂先生",
      "content": [
        "白须老子宿招提，香积厨边供晚炊。",
        "借问鱼羹何处少，北风安得似南枝。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 156345,
      "title": "高沙道中",
      "content": [
        "三月初五日，索马平山边。",
        "疾驰趋高沙，如走阪上圆。",
        "夜行二百里，望望无人烟。",
        "迷途呼不应，如在盘中旋。",
        "昏雾腥且湿，怒飙狂欲颠。",
        "流澌在须发，尘沫满櫜鞬。",
        "红日高十丈，方辨山与川。",
        "胡行疾如鬼，忽在林之巅。",
        "谁家苦竹园，其叶青戋戋。",
        "仓皇伏幽筿，生死信天缘。",
        "铁骑俄四合，鸟落无虚弦。",
        "遶林势奔轶，动地声喧阗。",
        "霜蹄破丛翳，出入相贯穿。",
        "既无遁形术，又非缩地僊。",
        "猛虎驱群羊，兔鱼落蹄筌。",
        "一吏射中目，颈血仅可溅。",
        "一隶缚上马，无路脱纠缠。",
        "一厮躏其足，吞声以自全。",
        "一宾与一从，买命得金钱。",
        "一伻与一校，幸不逢戈鋋。",
        "嗟予何薄命，寄身空且悬。",
        "萧萧数竹侧，往来度飞鞯。",
        "游锋几及肤，怒兴空握拳。",
        "跬步偶不见，残息忽复延。",
        "当其蹙迫时，大风起四边。",
        "意者相其间，神物来蜿蜒。",
        "更生不自意，如病乍得痊。",
        "须臾传火攻，然眉复相煎。",
        "一行辄一跌，奔命度平田。",
        "幽篁便自托，仰天坐且眠。",
        "晴曦正当昼，焦肠火生咽。",
        "断罂汲勺水，天降甘露鲜。",
        "青山为我屋，白云为我椽。",
        "彼草何荒荒，彼水何潺潺。",
        "首阳既无食，阴陵不可前。",
        "便如失目鱼，一似无足蚿。",
        "不见道傍骨，委积有万千。",
        "魂魄亲蝇蚋，膏脂饱乌鸢。",
        "使我先朝露，其事亦复然。",
        "丈夫竟如此，吁嗟彼苍天。",
        "古人择所安，肯蹈不测渊。",
        "柰何以遗体，粪土同弃捐。",
        "初学苏子卿，终慕鲁仲连。",
        "为我王室故，持此金石坚。",
        "自古皆有死，义不污腥膻。",
        "求仁而得仁，宁怨沟壑填。",
        "秦客载张禄，吴人纳伍员。",
        "季布走在鲁，樊期托于燕。",
        "国士急人病，倜傥何拘孪。",
        "彼人莫我知，此恨付重泉。",
        "鹊声从何来，忽有吉语传。",
        "此去三五里，古道方平平。",
        "行人渐复出，胡马觉已还。",
        "回首下山阿，七人相牵连。",
        "东野御已穷，而复加之鞭。",
        "趼足如移山，携持姑勉旃。",
        "行行重狼顾，常恐追骑先。",
        "扬州二游手，面目轻且儇。",
        "自言同脱虏，波波口流涎。",
        "白日各持梃，其来何翩翩。",
        "奴辈殊无聊，似欲为鹰鹯。",
        "逡巡不得避，默默同寒蝉。",
        "道逢采樵子，中流得舟船。",
        "竹畚当安车，六夫共赪肩。",
        "四肢与百骸，屈曲如杯棬。",
        "路人心为恻，从者皆涕涟。",
        "星奔不可止，暮达城西阡。",
        "饥卧野人庐，藉草为针毡。",
        "诘朝从东渡，始觉安且便。",
        "人生岂无难，此难何迍邅。",
        "重险复重险，今年定何年。",
        "圣世基岱岳，皇风扇垓埏。",
        "中兴奋王业，日月光重宣。",
        "报国臣有志，悔往不可湔。",
        "臣苦不如死，一死尚可怜。",
        "堂上太夫人，鬓发今犹玄。",
        "江南昔卜宅，岭右今受廛。",
        "首丘义皇皇，倚门望惓惓。",
        "波涛避江介，风雨行淮堧。",
        "北海转万折，南洋溯孤骞。",
        "周游大夫蠡，放浪太史迁。",
        "倘复游吾盘，终当耕我绵。",
        "夫人生于世，致命各有权。",
        "慷慨为烈士，从容为圣贤。",
        "稽首望南拜，著此泣血篇。",
        "百年尚哀痛，敢谓事已遄。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 156346,
      "title": "至高沙",
      "content": [
        "江南自好筑金台，何事风花堕向淮。",
        "若使两遭豺虎手，而今玉也有谁埋。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 156347,
      "title": "发高沙  其一",
      "content": [
        "晓发高沙卧一航，平沙漠漠水茫茫。",
        "舟人为指荒烟岸，南北今年几战场。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 156348,
      "title": "发高沙  其二",
      "content": [
        "城子河边委乱尸，河阴血肉更稀微。",
        "太行南北燕山外，多少游魂逐马蹄。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 156349,
      "title": "发高沙  其三",
      "content": [
        "一日经行白骨堆，中流失柁为心摧。",
        "海陵棹子长狼顾，水有船来步马来。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 156350,
      "title": "发高沙  其四",
      "content": [
        "小泊稽庄月正弦，庄官惊问是何船。",
        "今朝哨马湾头出，正在青山大路边。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 156351,
      "title": "稽庄即事",
      "content": [
        "乃心王室故，日夜奔南征。",
        "蹈险宁追悔，怀忠莫见明。",
        "雁声连水远，山色与天平。",
        "枉作穷途哭，男儿付死生。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156352,
      "title": "泰州",
      "content": [
        "羁臣家万里，天目鉴孤忠。",
        "心在坤维外，身游坎窞中。",
        "长淮行不断，苦海望无穷。",
        "晚鹊传佳好，通州路已通。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156353,
      "title": "卜神",
      "content": [
        "通州三百里，茅苇也还无。",
        "胡骑虎出没，山鼯鬼啸呼。",
        "王阳怀畏道，阮籍泪穷途。",
        "人物中兴骨，神明为国扶。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156354,
      "title": "旅怀  其一",
      "content": [
        "北去通州号畏途，固应孝子为回车。",
        "海陵若也容羁客，賸买菰蒲且寄居。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 156355,
      "title": "旅怀  其二",
      "content": [
        "天地虽宽靡所容，长淮谁是主人翁。",
        "江南父老还相念，只欠一帆东海风。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 156356,
      "title": "旅怀  其三",
      "content": [
        "昨夜分明梦到家，飘飖依旧客天涯。",
        "故园门掩东风老，无限杜鹃啼落花。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 156357,
      "title": "怀则堂实堂",
      "content": [
        "白头北使驾双鞯，沙阔天长泪晓烟。",
        "中夜想应发深省，故人南北地行僊。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 156358,
      "title": "贵卿",
      "content": [
        "天高并地逈，与子独牢愁。",
        "初作燕齐客，今为淮海游。",
        "半生谁俯仰，一死共沉浮。",
        "我视君年长，相看比惠州。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156359,
      "title": "忆太夫人",
      "content": [
        "三生命孤苦，万里路酸辛。",
        "屡险不一险，无身复有身。",
        "不忘圣天子，几负太夫人。",
        "定省今何处，新来梦寐频。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156360,
      "title": "即事",
      "content": [
        "痛哭辞京阙，微行访海门。",
        "久无鸡可听，新有虱堪扪。",
        "白发应多长，苍头少有存。",
        "但令身未死，随力报乾坤。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156361,
      "title": "纪闲",
      "content": [
        "九十春光好，周流人鬼关。",
        "人情轻似土，世路险于山。",
        "俯仰经行处，死生谈笑间。",
        "近时最难得，旬日海陵闲。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156362,
      "title": "声苦",
      "content": [
        "万死奔波落一生，飘零淮海命何轻。",
        "近来学得赵清献，叫苦时时数十声。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 156363,
      "title": "即事",
      "content": [
        "船只时闲锁，城孤日闭关。",
        "惊心常有马，极目柰无山。",
        "出路相传险，行囊愈觉悭。",
        "归心风絮乱，无柰一身闲。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156364,
      "title": "发海陵",
      "content": [
        "自海陵来向海安，分明如渡鬼门关。",
        "若将九折回车看，倦鸟何年可得还。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 156365,
      "title": "闻马",
      "content": [
        "过海安来柰若何，舟人去后马临河。",
        "若非神物扶忠直，世上未应侥幸多。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 156366,
      "title": "如臯",
      "content": [
        "雄狐假虎之林臯，河水腥风接海涛。",
        "行客不知身世险，一窗春梦送轻舠。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 156367,
      "title": "闻谍",
      "content": [
        "北来追骑满江滨，那更元戎按剑嗔。",
        "不是神明扶正直，淮头何处可安身。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 156368,
      "title": "哭金路分应  其一",
      "content": [
        "我为吾君役，而从乃主行。",
        "险夷宁异趣，休戚与同情。",
        "遇贼能无死，寻医剧不生。",
        "通州一丘土，相望泪如倾。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156369,
      "title": "哭金路分应  其二",
      "content": [
        "明朝吾渡海，汝魄在它乡。",
        "六七年华短，三千客路长。",
        "招魂情黯黯，归骨事茫茫。",
        "有子应年长，平生不汝忘。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156370,
      "title": "怀扬通州  其一",
      "content": [
        "江波无柰暮云阴，一片朝宗只此心。",
        "今日海头觅船去，始知百炼是精金。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 156371,
      "title": "怀扬通州  其二",
      "content": [
        "唤渡江沙眼欲枯，羁臣中道落崎岖。",
        "乘船不管千金购，渔父真成大丈夫。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 156372,
      "title": "怀扬通州  其三",
      "content": [
        "范叔西来变姓名，绨袍曾感故人情。",
        "而今未识春风面，倾盖江湖话一生。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 156373,
      "title": "怀扬通州  其四",
      "content": [
        "仲连义不帝西秦，拔宅逃来住海滨。",
        "我亦东寻烟雾去，扶桑影里看金轮。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 156374,
      "title": "海船",
      "content": [
        "海上多时断去舟，公来容易渡南州。",
        "子胥江上逢渔父，莫是神明遣汝否。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 156375,
      "title": "发通州  其一",
      "content": [
        "孤舟渐渐脱长淮，星斗当空月照怀。",
        "今夜分明栖海角，未应便道是天涯。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 156376,
      "title": "发通州  其二",
      "content": [
        "白骨丛中过一春，东将入海避风尘。",
        "姓名变尽形容改，犹有天涯相识人。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 156377,
      "title": "发通州  其三",
      "content": [
        "淮水淮山阻且长，孤臣性命寄何乡。",
        "只从海上寻归路，便是当年不死方。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 156378,
      "title": "石港",
      "content": [
        "王阳真畏道，季路渐知津。",
        "山鸟唤醒客，海风吹黑人。",
        "乾坤万里梦，烟雨一年春。",
        "起看扶桑晓，红黄六六鳞。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156379,
      "title": "卖鱼湾",
      "content": [
        "风起千湾浪，潮生万顷沙。",
        "春红堆蟹子，晚白结盐花。",
        "故国何时讯，扁舟到处家。",
        "狼山青两点，极目是天涯。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156380,
      "title": "即事",
      "content": [
        "飘蓬一叶落天涯，潮溅青纱日未斜。",
        "好事官人无勾当，呼童上岸买青虾。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 156381,
      "title": "北海口",
      "content": [
        "沧海人间别一天，只容渔父钓苍烟。",
        "而今蜃起楼台处，亦有北来蕃汉船。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 156382,
      "title": "出海  其一",
      "content": [
        "一团荡漾水晶盘，四畔青天作护阑。",
        "著我扁舟了无碍，分明便作混沦看。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 156383,
      "title": "出海  其二",
      "content": [
        "水天一色玉空明，便似乘槎上太清。",
        "我爱东坡南海句，兹游奇绝冠平生。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 156384,
      "title": "渔舟",
      "content": [
        "一阵飞帆破碧烟，儿郎惊饵理弓弦。",
        "舟中自信娄师德，海上谁知鲁仲连。",
        "初谓悠扬真贼舰，后闻欵乃是渔船。",
        "人生漂泊多磨折，何日山林清昼眠。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 156385,
      "title": "扬子江",
      "content": [
        "几日随风北海游，回从扬子大江头。",
        "臣心一片磁针石，不指南方不肯休。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 156386,
      "title": "使风",
      "content": [
        "渺渺茫茫远愈微，乘风日夜趁东归。",
        "半醒半困模糊处，一似醉中骑马飞。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 156387,
      "title": "苏州洋",
      "content": [
        "一叶漂摇扬子江，白云尽处是苏洋。",
        "便如伍子当年苦，只少行头宝剑装。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 156388,
      "title": "过扬子江心",
      "content": [
        "渺渺乘风出海门，一行淡水带潮浑。",
        "长江尽处还如此，何日岷山看发源。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 156389,
      "title": "入浙东",
      "content": [
        "厄运一百日，危机九十遭。",
        "孤踪落虎口，薄命付鸿毛。",
        "漠漠长淮路，茫茫巨海涛。",
        "惊魂犹未定，消息问金鳌。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156390,
      "title": "夜潮",
      "content": [
        "雨恶风狞夜色浓，潮头如屋打孤蓬。",
        "漂零行路丹心苦，梦里一声何处鸿。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 156391,
      "title": "乱礁洋",
      "content": [
        "海山僊子国，邂逅寄孤蓬。",
        "万象画图里，千崖玉界中。",
        "风摇春浪软，礁激暮潮雄。",
        "云气东南密，龙腾上碧空。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156392,
      "title": "夜走",
      "content": [
        "鲸波万里送归舟，倏忽惊心欲白头。",
        "何处赭衣操剑戟，同时黄帽理兜鍪。",
        "人间风雨真成梦，夜半江山总是愁。",
        "雁荡双峰片云隔，明朝蹑𪨗作清游。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 156393,
      "title": "绿漪堂",
      "content": [
        "义方堂上看，窗户翠玲珑。",
        "砚里云坛月，席间淇水风。",
        "清声随地到，直节与天通。",
        "庭玉森如笋，干霄雨露功。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156394,
      "title": "过黄岩",
      "content": [
        "魏雎变张禄，越蠡改陶朱。",
        "谁料文山氏，姓刘名是洙。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 156395,
      "title": "至温州",
      "content": [
        "万里风霜鬓已丝，飘零回首壮心悲。",
        "罗浮山下雪来未，扬子江心月照谁。",
        "祇谓虎头非贵相，不图羝乳有归期。",
        "乘潮一到中川寺，暗读中兴第二碑。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 156396,
      "title": "长溪道中和张自山韵  其一",
      "content": [
        "潮风连地吼，江雨带天流。",
        "宫殿扃春仗，衣冠锁月游。",
        "伤心今北府，遗恨古东洲。",
        "王气如川至，龙兴海上州。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156397,
      "title": "长溪道中和张自山韵  其二",
      "content": [
        "夜静吴歌咽，春深蜀血流。",
        "向来苏武节，今日子长游。",
        "海角云为岸，江心石作洲。",
        "丈夫竟何事，底用泣神州。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156398,
      "title": "和自山",
      "content": [
        "春晚伤为客，月明思见君。",
        "我方慕苏武，谁复从田文。",
        "龙背夹红日，雁声连白云。",
        "琶琵汉宫曲，马上不堪闻。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156399,
      "title": "林附祖",
      "content": [
        "画影图形正捕风，书生薄命入罝中。",
        "胡儿一似冬烘眼，错认颜标作鲁公。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 156400,
      "title": "呈小村",
      "content": [
        "万里飘零命羽轻，归来喜有故人迎。",
        "雷潜九地声元在，月暗千山魄再明。",
        "疑是仓公回已死，恍如羊祜说前生。",
        "夜阑相对真成梦，清酒浩歌双剑横。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 156401,
      "title": "二月晦",
      "content": [
        "塞上明妃马，江头渔父船。",
        "新雠谁共雪，旧梦不堪圆。",
        "遗恨常千古，浮生又一年。",
        "何时暮春者，还我浴沂天。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156402,
      "title": "有感呈景山校书诸丈",
      "content": [
        "北风吹春草，阳乌日已至。",
        "天时岂云爽，人事胡乃异。",
        "三月方皇皇，衣冠道如坠。",
        "栋挠榱桷折，木颠桢干悴。",
        "大者怀端忧，燋头求室毁。",
        "小者嗟行役，泥涂跋其尾。",
        "长平与新安，露胔如栉比。",
        "赋分本尔殊，适与天时值。",
        "哲人处明夷，致命以遂志。",
        "但令守吾贞，死生浩无愧。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 156403,
      "title": "即事",
      "content": [
        "去年伤北使，今日叹南驰。",
        "云湿山如动，天低雨欲垂。",
        "征夫行未已，游子去何之。",
        "正好王师出，崆峒麦熟时。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156404,
      "title": "所怀",
      "content": [
        "世途嗟孔棘，行役苦期频。",
        "良马比君子，清风来故人。",
        "相看千里月，空负一年春。",
        "便有桃源路，吾当少避秦。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156405,
      "title": "自叹",
      "content": [
        "草宿披宵露，松餐立晚风。",
        "乱离嗟我在，艰苦有谁同。",
        "祖逖关河志，程婴社稷功。",
        "身谋百年事，宇宙浩无穷。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156406,
      "title": "题苏武忠节图  其一",
      "content": [
        "忽报忠图纪岁华，东风吹泪落天涯。",
        "苏卿更有归时国，老相兼无去后家。",
        "烈士丧元心不易，达人知命事何嗟。",
        "生平爱览忠臣传，不为吾身亦陷车。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 156407,
      "title": "题苏武忠节图  其二",
      "content": [
        "独伴羝羊海上游，相逢血泪向天流。",
        "忠贞已向生前定，老节须从死后休。",
        "不死未论生可喜，虽生何恨死堪忧。",
        "甘心卖国人何处，曾识苏公义胆不。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 156408,
      "title": "题苏武忠节图  其三",
      "content": [
        "漠漠愁云海戍迷，十年何事望京师。",
        "李陵罪在偷生日，苏武功成未死时。",
        "铁石心存无镜变，君臣义重与天期。",
        "纵饶夜久胡尘黑，百炼丹心涅不缁。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 156409,
      "title": "过零丁洋",
      "content": [
        "辛苦遭逢起一经，干戈落落四周星。",
        "山河破碎风抛絮，身世飘摇雨打萍。",
        "皇恐滩头说皇恐，零丁洋里叹零丁。",
        "人生自古谁无死，留取丹心照汗青。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 156410,
      "title": "元夕",
      "content": [
        "南海观元夕，兹游古未曾。",
        "人间大竞渡，水上小烧灯。",
        "世事争强弱，人情尚废兴。",
        "孤臣腔血满，死不愧庐陵。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156411,
      "title": "怀赵清逸",
      "content": [
        "崖海真何地，驱来坐战场。",
        "家人半分合，国事决存亡。",
        "一死不足道，百忧何可当。",
        "故人髯似戟，起舞为君伤。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156412,
      "title": "二月六日海上大战国事不济孤臣天祥坐北舟中向南恸哭为之诗曰",
      "content": [
        "长平一坑四十万，秦人欢欣赵人怨。",
        "大风扬沙水不流，为楚者乐为汉愁。",
        "兵家胜负常不一，纷纷干戈何时毕。",
        "必有天吏将明威，不嗜杀人能一之。",
        "我生之初尚无疚，我生之后遭阳九。",
        "厥角稽首并二州，正气扫地山河羞。",
        "身为大臣义当死，城下师盟愧牛耳。",
        "间关归国洗日光，白麻重宣不敢当。",
        "出师三年劳且苦，只尺长安不得覩。",
        "非无虓虎士如林，一日不戈为人擒。",
        "楼船千艘下天角，两雄相遭争奋搏。",
        "古来何代无战争，未有锋猬交沧溟。",
        "游兵日来复日往，相持一月为鹬蚌。",
        "南人志欲扶昆仑，北人气欲黄河吞。",
        "一朝天昏风雨恶，炮火雷飞箭星落。",
        "谁雌谁雄顷刻分，流尸漂血洋水浑。",
        "昨朝南船满崖海，今朝只有北船在。",
        "昨夜两边桴鼓鸣，今朝船船鼾睡声。",
        "北兵去家八千里，椎牛酾酒人人喜。",
        "惟有孤臣雨泪垂，冥冥不敢向人啼。",
        "六龙杳霭知何处，大海茫茫隔烟雾。",
        "我欲借剑斩佞臣，黄金横带为何人。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 156413,
      "title": "又六噫",
      "content": [
        "飚风起兮海水飞，噫。",
        "文武尽兮火德微，噫。",
        "鹰鹯相击兮靡所施，噫。",
        "鸿鹄欲举兮将安归，噫。",
        "櫂歌中流兮任所之，噫。",
        "独抱春秋兮莫我知，噫。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 156414,
      "title": "言志",
      "content": [
        "九垠化为魅，亿丑俘为虏。",
        "既不能变姓名卒于吴，又不能髠钳奴于鲁。",
        "远引不如四皓翁，高蹈不如仲连父。",
        "冥鸿堕矰缴，长鲸陷网罟。",
        "鷃燕上下争谁何，蝼蚁等闲相尔汝。",
        "狼藉山河岁云杪，飘零海角春重暮。",
        "百年落落生涯尽，万里遥遥行役苦。",
        "我生不辰逢百罹，求仁得仁尚何语。",
        "一死鸿毛或泰山，之轻之重安所处。",
        "妇女低头守巾帼，男儿嚼齿吞刀锯。",
        "杀身慷慨犹易免，取义从容未轻许。",
        "仁人志士所植立，横绝地维屹天柱。",
        "以身徇道不苟生，道在光明照千古。",
        "素王不作春秋废，兽蹄鸟迹交中土。",
        "闰位适在三七间，礼乐终当属真主。",
        "李陵卫律罪通天，遗臭至今使人吐。",
        "种瓜东门不可得，暴骨匈奴固其所。",
        "平生读书为谁事，临难何忧复何惧。",
        "已矣夫，易箦不必如曾参，结缨犹当效子路。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 156415,
      "title": "南海",
      "content": [
        "朅来南海上，人死乱如麻。",
        "腥浪拍心碎，飙风吹鬓华。",
        "一山还一水，无国又无家。",
        "男子千年志，吾生未有涯。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156416,
      "title": "有感",
      "content": [
        "海阔龙深蛰，山空鸟杂鸣。",
        "花随春共去，云与水俱行。",
        "壮士千年志，征夫万里程。",
        "夜凉看星斗，何处是搀枪。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156417,
      "title": "张元帅谓予国已亡矣杀身以忠谁复书之予谓商非不亡夷齐自不食周粟人臣自尽其心岂论书与不书张为改容因成一诗",
      "content": [
        "高人名若浼，烈士死如归。",
        "智灭犹吞炭，商亡正采薇。",
        "岂因徼后福，其肯蹈危机。",
        "万古春秋义，悠悠双泪挥。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156418,
      "title": "登楼",
      "content": [
        "茫茫地老与天荒，如此男儿铁石肠。",
        "七十日来浮海道，三千里外望江乡。",
        "高鸿尚觉心期阔，蹇马何堪脚迹长。",
        "独自登楼时拄颊，山川在眼泪浪浪。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 156419,
      "title": "海上",
      "content": [
        "天边青鸟逝，海上白鸥驯。",
        "王济非痴叔，陶潜岂醉人。",
        "得官须报国，可隠即逃秦。",
        "身事盖棺定，挑灯看剑频。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156420,
      "title": "赣州",
      "content": [
        "满城风雨送凄凉，三四年前此战场。",
        "遗老犹应愧蜂蚁，故交已久化豺狼。",
        "江山不改人心在，宇宙方来事会长。",
        "翠玉楼前天亦泣，南音半夜落沧浪。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 156421,
      "title": "出广州第一宿",
      "content": [
        "越王台下路，搔首叹萍踪。",
        "城古都招水，山高易得风。",
        "鼓声残雨后，塔影暮林中。",
        "一样连营火，山同河不同。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156422,
      "title": "英德道中",
      "content": [
        "海近山如沃，杼深屋半芜。",
        "乾坤正风雨，轩冕总泥途。",
        "自叹鸢肩薄，谁怜鹤影孤。",
        "少年狂不醒，夜夜梦伊吾。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156423,
      "title": "晚渡",
      "content": [
        "青山围万叠，流落此何邦。",
        "云静龙归海，风清马渡江。",
        "汲滩供茗椀，编竹当蓬窗。",
        "一井沙头月，羁鸿共影双。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156424,
      "title": "珊瑚吟",
      "content": [
        "南方有珍禽，鸣声天下奇。",
        "毛羽黑如漆，两脸凝璚脂。",
        "燕赵佳公子，笼槛以自随。",
        "童子重丁宁，饮食必以时。",
        "将献上林苑，来巢万年枝。",
        "待之岂少恩，不免加絷维。",
        "珊瑚真珊瑚，碎琢良自悲。",
        "中原寒气深，风土非所宜。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 156425,
      "title": "和中甫端午韵不依次",
      "content": [
        "黄茅古道外，羸马发南州。",
        "有客嗤齐鲁，何人念楚囚。",
        "岁年付流水，风雨满沧洲。",
        "手把菖蒲看，黑头非所求。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156426,
      "title": "又呈中斋  其一",
      "content": [
        "风雨羊肠道，飘零万死身。",
        "牛儿朝共载，木客夜为邻。",
        "庾子江南梦，苏郎海上贫。",
        "悠悠看晚渡，谁是济川人。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156427,
      "title": "又呈中斋  其二",
      "content": [
        "万里论心晚，相看慰乱离。",
        "丹成俄已化，璧碎尚无缁。",
        "禾黍西原梦，川原落日悲。",
        "斯文今已矣，来世以为期。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156428,
      "title": "竹间",
      "content": [
        "倦来聊歇马，随分此青山。",
        "流水竹千个，清风沙一湾。",
        "乾坤醒醉里，身世有无间。",
        "客路真希绝，浮生半日闲。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156429,
      "title": "越王台",
      "content": [
        "登临我向乱离来，落落千年一越台。",
        "春事暗随流水去，潮声空逐暮天回。",
        "烟横古道人行少，月堕荒村鬼哭哀。",
        "莫作楚囚愁绝看，旧家歌舞此衔杯。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 156430,
      "title": "南华山",
      "content": [
        "北行近千里，迷复忘西东。",
        "行行至南华，忽忽如梦中。",
        "佛化知几尘，患乃与我同。",
        "有形终归灭，不灭惟真空。",
        "笑看曹溪水，门前坐松风。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 156431,
      "title": "南安军",
      "content": [
        "梅花南北路，风雨湿征衣。",
        "出岭谁同出，归乡如不归。",
        "山河千古在，城郭一时非。",
        "饥死真吾志，梦中行采薇。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156432,
      "title": "黄金市",
      "content": [
        "闭蓬绝粒始南州，我过青山欲首丘。",
        "巡远应无儿女态，夷齐肯作稻粱谋。",
        "人间早见黄金市，天上犹迟白玉楼。",
        "先子神游今二纪，梦中挥泪溅松楸。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 156433,
      "title": "万安县",
      "content": [
        "青山曲折水天平，不是南征是北征。",
        "举世更无巡远死，当年谁道甫申生。",
        "遥知岭外相思处，不见滩头皇恐声。",
        "传语故园猿鹤好，梦回江路月风清。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 156434,
      "title": "泰和",
      "content": [
        "书生曾拥碧油幢，耻与群儿共竖降。",
        "汉节几回登快阁，楚囚今度过澄江。",
        "丹心不改君臣谊，清泪难忘父母邦。",
        "惟有乡人知我瘦，下帷绝粒坐蓬窗。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 156435,
      "title": "苍然亭",
      "content": [
        "风打船头系夕阳，亭前老子旧胡床。",
        "青牛过去关山动，白鹤归来城郭荒。",
        "忠节风流落尘土，英雄遗恨满沧浪。",
        "故园水月应无恙，江上新松几许长。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 156436,
      "title": "别里中诸友",
      "content": [
        "青山重回首，风雨暗啼猿。",
        "杨柳溪头钓，梅花石上尊。",
        "故人无复见，烈士尚谁言。",
        "长有归来梦，衣冠满故园。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156437,
      "title": "发吉州",
      "content": [
        "己卯六月初一日，苍然亭下楚囚立。",
        "山河颠倒纷雨泣，乙亥七夕此何夕。",
        "煌煌斗牛剑光湿，戈鋋彗云雷电击。",
        "三百余年火为德，须臾风雨天地黑。",
        "皇纲解纽地维折，妾妇偷生自为贼。",
        "英雄扼腕怒须赤，贯日血忠死穷北。",
        "首阳风流落南国，正气未亡人未息。",
        "青原万丈光赫赫，大江东去日夜白。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 156438,
      "title": "临江军",
      "content": [
        "江岸今多啮，城居昔屡焚。",
        "市人半伧父，竖子亦将军。",
        "蛟哭金洲雨，猿啼玉观云。",
        "周郎坟土上，回首泪成痕。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156439,
      "title": "隆兴府",
      "content": [
        "半生几度此登临，流落而今雪满簪。",
        "南浦不知春已晚，西山但觉日初阴。",
        "谁怜龟鹤千年语，空负鹏鹍万里心。",
        "无限故人帘雨外，夜深如有广陵音。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    }
