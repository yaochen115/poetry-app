{
  "data": [
    {
      "id": 276920,
      "title": "随师东",
      "content": [
        "东征日调万黄金，几竭中原买鬬心。",
        "军令未闻诛马谡，捷书惟是报孙歆。",
        "但须鸑鷟巢阿阁，岂假鸱鸮在泮林。",
        "可惜前朝玄菟郡，积骸成莽阵云深。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276921,
      "title": "宋玉",
      "content": [
        "何事荆台百万家，惟教宋玉擅才华。",
        "楚辞已不饶唐勒，风赋何曾让景差。",
        "落日渚宫供观阁，开年云梦送烟花。",
        "可怜庾信寻荒径，犹得三朝托后车。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276922,
      "title": "韩同年新居饯韩西迎家室戏赠",
      "content": [
        "籍籍征西万户侯，新缘贵婿起朱楼。",
        "一名我漫居先甲，千骑君翻在上头。",
        "云路招邀回彩凤，天河迢遰笑牵牛。",
        "南朝禁脔无人近，瘦尽琼枝咏四愁。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276923,
      "title": "奉和太原公送前杨秀才戴兼招杨正字戎",
      "content": [
        "潼关地接古弘农，万里高飞雁与鸿。",
        "桂树一枝当白日，芸香三代继清风。",
        "仙舟尚惜乖双美，彩服何由得尽同。",
        "谁惮士龙多笑疾，美髭终类晋司空。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276924,
      "title": "池边",
      "content": [
        "玉管葭灰细细吹，流鸎上下燕参差。",
        "日西千遶池边树，忆把枯条撼雪时。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276925,
      "title": "贾生",
      "content": [
        "宣室求贤访逐臣，贾生才调更无伦。",
        "可怜夜半虚前席，不问苍生问鬼神。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276926,
      "title": "送王十三校书分司",
      "content": [
        "多少分曹掌秘文，洛阳花雪梦随君。",
        "定知何逊缘联句，每到城东忆范云。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276927,
      "title": "寄恼韩同年二首 一",
      "content": [
        "帘外辛夷定已开，开时莫放艳阳回。",
        "年华若到经风雨，便是胡僧话劫灰。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276928,
      "title": "寄恼韩同年二首 二",
      "content": [
        "龙山晴雪凤楼霞，洞里迷人有几家。",
        "我为伤春心自醉，不劳君劝石榴花。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276929,
      "title": "谒山",
      "content": [
        "从来系日乏长绳，水去云回恨不胜。",
        "欲就麻姑买沧海，一杯春露冷如冰。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276930,
      "title": "钧天",
      "content": [
        "上帝钧天会众灵，昔人因梦到青冥。",
        "伶伦吹裂孤生竹，却为知音不得听。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276931,
      "title": "失猿",
      "content": [
        "祝融南去万重云，清啸无因更一闻。",
        "莫遣碧江通箭道，不教肠断忆同群。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276932,
      "title": "戏题友人壁",
      "content": [
        "花迳逶迤柳巷深，小阑亭舞啭春禽。",
        "相如解作长门赋，却用文君取酒金。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276933,
      "title": "假日",
      "content": [
        "素琴弦断酒缾空，倚坐欹眠日已中。",
        "谁向刘灵天幕内，更当陶令北窻风。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276934,
      "title": "寄远",
      "content": [
        "姮娥捣药无时已，玉女投壶未肯休。",
        "何日桑田俱变了，不教伊水向东流。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276935,
      "title": "王昭君",
      "content": [
        "毛延寿画欲通神，忍为黄金不顾人。",
        "马上琵琶行万里，汉宫长有隔生春。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276936,
      "title": "旧将军",
      "content": [
        "云台高议正纷纷，谁定当时荡寇勋。",
        "日暮灞陵原上猎，李将军是故将军。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276937,
      "title": "曼倩辞",
      "content": [
        "十八年来堕世间，瑶池归梦碧桃闲。",
        "如何汉殿穿针夜，又向窻中觑阿环。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276938,
      "title": "所居",
      "content": [
        "窻下寻书细，溪边坐石平。",
        "水风醒酒病，霜日曝衣轻。",
        "鸡黍随人设，蒲渔得地生。",
        "前贤无不谓，容易即遗名。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276939,
      "title": "高松",
      "content": [
        "高松出众木，伴我向天涯。",
        "客散初晴候，僧来不语时。",
        "有风传雅韵，无雪试幽姿。",
        "上药终相待，他年访伏龟。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276940,
      "title": "访秋",
      "content": [
        "酒薄吹还醒，楼危望已穷。",
        "江臯当落日，帆席见归风。",
        "烟带龙潭白，霞分鸟道红。",
        "殷勤报秋意，只是有丹枫。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276941,
      "title": "昭州",
      "content": [
        "桂水春犹早，昭川日正西。",
        "虎当官道鬬，猿上驿楼啼。",
        "绳烂金沙井，松干乳洞梯。",
        "乡音殊可骇，仍有醉如泥。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276942,
      "title": "哭刘司户蕡",
      "content": [
        "路有论冤谪，言皆在中兴。",
        "空闻迁贾谊，不待相孙弘。",
        "江阔惟回首，天高但抚膺。",
        "去年相送地，春雪满黄陵。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276943,
      "title": "裴明府居止",
      "content": [
        "爱君茅屋下，向晚水溶溶。",
        "试墨书新竹，张琴和古松。",
        "坐来闻好鸟，归去度疎钟。",
        "明日还相见，桥南贳酒醲。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276944,
      "title": "陆发荆南始至商洛",
      "content": [
        "昔去真无奈，今还岂自知。",
        "青辞木奴橘，紫见地仙芝。",
        "四海秋风阔，千嵓暮景迟。",
        "向来忧际会，犹有五湖期。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276945,
      "title": "陈后宫",
      "content": [
        "玄武开新苑，龙舟䜩幸频。",
        "渚莲参法驾，沙鸟犯句陈。",
        "寿献金茎露，歌翻玉树尘。",
        "夜来江令醉，别诏宿临春。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276946,
      "title": "乐游原",
      "content": [
        "春梦乱不记，春原登已重。",
        "青门弄烟柳，紫阁舞云松。",
        "拂砚轻冰散，开尊绿酎浓。",
        "无悰托诗遣，吟罢更无悰。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276947,
      "title": "赠子直花下",
      "content": [
        "池光忽隐墙，花气乱侵房。",
        "屏缘蝶留粉，窗油蜂印黄。",
        "官书推小吏，侍史从清郎。",
        "竝马更吟去，寻思有底忙。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276948,
      "title": "小园独酌",
      "content": [
        "柳带谁能结，花房未肯开。",
        "空余双蝶舞，竟绝一人来。",
        "半展龙须席，轻斟玛瑙杯。",
        "年年春不定，虚信岁前梅。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276949,
      "title": "思归",
      "content": [
        "固有楼堪依，能无酒可倾。",
        "岭云春沮洳，江月夜晴明。",
        "鱼乱书何托，猿哀梦易惊。",
        "旧居连上苑，时节正迁鸎。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276950,
      "title": "献寄旧府开封公",
      "content": [
        "幕府三年远，春秋一字襃。",
        "书论秦逐客，赋续楚离骚。",
        "地理南溟阔，天文北极高。",
        "酬恩抚身世，未觉胜鸿毛。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276951,
      "title": "向晚",
      "content": [
        "当风横去幰，临水卷空帷。",
        "北土秋千罢，南朝祓禊归。",
        "花情羞脉脉，柳意怅微微。",
        "莫叹佳期晚，佳期自古稀。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276952,
      "title": "春游",
      "content": [
        "桥峻斑骓疾，川长白鸟高。",
        "烟轻惟润柳，风滥欲吹桃。",
        "徙倚三层阁，摩挲七宝刀。",
        "庾郎年最少，青草妬春袍。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276953,
      "title": "离席",
      "content": [
        "出宿金尊掩，从公玉帐新。",
        "依依向余照，远远隔芳尘。",
        "细草翻惊雁，残花伴醉人。",
        "杨朱不用劝，只是更霑巾。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276954,
      "title": "俳谐",
      "content": [
        "短顾何由遂，迟光且莫惊。",
        "鸎能歌子夜，蝶解舞宫城。",
        "柳讶眉双浅，桃猜粉太轻。",
        "年华有情状，吾岂怯平生。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276955,
      "title": "细雨",
      "content": [
        "萧洒傍回汀，依微过短亭。",
        "气凉先动竹，点细未开萍。",
        "稍促高高燕，微疎的的萤。",
        "故园烟草色，仍近五门青。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276956,
      "title": "商于新开路",
      "content": [
        "六百商于路，崎岖古共闻。",
        "蜂房春欲暮，虎穽日初曛。",
        "路向泉间辨，人从树杪分。",
        "更谁开捷径，速拟上青云。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276957,
      "title": "题郑大有隐居",
      "content": [
        "结构何峰是，喧闲此地分。",
        "石梁高泻月，樵路细侵云。",
        "堰卧蛟螭室，希夷鸟兽群。",
        "近知西岭上，玉管有时闻。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276958,
      "title": "夜饮",
      "content": [
        "卜夜容衰鬓，开筵属异方。",
        "烛分歌扇泪，雨送酒船香。",
        "江海三年客，乾坤百战场。",
        "谁能辞酩酊，淹卧剧清漳。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276959,
      "title": "江上",
      "content": [
        "万里风来地，清江北望楼。",
        "云通梁苑路，月带楚城秋。",
        "刺字从漫灭，归途尚阻修。",
        "前程更烟水，吾道岂淹留。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276960,
      "title": "凉思",
      "content": [
        "客去波平槛，蝉休露满枝。",
        "永怀当此节，倚立自移时。",
        "北斗兼春远，南陵寓使迟。",
        "天涯占梦数，疑误有新知。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276961,
      "title": "鸶凤",
      "content": [
        "旧镜鸾何处，衰桐凤不栖。",
        "金钱饶孔雀，锦段落山鸡。",
        "王子调清管，天人降紫泥。",
        "岂无云路分，相望不应迷。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276962,
      "title": "李卫公",
      "content": [
        "绛纱弟子音尘绝，鸾镜佳人旧会稀。",
        "今日致身歌舞地，木棉花暖鹧鸪飞。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276963,
      "title": "韦蟾",
      "content": [
        "谢家离别正凄凉，少傅临岐赌佩囊。",
        "却忆短亭回首处，夜来烟雨满池塘。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276964,
      "title": "自贶",
      "content": [
        "陶令弃官后，仰眠书屋中。",
        "谁将五斗米，拟换北窗风。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 276965,
      "title": "蝶",
      "content": [
        "孤蝶小徘徊，翩翾粉翅开。",
        "并应伤皎洁，频近雪中来。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 276966,
      "title": "夜意",
      "content": [
        "帘垂幕半卷，枕冷被仍香。",
        "如何为相忆，魂梦过潇湘。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 276967,
      "title": "因书",
      "content": [
        "绝徼南通栈，孤城北枕江。",
        "猿声连月槛，鸟影落天窗。",
        "海石分碁子，郫筒当酒缸。",
        "生归话辛苦，别夜对凝釭。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276968,
      "title": "奉寄安国大师兼简子蒙",
      "content": [
        "忆奉莲花座，兼闻贝叶经。",
        "岩光分蜡屐，涧响入铜缾。",
        "日下徒推鹤，天涯正对萤。",
        "鱼山羡曹植，眷属有文星。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276969,
      "title": "闲游",
      "content": [
        "危亭题竹粉，曲沼嗅荷花。",
        "数日同携酒，平明不在家。",
        "寻幽殊未极，得句总堪夸。",
        "强下西楼去，西楼倚暮霞。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276970,
      "title": "县中恼饮席",
      "content": [
        "晚醉题诗赠物华，罢吟还醉忘归家。",
        "若无江氏五色笔，争奈河阳一县花。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276971,
      "title": "题李上謩壁",
      "content": [
        "旧著思玄赋，新编杂拟诗。",
        "江庭犹近别，山舍得幽期。",
        "嫩割周颙韭，肥烹鲍照葵。",
        "饱闻南烛酒，仍及拨醅时。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276972,
      "title": "江村题壁",
      "content": [
        "沙岸竹森森，维艄听越禽。",
        "数家同老寿，一径自阴深。",
        "喜客尝留橘，应官说采金。",
        "倾壶真得地，爱日静霜砧。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276973,
      "title": "即日",
      "content": [
        "桂林闻旧说，曾不异炎方。",
        "山响匡床语，花飘度腊香。",
        "几时逢雁足，著处断猿肠。",
        "独抚青青桂，临城忆雪霜。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276974,
      "title": "漫成五章 一",
      "content": [
        "沈宋裁辞矜变律，王杨落笔得良朋。",
        "当时自谓宗师妙，今日惟观对属能。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276975,
      "title": "漫成五章 二",
      "content": [
        "李杜操持事略齐，三才万象共端倪。",
        "集仙殿与金銮殿，可是苍蝇惑曙鸡。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276976,
      "title": "漫成五章 三",
      "content": [
        "生儿古有孙征虏，嫁女今无王右军。",
        "借问琴书终一世，何如旗盖仰三分。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276977,
      "title": "漫成五章 四",
      "content": [
        "代北偏师衔使节，关中裨将建行台。",
        "不妨常日饶轻薄，且喜临戎用草莱。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276978,
      "title": "漫成五章 五",
      "content": [
        "郭令素心非黩武，韩公本意在和戎。",
        "两都耆旧偏垂泪，临老中原见朔风。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276979,
      "title": "射鱼曲",
      "content": [
        "思牢弩箭磨青石，绣额蛮渠三虎力。",
        "寻潮背日伺泅鳞，贝阙夜移鲸失色。",
        "纤纤粉簳馨香饵，绿鸭回塘养龙水。",
        "含冰汉语远于天，何由回作金盘死。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276980,
      "title": "日高",
      "content": [
        "镀镮故锦縻轻拖，玉𥫽不动便门锁。",
        "水精眠梦是何人，栏药日高红髲𩭝。",
        "飞香上云春诉天，云梯十二门九关。",
        "轻身灭影何可望，粉蛾帖死屏风上。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276981,
      "title": "宫中曲",
      "content": [
        "云母滤宫月，夜夜白于水。",
        "赚得羊车来，低扇遮黄子。",
        "水精不觉冷，自刻鸳鸯翅。",
        "蚕缕茜香浓，正朝缠左臂。",
        "巴牋两三幅，满写承恩字。",
        "欲得识青天，昨夜苍龙是。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 276982,
      "title": "海上谣",
      "content": [
        "桂水寒于江，玉兔秋冷咽。",
        "海底觅仙人，香桃如瘦骨。",
        "紫鸾不肯舞，满翅蓬山雪。",
        "借得龙堂宽，晓出揲云髪。",
        "刘郎旧香炷，立见茂陵树。",
        "云孙帖帖卧秋烟，上元细字如蚕眠。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 276983,
      "title": "李夫人三首 一",
      "content": [
        "一带不结心，两股方安髻。",
        "慙愧白茅人，月没教星替。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 276984,
      "title": "李夫人三首 二",
      "content": [
        "剩结茱萸枝，多擘秋莲的。",
        "独自有波光，彩囊盛不得。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 276985,
      "title": "李夫人三首 三",
      "content": [
        "蛮丝系条脱，妍眼和香屑。",
        "寿宫不惜铸南人，柔肠早被秋眸割。",
        "清澄有余幽素香，鳏鱼渴凤真珠房。",
        "不知瘦骨类冰井，更许夜帘通晓霜。",
        "土花漠漠云茫茫，黄河欲尽天苍苍。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 276986,
      "title": "景阳宫井双桐",
      "content": [
        "秋港菱花干，玉盘明月蚀。",
        "血渗两枯心，情多去未得。",
        "徒经白门伴，不见丹山客。",
        "未待刻作人，愁多有魂魄。",
        "谁将玉盘与，不死翻相误。",
        "天更阔于江，孙枝觅郎主。",
        "昔妬隣宫槐，道类双眉歛。",
        "今日繁红樱，抛人占长簟。",
        "翠襦不禁绽，留泪啼天眼。",
        "寒灰劫尽问方知，石羊不去谁相绊。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 276987,
      "title": "秋日晚思",
      "content": [
        "桐槿日零落，雨余方寂寥。",
        "枕寒庄蝶去，窻冷胤萤销。",
        "取适琴将酒，忘名牧与樵。",
        "平生有游旧，一一在烟霄。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276988,
      "title": "春宵自遣",
      "content": [
        "地胜遗尘事，身闲念岁华。",
        "晚晴风过竹，深夜月当花。",
        "石乱知泉咽，苔荒任迳斜。",
        "陶然恃琴酒，忘却在山家。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276989,
      "title": "七夕偶题",
      "content": [
        "宝婺摇珠珮，常娥照玉轮。",
        "灵归天上匹，巧遗世间人。",
        "花果香千户，笙竽滥四隣。",
        "明朝晒犊鼻，方信阮家贫。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276990,
      "title": "灵仙阁晚眺寄郓州韦评事",
      "content": [
        "愚公方住谷，仁者本依山。",
        "共誓林泉志，胡为尊俎间。",
        "华莲开菡萏，荆玉刻孱颜。",
        "爽气临周道，岚光入汉关。",
        "满壶徒蚁泛，高阁已苔斑。",
        "想就安车召，宁期负矢还。",
        "潘游全璧散，郭去半舟闲。",
        "定笑幽人迹，鸿轩不可攀。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 276991,
      "title": "幽居冬暮",
      "content": [
        "羽翼摧残日，郊园寂寞时。",
        "晓鸡惊树雪，寒骛守冰池。",
        "急景忽云暮，颓年浸已衰。",
        "如何匡国分，不与夙心期。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276992,
      "title": "过姚孝子庐偶书",
      "content": [
        "拱木临周道，荒庐积古苔。",
        "鱼因感姜出，鹤为吊陶来。",
        "两鬓蓬常乱，双眸血不开。",
        "圣朝敦尔类，非独路人哀。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276993,
      "title": "赋得月照冰池",
      "content": [
        "皓月方离海，坚冰正满池。",
        "金波双激射，璧彩两参差。",
        "影占徘徊处，光含的皪时。",
        "高低连素色，上下接清规。",
        "顾兔飞难定，潜鱼跃未期。",
        "鹊惊俱欲遶，狐听始无疑。",
        "似镜将盈手，如霜恐透肌。",
        "独怜游翫意，达晓不知疲。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 276994,
      "title": "永乐县所居一草一木无非自栽今春悉已芳茂因书即事一章",
      "content": [
        "手种悲陈事，心期玩物华。",
        "柳飞彭泽雪，桃散武陵霞。",
        "枳嫩栖鸾叶，桐香待凤花。",
        "绶藤萦弱蔓，袍草展新芽。",
        "学植功虽倍，成蹊迹尚赊。",
        "芳年谁共玩，终老邵平瓜。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 276995,
      "title": "南潭上亭䜩集以疾后至因而抒情",
      "content": [
        "马卿聊应召，谢傅已登山。",
        "歌发百花外，乐调深竹间。",
        "鹢舟萦远岸，鱼钥启重关。",
        "鸎蝶如相引，烟萝不暇攀。",
        "佳人启玉齿，上客颔朱颜。",
        "肯念沈疴士，俱期倒载还。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 276996,
      "title": "寒食行次冷泉驿",
      "content": [
        "驿途仍近节，旅宿倍思家。",
        "独夜三更月，空庭一树花。",
        "介山当驿秀，汾水遶关斜。",
        "自怯春寒苦，那堪禁火赊。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276997,
      "title": "寄华岳孙逸人",
      "content": [
        "灵岳几千仞，老松逾百寻。",
        "攀崖仍蹑壁，噉叶复眠阴。",
        "海上呼三岛，斋中戏五禽。",
        "唯应逢阮籍，长啸作鸾音。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276998,
      "title": "戏题赠稷山驿吏王全",
      "content": [
        "绛台驿吏老风尘，耽酒成仙几十春。",
        "过客不劳询甲子，惟书亥字与时人。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276999,
      "title": "和韦潘前辈七月十二日夜泊池州城下先寄上李使君",
      "content": [
        "桂含爽气三秋首，蓂吐中旬二叶新。",
        "正是澄江如练处，玄晖应喜见诗人。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 277000,
      "title": "花下醉",
      "content": [
        "寻芳不觉醉流霞，倚树沈眠日已斜。",
        "客散酒醒深夜后，更持红烛赏残花。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 277001,
      "title": "所居永乐县久旱县宰祈祷得雨因赋诗",
      "content": [
        "甘膏滴滴是精诚，昼夜如丝一尺盈。",
        "祗怪闾阎喧鼓吹，邑人同报束长生。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 277002,
      "title": "正月十五夜闻京有灯恨不得观",
      "content": [
        "月色灯光满帝都，香车宝辇隘通衢。",
        "身闲不睹中兴盛，羞逐乡人赛紫姑。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 277003,
      "title": "赠赵协律晳",
      "content": [
        "俱识孙公与谢公，二年歌哭处还同。",
        "已叨邹马声华末，更共刘卢族望通南省恩深宾馆在，东山事往妓楼空。",
        "不堪岁暮相逢地，我欲西征君又东。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 277004,
      "title": "摇落",
      "content": [
        "摇落伤年日，羁留念远心。",
        "水亭吟断续，月幌梦飞沈。",
        "古木含风久，疎萤怯露深。",
        "人闲始遥夜，地迥更清砧。",
        "结爱曾伤晚，端忧复至今。",
        "未谙沧海路，何处玉山岑？",
        "滩激黄牛暮，云屯白帝阴。",
        "遥知霑洒意，不减欲分襟。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 277005,
      "title": "滞雨",
      "content": [
        "滞雨长安夜，残灯独客愁。",
        "故乡云水地，归梦不宜秋。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 277006,
      "title": "偶题二首 一",
      "content": [
        "小亭闲眠微醉消，山榴海栢枝相交。",
        "水文簟上琥珀枕，傍有堕钗双翠翘。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 277007,
      "title": "偶题二首 二",
      "content": [
        "清月依微香露轻，曲房小院多逢迎。",
        "春丛定见饶栖鸟，饮罢莫持红烛行。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 277008,
      "title": "月",
      "content": [
        "过水穿楼触处明，藏人带树远含清。",
        "初生欲缺虚惆怅，未必圆时即有情。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 277009,
      "title": "夜冷",
      "content": [
        "树遶池宽月影多，村砧坞笛隔风萝。",
        "西亭翠被余香薄，一夜将愁向败荷。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 277010,
      "title": "正月崇让宅",
      "content": [
        "密锁重关掩绿苔，廊深阁迥此徘徊。",
        "先知风起月含晕，尚自露寒花未开。",
        "蝙拂帘旌终展转，鼠翻牕网小惊猜。",
        "背灯独共余香语，不觉犹歌起夜来。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 277011,
      "title": "城外",
      "content": [
        "露寒风定不无情，临水当山又隔城。",
        "未必明时胜蜯蛤，一生长共月亏盈。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 277012,
      "title": "撰彭阳公志文毕有感",
      "content": [
        "延陵留表墓，岘首送沈碑。",
        "敢伐不加点，犹当无愧辞。",
        "百生终莫报，九死谅难追。",
        "待得生金后，川原亦几移。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 277013,
      "title": "北青萝",
      "content": [
        "残阳西入崦，茅屋访孤僧。",
        "落叶人何在，寒云路几层。",
        "独敲初夜磬，闲倚一枝藤。",
        "世界微尘里，吾宁爱与憎。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 277014,
      "title": "戏赠张书记",
      "content": [
        "别馆君孤枕，空庭我闭关。",
        "池光不受月，野气欲沈山。",
        "星汉秋方会，关河梦几还。",
        "危弦伤远道，明镜惜红颜。",
        "古木含风久，平芜尽日闲。",
        "心知两愁绝，不段若寻环。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 277015,
      "title": "幽人",
      "content": [
        "丹灶三年火，苍崖万岁藤。",
        "樵归说逢虎，碁罢正留僧。",
        "星斗同秦分，人烟接汉陵。",
        "东流清渭苦，不尽照衰兴。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 277016,
      "title": "念远",
      "content": [
        "日月淹秦甸，江湖动越吟。",
        "苍桐应露下，白阁自云深。",
        "皎皎非鸾扇，翘翘失凤簪。",
        "床空鄂君被，杵冷女媭砧。",
        "北思惊沙雁，南情属海禽。",
        "关山已摇落，天地共登临。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 277017,
      "title": "过故崔兖海宅与崔明秀才话旧因寄僚杜赵李三掾",
      "content": [
        "绛帐恩如昨，乌衣事莫寻。",
        "诸生空会葬，旧掾已华簪。",
        "共入留宾驿，俱分市骏金。",
        "莫凭无鬼论，终负托孤心。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 277018,
      "title": "微雨",
      "content": [
        "初随林霭动，稍共夜凉分。",
        "窗迥侵灯冷，庭虚近水闻。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 277019,
      "title": "南山赵行军新诗盛称游䜩之洽因寄一绝",
      "content": [
        "莲幕遥临黑水津，橐鞬无事但寻春。",
        "梁王司马非孙武，且免宫中斩美人。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    }
  ],
