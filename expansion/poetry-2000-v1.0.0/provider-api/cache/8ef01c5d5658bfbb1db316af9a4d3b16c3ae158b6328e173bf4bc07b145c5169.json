{
  "data": [
    {
      "id": 156640,
      "title": "己卯十月一日至燕越五日罹狴犴有感而赋  其一七",
      "content": [
        "珙璧衣冠十六传，更无一士死君前。",
        "自惭重赵非九鼎，犹幸延韩更数年。",
        "孟博囊头真自爱，杲卿钩舌要谁怜。",
        "人间信有纲常在，万古西山皎月悬。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 156641,
      "title": "和夷齐西山歌  其一",
      "content": [
        "小雅尽废兮，出车采薇矣。",
        "戎有中国兮，人类熄矣。",
        "明王不兴兮，吾谁与归矣。",
        "抱春秋以没世兮，甚矣吾衰矣。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 156642,
      "title": "和夷齐西山歌  其二",
      "content": [
        "彼美人兮，西山之薇矣。",
        "北方之人兮，为吾是非矣。",
        "异域长绝兮，不复归矣。",
        "凤不至兮，德之衰矣。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 156643,
      "title": "十二月二十日作",
      "content": [
        "家国哀千古，星霜忽一周。",
        "黄沙漫故道，白骨委荒丘。",
        "许远死何晚，李陵生自羞。",
        "南来冠不改，吾且任吾囚。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156644,
      "title": "二十四日",
      "content": [
        "壮心负光岳，病质落幽燕。",
        "春节前三日，江乡正小年。",
        "岁时如有水，风俗不同天。",
        "家庙荒苔滑，谁人烧纸钱。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156645,
      "title": "立春",
      "content": [
        "无限斜阳故国愁，朔风吹马上幽州。",
        "天翻地覆三生劫，岁晚江空万里囚。",
        "烈士丧元端不惜，达人知命复何忧。",
        "祇应四十三年死，两度无端见土牛。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 156646,
      "title": "遇灵阳子谈道赠以诗",
      "content": [
        "昔我爱泉石，长揖离公卿。",
        "结屋青山下，咫尺蓬与瀛。",
        "至人不可见，世尘忽相缨。",
        "业风吹浩劫，蜗角争浮名。",
        "偶逢大吕翁，如有宿世盟。",
        "相从语寥廓，俯仰万念轻。",
        "天地不知老，日月交其精。",
        "人一阴阳性，本来自长生。",
        "指点虚无间，引我归员明。",
        "一针透顶门，道骨由天成。",
        "我如一逆旅，久欲蹑𪨗行。",
        "闻师此妙诀，蘧庐复何情。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 156647,
      "title": "岁祝犁单阏月赤奋若日焉逢涒滩遇异人指示以大光明正法于是死生脱然若遗矣作五言八句",
      "content": [
        "谁知真患难，忽悟大光明。",
        "日出云俱静，风消水自平。",
        "功名几灭性，忠孝大劳生。",
        "天下惟豪杰，神仙立地成。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156648,
      "title": "己卯岁除",
      "content": [
        "岁除破衣裳，夜半刺针线。",
        "游子长夜思，佳人不可见。",
        "草枯稚馿吼，灯暗饥鼠现。",
        "深室闭星斗，轻裘卧风霰。",
        "大化忽流斡，浩劫荡回转。",
        "冠屦失其位，侯王化畸贱。",
        "弓戈叱奇字，刀锯摧䪻弁。",
        "至性讵可迁，微躯不足恋。",
        "真人坐冲漠，死生一乘传。",
        "日月行万古，神光索九县。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 156649,
      "title": "元日",
      "content": [
        "铁马风尘暗，金龙日月新。",
        "衣冠怀故国，鼓角泣离人。",
        "自分流年晚，不妨吾道春。",
        "方来有千载，儿女枉悲辛。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156650,
      "title": "庚辰四十五岁",
      "content": [
        "东风昨夜忽相过，天地无情柰老何。",
        "千载方来那有尽，百年未半已为多。",
        "君传南海长生药，我爱西山饿死歌。",
        "泡影生来随自在，悠悠不管世间魔。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 156651,
      "title": "感兴",
      "content": [
        "万里云山断客魂，浮云心事向谁言。",
        "月侵乡梦夜推枕，风送牢愁昼掩门。",
        "苏子窖中闲日月，石郎家里旧乾坤。",
        "朝闻夕死吾何恨，坐把春秋子细论。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 156652,
      "title": "正月十三日",
      "content": [
        "去年今日遁崖山，望见龙舟咫尺间。",
        "海上楼台俄已变，河阳车驾不须还。",
        "可怜羝乳烟横塞，空想鹃啼月掩关。",
        "人世流光忽如此，东风吹雪鬓毛班。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 156653,
      "title": "上元怀旧",
      "content": [
        "禁门三五金吾夜，回首青春忽二毛。",
        "池上昔陪王母宴，斗中今直贵人牢。",
        "风生江海龙游远，月满关山鹤唳高。",
        "梦到钧天灯火閙，依然彩笔照宫袍。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 156654,
      "title": "读史",
      "content": [
        "自古英雄士，还为薄命人。",
        "孔明登四十，韩信过三旬。",
        "壮志摧龙虎，高词泣鬼神。",
        "一朝事千古，何用怨青春。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156655,
      "title": "感伤",
      "content": [
        "家国伤冰泮，妻孥叹陆沉。",
        "半生遭万劫，一落下千寻。",
        "各任汝曹命，那知吾辈心。",
        "人谁无骨肉，恨与海俱深。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156656,
      "title": "遣兴  其一",
      "content": [
        "一落颠崖不自由，春风相对说牢愁。",
        "稚馿黑月光中吼，饥鼠青灯影下游。",
        "岂料乾坤成堕甑，始知身世是虚舟。",
        "遥怜海上今尘土，前代风流不肯休。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 156657,
      "title": "遣兴  其二",
      "content": [
        "东风吹草日高眠，试把平生细问天。",
        "燕子愁迷江右月，杜鹃声破洛阳烟。",
        "何从林下寻元亮，只向尘中作鲁连。",
        "莫笑道人空打坐，英雄收敛便神仙。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 156658,
      "title": "四月八日",
      "content": [
        "今朝浴佛旧风流，身落山前第一州。",
        "赣上瑶桃俄五稔，海中玉果已三周。",
        "人生聚散真成梦，世事悲懽一转头。",
        "坐对薰风开口笑，满怀耿耿复何求。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 156659,
      "title": "夜起",
      "content": [
        "梦破东窗月半明，此身虽在只堪惊。",
        "一春花里离人泪，万里灯前故国情。",
        "龙去想应回海岛，雁飞犹未出江城。",
        "客愁多似西山雨，一任萧条白发生。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 156660,
      "title": "端午感兴  其一",
      "content": [
        "千金铸镜百神愁，功与当年禹服侔。",
        "荆棘故宫魑魅走，空余扬子水东流。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 156661,
      "title": "端午感兴  其二",
      "content": [
        "当年忠血堕谗波，千古荆人祭汨罗。",
        "风雨天涯芳草梦，江山如此故都何。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 156662,
      "title": "端午感兴  其三",
      "content": [
        "流棹西来恨未销，鱼龙寂寞暗风潮。",
        "楚人犹自贪儿戏，江上年年夺锦标。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 156663,
      "title": "见艾有感",
      "content": [
        "过眼惊初夏，回头忆晚春。",
        "已怜花结子，又见艾为人。",
        "故国丹心老，中原白发新。",
        "灵修那解化，清梦楚江滨。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156664,
      "title": "自叹",
      "content": [
        "绿槐云影弄黄昏，月照牢愁半掩门。",
        "一片心如千片碎，十分须有二分存。",
        "沙边黄鹄长回首，江上杜鹃空断魂。",
        "竖子溷人漫不省，红缨白马意轩轩。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 156665,
      "title": "自遣",
      "content": [
        "诗余眠白日，饮后坐清风。",
        "万事乘除里，平生宠辱中。",
        "心无随境变，意自与天通。",
        "莫笑邯郸梦，惺惺更是空。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156666,
      "title": "自述",
      "content": [
        "赤舄登黄道，朱旗上紫垣。",
        "有心扶日月，无力报乾坤。",
        "往事飞鸿渺，新愁落照昏。",
        "千年沧海上，精卫是吾魂。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156667,
      "title": "不睡",
      "content": [
        "终夕起推枕，五更闻打钟。",
        "精神入朱鸟，形影落卢龙。",
        "弭节蓬莱岛，扬旗太华峰。",
        "奔驰竟何事，回首谢乔松。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156668,
      "title": "七夕",
      "content": [
        "大地风尘恶，长天岁月奔。",
        "忧来浑是感，梦破与谁言。",
        "缑鹤空回首，河牛暗断魂。",
        "吾今拙又拙，无复问天孙。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156669,
      "title": "有感",
      "content": [
        "石郎草草割山川，一落人手三百年。",
        "八州风雨暗连天，三皇五帝如飞烟。",
        "人人野祭伊水边，春秋断烂不复传。",
        "白头潦倒今鲁连，夜深危坐日晏眠。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 156670,
      "title": "闻季万至",
      "content": [
        "去年别我旋出岭，今年汝来亦至燕。",
        "弟兄一囚一乘马，同父同母不同天。",
        "可怜骨肉相聚散，人间不满五十年。",
        "三仁生死各有意，悠悠白日横苍烟。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 156671,
      "title": "有感",
      "content": [
        "平生心事付悠悠，风雨燕南老楚囚。",
        "故旧相思空万里，妻孥不见满三秋。",
        "绝怜诸葛隆中意，赢得子长天下游。",
        "一死皎然无复恨，忠魂多少暗荒丘。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 156672,
      "title": "感怀",
      "content": [
        "去岁趋燕路，今晨发楚津。",
        "浪名千里客，剩作一年人。",
        "镜里秋容别，灯前暮影亲。",
        "鲁连疑未死，聊用托芳尘。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156673,
      "title": "重阳  其一",
      "content": [
        "飘零万里若为家，一夜西风吹鬓华。",
        "祇有新诗题甲子，更无故旧对黄花。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 156674,
      "title": "重阳  其二",
      "content": [
        "江南秋色满梧桐，回首青山万事空。",
        "怕见镜中新白发，长将破帽裹西风。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 156675,
      "title": "重阳  其三",
      "content": [
        "风卷车尘弄晓寒，天涯流落寸心丹。",
        "去年醉与茱萸别，不把今年作健看。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 156676,
      "title": "己卯十月一日予入燕城岁月冉冉忽复周星而予犹未得死也因赋八句",
      "content": [
        "去冬阳月朔，吾始至幽燕。",
        "浩劫真千载，浮生又一年。",
        "天南照天北，山后接山前。",
        "梦里乾坤老，孤臣雪咽毡。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156677,
      "title": "己卯十月五日予入燕狱今三十有六旬感兴一首",
      "content": [
        "石晋旧燕赵，钟仪新楚囚。",
        "山河千古痛，风雨一年周。",
        "过雁催人老，寒花送客愁。",
        "卷帘云满座，抱膝意悠悠。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156678,
      "title": "去年十月九日余至燕城今周星不报为赋长句",
      "content": [
        "君不见常山太守骂羯奴，天津桥上舌尽刳。",
        "又不见睢阳将军怒切齿，三十六人同日死。",
        "去冬长至前一日，朔庭呼我弗为屈。",
        "丈夫开口即见胆，意谓生死在顷刻。",
        "赭衣冉冉生苍苔，书云时节忽复来。",
        "鬼影青灯照孤坐，梦啼死血丹心破。",
        "只今便作渭水囚，食粟已是西山羞。",
        "悔不当年跳东海，空有鲁连心独在。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 156679,
      "title": "冬至",
      "content": [
        "书云今日事，梦破晓鸣钟。",
        "家祸三生劫，年愁两度冬。",
        "江山乏小草，霜雪见孤松。",
        "春色蒙泉里，烟芜几万重。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156680,
      "title": "冬晴",
      "content": [
        "北国天寒少，南方地气来。",
        "年光如箭去，世事正轮回。",
        "可怪新祈雪，相思久别梅。",
        "夜阑灯坐暗，独自拨残灰。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156681,
      "title": "自叹",
      "content": [
        "可怜大流落，白发鲁连翁。",
        "每夜瞻南斗，连年坐北风。",
        "三生遭际处，一死笑谈中。",
        "赢得千年在，丹心射碧空。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156682,
      "title": "戊寅腊月二十日空坑败被执于今二周年矣感怀八句",
      "content": [
        "横磨十万坐无谋，回首蹉跎海上州。",
        "太傅只图和药了，将军便谓斫头休。",
        "乾坤颠倒真千劫，身世留连复一周。",
        "一死到今如送佛，空窗淡月夜悠悠。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 156683,
      "title": "所怀",
      "content": [
        "万里青山两鬓华，老臣无国又无家。",
        "乾坤局促笼中鸟，风雪飘零粪上花。",
        "岁晚江空人已逝，天寒日短路何赊。",
        "书生不作纲常计，闻是东门已种瓜。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 156684,
      "title": "除夜  其一",
      "content": [
        "门揜千山黑，孤灯伴不眠。",
        "故乡在何处，今夕是穷年。",
        "住世真无系，为囚已自然。",
        "劳劳空岁月，得死似登仙。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156685,
      "title": "除夜  其二",
      "content": [
        "岁暮难为客，天涯况是囚。",
        "乾坤还许大，岁月忽如流。",
        "梦过元无梦，忧多更不忧。",
        "屠苏儿女态，肯作百年谋。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156686,
      "title": "元日  其一",
      "content": [
        "金虬衔日出，铁骑勒春回。",
        "天上青门隔，人间白发催。",
        "霜寒欺旧草，山晚放新梅。",
        "环堵甘牢落，东风枉却来。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156687,
      "title": "元日  其二",
      "content": [
        "慙愧云台客，飘零雪满毡。",
        "不图朱鸟影，犹见白蛇年。",
        "宫殿荒烟隔，门庭宿草连。",
        "乾坤自春色，回首一潸然。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156688,
      "title": "初六日即事",
      "content": [
        "车马燕山閙，谁家早管弦。",
        "开门忽见雪，拥被不知年。",
        "箧破书犹在，炉残火复燃。",
        "偷桃昨日事，回首哭尧天。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156689,
      "title": "人日",
      "content": [
        "今年为蛇年，此日是人日。",
        "江右一龙钟，山中旧占毕。",
        "独坐守太玄，一笑发狂疾。",
        "悠悠王正意，衰涕感麟笔。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156690,
      "title": "自叹",
      "content": [
        "功业羞前辈，形骸感故吾。",
        "屡判嵇绍血，几无庆公须。",
        "落落惟心在，苍苍有意无。",
        "江流总遗泪，何止失吞吴。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156691,
      "title": "元夕  其一",
      "content": [
        "灯火喧三市，衣冠宴九宸。",
        "金吾不禁夜，公子早行春。",
        "梦断青山远，愁侵白发新。",
        "燕山今夕月，清影伴孤臣。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156692,
      "title": "元夕  其二",
      "content": [
        "飘零竟如此，元夕几堪怜。",
        "南国张灯火，燕山沸管弦。",
        "相思云万里，剩看月三年。",
        "笑与东风道，浮生信偶然。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 156693,
      "title": "社稷第一",
      "content": [
        "南极连铜柱，煌煌太宗业。",
        "始谋谁其间，风雨秋一叶。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 156694,
      "title": "理宗度宗第二",
      "content": [
        "先帝弓剑远，永怀侍芳茵。",
        "今朝汉社稷，为话涕沾巾。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 156695,
      "title": "误国权臣第三",
      "content": [
        "苍生倚大臣，此风破南极。",
        "开边一何多，至死难塞责。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 156696,
      "title": "泸州大将第四",
      "content": [
        "西南失大将，带甲满天地。",
        "高人忧祸胎，感叹亦歔欷。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 156697,
      "title": "襄阳第五",
      "content": [
        "十年杀气盛，百万攻一城。",
        "贼臣表逆节，胡骑忽纵横。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 156698,
      "title": "荆湖诸戍第六",
      "content": [
        "长啸下荆门，胡行速如鬼。",
        "门户无人持，社稷堪流涕。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 156699,
      "title": "黄州第七",
      "content": [
        "桓桓陈将军，东屯大江北。",
        "化作虎与豺，楚星南天黑。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 156700,
      "title": "阳罗堡第八",
      "content": [
        "日色隠孤戍，大江声怒号。",
        "朝廷任猛将，宿昔恨滔滔。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 156701,
      "title": "京湖宣阃第九",
      "content": [
        "正当艰难时，岂无济时策。",
        "连樯荆州船，悠悠回赤壁。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 156702,
      "title": "渡江第十",
      "content": [
        "济江元自阔，轻舟下吴会。",
        "南纪改波澜，吾将罪真宰。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 156703,
      "title": "鄂州第十一",
      "content": [
        "鄂渚分云树，春城带雨长。",
        "惜哉形胜地，河岳空金汤。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 156704,
      "title": "江州第十二",
      "content": [
        "戎马暗天宇，落日九江流。",
        "元恶迷是似，化作黄长虬。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 156705,
      "title": "安庆府第十三",
      "content": [
        "岸转异江湖，江水流城郭。",
        "鸱鸮志意满，山鬼独一脚。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 156706,
      "title": "鲁港之遁第十四",
      "content": [
        "出师亦多门，水陆迷畏途。",
        "蹭蹬麒麟老，危樯逐夜乌。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 156707,
      "title": "建康府第十五",
      "content": [
        "亭亭凤凰台，江城孤照日。",
        "胡来满彤宫，驱马一万匹。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 156708,
      "title": "相陈宜中第十六",
      "content": [
        "苍生起谢安，翠华拥吴岳。",
        "可以一木支，俯恐坤轴弱。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 156709,
      "title": "召张世杰第十七",
      "content": [
        "诏发西山将，熊虎亘阡陌。",
        "笳鼓凝皇情，佳气向金阙。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 156710,
      "title": "镇江之战第十八",
      "content": [
        "海胡舶千艘，肉食三十万。",
        "江平不肯流，到今有遗恨。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 156711,
      "title": "将相弃国第十九",
      "content": [
        "扈圣登黄阁，大将赴朝廷。",
        "胡为入云雾，浩荡乘沧溟。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 156712,
      "title": "京城第二十",
      "content": [
        "当宁陷玉座，两宫弃紫微。",
        "北城悲笳发，失涕万人挥。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 156713,
      "title": "京城二十一",
      "content": [
        "黄屋朔风卷，园林杀气平。",
        "宫殿青门隔，永怀丹凤城。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 156714,
      "title": "陵寝第二十二",
      "content": [
        "五陵花满眼，霜露在草根。",
        "冥冥子规叫，重是古帝魂。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 156715,
      "title": "陵寝第二十三",
      "content": [
        "旄头彗紫微，蚩尤塞寒空。",
        "愚智心尽死，漂荡随高风。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 156716,
      "title": "江陵第二十四",
      "content": [
        "闻说江陵府，今又降元戎。",
        "甲外控鸣镝，肩舆强老翁。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 156717,
      "title": "淮西帅第二十五",
      "content": [
        "借问大将谁，战骨当速朽。",
        "逆节同所归，水花笑白首。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 156718,
      "title": "扬州第二十六",
      "content": [
        "城峻随天壁，胡来但自守。",
        "士卒终倒戟，仰望嗟叹久。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 156719,
      "title": "京湖两淮第二十七",
      "content": [
        "荆扬风土暖，大城铁不如。",
        "秦山忽破碎，流落随丘墟。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 156720,
      "title": "景炎拥立第二十八",
      "content": [
        "汉运初中兴，扶颠待柱石。",
        "畴能补天漏，登阶捧玉册。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 156721,
      "title": "福安府第二十九",
      "content": [
        "崔嵬扶桑日，阔会沧海潮。",
        "倾都看黄屋，此意竟萧条。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 156722,
      "title": "幸海道第三十",
      "content": [
        "天王守太白，立国自有疆。",
        "舍此复何之，已具浮海航。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 156723,
      "title": "景炎宾天第三十一",
      "content": [
        "阴风西北来，青海天轩轾。",
        "白水暮东流，魂断苍梧帝。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 156724,
      "title": "祥兴登极第三十二",
      "content": [
        "浮龙倚长津，参错走洲渚。",
        "苍梧云正愁，初日翳复吐。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 156725,
      "title": "祥兴第三十三",
      "content": [
        "南游炎海甸，沃野开天庭。",
        "真龙竟寂寞，乾坤水上萍。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 156726,
      "title": "祥兴第三十四",
      "content": [
        "弧矢暗江海，百万化为鱼。",
        "帝子留遗恨，故园莽丘墟。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 156727,
      "title": "祥兴第三十五",
      "content": [
        "朱崖云日高，风浪无晨暮。",
        "冥冥翠龙驾，今复在何许。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 156728,
      "title": "祥兴第三十六",
      "content": [
        "六龙忽蹉跎，川广不可溯。",
        "东风吹春水，乾坤莽回互。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 156729,
      "title": "祥兴第三十七",
      "content": [
        "幽燕盛用武，六合已一家。",
        "眼穿当落日，沧海有灵查。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 156730,
      "title": "祥兴第三十八",
      "content": [
        "客从南溟来，黄屋今在否。",
        "天高无消息，未忍即开口。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 156731,
      "title": "祥兴第三十九",
      "content": [
        "南岳配朱鸟，望岳地轴为之翻。",
        "皇纲未为绝，云台谁再论。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 156732,
      "title": "陈宜中第四十",
      "content": [
        "管葛本时须，经纶中兴业。",
        "有志乘鲸鳌，南纪阻归檝。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 156733,
      "title": "张世杰第四十一",
      "content": [
        "南国卷云水，黄金倾有无。",
        "蛟龙亦狼狈，反复乃须臾。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 156734,
      "title": "张世杰第四十二",
      "content": [
        "长风驾高浪，偃蹇龙虎姿。",
        "萧条犹在否，寒日出雾迟。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 156735,
      "title": "苏刘义第四十三",
      "content": [
        "骅骝事天子，龙怒拔老湫。",
        "鼓枻视青旻，烈风无时休。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 156736,
      "title": "曾渊子第四十四",
      "content": [
        "子负经济才，鬰陶抱长策。",
        "安得万里风，南图回羽翮。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 156737,
      "title": "江丞相万里第四十五",
      "content": [
        "星拆台衡地，斯文去矣休。",
        "湖光与天远，屈注沧江流。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 156738,
      "title": "赵倅昴发第四十六",
      "content": [
        "风雷飒万里，大江动我前。",
        "青衿一憔悴，名与日月悬。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 156739,
      "title": "将军王安节第四十七",
      "content": [
        "激烈伤雄才，直气横乾坤。",
        "惆怅汗血驹，见此忠孝门。"
      ],
      "author": {
        "id": 802,
        "name": "文天祥"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    }
  ],
