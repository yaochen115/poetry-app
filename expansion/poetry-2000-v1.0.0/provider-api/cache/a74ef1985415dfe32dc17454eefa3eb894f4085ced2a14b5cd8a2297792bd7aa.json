{
  "data": [
    {
      "id": 249186,
      "title": "送晁恭道侍郎守临川",
      "content": [
        "才猷表表自名卿，何况传家烜赫声。",
        "道院老人真乃祖，雪堂高弟是诸兄。",
        "一牛鸣地正接迹，五马行时尤见情。",
        "拟岘登临试回首，小轩应记碧山横。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 249187,
      "title": "送绍兴帅汤相得请洞霄归括苍二首  其一",
      "content": [
        "武公入相不虚传，奏牍求闲郤更前。",
        "圣主闵劳天下士，诏书许作地行仙。",
        "少微星分临江左，大涤山门锁日边。",
        "便以公归良易耳，午桥虽好莫留连。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 249188,
      "title": "送绍兴帅汤相得请洞霄归括苍二首  其二",
      "content": [
        "谁言富贵践危机，永日深春故里归。",
        "烟雨高楼增意气，蓬莱杰阁少光辉。",
        "向来赤舄又遵陆，此去青鞋长掩扉。",
        "画戟门东是茅宇，铃斋想像独依依。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 249189,
      "title": "送逮子赴秋试江西漕司",
      "content": [
        "有诏词场猎俊英，西风匹马豫章城。",
        "欲追诸父雁行上，肯逐群儿鱼队行。",
        "金是莫邪当自必，璞非死鼠会相明。",
        "笔端妙处还知否，万里秋天壮气横。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 249190,
      "title": "示逢子",
      "content": [
        "清臞骨相类诸生，黾勉寒窗守一经。",
        "用赋要窥司马室，学诗频过伯鱼庭。",
        "可怜亲髪镜中白，莫负子衿身上青。",
        "五桂荫门家世事，寂寥天畔几回星。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 249191,
      "title": "同逢子韵寄逮子促其归",
      "content": [
        "九日清尊要及辰，谁令形迹滞瓯闽。",
        "饶阳城畔趋庭子，长乐坡前入幕宾。",
        "竝倚门闾吾二老，相求原隰汝三人。",
        "借令不共黄花酒，莫与西风作后尘。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 249192,
      "title": "逮子得龙团胜雪茶两胯以归予其直万钱云",
      "content": [
        "移人尤物众谈夸，持以趋庭意可嘉。",
        "鲑菜自无三九种，龙团空取十千茶。",
        "烹尝便恐成灾怪，把玩那能定等差。",
        "赖有前贤小团例，一囊深贮只传家。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 249193,
      "title": "用逮子韵奉赠郑禹功参议",
      "content": [
        "雨余依砌上苍苔，竟日山房闭不开。",
        "下马厌闻生客至，敲门喜见故人来。",
        "长哦绿竹诗三叠，小酌黄花酒一杯。",
        "此外相看复何事，团蒲隐几湛灵台。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 249194,
      "title": "次钱处和赠赴召之行韵",
      "content": [
        "苍颜白髪海边州，敢与君王侧席求。",
        "水似篙深催我去，雨如丝下要人留。",
        "偶然结绶登畿左，不用攀辕拥道周。",
        "高卧耦耕吾有分，何心赐璧取封侯。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 249195,
      "title": "留别三侄",
      "content": [
        "僧窗又与汝周旋，百感相随到酒边。",
        "无复吹箎如异日，空惊枕块已三年。",
        "一门叔父吾衰矣，东阁郎君但勉旃。",
        "不为怀金纡紫事，澡身玉雪是空传。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 249196,
      "title": "春来闻故旧多云亡者作诗示同志",
      "content": [
        "雁足曾无一字收，有时书到郤生愁。",
        "故人叠叠半黄壤，今我萧萧全白头。",
        "大抵百年皆逝水，可怜万事只浮沤。",
        "朝闻夕死真吾道，圣处工夫办得不。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 249197,
      "title": "次郑禹功韵",
      "content": [
        "怪底消除执热烦，郑公方丈接三韩。",
        "空余坐榻悬犀柄，岂有行厨洗玉盘。",
        "作吏忽惊玄鸟变，寻盟未向白鸥寒。",
        "诸山只在登临眼，安得陪君杖履看。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 249198,
      "title": "次招客见赠韵",
      "content": [
        "夏夜僧窗淡月笼，新凉绝类九秋中。",
        "曲生入座有清浊，荔子堆盘能白红。",
        "持此淹留数佳客，慰予牢落一衰翁。",
        "骊驹散后君知否，独卧山房竹里风。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 249199,
      "title": "次徐㟯立韵",
      "content": [
        "此身那得作飞仙，魂梦相从但欲眠。",
        "极目参辰不相见，论心胶膝未为坚。",
        "别君甲子三千日，问我春秋七十年。",
        "久要不忘吾辈事，交情自昔几人全。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 249200,
      "title": "次王元渤问余脱齿韵",
      "content": [
        "齿危但以粥充虚，辜负公家夏屋渠。",
        "政恐曲生深作祟，可怜髯簿顿成疏。",
        "动摇不减韩吏部，蹴踏非同焦校书。",
        "落势今年残未已，秖应从此并无余。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 249201,
      "title": "吴帅见和亦复次韵",
      "content": [
        "九日心飞类琯灰，龙山直上好楼台。",
        "老身稚子扶将去，胜地元戎借得来。",
        "酒似朝霞披雾散，诗如秋菊艳霜开。",
        "至今研席珠玑满，莫道登高寂寞回。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 249202,
      "title": "次忧字韵",
      "content": [
        "公家伯仲世名流，画省归来共乐忧。",
        "稍喜对床听夜雨，永怀扇枕作凉秋。",
        "谁言小草能蠲忿，未信闲花可疗愁。",
        "惟有埙箎发清吹，渠侬无厌亦无求。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 249203,
      "title": "挽韩子苍待制",
      "content": [
        "佩声曾到鳯凰池，不尽胸中五色丝。",
        "三黜本因元祐学，一飞合在中兴时。",
        "忽惊地下修文去，太息门边问字谁。",
        "犹想泉台有新作，郊原小雨欲催诗。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 249204,
      "title": "挽郑禹功",
      "content": [
        "郑公高义绝陈雷，别我姑胥首重回。",
        "书迹横斜良足喜，讣音曲折可胜哀。",
        "定知泡影垂垂尽，故傍江湖得得来。",
        "俗眼看公终未是，无生灭处咏归哉。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 249205,
      "title": "挽梁元功",
      "content": [
        "朋俦大半白头新，臭味同流少似君。",
        "交契虽深淡如水，宦情何翅薄于云。",
        "安知暮景莺声谷，遽作高原马鬛坟。",
        "忍向西风歌薤露，略无好语颂清芬。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 249206,
      "title": "挽陈丞相",
      "content": [
        "中兴论相得耆英，进退能为国重轻。",
        "有望临人山泰华，无私待物器权衡。",
        "两朝礼貌缘同德，多士凭依为至诚。",
        "自古元臣薨位少，一时生死极哀荣。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 249207,
      "title": "悼云泉勤庵主",
      "content": [
        "正坐长斋早得衰，中年一病莫医治。",
        "悬知水复山重地，难度风饕雪虐时。",
        "乘兴前村曾有约，寄声绝顶可无诗。",
        "禅房手自栽花木，付主林神好护持。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 249208,
      "title": "上元日大雪",
      "content": [
        "句芒整辔浃辰间，雪片相随大可观。",
        "挑菜园林有余润，烧灯庭院不胜寒。",
        "柳条弄色政尔好，梅蘂飘香殊未阑。",
        "便似落花飞絮去，直疑春事并衰残。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 249209,
      "title": "寒食只旬日间风雨不已",
      "content": [
        "年光胡不少留连，熟食清明又眼前。",
        "敢望深宫传蜡烛，可堪小市禁炊烟。",
        "满城风雨无杯酒，故国松楸欠纸钱。",
        "老病心情冷时节，只将书策替幽禅。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 249210,
      "title": "寒食与客游东湖",
      "content": [
        "官曹颜状满尘埃，负郭陂湖眼为开。",
        "春色少留如过客，赏心多病只寒灰。",
        "黄童白叟喜相告，皂盖朱幡能一来。",
        "日暮游人归去尽，沙头鸥鹭与徘徊。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 249211,
      "title": "久雨",
      "content": [
        "谁言春雨散如丝，一月垂空似绠縻。",
        "云去云来何日了，花开花落不曾知。",
        "直愁排荡根荄尽，安用栽培桃李为。",
        "政恐东君不无意，十分姸暖乞酴釄。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 249212,
      "title": "上方",
      "content": [
        "前朝兰若旧闻名，绝顶禅房日月邻。",
        "木润山辉应有物，锡飞杯渡不无神。",
        "郊坰行去仅百里，郡郭往来今十春。",
        "未踏青云梯一级，会当齐侣个中人。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 249213,
      "title": "游姑苏张氏园二首  其一",
      "content": [
        "郭内名园旧所闻，扶携老稺及良辰。",
        "重重碧树深留客，一一华堂极可人。",
        "绿暗池塘初破夏，清和时节尙关春。",
        "凭谁说与沧浪水，早晚芒鞋去问津。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 249214,
      "title": "游姑苏张氏园二首  其二",
      "content": [
        "雨近黄梅细不闻，破窗夜夜看星辰。",
        "园林如许不行乐，鱼鸟有知应笑人。",
        "盛喜晴天容卜昼，绝怜小坞解藏春。",
        "何妨著我闲田地，坐看垂杨夹广津。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 249215,
      "title": "游桥南竹园",
      "content": [
        "杖屦桥南访此君，别君安否断知闻。",
        "苦遭积雨来为祟，政得新晴为解纷。",
        "直干万余森碧玉，高标一半入青云。",
        "人言歳暮于吾子，踏雪相看未当勤。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 249216,
      "title": "游沧浪亭诗",
      "content": [
        "丘壑园林得我惊，兹游便足了余生。",
        "飞来嶓冢横空翠，流出沧浪彻底清。",
        "探讨不遗幽士力，招邀难得主人情。",
        "波间渔父还知否，已挂朝冠不濯缨。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 249217,
      "title": "游虎丘",
      "content": [
        "谁能竟日把书看，荡桨扶笻十里间。",
        "未办深藏豹林谷，不妨时到虎丘山。",
        "秋来千顷境绝丽，老矣北窗人极闲。",
        "忽见题名在尘壁，余生那得许坚顽。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 249218,
      "title": "过松江",
      "content": [
        "家在朱帘画舫中，今朝误入水精宫。",
        "江澄不起无风浪，天远长垂未霁虹。",
        "酒熟杯盘供雪鲙，诗成岛屿落霜枫。",
        "帆来帆去何曾歇，万顷烟波属钓翁。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 249219,
      "title": "信衢道中溪流不通全家遵陆",
      "content": [
        "客情厌楚却思吴，白鹭汀洲政起予。",
        "渴雨溪流妨进艇，得晴山路称骑驴。",
        "满林霜著春相似，半岭云横雪不如。",
        "匹马四方男子事，饶阳况不是吾庐。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 249220,
      "title": "风月堂二首  其一",
      "content": [
        "西湖地僻少人知，隐吏官曹占作池。",
        "浩荡芙蕖风过夜，扶疏杨柳月明时。",
        "虽多不用一钱买，纵少足供千首诗。",
        "但使尊中深贮此，巵刀细薄可无饥。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 249221,
      "title": "风月堂二首  其二",
      "content": [
        "青罗熨镜正揩磨，上有虚堂发兴多。",
        "大热端能排酷吏，广寒只合在嫦娥。",
        "又成画舫珠帘去，可奈红妆翠盖何。",
        "纵使曲肱无别梦，一尊风月弄婆娑。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 249222,
      "title": "即事",
      "content": [
        "野寺山家两寂然，小窗下有白头禅。",
        "微风不动炉烟直，永日方中树影圆。",
        "隐几读书长竟夕，闭门觅句可忘年。",
        "幸无驷马高车客，触忤幽人到眼边。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 249223,
      "title": "出岭",
      "content": [
        "乞得身闲又御魑，干戈瘴疠两危机。",
        "三年似涉新冰过，十口今持旧璧归。",
        "天静不忧鸿北向，月明休咏鹊南飞。",
        "只应黄帽青鞋底，城郭人民有是非。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 249224,
      "title": "咏城居",
      "content": [
        "盘碧栖寒结露居，虚封水户食芙蕖。",
        "锦云长日来无定，萝月通宵色有余。",
        "静拂琴书寻密契，时因斋戒具甘蔬。",
        "门穿藜径裁尘迹，车马无烦问广闾。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 249225,
      "title": "秋日郊居",
      "content": [
        "眼前百种并愁予，风日凄凄野外居。",
        "落雁沙边水清浅，蜕蝉枝上叶萧疏。",
        "一身病著残光景，尽室贫依古屋庐。",
        "物色情怀两岑寂，更无人问客何如。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 249226,
      "title": "避寇迁居郭内风雨凄然郑顾道饷酒",
      "content": [
        "烟雨昏昏一月梅，全家避贼寄城隈。",
        "欲寻碧落侍郎去，遽沐青州从事来。",
        "令我妻孥争洗盏，想公伯仲政传杯。",
        "安能鬰鬰久居此，且傍茶山松径回。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 249227,
      "title": "寓居吴兴",
      "content": [
        "相对真成泣楚囚，遂无末策到神州。",
        "但知遶树如飞鹊，不解营巢似拙鸠。",
        "江北江南犹断绝，秋风秋雨敢淹留。",
        "低回又作荆州梦，落日孤云始欲愁。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 249228,
      "title": "寓广教寺东轩",
      "content": [
        "谁将老境觅菟裘，聊与瞿昙共一丘。",
        "青士无多自萧散，紫君虽小亦风流。",
        "要须憩寂有茅宇，何以落成惟茗瓯。",
        "稳看林间上番笋，惜无余地可通幽。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 249229,
      "title": "宜兴邵智卿天远堂",
      "content": [
        "目极云沙静渺然，邵卿风月过年年。",
        "雁行灭没山横晚，渔艇空蒙水接天。",
        "南国棠阴春寂寂，东风瓜蔓日緜緜。",
        "问君许作邻翁否，阳羡溪边即买田。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 249230,
      "title": "发宜兴",
      "content": [
        "老境垂垂六十年，又将家上鐡头船。",
        "客留阳羡秖三月，归去玉溪无一钱。",
        "观水观山都废食，听风听雨不妨眠。",
        "从今布袜青鞵梦，不到张公即善权。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 249231,
      "title": "壬戌歳除作明朝六十歳矣",
      "content": [
        "禅榻萧然丈室空，薰销火冷闭门中。",
        "光阴又似烛见跋，学问只如船逆风。",
        "一歳临分惊老大，五更相守笑儿童。",
        "休言四十明朝过，看取霜髯六十翁。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 249232,
      "title": "谒灵康庙",
      "content": [
        "玉霄峰外海西头，即是衰翁所领州。",
        "云水茫茫长发兴，春山叠叠未生愁。",
        "旧时英物余千载，胜地丛祠尙一丘。",
        "苦雨凄风莫为崇，与君同乐亦同忧。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 249233,
      "title": "登玉霄亭",
      "content": [
        "老荷君恩付赤城，瘦笻扶上玉霄亭。",
        "悬知地接溟溟海，坐见天横两两星。",
        "作赋兴公虚想像，谪官司户实飘零。",
        "衰翁何幸分符竹，一览东吴未了青。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 249234,
      "title": "竹轩小睡",
      "content": [
        "好竹迷时手自栽，一轩寒碧谢尘埃。",
        "清风政为我辈设，小睡忽从何许来。",
        "已用官茶麾得去，莫因家酿挽令回。",
        "呼儿静扫黄叶径，吾与此君俱快哉。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 249235,
      "title": "竹轩睡起诗和者既多辄复次韵",
      "content": [
        "雨中好竹不难栽，雨后清无一点埃。",
        "政有贤人林下集，何尝俗客洞中来。",
        "稽山老干应相忆，茂苑新梢未遣回。",
        "归去南轩曲肱梦，葱葱鬰鬰气佳哉。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 249236,
      "title": "曾表勋画屏",
      "content": [
        "笔端水远又山长，潇洒吾宗白面郎。",
        "荠树烟中分琐细，叶舟沙外见微茫。",
        "不宜朝士听鸡枕，政惬幽人梦蝶床。",
        "却恐非关毫素事，此身元住玉溪旁。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 249237,
      "title": "程吉老抚干以英石见遗层叠可爱报之以此",
      "content": [
        "几净窗明丈室间，炷香危坐不开关。",
        "如何密密深深地，忽有层层叠叠山。",
        "珍重故人初入手，携持使我得怡颜。",
        "从今石友常相对，世上交游费往还。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 249238,
      "title": "雪后梅花盛开折置灯下",
      "content": [
        "满城桃李望东君，破腊江梅未上春。",
        "窗几数枝逾静好，园林一雪倍清新。",
        "已无妙语形容汝，不用幽香触拨人。",
        "迨此暇时当举酒，明朝风雨恐伤神。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 249239,
      "title": "瓶中梅",
      "content": [
        "小窗水冰青琉璃，梅花横斜三四枝。",
        "若非风日不到处，何得色香如许时。",
        "神情萧散林下气，玉雪清莹闺中姿。",
        "陶泓毛颖果安用，疏影写出无声诗。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 249240,
      "title": "返魂梅",
      "content": [
        "径菊庭兰日夜摧，禅房未合有江梅。",
        "香今政作依稀似，花乃能令顷刻开。",
        "笑说巫阳真浪下，寄声驿使未须来。",
        "为君浮动黄昏月，挽取林逋句法回。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 249241,
      "title": "诸人见和返魂梅再次韵",
      "content": [
        "蜡炬高花半欲摧，斑斑小雨学黄梅。",
        "有时燕寝香中坐，如梦前村雪里开。",
        "披拂故令携袖满，横斜便欲映窗来。",
        "重帘幽户深深闭，亦恐风飘不得回。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 249242,
      "title": "郑侍郎折赠白芍药",
      "content": [
        "奇葩天遣殿芳丛，一朵瑶台月下逢。",
        "黄遶腰间空自贵，红潮颊上莫争秾。",
        "如何风日许姸暖，更著衣裳能叠重。",
        "定是扬州玉楼子，略无佳句与形客。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 249243,
      "title": "曾宏甫分饷洞庭柑",
      "content": [
        "黄柑送似得尝新，坐我松江震泽濵。",
        "想见霜林三百颗，梦成罗帕一双珍。",
        "流泉喷雾真宜酒，带叶连枝绝可人。",
        "莫向君家樊素口，瓠犀微齼远山颦。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 249244,
      "title": "福帅张渊道送荔子",
      "content": [
        "岂无重碧实瓶罍，难得轻红荐一杯。",
        "千里人从闽岭出，三年公送荔枝来。",
        "玉为肌骨凉无汗，云作衣裳皱不开。",
        "莫讶关情向尤物，厌看绿李与杨梅。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 249245,
      "title": "荔子",
      "content": [
        "异方风物鬓成斑，荔子尝新得破颜。",
        "兰蕙香浮襟解后，雪冰肤在酒酣间。",
        "绝知高味倾瑶柱，未觉丰肌病玉环。",
        "似是看来终不近，寄声龙目尽追攀。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 249246,
      "title": "又咏荔子",
      "content": [
        "百年中半饱闻渠，名下亲承果不虚。",
        "可爱风流元有种，自然富贵乃其余。",
        "肯随妃子红尘驿，甘伴先生白鹤居。",
        "可惜不经山谷赏，照红鸭绿定何如。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 249247,
      "title": "吴傅朋送惠山泉两瓶竝所书石刻",
      "content": [
        "锡谷寒泉双玉瓶，故人捐惠意非轻。",
        "疾风骤雨汤声作，淡月疏星茗事成。",
        "新歳头纲须击拂，旧时水递费经营。",
        "银钩虿尾增奇丽，并得晴窗两眼明。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 249248,
      "title": "李相公饷建溪新茗奉寄",
      "content": [
        "一书说尽故人情，闽岭春风入户庭。",
        "碾处曾看眉上白，分时为见眼中青。",
        "饭羹正昼成空洞，枕簟通宵失杳冥。",
        "无奈笔端尘俗在，更呼活火发铜瓶。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 249249,
      "title": "郑顾道招赏瑞香",
      "content": [
        "山城底处不春风，未似畱宾郑驿中。",
        "家酿𥬠成玉池水，槛花移得锦薰笼。",
        "已将故事来招我，不著新诗去恼公。",
        "从此溪南溪北路，桃蹊一任雨繁红。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 249250,
      "title": "得瑞香于四明",
      "content": [
        "锦树团栾海角州，移春槛里见风流。",
        "两三翠盖张前面，千百香囊缀上头。",
        "绝代红梅相对好，妒人山麝莫来休。",
        "衰翁若被儿童问，入眼还曾有此不。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 249251,
      "title": "张耆年教授置酒官舍环碧散步上园煎桃花茶",
      "content": [
        "何许清尊对物华，广文官舍似僧家。",
        "向人只合供谈笑，领客犹能办咄嗟。",
        "光动杯盘环碧水，香随珠履上园花。",
        "公如不厌过从数，但煮东坡所种茶。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 249252,
      "title": "郡中禁私酿严甚戏作",
      "content": [
        "结交欢伯无他肠，小槽窃比顾建康。",
        "此身忽堕禁酒国，何路得到无功乡。",
        "官酤快甚夏酌水，斋酿惬于冬饮汤。",
        "客来且复置是事，北焙荐椀春风香。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 249253,
      "title": "荣茂实侍郎饷家酿",
      "content": [
        "风窗雪屋坐昏晨，一老江湖寂寞滨。",
        "解战充虚惟有酒，绝甘分少不无人。",
        "交情好在筼筜谷，腊味持来曲米春。",
        "便觉寒家生暖热，故知客里未全贫。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 249254,
      "title": "家酿红酒美甚戏作",
      "content": [
        "曲生奇丽乃如许，酒母秾华当若何。",
        "向人自作醉时面，遣我宁不苍颜酡。",
        "得非琥珀所成就，更有丹砂相荡磨。",
        "可怜老杜不对汝，但爱引颈舟前鹅。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 249255,
      "title": "食笋",
      "content": [
        "花事阑珊竹事初，一番风味殿春蔬。",
        "龙蛇戢戢风雷后，虎豹斑斑雾雨余。",
        "但使此君常有子，不忧每食叹无鱼。",
        "丁宁下番须留取，障日遮风却要渠。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 249256,
      "title": "戏作盆池四于和青堂",
      "content": [
        "陂湖春尽水茫茫，收拾波涛入小塘。",
        "睡起微凉馥荷气，雨余斜日丽萍光。",
        "聊为堂下龟鱼主，少退阶前雁鹜行。",
        "只欠盆行数峰在，并持小树作青苍。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 249257,
      "title": "秘省避暑抵暮乃出",
      "content": [
        "蜗庐何以度袢延，竟日蓬山一洗湔。",
        "阴翳树林无六月，风凉殿阁是诸天。",
        "政须深隐似玄豹，不用怀归如杜鹃。",
        "咄咄逼人牛马走，夜窗妨我枕书眠。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 249258,
      "title": "复热",
      "content": [
        "墨云行雨并成空，突兀彤云在眼中。",
        "瓜李不禁如许热，蒲葵能得几多风。",
        "通宵看月坐还卧，竟日追凉西复东。",
        "回首本无寒暑地，听渠亭午汗珠融。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 249259,
      "title": "儿辈次复热诗韵再次韵示之",
      "content": [
        "蓐收何在渺层空，三伏炎蒸尙未中。",
        "况复今宵无好月，不知底处有清风。",
        "看云暮暮不为雨，畏日朝朝还自东。",
        "忆昔给孤园里梦，褰裳觅路踏泥融。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 249260,
      "title": "八月十五夜月二首  其一",
      "content": [
        "玉露金波不可孤，相瞻今夕定何如。",
        "氛埃未净雨湔洗，阴翳小留风扫除。",
        "丹桂看来元了了，白榆种得许疏疏。",
        "一杯浊酒非难事，未有新诗报答渠。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 249261,
      "title": "八月十五夜月二首  其二",
      "content": [
        "云日晶荧固自佳，幽人有待至昏鸦。",
        "远分嵒际松枫树，复乱洲前芦荻花。",
        "曳履商声怜此老，倚楼长笛问谁家。",
        "霜螯玉柱姚江上，作意三年醉月华。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 249262,
      "title": "重阳",
      "content": [
        "老去长争一寸阴，良辰物色负幽襟。",
        "中秋素月偏离毕，九日黄花未散金。",
        "蓓蕾不妨供小摘，茱萸聊复伴孤斟。",
        "重阳何必今朝是，从此篱边日访寻。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 249263,
      "title": "十月一日",
      "content": [
        "屋角羲娥转两轮，今朝水帝又司辰。",
        "山家尝稻知良月，野径寻梅见小春。",
        "一歳坐看除得尽，百年正与死为邻。",
        "谁能思许无穷事，闭合开炉但饮醇。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 249264,
      "title": "长至日述怀兼寄十七兄",
      "content": [
        "老来愈觉白驹忙，眼看重阳又一阳。",
        "心似死灰飞不起，技如寒日短中长。",
        "厌看宾客空投谒，强对妻孥略举觞。",
        "回首山阴酬劝地，应怜鸿雁不成行。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 249265,
      "title": "雪作",
      "content": [
        "卧闻微霰却无声，起看阶前又不能。",
        "一夜纸窗明似月，多年布被冷于冰。",
        "履穿过我柴门客，笠重归来竹院僧。",
        "三白自佳晴亦好，诸山粉黛见层层。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 249266,
      "title": "雪晴",
      "content": [
        "衾裯一夜冷于冰，雪事心知作得成。",
        "自起穴窗看不见，却来攲枕听无声。",
        "下床走报童心喜，开户惊呼老眼明。",
        "晴日垂簷白银塔，怪奇亦复可怜生。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 249267,
      "title": "十二月六日大雪",
      "content": [
        "薄晚蓬山下直余，笑看六出点衣裾。",
        "絮飞帘外无萦绊，花落阶前不扫除。",
        "松鬛垂身全类我，竹头抢地最怜渠。",
        "短檠便可捐墙角，剩有窗光映读书。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 249268,
      "title": "歳尽",
      "content": [
        "漏箭更筹日夜催，万牛不挽白驹回。",
        "梅花雪片歳华尽，萱草柳条春鼎来。",
        "病里诗书元不读，贫中尊俎未尝开。",
        "年光似此真虚掷，请以丹心学死灰。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 249269,
      "title": "致仕",
      "content": [
        "妻孥挽我奉真祠，老子婆娑正坐谁。",
        "受禄功无一毫末，休官事有十年迟。",
        "尚容款曲悬车地，绝胜仓皇易箦时。",
        "请祝圣人千万寿，小臣何敢望期颐。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 249270,
      "title": "癸未八月十四日至十六夜月色皆佳",
      "content": [
        "年年歳歳望中秋，歳歳年年雾雨愁。",
        "凉月风光三夜好，老夫怀抱一生休。",
        "明时谅费银河洗，缺处应须玉斧修。",
        "京洛胡尘满人眼，不知能似浙江不。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 249271,
      "title": "自号在家衲子",
      "content": [
        "绝胜人间万户侯，不称俗士不缁流。",
        "又随拄杖去行脚，未办把茅来盖头。",
        "但使宗风嗣庞蕴，谁能佛事觉裴休。",
        "秖应除却闲名字，一听人呼作马牛。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 249272,
      "title": "题东臯",
      "content": [
        "市声俱不闻，野色良可喜。",
        "听公北宅住，还我东臯子。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 249273,
      "title": "西崦",
      "content": [
        "一重仍一掩，少有外人知。",
        "杖屦归来处，斜阳隐半规。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 249274,
      "title": "南埭",
      "content": [
        "薫风追晚凉，爱日引朝步。",
        "瘦策与青鞋，应知来往路。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 249275,
      "title": "北垞",
      "content": [
        "不谓蕞尔邦，有此岿然宅。",
        "江山自比邻，风月相主客。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 249276,
      "title": "松谿",
      "content": [
        "不似居城市，澄湖上有松。",
        "日斜人影散，百尺卧苍龙。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 249277,
      "title": "竹坞",
      "content": [
        "烟雨百余年，茅茨数间屋。",
        "中有在家僧，萧然如此竹。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 249278,
      "title": "梅坡",
      "content": [
        "被雪一枝好，令人双眼明。",
        "未须贪结子，对汝不胜清。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 249279,
      "title": "兰畹",
      "content": [
        "深林以芗名，花木不知数。",
        "一点无俗氛，兰芽在幽处。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 249280,
      "title": "丛桂",
      "content": [
        "行攀丛桂枝，坐息丛桂影。",
        "王孙胡不归，歳晏雪霜冷。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 249281,
      "title": "海棠洞",
      "content": [
        "玉颊酒潮红，醉头扶不举。",
        "杜老岂无诗，应为六丁取。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 249282,
      "title": "柔桑陌",
      "content": [
        "南陌绿成阴，园林正春老。",
        "能令蚕事办，更遣鸮音好。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 249283,
      "title": "梨花原",
      "content": [
        "酒渴上安市，甘寒为解围。",
        "鹅儿黄不见，空见鹭鸶飞。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 249284,
      "title": "柑子园",
      "content": [
        "小摘乱青黄，开尝馥香气。",
        "持比千户封，真成败人意。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 249285,
      "title": "山斋",
      "content": [
        "颇知藏曲折，故作小峥嵘。",
        "一穟香已过，半山云正横。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
