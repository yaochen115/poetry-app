{
  "data": [
    {
      "id": 342086,
      "title": "巴南舟中夜市",
      "content": [
        "渡口欲黄昏，归人争流喧。",
        "近钟清野寺，远火点江村。",
        "见雁思乡信，闻猿积泪痕。",
        "孤舟万里外，秋月不堪论。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 342087,
      "title": "江上春叹",
      "content": [
        "腊月江上暖，南桥新柳枝。",
        "春风触处到，忆得故园时。",
        "终日不如意，出门何所之。",
        "从人觅颜色，自笑弱男儿。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 342089,
      "title": "使院中新栽柏树子，呈李十五栖筠",
      "content": [
        "爱尔青青色，移根此地来。",
        "不曾台上种，留向碛中栽。",
        "脆叶欺门柳，狂花笑院梅。",
        "不须愁岁晚，霜露岂能摧。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 342091,
      "title": "临洮龙兴寺玄上人院，同咏青木香丛",
      "content": [
        "移根自远方，种得在僧房。",
        "六月花新吐，三春叶已长。",
        "抽茎高锡杖，引影到绳床。",
        "只为能除疾，倾心向药王。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 342092,
      "title": "成王挽歌",
      "content": [
        "幽山悲旧桂，长阪怆余兰。",
        "地底孤灯冷，泉中一镜寒。",
        "铭旌门客送，骑吹路人看。",
        "漫作琉璃碗，淮王误合丹。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 342093,
      "title": "苗侍中挽歌二首",
      "content": [
        "摄政朝章重，持衡国相尊。",
        "笔端通造化，掌内运乾坤。",
        "青史遗芳满，黄枢故事存。",
        "空悲渭桥路，谁对汉皇言。",
        "天子悲元老，都人惜上公。",
        "优贤几杖在，会葬市朝空。",
        "丹旐飞斜日，清笳怨暮风。",
        "平生门下客，继美庙堂中。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 342094,
      "title": "故仆射裴公挽歌三首",
      "content": [
        "盛德资邦杰，嘉谟作世程。",
        "门瞻驷马贵，时仰八龙名。",
        "罢市秦人送，还乡绛老迎。",
        "莫埋丞相印，留著付玄成。",
        "五府瞻高位，三台丧大贤。",
        "礼容还故绛，宠赠冠新田。",
        "气歇汾阴鼎，魂飞京兆阡。",
        "先时剑已没，陇树久苍然。",
        "富贵徒言久，乡闾殁后归。",
        "锦衣都未著，丹旐忽先飞。",
        "哀挽辞秦塞，悲笳出帝畿。",
        "遥知九原上，渐觉吊人稀。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 342095,
      "title": "河西太守杜公挽歌四首",
      "content": [
        "蒙叟悲藏壑，殷宗惜济川。",
        "长安非旧日，京兆是新阡。",
        "黄霸官犹屈，苍生望已愆。",
        "唯余卿月在，留向杜陵悬。",
        "鼓角城中出，坟茔郭外新。",
        "雨随思太守，云从送夫人。",
        "蒿里埋双剑，松门闭万春。",
        "回瞻北堂上，金印已生尘。",
        "忆昨明光殿，新承天子恩。",
        "剖符移北地，授钺领西门。",
        "塞草迎军幕，边云拂使轩。",
        "至今闻陇外，戎虏尚亡魂。",
        "漫漫澄波阔，沉沉大厦深。",
        "秉心常匪席，行义每挥金。",
        "汲引窥兰室，招携入翰林。",
        "多君有令子，犹注世人心。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 342096,
      "title": "故河南尹岐国公赠工部尚书苏公挽歌二首",
      "content": [
        "河尹恩荣旧，尚书宠赠新。",
        "一门传画戟，几世驾朱轮。",
        "夜色何时晓，泉台不复春。",
        "唯余朝服在，金印已生尘。",
        "白日扃泉户，青春掩夜台。",
        "旧堂阶草长，空院砌花开。",
        "山晚铭旌去，郊寒骑吹回。",
        "三川难可见，应惜庾公才。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 342097,
      "title": "韩员外夫人清河县君崔氏挽歌二首",
      "content": [
        "令德当时重，高门举世推。",
        "从夫荣已绝，封邑宠难追。",
        "陌上人皆惜，花间鸟亦悲。",
        "仙郎看陇月，犹忆画眉时。",
        "遽闻伤别剑，忽复叹藏舟。",
        "灯冷泉中夜，衣寒地下秋。",
        "青松吊客泪，丹旐路人愁。",
        "徒有清河在，空悲逝水流。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 342099,
      "title": "南溪别业",
      "content": [
        "结宇依青嶂，开轩对翠畴。",
        "树交花两色，溪合水重流。",
        "竹径春来扫，兰樽夜不收。",
        "逍遥自得意，鼓腹醉中游。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 342100,
      "title": "奉和中书舍人贾至早朝大明宫",
      "content": [
        "鸡鸣紫陌曙光寒，莺啭皇州春色阑。",
        "金阙晓钟开万户，",
        "独有凤凰池上客，阳春一曲和皆难。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 342101,
      "title": "和祠部王员外雪后早朝即事",
      "content": [
        "长安雪后似春归，积素凝华连曙晖。",
        "色借玉珂迷晓骑，",
        "闻道仙郎歌白雪，由来此曲和人稀。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 342102,
      "title": "奉和相公发益昌",
      "content": [
        "相国临戎别帝京，拥麾持节远横行。",
        "朝登剑阁云随马，",
        "暂到蜀城应计日，须知明主待持衡。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 342103,
      "title": "秋夕读书幽兴，献兵部李侍郎",
      "content": [
        "年纪蹉跎四十强，自怜头白始为郎。",
        "雨滋苔藓侵阶绿，",
        "览卷试穿邻舍壁，明灯何惜借余光。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 342104,
      "title": "使君席夜送严河南赴长水",
      "content": [
        "娇歌急管杂青丝，银烛金杯映翠眉。",
        "使君地主能相送，",
        "寄声报尔山翁道，今日河南胜昔时。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 342105,
      "title": "暮春虢州东亭送李司马归扶风别庐",
      "content": [
        "柳亸莺娇花复殷，红亭绿酒送君还。",
        "到来函谷愁中月，",
        "西望乡关肠欲断，对君衫袖泪痕斑。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 342106,
      "title": "九日使君席奉饯卫中丞赴长水",
      "content": [
        "节使横行西出师，鸣弓擐甲羽林儿。",
        "台上霜风凌草木，",
        "为报使君多泛菊，更将弦管醉东篱。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 342107,
      "title": "西掖省即事",
      "content": [
        "西掖重云开曙晖，北山疏雨点朝衣。",
        "千门柳色连青琐，",
        "官拙自悲头白尽，不如岩下偃荆扉。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 342108,
      "title": "首春渭西郊行，呈蓝田张二主簿",
      "content": [
        "回风度雨渭城西，细草新花踏作泥。",
        "秦女峰头雪未尽，",
        "闻道辋川多胜事，玉壶春酒正堪携。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 342109,
      "title": "赴嘉州过城固县，寻永安超禅师房",
      "content": [
        "满寺枇杷冬著花，老僧相见具袈裟。",
        "汉王城北雪初霁，",
        "岂料巴川多胜事，为君书此报京华。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 342110,
      "title": "酬畅当嵩山寻麻道士见寄",
      "content": [
        "闻逐樵夫闲看棋，忽逢人世是秦时。",
        "开云种玉嫌山浅，",
        "烦君远示青囊录，愿得相从一问师。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 342111,
      "title": "和刑部成员外秋夜寓直寄台省知己",
      "content": [
        "列宿光三署，仙郎直五宵。",
        "时衣天子赐，厨膳大官调。",
        "长乐钟应近，明光漏不遥。",
        "黄门持被覆，侍女捧香烧。",
        "笔为题诗点，灯缘起草挑。",
        "竹喧交砌叶，柳亸拂窗条。",
        "粉署荣新命，霜台忆旧僚。",
        "名香播兰蕙，重价蕴琼瑶。",
        "击水翻沧海，抟风透赤霄。",
        "微才喜同舍，何幸忽闻韶。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 342112,
      "title": "送卢郎中除杭州赴任",
      "content": [
        "罢起郎官草，初分刺史符。",
        "海云迎过楚，江月引归吴。",
        "城底涛声震，楼端蜃气孤。",
        "千家窥驿舫，五马饮春湖。",
        "柳色供诗用，莺声送酒须。",
        "知君望乡处，枉道上姑苏。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 342114,
      "title": "送严维下第还江东",
      "content": [
        "勿叹今不第，似君殊未迟。",
        "且归沧洲去，相送青门时。",
        "望鸟指乡远，问人愁路疑。",
        "敝裘沾暮雪，归棹带流澌。",
        "严子滩复在，谢公文可追。",
        "江皋如有信，莫不寄新诗。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 342116,
      "title": "饯王岑判官赴襄阳道",
      "content": [
        "故人汉阳使，走马向南荆。",
        "不厌楚山路，只怜襄水清。",
        "津头习氏宅，江上夫人城。",
        "夜入橘花宿，朝穿桐叶行。",
        "害群应自慑，持法固须平。",
        "暂得青门醉，斜光速去程。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 342120,
      "title": "送史司马赴崔相公幕",
      "content": [
        "峥嵘丞相府，清切凤凰池。",
        "羡尔瑶台鹤，高栖琼树枝。",
        "归飞晴日好，吟弄惠风吹。",
        "正有乘轩乐，初当学舞时。",
        "珍禽在罗网，微命若游丝。",
        "愿托周南羽，相衔溪水湄。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 342121,
      "title": "送严黄门拜御史大夫再镇蜀川兼觐省",
      "content": [
        "授钺辞金殿，承恩恋玉墀。",
        "登坛汉主用，讲德蜀人思。",
        "副相韩安国，黄门向子期。",
        "刀州重入梦，剑阁再题词。",
        "春草连青绶，晴花间赤旗。",
        "山莺朝送酒，江月夜供诗。",
        "许国分忧日，荣亲色养时。",
        "苍生望已久，来去不应迟。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 342122,
      "title": "送郭仆射节制剑南",
      "content": [
        "铁马擐红缨，幡旗出禁城。",
        "明王亲授钺，丞相欲专征。",
        "玉馔天厨送，金杯御酒倾。",
        "剑门乘崄过，阁道踏空行。",
        "山鸟惊吹笛，江猿看洗兵。",
        "晓云随去阵，夜月逐行营。",
        "南仲今时往，西戎计日平。",
        "将心感知己，万里寄悬旌。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 342123,
      "title": "早秋与诸子登虢州西亭观眺",
      "content": [
        "亭高出鸟外，客到与云齐。",
        "树点千家小，天围万岭低。",
        "残虹挂陕北，急雨过关西。",
        "酒榼缘青壁，瓜田傍绿溪。",
        "微官何足道，爱客且相携。",
        "唯有乡园处，依依望不迷。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 342125,
      "title": "灭胡曲",
      "content": [
        "都护新灭胡，士马气亦粗。",
        "萧条虏尘净，突兀天山孤。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 342126,
      "title": "尚书念旧，垂赐袍衣，率题绝句献上，以申感谢",
      "content": [
        "富贵情还在，相逢岂间然。",
        "绨袍更有赠，犹荷故人怜。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 342127,
      "title": "忆长安曲二章寄庞cc",
      "content": [
        "东望望长安，正值日初出。",
        "长安不可见，喜见长安日。",
        "长安何处在，只在马蹄下。",
        "明日归长安，为君急走马。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 342130,
      "title": "题井陉双溪李道士所居",
      "content": [
        "五粒松花酒，双溪道士家。",
        "唯求缩却地，乡路莫教赊。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 342131,
      "title": "题云际南峰眼上人读经堂",
      "content": [
        "结宇题三藏，焚香老一峰。",
        "云间独坐卧，只是对山松。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 342133,
      "title": "题三会寺苍颉造字台",
      "content": [
        "野寺荒台晚，寒天古木悲。",
        "空阶有鸟迹，犹似造书时。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 342135,
      "title": "西过渭州，见渭水思秦川",
      "content": [
        "渭水东流去，何时到雍州。",
        "凭添两行泪，寄向故园流。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 342143,
      "title": "献封大夫破播仙凯歌六首",
      "content": [
        "汉将承恩西破戎，捷书先奏未央宫。",
        "天子预开麟阁待，只今谁数贰师功。",
        "官军西出过楼兰，营幕傍临月窟寒。",
        "蒲海晓霜凝马尾，葱山夜雪扑旌竿。",
        "鸣笳叠鼓拥回军，破国平蕃昔未闻。",
        "丈夫鹊印摇边月，大将龙旗掣海云。",
        "日落辕门鼓角鸣，千群面缚出蕃城。",
        "洗兵鱼海云迎阵，秣马龙堆月照营。",
        "蕃军遥见汉家营，满谷连山遍哭声。",
        "万箭千刀一夜杀，平明流血浸空城。",
        "暮雨旌旗湿未干，胡烟白草日光寒。",
        "昨夜将军连晓战，蕃军只见马空鞍。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 342151,
      "title": "原头送范侍御",
      "content": [
        "百尺原头酒色殷，路傍骢马汗斑斑。",
        "别君只有相思梦，遮莫千山与万山。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 342152,
      "title": "送李明府赴睦州，便拜觐太夫人",
      "content": [
        "手把铜章望海云，夫人江上泣罗裙。",
        "严滩一点舟中月，万里烟波也梦君。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 342154,
      "title": "奉送贾侍御使江外",
      "content": [
        "新骑骢马复承恩，使出金陵过海门。",
        "荆南渭北难相见，莫惜衫襟著酒痕。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 342157,
      "title": "酒泉太守席上醉后作",
      "content": [
        "酒泉太守能剑舞，高堂置酒夜击鼓。",
        "胡笳一曲断人肠，座上相看泪如雨。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 342159,
      "title": "草堂村寻罗生不遇",
      "content": [
        "数株溪柳色依依，深巷斜阳暮鸟飞。",
        "门前雪满无人迹，应是先生出未归。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 342160,
      "title": "山房春事二首",
      "content": [
        "风恬日暖荡春光，戏蝶游蜂乱入房。",
        "数枝门柳低衣桁，一片山花落笔床。",
        "梁园日暮乱飞鸦，极目萧条三两家。",
        "庭树不知人死尽，春来还发旧时花。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 342164,
      "title": "赴北庭度陇思家",
      "content": [
        "西向轮台万里余，也知乡信日应疏。",
        "陇山鹦鹉能言语，为报家人数寄书。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 342167,
      "title": "醉戏窦子美人",
      "content": [
        "朱唇一点桃花殷，宿妆娇羞偏髻鬟。",
        "细看只似阳台女，醉著莫许归巫山。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 376749,
      "title": "白雪歌送武判官归京",
      "content": [
        "北风卷地白草折，胡天八月即飞雪。",
        "忽如一夜春风来，千树万树梨花开。",
        "散入珠帘湿罗幕，狐裘不暖锦衾薄。",
        "将军角弓不得控，都护铁衣冷难著。",
        "瀚海阑干百丈冰，愁云惨淡万里凝。",
        "中军置酒饮归客，胡琴琵琶与羌笛。",
        "纷纷暮雪下辕门，风掣红旗冻不翻。",
        "轮台东门送君去，去时雪满天山路。",
        "山回路转不见君，雪上空留马行处。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 376750,
      "title": "苜蓿峰寄家人",
      "content": [
        "苜蓿峰边逢立春，葫芦河上泪沾巾。",
        "闺中只是空相忆，不见沙场愁杀人。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 376751,
      "title": "碛中作",
      "content": [
        "走马西来欲到天，辞家见月两回圆。",
        "今夜未知何处宿，平沙万里绝人烟。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 376752,
      "title": "山房春事",
      "content": [
        "梁园日暮乱飞鸦，极目箫条三两家。",
        "庭树不知人去尽，春来还发旧时花。"
      ],
      "author": {
        "id": 7545,
        "name": "岑参"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
