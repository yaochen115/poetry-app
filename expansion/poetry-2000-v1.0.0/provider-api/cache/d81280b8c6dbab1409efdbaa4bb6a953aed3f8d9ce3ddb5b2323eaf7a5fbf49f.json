{
  "data": [
    {
      "id": 99930,
      "title": "中春中澣后一日老人挈累下西市寓舍越三日某行感而赋诗呈友人  其二",
      "content": [
        "吐气韶华里，关心晓哢边。",
        "鹧鸪天性在，杜宇世情然。",
        "怒笋和泥煮，殷花蘸乳煎。",
        "须君来共此，已办杖头钱。"
      ],
      "author": {
        "id": 8088,
        "name": "洪咨夔"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 301663,
      "title": "句",
      "content": [
        "春游鸡鹿塞，家在鹧鸪天。",
        "（《艺需要伐山》十八）。"
      ],
      "author": {
        "id": 12505,
        "name": "郑嵎"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 312233,
      "title": "鹧鸪天",
      "content": [
        "镇日无心扫黛眉。",
        "临行愁见理征衣。",
        "尊前只恐伤郎意，阁泪汪汪不敢垂。",
        "停宝马，捧瑶卮。",
        "相斟相劝忍分离。",
        "不如饮待奴先醉，图得不知郎去时。"
      ],
      "author": {
        "id": 1299,
        "name": "夏竦"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312444,
      "title": "鹧鸪天",
      "content": [
        "吹破残烟入夜风。",
        "一轩明月上帘栊。",
        "因惊路远人还远，纵得心同寝未同。",
        "情脉脉，意忡忡。",
        "碧云归去认无踪。",
        "只应曾向前生里，爱把鸳鸯两处笼。"
      ],
      "author": {
        "id": 3061,
        "name": "柳永"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312783,
      "title": "鹧鸪天",
      "content": [
        "画毂雕鞍狭路逢。",
        "一声肠断绣帘中。",
        "身无彩凤双飞翼，心有灵犀一点通。",
        "金作屋，玉为笼。",
        "车如流水马游龙。",
        "刘郎已恨蓬山远，更隔蓬山几万重。"
      ],
      "author": {
        "id": 6857,
        "name": "宋祁"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312964,
      "title": "鹧鸪天",
      "content": [
        "学画宫眉细细长。",
        "芙蓉出水斗新妆。",
        "只知一笑能倾国，不信相看有断肠。",
        "双黄鹄，两鸳鸯。",
        "迢迢云水恨难忘。",
        "早知今日长相忆，不及从初莫作双。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313269,
      "title": "鹧鸪天",
      "content": [
        "腊后春前暖律催。",
        "日和风软欲开梅。",
        "公方结客寻佳景，我亦忘形趁酒杯。",
        "添歌管，续尊罍。",
        "更阑烛短未能回。",
        "清欢莫待相期约，乘兴来时便可来。"
      ],
      "author": {
        "id": 7674,
        "name": "范纯仁"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313331,
      "title": "鹧鸪天",
      "content": [
        "彩袖殷勤捧玉锺。",
        "当年拼却醉颜红。",
        "舞低杨柳楼心月，歌尽桃花扇影风。",
        "从别后，忆相逢。",
        "几回魂梦与君同。",
        "今宵剩把银釭照，犹恐相逢是梦中。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313332,
      "title": "鹧鸪天",
      "content": [
        "一醉醒来春又残。",
        "野棠梨雨泪阑干。",
        "玉笙声里鸾空怨。",
        "罗幕香中燕未还。",
        "终易散，且长闲。",
        "莫教离恨损朱颜。",
        "谁堪共展鸳鸯锦，同过西楼此夜寒。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313333,
      "title": "鹧鸪天",
      "content": [
        "梅蕊新妆桂叶眉。",
        "小莲风韵出瑶池。",
        "云随绿水歌声转，雪绕红绡舞袖垂。",
        "伤别易，恨欢迟。",
        "惜无红锦为裁诗。",
        "行人莫便消魂去，汉渚星桥尚有期。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313334,
      "title": "鹧鸪天",
      "content": [
        "守得莲开结伴游。",
        "约开萍叶上兰舟。",
        "来时浦口云随棹，采罢江边月满楼。",
        "花不语，水空流。",
        "年年拼得为花愁。",
        "明朝万一西风动，争向朱颜不耐秋。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313335,
      "title": "鹧鸪天",
      "content": [
        "斗鸭池南夜不归。",
        "酒阑纨扇有新诗。",
        "云随碧玉歌声转，雪绕红琼舞袖回。",
        "今感旧，欲沾衣。",
        "可怜人似水东西。",
        "回头满眼凄凉事，秋月春风岂得知。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313336,
      "title": "鹧鸪天",
      "content": [
        "当日佳期鹊误传。",
        "至今犹作断肠仙。",
        "桥成汉渚星波外，人在鸾歌凤舞前。",
        "欢尽夜，别经年。",
        "别多欢少奈何天。",
        "情知此会无长计。",
        "咫尺凉蟾亦未圆。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313337,
      "title": "鹧鸪天",
      "content": [
        "题破香笺小砑红。",
        "诗篇多寄旧相逢。",
        "西楼酒面垂垂雪，南苑春衫细细风。",
        "花不尽，柳无穷。",
        "别来欢事少人同。",
        "凭谁问取归云信，今在巫山第几峰。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313338,
      "title": "鹧鸪天",
      "content": [
        "清颍尊前酒满衣。",
        "十年风月旧相知。",
        "凭谁细话当时事，肠断山长水远诗。",
        "金凤阙，玉龙墀。",
        "看君来换锦袍时。",
        "姮娥已有殷勤约，留著蟾宫第一枝。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313339,
      "title": "鹧鸪天",
      "content": [
        "醉拍春衫惜旧香。",
        "天将离恨恼疏狂。",
        "年年陌上生秋草，日日楼中到夕阳。",
        "云渺渺，水茫茫。",
        "征人归路许多长。",
        "相思本是无凭语，莫向花笺费泪行。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313340,
      "title": "鹧鸪天",
      "content": [
        "小令尊前见玉箫。",
        "银灯一曲太妖娆。",
        "歌中醉倒谁能恨，唱罢归来酒未消。",
        "春悄悄，夜迢迢。",
        "碧云天共楚宫遥。",
        "梦魂惯得无拘检，又踏杨花过谢桥。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313341,
      "title": "鹧鸪天",
      "content": [
        "楚女腰肢越女腮。",
        "粉圆双蕊髻中开。",
        "朱弦曲怨愁春尽，渌酒杯寒记夜来。",
        "新掷果，旧分钗。",
        "冶游音信隔章台。",
        "花间锦字空频寄，月底金鞍竟未回。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313342,
      "title": "鹧鸪天",
      "content": [
        "十里楼台倚翠微。",
        "百花深处杜娟啼。",
        "殷勤自与行人语，不似流莺取次飞。",
        "惊梦觉，弄晴时。",
        "声声只道不如归。",
        "天涯岂是无归意，争奈归期未可期。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313343,
      "title": "鹧鸪天",
      "content": [
        "陌上蒙蒙残絮飞。",
        "杜娟花里杜娟啼。",
        "年年底事不归去，怨月愁烟长为谁。",
        "梅雨细，晓风微。",
        "倚楼人听欲沾衣。",
        "故园三度群花谢，曼倩天涯犹未归。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313344,
      "title": "鹧鸪天",
      "content": [
        "晓日迎长岁岁同。",
        "太平箫鼓间歌钟。",
        "云高未有前村雪，梅小初开昨夜风。",
        "罗幕翠，锦筵红。",
        "钗头罗胜写宜冬。",
        "从今屈指春期近，莫使金尊对月空。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313345,
      "title": "鹧鸪天",
      "content": [
        "小玉楼中月上时。",
        "夜来惟许月华知。",
        "重帘有意藏私语，双烛无端恼暗期。",
        "伤别易，恨欢迟。",
        "归来何处验相思。",
        "沈郎春雪愁消臂，谢女香膏懒画眉。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313346,
      "title": "鹧鸪天",
      "content": [
        "手拈香笺忆小莲。",
        "欲将遗恨倩谁传。",
        "归来独卧逍遥夜，梦里相逢酩酊天。",
        "花易落，月难圆。",
        "只应花月似欢缘。",
        "秦筝算有心情在，试写离声入旧弦。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313347,
      "title": "鹧鸪天",
      "content": [
        "九日悲秋不到心。",
        "凤城歌管有新音。",
        "风凋碧柳愁眉淡，露染黄花笑靥深。",
        "初见雁，已闻砧。",
        "绮罗丛里胜登临。",
        "须教月户纤纤玉，细捧霞觞滟滟金。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313348,
      "title": "鹧鸪天",
      "content": [
        "碧藕花开水殿凉。",
        "万年枝外转红阳。",
        "升平歌管随天仗，祥瑞封章满御床。",
        "金掌露，玉炉香。",
        "岁华方共圣恩长。",
        "皇州又奏圜扉静，十样宫眉捧寿觞。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313349,
      "title": "鹧鸪天",
      "content": [
        "绿橘梢头几点春。",
        "似留香蕊送行人。",
        "明朝紫凤朝天路，十二重城五碧云。",
        "歌渐咽，酒初醺。",
        "尽将红泪湿湘裙。",
        "赣江西畔从今日，明月清风忆使君。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313623,
      "title": "鹧鸪天",
      "content": [
        "才子阴风度远关。",
        "清愁曾向画图看。",
        "山衔斗柄三星没，雪共月明千里寒。",
        "新路陌，旧江干。",
        "崎岖谁叹客程难。",
        "临风更听昭华笛，簌簌梅花满地残。"
      ],
      "author": {
        "id": 1324,
        "name": "王诜"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313700,
      "title": "鹧鸪天",
      "content": [
        "林断山明竹隐墙。",
        "乱蝉衰草小池塘。",
        "翻空白鸟时时见，照水红蕖细细香。",
        "村舍外，古城旁。",
        "杖藜徐步转斜阳。",
        "殷勤昨夜三更雨，又得浮生一日凉。"
      ],
      "author": {
        "id": 11678,
        "name": "苏轼"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313701,
      "title": "鹧鸪天",
      "content": [
        "笑拈红梅亸翠翘。",
        "扬州十里最妖饶。",
        "夜来绮席亲曾见，撮得精神滴滴娇。",
        "娇后眼，舞时腰。",
        "刘郎几度欲魂消。",
        "明朝酒醒知何处，肠断云间《紫玉箫》。"
      ],
      "author": {
        "id": 11678,
        "name": "苏轼"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314003,
      "title": "鹧鸪天",
      "content": [
        "罗带双垂画不成。",
        "𣨼人娇态最轻盈。",
        "酥胸斜抱天边月，玉手轻弹水面冰。",
        "无限事，许多情。",
        "四弦丝竹苦丁宁。",
        "饶君拨尽相思调，待听梧桐叶落声。"
      ],
      "author": {
        "id": 11678,
        "name": "苏轼"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314053,
      "title": "鹧鸪天",
      "content": [
        "节是重阳却斗寒。",
        "可堪风雨累寻欢。",
        "虽辜早菊同高柳，聊楫残蕉共小栏。",
        "浮蚁嫩，炷烟盘。",
        "恨无莺唱舞催鸾。",
        "空惊绝韵天边落，不许韶颜梦里看。"
      ],
      "author": {
        "id": 8599,
        "name": "李之仪"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314054,
      "title": "鹧鸪天",
      "content": [
        "浓丽妖妍不是妆。",
        "十分风艳夺韶光。",
        "牡丹开就应难比，繁富犹疑过海棠。",
        "须仔细，更端相。",
        "烂霞梳晕带朝阳。",
        "千金未足酬真赏，一度相看一断肠。"
      ],
      "author": {
        "id": 8599,
        "name": "李之仪"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314055,
      "title": "鹧鸪天",
      "content": [
        "避暑佳人不著妆。",
        "水晶冠子薄罗裳。",
        "摩绵扑粉飞琼屑，滤蜜调冰结绛霜。",
        "随定我，小兰堂。",
        "金盆盛水绕牙床。",
        "时时浸手心头熨，受尽无人知处凉。"
      ],
      "author": {
        "id": 8599,
        "name": "李之仪"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314056,
      "title": "鹧鸪天",
      "content": [
        "收尽微风不见江。",
        "分明天水共澄光。",
        "由来好处输闲地，堪叹人生有底忙。",
        "心既远，味偏长。",
        "须知粗布胜无裳。",
        "从今认得归田乐，何必桃源是故乡。"
      ],
      "author": {
        "id": 8599,
        "name": "李之仪"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314238,
      "title": "鹧鸪天",
      "content": [
        "休舞银貂小契丹。",
        "满堂宾客尽关山。",
        "从今袅袅盈盈处，谁复端端正正看。",
        "模泪易，写愁难。",
        "潇湘江上竹枝斑。",
        "碧云日暮无书寄，寥落烟中一雁寒。"
      ],
      "author": {
        "id": 9909,
        "name": "范成大"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314239,
      "title": "鹧鸪天",
      "content": [
        "荡漾西湖采绿苹。",
        "扬鞭南埭衮红尘。",
        "桃花暖日茸茸笑，杨柳光风浅浅颦。",
        "章贡水，郁孤云。",
        "多情争似桂江春。",
        "崔徽卷轴瑶姬梦，纵有相逢不是真。"
      ],
      "author": {
        "id": 9909,
        "name": "范成大"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314240,
      "title": "鹧鸪天",
      "content": [
        "嫩绿重重看得成。",
        "曲栏幽槛小红英。",
        "酴醿架上蜂儿闹，杨柳行间燕子轻。",
        "春婉娩，客飘零。",
        "残花浅酒片时清。",
        "一杯且买明朝事，送了斜阳月又生。"
      ],
      "author": {
        "id": 9909,
        "name": "范成大"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314241,
      "title": "鹧鸪天",
      "content": [
        "压蕊拈须粉作团。",
        "疏香辛苦颤朝寒。",
        "须知风月寻常见，不似层层带雪看。",
        "春髻重，晓眉弯。",
        "一枝斜并缕金旛。",
        "酒红不解东风冻，惊怪钗头玉燕干。"
      ],
      "author": {
        "id": 9909,
        "name": "范成大"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314423,
      "title": "鹧鸪天",
      "content": [
        "十月南闽未有霜。",
        "蕉林蔗圃郁相望。",
        "压枝橄榄浑如画，透甲香橙半弄黄。",
        "斟绿醑，泛沧浪。",
        "白沙翠竹近温汤。",
        "分明水墨山阴道，只欠冰溪雪月光。"
      ],
      "author": {
        "id": 793,
        "name": "李洪"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314434,
      "title": "鹧鸪天",
      "content": [
        "淑德由来孟母名。",
        "方瞳鹤发莹精神。",
        "天教遐算灵椿比，亲见贤郎擢桂荣。",
        "逢诞日，庆孙曾。",
        "金花纶诰又重新。",
        "愿君学得司空母，管取年高寿太平。"
      ],
      "author": {
        "id": 8294,
        "name": "李漳"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314451,
      "title": "鹧鸪天",
      "content": [
        "暮雨朝云不自怜。",
        "放教春涨绿浮天。",
        "祗令画阁临无地，宿昔新诗满系船。",
        "青鸟外，白鸥前。",
        "几生香火旧因缘。",
        "酒阑山月移雕槛，歌罢江风拂玳筵。"
      ],
      "author": {
        "id": 13029,
        "name": "朱熹"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314452,
      "title": "鹧鸪天",
      "content": [
        "已分江湖寄此生。",
        "长蓑短笠任阴晴。",
        "鸣桡细雨沧洲远，系舸斜阳画阁明。",
        "奇绝处，未忘情。",
        "几时还得去寻盟。",
        "江妃定许捐双佩，渔父何劳笑独醒。"
      ],
      "author": {
        "id": 13029,
        "name": "朱熹"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314453,
      "title": "鹧鸪天",
      "content": [
        "脱却儒冠著羽衣。",
        "青山绿水浩然归。",
        "看成鼎内真龙虎，管甚人间闲与非。",
        "生羽翼，上烟霏。",
        "回头祗见冢累累。",
        "未寻跨凤吹箫侣，且伴孤云独鹤飞。"
      ],
      "author": {
        "id": 13029,
        "name": "朱熹"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314630,
      "title": "鹧鸪天",
      "content": [
        "烟雨溟溟趁落成。",
        "只应天欲称佳名。",
        "万丝明灭青山映，匹素浓纤渌水萦。",
        "民亦乐，美能并。",
        "酒杯莫惜十分倾。",
        "要知社下平生志，觞政聊须为主盟。"
      ],
      "author": {
        "id": 6695,
        "name": "李处全"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314631,
      "title": "鹧鸪天",
      "content": [
        "缥缈危楼百尺雄。",
        "淡烟疏雨暗帘栊。",
        "偶妨清赏中秋夕，为忆名言玉局翁。",
        "贤达意，古今同。",
        "凉天佳月会相逢。",
        "老蟾一跃三千丈，却唤姮娥驾阆风。"
      ],
      "author": {
        "id": 6695,
        "name": "李处全"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314701,
      "title": "鹧鸪天",
      "content": [
        "怀抱环奇懒叩阍。",
        "朝阳独赋远人村。",
        "即看飞下芝封诏，会见趣归金马门。",
        "今夕饮，拼濡裙。",
        "一时尊俎尽诗人。",
        "唯馀阿买真才劣，醉后犹能写八分。"
      ],
      "author": {
        "id": 1129,
        "name": "丘崈"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314702,
      "title": "鹧鸪天",
      "content": [
        "陆海蓬壶自有山。",
        "光风霁月未应悭。",
        "但将歌舞酬佳节，却信阴晴是等闲。",
        "花照夜，烛烘盘。",
        "明年公更酒肠宽。",
        "奉陪黄伞传柑宴，莫望红妆拥座欢。"
      ],
      "author": {
        "id": 1129,
        "name": "丘崈"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314703,
      "title": "鹧鸪天",
      "content": [
        "准拟关门度一秋。",
        "强扶衰病起相酬。",
        "不辞酩酊还吹帽，自笑鬅鬙怯露头。",
        "江日晚，更迟留。",
        "争传五马足风流。",
        "论车载酒浑闲事，著笼藏花说未休。"
      ],
      "author": {
        "id": 1129,
        "name": "丘崈"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314704,
      "title": "鹧鸪天",
      "content": [
        "两两维舟近柳堤。",
        "菱歌迤逦过前溪。",
        "曲中自诉衷肠事，岸上行人那得知。",
        "金齿屐，翠云篦。",
        "女萝为带蕙为衣。",
        "惜花贪折归时晚，急桨相呼入翠微。"
      ],
      "author": {
        "id": 1129,
        "name": "丘崈"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314705,
      "title": "鹧鸪天",
      "content": [
        "玳瑁宴中见绿珠。",
        "淡然高韵胜施朱。",
        "揉兰雾縠蔷薇浅，半露冰肌玉不如。",
        "餐秀色，味肤腴。",
        "轻红端合与为奴。",
        "只愁宴罢翻成恨，赢得偏怜不似初。"
      ],
      "author": {
        "id": 1129,
        "name": "丘崈"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314815,
      "title": "鹧鸪天",
      "content": [
        "竹树萧萧屋数椽。",
        "平湖漫漫纳通川。",
        "有时竹杖芒鞋至，醉著山光水色间。",
        "成小隐，未经年。",
        "功名夷路稳加鞭。",
        "逢时且数中书考，他日还寻独乐园。"
      ],
      "author": {
        "id": 11270,
        "name": "吕胜己"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314816,
      "title": "鹧鸪天",
      "content": [
        "记得追游故老家。",
        "红莲幕府在长沙。",
        "放船桥口秋随月，走马春园夜踏花。",
        "思往昔，谩咨磋。",
        "几番魂梦转天涯。",
        "葵轩老子今何在，岳麓风雩噪暮鸦。"
      ],
      "author": {
        "id": 11270,
        "name": "吕胜己"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314817,
      "title": "鹧鸪天",
      "content": [
        "一夜春寒透锦帏。",
        "满庭花露起多时。",
        "垒金梳子双双耍，铺翠花儿袅袅垂。",
        "人去后，信来稀。",
        "等闲屈指数归期。",
        "门前恰限行人至，喜鹊如何圣得知。"
      ],
      "author": {
        "id": 11270,
        "name": "吕胜己"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314818,
      "title": "鹧鸪天",
      "content": [
        "日日楼心与画眉。",
        "松分蝉翅黛云低。",
        "象牙白齿双梳子，驼骨红纹小棹篦。",
        "朝暮宴，浅深杯。",
        "更阑生怕下楼梯。",
        "徐娘怪我今疏懒，不及庐郎年少时。"
      ],
      "author": {
        "id": 11270,
        "name": "吕胜己"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314819,
      "title": "鹧鸪天",
      "content": [
        "纸帐虚明好醉眠。",
        "博山轻袅水沉烟。",
        "了知世上都如梦，须信壶中别有天。",
        "知我者，为君言。",
        "道人有个好因缘。",
        "丹成有日归云路，且最梅花作地仙。"
      ],
      "author": {
        "id": 11270,
        "name": "吕胜己"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314856,
      "title": "鹧鸪天",
      "content": [
        "镂玉裁琼莫比香。",
        "娉婷枝上𣨼春光。",
        "风流别有千般韵，割舍昏沈入醉乡。",
        "蜂共蝶，尽干忙。",
        "檀心知未肯寻常。",
        "从来诗苦人消瘦，乞与幽窗富锦囊。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314857,
      "title": "鹧鸪天",
      "content": [
        "蜂蜜酿成花已飞。",
        "海棠次第雨胭脂。",
        "园林检点春归也，只有萦风柳带垂。",
        "情默默，恨依依。",
        "可人天气日长时。",
        "东风恰好寻芳去，何事驱弛作别离。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314880,
      "title": "鹧鸪天",
      "content": [
        "弱质纤姿俪素妆。",
        "水沈山麝郁幽香。",
        "直疑姑射来天上，要恼人间傅粉郎。",
        "简酿酒，枕为囊。",
        "更馀风味胜糖霜。",
        "肯如红紫空姚冶，谩惹游蜂戏蝶忙。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314881,
      "title": "鹧鸪天",
      "content": [
        "玉容应不羡梅妆。",
        "檀心特地赛炉香。",
        "半臧密叶墙头女，勾引酡颜马上郎。",
        "樽乏酒，且倾囊。",
        "蟹螯糟熟似黏霜。",
        "一年光景浑如梦，可惜人生忙处忙。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314882,
      "title": "鹧鸪天",
      "content": [
        "洗尽铅华不著妆。",
        "一般真色自生香。",
        "飘飘何处凌波女，故故相迎马上郎。",
        "寻谱谍，发诗囊。",
        "绝胜梅萼嫁冰霜。",
        "故山寒食依然在，句引东坡旅兴忙。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314883,
      "title": "鹧鸪天",
      "content": [
        "镂玉裁琼学靓妆。",
        "不须沈水自然香。",
        "好随梅蕊妆宫额，肯似桃花误阮郎。",
        "羞傅粉，贱香囊。",
        "何劳傲雪与凌霜。",
        "新来句引无情眼，拼为东风一晌忙。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314884,
      "title": "鹧鸪天",
      "content": [
        "绰约肌肤巧样妆。",
        "风流元自有清香。",
        "未应傅粉疑平叔，却笑荷花似六郎。",
        "浮蚁瓮，入诗囊。",
        "学人消瘦怯风霜。",
        "午窗一枕庄周梦，甘作花心粉蝶忙。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314915,
      "title": "鹧鸪天",
      "content": [
        "梁上双双海燕归。",
        "故人应不寄新诗。",
        "柳梧阴里高还下，帘幕中间去复回。",
        "追盛事，忆乌衣。",
        "王家巷陌日沈西。",
        "兴亡无限惊心语，说与时人总不知。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314916,
      "title": "鹧鸪天",
      "content": [
        "谡谡东风作雨寒。",
        "无言独自凭栏干。",
        "绿肥红瘦春归去，恨逼愁侵酒怎宽。",
        "追往事，惜花残。",
        "残花往事总相关。",
        "风光台上伤心处，此意人休作等闲。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314946,
      "title": "鹧鸪天",
      "content": [
        "手种梅花三四株。",
        "要看冰霜照清臞。",
        "朝来几朵茅檐下，竹外江头恐不如。",
        "凝玉面，吐香须。",
        "莫嫌孤瘦渐丰馀。",
        "化工不肯辜人意，做底欢娱报答渠。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314947,
      "title": "鹧鸪天",
      "content": [
        "只惯娇痴不惯愁。",
        "离情浑不挂眉头。",
        "可怜恼尽尊前客，却趁东风上小舟。",
        "真个去，不忺留。",
        "落花流水一春休。",
        "自怜不及春江水，随到滕王阁下流。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314965,
      "title": "鹧鸪天",
      "content": [
        "新晴水暖藕花红。",
        "烘人暑意晚来浓。",
        "共携纤手桥东路，杨柳青青一径风。",
        "深翠里，艳香中。",
        "双莺初下蕊珠宫。",
        "月笼粉面三更露，凉透萧萧一梦中。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314982,
      "title": "鹧鸪天",
      "content": [
        "牙领番腾一线红。",
        "花儿新样喜相逢。",
        "薄纱衫子轻笼玉，削玉身材瘦怯风。",
        "人易老，恨难穷。",
        "翠屏罗幌两心同。",
        "既无闲事萦怀抱，莫把双蛾皱碧峰。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315008,
      "title": "鹧鸪天",
      "content": [
        "亭树萧萧生暮凉。",
        "安排清梦到胡床。",
        "楚山楚水秋江外，江北江南客恨长。",
        "苹渚冷，橘汀黄。",
        "断魂残梦更斜阳。",
        "欲将此日悲秋泪，洒向江天哭楚狂。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315056,
      "title": "鹧鸪天",
      "content": [
        "宝篆龙煤烧欲残。",
        "细听铜漏已更阑。",
        "纱窗斜月移梅影，特地笼灯仔细看。",
        "幽梦断，旧盟寒。",
        "那时屈曲小屏山。",
        "风光得似而今不，肯把花枝作等闲。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315062,
      "title": "鹧鸪天",
      "content": [
        "门外寒江泊小船。",
        "月明留客小窗前。",
        "夜香烧尽更声远，斗帐低垂暖意生。",
        "醺著酒，炙些灯。",
        "伴他针线懒成眠。",
        "情知今夜鸳鸯梦，不似孤篷宿雁边。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315100,
      "title": "鹧鸪天",
      "content": [
        "睡觉扶头听晓钟。",
        "隔帘花雾湿香红。",
        "翠摇钿砌梧桐影，暖透罗襦芍药风。",
        "闲对影，记曾逢。",
        "画眉临镜霎时同。",
        "相思已有无穷恨，忍见孤鸾宿镜中。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315101,
      "title": "鹧鸪天",
      "content": [
        "宝篆烟消香已残。",
        "蝉娟月色浸栏干。",
        "歌喉不作寻常唱，酒令从他各自还。",
        "传杯手，莫教闲。",
        "醉红潮脸媚酡颜。",
        "相携共学骖鸾侣，却笑卢郎旧约寒。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315102,
      "title": "鹧鸪天",
      "content": [
        "绿水澄江得胜游。",
        "浪平风软称轻舟。",
        "樽前我易伤前事，柳外人谁独倚楼。",
        "空感慨，惜风流。",
        "风流赢得谩多愁。",
        "愁多著甚销磨得，莫怪安仁鬓早秋。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315103,
      "title": "鹧鸪天",
      "content": [
        "一曲清歌金缕衣。",
        "巧佼心事有谁知。",
        "自从别后难相见，空解题红寄好诗。",
        "忆携手，过阶墀。",
        "月笼花影半明时。",
        "玉钗头上轻轻颤，摇落钗头豆蔻枝。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315179,
      "title": "鹧鸪天",
      "content": [
        "落魄东吴二十春。",
        "风流诗句得清新。",
        "今年却恨花星照，再见温卿与远真。",
        "分楚佩，染巫云。",
        "赤绳结得短花茵。",
        "若非京口初相识，安得毗陵作故人。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315202,
      "title": "鹧鸪天",
      "content": [
        "豆蔻梢头春意浓。",
        "薄罗衫子柳腰风。",
        "人间乍识瑶池似，天上浑疑月殿空。",
        "眉黛小，髻云松。",
        "背人欲整又还慵。",
        "多应没个藏娇处，满镜桃花带雨红。"
      ],
      "author": {
        "id": 257,
        "name": "张孝忠"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315218,
      "title": "鹧鸪天",
      "content": [
        "天近袄知雨露浓。",
        "湖山无日不春风。",
        "闲花野草皆掀舞，曾在君王顾盼中。",
        "时易得，会难逢。",
        "朝为逆旅暮三公。",
        "蛟龙得雨飞无便，鸡犬腾云夙有功。"
      ],
      "author": {
        "id": 1037,
        "name": "林淳"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315292,
      "title": "鹧鸪天",
      "content": [
        "岁月如驰乌兔飞。",
        "情怀著酒强支持。",
        "经年不见宫妆面，秾碧谁斟翡翠卮。",
        "江路晚，夕阳低。",
        "奚奴空负锦囊归。",
        "欲凭驿使传芳信，未放东风第一枝。"
      ],
      "author": {
        "id": 8242,
        "name": "杨冠卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315354,
      "title": "鹧鸪天",
      "content": [
        "一榻清风殿影凉。",
        "涓涓流水响回廊。",
        "千章云木钩辀叫，十里溪风𫁂䅉香。",
        "冲急雨，趁斜阳。",
        "山园细路转微茫。",
        "倦途却被行人笑，只为林泉有底忙。"
      ],
      "author": {
        "id": 8618,
        "name": "辛弃疾"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315355,
      "title": "鹧鸪天",
      "content": [
        "晚日寒鸦一片愁。",
        "柳塘新绿却温柔。",
        "若教眼底无离恨，不信人间有白头。",
        "肠已断，泪难收。",
        "相思重上小红楼。",
        "情知已被山遮断，频倚阑干不自由。"
      ],
      "author": {
        "id": 8618,
        "name": "辛弃疾"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315356,
      "title": "鹧鸪天",
      "content": [
        "翠竹千寻上薜萝。",
        "东湖经雨又增波。",
        "只因买得青山好，却恨归来白发多。",
        "明画烛，洗金荷。",
        "主人起舞客齐歌。",
        "醉中只恨欢娱少，明日醒时奈病何。"
      ],
      "author": {
        "id": 8618,
        "name": "辛弃疾"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315357,
      "title": "鹧鸪天",
      "content": [
        "唱彻《阳关》泪未干。",
        "功名馀事且加餐。",
        "浮天水送无穷树，带雨云埋一半山。",
        "今古恨，几千般。",
        "只应离合是悲欢。",
        "江头未是风波恶，别有人间行路难。"
      ],
      "author": {
        "id": 8618,
        "name": "辛弃疾"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315358,
      "title": "鹧鸪天",
      "content": [
        "扑面征尘去路遥。",
        "香篝渐觉水沈销。",
        "山无重数周遭碧，花不知名分外娇。",
        "人历历，马萧萧。",
        "笙旗又过小红桥。",
        "愁边剩有相思句，摇断吟鞭碧玉梢。"
      ],
      "author": {
        "id": 8618,
        "name": "辛弃疾"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315359,
      "title": "鹧鸪天",
      "content": [
        "枕簟溪堂冷欲秋。",
        "断云依水晚来收。",
        "红莲相倚浑如醉，白鸟无言定自愁。",
        "书咄咄，且休休。",
        "一丘一壑也风流。",
        "不知筋力衰多少，但觉新来懒上楼。"
      ],
      "author": {
        "id": 8618,
        "name": "辛弃疾"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315455,
      "title": "鹧鸪天",
      "content": [
        "著意寻春懒便回。",
        "何如信步两三杯。",
        "山才好处行还倦，诗未成时雨早催。",
        "携竹杖，更芒鞋。",
        "朱朱粉粉野蒿开。",
        "谁家寒食归宁女，笑语柔桑陌上来。"
      ],
      "author": {
        "id": 8618,
        "name": "辛弃疾"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315456,
      "title": "鹧鸪天",
      "content": [
        "水底明霞十顷光。",
        "天教铺锦衬鸳鸯。",
        "最怜杨柳如张绪，却笑莲花似六郎。",
        "方竹簟，小胡床。",
        "晚风消得许多凉。",
        "背人白鸟都飞去，落日残□更断肠。"
      ],
      "author": {
        "id": 8618,
        "name": "辛弃疾"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315457,
      "title": "鹧鸪天",
      "content": [
        "漠漠轻□拨不开。",
        "江南细雨熟黄梅。",
        "有情无意东边日，已怒重惊忽地雷。",
        "云柱础，水楼台。",
        "罗衣费尽博山灰。",
        "当时一识和羹味，便道为霖消息来。"
      ],
      "author": {
        "id": 8618,
        "name": "辛弃疾"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315458,
      "title": "鹧鸪天",
      "content": [
        "有甚闲愁可皱眉。",
        "老怀无绪自伤悲。",
        "百年旋逐花阴转，万事长看鬓发知。",
        "溪上枕，竹间棋。",
        "怕寻酒伴懒吟诗。",
        "十分筋力夸强健，只比年时病起时。"
      ],
      "author": {
        "id": 8618,
        "name": "辛弃疾"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315459,
      "title": "鹧鸪天",
      "content": [
        "山上飞泉万斛珠。",
        "悬崖千丈落鼪鼯。",
        "已通樵迳行还碍，似有人声听却无。",
        "闲略彴，远浮屠。",
        "溪南修竹有茅庐。",
        "莫嫌杖屦频来往，此地偏宜著老夫。"
      ],
      "author": {
        "id": 8618,
        "name": "辛弃疾"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315460,
      "title": "鹧鸪天",
      "content": [
        "莫避春阴上马迟。",
        "春来未有不阴时。",
        "人情展转闲中看，客路崎岖倦后知。",
        "梅似雪，柳如丝。",
        "试听别语慰相思。",
        "短篷炊饭鲈鱼熟，除却松江枉费诗。"
      ],
      "author": {
        "id": 8618,
        "name": "辛弃疾"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315461,
      "title": "鹧鸪天",
      "content": [
        "白苎新袍入嫩凉。",
        "春蚕食叶响回廊。",
        "禹门已准桃花浪，月殿先收桂子香。",
        "鹏北海，凤朝阳。",
        "又携书剑路茫茫。",
        "明年此日青云去，却笑人间举子忙。"
      ],
      "author": {
        "id": 8618,
        "name": "辛弃疾"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315462,
      "title": "鹧鸪天",
      "content": [
        "莫上扁舟向剡溪。",
        "浅斟低唱正相宜。",
        "从□犬吠千家白，且与梅成一段奇。",
        "香暖处，酒醒时。",
        "画檐玉箸已偷垂。",
        "笑君解释春风恨，倩拂蛮笺只费诗。"
      ],
      "author": {
        "id": 8618,
        "name": "辛弃疾"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315463,
      "title": "鹧鸪天",
      "content": [
        "千丈阴崖百丈溪。",
        "孤桐枝上凤偏宜。",
        "玉音落落虽难合，横理庚庚定自奇。",
        "人散后，月明诗。",
        "试弹《幽愤》泪空垂。",
        "不如却付骚人手，留和《南风》解愠诗。"
      ],
      "author": {
        "id": 8618,
        "name": "辛弃疾"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315464,
      "title": "鹧鸪天",
      "content": [
        "陌上柔条初破芽。",
        "东邻蚕种已生些。",
        "平冈细草鸣黄犊，斜日寒林点暮鸦。",
        "山远近，路横斜。",
        "青旗沽酒有人家。",
        "城中桃李愁风雨，春在溪头野荠花。"
      ],
      "author": {
        "id": 8618,
        "name": "辛弃疾"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315465,
      "title": "鹧鸪天",
      "content": [
        "春日平原荠菜花。",
        "新耕雨后落群鸦。",
        "多情白发春无奈，晚日青□酒易赊。",
        "闲意态，细生涯。",
        "牛□西畔有桑麻。",
        "青裙缟袂谁家女，去趁蚕生看外家。"
      ],
      "author": {
        "id": 8618,
        "name": "辛弃疾"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315466,
      "title": "鹧鸪天",
      "content": [
        "千丈清溪百步雷。",
        "柴门都向水边开。",
        "乱云剩带炊烟去，野水闲将日影来。",
        "穿窈窕，历崔嵬。",
        "东林试问几时栽。",
        "动摇意态虽多竹，点缀风流却少梅。"
      ],
      "author": {
        "id": 8618,
        "name": "辛弃疾"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315467,
      "title": "鹧鸪天",
      "content": [
        "敧枕婆娑两鬓霜。",
        "起听檐溜碎喧江。",
        "那边玉箸销啼粉，这里车轮转别肠。",
        "诗酒社，水边乡。",
        "可堪醉墨几淋浪。",
        "画图恰似归家梦，千里河山寸许长。"
      ],
      "author": {
        "id": 8618,
        "name": "辛弃疾"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315601,
      "title": "鹧鸪天",
      "content": [
        "聚散匆匆不偶然。",
        "二年遍历楚山川。",
        "但将痛饮酬风月，莫放离歌入管弦。",
        "萦绿带，点青钱。",
        "东湖春水碧连天。",
        "明朝放我东归去，后夜相思月满船。"
      ],
      "author": {
        "id": 8618,
        "name": "辛弃疾"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315602,
      "title": "鹧鸪天",
      "content": [
        "翰墨诸君久擅场。",
        "胸中书传许多香。",
        "苦无丝竹衔杯乐，却看龙蛇落笔忙。",
        "闲意思，老风光。",
        "酒徒今有几高阳。",
        "黄花不怯秋风冷，只怕诗人两鬓霜。"
      ],
      "author": {
        "id": 8618,
        "name": "辛弃疾"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    }
  ],
