{
  "data": [
    {
      "id": 267449,
      "title": "峡哀 五",
      "content": [
        "峡螭老解语，百丈潭底闻。",
        "毒波为计校，饮血养子孙。",
        "既非臯陶吏，空食沈狱魂。",
        "潜怪何幽幽，魄说徒云云。",
        "峡听哀哭泉，峡吊鳏寡猿。",
        "峡声非人声，劒水相劈翻。",
        "斯谁士诸谢，奏此沉苦言。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267450,
      "title": "峡哀 六",
      "content": [
        "谗人峡虬心，渴罪呀然浔。",
        "所食无直肠，所语饶枭音。",
        "石齿嚼百泉，石风号千琴。",
        "幽哀莫能远，分雪何由寻。",
        "月魄高卓卓，峡窟清沉沉。",
        "衔诉何时明，抱痛已不禁。",
        "犀飞空波涛，裂石千嵚岑。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267451,
      "title": "峡哀 七",
      "content": [
        "峡棱剸日月，日月多摧辉。",
        "物皆斜仄生，鸟亦斜仄飞。",
        "潜石齿相锁，沉魂招莫归。",
        "恍惚清泉甲，斑斓碧石衣。",
        "饿咽潺湲号，涎似泓浤肥。",
        "峡青不可游，腥草生微微。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267452,
      "title": "峡哀 八",
      "content": [
        "峡景滑易堕，峡花怪非春。",
        "红光根潜涎，碧雨飞沃津。",
        "巴谷蛟螭心，巴乡魍魉亲。",
        "噉生不问贤，至死独养身。",
        "腥语信者谁，拗歌欢非真。",
        "仄田无异稼，毒水多狞鳞。",
        "异类不可友，峡哀哀难伸。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267453,
      "title": "峡哀 九",
      "content": [
        "峡水劒戟狞，峡舟霹雳翔。",
        "因依虺蜴手，起坐风雨忙。",
        "峡旅多窜官，峡氓多非良。",
        "滑心不可求，滑习积已长。",
        "漠漠涎雾起，龂龂涎水光。",
        "渴贤如之何，忽在水中央。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267454,
      "title": "峡哀 十",
      "content": [
        "枭鸱作人语，蛟虬吸水波。",
        "能于白日间，谄欲晴风和。",
        "骇智蹶众命，蕴腥布深萝。",
        "齿泉无底贫，锯涎在处多。",
        "仄树鸟不巢，踔𨃚猿相过。",
        "峡哀不可听，峡怨其奈何。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267455,
      "title": "杏殇 一",
      "content": [
        "冻手莫弄珠，弄珠珠易飞。",
        "惊霜莫翦春，翦春无光辉。",
        "零落小花乳，斓斑昔婴衣。",
        "拾之不盈把，日暮空悲归。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267456,
      "title": "杏殇 二",
      "content": [
        "地上空拾星，枝上不见花。",
        "哀哀孤老人，戚戚无子家。",
        "岂若没水凫，不如拾巢鸦。",
        "浪鷇破便飞，风雏褭相夸。",
        "芳婴不复生，向物空悲嗟。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267457,
      "title": "杏殇 三",
      "content": [
        "应是一线泪，入此春木心。",
        "枝枝不成花，片片落翦金。",
        "春寿何可长，霜哀亦已深。",
        "常时洗芳泉，此日洗泪襟。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267458,
      "title": "杏殇 四",
      "content": [
        "儿生月不明，儿死月始光。",
        "儿月两相夺，儿命果不长。",
        "如何此英英，亦为吊苍苍。",
        "甘为堕地尘，不为末世芳。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267459,
      "title": "杏殇 五",
      "content": [
        "踏地恐土痛，损彼芳树根。",
        "此诚天不知，翦弃我子孙。",
        "垂枝有千落，芳命无一存。",
        "谁谓生人家，春色不入门。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267460,
      "title": "杏殇 六",
      "content": [
        "冽冽霜杀春，枝枝疑纤刀。",
        "木心既零落，山窍空呼号。",
        "班班落地英，点点如明膏。",
        "始知天地间，万物皆不牢。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267461,
      "title": "杏殇 七",
      "content": [
        "哭此不成春，泪痕三四斑。",
        "失芳蝶既狂，失子老亦孱。",
        "且无生生力，自有死死颜。",
        "灵凤不衔诉，谁为扣天关。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267462,
      "title": "杏殇 八",
      "content": [
        "此儿自见灾，花发多不谐。",
        "穷老收碎心，永夜抱破怀。",
        "声死更何言，意死不必喈。",
        "病叟无子孙，独立犹束柴。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267463,
      "title": "杏殇 九",
      "content": [
        "霜似败红芳，剪啄十数双。",
        "参差呻细风，𪡋喁沸浅江。",
        "泣凝不可消，恨壮难自降。",
        "空遗旧日影，怨彼小书窗。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267464,
      "title": "吊江南老家人春梅",
      "content": [
        "念尔筋力尽，违我衣食恩。",
        "奈何粗犷儿，生鞭见死痕。",
        "旧使常以礼，新怨将谁吞。",
        "胡为乎泥中，消歇教义源。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 267465,
      "title": "哭李丹员外幷寄杜中丞",
      "content": [
        "生死方知交态存，忍将齚齖报幽魂。",
        "十年同在平原客，更遣何人哭寝门。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 267466,
      "title": "哭刘言史",
      "content": [
        "诗人业孤峭，饿死良已多。",
        "相悲与相笑，累累其奈何。",
        "精异刘言史，诗肠倾珠河。",
        "取次抱置之，飞过东溟波。",
        "可惜大国谣，飘为四夷歌。",
        "常于众中会，颜色两切[磋]。",
        "今日果成死，葬襄之洛河。",
        "洛岸远相吊，洒泪双滂沱。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267467,
      "title": "吊卢殷 一",
      "content": [
        "诗人多清峭，饿死抱空山。",
        "白云既无主，飞出意等闲。",
        "久病床席尸，护丧童仆孱。",
        "故书穷鼠啮，狼藉一室间。",
        "君归新鬼乡，我面古玉颜。",
        "羞见入地时，无人叫追攀。",
        "百泉空相吊，日久哀潺潺。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267468,
      "title": "吊卢殷 二",
      "content": [
        "唧唧复唧唧，千古一月色。",
        "新新复新新，千古一花春。",
        "邙风噫孟郊，嵩秋葬卢殷。",
        "北邙前后客，相吊为埃尘。",
        "北邙棘针草，泪根生苦辛。",
        "烟火不自煖，筋力早已贫。",
        "幽荐一杯泣，泻之清洛滨。",
        "添为断肠声，愁杀长别人。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267469,
      "title": "吊卢殷 三",
      "content": [
        "棘针风相号，破碎诸苦哀。",
        "苦哀不可闻，掩耳亦入来。",
        "哭弦多煎声，恨涕有余摧。",
        "噫贫气已焚，噫死心更灰。",
        "梦世浮闪闪，泪波深洄洄。",
        "薤歌一以去，蒿闭不复开。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267470,
      "title": "吊卢殷 四",
      "content": [
        "登封草木深，登封道路微。",
        "日月不与光，莓苔空生衣。",
        "可怜无子翁，蚍蜉缘病肌。",
        "挛卧岁时长，涟涟但幽噫。",
        "幽噫虎豹闻，此外相访稀。",
        "至亲唯有诗，抱心死有归。",
        "河南韩先生，后君作因依。",
        "磨一片嵌岩，书千古光辉。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267471,
      "title": "吊卢殷 五",
      "content": [
        "贤人无计较，生苦死徒夸。",
        "佗名润子孙，君名润泥沙。",
        "可惜千首文，闪如一朝花。",
        "零落难苦言，起坐空惊嗟。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 267472,
      "title": "吊卢殷 六",
      "content": [
        "耳闻陋巷生，眼见鲁山君。",
        "饿死始有名，饿名高氛氲。",
        "戆叟老壮气，感之为忧云。",
        "所忧唯一泣，古今相纷纷。",
        "平生与君说，逮此俱云云。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267473,
      "title": "吊卢殷 七",
      "content": [
        "初识漆鬓发，争为新文章。",
        "夜踏明月桥，店饮吾曹床。",
        "醉啜二杯酿，名郁一县香。",
        "寺中摘梅花，园里翦浮芳。",
        "高嗜绿蔬羹，意轻肥腻羊。",
        "吟哦无滓韵，言语多古肠。",
        "白首忽然至，盛年如偷将。",
        "清浊俱莫追，何须骂沧浪。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267474,
      "title": "吊卢殷 八",
      "content": [
        "前贤多哭酒，哭酒免哭心。",
        "后贤试衔之，哀至无不深。",
        "少年哭酒时，白发亦已侵。",
        "老年哭酒时，声韵随生沈。",
        "寄言哭酒宾，勿作登封音。",
        "登封徒放声，天地竟难寻。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267475,
      "title": "吊卢殷 九",
      "content": [
        "同人少相哭，异类多相号。",
        "始知禽兽痴，却至天然高。",
        "非子病无泪，非父念莫劳。",
        "如何裁亲疎，用礼如用刀。",
        "孤丧鲜匍匐，闭哀抱郁陶。",
        "烦他手中葬，诚信焉能褒。",
        "嗟嗟无子翁，死弃如脱毛。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267476,
      "title": "吊卢殷 十",
      "content": [
        "圣人哭贤人，骨化气为星。",
        "文章飞上天，列宿增晶荧。",
        "前古文可数，今人文亦灵。",
        "高名称谪仙，升降曾莫停。",
        "有文死更香，无文生亦腥。",
        "为君铿好辞，永传作谧宁。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 292804,
      "title": "有所思联句",
      "content": [
        "相思绕我心，日夕千万重。",
        "年光坐婉娩，春泪销颜容。",
        "台镜晦旧晖，庭草滋深茸。",
        "望夫山上石，别劒水中龙。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 292805,
      "title": "遣兴联句",
      "content": [
        "我心随月光，写君庭中央。",
        "月光有时晦，我心安所忘。",
        "常恐金石契，断为相思肠。",
        "平生无百岁，岐路有四方。",
        "四方各异俗，适异非所将。",
        "驽蹄顾挫秣，逸翮遗稻粱。",
        "时危抱独沈，道泰怀同翔。",
        "独居久寂默，相顾聊慨慷。",
        "慨慷丈夫志，可以曜锋铓。",
        "蘧宁知卷舒，孔颜识行藏。",
        "殷鉴谅不远，佩兰永芬芳。",
        "苟无夫子听，谁使知音扬。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 292806,
      "title": "赠劒客李园联句",
      "content": [
        "天地有灵术，得之者惟君。",
        "筑炉地区外，积火烧氛氲。",
        "照海铄幽怪，满空歊异氛。",
        "山磨电奕奕，水淬龙蝹蝹。",
        "太一装以宝，列仙篆其文。",
        "可用慑百神，岂惟壮三军。",
        "有时幽匣吟，忽似深潭闻。",
        "风胡久已死，此劒将谁分。",
        "行当献天子，然后致殊勋。",
        "岂知丰城下，空有斗间云。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 301581,
      "title": "观音岩",
      "content": [
        "岩洞分明是普陀，和风甘雨向来多。",
        "空山寂寞香灯少，莲坐春云长薜萝。",
        "（《古今图书集·职方典》七八五《安庆府部》）。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 334314,
      "title": "乐府杂曲：鼓吹曲辞：巫山高二首",
      "content": [
        "巴山上峡重复重，阳台碧峭十二峰。",
        "荆王猎时逢暮雨，",
        "目极魂断望不见，猿啼三声泪沾衣。",
        "见尽数万里，不闻三声猿。",
        "但飞萧萧雨，中有亭亭魂。",
        "千载楚襄恨，遗文宋玉言。",
        "至今青冥里，云结深闺门。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 334329,
      "title": "乐府杂曲：鼓吹曲辞：有所思",
      "content": [
        "桔槔烽火昼不灭，客路迢迢信难越。",
        "古镇刀攒万片霜，"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 334397,
      "title": "横吹曲辞：折杨柳",
      "content": [
        "杨柳多短枝，短枝多别离。",
        "赠远累攀折，柔条安得垂。",
        "青春有定节，离别无定时。",
        "但恐人别促，不怨来迟迟。",
        "莫言短枝条，中有长相思。",
        "朱颜与绿杨，并在别离期。",
        "楼上春风过，风前杨柳歌。",
        "枝疏缘别苦，曲怨为年多。",
        "花惊燕地雪，叶映楚池波。",
        "谁堪别离此，征戍在交河。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 334418,
      "title": "横吹曲辞：长安道",
      "content": [
        "胡风激秦树，贱子风中泣。",
        "家家朱门开，得见不可入。",
        "长安十二衢，投树鸟亦急。",
        "高阁何人家，笙簧正喧吸。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 334643,
      "title": "相和歌辞：怨诗",
      "content": [
        "试妾与君泪，两处滴池水。",
        "看取芙蓉花，今年为谁死。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 334696,
      "title": "相和歌辞：杂怨三首",
      "content": [
        "夭桃花清晨，游女红粉新。",
        "夭桃花薄暮，游女红粉故。",
        "树有百年花，人无一定颜。",
        "花送人老尽，人悲花自闲。",
        "贫女镜不明，寒花日少容。",
        "暗蛩有虚织，短线无长缝。",
        "浪水不可照，狂夫不可从。",
        "浪水多散影，狂夫多异踪。",
        "持此一生薄，空成百恨浓。",
        "忆人莫至悲，至悲空自衰。",
        "寄人莫翦衣，翦衣未必归。",
        "朝为双蒂花，暮为四散飞。",
        "花落却绕树，游子不顾期。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 334820,
      "title": "琴曲歌辞：湘妃怨",
      "content": [
        "南巡竟不返，帝子怨逾积。",
        "万里丧蛾眉，潇湘水空碧。",
        "冥冥荒山下，古庙收贞魄。",
        "乔木深青春，清光满瑶席。",
        "搴芳徒有荐，灵意殊脉脉。",
        "玉佩不可亲，裴回烟波夕。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 334841,
      "title": "琴曲歌辞：列女操",
      "content": [
        "梧桐相待老，鸳鸯会双死。",
        "贞妇贵殉夫，舍生亦如此。",
        "波澜誓不起，妾心井中水。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 334885,
      "title": "杂曲歌辞：出门行二首",
      "content": [
        "长河悠悠去无极，百龄同此可叹息。",
        "秋风白露沾人衣，",
        "一闻陌上苦寒奏，使我伫立惊且悲。",
        "君今得意厌粱肉，",
        "海风萧萧天雨霜，穷愁独坐夜何长。",
        "驱车旧忆太行险，",
        "手持琅玕欲有赠，爱而不见心断绝。",
        "南山峨峨白石烂，"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 334893,
      "title": "杂曲歌辞：伤歌行",
      "content": [
        "众毒蔓贞松，一枝难久荣。",
        "岂知黄庭客，仙骨生不成。",
        "春色舍芳蕙，秋风绕枯茎。",
        "弹琴不成曲，始觉知音倾。",
        "馆月改旧照，吊宾写余情。",
        "还舟空江上，波浪送铭旌。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 334905,
      "title": "杂曲歌辞：妾薄命",
      "content": [
        "不惜十指弦，为君千万弹。",
        "常恐新声至，坐使故声残。",
        "弃置今日悲，即是昨日欢。",
        "将新变故易，持故为新难。",
        "青山有蘼芜，泪叶长不干。",
        "空令后代人，采掇幽思攒。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 334913,
      "title": "杂曲歌辞：羽林行",
      "content": [
        "朔雪寒断指，朔风劲裂冰。",
        "胡中射雕者，此日犹不能。",
        "翩翩羽林儿，锦臂飞苍鹰。",
        "挥鞭决白马，走出黄河凌。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 334963,
      "title": "杂曲歌辞：灞上轻薄行",
      "content": [
        "长安无缓步，况值天景暮。",
        "相逢灞浐间，亲戚不相顾。",
        "自叹方拙身，忽随轻薄伦。",
        "常恐失所避，化为车辙尘。",
        "此中生白发，疾走亦未歇。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 334965,
      "title": "杂曲歌辞：游侠行",
      "content": [
        "壮士性刚决，火中见石裂。",
        "杀人不回头，轻生如暂别。",
        "岂知眼有泪，肯白头上发。",
        "平生无恩酬，剑闲一百月。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 334970,
      "title": "杂曲歌辞：游子吟",
      "content": [
        "慈母手中线，游子身上衣。",
        "临行密密缝，意恐迟迟归。",
        "谁言寸草心，报得三春晖。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 334993,
      "title": "杂曲歌辞：车遥遥",
      "content": [
        "路喜到江尽，江上又通舟。",
        "舟车两无阻，何处不得游。",
        "丈夫四方志，女子安可留。",
        "郎自别日言，无令生远愁。",
        "旅雁忽叫月，断猿寒啼秋。",
        "此夕梦君梦，君在百城楼。",
        "寄泪无因波，寄恨无因辀。",
        "愿为驭者手，与郎回马头。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 335044,
      "title": "杂曲歌辞：古离别二首",
      "content": [
        "松山云缭绕，萍路水分离。",
        "云去有归日，水分无合时。",
        "春芳役双眼，春色柔四支。",
        "杨柳织别愁，千条万条丝。",
        "山川古今路，纵横无断绝。",
        "来往天地间，人皆有离别。",
        "行衣未束带，中肠已先结。",
        "不用看镜中，自知生白发。",
        "欲陈去留意，声向言前咽。",
        "愁结填心胸，茫茫若为说。",
        "荒郊烟莽苍，旷野风凄切。",
        "处处得相随，人那不如月。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 335133,
      "title": "杂曲歌辞：乐府三首",
      "content": [
        "莲子不可得，荷花生水中。",
        "犹胜道傍柳，无事荡春风。",
        "渌萍与荷叶，同此一水中。",
        "风吹荷叶在，渌萍西复东。",
        "莲花未开时，苦心终日卷。",
        "春水徒荡漾，荷花未开展。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 350772,
      "title": "列女操",
      "content": [
        "梧桐相待老，鸳鸯会双死。",
        "贞女贵徇夫，舍生亦如此。",
        "波澜誓不起，妾心井中水。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 350773,
      "title": "灞上轻薄行",
      "content": [
        "长安无缓步，况值天景暮。",
        "相逢灞浐间，亲戚不相顾。",
        "自叹方拙身，忽随轻薄伦。",
        "常恐失所避，化为车辙尘。",
        "此中生白发，疾走亦未歇。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 350776,
      "title": "送远吟",
      "content": [
        "河水昏复晨，河边相送频。",
        "离杯有泪饮，别柳无枝春。",
        "一笑忽然敛，万愁俄已新。",
        "东波与西日，不惜远行人。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 350779,
      "title": "杂怨",
      "content": [
        "忆人莫至悲，至悲空自衰。",
        "寄人莫剪衣，剪衣未必归。",
        "朝为双蒂花，莫为四散飞。",
        "花落还绕树，游子不顾期。",
        "夭桃花清晨，游女红粉新。",
        "夭桃花薄暮，游女红粉故。",
        "树有百年花，人无一定颜。",
        "花送人老尽，人悲花自闲。",
        "贫女镜不明，寒花日少容。",
        "暗蛩有虚织，短线无长缝。",
        "浪水不可照，狂夫不可从。",
        "浪水多散影，狂夫多异踪。",
        "持此一生薄，空成万恨浓。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 350780,
      "title": "静女吟",
      "content": [
        "艳女皆妒色，静女独检踪。",
        "任礼耻任妆，嫁德不嫁容。",
        "君子易求聘，小人难自从。",
        "此志谁与谅，琴弦幽韵重。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 350782,
      "title": "山老吟",
      "content": [
        "不行山下地，唯种山上田。",
        "腰斧斫旅松，手瓢汲家泉。",
        "讵知文字力，莫记日月迁。",
        "蟠木为我身，始得全天年。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 350785,
      "title": "苦寒吟",
      "content": [
        "天寒色青苍，北风叫枯桑。",
        "厚冰无裂文，短日有冷光。",
        "敲石不得火，壮阴夺正阳。",
        "苦调竟何言，冻吟成此章。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 350787,
      "title": "伤哉行",
      "content": [
        "众毒蔓贞松，一枝难久荣。",
        "岂知黄庭客，仙骨生不成。",
        "春色舍芳蕙，秋风绕枯茎。",
        "弹琴不成曲，始觉知音倾。",
        "馆月改旧照，吊宾写余情。",
        "还舟空江上，波浪送铭旌。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 350790,
      "title": "楚竹吟酬卢虔端公见和湘弦怨",
      "content": [
        "握中有新声，楚竹人未闻。",
        "识音者谓谁，清夜吹赠君。",
        "昔为潇湘引，曾动潇湘云。",
        "一叫凤改听，再惊鹤失群。",
        "江花匪秋落，山日当昼曛。",
        "众浊响杂遝，孤清思氛氲。",
        "欲知怨有形，愿向明月分。",
        "一掬灵均泪，千年湘水文。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 350795,
      "title": "杀气不在边",
      "content": [
        "杀气不在边，凛然中国秋。",
        "道险不在山，平地有摧辀。",
        "河南又起兵，清浊俱锁流。",
        "岂唯私客艰，拥滞官行舟。",
        "况余隔晨昏，去家成阻修。",
        "忽然两鬓雪，同是一日愁。",
        "独寝夜难晓，起视星汉浮。",
        "凉风荡天地，日夕声飕飗。",
        "万物无少色，兆人皆老忧。",
        "长策苟未立，丈夫诚可羞。",
        "灵响复何事，剑鸣思戮雠。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 350797,
      "title": "弦歌行",
      "content": [
        "驱傩击鼓吹长笛，瘦鬼染面惟齿白。",
        "暗中崒崒拽茅鞭，"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 350798,
      "title": "覆巢行",
      "content": [
        "荒城古木枝多枯，飞禽嗷嗷朝哺雏。",
        "枝倾巢覆雏坠地，",
        "枝危巢小风雨多，未容长成已先覆。",
        "灵枝珍木满上林，"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 350799,
      "title": "出门行",
      "content": [
        "长河悠悠去无极，百龄同此可叹息。",
        "秋风白露沾人衣，",
        "一闻陌上苦寒奏，使我伫立惊且悲。",
        "君今得意厌粱肉，",
        "海风萧萧天雨霜，穷愁独坐夜何长。",
        "驱车旧忆太行险，",
        "手持琅玕欲有赠，爱而不见心断绝。",
        "南山峨峨白石烂，"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 350801,
      "title": "巫山曲",
      "content": [
        "巴江上峡重复重，阳台碧峭十二峰。",
        "荆王猎时逢暮雨，",
        "目极魂断望不见，猿啼三声泪滴衣。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 350806,
      "title": "车遥遥",
      "content": [
        "路喜到江尽，江上又通舟。",
        "舟车两无阻，何处不得游。",
        "丈夫四方志，女子安可留。",
        "郎自别日言，无令生远愁。",
        "旅雁忽叫月，断猿寒啼秋。",
        "此夕梦君梦，君在百城楼。",
        "寄泪无因波，寄恨无因辀。",
        "愿为驭者手，与郎回马头。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 350807,
      "title": "征妇怨",
      "content": [
        "良人昨日去，明月又不圆。",
        "别时各有泪，零落青楼前。",
        "君泪濡罗巾，妾泪满路尘。",
        "罗巾长在手，今得随妾身。",
        "路尘如得风，得上君车轮。",
        "渔阳千里道，近如中门限。",
        "中门逾有时，渔阳长在眼。",
        "生在绿罗下，不识渔阳道。",
        "良人自戍来，夜夜梦中到。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 350808,
      "title": "空城雀",
      "content": [
        "一雀入官仓，所食宁损几。",
        "只虑往覆频，官仓终害尔。",
        "鱼网不在天，鸟罗不张水。",
        "饮啄要自然，可以空城里。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 350813,
      "title": "游侠行",
      "content": [
        "壮士性刚决，火中见石裂。",
        "杀人不回头，轻生如暂别。",
        "岂知眼有泪，肯白头上发。",
        "半生无恩酬，剑闲一百月。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 350814,
      "title": "黄雀吟",
      "content": [
        "黄雀舞承尘，倚恃主人仁。",
        "主人忽不仁，买弹弹尔身。",
        "何不远飞去，蓬蒿正繁新。",
        "蒿粒无人争，食之足为珍。",
        "莫觑翻车粟，觑翻罪有因。",
        "黄雀不知言，赠之徒殷勤。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 350815,
      "title": "有所思",
      "content": [
        "桔槔烽火昼不灭，客路迢迢信难越。",
        "古镇刀攒万片霜，"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 350817,
      "title": "婵娟篇",
      "content": [
        "花婵娟，泛春泉。",
        "竹婵娟，笼晓烟。",
        "妓婵娟，不长妍。",
        "月婵娟，真可怜。",
        "夜半姮娥朝太一，人间本自无灵匹。",
        "汉宫承宠不多时，飞燕婕妤相妒嫉。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 350818,
      "title": "南浦篇",
      "content": [
        "南浦桃花亚水红，水边柳絮由春风。",
        "鸟鸣喈喈烟蒙蒙，"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 350819,
      "title": "清东曲",
      "content": [
        "樱桃花参差，香雨红霏霏。",
        "含笑竞攀折，美人湿罗衣。",
        "采采清东曲，明眸艳珪玉。",
        "青巾艑上郎，上下看不足。",
        "南阳公首词，编入新乐录。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 350820,
      "title": "望远曲",
      "content": [
        "朝朝候归信，日日登高台。",
        "行人未去植庭梅，",
        "愁来望远烟尘隔，空怜绿鬓风吹白。",
        "何当归见远行客。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 350821,
      "title": "织妇辞",
      "content": [
        "夫是田中郎，妾是田中女。",
        "当年嫁得君，为君秉机杼。",
        "筋力日已疲，不息窗下机。",
        "如何织纨素，自著蓝缕衣。",
        "官家榜村路，更索栽桑树。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 350823,
      "title": "折杨柳",
      "content": [
        "杨柳多短枝，短枝多别离。",
        "赠远屡攀折，柔条安得垂。",
        "青春有定节，离别无定时。",
        "但恐人别促，不怨来迟迟。",
        "莫言短枝条，中有长相思。",
        "朱颜与绿杨，并在别离期。",
        "楼上春风过，风前杨柳歌。",
        "枝疏缘别苦，曲怨为年多。",
        "花惊燕地云，叶映楚池波。",
        "谁堪别离此，征戍在交河。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 350827,
      "title": "戏赠陆大夫十二丈",
      "content": [
        "莲子不可得，荷花生水中。",
        "犹胜道傍柳，无事荡春风。",
        "渌萍与荷叶，同此一水中。",
        "风吹荷叶在，渌萍西复东。",
        "莲叶未开时，苦心终日卷。",
        "春水徒荡漾，荷花未开展。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 350828,
      "title": "劝善吟",
      "content": [
        "瘦郭有志气，相哀老龙钟。",
        "劝我少吟诗，俗窄难尔容。",
        "一口百味别，况在醉会中。",
        "四座正当喧，片言何由通。",
        "顾余昧时调，居止多疏慵。",
        "见书眼始开，闻乐耳不聪。",
        "视听互相隔，一身且莫同。",
        "天疾难自医，诗癖将何攻。",
        "见君如见书，语善千万重。",
        "自悲咄咄感，变作烦恼翁。",
        "烦恼不可欺，古剑涩亦雄。",
        "知君方少年，少年怀古风。",
        "藏书拄屋脊，不惜与凡聋。",
        "我愿拜少年，师之学崇崇。",
        "从他笑为矫，矫善亦可宗。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 350829,
      "title": "望夫石",
      "content": [
        "望夫石，夫不来兮江水碧。",
        "行人悠悠朝与暮，千年万年色如故。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 350830,
      "title": "寒江吟",
      "content": [
        "冬至日光白，始知阴气凝。",
        "寒江波浪冻，千里无平冰。",
        "飞鸟绝高羽，行人皆晏兴。",
        "荻洲素浩渺，埼岸澌崚嶒。",
        "烟舟忽自阻，风帆不相乘。",
        "何况异形体，信任为股肱。",
        "涉江莫涉凌，得意须得朋。",
        "结交非贤良，谁免生爱憎。",
        "冻水有再浪，失飞有载腾。",
        "一言纵丑词，万响无善应。",
        "取鉴谅不远，江水千万层。",
        "何当春风吹，利涉吾道弘。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 350833,
      "title": "百忧",
      "content": [
        "萱草女儿花，不解壮士忧。",
        "壮士心是剑，为君射斗牛。",
        "朝思除国雠，暮思除国雠。",
        "计尽山河画，意穷草木筹。",
        "智士日千虑，愚夫唯四愁。",
        "何必在波涛，然后惊沉浮。",
        "伯伦心不醉，四皓迹难留。",
        "出处各有时，众议徒啾啾。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 350837,
      "title": "退居",
      "content": [
        "退身何所食，败力不能闲。",
        "种稻耕白水，负薪斫青山。",
        "众听喜巴唱，独醒愁楚颜。",
        "日暮静归时，幽幽扣松关。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 350838,
      "title": "卧病",
      "content": [
        "贫病诚可羞，故床无新裘。",
        "春色烧肌肤，时餐苦咽喉。",
        "倦寝意蒙昧，强言声幽柔。",
        "承颜自俯仰，有泪不敢流。",
        "默默寸心中，朝愁续莫愁。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 350839,
      "title": "隐士",
      "content": [
        "本末一相返，漂浮不还真。",
        "山野多馁士，市井无饥人。",
        "虎豹忌当道，糜鹿知藏身。",
        "奈何贪竞者，日与患害亲。",
        "颜貌岁岁改，利心朝朝新。",
        "孰知富生祸，取富不取贫。",
        "宝玉忌出璞，出璞先为尘。",
        "松柏忌出山，出山先为薪。",
        "君子隐石壁，道书为我邻。",
        "寝兴思其义，澹泊味始真。",
        "陶公自放归，尚平去有依。",
        "草木择地生，禽鸟顺性飞。",
        "青青与冥冥，所保各不违。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 350842,
      "title": "将见故人",
      "content": [
        "故人季夏中，及此百余日。",
        "无日不相思，明镜改形色。",
        "宁知仲冬时，忽有相逢期。",
        "振衣起踯躅，赪鲤跃天池。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 350843,
      "title": "伤时",
      "content": [
        "常闻贫贱士之常，嗟尔富者莫相笑。",
        "男儿得路即荣名，",
        "劝人一种种桃李，种亦直须遍天地。",
        "一生不爱嘱人事，",
        "有财有势即相识，无财无势同路人。",
        "因知世事皆如此，"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 350848,
      "title": "长安早春",
      "content": [
        "旭日朱楼光，东风不惊尘。",
        "公子醉未起，美人争探春。",
        "探春不为桑，探春不为麦。",
        "日日出西园，只望花柳色。",
        "乃知田家春，不入五侯宅。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 350851,
      "title": "感怀",
      "content": [
        "秋气悲万物，惊风振长道。",
        "登高有所思，寒雨伤百草。",
        "平生有亲爱，零落不相保。",
        "五情今已伤，安得自能老。",
        "晨登洛阳阪，目极天茫茫。",
        "群物归大化，六龙颓西荒。",
        "豺狼日已多，草木日已霜。",
        "饥年无遗粟，众鸟去空场。",
        "路傍谁家子，白首离故乡。",
        "含酸望松柏，仰面诉穹苍。",
        "去去勿复道，苦饥形貌伤。",
        "徘徊不能寐，耿耿含酸辛。",
        "中夜登高楼，忆我旧星辰。",
        "四时互迁移，万物何时春。",
        "唯忆首阳路，永谢当时人。",
        "长安佳丽地，宫月生蛾眉。",
        "阴气凝万里，坐看芳草衰。",
        "玉堂有玄鸟，亦以从此辞。",
        "伤哉志士叹，故国多迟迟。",
        "深宫岂无乐，扰扰复何为。",
        "朝见名与利，莫还生是非。",
        "姜牙佐周武，世业永巍巍。",
        "举才天道亲，首阳谁采薇。",
        "去去荒泽远，落日当西归。",
        "羲和驻其轮，四海借余晖。",
        "极目何萧索，惊风正离披。",
        "鸱鸮鸣高树，众鸟相因依。",
        "东方有一士，岁暮常苦饥。",
        "主人数相问，脉脉今何为。",
        "贫贱亦有乐，且愿掩柴扉。",
        "火云流素月，三五何明明。",
        "光曜侵白日，贤愚迷至精。",
        "四时更变化，天道有亏盈。",
        "常恐今已没，须臾还复生。",
        "河梁暮相遇，草草不复言。",
        "汉家正离乱，王粲别荆蛮。",
        "野泽何萧条，悲风振空山。",
        "举头是星辰，念我何时还。",
        "亲爱久别散，形神各离迁。",
        "未为生死诀，长在心目间。",
        "有鸟东西来，哀鸣过我前。",
        "愿飞浮云外，饮啄见青天。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 350853,
      "title": "暮秋感思",
      "content": [
        "西风吹垂杨，条条脆如藕。",
        "上有噪日蝉，催人成皓首。",
        "亦恐旅步难，何独朱颜丑。",
        "欲慰一时心，莫如千日酒。",
        "优哉遵渚鸿，自得养身旨。",
        "不啄太仓粟，不饮方塘水。",
        "振羽戛浮云，罝罗任徒尔。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 350855,
      "title": "劝友",
      "content": [
        "至白涅不缁，至交淡不疑。",
        "人生静躁殊，莫厌相箴规。",
        "胶漆武可接，金兰文可思。",
        "堪嗟无心人，不如松柏枝。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 350856,
      "title": "夷门雪赠主人",
      "content": [
        "夷门贫士空吟雪，夷门豪士皆饮酒。",
        "酒声欢闲入雪销，"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 350857,
      "title": "尧歌",
      "content": [
        "尔室何不安，尔孝无与齐。",
        "一言应对姑，一度为出妻。",
        "往辙才晚钟，还辙及晨鸡。",
        "往还迹徒新，很戾竟独迷。",
        "娥女无礼数，污家如粪泥。",
        "父母吞声哭，禽鸟亦为啼。",
        "如何天与恶，不得和鸣栖。",
        "山色挽心肝，将归尽日看。",
        "村肩篮舆子，野坐白发官。",
        "莺弄方短短，花明碎攒攒。",
        "琉璃堆可掬，琴瑟饶多欢。",
        "翠韵仙窈窕，岚漪出无端。",
        "养馆洞庭秋，响答虚吹弹。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 350859,
      "title": "劝酒",
      "content": [
        "白日无定影，清江无定波。",
        "人无百年寿，百年复如何。",
        "堂上陈美酒，堂下列清歌。",
        "劝君金曲卮，勿谓朱颜酡。",
        "松柏岁岁茂，丘陵日日多。",
        "君看终南山，千古青峨峨。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 350861,
      "title": "君子勿郁郁士有谤毁者作诗以赠之",
      "content": [
        "君子勿郁郁，听我青蝇歌。",
        "人间少平地，森耸山岳多。",
        "折辀不在道，覆舟不在河。",
        "须知一尺水，日夜增高波。",
        "叔孙毁仲尼，臧仓掩孟轲。",
        "兰艾不同香，自然难为和。",
        "良玉烧不热，直竹文不颇。",
        "自古皆如此，其如道在何。",
        "日往复不见，秋堂暮仍学。",
        "玄发不知白，晓入寒铜觉。",
        "为林未离树，有玉犹在璞。",
        "谁把碧梧枝，刻作云门乐。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 350863,
      "title": "游子",
      "content": [
        "萱草生堂阶，游子行天涯。",
        "慈亲倚堂门，不见萱草花。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 350864,
      "title": "自叹",
      "content": [
        "愁与发相形，一愁白数茎。",
        "有发能几多，禁愁日日生。",
        "古若不置兵，天下无战争。",
        "古若不置名，道路无欹倾。",
        "太行耸巍峨，是天产不平。",
        "黄河奔浊浪，是天生不清。",
        "四蹄日日多，双轮日日成。",
        "二物不在天，安能免营营。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 350865,
      "title": "求友",
      "content": [
        "北风临大海，坚冰临河面。",
        "下有大波澜，对之无由见。",
        "求友须在良，得良终相善。",
        "求友若非良，非良中道变。",
        "欲知求友心，先把黄金炼。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 350866,
      "title": "投所知",
      "content": [
        "苦心知苦节，不容一毛发。",
        "炼金索坚贞，洗玉求明洁。",
        "自惭所业微，功用如鸠拙。",
        "何殊嫫母颜，对彼寒塘月。",
        "君存古人心，道出古人辙。",
        "尽美固可扬，片善亦不遏。",
        "朝向公卿说，暮向公卿说。",
        "谁谓黄钟管，化为君子舌。",
        "一说清嶰竹，二说变嶰谷。",
        "三说四说时，寒花拆寒木。",
        "晔晔家道路，灿灿我衣服。",
        "岂直辉友朋，亦用慰骨肉。",
        "一暖荷匹素，一饱荷升粟。",
        "而况大恩恩，此身报得足。",
        "且将食檗劳，酬之作金刀。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 350867,
      "title": "病客吟",
      "content": [
        "主人夜呻吟，皆入妻子心。",
        "客子昼呻吟，徒为虫鸟音。",
        "妻子手中病，愁思不复深。",
        "僮仆手中病，忧危独难任。",
        "丈夫久漂泊，神气自然沉。",
        "况于滞疾中，何人免嘘eS。",
        "大海亦有涯，高山亦有岑。",
        "沉忧独无极，尘泪互盈襟。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 350868,
      "title": "感怀",
      "content": [
        "孟冬阴气交，两河正屯兵。",
        "烟尘相驰突，烽火日夜惊。",
        "太行险阻高，挽粟输连营。",
        "奈何操弧者，不使枭巢倾。",
        "犹闻汉北儿，怙乱谋纵横。",
        "擅摇干戈柄，呼叫豺狼声。",
        "白日临尔躯，胡为丧丹诚。",
        "岂无感激士，以致天下平。",
        "登高望寒原，黄云郁峥嵘。",
        "坐驰悲风暮，叹息空沾缨。"
      ],
      "author": {
        "id": 9110,
        "name": "孟郊"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    }
