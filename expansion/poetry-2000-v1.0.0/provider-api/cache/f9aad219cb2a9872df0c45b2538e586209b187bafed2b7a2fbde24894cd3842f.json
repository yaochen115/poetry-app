{
  "data": [
    {
      "id": 255258,
      "title": "相和歌辞 江南曲",
      "content": [
        "妾住越城南，离居不自堪。",
        "采花惊曙鸟，摘叶𫗪春蚕。",
        "嬾结茱萸带，愁安玳瑁簪。",
        "侍臣消瘦尽，日暮碧江潭。"
      ],
      "author": {
        "id": 8710,
        "name": "宋之问"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 255337,
      "title": "相和歌辞 王子乔",
      "content": [
        "王子乔，爱神仙，七月七日上宾天。",
        "白虎摇瑟凤吹笙，乘骑云气吸日精。",
        "吸日精，长不归，遗庙今在而人非。",
        "空望山头草，草露湿君衣。"
      ],
      "author": {
        "id": 8710,
        "name": "宋之问"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 255825,
      "title": "琴曲歌辞 绿竹引",
      "content": [
        "青溪绿潭潭水侧，修竹婵娟同一色。",
        "徒生仙实凤不游，老死空山人讵识。",
        "妙年秉愿逃俗纷，归卧嵩丘弄白云。"
      ],
      "author": {
        "id": 8710,
        "name": "宋之问"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 277441,
      "title": "息夫人",
      "content": [
        "可怜楚破息，肠断息夫人。",
        "仍为泉下骨，不作楚王嫔。",
        "楚王宠莫盛，息君情更亲。",
        "情亲怨生别，一朝俱杀身。"
      ],
      "author": {
        "id": 8710,
        "name": "宋之问"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 277442,
      "title": "初到陆浑山庄",
      "content": [
        "授衣感穷节，策马凌伊关。",
        "归齐逸人趣，日觉秋琴闲。",
        "寒露衰北阜，夕阳破东山。",
        "浩歌步榛樾，栖鸟随我还。"
      ],
      "author": {
        "id": 8710,
        "name": "宋之问"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 277443,
      "title": "夜饮东亭",
      "content": [
        "春泉鸣大壑，皓月吐层岑。",
        "岑壑景色佳，慰我远游心。",
        "暗芳足幽气，惊栖多众音。",
        "高兴南山曲，长谣横素琴。"
      ],
      "author": {
        "id": 8710,
        "name": "宋之问"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 277444,
      "title": "芳树",
      "content": [
        "何地早芳菲，宛在长门殿。",
        "夭桃色若绶，秾李光如练。",
        "啼鸟弄花疎，游蜂饮香遍。",
        "叹息春风起，飘零君不见。"
      ],
      "author": {
        "id": 8710,
        "name": "宋之问"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 277445,
      "title": "送赵六贞固",
      "content": [
        "目断南浦云，心醉东郊柳。",
        "怨别此何时，春芳来已久。",
        "与君共时物，尽此盈樽酒。",
        "始愿今不从，春风恋携手。"
      ],
      "author": {
        "id": 8710,
        "name": "宋之问"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 277446,
      "title": "题张老松树",
      "content": [
        "岁晚东岩下，周顾何凄恻。",
        "日落西山阴，众草起寒色。",
        "中有乔松树，使我长叹息。",
        "百尺无寸枝，一生自孤直。"
      ],
      "author": {
        "id": 8710,
        "name": "宋之问"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 277447,
      "title": "别之望后独宿蓝田山庄",
      "content": [
        "鹡鸰有旧曲，调苦不成歌。",
        "自叹兄弟少，常嗟离别多。",
        "尔寻北京路，予卧南山阿。",
        "泉晚更幽咽，云秋尚嵯峨。",
        "药栏听蝉噪，书幌见禽过。",
        "愁至愿甘寝，其如乡梦何。"
      ],
      "author": {
        "id": 8710,
        "name": "宋之问"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 277448,
      "title": "浣纱篇赠陆上人",
      "content": [
        "越女颜如花，越王闻浣纱。",
        "国微不自宠，献作吴宫娃。",
        "山薮半潜匿，苎萝更蒙遮。",
        "一行霸句践，再笑倾夫差。",
        "艳色夺人目，敩嚬亦相夸。",
        "一朝还旧都，靓粧寻若耶。",
        "鸟惊入松网，鱼畏沈荷花。",
        "始觉冶容妄，方悟群心邪。",
        "钦子秉幽意，世人共称嗟。",
        "愿言托君怀，倘类蓬生麻。",
        "家住雷门曲，高阁凌飞霞。",
        "淋漓翠羽帐，旖旎采云军。",
        "春风艳楚舞，秋月缠胡笳。",
        "自昔专娇爱，袭玩唯矜奢。",
        "达本知空寂，弃彼犹泥沙。",
        "永割偏执性，自长薰修芽。",
        "携妾不障道，来止妾西家。"
      ],
      "author": {
        "id": 8710,
        "name": "宋之问"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 277449,
      "title": "雨从箕山来",
      "content": [
        "雨从箕山来，倏与飘风度。",
        "晴明西峰日，绿缛南溪树。",
        "此时客精庐，幸蒙真僧顾。",
        "深入清净理，妙断往来趣。",
        "意得两契如，言尽共忘喻。",
        "观花寂不动，闻鸟悬可悟。",
        "向夕闻天香，淹留不能去。"
      ],
      "author": {
        "id": 8710,
        "name": "宋之问"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 277450,
      "title": "初至崖口",
      "content": [
        "崖口众山断，嵚崟耸天壁。",
        "气冲落日红，影入春潭碧。",
        "锦缋织苔藓，丹青画松石。",
        "水禽泛容与，岩花飞的皪。",
        "微路从此深，我来限于役。",
        "惆怅情未已，群峰暗将夕。"
      ],
      "author": {
        "id": 8710,
        "name": "宋之问"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 277451,
      "title": "自湘源至潭州衡山县",
      "content": [
        "浮湘沿迅湍，逗浦凝远盼。",
        "渐见江势阔，行嗟水流漫。",
        "赤岸杂云霞，绿竹缘溪涧。",
        "向背群山转，应接良景晏。",
        "沓障连夜猿，平沙覆阳雁。",
        "纷吾望阙客，归桡速已惯。",
        "中道方溯洄，迟念自兹撰。",
        "赖欣衡阳美，持以蠲忧患。"
      ],
      "author": {
        "id": 8710,
        "name": "宋之问"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 277452,
      "title": "入崖口五渡寄李适",
      "content": [
        "抱琴登绝壑，伐木溯清川。",
        "路极意谓尽，势回趣转绵。",
        "人远草木秀，山深云景鲜。",
        "余负海峤情，自昔微尚然。",
        "弥旷十余载，今来宛仍前。",
        "未窥仙源极，独进野人船。",
        "时攀乳窦憩，屡薄天窗眠。",
        "夜弦响松月，朝楫弄苔泉。",
        "因冥象外理，永谢区中缘。",
        "碧潭可遗老，丹砂堪学仙。",
        "莫使驰光暮，空令归鹤怜。"
      ],
      "author": {
        "id": 8710,
        "name": "宋之问"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 277453,
      "title": "洞庭湖",
      "content": [
        "地尽天水合，朝及洞庭湖。",
        "初日当中涌，莫辨东西隅。",
        "晶耀目何在，滢荧心欲无。",
        "灵光晏海若，游气耿天吴。",
        "张乐轩皇至，征苗夏禹徂。",
        "楚臣悲落叶，尧女泣苍梧。",
        "野积九江润，山通五岳图。",
        "风恬鱼自跃，云夕雁相呼。",
        "独此临泛漾，浩将人代殊。",
        "永言洗氛浊，卒岁为清娱。",
        "要使功成退，徒劳越大夫。"
      ],
      "author": {
        "id": 8710,
        "name": "宋之问"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 277454,
      "title": "景龙四年春祠海",
      "content": [
        "肃事祠春溟，宵斋洗蒙虑。",
        "鸡鸣见日出，鹭下惊涛鹜。",
        "地阔八荒近，天回百川澍。",
        "筵端接空曲，目外唯雰雾。",
        "暖气物象来，周游晦明互。",
        "致牲匪玄享，禋涤期灵煦。",
        "的的波际禽，沄沄岛间树。",
        "安期今何在，方丈蔑寻路。",
        "仙事与世隔，冥搜徒已屡。",
        "四明背群山，遗老莫辨处。",
        "抚中良自慨，弱龄忝恩遇。",
        "三入文史林，两拜神仙署。",
        "虽叹出关远，始知临海趣。",
        "赏来空自多，理胜孰能喻。",
        "留楫竟何待，徙倚忽云暮。"
      ],
      "author": {
        "id": 8710,
        "name": "宋之问"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 277455,
      "title": "温泉庄卧病寄杨七炯",
      "content": [
        "移疾卧兹岭，寥寥倦幽独。",
        "赖有嵩丘山，高枕长在目。",
        "兹山栖灵异，朝夜翳云族。",
        "是日蒙雨晴，返景入岩谷。",
        "幂幂涧畔草，青青山下木。",
        "此意方无穷，环顾怅林麓。",
        "伊洛何悠漫，川原信重复。",
        "夏余鸟兽蕃，秋末禾黍熟。",
        "秉愿守樊圃，归闲欣艺牧。",
        "惜无载酒人，徒把凉泉掬。"
      ],
      "author": {
        "id": 8710,
        "name": "宋之问"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 277456,
      "title": "荅田征君",
      "content": [
        "家临清溪水，溪水绕盘石。",
        "绿萝四面垂，褭褭百余尺。",
        "风泉度丝管，苔藓铺茵席。",
        "传闻颍阳人，霞外漱灵液。",
        "忽枉岩中翰，吟望朝复夕。",
        "何当遂远游，物色候逋客。"
      ],
      "author": {
        "id": 8710,
        "name": "宋之问"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 277457,
      "title": "自衡阳至韶州谒能禅师",
      "content": [
        "谪居窜炎壑，孤帆淼不系。",
        "别家万里余，流目三春际。",
        "猿啼山馆晓，虹饮江皐霁。",
        "湘岸竹泉幽，衡峰石囷闭。",
        "岭嶂穷攀越，风涛极沿济。",
        "吾师在韶阳，欣此得躬诣。",
        "洗虑宾空寂，焚香结精誓。",
        "愿以有漏躯，聿薰无生慧。",
        "物用益冲旷，心源日闲细。",
        "伊我获此途，游道回晚计。",
        "宗师信舍法，摈落文史艺。",
        "坐禅罗浮中，寻异穷海裔。",
        "何辞御魑魅，自可乘炎疠。",
        "回首望旧乡，云林浩亏蔽。",
        "不作离别苦，归期多年岁。"
      ],
      "author": {
        "id": 8710,
        "name": "宋之问"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 277458,
      "title": "见南山夕阳召监师不至",
      "content": [
        "夕阳黯晴碧，山翠互明灭。",
        "此中意无限，要与开士说。",
        "徒郁仲举思，讵回道林辙。",
        "孤兴欲待谁，待此湖上月。"
      ],
      "author": {
        "id": 8710,
        "name": "宋之问"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 277459,
      "title": "游法华寺",
      "content": [
        "薄游京都日，遥羡稽山名。",
        "分刺江海郡，朅来征素情。",
        "松露洗心眷，象筵敷念诚。",
        "薄云界青嶂，皎日鶱朱甍。",
        "苔涧深不测，竹房闲且清。",
        "感真六象见，垂兆二𪅝鸣。",
        "古今信灵迹，中州莫与京。",
        "林𪩘永栖业，岂伊佐一生。",
        "浮悟虽已久，事试去来成。",
        "观念幸相续，庶几最后明。"
      ],
      "author": {
        "id": 8710,
        "name": "宋之问"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 277460,
      "title": "宿云门寺",
      "content": [
        "云门若邪里，泛鹢路才通。",
        "夤缘绿筿岸，遂得青莲宫。",
        "天香众壑满，夜梵前山空。",
        "漾漾潭际月，飔飗杉上风。",
        "兹焉多嘉遯，数子今莫同。",
        "凤归慨处士，鹿化闻仙公。",
        "樵路郑州北，举井阿岩东。",
        "永夜岂云寐，曙华忽葱茏。",
        "谷鸟啭尚涩，源桃惊未红。",
        "再来期春暮，当造林端穷。",
        "庶几踪谢客，开山投剡中。"
      ],
      "author": {
        "id": 8710,
        "name": "宋之问"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 277461,
      "title": "春湖古意",
      "content": [
        "院梅发向尺，园鸟复成曲。",
        "落日游南湖，果掷颜如玉。",
        "含情不得语，转盼知所属。",
        "惆怅未可归，宁关须采菉。"
      ],
      "author": {
        "id": 8710,
        "name": "宋之问"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 277462,
      "title": "游陆浑南山自歇马岭到枫香林以诗代书荅李舍人适",
      "content": [
        "晨登歇马岭，遥望伏牛山。",
        "孤出群峰首，熊熊元气间。",
        "太和亦崔嵬，石扇横闪倏。",
        "细岑互攒倚，浮𪩘竞奔蹙。",
        "白云遥入怀，青霭近可掬。",
        "徒寻灵异迹，周顾惬心目。",
        "晨拂鸟路行，暮投人烟宿。",
        "稉稻远弥秀，栗芋秋新熟。",
        "石髓非一岩，药苗乃万族。",
        "间关踏云雨，缭绕缘水木。",
        "西见商山芝，南到楚乡竹。",
        "楚竹幽且深，半杂枫香林。",
        "浩歌清潭曲，寄尔桃源心。"
      ],
      "author": {
        "id": 8710,
        "name": "宋之问"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 277463,
      "title": "早发大庾岭",
      "content": [
        "晨跻大庾险，驿鞍驰复息。",
        "雾露昼未开，浩途不可测。",
        "嵥起华夷界，信为造化力。",
        "歇鞍问徒旅，乡关在西北。",
        "出门怨别家，登岭恨辞国。",
        "自惟勗忠孝，斯罪懵所得。",
        "皇明颇照洗，延议日纷惑。",
        "兄弟远沦居，妻子成异域。",
        "羽翮伤已毁，童幼怜未识。",
        "踌蹰恋北顾，亭午晞霁色。",
        "春煖阴梅花，瘴回阳鸟翼。",
        "含沙缘涧聚，吻草依林植。",
        "适蛮悲疾首，怀巩泪沾臆。",
        "感谢鹓鹭朝，勤修魑魅职。",
        "生还倘非远，誓拟酬恩德。"
      ],
      "author": {
        "id": 8710,
        "name": "宋之问"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 277464,
      "title": "自洪府舟行直书其事",
      "content": [
        "仲春辞国门，畏途横万里。",
        "越淮乘楚嶂，造江泛吴汜。",
        "严程无休隙，日夜涉风水。",
        "昔闻垂堂言，将诫千金子。",
        "问余何奇剥，迁窜极炎鄙。",
        "揆己道德余，幼闻虚白旨。",
        "贵身贱外物，抗迹远尘轨。",
        "朝游伊水湄，夕卧箕山趾。",
        "妙年拙自晦，皎洁弄文史。",
        "谬辱紫泥书，挥翰青云里。",
        "事往每增伤，宠来常誓止。",
        "铭骨怀报称，逆鳞让金紫。",
        "安位衅潜搆，退耕祸犹起。",
        "栖岩实吾策，触藩诚内耻。",
        "济济同时人，台庭鸣劒履。",
        "愚以卑自衞，兀坐去沈滓。",
        "迨兹理已极，窃位申知己。",
        "群议负宿心，获戾光华始。",
        "黄金忽销铄，素业坐沦毁。",
        "浩叹诬平生，何独恋枌梓。",
        "浦树浮郁郁，皐兰覆靡靡。",
        "百越去魂断，九疑望心死。",
        "未尽匡阜游，远欣罗浮美。",
        "周旋本师训，佩服无生理。",
        "异国多灵仙，幽探忘年纪。",
        "敝庐嵩山下，空谷茂兰芷。",
        "悠悠南溟远，采掇长已矣。"
      ],
      "author": {
        "id": 8710,
        "name": "宋之问"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 277465,
      "title": "下桂江县黎壁",
      "content": [
        "放溜觌前溆，连山分上干。",
        "江回云壁转，天小雾峰攒。",
        "吼沫跳急浪，合流环峻滩。",
        "欹离出漩划，缭绕避涡盘。",
        "舟子怯桂水，最言斯路难。",
        "吾生抱忠信，吟啸自安闲。",
        "旦别已千岁，夜愁劳万端。",
        "企予见夜月，委曲破林峦。",
        "潭旷竹烟尽，洲香橘露团。",
        "岂傲夙所好，对之与俱欢。",
        "思君罢琴酌，泣此夜漫漫。"
      ],
      "author": {
        "id": 8710,
        "name": "宋之问"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 277466,
      "title": "奉使嵩山途经缑岭",
      "content": [
        "侵星发洛城，城中歌吹声。",
        "毕景至缑岭，岭上烟霞生。",
        "草树饶野意，山川多古情。",
        "大隐德所薄，归来可退耕。"
      ],
      "author": {
        "id": 8710,
        "name": "宋之问"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 277467,
      "title": "伤王七秘书监寄呈扬州陆长史通简府僚广陵以广好事",
      "content": [
        "王氏贵先宗，衡门栖道风。",
        "传心晤有物，秉化游无穷。",
        "学奥九流异，机玄三语同。",
        "书乃墨场绝，文称词伯雄。",
        "白屋藩魏主，苍生期谢公。",
        "一祗贤良诏，遂谒承明宫。",
        "补衮望奚塞，尊儒位未充。",
        "罢官七门里，归老一丘中。",
        "尝忝长者辙，微言私谓通。",
        "我行会稽郡，路出广陵东。",
        "物在人已矣，都疑淮海空。"
      ],
      "author": {
        "id": 8710,
        "name": "宋之问"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 277468,
      "title": "使至嵩山寻杜四不遇慨然复伤田洗马韩观主因以题壁赠杜侯杜四",
      "content": [
        "洛桥瞻太室，期子在云烟。",
        "归来不相见，孤赏弄寒泉。",
        "与君阔松石，于兹二十年。",
        "田公谢昭世，韩子秘幽埏。",
        "忆昔同携手，山栖接二贤。",
        "笙歌入玄地，诗酒坐寥天。",
        "旧友悉零落，罢琴私自怜。",
        "逝者非药误，餐霞意可全。",
        "为余理还策，相与事灵仙。"
      ],
      "author": {
        "id": 8710,
        "name": "宋之问"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 277469,
      "title": "翫郡斋海榴",
      "content": [
        "泽国韶气早，开帘延霁天。",
        "野禽宵未啭，山蜚昼仍眠。",
        "目兹海榴发，列暎岩楹前。",
        "熠爚御风静，葳蕤含景鲜。",
        "清晨绿堪佩，亭午丹欲然。",
        "昔忝金闺籍，尝见玉池莲。",
        "未若宗族地，更逢荣耀全。",
        "南金虽自贵，贺赏讵能迁。",
        "抚躬万里绝，岂染一朝妍。",
        "徒缘滞遐郡，常是惜流年。",
        "越俗鄙章甫，扪心空自怜。"
      ],
      "author": {
        "id": 8710,
        "name": "宋之问"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 277470,
      "title": "长安路",
      "content": [
        "秦地平如掌，层城出云汉。",
        "楼阁九衢春，车马千门旦。",
        "绿柳开复合，红尘聚还散。",
        "日晚鬬鸡场，经过狭斜看。"
      ],
      "author": {
        "id": 8710,
        "name": "宋之问"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 277471,
      "title": "折杨柳",
      "content": [
        "玉树朝日映，罗帐春风吹。",
        "拭泪攀杨柳，长条宛地垂。",
        "白花飞历乱，黄鸟思参差。",
        "妾自肝肠断，傍人那得知。"
      ],
      "author": {
        "id": 8710,
        "name": "宋之问"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 277472,
      "title": "有所思",
      "content": [
        "君子事行役，再空芳岁期。",
        "美人旷遥伫，万里浮云思。",
        "园桃绽红艳，郊叶柔绿滋。",
        "坐看长夏晚，秋月生罗帷。"
      ],
      "author": {
        "id": 8710,
        "name": "宋之问"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 277473,
      "title": "军中人日登高赠房明府",
      "content": [
        "幽郊昨夜阴风断，顿觉朝来阳吹暖。",
        "泾水桥南柳欲黄，杜陵城北花应满。",
        "长安昨夜寄春衣，短翮登兹一望归。",
        "闻道凯旋乘骑入，看君走马见芳菲。"
      ],
      "author": {
        "id": 8710,
        "name": "宋之问"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 277474,
      "title": "寒食还陆浑别业",
      "content": [
        "洛阳城里花如雪，陆浑山中今始发。",
        "旦别河桥杨柳风，夕卧伊川桃李月。",
        "伊川桃李正芳新，寒食山中酒复春。",
        "野老不知尧舜力，酣歌一曲太平人。"
      ],
      "author": {
        "id": 8710,
        "name": "宋之问"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 277475,
      "title": "寒食江州满塘驿",
      "content": [
        "去年上巳洛桥边，今年寒食庐山曲。",
        "遥怜巩树花应满，复见吴洲草新绿。",
        "吴洲春草兰杜芳，感物思归怀故乡。",
        "驿骑明朝宿何处？",
        "猿声今夜断君肠。"
      ],
      "author": {
        "id": 8710,
        "name": "宋之问"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 277476,
      "title": "至端州驿见杜五审言沈三佺期阎五朝隐王二无竞题壁慨然成咏",
      "content": [
        "逐臣北地承严谴，谓到南中每相见。",
        "岂意南中岐路多，千山万水分乡县。",
        "云摇雨散各翻飞，海阔天长音信稀。",
        "处处山川同瘴疠，自怜能得几人归。"
      ],
      "author": {
        "id": 8710,
        "name": "宋之问"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 277477,
      "title": "绿竹引",
      "content": [
        "青溪绿潭潭水侧，修竹婵娟同一色。",
        "徒生僊实凤不游，老死空山人讵识。",
        "妙年秉愿逃俗纷，归卧嵩丘弄白云。",
        "含情傲睨慰心目，何可一日无此君。"
      ],
      "author": {
        "id": 8710,
        "name": "宋之问"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 277478,
      "title": "明河篇",
      "content": [
        "八月凉风天气晶，万里无云河汉明。",
        "昏见南楼清且浅，晓落西山纵复横。",
        "洛阳城阙天中起，长河夜夜千门里。",
        "复道连甍共蔽亏，画堂琼户特相宜。",
        "云母帐前初泛滥，水精帘外转逶迤。",
        "倬彼昭回如练白，复出东城接南陌。",
        "南陌征人去不归，谁家今夜捣寒衣。",
        "鸳鸯机上疎萤度，乌鹊桥边一雁飞。",
        "雁飞萤度愁难歇，坐见明河渐微没。",
        "已能舒卷任浮云，不惜光辉让流月。",
        "明河可望不可亲，愿得乘槎一问津。",
        "更将织女支机石，还访成都卖卜人。"
      ],
      "author": {
        "id": 8710,
        "name": "宋之问"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 277479,
      "title": "龙门应制",
      "content": [
        "宿雨霁氛埃，流云度城阙。",
        "河堤柳新翠，苑树花先发。",
        "洛阳花柳此时浓，山水楼台暎几重。",
        "群公拂雾朝翔凤，天子乘春幸凿龙。",
        "凿龙近出王城外，羽从琳琅拥轩盖。",
        "云罕才临御水桥，天衣已入香山会。",
        "山壁崭岩断复连，清流澄澈俯伊川。",
        "雁塔遥遥绿波上，星龛奕奕翠微边。",
        "层峦旧长千寻木，远壑初飞百丈泉。",
        "彩仗蜺旌遶香阁，下辇登高望河洛。",
        "东城宫阙拟昭回，南陌沟塍殊绮错。",
        "林下天香七宝台，山中春酒万年杯。",
        "微风一起祥花落，仙乐初鸣瑞鸟来。",
        "鸟来花落纷无已，称觞献寿烟霞里。",
        "歌舞淹留景欲斜，石关犹驻五云车。",
        "鸟旗翼翼留芳草，龙骑骎骎暎晚花。",
        "千乘万骑銮舆出，水静山空严警跸。",
        "郊外喧喧引看人，倾都南望属车尘。",
        "嚣声引飏闻黄道，佳气周回入紫宸。",
        "先王定鼎山河固，宝命乘周万物新。",
        "吾皇不事瑶池乐，时雨来观农扈春。"
      ],
      "author": {
        "id": 8710,
        "name": "宋之问"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 277480,
      "title": "初宿淮口",
      "content": [
        "孤舟汴河水，去国情无已。",
        "晚泊投楚乡，明月清淮里。",
        "汴河东泻路穷兹，洛阳西顾日增悲。",
        "夜闻楚歌思欲断，况值淮南木落时。"
      ],
      "author": {
        "id": 8710,
        "name": "宋之问"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 277481,
      "title": "王子乔",
      "content": [
        "王子乔，爱神仙，七月七日上宾天。",
        "白虎摇瑟凤吹笙，乘骑云气吸日精。",
        "吸日精，长不归，遗庙今在而人非。",
        "空望山头草，草露湿人衣。"
      ],
      "author": {
        "id": 8710,
        "name": "宋之问"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 277482,
      "title": "放白鹇篇",
      "content": [
        "故人赠我绿绮琴，兼致白鹇鸟。",
        "琴是峄山桐，鸟出吴溪中。",
        "我心松石清霞里，弄此幽弦不能已。",
        "我心河海白云垂，怜此珍禽空自知。",
        "著书晚下麒麟阁，幼稚骄痴候门乐。",
        "乃言物性不可违，白鹇愁慕刷毛衣。",
        "玉徽闭匣留为念，六翮开笼任尔飞。"
      ],
      "author": {
        "id": 8710,
        "name": "宋之问"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 277483,
      "title": "桂州三月三日",
      "content": [
        "代业京华里，远投魑魅乡。",
        "登高望不极，云海四茫茫。",
        "伊昔承休盼，曾为人所羡。",
        "两朝赐颜色，二纪陪欢宴。",
        "昆明御宿侍龙媒，伊阙天泉复几回。",
        "西夏黄河水心劒，东周清洛羽觞杯。",
        "苑中落花扫还合，河畔垂杨拨不开。",
        "千春万寿多行乐，柏梁和歌攀睿作。",
        "赐金分帛奉恩辉，风举云摇入紫微。",
        "晨趋北阙鸣珂至，夜出南宫把烛归。",
        "载笔儒林多岁月，幞被文昌佐吴越。",
        "越中山海高且深，兴来无处不登临。",
        "永和九年刺海郡，暮春三月醉山阴。",
        "愚谓嬉游长似昔，不言流寓歘成今。",
        "始安繁华旧风俗，帐饮倾城沸江曲。",
        "主人丝管清且悲，客子肝肠断还续。",
        "荔浦蘅皐万里余，洛阳音信绝能疎。",
        "故园今日应愁思，曲水何能更祓除。",
        "逐伴谁怜合浦叶，思归岂食桂江鱼。",
        "不求汉使金囊赠，愿得佳人锦字书。"
      ],
      "author": {
        "id": 8710,
        "name": "宋之问"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 277484,
      "title": "下山歌",
      "content": [
        "下嵩山兮多所思，携佳人兮步迟迟。",
        "松间明月长如此，君再游兮复何时。"
      ],
      "author": {
        "id": 8710,
        "name": "宋之问"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 277485,
      "title": "冬宵引赠司马承祯",
      "content": [
        "河有冰兮山有雪，北户墐兮行人绝。",
        "独坐山中兮对松月，怀美人兮屡盈缺。",
        "明月的的寒潭中，青松幽幽吟劲风。",
        "此情不向俗人说，爱而不见恨无穷。"
      ],
      "author": {
        "id": 8710,
        "name": "宋之问"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 277486,
      "title": "高山引",
      "content": [
        "攀云窈窕兮上跻悬峰，长路浩浩兮此去何从。",
        "水一曲兮肠一曲，山一重兮悲一重。",
        "松槚邈已远，友于何日逢？",
        "况满室兮童稚，攒众虑于心胷。",
        "天高难诉兮远负明德，却望咸京兮挥涕龙钟。"
      ],
      "author": {
        "id": 8710,
        "name": "宋之问"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 277487,
      "title": "嵩山天门歌",
      "content": [
        "登天门兮坐盘石之磷𥒘，前漎漎兮未半，下漠漠兮无垠。",
        "纷窈窕兮岩倚披以鹏翅，洞胶葛兮峰棱层以龙鳞。",
        "松移岫转，左变而右易。",
        "风生云起，出鬼而入神。",
        "吾亦不知其灵怪如此，愿游杳冥兮见羽人。",
        "重曰：天门兮穹崇，回合兮攒藂。",
        "松万接兮柱日，石千寻兮倚空。",
        "晚阴兮足风，夕阳兮赩红。",
        "试一望兮夺魄，况众妙之无穷。"
      ],
      "author": {
        "id": 8710,
        "name": "宋之问"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 277488,
      "title": "有所思",
      "content": [
        "洛阳城东桃李花，飞来飞去落谁家。",
        "幽闺女儿惜颜色，坐见落花长叹息。",
        "今年花落颜色改，明年花开复谁在。",
        "已见松柏摧为薪，更闻桑田变成海。",
        "古人无复洛城东，今人还对落花风。",
        "年年岁岁花相似，岁岁年年人不同。",
        "寄言全盛红颜子，须怜半死白头翁。",
        "此翁白头真可怜，伊昔红颜美少年。",
        "公子王孙芳树下，清歌妙舞落花前。",
        "光禄池台交锦绣，将军楼阁画神仙。",
        "一朝卧病无相识，三春行乐在谁边。",
        "婉转蛾眉能几时，须臾鹤发乱如丝。",
        "但看古来歌舞地，唯有黄昏鸟雀飞。"
      ],
      "author": {
        "id": 8710,
        "name": "宋之问"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 277489,
      "title": "奉和立春日侍宴内出剪彩花应制",
      "content": [
        "金阁粧新杏，琼筵弄绮梅。",
        "人间都未识，天上忽先开。",
        "蜨绕香丝住，蜂怜艳粉回。",
        "今年春色早，应为剪刀催。"
      ],
      "author": {
        "id": 8710,
        "name": "宋之问"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 277490,
      "title": "春日芙蓉园侍宴应制",
      "content": [
        "芙蓉秦地沼，卢橘汉家园。",
        "谷转斜盘径，川回曲抱原。",
        "风来花自舞，春入鸟能言。",
        "侍宴瑶池夕，归途笳吹繁。"
      ],
      "author": {
        "id": 8710,
        "name": "宋之问"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 277491,
      "title": "夏日仙蕚亭应制",
      "content": [
        "高岭逼星河，乘舆此日过。",
        "野含时雨润，山杂夏云多。",
        "睿藻光岩穴，宸襟洽薜萝。",
        "悠然小天下，归路满笙歌。"
      ],
      "author": {
        "id": 8710,
        "name": "宋之问"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 277492,
      "title": "奉和九月九日登慈恩寺浮屠应制",
      "content": [
        "凤刹侵云半，虹旌倚日边。",
        "散花多宝塔，张乐布金田。",
        "时菊芳仙酝，秋兰动睿篇。",
        "香街稍欲晚，清跸扈归天。"
      ],
      "author": {
        "id": 8710,
        "name": "宋之问"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 277493,
      "title": "奉和九日幸临渭亭登高应制得欢字",
      "content": [
        "令节三秋晚，重阳九日欢。",
        "仙杯还泛菊，宝馔且调兰。",
        "御气云霄近，乘高宇宙宽。",
        "今朝万寿引，宜向曲中弹。"
      ],
      "author": {
        "id": 8710,
        "name": "宋之问"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 277494,
      "title": "奉和圣制闰九月九日登庄严总持二寺阁",
      "content": [
        "闰月再重阳，仙舆历宝坊。",
        "帝歌云稍白，御酒菊犹黄。",
        "风铎喧行漏，天花拂舞行。",
        "豫游多景福，梵宇日生光。"
      ],
      "author": {
        "id": 8710,
        "name": "宋之问"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 277495,
      "title": "麟趾殿侍宴应制",
      "content": [
        "北阙层城峻，西宫复道悬。",
        "乘舆历万户，置酒望三川。",
        "花柳含丹日，山河入绮筵。",
        "欲知陪赏处，空外有飞烟。"
      ],
      "author": {
        "id": 8710,
        "name": "宋之问"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 277496,
      "title": "上阳宫侍宴应制得林字",
      "content": [
        "广乐张前殿，重裘感圣心。",
        "砌蓂霜月尽，庭树雪云深。",
        "旧渥骖宸御，慈恩忝翰林。",
        "微臣一何幸，再得听瑶琴。"
      ],
      "author": {
        "id": 8710,
        "name": "宋之问"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 277497,
      "title": "幸少林寺应制",
      "content": [
        "绀宇横天室，回銮指帝休。",
        "曙阴迎日尽，春气抱岩流。",
        "空乐繁行漏，香烟薄彩斿。",
        "玉膏从此泛，仙驭接浮丘。"
      ],
      "author": {
        "id": 8710,
        "name": "宋之问"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 277498,
      "title": "幸岳寺应制",
      "content": [
        "𫏐幸珠筵地，俱怜石濑清。",
        "泛流张翠幕，拂迥挂红旌。",
        "雅曲龙调管，芳樽蚁泛觥。",
        "陪欢玉座晚，复得听金声。"
      ],
      "author": {
        "id": 8710,
        "name": "宋之问"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 277499,
      "title": "扈从登封途中作",
      "content": [
        "帐殿郁崔嵬，仙游实壮哉。",
        "晓云连幕卷，夜火杂星回。",
        "谷暗千旗出，山鸣万乘来。",
        "扈从良可赋，终乏掞天才。"
      ],
      "author": {
        "id": 8710,
        "name": "宋之问"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 277500,
      "title": "扈从登封告成颂",
      "content": [
        "复道开行殿，钩陈列禁兵。",
        "和风吹鼓角，佳气动旗旌。",
        "后骑回天苑，前山入御营。",
        "万方俱下拜，相与乐升平。"
      ],
      "author": {
        "id": 8710,
        "name": "宋之问"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 277501,
      "title": "松山岭应制",
      "content": [
        "翼翼高旌转，锵锵凤辇飞。",
        "尘销清跸路，云湿从臣衣。",
        "白羽摇丹壑，天营逼翠微。",
        "芳声耀今古，四海警宸威。"
      ],
      "author": {
        "id": 8710,
        "name": "宋之问"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 277502,
      "title": "缑山庙",
      "content": [
        "王子宾仙去，飘飖笙鹤飞。",
        "徒闻沧海变，不见白云归。",
        "天路何其远，人间此会稀。",
        "空歌日云暮，霜月渐微微。"
      ],
      "author": {
        "id": 8710,
        "name": "宋之问"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 277503,
      "title": "奉和梁王宴龙泓应教得微字",
      "content": [
        "水府沦幽壑，星轺下紫微。",
        "鸟惊司仆驭，花落侍臣衣。",
        "芳树摇春晚，晴云绕座飞。",
        "淮王正留客，不醉莫言归。"
      ],
      "author": {
        "id": 8710,
        "name": "宋之问"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 277504,
      "title": "寿阳王花烛图",
      "content": [
        "仙媛乘龙日，天孙捧雁来。",
        "可怜桃李树，更绕凤皇台。",
        "烛照香车入，花临宝扇开。",
        "莫令银箭晓，为尽合欢杯。"
      ],
      "author": {
        "id": 8710,
        "name": "宋之问"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 277505,
      "title": "江南曲",
      "content": [
        "妾住越城南，离居不自堪。",
        "采花惊曙鸟，摘叶𫗪春蚕。",
        "懒结茱萸带，愁安玳瑁簪。",
        "待君消瘦尽，日暮碧江潭。"
      ],
      "author": {
        "id": 8710,
        "name": "宋之问"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 277506,
      "title": "牛女",
      "content": [
        "粉席秋期缓，针楼别怨多。",
        "奔龙争渡月，飞鹊乱填河。",
        "失喜先临镜，含羞未解罗。",
        "谁能留夜色，来夕倍还梭。"
      ],
      "author": {
        "id": 8710,
        "name": "宋之问"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 277507,
      "title": "冬夜寓直麟阁",
      "content": [
        "直事披三省，重关闭七门。",
        "广庭怜雪净，深屋喜炉温。",
        "月幌花虚馥，风窗竹暗喧。",
        "东山白云意，兹夕寄琴尊。"
      ],
      "author": {
        "id": 8710,
        "name": "宋之问"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 277508,
      "title": "登禅定寺阁",
      "content": [
        "梵宇出三天，登临望八川。",
        "开襟坐霄汉，挥手拂云烟。",
        "函谷青山外，昆池落日边。",
        "东京杨柳陌，少别已经年。"
      ],
      "author": {
        "id": 8710,
        "name": "宋之问"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 277509,
      "title": "陆浑山庄",
      "content": [
        "归来物外情，负杖阅岩耕。",
        "源水看花入，幽林采药行。",
        "野人相问姓，山鸟自呼名。",
        "去去独吾乐，无然愧此生。"
      ],
      "author": {
        "id": 8710,
        "name": "宋之问"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 277510,
      "title": "蓝田山庄",
      "content": [
        "宦游非吏隐，心事好幽偏。",
        "考室先依地，为农且用天。",
        "辋川朝伐木，蓝水暮浇田。",
        "独与秦山老，相欢春酒前。"
      ],
      "author": {
        "id": 8710,
        "name": "宋之问"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 277511,
      "title": "春日山家",
      "content": [
        "今日游何处？",
        "春泉洗药归。",
        "悠然紫芝曲，昼掩白云扉。",
        "鱼乐偏寻藻，人闲屡采薇。",
        "丘中无俗事，身世两相违。"
      ],
      "author": {
        "id": 8710,
        "name": "宋之问"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 277512,
      "title": "春日宴宋主簿山亭得寒字",
      "content": [
        "公子正邀欢，林亭春未兰。",
        "攀岩践苔易，迷路出花难。",
        "窗覆垂杨煖，阶侵瀑水寒。",
        "帝城归路直，留兴接鹓鸾。"
      ],
      "author": {
        "id": 8710,
        "name": "宋之问"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 277513,
      "title": "江亭晚望",
      "content": [
        "浩渺浸云根，烟岚出远村。",
        "鸟归沙有迹，帆过浪无痕。",
        "望水知柔性，看山欲断魂。",
        "纵情犹未已，回马欲黄昏。"
      ],
      "author": {
        "id": 8710,
        "name": "宋之问"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 277514,
      "title": "秋晚游普耀寺",
      "content": [
        "薄暮曲江头，仁祠暂可留。",
        "山形无隐霁，野色徧呈秋。",
        "荷覆香泉密，藤缘宝树幽。",
        "平生厌尘事，过此忽悠悠。"
      ],
      "author": {
        "id": 8710,
        "name": "宋之问"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 277515,
      "title": "答李司户夔",
      "content": [
        "远方来下客，輶轩摄使臣。",
        "弄琴宜在夜，倾酒贵逢春。",
        "驷马留孤馆，双鱼赠故人。",
        "明朝散云雨，遥仰德为邻。"
      ],
      "author": {
        "id": 8710,
        "name": "宋之问"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 277516,
      "title": "寄天台司马道士",
      "content": [
        "卧来生白发，览镜忽成丝。",
        "远愧餐霞子，童颜且自持。",
        "旧游惜疎旷，微尚日磷缁。",
        "不寄西山药，何由东海期。"
      ],
      "author": {
        "id": 8710,
        "name": "宋之问"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 277517,
      "title": "使往天平军马约与陈子昂新乡为期及还而不相遇",
      "content": [
        "入衞期之子，吁嗟不少留。",
        "情人去何处？",
        "淇水日悠悠。",
        "恒碣青云断，衡漳白露秋。",
        "知君心许国，不是爱封侯。"
      ],
      "author": {
        "id": 8710,
        "name": "宋之问"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 277518,
      "title": "过函谷关",
      "content": [
        "二百四十载，海内何纷纷。",
        "六国兵同合，七雄势未分。",
        "从成拒秦帝，策决问苏君。",
        "鸡鸣将狗盗，论德不论勋。"
      ],
      "author": {
        "id": 8710,
        "name": "宋之问"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 277519,
      "title": "送朔方何侍郎",
      "content": [
        "闻道云中使，乘骢往复还。",
        "河兵守阳月，塞虏失阴山。",
        "拜职尝随骠，铭功不让班。",
        "旋闻受降日，歌舞入萧关。"
      ],
      "author": {
        "id": 8710,
        "name": "宋之问"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 277520,
      "title": "送田道士使蜀投龙",
      "content": [
        "风驭忽泠然，云台路几千。",
        "蜀门峰势断，巴字水形连。",
        "人隔壶中地，龙游洞里天。",
        "赠言回驭日，图画彼山川。"
      ],
      "author": {
        "id": 8710,
        "name": "宋之问"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 277521,
      "title": "送许州宋司马赴任",
      "content": [
        "颍郡水东流，荀陈兄弟游。",
        "偏伤兹日远，独向聚星州。",
        "河润在明德，人康非外求。",
        "当闻力为政，遥慰我心愁。"
      ],
      "author": {
        "id": 8710,
        "name": "宋之问"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 277522,
      "title": "送赵司马赴蜀州",
      "content": [
        "饯子西南望，烟緜劒道微。",
        "桥寒金雁落，林曙碧鸡飞。",
        "职拜舆方远，仙成履会归。",
        "定知和氏璧，遥掩玉轮辉。"
      ],
      "author": {
        "id": 8710,
        "name": "宋之问"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 277523,
      "title": "送永昌萧赞府",
      "content": [
        "柳变曲江头，送君函谷游。",
        "弄琴宽别意，酌醴醉春愁。",
        "恋本亦何极，赠言微所求。",
        "莫令金谷水，不入故园流。"
      ],
      "author": {
        "id": 8710,
        "name": "宋之问"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 277524,
      "title": "送李侍御",
      "content": [
        "行李恋庭闱，乘轺振彩衣。",
        "南登指吴服，北走出秦畿。",
        "去国夏云断，还乡秋雁飞。",
        "旋闻郡计入，更有使臣归。"
      ],
      "author": {
        "id": 8710,
        "name": "宋之问"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 277525,
      "title": "饯湖州薛司马",
      "content": [
        "别驾促严程，离筵多故情。",
        "交深季作友，义重伯为兄。",
        "镇静移吴俗，风流在汉京。",
        "会看陈仲举，从此拜公卿。"
      ],
      "author": {
        "id": 8710,
        "name": "宋之问"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 277526,
      "title": "送杜审言",
      "content": [
        "卧病人事绝，嗟君万里行。",
        "河桥不相送，江树远含情。",
        "别路追孙楚，维舟吊屈平。",
        "可惜龙泉劒，流落在丰城。"
      ],
      "author": {
        "id": 8710,
        "name": "宋之问"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 277527,
      "title": "送武进郑明府",
      "content": [
        "弦歌试宰日，城阙赏心违。",
        "北谢苍龙去，南随黄鹄飞。",
        "夏云海中出，吴山江上微。",
        "甿谣岂云远，从此庆缁衣。"
      ],
      "author": {
        "id": 8710,
        "name": "宋之问"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 277528,
      "title": "送姚侍御出使江东",
      "content": [
        "帝忧河朔郡，南发海陵仓。",
        "坐叹青春别，逶迤碧水长。",
        "饮冰朝受命，衣锦昼还乡。",
        "为问东山桂，无人何自芳。"
      ],
      "author": {
        "id": 8710,
        "name": "宋之问"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 277529,
      "title": "留别之望舍弟",
      "content": [
        "同气有三人，分飞在此晨。",
        "西驰巴岭徼，东去洛阳滨。",
        "强饮离前酒，终伤别后神。",
        "谁怜散花蕚，独赴日南春。"
      ],
      "author": {
        "id": 8710,
        "name": "宋之问"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 277530,
      "title": "汉江宴别",
      "content": [
        "汉广不分天，舟移杳若仙。",
        "秋虹暎晚日，江鹤弄晴烟。",
        "积水浮冠盖，遥风逐管弦。",
        "嬉游不可极，留恨此山川。"
      ],
      "author": {
        "id": 8710,
        "name": "宋之问"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 277531,
      "title": "初发荆府赠长史",
      "content": [
        "□□□□□，□□□□□。",
        "仍随五马谪，载与两禽奔。",
        "明主无由见，群公莫与言。",
        "幸君逢圣日，何惜理虞翻。"
      ],
      "author": {
        "id": 8710,
        "name": "宋之问"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 277532,
      "title": "晚泊湘江",
      "content": [
        "五岭恓惶客，三湘顦顇颜。",
        "况复秋雨霁，表里见衡山。",
        "路逐鹏南转，心依雁北还。",
        "唯余望乡泪，更染竹成斑。"
      ],
      "author": {
        "id": 8710,
        "name": "宋之问"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 277533,
      "title": "过蛮洞",
      "content": [
        "越岭千重合，蛮谿十里斜。",
        "竹迷樵子径，萍匝钓人家。",
        "林暗交枫叶，园香覆橘花。",
        "谁怜在荒外，孤赏足云霞。"
      ],
      "author": {
        "id": 8710,
        "name": "宋之问"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 277534,
      "title": "经梧州",
      "content": [
        "南国无霜霰，连年见物华。",
        "青林暗换叶，红橤续开花。",
        "春去闻山鸟，秋来见海槎。",
        "流芳虽可悦，会自泣长沙。"
      ],
      "author": {
        "id": 8710,
        "name": "宋之问"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 277535,
      "title": "渡吴江别王长史",
      "content": [
        "倚櫂望兹川，销魂独黯然。",
        "乡连江北树，云断日南天。",
        "劒别龙初没，书成雁不传。",
        "离舟意无限，催渡复催年。"
      ],
      "author": {
        "id": 8710,
        "name": "宋之问"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 277536,
      "title": "泛镜湖南溪",
      "content": [
        "乘兴入幽栖，舟行日向低。",
        "岩花候冬发，谷鸟作春啼。",
        "沓嶂开天小，丛篁夹路迷。",
        "犹闻可怜处，更在若邪溪。"
      ],
      "author": {
        "id": 8710,
        "name": "宋之问"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 277537,
      "title": "途中寒食题黄梅临江驿寄崔融",
      "content": [
        "马上逢寒食，愁中属暮春。",
        "可怜江浦望，不见洛阳人。",
        "北极怀明主，南溟作逐臣。",
        "故园肠断处，日夜柳条新。"
      ],
      "author": {
        "id": 8710,
        "name": "宋之问"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    }
  ],
