{
  "data": [
    {
      "id": 268088,
      "title": "南园十三首 七",
      "content": [
        "长卿牢落悲空舍，曼倩诙谐取自容。",
        "见买若耶溪水劒，明朝归去事猨公。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268089,
      "title": "南园十三首 八",
      "content": [
        "春水初生乳燕飞，黄蜂小尾扑花归。",
        "窗含远色通书幌，鱼拥香钩近石矶。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268090,
      "title": "南园十三首 九",
      "content": [
        "泉沙耎卧鸳鸯暖，曲岸回篙舴艋迟。",
        "泻酒木栏椒叶盖，病容扶起种菱丝。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268091,
      "title": "南园十三首 十",
      "content": [
        "边让今朝忆蔡邕，无心裁曲卧春风。",
        "舍南有竹堪书字，老去溪头作钓翁。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268092,
      "title": "南园十三首 十一",
      "content": [
        "长峦谷口倚嵇家，白昼千峰老翠华。",
        "自履藤鞋收石蜜，手牵苔絮长莼花。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268093,
      "title": "南园十三首 十二",
      "content": [
        "松溪黑水新龙卵，桂洞生硝旧马牙。",
        "谁遣虞卿裁道帔，轻绡一匹染朝霞。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268094,
      "title": "南园十三首 十三",
      "content": [
        "小树开朝迳，长茸湿夜烟。",
        "柳花惊雪浦，麦雨涨溪田。",
        "古刹疎钟度，遥岚破月悬。",
        "沙头敲石火，烧竹照渔船。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 268095,
      "title": "金铜仙人辞汉歌",
      "content": [
        "茂陵刘郎秋风客，夜闻马嘶晓无迹。",
        "画栏桂树悬秋香，三十六宫土花碧。",
        "魏官牵车指千里，东关酸风射眸子。",
        "空将汉月出宫门，忆君清泪如铅水。",
        "衰兰送客咸阳道，天若有情天亦老。",
        "携盘独出月荒凉，渭城已远波声小。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 268096,
      "title": "古悠悠行",
      "content": [
        "白景归西山，碧华上迢迢。",
        "今古何处尽，千岁随风飘。",
        "海沙变成石，鱼沫吹秦桥。",
        "空光远流浪，铜柱从年消。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 268097,
      "title": "黄头郎",
      "content": [
        "黄头郎，捞拢去不归。",
        "南浦芙蓉影，愁红独自垂。",
        "水弄湘娥珮，竹啼山露月。",
        "玉瑟调青门，石云湿黄葛。",
        "沙上蘼芜花，秋风已先发。",
        "好持扫罗荐，香出鸳鸯热。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 268098,
      "title": "马诗二十三首 一",
      "content": [
        "龙脊贴连钱，银蹄白踏烟。",
        "无人织锦韂，谁为铸金鞭。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 268099,
      "title": "马诗二十三首 二",
      "content": [
        "腊月草根甜，天街雪似盐。",
        "未知口硬软，先拟蒺藜衔。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 268100,
      "title": "马诗二十三首 三",
      "content": [
        "忽忆周天子，驱车上玉山。",
        "鸣驺辞凤苑，赤骥最承恩。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 268101,
      "title": "马诗二十三首 四",
      "content": [
        "此马非凡马，房星本是星。",
        "向前敲瘦骨，犹自带铜声。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 268102,
      "title": "马诗二十三首 五",
      "content": [
        "大漠山如雪，燕山月似钩。",
        "何当金络脑，快走踏清秋。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 268103,
      "title": "马诗二十三首 六",
      "content": [
        "饥卧骨查牙，粗毛刺破花。",
        "鬣焦朱色落，发断锯长麻。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 268104,
      "title": "马诗二十三首 七",
      "content": [
        "西母酒将阑，东王饭已干。",
        "君王若燕去，谁为拽车辕。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 268105,
      "title": "马诗二十三首 八",
      "content": [
        "赤兔无人用，当须吕布骑。",
        "吾闻果下马，羇策任蛮儿。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 268106,
      "title": "马诗二十三首 九",
      "content": [
        "飂叔去怱怱，如今不豢龙。",
        "夜来霜压栈，骏骨折西风。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 268107,
      "title": "马诗二十三首 十",
      "content": [
        "摧榜渡乌江，神骓泣向风。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 268108,
      "title": "马诗二十三首 十一",
      "content": [
        "内马赐宫人，银鞯刺骐驎。",
        "午时盐坂上，蹭蹬溘风尘。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 268109,
      "title": "马诗二十三首 十二",
      "content": [
        "批竹初攒耳，桃花未上身。",
        "他时须搅阵，牵去借将军。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 268110,
      "title": "马诗二十三首 十三",
      "content": [
        "宝玦谁家子，长闻侠骨香。",
        "堆金买骏骨，将送楚襄王。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 268111,
      "title": "马诗二十三首 十四",
      "content": [
        "香幞赭罗新，盘龙蹙镫鳞。",
        "回看南陌上，谁道不逢春。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 268112,
      "title": "马诗二十三首 十五",
      "content": [
        "不从桓公猎，何能伏虎威。",
        "一朝沟陇出，看取拂云飞。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 268113,
      "title": "马诗二十三首 十六",
      "content": [
        "唐剑斩隋公，拳毛属太宗。",
        "莫嫌金甲重，且去捉𩘶风。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 268114,
      "title": "马诗二十三首 十七",
      "content": [
        "白铁剉青禾，碪间落细莎。",
        "世人怜小颈，金埒畏长牙。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 268115,
      "title": "马诗二十三首 十八",
      "content": [
        "伯乐向前看，旋毛在腹间。",
        "祗今掊白草，何日蓦青山。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 268116,
      "title": "马诗二十三首 十九",
      "content": [
        "萧寺驮经马，元从竺国来。",
        "空知有善相，不解走章台。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 268117,
      "title": "马诗二十三首 二十",
      "content": [
        "重围如燕尾，宝剑似鱼肠。",
        "欲求千里脚，先采眼中光。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 268118,
      "title": "马诗二十三首 二十一",
      "content": [
        "暂系腾黄马，仙人上彩楼。",
        "须鞭玉勒吏，何事谪高州。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 268119,
      "title": "马诗二十三首 二十二",
      "content": [
        "汗血到王家，随鸾撼玉珂。",
        "少君骑海上，人见是青骡。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 268120,
      "title": "马诗二十三首 二十三",
      "content": [
        "武帝爱神仙，烧金得紫烟。",
        "廐中皆肉马，不解上青天。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 268121,
      "title": "申胡子觱篥歌",
      "content": [
        "颜热感君酒，含嚼芦中声。",
        "花娘𥮾绥妥，休睡芙蓉屏。",
        "谁截太平管，列点排空星。",
        "直贯开花风，天上驱云行。",
        "今夕岁华落，令人惜平生。",
        "心事如波涛，中坐时时惊。",
        "朔客骑白马，剑弝悬兰缨。",
        "俊健如生猱，肯拾蓬中萤。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 268122,
      "title": "老夫采玉歌",
      "content": [
        "采玉采玉须水碧，琢作步摇徒好色。",
        "老夫饥寒龙为愁，蓝溪水气无清白。",
        "夜雨冈头食蓁子，杜鹃口血老夫泪。",
        "蓝溪之水厌生人，身死千年恨溪水。",
        "斜山柏风雨如啸，泉脚挂绳青褭褭。",
        "村寒白屋念娇婴，古台石磴悬肠草。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 268123,
      "title": "伤心行",
      "content": [
        "咽咽学楚吟，病骨伤幽素。",
        "秋姿白发生，木叶啼风雨。",
        "灯青兰膏歇，落照飞蛾舞。",
        "古壁生凝尘，羇魂梦中语。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 268124,
      "title": "湖中曲",
      "content": [
        "长眉越沙采兰若，桂叶水葓春漠漠。",
        "横船醉眠白昼闲，渡口梅风歌扇薄。",
        "燕钗玉股照青渠，越王娇郎小字书。",
        "蜀纸封巾报云鬓，晚漏壶中水淋尽。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 268125,
      "title": "黄家洞",
      "content": [
        "雀步蹙沙声促促，四尺角弓青石镞。",
        "黑幡三点铜鼓鸣，高作猨啼摇箭箙。",
        "彩巾缠踍幅半斜，溪头簇队暎葛花。",
        "山潭晚雾吟白鼍，竹蛇飞蠹射金沙。",
        "闲驱竹马缓归家，官军自杀容州槎。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 268126,
      "title": "屏风曲",
      "content": [
        "蝶栖石竹银交关，水凝绿鸭瑠璃钱。",
        "团回六曲抱膏兰，将鬟镜上掷金蝉。",
        "沈香火暖茱萸烟，酒觥绾带新承懽。",
        "月风吹露屏外寒，城上乌啼楚女眠。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 268127,
      "title": "南山田中行",
      "content": [
        "秋野明，秋风白，塘水漻漻虫啧啧。",
        "云根苔藓山上石，冷红泣露娇啼色。",
        "荒畦九月稻叉牙，蛰萤低飞陇迳斜。",
        "石脉水流泉滴沙，鬼灯如漆点松花。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 268128,
      "title": "贵主征行乐",
      "content": [
        "奚骑黄铜连锁甲，罗旗香干金画叶。",
        "中军留醉河阳城，娇嘶紫燕踏花行。",
        "春营骑将如红玉，走马捎鞭上空绿。",
        "女垣素月角吚吚，牙帐未开分锦衣。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 268129,
      "title": "酒罢张大彻索赠诗",
      "content": [
        "长鬣张郎三十八，天遣裁诗花作骨。",
        "往还谁是龙头人，公主遣秉鱼须笏。",
        "太行青草上白衫，匣中章奏密如蚕。",
        "金门石阁知卿有，豸角鸡香早晚含。",
        "陇西长吉摧颓客，酒阑感觉中区窄。",
        "葛衣断碎赵城秋，吟诗一夜东方白。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 268130,
      "title": "罗浮山父与葛篇",
      "content": [
        "依依宜织江雨空，雨中六月兰台风。",
        "博罗老仙时出洞，千岁石床啼鬼工。",
        "蛇毒浓凝洞堂湿，江鱼不食衔沙立。",
        "欲剪箱中一尺天，吴娥莫道吴刀涩。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 268131,
      "title": "仁和里杂叙皇甫湜",
      "content": [
        "大人乞马癯乃寒，宗人贷宅荒厥垣。",
        "横庭鼠径空土涩，出篱大枣垂朱残。",
        "安定美人截黄绶，脱落缨裾瞑朝酒。",
        "还家白笔未上头，使我清声落人后。",
        "枉辱称知犯君眼，排引才升强𫄠断。",
        "洛风送马入长关，阖扇未开逢猰犬。",
        "那知坚都相草草，客枕幽单看春老。",
        "归来骨薄面无膏，疫气冲头鬓茎少。",
        "欲雕小说干天官，宗孙不调为谁怜。",
        "明朝下元复西道，崆峒叙别长如天。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 268132,
      "title": "宫娃歌",
      "content": [
        "蜡光高悬照纱空，花房夜捣红守宫。",
        "象口吹香毾㲪暖，七星挂城闻漏板。",
        "寒入罘罳殿影昏，彩鸾帘额著霜痕。",
        "啼蛄吊月钩栏下，屈膝铜铺锁阿甄。",
        "梦入家门上沙渚，天河落处长洲路。",
        "愿君光明如太阳，放妾骑鱼撇波去。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 268133,
      "title": "堂堂",
      "content": [
        "堂堂复堂堂，红脱梅灰香。",
        "十年粉蠹生画梁，饥虫不食推碎黄。",
        "蕙花已老桃叶长，禁院悬帘隔御光。",
        "华清源中礜石汤，裴回白凤随君王。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 268134,
      "title": "勉爱行二首送小季之庐山 一",
      "content": [
        "洛郊无俎豆，弊廐慙老马。",
        "小雁过𬬻峰，影落楚水下。",
        "长船倚云泊，石镜秋凉夜。",
        "岂解有乡情，弄月聊呜哑。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 268135,
      "title": "勉爱行二首送小季之庐山 二",
      "content": [
        "别柳当马头，官槐如兔目。",
        "欲将千里别，持我易斗粟。",
        "南云北云空脉断，灵台经络悬春线。",
        "青轩树转月满床，下国饥儿梦中见。",
        "维尔之昆二十余，年来持镜颇有须。",
        "辞家三载今如此，索米王门一事无。",
        "荒沟古水光如刀，庭南拱柳生蛴螬。",
        "江干幼客真可念，郊原晚吹悲号号。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 268136,
      "title": "致酒行",
      "content": [
        "零落栖迟一杯酒，主人奉觞客长寿。",
        "主父西游困不归，家人折断门前柳。",
        "吾闻马周昔作新丰客，天荒地老无人识。",
        "空将牋上两行书，直犯龙颜请恩泽。",
        "我有迷魂招不得，雄鸡一声天下白。",
        "少年心事当拏云，谁念幽寒坐呜呃。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 268137,
      "title": "长歌续短歌",
      "content": [
        "长歌破衣襟，短歌断白发。",
        "秦王不可见，旦夕成内热。",
        "渴饮壶中酒，饥拔陇头粟。",
        "凄凄四月阑，千里一时绿。",
        "夜峰何离离，明月落石底。",
        "裴回沿石寻，照出高峰外。",
        "不得与之游，歌成鬓先改。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 268138,
      "title": "公莫舞歌",
      "content": [
        "方花古础排九楹，刺豹淋血盛银甖。",
        "华筵鼓吹无桐竹，长刀直立割鸣筝。",
        "横楣麤锦生红纬，日炙锦嫣王未醉。",
        "腰下三看宝玦光，项庄掉箾栏前起。",
        "材官小臣公莫舞，座上真人赤龙子。",
        "芒砀云端抱天回，咸阳王气清如水。",
        "铁枢铁楗重束关，大旗五丈撞双镮。",
        "汉王今日颁秦印，绝膑刳肠臣不论。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 268139,
      "title": "昌谷北园新笋四首 一",
      "content": [
        "箨落长竿削玉开，君看母笋是龙材。",
        "更容一夜抽千尺，别却池园数寸泥。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268140,
      "title": "昌谷北园新笋四首 二",
      "content": [
        "斫取青光写楚辞，腻香春粉黑离离。",
        "无情有恨何人见，露压烟啼千万枝。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268141,
      "title": "昌谷北园新笋四首 三",
      "content": [
        "家泉石眼两三茎，晓看阴根紫脉生。",
        "今年水曲春沙上，笛管新篁拔玉青。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268142,
      "title": "昌谷北园新笋四首 四",
      "content": [
        "古竹老梢惹碧云，茂陵归卧叹清贫。",
        "风吹千亩迎雨啸，鸟重一枝入酒尊。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268143,
      "title": "恼公",
      "content": [
        "宋玉愁空断，娇饶粉自红。",
        "歌声春草露，门掩杏花丛。",
        "注口樱桃小，添眉桂叶浓。",
        "晓奁妆秀靥，夜帐减香筒。",
        "钿镜飞孤鹊，江图画水葓。",
        "陂陀梳碧凤，腰褭带金虫。",
        "杜若含清露，河蒲聚紫茸。",
        "月分蛾黛破，花合靥朱融。",
        "发重疑盘雾，腰轻乍倚风。",
        "密书题荳蔲，隐语笑芙蓉。",
        "莫锁茱萸匣，休开翡翠笼。",
        "弄珠惊汉燕，烧蜜引胡蜂。",
        "醉缬抛红网，单罗挂绿蒙。",
        "数钱教姹女，买药问巴賨。",
        "匀脸安斜雁，移灯想梦熊。",
        "肠攒非束竹，胘急是张弓。",
        "晚树迷新蝶，残蜺忆断虹。",
        "古时填渤澥，今日凿崆峒。",
        "绣沓褰长幔，罗裙结短封。",
        "心摇如舞鹤，骨出似飞龙。",
        "井槛淋清漆，门铺缀白铜。",
        "隈花开兔径，向壁印狐踪。",
        "玳瑁钉帘薄，琉璃叠扇烘。",
        "象床缘素柏，瑶席卷香葱。",
        "细管吟朝幌，芳醪落夜枫。",
        "宜男生楚巷，栀子发金墉。",
        "龟甲开屏涩，鹅毛渗墨浓。",
        "黄庭留卫瓘，绿树养韩冯。",
        "鸡唱星悬柳，鵶啼露滴桐。",
        "黄娥初出座，宠妹始相从。",
        "蜡泪垂兰烬，秋芜扫绮栊。",
        "吹笙翻旧引，沽酒待新丰。",
        "短珮愁填粟，长弦怨削菘。",
        "曲池眠乳鸭，小阁睡娃僮。",
        "褥缝𥮾双线，钩縚辫五总。",
        "蜀烟飞重锦，峡雨溅轻容。",
        "拂镜羞温峤，薰衣避贾充。",
        "鱼生玉藕下，人在石莲中。",
        "含水弯蛾翠，登楼选马鬉。",
        "使君居曲陌，园令住临邛。",
        "桂火流苏暖，金炉细炷通。",
        "春迟王子态，莺啭谢娘慵。",
        "玉漏三星曙，铜街五马逢。",
        "犀株防胆怯，银液镇心忪。",
        "跳脱看年命，琵琶道吉凶。",
        "王时应七夕，夫位在三宫。",
        "无力涂云母，多方带药翁。",
        "符因青鸟送，囊用绛纱缝。",
        "汉苑寻官柳，河桥阂禁钟。",
        "月明中妇觉，应笑画堂空。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 268144,
      "title": "感讽五首 一",
      "content": [
        "合浦无明珠，龙洲无木奴。",
        "足知造化力，不给使君须。",
        "越妇未织作，吴蚕始蠕蠕。",
        "县官骑马来，狞色虬紫须。",
        "怀中一方板，板上数行书。",
        "不因使君怒，焉得诣尔庐。",
        "越妇拜县官，桑牙今尚小。",
        "会待春日晏，丝车方掷掉。",
        "越妇通言语，小姑具黄粱。",
        "县官踏飡去，簿吏复登堂。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 268145,
      "title": "感讽五首 二",
      "content": [
        "奇俊无少年，日车何躃躃。",
        "我待纡双绶，遗我星星发。",
        "都门贾生墓，青蝇久断绝。",
        "寒食摇扬天，愤景长肃杀。",
        "皇汉十二帝，唯帝称睿哲。",
        "一夕信竖儿，文明永沦歇。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 268146,
      "title": "感讽五首 三",
      "content": [
        "南山何其悲，鬼雨洒空草。",
        "长安夜半秋，风前几人老。",
        "低迷黄昏径，褭褭青栎道。",
        "月午树无影，一山唯白晓。",
        "漆炬迎新人，幽圹萤扰扰。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 268147,
      "title": "感讽五首 四",
      "content": [
        "星尽四方高，万物知天曙。",
        "己生须己养，荷担出门去。",
        "君平久不反，康伯循国路。",
        "晓思何𫍢𫍢，阛阓千人语。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 268148,
      "title": "感讽五首 五",
      "content": [
        "石根秋水明，石畔秋草瘦。",
        "侵衣野竹香，蛰蛰垂叶厚。",
        "岑中月归来，蟾光挂空秀。",
        "桂露对仙娥，星星下云逗。",
        "凄凉栀子落，山璺泣清漏。",
        "下有张仲蔚，披书案将朽。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 268149,
      "title": "三月过行宫",
      "content": [
        "渠水红繁拥御墙，风娇小叶学娥妆。",
        "垂帘几度青春老，堪锁千年白日长。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 268150,
      "title": "追和何谢铜雀妓",
      "content": [
        "佳人一壶酒，秋容满千里。",
        "石马卧新烟，忧来何所似。",
        "歌声且潜弄，陵树风自起。",
        "长裾压高台，泪眼看花机。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 268151,
      "title": "送秦光禄北征",
      "content": [
        "北虏胶堪折，秋沙乱晓鼙。",
        "髯胡频犯塞，骄气似横霓。",
        "灞水楼船渡，营门细柳开。",
        "将军驰白马，豪彦骋雄材。",
        "箭射欃枪落，旗悬日月低。",
        "榆稀山易见，甲重马频嘶。",
        "天远星光没，沙平草叶齐。",
        "风吹云路火，雪污玉关泥。",
        "屡断呼韩颈，曾然董卓脐。",
        "太常犹旧宠，光禄是新隮。",
        "宝玦麒麟起，银壶狒狖啼。",
        "桃花连马发，彩絮扑鞍来。",
        "呵臂悬金斗，当唇注玉罍。",
        "清苏和碎蚁，紫腻卷浮杯。",
        "虎鞹先蒙马，鱼肠且断犀。",
        "𫎺𧽼西旅狗，蹙额北方奚。",
        "守帐然香暮，看鹰永夜栖。",
        "黄龙就别镜，青冢念阳台。",
        "周处长桥役，侯调短弄哀。",
        "钱塘阶凤羽，正室擘鸾钗。",
        "内子攀琪树，羌儿奏落梅。",
        "今朝擎劒去，何日刺蛟回。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 268152,
      "title": "酬荅二首 一",
      "content": [
        "金鱼公子夹衫长，密装腰鞓割玉方。",
        "行处春风随马尾，柳花偏打内家香。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268153,
      "title": "酬荅二首 二",
      "content": [
        "雍州二月梅池春，御水䴔䴖暖白苹。",
        "试问酒旗歌板地，今朝谁是抝花人。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 268154,
      "title": "画角东城",
      "content": [
        "河转曙萧萧，鸦飞睥睨高。",
        "帆长摽越甸，壁冷挂吴刀。",
        "淡菜生寒日，鲕鱼潠白涛。",
        "水花霑抹额，旗鼓夜迎潮。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 268155,
      "title": "谢秀才有妾缟练改从于人秀才留之不得[后]生感忆座人制诗嘲谢贺复继四首 一",
      "content": [
        "谁知泥忆云，望断梨花春。",
        "荷丝制机练，竹叶剪花裙。",
        "月明啼阿姊，灯暗会良人。",
        "也识君夫壻，金鱼挂在身。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 268156,
      "title": "谢秀才有妾缟练改从于人秀才留之不得[后]生感忆座人制诗嘲谢贺复继四首 二",
      "content": [
        "铜镜立青鸾，燕脂拂紫绵。",
        "腮花弄暗粉，眼尾泪侵寒。",
        "碧玉破不复，瑶琴重拨弦。",
        "今日非昔日，何人敢正看。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 268157,
      "title": "谢秀才有妾缟练改从于人秀才留之不得[后]生感忆座人制诗嘲谢贺复继四首 三",
      "content": [
        "洞房思不禁，蜂子作花心。",
        "灰暖残香炷，发冷青虫簪。",
        "夜遥灯焰短，睡熟小屏深。",
        "好作鸳鸯梦，南城罢捣碪。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 268158,
      "title": "谢秀才有妾缟练改从于人秀才留之不得[后]生感忆座人制诗嘲谢贺复继四首 四",
      "content": [
        "寻常轻宋玉，今日嫁文鸯。",
        "戟干横龙簴，刀环倚桂窗。",
        "邀人裁半袖，端坐据胡床。",
        "泪湿红轮重，栖乌上井梁。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 268159,
      "title": "昌谷读书示巴童",
      "content": [
        "虫响灯光薄，宵寒药气浓。",
        "君怜垂翅客，辛苦尚相从。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 268160,
      "title": "巴童荅",
      "content": [
        "巨鼻宜山褐，庞眉入苦吟。",
        "非君唱乐府，谁识怨秋深。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 268161,
      "title": "代崔家送客",
      "content": [
        "行盖柳烟下，马蹄白翩翩。",
        "恐随行处尽，何忍重扬鞭。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 268162,
      "title": "出城",
      "content": [
        "雪下桂花稀，啼乌被弹归。",
        "关水乘驴影，秦风帽带垂。",
        "入乡试万里，无印自堪悲。",
        "卿卿忍相问，镜中双泪姿。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 268163,
      "title": "莫种树",
      "content": [
        "园中莫种树，种树四时愁。",
        "独睡南床月，今秋似去秋。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 268164,
      "title": "将发",
      "content": [
        "东床卷席罢，[濩]落将行去。",
        "秋白遥遥空，日满门前路。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 268165,
      "title": "追赋画江潭苑四首 一",
      "content": [
        "吴苑晓苍苍，宫衣水溅黄。",
        "小鬟红粉薄，骑马珮珠长。",
        "路指台城迥，罗薰袴褶香。",
        "行云霑翠辇，今日似襄王。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 268166,
      "title": "追赋画江潭苑四首 二",
      "content": [
        "宝袜菊衣单，蕉花密露寒。",
        "水光兰泽叶，带重剪刀钱。",
        "角暖盘弓易，靴长上马难。",
        "泪痕霑寝帐，匀粉照金鞍。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 268167,
      "title": "追赋画江潭苑四首 三",
      "content": [
        "剪翅小鹰斜，[縚]根玉镟花。",
        "秋垂妆钿粟，箭箙钉文牙。",
        "●●啼深竹，䴔䴖老湿沙。",
        "宫官烧蜡火，飞烬汚铅华。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 268168,
      "title": "追赋画江潭苑四首 四",
      "content": [
        "十骑簇芙蓉，宫衣小队红。",
        "练香熏宋鹊，寻箭踏卢龙。",
        "旗湿金铃重，霜干玉镫空。",
        "今朝画眉早，不待景阳钟。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 268169,
      "title": "潞州张大宅病酒遇江使寄上十四兄",
      "content": [
        "秋至昭关后，当知赵国寒。",
        "系书随短羽，写恨破长笺。",
        "病客眠清晓，疎桐坠绿鲜。",
        "城鸦啼粉堞，军吹压芦烟。",
        "岸帻褰沙幌，枯塘卧折莲。",
        "木窗银迹画，石磴水痕钱。",
        "旅酒侵愁肺，离歌绕懦弦。",
        "诗封两条泪，露折一枝兰。",
        "莎老沙鸡泣，松干瓦兽残。",
        "觉骑燕地马，梦载楚溪船。",
        "椒桂倾长席，鲈鲂斫玳筵。",
        "岂能忘旧路，江岛滞佳年。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 268170,
      "title": "难忘曲",
      "content": [
        "夹道开洞门，弱杨低画戟。",
        "帘影竹华起，箫声吹日色。",
        "蜂语绕妆镜，拂蛾学春碧。",
        "乱系丁香梢，满栏花向夕。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 268171,
      "title": "贾公闾贵壻曲",
      "content": [
        "朝衣不须长，分花对袍缝。",
        "嘤嘤白马来，满脑黄金重。",
        "今朝香气苦，珊瑚涩难枕。",
        "且要弄风人，暖蒲沙上饮。",
        "燕语踏帘钩，日虹屏中碧。",
        "潘令在河阳，无人死芳色。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 268172,
      "title": "夜饮朝眠曲",
      "content": [
        "觞酣出座东方高，腰横半解星劳劳。",
        "柳苑鸦啼公主醉，薄露压花蕙园气。",
        "玉转湿丝牵晓水，熟粉生香琅玕紫。",
        "夜饮朝眠断无事，楚罗之帏卧皇子。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 268173,
      "title": "王濬墓下作",
      "content": [
        "人间无阿童，犹唱水中龙。",
        "白草侵烟死，秋梨遶地红。",
        "古书平黑石，袖劒断青铜。",
        "耕势鱼鳞起，坟科马鬣封。",
        "菊花垂湿露，棘径卧干蓬。",
        "松柏愁香涩，南原几夜风。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 268174,
      "title": "客游",
      "content": [
        "悲满千里心，日暖南山石。",
        "不谒承明庐，老作平原客。",
        "四时别家庙，三年去乡国。",
        "旅歌屡弹铗，归问时裂帛。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 268175,
      "title": "崇义里滞雨",
      "content": [
        "落莫谁家子，来感长安秋。",
        "壮年抱羁恨，梦泣生白头。",
        "瘦马秣败草，雨沫飘寒沟。",
        "南宫古帘暗，湿景传签筹。",
        "家山远千里，云脚天东头。",
        "忧眠枕劒匣，客帐梦封侯。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 268176,
      "title": "冯小怜",
      "content": [
        "湾头见小怜，请上琵琶弦。",
        "破得春风恨，今朝直几钱。",
        "裙垂竹叶带，鬓湿杏花烟。",
        "玉冷红丝重，齐宫妾驾鞭。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 268177,
      "title": "赠陈商",
      "content": [
        "长安有男儿，二十心已朽。",
        "楞伽堆案前，楚辞系肘后。",
        "人生有穷拙，日暮聊饮酒。",
        "秪今道已塞，何必须白首。",
        "凄凄陈述圣，披褐鉏俎豆。",
        "学为尧舜文，时人责衰偶。",
        "柴门车辙冻，日下榆影瘦。",
        "黄昏访我来，苦节青阳皱。",
        "太华五千仞，劈地抽森秀。",
        "旁古无寸寻，一上戛牛斗。",
        "公卿纵不怜，宁能锁吾口。",
        "李生师太华，大坐看白昼。",
        "逢霜作朴𣙙，得气为春柳。",
        "礼节乃相去，顦顇如刍狗。",
        "风雪直斋坛，墨组贯铜绶。",
        "臣妾气态间，唯欲承箕帚。",
        "天眼何时开，古劒庸一吼。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 268178,
      "title": "钓鱼诗",
      "content": [
        "秋水钓红渠，仙人待素书。",
        "菱丝萦独茧，蒲米蛰双鱼。",
        "斜竹垂清沼，长纶贯碧虚。",
        "饵悬春[蜥蜴]，钩坠小蟾蜍。",
        "詹子情无限，龙阳恨有余。",
        "为看烟浦上，楚女泪霑裾。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 268179,
      "title": "奉和二兄罢使遣马归延州",
      "content": [
        "空留三尺劒，不用一丸泥。",
        "马向沙场去，人归故国来。",
        "笛愁翻陇水，酒喜沥春灰。",
        "锦带休惊雁，罗衣尚鬬鸡。",
        "还吴已渺渺，入郢莫凄凄。",
        "自是桃李树，何畏不成蹊。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 268180,
      "title": "荅赠",
      "content": [
        "本是张公子，曾名萼绿华。",
        "沈香熏小像，杨柳伴啼鸦。",
        "露重金泥冷，杯阑玉树斜。",
        "琴堂沽酒客，新买后园花。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 268181,
      "title": "题赵生壁",
      "content": [
        "大妇然竹根，中妇舂玉屑。",
        "冬暖拾松枝，日烟坐蒙灭。",
        "木藓青桐老，石井水声发。",
        "曝背卧东亭，桃花满肌骨。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 268182,
      "title": "感春",
      "content": [
        "日暖自萧条，花悲北郭骚。",
        "榆穿莱子眼，柳断舞儿腰。",
        "上幕迎神燕，飞丝送百劳。",
        "胡琴今日恨，急语向檀槽。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 268183,
      "title": "仙人",
      "content": [
        "弹琴石壁上，翻翻一仙人。",
        "手持白鸾尾，夜扫南山云。",
        "鹿饮寒涧下，鱼归清海滨。",
        "当时汉武帝，书报桃花春。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 268184,
      "title": "河阳歌",
      "content": [
        "染罗衣，秋蓝难著色。",
        "不是无心人，为作台邛客。",
        "花烧中潬城，颜郎身已老。",
        "惜许两少年，抽心似春草。",
        "今日见银牌，今夜鸣玉䜩。",
        "牛头高一尺，隔坐应相见。",
        "月从东方来，酒从东方转。",
        "觥船饫口红，[蜜]炬千枝烂。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 268185,
      "title": "花游曲",
      "content": [
        "春柳南陌态，冷花寒露姿。",
        "今朝醉城外，拂镜浓扫眉。",
        "烟湿愁车重，红油覆画衣。",
        "舞裙香不暖，酒色上来迟。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 268186,
      "title": "春昼",
      "content": [
        "朱城报春更漏转，光风催兰吹小殿。",
        "草细堪梳，柳长如线。",
        "卷衣秦帝，扫粉赵燕。",
        "日含画幕，蜂上罗荐。",
        "平阳花坞，河阳花县。",
        "越妇搘机，吴蚕作茧。",
        "菱汀系带，荷塘倚扇。",
        "江南有情，塞北无恨。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 268187,
      "title": "安乐宫",
      "content": [
        "深井桐乌起，尚复牵情水。",
        "未盥邵陵瓜，缾中弄长翠。",
        "新成安乐宫，宫如凤皇翅。",
        "歌回蜡板鸣，左悺提壶使。",
        "绿蘩悲水曲，茱萸别秋子。"
      ],
      "author": {
        "id": 1849,
        "name": "李贺"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
