{
  "data": [
    {
      "id": 269791,
      "title": "重到毓村宅有感",
      "content": [
        "欲入中门泪满巾，庭花无主两回春。",
        "轩窗帘幕皆依旧，只是堂前欠一人。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 269792,
      "title": "乱后过流沟寺",
      "content": [
        "九月徐州新战后，悲风杀气满山河。",
        "唯有流沟山下寺，门前依旧白云多。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 269793,
      "title": "叹发落",
      "content": [
        "多病多愁心自知，行年未老发先衰。",
        "随梳落去何须惜，不落终须变作丝。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 269794,
      "title": "留别吴七正字",
      "content": [
        "成名共记甲科上，署吏同登芸阁间。",
        "唯是尘心殊道性，秋蓬常转水长闲。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 269795,
      "title": "除夜宿洺州",
      "content": [
        "家寄关西住，身为河北游。",
        "萧条岁除夜，旅泊在洺州。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 269796,
      "title": "邯郸冬至夜思家",
      "content": [
        "邯郸驿里逢冬至，抱膝灯前影伴身。",
        "想得家中夜深坐，还应说著远行人。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 269797,
      "title": "冬至夜怀湘灵",
      "content": [
        "艳质无由见，寒衾不可亲。",
        "何堪最长夜，俱作独眠人。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 269798,
      "title": "感故张仆射诸妓",
      "content": [
        "黄金不惜买蛾眉，拣得如花三四枝。",
        "歌舞教成心力尽，一朝身去不相随。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 269799,
      "title": "游仙游山",
      "content": [
        "暗将心地出人间，五六年来人怪闲。",
        "自嫌恋著未全尽，犹爱云泉多在山。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 269800,
      "title": "见尹公亮新诗偶赠绝句",
      "content": [
        "袖里新诗十首余，吟看句句是琼琚。",
        "如何持此将干谒，不及公卿一字书。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 269801,
      "title": "长安闲居",
      "content": [
        "风竹松烟昼掩关，意中长似在深山。",
        "无人不怪长安住，何独朝朝暮暮间。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 269802,
      "title": "早春独游曲江",
      "content": [
        "散职无羁束，羸骖少送迎。",
        "朝从直城出，春傍曲江行。",
        "风起池东暖，云开山北晴。",
        "冰销泉脉动，雪尽草芽生。",
        "露杏红初坼，烟杨绿未成。",
        "影迟新度鴈，声涩欲啼莺。",
        "闲地心俱静，韶光眼共明。",
        "酒狂怜性逸，药效喜身轻。",
        "慵慢疎人事，幽栖逐野情。",
        "回看芸阁笑，不似有浮名。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 269803,
      "title": "秘书省中忆旧山",
      "content": [
        "厌从薄宦校青简，悔别故山思白云。",
        "犹喜兰台非傲吏，归时应免动移文。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 269804,
      "title": "凉夜有怀",
      "content": [
        "清风吹枕席，白露湿衣裳。",
        "好是相亲夜，漏迟天气凉。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 269805,
      "title": "送武士曹归蜀",
      "content": [
        "花落鸟嘤嘤，南归称野情。",
        "月宜秦岭宿，春好蜀江行。",
        "乡路通云栈，郊扉近锦城。",
        "乌台陟冈送，人羡别时荣。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 269806,
      "title": "江南送北客因凭寄徐州兄弟书",
      "content": [
        "故园望断欲何如，楚水吴山万里余。",
        "今日因君访兄弟，数行乡泪一封书。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 269807,
      "title": "赋得古原草送别",
      "content": [
        "离离原上草，一岁一枯荣。",
        "野火烧不尽，春风吹又生。",
        "远芳侵古道，晴翠接荒城。",
        "又送王孙去，萋萋满别情。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 269808,
      "title": "夜哭李夷道",
      "content": [
        "逝者绝影响，空庭朝复昏。",
        "家人哀临毕，夜鏁寿堂门。",
        "无妻无子何人葬，空见铭旌向月飜。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 269809,
      "title": "病中作",
      "content": [
        "久为劳生事，不学摄生道。",
        "年少已多病，此身岂堪老。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 269810,
      "title": "秋江晚泊",
      "content": [
        "扁舟泊云岛，倚櫂念乡国。",
        "四望不见人，烟江澹秋色。",
        "客心贫易动，日入愁未息。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 269811,
      "title": "旅次景空寺宿幽上人院",
      "content": [
        "不与人境接，寺门开向山。",
        "暮钟寒鸟聚，秋雨病僧闲。",
        "月隐云树外，萤飞廊宇间。",
        "幸投花界宿，暂得静心颜。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 269812,
      "title": "长安正月十五日",
      "content": [
        "諠諠车骑帝王州，羇病无心逐胜游。",
        "明月春风三五夜，万人行乐一人愁。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 269813,
      "title": "过高将军墓",
      "content": [
        "原上新坟委一身，城中旧宅有何人。",
        "妓堂宾阁无归日，野草山花又欲春。",
        "门客空将感恩泪，白杨风里一霑巾。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 269814,
      "title": "寒食卧病",
      "content": [
        "病逢佳节长叹息，春雨蒙蒙榆柳色。",
        "羸坐全非旧日容，扶行半是他人力。",
        "諠諠里巷蹋青归，笑闭柴门度寒食。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 269815,
      "title": "宿桐庐馆同崔存度醉后作",
      "content": [
        "江海漂漂共旅游，一尊相劝散穷愁。",
        "夜深醒后愁还在，雨滴梧桐山馆秋。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 269816,
      "title": "江楼望归",
      "content": [
        "满眼云水色，月明楼上人。",
        "旅愁春入越，乡梦夜归秦。",
        "道路通荒服，田园隔虏尘。",
        "悠悠沧海畔，十载避黄巾。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 269817,
      "title": "除夜寄弟妹",
      "content": [
        "感时思弟妹，不寐百忧生。",
        "万里经年别，孤灯此夜情。",
        "病容非旧日，归思逼新正。",
        "早晚重欢会，羇离各长成。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 269818,
      "title": "寒食月夜",
      "content": [
        "风香露重棃花湿，草舍无灯愁未入。",
        "南邻北里歌吹时，独倚柴门月中立。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 269819,
      "title": "感芍药花寄正一上人",
      "content": [
        "今日阶前红芍药，几花欲老几花新。",
        "开时不解比色相，落后始知如幻身。",
        "空门此去几多地，欲把残花问上人。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 269820,
      "title": "晚秋闲居",
      "content": [
        "地僻门深少送迎，披衣闲坐养幽情。",
        "秋庭不埽携藤杖，闲蹋梧桐黄叶行。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 269821,
      "title": "秋暮郊居书怀",
      "content": [
        "郊居人事少，昼卧对林峦。",
        "穷巷厌多雨，贫家愁早寒。",
        "葛衣秋未换，书卷病仍看。",
        "若问生涯计，前溪一钓竿。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 269822,
      "title": "为薛台悼亡",
      "content": [
        "半死梧桐老病身，重泉一念一伤神。",
        "手携穉子夜归院，月冷空房不见人。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 269823,
      "title": "途中寒食",
      "content": [
        "路傍寒食行人尽，独占春愁在路旁。",
        "马上垂鞭愁不语，风吹百草野田香。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 269824,
      "title": "题流沟寺古松",
      "content": [
        "烟叶葱茏苍麈尾，霜皮剥落紫龙鳞。",
        "欲知松老看尘壁，死却题诗几许人。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 269825,
      "title": "感月悲逝者",
      "content": [
        "存亡感月一潸然，月色今宵似往年。",
        "何处曾经同望月？",
        "樱桃树下后堂前。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 269826,
      "title": "代邻叟言怀",
      "content": [
        "人生何事心无定，宿昔如今意不同。",
        "宿昔愁身不得老，如今恨作白头翁。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 269827,
      "title": "自河南经乱关内阻饥兄弟离散各在一处因望月有感聊书所怀寄上浮梁大兄于潜七兄乌江十五兄兼示符离及下邽弟妹",
      "content": [
        "时难年饥世业空，弟兄羇旅各西东。",
        "田园寥落干戈后，骨肉流离道路中。",
        "吊影分为千里鴈，辞根散作九秋蓬。",
        "共看明月应垂泪，一夜乡心五处同。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 269828,
      "title": "长安早春旅怀",
      "content": [
        "轩车歌吹諠都邑，中有一人向隅立。",
        "夜深明月卷帘愁，日暮青山望乡泣。",
        "风吹新绿草芽坼，雨洒轻黄柳条湿。",
        "此生知负少年春，不展愁眉欲三十。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 269829,
      "title": "寒闺夜",
      "content": [
        "夜半衾裯冷，孤眠嬾未能。",
        "笼香销尽火，巾泪滴成冰。",
        "为惜影相伴，通宵不灭灯。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 269830,
      "title": "寄湘灵",
      "content": [
        "泪眼凌寒冻不流，每经高处即回头。",
        "遥知别后西楼上，应凭阑干独自愁。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 269831,
      "title": "冬至宿杨梅馆",
      "content": [
        "十一月中长至夜，三千里外远行人。",
        "若为独宿杨梅馆，冷枕单床一病身。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 269832,
      "title": "临江送夏瞻",
      "content": [
        "悲君老别我霑巾，七十无家万里身。",
        "愁见舟行风又起，白头浪里白头人。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 269833,
      "title": "冬夜示敏巢",
      "content": [
        "炉火欲销灯欲尽，夜长相对百忧生。",
        "他时诸处重相见，莫忘今宵灯下情。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 269834,
      "title": "客中守岁",
      "content": [
        "守岁尊无酒，思乡泪满巾。",
        "始知为客苦，不及在家贫。",
        "畏老偏惊节，防愁预恶春。",
        "故园今夜里，应念未归人。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 269835,
      "title": "问淮水",
      "content": [
        "自嗟名利客，扰扰在人间。",
        "何事长淮水，东流亦不闲。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 269836,
      "title": "宿樟亭驿",
      "content": [
        "夜半樟亭驿，愁人起望乡。",
        "月明何所见，潮水白茫茫。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 269837,
      "title": "及第后忆旧山",
      "content": [
        "偶献子虚登上第，却吟招隐忆中林。",
        "春萝秋桂莫惆怅，纵有浮名不系心。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 269838,
      "title": "题李次云窗竹",
      "content": [
        "不用裁为鸣凤管，不须截作钓鱼竿。",
        "千花百草凋零后，留向纷纷雪里看。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 269839,
      "title": "花下自劝酒",
      "content": [
        "酒醆酌来须满满，花枝看即落纷纷。",
        "莫言三十是年少，百岁三分已一分。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 269840,
      "title": "题李十一东亭",
      "content": [
        "相思夕上松台立，蛩思蝉声满耳秋。",
        "惆怅东亭风月好，主人今夜在鄜州。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 269841,
      "title": "春村",
      "content": [
        "二月村园暖，桑间戴胜飞。",
        "农夫舂旧谷，蚕妾捣新衣。",
        "牛马因风远，鸡豚过社稀。",
        "黄昏林下路，鼓笛赛神归。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 269842,
      "title": "题施山人野居",
      "content": [
        "得道应无著，谋生亦不妨。",
        "春泥秧稻暖，夜火焙茶香。",
        "水巷风尘少，松斋日月长。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 269843,
      "title": "翰林中送独孤二十七起居罢职出院",
      "content": [
        "碧落留云住，青冥放鹤还。",
        "银台向南路，从此到人间。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 269844,
      "title": "重寻杏园",
      "content": [
        "忽忆芳时频酩酊，却寻醉处重裴回。",
        "杏花结子春深后，谁解多情又独来。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 269845,
      "title": "曲江独行",
      "content": [
        "独来独去何人识，廐马朝衣野客心。",
        "闲爱无风水边坐，杨花不动树阴阴。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 269846,
      "title": "同李十一醉忆元九",
      "content": [
        "花时同醉破春愁，醉折花枝当酒筹。",
        "忽忆故人天际去，计程今日到凉州。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 269847,
      "title": "同钱员外题绝粮僧巨川",
      "content": [
        "三十年来坐对山，唯将无事化人间。",
        "斋时往往闻钟笑，一食何如不食闲。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 269848,
      "title": "绝句代书赠钱员外",
      "content": [
        "欲寻秋景闲行去，君病多慵我兴孤。",
        "可惜今朝山最好，强能骑马出来无。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 269849,
      "title": "晚秋有怀郑中旧隐",
      "content": [
        "天高风袅袅，乡思绕关河。",
        "寥落归山梦，殷勤采蕨歌。",
        "病添心寂寞，愁人鬓蹉跎。",
        "晚树蝉鸣少，秋阶日上多。",
        "长闲羡云鹤，久别媿烟萝。",
        "其奈丹墀上，君恩未报何。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 269850,
      "title": "禁中九日对菊花酒忆元九",
      "content": [
        "赐酒盈杯谁共持，宫花满把独相思。",
        "相思只傍花边立，尽日吟君咏菊诗。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 269851,
      "title": "送王十八归山寄题仙游寺",
      "content": [
        "曾于太白峰前住，数到仙游寺里来。",
        "黑水澄时潭底出，白云破处洞门开。",
        "林间暖酒烧红叶，石上题诗埽绿苔。",
        "惆怅旧游那复到，菊花时节羡君回。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 269852,
      "title": "荅张籍因以代书",
      "content": [
        "怜君马瘦衣裘薄，许到江东访鄙夫。",
        "今日正闲天又暖，可能扶病暂来无。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 269853,
      "title": "曲江早春",
      "content": [
        "曲江柳条渐无力，杏园伯劳初有声。",
        "可怜春浅游人少，好傍池边下马行。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 269854,
      "title": "见元九悼亡诗因以此寄",
      "content": [
        "夜泪暗销明月幌，春肠遥断牡丹庭。",
        "人间此病治无药，唯有楞伽四卷经。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 269855,
      "title": "寒食夜",
      "content": [
        "无月无灯寒食夜，夜深犹立暗花前。",
        "忽因时节惊年几，四十如今欠一年。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 269856,
      "title": "杏园花落时招钱员外同醉",
      "content": [
        "花园欲去去应迟，正是风吹狼藉时。",
        "近西数树犹堪醉，半落春风半在枝。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 269857,
      "title": "重题西明寺牡丹",
      "content": [
        "往年君向东都去，曾叹花时君未回。",
        "今年况作江陵别，惆怅花前又独来。",
        "只愁离别长如此，不道明年花不开。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 269858,
      "title": "同钱员外禁中夜直",
      "content": [
        "宫漏三声知半夜，好风凉月满松筠。",
        "此时闲坐寂无语，药树影中唯两人。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 269859,
      "title": "禁中夜作书与元九",
      "content": [
        "心绪万端书两纸，欲封重读意迟迟。",
        "五声宫漏初鸣夜，一点窗灯欲灭时。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 269860,
      "title": "八月十五日夜禁中独直对月忆元九",
      "content": [
        "银台金阙夕沈沈，独宿相思在翰林。",
        "三五夜中新月色，二千里外故人心。",
        "渚宫东面烟波冷，浴殿西头钟漏深。",
        "犹恐清光不同见，江陵卑湿足秋阴。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 269861,
      "title": "寄陈式五兄",
      "content": [
        "年来白发两三茎，忆别君时髭未生。",
        "惆怅料君应满鬓，当初是我十年兄。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 269862,
      "title": "庾顺之以紫霞绮远赠以诗荅之",
      "content": [
        "千里故人心郑重，一端香绮紫氛氲。",
        "开缄日映晚霞色，满幅风生秋水纹。",
        "为褥欲裁怜叶破，制裘将翦惜花分。",
        "不如缝作合欢被，寤寐相思如对君。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 269863,
      "title": "送元八归凤翔",
      "content": [
        "莫道岐州三日程，其如风雪一身行。",
        "与君况是经年别，暂到城来又出城。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 269864,
      "title": "雨雪放朝因怀微之",
      "content": [
        "归骑纷纷满九衢，放朝三日为泥涂。",
        "不知雨雪江陵府，今日排衙得免无。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 269865,
      "title": "咏怀",
      "content": [
        "岁去年来尘土中，眼看变作白头翁。",
        "如何办得归山计，两顷村田一亩宫。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 269866,
      "title": "闻微之江陵卧病以大通中散碧腴垂云膏寄之因题四韵",
      "content": [
        "已题一帖红消散，又封一合碧云英。",
        "凭人寄向江陵去，道路迢迢一月程。",
        "未必能治江上瘴，且图遥慰病中情。",
        "到时想得君拈得，枕上开看眼暂明。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 269867,
      "title": "酬钱员外雪中见寄",
      "content": [
        "松雪无尘小院寒，闭门不似住长安。",
        "烦君想我看心坐，报道心空无可看。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 269868,
      "title": "重酬钱员外",
      "content": [
        "雪中重寄雪山偈，问荅殷勤四句中。",
        "本立空名缘破妄，若能无妄亦无空。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 269869,
      "title": "独酌忆微之",
      "content": [
        "独酌花前醉忆君，与君春别又逢春。",
        "惆怅银杯来处重，不曾盛酒劝闲人。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 269870,
      "title": "微之宅残牡丹",
      "content": [
        "残红零落无人赏，雨打风摧花不全。",
        "诸处见时犹怅望，况当元九小亭前。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 269871,
      "title": "新磨镜",
      "content": [
        "衰容常晚栉，秋镜偶新磨。",
        "一与清光对，方知白发多。",
        "鬓毛从幻化，心地付头陀。",
        "任意浑成雪，其如似梦何。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 269872,
      "title": "感发落",
      "content": [
        "昔日愁头白，谁知未白衰。",
        "眼看应落尽，无可变成丝。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 269873,
      "title": "八月十五日夜闻崔大员外翰林独直对酒玩月因怀禁中清景偶题是诗",
      "content": [
        "秋月高悬空碧外，仙郎静玩禁闱间。",
        "岁中唯有今宵好，海内无如此地闲。",
        "皓色分明双阙牓，清光深到九门关。",
        "遥闻独醉还惆怅，不见金波照玉山。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 269874,
      "title": "酬王十八见寄",
      "content": [
        "秋思太白峰头雪，晴忆仙游洞口云。",
        "未报皇恩归未得，慙君为寄北山文。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 269875,
      "title": "立春日酬钱员外曲江同行见赠",
      "content": [
        "下直遇春日，垂鞭出禁闱。",
        "两人携手语，十里看山归。",
        "柳色早黄浅，水文新绿微。",
        "风光向晚好，车马近南稀。",
        "机尽笑相顾，不惊鸥鹭飞。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 269876,
      "title": "和钱员外青龙寺上方望旧山",
      "content": [
        "旧峰松雪旧溪云，怅望今朝遥属君。",
        "共道使臣非俗吏，南山莫动北山文。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 269877,
      "title": "宴周皓大夫光福宅",
      "content": [
        "何处风光最可怜？",
        "妓堂阶下砌台前。",
        "轩车拥路光照地，丝管入门声沸天。",
        "绿蕙不香饶桂酒，红樱无色让花钿。",
        "野人不敢求他事，唯借泉声伴醉眠。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 269878,
      "title": "晚秋夜",
      "content": [
        "碧空溶溶月华静，月里愁人吊孤影。",
        "花开残菊傍疎篱，叶下衰桐落寒井。",
        "塞鸿飞急觉秋尽，邻鸡鸣迟知夜永。",
        "凝情不语空所思，风吹白露衣裳冷。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 269879,
      "title": "惜牡丹花二首 一",
      "content": [
        "惆怅阶前红牡丹，晚来唯有两枝残。",
        "明朝风起应吹尽，夜惜衰红把火看。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 269880,
      "title": "惜牡丹花二首 二",
      "content": [
        "寂寞萎红低向雨，离披破艳散随风。",
        "晴明落地犹惆怅，何况飘零泥土中。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 269881,
      "title": "荅元奉礼同宿见赠",
      "content": [
        "相逢俱叹不闲身，直日常多斋日频。",
        "晓鼓一声分散去，明朝风景属何人。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 269882,
      "title": "荅马侍御见赠",
      "content": [
        "谬入金门侍玉除，烦君问我意何如。",
        "蟠木讵堪明主用，笼禽徒与故人疎。",
        "苑花似雪同随辇，宫月如眉伴直庐。",
        "浅薄求贤思自代，嵇康莫寄绝交书。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 269883,
      "title": "上巳日恩赐曲江宴会即事",
      "content": [
        "赐欢仍许醉，此会兴如何。",
        "翰苑主恩重，曲江春意多。",
        "花低羞艳妓，莺散让清歌。",
        "共道升平乐，元和胜永和。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 269884,
      "title": "夜惜禁中桃花因怀钱员外",
      "content": [
        "前日归时花正红，今夜宿时枝半空。",
        "坐惜残芳君不见，风吹狼藉月明中。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 269885,
      "title": "和钱员外早冬玩禁中新菊",
      "content": [
        "禁署寒气迟，孟冬菊初坼。",
        "新黄间繁绿，烂若金照碧。",
        "仙郎小隐日，心似陶彭泽。",
        "秋怜潭上看，日惯篱边摘。",
        "今来此地赏，野意潜自适。",
        "金马门内花，玉山峰下客。",
        "寒芳引清句，吟玩烟景夕。",
        "赐酒色偏宜，握兰香不敌。",
        "凄凄百卉死，岁晚冰霜积。",
        "唯有此花开，殷勤助君惜。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 269886,
      "title": "荅刘戒之早秋别墅见寄",
      "content": [
        "凉风木槿篱，暮雨槐花枝。",
        "幷起新秋思，为得故人诗。",
        "避地鸟择木，升朝鱼在池。",
        "城中与山下，喧静暗相思。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 269887,
      "title": "凉夜有怀",
      "content": [
        "念别感时节，早蛩闻一声。",
        "风帘夜凉入，露簟秋意生。",
        "灯尽梦初罢，月斜天未明。",
        "暗凝无限思，起傍药阑行。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 269888,
      "title": "秋思",
      "content": [
        "病眠夜少梦，闲立秋多思。",
        "寂寞余雨晴，萧条早寒至。",
        "鸟栖红叶树，月照青苔地。",
        "何况镜中年，又过三十二。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 269889,
      "title": "禁中闻蛩",
      "content": [
        "悄悄禁门闭，夜深无月明。",
        "西窗独暗坐，满耳新蛩声。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 269890,
      "title": "秋虫",
      "content": [
        "切切暗窗下，喓喓深草里。",
        "秋天思妇心，雨夜愁人耳。"
      ],
      "author": {
        "id": 9057,
        "name": "白居易"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    }
  ],
