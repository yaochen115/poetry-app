{
  "data": [
    {
      "id": 315001,
      "title": "醉蓬莱",
      "content": [
        "正金风无露。",
        "玉宇生凉，楚郊无暑。",
        "催起行人，恰槐黄时序。",
        "万里晴宵，几人争睹，快鹏抟一举。",
        "明月圆时，素秋中夜，凌云新赋。",
        "那更渊源，词锋轻锐，笔阵纵横，学通今古。",
        "誉望飞腾，是麟宗文虎。",
        "魁荐归来，华堂香里，与管弦为主。",
        "待看明年，彤墀射策，鳌头独步。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315002,
      "title": "洞仙歌",
      "content": [
        "黄花满地，庭院重阳后。",
        "天气凄清透襟袖。",
        "动离情、最苦旅馆萧条，那更堪、风剪凋零飞柳。",
        "临歧曾执手。",
        "祝付叮咛，知会别来念人否。",
        "为多情，生怕分离，只知道、准拟别来消瘦。",
        "甚苦苦、促装赴归期，要趁他、橘绿澄黄时候。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315003,
      "title": "夏云峰",
      "content": [
        "露华清。",
        "天气爽、新秋已觉凉生。",
        "朱户小窗，坐来低按秦筝。",
        "几多妖艳，都总是、白雪馀声。",
        "那更、玉肌肤韵胜，体段轻盈。",
        "照人双眼偏明，况周郎、自来多病多情。",
        "把酒为伊，再三著意须听。",
        "销魂无语，一任侧耳与心倾。",
        "是我不卿卿，更有谁可卿卿。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315004,
      "title": "感皇恩",
      "content": [
        "碧水浸芙容，秋风楚岸。",
        "三岁光阴转头换。",
        "且留都骑，未许匆匆分散。",
        "更持杯酒殷勤劝。",
        "休作等闲，别离人看。",
        "且对笙歌醉须拼。",
        "如君才调，掌得玉堂词翰。",
        "定应不久劳州县。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315005,
      "title": "瑞鹤仙",
      "content": [
        "败荷擎沼面，红叶舞林梢，光阴何速。",
        "碧天静如水，金风透帘幕，露清蝉伏。",
        "追思往事，念当年、悲伤宋玉。",
        "渐危楼向晚，魂销处、倚遍阑干曲。",
        "凝目。",
        "一霎微雨，塞鸿声断，酒病相续。",
        "无情赏处，金井梧，东篱菊。",
        "渐兰桡归去，银蟾满夜，水村烟渡怎宿。",
        "负伊家、万愁千恨，甚时是足。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315006,
      "title": "临江仙",
      "content": [
        "万里西风吹去旆，满城无奈离情。",
        "甘棠也似戴公深。",
        "晓来风露里，叶叶做秋声。",
        "十载两番遗爱在，须知愁满宜春。",
        "楚天低处是归程。",
        "夕阳疏雨外，莫遣乱蝉鸣。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315007,
      "title": "临江仙",
      "content": [
        "枫叶白苹秋未老，晚风吹泛轻艎。",
        "青山沥沥水茫茫。",
        "情随流水远，恨逐暮山长。",
        "一点相思千点泪，眼前无限情伤。",
        "佳人犹自捧离觞。",
        "阳关休唱彻，唱彻断人肠。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315008,
      "title": "鹧鸪天",
      "content": [
        "亭树萧萧生暮凉。",
        "安排清梦到胡床。",
        "楚山楚水秋江外，江北江南客恨长。",
        "苹渚冷，橘汀黄。",
        "断魂残梦更斜阳。",
        "欲将此日悲秋泪，洒向江天哭楚狂。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315009,
      "title": "蓦山溪",
      "content": [
        "木犀开了。",
        "还是生辰到。",
        "一笑对西风，喜人与、花容俱好。",
        "寿筵开处，香雾扑帘帏，笙簧奏，星河晓，拼取金罍倒。",
        "当年仙子，容易抛蓬岛。",
        "月窟与花期，要同向、人间不老。",
        "拈枝弄蕊，此乐几时穷，一岁里，一番新，莫与蟠桃道。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315010,
      "title": "醉落魄・一斛珠",
      "content": [
        "伤离恨别。",
        "愁肠又似丁香结。",
        "不应斗顿音书绝。",
        "烟水连天，何处认红叶。",
        "残更数尽银缸灭。",
        "边城画角声呜咽。",
        "罗衾泪滴相思血。",
        "花影移来，摇碎半窗月。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315011,
      "title": "好事近",
      "content": [
        "初过菊花天，饯送月宫仙客。",
        "丹桂拒霜浓淡，映眉间黄色。",
        "红裙歌夜饮离觞，努力赴劲敌。",
        "惟愿捷书来到，道一声都得。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315012,
      "title": "菩萨蛮",
      "content": [
        "倚楼小小穿针女。",
        "秋光点点蛛丝雨。",
        "今夕是何宵。",
        "龙车乌鹊桥。",
        "经年谋一笑。",
        "岂解令人巧。",
        "不用问如何。",
        "人间巧更多。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315013,
      "title": "卜算子",
      "content": [
        "凉夜竹堂空，小睡匆匆醒。",
        "庭院无人月上阶，满地栏干影。",
        "何处最知秋，风在梧桐井。",
        "夜半骖鸾弄玉笙，露湿衣裳冷。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315014,
      "title": "点绛唇",
      "content": [
        "蓼岸西风，小舟江上渔歌唱。",
        "倚栏凝想。",
        "幂幂云垂帐。",
        "好事因循，寂寞闲惆怅。",
        "如何向。",
        "又来心上。",
        "空向高亭望。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315015,
      "title": "好事近",
      "content": [
        "淅淅蓼花风，怪道晓来凄恻。",
        "翻见密云抛雨，动一山秋色。",
        "从前多感为伤时，无处顿然寂。",
        "个事已寒前约，只晚阴凝碧。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315016,
      "title": "品令",
      "content": [
        "情难托。",
        "离愁重、悄愁没处安著。",
        "那堪更、一叶知秋后，天色儿、渐冷落。",
        "马上征衫频揾泪，一半斑斑污却。",
        "别来为、思忆叮咛话，空赢得、瘦如削。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315017,
      "title": "小重山",
      "content": [
        "一夜西风响翠条。",
        "碧纱窗外雨，长凉飙。",
        "朝来绿涨水平桥。",
        "添清景，疏韵入芭蕉。",
        "坐久篆烟销。",
        "多情人去后，信音遥。",
        "即今消瘦沈郎腰。",
        "悲秋切，虚度可人宵。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315018,
      "title": "采桑子",
      "content": [
        "去年岩桂花香里，著意非常。",
        "月在东厢。",
        "酒与繁华一色黄。",
        "今年杯酒流连处，银烛交光。",
        "往事难忘。",
        "待把真诚问阿郎。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315019,
      "title": "朝中措",
      "content": [
        "柳林幂幂暮烟斜。",
        "秋水浅平沙。",
        "楼外碧天无际，紫山断处横霞。",
        "星稀渐觉，东檐隐月，凉到窗纱。",
        "多少伤怀往事，隔溪灯火人家。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315020,
      "title": "朝中措",
      "content": [
        "征帆一缕转弯斜。",
        "惊鹭起沙汀。",
        "点点随风逆上，满江飞破残霞。",
        "楼前光景，楼心红粉，蝉翼轻纱。",
        "却忆钱塘江上，曲栏横槛他家。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315021,
      "title": "洞仙歌",
      "content": [
        "广寒宫殿，不在人间世。",
        "分付天香与岩桂。",
        "向西风、遥曳处，数十里知闻，金翠里、别有出群标致。",
        "东园盛事。",
        "五亩浓阴芘。",
        "必以诗书取荣贵。",
        "况一门，三秀才，未足钦崇，那更是、异姓同居兄弟。",
        "更细把、繁英祝姮娥，看禹浪飞腾，定应来岁。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315022,
      "title": "似娘儿",
      "content": [
        "橘绿与澄黄。",
        "今小春、已过重阳。",
        "晚来一霎霏微雨，单衣渐觉，西风冷也，无限情伤。",
        "孤馆最凄凉。",
        "天色儿、苦恁凄惶。",
        "离愁一枕灯残后，睡来不是，行行坐坐，月在迥廊。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315023,
      "title": "蝶恋花",
      "content": [
        "一梦十年劳忆记。",
        "社燕宾鸿，来去何容易。",
        "宿酒半醒便午睡。",
        "芭蕉叶映纱窗翠。",
        "衬粉泥书双合字。",
        "鸾凤鸳鸯，总是双双意。",
        "已作吹箫长久计。",
        "鸳衾空有中宵泪。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315024,
      "title": "夜行船",
      "content": [
        "泪眼江头看锦树。",
        "别离又还秋暮。",
        "细水浮浮，轻风冉冉，稳送扁舟去。",
        "归去江山应得助。",
        "新诗定须多赋。",
        "有雁南来，槐溪千万，寄我惊人句。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315025,
      "title": "清平乐",
      "content": [
        "鸿来燕去。",
        "又是秋光暮。",
        "冉冉流年嗟暗度。",
        "这心事还无据。",
        "寒窗露冷风清。",
        "旅魂幽梦频惊。",
        "何日利名俱赛，为予笑下愁城。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315026,
      "title": "清平乐",
      "content": [
        "秋容眼界。",
        "随寓浑堪爱。",
        "远岫连天横淡霭。",
        "望断孤鸿飞外。",
        "夕阳红树林坰。",
        "重重锦障横陈。",
        "一段江南景色，倩谁为下丹青。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315027,
      "title": "一翦梅",
      "content": [
        "霁霭迷空晓未收。",
        "羁馆残灯，永夜悲秋。",
        "梧桐叶上三更雨，别是人间一段愁。",
        "睡又不成梦又休。",
        "多愁多病，当甚风流。",
        "真情一点苦萦人，才下眉尖，恰上心头。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315028,
      "title": "南歌子",
      "content": [
        "此日知何日，他乡忆故乡。",
        "乱山深处过重阳。",
        "走马吹花、无复少年狂。",
        "黄菊擎枝重，红茱湿露香。",
        "扁舟随雁过潇湘。",
        "遥想莱庭、应恨不同觞。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315029,
      "title": "醉花阴",
      "content": [
        "老去悲秋人转瘦。",
        "更异乡重九。",
        "人意自凄凉，只有茱萸，岁岁香依旧。",
        "登高无奈空搔首。",
        "落照归鸦后。",
        "六代旧江山，满眼兴亡，一洗黄花酒。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315030,
      "title": "菩萨蛮",
      "content": [
        "西风转柂蒹葭浦。",
        "客愁生怕秋阑雨。",
        "衾冷梦魂惊。",
        "声声滴到明。",
        "不眠敧枕听。",
        "故故添新恨。",
        "新恨有谁知。",
        "天寒雁正稀。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315031,
      "title": "菩萨蛮",
      "content": [
        "炊烟一点孤村迥。",
        "娇容敛尽天容净。",
        "雁字忽横秋。",
        "秋江泻客愁。",
        "银钩空寄恨。",
        "恨满凭谁问。",
        "袖手立西风。",
        "舟行秋色中。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315032,
      "title": "浣溪沙",
      "content": [
        "雨滴梧桐点点愁。",
        "冷催秋色上帘钩。",
        "蛩声何事早知秋。",
        "一夜凉风惊去燕，满川晴涨漾轻鸥。",
        "怀人千里思悠悠。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315033,
      "title": "满庭芳",
      "content": [
        "晚色沈沈，雨声寂莫，夜寒初冻云头。",
        "晓来阶砌，一捻冷光浮。",
        "目断江天霭霭，低迷映、绿竹修修。",
        "多才客，高吟柳絮，还更上层楼。",
        "烹茶，新试水，人间清楚，物外遨游。",
        "胜似他、销金暖帐情柔。",
        "细看流风迥舞，终日价、浅酌轻讴。",
        "醺醺地，美人翻曲，消尽古今愁。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315034,
      "title": "御街行",
      "content": [
        "晚来无奈伤心处。",
        "见红叶、随风舞。",
        "解鞍还向乱山深，黄昏后、不成情绪。",
        "先来离恨，打叠不下，天气还凄楚。",
        "风儿住后云来去。",
        "装撰些儿雨。",
        "无眠托首对孤灯，好语向谁分付。",
        "从来烦恼，吓得胆碎，此度难担负。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315035,
      "title": "有有令",
      "content": [
        "前山减翠。",
        "疏竹度轻风，日移金影碎。",
        "还又年华暮，看看是、新春至。",
        "那更堪、有个人人，似花似玉，温柔伶俐。",
        "准拟。",
        "恩情忔戏。",
        "拈弄上、则人难比。",
        "我也埋根竖柱，你也争些气。",
        "大家一捺头地。",
        "美中更美。",
        "厮守定、共伊百岁。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315036,
      "title": "摊破丑奴儿・采桑子",
      "content": [
        "树头红叶飞都尽，景物凄凉。",
        "秀出群芳。",
        "又见江梅浅淡妆。",
        "也啰，真个是、可人香。",
        "兰魂蕙魄应羞死，独占风光。",
        "梦断高堂。",
        "月送疏枝过女墙。",
        "也啰，真个是、可人香。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315037,
      "title": "临江仙",
      "content": [
        "日欲低时江景好，暮山紫翠重重。",
        "钓筒收尽碧潭空。",
        "一船霜夜月，两岸荻花风。",
        "遥忆暖春新向火，黄昏下了帘栊。",
        "水村渔浦舣孤篷。",
        "单衾愁梦断，无梦转愁浓。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315038,
      "title": "南歌子",
      "content": [
        "霜结凝寒夜，星辉识晓晴。",
        "兰膏重剔且教明。",
        "为照梢头香缕、一丝轻。",
        "坐久看看困，新词缀未成。",
        "梅花熏得酒初醒。",
        "更向耳边低道、月三更。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315039,
      "title": "永遇乐",
      "content": [
        "宵露珠零，溅冰花薄，凝瑞偏早。",
        "月练轻翻，风刀碎剪，青女呈纤巧。",
        "微丹枫缬，低摧蕉尾，不觉半池莲倒。",
        "最好是、千林橘柚，轻黄一村封了。",
        "佳人指冷，暗惊罗幕，一夜斜飞多少。",
        "怕倚银屏，愁看玉砌，金菊鲜鲜晓。",
        "伤嗟傅粉，佳期还未，何处冷沾衣透。",
        "争知人、临鸾试罢，与梅共瘦。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315040,
      "title": "玉蝴蝶",
      "content": [
        "片片空中剪水，巧妆春色，照耀江湖。",
        "渐觉花球转柳，荚阵飞榆。",
        "散银杯、时时逐马。",
        "翻缟带、一一随车。",
        "遍帘隅。",
        "寒生冰箸，光剖明珠。",
        "应须。",
        "浅斟低唱，毡垂红帐，兽𦶟金炉。",
        "更向高楼，纵观吟醉谢娘扶。",
        "静时闻、竹声岩谷，漫不见、禽影江湖。",
        "尽踌躇。",
        "歌阑宝玉，赋就相如。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315041,
      "title": "潇湘夜雨・满庭芳",
      "content": [
        "斜点银缸，高擎莲炬，夜寒不奈微风。",
        "重重帘幕掩堂中。",
        "香渐远、长烟袅穟，光不定、寒影摇红。",
        "偏奇处，当庭月暗，吐焰如虹。",
        "红裳呈艳丽，□娥一见，无奈狂纵。",
        "试烦他纤手，卷上纱龙。",
        "开正好、银花照夜，堆不尽、金粟凝空。",
        "叮咛语，频将好事，来报主人公。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315042,
      "title": "念奴娇",
      "content": [
        "据炉肃坐，听瓶笙、别有天然宫征。",
        "纸帐屏山浑不俗，写出江南烟水。",
        "檠短灯青，灰闲香软，所欠惟梅矣。",
        "风飞无定，数声时颤窗纸。",
        "试问夜已何其，呼童起看，月上东墙未。",
        "天外忽闻征雁过，还把音书来寄。",
        "短笠埋烟，轻蓑鸣雨，已办征船计。",
        "放教归去，故乡江上鱼美。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315043,
      "title": "摊破丑奴儿・采桑子",
      "content": [
        "又是两分携。",
        "憔悴损、看怎医治。",
        "烟村一带寒红绕，悲风红叶，残阳暮草，还似年时。",
        "愁绪暗犹夷。",
        "谩屈指、数遍归期。",
        "短檠灯烬无人问，此时只有，窗前素月，刚伴相思。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315044,
      "title": "柳梢青",
      "content": [
        "云暗天低。",
        "枫林凋翠，寒雁声悲。",
        "茅店儿前，竹篱巴后，初见横枝。",
        "盈盈粉面香肌。",
        "记月榭、当年见伊。",
        "有恨难传，无肠可断，立马多时。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315045,
      "title": "祝英台近",
      "content": [
        "记临歧，销黯处。",
        "离恨惨歌舞。",
        "恰是江梅，开遍小春暮。",
        "断肠一曲金衣，两行玉箸，酒阑后、欲行难去。",
        "恶情绪。",
        "因念锦幄香奁，别来负情素。",
        "冷落深闺，知解怨人否。",
        "料应宝瑟慵弹，露华懒傅，对鸾镜、终朝凝伫。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315046,
      "title": "点绛唇",
      "content": [
        "瓦湿鸳鸯，夜深霜重江风冷。",
        "月华明映。",
        "清浸梅梢粉。",
        "漏断寒浓，惹起当年恨。",
        "君休问。",
        "雁飞欲尽。",
        "没个南来信。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315047,
      "title": "点绛唇",
      "content": [
        "当日相逢，枕衾清夜纱窗冷。",
        "翠梅低映。",
        "汗湿香腮粉。",
        "美满风情，结下无穷恨。",
        "凭谁问。",
        "此心难尽。",
        "说与他争信。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315048,
      "title": "点绛唇",
      "content": [
        "云霁山横，翠涛拥起千重恨。",
        "砌成愁闷。",
        "那更梅花褪。",
        "凤管云笙，无不萦方寸。",
        "叮咛问。",
        "泪痕羞愠。",
        "界破香腮粉。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315049,
      "title": "柳梢青",
      "content": [
        "千林落叶声声悲。",
        "听凄惨、江皋雁飞。",
        "难似玉肌，总惊花貌，压倒芳菲。",
        "香心吐尽因谁。",
        "料调鼎、工夫易期。",
        "休唱阳关，莫歌白雪，雨泪沾衣。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315050,
      "title": "西江月",
      "content": [
        "背日犹馀残雪，向阳初绽红梅。",
        "腊寒那事更相宜。",
        "醉了还醒又醉。",
        "堪笑多愁早老，管他闲是闲非。",
        "对花酌酒两忘机。",
        "唱个哩啰啰哩。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315051,
      "title": "眼儿媚",
      "content": [
        "一钩新月照西楼。",
        "清夜思悠悠。",
        "那堪更被，征鸿嘹唳，绊惹离愁。",
        "倚栏不语情如醉，都总寄眉头。",
        "从前只为，惜他伶俐，举措风流。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315052,
      "title": "别怨",
      "content": [
        "娇马频嘶。",
        "晓霜浓、寒色侵衣。",
        "凤帷私语处，翻成离怨不胜悲。",
        "更与叮咛祝后期。",
        "素约谐心事，重来了、比看相思。",
        "如何见得，明年春事浓时。",
        "稳乘金腰袅，来烂醉、玉东西。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315053,
      "title": "减字木兰花",
      "content": [
        "小春天气。",
        "未唱阳关心已醉。",
        "红蓼秋容。",
        "后会何时得再逢。",
        "归期好事。",
        "仰看皇州扬雨露。",
        "百里恩波。",
        "拟欲留公无奈何。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315054,
      "title": "好事近",
      "content": [
        "去路马蹄轻，正是小春时节。",
        "爱日暖烘江树，缀梅梢新雪。",
        "范滂揽辔正澄清，知我公明洁。",
        "分此仁风恺悌，济邻邦欢悦。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315055,
      "title": "霜天晓角",
      "content": [
        "合儿幽静处，围炉面小窗。",
        "好是斗头儿坐，梅烟炷、返魂香。",
        "对火怯夜冷，猛饮消漏长。",
        "饮罢且收拾睡，斜月照、满帘霜。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315056,
      "title": "鹧鸪天",
      "content": [
        "宝篆龙煤烧欲残。",
        "细听铜漏已更阑。",
        "纱窗斜月移梅影，特地笼灯仔细看。",
        "幽梦断，旧盟寒。",
        "那时屈曲小屏山。",
        "风光得似而今不，肯把花枝作等闲。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315057,
      "title": "蓦山溪",
      "content": [
        "玉妃整佩，绛节参差御。",
        "一笑唤春回，正江南、天寒岁暮。",
        "孤标独立，占断世间香，云屋冷，雪篱深，长记西湖路。",
        "人间尘土，不是留花处。",
        "羌管一声催，碎琼瑶、纷纷似雨。",
        "枝头著子，聊与世调羹，功就后，盍归休，还记来时不。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315058,
      "title": "浣溪沙",
      "content": [
        "雪压前村曲径迷。",
        "万山寒立玉参差。",
        "孤舟独钓一蓑归。",
        "别坞时听风折竹，断桥闲看水流澌。",
        "一枝冻蕊出疏篱。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315059,
      "title": "浣溪沙",
      "content": [
        "风卷霜林叶叶飞。",
        "雁横寒影一行低。",
        "淡烟衰草不胜诗。",
        "白酒已𥬠浮蚁熟，黄鸡未老藁头肥。",
        "问侬不醉待何时。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315060,
      "title": "浣溪沙",
      "content": [
        "忆为梅花醉不醒。",
        "断桥流水去无声。",
        "鹭翘沙嘴亦多情。",
        "疏影卧波波不动，暗香浮月月微明。",
        "高楼羌管未须横。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315061,
      "title": "点绛唇",
      "content": [
        "离绪千重，角声偏著羁人枕。",
        "那堪酒醒。",
        "句引愁难整。",
        "门锁黄昏，月浸梅花冷。",
        "人初静。",
        "斗垂天迥。",
        "雁落清江影。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315062,
      "title": "鹧鸪天",
      "content": [
        "门外寒江泊小船。",
        "月明留客小窗前。",
        "夜香烧尽更声远，斗帐低垂暖意生。",
        "醺著酒，炙些灯。",
        "伴他针线懒成眠。",
        "情知今夜鸳鸯梦，不似孤篷宿雁边。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315063,
      "title": "望江南・忆江南",
      "content": [
        "山又水，云岫插峰峦。",
        "断雁飞时霜月冷，乱鸦啼处日衔山。",
        "疑在画图间。",
        "金乌转，游子损朱颜。",
        "别泪盈襟双袖湿，春心不放两眉间。",
        "此去几时还。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315064,
      "title": "菩萨蛮",
      "content": [
        "枫林飒飒凋寒叶。",
        "汀苹败蓼遥相接。",
        "景物已非秋。",
        "凄凉动客愁。",
        "还家贫亦好。",
        "肯厌杯中草。",
        "香饭滑流匙。",
        "三登快乐时。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315065,
      "title": "菩萨蛮",
      "content": [
        "霜风飒飒溪山碧。",
        "寒波一望伤行色。",
        "落日淡荒村。",
        "人家半掩门。",
        "孤舟移野渡。",
        "古木栖鸦聚。",
        "著雨晚风酸。",
        "貂裘不奈寒。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315066,
      "title": "菩萨蛮",
      "content": [
        "败荷倒尽芙蓉老。",
        "寒光黯淡迷衰草。",
        "行客易销魂。",
        "笛飞何处村。",
        "云寒天借碧。",
        "树瘦烟笼直。",
        "若个是乡关。",
        "夕阳西去山。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315067,
      "title": "阮郎归",
      "content": [
        "年年为客遍天涯。",
        "梦迟归路赊。",
        "无端星月浸窗纱。",
        "一枝寒影斜。",
        "肠未断，鬓先华。",
        "新来瘦转加。",
        "角声吹彻小梅花。",
        "夜长人忆家。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315068,
      "title": "霜天晓角",
      "content": [
        "香来不歇。",
        "谁把南枝折。",
        "的砾疏花初破，都因是、夜来雪。",
        "清绝。",
        "十分绝。",
        "孤标难细说。",
        "独立野塘清浅，谁作伴、空夜月。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315069,
      "title": "霜天晓角",
      "content": [
        "雪花飞歇。",
        "好向前村折。",
        "行至断桥斜处，寒蕊瘦、不禁雪。",
        "韵绝。",
        "香更绝。",
        "归来人共说。",
        "最爱夜堂深迥，疏影占、半窗月。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315070,
      "title": "菩萨蛮",
      "content": [
        "客帆卸尽风初定。",
        "夜空霜落无江冷。",
        "幸自不思归。",
        "无端乌夜啼。",
        "鸡鸣残月落。",
        "到枕秋声恶。",
        "有酒不须斟。",
        "酒深愁转深。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315071,
      "title": "忆秦娥",
      "content": [
        "寒萧索。",
        "征鸿过尽离怀恶。",
        "离怀恶。",
        "江空天迥，夜寒枫落。",
        "有人应误刀头约。",
        "情深翻恨郎情薄。",
        "郎情薄。",
        "梦回长是，半床闲却。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315072,
      "title": "如梦令",
      "content": [
        "何处一声鸣橹。",
        "惊起满川寒鹭。",
        "一著画难成，雪霁乱山无数。",
        "且住。",
        "且住。",
        "数遍溪南烟树。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315073,
      "title": "水龙吟",
      "content": [
        "危楼横枕清江上，两岸碧山如画。",
        "夕烟幂幂，晚灯点点，楼台新夜。",
        "明月当天，白沙流水，冷光连野。",
        "浸栏干万顷，琉璃软皱，打鱼艇、相高下。",
        "何处一声羌管，是谁家、倚楼人也。",
        "多情对景，无言有恨，欲歌还罢。",
        "把酒临筵，阿谁知我，此怀难写。",
        "忍思量后夜，芳容不似，暗尘随马。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315074,
      "title": "水调歌头",
      "content": [
        "离愁晚如织，托酒与消磨。",
        "奈何酒薄愁重，越醉越愁多。",
        "忍对碧天好夜，皓月流光无际，光影转庭柯。",
        "有恨空垂泪，无语但悲歌。",
        "因凝想，从别后，蹙双蛾。",
        "春来底事，孤负紫袖与红靴。",
        "速整雕鞍归去，著意浅斟低唱，细看小婆娑。",
        "万蕊千花里，一任玉颜酡。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315075,
      "title": "水龙吟",
      "content": [
        "酒潮匀颊双眸溜。",
        "美映远山横秀。",
        "风流俊雅，娇痴体态，眼前稀有。",
        "莲步弯弯，移归拍里，凌波难偶。",
        "对仙源醉眼，玉纤笼巧，拨轻声、鱼纹皱。",
        "我自多情多病，对人前、只推伤酒。",
        "瞒他不得，诗情懒倦，沈腰销瘦。",
        "多谢东君，殷勤知我，曲翻红袖。",
        "拼来朝又是，扶头不起，江楼知不。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315076,
      "title": "念奴娇",
      "content": [
        "夕阳底尽，望楚天空阔，稀星帘幕。",
        "暮霭横江烟万缕，照水参差楼阁。",
        "两两三三，楼前归鹭，飞过栏干角。",
        "霜风何事，绕檐吹动寂寞。",
        "消散我已忘机，而今百念，灰了心头火。",
        "对酒当歌浑冷淡，一任他懑嗔恶。",
        "松竹园林，柳梧庭院，自有人间乐。",
        "闲云休问，去来本是无著。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315077,
      "title": "水调歌头",
      "content": [
        "贪痴无了日，人事没休期。",
        "白驹过隙，百岁能得几多时。",
        "自古腰金结绶，著意经营辛苦，回首不胜悲。",
        "名未能安稳，身已至倾危。",
        "空剜刻，休巧诈，莫心欺。",
        "须知天定，只见高冢与新碑。",
        "我已从头识破，赢得当歌临酒，欢笑且随宜。",
        "较甚荣和辱，争甚是和非。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315078,
      "title": "水龙吟",
      "content": [
        "�稍�著意斟量过，天下事、无穷尽。",
        "贪荣贪富，朝思夕计，空劳方寸。",
        "蹑足封王，功名盖世，谁如韩信。",
        "更堆金积玉，石崇豪侈，当时望、倾西晋。",
        "长乐宫中一叹，又何须累累悬印。",
        "坠楼效死，轻车东市，头膏血刃。",
        "尤物虚名，于身何补，一齐休问。",
        "遇当歌临酒，舒眉展眼，且随缘分。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315079,
      "title": "蓦山溪",
      "content": [
        "壶天冰雪，消尽虚堂暑。",
        "多谢故人风，送花香传小树。",
        "香风初过，一曲断肠声，如怨诉。",
        "诉闲愁，落落琵琶语。",
        "江边马上，弹指成千古。",
        "泪眼与啼妆，叹风流、只今何处。",
        "芳心役损，触事起悲酸，招玉素。",
        "拨檀槽，整理金衣缕。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315080,
      "title": "念奴娇",
      "content": [
        "精神俊雅，更那堪、天与风流标格。",
        "罗绮丛中偏艳冶，偷处教人怜惜。",
        "目剪秋波，指纤春笋，新样冠儿直。",
        "高堂云雨，甚人有分消得。",
        "忔戏笑里含羞，回眸低盼，此意谁能识。",
        "密约幽欢空怅望，何日能谐端的。",
        "玳席歌馀，兰堂香散，此际愁如织。",
        "人归空对，晚阴庭树横碧。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315081,
      "title": "瑞鹤仙",
      "content": [
        "无言屈指也。",
        "算年年底事，长为旅也。",
        "凄惶受尽也。",
        "把良辰美景，总成虚也。",
        "自嗟叹也。",
        "这情怀、如何诉也。",
        "谩愁明怕暗，单栖独宿，怎生禁也。",
        "闲也。",
        "有时临镜，渐觉形容，日消减也。",
        "光阴换也。",
        "空辜负、少年也。",
        "念仙源深处，暖香小院，赢得群花怨也。",
        "是亏他见了，多教骂几句也。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315082,
      "title": "蓦山溪",
      "content": [
        "无非无是。",
        "好个闲居士。",
        "衣食不求人，又识得、三文两字。",
        "不贪不伪，一味乐天真，三径里。",
        "四时花，随分堪游戏。",
        "学些沓拖，也似没意志。",
        "诗酒度流年，熟谙得、无争三昧。",
        "风波歧路，成败霎时间，你富贵。",
        "你荣华，我自关门睡。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315083,
      "title": "青玉案",
      "content": [
        "东门杨柳空盈路。",
        "系得征鞍能驻不。",
        "暗绿枝头新过雨。",
        "柔丝千尺，乳莺百啭，似怨行人去。",
        "行人去后如何处。",
        "去向天边簉鹓鹭。",
        "瑶管琼台多雅趣。",
        "花砖稳上，玉阶阔步，肯念人尘土。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315084,
      "title": "虞美人",
      "content": [
        "雨声破晓催行桨。",
        "拍拍溪流长。",
        "绿杨绕岸水痕斜。",
        "恰似画桥西畔、那人家。",
        "人家楼阁临江渚。",
        "应是停歌舞。",
        "珠帘整日不闲钩。",
        "目断征帆、犹未识归舟。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315085,
      "title": "虞美人",
      "content": [
        "灯前忍见啼红面。",
        "别酒频斟劝。",
        "愁蛾敛翠不胜情。",
        "报道看看天色、待平明。",
        "殷勤重把阳关唱。",
        "休要教人望。",
        "出门犹自尚叮咛。",
        "厮养频催恰好、趁凉行。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315086,
      "title": "临江仙",
      "content": [
        "十里春风杨柳路，年年带雨披云。",
        "柔条万缕不胜情。",
        "还将无意眼，识遍有心人。",
        "饿损宫腰终不似，效颦总是难成。",
        "只愁秋色入高林。",
        "残蝉和落叶，此际不堪论。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315087,
      "title": "渔家傲",
      "content": [
        "客里情怀谁可表。",
        "凄凉举目知多少。",
        "强饮强歌还强笑。",
        "心悄悄。",
        "从头彻底思量了。",
        "当日相逢非草草。",
        "果然恩爱成烦恼。",
        "稳整征鞍归去好。",
        "重厮守。",
        "相期待与同偕老。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315088,
      "title": "江神子・江城子",
      "content": [
        "当时得意两心齐。",
        "绮窗西。",
        "共于飞。",
        "拂掠宫妆，长与画新眉。",
        "一自别来烟水阔，愁易积，梦还稀。",
        "相逢恰似旧家时。",
        "恨依依。",
        "语低低。",
        "多少关情，冷暖有谁知。",
        "只此定应谐素愿，但指日，约鸾栖。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315089,
      "title": "御街行",
      "content": [
        "香熏斗帐相逢乍。",
        "正宫漏、沈沈夜。",
        "月飞梅影上帘栊，标致风流娇雅。",
        "眼波横浸，照人百媚，无限叮咛话。",
        "玉鞍门上嘶归马。",
        "趱行色、难留也。",
        "别来花艳不禁春，浪向东风轻嫁。",
        "空馀小院，博山修竹，依旧窗儿下。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315090,
      "title": "一丛花",
      "content": [
        "当歌临酒恨难穷。",
        "酒不似愁浓。",
        "风帆正起归与兴，岸东西、芳草茸茸。",
        "楚梦乍回，吴音初听，谁念我孤踪。",
        "藏春小院暖融融。",
        "眼色与心通。",
        "乌云有意重梳掠，便安排、金屋房栊。",
        "云雨厚因，鸳鸯宿债，作个好家风。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315091,
      "title": "天仙子",
      "content": [
        "眼色媚人娇欲度。",
        "行尽巫阳云又雨。",
        "花时还复见芳姿，情几许。",
        "愁何许。",
        "莫向耳边传好语。",
        "往事悠悠曾记否。",
        "忍听黄鹂啼锦树。",
        "啼声惊碎百花心。",
        "分付与。",
        "谁为主。",
        "落蕊飞红知甚处。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315092,
      "title": "瑞鹧鸪",
      "content": [
        "宝奁常见晓妆时。",
        "面药香融傅口脂。",
        "扰扰亲曾撩绿鬓，纤纤巧与画新眉。",
        "浓欢已散西风远，忆泪无多为你垂。",
        "各自从今好消遣，莫将红叶浪题诗。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315093,
      "title": "瑞鹧鸪",
      "content": [
        "结丝千绪不胜愁。",
        "莫怪安仁鬓早秋。",
        "檀口未歌先愠泪，柳眉将敛半凝羞。",
        "杯倾潋滟送行酒，岸舣飘飘欲去舟。",
        "待得名登天府后，归来茱菊映钗头。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315094,
      "title": "行香子",
      "content": [
        "骄马花骢。",
        "柳陌经从。",
        "小春天、十里和风。",
        "个人家住，曲巷墙东。",
        "好轩窗，好体面，好仪容。",
        "烛灺歌慵。",
        "斜月朦胧。",
        "夜新寒、斗帐香浓。",
        "梦回画角，云雨匆匆。",
        "恨相逢，恨分散，恨情锺。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315095,
      "title": "夜行船",
      "content": [
        "龟甲炉烟轻袅。",
        "帘栊静、乳莺啼晓。",
        "拂掠新妆，时宜头面，绣草冠儿小。",
        "衫子揉蓝初著了。",
        "身材称、就中恰好。",
        "手拈双纨，菱花重照，带朵宜男草。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315096,
      "title": "采桑子",
      "content": [
        "疏帘乍卷孜孜看，冰玉精神。",
        "体白停匀。",
        "端的于人不薄情。",
        "更无背约和焦燥，各表真诚。",
        "才得相亲。",
        "切莫分张向别人。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315097,
      "title": "蝶恋花",
      "content": [
        "闲上西楼供远望。",
        "一曲新声，巧媚谁家唱。",
        "独倚危栏听半晌。",
        "长江快泻澄无浪。",
        "清泪恰同清水涨。",
        "拭尽重流，触事如何向。",
        "不觉黄昏灯已上。",
        "旧愁还是新愁样。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315098,
      "title": "蝶恋花",
      "content": [
        "天净姮娥初整驾。",
        "桂魄蟾辉，来趁清和夜。",
        "费尽丹青无计画。",
        "纤纤侧向疏桐挂。",
        "人在扶疏桐影下。",
        "耳畔轻轻，细说家常话。",
        "年少难留应不借。",
        "未歌先咽歌还罢。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315099,
      "title": "蝶恋花",
      "content": [
        "叶底蜂衙催日晚。",
        "向晚匀妆，巧画宫眉浅。",
        "翠幕无风香自远。",
        "金船酌酒须教满。",
        "未说别离魂已断。",
        "雨幌云屏，只恐良宵短。",
        "心事不随飞絮乱。",
        "宦情肯把恩情换。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 315100,
      "title": "鹧鸪天",
      "content": [
        "睡觉扶头听晓钟。",
        "隔帘花雾湿香红。",
        "翠摇钿砌梧桐影，暖透罗襦芍药风。",
        "闲对影，记曾逢。",
        "画眉临镜霎时同。",
        "相思已有无穷恨，忍见孤鸾宿镜中。"
      ],
      "author": {
        "id": 2137,
        "name": "赵长卿"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    }
  ],
