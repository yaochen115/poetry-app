{
  "data": [
    {
      "id": 312996,
      "title": "怨春郎",
      "content": [
        "为伊家，终日闷。",
        "受尽恓惶谁问。",
        "不知不觉上心头，悄一霎身心，顿也没处顿。",
        "恼愁肠，成寸寸。",
        "已恁莫把人萦损。",
        "奈每每人前道著伊，空把相思泪眼和衣揾。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312997,
      "title": "滴滴金",
      "content": [
        "尊前一把横波溜。",
        "彼此心儿有。",
        "曲屏深幌解香罗，花灯微透。",
        "偎人欲语眉先皱。",
        "红玉困春酒。",
        "为问鸳衾这回后。",
        "几时重又。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312998,
      "title": "卜算子",
      "content": [
        "极得醉中眠，迤逦翻成病。",
        "莫是前生负你来，今世里、教孤冷。",
        "言约全无定。",
        "是谁先薄幸。",
        "不惯孤眠惯成双，奈奴子、心肠硬。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312999,
      "title": "感庭秋・撼庭秋",
      "content": [
        "红笺封了还重拆。",
        "这添追忆。",
        "且教伊见我，别来翠减香销端的。",
        "渌波平远，暮山重叠，算难凭鳞翼。",
        "倚危楼极目，无情细草长天色。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313000,
      "title": "满路花・促拍满路花",
      "content": [
        "铜荷融烛泪，金兽啮扉环。",
        "兰堂春夜疑，惜更残。",
        "落花风雨，向晓作轻寒。",
        "金龟朝早，香衾馀暖，𣨼娇由自慵眠。",
        "小鬟无事须来唤，呵破点唇檀。",
        "回身还、却背屏山。",
        "春禽飞下，帘外日三竿。",
        "起来云鬓乱，不妆红粉，下阶且上秋千。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313001,
      "title": "好女儿令・好女儿",
      "content": [
        "眼细眉长。",
        "宫样梳妆。",
        "靸鞋儿走向花下立著。",
        "一身绣出，两同心字，浅浅金黄。",
        "早是肌肤轻渺，抱著了、暖仍香。",
        "姿姿媚媚端正好，怎教人别后，从头仔细，断得思量。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313002,
      "title": "南乡子",
      "content": [
        "浅浅画双眉。",
        "取次梳妆也便宜。",
        "洒着胭脂红扑面，须知。",
        "更有何人得似伊。",
        "宝帐烛残时。",
        "好个温柔模样儿。",
        "月里仙郎清似玉，相期。",
        "些子精神更与谁。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313003,
      "title": "南乡子",
      "content": [
        "好个人人，深点唇儿淡抹腮。",
        "花下相逢、忙走怕人猜。",
        "遗下弓弓小绣鞋。",
        "刬袜重来。",
        "半亸乌云金凤钗。",
        "行笑行行连抱得，相挨。",
        "一向娇痴不下怀。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313004,
      "title": "踏莎行",
      "content": [
        "碧藓回廊，绿杨深院。",
        "偷期夜入帘犹卷。",
        "照人无奈月华明，潜身却恨花深浅。",
        "密约如沈，前欢未便。",
        "看看掷尽金壶箭。",
        "阑干敲遍不应人，分明帘下闻裁剪。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313005,
      "title": "踏莎行",
      "content": [
        "云母屏低，流苏帐小。",
        "矮床薄被秋将晓。",
        "乍凉天气未寒时，平明窗外闻啼鸟。",
        "困𣨼榴花，香添蕙草。",
        "佳期须及朱颜好。",
        "莫言多病为多情，此身甘向情中老。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313006,
      "title": "诉衷情",
      "content": [
        "歌时眉黛舞时腰。",
        "无处不娇饶。",
        "初剪菊、欲登高。",
        "天气怯鲛绡。",
        "紫丝障，绿杨桥。",
        "路迢迢。",
        "酒阑歌罢，一度归时，一度魂消。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313007,
      "title": "诉衷情",
      "content": [
        "离怀酒病两忡忡。",
        "倚枕梦无踪。",
        "可怜有人今夜，胆小怯房空。",
        "杨柳绿，杏梢红。",
        "负春风。",
        "迢迢别恨，脉脉归心，付与征鸿。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313008,
      "title": "恨春迟",
      "content": [
        "欲借江梅荐饮。",
        "望陇驿、音息沈沈。",
        "住在柳州东，彼此相思，梦回云去难寻。",
        "归燕来时花期浸。",
        "淡月坠、将晓还阴。",
        "争奈多情易感，风信无凭，如何消遣初心。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313009,
      "title": "盐角儿",
      "content": [
        "增之太长，减之太短，出群风格。",
        "施朱太赤，施粉太白，倾城颜色。",
        "慧多多，娇的的。",
        "天付与、教谁怜惜。",
        "除非我、偎著抱著，更有何人消得。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313010,
      "title": "盐角儿",
      "content": [
        "人生最苦，少年不得，鸳帏相守。",
        "西风时节，那堪话别，双蛾频皱。",
        "暗消魂，重回首。",
        "奈心儿里、彼此皆有。",
        "后时我、两个相见，管取一双清瘦。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313011,
      "title": "忆秦娥",
      "content": [
        "十五六，脱罗裳，长恁黛眉蹙。",
        "红玉暖，入人怀，春困熟。",
        "展香裀，帐前明画烛。",
        "眼波长，斜浸鬓云绿。",
        "看不足。",
        "苦残宵、更漏促。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313012,
      "title": "少年游",
      "content": [
        "绿云双亸插金翘。",
        "年纪正妖饶。",
        "汉妃束素，小蛮垂柳，都占洛城腰。",
        "锦屏春过衣初减，香雪暖凝消。",
        "试问当筵眼波恨，滴滴为谁娇。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313013,
      "title": "踏莎行慢",
      "content": [
        "独自上孤舟。",
        "倚危樯目断。",
        "难成暮雨，更朝云散。",
        "凉劲残叶乱。",
        "新月照、澄波浅。",
        "今夜里，厌厌离绪难销遣。",
        "强来就枕，灯残漏永，合相思眼。",
        "分明梦见如花面。",
        "依前是、旧庭院。",
        "新月照，罗幕挂，珠帘卷。",
        "渐向晓，脉然睡觉如天远。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313014,
      "title": "蕙香囊・鹊桥仙",
      "content": [
        "身作琵琶，调全宫羽，佳人自然用意。",
        "宝檀槽在雪胸前，倚香脐、横枕琼臂。",
        "组带金钩，背垂红绶，纤指转弦韵细。",
        "愿伊只恁拨梁州，且多时、得在怀里。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313015,
      "title": "玉楼春",
      "content": [
        "艳冶风情天与措。",
        "清瘦肌肤冰雪妒。",
        "百年心事一宵同，愁听鸡声窗外度。",
        "信阻青禽云雨暮。",
        "海月空惊人两处。",
        "强将离恨倚江楼，江水不能流恨去。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313016,
      "title": "玉楼春",
      "content": [
        "半辐霜绡亲手剪。",
        "香染青蛾和泪卷。",
        "画时横接媚霞长，印处双沾愁黛浅。",
        "当时付我情何限。",
        "欲使妆痕长在眼。",
        "一回忆著一拈看，便似花前重见面。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313017,
      "title": "玉楼春",
      "content": [
        "红楼昨夜相将饮。",
        "月近珠帘花近枕。",
        "银缸照客酒方酣，玉漏催人街已禁。",
        "晚潮去棹浮清浸。",
        "古岸平芜萧索甚。",
        "大都薄宦足离愁，不放双鸳长恁恁。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313018,
      "title": "玉楼春",
      "content": [
        "金雀双鬟年纪小。",
        "学画蛾眉红淡扫。",
        "尽人言语尽人怜，不解此情惟解笑。",
        "稳着舞衣行动俏。",
        "走向绮筵呈曲妙。",
        "刘郎大有惜花心，只恨寻花来较早。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313019,
      "title": "玉楼春",
      "content": [
        "夜来枕上争闲事。",
        "推倒屏山褰绣被。",
        "尽人求守不应人，走向碧纱窗下睡。",
        "直到起来由自𣨼。",
        "向道夜来真个醉。",
        "大家恶发大家休，毕竟到头谁不是。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313020,
      "title": "定风波",
      "content": [
        "把酒花前欲问伊。",
        "问伊还记那回时。",
        "黯淡梨花笼月影。",
        "人静。",
        "画堂东畔药阑西。",
        "及至如今都不认。",
        "难问。",
        "有情谁道不相思。",
        "何事碧窗春睡觉。",
        "偷照。",
        "粉痕匀却湿胭脂。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313021,
      "title": "减字木兰花",
      "content": [
        "去年残腊。",
        "曾折梅花相对插。",
        "人面而今。",
        "空有花开无处寻。",
        "天天不远。",
        "把酒拈花重发愿。",
        "愿得和伊。",
        "偎雪眠香似旧时。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313022,
      "title": "减字木兰花",
      "content": [
        "年来方寸。",
        "十日幽欢千日恨。",
        "未会此情。",
        "白尽人头可得平。",
        "区区堪比。",
        "水趁浮萍风趁水。",
        "试望瑶京。",
        "芳草随人上古城。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313023,
      "title": "迎春乐",
      "content": [
        "薄纱衫子裙腰匝。",
        "步轻轻、小罗靸。",
        "人前爱把眼儿札。",
        "香汗透、胭脂蜡。",
        "良夜永、幽期欢则洽。",
        "约重会、玉纤频插。",
        "执手临归，犹且更待留时霎。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313024,
      "title": "一落索",
      "content": [
        "小桃风撼香红碎。",
        "满帘笼花气。",
        "看花何事却成愁，悄不会、春风意。",
        "窗在梧桐叶底。",
        "更黄昏雨细。",
        "枕前前事上心来，独自个、怎生睡。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313025,
      "title": "夜行船",
      "content": [
        "闲把鸳衾横枕。",
        "损眉尖、泪痕红沁。",
        "花时良夜不归来，忍频听、漏移清禁。",
        "一饷无言都未寝。",
        "忆当初、是谁先恁。",
        "及至如今，教人成病，风流万般徒甚。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313026,
      "title": "夜行船",
      "content": [
        "轻捧香腮低枕。",
        "眼波媚、向人相浸。",
        "佯娇佯醉索如今，这风情、怎教人禁。",
        "却与和衣推未寝。",
        "低声地、告人休恁。",
        "月夕花朝，不成虚过，芳年嫁君徒甚。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313027,
      "title": "望江南・忆江南",
      "content": [
        "江南柳，花柳两相柔。",
        "花片落时粘酒盏，柳条低处拂人头。",
        "各自是风流。",
        "江南月，如镜复如钩。",
        "似镜不侵红粉面，似钩不挂画帘头。",
        "长是照离愁。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313028,
      "title": "望江南・忆江南",
      "content": [
        "江南柳，叶小未成阴。",
        "人为丝轻那忍折，莺嫌枝嫩不胜吟。",
        "留著待春深。",
        "十四五，闲抱琵琶寻。",
        "阶上簸钱阶下走，恁时相见早留心。",
        "何况到如今。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313029,
      "title": "宴瑶池・越江吟",
      "content": [
        "恋眼哝心终未改。",
        "向意间长在。",
        "都缘为、颜色殊常，见馀花、尽无心爱。",
        "都为是风流㬠。",
        "至他人、强来厮壤。",
        "从今后、若得相逢，绣帏里、痛惜娇态。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313030,
      "title": "解仙佩",
      "content": [
        "有个人人牵系。",
        "泪成痕、滴尽罗衣。",
        "问海约山盟何时。",
        "镇教人、目断魂飞。",
        "梦里似偎人睡。",
        "肌肤依旧骨香腻。",
        "觉来但堆鸳被。",
        "想忡忡、那里争知。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313031,
      "title": "渔家傲",
      "content": [
        "战胜归来飞捷奏。",
        "倾贺酒。",
        "玉阶遥献南山寿。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313032,
      "title": "少年游",
      "content": [
        "阑干十二独凭春。",
        "晴碧远连云。",
        "千里万里，二月三月，行色苦愁人。",
        "谢家池上，江淹浦畔，吟魄与离魂。",
        "那堪疏雨滴黄昏。",
        "更特地、忆王孙。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313033,
      "title": "桃源忆故人",
      "content": [
        "碧纱影弄东风晓。",
        "一夜海棠开了。",
        "枝上数声啼鸟。",
        "妆点愁多少。",
        "妒云恨雨腰支袅。",
        "眉黛不忺重扫。",
        "薄幸不来春老。",
        "羞带宜男草。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313034,
      "title": "阮郎归",
      "content": [
        "雪霜林际见依稀。",
        "清香已暗期。",
        "前村已遍倚南枝。",
        "群花犹未知。",
        "情似旧，赏休迟。",
        "看看陇上吹。",
        "便从今日赏芳菲。",
        "韶华取次归。"
      ],
      "author": {
        "id": 4748,
        "name": "欧阳修"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313035,
      "title": "南乡子",
      "content": [
        "江上野梅芳。",
        "粉色盈盈照路傍。",
        "闲折一枝和雪嗅，思量。",
        "似个人人玉体香。",
        "特地起愁肠。",
        "此恨谁人与寄将。",
        "山馆寂寥天欲暮，凄凉。",
        "人转迢迢路转长。"
      ],
      "author": {
        "id": 3405,
        "name": "荣"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313036,
      "title": "定风波",
      "content": [
        "把酒花前欲问天。",
        "春来秋去苦茫然。",
        "风雨满枝花满地。",
        "何事。",
        "却教纤草占流年。",
        "试把钿筝重促柱。",
        "无绪。",
        "酒阑清泪滴朱弦。",
        "赖有玉人相顾好。",
        "轻笑。",
        "却疑春色在婵娟。"
      ],
      "author": {
        "id": 3987,
        "name": "王琪"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313037,
      "title": "祝英台・祝英台近",
      "content": [
        "可堪妒柳羞花，下床都懒，便瘦也教春知道。"
      ],
      "author": {
        "id": 3987,
        "name": "王琪"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313038,
      "title": "望江南・忆江南",
      "content": [
        "江南柳，烟穗拂人轻。",
        "愁黛空长描不似，舞腰虽瘦学难成。",
        "天意与风情。",
        "攀折处，离恨几时平。",
        "已纵柔条萦客棹，更飞狂絮扑旗亭。",
        "三月乱莺声。"
      ],
      "author": {
        "id": 3987,
        "name": "王琪"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313039,
      "title": "望江南・忆江南",
      "content": [
        "江南酒，何处味偏浓。",
        "醉卧春风深巷里，晓寻香旆小桥东。",
        "竹叶满金锺。",
        "檀板醉，人面粉生红。",
        "青杏黄梅朱阁上，鲥鱼苦笋玉盘中。",
        "酩酊任愁攻。"
      ],
      "author": {
        "id": 3987,
        "name": "王琪"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313040,
      "title": "望江南・忆江南",
      "content": [
        "江南燕，轻扬绣帘风。",
        "二月池塘新社过，六朝宫殿旧巢空。",
        "颉颃恣西东。",
        "王谢宅，曾入绮堂中。",
        "烟径掠花飞远远，晓窗惊梦语匆匆。",
        "偏占杏园红。"
      ],
      "author": {
        "id": 3987,
        "name": "王琪"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313041,
      "title": "望江南・忆江南",
      "content": [
        "江南竹，清润绝纤埃。",
        "深径欲留双凤宿，后庭偏映小桃开。",
        "风月影徘徊。",
        "寒玉瘦，霜霰信相催。",
        "粉泪空流妆点在，羊车曾傍翠枝来。",
        "龙笛莫轻裁。"
      ],
      "author": {
        "id": 3987,
        "name": "王琪"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313042,
      "title": "望江南・忆江南",
      "content": [
        "江南草，如种复如描。",
        "深映落花莺舌乱，绿迷南浦客魂消。",
        "日日斗青袍。",
        "风欲转，柔态不胜娇。",
        "远翠天涯经夜雨，冷痕沙上带昏潮。",
        "谁梦与兰苕。"
      ],
      "author": {
        "id": 3987,
        "name": "王琪"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313043,
      "title": "望江南・忆江南",
      "content": [
        "江南雨，风送满长川。",
        "碧瓦烟昏沈柳岸，红绡香润入梅天。",
        "飘洒正潇然。",
        "朝与暮，长在楚峰前。",
        "寒夜愁敧金带枕，暮江深闭木兰船。",
        "烟浪远相连。"
      ],
      "author": {
        "id": 3987,
        "name": "王琪"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313044,
      "title": "望江南・忆江南",
      "content": [
        "江南水，江路转平沙。",
        "雨霁高烟收素练，风晴细浪吐寒花。",
        "迢递送星槎。",
        "名利客，飘泊未还家。",
        "西塞山前渔唱远，洞庭波上雁行斜。",
        "征棹宿天涯。"
      ],
      "author": {
        "id": 3987,
        "name": "王琪"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313045,
      "title": "望江南・忆江南",
      "content": [
        "江南岸，云树半晴阴。",
        "帆去帆来天亦老，潮生潮落日还沈。",
        "南北别离心。",
        "兴废事，千古一沾襟。",
        "山下孤烟渔市晓，柳边疏雨酒家深。",
        "行客莫登临。"
      ],
      "author": {
        "id": 3987,
        "name": "王琪"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313046,
      "title": "望江南・忆江南",
      "content": [
        "江南月，清夜满西楼。",
        "云落开时冰吐鉴，浪花深处玉沈钩。",
        "圆缺几时休。",
        "星汉迥，风露入新秋。",
        "丹桂不知摇落恨，素娥应信别离愁。",
        "天上共悠悠。"
      ],
      "author": {
        "id": 3987,
        "name": "王琪"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313047,
      "title": "望江南・忆江南",
      "content": [
        "江南雪，轻素剪云端。",
        "琼树忽惊春意早，梅花偏觉晓香寒。",
        "冷影褫清欢。",
        "蟾玉迥，清夜好重看。",
        "谢女联诗衾翠幕，子猷乘兴泛平澜。",
        "空惜舞英残。"
      ],
      "author": {
        "id": 3987,
        "name": "王琪"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313048,
      "title": "失调名",
      "content": [
        "金斗熨秋江。"
      ],
      "author": {
        "id": 3987,
        "name": "王琪"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313049,
      "title": "一络索・一落萦",
      "content": [
        "蜀江春色浓如雾。",
        "拥双旌归去。",
        "海棠也似别君难，一点点、啼红雨。",
        "此去马蹄何处。",
        "沙堤新路。",
        "禁林赐宴赏花时，还忆著、西楼否。"
      ],
      "author": {
        "id": 2600,
        "name": "陈凤仪"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313050,
      "title": "水调歌头",
      "content": [
        "潇洒太湖岸，淡伫洞庭山。",
        "鱼龙隐处，烟雾深锁渺弥间。",
        "方念陶朱张翰，忽有扁舟急桨，撇浪载鲈还。",
        "落日暴风雨，归路绕汀湾。",
        "丈夫志，当景盛，耻疏闲。",
        "壮年何事憔悴，华发改朱颜。",
        "拟借寒潭垂钓，又恐鸥鸟相猜，不肯傍青纶。",
        "刺棹穿芦荻，无语看波澜。"
      ],
      "author": {
        "id": 13077,
        "name": "苏舜钦"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313051,
      "title": "永遇乐",
      "content": [
        "风暖莺娇，露浓花重，天气和煦。",
        "院落烟收，垂杨舞困，无奈堆金缕。",
        "谁家巧纵，青楼弦管，惹起梦云情绪。",
        "忆当时、纹衾粲枕，未尝暂孤鸳侣。",
        "芳菲易老，故人难聚。",
        "到此翻成轻误。",
        "阆苑仙遥，蛮笺纵写、何计传深诉。",
        "青山绿水，古今长在，惟有旧欢何处。",
        "空赢得、斜阳暮草，淡烟细雨。"
      ],
      "author": {
        "id": 130,
        "name": "解"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313052,
      "title": "阳台梦",
      "content": [
        "仙姿本寓。",
        "十二峰前住。",
        "千里行云行雨。",
        "偶因鹤驭过巫阳。",
        "邂逅他、楚襄王。",
        "无端宋玉夸才赋。",
        "诬诞人心素。",
        "至今狂客到阳台。",
        "也有痴心，望妾入、梦中来。"
      ],
      "author": {
        "id": 130,
        "name": "解"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313053,
      "title": "点绛唇",
      "content": [
        "病起恹恹，画堂花谢添憔悴。",
        "乱红飘砌。",
        "滴尽胭脂泪。",
        "惆怅前春，谁向花前醉。",
        "愁无际。",
        "武陵回睇。",
        "人远波空翠。"
      ],
      "author": {
        "id": 12016,
        "name": "韩琦"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313054,
      "title": "维扬好",
      "content": [
        "二十四桥千步柳，春风十里上珠帘。"
      ],
      "author": {
        "id": 12016,
        "name": "韩琦"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313055,
      "title": "安阳好・忆江南",
      "content": [
        "安阳好，形势魏西州。",
        "曼衍山川环故国，升平歌吹沸高楼。",
        "和气镇飞浮。",
        "笼画陌，乔木几春秋。",
        "花外轩窗排远岫，竹间门巷带长流。",
        "风物更清幽。"
      ],
      "author": {
        "id": 12016,
        "name": "韩琦"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313056,
      "title": "安阳好・忆江南",
      "content": [
        "安阳好，戟户使君宫。",
        "白昼锦衣清宴处，铁楹丹榭画图中。",
        "壁记旧三公。",
        "棠讼悄，池馆北园通。",
        "夏夜泉声来枕簟，春来花气透帘栊。",
        "行乐兴何穷。"
      ],
      "author": {
        "id": 12016,
        "name": "韩琦"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313057,
      "title": "望江南・忆江南",
      "content": [
        "维杨好，灵宇有琼花。",
        "千点真珠擎素蕊，一环名玉破香葩。",
        "芳艳信难加。",
        "如雪貌，绰约最堪夸。",
        "疑是八仙乘皓月，羽衣摇曳上云车。",
        "来会列仙家。"
      ],
      "author": {
        "id": 12016,
        "name": "韩琦"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313058,
      "title": "失调名",
      "content": [
        "不是这，下辈无礼，都缘是我，自家遭逢。"
      ],
      "author": {
        "id": 10563,
        "name": "沈唐"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313059,
      "title": "雨中花・夜行船",
      "content": [
        "有谁念我、如今霜鬓，远赴边堠。",
        "……身在碧云西畔，情随陇水东流。"
      ],
      "author": {
        "id": 10563,
        "name": "沈唐"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313060,
      "title": "霜叶飞",
      "content": [
        "霜林凋晚，危楼迥，登临无限秋思。",
        "望中闲想，洞庭波面，乱红初坠。",
        "更萧索、风吹渭水。",
        "长安飞舞千门里。",
        "变景摧芳榭，唯有兰衰暮丛，菊残馀蕊。",
        "回念花满华堂，美人一去，镇掩香闺经岁。",
        "又观珠露，碎点苍苔，败梧飘砌。",
        "谩赢得、相思泪眼，东君早作归来计。",
        "便莫惜丹青手，重与芳菲，万红千翠。"
      ],
      "author": {
        "id": 10563,
        "name": "沈唐"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313061,
      "title": "念奴娇",
      "content": [
        "杏花过雨，渐残红零落，胭脂颜色。",
        "流水飘香人渐远，难托春心脉脉。",
        "恨别王孙，墙阴目断，手把青梅摘。",
        "金鞍何处，绿杨依旧南陌。",
        "消散云雨须臾，多情因甚，有轻离轻拆。",
        "燕语千般，争解说、些子伊家消息。",
        "厚约深盟，除非重见，见了方端的。",
        "而今无奈，寸肠千恨堆积。"
      ],
      "author": {
        "id": 10563,
        "name": "沈唐"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313062,
      "title": "望海潮",
      "content": [
        "山光凝翠，川容如画，名都自古并州。",
        "箫鼓沸天，弓刀似水，连营十万貔貅。",
        "金骑走长楸。",
        "少年人一一，锦带吴钩。",
        "路入榆关，雁飞汾水正宜秋。",
        "追思昔日风流。",
        "有儒将醉吟，才子狂游。",
        "松偃旧亭，城高故国，空馀舞榭歌楼。",
        "方面倚贤候。",
        "便恐为霖雨，归去难留。",
        "好向西溪，恣携弦管宴兰舟。"
      ],
      "author": {
        "id": 10563,
        "name": "沈唐"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313063,
      "title": "望南云慢",
      "content": [
        "木叶轻飞，乍雨歇亭皋，帘卷秋光。",
        "栏隈砌角，绽拒霜几处，蓓深浅红芳。",
        "应恨开时晚，伴翠菊、风前并香。",
        "晓来寒露，嫩脸低凝，似带啼妆。",
        "堪伤。",
        "记得佳人，当时怨别，盈腮泪粉行行。",
        "而今最苦，奈千里身心，两处凄凉。",
        "感物成消黯，念旧欢、空劳寸肠。",
        "月斜残漏，梦断孤帏，一枕思量。"
      ],
      "author": {
        "id": 10563,
        "name": "沈唐"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313064,
      "title": "鹤冲天",
      "content": [
        "清明天气。",
        "永日愁如醉。",
        "台榭绿阴浓，薰风细。",
        "燕子巢方就，盆池小，新荷蔽。",
        "恰是逍遥际。",
        "单夹衣裳，半栊软玉肌体。",
        "石榴美艳，一撮红绡比。",
        "窗外数修篁，寒相倚。",
        "有个关心处，难相见、空凝睇。",
        "行坐深闺里。",
        "懒更妆梳，自知新来憔悴。"
      ],
      "author": {
        "id": 11741,
        "name": "杜安世"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313065,
      "title": "两同心",
      "content": [
        "巍巍剑外，寒霜覆林枝。",
        "望衰柳、尚色依依。",
        "暮天静、雁阵高飞。",
        "入碧云际。",
        "江山秋色，遣客心悲。",
        "蜀道巇崄行迟。",
        "瞻京都迢递。",
        "听巴峡、数声猿啼。",
        "惟独个、未有归计。",
        "谩空怅望，每每无言，独对斜晖。"
      ],
      "author": {
        "id": 11741,
        "name": "杜安世"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313066,
      "title": "玉阑干",
      "content": [
        "珠帘怕卷春残景。",
        "小雨牡丹零欲尽。",
        "庭轩悄悄燕高空，风飘絮、绿苔侵径。",
        "欲将幽恨传愁信。",
        "想后期、无个凭定。",
        "几回独睡不思量，还悠悠、梦里寻趁。"
      ],
      "author": {
        "id": 11741,
        "name": "杜安世"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313067,
      "title": "浣溪沙",
      "content": [
        "模样偏宜掌上怜。",
        "云如双鬓玉如颜。",
        "身材轻妙眼儿单。",
        "幽会未成双怅望，深情欲诉两艰难。",
        "空教魂梦到巫山。"
      ],
      "author": {
        "id": 11741,
        "name": "杜安世"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313068,
      "title": "浣溪沙",
      "content": [
        "横画功夫想未全。",
        "双双文彩羽仪鲜。",
        "和鸣偕老是天然。",
        "暮雨并深流细草，暖风交颈傍清涟。",
        "羡他真个好因缘。"
      ],
      "author": {
        "id": 11741,
        "name": "杜安世"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313069,
      "title": "惜春令",
      "content": [
        "春梦无凭犹懒起。",
        "银烛尽、画帘低垂。",
        "小庭杨柳黄金翠，桃脸两三枝。",
        "妆阁慵梳洗。",
        "闷无绪、玉箫抛掷。",
        "絮飘纷纷人疏远，空对日迟迟。"
      ],
      "author": {
        "id": 11741,
        "name": "杜安世"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313070,
      "title": "惜春令",
      "content": [
        "今夕重阳秋意深。",
        "篱边散、嫩菊开金。",
        "万里霜天林叶坠，萧索动离心。",
        "臂上茱萸新。",
        "似旧年、堪赏光阴。",
        "百盏香醑且酬身。",
        "牛山会难寻。"
      ],
      "author": {
        "id": 11741,
        "name": "杜安世"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313071,
      "title": "踏莎行",
      "content": [
        "雨霁风光，春分天气。",
        "千花百草争明媚。",
        "画梁新燕一双双，玉笼鹦鹉爱孤睡。",
        "薜荔依墙，莓苔满地。",
        "青楼几处歌声丽。",
        "蓦然旧事上心头，无言敛皱眉山翠。"
      ],
      "author": {
        "id": 11741,
        "name": "杜安世"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313072,
      "title": "踏莎行",
      "content": [
        "夜雨朝晴，东风微冷。",
        "雕梁燕子闲相并。",
        "后园次第数芳菲，千香百艳年年定。",
        "步险楼高，人赊途迥。",
        "烟芜冉冉斜阳暝。",
        "红笺写尽寄无因，想伊不信人成病。"
      ],
      "author": {
        "id": 11741,
        "name": "杜安世"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313073,
      "title": "踏莎行",
      "content": [
        "嫩柳成阴，残花双舞。",
        "尘消院落新经雨。",
        "洞房深掩日长天，珠帘时有沈烟度。",
        "夜梦凄凉，晨妆薄注。",
        "香肌瘦尽宽金缕。",
        "到头终是恶因缘，当初只被多情误。"
      ],
      "author": {
        "id": 11741,
        "name": "杜安世"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313074,
      "title": "踏莎行",
      "content": [
        "闲院秋千，又还拆了。",
        "绿苔遍地青春老。",
        "画楼日晚燕归巢，红稀翠盛梅初小。",
        "窈窕身轻，怎禁烦恼。",
        "罗衣渐减怯风峭。",
        "韶华好景想多才，厌厌只为书音少。"
      ],
      "author": {
        "id": 11741,
        "name": "杜安世"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313075,
      "title": "端正好",
      "content": [
        "栏菊愁烟沾秋露。",
        "天微冷、双燕辞去。",
        "月明空照别离苦。",
        "透素光、穿朱户。",
        "夜来西风雕寒树。",
        "凭阑望、迢遥长路。",
        "花笺写就此情绪。",
        "特寄传、知何处。"
      ],
      "author": {
        "id": 11741,
        "name": "杜安世"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313076,
      "title": "端正好",
      "content": [
        "每逢春来长如病。",
        "玉容瘦、薄妆相称。",
        "双欢未经成孤令。",
        "奈厚约、全无定。",
        "众禽啾唧声愁听。",
        "相思事、多少春恨。",
        "孤眠帐外银缸耿。",
        "透一点、炉烟暝。"
      ],
      "author": {
        "id": 11741,
        "name": "杜安世"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313077,
      "title": "端正好",
      "content": [
        "露落风高桐叶坠。",
        "小庭院、秋凉佳气。",
        "兰堂聚饮华筵启。",
        "罢令曲、呈珠缀。",
        "晚天行云凝香袂。",
        "新声内、分明心意。",
        "玉炉初喷檀烟起。",
        "敛愁在、双蛾翠。"
      ],
      "author": {
        "id": 11741,
        "name": "杜安世"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313078,
      "title": "端正好",
      "content": [
        "野禽林栖啾唧语。",
        "闲庭院、残阳将暮。",
        "兰堂静悄珠帘窣。",
        "想玉人、归何处。",
        "喜鹊几回薄无据。",
        "愁都在、双眉头聚。",
        "凄凉方感孤鸳侣。",
        "对夜永、成愁绪。"
      ],
      "author": {
        "id": 11741,
        "name": "杜安世"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313079,
      "title": "菩萨蛮",
      "content": [
        "游丝欲堕还重上。",
        "春残日永人相望。",
        "花共燕争飞。",
        "青梅细雨枝。",
        "离愁终未解。",
        "忘了依前在。",
        "拟待不寻思。",
        "刚眠梦见伊。"
      ],
      "author": {
        "id": 11741,
        "name": "杜安世"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313080,
      "title": "菩萨蛮",
      "content": [
        "锦机织了相思字。",
        "天涯路远无由寄。",
        "寒雁只衔芦。",
        "何曾解寄书。",
        "缄封和血泪。",
        "目断西江水。",
        "拟欲托双鱼。",
        "问君情有无。"
      ],
      "author": {
        "id": 11741,
        "name": "杜安世"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313081,
      "title": "丑奴儿・采桑子",
      "content": [
        "樱桃谢了梨花发，红白相催。",
        "燕子归来。",
        "几处风帘绣户开。",
        "人生乐事知多少，且酌金杯。",
        "管咽声哀。",
        "慢引萧娘舞一回。"
      ],
      "author": {
        "id": 11741,
        "name": "杜安世"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313082,
      "title": "凤衔杯",
      "content": [
        "人生不似月初圆。",
        "叹分飞、容易经年。",
        "凄惨断云片雨、□□□。",
        "□□□、□□□。",
        "金钵小，玉槽悭。",
        "想至今、谁为相怜。",
        "多少旧欢往事、一潸然。",
        "空牵惹、病缠绵。"
      ],
      "author": {
        "id": 11741,
        "name": "杜安世"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313083,
      "title": "凤衔杯",
      "content": [
        "留花不住怨花飞。",
        "向南园、情绪依依。",
        "可惜倚红斜白、一枝枝。",
        "经宿雨、暮江披。",
        "凭朱槛，把金卮。",
        "对芳丛、惆怅多时。",
        "何况旧欢新恨、阻心期。",
        "空满眼、是相思。"
      ],
      "author": {
        "id": 11741,
        "name": "杜安世"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313084,
      "title": "少年游",
      "content": [
        "小轩深院是秋时。",
        "风叶堕高枝。",
        "疏帘静永，薄帷清夜，暑退觉寒微。",
        "凄凉天气离愁意，音书杳难期。",
        "多情成病不须医。",
        "更憔悴、转寻思。"
      ],
      "author": {
        "id": 11741,
        "name": "杜安世"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313085,
      "title": "玉楼春",
      "content": [
        "玉烛光明正旦好。",
        "斗柄东回春太早。",
        "岭寒犹锁去年梅，江暖新催今岁草。",
        "蜀国熙熙冬令杪。",
        "更喜寿阳新梦觉。",
        "玉杯齐举乐音谐，遥想金阶天仗晓。"
      ],
      "author": {
        "id": 11741,
        "name": "杜安世"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313086,
      "title": "玉楼春",
      "content": [
        "风解池冰蝉翅薄。",
        "庭树枝枯笼翠萼。",
        "背寒迎暖起犹慵，闲卷珠帘凭画阁。",
        "晴景融融烟漠漠。",
        "天际行人乖信约。",
        "病容先怯见春来，长到恁时添瘦削。"
      ],
      "author": {
        "id": 11741,
        "name": "杜安世"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313087,
      "title": "玉楼春",
      "content": [
        "晴景融融春色浅。",
        "落尽梅花千万片。",
        "小池冰解水纹生，消息未闻梁上燕。",
        "楼倚轻寒风力软。",
        "目断孤云天自远。",
        "又还依旧去年时，寂寞病容人怪见。"
      ],
      "author": {
        "id": 11741,
        "name": "杜安世"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313088,
      "title": "玉楼春",
      "content": [
        "三月牡丹呈艳态。",
        "壮观人间春世界。",
        "鲛绡玉槛作扃栊，淹雅洞中王母队。",
        "不奈风吹兼日㬠。",
        "国貌天香无物赛。",
        "直须共赏莫轻孤，回首万金何处买。"
      ],
      "author": {
        "id": 11741,
        "name": "杜安世"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313089,
      "title": "玉楼春",
      "content": [
        "纶命忽从天上至。",
        "便绾兵权辞漕计。",
        "汉廷起草旧郎官，蜀部坐筹新将帅。",
        "红旆碧幢春色里。",
        "娇马嘶风花片坠。",
        "送行今日短亭中，恼乱故人须尽醉。"
      ],
      "author": {
        "id": 11741,
        "name": "杜安世"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313090,
      "title": "玉楼春",
      "content": [
        "春景抛人无处问。",
        "多谢石榴花又喷。",
        "茜罗揉出碎英繁，红蜡缕成香萼润。",
        "血色新裙羞莫近。",
        "密叶柔条相间衬。",
        "雨馀寂寞假山傍，乡国尚遥西海信。"
      ],
      "author": {
        "id": 11741,
        "name": "杜安世"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313091,
      "title": "玉楼春",
      "content": [
        "三月初三春渐老。",
        "遍地残花风暗扫。",
        "命俦啸侣拥笙歌，临水泛觞游宴好。",
        "浮利浮名何足道。",
        "丽景芳时须笑傲。",
        "今年不似去年欢，云海路长天杳杳。"
      ],
      "author": {
        "id": 11741,
        "name": "杜安世"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313092,
      "title": "河满子",
      "content": [
        "细雨裛开红杏，新妆粉面鲜明。",
        "东君何事交来早，更无绿叶同荣。",
        "独倚青楼吟赏，目前无限轻盈。",
        "命薄不依栏槛，或占郊坰。",
        "清香繁艳真堪爱，枉教寂寞凋零。",
        "相次牡丹芍药，王孙谁道多情。"
      ],
      "author": {
        "id": 11741,
        "name": "杜安世"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313093,
      "title": "河满子",
      "content": [
        "柳嫩不禁摇动，梅残尽任飘零。",
        "雨馀天气来深院，向阳纤草重青。",
        "寂寞小桃初绽，两三枝上红英。",
        "又见云中归雁，嗈嗈断续和鸣。",
        "年年依旧无情绪，镇长冷落银屏。",
        "不语闲寻往事，微风频动帘旌。"
      ],
      "author": {
        "id": 11741,
        "name": "杜安世"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313094,
      "title": "山亭柳",
      "content": [
        "晓来风雨，万花飘落。",
        "叹韶光虚过。",
        "却芳草萋萋，映楼台、淡烟漠漠。",
        "纷纷絮飞院宇，燕子过朱阁。",
        "玉容淡妆添寂寞。",
        "檀郎孤愿太情薄。",
        "数归期，绝信约。",
        "暗添春宵恨，平康恣迷欢乐。",
        "时时闷饮绿醑，甚转转、思量著。"
      ],
      "author": {
        "id": 11741,
        "name": "杜安世"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313095,
      "title": "合欢带",
      "content": [
        "楼台高下玲珑。",
        "斗芳草、绿阴浓。",
        "芍药孤栖香艳晚，见樱桃、万颗初红。",
        "巢喧乳燕，珠帘镂曳，满户香风。",
        "罩纱帏、象床屏枕，昼眠才似朦胧。",
        "起来无语更兼慵。",
        "念分明、事成空。",
        "被你厌厌牵系我，怪纤腰、绣带宽松。",
        "春来早是，分飞两处，长恨西东。",
        "到如今、扇移明月，簟铺寒浪与谁同。"
      ],
      "author": {
        "id": 11741,
        "name": "杜安世"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    }
  ],
