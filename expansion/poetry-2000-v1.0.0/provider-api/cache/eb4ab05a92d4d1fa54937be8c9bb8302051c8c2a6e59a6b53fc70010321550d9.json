      }
    },
    {
      "id": 197341,
      "title": "答文与可以六言诗相示因道济南事作十首  其一○",
      "content": [
        "相思欲见无路，满秩西归有时。",
        "及君铃阁少事，饮我松醪满巵。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 197342,
      "title": "次韵李公择寄子瞻",
      "content": [
        "青蒲一下复东来，拥扇西风满面埃。",
        "击柝自营何择地，𫗦糟同醉未须回。",
        "孤高振鹭瞻初下，淡泊婴儿及未孩。",
        "我亦漂流家万里，年来羞上望乡台。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 197343,
      "title": "次韵李公择以惠泉答章子厚新茶二首  其一",
      "content": [
        "无锡铜瓶手自持，新芽顾渚近相思。",
        "故人赠答无千里，好事安排巧一时。",
        "蟹眼煎成声未老，兔毛倾看色尤宜。",
        "枪旗携到齐西境，更试城南金线奇。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 197344,
      "title": "次韵李公择以惠泉答章子厚新茶二首  其二",
      "content": [
        "新诗态度霭春云，肯把篇章妄与人。",
        "性似好茶常自养，交如泉水久弥亲。",
        "睡浓正想罗声发，食饱尤便粥面匀。",
        "底处翰林长外补，明年谁送霅溪春。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 197345,
      "title": "和李公择赴历下道中杂咏十二首 泛清河",
      "content": [
        "南北无多水，崎岖未舍船。",
        "何时好霖雨，是处有通川。",
        "坟垅看书卷，兴亡指道边。",
        "苍茫半秋草，犹复较愚贤。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 197346,
      "title": "和李公择赴历下道中杂咏十二首 将至桃园阻浅且风不得进",
      "content": [
        "卷帆倚棹浅河津，忆泛长江步步新。",
        "未免生涯寄风浪，不堪舟楫委埃尘。",
        "往来欲就沙囊堰，深浅时看举策频。",
        "一望云霓百忧集，应思平地隠居人。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 197347,
      "title": "和李公择赴历下道中杂咏十二首 桃园阻浅将易小舟一夜水大至复乘便风顷刻百里",
      "content": [
        "此生与物妄相仇，欲往长嫌苦见留。",
        "浅濑何知向人恶，涨溪岂复为公流。",
        "雨痕忽到工催客，风信初来转打头。",
        "举目汀洲都未改，忽添清兴满行舟。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
