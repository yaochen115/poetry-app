      }
    },
    {
      "id": 197272,
      "title": "游太山四首 岳下",
      "content": [
        "东来亦何求，聊欲观海岱。",
        "海西尚千里，将行勇还退。",
        "岱阴即齐疆，南往曾历块。",
        "春深草木长，山暖冰雪溃。",
        "中巷无居人，南亩释耕耒。",
        "车徒八方至，尘坌百里内。",
        "牛马汗淋漓，绮纨声綷縩。",
        "喧阗六师合，汹涌众流汇。",
        "无复问谁何，但自舍耽爱。",
        "龙鸾画车服，贝玉饰冠佩。",
        "骅骝蹴腾骞，幡旆飞晻暧。",
        "腥膻及鱼鼈，琐细或蒲菜。",
        "游墯愧无赍，技巧穷殊态。",
        "纵观𥈭未已，精意殚一酹。",
        "出门青山屯，绕廊遗迹昧。",
        "登封尚坛壝，古观写旗队。",
        "戈矛认毫末，舒卷分向背。",
        "雍容太平业，磊落丰碑在。",
        "往事半蓬蒿，遗氓但悲慨。",
        "回瞻最高峰，远谢徂徕对。",
        "欲将有限力，一放目所迨。",
        "天门四十里，预恐双足废。",
        "三宿遂徘徊，归来欲谁怼。",
        "前年道轘辕，直上嵩岭背。",
        "中休强饮食，莫宿时盥颒。",
        "稍知天宇宽，不觉人寰秽。",
        "岁时未云久，筋骸老难再。",
        "山林无不容，疲薾坐自碍。",
        "自知俗缘深，毕老守阛阓。",
        "何当御清风，不用车马载。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 197273,
      "title": "送王璋长官赴真定孙和甫辟书",
      "content": [
        "昔年旅南服，始识王荆州。",
        "威动千里肃，恩宽行客留。",
        "从容见少子，风采倾凡俦。",
        "温然吐词气，已觉清且修。",
        "不见十五年，相逢话百忧。",
        "青衫走尘土，白发各满头。",
        "新弃东海邑，愿从北诸侯。",
        "北鄙事方伙，饥馑连戈矛。",
        "盟好未可轻，念当事怀柔。",
        "主将今老成，勉尽良计筹。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 197274,
      "title": "寄孙朴",
      "content": [
        "忆昔补官太皞墟，泮宫萧条人事疏。",
        "日高鼾睡声嘘嘘，往还废绝门无车。",
        "君为户曹畏简书，放怀疏懒亦似余。",
        "相逢语笑夜踌躇，烹煮梨栗羞殽蔬。",
        "官居一去真蘧庐，东来失计悔厥初。",
        "夜闻桴鼓惊阎闾，事如牛毛费耘鉏。",
        "违失真性从吏胥，目视紾臂邀徐徐。",
        "羡君不出心自如，北潭秋水多芙蕖。",
        "青荷包饭蒲为菹，翛然独往深渊鱼。",
        "人生如此乐有余，胡为自投槛中狙。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 197275,
      "title": "和韩宗弼暴雨",
      "content": [
        "执热卧北窗，淋漓汗流注。",
        "蛟龙遁水府，谁起叩天户。",
        "偶然终日风，振扰北山雾。",
        "崩腾转相轧，变化不容睹。",
        "雷声运车毂，雨点倾豆黍。",
        "逡巡溜河汉，指顾才笑语。",
        "破屋少干床，茅苫固难御。",
        "出门泥没足，此厄比邻溥。",
        "苟令终岁熟，敢有今日怒。",
        "晚照上东轩，清风袭虚庑。",
        "微生免荷鉏，但喜脱烦暑。",
        "农父更事多，缺塘已增土。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 197276,
      "title": "舜泉复发",
      "content": [
        "奕奕清波旧绕城，旱来泉眼亦尘生。",
        "连宵暑雨源初接，发地春雷夜有声。",
        "复理沟渠通屈曲，重开池沼放澄清。",
        "通衢细洒浮埃净，车马归来似晚晴。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 197277,
      "title": "次韵徐正权谢示闵子庙记及惠纸",
      "content": [
        "西溪秋思日盈笺，幕府拘愁学久骞。",
        "记庙终惭无好句，酹坟犹喜有前篇。",
        "屏除笔砚真良计，写寄交游畏妄传。",
        "吴纸赠君君莫怪，耕耘废罢有闲田。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 197278,
      "title": "张文裕侍郎挽词",
      "content": [
        "持节西南二十年，华堂遗像已苍然。",
        "归来侍从三朝旧，老去雍容平地仙。",
        "落笔纵横题壁处，诵诗清壮举杯前。",
        "东游邂逅迎归旐，泪落城南下马阡。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 197279,
      "title": "东方书生行",
      "content": [
        "东方书生多愚鲁，闭门诵书口生土。",
        "窗中白首抱遗编，自信此书传父祖。",
        "辟雍新说从上公，册除仆射酬元功。",
        "太常弟子不知数，日夜吟讽如寒虫。",
        "四方窥觇不能得，一卷百金犹复惜。",
        "康成颖达弃尘灰，老聃瞿昙更出入。",
        "旧书句句传先师，中途欲弃还自疑。",
        "东邻小儿识机会，半年外舍无不知。",
        "乘轻策肥正年少，齿疏唇腐真堪笑。",
        "是非得失付它年，眼前且买先腾踔。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 197280,
      "title": "送韩宗弼",
      "content": [
        "大野将冻河水微，慨然临流送将归。",
        "登舟上帆手一挥，脱弃朋友如敝衣。",
        "我来三见芳草腓，来时同寮今已非。",
        "念昔相从未尝违，西湖幽远人事稀。",
        "青莲紫芡倾珠玑，白鱼掉尾黄鼈肥。",
        "客醉将起命阖扉，方桥月出风露霏。",
        "星河下照摇清辉，喧呼笑语相嘲讥。",
        "岁月一逝空长欷，交游去尽将谁依。",
        "君家汉代平与韦，蔼然令德传余徽。",
        "鸣鸠著地鸿高飞，安得久此同絷鞿。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 197281,
      "title": "送刘长清敏",
      "content": [
        "汝州太守卧病年，亹亹犹复能清言。",
        "平生雄辩嗟不见，风流尚有曹州存。",
        "历下东游少相识，欢喜闻君在西邑。",
        "旧知兄弟无凡俦，相逢一笑开颜色。",
        "三年政令如牛毛，思归南亩皆蓬蒿。",
        "羡君饮酒动论斗，引觥向口收狂潮。",
        "醉后胸中百无有，偃然啸傲倾朋曹。",
        "中朝卿士足官府，君归何处狂歌谣。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 197282,
      "title": "题张安道乐全堂",
      "content": [
        "天命无不全，人事每自伤。",
        "譬如摩尼珠，宛转有余光。",
        "藻饰不能加，尘垢岂有亡。",
        "世人未尝识，姑射手自将。",
        "我公体自然，率性非勉强。",
        "驰驱四十年，不入忧患场。",
        "晚岁事蒙养，敛退就此堂。",
        "小儒岂知道，宿昔窥门墙。",
        "申屠师无人，无足亦自忘。",
        "如逢郑执政，一笑先生傍。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 197283,
      "title": "和鲜于子骏益昌官舍八咏 桐轩",
      "content": [
        "桐身青琅玕，桐叶蒲葵扇。",
        "落落出轩墀，亭亭奉闲燕。",
        "夜声疏雨滴，午影微风转。",
        "秋飙一凌乱，淅沥惊葱蒨。",
        "朝日失繁阴，青苔覆遗片。",
        "空使坐中人，慨然嗟物变。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 197284,
      "title": "和鲜于子骏益昌官舍八咏 竹轩",
      "content": [
        "幽轩离纷华，惟有一丛竹。",
        "纤梢起余寒，紫笋散轻馥。",
        "擢干春雨余，挺节秋霜足。",
        "不知岁时改，守此娟娟绿。",
        "上有吟风蝉，空腹未尝食。",
        "翦伐非所辞，不受尘土辱。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 197285,
      "title": "和鲜于子骏益昌官舍八咏 柏轩",
      "content": [
        "筑室城市间，移柏南涧底。",
        "山林夙所尚，封植聊自寄。",
        "崎岖脱岩石，拥塞出棼翳。",
        "上承清露滋，下受寒泉惠。",
        "秋来采霜叶，咀嚼有余味。",
        "苦涩未须嫌，愈久甘如荠。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 197286,
      "title": "和鲜于子骏益昌官舍八咏 巽堂",
      "content": [
        "山前三秦道，车马不遑息。",
        "日出红尘生，不见青山色。",
        "峰峦未尝改，往意自奔迫。",
        "谁言幽堂居，近在使者宅。",
        "俯听辨江声，却立睨石壁。",
        "藤萝自太古，松竹列新植。",
        "暑簟卧清风，寒樽对佳客。",
        "试问东行人，谁能同此适。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 197287,
      "title": "和鲜于子骏益昌官舍八咏 山斋",
      "content": [
        "平地厌喧嚣，虚斋上山足。",
        "萧条远城市，坡陀富林麓。",
        "简书日填委，杖屦每幽独。",
        "岂无山中士，高卧白茅屋。",
        "逢人默无语，长啸响岩谷。",
        "此室庶可招，夜月相从宿。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 197288,
      "title": "和鲜于子骏益昌官舍八咏 闲燕亭",
      "content": [
        "登山稍已高，旷望良亦远。",
        "危亭在山腹，物景行自变。",
        "诸峰宿露收，草木朝阳绚。",
        "盎盎云出山，溜溜泉垂坂。",
        "徐行得佳处，永日遂忘返。",
        "此乐只自知，傍人任嫌懒。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 197289,
      "title": "和鲜于子骏益昌官舍八咏 会景亭",
      "content": [
        "亭高众山下，胜势不自收。",
        "冈峦向眼尽，风籁与耳谋。",
        "鸢飞半岭息，云起当空游。",
        "视身如乘风，超然忘百忧。",
        "暮归室中居，唯见窗户幽。",
        "视听随物变，恍谁识其由。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 197290,
      "title": "和鲜于子骏益昌官舍八咏 宝峰亭",
      "content": [
        "昔过益昌城，莫登君子堂。",
        "驾言念长道，未暇升崇冈。",
        "今闻宝峰上，缥缈陵朝阳。",
        "三休引萝蔓，一览穷苍茫。",
        "微云霭双剑，落日明故乡。",
        "奔驰迹未安，山薮意自长。",
        "漂摇万里外，手把新诗章。",
        "宦游不忘归，何异鸟欲翔。",
        "尘土污颜面，年华侵鬓霜。",
        "何时首归路，所至聊徬徨。",
        "樽俎逢故人，亭榭凝清光。",
        "为我具斗酒，宿恨犹可偿。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 197291,
      "title": "次韵分司南京李诚之待制求酒二首  其一",
      "content": [
        "世上升沉都梦里，春来强健斗樽前。",
        "公田种秫全抛却，坐客无毡谁与钱。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 197293,
      "title": "送施历城辩归常州",
      "content": [
        "高人不受尘土侵，三年浙江藏何深。",
        "久闲物理有相复，历城官事森成林。",
        "乘时敛散逐十二，鞭挞逋负徒哀矜。",
        "一杯相属未尝得，百亩归去将安能。",
        "潜逃虽出知者后，黾勉尚见仁人心。",
        "归期忽告三月尾，强留不顾千黄金。",
        "河豚虽过鲈鳜在，粳稻正插风雨淫。",
        "酒肴劳苦罄邻里，期会迫隘思僚朋。",
        "山川吴越我所爱，扁舟佗日要追寻。",
        "滞留未用便相诧，半年岁月行骎骎。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 197294,
      "title": "施君既去复以事还戏赠",
      "content": [
        "令尹西行去又回，西湖重把旧樽罍。",
        "吏民再见鸡栖乘，犹道吾公挽不来。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 197295,
      "title": "和文与可洋州园亭三十咏 湖桥",
      "content": [
        "湖南堂宇深，湖北林亭远。",
        "不作过湖桥，两处那相见。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 197296,
      "title": "和文与可洋州园亭三十咏 横湖",
      "content": [
        "湖里种荷花，湖边种杨柳。",
        "何处渡桥人，问是人间否。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 197297,
      "title": "和文与可洋州园亭三十咏 书轩",
      "content": [
        "绿竹覆清渠，尘心日日疏。",
        "使君遗癖在，苦要读文书。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 197298,
      "title": "和文与可洋州园亭三十咏 冰池",
      "content": [
        "水深冰亦厚，滉荡铺寒玉。",
        "好在水中鱼，何愁池上鹜。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 197299,
      "title": "和文与可洋州园亭三十咏 竹坞",
      "content": [
        "空陂放修竹，肃肃复冥冥。",
        "莫除坞外笋，从使入园生。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 197300,
      "title": "和文与可洋州园亭三十咏 荻浦",
      "content": [
        "离披寒露下，萧索微风触。",
        "摧折有余青，从横未须束。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 197301,
      "title": "和文与可洋州园亭三十咏 蓼屿",
      "content": [
        "风高莲欲衰，霜重蓼初发。",
        "会使此池中，秋芳未尝歇。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 197302,
      "title": "和文与可洋州园亭三十咏 望云楼",
      "content": [
        "云生如涌泉，云散如翻水。",
        "百变一凭栏，悠悠定谁使。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 197303,
      "title": "和文与可洋州园亭三十咏 天汉台",
      "content": [
        "台高天汉近，匹练挂林端。",
        "秋深霜露重，谁见落西山。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 197304,
      "title": "和文与可洋州园亭三十咏 待月台",
      "content": [
        "夜色何苍苍，月明久未上。",
        "不上倚城台，无奈东南嶂。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 197305,
      "title": "和文与可洋州园亭三十咏 二乐榭",
      "content": [
        "动静惟所遇，仁智亦偶然。",
        "谁见二物外，犹有天地全。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 197306,
      "title": "和文与可洋州园亭三十咏 𣺼泉亭",
      "content": [
        "泉来草木滋，泉去池塘满。",
        "委曲到庭除，清泠备晨盥。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 197307,
      "title": "和文与可洋州园亭三十咏 吏隠亭",
      "content": [
        "隠居亦非难，欲少求易遂。",
        "有意未成归，聊就茅檐试。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 197308,
      "title": "和文与可洋州园亭三十咏 霜筠亭",
      "content": [
        "林高日气薄，竹色净如水。",
        "寂历断人声，时有鸣禽起。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 197309,
      "title": "和文与可洋州园亭三十咏 无言亭",
      "content": [
        "处世欲无言，事至或未可。",
        "唯有此亭空，宴坐聊从我。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 197310,
      "title": "和文与可洋州园亭三十咏 露香亭",
      "content": [
        "重露复千花，繁香凝畦圃。",
        "不忍日将晞，散逐微风去。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 197311,
      "title": "和文与可洋州园亭三十咏 涵虚亭",
      "content": [
        "虚亭面疏篁，窈窕众景聚。",
        "更与坐中人，行寻望来处。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 197312,
      "title": "和文与可洋州园亭三十咏 溪光亭",
      "content": [
        "溪亭新雨余，秋色明滉漾。",
        "鸟渡夕阳中，鱼行白石上。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 197313,
      "title": "和文与可洋州园亭三十咏 过溪亭",
      "content": [
        "溪浅复通桥，过者犹恨懒。",
        "頼有沙上鸥，常为独游伴。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 197314,
      "title": "和文与可洋州园亭三十咏 披锦亭",
      "content": [
        "春晚百花齐，绵绵巧如织。",
        "细雨洗还明，轻风卷无迹。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 197315,
      "title": "和文与可洋州园亭三十咏 禊亭",
      "content": [
        "觞流无定处，客醉醒还酌。",
        "毋令仲御歌，空使人惊愕。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 197316,
      "title": "和文与可洋州园亭三十咏 菡萏轩",
      "content": [
        "开花浊水中，抱性一何洁。",
        "朱槛月明时，清香为谁发。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 197317,
      "title": "和文与可洋州园亭三十咏 荼䕷洞",
      "content": [
        "猗猗翠蔓长，蔼蔼繁香足。",
        "绮席堕残英，芳樽渍余馥。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 197318,
      "title": "和文与可洋州园亭三十咏 筼筜谷",
      "content": [
        "谁言使君贫，已用谷量竹。",
        "盈谷万万竿，何曾一竿曲。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 197319,
      "title": "和文与可洋州园亭三十咏 寒芦港",
      "content": [
        "芦深可藏人，下有扁舟泊。",
        "正似洞庭风，日莫孤帆落。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 197320,
      "title": "和文与可洋州园亭三十咏 野人庐",
      "content": [
        "野人三四家，桑麻足生意。",
        "试与叩柴荆，言辞应有味。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 197321,
      "title": "和文与可洋州园亭三十咏 此君庵",
      "content": [
        "风梢绕檐匝，霜干当窗净。",
        "遥知素壁上，醉墨森相映。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 197322,
      "title": "和文与可洋州园亭三十咏 金橙径",
      "content": [
        "叶如石楠坚，实比霜柑大。",
        "穿径得新苞，令公忆鲈鲙。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 197323,
      "title": "和文与可洋州园亭三十咏 南园",
      "content": [
        "官是劝农官，种桑亦其所。",
        "安得陌上人，隔叶攀条语。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 197324,
      "title": "和文与可洋州园亭三十咏 北园",
      "content": [
        "使君美且仁，遍地种桃李。",
        "岂独放春花，行看食秋子。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 197325,
      "title": "次韵吴兴李行中秀才见寄并求醉眠亭诗二首 和见寄",
      "content": [
        "才堪簿领更无余，赢得十年闲读书。",
        "宠辱何须身自试，穷愁不待酒驱除。",
        "故人归去无消息，佳句新来屡卷舒。",
        "前日使君今在此，不妨时复置双鱼。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 197326,
      "title": "次韵吴兴李行中秀才见寄并求醉眠亭诗二首 醉眠亭",
      "content": [
        "是非一醉了无余，唯有胸中万卷书。",
        "已把人生比蘧传，更将江浦作阶除。",
        "欲眠宾客从教去，倒卧氍毹岂暇舒。",
        "京洛旧游真梦里，秋风无复忆鲈鱼。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 197327,
      "title": "和子瞻玉盘盂二首  其一",
      "content": [
        "千叶团团一尺余，扬州绝品旧应无。",
        "赏传莒国迁钟虡，移忆胡僧置钵盂。",
        "丛底留连倾凿落，瓶中捧拥照浮屠。",
        "强将绛蜡封红萼，憔悴无言损玉肤。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 197328,
      "title": "和子瞻玉盘盂二首  其二",
      "content": [
        "故相林亭父老知，出群草木尚何疑。",
        "无多产业残花药，几许功名旧鼎彝。",
        "丰艳不知人世别，佳名新换使君诗。",
        "明年会看花尤好，剥尽浮苞养一枝。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 197329,
      "title": "寄题密州新作快哉亭二首  其一",
      "content": [
        "车骑崩腾送客来，奔河断岸首频回。",
        "凿成户牖功无几，放出江湖眼一开。",
        "景物为公争自致，登临约我共追陪。",
        "自矜新作超然赋，更拟兰台诵快哉。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 197330,
      "title": "寄题密州新作快哉亭二首  其二",
      "content": [
        "槛前潍水去沄沄，洲渚苍茫烟柳匀。",
        "万里忽惊非故国，一樽聊复对行人。",
        "谢安未厌频携妓，汲黯犹须卧理民。",
        "试问沙囊无处所，于今信怯定非真。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 197331,
      "title": "赠马正卿秀才",
      "content": [
        "男儿生可怜，赤手空腹无一钱。",
        "死丧三世委平地，骨肉不得归黄泉。",
        "徒行乞丐买坟墓，冠帻破败衣履穿。",
        "矫然未肯妄求取，耻以不义藏其先。",
        "辛勤直使行路泣，六亲不信相尤愆。",
        "问人何罪穷至此，人不敢尤其怨天。",
        "孝慈未省鬼神恶，兄弟宁有木石顽。",
        "善人自古有不遇，力行不废良谓贤。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
