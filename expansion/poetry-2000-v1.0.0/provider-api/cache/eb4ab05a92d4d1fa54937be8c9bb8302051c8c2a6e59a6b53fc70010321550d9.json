      }
    },
    {
      "id": 197333,
      "title": "答文与可以六言诗相示因道济南事作十首  其二",
      "content": [
        "舜井溢流陌上，历山近在城头。",
        "羁旅三年忘去，故园何日归休。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 197334,
      "title": "答文与可以六言诗相示因道济南事作十首  其三",
      "content": [
        "野步西湖绿缛，晴登北渚烟绵。",
        "蒲莲自可供腹，鱼蟹何尝要钱。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 197335,
      "title": "答文与可以六言诗相示因道济南事作十首  其四",
      "content": [
        "饮酒方桥夜月，钓鱼画舫秋风。",
        "冉冉荷香不断，悠悠水面无穷。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 197336,
      "title": "答文与可以六言诗相示因道济南事作十首  其五",
      "content": [
        "雨过山光欲溜，寒来水气如烝。",
        "胜处何须吴越，随方亦有游朋。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 197337,
      "title": "答文与可以六言诗相示因道济南事作十首  其六",
      "content": [
        "扬雄执戟虽久，陶令归田未能。",
        "眼看云山无奈，神伤簿领相仍。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 197338,
      "title": "答文与可以六言诗相示因道济南事作十首  其七",
      "content": [
        "终岁常亲鞭扑，此生知负诗书。",
        "欲寻旧学无处，时有故人起予。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 197339,
      "title": "答文与可以六言诗相示因道济南事作十首  其八",
      "content": [
        "故人远在江汉，万里时寄声音。",
        "闻道禅心寂寞，未废诗人苦吟。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 197340,
      "title": "答文与可以六言诗相示因道济南事作十首  其九",
      "content": [
        "佳句近参风雅，微词间发离骚。",
        "窃欲比君庾信，莫年诗赋尤高。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
