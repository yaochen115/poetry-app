      }
    },
    {
      "id": 197332,
      "title": "答文与可以六言诗相示因道济南事作十首  其一",
      "content": [
        "远游既为东鲁，迁居又爱南山。",
        "齿发自知将老，心怀且欲偷安。"
      ],
      "author": {
        "id": 2650,
        "name": "苏辙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
