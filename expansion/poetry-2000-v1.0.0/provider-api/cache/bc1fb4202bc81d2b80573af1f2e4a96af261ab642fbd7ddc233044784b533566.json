{
  "data": [
    {
      "id": 32673,
      "title": "晚泊慈姥矶下二首  其二",
      "content": [
        "慈姥矶头月，纤纤照酒杯。",
        "素秋风露重，久客鬓毛催。",
        "宿鸟惊还定，飞萤阖复开。",
        "平生四方志，老去转悠哉。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 32674,
      "title": "七月十四夜观月",
      "content": [
        "不复微云滓太清，浩然风露欲三更。",
        "开帘一寄平生快，万顷空江著月明。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 32675,
      "title": "夜宿阳山矶将晓大雨北风甚劲俄顷行三百余里遂抵雁翅浦",
      "content": [
        "五更颠风吹急雨，倒海翻江洗残暑。",
        "白浪如山泼入船，家人惊怖篙师舞。",
        "此行十日苦滞留，我亦芦樷厌鸣𫇛。",
        "书生快意轻性命，十丈蒲帆百夫举。",
        "星驰电骛三百里，坡陇聮翩杂平楚。",
        "船头风浪声愈厉，助以长笛挝鼍鼓。",
        "岂惟澎湃震山岳，直恐澒洞连后土。",
        "起看草木尽南靡，水鸟号鸣集洲渚。",
        "稽首龙公谢风伯，区区未祷烦神许。",
        "应知老去负壮心，戏遣穷途出豪语。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 32676,
      "title": "望江道中",
      "content": [
        "吾道非邪来旷野，江涛如此去何之。",
        "起随乌鹊初翻后，宿及牛羊欲下时。",
        "风力渐添帆力健，𫇛声常杂雁声悲。",
        "晚来又入淮南路，红树青山合有诗。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32677,
      "title": "秋夜读书每以二鼓尽为节",
      "content": [
        "腐儒碌碌叹无奇，独喜遗编不我欺。",
        "白发无情侵老境，青灯有味似儿时。",
        "高梧策策传寒意，叠鼓冬冬迫睡期。",
        "秋夜渐长饥作祟，一杯山药进琼糜。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32678,
      "title": "往在都下时与邹德章兵部同居百官宅无日不相从仆来佐豫章而德章亦谪高安感事述怀作歌奉寄",
      "content": [
        "巷南巷北秋月明，东家西家读书声。",
        "官闲出局各无事，冷落往往思同盟。",
        "出门相寻索一笑，亦或邂逅因俱行。",
        "黄中掀髯语激烈，韶美坚坐书纵横。",
        "子充清言喜置酒，赤梨绿柿相扶檠。",
        "寒灯耿耿地炉暖，宫门风顺闻疏更。",
        "故交一作霜叶散，外物已付秋毫轻。",
        "两穷相遭世果有，我与邹子俱南征。",
        "豫章高安本一郡，挂帆起柂无三程。",
        "簿书衮衮不少借，怀抱郁郁何由倾。",
        "明年君归我亦去，早卜三畆开柴荆。",
        "软红旧路莫重蹋，二升脱粟同煨铛。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 32679,
      "title": "寄答绵州杨齐伯左司",
      "content": [
        "磊落人为磊落州，滕王阁望越王楼。",
        "欲凭梦去直虚语，赖有诗来宽旅愁。",
        "我老一官书纸尾，君行千骑试遨头。",
        "遥知小寄平生快，春酒如川炙万牛。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32680,
      "title": "送全州赵都曹",
      "content": [
        "霜叶无停声，脂车有行色。",
        "正悲南浦秋，又送清湘客。",
        "啼饥儿颊红，待养亲发白。",
        "努力事上官，世路日已迫。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 32681,
      "title": "病中作",
      "content": [
        "豫章濒大江，气候颇不令。",
        "孟冬风薄人，十室八九病。",
        "外寒客肺胃，下湿攻脚胫。",
        "俗巫医不艺，呜呼安托命。",
        "我始屏药囊，治病以清静。",
        "幻妄消六尘，虚白全一性。",
        "三日体遂轻，成此不战胜。",
        "长年更事多，苦语君试听。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 32682,
      "title": "夜梦从数客雨中载酒出游山川城阙极雄丽云长安也因与客马上分韵作诗得游字",
      "content": [
        "有酒不谋州，能诗自胜侯。",
        "但须绳系日，安用地埋忧。",
        "射雉侵星出，看花秉烛游。",
        "残春杜陵雨，不恨湿貂裘。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 32683,
      "title": "去年余佐京口遇王嘉叟从张魏公督师过焉魏公道免相嘉叟亦出守莆阳近辱书报魏公已葬衡山感叹不已因用所遗拄颊亭诗韵奉寄",
      "content": [
        "河亭挈手共徘徊，万事寜非有数哉。",
        "黄阁相君三黜去，青云学士一麾来。",
        "中原故老知谁在，南岳新丘共此哀。",
        "火冷夜窗听急雪，相思时取近书开。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32684,
      "title": "自咏示客",
      "content": [
        "衰发萧萧老郡丞，洪州又看上元灯。",
        "羞将枉直分寻尺，寜走东西就斗升。",
        "吏进饱谙箝纸尾，客来苦劝摸床棱。",
        "归装渐理君知否，笑指庐山古涧藤。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32685,
      "title": "醉中歌",
      "content": [
        "吾少贫贱真臞儒，贪食嗜味老不除。",
        "折腰敛版日走趋，归来聊以醉自娱。",
        "长缾巨榼罗杯盂，不须渔翁劝三闾。",
        "牛尾膏美如凝酥，猫头轮囷欲专车。",
        "黄雀万里行头颅，白鹅作鲊天下无。",
        "浔阳糖蟹径尺余，吾州之蔊尤嘉蔬。",
        "珍盘饾饤百味俱，不但项脔与腹腴。",
        "悠然一饱自笑愚，顾为口腹劳形躯。",
        "投劾行矣归园庐，莫厌粝饭尝黄葅。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 32686,
      "title": "寄陶茂安监丞",
      "content": [
        "永州太守鬓毛残，矍铄犹能起据鞍。",
        "徴士虽思赋松菊，隐居未可挂衣冠。",
        "功名梦境元非实，歌舞山城且自宽。",
        "也胜钟陵穷别驾，闭门无客遣忧端。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32687,
      "title": "烧香",
      "content": [
        "茹芝却粒世无方，随食江湖每自伤。",
        "千里一身凫泛泛，十年万事海茫茫。",
        "春来乡梦凭谁说，归去君恩未敢忘。",
        "一寸丹心幸无愧，庭空月白夜烧香。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32688,
      "title": "寒食临川道中",
      "content": [
        "百卉千花了不存，堕溪飞絮看无痕。",
        "家人自作清明节，老子来穿绿暗村。",
        "日落啼鸦随野祭，雨余荒蔓上颓垣。",
        "道边醉饱休相避，作吏堪羞甚乞墦。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32689,
      "title": "上巳临川道中",
      "content": [
        "二月六夜春水生，陆子初有临川行。",
        "溪深桥断不得渡，城近卧闻吹角声。",
        "三月三日天气新，临川道中愁杀人。",
        "纤纤女手桑叶绿，漠漠客舍桐花春。",
        "平生怕路如怕虎，幽居不省游城府。",
        "鹤躯苦瘦坐长饥，龟息无声惟黙数。",
        "如今自怜还自笑，敛版低心事年少。",
        "儒冠未恨终自误，刀笔最惊非素料。",
        "五更欹枕一凄然，梦里扁舟水接天。",
        "红蕖绿芰梅山下，白塔朱楼禹庙边。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 32690,
      "title": "寄别李德远二首  其一",
      "content": [
        "萧萧风雨临川驿，邂逅连床若有期。",
        "自起挑灯贪夜话，疾呼索饭疗朝饥。",
        "即今明月共千里，已占深林巢一枝。",
        "惜别自嫌儿女态，梦骑羸马度芳陂。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32691,
      "title": "寄别李德远二首  其二",
      "content": [
        "李侯不恨世卖友，陆子那须钱买山。",
        "出牧君当千里去，归耕我判一生闲。",
        "中原乱后儒风替，党禁兴来士气孱。",
        "复古主盟须老手，勉追庆历数公间。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32692,
      "title": "初夏道中",
      "content": [
        "桑间葚熟麦齐腰，莺语惺惺野雉骄。",
        "日薄人家晒蚕子，雨余山客买鱼苗。",
        "丰年随处俱堪乐，行路终然不自聊。",
        "独喜此身强健在，又揺团扇著𫄨蕉。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32693,
      "title": "示儿子",
      "content": [
        "父子扶携返故乡，欣然击壤咏陶唐。",
        "墓前自誓寜非隘，泽畔行吟未免狂。",
        "雨润北窗看洗竹，霜清南陌课剶桑。",
        "秋毫何者非君赐，回首修门敢遽忘。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32694,
      "title": "重五同尹少稷观江中竞渡",
      "content": [
        "楚人遗俗阅千年，箫鼓喧呼鬭画船。",
        "风浪如山鲛鳄横，何心此地更争先。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 32695,
      "title": "过玉山辱芮国器检详留语甚勤因寄此诗兼呈韩无咎右司",
      "content": [
        "辽东归老白襦裙，名字何堪遣世闻。",
        "便谓与公长契濶，不知留语故慇懃。",
        "诗章有便犹应寄，禄米无多切莫分。",
        "倘见右司烦说似，每因风月怆离群。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32696,
      "title": "随意",
      "content": [
        "随意上渔舟，幽寻不预谋。",
        "清溪欣始泛，野寺忆前游。",
        "丰岁鸡豚贱，霜天柿栗稠。",
        "余生知有几，且置万端忧。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 32697,
      "title": "寄龚实之正言",
      "content": [
        "台省诸公岁岁新，平生敬慕独斯人。",
        "山林不恨音尘远，梦寐时容笑语亲。",
        "学道皮肤虽脱落，忧时肝胆尚轮囷。",
        "至和嘉祐须公了，乞向升平作幸民。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32698,
      "title": "游山西村",
      "content": [
        "莫笑农家腊酒浑，丰年留客足鸡豚。",
        "山重水复疑无路，柳暗花明又一村。",
        "箫鼓追随春社近，衣冠简朴古风存。",
        "从今若许闲乘月，拄杖无时夜叩门。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32699,
      "title": "观村童戏溪上",
      "content": [
        "雨余溪水掠堤平，闲看村童戏晚晴。",
        "竹马踉蹡冲淖去，纸鸢跋扈挟风鸣。",
        "三冬暂就儒生学，千耦还从父老耕。",
        "识字粗堪供赋役，不须辛苦慕公卿。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32700,
      "title": "雨霁出游书事",
      "content": [
        "十日苦雨一日晴，拂拭拄杖西村行。",
        "清沟泠泠流水细，好风习习吹衣轻。",
        "四邻蛙声已合合，两岸柳色争青青。",
        "辛夷先开半委地，海棠独立方倾城。",
        "春工遇物初不择，亦秀燕麦开芜菁。",
        "荠花如雪又烂漫，百草红紫那知名。",
        "小鱼谁取置道侧，细柳穿颊危将烹。",
        "欣然买放寄吾意，草莱无地苏疲氓。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 32701,
      "title": "残春",
      "content": [
        "残春醉著钓鱼庵，花雨娱人落半岩。",
        "岂是天公无皂白，独悲世俗异酸咸。",
        "妄身似梦行当觉，谈口如狂未易缄。",
        "已作沉舟君勿叹，年来何止阅千帆。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32702,
      "title": "家园小酌二首  其一",
      "content": [
        "旋作园庐指顾成，柳阴已复著啼莺。",
        "百年更把几杯酒，一月元无三日晴。",
        "鸥鹭向人殊耐久，山林与世本无营。",
        "小诗漫付儿曹诵，不用韩公说有声。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32703,
      "title": "家园小酌二首  其二",
      "content": [
        "满林春笋生无数，竟日鸬鹚来百回。",
        "衣上尘埃真一洗，酒边怀抱得频开。",
        "池鱼往者忧奇祸，社栎终然幸散材。",
        "世事纷纷心本懒，闭门岂独畏嫌猜。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32704,
      "title": "寄王嘉叟吏部",
      "content": [
        "宿负烦公议，隆宽荷圣时。",
        "江湖真送老，药饵且扶衰。",
        "抚事惊年往，怀人有梦知。",
        "敢嗟贫到骨，饮水诵君诗。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 32705,
      "title": "夜读隐书有感",
      "content": [
        "平生志慕白云乡，俯仰人间每自伤。",
        "倦鹤摧颓寜望料，寒龟蹙缩且支床。",
        "力探鸿宝寻奇诀，剩采青精试秘方。",
        "常鄙臞仙老山泽，要令仰首看飞翔。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32706,
      "title": "上虞逆旅见旧题岁月感怀",
      "content": [
        "舴艋为家东复西，今朝破晓下前溪。",
        "青山缺处日初上，孤店开时莺乱啼。",
        "倦枕不成千里梦，坏墙闲觅十年题。",
        "漆园傲吏犹非达，物我区区岂足齐。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32707,
      "title": "舜庙怀古",
      "content": [
        "云断苍梧竟不归，江边古庙锁朱扉。",
        "山川不为兴亡改，风月应怜感慨非。",
        "孤枕有时莺唤梦，斜风无赖客添衣。",
        "千年回首消磨尽，输与渔舟送落晖。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32708,
      "title": "题十八学士图",
      "content": [
        "隋日昏曀东南倾，雷塘风吹草木腥。",
        "平时但忌黑色儿，不知乃有虬髯生。",
        "晋阳龙飞云滃滃，关洛万里即日平。",
        "东征归来脱金甲，天策开府延豪英。",
        "琴书闲暇永清昼，簪履光彩明华星。",
        "高参伊吕列佐命，下者才气犹峥嵘。",
        "但余一恨到千载，高阳缪公来窜名。",
        "老奸得志国几丧，李氏诛徙连孤婴。",
        "向令亟念履霜戒，危乱安得存勾萌。",
        "众贤一佞祸尚尔，掩卷涕泪临风横。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 32709,
      "title": "统分稻晚归二首  其一",
      "content": [
        "出裹一箪饭，归收百把禾。",
        "勤劳解堪忍，余暇更吟哦。",
        "岁恶增吾困，家贫赖汝多。",
        "村醪莫辞醉，羮芋学岷峨。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 32710,
      "title": "统分稻晚归二首  其二",
      "content": [
        "薄酒不自酌，夕阳须汝归。",
        "橘包霜后美，豆荚雨中肥。",
        "路远应加饭，天寒莫减衣。",
        "老怀忧自切，道眼看皆非。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 32711,
      "title": "衰病二首  其一",
      "content": [
        "衰病不浪出，闭门烟雨中。",
        "苇花添絮暖，葑火试炉红。",
        "仕宦螘窠梦，功名马耳风。",
        "山翁但更事，人看作神通。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 32712,
      "title": "衰病二首  其二",
      "content": [
        "病除犹老健，雨止得冬晴。",
        "觅句嗟心在，钞书试眼明。",
        "朝寒添布褐，晚步出柴荆。",
        "外慕终无益，儿曹且力耕。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 32713,
      "title": "霜风",
      "content": [
        "十月霜风吼屋边，布裘未办一铢绵。",
        "岂惟饥索邻僧米，真是寒无坐客氊。",
        "身老啸歌悲永夜，家贫撑拄过凶年。",
        "丈夫经此寜非福，破涕灯前一粲然。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32714,
      "title": "小酌",
      "content": [
        "盘箸贫犹设，杯盂老更耽。",
        "宗文树鸡栅，灵照挈蔬篮。",
        "径醉眼花乱，高眠鼻息酣。",
        "觉来寒日晚，落叶拥茆庵。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 32715,
      "title": "十月苦蝇二首  其一",
      "content": [
        "村北村南打稻忙，浮云吹尽见朝阳。",
        "不宜便作晴明看，扑面飞蝇未退藏。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 32716,
      "title": "十月苦蝇二首  其二",
      "content": [
        "十月江南未拥炉，痴蝇扰扰莫嫌渠。",
        "细看岂是坚牢物，付与清霜为扫除。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 32717,
      "title": "丫头岩见周洪道以进士入都日题字",
      "content": [
        "乌巾白纻蹋京尘，瑶树琼林照路人。",
        "西省归来名盖代，两行墨色尚如新。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 32718,
      "title": "独学",
      "content": [
        "师友雕零身白首，杜门独学就谁评。",
        "秋风弃扇知安命，小炷留灯悟养生。",
        "踵息无声酣午枕，舌根忘味美晨烹。",
        "少年妄起功名念，岂信身闲心太平。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32719,
      "title": "霜月",
      "content": [
        "枯草霜花白，寒窗月影新。",
        "惊鸦时绕树，吠犬远随人。",
        "出仕谗销骨，归耕病满身。",
        "世间输坏衲，切莫劝冠巾。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 32720,
      "title": "寄黄龙升老",
      "content": [
        "读书万卷裂儒衣，黄金可成弃不为。",
        "快哉天马不可羁，开口便呼临济儿。",
        "诸方蹴蹋莫支持，吾州一老偶得之。",
        "闭门夜付僧伽黎，明日声价羽檄驰。",
        "弟子不必不如师，黄龙所立尤瑰奇。",
        "空山鬼火号狐狸，筑屋千础食万缁。",
        "痴人不解公游嬉，嫉怒欲碎门前碑。",
        "世衰道丧士自欺，山林亦复践骇机。",
        "长谣寄公公试思，吾辈救此当何施。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 32721,
      "title": "赠进贤刘令",
      "content": [
        "簿领尘埃里，超然见鳯麟。",
        "性疏忘顾忌，学大有经纶。",
        "正论虽频接，高标岂易亲。",
        "向来相识晚，吾党欠斯人。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 32722,
      "title": "书室名可斋或问其义作此告之",
      "content": [
        "得福常廉祸自轻，坦然无愧亦无惊。",
        "平生秘诀今相付，只向君心可处行。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 32723,
      "title": "寄酬杨齐伯少卿",
      "content": [
        "杨卿人材金百炼，岐公座上初识面。",
        "十年万事不须说，犹喜归来且强健。",
        "题诗想见初削瓜，寄到茆堂已归燕。",
        "辞严意密敢轻读，呼儿炷灯重把卷。",
        "即今相望几千里，何日蝉聨语忘倦。",
        "就令有使即寄书，岂如无事长相见。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 32724,
      "title": "自笑",
      "content": [
        "自笑平生醉后狂，千钟使气少年塲。",
        "那知病叶先摧落，却羡寒龟巧缩藏。",
        "药物及时希老健，山家随日了穷忙。",
        "凶年坐待新春麦，莫厌清吟雪夜长。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32725,
      "title": "夜闻松声有感",
      "content": [
        "清晨放船落星石，大风吹颿如箭激。",
        "回头已失庐山云，却上吴城观落日。",
        "夜深龙归擘祠门，入木数寸留爪痕。",
        "明朝就视心尚栗，腥风卷地雷霆奔。",
        "归船买酒持自慰，性命平生惊屡戏。",
        "固知神怒有定时，波纹蹙作鱼鳞细。",
        "如今衰病卧林坰，霜覆茆簷月满庭。",
        "松声惊破三更梦，犹作当时风浪听。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 32726,
      "title": "十二月一日二首  其一",
      "content": [
        "病愈都忘老，晴和已似春。",
        "畦蔬青长甲，塘水绿生鳞。",
        "酒盌论交密，丹炉作梦新。",
        "穷居那敢恨，幸远庾公尘。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 32727,
      "title": "十二月一日二首  其二",
      "content": [
        "东风吹斗柄，暖律变严凝。",
        "草色迷残烧，溪流帯断冰。",
        "儿书春日牓，女剪上元灯。",
        "莫笑蒲龛睡，山翁怯岁增。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 32728,
      "title": "春日二首  其一",
      "content": [
        "老夫一卧三山下，两见城门送土牛。",
        "贫舍春盘还草草，暮年心事转悠悠。",
        "湖光涨绿分烟浦，柳色揺金映市楼。",
        "药饵及时身尚健，无风无雨且闲游。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32729,
      "title": "春日二首  其二",
      "content": [
        "久抛朝帻懒重弹，华发萧然二寸冠。",
        "不恨凄凉侵晚境，犹能语笑向春盘。",
        "银杯酒色家家绿，篛笠烟波处处宽。",
        "一片梅花无复在，却嫌新暖换余寒。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32730,
      "title": "僧房假榻",
      "content": [
        "过尽青山唤渡船，晚窗洗脚卧僧氊。",
        "剩偿平日清游愿，更结来生熟睡缘。",
        "吞啄渐稀如老鹤，鸣声已断似寒蝉。",
        "旁观莫苦嘲痴钝，此妙吾宗秘不传。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32731,
      "title": "闻雨",
      "content": [
        "慷慨心犹壮，蹉跎鬓已秋。",
        "百年殊鼎鼎，万事秪悠悠。",
        "不悟鱼千里，终归貉一丘。",
        "夜阑闻急雨，起坐涕交流。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 32732,
      "title": "休日有感",
      "content": [
        "少年从宦地，休日喜无涯。",
        "坐上强留客，街头旋买花。",
        "开轩催汛扫，脱帽共諠哗。",
        "村巷朋游绝，逢春祇自嗟。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 32733,
      "title": "题徐子礼宗丞自觉斋",
      "content": [
        "末俗纷纷只自谩，惟公肯向静中观。",
        "闲看此事从何得，正自它人著力难。",
        "茶熟松风生石鼎，香残云缕遶蒲团。",
        "江湖多少痴禅衲，蹋破青鞵觅话端。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32734,
      "title": "送张叔潜编修造朝四首  其一",
      "content": [
        "此士名高北斗南，眼中独许我同参。",
        "匆匆却作临分恨，一月何曾笑二三。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 32735,
      "title": "送张叔潜编修造朝四首  其二",
      "content": [
        "简牍清闲胜校讐，题诗应肯寄夔州。",
        "东厨羊美聊堪饱，北面铃稀莫强愁。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 32736,
      "title": "送张叔潜编修造朝四首  其三",
      "content": [
        "北窗铜碾破云腴，扪腹翛然一事无。",
        "安用雁行排院吏，正须鱼贯看胡俘。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 32737,
      "title": "送张叔潜编修造朝四首  其四",
      "content": [
        "芒𪨗年来渐懒穿，闭门日日只高眠。",
        "今朝出送张夫子，借得南邻放鸭船。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 32738,
      "title": "有感",
      "content": [
        "云崦重重不易寻，庖厨性命走山林。",
        "但令有月同幽梦，更用何人识苦心。",
        "流辈渐稀知死近，鬓毛无色觉愁侵。",
        "平生自许忘情者，颇怪灯前感慨深。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32739,
      "title": "涧松",
      "content": [
        "药出山来为小草，楸成树后困长藤。",
        "涧松郁郁何劳叹，却是人间奈废兴。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 32740,
      "title": "将赴官夔府书怀",
      "content": [
        "病夫喜山泽，抗志自年少。",
        "有时缘龟饥，妄出丏鹤料。",
        "亦尝厕朝绅，退懦每自笑。",
        "正如怯酒人，虽爱不敢釂。",
        "一从南昌免，五岁嗟不调。",
        "朝廷每哀矜，幙府误辟召。",
        "终然敛孤迹，万里游绝徼。",
        "民风杂莫徭，封域近无诏。",
        "凄凉黄魔宫，峭绝白帝庙。",
        "又尝闻此邦，野陋可嘲诮。",
        "通衢舞竹枝，谯门对山烧。",
        "浮生一梦耳，何者可庆吊。",
        "但愁瘿累累，把镜羞自照。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 32741,
      "title": "送芮国器司业二首  其一",
      "content": [
        "此心知我岂非天，双鬓皤然气浩然。",
        "曾见灰寒百僚底，真能山立万夫前。",
        "洛城霜重听宫漏，霅水云深著钓船。",
        "拈起吾宗安乐法，人生何处不随缘。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32742,
      "title": "送芮国器司业二首  其二",
      "content": [
        "往岁淮边虏未归，诸生合疏论危机。",
        "人材衰靡方当虑，士气峥嵘未可非。",
        "万事不如公论久，诸贤莫与众心违。",
        "还朝此段宜先及，岂独遗经赖发挥。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32743,
      "title": "春阴",
      "content": [
        "春风浩荡作春阴，弱燕归来不自禁。",
        "白塔昏昏才半露，青山淡淡欲平沉。",
        "裘茸细雨初惊湿，屐齿新泥忽已深。",
        "直怕楼高生客恨，不因病起倦登临。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32744,
      "title": "投梁参政",
      "content": [
        "浮生无根株，志士惜浪死。",
        "鸡鸣何预人，推枕中夕起。",
        "游也本无奇，腰折百僚底。",
        "流离鬓成丝，悲咤涙如洗。",
        "残年走巴峡，辛苦为斗米。",
        "远冲三伏热，前指九月水。",
        "回首长安城，未忍便万里。",
        "袖诗叩东府，再拜求望履。",
        "平生实易足，名幸污黄纸。",
        "但忧死无闻，功不挂青史。",
        "颇闻匈奴乱，天意殄蛇豕。",
        "何时嫖姚师，大刷渭桥耻。",
        "士各奋所长，儒生未宜鄙。",
        "覆氊草军书，不畏寒堕指。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 32745,
      "title": "宿枫桥",
      "content": [
        "七年不到枫桥寺，客枕依然半夜钟。",
        "风月未须轻感慨，巴山此去尚千重。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 32746,
      "title": "晚泊",
      "content": [
        "半世无归似转蓬，今年作梦到巴东。",
        "身游万死一生地，路入千峰百嶂中。",
        "邻舫有时来乞火，樷祠无处不祈风。",
        "晚潮又泊淮南岸，落日啼鸦戍堞空。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32747,
      "title": "金山观日出",
      "content": [
        "系船浮玉山，清晨得奇观。",
        "日轮擘水出，始觉江面宽。",
        "遥波蹙红鳞，翠霭开金盘。",
        "光彩射楼塔，丹碧浮云端。",
        "诗人窘笔力，但咏秋月寒。",
        "何当罗浮望，涌海夜未阑。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 32748,
      "title": "吊李翰林墓",
      "content": [
        "饮似长鲸快吸川，思如渴骥勇奔泉。",
        "客从县令初何有，醉忤将军亦偶然。",
        "骏马名姬如昨日，断碑乔木不知年。",
        "浮生今古同归此，回首桓公亦故阡。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32749,
      "title": "雨中泊赵屯有感",
      "content": [
        "归燕羁鸿共断魂，荻花枫叶泊孤村。",
        "风吹暗浪重添缆，雨送新寒半掩门。",
        "鱼市人烟横惨淡，龙祠箫鼓閙黄昏。",
        "此身且健无余恨，行路虽难莫更论。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32750,
      "title": "黄州",
      "content": [
        "局促常悲类楚囚，迁流还叹学齐优。",
        "江声不尽英雄恨，天意无私草木秋。",
        "万里羁愁添白发，一帆寒日过黄州。",
        "君看赤壁终陈迹，生子何须似仲谋。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32751,
      "title": "武昌感事",
      "content": [
        "百万呼卢事已空，新寒拥褐一衰翁。",
        "但悲鬓色成枯草，不恨生涯似断蓬。",
        "烟雨凄迷云梦泽，山川萧瑟武昌宫。",
        "西游处处堪流涕，抚枕悲歌兴未穷。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32752,
      "title": "夜思",
      "content": [
        "露泣啼螀草，潮生宿雁汀。",
        "经年寄孤舫，终夜托丘亭。",
        "楚泽无穷白，巴山何处青。",
        "四方男子事，不敢恨飘零。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 32753,
      "title": "哀郢二首  其一",
      "content": [
        "远接商周祚最长，北盟齐晋势争强。",
        "章华歌舞终萧瑟，云梦风烟旧莽苍。",
        "草合故宫惟雁起，盗穿荒冢有狐藏。",
        "离骚未尽灵均恨，志士千秋泪满裳。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32754,
      "title": "哀郢二首  其二",
      "content": [
        "荆州十月早梅春，徂岁真同下阪轮。",
        "天地何心穷壮士，江湖从古著羁臣。",
        "淋漓痛饮长亭暮，慷慨悲歌白发新。",
        "欲吊章华无处问，废城霜露湿荆榛。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32755,
      "title": "江陵道中作",
      "content": [
        "山川杂吴楚，气候接秋冬。",
        "水落鱼可拾，霜清裘欲重。",
        "乡遥归梦短，酒薄客愁浓。",
        "白帝何时到，高吟酹卧龙。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 32756,
      "title": "石首县雨中系舟戏作短歌",
      "content": [
        "庚寅去吴西适楚，秋晚孤舟泊江渚。",
        "荒林月黑虎欲行，古道人稀鬼相语。",
        "鬼语亦如人语悲，楚国繁华非昔时。",
        "章华台前小家住，茆屋雨漏秋风吹。",
        "悲哉秦人真虎狼，欺侮六国囚侯王。",
        "亦知兴废古来有，但恨不见秦先亡。",
        "开窗酹汝一杯酒，等为亡国秦更丑。",
        "骊山冢破已千年，至今过者无伤怜。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 32757,
      "title": "初寒",
      "content": [
        "船尾寒风不满旗，江边樷祠常掩扉。",
        "行人畏虎少晨起，舟子捕鱼多夜归。",
        "茆叶翻翻带宿雨，苇花漠漠弄斜晖。",
        "伤心到处闻碪杵，九月今年未授衣。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32758,
      "title": "醉歌",
      "content": [
        "老夫樯竿插苍石，水落岸沙痕数尺。",
        "江南秋尽未揺落，槲叶离离枫叶赤。",
        "楚人自古多悲伤，道傍行歌犹感激。",
        "野花碧紫亦满把，涧果青红正堪摘。",
        "客中得酒薄亦好，江头烂醉真不惜。",
        "千古兴亡在目前，郁郁关河含暝色。",
        "饥鸿垂翅掠舟过，此意与我同凄恻。",
        "三抚阑干恨未平，月明正照颓乌帻。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 32759,
      "title": "秋风",
      "content": [
        "秋风吹客樯，节物叹遐方。",
        "岁事忽云暮，吾行殊未央。",
        "霜清汉水绿，日落楚山苍。",
        "此去三巴路，无猿亦断肠。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 32760,
      "title": "塔子矶",
      "content": [
        "塔子矶前艇子横，一窗秋月为谁明。",
        "青山不减年年恨，白发无端日日生。",
        "七泽苍茫非故国，九歌哀怨有遗声。",
        "古来拨乱非无策，夜半潮平意未平。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32761,
      "title": "重阳",
      "content": [
        "照江丹叶一林霜，折得黄花更断肠。",
        "商略此时须痛饮，细腰宫畔过重阳。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 32762,
      "title": "早寒",
      "content": [
        "沔鄂犹残暑，荆巫已早寒。",
        "潦收滩正白，霜重叶初丹。",
        "节物元非恶，情怀自鲜欢。",
        "暮年更世事，唯有醉江干。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 32763,
      "title": "公安",
      "content": [
        "地旷江天接，沙隤市井移。",
        "避风留半日，买米待多时。",
        "蝶冷停菰叶，鸥驯傍𫇛枝。",
        "昔人勲业地，搔首叹吾衰。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 32764,
      "title": "沙头",
      "content": [
        "游子行愈远，沙头逢暮秋。",
        "孙刘鼎足地，荆益犬牙州。",
        "鼓角风云惨，江湖日夜浮。",
        "此生应衮衮，高枕看东流。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 32765,
      "title": "大寒出江陵西门",
      "content": [
        "平明羸马出西门，淡日寒云久吐吞。",
        "醉面冲风惊易醒，重裘藏手取微温。",
        "纷纷狐兔投深莽，点点牛羊散远村。",
        "不为山川多感慨，岁穷游子自消魂。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32766,
      "title": "江夏与章冠之遇别后寄赠",
      "content": [
        "骑鹤仙人不可呼，一樽犹得与君俱。",
        "未应湖海无豪士，长恨乾坤有腐儒。",
        "壮岁光阴随手过，晚途衰病要人扶。",
        "凄凉江夏秋风里，况见新丰旧酒徒。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32767,
      "title": "题江陵村店壁",
      "content": [
        "青旆三家市，黄茆十里冈。",
        "蓬飞风浩浩，尘起日茫茫。",
        "驰骋多从兽，鉏耰少破荒。",
        "行人相指似，此路走襄阳。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 32768,
      "title": "马上",
      "content": [
        "灯前薄飰陈盐虀，带睡强出行江隄。",
        "五更落月移树影，十月清霜侵马蹄。",
        "荒陂嗈嗈已度雁，小市喔喔初鸣鸡。",
        "可怜万里觅归梦，未到故山先自迷。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32769,
      "title": "水亭有怀",
      "content": [
        "渔村把酒对丹枫，水驿凭轩送去鸿。",
        "道路半年行不到，江山万里看无穷。",
        "故人草诏九天上，老子题诗三峡中。",
        "笑谓毛锥可无恨，书生处处与卿同。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32770,
      "title": "移船",
      "content": [
        "沙际舟衘尾，相依作四邻。",
        "暮年多感慨，分路亦酸辛。",
        "折竹占行日，吹箫赛水神。",
        "无劳问亭驿，久客自知津。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 32771,
      "title": "将离江陵",
      "content": [
        "暮暮过渡头，旦旦走隄上。",
        "舟人与关吏，见熟识颜状。",
        "痴顽久不去，常恐遭诮让。",
        "昨日倒樯竿，今日聮百丈。",
        "买薪备雨雪，储米满瓶盎。",
        "明当遂去此，障袂先侧望。",
        "即今孟冬月，波涛幸非壮。",
        "潦收出奇石，雾卷见叠嶂。",
        "地崄多崎岖，峡束少平旷。",
        "从来乐山水，临老愈跌宕。",
        "皇天怜其狂，择地令自放。",
        "山花白似雪，江水绿于酿。",
        "竹枝本楚些，妙句寄凄怆。",
        "何当出清诗，千古续遗唱。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 32772,
      "title": "六言",
      "content": [
        "三巴亦有何好，万里翩然独寻。",
        "本意为君说破，消磨梦境光阴。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    }
