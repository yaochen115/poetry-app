{
  "data": [
    {
      "id": 376873,
      "title": "长相思·山一程",
      "content": [
        "山一程，水一程，身向榆关那畔行，夜深千帐灯",
        "风一更，雪一更，聒碎乡心梦不成，故园无此声"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 376874,
      "title": "木兰花令·拟古决绝词",
      "content": [
        "人生若只如初见，何事秋风悲画扇",
        "等闲变却故人心，却道故心人易变",
        "骊山语罢清宵半，泪雨霖铃终不怨",
        "何如薄幸锦衣郎，比翼连枝当日愿"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 376875,
      "title": "点绛唇·咏风兰",
      "content": [
        "别样幽芬，更无浓艳催开处",
        "凌波欲去，且为东风住",
        "忒煞萧疏，争奈秋如许",
        "还留取，冷香半缕，第一湘江雨"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 376876,
      "title": "画堂春·一生一代一双人",
      "content": [
        "一生一代一双人，争教两处销魂",
        "相思相望不相亲，天为谁春",
        "浆向蓝桥易乞，药成碧海难奔",
        "若容相访饮牛津，相对忘贫"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 376877,
      "title": "忆秦娥·长飘泊",
      "content": [
        "长飘泊，多愁多病心情恶",
        "心情恶",
        "模糊一片，强分哀乐",
        "拟将欢笑排离索，镜中无奈颜非昨",
        "颜非昨",
        "才华尚浅，因何福薄"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 376878,
      "title": "酒泉子·谢却荼蘼",
      "content": [
        "谢却荼蘼，一片月明如水",
        "篆香消，犹未睡，早鸦啼",
        "嫩寒无赖罗衣薄，休傍阑干角",
        "最愁人，灯欲落，雁还飞"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 376879,
      "title": "菩萨蛮·问君何事轻离别",
      "content": [
        "问君何事轻离别，一年能几团圆月",
        "杨柳乍如丝",
        "故园春尽时",
        "春归归不得，两桨松花隔",
        "旧事逐寒潮，啼鹃恨未消"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 376880,
      "title": "生查子·东风不解愁",
      "content": [
        "东风不解愁，偷展湘裙衩",
        "独夜背纱笼，影著纤腰画",
        "𦶟尽水沉烟，露滴鸳鸯瓦",
        "花骨冷宜香，小立樱桃下"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 376881,
      "title": "浣溪沙·谁念西风独自凉",
      "content": [
        "谁念西风独自凉，萧萧黄叶闭疏窗，沉思往事立残阳",
        "被酒莫惊春睡重，赌书消得泼茶香，当时只道是寻常"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 376882,
      "title": "浣溪沙·郊游联句",
      "content": [
        "出郭寻春春已阑(陈维崧)，东风吹面不成寒(秦松龄)，青村几曲到西山(严绳孙)",
        "并马未须愁路远(姜宸英)，看花且莫放杯闲(朱彝尊)，人生别易会常难(纳兰性德)"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 376883,
      "title": "采桑子·谁翻乐府凄凉曲",
      "content": [
        "谁翻乐府凄凉曲",
        "风也萧萧，雨也萧萧，瘦尽灯花又一宵",
        "不知何事萦怀抱，醒也无聊，醉也无聊，梦也何曾到谢桥"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 376884,
      "title": "生查子·短焰剔残花",
      "content": [
        "短焰剔残花，夜久边声寂",
        "倦舞却闻鸡，暗觉青绫湿",
        "天水接冥蒙，一角西南白",
        "欲渡浣花溪，远梦轻无力"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 376885,
      "title": "生查子·惆怅彩云飞",
      "content": [
        "惆怅彩云飞，碧落知何许",
        "不见合欢花，空倚相思树",
        "总是别时情，那待分明语",
        "判得最长宵，数尽厌厌雨"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 376886,
      "title": "浣溪沙·庚申除夜",
      "content": [
        "收取闲心冷处浓，舞裙犹忆柘枝红",
        "谁家刻烛待春风",
        "竹叶樽空翻采燕，九枝灯灺颤金虫",
        "风流端合倚天公"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 376887,
      "title": "江城子·咏史",
      "content": [
        "湿云全压数峰低",
        "影凄迷，望中疑",
        "非雾非烟，神女欲来时、若问生涯原是梦，除梦里，没人知"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 376888,
      "title": "点绛唇·一种蛾眉",
      "content": [
        "一种蛾眉，下弦不似初弦好",
        "庾郎未老，何事伤心早",
        "素壁斜辉，竹影横窗扫",
        "空房悄，乌啼欲晓，又下西楼了"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 376889,
      "title": "青衫湿·悼亡",
      "content": [
        "近来无限伤心事，谁与话长更",
        "从教分付，绿窗红泪，早雁初莺",
        "当时领略，而今断送，总负多情",
        "忽疑君到，漆灯风飐，痴数春星"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 376890,
      "title": "摊破浣溪沙·葬名花",
      "content": [
        "林下荒苔道韫家，生怜玉骨委尘沙",
        "愁向风前无处说，数归鸦",
        "半世浮萍随逝水，一宵冷雨葬名花",
        "魂是柳绵吹欲碎，绕天涯"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 376891,
      "title": "点绛唇·五夜光寒",
      "content": [
        "五夜光寒，照来积雪平于栈",
        "西风何限，自起披衣看",
        "对此茫茫，不觉成长叹",
        "何时旦，晓星欲散，飞起平沙雁"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 376892,
      "title": "浣溪沙·欲问江梅瘦几分",
      "content": [
        "欲问江梅瘦几分，只看愁损翠罗裙",
        "麝篝衾冷惜余熏",
        "可耐暮寒长倚竹，便教春好不开门",
        "枇杷花底校书人"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 376893,
      "title": "浣溪沙·脂粉塘空遍绿苔",
      "content": [
        "脂粉塘空遍绿苔",
        "掠泥营垒燕相催",
        "妒他飞去却飞回",
        "一骑近从梅里过，片帆遥自藕溪来",
        "博山香烬未全灰"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 376894,
      "title": "梦江南·昏鸦尽",
      "content": [
        "昏鸦尽，小立恨因谁",
        "急雪乍翻香阁絮，轻风吹到胆瓶梅，心字已成灰"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 376895,
      "title": "赤枣子·惊晓漏",
      "content": [
        "惊晓漏，护春眠",
        "格外娇慵只自怜",
        "寄语酿花风日好，绿窗来与上琴弦"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 376896,
      "title": "浣溪沙·残雪凝辉冷画屏",
      "content": [
        "残雪凝辉冷画屏，落梅横笛已三更，更无人处月胧明",
        "我是人间惆怅客，知君何事泪纵横，断肠声里忆平生"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 376897,
      "title": "忆王孙·西风一夜剪芭蕉",
      "content": [
        "西风一夜剪芭蕉，倦眼经秋耐寂寥",
        "强把心情付浊醪",
        "读《离骚》",
        "愁似湘江日夜潮"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 376898,
      "title": "生查子·散帙坐凝尘",
      "content": [
        "散帙坐凝尘，吹气幽兰并",
        "茶名龙凤团，香字鸳鸯饼",
        "玉局类弹棋，颠倒双栖影",
        "花月不曾闲，莫放相思醒"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 376899,
      "title": "浣溪沙·一半残阳下小楼",
      "content": [
        "一半残阳下小楼，朱帘斜控软金钩",
        "倚阑无绪不能愁",
        "有个盈盈骑马过，薄妆浅黛亦风流",
        "见人羞涩却回头"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 376900,
      "title": "浣溪沙·睡起惺忪强自支",
      "content": [
        "睡起惺忪强自支",
        "绿倾蝉鬓下帘时",
        "夜来愁损小腰肢",
        "远信不归空伫望，幽期细数却参差",
        "更兼何事耐寻思"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 376901,
      "title": "浣溪沙·凤髻抛残秋草生",
      "content": [
        "凤髻抛残秋草生",
        "高梧湿月冷无声",
        "当时七夕记深盟",
        "信得羽衣传钿合，悔教罗袜葬倾城",
        "人间空唱雨淋铃"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 376902,
      "title": "如梦令·正是辘轳金井",
      "content": [
        "正是辘轳金井，满砌落花红冷",
        "蓦地一相逢，心事眼波难定",
        "谁省，谁省",
        "从此簟纹灯影"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 376903,
      "title": "如梦令·纤月黄昏庭院",
      "content": [
        "纤月黄昏庭院，语密翻教醉浅",
        "知否那人心",
        "旧恨新欢相半",
        "谁见",
        "谁见",
        "珊枕泪痕红泫"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 376904,
      "title": "采桑子·彤霞久绝飞琼字",
      "content": [
        "彤霞久绝飞琼字，人在谁边",
        "人在谁边，今夜玉清眠不眠",
        "香销被冷残灯灭，静数秋天",
        "静数秋天，又误心期到下弦"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 376905,
      "title": "好事近·何路向家园",
      "content": [
        "何路向家园，历历残山剩水",
        "都把一春冷淡，到麦秋天气",
        "料应重发隔年花，莫问花前事",
        "纵使东风依旧，怕红颜不似"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 376906,
      "title": "忆秦娥·春深浅",
      "content": [
        "春深浅，一痕摇漾青如剪",
        "青如剪",
        "鹭鸶立处，烟芜平远",
        "吹开吹谢东风倦，缃桃自惜红颜变",
        "红颜变",
        "兔葵燕麦，重来相见"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 376907,
      "title": "忆秦娥·山重叠",
      "content": [
        "山重叠",
        "悬崖一线天疑裂",
        "天疑裂",
        "断碑题字，苔痕横啮",
        "风声雷动鸣金铁",
        "阴森潭底蛟龙窟",
        "蛟龙窟",
        "兴亡满眼，旧时明月"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 376908,
      "title": "眼儿媚·咏梅",
      "content": [
        "莫把琼花比澹妆，谁似白霓裳",
        "别样清幽，自然标格，莫近东墙",
        "冰肌玉骨天分付，兼付与凄凉",
        "可怜遥夜，冷烟和月，疏影横窗"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 376909,
      "title": "眼儿媚·重见星娥碧海槎",
      "content": [
        "重见星娥碧海槎，忍笑却盘鸦",
        "寻常多少，月明风细，今夜偏佳",
        "休笼彩笔闲书字，街鼓巳三挝",
        "烟丝欲袅，露光微泫，春在桃花"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 376910,
      "title": "眼儿媚·独倚春寒掩夕扉",
      "content": [
        "独倚春寒掩夕扉，清露泣铢衣",
        "玉萧吹梦，金钗划影，悔不同携",
        "刻残红烛曾相待，旧事总依稀",
        "料应遗恨，月中教去，花底催归"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 376911,
      "title": "摊破浣溪沙·欲语心情梦已阑",
      "content": [
        "欲语心情梦已阑，镜中依约见春山",
        "方悔从前真草草，等闲看",
        "环佩只应归月下，钗钿何意寄人间",
        "多少滴残红蜡泪，几时干"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 376912,
      "title": "摊破浣溪沙·一霎灯前醉不醒",
      "content": [
        "一霎灯前醉不醒，恨如春梦畏分明",
        "淡月淡云窗外雨，一声声",
        "人道情多情转薄，而今真个不多情",
        "又听鹧鸪啼遍了，短长亭"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 376913,
      "title": " 太常引·自题小照 ",
      "content": [
        "西风乍起峭寒生，惊雁避移营",
        "千里暮云平，休回首、长亭短亭",
        "无穷山色，无边往事，一例冷清清",
        "试倩玉萧声，唤千古、英雄梦醒"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 376914,
      "title": "生查子·鞭影落春堤",
      "content": [
        "鞭影落春堤，绿锦鄣泥卷",
        "脉脉逗菱丝，嫩水吴姬眼",
        "啮膝带香归，谁整樱桃宴",
        "蜡泪恼东风，旧垒眠新燕"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 376915,
      "title": "浣溪沙·万里阴山万里沙",
      "content": [
        "万里阴山万里沙",
        "谁将绿鬓斗霜华",
        "年来强半在天涯",
        "魂梦不离金屈戌，画图亲展玉鸦叉",
        "生怜瘦减一分花"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 376916,
      "title": "浣溪沙·姜女庙",
      "content": [
        "海色残阳影断霓，寒涛日夜女郎祠",
        "翠钿尘网上蛛丝",
        "澄海楼高空极目，望夫石在且留题",
        "六王如梦祖龙非"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 376917,
      "title": "减字木兰花·相逢不语",
      "content": [
        "相逢不语，一朵芙蓉著秋雨",
        "小晕红潮，斜溜鬟心只凤翘",
        "待将低唤，直为凝情恐人见",
        "欲诉幽怀，转过回阑叩玉钗"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 376918,
      "title": "采桑子·当时错",
      "content": [
        "而今才道当时错，心绪凄迷",
        "红泪偷垂，满眼春风百事非",
        "情知此后来无计，强说欢期",
        "一别如斯，落尽梨花月又西"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 376919,
      "title": "采桑子·梦一场",
      "content": [
        "谢家庭院残更立，燕宿雕梁",
        "月度银墙，不辨花丛哪瓣香",
        "此情已自成追忆，零落鸳鸯",
        "雨歇微凉，十一年前梦一场！"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 376920,
      "title": "采桑子·拨灯书尽红笺也",
      "content": [
        "拨灯书尽红笺也，依旧无聊",
        "玉漏迢迢，梦里寒花隔玉箫",
        "几竿修竹三更雨，叶叶萧萧",
        "分付秋潮，莫误双鱼到谢桥"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 376921,
      "title": "浣溪沙·莲漏三声烛半条",
      "content": [
        "莲漏三声烛半条，杏花微雨湿红绡",
        "那将红豆记无聊，",
        "春色己看浓似酒，归期安得信如潮",
        "离魂入夜倩谁招"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 376922,
      "title": "浣溪沙·寄严荪友",
      "content": [
        "藕荡桥边理钓筒，苎萝西去五湖东",
        "笔床茶灶太从容",
        "况有短墙银杏雨，更兼高阁玉兰风",
        "画眉闲了画芙蓉"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 376923,
      "title": "浣溪沙·五字诗中目乍成",
      "content": [
        "五字诗中目乍成",
        "尽教残福折书生",
        "手挼裙带那时情",
        "别后心期和梦杳，年来憔悴与愁并",
        "夕阳依旧小窗明"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 376924,
      "title": "浣溪沙·无恙年年汴水流",
      "content": [
        "无恙年年汴水流",
        "一声水调短亭秋",
        "旧时明月照扬州",
        "曾是长堤牵锦缆，绿杨清瘦至今愁",
        "玉钩斜路近迷楼"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 376925,
      "title": "诉衷情·冷落绣衾谁与伴",
      "content": [
        "冷落绣衾谁与伴，倚香篝",
        "春睡起，斜日照梳头",
        "欲写两眉愁，休休",
        "远山残翠收，莫登楼"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 376926,
      "title": "如梦令·木叶纷纷归路",
      "content": [
        "木叶纷纷归路",
        "残月晓风何处",
        "消息半浮沈，今夜相思几许",
        "秋雨，秋雨",
        "一半西风吹去"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 376927,
      "title": "如梦令·万帐穹庐人醉",
      "content": [
        "万帐穹庐人醉，星影摇摇欲坠，归梦隔狼河，又被河声搅碎",
        "还睡、还睡，解道醒来无味"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 376928,
      "title": "如梦令·黄叶青苔归路",
      "content": [
        "黄叶青苔归路，屧粉衣香何处",
        "消息竟沉沉，今夜相思几许",
        "秋雨，秋雨，一半因风吹去"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 376929,
      "title": "昭君怨·暮雨丝丝吹湿",
      "content": [
        "暮雨丝丝吹湿，倦柳愁荷风急",
        "瘦骨不禁秋，总成愁",
        "别有心情怎说，未是诉愁时节，谯鼓已三更，梦须成"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 376930,
      "title": "浣溪沙·容易浓香近画屏",
      "content": [
        "容易浓香近画屏，繁枝影著半窗横",
        "风波狭路倍怜卿",
        "未接语言犹怅望，才通商略已懵腾",
        "只嫌今夜月偏明"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 376931,
      "title": "浣溪沙·肠断班骓去未还",
      "content": [
        "肠断班骓去未还，绣屏深锁凤箫寒",
        "一春幽梦有无间",
        "逗雨疏花浓淡改，关心芳草浅深难",
        "不成风月转摧残"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 376932,
      "title": "浣溪沙·旋拂轻容写洛神",
      "content": [
        "旋拂轻容写洛神，须知浅笑是深颦",
        "十分天与可怜春",
        "掩抑薄寒施软障，抱持纤影藉芳茵",
        "未能无意下香尘"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 376933,
      "title": "菩萨蛮·晶帘一片伤心白",
      "content": [
        "晶帘一片伤心白，云鬟香雾成遥隔",
        "无语问添衣，桐阴月已西",
        "西风鸣络纬，不许愁人睡",
        "只是去年秋，如何泪欲流"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 376934,
      "title": "谒金门·风丝袅",
      "content": [
        "风丝袅，水浸碧天清晓",
        "一镜湿云青未了，雨晴春草草",
        "梦里轻螺谁扫，帘外落花红小",
        "独睡起来情悄悄，寄愁何处好"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 376935,
      "title": "好事近·帘外五更风",
      "content": [
        "帘外五更风，消受晓寒时节",
        "刚剩秋衾一半，拥透帘残月",
        "争教清泪不成冰",
        "好处便轻别",
        "拟把伤离情绪，待晓寒重说"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 376936,
      "title": "好事近·马首望青山",
      "content": [
        "马首望青山，零落繁华如此",
        "再向断烟衰草，认藓碑题字",
        "休寻折载话当年，只洒悲秋泪",
        "斜日十三陵下，过新丰猎骑"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 376937,
      "title": "一络索·野火拂云微绿",
      "content": [
        "野火拂云微绿，西风夜哭",
        "苍茫雁翅列秋空，忆写向、屏山曲",
        "山海几经翻覆，女墙斜矗",
        "看来费尽祖龙心，毕竟为、谁家筑"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 376938,
      "title": "清平乐·将愁不去",
      "content": [
        "将愁不去，秋色行难住",
        "六曲屏山深院宇",
        "日日风风雨雨",
        "雨晴篱菊初香，人言此日重阳",
        "回首凉云暮叶，黄昏无限思量"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 376939,
      "title": "清平乐·塞鸿去矣",
      "content": [
        "塞鸿去矣，锦字何时寄",
        "记得灯前佯忍泪，却问明朝行未",
        "别来几度如珪，飘零落叶成堆",
        "一种晓寒浅梦，妻凉毕竟因谁"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 376940,
      "title": "清平乐·孤花片叶",
      "content": [
        "孤花片叶，断送清秋节",
        "寂寂绣屏香篆灭，暗里朱颜消歇",
        "谁怜散髻吹笙，天涯芳草关情",
        "懊恼隔帘幽梦，半床花月纵横"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 376941,
      "title": "清平乐·才听夜雨",
      "content": [
        "才听夜雨，便觉秋如许",
        "绕砌蛩螀人不语，有梦转愁无据",
        "乱山千叠横江，忆君游倦何方",
        "知否小窗红烛",
        "照人此夜凄凉"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 376942,
      "title": "清平乐·上元月蚀",
      "content": [
        "瑶华映阙，烘散蓂墀雪",
        "比拟寻常清景别，第一团圆时节",
        "影蛾忽泛初弦，分辉借与宫莲",
        "七宝修成合璧，重轮岁岁中天"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 376943,
      "title": "清平乐·凄凄切切",
      "content": [
        "凄凄切切，惨澹黄花节",
        "梦里砧声浑末歇，那更乱蛩悲咽",
        "尘生燕子空楼，抛残弦索床头",
        "一样晓风残月，而今触绪添愁"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 376944,
      "title": "阮郎归·杏花疏雨洒香堤",
      "content": [
        "杏花疏雨洒香堤，高楼帘幕垂",
        "远山映水夕阳低，春愁压翠眉",
        "芳草句，碧云辞，低徊闲自思",
        "流莺枝上不曾啼，知君肠断时"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 376945,
      "title": "眼儿媚·林下闺房世罕俦",
      "content": [
        "林下闺房世罕俦，偕隐足风流",
        "今来忍见，鹤孤华表，人远罗浮",
        "中年定不禁哀乐，其奈忆曾游",
        "浣花微雨，采菱斜日，欲去还留"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 376946,
      "title": "朝中措·蜀弦秦柱不关情",
      "content": [
        "蜀弦秦柱不关情，尽日掩云屏",
        "己惜轻翎退粉，更嫌弱絮为萍",
        "东风多事，余寒吹散，烘暖微酲",
        "看尽一帘红雨，为谁亲系花铃"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 376947,
      "title": " 落花时·夕阳谁唤下楼梯 ",
      "content": [
        "夕阳谁唤下楼梯，一握香荑",
        "回头忍笑阶前立，总无语，也依依",
        "笺书直恁无凭据，休说相思",
        "劝伊好向红窗醉，须莫及，落花时"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 376948,
      "title": " 锦堂春·帘际一痕轻绿 ",
      "content": [
        "帘际一痕轻绿，墙阴几簇低花",
        "夜来微雨西风软，无力任欹斜",
        "仿佛个人睡起，晕红不著铅华",
        "天寒翠袖添凄楚，愁近欲栖鸦"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 376949,
      "title": " 海棠春·落红片片浑如雾 ",
      "content": [
        "落红片片浑如雾，不教更觅桃源路",
        "香径晚风寒，月在花飞处",
        "蔷薇影暗空凝贮",
        "任碧飐轻衫萦住",
        "惊起早栖鸦，飞过秋千去"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 376950,
      "title": "清平乐·画屏无睡",
      "content": [
        "画屏无睡，雨点惊风碎",
        "贪话零星兰焰坠，闲了半床红被",
        "生来柳絮飘零，便教咒也无灵",
        "待问归期还未，已看双睫盈盈"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 376951,
      "title": "点绛唇·小院新凉",
      "content": [
        "小院新凉，晚来顿觉罗衫薄",
        "不成孤酌，形影空酬酢",
        "萧寺怜君，别绪应萧索",
        "西风恶，夕阳吹角，一阵槐花落"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 376952,
      "title": "浣溪沙·咏五更，和湘真韵",
      "content": [
        "微晕娇花湿欲流，簟纹灯影一生愁",
        "梦回疑在远山楼",
        "残月暗窥金屈戍，软风徐荡玉帘钩",
        "待听邻女唤梳头"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 376953,
      "title": " 河渎神·凉月转雕阑 ",
      "content": [
        "凉月转雕阑，萧萧木叶声干",
        "银灯飘落琐窗闲，枕屏几叠秋山",
        "朔风吹透青缣被，药炉火暖初沸",
        "清漏沉沉无寐，为伊判得憔悴"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 376954,
      "title": "相见欢·微云一抹遥峰",
      "content": [
        "微云一抹遥峰，冷溶溶",
        "恰与个人清晓，画眉同",
        "红蜡泪，青绫被，水沉浓",
        "却与黄茅野店，听西风"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 376955,
      "title": "减字木兰花·新月",
      "content": [
        "晚妆欲罢，更把纤眉临镜画",
        "准待分明，和雨和烟两不胜",
        "莫教星替，守取团圆终必遂",
        "此夜红楼，天上人间一样愁"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 376956,
      "title": "减字木兰花·花丛冷眼",
      "content": [
        "花丛冷眼，自惜寻春来较晚",
        "知道今生，知道今生那见卿",
        "天然绝代，不信相思浑不解",
        "若解相思，定与韩凭共一枝"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 376957,
      "title": "减字木兰花·断魂无据",
      "content": [
        "断魂无据，万水千山何处去",
        "没个音书，尽日东风上绿除",
        "故园春好，寄语落花须自扫",
        "莫更伤春，同是恹恹多病人"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 376958,
      "title": "卜算子·五日",
      "content": [
        "村静午鸡啼，绿暗新阴覆",
        "一展轻帘出画墙，道是端阳酒",
        "早晚夕阳蝉，又噪长堤柳",
        "青鬓长青自古谁，弹指黄花九②"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 376959,
      "title": "卜算子·塞草晚才青",
      "content": [
        "塞草晚才青，日落箫笳动，戚戚凄凄入夜分，催度星前梦",
        "小语绿杨烟，怯踏银河冻，行尽关山到白狼，相见惟珍重"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 376960,
      "title": "采桑子·九日",
      "content": [
        "深秋绝塞谁相忆，木叶萧萧",
        "乡路迢迢",
        "六曲屏山和梦遥",
        "佳时倍惜风光别，不为登高",
        "只觉魂销",
        "南雁归时更寂寥"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 376961,
      "title": "采桑子·非关癖爱轻模样",
      "content": [
        "非关癖爱轻模样，冷处偏佳",
        "别有根芽，不是人间富贵花",
        "谢娘别后谁能惜，飘泊天涯",
        "寒月悲笳，万里西风瀚海沙"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 376962,
      "title": "采桑子·谢家庭院残更立",
      "content": [
        "谢家庭院残更立，燕宿雕梁",
        "月度银墙",
        "不辨花丛那辨香",
        "此情已自成追忆，零落鸳鸯",
        "雨歇微凉",
        "十一年前梦一场"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 376963,
      "title": "采桑子·白衣裳凭朱阑立",
      "content": [
        "白衣裳凭朱阑立，凉月趖西",
        "点鬓霜微，岁晏知君归不归",
        "残更目断传书雁，尺素还稀",
        "一味相思，准拟相看似旧时"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 376964,
      "title": "采桑子·冷香萦遍红桥梦",
      "content": [
        "冷香萦遍红桥梦，梦觉城笳",
        "月上桃花，雨歇春寒燕子家",
        "箜篌别后谁能鼓，肠断天涯",
        "暗损韶华，一缕茶烟透碧纱"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 376965,
      "title": "采桑子·海天谁放冰轮满",
      "content": [
        "海天谁放冰轮满，惆怅离情",
        "莫说离情，但值良宵总泪零",
        "只应碧落重相见，那是今生",
        "可奈今生，刚作愁时又忆卿"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 376966,
      "title": "眼儿媚·咏红姑娘",
      "content": [
        "骚屑西风弄晚寒，翠袖倚阑干",
        "霞绡裹处，樱唇微绽，靺鞨红殷",
        "故宫事往凭谁问，无恙是朱颜",
        "玉墀争采，玉钗争插，至正年间"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 376967,
      "title": "采桑子·凉生露气湘弦润",
      "content": [
        "凉生露气湘弦润，暗滴花梢",
        "帘影谁摇，燕蹴风丝上柳条",
        "舞鹍镜匣开频掩，檀粉慵调",
        "朝泪如潮，昨夜香衾觉梦遥"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 376968,
      "title": "临江仙·寒柳",
      "content": [
        "飞絮飞花何处是，层冰积雪摧残，疏疏一树五更寒",
        "爱他明月好，憔悴也相关",
        "最是繁丝摇落后，转教人忆春山",
        "湔裙梦断续应难",
        "西风多少恨，吹不散眉弯"
      ],
      "author": {
        "id": 3074,
        "name": "纳兰性德"
      },
      "dynasty": {
        "id": 10,
        "name": "清"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 376969,
      "title": "沁园春·瞬息浮生",
      "content": [
        "丁巳重阳前三日，梦亡妇淡妆素服，执手硬咽",
        "语多不复能",
        "但临别有云：“衔恨愿为天上月，年年犹得向郎圆”",
        "妇素未工诗，不知何以得此也",
        "觉后感赋长调:",
        "瞬息浮生，薄命如斯，低徊怎忘？",
        "记绣榻闲时，并吹红雨，雕阑曲处，同倚斜阳。",
        "梦好难留，诗残莫续，赢得更深哭一场。",
        "遗容在，只灵飙一转，未许端详。",
        "重寻碧落茫茫，料短发，朝来定有霜。",
        "便人间天上，尘缘未断，春花秋叶，触绪还伤。",
        "欲结绸缪，翻惊摇落，减尽荀衣昨日香。",
        "真无奈，倩声声邻笛，谱出回肠。"
      ],
