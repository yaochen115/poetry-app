{
  "data": [
    {
      "id": 314698,
      "title": "垂丝钓",
      "content": [
        "夕烽戍鼓。",
        "悲凉江岸淮浦。",
        "雾隐孤城，水荒沙聚。",
        "人共语。",
        "尽向来胜处。",
        "谩怀古。",
        "问柳津花渡。",
        "露桥夜月，吹箫人在何许。",
        "缭嫱望篽。",
        "粉黛成黄土。",
        "惟有江东注。",
        "都无虏。",
        "似旧时得否。"
      ],
      "author": {
        "id": 1129,
        "name": "丘崈"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314699,
      "title": "黄河清",
      "content": [
        "鼓角清雄占云祲。",
        "喜边尘、今度还静。",
        "一线乍添，长觉皇州日永。",
        "楼外崇牙影转，拥千骑、欢声万井。",
        "太平官府人初见，梦熊三占佳景。",
        "皇恩夜出天闱，云章粲、凤鸾飞动相映。",
        "宝带万钉，与作今朝佳庆。",
        "勋业如斯得也，况整顿、江淮大定。",
        "这回恰好，归朝去、共调金鼎。"
      ],
      "author": {
        "id": 1129,
        "name": "丘崈"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314700,
      "title": "蓦山溪",
      "content": [
        "风传芳信，晓色便清霁。",
        "帘幕护春寒，篆香温、笙簧韵美。",
        "使华容与，星动帝王州，花上脸，柳边眉，竞报占熊喜。",
        "欢娱好是，玉塞无尘起。",
        "鞭计小迟留，要长折、遐冲万里。",
        "传闻有诏，宣室待归来，醽醁满，叵罗深，莫负春葱指。"
      ],
      "author": {
        "id": 1129,
        "name": "丘崈"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314701,
      "title": "鹧鸪天",
      "content": [
        "怀抱环奇懒叩阍。",
        "朝阳独赋远人村。",
        "即看飞下芝封诏，会见趣归金马门。",
        "今夕饮，拼濡裙。",
        "一时尊俎尽诗人。",
        "唯馀阿买真才劣，醉后犹能写八分。"
      ],
      "author": {
        "id": 1129,
        "name": "丘崈"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314702,
      "title": "鹧鸪天",
      "content": [
        "陆海蓬壶自有山。",
        "光风霁月未应悭。",
        "但将歌舞酬佳节，却信阴晴是等闲。",
        "花照夜，烛烘盘。",
        "明年公更酒肠宽。",
        "奉陪黄伞传柑宴，莫望红妆拥座欢。"
      ],
      "author": {
        "id": 1129,
        "name": "丘崈"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314703,
      "title": "鹧鸪天",
      "content": [
        "准拟关门度一秋。",
        "强扶衰病起相酬。",
        "不辞酩酊还吹帽，自笑鬅鬙怯露头。",
        "江日晚，更迟留。",
        "争传五马足风流。",
        "论车载酒浑闲事，著笼藏花说未休。"
      ],
      "author": {
        "id": 1129,
        "name": "丘崈"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314704,
      "title": "鹧鸪天",
      "content": [
        "两两维舟近柳堤。",
        "菱歌迤逦过前溪。",
        "曲中自诉衷肠事，岸上行人那得知。",
        "金齿屐，翠云篦。",
        "女萝为带蕙为衣。",
        "惜花贪折归时晚，急桨相呼入翠微。"
      ],
      "author": {
        "id": 1129,
        "name": "丘崈"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314705,
      "title": "鹧鸪天",
      "content": [
        "玳瑁宴中见绿珠。",
        "淡然高韵胜施朱。",
        "揉兰雾縠蔷薇浅，半露冰肌玉不如。",
        "餐秀色，味肤腴。",
        "轻红端合与为奴。",
        "只愁宴罢翻成恨，赢得偏怜不似初。"
      ],
      "author": {
        "id": 1129,
        "name": "丘崈"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314706,
      "title": "夜行船",
      "content": [
        "水满平湖香满路。",
        "绕重城、藕花无数。",
        "小艇红妆，疏帘轻盖，烟柳画桥斜渡。",
        "恣乐追凉忘日暮。",
        "箫鼓动、月明人去。",
        "犹有清歌，随风迢递，声在芰荷深处。"
      ],
      "author": {
        "id": 1129,
        "name": "丘崈"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314707,
      "title": "夜行船",
      "content": [
        "一舸鸱夷云水路。",
        "贪游戏、悄忘尘数。",
        "明月长随，清风满载，那向急流争渡。",
        "邂逅占星来已暮。",
        "芝封待、却催归处。",
        "倚玉蒹葭，论文尊俎，回首笑谈何处。"
      ],
      "author": {
        "id": 1129,
        "name": "丘崈"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314708,
      "title": "夜行船",
      "content": [
        "飞舄朝天云作路。",
        "长安近、更无程数。",
        "梧竹当年，丝纶弈世，咫尺凤池平渡。",
        "青眼相逢何太暮。",
        "眉黄透、却愁君去。",
        "官事无多，丰年有暇，莫负赏心佳处。"
      ],
      "author": {
        "id": 1129,
        "name": "丘崈"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314709,
      "title": "夜行船",
      "content": [
        "万柄荷花红绕路。",
        "锦连空、望无层数。",
        "照水旌旗，临风鼓吹，行遍月桥烟渡。",
        "堪笑年华今已暮。",
        "身西上、梦魂东去。",
        "一曲亭边，五云门外，犹记最花多处。"
      ],
      "author": {
        "id": 1129,
        "name": "丘崈"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314710,
      "title": "临江仙",
      "content": [
        "天上玉卮称万寿，人间湛露初匀。",
        "种萱堂上阅青春。",
        "薰风频送喜，同日拜丝纶。",
        "班在蕊珠仙缀立，等闲历遍燕秦。",
        "紫皇先付与佳名。",
        "宜家更宜国，宜子又宜孙。"
      ],
      "author": {
        "id": 1129,
        "name": "丘崈"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314711,
      "title": "感皇恩",
      "content": [
        "时节近中秋，桂花天气。",
        "忆得熊罴梦呈瑞。",
        "向来三度，恨被一官萦系。",
        "今朝称寿，也休辞醉。",
        "斑衣戏彩，薄罗初试。",
        "华发双亲剩欢喜。",
        "功名荣贵，未要匆匆深计。",
        "一杯先要祝，千百岁。"
      ],
      "author": {
        "id": 1129,
        "name": "丘崈"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314712,
      "title": "蝶恋花",
      "content": [
        "梅子著花当献寿。",
        "得得天工，有意还知否。",
        "教在岁寒双雪后。",
        "长年不羡松筠茂。",
        "莫厌杯深歌舞奏。",
        "约略丝纶，正是来时候。",
        "富贵明年公自有。",
        "天香公烛黄封酒。"
      ],
      "author": {
        "id": 1129,
        "name": "丘崈"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314713,
      "title": "蝶恋花",
      "content": [
        "鼓吹东方天欲晓。",
        "打彻伊州，梅柳都开了。",
        "尽道鄞江春许早。",
        "使君未到春先到。",
        "号令只凭花信报。",
        "旗垒精明，家世临淮妙。",
        "遥想明年元夕好。",
        "玉人更著华灯照。"
      ],
      "author": {
        "id": 1129,
        "name": "丘崈"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314714,
      "title": "蝶恋花",
      "content": [
        "逼砌筠窗围小院。",
        "日照花枝，疏影重重见。",
        "金鸭无风香自暖。",
        "腊寒才比春寒浅。",
        "画景温温烘笔砚。",
        "闲把安西，六纸都临遍。",
        "茗碗不禁幽梦远。",
        "鹊来唤起斜阳晚。"
      ],
      "author": {
        "id": 1129,
        "name": "丘崈"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314715,
      "title": "一翦梅",
      "content": [
        "潇洒佳人淡淡妆。",
        "特地凌寒，秀出孤芳。",
        "雪为肌体练为裳。",
        "韵处天姿，不御铅黄。",
        "古样铜壶湿篆章。",
        "浅浸横斜，净几明窗。",
        "何妨三弄点苔苍。",
        "但有疏枝，依旧清香。"
      ],
      "author": {
        "id": 1129,
        "name": "丘崈"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314716,
      "title": "天仙子",
      "content": [
        "畏暑只嫌秋较晚。",
        "不道玉楼人渐远。",
        "此情那解却清凉，肠欲断。",
        "愁无限。",
        "安得冰壶还照眼。",
        "妙舞蹁跹歌宛转。",
        "走遍京华何处见。",
        "清眠无梦到西州，馀香浅。",
        "银钩软。",
        "唯仗锦书聊自遣。"
      ],
      "author": {
        "id": 1129,
        "name": "丘崈"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314717,
      "title": "朝中措",
      "content": [
        "晚风斜日折梅花。",
        "楼外卷残霞。",
        "领略一城春气，华灯十万人家。",
        "轻衫短帽，风前趁马，月下随车。",
        "道个小来脚定，那人笑隔笼纱。"
      ],
      "author": {
        "id": 1129,
        "name": "丘崈"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314718,
      "title": "朝中措",
      "content": [
        "几回相与叹高才。",
        "忽报驭风来。",
        "谁道亟朝天阕，更能同上春台。",
        "主人早晚，班联玉笋，行听连催。",
        "湖上饱赓新唱，思堂快泻深杯。"
      ],
      "author": {
        "id": 1129,
        "name": "丘崈"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314719,
      "title": "朝中措",
      "content": [
        "尊前宾主角多才。",
        "亦许我同来。",
        "诗思竞翻三峡，酒狂欲拗连台。",
        "身闲有限，莫辞光景，刻烛相催。",
        "沙路即看联辔，上林趁赏流杯。"
      ],
      "author": {
        "id": 1129,
        "name": "丘崈"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314720,
      "title": "菩萨蛮",
      "content": [
        "壶边击断歌无节。",
        "山川一带伤情切。",
        "依旧石头城。",
        "夕阳天外明。",
        "行人谁是侣。",
        "遗唱今何许。",
        "对酒转愁多。",
        "愁多奈酒何。"
      ],
      "author": {
        "id": 1129,
        "name": "丘崈"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314721,
      "title": "菩萨蛮",
      "content": [
        "秋声夜到秋香园。",
        "重帘拭卷都开遍。",
        "只似旧时香。",
        "更添些子黄。",
        "绮窗人共赋。",
        "犹忆分香句。",
        "别后几回秋。",
        "见花空复愁。"
      ],
      "author": {
        "id": 1129,
        "name": "丘崈"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314722,
      "title": "菩萨蛮",
      "content": [
        "云林带水山横阁。",
        "故人去尽添萧索。",
        "反照射微茫。",
        "临分愁夕阳。",
        "传柑当令节。",
        "连璧朝天阕。",
        "还有雁西飞。",
        "慰人新别离。"
      ],
      "author": {
        "id": 1129,
        "name": "丘崈"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314723,
      "title": "西江月",
      "content": [
        "恰好轻篷短棹，绝胜锦缆牙樯。",
        "一声横笛起微茫。",
        "十里红莲步障。",
        "小待山头吐月，何妨说剑杯长。",
        "更看风露洗湖光。",
        "水底金盘滉漾。"
      ],
      "author": {
        "id": 1129,
        "name": "丘崈"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314724,
      "title": "西江月",
      "content": [
        "明日又还重九，黄昏小雨疏风。",
        "菊英萸糁一尊同。",
        "付与今宵号梦。",
        "寒意梧桐叶上，客愁画角声中。",
        "小楼何日却从容。",
        "千里此情应共。"
      ],
      "author": {
        "id": 1129,
        "name": "丘崈"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314725,
      "title": "梅弄影",
      "content": [
        "雨晴风定。",
        "一任春寒逞。",
        "要勒群芳未醒。",
        "不废梅花，晚来妆面靓。",
        "曲阑斜凭。",
        "水栏临清镜。",
        "翠竹箫骚相映。",
        "付与幽人，巡池看弄影。"
      ],
      "author": {
        "id": 1129,
        "name": "丘崈"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314726,
      "title": "诉衷情",
      "content": [
        "东风罨岸进船难。",
        "酒醒篆香残。",
        "不堪客里无绪，那更晚来寒。",
        "思往事，耿无眠。",
        "掩屏山。",
        "夜深人静，何处一声，月子弯弯。"
      ],
      "author": {
        "id": 1129,
        "name": "丘崈"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314727,
      "title": "诉衷情",
      "content": [
        "素衣苍狗不成妍。",
        "何意妒蝉娟。",
        "不知高处难掩，终自十分圆。",
        "涵万象，独当天。",
        "照无边。",
        "乾坤呈露，何况人间，大地山川。"
      ],
      "author": {
        "id": 1129,
        "name": "丘崈"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314728,
      "title": "诉衷情",
      "content": [
        "芙蓉深径小肩舆。",
        "相并语徐徐。",
        "红妆著处迎笑，遮路索踟蹰。",
        "锦步障，绣储胥。",
        "绕重湖。",
        "更添月照，人面花枝，疑在蓬壶。"
      ],
      "author": {
        "id": 1129,
        "name": "丘崈"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314729,
      "title": "诉衷情",
      "content": [
        "十分风味似诗人。",
        "有些子太清生。",
        "只应最嫌俗子，消瘦却盈盈。",
        "风乍静，雪初晴。",
        "月微明。",
        "泊然疏淡，莫是无情，作个关情。"
      ],
      "author": {
        "id": 1129,
        "name": "丘崈"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314730,
      "title": "锦帐春",
      "content": [
        "翠竹如屏，浅山如画。",
        "小池面、危桥一跨。",
        "著棕亭临水，宛然郊野。",
        "竹篱茅舍。",
        "好是天寒，倍添幽雅。",
        "正雪意、垂垂欲下。",
        "更朦胧月影，弄明初夜。",
        "梅花动也。"
      ],
      "author": {
        "id": 1129,
        "name": "丘崈"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314731,
      "title": "谒金门",
      "content": [
        "风又雨。",
        "吹面落花红舞。",
        "把酒不禁春思苦。",
        "别离闻杜宇。",
        "叠嶂楼头佳处。",
        "犹想襞笺容与。",
        "思入云山便好语。",
        "莫辞频寄取。"
      ],
      "author": {
        "id": 1129,
        "name": "丘崈"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314732,
      "title": "谒金门",
      "content": [
        "槐阴绿。",
        "帘卷翠屏山曲。",
        "照眼冰壶寒并玉。",
        "赐衣便雾縠。",
        "熊梦又惊初卜。",
        "好在掖垣梧竹。",
        "应讶人归犹未速。",
        "已颁新诏墨。"
      ],
      "author": {
        "id": 1129,
        "name": "丘崈"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314733,
      "title": "谒金门",
      "content": [
        "罗袖薄。",
        "玉臂镂花金约。",
        "起晚欠伸莲步弱。",
        "倚床娇韵恶。",
        "独自青楼珠箔。",
        "怎向日长花落。",
        "门掩东风春寂寞。",
        "误人瞋喜鹊。"
      ],
      "author": {
        "id": 1129,
        "name": "丘崈"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314734,
      "title": "谒金门",
      "content": [
        "花雨润。",
        "烟锁玉炉香韵。",
        "笑度华年春不尽。",
        "寿觞寒食近。",
        "甲子才周一瞬。",
        "争羡珠颜青鬓。",
        "咫尺朝元仙路稳。",
        "碧云新有信。"
      ],
      "author": {
        "id": 1129,
        "name": "丘崈"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314735,
      "title": "好事近",
      "content": [
        "空涧落鸣泉，千骑雨霖衣铁。",
        "金奏欲终人醉，有玉声清越。",
        "夜深纤手怯轻寒，馀韵寄愁绝。",
        "玉树梦回何处，但满庭霜月。"
      ],
      "author": {
        "id": 1129,
        "name": "丘崈"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314736,
      "title": "好事近",
      "content": [
        "整整一冬晴，雨后不论朝夕。",
        "麦陇救得一半，莫妨他寒食。",
        "试看天气定乘除，宽更待三日。",
        "桃李且须宁耐，有无边春色。"
      ],
      "author": {
        "id": 1129,
        "name": "丘崈"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314737,
      "title": "浣溪沙",
      "content": [
        "铁锁星桥永夜通。",
        "万家帘幕度香风。",
        "俊游人在笑声中。",
        "罗绮十行眉黛绿，银花千炬簇莲红。",
        "座中争看黑头公。"
      ],
      "author": {
        "id": 1129,
        "name": "丘崈"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314738,
      "title": "浣溪沙",
      "content": [
        "胜子幡儿袅鬓云。",
        "钗头绝唱旧曾闻。",
        "江城喜见又班春。",
        "拂柳和风初有信，欺梅残雪已无痕。",
        "只应笑语作春温。"
      ],
      "author": {
        "id": 1129,
        "name": "丘崈"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314739,
      "title": "浪淘沙",
      "content": [
        "潇洒无湖仙。",
        "踏遍尘寰。",
        "吟哦长忆两松闲。",
        "邂逅天涯还一笑，璧合珠连。",
        "风采照衰残。",
        "妙语冷然。",
        "妓围香暖簇金蝉。",
        "端为故人情未减，醉玉颓山。"
      ],
      "author": {
        "id": 1129,
        "name": "丘崈"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314740,
      "title": "定风波",
      "content": [
        "月殿移根入帝乡。",
        "风流犹是旧时妆。",
        "猩血染成丹杏脸。",
        "浓点。",
        "郁金笼就赭衣黄。",
        "浪说锦城元自少。",
        "不道。",
        "只今何啻五枝芳。",
        "试问司花谁是主。",
        "传语。",
        "且烦都与十分香。"
      ],
      "author": {
        "id": 1129,
        "name": "丘崈"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314741,
      "title": "卜算子",
      "content": [
        "翠被怯轻寒，花气撩幽梦。",
        "梦蹑飞云驾彩鸾，惊觉花枝动。",
        "宿酒未全醒，屋角闻晴哢。",
        "爱著荼シ彻骨香，嗅了还重□。"
      ],
      "author": {
        "id": 1129,
        "name": "丘崈"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314742,
      "title": "柳梢青",
      "content": [
        "风佩珊珊。",
        "云屏曲曲，愁绝春悭。",
        "无奈馀寒。",
        "半醒宿酒，御夹成单。",
        "深沈院落人闲。",
        "凭阑处、眉颦黛残。",
        "彩笔慵拈。",
        "新声微度，兴入云山。"
      ],
      "author": {
        "id": 1129,
        "name": "丘崈"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314743,
      "title": "点绛唇",
      "content": [
        "花落花开，等闲不管流年度。",
        "旧游何处。",
        "浅立空凝伫。",
        "惊拍栏干，忍见春将暮。",
        "凭风絮。",
        "为人飞去。",
        "散作愁无数。"
      ],
      "author": {
        "id": 1129,
        "name": "丘崈"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314744,
      "title": "醉花阴",
      "content": [
        "碧玉槎桠金粟小。",
        "山路惊秋老。",
        "倒倚湿寒烟，似怯秋风，阁泪啼清晓。",
        "铜壶冷浸宜深窈。",
        "人试新妆巧。",
        "云鬓一枝斜，小阁幽窗，是处都香了。"
      ],
      "author": {
        "id": 1129,
        "name": "丘崈"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314745,
      "title": "愁倚阑・春光好",
      "content": [
        "风雨骤，妒花黄。",
        "忽斜阳。",
        "急手打开君会否，是伊凉。",
        "深深密密传觞。",
        "似差胜、落帽清狂。",
        "满引休辞还醉倒，却何妨。"
      ],
      "author": {
        "id": 1129,
        "name": "丘崈"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314746,
      "title": "如梦令",
      "content": [
        "门外绮罗入绣。",
        "堂上华灯入昼。",
        "领略一番春，共醉连宵歌酒。",
        "今后。",
        "今后。",
        "如此遨头少有。"
      ],
      "author": {
        "id": 1129,
        "name": "丘崈"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314747,
      "title": "如梦令",
      "content": [
        "小小峰峦对起。",
        "芳树重重相倚。",
        "清溜绕阶除，聊备一池春水。",
        "游戏。",
        "游戏。",
        "适意随缘足矣。"
      ],
      "author": {
        "id": 1129,
        "name": "丘崈"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314748,
      "title": "太常引",
      "content": [
        "憎人虎豹守天关。",
        "嗟蜀道、十分难。",
        "说与沐猴冠。",
        "这富贵、于人怎谩。",
        "忘形尊俎，能言桃李，日日在东山。",
        "不醉有馀欢。",
        "唱好个、风流谢安。"
      ],
      "author": {
        "id": 1129,
        "name": "丘崈"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314749,
      "title": "南歌子",
      "content": [
        "影落三秋月，寒生六月霜。",
        "是谁幻出玉筼筜。",
        "乞与一枝和雪、钓漓湘。",
        "劲节依琳馆，虚心漏草堂。",
        "笔端元自有雌黄。",
        "疑是化龙蜚到、葛仙旁。"
      ],
      "author": {
        "id": 6147,
        "name": "朱晞颜"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314750,
      "title": "沁园春",
      "content": [
        "月晃西窗，风掀斗帐，晓来梦回。",
        "见满川惊鹭，长空瑞鹤，联翩来下，翔舞徘徊。",
        "旋放金磐承积块，更轻撼琼壶撩冻澌。",
        "毡帏小，近宝炉兽炭，沈水兰煤。",
        "寒威。",
        "酒力相欺。",
        "荐绿蚁霜螯左右持。",
        "问岁岁祯祥，如何中断，年年梅月，因甚愆期。",
        "上绀碧楼，城高百尺，看白玉虬龙奔四围。",
        "纷争罢，正残鳞败甲，天上交飞。"
      ],
      "author": {
        "id": 11270,
        "name": "吕胜己"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314751,
      "title": "醉桃源・阮郎归",
      "content": [
        "山翁可是爱登台。",
        "看云日几回。",
        "恨无语似谪仙才。",
        "空教云去来。",
        "思往事，引深杯。",
        "长歌感壮怀。",
        "霜风晚下扫阴霾。",
        "天心宝鉴开。"
      ],
      "author": {
        "id": 11270,
        "name": "吕胜己"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314752,
      "title": "醉桃源・阮郎归",
      "content": [
        "马蹄西路赏春妍。",
        "重来十五年。",
        "好山如带水如环。",
        "红楼罨画闲。",
        "人易老，景如前。",
        "停杯俯逝川。",
        "归舟回首望云烟。",
        "秦人隔洞天。"
      ],
      "author": {
        "id": 11270,
        "name": "吕胜己"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314753,
      "title": "醉桃源・阮郎归",
      "content": [
        "去年手种十株梅。",
        "而今犹未开。",
        "山翁一日走千迥。",
        "今朝蝶也来。",
        "高树杪，暗香微。",
        "悭香越恼怀。",
        "更烧银烛引春回。",
        "英英露粉腮。"
      ],
      "author": {
        "id": 11270,
        "name": "吕胜己"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314754,
      "title": "蝶恋花",
      "content": [
        "墙角栽梅分两下。",
        "夹竹穿松，巧傍柴门亚。",
        "不似西湖明月夜。",
        "展开一片江南画。",
        "老子寻芳心已罢。",
        "为爱孤高，结约如莲社。",
        "清静界中观物化。",
        "憧憧门外驰车马。"
      ],
      "author": {
        "id": 11270,
        "name": "吕胜己"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314755,
      "title": "蝶恋花",
      "content": [
        "天际行云红一缕。",
        "无尽青山，江水悠悠去。",
        "更上层楼凭远处。",
        "凄凉今古悲三楚。",
        "心事多端谁共语。",
        "酒醒愁来，望望家何所。",
        "薄宦漂零成久旅。",
        "天涯却羡鸿遵渚。"
      ],
      "author": {
        "id": 11270,
        "name": "吕胜己"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314756,
      "title": "蝶恋花",
      "content": [
        "姑射真仙蓬海会。",
        "驭气乘龙，作意游方外。",
        "冬后翦花飞素彩。",
        "腊前陨璞抛团块。",
        "幂幂锦云相映带。",
        "川谷林峦，混一乾坤大。",
        "白玉装成全世界。",
        "江湖点染微瑕颣。"
      ],
      "author": {
        "id": 11270,
        "name": "吕胜己"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314757,
      "title": "蝶恋花",
      "content": [
        "屈指瓜期犹渺渺。",
        "羡子征鞍，去上长安道。",
        "到得故园春正好。",
        "桃腮杏脸迎门笑。",
        "闻道难兄登显要。",
        "雁子云宵，花萼应同调。",
        "旧恨新愁须拼了。",
        "功名趁取方年少。"
      ],
      "author": {
        "id": 11270,
        "name": "吕胜己"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314758,
      "title": "蝶恋花",
      "content": [
        "眼约心期常未足。",
        "邂逅今朝，暂得论心曲。",
        "忽堕鲛珠红簌簌。",
        "双眸翦水明如烛。",
        "可恨匆匆归去速。",
        "去去行云，望断凄心目。",
        "何似当初情未熟。",
        "免教添得愁千斛。"
      ],
      "author": {
        "id": 11270,
        "name": "吕胜己"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314759,
      "title": "蝶恋花",
      "content": [
        "天色沈沈云色赭。",
        "风扰阴寒，浩荡吹平野。",
        "万斛珠玑天弃舍。",
        "长空撒下鸣鸳瓦。",
        "玉女凝愁金阕下。",
        "褪粉残妆，和泪轻挥洒。",
        "欲降尘凡飙驭驾。",
        "翩翩白凤先来也。"
      ],
      "author": {
        "id": 11270,
        "name": "吕胜己"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314760,
      "title": "长相思",
      "content": [
        "体夭夭。",
        "步飘飘。",
        "绶带金泥缕绛绡。",
        "珑璁趁步摇。",
        "浅霞消。",
        "两峰遥。",
        "斜插层楼金系腰。",
        "花羞人面娇。"
      ],
      "author": {
        "id": 11270,
        "name": "吕胜己"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314761,
      "title": "长相思",
      "content": [
        "展颦蛾。",
        "抹流波。",
        "并插玲珑碧玉梭。",
        "松分两髻螺。",
        "晓霜和。",
        "冻轻呵。",
        "拍罢阳春白雪歌。",
        "偎人春意多。"
      ],
      "author": {
        "id": 11270,
        "name": "吕胜己"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314762,
      "title": "长相思",
      "content": [
        "冒寒吹。",
        "访琼姬。",
        "行到青山遇玉肌。",
        "凝情欲待谁。",
        "山疏篱。",
        "手同携。",
        "踏月随香清夜归。",
        "乘欢拨冻醅。"
      ],
      "author": {
        "id": 11270,
        "name": "吕胜己"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314763,
      "title": "浣溪沙",
      "content": [
        "浅著铅华素净妆。",
        "翩跹翠袖拂云裳。",
        "傍人作意捧金觞。",
        "曲度清悲云冉冉，花飞零乱月茫茫。",
        "梦回人去似高唐。"
      ],
      "author": {
        "id": 11270,
        "name": "吕胜己"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314764,
      "title": "浣溪沙",
      "content": [
        "直系腰围鹤间霞。",
        "双垂项帕凤穿花。",
        "新妆全学内人家。",
        "惠性芳心谁得似，饶嗔□恶也还他。",
        "只消凡事与饶些。"
      ],
      "author": {
        "id": 11270,
        "name": "吕胜己"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314765,
      "title": "清平乐",
      "content": [
        "红尘久住。",
        "仙驭凌波去。",
        "本似行云无定处。",
        "那更腊残风雨。",
        "瑶芳片片轻飞。",
        "但留青子栾枝。",
        "孤负岁寒幽意，如今却与春宜。"
      ],
      "author": {
        "id": 11270,
        "name": "吕胜己"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314766,
      "title": "清平乐",
      "content": [
        "灵心暗属。",
        "髻垒黄金粟。",
        "寂静虚堂情不足。",
        "微步徘徊山麓。",
        "蕊珠宫里新妆。",
        "生香全似瑶芳。",
        "应为莺花留恋，人间暂歇鸾凤。"
      ],
      "author": {
        "id": 11270,
        "name": "吕胜己"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314767,
      "title": "促拍满路花",
      "content": [
        "名花无影迹，寒气日凄凉。",
        "人间千万树，歇芬芳。",
        "紫微宫女，仙驭降霓裳。",
        "名在仙班簿，不属尘凡，洞天密锁云窗。",
        "遗珰连宝珥，人间识天香。",
        "凝寒承雨露，傲冰霜。",
        "凌仙仙子，邂逅水云乡。",
        "更约南枝友，游遍江南，共归三岛扶桑。"
      ],
      "author": {
        "id": 11270,
        "name": "吕胜己"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314768,
      "title": "谒金门",
      "content": [
        "花满树。",
        "两个黄鹂相语。",
        "恰似碧城双玉女。",
        "对歌还对舞。",
        "可惜娟娟楚楚。",
        "同伴彩云归去。",
        "居士心如泥上絮。",
        "那能无恨处。"
      ],
      "author": {
        "id": 11270,
        "name": "吕胜己"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314769,
      "title": "谒金门",
      "content": [
        "嗟久客。",
        "又见他乡寒食。",
        "流水断桥春寂寂。",
        "孤村烟火息。",
        "白去红飞无迹。",
        "千树总成新碧。",
        "醉里伤春愁似织。",
        "东风欺酒力。"
      ],
      "author": {
        "id": 11270,
        "name": "吕胜己"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314770,
      "title": "谒金门",
      "content": [
        "芳思切，旧事不堪重说。",
        "浓露凝香花喷血。",
        "花心双蛱蝶。",
        "燕语莺啼都歇。",
        "又过清明时节。",
        "记得离歌三两阕。",
        "未歌先哽咽。"
      ],
      "author": {
        "id": 11270,
        "name": "吕胜己"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314774,
      "title": "谒金门",
      "content": [
        "春又过。",
        "那更雨摧风挫。",
        "留得浅红三两朵。",
        "竹梢烟雾锁。",
        "把酒对花危坐。",
        "多病多愁都可。",
        "舞蝶游蜂迷道左。",
        "惜春忙似我。"
      ],
      "author": {
        "id": 11270,
        "name": "吕胜己"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314775,
      "title": "谒金门",
      "content": [
        "秋夜静。",
        "屋上狂风初定。",
        "两两啼蛄相答应。",
        "灯蛾摇烛影。",
        "枕上鸡声遥听。",
        "起舞良宵偏永。",
        "明日谩寻弓剑整。",
        "衰颜重揽镜。"
      ],
      "author": {
        "id": 11270,
        "name": "吕胜己"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314776,
      "title": "谒金门",
      "content": [
        "芳信拆。",
        "漏泄东君消息。",
        "帝殿宝炉烟未熄。",
        "龙香飘片白。",
        "点缀枯梢的皪。",
        "疏影摇荡寒碧。",
        "指与纤纤教自摘。",
        "枝横云鬓侧。"
      ],
      "author": {
        "id": 11270,
        "name": "吕胜己"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314777,
      "title": "谒金门",
      "content": [
        "天气暖。",
        "开了荼䕷一半。",
        "红日迟迟风拂面。",
        "阶前花影乱。",
        "俊雅风流不见。",
        "定被莺花留恋。",
        "千尺游丝舒又罥。",
        "系人心上线。"
      ],
      "author": {
        "id": 11270,
        "name": "吕胜己"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314778,
      "title": "谒金门",
      "content": [
        "歌罢奏。",
        "敛步拂开罗袖。",
        "宝扇轻摇香汗透。",
        "软香沾素手。",
        "小立偎人良久。",
        "一寸娇波横溜。",
        "心事未言眉已皱。",
        "无端催劝酒。"
      ],
      "author": {
        "id": 11270,
        "name": "吕胜己"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314779,
      "title": "南乡子",
      "content": [
        "斗笠棹边舟。",
        "碧水湾头放自流。",
        "尽日垂丝鱼不上，优游。",
        "更觉心松奈得愁。",
        "行客语沧洲。",
        "笑道渔翁太拙休。",
        "万事要求须有道，何由。",
        "教与敲针换曲钩。"
      ],
      "author": {
        "id": 11270,
        "name": "吕胜己"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314780,
      "title": "南乡子",
      "content": [
        "纵棹越溪船。",
        "破浪冲涛到碧湾。",
        "种就长堤千亩竹，无边。",
        "插玉屯云满渭川。",
        "平日乐归田。",
        "不恋荣华不慕仙。",
        "得个容身栖隐处，宽闲。",
        "每日江边理钓竿。"
      ],
      "author": {
        "id": 11270,
        "name": "吕胜己"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314781,
      "title": "减字木兰花",
      "content": [
        "烟云变化。",
        "面面青山如展画。",
        "俯对平川。",
        "野水烟村远接天。",
        "有时纵目。",
        "景物繁华观不足。",
        "月下风头。",
        "一曲清讴博见楼。"
      ],
      "author": {
        "id": 11270,
        "name": "吕胜己"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314782,
      "title": "瑞鹤仙",
      "content": [
        "南州春又到。",
        "向腊尽冬残，冰姑先报。",
        "芳心爱春早。",
        "露生香馥馥，靓妆皎皎。",
        "诗人最巧。",
        "道竹外、斜枝更好。",
        "旋移根引水，浇培松竹，凑成三妙。",
        "回首。",
        "当年客里，荆棘途中，幸陪欢笑。",
        "闲愁似扫。",
        "记风雪、关山道。",
        "待飘花结子，和羹煮酒，还我山居送老。",
        "那青红、浪蕊浮花，尽锄去了。"
      ],
      "author": {
        "id": 11270,
        "name": "吕胜己"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314783,
      "title": "瑞鹤仙",
      "content": [
        "倚阑观四远。",
        "近有客登临，故相磨难。",
        "山形欠舒展。",
        "小峰峦云树，晦明更变。",
        "江淮楚甸。",
        "又何曾、分明在眼。",
        "但临深、自觉身高，未可便名博见。",
        "休辨。",
        "吾心乐处，不要他人，共同称善。",
        "痴儿浅浅。",
        "因他谩说一遍。",
        "问还知宴坐，回光收视，大地河山尽现。",
        "待于中、会得些时，举觞奉劝。"
      ],
      "author": {
        "id": 11270,
        "name": "吕胜己"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314784,
      "title": "瑞鹤仙",
      "content": [
        "人生如意少。",
        "谁得似仙翁，身名俱好。",
        "亨衢腾踏早。",
        "驾双旌五马，便居蓬岛。",
        "闽山蜀道。",
        "秉玉节、油幢屡到。",
        "号当今、有脚阳春，处处变愁成笑。",
        "尤妙。",
        "晚陪论道。",
        "密赞调元，虎符重剖。",
        "去劳自保。",
        "奉香火、归来了。",
        "见煌煌甲第，两两龙驹，绿鬓朱颜未到。",
        "是平生、种德阴功，自天有报。"
      ],
      "author": {
        "id": 11270,
        "name": "吕胜己"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314785,
      "title": "瑞鹤仙",
      "content": [
        "金枝联玉叶。",
        "世代有宗英，声华烨烨。",
        "君侯更超绝。",
        "抱不群才气，壮图英发。",
        "津途轨辙。",
        "□武上、青宵迥别。",
        "自玉阶、契合君王，拍拍满怀风月。",
        "奇绝。",
        "身居萧散，志在功名，眼高天阔。",
        "恩来魏阕。",
        "长江上、驻旌节。",
        "待胡尘有警，纶巾羽扇，谈笑周郎事业。",
        "恁时看、国倚强宗，诏褒伟烈。"
      ],
      "author": {
        "id": 11270,
        "name": "吕胜己"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314786,
      "title": "瑞鹤仙",
      "content": [
        "残梅飘簌簌。",
        "看柳上春归，揉条新绿。",
        "娇莺离幽谷。",
        "弄弹簧清响，飞迁乔木。",
        "年华迅速。",
        "叹浮生、流晖转烛。",
        "自春来、每每遨游，多办九霞醽醁。",
        "溪北。",
        "踏青微步，斗草慵眠，锦裀花褥。",
        "铅华簇簇。",
        "歌声妙、间丝竹。",
        "爱一川好处，高山流水，不减城南杜曲。",
        "笑平生、卓地无锥，老来富足。"
      ],
      "author": {
        "id": 11270,
        "name": "吕胜己"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314787,
      "title": "满江红",
      "content": [
        "往事千端，都销道、衰翁宦拙。",
        "今会得、人情物态，尽皆休说。",
        "广厦尽堪舒笑傲，层楼又见凌空阔。",
        "试闲思、画戟比衡门，谁优劣。",
        "尘里事，无休歇。",
        "楼上事、真奇绝。",
        "有一川虚旷，万山环列。",
        "识破古今如旦暮，肯将物我刚分别。",
        "愿时时、与客坐楼心，谈风月。"
      ],
      "author": {
        "id": 11270,
        "name": "吕胜己"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314788,
      "title": "满江红",
      "content": [
        "屈指重阳，有半月、犹零九日。",
        "且停待、今宵月上，宝轮飞出。",
        "有客最谙闲况味，无人会得真消息。",
        "算何须、抵死要荣华，劳心力。",
        "楼观迥、遥山碧。",
        "槽窄小，真珠滴。",
        "随分赏、闲亭别圃，好天良夕。",
        "篱畔行看金蕊耀，林梢便见瑶芳白。",
        "玩春来、夏去复秋冬，尘中客。"
      ],
      "author": {
        "id": 11270,
        "name": "吕胜己"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314789,
      "title": "满江红",
      "content": [
        "小立危亭，风惨淡、斜阳满目。",
        "望渺渺、湘江一派，楚山千簇。",
        "芳草连云迷远树，断霞散绮飞孤骛。",
        "感骚人、赋客向来词，愁如束。",
        "磋远宦、甘微粟。",
        "惊世事，伤浮俗。",
        "且经营一醉，未怀荣辱。",
        "君不见、渊明归去后，一觞自泛东篱菊。",
        "仰高风、寂寞奠生刍，人如玉。"
      ],
      "author": {
        "id": 11270,
        "name": "吕胜己"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314790,
      "title": "满江红",
      "content": [
        "忆惜西来，春已暮、馀寒犹力。",
        "正迤逦、登山临水，未磋行役。",
        "云笈偶寻高士传，桃川又访秦人迹。",
        "向此时、游宦兴阑珊，归无策。",
        "归计定，归心追。",
        "惊换岁，犹为客。",
        "还怅望、家山千里，迥无消息。",
        "□□不堪泥路远，烟林赖有梅花白。",
        "为孤芳、领略岁寒情，谁人识。"
      ],
      "author": {
        "id": 11270,
        "name": "吕胜己"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314791,
      "title": "满江红",
      "content": [
        "物理分明，人事巧、元来是拙。",
        "常自觉、满怀春意，向他谁说。",
        "剩喜登临频眺望，那知出处成迂阔。",
        "细闲思、萧散较贪痴，谁为劣。",
        "高楼上、蝉声歇。",
        "飞楝外，云行绝。",
        "见明河星斗，半空森列。",
        "领略光阴成赋咏，等闲酬唱休旌别。",
        "要良辰、把酒倩佳宾，嘲风月。"
      ],
      "author": {
        "id": 11270,
        "name": "吕胜己"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314792,
      "title": "满江红",
      "content": [
        "拍碎红牙，一声上、梁尘暗落。",
        "纨扇掩、雏莺叶下，巧呈绰约。",
        "字字只愁郎幸浅，声声似怨年华薄。",
        "坐中人、相顾感幽怀，添萧索。",
        "歌暂阕，杯交错。",
        "人又去，情怀沪。",
        "那堪听风雨，渭城吹角。",
        "去去已离闽岭路，行行渐近滕王阁。",
        "便无情、山海会相逢，坚心著。"
      ],
      "author": {
        "id": 11270,
        "name": "吕胜己"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314793,
      "title": "满江红",
      "content": [
        "檀扳频催，双拈袖、飞来趁拍。",
        "锦裀上、娇抬粉面，浅蛾脉脉。",
        "鸾观莺窥秋水净，鸿惊凤翥祥云白。",
        "看妖娆、体态与山精神，天仙谪。",
        "鞓带紧，弓靴窄。",
        "花压帽，云垂额。",
        "□回雪、定拼醉倒，厌厌良夕。",
        "明日恨随芳草远，回头目断遥山隔。",
        "料多情、应也念行人，思佳客。"
      ],
      "author": {
        "id": 11270,
        "name": "吕胜己"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314794,
      "title": "满江红",
      "content": [
        "墙下松筠，并手种、花窠尽著。",
        "试屈指、一年前事，恍然如昨。",
        "繁杏新荷春夏景，疏梅细菊秋冬约。",
        "渭川翁、随分小生涯，些官爵。",
        "分物我，争强弱。",
        "都作梦，谁先觉。",
        "好一条平路，是人迷却。",
        "斑鬓已灰心里事，瘦滕谩卦瓢中药。",
        "愿当今、四海九州人，同欢乐。"
      ],
      "author": {
        "id": 11270,
        "name": "吕胜己"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314795,
      "title": "满江红",
      "content": [
        "雪压山颓，谁撒下、琼花玉蕊。",
        "寒气凛、沈沈天籁，望迷千里。",
        "群雀耐寒枯树顶，扁舟独钓平沙觜。",
        "把江南、图画展开看，都难比。",
        "台榭远、登临喜。",
        "楼阁上，歌声起。",
        "赏时光，居士独怜愁底。",
        "安得四方寒畯彦，归吾广厦千间里。",
        "但今生、此愿得从心，心休矣。"
      ],
      "author": {
        "id": 11270,
        "name": "吕胜己"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314796,
      "title": "满江红",
      "content": [
        "惨惨枯梢，初疑似、真酥点滴。",
        "见深红蒂萼，方认早梅消息。",
        "粉艳牵连春意动，冰姿照映霜华白。",
        "伴苍松、修竹似幽人，相寻觅。",
        "香远近，枝南北。",
        "幽涧畔，疏篱侧。",
        "便佣儿贩妇，也知怜惜。",
        "渭水渔翁方入社，西湖处士成陈迹。",
        "爱平生、炯炯岁寒心，无今昔。"
      ],
      "author": {
        "id": 11270,
        "name": "吕胜己"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314797,
      "title": "江城子",
      "content": [
        "年年腊后见冰姑。",
        "玉肌肤。",
        "点琼酥。",
        "不老花荣，经岁转敷腴。",
        "向背稀稠如画里，明月下、影疏疏。",
        "江南有客问征途。",
        "寄音书。",
        "定来无。",
        "且傍盆池，巧石倚浮图。",
        "静对北山林处士，妆点就、小西湖。"
      ],
      "author": {
        "id": 11270,
        "name": "吕胜己"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314798,
      "title": "江城子",
      "content": [
        "一钩新月下庭西。",
        "绣帘低。",
        "漏声迟。",
        "小宴幽欢，依约似当时。",
        "娇盼注人都不语，眉黛蹙，鬓云敧。",
        "街槐阴下玉骢嘶。",
        "苦相催。",
        "醉中归。",
        "可惜明朝，秋色满东篱。",
        "只恐又成轻别也，情脉脉，恨凄凄。"
      ],
      "author": {
        "id": 11270,
        "name": "吕胜己"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314799,
      "title": "满庭芳",
      "content": [
        "丹雘浮空，琉璃耀日，上云楼阁眈眈。",
        "□□居士，燕坐息玄谈。",
        "十载劳心问道，今悟罢、截日停参。",
        "凝神处，九苞丹凤，翔舞在山南。",
        "喃喃。",
        "成障碍，千经万论，从此休贪。",
        "且陶陶兀兀，对酒醺酣。",
        "清兴有时狂放，扁舟上、绿水澄潭。",
        "渔歌起，从他两岸，齐笑老翁憨。"
      ],
      "author": {
        "id": 11270,
        "name": "吕胜己"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 314800,
      "title": "卜算子",
      "content": [
        "人事几时穷，我性偏宜静。",
        "世上谁无富贵心，到了须由命。",
        "闲里且偷安，醉后休教醒。",
        "醉里高歌妙入神，妙处君须听。"
      ],
      "author": {
        "id": 11270,
        "name": "吕胜己"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    }
