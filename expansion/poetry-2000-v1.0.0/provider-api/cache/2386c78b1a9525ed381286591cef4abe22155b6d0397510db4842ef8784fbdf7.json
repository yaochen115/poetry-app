{
  "data": [
    {
      "id": 313496,
      "title": "虞美人",
      "content": [
        "飞花自有牵情处。",
        "不向枝边坠。",
        "随风飘荡已堪愁。",
        "更伴东流流水、过秦楼。",
        "楼中翠黛含春怨。",
        "闲倚阑干见。",
        "远弹双泪惜香红。",
        "暗恨玉颜光景、与花同。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313497,
      "title": "虞美人",
      "content": [
        "曲阑干外天如水。",
        "昨夜还曾倚。",
        "初将明月比佳期。",
        "长向月圆时候、望人归。",
        "罗衣著破前香在。",
        "旧意谁教改。",
        "一春离恨懒调弦。",
        "犹有两行闲泪、宝筝前。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313498,
      "title": "虞美人",
      "content": [
        "疏梅月下歌金缕。",
        "忆共文君语。",
        "更谁情浅似春风。",
        "一夜满枝新绿、替残红。",
        "苹香已有莲开信。",
        "两桨佳期近。",
        "采莲时节定来无。",
        "醉后满身花影、倩人扶。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313499,
      "title": "虞美人",
      "content": [
        "玉箫吹遍烟花路。",
        "小谢经年去。",
        "更教谁画远山眉。",
        "又是陌头风细、恼人时。",
        "时光不解年年好。",
        "叶上秋声早。",
        "可怜蝴蝶易分飞。",
        "只有杏梁双燕、每来归。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313500,
      "title": "虞美人",
      "content": [
        "秋风不似春风好。",
        "一夜金英老。",
        "更谁来凭曲阑干。",
        "惟有雁边斜月、照关山。",
        "双星旧约年年在。",
        "笑尽人情改。",
        "有期无定是无期。",
        "说与小云新恨、也低眉。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313501,
      "title": "虞美人",
      "content": [
        "小梅枝上东君信。",
        "雪后花期近。",
        "南枝开尽北枝开。",
        "长被陇头游子、寄春来。",
        "年年衣袖年年泪。",
        "总为今朝意。",
        "问谁同是忆花人。",
        "赚得小鸿眉黛、也低颦。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313502,
      "title": "虞美人",
      "content": [
        "湿红笺纸回纹字。",
        "多少柔肠事。",
        "去年双燕欲归时。",
        "还是碧云千里、锦书迟。",
        "南楼风月长依旧。",
        "别恨无端有。",
        "倩谁横笛倚危阑。",
        "今夜落梅声里、怨关山。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313503,
      "title": "虞美人",
      "content": [
        "一弦弹尽仙韶乐。",
        "曾破千金学。",
        "玉楼银烛夜深深。",
        "愁见曲中双泪、落香襟。",
        "从来不奈离声怨。",
        "几度朱弦断。",
        "未知谁解赏新音。",
        "长是好风明月、暗知心。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313504,
      "title": "采桑子",
      "content": [
        "秋千散后朦胧月，满院人闲。",
        "几处雕阑。",
        "一夜风吹杏粉残。",
        "昭阳殿里春衣就，金缕初干。",
        "莫信朝寒。",
        "明日花前试舞看。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313505,
      "title": "采桑子",
      "content": [
        "花前独占春风早，长爱江梅。",
        "秀艳清杯。",
        "芳意先愁凤管催。",
        "寻香已落闲人后，此恨难裁。",
        "更晚须来。",
        "却恐初开胜未开。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313506,
      "title": "采桑子",
      "content": [
        "芦鞭坠遍杨花陌，晚见珍珍。",
        "疑是朝云。",
        "来作高唐梦里人。",
        "应怜醉落楼中帽，长带歌尘。",
        "试拂香茵。",
        "留解金鞍睡过春。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313507,
      "title": "采桑子",
      "content": [
        "日高庭院杨花转，闲淡春风。",
        "昨夜匆匆。",
        "颦入遥山翠黛中。",
        "金盆水冷菱花净，满面残红。",
        "欲洗犹慵。",
        "弦上啼乌此夜同。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313508,
      "title": "采桑子",
      "content": [
        "征人去日殷勤嘱，莫负心期。",
        "寒雁来时。",
        "第一传书慰别离。",
        "轻春织就机中素，泪墨题诗。",
        "欲寄相思。",
        "日日高楼看雁飞。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313509,
      "title": "采桑子",
      "content": [
        "花时恼得琼枝瘦，半被残香。",
        "睡损梅妆。",
        "红泪今春第一行。",
        "风流笑伴相逢处，白马游缰。",
        "共折垂杨。",
        "手拈芳条说夜长。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313510,
      "title": "采桑子",
      "content": [
        "春风不负年年信，长趁花期。",
        "小锦堂西。",
        "红杏初开第一枝。",
        "碧箫度曲留人醉，昨夜归迟。",
        "短恨凭谁。",
        "莺语殷勤月落时。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313511,
      "title": "采桑子",
      "content": [
        "秋来更觉消魂苦，小字还稀。",
        "坐想行思。",
        "怎得相看似旧时。",
        "南楼把手凭肩处，风月应知。",
        "别后除非。",
        "梦里时时得见伊。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313512,
      "title": "采桑子",
      "content": [
        "谁将一点凄凉意，送入低眉。",
        "画箔闲垂。",
        "多是今宵得睡迟。",
        "夜痕记尽窗间月，曾误心期。",
        "准拟相思。",
        "还是窗间记月时。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313513,
      "title": "采桑子",
      "content": [
        "宜春苑外楼堪倚，雪意方浓。",
        "雁影冥蒙。",
        "正共银屏小景同。",
        "可无人解相思处，昨夜东风。",
        "梅蕊应红。",
        "知在谁家锦字中。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313514,
      "title": "采桑子",
      "content": [
        "白莲池上当时月，今夜重圆。",
        "曲水兰船。",
        "忆伴飞琼看月眠。",
        "黄花绿酒分携后，泪湿吟笺。",
        "旧事年年。",
        "时节南湖又采莲。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313515,
      "title": "采桑子",
      "content": [
        "高吟烂醉淮西月，诗酒相留。",
        "明日归舟。",
        "碧藕花中醉过秋。",
        "文姬赠别双团扇，自写银钩。",
        "散尽离愁。",
        "携得清风出画楼。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313516,
      "title": "采桑子",
      "content": [
        "前欢几处笙歌地，长负登临。",
        "月幌风襟。",
        "犹忆西楼著意深。",
        "莺花见尽当时事，应笑如今。",
        "一寸愁心。",
        "日日寒蝉夜夜砧。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313517,
      "title": "采桑子",
      "content": [
        "无端恼破桃源梦，明日青楼。",
        "玉腻花柔。",
        "不学行云易去留。",
        "应嫌衫袖前香冷，重傍金虬。",
        "歌扇风流。",
        "遮尽归时翠黛愁。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313518,
      "title": "采桑子",
      "content": [
        "年年此夕东城见，欢意匆匆。",
        "明日还重。",
        "却在楼台缥缈中。",
        "垂螺拂黛清歌女，曾唱相逢。",
        "秋月春风。",
        "醉枕香衾一岁同。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313519,
      "title": "采桑子",
      "content": [
        "双螺未学同心绾，已占歌名。",
        "月白风清。",
        "长倚昭华笛里声。",
        "知音敲尽朱颜改，寂寞时情。",
        "一曲离亭。",
        "惜与青楼忍泪听。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313520,
      "title": "采桑子",
      "content": [
        "西楼月下当时见，泪粉偷匀。",
        "歌罢还颦。",
        "恨隔炉烟看未真。",
        "别来楼外垂杨缕，几换青春。",
        "倦客红尘。",
        "长记楼中粉泪人。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313521,
      "title": "采桑子",
      "content": [
        "非花非雾前时见，满眼娇春。",
        "浅笑微颦。",
        "恨隔垂帘看未真。",
        "殷勤借问家何处，不在红尘。",
        "若是朝云。",
        "宜作今宵梦里人。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313522,
      "title": "采桑子",
      "content": [
        "当时月下分飞处，依旧凄凉。",
        "也会思量。",
        "不道孤眠夜更长。",
        "泪痕揾遍鸳鸯枕，重绕回廊。",
        "月上东窗。",
        "长到如今欲断肠。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313523,
      "title": "采桑子",
      "content": [
        "湘妃浦口莲开尽，昨夜红稀。",
        "懒过前溪。",
        "闲舣扁舟看雁飞。",
        "去年谢女池边醉，晚雨霏微。",
        "记得归时。",
        "旋折新荷盖舞衣。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313524,
      "title": "采桑子",
      "content": [
        "别来长记西楼事，结遍兰襟。",
        "遗恨重寻。",
        "弦断相如绿绮琴。",
        "何时一枕逍遥夜，细话初心。",
        "若问如今。",
        "也似当时著意深。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313525,
      "title": "采桑子",
      "content": [
        "红窗碧玉新名旧，犹绾双螺。",
        "一寸秋波。",
        "千斛明珠觉未多。",
        "小来竹马同游客，惯听清歌。",
        "今日蹉跎。",
        "恼乱工夫晕翠蛾。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313526,
      "title": "采桑子",
      "content": [
        "昭华凤管知名久，长闭帘栊。",
        "闻道春慵。",
        "方倚庭花晕脸红。",
        "可怜金谷无人后，此会相逢。",
        "三弄临风。",
        "送得当筵玉盏空。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313527,
      "title": "采桑子",
      "content": [
        "金风玉露初凉夜，秋草窗前。",
        "浅醉闲眠。",
        "一枕江风梦不圆。",
        "长情短恨难凭寄，枉费红笺。",
        "试拂么弦。",
        "却恐琴心可暗传。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313528,
      "title": "采桑子",
      "content": [
        "心期昨夜寻思遍，犹负殷勤。",
        "齐斗堆金。",
        "难买丹诚一寸真。",
        "须知枕上尊前意，占得长春。",
        "寄语东邻。",
        "似此相看有几人。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313529,
      "title": "踏莎行",
      "content": [
        "柳上烟归，池南雪尽。",
        "东风渐有繁华信。",
        "花开花谢蝶应知，春来春去莺能问。",
        "梦意犹疑，心期欲近。",
        "云笺字字萦方寸。",
        "宿妆曾比杏腮红，忆人细把香英认。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313530,
      "title": "踏莎行",
      "content": [
        "宿雨收尘，朝霞破暝。",
        "风光暗许花期定。",
        "玉人呵手试妆时，粉香帘幕阴阴静。",
        "斜雁朱弦，孤鸾绿镜。",
        "伤春误了寻芳兴。",
        "去年今日杏墙西，啼莺唤得闲愁醒。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313531,
      "title": "踏莎行",
      "content": [
        "绿径穿花，红楼压水。",
        "寻芳误到蓬莱地。",
        "玉颜人是蕊珠仙，相逢展尽双蛾翠。",
        "梦草闲眠，流觞浅醉。",
        "一春总见瀛洲事。",
        "别来双燕又西飞，无端不寄相思字。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313532,
      "title": "踏莎行",
      "content": [
        "雪尽寒轻，月斜烟重。",
        "清欢犹记前时共。",
        "迎风朱户背灯开，拂檐花影侵帘动。",
        "绣枕双鸳，香苞翠凤。",
        "从来往事都如梦。",
        "伤心最是醉归时，眼前少个人人送。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313533,
      "title": "满庭芳",
      "content": [
        "南苑吹花，西楼题叶，故园欢事重重。",
        "凭阑秋思，闲记旧相逢。",
        "几处歌云梦雨，可怜便、流水西东。",
        "别来久，浅情未有，锦字系征鸿。",
        "年光还少味，开残槛菊，落尽溪桐。",
        "漫留得，尊前淡月西风。",
        "此恨谁堪共说，清愁付、绿酒杯中。",
        "佳期在，归时待把，香袖看啼红。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313534,
      "title": "留春令",
      "content": [
        "画屏天畔，梦回依约，十洲云水。",
        "手拈红笺寄人书，写无限、伤春事。",
        "别浦高楼曾漫倚。",
        "对江南千里。",
        "楼下分流水声中，有当日、凭高泪。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313535,
      "title": "留春令",
      "content": [
        "采莲舟上，夜来陡觉，十分秋意。",
        "懊恼寒花暂时香，与情浅、人相似。",
        "玉蕊歌清招晚醉。",
        "恋小桥风细。",
        "水湿红裙酒初消，又记得、南溪事。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313536,
      "title": "留春令",
      "content": [
        "海棠风横，醉中吹落，香红强半。",
        "小粉多情怨花飞，仔细把、残香看。",
        "一抹浓檀秋水畔。",
        "缕金衣新换。",
        "鹦鹉杯深艳歌迟，更莫放、人肠断。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313537,
      "title": "风入松",
      "content": [
        "柳阴庭院杏梢墙。",
        "依旧巫阳。",
        "凤箫已远青楼在，水沈谁、复暖前香。",
        "临镜舞鸾离照，倚筝飞雁辞行。",
        "坠鞭人意自凄凉。",
        "泪眼回肠。",
        "断云残雨当年事，到如今、几处难忘。",
        "两袖晓风花陌，一帘夜月兰堂。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313538,
      "title": "风入松",
      "content": [
        "心心念念忆相逢。",
        "别恨谁浓。",
        "就中懊恼难拼处，是擘钗、分钿匆匆。",
        "却似桃源路失，落花空记前踪。",
        "彩笺书尽浣溪红。",
        "深意难通。",
        "强欢𣨼酒图消遣，到醒来、愁闷还重。",
        "若是初心未改，多应此意须同。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313539,
      "title": "清商怨",
      "content": [
        "庭花香信尚浅。",
        "最玉楼先暖。",
        "梦觉春衾，江南依旧远。",
        "回纹锦字暗翦。",
        "漫寄与、也应归晚。",
        "要问相思，天涯犹自短。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313540,
      "title": "秋蕊香",
      "content": [
        "池苑清阴欲就。",
        "还傍送春时候。",
        "眼中人去难欢偶。",
        "谁共一杯芳酒。",
        "朱阑碧砌皆如旧。",
        "记携手。",
        "有情不管别离久。",
        "情在相逢终有。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313541,
      "title": "秋蕊香",
      "content": [
        "歌彻郎君秋草。",
        "别恨远山眉小。",
        "无情莫把多情恼。",
        "第一归来须早。",
        "红尘自古长安道。",
        "故人少。",
        "相思不比相逢好。",
        "此别朱颜应老。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313542,
      "title": "思远人",
      "content": [
        "红叶黄花秋意晚，千里念行客。",
        "飞云过尽，归鸿无信，何处寄书得。",
        "泪弹不尽临窗滴。",
        "就砚旋研墨。",
        "渐写到别来，此情深处，红笺为无色。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313543,
      "title": "碧牡丹",
      "content": [
        "翠袖疏纨扇。",
        "凉叶催归燕。",
        "一夜西风，几处伤高怀远。",
        "细菊枝头，开嫩香还遍。",
        "月痕依旧庭院。",
        "事何限。",
        "怅望秋意晚。",
        "离人鬓华将换。",
        "静忆天涯，路比此情犹短。",
        "试约鸾笺，传素期良愿。",
        "南云应有新雁。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313544,
      "title": "长相思",
      "content": [
        "长相思。",
        "长相思。",
        "若问相思甚了期。",
        "除非相见时。",
        "长相思。",
        "长相思。",
        "欲把相思说似谁。",
        "浅情人不知。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313545,
      "title": "醉落魄・一斛珠",
      "content": [
        "满街斜月。",
        "垂鞭自唱阳关彻。",
        "断尽柔肠思归切。",
        "都为人人，不许多时别。",
        "南桥昨夜风吹雪。",
        "短长亭下征尘歇。",
        "归时定有梅堪折。",
        "欲把离愁，细拈花枝说。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313546,
      "title": "醉落魄・一斛珠",
      "content": [
        "鸾孤月缺。",
        "两春惆怅音尘绝。",
        "如今若负当时节。",
        "信道欢缘，狂向衣襟结。",
        "若问相思何处歇。",
        "相逢便是相思彻。",
        "尽饶别后留心别。",
        "也待相逢，细把相思说。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313547,
      "title": "醉落魄・一斛珠",
      "content": [
        "天教命薄。",
        "青楼占得声名恶。",
        "对酒当歌寻思著。",
        "月户星窗，多少旧期约。",
        "相逢细语初心错。",
        "两行红泪尊前落。",
        "霞觞且共深深酌。",
        "恼乱春宵，翠被都闲却。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313548,
      "title": "醉落魄・一斛珠",
      "content": [
        "休休莫莫。",
        "离多还是因缘恶。",
        "有情无奈思量著。",
        "月夜佳期，近写青笺约。",
        "心心口口长恨昨。",
        "分飞容易当时错。",
        "后期休似前欢薄。",
        "买断青楼，莫放春闲却。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313549,
      "title": "望仙楼・胡捣练",
      "content": [
        "小春花信日边来，未上江楼先坼。",
        "今岁东君消息。",
        "还自南枝得。",
        "素衣染尽天香，玉酒添成国色。",
        "一自故溪疏隔。",
        "肠断长相忆。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313550,
      "title": "凤孤飞",
      "content": [
        "一曲画楼钟动，宛转歌声缓。",
        "绮席飞尘满。",
        "更少待、金蕉暖。",
        "细雨轻寒今夜短。",
        "依前是、粉墙别馆。",
        "端的欢期应未晚。",
        "奈归云难管。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313551,
      "title": "西江月",
      "content": [
        "愁黛颦成月浅，啼妆印得花残。",
        "只消鸳枕夜来闲。",
        "晓镜心情便懒。",
        "醉帽檐头风细，征衫袖口香寒。",
        "绿江春水寄书难。",
        "携手佳期又晚。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313552,
      "title": "西江月",
      "content": [
        "南苑垂鞭路冷，西楼把袂人稀。",
        "庭花犹有鬓边枝。",
        "且插残红自醉。",
        "画幕凉催燕去，香屏晓放云归。",
        "依前青枕梦回时。",
        "试问闲愁有几。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313553,
      "title": "武陵春",
      "content": [
        "绿蕙红兰芳信歇，金蕊正风流。",
        "应为诗人多怨秋。",
        "花意与消愁。",
        "梁王苑路香英密，长记旧嬉游。",
        "曾看飞琼戴满头。",
        "浮动舞梁州。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313554,
      "title": "武陵春",
      "content": [
        "九日黄花如有意，依旧满珍丛。",
        "谁似龙山秋兴浓。",
        "吹帽落西风。",
        "年年岁岁登高节，欢事旋成空。",
        "几处佳人此会同。",
        "今在泪痕中。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313555,
      "title": "武陵春",
      "content": [
        "烟柳长堤知几曲，一曲一魂消。",
        "秋水无情天共遥。",
        "愁送木兰桡。",
        "熏香绣被心情懒，期信转迢迢。",
        "记得来时倚画桥。",
        "红泪满鲛绡。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313556,
      "title": "解佩令",
      "content": [
        "玉阶秋感，年华暗去。",
        "掩深宫、团扇无绪。",
        "记得当时，自翦下、机中轻素。",
        "点丹青、画成秦女。",
        "凉襟犹在，朱弦未改，忍霜纨、飘零何处。",
        "自古悲凉，是情事、轻如云雨。",
        "倚么弦、恨长难诉。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313557,
      "title": "行香子",
      "content": [
        "晚绿寒红。",
        "芳意匆匆。",
        "惜年华、今与谁同。",
        "碧云零落，数字征鸿。",
        "看渚莲凋，宫扇旧，怨秋风。",
        "流波坠叶，佳期何在，想天教、离恨无穷。",
        "试将前事，闲倚梧桐。",
        "有消魂处，明月夜，粉屏空。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313558,
      "title": "庆春时",
      "content": [
        "倚天楼殿，升平风月，彩仗春移。",
        "鸾丝凤竹，长生调里，迎得翠舆归。",
        "雕鞍游罢，何处还有心期。",
        "浓熏翠被，深停画烛，人约月西时。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313559,
      "title": "庆春时",
      "content": [
        "梅梢已有，春来音信，风意犹寒。",
        "南楼暮雪，无人共赏，闲却玉阑干。",
        "殷勤今夜，凉月还似眉弯。",
        "尊前为把，桃根丽曲，重倚四弦看。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313560,
      "title": "喜团圆",
      "content": [
        "危楼静锁，窗中远岫，门外垂杨。",
        "珠帘不禁春风度，解偷送馀香。",
        "眠思梦想，不如双燕，得到兰房。",
        "别来只是，凭高泪眼，感旧离肠。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313561,
      "title": "忆闷令",
      "content": [
        "取次临鸾匀画浅。",
        "酒醒迟来晚。",
        "多情爱惹闲愁，长黛眉低敛。",
        "月底相逢花下见。",
        "有深深良愿。",
        "愿期信、似月如花，须更教长远。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313562,
      "title": "梁州令",
      "content": [
        "莫唱阳关曲。",
        "泪湿当年金缕。",
        "离歌自古最消魂，闻歌更在魂消处。",
        "南楼杨柳多情绪。",
        "不系行人住。",
        "人情却似飞絮。",
        "悠扬便逐春风去。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313563,
      "title": "燕归梁",
      "content": [
        "莲叶雨，蓼花风。",
        "秋恨几枝红。",
        "远烟收尽水溶溶。",
        "飞雁碧云中。",
        "衷肠事。",
        "鱼笺字。",
        "情绪年年相似。",
        "凭高双袖晚寒浓。",
        "人在月桥东。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313564,
      "title": "胡捣练",
      "content": [
        "小亭初报一枝梅，惹起江南归兴。",
        "遥想玉溪风景，水漾横斜影。",
        "异香直到醉乡中，醉后还因香醒。",
        "好是玉容相并。",
        "人与花争莹。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313565,
      "title": "扑蝴蝶",
      "content": [
        "风梢雨叶，绿遍江南岸。",
        "思归倦客，寻芳来最晚。",
        "酒边红日初长，陌上飞花正满。",
        "凄凉数声弦管。",
        "怨春短。",
        "玉人应在，明月楼中画眉懒。",
        "鱼笺锦字，多时音信断。",
        "恨如去水空长，事与行云渐远。",
        "罗衾旧香馀暖。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313566,
      "title": "丑奴儿・采桑子",
      "content": [
        "夜来酒醒清无梦，愁倚阑干。",
        "露滴轻寒。",
        "雨打芙蓉泪不干。",
        "佳人别后音尘悄，瘦尽难拼。",
        "明月无端。",
        "已过红楼十二间。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313567,
      "title": "谒金门",
      "content": [
        "溪声急。",
        "无数落花漂出。",
        "燕子分泥蜂酿蜜。",
        "迟迟艳风日。",
        "须信芳菲随失。",
        "况复佳期难必。",
        "拟把此情书万一。",
        "愁多翻阁笔。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313568,
      "title": "忆黄梅",
      "content": [
        "枝上叶儿未展。",
        "已有坠红千片。",
        "春意怎生防，怎不怨。",
        "被我安排，矮牙床斗帐，和娇艳。",
        "移在花丛里面。",
        "请君看。",
        "惹清香，偎媚暖。",
        "爱香爱暖金杯满。",
        "问春怎管。",
        "大家拼、便做东风，总吹交零乱。",
        "犹肯自、输我鸳鸯一半。"
      ],
      "author": {
        "id": 8647,
        "name": "王观"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313569,
      "title": "浪淘沙",
      "content": [
        "素手水晶盘。",
        "垒起仙丸。",
        "红绡剪碎却成团。",
        "逗得安排金粟遍，何似鸡冠。",
        "味胜玉浆寒。",
        "只被宜酸。",
        "莫将荔子一般看。",
        "色淡香消僝僽损，才到长安。"
      ],
      "author": {
        "id": 8647,
        "name": "王观"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313570,
      "title": "天香",
      "content": [
        "霜瓦鸳鸯，风帘翡翠，今年早是寒少。",
        "矮钉明窗，侧开朱户，断莫乱教人到。",
        "重阴未解，云共雪、商量不了。",
        "青帐垂毡要密，红炉收围宜小。",
        "呵梅弄妆试巧。",
        "绣罗衣、瑞云芝草。",
        "伴我语时同语，笑时同笑。",
        "已被金尊劝倒。",
        "又唱个新词故相恼。",
        "尽道穷冬，元来恁好。"
      ],
      "author": {
        "id": 8647,
        "name": "王观"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313571,
      "title": "卜算子",
      "content": [
        "水是眼波横，山是眉峰聚。",
        "欲问行人去那边，眉眼盈盈处。",
        "才始送春归，又送君归去。",
        "若到江东赶上春，千万和春住。"
      ],
      "author": {
        "id": 8647,
        "name": "王观"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313572,
      "title": "清平乐",
      "content": [
        "黄金殿里。",
        "烛影双龙戏。",
        "劝得官家真个醉。",
        "进酒犹呼万岁。",
        "折旋舞彻伊州。",
        "君恩与整搔头。",
        "一夜御前宣住，六宫多少人愁。"
      ],
      "author": {
        "id": 8647,
        "name": "王观"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313573,
      "title": "雨中花令",
      "content": [
        "百尺清泉声陆续。",
        "映潇洒、碧梧翠竹。",
        "面千步回廊，重重帘幕，小枕敧寒玉。",
        "试展鲛绡看画轴。",
        "见一片、潇湘凝绿。",
        "待玉漏穿花，银河垂地，月上栏干曲。"
      ],
      "author": {
        "id": 8647,
        "name": "王观"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313574,
      "title": "庆清朝慢・庆清朝",
      "content": [
        "调雨为酥，催冰做水，东君分付春还。",
        "何人便将轻暖，点破残寒。",
        "结伴踏青去好，平头鞋子小双鸾。",
        "烟郊外，望中秀色，如有无间。",
        "晴则个，阴则个，饾饤得天气，有许多般。",
        "须教镂花拨柳，争要先看。",
        "不道吴绫绣袜，香泥斜沁几行斑。",
        "东风巧，尽收翠绿，吹在眉山。"
      ],
      "author": {
        "id": 8647,
        "name": "王观"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313575,
      "title": "清平乐",
      "content": [
        "宜春小苑。",
        "处处花开满。",
        "学得红妆红要浅。",
        "催上金车要看。",
        "君王曲宴瑶池。",
        "小舟掠水如飞。",
        "夺得锦标归去，匆匆不惜罗衣。"
      ],
      "author": {
        "id": 8647,
        "name": "王观"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313576,
      "title": "木兰花令",
      "content": [
        "铜驼陌上新正后。",
        "第一风流除是柳。",
        "勾牵春事不如梅，断送离人强似酒。",
        "东君有意偏撋就。",
        "惯得腰肢真个瘦。",
        "阿谁道你不思量，因甚眉头长恁皱。"
      ],
      "author": {
        "id": 8647,
        "name": "王观"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313577,
      "title": "生查子",
      "content": [
        "关山魂梦长，塞雁音书少。",
        "两鬓可怜青，一夜相思老。",
        "归傍碧纱窗，说与人人道。",
        "真个别离难，不似相逢好。"
      ],
      "author": {
        "id": 8647,
        "name": "王观"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313578,
      "title": "菩萨蛮",
      "content": [
        "单于吹落山头月。",
        "漫漫江上沙如雪。",
        "谁唱缕金衣。",
        "水寒船舫稀。",
        "芦花枫叶浦。",
        "忆抱琵琶语。",
        "身未发长沙。",
        "梦魂先到家。"
      ],
      "author": {
        "id": 8647,
        "name": "王观"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313579,
      "title": "江城梅花引",
      "content": [
        "年年江上见寒梅。",
        "暗香来。",
        "为谁开。",
        "疑是月宫、仙子下瑶台。",
        "冷艳一枝春在手，故人远，相思寄与谁。",
        "怨极恨极嗅香蕊。",
        "念此情，家万里。",
        "暮霞散绮。",
        "楚天碧、片片轻飞。",
        "为我多情，特地点征衣。",
        "花易飘零人易老，正心碎，那堪塞管吹。"
      ],
      "author": {
        "id": 8647,
        "name": "王观"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313580,
      "title": "高阳台",
      "content": [
        "红入桃腮，青回柳眼，韶华已破三分。",
        "人不归来，空教草怨王孙。",
        "平明几点催花雨，梦半阑、敧枕初闻。",
        "问东君，因甚将春，老了闲人。",
        "东郊十里香尘满，旋安排玉勒，整顿雕轮。",
        "趁取芳时，共寻岛上红云。",
        "朱衣引马黄金带，算到头、总是虚名。",
        "莫闲愁，一半悲秋，一半伤春。"
      ],
      "author": {
        "id": 8647,
        "name": "王观"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313581,
      "title": "减字木兰花",
      "content": [
        "瑞云仙雾。",
        "拂晓重重遮绣户。",
        "一炷清香。",
        "千尺流霞入寿觞。",
        "家门转好。",
        "从此应须长不老。",
        "来岁春风。",
        "看拜西枢小令公。"
      ],
      "author": {
        "id": 8647,
        "name": "王观"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313582,
      "title": "红芍药",
      "content": [
        "人生百岁，七十稀少。",
        "更除十年孩童小。",
        "又十年昏老。",
        "都来五十载，一半被、睡魔分了。",
        "那二十五载之中，宁无些个烦恼。",
        "仔细思量，好追欢及早。",
        "遇酒追朋笑傲。",
        "任玉山摧倒。",
        "沈醉且沈醉，人生似、露垂芳草。",
        "幸新来、有酒如渑，结千秋歌笑。"
      ],
      "author": {
        "id": 8647,
        "name": "王观"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313583,
      "title": "失调名",
      "content": [
        "十三妮子绿窗中。"
      ],
      "author": {
        "id": 8647,
        "name": "王观"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313584,
      "title": "临江仙",
      "content": [
        "别岸相逢何草草，扁舟两岸垂杨。",
        "绣屏珠箔绮香囊。",
        "酒深歌拍缓，愁入翠眉长。",
        "燕子归来人去也，此时无奈昏黄。",
        "桃花应是我心肠。",
        "不禁微雨，流泪湿红妆。"
      ],
      "author": {
        "id": 8647,
        "name": "王观"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313585,
      "title": "万年欢",
      "content": [
        "雅出群芳。",
        "占春前信息，腊后风光。",
        "野岸邮亭，繁似万点轻霜。",
        "清浅溪流倒影，更黯淡、月色笼香。",
        "浑疑是、姑射冰姿，寿阳粉面初妆。",
        "多情对景易感，况淮天庾岭，迢递相望。",
        "愁听龙吟凄绝，画角悲凉。",
        "念昔因谁醉赏，向此际、空恼危肠。",
        "终须待结实，恁时佳味堪尝。"
      ],
      "author": {
        "id": 13500,
        "name": "王安礼"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313586,
      "title": "潇湘忆故人慢",
      "content": [
        "薰风微动，方樱桃弄色，萱草成窠。",
        "翠帏敞轻罗。",
        "试冰簟初展，几尺湘波。",
        "疏帘广厦，寄潇洒、一枕南柯。",
        "引多少、梦中归绪，洞庭雨棹烟蓑。",
        "惊回处，闲昼永，但时时，燕雏莺友相过。",
        "正绿影婆娑。",
        "况庭有幽花，池有新荷。",
        "青梅煮酒，幸随分、赢得高歌。",
        "功名事、到头终在，岁华忍负清和。"
      ],
      "author": {
        "id": 13500,
        "name": "王安礼"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313587,
      "title": "点绛唇",
      "content": [
        "春睡腾腾，觉来鸳被堆香暖。",
        "起来慵懒。",
        "触目情何限。",
        "深院日斜，人静花阴转。",
        "柔肠断。",
        "凭高不见。",
        "芳草连天远。"
      ],
      "author": {
        "id": 13500,
        "name": "王安礼"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313588,
      "title": "江神子・江城子",
      "content": [
        "七朝文物旧江山。",
        "水如天。",
        "莫凭栏。",
        "千古斜阳，无处问长安。",
        "更隔秦淮闻旧曲，秋已半，夜将阑。",
        "争教潘鬓不生斑。",
        "敛芳颜。",
        "抹么弦。",
        "须记琵琶，子细说因缘。",
        "待得鸾胶肠已断，重别日，是何年。"
      ],
      "author": {
        "id": 7459,
        "name": "张舜民"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313589,
      "title": "朝中措",
      "content": [
        "三湘迁客思悠哉。",
        "尊俎定常开。",
        "云雨未消歌伴，山川忍对离杯。",
        "他年来此，贤侯未去，忍话先回。",
        "好在江南山色，恁时重上高台。"
      ],
      "author": {
        "id": 7459,
        "name": "张舜民"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313590,
      "title": "卖花声",
      "content": [
        "木叶下君山。",
        "空水漫漫。",
        "十分斟酒敛芳颜。",
        "不是渭城西去客，休唱阳关。",
        "醉袖抚危栏。",
        "天淡云闲。",
        "何人此路得生还。",
        "回首夕阳红尽处，应是长安。"
      ],
      "author": {
        "id": 7459,
        "name": "张舜民"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313591,
      "title": "卖花声",
      "content": [
        "楼上久踟躇。",
        "地远身孤。",
        "拟将憔悴吊三闾。",
        "自是长安日下影，流落江湖。",
        "烂醉且消除。",
        "不醉何如。",
        "又看暝色满平芜。",
        "试问寒沙新到雁，应有来书。"
      ],
      "author": {
        "id": 7459,
        "name": "张舜民"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313592,
      "title": "江南好・忆江南",
      "content": [
        "江南客，家有宁馨儿。",
        "三世文章称大手，一门兄弟独良眉。",
        "借甚众多推。",
        "千里足，来自渥洼池。",
        "莫倚善题鹦鹉赋，青山须待健时归。",
        "不似傲当时。"
      ],
      "author": {
        "id": 36,
        "name": "曾布"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313593,
      "title": "水调歌头",
      "content": [
        "魏豪有冯燕，年少客幽并。",
        "击球斗鸡为戏，游侠久知名。",
        "因避仇、来东郡。",
        "元戎留属中军。",
        "直气凌貔虎，须臾叱咤风云。",
        "凛凛坐中生。",
        "偶乘佳兴。",
        "轻裘锦带，东风跃马，往来寻访幽胜。",
        "游冶出东城。",
        "堤上莺花撩乱，香车宝马纵横。",
        "草软平沙稳。",
        "高楼两岸春风，语笑隔帘声。"
      ],
      "author": {
        "id": 36,
        "name": "曾布"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313594,
      "title": "水调歌头",
      "content": [
        "袖笼鞭敲镫。",
        "无语独闲行。",
        "绿杨下、人初静。",
        "烟澹夕阳明。",
        "窈窕佳人，独立瑶阶，掷果潘郎，瞥见红颜横波盻，不胜娇软倚银屏。",
        "曳红裳，频推朱户，半开还掩，似欲倚、咿哑声里，细说深情。",
        "因遣林间青鸟，为言彼此心期，的的深相许，窃香解佩，绸缪相顾不胜情。"
      ],
      "author": {
        "id": 36,
        "name": "曾布"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313595,
      "title": "水调歌头",
      "content": [
        "说良人滑将张婴。",
        "从来嗜酒，还家镇长酩酊狂酲。",
        "屋上鸣鸠空斗，梁间客燕相惊。",
        "谁与花为主，兰房从此，朝云夕雨两牵萦。",
        "似游丝飘荡，随风无定。",
        "奈何岁华荏苒，欢计苦难凭。",
        "唯见新恩缱绻，连枝并翼，香闺日日为郎，谁知松萝托蔓，一比一毫轻。"
      ],
      "author": {
        "id": 36,
        "name": "曾布"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    }
