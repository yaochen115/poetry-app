{
  "data": [
    {
      "id": 176304,
      "title": "春猎",
      "content": [
        "小苑微寒春鴈飞，石关宫外草萋萋。",
        "汉家旌斾连围合，秦国山川入望低。",
        "花色才临珠缀发，柳阴欲傍金堤齐。",
        "韩嫣承恩来视兽，飞尘遥出建章西。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 176305,
      "title": "八月十五日夜寄友人",
      "content": [
        "故人音信绝，对月动相思。",
        "清露滴红叶，此怀当告谁。",
        "秋风广陵郭，正是望涛时。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 176306,
      "title": "戏下歌",
      "content": [
        "项王初破函关兵，气压山河风火明。",
        "旌旗金鼓四十万，夜泊鸿门期晓战。",
        "关东席卷五诸侯，沛公君臣相视愁。",
        "幸因项伯谢前过，进谒不敢须臾留。",
        "椎牛高会召诸将，宝剑泠泠舞席上。",
        "咸阳灰烬义帝迁，分裂九州如指掌。",
        "功高意满思东归，韩生受诛不复疑。",
        "区区蜀汉迁谪地，纵使倒戈何足为。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 176307,
      "title": "乌栖曲二首  其一",
      "content": [
        "风破金铺结绮钱，穿帘入幌舞垂莲。",
        "可怜无人夜不晓，起视西窗月华皎。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 176308,
      "title": "乌栖曲二首  其二",
      "content": [
        "星疏月明漏水长，罗帷翠帐华灯光。",
        "佳人起舞玉钗堕，门外乌栖鴈南过。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 176309,
      "title": "海仙歌",
      "content": [
        "东望海波苍茫浩渺无所极，高浪洪涛黯风色。",
        "翻星倒汉天地黑，阴灵出没互相索。",
        "东方曈昽景气清，庆云合沓吐赤精，蓬莱瀛洲杳如萍。",
        "遥观五楼十二城，群仙剑佩朝玉京。",
        "祥风缥渺钧天声，彩幢翠盖烟霞生。",
        "鸾歌鳯舞入帝乡，紫麟徐驱白鹤翔。",
        "餐芝茹术饮玉浆，千年万年乐未央。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 176310,
      "title": "宫漏谣",
      "content": [
        "宫漏清高处处闻，六街寂寂夜将分。",
        "南下河梁缅诘曲，北瞻禁阙鬰缤纷。",
        "黄金锁闭斗城斜，白玉楼通上帝家。",
        "若木未光潜日月，神仙不动积烟霞。",
        "铜壶银箭夜何长，杳杳亭亭未遽央。",
        "复道回廊接西掖，千门万户遥相当。",
        "宛转徘徊不能驻，复出宫城透宫树。",
        "宫树乌飞月欲西，烛光一道照沙堤。",
        "龙骑联翩排阊阖，鳯帷岑寂对狻猊。",
        "广庭肃肃延冠带，剑佩峥嵘百神会。",
        "施政发令四海春，庙堂垂衣天宇泰。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 176311,
      "title": "华州祗役往冯翊留别楚正叔",
      "content": [
        "芳菲不得驻，会取余春还。",
        "欲知回首处，渭曲苍茫间。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 176312,
      "title": "孟尝君歌",
      "content": [
        "君不见薛公在齐当路时，三千豪士相追随。",
        "邑封万户无自入，椎牛酾酒不为赀。",
        "门下纷纷如市人，鸡鸣狗盗亦同尘。",
        "一朝失势宾客落，唯有冯驩西入秦。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 176313,
      "title": "缑山引",
      "content": [
        "王子吹笙去不还，当时旧物唯缑山。",
        "山深树老藏遗庙，春月秋风空自闲。",
        "轘辕左界连商雒，碧瓦朱栏露华薄。",
        "经时掩户庭草深，永昼无人涧花落。",
        "徘徊未下日将西，遥望嵩阳烟景微。",
        "鹤驭飘飖向何许，林间空见白云飞。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 176314,
      "title": "洛阳少年行",
      "content": [
        "铜驼陌上桃花红，洛阳无处无春风。",
        "青丝尾结连钱骢，相从射猎北邙东。",
        "流鞭纵镝未云毕，青山团团载红日。",
        "云分电散无影迹，黄鸡未鸣已复出。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 176315,
      "title": "将军行",
      "content": [
        "赤光满面唇激朱，虬须虎颡三十余。",
        "腰垂金印结紫绶，诸将不敢过庭除。",
        "羽林精卒二十万，注听钲鼓观麾旟。",
        "肥牛百头酒万石，烂漫一日供欢娱。",
        "自言不喜读兵法，智略何必求孙吴。",
        "贺兰山前烽火满，谁令小虏骄慢延须臾。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 176316,
      "title": "何秀才郊园五首  其一",
      "content": [
        "主人耽诗书，乐道深居久。",
        "挟策往来游，东冈复南亩。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 176317,
      "title": "何秀才郊园五首  其二",
      "content": [
        "浊酒不取味，素琴无复弦。",
        "何须更清论，相见自萧然。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 176318,
      "title": "何秀才郊园五首  其三",
      "content": [
        "苍苍竹林暝，鬰欝松气寒。",
        "纵横兴来笔，欹侧醉中冠。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 176319,
      "title": "何秀才郊园五首  其四",
      "content": [
        "褰裳涉幽涧，日落烟岩空。",
        "踌躇待新月，长啸来清风。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 176320,
      "title": "何秀才郊园五首  其五",
      "content": [
        "夏木绕茅庐，棋酒资清宴。",
        "密叶绿藏枝，空闻黄鸟啭。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 176321,
      "title": "夏日过陈秀才园林",
      "content": [
        "桑荫青青紫葚垂，鲜风荡麦生涟漪。",
        "驱童策马踏村路，乘兴出游当访谁。",
        "槿花篱落围丛竹，风日萧疏满园绿。",
        "到门下马问主人，文籍先生其姓陈。",
        "高谈浩浩究今古，不觉林间日将暮。",
        "茅庐蒿径幸不遥，不厌频烦数来去。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 176322,
      "title": "陪同年吴冲卿登宿州北楼望梁楚之郊访古建中作是诗",
      "content": [
        "大禹息洪潦，画野经九州。",
        "波沈露群山，嶷嶷相婴钩。",
        "漩洄澹兹土，平敞诚寡仇。",
        "乘高极回望，坦坦无陵丘。",
        "先王崇皡济，建祀邦诸侯。",
        "玉帛从会同，赴告书春秋。",
        "六雄方逐鹿，为嬴弱姬周。",
        "兹为会战场，蹀血无时休。",
        "汉错削七国，祸生东南陬。",
        "亚夫闭高壁，坐折彊吴谋。",
        "典午倒太阿，辟户延旃裘。",
        "淮泗漫腥膻，房心掩旄头。",
        "人移烟火绝，榛茂豺狼游。",
        "唐纲日寖衰，盗起如螟蟊。",
        "相携聚萑蒲，袒臂提鉏耰。",
        "蟠薄数千里，焚劫无余留。",
        "圣朝定多垒，剑戟包貔貅。",
        "蓁蓁荆棘林，膴膴良田畴。",
        "耒耜趣时雨，黍稷丰岁秋。",
        "昔为车骑利，今睹桑麻收。",
        "我来宦东土，莨菪乘春流。",
        "行行次符离，固为亲交留。",
        "樽罍且为乐，携手登高楼。",
        "是时新雨余，风日方和柔。",
        "云鲜乱花薄，波绿迷芳洲。",
        "羃羃游丝转，衮衮野阳浮。",
        "调篁语双鹂，飜雪矫群鸥。",
        "爱兹登临美，况复依良俦。",
        "聊适笑言乐，尽忘羁旅忧。",
        "翔阳何冉冉，渐与西山遒。",
        "驿程前有期，恋此当何由。",
        "分首下岧嶤，怅然登暮舟。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 176323,
      "title": "燕台歌",
      "content": [
        "万古苍茫空盛衰，燕台贤客姓名谁。",
        "君看碣石岩中草，宁似昭王拥篲时。",
        "黄金散尽余基没，易水萧条烽火飞。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 176324,
      "title": "楚宫行",
      "content": [
        "楚王宫中夜未央，清歌秘舞会华堂。",
        "木兰为柱桂为梁，随珠和璧烂同光。",
        "横吹乍鸣秋竹裂，繁弦初度春雨歇。",
        "九微火树垂垂灭，罗衣纷纷玉缨绝。",
        "满朝冠剑东方明，宫门未启君朝醒。",
        "秦关日夜出奇兵，武安君火照夷陵。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 176325,
      "title": "塞上",
      "content": [
        "胡兵欲下阴山，寒烽远过萧关。",
        "将军贵轻士卒，几人回首生还。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 176326,
      "title": "柳枝词十三首  其一",
      "content": [
        "烟满上林春未归，三三两两雪花飞。",
        "柳条别得东皇意，映堤拂水已依依。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 176327,
      "title": "柳枝词十三首  其二",
      "content": [
        "依依高树出宫墙，摇曳青丝百尺长。",
        "愿与宣温万年树，年年岁岁奉君王。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 176328,
      "title": "柳枝词十三首  其三",
      "content": [
        "君王游豫赏青春，折柳为弮赐侍臣。",
        "莫怪长条低拂地，只缘供扫属车尘。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 176329,
      "title": "柳枝词十三首  其四",
      "content": [
        "属车隐隐远如雷，陈后愁眉久不开。",
        "杨花都不知人意，故入长门宫里来。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 176330,
      "title": "柳枝词十三首  其五",
      "content": [
        "长门宫晓未成粧，结雨萦风蔽琐窗。",
        "莫令透入华梁鷰，那堪负汝更双双。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 176331,
      "title": "柳枝词十三首  其六",
      "content": [
        "双双春鷰飏云霄，楚国宫深乐事饶。",
        "会待急管繁弦际，试取纤条并舞腰。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 176332,
      "title": "柳枝词十三首  其七",
      "content": [
        "舞腰缤纷长乐东，柳间怅饮送春风。",
        "请君试望邯郸道，青门袅袅彻新丰。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 176333,
      "title": "柳枝词十三首  其八",
      "content": [
        "新丰道上灞陵头，又送夫君去远游。",
        "借问柳枝能寄否，古今共有几多愁。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 176334,
      "title": "柳枝词十三首  其九",
      "content": [
        "多愁尤是别离深，折条相赠各沾襟。",
        "留住不住居人意，欲去未去行人心。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 176335,
      "title": "柳枝词十三首  其一○",
      "content": [
        "行人白马去遥遥，初上金堤欲过桥。",
        "望尘不见遮人眼，苦怨无情万万条。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 176336,
      "title": "柳枝词十三首  其一一",
      "content": [
        "五柳先生门乍开，宅边植杖久徘徊。",
        "陌头遥认颜光禄，诘旦先乘瘦马来。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 176337,
      "title": "柳枝词十三首  其一二",
      "content": [
        "白雪虽然比絮花，艶阳不得共繁华。",
        "为君故入乌衣巷，飞舞风流谢傅家。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 176338,
      "title": "柳枝词十三首  其一三",
      "content": [
        "宣阳门前三月初，家家杨柳绿藏乌。",
        "欢似白花飘荡去，忍能弃掷博山炉。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 176339,
      "title": "奉和经略庞龙图延州南城八咏 迎薫亭",
      "content": [
        "华馆压清波，坐待南风至。",
        "须知明牧贤，善达吾君意。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 176340,
      "title": "奉和经略庞龙图延州南城八咏 供兵硙",
      "content": [
        "晨暮响寒泉，飞轮驶风转。",
        "士饱气益振，轻与先零战。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 176341,
      "title": "奉和经略庞龙图延州南城八咏 柳湖",
      "content": [
        "依依烟未歇，漠漠风初静。",
        "浮花满波面，不见参差影。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 176342,
      "title": "奉和经略庞龙图延州南城八咏 飞盖园",
      "content": [
        "军中富余暇，飞盖南城隈。",
        "雍容陪后乘，一一应刘才。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 176343,
      "title": "奉和经略庞龙图延州南城八咏 翠漪亭",
      "content": [
        "雕簷日华动，滉瀁照漪涟。",
        "四月芰荷满，不似在穷边。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 176344,
      "title": "奉和经略庞龙图延州南城八咏 延利渠",
      "content": [
        "枝分清浅流，纵横贯城市。",
        "还如恩在人，润泽无终既。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 176345,
      "title": "奉和经略庞龙图延州南城八咏 缘云轩",
      "content": [
        "逼汉敞高岩，缘云结飞阁。",
        "东山草树曛，致足登临乐。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 176346,
      "title": "奉和经略庞龙图延州南城八咏 禊堂",
      "content": [
        "箫鼓震阳休组练，照芳洲意气坐中。",
        "客羞笑山阴游河，上督役怀噐之寄。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 176347,
      "title": "天马歌",
      "content": [
        "大宛汗血古共知，青海龙种骨更奇。",
        "网丝旧画昔尝见，不意人间今见之。",
        "银鞍玉镫黄金辔，广路长鸣增意气。",
        "富平公子韩王孙，求买倾家不知贵。",
        "芙蓉高阙北向开，金印紫绶从天来。",
        "路人回首无所见，流风瞥过惊浮埃。",
        "如何弃置归皂栈，踠足垂头困羁绊。",
        "精神惨澹筋骨羸，举目双睛犹璀璨。",
        "伏波马式今已无，子阿肉腐骨久枯。",
        "举世无人相骐骥，憔悴不与驽骀殊。",
        "神兵淬砺精芒在，宝鉴游尘肯终晦。",
        "君今鬋剔被鸣鸾，尚能腾踏昆仑外。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 176348,
      "title": "河上督役怀器之寄呈公明叔度时器之鞫狱沧州",
      "content": [
        "河灾泛东郡，庐井多堙沦。",
        "题舆得贤佐，姁妪安疲民。",
        "遂令枯槁余，稍复苏阳春。",
        "伊人屏外饰，倜傥穷天真。",
        "徒观浩荡波，莫测江海津。",
        "矧兹同府士，一一随和珍。",
        "公明抱全德，洞澈无缁磷。",
        "叔度秉峻节，竦若凌霜筠。",
        "顾兹不肖材，亦齿幕中宾。",
        "同依松柏阴，共醉醍醐醇。",
        "高论探要妙，佳句裁清新。",
        "有诗纵欢谑，杯案霑衣巾。",
        "曾无礼节间，但以风期亲。",
        "北州有疑狱，两造正纷纶。",
        "当须于公断，然后无冤人。",
        "送行出郊岐，扬鞭从此违。",
        "堤繇春事起，行役未成归。",
        "索居如几日，河草已芳菲。",
        "徒然掩瑶瑟，坐叹知音稀。",
        "昨夜西南风，梦中东北飞。",
        "行行涉沧海，仿佛睹容晖。",
        "寤思益惆怅，天长羽翼微。",
        "离怀如柳色，极目正依依。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 176349,
      "title": "华星篇",
      "content": [
        "凉风净扫云无迹，海月未生星历历。",
        "贝联珠贯拱北辰，三五纵横此何夕。",
        "重楼叠榭出秋空，𫛛鹊露寒连桂宫。",
        "瑶井迥临丹阙外，玉绳斜挂琐窗中。",
        "征人远别空闺悄，钟漏萧疏天不晓。",
        "碧纱展转无复眠，卧视寒光度华沼。",
        "汉家贤将戍临洮，结髪从军今二毛。",
        "谁怜身老心犹壮，深入长占太白高。",
        "丰城古剑沉沦久，匣中夜半双龙吼。",
        "乃知神物不自藏，紫气依稀见牛斗。",
        "有客离居望所亲，遥知清夜会荀陈。",
        "堤繇未息无由去，不及浮槎河畔人。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 176350,
      "title": "宿石堰闻牧马者歌",
      "content": [
        "大河之曲多寛闲，牧田枕倚长堤湾。",
        "乌栖鹊散堤树寂，柝木声稀宵欲阑。",
        "牧儿跨马乘凉月，历历绕群高唱发。",
        "幽情逸气生自然，往往鸣鞘应疏节。",
        "歌辞难辨野风高，似述离忧嗟役劳。",
        "徘徊不断何妨近，仿佛微闻已复遥。",
        "长川冷浸秋云白，露草飜光凝碧色。",
        "星疏河淡夜初长，展转空亭奈孤客。",
        "洞箫音律京君明，可怜骨朽不更生。",
        "安得使传哀怨意，为我写之羌笛声。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 176351,
      "title": "杨白华",
      "content": [
        "劝君勿嫌杨花太轻薄，篱下沟中纷漠漠。",
        "翠鬟婢子不胜愁，扫尽还飞满朱阁。",
        "晚来风雨送行春，天无游丝地无尘。",
        "雪狂絮乱安可得，孤树青青愁杀人。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 176352,
      "title": "都下秋怀呈聂之美",
      "content": [
        "愚疏强从仕，趣尚与时乖。",
        "朅来游京邑，荣愿知谁谐。",
        "王国富英奇，气象标岩崖。",
        "云鸿送双目，攀援路可阶。",
        "秋风转枯叶，飒飒绕寒斋。",
        "岀门无所之，飞尘满天街。",
        "夫君宦未达，犹得称吾侪。",
        "解衣换斗酒，且尽平生怀。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 176353,
      "title": "陪张龙图南湖暑饮  其一",
      "content": [
        "红斾萦林却转，琼筵就水重开。",
        "荷香著衣不去，竹色映酒遥来。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 176354,
      "title": "陪张龙图南湖暑饮  其二",
      "content": [
        "楼船潋灔轻浪，鸥鹭缤纷满天。",
        "清歌久之未度，画梁尘落芳筵。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 176355,
      "title": "道傍田家",
      "content": [
        "道傍田家翁妪俱垂白，败屋萧条无壮息。",
        "翁携镰索妪携箕，自向薄田收黍稷。",
        "静夜偷舂避债家，比明门外已如麻。",
        "筋疲力敝不入腹，未议县官租税足。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 176356,
      "title": "送李汝臣同年谪官导江主簿",
      "content": [
        "得丧互循环，古今昧终始。",
        "百歳落其间，仅与毫芒似。",
        "所以达人心，身外不复纪。",
        "愁来若乱丝，疏解当以理。",
        "昔君关外来，籍籍声华起。",
        "凭案一濡毫，万言俱落纸。",
        "老生闚其文，色若寒灰死。",
        "阁笔不能下，敢有玼瑕指。",
        "或时抵卿相，入门俱倒屣。",
        "阍夫迎受谒，不敢扬眸视。",
        "解褐吏边州，长涂初进跬。",
        "蛟龙得尺水，双骼方嶷嶷。",
        "西羌负德泽，飞镝耸边鄙。",
        "添兵十万余，斗粟无支拟。",
        "州郡走符檄，纵横恣鞭箠。",
        "闾阎浪愁苦，卒食半糠粃。",
        "上官知君才，悉以储粮委。",
        "开仓募平籴，至者车连轨。",
        "严明束吏手，诱谕提民耳。",
        "留谷受金去，若与同侪市。",
        "弦朔未云周，露积丘山比。",
        "曾无转饷劳，坐饱防秋士。",
        "幕府上其功，明诏深嘉美。",
        "为僚登九寺，长人专百里。",
        "聊用报勤劬，未言穷任使。",
        "何期逢怨雠，意外成疮痏。",
        "刺骨舞文法，吹毛出瑕滓。",
        "清霜五月飞，惨烈伤兰芷。",
        "鸾鳯失椅梧，飘泊还荆枳。",
        "圣朝方任能，大过尚收齿。",
        "况于济时具，𫏐然遭诋訾。",
        "宁因青蝇恶，遂取玙璠毁。",
        "良工构明堂，必不遗杞梓。",
        "勉哉益自立，勿为穷衰止。",
        "人生难豫期，神理无终否。",
        "庸知今日忧，不为后日喜。",
        "吾道诚无亏，𡒄坎安足耻。",
        "关山迤逦长，百剑连天倚。",
        "萦纡结危栈，迥入云星里。",
        "蜀国富嬉游，花繁春酒旨。",
        "莫作吊原文，投之岷江水。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 176357,
      "title": "春日书寄东郡诸同舍",
      "content": [
        "滑台古镇掲高牙，主人贤厚宾友嘉。",
        "公庭退休射堂饮，水沈绿李浮甘瓜。",
        "清言妙谕间诙谑，笑语往反何喧哗。",
        "别来泛滥若浮梗，尘愁俗累稠于麻。",
        "提鞭俄盖触风日，惨涩满眼飞埃沙。",
        "朱门湛湛果深浅，门外日拥千余车。",
        "阍人未肯即通刺，指弹手版景欲斜。",
        "就令入见亦何事，气象渺邈凌青霞。",
        "围棋角智赌胜负，拙者理与功名賖。",
        "舍之归入户庭隘，仰视青天如井蛙。",
        "后檐数尺地荒秽，不翦欲令生荠花。",
        "当春寂寂但如此，意恐至外逢纷华。",
        "奈何胜友百余里，不可一见如天涯。",
        "何时更共把巵酒，侧身北望空咨嗟。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 176358,
      "title": "和邵不疑校理蒲州十诗 饮亭",
      "content": [
        "飞盖名僚集，临流芳宴开。",
        "萦纡漱文石，次第传清杯。",
        "回波亦多意，并泛落花来。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 176359,
      "title": "和邵不疑校理蒲州十诗 涌泉石",
      "content": [
        "苍然片石寒，百道飞泉吐。",
        "高堂忽萧飒，坐失炎蒸苦。",
        "蛟龙卧欲飞，仰噀秋空雨。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 176360,
      "title": "和邵不疑校理蒲州十诗 翠楼",
      "content": [
        "条山翠气横，隐嶙秋空窄。",
        "危楼雨初度，卷幌延佳色。",
        "扑扑满前轩，岚光真可摘。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 176361,
      "title": "和邵不疑校理蒲州十诗 碧楼",
      "content": [
        "烟瓦叠琉璃，危楼半空倚。",
        "歌钟奉高宴，声来碧云里。",
        "日暮天四垂，黯澹如秋水。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 176362,
      "title": "和邵不疑校理蒲州十诗 静斋",
      "content": [
        "□□□□□，□□□□□。",
        "聊窥碧甃缺，寒草生历历。",
        "时闻山鸟呼，未得全幽寂。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 176363,
      "title": "和邵不疑校理蒲州十诗 槐轩",
      "content": [
        "□□轩已幽，况复植宫槐。",
        "簷外阴沉绿，南山雨气来。",
        "逍遥不知久，惊此黄花开。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 176364,
      "title": "和邵不疑校理蒲州十诗 凉□",
      "content": [
        "□□□□□，□□□□□。",
        "清风满四境，岂独华榱下。",
        "不若楚台人，披襟独萧洒。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 176365,
      "title": "和邵不疑校理蒲州十诗 芙蕖轩",
      "content": [
        "荷花烂漫红，不见方塘水。",
        "嶣嶤结飞阁，苒惹清香里。",
        "露重忽欹侧，翩然翠禽起。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 176366,
      "title": "和邵不疑校理蒲州十诗 惜花亭",
      "content": [
        "春意复蹉蛇，园林日愁寂。",
        "枝边绿阴重，砌下红英积。",
        "兹亭花最繁，飘零尤可惜。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 176367,
      "title": "和邵不疑校理蒲州十诗 竹轩",
      "content": [
        "茂密正当轩，欹垂欲侵案。",
        "风枝忽交戛，月影争凌乱。",
        "诚嘉君子心，匪直林亭玩。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 176368,
      "title": "秋日寄山中友人",
      "content": [
        "昨夜听秋风，霜崖几树红。",
        "心随新鴈去，宛至碧谿东。",
        "圣主搜渔钓，林岩今已空。",
        "胡为执高节，憔悴久山中。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176369,
      "title": "和之美舟行杂诗八首 舟中夜坐 其一",
      "content": [
        "风柳动萧疏，寒星浸寥落。",
        "中宵四寂然，时有游鱼跃。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 176370,
      "title": "和之美舟行杂诗八首 舟中夜坐 其二",
      "content": [
        "汀沙落席帆，岸柳萦单舸。",
        "小市远微茫，簇水初灯火。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 176371,
      "title": "和之美舟行杂诗八首 船行遇风",
      "content": [
        "蔡水仅成波，不若江湖濬。",
        "诚无倾侧忧，缆弱终难进。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 176372,
      "title": "和之美舟行杂诗八首 野花",
      "content": [
        "喧喧桃李蹊，何妨笑幽草。",
        "但愿保天真，徐共春风老。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 176373,
      "title": "和之美舟行杂诗八首 水鸭",
      "content": [
        "褵𫄳出短蒲，毰毸浴清水。",
        "物忌太鲜明，何妨染泥滓。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 176374,
      "title": "和之美舟行杂诗八首 鱼鹰",
      "content": [
        "翩然下林表，不惮风湍恶。",
        "得隽辄高飞，为君羞击搏。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 176375,
      "title": "和之美舟行杂诗八首 罾鱼者",
      "content": [
        "弱筿絓轻丝，尽日寒溪侧。",
        "获少近知无，溪鱼皆尔识。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 176376,
      "title": "和之美舟行杂诗八首 都门路",
      "content": [
        "红尘昼夜飞，车马古今迹。",
        "独怜道傍柳，惨淡少颜色。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 176377,
      "title": "吴冲卿直舍阎士安画墨竹歌",
      "content": [
        "阎生画竹旧所闻，望中一见遥可分。",
        "伊予不甚少佳画，犹爱气骨高出群。",
        "狂枝怒叶凌绢素，势若飞动争纷纭。",
        "蟠根数节出地底，上有积年苍藓纹。",
        "森然直干忽孤耸，意恐出屋排浮云。",
        "秋风飒飒生左右，耳目洒落遗尘氛。",
        "乃知良工自神解，昧者倣习徒艰勤。",
        "子猷昔者得收玩，不患终朝无此君。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 176378,
      "title": "和之美河洲四诗  其一",
      "content": [
        "冉冉河洲晓，晴霞登木杪。",
        "稍见水烟开，孤舟天际小。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 176379,
      "title": "和之美河洲四诗  其二",
      "content": [
        "杳杳河洲晚，客行殊未返。",
        "目随林鸟还，心共征鸿远。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 176380,
      "title": "和之美河洲四诗  其三",
      "content": [
        "寂寂河洲夜，芦花绕墟舍。",
        "孤客久未眠，窗灯落寒灺。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 176381,
      "title": "和之美河洲四诗  其四",
      "content": [
        "漠漠河洲雨，依稀辨村聚。",
        "时哉鸥鸟群，凌乱争鸣舞。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 176382,
      "title": "又和夜雨宿村舍",
      "content": [
        "积雨久未阕，岂徒行客忧。",
        "夜闻屋中人，叹息悲田畴。",
        "方春播殖时，种食皆外求。",
        "鞭诃犯赤日，酷烈惭羸牛。",
        "草薉竞禾长，从人借鉏耰。",
        "晨薅戴星起，日暗未能休。",
        "岂无一时勤，所觊歳有秋。",
        "今兹昏垫灾，大埜成洪流。",
        "直疑沧海溢，茧栗浮陵丘。",
        "昔时百丈原，泛泛皆挐舟。",
        "乔木失端杪，饥鸟下无投。",
        "黍稷沉黄泥，圭合安可收。",
        "嗟予乏技能，无以易糠麰。",
        "贩鬻固所昧，敢托市井游。",
        "欲依盗贼群，懦不闲戈矛。",
        "已哉任天地，无益徒为愁。",
        "一身无死所，况为妻儿谋。",
        "之美爱物者，凄然涕霑裘。",
        "一夫有不获，伊尹为深羞。",
        "何当富斯民，比屋囷仓稠。",
        "惜哉禄秩卑，此志终宜酬。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 176383,
      "title": "送伊阙王大夫歌",
      "content": [
        "于嗟古之道邈既远兮，日陵夷而就衰。",
        "群儒角逐异端竞进兮，圣涂榛枳幽昧而难知。",
        "君独耻从众人之后兮，轩然高举远取而穷追。",
        "拨去虹蜺汛扫氛浊兮，廓然廼得睹夫朝曦。",
        "授邑于雒之南兮，始者既学今得而施。",
        "归风俗于醇厚兮，又何西门卓鲁之足为。",
        "消奸化桀折牙杜蘖兮，寂不知其所之。",
        "何者为令之德兮，黄童皓首接手而游嬉。",
        "菽粟露积牛羊被野兮，百里独比于太古之时。",
        "予愿解冠弃佩兮，受一廛于伊之野。",
        "蓑身笠首兮，同邑民以熙熙。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 176384,
      "title": "送韩太祝归许昌",
      "content": [
        "王城名利窟，冠盖鬰相交。",
        "夫君独鳯举，彯然去喧呶。",
        "颍水清可濯，箕山高可巢。",
        "反顾公相荣，一芥浮堂坳。",
        "□□大吕重，岂知轻斗筲。",
        "苍苍气象严，万木拥寒郊。",
        "□□点隈曲，初旭染林梢。",
        "去去善自将，因声访衡茅。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 176385,
      "title": "和兴宗夜直听雨",
      "content": [
        "□茫冻雨来，入夜势增急。",
        "纵横挟春风，飘洒相喷吸。",
        "败窗端见欺，遽有万点入。",
        "先生伏经编，眼冷倍昏涩。",
        "夜分童仆倦，跛倚厌久立。",
        "灯火为溟蒙，诗书亦霑湿。",
        "夫君储善价，未售不悁悒。",
        "物华迎霁新，佳赏时将及。",
        "囷中秫几何，营酿须汲汲。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 176386,
      "title": "和之美讽古  其一",
      "content": [
        "曲逆从汉祖，出奇谁与让。",
        "一朝寄天下，不及王陵戆。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 176387,
      "title": "和之美讽古  其二",
      "content": [
        "海客久藏机，鸥知人未知。",
        "如何毫末利，管鲍亦相欺。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 176388,
      "title": "和之美二贫诗",
      "content": [
        "君子尚仁义，宝用为身资。",
        "其人苟不贤，富饶亦胡为。",
        "所以回宪徒，不厌糠与藜。",
        "当时万金产，令名传者谁。",
        "之美初解褐，为吏长河湄。",
        "月得数斗禄，仅足供𫗴糜。",
        "谓言家无宝，不必修藩篱。",
        "囊衣不自暖，乃为偷意窥。",
        "穿墉入其室，探取无纤遗。",
        "从事借之带，同列乞其衣。",
        "日高服未具，不敢逾门畿。",
        "萧条四壁寒，独立空自嗤。",
        "援毫引幅纸，书作二贫诗。",
        "上言运命邅，温饫无时期。",
        "下嗟职事劳，旧学日以隳。",
        "乃知贤者心，不独忧寒饥。",
        "𡒄坎虽益多，志业终无衰。",
        "我实甚贫者，视君犹白圭。",
        "行年三十余，碌碌无佗奇。",
        "庇身太学官，旦夕唯盐虀。",
        "读君二贫作，我事借君词。",
        "君诚士林秀，不免青衫卑。",
        "满腹岂无才，抱蓄未有施。",
        "不用固为小，用之活蒸黎。",
        "如君有此富，岂必藏珠玑。",
        "财贫非道贫，已矣何嗟咨。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 176389,
      "title": "送薯预苗与兴宗",
      "content": [
        "客从魏都来，贻我山𫉄实。",
        "散之膏土间，春苗比如栉。",
        "吾家庭户狭，树艺苦其密。",
        "危根递扶戴，怒牙犹拂欝。",
        "兴言念伊人，好嗜与我一。",
        "家蓄桐君书，喜观泛氏述。",
        "虽为簪带拘，雅尚林樊逸。",
        "分献取其诚，岂容羞薄物。",
        "况闻知药者，饵此等苓术。",
        "愿益君子年，康直体无疾。",
        "散诞得寛壤，繁大宜无日。",
        "萧梢新蔓抽，苯莼故丛失。",
        "入冬霜霰严，叶落掊可出。",
        "伸如猿臂长，拳若熊膰腯。",
        "拾木爨铜鼎，相期聚书室。",
        "谁得与其徒，谿茶与山栗。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 176390,
      "title": "答昌言求薯蓣苗",
      "content": [
        "冬实散肥壤，春苗动新叶。",
        "雅意非遗人，野情聊自惬。",
        "何言好事者，求访来相叠。",
        "会种十亩余，坐取诗盈箧。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176391,
      "title": "送冷金牋与兴宗",
      "content": [
        "蜀山瘦碧玉，蜀土膏黄金。",
        "寒谿漱其间，演漾清且深。",
        "工人剪穉麻，捣之白石砧。",
        "就溪沤为纸，莹若裁璆琳。",
        "风日常清和，小无尘滓侵。",
        "时逐贾舟来，万里巴江浔。",
        "王城压汴流，英俊萃如林。",
        "雄文溢箱箧，争买倾奇琛。",
        "夫君乃冠冕，辞气高千寻。",
        "十载为举首，于今犹陆沉。",
        "嗟我蓄此纸，才藻不足任。",
        "愿以写君诗，益为人所钦。",
        "缟带岂多物，足明同好心。",
        "黄钟声如雷，岂病无知音。",
        "请以此为质，佗年神所临。",
        "华轩策驷马，慎勿忘遗簪。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 176392,
      "title": "谢兴宗惠草虫扇",
      "content": [
        "吴僧画团扇，点缀成微虫。",
        "秋毫宛皆具，独窃天地功。",
        "细者及蛛蝥，大者才阜螽。",
        "枯枝拥寒蜩，黄蘃粘飞蜂。",
        "翾然得生意，上下相追从。",
        "徒观飞动姿，莫睹笔墨踪。",
        "儿曹取真物，细校无不同。",
        "恐其遂跃去，亟取藏箱中。",
        "乃知艺无小，意精神可通。",
        "不与误图蝇，能惑紫髯翁。",
        "子猷状蝉雀，藏宝传江东。",
        "不知古何如，此画今为雄。",
        "人墓木已拱，其徒颇能工。",
        "旧法存百一，要足超凡庸。",
        "友人幸为赐，物薄意何隆。",
        "玩之不替手，爱重心无穷。",
        "常如对君子，穆穆来清风。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 176393,
      "title": "和昌言官舍十题 石榴花",
      "content": [
        "灵根逐汉臣，远自河源至。",
        "流离徧中壤，今兹尽苗裔。",
        "畏日助殷红，冻雨涤浓翠。",
        "宜携避暑客，花下纵横醉。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176394,
      "title": "和昌言官舍十题 薏苡",
      "content": [
        "佳实产南州，流传却山瘴。",
        "如何马伏波，坐取丘山谤。",
        "夫君道义白，复为神明相。",
        "厉气与流言，安能逞无状。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176395,
      "title": "和昌言官舍十题 石兰",
      "content": [
        "楚人歌紫兰，华禁无传久。",
        "循名意兹是，谁得明真否。",
        "天怜菊性孤，秀发秋风后。",
        "固令芳物生，聊作黄花友。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176396,
      "title": "和昌言官舍十题 萱草",
      "content": [
        "叶濯宿露翠，花迎朝日黄。",
        "昔谁封殖此，俨列侍高堂。",
        "达士隐于吏，孰为行与藏。",
        "逍遥玩永日，自无忧可忘。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176397,
      "title": "和昌言官舍十题 蜀葵",
      "content": [
        "白若缯初断，红如颜欲酡。",
        "坐疑仙驾严，幢节纷骈罗。",
        "物性有常妍，人情轻所多。",
        "菖蒲傥日秀，弃掷不吾过。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176398,
      "title": "和昌言官舍十题 畦蔬",
      "content": [
        "隙土惜荒弃，翦治成春畦。",
        "讲雩时泽洽，葵荏高参差。",
        "酾渠若贯脉，疏塍如画棋。",
        "为吾谢来客，桔橰毋语机。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176399,
      "title": "和昌言官舍十题 水红",
      "content": [
        "梦想水乡游，阶庭植笼古。",
        "宛如江外行，高帆落寒浦。",
        "烟枝静疏秀，风穗闲低举。",
        "于今看未好，漠漠宜秋雨。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176400,
      "title": "和昌言官舍十题 甘菊",
      "content": [
        "野菊细琐物，篱间私自全。",
        "徒因气味殊，不为庖人捐。",
        "采升白玉堂，荐以黄金盘。",
        "愿若南阳守，永扶君子年。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176401,
      "title": "和昌言官舍十题 兰",
      "content": [
        "贤者非无心，园夫自临课。",
        "蓻植日繁滋，芬芳时入座。",
        "青葱春茹擢，皎洁秋英堕。",
        "正苦郢中人，逸唱高难和。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176402,
      "title": "和昌言官舍十题 病竹",
      "content": [
        "园竹久不治，芜没真可吊。",
        "岂无枯槁容，萧疏自殊调。",
        "至人爱高节，命斧除藜藋。",
        "何用报至恩，清阴与长啸。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 176403,
      "title": "送文慧师归眉山",
      "content": [
        "至人心如云，去住唯所适。",
        "飘飖涉四海，岂复校喧寂。",
        "朅来王城游，红尘暧晨夕。",
        "忽思还故峰，不可留宿昔。",
        "离合皆自然，于何寄驩戚。",
        "从兹坐林下，白首傲泉石。",
        "山鸟集掌中，巴猿侍瓶锡。",
        "寺前烟蔓深，何处求行迹。"
      ],
      "author": {
        "id": 7230,
        "name": "司马光"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    }
