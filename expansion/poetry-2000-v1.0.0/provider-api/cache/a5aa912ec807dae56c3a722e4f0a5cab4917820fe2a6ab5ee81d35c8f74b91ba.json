{
  "data": [
    {
      "id": 261404,
      "title": "赠内兄卢纶",
      "content": [
        "世故中年别，余生此会同。",
        "却将悲与病，来对朗陵翁。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 261405,
      "title": "答窦二曹长留酒还榼",
      "content": [
        "榼小非由榼，星朗是酒星。",
        "解酲元有数，不用吓刘伶。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 261406,
      "title": "答广宣供奉问兰陵居",
      "content": [
        "居北有朝路，居南无住人。",
        "劳师问家第，山色是南邻。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 261407,
      "title": "乞宽禅师瘿山罍呈宣供奉",
      "content": [
        "石色凝秋藓，峰形若夏云。",
        "谁留秦苑地，好赠杏溪君。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 261408,
      "title": "观骑射",
      "content": [
        "边头射雕将，走马出中军。",
        "远见平原上，翻身向暮云。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 261409,
      "title": "幽州赋诗见意时佐刘幕",
      "content": [
        "征戍在桑干，年年蓟水寒。",
        "殷勤驿西路，北去向长安。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 261410,
      "title": "军次阳城烽舍北流泉",
      "content": [
        "何地可潸然，阳城烽树边。",
        "今朝望乡客，不饮北流泉。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 261411,
      "title": "金吾子",
      "content": [
        "绣帐博山𬬻，银鞍冯子都。",
        "黄昏莫攀折，惊起欲栖乌。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 261412,
      "title": "山鹧鸪词",
      "content": [
        "湘江斑竹枝，锦翅鹧鸪飞。",
        "处处湘云合，郎从何处归。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 261413,
      "title": "立秋前一日览镜",
      "content": [
        "万事销身外，生涯在镜中。",
        "唯将满鬓雪，明日对秋风。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 261414,
      "title": "代人乞花",
      "content": [
        "绣户朝眠起，开帘满地花。",
        "春风解人意，欲落妾西家。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 261415,
      "title": "上洛桥",
      "content": [
        "金谷园中柳，春来似舞腰。",
        "何堪好风景，独上洛阳桥。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 261416,
      "title": "扬州怀古",
      "content": [
        "故国歌钟地，长桥车马尘。",
        "彭城阁边柳，偏似不胜春。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 261417,
      "title": "水宿闻雁",
      "content": [
        "早雁忽为双，惊秋风水窗。",
        "夜长人自起，星月满空江。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 261418,
      "title": "扬州早雁",
      "content": [
        "江上三千雁，年年过故宫。",
        "可怜江上月，偏照断根蓬。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 261419,
      "title": "下楼",
      "content": [
        "话旧全应老，逢春喜又悲。",
        "看花行拭泪，倍觉下楼迟。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 261420,
      "title": "度破讷沙二首 一",
      "content": [
        "眼见风来沙旋移，经年不省草生时。",
        "莫言塞北无春到，总有春来何处知。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 261421,
      "title": "度破讷沙二首 二",
      "content": [
        "破讷沙头雁正飞，䴙鹈泉上战初归。",
        "平明日出东南地，满碛寒光生铁衣。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 261422,
      "title": "拂云堆",
      "content": [
        "汉将新从虏地来，旌旗半上拂云堆。",
        "单于每近沙场猎，南望阴山哭始回。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 261423,
      "title": "中桥北送穆质兄弟应制戏赠萧二策",
      "content": [
        "洛水桥边雁影疎，陆机兄弟驻行车。",
        "欲陈汉帝登封草，犹待萧郎寄内书。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 261424,
      "title": "九月十日雨中过张伯佳期柳镇未至以诗招之",
      "content": [
        "柳吴兴近无消息，张长公贫苦寂寥。",
        "唯有角巾霑雨至，手持残菊向西招。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 261425,
      "title": "汴河曲",
      "content": [
        "汴水东流无限春，隋家宫阙已成尘。",
        "行人莫上长堤望，风起杨花愁杀人。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 261426,
      "title": "塞下曲 一",
      "content": [
        "蕃州部落能结束，朝暮驰猎黄河曲。",
        "燕歌未断塞鸿飞，牧马群嘶边草绿。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 261427,
      "title": "塞下曲 二",
      "content": [
        "秦筑长城城已摧，汉武北上单于台。",
        "古来征战虏不尽，今日还复天兵来。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 261428,
      "title": "塞下曲 三",
      "content": [
        "黄河东流流九折，沙场埋恨何时绝。",
        "蔡琰没去造胡笳，苏武归来持汉节。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 261429,
      "title": "塞下曲 四",
      "content": [
        "为报如今都护雄，匈奴且莫下云中。",
        "请书塞北阴山石，愿比燕然车骑功。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 261430,
      "title": "夜上西城听梁州曲二首 一",
      "content": [
        "行人夜上西城宿，听唱梁州双筦逐。",
        "此时秋月满关山，何处关山无此曲。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 261431,
      "title": "夜上西城听梁州曲二首 二",
      "content": [
        "鸿雁新从北地来，闻声一半却飞回。",
        "金河戍客肠应断，更在秋风百尺台。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 261432,
      "title": "暖川",
      "content": [
        "胡风冻合䴙鹈泉，牧马千群逐暖川。",
        "塞外征行无尽日，年年移帐雪中天。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 261433,
      "title": "过马嵬",
      "content": [
        "汉将如云不直言，寇来翻罪绮罗恩。",
        "托君休洗莲花血，留记千年妾泪痕。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 261434,
      "title": "答许五端公马上口号",
      "content": [
        "晚逐旌旗俱白首，少游京洛共缁尘。",
        "不堪身外悲前事，强向杯中觅旧春。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 261435,
      "title": "牡丹",
      "content": [
        "紫蕊丛开未到家，却教游客赏繁华。",
        "始知年少求名处，满眼空中别有花。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 261436,
      "title": "边思",
      "content": [
        "腰悬锦带佩吴钩，走马曾防玉塞秋。",
        "莫笑关西将家子，秪将诗思入凉州。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 261437,
      "title": "奉和武相公春晓闻莺",
      "content": [
        "蜀道山川心易惊，缘窗残梦晓闻莺。",
        "分明似写文君恨，万怨千愁弦上声。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 261438,
      "title": "送客还幽州",
      "content": [
        "惆怅秦城送独归，蓟门云树远依依。",
        "秋来莫射南飞雁，从遣乘春更北飞。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 261439,
      "title": "柳杨送客",
      "content": [
        "青枫江畔白苹洲，楚客伤离不待秋。",
        "君见隋朝更何事，柳杨南渡水悠悠。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 261440,
      "title": "从军北征",
      "content": [
        "天山雪后海风寒，横笛偏吹行路难。",
        "碛里征人三十万，一时回向月明看。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 261441,
      "title": "听晓角",
      "content": [
        "边霜昨夜堕关榆，吹角当城汉月孤。",
        "无限塞鸿飞不度，秋风卷入小单于。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 261442,
      "title": "宫怨",
      "content": [
        "露湿晴花春殿香，月明歌吹在昭阳。",
        "似将海水添宫漏，共滴长门一夜长。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 261443,
      "title": "暮过回乐烽",
      "content": [
        "烽火高飞百尺台，黄昏遥自碛西来。",
        "昔时征战回应乐，今日从军乐未回。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 261444,
      "title": "奉和武相公郊居寓目",
      "content": [
        "黄扉晚下禁垣钟，归坐南闱山万重。",
        "独有月中高兴尽，雪峰明处见寒松。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 261445,
      "title": "诣红楼院寻广宣不遇留题",
      "content": [
        "柿叶翻红霜景秋，碧天如水倚红楼。",
        "隔窗爱竹无人问，遣向邻房觅户钩。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 261446,
      "title": "回军行",
      "content": [
        "关城榆叶早疎黄，日暮沙云古战场。",
        "表请回军掩尘骨，莫教士卒哭龙荒。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 261447,
      "title": "邠宁春日",
      "content": [
        "桃李年年上国新，风沙日日塞垣人。",
        "伤心更见庭前柳，忽有千条欲占春。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 261448,
      "title": "古瑟怨",
      "content": [
        "破瑟悲秋已减弦，湘灵沈怨不知年。",
        "感君拂拭遗音在，更奏新声明月天。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 261449,
      "title": "夜宴观石将军舞",
      "content": [
        "微月东南上戍楼，琵琶起舞锦缠头。",
        "更闻横笛关山远，白草胡沙西塞秋。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 261450,
      "title": "春夜闻笛",
      "content": [
        "寒山吹笛唤春归，迁客相看泪满衣。",
        "洞庭一夜无穷雁，不待天明尽北飞。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 261451,
      "title": "扬州送客",
      "content": [
        "南行直入鹧鸪群，万岁桥边一送君。",
        "闻道望乡闻不得，梅花暗落岭头云。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 261452,
      "title": "统汉峰下",
      "content": [
        "统汉峰西降户营，黄河战骨拥长城。",
        "只今已勒燕然石，北地无人空月明。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 261453,
      "title": "避暑女冠",
      "content": [
        "雾袖烟裾云母冠，碧琉璃簟井冰寒。",
        "焚香欲使三清鸟，静拂桐阴上玉坛。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 261454,
      "title": "行舟",
      "content": [
        "柳花飞入正行舟，卧引菱花信碧流。",
        "闻道风光满扬子，天晴共上望乡楼。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 261455,
      "title": "隋宫燕",
      "content": [
        "燕语如伤旧国春，宫花一落已成尘。",
        "自从一闭风光后，几度飞来不见人。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 261456,
      "title": "送人归岳阳",
      "content": [
        "烟草连天枫树齐，岳阳归路子规啼。",
        "春江万里巴陵戍，落日看沈碧水西。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 261457,
      "title": "上汝州郡楼",
      "content": [
        "黄昏鼓角似边州，三十年前上此楼。",
        "今日山城对垂泪，伤心不独为悲秋。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 261458,
      "title": "临滹沱见蕃使列名",
      "content": [
        "漠南春色到滹沱，碧柳青青塞马多。",
        "万里关山今不闭，汉家频许郅支和。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 261459,
      "title": "写情",
      "content": [
        "水纹珍簟思悠悠，千里佳期一夕休。",
        "从此无心爱良夜，任他明月下西楼。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 261460,
      "title": "夜上受降城闻笛",
      "content": [
        "回乐峰前沙似雪，受降城下月如霜。",
        "不知何处吹芦管，一夜征人尽望乡。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 261461,
      "title": "赴渭北宿石泉驿南望黄堆烽",
      "content": [
        "边城已在虏城中，烽火南飞入汉宫。",
        "汉庭议事先黄老，麟阁何人定战功。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 261462,
      "title": "逢归信偶寄",
      "content": [
        "无事将心寄柳条，等闲书字满芭蕉。",
        "乡关若有东流信，遣送扬州近驿桥。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 261463,
      "title": "赠毛仙翁",
      "content": [
        "玉树溶溶仙气深，含光混俗似无心。",
        "长愁忽作鹤飞去，一片孤云何处寻。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 261464,
      "title": "长干行",
      "content": [
        "忆妾深闺里，烟尘不曾识。",
        "嫁与长干人，沙头候风色。",
        "五月南风兴，思君下巴陵。",
        "八月西风起，想君发扬子。",
        "去来悲如何，见少离别多。",
        "湘潭几日到，妾梦越风波。",
        "昨夜狂风度，吹折江头树。",
        "渺渺暗无边，行人在何处。",
        "好乘浮云骢，佳期兰渚东。",
        "鸳鸯绿浦上，翡翠锦屏中。",
        "自怜十五余，颜色桃花红。",
        "那作商人妇，愁水复愁风。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 261465,
      "title": "和丘员外题湛长史旧居",
      "content": [
        "昔降英王顾。",
        "屏身幽岩曲，灵波结繁笳。",
        "爽籁赴鸣玉，运转春华至。",
        "岁来山草绿，青松掩落晖。",
        "白云竟空谷，伊人抚遗叹。",
        "恻恻芳又缛，云谁𢽾美香。",
        "分毫寄明牧。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 261466,
      "title": "送客归振武",
      "content": [
        "骏马事轻车，军行万里沙。",
        "胡山通嗢落，汉节绕浑邪。",
        "桂满天西月，芦吹塞北笳。",
        "别离俱报主，路极不为赊。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261467,
      "title": "府试古镜",
      "content": [
        "旧是秦时镜，今藏古匣中。",
        "龙盘初挂月，凤舞欲生风。",
        "石黛曾留殿，朱光适在宫。",
        "应祥知道泰，鉴物觉神通。",
        "肝胆诚难隐，妍媸信易穷。",
        "幸居君子室，长愿免尘蒙。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 261468,
      "title": "赠宣大师",
      "content": [
        "一国沙弥独解诗，人人道胜惠林师。",
        "先皇诏下征还日，今上龙飞入内时。",
        "看月忆来松寺宿，寻花思作杏溪期。",
        "因论佛地求心地，秪说常吟是住持。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 261469,
      "title": "汉宫词",
      "content": [
        "汉室长陵小市东，珠帘绣户对春风。",
        "君王昨日移仙仗，玉辇将迎入汉中。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 261470,
      "title": "江南曲",
      "content": [
        "长乐花枝雨点销，江城日暮好相邀。",
        "春楼不闭葳蕤锁，绿水回连宛转桥。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 261473,
      "title": "途中寄李二",
      "content": [
        "杨柳含烟灞岸春，年年攀折为行人。",
        "好风若借低枝便，莫遣青丝扫路尘。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 261474,
      "title": "寄许炼师",
      "content": [
        "扫石焚香礼碧空，露华偏湿蕊珠宫。",
        "如何说得天坛上，万里无云月在中。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 261475,
      "title": "失题",
      "content": [
        "世故相逢各未闲，百年多在别离间。",
        "昨夜秋风今夜雨，不知何处入空山。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 261476,
      "title": "塞下曲",
      "content": [
        "伏波惟愿裹尸还，定远何须生入关。",
        "莫遣只轮归海窟，仍留一箭射天山。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 261477,
      "title": "上黄堆烽",
      "content": [
        "心期紫阁山中月，身过黄堆烽上云。",
        "年发已从书劒老，戎衣更逐霍将军。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 261478,
      "title": "句",
      "content": [
        "闲庭草色能留马，当路杨花不避人。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 266291,
      "title": "杂曲歌辞 鹧鸪词",
      "content": [
        "湘江斑竹枝，锦翼鹧鸪飞。",
        "处处湘云合，郎从何处归。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 292764,
      "title": "宣上人病中相寻联句",
      "content": [
        "策杖迎诗客，归房理病身。",
        "闲收无效药，徧寄有情人。",
        "草木分千品，方书问六陈。",
        "还知一室内，我尔即天亲。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 292765,
      "title": "八月十五夜宣上人独游安国寺山庭院步人迟明将至因话昨宵乘兴联句",
      "content": [
        "九重城接天花界，三五秋生一夜风。",
        "行听漏声云散后，遥闻天语月明中。",
        "含凉阁迥通仙掖，承露盘高出上宫。",
        "谁问独愁门外客，清谈不与此宵同。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 292766,
      "title": "重阳夜集兰陵居与宣上人联句",
      "content": [
        "蟋蟀催寒服，茱萸滴露房。",
        "酒巡明刻烛，篱菊暗寻芳。",
        "新月和秋露，繁星混夜霜。",
        "登高今夕事，九九是天长。"
      ],
      "author": {
        "id": 9351,
