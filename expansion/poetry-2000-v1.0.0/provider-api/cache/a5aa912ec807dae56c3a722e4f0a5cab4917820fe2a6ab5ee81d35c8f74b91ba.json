    {
      "id": 292767,
      "title": "与宣供奉携瘿尊归杏溪园联句",
      "content": [
        "千畦抱瓮园，一酌瘿尊酒。",
        "唯有沃洲僧，时过杏溪叟。",
        "追欢君适性，独饮我空口。",
        "儒释事虽殊，文章意多偶。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 292768,
      "title": "兰陵僻居联句",
      "content": [
        "潘岳闲居赋，陶潜独酌谣。",
        "二贤成往事，三径是今朝。",
        "生幸逢唐运，昌时奉帝尧。",
        "进思谐启沃，退混即渔樵。",
        "蠹简封延阁，雕阑閟上霄。",
        "相从清旷地，秋露挹兰苕。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 292769,
      "title": "天津桥南山中各题一句",
      "content": [
        "野坐分苔席，山行绕菊丛。",
        "云衣惹不破，秋色望来空。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 292770,
      "title": "红楼下联句",
      "content": [
        "佛刹接重城，红楼切太清。",
        "紫云连照耀，丹槛郁峥嵘。",
        "榱栋烟虹入，轩窗日月平。",
        "参差五陵晚，分背八川明。",
        "松韵风初过，莲陂浪欲倾。",
        "敬瞻疑涌见，围绕学无生。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 292771,
      "title": "赋应门照绿苔",
      "content": [
        "宫阙何年月，应门何岁苔。",
        "清光一以照，白露共裴回。",
        "珠履久行绝，玉房重未开。",
        "妾心正如此，昭阳歌吹来。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 303737,
      "title": "游栖岩寺",
      "content": [
        "晚上梯延洞，通宵兴莫穷。",
        "高明千嶂月，清爽一岩风。",
        "坐久衣衫润，吟余物象空。",
        "举头星可摘，疑在广寒宫。",
        "（见《古今图书集成·山川典》卷三五《中条山部》）。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 334431,
      "title": "横吹曲辞：紫骝马",
      "content": [
        "争场看斗鸡，白鼻紫䯄嘶。",
        "漳水春归晚，丛台日向低。",
        "歇鞍珠作汗，试剑玉如泥。",
        "为谢红梁燕，年年妾独栖。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 334453,
      "title": "相和歌辞：江南曲",
      "content": [
        "嫁得瞿塘贾，朝朝误妾期。",
        "早知潮有信，嫁与弄潮儿。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 334541,
      "title": "相和歌辞：置酒行",
      "content": [
        "置酒命所欢，凭觞遂为戚。",
        "日往不再来，兹辰坐成昔。",
        "百龄非长久，五十将半百。",
        "胡为劳我形，已须还复白。",
        "西山鸾鹤顾，矫矫烟雾翮。",
        "明霞发金丹，阴洞潜水碧。",
        "安得凌风羽，崦嵫驻灵魄。",
        "兀然坐衰老，惭叹东陵柏。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 334573,
      "title": "相和歌辞：从军有苦乐行",
      "content": [
        "劳者且勿歌，我欲送君觞。",
        "从军有苦乐，此曲乐未央。",
        "仆本居陇上，陇水断人肠。",
        "东过秦宫路，宫路入咸阳。",
        "时逢汉帝出，谏猎至长杨。",
        "讵驰游侠窟，非结少年场。",
        "一旦承嘉惠，轻命重恩光。",
        "秉笔参帷帟，从军至朔方。",
        "边地多阴风，草木自凄凉。",
        "断绝海云去，出没胡沙长。",
        "参差引雁翼，隐辚腾军装。",
        "剑文夜如水，马汗冻成霜。",
        "侠气五都少，矜功六郡良。",
        "山河起目前，睚眦死路傍。",
        "北逐驱獯虏，西临复旧疆。",
        "昔还赋余资，今出乃赢粮。",
        "一矢弢夏服，我弓不再张。",
        "寄言丈夫雄，苦乐身自当。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 334692,
      "title": "相和歌辞：宫怨",
      "content": [
        "露湿晴花宫殿香，月明歌吹在昭阳。",
        "似将海水添宫漏，共滴长门一夜长。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 334953,
      "title": "杂曲歌辞：汉宫少年行",
      "content": [
        "君不见上宫警夜营八屯，冬冬街鼓朝朱轩。",
        "玉阶霜仗拥未合，少年排入铜龙门。",
        "暗闻弦管九天上，",
        "玉笼金琐养黄口，探雏取卵伴王孙。",
        "分曹六博快一掷，",
        "晚来香街经柳市，行过倡市宿桃根。",
        "相逢杯酒一言失，",
        "岂知人事无定势，朝欢暮戚如掌翻。",
        "椒房宠移子爱夺，",
        "持杯收水水已覆，徙薪避火火更燔。",
        "欲求四老张丞相，"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 334960,
      "title": "杂曲歌辞：轻薄篇",
      "content": [
        "豪不必驰千骑，雄不在垂双鞬。",
        "天生俊气自相逐，",
        "忽闻燕雁一声去，回鞭挟弹平陵园。",
        "归来青楼曲未半，",
        "安知我有不平色，白日欲顾红尘昏。",
        "死生容易如反掌，"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 334972,
      "title": "杂曲歌辞：游子吟",
      "content": [
        "女羞夫婿荡，客耻主人贱。",
        "遭遇同众流，低回愧相见。",
        "君非青铜镜，何事空照面。",
        "莫以衣上尘，不谓心如练。",
        "人生当荣盛，待士勿言倦。",
        "君看白日驰，何异弦上箭。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 335031,
      "title": "杂曲歌辞：古别离",
      "content": [
        "双剑欲别风凄然，雌沉水底雄上天。",
        "江回汉转两不见，"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 335241,
      "title": "杂曲歌辞：鹧鸪词",
      "content": [
        "湘江斑竹枝，锦翼鹧鸪飞。",
        "处处湘阴合，郎从何处归。"
      ],
      "author": {
        "id": 9351,
        "name": "李益"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
