{
  "data": [
    {
      "id": 276404,
      "title": "献鄜坊丘常侍",
      "content": [
        "诏选将军护北戎，身骑白马臂彤弓。",
        "柳营远识金貂贵，榆塞遥知玉帐雄。",
        "秋槛鼓鼙惊朔雪，晓阶旗纛起边风。",
        "蓬莱每望平安火，应奏班超定远功。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276405,
      "title": "寄当涂李远",
      "content": [
        "赋拟相如诗似陶，云阳烟月又同袍。",
        "车前骥病驽骀逸，架上鹰闲鸟雀高。",
        "旧日乐贫能饮水，他时随俗愿𫗦糟。",
        "不须倚向青山住，咏雪题诗用意劳。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276406,
      "title": "和崔大夫新广北楼登眺",
      "content": [
        "北望高楼夏亦寒，山重水阔接长安。",
        "修梁暗换丹楹小，疎牖全开彩槛宽。",
        "风卷浮云披睥睨，露凉明月坠阑干。",
        "庾公恋阙怀乡处，目送归帆下远滩。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276407,
      "title": "送客自两河归江南",
      "content": [
        "两河庶事已堪伤，南客秋归路更长。",
        "台畔古松悲魏帝，苑边修竹吊梁王。",
        "山行露变茱萸色，水宿风披菡萏香。",
        "遥羡落帆逢旧友，绿蛾青鬓醉横塘。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 276408,
      "title": "题陆侍御林亭",
      "content": [
        "野水通池石叠台，五营无事隐雄才。",
        "松斋下马书千卷，兰舫逢人酒一杯。",
        "寒树雪晴红艳吐，远山云晓翠光来。",
        "定知别后无多日，海柳江花次第开。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276409,
      "title": "泊蒜山津闻东林寺光仪上人物故",
      "content": [
        "云斋曾宿借方袍，因说浮生大梦劳。",
        "言下是非齐虎尾，宿来荣辱比鸿毛。",
        "孤舟千棹水犹阔，寒殿一灯夜更高。",
        "明日东林有谁在，不堪秋磬拂烟涛。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276410,
      "title": "春日思旧游寄南徐从事刘三复",
      "content": [
        "风暖曲江花半开，忽思京口共衔杯。",
        "湘潭云尽暮山出，巴蜀雪消春水来。",
        "怀玉尚悲迷楚塞，捧金犹羡乐燕台。",
        "蓟门高处极归思，陇鴈北飞双燕回。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276411,
      "title": "郊园秋日寄洛中友人",
      "content": [
        "楚水西来天际流，感时伤别思悠悠。",
        "一尊酒尽青山莫，万里书回碧树秋。",
        "日落远波惊宿鴈，风吹轻浪起眠鸥。",
        "嵩阳亲友如相问，潘岳闲居欲白头。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276412,
      "title": "送杜秀才归桂林",
      "content": [
        "桂州南去与谁同，处处山连水自通。",
        "两岸晓霞千里草，半帆斜日一江风。",
        "瘴雨欲来枫树黑，火云初起荔枝红。",
        "愁君路远销年月，莫滞三湘五岭中。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276413,
      "title": "春雨舟中次和横江裴使君见迎李赵二秀才同来因书四韵兼寄江南",
      "content": [
        "芳草渡头微雨时，万株杨柳拂波垂。",
        "蒲根水暖鴈初落，梅径香寒蜂未知。",
        "词客倚风吹暗淡，使君回马湿旌旗。",
        "江南仲蔚多情调，怅望青云几首诗。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 276414,
      "title": "东陵赴京道病东归寓居开元寺寄卢员外宋魏二先辈",
      "content": [
        "西风吹雨鴈初时，病寄僧斋罢献书。",
        "万里咸秦劳我马，四邻松桂忆吾庐。",
        "沧洲有约心还静，青汉无媒迹自疎。",
        "不是醉眠愁不散，莫言琴酒学相如。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276415,
      "title": "闻开江宋相公申锡下世二首 一",
      "content": [
        "权门阴奏夺移才，驲骑如星堕峡来。",
        "鼌氏有恩忠作祸，贾生无罪直为灾。",
        "贞魂误向崇山殁，冤气疑从汩水回。",
        "毕竟功成何处是，五湖云月一帆开。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276416,
      "title": "闻开江宋相公申锡下世二首 二",
      "content": [
        "月落湘潭棹不喧，玉杯瑶瑟奠苹蘩。",
        "谁能力制乘时鹤，自取机沈在槛猨。",
        "位极乾坤三事贵，谤兴华夏一夫冤。",
        "宵衣旰食明天子，日伏青蒲不敢言。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276417,
      "title": "赠所知",
      "content": [
        "因钓鲈鱼住淛河，挂帆千里亦相过。",
        "茅簷夜醉平阶月，兰棹春归拍岸波。",
        "湖日似阴鼍鼓响，海云才起蜃楼多。",
        "明时又作闲居赋，谁荐东门策四科。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276418,
      "title": "谢人赠鞭",
      "content": [
        "蜀国名鞭见惠稀，驽骀从此长光辉。",
        "独根拥肿来云岫，紫陌提携在绣衣。",
        "几度拂花香里过，也曾敲𩍐月中归。",
        "莫言三尺长无用，百万军中要指挥。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276419,
      "title": "早秋寄刘尚书",
      "content": [
        "天生心识富人侯，将相门中第一流。",
        "旗纛早开擒虎帐，戈[鋋]初发斩鲸舟。",
        "柳营书号海山暝，菌阁赋诗江树秋。",
        "昨夜雨凉今夜月，笙歌应醉最高楼。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276420,
      "title": "及第后春情",
      "content": [
        "世间得意是春风，散诞经过触处通。",
        "细摇柳脸牵长带，慢撼桃株舞碎红。",
        "也从吹幌惊残梦，何处飘香别故丛？",
        "犹以西都名下客，今年一月始相逢。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276421,
      "title": "归长安",
      "content": [
        "三年何处泪汍澜，白帝城边晓角残。",
        "非是无心恋巫峡，自缘□臂到长安。",
        "黔江水暖还曾饮，楚岫云深不识寒。",
        "大抵莫教闻雨后，此时肠断不应难。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276422,
      "title": "经古行宫",
      "content": [
        "台阁参差倚太阳，年年花发满山香。",
        "重门堪锁青春晚，深院垂帘白昼长。",
        "草色芊绵侵御路，泉声呜咽绕宫墙。",
        "先皇一去无回驾，红粉云鬟空断肠。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 276424,
      "title": "贵游",
      "content": [
        "朝回佩马早凄凄，年少恩深卫霍齐。",
        "斧钺旧威龙塞北，池台新赐凤城西。",
        "门通碧树开金锁，楼对青山倚玉梯。",
        "南陌行人尽回首，笙歌一曲暮云低。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276426,
      "title": "秋夜与友人宿",
      "content": [
        "楚国同游过十霜，万重心事几堪伤。",
        "蒹葭露白莲塘浅，砧杵夜清河汉凉。",
        "云外山川归梦远，天涯岐路客愁长。",
        "塞城欲晓闻吹笛，犹卧东轩月满床。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276428,
      "title": "寄湘中友人",
      "content": [
        "莫恋醉乡迷酒杯，流年长怕老年催。",
        "西陵水阔鱼难到，南国路遥书未回。",
        "匹马计程愁日尽，一蝉何事引秋来。",
        "相如已定题桥志，江上无由梦钓台。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276429,
      "title": "江上逢友人",
      "content": [
        "故国归人酒一杯，暂停兰棹共徘徊。",
        "村连三峡暮云起，潮送九江寒雨来。",
        "已作相如投赋计，还凭殷浩寄书回。",
        "到时若见东篱菊，为问经霜几度开。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276430,
      "title": "金谷怀古",
      "content": [
        "凄凉遗迹洛川东，浮世荣枯万古同。",
        "桃李香销金谷在，绮罗魂断玉楼空。",
        "往年人事伤心外，今日风光属梦中。",
        "□□□□□□□，□□□□□□□。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276431,
      "title": "经行庐山东林寺",
      "content": [
        "离魂断续楚江壖，叶坠初红十月天。",
        "紫陌事多难数悉，青山长在好闲眠。",
        "方趋上国期干禄，未得空堂学坐禅。",
        "他岁若教如范蠡，也应须入五湖烟。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276432,
      "title": "途中逢故人话西山读书早曾游览",
      "content": [
        "西岩曾到读书堂，穿竹行沙十里强。",
        "湖上梦余波滟滟，岭头愁断路茫茫。",
        "经过事寄烟霞远，名利尘随日月长。",
        "莫道少年头不白，君看潘岳几茎霜。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276433,
      "title": "将赴京题陵阳王氏水居",
      "content": [
        "帘卷平芜接远天，暂宽行役到尊前。",
        "是非境里有闲日，荣辱尘中无了年。",
        "山簇暮云千野雨，江分秋水九条烟。",
        "马蹄不道贪西去，争向一声高树蝉。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276434,
      "title": "冬日五浪馆水亭怀别",
      "content": [
        "芦荻花多触处飞，独凭虚槛雨微微。",
        "寒林叶落鸟巢出，古渡浪高鱼艇稀。",
        "云抱四山终日在，草荒三径几时归。",
        "江城向暝东风急，一半乡愁闻捣衣。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276435,
      "title": "送别",
      "content": [
        "溪边杨柳色参差，攀折年年赠别离。",
        "一片风帆望已极，三湘烟水返何时？",
        "多缘去棹将愁远，犹倚危楼欲下迟。",
        "莫𣨼酒杯闲过日，碧云深处是佳期。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276436,
      "title": "寄远",
      "content": [
        "两叶愁眉愁不开，独含惆怅上层台。",
        "碧云空断鴈行处，红叶已凋人未来。",
        "塞外音书无信息，道傍车马起尘埃。",
        "功名待寄凌烟阁，力尽辽城不肯回。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276437,
      "title": "新柳",
      "content": [
        "无力摇风晓色新，细腰争妒看来频。",
        "绿阴未覆长堤水，金穗先迎上苑春。",
        "几处伤心怀远路，一枝和日送行尘。",
        "东□门外多离别，愁杀朝朝暮暮人。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276438,
      "title": "旅怀作",
      "content": [
        "促促因吟昼短诗，朝惊秾色暮空枝。",
        "无情春色不长久，有限年光多盛衰。",
        "往事只应随梦里，劳生何处是闲时。",
        "眼前扰扰日一日，暗送白头人不知。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276439,
      "title": "鴈",
      "content": [
        "万里衔芦别故乡，云飞水宿向潇湘。",
        "数声孤枕堪垂泪，几处高楼欲断肠。",
        "度日翩翩斜避影，临风一一直成行。",
        "年年辛苦来衡岳，羽翼摧残陇塞霜。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276440,
      "title": "出关",
      "content": [
        "朝缨初解佐江滨，麋鹿心知自有群。",
        "汉囿猎稀慵献赋，楚山耕早任移文。",
        "卧归渔浦月连海，行望凤城花隔云。",
        "关吏不须迎马笑，去时无意学终军。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276441,
      "title": "寄房千里博士",
      "content": [
        "春风白马紫丝缰，正值蚕眠未采桑。",
        "五夜有心随暮雨，百年无节待秋霜。",
        "重寻绣带朱藤合，更认罗裙碧草长。",
        "为报西游减离恨，阮郎才去嫁刘郎。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276442,
      "title": "泛五云溪",
      "content": [
        "此溪何处路，遥问白髯翁。",
        "佛庙千岩里，人家一岛中。",
        "鱼倾荷叶露，蝉噪柳林风。",
        "急濑鸣车轴，微波漾钓筒。",
        "石苔萦棹绿，山果拂舟红。",
        "更就千村宿，溪桥与剡通。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 276443,
      "title": "寄郴州李相公",
      "content": [
        "高楼王与谢，逸韵比南金。",
        "不遇销忧日，埃尘谁复寻。",
        "旷怀澹得丧，失意纵登临。",
        "彩槛浮云迥，绮窗明月深。",
        "虬龙压沧海，鸳鸯思邓林。",
        "青云伤国器，白发轸乡心。",
        "功高恩自洽，道直谤徒侵。",
        "应笑灵均恨，江畔独行吟。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 276444,
      "title": "赠萧炼师",
      "content": [
        "曾试昭阳曲，瑶斋帝自临。",
        "红珠络绣帽，翠钿束罗襟。",
        "双阙胡尘起，千门宿露阴。",
        "出宫迷国步，回驾轸皇心。",
        "桂殿春空晚，椒房夜自深。",
        "急宣求故劒，冥契得遗簪。",
        "暗记神仙传，潜封女史箴。",
        "壶中知日永，掌上畏年侵。",
        "莫比班家扇，宁同卓氏琴。",
        "云车辞凤辇，羽帔别鸳衾。",
        "网断鱼游藻，笼开鹤戏林。",
        "洛烟浮碧汉，嵩月上丹岑。",
        "露草争三秀，风篁共八音。",
        "吹笙延鹤舞，敲磬引龙吟。",
        "旄节纤腰举，霞杯皓腕斟。",
        "还磨照宝镜，犹插辟寒金。",
        "东海人情变，南山圣寿沈。",
        "朱颜常似渥，绿髪已如寻。",
        "养气齐生死，留形尽古今。",
        "更求应不见，鸡犬日骎骎。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 276445,
      "title": "冬日宣城开元寺赠元孚上人",
      "content": [
        "一钵事南宗，僧仪称病容。",
        "曹溪花里别，萧寺竹前逢。",
        "烛影深寒殿，经声彻曙钟。",
        "欲斋簷睡鸽，初定壁吟蛩。",
        "诗继休遗韵，书传永逸踪。",
        "艺多人誉洽，机绝道情浓。",
        "汲涧瓶沈藻，眠堦锡挂松。",
        "云鸣新放鹤，池卧旧降龙。",
        "露茗山厨焙，霜秔野碓舂。",
        "梵文明处译，禅衲暖时缝。",
        "层塔题应遍，飞轩步不慵。",
        "绣梁交薜荔，画井倒芙蓉。",
        "翠户垂旗网，朱窗列劒锋。",
        "寒风金磬远，晴雪玉楼重。",
        "妙理三乘达，清才万象供。",
        "山高横睥睨，滩浅聚艨艟。",
        "微雾苍平楚，残晖淡远峰。",
        "林疎霜摵摵，波静月溶溶。",
        "劒出因雷焕，琴全遇蔡邕。",
        "西方知有社，支许合相从。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 276446,
      "title": "维舟秦淮过温州李给事宅",
      "content": [
        "给事为郎日，青溪醉隐衔。",
        "冰池通极浦，雪迳遶高岩。",
        "珠玉砂同弃，松筠草共芟。",
        "帝图忧一失，臣节耻三缄。",
        "代有王陵戆，时无靳尚谗。",
        "定应标直笔，宁为发空函。",
        "雾黑连云栈，风狂截海帆。",
        "石梯迎雨润，沙井待潮咸。",
        "蜡屐青筇杖，蓝舆白罽衫。",
        "应劳北归梦，山路正巉巉。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 276447,
      "title": "登蒜山观发军",
      "content": [
        "羽檄征兵急，辕门选将雄。",
        "犬羊忧破竹，貔虎极飞蓬。",
        "定系猖狂虏，何烦矍铄翁。",
        "更探黄石略，重振黑山功。",
        "别马嘶营柳，惊乌散井桐。",
        "低星连宝剑，残月让雕弓。",
        "浪晓戈鋋里，山晴鼓角中。",
        "甲开鱼照水，旗飏虎拏风。",
        "去想金河远，行知玉塞空。",
        "汉庭应有问，师律在元戎。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 276448,
      "title": "送从兄别驾归蜀",
      "content": [
        "闻与湘南令，童年侍玉墀。",
        "家留秦塞曲，官谪瘴溪湄。",
        "道直奸臣屏，冤深圣主知。",
        "逝川东去疾，霈泽北来迟。",
        "青汉龙髯绝，苍岑马鬣移。",
        "风凄闻笛处，月惨罢琴时。",
        "客路黄公庙，乡关白帝祠。",
        "已称鹦鹉赋，宁诵鹡鸰诗。",
        "远道书难达，长亭酒莫持。",
        "当凭蜀江水，万里寄相思。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 276449,
      "title": "金陵阻风登延祚阁",
      "content": [
        "极目皆陈迹，披图问远公。",
        "戈鋋三国后，冠盖六朝中。",
        "葛蔓交残垒，芒花没后宫。",
        "水流箫鼓绝，山在绮罗空。",
        "极浦千艘聚，高台一径通。",
        "云移吴岫雨，潮转楚江风。",
        "登阁慙漂梗，停舟忆断蓬。",
        "归期与归路，杉桂海门东。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 276450,
      "title": "送林处士自闽中道越由霅抵两川",
      "content": [
        "书劒少青眼，烟波初白头。",
        "乡关背梨岭，客路转苹洲。",
        "处困道难固，乘时恩易酬。",
        "镜中非访戴，劒外欲依刘。",
        "高枕海天暝，落帆江雨秋。",
        "鼍声应远鼓，蜃气学危楼。",
        "智士役千虑，达人经百忧。",
        "唯闻陶靖节，多在醉乡游。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 276451,
      "title": "宣城赠萧兵曹",
      "content": [
        "桂檝谪湘渚，三年波上春。",
        "舟寒剡溪雪，衣破洛城尘。",
        "客道耻摇尾，皇恩宽犯鳞。",
        "花时去国远，月夕上楼频。",
        "贪酒不辞病，佣书非为贫。",
        "行吟值渔父，坐隐对樵人。",
        "紫陌罢双辙，碧潭穷一纶。",
        "高歌更南去，烟水是通津。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 276452,
      "title": "秋夕宴李侍御宅",
      "content": [
        "公子征词客，秋堂递玉杯。",
        "月高罗幕卷，风度锦屏开。",
        "凤管添簧品，鹍弦促柱哀。",
        "转喉云旋合，垂手露徐来。",
        "烛换三条烬，香销十炷灰。",
        "蛩声闻鼓歇，萤燄触帘回。",
        "广槛烟分柳，空庭露积苔。",
        "解酲须满酌，应为拨新醅。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 276453,
      "title": "晨自竹径至龙兴寺崇隐上人院",
      "content": [
        "佛寺通南径，僧堂倚北坡。",
        "藤阴迷晚竹，苔滑仰晴莎。",
        "病忆春前别，闲宜雨后过。",
        "石横闻水远，林缺见山多。",
        "欲结三天社，初降十地魔。",
        "毒龙来有窟，灵鹤去无窠。",
        "客路随萍梗，乡园失薜萝。",
        "禅心如可学，不藉鲁阳戈。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 276454,
      "title": "岁暮自广江至新兴往复中题峡山寺四首 一",
      "content": [
        "夜醉晨方醒，孤吟恐失群。",
        "海䲡潮上见，江鹄雾中闻。",
        "未腊梅先实，经冬草自薰。",
        "树随山崦合，泉到石棱分。",
        "虎迹空林雨，猨声绝岭云。",
        "萧萧异乡鬓，明日共丝棼。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 276455,
      "title": "岁暮自广江至新兴往复中题峡山寺四首 二",
      "content": [
        "薄暮缘西峡，停桡一访僧。",
        "鹭巢横卧柳，猨饮倒垂藤。",
        "水曲岩千叠，云重树百层。",
        "山风寒殿磬，溪雨夜船灯。",
        "滩涨危槎没，泉冲怪石崩。",
        "中台一襟泪，岁杪别良朋。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 276456,
      "title": "岁暮自广江至新兴往复中题峡山寺四首 三",
      "content": [
        "密树分苍壁，长溪抱碧岑。",
        "海风闻鹤远，潭日见鱼深。",
        "松盖环清韵，榕根架绿阴。",
        "洞丁多斵石，蛮女半淘金。",
        "南浦惊春至，西楼送月沈。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 276457,
      "title": "岁暮自广江至新兴往复中题峡山寺四首 四",
      "content": [
        "月在行人起，千峰复万峰。",
        "海虚争翡翠，溪逻鬬芙蓉。",
        "古木高生槲，阴池满种松。",
        "火探深洞燕，香送远潭龙。",
        "蓝坞寒先烧，禾堂晚并舂。",
        "更投何处宿，西峡隔云钟。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 276458,
      "title": "南海使院对菊怀丁卯别墅",
      "content": [
        "何处曾移菊，溪桥鹤岭东。",
        "篱疎还有艳，园小亦无丛。",
        "日晚秋烟里，星繁晓露中。",
        "影摇金涧水，香染玉潭风。",
        "罢酒慙陶令，题诗答谢公。",
        "朝来数花发，身在尉佗宫。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 276459,
      "title": "和李相国",
      "content": [
        "巨实珍吴果，驯雏重越禽。",
        "摘来渔浦上，携在兔园阴。",
        "霜合凝丹颊，风披敛素襟。",
        "刀分琼液散，笼簌雪华深。",
        "虎帐斋中设，龙楼洛下吟。",
        "含消兼受彩，应贵冢卿心。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 276460,
      "title": "陪少师李相国崔宾客宴居守狄仆射池亭",
      "content": [
        "池色似潇湘，仙舟正日长。",
        "燕飞惊蛱蝶，鱼跃动鸳鸯。",
        "云聚歌初转，风回舞欲翔。",
        "暖醅松叶嫩，寒粥杏花香。",
        "罗绮留春色，笙竽送晚光。",
        "何须明月夜，红烛在华堂。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 276461,
      "title": "和宾客相国咏雪",
      "content": [
        "近腊千岩白，迎春四气催。",
        "云阴连海起，风急度山来。",
        "尽日隋堤絮，经冬越岭梅。",
        "艳疑歌处散，轻似舞时回。",
        "道蕴诗传丽，相如赋骋才。",
        "霁添松筿媚，寒积蕙兰猜。",
        "暗涨宫池水，平封辇路埃。",
        "烛龙初照耀，巢鹤乍裴回。",
        "簷日琼先挂，墙风粉旋摧。",
        "五门环玉垒，双阙对瑶台。",
        "绮席陵寒坐，珠帘远曙开。",
        "灵芝霜下秀，仙桂月中栽。",
        "卷幌书千帙，援琴酒百桮。",
        "垂休编太史，呈瑞表中台。",
        "皓夜迷三径，浮光彻九垓。",
        "兹辰是丰岁，歌咏属良哉。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 276462,
      "title": "奉和卢大夫新立假山",
      "content": [
        "岩谷留心赏，为山极自然。",
        "孤峰空迸笋，攒萼旋开莲。",
        "黛色朱楼下，云形绣户前。",
        "砌尘凝积霭，簷溜挂飞泉。",
        "树暗壶中月，花香洞里天。",
        "何如谢康乐，海峤独题篇。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 276463,
      "title": "奉命和后池十韵",
      "content": [
        "叠石通溪水，量波失旧规。",
        "芳洲还屈曲，朱阁更逶迤。",
        "浴鸟翻荷叶，惊蝉出柳丝。",
        "翠烟秋桧耸，红露晓莲披。",
        "攀槛登楼近，停桡待客迟。",
        "野桥从浪没，轻舸信风移。",
        "竹韵迁棋局，松阴递酒巵。",
        "性闲鸥自识，心远鹤先知。",
        "应想秦人会，休怀越相祠。",
        "当期穆天子，箫鼓宴瑶池。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 276464,
      "title": "雨后思湖上居",
      "content": [
        "前山风雨凉，歇马坐垂杨。",
        "何处芙蓉落，南渠秋水香。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 276465,
      "title": "闻歌",
      "content": [
        "新秋弦管清，时转遏云声。",
        "曲尽不知处，月高风满城。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 276466,
      "title": "思天台",
      "content": [
        "赤城云雪深，山客负归心。",
        "昨夜西斋宿，月明琪树阴。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 276467,
      "title": "长安早春怀江南",
      "content": [
        "云月有归处，故山清洛南。",
        "如何一花发，春梦徧江潭。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 276468,
      "title": "塞下",
      "content": [
        "夜战桑干北，秦兵半不归。",
        "朝来有乡信，犹自寄征衣。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 276469,
      "title": "送客南归",
      "content": [
        "野寺薜萝晚，官渠杨柳春。",
        "归心已无限，更送洞庭人。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 276471,
      "title": "送曾主簿归楚州省觐予亦明日归姑孰",
      "content": [
        "帆转清淮极鸟飞，落帆应换老莱衣。",
        "河亭未醉先惆怅，明日还从此路归。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276472,
      "title": "重别",
      "content": [
        "泪沿红粉湿罗巾，重系兰舟劝酒频。",
        "留却一枝河畔柳，明朝犹有远行人。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276473,
      "title": "湖上",
      "content": [
        "髣髴欲当三五夕，万蝉清杂乱泉纹。",
        "钓鱼船上一尊酒，月出渡头零落云。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276474,
      "title": "夜泊永乐有怀",
      "content": [
        "莲渚愁红荡碧波，吴娃齐唱采莲歌。",
        "横塘一别已千里，芦苇萧萧风雨多。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276475,
      "title": "宿水合",
      "content": [
        "野客从来不解愁，等闲乘月海西头。",
        "未知南陌谁家子，夜半吹笙入水楼。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276476,
      "title": "谢亭送别",
      "content": [
        "劳歌一曲解行舟，红叶青山水急流。",
        "日暮酒醒人已远，满天风雨下西楼。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276477,
      "title": "酬李当",
      "content": [
        "知有瑶华手自开，巴人虚唱懒封回。",
        "山阴一夜满溪雪，借问扁舟来不来。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276478,
      "title": "蝉",
      "content": [
        "噪柳鸣槐晚未休，不知何事爱悲秋。",
        "朱门大有长吟处，刚傍愁人又送愁。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276479,
      "title": "夜过松江渡寄友人",
      "content": [
        "清露白云明月天，与君齐棹木兰船。",
        "南湖风雨一相失，夜泊横塘心渺然。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276480,
      "title": "守风淮阴",
      "content": [
        "遥见江阴夜渔客，因思京口钓鱼时。",
        "一潭明月万株柳，自去自来人不知。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276481,
      "title": "亡题",
      "content": [
        "商岭采芝寻四老，紫阳收术访三茅。",
        "欲求不死长生诀，骨里无仙不肯教。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276482,
      "title": "送杨发东归",
      "content": [
        "红花半落燕于飞，同客长安今独归。",
        "一纸乡书报兄弟，还家羞著别时衣。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276483,
      "title": "寄宋邧",
      "content": [
        "朱槛烟霜夜坐劳，美人南国旧同袍。",
        "山长水远无消息，瑶瑟一弹秋月高。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276484,
      "title": "题四老庙二首 一",
      "content": [
        "峨峨商岭采芝人，雪顶霜髯虎豹茵。",
        "山酒一巵歌一曲，汉家天子忌功臣。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276485,
      "title": "题四老庙二首 二",
      "content": [
        "避秦安汉出蓝关，松桂花阴满旧山。",
        "自是无人有归意，白云常在水潺潺。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276486,
      "title": "夏日寄江上亲友",
      "content": [
        "雨过前山日未斜，清蝉嘒嘒落槐花。",
        "车轮南北已无限，江上故人才到家。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276487,
      "title": "下第怀友人",
      "content": [
        "独掩衡门花盛时，一封书信缓归期。",
        "南宗更有潇湘客，夜夜月明闻竹枝。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276488,
      "title": "客有卜居不遂薄游汧陇因题",
      "content": [
        "海燕西飞白日斜，天门遥望五侯家。",
        "楼台深锁无人到，落尽春风第一花。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276489,
      "title": "陈宫怨二首 一",
      "content": [
        "风暖江城白日迟，昔人遗事后人悲。",
        "草生宫阙国无主，玉树后庭花为谁。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276490,
      "title": "陈宫怨二首 二",
      "content": [
        "地雄山险水悠悠，不信隋兵到石头。",
        "玉树后庭花一曲，与君同上景阳楼。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276491,
      "title": "经故太尉段公庙",
      "content": [
        "静想追兵缓翠华，古碑荒庙闭松花。",
        "纪生不向荥阳死，争有山河属汉家。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276492,
      "title": "途经秦始皇墓",
      "content": [
        "龙盘虎踞树层层，势入浮云亦是崩。",
        "一种青山秋草里，路人唯拜汉文陵。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276493,
      "title": "游楞伽寺",
      "content": [
        "碧烟秋寺泛潮来，水浸城根古堞摧。",
        "尽日伤心人不见，石榴花满旧琴台。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276494,
      "title": "缑山庙",
      "content": [
        "王子吹箫月满台，玉箫清转鹤裴回。",
        "曲终飞去不知处，山下碧桃春自开。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276495,
      "title": "送薛先辈入关",
      "content": [
        "一巵春酒送离歌，花落敬亭芳草多。",
        "欲问归期已深醉，只应孤梦绕关河。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276496,
      "title": "鸿沟",
      "content": [
        "相持未定各为君，秦政山河此地分。",
        "力尽乌江千载后，古沟芳草起寒云。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276497,
      "title": "韩信庙",
      "content": [
        "朝言云梦暮南巡，已为功名少退身。",
        "尽握兵权犹不得，更将心计托何人。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276498,
      "title": "过湘妃庙",
      "content": [
        "古木苍山掩翠娥，月明南浦起微波。",
        "九疑望断几千载，斑竹泪痕今更多。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276499,
      "title": "寄云际寺敬上人",
      "content": [
        "万山秋雨水萦回，红叶多从紫阁来。",
        "云冷竹斋禅衲薄，已应飞锡过天台。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276500,
      "title": "秋思",
      "content": [
        "琪树西风枕簟秋，楚云湘水忆同游。",
        "高歌一曲掩明镜，昨日少年今白头。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 276501,
      "title": "送宋处士归山",
      "content": [
        "卖药修琴归去迟，山风吹尽桂花枝。",
        "世间甲子须臾事，逢著仙人莫看棋。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276502,
      "title": "听琵琶",
      "content": [
        "欲写明妃万里情，紫槽红拨夜丁丁。",
        "胡沙望尽汉宫远，月落天山闻一声。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276503,
      "title": "秦楼曲",
      "content": [
        "秦女梦余仙路遥，月窗风簟夜迢迢。",
        "潘郎翠凤双飞去，三十六宫闻玉箫。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276504,
      "title": "旌儒庙",
      "content": [
        "寒陌阴风万古悲，儒冠相枕死秦时。",
        "庙前亦有商山路，不学老翁歌紫芝。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276505,
      "title": "览故人题僧院诗",
      "content": [
        "高阁清吟寄远公，四时云月一篇中。",
        "今来借问独何处，日暮槿花零落风。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276506,
      "title": "楚宫怨二首 一",
      "content": [
        "十二山晴花尽开，楚宫双阙对阳台。",
        "细腰争舞君沈醉，白日秦兵天上来。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276507,
      "title": "楚宫怨二首 二",
      "content": [
        "猎骑秋来在内稀，渚宫云雨湿龙衣。",
        "腾腾战鼓动城阙，江畔射麋殊未归。"
      ],
      "author": {
        "id": 4068,
        "name": "许浑"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    }
  ],
