{
  "data": [
    {
      "id": 372938,
      "title": "奉陪陆使君长源、裴端公枢春游东西武丘寺",
      "content": [
        "云水夹双刹，遥疑涌平陂。",
        "入门见藏山，元化何由窥。",
        "曳组探诡怪，停骢访幽奇。",
        "情高气为爽，德暖春亦随。",
        "瑶草自的皪，蕙楼争蔽亏。",
        "金精落坏陵，剑彩沈古池。",
        "一览匝天界，中峰步未移。",
        "应嘉生公石，列坐援松枝。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 372940,
      "title": "奉和崔中丞使君论李侍御萼登烂柯山宿石桥寺效小谢体",
      "content": [
        "常爱谢公郡，幽期愿相从。",
        "果回青骢臆，共蹑玄仙踪。",
        "灵境若仿佛，烂柯思再逢。",
        "飞梁丹霞接，古局苍苔封。",
        "往想冥昧理，谁亲冰雪容。",
        "蕙楼耸空界，莲宇开中峰。",
        "昔化冲虚鹤，今藏护法龙。",
        "云窥香树遝，月见色天重。",
        "永夜寄岑寂，清言涤心胸。",
        "盛游千年后，书在岩中松。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 372941,
      "title": "同颜使君真卿、李侍御萼游法华寺登凤翅山望太湖",
      "content": [
        "双峰开凤翅，秀出南湖州。",
        "地势抱郊树，山威增郡楼。",
        "正逢周柱史，来会鲁诸侯。",
        "缓步凌彩蒨，清铙发飕飗。",
        "披云得灵境，拂石临芳洲。",
        "积翠遥空碧，含风广泽秋。",
        "萧辰资丽思，高论惊精修。",
        "何似钟山集，征文及惠休。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 372942,
      "title": "奉陪陆使君长源诸公游支硎寺",
      "content": [
        "尝览高逸传，山僧有遗踪。",
        "佐游继雅篇，嘉会何由逢。",
        "尘世即下界，色天当上峰。",
        "春晖遍众草，寒色留高松。",
        "缭绕彩云合，参差绮楼重。",
        "琼葩洒巾舄，石de清心胸。",
        "灵境若可托，道情知所从。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 372943,
      "title": "奉陪郑使君谔游太湖至洞庭山登上真观却望湖水",
      "content": [
        "郡斋得无事，放舟下南湖。",
        "湖中见仙邸，果与心赏俱。",
        "不远风物变，忽如寰宇殊。",
        "背云视层崖，别是登蓬壶。",
        "突兀盘水府，参差遝天衢。",
        "回瞻平芜尽，洪流豁中区。",
        "气吞江山势，色净氛霭无。",
        "灵长习水德，胜势当地枢。",
        "朝宗动归心，万里思鸿途。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 372944,
      "title": "奉和袁使君高，郡中新亭会张炼师昼会二上人",
      "content": [
        "置亭隐城堞，事简迹易幽。",
        "公性崇俭素，雅才非广求。",
        "傍簷竹雨清，拂案杉风秋。",
        "不移府中步，登兹如远游。",
        "坐觉诗思高，俯知物役休。",
        "虚寂偶禅子，逍遥亲道流。",
        "更闻临川作，下节安能酬。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 372945,
      "title": "奉和陆使君长源水堂纳凉效曹刘体",
      "content": [
        "柳家陶暑亭，意远不可齐。",
        "烦襟荡朱弦，高步援绿荑。",
        "爱公满亭客，来是清风携。",
        "滢渟前溪上，旷望古郡西。",
        "六月正中伏，水轩气常凄。",
        "野香袭荷芰，道性亲凫鹥。",
        "禅子顾惠休，逸民重刘黎。",
        "乃知高世量，不以出处暌。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 372949,
      "title": "《奉和颜使君真卿修韵海》毕会诸文士东堂重校",
      "content": [
        "外学宗硕儒，游焉从后进。",
        "恃以仁恕广，不学门栏峻。",
        "著书裨理化，奉上表诚信。",
        "探讨始河图，纷纶归海韵。",
        "亲承大匠琢，况睹颓波振。",
        "错简记铅椠，阅书移玉镇。",
        "曷由旌不朽，盛美流歌引。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 372950,
      "title": "喜义兴权明府自君山至，集陆处士羽青塘别业",
      "content": [
        "应难久辞秩，暂寄君阳隐。",
        "已见县名花，会逢闱是粉。",
        "本自寻人至，宁因看竹引。",
        "身关白云多，门占春山尽。",
        "最赏无事心，篱边钓溪近。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 372953,
      "title": "和杨明府早秋游法华寺",
      "content": [
        "释事出县合，初闻兹山灵。",
        "寺扉隐天色，影刹遥丁丁。",
        "碧峰委合遝，香蔓垂蓂苓。",
        "清景为公有，放旷云边亭。",
        "秋赏石潭洁，夜嘉杉月清。",
        "诵空性不昧，助道迹又经。",
        "是以于物理，纷然若未形。",
        "移来字人要，全与此道冥。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 372957,
      "title": "奉同卢使君幼平游精舍寺",
      "content": [
        "影刹西方在，虚空翠色分。",
        "人天霁后见，猿鸟定中闻。",
        "真界隐青壁，春山凌白云。",
        "今朝石门会，千古仰斯文。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 372958,
      "title": "奉同颜使君真卿、袁侍御骆驼桥玩月",
      "content": [
        "山中常见月，不及共游时。",
        "水上恐将缺，林端爱落迟。",
        "乌惊宪府客，人咏鲍家诗。",
        "永夜南桥望，裴回若有期。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 372959,
      "title": "和邢端公登台春望句，句有春字之什",
      "content": [
        "春日绣衣轻，春台别有情。",
        "春烟间草色，春鸟隔花声。",
        "春树乱无次，春山遥得名。",
        "春风正飘荡，春瓮莫须倾。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 372961,
      "title": "独游二首",
      "content": [
        "性野趣无端，春晴路又干。",
        "逢泉破石弄，放鹤向云看。",
        "好僻谁相似，从狂我自安。",
        "芳洲亦有意，步上白沙滩。",
        "临水兴不尽，虚舟可同嬉。",
        "还云与归鸟，若共山僧期。",
        "世事吾不预，此心谁得知。",
        "西峰有禅老，应见独游时。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 372962,
      "title": "游溪待月",
      "content": [
        "溪色思泛月，沿洄欲未归。",
        "残灯逢水店，疏磬忆山扉。",
        "夜浦鱼惊少，空林鹊绕稀。",
        "可中才望见，撩乱捣寒衣。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 372963,
      "title": "西溪独泛",
      "content": [
        "道情何所寄，素舸漫流间。",
        "真性怜高鹤，无名羡野山。",
        "经寒丛竹秀，人静片云闲。",
        "泛泛谁为侣，唯应共月还。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 372965,
      "title": "九日陪颜使君真卿登水楼",
      "content": [
        "重阳荆楚尚，高会此难陪。",
        "偶见登龙客，同游戏马台。",
        "风文向水叠，云态拥歌回。",
        "持菊烦相问，扪襟愧不才。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 372967,
      "title": "自义亭驿送李长史纵，夜泊临平东湖",
      "content": [
        "长亭宾驭散，岐路起悲风。",
        "千里勤王事，驱车明月中。",
        "寒生洞庭水，夜度塞门鸿。",
        "处处堪伤别，归来山又空。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 372968,
      "title": "出游",
      "content": [
        "少时不见山，便觉无奇趣。",
        "狂发从乱歌，情来任闲步。",
        "此心谁共证，笑看风吹树。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 372969,
      "title": "界石守风，望天竺、灵隐二寺",
      "content": [
        "山顶东西寺，江中旦暮潮。",
        "归心不可到，松路在青霄。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 372970,
      "title": "《奉和颜使君真卿修韵海》毕，州中重宴",
      "content": [
        "世学高南郡，身封盛鲁邦。",
        "九流宗韵海，七字揖文江。",
        "借赏云归堞，留欢月在窗。",
        "不知名教乐，千载与谁双。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 372971,
      "title": "晦日陪颜使君白苹洲集",
      "content": [
        "南朝分古郡，山水似湘东。",
        "堤月吴风在，湔裾楚客同。",
        "桂寒初结旆，苹小欲成丛。",
        "时晦佳游促，高歌听未终。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 372974,
      "title": "新秋同卢侍御、薛员外白苹洲月夜",
      "content": [
        "隔暑苹洲近，迎凉欲泛舟。",
        "荣从宪府至，喜会夕郎游。",
        "气夺沧浪色，风欺汗漫流。",
        "谁言三伏夜，独此月前秋。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 372976,
      "title": "与王录事会张征君姊妹炼师院玩雪兼怀清会上人",
      "content": [
        "何意廉从事，还来会默仙。",
        "寒空惊雪遍，春意入歌偏。",
        "瑶草三花发，琼林七叶连。",
        "飘飖过柳寺，应满译经前。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 372977,
      "title": "和李侍御萼岁初夜集处士书阁",
      "content": [
        "迟贤新置阁，高意此郊居。",
        "古径行春早，新窗见月初。",
        "放歌还倚瑟，讲道亦观书。",
        "为我留禅位，来逢此会疏。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 372979,
      "title": "与朝阳山人张朝夜集湖亭，赋得各言其志",
      "content": [
        "洞庭孤月在，秋色望无边。",
        "零露积衰草，寒螀鸣古田。",
        "茫茫区中想，寂寂尘外缘。",
        "从此悟浮世，胡为伤暮年。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 372980,
      "title": "晦夜李侍御萼宅集招潘述、汤衡、海上人饮茶赋",
      "content": [
        "晦夜不生月，琴轩犹为开。",
        "墙东隐者在，淇上逸僧来。",
        "茗爱传花饮，诗看卷素裁。",
        "风流高此会，晓景屡裴回。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 372981,
      "title": "寄昱上人上方居",
      "content": [
        "厌向人间住，逢山欲懒归。",
        "片云闲似我，日日在禅扉。",
        "地静松阴遍，门空鸟语稀。",
        "夜凉疏磬尽，师友自相依。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 372982,
      "title": "夏日与綦毋居士、昱上人纳凉",
      "content": [
        "为依炉峰住，境胜增道情。",
        "凉日暑不变，空门风自清。",
        "坐援香实近，转爱绿芜生。",
        "宗炳青霞士，如何知我名。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 372983,
      "title": "建元寺集皇甫侍御书阁",
      "content": [
        "不因居佛里，无事得相逢。",
        "名重朝端望，身高俗外踪。",
        "机闲看净水，境寂听疏钟。",
        "宣室恩长在，知君志未从。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 372987,
      "title": "和阎士和李蕙冬夜重集",
      "content": [
        "郡理日闲旷，洗心宿香峰。",
        "双林秋见月，万壑静闻钟。",
        "佩玉行山翠，交麾动水容。",
        "如何股肱守，尘外得相从。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 372988,
      "title": "《春日陪颜使君真卿、皇甫曾西亭重会韵海》诸生",
      "content": [
        "为重南台客，朝朝会鲁儒。",
        "暄风众木变，清景片云无。",
        "峰翠飘簷下，溪光照座隅。",
        "不将簪艾隔，知与道情俱。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 372989,
      "title": "寒食日同陆处士行报德寺，宿解公房",
      "content": [
        "古寺章陵下，潜公住几年。",
        "安心生软草，灌顶引春泉。",
        "寂寂传灯地，寥寥禁火天。",
        "世间多暗室，白日为谁悬。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 372990,
      "title": "兵马曹季良宅夜集",
      "content": [
        "清景不可失，寻君趣有余。",
        "身高避事后，道长问心初。",
        "出处名则异，游从迹何疏。",
        "吟看刻尽烛，笑卷读残书。",
        "露彩生笔砚，风音入庭除。",
        "平明仙侣散，觳觫动回车。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 372991,
      "title": "同李侍御萼、李判官集陆处士羽新宅",
      "content": [
        "素风千户敌，新语陆生能。",
        "借宅心常远，移篱力更弘。",
        "钓丝初种竹，衣带近裁藤。",
        "戎佐推兄弟，诗流得友朋。",
        "柳阴容过客，花径许招僧。",
        "不为墙东隐，人家到未曾。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 372992,
      "title": "题报恩寺惟照上人房",
      "content": [
        "上界雨色干，凉宫日迟迟。",
        "水文披菡萏，山翠动罘罳。",
        "中有清真子，愔愔步闲墀。",
        "手萦颇黎缕，愿证黄金姿。",
        "旋草阶下生，看心当此时。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 372993,
      "title": "寻天目徐君",
      "content": [
        "常见仙翁变姓名，岂知松子号初平。",
        "逢人不道往来处，",
        "三花落地君犹在，笑抚安期昨日生。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 372994,
      "title": "同李著作纵题尘外上人院",
      "content": [
        "百缘唯有什公瓶，万法但看一字经。",
        "从遣鸟喧心不动，",
        "禅伴欲邀何著作，空音宜向夜中听。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 372995,
      "title": "题周谏别业",
      "content": [
        "隐身苕上欲如何，不著青袍爱绿萝。",
        "柳巷任疏容马入，",
        "若访禅斋遥可见，竹窗书幌共烟波。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 372996,
      "title": "同李中丞洪水亭夜集",
      "content": [
        "佳人但莫吹参差，正怜月色生酒卮。",
        "山公取醉不关我，为爱尊前白鹭鹚。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 372998,
      "title": "春夜集陆处士居玩月",
      "content": [
        "欲赏芳菲肯待辰，忘情人访有情人。",
        "西林可是无清景，只为忘情不记春。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 373001,
      "title": "冬日山行过薛征君",
      "content": [
        "我行倦修阪，四顾无平陆。",
        "雨霁鸣鹰鹯，天寒聚麋鹿。",
        "幽人访名士，家在南冈曲。",
        "菜实萦小园，稻花绕山屋。",
        "深居寡忧悔，胜境怡耳目。",
        "征心尚与我，永言谢浮俗。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 373002,
      "title": "往丹阳寻陆处士不遇",
      "content": [
        "远客殊未归，我来几惆怅。",
        "叩关一日不见人，",
        "行人无数不相识，独立云阳古驿边。",
        "凤翅山中思本寺，",
        "他日相期那可定，闲僧著处即经年。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 373006,
      "title": "题沈少府书斋",
      "content": [
        "不下南昌县，书斋每日闲。",
        "野花当砌落，溪鸟逐人还。",
        "有兴常临水，无时不见山。",
        "千峰数可尽，不出小窗间。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 373007,
      "title": "春夜与诸公同宴呈陆郎中",
      "content": [
        "南国宴佳宾，交情老倍亲。",
        "月惭红泪烛，花笑白头人。",
        "宝瑟縆余怨，琼枝不让春。",
        "更闻歌子夜，桃李艳妆新。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 373009,
      "title": "晚春寻桃源观",
      "content": [
        "武陵何处访仙乡，古观云根路已荒。",
        "细草拥坛人迹绝，",
        "全觉此身离俗境，玄机亦可照迷方。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 373012,
      "title": "奉陪杨使君顼送段校书赴南海幕",
      "content": [
        "硕贤静广州，信为天下贞。",
        "屈兹大将佐，藉彼延阁英。",
        "声动柳吴兴，郊饯意不轻。",
        "吾知段夫子，高论关苍生。",
        "处以德为藩，出则道可行。",
        "遥知南楼会，新景当诗情。",
        "天高林瘴洗，秋远海色清。",
        "时泰罢飞檄，唯应颂公成。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 373014,
      "title": "奉陪颜使君真卿登岘山，送张侍御严归台",
      "content": [
        "岘首千里情，北辕自兹发。",
        "烟霞正登览，簪笔限趋谒。",
        "黄鹤望天衢，白云归帝阙。",
        "客心南浦柳，离思西楼月。",
        "留赏景不延，感时芳易歇。",
        "他晨有山信，一为访林樾。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 373016,
      "title": "答道素上人别",
      "content": [
        "春色遍远道，寂寞闽中行。",
        "碧水何渺渺，白云亦英英。",
        "离人不可望，日暮芳洲情。",
        "黄鹤有逸翮，翘首白云倾。",
        "欲为山中侣，肯秘辽天声。",
        "蓝缕真子褐，葳蕤近臣缨。",
        "以兹夺尔怀，常恐道不成。",
        "吾门弟子中，不减惠休名。",
        "一性研已远，五言功更精。",
        "从君汗漫游，莫废学无生。",
        "忍草肯摇落，禅枝不枯荣。",
        "采采慰长路，知吾心不轻。",
        "幻情有去住，真性无离别。",
        "留取老桂枝，归来共攀折。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 373018,
      "title": "送穆寂赴举",
      "content": [
        "天子锡玄𫄸，倾山礼隐沦。",
        "君抛青霞去，荣资观国宾。",
        "剑光既陆离，琼彩何璘玢。",
        "夙驾别情远，商弦秋意新。",
        "冥冥鸿鹄姿，数尺看苍旻。",
        "残寇近宋郊，西行恶飙尘。",
        "立身素耿介，处难思经纶。",
        "春府搜才日，高科得一人。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 373019,
      "title": "送张彝归长沙",
      "content": [
        "早闻凌云彩，谓在鸳鹭俦。",
        "华发始相遇，沧江仍旅游。",
        "策名忘苟进，澹虑轻所求。",
        "常服远游诫，缅怀经世谋。",
        "片帆背风渚，万里还湘洲。",
        "别望荆云积，归心汉水流。",
        "兰苕行采采，桂棹思悠悠。",
        "宿昔无机者，为君动离忧。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 373020,
      "title": "秋日毗陵南寺送潘述之扬州",
      "content": [
        "孤客秋易伤，嘶蝉静仍续。",
        "佳晨亦已屡，欢会常不足。",
        "禅地非路岐，我心岂羁束。",
        "情生远别时，坐恨清景促。",
        "望中千里隔，暮归西山曲。",
        "萧条月中道，彩蒨原上绿。",
        "不见同心人，幽怀增踯躅。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 373021,
      "title": "春日又送潘述之扬州",
      "content": [
        "别渚望邗城，岐路春日遍。",
        "柔风吹杨柳，芳景流郊甸。",
        "日日东林期，今夕异乡县。",
        "文房旷佳士，禅室阻清盼。",
        "离恨夺赏心，不得谐所愿。",
        "莫忆山中人，碧云遥可见。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 373022,
      "title": "新秋送卢判官",
      "content": [
        "故人念宿昔，欲别增远情。",
        "入座炎气屏，为君秋景清。",
        "由来空山客，不怨离弦声。",
        "唯有暮蝉起，相思碧云生。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 373023,
      "title": "奉送袁高使君诏征赴行在，效曹刘体",
      "content": [
        "皇心亭毒广，蝥贼皆陶甄。",
        "未刈蚩尤旗，方同轩后年。",
        "天子幸汉中，轘辕阻氛烟。",
        "玺书召幕牧，名在列岳仙。",
        "国难倚长城，庙谋资大贤。",
        "清损休汝骑，仁留述职篇。",
        "遐路渺天末，繁笳思河边。",
        "饰徒促远期，祗命赴急宣。",
        "𫍲才岂足称，深仁顾何偏。",
        "那堪临流意，千里望旗旃。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 373024,
      "title": "奉送陆中丞长源诏征入朝",
      "content": [
        "诏下酂侯幕，征贤宠上勋。",
        "才当持汉典，道可致尧君。",
        "藩牧今荣饯，诗流此盛文。",
        "水从吴渚别，树向楚门分。",
        "宿寺期嘉月，看山识故云。",
        "归心复何奈，怊怅在江𣸣。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 373026,
      "title": "冬日送颜延之明府抚州觐叔父",
      "content": [
        "临川千里别，惆怅上津桥。",
        "日暮人归尽，山空雪未消。",
        "乡云心渺渺，楚水路遥遥。",
        "林下方欢会，山中独寂寥。",
        "天寒惊断雁，江信望回潮。",
        "岁晚流芳歇，思君在此宵。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 373035,
      "title": "送沈居士还太原",
      "content": [
        "辞官因世难，家族盛南朝。",
        "名重郊居赋，才高独酌谣。",
        "浪花飘一叶，峰色向三条。",
        "高逸虽成性，弓旌肯忘招。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 373037,
      "title": "兵后送姚太祝赴选",
      "content": [
        "两河兵已偃，处处见归舟。",
        "日夜故人散，江皋芳树秋。",
        "楚云伤远思，秦月忆佳游。",
        "名动春官籍，翩翩才少俦。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 373039,
      "title": "送邬傪之洪州觐兄弟",
      "content": [
        "年少足诗情，西江楚月清。",
        "书囊山翠湿，琴匣雪花轻。",
        "久别经离乱，新正忆弟兄。",
        "赠君题乐府，为是豫章行。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 373040,
      "title": "送干封李成",
      "content": [
        "羽檄飞未息，离情远近同。",
        "感君由泛瑟，关我是征鸿。",
        "眇默归人尽，疏芜夜渡空。",
        "还期当岁晚，独在路行中。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 373042,
      "title": "奉酬袁使君西楼饯秦山人与昼同赴李侍御招三韵",
      "content": [
        "秋风怨别情，江守上西城。",
        "竹署寒流浅，琴窗宿雨晴。",
        "治书招远意，知共楚狂行。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 373043,
      "title": "送清凉上人",
      "content": [
        "何意欲归山，道高由境胜。",
        "花空觉性了，月尽知心证。",
        "永夜出禅吟，清猿自相应。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 373046,
      "title": "送皇甫侍御曾还丹阳别业",
      "content": [
        "云阳别夜忆春耕，花发菱湖问去程。",
        "积水悠扬何处梦，",
        "朝右要君持汉典，明年北墅可须营。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 373047,
      "title": "白苹洲送洛阳李丞使还",
      "content": [
        "苹洲北望楚山重，千里回轺止一封。",
        "临水情来还共载，",
        "后会那应似畴昔，年年觉老雪山容。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 373051,
      "title": "送顾道士游洞庭山",
      "content": [
        "见说洞庭无上路，春游乱踏五灵芝。",
        "含桃风起花狼藉，正是仙翁棋散时。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 373053,
      "title": "送柳察谏议叔",
      "content": [
        "东城南陌强经过，怨别无心亦放歌。",
        "明日院公应问我，闲云长在石门多。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 373055,
      "title": "同李司直题武丘寺兼留诸公与陆羽之无锡",
      "content": [
        "陵寝成香阜，禅枝出白杨。",
        "剑池留故事，月树即他方。",
        "应世缘须别，栖心趣不忘。",
        "还将陆居士，晨发泛归航。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 373056,
      "title": "夏日题郑谷江上纳凉馆",
      "content": [
        "迢遥山意外，清风又对君。",
        "若为于此地，翻作路岐分。",
        "别馆琴徒语，前洲鹤自群。",
        "明朝天畔远，何处逐闲云。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 373059,
      "title": "早春送颜主簿游越东，兼谒元中丞",
      "content": [
        "轻舸趣不已，东风吹绿苹。",
        "欲看梅市雪，知赏柳家春。",
        "别意倾吴醑，芳声动越人。",
        "山阴三月会，内史得嘉宾。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 373060,
      "title": "同颜使君清明日游，因送萧主簿",
      "content": [
        "谁知赏嘉节，别意忽相和。",
        "暮色汀洲遍，春情杨柳多。",
        "高城恋旌旆，极浦宿风波。",
        "惆怅支山月，今宵不再过。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 373062,
      "title": "送裴邕之上京",
      "content": [
        "辞山偶世清，挟策忽西行。",
        "帆过随江疾，衣沾楚雪轻。",
        "尚文须献赋，重道莫论兵。",
        "东观今多事，应高白马生。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 373063,
      "title": "送珍上人还天竺，兼寄广通上人、秦山人",
      "content": [
        "江寺名天竺，多居蹑远踪。",
        "春帆依柳浦，轻履上莲峰。",
        "禅子兼三隐，空书共一封。",
        "因君达山信，应向白云逢。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 373070,
      "title": "送演上人之抚州觐使君叔",
      "content": [
        "临川内史怜诸谢，尔在生缘比惠宗。",
        "远别应将秦本去，",
        "便道须过大师寺，白莲池上访高踪。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 373071,
      "title": "送大宝上人归楚山",
      "content": [
        "厌上乌桥送别频，湖光烂熳望行人。",
        "欲将夜舸陪嘉月，",
        "从何得道怀惆怅，莫是人间屡见春。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 373072,
      "title": "送侯秀才南游",
      "content": [
        "芳草随君自有情，不关山色与猿声。",
        "为看严子滩头石，曾忆题诗不著名。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 373074,
      "title": "康造录事宅送太祝侄之虔吉访兄弟",
      "content": [
        "阮咸别曲四座愁，赖是春风不是秋。",
        "漫漫江行访兄弟，猿声几夜宿芦洲。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 373079,
      "title": "对陆迅饮天目山茶，因寄元居士晟",
      "content": [
        "喜见幽人会，初开野客茶。",
        "日成东井叶，露采北山芽。",
        "文火香偏胜，寒泉味转嘉。",
        "投铛涌作沫，著碗聚生花。",
        "稍与禅经近，聊将睡网赊。",
        "知君在天目，此意日无涯。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 373092,
      "title": "《奉陪颜使君修韵海》毕，东溪泛舟饯诸文士",
      "content": [
        "诸侯崇鲁学，羔雁日成群。",
        "外史刊新韵，中郎定古文。",
        "菁华兼百氏，缣素备三坟。",
        "国语思开物，王言欲致君。",
        "研精业已就，欢宴惜应分。",
        "独望西山去，将身寄白云。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 373095,
      "title": "雪夜送海上人常州觐叔父，上人殷仲文后",
      "content": [
        "继世风流在，传心向一灯。",
        "望云裁衲惯，玩雪步花能。",
        "交战情忘久，销魂别未曾。",
        "明朝阮家集，知有竹林僧。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 373105,
      "title": "送李秀才赴婺州招",
      "content": [
        "山开江色上，孤赏去应迟。",
        "绿水迎吴榜，秋风入楚词。",
        "猿清独宿处，木落远行时。",
        "见说东阳守，登楼为尔期。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 373107,
      "title": "送德守二叔侄上人还国清寺觐师",
      "content": [
        "道贤齐二阮，俱向竹林归。",
        "古偈穿花线，春装卷叶衣。",
        "僧墟回水寺，佛陇启山扉。",
        "爱别吾何有，人心强有违。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 373112,
      "title": "送唐赞善游越",
      "content": [
        "田园临汉水，离乱寄随关。",
        "今日烟尘尽，东西又未还。",
        "长亭百越外，孤棹五湖间。",
        "何处游芳草，云门千万山。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 373116,
      "title": "送李季良北归",
      "content": [
        "风吹残柳丝，孤客欲归时。",
        "掩抑楚弦绝，离披湘叶衰。",
        "前军犹转战，故国杳难期。",
        "北望雁门雪，空吟平子诗。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 373119,
      "title": "九日同卢使君幼平吴兴郊外送李司仓赴选",
      "content": [
        "重阳千骑出，送客为踟蹰。",
        "旷野多摇落，寒山满路隅。",
        "晴空悬蒨旆，秋色起菱湖。",
        "几日登司会，扬才盛五都。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 373120,
      "title": "送卢孟明还上都",
      "content": [
        "江皋北风至，归客独伤魂。",
        "楚水逢乡雁，平陵忆故园。",
        "征骖嘶别馆，落日隐寒原。",
        "应及秦川望，春华满国门。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 373123,
      "title": "送李道士",
      "content": [
        "常随山上下，忽限江南北。",
        "共是忘情人，何由肯相忆。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 373129,
      "title": "送孙侍御游越",
      "content": [
        "不知持斧客，吟会是何情。",
        "丹陛恩犹在，沧洲赏暂行。",
        "江桡随月泛，山策逐云行。",
        "佳句传零雨，诗流许盛名。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 373131,
      "title": "送还本上人游江西",
      "content": [
        "欲广分何教，心将江汉期。",
        "云招望寺处，月待溯杯时。",
        "真侣谁伤别，降猿汝自悲。",
        "多应过庐阜，幽赏却来迟。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 373133,
      "title": "于武原从送卢士举",
      "content": [
        "落日独归客，空山匹马嘶。",
        "萧条古关外，岐路更东西。",
        "大泽云寂寂，长亭雨凄凄。",
        "君还到湘水，寒夜满猿啼。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 373135,
      "title": "送裴秀才往会稽山读书",
      "content": [
        "一身赍万卷，编室寄烟萝。",
        "砚滴穿池小，书衣种楮多。",
        "吟诗山响答，泛瑟竹声和。",
        "鹤板求儒术，深居意若何。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
