    },
    {
      "id": 373136,
      "title": "送崔詹事论之上都",
      "content": [
        "金虎城池在，铜龙剑佩新。",
        "重看前浦柳，犹忆旧洲苹。",
        "远思秦云暮，归心腊月春。",
        "青园昔游处，惆怅别离人。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 373137,
      "title": "京口送卢孟明还扬州",
      "content": [
        "萧萧北风起，孤棹下江𣸣。",
        "暮客去来尽，春流南北分。",
        "萋萋御亭草，渺渺芜城云。",
        "相送目千里，空山独望君。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 373138,
      "title": "送沙弥大智游五台",
      "content": [
        "童年随法侣，家世本儒流。",
        "章句三生学，清凉万里游。",
        "云归龙沼暗，木落雁门秋。",
        "长老应相问，传予向祖州。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 373145,
      "title": "送如献上人游长安",
      "content": [
        "关中四子教犹存，见说新经待尔翻。",
        "为法应过七祖寺，",
        "高逸诗情无别怨，春游从遣落花繁。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 373146,
      "title": "日曜上人还润州",
      "content": [
        "送君何处最堪思，孤月停空欲别时。",
        "露茗犹芳邀重会，",
        "莫倚禅功放心定，萧家陵树误人悲。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 373149,
      "title": "答裴评事澄荻花间送梁肃拾遗",
      "content": [
        "波上荻花非雪花，风吹撩乱满袈裟。",
        "如今岁晏无芳草，独对离樽作物华。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 373151,
      "title": "诮士和别",
      "content": [
        "今日同，明日隔，何事悠悠久为客。",
        "君怜溪上去来云，"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 373155,
      "title": "答胡处士",
      "content": [
        "西山禅隐比来闻，长道唯应我与君。",
        "书上无名心忘却，人间聚散似浮云。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
