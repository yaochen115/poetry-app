{
  "data": [
    {
      "id": 255159,
      "title": "横吹曲辞 出塞 一",
      "content": [
        "秦时明月汉时关，万里长征人未还。",
        "但使龙城飞将在，不教胡马度阴山。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 255160,
      "title": "横吹曲辞 出塞 二",
      "content": [
        "白花垣上望京师，黄河水流无尽时。",
        "穷秋旷野行人绝，马首东来知是谁。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 255340,
      "title": "相和歌辞 长歌行",
      "content": [
        "旷野饶悲风，飕飕黄蒿草。",
        "系马停白杨，谁知我怀抱。",
        "所是同袍者，相逢尽衰老。",
        "况登汉家陵，南望长安道。",
        "下有枯树根，上有鼷鼠窠。",
        "高皇子孙尽，千古无人过。",
        "宝玉频发掘，精灵其奈何？",
        "人生须达命，有酒且长歌。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 255405,
      "title": "相和歌辞 从军行",
      "content": [
        "向夕临大荒，朔风轸归虑。",
        "平沙万里余，飞鸟宿何处？",
        "虏骑猎长原，翩翩傍河去。",
        "边声摇白草，海气生黄雾。",
        "百战苦风尘，十年履霜露。",
        "虽投定远笔，未坐将军树。",
        "早知行路难，悔不理章句。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 255406,
      "title": "相和歌辞 从军行 二",
      "content": [
        "烽火城西百尺楼，黄昏独上海风秋。",
        "更吹横笛关山月，谁解金闺万里愁。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 255407,
      "title": "相和歌辞 从军行 三",
      "content": [
        "琵琶起舞换新声，总是关山旧别情。",
        "撩乱边愁弹不尽，高高秋月下长城。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 255408,
      "title": "相和歌辞 从军行 四",
      "content": [
        "青海长云暗雪山，孤城遥望雁门关。",
        "黄沙百战穿金甲，不破楼兰终不还。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 255478,
      "title": "相和歌辞 放歌行",
      "content": [
        "南渡洛阳津，西望十二楼。",
        "明堂坐天子，月朔朝诸侯。",
        "清乐动千门，皇风被九州。",
        "庆云从东来，泱漭抱日流。",
        "升平贵论道，文墨将何求。",
        "有诏征草泽，微臣献谋猷。",
        "冠冕如星罗，拜揖曹与周。",
        "望尘非吾事，入赋且迟留。",
        "幸蒙国士识，因脱负薪裘。",
        "今者放歌行，以慰梁父愁。",
        "但营数斗禄，奉养毋丰羞。",
        "若得金膏遂，飞云亦可俦。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 255567,
      "title": "相和歌辞 长信怨 一",
      "content": [
        "金井梧桐秋叶黄，珠帘不卷夜来霜。",
        "金炉玉枕无颜色，卧听南宫清漏长。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 255568,
      "title": "相和歌辞 长信怨 二",
      "content": [
        "奉帚平明金殿开，暂将团扇共裴回。",
        "玉颜不及寒鵶色，犹带昭阳日影来。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 255672,
      "title": "相和歌辞 采莲曲三首 一",
      "content": [
        "吴姬越艳楚王妃，争弄莲舟水湿衣。",
        "来时浦口花迎入，采罢江头月送归。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 255673,
      "title": "相和歌辞 采莲曲三首 二",
      "content": [
        "荷叶罗裙一色裁，芙蓉向脸两边开。",
        "乱入池中看不见，闻歌始觉有人来。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 255674,
      "title": "相和歌辞 采莲曲三首 三",
      "content": [
        "越女作桂舟，还将桂为檝。",
        "湖上水渺漫，清江初可涉。",
        "摘取芙蓉花，莫摘芙蓉叶。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 255905,
      "title": "杂曲歌辞 少年行二首 一",
      "content": [
        "西陵侠年少，送客过长亭。",
        "青槐夹两路，白马如流星。",
        "闻道羽书急，单于寇井陉。",
        "气高轻赴难，谁顾燕山铭。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 255906,
      "title": "杂曲歌辞 少年行二首 二",
      "content": [
        "走马还相寻，西楼下夕阴。",
        "结交期一劒，留意赠千金。",
        "高阁歌声远，重关柳色深。",
        "夜闲须尽醉，莫负百年心。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 256033,
      "title": "杂曲歌辞 变行路难",
      "content": [
        "向晚横吹悲，风动马嘶合。",
        "前驱引旗节，千重阵云帀。",
        "单于下阴山，砂砾空飒飒。",
        "封侯取一战，岂复念闺合。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 297466,
      "title": "上马当山神",
      "content": [
        "青骢一匹昆仑牵，奏上大王不取钱。",
        "直为猛风波滚骤，莫怪昌龄不下船。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 299173,
      "title": "旅次盩厔过韩士别业",
      "content": [
        "春烟桑柘林，落日隐荒墅。",
        "泱漭平原夕，清吟久延伫。",
        "故人家于此，招我渔樵所。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 299174,
      "title": "上侍御士兄",
      "content": [
        "天人俟明路，益稷分尧心。",
        "利器必先举，非贤安可任。",
        "吾兄执严宪，时佐能钓深。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 299175,
      "title": "上同州使君伯",
      "content": [
        "大贤本孤立，有时起丝纶。",
        "伯父自天禀，元功载生人。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 299176,
      "title": "留别",
      "content": [
        "桑林映陂水，雨过宛城西。",
        "留醉楚山别，阴云暮霋霋。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 299177,
      "title": "赠李侍御",
      "content": [
        "青冥孤云去，终当暮归山。",
        "志士杖苦节，何时见龙颜。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 299178,
      "title": "又赠李侍御",
      "content": [
        "渺然客子魂，倏铄川上晖。",
        "还云惨知暮，九月仍未归。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 299179,
      "title": "送别",
      "content": [
        "春江愁送君，蕙草生氤氲。",
        "醉后不能语，乡山雨雰雰。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 299180,
      "title": "失题",
      "content": [
        "时与醉林壑，因之堕农桑。",
        "槐烟渐含夜，楼月深苍茫。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 299181,
      "title": "失题",
      "content": [
        "桑叶下墟落，鹍鸡鸣渚田。",
        "物情每衰极，吾道方渊然。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 299182,
      "title": "句",
      "content": [
        "与君远相知，不道云海深。",
        "得罪由己招，本性易然诺。",
        "黄叶乱秋雨，空斋愁暮心。",
        "通经彼上人，无迹任勤苦。",
        "枫桥延海岸，客帆归富春。",
        "寒江映村林，亭上纳高洁。",
        "陵薮寒苍茫，登城遂怀古。",
        "孤烟曳长林，春水聊一望。",
        "河口饯南客，进帆清江水。",
        "迁客又相送，风悲蝉更号。",
        "微雨随云收，蒙蒙傍山去。",
        "海客时独飞，永然沧洲意。",
        "日夕辨灵药，空山松桂香。",
        "墟落有怀县，长烟溪树边。",
        "青桂花未吐，江中独鸣琴。",
        "还家望炎海，楚叶下秋水。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 300408,
      "title": "城旁□□[一]伯二五六七下同",
      "content": [
        "降奚能骑射，战马百余匹，甲仗明寒川，霜□□□□。",
        "□□煞单于，薄暮红旗出。",
        "城旁粗少年，骤马垂长鞭，脱却□□□，□剑沦秋天。",
        "（项云「沦」疑当作「轮」，同抡。",
        "）匈奴不敢出，漠北开（闭）[三]甲烟。",
        "（[一]标题残去二三字。",
        "按《全唐诗》昌龄有《城旁曲》，但内容与此全异。",
        "[二]余疑「开」为「闭」误，俞云：「烟尘四合则虏起，今匈奴不出，故开霁也。",
        "依平仄论亦宜平声字，「开」字不误。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 300409,
      "title": "题净眼师房",
      "content": [
        "白鸽飞时日欲斜，禅房寂历饮香茶。",
        "倾人城，倾人国，斩新剃头青且黑。",
        "玉如意，金澡瓶，朱唇皓齿能诵经，吴音唤字更分明。",
        "日暮钟声相送出，袈裟挂着箔帘钉。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 301463,
      "title": "送李邕之秦",
      "content": [
        "空（《文镜秘府论》地《十七势》，《全唐诗》作《送李十五》。",
        "《文镜秘府》首句「怨别」作「别怨」，三句「杳」作「梦」，四句「影」作「映」。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 303075,
      "title": "吊轵道赋附邵平歌",
      "content": [
        "道不虚行兮，史䲡没位，吾宁范伯之徒欤，感夷齐而多愧。",
        "麟凤远去，龙则死之，河水洋洋兮，先师莫归。",
        "往者不可谏，来者吾谁欺？",
        "始退身以进道，曷飏言而受非，彼萧相国知予乎布衣。",
        "（见《文苑英华》卷一三○）。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 303076,
      "title": "云山清晓",
      "content": [
        "苍深翠浅瀑峥潺，岂谓讥秦始爱山。",
        "一炬咸阳机冢赤，紫霄巍立晓云间。",
        "（见《古今图书集成·山川典》卷一七三。",
        "此首当出后人依托。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 303077,
      "title": "四时调玉烛",
      "content": [
        "祥光长赫矣，佳号得温其。",
        "（见宋葛立方《韵语阳秋》卷三）。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 303078,
      "title": "梅诗",
      "content": [
        "落落寞寞路不分，梦中唤作梨花云。",
        "（见《苕溪渔隐丛话前集》卷四、《野客丛书》卷六引曾慥《高斋诗话》、龙榆生《东坡乐府笺》卷二《西江月》注引南宋傅藻注引。",
        "）（按：《墨庄漫录》卷六载此诗全篇，以为王建作，详本书卷十八。",
        "然曾慥时代较早，当有所据。",
        "苏轼《西江月》词末句云：「不与梨花同梦。",
        "」自跋云：「诗人王昌龄梦中作梅花诗。",
        "」傅注因引此二句。",
        "其时代较曾慥更早。",
        "今互收。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 303079,
      "title": "送别",
      "content": [
        "河口饯南客，进帆清江水。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 303080,
      "title": "送友人之安南",
      "content": [
        "还舟望炎海，楚叶下秋水。",
        "（均见《文镜秘府论》地卷《十七势》引王昌龄《诗格》。",
        "市河世宁《全唐诗逸》卷上收四句，缺题，今重录。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 303081,
      "title": "句（附存）",
      "content": [
        "王维诗天子，杜甫诗宰相。",
        "（见宋叶廷珪《海录碎事》卷十九引《王昌龄集》。",
        "似出后人依托。",
        "）（按：《全唐诗》卷一四一收昌龄《小敷谷龙潭祠作》，第十九句缺一字。",
        "汲克阁本《唐诗纪事》卷二四引此诗不缺，此句作「奔飞振串梁」。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 308540,
      "title": "变行路难",
      "content": [
        "向晚横吹悲，风动马嘶合。",
        "前趋引旗节，千里阵云帀。",
        "单于下阴山，砂砾空飒飒。",
        "封侯取一战，岂复念闺合。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 308541,
      "title": "塞下曲四首 一",
      "content": [
        "蝉鸣空桑林，八月萧关道。",
        "出塞入塞寒，处处黄芦草。",
        "从来幽幷客，皆共尘沙老。",
        "莫学游侠儿，矜夸紫骝好。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 308542,
      "title": "塞下曲四首 二",
      "content": [
        "饮马渡秋水，水寒风似刀。",
        "平沙日未没，黯黯见临洮。",
        "昔日长城战，咸言意气高。",
        "黄尘足今古，白骨乱蓬蒿。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 308543,
      "title": "塞下曲四首 三",
      "content": [
        "奉诏甘泉宫，总征天下兵。",
        "朝廷备礼出，郡国豫郊迎。",
        "纷纷几万人，去者无全生。",
        "臣愿节宫廐，分以赐边城。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 308544,
      "title": "塞下曲四首 四",
      "content": [
        "边头何惨惨，已葬霍将军。",
        "部曲皆相吊，燕南代北闻。",
        "功勋多被黜，兵马亦寻分。",
        "更遣黄龙戍，唯当哭塞云。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 308545,
      "title": "塞上曲",
      "content": [
        "秋风夜渡河，吹却鴈门桑。",
        "遥见胡地猎，鞲马宿严霜。",
        "五道分兵去，孤军百战场。",
        "功多翻下狱，士卒但心伤。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 308546,
      "title": "从军行二首 一",
      "content": [
        "向夕临大荒，朔风轸归虑。",
        "平沙万里余，飞鸟宿何处？",
        "虏骑猎长原，翩翩傍河去。",
        "边声摇白草，海气生黄雾。",
        "百战苦风尘，十年履霜露。",
        "虽投定远笔，未坐将军树。",
        "早知行路难，悔不理章句。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 308547,
      "title": "从军行二首 二",
      "content": [
        "秋草马蹄轻，角弓持弦急。",
        "去为龙城战，正值胡兵袭。",
        "军气横大荒，战酣日将入。",
        "长风金鼓动，白露铁衣湿。",
        "四起愁边声，南庭时伫立。",
        "断蓬孤自转，寒雁飞相及。",
        "万里云沙涨，平原冰霰涩。",
        "惟闻汉使还，独向刀环泣。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 308548,
      "title": "少年行二首 一",
      "content": [
        "西陵侠少年，送客短长亭。",
        "青槐夹两道，白马如流星。",
        "闻道羽书急，单于寇井陉。",
        "气高轻赴难，谁顾燕山铭。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 308549,
      "title": "少年行二首 二",
      "content": [
        "走马远相寻，西楼下夕阴。",
        "结交期一劒，留意赠千金。",
        "高阁歌声远，重门柳色深。",
        "夜阑须尽饮，莫负百年心。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 308550,
      "title": "长歌行",
      "content": [
        "旷野饶悲风，飕飕黄蒿草。",
        "系马倚白杨，谁知我怀抱。",
        "所是同袍者，相逢尽衰老。",
        "北登汉家陵，南望长安道。",
        "下有枯树根，上有鼯鼠窠。",
        "高皇子孙尽，千载无人过。",
        "宝玉频发掘，精灵其奈何？",
        "人生须达命，有酒且长歌。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 308551,
      "title": "悲哉行",
      "content": [
        "勿听白头吟，人间易忧怨。",
        "若非沧浪子，安得从所愿。",
        "北上太行山，临风阅吹万。",
        "长云数千里，倏忽还肤寸。",
        "观其微灭时，精意莫能论。",
        "百年不容息，是处生意蔓。",
        "始悟海上人，辞君永飞遯。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 308552,
      "title": "古意",
      "content": [
        "桃花四面发，桃叶一枝开。",
        "欲暮黄鹂啭，伤心玉镜台。",
        "清筝向明月，半夜春风来。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 308553,
      "title": "放歌行",
      "content": [
        "南渡洛阳津，西望十二楼。",
        "明堂坐天子，月朔朝诸侯。",
        "清乐动千门，皇风被九州。",
        "庆云从东来，泱漭抱日流。",
        "升平贵论道，文墨将何求？",
        "有诏征草泽，微诚将献谋。",
        "冠冕如星罗，拜揖曹与周。",
        "望尘非吾事，入赋且迟留。",
        "幸蒙国士识，因脱负薪裘。",
        "今者放歌行，以慰梁甫愁。",
        "但营数斗禄，奉养每丰羞。",
        "若得金膏遂，飞云亦何俦。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 308554,
      "title": "越女",
      "content": [
        "越女作桂舟，还将桂为楫。",
        "湖上水渺漫，清江不可涉。",
        "摘取芙蓉花，莫摘芙蓉叶。",
        "将归问夫壻，颜色何如妾。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 308555,
      "title": "郑县宿陶太公馆中赠冯六元二",
      "content": [
        "儒有轻王侯，脱略当事务。",
        "本家蓝田下，非为渔弋故。",
        "无何困躬耕，且欲驰永路。",
        "幽居与君近，出谷同所骛。",
        "昨日辞石门，五年变秋露。",
        "云龙未相感，干谒亦已屡。",
        "子为黄绶羁，余忝蓬山顾。",
        "京门望西岳，百里见郊树。",
        "飞雨祠上来，霭然关中暮。",
        "驱车郑城宿，秉烛论往素。",
        "山月出华阴，开此河渚雾。",
        "清光比故人，豁达展心晤。",
        "冯公尚戢翼，元子仍跼步。",
        "拂衣易为高，沦迹难有趣。",
        "张范善终始，吾等岂不慕。",
        "罢酒当凉风，屈伸备冥数。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 308556,
      "title": "听弹风入松阕赠杨补阙",
      "content": [
        "商风入我弦，夜竹深有露。",
        "弦悲与林寂，清景不可度。",
        "寥落幽居心，飕飗青松树。",
        "松风吹草白，溪水寒日暮。",
        "声意去复还，九变待一顾。",
        "空山多雨雪，独立君始悟。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 308557,
      "title": "缑氏尉沈兴宗置酒南谿留赠",
      "content": [
        "林色与溪古，深篁引幽翠。",
        "山尊在渔舟，棹月情已醉。",
        "始穷清源口，壑绝人境异。",
        "春泉滴空崖，萌草拆阴地。",
        "久之风榛寂，远闻樵声至。",
        "海雁时独飞，永然沧洲意。",
        "古时青冥客，灭迹沦一尉。",
        "吾子踌躇心，岂其纷埃事。",
        "缑峰信所克，济北余乃遂。",
        "齐物意已会，息肩理犹未。",
        "卷舒形性表，脱略贤哲议。",
        "仲月期角巾，饭僧嵩阳寺。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 308558,
      "title": "为张僓赠阎使臣",
      "content": [
        "哀哀献玉人，楚国同悲辛。",
        "泣尽继以血，何由辨其真。",
        "赖承琢磨惠，复使光辉新。",
        "犹畏谗口疾，弃之如埃尘。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 308559,
      "title": "赠史昭",
      "content": [
        "东林月未升，廓落星与汉。",
        "是夕鸿始来，斋中起长叹。",
        "怀哉望南浦，眇然夜将半。",
        "但有秋水声，愁使心神乱。",
        "握中何为赠，瑶草已衰散。",
        "海鳞未化时，各在天一岸。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 308560,
      "title": "秋山寄陈谠言",
      "content": [
        "岩间寒事早，众山木已黄。",
        "北风何萧萧，兹夕露为霜。",
        "感激未能寐，中宵时慨慷。",
        "黄虫初悲鸣，玄鸟去我梁。",
        "独卧时易晚，离群情更伤。",
        "思君若不及，鸿雁今南翔。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 308561,
      "title": "出郴山口至叠石湾野人室中寄张十一",
      "content": [
        "槠柟无冬春，柯叶连峰稠。",
        "阴壁下苍黑，烟含清江楼。",
        "景开独沿曳，响答随兴酬。",
        "旦夕望吾友，如何迅孤舟。",
        "叠沙积为岗，崩剥雨露幽。",
        "石脉尽横亘，潜潭何时流。",
        "既见万古色，颇尽一物由。",
        "永与世人远，气还草木收。",
        "盈缩理无余，今往何必忧。",
        "郴土群山高，耆老如中州。",
        "孰云议舛降，岂是娱宦游。",
        "阴火昔所伏，丹砂将尔谋。",
        "昨临苏耽井，复向衡阳求。",
        "同疚来相依，脱身当有筹。",
        "数月乃离居，风湍成阻修。",
        "野人善竹器，童子能谿讴。",
        "寒夜波荡漾，羇鸿去悠悠。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 308562,
      "title": "宿灞上寄侍御玙弟",
      "content": [
        "独饮灞上亭，寒山青门外。",
        "长云骤落日，桑枣寂已晦。",
        "古人驱驰者，宿此凡几代。",
        "佐邑由东南，岂不知进退。",
        "吾宗秉全璞，楚得璆琳最。",
        "茅山就一征，柏署起三载。",
        "道契非物理，神交无留碍。",
        "知我沧溟心，脱略腐儒辈。",
        "孟冬銮舆出，阳谷群臣会。",
        "半夜驰道喧，五侯拥轩盖。",
        "是时燕齐客，献术蓬瀛内。",
        "甚悦我皇心，得与王母对。",
        "贱臣欲干谒，稽首期殒碎。",
        "哲弟感我情，问易穷否泰。",
        "良马足尚踠，宝刀光未淬。",
        "昨闻羽书飞，兵气连朔塞。",
        "诸将多失律，庙堂始追悔。",
        "安能召书生，愿得论要害。",
        "戎夷非草木，侵逐使狼狈。",
        "虽有屠城功，亦有降虏辈。",
        "兵粮如山积，恩泽如雨霈。",
        "羸卒不可兴，碛地无足爱。",
        "若用匹夫策，坐令军围溃。",
        "不费黄金资，宁求白璧赉。",
        "明主忧既远，边事亦可大。",
        "荷宠务推诚，离言深慷慨。",
        "霜摇直指草，烛引明光珮。",
        "公论日夕阻，朝廷磋跎会。",
        "孤城海门月，万里流光带。",
        "不应百尺松，空老钟山霭。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 308563,
      "title": "次汝中寄河南陈赞府",
      "content": [
        "汝山方联延，伊水才明灭。",
        "遥见入楚云，又此空馆月。",
        "纷然驰梦想，不谓远离别。",
        "京邑多欢娱，衡湘𫏐沿越。",
        "明湖春草遍，秋桂白花发。",
        "岂惟长思君，日夕在魏阙。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 308564,
      "title": "同从弟销南斋玩月忆山阴崔少府",
      "content": [
        "高卧南斋时，开帷月初吐。",
        "清辉淡水木，演漾在窗户。",
        "苒苒几盈虚，澄澄变今古。",
        "美人清江畔，是夜越吟苦。",
        "千里其如何，微风吹兰杜。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 308565,
      "title": "代扶风主人答",
      "content": [
        "杀气凝不流，风悲日彩寒。",
        "浮埃起四远，游子弥不欢。",
        "依然宿扶风，沽酒聊自宽。",
        "寸心亦未理，长铗谁能弹。",
        "主人就我饮，对我还慨叹。",
        "便泣数行泪，因歌行路难。",
        "十五役边地，三回讨楼兰。",
        "连年不解甲，积日无所餐。",
        "将军降匈奴，国使没桑干。",
        "去时三十万，独自还长安。",
        "不信沙场苦，君看刀箭瘢。",
        "乡亲悉零落，冢墓亦摧残。",
        "仰攀青松枝，恸绝伤心肝。",
        "禽兽悲不去，路傍谁忍看。",
        "幸逢休明代，寰宇静波澜。",
        "老马思伏枥，长鸣力已殚。",
        "少年与运会，何事发悲端。",
        "天子初封禅，贤良刷羽翰。",
        "三边悉如此，否泰亦须观。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 308566,
      "title": "酬鸿胪裴主簿雨后北楼见赠",
      "content": [
        "暮霞照新晴，归云犹相逐。",
        "有怀晨昏暇，想见登眺目。",
        "问礼侍彤襜，题诗访茅屋。",
        "高楼多古今，陈事满陵谷。",
        "地久微子封，台余孝王筑。",
        "裴回顾霄汉，豁达俯川陆。",
        "远水对孤城，长天向乔木。",
        "公门何清静，列戟森已肃。",
        "不叹携手稀，常思著鞭速。",
        "终当拂羽翰，轻举随鸿鹄。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 308567,
      "title": "送任五之桂林",
      "content": [
        "楚客醉孤舟，越水将引棹。",
        "山为两乡别，月带千里貌。",
        "羇谴同缯纶，僻幽闻虎豹。",
        "桂林寒色在，苦节知所效。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 308568,
      "title": "山中别庞十",
      "content": [
        "幽娟松筿径，月出寒蝉鸣。",
        "散发卧其下，谁知孤隐情。",
        "吟时白云合，钓处玄潭清。",
        "琼树方杳霭，凤兮保其贞。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 308569,
      "title": "留别伊阙张少府郭大都尉",
      "content": [
        "迁客就一醉，主人空金罍。",
        "江湖青山底，欲去仍裴回。",
        "郭侯未相识，策马伊川来。",
        "把手相劝勉，不应老尘埃。",
        "孟阳逢山旧，仙馆留清才。",
        "日晚劝趣别，风长云逐开。",
        "幸随板舆远，负谴何忧哉。",
        "唯有仗忠信，音书报云雷。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 308570,
      "title": "送韦十二兵曹",
      "content": [
        "县职如长缨，终日检我身。",
        "平明趋郡府，不得展故人。",
        "故人念江湖，富贵如埃尘。",
        "迹在戎府掾，心游天台春。",
        "独立浦边鹤，白云长相亲。",
        "南风忽至吴，分散还入秦。",
        "寒夜天光白，海净月色真。",
        "对坐论岁暮，弦悲岂无因。",
        "平生驰驱分，非谓桮酒仁。",
        "出处两不合，忠贞何由伸。",
        "看君孤舟去，且欲歌垂纶。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 308571,
      "title": "东京府县诸公与綦毋潜李颀相送至白马寺宿",
      "content": [
        "鞍马上东门，裴回入孤舟。",
        "贤豪相追送，即櫂千里流。",
        "赤岸落日在，空波微烟收。",
        "薄宦忘机括，醉来即淹留。",
        "月明见古寺，林外登高楼。",
        "南风开长廊，夏夜如凉秋。",
        "江月照吴县，西归梦中游。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 308572,
      "title": "送东林廉上人归庐山",
      "content": [
        "石溪流已乱，苔径人渐微。",
        "日暮东林下，山僧还独归。",
        "昔为庐峰意，况与远公违。",
        "道性深寂寞，世情多是非。",
        "会寻名山去，岂复望清辉。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 308573,
      "title": "留别武陵袁丞",
      "content": [
        "皇恩暂迁谪，待罪逢知己。",
        "从此武陵溪，孤舟二千里。",
        "桃花遗古岸，金涧流春水。",
        "谁识马将军，忠贞抱生死。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 308574,
      "title": "别刘谞",
      "content": [
        "天地寒更雨，苍茫楚城阴。",
        "一尊广陵酒，十载衡阳心。",
        "倚仗不可料，悲欢岂易寻。",
        "相逢成远别，后会何如今。",
        "身在江海上，云连京国深。",
        "行当务功业，策马何骎骎。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 308575,
      "title": "岳阳别李十七越宾",
      "content": [
        "相逢楚水寒，舟在洞庭驿。",
        "具陈江波事，不异沦弃迹。",
        "杉上秋雨声，悲切蒹葭夕。",
        "弹琴收余响，来送千里客。",
        "平明孤帆心，岁晚济代策。",
        "时在身未充，潇湘不盈画。",
        "湖小洲渚联，澹淡烟景碧。",
        "鱼鳖自有性，龟龙无能易。",
        "谴黜同所安，风土任所适。",
        "闭门观玄化，携手遗损益。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 308576,
      "title": "留别岑参兄弟",
      "content": [
        "江城建业楼，山尽沧海头。",
        "副职守兹县，东南櫂孤舟。",
        "长安故人宅，秣马经前秋。",
        "便以风雪暮，还为纵饮留。",
        "貂蝉七叶贵，鸿鹄万里游。",
        "何必念钟鼎，所在烹肥牛。",
        "为君啸一曲，且莫弹箜篌。",
        "徒见枯者艳，谁言直如钩。",
        "岑家双琼树，腾光难为俦。",
        "谁言青门悲，俯期吴山幽。",
        "日西石门峤，月吐金陵洲。",
        "追随探灵怪，岂不骄王侯。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 308577,
      "title": "送刘眘虚归取宏词解",
      "content": [
        "太清闻海鹤，游子引乡眄。",
        "声随羽仪远，势与归云便。",
        "青桂春再荣，白云暮来变。",
        "迁飞在礼仪，岂复泪如霰。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 308578,
      "title": "巴陵别刘处士",
      "content": [
        "刘生隐岳阳，心远洞庭水。",
        "偃帆入山郭，一宿楚云里。",
        "竹映秋馆深，月寒江风起。",
        "烟波桂阳接，日夕数千里。",
        "袅袅清夜猿，孤舟坐如此。",
        "湘中有来鴈，雨雪候音旨。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 308579,
      "title": "宿裴氏山庄",
      "content": [
        "苍苍竹林暮，吾亦知所投。",
        "静坐山斋月，清溪闻远流。",
        "西峰下微雨，向晓白云收。",
        "遂解尘中组，终南春可游。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 308580,
      "title": "淇上酬薛据兼寄郭微",
      "content": [
        "自从别京华，我心乃萧索。",
        "十年守章句，万里空寥落。",
        "北上登蓟门，茫茫见沙漠。",
        "倚劒对风尘，慨然思衞霍。",
        "拂衣去燕赵，驱马怅不乐。",
        "天长沧洲路，日暮邯郸郭。",
        "酒肆或淹留，渔泽屡栖泊。",
        "独行备艰难，孰辞千鼎镬。",
        "皇情念淳古，时俗何浮薄。",
        "理道须任贤，安人在求瘼。",
        "故交负奇才，逸气包謇谔。",
        "隐轸经济策，纵横建安作。",
        "才望忽先鸣，风期无宿诺。",
        "飘飖劳州县，迢递限言谑。",
        "东驰眇贝丘，西顾弥虢略。",
        "淇水徒自深，浮云不堪托。",
        "吾谋适可用，天道岂辽廓。",
        "不然买山田，一身与耕凿。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 308581,
      "title": "咏史",
      "content": [
        "荷畚至洛阳，杖策游北门。",
        "天下尽兵甲，豺狼满中原。",
        "明夷方遘患，顾我徒崩犇。",
        "自慙菲薄才，误蒙国士恩。",
        "位重任亦重，时危志弥敦。",
        "西北未及终，东南不可吞。",
        "进则耻保躬，退乃为触藩。",
        "叹息嵩山老，而后知其尊。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 308582,
      "title": "杂兴",
      "content": [
        "握中铜匕首，粉剉楚山铁。",
        "义士频报雠，杀人不曾缺。",
        "可悲燕丹事，终被狼虎灭。",
        "一举无两全，荆轲遂为血。",
        "诚知匹夫勇，何取万人杰。",
        "无道吞诸侯，坐见九州裂。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 308583,
      "title": "秋兴",
      "content": [
        "日暮西北堂，凉风洗修木。",
        "著书在南窗，门馆常肃肃。",
        "苔草延古意，视听转幽独。",
        "或问余所营，刈黍就寒谷。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 308584,
      "title": "斋心",
      "content": [
        "女萝覆石壁，溪水幽蒙胧。",
        "紫葛蔓黄花，娟娟寒露中。",
        "朝饮花上露，夜卧松下风。",
        "云英化为水，光采与我同。",
        "日月荡精魄，寥寥天宇空。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 308585,
      "title": "独游",
      "content": [
        "林卧情每闲，独游景常晏。",
        "时从灞陵下，垂钓往南涧。",
        "手携双鲤鱼，目送千里鴈。",
        "悟彼飞有适，知此罹忧患。",
        "放之清冷泉，因得省疎慢。",
        "永怀青岑客，廻首白云间。",
        "神超物无违，岂系名与宦。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 308586,
      "title": "香积寺礼拜万廻平等二圣僧塔",
      "content": [
        "真无御化来，借有乘化归。",
        "如彼双塔内，孰能知是非。",
        "愚也骇苍生，圣哉为帝师。",
        "当为时世出，不由天地资。",
        "万廻主此方，平等性无违。",
        "今我一礼心，亿劫同不移。",
        "肃肃松柏下，诸天来有时。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 308587,
      "title": "就道士问周易参同契",
      "content": [
        "仙人骑白鹿，发短耳何长。",
        "时余采菖蒲，忽见嵩之阳。",
        "稽首求丹经，乃出怀中方。",
        "披读了不悟，归来问嵇康。",
        "嗟余无道骨，发我入太行。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 308588,
      "title": "诸官游招隐寺",
      "content": [
        "山馆人已空，青萝换风雨。",
        "自从永明世，月向龙宫吐。",
        "凿井长幽泉，白云今如古。",
        "应真坐松柏，锡杖挂窗户。",
        "口云七十余，能救诸有苦。",
        "回指岩树花，如闻道场鼓。",
        "金色身壤灭，真如性无主。",
        "僚友同一心，清光遣谁取。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 308589,
      "title": "宴南亭",
      "content": [
        "寒江暎村林，亭上纳鲜洁。",
        "楚客共闲饮，静坐金管阕。",
        "酣竟日入山，暝来云归穴。",
        "城楼空杳霭，猿鸟备清切。",
        "物状如丝纶，上心为予决。",
        "访君东溪事，早晚樵路绝。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 308590,
      "title": "何九于客舍集",
      "content": [
        "客有住桂阳，亦如巢林鸟。",
        "罍觞且终宴，功业曾未了。",
        "山月空霁时，江明高楼晓。",
        "门前泊舟檝，行次入松筿。",
        "此意投赠君，沧波风褭褭。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 308591,
      "title": "洛阳尉刘晏与府掾诸公茶集天宫寺岸道上人房",
      "content": [
        "良友呼我宿，月明悬天宫。",
        "道安风尘外，洒扫青林中。",
        "削去府县理，豁然神机空。",
        "自从三湘还，始得今夕同。",
        "旧居太行北，远宦沧溟东。",
        "各有四方事，白云处处通。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 308592,
      "title": "观江淮名胜图",
      "content": [
        "刻意吟云山，尤知隐沦妙。",
        "远公何为者，再诣临海峤。",
        "而我高其风，披图得遗照。",
        "援毫无逃境，遂展千里眺。",
        "淡扫荆门烟，明标赤城烧。",
        "青葱林间岭，隐见淮海徼。",
        "但指香炉顶，无闻白猿啸。",
        "沙门既云灭，独往岂殊调。",
        "感对怀拂衣，胡宁事渔钓。",
        "安期始遗舃，千古谢荣耀。",
        "投迹庶可齐，沧浪有孤棹。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 308593,
      "title": "灞上闲居",
      "content": [
        "鸿都有归客，偃卧滋阳村。",
        "轩冕无枉顾，清川照我门。",
        "空林网夕阳，寒鸟赴荒园。",
        "廓落时得意，怀哉莫与言。",
        "庭前有孤鹤，欲啄常翩翻。",
        "为我衔素书，吊彼颜与原。",
        "二君既不朽，所以慰其魂。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 308594,
      "title": "风凉原上作",
      "content": [
        "阴岑宿云归，烟雾湿松柏。",
        "风凄日初晓，下岭望川泽。",
        "远山无晦明，秋水千里白。",
        "佳气盘未央，圣人在凝碧。",
        "关门阻天下，信是帝王宅。",
        "海内方晏然，庙堂有奇策。",
        "时贞守全运，罢去游说客。",
        "予忝兰台人，幽寻免贻责。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 308595,
      "title": "裴六书堂",
      "content": [
        "闲堂闭空阴，竹林但清响。",
        "窗下长啸客，区中无遗想。",
        "经纶精微言，兼济当独往。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 308596,
      "title": "江上闻笛",
      "content": [
        "横笛怨江月，扁舟何处寻。",
        "声长楚山外，曲绕胡关深。",
        "相去万余里，遥传此夜心。",
        "寥寥浦溆寒，响尽惟幽林。",
        "不知谁家子，复奏邯郸音。",
        "水客皆拥棹，空霜遂盈襟。",
        "羸马望北走，迁人悲越吟。",
        "何当边草白，旌节陇城阴。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 308597,
      "title": "太湖秋夕",
      "content": [
        "水宿烟雨寒，洞庭霜落微。",
        "月明移舟去，夜静魂梦归。",
        "暗觉海风度，萧萧闻鴈飞。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 308598,
      "title": "赵十四兄见访",
      "content": [
        "客来舒长簟，开合延清风。",
        "但有无弦琴，共君尽尊中。",
        "晚来常读易，顷者欲还嵩。",
        "世事何须道，黄精且养蒙。",
        "嵇康殊寡识，张翰独知终。",
        "忽忆鲈鱼鲙，扁舟往江东。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 308599,
      "title": "过华阴",
      "content": [
        "云起太华山，云山互明灭。",
        "东峰始含景，了了见松雪。",
        "羇人感幽栖，窅暎转奇绝。",
        "欣然忘所疲，永望吟不辍。",
        "信宿百余里，出关玩新月。",
        "何意昨来心，遇物遂迁别。",
        "人生屡如此，何以肆愉悦。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 308600,
      "title": "九江口作",
      "content": [
        "漭漭江势阔，雨开浔阳秋。",
        "驿门是高岸，望尽黄芦洲。",
        "水与五谿合，心期万里游。",
        "明时无弃才，谪去随孤舟。",
        "鸷鸟立寒木，丈夫佩吴钩。",
        "何当报君恩，却系单于头。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 308601,
      "title": "大梁途中作",
      "content": [
        "怏怏步长道，客行渺无端。",
        "郊原欲下雪，天地棱棱寒。",
        "当时每酣醉，不觉行路难。",
        "今日无酒钱，凄惶向谁叹。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 308602,
      "title": "途中作",
      "content": [
        "游人愁岁晏，早起遵王畿。",
        "坠叶吹未晓，疎林月微微。",
        "惊禽栖不定，寒兽相因依。",
        "叹此霜露下，复闻鸿雁飞。",
        "渺然江南意，惜与中途违。",
        "羇旅悲壮发，别离念征衣。",
        "永图岂劳止，明节期所归。",
        "宁厌楚山曲，无人长掩扉。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    }
