{
  "data": [
    {
      "id": 313596,
      "title": "水调歌头",
      "content": [
        "一夕还家醉，开户起相迎。",
        "为郎引裾相庇，低首略潜形。",
        "情深无隐。",
        "欲郎乘间起佳兵。",
        "授青萍。",
        "茫然抚叹，不忍欺心。",
        "尔能负心于彼，于我必无情。",
        "熟视花钿不足，刚肠终不能平。",
        "假手迎天意，一挥霜刃。",
        "窗间粉颈断瑶琼。"
      ],
      "author": {
        "id": 36,
        "name": "曾布"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313597,
      "title": "水调歌头",
      "content": [
        "凤凰钗、宝玉凋零。",
        "惨然怅，娇魂怨，饮泣吞声。",
        "还被凌波呼唤，相将金谷同游，想见逢迎处，揶揄羞面，妆脸泪盈盈。",
        "醉眠人、醒来晨起，血凝螓首，但惊喧，白邻里、骇我卒难明。",
        "思败幽囚推究，覆盆无计哀鸣。",
        "丹笔终诬服，圜门驱拥，衔冤垂首欲临刑。"
      ],
      "author": {
        "id": 36,
        "name": "曾布"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313598,
      "title": "水调歌头",
      "content": [
        "向红尘里，有喧呼攘臂，转声辟众，莫遣人冤滥、杀张室，忍偷生。",
        "僚吏惊呼呵叱，狂辞不变如初，投身属吏，慷慨吐丹诚。",
        "仿佛缧绁，自疑梦中，闻者皆惊叹，为不平。",
        "割爱无心，泣对虞姬，手戮倾城宠，翻然起死，不教仇怨负冤声。"
      ],
      "author": {
        "id": 36,
        "name": "曾布"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313599,
      "title": "水调歌头",
      "content": [
        "义城元靖贤相国，喜慕英雄士，赐金缯。",
        "闻斯事，频叹赏，封章归印。",
        "请赎冯燕罪，日边紫泥封诏，阖境赦深刑。",
        "万古三河风义在，青简上、众知名。",
        "河东注，任流水滔滔，水涸名难泯。",
        "至今乐府歌咏。",
        "流入管弦声。"
      ],
      "author": {
        "id": 36,
        "name": "曾布"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313600,
      "title": "临江仙",
      "content": [
        "庭院深深深几许，云窗雾阁春迟。",
        "为谁憔悴损芳姿。",
        "夜来清梦好，应是发南枝。",
        "玉瘦檀轻无限恨，南楼羌管休吹。",
        "浓香吹尽有谁知。",
        "暖风迟日也，别到杏花肥。"
      ],
      "author": {
        "id": 2516,
        "name": "魏夫人"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313601,
      "title": "好事近",
      "content": [
        "雨后晓寒轻，花外早莺啼歇。",
        "愁听隔溪残漏，正一声凄咽。",
        "不堪西望去程赊，离肠万回结。",
        "不似海棠阴下，按凉州时节。"
      ],
      "author": {
        "id": 2516,
        "name": "魏夫人"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313602,
      "title": "阮郎归",
      "content": [
        "夕阳楼外落花飞。",
        "晴空碧四垂。",
        "去帆回首已天涯。",
        "孤烟卷翠微。",
        "楼上客，鬓成丝。",
        "归来未有期。",
        "断魂不忍下危梯。",
        "桐阴月影移。"
      ],
      "author": {
        "id": 2516,
        "name": "魏夫人"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313603,
      "title": "减字木兰花",
      "content": [
        "西楼明月。",
        "掩映梨花千树雪。",
        "楼上人归。",
        "愁听孤城一雁飞。",
        "玉人何处。",
        "又见江南春色暮。",
        "芳信难寻。",
        "去后桃花流水深。"
      ],
      "author": {
        "id": 2516,
        "name": "魏夫人"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313604,
      "title": "减字木兰花",
      "content": [
        "落花飞絮。",
        "杳杳天涯人甚处。",
        "欲寄相思。",
        "春尽衡阳雁渐稀。",
        "离肠泪眼。",
        "肠断泪痕流不断。",
        "明月西楼。",
        "一曲阑干一倍愁。"
      ],
      "author": {
        "id": 2516,
        "name": "魏夫人"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313605,
      "title": "菩萨蛮",
      "content": [
        "溪山掩映斜阳里。",
        "楼台影动鸳鸯起。",
        "隔岸两三家。",
        "出墙红杏花。",
        "绿杨堤下路。",
        "早晚溪边去。",
        "三见柳绵飞。",
        "离人犹未归。"
      ],
      "author": {
        "id": 2516,
        "name": "魏夫人"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313606,
      "title": "菩萨蛮",
      "content": [
        "东风已绿瀛洲草。",
        "画楼帘卷清霜晓。",
        "清绝比湖梅。",
        "花开未满枝。",
        "长天音信断。",
        "又见南归雁。",
        "何处是离愁。",
        "长安明月楼。"
      ],
      "author": {
        "id": 2516,
        "name": "魏夫人"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313607,
      "title": "菩萨蛮",
      "content": [
        "红楼斜倚连溪曲。",
        "楼前溪水凝寒玉。",
        "荡漾木兰船。",
        "船中人少年。",
        "荷花娇欲语。",
        "笑入鸳鸯浦。",
        "波上暝烟低。",
        "菱歌月下归。"
      ],
      "author": {
        "id": 2516,
        "name": "魏夫人"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313608,
      "title": "定风波",
      "content": [
        "不是无心惜落花。",
        "落花无意恋春华。",
        "昨日盈盈枝上笑。",
        "谁道。",
        "今朝吹去落谁家。",
        "把酒临风千种恨。",
        "难问。",
        "梦回云散见无涯。",
        "妙舞清歌谁是主。",
        "回顾。",
        "高城不见夕阳斜。"
      ],
      "author": {
        "id": 2516,
        "name": "魏夫人"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313609,
      "title": "点绛唇",
      "content": [
        "波上清风，画船明月人归后，渐消残酒。",
        "独自凭阑久。",
        "聚散匆匆，此恨年年有，重回首。",
        "淡烟疏柳。",
        "隐隐芜城漏。"
      ],
      "author": {
        "id": 2516,
        "name": "魏夫人"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313610,
      "title": "武陵春",
      "content": [
        "小院无人帘半卷，独自倚阑时。",
        "宽尽春来金缕衣。",
        "憔悴有谁知。",
        "玉人近日书来少，应是怨来迟。",
        "梦里长安早晚归。",
        "和泪立斜晖。"
      ],
      "author": {
        "id": 2516,
        "name": "魏夫人"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313611,
      "title": "江城子",
      "content": [
        "别郎容易见郎难。",
        "几何般。",
        "懒临鸾。",
        "憔悴容仪，陡觉缕衣宽。",
        "门外红梅将谢也，谁信道、不曾看。",
        "晓妆楼上望长安。",
        "怯轻寒。",
        "莫凭阑。",
        "嫌怕东风，吹恨上眉端。",
        "为报归期须及早，休误妾、一春闲。"
      ],
      "author": {
        "id": 2516,
        "name": "魏夫人"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313612,
      "title": "卷珠帘・蝶恋花",
      "content": [
        "记得来时春未暮。",
        "执手攀花，袖染花梢露。",
        "暗卜春心共花语。",
        "争寻双朵争先去。",
        "多情因甚相辜负。",
        "轻折轻离，欲向谁分诉。",
        "泪湿海棠花枝处。",
        "东君空把奴分付。"
      ],
      "author": {
        "id": 2516,
        "name": "魏夫人"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313613,
      "title": "系裙腰",
      "content": [
        "灯花耿耿漏迟迟。",
        "人别后、夜凉时。",
        "西风潇洒梦初回。",
        "谁念我，就单枕，皱双眉。",
        "锦屏绣幌与秋期。",
        "肠欲断、泪偷垂。",
        "月明还到小窗西。",
        "我恨你，我忆你，你争知。"
      ],
      "author": {
        "id": 2516,
        "name": "魏夫人"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313614,
      "title": "清平乐",
      "content": [
        "黄金殿里。",
        "烛影双龙戏。",
        "劝得官家真个醉，进酒犹呼万岁。",
        "锦裀舞彻凉州，君恩与整搔头。",
        "一夜御前宣唤，六宫多少人愁。"
      ],
      "author": {
        "id": 2911,
        "name": "王仲甫"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313615,
      "title": "满朝欢",
      "content": [
        "忆得延州，旧曾相见，东城近东下住。",
        "被若著意引归家，放十分、以上抬举。",
        "小样罗衫，淡红拂过，风流万般做处。",
        "怕伊蓦地忆人时，梦中来、不要迷路。"
      ],
      "author": {
        "id": 2911,
        "name": "王仲甫"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313616,
      "title": "丑奴儿・采桑子",
      "content": [
        "牡丹不好长春好，有个因依。",
        "一两枝儿。",
        "但是风光总属伊。",
        "当初祗为嫦娥种，月正明时。",
        "教恁芳菲。",
        "伴著团圆十二回。"
      ],
      "author": {
        "id": 2911,
        "name": "王仲甫"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313617,
      "title": "永遇乐",
      "content": [
        "风折新英，雨肥繁实，又还如豆。",
        "玉核初成，红腮尚浅，齿软酸透。",
        "粉墙低亚，佳人惊见，不管露沾襟袖。",
        "一枝钗子未插，应把手挪频嗅。",
        "相思病酒，只因思此，免使文君眉皱。",
        "入鼎调羹，攀林止渴，功业还依旧。",
        "看看飞燕，衔将春去，又将欲、黄昏时候。",
        "争如向、金盘满捧，共君王对酒。"
      ],
      "author": {
        "id": 2911,
        "name": "王仲甫"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313618,
      "title": "浪淘沙",
      "content": [
        "素手水晶盘。",
        "垒起仙丸。",
        "红绡碾碎却成团。",
        "逗得安排金粟遍，何似鸡冠。",
        "味胜玉浆寒。",
        "只被宜酸。",
        "莫将荔子一般看。",
        "色淡香消僝僽损，才到长安。"
      ],
      "author": {
        "id": 2911,
        "name": "王仲甫"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313619,
      "title": "醉落魄・一斛珠",
      "content": [
        "醉醒醒醉。",
        "凭君会取皆滋味。",
        "浓斟琥珀香浮蚁。",
        "一入愁肠，便有阳春意。",
        "须将席幕为天地。",
        "歌前起舞花前睡。",
        "从他兀兀陶陶里。",
        "犹胜醒醒，惹得闲憔悴。"
      ],
      "author": {
        "id": 2911,
        "name": "王仲甫"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313620,
      "title": "蓦山溪",
      "content": [
        "挂冠神武，来作烟花主。",
        "千里好江山，都尽是、君恩赐与。",
        "风勾月引，催上泛宅时，酒倾玉，脍堆雪，总道神仙侣。",
        "蓑衣箬笠，更著些儿雨。",
        "横笛两三声，晚云中、惊鸥来去。",
        "欲烦妙手，写入散人图，蜗角名，蝇头利，著甚来由顾。"
      ],
      "author": {
        "id": 2911,
        "name": "王仲甫"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313621,
      "title": "离亭燕・离亭宴",
      "content": [
        "一带江山如画。",
        "景物向秋潇洒。",
        "水浸碧天何处断，霁色冷光相射。",
        "橘树荻花洲，掩映竹篱茅舍。",
        "天际客帆高挂。",
        "烟外酒旗低亚。",
        "多少六朝兴废事，尽入渔樵闲话。",
        "怅望倚层楼，红日无言西下。"
      ],
      "author": {
        "id": 5305,
        "name": "孙浩然"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313622,
      "title": "夜行船",
      "content": [
        "何处采菱归暮。",
        "隔宵烟、菱歌轻举。",
        "白苹风起月华寒，影朦胧、半和梅雨。",
        "脉脉相逢心似许。",
        "扶兰棹、黯然凝伫。",
        "遥指前村，隐隐烟树，含情背人归去。"
      ],
      "author": {
        "id": 5305,
        "name": "孙浩然"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313623,
      "title": "鹧鸪天",
      "content": [
        "才子阴风度远关。",
        "清愁曾向画图看。",
        "山衔斗柄三星没，雪共月明千里寒。",
        "新路陌，旧江干。",
        "崎岖谁叹客程难。",
        "临风更听昭华笛，簌簌梅花满地残。"
      ],
      "author": {
        "id": 1324,
        "name": "王诜"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313624,
      "title": "花心动",
      "content": [
        "春欲来时，看雪里、新梅品流珍绝。",
        "气韵楚江，颜色中央，数朵巧熔香蜡。",
        "嫩苞珠泪圆金烛，娇腮润、蜂房微缺。",
        "画栏悄，佳人道妆，醉吟风月。",
        "淡白轻红谩说。",
        "算何事、东君用心偏别。",
        "赋与异姿，添与清香，堪向苦寒时节。",
        "但教开后金尊满，休惆怅、落时歌阙。",
        "断肠也，繁枝为谁赠折。"
      ],
      "author": {
        "id": 1324,
        "name": "王诜"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313625,
      "title": "落梅花・落梅",
      "content": [
        "寿阳妆晚，慵匀素脸，经宵醉痕堪惜。",
        "前村雪里，几枝初绽，□冰姿仙格。",
        "忍被东风，乱飘满地，残英堆积。",
        "可堪江上起离愁，凭谁说寄，肠断未归客。",
        "流恨声传羌笛。",
        "感行人、水亭山驿。",
        "越溪信阻，仙乡路杳，但风流尘迹。",
        "香艳浓时，东君吟赏，已成轻掷。",
        "愿身长健，且凭阑，明年还放春消息。"
      ],
      "author": {
        "id": 1324,
        "name": "王诜"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313626,
      "title": "黄莺儿",
      "content": [
        "多情春意忆时节。",
        "北圃人来，传道江梅，依稀芳姿，数枝新发。",
        "夸嫩脸著胭脂，腻滑凝香雪。",
        "问伊还记年时，正好相看，因甚轻别。",
        "情切。",
        "往事散浮云，旧恨成华发。",
        "算知空对，绮槛雕栏，孜孜望人攀折。",
        "愁未见苦思量，待见重端叠。",
        "愿与永仿高堂，云雨芳菲月。"
      ],
      "author": {
        "id": 1324,
        "name": "王诜"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313627,
      "title": "踏青游",
      "content": [
        "金勒狨鞍，西城嫩寒春晓。",
        "路渐入、垂杨芳草。",
        "过平堤，穿绿迳，几声啼鸟。",
        "是处里，谁家杏花临水，依约靓妆窥照。",
        "极目高原，东风露桃烟岛。",
        "望十里、红围绿绕。",
        "更相将、乘酒兴，幽情多少。",
        "待向晚、从头记将归去，说与凤楼人道。"
      ],
      "author": {
        "id": 1324,
        "name": "王诜"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313628,
      "title": "忆故人・烛影摇红",
      "content": [
        "烛影摇红向夜阑，乍酒醒、心情懒。",
        "尊前谁为唱阳关，离恨天涯远。",
        "无奈云沈雨散。",
        "凭阑干、东风泪眼。",
        "海棠开后，燕子来时，黄昏庭院。"
      ],
      "author": {
        "id": 1324,
        "name": "王诜"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313629,
      "title": "行香子",
      "content": [
        "金井先秋，梧叶飘黄。",
        "几回惊觉梦初长。",
        "雨微烟淡。",
        "疏雨池塘。",
        "渐蓼花明，菱花冷，藕花凉。",
        "幽人已惯，枕单衾冷，任商飙、催换年光。",
        "问谁相伴，终日清狂。",
        "有竹间风，尊中酒，水边床。"
      ],
      "author": {
        "id": 1324,
        "name": "王诜"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313630,
      "title": "蝶恋花",
      "content": [
        "钟送黄昏鸡报晓。",
        "昏晓相催，世事何时了。",
        "万恨千愁人自老。",
        "春来依旧生芳草。",
        "忙处人多闲处少。",
        "闲处光阴，几个人知道。",
        "独上高楼云渺渺。",
        "天涯一点青山小。"
      ],
      "author": {
        "id": 1324,
        "name": "王诜"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313631,
      "title": "玉楼春",
      "content": [
        "锦城春色花无数。",
        "排比笙歌留客住。",
        "轻寒轻暖夹衣天，乍雨乍晴寒食路。",
        "花虽不语莺能语。",
        "莫放韶光容易去。",
        "海棠开后月明前，纵有千金无买处。"
      ],
      "author": {
        "id": 1324,
        "name": "王诜"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313632,
      "title": "花发沁园春",
      "content": [
        "帝里春归，早先妆点，皇家池馆园林。",
        "雏莺未迁，燕子乍归，时节戏弄晴阴。",
        "琼楼珠阁，恰正在、柳曲花心。",
        "翠袖艳、衣凭阑干，惯闻弦管新音。",
        "此际相携宴赏，纵行乐随处，芳树遥岑。",
        "桃腮杏脸，嫩英万叶，千枝绿浅红深。",
        "轻风终日，泛暗香、长蛮衣襟。",
        "洞户醉，归访笙歌，晚来云海沈沈。"
      ],
      "author": {
        "id": 1324,
        "name": "王诜"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313633,
      "title": "人月圆",
      "content": [
        "小桃枝上春来早，初试薄罗衣。",
        "年年此夜，华灯盛照，人月圆时。",
        "禁街箫鼓，寒轻夜永，纤手同携。",
        "更阑人静。",
        "千门笑语，声在帘帏。"
      ],
      "author": {
        "id": 1324,
        "name": "王诜"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313634,
      "title": "换遍歌头",
      "content": [
        "雪霁轻尘敛，好风初报柳。",
        "春寒浅、当三五。",
        "是处鳌山耸，金羁宝乘，游赏遍蓬壶。",
        "向黄昏时候。",
        "对双龙阙门前，皓月华灯射，变清昼。",
        "彩凤低衔天语。",
        "承宣诏传呼。",
        "飞上层霄，共陪霞觞频举。",
        "更渐阑，正回路。",
        "遥拥车佩珊珊，笼纱满香衢。",
        "指凤楼、相将醉归去。"
      ],
      "author": {
        "id": 1324,
        "name": "王诜"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313635,
      "title": "失调名",
      "content": [
        "合彩丝、对缠玉腕。"
      ],
      "author": {
        "id": 1324,
        "name": "王诜"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313636,
      "title": "失调名",
      "content": [
        "偷闲结个艾虎儿，要插在、秋蝉鬓畔。"
      ],
      "author": {
        "id": 1324,
        "name": "王诜"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313637,
      "title": "失调名",
      "content": [
        "带了黄花，强饮茱萸酒。"
      ],
      "author": {
        "id": 1324,
        "name": "王诜"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313638,
      "title": "画堂春令・画堂春",
      "content": [
        "画堂霜重晓寒消，南枝红雪妆成。",
        "卷帘疑是弄妆人。",
        "粉面带春醒。",
        "最爱北江临岸，含娇浅淡精神。",
        "微风不动水纹平。",
        "倒影斗轻盈。"
      ],
      "author": {
        "id": 1324,
        "name": "王诜"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313639,
      "title": "撼庭竹",
      "content": [
        "绰略青梅弄春色。",
        "真艳态堪惜。",
        "经年费尽东君力。",
        "有情先到探春客。",
        "无语泣寒香，时暗度瑶席。",
        "月下风前空怅望，思携手同摘。",
        "画栏倚遍无消息。",
        "佳辰乐事再难得。",
        "还是夕阳天，空暮云凝碧。"
      ],
      "author": {
        "id": 1324,
        "name": "王诜"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313640,
      "title": "蝶恋花",
      "content": [
        "小雨初晴回晚照。",
        "金翠楼台，倒影芙蓉沼。",
        "杨柳垂垂风袅袅。",
        "嫩荷无数青钿小。",
        "似此园林无限好。",
        "流落归来，到了心情少。",
        "坐到黄昏人悄悄。",
        "更应添得朱颜老。"
      ],
      "author": {
        "id": 1324,
        "name": "王诜"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313641,
      "title": "蓦山溪",
      "content": [
        "去年今日，从驾游西苑。",
        "彩仗压金波，看水戏、鱼龙曼衍。",
        "宝津南殿，宴坐近天颜，金杯酒，君王劝。",
        "头上宫花颤。",
        "六军锦绣，万骑穿杨箭。",
        "日暮翠华归，拥钧天、笙歌一片。",
        "如今关外，千里未归人，前山雨，西楼晚。",
        "望断思君眼。"
      ],
      "author": {
        "id": 8572,
        "name": "陈济翁"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313642,
      "title": "蓦山溪",
      "content": [
        "薰风时候。",
        "芍药披晴昼。",
        "天上玉阑干，展一枰、天家锦绣。",
        "汉宫唐殿。",
        "嫔御逞妖娆，飞燕女，太真妃，一样新妆就。",
        "黄金拈线，色与红芳斗。",
        "谁把绛绡衣，误将他、胭脂渍透。",
        "晚风生处，襟袖卷浓香，持玉斝，秉纱笼，倚醉听更漏。"
      ],
      "author": {
        "id": 8572,
        "name": "陈济翁"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313643,
      "title": "踏青游",
      "content": [
        "濯锦江头，羞杀艳桃秾李。",
        "纵赵昌、丹青难比。",
        "晕轻红，留浅素，千娇百媚。",
        "照绿水。",
        "恰如下临鸾镜，妃子弄妆犹醉。",
        "诗笔因循，不晓少陵深意。",
        "但满眼、伤春珠泪。",
        "燕来时，莺啼处，年年憔悴。",
        "便除是。",
        "秉烛凭阑吟赏，莫教夜深花睡。"
      ],
      "author": {
        "id": 8572,
        "name": "陈济翁"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313644,
      "title": "水龙吟",
      "content": [
        "古来云海茫茫，道山绛阙知何处。",
        "人间自有，赤城居士，龙蟠凤举。",
        "清净无为，坐忘遗照，八篇奇语。",
        "向玉霄东望，蓬莱暗霭，有云驾、骖风驭。",
        "行尽九州四海，笑纷纷、落花飞絮。",
        "临江一见，谪仙风采，无言心许。",
        "八表神游，浩然相对，酒酣箕踞。",
        "待垂天赋就，骑鲸路稳，约相将去。"
      ],
      "author": {
        "id": 11678,
        "name": "苏轼"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313645,
      "title": "水龙吟",
      "content": [
        "楚山修竹如云，异材秀出千林表。",
        "龙须半翦，凤膺微涨，玉肌匀绕。",
        "木落淮南，雨晴云梦，月明风袅。",
        "自中郎不见，桓伊去后，知孤负、秋多少。",
        "闻道岭南太守，后堂深、绿珠娇小。",
        "绮窗学弄，梁州初遍，霓裳未了。",
        "嚼征含宫，泛商流羽，一声云杪。",
        "为使君洗尽，蛮风瘴雨，作霜天晓。"
      ],
      "author": {
        "id": 11678,
        "name": "苏轼"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313646,
      "title": "水龙吟",
      "content": [
        "似花还似非花，也无人惜从教坠。",
        "抛家傍路，思量却是，无情有思。",
        "萦损柔肠，困酣娇眼，欲开还闭。",
        "梦随风万里，寻郎去处，又还被、莺呼起。",
        "不恨此花飞尽，恨西园、落红难缀。",
        "晓来雨过，遗踪何在，一池萍碎。",
        "春色三分，二分尘土，一分流水。",
        "细看来，不是杨花点点，是离人泪。"
      ],
      "author": {
        "id": 11678,
        "name": "苏轼"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313647,
      "title": "水龙吟",
      "content": [
        "小舟横截春江，卧看翠壁红楼起。",
        "云间笑语，使君高会，佳人半醉。",
        "危柱哀弦，艳歌馀响，绕云萦水。",
        "念故人老大，风流未减，独回首、烟波里。",
        "推枕惘然不见，但空江、月明千里。",
        "五湖闻道，扁舟归去，仍携西子。",
        "云梦南州，武昌南岸，昔游应记。",
        "料多情梦里，端来见我，也参差是。"
      ],
      "author": {
        "id": 11678,
        "name": "苏轼"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313648,
      "title": "满庭芳",
      "content": [
        "归去来兮，吾归何处，万里家在岷峨。",
        "百年强半，来日苦无多。",
        "坐见黄州再闰，儿童尽、楚语吴歌。",
        "山中友，鸡豚社酒，相劝老东坡。",
        "云何。",
        "当此去，人生底事，来往如梭。",
        "待闲看，秋风洛水清波。",
        "好在堂前细柳，应念我、莫翦柔柯。",
        "仍传语，江南父老，时与晒渔蓑。"
      ],
      "author": {
        "id": 11678,
        "name": "苏轼"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313649,
      "title": "满庭芳",
      "content": [
        "香叆雕盘，寒生冰箸，画堂别是风光。",
        "主人情重，开宴出红妆。",
        "腻玉圆搓素颈，藕丝嫩、新织仙裳。",
        "双歌罢，虚檐转月，馀韵尚悠扬。",
        "人间，何处有，司空见惯，应谓寻常。",
        "坐中有狂客，恼乱愁肠。",
        "报道金钗坠也，十指露、春笋纤长。",
        "亲曾见，全胜宋玉，想像赋高唐。"
      ],
      "author": {
        "id": 11678,
        "name": "苏轼"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313650,
      "title": "满庭芳",
      "content": [
        "蜗角虚名，蝇头微利，算来著甚干忙。",
        "事皆前定，谁弱又谁强。",
        "且趁闲身未老，尽放我、些子疏狂。",
        "百年里，浑教是醉，三万六千场。",
        "思量。",
        "能几许，忧愁风雨，一半相妨。",
        "又何须，抵死说短论长。",
        "幸对清风皓月，苔茵展、云幕高张。",
        "江南好，千锺美酒，一曲《满庭芳》。"
      ],
      "author": {
        "id": 11678,
        "name": "苏轼"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313651,
      "title": "满庭芳",
      "content": [
        "三十三年，今谁存者，算只君与长江。",
        "凛然苍桧，霜干苦难双。",
        "闻道司州古县，云溪上、竹坞松窗。",
        "江南岸，不因送子，宁肯过吾邦。",
        "𪭢𪭢。",
        "疏雨过，风林舞破，烟盖云幢。",
        "愿持此邀君，一饮空缸。",
        "居士先生老矣，真梦里、相对残釭。",
        "歌舞断，行人未起，船鼓已逄逄。"
      ],
      "author": {
        "id": 11678,
        "name": "苏轼"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313652,
      "title": "满庭芳",
      "content": [
        "三十三年，飘流江海，万里烟浪云帆。",
        "故人惊怪，憔悴老青衫。",
        "我自疏狂异趣，君何事、奔走尘凡。",
        "流年尽，穷途坐守，船尾冻相衔。",
        "巉巉。",
        "淮浦外，层楼翠壁，古寺空岩。",
        "步携手林间，笑挽ホホ。",
        "莫上孤峰尽处，萦望眼、云海相搀。",
        "家何在，因君问我，归梦绕松杉。"
      ],
      "author": {
        "id": 11678,
        "name": "苏轼"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313653,
      "title": "水调歌头",
      "content": [
        "落日绣帘卷，亭下水连空。",
        "知君为我，新作窗户湿青红。",
        "长记平山堂上，敧枕江南烟雨，渺渺没孤鸿。",
        "认得醉翁语，山色有无中。",
        "一千顷，都镜净，倒碧峰。",
        "忽然浪起，掀舞一叶白头翁。",
        "堪笑兰台公子，未解庄生天籁，刚道有雌雄。",
        "一点浩然气，千里快哉风。"
      ],
      "author": {
        "id": 11678,
        "name": "苏轼"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313654,
      "title": "水调歌头",
      "content": [
        "安石在东海，从事鬓惊秋。",
        "中年亲友难别，丝竹缓离愁。",
        "一旦功成名遂，准拟东还海道，扶病入西州。",
        "雅志困轩冕，遗恨寄沧洲。",
        "岁云暮，须早计，要褐裘。",
        "故乡归去千里，佳处辄迟留。",
        "我醉歌时君和，醉倒须君扶我，惟酒可忘忧。",
        "一任刘玄德，相对卧高楼。"
      ],
      "author": {
        "id": 11678,
        "name": "苏轼"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313655,
      "title": "水调歌头",
      "content": [
        "明月几时有，把酒问青天。",
        "不知天上宫阙，今夕是何年。",
        "我欲乘风归去，又恐琼楼玉宇，高处不胜寒。",
        "起舞弄清影，何似在人间。",
        "转朱阁，低绮户，照无眠。",
        "不应有恨，何事长向别时圆。",
        "人有悲欢离合，月有阴晴圆缺，此事古难全。",
        "但愿人长久，千里共婵娟。"
      ],
      "author": {
        "id": 11678,
        "name": "苏轼"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313656,
      "title": "水调歌头",
      "content": [
        "昵昵儿女语，灯火夜微明。",
        "恩冤尔汝来去，弹指泪和声。",
        "忽变轩昂勇士，一鼓填然作气，千里不留行。",
        "回首暮云远，飞絮搅青冥。",
        "众禽里，真彩凤，独不鸣。",
        "跻攀寸步千险，一落百寻轻。",
        "烦子指间风雨，置我肠中冰炭，起坐不能平。",
        "推手从归去，无泪与君倾。"
      ],
      "author": {
        "id": 11678,
        "name": "苏轼"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313657,
      "title": "满江红",
      "content": [
        "忧喜相寻，风雨过、一江春绿。",
        "巫峡梦、至今空有，乱山屏簇。",
        "何似伯鸾携德耀，箪瓢未足清欢足。",
        "渐粲然、光彩照阶庭，生兰玉。",
        "幽梦里，传心曲。",
        "肠断处，凭他续。",
        "文君婿知否，笑君卑辱。",
        "君不见周南歌汉广，天教夫子休乔木。",
        "便相将、左手抱琴书，云间宿。"
      ],
      "author": {
        "id": 11678,
        "name": "苏轼"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313658,
      "title": "满江红",
      "content": [
        "江汉西来，高楼下、蒲萄深碧。",
        "犹自带、岷峨云浪，锦江春色。",
        "君是南山遗爱守，我为剑外思归客。",
        "对此间、风物岂无情，殷勤说。",
        "江表传，君休读。",
        "狂处士，真堪惜。",
        "空洲对鹦鹉，苇花萧瑟。",
        "不独笑书生争底事，曹公黄祖俱飘忽。",
        "愿使君、还赋谪仙诗，追黄鹤。"
      ],
      "author": {
        "id": 11678,
        "name": "苏轼"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313659,
      "title": "满江红",
      "content": [
        "东武南城，新堤固、涟漪初溢。",
        "隐隐遍、长林高阜，卧红堆碧。",
        "枝上残花吹尽也，与君更向江头觅。",
        "问向前、犹有几多春，三之一。",
        "官里事，何时毕。",
        "风雨外，无多日。",
        "相将泛曲水，满城争出。",
        "君不见兰亭修禊事，当时坐上皆豪逸。",
        "到如今、修竹满山阴，空陈迹。"
      ],
      "author": {
        "id": 11678,
        "name": "苏轼"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313660,
      "title": "满江红",
      "content": [
        "清颖东流，愁目断、孤帆明灭。",
        "宦游处、青山白浪，万重千叠。",
        "孤负当年林下意，对床夜雨听萧瑟。",
        "恨此生、长向别离中，添华发。",
        "一尊酒，黄河侧。",
        "无限事，从头说。",
        "相看恍如昨，许多年月。",
        "衣上旧痕馀苦泪，眉间喜气添黄色。",
        "便与君、池上觅残春，花如雪。"
      ],
      "author": {
        "id": 11678,
        "name": "苏轼"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313661,
      "title": "满江红",
      "content": [
        "天岂无情，天也解、多情留客。",
        "春向暖、朝来底事，尚飘轻雪。",
        "君过春来纡组绶，我应归去耽泉石。",
        "恐异时、杯酒忽相思，云山隔。",
        "浮世事，俱难必。",
        "人纵健，头应白。",
        "何辞更一醉，此欢难觅。",
        "欲向佳人诉离恨，泪珠先已凝双睫。",
        "但莫遣、新燕却来时，音书绝。"
      ],
      "author": {
        "id": 11678,
        "name": "苏轼"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313662,
      "title": "归朝欢",
      "content": [
        "我梦扁舟浮震泽。",
        "雪浪摇空千顷白。",
        "觉来满眼是庐山，倚天无数开青壁。",
        "此生长接淅。",
        "与君同是江南客。",
        "梦中游，觉来清赏，同作飞梭掷。",
        "明日西风还挂席。",
        "唱我新词泪沾臆。",
        "灵均去后楚山空，澧阳兰芷无颜色。",
        "君才如梦得。",
        "武陵更在西南极。",
        "竹枝词，莫摇新唱，谁谓古今隔。"
      ],
      "author": {
        "id": 11678,
        "name": "苏轼"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313663,
      "title": "念奴娇",
      "content": [
        "大江东去，浪淘尽、千古风流人物。",
        "故垒西边人道是，三国周郎赤壁。",
        "乱石穿空，惊涛拍岸，卷起千堆雪。",
        "江山如画，一时多少豪杰。",
        "遥想公瑾当年，小乔初嫁了，雄姿英发。",
        "羽扇纶巾谈笑间，强虏灰飞烟灭。",
        "故国神游，多情应笑，我早生华发。",
        "人间如梦，一尊还酹江月。"
      ],
      "author": {
        "id": 11678,
        "name": "苏轼"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313664,
      "title": "雨中花・夜行船",
      "content": [
        "今岁花时深院，尽日东风，荡扬茶烟。",
        "但有绿苔芳草，柳絮榆钱。",
        "闻道城西，长廊古寺，甲第名园。",
        "有国艳带酒，天香染袂，为我留连。",
        "清明过了，残红无处，对此泪洒尊前。",
        "秋向晚，一枝何事，向我依然。",
        "高会聊追短景，清商不暇馀妍。",
        "不如留取，十分春态，付与明年。"
      ],
      "author": {
        "id": 11678,
        "name": "苏轼"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313665,
      "title": "沁园春",
      "content": [
        "孤馆灯青，野店鸡号，旅枕梦残。",
        "渐月华收练，晨霜耿耿，云山摛锦，朝露清清。",
        "世路无穷，劳生有限，似此区区长鲜欢。",
        "微吟罢，凭征鞍无语，往事千端。",
        "当时共客长安。",
        "似二陆初来俱少年。",
        "有笔头千字，胸中万卷，致君尧舜，此事何难。",
        "用舍由时，行藏在我，袖手何妨闲处看。",
        "身长健，但优游卒岁，且斗尊前。"
      ],
      "author": {
        "id": 11678,
        "name": "苏轼"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313666,
      "title": "劝金船",
      "content": [
        "无情流水多情客。",
        "劝我如曾识。",
        "杯行到手休辞却。",
        "这公道难得。",
        "曲水池上，小字更书年月。",
        "还对茂林修竹，似永和节。",
        "纤纤素手如霜雪。",
        "笑把秋花插。",
        "尊前莫怪歌声咽。",
        "又还是轻别。",
        "此去翱翔，遍赏玉堂金阙。",
        "欲问再来何岁，应有华发。"
      ],
      "author": {
        "id": 11678,
        "name": "苏轼"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313667,
      "title": "一丛花",
      "content": [
        "今年春浅腊侵年。",
        "冰雪破春妍。",
        "东风有信无人见，露微意、柳际花边。",
        "寒夜纵长，孤衾易暖，钟鼓渐清圆。",
        "朝来初日半含山。",
        "楼阁淡疏烟。",
        "游人便作寻芳计，小桃杏、应已争先。",
        "衰病少情，疏慵自放，惟爱日高眠。"
      ],
      "author": {
        "id": 11678,
        "name": "苏轼"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313668,
      "title": "木兰花令",
      "content": [
        "霜馀已失长淮阔。",
        "空听潺潺清颍咽。",
        "佳人犹唱醉翁词，四十三年如电抹。",
        "草头秋露流珠滑。",
        "三五盈盈还二八。",
        "与余同是识翁人，惟有西湖波底月。"
      ],
      "author": {
        "id": 11678,
        "name": "苏轼"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313669,
      "title": "木兰花令",
      "content": [
        "知君仙骨无寒暑。",
        "千载相逢犹旦暮。",
        "故将别语恼佳人，要看梨花枝上雨。",
        "落花已逐回风去。",
        "花本无心莺自诉。",
        "明朝归路下塘西，不见莺啼花落处。"
      ],
      "author": {
        "id": 11678,
        "name": "苏轼"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313670,
      "title": "木兰花令",
      "content": [
        "梧桐叶上三更雨。",
        "惊破梦魂无觅处。",
        "夜凉枕簟已知秋，更听寒蛩促机杼。",
        "梦中历历来时路。",
        "犹在江亭醉歌舞。",
        "尊前必有问君人，为道别来心与绪。"
      ],
      "author": {
        "id": 11678,
        "name": "苏轼"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313671,
      "title": "西江月",
      "content": [
        "公子眼花乱发，老夫鼻观先通。",
        "领巾飘下瑞香风。",
        "惊起谪仙春梦。",
        "后土祠中玉蕊，蓬莱殿后鞓红。",
        "此花清绝更纤秾。",
        "把酒何人心动。"
      ],
      "author": {
        "id": 11678,
        "name": "苏轼"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313672,
      "title": "西江月",
      "content": [
        "小院朱阑几曲，重城画鼓三通。",
        "更看微月转光风。",
        "归去香云入梦。",
        "翠袖争浮大白，皂罗半插斜红。",
        "灯花零落酒花秾。",
        "妙语一时飞动。"
      ],
      "author": {
        "id": 11678,
        "name": "苏轼"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313673,
      "title": "西江月",
      "content": [
        "怪此花枝怨泣，托君诗句名通。",
        "凭将草木记吴风。",
        "继取相如云梦。",
        "点笔袖沾醉墨，谤花面有惭红。",
        "知君却是为情秾。",
        "怕见此花撩动。"
      ],
      "author": {
        "id": 11678,
        "name": "苏轼"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313674,
      "title": "西江月",
      "content": [
        "闻道双衔凤带，不妨单著鲛绡。",
        "夜香知与阿谁烧。",
        "怅望水沈烟袅。",
        "云鬓风前绿卷，玉颜醉里红潮。",
        "莫教空度可怜宵。",
        "月与佳人共僚。"
      ],
      "author": {
        "id": 11678,
        "name": "苏轼"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313675,
      "title": "西江月",
      "content": [
        "点点楼头细雨。",
        "重重江外平湖。",
        "当年戏马会东徐。",
        "今日凄凉南浦。",
        "莫恨黄花未吐。",
        "且教红粉相扶。",
        "酒阑不必看茱萸。",
        "俯仰人间今古。"
      ],
      "author": {
        "id": 11678,
        "name": "苏轼"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313676,
      "title": "西江月",
      "content": [
        "龙焙今年绝品，谷帘自古珍泉。",
        "雪芽双井散神仙。",
        "苗裔来从北苑。",
        "汤发云腴酽白，盏浮花乳轻圆。",
        "人间谁敢更争妍。",
        "斗取红窗粉面。"
      ],
      "author": {
        "id": 11678,
        "name": "苏轼"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313677,
      "title": "西江月",
      "content": [
        "别梦已随流水，泪巾犹裛香泉。",
        "相如依旧是臞仙。",
        "人在瑶台阆苑。",
        "花雾萦风缥缈，歌珠滴水清圆。",
        "蛾眉新作十分妍。",
        "走马归来便面。"
      ],
      "author": {
        "id": 11678,
        "name": "苏轼"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313678,
      "title": "西江月",
      "content": [
        "世事一场大梦，人生几度秋凉。",
        "夜来风叶已鸣廊。",
        "看取眉头鬓上。",
        "酒贱常愁客少，月明多被云妨。",
        "中秋谁与共孤光。",
        "把盏凄然北望。"
      ],
      "author": {
        "id": 11678,
        "name": "苏轼"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313679,
      "title": "西江月",
      "content": [
        "莫叹平原落落，且应去鲁迟迟。",
        "与君各记少年时。",
        "须信人生如寄。",
        "白发千茎相送，深杯百罚休辞。",
        "拍浮何用酒为池。",
        "我已为君德醉。"
      ],
      "author": {
        "id": 11678,
        "name": "苏轼"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313680,
      "title": "西江月",
      "content": [
        "玉骨那愁瘴雾，冰姿自有仙风。",
        "海仙时遣探芳丛。",
        "倒挂绿毛么凤。",
        "素面翻嫌粉涴，洗妆不褪唇红。",
        "高情已逐晓云空。",
        "不与梨花同梦。"
      ],
      "author": {
        "id": 11678,
        "name": "苏轼"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313681,
      "title": "西江月",
      "content": [
        "照野弥弥浅浪，横空暧暧微霄。",
        "障泥未解玉骢骄。",
        "我欲醉眠芳草。",
        "可惜一溪明月，莫教踏破琼瑶。",
        "解鞍敧枕绿杨桥。",
        "杜宇一声春晓。"
      ],
      "author": {
        "id": 11678,
        "name": "苏轼"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313682,
      "title": "西江月",
      "content": [
        "三过平山堂下，半生弹指声中。",
        "十年不见老仙翁。",
        "壁上龙蛇飞动。",
        "欲吊文章太守，仍歌杨柳春风。",
        "休言万事转头空。",
        "未转头时皆梦。"
      ],
      "author": {
        "id": 11678,
        "name": "苏轼"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313683,
      "title": "西江月",
      "content": [
        "昨夜扁舟京口，今朝马首长安。",
        "旧官何物与新官。",
        "只有湖山公案。",
        "此景百年几变，个中下语千难。",
        "使君才气卷波澜。",
        "与把新诗判断。"
      ],
      "author": {
        "id": 11678,
        "name": "苏轼"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313684,
      "title": "临江仙",
      "content": [
        "细马远驮双侍女，青巾玉带红靴。",
        "溪山好处便为家。",
        "谁知巴峡路，却见洛城花。",
        "面旋落英飞玉蕊，人间春日初斜。",
        "十年不见紫云车。",
        "龙丘新洞府，铅鼎养丹砂。"
      ],
      "author": {
        "id": 11678,
        "name": "苏轼"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313685,
      "title": "临江仙",
      "content": [
        "诗句端来磨我钝，钝锥不解生铓。",
        "欢颜为我解冰霜。",
        "酒阑清梦觉，春草满池塘。",
        "应念雪堂坡下老，昔年共采芸香。",
        "功成名遂早还乡。",
        "回车来过我，乔木拥千章。"
      ],
      "author": {
        "id": 11678,
        "name": "苏轼"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313686,
      "title": "临江仙",
      "content": [
        "我劝髯张归去好，从来自己忘情。",
        "尘心消尽道心平。",
        "江南与塞北，何处不堪行。",
        "俎豆庚桑真过矣，凭君说与南荣。",
        "愿闻吴越报丰登。",
        "君王如有问，结袜赖王生。"
      ],
      "author": {
        "id": 11678,
        "name": "苏轼"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313687,
      "title": "临江仙",
      "content": [
        "自古相从休务日，何妨低唱微吟。",
        "天垂云重作春阴。",
        "坐中人半醉，帘外雪将深。",
        "闻道分司狂御史，紫云无路追寻。",
        "凄风寒雨是骎骎。",
        "问囚长损气，见鹤忽惊心。"
      ],
      "author": {
        "id": 11678,
        "name": "苏轼"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313688,
      "title": "临江仙",
      "content": [
        "忘却成都来十载，因君未免思量。",
        "凭将清泪洒江阳。",
        "故山知好在，孤客自悲凉。",
        "坐上别愁君未见，归来欲断无肠。",
        "殷勤且更尽离觞。",
        "此身如传舍，何处是吾乡。"
      ],
      "author": {
        "id": 11678,
        "name": "苏轼"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313689,
      "title": "临江仙",
      "content": [
        "尊酒何人怀李白，草堂遥指江东。",
        "珠帘十里卷香风。",
        "花开又花谢，离恨几千重。",
        "轻舸渡江连夜到，一时惊笑衰容。",
        "语音犹自带吴侬。",
        "夜阑对酒处，依旧梦魂中。"
      ],
      "author": {
        "id": 11678,
        "name": "苏轼"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313690,
      "title": "临江仙",
      "content": [
        "九十日春都过了，贪忙何处追游。",
        "三分春色一分愁。",
        "雨翻榆荚阵，风转柳花球。",
        "阆苑先生须自责，蟠桃动是千秋。",
        "不知人世苦厌求。",
        "东皇不拘束，肯为使君留。"
      ],
      "author": {
        "id": 11678,
        "name": "苏轼"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313691,
      "title": "临江仙",
      "content": [
        "四大从来都遍满，此间风水何疑。",
        "故应为我发新诗。",
        "幽花香涧谷，寒藻舞沦漪。",
        "借与玉川生两腋，天仙未必相思。",
        "还凭流水送人归。",
        "层巅馀落日，草露已沾衣。"
      ],
      "author": {
        "id": 11678,
        "name": "苏轼"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313692,
      "title": "临江仙",
      "content": [
        "一别都门三改火，天涯踏尽红尘。",
        "依然一笑作春温。",
        "无波真古井，有节是秋筠。",
        "惆怅孤帆连夜发，送行淡月微云。",
        "尊前不用翠眉颦。",
        "人生如逆旅，我亦是行人。"
      ],
      "author": {
        "id": 11678,
        "name": "苏轼"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313693,
      "title": "临江仙",
      "content": [
        "多病休文都瘦损，不堪金带垂腰。",
        "望湖楼上暗香飘。",
        "和风春弄袖，明月夜闻箫。",
        "酒醒梦回清漏永，隐床无限更潮。",
        "佳人不见董娇饶。",
        "徘徊花上月，空度可怜宵。"
      ],
      "author": {
        "id": 11678,
        "name": "苏轼"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313694,
      "title": "临江仙",
      "content": [
        "夜饮东坡醒复醉，归来仿佛三更。",
        "家童鼻息已雷鸣。",
        "敲门都不应，倚杖听江声。",
        "长恨此身非我有，何时忘却营营。",
        "夜阑风静縠纹平。",
        "小舟从此逝，江海寄馀生。"
      ],
      "author": {
        "id": 11678,
        "name": "苏轼"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313695,
      "title": "临江仙",
      "content": [
        "冬夜夜寒冰合井，画堂明月侵帏。",
        "青缸明灭照悲啼。",
        "青缸挑欲尽，粉泪裛还垂。",
        "未尽一尊先掩泪，歌声半带清悲。",
        "情声两尽莫相违。",
        "欲知肠断处，梁上暗尘飞。"
      ],
      "author": {
        "id": 11678,
        "name": "苏轼"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    }
  ],
