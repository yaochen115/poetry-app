{
  "data": [
    {
      "id": 187842,
      "title": "观鱼",
      "content": [
        "江渚日夜归，江痕下汀矶。",
        "渔者不自劳，推舟就寒漪。",
        "得鱼乐几多，忽忘身在泥。",
        "未闻任氏风，岂信丝缗非。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 187843,
      "title": "山中",
      "content": [
        "山头树青青，山水日泠泠。",
        "攀树挂冠裳，饮水清肺肠。",
        "自然古心髙，忽与世态忘。",
        "有道不足名，无责身始康。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 187844,
      "title": "快哉行呈诸友兼简仲美",
      "content": [
        "脱巾草坐踏地歌，花影落酒生红波。",
        "拔剑横膝仰面笑，醒眼不识天为何。",
        "平时尘土埋英雄，却学弄笔为雕虫。",
        "太阿补履不足用，老骥捕鼠终无功。",
        "安得雄心大胆子，与之把臂论心事。",
        "不使生前眼见仇，何用死时尸磔市。",
        "人生病老多壮时，百岁祗如梭过机。",
        "安能跼促努筋力，眼穿仰望丹桂枝。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 187845,
      "title": "壬辰三月二十一日读李翰林墓铭云少以任侠为事因激素志示杜子长",
      "content": [
        "嗟吾为颛蒙，木朴无所思。",
        "成童始就学，数岁通书诗。",
        "十五尚意气，自待固不卑。",
        "尝为富贵易，有如涂上泥。",
        "苟意欲自进，足至则履之。",
        "二十忽自笑，学乃谋寒饥。",
        "倘富贵是致，其亦垄断为。",
        "虽曰为学难，我易易则宜。",
        "墙篱号障塞，犹可钻隙窥。",
        "岂此圣人道，苦勉不及期。",
        "反复私自念，已急犹惧迟。",
        "思而或有得，行之固不疑。",
        "跛以见圣贤，不及犹可随。",
        "道远志所毕，疾驱亦忘疲。",
        "逮兹五十年，财若穿铜锤。",
        "柄执似可役，持用宁无施。",
        "何意甚困踬，不及庸常儿。",
        "多病骨出露，薄食筋力羸。",
        "鼠饱昼睡穴，鸡飞暮乘埘。",
        "世既鸡鼠俦，宜吾安穷奇。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 187846,
      "title": "慎交",
      "content": [
        "昏镜无好面，恶土无善禾。",
        "镜不但自昏，损人颜色多。",
        "地恶根不长，禾死其奈何。",
        "必欲识已真，抆镜除埃尘。",
        "必欲得善禾，易地勤耕耘。",
        "安得浪与儿，诵口而思身。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 187847,
      "title": "西园月夜醉作短歌二阕  其一",
      "content": [
        "我有壹欝气，从来未经吐。",
        "欲作大叹吁向天，穿天作孔恐天怒。",
        "琥珀春拨醅，泛艶红出杯。",
        "无客尚有月，把对心尚开。",
        "踏地长歌仰天笑，突兀坐见朱颜颓。",
        "从他日月趁人老，一醉万事皆悠哉。",
        "丈夫身在不忧困，未必天心竟不回。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 187848,
      "title": "西园月夜醉作短歌二阕  其二",
      "content": [
        "醉眼不识天，疑是髙帐幙。",
        "忿月喝不住，起欲取绳缚。",
        "谁令吾不饮，饮剧始知乐。",
        "若令东海解醉人，吾亦去取北斗酌。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 187849,
      "title": "春梦",
      "content": [
        "春风儿女喜，不合丈夫爱。",
        "日午困魔来，四体倦欲解。",
        "春禽只随花中飞，幸此无声聒我睡。",
        "一梦梦周公，笑与伊尹语。",
        "问今天下贤者谁，何为见弃不见取。",
        "纸传周官十卷书，安用久留不烧去。",
        "二梦梦孔父，戟手怒目瞋。",
        "天下皆曰自孔氏，猎取利禄安荣身。",
        "髙官志遂不思道，牵以嗜利露己真。",
        "如何贫贱用我者皆是，富贵用我无一人。",
        "三梦梦我身，化为鸣鳯雏。",
        "飞飞两足髙，迅迅六翮舒。",
        "直上髙髙天，天门闭鎻阻我回。",
        "我留不肯去，以翼抟天天门开。",
        "天公遣玉女，问我何事来。",
        "再拜谢天公，贱臣无所知。",
        "幸至天公前，敢问无所尸。",
        "臣闻伊尹于汤旦于周，安致天下如山丘。",
        "愚孙𫘤子相承继，卜世以过天位留。",
        "自从中代来，世世亦有相。",
        "如何反复无定时，犹以乱割医疮痍。",
        "天公何忍是不救，恰如旁坐观奕棋。",
        "又闻人间人，一一天与命。",
        "孔饥孟退荀杨贱，天公岂不知其贤与圣。",
        "颜子号庶几，早死不久生。",
        "子夏既丧子，左丘亦失眀。",
        "伯牛疾牖间，原宪贫病成。",
        "晁错死非命，贾谊夭不卿。",
        "赐死萧望之，罪免刘更生。",
        "羊祜许国𣃁墓破，反得坠折无完肱。",
        "又如草木及禽兽，苟推以理亦莫知。",
        "春气不加松柏好，秋风先败兰蕙枝。",
        "蝮虺中人皆巳死，鸱枭食母然后飞。",
        "愿天明告臣，以祛臣心疑。",
        "天公未及言，起遂东风吹。",
        "觉来何所喻，壹欝双泪垂。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 187850,
      "title": "寄王正叔",
      "content": [
        "形骸饫餍城市劳，思得远去与俗逃。",
        "借来马病行欲倒，著鞭迫急翻奔跳。",
        "连绵半日走十堠，急雨随湿衣与袍。",
        "到家觅火烘衣湿，亟书名纸挥墨毫。",
        "由来道同志易合，顾人谓我此可交。",
        "形秽向逢珠在侧，联坐愧用狗续貂。",
        "喜爱常令对面月，招延不许他有庖。",
        "玄谈直抵世不到，大论许致君为尭。",
        "喧呼脱落笑绝倒，中乐不肯旁诮嘲。",
        "久孤得聚气遂振，张目视人皆么么。",
        "促席捉手坐接膝，不肯放去逾分宵。",
        "平明懒睡未及起，稠叠仆足烦见招。",
        "披嚢示我文数纸，晚霞烂漫新晴霄。",
        "魂迷心醉不敢议，畏伏缩若鼠见猫。",
        "同骑疲马远眺望，独止不进须连镳。",
        "江东山水雅丰富，熟视若在图画抄。",
        "嶙峋髙疑地作限，浪渺远若天不包。",
        "是时髙秋鲈可鲙，爱欲弃绶同鱼舠。",
        "直道有知私自贺，生平欝结数日消。",
        "笑颜快意面改色，食饮惬足肠生膋。",
        "今之腐儒不可洽，欲近俗气先腥臊。",
        "寻常语我我不听，视如秋月鸣蜩蟧。",
        "数日忽得正叔语，温玉𪭢击金相敲。",
        "胸怀坦傥气焰大，天马断辔鲸横涛。",
        "惜乎偶会复促别，归鞭行袖交相飘。",
        "还家日益无聊赖，口久不语如著胶。",
        "畏人常先走木猭，得食毎后残桃螬。",
        "飘风西来岁月晚，寒压天面低不凹。",
        "一夕浓霜死群翠，病若火逼毛发焦。",
        "鸣鸿南飞地得暖，鸦乌暮去林有巢。",
        "使人对之亦自感，平时乃此穷途号。",
        "百忧丛侵方寸乱，顶髪不痒手自搔。",
        "时时强酒期自醉，不忍把笔私成骚。",
        "近嫌文字不足学，欲出简札临渊抛。",
        "惟思边堠愿得到，耳静意若闻金刀。",
        "安得铁马十数万，少负弩矢加矛腰。",
        "力在快战不愿守，直令疻鬬而血鏖。",
        "东西南北四问罪，使人不敢诬天骄。",
        "增尸为城骨筑垒，滴血衅地尘不嚣。",
        "归来再拜贺太平，亟出敌首都城枭。",
        "如何壮志不可遂，穷愁压挫朱颜雕。",
        "因君知我故道此，以代面语相喧呶。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 187851,
      "title": "赠刘成文",
      "content": [
        "予生谢早先，晚世相逅邂。",
        "礼俗不可徴，百孔千疮坏。",
        "平时以是念，食美不知囋。",
        "谁为医国者，已亟不图瘥。",
        "引脰望古人，去我远以太。",
        "斓斑纸上语，十才一二在。",
        "思人乐其言，把读不知懈。",
        "爱其善调理，未讫已期再。",
        "探窥古人心，愤懑世俗败。",
        "常思得英奇，肝肺相诱劢。",
        "以是求世人，未免许以漑。",
        "不特学忧孤，直恐性失介。",
        "呜呼圣贤人，既以舍我迈。",
        "如何有常者，亦不可得拜。",
        "虽然众嘲扬，未忍径伍哙。",
        "刘生江东儒，心臆寛不隘。",
        "遇我数日语，收若俯拾芥。",
        "久从固所望，骤得尤所快。",
        "立海观鲸鲲，乘霄饮沆瀣。",
        "和风吹滞酲，利爪搔痒疥。",
        "我质遂愧陋，香禾映粃粺。",
        "和言遂愧疏，长江掩涔派。",
        "辱索宜有献，百择无一爱。",
        "作诗期笑咍，幸无怒目睚。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 187852,
      "title": "唐介",
      "content": [
        "以谏得罪者为谁，四海多作唐介诗。",
        "俗儿口狭文字碎，欲状介事语反卑。",
        "嗟嗟我亦介之徒，此恨不助掀目眉。",
        "三更灯死百虑息，四睫不交双目眵。",
        "推枕起坐壮介节，以手扪臆为介思。",
        "信乎介亦壮男子，直能金铁其肝脾。",
        "雷霆之怒万钧重，人主之威犹过之。",
        "一语所犯百死在，要领可断族可夷。",
        "堂堂介也人之难，不畏所畏将所持。",
        "捧书入奏伏文陛，身视赴死如食饴。",
        "面折庭诤语论险，直舌铁硬坚不移。",
        "天子怒叱大臣语，众笏交抵侔戈挥。",
        "如何面笑目不瞬，气不略詟颜怡怡。",
        "即日议下得远斥，中使临遣监妻儿。",
        "奈何左右口吻毒，只有死请无还辞。",
        "然今天子甚明圣，虽暂盛怒终复归。",
        "呜呼能对治乱鉴，介也能抆其瑕疵。",
        "语曰五谏吾从讽，仲尼逮有激而为。",
        "后世巽懦禄位徒，缘此粉饰尸素非。",
        "必也事有不得已，宜乎讫死争不回。",
        "伟哉介也已不朽，日月为字天为碑。",
        "寄语琐琐媒孽子，介纵蹈死吾何悲。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 187853,
      "title": "还东野诗",
      "content": [
        "吾于古人少所同，惟识韩家十八翁。",
        "其辞浩大无崖岸，有似碧海吞浸秋晴空。",
        "此老颇自负，把人常常看。",
        "于时未尝有夸诧，只说东野口不干。",
        "我生最迟暮，不识东野身。",
        "能得韩老低头拜，料得亦是无量文章人。",
        "前日杜子长，借我孟子诗。",
        "三日三夜读不倦，坐得脊折臀生胑。",
        "旁人笑我苦若是，何为竟此故字纸。",
        "童子请我愿去烧，此诗苦澁读不喜。",
        "吾闻旁人笑，叹之殊不已。",
        "又畏童子言，藏之不敢示。",
        "奈何天下俱若然，吾与东野安得不冺焉。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 187854,
      "title": "偶作",
      "content": [
        "女丑忌明镜，不知自羞人。",
        "士丑忌公言，不知自修身。",
        "羞人不出前，丑声日可湮。",
        "修身无不至，令问日益振。",
        "镜与言何尤，见忌不见亲。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 187855,
      "title": "乌鸱",
      "content": [
        "雄乌无空冲，雌乌无定飞。",
        "一巢不易成，两口千柴枝。",
        "已髙惧风颠，已下忧人窥。",
        "欲集更自翔，既安复重移。",
        "乌巢又生乌，复哺犹可期。",
        "鸱枭亦有巢，母死子后飞。",
        "呜呼造物者，于此竟谁尸。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 187856,
      "title": "寄王正叔",
      "content": [
        "微生不过人，气力两眇么。",
        "力学失自谋，径古与今左。",
        "病世相陷贼，树性期刚果。",
        "岂不中是时，然亦未尝过。",
        "奈何众好殊，未语咻已伙。",
        "伥伥独何之，云云锐亦挫。",
        "忠言不售耳，直面屡得唾。",
        "怒目瞋以环，谤口焰而火。",
        "出门先自羞，有衣恍疑裸。",
        "过市不成步，伛偻侔鼈跛。",
        "周旋不出扉，迷若蚁循磨。",
        "人恶固为甚，自厌近亦颇。",
        "媚世定有术，欲学从谁可。",
        "必也泥自售，恐由此始祸。",
        "贤子远相问，幸有以教我。",
        "得报速是宜，翘企不容坐。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 187857,
      "title": "不愿渔  其一",
      "content": [
        "终焉可伯为，不愿为渔子。",
        "当时渭阳人，自是直钓耳。",
        "今非结网身，岂有得鱼喜。",
        "试身风波间，特用豢妻子。",
        "古今同为渔，意义不相似。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 187858,
      "title": "不愿渔  其二",
      "content": [
        "采薇南山阿，归耕南山下。",
        "食苦心无虞，守约自闲暇。",
        "出处皆有义，在理无用讶。",
        "今人举一隅，何足语学稼。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 187859,
      "title": "杂诗效孙莘老  其一",
      "content": [
        "鱼虾无所能，动辄困人得。",
        "蛟鲸能则乖，覆舟取人食。",
        "龟龞能谓殊，刳剥同一剧。",
        "龙不入网罗，亦不为人识。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 187860,
      "title": "杂诗效孙莘老  其二",
      "content": [
        "犬羊飬于人，壮则人食之。",
        "猛虎嗜人肉，终昧猎者机。",
        "豺狼与狗同，为害岂必威。",
        "封狐能为人，还作行子妻。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 187862,
      "title": "江上四首  其一",
      "content": [
        "风吹平江起长澜，野客坐啸酒在颜。",
        "兴来就上南山观。",
        "固应散发游更好，何用美质加弊冠。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 187863,
      "title": "江上四首  其二",
      "content": [
        "梦载十舟胜一钩，曳缗万里悬十牛。",
        "饱食身至东海投。",
        "还踞秦山待鱼食，所得果可𫗦九州。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 187864,
      "title": "江上四首  其三",
      "content": [
        "山头斫竹下作竿，系钩沉水坐岸观。",
        "饵微水浊鱼不干。",
        "栖迟终日或有得，归去犹可妻子欢。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 187865,
      "title": "江上四首  其四",
      "content": [
        "江头风平可照水，衣冠面目略相似。",
        "与我同笑固相喜。",
        "何用妄携客子来，不可与语祗相视。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 187866,
      "title": "饮客",
      "content": [
        "青山何岩岩，江流自浑浑。",
        "欲由白石道，先自长松门。",
        "其间有万景，轩豁忘乾坤。",
        "适可得以心，不可为客论。",
        "安得山水交，共无世俗言。",
        "携琴写古声，酌泉求清源。",
        "适时固虽疏，谋道岂不敦。",
        "谁能歌此诗，侑我饮客樽。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 187867,
      "title": "江城",
      "content": [
        "江城酒熟贱卖醉，江人提鱼不到市。",
        "半道得钱相和歌，翁倒子扶相枕睡。",
        "江南山髙不见天，江北水远无复地。",
        "马惊堕崖舟覆波，可惜行人死声利。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 187868,
      "title": "效退之青青水中蒲  其一",
      "content": [
        "双双水中凫，足短翼有余。",
        "飞髙既能远，行陆安事俱。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 187869,
      "title": "效退之青青水中蒲  其二",
      "content": [
        "双双水中凫，来疾去闲暇。",
        "江湖风晚波，泛泛自髙下。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 187870,
      "title": "效退之青青水中蒲  其三",
      "content": [
        "双双水中凫，已往又回顾。",
        "弋者窥未知，舟来避还去。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 187871,
      "title": "效退之青青水中蒲  其四",
      "content": [
        "双双水中凫，常在水中居。",
        "还有笼中鹜，腾轩仰不如。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 187872,
      "title": "效退之青青水中蒲  其五",
      "content": [
        "双双水中凫，食饱不出水。",
        "灵鳯来何时，鸿鹄志万里。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 187873,
      "title": "霜风",
      "content": [
        "霜风裂寒窗，余响到我床。",
        "闻鼠有啮声，不省何物伤。",
        "儿呼须我起，顾无灯烛光。",
        "伏枕置所念，去梦通扶桑。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 187874,
      "title": "孟子",
      "content": [
        "孟子不肯比伊尹，仲尼方可期文王。",
        "圣贤自得固厚重，庸俗始以已较量。",
        "微生喜以佞面诋，臧氏恶非礼所当。",
        "惜哉二子不自重，以人可否何不详。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 187875,
      "title": "过扬子江",
      "content": [
        "长江来何从，远自西极詹。",
        "中破蜀山流，始与巴水兼。",
        "川原日混合，激射势益严。",
        "奔浑万里流，不自顷刻淹。",
        "骇如泻天来，急若赴海添。",
        "潮汐日往复，旦暮难安恬。",
        "攻冲气何雄，吞囓势未厌。",
        "因思禹功成，自匪尭谋佥。",
        "久已口効𪡋，岂复头今黔。",
        "余来方冬时，怒风何沾沾。",
        "掀轰驾髙浪，山阜相联粘。",
        "有如合万鼎，就沸烹群𪫺。",
        "天阳盛焚烁，鬼力争炰燖。",
        "声势欲状说，有口嗟如箝。",
        "须臾稍收敛，晴风荡氛揫。",
        "涵澄动自息，拂拭痕无纤。",
        "宛然帝女镜，仰照青天奁。",
        "遐观清神心，俯视分眉髯。",
        "有如尭舜时，惠泽四海霑。",
        "登贤默与虑，流恶声无霑。",
        "洗除岩穴空，荡涤昏奸殱。",
        "恩波浩滂沛，浸润咸滋渐。",
        "群山西南来，垂天下帷幨。",
        "霜风月凌厉，紫翠生觚廉。",
        "无波互澄照，黯惨画一缣。",
        "扁舟出中流，俯仰迷顾瞻。",
        "人生贵自便，苟信何用占。",
        "方期谢黄尘，窃身放苍蒹。",
        "闲从鱼鸟游，默相蛟龙潜。",
        "筑室近钓岸，巉崕插居簷。",
        "行春掇芑薇，坐晚登鲿鲇。",
        "仰思峻极髙，俯爱善下谦。",
        "更与虚旷间，日放诗锋铦。",
        "行求避世交，望醉江城帘。",
        "出处要皆道，终穷亦何嫌。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 187876,
      "title": "晚泊",
      "content": [
        "月形如张弓，下影射秋水。",
        "寒江风静时，逮目失洲沚。",
        "渔歌去时唱，归和讙未已。",
        "岂无人间乐，自快适为喜。",
        "客子有倦怀，归心动秋苇。",
        "更假沧浪清，聊用洗尘耳。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 187877,
      "title": "姚坚老见约偶成",
      "content": [
        "初正布新和，余腊争近候。",
        "升腾阳力微，恇怯老阴鬬。",
        "江云荡空碧，疏雨沐清昼。",
        "林梢释冬枯，土蘖壮春簇。",
        "萎蕤风日舒，刻画山野秀。",
        "关关先春鸟，格磔弄晴咮。",
        "无人与调和，终日自嘲诟。",
        "唯君卜近适，过我许来就。",
        "迁延日屡蹉，叹惜月复彀。",
        "人生诚多故，世事那可究。",
        "惟当自推置，障绝俗虑寇。",
        "休闲倘能偷，疏懒当自宥。",
        "徒行苟惮劳，借马欲谁廏。",
        "清沽如定携，佳客可先购。",
        "勉之无使迟，梅蕚已堪齅。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 187878,
      "title": "初闻思归鸟忆昨寄崔伯易朱元弼",
      "content": [
        "去年春日花盛开，尝有鸟啼归去来。",
        "余诗告尔东海志，子笑属我南山杯。",
        "将睎遐踪蹈髙轶，就拔去迹离俗埋。",
        "同时游者最谁上，朱子峭擢凌春材。",
        "门关午景卧正懒，过我呼号如春雷。",
        "邻惊偷窥妇女怪，婢骇奔走儿童咍。",
        "门开纳坐听论列，笑口侈哆倾胸怀。",
        "寒葅半菽要同飰，韲醤叫乞喧邻隈。",
        "僧从南浮云异角，尉解西去遗亭台。",
        "心争夸漫诘蜒蜿，日乐虚豁留崔嵬。",
        "柳梢黪黪坌晴絮，杏蕚烁烁翻遗埃。",
        "春湖平停照空碧，淮帆晓上搀天桅。",
        "西归颇阨穷饿久，南泛未免丐乞哀。",
        "朅来随人事卑折，忽自顾影惭低摧。",
        "平时客坐不敢语，苟以唯诺偿嫌猜。",
        "胸中纠结浩千万，到口不吐如横枚。",
        "比来颇自拨俗碍，日傍竹树良徘徊。",
        "昏昏万事置不省，知已疏懒心难裁。",
        "一闻春风动啼鸟，猛若重睡忽唤回。",
        "咨嗟岁月急若矢，叹息无地安蒿莱。",
        "比于见人日加懒，行恐合俗老益乖。",
        "不知飘浮寄兹世，竟亦何计收形骸。",
        "春林沾沾风日好，飞止自便宜尔谐。",
        "何为犹尚归不得，世间万事真悠哉。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 187879,
      "title": "望招隐山花回游江山思崔伯易因寄朱元弼",
      "content": [
        "春山晒日开百花，红紫乱眼生交加。",
        "青天晴髙褰翠幄，绣被堆叠帝所家。",
        "平江千里铺一席，扁舟脱若弃履舄。",
        "安得一醉眠千年，世间万事都弃捐。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 187880,
      "title": "同顾保之游灵隐",
      "content": [
        "闭门不知春色到，出城始见江梅开。",
        "行探幽泉至髙绝，共坐巨石聊徘徊。",
        "时逢天风吹客过，还有野鸟惊人来。",
        "林间躬惜所未历，归马空载斜阳回。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 187881,
      "title": "扬子江阻风",
      "content": [
        "扬子江风十月初，西驾巨浪渺无隅。",
        "常忧倾摇地为动，意欲起塞天无虚。",
        "大舟不行就系岸，小舟分去争得鱼。",
        "舟中壮士起坐笑，有酒更为斜阳酤。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 187882,
      "title": "山中",
      "content": [
        "山中亦有出山路，山人自不与世通。",
        "拂衣起行饮流水，枕书就卧听松风。",
        "地寛江河竞摇荡，天濶日月争西东。",
        "乾坤自为四时役，万事不到幽人胸。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 187883,
      "title": "出门",
      "content": [
        "出门万事非，聊复闭关坐。",
        "亲识久相远，与世绝吊贺。",
        "适时既非谋，接俗益加惰。",
        "外物等不来，何必问客过。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 187884,
      "title": "南徐怀古",
      "content": [
        "昔人战血化为土，今人常怀昔人苦。",
        "大江冥冥截海流，铁瓮城髙排万虎。",
        "乾坤未定龙蛇争，日月须归仁义主。",
        "江山本不为英雄，英雄自负江山死。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 187885,
      "title": "东城",
      "content": [
        "昔予出东城，初见垄上耕。",
        "忽忽自北至，岁月令人惊。",
        "虽云一草死，万物尚华荣。",
        "谁能当此时，叹息微阴生。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 187886,
      "title": "饿虎不食子",
      "content": [
        "饿虎不食子，饥鹰不雌求。",
        "虎饿不择肉，盛怒遇子收。",
        "鹰饥爪喙狞，尚与雌同鞲。",
        "人岂二者然，恩义宜绸缪。",
        "亲戚不宜怒，割恩以为仇。",
        "此割非常割，此伤无血流。",
        "肉割愈有日，恩割伤不收。",
        "一割大义死，再割面相仇。",
        "亲戚尚皆然，况又他人俦。",
        "是己与世绝，于世何足尤。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 187887,
      "title": "松江曲",
      "content": [
        "松江深处八九尺，去眼百里长风波。",
        "吾山井泉废不汲，一泓不知深几何。",
        "君家自无千尺绠，那知江深不如井。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 187888,
      "title": "赠王介甫",
      "content": [
        "当世胸怀万古淳，平生才术老经纶。",
        "况逢尭舜登贤日，不复伊周望古人。",
        "得志定知移弊俗，闻风犹足警斯民。",
        "九门无谒天旒邃，何惜长令仕为贫。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 187889,
      "title": "赠王平甫",
      "content": [
        "当世所交识者稀，十年闻子幸见之。",
        "平生所负自信重，他日可期人莫知。",
        "谁肯草茅穷钓筑，世方简策诵臯夔。",
        "丈夫出处诚何较，却痛苍生为泪垂。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 187890,
      "title": "赠孙莘老",
      "content": [
        "至愚不学常如足，盛德之充久自彰。",
        "管小始疑天可尽，绠穷终信海非量。",
        "始惭自待从来薄，不及时中适取狂。",
        "安得此生天与幸，没身得不去门墙。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 187891,
      "title": "思京口戯周器之",
      "content": [
        "江南别日醉方醺，贪爱青天带水痕。",
        "忘却碧山归路直，误投浮世俗尘昏。",
        "终期散发江边钓，当有渔舟日系门。",
        "但恨故人犹喜仕，他时胸腹未堪论。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 187892,
      "title": "舟中作",
      "content": [
        "杳杳波涛去莫穷，要须流合海天东。",
        "长帆百尺嗟无用，醉绝重湖笑逆风。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 187893,
      "title": "寄束伯仁",
      "content": [
        "身逐南舟去不回，匡庐留滞得徘徊。",
        "峰头夜宿平看斗，岩下朝阴俯听雷。",
        "西顾波涛浮日月，东归天地入尘埃。",
        "何时得遂幽栖志，常把韦编静处开。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 187894,
      "title": "题假山",
      "content": [
        "扰扰人心巧谓何，我肠愚只爱无它。",
        "目前好且留平地，浪爱山髙险自多。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 187895,
      "title": "夜归",
      "content": [
        "冲冲行路自多岐，已踏归途尚虑非。",
        "夜犬只知人是盗，不知人亦夜来归。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 187896,
      "title": "口占示姊",
      "content": [
        "盎竭嚢空且笑歌，更从吾命听如何。",
        "不须直有牛羊乐，只以无求富自多。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 187897,
      "title": "孙莘老将赴太平二首  其一",
      "content": [
        "先生素志已形诗，弟子何妨鼓瑟希。",
        "时若伊周方有任，命如孔孟可无归。",
        "要终四海乘槎去，髙谢西山食粟非。",
        "此道难言身未果，且当从世共依违。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 187898,
      "title": "孙莘老将赴太平二首  其二",
      "content": [
        "纷纷世俗竞朱金，仕道人人说直寻。",
        "但以一官求飬志，岂于千古有遗心。",
        "嗜偏羊枣情何甚，戯及牛刀意自深。",
        "何日山林遂归计，南风进讲五弦琹。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 187899,
      "title": "露筋贞女庙",
      "content": [
        "待夫以死如知命，信己轻生可谓贞。",
        "指尔为愚今尚众，莫言吾志不难行。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 187900,
      "title": "渰渰",
      "content": [
        "渰渰轻云弄落晖，坏簷巢满燕来归。",
        "小园桃李东风后，却看杨花自在飞。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 187901,
      "title": "寄聱隅先生黄晞",
      "content": [
        "王朝簪笏拥天扉，肯以经纶假布衣。",
        "老信苍生终有命，穷忧当世益思归。",
        "一身谁作千年望，两眼空看万事非。",
        "闻说韦编日开阅，可应三复叹知几。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 187902,
      "title": "春愁",
      "content": [
        "只闻来客说春游，不逐花前笑自留。",
        "浪说春期计春尽，留春无术只春愁。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 187903,
      "title": "少年答春愁",
      "content": [
        "花枝袅袅笑当觞，且作春风几日狂。",
        "纵使春归犹有酒，酒酣春去亦何伤。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 187904,
      "title": "和朱元弼春游",
      "content": [
        "闭门无著只疏慵，谩出留连与众同。",
        "柳却有情愁落日，花惟能笑谢东风。",
        "恨无日到三春外，尽看人狂六极中。",
        "泛泛相逢且相笑，久将吾道付穷通。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 187905,
      "title": "春日",
      "content": [
        "提壶聒聒惟呼酒，杜宇喧喧只说归。",
        "坐怪鸟声皆有取，静于人事益知非。",
        "已嫌世浊胡为混，能待河清固已稀。",
        "为语夷齐既甘饿，可能分我首阳薇。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 187906,
      "title": "对花",
      "content": [
        "忧愁卒卒人无乐，花草纷纷物又春。",
        "安得无忧与无虑，对花还作笑歌人。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 187907,
      "title": "靡靡",
      "content": [
        "源源世俗尚依违，靡靡风流日正微。",
        "吾病未能终是是，人言何似喜非非。",
        "况当天下难能地，欲拨𪫺人未发机。",
        "要格君心是知术，不然应合买山归。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 187908,
      "title": "观水",
      "content": [
        "细如虾蚓足留连，大可蛟鲸出自然。",
        "当使川流应到海，只今坎止亦成渊。",
        "民忧不见尭咨日，地碍何由禹凿穿。",
        "可惜卧龙无意思，不随云去雨春田。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 187909,
      "title": "读孟子",
      "content": [
        "去梁无故又辞齐，弟子纷纷益不知。",
        "天下未平虽我事，己身已枉更何为。",
        "后来谁是闻风者，当世何尝不召师。",
        "士要自髙无顾世，遗编今亦有人疑。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 187910,
      "title": "鹳",
      "content": [
        "毛羽人将鹤品流，斜阳髙处自迟留。",
        "人言杀尔三年旱，应是巢成更不忧。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 187911,
      "title": "寄朱元弼",
      "content": [
        "春城春雨绿春潭，冉冉归舟上去帆。",
        "爱子有诗留我别，悔予无酒伴君衔。",
        "东风随卷行人袖，落日犹明去客衫。",
        "好有新诗寄幽寂，我心无泊似摇窗。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 187912,
      "title": "春游",
      "content": [
        "春城儿女纵春游，醉倚层台笑上楼。",
        "满眼落花多少意，若何无个解春愁。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 187913,
      "title": "龙池二绝  其一",
      "content": [
        "满目尘埃白日阴，皇天无命且深沉。",
        "终当力卷沧溟水，来作人间十日霖。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 187914,
      "title": "龙池二绝  其二",
      "content": [
        "尽道神龙此有灵，一池澄静暮痕清。",
        "如何蟠屈无飞志，却放鸣蛙有怒声。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 187915,
      "title": "月蚀",
      "content": [
        "卢仝不作昌黎死，天目虽盲未见嗟。",
        "坐叹清光无惜处，一将吞吐听虾蟆。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 187916,
      "title": "偶成",
      "content": [
        "种花红不实，俗客醉仍喧。",
        "拔去树嘉谷，日无人过门。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 187917,
      "title": "偶感",
      "content": [
        "壮志老来退，穷愁无易攻。",
        "风云诗气焰，天地醉心胸。",
        "午枕著不觉，昼门关更慵。",
        "由来自疏拙，底处不相容。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 187918,
      "title": "寄满子权",
      "content": [
        "西北风吹数纸诗，神门枢钥鬼关机。",
        "九原黄土英灵活，万古青天霹雳飞。",
        "我是懦夫无壮志，近思依日窃余辉。",
        "髙楼暮插暗空肋，东望君心着翅归。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 187919,
      "title": "寄洪与权",
      "content": [
        "剑气寒髙倚暮空，男儿日月鏁心胸。",
        "莫藏牙爪同痴虎，好召风雷起卧龙。",
        "旧说王侯无世种，古尝富贵及耕佣。",
        "须将大道为奇遇，莫踏人间龌龊踪。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 187920,
      "title": "上聱隅先生",
      "content": [
        "夫子儒门杰，心诚行亦醇。",
        "玉金精粹美，椒桂性芬辛。",
        "一入随邦计，咸期利国宾。",
        "生民待儒效，天意属人伦。",
        "蜀犬争惊日，邹人不识麟。",
        "穷途千古泪，白发四方尘。",
        "弊世谁思救，仁贤自合振。",
        "爱狙徒食费，好鹤浪轩驯。",
        "不结临川网，偷安厝火薪。",
        "忠言惊苦逆，恬议贵因循。",
        "漆轨书三上，清时死九滨。",
        "不思防蚁壌，徒欲衞龙鳞。",
        "当道豺狼愎，升堂犬马嚚。",
        "旱余云不雨，命塞器藏身。",
        "独抱遗经老，来为后进陈。",
        "手提三圣出，口压九师堙。",
        "众耳雷霆震，群观日月新。",
        "韦编重断绝，文席互酬询。",
        "鲁变全归道，陈粮绝更贫。",
        "贱生无自幸，俗系弗容亲。",
        "盆覆徒经日，龟埋不伏人。",
        "短诗徒自讼，已伏下斯民。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 187921,
      "title": "春晚雨后",
      "content": [
        "东风柔弱事春权，剧雨无端转怆然。",
        "不惜好花都委地，却令远草直平天。",
        "龙蛇久蛰应思奋，蛙蝈乘时巳自先。",
        "绿柳由来却堪笑，叶眉愁剧遂长眠。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 187922,
      "title": "良农",
      "content": [
        "良农手足胝，老贾不亲犂。",
        "歉岁糠糟绝，髙门犬马肥。",
        "天心不宜咎，人理自谁尸。",
        "安得悠悠者，来同予一悲。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 187923,
      "title": "琼花",
      "content": [
        "无双亭下枝，密密复稀稀。",
        "蚌碎珠骈出，须牵蝶合围。",
        "会须珍作宝，常恐散成飞。",
        "况是东风后，游人莫易归。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 187924,
      "title": "夜深吟",
      "content": [
        "叩几悲歌涕满襟，圣贤千古我如今。",
        "冻琴弦断灯青晕，谁会男儿半夜心。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 187925,
      "title": "和人春雪",
      "content": [
        "莫叹年来雪句迟，雪迟诗句更依微。",
        "风来海国盐波涸，春入仙田玉气肥。",
        "雏鹤暖娇揺羽脱，老龙枯痒退鳞飞。",
        "天工人代如端的，安得吾能及九畿。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 187926,
      "title": "纸鸢",
      "content": [
        "谁作轻鸢壮远观，似嫌飞鸟未多端。",
        "才乘一线凭风去，便有愚儿仰面看。",
        "未必碧霄因可到，偶能终日遂为安。",
        "扶揺不起沧溟远，笑杀鹏搏似尔难。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 187927,
      "title": "赠别晏樊父太祝",
      "content": [
        "缩伏蒿莱听命沉，旧房孤剑铁尘侵。",
        "方思力举沧溟水，泼杀生平气焰心。",
        "不谓偶君夸意气，无端起我旧胸襟。",
        "男儿合是公侯器，未忍风前堕泪吟。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 187928,
      "title": "和洪与权",
      "content": [
        "沟中老弱转流尸，夫不容妻母弃儿。",
        "常得民愚犹是幸，不然死等更何为。",
        "布衣空有蒿莱泪，肉食方多妾马思。",
        "君也天心省民数，未知死所又何辞。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 187929,
      "title": "题天长县苏太尉庙",
      "content": [
        "唐室无臣覆手移，坐看悍媪制庸儿。",
        "思量可惜当年死，却是西来问鼎师。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 187930,
      "title": "春雪有感呈王正叔束徽之",
      "content": [
        "彼雪晚何滛，乘时横此临。",
        "必将滋及物，自合大为霖。",
        "也道春来好，何余臈后阴。",
        "冬冥诚不道，苍帝亦何心。",
        "俗口夸同粉，愚观谓似琳。",
        "独于平处薄，不似险中深。",
        "逆吹争为力，凌寒苦助侵。",
        "落疑天未悟，压恐地难任。",
        "蛰户开重墐，冰鱼上复沉。",
        "欲开花谩妬，垂死草奚禁。",
        "短韵徒堪叹，凭君附入琴。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 187931,
      "title": "古鉴",
      "content": [
        "一片灵光合有神，不知镕铸更何人。",
        "春耕破塜衣冠尽，鬼手摩天日月新。",
        "鉴面祗知西子姣，照心难见比干真。",
        "主人深有收藏意，当待清明不受尘。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 187932,
      "title": "代人送常州致仕张待制",
      "content": [
        "心贪进退适全宜，上印飞书剧去翚。",
        "荐口不加张柬老，明朝竟放孔戣归。",
        "黄堂合有遗思在，青史还留后世稀。",
        "此去江湖见鸥鸟，为言今合信无机。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 187933,
      "title": "代人送常州张卿挂冠",
      "content": [
        "清优四皓官，潇洒二疏颜。",
        "直道空华发，明时独买山。",
        "如闻元老议，尚恐輭轮还。",
        "谁是尘埃者，清风合自攀。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 187934,
      "title": "谢束丈",
      "content": [
        "卓郑簪裾密作林，相如贫病强来临。",
        "藜羮才饱无他志，肉食俄充有愧心。",
        "死马偶能逢市骨，滥竽常恐负知音。",
        "古来一饭皆论报，何日王孙遂有金。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 187935,
      "title": "和束熙之雨后",
      "content": [
        "猎猎风吹雨气腥，谁翻碧海踏天倾。",
        "如何农畯三时望，只得官蛙一处鸣。",
        "何处断虹残冷落，有时斜照𫏐分明。",
        "当车收辙云藏迹，依旧晴空万里平。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 187936,
      "title": "寄衡父满翁",
      "content": [
        "只卓来篇不许双，社坛髙处立旌幢。",
        "自知孤敌难为胜，欲竖长幡一面降。",
        "须学依墙勤哭楚，莫同伏弩助收庞。",
        "何时玉手归重搦，笑倒秋醪潋灔缸。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 187937,
      "title": "幽居感怀寄满子权",
      "content": [
        "卜得幽居四绝邻，寻常庭巷断蹄轮。",
        "门前犬豕卧横道，城上牛羊下视人。",
        "满眼夕阳闲草树，回头归路正埃尘。",
        "思君未有东来计，何日双眉对面伸。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 187938,
      "title": "偶成",
      "content": [
        "十日九自病，偶平还苦吟。",
        "万金无枉志，千古有遗心。",
        "静隐支凭几，寒搔髪解簪。",
        "南风久寂寞，谁继五弦琴。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 187939,
      "title": "信笔",
      "content": [
        "纷纷世趣竟多途，失在从人得在吾。",
        "苟获一时儿女笑，定罹千古圣贤诛。",
        "微生何事疑人佞，孟子当年亦自迂。",
        "满眼悠悠懒商较，尽留来者议贤愚。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 187940,
      "title": "蜣蜋",
      "content": [
        "扰扰蜣蜋不足评，区区只逐粪丸行。",
        "若乘饮露嘶风便，又作人间第一清。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 187941,
      "title": "答王薄正叔",
      "content": [
        "当年论友笑常情，谁使风波忽沸腾。",
        "自有赤心包白日，竟无绮语敌青蝇。",
        "重来赭面还如火，自许清诚卒似冰。",
        "反复来篇却堪叹，待将遗恨寄朱绳。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 187942,
      "title": "秋怀寄呈子权先示徽之兼简孝先熙之",
      "content": [
        "树哭寒蜩草哭虫，何堪覊客愤时穷。",
        "卒无可乐群书外，百不堪言一叹中。",
        "云黯暮天沉白日，土尘平地断清风。",
        "夫君若问秋来况，泪满遗编髪乱蓬。"
      ],
      "author": {
        "id": 4561,
        "name": "王令"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    }
  ],
