{
  "data": [
    {
      "id": 308703,
      "title": "留别司马太守",
      "content": [
        "辰阳太守念王孙，远谪沅谿何可论。",
        "黄鹤青云当一举，明珠吐著抱君恩。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 308704,
      "title": "卢溪主人",
      "content": [
        "武陵溪口驻扁舟，溪水随君向北流。",
        "行到荆门上三峡，莫将孤月对猿愁。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 308705,
      "title": "送程六",
      "content": [
        "冬夜伤离在五溪，青鱼雪落鲙橙虀。",
        "武冈前路看斜月，片片舟中云向西。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 308706,
      "title": "送朱越",
      "content": [
        "远别舟中蒋山暮，君行举首燕城路。",
        "蓟门秋月隐黄云，期向金陵醉江树。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 308707,
      "title": "别辛渐",
      "content": [
        "别馆萧条风雨寒，扁舟月色渡江看。",
        "酒酣不识关西道，却望春江云尚残。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 308708,
      "title": "送柴侍御",
      "content": [
        "流水通波接武冈，送君不觉有离伤。",
        "青山一道同云雨，眀月何曽是两乡。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 308709,
      "title": "送万大归长沙",
      "content": [
        "桂阳秋水长沙县，楚竹离声为君变。",
        "青山隐隐孤舟微，白鹤双飞忽相见。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 308710,
      "title": "送吴十九往沅陵",
      "content": [
        "沅江流水到辰阳，谿口逢君驿路长。",
        "远谪谁知望雷雨，明年春水共还乡。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 308711,
      "title": "别皇甫五",
      "content": [
        "溆浦潭阳隔楚山，离尊不用起愁颜。",
        "明祠灵响期昭应，天泽俱从此路还。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 308712,
      "title": "送崔参军往龙溪",
      "content": [
        "龙溪只在龙标上，秋月孤山两相向。",
        "谴谪离心是丈夫，鸿恩共侍春江涨。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 308713,
      "title": "送郑判官",
      "content": [
        "东楚吴山驿树微，轺车衔命奉恩辉。",
        "英僚携出新丰酒，半道遥看骢马归。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 308714,
      "title": "送姚司法归吴",
      "content": [
        "吴掾留觞楚郡心，洞庭秋雨海门阴。",
        "但令意远扁舟近，不道沧江百丈深。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 308715,
      "title": "送高三之桂林",
      "content": [
        "留君夜饮对潇湘，从此归舟客梦长。",
        "岭上梅花侵雪暗，归时还拂桂花香。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 308716,
      "title": "旅望",
      "content": [
        "白花原头望京师，黄河水流无尽时。",
        "穷秋旷野行人绝，马首东来知是谁。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 308717,
      "title": "题朱炼师山房",
      "content": [
        "叩齿焚香出世尘，斋坛鸣磬步虚人。",
        "百花仙酝能留客，一饭胡麻度几春。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 308718,
      "title": "武陵开元观黄炼师院三首 一",
      "content": [
        "松间白发黄尊师，童子烧香禹步时。",
        "欲访桃源入溪路，忽闻鸡犬使人疑。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 308719,
      "title": "武陵开元观黄炼师院三首 二",
      "content": [
        "先贤盛说桃花源，尘忝何堪武陵郡。",
        "闻道秦时避地人，至今不与人通问。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 308720,
      "title": "武陵开元观黄炼师院三首 三",
      "content": [
        "山观空虚清静门，从官役吏扰尘喧。",
        "暂因问俗到真境，便欲投诚依道源。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 308721,
      "title": "河上老人歌",
      "content": [
        "河上老人坐古槎，合丹只用青莲花。",
        "至今八十如四十，口道沧溟是我家。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 308722,
      "title": "春怨",
      "content": [
        "音书杜绝白狼西，桃李无颜黄鸟啼。",
        "寒雁春深归去尽，出门肠断草萋萋。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 308723,
      "title": "句",
      "content": [
        "朝荐抱良策，独倚江城楼。",
        "昨从金陵邑，远谪沅溪滨。",
        "娟魄已三孕。",
        "驾幸温泉日，严霜子月初。",
        "长亭酒未醒，千里风动地。",
        "苍荻寒沧江，石头岸边饮。",
        "天仗森森练雪凝，身骑铁骢自臂鹰。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 334370,
      "title": "横吹曲辞：出塞",
      "content": [
        "秦时明月汉时关，万里长征人未还。",
        "但使龙城飞将在，不教胡马度阴山。",
        "白花垣上望京师，黄河水流无尽时。",
        "穷秋旷野行人绝，马首东来知是谁。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 334510,
      "title": "相和歌辞：长歌行",
      "content": [
        "旷野饶悲风，飕飕黄蒿草。",
        "系马停白杨，谁知我怀抱。",
        "所是同袍者，相逢尽衰老。",
        "况登汉家陵，南望长安道。",
        "下有枯树根，上有鼷鼠窠。",
        "高皇子孙尽，千古无人过。",
        "宝玉频发掘，精灵其奈何。",
        "人生须达命，有酒且长歌。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 334564,
      "title": "相和歌辞：从军行",
      "content": [
        "向夕临大荒，朔风轸归虑。",
        "平沙万里余，飞鸟宿何处。",
        "虏骑猎长原，翩翩傍河去。",
        "边声摇白草，海气生黄雾。",
        "百战苦风尘，十年履霜露。",
        "虽投定远笔，未坐将军树。",
        "早知行路难，悔不理章句。",
        "烽火城西百尺楼，黄昏独上海风秋。",
        "更吹横笛关山月，谁解金闺万里愁。",
        "琵琶起舞换新声，总是关山旧别情。",
        "撩乱边愁弹不尽，高高秋月下长城。",
        "青海长云暗雪山，孤城遥望雁门关。",
        "黄沙百战穿金甲，不破楼兰终不还。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 334612,
      "title": "相和歌辞：放歌行",
      "content": [
        "南渡洛阳津，西望十二楼。",
        "明堂坐天子，月朔朝诸侯。",
        "清乐动千门，皇风被九州。",
        "庆云从东来，泱漭抱日流。",
        "升平贵论道，文墨将何求。",
        "有诏征草泽，微臣献谋猷。",
        "冠冕如星罗，拜揖曹与周。",
        "望尘非吾事，入赋且迟留。",
        "幸蒙国士识，因脱负薪裘。",
        "今者放歌行，以慰梁父愁。",
        "但营数斗禄，奉养毋丰羞。",
        "若得金膏遂，飞云亦可俦。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 334687,
      "title": "相和歌辞：长信怨",
      "content": [
        "金井梧桐秋叶黄，珠帘不卷夜来霜。",
        "金炉玉枕无颜色，卧听南宫清漏长。",
        "奉帚平明金殿开，暂将团扇共裴回。",
        "玉颜不及寒鸦色，犹带昭阳日影来。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 334770,
      "title": "相和歌辞：采莲曲三首",
      "content": [
        "吴姬越艳楚王妃，争弄莲舟水湿衣。",
        "来时浦口花迎入，采罢江头月送归。",
        "荷叶罗裙一色裁，芙蓉向脸两边开。",
        "乱入池中看不见，闻歌始觉有人来。",
        "越女作桂舟，还将桂为楫。",
        "湖上水渺漫，清江初可涉。",
        "摘取芙蓉花，莫摘芙蓉叶。",
        "将归问夫婿，颜色何如妾。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 334941,
      "title": "杂曲歌辞：少年行二首",
      "content": [
        "西陵侠年少，送客过长亭。",
        "青槐夹两路，白马如流星。",
        "闻道羽书急，单于寇井陉。",
        "气高轻赴难，谁顾燕山铭。",
        "走马还相寻，西楼下夕阴。",
        "结交期一剑，留意赠千金。",
        "高阁歌声远，重关柳色深。",
        "夜闲须尽醉，莫负百年心。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 335028,
      "title": "杂曲歌辞：变行路难",
      "content": [
        "向晚横吹悲，风动马嘶合。",
        "前驱引旗节，千重阵云匝。",
        "单于下阴山，砂砾空飒飒。",
        "封侯取一战，岂复念闺阁。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 339295,
      "title": "变行路难",
      "content": [
        "向晚横吹悲，风动马嘶合。",
        "前驱引旗节，千里阵云匝。",
        "单于下阴山，砂砾空飒飒。",
        "封侯取一战，岂复念闺阁。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 339296,
      "title": "塞下曲四首",
      "content": [
        "蝉鸣空桑林，八月萧关道。",
        "出塞入塞寒，处处黄芦草。",
        "从来幽并客，皆共尘沙老。",
        "莫学游侠儿，矜夸紫骝好。",
        "饮马渡秋水，水寒风似刀。",
        "平沙日未没，黯黯见临洮。",
        "昔日长城战，咸言意气高。",
        "黄尘足今古，白骨乱蓬蒿。",
        "奉诏甘泉宫，总征天下兵。",
        "朝廷备礼出，郡国豫郊迎。",
        "纷纷几万人，去者无全生。",
        "臣愿节宫厩，分以赐边城。",
        "边头何惨惨，已葬霍将军。",
        "部曲皆相吊，燕南代北闻。",
        "功勋多被黜，兵马亦寻分。",
        "更遣黄龙戍，唯当哭塞云。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 339297,
      "title": "塞上曲",
      "content": [
        "秋风夜渡河，吹却雁门桑。",
        "遥见胡地猎，鞲马宿严霜。",
        "五道分兵去，孤军百战场。",
        "功多翻下狱，士卒但心伤。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 339298,
      "title": "从军行二首",
      "content": [
        "向夕临大荒，朔风轸归虑。",
        "平沙万里余，飞鸟宿何处。",
        "虏骑猎长原，翩翩傍河去。",
        "边声摇白草，海气生黄雾。",
        "百战苦风尘，十年履霜露。",
        "虽投定远笔，未坐将军树。",
        "早知行路难，悔不理章句。",
        "秋草马蹄轻，角弓持弦急。",
        "去为龙城战，正值胡兵袭。",
        "军气横大荒，战酣日将入。",
        "长风金鼓动，白露铁衣湿。",
        "四起愁边声，南庭时伫立。",
        "断蓬孤自转，寒雁飞相及。",
        "万里云沙涨，平原冰霰涩。",
        "惟闻汉使还，独向刀环泣。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 339299,
      "title": "少年行二首",
      "content": [
        "西陵侠少年，送客短长亭。",
        "青槐夹两道，白马如流星。",
        "闻道羽书急，单于寇井陉。",
        "气高轻赴难，谁顾燕山铭。",
        "走马远相寻，西楼下夕阴。",
        "结交期一剑，留意赠千金。",
        "高阁歌声远，重门柳色深。",
        "夜阑须尽饮，莫负百年心。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 339300,
      "title": "长歌行",
      "content": [
        "旷野饶悲风，飕飕黄蒿草。",
        "系马倚白杨，谁知我怀抱。",
        "所是同袍者，相逢尽衰老。",
        "北登汉家陵，南望长安道。",
        "下有枯树根，上有鼯鼠窠。",
        "高皇子孙尽，千载无人过。",
        "宝玉频发掘，精灵其奈何。",
        "人生须达命，有酒且长歌。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 339301,
      "title": "悲哉行",
      "content": [
        "勿听白头吟，人间易忧怨。",
        "若非沧浪子，安得从所愿。",
        "北上太行山，临风阅吹万。",
        "长云数千里，倏忽还肤寸。",
        "观其微灭时，精意莫能论。",
        "百年不容息，是处生意蔓。",
        "始悟海上人，辞君永飞遁。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 339303,
      "title": "放歌行",
      "content": [
        "南渡洛阳津，西望十二楼。",
        "明堂坐天子，月朔朝诸侯。",
        "清乐动千门，皇风被九州。",
        "庆云从东来，泱漭抱日流。",
        "升平贵论道，文墨将何求。",
        "有诏征草泽，微诚将献谋。",
        "冠冕如星罗，拜揖曹与周。",
        "望尘非吾事，入赋且迟留。",
        "幸蒙国士识，因脱负薪裘。",
        "今者放歌行，以慰梁甫愁。",
        "但营数斗禄，奉养每丰羞。",
        "若得金膏遂，飞云亦可俦。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 339304,
      "title": "《越女",
      "content": [
        "越女作桂舟，还将桂为楫。",
        "湖上水渺漫，清江不可涉。",
        "摘取芙蓉花，莫摘芙蓉叶。",
        "将归问夫婿，颜色何如妾。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 339305,
      "title": "郑县宿陶太公馆中赠冯六元二",
      "content": [
        "儒有轻王侯，脱略当世务。",
        "本家蓝田下，非为渔弋故。",
        "无何困躬耕，且欲驰永路。",
        "幽居与君近，出谷同所骛。",
        "昨日辞石门，五年变秋露。",
        "云龙未相感，干谒亦已屡。",
        "子为黄绶羁，余忝蓬山顾。",
        "京门望西岳，百里见郊树。",
        "飞雨祠上来，霭然关中暮。",
        "驱车郑城宿，秉烛论往素。",
        "山月出华阴，开此河渚雾。",
        "清光比故人，豁达展心晤。",
        "冯公尚戢翼，元子仍局步。",
        "拂衣易为高，沦迹难有趣。",
        "张范善终始，吾等岂不慕。",
        "罢酒当凉风，屈伸备冥数。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 339307,
      "title": "缑氏尉沈兴宗置酒南溪留赠",
      "content": [
        "林色与溪古，深篁引幽翠。",
        "山尊在渔舟，棹月情已醉。",
        "始穷清源口，壑绝人境异。",
        "春泉滴空崖，萌草拆阴地。",
        "久之风榛寂，远闻樵声至。",
        "海雁时独飞，永然沧洲意。",
        "古时青冥客，灭迹沦一尉。",
        "吾子踌躇心，岂其纷埃事。",
        "缑峰信所克，济北余乃遂。",
        "齐物意已会，息肩理犹未。",
        "卷舒形性表，脱略贤哲议。",
        "仲月期角巾，饭僧嵩阳寺。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 339311,
      "title": "出郴山口至叠石湾野人室中寄张十一",
      "content": [
        "槠楠无冬春，柯叶连峰稠。",
        "阴壁下苍黑，烟含清江楼。",
        "景开独沿曳，响答随兴酬。",
        "旦夕望吾友，如何迅孤舟。",
        "叠沙积为岗，崩剥雨露幽。",
        "石脉尽横亘，潜潭何时流。",
        "既见万古色，颇尽一物由。",
        "永与世人远，气还草木收。",
        "盈缩理无余，今往何必忧。",
        "郴土群山高，耆老如中州。",
        "孰云议舛降，岂是娱宦游。",
        "阴火昔所伏，丹砂将尔谋。",
        "昨临苏耽井，复向衡阳求。",
        "同疚来相依，脱身当有筹。",
        "数月乃离居，风湍成阻修。",
        "野人善竹器，童子能溪讴。",
        "寒月波荡漾，羁鸿去悠悠。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 339312,
      "title": "宿灞上寄侍御玙弟",
      "content": [
        "独饮灞上亭，寒山青门外。",
        "长云骤落日，桑枣寂已晦。",
        "古人驱驰者，宿此凡几代。",
        "佐邑由东南，岂不知进退。",
        "吾宗秉全璞，楚得璆琳最。",
        "茅山就一征，柏署起三载。",
        "道契非物理，神交无留碍。",
        "知我沧溟心，脱略腐儒辈。",
        "孟冬銮舆出，阳谷群臣会。",
        "半夜驰道喧，五侯拥轩盖。",
        "是时燕齐客，献术蓬瀛内。",
        "甚悦我皇心，得与王母对。",
        "贱臣欲干谒，稽首期殒碎。",
        "哲弟感我情，问易穷否泰。",
        "良马足尚踠，宝刀光未淬。",
        "昨闻羽书飞，兵气连朔塞。",
        "诸将多失律，庙堂始追悔。",
        "安能召书生，愿得论要害。",
        "戎夷非草木，侵逐使狼狈。",
        "虽有屠城功，亦有降虏辈。",
        "兵粮如山积，恩泽如雨霈。",
        "羸卒不可兴，碛地无足爱。",
        "若用匹夫策，坐令军围溃。",
        "不费黄金资，宁求白璧赉。",
        "明主忧既远，边事亦可大。",
        "荷宠务推诚，离言深慷慨。",
        "霜摇直指草，烛引明光佩。",
        "公论日夕阻，朝廷蹉跎会。",
        "孤城海门月，万里流光带。",
        "不应百尺松，空老钟山霭。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 339313,
      "title": "次汝中寄河南陈赞府",
      "content": [
        "汝山方联延，伊水才明灭。",
        "遥见入楚云，又此空馆月。",
        "纷然驰梦想，不谓远离别。",
        "京邑多欢娱，衡湘暂沿越。",
        "明湖春草遍，秋桂白花发。",
        "岂惟长思君，日夕在魏阙。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 339317,
      "title": "送任五之桂林",
      "content": [
        "楚客醉孤舟，越水将引棹。",
        "山为两乡别，月带千里貌。",
        "羁谴同缯纶，僻幽闻虎豹。",
        "桂林寒色在，苦节知所效。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 339318,
      "title": "山中别庞十",
      "content": [
        "幽娟松筱径，月出寒蝉鸣。",
        "散发卧其下，谁知孤隐情。",
        "吟时白云合，钓处玄潭清。",
        "琼树方杳霭，凤兮保其贞。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 339320,
      "title": "送韦十二兵曹",
      "content": [
        "县职如长缨，终日检我身。",
        "平明趋郡府，不得展故人。",
        "故人念江湖，富贵如埃尘。",
        "迹在戎府掾，心游天台春。",
        "独立浦边鹤，白云长相亲。",
        "南风忽至吴，分散还入秦。",
        "寒夜天光白，海净月色真。",
        "对坐论岁暮，弦悲岂无因。",
        "平生驰驱分，非谓杯酒仁。",
        "出处两不合，忠贞何由伸。",
        "看君孤舟去，且欲歌垂纶。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 339321,
      "title": "东京府县诸公与綦毋潜李颀相送至白马寺宿",
      "content": [
        "鞍马上东门，裴回入孤舟。",
        "贤豪相追送，即棹千里流。",
        "赤岸落日在，空波微烟收。",
        "薄宦忘机括，醉来即淹留。",
        "月明见古寺，林外登高楼。",
        "南风开长廊，夏夜如凉秋。",
        "江月照吴县，西归梦中游。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 339326,
      "title": "留别岑参兄弟",
      "content": [
        "江城建业楼，山尽沧海头。",
        "副职守兹县，东南棹孤舟。",
        "长安故人宅，秣马经前秋。",
        "便以风雪暮，还为纵饮留。",
        "貂蝉七叶贵，鸿鹄万里游。",
        "何必念钟鼎，所在烹肥牛。",
        "为君啸一曲，且莫弹箜篌。",
        "徒见枯者艳，谁言直如钩。",
        "岑家双琼树，腾光难为俦。",
        "谁言青门悲，俯期吴山幽。",
        "日西石门峤，月吐金陵洲。",
        "追随探灵怪，岂不骄王侯。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 339327,
      "title": "送刘昚虚归取宏词解",
      "content": [
        "太清闻海鹤，游子引乡眄。",
        "声随羽仪远，势与归云便。",
        "青桂春再荣，白云暮来变。",
        "迁飞在礼仪，岂复泪如霰。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 339328,
      "title": "巴陵别刘处士",
      "content": [
        "刘生隐岳阳，心远洞庭水。",
        "偃帆入山郭，一宿楚云里。",
        "竹映秋馆深，月寒江风起。",
        "烟波桂阳接，日夕数千里。",
        "袅袅清夜猿，孤舟坐如此。",
        "湘中有来雁，雨雪候音旨。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 339330,
      "title": "淇上酬薛据兼寄郭微",
      "content": [
        "自从别京华，我心乃萧索。",
        "十年守章句，万里空寥落。",
        "北上登蓟门，茫茫见沙漠。",
        "倚剑对风尘，慨然思卫霍。",
        "拂衣去燕赵，驱马怅不乐。",
        "天长沧洲路，日暮邯郸郭。",
        "酒肆或淹留，渔泽屡栖泊。",
        "独行备艰难，孰辞干鼎镬。",
        "皇情念淳古，时俗何浮薄。",
        "理道须任贤，安人在求瘼。",
        "故交负奇才，逸气包謇谔。",
        "隐轸经济策，纵横建安作。",
        "才望忽先鸣，风期无宿诺。",
        "飘飖劳州县，迢递限言谑。",
        "东驰眇贝丘，西顾弥虢略。",
        "淇水徒自深，浮云不堪托。",
        "吾谋适可用，天道岂辽廓。",
        "不然买山田，一身与耕凿。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 339331,
      "title": "咏史",
      "content": [
        "荷畚至洛阳，杖策游北门。",
        "天下尽兵甲，豺狼满中原。",
        "明夷方遘患，顾我徒崩奔。",
        "自惭菲薄才，误蒙国士恩。",
        "位重任亦重，时危志弥敦。",
        "西北未及终，东南不可吞。",
        "进则耻保躬，退乃为触藩。",
        "叹息嵩山老，而后知其尊。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 339332,
      "title": "杂兴",
      "content": [
        "握中铜匕首，粉锉楚山铁。",
        "义士频报雠，杀人不曾缺。",
        "可悲燕丹事，终被狼虎灭。",
        "一举无两全，荆轲遂为血。",
        "诚知匹夫勇，何取万人杰。",
        "无道吞诸侯，坐见九州裂。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 339335,
      "title": "独游",
      "content": [
        "林卧情每闲，独游景常晏。",
        "时从灞陵下，垂钓往南涧。",
        "手携双鲤鱼，目送千里雁。",
        "悟彼飞有适，知此罹忧患。",
        "放之清冷泉，因得省疏慢。",
        "永怀青岑客，回首白云间。",
        "神超物无违，岂系名与宦。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 339336,
      "title": "香积寺礼拜万回平等二圣僧塔",
      "content": [
        "真无御化来，借有乘化归。",
        "如彼双塔内，孰能知是非。",
        "愚也骇苍生，圣哉为帝师。",
        "当为时世出，不由天地资。",
        "万回主此方，平等性无违。",
        "今我一礼心，亿劫同不移。",
        "肃肃松柏下，诸天来有时。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 339338,
      "title": "诸官游招隐寺",
      "content": [
        "山馆人已空，青萝换风雨。",
        "自从永明世，月向龙宫吐。",
        "凿井长幽泉，白云今如古。",
        "应真坐松柏，锡杖挂窗户。",
        "口云七十余，能救诸有苦。",
        "回指岩树花，如闻道场鼓。",
        "金色身坏灭，真如性无主。",
        "僚友同一心，清光遣谁取。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 339339,
      "title": "宴南亭",
      "content": [
        "寒江映村林，亭上纳鲜洁。",
        "楚客共闲饮，静坐金管阕。",
        "酣竟日入山，暝来云归穴。",
        "城楼空杳霭，猿鸟备清切。",
        "物状如丝纶，上心为予决。",
        "访君东溪事，早晚樵路绝。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 339340,
      "title": "何九于客舍集",
      "content": [
        "客有住桂阳，亦如巢林鸟。",
        "罍觞且终宴，功业会未了。",
        "山月空霁时，江明高楼晓。",
        "门前泊舟楫，行次入松筱。",
        "此意投赠君，沧波风袅袅。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 339342,
      "title": "观江淮名胜图",
      "content": [
        "刻意吟云山，尤知隐沦妙。",
        "远公何为者，再诣临海峤。",
        "而我高其风，披图得遗照。",
        "援毫无逃境，遂展千里眺。",
        "淡扫荆门烟，明标赤城烧。",
        "青葱林间岭，隐见淮海徼。",
        "但指香炉顶，无闻白猿啸。",
        "沙门既云灭，独往岂殊调。",
        "感对怀拂衣，胡宁事渔钓。",
        "安期始遗舄，千古谢荣耀。",
        "投迹庶可齐，沧浪有孤棹。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 339347,
      "title": "太湖秋夕",
      "content": [
        "水宿烟雨寒，洞庭霜落微。",
        "月明移舟去，夜静魂梦归。",
        "暗觉海风度，萧萧闻雁飞。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 339349,
      "title": "过华阴",
      "content": [
        "云起太华山，云山互明灭。",
        "东峰始含景，了了见松雪。",
        "羁人感幽栖，窅映转奇绝。",
        "欣然忘所疲，永望吟不辍。",
        "信宿百余里，出关玩新月。",
        "何意昨来心，遇物遂迁别。",
        "人生屡如此，何以肆愉悦。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 339350,
      "title": "九江口作",
      "content": [
        "漭漭江势阔，雨开浔阳秋。",
        "驿门是高岸，望尽黄芦洲。",
        "水与五溪合，心期万里游。",
        "明时无弃才，谪去随孤舟。",
        "鸷鸟立寒木，丈夫佩吴钩。",
        "何当报君恩，却系单于头。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 339352,
      "title": "途中作",
      "content": [
        "游人愁岁晏，早起遵王畿。",
        "坠叶吹未晓，疏林月微微。",
        "惊禽栖不定，寒兽相因依。",
        "叹此霜露下，复闻鸿雁飞。",
        "渺然江南意，惜与中途违。",
        "羁旅悲壮发，别离念征衣。",
        "永图岂劳止，明节期所归。",
        "宁厌楚山曲，无人长掩扉。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 339354,
      "title": "小敷谷龙潭祠作",
      "content": [
        "崖谷喷疾流，地中有雷集。",
        "百泉势相荡，巨石皆却立。",
        "跳波沸峥嵘，深处不可挹。",
        "昏为蛟龙怒，清见云雨入。",
        "灵怪崇偏祠，废兴自兹邑。",
        "沉淫顷多昧，簷宇遂不葺。",
        "吾闻被明典，盛德惟世及。",
        "生人载山川，血食报原隰。",
        "岂伊骇微险，将以循甿揖。",
        "□飞振吕梁，忠信亦我习。",
        "波流浸已广，悔吝在所汲。",
        "溪水有清源，褰裳靡沾湿。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 339355,
      "title": "段宥厅孤桐",
      "content": [
        "凤凰所宿处，月映孤桐寒。",
        "槁叶零落尽，空柯苍翠残。",
        "虚心谁能见，直影非无端。",
        "响发调尚苦，清商劳一弹。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 339356,
      "title": "琴",
      "content": [
        "孤桐秘虚鸣，朴素传幽真。",
        "仿佛弦指外，遂见初古人。",
        "意远风雪苦，时来江山春。",
        "高宴未终曲，谁能辨经纶。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 339360,
      "title": "箜篌引",
      "content": [
        "卢溪郡南夜泊舟，夜闻两岸羌戎讴，其时月黑猿啾啾。",
        "微雨沾衣令人愁，有一迁客登高楼，不言不寐弹箜篌。",
        "弹作蓟门桑叶秋，风沙飒飒青冢头，将军铁骢汗血流。",
        "深入匈奴战未休，黄旗一点兵马收，乱杀胡人积如丘。",
        "疮病驱来配边州，仍披漠北羔羊裘，颜色饥枯掩面羞。",
        "眼眶泪滴深两眸，思还本乡食牦牛，欲语不得指咽喉。",
        "或有强壮能咿嚘，意说被他边将雠，五世属藩汉主留。",
        "碧毛毡帐河曲游，橐驼五万部落稠，敕赐飞凤金兜鍪。",
        "为君百战如过筹，静扫阴山无鸟投，家藏铁券特承优。",
        "黄金千斤不称求，九族分离作楚囚，深溪寂寞弦苦幽。",
        "草木悲感声飕飗，仆本东山为国忧，明光殿前论九畴。",
        "簏读兵书尽冥搜，为君掌上施权谋，洞晓山川无与俦。",
        "紫宸诏发远怀柔，摇笔飞霜如夺钩，鬼神不得知其由。",
        "怜爱苍生比蚍蜉，朔河屯兵须渐抽，尽遣降来拜御沟。",
        "便令海内休戈矛，何用班超定远侯，史臣书之得已不。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 339361,
      "title": "乌栖曲",
      "content": [
        "白马逐朱车，黄昏入狭邪。",
        "柳树乌争宿，"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 339362,
      "title": "城傍曲",
      "content": [
        "秋风鸣桑条，草白狐兔骄。",
        "邯郸饮来酒未消，"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 339363,
      "title": "行路难",
      "content": [
        "双丝作绠系银瓶，百尺寒泉辘轳上。",
        "悬丝一绝不可望，",
        "宴罢调筝奏离鹤，回娇转盼泣君前。",
        "君不见，眼前事，",
        "但愿莫忘前者言，锉骨黄尘亦无愧。",
        "行路难，劝君酒，",
        "一闻汉主思故剑，使妾长嗟万古魂。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 339364,
      "title": "奉赠张荆州",
      "content": [
        "祝融之峰紫云衔，翠如何其雪崭岩。",
        "邑西有路缘石壁，",
        "王君飞舄仍未去，苏耽宅中意遥缄。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 339366,
      "title": "驾幸河东",
      "content": [
        "晋水千庐合，汾桥万国从。",
        "开唐天业盛，入沛圣恩浓。",
        "下辇回三象，题碑任六龙。",
        "睿明悬日月，千岁此时逢。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 339367,
      "title": "胡笳曲",
      "content": [
        "城南虏已合，一夜几重围。",
        "自有金笳引，能沾出塞衣。",
        "听临关月苦，清入海风微。",
        "三奏高楼晓，胡人掩涕归。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 339371,
      "title": "沙苑南渡头",
      "content": [
        "秋雾连云白，归心浦溆悬。",
        "津人空守缆，村馆复临川。",
        "篷隔苍茫雨，波连演漾田。",
        "孤舟未得济，入梦在何年。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 339379,
      "title": "九日登高",
      "content": [
        "青山远近带皇州，霁景重阳上北楼。",
        "雨歇亭皋仙菊润，",
        "谩说陶潜篱下醉，何曾得见此风流。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 339380,
      "title": "万岁楼",
      "content": [
        "江上巍巍万岁楼，不知经历几千秋。",
        "年年喜见山长在，",
        "谁堪登望云烟里，向晚茫茫发旅愁。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 339382,
      "title": "送欧阳会稽之任",
      "content": [
        "怀禄贵心赏，东流山水长。",
        "官移会稽郡，地迩上虞乡。",
        "缓带屏纷杂，渔舟临讼堂。",
        "逶迤回溪趣，猿啸飞鸟行。",
        "万室霁朝雨，千峰迎夕阳。",
        "辉辉远洲映，暧暧澄湖光。",
        "白发有高士，青春期上皇。",
        "应须枉车歇，为我访荷裳。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 339384,
      "title": "东溪玩月",
      "content": [
        "月从断山口，遥吐柴门端。",
        "万木分空霁，流阴中夜攒。",
        "光连虚象白，气与风露寒。",
        "谷静秋泉响，岩深青霭残。",
        "澄清入幽梦，破影抱空峦。",
        "恍惚琴窗里，松溪晓思难。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 339387,
      "title": "答武陵田太守",
      "content": [
        "仗剑行千里，微躯感一言。",
        "曾为大梁客，不负信陵恩。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 339388,
      "title": "题灞池二首",
      "content": [
        "腰镰欲何之，东园刈秋韭。",
        "世事不复论，悲歌和樵叟。",
        "开门望长川，薄暮见渔者。",
        "借问白头翁，垂纶几年也。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 339389,
      "title": "题僧房",
      "content": [
        "棕榈花满院，苔藓入闲房。",
        "彼此名言绝，空中闻异香。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 339392,
      "title": "送郭司仓",
      "content": [
        "映门淮水绿，留骑主人心。",
        "明月随良掾，春潮夜夜深。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 339395,
      "title": "武陵田太守席送司马卢溪",
      "content": [
        "诸侯分楚郡，饮饯五溪春。",
        "山水清晖远，俱怜一逐臣。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 339398,
      "title": "从军行七首",
      "content": [
        "烽火城西百尺楼，黄昏独上海风秋。",
        "更吹羌笛关山月，无那金闺万里愁。",
        "琵琶起舞换新声，总是关山旧别情。",
        "撩乱边愁听不尽，高高秋月照长城。",
        "关城榆叶早疏黄，日暮云沙古战场。",
        "表请回军掩尘骨，莫教兵士哭龙荒。",
        "青海长云暗雪山，孤城遥望玉门关。",
        "黄沙百战穿金甲，不破楼兰终不还。",
        "大漠风尘日色昏，红旗半卷出辕门。",
        "前军夜战洮河北，已报生擒吐谷浑。",
        "胡瓶落膊紫薄汗，碎叶城西秋月团。",
        "明敕星驰封宝剑，辞君一夜取楼兰。",
        "玉门山嶂几千重，山北山南总是烽。",
        "人依远戍须看火，马踏深山不见踪。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 339399,
      "title": "出塞二首",
      "content": [
        "秦时明月汉时关，万里长征人未还。",
        "但使龙城飞将在，不教胡马度阴山。",
        "骝马新跨白玉鞍，战罢沙场月色寒。",
        "城头铁鼓声犹振，匣里金刀血未干。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 339400,
      "title": "采莲曲二首",
      "content": [
        "吴姬越艳楚王妃，争弄莲舟水湿衣。",
        "来时浦口花迎入，采罢江头月送归。",
        "荷叶罗裙一色裁，芙蓉向脸两边开。",
        "乱入池中看不见，闻歌始觉有人来。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 339401,
      "title": "殿前曲二首",
      "content": [
        "贵人妆梳殿前催，香风吹入殿后来。",
        "仗引笙歌大宛马，白莲花发照池台。",
        "胡部笙歌西殿头，梨园弟子和凉州。",
        "新声一段高楼月，圣主千秋乐未休。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 339405,
      "title": "长信秋词五首",
      "content": [
        "金井梧桐秋叶黄，珠帘不卷夜来霜。",
        "熏笼玉枕无颜色，卧听南宫清漏长。",
        "高殿秋砧响夜阑，霜深犹忆御衣寒。",
        "银灯青琐裁缝歇，还向金城明主看。",
        "奉帚平明金殿开，且将团扇暂裴回。",
        "玉颜不及寒鸦色，犹带昭阳日影来。",
        "真成薄命久寻思，梦见君王觉后疑。",
        "火照西宫知夜饮，分明复道奉恩时。",
        "长信宫中秋月明，昭阳殿下捣衣声。",
        "白露堂中细草迹，红罗帐里不胜情。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 339406,
      "title": "青楼曲二首",
      "content": [
        "白马金鞍从武皇，旌旗十万宿长杨。",
        "楼头小妇鸣筝坐，遥见飞尘入建章。",
        "驰道杨花满御沟，红妆缦绾上青楼。",
        "金章紫绶千余骑，夫婿朝回初拜侯。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 339408,
      "title": "浣纱女",
      "content": [
        "钱塘江畔是谁家，江上女儿全胜花。",
        "吴王在时不得出，今日公然来浣纱。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 339409,
      "title": "闺怨",
      "content": [
        "闺中少妇不曾愁，春日凝妆上翠楼。",
        "忽见陌头杨柳色，悔教夫婿觅封侯。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 339410,
      "title": "甘泉歌",
      "content": [
        "乘舆执玉已登坛，细草沾衣春殿寒。",
        "昨夜云生拜初月，万年甘露水晶盘。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 339413,
      "title": "寄穆侍御出幽州",
      "content": [
        "一从恩谴度潇湘，塞北江南万里长。",
        "莫道蓟门书信少，雁飞犹得到衡阳。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 339415,
      "title": "至南陵答皇甫岳",
      "content": [
        "与君同病复漂沦，昨夜宣城别故人。",
        "明主恩深非岁久，长江还共五溪滨。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 339416,
      "title": "西江寄越弟",
      "content": [
        "南浦逢君岭外还，沅溪更远洞庭山。",
        "尧时恩泽如春雨，梦里相逢同入关。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 339421,
      "title": "梁苑",
      "content": [
        "梁园秋竹古时烟，城外风悲欲暮天。",
        "万乘旌旗何处在，平台宾客有谁怜。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 339425,
      "title": "送狄宗亨",
      "content": [
        "秋在水清山暮蝉，洛阳树色鸣皋烟。",
        "送君归去愁不尽，又惜空度凉风天。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 339427,
      "title": "芙蓉楼送辛渐二首",
      "content": [
        "寒雨连天夜入湖，平明送客楚山孤。",
        "洛阳亲友如相问，一片冰心在玉壶。",
        "丹阳城南秋海阴，丹阳城北楚云深。",
        "高楼送客不能醉，寂寂寒江明月心。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 339431,
      "title": "送李五",
      "content": [
        "玉碗金罍倾送君，江西日入起黄云。",
        "扁舟乘月暂来去，谁道沧浪吴楚分。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 339437,
      "title": "留别司马太守",
      "content": [
        "辰阳太守念王孙，远谪沅溪何可论。",
        "黄鹤青云当一举，明珠吐著报君恩。"
      ],
      "author": {
        "id": 2508,
        "name": "王昌龄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    }
  ],
