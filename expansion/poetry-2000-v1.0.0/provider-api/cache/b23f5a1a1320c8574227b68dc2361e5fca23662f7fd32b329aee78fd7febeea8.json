{
  "data": [
    {
      "id": 216341,
      "title": "晚发寿春浮桥望寿阳楼怀古",
      "content": [
        "烟水苍茫古岸高，危楼缥缈枕波涛。",
        "山围粉堞青屏合，桥跨长淮百舰牢。",
        "争战往年空故国，登临行客叹前朝。",
        "青旗试问谁家酒，风雨蒹葭晚渡遥。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 216342,
      "title": "夜泊",
      "content": [
        "远雁初归枫叶干，孤舟晚系岸边滩。",
        "淮声夜静凌风壮，月色秋深照客寒。",
        "疏拙功名甘阔略，飘零踪迹但悲叹。",
        "不关酒薄难成醉，自是年来少所欢。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 216343,
      "title": "将别普济二首  其一",
      "content": [
        "老槐疏竹寺门幽，九月轻寒袭客裘。",
        "漠漠淮烟天际晚，萧萧山雨坐中秋。",
        "风前红叶知时落，篱下黄花对客愁。",
        "为语老僧无我笑，此生终待老林丘。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 216344,
      "title": "将别普济二首  其二",
      "content": [
        "孤城淮北晚钟残，落日桥边送客鞍。",
        "物外楼台秋更豁，山深松竹晚多寒。",
        "窗风细细侵衣冷，簷雨萧萧到夜阑。",
        "佳境欲留嗟不可，尘埃踪迹但悲叹。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 216345,
      "title": "发泗州",
      "content": [
        "万艘猎猎战风桅，我亦孤舟别岸隈。",
        "漠漠晓云生木末，萧萧飞雨送帆开。",
        "消磨岁月书千卷，零落江湖酒一杯。",
        "因病得州真漫尔，功名于我亦悠哉。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 216346,
      "title": "病中得晁应之秋怀诗",
      "content": [
        "西风堂下飞黄叶，病卧空床白日高。",
        "疲薾扶行孤竹杖，萧条隠几两霜毛。",
        "散花有客谈真实，烧药无人过寂寥。",
        "怪得晚来头目快，新诗秋兴苦飘飘。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 216347,
      "title": "夏日杂兴四首  其一",
      "content": [
        "隔墙泉下是东溪，细溜涓涓入我池。",
        "一部笙箫寒竹响，百年风雨古槐姿。",
        "果悬幽槛朱初熟，蔓度空墙翠欲垂。",
        "野趣转深身愈老，故应寂寞畏人知。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 216348,
      "title": "夏日杂兴四首  其二",
      "content": [
        "无地从容解鬰陶，寄怀林野散尘劳。",
        "含风槐柳参天合，足雨桑麻映露高。",
        "五斗得官迷簿领，一廛何处𣃁蓬蒿。",
        "致身富贵须年少，顾我衰迟已二毛。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 216349,
      "title": "夏日杂兴四首  其三",
      "content": [
        "墙下溪流清且长，夹溪乔木雨苍苍。",
        "袅风翠果擎枝重，照水圆荷舞叶凉。",
        "蜗壳已枯黏粉壁，燕泥时落污书床。",
        "南山野客闲相过，赠我能携药满筐。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 216350,
      "title": "夏日杂兴四首  其四",
      "content": [
        "蔬圃茅斋三亩余，溪光山影动浮虚。",
        "病妻老去惟寻药，稚子年来解爱书。",
        "中散无堪心放荡，冯唐已老兴萧疏。",
        "全真养素安吾分，敢谓轩裳不我如。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 216351,
      "title": "清明日卧病",
      "content": [
        "莺花零乱清明日，巾褐萧条老病翁。",
        "乌鼎相亲勤煮药，素屏深坐怯当风。",
        "爱花未免呼儿摘，畏雨还成对客慵。",
        "自叹年来怨青镜，衰颜改尽少年红。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 216352,
      "title": "水南春望",
      "content": [
        "洛岸东风送马行，桥横落日半川明。",
        "天连观阁云垂地，春入山河秀满城。",
        "老去飘萍甘屏迹，兴来怀古未忘情。",
        "短歌一曲聊回首，不待悲秋白发生。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 216353,
      "title": "春日遣兴",
      "content": [
        "洛阳自古帝王都，百战荆榛只故墟。",
        "零乱园林遗物在，嬉游人物古风余。",
        "草迷公子障泥锦，花近佳人油壁车。",
        "漂泊强随游客辔，不辞尘土污衣裾。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 216354,
      "title": "送杨补之赴鄂州支使",
      "content": [
        "相逢顾我尚童儿，二十年来鬓有丝。",
        "涕泪两家同患难，光阴一半属分离。",
        "扁舟又作江湖别，千里长悬梦寐思。",
        "何日粗酬身世了，卜邻耕钓老追随。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 216355,
      "title": "送杨念行监簿侍行赴鄂渚",
      "content": [
        "楚天南去水冥冥，鄂渚悠悠到几程。",
        "京洛信稀千里隔，江湖春尽一帆轻。",
        "莫辞送别青春满，会是相逢白发生。",
        "饱读诗书取卿相，不应如我老无成。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 216356,
      "title": "送三姊之鄂州",
      "content": [
        "兄弟分飞各一方，老来分袂苦多伤。",
        "两行别泪江湖远，五月征车岐路长。",
        "休叹伯鸾甘寂寞，所欣杨恽好文章。",
        "北归会有相逢地，只恐尘埃发易苍。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 216357,
      "title": "正月六日",
      "content": [
        "杨柳梢头腊雪消，东风犹著晚寒骄。",
        "新年花柳传芳信，去腊星霜变斗杓。",
        "来共春烟情冉冉，洒随疏雨泪萧萧。",
        "蛾眉一闭年华改，纵有遗魂可得招。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 216358,
      "title": "游李氏园",
      "content": [
        "堂下新年见草芽，惊心强起探年华。",
        "柳呈雪后青苍干，梅破风前一两花。",
        "绰约风光新物态，栽培园沼好生涯。",
        "奔驰世路吾何有，一到林塘一叹嗟。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 216359,
      "title": "寄荣子雍",
      "content": [
        "苍茫腊雪欲成泥，又见东风上柳枝。",
        "万事过前浑是梦，百年投老只添悲。",
        "功名末路收常晚，节物惊心空自知。",
        "千里故人犹念我，书来辛苦话相思。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 216360,
      "title": "题朱氏园",
      "content": [
        "东风邀客入芳菲，夹径吹香李万枝。",
        "啼鸟远闻知昼静，好花相续得春迟。",
        "连樯东去淮天阔，绿野南环楚泽卑。",
        "客至会须留醉墨，主人留榜待新诗。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 216361,
      "title": "离宿州后寄兄弟",
      "content": [
        "落日村桥涕泫然，东风匹马去翩翩。",
        "两行绿树当隋岸，一片春云限楚天。",
        "妄意致身常许国，强颜得禄废求田。",
        "幅巾会作淮南叟，白发相收一钓船。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 216362,
      "title": "寄荣子雍三首  其一",
      "content": [
        "东风三月洛阳城，倾盖相逢气倍增。",
        "看尽园花方信马，饮斜楼月更挑灯。",
        "年光飘忽双驰毂，心事萧条一老僧。",
        "酒病年来慵把笔，新文寄我苦凭陵。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 216363,
      "title": "寄荣子雍三首  其二",
      "content": [
        "苍苍老柏古南禅，袅袅修篁泮水湾。",
        "此地笑谈惟我共，百年交友得君难。",
        "已甘心向诗书老，会与身图云水闲。",
        "年少功名须力致，看君朝佩日珊珊。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 216364,
      "title": "寄荣子雍三首  其三",
      "content": [
        "家家新酒滴新醅，残岁峥嵘春欲回。",
        "霜野寂无新到雁，雪林寒有欲开梅。",
        "关河路永双横辙，天地身闲一举杯。",
        "酬答风光千点泪，怯将愁眼更登台。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 216365,
      "title": "陈履常惠诗有曾门一老之句不肖二十五岁谒见南丰舍人于山阳始一书而褒与过宜阳有同途至亳之约耒以病不能如期后八年始遇公于京师南丰门人惟君一人而已感旧慨叹因成鄙句愿勿他示",
      "content": [
        "南丰冢木已萧萧，犹有门人守一瓢。",
        "文彩自应传壶奥，典刑犹可想风标。",
        "纷纷但见侏儒饱，寂寂谁歌隠士招。",
        "十载敝冠弹未得，簪缨知复为谁彯。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 216366,
      "title": "泊舟候水",
      "content": [
        "一水悠悠断复连，卸帆终日小滩前。",
        "青旗招饮篙工醉，五两敧风贾客眠。",
        "树色远分芳草路，鸟行斜断夕阳天。",
        "渔舟惯伴危樯宿，馈我霜鳞不用钱。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 216367,
      "title": "同李十二醉饮王氏牡丹园二首  其一",
      "content": [
        "东风穷巷只埃尘，谁见城南万朵新。",
        "不问主人聊一饮，为携佳客送余春。",
        "比君意气三年老，贷我疏狂一味真。",
        "醉里尚能驰马去，看君倒著接䍠巾。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 216368,
      "title": "同李十二醉饮王氏牡丹园二首  其二",
      "content": [
        "吹尽纷纷桃李尘，天香国艳一翻新。",
        "正过谷雨初晴日，分得西都大半春。",
        "旧态似推新艳好，红芳不似淡妆真。",
        "嗟予久得丘园意，何日相逢一幅巾。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 216369,
      "title": "同无咎遐叔文叔同游凝祥得游字",
      "content": [
        "客子长安尘满裘，道人门馆自深幽。",
        "东风拂地千条柳，春水平池数点鸥。",
        "俯首一官真底事，倒囊三百更何求。",
        "读书挟策君知否，失性还同博塞游。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 216370,
      "title": "昼卧怀陈三时陈三卧疾",
      "content": [
        "睡如饮蜜入蜂房，懒似游丝百尺长。",
        "陋巷谁过居士疾，春风正作国人狂。",
        "吟诗得瘦由无性，辟谷轻身合有方。",
        "欲饷子桑归问妇，一瓢过午尚悬墙。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 216371,
      "title": "将至海州明山有作",
      "content": [
        "望望孤城沧海边，好云深处是人烟。",
        "鸟飞山静晴秋日，水阔人闲熟稻天。",
        "旗影远摇沽酒市，棹歌归去隔村船。",
        "功名富贵非吾事，誓𣃁明山数亩田。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 216372,
      "title": "秋日登海州乘槎亭",
      "content": [
        "海上西风八月凉，乘槎亭外水茫茫。",
        "人家日暖樵渔乐，山路秋晴松栢香。",
        "隔水飞来鸿阵阔，趁潮归去橹声忙。",
        "蓬莱方丈知何处，烟浪参差在夕阳。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 216373,
      "title": "屋东",
      "content": [
        "苍鸠呼雨屋东啼，麦穗初长燕子飞。",
        "竹里人家鸡犬静，水边官舍吏民稀。",
        "溪声夜涨寒通枕，山色朝晴翠染衣。",
        "頼有西邻好诗句，赓酬终日自忘机。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 216374,
      "title": "题斋壁",
      "content": [
        "松庭日午听啼莺，帘外人稀睡老铃。",
        "已叹近秋添白发，更因多病读黄庭。",
        "江鱼未上烹难致，吴酒空斟醉易醒。",
        "好住安心莫惆怅，此身天地一浮萍。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 216375,
      "title": "次韵李德载见寄",
      "content": [
        "头颅幸获免奸锋，甘分江湖老钓篷。",
        "老得一州聊自慰，相望千里与谁同。",
        "已欣台省登群俊，犹数湖湘卧病翁。",
        "诗就醉余频走笔，待观云海戏群鸿。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 216376,
      "title": "读孙巨源经纬集",
      "content": [
        "等闲咳唾烂成文，奏牍三千世共珍。",
        "不向人间调鼎鼐，却归天上作麒麟。",
        "侍游曲水欢何在，敷奏延英迹已陈。",
        "四辅当时曾避柱，熙宁天子属词臣。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 216377,
      "title": "将赴上庠偶成",
      "content": [
        "卷中课最诗成后，枕上功名睡美余。",
        "弟子解疑常隠几，轮人能笑久观书。",
        "山林沉痼时搔首，松菊耽淫自荷锄。",
        "干世可能寻一饱，虀盐未用食无鱼。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 216378,
      "title": "寄杨克一",
      "content": [
        "吾甥颇似魏家舒，新罢推囚却著书。",
        "顾我独倾陶令酒，思君同鲙季鹰鲈。",
        "荒凉云物秋将老，寂寞山城谁与娱。",
        "倏忽风光行老矣，踌躇不去欲何如。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 216379,
      "title": "己卯十二月二十日感事二首  其一",
      "content": [
        "高楼乘兴独登临，搔首天涯岁暮心。",
        "带雪腊风藏泽国，犯寒春色著烟林。",
        "山川极目风光异，岁月惊怀老境侵。",
        "可是斯文天未丧，楚囚何事涕沾襟。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 216380,
      "title": "己卯十二月二十日感事二首  其二",
      "content": [
        "蹉跎流落已华颠，又见荆湖一岁迁。",
        "人怯苦寒愁日短，天收残腊放新年。",
        "园林寂历飘梅后，里巷经过爆竹前。",
        "自料知非犹得在，潜心久学卫蘧先。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 216381,
      "title": "冬节小不佳怀正叔老兄",
      "content": [
        "老境光阴短景催，新冬又复一年回。",
        "焚香燕坐衣僧衲，煮药高眠废酒杯。",
        "处处庖厨鸣瓮缶，年年歌笑惨风埃。",
        "孟公歌舞犹须雪，未放愁眉取次开。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 216382,
      "title": "耒将之临淮旅泊泗上属病作迎候上官不敢求告比归尤剧疏拙无以自振但自悯叹耳",
      "content": [
        "谋身不解免飘蓬，零落孤舟西复东。",
        "双鬓虽青应早白，病颜更醉不成红。",
        "崎岖避俗人难合，憔悴多愁疾易攻。",
        "莼菜碧鲈秋正美，步兵终欲向江东。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 216383,
      "title": "访人汴上有感",
      "content": [
        "万尾鳞鳞汴岸舟，汴流日夜去悠悠。",
        "舟行水去常如旧，世事纷纷何日休。",
        "落日昏昏沙际晚，白云片片碧天秋。",
        "□□□□□□□，□□□□□□□。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 216384,
      "title": "望龟山二首  其一",
      "content": [
        "淮上风高寒日西，龟山岭下白云归。",
        "游人苦憾日已晚，青山自与云为期。",
        "轻舟渔子犯烟去，照水白鸥窥影飞。",
        "人间不作逍遥客，老去尘埃空满衣。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 216385,
      "title": "望龟山二首  其二",
      "content": [
        "日落龟山山更清，原头啼鸟已春声。",
        "可怜山近不能到，尽日与山相对行。",
        "云里人家自来往，天边楼阁远分明。",
        "白鸥不解游客意，惊起碧烟深处横。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 216386,
      "title": "次韵答存之",
      "content": [
        "环堵萧然汝水隈，孤怀炯炯向谁开。",
        "青春不觉书边过，白发无端镜上来。",
        "祭灶请邻聊复尔，卖刀买犊岂难哉。",
        "故人休说封侯事，归钓江天有旧台。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 216387,
      "title": "离天长寄周重实",
      "content": [
        "相逢握手便忘形，射策天门尽弟兄。",
        "浮世有谁尊道义，青衫自笑为功名。",
        "高谈未尽胸中意，作别犹如梦后惊。",
        "半夜叩门投野寺，天寒孤月更分明。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 216388,
      "title": "秋宫",
      "content": [
        "帐额斓斑暗旧金，玉猊香重暖沈沈。",
        "秋风宫殿梧桐老，暮雨楼台帘幕深。",
        "银箭漏迟鸡唱晓，绮窗人睡昼生阴。",
        "无眠惯滴班姬泪，听尽长安夜夜砧。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 216389,
      "title": "题堂下桐",
      "content": [
        "零落当轩两树桐，秋来相伴一衰翁。",
        "寒枝向月空余影，陨叶知时不待风。",
        "故国山川天黯淡，美人音信雁西东。",
        "岁华节物俱寥落，满眼牢愁頼酒攻。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 216390,
      "title": "登海州城楼",
      "content": [
        "城外沧溟日夜流，城南山直对城楼。",
        "溪田雨足禾先熟，海树风高叶易秋。",
        "疏傅里闾询故老，秦皇车甲想东游。",
        "客心不待伤千里，槛外风烟尽是愁。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 216391,
      "title": "秋日忆家",
      "content": [
        "汩汩流光长远客，年年秋至是离家。",
        "孤城入夜寒更迥，霜月满天归梦赊。",
        "摵摵老桐风后叶，娟娟疏菊雨残花。",
        "茅簷布被犹无力，长走尘埃真可嗟。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 216392,
      "title": "七言",
      "content": [
        "飞鸿归尽燕将还，亭院深沉人倚栏。",
        "斜搭秋千寒食雨，已黄杨柳暮春寒。",
        "密毬杏萼红如糁，半落梅花香未残。",
        "人世年年非旧事，感时惟有泪汍澜。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 216393,
      "title": "山下",
      "content": [
        "山下疏钟日夜催，城头画角五更哀。",
        "流年忽忽愁中过，世事纷纷空里来。",
        "沮溺漫高轻世节，管商空尽济时才。",
        "古来扰扰今何有，一熟黄粱梦已回。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 216394,
      "title": "京师废宅",
      "content": [
        "当道朱门白昼扃，高堂歌吹久无声。",
        "古窗积雨昏残画，朽树经阴长寄生。",
        "门下老人时洒扫，旧时来客叹平生。",
        "艳姬骄马知何处，独有庭花春正荣。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 216395,
      "title": "送徐任",
      "content": [
        "白发青衫困宦游，相逢不复话封侯。",
        "少年壮气青云上，投老生涯一醉休。",
        "献璞谁怜藏美玉，恶声不至为虚舟。",
        "从来满卷新诗句，写取淮天万里秋。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 216396,
      "title": "登城楼",
      "content": [
        "沙雨初干巾褐轻，独披衰蔓步高城。",
        "天晴海上峰峦出，野暗人家灯火明。",
        "归鸟各寻芳树去，夕阳微照远村耕。",
        "登楼已恨荆州远，况复安仁白发生。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 216397,
      "title": "寄陈鼎",
      "content": [
        "懒著青衫沉醉眠，近来沽酒困无钱。",
        "常忧送乏邻僧米，何啻寒无坐客毡。",
        "直道漫凭詹尹卜，浮生已付祖师禅。",
        "祇应居士无醒日，知有渊明种秫田。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 216398,
      "title": "蓬瀛台二首  其一",
      "content": [
        "青冥不尽海茫茫，一望蓬瀛去路长。",
        "秋信解凭诗客寄，春心长为楚魂伤。",
        "萦回四望山如画，兴废千年木已苍。",
        "直使台倾荆棘满，闻琴何用涕霑裳。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 216399,
      "title": "蓬瀛台二首  其二",
      "content": [
        "苍烟乔木古台荒，下见蓬瀛六月凉。",
        "过雨谁知非峡女，好风应是为襄王。",
        "欢来未放流年老，事去却寻陈迹伤。",
        "飘泊南游未能返，兴来回首独凄凉。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 216400,
      "title": "和即事",
      "content": [
        "溪如圆堑木如城，鱼鸟从游信此情。",
        "啅雀踏枝飞尚袅，仰荷承雨侧还倾。",
        "弹琴废久重寻谱，种药求多旋记名。",
        "于世久判无妙策，直应归学老农耕。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 216401,
      "title": "自海至楚途次寄马全玉八首  其一",
      "content": [
        "迂疏怀抱独君知，杖拂亲依即我师。",
        "一句未能参妙道，数篇空复寄新诗。",
        "子方奋迅云间翮，我厌追随世上儿。",
        "安得岩坰两如志，铜瓶乌几为君携。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 216402,
      "title": "自海至楚途次寄马全玉八首  其二",
      "content": [
        "萧萧柳岸野风秋，虹挂前山晚雨收。",
        "回首孤城空绿树，满川斜日放归舟。",
        "年来双泪供愁尽，去去劳生几日休。",
        "试问故人思我否，梦魂犹在海边州。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 216403,
      "title": "自海至楚途次寄马全玉八首  其三",
      "content": [
        "高城欲去更徘徊，病眼登临强一开。",
        "风物尽为愁里景，山川疑是梦中来。",
        "此身双鬓何劳白，未老尘心可得灰。",
        "欲把烦愁付杯酒，祇应清梦待尊罍。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 216404,
      "title": "自海至楚途次寄马全玉八首  其四",
      "content": [
        "生涯飘泊一航轻，浩荡晴川送我行。",
        "北望山川连海远，南来风月近淮清。",
        "人家稻熟丰年满，泽国天高秋意生。",
        "惟有羁愁消不得，登临清泪落如倾。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 216405,
      "title": "自海至楚途次寄马全玉八首  其五",
      "content": [
        "少年居士正安禅，法是怀公门下传。",
        "已解出尘金里鑛，何妨离欲火中莲。",
        "苦心参道嗟予晚，极口随机恃子怜。",
        "若许维扬傍仁里，一廛须买许行田。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 216406,
      "title": "自海至楚途次寄马全玉八首  其六",
      "content": [
        "萧萧晚雨向风斜，村远荒凉三四家。",
        "野色连云迷稼穑，秋声催晓起蒹葭。",
        "愁如夜月长随客，身似飞鸿不记家。",
        "极目相望何处是，海天无际落残霞。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 216407,
      "title": "自海至楚途次寄马全玉八首  其七",
      "content": [
        "二年海角寄东城，岁久移居亦有情。",
        "去路山川嗟我远，旧时风月为谁清。",
        "一廛受地今难继，三径怀归久欲耕。",
        "何日山林有茅屋，百年无复问功名。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 216408,
      "title": "自海至楚途次寄马全玉八首  其八",
      "content": [
        "紫蟹双螯荐客盘，倾来不觉酒壶干。",
        "雨多泽国蒲鱼美，秋至楚天风露寒。",
        "老去论交嗟我晚，尊前一笑忆君欢。",
        "红莲幕下无书檄，剩寄新诗满卷看。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 216409,
      "title": "夏日三首  其一",
      "content": [
        "长夏江村风日清，簷牙燕雀已生成。",
        "蝶衣晒粉花枝午，蛛网添丝屋角晴。",
        "落落疏帘邀月影，嘈嘈虚枕纳溪声。",
        "久拚两鬓如霜雪，直欲樵渔过此生。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 216410,
      "title": "夏日三首  其二",
      "content": [
        "黄帘翠幕断飞蝇，午影当轩睡未兴。",
        "枕稳海鱼镌紫石，扇凉山雪画青缯。",
        "廊阴日转雕栏树，坐冷风生玉碗冰。",
        "满案诗书尘蠹甚，故应疏懒过炎蒸。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 216411,
      "title": "夏日三首  其三",
      "content": [
        "枣径瓜畦经雨凉，白衫乌帽野人装。",
        "幽花避日房房敛，翠树含风叶叶香。",
        "养拙久拚藏姓氏，致身安事巧文章。",
        "汉庭卿相皆豪俊，不遇何妨白发郎。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 216412,
      "title": "和晁应之大暑书事",
      "content": [
        "蓬门久闭谢来车，畏暑尤便小阁虚。",
        "青引嫩苔留鸟篆，绿垂残叶带虫书。",
        "寒泉出井功何有，白羽邀凉计已疏。",
        "忍待西风一萧瑟，碧鲈斫鲙意何如。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 216413,
      "title": "遣兴次韵和晁应之四首  其一",
      "content": [
        "老去诗书倦讨论，一樽相对尚殷勤。",
        "锻炉放荡狂中散，书阁萧条老子云。",
        "要路交亲嗟隔阔，他乡耆旧饱知闻。",
        "衰知多病头风甚，解寄新文独有君。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 216414,
      "title": "遣兴次韵和晁应之四首  其二",
      "content": [
        "西风淅淅满征衣，天畔危亭面翠微。",
        "云解映山常漠漠，叶知辞树亦依依。",
        "苦饥黄鹄犹谋食，无事轻鸥得远飞。",
        "落日秋风满江汉，杖藜三叹未能归。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 216415,
      "title": "遣兴次韵和晁应之四首  其三",
      "content": [
        "夜泛孤舟清洛津，宓妃轻步若为亲。",
        "清涵星汉光垂地，冷觉鱼龙气近人。",
        "镜里悲秋双鬓发，马边随客两京尘。",
        "愁心欲比东流水，滚滚无穷日日新。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 216416,
      "title": "遣兴次韵和晁应之四首  其四",
      "content": [
        "蓬门鸟雀啅黄昏，归径牛羊各有群。",
        "水阔鱼龙阴后出，山空虎豹夜深闻。",
        "西来客引秦川雨，南去秋连楚泽云。",
        "唐汉废兴无处问，西风禾黍但丘坟。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 216417,
      "title": "自巴河至蕲阳口道中得二诗示仲达与秬同赋  其一",
      "content": [
        "落月娟娟堕半环，呕哑鸣橹转荒湾。",
        "东南地缺天连水，春夏风高浪卷山。",
        "旅食每愁村市散，近秋已觉暑衣单。",
        "自惭老病心儿女，三日离家已念还。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 216418,
      "title": "自巴河至蕲阳口道中得二诗示仲达与秬同赋  其二",
      "content": [
        "浩浩浑流卷白沙，中流鼓棹四无涯。",
        "喜逢山色开眉黛，愁对江云起砲车。",
        "雨足郊原丰稻菽，日斜鸥鹭满蒹葭。",
        "长年怕作扁舟客，頼有高谈一笑哗。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 216419,
      "title": "离蕲阳守风林皇方虑风壮晚未知所止俄顷风息一食顷宿富池作诗示同行",
      "content": [
        "老怕风波见辄惊，頼逢谈笑慰危情。",
        "纵观云岭屏风合，坐见江涛镜面平。",
        "淹速人生难预计，险夷世路不须营。",
        "尘埃老作东州守，得得扁舟作此行。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 216420,
      "title": "离富池望庐岳是日入夹口直达浔阳遂舍大江之险示同行",
      "content": [
        "山秀江清三百里，与君三宿一扁舟。",
        "饮残桑落溪云暮，卧冷桃笙楚雨秋。",
        "舟隠长江逢夹口，眼明五老立云头。",
        "几年泽国行将遍，归与亲朋说旧游。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 216421,
      "title": "二十三日即事",
      "content": [
        "已逢娬媚散花峡，不怕艰危道士矶。",
        "啼鸟似逢人劝酒，好山如为我开眉。",
        "风标公子鹭得意，跋扈将军风敛威。",
        "到舍将何作归遗，江山收得一囊诗。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 216422,
      "title": "度洛因泛舟东下数里颇忆淮上",
      "content": [
        "沄沄清洛转山隈，渺渺东流不复回。",
        "轻鸟竟随青嶂去，乱波争泛夕阳来。",
        "偶惊舟楫乡心起，乍脱尘埃病眼开。",
        "疑是盱眙郭门外，月明帆席过清淮。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 216423,
      "title": "县斋",
      "content": [
        "只合门如野叟家，市朝声利苦喧哗。",
        "但知得醉频沽酒，何处逢春不见花。",
        "暗树五更鸡报晓，晚庭三叠鼓催衙。",
        "知君宰邑端无事，吟笑何妨到暮鸦。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 216424,
      "title": "和周廉彦",
      "content": [
        "天光不动晚云垂，芳草初长衬马蹄。",
        "新月已生飞鸟外，落霞更在夕阳西。",
        "花开有客时携酒，门冷无车出畏泥。",
        "修禊洛滨期一醉，天津春浪绿浮堤。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 216425,
      "title": "春日遣兴二首  其一",
      "content": [
        "流光向老惜芳菲，搔首悲歌心事违。",
        "绿野染成延昼永，辞红吹尽放春归。",
        "荆榛废苑人闲牧，风雨空城乌夜飞。",
        "断送一番桃李尽，可怜桑柘有光辉。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 216426,
      "title": "春日遣兴二首  其二",
      "content": [
        "日烘烟柳软于丝，桃李成尘绿满枝。",
        "芳草有情随处好，落花无頼信风吹。",
        "关心伤感知何处，过眼芳菲能几时。",
        "一病春来妨痛饮，遣愁惟有强裁诗。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 216427,
      "title": "钱仲珣追船及陈留",
      "content": [
        "野岸南风百草长，沄沄汴水卷沙黄。",
        "扁舟转柁迷城市，送客追船罗酒浆。",
        "休唱阳关伤远别，所欣莼菜入新堂。",
        "宦名衰晚君无问，便得封侯鬓已苍。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 216428,
      "title": "遗兴次韵和晁应之四首  其一",
      "content": [
        "日落村虚烟霭青，草根促织晚先鸣。",
        "群山衮衮望中去，新月娟娟愁里生。",
        "暗峡风云秋惨淡，高城河汉夜分明。",
        "寄书故国还羞涩，白首萧条老病婴。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 216429,
      "title": "遗兴次韵和晁应之四首  其二",
      "content": [
        "洛阳宫殿锁埃尘，翠辇东还几度春。",
        "双阙晓云连太室，九门晴影动天津。",
        "地藏宝鼎宁无祲，龙护灵书固有神。",
        "游豫此时期圣主，保厘从古仗元臣。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 216430,
      "title": "遗兴次韵和晁应之四首  其三",
      "content": [
        "女几山前云雨收，五更星斗转西楼。",
        "苍苍淡月关河晓，袅袅西风观阁秋。",
        "独鹤有求时饮啄，孤云无事任沉浮。",
        "可怜白发张公子，还望西山歌四愁。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 216431,
      "title": "遗兴次韵和晁应之四首  其四",
      "content": [
        "露下风悲萤火流，周南羁客意悠悠。",
        "山川老去三年泪，关塞秋来万里愁。",
        "惯逐禽鱼谙异俗，每因霜月梦沧洲。",
        "一抛砚井双蓬鬓，天畔诗成独倚楼。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 216432,
      "title": "新霁",
      "content": [
        "园门几日断行踪，新霁欣然路小通。",
        "晚萼有情开宿雨，长林尽日舞高风。",
        "后皇佳植宁无橘，鸾凤求栖亦有桐。",
        "不惜园林娱逐客，此情谁似主人翁。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 216433,
      "title": "与李文举登梦野亭",
      "content": [
        "樽俎相逢散百忧，虽非吾土共登楼。",
        "天边云送荆王雨，江上枫雕宋玉秋。",
        "华发不堪怀故国，清杯相与散牢愁。",
        "清谈七泽谁强健，莫学骚人赋远游。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 216434,
      "title": "登梦野亭怀旧",
      "content": [
        "曾上高台望翠微，重来悲叹客难期。",
        "章华苍莽寻无处，云梦逶迤寒更迟。",
        "墨客多情曾痛饮，玉箫何处弄妍词。",
        "请君点检当时事，只应朱颜非旧时。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 216435,
      "title": "北堂斋居示秬秸",
      "content": [
        "穷腊贫家𫄨纻单，可堪过雨夜堂寒。",
        "屏除荤酒神应爽，谈笑诗书乐未闲。",
        "净境眼前无俗物，清都梦到有飞翰。",
        "鸡鸣月落纸窗白，疑是从天风驭还。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 216436,
      "title": "送复守张坰朝奉罢归",
      "content": [
        "一梦西都十二年，竟陵相遇各华颠。",
        "风流家世仁人后，恺悌歌谣楚俗传。",
        "学道爱君甘淡薄，倦游嗟我久留连。",
        "自怜江上伤春眼，不待琵琶已泫然。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 216437,
      "title": "岁日同郡官朝天庆回偶成",
      "content": [
        "清晓琳宫拜谒还，驼裘犹怯夜霜寒。",
        "春生七泽苍茫外，日上三山缥缈间。",
        "投老埃尘从马后，异时班缀近龙颜。",
        "人间倚伏谁能料，一酌芳醪兴未阑。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 216438,
      "title": "僦居小室之西有隙地不满十步新岁后稍暖每开户春色鬬进戏名其户曰嬉春因为此诗",
      "content": [
        "苍苍老桧已消雪，冉冉烟芜欲鬭妍。",
        "围得青春数亩地，断将平楚一方天。",
        "春风入户如相觅，新月低窗最可怜。",
        "老子婆娑便终日，一壶春酒与周旋。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 216439,
      "title": "发安化回望黄州山",
      "content": [
        "流落江湖四见春，天恩复与两朱轮。",
        "几年鱼鸟真相得，从此江山是故人。",
        "碧落已瞻新日月，故园好在旧交亲。",
        "此生已免嘲伧父，莫避北风京洛尘。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 216440,
      "title": "发云山近岐亭望光蔡接尉氏",
      "content": [
        "白草黄茅间瘦田，郊原残暑已萧然。",
        "泽连楚梦悲秋野，山近尧封望日天。",
        "浓绿远陂铺晚稼，幽香秋水折残莲。",
        "热行更益相如渴，怅望华陵陆子泉。"
      ],
      "author": {
        "id": 3743,
        "name": "张耒"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    }
