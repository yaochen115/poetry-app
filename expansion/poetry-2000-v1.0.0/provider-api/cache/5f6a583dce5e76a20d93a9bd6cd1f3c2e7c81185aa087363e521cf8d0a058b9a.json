{
  "data": [
    {
      "id": 378115,
      "title": "河渎神·河渎神·江上草芊芊",
      "content": [
        "江上草芊芊，春晚湘妃庙前。",
        "一方卵色楚南天，数行征雁联翩。",
        "独倚朱栏情不极，魂断终朝相忆。",
        "两桨不知消息，远汀时起㶉𫛶。"
      ],
      "author": {
        "id": 12232,
        "name": "孙光宪"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378116,
      "title": "虞美人·虞美人·红窗寂寂无人语",
      "content": [
        "红窗寂寂无人语，暗淡梨花雨。",
        "绣罗纹地粉新描，博山香炷旋抽条，暗魂消。",
        "天涯一去无消息，终日长相忆。",
        "教人相忆几时休？",
        "不堪枨触别离愁，泪还流。"
      ],
      "author": {
        "id": 12232,
        "name": "孙光宪"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378117,
      "title": "虞美人·虞美人·好风微揭帘旌起",
      "content": [
        "好风微揭帘旌起，金翼鸾相倚。",
        "翠檐愁听乳禽声，此时春态暗关情，独难平。",
        "画堂流水空相翳，一穗香摇曳。",
        "教人无处寄相思，落花芳草过前期，没人知。"
      ],
      "author": {
        "id": 12232,
        "name": "孙光宪"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378118,
      "title": "后庭花·后庭花·景阳钟动宫莺啭",
      "content": [
        "景阳钟动宫莺啭，露凉金殿。",
        "轻飙吹起琼花旋，玉叶如剪。",
        "晚来高阁上，珠帘卷，见坠香千片。",
        "修蛾慢脸陪雕辇，后庭新宴。"
      ],
      "author": {
        "id": 12232,
        "name": "孙光宪"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378119,
      "title": "后庭花·后庭花·石城依旧空江国",
      "content": [
        "石城依旧空江国，故宫春色。",
        "七尺青丝芳草碧，绝世难得。",
        "玉英凋落尽，更何人识，野棠如织。",
        "只是教人添怨忆，怅望无极。"
      ],
      "author": {
        "id": 12232,
        "name": "孙光宪"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378120,
      "title": "生查子·生查子·寂寞掩朱门",
      "content": [
        "寂寞掩朱门，正是天将暮。",
        "暗淡小庭中，滴滴梧桐雨。",
        "绣工夫，牵心绪，配尽鸳鸯缕。",
        "待得没人时，偎倚论私语。"
      ],
      "author": {
        "id": 12232,
        "name": "孙光宪"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378121,
      "title": "生查子·生查子·暖日策花骢",
      "content": [
        "暖日策花骢，亸鞚垂杨陌。",
        "芳草惹烟青，落絮随风白。",
        "谁家绣毂动香尘，隐遇难神仙客。",
        "狂杀玉鞭郎，咫尺音容隔。"
      ],
      "author": {
        "id": 12232,
        "name": "孙光宪"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378122,
      "title": "生查子·生查子·金井堕高梧",
      "content": [
        "金井堕高梧，玉殿笼斜月。",
        "永巷寂无人，敛态愁堪绝。",
        "玉炉寒，香烬灭，还似君恩歇。",
        "翠辇不归来，幽恨将谁说。"
      ],
      "author": {
        "id": 12232,
        "name": "孙光宪"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378123,
      "title": "临江仙·临江仙·霜拍井梧干叶堕",
      "content": [
        "霜拍井梧干叶堕，翠帷雕槛初寒。",
        "薄铅残黛称花冠，含情无语，延伫倚栏干。",
        "杳杳征轮何处去，离愁别恨千般。",
        "不堪心绪正多端，镜奁长掩，无意对孤鸾。"
      ],
      "author": {
        "id": 12232,
        "name": "孙光宪"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378124,
      "title": "临江仙·临江仙·暮雨凄凄深院闭",
      "content": [
        "暮雨凄凄深院闭，灯前凝坐初更。",
        "玉钗低压鬓云横，半垂罗幕，相映烛光明。",
        "终是有心投汉佩，低头但理秦筝。",
        "燕双鸾耦不胜情，只愁明发，将逐楚云行。"
      ],
      "author": {
        "id": 12232,
        "name": "孙光宪"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378125,
      "title": "酒泉子·酒泉子·空碛无边",
      "content": [
        "空碛无边，万里阳关道路。",
        "马萧萧，人去去，陇云愁。",
        "香貂旧制戎衣窄，胡霜千里白。",
        "绮罗心，魂梦隔，上高楼。"
      ],
      "author": {
        "id": 12232,
        "name": "孙光宪"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378126,
      "title": "酒泉子·酒泉子·曲槛小楼",
      "content": [
        "曲槛小楼，正是莺花二月。",
        "思无聊，愁欲绝，郁离襟。",
        "展屏空对潇湘水，眼前千万里。",
        "泪掩红，眉敛翠，恨沉沉。"
      ],
      "author": {
        "id": 12232,
        "name": "孙光宪"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378127,
      "title": "酒泉子·酒泉子·敛态窗前",
      "content": [
        "敛态窗前，袅袅雀钗抛颈。",
        "燕成双，鸾对影，耦新知。",
        "玉纤淡拂眉山小，镜中嗔共照。",
        "翠连娟，红缥渺，早妆时。"
      ],
      "author": {
        "id": 12232,
        "name": "孙光宪"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378128,
      "title": "清平乐·清平乐·愁肠欲断",
      "content": [
        "愁肠欲断，正是青春半。",
        "连理分枝鸾失伴，又是一场离散。",
        "掩镜无语眉低，思随芳草萋萋。",
        "凭仗东风吹梦，与郎终日东西。"
      ],
      "author": {
        "id": 12232,
        "name": "孙光宪"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378129,
      "title": "清平乐·清平乐·等闲无语",
      "content": [
        "等闲无语，春恨如何去？",
        "终是疏狂留不住，花暗柳浓何处。",
        "尽日目断魂飞，晚窗斜界残晖。",
        "长恨朱门薄暮，绣鞍骢马空归。"
      ],
      "author": {
        "id": 12232,
        "name": "孙光宪"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378130,
      "title": "更漏子·更漏子·听寒更",
      "content": [
        "听寒更，闻远雁，半夜萧娘深院。",
        "扃绣户，下珠帘，满庭喷玉蟾。",
        "人语静，香闺冷，红幕半垂清影。",
        "云雨态，蕙兰心，此情江海深。"
      ],
      "author": {
        "id": 12232,
        "name": "孙光宪"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378131,
      "title": "更漏子·更漏子·今夜期",
      "content": [
        "今夜期，来日别，相对只堪愁绝。",
        "偎粉面，捻瑶簪，无言泪满襟。",
        "银箭落，霜华薄，墙外晓鸡咿喔。",
        "听咐嘱，恶情悰，断肠西复东。"
      ],
      "author": {
        "id": 12232,
        "name": "孙光宪"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378132,
      "title": "女冠子·女冠子·蕙风芝露",
      "content": [
        "蕙风芝露，坛际残香轻度。",
        "蕊珠宫，苔点分圆碧，桃花践破红。",
        "品流巫峡外，名籍紫微中。",
        "真侣墉城会，梦魂通。"
      ],
      "author": {
        "id": 12232,
        "name": "孙光宪"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378133,
      "title": "女冠子·女冠子·淡花瘦玉",
      "content": [
        "淡花瘦玉，依约神仙妆束。",
        "佩琼文，瑞露通宵贮，幽香尽日焚。",
        "碧纱笼绛节，黄藕冠浓云。",
        "勿以吹箫伴，不同群。"
      ],
      "author": {
        "id": 12232,
        "name": "孙光宪"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378134,
      "title": "风流子·风流子·茅舍槿篱溪曲",
      "content": [
        "茅舍槿篱溪曲，鸡犬自南自北。",
        "菰叶长，水葓开，门外春波涨绿。",
        "听织，声促，轧轧鸣梭穿屋。"
      ],
      "author": {
        "id": 12232,
        "name": "孙光宪"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378135,
      "title": "风流子·风流子·楼倚长衢欲暮",
      "content": [
        "楼倚长衢欲暮，簪见神仙伴侣。",
        "微傅粉，拢梳头，隐映画帘开处。",
        "无语，无绪，慢曳罗裙归去。"
      ],
      "author": {
        "id": 12232,
        "name": "孙光宪"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378136,
      "title": "风流子·风流子·金络玉衔嘶马",
      "content": [
        "金络玉衔嘶马，系向绿杨阴下。",
        "朱户掩，绣帘垂，曲院水流花谢。",
        "欢罢，归也，犹在九衢深夜。"
      ],
      "author": {
        "id": 12232,
        "name": "孙光宪"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378137,
      "title": "定西番·定西番·鸡禄山前游骑",
      "content": [
        "鸡禄山前游骑，边草白，朔天明，马蹄轻。",
        "鹊面弓离短韔，弯来月欲成。",
        "一只鸡鹘云外，晓鸿惊。"
      ],
      "author": {
        "id": 12232,
        "name": "孙光宪"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378138,
      "title": "定西番·定西番·帝子枕前秋夜",
      "content": [
        "帝子枕前秋夜，霜幄冷，月华明，正三更。",
        "何处戍楼寒笛，梦残闻一声。",
        "遥想汉关万里，泪纵横。"
      ],
      "author": {
        "id": 12232,
        "name": "孙光宪"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378139,
      "title": "河满子·河满子·冠剑不随君去",
      "content": [
        "冠剑不随君去，江河还共恩深。",
        "歌袖半遮眉黛惨，泪珠旋滴衣襟。",
        "惆怅云愁雨怨，断魂何处相寻。"
      ],
      "author": {
        "id": 12232,
        "name": "孙光宪"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378140,
      "title": "玉蝴蝶·玉蝴蝶·春欲尽",
      "content": [
        "春欲尽，景仍长，满园花正黄。",
        "粉翘两悠飏，翩翩过短墙。",
        "鲜飙暖，牵游伴，飞去立残芳。",
        "无语对萧娘，舞衫沉麝香。"
      ],
      "author": {
        "id": 12232,
        "name": "孙光宪"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378141,
      "title": "八拍蛮·八拍蛮·孔雀尾拖金线长",
      "content": [
        "孔雀尾拖金线长，怕人飞起入丁香。",
        "越女沙头争拾翠，相呼归去背斜阳。"
      ],
      "author": {
        "id": 12232,
        "name": "孙光宪"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378142,
      "title": "竹枝·竹枝·门前春水白苹花",
      "content": [
        "门前春水（竹枝）白苹花（女儿），岸上无人（竹枝）小艇斜（女儿）。",
        "商女经过（竹枝）江欲暮（女儿），散抛残食（竹枝）饲神鸦（女儿）。"
      ],
      "author": {
        "id": 12232,
        "name": "孙光宪"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378143,
      "title": "竹枝·竹枝·乱绳千结绊人深",
      "content": [
        "乱绳千结（竹枝）绊人深（女儿），越罗万丈（竹枝）表长寻（女儿）。",
        "杨柳在身（竹枝）垂意绪（女儿），藕花落尽（竹枝）见莲心（女儿）。"
      ],
      "author": {
        "id": 12232,
        "name": "孙光宪"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378144,
      "title": "思帝乡·思帝乡·如何",
      "content": [
        "如何？",
        "遣情情更多。",
        "永日水堂帘下，敛羞蛾。",
        "六幅罗裙窣地，微行曳碧波。",
        "看尽满地疏雨，打团荷。"
      ],
      "author": {
        "id": 12232,
        "name": "孙光宪"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378145,
      "title": "上行杯·上行杯·草草离亭鞍马",
      "content": [
        "草草离亭鞍马，从远道，此地分襟，燕宋秦吴千万里。",
        "无辞一醉。",
        "野棠开，江草湿。",
        "伫立，沾泣，征骑骎骎。"
      ],
      "author": {
        "id": 12232,
        "name": "孙光宪"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378146,
      "title": "上行杯·上行杯·离棹逡巡欲动",
      "content": [
        "离棹逡巡欲动，临极浦，故人相送，去住心情知不共。",
        "金船满捧。",
        "绮罗愁，丝管咽。",
        "回别，帆影灭，江浪如雪。"
      ],
      "author": {
        "id": 12232,
        "name": "孙光宪"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378147,
      "title": "谒金门·谒金门·留不得",
      "content": [
        "留不得！",
        "留得也应无益。",
        "白纻春衫如雪色，扬州初去日。",
        "轻别离，甘抛掷，江上满帆风疾。",
        "却羡彩鸳三十六，孤鸾还一只。"
      ],
      "author": {
        "id": 12232,
        "name": "孙光宪"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378148,
      "title": "思越人·思越人·古台平",
      "content": [
        "古台平，芳草远，馆娃宫外春深。",
        "翠黛空留千载恨，教人何处相寻。",
        "绮罗无复当时事，露花点滴香泪。",
        "惆怅遥天横绿水，鸳鸯对时飞起。"
      ],
      "author": {
        "id": 12232,
        "name": "孙光宪"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378149,
      "title": "思越人·思越人·渚莲枯",
      "content": [
        "渚莲枯，宫树老，长洲废萧条。",
        "想象玉人空处所，月明独上溪桥。",
        "经春初败秋风起，江兰绿蕙愁死。",
        "一片风流伤心地，魂销目断西子。"
      ],
      "author": {
        "id": 12232,
        "name": "孙光宪"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378150,
      "title": "杨柳枝·杨柳枝·阊门风暖落花干",
      "content": [
        "阊门风暖落花干，飞遍江城江城雪不寒。",
        "独有晚来临水驿，闲人多凭赤栏干。"
      ],
      "author": {
        "id": 12232,
        "name": "孙光宪"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378151,
      "title": "杨柳枝·杨柳枝·有池有榭即蒙蒙",
      "content": [
        "有池有榭即蒙蒙，浸润翻成长养功。",
        "恰似有人长点检，着行排立向春风。"
      ],
      "author": {
        "id": 12232,
        "name": "孙光宪"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378152,
      "title": "杨柳枝·杨柳枝·根柢虽然傍浊河",
      "content": [
        "根柢虽然傍浊河，无妨终日近笙歌。",
        "骖骖金带谁堪比，还共黄莺不较多。"
      ],
      "author": {
        "id": 12232,
        "name": "孙光宪"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378153,
      "title": "杨柳枝·杨柳枝·万株枯槁怨亡隋",
      "content": [
        "万株枯槁怨亡隋，似吊吴台各自垂。",
        "好是淮阴明月里，酒楼横笛不胜吹。"
      ],
      "author": {
        "id": 12232,
        "name": "孙光宪"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378154,
      "title": "望梅花·望梅花·数枝开与短墙平",
      "content": [
        "数枝开与短墙平，见雪萼红跗相映，引起谁人边塞情。",
        "帘外欲三更，吹断离愁月正明，空听隔江声。"
      ],
      "author": {
        "id": 12232,
        "name": "孙光宪"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378155,
      "title": "渔歌子·渔歌子·草芊芊",
      "content": [
        "草芊芊，波漾漾，湖边草色连波涨。",
        "沿蓼岸，泊飘汀，天际玉轮初上。",
        "扣舷歌，联极望，桨声伊轧知何向。",
        "黄鹊叫，白鸥眠，谁似侬家疏旷。"
      ],
      "author": {
        "id": 12232,
        "name": "孙光宪"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378156,
      "title": "渔歌子·渔歌子·泛流萤",
      "content": [
        "泛流萤，明又灭，夜凉水冷东湾阔。",
        "风浩浩，笛寥寥，万顷金波澄澈。",
        "杜若洲，香郁烈，一声宿雁霜时节。",
        "经霅水，过松江，尽属侬家日月。"
      ],
      "author": {
        "id": 12232,
        "name": "孙光宪"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378157,
      "title": "菩萨蛮·菩萨蛮·罗裾薄薄秋波染",
      "content": [
        "罗裾薄薄秋波染，眉间画时山两点。",
        "相见绮筵时，深情暗共知。",
        "翠翘云鬓动，敛态弹金凤。",
        "宴罢入兰房，邀入解佩珰。"
      ],
      "author": {
        "id": 12827,
        "name": "魏承班"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378158,
      "title": "菩萨蛮·菩萨蛮·罗衣隐约金泥画",
      "content": [
        "罗衣隐约金泥画，玳筵一曲当秋夜。",
        "声战觑人娇，云袅翠翘。",
        "酒醺红玉软，眉翠秋山远。",
        "绣幌麝烟沉，谁人知两心。"
      ],
      "author": {
        "id": 12827,
        "name": "魏承班"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378159,
      "title": "满宫花·满宫花·雪霏霏",
      "content": [
        "雪霏霏，风凛凛，玉郎何处狂饮。",
        "醉时想得纵风流，罗帐香帷鸳寝。",
        "春朝秋夜思君甚，愁见绣屏孤枕。",
        "少年何事负初心，泪滴缕金双衽。"
      ],
      "author": {
        "id": 12827,
        "name": "魏承班"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378160,
      "title": "木兰花·木兰花·小芙蓉",
      "content": [
        "小芙蓉，香旖旎，碧玉堂深清似水。",
        "闭宝匣，掩金铺，倚屏拖袖愁如醉。",
        "迟迟好景烟花媚，曲渚鸳鸯眠锦翅。",
        "凝然愁望静相思，一双笑靥嚬香蕊。"
      ],
      "author": {
        "id": 12827,
        "name": "魏承班"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378161,
      "title": "玉楼春·玉楼春·寂寂画堂梁上燕",
      "content": [
        "寂寂画堂梁上燕，高卷翠帘横数扇。",
        "一庭春色恼人来，满地落花红几片。",
        "愁倚锦屏低雪面，泪滴绣罗金缕线。",
        "好天凉月尽伤心，为是玉郎长不见。"
      ],
      "author": {
        "id": 12827,
        "name": "魏承班"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378162,
      "title": "玉楼春·玉楼春·轻敛翠蛾呈皓齿",
      "content": [
        "轻敛翠蛾呈皓齿，莺啭一枝花影里。",
        "声声清迥遏行云，寂寂画梁尘暗起。",
        "玉斝满斟情未已，促坐王孙公子醉。",
        "春风筵上贯珠匀，艳色韶颜娇旖旎。"
      ],
      "author": {
        "id": 12827,
        "name": "魏承班"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378163,
      "title": "诉衷情·诉衷情·高歌宴罢月初盈",
      "content": [
        "高歌宴罢月初盈，诗情引恨情。",
        "烟露冷，水流轻，思想梦难成。",
        "罗帐袅香平，恨频生。",
        "思君无计睡还醒，隔层城。"
      ],
      "author": {
        "id": 12827,
        "name": "魏承班"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378164,
      "title": "诉衷情·诉衷情·春深花簇小楼台",
      "content": [
        "春深花簇小楼台，风飘锦绣开。",
        "新睡觉，步香阶，山枕印红腮。",
        "鬓乱坠金钗，语檀偎。",
        "临行执手重重嘱，几千回。"
      ],
      "author": {
        "id": 12827,
        "name": "魏承班"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378165,
      "title": "诉衷情·诉衷情·银汉云晴玉漏长",
      "content": [
        "银汉云晴玉漏长，蛩声悄画堂。",
        "筠簟冷，碧窗凉，红蜡泪飘香。",
        "皓月泻寒光，割人肠。",
        "那堪独自步池塘，对鸳鸯。"
      ],
      "author": {
        "id": 12827,
        "name": "魏承班"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378166,
      "title": "诉衷情·诉衷情·金风轻透碧窗纱",
      "content": [
        "金风轻透碧窗纱，银釭焰影斜。",
        "倚枕卧，恨何赊，山掩小屏霞。",
        "云雨别吴娃，想容华。",
        "梦成几度绕天涯，到君家。"
      ],
      "author": {
        "id": 12827,
        "name": "魏承班"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378167,
      "title": "诉衷情·诉衷情·春情满眼脸红绡",
      "content": [
        "春情满眼脸红绡，娇妒索人饶。",
        "星靥小，玉珰摇，几共醉春朝。",
        "别后忆纤腰，梦魂劳。",
        "如今风叶又萧萧，恨迢迢。"
      ],
      "author": {
        "id": 12827,
        "name": "魏承班"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378168,
      "title": "生查子·生查子·烟雨晚晴天",
      "content": [
        "烟雨晚晴天，零落花无语。",
        "难话此时心，梁燕双来去。",
        "琴韵对薰风，有恨和情抚。",
        "肠断断弦频，泪滴黄金缕。"
      ],
      "author": {
        "id": 12827,
        "name": "魏承班"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378169,
      "title": "生查子·生查子·寂寞画堂空",
      "content": [
        "寂寞画堂空，深夜垂罗幕。",
        "灯暗锦屏欹，月冷珠帘薄。",
        "愁恨梦难成，何处贪欢乐。",
        "看看又春来，还是长萧索。"
      ],
      "author": {
        "id": 12827,
        "name": "魏承班"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378170,
      "title": "黄钟乐·黄钟乐·池塘烟暖草萋萋",
      "content": [
        "池塘烟暖草萋萋。",
        "惆怅闲宵，含恨愁坐，思堪迷。",
        "遥想玉人情事远，音容浑似隔桃溪。",
        "偏记同欢秋月低，帘外论心，花畔和醉，暗相携。",
        "何事春来君不见，梦魂长在锦江西。"
      ],
      "author": {
        "id": 12827,
        "name": "魏承班"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378171,
      "title": "渔歌子·渔歌子·柳如眉",
      "content": [
        "柳如眉，云似发。",
        "姣绡雾縠笼香雪。",
        "梦魂惊，钟漏歇，窗外晓莺残月。",
        "几多情，无处说，落花飞絮清明节。",
        "少年郎，容易别，一去音书断绝。"
      ],
      "author": {
        "id": 12827,
        "name": "魏承班"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378172,
      "title": "临江仙·临江仙·金锁重门荒苑静",
      "content": [
        "金锁重门荒苑静，绮窗愁对秋空。",
        "翠华一去寂无踪，玉楼歌吹，声断已随风。",
        "烟月不知人事改，夜阑还照深宫。",
        "藕花相向野塘中，暗伤亡国，清露泣香红。"
      ],
      "author": {
        "id": 3625,
        "name": "鹿虔扆"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378173,
      "title": "临江仙·临江仙·无赖晓莺惊梦断",
      "content": [
        "无赖晓莺惊梦断，起来残醉初醒。",
        "映窗丝柳袅烟青，翠帘慵卷，约砌杏花零。",
        "一自玉郎游冶去，莲凋月惨仪形。",
        "暮天微雨洒闲庭，手挼裙带，无语倚云屏。"
      ],
      "author": {
        "id": 3625,
        "name": "鹿虔扆"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378174,
      "title": "女冠子·女冠子·凤楼琪树",
      "content": [
        "凤楼琪树，惆怅刘郎一去，正春深。",
        "洞里愁空结，人间信莫寻。",
        "竹疏斋殿迥，松密醮坛阴。",
        "倚云低首望，可知心。"
      ],
      "author": {
        "id": 3625,
        "name": "鹿虔扆"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378175,
      "title": "女冠子·女冠子·步虚坛上",
      "content": [
        "步虚坛上，绛节霓旌相向，引真仙。",
        "玉佩摇蟾影，金炉袅麝烟。",
        "露浓霜简湿，风紧羽衣偏。",
        "欲留难得住，却归天。"
      ],
      "author": {
        "id": 3625,
        "name": "鹿虔扆"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378176,
      "title": "思越人·思越人·翠屏欹",
      "content": [
        "翠屏欹，银烛背，漏残清夜迢迢。",
        "双带绣窠盘锦荐，泪浸花暗香消。",
        "珊瑚枕腻鸦鬟乱，玉纤慵整云散。",
        "若是适来新梦见，离肠怎不千断。"
      ],
      "author": {
        "id": 3625,
        "name": "鹿虔扆"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378177,
      "title": "虞美人·虞美人·卷荷香淡浮烟渚",
      "content": [
        "卷荷香淡浮烟渚，绿嫩擎新雨。",
        "绣窗疏透晓风情，象床珍簟冷光轻，水纹平。",
        "九疑黛色屏斜掩，枕上眉心敛。",
        "不堪相望病将成，钿昏檀粉泪纵横，不胜情。"
      ],
      "author": {
        "id": 3625,
        "name": "鹿虔扆"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378178,
      "title": "虞美人·虞美人·粉融红腻莲房绽",
      "content": [
        "粉融红腻莲房绽，脸动双波慢。",
        "小鱼衔玉鬓钗横，石榴裙染象纱轻，转娉婷。",
        "偷期锦浪荷深处，一梦云兼雨。",
        "臂留檀印齿痕香，深秋不寐漏初长，尽思量。"
      ],
      "author": {
        "id": 3463,
        "name": "阎选"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378179,
      "title": "虞美人·虞美人·楚腰蛴领团香玉",
      "content": [
        "楚腰蛴领团香玉，鬓叠深深绿。",
        "月蛾星眼笑微嚬，柳妖桃艳不胜春，晚妆匀。",
        "水纹簟青纱帐，雾罩秋波上。",
        "一枝娇卧醉芙蓉，袅宵不得与君同，恨忡忡。"
      ],
      "author": {
        "id": 3463,
        "name": "阎选"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378180,
      "title": "临江仙·临江仙·雨停荷芰逗浓香",
      "content": [
        "雨停荷芰逗浓香，岸边蝉噪垂杨。",
        "物华空有旧池塘，不逢仙子，何处梦襄王。",
        "珍簟对欹鸳枕冷，此来尘暗凄凉。",
        "欲凭危槛恨偏长，藕花珠缀，犹似汗凝妆。"
      ],
      "author": {
        "id": 3463,
        "name": "阎选"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378181,
      "title": "临江仙·临江仙·十二高峰天外寒",
      "content": [
        "十二高峰天外寒，竹梢轻拂仙坛。",
        "宝衣行雨在云端，画帘深殿，香雾冷风残。",
        "欲问楚王何处去？",
        "翠屏犹掩金鸾。",
        "猿啼明月照空滩，孤舟行客，惊梦亦艰难。"
      ],
      "author": {
        "id": 3463,
        "name": "阎选"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378182,
      "title": "浣溪沙·浣溪沙·寂寞流苏冷绣茵",
      "content": [
        "寂寞流苏冷绣茵，倚屏山枕惹香尘，小庭花露泣浓香。",
        "刘阮信非仙洞客，嫦娥终是月中人，此生无路访东邻。"
      ],
      "author": {
        "id": 3463,
        "name": "阎选"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378183,
      "title": "八拍蛮·八拍蛮·云锁嫩黄烟柳细",
      "content": [
        "云锁嫩黄烟柳细，风吹红蒂雪梅残。",
        "光景不胜闺阁恨，行行坐坐黛眉攒。"
      ],
      "author": {
        "id": 3463,
        "name": "阎选"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378184,
      "title": "八拍蛮·八拍蛮·愁锁黛眉烟易惨",
      "content": [
        "愁锁黛眉烟易惨，泪飘红脸粉难匀。",
        "憔悴不知缘底事，遇人推道不宜春。"
      ],
      "author": {
        "id": 3463,
        "name": "阎选"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378185,
      "title": "河传·河传·秋雨",
      "content": [
        "秋雨，秋雨，无昼无夜，滴滴霏霏。",
        "暗灯凉簟怨分离，妖姬，不胜悲。",
        "西风稍急喧窗竹，停又续，腻脸悬双玉。",
        "几回邀约雁来时，违期，雁归，人不归。"
      ],
      "author": {
        "id": 3463,
        "name": "阎选"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378186,
      "title": "临江仙·临江仙·一番荷芰生池沼",
      "content": [
        "一番荷芰生池沼，槛前风送馨香。",
        "昔年于此伴萧娘，相偎伫立，牵惹叙衷肠。",
        "时逞笑容无限态，还如菡萏争芳。",
        "别来虚遣思悠飏，慵窥往事，金锁小兰房。"
      ],
      "author": {
        "id": 11985,
        "name": "尹鹗 六首"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378187,
      "title": "临江仙·临江仙·深秋寒夜银河静",
      "content": [
        "深秋寒夜银河静，月明深院中庭。",
        "西窗幽梦等闲成，逡巡觉后，特地恨难平。",
        "红烛半消残焰短，依稀暗背银屏。",
        "枕前何事最伤情，梧桐叶上，点点露珠零。"
      ],
      "author": {
        "id": 11985,
        "name": "尹鹗 六首"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378188,
      "title": "满宫花·满宫花·月沉沉",
      "content": [
        "月沉沉，人悄悄，一炷后庭香袅。",
        "风流帝子不归来，满地禁花慵扫。",
        "离恨多，相见少，何处醉迷三岛。",
        "漏清宫树子规啼，愁锁碧窗春晓。"
      ],
      "author": {
        "id": 11985,
        "name": "尹鹗 六首"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378189,
      "title": "杏园芳·杏园芳·严妆嫩脸花明",
      "content": [
        "严妆嫩脸花明，教人见了关情。",
        "含羞举步越罗轻，称娉婷。",
        "终朝咫尺窥香阁，迢遥似隔层城。",
        "何时休遣梦相萦，入云屏。"
      ],
      "author": {
        "id": 11985,
        "name": "尹鹗 六首"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378190,
      "title": "醉公子·醉公子·暮烟笼藓砌",
      "content": [
        "暮烟笼藓砌，戟门犹未闭。",
        "尽日醉寻春，归来月满身。",
        "离鞍偎绣袂，坠巾花乱缀。",
        "何处恼佳人，檀痕衣上新。"
      ],
      "author": {
        "id": 11985,
        "name": "尹鹗 六首"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378191,
      "title": "菩萨蛮·菩萨蛮·陇云暗合秋天白",
      "content": [
        "陇云暗合秋天白，俯窗独坐窥烟陌。",
        "楼际角重吹，黄昏方醉归。",
        "荒唐难共语，明日还应去。",
        "上马出门时，金鞭莫与伊。"
      ],
      "author": {
        "id": 11985,
        "name": "尹鹗 六首"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378192,
      "title": "浣溪沙·浣溪沙·春暮黄莺下砌前",
      "content": [
        "春暮黄莺下砌前，水晶帘影露珠悬，绮霞低映晚晴天。",
        "弱柳万条垂翠带，残红落地碎香钿，蕙风飘荡散轻烟。"
      ],
      "author": {
        "id": 13554,
        "name": "毛熙震"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378193,
      "title": "浣溪沙·浣溪沙·花榭香红烟景迷",
      "content": [
        "花榭香红烟景迷，满庭芳草绿萋萋，金铺闲掩绣帘低。",
        "紫燕一双娇语碎，翠屏十二晚峰齐，梦魂消散醉空闺。"
      ],
      "author": {
        "id": 13554,
        "name": "毛熙震"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378194,
      "title": "浣溪沙·浣溪沙·晚起红房醉欲消",
      "content": [
        "晚起红房醉欲消，绿鬟云散袅金翘，雪香花语不胜娇。",
        "好是向人柔弱处，玉纤时急绣裙腰，春心牵惹转无聊。"
      ],
      "author": {
        "id": 13554,
        "name": "毛熙震"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378195,
      "title": "浣溪沙·浣溪沙·一只横钗坠髻丛",
      "content": [
        "一只横钗坠髻丛，静眠珍簟起来慵，绣罗红嫩抹酥胸。",
        "羞敛细蛾魂暗断，困迷无语思犹浓，小屏香霭碧山重。"
      ],
      "author": {
        "id": 13554,
        "name": "毛熙震"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378196,
      "title": "浣溪沙·浣溪沙·云薄罗裙绶带长",
      "content": [
        "云薄罗裙绶带长，满身新裛瑞龙香，翠钿斜映艳梅妆。",
        "佯不觑人空婉约，笑和娇语太猖狂，忍教牵恨暗形相。"
      ],
      "author": {
        "id": 13554,
        "name": "毛熙震"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378197,
      "title": "浣溪沙·浣溪沙·碧玉冠轻袅燕钗",
      "content": [
        "碧玉冠轻袅燕钗，捧心无语步香阶，缓移弓底绣罗鞋。",
        "暗想欢娱何计好，岂堪期约有时乖，日高深院正忘怀。"
      ],
      "author": {
        "id": 13554,
        "name": "毛熙震"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378198,
      "title": "浣溪沙·浣溪沙·半醉凝情卧绣茵",
      "content": [
        "半醉凝情卧绣茵，睡容无力卸罗裙，玉笼鹦鹉厌听闻。",
        "慵整落钗金翡翠，象梳欹鬓月生云，锦屏销幌麝烟熏。"
      ],
      "author": {
        "id": 13554,
        "name": "毛熙震"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378199,
      "title": "临江仙·临江仙·南齐天子宠婵娟",
      "content": [
        "南齐天子宠婵娟，六宫罗绮三千。",
        "潘妃娇艳独芳妍，椒房兰洞，云雨降神仙。",
        "纵态迷欢心不足，风流可惜当年。",
        "纤腰婉约步金莲，妖君倾国，犹自至今传。"
      ],
      "author": {
        "id": 13554,
        "name": "毛熙震"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378200,
      "title": "临江仙·临江仙·幽闺欲曙闻莺啭",
      "content": [
        "幽闺欲曙闻莺啭，红窗月影微明。",
        "好风频谢落花声，隔帷残烛，犹照绮屏筝。",
        "绣被锦茵眠玉暖，炷香斜袅烟轻。",
        "淡蛾羞敛不胜情，暗思闲梦，何处逐云行。"
      ],
      "author": {
        "id": 13554,
        "name": "毛熙震"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378201,
      "title": "更漏子·更漏子·秋色清",
      "content": [
        "秋色清，河影淡，深户烛寒光暗。",
        "绡幌碧，锦衾红，博山香炷融。",
        "更漏咽，蛩鸣切，满院霜华如雪。",
        "新月上，薄云收，映帘悬玉钩。"
      ],
      "author": {
        "id": 13554,
        "name": "毛熙震"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378202,
      "title": "更漏子·更漏子·烟月寒",
      "content": [
        "烟月寒，秋夜静，漏转金壶初永。",
        "罗幕下，绣屏空，灯花结碎红。",
        "人悄悄，愁无了，思梦不成难晓。",
        "长忆得，与郎期，窃香私语时。"
      ],
      "author": {
        "id": 13554,
        "name": "毛熙震"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378203,
      "title": "女冠子·女冠子·碧桃红杏",
      "content": [
        "碧桃红杏，迟日媚笼光影，彩霞深。",
        "香暖熏莺语，风清引鹤音。",
        "翠鬟冠玉叶，霓袖捧瑶琴。",
        "应共吹箫侣，暗相寻。"
      ],
      "author": {
        "id": 13554,
        "name": "毛熙震"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378204,
      "title": "女冠子·女冠子·修蛾慢脸",
      "content": [
        "修蛾慢脸，不语檀心一点，小山妆。",
        "蝉鬓低含绿，罗衣淡拂黄。",
        "闷来深院里，闲步落花傍。",
        "纤手轻轻整，玉炉香。"
      ],
      "author": {
        "id": 13554,
        "name": "毛熙震"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
        "id": 21,
        "name": "五代词"
      }
    },
    {
      "id": 378205,
      "title": "清平乐·清平乐·春光欲暮",
      "content": [
        "春光欲暮，寂寞闲庭户。",
        "粉蝶双双穿槛舞，帘卷晚天疏雨。",
        "含愁独倚闺帷，玉炉烟断香微。",
        "正是销魂时节，东风满树花飞。"
      ],
      "author": {
        "id": 13554,
        "name": "毛熙震"
      },
      "dynasty": {
        "id": 7,
        "name": "五代"
      },
      "type": {
