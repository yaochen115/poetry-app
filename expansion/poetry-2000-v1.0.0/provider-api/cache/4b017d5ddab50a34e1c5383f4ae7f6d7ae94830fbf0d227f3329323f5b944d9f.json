      }
    },
    {
      "id": 210049,
      "title": "陈用之学士挽词  其三",
      "content": [
        "云台观者候昏明，奎壁躔中失二星。",
        "上界真人重离别，阴风一夜搅青冥。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
