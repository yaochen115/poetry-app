  "data": [
    {
      "id": 210047,
      "title": "陈用之学士挽词  其一",
      "content": [
        "礼经三百鬓毛班，追述先儒伯仲间。",
        "谁请尚书重给札，尽抄遗稿入名山。"
      ],
      "author": {
        "id": 4290,
        "name": "秦观"
