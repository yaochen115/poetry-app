{
  "data": [
    {
      "id": 294454,
      "title": "送李喻之处士洪州谒曹王",
      "content": [
        "独思贤王府，遂作豫章行。",
        "雄镇庐霍秀，高秋江汉清。",
        "见闻惊苦节，艰故伤远情。",
        "西邸延嘉士，遗才得正平。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 294455,
      "title": "送唐赞善游越",
      "content": [
        "田园临汉水，离乱寄随关。",
        "今日烟尘尽，东西又未还。",
        "长亭百越外，孤櫂五湖间。",
        "何处游芳草，云门千万山。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 294456,
      "title": "送韦秀才",
      "content": [
        "晨装行堕叶，万里望桑干。",
        "旧说泾关险，犹闻易水寒。",
        "黄云战后积，白草暮来看。",
        "近得君苗信，时教旅思宽。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 294457,
      "title": "送陈秀才赴举",
      "content": [
        "诸侯惧削地，选士皆不羁。",
        "休隐脱荷芰，将鸣矜羽仪。",
        "甲科争玉片，诗句拟花枝。",
        "君实三楚秀，承家有清规。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 294458,
      "title": "乌程李明府水堂同卢使君幼平送奘上人游五台",
      "content": [
        "身将刘令隐，经共谢公翻。",
        "有此宗师在，应知我法存。",
        "问心常寂乐，为别岂伤魂。",
        "独访华泉去，秋风入雁门。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 294459,
      "title": "送李季良北归",
      "content": [
        "风吹残柳丝，孤客欲归时。",
        "掩抑楚弦绝，离披湘叶衰。",
        "前军犹转战，故国杳难期。",
        "北望鴈门雪，空吟平子诗。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 294460,
      "title": "送淳于秀才兰陵觐省",
      "content": [
        "欢言欲忘别，风信忽相惊。",
        "柳浦归人思，兰陵春草生。",
        "撷芳心未及，视枕恋常盈。",
        "此去非长路，还如千里情。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 294461,
      "title": "送至洪沙弥赴上元受戒",
      "content": [
        "不肯资章甫，胜衣被木兰。",
        "今随秣陵信，欲及蔡州坛。",
        "野寺钟声远，春山戒足寒。",
        "归来次第学，应见后心难。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 294462,
      "title": "九日同卢使君幼平吴兴郊外送李司仓赴选",
      "content": [
        "重阳千骑出，送客为踟蹰。",
        "旷野多摇落，寒山满路隅。",
        "晴空悬蒨斾，秋色起菱湖。",
        "几日登司会，扬才盛五都。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 294463,
      "title": "送卢孟明还上都",
      "content": [
        "江臯北风至，归客独伤魂。",
        "楚水逢乡雁，平陵忆故园。",
        "征骖嘶别馆，落日隐寒原。",
        "应及秦川望，春华满国门。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 294464,
      "title": "送李少宾赴举",
      "content": [
        "岂谓江南别，心如塞上行。",
        "苦云摇阵色，乱木搅秋声。",
        "周谷雨未散，汉河流尚横。",
        "春司迟尔策，方用静妖兵。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 294465,
      "title": "留别阎士和",
      "content": [
        "不惯人间别，多应忘别时。",
        "逢山又逢水，只畏却来迟。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 294466,
      "title": "送李道士",
      "content": [
        "常随山上下，忽限江南北。",
        "共是忘情人，何繇肯相忆。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 294467,
      "title": "送裴参军还下邳旧居",
      "content": [
        "北望烟铺骠骑营，虏烽无火楚天晴。",
        "此时千里西归客，泗上春风得及耕。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 294468,
      "title": "送文会上人还富阳",
      "content": [
        "悠悠渺渺属寒波，故寺思归意若何。",
        "长忆孤洲二三月，春山偏爱富春多。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 294469,
      "title": "送维谅上人归洞庭",
      "content": [
        "从来湖上胜人间，远爱浮云独自还。",
        "孤月空天见心地，寥寥一水镜中山。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 294470,
      "title": "九月八日送萧少府归洪州",
      "content": [
        "明日重阳今日归，布帆丝雨望霏霏。",
        "行过鹤渚知堪住，家在龙沙意有违。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 294471,
      "title": "同颜鲁公泛舟送皇甫侍御曾",
      "content": [
        "维舟若许暂从容，送过重江不厌重。",
        "霜简别来今始见，雪山归去又难逢。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 294472,
      "title": "送孙侍御游越",
      "content": [
        "不知持斧客，吟会是何情。",
        "丹陛恩犹在，沧洲赏暂行。",
        "江桡随月泛，山策逐雪行。",
        "佳句传零雨，诗流许盛名。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 294473,
      "title": "送颜处士还长沙觐省",
      "content": [
        "西候风信起，三湘孤客心。",
        "天寒汉水广，乡远楚云深。",
        "服彩将侍膳，撷芳思满襟。",
        "归人忘艰阻，别恨独何任。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 294474,
      "title": "送还本上人游江西",
      "content": [
        "欲广分何教，心将江汉期。",
        "云招望寺处，月待溯杯时。",
        "真侣谁伤别，降猨汝自悲。",
        "多应过庐阜，幽赏却来迟。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 294475,
      "title": "送路少府使京兼觐侍御兄",
      "content": [
        "国赋推能吏，今朝发贡湖。",
        "伫瞻双阙凤，思见柏台乌。",
        "树向秦关远，江分楚驿孤。",
        "荣君有兄弟，相继骋长途。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 294476,
      "title": "于武原从送卢士举",
      "content": [
        "落日独归客，空山匹马嘶。",
        "萧条古关外，岐路更东西。",
        "大泽云寂寂，长亭雨凄凄。",
        "君还到湘水，寒夜满猨啼。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 294477,
      "title": "送乌程李明府得陟状赴京",
      "content": [
        "驿吏满江城，深仁见此情。",
        "士林推玉振，公府荐冰清。",
        "为政移风久，承恩就日行。",
        "仲容纶綍贵，南巷有光荣。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 294478,
      "title": "送裴秀才往会稽山读书",
      "content": [
        "一身赍万卷，编室寄烟萝。",
        "砚滴穿池小，书衣种楮多。",
        "吟诗山响荅，泛瑟竹声和。",
        "鹤板求儒术，深居意若何。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 294479,
      "title": "送崔詹事论之上都",
      "content": [
        "金虎城池在，铜龙劒珮新。",
        "重看前浦柳，犹忆旧洲苹。",
        "远思秦云暮，归心腊月春。",
        "青园昔游处，惆怅别离人。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 294480,
      "title": "京口送卢孟明还扬州",
      "content": [
        "萧萧北风起，孤櫂下江𣸣。",
        "暮客去来尽，春流南北分。",
        "萋萋御亭草，渺渺芜城云。",
        "相送目千里，空山独望君。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 294481,
      "title": "送沙弥大智游五台",
      "content": [
        "童年随法侣，家世本儒流。",
        "章句三生学，清凉万里游。",
        "云归龙沼暗，木落鴈门秋。",
        "长老应相问，传予向祖州。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 294482,
      "title": "送禀上人游越",
      "content": [
        "云泉谁不赏，独见尔情高。",
        "投石轻龙窟，临流笑鹭涛。",
        "折荷为片席，洒水净方袍。",
        "剡路逢禅侣，多应问我曹。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 294483,
      "title": "送潘秀才之舒州",
      "content": [
        "楚水清风生，扬舲泛月行。",
        "荻洲寒露彩，雷岸曙潮声。",
        "东道思才子，西人望客卿。",
        "从来金谷集，相继有诗名。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 294484,
      "title": "送王山人游庐山",
      "content": [
        "千里访灵奇，山资亦相随。",
        "叶舟过鹤市，花漏宿龙池。",
        "峰顶应闲散，人间足别离。",
        "白云将世事，吾见尔心知。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 294485,
      "title": "送道契上人之越觐大夫叔",
      "content": [
        "楚僧推后辈，唐本学新经。",
        "外国传香氎，何人施竹瓶。",
        "秋风别李寺，春日向柯亭。",
        "大阮今为郡，看君眼最青。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 294486,
      "title": "送沙弥长文游京",
      "content": [
        "白版年犹小，黄花褐已通。",
        "若为诗思逸，早欲似休公。",
        "迈俗多真气，传家有素风。",
        "应须学心地，宗旨在关东。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 294487,
      "title": "秋日送择高上人往江西谒曹王",
      "content": [
        "超然独游趣，无限别山情。",
        "予病不同赏，云闲应共行。",
        "斋容秋水照，香氎早风轻。",
        "曾被陈王识，遥知江上迎。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 294488,
      "title": "送如献上人游长安",
      "content": [
        "关中四子教犹存，见说新经待尔翻。",
        "为法应过七祖寺，忘名不到五侯门。",
        "闲寻鄠杜看修竹，独上风凉望古原。",
        "高逸诗情无别怨，春游从遣落花繁。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 294489,
      "title": "日曜上人还润州",
      "content": [
        "送君何处最堪思，孤月停空欲别时。",
        "露茗犹芳邀重会，寒花落尽不成期。",
        "鹤令先去看山近，云碍初飞到寺迟。",
        "莫倚禅功放心定，萧家陵树误人悲。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 294490,
      "title": "寺院听胡笳送李殷",
      "content": [
        "一奏胡笳客未停，野僧还欲废禅听。",
        "难将此意临江别，无限春风葭菼青。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 294491,
      "title": "送僧绎",
      "content": [
        "斜日摇扬在柳丝，孤亭寂寂水逶迤。",
        "谁堪别后行人尽，唯有春风起路岐。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 294492,
      "title": "荅裴评事澄荻花间送梁肃拾遗",
      "content": [
        "波上荻花非雪花，风吹撩乱满袈裟。",
        "如今岁晏无芳草，独对离樽作物华。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 294493,
      "title": "送胜云小师",
      "content": [
        "昨日雪山记尔名，吾今坐石已三生。",
        "少年道性易流动，莫遣秋风入别情。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 294494,
      "title": "诮士和别",
      "content": [
        "今日同，明日隔，何事悠悠久为客。",
        "君怜溪上去来云，我羡磷磷水中石。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 294495,
      "title": "送吴冯游京",
      "content": [
        "北期何意促，蕙草夜来繁。",
        "清月思淮水，春风望国门。",
        "此时休旋逸，万里忽飞翻。",
        "若忆山阴会，孤琴为我援。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 294496,
      "title": "送僧游宣州",
      "content": [
        "楚山千里一僧行，念尔初缘道未成。",
        "莫向舒姑泉口泊，此中呜咽为伤情。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 294497,
      "title": "宿支硎寺上房",
      "content": [
        "上方精舍远，共宿白云端。",
        "寂寞千峰夜，萧条万木寒。",
        "山光霜下见，松色月中看。",
        "却与西林别，归心即欲阑。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 294498,
      "title": "荅胡处士",
      "content": [
        "西山禅隐比来闻，长道唯应我与君。",
        "书上无名心忘却，人间聚散似浮云。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 294499,
      "title": "荅张乌程",
      "content": [
        "莫道谪官无主人，秣陵才令日相亲。",
        "前溪更有忘忧处，荷叶田田间白苹。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 294500,
      "title": "酬张明府",
      "content": [
        "爱君诗思动禅心，使我休吟待鹤吟。",
        "更说郡中黄霸在，朝朝无事许招寻。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 294501,
      "title": "劳山居寄呈吴处士",
      "content": [
        "官居鼎鼐古今无，名士才臣独一余。",
        "贤阁御题龙墨灿，诏归补衮在须臾。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 294502,
      "title": "从军行五首 一",
      "content": [
        "候骑出纷纷，元戎霍冠军。",
        "汉鞞秋聒地，羌火昼烧云。",
        "万里戈城合，三边羽檄分。",
        "乌孙驱未尽，肯顾辽阳勋。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 294503,
      "title": "从军行五首 二",
      "content": [
        "韩斾拂丹霄，汉军新破辽。",
        "红尘驱卤簿，白羽拥嫖姚。",
        "战苦军犹乐，功高将不骄。",
        "至今丁零塞，朔吹空萧萧。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 294504,
      "title": "从军行五首 三",
      "content": [
        "百万逐呼韩，频年不解鞍。",
        "兵屯绝漠暗，马饮浊河干。",
        "破虏功未录，劳师力已殚。",
        "须防肘腋下，飞祸出无端。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 294505,
      "title": "从军行五首 四",
      "content": [
        "飞将下天来，奇谋阃外裁。",
        "水心龙劒动，地肺鴈山开。",
        "望气燕师锐，当锋虏阵摧。",
        "从今射雕骑，不敢过云堆。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 294506,
      "title": "从军行五首 五",
      "content": [
        "黄纸君王诏，青泥校尉书。",
        "誓师张虎落，选将擐犀渠。",
        "雾暗津蒲失，天寒塞柳疎。",
        "横行十万骑，欲扫虏尘余。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 294507,
      "title": "陇头水二首 一",
      "content": [
        "陇头水欲绝，陇水不堪闻。",
        "碎影摇枪垒，寒声咽幔军。",
        "素从盐海积，绿带柳城分。",
        "日落天边望，逶迤入寒云。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 294508,
      "title": "陇头水二首 二",
      "content": [
        "秦陇逼氐羌，征人去未央。",
        "如何幽咽水，并欲断君肠。",
        "西注悲穷漠，东分忆故乡。",
        "旅魂声搅乱，无梦到咸阳。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 294509,
      "title": "塞下曲二首 一",
      "content": [
        "寒塞无因见落梅，胡人吹入笛声来。",
        "劳劳亭上春应度，夜夜城南战未回。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 294510,
      "title": "塞下曲二首 二",
      "content": [
        "都护今年破武威，胡沙万里鸟空飞。",
        "旄竿瀚海扫云出，毡骑天山蹋雪归。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 294511,
      "title": "览史",
      "content": [
        "黄绮皆皓发，秦时隐商山。",
        "嘉谋匡帝道，高步游天关。",
        "不爱珪组绁，却思林壑还。",
        "放歌长松下，日与孤云闲。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 294512,
      "title": "咏史",
      "content": [
        "独负高世资，冥冥寄浮俗。",
        "卞子去不归，何人辩荆玉。",
        "鬻舂意不浅，汚迹身岂辱。",
        "鸾铩乐迍邅，虬蟠甘窘束。",
        "五噫谲且正，可以见心曲。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 294513,
      "title": "咏史",
      "content": [
        "田氏门下客，冯公众中贱。",
        "一朝市义还，百代名独擅。",
        "始知下客不可轻，能使主人功业成。",
        "借问高车与珠履，何如卑贱一书生。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 294514,
      "title": "读张曲江集",
      "content": [
        "相公乃天盖，人文佐生成。",
        "立程正颓靡，绎思何纵横。",
        "春杼弄缃绮，阳林敷玉英。",
        "飘然飞动姿，邈矣高简情。",
        "后辈惊失步，前修敢争衡。",
        "始欣耳目远，再使机虑清。",
        "体正力已全，理精识何妙。",
        "昔年歌阳春，徒推郢中调。",
        "今朝听鸾凤，岂独羡门啸。",
        "帝命镇雄州，待济寄上流。",
        "才兼荆衡秀，气助潇湘秋。",
        "逸荡子山匹，经奇文畅俦。",
        "沈吟未终卷，变态纷难数。",
        "曜耳代明珰，袭衣同芳杜。",
        "愔愔闻玉磬，寤寐在灵府。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 294515,
      "title": "奉酬陆使君见过各赋院中一物得江蓠",
      "content": [
        "江蓠生古砌，花每落禅床。",
        "嘉客未采掇，空门自馨香。",
        "名因诗目见，色对道心忘。",
        "不遇陆内史，谁知殊众芳。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 294516,
      "title": "赋得谢墅送王长史",
      "content": [
        "世业西山墅，移家长我身。",
        "萧疎遗树老，寂寞废田春。",
        "车巷伤前辙，篱沟忆旧隣。",
        "何堪再过日，更送北归人。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 294517,
      "title": "夏日同崔使君论登城楼赋得远山",
      "content": [
        "远山湖上小，青翠望依稀。",
        "才向窗中列，还从林表微。",
        "色浓春草在，峰起夏云归。",
        "不是蓬莱岛，如何人去稀。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 294518,
      "title": "咏数探得七",
      "content": [
        "邹子谭天岁，黄童对日年。",
        "求真初作传，炼魄已成仙。",
        "鹤驾迎缑岭，星桥下蜀川。",
        "逢君竹林客，相对弄清弦。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 294519,
      "title": "奉同颜使君真卿送李侍御萼赋得荻塘路",
      "content": [
        "落日车遥遥，客心在归路。",
        "细草暗回塘，春泉萦古渡。",
        "遗踪叹芜没，远道悲去住。",
        "寂寞荻花空，行人别无数。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 294520,
      "title": "赋颜氏古今一事得晋仙传送颜逸",
      "content": [
        "曾看颜氏传，多记晋时仙。",
        "却忆桐君老，俱还桂父年。",
        "青春留鬓发，白日向云烟。",
        "远别賷遗简，囊中有几篇。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 294521,
      "title": "赋得石梁泉送崔逵",
      "content": [
        "架石通霞壁，悬崖散碧沙。",
        "天晴虹影渡，风细练文斜。",
        "举陟幽期阻，沿洄客意赊。",
        "河梁非此路，别恨亦无涯。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 294522,
      "title": "赋得夜雨滴空堦送陆羽归龙山",
      "content": [
        "闲堦夜雨滴，偏入别情中。",
        "断续清猨应，淋漓候馆空。",
        "气令烦虑散，时与早秋同。",
        "归客龙山道，东来杂好风。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 294523,
      "title": "赋得灯心送李侍御萼",
      "content": [
        "灯心生众草，因有始知芳。",
        "彩妓窗偏丽，金桃动更香。",
        "花惊春未尽，焰喜夜初长。",
        "别后空离室，何人借末光。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 294524,
      "title": "赋得竹如意送详师赴讲",
      "content": [
        "缥竹湘南美，吾师尚毁形。",
        "仍留负霜节，不变在林青。",
        "每入杨枝手，因谈贝叶经。",
        "谁期沃州讲，持此别东亭。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 294525,
      "title": "听素法师讲法华经",
      "content": [
        "法子出西秦，名齐漆道人。",
        "才敷药草义，便见雪山春。",
        "护讲龙来远，闻经鹤下频。",
        "应机如一雨，谁不涤心尘。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 294526,
      "title": "咏敭上人座右画松",
      "content": [
        "写得长松意，千寻数尺中。",
        "翠阴疑背日，寒色欲生风。",
        "真树孤标在，高人立操同。",
        "一枝遥可折，吾欲问生公。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 294527,
      "title": "夏日登观农楼和崔使君",
      "content": [
        "片雨拂簷楹，烦襟四坐清。",
        "霏微过麦陇，萧散傍莎城。",
        "静爱和花落，幽闻入竹声。",
        "朝观趣无限，高咏寄深情。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 294528,
      "title": "妙喜寺逵公院赋得夜磬送吕评事",
      "content": [
        "一磬寒山至，凝心转清越。",
        "细和虚籁尽，疎绕悬泉发。",
        "在夜吟更长，停空韵难绝。",
        "幽僧悟深定，归客忘远别。",
        "寂历无性中，真声何起灭。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 294529,
      "title": "咏小瀑布",
      "content": [
        "瀑布小更奇，潺湲二三尺。",
        "细脉穿乱沙，丛声咽危石。",
        "初因智者赏，果会幽人迹。",
        "不向定中闻，那知我心寂。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 294530,
      "title": "僊女台",
      "content": [
        "寂寂旧桑田，谁家女得僊。",
        "应无鸡犬在，空有子孙传。",
        "古木花犹发，荒台路未迁。",
        "暮来云一片，疑是欲归年。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 294531,
      "title": "灵澈上人何山寺七贤石诗",
      "content": [
        "七石配七贤，隐僧山上移。",
        "石性殊磊落，君子又高奇。",
        "跂禅服宜坏，坐客冠可隳。",
        "夜倚月树影，昼倾风竹枝。",
        "集质患追琢，表顽用磷缁。",
        "佚火玉亦害，块然长在兹。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 294532,
      "title": "潘丞孩子",
      "content": [
        "爱子性情奇，初生玉树枝。",
        "人曾天上见，名向月中知。",
        "我识婴儿意，何须待佩觿。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 294533,
      "title": "南池杂咏五首 水月",
      "content": [
        "夜夜池上观，禅身坐月边。",
        "虚无色可取，皎洁意难传。",
        "若向空心了，长如影正圆。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 294534,
      "title": "南池杂咏五首 溪云",
      "content": [
        "舒卷意何穷，萦流复带空。",
        "有形不累物，无迹去随风。",
        "莫怪长相逐，飘然与我同。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 294535,
      "title": "南池杂咏五首 虚舟",
      "content": [
        "虚舟动又静，忽似去逢时。",
        "触物知无迕，为梁幸见遗。",
        "因风到此岸，非有济川期。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 294536,
      "title": "南池杂咏五首 寒山",
      "content": [
        "侵空撩乱色，独爱我中峰。",
        "无事负轻策，闲行蹑幽踪。",
        "众山摇落尽，寒翠更重重。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 294537,
      "title": "南池杂咏五首 寒竹",
      "content": [
        "褭褭孤生竹，独立山中雪。",
        "苍翠摇动风，婵娟带寒月。",
        "狂花不相似，还共凌冬发。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 294538,
      "title": "望远村",
      "content": [
        "林杪不可分，水步遥难辨。",
        "一片山翠边，依稀见村远。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 294539,
      "title": "惜暮景",
      "content": [
        "疎阴花不动，片景松梢度。",
        "夏日旧来长，佳游何易暮。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 294540,
      "title": "效古",
      "content": [
        "日出天地正，煌煌辟晨曦。",
        "六龙驱群动，古今无尽时。",
        "夸父亦何愚，竞走先自疲。",
        "饮干咸池水，折尽扶桑枝。",
        "渴死化爝火，嗟嗟徒尔为。",
        "空留邓林在，折尽令人嗤。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 294541,
      "title": "古别离",
      "content": [
        "太湖三山口，吴王在时道。",
        "寂寞千载心，无人见春草。",
        "谁识缄怨者，持此伤怀抱。",
        "孤舟畏狂风，一点宿烟岛。",
        "望所思兮若何，月荡漾兮空波。",
        "云离离兮北断，鸿眇眇兮南多。",
        "身去兮天畔，心折兮湖岸。",
        "春风胡为兮塞路，使我归梦兮撩乱。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 294542,
      "title": "拟长安春词",
      "content": [
        "春信在河源，春风荡妾魂。",
        "春歌杂𫛸鴂，春梦绕轘辕。",
        "春絮愁偏满，春丝闷更繁。",
        "春期不可定，春曲嬾新翻。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 294543,
      "title": "效古",
      "content": [
        "思君转战度交河，强弄胡琴不成曲。",
        "日落应愁陇底难，春来定梦江南数。",
        "万丈游丝是妾心，惹蝶萦花乱相续。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 294544,
      "title": "昭君怨",
      "content": [
        "自倚婵娟望主恩，谁知美恶忽相翻。",
        "黄金不买汉宫貌，青冢空埋胡地魂。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 294545,
      "title": "铜雀妓",
      "content": [
        "强开尊酒向陵看，忆得君王旧日懽。",
        "不觉余歌悲自断，非关艳曲转声难。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 294546,
      "title": "长门怨",
      "content": [
        "春风日日闭长门，摇荡春心似梦魂。",
        "谁遣花开只笑妾，不如桃李正无言。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 294547,
      "title": "哭吴县房耸明府",
      "content": [
        "仁人迈厚德，可谓名实全。",
        "抚迹若疎旷，会心极精研。",
        "履危节讵屈，著论识不偏。",
        "恨以荣级浅，嘉猷未及宣。",
        "伊人期远大，志业难比肩。",
        "昭世既合幷，吾君藉陶甄。",
        "奈何明明理，与善徒空诠。",
        "征教或稽圣，穷源反问天。",
        "一官自吴邑，六翮委江壖。",
        "始是牵丝日，翻成撤瑟年。",
        "金膏果不就，玉珮长此捐。",
        "倚伏信冥昧，夭修惊后先。",
        "安知忘情子，爱网素已褰。",
        "为有深仁感，遂令真性迁。",
        "心悲空林下，泪洒秋景前。",
        "夫子寡兄弟，抚孤伤藐然。",
        "倾云为惨结，吊鹤共联翩。",
        "割念命归驾，诀词向空筵。",
        "树桃阴始合，爱客位常悬。",
        "幡然远行时，崇望归朝旋。",
        "悟兹懽宴隔，哀被岁月延。",
        "书带变芳草，履痕移绿钱。",
        "冥期傥可逢，生尽会无缘。",
        "幸愿示因业，代君运精专。",
        "相思转寂寞，独往西林泉。",
        "欲见故人心，时阅所赠篇。",
        "素高陶靖节，今重楚先贤。",
        "芳躅将遗爱，可为终古传。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 294548,
      "title": "哭觉上人",
      "content": [
        "忆君南适越，不作买山期。",
        "昨得耶溪信，翻为逝水悲。",
        "神交如可见，生尽杳难思。",
        "白日东林下，空怀步影时。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 294549,
      "title": "题余不溪废寺",
      "content": [
        "武原离乱后，真界积尘埃。",
        "残月生秋水，悲风起故台。",
        "居人今已尽，栖鸽暝还来。",
        "不到无生理，应堪赋七哀。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 294550,
      "title": "同李洗马入余不溪经辛将军故城",
      "content": [
        "惨惨寒城望，将军下世时。",
        "高墉暮草遍，大树野风悲。",
        "壁垒今惟在，勋庸近可思。",
        "苍然古溪上，川逝共凄其。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 294551,
      "title": "忆天台",
      "content": [
        "箬溪朝雨散，云色似天台。",
        "应是东风便，吹从海上来。",
        "灵山游汗漫，仙石过莓苔。",
        "误到人间世，经年不早回。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 294552,
      "title": "万回寺",
      "content": [
        "万里称逆化，愚惷性亦全。",
        "紫绂拖身上，妖姬安膝前。",
        "见他拘坐寂，故我是眠禅。",
        "吾知至人心，杳若青冥天。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 294553,
      "title": "禅诗",
      "content": [
        "万法出无门，纷纷使智昏。",
        "徒称谁氏子，独立天地元。",
        "实际且何有，物先安可存。",
        "须知不动念，照山万重源。"
      ],
      "author": {
        "id": 8777,
        "name": "皎然"
      },
