{
  "data": [
    {
      "id": 351435,
      "title": "酬杭州白使君，兼寄浙东元大夫",
      "content": [
        "相印暂离临远镇，掖垣出守复同时。",
        "一行已作三年别，",
        "人间聚散真难料，莫叹平生信所之。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351436,
      "title": "寄苏州白二十二使君",
      "content": [
        "三朝出入紫微臣，头白金章未在身。",
        "登第早年同座主，",
        "此处吟诗向山寺，知君忘却曲江春。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351437,
      "title": "送白宾客分司东都",
      "content": [
        "赫赫声名三十春，高情人独出埃尘。",
        "病辞省闼归闲地，",
        "老人也拟休官去，便是君家池上人。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351438,
      "title": "赠阎少保",
      "content": [
        "辞荣恋阙未还乡，修养年多气力强。",
        "半俸归烧伏火药，",
        "竹树晴深寒院静，长悬石磬在虚廊。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351439,
      "title": "赠别王侍御赴任陕州司马",
      "content": [
        "京城在处闲人少，唯共君行并马蹄。",
        "更和诗篇名最出，",
        "今日春明门外别，更无因得到街西。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351440,
      "title": "田司空入朝",
      "content": [
        "西来将相位兼雄，不与诸君觐礼同。",
        "早变山东知顺命，",
        "阊阖晓开铜漏静，身当受册大明宫。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351441,
      "title": "送浙西周判官",
      "content": [
        "由来自是烟霞客，早已闻名诗酒间。",
        "天阙因将贺表到，",
        "吴越主人偏爱重，多应不肯放君闲。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351442,
      "title": "送吴炼师归王屋",
      "content": [
        "玉阳峰下学长生，玉洞仙中已有名。",
        "独戴熊须冠暂出，",
        "却到瑶坛上头宿，应闻空里步虚声。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351443,
      "title": "送邵州林使君",
      "content": [
        "词客南行宠命新，潇湘郡入曲江津。",
        "山幽自足探微处，",
        "知君不作家私计，迁日还同到日贫。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351444,
      "title": "寄王六侍御",
      "content": [
        "渐觉近来筋力少，难堪今日在风尘。",
        "谁能借问功名事，",
        "洞庭已置新居处，归去安期与作邻。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351445,
      "title": "送稽亭山寺僧",
      "content": [
        "师住稽亭高处寺，斜廊曲阁倚云开。",
        "山门十里松间入，",
        "旧房到日闲吟后，林下还登说法台。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351446,
      "title": "送汀州源使君",
      "content": [
        "曾成赵北归朝计，因拜王门最好官。",
        "为郡暂辞双凤阙，",
        "地僻寻常来客少，刺桐花发共谁看。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351447,
      "title": "寄孙洛阳格",
      "content": [
        "久持刑宪声名远，好是中朝正直臣。",
        "赤县上来应足事，",
        "遥爱南桥秋日晚，雨边杨柳映天津。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351448,
      "title": "胡山人归王屋，因有赠",
      "content": [
        "转转无成到白头，人间举眼尽堪愁。",
        "此生已是蹉跎去，",
        "君归与访移家处，若个峰头最较幽。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351449,
      "title": "寄虔州韩使君",
      "content": [
        "南康太守负才豪，五十如今未拥旄。",
        "早得一人知姓字，",
        "郡政已成秋思远，闲吟应不问官曹。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351450,
      "title": "送从弟蒙赴饶州",
      "content": [
        "京城南去鄱阳远，风月悠悠别思劳。",
        "三领郡符新寄重，",
        "到日更行清静化，春田应不见蓬蒿。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351451,
      "title": "罗道士",
      "content": [
        "城里无人得实年，衣襟常带臭黄烟。",
        "楼中赊酒唯留药，",
        "寻常行处皆逢见，世上多疑是谪仙。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351452,
      "title": "寄陆浑赵明府",
      "content": [
        "与君学省同官处，常日相随说道情。",
        "新作陆浑山县长，",
        "公事稀疏来客少，无妨著屐独闲行。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351453,
      "title": "同将作韦二少监赠水部李郎中",
      "content": [
        "旧年同是水曹郎，各罢鱼符自楚乡。",
        "重著青衫承诏命，",
        "忆得当时亦连步，如今独在读书堂。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351454,
      "title": "赠王侍御",
      "content": [
        "心同野鹤与尘远，诗似冰壶见底清。",
        "府县同趋昨日事，",
        "自叹独为折腰吏，可怜骢马路傍行。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351455,
      "title": "送金少卿副使归新罗",
      "content": [
        "云岛茫茫天畔微，向东万里一帆飞。",
        "久为侍子承恩重，",
        "从前此去人无数，光彩如君定是稀。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351456,
      "title": "送李司空赴镇襄阳",
      "content": [
        "中外兼权社稷臣，千官齐出拜行尘。",
        "再调公鼎勋庸盛，",
        "襄阳风景由来好，重与江山作主人。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351457,
      "title": "送李仆射愬赴镇凤翔",
      "content": [
        "由来勋业属英雄，兄弟连营列位同。",
        "先入贼城擒首恶，",
        "天子新收秦陇地，故教移镇古扶风。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351458,
      "title": "寄白二十二舍人",
      "content": [
        "早知内诏过先辈，蹭蹬江南百事疏。",
        "湓浦城中为上佐，",
        "三省比来名望重，肯容君去乐樵渔。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351459,
      "title": "送友人卢处士游吴越",
      "content": [
        "羡君东去见残梅，惟有王孙独未回。",
        "吴苑夕阳明古堞，",
        "试问渔舟看雪浪，几多江燕荇花开。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 351460,
      "title": "苏州江岸留别乐天",
      "content": [
        "银泥裙映锦障泥，画舸停桡马簇蹄。",
        "清管曲终鹦鹉语，",
        "莫忘使君吟咏处，女坟湖北武丘西。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351461,
      "title": "寒食看花",
      "content": [
        "早入公门到夜归，不因寒食少闲时。",
        "颠狂绕树猿离锁，",
        "老来自喜常无事，仰面西园得咏诗。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351462,
      "title": "酬浙东元尚书见寄绫素",
      "content": [
        "越地缯纱纹样新，远封来寄学曹人。",
        "便令裁制为时服，",
        "三千里外无由见，海上东风又一春。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351463,
      "title": "赠项斯",
      "content": [
        "端坐吟诗忘忍饥，万人中觅似君稀。",
        "门连野水风长到，",
        "曲江亭上频频见，为爱鸬鹚雨里飞。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351464,
      "title": "和韦开州盛山十二首：宿云亭",
      "content": [
        "清净当深处，虚明向远开。",
        "卷帘无俗客，应只见云来。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 351465,
      "title": "和韦开州盛山十二首：梅溪",
      "content": [
        "自爱新梅好，行寻一径斜。",
        "不教人扫石，恐损落来花。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 351466,
      "title": "和韦开州盛山十二首：茶岭",
      "content": [
        "紫芽连白蕊，初向岭头生。",
        "自看家人摘，寻常触露行。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 351467,
      "title": "和韦开州盛山十二首：流杯渠",
      "content": [
        "渌酒白螺杯，随流去复回。",
        "似知人把处，各向面前来。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 351468,
      "title": "和韦开州盛山十二首：磐石磴",
      "content": [
        "垒石盘空远，层层势不危。",
        "不知行几匝，得到上头时。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 351469,
      "title": "和韦开州盛山十二首：桃坞",
      "content": [
        "春坞桃花发，多将野客游。",
        "日西殊未散，看望酒缸头。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 351470,
      "title": "和韦开州盛山十二首：竹岩",
      "content": [
        "独入千竿里，缘岩踏石层。",
        "笋头齐欲出，更不许人登。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 351471,
      "title": "和韦开州盛山十二首：琵琶台",
      "content": [
        "台上绿萝春，闲登不待人。",
        "每当休暇日，著履戴纱巾。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 351472,
      "title": "和韦开州盛山十二首：胡芦沼",
      "content": [
        "曲沼春流满，新蒲映野鹅。",
        "闲斋朝饭后，拄杖绕行多。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 351473,
      "title": "和韦开州盛山十二首：隐月岫",
      "content": [
        "月出深峰里，清凉夜亦寒。",
        "每嫌西落疾，不得到明看。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 351474,
      "title": "和韦开州盛山十二首：绣衣石榻",
      "content": [
        "山城无别味，药草兼鱼果。",
        "时到绣衣人，同来石上坐。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 351475,
      "title": "和韦开州盛山十二首：上士泉瓶",
      "content": [
        "阶上一眼泉，四边青石甃。",
        "唯有护净僧，添瓶将盥漱。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 351483,
      "title": "岸花",
      "content": [
        "可怜岸边树，红蕊发青条。",
        "东风吹渡水，冲著木兰桡。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 351485,
      "title": "送蜀客",
      "content": [
        "蜀客南行祭碧鸡，木绵花发锦江西。",
        "山桥日晚行人少，时见猩猩树上啼。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 351488,
      "title": "美人宫棋",
      "content": [
        "红烛台前出翠娥，海沙铺局巧相和。",
        "趁行移手巡收尽，数数看谁得最多。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 351494,
      "title": "题玉像堂",
      "content": [
        "玉毫不著世间尘，辉相分明十八身。",
        "入夜无烟灯更好，堂中唯有转经人。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 351498,
      "title": "患眼",
      "content": [
        "三年患眼今年校，免与风光便隔生。",
        "昨日韩家后园里，看花犹似未分明。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 351500,
      "title": "赠华严院僧",
      "content": [
        "一身依止荒闲院，烛耀窗中有宿烟。",
        "遍礼华严经里字，不曾行到寺门前。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 351506,
      "title": "送许处士",
      "content": [
        "高情自与俗人疏，独向蓝溪选僻居。",
        "会到白云长取醉，不能窗下读闲书。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 351510,
      "title": "送僧往金州",
      "content": [
        "闻道溪阴山水好，师行一一遍经过。",
        "事须觅取堪居处，若个溪头药最多。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 351512,
      "title": "答开州韦使君寄车前子",
      "content": [
        "开州午日车前子，作药人皆道有神。",
        "惭愧使君怜病眼，三千余里寄闲人。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 351517,
      "title": "赠李司议",
      "content": [
        "汉庭谁问投荒客，十载天南著白衣。",
        "秋草茫茫恶溪路，岭头遥送北人稀。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 351520,
      "title": "答刘明府",
      "content": [
        "身病多时又客居，满城亲旧尽相疏。",
        "可怜绛县刘明府，犹解频频寄远书。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 351523,
      "title": "寄故人",
      "content": [
        "静曲闲房病客居，蝉声满树槿花疏。",
        "故人只在蓝田县，强半年来未得书。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 351526,
      "title": "和裴仆射看樱桃花",
      "content": [
        "昨日南园新雨后，樱桃花发旧枝柯。",
        "天明不待人同看，绕树重重履迹多。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 351536,
      "title": "同严给事闻唐昌观玉蕊近有仙过，因成绝句二首",
      "content": [
        "千枝花里玉尘飞，阿母宫中见亦稀。",
        "应共诸仙斗百草，独来偷得一枝归。",
        "九色云中紫凤车，寻仙来到洞仙家。",
        "飞轮回处无踪迹，唯有斑斑满地花。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 351542,
      "title": "凉州词三首",
      "content": [
        "边城暮雨雁飞低，芦笋初生渐欲齐。",
        "无数铃声遥过碛，应驮白练到安西。",
        "古镇城门白碛开，胡兵往往傍沙堆。",
        "巡边使客行应早，欲问平安无使来。",
        "凤林关里水东流，白草黄榆六十秋。",
        "边将皆承主恩泽，无人解道取凉州。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 351543,
      "title": "宫词",
      "content": [
        "新鹰初放兔犹肥，白日君王在内稀。",
        "薄暮千门临欲锁，红妆飞骑向前归。",
        "黄金捍拨紫檀槽，弦索初张调更高。",
        "尽理昨来新上曲，内官帘外送樱桃。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 351547,
      "title": "刘兵曹赠酒",
      "content": [
        "一瓶颜色似甘泉，闲向新栽小竹前。",
        "饮罢身中更无事，移床独就夕阳眠。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 351550,
      "title": "寄朱、阚二山人",
      "content": [
        "为个朝章束此身，眼看东路去无因。",
        "历阳旧客今应少，转忆邻家二老人。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 351554,
      "title": "答鄱阳客药名诗",
      "content": [
        "江皋岁暮相逢地，黄叶霜前半夏枝。",
        "子夜吟诗向松桂，心中万事喜君知。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 351562,
      "title": "送元八",
      "content": [
        "百神斋祭相随遍，寻竹看山亦共行。",
        "明日城西送君去，旧游重到独题名。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 351564,
      "title": "题方睦上人月台观",
      "content": [
        "一身清净无童子，独坐空堂得几年。",
        "每夜焚香通月观，可怜光影最团圆。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 351570,
      "title": "逢贾岛",
      "content": [
        "僧房逢著款冬花，出寺行吟日已斜。",
        "十二街中春雪遍，马蹄今去入谁家。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 351572,
      "title": "弱柏院僧影堂",
      "content": [
        "弱柏倒垂如线蔓，簷头不见有枝柯。",
        "影堂香火长相续，应得人来礼拜多。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 351575,
      "title": "山禽",
      "content": [
        "山禽毛如白练带，栖我庭前栗树枝。",
        "猕猴半夜来取栗，一双中林向月飞。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 351581,
      "title": "宿天竺寺，寄灵隐寺僧",
      "content": [
        "夜向灵溪息此身，风泉竹露净衣尘。",
        "月明石上堪同宿，那作山南山北人。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 351582,
      "title": "酬朱庆余",
      "content": [
        "越女新妆出镜心，自知明艳更沉吟。",
        "齐纨未是人间贵，一曲菱歌敌万金。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 351584,
      "title": "寒食",
      "content": [
        "绿杨枝上五丝绳，枝弱春多欲不胜。",
        "唯有一年寒食日，女郎相唤摆阶o3。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351585,
      "title": "赋花",
      "content": [
        "花，花。",
        "落早，开赊。",
        "对酒客，兴诗家。",
        "能回游骑，"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 376700,
      "title": "野老歌",
      "content": [
        "老农家贫在山住，耕种山田三四亩。",
        "苗疏税多不得食，输入官仓化为土。",
        "岁暮锄犁傍空室，呼儿登山收橡实。",
        "西江贾客珠百斛，船中养犬长食肉。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 376701,
      "title": "没蕃故人",
      "content": [
        "前年戍月支，城下没全师。",
        "蕃汉断消息，死生长别离。",
        "无人收废帐，归马识残旗。",
        "欲祭疑君在，天涯哭此时。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    }
  ],
