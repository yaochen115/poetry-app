  "data": [
    {
      "id": 121180,
      "title": "卷雪楼",
      "content": [
        "烟水苍苍古渡头，神鸦噪罢缆方收。",
        "泊舟凫渚鸥汀晚，夜入兰宫桂殿秋。",
        "绿苇黄芦悲落日，白苹红蓼閙沧洲。",
        "冥冥千古今如梦，浩浩长江不管愁。",
        "鴈阵归时云似幕，风樯高处月如钩。",
        "惊涛飞起银花舞，万顷寒光十二楼。"
      ],
      "author": {
        "id": 8874,
        "name": "白玉蟾"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 171602,
      "title": "题桂殿秋辞  其一",
      "content": [
        "飞翠盖，走篮舆，乱山千叠为先驱。",
        "洞天迎目深且窈，满耳天风吹步虚。"
      ],
      "author": {
        "id": 432,
        "name": "李仁本"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 171603,
      "title": "题桂殿秋辞  其二",
      "content": [
        "巑兽石，错虬松，黛岚终日下天风。",
        "杖藜携我恣遥望，缥缈霓裳飞碧空。"
      ],
      "author": {
        "id": 432,
        "name": "李仁本"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 171604,
      "title": "题桂殿秋辞  其三",
      "content": [
        "金带重，紫袍宽，到头不似羽衣闲。",
        "君王若许供香火，神武门前早挂冠。"
      ],
      "author": {
        "id": 432,
        "name": "李仁本"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298353,
      "title": "桂殿秋 一",
      "content": [
        "仙女下，董双成，汉殿夜凉吹玉笙。",
        "曲终却从仙官去，万户千门惟月明。"
      ],
      "author": {
        "id": 2045,
        "name": "李白"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298354,
      "title": "桂殿秋 二",
      "content": [
        "河汉女，玉炼颜，云𫐌往往在人间。",
        "九霄有路去无迹，袅袅香风生佩环。"
      ],
      "author": {
        "id": 2045,
        "name": "李白"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 301605,
      "title": "桂花曲",
      "content": [
        "仙女侍，董双成，桂殿夜凉（一作「寒」）吹玉笙。",
        "曲终却从仙宫去，万户千门空月明。",
        "河汉女，玉练颜，云𫐌往往到人间。",
        "九霄有路去无际（一作「迹」），袅袅大风吹珮环。",
        "《苕溪渔隐业话后集》十二：「战斗曲《许彦周诗话》谓是李卫公作，《桐江诗话》谓是均州武当山石壁上刻之，云神仙所作，未知孰是。",
        "」（《全唐诗补逸》卷五以前五句作李栖筠诗，未妥，今删彼存此。",
        "详参书末之修订说明。",
        "《全唐诗》卷八九○收作李白《桂殿秋》词，恐误。"
      ],
      "author": {
        "id": 5714,
        "name": "李德谷"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 317010,
      "title": "桂殿秋",
      "content": [
        "青帝子，碧莲宫。",
        "不驾云车骑白龙。",
        "瑶池路远羽衣湿，玉珮泠泠明月中。"
      ],
      "author": {
        "id": 2970,
        "name": "刘翰"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 317011,
      "title": "桂殿秋",
      "content": [
        "双玉节，到神京。",
        "碧杯仙露冷如冰。",
        "一声金磬千花发，洞口天风吹洒醒。"
      ],
      "author": {
        "id": 2970,
        "name": "刘翰"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
