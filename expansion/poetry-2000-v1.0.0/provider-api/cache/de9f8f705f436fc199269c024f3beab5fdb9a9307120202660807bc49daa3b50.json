{
  "data": [
    {
      "id": 206505,
      "title": "次韵奉答文少激推官纪赠二首  其一",
      "content": [
        "诗来清吹拂衣巾，句法词锋觉有神。",
        "今日相看青眼旧，他年肯作白头新。",
        "文如雾豹容窥管，气似灵犀可辟尘。",
        "慙愧相期在台省，无心枯木岂能春。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 206506,
      "title": "次韵奉答文少激推官纪赠二首  其二",
      "content": [
        "文章藻鉴随时去，人物权衡逐势低。",
        "扬子墨池春草遍，武侯祠庙晓鶑啼。",
        "书帷寂寞知音少，幕府留连要路迷。",
        "顾我何人敢推挽，看君桃李合成蹊。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 206507,
      "title": "次韵文少激祈雨有感",
      "content": [
        "穷儒忧乐与民同，何况朱轮职劝农。",
        "终日虀盐供一饭，几时肤寸冒千峰。",
        "未须丘垤占鸣鹳，只要朝廷起卧龙。",
        "从此滂沱徧枯槁，爱民天子似仁宗。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 206508,
      "title": "次韵李任道晚饮锁江亭",
      "content": [
        "西来雪浪如炰烹，两涯一苇乃可横。",
        "忽思钟陵江十里，白苹风起縠纹生。",
        "酒杯未觉浮蚁滑，茶鼎已作苍蝇鸣。",
        "归时共须落日尽，亦嫌持盖仆屡更。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 206509,
      "title": "再次韵兼简履中南玉三首  其一",
      "content": [
        "李侯诗律严且清，诸生赓载笔纵横。",
        "句中稍觉道战胜，胸次不使俗尘生。",
        "山绕楼台钟鼓晚，江触石矶碪杵鸣。",
        "锁江主人能致酒，愿渠久住莫终更。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 206510,
      "title": "再次韵兼简履中南玉三首  其二",
      "content": [
        "江津道人心源清，不系虚舟尽日横。",
        "道机禅观转万物，文采风流被诸生。",
        "与世浮沈惟酒可，随人忧乐以诗鸣。",
        "江头一醉岂易得，事如浮云多变更。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 206511,
      "title": "再次韵兼简履中南玉三首  其三",
      "content": [
        "锁江亭上一樽酒，山自白云江自横。",
        "李侯短褐有长处，不与俗物同条生。",
        "经术貂蝉续狗尾，文章瓦釜作雷鸣。",
        "古来寒士但守节，夜夜抱关听五更。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 206512,
      "title": "次韵任道食荔支有感三首  其一",
      "content": [
        "一钱不直程卫尉，万事称好司马公。",
        "白发永无怀橘日，六年怊怅荔支红。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206513,
      "title": "次韵任道食荔支有感三首  其二",
      "content": [
        "今年荔子熟南风，莫愁留滞太史公。",
        "五月照江鸭头绿，六月连山柘枝红。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206514,
      "title": "次韵任道食荔支有感三首  其三",
      "content": [
        "舞女荔支熟虽晚，临江照影自恼公。",
        "天与蹙罗装宝髻，更挼猩血染殷红。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206515,
      "title": "廖致平送绿荔支为戎州第一王公权荔支绿酒亦为戎州第一",
      "content": [
        "王公权家荔支绿，廖致平家绿荔支。",
        "试倾一杯重碧色，快剥千颗轻红肌。",
        "拨醅蒲萄未足数，堆盘马乳不同时。",
        "谁能同此胜绝味，唯有老杜东楼诗。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 206516,
      "title": "谢杨履道送银茄四首  其一",
      "content": [
        "藜藿盘中生精神，珍蔬长蒂色胜银。",
        "朝来盐醯饱滋味，已觉瓜瓠漫轮囷。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206517,
      "title": "谢杨履道送银茄四首  其二",
      "content": [
        "君家水茄白银色，殊胜埧里紫彭亨。",
        "蜀人生疏不下箸，吾与北人俱眼明。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206518,
      "title": "谢杨履道送银茄四首  其三",
      "content": [
        "白金作颗非椎成，中有万粟嚼轻冰。",
        "戎州夏畦少蔬供，感君来饭在家僧。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206519,
      "title": "谢杨履道送银茄四首  其四",
      "content": [
        "畦丁收尽垂露实，叶底犹藏十二三。",
        "待得银包已成谷，更当乞种过江南。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206520,
      "title": "送石长卿太学秋补",
      "content": [
        "长卿家亦但四壁，文君窥之介如石。",
        "胸中已无少年事，骨气乃有老松格。",
        "汉文新览天下图，诏山采玉渊献珠。",
        "再三可陈治安策，第一莫上登封书。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 206521,
      "title": "次韵少激甘露降太守居桃叶上",
      "content": [
        "金茎甘露荐斋房，润及边城草木香。",
        "蕡实叶间天与味，成蹊枝上月翻光。",
        "群心爱戴葵倾日，万事驱除叶陨霜。",
        "玉烛时和君会否，旧臣重叠起南荒。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 206522,
      "title": "借景亭",
      "content": [
        "青神县中得两张，爱民财力惟恐伤。",
        "二公身安民乃乐，劝葺城头五月凉。",
        "竹铺不涴吴绫袜，东西开轩荫清樾。",
        "当官借景不伤民，恰似凿池取明月。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 206523,
      "title": "戏赠家安国",
      "content": [
        "家侯口吃善著书，常愿执戈王前驱。",
        "朱绂蹉跎晚监郡，吟弄风月思天衢。",
        "二苏平生亲且旧，少年笔砚老杯酒。",
        "但使一气转洪钧，此老矍铄还冠军。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 206524,
      "title": "次韵杨君全送酒",
      "content": [
        "扶衰却老世无方，惟有君家酒未尝。",
        "秋入园林花老眼，茗搜文字响枯肠。",
        "醡头夜雨排簷滴，杯面春风绕鼻香。",
        "不待澄清遣分送，定知佳客对空觞。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 206525,
      "title": "次韵杨君全送春花",
      "content": [
        "化工能斡大钧回，不得东君花不开。",
        "谁道纤纤绿窗手，磨刀剪彩唤春来。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206526,
      "title": "谢杨景山送酒器",
      "content": [
        "杨君喜我梨花盏，却念初无注酒魁。",
        "矲矮金壶肯持送，挼莎残菊更传杯。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206527,
      "title": "史彦升送春花",
      "content": [
        "千林摇落照秋空，忽散秾花在眼中。",
        "蝶绕蜂随俱入座，君家女手化春风。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206528,
      "title": "题石恪画尝醋翁",
      "content": [
        "石媪忍酸喙三尺，石皤尝味面百折。",
        "谁知耸膊寒至骨，图画不减吴生笔。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206529,
      "title": "谢应之",
      "content": [
        "昨夜风雷震海隅，天心急拟活焦枯。",
        "去年席上蛟龙语，未委先生记得无。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206530,
      "title": "走笔谢王朴居士拄杖",
      "content": [
        "投我木瓜霜雪枝，六年流落放归时。",
        "千岩万壑须重到，脚底危时幸见持。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206531,
      "title": "戏答王居士送文石",
      "content": [
        "南极一星天九秋，自埋光景落江流。",
        "是公至乐山中物，乞与衰翁似暗投。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206532,
      "title": "次韵杨明叔见饯十首  其一",
      "content": [
        "平津善牧豕，佽飞能斩蛟。",
        "终藉一汲黯，淮南解兵交。",
        "杨子有直气，未忍死草茅。",
        "引之入汉朝，谁为续弦胶。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 206533,
      "title": "次韵杨明叔见饯十首  其二",
      "content": [
        "杨君清渭水，自流浊泾中。",
        "今年贫到骨，豪气似元龙。",
        "男儿生世间，笔端吐白虹。",
        "何事与秋萤，争光蒲苇丛。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 206534,
      "title": "次韵杨明叔见饯十首  其三",
      "content": [
        "事随世滔滔，心欲自得得。",
        "杨君为己学，度越流辈百。",
        "坐扪故衣虱，垢袜春汗黑。",
        "睥睨纨袴儿，可饮三斗墨。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 206535,
      "title": "次韵杨明叔见饯十首  其四",
      "content": [
        "清静草玄学，西京有子云。",
        "太尉死宗社，大鸟泣其坟。",
        "寂寞向千载，风流被仍昆。",
        "富贵何足道，圣处要策勋。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 206536,
      "title": "次韵杨明叔见饯十首  其五",
      "content": [
        "桑舆金石交，既别十日雨。",
        "子舆裹饭来，一笑相告语。",
        "杨子困箪瓢，诸公不能举。",
        "傥可从我归，沙头驻鸣𫇛。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 206537,
      "title": "次韵杨明叔见饯十首  其六",
      "content": [
        "山围少天日，狐鬼能作妖。",
        "睒闪载一车，猎人用鸣枭。",
        "小智窘流俗，蹇浅不能超。",
        "安得万里沙，晴天看射雕。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
