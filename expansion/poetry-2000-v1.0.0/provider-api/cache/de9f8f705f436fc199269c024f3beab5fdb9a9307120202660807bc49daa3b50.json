        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 206538,
      "title": "次韵杨明叔见饯十首  其七",
      "content": [
        "元之如砥柱，大年若霜鹗。",
        "王杨立本朝，与世作郛郭。",
        "观公有胆气，自可继前作。",
        "丈夫存远大，胸次要落落。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 206539,
      "title": "次韵杨明叔见饯十首  其八",
      "content": [
        "虚心观万物，险易极变态。",
        "皮毛剥落尽，惟有真实在。",
        "侍中乃珥貂，御史则冠豸。",
        "照影或可羞，短蓑钓寒濑。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 206540,
      "title": "次韵杨明叔见饯十首  其九",
      "content": [
        "松柏生涧壑，坐阅草木秋。",
        "金石在波中，仰看万物流。",
        "抗脏自抗脏，伊优自伊优。",
        "但观百岁后，传者非公侯。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 206541,
      "title": "次韵杨明叔见饯十首  其一○",
      "content": [
        "老作同安守，蹇足信所便。",
        "胸中无水镜，敢当吏部铨。",
        "恨此虚名在，未脱世纠缠。",
        "梦作白鸥去，江南水如天。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 206542,
      "title": "次韵石七三六言七首  其一",
      "content": [
        "从来不似一物，妄欲贯穿九流。",
        "骨硬非黄合相，眼青见白苹洲。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206543,
      "title": "次韵石七三六言七首  其二",
      "content": [
        "生涯一九节筇，老境五十六翁。",
        "不堪上补黼黻，但可归教儿童。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206544,
      "title": "次韵石七三六言七首  其三",
      "content": [
        "万里草荒先垄，六年虫蠹群经。",
        "老喜宽恩放去，心似惊波不停。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206545,
      "title": "次韵石七三六言七首  其四",
      "content": [
        "为君试讲古学，此事可牋天公。",
        "君看花梢朝露，何如松上霜风。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206546,
      "title": "次韵石七三六言七首  其五",
      "content": [
        "幽州已投斧柯，崇山更用忧何。",
        "且喜龚邹冠豸，又闻张董上坡。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206547,
      "title": "次韵石七三六言七首  其六",
      "content": [
        "看著庄周枯槁，化为胡蝶翾轻。",
        "人见穿花入柳，谁知有体无情。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206548,
      "title": "次韵石七三六言七首  其七",
      "content": [
        "欲行水遶山围，但闻鲲化鹏飞。",
        "女忧鬓发尽白，兄叹江船未归。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206549,
      "title": "万州太守高仲本宿约游岑公洞而夜雨连明戏作二首  其一",
      "content": [
        "肩舆欲到岑公洞，正怯冲泥傍险行。",
        "定是岑公閟清境，春江一夜雨连明。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206550,
      "title": "万州太守高仲本宿约游岑公洞而夜雨连明戏作二首  其二",
      "content": [
        "蓬窗高卧雨如绳，恰似糟床压酒声。",
        "今日岑公不能饮，吾侪闻健且频倾。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206551,
      "title": "万州下岩二首  其一",
      "content": [
        "空岩静发钟磬响，古木倒挂藤萝昏。",
        "莫道苍崖锁灵骨，时应持钵到诸村。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206552,
      "title": "万州下岩二首  其二",
      "content": [
        "寺古松楠老，岩虚塔庙开。",
        "僧缘蚕麦去，官数荔支来。",
        "石室无心骨，金铺称意苔。",
        "若为刘道者，拽得鼻头回。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 206553,
      "title": "又戏题下岩",
      "content": [
        "往往携家来托宿，裙襦参错佛衣巾。",
        "未嫌满院油头臭，蹋破苔钱最恼人。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206554,
      "title": "戏题巫山县用杜子美韵",
      "content": [
        "巴俗深留客，吴侬但忆归。",
        "直知难共语，不是故相违。",
        "东县闻铜臭，江陵换袷衣。",
        "丁宁巫峡雨，慎莫暗朝晖。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 206555,
      "title": "和王观复洪驹父谒陈无己长句",
      "content": [
        "陈君今古焉不学，清渭无心映泾浊。",
        "汉官旧仪重九鼎，集贤学士见一角。",
        "王侯文采似於菟，洪甥人间汗血驹。",
        "相将问道城南隅，无屋正借船官居。",
        "有书万卷绕四壁，樵苏不爨谈至夕。",
        "主人自是文章伯，邻里颇怪有此客。",
        "食贫各仕天一方，佳人可思不可忘。",
        "河从天来砥柱立，爱莫助之涕淋浪。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206556,
      "title": "以古铜壶送王观复",
      "content": [
        "随俗易汩没，从公常纠纷。",
        "我观王隆化，入莸不改薰。",
        "未见蛇起陆，已看豹成文。",
        "爱君古人风，古壶投赠君。",
        "酌酒时在傍，可用弭楚氛。",
        "问君何以报，直谅与多闻。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206557,
      "title": "病起荆江亭即事十首  其一",
      "content": [
        "翰墨场中老伏波，菩提坊里病维摩。",
        "近人积水无鸥鹭，时有归牛浮鼻过。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206558,
      "title": "病起荆江亭即事十首  其二",
      "content": [
        "维摩老子五十七，大圣天子初元年。",
        "传闻有意用幽侧，病著不能朝日边。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206559,
      "title": "病起荆江亭即事十首  其三",
      "content": [
        "禁中夜半定天下，仁风义气彻修门。",
        "十分整顿乾坤了，复辟归来道更尊。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206560,
      "title": "病起荆江亭即事十首  其四",
      "content": [
        "成王小心似文武，周召何妨略不同。",
        "不须要出我门下，实用人材即至公。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206561,
      "title": "病起荆江亭即事十首  其五",
      "content": [
        "司马丞相昔登庸，诏用元老超群公。",
        "杨绾当朝天下喜，断碑零落卧秋风。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206562,
      "title": "病起荆江亭即事十首  其六",
      "content": [
        "死者已死黄雾中，三事不数两苏公。",
        "岂谓高才难驾御，空归万里白头翁。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206563,
      "title": "病起荆江亭即事十首  其七",
      "content": [
        "文章韩杜无遗恨，草诏陆贽倾诸公。",
        "玉堂端要真学士，须得儋州秃鬓翁。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206564,
      "title": "病起荆江亭即事十首  其八",
      "content": [
        "闭门觅句陈无己，对客挥毫秦少游。",
        "正字不知温饱未，西风吹泪古藤州。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206565,
      "title": "病起荆江亭即事十首  其九",
      "content": [
        "张子耽酒语蹇吃，闻道颍州又陈州。",
        "形模弥勒一布袋，文字江河万古流。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206566,
      "title": "病起荆江亭即事十首  其一○",
      "content": [
        "鲁中狂士邢尚书，本意扶日上天衢。",
        "惇夫若在𫔔此老，不令平地生崎岖。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206567,
      "title": "邹松滋寄苦竹泉橙曲莲子汤三首  其一",
      "content": [
        "松滋县西竹林寺，苦竹林中甘井泉。",
        "巴人漫说虾蟆培，试裹春芽来就煎。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206568,
      "title": "邹松滋寄苦竹泉橙曲莲子汤三首  其二",
      "content": [
        "天将金阙真黄色，借与洞庭霜后橙。",
        "松滋解作逡巡曲，压倒江南好事僧。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206569,
      "title": "邹松滋寄苦竹泉橙曲莲子汤三首  其三",
      "content": [
        "新收千百秋莲菂，剥尽红衣捣玉霜。",
        "不假参同成气味，跳珠椀里绿荷香。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206570,
      "title": "次韵答黄与迪",
      "content": [
        "和氏有尺璧，楚国无人知。",
        "青山抱国器，岁月忽如遗。",
        "但使玉非石，果有遭逢时。",
        "吾宗固神秀，天乃晚成之。",
        "兰芳深九畹，露味挹三危。",
        "流俗不顾省，古人可前追。",
        "胸中凌云赋，自贵知音希。",
        "渊源学未浅，孝友家正肥。",
        "与世殊轨辙，三黜理亦宜。",
        "吴溪浣纱女，不用朱粉施。",
        "岂伊风尘子，市门自夸毗。",
        "我作僰道囚，三年始放归。",
        "邂逅终日语，贻我五字诗。",
        "句如秋雨晴，远峰抹修眉。",
        "老马甘伏枥，坐看天骥驰。",
        "洒扫清樾下，当为果茗期。",
        "光阴去易失，日月转两仪。",
        "仲氏有东园，花竹深可依。",
        "寸步不往来，千里常梦思。",
        "几时开后户，扶策方自兹。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206571,
      "title": "次前韵谢与迪惠所作竹五幅",
      "content": [
        "吾宗墨修竹，心手不自知。",
        "天公造化炉，揽取如拾遗。",
        "风雪烟雾雨，荣悴各一时。",
        "此物抱晚节，君又润色之。",
        "抽萌或发石，悬箠有阽危。",
        "林梢一片雨，造次以笔追。",
        "猛吹万籁作，微凉大音希。",
        "霜兔束毫健，松烟泛砚肥。",
        "盘桓未落笔，落笔必中宜。",
        "今代捧心学，取笑如东施。",
        "或可遗巾帼，选耎如辛毗。",
        "生枝不应节，乱叶无所归。",
        "非君一起予，衰病岂能诗。",
        "忆君初解鞍，新月挂弯眉。",
        "夜来上金镜，坐叹光景驰。",
        "我有好东绢，晴明要会期。",
        "猗猗淇园姿，此君有威仪。",
        "愿作数百竿，水石相因依。",
        "他年风动璧，洗我别后思。",
        "开图慰满眼，何时遂臻兹。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206572,
      "title": "戏简朱公武刘邦直田子平五首  其一",
      "content": [
        "不趋吏部曹中版，且鲙高沙湖里鱼。",
        "虽无季子六国印，要读田郎万卷书。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206573,
      "title": "戏简朱公武刘邦直田子平五首  其二",
      "content": [
        "欢伯可解藜藿嘲，孔方定非金石交。",
        "君看刘郎最多智，昨者火事几焚巢。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206574,
      "title": "戏简朱公武刘邦直田子平五首  其三",
      "content": [
        "刘郎好诗又能文，方我奔窜义甚敦。",
        "为亲未葬走人门，闭门却扫不足论。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206575,
      "title": "戏简朱公武刘邦直田子平五首  其四",
      "content": [
        "朱家埙篪好兄弟，陋巷六经葵苋秋。",
        "我卜荆州三亩宅，读田家书从之游。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206576,
      "title": "戏简朱公武刘邦直田子平五首  其五",
      "content": [
        "朱公趋朝瘦至骨，归来豪健踞胡床。",
        "日看省曹阍者面，何如田家侍儿妆。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206577,
      "title": "次韵益修四弟",
      "content": [
        "霜晚菊未花，节物亦可嘉。",
        "欣欣登高侣，畏雨占暮霞。",
        "楚人酝菉豆，轻碧自相夸。",
        "老夫不举酒，咽嗽鸣两车。",
        "良辰与美景，客至但成嗟。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206578,
      "title": "以峡州酒遗益修复继前韵",
      "content": [
        "令节不把酒，新诗徒拜嘉。",
        "颇忆宋玉赋，登高气成霞。",
        "渚宫但衰柳，朝云为谁夸。",
        "吾宗怀古恨，流涎过曲车。",
        "一壶浇往事，聊送解愁嗟。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 206579,
      "title": "谢益修四弟送石屏",
      "content": [
        "石似江沧落日明，鸬鹚乌鹊满沙汀。",
        "小儿骨相能文字，乞与班班作砚屏。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206580,
      "title": "戏答王观复酴醾菊二首  其一",
      "content": [
        "谁将陶令黄金菊，幻作酴醾白玉花。",
        "小草真成有风味，东园添我老生涯。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206581,
      "title": "戏答王观复酴醾菊二首  其二",
      "content": [
        "吕园未肯轻沽我，且寄田家砌下栽。",
        "他日秋花媚重九，清香知自故人来。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206582,
      "title": "戏答王子予送凌风菊二首  其一",
      "content": [
        "病来孤负鸬鹚杓，禅板蒲团入眼中。",
        "浪说闲居爱重九，黄花应笑白头翁。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206583,
      "title": "戏答王子予送凌风菊二首  其二",
      "content": [
        "王郎颇病金瓢酒，不耐寒花晚更芳。",
        "瘦尽腰围怯风景，故来归我一枝香。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206584,
      "title": "谢王子予送橄榄",
      "content": [
        "方怀味谏轩中果，忽见金盘橄榄来。",
        "想共余甘有瓜葛，苦中真味晚方回。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206585,
      "title": "以椰子小冠送子予",
      "content": [
        "浆成乳酒醺人醉，肉截鹅肪上客盘。",
        "有核如匏可雕琢，道装宜作玉人冠。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206586,
      "title": "呈杨康国",
      "content": [
        "君家秋实罗浮种，已作累累半拂墙。",
        "莫遣儿童酸打尽，要看霜后十分黄。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206587,
      "title": "又戏呈康国",
      "content": [
        "整冠行客莫先尝，杨子家无数仞墙。",
        "假借肃霜令弄色，勾添寒日与争黄。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206588,
      "title": "次韵马荆州",
      "content": [
        "六年绝域梦刀头，判得南还万事休。",
        "谁谓石渠刘校尉，来依绛帐马荆州。",
        "霜髭雪鬓共看镜，茱糁菊英同送秋。",
        "他日江梅腊前破，还从天际望归舟。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 206589,
      "title": "和中玉使君晚秋开天宁节道场",
      "content": [
        "江南江北尽云沙，车骑东来风旆斜。",
        "倒影楼台开紫府，得霜篱落賸黄花。",
        "钓溪筑野收多士，航海梯山共一家。",
        "想见星坛祝尧寿，步虚声里静无哗。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 206590,
      "title": "入穷巷谒李材叟翘叟戏赠兼简田子平三首  其一",
      "content": [
        "紫冠黄钿网丝窠，蝶绕蜂围奈晚何。",
        "二叟家居如避世，开门自少俗人过。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206591,
      "title": "入穷巷谒李材叟翘叟戏赠兼简田子平三首  其二",
      "content": [
        "只可阕中安止止，谁能铁里鬭铮铮。",
        "田多谷少无人会，譬似无田过一生。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206592,
      "title": "入穷巷谒李材叟翘叟戏赠兼简田子平三首  其三",
      "content": [
        "田郎杞菊荒三径，文字时追二叟游。",
        "万卷藏书多未见，老夫端拟乞荆州。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206593,
      "title": "次韵答马中玉三首  其一",
      "content": [
        "雨入纱窗风簸船，菊花过后早梅前。",
        "锦江春色熏人醉，也到壶中小隠天。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206594,
      "title": "次韵答马中玉三首  其二",
      "content": [
        "卷沙成浪北风颠，衔尾千艘不敢前。",
        "匝岸水居皆有酒，行人得意买江天。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206595,
      "title": "次韵答马中玉三首  其三",
      "content": [
        "仁气已蒸全楚尽，同云欲合暮江前。",
        "争春梅柳无三月，对雪樽罍属二天。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206596,
      "title": "次韵中玉早梅二首  其一",
      "content": [
        "梅蘂争先公不嗔，知公家有似梅人。",
        "何时各得自由去，相逐扬州作好春。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206597,
      "title": "次韵中玉早梅二首  其二",
      "content": [
        "折得寒香不露机，小窗斜日两三枝。",
        "罗帷翠幕深调护，已被游蜂圣得知。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206598,
      "title": "次韵中玉水仙花二首  其一",
      "content": [
        "借水开花自一奇，水沈为骨玉为肌。",
        "暗香已压酴醾倒，只比寒梅无好枝。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206599,
      "title": "次韵中玉水仙花二首  其二",
      "content": [
        "淤泥解作白莲藕，粪壤能开黄玉花。",
        "可惜国香天不管，随缘流落小民家。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206600,
      "title": "王充道送水仙花五十枝欣然会心为之作咏",
      "content": [
        "凌波仙子生尘袜，水上轻盈步微月。",
        "是谁招此断肠魂，种作寒花寄愁绝。",
        "含香体素欲倾城，山矾是弟梅是兄。",
        "坐对真成被花恼，出门一笑大江横。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 206601,
      "title": "吴君送水仙花并二大本",
      "content": [
        "折送南园栗玉花，并移香本到寒家。",
        "何时持上玉宸殿，乞与宫梅定等差。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206602,
      "title": "刘邦直送早梅水仙花四首  其一",
      "content": [
        "簸船綪缆北风嗔，霜落千林憔悴人。",
        "欲问江南近消息，喜君贻我一枝春。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206603,
      "title": "刘邦直送早梅水仙花四首  其二",
      "content": [
        "探请东皇第一机，水边风日笑横枝。",
        "鸳鸯浮弄婵娟影，白鹭窥鱼凝不知。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 206604,
      "title": "刘邦直送早梅水仙花四首  其三",
      "content": [
        "得水能仙天与奇，寒香寂寞动冰肌。",
        "仙风道骨今谁有，淡扫蛾眉簪一枝。"
      ],
      "author": {
        "id": 8891,
        "name": "黄庭坚"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
