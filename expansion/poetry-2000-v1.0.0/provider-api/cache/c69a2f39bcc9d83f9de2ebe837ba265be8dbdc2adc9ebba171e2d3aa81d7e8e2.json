{
  "data": [
    {
      "id": 255272,
      "title": "相和歌辞 江南曲",
      "content": [
        "郎船安两桨，侬舸动双桡。",
        "埽黛开宫额，裁裙约楚腰。",
        "乖期方积思，临醉欲拚娇。",
        "莫以采菱唱，欲羡秦台箫。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 255329,
      "title": "相和歌辞 王昭君",
      "content": [
        "毛延寿画欲通神，忍为黄金不为人。",
        "马上琵琶行万里，汉宫长有隔生春。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 256115,
      "title": "杂曲歌辞 无愁果有愁曲",
      "content": [
        "东有青龙西白虎，中含福皇包世度。",
        "玉壶渭水笑清潭，凿天不到牵牛处。",
        "骐驎踏云天马狞，牛山撼碎珊瑚声。",
        "秋娥点滴不成泪，十二玉楼无故钉。",
        "推烟唾月抛千里，十番红桐一行死。",
        "白杨别屋鬼迷人，空留暗记如蚕纸。",
        "日暮向风牵短丝，血凝血散今谁是。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 266365,
      "title": "杂曲歌辞 杨柳枝 一",
      "content": [
        "暂凭樽酒送无憀，莫损愁眉与细腰。",
        "人世死前唯有别，春风争拟惜长条。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 266366,
      "title": "杂曲歌辞 杨柳枝 二",
      "content": [
        "含烟惹雾每依依，万绪千条拂落晖。",
        "为报行人休尽折，半留相送半迎归。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 266568,
      "title": "杂歌谣辞 李夫人歌 一",
      "content": [
        "一带不结心，两股方安髻。",
        "慙愧白茅人，月没教星替。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 266569,
      "title": "杂歌谣辞 李夫人歌 二",
      "content": [
        "剩结茱萸枝，多擘秋莲的。",
        "独自有波光，彩囊盛不得。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 266570,
      "title": "杂歌谣辞 李夫人歌 三",
      "content": [
        "蛮丝系条脱，妍眼和香屑。",
        "寿宫不惜铸南人，柔肠早被秋波割。",
        "清澄有余幽素香，鳏鱼渴凤真珠房。",
        "不知瘦骨类冰井，更许夜帘通晓霜。",
        "土花漠碧云[茫茫]，黄河欲尽天苍黄。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 276528,
      "title": "锦瑟",
      "content": [
        "锦瑟无端五十弦，一弦一柱思华年。",
        "庄生晓梦迷蝴蝶，望帝春心托杜鹃。",
        "沧海月明珠有泪，蓝田日暖玉生烟。",
        "此情可待成追忆，只是当时已惘然。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276529,
      "title": "重过圣女祠",
      "content": [
        "白石岩扉碧藓滋，上清沦谪得归迟。",
        "一春梦雨常飘瓦，尽日灵风不满旗。",
        "萼绿华来无定所，杜兰香去未移时。",
        "玉郎会此通仙籍，忆向天阶问紫芝。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276530,
      "title": "寄罗劭兴",
      "content": [
        "棠棣黄花发，忘忧碧叶齐。",
        "人闲微病酒，燕重远兼泥。",
        "混沌何由凿，青冥有未梯。",
        "高阳旧徒侣，时复一相携。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276531,
      "title": "令狐舍人说昨夜西掖翫月因戏赠",
      "content": [
        "昨夜玉轮明，传闻近太清。",
        "凉波冲碧瓦，晓晕落金茎。",
        "露索秦宫井，风弦汉殿筝。",
        "几时緜竹颂，拟荐子虚名。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276532,
      "title": "崔处士",
      "content": [
        "真人塞其内，夫子入于机。",
        "未肯投竿起，惟欢负米归。",
        "雪中东郭履，堂上老莱衣。",
        "读遍先贤传，如君事者稀。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276533,
      "title": "自喜",
      "content": [
        "自喜蜗牛舍，兼容燕子巢。",
        "绿筠遗粉箨，红药绽香苞。",
        "虎过遥知穽，鱼来且佐庖。",
        "慢行成酩酊，邻壁有松醪。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276534,
      "title": "题僧壁",
      "content": [
        "舍生求道有前踪，乞脑剜身结愿重。",
        "大去便应欺粟颗，小来兼可隐针锋。",
        "蚌胎未满思新桂，琥珀初成忆旧松。",
        "若信贝多真实语，三生同听一楼钟。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276535,
      "title": "霜月",
      "content": [
        "初闻征雁已无蝉，百尺楼高水接天。",
        "青女素娥俱耐冷，月中霜里鬬婵娟。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276536,
      "title": "异俗二首 一",
      "content": [
        "鬼疟朝朝避，春寒夜夜添。",
        "未惊雷破柱，不报水齐簷。",
        "虎箭侵肤毒，鱼钩刺骨铦。",
        "鸟言成谍诉，多是恨彤幨。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276537,
      "title": "异俗二首 二",
      "content": [
        "户尽悬秦网，家多事越巫。",
        "未曾容獭祭，只是纵猪都。",
        "点对连鳌饵，搜求缚虎符。",
        "贾生兼事鬼，不信有洪炉。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276538,
      "title": "归墅",
      "content": [
        "行李逾南极，旬时到旧乡。",
        "楚芝应徧紫，邓橘未全黄。",
        "渠浊村舂急，旗高社酒香。",
        "故山归梦喜，先入读书堂。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276539,
      "title": "商于",
      "content": [
        "商于朝雨霁，归路有秋光。",
        "背坞猿收果，投岩麝退香。",
        "建瓴真得势，横戟岂能当。",
        "割地张仪诈，谋身绮季长。",
        "清渠州外月，黄叶庙前霜。",
        "今日看云意，依依入帝乡。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 276540,
      "title": "和孙朴韦蟾孔雀咏",
      "content": [
        "此去三梁远，今来万里携。",
        "西施因网得，秦客被花迷。",
        "可在青鹦鹉，非关碧野鸡。",
        "约眉怜翠羽，刮目想金篦。",
        "瘴气笼飞远，蛮花向坐低。",
        "轻于赵皇后，贵极楚悬黎。",
        "都护矜罗幕，佳人炫绣袿。",
        "屏风临烛扣，捍拨倚香脐。",
        "旧思牵云叶，新愁待雪泥。",
        "爱堪通梦寐，画得不端倪。",
        "地锦排苍雁，帘钉镂白犀。",
        "曙霞星斗外，凉月露盘西。",
        "妬好休夸舞，经寒且少啼。",
        "红楼三十级，稳稳上丹梯。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 276541,
      "title": "人欲",
      "content": [
        "人欲天从竟不疑，莫言圆盖便无私。",
        "秦中已久乌头白，却是君王未备知。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276542,
      "title": "华山题王母祠",
      "content": [
        "莲华峰下锁雕梁，此去瑶池地共长。",
        "好为麻姑到东海，劝栽黄竹莫栽桑。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276543,
      "title": "华清宫",
      "content": [
        "华清恩幸古无伦，犹恐蛾眉不胜人。",
        "未免被他褒女笑，只教天子暂蒙尘。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276544,
      "title": "楚泽",
      "content": [
        "夕阳归路后，霜野物声干。",
        "集鸟翻渔艇，残虹拂马鞍。",
        "刘桢元抱病，虞寄数辞官。",
        "白袷经年卷，西来及早寒。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276545,
      "title": "蝉",
      "content": [
        "本以高难饱，徒劳恨费声。",
        "五更疎欲断，一树碧无情。",
        "薄宦梗犹泛，故园芜已平。",
        "烦君最相警，我亦举家清。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276546,
      "title": "江亭散席循柳路吟",
      "content": [
        "春咏敢轻裁，衔辞入半杯。",
        "已遭江映柳，更被雪藏梅。",
        "寡和真徒尔，殷忧动即来。",
        "从诗得何报，惟感二毛催。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276547,
      "title": "潭州",
      "content": [
        "潭州官舍暮楼空，今古无端入望中。",
        "湘泪浅深滋竹色，楚歌重叠怨兰丛。",
        "陶公战舰空滩雨，贾傅承尘破庙风。",
        "目断故园人不至，松醪一醉与谁同。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276548,
      "title": "赠刘司户",
      "content": [
        "江风吹浪动云根，重碇危樯白日昏。",
        "已断燕鸿初起势，更惊骚客后归魂。",
        "汉廷急诏谁先入，楚路高歌自欲翻。",
        "万里相逢欢复泣，凤巢西隔九重门。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276549,
      "title": "哭刘司户二首 一",
      "content": [
        "离居星岁易，失望死生分。",
        "酒瓮凝余桂，书签冷旧芸。",
        "江风吹鴈急，山木带蝉曛。",
        "一呌千回首，天高不为闻。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276550,
      "title": "哭刘司户二首 二",
      "content": [
        "有美扶皇运，无谁荐直言。",
        "已为秦逐客，复作楚冤魂。",
        "湓浦应分派，荆江有会源。",
        "幷将添恨泪，一洒问乾坤。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276551,
      "title": "悼伤后赴东蜀辟至散关遇雪",
      "content": [
        "剑外从军远，无家与寄衣。",
        "散关三尺雪，回梦旧鸳机。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 276552,
      "title": "乐游原",
      "content": [
        "向晚意不适，驱车登古原。",
        "夕阳无限好，只是近黄昏。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 276553,
      "title": "北齐二首 一",
      "content": [
        "一笑相倾国便亡，何劳荆棘始堪伤。",
        "小怜玉体横陈夜，已报周师入晋阳。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276554,
      "title": "北齐二首 二",
      "content": [
        "巧笑知堪敌万几，倾城最在著戎衣。",
        "晋阳已陷休回顾，更请君王猎一围。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276555,
      "title": "街西池馆",
      "content": [
        "白阁他年别，朱门此夜过。",
        "疎帘留月魄，珍簟接烟波。",
        "太守三刀梦，将军一箭歌。",
        "国租容客旅，香熟玉山禾。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276556,
      "title": "南朝",
      "content": [
        "玄武湖中玉漏催，鸡鸣埭口绣襦回。",
        "谁言琼树朝朝见，不及金莲步步来。",
        "敌国军营漂木柹，前朝神庙锁烟煤。",
        "满宫学士皆颜色，江令当年只费才。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276557,
      "title": "复京",
      "content": [
        "虏骑胡兵一战摧，万灵回首贺轩台。",
        "天教李令心如日，可要昭陵石马来。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276558,
      "title": "浑河中",
      "content": [
        "九庙无尘八马回，奉天城垒长春苔。",
        "咸阳原上英雄骨，半向君家养马来。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276559,
      "title": "鄠杜马上念汉书",
      "content": [
        "世上苍龙种，人间武帝孙。",
        "小来惟射猎，兴罢得乾坤。",
        "渭水天开苑，咸阳地献原。",
        "英灵殊未已，丁傅渐华轩。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276560,
      "title": "柳",
      "content": [
        "动春何限叶，撼晓几多枝。",
        "解有相思[否]，应无不舞时。",
        "絮飞藏皓蝶，带弱露黄鹂。",
        "倾国宜通体，谁来独赏眉。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276561,
      "title": "巴江柳",
      "content": [
        "巴江可惜柳，柳色绿侵江。",
        "好向金銮殿，移阴入绮窗。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 276562,
      "title": "咸阳",
      "content": [
        "咸阳宫阙郁嵯峨，六国楼台艳绮罗。",
        "自是当时天帝醉，不关秦地有山河。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276563,
      "title": "同崔八诣药山访融禅师",
      "content": [
        "共受征南不次恩，报恩惟是有忘言。",
        "岩花涧草西林路，未见高僧只见猿。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276564,
      "title": "闻著明凶问哭寄飞卿",
      "content": [
        "昔叹谗销骨，今伤泪满膺。",
        "空余双玉剑，无复一壶冰。",
        "江势翻银砾，天文露玉绳。",
        "何因携庾信，同去哭徐陵。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276565,
      "title": "听鼓",
      "content": [
        "城头叠鼓声，城下暮江清。",
        "欲问渔阳掺，时无祢正平。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 276566,
      "title": "送崔珏往西川",
      "content": [
        "年少因何有旅愁，欲为东下更西游。",
        "一条雪浪吼巫峡，千里火云烧益州。",
        "卜肆至今多寂寞，酒垆从古擅风流。",
        "浣花牋纸桃花色，好好题诗咏玉钩。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276567,
      "title": "代赠",
      "content": [
        "杨柳路尽处，芙蓉湖上头。",
        "虽同锦步障，独映钿箜篌。",
        "鸳鸯可羡头俱白，飞去飞来烟雨秋。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 276568,
      "title": "桂林",
      "content": [
        "城窄山将压，江宽地共浮。",
        "东南通绝域，西北有高楼。",
        "神护青枫岸，龙移白石湫。",
        "殊乡竟何祷，箫鼓不曾休。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276569,
      "title": "夜雨寄北",
      "content": [
        "君问归期未有期，巴山夜雨涨秋池。",
        "何当共剪西窗烛，却话巴山夜雨时。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276570,
      "title": "陈后宫",
      "content": [
        "茂苑城如画，阊门瓦欲流。",
        "还依水光殿，更起月华楼。",
        "侵夜鸾开镜，迎冬雉献裘。",
        "从臣皆半醉，天子正无愁。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276571,
      "title": "属疾",
      "content": [
        "许靖犹羁宦，安仁复悼亡。",
        "兹辰聊属疾，何日免殊方。",
        "秋蝶无端丽，寒花只暂香。",
        "多情真命薄，容易即回肠。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276572,
      "title": "石榴",
      "content": [
        "榴枝婀娜榴实繁，榴膜轻明榴子鲜。",
        "可羡瑶池碧桃树，碧桃红颊一千年。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276573,
      "title": "明日",
      "content": [
        "天上参旗过，人间烛燄销。",
        "谁言整双履，便是隔三桥。",
        "知处黄金鏁，曾来碧绮寮。",
        "凭栏明日意，池阔雨萧萧。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276574,
      "title": "饮席戏赠同舍",
      "content": [
        "洞中屐响省分携，不是花迷客自迷。",
        "珠树重行怜翡翠，玉楼双舞羡鹍鸡。",
        "兰回旧蘂缘屏绿，椒缀新香和壁泥。",
        "唱尽阳关无限叠，半杯松叶冻颇黎。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276575,
      "title": "西溪",
      "content": [
        "近郭西溪好，谁堪共酒壶。",
        "苦吟防柳恽，多泪怯杨朱。",
        "野鹤随君子，寒松揖大夫。",
        "天涯常病意，岑寂胜欢娱。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276576,
      "title": "忆梅",
      "content": [
        "定定住天涯，依依向物华。",
        "寒梅最堪恨，常作去年花。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 276577,
      "title": "赠柳",
      "content": [
        "章台从掩映，郢路更参差。",
        "见说风流极，来当婀娜时。",
        "桥回行欲断，隄远意相随。",
        "忍放花如雪，青楼扑酒旗。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276578,
      "title": "谑柳",
      "content": [
        "已带黄金缕，仍飞白玉花。",
        "长时须拂马，密处少藏鸦。",
        "眉细从他敛，腰轻莫自斜。",
        "玳梁谁道好，偏拟映卢家。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276579,
      "title": "北禽",
      "content": [
        "为恋巴江好，无辞瘴雾蒸。",
        "纵能朝杜宇，可得值苍鹰。",
        "石小虚填海，芦铦未破矰。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 276580,
      "title": "初起",
      "content": [
        "想像咸池日欲光，五更钟后更回肠。",
        "三年苦雾巴江水，不为离人照屋梁。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276581,
      "title": "楚宫",
      "content": [
        "复壁交青琐，重帘挂紫绳。",
        "如何一柱观，不碍九枝灯。",
        "扇薄常规月，钗斜只镂冰。",
        "歌成犹未唱，秦火入夷陵。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276582,
      "title": "柳",
      "content": [
        "柳映江潭底有情，望中频遣客心惊。",
        "巴雷隐隐千山外，更作章台走马声。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276583,
      "title": "石城",
      "content": [
        "石城夸窈窕，花县更风流。",
        "簟冰将飘枕，帘烘不隐钩。",
        "玉童收夜钥，金狄守更筹。",
        "共笑鸳鸯绮，鸳鸯两白头。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276584,
      "title": "韩碑",
      "content": [
        "元和天子神武姿，彼何人哉轩与羲。",
        "誓将上雪列圣耻，坐法宫中朝四夷。",
        "淮西有贼五十载，封狼生䝙䝙生罴。",
        "不据山河据平地，长戈利矛日可麾。",
        "帝得圣相相曰度，贼斫不死神扶持。",
        "腰悬相印作都统，阴风惨澹天王旗。",
        "愬武古通作牙爪，仪曹外郎载笔随。",
        "行军司马智且勇，十四万众犹虎貔。",
        "入蔡缚贼献太庙，功无与让恩不訾。",
        "帝曰汝度功第一，汝从事愈宜为辞。",
        "愈拜稽首蹈且舞，金石刻画臣能为。",
        "古者世称大手笔，此事不系于职司。",
        "当仁自古有不让，言讫屡颔天子颐。",
        "公退斋戒坐小阁，濡染大笔何淋漓。",
        "点窜尧典舜典字，涂改清庙生民诗。",
        "文成破体书在纸，清晨再拜铺丹墀。",
        "表曰臣愈昧死上，咏神圣功书之碑。",
        "碑高三丈字如斗，负以灵鼇蟠以螭。",
        "句奇语重喻者少，谗之天子言其私。",
        "长绳百尺拽碑倒，麤砂大石相磨治。",
        "公之斯文若元气，先时已入人肝脾。",
        "汤盘孔鼎有述作，今无其器存其辞。",
        "呜呼圣皇及圣相，相与烜赫流淳熙。",
        "公之斯文不示后，曷与三五相攀追。",
        "愿书万本诵万过，口角流沫右手胝。",
        "传之七十有二代，以为封禅玉检明堂基。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 276585,
      "title": "令狐八拾遗见招送裴十四归华州",
      "content": [
        "二十中郎未足希，骊驹先自有光辉。",
        "兰亭䜩罢方回去，雪夜诗成道韫归。",
        "汉苑风烟吹客梦，云台洞穴接郊扉。",
        "嗟予久抱临邛渴，便欲因君问钓矶。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276586,
      "title": "离思",
      "content": [
        "气尽前溪舞，心酸子夜歌。",
        "峡云寻不得，沟水欲如何。",
        "朔雁传书绝，湘篁染泪多。",
        "无由见颜色，还自托微波。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 276587,
      "title": "宿骆氏亭寄怀崔雍衮",
      "content": [
        "竹坞无尘水槛清，相思迢递隔重城。",
        "秋阴不散霜飞晚，留得枯荷听雨声。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276588,
      "title": "风雨",
      "content": [
        "凄凉宝剑篇，羁泊欲穷年。",
        "黄叶仍风雨，青楼自管弦。",
        "新知遭薄俗，旧好隔良缘。",
        "心断新丰酒，销愁斗几千。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276589,
      "title": "梦泽",
      "content": [
        "梦泽悲风动白茅，楚王葬尽满城娇。",
        "未知歌舞能多少，虚减宫厨为细腰。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276590,
      "title": "赠歌妓二首 一",
      "content": [
        "水精如意玉连环，下蔡城危莫破颜。",
        "红绽樱桃含白雪，断肠声里唱阳关。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276591,
      "title": "赠歌妓二首 二",
      "content": [
        "白日相思可奈何，严城清夜断经过。",
        "只知解道春来瘦，不道春来独自多。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276592,
      "title": "谢书",
      "content": [
        "微意何曾有一毫，空携笔砚奉龙韬。",
        "自蒙半夜传衣后，不羡王祥得佩刀。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276593,
      "title": "寄令狐学士",
      "content": [
        "秘殿崔嵬拂彩霓，曹司今在殿东西。",
        "赓歌太液翻黄鹄，从猎陈仓获碧鸡。",
        "晓饮岂知金掌迥，夜吟应讶玉绳低。",
        "钧天虽许人间听，阊阖门多梦自迷。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276594,
      "title": "酬令狐郎中见寄",
      "content": [
        "望郎临古郡，佳句洒丹青。",
        "应自丘迟宅，仍过柳恽汀。",
        "封来江渺渺，信去雨冥冥。",
        "句曲闻仙诀，临川得佛经。",
        "朝吟搘客枕，夜读漱僧瓶。",
        "不见衔芦雁，空流腐草萤。",
        "土宜悲坎井，天怒识雷霆。",
        "象卉分疆近，蛟涎浸岸腥。",
        "补羸贪紫桂，负气托青萍。",
        "万里悬离抱，危于讼合铃。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 276595,
      "title": "七月二十八日夜与王郑二秀才听雨后梦作",
      "content": [
        "初梦龙宫宝燄然，瑞霞明丽满晴天。",
        "旋成醉倚蓬莱树，有个仙人拍我肩。",
        "少顷远闻吹细管，闻声不见隔飞烟。",
        "逡巡又过潇湘雨，雨打湘灵五十弦。",
        "瞥见冯夷殊怅望，鲛绡休卖海为田。",
        "亦逢毛女无憀极，龙伯擎将华岳莲。",
        "恍惚无倪明又暗，低迷不已断还连。",
        "觉来正是平阶雨，独背寒灯枕手眠。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 276596,
      "title": "寄令狐郎中",
      "content": [
        "嵩云秦树久离居，双鲤迢迢一纸书。",
        "休问梁园旧宾客，茂陵秋雨病相如。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276597,
      "title": "漫成三首 一",
      "content": [
        "不妨何范尽诗家，未解当年重物华。",
        "远把龙山千里雪，将来拟并洛阳花。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276598,
      "title": "漫成三首 二",
      "content": [
        "沈约怜何逊，延年毁谢庄。",
        "清新俱有得，名誉底相伤。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 276599,
      "title": "漫成三首 三",
      "content": [
        "雾夕咏芙蕖，何郎得意初。",
        "此时谁最赏，沈范两尚书。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 276600,
      "title": "无题",
      "content": [
        "白道萦回入暮霞，斑骓嘶断七香车。",
        "春风自共何人笑，枉破阳城十万家。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276601,
      "title": "槿花二首 一",
      "content": [
        "燕体伤风力，鸡香积露文。",
        "殷鲜一相杂，啼笑两难分。",
        "月里宁无姊，云中亦有君。",
        "三清与仙岛，何事亦离群。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276602,
      "title": "槿花二首 二",
      "content": [
        "珠馆薰燃久，玉房梳扫余。",
        "烧兰才作烛，襞锦不成书。",
        "本以亭亭远，翻嫌眽眽疎。",
        "回头问残照，残照更空虚。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276603,
      "title": "哭刘蕡",
      "content": [
        "上帝深宫闭九阍，巫咸不下问衔冤。",
        "广陵别后春涛隔，湓浦书来秋雨翻。",
        "只有安仁能作诔，何曾宋玉解招魂。",
        "平生风义兼师友，不敢同君哭寝门。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276604,
      "title": "杜司勋",
      "content": [
        "高楼风雨感斯文，短翼差池不及群。",
        "刻意伤春复伤别，人间惟有杜司勋。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276605,
      "title": "荆门西下",
      "content": [
        "一夕南风一叶危，荆云回望夏云时。",
        "人生岂得轻离别，天意何曾忌崄巇。",
        "骨肉书题安绝徼，蕙兰蹊径失佳期。",
        "洞庭湖阔蛟龙恶，却羡杨朱泣路岐。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276606,
      "title": "碧瓦",
      "content": [
        "碧瓦衔珠树，红轮结绮寮。",
        "无双汉殿鬓，第一楚宫腰。",
        "雾唾香难尽，珠啼冷易销。",
        "歌从雍门学，酒是蜀城烧。",
        "柳暗将翻巷，荷欹正抱桥。",
        "钿辕开道入，金管隔隣调。",
        "梦到飞魂急，书成即席遥。",
        "河流冲柱转，海沫近槎飘。",
        "吴市𧏗蛦甲，巴賨翡翠翘。",
        "他时未知意，重叠赠娇饶。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 276607,
      "title": "蜨",
      "content": [
        "叶叶复翻翻，斜桥对侧门。",
        "芦花惟有白，柳絮可能温。",
        "西子寻遗殿，昭君觅故村。",
        "年年芳物尽，来别败兰荪。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276608,
      "title": "蝇蜨鸡麝鸶凤等成篇",
      "content": [
        "韩蝶翻罗幕，曹蝇拂绮窗。",
        "鬬鸡回玉勒，融麝暖金釭。",
        "瑇瑁明书阁，琉璃冰酒缸。",
        "画楼多有主，鸾凤各双双。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276609,
      "title": "韩翃舍人即事",
      "content": [
        "萱草含丹粉，荷花抱绿房。",
        "鸟应悲蜀帝，蝉是怨齐王。",
        "通内藏珠府，应官解玉坊。",
        "桥南荀令过，十里送衣香。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276610,
      "title": "公子",
      "content": [
        "一盏新罗酒，凌晨恐易消。",
        "归应冲鼓半，去不待笙调。",
        "歌好惟愁和，香浓岂惜飘。",
        "春场铺艾帐，下马雉媒娇。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276611,
      "title": "子初全溪作",
      "content": [
        "全溪不可到，况复尽余醅。",
        "汉苑生春水，昆池换劫灰。",
        "战蒲知雁唼，皱月觉鱼来。",
        "清兴恭闻命，言诗未敢回。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276612,
      "title": "杨本胜说于长安见小男阿衮",
      "content": [
        "闻君来日下，见我最娇儿。",
        "渐大啼应数，长贫学恐迟。",
        "寄人龙种瘦，失母凤雏痴。",
        "语罢休边角，青灯两鬓丝。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276613,
      "title": "西溪",
      "content": [
        "怅望西溪水，潺湲奈尔何。",
        "不惊春物少，只觉夕阳多。",
        "色染妖韶柳，光含窈窕萝。",
        "人间从到海，天上莫为河。",
        "凤女弹瑶瑟，龙孙撼玉珂。",
        "京华他夜梦，好好寄云波。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 276614,
      "title": "柳下暗记",
      "content": [
        "无奈巴南柳，千条傍吹台。",
        "更将黄映白，拟作杏花媒。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 276615,
      "title": "妓席",
      "content": [
        "乐府闻桃叶，人前道得无。",
        "劝君书小字，慎莫唤官奴。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 276616,
      "title": "少年",
      "content": [
        "外戚平羌第一功，生年二十有重封。",
        "直登宣室螭头上，横过干泉豹尾中。",
        "别馆觉来云雨梦，后门归去蕙兰丛。",
        "灞陵夜猎随田窦，不识寒郊自转蓬。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276617,
      "title": "无题",
      "content": [
        "近知名阿侯，住处小江流。",
        "腰细不胜舞，眉长惟是愁。",
        "黄金堪作屋，何不作重楼。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
