{
  "data": [
    {
      "id": 313396,
      "title": "减字木兰花",
      "content": [
        "长亭晚送。",
        "都似绿窗前日梦。",
        "小字还家。",
        "恰应红灯昨夜花。",
        "良时易过。",
        "半镜流年春欲破。",
        "往事难忘。",
        "一枕高楼到夕阳。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313397,
      "title": "减字木兰花",
      "content": [
        "留春不住。",
        "恰似年光无味处。",
        "满眼飞英。",
        "弹指东风太浅情。",
        "筝弦未稳。",
        "学得新声难破恨。",
        "转枕花前。",
        "且占香红一夜眠。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313398,
      "title": "减字木兰花",
      "content": [
        "长杨辇路。",
        "绿满当年携手处。",
        "试逐春风。",
        "重到宫花花树中。",
        "芳菲绕遍。",
        "今日不如前日健。",
        "酒罢凄凉。",
        "新恨犹添旧恨长。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313399,
      "title": "泛清波摘遍",
      "content": [
        "催花雨小，著柳风柔，都似去年时候好。",
        "露红烟绿，尽有狂情斗春早。",
        "长安道。",
        "秋千影里，丝管声中，谁放艳阳轻过了。",
        "倦客登临，暗惜光阴恨多少。",
        "楚天渺。",
        "归思正如乱云，短梦未成芳草。",
        "空把吴霜鬓华，自悲清晓。",
        "帝城杳。",
        "双凤旧约渐虚，孤鸿后期难到。",
        "且趁朝花夜月，翠尊频倒。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313400,
      "title": "洞仙歌",
      "content": [
        "春残雨过，绿暗东池道。",
        "玉艳藏羞媚赪笑。",
        "记当时、已恨飞镜欢疏，那至此，仍苦题花信少。",
        "连环情未己，物是人非，月下疏梅似伊好。",
        "澹秀色，黯寒香，粲若春容，何心顾、闲花凡草。",
        "但莫使、情随岁华迁，便杳隔秦源，也须能到。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313401,
      "title": "菩萨蛮",
      "content": [
        "来时杨柳东桥路。",
        "曲中暗有相期处。",
        "明月好因缘。",
        "欲圆还未圆。",
        "欲寻芳草去。",
        "画扇遮微雨。",
        "飞絮莫无情。",
        "闲花应笑人。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313402,
      "title": "菩萨蛮",
      "content": [
        "个人轻似低飞燕。",
        "春来绮陌时相见。",
        "堪恨两横波。",
        "恼人情绪多。",
        "长留青鬓住。",
        "莫放红颜去。",
        "占取艳阳天。",
        "且教伊少年。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313403,
      "title": "菩萨蛮",
      "content": [
        "鸾啼似作留春语。",
        "花飞斗学回风舞。",
        "红日又平西。",
        "画帘遮燕泥。",
        "烟光还自老。",
        "绿镜人空好。",
        "香在去年衣。",
        "鱼笺音信稀。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313404,
      "title": "菩萨蛮",
      "content": [
        "春风未放花心吐。",
        "尊前不拟分明语。",
        "酒色上来迟。",
        "绿须红杏枝。",
        "今朝眉黛浅。",
        "暗恨归时远。",
        "前夜月当楼。",
        "相逢南陌头。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313405,
      "title": "菩萨蛮",
      "content": [
        "娇香淡染胭脂雪。",
        "愁春细画弯弯月。",
        "花月镜边情。",
        "浅妆匀未成。",
        "佳期应有在。",
        "试倚秋千待。",
        "满地落英红。",
        "万条杨柳风。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313406,
      "title": "菩萨蛮",
      "content": [
        "香莲烛下匀丹雪。",
        "妆成笑弄金阶月。",
        "娇面胜芙蓉。",
        "脸边天与红。",
        "玳筵双揭鼓。",
        "唤上华茵舞。",
        "春浅未禁寒。",
        "暗嫌罗袖宽。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313407,
      "title": "菩萨蛮",
      "content": [
        "哀筝一弄湘江曲。",
        "声声写尽湘波绿。",
        "纤指十三弦。",
        "细将幽恨传。",
        "当筵秋水慢。",
        "玉柱斜飞雁。",
        "弹到断肠时。",
        "春山眉黛低。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313408,
      "title": "菩萨蛮",
      "content": [
        "江南未雪梅花白。",
        "忆梅人是江南客。",
        "犹记旧相逢。",
        "淡烟微月中。",
        "玉容长有信。",
        "一笑归来近。",
        "怀远上楼时。",
        "晚云和雁低。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313409,
      "title": "菩萨蛮",
      "content": [
        "相逢欲话相思苦。",
        "浅情肯信相思否。",
        "还恐漫相思。",
        "浅情人不知。",
        "忆曾携手处。",
        "月满窗前路。",
        "长到月来时。",
        "不眠犹待伊。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313410,
      "title": "玉楼春",
      "content": [
        "雕鞍好为莺花住。",
        "占取东城南陌路。",
        "尽教春思乱如云，莫管世情轻似絮。",
        "古来多被虚名误。",
        "宁负虚名身莫负。",
        "劝君频入醉乡来，此是无愁无恨处。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313411,
      "title": "玉楼春",
      "content": [
        "一尊相遇春风里。",
        "诗好似君人有几。",
        "吴姬十五语如弦，能唱当时楼下水。",
        "良辰易去如弹指。",
        "金盏十分须尽意。",
        "明朝三丈日高时，共拼醉头扶不起。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313412,
      "title": "玉楼春",
      "content": [
        "琼酥酒面风吹醒。",
        "一缕斜红临晚镜。",
        "小颦微笑尽妖娆，浅注轻匀长淡净。",
        "手挪梅蕊寻香径。",
        "正是佳期期未定。",
        "春来还为个般愁，瘦损宫腰罗带剩。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313413,
      "title": "玉楼春",
      "content": [
        "清歌学得秦娥似。",
        "金屋瑶台知姓字。",
        "可怜春恨一生心，长带粉痕双袖泪。",
        "从来懒话低眉事。",
        "今日新声谁会意。",
        "坐中应有赏音人，试问回肠曾断未。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313414,
      "title": "玉楼春",
      "content": [
        "旗亭西畔朝云住。",
        "沈水香烟长满路。",
        "柳阴分到画眉边，花片飞来垂手处。",
        "妆成尽任秋娘妒。",
        "袅袅盈盈当绣户。",
        "临风一曲醉朦腾，陌上行人凝恨去。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313415,
      "title": "玉楼春",
      "content": [
        "离鸾照罢尘生镜。",
        "几点吴霜侵绿鬓。",
        "琵琶弦上语无凭，豆蔻梢头春有信。",
        "相思拼损朱颜尽。",
        "天若多情终欲问。",
        "雪窗休记夜来寒，桂酒已消人去恨。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313416,
      "title": "玉楼春",
      "content": [
        "东风又作无情计。",
        "艳粉娇红吹满地。",
        "碧楼帘影不遮愁，还似去年今日意。",
        "谁知错管春残事。",
        "到处登临曾费泪。",
        "此时金盏直须深，看尽落花能几醉。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313417,
      "title": "玉楼春",
      "content": [
        "斑骓路与阳台近。",
        "前度无题初借问。",
        "暖风鞭袖尽闲垂，微月帘栊曾暗认。",
        "梅花未足凭芳信。",
        "弦语岂堪传素恨。",
        "翠眉饶似远山长，寄与此愁颦不尽。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313418,
      "title": "玉楼春",
      "content": [
        "红绡学舞腰肢软。",
        "旋织舞衣宫样染。",
        "织成云外雁行斜，染作江南春水浅。",
        "露桃宫里随歌管。",
        "一曲霓裳红日晚。",
        "归来双袖酒成痕，小字香笺无意展。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313419,
      "title": "玉楼春",
      "content": [
        "当年信道情无价。",
        "桃叶尊前论别夜。",
        "脸红心绪学梅妆，眉翠工夫如月画。",
        "来时醉倒旗亭下。",
        "知是阿谁扶上马。",
        "忆曾挑尽五更灯，不记临分多少话。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313420,
      "title": "玉楼春",
      "content": [
        "采莲时候慵歌舞。",
        "永日闲从花里度。",
        "暗随苹末晓风来，直待柳梢斜月去。",
        "停桡共说江头路。",
        "临水楼台苏小住。",
        "细思巫峡梦回时，不减秦源肠断处。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313421,
      "title": "玉楼春",
      "content": [
        "芳年正是香英嫩。",
        "天与娇波长入鬓。",
        "蕊珠宫里旧承恩，夜拂银屏朝把镜。",
        "云情去住终难信。",
        "花意有无休更问。",
        "醉中同尽一杯欢，归后各成孤枕恨。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313422,
      "title": "玉楼春",
      "content": [
        "轻风拂柳冰初绽。",
        "细雨消尘云未散。",
        "红窗青镜待妆梅，绿陌高楼催送雁。",
        "华罗歌扇金蕉盏。",
        "记得寻芳心绪惯。",
        "凤城寒尽又飞花，岁岁春光常有限。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313423,
      "title": "阮郎归",
      "content": [
        "粉痕闲印玉尖纤。",
        "啼红傍晚奁。",
        "旧寒新暖尚相兼。",
        "梅疏待雪添。",
        "春冉冉，恨恹恹。",
        "章台对卷帘。",
        "个人鞭影弄凉蟾。",
        "楼前侧帽檐。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313424,
      "title": "阮郎归",
      "content": [
        "来时红日弄窗纱。",
        "春红入睡霞。",
        "去时庭树欲栖鸦。",
        "香屏掩月斜。",
        "收翠羽，整妆华。",
        "青骊信又差。",
        "玉笙犹恋碧桃花。",
        "今宵未忆家。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313425,
      "title": "阮郎归",
      "content": [
        "旧香残粉似当初。",
        "人情恨不如。",
        "一春犹有数行书。",
        "秋来书更疏。",
        "衾凤冷，枕鸳孤。",
        "愁肠待酒舒。",
        "梦魂纵有也成虚。",
        "那堪和梦无。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313426,
      "title": "阮郎归",
      "content": [
        "天边金掌露成霜。",
        "云随雁字长。",
        "绿杯红袖称重阳。",
        "人情似故乡。",
        "兰佩紫，菊簪黄。",
        "殷勤理旧狂。",
        "欲将沈醉换悲凉。",
        "清歌莫断肠。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313427,
      "title": "阮郎归",
      "content": [
        "晚妆长趁景阳钟。",
        "双蛾著意浓。",
        "舞腰浮动绿云浓。",
        "樱桃半点红。",
        "怜美景，惜芳容。",
        "沈思暗记中。",
        "春寒帘幕几重重。",
        "杨花尽日风。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313428,
      "title": "归田乐",
      "content": [
        "试把花期数。",
        "便早有、感春情绪。",
        "看即梅花吐。",
        "愿花更不谢，春且长住。",
        "只恐花飞又春去。",
        "花开还不语。",
        "问此意、年年春还会否。",
        "绛唇青鬓，渐少花前语。",
        "对花又记得、旧曾游处。",
        "门外垂杨未飘絮。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313429,
      "title": "浣溪沙",
      "content": [
        "二月春花厌落梅。",
        "仙源归路碧桃催。",
        "渭城丝雨劝离杯。",
        "欢意似云真薄幸，客鞭摇柳正多才。",
        "凤楼人待锦书来。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313430,
      "title": "浣溪沙",
      "content": [
        "卧鸭池头小苑开。",
        "暄风吹尽北枝梅。",
        "柳长莎软路萦回。",
        "静避绿阴莺有意，漫随游骑絮多才。",
        "去年今日忆同来。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313431,
      "title": "浣溪沙",
      "content": [
        "二月和风到碧城。",
        "万条千缕绿相迎。",
        "舞烟眠雨过清明。",
        "妆镜巧眉偷叶样，歌楼妍曲借枝名。",
        "晚秋霜霰莫无情。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313432,
      "title": "浣溪沙",
      "content": [
        "白纻春衫杨柳鞭。",
        "碧蹄骄马杏花鞯。",
        "落英飞絮冶游天。",
        "南陌暖风吹舞榭，东城凉月照歌筵。",
        "赏心多是酒中仙。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313433,
      "title": "浣溪沙",
      "content": [
        "床上银屏几点山。",
        "鸭炉香过琐窗寒。",
        "小云双枕恨春闲。",
        "惜别漫成良夜醉，解愁时有翠笺还。",
        "那回分袂月初残。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313434,
      "title": "浣溪沙",
      "content": [
        "绿柳藏乌静掩关。",
        "鸭炉香细琐窗闲。",
        "那回分袂月初残。",
        "惜别漫成良夜醉，解愁时有翠笺还。",
        "欲寻双叶寄情难。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313435,
      "title": "浣溪沙",
      "content": [
        "家近旗亭酒易酤。",
        "花时长得醉工夫。",
        "伴人歌笑懒妆梳。",
        "户外绿杨春系马，床前红烛夜呼卢。",
        "相逢还解有情无。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313436,
      "title": "浣溪沙",
      "content": [
        "日日双眉斗画长。",
        "行云飞絮共轻狂。",
        "不将心嫁冶游郎。",
        "溅酒滴残歌扇字，弄花熏得舞衣香。",
        "一春弹泪说凄凉。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313437,
      "title": "浣溪沙",
      "content": [
        "飞鹊台前晕翠蛾。",
        "千金新换绛仙螺。",
        "最难加意为颦多。",
        "几处睡痕留醉袖，一春愁思近横波。",
        "远山低尽不成歌。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313438,
      "title": "浣溪沙",
      "content": [
        "午醉西桥夕未醒。",
        "雨花凄断不堪听。",
        "归时应减鬓边青。",
        "衣化客尘今古道，柳含春意短长亭。",
        "凤楼争见路旁情。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313439,
      "title": "浣溪沙",
      "content": [
        "一样宫妆簇彩舟。",
        "碧罗团扇自障羞。",
        "水仙人在镜中游。",
        "腰自细来多态度，脸因红处转风流。",
        "年年相遇绿江头。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313440,
      "title": "浣溪沙",
      "content": [
        "已拆秋千不奈闲。",
        "却随胡蝶到花间。",
        "旋寻双叶插云鬟。",
        "几折湘裙烟缕细，一钩罗袜素蟾弯。",
        "绿窗红豆忆前欢。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313441,
      "title": "浣溪沙",
      "content": [
        "闲弄筝弦懒系裙。",
        "铅华消尽见天真。",
        "眼波低处事还新。",
        "怅恨不逢如意酒，寻思难值有情人。",
        "可怜虚度琐窗春。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313442,
      "title": "浣溪沙",
      "content": [
        "团扇初随碧簟收。",
        "画檐归燕尚迟留。",
        "靥朱眉翠喜清秋。",
        "风意未应迷狭路，灯痕犹自记高楼。",
        "露花烟叶与人愁。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313443,
      "title": "浣溪沙",
      "content": [
        "翠阁朱阑倚处危。",
        "夜凉闲捻彩箫吹。",
        "曲中双凤已分飞。",
        "绿酒细倾消别恨，红笺小写问归期。",
        "月华风意似当时。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313444,
      "title": "浣溪沙",
      "content": [
        "唱得红梅字字香。",
        "柳枝桃叶尽深藏。",
        "遏云声里送雕觞。",
        "才听便拼衣袖湿，欲歌先倚黛眉长。",
        "曲终敲损燕钗梁。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313445,
      "title": "浣溪沙",
      "content": [
        "小杏春声学浪仙。",
        "疏梅清唱替哀弦。",
        "似花如雪绕琼筵。",
        "腮粉月痕妆罢后，脸红莲艳酒醒前。",
        "今年水调得人怜。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313446,
      "title": "浣溪沙",
      "content": [
        "铜虎分符领外台。",
        "五云深处彩旌来。",
        "春随红旆过长淮。",
        "千里裤襦添旧暖，万家桃李间新栽。",
        "使星回首是三台。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313447,
      "title": "浣溪沙",
      "content": [
        "浦口莲香夜不收。",
        "水边风里欲生秋。",
        "棹歌声细不惊鸥。",
        "凉月送归思往事，落英飘去起新愁。",
        "可堪题叶寄东楼。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313448,
      "title": "浣溪沙",
      "content": [
        "莫问逢春能几回。",
        "能歌能笑是多才。",
        "露花犹有好枝开。",
        "绿鬓旧人皆老大，红梁新燕又归来。",
        "尽须珍重掌中杯。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313449,
      "title": "浣溪沙",
      "content": [
        "楼上灯深欲闭门。",
        "梦云归去不留痕。",
        "几年芳草忆王孙。",
        "向日阑干依旧绿，试将前事倚黄昏。",
        "记曾来处易消魂。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313450,
      "title": "六么令",
      "content": [
        "绿阴春尽，飞絮绕香阁。",
        "晚来翠眉宫样，巧把远山学。",
        "一寸狂心未说，已向横波觉。",
        "画帘遮币。",
        "新翻曲妙，暗许闲人带偷掏。",
        "前度书多隐语，意浅愁难答。",
        "昨夜诗有回纹，韵险还慵押。",
        "都待笙歌散了，记取留时霎。",
        "不消红蜡。",
        "闲云归后，月在庭花旧阑角。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313451,
      "title": "六么令",
      "content": [
        "雪残风信，悠扬春消息。",
        "天涯倚楼新恨，杨柳几丝碧。",
        "还是南云雁少，锦字无端的。",
        "宝钗瑶席。",
        "彩弦声里，拼作尊前未归客。",
        "遥想疏梅此际，月底香英白。",
        "别后谁绕前溪，手拣繁枝摘。",
        "莫道伤高恨远，付与临风笛。",
        "尽堪愁寂。",
        "花时往事，更有多情个人忆。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313452,
      "title": "六么令",
      "content": [
        "日高春睡，唤起懒装束。",
        "年年落花时候，惯得娇眠足。",
        "学唱宫梅便好，更暖银笙逐。",
        "黛蛾低绿。",
        "堪教人恨，却似江南旧时曲。",
        "常记东楼夜雪，翠幕遮红烛。",
        "还是芳酒杯中，一醉光阴促。",
        "曾笑阳台梦短，无计怜香玉。",
        "此欢难续。",
        "乞求歌罢，借取归云画堂宿。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313453,
      "title": "更漏子",
      "content": [
        "槛花稀，池草遍。",
        "冷落吹笙庭院。",
        "人去日，燕西飞。",
        "燕归人未归。",
        "数书期，寻梦意。",
        "弹指一年春事。",
        "新怅望，旧悲凉。",
        "不堪红日长。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313454,
      "title": "更漏子",
      "content": [
        "柳间眠，花里醉。",
        "不惜绣裙铺地。",
        "钗燕重，鬓蝉轻。",
        "一双梅子青。",
        "粉笺书，罗袖泪。",
        "还有可怜新意。",
        "遮闷绿，掩羞红。",
        "晚来团扇风。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313455,
      "title": "更漏子",
      "content": [
        "柳丝长，桃叶小。",
        "深院断无人到。",
        "红日淡，绿烟晴。",
        "流莺三两声。",
        "雪香浓，檀晕少。",
        "枕上卧枝花好。",
        "春思重，晓妆迟。",
        "寻思残梦时。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313456,
      "title": "更漏子",
      "content": [
        "露华高，风信远。",
        "宿醉画帘低卷。",
        "梳洗倦，冶游慵。",
        "绿窗春睡浓。",
        "彩条轻，金缕重。",
        "昨日小桥相送。",
        "芳草恨，落花愁。",
        "去年同倚楼。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313457,
      "title": "更漏子",
      "content": [
        "出墙花，当路柳。",
        "借问芳心谁有。",
        "红解笑，绿能颦。",
        "千般恼乱春。",
        "北来人，南去客。",
        "朝暮等闲攀折。",
        "怜晚秀，惜残阳。",
        "情知枉断肠。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313458,
      "title": "更漏子",
      "content": [
        "欲论心，先掩泪。",
        "零落去年风味。",
        "闲卧处，不言时。",
        "愁多只自知。",
        "到情深，俱是怨。",
        "惟有梦中相见。",
        "犹似旧，奈人禁。",
        "偎人说寸心。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313459,
      "title": "河满子",
      "content": [
        "对镜偷匀玉箸，背人学写银钩。",
        "系谁红豆罗带角，心情正著春游。",
        "那日杨花陌上，多时杏子墙头。",
        "眼底关山无奈，梦中云雨空休。",
        "问看几许怜才意，两蛾藏尽离愁。",
        "难拼此回肠断，终须锁定红楼。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313460,
      "title": "河满子",
      "content": [
        "绿绮琴中心事，齐纨扇上时光。",
        "五陵年少浑薄幸，轻如曲水飘香。",
        "夜夜魂消梦峡，年年泪尽啼湘。",
        "归雁行边远字，惊鸾舞处离肠。",
        "蕙楼多少铅华在，从来错倚红妆。",
        "可羡邻姬十五，金钗早嫁王昌。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313461,
      "title": "于飞乐",
      "content": [
        "晓日当帘，睡痕犹占香腮。",
        "轻盈笑倚鸾台。",
        "晕残红，匀宿翠，满镜花开。",
        "娇蝉鬓畔，插一枝、淡蕊疏梅。",
        "每到春深，多愁饶恨，妆成懒下香阶。",
        "意中人，从别后，萦系情怀。",
        "良辰好景，相思字、唤不归来。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313462,
      "title": "愁倚阑令・春光好",
      "content": [
        "凭江阁，看烟鸿。",
        "恨春浓。",
        "还有当年闻笛泪，洒东风。",
        "时候草绿花红。",
        "斜阳外、远水溶溶。",
        "浑似阿莲双枕畔，画屏中。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313463,
      "title": "愁倚阑令・春光好",
      "content": [
        "花阴月，柳梢莺。",
        "近清明。",
        "长恨去年今夜雨，洒离亭。",
        "枕上怀远诗成。",
        "红笺纸、小砑吴绫。",
        "寄与征人教念远，莫无情。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313464,
      "title": "愁倚阑令・春光好",
      "content": [
        "春罗薄，酒醒寒。",
        "梦初残。",
        "敧枕片时云雨事，已关山。",
        "楼上斜日阑干。",
        "楼前路、曾试雕鞍。",
        "拼却一襟怀远泪，倚阑看。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313465,
      "title": "御街行",
      "content": [
        "年光正似花梢露。",
        "弹指春还暮。",
        "翠眉仙子望归来，倚遍玉城珠树。",
        "岂知别后，好风良月，往事无寻处。",
        "狂情错向红尘住。",
        "忘了瑶台路。",
        "碧桃花蕊已应开，欲伴彩云飞去。",
        "回思十载，朱颜青鬓，枉被浮名误。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313466,
      "title": "御街行",
      "content": [
        "街南绿树春饶絮。",
        "雪满游春路。",
        "树头花艳杂娇云，树底人家朱户。",
        "北楼闲上，疏帘高卷，直见街南树。",
        "阑干倚尽犹慵去。",
        "几度黄昏雨。",
        "晚春盘马踏青苔，曾傍绿阴深驻。",
        "落花犹在，香屏空掩，人面知何处。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313467,
      "title": "浪淘沙",
      "content": [
        "高阁对横塘。",
        "新燕年光。",
        "柳花残梦隔潇湘。",
        "绿浦归帆看不见，还是斜阳。",
        "一笑解愁肠。",
        "人会娥妆。",
        "藕丝衫袖郁金香。",
        "曳雪牵云留客醉，且伴春狂。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313468,
      "title": "浪淘沙",
      "content": [
        "小绿间长红。",
        "露蕊烟丛。",
        "花开花落昔年同。",
        "惟恨花前携手处，往事成空。",
        "山远水重重。",
        "一笑难逢。",
        "已拼长在别离中。",
        "霜鬓知他从此去，几度春风。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313469,
      "title": "浪淘沙",
      "content": [
        "丽曲醉思仙。",
        "十二哀弦。",
        "秾蛾叠柳脸红莲。",
        "多少雨条烟叶恨，红泪离筵。",
        "行子惜流年。",
        "鹈鴂枝边。",
        "吴堤春水舣兰船。",
        "南去北来今渐老，难负尊前。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313470,
      "title": "浪淘沙",
      "content": [
        "翠幕绮筵张。",
        "淑景难忘。",
        "阳关声巧绕雕梁。",
        "美酒十分谁与共，玉指持觞。",
        "晓枕梦高唐。",
        "略话衷肠。",
        "小山池院竹风凉。",
        "明夜月圆帘四卷，今夜思量。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313471,
      "title": "丑奴儿・采桑子",
      "content": [
        "昭华凤管知名久。",
        "长闭帘栊。",
        "日日春慵。",
        "闲倚庭花晕脸红。",
        "应说金谷无人后，此会相逢。",
        "三弄临风。",
        "送得当筵玉盏空。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313472,
      "title": "丑奴儿・采桑子",
      "content": [
        "日高庭院杨花转，闲淡春风。",
        "莺语惺忪。",
        "似笑金屏昨夜空。",
        "娇慵未洗匀妆手，闲印斜红。",
        "新恨重重。",
        "都与年时旧意同。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313473,
      "title": "诉衷情",
      "content": [
        "种花人自蕊宫来。",
        "牵衣问小梅。",
        "今年芳意何似，应向旧枝开。",
        "凭寄语，谢瑶台。",
        "客无才。",
        "粉香传信，玉盏开筵，莫待春回。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313474,
      "title": "诉衷情",
      "content": [
        "净揩妆脸浅匀眉。",
        "衫子素梅儿。",
        "苦无心绪梳洗，闲淡也相宜。",
        "云态度，柳腰肢。",
        "入相思。",
        "夜来月底，今日尊前，未当佳期。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313475,
      "title": "诉衷情",
      "content": [
        "渚莲霜晓坠残红。",
        "依约旧秋同。",
        "玉人团扇恩浅，一意恨西风。",
        "云去住，月朦胧。",
        "夜寒浓。",
        "此时还是，泪墨书成，未有归鸿。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313476,
      "title": "诉衷情",
      "content": [
        "凭觞静忆去年秋，桐落故溪头。",
        "诗成自写红叶，和恨寄东流。",
        "人脉脉，水悠悠。",
        "几多愁。",
        "雁书不到，蝶梦无凭，漫倚高楼。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313477,
      "title": "诉衷情",
      "content": [
        "小梅风韵最妖娆。",
        "开处雪初消。",
        "南枝欲附春信，长恨陇人遥。",
        "闲记忆，旧江皋。",
        "路迢迢。",
        "暗香浮动，疏影横斜，几处溪桥。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313478,
      "title": "诉衷情",
      "content": [
        "长因蕙草记罗裙。",
        "绿腰沈水熏。",
        "阑干曲处人静，曾共倚黄昏。",
        "风有韵，月无痕。",
        "暗消魂。",
        "拟将幽恨，试写残花，寄与朝云。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313479,
      "title": "诉衷情",
      "content": [
        "御纱新制石榴裙。",
        "沈香慢火熏。",
        "越罗双带宫样，飞鹭碧波纹。",
        "随锦字，叠香痕。",
        "寄文君。",
        "系来花下，解向尊前，谁伴朝云。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313480,
      "title": "诉衷情",
      "content": [
        "都人离恨满歌筵。",
        "清唱倚危弦。",
        "星屏别后千里，更见是何年。",
        "骢骑稳，绣衣鲜。",
        "欲朝天。",
        "北人欢笑，南国悲凉，迎送金鞭。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313481,
      "title": "破阵子",
      "content": [
        "柳下笙歌庭院，花间姊妹秋千。",
        "记得春楼当日事，写向红窗夜月前。",
        "凭谁寄小莲。",
        "绛蜡等闲陪泪，吴蚕到了缠绵。",
        "绿鬓能供多少恨，未肯无情比断弦。",
        "今年老去年。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313482,
      "title": "好女儿",
      "content": [
        "绿遍西池。",
        "梅子青时。",
        "尽无端、尽日东风恶，更霏微细雨，恼人离恨，满路春泥。",
        "应是行云归路，有闲泪、洒相思。",
        "想旗亭、望断黄昏月，又依前误了，红笺香信，翠袖欢期。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313483,
      "title": "好女儿",
      "content": [
        "酌酒殷勤。",
        "尽更留春。",
        "忍无情、便赋馀花落，待花前细把、一春心事，问个人人。",
        "莫似花开还谢，愿芳意、且长新。",
        "倚娇红、待得欢期定，向水沈烟底，金莲影下，睡过佳辰。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313484,
      "title": "点绛唇",
      "content": [
        "花信来时，恨无人似花依旧。",
        "又成春瘦。",
        "折断门前柳。",
        "天与多情，不与长相守。",
        "分飞后。",
        "泪痕和酒。",
        "占了双罗袖。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313485,
      "title": "点绛唇",
      "content": [
        "明日征鞭，又将南陌垂杨折。",
        "自怜轻别。",
        "拼得音尘绝。",
        "杏子枝边，倚处阑干月。",
        "依前缺。",
        "去年时节。",
        "旧事无人说。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313486,
      "title": "点绛唇",
      "content": [
        "碧水东流，漫题凉叶津头寄。",
        "谢娘春意。",
        "临水颦双翠。",
        "日日骊歌，空费行人泪。",
        "成何计。",
        "未如浓醉。",
        "闲掩红楼睡。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313487,
      "title": "点绛唇",
      "content": [
        "妆席相逢，旋匀红泪歌金缕。",
        "意中曾许。",
        "欲共吹花去。",
        "长爱荷香，柳色殷桥路。",
        "留人住。",
        "淡烟微雨。",
        "好个双栖处。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313488,
      "title": "点绛唇",
      "content": [
        "湖上西风，露花啼处秋香老。",
        "谢家春草。",
        "唱得清商好。",
        "笑倚兰舟，转尽新声了。",
        "烟波渺。",
        "暮云稀少。",
        "一点凉蟾小。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313489,
      "title": "两同心",
      "content": [
        "楚乡春晚，似入仙源。",
        "拾翠处、闲随流水，踏青路、暗惹香尘。",
        "心心在，柳外青帘，花下朱门。",
        "对景且醉芳尊。",
        "莫话消魂。",
        "好意思、曾同明月，恶滋味、最是黄昏。",
        "相思处，一纸红笺，无限啼痕。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313490,
      "title": "少年游",
      "content": [
        "绿勾阑畔，黄昏淡月，携手对残红。",
        "纱窗影里，朦腾春睡，繁杏小屏风。",
        "须愁别后，天高海阔，何处更相逢。",
        "幸有花前，一杯芳酒，欢计莫匆匆。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313491,
      "title": "少年游",
      "content": [
        "西溪丹杏，波前媚脸，珠露与深匀。",
        "南楼翠柳，烟中愁黛，丝雨恼娇颦。",
        "当年此处，闻歌𣨼酒，曾对可怜人。",
        "今夜相思，水长山远，闲卧送残春。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313492,
      "title": "少年游",
      "content": [
        "离多最是，东西流水，终解两相逢。",
        "浅情终似，行云无定，犹到梦魂中。",
        "可怜人意，薄于云水，佳会更难重。",
        "细想从来，断肠多处，不与者番同。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313493,
      "title": "少年游",
      "content": [
        "西楼别后，风高露冷，无奈月分明。",
        "飞鸿影里，捣衣砧外，总是玉关情。",
        "王孙此际，山重水远，何处赋西征。",
        "金闺魂梦枉丁宁。",
        "寻尽短长亭。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313494,
      "title": "少年游",
      "content": [
        "雕梁燕去，裁诗寄远，庭院旧风流。",
        "黄花醉了，碧梧题罢，闲卧对高秋。",
        "繁云破后，分明素月，凉影挂金钩。",
        "有人凝澹倚西楼。",
        "新样两眉愁。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313495,
      "title": "虞美人",
      "content": [
        "闲敲玉镫隋堤路。",
        "一笑开朱户。",
        "素云凝澹月婵娟。",
        "门外鸭头春水、木兰船。",
        "吹花拾蕊嬉游惯。",
        "天与相逢晚。",
        "一声长笛倚楼时。",
        "应恨不题红叶、寄相思。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    }
  ],
