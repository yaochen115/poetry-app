{
  "data": [
    {
      "id": 257271,
      "title": "官定后戏赠",
      "content": [
        "不作河西尉，凄凉为折腰。",
        "老夫怕趋走，率府且逍遥。",
        "耽酒须微禄，狂歌托圣朝。",
        "故山归兴尽，回首向风飙。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 257272,
      "title": "九日蓝田崔氏庄",
      "content": [
        "老去悲秋强自宽，兴来今日尽君欢。",
        "羞将短发还吹帽，笑倩旁人为正冠。",
        "蓝水远从千涧落，玉山高并两峰寒。",
        "明年此会知谁健，醉把茱萸子细看。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 257273,
      "title": "崔氏东山草堂",
      "content": [
        "爱汝玉山草堂静，高秋爽气相鲜新。",
        "有时自发钟磬响，落日更见渔樵人。",
        "盘剥白鸦谷口栗，饭煮青泥坊底芹。",
        "何为西庄王给事，柴门空闭鏁松筠。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 257274,
      "title": "对雪",
      "content": [
        "战哭多新鬼，愁吟独老翁。",
        "乱云低薄暮，急雪舞回风。",
        "瓢弃尊无绿，炉存火似红。",
        "数州消息断，愁坐正书空。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 257275,
      "title": "月夜",
      "content": [
        "今夜鄜州月，闺中只独看。",
        "遥怜小儿女，未解忆长安。",
        "香雾云鬟湿，清辉玉臂寒。",
        "何时倚虚幌，双照泪痕干。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 257276,
      "title": "遣兴",
      "content": [
        "骥子好男儿，前年学语时。",
        "问知人客姓，诵得老夫诗。",
        "世乱怜渠小，家贫仰母慈。",
        "鹿门携不遂，雁足系难期。",
        "天地军麾满，山河战角悲。",
        "傥归免相失，见日敢辞迟。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 257277,
      "title": "元日寄韦氏妹",
      "content": [
        "近闻韦氏妹，迎在汉钟离。",
        "郎伯殊方镇，京华旧国移。",
        "春城回北斗，郢树发南枝。",
        "不见朝正使，啼痕满面垂。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 257278,
      "title": "春望",
      "content": [
        "国破山河在，城春草木深。",
        "感时花溅泪，恨别鸟惊心。",
        "烽火连三月，家书抵万金。",
        "白头搔更短，浑欲不胜簪。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 257279,
      "title": "忆幼子",
      "content": [
        "骥子春犹隔，莺歌暖正繁。",
        "别离惊节换，聪慧与谁论。",
        "涧水空山道，柴门老树村。",
        "忆渠愁只睡，炙背俯晴轩。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 257280,
      "title": "一百五日夜对月",
      "content": [
        "无家对寒食，有泪如金波。",
        "斫却月中桂，清光应更多。",
        "仳离放红蘂，想像嚬青蛾。",
        "牛女漫愁思，秋期犹渡河。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 257281,
      "title": "喜达行在所三首 一",
      "content": [
        "西忆岐阳信，无人遂却回。",
        "眼穿当落日，心死著寒灰。",
        "雾树行相引，莲峰望忽开。",
        "所亲惊老瘦，辛苦贼中来。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 257282,
      "title": "喜达行在所三首 二",
      "content": [
        "愁思胡笳夕，凄凉汉苑春。",
        "生还今日事，间道暂时人。",
        "司隶章初覩，南阳气已新。",
        "喜心飜倒极，呜咽泪霑巾。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 257283,
      "title": "喜达行在所三首 三",
      "content": [
        "死去凭谁报，归来始自怜。",
        "犹瞻太白雪，喜遇武功天。",
        "影静千官里，心苏七校前。",
        "今朝汉社稷，新数中兴年。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 257284,
      "title": "得家书",
      "content": [
        "去凭游客寄，来为附家书。",
        "今日知消息，他乡且旧居。",
        "熊儿幸无恙，骥子最怜渠。",
        "临老羁孤极，伤时会合疎。",
        "二毛趋帐殿，一命侍鸾舆。",
        "北阙妖氛满，西郊白露初。",
        "凉风新过雁，秋雨欲生鱼。",
        "农事空山里，眷言终荷锄。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 257285,
      "title": "奉赠严八阁老",
      "content": [
        "扈圣登黄阁，明公独妙年。",
        "蛟龙得云雨，雕鹗在秋天。",
        "客礼容疎放，官曹可接联。",
        "新诗句句好，应任老夫传。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 257286,
      "title": "奉送郭中丞兼太仆卿充陇右节度使三十韵",
      "content": [
        "诏发西山将，秋屯陇右兵。",
        "凄凉余部曲，燀赫旧家声。",
        "雕鹗乘时去，骅骝顾主鸣。",
        "艰难须上策，容易即前程。",
        "斜日当轩盖，高风卷斾旌。",
        "松悲天水冷，沙乱雪山清。",
        "和虏犹怀惠，防边不敢惊。",
        "古来于异域，镇静示专征。",
        "燕蓟奔封豕，周秦触骇鲸。",
        "中原何惨黩，余孽尚纵横。",
        "箭入昭阳殿，笳吟细柳营。",
        "内人红袖泣，王子白衣行。",
        "宸极祅星动，园陵杀气平。",
        "空余金椀出，无复穗帷轻。",
        "毁庙天飞雨，焚宫火彻明。",
        "罘罳朝共落，棆桷夜同倾。",
        "三月师逾整，群胡势就烹。",
        "疮痍亲接战，勇决冠垂成。",
        "妙誉期元宰，殊恩且列卿。",
        "几时回节钺，戮力埽欃枪。",
        "圭窦三千士，云梯七十城。",
        "耻非齐说客，祗似鲁诸生。",
        "通籍微班忝，周行独坐荣。",
        "随肩趋漏刻，短发寄簪缨。",
        "径欲依刘表，还疑厌祢衡。",
        "渐衰那此别，忍泪独含情。",
        "废邑狐貍语，空邨虎豹争。",
        "人频坠涂炭，公岂忘精诚。",
        "元帅调新律，前军压旧京。",
        "安边仍扈从，莫作后功名。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 257287,
      "title": "送杨六判官使西蕃",
      "content": [
        "送远秋风落，西征海气寒。",
        "帝京氛祲满，人世别离难。",
        "绝域遥怀怒，和亲愿结欢。",
        "敕书怜赞普，兵甲望长安。",
        "宣命前程急，惟良待士宽。",
        "子云清自守，今日起为官。",
        "垂泪方投笔，伤时即据鞍。",
        "儒衣山鸟怪，汉节野童看。",
        "边酒排金醆，夷歌捧玉盘。",
        "草轻蕃马健，雪重拂庐干。",
        "慎尔参筹划，从兹正羽翰。",
        "归来权可取，九万一朝抟。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 257288,
      "title": "月",
      "content": [
        "天上秋期近，人间月影清。",
        "入河蟾不没，捣药兔长生。",
        "只益丹心苦，能添白发明。",
        "干戈知满地，休照国西营。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 257289,
      "title": "留别贾严二阁老两院补阙",
      "content": [
        "田园须𫏐往，戎马惜离群。",
        "去远留诗别，愁多任酒醺。",
        "一秋常苦雨，今日始无云。",
        "山路时吹角，那堪处处闻。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 257290,
      "title": "晚行口号",
      "content": [
        "三川不可到，归路晚山稠。",
        "落雁浮寒水，饥乌集戍楼。",
        "市朝今日异，丧乱几时休。",
        "远媿梁江总，还家尚黑头。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 257291,
      "title": "独酌成诗",
      "content": [
        "灯花何太喜，酒绿正相亲。",
        "醉里从为客，诗成觉有神。",
        "兵戈犹在眼，儒术岂谋身。",
        "共被微官缚，低头媿野人。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 257292,
      "title": "行次昭陵",
      "content": [
        "旧俗疲庸主，群雄问独夫。",
        "谶归龙凤质，威定虎狼都。",
        "天属尊尧典，神功协禹谟。",
        "风云随绝足，日月继高衢。",
        "文物多师古，朝廷半老儒。",
        "直词宁戮辱，贤路不崎岖。",
        "往者灾犹降，苍生喘未苏。",
        "指麾安率土，荡涤抚洪炉。",
        "壮士悲陵邑，幽人拜鼎湖。",
        "玉衣晨自举，铁马汗常趋。",
        "松柏瞻虚殿，尘沙立暝途。",
        "寂寥开国日，流恨满山隅。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 257293,
      "title": "重经昭陵",
      "content": [
        "草昧英雄起，讴歌历数归。",
        "风尘三尺劒，社稷一戎衣。",
        "翼亮贞文德，丕承戢武威。",
        "圣图天广大，宗祀日光辉。",
        "陵寝盘空曲，熊罴守翠微。",
        "再窥松柏路，还见五云飞。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 257294,
      "title": "喜闻官军已临贼境二十韵",
      "content": [
        "胡虏潜京县，官军拥贼壕。",
        "鼎鱼犹假息，穴蚁欲何逃。",
        "帐殿罗玄冕，辕门照白袍。",
        "秦山当警跸，汉苑入旌旄。",
        "路失羊肠险，云横雉尾高。",
        "五原空壁垒，八水散风涛。",
        "今日看天意，游魂贷尔曹。",
        "乞降那更得，尚诈莫徒劳。",
        "元帅归龙种，司空握豹韬。",
        "前军苏武节，左将吕虔刀。",
        "兵气回飞鸟，威声没巨鼇。",
        "戈鋋开雪色，弓矢尚秋毫。",
        "天步艰方尽，时和运更遭。",
        "谁云遗毒螫，已是沃腥臊。",
        "睿想丹墀近，神行羽卫牢。",
        "花门腾绝漠，拓羯渡临洮。",
        "此辈感恩至，羸俘何足操。",
        "锋先衣染血，骑突劒吹毛。",
        "喜觉都城动，悲怜子女号。",
        "家家卖钗钏，只待献春醪。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 257295,
      "title": "收京三首 一",
      "content": [
        "仙仗离丹极，妖星照玉除。",
        "须为下殿走，不可好楼居。",
        "暂屈汾阳驾，聊飞燕将书。",
        "依然七庙略，更与万方初。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 257296,
      "title": "收京三首 二",
      "content": [
        "生意甘衰白，天涯正寂寥。",
        "忽闻哀痛诏，又下圣明朝。",
        "羽翼怀商老，文思忆帝尧。",
        "叨逢罪己日，霑洒望青霄。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 257297,
      "title": "收京三首 三",
      "content": [
        "汗马收宫阙，春城铲贼壕。",
        "赏应歌杕杜，归及荐樱桃。",
        "杂虏横戈数，功臣甲第高。",
        "万方频送喜，无乃圣躬劳。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 257298,
      "title": "腊日",
      "content": [
        "腊日常年暖尚遥，今年腊日冻全消。",
        "侵陵雪色还萱草，漏泄春光有柳条。",
        "纵酒欲谋良夜醉，还家初散紫宸朝。",
        "口脂面药随恩泽，翠管银罂下九霄。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 257299,
      "title": "紫宸殿退朝口号",
      "content": [
        "户外昭容紫袖垂，双瞻御座引朝仪。",
        "香飘合殿春风转，花覆千官淑景移。",
        "昼漏希闻高阁报，天颜有喜近臣知。",
        "宫中每出归东省，会送夔龙集凤池。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 257300,
      "title": "曲江二首 一",
      "content": [
        "一片花飞减却春，风飘万点正愁人。",
        "且看欲尽花经眼，莫厌伤多酒入唇。",
        "江上小堂巢翡翠，花边高冢卧麒麟。",
        "细推物理须行乐，何用浮名绊此身。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 257301,
      "title": "曲江二首 二",
      "content": [
        "朝回日日典春衣，每日江头尽醉归。",
        "酒债寻常行处有，人生七十古来稀。",
        "穿花蛱蝶深深见，点水蜻蜓款款飞。",
        "传语风光共流转，暂时相赏莫相违。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 257302,
      "title": "曲江对酒",
      "content": [
        "苑外江头坐不归，水精春殿转霏微。",
        "桃花细逐杨花落，黄鸟时兼白鸟飞。",
        "纵饮久判人共弃，嬾朝真与世相违。",
        "吏情更觉沧洲远，老大悲伤未拂衣。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 257303,
      "title": "曲江对雨",
      "content": [
        "城上春云覆苑墙，江亭晚色静年芳。",
        "林花著雨燕脂落，水荇牵风翠带长。",
        "龙武新军深驻辇，芙蓉别殿谩焚香。",
        "何时诏此金钱会，暂醉佳人锦瑟旁。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 257304,
      "title": "奉和贾至舍人早朝大明宫",
      "content": [
        "五夜漏声催晓箭，九重春色醉仙桃。",
        "旌旗日暖龙蛇动，宫殿风微燕雀高。",
        "朝罢香烟携满袖，诗成珠玉在挥毫。",
        "欲知世掌丝纶美，池上于今有凤毛。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 257305,
      "title": "宣政殿退朝晚出左掖",
      "content": [
        "天门日射黄金牓，春殿晴曛赤羽旗。",
        "宫草微微承委佩，𬬻烟细细驻游丝。",
        "云近蓬莱常好色，雪残𫛛鹊亦多时。",
        "侍臣缓步归青琐，退食从容出每迟。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 257306,
      "title": "题省中院壁",
      "content": [
        "掖垣竹埤梧十寻，洞门对霤常阴阴。",
        "落花游丝白日静，鸣鸠乳燕青春深。",
        "腐儒衰晚谬通籍，退食迟回违寸心。",
        "衮职曾无一字补，许身媿比双南金。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 257307,
      "title": "春宿左省",
      "content": [
        "花隐掖垣暮，啾啾栖鸟过。",
        "星临万户动，月傍九霄多。",
        "不寝听金钥，因风想玉珂。",
        "明朝有封事，数问夜如何。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 257308,
      "title": "送翰林张司马南海勒碑",
      "content": [
        "冠冕通南极，文章落上台。",
        "诏从三殿去，碑到百蛮开。",
        "野馆浓花发，春帆细雨来。",
        "不知沧海上，天遣几时回。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 257309,
      "title": "晚出左掖",
      "content": [
        "昼刻传呼浅，春旗簇仗齐。",
        "退朝花底散，归院柳边迷。",
        "楼雪融城湿，宫云去殿低。",
        "避人焚谏草，骑马欲鸡栖。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 257310,
      "title": "曲江陪郑八丈南史饮",
      "content": [
        "雀啄江头黄柳花，䴔䴖㶉𫛶满晴沙。",
        "自知白发非春事，且尽芳尊恋物华。",
        "近侍即今难浪迹，此身那得更无家。",
        "丈人文力犹强健，岂傍青门学种瓜。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 257311,
      "title": "送贾阁老出汝州",
      "content": [
        "西掖梧桐树，空留一院阴。",
        "艰难归故里，去住损春心。",
        "宫殿青门隔，云山紫逻深。",
        "人生五马贵，莫受二毛侵。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 257312,
      "title": "郑驸马池台喜遇郑广文同饮",
      "content": [
        "不谓生戎马，何知共酒杯。",
        "然脐郿坞败，握节汉臣回。",
        "白发千茎雪，丹心一寸灰。",
        "别离经死地，披写忽登台。",
        "重对秦箫发，俱过阮宅来。",
        "留连春夜舞，泪落强裴回。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 257313,
      "title": "送郑十八虔贬台州司户伤其临老陷贼之故阙为面别情见于诗",
      "content": [
        "郑公樗散鬓成丝，酒后常称老画师。",
        "万里伤心严谴日，百年垂死中兴时。",
        "苍惶已就长途往，邂逅无端出饯迟。",
        "便与先生应永诀，九重泉路尽交期。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 257314,
      "title": "题郑十八著作虔",
      "content": [
        "台州地阔海冥冥，云水长和岛屿青。",
        "乱后故人双别泪，春深逐客一浮萍。",
        "酒酣嬾舞谁相拽，诗罢能吟不复听。",
        "第五桥东流恨水，皇陂岸北结愁亭。",
        "贾生对𫛳伤王傅，苏武看羊陷贼庭。",
        "可念此翁怀直道，也霑新国用轻刑。",
        "祢衡实恐遭江夏，方朔虚传是岁星。",
        "穷巷悄然车马绝，案头干死读书萤。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 257315,
      "title": "端午日赐衣",
      "content": [
        "宫衣亦有名，端午被恩荣。",
        "细葛含风輭，香罗叠雪轻。",
        "自天题处湿，当暑著来清。",
        "意内称长短，终身荷圣情。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 257316,
      "title": "赠毕四",
      "content": [
        "才大今诗伯，家贫苦宦卑。",
        "饥寒奴仆贱，颜状老翁为。",
        "同调嗟谁惜，论文笑自知。",
        "流传江鲍体，相顾免无儿。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 257317,
      "title": "酬孟云卿",
      "content": [
        "乐极伤头白，更长爱烛红。",
        "相逢难衮衮，告别莫怱怱。",
        "但恐天河落，宁辞酒醆空。",
        "明朝牵世务，挥泪各西东。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 257318,
      "title": "奉赠王中允",
      "content": [
        "中允声名久，如今契阔深。",
        "共传收庾信，不比得陈琳一病缘明主，三年独此心。",
        "穷愁应有作，试诵白头吟。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 257319,
      "title": "奉陪郑驸马韦曲二首 一",
      "content": [
        "韦曲花无赖，家家恼杀人。",
        "绿尊虽尽日，白发好禁春。",
        "石角钩衣破，藤枝刺眼新。",
        "何时占业竹，头戴小乌巾。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 257320,
      "title": "奉陪郑驸马韦曲二首 二",
      "content": [
        "野寺垂杨里，春畦乱水间。",
        "美花多映竹，好鸟不归山。",
        "城郭终何事，风尘岂驻颜。",
        "谁能共公子，薄暮欲俱还。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 257321,
      "title": "奉荅岑参补阙见赠",
      "content": [
        "窈窕清禁闼，罢朝归不同。",
        "君随丞相后，我往日华东。",
        "冉冉柳枝碧，娟娟花蘂红。",
        "故人得佳句，独赠白头翁。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 257322,
      "title": "送许八拾遗归江宁觐省甫昔时尝客游此县于许生处乞瓦棺寺维摩图样志诸篇末",
      "content": [
        "诏许辞中禁，慈颜赴北堂。",
        "圣朝新孝理，祖席倍辉光。",
        "内帛擎偏重，宫衣著更香。",
        "淮阴清夜驿，京口渡江航。",
        "春隔鸡人昼，秋期燕子凉。",
        "赐书夸父老，寿酒乐城隍。",
        "看画曾饥渴，追踪恨淼茫。",
        "虎头金粟影，神妙独难忘。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 257323,
      "title": "因许八奉寄江宁旻上人",
      "content": [
        "不见旻公三十年，对书寄与泪潺湲。",
        "旧来好事今能否，老去新诗谁与传。",
        "棋局动随寻涧竹，袈裟忆上泛湖船。",
        "闻君话我为官在，头白昏昏只醉眠。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 257324,
      "title": "至德二载甫自京金光门出问道归凤翔乾元初从左拾遗移华州掾与亲故别因出此门有悲往事",
      "content": [
        "此道昔归顺，西郊胡正繁。",
        "至今残破胆，应有未招魂。",
        "近得归京邑，移官岂至尊。",
        "无才日衰老，驻马望千门。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 257325,
      "title": "寄高三十五詹事",
      "content": [
        "安稳高詹事，兵戈久索居。",
        "时来如宦达，岁晚莫情疎。",
        "天上多鸿雁，池中足鲤鱼。",
        "相看过半百，不寄一行书。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 257326,
      "title": "路逢襄阳杨少府入城戏呈杨员外绾",
      "content": [
        "寄语杨员外，山寒少茯苓。",
        "归来稍喧暖，当为𣃁青冥。",
        "飜动神仙窟，封题鸟兽形。",
        "兼将老藤杖，扶汝醉初醒。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 257327,
      "title": "题郑县亭子",
      "content": [
        "郑县亭子涧之滨，户牖凭高发兴新。",
        "云断岳莲临大路，天晴宫柳暗长春。",
        "巢边野雀群欺燕，花底山蜂远趁人。",
        "更欲题诗满青竹，晚来幽独恐伤神。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 257328,
      "title": "早秋苦热堆案相仍",
      "content": [
        "七月六日苦炎热，对食暂餐还不能。",
        "每愁夜中自足蝎，况乃秋后转多蝇。",
        "束带发狂欲大叫，簿书何急来相仍。",
        "南望青松架短壑，安得赤脚蹋层冰。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 257329,
      "title": "望岳",
      "content": [
        "西岳崚嶒竦处尊，诸峰罗立如儿孙。",
        "安得仙人九节杖，拄到玉女洗头盆。",
        "车箱入谷无归路，箭栝通天有一门。",
        "稍待西风凉冷后，高寻白帝问真源。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 257330,
      "title": "至日遣兴奉寄北省旧阁老两院故人二首 一",
      "content": [
        "去岁兹辰捧御床，五更三点入鹓行。",
        "欲知趋走伤心地，正想氛氲满眼香。",
        "无路从容陪语笑，有时颠倒著衣裳。",
        "何人错忆穷愁日，愁日愁随一线长。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 257331,
      "title": "至日遣兴奉寄北省旧阁老两院故人二首 二",
      "content": [
        "忆昨逍遥供奉班，去年今日侍龙颜。",
        "麒麟不动炉烟上，孔雀徐开扇影还。",
        "玉几由来天北极，朱衣只在殿中间。",
        "孤城此日堪肠断，愁对寒云雪满山。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 257332,
      "title": "得弟消息二首 一",
      "content": [
        "近有平阴信，遥怜舍弟存。",
        "侧身千里道，寄食一家村。",
        "烽举新酣战，啼垂旧血痕。",
        "不知临老日，招得几人魂。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 257333,
      "title": "得弟消息二首 二",
      "content": [
        "汝懦归无计，吾衰往未期。",
        "浪传乌鹊喜，深负鹡鸽诗。",
        "生理何颜面，忧端且岁时。",
        "两京三十口，虽在命如丝。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 257334,
      "title": "忆弟二首 一",
      "content": [
        "丧乱闻吾弟，饥寒傍济州。",
        "人稀吾不到，兵在见何由。",
        "忆昨狂催走，无时病去忧。",
        "即今千种恨，惟共水东流。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 257335,
      "title": "忆弟二首 二",
      "content": [
        "且喜河南定，不问邺城围。",
        "百战今谁在，三年望汝归。",
        "故园花自发，春日鸟还飞。",
        "断绝人烟久，东西消息稀。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 257336,
      "title": "得舍弟消息",
      "content": [
        "乱后谁归得，他乡胜故乡。",
        "直为心厄苦，久念与存亡。",
        "汝书犹在壁，汝妾已辞房。",
        "旧犬知愁恨，垂头傍我床。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 257337,
      "title": "秦州杂诗二十首 一",
      "content": [
        "满目悲生事，因人作远游。",
        "迟回度陇怯，浩荡及关愁。",
        "水落鱼龙夜，山空鸟鼠秋。",
        "西征问烽火，心折此淹留。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 257338,
      "title": "秦州杂诗二十首 二",
      "content": [
        "秦州山北寺，胜迹隗嚣宫。",
        "苔藓山门古，丹青野殿空。",
        "月明垂叶露，云逐渡溪风。",
        "清渭无情极，愁时独向东。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 257339,
      "title": "秦州杂诗二十首 三",
      "content": [
        "州图领同谷，驿道出流沙。",
        "降虏兼千帐，居人有万家。",
        "马骄珠汗落，胡舞白蹄斜。",
        "年少临洮子，西来亦自夸。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 257340,
      "title": "秦州杂诗二十首 四",
      "content": [
        "鼓角缘边郡，川原欲夜时。",
        "秋听殷地发，风散入云悲。",
        "抱叶寒蝉静，归来独鸟迟。",
        "万方声一概，吾道竟何之。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 257341,
      "title": "秦州杂诗二十首 五",
      "content": [
        "南使宜天马，由来万匹强。",
        "浮云连阵没，秋草徧山长。",
        "闻说真龙种，仍残老骕骦。",
        "哀鸣思战鬬，逈立向苍苍。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 257342,
      "title": "秦州杂诗二十首 六",
      "content": [
        "城上胡笳奏，山边汉节归。",
        "防河赴沧海，奉诏发金微。",
        "士苦形骸黑，旌疎鸟兽稀。",
        "那闻往来戍，恨解邺城围。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 257343,
      "title": "秦州杂诗二十首 七",
      "content": [
        "莽莽万重山，孤城山谷间。",
        "无风云出塞，不夜月临关。",
        "属国归何晚，楼兰斩未还。",
        "烟尘独长望，衰飒正摧颜。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 257344,
      "title": "秦州杂诗二十首 八",
      "content": [
        "闻道寻源使，从天此路回。",
        "牵牛去几许，宛马至今来。",
        "一望幽燕隔，何时郡国开。",
        "东征健儿尽，羌笛暮吹哀。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 257345,
      "title": "秦州杂诗二十首 九",
      "content": [
        "今日明人眼，临池好驿亭。",
        "丛篁低地碧，高柳半天青。",
        "稠叠多幽事，喧呼阅使星。",
        "老夫如有此，不异在郊坰。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 257346,
      "title": "秦州杂诗二十首 十",
      "content": [
        "云气接昆仑，涔涔塞雨繁。",
        "羌童看渭水，使客向河源。",
        "烟火军中幕，牛羊岭上村。",
        "所居秋草净，正闭小蓬门。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 257347,
      "title": "秦州杂诗二十首 十一",
      "content": [
        "萧萧古塞冷，漠漠秋云低。",
        "黄鹄翅垂雨，苍鹰饥啄泥。",
        "蓟门谁自北，汉将独征西。",
        "不意书生耳，临衰厌鼓鞞。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 257348,
      "title": "秦州杂诗二十首 十二",
      "content": [
        "山头南郭寺，水号北流泉。",
        "老树空庭得，清渠一邑传。",
        "秋花危石底，晚景卧钟边。",
        "俯仰悲身世，溪风为飒然。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 257349,
      "title": "秦州杂诗二十首 十三",
      "content": [
        "传道东柯谷，深藏数十家。",
        "对门藤盖瓦，映竹水穿沙。",
        "瘦地飜宜粟，阳坡可种瓜。",
        "船人近相报，但恐失桃花。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 257350,
      "title": "秦州杂诗二十首 十四",
      "content": [
        "万古仇池穴，潜通小有天。",
        "神鱼人不见，福地语真传。",
        "近接西南境，长怀十九泉。",
        "何时一茅屋，送老白云边。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 257351,
      "title": "秦州杂诗二十首 十五",
      "content": [
        "未暇泛苍海，悠悠兵马间。",
        "塞门风落木，客舍雨连山。",
        "阮籍行多兴，庞公隐不还。",
        "东柯遂疎嬾，休镊鬓毛斑。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 257352,
      "title": "秦州杂诗二十首 十六",
      "content": [
        "东柯好崖谷，不与众峰群。",
        "落日邀双鸟，晴天养片云。",
        "野人矜险绝，水竹会平分。",
        "采药吾将老，儿童未遣闻。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 257353,
      "title": "秦州杂诗二十首 十七",
      "content": [
        "边秋阴易久，不复辨晨光。",
        "檐雨乱淋幔，山云低度墙。",
        "鸬鹚窥浅井，蚯蚓上深堂。",
        "车马何萧索，门前百草长。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 257354,
      "title": "秦州杂诗二十首 十八",
      "content": [
        "地僻秋将尽，山高客未归。",
        "塞云多断绩，边日少光辉。",
        "警急烽常报，传闻檄屡飞。",
        "西戎外甥国，何得迕天威。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 257355,
      "title": "秦州杂诗二十首 十九",
      "content": [
        "凤林戈未息，鱼海路常难。",
        "候火云烽峻，悬军幕井干。",
        "风连西极动，月过北庭寒。",
        "故老思飞将，何时议筑坛。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 257356,
      "title": "秦州杂诗二十首 二十",
      "content": [
        "唐尧真自圣，野老复何知。",
        "晒药能无妇，应门幸有儿。",
        "藏书闻禹穴，读记忆仇池。",
        "为报鸳行旧，鹪鹩在一枝。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 257357,
      "title": "月夜忆舍弟",
      "content": [
        "戍鼓断人行，秋边一雁声。",
        "露从今夜白，月是故乡明。",
        "有弟皆分散，无家问死生。",
        "寄书长不避，况乃未休兵。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 257358,
      "title": "宿赞公房",
      "content": [
        "杖锡何来此，秋风已飒然。",
        "雨荒深院菊，霜倒半池莲。",
        "放逐宁违性，虚空不离禅。",
        "相逢成夜宿，陇月向人圆。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 257359,
      "title": "东楼",
      "content": [
        "万里流沙道，西征过北门。",
        "但添新战骨，不返旧征魂。",
        "楼角临风迥，城阴带水昏。",
        "传声看驿使，送节向河源。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 257360,
      "title": "雨晴",
      "content": [
        "天水秋云薄，从西万里风。",
        "今朝好晴景，久雨不妨农。",
        "塞柳行疎翠，山棃结小红。",
        "胡笳楼上发，一雁入高空。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 257361,
      "title": "寓目",
      "content": [
        "一县蒲萄熟，秋山苜蓿多。",
        "关云常带雨，塞水不成河。",
        "羌女轻烽燧，胡儿制骆驼。",
        "自伤迟暮眼，丧乱饱经过。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 257362,
      "title": "山寺",
      "content": [
        "野寺残僧少，山园细路高。",
        "麝香眠石竹，鹦鹉啄金桃。",
        "乱石通人过，悬崖置屋牢。",
        "上方重阁晚，百里见秋毫。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 257363,
      "title": "即事",
      "content": [
        "闻道花门破，和亲事却非。",
        "人怜汉公主，生得渡河归。",
        "秋思抛云髻，腰支胜宝衣。",
        "群凶犹索战，回首意多违。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 257364,
      "title": "遣怀",
      "content": [
        "愁眼看霜露，寒城菊自花。",
        "天风随断柳，客泪堕清笳。",
        "水净楼阴直，山昏塞日斜。",
        "夜来归鸟尽，啼杀后栖鸦。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 257365,
      "title": "天河",
      "content": [
        "常时任显晦，秋至辄分明。",
        "纵被微云掩，终能永夜清。",
        "含星动双阙，伴月照边城。",
        "牛女年年渡，何曾风浪生。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 257366,
      "title": "初月",
      "content": [
        "光细弦岂上，影斜轮未安。",
        "微升古塞外，已隐暮云端。",
        "河汉不改色，关山空自寒。",
        "庭前有白露，暗满菊花团。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 257367,
      "title": "归燕",
      "content": [
        "不独避霜雪，其如俦侣稀。",
        "四时无失序，八月自知归。",
        "春色岂相访，众雏还识机。",
        "故巢傥未毁，会傍主人飞。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 257368,
      "title": "捣衣",
      "content": [
        "亦知戍不返，秋至拭清砧。",
        "已近苦寒月，况经长别心。",
        "宁辞捣熨倦，一寄塞垣深。",
        "用尽闺中力，君听空外音。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 257369,
      "title": "促织",
      "content": [
        "促织甚微细，哀音何动人。",
        "草根吟不稳，床下夜相亲。",
        "久客得无泪，放妻难及晨。",
        "悲丝与急管，感激异天真。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 257370,
      "title": "萤火",
      "content": [
        "幸因腐草出，敢近太阳飞。",
        "未足临书卷，时能点客衣。",
        "随风隔幔小，带雨傍林微。",
        "十月清霜重，飘零何处归。"
      ],
      "author": {
        "id": 3911,
        "name": "杜甫"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    }
