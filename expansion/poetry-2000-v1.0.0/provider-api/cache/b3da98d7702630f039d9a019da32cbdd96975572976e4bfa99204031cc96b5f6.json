{
  "data": [
    {
      "id": 298455,
      "title": "菩萨蛮 七",
      "content": [
        "凤凰相对盘金缕，牡丹一夜经微雨。",
        "明镜照新妆，鬓轻双脸长。",
        "画楼相望久，阑外垂丝柳。",
        "音信不归来，社前双燕回。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298456,
      "title": "菩萨蛮 八",
      "content": [
        "牡丹花谢鸎声歇，绿杨满院中庭月。",
        "相忆梦难成，背窗灯半明。",
        "翠钿金压脸，寂寞香闺掩。",
        "人远泪阑干，燕飞春又残。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298457,
      "title": "菩萨蛮 九",
      "content": [
        "满宫明月梨花白，故人万里关山隔。",
        "金鴈一双飞，泪痕霑绣衣。",
        "小园芳草绿，家住越溪曲。",
        "杨柳色依依，燕归君不归。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298458,
      "title": "菩萨蛮 十",
      "content": [
        "宝函钿雀金㶉𫛶，沈香阁上吴山碧。",
        "杨柳又如丝，驿桥春雨时。",
        "画楼音信断，芳草江南岸。",
        "鸾镜与花枝，此情谁得知。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298459,
      "title": "菩萨蛮 十一",
      "content": [
        "南园满地堆轻絮，愁闻一霎清明雨。",
        "雨后却斜阳，杏花零落香。",
        "无言匀睡脸，枕上屏山掩。",
        "时节欲黄昏，无憀独倚门。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298460,
      "title": "菩萨蛮 十二",
      "content": [
        "夜来皓月才当午，重帘悄悄无人语。",
        "深处麝烟长，卧时留薄妆。",
        "当年还自惜，往事那堪忆。",
        "花露月明残，锦衾知晓寒。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298461,
      "title": "菩萨蛮 十三",
      "content": [
        "雨晴夜合玲珑日，万枝香袅红丝拂。",
        "闲梦忆金堂，满庭萱草长。",
        "绣帘垂{罒/录}𦌉，眉黛远山绿。",
        "春水渡溪桥，凭阑魂欲消。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298462,
      "title": "菩萨蛮 十四",
      "content": [
        "竹风轻动庭除冷，珠帘月上玲珑影。",
        "山枕隐浓妆，绿檀金凤凰。",
        "两蛾愁黛浅，故国吴宫远。",
        "春恨正关情，画楼残点声。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298463,
      "title": "菩萨蛮 十五",
      "content": [
        "玉纤弹处真珠落，流多暗湿铅华薄。",
        "春露浥朝花，秋波浸晚霞。",
        "风流心上物，本为风流出。",
        "看取薄情人，罗衣无此痕。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298464,
      "title": "清平乐 一",
      "content": [
        "上阳春晚，宫女愁蛾浅。",
        "新岁清平思同辇，争奈长安路远。",
        "凤帐鸳被徒熏，寂寞花琐千门。",
        "竞把黄金买赋，为妾将上明君。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298465,
      "title": "清平乐 二",
      "content": [
        "洛阳愁绝，杨柳花飘雪。",
        "终日行人争攀折，桥下水流呜咽。",
        "上马争劝离觞，南浦鸎声断肠。",
        "愁杀平原年少，回首挥泪千行。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298466,
      "title": "更漏子 一",
      "content": [
        "柳丝长，春雨细，花外漏声迢递。",
        "惊塞鴈，起城乌，画屏金鹧鸪。",
        "香雾薄，透帘幕，惆怅谢家池阁。",
        "红烛背，绣帘垂，梦长君不知。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298467,
      "title": "更漏子 二",
      "content": [
        "星斗稀，钟鼓歇，帘外晓鸎残月。",
        "兰露重，柳风斜，满庭堆落花。",
        "虚阁上，倚阑望，还似去年惆怅。",
        "春欲暮，思无穷，旧欢如梦中。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298468,
      "title": "更漏子 三",
      "content": [
        "金雀钗，红粉面，花里暂时相见。",
        "知我意，感君怜，此情须问天。",
        "香作穗，蜡成泪，还似两人心意。",
        "山枕腻，锦衾寒，觉来更漏残。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298469,
      "title": "更漏子 四",
      "content": [
        "相见稀，相忆久，眉浅淡烟如柳。",
        "垂翠幕，结同心，待郎熏绣衾。",
        "城上月，白如雪，蝉鬓美人愁绝。",
        "宫树暗，鹊桥横，玉签初报明。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298470,
      "title": "更漏子 五",
      "content": [
        "背江楼，临海月，城上角声呜咽。",
        "堤柳动，岛烟昏，两行征鴈分。",
        "京口路，归帆渡，正是芳菲欲度。",
        "银烛尽，玉绳低，一声村落鸡。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298471,
      "title": "更漏子 六",
      "content": [
        "玉炉香，红蜡泪，偏照画堂秋思。",
        "眉翠薄，鬓云残，夜长衾枕寒。",
        "梧桐树，三更雨，不道离情正苦。",
        "一叶叶，一声声，空阶滴到明。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298472,
      "title": "河渎神 一",
      "content": [
        "河上望丛祠，庙前春雨来时。",
        "楚山无限鸟飞迟，兰櫂空伤别离。",
        "何处杜鹃啼不歇，艳红开尽如血。",
        "蝉鬓美人愁绝，百花芳草佳节。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298473,
      "title": "河渎神 二",
      "content": [
        "孤庙对寒潮，西陵风雨潇潇。",
        "谢娘惆怅倚兰桡，泪流玉筯千条。",
        "暮天愁听思归乐，早梅香满山郭。",
        "回首两情萧索，离魂何处飘泊。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298474,
      "title": "河渎神 三",
      "content": [
        "铜鼓赛神来，满庭幡盖裴回。",
        "水村江浦过风雷，楚山如画烟开。",
        "离别𫇛声空萧索，玉容惆怅妆薄。",
        "青麦燕飞落落，卷帘愁对珠阁。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298475,
      "title": "河传 一",
      "content": [
        "江畔，相唤。",
        "晓妆鲜，仙景个女采莲。",
        "请君莫向那岸边，少年，好花新满船。",
        "红袖摇曳逐风輭，垂玉腕，肠向柳丝断。",
        "浦南归，浦北归，莫知，晚来人已稀。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298476,
      "title": "河传 二",
      "content": [
        "湖上，闲望。",
        "雨萧萧，烟浦花桥路遥。",
        "谢娘翠蛾愁不销，终朝，梦魂迷晚潮。",
        "荡子天涯归櫂远，春已晚，鸎语空肠断。",
        "若耶溪，溪水西，柳堤，不闻郎马嘶。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298477,
      "title": "河传 三",
      "content": [
        "同伴，相唤。",
        "杏花稀，梦里每愁依违。",
        "仙客一去燕已飞，不归，泪痕空满衣。",
        "天际云鸟引情远，春已晚，烟霭渡南苑。",
        "雪梅香，柳带长，小娘，转令人意伤。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298478,
      "title": "木兰花",
      "content": [
        "家临长信往来道，乳燕双双拂烟草。",
        "油壁车轻金犊肥，流苏帐晓春鸡早。",
        "笼中娇鸟暖犹睡，帘外落花闲不扫。",
        "衰桃一树近前池，似惜容颜镜中老。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 299218,
      "title": "句",
      "content": [
        "沿涧水声喧户外，卷帘山色入窗来。",
        "自有晚风推楚浪，不劳春色染湘烟。",
        "卓氏垆前金线柳，隋家隄畔锦帆风。",
        "门外白云何处雨，一条清涧遶溪流。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 301668,
      "title": "赠隐者",
      "content": [
        "楚客隐名姓，围碁当薜萝。",
        "乱溪藏钓石，一鹤在庭柯。",
        "败堰水声急，破窗山色多。",
        "南轩新竹迳，应许子猷过。",
        "（《又玄集》中）。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 301669,
      "title": "蜂蝶（句）",
      "content": [
        "蜜官金翼使，花贼玉腰奴。",
        "（《清异录》三）。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 304207,
      "title": "句 一",
      "content": [
        "山寺明媚木芍药，野田叫噪官虾蟆。",
        "（见《能改斋漫录》卷五《汉以牡丹为木芍药》条）。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 304208,
      "title": "句 二",
      "content": [
        "窗疏眉语度。",
        "（见《类说》卷四九《汉上题襟》）。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 304209,
      "title": "卜山居",
      "content": [
        "山底采薇云不厌，洞中栽树鹤先知。",
        "（见《日本古典文学大系》七三册藤原公任《和汉朗咏集》卷下《仙家》引）（按：上毛河世宁《全唐诗逸》卷中收二句归「温达」。",
        "川口久雄注《和汉朗咏集》以为系沿袭《千唐佳句》抄本的误字而致误。",
        "题从架藏私注本。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 334438,
      "title": "横吹曲辞：雍台歌",
      "content": [
        "太子池南楼百尺，八窗新树疏帘隔。",
        "黄金铺首画钩陈，",
        "早雁声鸣细波起，映花卤簿龙飞回。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 334446,
      "title": "相和歌辞：公无渡河",
      "content": [
        "黄河怒浪连天来，大响谹谹如殷雷。",
        "龙伯驱风不敢上，",
        "下有狂蛟锯为尾，裂帆截棹磨霜齿。",
        "神锥凿石塞神潭，"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 334457,
      "title": "相和歌辞：江南曲",
      "content": [
        "妾家白苹浦，日上芙蓉楫。",
        "轧轧摇桨声，移舟入茭叶。",
        "溪长茭叶深，作底难相寻。",
        "避郎郎不见，㶉𫛶自浮沉。",
        "拾萍萍无根，采莲莲有子。",
        "不作浮萍生，宁作藕花死。",
        "岸傍骑马郎，乌帽紫游缰。",
        "含愁复含笑，回首问横塘。",
        "妾住金陵步，门前朱雀航。",
        "流苏持作帐，芙蓉持作梁。",
        "出入金犊幰，兄弟侍中郎。",
        "前年学歌舞，定得郎相许。",
        "连娟眉绕山，依约腰如杵。",
        "凤管悲若咽，鸾弦娇欲语。",
        "扇薄露红铅，罗轻压金缕。",
        "明月西南楼，珠帘玳瑁钩。",
        "横波巧能笑，弯蛾不识愁。",
        "花开子留树，草长根依土。",
        "早闻金沟远，底事归郎许。",
        "不学杨白花，朝朝泪如雨。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 334717,
      "title": "相和歌辞：懊恼曲",
      "content": [
        "藕丝作线难胜针，蕊粉染黄那得深。",
        "玉白兰芳不相顾，",
        "三秋庭绿尽迎霜，惟有荷花守红死。",
        "西江小吏朱斑轮，",
        "悠悠楚水流如马，恨紫愁红满平野。",
        "野土千年怨不平，"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 334721,
      "title": "相和歌辞：春江花月夜",
      "content": [
        "玉树歌阑海云黑，花庭忽作青芜国。",
        "秦淮有水水无情，",
        "百幅锦帆风力满，连天展尽金芙蓉。",
        "珠翠丁星复明灭，",
        "漏转霞高沧海西，颇黎枕上闻天鸡。",
        "蛮弦代雁曲如语，",
        "后主荒宫有晓莺，飞来只隔西江水。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 334723,
      "title": "相和歌辞：堂堂",
      "content": [
        "钱塘岸上春如织，淼淼寒潮带晴色。",
        "淮南游客马连嘶，",
        "一曲堂堂红烛筵，金鲸泻酒如飞泉。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 334760,
      "title": "相和歌辞：三洲歌",
      "content": [
        "团圆莫作波中月，洁白莫为枝上雪。",
        "月随波动碎潾潾，",
        "门前有路轻离别，惟恐归来旧香灭。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 334763,
      "title": "相和歌辞：常林欢",
      "content": [
        "宜城酒熟花覆桥，沙晴绿鸭鸣咬咬。",
        "秾桑绕舍麦如尾，",
        "锦荐金炉梦正长，东家呃喔鸡鸣早。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 334780,
      "title": "相和歌辞：张静婉采莲曲",
      "content": [
        "兰膏坠发红玉春，燕钗拖颈抛盘云。",
        "城西杨柳向娇晚，",
        "掌中无力舞衣轻，翦断鲛绡破春碧。",
        "抱月飘烟一尺腰，",
        "㶉𫛶胶胶塘水满，绿萍如粟莲茎短。",
        "一夜西风送雨来，",
        "郎心似月月易缺，十五十六清光圆。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 334786,
      "title": "相和歌辞：阳春曲",
      "content": [
        "云母空窗晓烟薄，香昏龙气凝辉阁。",
        "霏霏雾雨杏花天，",
        "厩马何能啮芳草，路人不敢随流尘。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 334816,
      "title": "舞曲歌辞：屈柘词",
      "content": [
        "杨柳萦桥绿，玫瑰拂地红。",
        "绣衫金騕褭，花髻玉珑璁。",
        "宿雨香潜润，春流水暗通。",
        "画楼初梦断，晴日照湘风。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 334968,
      "title": "杂曲歌辞：侠客行",
      "content": [
        "欲出鸿都门，阴云蔽城阙。",
        "宝剑黯如水，微红湿余血。",
        "白马夜频嘶，三更霸陵雪。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 335060,
      "title": "杂曲歌辞：西洲曲",
      "content": [
        "悠悠复悠悠，昨日下西洲。",
        "西洲风色好，遥见武昌楼。",
        "武昌何郁郁，侬家定无匹。",
        "小妇被流黄，登楼抚瑶瑟。",
        "朱弦繁复轻，素手直凄清。",
        "一弹三四解，掩抑似含情。",
        "南楼登且望，西江广复平。",
        "艇子摇两桨，催过石头城。",
        "门前乌臼树，惨澹天将曙。",
        "鶤𫛥飞复还，郎随早帆去。",
        "回头语同伴，定复负情侬。",
        "去帆不安幅，作抵使西风。",
        "他日相寻索，莫作西洲客。",
        "西洲人不归，春草年年碧。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 335093,
      "title": "杂曲歌辞：湖阴曲",
      "content": [
        "祖龙黄须珊瑚鞭，铁骢金面青连钱。",
        "虎髯拔剑欲成梦，",
        "苍黄追骑尘外归，森索妖星阵前死。",
        "五陵愁碧春萋萋，",
        "白虬天子金煌铓，高临帝座回龙章。",
        "吴波不动楚山晚，"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 335258,
      "title": "杂曲歌辞：达摩支",
      "content": [
        "捣麝成尘香不灭，拗莲作寸丝难绝。",
        "红泪文姬洛水春，",
        "旧臣头鬓霜华早，可惜雄心醉中老。",
        "万古春归梦不归，"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 335276,
      "title": "杂曲歌辞：杨柳枝",
      "content": [
        "宜春苑外最长条，闲袅春风伴舞腰。",
        "正是玉人肠断处，一渠春水赤栏桥。",
        "南内墙东御路傍，预知春色柳丝黄。",
        "杏花未肯无情思，何事情人最断肠。",
        "苏小门前柳万条，毵毵金线拂平桥。",
        "黄莺不语东风起，深闭朱门伴细腰。",
        "金缕毵毵碧瓦沟，六宫眉黛惹春愁。",
        "晚来更带龙池雨，半拂栏干半入楼。",
        "馆娃宫外邺城西，远映征帆近拂堤。",
        "系得王孙归意切，不关春草绿萋萋。",
        "两两黄鹂色似金，袅枝啼露动芳音。",
        "春来幸自长如线，可惜牵缠荡子心。",
        "御柳如丝映九重，凤凰窗柱绣芙蓉。",
        "景阳楼伴千条露，一面新妆待晓钟。",
        "织锦机边莺语频，停梭垂泪忆征人。",
        "塞门三月犹萧索，纵有垂杨未觉春。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 335355,
      "title": "杂歌谣辞：苏小小歌",
      "content": [
        "买莲莫破券，买酒莫解金。",
        "酒里春容抱离恨，",
        "一自檀郎逐便风，门前春水年年绿。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 335365,
      "title": "杂歌谣辞：黄昙子歌",
      "content": [
        "参差绿蒲短，摇艳云塘满。",
        "红潋荡融融，莺翁㶉𫛶暖。",
        "萋芊小城路，马上修蛾懒。",
        "罗衫褭向风，点粉金鹂卵。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 335366,
      "title": "杂歌谣辞：邯郸郭公辞",
      "content": [
        "金笳悲故曲，玉座积深尘。",
        "言是邯郸伎，不易邺城人。",
        "青苔竟埋骨，红粉自伤神。",
        "唯有漳河柳，还向旧营春。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 361850,
      "title": "鸡鸣埭曲",
      "content": [
        "南朝天子射雉时，银河耿耿星参差。",
        "铜壶漏断梦初觉，",
        "红妆万户镜中春，碧树一声天下晓。",
        "盘踞势穷三百年，",
        "绣龙画雉填宫井，野火风驱烧九鼎。",
        "殿巢江燕砌生蒿，",
        "宁知玉树后庭曲，留待野棠如雪枝。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361851,
      "title": "织锦词",
      "content": [
        "丁东细漏侵琼瑟，影转高梧月初出。",
        "簇簌金梭万缕红，",
        "此意欲传传不得，玫瑰作柱朱弦琴。",
        "为君裁破合欢被，"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361852,
      "title": "夜宴谣",
      "content": [
        "长钗坠发双蜻蜓，碧尽山斜开画屏。",
        "虬须公子五侯客，",
        "清夜恩情四座同，莫令沟水东西别。",
        "亭亭蜡泪香珠残，",
        "裂管萦弦共繁曲，芳樽细浪倾春醁。",
        "高楼客散杏花多，"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361853,
      "title": "莲浦谣",
      "content": [
        "鸣桡轧轧溪溶溶，废绿平烟吴苑东。",
        "水清莲媚两相向，",
        "荷心有露似骊珠，不是真圆亦摇荡。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361854,
      "title": "郭处士击瓯歌",
      "content": [
        "佶栗金虬石潭古，勺陂潋滟幽修语。",
        "湘君宝马上神云，",
        "玉晨冷磬破昏梦，天露未干香著衣。",
        "兰钗委坠垂云发，",
        "太平天子驻云车，龙炉勃郁双蟠拏。",
        "宫中近臣抱扇立，",
        "我亦为君长叹息，缄情远寄愁无色。",
        "莫沾香梦绿杨丝。",
        "千里春风正无力。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361855,
      "title": "遐水谣",
      "content": [
        "天兵九月渡遐水，马踏沙鸣惊雁起。",
        "杀气空高万里情，",
        "犀带鼠裘无暖色，清光炯冷黄金鞍。",
        "虏尘如雾昏亭障，"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361856,
      "title": "晓仙谣",
      "content": [
        "玉妃唤月归海宫，月色澹白涵春空。",
        "银河欲转星靥靥，",
        "绮阁空传唱漏声，网轩未辨凌云字。",
        "遥遥珠帐连湘烟，",
        "秦王女骑红尾凤，半空回首晨鸡弄。",
        "雾盖狂尘亿兆家，"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361857,
      "title": "锦城曲",
      "content": [
        "蜀山攒黛留晴雪，簝笋蕨芽萦九折。",
        "江风吹巧剪霞绡，",
        "巴水漾情情不尽，文君织得春机红。",
        "怨魄未归芳草死，"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361858,
      "title": "生禖屏风歌",
      "content": [
        "玉墀暗接昆仑井，井上无人金索冷。",
        "画壁阴森九子堂，",
        "宜男漫作后庭草，不似樱桃千子红。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361860,
      "title": "舞衣曲",
      "content": [
        "藕肠纤缕抽轻春，烟机漠漠娇娥嚬。",
        "金梭淅沥透空薄，",
        "蝉衫麟带压愁香，偷得莺簧锁金缕。",
        "管含兰气娇语悲，"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361861,
      "title": "张静婉采莲歌",
      "content": [
        "兰膏坠发红玉春，燕钗拖颈抛盘云。",
        "城边杨柳向娇晚，",
        "掌中无力舞衣轻，剪断鲛绡破春碧。",
        "抱月飘烟一尺腰，",
        "㶉𫛶交交塘水满，绿芒如粟莲茎短。",
        "一夜西风送雨来，",
        "郎心似月月未缺，十五十六清光圆。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361863,
      "title": "黄昙子歌",
      "content": [
        "参差绿蒲短，摇艳云塘满。",
        "红潋荡融融，莺翁㶉𫛶暖。",
        "萋芊小成路，马上修蛾懒。",
        "罗衫袅回风，点粉金鹂卵。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 361864,
      "title": "觱篥歌",
      "content": [
        "蜡烟如纛新蟾满，门外平沙草芽短。",
        "黑头丞相九天归。",
        "夜听飞琼吹朔管。",
        "情远气调兰蕙熏，天香瑞彩含絪缊。",
        "皓然纤指都揭血，日暖碧霄无片云。",
        "含商咀征双幽咽，",
        "鸣梭淅沥金丝蕊，恨语殷勤陇头水。",
        "汉将营前万里沙，",
        "景阳宫女正愁绝，莫使此声催断魂。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361865,
      "title": "照影曲",
      "content": [
        "景阳妆罢琼窗暖，欲照澄明香步懒。",
        "桥上衣多抱彩云，",
        "桃花百媚如欲语，曾为无双今两身。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361866,
      "title": "拂舞词",
      "content": [
        "黄河怒浪连天来，大响谹谹如殷雷。",
        "龙伯驱风不敢上，",
        "下有狂蛟锯为尾，裂帆截棹磨霜齿。",
        "神椎凿石塞神潭，",
        "腥鲜龙气连清防，花风漾漾吹细光。",
        "叠澜不定照天井，",
        "夜深银汉通柏梁，二十八宿朝玉堂。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361867,
      "title": "雉场歌",
      "content": [
        "茭叶萋萋接烟曙，鸡鸣埭上梨花露。",
        "彩仗锵锵已合围，",
        "绿场红迹未相接，箭发铜牙伤彩毛。",
        "麦陇桑阴小山晚，"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361868,
      "title": "雍台歌",
      "content": [
        "太子池南楼百尺，入窗新树疏帘隔。",
        "黄金铺首画钩陈，",
        "早雁惊鸣细波起，映花卤簿龙飞回。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361869,
      "title": "吴苑行",
      "content": [
        "锦雉双飞梅结子，平春远绿窗中起。",
        "吴江澹画水连空，",
        "绮户雕楹长若此，韶光岁岁如归来。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361870,
      "title": "常林欢歌",
      "content": [
        "宜城酒熟花覆桥，沙晴绿鸭鸣咬咬。",
        "秾桑绕舍麦如尾，",
        "锦荐金炉梦正长，东家咿喔鸡鸣早。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361871,
      "title": "塞寒行",
      "content": [
        "燕弓弦劲霜封瓦，朴簌寒雕睇平野，一点黄尘起雁喧，",
        "晚出榆关逐征北，惊沙飞迸冲貂袍。",
        "心许凌烟名不灭，"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361872,
      "title": "湖阴词",
      "content": [
        "祖龙黄须珊瑚鞭，铁骢金面青连钱。",
        "虎髯拔剑欲成梦，",
        "苍黄追骑尘外归，森索妖星阵前死。",
        "五陵愁碧春萋萋，",
        "白虬天子金煌铓，高临帝座回龙章。",
        "吴波不动楚山晚，"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361873,
      "title": "蒋侯神歌",
      "content": [
        "楚神铁马金鸣珂，夜动蛟潭生素波。",
        "商风刮水报西帝，",
        "巫娥传意托悲丝，铎语琅琅理双鬓。",
        "湘烟刷翠湘山斜，"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361874,
      "title": "汉皇迎春词",
      "content": [
        "春草芊芊晴扫烟，宫城大锦红殷鲜。",
        "海日初融照仙掌，",
        "巨公步辇迎句芒，复道扫尘燕彗长。",
        "豹尾竿前赵飞燕，",
        "宝马摇环万骑归，恩光暗入帘栊里。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 361875,
      "title": "兰塘词",
      "content": [
        "塘水汪汪凫唼喋，忆上江南木兰楫。",
        "绣颈金须荡倒光，",
        "小姑归晚红妆浅，镜里芙蓉照水鲜。",
        "东沟潏潏劳回首，"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361876,
      "title": "晚归曲",
      "content": [
        "格格水禽飞带波，孤光斜起夕阳多。",
        "湖西山浅似相笑，",
        "水极晴摇泛滟红，草平春染烟绵绿。",
        "玉鞭骑马杨叛儿，",
        "弯堤弱柳遥相瞩，雀扇团圆掩香玉。",
        "莲塘艇子归不归，"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361878,
      "title": "昆明池水战词",
      "content": [
        "汪汪积水光连空，重叠细纹晴漾红。",
        "赤帝龙孙鳞甲怒，",
        "雷吼涛惊白石山，石鲸眼裂蟠蛟死。",
        "溟池海浦俱喧豗。",
        "青帜白旌相次来。",
        "箭羽枪缨三百万，踏翻西海生尘埃。",
        "茂陵仙去菱花老，唼唼游鱼近烟岛。",
        "渺莽残阳钓艇归，"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361879,
      "title": "谢公墅歌",
      "content": [
        "朱雀航南绕香陌，谢郎东墅连春碧。",
        "鸠眠高柳日方融，",
        "四座无喧梧竹静，金蝉玉柄俱持颐。",
        "对局含情见千里，"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361880,
      "title": "罩鱼歌",
      "content": [
        "朝罩罩城南，暮罩罩城西。",
        "两浆鸣幽幽，莲子相高低。",
        "持罩入深水，金鳞大如手。",
        "鱼尾迸圆波，千珠落湘藕。",
        "风飔飔，雨离离，菱尖茭刺㶉𫛶飞。",
        "水连网眼白如影，",
        "悠溶杳若去无穷，五色澄潭鸭头绿。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361881,
      "title": "春洲曲",
      "content": [
        "韶光染色如蛾翠，绿湿红鲜水容媚。",
        "苏小慵多兰渚闲，",
        "门外平桥连柳堤，归来晚树黄莺啼。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361882,
      "title": "台城晓朝曲",
      "content": [
        "司马门前火千炬，阑干星斗天将曙。",
        "朱网龛𩭹丞相车，",
        "大江敛势避辰极，两阙深严烟翠浓。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361883,
      "title": "走马楼三更曲",
      "content": [
        "春姿暖气昏神沼，李树拳枝紫芽小。",
        "玉皇夜入未央宫，",
        "帘间清唱报寒点，丙舍无人遗烬香。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361884,
      "title": "达摩支曲",
      "content": [
        "捣麝成尘香不灭，拗莲作寸丝难绝。",
        "红泪文姬洛水春，",
        "旧臣头鬓霜华早，可惜雄心醉中老。",
        "万古春归梦不归，"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361885,
      "title": "阳春曲",
      "content": [
        "云母空窗晓烟薄，香昏龙气凝晖阁。",
        "霏霏雾雨杏花天，",
        "厩马何能啮芳草，路人不敢随流尘。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361886,
      "title": "湘东宴曲",
      "content": [
        "湘东夜宴金貂人，楚女含情娇翠嚬。",
        "玉管将吹插钿带，",
        "万户沉沉碧树圆，云飞雨散知何处。",
        "欲上香车俱脉脉，"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361887,
      "title": "东郊行",
      "content": [
        "斗鸡台下东西道，柳覆班骓蝶萦草。",
        "坱霭韶容锁澹愁，",
        "王孙骑马有归意，林彩著空如细尘。",
        "安得人生各相守，"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361888,
      "title": "水仙谣",
      "content": [
        "水客夜骑红鲤鱼，赤鸾双鹤蓬瀛书。",
        "轻尘不起雨新霁，",
        "夜深天碧乱山姿，光碎平波满船月。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361889,
      "title": "东峰歌",
      "content": [
        "锦砾潺湲玉溪水，晓来微雨藤花紫。",
        "冉冉山鸡红尾长，",
        "阳崖一梦伴云根，仙菌灵芝梦魂里。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361890,
      "title": "会昌丙寅丰岁歌",
      "content": [
        "丙寅岁，休牛马，风如吹烟，日如渥赭。",
        "九重天子调天下，",
        "zv茸单衣麦田路，村南娶妇桃花红。",
        "新姑车右及门柱，"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361892,
      "title": "春野行",
      "content": [
        "草浅浅，春如剪。",
        "花压李娘愁，饥蚕欲成茧。",
        "东城年少气堂堂，金丸惊起双鸳鸯。",
        "含羞更问卫公子，"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361893,
      "title": "醉歌",
      "content": [
        "簷柳初黄燕新乳，晓碧芊绵过微雨。",
        "树色深含台榭情，",
        "入门下马问谁在，降阶握手登华堂。",
        "临邛美人连山眉，",
        "劝君莫惜金樽酒，年少须臾如覆手。",
        "辛勤到老慕箪瓢，",
        "阿耋光颜不识字，指麾豪俊如驱羊。",
        "天犀压断朱鼹鼠，",
        "驽马垂头抢暝尘，骅骝一日行千里。",
        "但有沉冥醉客家，"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 361894,
      "title": "江南曲",
      "content": [
        "妾家白苹浦，日上芙蓉楫。",
        "轧轧摇桨声，移舟入茭叶。",
        "溪长茭叶深，作底难相寻。",
        "避郎郎不见，㶉𫛶自浮沉。",
        "拾萍萍无根，采莲莲有子。",
        "不作浮萍生，宁为藕花死。",
        "岸傍骑马郎，乌帽紫游缰。",
        "含愁复含笑，回首问横塘。",
        "妾住金陵浦，门前朱雀航。",
        "流苏持作帐，芙蓉持作梁。",
        "出入金犊幰，兄弟侍中郎。",
        "前年学歌舞，定得郎相许。",
        "连娟眉绕山，依约腰如杵。",
        "凤管悲若咽，鸾弦娇欲语。",
        "扇薄露红铅，罗轻压金缕。",
        "明月西南楼，珠帘玳瑁钩。",
        "横波巧能笑，弯蛾不识愁。",
        "花开子留树，草长根依土。",
        "早闻金沟远，底事归郎许。",
        "不学杨白花，朝朝泪如雨。"
      ],
      "author": {
