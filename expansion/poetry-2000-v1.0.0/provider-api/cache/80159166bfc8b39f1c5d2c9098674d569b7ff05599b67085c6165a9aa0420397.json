{
  "data": [
    {
      "id": 276820,
      "title": "四皓庙",
      "content": [
        "羽翼殊勋弃若遗，皇天有运我无时。",
        "庙前便接山门路，不长青松长紫芝。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276821,
      "title": "题白石莲花寄楚公",
      "content": [
        "白石莲花谁所共，六时长捧佛前灯。",
        "空庭苔藓饶霜露，时梦西山老病僧。",
        "大海龙宫无限地，诸天雁塔几多层。",
        "漫夸鹙子真罗汉，不会牛车是上乘。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276822,
      "title": "[安定]城楼",
      "content": [
        "迢遰高城百尺楼，绿杨枝外尽汀洲。",
        "贾生年少虚垂泪，王粲春来更远游。",
        "永忆江湖归白发，欲回天地入扁舟。",
        "不知腐鼠成滋味，猜意鸳雏竟未休。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276823,
      "title": "隋宫守岁",
      "content": [
        "消息东郊木帝回，宫中行乐有新梅。",
        "沈香甲煎为庭燎，玉液琼苏作寿杯。",
        "遥望露盘疑是月，远闻鼍鼓欲惊雷。",
        "昭阳第一倾城客，不踏金莲不肯来。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276824,
      "title": "利州江潭作",
      "content": [
        "神劒飞来不易销，碧潭珍重驻兰桡。",
        "自携明月移灯疾，欲就行云散锦遥。",
        "河伯轩窗通贝阙，水宫帷箔卷冰绡。",
        "他时燕脯无人寄，雨满空城蕙叶雕。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276825,
      "title": "即目",
      "content": [
        "地宽楼已迥，人更迥于楼。",
        "细意经春物，伤酲属暮愁。",
        "望赊殊易断，恨久欲难收。",
        "大埶真无利，多情岂自由。",
        "空园兼树废，败港拥花流。",
        "书去青枫驿，鸿归杜若洲。",
        "单栖应分定，辞疾索谁忧。",
        "更替林鵶恨，惊频去不休。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 276826,
      "title": "相思",
      "content": [
        "相思树上合欢枝，紫凤青鸾共羽仪。",
        "肠断秦台吹管客，日西春尽到来迟。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276827,
      "title": "茂陵",
      "content": [
        "汉家天马出蒲梢，苜蓿榴花遍近郊。",
        "内苑只知含凤觜，属车无复插鸡翘。",
        "玉桃偷得怜方朔，金屋修成贮阿娇。",
        "谁料苏卿老归国，茂陵松栢雨萧萧。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276828,
      "title": "镜槛",
      "content": [
        "镜槛芙蓉入，香台翡翠过。",
        "拨弦惊火凤，交扇拂天鹅。",
        "隐忍阳城笑，喧传郢市歌。",
        "仙眉琼作叶，佛髻钿为螺。",
        "五里无因雾，三秋只见河。",
        "月中供药剩，海上得绡多。",
        "玉集胡沙割，犀留圣水磨。",
        "斜门穿戏蝶，小阁锁飞蛾。",
        "骑襜侵鞯卷，车帷约幰𨱂。",
        "传书两行雁，取酒一封𫘞。",
        "桥迥凉风压，沟横夕照和。",
        "待乌燕太子，驻马魏东阿。",
        "想像铺芳褥，依稀解醉罗。",
        "散时帘隔露，卧后幕生波。",
        "梯稳从攀桂，弓调任射莎。",
        "岂能抛断梦，听鼓事朝珂。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 276829,
      "title": "送郑大台文南觐",
      "content": [
        "黎辟滩声五月寒，南风无处附平安。",
        "君怀一匹胡威绢，争拭酬恩泪得干。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276830,
      "title": "风",
      "content": [
        "迥拂来鸿急，斜催别燕高。",
        "已寒休惨淡，更远尚呼号。",
        "楚色分西塞，夷音接下牢。",
        "归舟天外有，一为戒波涛。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276831,
      "title": "洞庭鱼",
      "content": [
        "洞庭鱼可拾，不假更垂罾。",
        "闹若雨前蚁，多于秋后蝇。",
        "岂思鳞作簟，仍计腹为灯。",
        "浩荡天池路，翱翔欲化鹏。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276832,
      "title": "天涯",
      "content": [
        "春日在天涯，天涯日又斜。",
        "莺啼如有泪，为湿最高花。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 276833,
      "title": "喜舍弟羲叟及第上礼部魏公",
      "content": [
        "国以斯文重，公仍内署来。",
        "风标森太华，星象逼中台。",
        "朝满迁鸎侣，门多吐凤才。",
        "宁同鲁司寇，惟铸一颜回。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276834,
      "title": "哀筝",
      "content": [
        "延颈全同鹤，柔肠素怯猿。",
        "湘波无限泪，蜀魄有余冤。",
        "轻幰长无道，哀筝不出门。",
        "何由问香炷，翠幕自黄昏。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276835,
      "title": "自南山北归经分水岭",
      "content": [
        "水急愁无地，山深故有云。",
        "那通极目望，又作断肠分。",
        "郑驿来虽及，燕台哭不闻。",
        "犹余遗意在，许刻镇南勋。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276836,
      "title": "旧顿",
      "content": [
        "东人望幸久咨嗟，四海于今是一家。",
        "犹锁平时旧行殿，尽无宫户有宫鸦。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276837,
      "title": "代董秀才却扇",
      "content": [
        "莫将画扇出帷来，遮掩春山滞上才。",
        "若道团圆似明月，此中须放桂花开。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276838,
      "title": "有感",
      "content": [
        "非关宋玉有微辞，却是襄王梦觉迟。",
        "一自高唐赋成后，楚天云雨尽堪疑。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276839,
      "title": "骊山有感",
      "content": [
        "骊岫飞泉泛暖香，九龙呵护玉莲房。",
        "平明每幸长生殿，不从金舆惟寿王。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276840,
      "title": "别智玄法师",
      "content": [
        "云鬓无端怨别离，十年移易住山期。",
        "东西南北皆垂泪，却是杨朱真本师。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276841,
      "title": "赠孙绮新及第",
      "content": [
        "长乐遥听上苑钟，彩衣称庆桂香浓。",
        "陆机始拟夸文赋，不觉云间有士龙。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276842,
      "title": "代秘书赠弘文馆诸校书",
      "content": [
        "清切曹司近玉除，比来秋兴复何如。",
        "崇文馆里丹霜后，无限红棃忆校书。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276843,
      "title": "乱石",
      "content": [
        "虎踞龙蹲纵复横，星光渐减雨痕生。",
        "不须并碍东西路，哭杀厨头阮步兵。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276844,
      "title": "日日",
      "content": [
        "日日春光鬬日光，山城斜路杏花香。",
        "几时心绪浑无事，得及游丝百尺长。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276845,
      "title": "过楚宫",
      "content": [
        "巫峡迢迢旧楚宫，至今云雨暗丹枫。",
        "微生尽恋人间乐，只有襄王忆梦中。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276846,
      "title": "龙池",
      "content": [
        "龙池赐酒敞云屏，羯鼓声高众乐停。",
        "夜半宴归宫漏永，薛王沉醉寿王醒。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276847,
      "title": "涙",
      "content": [
        "永巷长年怨绮罗，离情终日思风波。",
        "湘江竹上痕无限，岘首碑前洒几多。",
        "人去紫台秋入塞，兵残楚帐夜闻歌。",
        "朝来灞水桥边问，未抵青袍送玉珂。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276848,
      "title": "十字水期韦潘侍御同年不至时韦寓居水次故郭汾宁宅",
      "content": [
        "伊水溅溅相背流，朱栏画阁几人游。",
        "漆灯夜照真无数，蜡炬晨炊竟未休。",
        "顾我有怀同大梦，期君不至更沉忧。",
        "西园碧树今谁主，与近高窗卧听秋。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276849,
      "title": "流鸎",
      "content": [
        "流鸎飘荡复参差，渡陌临流不自持。",
        "巧啭岂能无本意，良辰未必有佳期。",
        "风朝露夜阴晴里，万户千门开闭时。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 276850,
      "title": "出关宿盘豆馆对丛芦有感",
      "content": [
        "芦叶梢梢夏景深，邮亭暂欲洒尘襟。",
        "昔年曾是江南客，此日初为关外心。",
        "思子台边风自急，玉娘湖上月应沈。",
        "清声不远行人去，一世荒城伴夜砧。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276851,
      "title": "和韩录事送宫人入道",
      "content": [
        "星使追还不自由，双童捧上绿琼辀。",
        "九枝灯下朝金殿，三素云中侍玉楼。",
        "凤女颠狂成久别，月娥孀独好同游。",
        "当时若爱韩公子，埋骨成灰恨未休。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276852,
      "title": "即目",
      "content": [
        "小鼎煎茶面曲池，白须道士竹间棋。",
        "何人书破蒲葵扇，记著南塘移树时。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276853,
      "title": "圣女祠",
      "content": [
        "杳蔼逢仙迹，苍茫滞客途。",
        "何年归碧落，此路向皇都。",
        "消息期青雀，逢迎异紫姑。",
        "肠回楚国梦，心断汉宫巫。",
        "从骑裁寒竹，行车荫白榆。",
        "星娥一去后，月姊更来无。",
        "寡鹄迷苍壑，羇凰怨翠梧。",
        "惟应碧桃下，方朔是狂夫。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 276854,
      "title": "七月二十九日崇让宅䜩作",
      "content": [
        "露如微霰下前池，月过回塘万竹悲。",
        "浮世本来多聚散，红蕖何事亦离披。",
        "悠扬归梦惟灯见，濩落生涯独酒知。",
        "岂到白头长只尔，嵩阳松雪有心期。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276855,
      "title": "赠从兄阆之",
      "content": [
        "怅望人间万事违，私书幽梦约忘机。",
        "荻花村里鱼标在，石藓庭中鹿迹微。",
        "幽径定携僧共入，寒塘好与月相依。",
        "城中猘犬憎兰佩，莫损幽芳久不归。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276856,
      "title": "吴宫",
      "content": [
        "龙槛沈沈水殿清，禁门深揜断人声。",
        "吴王宴罢满宫醉，日暮水漂花出城。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276857,
      "title": "常娥",
      "content": [
        "云母屏风烛影深，长河渐落晓星沈。",
        "常娥应悔偷灵药，碧海青天夜夜心。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276858,
      "title": "残花",
      "content": [
        "残花啼露莫留春，尖髪谁非怨别人。",
        "若但掩关劳烛梦，宝钗何日不生尘。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276859,
      "title": "天津西望",
      "content": [
        "虏马崩腾忽一狂，翠华无日到东方。",
        "天津西望肠真断，满眼秋波出苑墙。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276860,
      "title": "西亭",
      "content": [
        "此夜西亭月正圆，疎帘相伴宿风烟。",
        "梧桐莫更翻清露，孤鹤从来不得眠。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276861,
      "title": "忆住一师",
      "content": [
        "无事经年别远公，帝城钟晓忆西峰。",
        "炉烟消尽寒灯晦，童子开门雪满松。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276862,
      "title": "昨夜",
      "content": [
        "不辞𫛸鴂妬年芳，但惜流尘暗烛房。",
        "昨夜西池凉露满，桂花吹断月中香。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276863,
      "title": "海客",
      "content": [
        "海客乘槎上紫氛，星娥罢织一相闻。",
        "只应不惮牵牛妬，聊用支机石赠君。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276864,
      "title": "初食笋呈座中",
      "content": [
        "嫩箨香苞初出林，于陵论价重如金。",
        "皇都陆海应无数，忍剪凌云一寸心。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276865,
      "title": "早起",
      "content": [
        "风露澹清晨，帘间独起人。",
        "鸎花啼又笑，毕竟是谁春。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 276866,
      "title": "寄蜀客",
      "content": [
        "君到临邛问酒垆，近来还有长卿无。",
        "金徽却是无情物，不许文君忆故夫。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276867,
      "title": "行至金牛驿寄兴元渤海尚书",
      "content": [
        "楼上春云水底天，五云章色破巴牋。",
        "诸生个个王恭柳，从事人人庾杲莲。",
        "六曲屏风江雨急，九枝灯檠夜珠圆。",
        "深慙走马金牛路，骤和陈王白玉篇。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276868,
      "title": "深树见一颗樱桃尚在",
      "content": [
        "高桃留晚实，寻得小庭南。",
        "矮堕绿云髻，欹危红玉簪。",
        "惜堪充凤食，痛已被鸎含。",
        "越鸟夸香荔，齐名亦未甘。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276869,
      "title": "细雨",
      "content": [
        "帷飘白玉堂，簟卷碧牙床。",
        "楚女当时意，萧萧髪彩凉。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 276870,
      "title": "歌舞",
      "content": [
        "遏云歌响清，回雪舞腰轻。",
        "只要君流眄，君倾国自倾。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 276871,
      "title": "海上",
      "content": [
        "石桥东望海连天，徐福空来不得仙。",
        "直遣麻姑与搔背，可能留命待桑田。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276872,
      "title": "魏侯第东北楼堂郢叔言别聊用书所见成篇",
      "content": [
        "暗楼连夜阁，不拟为黄昏。",
        "未必断别泪，何曾妨梦魂。",
        "疑穿花逶迤，渐近火温黁。",
        "海底翻无水，仙家却有邨。",
        "锁香金屈[戌]，𣨼酒玉昆仑。",
        "羽白风交扇，冰清月映盆。",
        "旧欢尘自积，新岁电犹奔。",
        "霞绮空留段，云峰不带根。",
        "念君千里舸，江草漏灯痕。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 276873,
      "title": "白云夫旧居",
      "content": [
        "平生误识白云夫，再到仙簷忆酒垆。",
        "墙外万株人绝迹，夕阳惟照欲栖乌。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276874,
      "title": "同学彭道士参寥",
      "content": [
        "莫羡仙家有上真，仙家暂谪亦千春。",
        "月中桂树高多少，试问西河斫树人。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276875,
      "title": "到秋",
      "content": [
        "扇风淅沥簟流离，万里南风滞所思。",
        "守到清秋还寂莫，叶丹苔碧闭门时。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276876,
      "title": "华师",
      "content": [
        "孤鹤不睡云无心，衲衣筇杖来西林。",
        "院门昼锁回廊静，秋日当堦柿叶阴。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276877,
      "title": "华岳下题西王母庙",
      "content": [
        "神仙有分岂关情，八马虚随落日行。",
        "莫恨名姬中夜没，君王犹自不长生。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276878,
      "title": "过华清内廐门",
      "content": [
        "华清别馆闭黄昏，碧草悠悠内厩门。",
        "自是明时不巡幸，至今青海有龙孙。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276879,
      "title": "乐游原",
      "content": [
        "万树鸣蝉隔岸虹，乐游原上有西风。",
        "羲和自趁虞泉宿，不放斜阳更向东。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276880,
      "title": "赠荷花",
      "content": [
        "世间花叶不相伦，花入金盆叶作尘。",
        "惟有绿荷红菡萏，卷舒开合任天真。",
        "此[花]此叶常相映，翠减红衰愁杀人。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 276881,
      "title": "丹丘",
      "content": [
        "青女丁宁结夜霜，羲和辛苦送朝阳。",
        "丹丘万里无消息，几对梧桐忆凤皇。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276882,
      "title": "房君珊瑚散",
      "content": [
        "不见姮娥影，清秋守月轮。",
        "月中闲杵臼，桂子捣成尘。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 276883,
      "title": "小桃园",
      "content": [
        "竟日小桃园，休寒亦未暄。",
        "坐鸎当酒重，送客出墙繁。",
        "啼久艳粉薄，舞多香雪翻。",
        "犹怜未圆月，先出照黄昏。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276884,
      "title": "嘲樱桃",
      "content": [
        "朱实鸟含尽，青楼人未归。",
        "南园无限树，独自叶如帏。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 276885,
      "title": "和张秀才落花有感",
      "content": [
        "晴暖感余芳，红苞杂绛房。",
        "落时犹自舞，扫后更闻香。",
        "梦罢收罗荐，仙归勅玉箱。",
        "回肠九回后，犹有剩回肠。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276886,
      "title": "代越公房妓嘲徐公主",
      "content": [
        "笑啼俱不敢，几欲是吞声。",
        "遽遣离琴怨，都由半镜明。",
        "应防啼与笑，微露浅深情。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 276887,
      "title": "代贵公主",
      "content": [
        "芳条得意红，飘落忽西东。",
        "分逐春风去，风回得故丛。",
        "明朝金井露，始看忆春风。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 276888,
      "title": "凤",
      "content": [
        "万里峰峦归路迷，未判容彩借山鸡。",
        "新春定有将雏乐，阿阁华池两处栖。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276889,
      "title": "昭肃皇帝挽歌辞三首 一",
      "content": [
        "九县怀雄武，三灵仰睿文。",
        "周王传叔父，汉后重神君。",
        "玉律朝惊露，金茎夜切云。",
        "笳箫凄欲断，无复咏横汾。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 276890,
      "title": "昭肃皇帝挽歌辞三首 二",
      "content": [
        "玉塞惊宵柝，金桥罢举烽。",
        "始巢阿阁凤，旋驾鼎湖龙。",
        "门咽通神鼓，楼凝警夜钟。",
        "小臣观吉从，犹误欲东封。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 276891,
      "title": "昭肃皇帝挽歌辞三首 三",
      "content": [
        "莫验昭华琯，虚传甲帐神。",
        "海迷求药使，雪隔献桃人。",
        "桂寝青云断，松扉白露新。",
        "万方同象鸟，举恸满秋尘。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 276892,
      "title": "梓州罢吟寄同舍",
      "content": [
        "不拣花朝与雪朝，五年从事霍嫖姚。",
        "君缘接座交珠履，我为分行近翠翘。",
        "楚雨含情皆有托，漳滨卧病竟无憀。",
        "长吟远下燕台去，惟有衣香染未销。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276893,
      "title": "无题二首 一",
      "content": [
        "凤尾香罗薄几重，碧文圆顶夜深缝。",
        "扇裁月魄羞难掩，车走雷声语未通。",
        "曾是寂寥金烬暗，断无消息石榴红。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 276894,
      "title": "无题二首 二",
      "content": [
        "重帷深下莫愁堂，卧后清宵细细长。",
        "神女生涯原是梦，小姑居处本无郎。",
        "风波不信菱枝弱，月露谁教桂叶香。",
        "直道相思了无益，未妨惆怅是清狂。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276895,
      "title": "病中早访招国李十将军遇挈家游曲江",
      "content": [
        "十顷平波溢岸清，病来惟梦此中行。",
        "相如未是真消渴，犹放沱江过锦城。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276896,
      "title": "昨日",
      "content": [
        "昨日紫姑神去也，今朝青鸟使来赊。",
        "未容言语还分散，少得团圆足怨嗟。",
        "二八月轮蟾影破，十三弦柱雁行斜。",
        "平明钟后更何事，笑倚墙边梅树花。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276897,
      "title": "樱桃花下",
      "content": [
        "流鸎舞蝶两相欺，不取花芳正结时。",
        "他日未开今日谢，嘉辰长短是参差。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276898,
      "title": "故驿迎吊故桂府常侍有感",
      "content": [
        "饥乌翻树晚鸡啼，泣过秋原没马泥。",
        "二纪征南恩与旧，此时丹旐玉山西。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276899,
      "title": "槿花",
      "content": [
        "风露凄凄秋景繁，可怜荣落在朝昏。",
        "未央宫里三千女，但保红颜莫保恩。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276900,
      "title": "暮秋独游曲江",
      "content": [
        "荷叶生时春恨生，荷叶枯时秋恨成。",
        "深知身在情长在，怅望江头江水声。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276901,
      "title": "任弘农尉献州刺史乞假还京",
      "content": [
        "黄昏封印点刑徒，愧负荆山入座隅。",
        "却羡卞和双刖足，一生无复没阶趋。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276902,
      "title": "赠句芒神",
      "content": [
        "佳期不定春期赊，春物夭阏兴咨嗟。",
        "愿得句芒索青女，不教容易损年华。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276903,
      "title": "无愁果有愁曲北齐歌",
      "content": [
        "东有青龙西白虎，中含福星包世度。",
        "玉壶渭水笑清潭，凿天不到牵牛处。",
        "骐驎踏云天马狞，牛山撼碎珊瑚声。",
        "秋娥点滴不成泪，十二玉楼无故钉。",
        "推烟唾月抛千里，十番红桐一行死。",
        "白杨别屋鬼迷人，空留暗记如蚕纸。",
        "日暮向风牵短丝，血凝血散今谁是。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 276904,
      "title": "房中曲",
      "content": [
        "蔷薇泣幽素，翠带花钱小。",
        "娇郎痴若云，抱日西帘晓。",
        "枕是龙宫石，割得秋波色。",
        "玉簟失柔肤，但见蒙罗碧。",
        "忆得前年春，未语含悲辛。",
        "归来已不见，锦瑟长于人。",
        "今日涧底松，明日山头檗。",
        "愁到天池翻，相看不相识。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 276905,
      "title": "齐梁晴云",
      "content": [
        "缓逐烟波起，如妬柳緜飘。",
        "故临飞阁度，欲入回陂销。",
        "萦歌怜画扇，敞景弄柔条。",
        "更奈天南位，牛渚宿残宵。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276906,
      "title": "效徐陵体赠更衣",
      "content": [
        "密帐真珠络，温帏翡翠装。",
        "楚腰知便宠，宫眉正鬬强。",
        "结带悬栀子，绣领刺鸳鸯。",
        "轻寒衣省夜，金斗熨沉香。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 276907,
      "title": "又效江南曲",
      "content": [
        "郎船安两桨，侬舸动双桡。",
        "扫黛开宫额，裁裙约楚腰。",
        "乖期方积思，临酒欲拌娇。",
        "莫以采菱唱，欲羡秦台箫。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 276908,
      "title": "月夜重寄宋华阳姊妹",
      "content": [
        "偷桃窃药事难兼，十二城中锁彩蟾。",
        "应共三英同夜赏，玉楼仍是水精帘。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276909,
      "title": "访人不遇留别馆",
      "content": [
        "卿卿不惜锁窗春，去作长楸走马身。",
        "闲倚绣帘吹柳絮，日高深院断无人。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276910,
      "title": "雨中长乐水馆送赵十五滂不及",
      "content": [
        "碧云东去雨云西，苑路高高驿路低。",
        "秋水绿芜终尽分，夫君太骋锦障泥。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 276911,
      "title": "汴上送李郢之苏州",
      "content": [
        "人高诗苦滞夷门，万里梁王有旧园。",
        "烟幌自应怜白纻，月楼谁伴咏黄昏。",
        "露桃涂颊依苔井，风柳夸腰住水村。",
        "苏小小坟今在否，紫兰香径与招魂。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276912,
      "title": "赠郑谠处士",
      "content": [
        "浪迹江湖白发新，浮云一片是吾身。",
        "寒归山观随碁局，暖入汀洲逐钓轮。",
        "越桂留烹张翰鲙，蜀姜供煮陆机莼。",
        "相逢一笑怜疎放，他日扁舟有故人。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276913,
      "title": "复至裴明府所居",
      "content": [
        "伊人卜筑自幽深，桂巷杉篱不可寻。",
        "柱上雕虫对书字，槽中瘦马仰听琴。",
        "求之流辈岂易得，行矣关山方独吟。",
        "赊取松醪一斗酒，与君相伴洒烦襟。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276914,
      "title": "览古",
      "content": [
        "莫恃金汤忽太平，草间霜露古今情。",
        "空糊頳坏真何益，欲举黄旗竟未成。",
        "长乐瓦飞随水逝，景阳钟堕失天明。",
        "回头一吊箕山客，始信逃尧不为名。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276915,
      "title": "子初郊墅",
      "content": [
        "看山对酒君思我，听鼓离城我访君。",
        "腊雪已添墙下水，斋钟不散槛前云。",
        "阴移竹柏浓还淡，歌杂渔樵断更闻。",
        "亦拟村南买烟舍，子孙相约事耕耘。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276916,
      "title": "汉南书事",
      "content": [
        "西师万众几时回，哀痛天书近已裁。",
        "文吏何曾重刀笔，将军犹自舞轮台。",
        "几时拓土成王道，从古穷兵是祸胎。",
        "陛下好生千万寿，玉楼长御白云杯。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276917,
      "title": "当句有对",
      "content": [
        "密迩平阳接上兰，秦楼鸳瓦汉宫盘。",
        "池光不定花光乱，日气初涵露气干。",
        "但觉游蜂饶舞蝶，岂知孤凤忆离鸾。",
        "三星自转三山远，紫府程遥碧落宽。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276918,
      "title": "井络",
      "content": [
        "井络天彭一掌中，漫夸天设劒为峰。",
        "阵图东聚燕江石，边柝西悬雪岭松。",
        "堪叹故君成杜宇，可能先主是真龙。",
        "将来为报奸雄辈，莫向金牛访旧踪。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 276919,
      "title": "写意",
      "content": [
        "燕雁迢迢隔上林，高秋望断正长吟。",
        "人间路有潼江险，天外山惟玉垒深。",
        "日向花间留返照，云从城上结层阴。",
        "三年已制思乡泪，更入新年恐不禁。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    }
  ],
