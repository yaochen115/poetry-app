{
  "data": [
    {
      "id": 248984,
      "title": "为张四明作",
      "content": [
        "一生所闻张仲蔚，闭门蓬蒿深几尺。",
        "迩来伐竹声丁丁，手披榛丛待三益。",
        "径中踏破苍苔色，定是幽人芒屦迹。",
        "莫将车边两轮赤，夺此千竿一池碧。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 248985,
      "title": "冯县丞墨花",
      "content": [
        "君持松煤与研滴，惨澹不言生百物。",
        "胸中自无俗子韵，落笔乃有此气骨。",
        "江梅正尔不施丹，为我拂拭为清寒。",
        "一枝早晚到窗几，定作月影横斜看。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 248986,
      "title": "钱生遗笻竹斑杖戏作",
      "content": [
        "笻山美竹天下闻，有客钱氏之礽云。",
        "自言吾祖嫌杖晚，赠子九节斑烂文。",
        "寻幽已得济胜具，傍险更策扶危勋。",
        "同行安用木上座，一日不可无此君。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 248987,
      "title": "夏初示儿曹",
      "content": [
        "鸟声四合阴扶疏，江湖散人拜赐初。",
        "此君之子才堕地，一一文采如於菟。",
        "相看又作故时面，乃是秋风箧中扇。",
        "寸阴尺璧定何如，付与尔曹分贵贱。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 248988,
      "title": "玩鸥亭",
      "content": [
        "乃翁独步辞云间，五花判罢游金銮。",
        "甘泉颇劳侍从事，夜直必梦江湖寛。",
        "晚遭忌刻泛湘水，众为不乐公欣欢。",
        "白鸥无数没浩荡，相亲相近俄相安。",
        "何曾一旦舞不下，始信前事盟未寒。",
        "文章炳蔚冠当代，衣被诸子犹班班。",
        "携持扁牓向阳羡，往日风味追令还。",
        "乃翁闲散莫浪许，乃翁青紫当拾取。",
        "回施佳名与老夫，长共群鸥卧烟雨。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 248989,
      "title": "独青亭",
      "content": [
        "霜落水痕风落木，翠盖倚天惟汝独。",
        "是谁手种百年余，荫此空庭一株足。",
        "岁寒不但色青青，上有垂丝下茯苓。",
        "松根老僧应取此，制人颓龄起人死。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 248990,
      "title": "题寿樟亭",
      "content": [
        "大屋连甍小容足，栋宇以来非一木。",
        "豫章不是十围樗，受命于天何得独。",
        "君莫厌老大蓬蒿间，应龙虹梁果非福。",
        "虚堂昼静闻丁丁，溜雨枯皮在空谷。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 248991,
      "title": "蚊蝇扰甚戏作",
      "content": [
        "黑衣小儿雨打窗，斑衣小儿雷殷床。",
        "良宵永昼作底用，只与二子更飞扬。",
        "开尊匕箸须一洗，破卷灯火尤相妨。",
        "从来所持白羽扇，自许百万犹能当。",
        "安知手腕为汝脱，以小喻大真成狂。",
        "挥之使去定无策，葛帐十幅眠空堂。",
        "朝喧暮哄姑听汝，坐待九月飞严霜。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 248992,
      "title": "同郑禹功登巾子山",
      "content": [
        "天台雁荡天下奇，岂不欲往官缚之。",
        "巾山只在郡南郭，曾未著眼真成痴。",
        "今晨排遣簿书了，往赴郑老同幽期。",
        "羊肠转尽得兰若，飞鸟不到云雨垂。",
        "青铜镜外翠屏遶，中有万屋鱼鳞差。",
        "古来二事不兼得，此地一览俱无遗。",
        "蓬莱方丈果何许，云驾飇驭知为谁。",
        "赤城风月幸好戏，驱取鸾鳯相追随。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 248993,
      "title": "立春",
      "content": [
        "十载东都客，春盘种种春。",
        "翠看蔬甲小，黄爱韭苗新。",
        "流落成吾老，萧疏对此辰。",
        "睦隣如有使，传语大梁人。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 248994,
      "title": "春日二首  其一",
      "content": [
        "今日知何日，东风破腊来。",
        "寒随边骑去，春与汉军回。",
        "彩胜参差翦，蔬盘饤饾开。",
        "不妨时节好，年事岂禁催。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 248995,
      "title": "春日二首  其二",
      "content": [
        "期颐三万日，政尔亦无多。",
        "佳节已如许，衰年将若何。",
        "雨风增落寞，戚友断经过。",
        "问讯庖厨内，犹堪一洗磨。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 248996,
      "title": "春日即事次韵",
      "content": [
        "秾李花如许，殊胜灼灼红。",
        "只言开似雪，不道去随风。",
        "胜日从吾党，衰年念此翁。",
        "诗情犹可强，杯勺不能同。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 248997,
      "title": "雨二首  其一",
      "content": [
        "秋冬久不雨，气浊喜云生。",
        "麦陇崇朝润，茅檐彻夜声。",
        "初来断幽径，渐密杂疏更。",
        "赖有墙阴荠，离离已可烹。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 248998,
      "title": "雨二首  其二",
      "content": [
        "薄晚初霑洒，清晨更惨凄。",
        "鱼寒抛饵去，鸦湿就簷栖。",
        "幽涧溅溅溜，长堤浅浅泥。",
        "一杯持自贺，吾事在锄犁。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 248999,
      "title": "夕雨",
      "content": [
        "屣履行莎径，移床卧草亭。",
        "风声杂溪濑，雨气挟龙腥。",
        "烨烨空中电，昏昏云罅星。",
        "徂年又如许，吾鬓得长青。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 249000,
      "title": "雨夜",
      "content": [
        "一雨遂通夕，安眠失百忧。",
        "窗扉淡欲晓，枕簟冷生秋。",
        "画烛争棋道，金尊数酒筹。",
        "依然锦城梦，忘却在南州。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 249001,
      "title": "仲夏细雨",
      "content": [
        "霡霂无人见，芭蕉报客闻。",
        "润能添砚滴，细欲乱炉薫。",
        "竹树惊秋半，衾裯惬夜分。",
        "何当一倾倒，趁取未归云。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 249002,
      "title": "悯雨",
      "content": [
        "梅子黄初徧，秧针绿未抽。",
        "若无三日雨，那复一年秋。",
        "薄晚看天意，今宵破客愁。",
        "不眠听竹树，还有好音不。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 249003,
      "title": "郡中迎怀玉山应真请雨得之未沾足",
      "content": [
        "悯雨连三月，为霖抵万金。",
        "小垂开士手，足慰老农心。",
        "果欲千仓积，犹须一尺深。",
        "病夫浑不寝，危坐听佳音。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 249004,
      "title": "苏秀道中大雨",
      "content": [
        "梅雨又时雨，苏州仍秀州。",
        "客行无六月，农事有三秋。",
        "云气深鸿雁，烟波没白鸥。",
        "衰年惭愧汝，物役几时休。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 249006,
      "title": "久雨",
      "content": [
        "荒院已无趣，愁霖终不开。",
        "簷声喧客语，屋漏逐人来。",
        "桥报今朝断，墙闻昨夜摧。",
        "尚余汤饼具，积潦未为灾。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 249007,
      "title": "久雨有怀曾宏甫",
      "content": [
        "欲访溪山老，无如此雨何。",
        "一春判弃置，十日断经过。",
        "灯火相看放，莺花即渐多。",
        "晴暄如有意，数数上南坡。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 249008,
      "title": "苦雨",
      "content": [
        "尽道迎梅雨，能无一日晴。",
        "窗昏愁细字，簷暗乱疏更。",
        "未怪蛙争席，真忧水冒城。",
        "何由收积潦，箫鼔赛西成。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 249009,
      "title": "大暑",
      "content": [
        "赤日几时过，清风无处寻。",
        "经书聊枕籍，瓜李漫浮沈。",
        "兰若静复静，茅茨深又深。",
        "炎蒸乃如许，那更惜分阴。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 249010,
      "title": "谢人送壑源绝品云九重所赐也",
      "content": [
        "三伏汗如雨，终朝沾我裳。",
        "谁分金掌露，来作玉溪凉。",
        "别甑輭炊饭，小炉深炷香。",
        "曲生何等物，不与汝同乡。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 249011,
      "title": "大热欲过广寿寺谒韩子苍追凉先之以诗",
      "content": [
        "执热今如此，追凉定若何。",
        "长廊受风远，广殿得阴多。",
        "盛欲扶笻去，还能下榻么。",
        "近公如玉雪，未厌数经过。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 249012,
      "title": "病中闻莺啼",
      "content": [
        "独园森古木，其下客幽栖。",
        "尽日绿阴合，有时黄鸟啼。",
        "一声添昼寂，百啭使人迷。",
        "赖汝生佳听，身今气惨凄。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 249013,
      "title": "病起赠曾宏甫",
      "content": [
        "同病仍同起，无聊独至今。",
        "酒杯君入手，药裹我关心。",
        "极暑方无奈，新凉又不禁。",
        "呼儿锄径草，万一故人临。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 249014,
      "title": "蛱蝶",
      "content": [
        "不逐春风去，仍当夏日长。",
        "一双还一只，能白或能黄。",
        "恋恋不能已，翩翩空自狂。",
        "讣功归实用，终自愧蜂房。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 249015,
      "title": "萤火",
      "content": [
        "浑忘生朽质，直拟慕光辉。",
        "解烛书帷静，能添列宿稀。",
        "当风方自表，带雨忽成微。",
        "变灭多无理，荣枯会一归。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 249016,
      "title": "读书",
      "content": [
        "散帙有佳趣，俗人那得知。",
        "醉乡非为酒，坐隐不关棋。",
        "几净幽怀惬，窗明老眼宜。",
        "一生无用处，又把教群儿。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 249017,
      "title": "乞笔",
      "content": [
        "市上无佳笔，营求亦已劳。",
        "护持空雪竹，束缚欠霜毫。",
        "此物藏三穴，须公拔一毛。",
        "不堪髯主簿，取用价能高。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 249018,
      "title": "题双岩堂",
      "content": [
        "老子徜徉地，岩幽想像间。",
        "绿阴城角路，青嶂屋头山。",
        "簿领惟生睡，壶觞不解颜。",
        "使人留眼处，龛壁字回环。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 249019,
      "title": "泉石堂",
      "content": [
        "南坡佳绝处，夏木昼成阴。",
        "青壁可对面，寒泉能醒心。",
        "驾言同胜践，晤语契幽襟。",
        "野兴何曾尽，林间栖暮禽。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 249020,
      "title": "坐进堂",
      "content": [
        "茅宇净扫地，竹炉深炷香。",
        "一枝藤倚壁，六尺簟敷床。",
        "门掩人声寂，帘垂昼景长。",
        "跏趺便终夕，端不负兹堂。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 249021,
      "title": "参云亭晚坐",
      "content": [
        "大暑不可避，微凉安所寻。",
        "云霄非浊世，竹树有清阴。",
        "海近风先集，山高日易沈。",
        "无因见明月，萤火乱更深。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 249022,
      "title": "龙溪新亭",
      "content": [
        "不识梯山路，今闻驾壑桥。",
        "蛟龙深窟宅，松竹半云霄。",
        "与子成二老，由来非一朝。",
        "崖藤如暂寄，还往肯辞遥。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 249023,
      "title": "雪中次韵",
      "content": [
        "积雪何所待，冻云终未开。",
        "有时闻泻竹，无路去寻梅。",
        "只欲关门卧，谁能荡桨来。",
        "辟寒须底物，正乏曲生才。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 249024,
      "title": "负暄",
      "content": [
        "炙背茅簷日，虽贫办不难。",
        "赵衰真可爱，范叔一何寒。",
        "虱暖无遗索，书明得细看。",
        "羲和有底急，薄暮更衣单。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 249025,
      "title": "次韵三首  其一",
      "content": [
        "白日无偏照，玄冥不作难。",
        "有炉如许大，无地可言寒。",
        "书腹夤缘晒，禅心邂逅看。",
        "呼儿来共此，形影未孤单。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 249026,
      "title": "次韵三首  其二",
      "content": [
        "御冬无过酒，得酒政应难。",
        "可爱惟晴日，相依度歳寒。",
        "虽非挟纩坐，且作拥炉看。",
        "饥亦何堪忍，斜阳挂食单。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 249027,
      "title": "次韵三首  其三",
      "content": [
        "凿土篝松火，为炉有底难。",
        "未知行地日，可辟中人寒。",
        "气味醇醪似，光阴尺璧看。",
        "回头长夏景，直欲褫中单。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 249028,
      "title": "晁园",
      "content": [
        "晁氏芳菲圃，因依渌水浔。",
        "峰峦春著色，桃李昼成阴。",
        "可惜花狼籍，仍遭雨滞淫。",
        "饶阳供客眼，只有此园林。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 249029,
      "title": "次朱新仲待制见庆次对之命韵",
      "content": [
        "典郡才能薄，趋朝气力微。",
        "更堪持橐去，只合挂冠归。",
        "六合丽千尺，四松森百围。",
        "公今有班缀，衰老借余辉。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 249030,
      "title": "次刘千歳喜折仲古见过二首韵  其一",
      "content": [
        "新知刘子政，生理发萧疏。",
        "胜日归谈笑，佳山奉起居。",
        "摩挲千古物，料理一床书。",
        "秀色堪餐否，聊须摘我蔬。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 249031,
      "title": "次刘千歳喜折仲古见过二首韵  其二",
      "content": [
        "门对分流水，窗横别岸山。",
        "茅茨居不翦，蓬荜昼常关。",
        "倾盖曾三径，摇旌每数间。",
        "犹欣龙阁老，携得好诗还。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 249032,
      "title": "次曾宏甫见过二首韵  其一",
      "content": [
        "客有过兰若，交情似竹林。",
        "野花无可落，村酒不宜斟。",
        "又得清新句，如闻謦欬音。",
        "南坡盟好在，为问几时寻。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 249033,
      "title": "次曾宏甫见过二首韵  其二",
      "content": [
        "莺啼花落后，芳草绿阴初。",
        "良会日不足，清谈风有余。",
        "饥餐聊当肉，嬾出坐无车。",
        "勿以贫兼病，相过迹也疏。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 249034,
      "title": "次镇江守曾宏甫见寄韵",
      "content": [
        "一别高明去，频为瘴疠侵。",
        "连沧公境界，横碧我山林。",
        "夜雨思同梦，秋风辱寄音。",
        "他年如衣锦，毕世莫分襟。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 249035,
      "title": "次曾宏甫见寄韵  其一",
      "content": [
        "今晨尺书至，令我寸心寛。",
        "老去光阴速，人生会合难。",
        "竹舆云洞暖，钓艇玉溪寒。",
        "小憩饶阳否，吾衰合挂冠。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 249036,
      "title": "次曾宏甫见寄韵  其二",
      "content": [
        "剖符舒子国，蜡屐皖公台。",
        "恨不从山简，欣然见老莱。",
        "功名身已老，交旧首空回。",
        "早晚依刘去，朝廷不乏材。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 249037,
      "title": "又二首  其一",
      "content": [
        "一纸寝丘书，僧窗屡卷舒。",
        "无因浮左蠡，况复度匡庐。",
        "政以相望远，非关自作疏。",
        "梦成飞鸟去，千里不踌躇。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 249038,
      "title": "又二首  其二",
      "content": [
        "政喜溪南宅，还乘剡县船。",
        "归来知底日，老去惜余年。",
        "觞咏虽休矣，音书未寂然。",
        "省郎君旧物，消息已真传。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 249039,
      "title": "次曾宏甫赴光守留别二首韵  其一",
      "content": [
        "听说光州好，淮山是四隣。",
        "凝香无一事，奠枕有余民。",
        "世以文章著，朝须宠数频。",
        "西湖便归去，应不待班春。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 249040,
      "title": "次曾宏甫赴光守留别二首韵  其二",
      "content": [
        "淮白美无度，山丹开欲然。",
        "谈夸空海内，怅望只溪边。",
        "老境嗟无几，宗盟幸有连。",
        "到时能走送，别后见相怜。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 249041,
      "title": "五月六日为丛珍之集于南池呈座中诸公",
      "content": [
        "今日携壶地，南池信杖行。",
        "红蕖争入眼，白鹭最关情。",
        "待得跳珠雨，来听打叶声。",
        "菰蒲最深处，只欠小舟横。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 249042,
      "title": "公廨莲池",
      "content": [
        "浪说吾邦小，清池思有余。",
        "水风凉枕簟，荷气馥衣裾。",
        "客位经过少，官曹簿领疏。",
        "良辰不行乐，秋水落芙蕖。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 249043,
      "title": "题方氏清芬阁用范文正公韵",
      "content": [
        "胜绝登临地，桐江占十分。",
        "省郎才不世，御史气如云。",
        "遂使芝兰秀，俱能锦绣文。",
        "诸孙又如许，百代有清芬。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 249044,
      "title": "效诸生作雪中探梅",
      "content": [
        "野梅消息近，踏冷访林端。",
        "东阁尊空满，南枝雪半残。",
        "疏条未禁笑，真态欲欺寒。",
        "后夜花应好，仍勤束火看。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 249045,
      "title": "岭梅",
      "content": [
        "蛮烟无处洗，梅蕊不胜清。",
        "顾我已头白，见渠犹眼明。",
        "折来知韵胜，落去得愁生。",
        "坐久江南梦，园林雪正晴。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 249046,
      "title": "岩桂二首  其一",
      "content": [
        "擢本千岩秀，开花八月凉。",
        "虽非倾国色，要是恼人香。",
        "篱下菊清好，林间兰静芳。",
        "可怜遭遇晚，妙语欠苏黄。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 249047,
      "title": "岩桂二首  其二",
      "content": [
        "栗玉黏枝细，青云翦叶齐。",
        "团团岩下桂，表表木中犀。",
        "江树风萧瑟，园花气惨凄。",
        "浓薫不如此，何以慰幽栖。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 249048,
      "title": "种竹",
      "content": [
        "近郊蕃竹树，手种满庭隅。",
        "余子不足数，此君何可无。",
        "风来当一笑，雪压要相扶。",
        "莫作封侯相，生来鄙木奴。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 249049,
      "title": "二儿次韵予亦复次韵二首  其一",
      "content": [
        "此君今日醉，不复记方隅。",
        "窈窕因吾有，恢台到尔无。",
        "青犹须雨沐，直不要人扶。",
        "旁舍连高柳，何堪与作奴。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 249050,
      "title": "二儿次韵予亦复次韵二首  其二",
      "content": [
        "幽居有忙事，为竹遶墙隅。",
        "雨后青葱否，风前安稳无。",
        "井深时汲引，架倒复持扶。",
        "只欠江梅树，君应壻玉奴。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 249051,
      "title": "新种竹有笋",
      "content": [
        "此君非俗物，今歳有佳儿。",
        "径密无人见，僧来报客知。",
        "西家应满地，上番欲横枝。",
        "添得清声未，君听风雨时。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 249052,
      "title": "竹轩出笋",
      "content": [
        "问讯东轩竹，新萌颇不齐。",
        "文章藏雾豹，头角触藩羝。",
        "逸气先腾上，长鞭半落西。",
        "后来堪底用，采掇付山妻。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 249053,
      "title": "似贤斋竹",
      "content": [
        "大暑不可度，小轩聊复开。",
        "只消看竹坐，不必要风来。",
        "岂待迷时种，何妨腊月栽。",
        "叶端须雨打，有句索渠催。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 249054,
      "title": "所种竹鞭盛行",
      "content": [
        "独遶筼筜径，令人喜欲颠。",
        "已持苏老节，更著祖生鞭。",
        "傍舍应除地，新梢拟上天。",
        "真成时夜卵，煨茁想明年。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 249055,
      "title": "逮子作亭于官舍明清堂后种竹殆千竿余名其亭以留客取老杜竹深留客处之句因题二小诗云  其一",
      "content": [
        "行到竹穷处，有亭佳可游。",
        "境因吾子胜，客为此君留。",
        "娟净经时雨，萧梢六月秋。",
        "岂无他草树，泾渭不同流。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 249056,
      "title": "逮子作亭于官舍明清堂后种竹殆千竿余名其亭以留客取老杜竹深留客处之句因题二小诗云  其二",
      "content": [
        "种竹无他事，林间与客游。",
        "自应携手入，安用闭门留。",
        "静可过僧夏，清宜对奕秋。",
        "衰翁九节杖，来往亦风流。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 249057,
      "title": "代书抵筠守谭崧老求茶笋",
      "content": [
        "问讯江南美，人推道院州。",
        "雨前收雀舌，雪底荐猫头。",
        "有客同僧过，频年遣仆求。",
        "故交今五马，解送老庞不。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 249058,
      "title": "南归题扬州竹西亭",
      "content": [
        "往歳出芜城，飘然一客星。",
        "又从江北路，重到竹西亭。",
        "楚岸寛围碧，吴山远借青。",
        "圣时还旧观，歌吹月中听。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 249059,
      "title": "登扬州郡圃小金山遥碧亭",
      "content": [
        "绝岛浸中零，飞来枣叶轻。",
        "碧天围斗野，红日下芜城。",
        "山作修眉翠，人添老眼明。",
        "园林多胜地，独爱小峥嵘。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 249060,
      "title": "高邮无梅花求之于扬帅邓直阁",
      "content": [
        "送腊腊垂尽，迎春春欲回。",
        "如何万家县，不见一枝梅。",
        "有客幽寻去，无人远寄来。",
        "扬州何逊在，政用小诗催。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 249061,
      "title": "邓帅寄梅并山堂酒",
      "content": [
        "甓社湖边路，诗筒得报回。",
        "旧时云液酒，新歳雨肥梅。",
        "不是园官送，真成驿使来。",
        "鬓毛都白尽，更著此花催。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 249062,
      "title": "谒径山佛日杲禅师于虎丘",
      "content": [
        "此老云相似，何天不往还。",
        "打包龙井寺，持钵虎丘山。",
        "一别经年事，相逢半日间。",
        "向来参底语，不堕有无间。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 249063,
      "title": "游虎丘寺",
      "content": [
        "重游吴子国，又入虎丘山。",
        "长日挽人住，好风将我还。",
        "儿童陪胜践，长老记衰颜。",
        "无复尹和靖，西庵空掩关。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 249064,
      "title": "留别荣茂实侍郎",
      "content": [
        "老为吴会客，耆旧不相忘。",
        "政以牛马走，曾陪鹓鹭行。",
        "千年书穴在，六月镜湖凉。",
        "从此登临地，回头忆侍郎。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 249065,
      "title": "寓广教僧寺",
      "content": [
        "似病元非病，求闲方得闲。",
        "残僧六七辈，败屋两三间。",
        "野外无供给，城中断往还。",
        "同参木上座，与汝住茶山。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 249066,
      "title": "岳麓寺",
      "content": [
        "岳麓知名寺，幽寻到眼边。",
        "林深不见日，山静只闻泉。",
        "便欲呼舟去，聊为借榻眠。",
        "明朝游历处，都在小窗前。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 249067,
      "title": "岭外出巡",
      "content": [
        "岭外身逾老，江南首重回。",
        "有猿啼梦破，无雁寄书来。",
        "山雨晴犹湿，蛮烟昼不开。",
        "如何缘许事，夺我手中杯。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 249068,
      "title": "南雄郡守致怪石四株",
      "content": [
        "只道无南雁，书今数往还。",
        "一窗江表地，数朵广东山。",
        "奇甚君风骨，苍然我面颜。",
        "归时要船重，更为𣃁岩间。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 249069,
      "title": "何德器寄道州怪石",
      "content": [
        "一去春陵郡，天星几度回。",
        "身今镜湖住，山自道州来。",
        "指点双岩出，摩挲一笑开。",
        "是谁营致此，石友似陈雷。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 249070,
      "title": "太湖石",
      "content": [
        "谁怜孤峭质，移在太湖心。",
        "出得风波外，任他池馆深。",
        "不同花逞艳，多愧竹垂阴。",
        "一片至坚操，那忧歳月侵。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 249071,
      "title": "怪石",
      "content": [
        "济胜初无具，搜奇只此间。",
        "飞来太湖石，坐我洞庭山。",
        "面面成窗户，峰峰出髻鬟。",
        "寓居端欠此，颇欲载之还。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 249072,
      "title": "闻寇至初去柳州",
      "content": [
        "剥啄谁敲户，仓皇客抱衾。",
        "只看人似蚁，共道贼如林。",
        "两岸论千里，扁舟抵万金。",
        "病夫桑下恋，万一有佳音。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 249073,
      "title": "闻寇退欲还柳州寄柳守常子正",
      "content": [
        "旧隐龙城在，书传喜可知。",
        "还来避地客，已去弄兵儿。",
        "瘴色休看镜，行期不问龟。",
        "中秋一杯酒，定与故人持。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 249074,
      "title": "大藤峡",
      "content": [
        "一洗干戈眼，舟穿乱石间。",
        "不因深避地，何得饱看山。",
        "江溃重围急，天横一线悭。",
        "人言三峡险，此路足追攀。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 249075,
      "title": "归途",
      "content": [
        "归途似乌鹊，得树且依栖。",
        "一寸客亭烛，数声村舍鸡。",
        "路长风正北，野旷日沈西。",
        "梦作祠官去，江干入马蹄。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 249076,
      "title": "自广西归上饶阅所藏书",
      "content": [
        "久矣山人去，怀哉屋壁藏。",
        "侵陵阅梅雨，调护乏芸香。",
        "次第繙经集，呼儿理在亡。",
        "乞归全为此，何爱橐中装。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 249077,
      "title": "初还信州呈寓居诸公",
      "content": [
        "万事不称意，一生长损心。",
        "稍知闲有味，又觉老相侵。",
        "田舍那能问，溪山未暇寻。",
        "清歌一杯酒，聊与故人斟。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 249078,
      "title": "吕郎治先以职事至常山县不敢越境以书致两郡酒日铸茶",
      "content": [
        "子到常山县，饶阳有敝庐。",
        "相望百里地，空得数行书。",
        "睡思茶料理，愁怀酒破除。",
        "新秋即在眼，过我定何如。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 249079,
      "title": "迪侄屡饷新茶二首  其一",
      "content": [
        "吾家今小阮，有使附书频。",
        "唤起南柯梦，持来北苑春。",
        "顾余多下驷，况复似陈人。",
        "不是能分少，其谁遣食新。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 249080,
      "title": "迪侄屡饷新茶二首  其二",
      "content": [
        "敕厨羞煮饼，扫地供炉芬。",
        "汤鼎聊从事，茶瓯遂策勋。",
        "兴来吾不浅，送似汝良勤。",
        "欲作柯山点，当令阿造分。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 249081,
      "title": "造侄寄建茶",
      "content": [
        "汝已去闽岭，茶酒犹粲然。",
        "买应从聚处，寄不下常年。",
        "洗涤卢仝椀，提携陆羽泉。",
        "无人分得好，更忆仲容贤。"
      ],
      "author": {
        "id": 3192,
        "name": "曾几"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 249082,
      "title": "述侄饷日铸茶",
      "content": [
        "宝胯自不乏，山芽安可无。",
        "子能来日铸，吾得具风炉。",
        "夏木啭黄鸟，僧窗行白驹。",
        "谈多转生睡，此味正时须。"
      ],
