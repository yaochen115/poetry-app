{
  "data": [
    {
      "id": 159393,
      "title": "黄帝洞庭张乐图",
      "content": [
        "天水相涵万象清，咸池真乐妙无根。",
        "大音岂在九霄外，有意听时却不闻。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159394,
      "title": "尧民击壤图",
      "content": [
        "百姓相忘尧帝春，耕田凿井淡无情。",
        "只今正是何年月，日日月从东向生。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159395,
      "title": "巢父洗耳图",
      "content": [
        "万事喧喧杂响中，细参巢父意无穷。",
        "须还半掬溪边水，方始教君耳不聋。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159396,
      "title": "许由弃瓢图",
      "content": [
        "天下摇头不肯为，恰如瓢挂老松枝。",
        "许由不在箕山在，千古高风属阿谁。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159397,
      "title": "吕望垂钓图",
      "content": [
        "八十翁翁心尚孩，渭滨痴坐弄徘徊。",
        "当初若是逃名者，谁要文王上钓来。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159398,
      "title": "夷齐西山图",
      "content": [
        "扣马痴心谏不休，既拚一死百无忧。",
        "因何留得首阳在，只说商家不说周。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159399,
      "title": "老子度关图",
      "content": [
        "紫气东来压万山，老聃吐舌笑开颜。",
        "青牛车外天风阔，摇动当年函谷关。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159400,
      "title": "纪昌贯虱悟射图",
      "content": [
        "从来绝艺欲超伦，何止弯弓用意深。",
        "觑破微尘微极处，忽开大地见红心。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159401,
      "title": "钟子期听琴图",
      "content": [
        "一契高山流水心，形神空静两忘情。",
        "自非父母所生耳，听见伯牙声外声。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159402,
      "title": "伯牙绝弦图",
      "content": [
        "终不求人更赏音，只当仰面看山林。",
        "一双闲手无聊頼，满地斜阳是此心。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159403,
      "title": "荣启期三乐图",
      "content": [
        "生死悠悠付老天，启期三乐亦超然。",
        "此身不得为男子，空活人间九十年。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159404,
      "title": "伯乐相马图",
      "content": [
        "冀地群中不可留，如龙走地绝无俦。",
        "何劳伯乐一相顾，抹过西风数百州。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159405,
      "title": "庄子梦蝶图",
      "content": [
        "素来梦觉两俱空，开眼还如阖眼同。",
        "蝶是庄周周是蝶，百花无口骂春风。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159406,
      "title": "轮扁谏读书图",
      "content": [
        "轮扁释椎开口谏，国君据坐展书开。",
        "古人糟粕终枯淡，谁醉天然滋味来。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159407,
      "title": "卞和泣玉图",
      "content": [
        "大璞中函天地精，卞和抱出愈分明。",
        "一番刖足一番哭，哭杀世人无眼睛。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159408,
      "title": "宁戚饭牛图",
      "content": [
        "斯人岂是饭牛者，浩叹空怀扣角悲。",
        "说到漫漫长夜处，南山白石也攒眉。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159409,
      "title": "孺子濯缨图",
      "content": [
        "秋影澄澄湛碧波，濯缨人远意如何。",
        "临风歌罢飘然去，卖弄沧浪清处多。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159410,
      "title": "叶公画龙图",
      "content": [
        "神物难传变化时，叶公眼外泄天机。",
        "一从亲见真头角，满手风云雷电飞。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159411,
      "title": "孟尝君度关图",
      "content": [
        "狐白裘边事若难，孟尝门下亦何颜。",
        "若无意智翻身去，半夜焉能度此关。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159412,
      "title": "屈原九歌图",
      "content": [
        "楚人念念爱清湘，苦忆九歌频断肠。",
        "只道此中皆楚国，还于何处拜东皇。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159413,
      "title": "屈原餐菊图",
      "content": [
        "谁念三闾久陆沉，饱霜犹自傲秋深。",
        "年年吞吐说不得，一见黄花一苦心。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159414,
      "title": "范蠡扁舟图",
      "content": [
        "乌喙无情奈若何，功成只合理渔蓑。",
        "跃身吴越兴亡外，一舸江湖风月多。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159415,
      "title": "毛遂脱颖图",
      "content": [
        "十九人中不数君，当机勇辩独超群。",
        "若非末后脱颖出，多得英风泼楚云。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159416,
      "title": "鲁欹器图",
      "content": [
        "此心安分即逍遥，无欲何愁外境摇。",
        "才有秋毫失中正，一杯水亦不能消。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159417,
      "title": "列子窃𫓧图",
      "content": [
        "宇宙茫茫尽坦途，莫将得失自相辜。",
        "胸中若有一些子，大地山河俱窃𫓧。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159418,
      "title": "秋胡子图",
      "content": [
        "郎归犹未到家中，艳语勾春妾面红。",
        "叵耐相逢不相识，梅花那肯恋东风。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159419,
      "title": "西施捧心图",
      "content": [
        "荡尽吴王醉后春，化为颦笑艳精神。",
        "当胸一点痛得别，直是妖娆恼杀人。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159420,
      "title": "骊山老姥磨铁杵欲作绣针图",
      "content": [
        "欲化龟蛇生圣胎，骊山微意孰能猜。",
        "纯钢一块都磨尽，不信纤毫眼不开。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159421,
      "title": "秦女吹箫图",
      "content": [
        "弄玉飘飘仙女姿，凤凰低舞久相期。",
        "箫中应有别一曲，飞出青天影外吹。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159422,
      "title": "湘灵鼓瑟图",
      "content": [
        "雾质烟姿雪月心，凌波无迹似多情。",
        "试听谁在湘江上，仿佛秋风曲数声。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159423,
      "title": "毛女图",
      "content": [
        "六国倾城辇入秦，深花密柳鏁青春。",
        "神仙自有长生路，岂是阿房宫里人。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159424,
      "title": "徐福采药图",
      "content": [
        "仙药长生不易求，仙山可在海东头。",
        "祖龙灭尽诸侯后，徐福却来赢一筹。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159425,
      "title": "青门种瓜图",
      "content": [
        "百二山河势莫当，咸阳谁付与高皇。",
        "尽嫌嬴政鲍鱼臭，争慕邵平瓜圃香。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159426,
      "title": "汉高祖将韩信图",
      "content": [
        "先入关中得计多，彭城未是汉山河。",
        "不操擒纵英雄手，韩信何由肯倒戈。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159427,
      "title": "张子房遇黄石公图",
      "content": [
        "三度桥边伺老仙，始将兵法尽相传。",
        "不知蹑足此一计，还出书中第几篇。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159428,
      "title": "四皓图",
      "content": [
        "晔晔紫芝岩石隈，避秦有地似蓬莱。",
        "可怜白发坐不定，又被汉朝呼出来。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159429,
      "title": "周亚夫细柳营图",
      "content": [
        "细柳营中作略殊，宁容直入骤先驱。",
        "不因一见入门诀，文帝何曾识亚夫。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159430,
      "title": "李广射石虎图",
      "content": [
        "怪石蹲身草芥中，错疑猛虎喷腥风。",
        "何消重费将军力，只在当头一箭功。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159431,
      "title": "董仲舒不窥园图",
      "content": [
        "西汉诸儒君最醇，无人见面意应深。",
        "三年尽力窥经史，一旦看花了古今。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159432,
      "title": "苏武牧羊假寐图",
      "content": [
        "十九年间堕渺茫，饥来啮雪齿生香。",
        "一心只梦飞归国，双眼何曾看见羊。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159433,
      "title": "苏李泣别图",
      "content": [
        "同为武帝一时人，忠逆分违感慨深。",
        "早信子卿归汉去，泪痕滴滴滴黄金。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159434,
      "title": "司马相如题柱图",
      "content": [
        "初上升仙何慷慨，重来衣锦颇从容。",
        "男儿意气当如此，透过禹门方是龙。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159435,
      "title": "张骞乘槎图",
      "content": [
        "牛女宫中事若何，亲身曾得上天河。",
        "逢人莫说支机石，漏泄苍苍意已多。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159436,
      "title": "翟公交情图",
      "content": [
        "翟公冷语久逾新，汉世交情古亦今。",
        "不被死生贫贱转，此时方始见人心。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159437,
      "title": "朱买臣卖柴图",
      "content": [
        "年当五十始荣华，覆水难收重叹嗟。",
        "岂信后来春色别，满柴担上尽开花。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159438,
      "title": "二疏东门祖帐图",
      "content": [
        "昔日贤哉二大夫，东门祖帐耀通衢。",
        "太平时节独先去，阖国人知此意无。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159439,
      "title": "严君平垂帘卖卜图",
      "content": [
        "多是垂帘自养神，仅能了日即安贫。",
        "不离忠孝谈玄妙，岂是寻常卖卜人。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159440,
      "title": "皇初平牧羊图",
      "content": [
        "兄弟参商四十春，金华山里问斜曛。",
        "相逢不是牧羊客，白石颟顸冷笑君。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159441,
      "title": "西王母蟠桃宴图",
      "content": [
        "玄圃筵开物外春，万仙欢笑动精神。",
        "蟠桃种子今犹在，谁是三千年后人。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159442,
      "title": "严子陵垂钓图",
      "content": [
        "新莽纷纷未有涯，桐江山水颇为嘉。",
        "无心偶向一丝上，钓得清风满汉家。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159443,
      "title": "袁安卧雪图",
      "content": [
        "飞玉堆寒二丈过，杜门僵卧养天和。",
        "不愁屋外六花大，但觉胸中清气多。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159444,
      "title": "高凤读书漂麦图",
      "content": [
        "癖爱诗书苦未休，肯将俗事挂心头。",
        "等闲痛快语言外，那见雨来和麦流。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159445,
      "title": "张天师飞升图",
      "content": [
        "玉局曾经拜老君，子孙今尚宝玄文。",
        "要知龙虎山前意，但看空中数片云。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159446,
      "title": "王粲覆棋图",
      "content": [
        "鸦鹭争飞局局殊，便生国手亦难图。",
        "未曾落子有一著，王粲还能覆得无。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159447,
      "title": "先主三顾草庐图",
      "content": [
        "抱膝高吟梁父时，卧龙致雨未为迟。",
        "若无三顾草庐意，剖出心肝卖与谁。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159448,
      "title": "孔明出师表图",
      "content": [
        "一身英气射光芒，北定中原事转长。",
        "落得两篇出师表，至今只是汉文章。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159449,
      "title": "孔明成都八阵图",
      "content": [
        "孔明抱义耻偏安，不道中兴事业难。",
        "頼有石头知落处，任从人换八门看。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159450,
      "title": "王祥卧冰图",
      "content": [
        "母病杯羹意未谐，解衣竟欲卧冰开。",
        "有心直透清波下，安得无鱼跃出来。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159451,
      "title": "王衍举阿堵物图",
      "content": [
        "口不言钱早不同，何须相试苦相攻。",
        "今朝叱去阿堵物，一室玲珑分外空。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159452,
      "title": "竹林七贤图",
      "content": [
        "清谈何补晋江山，谁与中原了岁寒。",
        "惟有白云三四片，飞来自向古琅玕。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159453,
      "title": "王子猷看竹图",
      "content": [
        "秋沁徽之骨亦清，翠光如水漾空明。",
        "只图一见此君面，谁更问人闲姓名。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159454,
      "title": "王子猷访戴图",
      "content": [
        "雪夜怀人泛剡溪，造门而返是还非。",
        "不曾相见犹相见，满载清风独自归。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159455,
      "title": "阮籍醉眠酒家图",
      "content": [
        "少妇当垆应怪人，陶陶一觉了残更。",
        "无情不作如花想，梦见醉乡生月明。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159456,
      "title": "刘伶荷锸图",
      "content": [
        "酒国韶光无际涯，大人境界绝朋侪。",
        "生来自有一方地，何待醉终才始埋。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159457,
      "title": "戴安道破琴图",
      "content": [
        "独抱洋洋太古心，王门何苦欲相寻。",
        "狂来宁可破琴去，不许俗人闻此音。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159458,
      "title": "毕卓瓮间图",
      "content": [
        "醉玉颓来欲化仙，一漥和气蔼芳妍。",
        "终宵自向华胥去，吏部何曾瓮下眠。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159459,
      "title": "孙康映雪读书图",
      "content": [
        "孙康苦志惜居诸，雪夜无灯兴有余。",
        "冷地白光生破屋，自然开眼见诗书。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159460,
      "title": "张翰思莼鲈图",
      "content": [
        "名爵虽荣心最苦，莼鲈有味食无厌。",
        "后来京洛风尘暗，转觉吴淞江水甜。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159461,
      "title": "孙楚枕流潄石图",
      "content": [
        "孙楚匆匆误答时，说来颇与事相违。",
        "枕流潄石翻为妙，活弄胸中倒一机。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159462,
      "title": "庾亮登南楼图",
      "content": [
        "老子情怀颇滑稽，登楼恰喜月明时。",
        "虽然于此兴不浅，要且诸人知不知。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159463,
      "title": "周处除三害图",
      "content": [
        "一朝周处奋英豪，三害皆除岂惮劳。",
        "若是不能降自己，纵屠龙虎不为高。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159464,
      "title": "王羲之兰亭图",
      "content": [
        "犹记兰亭三月三，流觞曲水畅清酣。",
        "分明一段永和意，好向羲之笔外参。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159465,
      "title": "桓伊三弄图",
      "content": [
        "倾盖相逢不问谁，知音那肯露心机。",
        "一声吹破清秋影，惊散闲云各自飞。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159466,
      "title": "车武子聚萤读书图",
      "content": [
        "武子耽书不暂忘，练囊终夜照凄凉。",
        "读来读去东方白，笑杀流萤数点光。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159467,
      "title": "陆绩怀橘遗母图",
      "content": [
        "独荐霜丸意不安，谁供甘旨侍团𪢮。",
        "蓦然忆著娘生面，万树黄金尽喜欢。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159468,
      "title": "吴隠之饮贪泉图",
      "content": [
        "外物终难换肺肠，隠之清介顿生狂。",
        "便教饮尽贪泉水，只觉通身白雪香。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159469,
      "title": "郝隆晒腹书图",
      "content": [
        "七夕庭中罗绮干，邻家应是鄙儒冠。",
        "文章满腹无人识，铺与青天白日看。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159470,
      "title": "陶渊明三迳图",
      "content": [
        "老气苍寒松树活，闲情幽淡菊花开。",
        "一条古路无人走，还且与人相往来。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159471,
      "title": "陶渊明对菊图",
      "content": [
        "彭泽归来老岁华，东篱尽可了生涯。",
        "谁知秋意凋零后，最耐风霜有此花。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159472,
      "title": "王孝伯痛饮读离骚图",
      "content": [
        "名士天生磊落才，只耽痛饮罄樽罍。",
        "谁传一味解酲法，歌断离骚眼自开。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159473,
      "title": "许真君飞升图",
      "content": [
        "铁柱遗踪尚俨然，五陵后必出群仙。",
        "当时谌姆说甚么，四十二人都上天。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159474,
      "title": "孙登长啸图",
      "content": [
        "碧眼空空照九州，阮公不是我同流。",
        "划然长啸谁听得，独有苏门山点头。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159475,
      "title": "王烈餐石髓图",
      "content": [
        "五百年方开此山，寒光浮暖湿而干。",
        "明明正是洪蒙髓，只恐凡人不肯餐。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159476,
      "title": "桃源图",
      "content": [
        "长城徭役苦咨嗟，澧水偷春隠岁华。",
        "有耳不闻秦汉事，眼前日日赏桃花。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159477,
      "title": "烂柯图",
      "content": [
        "日出樵柴日落归，几年黑白梦纷飞。",
        "看来直待斧柯烂，始悟老仙棋外机。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159478,
      "title": "延平跃剑图",
      "content": [
        "白昼平津涌似雷，尽惊灵物出尘埃。",
        "倒翻三尺挥空去，对舞双龙破浪来。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159479,
      "title": "陶弘景三层楼听松风图",
      "content": [
        "弘景层楼掉太清，万龙卷翠响泠泠。",
        "此心不出三界看，一片秋声何处听。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159480,
      "title": "文选阁图",
      "content": [
        "太子奢华能几年，尽将春梦付荒烟。",
        "错听古调一两拍，空嗅斯文数百篇。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159481,
      "title": "唐明皇游月宫图",
      "content": [
        "玉仗飞行驭太空，须臾径到广寒宫。",
        "三郎胸次无高见，落眼蟾蜍光影中。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159482,
      "title": "李靖天瓢图",
      "content": [
        "梦里骑龙出八荒，扫空热恼作清凉。",
        "不消数滴天瓢雨，净洗娑婆透骨香。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159483,
      "title": "王勃滕王阁记图",
      "content": [
        "王勃清才俊不禁，烂铺艳锦赏知音。",
        "空余高阁青云里，谁识落霞秋水心。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159484,
      "title": "狄仁杰白云亲舍图",
      "content": [
        "驻马回头眺碧空，河阳在望去匆匆。",
        "吾亲虽舍白云下，岂出梁公一念中。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159485,
      "title": "孟浩然归隠图",
      "content": [
        "明主怜才若赐官，奔驰微禄负家山。",
        "狂吟搔首笑归去，满路秋光上醉颜。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159486,
      "title": "李太白砚靴图",
      "content": [
        "斗酒未干诗百篇，篇篇奇气走云烟。",
        "自从捧砚脱靴后，笑看唐家万里天。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159487,
      "title": "杜子美茅屋为秋风所破歌图",
      "content": [
        "雨卷风掀地欲沈，浣花溪路似难寻。",
        "数间茅屋苦饶舌，说杀少陵忧国心。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159488,
      "title": "杜子美骑馿图",
      "content": [
        "饭颗山前花正妍，饮愁为醉弄吟颠。",
        "突然骑过草堂去，梦拜杜鹃声外天。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159489,
      "title": "子美孔明庙古柏行图",
      "content": [
        "诸葛甘棠岁月深，霜皮黛色鬰沉沉。",
        "尚垂清荫蜀国里，一树风霜千载心。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159490,
      "title": "韩昌黎祭鳄鱼图",
      "content": [
        "朝奏空言暮远途，蓝关飞雪渍衣裾。",
        "岂期去国八千里，此意犹能化鳄鱼。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159491,
      "title": "柳子厚赋寒江钓雪图",
      "content": [
        "空玄影外渺孤舟，不与渔翁意思侔。",
        "万顷风涛一天雪，且看谁解下金钩。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 159492,
      "title": "卢仝煎茶图",
      "content": [
        "月团片片吐苍烟，破帽笼头手自煎。",
        "七椀不妨都吃了，恣开笑口骂群仙。"
      ],
      "author": {
        "id": 7822,
        "name": "郑思肖"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    }
