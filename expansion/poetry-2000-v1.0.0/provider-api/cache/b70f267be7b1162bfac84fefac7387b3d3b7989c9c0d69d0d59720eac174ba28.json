{
  "data": [
    {
      "id": 334742,
      "title": "相和歌辞：乌栖曲",
      "content": [
        "西山作宫潮满池，宫乌晓鸣茱萸枝。",
        "吴姬自唱采莲曲，君王昨夜舟中宿。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 334748,
      "title": "相和歌辞：贾客乐",
      "content": [
        "金陵向西贾客多，船中生长乐风波。",
        "欲发移船近江口，",
        "金多众中为上客，夜夜算缗眠独迟。",
        "秋江初月猩猩语，",
        "年年逐利西复东，姓名不在县籍中。",
        "农夫税多长辛苦，"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 334774,
      "title": "相和歌辞：采莲曲",
      "content": [
        "秋江岸边莲子多，采莲女儿凭船歌。",
        "青房圆实齐戢戢，",
        "白练束腰袖半卷，不插玉钗妆梳浅。",
        "船中未满度前洲，"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 334810,
      "title": "舞曲歌辞：白纻歌",
      "content": [
        "皎皎白纻白且鲜，将作春衫称少年。",
        "裁缝长短不能定，",
        "衣裳著时寒食下，还把玉鞭鞭白马。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 334845,
      "title": "琴曲歌辞：别鹤",
      "content": [
        "双鹤出云溪，分飞各自迷。",
        "空巢在松杪，折羽落江泥。",
        "寻水终不饮，逢林亦未栖。",
        "别离应易老，万里两凄凄。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 334865,
      "title": "琴曲歌辞：乌夜啼引",
      "content": [
        "秦乌啼哑哑，夜啼长安吏人家。",
        "吏人得罪囚在狱，",
        "下床心喜不重寐，未明上堂贺舅姑。",
        "少妇语啼乌，"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 334868,
      "title": "琴曲歌辞：宛转行",
      "content": [
        "华屋重翠幄，绮席雕象床。",
        "远漏微更疏，薄衾中夜凉。",
        "炉氲暗裴回，寒灯背斜光。",
        "妍姿结宵态，寝臂幽梦长。",
        "宛转复宛转，忆忆更未央。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 334892,
      "title": "杂曲歌辞：伤歌行",
      "content": [
        "黄门诏下促收捕，京兆君系御史府。",
        "出门无复部曲随，",
        "身著青衫骑恶马，东门之东无送者。",
        "邮夫防吏急喧驱，",
        "高堂舞榭锁管弦，美人遥望西南天。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 334906,
      "title": "杂曲歌辞：妾薄命",
      "content": [
        "薄命妇，良家子，无事从军去万里。",
        "汉家天子平四夷，",
        "与君一日为夫妇，千年万岁亦相守。",
        "君爱龙城征战功，"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 334926,
      "title": "杂曲歌辞：春日行",
      "content": [
        "春日融融池上暖，竹牙出土兰心短。",
        "草堂晨起酒半醒，",
        "树树殷勤尽绕行，举枝未遍春日暝。",
        "不用积金著青天，"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 334942,
      "title": "杂曲歌辞：少年行",
      "content": [
        "少年从出猎长杨，禁中新拜羽林郎。",
        "独到辇前射双虎，",
        "百里报仇夜出城，平明还在倡楼醉。",
        "遥闻虏到平陵下，",
        "不为六郡良家子，百战始取边城功。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 334994,
      "title": "杂曲歌辞：车遥遥",
      "content": [
        "征人遥遥出古城，双轮齐动驷马鸣。",
        "山川无处无归路，",
        "惊麏游兔在我傍，独唱乡歌对僮仆。",
        "君家大宅凤城隅，",
        "门前旧辙久已平，无由复得君消息。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 335018,
      "title": "杂曲歌辞：行路难",
      "content": [
        "湘东行人长叹息，十年离家归未得。",
        "弊裘羸马苦难行，",
        "龙蟠泥中未有云，不能生彼升天翼。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 335051,
      "title": "杂曲歌辞：远别离",
      "content": [
        "莲叶团团杏花拆，长江鲤鱼鳍鬣赤。",
        "念君少年弃亲戚，",
        "几时断得城南陌，勿使居人有行役。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 335058,
      "title": "杂曲歌辞：别离曲",
      "content": [
        "行人结束出门去，马蹄几时踏门路。",
        "忆昔君初纳彩时，",
        "男儿生身自有役，那得误我少年时。",
        "不如逐君征战死，"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 335090,
      "title": "杂曲歌辞：筑城曲",
      "content": [
        "筑城去，千人万人齐抱杵。",
        "重重土坚试行锥，",
        "力尽不得抛杵声，杵声未定人皆死。",
        "家家养男当门户，"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 335109,
      "title": "杂曲歌辞：秋夜长",
      "content": [
        "秋天如水夜未央，天汉东西月色光。",
        "愁人不寐畏枕席，",
        "白露满田风褭褭，千声万声鹖鸟鸣。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 335119,
      "title": "杂曲歌辞：春江曲",
      "content": [
        "春江无云潮水平，蒲心出水凫雏鸣。",
        "长干夫婿爱远行，",
        "春来未到父母家，舟小风多渡不得。",
        "欲辞舅姑先问人，"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 335181,
      "title": "杂曲歌辞：凉州词",
      "content": [
        "边城暮雨雁飞低，芦笋初生渐欲齐。",
        "无数铃声遥过碛，应驮白练到安西。",
        "古镇城门白碛开，胡兵往往傍沙堆。",
        "巡边使客行应早，每待平安火到来。",
        "凤林关里水东流，白草黄榆六十秋。",
        "边将皆承主恩泽，无人解道取凉州。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 335343,
      "title": "杂歌谣辞：吴楚歌",
      "content": [
        "庭前春鸟啄林声，红夹罗襦缝未成。",
        "今朝社日停针线，起向朱樱树下行。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 335370,
      "title": "杂歌谣辞：白鼍鸣",
      "content": [
        "天欲雨，有东风，南溪白鼍鸣窟中。",
        "六月人家井无水，"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351153,
      "title": "寄远曲",
      "content": [
        "美人来去春江暖，江头无人湘水满。",
        "浣沙石上水禽栖，"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351154,
      "title": "行路难",
      "content": [
        "湘东行人长叹息，十年离家归未得。",
        "弊裘羸马苦难行，",
        "龙蟠泥中未有云，不能生彼升天翼。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 351155,
      "title": "征妇怨",
      "content": [
        "九月匈奴杀边将，汉军全没辽水上。",
        "万里无人收白骨，",
        "夫死战场子在腹，妾身虽存如昼烛。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351156,
      "title": "白纻歌",
      "content": [
        "皎皎白纻白且鲜，将作春衣称少年。",
        "裁缝长短不能定，",
        "衣裳著时寒食下，还把玉鞭鞭白马。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351157,
      "title": "野老歌",
      "content": [
        "老农家贫在山住，耕种山田三四亩。",
        "苗疏税多不得食，",
        "西江贾客珠百斛，船中养犬长食肉。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351158,
      "title": "寄衣曲",
      "content": [
        "织素缝衣独苦辛，远因回使寄征人。",
        "官家亦自寄衣去，",
        "殷勤为看初著时，征夫身上宜不宜。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351159,
      "title": "送远曲",
      "content": [
        "戏马台南山簇簇，山边饮酒歌别曲。",
        "行人醉后起登车，",
        "愿君到处自题名，他日知君从此去。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351160,
      "title": "筑城词",
      "content": [
        "筑城处，千人万人齐把杵。",
        "重重土坚试行锥，",
        "力尽不得抛杵声，杵声未尽人皆死。",
        "家家养男当门户，"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351161,
      "title": "猛虎行",
      "content": [
        "南山北山树冥冥，猛虎白日绕林行。",
        "向晚一身当道食，",
        "谷中近窟有山村，长向村家取黄犊。",
        "五陵年少不敢射，"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351162,
      "title": "别离曲",
      "content": [
        "行人结束出门去，几时更踏门前路。",
        "忆昔君初纳采时，",
        "男儿生身自有役，那得误我少年时。",
        "不如逐君征战死，"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351163,
      "title": "牧童词",
      "content": [
        "远牧牛，绕村四面禾黍稠。",
        "陂中饥乌啄牛背，",
        "隔堤吹叶应同伴，还鼓长鞭三四声。",
        "牛牛食草莫相触，"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351164,
      "title": "沙堤行，呈裴相公",
      "content": [
        "长安大道沙为堤，早风无尘雨无泥。",
        "宫中玉漏下三刻，",
        "街官闾吏相传呼，当前十里惟空衢。",
        "白麻诏下移相印，"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351165,
      "title": "求仙行",
      "content": [
        "汉皇欲作飞仙子，年年采药东海里。",
        "蓬莱无路海无边，",
        "九皇真人终不下，空向离宫祠太乙。",
        "丹田有气凝素华，"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351166,
      "title": "古钗叹",
      "content": [
        "古钗堕井无颜色，百尺泥中今复得。",
        "凤凰宛转有古仪，",
        "兰膏已尽股半折，雕文刻样无年月。",
        "虽离井底入匣中，"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351167,
      "title": "各东西",
      "content": [
        "游人别，一东复一西。",
        "出门相背两不返，惟信车轮与马蹄。",
        "道路悠悠不知处，山高海阔谁辛苦。",
        "远游不定难寄书，",
        "我今与子非一身，安得死生不相弃。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351168,
      "title": "节妇吟，寄东平李司空师道",
      "content": [
        "君知妾有夫，赠妾双明珠。",
        "感君缠绵意，系在红罗襦。",
        "妾家高楼连苑起，良人执戟明光里。",
        "知君用心如日月，"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351169,
      "title": "宴客词",
      "content": [
        "上客不用顾金羁，主人有酒君莫违。",
        "请君看取园中花，",
        "人人齐醉起舞时，谁觉翻衣与倒帻。",
        "明朝花尽人已去，"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351170,
      "title": "永嘉行",
      "content": [
        "黄头鲜卑入洛阳，胡儿执戟升明堂。",
        "晋家天子作降虏，",
        "妇人出门随乱兵，夫死眼前不敢哭。",
        "九州诸侯自顾土，"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351171,
      "title": "采莲曲",
      "content": [
        "秋江岸边莲子多，采莲女儿凭船歌。",
        "青房圆实齐戢戢，",
        "白练束腰袖半卷，不插玉钗妆梳浅。",
        "船中未满度前洲，"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 351172,
      "title": "伤歌行",
      "content": [
        "黄门诏下促收捕，京兆尹系御史府。",
        "出门无复部曲随，",
        "身著青衫骑恶马，中门之外无送者。",
        "邮夫防吏急喧驱，",
        "高堂舞榭锁管弦，美人遥望西南天。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 351173,
      "title": "吴宫怨",
      "content": [
        "吴宫四面秋江水，江清露白芙蓉死。",
        "吴王醉后欲更衣，",
        "君心与妾既不同，徒向君前作歌舞。",
        "茱萸满宫红实垂，",
        "白日在天光在地，君今那得长相弃。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 351174,
      "title": "北邙行",
      "content": [
        "洛阳北门北邙道，丧车辚辚入秋草。",
        "车前齐唱薤露歌，",
        "千金立碑高百尺，终作谁家柱下石。",
        "山头松柏半无主，",
        "人居朝市未解愁，请君暂向北邙游。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 351175,
      "title": "关山月",
      "content": [
        "秋月朗朗关山上，山中行人马蹄响。",
        "关山秋来雨雪多，",
        "军中探骑暮出城，伏兵暗处低旌戟。",
        "溪水连天霜草平，",
        "可怜万国关山道，年年战骨多秋草。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 351176,
      "title": "陇头行",
      "content": [
        "陇头路断人不行，胡骑夜入凉州城。",
        "汉兵处处格斗死，",
        "去年中国养子孙，今著毡裘学胡语。",
        "谁能更使李轻车，"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351177,
      "title": "楚妃叹",
      "content": [
        "湘云初起江沉沉，君王遥在云梦林。",
        "江南雨多旌旗暗，",
        "楚兵满地能逐禽，谁用一身骋筋力。",
        "西江若翻云梦中，"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351178,
      "title": "春日行",
      "content": [
        "春日融融池上暖，竹牙出土兰心短。",
        "草堂晨起酒半醒，",
        "树树殷勤尽绕行，攀枝未遍春日暝。",
        "不用积金著青天，"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351179,
      "title": "秋夜长",
      "content": [
        "秋天如水夜未央，天汉东西月色光。",
        "愁人不寐畏枕席，",
        "白露满田风袅袅，千声万声鹖鸟鸣。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351180,
      "title": "白鼍鸣",
      "content": [
        "天欲雨，有东风，南溪白鼍鸣窟中。",
        "六月人家井无水，"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351181,
      "title": "洛阳行",
      "content": [
        "洛阳宫阙当中州，城上峨峨十二楼。",
        "翠华西去几时返，",
        "六街朝暮鼓冬冬，禁兵持戟守空宫。",
        "百官月月拜章表，",
        "陌上老翁双泪垂，共说武皇巡幸时。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 351182,
      "title": "春江曲",
      "content": [
        "春江无云潮水平，蒲心出水凫雏鸣。",
        "长干夫婿爱远行，",
        "春来未到父母家，舟小风多渡不得。",
        "欲辞舅姑先问人，"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351183,
      "title": "送远曲",
      "content": [
        "吴门向西流水长，水长柳暗烟茫茫。",
        "行人送客各惆怅，",
        "行人告我挂帆去，此去何时返故乡。",
        "殷勤振衣两相嘱，",
        "行人行处求知亲，送君去去徒酸辛。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 351184,
      "title": "塞下曲",
      "content": [
        "边州八月修城堡，候骑先烧碛中草。",
        "胡风吹沙度陇飞，",
        "天寒山路石断裂，白日不销帐上雪。",
        "乌孙国乱多降胡，"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 351185,
      "title": "董逃行",
      "content": [
        "洛阳城头火曈曈，乱兵烧我天子宫。",
        "宫城南面有深山，",
        "闻道官军犹掠人，旧里如今归未得。",
        "董逃行，"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351186,
      "title": "少年行",
      "content": [
        "少年从猎出长杨，禁中新拜羽林郎。",
        "独对辇前射双虎，",
        "百里报仇夜出城，平明还在娼楼醉。",
        "遥闻虏到平陵下，",
        "不为六郡良家子，百战始取边城功。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 351187,
      "title": "白头吟",
      "content": [
        "请君膝上琴，弹我白头吟。",
        "忆昔君前娇笑语，",
        "春天百草秋始衰，弃我不待白头时。",
        "罗襦玉珥色未暗，",
        "人心回互自无穷，眼前好恶那能定。",
        "君恩已去若再返，"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 351188,
      "title": "将军行",
      "content": [
        "弹筝峡东有胡尘，天子择日拜将军。",
        "蓬莱殿前赐六纛，",
        "战车彭彭旌旗动，三十六军齐上陇。",
        "陇头战胜夜亦行，",
        "边人亲戚曾战没，今逐官军收旧骨。",
        "碛西行见万里空，"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351189,
      "title": "贾客乐",
      "content": [
        "金陵向西贾客多，船中生长乐风波。",
        "欲发移船近江口，",
        "金多众中为上客，夜夜算缗眠独迟。",
        "秋江初月猩猩语，",
        "年年逐利西复东，姓名不在县籍中。",
        "农夫税多长辛苦，"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351190,
      "title": "羁旅行",
      "content": [
        "远客出门行路难，停车敛策在门端。",
        "荒城无人霜满路，",
        "行寻田头暝未息，双毂长辕碍荆棘。",
        "缘冈入涧投田家，",
        "旧山已别行已远，身计未成难复返。",
        "长安陌上相识稀，"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351191,
      "title": "车遥遥",
      "content": [
        "征人遥遥出古城，双轮齐动驷马鸣。",
        "山川无处不归路，",
        "惊麏游兔在我傍，独唱乡歌对僮仆。",
        "君家大宅凤城隅，",
        "门前旧辙久已平，无由复得君消息。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 351192,
      "title": "妾薄命",
      "content": [
        "薄命妇，良家子，无事从军去万里。",
        "汉家天子平四夷，",
        "与君一日为夫妇，千年万岁亦相守。",
        "君爱龙城征战功，"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351193,
      "title": "朱鹭",
      "content": [
        "翩翩兮朱鹭，来泛春塘栖绿树。",
        "羽毛如翦色如染，",
        "谁知豪家网尔躯，不如饮啄江海隅。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351194,
      "title": "远别离",
      "content": [
        "莲叶团团杏花拆，长江鲤鱼鬐鬣赤。",
        "念君少年弃亲戚，",
        "几时断得城南陌，勿使居人有行役。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351195,
      "title": "楚宫行",
      "content": [
        "章华宫中九月时，桂花半落红橘垂。",
        "江头骑火照辇道，",
        "千门万户开相当，烛笼左右列成行。",
        "下辇更衣入洞房，",
        "玉酒湛湛盈华觞，丝竹次第鸣中堂。",
        "巴姬起舞向君王，"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351196,
      "title": "江南行",
      "content": [
        "江南人家多橘树，吴姬舟上织白苎。",
        "土地卑湿饶虫蛇，",
        "清莎覆城竹为屋，无井家家饮潮水。",
        "长干午日沽春酒，",
        "江南风土欢乐多，悠悠处处尽经过。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 351197,
      "title": "乌夜啼引",
      "content": [
        "秦乌啼哑哑，夜啼长安吏人家。",
        "吏人得罪囚在狱，",
        "下床心喜不重寐，未明上堂贺舅姑。",
        "少妇语啼乌，"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351198,
      "title": "促促词",
      "content": [
        "促促复促促，家贫夫妇欢不足。",
        "今年为人送租船，",
        "家家桑麻满地黑，念君一身空努力。",
        "愿教牛蹄团团羊角直，君身常在应不得。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351199,
      "title": "宛转行",
      "content": [
        "华屋重翠幄，绮席雕象床。",
        "远漏微更疏，薄衾中夜凉。",
        "炉气暗裴徊，寒灯背斜光。",
        "妍姿结宵态，寝臂幽梦长。",
        "宛转复宛转，忆君更未央。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351200,
      "title": "短歌行",
      "content": [
        "青天荡荡高且虚，上有白日无根株。",
        "流光暂出还入地，",
        "玉卮盛酒置君前，再拜愿君千万年。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 351201,
      "title": "山头鹿",
      "content": [
        "山头鹿，角芟芟，尾促促。",
        "贫儿多租输不足，",
        "县家唯忧少军食，谁能令尔无死伤。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351202,
      "title": "湘江曲",
      "content": [
        "湘水无潮秋水阔，湘中月落行人发。",
        "送人发，送人归，"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351206,
      "title": "寒塘曲",
      "content": [
        "寒塘沉沉柳叶疏，水暗人语惊栖凫。",
        "舟中少年醉不起，持烛照水射游鱼。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 351210,
      "title": "雀飞多",
      "content": [
        "雀飞多，触网罗，网罗高树颠。",
        "汝飞蓬蒿下，"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351211,
      "title": "泗水行",
      "content": [
        "泗水流急石纂纂，鲤鱼上下红尾短。",
        "春冰销散日华满，"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351212,
      "title": "废居行",
      "content": [
        "胡马崩腾满阡陌，都人避乱唯空宅。",
        "宅边青桑垂宛宛，",
        "去时禾黍埋地中，饥兵掘土翻重重。",
        "鸱枭养子庭树上，"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351213,
      "title": "寄菖蒲",
      "content": [
        "石上生菖蒲，一寸十二节。",
        "仙人劝我食，令我头青面如雪。",
        "逢人寄君一绛囊，书中不得传此方。",
        "君能来作栖霞侣，"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351214,
      "title": "江村行",
      "content": [
        "南塘水深芦笋齐，下田种稻不作畦。",
        "耕场磷磷在水底，",
        "水淹手足尽有疮，山虻绕身飞飏飏。",
        "桑林椹黑蚕再眠，",
        "一年耕种长苦辛，田熟家家将赛神。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 351215,
      "title": "樵客吟",
      "content": [
        "上山采樵选枯树，深处樵多出辛苦。",
        "秋来野火烧栎林，",
        "日西待伴同下山，竹担弯弯向身曲。",
        "共知路傍多虎窟，",
        "采樵客，莫采松与柏。",
        "松柏生枝直且坚，与君作屋成家宅。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351217,
      "title": "春水曲",
      "content": [
        "鸭鸭，觜唼唼。",
        "青蒲生，春水狭。",
        "荡漾木兰船，"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351218,
      "title": "云童行",
      "content": [
        "云童童，白龙之尾垂江中。",
        "今年天旱不作雨，"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351220,
      "title": "忆远曲",
      "content": [
        "水上山沉沉，征途复绕林。",
        "途荒人行少，马迹犹可寻。",
        "雪中独立树，海口失侣禽。",
        "离忧如长线，千里萦我心。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 351221,
      "title": "长塘湖",
      "content": [
        "长塘湖，一斛水中半斛鱼。",
        "大鱼如柳叶，小鱼如针锋，"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351222,
      "title": "废瑟词",
      "content": [
        "古瑟在匣谁复识，玉柱颠倒朱丝黑。",
        "千年曲谱不分明，",
        "几时天下复古乐，此瑟还奏云门曲。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351223,
      "title": "野居",
      "content": [
        "贫贱易为适，荒郊亦安居。",
        "端坐无余思，弥乐古人书。",
        "秋田多良苗，野水多游鱼。",
        "我无耒与网，安得充廪厨。",
        "寒天白日短，簷下暖我躯。",
        "四肢暂宽柔，中肠郁不舒。",
        "多病减志气，为客足忧虞。",
        "况复苦时节，览景独踟蹰。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351227,
      "title": "三原李氏园宴集",
      "content": [
        "暮春天早热，邑居苦嚣烦。",
        "言从君子乐，乐彼李氏园。",
        "园中有草堂，池引泾水泉。",
        "开户西北望，远见嵯峨山。",
        "借问主人翁，北州佐戎轩。",
        "仆夫守旧宅，为客侍华筵。",
        "高怀有余兴，竹树芳且鲜。",
        "倾我所持觞，尽日共留连。",
        "疏拙不偶俗，常喜形体闲。",
        "况来幽栖地，能不重叹言。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351228,
      "title": "沈千运旧居",
      "content": [
        "汝北君子宅，我来见颓墉。",
        "乱离子孙尽，地属邻里翁。",
        "土木被丘墟，溪路不连通。",
        "旧井蔓草合，牛羊坠其中。",
        "君辞天子书，放意任体躬。",
        "一生不自力，家与逆旅同。",
        "高议切星辰，余声激喑聋。",
        "方将旌旧闾，百世可封崇。",
        "嗟其未积年，已为荒林丛。",
        "时岂无知音，不能崇此风。",
        "浩荡竟无睹，我将安所从。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351229,
      "title": "赠别孟郊",
      "content": [
        "历历天上星，沉沉水中萍。",
        "幸当清秋夜，流影及微形。",
        "君生衰俗间，立身如礼经。",
        "纯诚发新文，独有金石声。",
        "才名振京国，归省东南行。",
        "停车楚城下，顾我不念程。",
        "宝镜曾坠水，不磨岂自明。",
        "苦节居贫贱，所知赖友生。",
        "欢会方别离，戚戚忧虑并。",
        "安得在一方，终老无送迎。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351230,
      "title": "卧疾",
      "content": [
        "身病多思虑，亦读神农经。",
        "空堂留灯烛，四壁青荧荧。",
        "羁旅随人欢，贫贱还自轻。",
        "今来问良医，乃知病所生。",
        "僮仆各忧愁，杵臼无停声。",
        "见我形憔悴，劝药语丁宁。",
        "春雨枕席冷，窗前新禽鸣。",
        "开门起无力，遥爱鸡犬行。",
        "服药察耳目，渐如醉者醒。",
        "顾非达性命，犹为忧患生。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351232,
      "title": "哭于鹄",
      "content": [
        "青山无逸人，忽觉大国贫。",
        "良玉沉幽泉，名为天下珍。",
        "野性疏时俗，再拜乃从军。",
        "气高终不合，去如镜上尘。",
        "我初有章句，相合者唯君。",
        "今来吊嗣子，对陇烧新文。",
        "耕者废其耜，爨者绝其薪。",
        "苟无新衣裳，曷用光我身。",
        "奠酒徒拜手，哀怀安能陈。",
        "徒保金石韵，千载人所闻。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351233,
      "title": "南归",
      "content": [
        "促促念道路，四支不常宁。",
        "行车未及家，天外非尽程。",
        "骨肉待我欢，乡里望我荣。",
        "岂知东与西，憔悴竟无成。",
        "人言苦夜长，穷者不念明。",
        "惧离其寝寐，百忧伤性灵。",
        "世道多险薄，相劝毕中诚。",
        "远游无知音，不如商贾行。",
        "达人有常志，愚夫劳所营。",
        "旧山行去远，言归乐此生。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351234,
      "title": "惜花",
      "content": [
        "蒙蒙庭树花，坠地无颜色。",
        "日暮东风起，飘扬玉阶侧。",
        "残蕊在犹稀，青条耸复直。",
        "为君结芳实，令君勿叹息。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 351235,
      "title": "奉和舍人叔直省时思琴",
      "content": [
        "蔼蔼紫薇直，秋意深无穷。",
        "滴沥仙阁漏，肃穆禁池风。",
        "竹月泛凉影，萱露澹幽丛。",
        "地清物态胜，宵闲琴思通。",
        "时属雅音际，迥凝虚抱中。",
        "达人掌枢近，常与隐默同。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351236,
      "title": "离妇",
      "content": [
        "十载来夫家，闺门无瑕疵。",
        "薄命不生子，古制有分离。",
        "托身言同穴，今日事乖违。",
        "念君终弃捐，谁能强在兹。",
        "堂上谢姑嫜，长跪请离辞。",
        "姑嫜见我往，将决复沉疑。",
        "与我古时钏，留我嫁时衣。",
        "高堂拊我身，哭我于路陲。",
        "昔日初为妇，当君贫贱时。",
        "昼夜常纺织，不得事蛾眉。",
        "辛勤积黄金，济君寒与饥。",
        "洛阳买大宅，邯郸买侍儿。",
        "夫婿乘龙马，出入有光仪。",
        "将为富家妇，永为子孙资。",
        "谁谓出君门，一身上车归。",
        "有子未必荣，无子坐生悲。",
        "为人莫作女，作女实难为。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351238,
      "title": "学仙",
      "content": [
        "楼观开朱门，树木连房廊。",
        "中有学仙人，少年休谷粮。",
        "高冠如芙蓉，霞月披衣裳。",
        "六时朝上清，佩玉纷锵锵。",
        "自言天老书，秘覆云锦囊。",
        "百年度一人，妄泄有灾殃。",
        "每占有仙相，然后传此方。",
        "先生坐中堂，弟子跪四厢。",
        "金刀截身发，结誓焚灵香。",
        "弟子得其诀，清斋入空房。",
        "守神保元气，动息随天罡。",
        "炉烧丹砂尽，昼夜候火光。",
        "药成既服食，计日乘鸾凰。",
        "虚空无灵应，终岁安所望。",
        "勤劳不能成，疑虑积心肠。",
        "虚羸生疾疹，寿命多夭伤。",
        "身殁惧人见，夜埋山谷傍。",
        "求道慕灵异，不如守寻常。",
        "先王知其非，戒之在国章。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 351240,
      "title": "城南",
      "content": [
        "漾漾南涧水，来作曲池流。",
        "言寻参差岛，晓榜轻盈舟。",
        "万绕不再止，千寻尽孤幽。",
        "藻涩讶人重，萍分指鱼游。",
        "繁苗毯下垂，密箭翻回辀。",
        "曝鳖乱自坠，阴藤斜相钩。",
        "卧蒋黑米吐，翻芰紫角稠。",
        "桥低竞俯偻，亭近闲夷犹。",
        "目为逐胜朗，手因掇芳柔。",
        "渐喜游来极，忽疑归无由。",
        "气状虽可览，纤微谅难搜。",
        "未听主人赏，徒爱清华秋。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
