{
  "data": [
    {
      "id": 262384,
      "title": "春意二首 一",
      "content": [
        "去日丁宁别，情知寒食归。",
        "缘逢好天气，教熨看花衣。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 262385,
      "title": "春意二首 二",
      "content": [
        "谁是杏园主，一枝临古岐。",
        "从伤早春意，乞取欲开枝。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 262386,
      "title": "夜闻子规",
      "content": [
        "子规啼不歇，到晓口应穿。",
        "况是不眠夜，声声在耳边。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 262387,
      "title": "四望驿松",
      "content": [
        "当初北涧别，直至此庭中。",
        "何意闻鞞耳，听君枝上风。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 262388,
      "title": "江馆",
      "content": [
        "水面细风生，菱歌慢慢声。",
        "客亭临小市，灯火夜妆明。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 262389,
      "title": "题江台驿",
      "content": [
        "水北金台路，年年行客稀。",
        "近闻天子使，多取雁门归。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 262390,
      "title": "赠谪者",
      "content": [
        "何罪过长沙，年年北望家。",
        "重封岭头信，一树海边花。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 262391,
      "title": "戏酬卢秘书",
      "content": [
        "芸香阁里人，采摘御园春。",
        "取此和仙药，犹治老病身。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 262392,
      "title": "小松",
      "content": [
        "小松初数尺，未有直生枝。",
        "闲即傍边立，看多长却迟。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 262393,
      "title": "秋夜",
      "content": [
        "夜久叶露滴，秋虫入户飞。",
        "卧多骨髓冷，起覆旧绵衣。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 262394,
      "title": "水精",
      "content": [
        "映水色不别，向月光还度。",
        "倾在荷叶中，有时看是露。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 262395,
      "title": "香印",
      "content": [
        "闲坐烧印香，满户松柏气。",
        "火尽转分明，青苔碑上字。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 262396,
      "title": "秋灯",
      "content": [
        "向壁暖悠悠，罗帏寒寂寂。",
        "斜照碧山图，松间一片石。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 262397,
      "title": "落叶",
      "content": [
        "陈绿向参差，初红已重叠。",
        "中庭初扫地，绕树三两叶。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 262398,
      "title": "园果",
      "content": [
        "雨中棃果病，每树无数个。",
        "小儿出入看，一半鸟啄破。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 262399,
      "title": "野菊",
      "content": [
        "晚艳出荒篱，冷香著秋水。",
        "忆向山中见，伴蛩石壁里。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 262400,
      "title": "荒园",
      "content": [
        "朝日满园霜，牛冲篱落坏。",
        "扫掠黄叶中，时时一窠薤。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 262401,
      "title": "南涧",
      "content": [
        "野桂香满溪，石莎寒覆水。",
        "爱此南涧头，终日潺湲里。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 262402,
      "title": "晚蝶",
      "content": [
        "粉翅嫩如水，绕砌乍依风。",
        "日高山露解，飞入菊花中。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 262403,
      "title": "田家",
      "content": [
        "啾啾雀满树，霭霭东坡雨。",
        "田家夜无食，水中摘禾黍。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 262404,
      "title": "新嫁娘词三首 一",
      "content": [
        "邻家人未识，床上坐堆堆。",
        "郎来傍门户，满口索钱财。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 262405,
      "title": "新嫁娘词三首 二",
      "content": [
        "锦幛两边横，遮掩侍娘行。",
        "遣郎铺簟席，相并拜亲情。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 262406,
      "title": "新嫁娘词三首 三",
      "content": [
        "三日入厨下，洗手作羹汤。",
        "未谙姑食性，先遣小姑尝。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 262407,
      "title": "故行宫",
      "content": [
        "寥落古行宫，宫花寂寞红。",
        "白头宫女在，闲坐说玄宗。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 262408,
      "title": "酬从姪再看诗本",
      "content": [
        "眼暗没功夫，慵来翦刻麤。",
        "自看花样古，称得少年无。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 262409,
      "title": "别自栽小树",
      "content": [
        "去年今日栽，临去见花开。",
        "好住守空院，夜间人不来。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 262410,
      "title": "早发汾南",
      "content": [
        "桥上车马发，桥南烟树开。",
        "青山斜不断，迢递故乡来。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 262411,
      "title": "宫中三台词二首 一",
      "content": [
        "鱼藻池边射鸭，芙蓉园里看花。",
        "日色柘袍相似，不著红鸾扇遮。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 262412,
      "title": "宫中三台词二首 二",
      "content": [
        "池北池南草绿，殿前殿后花红。",
        "天子千年万岁，未央明月清风。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 262413,
      "title": "江南三台词四首 一",
      "content": [
        "扬州桥边少妇，长安城里商人。",
        "二年不得消息，各自拜鬼求神。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 262414,
      "title": "江南三台词四首 二",
      "content": [
        "青草湖边草色，飞猿岭上猿声。",
        "万里湘江客到，有风有雨人行。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 262415,
      "title": "江南三台词四首 三",
      "content": [
        "树头花落花开，道上人去人来。",
        "朝愁暮愁即老，百年几度三台。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 262416,
      "title": "江南三台词四首 四",
      "content": [
        "闻身强健且为，头白齿落难追。",
        "准拟百年千岁，能得几许多时。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 262417,
      "title": "御猎",
      "content": [
        "青山直遶凤城头，浐水斜分入御沟。",
        "新教内人唯射鸭，长随天子苑东游。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262418,
      "title": "长门烛",
      "content": [
        "秋夜床前蜡烛微，铜壶滴尽晓钟迟。",
        "残光欲灭还吹著，年少宫人未睡时。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262419,
      "title": "过绮岫宫",
      "content": [
        "玉楼倾倒粉墙空，重叠青山遶故宫。",
        "武帝去来罗袖尽，野花黄蝶领春风。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262420,
      "title": "朝天词十首寄上魏博田侍中 一",
      "content": [
        "山川初展国图宽，未识龙颜坐不安。",
        "风动白髯旌节下，过时天子御楼看。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262421,
      "title": "朝天词十首寄上魏博田侍中 二",
      "content": [
        "相感君臣总泪流，恩深舞蹈不知休。",
        "初从战地来无物，唯奏新添十八州。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262422,
      "title": "朝天词十首寄上魏博田侍中 三",
      "content": [
        "催修水殿宴沂公，与别诸候总不同。",
        "隔月太常先习乐，金书牌纛彩云中。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262423,
      "title": "朝天词十首寄上魏博田侍中 四",
      "content": [
        "无人敢夺在先筹，天子门边送与毬。",
        "遥索彩箱新样锦，内人舁出马前头。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262424,
      "title": "朝天词十首寄上魏博田侍中 五",
      "content": [
        "御马牵来亲自试，珠毬到处玉蹄知。",
        "殿头宣赐连催上，未解红缨不敢骑。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262425,
      "title": "朝天词十首寄上魏博田侍中 六",
      "content": [
        "老作三公经献寿，临时犹自语差池。",
        "私从班里来长跪，捧上金杯便合仪。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262426,
      "title": "朝天词十首寄上魏博田侍中 七",
      "content": [
        "四海无波乞放闲，三封手疏犯龙颜。",
        "他时若有边尘动，不待天书自出山。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262427,
      "title": "朝天词十首寄上魏博田侍中 八",
      "content": [
        "胡马悠悠未尽归，玉关犹隔吐蕃旗。",
        "老臣一表求高卧，边事从今欲问谁。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262428,
      "title": "朝天词十首寄上魏博田侍中 九",
      "content": [
        "威容难画改频频，眉目分毫恐不真。",
        "有诏别图书阁上，先教粉本定风神。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262429,
      "title": "朝天词十首寄上魏博田侍中 十",
      "content": [
        "重赐弓刀内宴回，看人城外满楼台。",
        "君臣不作多时别，收尽边旗当日来。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262430,
      "title": "霓裳词十首 一",
      "content": [
        "弟子部中留一色，听风听水作霓裳。",
        "散声未足重来授，直到床前见上皇。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262431,
      "title": "霓裳词十首 二",
      "content": [
        "中管五弦初半曲，遥教合上隔帘听。",
        "一声声向天头落，效得仙人夜唱经。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262432,
      "title": "霓裳词十首 三",
      "content": [
        "自直棃园得出稀，更番上曲不教归。",
        "一时跪拜霓裳彻，立地阶前赐紫衣。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262433,
      "title": "霓裳词十首 四",
      "content": [
        "旋翻新谱声初足，除却棃园未教人。",
        "宣与书家分手写，中官走马赐功臣。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262434,
      "title": "霓裳词十首 五",
      "content": [
        "伴教霓裳有贵妃，从初直到曲成时。",
        "日长耳里闻声熟，拍数分毫错总知。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262435,
      "title": "霓裳词十首 六",
      "content": [
        "弦索𪭢𪭢隔彩云，五更初发一山闻。",
        "武皇自送西王母，新换霓裳月色裙。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262436,
      "title": "霓裳词十首 七",
      "content": [
        "敕赐宫人澡浴回，遥看美女院门开。",
        "一山星月霓裳动，好字先从殿里来。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262437,
      "title": "霓裳词十首 八",
      "content": [
        "传呼法部按霓裳，新得承恩别作行。",
        "应是贵妃楼上看，内人舁下彩罗箱。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262438,
      "title": "霓裳词十首 九",
      "content": [
        "朝元阁上山风起，夜听霓裳玉露寒。",
        "宫女月中更替立，黄金梯滑并行难。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262439,
      "title": "霓裳词十首 十",
      "content": [
        "知向华清年月满，山头山底种长生。",
        "去时留下霓裳曲，总是离宫别馆声。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262440,
      "title": "宫前早春",
      "content": [
        "酒幔高楼一百家，宫前杨柳寺前花。",
        "内园分得温汤水，二月中旬已进瓜。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262441,
      "title": "奉同曾郎中题石瓮寺得嵌韵",
      "content": [
        "寺门连内遶丹岩，下界云开数过帆。",
        "遥指上皇翻曲处，百官题字满西嵌。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262442,
      "title": "旧宫人",
      "content": [
        "先帝旧宫宫女在，乱丝犹挂凤皇钗。",
        "霓裳法曲浑抛却，独自花间埽玉堦。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262443,
      "title": "新授戒尼师",
      "content": [
        "新短方裙叠作棱，听钟洗钵绕青蝇。",
        "自知戒相分明后，先出坛场礼大僧。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262444,
      "title": "太和公主和蕃",
      "content": [
        "塞黑云黄欲渡河，风沙瞇眼雪相和。",
        "琵琶泪湿行声小，断得人肠不在多。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262445,
      "title": "元太守同游七泉寺",
      "content": [
        "盘磴回廊古塔深，紫芝红药入云寻。",
        "晚吹箫管秋山里，引得猕猴出象林。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262446,
      "title": "望定州寺",
      "content": [
        "回看佛阁青山半，三四年前到上头。",
        "省得老僧留不住，重寻更可有因由。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262447,
      "title": "道中寄杜书记",
      "content": [
        "西南东北暮天斜，巴字江边楚树花。",
        "珍重荆州杜书记，闲时多在广师家。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262448,
      "title": "听琴",
      "content": [
        "无事此身离白云，松风溪水不曾闻。",
        "至心听著仙翁引，今看青山围绕君。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262449,
      "title": "赠陈评事",
      "content": [
        "识君虽向歌钟会，说事不离云水间。",
        "春夜酒醒长起坐，灯前一纸洞庭山。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262450,
      "title": "寄画松僧",
      "content": [
        "天香寺里古松僧，不画枯松落石层。",
        "最爱临江两三树，水禽栖处解无藤。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262451,
      "title": "花褐裘",
      "content": [
        "对织芭蕉雪毳新，长缝双袖窄裁身。",
        "到头须向边城著，消杀秋风称猎尘。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262452,
      "title": "夜看美人宫棋",
      "content": [
        "宫棋布局不依经，黑白分明子数停。",
        "巡拾玉沙天汉晓，犹残织女两三星。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262453,
      "title": "上田仆射",
      "content": [
        "一方新地隔河烟，曾接诸生听管弦。",
        "却忆去年寒食会，看花犹在水堂前。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262454,
      "title": "江陵道中",
      "content": [
        "菱叶参差萍叶重，新蒲半折夜来风。",
        "江村水落平地出，溪畔渔船青草中。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262455,
      "title": "冬至后招于秀才",
      "content": [
        "日近山红暖气新，一阳先入御沟春。",
        "闻闲立马重来此，沐浴明年称意身。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262456,
      "title": "别曲",
      "content": [
        "毒蛇在肠疮满背，去年别家今别弟。",
        "马头对哭各东西，天边柳絮无根蔕。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262457,
      "title": "长安别",
      "content": [
        "长安清明好时节，只宜相送不宜别。",
        "恶心床上铜片明，照见离人白头发。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262458,
      "title": "宫人斜",
      "content": [
        "未央墙西青草路，宫人斜里红妆墓。",
        "一边载出一边来，更衣不减寻常数。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262459,
      "title": "春词",
      "content": [
        "良人朝早半夜起，樱桃如珠露如水。",
        "下堂把火送郎回，移枕重眠晓窗里。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262460,
      "title": "野池",
      "content": [
        "野池水满连秋隄，菱花结实蒲叶齐。",
        "川口雨晴风复止，蜻蜓上下鱼东西。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262461,
      "title": "题崔秀才里居",
      "content": [
        "自知名出休呈卷，爱去人家远处居。",
        "时复打门无别事，铺头来索买残书。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262462,
      "title": "酬栢侍御荅酒",
      "content": [
        "茱萸酒法大家同，好是盛来白椀中。",
        "这度自知颜色重，不消诗里弄溪翁。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262463,
      "title": "别药栏",
      "content": [
        "芍药丁香手里栽，临行一日绕千回。",
        "外人应怪难辞别，总是山中自取来。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262464,
      "title": "长门",
      "content": [
        "长门闭定不求生，烧却头花卸却筝。",
        "病卧玉窗秋雨下，遥闻别院唤人声。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262465,
      "title": "题渭亭",
      "content": [
        "云开远水傍秋天，沙岸蒲帆隔野烟。",
        "一片蔡州青草色，日西铺在古台边。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262466,
      "title": "过喜祥山馆",
      "content": [
        "夜过深山算驿程，三回黑地听泉声。",
        "自离军马身轻健，得向溪边尽足行。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262467,
      "title": "送迁客",
      "content": [
        "万里潮州一逐臣，悠悠青草海边春。",
        "天涯莫道无回日，上岭还逢向北人。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262468,
      "title": "废寺",
      "content": [
        "废寺乱来为县驿，荒松老柏不生烟。",
        "空廊屋漏画僧尽，梁上犹书天宝年。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262469,
      "title": "题禅师房",
      "content": [
        "浮生不住叶随风，填海移山总是空。",
        "长向人间愁老病，谁来闲坐此房中。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262470,
      "title": "看石楠花",
      "content": [
        "留得行人忘却归，雨中须是石楠枝。",
        "明朝独上铜台路，容见花开少许时。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262471,
      "title": "长安县后亭看画",
      "content": [
        "水冻横桥雪满池，新排石笋绕巴篱。",
        "县门斜掩无人吏，看画双飞白鹭鸶。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262472,
      "title": "华岳庙二首 一",
      "content": [
        "女巫遮客买神盘，争取琵琶庙里弹。",
        "闻有马蹄生拍树，路人来去向南看。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262473,
      "title": "华岳庙二首 二",
      "content": [
        "自移西岳门长锁，一个行人一遍开。",
        "上庙参天今见在，夜头风起觉神来。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262474,
      "title": "酬赵侍御",
      "content": [
        "年少同为邺下游，闲寻野寺醉登楼。",
        "别来衣马从胜旧，争向边尘满白头。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262475,
      "title": "镊白",
      "content": [
        "总道老来无用处，何须白发在前生。",
        "如今不用偷年少，拔却三茎又五茎。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262476,
      "title": "送山人二首 一",
      "content": [
        "嵩山古寺离来久。",
        "回见溪桥野叶黄，辛苦老师看守处。",
        "为悬秋药闭空房。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262477,
      "title": "送山人二首 二",
      "content": [
        "山客狂来跨白驴，袖中遗却颍阳书。",
        "人间亦有妻儿在，抛向嵩阳古观居。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262478,
      "title": "扬州寻张籍不见",
      "content": [
        "别后知君在楚城，扬州寺里觅君名。",
        "西江水阔吴山远，却打船头向北行。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262479,
      "title": "宿长安县后斋",
      "content": [
        "新向金阶奏罢兵，长安县里绕池行。",
        "喜欢得伴山僧宿，看雪吟诗直到明。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262480,
      "title": "夜看扬州市",
      "content": [
        "夜市千灯照碧云，高楼红袖客纷纷。",
        "如今不似时平日，犹自笙歌彻晓闻。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262481,
      "title": "寄韦谏议",
      "content": [
        "百年看似暂时间，头白求官亦未闲。",
        "独有龙门韦谏议，三征不起恋青山。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262482,
      "title": "寻补阙旧宅",
      "content": [
        "知得清名二十年，登山上坂乞新篇。",
        "除书近拜侍臣去，空院鸟啼风竹前。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 262483,
      "title": "初冬旅游",
      "content": [
        "远投人宿趁房迟，僮仆伤寒马亦饥。",
        "为客悠悠十月尽，庄头栽竹已过时。"
      ],
      "author": {
        "id": 8985,
        "name": "王建"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    }
  ],
