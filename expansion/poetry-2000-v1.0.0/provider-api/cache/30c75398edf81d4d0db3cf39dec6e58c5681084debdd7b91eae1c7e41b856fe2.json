{
  "data": [
    {
      "id": 3485,
      "title": "留别康元质教授",
      "content": [
        "腐儒身世已百忧，此去行年岂堪记。",
        "岳阳楼前一杯酒，与子同州复同味。",
        "洞庭秋气连苍梧，天高地远鱼龙呼。",
        "莫倚仲宣能作赋，不随文若事征途。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 3486,
      "title": "留别天宁永庆干明金銮四老",
      "content": [
        "我生能几何，两脚疲世故。",
        "忽破巴丘梦，还寻邵阳路。",
        "穷乡得四老，足以慰迟暮。",
        "胜事远公莲，深心懒残芋。",
        "本是群山云，𫏐聚当别去。",
        "那知天风便，不得还相聚。",
        "凡情我未免，临别吐幽句。",
        "慎勿过虎溪，晓霜侵杖屦。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3487,
      "title": "别岳州",
      "content": [
        "朝食三斗葱，暮饮三斗醋。",
        "宁受此酸辛，莫行岁晚路。",
        "丈夫少壮日，忍穷不自恕。",
        "乘除冀晚泰，乃复逢变故。",
        "经年岳阳楼，不见宫南树。",
        "辞巢已万里，两脚未遑住。",
        "水落君山高，洞庭秋已素。",
        "浮云易归岫，远客难回顾。",
        "飘然一瓶锡，未知所挂处。",
        "寂寞短歌行，萧条远游赋。",
        "学道始恨晚，为儒孰非腐。",
        "乾坤杳茫茫，三叹出门去。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3488,
      "title": "奇父先至湘阴书来戒由禄唐路而仆以它故由南阳路来夹道皆松如行青罗步障中先寄奇父",
      "content": [
        "云接湘阴百里松，肃肃穆穆湖南风。",
        "随时忧乐非人世，迎我笙箫起道中。",
        "竹舆两面天明灭，秋令不到林西东。",
        "未必禄唐能办此，题诗著画寄兴公。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 3489,
      "title": "初识茶花",
      "content": [
        "伊轧篮舆不受催，湖南秋色更佳哉。",
        "青裙玉面初相识，九月茶花满路开。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 3490,
      "title": "以玉刚卯为向伯共生朝",
      "content": [
        "仲冬吉日，风穆气休。",
        "我出刚卯，以寿元侯。",
        "祝融之玉，莫此离方。",
        "元侯佩之，如玉之刚。",
        "攘除厉凶，以迪明王。",
        "南门不键，有室则强。",
        "三肃元侯，既赠既祷。",
        "曷以报我，当以刚卯。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3491,
      "title": "别伯共",
      "content": [
        "樽酒相逢地，江枫欲尽时。",
        "犹能十日客，共出数年诗。",
        "供世无筋力，惊心有别离。",
        "好为南极柱，深慰旅人悲。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 3492,
      "title": "再别",
      "content": [
        "多难还分手，江边白发新。",
        "公为九州督，我是半途人。",
        "政尔倾全节，终然却要身。",
        "平生第温峤，未必下张巡。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 3493,
      "title": "别孙信道",
      "content": [
        "万里鸥仍去，千年鹤未归。",
        "极知身有几，不奈世相违。",
        "岁暮蒹葭响，天长鸿雁微。",
        "如君那可别，老泪欲霑衣。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 3494,
      "title": "游道林岳麓",
      "content": [
        "耽耽衡山麓，翠气横古今。",
        "济胜得短筇，未怕山行深。",
        "路盘天开阖，风动龙噫吟。",
        "峰恋惨澹处，照以布地金。",
        "世尊诸天上，燕坐朝千林。",
        "向来修何行，不受安危侵。",
        "道人轻殊胜，来客费幽寻。",
        "恍然结愿香，独会三生心。",
        "山中日易晚，坐失群木阴。",
        "勿唾此山地，后日重窥临。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3495,
      "title": "江行野宿寄大光",
      "content": [
        "樯乌送我入蛮乡，天地无情白发长。",
        "万里回头看北斗，三更不寐听鸣榔。",
        "平生正出元子下，此去还经思旷傍。",
        "投老相逢难衮衮，共恢诗律撼潇湘。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 3496,
      "title": "寄信道",
      "content": [
        "衡山未见意如飞，浩荡风帆不可期。",
        "却忆府中三语掾，空吟江上四愁诗。",
        "高滩落日光零乱，远岸丛梅雪陆离。",
        "剩欲平分持寄子，白头才尽只成悲。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 3497,
      "title": "适远",
      "content": [
        "处处非吾土，年年备虏兵。",
        "何妨更适远，未免一伤情。",
        "石岸烟添色，风滩暮有声。",
        "平生五字律，头白不贪名。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 3498,
      "title": "衡岳道中  其一",
      "content": [
        "野客元耕崧岳田，得游衡岳亦前缘。",
        "避兵径度吾岂忍，欲雨还休神所怜。",
        "世乱不妨松偃蹇，村空更觉水潺湲。",
        "非无拄杖终伤老，负此名山四十年。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 3499,
      "title": "衡岳道中  其二",
      "content": [
        "客子山行不觉风，龙吟虎啸满山松。",
        "纶巾一幅无人识，胜业门前听午钟。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 3500,
      "title": "衡岳道中  其三",
      "content": [
        "城中望衡山，浮云作飞盖。",
        "朅来岩谷游，却在浮云外。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 3501,
      "title": "衡岳道中  其四",
      "content": [
        "危亭见上方，林壑带残阳。",
        "今日岂无恨，重游却味长。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 3502,
      "title": "跋任才仲画两首  其一",
      "content": [
        "远游吾不恨，扁舟载幅巾。",
        "山色暮暮改，林气朝朝新。",
        "野客初逢句，薄暮欲生春。",
        "因知子任子，胸怀非世人。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 3503,
      "title": "跋任才仲画两首  其二",
      "content": [
        "前年与孙子，共作南山客。",
        "扶疏月下树，偃蹇涧边石。",
        "赋诗题古藓，三叫风脱帻。",
        "任子不同游，毫端有畴昔。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 3504,
      "title": "跋江都王马",
      "content": [
        "天上房星空不动，人间画马亦难逢。",
        "当年笔下千金鹿，此日窗前八尺龙。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 3505,
      "title": "与王子焕席大光同游廖园",
      "content": [
        "三枝筇竹兴还新，王丈席兄俱可人。",
        "侨立司州溪水上，吟诗把酒对青春。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 3506,
      "title": "除夜次大光韵大光是夕婚",
      "content": [
        "一杯节酒莫留残，坐看新年上鬓端。",
        "只恐梅花明日老，夜瓶相对不知寒。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 3507,
      "title": "除夜不寐饮酒一杯明日示大光",
      "content": [
        "万里乡山路不通，年年佳节百忧中。",
        "催成客睡须春酒，老却梅花是晓风。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 3508,
      "title": "元日",
      "content": [
        "五年元日只流离，楚俗今年事事非。",
        "后饮屠苏惊已老，长乘舴艋竟安归。",
        "携家作客真无策，学道刳心却自违。",
        "汀草岸花知节序，一身千恨独霑衣。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 3509,
      "title": "别大光",
      "content": [
        "堂堂一年长，渺渺三秋阔。",
        "恍然衡山前，相遇各白发。",
        "岁穷窗欲霰，人老情难竭。",
        "君有杯中物，我有肝肺热。",
        "饮尽不能起，交深忘事拙。",
        "乾坤日多虞，游子屡惊骨。",
        "衡阳非不遥，雁意犹超忽。",
        "一生能几回，百计易相夺。",
        "滔滔江受风，耿耿客孤发。",
        "他夕怀君子，岩间望明月。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3510,
      "title": "道中",
      "content": [
        "雨子收还急，溪流直又斜。",
        "迢迢傍山路，漠漠满林花。",
        "破水双鸥影，掀泥百草芽。",
        "川原有高下，随处著人家。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 3511,
      "title": "金潭道中",
      "content": [
        "晴路篮舆稳，举头闲望赊。",
        "前冈春泱漭，后岭雪槎牙。",
        "海内兵犹壮，村边岁自华。",
        "客行惊节序，回眼送桃花。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 3512,
      "title": "绝句",
      "content": [
        "野鸭飞无数，桃花湿满枝。",
        "竹舆鸣细雨，山客有新诗。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 3513,
      "title": "甘棠道中",
      "content": [
        "笋舆碍石一悠然，正月微风意已便。",
        "桃花向来浑不数，山中时见绝堪怜。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 3514,
      "title": "将至杉木铺望野人居",
      "content": [
        "春风漠漠野人居，若使能诗我不如。",
        "数株苍桧遮官道，一树桃花映草庐。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 3515,
      "title": "晓发杉木",
      "content": [
        "古泽春光淡，高林露气清。",
        "纷纷世上事，寂寂水边行。",
        "客子凋双鬓，田家自一生。",
        "有诗还忘记，无酒却思倾。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 3516,
      "title": "先寄邢子友",
      "content": [
        "作客经年乐有余，邵阳歧路不崎岖。",
        "山川好处欹纱帽，桃李香中度笋舆。",
        "欲见旧交惊岁月，剩排幽话说艰虞。",
        "人间书疏非吾事，一首新诗未可无。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 3517,
      "title": "立春日雨",
      "content": [
        "衡山县下春日雨，远映青山丝样斜。",
        "容易江边欺客袂，分明沙际湿年华。",
        "竹林路隔生新水，古渡船空集乱鸦。",
        "未暇独忧巾一角，西溪当有续开花。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 3518,
      "title": "正月十二日至邵州十三日夜暴雨滂沱",
      "content": [
        "邵州正月风气殊，鹑尾之南更山坞。",
        "昨日已见三月花，今夜还闻五更雨。",
        "牋与天公一破颜，走避北狄趋南蛮。",
        "梦到龙门听涧水，觉来檐溜正潺潺。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 3519,
      "title": "初至邵阳逢入桂林使作书问其地之安危",
      "content": [
        "湖北弥年所，长沙费月余。",
        "初为邵阳梦，又作桂林书。",
        "老矣身安用，飘然计本疏。",
        "管宁辽海上，何得便端居。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 3520,
      "title": "舟泛邵江",
      "content": [
        "老去作新梦，邵江非旧闻。",
        "滩前群鹭起，柁尾川华分。",
        "落花栖客鬓，孤舟溯归云。",
        "快然心自足，不独避嚣纷。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 3521,
      "title": "过孔雀滩赠周静之",
      "content": [
        "海内无坚垒，天涯有近亲。",
        "不辞供笑语，未惯得殷勤。",
        "舟楫深宜客，溪山各放春。",
        "高眠过滩浪，已寄百年身。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 3522,
      "title": "江行晚兴",
      "content": [
        "曾听石楼水，今过邵州滩。",
        "一笑供舟子，五年经路难。",
        "云间落日淡，山下东风寒。",
        "烟岭丛花照，夕湾群鹭盘。",
        "生身后圣哲，随俗了悲欢。",
        "淹旅非吾病，悠悠良足叹。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3523,
      "title": "夜抵贞牟",
      "content": [
        "野暝犹闻远，川明不恨迟。",
        "焚山隔岸火，及我系船时。",
        "夜半青灯屋，篱前白水陂。",
        "殷勤谢地主，小筑欲深期。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 3524,
      "title": "晚步",
      "content": [
        "畎亩意不释，出门聊散忧。",
        "雨余山欲近，春半水争流。",
        "众籁夕还作，孤怀行转幽。",
        "溪西篁竹乱，微径杂归牛。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 3525,
      "title": "雨",
      "content": [
        "云物澹清晓，无风溪自闲。",
        "柴门对急雨，壮观满空山。",
        "春发苍茫内，鸟鸣篁竹间。",
        "儿童笑老子，衣湿不知还。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 3526,
      "title": "今夕",
      "content": [
        "今夕定何夕，对此山苍然。",
        "偷生经五载，幽意独已坚。",
        "微阴拱众木，静夜闻孤泉。",
        "唯应寂寞事，可以送余年。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 3527,
      "title": "暝色",
      "content": [
        "残辉度平野，列岫围青春。",
        "柴门一枝筇，日暮栖心神。",
        "暝色著川岭，高低鬰轮囷。",
        "水光忽倒树，山势欲傍人。",
        "万化元相寻，幽子意自新。",
        "肃肃夜将久，空明动边垠。",
        "田鹤吟相应，我独无荒邻。",
        "短篇不可就，所寄聊一伸。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3528,
      "title": "贞牟书事",
      "content": [
        "留侯辟谷年，汉鼎无余功。",
        "子真策不售，脱迹市门中。",
        "神仙非异人，由来本英雄。",
        "抚世独余事，用舍何必同。",
        "眷此贞牟野，息驾吾其终。",
        "苍山雨中高，缘草溪上丰。",
        "仲春水木丽，禽鸣清昼风。",
        "祸福两合绳，既解一身空。",
        "荣华信非贵，寂寞亦非穷。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3529,
      "title": "山中",
      "content": [
        "当复入州宽作期，人间踏地有安危。",
        "风流丘壑真吾事，筹策庙堂非所知。",
        "白水春陂天澹澹，苍峰晴雪锦离离。",
        "恰逢居士身轻日，正是山中多景时。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 3530,
      "title": "入城",
      "content": [
        "舴艋溯溪来，款段踏山去。",
        "入城缘底事，要识崎岖路。",
        "稻塍白纵横，茅岭青盘互。",
        "牧儿歌不休，孤客自多惧。",
        "士行犹运甓，文公亦习步。",
        "我敢忘艰难，冲烟问荒渡。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3531,
      "title": "谢主人",
      "content": [
        "春禽劝我归，主人留我住。",
        "一笑谢主人，我自归无处。",
        "拟借溪边三亩春，结茅依树不依邻。",
        "伐薪政可烦名士，分米何须待故人。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3532,
      "title": "罗江二绝  其一",
      "content": [
        "荒村终日水车鸣，陂北陂南共一声。",
        "洒面风吹作飞雨，老夫诗到此间成。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 3533,
      "title": "罗江二绝  其二",
      "content": [
        "山翁见客亦欣然，好语重重意不传。",
        "行过竹篱逢细雨，眼明双鹭立青田。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 3534,
      "title": "洛头书事",
      "content": [
        "纶巾古鹤氅，日暮槲林间。",
        "谁使翁迎客，应闻屐响山。",
        "占年又得熟，劝我不须还。",
        "村酒困壮士，水风吹醉颜。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 3535,
      "title": "三月二十日闻德音寄李德升席大光新有召命皆寓永州",
      "content": [
        "尘隔斗牛三月余，德音再与万方初。",
        "又蒙天地宽今岁，且扫轩窗读我书。",
        "自古安危关政事，随时忧喜到樵渔。",
        "零陵并起扶颠手，九庙无归计莫疏。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 3536,
      "title": "夏夜",
      "content": [
        "远游万事裂，独立数峰青。",
        "明月照山木，荒村饶夜萤。",
        "翻翻云渡汉，历历水浮星。",
        "遥舍灯已尽，幽人门未扃。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 3537,
      "title": "题东家壁",
      "content": [
        "斜阳步屧过东家，便置清樽不煮茶。",
        "高柳光阴初罢絮，嫩凫毛羽欲成花。",
        "群公天上分时栋，闲客江边管物华。",
        "醉里吟诗空跌宕，借君素壁落栖鸦。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 3538,
      "title": "曳杖",
      "content": [
        "柳条一何长，我发一何短。",
        "余日会有几，经春卧荒疃。",
        "曳杖陂西去，悠然寄萧散。",
        "田垅粲高低，白水一时满。",
        "农夫暮犹作，愧我读书懒。",
        "且复弃今兹，前峰青蹇𡶴。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3539,
      "title": "雷行雨庚戌岁闻赦作",
      "content": [
        "忆昨炎正中不融，元帅仗钺临山东。",
        "万方嗷嗷叫上帝，黄屋已照睢阳宫。",
        "呜呼吾君天所立，岂料四载犹服戎。",
        "禹巡会稽不到海，未省驾舶观民风。",
        "定知谏诤有张猛，不可危急无高共。",
        "自古美恶周必复，犬羊汝莫穷妖凶。",
        "吉语四奏元气通，德音夜发春改容。",
        "雷雨一日遍天下，父老感泣霑其胸。",
        "臣少忧国今成翁，欲起荷戟伤疲癃。",
        "小游太一未移次，大树将军莫振功。",
        "刘琨祖逖未足雄，晏球一战腥臊空。",
        "诸君努力光竹素，天子可使尘常蒙。",
        "君不见夷门山头虎复龙，向来佳气元葱葱。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3540,
      "title": "开壁置窗命曰远轩  其一",
      "content": [
        "钟妖鸣吾旁，杨獠舞吾侧。",
        "东西俱有碍，群盗何时息。",
        "丈夫堂堂躯，坐受世褊迫。",
        "仙人千仞岗，下视笑予厄。",
        "谁能久鬰鬰，持斧破南壁。",
        "窗开三尺明，空纳万里碧。",
        "岩霏杂川霭，奇变供几席。",
        "谁见老书生，轩中岸玄帻。",
        "荡漾浮世里，超遥送兹夕。",
        "倚楹发孤啸，呼月出荒泽。",
        "天公亦粲然，林壑受珠璧。",
        "会有鹤驾宾，经过来见客。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3541,
      "title": "开壁置窗命曰远轩  其二",
      "content": [
        "清晓坐南轩，望山头屡侧。",
        "居士亦岂痴，飞云方未息。",
        "乐哉此远俗，乱世免怵迫。",
        "那知百战祸，岂识三空厄。",
        "闭门美享睡，开门瞻翠壁。",
        "远客谢主人，分此一窗碧。",
        "新晴鸟鸣檐，微暑风入席。",
        "萧然此白首，岂更冒朝帻。",
        "誓将老兹地，不复数晨夕。",
        "但恨食无肉，臞仙出山泽。",
        "蛰雷转空肠，吐句作圭璧。",
        "一笑示邻家，向来无此客。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3542,
      "title": "开壁置窗命曰远轩  其三",
      "content": [
        "我昨在衡山，伤心衢路侧。",
        "岂知得此地，一坐数千息。",
        "易安生痛定，过美出饥迫。",
        "誓言如齐侯，常戒在莒厄。",
        "要将万里身，独面九年壁。",
        "如何不己奈，开窗玩霏碧。",
        "招呼面前山，浮翠落衾席。",
        "一笑等儿戏，都忘雪侵帻。",
        "人生何不娱，今夕定何夕。",
        "向来万顷胸，余地吞七泽。",
        "念此亦细事，未遽瑕生璧。",
        "聊使山中人，永记山下客。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3543,
      "title": "伤春",
      "content": [
        "庙堂无策可平戎，坐使甘泉照夕烽。",
        "初怪上都闻战马，岂知穷海看飞龙。",
        "孤臣霜发三千丈，每岁烟花一万重。",
        "稍喜长沙向延阁，疲兵敢犯犬羊锋。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 3544,
      "title": "题水西周三十三壁二首  其一",
      "content": [
        "不管先生巾欲摧，雨中艇子便撑开。",
        "青山隔岸迎人去，白鹭冲烟送酒来。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 3545,
      "title": "题水西周三十三壁二首  其二",
      "content": [
        "周子𥬠中早得春，唤人同渡一溪云。",
        "贪看雨歇前峰变，不觉斟时已十分。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 3546,
      "title": "山斋  其一",
      "content": [
        "夏郊绿已遍，山斋昼自迟。",
        "云物忽分散，余碧暮逶迤。",
        "寒暑送万古，荣枯各一时。",
        "世纷幸莫及，我麈得常持。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 3547,
      "title": "山斋  其二",
      "content": [
        "虽愧荷鉏叟，朝来亦不闲。",
        "自剪墙角树，尽纳溪西山。",
        "经行天下半，送老此窗间。",
        "日暮烟生岭，离离飞鸟还。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 3548,
      "title": "散发",
      "content": [
        "百年如寄亦何为，散发清狂未足非。",
        "南涧题诗风满面，东桥行药露霑衣。",
        "松花照夏山无暑，桂树留人吾岂归。",
        "藜杖不当轩盖用，稳扶居士莫相违。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 3549,
      "title": "六月六日夜",
      "content": [
        "蕴隆岂不坏，凉气亦徐还。",
        "独立清夜半，疏星苍桧间。",
        "晦明莽相代，天地本长闲。",
        "四顾何寥落，微风时动关。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 3550,
      "title": "六月十七夜寄邢子友",
      "content": [
        "暑雨虽不足，凉风还有余。",
        "乐此城阴夜，何殊山崦居。",
        "月明苍桧立，露下芭蕉舒。",
        "试问澄虚阁，今夕复焉如。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 3551,
      "title": "观雨",
      "content": [
        "山客龙钟不解耕，开轩危坐看阴晴。",
        "前江后岭通云气，万壑千林送雨声。",
        "海压竹枝低复举，风吹山角晦还明。",
        "不嫌屋漏无干处，正要群龙洗甲兵。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 3552,
      "title": "寄大光  其一",
      "content": [
        "心折零陵霜入鬓，更修短札问何如。",
        "江湖不是无来雁，只惯平生作报书。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 3553,
      "title": "寄大光  其二",
      "content": [
        "芭蕉急雨三更闹，客子殊方五月寒。",
        "近得会稽消息否，稍传荆渚路歧宽。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 3554,
      "title": "寄德升大光",
      "content": [
        "君王优诏起群公，也寘樵夫尺一中。",
        "易著青衫随世事，难将白发犯秋风。",
        "共谈太极非无意，能系苍生本不同。",
        "却倚紫阳千丈岭，遥瞻黄鹄九霄东。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 3555,
      "title": "次韵谢邢九思",
      "content": [
        "平生不接里闾欢，岂料相逢虺蜮坛。",
        "能赋君推三世事，倦游我弃七年官。",
        "流传恶语知谁好，勾引新篇得细看。",
        "六月山斋当暑令，风霜独发卷中寒。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 3556,
      "title": "村景",
      "content": [
        "黄昏吹角闻呼鬼，清晓持竿看牧鹅。",
        "蚕上楼时桑叶少，水鸣车处稻苗多。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 3557,
      "title": "次周漕示族人韵",
      "content": [
        "谏议遗踪尚可望，曳裾不必效邹阳。",
        "但修天爵膺人爵，始信书堂有玉堂。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 3558,
      "title": "水车",
      "content": [
        "江边终日水车鸣，我自平生爱此声。",
        "风月一时都属客，杖藜聊复寄诗情。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 3559,
      "title": "山居二首  其一",
      "content": [
        "点检行年书阀阅，山中共赋几篇诗。",
        "如今未有惊人句，更待秋风生桂枝。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 3560,
      "title": "山居二首  其二",
      "content": [
        "宅图不必烦丘令，已卜坡东涧水边。",
        "更与我为烧药灶，只愁君要买山钱。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 3561,
      "title": "拜诏",
      "content": [
        "紫阳山下闻皇牒，地藏阶前拜诏书。",
        "乍脱绿袍山色翠，新披紫绶佩金鱼。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 3562,
      "title": "别诸周二首  其一",
      "content": [
        "风送孤篷不可遮，山中城里总非家。",
        "临行有恨君知否，不见篱前稻著花。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 3563,
      "title": "别诸周二首  其二",
      "content": [
        "陇云知我欲船开，飞过江东还复回。",
        "不似周颙趋阙去，山灵应许却归来。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 3564,
      "title": "题向伯共过峡图二首  其一",
      "content": [
        "旌旗翻日淮南道，兴罢归来雪一船。",
        "正有佛光无处著，独将佳句了山川。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 3565,
      "title": "题向伯共过峡图二首  其二",
      "content": [
        "过峡新图世所传，峡中犹说泛舟仙。",
        "柱天勋业须君了，借我茅斋看十年。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 3566,
      "title": "题赵少隐青白堂三首  其一",
      "content": [
        "小谢为州不废诗，庭中草木有光辉。",
        "一林风露非人世，更著梅花相发挥。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 3567,
      "title": "题赵少隐青白堂三首  其二",
      "content": [
        "使君堂上无俗客，白白青青两胜流。",
        "添得吟诗老居士，千年一笑泽南州。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 3568,
      "title": "题赵少隐青白堂三首  其三",
      "content": [
        "雪里芭蕉摩诘画，炎天梅蕊简斋诗。",
        "它时相见非生客，看倚瑯玕一段奇。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 3569,
      "title": "次韵邢九思",
      "content": [
        "百年鼎鼎杂悲欢，老去初依六祖坛。",
        "玄晏不堪长抱病，子真那复更为官。",
        "山林未必容身得，颜面何宜与世看。",
        "白帝高寻最奇事，共君盟了不应寒。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 3570,
      "title": "遥碧轩作呈使君少隐时欲赴召",
      "content": [
        "我本山中人，尺一唤起趋埃尘。",
        "君为边城守，作意邀山入窗牖。",
        "朝来爽气如有期，送我凭轩一杯酒。",
        "丈夫已忍猿鹤羞，欲去且复斯须留。",
        "西峰木脱乱鬟拥，东岭烟破修眉浮。",
        "主人爱客山更好，醉里一笑惊蛮州。",
        "丁宁云雨莫作厄，明日青山当送客。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3571,
      "title": "石限病起",
      "content": [
        "幽人病起山深处，小院鸦鸣日午时。",
        "六尺屏风遮宴坐，一帘细雨独题诗。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 3572,
      "title": "同范直愚单履游浯溪",
      "content": [
        "潇湘之流碧复碧，上有铁立千寻壁。",
        "河朔功就人与能，湖南碑成江动色。",
        "文章得意易为好，书杂矛剑天假力。",
        "四百年来如创见，雷公雨师知此石。",
        "小儒五载忧国泪，杖藜今日溪水侧。",
        "欲搜奇句谢两公，风作浪涌空心恻。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3573,
      "title": "愚溪",
      "content": [
        "小阁当乔木，清溪抱竹林。",
        "寒声日暮起，客思雨中深。",
        "行李妨幽事，栏干试独临。",
        "终然游子意，非复昔人心。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 3574,
      "title": "己酉中秋之夕与任才仲醉于岳阳楼上明年十一月二十日南游过道谒姜光彦出才仲画轴则写是夕事也剪烛观之恍然一笑书八句以当画记",
      "content": [
        "去年中秋洞庭野，寒瑶万顷兼天泻。",
        "岳阳楼上两幅巾，月入栏干影潇洒。",
        "世间此影谁能孤，狂如我友人所无。",
        "一梦经年无续处，道州还见倚楼图。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 3575,
      "title": "甘泉吴使君使画史作简斋居士像居士见之大笑如洞山过水睹影时也戏书三十二字",
      "content": [
        "两眉轩然，意像无寄。",
        "而服如此，又不离世。",
        "鉴中壁上，处处皆是。",
        "简斋虽传，文殊无二。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 3576,
      "title": "题甘泉书院",
      "content": [
        "甘泉坊里林影黑，吴氏舍前书榜鲜。",
        "床座畧容摩诘借，桂枝应待小山传。",
        "兵横海内犹纷若，风到湖南还穆然。",
        "勉效周生述孔业，赋诗吾独愧先贤。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 3577,
      "title": "度岭一首",
      "content": [
        "年律将穷天地温，两州风气此横分。",
        "已吟子美湖南句，更拟东坡岭外文。",
        "隔水丛梅疑是雪，近人孤嶂欲生云。",
        "不愁去路三千里，少住林间看夕曛。"
      ],
      "author": {
        "id": 788,
        "name": "陈与义"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 3578,
      "title": "游秦岩",
      "content": [
        "秦岩昧旧闻，胜会非复常。",
        "异哉五里秘，发此一日狂。",
        "篝灯破大阴，拄杖入仙乡。",
        "散途杨梅实，承磴菡萏房。",
        "石液白瑶堕，泉气青霓翔。",
        "度危心欲动，逢衍兴未央。",
        "眩人黝谷深，覆我翠极长。",
        "降登穷田垅，开阖到鞠场。",
        "龙遮侧岸路，猫护高廪藏。",
        "力士倒履空，应真俨成行。",
        "碾缺神所吝，帐空仙莫量。",
        "水鸣泬寥内，柱立森罗傍。",
        "语闻受远响，力极生微阳。",
        "梦中出小窦，立处忽大荒。",
        "尘缘信深重，仙事岂渺茫。",
        "灵武唐业开，湘滨耀文章。",
        "望夷秦政坏，岭底畏祸殃。",
        "隐显非士意，安危存国纲。",
        "且复置此事，更将适何方。",
        "赋诗意未惬，吾欲栖僧廊。"
      ],
