{
  "data": [
    {
      "id": 280900,
      "title": "湘口送友人",
      "content": [
        "中流欲暮见湘烟，苇岸无穷接楚田。",
        "去雁远冲云梦雪，离人独上洞庭船。",
        "风波尽日依山转，星汉通霄向水连。",
        "零落梅花过残腊，故园归醉及新年。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 280901,
      "title": "鄂州头陀寺上方",
      "content": [
        "高寺上方无不见，天涯行客思迢迢。",
        "西江帆挂东风急，夏口城衔楚塞遥。",
        "沙渚渔归多湿网，桑林蚕后尽空条。",
        "感时叹物寻僧话，惟向禅心得寂寥。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 280902,
      "title": "寄远",
      "content": [
        "槐欲成阴分袂时，君期十日复金扉。",
        "槐今落叶已将尽，君向远乡犹未归。",
        "化石早曾闻节妇，沈湘何必独灵妃。",
        "须知此意同生死，不学他人空寄衣。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 280903,
      "title": "题张司马别墅",
      "content": [
        "庭前树尽手中栽，先后花分几番开。",
        "巢鸟恋雏惊不起，野人思酒去还来。",
        "自抛官与青山近，谁讶身为白发催。",
        "门外寻常行乐处，重重履迹在莓苔。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 280904,
      "title": "长安即事",
      "content": [
        "长遇豪家不敢过，此身谁与取高科。",
        "故园久绝书来后，南国空看雁去多。",
        "中夜永怀听叠漏，先秋归梦涉层波。",
        "愁人白发自生早，我独少年能几何。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 280905,
      "title": "汉上逢同年崔八",
      "content": [
        "去岁曾游帝里春，杏花开过各离秦。",
        "偶先托质逢知己，独未还家作旅人。",
        "世上路岐何缭绕，空中光景自逡巡。",
        "一回相见一回别，能得几时年少身。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 280906,
      "title": "五月一日蒙替本官不得随例入关感怀献送相公",
      "content": [
        "五月倾朝谒紫宸，一朝无分在清尘。",
        "含香已去星郎位，衣锦惟思婺女隣。",
        "折狱也曾为俗吏，劝农元本是耕人。",
        "知将何事酬公道，只养生灵似养身。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 280907,
      "title": "春闺怨",
      "content": [
        "红妆女儿灯下羞，画眉夫壻陇西头。",
        "自怨愁容长照镜，悔教征戍觅封侯。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 280908,
      "title": "送边将",
      "content": [
        "防秋戎马恐来奔，诏发将军出雁门。",
        "遥领短兵登陇首，独横长劒向河源。",
        "悠扬落日黄云动，苍莽阴风白草翻。",
        "若纵干戈更深入，应闻收得到昆仑。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 280909,
      "title": "太和公主还宫",
      "content": [
        "天骄发使犯边尘，汉将推功遂夺亲。",
        "离乱应无初去貌，死生难有却回身。",
        "禁花半老曾攀树，宫女多非旧识人。",
        "重上凤楼追故事，几多愁思向青春。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 280910,
      "title": "将赴黔州先寄本府中丞",
      "content": [
        "八月瞿塘到底翻，孤舟上得已销魂。",
        "幕中职罢犹趋府，阙下官成未谢恩。",
        "丹嶂耸空无过鸟，青林覆水有垂猿。",
        "感知肺腑终难说，从此辞归便扫门。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 280911,
      "title": "和友人下第北游感怀",
      "content": [
        "圣代为儒可致身，谁知又别五陵春。",
        "青门独出空归鸟，紫陌相逢尽醉人。",
        "江岛去寻垂钓远，塞山来见举头频。",
        "且须共漉边城酒，何必陶家有白纶。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 280912,
      "title": "乐游原春望",
      "content": [
        "五陵佳气晚氛氲，霸业雄图势自分。",
        "秦地山河连楚塞，汉家宫殿入青云。",
        "未央树色春中见，长乐钟声月下闻。",
        "无那杨华起愁思，满天飘落雪纷纷。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 280913,
      "title": "黄雀行",
      "content": [
        "欲窃高仓集御河，翩翩疑渡畏秋波。",
        "朱宫晚树侵莺语，画阁香帘夺燕窠。",
        "疎影暗栖寒露重，空城饥噪暮烟多。",
        "谁令不解高飞去，破宅荒庭有网罗。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 280914,
      "title": "长安寓居寄柏侍郎",
      "content": [
        "霜轻两鬓欲相侵，愁绪无端不可寻。",
        "秦女红妆空觅伴，郢郎白雪少知音。",
        "长亭古木春光老，太华青烟晚更深。",
        "独向灞陵东北望，一封书寄万重心。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 280915,
      "title": "春日思归",
      "content": [
        "春情不断若连环，一夕思归鬓欲斑。",
        "壮志未酬三尺劒，故乡空隔万重山。",
        "音书断绝干戈后，亲友相逢梦寐间。",
        "却羡浮云与飞鸟，因风吹去又吹还。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 280916,
      "title": "朔中即事",
      "content": [
        "关门南北杂戎夷，草木秋来即出师。",
        "落日风沙长暝早，穷冬雨雪转春迟。",
        "山头堠火孤明后，星外行人四绝时。",
        "自古边功何不立，汉家中外自相疑。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 280917,
      "title": "感怀献门下相公",
      "content": [
        "谁云郎选不由诗，上相怜才积有时。",
        "却是龙钟到门晚，终非稽古致身迟。",
        "谋将郡印归难遂，读著家书坐欲痴。",
        "日望南宫看列宿，迢迢婺女与乡比。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 280918,
      "title": "赠长城庾将军",
      "content": [
        "初年三十拜将军，近代英雄独未闻。",
        "向国报恩心比石，辞天作镇气凌云。",
        "逆风走马貂裘卷，望塞悬弧雁阵分。",
        "定拥节麾从此去，安西大破犬戎群。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 280919,
      "title": "浙东献郑大夫",
      "content": [
        "圣主东忧涨海滨，思移副相倚陶钧。",
        "楼台独坐江山月，舟楫先行泽国春。",
        "遥想万家开户外，近闻群盗窜诸邻。",
        "几时入去调元化，天下同为尧舜人。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 280920,
      "title": "镜湖夜泊有怀",
      "content": [
        "广水遥隄利物功，因思太守惠无穷。",
        "自从版筑兴农隙，长与耕耘致岁丰。",
        "涨接星津流荡漾，宽浮云岫动虚空。",
        "想当战国开时有，范蠡扁舟祗此中。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 280921,
      "title": "宣州献从叔大夫",
      "content": [
        "清时选地任贤明，从此观风辍尹京。",
        "日月天中辞洛邑，云山江上领宣城。",
        "万家闾井俱安寝，千里农桑竟起耕。",
        "闻说圣朝同汉代，已愁征入拜公卿。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 280922,
      "title": "贺同年翰林从叔舍人知制诰",
      "content": [
        "仙禁何人蹑近踪，孔门先选得真龙。",
        "别居云路抛三省，专掌天书在九重。",
        "五色毫挥成涣汗，百寮班下独从容。",
        "芳年贵盛谁为比，郁郁青青岳顶松。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 280923,
      "title": "吴门别主人",
      "content": [
        "早晚更看吴苑月，小斋长忆落西窗。",
        "不知明夜谁家见，应照离人隔楚江。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 280924,
      "title": "自黔中归新安",
      "content": [
        "朝过春关辞北阙，暮参戎幕向南巴。",
        "却将仙桂东归去，江月相随直到家。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 280925,
      "title": "奉和郑薰相公",
      "content": [
        "三四株松匝草亭，便成彭泽柳为名。",
        "莲峰隐去难辞阙，浐水朝回与出城。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 280926,
      "title": "及第后还家过岘岭",
      "content": [
        "魏驮山前一朵花，岭西更有几千家。",
        "石斑鱼鲊香冲鼻，浅水沙田饭遶牙。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 280927,
      "title": "春日旅舍",
      "content": [
        "未识东西南北路，青春白日坐销难。",
        "如何一别故园后，五度花开五处看。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 280928,
      "title": "过长江伤贾岛",
      "content": [
        "忽从一宦远流离，无罪无人子细知。",
        "到得长江闻杜宇，想君魂魄也相随。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 280929,
      "title": "自遣",
      "content": [
        "永拟东归把钓丝，将行忽起半心疑。",
        "青云道是不平地，还有平人上得时。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 280930,
      "title": "寄曹邺",
      "content": [
        "终南山是枕前云，禁鼓无因晓夜闻。",
        "朝客秋来不朝日，曲江西岸去寻君。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 280931,
      "title": "述怀",
      "content": [
        "望月疑无得桂缘，春天又待到秋天。",
        "杏花开与槐花落，愁去愁来过几年。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 280932,
      "title": "客洛酬刘驾",
      "content": [
        "浮世总应相送老，共君偏更远行多。",
        "此回不似前回别，听尽离歌逐櫂歌。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 280933,
      "title": "题钓台障子",
      "content": [
        "君家尽是我家山，严子前台枕古湾。",
        "却把钓竿终不可，几时入海得鱼还。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 280934,
      "title": "题阳山顾炼师草堂",
      "content": [
        "若到当时上升处，长生何事后无人。",
        "前峰自去种松子，坐见年来取茯神。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 280935,
      "title": "闻金吾妓唱梁州",
      "content": [
        "闻君一曲古梁州，惊起黄云塞上愁。",
        "秦女树前花正发，北风吹落满城秋。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 280936,
      "title": "游蜀回简友人",
      "content": [
        "别来十二月，去到漏天边。",
        "不是因逢闰，还应是隔年。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 280937,
      "title": "赠泾州王侍御",
      "content": [
        "一旦天书下紫微，三年旌斾陇云飞。",
        "塞门无事春空到，边草青青战马肥。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 280938,
      "title": "夏日宿秘书姚监宅",
      "content": [
        "贵宅多嘉树，先秋有好风。",
        "情闲离阙下，梦野在山中。",
        "露色浮寒瓦，萤光堕暗丛。",
        "听吟丽句尽，河汉任西东。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280939,
      "title": "过嵩阴隐者",
      "content": [
        "当门看少室，倚杖复披衣。",
        "每日醒还醉，无人是与非。",
        "架书抽读乱，庭果摘尝稀。",
        "独有江南客，思家未得归。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280940,
      "title": "留别山家",
      "content": [
        "闲门不易求，半月在林丘。",
        "已与山水别，难为花木留。",
        "孤怀归静夜，远会隔高秋。",
        "莫道无言去，冥心在重游。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280941,
      "title": "送人游吴",
      "content": [
        "楚田开雪后，草色与君看。",
        "积水浮春气，深山滞雨寒。",
        "毗陵孤月出，建业一钟残。",
        "为把乡书去，因收别泪难。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280942,
      "title": "东渭桥晚眺",
      "content": [
        "秦地有吴洲，千樯渭曲头。",
        "人当返照立，水彻故乡流。",
        "落第春难过，穷途日易愁。",
        "谁知桥上思，万里在江楼。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280943,
      "title": "送延陵韦少府",
      "content": [
        "延陵称贵邑，季子有高踪。",
        "古迹传多代，仙山管几峰。",
        "微泉声小雨，异木色深冬。",
        "去毕三年秩，新诗箧不容。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280944,
      "title": "淮南送友人归沧州",
      "content": [
        "风色忽西转，坐为千里分。",
        "高帆背楚落，寒日逆淮曛。",
        "断烧缘乔木，盘雕隐片云。",
        "乡关百战地，归去始休军。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 280945,
      "title": "夏日题盩厔友人书斋",
      "content": [
        "修竹齐高树，书斋竹树中。",
        "四时无夏气，三伏有秋风。",
        "黑处巢幽鸟，阴来呌候虫。",
        "牕西太白雪，万仞在遥空。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280946,
      "title": "寻山",
      "content": [
        "一迳入双崖，初疑有几家。",
        "行穷人不见，坐久日空斜。",
        "石上生灵草，泉中落异花。",
        "终须结茅屋，向此学餐霞。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280947,
      "title": "送元遂上人归钱唐",
      "content": [
        "白衣游帝乡，已得事空王。",
        "却返湖山寺，高禅水月房。",
        "雨中过岳黑，秋后宿船凉。",
        "回顾秦人语，他生会别方。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280948,
      "title": "贻友人喻坦之",
      "content": [
        "从容心自切，饮水胜衔杯。",
        "共在山中长，相随阙下来。",
        "修身空有道，取事各无媒。",
        "不信升平代，终遗草泽才。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280949,
      "title": "送友人往振武",
      "content": [
        "风沙遥见说，道路替君愁。",
        "碛夜星垂地，云明火上楼。",
        "征鸿辞塞雪，战马识边秋。",
        "不共将军语，何因有去留。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 280950,
      "title": "赋得长城斑竹杖",
      "content": [
        "秦兴版筑时，翦伐不知谁。",
        "异代余根在，幽人得手持。",
        "细看生古意，闲倚动边思。",
        "莫作鸠形并，空将鹤髪期。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280951,
      "title": "送德清喻明府",
      "content": [
        "棹返霅溪云，仍参旧使君。",
        "州传多古迹，县记是新文。",
        "水栅横舟闭，湖田立木分。",
        "但如诗思苦，为政即超群。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280952,
      "title": "送薛能少府任盩厔",
      "content": [
        "不才甘下第，君子蹇何重。",
        "相送昆明岸，同看太白峰。",
        "数瓢留顷刻，残照迫从容。",
        "好去烟霞县，仙人有旧踪。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280953,
      "title": "送许寿下第归东山",
      "content": [
        "吾君设礼闱，谁合学忘机。",
        "却是高人起，难为下第归。",
        "出关心纵野，避世事终稀。",
        "莫更今秋夕，相思望少微。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280954,
      "title": "冬夜酬范秘书",
      "content": [
        "九衢行一匝，不敢入他门。",
        "累日无余事，通宵得至言。",
        "命嗟清世蹇，春觉闰冬暄。",
        "翻覆吟佳句，何酬国士恩。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280955,
      "title": "送陆肱尉江夏",
      "content": [
        "如何执简去，便作挂帆期。",
        "泽国三春早，江天落日迟。",
        "县人齐候处，洲鸟欲飞时。",
        "免褐方三十，青云岂白髭。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280956,
      "title": "汉上送人西归",
      "content": [
        "几作西归梦，因为怆别心。",
        "野衔天去尽，山夹汉来深。",
        "叠浪翻残照，高帆引片阴。",
        "空留相赠句，毕我白头吟。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280957,
      "title": "蜀中逢友人",
      "content": [
        "自古有行役，谁人免别家。",
        "相欢犹陌上，一醉任天涯。",
        "积叠山藏蜀，潺湲水遶巴。",
        "他年复何处，共说海棠花。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280958,
      "title": "寄范评事",
      "content": [
        "行坐不相遗，辕门载笔时。",
        "雅知难更遇，旧分合长思。",
        "梦即重寻熟，书常转达迟。",
        "山斋终拟到，何日遂心期。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280959,
      "title": "南游过湘汉即事寄友人",
      "content": [
        "南去远駈逐，三湘五月行。",
        "巴山雪水下，楚泽火云生。",
        "向野聊中饭，乘凉探暮程。",
        "离怀不可说，已迫峡猿声。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280960,
      "title": "送许浑侍御赴润州",
      "content": [
        "家山近石头，遂意恣东游。",
        "祖席离乌府，归帆转蜃楼。",
        "阴氛出海散，落月向潮流。",
        "别有为霖日，孤云未自由。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280961,
      "title": "喜友人厉图南及第",
      "content": [
        "相忧过己切，相贺似身荣。",
        "心达无前后，神交共死生。",
        "承家吾子事，登第世人情。",
        "未有通儒术，明时道不行。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280962,
      "title": "送友人下第归越",
      "content": [
        "归意随流水，江湖共在东。",
        "山阴何处去，草际片帆通。",
        "雨色春愁里，潮声晓梦中。",
        "虽为半年客，便是往来鸿。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 280963,
      "title": "寄友人",
      "content": [
        "一别一相见，须臾老此生。",
        "客衣寒后薄，山思夜深清。",
        "诗近吟何句，髭新白几茎。",
        "路岐如昨日，来往梦分明。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280964,
      "title": "送友人下第归宛陵",
      "content": [
        "天涯长恋亲，阙下独伤春。",
        "拟住还求己，须归不为身。",
        "临岐仍犯雪，挂席始离尘。",
        "共泣东风别，同为沧海人。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 280965,
      "title": "秋夜对月寄鳯翔范书记",
      "content": [
        "月过秋霖后，光应夜夜清。",
        "一回相忆起，几度独吟行。",
        "河汉东西直，山川远近明。",
        "寸心遥往处，新有雁来声。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280966,
      "title": "送孙明秀才往潘州访韦卿",
      "content": [
        "北鸟飞不到，北人今去游。",
        "天涯浮瘴水，岭外问潘州。",
        "草木春冬茂，猿猱日夜愁。",
        "定知迁客泪，应只对君流。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280967,
      "title": "八月十五夜对月",
      "content": [
        "阴盛此宵中，多为雨与风。",
        "坐无云雨至，看与雪霜同。",
        "抱湿离遥海，倾寒向逈空。",
        "年年不可值，还似命难通。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280968,
      "title": "及第后归",
      "content": [
        "家临浙水傍，岸对买臣乡。",
        "纵棹随归鸟，乘潮向夕阳。",
        "苦吟身得雪，甘意鬓成霜。",
        "况此年犹少，酬知足自强。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280969,
      "title": "过巫峡",
      "content": [
        "拥棹向惊湍，巫峰直上看。",
        "削成从水底，耸出在云端。",
        "暮雨晴时少，啼猿渴下难。",
        "一闻神女去，风竹扫空坛。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280970,
      "title": "送友人往太原",
      "content": [
        "离亭聊把酒，此路彻边头。",
        "草白雁来尽，时清人去游。",
        "汾河流晋地，塞雪满幷州。",
        "别后相思夜，空看北斗愁。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 280971,
      "title": "旅怀",
      "content": [
        "万里共心论，徒言吾道存。",
        "奉亲无别业，谒帝有何门。",
        "水宿惊涛浦，山行落叶村。",
        "长安长梦去，欹枕即闻猿。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280972,
      "title": "送裴御史赴湖南",
      "content": [
        "关门鸟道中，飞传复乘骢。",
        "暮雪离秦甸，春云入楚宫。",
        "平芜天共阔，积水地多空。",
        "使府悬帆去，能消几日风。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280973,
      "title": "送姚郜先辈赴汝州辟",
      "content": [
        "行李事寒天，东来聘礼全。",
        "州当定鼎处，人去偃戈年。",
        "雷雨依嵩岭，桑麻接楚田。",
        "遥知清夜作，不是借戎篇。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280974,
      "title": "初离黔中泊江上",
      "content": [
        "去去把青桂，平生心不违。",
        "更蒙莲府辟，兼脱布衣归。",
        "霁岳明残雪，清波漾落晖。",
        "无穷幽鸟戏，时向棹前飞。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280975,
      "title": "黔中酬同院韦判官",
      "content": [
        "平生同所为，相遇偶然迟。",
        "各著青袍后，无归白社期。",
        "江流来绝域，府地管诸夷。",
        "圣代都无事，从公且赋诗。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280976,
      "title": "和范秘书襄阳旧游",
      "content": [
        "听话扬帆兴，初从岘首还。",
        "高吟入白浪，遥坐看青山。",
        "枯木猿啼爽，寒汀鹤步闲。",
        "秋来关去梦，几夜度商颜。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280977,
      "title": "秋夜山中思归送友人",
      "content": [
        "萧条对秋色，相忆在云泉。",
        "木落病身起，潮平归思悬。",
        "凉钟山顶寺，暝火渡头船。",
        "此地非吾土，淹留又一年。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 280978,
      "title": "自黔中东归旅次淮上",
      "content": [
        "行旅本同愁，黔吴复阻修。",
        "半年方中路，穷节到孤舟。",
        "夕霭垂阴野，晨光动积流。",
        "家山一夜梦，便是昔年游。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280979,
      "title": "江夏春感旧",
      "content": [
        "东风出海门，处处动林园。",
        "泽国雪霜少，沙汀花木繁。",
        "暖鱼依水浅，晴雁入空翻。",
        "何处阳和力，生萍不驻根。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280980,
      "title": "眉州别李使君",
      "content": [
        "回首雪峰前，朱门心杳然。",
        "离人自呜咽，流水莫潺湲。",
        "毒草通蛮徼，秋林近漏天。",
        "一生从此去，五字有谁怜。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280981,
      "title": "送许棠及第归宣州",
      "content": [
        "高科终自致，志业信如神。",
        "待得逢公道，由来合贵身。",
        "秋归方觉好，旧梦始知真。",
        "更想青山宅，谁为后主人。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280982,
      "title": "黔中罢职将泛江东",
      "content": [
        "黔中初罢职，薄俸亦无残。",
        "举目乡关远，携家旅食难。",
        "野梅将雪竞，江月与沙寒。",
        "两鬓愁应白，何劳把镜看。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280983,
      "title": "长安书事寄所知",
      "content": [
        "帝里本无名，端居有道情。",
        "睡魂春梦断，书兴晚窗明。",
        "老拟归何处，闲应过此生。",
        "江湖终一日，拜别便东行。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280984,
      "title": "酬姚覃",
      "content": [
        "不见又相招，何曾诉寂寥。",
        "醉眠春草长，吟坐夜灯销。",
        "泪堕思山切，身归转路遥。",
        "年年送别处，杨柳少垂条。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280985,
      "title": "春日鄜州赠裴居言",
      "content": [
        "虽将身佐幕，出入似闲居。",
        "草色长相待，山情信不疎。",
        "灯前春睡足，酒后夜寒余。",
        "笔砚时时近，终非署簿书。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280986,
      "title": "送于生入蜀",
      "content": [
        "家吴闻入蜀，道路颇乖离。",
        "一第何多难，都城可少知。",
        "江山非久适，命数未终奇。",
        "况又将冤抱，经春杜魄随。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280987,
      "title": "送许棠归泾县作尉",
      "content": [
        "青桂复青袍，一归荣一高。",
        "县人齐下拜，邑宰共分曹。",
        "遶郭看秧插，寻街听茧缫。",
        "封侯万里者，燕颔乃徒劳。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280988,
      "title": "友人话别",
      "content": [
        "论交虽不蚤，话别且相亲。",
        "除却栖禅客，谁非南陌人。",
        "半生都返性，终老拟安贫。",
        "愿入白云社，高眠自致身。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280989,
      "title": "山居",
      "content": [
        "欲出穷吾道，东西自未能。",
        "卷书唯对鹤，开画独留僧。",
        "落叶和云扫，秋山共月登。",
        "何年石上水，夜夜滴高层。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280990,
      "title": "寄范郎中",
      "content": [
        "蔾杖山中出，吟诗对范家。",
        "相知从海峤，寄食向京华。",
        "名宦成何报，清眸未纵赊。",
        "临邛梦来往，雨雪满襃斜。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280991,
      "title": "书怀",
      "content": [
        "宦途从不问，身事觉无差。",
        "华髪初生女，沧洲未有家。",
        "却闲思洞穴，终老旷桑麻。",
        "别访栖禅侣，相期语劫沙。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280992,
      "title": "越中行",
      "content": [
        "越国临沧海，芳洲复暮晴。",
        "湖通诸浦白，日隐乱峰明。",
        "野宿多无定，闲游免有情。",
        "天台闻不远，终到石桥行。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280993,
      "title": "春日南游寄浙东许同年",
      "content": [
        "孤帆处处宿，不问是谁家。",
        "南国平芜远，东风细雨斜。",
        "旅怀多寄酒，寒意欲留花。",
        "更想前途去，茫茫沧海涯。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280994,
      "title": "明州江亭夜别段秀才",
      "content": [
        "离亭向水开，时候复蒸梅。",
        "霹雳灯烛灭，蒹葭风雨来。",
        "京关虽共语，海峤不同回。",
        "莫为莼鲈美，天涯滞尔才。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280995,
      "title": "临岐留别相知",
      "content": [
        "百岁竟何事，一身长远游。",
        "行行将近老，处处不离愁。",
        "世路多相取，权门不自投。",
        "难为此时别，欲别愿人留。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280996,
      "title": "鄂渚湖上即事",
      "content": [
        "杜门聊自适，湖水在窗间。",
        "纵得沧洲去，无过白日闲。",
        "多慵空好道，少贱早凋颜。",
        "独有东山月，依依自往还。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280997,
      "title": "辞夏口崔尚书",
      "content": [
        "一饭仍难受，依仁况一年。",
        "终期身可报，不拟骨空镌。",
        "城晚风高角，江春浪起船。",
        "同来栖止地，独去塞鸿前。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280998,
      "title": "秦原早望",
      "content": [
        "一忝乡书荐，长安未得回。",
        "年光逐渭水，春色上秦台。",
        "燕掠平芜去，人冲细雨来。",
        "东风生故里，又过几花开。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 280999,
      "title": "送友人之扬州",
      "content": [
        "一别长安后，晨征便信鸡。",
        "河声入峡急，地势出关低。",
        "绿树丛垓下，青芜阔楚西。",
        "路长知不恶，随处得诗题。"
      ],
      "author": {
        "id": 5772,
        "name": "李频"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    }
  ],
