    {
      "id": 309560,
      "title": "望洞庭湖赠张丞相",
      "content": [
        "八月湖水平，涵虚混太清。",
        "气蒸云梦泽，波撼岳阳城。",
        "欲济无舟楫，端居耻圣明。",
        "坐观垂钓者，空有羡鱼情。"
      ],
      "author": {
        "id": 10243,
        "name": "孟浩然"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
