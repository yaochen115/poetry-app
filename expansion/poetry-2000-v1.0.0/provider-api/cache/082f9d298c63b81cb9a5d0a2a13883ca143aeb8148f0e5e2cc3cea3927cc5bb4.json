{
  "data": [
    {
      "id": 45492,
      "title": "胡季永挽词二首  其一",
      "content": [
        "澹庵潜圣学，未许外人传。",
        "门里存衣钵，吟边可管弦。",
        "浣花宗武辔，儋耳小坡船。",
        "绿鬓成黄壤，从今更问天。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 45493,
      "title": "胡季永挽词二首  其二",
      "content": [
        "一昨官都下，同时寄客间。",
        "相从湖上寺，览遍浙西山。",
        "骏足应千里，彪文未一斑。",
        "霜风吹病眼，老泪为渠潸。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 45494,
      "title": "送徐吉水解组造朝",
      "content": [
        "我住南溪溪北涯，闭门草长不曾开。",
        "风窗只怪灯花喜，雪径传呼县尹来。",
        "道是朝廷举廉吏，如何江海尚遗才。",
        "西枢东观俱知己，拜了除书却探梅。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 45495,
      "title": "寄题萧民望扶疎堂二首  其一",
      "content": [
        "不栽繁杏试晴红，不种垂杨拂暖茸。",
        "堂下生涯无一物，月中修竹雪中松。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45496,
      "title": "寄题萧民望扶疎堂二首  其二",
      "content": [
        "株松个竹已奇奇，那更扶疎荫碧漪。",
        "唤醒渊明千载梦，政缘泸水一篇诗。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45497,
      "title": "送奔医时亨往攸县省觐",
      "content": [
        "雪恰来时子恰行，白云飞边双眼明。",
        "阿母几年不相见，阿兄唤渠来作伴。",
        "探囊半粒黄金丹，湘南小儿开病颜。",
        "江西两奔留不住，并被湘南夺将去。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 45498,
      "title": "晚步",
      "content": [
        "半疋轻烟束翠山，一梳寒月印青天。",
        "生憎野烧无端甚，直上高林杳霭边。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45500,
      "title": "题刘直卿崇兰轩",
      "content": [
        "风亦何须过，林仍不厌深。",
        "莫将春色眼，来看岁寒心。",
        "政坐香通国，端令佩满襟。",
        "楚人更饶舌，得免世间寻。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 45501,
      "title": "寄题朱景元直节轩二首  其一",
      "content": [
        "见说幽居似渭川，一川修竹雪霜寒。",
        "如何翦得苍苍玉，乞与诚斋作钓竿。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45502,
      "title": "寄题朱景元直节轩二首  其二",
      "content": [
        "月到梢头十倍明，风来叶底百分清。",
        "尽言直节无人会，岁晚君看太瘦生。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45503,
      "title": "和同年梁韶州寺丞次张寄诗",
      "content": [
        "故人一别恰三年，谁与论诗更说禅。",
        "忽报一麾官岭外，寄来七字雪梅前。",
        "人惟南内班行旧，语带西湖山水鲜。",
        "安得对床吟至晓，旋烹山茗试溪泉。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 45504,
      "title": "送永新杜宰解印还朝",
      "content": [
        "去年摘山初弄兵，永新县前戈剑腥。",
        "杜侯不持一寸铁，闭阁坚卧民不惊。",
        "军前米作山谷聚，木牛流马安用许。",
        "但令绿林无点尘，何须烂额画麒麟。",
        "紫皇急才宵不寐，斯人合著班行里。",
        "速骑匹马谒明光，夜来溪风吹玉霜。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 45505,
      "title": "探梅",
      "content": [
        "山间幽步不胜奇，政是深寒浅暮时。",
        "一树梅花开一朶，恼人偏在最高枝。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45506,
      "title": "霜夜",
      "content": [
        "月影全无只有星，如何夜色照人清。",
        "素娥未必饶青女，不道霜明胜月明。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45507,
      "title": "月下梅花",
      "content": [
        "天恐梅花不耐寒，遣将孤月问平安。",
        "未须一夜都开尽，留取前前后后看。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45508,
      "title": "访周仲觉夜宿南岭月色粲然晓起路湿闻有夜雨",
      "content": [
        "夜晴那得晓来泥，才见金钲浴绀池。",
        "一阵五更松上雨，元来睡著不曾知。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45509,
      "title": "过西坑",
      "content": [
        "干风无那湿云何，吹不能开只助他。",
        "野水落溪生蟹眼，一番过了一番多。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45510,
      "title": "观陂水",
      "content": [
        "波缓沤迟似让行，忽然赴壑怒还生。",
        "东归到底谁先后，何用争流作许声。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45511,
      "title": "刘村渡二首  其一",
      "content": [
        "隔岸轻舟不可呼，小桥独木有如无。",
        "落松满地金钗瘦，远树黏天菌子孤。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45512,
      "title": "刘村渡二首  其二",
      "content": [
        "旷野风从脚底生，远峰顶与额般平。",
        "何人知道诚斋叟，独著驼裘破雨行。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45513,
      "title": "晚归遇雨",
      "content": [
        "略略烟痕草许低，初初雨影伞先知。",
        "溪回谷转愁无路，忽有梅花一两枝。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45514,
      "title": "和闽漕傅安道郎中送毛平仲诗韵寄谢惠书及诗",
      "content": [
        "宣城讯后忽年余，闽水风来又岁除。",
        "人品只今推正始，诗声何止过黄初。",
        "岂无天上同朝友，不寄山中半纸书。",
        "珍重故人多问我，鬓毛半脱齿全疎。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 45515,
      "title": "丁酉初春和张钦夫榕溪阁五言",
      "content": [
        "榕影下照水，翠蛟舒复樛。",
        "溪光逆升簷，朱夏冻以幽。",
        "高阁昔雨荒，奇观久风休。",
        "南轩天遣来，山谷神与谋。",
        "宇新址惟旧，景逝人为留。",
        "不意猿饮潭，复见驷驾辀。",
        "先生何孤往，野客欠从游。",
        "愿携龙文璧，去瀹兔褐瓯。",
        "垂手掬寒泚，移床听凉飕。",
        "阁迥诗更超，古往今亦犹。",
        "揽渠五字妙，觉我百疾瘳。",
        "出山未遽误，在山未遽优。",
        "如何近来梦，夜夜在钓舟。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 45516,
      "title": "曾达臣挽词二首  其一",
      "content": [
        "珠冻兰溪水，冰封玉笥山。",
        "是翁元不死，蜕骨此中间。",
        "书画今存否，仪刑杳莫攀。",
        "端令郡博士，陟岵泪斑斑。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 45517,
      "title": "曾达臣挽词二首  其二",
      "content": [
        "议论千千古，胸怀一一奇。",
        "非关时弃我，不肯我干时。",
        "老鹤云间意，长松雪外姿。",
        "平生独知命，冷眼看人痴。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 45518,
      "title": "题刘景明百牛图扇面",
      "content": [
        "吉语闻田父，新年胜故年。",
        "借侬百觳觫，雨里破荒田。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 45519,
      "title": "题刘景明百马图扇面",
      "content": [
        "雾鬣如无笔，霜蹄不带埃。",
        "直言明眼著，若个是龙媒。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 45520,
      "title": "题邓国材水墨寒林",
      "content": [
        "人间那得个山川，船上渔郎便是仙。",
        "远岭外头江尽处，问渠何许洞中天。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45521,
      "title": "春寒绝句",
      "content": [
        "几丝微雨噀前山，半点轻寒健牡丹。",
        "只道一春晴较少，到它晴了是春残。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45522,
      "title": "雨中酴醾",
      "content": [
        "翡翠堆头乱不梳，梅花脑子糁肌肤。",
        "夜来急雨元无事，晓起看花一片无。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45523,
      "title": "晚春即事二绝  其一",
      "content": [
        "尺许新条长杏栽，丈余斑笋出墙隈。",
        "浪愁草草酴醾过，不道婷婷芍药来。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45524,
      "title": "晚春即事二绝  其二",
      "content": [
        "树头吹得叶冥冥，三日颠风不小停。",
        "只是向来枯树子，知他那得许多青。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45525,
      "title": "寄题邹虞卿觌仙阁",
      "content": [
        "仙山去天才一握，与山相高邹氏阁。",
        "月波吹面寒欲冰，斗柄挂簷危不落。",
        "叶县双凫那复飞，缑山一鹤何时归。",
        "王仙肯来阁上否，共丝麟脯倾天酒。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 45526,
      "title": "入城",
      "content": [
        "杜鹃有底怨春啼，燕子无端贴水飞。",
        "不种自红仍自白，野酴醾压野蔷薇。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45527,
      "title": "永和放船二首  其一",
      "content": [
        "永和不到又经秋，淡日微风好放舟。",
        "最是可怜江上路，人来人去几时休。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45528,
      "title": "永和放船二首  其二",
      "content": [
        "濒江楼阁祇遥看，却恐登临不足观。",
        "已是老来无眼力，更供两岸万峰寒。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45529,
      "title": "丁酉四月十日之官毗陵舟行阻风宿椆陂江口二首  其一",
      "content": [
        "虫声两岸不堪闻，把烛销愁且一尊。",
        "谁宿此船愁似我，船篷犹带烛烟痕。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45530,
      "title": "丁酉四月十日之官毗陵舟行阻风宿椆陂江口二首  其二",
      "content": [
        "十里江行一日程，出山似被北风嗔。",
        "东窗水影西窗月，并照船中不睡人。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45531,
      "title": "舟次西径",
      "content": [
        "夜来徐汊伴鸥眠，西径晨炊小泊船。",
        "芦荻渐多人渐少，鄱阳湖尾水如天。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45532,
      "title": "余干溯流至安仁",
      "content": [
        "半篙新涨满帆风，两岸千山一抹中。",
        "惭媿櫂郎能袖手，若非袖手更无功。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45533,
      "title": "宿小沙溪  其一",
      "content": [
        "树捧山烟补缺云，风揉花雨作香尘。",
        "绿杨尽道无情著，何苦垂条拂路人。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45534,
      "title": "宿小沙溪  其二",
      "content": [
        "诸峰知我厌泥行，卷尽痴云放嫩晴。",
        "不分竹梢含宿雨，时将残点滴寒声。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45535,
      "title": "玉山道中",
      "content": [
        "村北村南水响齐，巷头巷尾树阴低。",
        "青山自负无尘色，尽日殷勤照碧溪。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45536,
      "title": "入常山界二首  其一",
      "content": [
        "老随千骑赴毗陵，骑吏朝来有喜声。",
        "未到常山三十里，此身已在浙中行。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45537,
      "title": "入常山界二首  其二",
      "content": [
        "昨日愁霖今喜晴，好山夹路玉亭亭。",
        "一峰忽被云偷去，留得峥嵘半截青。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45538,
      "title": "小憩栟楮",
      "content": [
        "笋舆放下倦腾腾，睡倚胡床撼不应。",
        "榉柳细花吹面落，误挥团扇扑飞蝇。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45539,
      "title": "过招贤渡四首  其一",
      "content": [
        "归舟曾被此滩留，说著招贤梦亦愁。",
        "五月雪飞人不信，一来滩下看涛头。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45540,
      "title": "过招贤渡四首  其二",
      "content": [
        "一江故作两江分，立杀呼船隔岸人。",
        "柳上青虫宁许劣，垂丝到地却回身。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45541,
      "title": "过招贤渡四首  其三",
      "content": [
        "倦游客子自无聊，不是江山景不饶。",
        "危岸崩沙新改路，断渠横石自成桥。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45542,
      "title": "过招贤渡四首  其四",
      "content": [
        "岸上行人莫叹劳，长年三老政呼号。",
        "也知滩恶船难上，仰踏桅竿卧著篙。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45543,
      "title": "苕溪登舟",
      "content": [
        "深于池沼浅于河，动地风来也不波。",
        "只道东来行役苦，胡床面面是菱荷。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45544,
      "title": "舟过德清",
      "content": [
        "人家两岸柳阴边，出得门来便入船。",
        "不是全无最佳处，何窗何户不清妍。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45545,
      "title": "舟泊吴江三首  其一",
      "content": [
        "独立吴江第四桥，桥南桥北渺银涛。",
        "此身真在吴江里，不用并州快剪刀。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45546,
      "title": "舟泊吴江三首  其二",
      "content": [
        "江湖便是老生涯，佳处何妨且泊家。",
        "自汲松江桥下水，垂虹亭上试新茶。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45547,
      "title": "舟泊吴江三首  其三",
      "content": [
        "东是吴江西太湖，长桥横截万寻余。",
        "江妃舞倦凌波袜，玉带围腰揽镜初。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45548,
      "title": "七月十四日雨后毗陵郡圃荷桥上纳凉",
      "content": [
        "荷叶迎风听，荷花过雨看。",
        "移床桥上坐，堕我镜中寒。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 45549,
      "title": "暮立荷桥",
      "content": [
        "欲问红蕖几莟开，忽惊浴罢夕阳催。",
        "也知今夕来差晚，犹胜穷忙不到来。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45550,
      "title": "秋热追凉池上",
      "content": [
        "圃迥人全寂，池清虑自消。",
        "萍根微著水，荷叶欲穿桥。",
        "今岁知何故，秋阳尔许骄。",
        "追凉犹有处，此老未无聊。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 45551,
      "title": "秋凉晚步",
      "content": [
        "秋气堪悲未必然，轻寒政是可人天。",
        "绿池落尽红蕖却，荷叶犹开最小钱。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45552,
      "title": "毗陵郡斋冬至晴寒",
      "content": [
        "竹屋消残半瓦霜，冰河冻裂一渔航。",
        "不须宫线量曦影，化日今年特地长。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45553,
      "title": "蜡梅",
      "content": [
        "天向梅梢别出奇，国香未许世人知。",
        "殷勤滴蜡缄封却，偷被霜风拆一枝。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45554,
      "title": "登浄远亭",
      "content": [
        "池冰受日未全开，旋旋波痕百皱来。",
        "野鸭被人惊得惯，作群飞去却飞回。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45555,
      "title": "戊戌正月二日雪作二首  其一",
      "content": [
        "雪与新春作伴回，捣霜为片雹为埃。",
        "只愁雪虐梅无奈，不道梅花领雪来。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45556,
      "title": "戊戌正月二日雪作二首  其二",
      "content": [
        "梦回纸帐怪生寒，童子传呼雪作团。",
        "已被晓风融作水，头巾不裹起来看。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45557,
      "title": "戏题郡斋水墨坐屏二面二首  其一",
      "content": [
        "两客呼船一急行，树林半落半犹青。",
        "诸峰最是中峰好，我欲峰头筑小亭。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45558,
      "title": "戏题郡斋水墨坐屏二面二首  其二",
      "content": [
        "荆溪四面四无山，不是荒林即野田。",
        "忽有石崖天半出，飞泉落处稍人烟。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45559,
      "title": "郡圃小梅一枝先开",
      "content": [
        "小窠梅树太尖新，先为东风觅得春。",
        "后日千株空玉雪，如今一朶许精神。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45560,
      "title": "戏赠子仁姪",
      "content": [
        "小阮新来觅句忙，自携破砚汲寒江。",
        "天公念子抄诗苦，借与朝阳小半窗。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45561,
      "title": "浄远亭晚望",
      "content": [
        "㶉𫛶娇红野鸭青，为人浮没为人鸣。",
        "忽闻风起仍波起，乃是飞声与落声。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45562,
      "title": "郡斋梅花",
      "content": [
        "月朶千痕雪半梢，便无雪月更飘萧。",
        "不应腊尾春头里，两岁风光一并饶。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45563,
      "title": "雪后寻梅",
      "content": [
        "去年看梅南溪北，月作主人梅作客。",
        "今年看梅荆溪西，玉为风骨雪为衣。",
        "腊前欲雪竟未雪，梅花不惯人间热。",
        "横枝憔悴涴晴埃，端令羞面不肯开。",
        "缟裙夜诉玉皇殿，乞得天花来作伴。",
        "三更滕六驾海神，先遣东风吹玉尘。",
        "梅仙晓沐银浦水，冰肤别放瑶林春。",
        "诗人莫作雪前看，雪后精神添一半。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 45564,
      "title": "雪霁出城",
      "content": [
        "梅于雪后较多花，草亦晴初忽几芽。",
        "河冻落痕余一寸，残冰阁在柳根沙。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45565,
      "title": "正月十九日五更诣天庆观谢雪闻都下尺雪旬日而毗陵三四微雪而已",
      "content": [
        "元宵风物又阑残，闭阁何曾出一看。",
        "尚觉烛光欺病眼，旋添衣著试春寒。",
        "中都尺雪逾旬许，此地飞花逐片干。",
        "不待珠宫香火了，海风吹上紫金盘。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 45566,
      "title": "雪中看梅",
      "content": [
        "犯雪寻梅雪满衣，池边梅映竹边池。",
        "要寻疎影横斜底，拣尽南枝与北枝。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45567,
      "title": "梅花",
      "content": [
        "花早春何力，香寒晓尽吹。",
        "月摇横水影，雪带入瓶枝。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 45568,
      "title": "春梦纷纭",
      "content": [
        "烛花半作紫芝开，诗兴频遭白雨催。",
        "只有睡时愁可遣，春愁又向梦中来。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45569,
      "title": "二月一日郡圃寻春二首  其一",
      "content": [
        "中和节里半春天，一拂清寒半点暄。",
        "憔悴不胜梅欲落，娇饶无对杏初繁。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45570,
      "title": "二月一日郡圃寻春二首  其二",
      "content": [
        "花遶朱簷柳遶栏，小亭面面锦团栾。",
        "春风横欲欺诗瘦，且下东窗护嫩寒。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45571,
      "title": "梅残",
      "content": [
        "雪已都消去，梅能小住无。",
        "雀争飞落片，蜂猎未蔫须。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 45572,
      "title": "寒夜不寐",
      "content": [
        "雪入迎春鬓，茶醒学古胸。",
        "梦回霜满屋，吟到月斜钟。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 45573,
      "title": "新柳",
      "content": [
        "辇路金丝半欲垂，外间玉爪未渠开。",
        "上林柳色休多忆，更趁春风看一回。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45574,
      "title": "小饮俎豆颇备江西淮浙之品戏题二首  其一",
      "content": [
        "满盘山海眩芳珍，未借前筹已咽津。",
        "鲎醤子鱼总佳客，玉狸黄雀是乡人。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45575,
      "title": "小饮俎豆颇备江西淮浙之品戏题二首  其二",
      "content": [
        "味含霜气洞庭柑，鲊带桃花楚水𧍧。",
        "春暖著人君会否，不教淮白过江南。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45576,
      "title": "雨霁",
      "content": [
        "雨为梅花遣尽尘，柳勾日影自传神。",
        "不须苦问春多少，暖幕晴帘总是春。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45577,
      "title": "蜜渍梅花",
      "content": [
        "瓮澄雪水酿春寒，蜜点梅花带露餐。",
        "句里略无烟火气，更教谁上少陵坛。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45578,
      "title": "感兴",
      "content": [
        "看书已怯短檠灯，觅句犹锵涧水声。",
        "诗瘦近来惟有骨，可怜辛苦为虚名。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45579,
      "title": "春暖郡圃散策三首  其一",
      "content": [
        "已觉朝来退裌衣，日光风力软如痴。",
        "倩谁留许春寒著，更放梅花住少时。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45580,
      "title": "春暖郡圃散策三首  其二",
      "content": [
        "萱草行间过履絇，杏花影里散文书。",
        "秋风遣我疎团扇，又被春风遣唤渠。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45581,
      "title": "春暖郡圃散策三首  其三",
      "content": [
        "春禽处处讲新声，细草欣欣贺嫩晴。",
        "曲折遍穿花底路，莫令一步作虚行。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45582,
      "title": "休日登城",
      "content": [
        "爱他休日更新晴，忍却春寒上古城。",
        "废垒荒芦无一好，春来微径总堪行。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45583,
      "title": "浄远亭午望二首  其一",
      "content": [
        "城外春光染远山，池中嫩水涨微澜。",
        "回身小却深簷里，野鸭双浮欲近栏。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45584,
      "title": "浄远亭午望二首  其二",
      "content": [
        "竹迳殊疎欠补栽，兰芽欲吐未全开。",
        "初暄乍冷飞犹倦，一蝶新从底处来。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45585,
      "title": "池亭双树梅花",
      "content": [
        "开尽梅花半欲残，两株晴雪作双寒。",
        "团栾遶树元无见，只合池亭隔水看。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45586,
      "title": "多稼亭前小步",
      "content": [
        "樱桃抛过隔墙莟，芍药丛抽刺土芽。",
        "最是蜜蜂无意思，忍将尘脚踏梅花。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45587,
      "title": "多稼亭宴客",
      "content": [
        "归来不省醉还醒，只怪谯门打一更。",
        "秉烛径穿梅下过，此身真在雪中行。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45588,
      "title": "烧香七言",
      "content": [
        "琢瓷作鼎碧于水，削银为叶轻如纸。",
        "不文不武火力匀，闭阁下帘风不起。",
        "诗人自炷古龙涎，但令有香不见烟。",
        "素馨忽开抹利拆，低处龙麝和沉檀。",
        "平生饱识山林味，不奈此香殊娬媚。",
        "呼儿急取烝木犀，却作书生真富贵。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 45589,
      "title": "读严子陵传",
      "content": [
        "客星何补汉中兴，空有清风冷似冰。",
        "早遣阿瞒移汉鼎，人间何处有严陵。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45590,
      "title": "题山庄小集",
      "content": [
        "莫笑山庄小集休，篇篇字字爽于秋。",
        "向来枫落吴江冷，一句能销万古愁。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45591,
      "title": "春寒",
      "content": [
        "春寒尽解粟人肤，敢傍吾侪酒盏无。",
        "雨里杏花如半醉，抬头不起索人扶。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 45592,
      "title": "瓶中梅杏二花",
      "content": [
        "梅花耿耿冰玉姿，杏花淡淡注燕脂。",
        "两花相娇不相下，各向春风同索价。",
        "折来双插一铜瓶，旋汲井花浇使醒。",
        "红红白白看不足，更遣山童烧蜡烛。"
      ],
      "author": {
        "id": 6916,
        "name": "杨万里"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    }
  ],
