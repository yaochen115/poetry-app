{
  "data": [
    {
      "id": 283295,
      "title": "力疾山下吴邨看杏花十九首 七",
      "content": [
        "白衫裁袖本教宽，朱紫由来亦一般。",
        "王老小儿吹笛看，我侬试舞尔侬看。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283296,
      "title": "力疾山下吴邨看杏花十九首 八",
      "content": [
        "单床薄被又羁栖，待到花开亦甚迷。",
        "若道折多还有罪，只应莺啭是金鸡。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283297,
      "title": "力疾山下吴邨看杏花十九首 九",
      "content": [
        "近来桃李半烧枯，归卧乡园只老夫。",
        "莫算明年人在否，不知花得更开无。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283298,
      "title": "力疾山下吴邨看杏花十九首 十",
      "content": [
        "汉王何事损精神，花满深宫不见春。",
        "秾艳三千临粉镜，独悲掩面李夫人。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283299,
      "title": "力疾山下吴邨看杏花十九首 十一",
      "content": [
        "能艳能芳自一家，胜鸾胜凤胜烟霞。",
        "客来须共醒醒看，碾尽明昌几角茶。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283300,
      "title": "力疾山下吴邨看杏花十九首 十二",
      "content": [
        "造化无端欲自神，裁红剪翠为新春。",
        "不如分减闲心力，更助英豪济活人。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283301,
      "title": "力疾山下吴邨看杏花十九首 十三",
      "content": [
        "徘徊自劝莫沾缨，分付年年谷口莺。",
        "却赖无情容易别，有情早个不胜情。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283302,
      "title": "力疾山下吴邨看杏花十九首 十四",
      "content": [
        "闲步偏宜舞袖迎，春光何事独无情。",
        "垂杨合是诗家物，只爱敷溪道北生。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283303,
      "title": "力疾山下吴邨看杏花十九首 十五",
      "content": [
        "亦知王大是昌龄，杜二其如律韵清。",
        "还有酸寒堪笑处，拟夸朱绂更峥嵘。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283304,
      "title": "力疾山下吴邨看杏花十九首 十六",
      "content": [
        "潘郎爱说是诗家，枉占河阳一县花。",
        "千载几人搜警句，补方金字爱晴霞。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283305,
      "title": "力疾山下吴邨看杏花十九首 十七",
      "content": [
        "行乐溪边步转迟，出山渐减探花期。",
        "去年四度今三度，恐到凭人折去时。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283306,
      "title": "力疾山下吴邨看杏花十九首 十八",
      "content": [
        "此身衰病转堪嗟，长忍春寒独惜花。",
        "更恨新诗无纸写，蜀牋堆积是谁家。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283307,
      "title": "力疾山下吴邨看杏花十九首 十九",
      "content": [
        "昨日黄昏始看回，梦中相约又衔杯。",
        "起来闻到风飘却，犹拟教人扫取来。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283308,
      "title": "少仪",
      "content": [
        "昨日登班缀柏台，更惭起草属微才。",
        "锦窠不是寻常锦，兼向丘迟夺得来。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283309,
      "title": "重阳四首 一",
      "content": [
        "簷前减燕菊添芳，燕尽庭前菊又荒。",
        "老大比他年少少，每逢佳节更悲凉。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283310,
      "title": "重阳四首 二",
      "content": [
        "雨寒莫待菊花催，须怕晴空暖并开。",
        "开却一枝开却尽，且随幽蝶更徘徊。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283311,
      "title": "重阳四首 三",
      "content": [
        "青娥懒唱无衣换，黄菊新开乞酒难。",
        "长有长亭惆怅事，隔河更得对凭栏。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283312,
      "title": "重阳四首 四",
      "content": [
        "白发怕寒梳更懒，黄花晴日照初开。",
        "篱头应是蝶相报，已被邻家携酒来。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283313,
      "title": "长命缕",
      "content": [
        "他乡处处堪悲事，残照依依惜别天。",
        "此去知名长命缕，殷勤为我唱花前。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283314,
      "title": "柏东",
      "content": [
        "冥得机心岂在僧，柏东闲步爱腾腾。",
        "免教世路人相忌，逢着村醪亦不憎。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283315,
      "title": "歌者十二首 一",
      "content": [
        "追逐翻嫌傍管弦，金钗击节自当筵。",
        "风霜一夜燕鸿断，唱作江南袚禊天。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283316,
      "title": "歌者十二首 二",
      "content": [
        "玉树花飘凤失栖，一声初压管弦低。",
        "清回烦署成潇洒，艳逐寒云变惨凄。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283317,
      "title": "歌者十二首 三",
      "content": [
        "十斛明珠亦易拚，欲兼人艺古来难。",
        "五云合是新声染，镕作琼浆洒露盘。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283318,
      "title": "歌者十二首 四",
      "content": [
        "不似新声唱亦新，旋调玉管旋生春。",
        "愁肠隔断珠帘外，只为今宵共听人。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283319,
      "title": "歌者十二首 五",
      "content": [
        "十年逃难别云林，暂辍狂歌且听琴。",
        "转觉淡交言有味，此声知是古人心。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283320,
      "title": "歌者十二首 六",
      "content": [
        "五柳先生自识微，无言共笑手空挥。",
        "胸中免被风波挠，肯为螳螂动杀机。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283321,
      "title": "歌者十二首 七",
      "content": [
        "风霜寒水旅人心，几处笙歌绣户深。",
        "分泊一场云散后，未胜初夜便听琴。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283322,
      "title": "歌者十二首 八",
      "content": [
        "自怜眼暗难求药，莫恨花繁便有风。",
        "桃李更开须强看，明年兼恐听歌聋。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283323,
      "title": "歌者十二首 九",
      "content": [
        "白云深处寄生涯，岁暮生情赖此花。",
        "蜂蝶绕来忙绕袖，似知教折送邻家。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283324,
      "title": "歌者十二首 十",
      "content": [
        "重九仍重岁渐阑，强开病眼更登攀。",
        "年年认得酣歌处，犹恐招魂葬故山。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283325,
      "title": "歌者十二首 十一",
      "content": [
        "绕壁依稀认写真，更须粉绘饰羸身。",
        "凄凉不道身无寿，九日还无旧会人。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283326,
      "title": "歌者十二首 十二",
      "content": [
        "鹤氅花香搭槿篱，枕前蛩迸酒醒时。",
        "夕阳似照陶家菊，黄蝶无穷压故枝。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283327,
      "title": "题裴晋公华岳庙题名",
      "content": [
        "岳前大队赴淮西，从此中原息鼓鼙。",
        "石阙莫教苔藓上，分明认取晋公题。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283328,
      "title": "杨柳枝寿杯词十八首 一",
      "content": [
        "乐府翻来占太平，风光无处不含情。",
        "千门万户喧歌吹，富贵人间只此声。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 283329,
      "title": "杨柳枝寿杯词十八首 二",
      "content": [
        "撼晚梳空不自持，与君同折上楼时。",
        "春风还有常情处，系得人心免别离。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 283330,
      "title": "杨柳枝寿杯词十八首 三",
      "content": [
        "灞亭东去彻隋堤，赠别何须醉似泥。",
        "万里往来无一事，便帆轻拂乱莺啼。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 283331,
      "title": "杨柳枝寿杯词十八首 四",
      "content": [
        "台城细仗晓初移，诏赐千官禊饮时。",
        "绿帐远笼轻珮响，更曛晴日上龙旗。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 283332,
      "title": "杨柳枝寿杯词十八首 五",
      "content": [
        "桃源仙子不须夸，闻道惟栽一片花。",
        "何似浣纱溪畔住，绿阴相间两三家。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 283333,
      "title": "杨柳枝寿杯词十八首 六",
      "content": [
        "偶然楼上卷珠帘，往往长条拂枕函。",
        "恰值小娥初学舞，拟偷金缕押春衫。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 283334,
      "title": "杨柳枝寿杯词十八首 七",
      "content": [
        "池边影动散鸳鸯，更引微风乱绣床。",
        "直待玉窗尘不起，始应金鴈得成行。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 283335,
      "title": "杨柳枝寿杯词十八首 八",
      "content": [
        "稻畦分影向江邨，憔悴经霜只半存。",
        "昨日流莺今不见，乱萤飞出照黄昏。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 283336,
      "title": "杨柳枝寿杯词十八首 九",
      "content": [
        "客泪休沾汉水滨，舞腰羞杀汉宫人。",
        "狂风更与回烟箒，扫尽繁花独占春。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 283337,
      "title": "杨柳枝寿杯词十八首 十",
      "content": [
        "游人莫叹易凋衰，长乐荣枯自有期。",
        "看取明年春意动，更于何处最先知。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 283338,
      "title": "杨柳枝寿杯词十八首 十一",
      "content": [
        "昔年行乐及芳时，一上丹梯桂一枝。",
        "笑问江头醉公子，饶君满把曲尘丝。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 283339,
      "title": "杨柳枝寿杯词十八首 十二",
      "content": [
        "渡头残照一行新，独自依依向北人。",
        "莫恨乡程千里远，眼中从此故乡春。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 283340,
      "title": "杨柳枝寿杯词十八首 十三",
      "content": [
        "絮惹轻枝雪未飘，小溪烟束带危桥。",
        "邻家女伴频攀折，不觉回身罥翠翘。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 283341,
      "title": "杨柳枝寿杯词十八首 十四",
      "content": [
        "处处萦空百万枝，一枝枝好更题诗。",
        "隔城远岫招行客，便与朱楼当酒旗。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 283342,
      "title": "杨柳枝寿杯词十八首 十五",
      "content": [
        "锦城分得映金沟，两岸年年引胜游。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 283343,
      "title": "杨柳枝寿杯词十八首 十六",
      "content": [
        "日暖津头絮已飞，看看还是送君归。",
        "莫言万绪牵愁思，缉取长绳系落晖。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 283344,
      "title": "杨柳枝寿杯词十八首 十七",
      "content": [
        "大堤时节近清明，霞衬烟笼遶郡城。",
        "好是梨花相映处，更胜松雪日初晴。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 283345,
      "title": "杨柳枝寿杯词十八首 十八",
      "content": [
        "圣主千年乐未央，御沟金翠满垂杨。",
        "年年织作升平字，高映南山献寿觞。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 283346,
      "title": "山鹊",
      "content": [
        "多惊本为好毛衣，只赖人怜始却归。",
        "众鸟自知颜色减，妬他偏向眼前飞。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283347,
      "title": "李居士",
      "content": [
        "高风只在五峰前，应是精灵降作贤。",
        "万里无云惟一鹤，乡中同看却升天。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283348,
      "title": "杏花",
      "content": [
        "诗家偏为此伤情，品韵由来莫与争。",
        "解笑亦应兼解语，只应慵语倩莺声。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283349,
      "title": "白菊三首 一",
      "content": [
        "不疑陶令是狂生，作赋其如有定情。",
        "犹胜江南隐居士，诗魔终袅负孤名。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283350,
      "title": "白菊三首 二",
      "content": [
        "自古诗人少显荣，逃名何用更题名。",
        "诗中有虑犹须戒，莫向诗中著不平。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283351,
      "title": "白菊三首 三",
      "content": [
        "登高可羡少年场，白菊堆边鬓似霜。",
        "益算更希沾上药，今朝第七十重阳。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283353,
      "title": "杨柳枝二首 一",
      "content": [
        "陶家五柳簇衡门，还有高情爱此君。",
        "何处更添诗境好，新蝉欹枕每先闻。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 283354,
      "title": "杨柳枝二首 二",
      "content": [
        "数枝珍重蘸沧浪，无限尘心暂免忙。",
        "烦暑若和烟露裛，便同佛手洒清凉。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 283355,
      "title": "修史亭二首 一",
      "content": [
        "少年已惯掷年光，时节催驱独不忙。",
        "今日无疑亦无病，前程无事扰医王。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283356,
      "title": "修史亭二首 二",
      "content": [
        "篱落轻寒整顿新，雪晴步屣会诸邻。",
        "自从南至歌风顶，始见人烟外有人。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283357,
      "title": "漫书",
      "content": [
        "乐退安贫知是分，成家报国亦何惭。",
        "到还僧院心期在，瑟瑟澄鲜百丈潭。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283358,
      "title": "杂题二首 一",
      "content": [
        "棋局长携上钓船，杀中棋杀胜丝牵。",
        "洪𬬻任铸千钧鼎，只在磻溪一缕悬。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283359,
      "title": "杂题二首 二",
      "content": [
        "晓镜高窗气象深，自怜清格笑尘心。",
        "世间不为蛾眉误，海上方应鹤背吟。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283360,
      "title": "题休休亭",
      "content": [
        "咄，诺。",
        "休休休，莫莫莫。",
        "伎两虽多性灵恶，赖是长教闲处著。",
        "休休休，莫莫莫。",
        "一局棋，一炉药。",
        "天意时情可料度，白日偏催快活人。",
        "黄金难买堪骑鹤，若曰尔何能，荅言耐辱莫。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 283361,
      "title": "冯燕歌",
      "content": [
        "魏中义士有冯燕，游侠幽幷最少年。",
        "避讐偶作滑台客，嘶风跃马来翩翩。",
        "此时恰遇莺花月，堤上轩车昼不绝。",
        "两面高楼语笑声，指点行人情暗结。",
        "掷果潘郎谁不慕，朱门别见红妆露。",
        "故故推门掩不开，似教欧轧传言语。",
        "冯生敲镫袖笼鞭，半拂垂杨半惹烟。",
        "树间春鸟知人意，的的心期暗与传。",
        "传道张婴偏嗜酒，从此香闺为我有。",
        "梁间客燕正相欺，屋上鸣鸠空自鬬。",
        "婴归醉卧非讐汝，岂知负过人怀惧。",
        "燕依户扇欲潜逃，巾在枕傍指令取。",
        "谁言狼戾心能忍，待我情深情不隐。",
        "回身本谓取巾难，倒柄方知授霜刅。",
        "冯君抚劒即迟疑，自顾平生心不欺。",
        "尔能负彼必相负，假手他人复在谁。",
        "窗间红艳犹可掬，熟视花钿情不足。",
        "唯将大义断胸襟，粉颈初回如切玉。",
        "凤皇钗碎各分飞，怨魄娇魂何处追。",
        "凌波如唤游金谷，羞彼[揶揄]泪满衣。",
        "新人藏匿旧人起，白昼喧呼骇邻里。",
        "诬执张婴不自明，贵免生前遭考捶。",
        "官将赴市拥红尘，掉臂人来擗看人。",
        "传声莫遣有冤滥，盗杀婴家即我身。",
        "初闻僚吏翻疑叹，呵叱风狂词不变。",
        "缧囚解缚犹自疑，疑是梦中方脱免。",
        "未死劝君莫浪言，临危不顾始知难。",
        "已为不平能割爱，更将身命救深冤。",
        "白马贤侯贾相公，长悬金帛募才雄。",
        "拜章请赎冯燕罪，千古三河激义风。",
        "黄河东注无时歇，注尽波澜名不灭。",
        "为感词人沈下贤，长歌更与分明说。",
        "此君精爽知犹在，长与人间留炯诫。",
        "铸作金燕香作堆，焚香酬酒听歌来。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 283362,
      "title": "寄薛起居",
      "content": [
        "小域新衔贺圣朝，亦知蹇分巧难抛。",
        "麤才自合无岐路，不破工夫漫解嘲。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283363,
      "title": "月下留丹灶",
      "content": [
        "月下留丹灶，坛边树羽衣。",
        "异香人不觉，残夜鹤分飞。",
        "朝会初元盛，蓬瀛旧侣稀。",
        "瑶函真迹在，妖魅敢扬威。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 283364,
      "title": "元日",
      "content": [
        "甲子今重数，生涯只自怜。",
        "殷勤元日日，欹午又明年。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 283365,
      "title": "洛阳咏古",
      "content": [
        "石勒童年有战机，洛阳长啸倚门时。",
        "晋朝不是王夷甫，大智何由得预知。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 283366,
      "title": "诗品二十四则 雄浑",
      "content": [
        "大用外腓，真体内充。",
        "返虚入浑，积健为雄。",
        "具备万物，横绝太空。",
        "荒荒油云，寥寥长风。",
        "超以象外，得其环中。",
        "持之匪强，来之无穷。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 283367,
      "title": "诗品二十四则 冲淡",
      "content": [
        "素处以默，妙机其微。",
        "饮之太和，独鹤与飞。",
        "犹之惠风，苒苒在衣。",
        "阅音修篁，美曰载归。",
        "遇之匪深，即之愈稀。",
        "脱有形似，握手已违。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 283368,
      "title": "诗品二十四则 纤秾",
      "content": [
        "采采流水，蓬蓬远春。",
        "窈窕深谷，时见美人。",
        "碧桃满树，风日水滨。",
        "柳阴路曲，流莺比邻。",
        "乘之愈往，识之愈真。",
        "如将不尽，与古为新。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 283369,
      "title": "诗品二十四则 沈著",
      "content": [
        "绿杉野屋，落日气清。",
        "脱巾独步，时闻鸟声。",
        "鸿鴈不来，之子远行。",
        "所思不远，若为平生。",
        "海风碧云，夜渚月明。",
        "如有佳语，大河前横。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 283370,
      "title": "诗品二十四则 高古",
      "content": [
        "畸人乘真，手把芙蓉。",
        "泛彼浩劫，窅然空纵。",
        "月出东斗，好风相从。",
        "太华夜碧，人闻清钟。",
        "虚伫神素，脱然畦封。",
        "黄唐在独，落落玄宗。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 283371,
      "title": "诗品二十四则 典雅",
      "content": [
        "玉壶买春，赏雨茆屋。",
        "坐中佳士，左右修竹。",
        "白云初晴，幽鸟相逐。",
        "眠琴绿阴，上有飞瀑。",
        "落花无言，人淡如菊。",
        "书之岁华，其曰可读。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 283372,
      "title": "诗品二十四则 洗炼",
      "content": [
        "犹鑛出金，如铅出银。",
        "超心炼冶，绝爱[缁]磷。",
        "空潭泻春，古镜照神。",
        "体素储洁，乘月返真。",
        "载瞻星辰，载歌幽人。",
        "流水今日，明月前身。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 283373,
      "title": "诗品二十四则 劲健",
      "content": [
        "行神如空，行气如虹。",
        "巫峡千寻，走云连风。",
        "饮真茹强，蓄素守中。",
        "喻彼行健，是谓存雄。",
        "天地与立，神化攸同。",
        "期之以实，御之以终。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 283374,
      "title": "诗品二十四则 绮丽",
      "content": [
        "神存富贵，始轻黄金。",
        "浓尽必枯，浅者屡深。",
        "露余山青，红杏在林。",
        "月明华屋，画桥碧阴。",
        "金尊酒满，共客弹琴。",
        "取之自足，良殚美襟。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 283375,
      "title": "诗品二十四则 自然",
      "content": [
        "俯拾即是，不取诸邻。",
        "俱道适往，著手成春。",
        "如逢花开，如瞻岁新。",
        "真予不夺，强得易贫。",
        "幽人空山，过水采苹。",
        "薄言情晤，悠悠天钧。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 283376,
      "title": "诗品二十四则 含蓄",
      "content": [
        "不著一字，尽得风流。",
        "语不涉难，已不堪忧。",
        "是有真宰，与之沈浮。",
        "如渌满酒，花时返秋。",
        "悠悠空尘，忽忽海沤。",
        "浅深聚散，万取一收。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 283377,
      "title": "诗品二十四则 豪放",
      "content": [
        "观花匪禁，吞吐大荒。",
        "由道返气，处得以狂。",
        "天风浪浪，海山苍苍。",
        "真力弥满，万象在旁。",
        "前招三辰，后引凤皇。",
        "晓策六鼇，濯足扶桑。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 283378,
      "title": "诗品二十四则 精神",
      "content": [
        "欲返不尽，相期与来。",
        "明漪绝底，奇花初胎。",
        "青春鹦鹉，杨柳池台。",
        "碧山人来，清酒满杯。",
        "生气远出，不著死灰。",
        "妙造自然，伊谁与裁。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 283379,
      "title": "诗品二十四则 缜密",
      "content": [
        "是有真迹，如不可知。",
        "意象欲生，造化已奇。",
        "水流花开，清露未晞。",
        "要路愈远，幽行为迟。",
        "语不欲犯，思不欲痴。",
        "犹春于绿，明月雪时。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 283380,
      "title": "诗品二十四则 疎野",
      "content": [
        "惟性所宅，真取弗羁。",
        "拾物自富，与率为期。",
        "筑屋松下，脱帽看诗。",
        "但知旦暮，不辨何时。",
        "倘然适意，岂必有为。",
        "若其天放，如是得之。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 283381,
      "title": "诗品二十四则 清奇",
      "content": [
        "娟娟群松，下有漪流。",
        "晴雪满汀，隔溪渔舟。",
        "可人如玉，步屧寻幽。",
        "载行载止，空碧悠悠。",
        "神出古异，淡不可收。",
        "如月之曙，如气之秋。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 283382,
      "title": "诗品二十四则 委曲",
      "content": [
        "登彼太行，翠遶羊肠。",
        "杳霭流玉，悠悠花香。",
        "力之于时，声之于羌。",
        "似往已回，如幽匪藏。",
        "水理漩洑，鹏风翱翔。",
        "道不自器，与之圆方。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 283383,
      "title": "诗品二十四则 实境",
      "content": [
        "取语甚直，计思匪深。",
        "忽逢幽人，如见道心。",
        "晴磵之曲，碧松之阴。",
        "一客荷樵，一客听琴。",
        "情性所至，妙不自寻。",
        "遇之自天，冷然希音。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 283384,
      "title": "诗品二十四则 悲慨",
      "content": [
        "大风卷水，林木为摧。",
        "意苦若死，招憩不来。",
        "百岁如流，富贵冷灰。",
        "大道日往，若为雄才。",
        "壮士拂劒，浩然弥哀。",
        "萧萧落叶，漏雨苍苔。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 283385,
      "title": "诗品二十四则 形容",
      "content": [
        "绝伫灵素，少回清真。",
        "如觅水影，如写阳春。",
        "风云变态，花草精神。",
        "海之波澜，山之嶙峋。",
        "俱似大道，妙契同尘。",
        "离形得似，庶几斯人。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 283386,
      "title": "诗品二十四则 超诣",
      "content": [
        "匪神之灵，匪机之微。",
        "如将白云，清风与归。",
        "远引若至，临之已非。",
        "少有道契，终与俗违。",
        "乱山高木，碧苔芳晖。",
        "诵之思之，其声愈稀。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 283387,
      "title": "诗品二十四则 飘逸",
      "content": [
        "落落欲往，矫矫不群。",
        "缑山之鹤，华顶之云。",
        "高人画中，令色絪缊。",
        "御风蓬叶，泛彼无垠。",
        "如不可执，如将有闻。",
        "识者已领，期之愈分。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 283388,
      "title": "诗品二十四则 旷达",
      "content": [
        "生者百岁，相去几何。",
        "欢乐苦短，忧愁实多。",
        "何如尊酒，日往烟萝。",
        "花覆茆簷，疎雨相过。",
        "倒酒既尽，杖藜行过。",
        "孰不有古，南山峨峨。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 283389,
      "title": "诗品二十四则 流动",
      "content": [
        "若纳水𫐑，如转丸珠。",
        "夫岂可道，假体遗愚。",
        "荒荒坤轴，悠悠天枢。",
        "载要其端，载同其符。",
        "超超神明，返返冥无。",
        "来往千载，是之谓乎。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 283390,
      "title": "句",
      "content": [
        "忍事敌灾星，物望倾心久。",
        "凶渠破胆频。",
        "鼎饫和方济，台阶润欲平。",
        "夜短猨悲减，风和鹊喜虚。",
        "骅骝思故第，鹦鹉失佳人。",
        "鲸鲵人海涸，魑魅棘林幽。",
        "棋声花院闭，幡影石坛高。",
        "地凉清鹤梦，林静肃僧仪。",
        "晚妆留拜月，春睡更生香。",
        "隔谷见鸡犬，山苗接楚田。",
        "人家寒食月，花影午时天。",
        "官路好禽声，轩车驻晚程。",
        "南楼山最秀，北路邑偏清。",
        "多病形容五十三，谁邻借笏趂朝参。",
        "十年太华无知己，只得虚中两首诗。",
        "看师逸迹两师宜，高适歌行李白诗。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298139,
      "title": "丙午岁旦",
      "content": [
        "鸡报已判春，中年抱疾身。",
        "晓催庭火暗，风带寺幡新。",
        "多虑无成事，空休是吉人。",
        "梅花浮寿酒，莫笑又移巡。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 298140,
      "title": "丁巳元日",
      "content": [
        "禀朔华夷会，开春气象生。",
        "日随行阙近，岳为寿觞晴。",
        "作睿由稽古，昭仁事措刑。",
        "上玄劳眷佑，高庙保忠贞。",
        "星变当移幸，人心喜奉迎。",
        "传呼清御道，雪涕识臣诚。",
        "鼎餁和方济，台阶润欲平。",
        "扶天咨协力，并日召延英。",
        "金跃洪𬬻动，云驱众蛰惊。",
        "关中留王气，席上纵奇兵。",
        "累降搜贤诏，兼持进善旌。",
        "短辕收骥步，直路发鹏程。",
        "自乏匡时略，非沽矫俗名。",
        "鹤笼何足献，蜗舍别无营。",
        "羸带漳滨病，吟哀越客声。",
        "移居荒药圃，耗志在棋枰。",
        "醉忘身空老，书怜眼尚明。",
        "偶能甘蹇分，岂是薄浮荣。",
        "虑戒防微浅，□知近利轻。",
        "献陵三百里，寤寐祷时清。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298141,
      "title": "光启三年人日逢鹿",
      "content": [
        "浮世仍逢乱，安排赖佛书。",
        "劳生中寿少，抱疾上升疎。",
        "日暖人逢鹿，园荒雪带锄。",
        "知非今又过，蘧瑗最怜渠。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 298142,
      "title": "浙上重阳",
      "content": [
        "登高唯北望，菊助可□明。",
        "离恨初逢节，贫居只喜晴。",
        "好文时可见，学稼老无成。",
        "莫叹关山阻，何当不阻兵。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 298143,
      "title": "乙巳岁愚春秋四十九辞疾拜章将免左掖重阳独登上方",
      "content": [
        "雪鬓不禁镊，知非又此年。",
        "退居还有旨，荣路免妨贤。",
        "落落鸣蛩鸟，晴霞度雁天。",
        "自无佳节兴，依旧菊篱边。"
      ],
      "author": {
        "id": 5643,
        "name": "司空图"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    }
