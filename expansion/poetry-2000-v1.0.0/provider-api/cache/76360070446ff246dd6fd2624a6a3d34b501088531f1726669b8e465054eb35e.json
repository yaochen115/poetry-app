{
  "data": [
    {
      "id": 267842,
      "title": "赠任道人",
      "content": [
        "长安多病无生计，药铺医人乱索钱。",
        "欲得定知身上事，凭君为算小行年。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 267843,
      "title": "招周居士",
      "content": [
        "闭门秋雨湿墙莎，俗客来稀野思多。",
        "已扫书斋安药灶，山人作意早经过。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 267844,
      "title": "送许处士",
      "content": [
        "高情自与俗人疎，独向蓝溪选僻居。",
        "会到白云长取醉，不能窗下读闲书。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 267845,
      "title": "送律师归婺州",
      "content": [
        "京中开讲已多时，曾作坛头证戒师。",
        "归到双溪桥北寺，乡僧争就学威仪。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 267846,
      "title": "题杨秘书新居",
      "content": [
        "爱闲不向争名地，宅在街西最静坊。",
        "卷里诗过一千首，白头新受秘书郎。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 267847,
      "title": "送晊师",
      "content": [
        "九星台下煎茶别，五老峰头觅寺居。",
        "作得新诗旋相寄，人来请莫达空书。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 267848,
      "title": "送僧往金州",
      "content": [
        "闻道谿阴山水好，师行一一徧经过。",
        "事须觅取堪居处，若个溪头药最多。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 267849,
      "title": "寻徐道士",
      "content": [
        "寻师远到晖天观，竹院森森闭药房。",
        "闻入静来经七日，仙童簷下独焚香。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 267850,
      "title": "答开州韦使君寄车前子",
      "content": [
        "开州午日车前子，作药人皆道有神。",
        "慙愧使君怜病眼，三千余里寄闲人。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 267851,
      "title": "忆故州",
      "content": [
        "垒石为山伴野夫，自收灵药读仙书。",
        "如今身是他州客，每见青山忆旧居。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 267852,
      "title": "送客游蜀",
      "content": [
        "行尽青山到益州，锦城楼下二江流。",
        "杜家曾向此中住，为到浣花溪水头。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 267853,
      "title": "送陆畅",
      "content": [
        "共踏长安街里尘，吴州独作未归身。",
        "昔年旧宅今谁住，君过西塘与问人。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 267854,
      "title": "感春",
      "content": [
        "远客悠悠任病身，谢家池上又逢春。",
        "明年各自东西去，此地看花是别人。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 267855,
      "title": "赠李司议",
      "content": [
        "汉庭谁问投荒客，十载天南着白衣。",
        "秋草茫茫恶谿路，岭头遥送北人稀。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 267856,
      "title": "别客",
      "content": [
        "青山历历水悠悠，今日相逢明日秋。",
        "系马城边杨柳树，为君沽酒暂淹留。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 267857,
      "title": "登楼寄胡家兄弟",
      "content": [
        "独上西楼尽日闲，林烟演漾鸟蛮蛮。",
        "谢家兄弟重城里，不得同看雨后山。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 267858,
      "title": "答刘明府",
      "content": [
        "身病多时又客居，满城亲旧尽相疎。",
        "可怜绛县刘明府，犹解频频寄远书。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 267859,
      "title": "酬藤杖",
      "content": [
        "病里出门行步迟，喜君相赠古藤枝。",
        "倚来自觉身生力，每向傍人说得时。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 267860,
      "title": "法雄寺东楼",
      "content": [
        "汾阳旧宅今为寺，犹有当时歌舞楼。",
        "四十年来车马绝，古槐深巷暮蝉愁。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 267861,
      "title": "寄故人",
      "content": [
        "静曲闲房病客居，蝉声满树槿花疎。",
        "故人祗在蓝田县，强半年来未得书。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 267862,
      "title": "邻妇哭征夫",
      "content": [
        "双鬟初合便分离，万里征夫不得随。",
        "今日军回身独殁，去时鞍马别人骑。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 267863,
      "title": "和崔驸马闻蝉",
      "content": [
        "凤凰楼下多欢乐，不觉秋风暮雨天。",
        "应为昨来身暂病，蝉声得到耳傍边。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 267864,
      "title": "和裴仆射看樱桃花",
      "content": [
        "昨日南园新雨后，樱桃花发旧枝柯。",
        "天明不待人同看，遶树重重履迹多。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 267865,
      "title": "和长安郭明府与友人县中会饮",
      "content": [
        "一尊清酒两人同，好在街西水县中。",
        "自恨病身相去远，此时闲坐对秋风。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 267866,
      "title": "唐昌观看花",
      "content": [
        "新红旧紫不相宜，看觉从前两月迟。",
        "更向同来诗客道，明年到此莫过时。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 267867,
      "title": "九华观看花",
      "content": [
        "街西无数闲游处，不似九华仙观中。",
        "花里可怜池上景，几重墙壁贮春风。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 267868,
      "title": "赠姚合",
      "content": [
        "丹凤城门向晓开，千官相次入朝来。",
        "唯君独走冲尘土，下马桥边报直回。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 267869,
      "title": "同韦员外开元观寻时道士",
      "content": [
        "观里初晴竹树凉，闲行共到最高房。",
        "昨来官罢无生计，欲就师求断谷方。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 267870,
      "title": "同韩侍御南溪夜赏",
      "content": [
        "喜作闲人得出城，南溪两月逐君行。",
        "忽闻新命须归去，一夜船中语到明。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 267871,
      "title": "使行望悟真寺",
      "content": [
        "采玉峰连佛寺幽，高高斜对驿门楼。",
        "无端来去骑官马，寸步教身不得游。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 267872,
      "title": "重阳日至峡道",
      "content": [
        "无限青山行已尽，回看忽觉远离家。",
        "逢高欲饮重阳酒，山菊今朝未有花。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 267873,
      "title": "赠主客刘郎中",
      "content": [
        "忆昔君登南省日，老夫犹是褐衣身。",
        "谁知二十余年后，来作客曹相替人。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 267874,
      "title": "同严给事闻唐昌观玉蘂近有仙过因成绝句二首 一",
      "content": [
        "千枝花里玉尘飞，阿母宫中见亦稀。",
        "应共诸仙鬬百草，独来偷得一枝归。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 267875,
      "title": "同严给事闻唐昌观玉蘂近有仙过因成绝句二首 二",
      "content": [
        "九色云中紫凤车，寻仙来到洞仙家。",
        "飞轮回处无踪迹，唯有斑斑满地花。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 267876,
      "title": "秋思",
      "content": [
        "洛阳城里见秋风，欲作归书意万重。",
        "忽恐匆匆说不尽，行人临发又开封。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 267877,
      "title": "忆远",
      "content": [
        "行人犹未有归期，万里初程日暮时。",
        "唯爱门前双柳树，枝枝叶叶不相离。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 267878,
      "title": "玉仙馆",
      "content": [
        "长溪新雨色如泥，野水阴云尽向西。",
        "楚客天南行渐远，山山树里鹧鸪啼。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 267879,
      "title": "寄府吏",
      "content": [
        "野外寻花共作期，今朝出郭不相随。",
        "待君公事有闲日，此地春风应过时。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 267880,
      "title": "弟萧远雪夜同宿",
      "content": [
        "数卷新游蜀客诗，长安僻巷得相随。",
        "草堂雪夜携琴宿，说是青城馆里时。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 267881,
      "title": "凉州词三首 一",
      "content": [
        "边城暮雨雁飞低，芦笋初生渐欲齐。",
        "无数铃声遥过碛，应驮白练到安西。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 267882,
      "title": "凉州词三首 二",
      "content": [
        "古镇城门白碛开，胡兵往往傍沙堆。",
        "巡边使客行应早，欲问平安无使来。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 267883,
      "title": "凉州词三首 三",
      "content": [
        "凤林关里水东流，白草黄榆六十秋。",
        "边将皆承主恩泽，无人解道取凉州。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 267884,
      "title": "宫词 一",
      "content": [
        "新鹰初放兔犹肥，白日君王在内稀。",
        "薄暮千门临欲锁，红妆飞骑向前归。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 267885,
      "title": "宫词 二",
      "content": [
        "黄金捍拨紫檀槽，弦索初张调更高。",
        "尽理昨来新上曲，内官帘外送樱桃。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 267886,
      "title": "华清宫",
      "content": [
        "温泉流入汉离宫，宫树行行浴殿空。",
        "武帝时人今欲尽，青山空闭御墙中。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 267887,
      "title": "崔驸马养鹤",
      "content": [
        "身闲无事称高情，已有人间章句名。",
        "求得鹤来教翦翅，望仙台下亦将行。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 267888,
      "title": "闲游",
      "content": [
        "老身不计人间事，野寺秋晴每独过。",
        "病眼校来犹断酒，却嫌行处菊花多。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 267889,
      "title": "刘兵曹赠酒",
      "content": [
        "一缾颜色似甘泉，闲向新栽小竹前。",
        "饮罢身中更无事，移床独就夕阳眠。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 267890,
      "title": "送梧州王使君",
      "content": [
        "楚江亭上秋风起，看发苍梧太守船。",
        "千里同行从此别，相逢又隔几多年。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 267891,
      "title": "春日早朝",
      "content": [
        "晓陌春寒朝骑来，瑞云深处见楼台。",
        "夜来新雨沙堤湿，东上合门应未开。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 267892,
      "title": "寄朱阚二山人",
      "content": [
        "为个朝章束此身，眼看东路去无因。",
        "历阳旧客今应少，转忆邻家二老人。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 267893,
      "title": "寄李渤",
      "content": [
        "五度溪头踯躅红，嵩阳寺里讲时钟。",
        "春山处处行应好，一月看花到几峰。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 267894,
      "title": "寻仙",
      "content": [
        "溪头一径入青崖，处处仙居隔杏花。",
        "更见峰西幽客说，云中犹有两三家。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 267895,
      "title": "同白侍郎杏园赠刘郎中",
      "content": [
        "一去潇湘头欲白，今朝始见杏花春。",
        "从来迁客应无数，重到花前有几人。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 267896,
      "title": "答鄱阳客药名诗",
      "content": [
        "江臯岁暮相逢地，黄叶霜前半夏枝。",
        "子夜吟诗向松桂，心中万事喜君知。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 267897,
      "title": "寄宋景",
      "content": [
        "诏发官兵取乱臣，将军弓箭不离身。",
        "今君独在征东府，莫遣功名属别人。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 267898,
      "title": "寄王侍御",
      "content": [
        "爱君紫阁峰前好，新作书堂药灶成。",
        "见欲移居相近住，有田多与种黄精。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 267899,
      "title": "题渭北寺上方",
      "content": [
        "昔祭郊坛今谒陵，寺中高处最来登。",
        "十余年后人多别，喜见当时转读僧。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 267900,
      "title": "闲游",
      "content": [
        "终日不离尘土间，若为能见此身闲。",
        "今朝暂共游僧语，更恨趋时别旧山。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 267901,
      "title": "倡女词",
      "content": [
        "轻鬓丛梳阔扫眉，为嫌风日下楼稀。",
        "画罗金缕难相称，故著寻常淡薄衣。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 267902,
      "title": "答元八遗纱帽",
      "content": [
        "黑纱方帽君边得，称对山前坐竹床。",
        "唯恐被人偷剪样，不曾闲戴出书堂。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 267903,
      "title": "题僧院",
      "content": [
        "闻师行讲青龙疏，本寺住来多少年。",
        "静扫空房唯独坐，千茎秋竹在簷前。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 267904,
      "title": "送元八",
      "content": [
        "百神斋祭相随徧，寻竹看山亦共行。",
        "明日城西送君去，旧游重到独题名。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 267905,
      "title": "吴楚歌词",
      "content": [
        "庭前春鸟啄林声，红夹罗襦缝未成。",
        "今朝社日停针线，起向朱樱树下行。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 267906,
      "title": "题方睦上人月台观",
      "content": [
        "一身清净无童子，独坐空堂得几年。",
        "每夜焚香通月观，可邻光影最团圆。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 267907,
      "title": "华山庙",
      "content": [
        "金天庙下西京道，巫女纷纷走似烟。",
        "手把纸钱迎过客，遣求恩福到神前。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 267908,
      "title": "病中酬元宗简",
      "content": [
        "东风渐暖满城春，独占幽居养病身。",
        "莫说樱桃花已发，今年不作看花人。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 267909,
      "title": "寺宿斋",
      "content": [
        "晚到金光门外寺，寺中新竹隔帘多。",
        "斋官禁与僧相见，院院开门不得过。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 267910,
      "title": "赠施肩吾",
      "content": [
        "世间渐觉无多事，虽有空名未著身。",
        "合取药成相待吃，不须先作上天人。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 267911,
      "title": "赠王建",
      "content": [
        "白君去后交游少，东野亡来箧笥贫。",
        "赖有白头王建在，眼前犹见咏诗人。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 267912,
      "title": "逢贾岛",
      "content": [
        "僧房逢着欵冬花，出寺行吟日已斜。",
        "十二街中春雪遍，马蹄今去入谁家。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 267913,
      "title": "山中酬人",
      "content": [
        "山中日暖春鸠鸣，逐水看花任意行。",
        "向晚归来石窗下，菖蒲叶上见题名。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 267914,
      "title": "弱栢院僧影堂",
      "content": [
        "弱栢倒垂如线蔓，簷头不见有枝柯。",
        "影堂香火长相续，应得人来礼拜多。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 267915,
      "title": "题故僧影堂",
      "content": [
        "香消云锁旧僧家，僧刹残形半壁斜。",
        "日暮松烟寒漠漠，秋风吹破纸莲花。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 267916,
      "title": "无题",
      "content": [
        "桃溪柳陌好经过，灯下妆成月下歌。",
        "为是襄王故宫地，至今犹有细腰多。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 267917,
      "title": "山禽",
      "content": [
        "山禽毛如白练带，栖我庭前栗树枝。",
        "狝猴半夜来取栗，一双中林向月飞。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 267918,
      "title": "秋山",
      "content": [
        "秋山无云复无风，溪头看月出深松。",
        "草堂不闭石床静，叶间坠露声重重。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 267919,
      "title": "玉真观",
      "content": [
        "台殿曾为贵主家，春风吹尽竹窗纱。",
        "院中仙女修香火，不许闲人入看花。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 267920,
      "title": "蛮中",
      "content": [
        "铜柱南边毒草春，行人几日到金麟。",
        "玉镮穿耳谁家女，自抱琵琶迎海神。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 267921,
      "title": "赠道士",
      "content": [
        "茅山近别剡溪逢，玉节青旄十二重。",
        "自说年年上天去，罗浮最近海边峰。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 267922,
      "title": "重平驿作",
      "content": [
        "茫茫菰草平如地，渺渺长堤曲似城。",
        "日暮未知投宿处，逢人更问向前程。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 267923,
      "title": "宿天竺寺寄灵隐寺僧",
      "content": [
        "夜向灵溪息此身，风泉竹露净衣尘。",
        "月明石上堪同宿，那作山南山北人。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 267924,
      "title": "酬朱庆余",
      "content": [
        "越女新妆出镜心，自知明艳更沈吟。",
        "齐纨未是人间贵，一曲菱歌敌万金。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 267926,
      "title": "寒食",
      "content": [
        "绿杨枝上五丝绳，枝弱春多欲不胜。",
        "唯有一年寒食日，女郎相唤摆阶𤺩。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 267927,
      "title": "赋花",
      "content": [
        "花，花。",
        "落早，开赊。",
        "对酒客，兴诗家。",
        "能回游骑，每驻行车。",
        "宛宛清风起，茸茸丽日斜。",
        "且愿相留懽洽，惟愁虚弃光华。",
        "明年攀折知不远，对此谁能更叹嗟。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 267928,
      "title": "句",
      "content": [
        "韩公国大贤，道德赫已闻。",
        "时出为阳山，尔区来趋奔。",
        "韩官迁掾曹，子随至荆门。",
        "韩入为博士，崎岖送归轮。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 301582,
      "title": "虎丘寺",
      "content": [
        "望月登楼海气昏，剑池无底浸云根。",
        "老僧只怕山移去，日暮先教锁寺门。",
        "（康熙顾湄《虎丘志》三《寺字》）。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 303745,
      "title": "咏陀罗山",
      "content": [
        "凿开混沌露元气，散布森罗弥梵天。",
        "云外无时不闲在，楼居何处得超然。",
        "（《记纂渊海》卷二三）。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 334297,
      "title": "乐府杂曲：鼓吹曲辞：朱鹭",
      "content": [
        "翩翩兮朱鹭，来泛春塘栖绿树。",
        "羽毛如翦色如染，远飞欲下双翅敛。",
        "避人引子入深堑，动处水纹开滟滟。",
        "谁知豪家网尔躯，不如饮啄江海隅。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 334352,
      "title": "横吹曲辞：陇头",
      "content": [
        "陇头已断人不行，胡骑夜入凉州城。",
        "汉家处处格斗死，",
        "去年中国养子孙，今著毡裘学胡语。",
        "谁能更使李轻车，"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 334377,
      "title": "横吹曲辞：出塞",
      "content": [
        "秋塞雪初下，将军远出师。",
        "分营长记火，放马不收旗。",
        "月冷边帐湿，沙昏夜探迟。",
        "征人皆白首，谁见灭胡时。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 334401,
      "title": "横吹曲辞：望行人",
      "content": [
        "秋风窗下起，旅雁向南飞。",
        "日日出门望，家家行客归。",
        "无因见边使，空待寄寒衣。",
        "独闭青楼暮，烟深鸟雀稀。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 334411,
      "title": "横吹曲辞：关山月",
      "content": [
        "秋月朗朗关山上，山中行人马蹄响。",
        "关山秋来雨雪多，",
        "军中探骑暮出城，伏兵暗处低旌戟。",
        "溪水连地霜草平，",
        "可怜万国关山道，年年战骨多秋草。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 334458,
      "title": "相和歌辞：江南曲",
      "content": [
        "江南人家多橘树，吴姬舟上织白纻。",
        "土地卑湿饶虫蛇，",
        "青莎覆城竹为屋，无井家家饮潮水。",
        "长江午日酤春酒，",
        "江南风土欢乐多，悠悠处处尽经过。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 334505,
      "title": "相和歌辞：楚妃叹",
      "content": [
        "湘云初起江沉沉，君王遥在云梦林。",
        "江南雨多旌旗暗，",
        "楚兵满地能逐禽，谁用一身继筋力。",
        "西江若翻云梦中，"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 334506,
      "title": "相和歌辞：楚妃怨",
      "content": [
        "梧桐叶下黄金井，横架辘轳牵素绠。",
        "美人初起天未明，手拂银瓶秋水冷。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 334515,
      "title": "相和歌辞：短歌行",
      "content": [
        "青天荡荡高且虚，上有白日无根株。",
        "流光暂出还入地，",
        "玉卮盛酒置君前，再拜愿君千万年。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 334547,
      "title": "相和歌辞：猛虎行",
      "content": [
        "南山北山树冥冥，猛虎白日绕林行。",
        "向晚一身当道食，",
        "谷中近窟有山村，长向村家取黄犊。",
        "五陵年少不敢射，"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 334585,
      "title": "相和歌辞：董逃行",
      "content": [
        "洛阳城头火曈曈，乱兵烧我天子宫。",
        "宫城南面有深山，",
        "闻道官军犹掠人，旧里如今归未得。",
        "董逃行，汉家几时重太平。"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 334633,
      "title": "相和歌辞：白头吟",
      "content": [
        "请君膝上琴，弹我白头吟。",
        "忆昔君前娇笑语，",
        "春天百草秋始衰，弃我不待白头时。",
        "罗襦玉珥色未暗，",
        "人心回互自无穷，眼前好恶那能定。",
        "君恩已去若再返，"
      ],
      "author": {
        "id": 6145,
        "name": "张籍"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    }
  ],
