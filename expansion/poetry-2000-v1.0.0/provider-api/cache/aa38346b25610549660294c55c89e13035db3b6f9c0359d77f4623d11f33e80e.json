{
  "data": [
    {
      "id": 359398,
      "title": "饮席代官妓赠两从事",
      "content": [
        "新人桥上著春衫，旧主江边侧帽檐。",
        "愿得化为红绶带，许教双凤一时衔。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 359400,
      "title": "代元城吴令暗为答",
      "content": [
        "背阙归藩路欲分，水边风日半西曛。",
        "荆王枕上原无梦，莫枉阳台一片云。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 359401,
      "title": "牡丹",
      "content": [
        "压径复缘沟，当窗又映楼。",
        "终销一国破，不啻万金求。",
        "鸾凤戏三岛，神仙居十洲。",
        "应怜萱草淡，却得号忘忧。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 359402,
      "title": "百果嘲樱桃",
      "content": [
        "珠实虽先熟，琼莩纵早开。",
        "流莺犹故在，争得讳含来。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 359406,
      "title": "一片",
      "content": [
        "一片非烟隔九枝，蓬峦仙仗俨云旗。",
        "天泉水暖龙吟细，",
        "人间桑海朝朝变，莫遣佳期更后期。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359415,
      "title": "酬崔八早梅有赠兼示之作",
      "content": [
        "知访寒梅过野塘，久留金勒为回肠。",
        "谢郎衣袖初翻雪，",
        "维摩一室虽多病，亦要天花作道场。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359417,
      "title": "蜀桐",
      "content": [
        "玉垒高桐拂玉绳，上含非雾下含冰。",
        "枉教紫凤无栖处，斫作秋琴弹坏陵。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 359420,
      "title": "促漏",
      "content": [
        "促漏遥钟动静闻，报章重叠杳难分。",
        "舞鸾镜匣收残黛，",
        "南塘渐暖蒲堪结，两两鸳鸯护水纹。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359421,
      "title": "江东",
      "content": [
        "惊鱼拨剌燕翩翾，独自江东上钓船。",
        "今日春光太漂荡，谢家轻絮沈郎钱。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 359423,
      "title": "荷花",
      "content": [
        "都无色可并，不奈此香何。",
        "瑶席乘凉设，金羁落晚过。",
        "回衾灯照绮，渡袜水沾罗。",
        "预想前秋别，离居梦棹歌。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 359426,
      "title": "送臻师二首",
      "content": [
        "昔去灵山非拂席，今来沧海欲求珠。",
        "楞伽顶上清凉地，善眼仙人忆我无。",
        "苦海迷途去未因，东方过此几微尘。",
        "何当百亿莲花上，一一莲花见佛身。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 359428,
      "title": "谢先辈防纪念拙诗甚多，异日偶有此寄",
      "content": [
        "晓用云添句，寒将雪命篇。",
        "良辰多自感，作者岂皆然。",
        "熟寝初同鹤，含嘶欲并蝉。",
        "题时长不展，得处定应偏。",
        "南浦无穷树，西楼不住烟。",
        "改成人寂寂，寄与路绵绵。",
        "星势寒垂地，河声晓上天。",
        "夫君自有恨，聊借此中传。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359429,
      "title": "马嵬二首",
      "content": [
        "冀马燕犀动地来，自埋红粉自成灰。",
        "君王若道能倾国，玉辇何由过马嵬。",
        "海外徒闻更九州，他生未卜此生休。",
        "空闻虎旅传宵柝，",
        "如何四纪为天子，不及卢家有莫愁。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359430,
      "title": "可叹",
      "content": [
        "幸会东城宴未回，年华忧共水相催。",
        "梁家宅里秦宫入，",
        "宓妃愁坐芝田馆，用尽陈王八斗才。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359431,
      "title": "望喜驿别嘉陵江水二绝",
      "content": [
        "嘉陵江水此东流，望喜楼中忆阆州。",
        "若到阆中还赴海，阆州应更有高楼。",
        "千里嘉陵江水色，含烟带月碧于蓝。",
        "今朝相送东流后，犹自驱车更向南。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 359432,
      "title": "别薛岩宾",
      "content": [
        "曙爽行将拂，晨清坐欲凌。",
        "别离真不那，风物正相仍。",
        "漫水任谁照，衰花浅自矜。",
        "还将两袖泪，同向一窗灯。",
        "桂树乖真隐，芸香是小惩。",
        "清规无以况，且用玉壶冰。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359433,
      "title": "富平少侯",
      "content": [
        "七国三边未到忧，十三身袭富平侯。",
        "不收金弹抛林外，",
        "当关不报侵晨客，新得佳人字莫愁。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359434,
      "title": "肠",
      "content": [
        "有怀非惜恨，不奈寸肠何。",
        "即席回弥久，前时断固多。",
        "热应翻急烧，冷欲彻微波。",
        "隔树澌澌雨，通池点点荷。",
        "倦程山向背，望国阙嵯峨。",
        "故念飞书及，新欢借梦过。",
        "染筠休伴泪，绕雪莫追歌。",
        "拟问阳台事，年深楚语讹。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359438,
      "title": "月夕",
      "content": [
        "草下阴虫叶上霜，朱栏迢递压湖光。",
        "兔寒蟾冷桂花白，此夜姮娥应断肠。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 359440,
      "title": "灯",
      "content": [
        "皎洁终无倦，煎熬亦自求。",
        "花时随酒远，雨后背窗休。",
        "冷暗黄茅驿，暄明紫桂楼。",
        "锦囊名画掩，玉局败棋收。",
        "何处无佳梦，谁人不隐忧。",
        "影随帘押转，光信簟文流。",
        "客自胜潘岳，侬今定莫愁。",
        "固应留半焰，回照下帏羞。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359442,
      "title": "袜",
      "content": [
        "尝闻宓妃袜，渡水欲生尘。",
        "好借常娥著，清秋踏月轮。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 359445,
      "title": "离亭赋得折杨柳二首",
      "content": [
        "暂凭樽酒送无憀，莫损愁眉与细腰。",
        "人世死前惟有别，春风争拟惜长条。",
        "含烟惹雾每依依，万绪千条拂落晖。",
        "为报行人休尽折，半留相送半迎归。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 359451,
      "title": "东下三旬苦于风土马上戏作",
      "content": [
        "路绕函关东复东，身骑征马逐惊蓬。",
        "天池辽阔谁相待，日日虚乘九万风。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 359455,
      "title": "有感",
      "content": [
        "中路因循我所长，古来才命两相妨。",
        "劝君莫强安蛇足，一盏芳醪不得尝。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 359456,
      "title": "宫妓",
      "content": [
        "珠箔轻明拂玉墀，披香新殿斗腰支。",
        "不须看尽鱼龙戏，终遣君王怒偃师。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 359458,
      "title": "代赠二首",
      "content": [
        "楼上黄昏欲望休，玉梯横绝月中钩。",
        "芭蕉不展丁香结，同向春风各自愁。",
        "东南日出照高楼，楼上离人唱石州。",
        "总把春山扫眉黛，不知供得几多愁。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 359465,
      "title": "韩冬郎即席为诗相送一座尽惊他日余方追吟连宵侍坐裴回久之句有老成之风因成二绝寄酬兼呈畏之员外",
      "content": [
        "十岁裁诗走马成，冷灰残烛动离情。",
        "桐花万里丹山路，雏凤清于老凤声。",
        "剑栈风樯各苦辛，别时冰雪到时春。",
        "为凭何逊休联句，瘦尽东阳姓沈人。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 359466,
      "title": "评事翁寄赐饧粥走笔为答",
      "content": [
        "粥香饧白杏花天，省对流莺坐绮筵。",
        "今日寄来春已老，凤楼迢递忆秋千。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 359468,
      "title": "圣女祠",
      "content": [
        "松篁台殿蕙香帏，龙护瑶窗凤掩扉。",
        "无质易迷三里雾，",
        "寄问钗头双白燕，每朝珠馆几时归。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359469,
      "title": "独居有怀",
      "content": [
        "麝重愁风逼，罗疏畏月侵。",
        "怨魂迷恐断，娇喘细疑沈。",
        "数急芙蓉带，频抽翡翠簪。",
        "柔情终不远，遥妒已先深。",
        "浦冷鸳鸯去，园空蛱蝶寻。",
        "蜡花长递泪，筝柱镇移心。",
        "觅使嵩云暮，回头灞岸阴。",
        "只闻凉叶院，露井近寒砧。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359471,
      "title": "临发崇让宅紫薇",
      "content": [
        "一树浓姿独看来，秋庭暮雨类轻埃。",
        "不先摇落应为有，",
        "天涯地角同荣谢，岂要移根上苑栽。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359472,
      "title": "及第东归次灞上，却寄同年",
      "content": [
        "芳桂当年各一枝，行期未分压春期。",
        "江鱼朔雁长相忆，",
        "灞陵柳色无离恨，莫枉长条赠所思。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359473,
      "title": "《野菊",
      "content": [
        "苦竹园南椒坞边，微香冉冉泪涓涓。",
        "已悲节物同寒雁，",
        "紫云新苑移花处，不敢霜栽近御筵。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359475,
      "title": "过伊仆射旧宅",
      "content": [
        "朱邸方酬力战功，华筵俄叹逝波穷。",
        "回廊簷断燕飞去，",
        "何能更涉泷江去，独立寒流吊楚宫。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359478,
      "title": "银河吹笙",
      "content": [
        "怅望银河吹玉笙，楼寒院冷接平明。",
        "重衾幽梦他年断，",
        "不须浪作缑山意，湘瑟秦箫自有情。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359479,
      "title": "与同年李定言曲水闲话戏作",
      "content": [
        "海燕参差沟水流，同君身世属离忧。",
        "相携花下非秦赘，",
        "莫惊五胜埋香骨，地下伤春亦白头。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359480,
      "title": "彭城公薨后赠杜二十七胜李十七潘二君并与愚同出故尚书安平公门下",
      "content": [
        "梁山兖水约从公，两地参差一旦空。",
        "谢墅庾村相吊后，自今岐路各西东。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 359481,
      "title": "闻歌",
      "content": [
        "敛笑凝眸意欲歌，高云不动碧嵯峨。",
        "铜台罢望归何处，",
        "此声肠断非今日，香灺灯光奈尔何。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359482,
      "title": "赠华阳宋真人兼寄清都刘先生",
      "content": [
        "沦谪千年别帝宸，至今犹谢蕊珠人。",
        "但惊茅许同仙籍，",
        "不因杖屦逢周史，徐甲何曾有此身。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359483,
      "title": "楚宫二首",
      "content": [
        "十二峰前落照微，高唐宫暗坐迷归。",
        "朝云暮雨长相接，犹自君王恨见稀。",
        "月姊曾逢下彩蟾，倾城消息隔重帘。",
        "已闻佩响知腰细，",
        "王昌且在墙东住，未必金堂得免嫌。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359484,
      "title": "和友人戏赠二首",
      "content": [
        "东望花楼曾不同，西来双燕信休通。",
        "仙人掌冷三霄露，",
        "殷勤莫使清香透，牢合金鱼锁桂丛。",
        "迢递青门有几关，柳梢楼角见南山。",
        "明珠可贯须为佩，",
        "猿啼鹤怨终年事，未抵熏炉一夕间。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359485,
      "title": "题二首后重有戏赠任秀才",
      "content": [
        "一丈红蔷拥翠筠，罗窗不识绕街尘。",
        "峡中寻觅长逢雨，",
        "适知小阁还斜照，羡杀乌龙卧锦茵。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359486,
      "title": "有感二首",
      "content": [
        "九服归元化，三灵叶睿图。",
        "如何本初辈，自取屈牦诛。",
        "有甚当车泣，因劳下殿趋。",
        "何成奏云物，直是灭萑苻。",
        "证逮符书密，辞连性命俱。",
        "竟缘尊汉相，不早辨胡雏。",
        "鬼箓分朝部，军烽照上都。",
        "敢云堪恸哭，未免怨洪炉。",
        "丹陛犹敷奏，彤庭欻战争。",
        "临危对卢植，始悔用庞萌。",
        "御仗收前殿，兵徒剧背城。",
        "苍黄五色棒，掩遏一阳生。",
        "古有清君侧，今非乏老成。",
        "素心虽未易，此举太无名。",
        "谁瞑衔冤目，宁吞欲绝声。",
        "近闻开寿宴，不废用咸英。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359487,
      "title": "重有感",
      "content": [
        "玉帐牙旗得上游，安危须共主君忧。",
        "窦融表已来关右，",
        "昼号夜哭兼幽显，早晚星关雪涕收。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359490,
      "title": "春雨",
      "content": [
        "怅卧新春白袷衣，白门寥落意多违。",
        "红楼隔雨相望冷，",
        "玉珰缄劄何由达，万里云罗一雁飞。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359491,
      "title": "中元作",
      "content": [
        "绛节飘飖宫国来，中元朝拜上清回。",
        "羊权须得金条脱，",
        "有娀未抵瀛洲远，青雀如何鸩鸟媒。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359493,
      "title": "楚宫",
      "content": [
        "湘波如泪色漻漻，楚厉迷魂逐恨遥。",
        "枫树夜猿愁自断，",
        "但使故乡三户在，彩丝谁惜惧长蛟。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359494,
      "title": "妓席暗记送同年独孤云之武昌",
      "content": [
        "叠嶂千重叫恨猿，长江万里洗离魂。",
        "武昌若有山头石，为拂苍苔检泪痕。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 359495,
      "title": "宿晋昌亭闻惊禽",
      "content": [
        "羁绪鳏鳏夜景侵，高窗不掩见惊禽。",
        "飞来曲渚烟方合，",
        "失群挂木知何限，远隔天涯共此心。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359496,
      "title": "深宫",
      "content": [
        "金殿销香闭绮栊，玉壶传点咽铜龙。",
        "狂飙不惜萝阴薄，",
        "岂知为雨为云处，只有高唐十二峰。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359497,
      "title": "明禅师院酬从兄见寄",
      "content": [
        "贞吝嫌兹世，会心驰本原。",
        "人非四禅缚，地绝一尘喧。",
        "霜露欹高木，星河压故园。",
        "斯游傥为胜，九折幸回轩。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 359501,
      "title": "崇让宅东亭醉后沔然有作",
      "content": [
        "曲岸风雷罢，东亭霁日凉。",
        "新秋仍酒困，幽兴暂江乡。",
        "摇落真何遽，交亲或未忘。",
        "一帆彭蠡月，数雁塞门霜。",
        "俗态虽多累，仙标发近狂。",
        "声名佳句在，身世玉琴张。",
        "万古山空碧，无人鬓免黄。",
        "骅骝忧老大，𫛸鴂妒芬芳。",
        "密竹沈虚籁，孤莲泊晚香。",
        "如何此幽胜，淹卧剧清漳。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359506,
      "title": "寄成都高苗二从事",
      "content": [
        "红莲幕下紫梨新，命断湘南病渴人。",
        "今日问君能寄否，二江风水接天津。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 359507,
      "title": "郑州献从叔舍人褎",
      "content": [
        "蓬岛烟霞阆苑钟，三官笺奏附金龙。",
        "茅君奕世仙曹贵，",
        "不知他日华阳洞，许上经楼第几重。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359510,
      "title": "题白石莲花寄楚公",
      "content": [
        "白石莲花谁所共，六时长捧佛前灯。",
        "空庭苔藓饶霜露，",
        "漫夸鹙子真罗汉，不会牛车是上乘。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359511,
      "title": "安定城楼",
      "content": [
        "迢递高城百尺楼，绿杨枝外尽汀洲。",
        "贾生年少虚垂泪，",
        "不知腐鼠成滋味，猜意鸳雏竟未休。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359512,
      "title": "隋宫守岁",
      "content": [
        "消息东郊木帝回，宫中行乐有新梅。",
        "沈香甲煎为庭燎，",
        "昭阳第一倾城客，不踏金莲不肯来。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359513,
      "title": "利州江潭作",
      "content": [
        "神剑飞来不易销，碧潭珍重驻兰桡。",
        "自携明月移灯疾，",
        "他时燕脯无人寄，雨满空城蕙叶雕。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359514,
      "title": "即目",
      "content": [
        "地宽楼已迥，人更迥于楼。",
        "细意经春物，伤酲属暮愁。",
        "望赊殊易断，恨久欲难收。",
        "大势真无利，多情岂自由。",
        "空园兼树废，败港拥花流。",
        "书去青枫驿，鸿归杜若洲。",
        "单栖应分定，辞疾索谁忧。",
        "更替林鸦恨，惊频去不休。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359516,
      "title": "茂陵",
      "content": [
        "汉家天马出蒲梢，苜蓿榴花遍近郊。",
        "内苑只知含凤觜，",
        "谁料苏卿老归国，茂陵松柏雨萧萧。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359517,
      "title": "镜槛",
      "content": [
        "镜槛芙蓉入，香台翡翠过。",
        "拨弦惊火凤，交扇拂天鹅。",
        "隐忍阳城笑，喧传郢市歌。",
        "仙眉琼作叶，佛髻钿为螺。",
        "五里无因雾，三秋只见河。",
        "月中供药剩，海上得绡多。",
        "玉集胡沙割，犀留圣水磨。",
        "斜门穿戏蝶，小阁锁飞蛾。",
        "骑襜侵鞯卷，车帷约幰𨱂。",
        "传书两行雁，取酒一封驼。",
        "桥迥凉风压，沟横夕照和。",
        "待乌燕太子，驻马魏东阿。",
        "想像铺芳褥，依稀解醉罗。",
        "散时帘隔露，卧后幕生波。",
        "梯稳从攀桂，弓调任射莎。",
        "岂能抛断梦，听鼓事朝珂。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359519,
      "title": "风",
      "content": [
        "迥拂来鸿急，斜催别燕高。",
        "已寒休惨澹，更远尚呼号。",
        "楚色分西塞，夷音接下牢。",
        "归舟天外有，一为戒波涛。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 359522,
      "title": "喜舍弟羲叟及第上礼部魏公",
      "content": [
        "国以斯文重，公仍内署来。",
        "风标森太华，星象逼中台。",
        "朝满迁莺侣，门多吐凤才。",
        "宁同鲁司寇，惟铸一颜回。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 359531,
      "title": "代秘书赠弘文馆诸校书",
      "content": [
        "清切曹司近玉除，比来秋兴复何如。",
        "崇文馆里丹霜后，无限红梨忆校书。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 359533,
      "title": "日日",
      "content": [
        "日日春光斗日光，山城斜路杏花香。",
        "几时心绪浑无事，得及游丝百尺长。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 359536,
      "title": "泪",
      "content": [
        "永巷长年怨绮罗，离情终日思风波。",
        "湘江竹上痕无限，",
        "朝来灞水桥边问，未抵青袍送玉珂。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359537,
      "title": "十字水期韦潘侍御同年不至时韦寓居水次故郭汾宁宅",
      "content": [
        "伊水溅溅相背流，朱栏画阁几人游。",
        "漆灯夜照真无数，",
        "西园碧树今谁主，与近高窗卧听秋。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359538,
      "title": "流莺",
      "content": [
        "流莺漂荡复参差，渡陌临流不自持。",
        "巧啭岂能无本意，",
        "曾苦伤春不忍听，凤城何处有花枝。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359539,
      "title": "出关宿盘豆馆对丛芦有感",
      "content": [
        "芦叶梢梢夏景深，邮亭暂欲洒尘襟。",
        "昔年曾是江南客，",
        "清声不远行人去，一世荒城伴夜砧。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359540,
      "title": "和韩录事送宫人入道",
      "content": [
        "星使追还不自由，双童捧上绿琼辀。",
        "九枝灯下朝金殿，",
        "当时若爱韩公子，埋骨成灰恨未休。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359542,
      "title": "圣女祠",
      "content": [
        "杳蔼逢仙迹，苍茫滞客途。",
        "何年归碧落，此路向皇都。",
        "消息期青雀，逢迎异紫姑。",
        "肠回楚国梦，心断汉宫巫。",
        "从骑裁寒竹，行车荫白榆。",
        "星娥一去后，月姊更来无。",
        "寡鹄迷苍壑，羁凰怨翠梧。",
        "惟应碧桃下，方朔是狂夫。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359543,
      "title": "七月二十九日崇让宅宴作",
      "content": [
        "露如微霰下前池，月过回塘万竹悲。",
        "浮世本来多聚散，",
        "岂到白头长只尔，嵩阳松雪有心期。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359544,
      "title": "赠从兄阆之",
      "content": [
        "怅望人间万事违，私书幽梦约忘机。",
        "荻花村里鱼标在，",
        "城中猘犬憎兰佩，莫损幽芳久不归。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359545,
      "title": "吴宫",
      "content": [
        "龙槛沉沉水殿清，禁门深掩断人声。",
        "吴王宴罢满宫醉，日暮水漂花出城。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 359547,
      "title": "残花",
      "content": [
        "残花啼露莫留春，尖发谁非怨别人。",
        "若但掩关劳独梦，宝钗何日不生尘。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 359549,
      "title": "西亭",
      "content": [
        "此夜西亭月正圆，疏帘相伴宿风烟。",
        "梧桐莫更翻清露，孤鹤从来不得眠。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 359551,
      "title": "昨夜",
      "content": [
        "不辞𫛸鴂妒年芳，但惜流尘暗烛房。",
        "昨夜西池凉露满，桂花吹断月中香。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 359552,
      "title": "海客",
      "content": [
        "海客乘槎上紫氛，星娥罢织一相闻。",
        "只应不惮牵牛妒，聊用支机石赠君。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 359554,
      "title": "早起",
      "content": [
        "风露澹清晨，帘间独起人。",
        "莺花啼又笑，毕竟是谁春。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 359556,
      "title": "行至金牛驿寄兴元渤海尚书",
      "content": [
        "楼上春云水底天，五云章色破巴笺。",
        "诸生个个王恭柳，",
        "深惭走马金牛路，骤和陈王白玉篇。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359557,
      "title": "深树见一颗樱桃尚在",
      "content": [
        "高桃留晚实，寻得小庭南。",
        "矮堕绿云髻，欹危红玉簪。",
        "惜堪充凤食，痛已被莺含。",
        "越鸟夸香荔，齐名亦未甘。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 359558,
      "title": "细雨",
      "content": [
        "帷飘白玉堂，簟卷碧牙床。",
        "楚女当时意，萧萧发彩凉。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 359561,
      "title": "魏侯第东北楼堂郢叔言别，聊用书所见成篇",
      "content": [
        "暗楼连夜阁，不拟为黄昏。",
        "未必断别泪，何曾妨梦魂。",
        "疑穿花逶迤，渐近火温黁。",
        "海底翻无水，仙家却有村。",
        "锁香金屈戌，𣨼酒玉昆仑。",
        "羽白风交扇，冰清月映盆。",
        "旧欢尘自积，新岁电犹奔。",
        "霞绮空留段，云峰不带根。",
        "念君千里舸，江草漏灯痕。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359564,
      "title": "到秋",
      "content": [
        "扇风淅沥簟流离，万里南风滞所思。",
        "守到清秋还寂寞，叶丹苔碧闭门时。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 359565,
      "title": "华师",
      "content": [
        "孤鹤不睡云无心，衲衣筇杖来西林。",
        "院门昼锁回廊静，秋日当阶柿叶阴。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 359567,
      "title": "过华清内厩门",
      "content": [
        "华清别馆闭黄昏，碧草悠悠内厩门。",
        "自是明时不巡幸，至今青海有龙孙。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 359569,
      "title": "赠荷花",
      "content": [
        "世间花叶不相伦，花入金盆叶作尘。",
        "惟有绿荷红菡萏，"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359570,
      "title": "丹丘",
      "content": [
        "青女丁宁结夜霜，羲和辛苦送朝阳。",
        "丹丘万里无消息，几对梧桐忆凤凰。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 359572,
      "title": "小桃园",
      "content": [
        "竟日小桃园，休寒亦未暄。",
        "坐莺当酒重，送客出墙繁。",
        "啼久艳粉薄，舞多香雪翻。",
        "犹怜未圆月，先出照黄昏。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 359574,
      "title": "和张秀才落花有感",
      "content": [
        "晴暖感余芳，红苞杂绛房。",
        "落时犹自舞，扫后更闻香。",
        "梦罢收罗荐，仙归敕玉箱。",
        "回肠九回后，犹有剩回肠。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 359578,
      "title": "昭肃皇帝挽歌辞三首",
      "content": [
        "九县怀雄武，三灵仰睿文。",
        "周王传叔父，汉后重神君。",
        "玉律朝惊露，金茎夜切云。",
        "笳箫凄欲断，无复咏横汾。",
        "玉塞惊宵柝，金桥罢举烽。",
        "始巢阿阁凤，旋驾鼎湖龙。",
        "门咽通神鼓，楼凝警夜钟。",
        "小臣观吉从，犹误欲东封。",
        "莫验昭华管，虚传甲帐神。",
        "海迷求药使，雪隔献桃人。",
        "桂寝青云断，松扉白露新。",
        "万方同象鸟，举恸满秋尘。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 359579,
      "title": "梓州罢吟寄同舍",
      "content": [
        "不拣花朝与雪朝，五年从事霍嫖姚。",
        "君缘接座交珠履，",
        "长吟远下燕台去，惟有衣香染未销。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359580,
      "title": "无题二首",
      "content": [
        "凤尾香罗薄几重，碧文圆顶夜深缝。",
        "扇裁月魄羞难掩，",
        "斑骓只系垂杨岸，何处西南任好风。",
        "重帷深下莫愁堂，卧后清宵细细长。",
        "神女生涯原是梦，",
        "直道相思了无益，未妨惆怅是清狂。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359582,
      "title": "昨日",
      "content": [
        "昨日紫姑神去也，今朝青鸟使来赊。",
        "未容言语还分散，",
        "平明钟后更何事，笑倚墙边梅树花。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 359583,
      "title": "樱桃花下",
      "content": [
        "流莺舞蝶两相欺，不取花芳正结时。",
        "他日未开今日谢，嘉辰长短是参差。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 359589,
      "title": "无愁果有愁曲北齐歌",
      "content": [
        "东有青龙西白虎，中含福星包世度。",
        "玉壶渭水笑清潭，",
        "秋娥点滴不成泪，十二玉楼无故钉。",
        "推烟唾月抛千里，",
        "日暮向风牵短丝，血凝血散今谁是。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 359591,
      "title": "齐梁晴云",
      "content": [
        "缓逐烟波起，如妒柳绵飘。",
        "故临飞阁度，欲入回陂销。",
        "萦歌怜画扇，敞景弄柔条。",
        "更奈天南位，牛渚宿残宵。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 359592,
      "title": "效徐陵体赠更衣",
      "content": [
        "密帐真珠络，温帏翡翠装。",
        "楚腰知便宠，宫眉正斗强。",
        "结带悬栀子，绣领刺鸳鸯。",
        "轻寒衣省夜，金斗熨沈香。"
      ],
      "author": {
        "id": 5871,
        "name": "李商隐"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 359597,
      "title": "汴上送李郢之苏州",
      "content": [
        "人高诗苦滞夷门，万里梁王有旧园。",
        "烟幌自应怜白纻，",
        "苏小小坟今在否，紫兰香径与招魂。"
      ],
      "author": {
