      }
    },
    {
      "id": 261231,
      "title": "送颜推官游银夏谒韩大夫",
      "content": [
        "丛篁叫寒笛，满眼塞山青。",
        "才子尊前画，将军石上铭。",
        "猎声云外响，战血雨中腥。",
        "苦乐从来事，因君一涕零。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261232,
      "title": "咸阳送房济侍御归太原幕",
      "content": [
        "旧居无旧邻，似见故乡春。",
        "复对别离酒，欲成衰老人。",
        "客衣频染泪，军旅亦多尘。",
        "握手重相勉，平生心所因。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261233,
      "title": "宝泉寺送李益端公归邠宁幕",
      "content": [
        "参差岩障东，云日晃龙宫。",
        "石净非因雨，松凉不为风。",
        "恋泉将鹤并，偷果与猨同。",
        "眼界尘虽染，心源蔽已通。",
        "莲花国何限，贝叶字无穷。",
        "早晚登麟阁，慈门欲付公。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 261234,
      "title": "送何召下第后归蜀",
      "content": [
        "襃斜行客过，栈道响危空。",
        "路湿云初上，山明日正中。",
        "水程通海货，地利杂吴风。",
        "一别金门远，何人复荐雄。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261235,
      "title": "宿定陵寺",
      "content": [
        "古塔荒台出禁墙，磬声初尽漏声长。",
        "云生紫殿幡花湿，月照青山松栢香。",
        "禅室夜闻风过竹，奠筵朝启露霑裳。",
        "谁悟威灵同寂灭，更堪砧杵发昭阳。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
