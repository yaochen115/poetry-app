{
  "data": [
    {
      "id": 261136,
      "title": "寻贾尊师",
      "content": [
        "玉洞秦时客，焚香映绿萝。",
        "新传左慈诀，曾与右军鹅。",
        "井臼阴苔遍，方书古字多。",
        "成都今日雨，应与酒相和。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261137,
      "title": "秋中过独孤郊居",
      "content": [
        "开园过水到郊居，共引家童拾野蔬。",
        "高树夕阳连古巷，菊花棃叶满荒渠。",
        "秋山近处行过寺，夜雨寒时起读书。",
        "帝里诸亲别来久，岂知王粲爱樵渔。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 261138,
      "title": "同耿拾遗春中题第四郎新修书院",
      "content": [
        "得接西园会，多因野性同。",
        "引藤连树影，移石间花丛。",
        "学就晨昏外，欢生礼乐中。",
        "春游随墨客，夜宿伴潜公。",
        "散帙灯惊燕，开帘月带风。",
        "朝朝在门下，自与五侯通。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 261139,
      "title": "春日题杜叟山下别业",
      "content": [
        "白鸟群飞山半晴，渚田相接有泉声。",
        "园中晓露青丛合，桥上春风绿野明。",
        "云影断来峰影出，林花落尽草花生。",
        "今朝醉舞同君乐，始信幽人不爱荣。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 261140,
      "title": "过终南柳处士",
      "content": [
        "五老正相寻，围棋到煮金。",
        "石摧丹井闭，月过洞门深。",
        "猨鸟三时下，藤萝十里阴。",
        "绿泉多草气，青壁少花林。",
        "自愧非仙侣，何言见道心。",
        "悠哉宿山口，雷雨夜沈沈。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 261141,
      "title": "宿澄上人院",
      "content": [
        "竹窗闻远水，月出似溪中。",
        "香覆经年火，幡飘后夜风。",
        "性昏知道晚，学浅喜言同。",
        "一悟归身处，何山路不通。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261142,
      "title": "题李沆林园",
      "content": [
        "古巷牛羊出，重门接柳阴。",
        "闲看入竹路，自有向山心。",
        "种药齐幽石，耕田到远林。",
        "愿同词赋客，得兴谢家深。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261143,
      "title": "过司空曙村居",
      "content": [
        "南北与山邻，蓬庵庇一身。",
        "繁霜疑有雪，枯草似无人。",
        "遂性在耕稼，所交唯贱贫。",
        "何言张掾傲，每重德璋亲。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261144,
      "title": "题念济寺晕上人院",
      "content": [
        "泉响竹潇潇，潜公居处遥。",
        "虚空闻偈夜，清净雨花朝。",
        "放鹤临山阁，降龙步石桥。",
        "世尘徒委积，劫火定焚烧。",
        "苔壁云难聚，风篁露易摇。",
        "浮生亦无著，况乃是芭蕉。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 261145,
      "title": "题杨虢县竹亭",
      "content": [
        "夜宿密公室，话馀将昼兴。",
        "遶堦三迳雪，当户一池冰。",
        "家训资风化，心源隐政能。",
        "明朝复何见，莱草古沟堘。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261146,
      "title": "过楼观李尊师",
      "content": [
        "城阙望烟霞，常悲仙路赊。",
        "宁知樵子径，得到葛洪家。",
        "犬吠松间月，人行洞里花。",
        "留诗千岁鹤，送客五云车。",
        "访世山空在，观棋日未斜。",
        "不知尘俗士，谁解种胡麻。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 261147,
      "title": "雪谤后逢李叔度",
      "content": [
        "相逢空握手，往事不堪思。",
        "见少情难尽，愁深语自迟。",
        "草生分路处，雨散出山时。",
        "强得宽离恨，唯当说后期。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261148,
      "title": "春日过李侍御",
      "content": [
        "高柳满春城，东园有鸟声。",
        "折花朝露滴，漱石野泉清。",
        "心许陶家醉，诗逢谢客呈。",
        "应怜末行吏，曾是鲁诸生。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261149,
      "title": "出山逢耿𣲗",
      "content": [
        "云雪离披山万里，别来曾住最高峰。",
        "暂到人间归不得，长安陌上又相逢。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 261150,
      "title": "题金吾郭将军石伏茅堂",
      "content": [
        "云戟曙沈沈，轩墀清且深。",
        "家传成栋美，尧宠结茅心。",
        "玉佩多依石，油幢亦在林。",
        "炉香诸洞暖，殿影众山阴。",
        "草奏风生笔，筵开雪满琴。",
        "客从龙阙至，僧自虎溪寻。",
        "萧洒延清赏，风流会素襟。",
        "终朝息尘步，一醉间华簪。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 261151,
      "title": "题贾山人园林",
      "content": [
        "竹影朦胧松影长，素琴清簟好风凉。",
        "连春诗会烟花满，半夜酒醒兰蕙香。",
        "五字每将称玉友，一尊曾不顾金囊。",
        "长沙流谪君非远，莫遣英名负洛阳。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 261152,
      "title": "秋夜同畅当宿藏公院",
      "content": [
        "礼足一垂泪，医王知病由。",
        "风萤方喜夜，露槿已伤秋。",
        "顾以儿童爱，每从仁者求。",
        "将祈竟何得，灭迹在缁流。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261153,
      "title": "重同畅当奘公院闻琴",
      "content": [
        "悮以音声祈远公，请将徽轸付秋风。",
        "漾漾硖流吹不尽，月华如在白波中。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 261154,
      "title": "同耿𣲗宿陆澧旅舍",
      "content": [
        "当轩云月开，清夜故人桮。",
        "拥褐觉霜下，抱琴闻鴈来。",
        "迎风君顾步，临路我迟回。",
        "双鬓共如此，此懽非易陪。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261155,
      "title": "题苗员外竹间亭",
      "content": [
        "高甃绝行尘，开帘似有春。",
        "风倾竹上雪，山对酒边人。",
        "步暖先逢日，书空远见邻。",
        "还同内斋暇，登赏及诸姻。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261156,
      "title": "奉陪侍中登白楼",
      "content": [
        "高楼倚玉梯，朱槛与云齐。",
        "顾盼亲霄汉，谈谐息鼓鼙。",
        "洪河斜更直，野雨急仍低。",
        "今日陪尊俎，唯当醉似泥。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261157,
      "title": "九日奉陪侍郎登白楼",
      "content": [
        "碧霄孤鹤发清音，上宰因添望阙心。",
        "睥睨三层连步障，茱萸一朵映华簪。",
        "红霞似绮河如带，白露团珠菊散金。",
        "此日所从何所问，俨然冠剑拥成林。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 261158,
      "title": "春日喜雨奉和马侍中宴白楼",
      "content": [
        "鹳鹤相呼绿野宽，鼎臣闲倚玉栏干。",
        "洪河拥沫流仍急，苍岭和云色更寒。",
        "艳艳风光呈瑞岁，泠泠歌颂振雕盘。",
        "今朝醉舞共乡老，不觉倾欹獬豸冠。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 261159,
      "title": "奉陪侍中游石笋溪十二韵",
      "content": [
        "朝日照灵山，山溪浩纷错。",
        "图书无旧记，鲧禹应新凿。",
        "双壁泻天河，一峰吐莲萼。",
        "潭心乱雪卷，嵓腹繁珠落。",
        "彩蛤攒锦囊，芳萝袅花索。",
        "猨群曝阳岭，龙穴腥阴壑。",
        "静得渔者言，闲闻洞仙博。",
        "欹松倚朱幰，广石屯油幕。",
        "国泰事留侯，山春纵康乐。",
        "间关殊状鸟，烂熳无名药。",
        "欲验少君方，还吟大隐作。",
        "旌幢不可驻，古塞新沙漠。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 261160,
      "title": "九日奉陪侍中宴白楼",
      "content": [
        "露白菊氛氲，西楼盛袭文。",
        "玉筵秋令节，金钺汉元勋。",
        "说剑风生座，抽琴鹤遶云。",
        "𫍲儒无以荅，愿得备前军。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261161,
      "title": "九日奉陪侍中宴后亭",
      "content": [
        "玉壶倾菊酒，一顾得淹留。",
        "彩笔征枚叟，花筵舞莫愁。",
        "管弦能驻景，松桂不停秋。",
        "为谢蓬蒿辈，如何霜霰稠。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261162,
      "title": "九日奉陪令公登白楼同咏菊",
      "content": [
        "琼尊犹有菊，可以献留侯。",
        "愿比三花秀，非同百卉秋。",
        "金英分蘂细，玉露结房稠。",
        "黄雀知恩在，衔飞亦上楼。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261163,
      "title": "奉陪浑侍中上巳日泛渭河",
      "content": [
        "青舸锦帆开，浮天接上台。",
        "晚莺和玉笛，春浪动金罍。",
        "舟檝方朝海，鲸鲵自曝腮。",
        "应怜似萍者，空逐榜人回。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261164,
      "title": "奉陪侍中春日过武安君庙",
      "content": [
        "长裾间貔虎，遗庙盛攀登。",
        "白羽三千骑，红林一万层。",
        "元臣达幽契，祝史告明征。",
        "抚坐悲今古，瞻容感废兴。",
        "回风卷藂栢，骤雨湿诸陵。",
        "倏忽烟花霁，当营看月生。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 261165,
      "title": "过玉[真]公主影殿",
      "content": [
        "夕照临窗起暗尘，青松绕殿不知春。",
        "君看白发诵经者，半是宫中歌舞人。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 261166,
      "title": "题嘉祥殿南溪印禅师壁画影堂",
      "content": [
        "双屐参差锡杖斜，衲衣交膝对天花。",
        "瞻容悟问修持劫，似指前溪无数沙。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 261167,
      "title": "题伯夷庙",
      "content": [
        "中条山下黄礓石，垒作夷齐庙里神。",
        "落叶满堦尘满座，不知浇酒为何人。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 261168,
      "title": "早春游樊川野居却寄李端校书兼呈崔峒补阙司空曙主簿耿𣲗拾遗",
      "content": [
        "白水遍沟堘，青山对杜陵。",
        "晴明人望鹤，旷野鹿随僧。",
        "古柳连巢折，荒堤带草崩。",
        "阴桥全覆雪，瀑溜半垂冰。",
        "鬬鼠摇松影，游龟落石层。",
        "韶光偏不待，衰败巧相仍。",
        "桂树曾争折，龙门几共登。",
        "琴师阮校尉，诗和柳吴兴。",
        "舐笔求书扇，张屏看画蝇。",
        "卜邻空遂约，问卦独无征。",
        "投足经危路，收才遇直绳。",
        "守农穷自固，行乐病何能。",
        "掩帙蓬蒿晚，临川景气澄。",
        "飒然成一叟，谁更慕骞腾。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 261169,
      "title": "同钱郎中晚春过慈恩寺",
      "content": [
        "不见僧中旧，仍逢雨后春。",
        "惜花将爱寺，俱是白头人。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 261170,
      "title": "曲江春望 一",
      "content": [
        "菖蒲飜叶柳交枝，暗上莲舟鸟不知。",
        "更到无花最深处，玉楼金殿影参差。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 261171,
      "title": "曲江春望 二",
      "content": [
        "翠黛红粧画鹢中，共惊云色带微风。",
        "箫管曲长吹未尽，花南水北雨蒙蒙。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 261172,
      "title": "曲江春望 三",
      "content": [
        "泉声遍野入芳洲，拥沫吹花草上流。",
        "落日行人渐无路，巢乌乳燕满高楼。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 261173,
      "title": "春日陪李庶子遵善寺东院晓望",
      "content": [
        "映竹水田分，当山起鴈群。",
        "阳峰高对寺，阴井下通云。",
        "雪昼唯逢鹤，花时此见君。",
        "由来禅诵地，多有谢公文。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261174,
      "title": "华清宫 一",
      "content": [
        "汉家天子好经过，白日青山宫殿多。",
        "见说只今生草处，禁泉荒石已相和。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 261175,
      "title": "华清宫 二",
      "content": [
        "水气朦胧满画梁，一回开殿满山香。",
        "宫娃几许经歌舞，白首翻令忆建章。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 261176,
      "title": "题兴善寺后池",
      "content": [
        "隔窗栖白鹤，似与镜湖邻。",
        "月照何年树，花逢几遍人。",
        "岸莎青有路，苔径绿无尘。",
        "永愿容依止，僧中老此身。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261177,
      "title": "陪中书李纾舍人夜泛东池",
      "content": [
        "看月复听琴，移舟出树阴。",
        "夜村机杼急，秋水芰荷深。",
        "石静龟潜上，萍开果暗沈。",
        "何言奉杯酒，得见五湖心。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261178,
      "title": "宴赵氏昆季书院因与会文幷率尔投赠",
      "content": [
        "诗礼挹余波，相懽在琢磨。",
        "琴尊方会集，珠玉忽骈罗。",
        "谢族风流盛，于门福庆多。",
        "花攒骐骥枥，锦绚凤凰窠。",
        "咏雪因饶妹，书经为爱鹅。",
        "仍闻广练被，更有远儒过。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 261179,
      "title": "题天华观",
      "content": [
        "峰嶂徘徊霞景新，一潭寒水绝纤鳞。",
        "朱字灵书千万轴，苍髯道士两三人。",
        "芝童解说壶中事，玉管能留天上春。",
        "眼见仙丹求不得，汉家簪绂在羸身。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 261180,
      "title": "宿石瓮寺",
      "content": [
        "殿有寒灯草有萤，千林万壑寂无声。",
        "烟凝积水龙蛇蛰，露湿空山星汉明。",
        "昏霭雾中悲世界，曙霞光里见王城。",
        "回瞻相好因垂泪，苦海波涛何日平。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 261181,
      "title": "题悟真寺",
      "content": [
        "万峰交掩一峰开，晓色常从天上来。",
        "似到西方诸佛国，莲花影里数楼台。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 261182,
      "title": "题云际寺上方",
      "content": [
        "松高萝蔓轻，中有石床平。",
        "下界水长急，上方灯自明。",
        "空门不易启，初地本无程。",
        "回步忽山尽，万缘从此生。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261183,
      "title": "九日同司直九叔崔侍御登宝鸡南楼",
      "content": [
        "把菊叹将老，上楼悲未还。",
        "短长新白发，重叠旧青山。",
        "霜气清衿袖，琴声引醉颜。",
        "竹林唯七友，何幸亦登攀。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261184,
      "title": "同王员外雨后登开元寺南楼因寄西岩警上人",
      "content": [
        "过雨开楼看晚虹，白云相逐水相通。",
        "寒蝉噪暮野无日，古树伤秋天有风。",
        "数穗远烟凝垅上，一枝繁果忆山中。",
        "何言暂别东林友，惆怅人间事不同。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 261185,
      "title": "同赵进马元阳春日登长春宫古城望河中因寄郑损仓曹",
      "content": [
        "城头春霭晓蒙蒙，指望关桥满袖风。",
        "云骑闲嘶宫柳外，玉人愁立草花中。",
        "钟分寺路山光绿，河绕军州日气红。",
        "迹忝已成方恋赏，此时离恨与君同。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 261186,
      "title": "同崔峒补阙慈恩寺避暑",
      "content": [
        "寺凉高树合，卧石绿阴中。",
        "伴鹤慙僊侣，依僧学老翁。",
        "鱼沈荷叶露，鸟散竹林风。",
        "始悟尘居者，应将火宅同。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261187,
      "title": "春日登楼有怀",
      "content": [
        "花正浓时人正愁，逢花却欲替花羞。",
        "年来笑伴皆归去，今日晴明独上楼。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 261188,
      "title": "长安春望",
      "content": [
        "东风吹雨过青山，却望千门草色闲。",
        "家在梦中何日到，春生江上几人还。",
        "川原缭绕浮云外，宫阙参差落照间。",
        "谁念为儒逢世难，独将衰鬓客秦关。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 261189,
      "title": "冬日登城楼有怀因赠程腾",
      "content": [
        "生涯何事多羁束，赖此登临畅心目。",
        "郭南郭北无数山，万井逶迤流水间。",
        "弹琴对酒不知暮，岸帻题诗身自闲。",
        "风声肃肃鴈飞绝，云色茫茫欲成雪。",
        "遥思海客天外归，坐想征人两头别。",
        "世情多以风尘隔，泣尽无因画筹策。",
        "谁知白首窗下人，不接朱门坐中客。",
        "贱亦不足叹，贵亦不足陈。",
        "长卿未遇杨朱泣，蔡泽无媒原宪贫。",
        "如今万乘方用武，国命天威借貔虎。",
        "穷达皆为身外名，公侯可废刀头取。",
        "君不见汉家边将在边庭，白羽三千出井陉。",
        "当风看猎拥珠翠，岂在终年穷一经。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 261190,
      "title": "过仙游寺",
      "content": [
        "上方下方雪中路，白云流水如闲步。",
        "数峰行尽犹未归，寂寞经声竹阴暮。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 261191,
      "title": "同路郎中韩侍御春日题野寺",
      "content": [
        "寺前山远古陂宽，寺里人稀春草寒。",
        "何事最堪悲色相，折花将与老僧看。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 261192,
      "title": "奉和李益游栖岩寺",
      "content": [
        "林香雨气新，山寺绿无尘。",
        "遂结云外赏，共游天上春。",
        "鹤鸣金阙丽，僧语竹房邻。",
        "待月水流急，惜花风起频。",
        "何方非坏境，此地有归人。",
        "回首空门路，皤然一幻身。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 261193,
      "title": "秋夜同畅当宿潭上西亭",
      "content": [
        "圆月出山头，七贤林下游。",
        "梢梢寒叶坠，滟滟月波流。",
        "凫鹄共思晓，菰蒲相与秋。",
        "明当此中别，一为望汀洲。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261194,
      "title": "山中一绝",
      "content": [
        "饥食松花渴饮泉，偶从山后到山前。",
        "阳坡软草厚如织，因与鹿麛相伴眠。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 261195,
      "title": "与畅当夜泛秋潭",
      "content": [
        "萤火飏莲丛，水凉多夜风。",
        "离人将落叶，俱在一船中。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 261196,
      "title": "秋夜宴集陈翃郎中圃亭美校书郎张正元归乡",
      "content": [
        "泉清兰菊稠，红果落城沟。",
        "保庆台榭古，感时琴瑟秋。",
        "硕儒欢颇至，名士礼能周。",
        "为谢邑中少，无惊池上鸥。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261197,
      "title": "春游东潭",
      "content": [
        "移舟试望家，漾漾似天涯。",
        "日暮满潭雪，白鸥和柳花。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 261198,
      "title": "同薛存诚登栖岩寺",
      "content": [
        "衰蹇步难前，上山如上天。",
        "尘泥来自晚，猨鹤到何先。",
        "万壑应孤磬，百花通一泉。",
        "苍苍此明月，下界正沈眠。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261199,
      "title": "河中府崇福寺看花",
      "content": [
        "闻道山花如火红，平明登寺已经风。",
        "老僧无见亦无说，应与看人心不同。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 261200,
      "title": "冬日宴郭监林亭",
      "content": [
        "玉勒聚如云，森森鸾鹤群。",
        "据梧花罽接，沃盥石泉分。",
        "华味慙初识，新声喜尽闻。",
        "此山招老贱，敢不谢夫君。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261201,
      "title": "奉和李舍人昆季咏玫瑰花寄赠徐侍郎",
      "content": [
        "独鹤寄烟霜，双鸾思晚芳。",
        "旧阴依谢宅，新艳出萧墙。",
        "蝶散摇轻露，莺衔入夕阳。",
        "雨朝胜濯锦，风夜剧焚香。",
        "断日千层艳，孤霞一片光。",
        "密来惊叶少，动处觉枝长。",
        "布影期高赏，留春为远方。",
        "尝闻赠琼玖，叨和愧升堂。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 261202,
      "title": "同耿𣲗司空曙二拾遗题韦员外东斋花树",
      "content": [
        "绿砌红花树，狂风独未吹。",
        "光中疑有燄，密处似无枝。",
        "鸟动香轻发，人愁影屡移。",
        "今朝数片落，为报汉郎知。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261203,
      "title": "观袁修侍郎涨新池",
      "content": [
        "引水香山近，穿云复遶林。",
        "才闻篱外响，已觉石边深。",
        "满处侵苔色，澄来见柳阴。",
        "微风月明夜，知有五湖心。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261204,
      "title": "和徐法曹赠崔洛阳斑竹杖以诗见荅",
      "content": [
        "玉干一寻余，苔花锦不如。",
        "劲堪和醉倚，轻好向空书。",
        "采拂稽山曲，因依释氏居。",
        "方辰将独步，岂与此君疎。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261205,
      "title": "早秋望华清宫中树因以成咏",
      "content": [
        "可怜云木藂，满禁碧蒙蒙。",
        "色润灵泉近，阴清辇路通。",
        "玉坛标八桂，金井识双桐。",
        "交映凝寒露，相和起夜风。",
        "数枝盘石上，几叶落云中。",
        "燕拂宜秋霁，蝉鸣觉昼空。",
        "翠屏更隐见，珠缀共玲珑。",
        "雷雨生成早，樵苏禁令雄。",
        "野藤高助绿，仙果迥呈红。",
        "惆怅缭垣暮，兹山闻暗蛩。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 261206,
      "title": "小鱼咏寄泾州杨侍郎",
      "content": [
        "莲花影里暂相离，才出浮萍值罟师。",
        "上得龙门还失浪，九江何处是归期。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 261207,
      "title": "贼中与严越卿曲江看花",
      "content": [
        "红枝欲折紫枝殷，隔水连宫不用攀。",
        "会待长风吹落尽，始能开眼向青山。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 261208,
      "title": "同畅当咏蒲团",
      "content": [
        "团团锦花结，乃是前溪蒲。",
        "拥坐称儒褐，倚眠宜病夫。",
        "唯当学禅寂，终老与之俱。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 261209,
      "title": "焦篱店醉题",
      "content": [
        "洛下渠头百卉新，满筵歌笑独伤春。",
        "何须更弄邵翁伯，即我此身如此人。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 261210,
      "title": "陈翃中丞东斋赋白玉簪",
      "content": [
        "美矣新成太华峰，翠莲枝折叶重重。",
        "松阴满涧闲飞鹤，潭影通云暗上龙。",
        "漠漠水香风颇馥，涓涓乳溜味何浓。",
        "因声远报浮丘子，不奏登封时不容。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 261211,
      "title": "新茶咏寄上西川相公二十三舅大夫二十舅",
      "content": [
        "三献蓬莱始一尝，日调金鼎阅芳香。",
        "贮之玉合才半饼，寄与阿连题数行。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 261212,
      "title": "泊扬子江岸",
      "content": [
        "山映南徐暮，千帆入古津。",
        "鱼惊出浦火，月照渡江人。",
        "清镜催双鬓，沧波寄一身。",
        "空怜莎草色，长接故园春。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261213,
      "title": "晚次鄂州",
      "content": [
        "云开远见汉阳城，犹是孤帆一日程。",
        "估客昼眠知浪静，舟人夜语觉潮生。",
        "三湘衰鬓逢秋色，万里归心对月明。",
        "旧业已随征战尽，更堪江上鼓鼙声。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 261214,
      "title": "夜投丰德寺谒海上人",
      "content": [
        "半夜中峰有磬声，偶逢樵者问山名。",
        "上方月晓闻僧语，下路林疎见客行。",
        "野鹤巢边松最老，毒龙潜处水偏清。",
        "愿得远公知姓字，焚香洗钵过浮生。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 261215,
      "title": "江行次武昌县",
      "content": [
        "家寄五湖间，扁舟往复还。",
        "年年生白发，处处上青山。",
        "去国空知远，安身竟不闲。",
        "更悲江畔柳，长是北人攀。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261216,
      "title": "夜泊金陵",
      "content": [
        "圆月出高城，苍苍照水营。",
        "江中正吹笛，楼上又无更。",
        "洛下仍传箭，关西欲进兵。",
        "谁知五湖外，诸将但争名。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261217,
      "title": "渡浙江",
      "content": [
        "前船后船未相及，五两头平北风急。",
        "飞沙卷地日色昏，一半征帆浪花湿。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 261218,
      "title": "李端公",
      "content": [
        "故关衰草遍，离别自堪悲。",
        "路出寒云外，人归暮雪时。",
        "少孤为客早，多难识君迟。",
        "掩泪空相向，风尘何处期。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261219,
      "title": "秋晚山中别业",
      "content": [
        "树老野泉清，幽人好独行。",
        "去闲知路静，归晚喜山明。",
        "兰芰通荒井，牛羊出古城。",
        "茂陵秋最冷，谁念一书生。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261220,
      "title": "关口逢徐迈",
      "content": [
        "废寺连荒垒，那知见子真。",
        "关城夜有雪，冰渡晓无人。",
        "酒里唯多病，山中愿作邻。",
        "常闻兄弟乐，谁肯信家贫。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261221,
      "title": "山中咏古木",
      "content": [
        "高木已萧索，夜雨复秋风。",
        "坠叶鸣藂竹，斜根拥断蓬。",
        "半侵山色里，长在水声中。",
        "此地何人到，云门去亦通。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261222,
      "title": "詶李端公野寺病居见寄",
      "content": [
        "野寺钟昏山正阴，乱藤高竹水声深。",
        "田夫就饷还依草，野雉惊飞不过林。",
        "斋沫暂思同静室，清羸已觉助禅心。",
        "寂寞日长谁问疾，料君惟取古方寻。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 261223,
      "title": "送少微上人游蜀",
      "content": [
        "瓶钵绕禅衣，连宵宿翠微。",
        "树开巴水远，山晓蜀星稀。",
        "识遍中朝贵，多谙外学非。",
        "何当一传付，道侣愿知归。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261224,
      "title": "送宁国夏侯丞",
      "content": [
        "楚国青芜上，秋云似白波。",
        "五湖长路少，九派乱山多。",
        "谢守通诗宴，陶公许醉过。",
        "怃然饯离阻，年鬓两蹉跎。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261225,
      "title": "送袁偁",
      "content": [
        "谏猎名空久，多因病与贫。",
        "买书行几市，带雨别何人。",
        "客路山连水，军州日映尘。",
        "凄凉一分手，俱恨老相亲。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261226,
      "title": "赠别李纷",
      "content": [
        "头白乘驴悬布囊，一回言别泪千行。",
        "儿孙满眼无归处，唯到尊前似故乡。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 261227,
      "title": "罪所送苗员外上都",
      "content": [
        "谋身当议罪，宁遣友朋闻。",
        "祸近防难及，愁长事未分。",
        "寂寥惊远语，幽闭望归云。",
        "亲戚如相见，唯应泣向君。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261228,
      "title": "送李校书赴东川幕",
      "content": [
        "泥坂望青城，浮云与栈平。",
        "字形知国号，眉势识山名。",
        "编简尘封阁，戈鋋雪照营。",
        "男儿须聘用，莫信笔堪耕。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261229,
      "title": "至德中赠内兄刘赞",
      "content": [
        "时难访亲戚，相见喜还悲。",
        "好学年空在，从戎事已迟。",
        "听琴泉落处，步履雪深时。",
        "惆怅多边信，青山共有期。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 261230,
      "title": "春日灞亭同苗员外寄皇甫侍御",
      "content": [
        "坐见春云暮，无因报所思。",
        "川平人去远，日暖鴈飞迟。",
        "对酒山长在，看花鬓自衰。",
        "谁堪登灞岸，还作旧乡悲。"
      ],
      "author": {
        "id": 2573,
        "name": "卢纶"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
