{
  "data": [
    {
      "id": 316001,
      "title": "蝶恋花",
      "content": [
        "晴带溪光春自媚。",
        "绕翠萦青，来约东风醉。",
        "云补断山疏复缀。",
        "雨回绿野清还丽。",
        "拄杖不妨舒客意。",
        "临水人家，问有花开未。",
        "江左风流今有几。",
        "逢春不要人憔悴。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316002,
      "title": "蝶恋花",
      "content": [
        "翠幕成阴帘拂地。",
        "池馆无人，四面生凉意。",
        "荷气竹香俱细细。",
        "分明著莫清风袂。",
        "玉枕如冰笙似水。",
        "才亸横钗，早被莺呼起。",
        "今夜月明人未睡。",
        "只消三四分来醉。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316003,
      "title": "蝶恋花",
      "content": [
        "画阁红炉屏四向。",
        "梅拥寒香，次第侵帷帐。",
        "烛影半低花影幌。",
        "修眉正在花枝傍。",
        "𣨼粉偎香羞一饷。",
        "未识春风，已觉春情荡。",
        "醉里不知霜月上。",
        "归来已踏梅花浪。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316004,
      "title": "蝶恋花",
      "content": [
        "楼角吹花烟月堕。",
        "的皪韶研，又向梅心破。",
        "钗上采旛看一个。",
        "赏心已觉春生坐。",
        "莫恨年华风雨过。",
        "人日嬉游，次第连灯火。",
        "翠幄高张金盏大。",
        "已拼醉袖随香亸。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316005,
      "title": "蝶恋花",
      "content": [
        "小院菊残烟雨细。",
        "天气凄凉，恼得人憔悴。",
        "被暖橙香羞早起。",
        "玉钗一任慵云坠。",
        "楼上珠帘钩也未。",
        "数尺遥山，供尽伤高意。",
        "伫立不禁残酒味。",
        "绣罗依旧和香睡。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316006,
      "title": "蝶恋花",
      "content": [
        "小院秋光浓欲滴。",
        "独自钩帘，细数归鸿翼。",
        "鸿断天高无处觅。",
        "矮窗催暝蛩催织。",
        "凉月去人才数尺。",
        "断发萧骚，醉傍西风立。",
        "愁眼望天收不得。",
        "露华衣上三更湿。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316007,
      "title": "蝶恋花",
      "content": [
        "晴日溪山春可数。",
        "水绕池塘，知有人家住。",
        "寻日寻花花不语。",
        "旧时春恨还如许。",
        "苦恨东风无意绪。",
        "只解催花，不解催人去。",
        "日晚荒烟迷古戍。",
        "断魂正在梅花浦。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316008,
      "title": "菩萨蛮",
      "content": [
        "和风暖日西郊路。",
        "游人又踏青山去。",
        "何处碧云衫。",
        "映溪才两三。",
        "疏松分翠黛。",
        "故作羞春态。",
        "回首杏烟消。",
        "月明归渡桥。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316009,
      "title": "菩萨蛮",
      "content": [
        "春回绿野烟光薄。",
        "低花矮柳田家乐。",
        "陇麦又青青。",
        "喧蜂闲趁人。",
        "野翁忘近远。",
        "怪识刘郎面。",
        "断却小桥溪。",
        "怕人溪外知。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316010,
      "title": "菩萨蛮",
      "content": [
        "画桥拍拍春江绿。",
        "行人正在春江曲。",
        "花润接平川。",
        "有人花底眠。",
        "东风元自好。",
        "只怕催花老。",
        "安得万垂杨。",
        "系教春日长。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316011,
      "title": "菩萨蛮",
      "content": [
        "平芜冉冉连云绿。",
        "斜阳衬雨明溪足。",
        "小鸭睡晴沙。",
        "翠烘三两花。",
        "春光闲婉娩。",
        "尽日无人见。",
        "试著小屏山。",
        "图归云际看。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316012,
      "title": "菩萨蛮",
      "content": [
        "山头翠树调莺舌。",
        "山腰野菜飞黄蝶。",
        "来为等闲休。",
        "去成多少愁。",
        "小庭花木改。",
        "犹有啼痕在。",
        "别后不曾看。",
        "怕花和泪残。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316013,
      "title": "菩萨蛮",
      "content": [
        "罗衫乍试寒犹怯。",
        "妒花风雨连三月。",
        "灯冷闭门时。",
        "有愁谁得知。",
        "此情真个苦。",
        "只为当时语。",
        "莫道絮沾泥。",
        "絮飞魂亦飞。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316014,
      "title": "菩萨蛮",
      "content": [
        "夜来花底莺饶舌。",
        "把人心事分明说。",
        "许大好因缘。",
        "只成容易传。",
        "春阑无好计。",
        "唯有归来是。",
        "从此玉台前。",
        "晓妆休太妍。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316015,
      "title": "菩萨蛮",
      "content": [
        "小窗荫绿清无暑。",
        "篆香终日萦兰炷。",
        "冰簟涨寒涛。",
        "清风一枕高。",
        "有日团扇却。",
        "门掩庭花落。",
        "少待月侵床。",
        "教他魂梦凉。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316016,
      "title": "菩萨蛮",
      "content": [
        "暑庭消尽风鸣树。",
        "树鸣风尽消庭暑。",
        "横枕一声莺。",
        "莺声一枕横。",
        "扇纨低粉面。",
        "面粉低纨扇。",
        "凉月淡侵床。",
        "床侵淡月凉。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316017,
      "title": "菩萨蛮",
      "content": [
        "东风有意留人住。",
        "熏风无意催人去。",
        "去住两茫然。",
        "相逢成短缘。",
        "平生花柳笑。",
        "过后关心少。",
        "今日奈情何。",
        "为伊饶恨多。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316018,
      "title": "菩萨蛮",
      "content": [
        "去年恰好双星节。",
        "鹊桥未渡人离别。",
        "不恨障云生。",
        "恨他真个行。",
        "天涯消息近。",
        "不见乘鸾影。",
        "楼外鹧鸪声。",
        "几回和梦惊。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316019,
      "title": "菩萨蛮",
      "content": [
        "浅寒带暝和烟下。",
        "轻阴挟雨随风洒。",
        "翠幕护重帘。",
        "篆香销半奁。",
        "平生风雨夜。",
        "怕近芭蕉下。",
        "今夕定愁多。",
        "萧萧声奈何。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316020,
      "title": "菩萨蛮",
      "content": [
        "客窗曾剪灯花弄。",
        "谁教来去如春梦。",
        "冷落旧梅台。",
        "小桃相次开。",
        "人间春易老。",
        "只有山中好。",
        "闲却槿花篱。",
        "莫教溪外知。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316021,
      "title": "菩萨蛮",
      "content": [
        "晓烟笼日浮山翠。",
        "春风著水回川媚。",
        "远近碧重重。",
        "人家山色中。",
        "野花香自度。",
        "似识幽人处。",
        "安得著三间。",
        "与山终日闲。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316022,
      "title": "菩萨蛮",
      "content": [
        "扶犁野老田东睡。",
        "插花山女田西醉。",
        "醉眼眩东西。",
        "看看桃满溪。",
        "耕桑山下足。",
        "纨绮人间俗。",
        "莫管旧东风。",
        "从教吹软红。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316023,
      "title": "木兰花・玉楼春",
      "content": [
        "疏枝半作窥窗老。",
        "又是一年春意早。",
        "风低小院得香迟，月傍女墙和影好。",
        "去年苦被离情恼。",
        "今日逢花休草草。",
        "后时花紫尽从他，且趁先春拼醉倒。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316024,
      "title": "鹧鸪天",
      "content": [
        "昨夜思量直到明。",
        "拂明心绪更愁人。",
        "风披露叶高低怨，冷雨寒烟各自轻。",
        "休赖酒，莫求神。",
        "为谁教尔许多情。",
        "如今早被思量损，好更当时做弄成。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316025,
      "title": "入塞",
      "content": [
        "好思量。",
        "正秋风、半夜长。",
        "奈银缸一点，耿耿背西窗。",
        "衾又凉。",
        "枕又凉。",
        "露华凄凄月半床。",
        "照得人、真个断肠。",
        "窗前谁浸木犀黄。",
        "花也香。",
        "梦也香。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316026,
      "title": "桃源忆故人",
      "content": [
        "粉霜拂拂凝香砌。",
        "酝酿梅花天气。",
        "月上小窗如水。",
        "冷浸人无寐。",
        "平生可惯闲憔悴。",
        "担负新愁不起。",
        "消遣夜长无计。",
        "只倚熏香睡。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316027,
      "title": "愁倚阑・春光好",
      "content": [
        "春犹浅，柳初芽。",
        "杏初花。",
        "杨柳杏花交影处，有人家。",
        "玉窗明暖烘霞。",
        "小屏上、水远山斜。",
        "昨夜酒多春睡重，莫惊他。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316028,
      "title": "乌夜啼",
      "content": [
        "静院槐风绿涨，小窗梅雨黄垂。",
        "欲看春事留连处，惟有夜寒知。",
        "魂梦长闲消午醉，扫花共坐风凉。",
        "归来窗北有胡床。",
        "兴在羲皇以上。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316029,
      "title": "忆秦娥",
      "content": [
        "青门深。",
        "海棠开尽春阴阴。",
        "春阴阴。",
        "万重云水，一寸归心。",
        "玉楼深锁烟消沈。",
        "知他何日同登临。",
        "同登临。",
        "待收红泪，细说如今。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316030,
      "title": "忆秦娥",
      "content": [
        "情脉脉。",
        "半黄橙子和香擘。",
        "和香擘。",
        "分明记得，袖香熏窄。",
        "别来人远关山隔。",
        "见梅不忍和花摘。",
        "和花摘。",
        "有书无雁，寄谁归得。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316031,
      "title": "忆秦娥",
      "content": [
        "愁无语。",
        "黄昏庭院黄梅雨。",
        "黄梅雨。",
        "新愁一寸，旧愁千缕。",
        "杜鹃叫断空山苦。",
        "相思欲计人何许。",
        "一重云断，一重山阻。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316032,
      "title": "西江月",
      "content": [
        "众绿初围夏荫，老红犹驻春妆。",
        "画帘燕子日偏长。",
        "静看新雏来往。",
        "□□□□□□，□□□□□□。",
        "□□□□□□□。",
        "□□□□□□。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316033,
      "title": "西江月",
      "content": [
        "□□□□□□，□□□□□□。",
        "□□□□□□□。",
        "□□□□□□。",
        "汲井漫随兰炷，心情半怯罗衣。",
        "粉香消尽无人觑，只门外、子规啼。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316034,
      "title": "乌夜啼",
      "content": [
        "墙外雨肥梅子，阶前水绕荷花。",
        "阴阴庭户熏风满，水纹簟、怯菱芽。",
        "春尽难凭燕语，日长惟有蜂卫。",
        "沈香火冷珠帘暮，个人在、碧窗纱。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316035,
      "title": "浣溪沙",
      "content": [
        "天女殷勤著意多。",
        "散花犹记病维摩。",
        "肯来丈室问云何。",
        "腰佩摘来烦玉笋，鬓香分处想秋波。",
        "不知真个有情么。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316036,
      "title": "浣溪沙",
      "content": [
        "遥想当年出凤雏。",
        "王□风有未全疏。",
        "祗今朱绂为谁纡。",
        "芳草池塘春梦后，粉香帘幕晓晴初。",
        "一簪华发要人梳。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316037,
      "title": "浣溪沙",
      "content": [
        "翠葆扶疏傍药阑。",
        "乱红飘洒满书单。",
        "清明时节又看看。",
        "小雨勒成春尾恨，东风偏作夜来寒。",
        "琴心老尽不须弹。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316038,
      "title": "浣溪沙",
      "content": [
        "薄日移影午暑空。",
        "一杯何事便潮红。",
        "扇纨挥尽却疏慵。",
        "早睡青怀冰枕外，夜来消息雨荷中。",
        "不须留烛眩房栊。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316039,
      "title": "浣溪沙",
      "content": [
        "闲倚前荣小扇车。",
        "晚妆无力亸云鸦。",
        "凝情香落一庭花。",
        "笑挽清风归玉枕，懒随缺月傍窗纱。",
        "羞红两脸上娇霞。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316040,
      "title": "鹧鸪天",
      "content": [
        "木落江空又一秋。",
        "天寒几日不登楼。",
        "红绡帐里橙犹在，青琐窗深菊未收。",
        "新画阁，小书舟。",
        "篆烟熏得晚香留。",
        "只因贪伴开炉酒，恼得红儿一夜讴。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316041,
      "title": "鹧鸪天",
      "content": [
        "泪湿芙蓉城上花。",
        "片飞何事苦参差。",
        "锁深不奈莺无语，巢稳争如燕有家。",
        "情未老，鬓先华。",
        "可怜各自淡生涯。",
        "桃花不解知人意，犹自沾泥也学他。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316042,
      "title": "一落索",
      "content": [
        "门外莺寒杨柳。",
        "正减欢疏酒。",
        "春阴早是做人愁，更何况、花飞后。",
        "莫倚东风消瘦。",
        "有酴醿入手。",
        "尽偎香玉醉何妨，任花落、愁依旧。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316043,
      "title": "一落索",
      "content": [
        "小小腰身相称。",
        "更著人心性。",
        "一声歌起绣帘阴，都遏住、行云影。",
        "闻道玉郎家近。",
        "被春风勾引。",
        "从今莫怪一东看，自压尽、人间韵。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316044,
      "title": "破阵子",
      "content": [
        "小小红泥院宇，深深翠色屏帷。",
        "簇定熏炉酥酒软，门外东风寒不知。",
        "恰疑三月时。",
        "钗影半欹绿子，歌声轻度红儿。",
        "醉里不愁更漏断，更要梅花看几枝。",
        "起来霜月低。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316045,
      "title": "一翦梅",
      "content": [
        "斗转参横一夜霜。",
        "玉律声中，又报新阳。",
        "起来无绪赋行藏。",
        "只喜人间，一线添长。",
        "帘幕垂垂月半廊。",
        "节物心情，都付椒觞。",
        "年华渐晚鬓毛苍。",
        "身外功名，休苦思量。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316046,
      "title": "木兰花・玉楼春",
      "content": [
        "别时已有重来愿。",
        "谁料情多天不管。",
        "分明咫尺是青楼，抵死浓云遮得遍。",
        "寄声只倚西飞雁。",
        "雁落书回空是怨。",
        "领愁归去有谁知，水又茫茫山又断。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316047,
      "title": "生查子",
      "content": [
        "兰帷夜色高，绣被春寒拥。",
        "何事玉楼人，屡踏杨花梦。",
        "分明相见陈，不道幽情重。",
        "乞个好因缘，莫待来生种。"
      ],
      "author": {
        "id": 7152,
        "name": "程垓"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316048,
      "title": "满庭芳",
      "content": [
        "色染莺黄，枝横鹤瘦，玉奴蝉蜕花间。",
        "铅华不御，慵态尽欹鬟。",
        "冷淡琐窗烟雾，来清供、莞尔怡颜。",
        "狂蜂蝶，还须敛衽，何得傍高闲。",
        "西山。",
        "招隐处，寒云缭绕，流水回环。",
        "念风前绰约，雪后清孱。",
        "别是仙韵道标，应羞对、舞袖弓弯。",
        "怀真赏，今宵归梦，一饷许跻攀。"
      ],
      "author": {
        "id": 6878,
        "name": "虞俦"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316049,
      "title": "临江仙",
      "content": [
        "万壑千岩秋色里，歌眉醉眼争妍。",
        "一枝娇柳趁么弦。",
        "疑非香案吏，诏到小蓬天。",
        "乐事便成陈迹也，依人小月娟娟。",
        "尊前空唱短因缘。",
        "引船风又起，吹过浙江边。"
      ],
      "author": {
        "id": 6878,
        "name": "虞俦"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316050,
      "title": "阮郎归",
      "content": [
        "茶寮山上一头陀。",
        "新来学者么。",
        "蝤蛑螃蟹与乌螺。",
        "知他放几多。",
        "有一物，是蜂窝。",
        "姓牙名老婆。",
        "虽然无奈得它何。",
        "如何放得它。"
      ],
      "author": {
        "id": 12846,
        "name": "徐似道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316051,
      "title": "浪淘沙",
      "content": [
        "风紧浪淘生。",
        "蛟吼鼍鸣。",
        "家人睡著怕人惊。",
        "只有一翁扪虱坐，依约三更。",
        "雪又打残灯。",
        "欲暗还明。",
        "有谁知我此时情。",
        "独对梅花倾一盏，还又诗成。"
      ],
      "author": {
        "id": 12846,
        "name": "徐似道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316052,
      "title": "瑞鹤仙令・临江仙",
      "content": [
        "西子湖边春正好，输他公子王孙。",
        "落花香趁马蹄温。",
        "暖烟桃叶渡，晴日柳枝门。",
        "中有能诗狂处士，闲将一鹤随轩。",
        "百钱买只下湖船。",
        "就他弦管里，醉过杏花天。"
      ],
      "author": {
        "id": 12846,
        "name": "徐似道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316053,
      "title": "一剪梅・一翦梅",
      "content": [
        "道学从来不则声。",
        "行也东铭。",
        "坐也西铭。",
        "爷娘死后更伶丁。",
        "也不看经。",
        "也不斋僧。",
        "却言渊子太狂生。",
        "行也轻轻。",
        "坐也轻轻。",
        "他年青史总无名。",
        "你也能亨。",
        "我也能亨。"
      ],
      "author": {
        "id": 12846,
        "name": "徐似道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316054,
      "title": "失调名",
      "content": [
        "问竹平安，点花番次。"
      ],
      "author": {
        "id": 12846,
        "name": "徐似道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316055,
      "title": "蓦山溪",
      "content": [
        "青梅骨瘦，已有生春意。",
        "椒萼露微花，便觉香魂旖旎。",
        "惜花公子，可是赋情深，携瘦竹，绕疏篱，终日成孤倚。",
        "赏心乐事，又也何曾废。",
        "烟露湿铅华，误啼妆、三年客里。",
        "江南芳信，政自不愆期，吴山远，越山长，梦寐添憔悴。"
      ],
      "author": {
        "id": 604,
        "name": "徐安国"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316056,
      "title": "鹧鸪天",
      "content": [
        "翠幕围香夜正迟。",
        "红麟生焰烛交辉。",
        "纤腰趁拍轻于柳，娇面添妆韵似梅。",
        "凝远恨，惜芳期。",
        "十年幽梦彩云飞。",
        "多情不管霜髯满，犹欲杯翻似旧时。"
      ],
      "author": {
        "id": 604,
        "name": "徐安国"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316057,
      "title": "满江红",
      "content": [
        "挥手华堂，重整顿、选花场屋。",
        "撩鼻观、飞浮杂沓，异香芬馥。",
        "金缕尚馀闲态度，冰姿早作新妆束。",
        "恨尊前、缺典费思量，无松竹。",
        "蜂蝶恨，何时足。",
        "桃李怨，成粗俗。",
        "为情深、拼了一生愁独。",
        "菊信谩劳频探问，兰心未许相随逐。",
        "想从今、无暇𣃁蔷薇，锄罂粟。"
      ],
      "author": {
        "id": 604,
        "name": "徐安国"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316058,
      "title": "满江红",
      "content": [
        "争献交酬，消受取、真山真水。",
        "供不尽、杯螺浮碧，髻鬟拥翠。",
        "莫便等闲嗟去国，固因特地经仙里。",
        "奉周旋、惟有老先生，门堪倚。",
        "追往驾，烟宵里。",
        "终旧学，今无计。",
        "叹白头犹记，壮年标致。",
        "一乐堂深文益著，风雩亭在词难继。",
        "问有谁、熟识晦庵心，南轩意。"
      ],
      "author": {
        "id": 604,
        "name": "徐安国"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316059,
      "title": "祝英台・祝英台近",
      "content": [
        "异乡中，行色里，随分庆初度。",
        "老子今年，五十又还五。",
        "任他坎止流行，吴头楚尾，本来是、乾坤逆旅。",
        "贵和富。",
        "此事都付浮云，无必也无固。",
        "用即为龙，不用即为鼠。",
        "便教老却英雄，草庐烟舍，也须有、著闲人处。"
      ],
      "author": {
        "id": 2355,
        "name": "黄人杰"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316060,
      "title": "酹江月・念奴娇",
      "content": [
        "年时今日，御双凫曾到、蓬壶方丈。",
        "元是王孙生此夕，红紫娇春成行。",
        "数曲栏干，一双蓂荚，正傍瑶阶长。",
        "风帘斜处，有时新燕来往。",
        "犹记不住称觞，挥毫著语，更与书扁榜。",
        "转首还逢汤饼客，景物依然和畅。",
        "待赋新词，说些消息，教倩飞琼唱。",
        "南班虚席，看随丹诏东上。"
      ],
      "author": {
        "id": 2355,
        "name": "黄人杰"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316061,
      "title": "感皇恩",
      "content": [
        "秋色满西湖，雨添新绿。",
        "一派烟光望中足。",
        "清香十里，画舸去来相逐。",
        "酒酣时听得，渔家曲。",
        "人道似郎，郎还第六。",
        "云水相逢未谙熟。",
        "晚来风静，闲浸几枝红玉。",
        "水神应不禁，江妃浴。"
      ],
      "author": {
        "id": 2355,
        "name": "黄人杰"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316062,
      "title": "念奴娇",
      "content": [
        "西湖胜绝，有栖云楼观，蟠空丘壑。",
        "玉鉴光中天不老，人在蓬壶行乐。",
        "画舫藏春，垂杨系马，幽处笙箫作。",
        "京华狂客，也忘身世飘泊。",
        "行时载酒寻芳，湖湾堤曲，放浪红尘脚。",
        "借景留欢排日醉，不负莺花盟约。",
        "忍缓东风，耐烦迟日，休恁匆匆著。",
        "温存桃李，莫教一顿开却。"
      ],
      "author": {
        "id": 2355,
        "name": "黄人杰"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316063,
      "title": "浣溪沙",
      "content": [
        "的皪江梅共蜡梅。",
        "剪金裁玉一时开。",
        "黄姑相伴雪儿来。",
        "别驾公馀无个事，得将诗酒与栽培。",
        "为春留客小徘徊。"
      ],
      "author": {
        "id": 2355,
        "name": "黄人杰"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316064,
      "title": "生查子",
      "content": [
        "烟雨不多时，肥得梅如许。",
        "早有点儿酸，诮没星儿苦。",
        "飞燕恶禁持，又待衔春去。",
        "容著水精盐，觅个调羹处。"
      ],
      "author": {
        "id": 2355,
        "name": "黄人杰"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316065,
      "title": "柳梢青",
      "content": [
        "恰则年时。",
        "风前雪底，初见南枝。",
        "可㬠匆匆，花才清瘦，子已红肥。",
        "安排酒盏相随。",
        "看金弹、累累四垂。",
        "渴后情怀，鼎中风味，惟有心知。"
      ],
      "author": {
        "id": 2355,
        "name": "黄人杰"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316066,
      "title": "蓦山溪",
      "content": [
        "翠环惊报，叶底梅如弹。",
        "小摘试尝看，齿微酸、生香不断。",
        "烟丸露颗，肥得颊儿红，还欲近，浅黄时，风雨催残半。",
        "何如珍重，剩著冰盘荐。",
        "持酒劝飞仙，似江梅、累累子满。",
        "饶将风味，成就与东君，随鼎鼐，著形盐，早趁调羹便。"
      ],
      "author": {
        "id": 2355,
        "name": "黄人杰"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316067,
      "title": "满江红",
      "content": [
        "小队旌旗，又催送、元戎领客。",
        "政十顷、荷香微度，草烟横碧。",
        "杨柳参差新合翠，水天上下俱齐色。",
        "傍野桥、容与绕重湖，严城侧。",
        "花作阵，舟为宅。",
        "敲羯鼓，鸣羌笛。",
        "渐夜凉风进，酒杯无力。",
        "遥想汉中鸡肋地，未应万里回金勒。",
        "看便随、飞诏下南州，朝京国。"
      ],
      "author": {
        "id": 2355,
        "name": "黄人杰"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316068,
      "title": "点绛唇",
      "content": [
        "纤手工夫，采丝五色交相映。",
        "同心端正。",
        "上有双鸳并。",
        "皓腕轻缠，结就相思病。",
        "凭谁信。",
        "玉肌宽尽。",
        "却系心儿紧。"
      ],
      "author": {
        "id": 2703,
        "name": "蔡戡"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316069,
      "title": "水调歌头",
      "content": [
        "肃霜靡衰草，骤雨洗寒空。",
        "刀弓斗力增劲，万马骤西风。",
        "细看外围合阵，忽变横斜曲直，妙在指麾中。",
        "号令肃诸将，谈笑听元戎。",
        "坐中客，休笑我，已衰翁。",
        "十年重到，今日此会与谁同。",
        "差把龙锺鹤发，来对虎头燕颔，年少总英雄。",
        "飞镞落金碗，酣醉吸长虹。"
      ],
      "author": {
        "id": 2703,
        "name": "蔡戡"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316070,
      "title": "水调歌头",
      "content": [
        "拥节出闽峤，易镇上岷山。",
        "东西崄岨，分陕初不在荣观。",
        "痛念两河未复，独作中流砥柱，屹若障狂澜。",
        "极目神京远，百万虎貔闲。",
        "趁良时，摅豹略，勇声欢。",
        "风飞雷厉，威行逆虏胆生寒。",
        "汉寝周原如旧，一扫腥膻丑类，谈笑定三关。",
        "识取投机会，莫作等闲看。"
      ],
      "author": {
        "id": 2703,
        "name": "蔡戡"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316071,
      "title": "鹧鸪天",
      "content": [
        "庾岭移来傍桂丛。",
        "绕花安敢望凌风。",
        "癯儒合作孤芳伴，四面相看一笑同。",
        "冰照座，玉横空。",
        "雪花零落暗香中。",
        "有人醉倚阑干畔，付与江南老画工。"
      ],
      "author": {
        "id": 5984,
        "name": "何澹"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316072,
      "title": "桃源忆故人",
      "content": [
        "拍堤芳草随人去。",
        "洞口山无重数。",
        "翦朝露成树。",
        "争晚渔翁住。",
        "今人忍听秦人语。",
        "只有花无今古。",
        "欲饮仙家寿醑。",
        "记取桥边路。"
      ],
      "author": {
        "id": 5984,
        "name": "何澹"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316073,
      "title": "满江红",
      "content": [
        "灯夕筵开，人物共、英词三绝。",
        "环坐处、袖中珠玉，郢中春雪。",
        "红烛星繁销夜漏，紫霞香满催歌拍。",
        "算新年、何处不风光，三山别。",
        "云表殿，千层结。",
        "花籍锦，添明月。",
        "更浮屠七塔，万枝争发。",
        "多谢一天驱宿霭，故教三日成佳节。",
        "更何须、海上觅蓬莱，真仙阙。"
      ],
      "author": {
        "id": 5984,
        "name": "何澹"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316074,
      "title": "满江红",
      "content": [
        "乐禁初开，平地耸、海山清绝。",
        "千里内、欢声和气，可融霜雪。",
        "盛事终将椽笔记，新歌翻入梨园拍。",
        "道古来、南国做元宵，今宵别。",
        "灯万碗，花千结。",
        "星斗上，天浮月。",
        "向玉绳低处，笙箫高发。",
        "人物尽夸长乐郡，儿童争庆烧灯节。",
        "疑此身、清梦到华胥，朝金阙。"
      ],
      "author": {
        "id": 5984,
        "name": "何澹"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316075,
      "title": "鹧鸪天",
      "content": [
        "好景良辰造物悭。",
        "一年灯火遽摧残。",
        "雨淋夹道星千点，雪阻游人路九盘。",
        "停社舞，撤宾筵。",
        "谩烧银烛照金莲。",
        "不如我入香山社，一盏青灯说夜禅。"
      ],
      "author": {
        "id": 5984,
        "name": "何澹"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316076,
      "title": "满江红",
      "content": [
        "薄日轻云，天气好、相将祈谷。",
        "民情喜、颂声洋溢，清风斯穆。",
        "饮酒不多元有量，吟诗无数添新轴。",
        "对古人、一笑我真愚，君无俗。",
        "斜川路，经行熟。",
        "黄花在，归心足。",
        "问渊明去后，有谁能属。",
        "神武衣冠惊梦里，江湖渔钓论心曲。",
        "但从今、散发更披襟，谁能束。"
      ],
      "author": {
        "id": 650,
        "name": "陈三聘"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316077,
      "title": "满江红",
      "content": [
        "天岂无情，天若道、有情也老。",
        "功名事、问天因甚，蒙人不了。",
        "好伴云烟耕谷口，休将翰墨传江表。",
        "算鬓边、能得几春风，惊秋早。",
        "陶令尹，张京兆。",
        "怀舒啸，贪荣耀。",
        "尽南柯一梦，漏残钟晓。",
        "滕阁暮霞孤鹜举，庾楼明月乌飞绕。",
        "念老来、于此兴无穷，知音少。"
      ],
      "author": {
        "id": 650,
        "name": "陈三聘"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316078,
      "title": "满江红",
      "content": [
        "绀縠浮空，山拥髻、晚来风急。",
        "吹骤雨、藕花千柄，艳妆新浥。",
        "窥鉴粉光犹有泪，凌波罗袜何曾湿。",
        "讶汉宫、朝罢玉皇归，凝情立。",
        "尊前恨，歌三叠。",
        "身外事，轻飞叶。",
        "怅当年空击，誓江孤楫。",
        "云色远连平野尽，夕阳偏傍疏林入。",
        "看月明、冷浸碧琉璃，君须吸。"
      ],
      "author": {
        "id": 650,
        "name": "陈三聘"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316079,
      "title": "满江红",
      "content": [
        "斜日熔金，三万顷、棹歌齐举。",
        "风不动、采苹双桨，翠鬟相语。",
        "月殿欲浮蟾兔魄，海神不放鱼龙舞。",
        "到今宵、秋气十分清，无今古。",
        "君试唤，扁舟侣。",
        "来伴我，潇湘渚。",
        "共夷犹春浪，笑歌秋浦。",
        "霸越独高身退后，尘缨未濯人谁许。",
        "叹酒杯、不到子陵台，刘伶土。"
      ],
      "author": {
        "id": 650,
        "name": "陈三聘"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316080,
      "title": "千秋岁",
      "content": [
        "当年渔隐，路转桃溪汇。",
        "流水下，青山外。",
        "客行花径曲，月上松门对。",
        "撑艇子，雪中蓑笠亲曾载。",
        "老去谁倾盖。",
        "腰瘦频移带。",
        "人健否，花仍在。",
        "明年春更好，来向花前醉。",
        "青鬓改，恁时难拼千金买。"
      ],
      "author": {
        "id": 650,
        "name": "陈三聘"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316081,
      "title": "浣溪沙",
      "content": [
        "酒力先从脸晕生。",
        "粉妆新丽笑相迎。",
        "晓寒高护彩云轻。",
        "不语似愁春力浅，有情应恨烛花明。",
        "更于何处觅倾城。"
      ],
      "author": {
        "id": 650,
        "name": "陈三聘"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316082,
      "title": "浣溪沙",
      "content": [
        "翠幕遮笼锦一丛。",
        "尊前初见浅深红。",
        "淡云和月影葱茏。",
        "醉态只疑春睡里，啼妆愁听雨声中。",
        "更烧银烛醉东风。"
      ],
      "author": {
        "id": 650,
        "name": "陈三聘"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316083,
      "title": "浣溪沙",
      "content": [
        "不怕春寒更出游。",
        "兰桡飞动却惊鸥。",
        "烟光佳处辄迟留。",
        "屏曲未曾歌醉梦，眉尖空只锁闲愁。",
        "从教丝柳绊行舟。"
      ],
      "author": {
        "id": 650,
        "name": "陈三聘"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316084,
      "title": "浣溪沙",
      "content": [
        "越浦潮来信息通。",
        "吴山不见暮云重。",
        "人生何事各西东。",
        "烟外好花红浅淡，雨馀芳草绿葱茏。",
        "苦无欢意敌春浓。"
      ],
      "author": {
        "id": 650,
        "name": "陈三聘"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316085,
      "title": "浣溪沙",
      "content": [
        "点检尊前花柳丛。",
        "于中偏占牡丹风。",
        "等闲言语惯迎逢。",
        "扇影不摇珠的皪，钗梁斜亸玉玲珑。",
        "梦魂长向楚江东。"
      ],
      "author": {
        "id": 650,
        "name": "陈三聘"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316086,
      "title": "浣溪沙",
      "content": [
        "不跃银鞍与绣鞯。",
        "曲筇芒跷见衰年。",
        "寻幽来立渡头船。",
        "碧涧芹羹珍下箸，红莲香饭乐归田。",
        "不妨尊酒兴悠然。"
      ],
      "author": {
        "id": 650,
        "name": "陈三聘"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316087,
      "title": "浣溪沙",
      "content": [
        "帘押低垂月影疏。",
        "梅枝和雪玉相扶。",
        "儿家春信入来无。",
        "半坠宝钗慵览镜，任偏罗髻却拈书。",
        "琴心谁与问相如。"
      ],
      "author": {
        "id": 650,
        "name": "陈三聘"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316088,
      "title": "朝中措",
      "content": [
        "朝来和气满西山。",
        "拄颊小阑干。",
        "柳色野塘幽兴，梅花纸帐轻寒。",
        "三杯淡酒，玉腴蔬嫩，青缕堆盘。",
        "细写池塘诗梦，玉人翦做春幡。"
      ],
      "author": {
        "id": 650,
        "name": "陈三聘"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316089,
      "title": "朝中措",
      "content": [
        "求田何处是生涯。",
        "双鬓已先华。",
        "随分夏凉冬暖，赏心秋月春花。",
        "吾年如此，愁来问酒，困后呼茶。",
        "结社竹林诗老，卜邻江上渔家。"
      ],
      "author": {
        "id": 650,
        "name": "陈三聘"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316090,
      "title": "朝中措",
      "content": [
        "去年曾醉杏花坊。",
        "柳色间轻黄。",
        "重觅旧时行迹，春风满路梅香。",
        "平沙岸草，夫差故国，知是吾乡。",
        "梦断数声柔橹，只应已过横塘。"
      ],
      "author": {
        "id": 650,
        "name": "陈三聘"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316091,
      "title": "朝中措",
      "content": [
        "草堂春过一分馀。",
        "幽事酒醒初。",
        "琴调细鸣焦木，矢声不断铜壶。",
        "关心药裹，忘年蓑笠，自著潜夫。",
        "雨后长镵东麓，月明短艇西湖。"
      ],
      "author": {
        "id": 650,
        "name": "陈三聘"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316092,
      "title": "朝中措",
      "content": [
        "秋山横截半湖光。",
        "湖渚橘枝黄。",
        "纨扇罢摇蟾影，练衣已怯风凉。",
        "插红裂蟹，银丝鲙鲫，莫负传觞。",
        "醉里乾坤广大，人间宠辱兼忘。"
      ],
      "author": {
        "id": 650,
        "name": "陈三聘"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316093,
      "title": "蝶恋花",
      "content": [
        "阊阖城西山四面。",
        "鸭绿鳞鳞，轻拍横塘岸。",
        "一阵东风羊角转。",
        "望中已觉孤帆远。",
        "独恨寻芳来较晚。",
        "柘老桑稠，农务村村遍。",
        "山鸟劝酤官酒贱。",
        "炊烟深巷听缫茧。"
      ],
      "author": {
        "id": 650,
        "name": "陈三聘"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316094,
      "title": "南柯子・南歌子",
      "content": [
        "别后惊人远，归心怯橹柔。",
        "晚天凉思冷于秋。",
        "冷浸一溪明月、水弥流。",
        "醉里狂仍在，吟馀趣极幽。",
        "夜深何用数更筹。",
        "别有好风吹酒、不须求。"
      ],
      "author": {
        "id": 650,
        "name": "陈三聘"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316095,
      "title": "南柯子・南歌子",
      "content": [
        "烟树观前浦，风苹听远洲。",
        "等闲来上水边楼。",
        "怅望天涯、何处有归舟。",
        "香断灯花夜，歌停扇影秋。",
        "欲缄尺素说离愁。",
        "不见双鱼、空有大江流。"
      ],
      "author": {
        "id": 650,
        "name": "陈三聘"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316096,
      "title": "南柯子・南歌子",
      "content": [
        "月傍云头吐，风将雨脚吹。",
        "夜深乌鹊向南飞。",
        "应是星娥颦恨、入双眉。",
        "旧怨垂千古，新欢只片时。",
        "一年屈指数佳期。",
        "到得佳期别了、又相思。"
      ],
      "author": {
        "id": 650,
        "name": "陈三聘"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316097,
      "title": "水调歌头",
      "content": [
        "玉鉴十分满，清露一年秋。",
        "漂流踪迹，谁念楚尾与吴头。",
        "此夜刮明尘眼。",
        "望极好张诗胆。",
        "何处有高楼。",
        "浩荡银潢冷，缥缈白云浮。",
        "笑劳生，难坎止，亦乘流。",
        "阑干拍碎，清夜起舞不胜愁。",
        "万里关河依旧。",
        "一寸功名乌有。",
        "清泪滴衣裘。",
        "老去心空在，归梦绕苹洲。"
      ],
      "author": {
        "id": 650,
        "name": "陈三聘"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316098,
      "title": "水调歌头",
      "content": [
        "有客念行役，劲气凛于秋。",
        "男儿未老，衔命如虏亦风流。",
        "决定平戎方略，恢复旧燕封壤，安用割鸿沟。",
        "莫献肃霜马，好衣白狐裘。",
        "我何人，怀壮节，但凝愁。",
        "平生未逢知己，哙伍实堪羞。",
        "金马文章何在，玉鼎勋庸何有，一笑等云浮。",
        "拼断好风月，羯鼓打梁州。"
      ],
      "author": {
        "id": 650,
        "name": "陈三聘"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316099,
      "title": "西江月",
      "content": [
        "诗眼曾逢花面，画图还识春娇。",
        "当年风格太妖饶。",
        "粉腻酥柔更好。",
        "酒晕不温香脸，玉慵犹怯轻绡。",
        "春风别后又秋高。",
        "再见只应人老。"
      ],
      "author": {
        "id": 650,
        "name": "陈三聘"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 316100,
      "title": "西江月",
      "content": [
        "春事已浓多日，游人偏盛今年。",
        "梨花寒食雨馀天。",
        "鸭绿含风浪浅。",
        "翠袖半黏飞粉，罗衣尚怯轻寒。",
        "不辞归路委香钿。",
        "门外东风如箭。"
      ],
      "author": {
        "id": 650,
        "name": "陈三聘"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    }
  ],
