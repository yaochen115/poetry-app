{
  "data": [
    {
      "id": 32573,
      "title": "别曾学士",
      "content": [
        "儿时闻公名，谓在千载前。",
        "稍长诵公文，杂之韩杜编。",
        "夜辄梦见公，皎若月在天。",
        "起坐三叹息，欲见亡繇缘。",
        "忽闻高轩过，欢喜忘食眠。",
        "袖书拜辕下，此意私自怜。",
        "道若九达衢，小智妄凿穿。",
        "所愿瞻德容，顽固或少痊。",
        "公不谓狂疏，屈体与周旋。",
        "骑气动原隰，霜日明山川。",
        "匏系不得从，瞻望抱悁悁。",
        "画石或十日，刻楮有三年。",
        "贱贫未即死，闻道期华颠。",
        "他时得公心，敢不知所传。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 32574,
      "title": "送仲高兄宫学秩满赴行在",
      "content": [
        "兄去游东合，才堪直北扉。",
        "莫忧持槖晚，姑记乞身归。",
        "道义无今古，功名有是非。",
        "临分出苦语，不敢计从违。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 32575,
      "title": "题阎郎中溧水东皋园亭",
      "content": [
        "省中地禁清昼长，侍史深注熏笼香。",
        "荣名挽公公不住，东皋归去栽花忙。",
        "毵毵华发映朱绂，同舍半已排云翔。",
        "正如少陵入严幕，本自不用尚书郎。",
        "向令封侯佩金印，不然草诏直玉堂。",
        "万锺会作梦幻过，三径空叹松菊荒。",
        "乐天十年履道宅，赞皇一夕平泉庄。",
        "公看富贵定何物，一笑乃复坐此妨。",
        "东皋乐哉日成趣，簪花起舞当自强。",
        "知公能容贱子狂，请赋式微之二章。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 32576,
      "title": "和陈鲁山十诗以孟夏草木长遶屋树扶疏为韵  其一",
      "content": [
        "言语日益工，风节顾弗竞。",
        "杞柳为桮棬，此岂真物性。",
        "病夫背俗驰，梁甫时一咏。",
        "奈何七尺躯，贵贱视赵孟。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 32577,
      "title": "和陈鲁山十诗以孟夏草木长遶屋树扶疏为韵  其二",
      "content": [
        "唐虞亦人耳，四海可高谢。",
        "哀哉斗升故，谄妄两凭架。",
        "心明物自宾，能整故能暇。",
        "会当弃人事，面壁度九夏。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 32578,
      "title": "和陈鲁山十诗以孟夏草木长遶屋树扶疏为韵  其三",
      "content": [
        "大父昔在朝，腾上唯恐早。",
        "淡然清班中，灰寒而木槁。",
        "议论主中和，人才进耆老。",
        "至今下马坟，不生刺人草。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 32579,
      "title": "和陈鲁山十诗以孟夏草木长遶屋树扶疏为韵  其四",
      "content": [
        "樱酪事已过，角黍配夏熟。",
        "尚忆少小时，彩缕系腕玉。",
        "此生本幻戏，衰态转眼足。",
        "三郎老无憀，始解叹丝木。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 32580,
      "title": "和陈鲁山十诗以孟夏草木长遶屋树扶疏为韵  其五",
      "content": [
        "门无容车高，庭止旋马广。",
        "富贵固易耳，正恐卿惭长。",
        "时情竞脂韦，家法独肮脏。",
        "静处看纷纷，桔槔劳𫖯仰。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 32581,
      "title": "和陈鲁山十诗以孟夏草木长遶屋树扶疏为韵  其六",
      "content": [
        "至人贵其身，不使事物遶。",
        "捐身易富贵，明珠弹飞鸟。",
        "我愿称善人，题作墓上表。",
        "从来尺鷃乐，不羡飞鸿矫。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 32582,
      "title": "和陈鲁山十诗以孟夏草木长遶屋树扶疏为韵  其七",
      "content": [
        "匆匆过三十，梦境日已蹙。",
        "谁知叹亡羊，但有喜得鹿。",
        "本来作何面，认此逆旅屋。",
        "逢人吹布毛，出世不忍独。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 32583,
      "title": "和陈鲁山十诗以孟夏草木长遶屋树扶疏为韵  其八",
      "content": [
        "杜门殊省事，百巧输一粗。",
        "烧香净扫地，袖手了朝暮。",
        "君看瓦抠手，端自胜金注。",
        "尘机早见贷，不待鸡竿树。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 32584,
      "title": "和陈鲁山十诗以孟夏草木长遶屋树扶疏为韵  其九",
      "content": [
        "万物备于我，本来无欠余。",
        "𪧘儒可怜生，西抺复东涂。",
        "斯文如大厦，倾坏要力扶。",
        "犬子真鼠辈，辛苦卖子虚。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 32585,
      "title": "和陈鲁山十诗以孟夏草木长遶屋树扶疏为韵  其一○",
      "content": [
        "风花怜寂寞，起舞为我娱。",
        "举酒谢风花，吾道殊不疏。",
        "汝开何自有，汝落何自无。",
        "居然会此理，吾汝皆如如。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 32586,
      "title": "看梅绝句五首  其一",
      "content": [
        "梅花宜寒更宜阴，摩挲拄杖过溪寻。",
        "幽香著人索管领，不信如今鐡石心。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 32587,
      "title": "看梅绝句五首  其二",
      "content": [
        "梅花树下黄茆丘，古人尚能爱花不。",
        "月淡烟深听牧笛，死生常事不须愁。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 32588,
      "title": "看梅绝句五首  其三",
      "content": [
        "荒陂十畆浴凫鸭，折苇枯蒲寒意深。",
        "何处得船满载酒，醉时系著古梅林。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 32589,
      "title": "看梅绝句五首  其四",
      "content": [
        "一物不向胸次横，醉中谈谑坐中倾。",
        "梅花有情应记得，可惜如今白发生。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 32590,
      "title": "看梅绝句五首  其五",
      "content": [
        "老子舞时不须拍，梅花乱插乌巾香。",
        "尊前作剧莫相笑，我死诸君思此狂。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 32591,
      "title": "春晚简陈鲁山",
      "content": [
        "春工我辈人，可许不待面。",
        "欲老更增奇，原野红绿遍。",
        "向来苦摧伤，零雨杂飞霰。",
        "岂知袖此手，天定乃徐见。",
        "吾斋万花间，轻衫称团扇。",
        "飞花点书册，戏蝶游几研。",
        "吾衰未忘情，小句亦倩绚。",
        "持问陈元龙，试乞语一转。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 32592,
      "title": "寄酬曾学士学宛陵先生体比得书云所寓广教僧舍有陆子泉每对之辄奉怀",
      "content": [
        "庭中下干鹊，门外传远书。",
        "小印红屈蟠，两端黄蜡涂。",
        "开缄展矮纸，滑细疑卵肤。",
        "首言劳良苦，后问逮妻孥。",
        "中间勉以仕，语意极勤渠。",
        "字如老瘠竹，墨淡行疏疏。",
        "诗如古鼎篆，可爱不可摹。",
        "快读醒人意，垢痒逢爬梳。",
        "细读味益长，炙毂出膏腴。",
        "行吟坐卧看，废食至日晡。",
        "想见落笔时，万象听指呼。",
        "亦知题诗处，绿井石发粗。",
        "公闲计有客，煎茶置风炉。",
        "倘公无客时，濯缨亦足娱。",
        "井名本季疵，思人理岂无。",
        "居然及贱子，愧谢恩意殊。",
        "几时得从公，旧学锄荒芜。",
        "古文讲声形，误字辨鲁鱼。",
        "时时酌井泉，露芽奉瓢盂。",
        "不知公许否，因风报何如。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 32593,
      "title": "夜读兵书",
      "content": [
        "孤灯耿霜夕，穷山读兵书。",
        "平生万里心，执戈王前驱。",
        "战死士所有，耻复守妻孥。",
        "成功亦邂逅，逆料政自疏。",
        "陂泽号饥鸿，岁月欺贫儒。",
        "叹息镜中面，安得长肤腴。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 32594,
      "title": "二月二十四日作",
      "content": [
        "棠梨花开社酒浓，南村北村鼓冬冬。",
        "且祈麦熟得饱飰，敢说谷贱复伤农。",
        "崖州万里窜酷吏，湖南几时起卧龙。",
        "但愿诸贤集廊庙，书生穷死胜侯封。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32595,
      "title": "送曾学士赴行在",
      "content": [
        "二月侍燕觞，红杏寒未坼。",
        "四月送入都，杏子已可摘。",
        "流年不贷人，俯仰遂成昔。",
        "事贤要及时，感此我心恻。",
        "欲书加餐字，寄之西飞翮。",
        "念公为民起，我得怨乖隔。",
        "揺揺跂前旌，去去望车轭。",
        "亭鄣郁将暮，落日澹陂泽。",
        "敢忘国士风，涕泣效臧获。",
        "敬输千一虑，或取二三策。",
        "公归对延英，清问方侧席。",
        "民瘼公所知，愿言写肝膈。",
        "向来酷吏横，至今有遗螫。",
        "织罗士破胆，白著民碎魄。",
        "诏书已屡下，宿蠧或未革。",
        "期公作医和，汤剂穷络脉。",
        "士生恨不用，得位忍辞责。",
        "并乞谢诸贤，努力光竹帛。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 32596,
      "title": "霁夜观月",
      "content": [
        "云重真愁无散时，可怜不奈一风吹。",
        "清辉如此那休得，谁悮虚空作许痴。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 32597,
      "title": "新夏感事",
      "content": [
        "百花过尽绿阴成，漠漠炉香睡晚晴。",
        "病起兼旬疏把酒，山深四月始闻莺。",
        "近传下诏通言路，已卜余年见太平。",
        "圣主不忘初政美，小儒唯有涕纵横。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32598,
      "title": "留题云门草堂",
      "content": [
        "小住初为旬月期，二年留滞未应非。",
        "寻碑野寺云生屦，送客溪桥雪满衣。",
        "亲涤砚池余墨渍，卧看炉面散烟霏。",
        "他年游宦应无此，早买渔蓑未老归。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32599,
      "title": "送韩梓秀才十八韵",
      "content": [
        "束发走塲屋，始得从君游。",
        "灯火都城夜，风雨湖上秋。",
        "追随不隔日，岩壑穷探搜。",
        "摩挲石屋背，揺兀暗门舟。",
        "酒酣耳颊热，意气盖九州。",
        "夜卧相蹋语，狂笑杂嘲讴。",
        "但恐富贵逼，肯怀贫贱忧。",
        "人事信难料，百战竟不侯。",
        "我老农圃间，君落天南陬。",
        "相逢会稽市，感叹岁月遒。",
        "君从上都来，倘逢旧朋俦。",
        "我穷本天命，于人寜有求。",
        "但念侯君房，不知尚痴不。",
        "君闻拊手笑，怪我狂未瘳。",
        "共谈平生旧，只欲苦死留。",
        "如何忽决去，病疟送无由。",
        "秋风坠桐叶，新霜犯貂裘。",
        "君听马蹄声，中有千里愁。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 32600,
      "title": "送陈德邵宫教赴行在二十韵",
      "content": [
        "相从何必早，白头或如新。",
        "登门虽尚疏，数面自成亲。",
        "昨者始见公，凛然须如银。",
        "败席留煮茗，寒厅无杂宾。",
        "平生事贤意，寸心渴生尘。",
        "乐哉得所从，贫病忘吟呻。",
        "恭惟大雅姿，信是邦国珍。",
        "广文旧官长，二纪转鸿钧。",
        "恩仇快报复，祸福出笑颦。",
        "同舍事容悦，腰佩玉麒麟。",
        "群谀更得志，后来如积薪。",
        "于时公淡如，位屈道则伸。",
        "法宫亲决事，收召极海滨。",
        "人才方杂沓，公仕益逡巡。",
        "欲以贵祝公，公岂慕要津。",
        "欲以穷托公，公岂私贱贫。",
        "颇欲述古谊，劝公勿爱身。",
        "此又公所存，岂待贱子陈。",
        "高颿泊江渚，岁晚风雨频。",
        "愿言添衣裘，寒阴能薄人。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 32601,
      "title": "朱子云园中观花",
      "content": [
        "我鬓忽已白，君颜非复朱。",
        "花前一杯酒，不乐复何如。",
        "暮看枝上花，已觉不如早。",
        "富贵当及时，吾辈奈何老。",
        "我歌君起舞，竟日为君留。",
        "安知花无情，不解替人愁。",
        "长安二三月，花满上林中。",
        "祝君早得意，归辔听璁珑。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 32602,
      "title": "酬妙湛阇梨见赠妙湛能棋其师璘公盖尝与先君游云",
      "content": [
        "昔侍先君故里时，僧中最喜老璘师。",
        "高标无复乡人识，妙寄惟应弟子知。",
        "山店煎茶留小语，寺桥看雨待幽期。",
        "可人不但诗超绝，玉子纹枰又一奇。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32603,
      "title": "次韵鲁山新居绝句二首  其一",
      "content": [
        "求得轩车心愧天，不如穷死却陶然。",
        "君曾布衣尚可活，那有日兴须万钱。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 32604,
      "title": "次韵鲁山新居绝句二首  其二",
      "content": [
        "短墙缺处插疏篱，巷劣容车堂对陂。",
        "天下有公殊可贺，坐中著我不妨奇。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 32605,
      "title": "寄陈鲁山二首  其一",
      "content": [
        "诸公贵人识面稀，胸中璀璨漫珠玑。",
        "即今举手遮西日，应有流尘化素衣。",
        "旧学极知难少贬，吾侪持此欲安归。",
        "夜来风雨空堂静，忽忆灯前语入微。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32606,
      "title": "寄陈鲁山二首  其二",
      "content": [
        "天下无虞国论深，书生端合老山林。",
        "平生力学所得处，政要如今不动心。",
        "旧友几年犹短褐，谪官万里少来音。",
        "愿公思此宽羁旅，静胜炎曦岂易侵。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32607,
      "title": "戏题江心寺僧房壁",
      "content": [
        "史君千骑驻霜天，主簿孤舟冷不眠。",
        "也与史君同快意，卧听鼓角大江边。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 32608,
      "title": "泛瑞安江风涛贴然",
      "content": [
        "俯仰两青空，舟行明镜中。",
        "蓬莱定不远，正要一颿风。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 11,
        "name": "五言绝句"
      }
    },
    {
      "id": 32609,
      "title": "平阳驿舍梅花",
      "content": [
        "江路轻阴未成雨，梅花欲过半沾泥。",
        "远来不负东皇意，一绝清诗手自题。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 32610,
      "title": "度浮桥至南台",
      "content": [
        "客中多病废登临，闻说南台试一寻。",
        "九轨徐行怒涛上，千艘横系大江心。",
        "寺楼钟鼓催昏晓，墟落云烟自古今。",
        "白发未除豪气在，醉吹横笛坐榕阴。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32611,
      "title": "出县",
      "content": [
        "匆匆簿领不堪论，出宿聊宽久客魂。",
        "稻垄牛行泥活活，野塘桥坏雨昏昏。",
        "槿篱护药才通径，竹笕分泉自遍村。",
        "归计未成留亦好，愁肠不用遶吴门。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32612,
      "title": "还县",
      "content": [
        "霁色清和日已长，纶巾萧散意差强。",
        "飞飞鸥鹭陂塘绿，郁郁桑麻风露香。",
        "南陌东村初过社，轻装小队似还乡。",
        "哦诗忘却登车去，枉是人言作吏忙。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32613,
      "title": "雨晴游洞宫山天庆观坐间复雨",
      "content": [
        "近水松篁锁翠微，洞天宫殿对清晖。",
        "快晴似为酴醿计，急雨还妨燕子飞。",
        "道士昼闲丹灶冷，山童晓出药苗肥。",
        "拂床不用勤留客，我困文书自怕归。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32614,
      "title": "寄陈鲁山正字",
      "content": [
        "平生交游中，陈子我所敬。",
        "初犹似豪举，晚乃抱渊静。",
        "独观心地初，皎若虚室镜。",
        "人知自渠事，道行君有命。",
        "青衫二十年，老色上须鬓。",
        "偶然预收召，瘦马趁朝请。",
        "退食辄杜门，不省求捷径。",
        "似闻石渠书，雌黄久未定。",
        "丁字犹恨曲，朋字竟须正。",
        "愿君试思之，鱼鲁何足订。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 32615,
      "title": "航海",
      "content": [
        "我不如列子，神游御天风。",
        "尚应似安石，悠然云海中。",
        "卧看十幅蒲，弯弯若张弓。",
        "潮来涌银山，忽复磨青铜。",
        "饥鹘掠船舷，大鱼舞虚空。",
        "流落何足道，豪气荡肺胸。",
        "歌罢海动色，诗成天改容。",
        "行矣跨鹏背，弭节蓬莱宫。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 32616,
      "title": "海中醉题时雷雨初霁天水相接也",
      "content": [
        "羁游那复恨，奇观有南溟。",
        "浪蹴半空白，天浮无尽青。",
        "吐吞交日月，澒洞战雷霆。",
        "醉后吹横笛，鱼龙亦出听。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 32617,
      "title": "溪行二首  其一",
      "content": [
        "蓬蒻鸣春雨，帆蒲挂暮烟。",
        "买鱼寻近市，觅火就邻船。",
        "愁卧醒还醉，滩行却复前。",
        "长年殊可念，力尽逆风牵。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 32618,
      "title": "溪行二首  其二",
      "content": [
        "冒雨牵何急，争风力不余。",
        "逢人问虚市，计日买薪蔬。",
        "烟寺高旛出，山畬一老锄。",
        "枕书醒醉里，短发不曾梳。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 32619,
      "title": "自来福州诗酒殆废北归始稍稍复饮至永嘉括苍无日不醉诗亦屡作此事不可不记也",
      "content": [
        "尊酒如江绿，春愁抵草长。",
        "但令闲一日，便拟醉千场。",
        "柳弱风禁絮，花残雨渍香。",
        "客游还役役，心赏竟茫茫。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 32620,
      "title": "东阳道中",
      "content": [
        "风欹乌帽送轻寒，雨点春衫作碎斑。",
        "小吏知人当著句，先安笔砚对溪山。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 32621,
      "title": "东阳观酴醿",
      "content": [
        "福州正月把离杯，已见酴醿压架开。",
        "吴地春寒花渐晚，北归一路摘香来。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 32622,
      "title": "送李德远寺丞奉祠归临川",
      "content": [
        "送骑拥东城，烟帆如鸟轻。",
        "道行端有命，身隐更须名。",
        "旰食烦明主，尘沙暗旧京。",
        "临分一襟泪，不独为交情。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 32623,
      "title": "送王嘉叟编修出佐南昌",
      "content": [
        "玉殿求衣早，鸾台退食迟。",
        "君看多故日，寜是弃言时。",
        "小作南州计，方观急诏追。",
        "归来上霄汉，莫遣此心移。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 32624,
      "title": "送王龟龄著作赴会稽大宗丞二首  其一",
      "content": [
        "有越逾千载，何人不宦游。",
        "向来惟一范，真足壮吾州。",
        "高躅今谁继，先生独再留。",
        "登堂吊兴废，想像气横秋。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 32625,
      "title": "送王龟龄著作赴会稽大宗丞二首  其二",
      "content": [
        "大将上兵符，军容备扫除。",
        "恭惟陛下圣，方采直臣书。",
        "忽报分司去，还寻入幕初。",
        "宗藩虽旧识，莫遣得亲疏。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 32626,
      "title": "送杜起莘殿院出守遂寜",
      "content": [
        "羽檄聨翩昼夜驰，臣忧顾不在边陲。",
        "军容地密寜当议，陛下恩深不忍欺。",
        "白简万言几恸哭，青编一传可前知。",
        "平生所学今无负，未叹还乡两鬓丝。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32627,
      "title": "和曾待制游两山三首 题育王山明月堂",
      "content": [
        "翰林碑立崔嵬上，待制诗题杳霭间。",
        "人天八万四千塔，便合推为第一山。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 32628,
      "title": "和曾待制游两山三首 题天章山宿鹭亭",
      "content": [
        "疏钟迎客到溪亭，碧瓦朱栏相照明。",
        "想得松阴排万衲，篮舆放处恰诗成。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 32629,
      "title": "和曾待制游两山三首 题天章山更幽亭且以未到玲珑为恨",
      "content": [
        "攀石扪萝到更幽，玲珑咫尺懒穷搜。",
        "旁人不会当时意，为欠门生作伴游。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 32630,
      "title": "雨中出游夜归",
      "content": [
        "小雨南山路，今朝思出游。",
        "难从子规请，寜遣竹鸡忧。",
        "野店寒饶柿，烟津晚唤舟。",
        "归来对灯火，未恨湿衣裘。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 32631,
      "title": "谢李平叔郎中问疾",
      "content": [
        "吏部朝回早，幽人病始苏。",
        "过门迂问讯，欹枕听传呼。",
        "缘瘦重裁帽，因衰学染须。",
        "投诗发公笑，试想此形模。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 32632,
      "title": "闻武均州报已复西京",
      "content": [
        "白发将军亦壮哉，西京昨夜捷书来。",
        "胡儿敢作千年计，天意寜知一日回。",
        "列圣仁恩深雨露，中兴赦令疾风雷。",
        "悬知寒食朝陵使，驿路梨花处处开。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32633,
      "title": "喜小儿辈到行在",
      "content": [
        "阿纲学书蚓满幅，阿绘学语莺啭木。",
        "截竹作马走不休，小车驾羊声陆续。",
        "书窗涴壁谁忍嗔，啼呼也复可怜人。",
        "却思胡马饮江水，敢道春风无战尘。",
        "传闻贼弃两京走，列城争为朝廷守。",
        "从今父子见太平，花前饮水勿饮酒。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 32634,
      "title": "病起寄曾原伯兄弟",
      "content": [
        "意象殊非昨，筋骸劣自持。",
        "衰如霜后木，愁抵盎中丝。",
        "风雪书来少，江山梦到迟。",
        "出门还惘惘，倚杖独移时。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 32635,
      "title": "送汤岐公镇会稽",
      "content": [
        "吴越东西州，浙江限其中。",
        "黄旗高十丈，大舟凌虚空。",
        "都人送留守，郡吏迎相公。",
        "江心波涛壮，帐下鼓角雄。",
        "乐哉公何憾，廷论则未同。",
        "永怀前年秋，群胡方啸凶。",
        "闾左发蓟北，戈船满山东。",
        "旧盟顾未解，谁敢婴其锋。",
        "公时立殿上，措置极雍容。",
        "南荒窜骄将，京口起元戎。",
        "旧勲与宿贵，屏气听指踪。",
        "规模一朝定，强虏终归穷。",
        "当时谓易耳，未见回天功。",
        "及今始大服，咨嗟到儿童。",
        "天心佑社稷，主圣肖祖宗。",
        "旌节早来朝，笑谈折遐冲。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 32636,
      "title": "周洪道学士许折赠馆中海棠以诗督之",
      "content": [
        "袅袅柔丝不自持，更禁日炙与风吹。",
        "仙家见惯浑闲事，乞与人间看一枝。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 32637,
      "title": "送七兄赴杨州帅幕",
      "content": [
        "初报边烽照石头，旋闻胡马集瓜州。",
        "诸公谁听刍荛策，吾辈空怀畎畆忧。",
        "急雪打窗心共碎，危楼望远涕俱流。",
        "岂知今日淮南路，乱絮飞花送客舟。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32638,
      "title": "闰二月二十日游西湖",
      "content": [
        "西湖二月游人稠，鲜车快马巷无留。",
        "梨园乐工教坊优，丝竹悲激杂清讴。",
        "追逐下上暮始休，外虽狂酲乐则不。",
        "岂知吾曹淡相求，酒肴取具非预谋。",
        "青梅苦笋助献酬，意象简朴足镇浮。",
        "尚惭一官自拘囚，未免疋马从两驺。",
        "南山老翁亦出游，百钱自挂竹杖头。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 32639,
      "title": "刘太尉挽歌辞二首  其一",
      "content": [
        "羌胡忘复育，师旅备非常。",
        "南服更旄节，中军铸印章。",
        "驰书谕燕赵，开府冠侯王。",
        "赫赫今何在，门庭冷似霜。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 32640,
      "title": "刘太尉挽歌辞二首  其二",
      "content": [
        "坚壁临江日，人疑制敌疏。",
        "安知百万虏，锐尽浃旬余。",
        "智出常情表，功如定计初。",
        "云何媢公者，不置箧中书。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 17,
        "name": "乐府诗"
      }
    },
    {
      "id": 32641,
      "title": "过林黄中食柑子有感学宛陵先生体",
      "content": [
        "博士得黄柑，甚爱不忍擘。",
        "持献太夫人，远附海上舶。",
        "故山饶氛雾，可使酒杯窄。",
        "岂无荔枝好，餍饫恐不摘。",
        "相去三千里，无异娱旁侧。",
        "乃知母子意，更远未尝隔。",
        "我昨往见君，从容弄书册。",
        "药分腊剂香，茶泛春芽白。",
        "主意顾未厌，筐筥自搜索。",
        "敢谓甘旨余，亦及此下客。",
        "霜包才三四，气可压千百。",
        "重是慈孝物，不敢吐其核。",
        "甘寒虽遶齿，悲感已横臆。",
        "半生无欢娱，初不为湮阨。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 32642,
      "title": "玉牒所迎驾望见周洪道舍人",
      "content": [
        "自卜河桥宅，清谈喜屡陪。",
        "今年见腾踔，不恨老氛埃。",
        "晓放宫门钥，霜雕辇路槐。",
        "班回独小立，为待绣鞍来。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 32643,
      "title": "送梁谏议",
      "content": [
        "湖海还朝白发生，懒随年少事声名。",
        "极知忧国人谁及，细看无心语自平。",
        "归访乡人忘位重，乍辞言责觉身轻。",
        "篮舆避暑云门寺，应过幽居听水声。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32644,
      "title": "以石芥送刘韶美礼部刘比酿酒劲甚因以为戏二首  其一",
      "content": [
        "古人重改阳城驿，吾辈欣闻石芥名。",
        "风味可人终骨骾，尊前真见鲁诸生。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 32645,
      "title": "以石芥送刘韶美礼部刘比酿酒劲甚因以为戏二首  其二",
      "content": [
        "长安官酒甜如蜜，风月虽佳懒举觞。",
        "持送盘蔬还会否，与公新酿鬭端方。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 32646,
      "title": "出都",
      "content": [
        "重入修门甫岁余，又携琴剑返江湖。",
        "乾坤浩浩何由报，犬马区区正自愚。",
        "缘熟且为莲社客，伻来喜对草堂图。",
        "西厢屋了吾真足，高枕看云一事无。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32647,
      "title": "曾原伯屡劝居城中而仆方欲自梅山入云门今日病酒偶得长句奉寄",
      "content": [
        "借得僧房似钓船，兼旬散发醉江天。",
        "酒能作病真如此，穷乃工诗却未然。",
        "闲似白鸥虽自许，健如黄犊已无缘。",
        "秋高更欲移家去，先葺云门屋数椽。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32648,
      "title": "村居",
      "content": [
        "富贵功名不拟论，且浮舴艋寄烟村。",
        "生憎快马随鞭影，寜作痴人记剑痕。",
        "樵牧相谙欲争席，比邻渐熟约论婚。",
        "晨舂夜绩吾家旧，正要遗风付子孙。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32649,
      "title": "看山",
      "content": [
        "小葺茆茨紫翠间，今年偷得半年闲。",
        "门前木落须霜晓，且看西南一角山。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 32650,
      "title": "夏夜泛舟书所见",
      "content": [
        "山房犹复畏炎蒸，长掩柴门愧老僧。",
        "两桨去揺东浦月，一龛回望上方灯。",
        "惊飞宿鸟时呼侣，腾起长鱼有脱罾。",
        "夜半归来步松影，真成赤脚踏层冰。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32651,
      "title": "秋阴",
      "content": [
        "陂泽秋容淡，郊原晓气清。",
        "雨来鸠有语，社近燕无情。",
        "拄杖扶腰痛，渔舟照眼明。",
        "苦吟缘病辍，随意或诗成。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 32652,
      "title": "盆池",
      "content": [
        "门外江涛涌雪堆，埋盆作沼亦何哉。",
        "儿曹不解渠翁意，新脱风波崄处来。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 32653,
      "title": "比从人觅酒皆酸薄戏作此诗",
      "content": [
        "酒尽聊凭折简求，不知人要博凉州。",
        "墙隅弃置空三叹，露下萤飞奈此秋。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 32654,
      "title": "买鱼二首  其一",
      "content": [
        "卧沙细肋何由得，出水纤鳞却易求。",
        "一夏与僧同粥饭，朝来破戒醉新秋。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 32655,
      "title": "买鱼二首  其二",
      "content": [
        "两京春荠论斤卖，江上鲈鱼不直钱。",
        "斫脍捣齑香满屋，雨窗唤起醉中眠。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 32656,
      "title": "秋雨",
      "content": [
        "漫道秋来雨，那无一日晴。",
        "只供高枕卧，不放小窗明。",
        "书册频开阖，山瓢任浊清。",
        "长年谙世味，不是故逃名。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 32657,
      "title": "晨起偶题",
      "content": [
        "城远不闻长短更，上方钟鼓自分明。",
        "幽居不负秋来睡，末路偏谙世上情。",
        "大事岂堪重破坏，穷人难与共功名。",
        "风炉歙钵生涯在，且试新寒芋糁羮。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32658,
      "title": "悲秋",
      "content": [
        "烟草凄迷八月秋，荒村络纬戒衣裘。",
        "道人大欠修行力，平地闲生尔许愁。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 32659,
      "title": "寄张真父舍人二首  其一",
      "content": [
        "诸公方衮衮，无地著斯人。",
        "万里夔州守，中朝禁省臣。",
        "孤帆秋上峡，五马晓班春。",
        "想见怀明主，登临白发新。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 32660,
      "title": "寄张真父舍人二首  其二",
      "content": [
        "天上紫微省，莺花绕直庐。",
        "逢时身鼎贵，忧国鬓先疏。",
        "憔悴元当弃，牵聨也得书。",
        "犹能下榻否，拟卜瀼西居。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 32661,
      "title": "幽居",
      "content": [
        "翳翳桑麻巷，幽幽水竹居。",
        "纫缝一獠婢，樵汲两蛮奴。",
        "雨挟清砧急，篱悬野蔓枯。",
        "邻村有鬻子，吾敢叹空无。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 32662,
      "title": "法宝琏师求竹轩诗",
      "content": [
        "南轩竹色映谿光，不减吾州五月凉。",
        "犹恨秋来鸥鹭少，须君更为筑横塘。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 32663,
      "title": "欲游五峰不果往小诗寄莹老",
      "content": [
        "东来恨不见汤休，千首清诗傥许求。",
        "要与茶山灯下读，莫令侍者作蝇头。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 12,
        "name": "七言绝句"
      }
    },
    {
      "id": 32664,
      "title": "谢王彦光提刑见访并送茶",
      "content": [
        "迩英帷幄旧儒臣，肯顾荒山野水滨。",
        "不怕客嘲轻薄尹，要令我识老成人。",
        "颿回鼓转东城暮，酒冽橙香一笑新。",
        "遥想解酲须底物，隆兴第一壑源春。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32665,
      "title": "送查元章赴夔漕",
      "content": [
        "柳色西门路，看公上马时。",
        "亦知非久别，不奈自成悲。",
        "白发刘宾客，青衫杜拾遗。",
        "分留端有待，剩赋竹枝词。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 32666,
      "title": "逍遥",
      "content": [
        "台省诸公日造朝，放慵别驾愧逍遥。",
        "州如斗大真无事，日抵年长未易消。",
        "午坐焚香常寂寂，晨兴署字亦寥寥。",
        "时平更喜戈船静，闲看城边帯雨潮。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32667,
      "title": "病中简仲弥性唐克明苏训直",
      "content": [
        "移疾还家暂曲肱，依然耐久北窗灯。",
        "心如泽国春归雁，身是云堂旦过僧。",
        "细雨佩壶寻废寺，夕阳下马吊荒陵。",
        "小留莫厌时追逐，胜社年来冷欲冰。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32668,
      "title": "送王景文",
      "content": [
        "张公遂如此，海内共悲辛。",
        "逆胡犹遗种，皇天夺老臣。",
        "深知万言策，不愧九原人。",
        "风雨津亭暮，辞君泪满君。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    },
    {
      "id": 32669,
      "title": "送吕彦升参谋",
      "content": [
        "楚塞萧条久宿师，参谋承诏上丹墀。",
        "苦言到口真当发，圣度如天莫自疑。",
        "万里寄声长不达，一尊相属岂前期。",
        "遥怜霜晓朝衣冷，深愧江城睡足时。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32670,
      "title": "无咎兄郡斋燕集有诗末章见及敬次元韵",
      "content": [
        "城楼画角吹晚晴，梅花堕地草欲生。",
        "绮盘翠杓春满眼，我胡不乐君将行。",
        "君归吾党共增气，往往怪我衰涕横。",
        "我来江干旧交少，见君不啻河之清。",
        "北风共爱地炉暖，西日同赏油窗明。",
        "微吟剧醉不知倦，坐阅汉腊逾周正。",
        "君文雄丽擅一世，凛凛武库藏五兵。",
        "酸寒如我每自笑，顾辱刻画为虚声。",
        "乃知好士如好色，遇合不必皆倾城。",
        "君方与世作水镜，如此过许人将惊。",
        "千金敝帚有定价，周玉郑鼠难强名。",
        "失言议罚不可缓，敬白府主浮金觥。",
        "君看失脚落尘土，岂复毫发余诗情。",
        "自伤但似路旁堠，雨剥风摧供送迎。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 32671,
      "title": "次韵无咎别后见寄",
      "content": [
        "平日杯行不解辞，长亭况是送君时。",
        "几行零落僧窗字，何限流传乐府诗。",
        "归思恰如重酝酒，欢情略似欲残棋。",
        "龙蛇飞动无由见，坐愧文园属思迟。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 32672,
      "title": "晚泊慈姥矶下二首  其一",
      "content": [
        "山断峭崖立，江空翠霭生。",
        "漫多来往客，不尽古今情。",
        "月碎知流急，风高觉笛清。",
        "儿曹笑老子，不睡待潮平。"
      ],
      "author": {
        "id": 7513,
        "name": "陆游"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 13,
        "name": "五言律诗"
      }
    }
