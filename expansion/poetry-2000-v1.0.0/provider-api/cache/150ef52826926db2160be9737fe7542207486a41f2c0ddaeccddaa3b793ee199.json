        "name": "宋词"
      }
    },
    {
      "id": 313578,
      "title": "菩萨蛮",
      "content": [
        "单于吹落山头月。",
        "漫漫江上沙如雪。",
        "谁唱缕金衣。",
        "水寒船舫稀。",
        "芦花枫叶浦。",
        "忆抱琵琶语。",
        "身未发长沙。",
        "梦魂先到家。"
      ],
      "author": {
        "id": 8647,
        "name": "王观"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
