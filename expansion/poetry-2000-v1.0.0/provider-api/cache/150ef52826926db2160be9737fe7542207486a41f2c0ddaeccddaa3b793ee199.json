{
  "data": [
    {
      "id": 142323,
      "title": "别山和尚赞",
      "content": [
        "严冷面皮，软顽肠肚。",
        "对同参唱菩萨蛮，与行家说无义语。",
        "纵苍鹰搏物机，辟狮子翻身路。",
        "医衲僧病下天王补心圆，移覩史宫换长庚大火聚。",
        "虽潜行密用处鹘眼迷踪，点捡将来也是果州饭布。"
      ],
      "author": {
        "id": 8174,
        "name": "释绍昙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 142656,
      "title": "偈颂一百一十七首  其九三",
      "content": [
        "四十年同参，廿余年相别。",
        "不唱菩萨蛮，何暇说佛法。",
        "蓦劄相逢十二峰，我患生盲你患聋。",
        "是圣是凡都莫问，且分苔石憩松风。"
      ],
      "author": {
        "id": 8174,
        "name": "释绍昙"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 164567,
      "title": "题苏东坡书楚颂并菩萨蛮满庭芳词卷后",
      "content": [
        "南荒九死幸生还，种树书成手自删。",
        "赤壁梦难同楚颂，洞庭乐不减商山。",
        "人生堕地少如意，老子对天无愧颜。",
        "千古菟裘有遗恨，断珪残璧自人间。"
      ],
      "author": {
        "id": 9208,
        "name": "白珽"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 14,
        "name": "七言律诗"
      }
    },
    {
      "id": 298295,
      "title": "菩萨蛮 一",
      "content": [
        "登楼遥望秦宫殿，茫茫只见双飞燕。",
        "渭水一条流，千山与万丘。",
        "远烟笼碧树，陌上行人去。",
        "安得有英雄，迎归大内中。"
      ],
      "author": {
        "id": 5820,
        "name": "昭宗皇帝"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298296,
      "title": "菩萨蛮 二",
      "content": [
        "飘飘且在三峰下，秋风往往堪霑洒。",
        "肠断忆仙宫，朦胧烟雾中。",
        "思梦时时睡，不语长如醉。",
        "早晚是归期，苍穹知不知。"
      ],
      "author": {
        "id": 5820,
        "name": "昭宗皇帝"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298320,
      "title": "菩萨蛮 一",
      "content": [
        "花明月暗笼轻雾，今宵好向郎边去。",
        "刬韤步香阶，手提金缕鞋。",
        "画堂南畔见，一晌偎人颤。",
        "好为出来难，教君恣意怜。"
      ],
      "author": {
        "id": 11675,
        "name": "后主煜"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298321,
      "title": "菩萨蛮 二",
      "content": [
        "蓬莱院闭天台女，画堂昼寝无人语。",
        "抛枕翠云光，绣衣闻异香。",
        "潜来珠锁动，惊觉鸳鸯梦。",
        "慢脸笑盈盈，相看无限情。"
      ],
      "author": {
        "id": 11675,
        "name": "后主煜"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298322,
      "title": "菩萨蛮 三",
      "content": [
        "铜簧韵脆锵寒竹，新声慢奏移纤玉。",
        "眼色暗相钩，秋波横欲流。",
        "雨云深绣户，来便谐衷素。",
        "宴罢又成空，梦迷春睡中。"
      ],
      "author": {
        "id": 11675,
        "name": "后主煜"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298323,
      "title": "菩萨蛮 四",
      "content": [
        "人生愁恨何能免，消魂独我情何限。",
        "故国梦重归，觉来双泪垂。",
        "高楼谁与上，长记秋晴望。",
        "往事已成空，还如一梦中。"
      ],
      "author": {
        "id": 11675,
        "name": "后主煜"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298360,
      "title": "菩萨蛮",
      "content": [
        "平林漠漠烟如织，寒山一带伤心碧。",
        "暝色入高楼，有人楼上愁。",
        "玉阶空伫立，宿鸟归飞急。",
        "何处是归程，长亭更短亭。"
      ],
      "author": {
        "id": 2045,
        "name": "李白"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298449,
      "title": "菩萨蛮 一",
      "content": [
        "小山重叠金明灭，鬓云欲度香顋雪。",
        "嬾起画蛾眉，弄妆梳洗迟。",
        "照花前后镜，花面交相映。",
        "新帖绣罗襦，双双金鹧鸪。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298450,
      "title": "菩萨蛮 二",
      "content": [
        "水精帘里颇黎枕，暖香惹梦鸳鸯锦。",
        "江上柳如烟，鴈飞残月天。",
        "藕丝秋色浅，人胜参差翦。",
        "双鬓隔香红，玉钗头上风。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298451,
      "title": "菩萨蛮 三",
      "content": [
        "蘂黄无限当山额，宿妆隐笑纱窗隔。",
        "相见牡丹时，暂来还别离。",
        "翠钗金作股，钗上蝶双舞。",
        "心事竟谁知，月明花满枝。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298452,
      "title": "菩萨蛮 四",
      "content": [
        "翠翘金缕双㶉𫛶，水文细起春池碧。",
        "池上海棠梨，雨晴红满枝。",
        "绣衫遮笑靥，烟草黏飞蝶。",
        "青琐对芳菲，玉关音信稀。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298453,
      "title": "菩萨蛮 五",
      "content": [
        "杏花含露团香雪，绿杨陌上多离别。",
        "灯在月胧明，觉来闻晓鸎。",
        "玉钩褰翠幕，妆浅旧眉薄。",
        "春梦正关情，镜中蝉鬓轻。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298454,
      "title": "菩萨蛮 六",
      "content": [
        "玉楼明月长相忆，柳丝袅娜春无力。",
        "门外草萋萋，送君闻马嘶。",
        "画罗金翡翠，香烛销成泪。",
        "花落子规啼，绿窗残梦迷。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298455,
      "title": "菩萨蛮 七",
      "content": [
        "凤凰相对盘金缕，牡丹一夜经微雨。",
        "明镜照新妆，鬓轻双脸长。",
        "画楼相望久，阑外垂丝柳。",
        "音信不归来，社前双燕回。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298456,
      "title": "菩萨蛮 八",
      "content": [
        "牡丹花谢鸎声歇，绿杨满院中庭月。",
        "相忆梦难成，背窗灯半明。",
        "翠钿金压脸，寂寞香闺掩。",
        "人远泪阑干，燕飞春又残。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298457,
      "title": "菩萨蛮 九",
      "content": [
        "满宫明月梨花白，故人万里关山隔。",
        "金鴈一双飞，泪痕霑绣衣。",
        "小园芳草绿，家住越溪曲。",
        "杨柳色依依，燕归君不归。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298458,
      "title": "菩萨蛮 十",
      "content": [
        "宝函钿雀金㶉𫛶，沈香阁上吴山碧。",
        "杨柳又如丝，驿桥春雨时。",
        "画楼音信断，芳草江南岸。",
        "鸾镜与花枝，此情谁得知。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298459,
      "title": "菩萨蛮 十一",
      "content": [
        "南园满地堆轻絮，愁闻一霎清明雨。",
        "雨后却斜阳，杏花零落香。",
        "无言匀睡脸，枕上屏山掩。",
        "时节欲黄昏，无憀独倚门。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298460,
      "title": "菩萨蛮 十二",
      "content": [
        "夜来皓月才当午，重帘悄悄无人语。",
        "深处麝烟长，卧时留薄妆。",
        "当年还自惜，往事那堪忆。",
        "花露月明残，锦衾知晓寒。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298461,
      "title": "菩萨蛮 十三",
      "content": [
        "雨晴夜合玲珑日，万枝香袅红丝拂。",
        "闲梦忆金堂，满庭萱草长。",
        "绣帘垂{罒/录}𦌉，眉黛远山绿。",
        "春水渡溪桥，凭阑魂欲消。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298462,
      "title": "菩萨蛮 十四",
      "content": [
        "竹风轻动庭除冷，珠帘月上玲珑影。",
        "山枕隐浓妆，绿檀金凤凰。",
        "两蛾愁黛浅，故国吴宫远。",
        "春恨正关情，画楼残点声。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298463,
      "title": "菩萨蛮 十五",
      "content": [
        "玉纤弹处真珠落，流多暗湿铅华薄。",
        "春露浥朝花，秋波浸晚霞。",
        "风流心上物，本为风流出。",
        "看取薄情人，罗衣无此痕。"
      ],
      "author": {
        "id": 288,
        "name": "温庭筠"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298530,
      "title": "菩萨蛮 一",
      "content": [
        "红楼别夜堪惆怅，香灯半卷流苏帐。",
        "残月出门时，美人和泪辞。",
        "琵琶金翠羽，弦上黄莺语。",
        "劝我早归家，绿窗人似花。"
      ],
      "author": {
        "id": 6755,
        "name": "韦庄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298531,
      "title": "菩萨蛮 二",
      "content": [
        "人人尽说江南好，游人只合江南老。",
        "春水碧于天，画船听雨眠。",
        "垆边人似月，皓腕凝双雪。",
        "未老莫还乡，还乡须断肠。"
      ],
      "author": {
        "id": 6755,
        "name": "韦庄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298532,
      "title": "菩萨蛮 三",
      "content": [
        "如今却忆江南乐，当时年少春衫薄。",
        "骑马倚斜桥，满楼红袖招。",
        "翠屏金屈曲，醉入花丛宿。",
        "此度见花枝，白头誓不归。"
      ],
      "author": {
        "id": 6755,
        "name": "韦庄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298533,
      "title": "菩萨蛮 四",
      "content": [
        "劝君今夜须沈醉，尊前莫话明朝事。",
        "珍重主人心，酒深情亦深。",
        "须愁春漏短，莫诉金杯满。",
        "遇酒且呵呵，人生能几何。"
      ],
      "author": {
        "id": 6755,
        "name": "韦庄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298534,
      "title": "菩萨蛮 五",
      "content": [
        "洛阳城里春光好，洛阳才子他乡老。",
        "柳暗魏王堤，此时心转迷。",
        "桃花春水渌，水上鸳鸯浴。",
        "凝恨对残晖，忆君君不知。"
      ],
      "author": {
        "id": 6755,
        "name": "韦庄"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298570,
      "title": "菩萨蛮 一",
      "content": [
        "舞帬香暖金泥凤，画梁语燕惊残梦。",
        "门外柳花飞，玉郎犹未归。",
        "愁匀红粉泪，眉翦春山翠。",
        "何处是辽阳，锦屏春昼长。"
      ],
      "author": {
        "id": 12058,
        "name": "牛峤"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298571,
      "title": "菩萨蛮 二",
      "content": [
        "柳花飞处莺声急，晴街春色香车立。",
        "金凤小帘开，脸波和恨来。",
        "今宵求梦想，难到青楼上。",
        "赢得一场愁，鸳衾谁竝头。"
      ],
      "author": {
        "id": 12058,
        "name": "牛峤"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298572,
      "title": "菩萨蛮 三",
      "content": [
        "玉钗风动春幡急，交枝红杏笼烟泣。",
        "楼上望卿卿，窗寒新雨晴。",
        "熏炉蒙翠被，绣帐鸳鸯睡。",
        "何处有相知，羡他初画眉。"
      ],
      "author": {
        "id": 12058,
        "name": "牛峤"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298573,
      "title": "菩萨蛮 四",
      "content": [
        "画屏重叠巫阳翠，楚神尚有行云意。",
        "朝暮几般心，向他情谩深。",
        "风流今古隔，虚作瞿塘客。",
        "山月照山花，梦回灯影斜。"
      ],
      "author": {
        "id": 12058,
        "name": "牛峤"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298574,
      "title": "菩萨蛮 五",
      "content": [
        "风帘燕舞莺啼柳，妆台约鬓低纤手。",
        "钗重髻盘珊，一枝红牡丹。",
        "门前行乐客，白马嘶春色。",
        "故故坠金鞭，回头应眼穿。"
      ],
      "author": {
        "id": 12058,
        "name": "牛峤"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298575,
      "title": "菩萨蛮 六",
      "content": [
        "绿云鬓上飞金雀，愁眉歛翠春烟薄。",
        "香阁掩芙蓉，画屏山几重。",
        "窗寒天欲曙，犹结同心苣。",
        "啼粉涴罗衣，问郎何日归。"
      ],
      "author": {
        "id": 12058,
        "name": "牛峤"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298576,
      "title": "菩萨蛮 七",
      "content": [
        "玉炉冰簟鸳鸯锦，粉融香汗流山枕。",
        "帘外辘轳声，歛眉含笑惊。",
        "柳阴烟漠漠，低鬓蝉钗落。",
        "须作一生拌，尽君今日欢。"
      ],
      "author": {
        "id": 12058,
        "name": "牛峤"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298632,
      "title": "菩萨蛮",
      "content": [
        "越梅半拆轻寒里，冰清澹薄笼蓝水。",
        "暖觉杏梢红，游丝狂惹风。",
        "闲阶莎径碧，远梦犹堪惜。",
        "离恨又迎春，相思难重陈。"
      ],
      "author": {
        "id": 7016,
        "name": "和凝"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298741,
      "title": "菩萨蛮 一",
      "content": [
        "罗裾薄薄秋波染，眉间画得山两点。",
        "相见绮筵时，深情暗共知。",
        "翠翘云鬓动，歛态弹金凤。",
        "宴罢入兰房，邀人解佩珰。"
      ],
      "author": {
        "id": 12827,
        "name": "魏承班"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298742,
      "title": "菩萨蛮 二",
      "content": [
        "罗衣隐约金泥画，玳筵一曲当秋夜。",
        "声颤觑人娇，[云]鬟袅翠翘。",
        "酒醺红玉輭，眉翠秋山远。",
        "绣幌麝烟沈，谁人知两心。"
      ],
      "author": {
        "id": 12827,
        "name": "魏承班"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298743,
      "title": "菩萨蛮 三",
      "content": [
        "玉容光照菱花影，沈沈脸上秋波冷。",
        "白雪一声新，雕梁起暗尘。",
        "宝钗摇翡翠，香惹芙蓉醉。",
        "携手入鸳衾，谁人知此心。"
      ],
      "author": {
        "id": 12827,
        "name": "魏承班"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298758,
      "title": "菩萨蛮 一",
      "content": [
        "陇云暗合秋天白，俯窗独坐窥烟陌。",
        "楼际角重吹，黄昏方醉归。",
        "荒唐难共语，明日还应去。",
        "上马出门时，金鞭莫与伊。"
      ],
      "author": {
        "id": 3776,
        "name": "尹鹗"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298759,
      "title": "菩萨蛮 二",
      "content": [
        "呜呜晓角调如语，画楼三会喧雷鼓。",
        "枕上梦方残，月光铺水寒。",
        "蛾眉应歛翠，咫尺同千里。",
        "宿酒未全消，满怀离恨饶。"
      ],
      "author": {
        "id": 3776,
        "name": "尹鹗"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298760,
      "title": "菩萨蛮 三",
      "content": [
        "锦茵闲衬丁香枕，银釭烬落犹慵寝。",
        "颙坐遍红炉，谁知情绪孤。",
        "少年狂荡惯，花曲长牵绊。",
        "去便不归来，空教骏马回。"
      ],
      "author": {
        "id": 3776,
        "name": "尹鹗"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298788,
      "title": "菩萨蛮 一",
      "content": [
        "梨花满院飘香雪，高楼夜静风筝咽。",
        "斜月照帘帷，忆君和梦稀。",
        "小窗灯影背，燕语惊愁态。",
        "屏掩断香飞，行云山外归。"
      ],
      "author": {
        "id": 13554,
        "name": "毛熙震"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298789,
      "title": "菩萨蛮 二",
      "content": [
        "绣帘高轴临塘看，雨翻荷芰真珠散。",
        "残暑晚初凉，轻风渡水香。",
        "无憀悲往事，争那牵情思。",
        "光影暗相催，等闲秋又来。"
      ],
      "author": {
        "id": 13554,
        "name": "毛熙震"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298790,
      "title": "菩萨蛮 三",
      "content": [
        "天含残碧融春色，五陵薄幸无消息。",
        "尽日掩朱门，离愁暗断魂。",
        "莺啼芳树暖，燕拂回塘满。",
        "寂寞对屏山，相思醉梦间。"
      ],
      "author": {
        "id": 13554,
        "name": "毛熙震"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298835,
      "title": "菩萨蛮 一",
      "content": [
        "回塘风起波文细，刺桐花里门斜闭。",
        "残日照平芜，双双飞鹧鸪。",
        "征帆何处客，相见还相隔。",
        "不语欲魂销，望中烟水遥。"
      ],
      "author": {
        "id": 12052,
        "name": "李珣"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298836,
      "title": "菩萨蛮 二",
      "content": [
        "等闲将度三春景，帘垂碧砌参差影。",
        "曲槛日初斜，杜鹃啼落花。",
        "恨君容易处，又话潇湘去。",
        "凝思倚屏山，泪流红脸斑。"
      ],
      "author": {
        "id": 12052,
        "name": "李珣"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298837,
      "title": "菩萨蛮 三",
      "content": [
        "隔帘微雨双飞燕，砌花零落红深浅。",
        "捻得宝筝调，心随征櫂遥。",
        "楚天云外路，动便经年去。",
        "香断画屏深，旧欢何处寻。"
      ],
      "author": {
        "id": 12052,
        "name": "李珣"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298881,
      "title": "菩萨蛮 一",
      "content": [
        "晓来中酒和春睡，四支无力云鬟坠。",
        "斜卧脸波春，玉郎休恼人。",
        "日高犹未起，为恋鸳鸯被。",
        "鹦鹉语金笼，道儿还是慵。"
      ],
      "author": {
        "id": 7856,
        "name": "欧阳炯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298882,
      "title": "菩萨蛮 二",
      "content": [
        "红炉煖阁佳人睡，隔帘飞雪添寒气。",
        "小院奏笙歌，香风簇绮罗。",
        "酒倾金醆满，兰烛重开宴。",
        "公子醉如泥，天街闻马嘶。"
      ],
      "author": {
        "id": 7856,
        "name": "欧阳炯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298883,
      "title": "菩萨蛮 三",
      "content": [
        "翠眉双脸新妆薄，幽闺斜卷青罗幕。",
        "寒食百花时，红繁香满枝。",
        "双双梁燕语，蝶舞相随去。",
        "肠断正思君，闲眠冷绣茵。"
      ],
      "author": {
        "id": 7856,
        "name": "欧阳炯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 298884,
      "title": "菩萨蛮 四",
      "content": [
        "画屏绣阁三秋雨，香唇腻脸偎人语。",
        "语罢欲天明，娇多梦不成。",
        "晓街钟鼓绝，嗔道如今别。",
        "特地气长吁，倚屏弹泪珠。"
      ],
      "author": {
        "id": 7856,
        "name": "欧阳炯"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 299053,
      "title": "菩萨蛮 一",
      "content": [
        "金波远逐行云去，疎星时作银河渡。",
        "花影卧秋千，更长人不眠。",
        "玉筝弹未彻，凤髻黄钗脱。",
        "忆梦翠蛾低，微风吹绣衣。"
      ],
      "author": {
        "id": 8353,
        "name": "冯延巳"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 299054,
      "title": "菩萨蛮 二",
      "content": [
        "画堂昨夜西风过，绣帘时拂朱门锁。",
        "惊梦不成云，双蛾枕上颦。",
        "金炉烟袅袅，烛暗纱窗晓。",
        "残日尚弯环，玉筝和泪弹。"
      ],
      "author": {
        "id": 8353,
        "name": "冯延巳"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 299055,
      "title": "菩萨蛮 三",
      "content": [
        "梅花吹入谁家笛，行云半夜凝空碧。",
        "欹枕不成眠，关山人未还。",
        "声随幽怨绝，空断澄霜月。",
        "月影下重簷，轻风花满帘。"
      ],
      "author": {
        "id": 8353,
        "name": "冯延巳"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 299056,
      "title": "菩萨蛮 四",
      "content": [
        "回廊远砌生秋草，梦魂千里青门道。",
        "鹦鹉怨长更，碧笼金锁横。",
        "罗帏中夜起，霜月清如水。",
        "玉露不成圆，宝筝悲断弦。"
      ],
      "author": {
        "id": 8353,
        "name": "冯延巳"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 299057,
      "title": "菩萨蛮 五",
      "content": [
        "娇鬟堆枕钗横凤，溶溶春水杨花梦。",
        "红烛泪阑干，翠屏烟浪寒。",
        "锦壶催画箭，玉佩天涯远。",
        "和泪试严妆，落梅飞夜霜。"
      ],
      "author": {
        "id": 8353,
        "name": "冯延巳"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 299058,
      "title": "菩萨蛮 六",
      "content": [
        "西风袅袅凌歌扇，秋期正与行云远。",
        "花叶脱霜红，流萤残月中。",
        "兰闺人在否，千里重楼暮。",
        "翠被已销香，梦随寒漏长。"
      ],
      "author": {
        "id": 8353,
        "name": "冯延巳"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 299059,
      "title": "菩萨蛮 七",
      "content": [
        "沈沈朱户横金锁，纱窗月影随花过。",
        "烛泪欲阑干，落梅生晚寒。",
        "宝钗横翠凤，千里香屏梦。",
        "云雨已荒凉，江南春草长。"
      ],
      "author": {
        "id": 8353,
        "name": "冯延巳"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 299060,
      "title": "菩萨蛮 八",
      "content": [
        "欹鬟堕髻摇双桨，采莲晚出清江上。",
        "顾影约流萍，楚歌娇未成。",
        "相逢颦翠黛，笑把珠珰解。",
        "家住柳阴中，画桥东复东。"
      ],
      "author": {
        "id": 8353,
        "name": "冯延巳"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 299107,
      "title": "菩萨蛮",
      "content": [
        "画堂春昼垂珠箔，卧来揉惹金钗落。",
        "簟滑枕头移，鬓蝉狂欲飞。",
        "笑拖娇眼慢，罗袖笼花面。",
        "重道好郎君，人前莫恼人。"
      ],
      "author": {
        "id": 11165,
        "name": "林楚翘"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 299111,
      "title": "菩萨蛮",
      "content": [
        "牡丹含露真珠颗，美人折向庭前过。",
        "含笑问檀郎，花强妾貌强。",
        "檀郎故相恼，须道花枝好。",
        "一面发娇嗔，碎挼花打人。"
      ],
      "author": {
        "id": 5773,
        "name": "无名氏"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 299122,
      "title": "菩萨蛮",
      "content": [
        "玉京人去秋萧索，画簷鹊起梧桐落。",
        "欹枕悄无言，月和残梦圆。",
        "背灯唯暗泣甚处砧声急眉黛远山攒芭蕉生暮寒。"
      ],
      "author": {
        "id": 7509,
        "name": "耿玉真"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 301508,
      "title": "菩萨蛮",
      "content": [
        "举头忽见衡阳雁，千声万字情何限。",
        "叵耐薄情夫，一行书也无。",
        "泣归香阁恨，和泪淹红粉。",
        "待雁却回时，也无书寄伊。",
        "（《尊前集》）（《全宋词》第四册第二五一月页云《历代诗余》卷九载此为陈以庄词，杨金本《草堂诗余》卷下作陈达叟词。"
      ],
      "author": {
        "id": 2045,
        "name": "李白"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 301825,
      "title": "子夜歌（《全唐诗》八九九词句只存首二句，题作《菩萨蛮》）",
      "content": [
        "寻春须是先春早，看花莫待花枝老。",
        "缥色玉柔擎，醅浮盏面清。",
        "何妨频笑粲，禁苑春归晚。",
        "同醉与闲平（一作「评」），诗随羯鼓成。",
        "（南词本注。",
        "参《历代诗余》）（〖1〗《历代诗余》卷九收此词，调属《菩萨蛮》，「羯鼓」作「叠鼓」。"
      ],
      "author": {
        "id": 6029,
        "name": "李煜"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 306746,
      "title": "菩萨蛮",
      "content": [
        "家家尽有长生药，时人取用皆差错。",
        "气候若飞沈，问君何处寻？",
        "眼看犹不识，误向铅中觅。",
        "此物没黄芽，徒劳岁月赊。",
        "（以上二首均见《金液还丹百问诀》。"
      ],
      "author": {
        "id": 62,
        "name": "陶埴"
      },
      "dynasty": {
        "id": 6,
        "name": "唐"
      },
      "type": {
        "id": 99,
        "name": "其他"
      }
    },
    {
      "id": 312462,
      "title": "菩萨蛮",
      "content": [
        "忆郎还上层楼曲。",
        "楼前芳草年年绿。",
        "绿似去时袍。",
        "回头风袖飘。",
        "郎袍应已旧。",
        "颜色非长久。",
        "惜恐镜中春。",
        "不如花草新。"
      ],
      "author": {
        "id": 5040,
        "name": "张先"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312463,
      "title": "菩萨蛮",
      "content": [
        "闻人语著仙卿字。",
        "瞋情恨意还须喜。",
        "何况草长时。",
        "酒前频共伊。",
        "娇香堆宝帐。",
        "月到梨花上。",
        "心事两人知。",
        "掩灯罗幕垂。"
      ],
      "author": {
        "id": 5040,
        "name": "张先"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312464,
      "title": "菩萨蛮",
      "content": [
        "夜深不至春蟾见。",
        "令人更更情飞乱。",
        "翠幕动风亭。",
        "时疑响屉声。",
        "花香闻水榭。",
        "几误飘衣麝。",
        "不忍下朱扉。",
        "绕廊重待伊。"
      ],
      "author": {
        "id": 5040,
        "name": "张先"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312465,
      "title": "菩萨蛮",
      "content": [
        "簟纹衫色娇黄浅。",
        "钗头秋叶玲珑翦。",
        "轻怯瘦腰身。",
        "纱窗病起人。",
        "相思魂欲绝。",
        "莫话新秋别。",
        "何处断离肠。",
        "西风昨夜凉。"
      ],
      "author": {
        "id": 5040,
        "name": "张先"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312535,
      "title": "菩萨蛮",
      "content": [
        "玉人又是匆匆去。",
        "马蹄何处垂杨路。",
        "残日倚楼时。",
        "断魂郎未知。",
        "阑干移倚遍。",
        "薄幸教人怨。",
        "明月却多情。",
        "随人处处行。"
      ],
      "author": {
        "id": 5040,
        "name": "张先"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312575,
      "title": "菩萨蛮",
      "content": [
        "佳人学得平阳曲。",
        "纤纤玉笋横孤竹。",
        "一弄入云声。",
        "海门江月清。",
        "髻摇金钿落。",
        "惜恐樱唇薄。",
        "听罢已依依。",
        "莫吹杨柳枝。"
      ],
      "author": {
        "id": 5040,
        "name": "张先"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312576,
      "title": "菩萨蛮",
      "content": [
        "藕丝衫翦猩红窄。",
        "衫轻不碍琼肤白。",
        "缦鬓小横波。",
        "花楼东是家。",
        "上湖闲荡桨。",
        "粉艳芙蓉样。",
        "湖水亦多情。",
        "照妆天底清。"
      ],
      "author": {
        "id": 5040,
        "name": "张先"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312577,
      "title": "菩萨蛮",
      "content": [
        "牛星织女年年别。",
        "分明不及人间物。",
        "匹鸟少孤飞。",
        "断沙犹并栖。",
        "洗车昏雨过。",
        "缺月云中堕。",
        "斜汉晓依依。",
        "暗蛩还促机。"
      ],
      "author": {
        "id": 5040,
        "name": "张先"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312578,
      "title": "菩萨蛮",
      "content": [
        "双针竞引双丝缕。",
        "家家尽道迎牛女。",
        "不见渡河时。",
        "空闻乌鹊飞。",
        "西南低片月。",
        "应恐云梳发。",
        "寄语问星津。",
        "谁为得巧人。"
      ],
      "author": {
        "id": 5040,
        "name": "张先"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312736,
      "title": "菩萨蛮",
      "content": [
        "芳莲九蕊开新艳。",
        "轻红淡白匀双脸。",
        "一朵近华堂。",
        "学人宫样妆。",
        "看时斟美酒。",
        "共祝千年寿。",
        "销得曲中夸。",
        "世间无此花。"
      ],
      "author": {
        "id": 6242,
        "name": "晏殊"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312737,
      "title": "菩萨蛮",
      "content": [
        "秋花最是黄葵好。",
        "天然嫩态迎秋早。",
        "染得道家衣。",
        "淡妆梳洗时。",
        "晓来清露滴。",
        "一一金杯侧。",
        "插向绿云鬓。",
        "便随王母仙。"
      ],
      "author": {
        "id": 6242,
        "name": "晏殊"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312738,
      "title": "菩萨蛮",
      "content": [
        "人人尽道黄葵淡。",
        "侬家解说黄葵艳。",
        "可喜万般宜。",
        "不劳朱粉施。",
        "摘承金盏酒。",
        "劝我千长寿。",
        "擎作女真冠。",
        "试伊娇面看。"
      ],
      "author": {
        "id": 6242,
        "name": "晏殊"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312739,
      "title": "菩萨蛮",
      "content": [
        "高梧叶下秋光晚。",
        "珍丛化出黄金盏。",
        "还似去年时。",
        "傍阑三两枝。",
        "人情须耐久。",
        "花面长依旧。",
        "莫学蜜蜂儿。",
        "等闲悠扬飞。"
      ],
      "author": {
        "id": 6242,
        "name": "晏殊"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 312775,
      "title": "菩萨蛮",
      "content": [
        "娟娟侵鬓妆痕浅。",
        "双眸相媚弯如翦。",
        "一瞬百般宜。",
        "无论笑与啼。",
        "酒阑思翠被。",
        "特故瞢腾地。",
        "生怕促归轮。",
        "微波先注人。"
      ],
      "author": {
        "id": 3376,
        "name": "谢绛"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313079,
      "title": "菩萨蛮",
      "content": [
        "游丝欲堕还重上。",
        "春残日永人相望。",
        "花共燕争飞。",
        "青梅细雨枝。",
        "离愁终未解。",
        "忘了依前在。",
        "拟待不寻思。",
        "刚眠梦见伊。"
      ],
      "author": {
        "id": 11741,
        "name": "杜安世"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313080,
      "title": "菩萨蛮",
      "content": [
        "锦机织了相思字。",
        "天涯路远无由寄。",
        "寒雁只衔芦。",
        "何曾解寄书。",
        "缄封和血泪。",
        "目断西江水。",
        "拟欲托双鱼。",
        "问君情有无。"
      ],
      "author": {
        "id": 11741,
        "name": "杜安世"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313197,
      "title": "菩萨蛮",
      "content": [
        "子规啼破城楼月。",
        "画船晓载笙歌发。",
        "两岸荔枝红。",
        "万家烟雨中。",
        "佳人相对泣。",
        "泪下罗衣湿。",
        "从此信音稀。",
        "岭南无雁飞。"
      ],
      "author": {
        "id": 10559,
        "name": "李师中"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313231,
      "title": "菩萨蛮",
      "content": [
        "数家茅屋闲临水。",
        "单衫短帽垂杨里。",
        "今日是何朝。",
        "看予度石桥。",
        "梢梢新月偃。",
        "午醉醒来晚。",
        "何物最关情。",
        "黄鹂三两声。"
      ],
      "author": {
        "id": 9366,
        "name": "王安石"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313254,
      "title": "菩萨蛮",
      "content": [
        "海棠乱发皆临水。",
        "君知此处花何似。",
        "凉月白纷纷。",
        "香风隔岸闻。",
        "啭枝黄鸟近。",
        "隔岸声相应。",
        "随意坐莓苔。",
        "飘零酒一杯。"
      ],
      "author": {
        "id": 9366,
        "name": "王安石"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313289,
      "title": "菩萨蛮",
      "content": [
        "楼头上有三冬鼓。",
        "何须抵死催人去。",
        "上马苦匆匆。",
        "琵琶曲未终。",
        "回头肠断处。",
        "却更廉纤雨。",
        "漫道玉为堂。",
        "玉堂今夜长。"
      ],
      "author": {
        "id": 12973,
        "name": "孙洙"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313297,
      "title": "菩萨蛮",
      "content": [
        "琼杯且尽清歌送。",
        "人生离合真如梦。",
        "瞬息又春归。",
        "回头光景非。",
        "香喷金兽暖。",
        "欢意愁更短。",
        "白发不须量。",
        "从教千丈长。"
      ],
      "author": {
        "id": 1307,
        "name": "韦骧"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313401,
      "title": "菩萨蛮",
      "content": [
        "来时杨柳东桥路。",
        "曲中暗有相期处。",
        "明月好因缘。",
        "欲圆还未圆。",
        "欲寻芳草去。",
        "画扇遮微雨。",
        "飞絮莫无情。",
        "闲花应笑人。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313402,
      "title": "菩萨蛮",
      "content": [
        "个人轻似低飞燕。",
        "春来绮陌时相见。",
        "堪恨两横波。",
        "恼人情绪多。",
        "长留青鬓住。",
        "莫放红颜去。",
        "占取艳阳天。",
        "且教伊少年。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313403,
      "title": "菩萨蛮",
      "content": [
        "鸾啼似作留春语。",
        "花飞斗学回风舞。",
        "红日又平西。",
        "画帘遮燕泥。",
        "烟光还自老。",
        "绿镜人空好。",
        "香在去年衣。",
        "鱼笺音信稀。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313404,
      "title": "菩萨蛮",
      "content": [
        "春风未放花心吐。",
        "尊前不拟分明语。",
        "酒色上来迟。",
        "绿须红杏枝。",
        "今朝眉黛浅。",
        "暗恨归时远。",
        "前夜月当楼。",
        "相逢南陌头。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313405,
      "title": "菩萨蛮",
      "content": [
        "娇香淡染胭脂雪。",
        "愁春细画弯弯月。",
        "花月镜边情。",
        "浅妆匀未成。",
        "佳期应有在。",
        "试倚秋千待。",
        "满地落英红。",
        "万条杨柳风。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313406,
      "title": "菩萨蛮",
      "content": [
        "香莲烛下匀丹雪。",
        "妆成笑弄金阶月。",
        "娇面胜芙蓉。",
        "脸边天与红。",
        "玳筵双揭鼓。",
        "唤上华茵舞。",
        "春浅未禁寒。",
        "暗嫌罗袖宽。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
