      }
    },
    {
      "id": 313407,
      "title": "菩萨蛮",
      "content": [
        "哀筝一弄湘江曲。",
        "声声写尽湘波绿。",
        "纤指十三弦。",
        "细将幽恨传。",
        "当筵秋水慢。",
        "玉柱斜飞雁。",
        "弹到断肠时。",
        "春山眉黛低。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313408,
      "title": "菩萨蛮",
      "content": [
        "江南未雪梅花白。",
        "忆梅人是江南客。",
        "犹记旧相逢。",
        "淡烟微月中。",
        "玉容长有信。",
        "一笑归来近。",
        "怀远上楼时。",
        "晚云和雁低。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
        "id": 20,
        "name": "宋词"
      }
    },
    {
      "id": 313409,
      "title": "菩萨蛮",
      "content": [
        "相逢欲话相思苦。",
        "浅情肯信相思否。",
        "还恐漫相思。",
        "浅情人不知。",
        "忆曾携手处。",
        "月满窗前路。",
        "长到月来时。",
        "不眠犹待伊。"
      ],
      "author": {
        "id": 5825,
        "name": "晏几道"
      },
      "dynasty": {
        "id": 8,
        "name": "宋"
      },
      "type": {
